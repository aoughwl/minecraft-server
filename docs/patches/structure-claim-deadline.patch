 proc findOrClaimStructureStart*(c: GlobalStructureCache, key: StructureKeys, chunkX, chunkZ: int32,
                                 found: var StructurePosition): bool =
   ## `findStructureStart`, except that when another worker is computing this very start it waits for that result instead of
   ## computing it again (neighbouring chunks run their reference passes at the same time and all want the same village).
   ## True with `found` set; false means the caller has claimed the start and must call `storeStructureStart`. A claim that
-  ## is never answered (a worker that failed) is given up on after 20 s.
+  ## is never answered (a worker that failed) is given up on after 20 s of WALL CLOCK (was: 20000 iterations of Sleep(1), which is
+  ## 20 s only with a 1 ms timer; at the default 15.6 ms Windows timer it is 240-340 s, the stalls seen in the real-server bench).
   let k: StructureStartKey = (key, chunkX, chunkZ)
-  var waited = 0
+  let deadline = tickCount64() + 20000'u64
   while true:
     lockGen()
     if c.structureStarts.hasKey(k):
       found = c.structureStarts.getOrDefault(k, nil)
       unlockGen()
       return true
-    if not c.claimed.hasKey(k) or waited >= 20000:
+    if not c.claimed.hasKey(k) or tickCount64() >= deadline:
       c.claimed[k] = true
       unlockGen()
       return false
     unlockGen()
     sleepWin(1'u32)
-    inc waited
+
+proc abandonStructureClaim*(c: GlobalStructureCache, key: StructureKeys, chunkX, chunkZ: int32) =
+  ## The claimant failed: release the claim at once so waiters recompute instead of sleeping out the deadline.
+  let k: StructureStartKey = (key, chunkX, chunkZ)
+  lockGen()
+  if c.claimed.hasKey(k):
+    c.claimed.del(k)
+  unlockGen()
 
