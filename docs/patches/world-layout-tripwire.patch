diff --git a/tools/check_world_layout.sh b/tools/check_world_layout.sh
new file mode 100644
index 0000000..e4f1dbf
--- /dev/null
+++ b/tools/check_world_layout.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Stale-nimcache tripwire: the World.blockWorld field offset must be the same in worldadapter (reader) and worldmod (writer).
+# A mismatch means some modules were compiled against an older World layout (incremental cache not invalidated): rebuild with a fresh --nimcache.
+#   sh tools/check_world_layout.sh <server exe>
+EXE="$1"; [ -f "$EXE" ] || { echo "usage: check_world_layout.sh <exe>"; exit 2; }
+export PATH="/c/msys64/ucrt64/bin:$PATH"
+rd=$(gdb -batch -ex "disassemble runTickData_0_worm5ecfw1" "$EXE" 2>&1 | grep -m1 -o '0x[0-9a-f]*(%rcx)' | sed 's/(.*//')
+wr=$(gdb -batch -ex "disassemble loadWorld_0_worsj29i7" "$EXE" 2>&1 | grep -A4 newBlockWorldOf | grep -m1 -o 'mov    %rdi,0x[0-9a-f]*(%rbx)' | sed 's/.*,\(0x[0-9a-f]*\).*/\1/')
+echo "runTickData reads World.blockWorld at $rd; loadWorld stores it at $wr"
+[ -n "$rd" ] && [ "$rd" = "$wr" ] && echo LAYOUT-OK || { echo "LAYOUT-MISMATCH (stale cache?)"; exit 1; }
