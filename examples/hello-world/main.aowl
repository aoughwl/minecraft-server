## hello-world: a plugin in aowlmony that shows most of what a server plugin can do.
##
## Build and install (from the repository root):
##     sh tools/build_plugin.sh examples/hello-world
##     cp -r examples/hello-world plugins/hello-world
## The server loads plugins/hello-world on start, and reloads it whenever you build it again.
##
## How a plugin is written: it is one file. It imports `pluginsdk`, defines handlers, and registers them at the top level:
## `registerEvent(handler)` listens to the event named by the handler's parameter type, `command(...)` adds /name, `after` and
## `every` schedule work, and `onEnable`/`onDisable` run when the plugin starts and stops. An event is a typed object: read its
## fields, change the ones that are writable, and `e.cancel()` stops the server doing what was happening.

import pluginsdk

type
  Counter = object
    name: string
    count: int

var
  joins: seq[Counter] = @[]       ## how many times each player joined while this server ran
  chats: seq[Counter] = @[]       ## messages each player sent
  placed: seq[Counter] = @[]      ## blocks each player placed
  greeted: seq[string] = @[]      ## players whose first step we commented on
  tipNumber = 0

const Tips = [
  "Tip: /hello shows what this plugin can do.",
  "Tip: /where tells you your coordinates.",
  "Tip: /remind 10 drink water sets a reminder for ten seconds from now.",
  "Tip: type !ping in chat for a pong."
]

# ---- small helpers -------------------------------------------------------------------------------------------------------------------

proc bump(table: var seq[Counter]; name: string): int =
  for k in 0 ..< table.len:
    if table[k].name == name:
      table[k].count = table[k].count + 1
      return table[k].count
  table.add Counter(name: name, count: 1)
  1

proc countOf(table: seq[Counter]; name: string): int =
  for c in table:
    if c.name == name: return c.count
  0

proc plural(n: int; word: string): string =
  $n & " " & word & (if n == 1: "" else: "s")

proc whole(x: float): int =
  ## The whole part of a coordinate, rounding down.
  let t = int(x)
  if float(t) > x: t - 1 else: t

proc contains(text, part: string): bool =
  if part.len == 0: return true
  if text.len < part.len: return false
  for i in 0 .. text.len - part.len:
    if text.substr(i, i + part.len - 1) == part: return true
  false

proc lower(s: string): string =
  result = ""
  for c in s:
    result.add (if c >= 'A' and c <= 'Z': chr(ord(c) + 32) else: c)

proc replaceAll(text, old, replacement: string): string =
  result = ""
  var i = 0
  while i < text.len:
    if old.len > 0 and i + old.len <= text.len and text.substr(i, i + old.len - 1) == old:
      result.add replacement
      i += old.len
    else:
      result.add text[i]
      inc i

# ---- events -------------------------------------------------------------------------------------------------------------------------

proc greet(e: var JoinEvent) =
  let n = bump(joins, e.player.name)
  discard e.player.tell("Welcome" & (if n > 1: " back" else: "") & ", " & e.player.name & "! Type /hello to see what this plugin does.")
  broadcast(e.player.name & " joined the game (" & plural(onlineCount(), "player") & " online)")

proc goodbye(e: var LeaveEvent) =
  log("hello-world: " & e.player.name & " left")

proc chatRules(e: var ChatEvent) =
  discard bump(chats, e.player.name)
  # 1. a chat command handled by the plugin; cancelling stops the server broadcasting it
  if e.message == "!ping":
    discard e.player.tell("pong!")
    e.cancel()
    return
  # 2. a filter: drop messages that contain a banned word
  if contains(lower(e.message), "badword"):
    discard e.player.tell("Please keep it friendly.")
    e.cancel()
    return
  # 3. a rewrite: the message that goes out is the one the plugin leaves in the event
  if contains(e.message, ":)"):
    e.message = replaceAll(e.message, ":)", "(smile)")

proc firstStep(e: var MoveEvent) =
  for g in greeted:
    if g == e.player.name: return
  greeted.add e.player.name
  discard e.player.tell("Nice first step!")

proc blocks(e: var BlockPlaceEvent) =
  let n = bump(placed, e.player.name)
  if e.blockName == "minecraft:tnt":     # cancel a placement
    discard e.player.tell("TNT is not allowed here.")
    e.cancel()
    return
  if n == 1: discard e.player.tell("You placed your first block (" & e.blockName & ").")

proc modeNotice(e: var GamemodeChangeEvent) =
  const names = ["survival", "creative", "adventure", "spectator"]
  discard e.player.tell("Game mode: " & names[ord(e.previous)] & " -> " & names[ord(e.next)])

proc spawnNotice(e: var SpawnChangeEvent) =
  broadcast("The world spawn moved to " & $whole(e.next.x) & ", " & $whole(e.next.z) & ".")

proc consoleLog(e: var ServerCommandEvent) =
  log("hello-world: console command: " & e.command)

proc fallDamage(e: var EntityDamageEvent) =
  # entity events work the same way: here, half damage for creepers
  if e.entityType == "creeper":
    e.amount = e.amount / 2.0

proc levelNotice(e: var LevelChangeEvent) =
  discard e.player.tell("Level " & $e.previous & " -> " & $e.level)

proc timeNotice(e: var TimeSetEvent) =
  broadcast("Time set: " & $e.previous & " -> " & $e.time)

proc healNotice(e: var HealEvent) =
  if e.entityType == "player": broadcast("Healed " & $int(e.amount))

proc foodNotice(e: var FoodLevelChangeEvent) =
  broadcast("Food " & $e.previous & " -> " & $e.level)

var statTotal = 0

proc statCount(e: var StatisticEvent) =
  inc statTotal

proc cullCow(data: string) =
  ## runs a moment after a cow spawned: `data` is its entity id
  let id = int(parseNum(data))
  broadcast("Cow health " & $int(entityHealth(id)))
  discard setEntityHealth(id, 2.0)
  broadcast("Cow now " & $int(entityHealth(id)))
  discard teleportEntity(id, 7.0, 75.0, 7.0)
  broadcast("Cow moved to " & $int(entityPos(id).x))
  if removeEntity(id): broadcast("Cow removed")

proc cowWatch(e: var EntitySpawnEvent) =
  # entity control: act on the entity the event named (a moment later; the entity is not fully in the world yet)
  if e.entityType == "cow": discard after(2, $e.entityId, cullCow)

proc saved(e: var WorldSaveEvent) =
  log("hello-world: the server saved")
  broadcast("World saved")

proc listPing(e: var ServerListPingEvent) =
  # the entry in the multiplayer list: a plugin may change the MOTD (and the player maximum) each asker sees
  e.motd = "hello-world server (" & $e.online & " online)"

proc preLogin(e: var PreLoginEvent) =
  # a client asks to log in: cancel to turn it away with a message
  if e.name == "Griefer":
    e.kickMessage = "Griefers are not welcome."
    e.cancel()

# ---- commands ----------------------------------------------------------------------------------------------------------------------

proc helloCommand(c: var CommandContext) =
  let who = if c.rawArgs.len > 0: c.rawArgs elif c.isConsole: "console" else: c.sender.name
  c.reply("Hello, " & who & "! This plugin:")
  c.reply("  - greets players, filters chat (try 'badword' or :) ), answers !ping")
  c.reply("  - commands: /where /gm /tpme /announce /remind /stats /kickme /online")
  c.reply("  - reports your first step, your first block, game mode changes, spawn changes")

proc onlineCommand(c: var CommandContext) =
  c.reply(plural(onlineCount(), "player") & " online.")

proc whereCommand(c: var CommandContext) =
  if c.isConsole:
    c.fail("/where can only be used by a player.")
    return
  let p = c.sender.pos()
  c.reply("You are at " & $whole(p.x) & ", " & $whole(p.y) & ", " & $whole(p.z))

proc gmCommand(c: var CommandContext) =
  let mode = c.intArg(0, -1)
  if c.arg(0).len != 1 or mode < 0 or mode > 3:
    c.fail("Usage: /gm <0|1|2|3>")
    return
  discard c.sender.setGamemode(Gamemode(mode))

proc tpCommand(c: var CommandContext) =
  if c.args.len < 3:
    c.fail("Usage: /tpme <x> <y> <z>")
    return
  discard c.sender.teleport(c.floatArg(0), c.floatArg(1), c.floatArg(2))
  c.reply("Teleported to " & c.arg(0) & ", " & c.arg(1) & ", " & c.arg(2))

proc announceCommand(c: var CommandContext) =
  if c.rawArgs.len == 0:
    c.fail("Usage: /announce <text>")
    return
  broadcast("[" & c.sender.name & "] " & c.rawArgs)

proc remindFires(data: string) =
  ## `data` is what `after` was given: the player, a space, then the reminder.
  var at = 0
  while at < data.len and data[at] != ' ': inc at
  discard playerNamed(data.substr(0, at - 1)).tell("Reminder: " & data.substr(at + 1))

proc remindCommand(c: var CommandContext) =
  let seconds = c.intArg(0)
  let what = c.restFrom(1)
  if seconds < 1 or what.len == 0:
    c.fail("Usage: /remind <seconds> <text>")
    return
  discard after(seconds * 20, c.sender.name & " " & what, remindFires)
  c.reply("I will remind you in " & plural(seconds, "second") & ".")

proc statsCommand(c: var CommandContext) =
  c.reply("statistic events so far: " & $statTotal)
  let n = c.sender.name
  c.reply("You joined " & plural(countOf(joins, n), "time") & ", sent " & plural(countOf(chats, n), "chat message") &
    " and placed " & plural(countOf(placed, n), "block") & ".")

proc blockCommand(c: var CommandContext) =
  ## /block <x> <y> <z>            tells which block is there
  ## /block <x> <y> <z> <name>     puts that block there
  if c.args.len < 3:
    c.fail("Usage: /block <x> <y> <z> [block name]")
    return
  let x = c.intArg(0)
  let y = c.intArg(1)
  let z = c.intArg(2)
  if c.args.len == 3:
    c.reply("Block at " & $x & " " & $y & " " & $z & ": " & blockAt(x, y, z))
  elif setBlock(x, y, z, c.arg(3)):
    c.reply("Placed " & c.arg(3) & " at " & $x & " " & $y & " " & $z)
  else:
    c.fail("Could not place " & c.arg(3) & " there.")

proc giveCommand(c: var CommandContext) =
  if c.isConsole or c.args.len < 2:
    c.fail("Usage: /giveme <item> <count>")
    return
  if c.sender.give(c.arg(0), c.intArg(1, 1)):
    c.reply("You now carry " & $c.sender.itemCount(c.arg(0)) & " of " & c.arg(0))
  else:
    c.fail("Unknown item " & c.arg(0))

proc foodCommand(c: var CommandContext) =
  if c.isConsole:
    c.fail("/food can only be used by a player.")
    return
  discard c.sender.setFood(c.intArg(0, 20))

proc kickCommand(c: var CommandContext) =
  discard c.sender.kick("You asked to be kicked. Come back any time!")

# ---- a repeating task: a tip to everyone every minute ---------------------------------------------------------------------------------

proc tip() =
  if onlineCount() > 0:
    broadcast(Tips[tipNumber mod Tips.len])
    inc tipNumber

proc starting() =
  log("hello-world: starting")
  discard every(20 * 60, tip)          # 20 ticks make a second

proc stopping() =
  log("hello-world: stopping")

# ---- registration: this is the whole wiring --------------------------------------------------------------------------------------------

registerEvent(greet)
registerEvent(goodbye)
registerEvent(chatRules)
registerEvent(firstStep)
registerEvent(blocks)
registerEvent(modeNotice)
registerEvent(spawnNotice)
registerEvent(consoleLog)
registerEvent(fallDamage)
registerEvent(listPing)
registerEvent(levelNotice)
registerEvent(saved)
registerEvent(cowWatch)
registerEvent(timeNotice)
registerEvent(healNotice)
registerEvent(foodNotice)
registerEvent(statCount)
registerEvent(preLogin)

command("hello", "Say hello and list what this plugin can do", 0, helloCommand)
command("online", "How many players are online", 0, onlineCommand)
command("where", "Show your coordinates", 0, whereCommand)
command("gm", "Change your game mode: /gm <0-3>", 2, gmCommand)
command("tpme", "Teleport yourself: /tpme <x> <y> <z>", 2, tpCommand)
command("announce", "Broadcast a message to everyone: /announce <text>", 2, announceCommand)
command("remind", "Remind yourself later: /remind <seconds> <text>", 0, remindCommand)
command("stats", "What this plugin has counted for you", 0, statsCommand)
command("block", "Read or place a block: /block <x> <y> <z> [name]", 2, blockCommand)
command("giveme", "Give yourself items: /giveme <item> <count>", 2, giveCommand)
command("food", "Set your food level: /food <0-20>", 2, foodCommand)
command("kickme", "Kick yourself (to show kick)", 0, kickCommand)

onEnable(starting)
onDisable(stopping)
