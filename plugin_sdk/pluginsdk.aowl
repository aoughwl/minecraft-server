# ---- commands ---------------------------------------------------------------------------------------------------------------------------

type
  CommandContext* = object
    sender*: Player            ## who ran it; `isConsole` when nobody did
    isConsole*: bool
    name*: string              ## the command, as registered
    rawArgs*: string           ## everything after the name
    args*: seq[string]         ## `rawArgs` split on spaces

  CommandHandler* = proc (c: var CommandContext) {.nimcall.}

  CommandEntry = object
    name: string
    description: string
    level: int
    handler: CommandHandler

var commands: seq[CommandEntry] = @[]

proc command*(name, description: string; level: int; handler: CommandHandler) =
  ## Adds /name. `level` 0 lets anyone use it, 1 to 4 an operator of at least that level. The handler answers with `reply` or `fail`.
  commands.add CommandEntry(name: name, description: description, level: level, handler: handler)
  want("on_command")
  if started: discard call3("register_command", name, description, $level)

proc reply*(c: CommandContext; text: string) = discard call1("command_reply", text)
proc fail*(c: CommandContext; text: string) = discard call1("command_fail", text)
proc arg*(c: CommandContext; i: int): string = (if i >= 0 and i < c.args.len: c.args[i] else: "")
proc intArg*(c: CommandContext; i: int; default = 0): int = (if i >= 0 and i < c.args.len: parseInt(c.args[i]) else: default)
proc floatArg*(c: CommandContext; i: int; default = 0.0): float = (if i >= 0 and i < c.args.len: parseNum(c.args[i]) else: default)
proc restFrom*(c: CommandContext; first: int): string =
  ## The arguments from `first` on, joined with spaces (a message, say).
  result = ""
  for k in first ..< c.args.len:
    if k > first: result.add " "
    result.add c.args[k]

# ---- tasks and the plugin's life ---------------------------------------------------------------------------------------------------------

type
  TaskHandler* = proc () {.nimcall.}
  TaskDataHandler* = proc (data: string) {.nimcall.}   ## for a task that carries something (who to remind, and of what)

  TaskEntry = object
    id: int
    repeat: bool
    hasData: bool
    data: string
    handler: TaskHandler
    dataHandler: TaskDataHandler

var
  tasks: seq[TaskEntry] = @[]
  enableHandlers: seq[TaskHandler] = @[]
  disableHandlers: seq[TaskHandler] = @[]

proc after*(ticks: int; handler: TaskHandler): int =
  ## Runs `handler` once, `ticks` from now (20 ticks make a second). The task id, for `cancelTask`.
  want("on_task")
  let id = parseInt(call1("schedule_after", $ticks))
  tasks.add TaskEntry(id: id, repeat: false, handler: handler)
  id

proc every*(ticks: int; handler: TaskHandler): int =
  want("on_task")
  let id = parseInt(call1("schedule_repeat", $ticks))
  tasks.add TaskEntry(id: id, repeat: true, handler: handler)
  id

proc after*(ticks: int; data: string; handler: TaskDataHandler): int =
  ## Like `after`, and `handler` is given `data` when it runs.
  want("on_task")
  let id = parseInt(call1("schedule_after", $ticks))
  tasks.add TaskEntry(id: id, repeat: false, hasData: true, data: data, dataHandler: handler)
  id

proc every*(ticks: int; data: string; handler: TaskDataHandler): int =
  want("on_task")
  let id = parseInt(call1("schedule_repeat", $ticks))
  tasks.add TaskEntry(id: id, repeat: true, hasData: true, data: data, dataHandler: handler)
  id

proc cancelTask*(id: int) =
  discard call1("schedule_cancel", $id)
  var kept: seq[TaskEntry] = @[]
  for t in tasks:
    if t.id != id: kept.add t
  tasks = kept

proc onEnable*(handler: TaskHandler) = enableHandlers.add handler
proc onDisable*(handler: TaskHandler) = disableHandlers.add handler

# ---- what the engine calls (the build adds `proc start*() = startPlugin()`, `event`, `stop` to the plugin's main module) ------------------

proc startPlugin*() =
  ## After the plugin loaded: tells the host which events and commands it has, then runs the `onEnable` handlers.
  started = true
  for w in wanted:
    discard call1("subscribe_event", w)
  for c in commands:
    discard call3("register_command", c.name, c.description, $c.level)
  for h in enableHandlers:
    h()

proc stopPlugin*() =
  for h in disableHandlers:
    h()

proc splitWords(s: string): seq[string] =
  result = @[]
  var cur = ""
  for c in s:
    if c == ' ':
      if cur.len > 0:
        result.add cur
        cur = ""
    else:
      cur.add c
  if cur.len > 0: result.add cur

proc finish(cancelled: bool) =
  if cancelled: discard call0("event_cancel")

proc dispatchEvent*() =
  ## One call per event the plugin listens to: builds the event, runs the handlers in the order they were registered, and tells
  ## the host what they decided.
  let name = evStr("event")
  case name
  of "on_player_chat":
    var e = ChatEvent(player: evPlayer(), message: evStr("message"), cancelled: false)
    let before = e.message
    for h in chatHandlers: h(e)
    if e.message != before: discard call1("event_set_message", e.message)
    finish(e.cancelled)
  of "on_player_command":
    var e = PlayerCommandEvent(player: evPlayer(), command: evStr("message"), cancelled: false)
    for h in playerCommandHandlers: h(e)
    finish(e.cancelled)
  of "on_player_join":
    var e = JoinEvent(player: evPlayer(), cancelled: false)
    for h in joinHandlers: h(e)
    finish(e.cancelled)
  of "on_player_leave":
    var e = LeaveEvent(player: evPlayer(), cancelled: false)
    for h in leaveHandlers: h(e)
    finish(e.cancelled)
  of "on_player_login":
    var e = LoginEvent(player: evPlayer(), kickMessage: evStr("message"), cancelled: false)
    let before = e.kickMessage
    for h in loginHandlers: h(e)
    if e.kickMessage != before: discard call1("event_set_message", e.kickMessage)
    finish(e.cancelled)
  of "on_player_move":
    var e = MoveEvent(player: evPlayer(), origin: evVec("from_"), target: evVec("to_"), cancelled: false)
    for h in moveHandlers: h(e)
    finish(e.cancelled)
  of "on_player_teleport":
    var e = TeleportEvent(player: evPlayer(), origin: evVec("from_"), target: evVec("to_"), cancelled: false)
    for h in teleportHandlers: h(e)
    finish(e.cancelled)
  of "on_player_toggle":
    var e = ToggleEvent(player: evPlayer(), kind: evInt("kind"), on: evInt("value") != 0, cancelled: false)
    for h in toggleHandlers: h(e)
    finish(e.cancelled)
  of "on_player_gamemode_change":
    var e = GamemodeChangeEvent(player: evPlayer(), previous: evMode("previous"), next: evMode("next"), cancelled: false)
    for h in gamemodeHandlers: h(e)
    finish(e.cancelled)
  of "on_player_item_held":
    var e = ItemHeldEvent(player: evPlayer(), previousSlot: evInt("previous"), nextSlot: evInt("next"), cancelled: false)
    for h in itemHeldHandlers: h(e)
    finish(e.cancelled)
  of "on_player_interact":
    var e = InteractEvent(player: evPlayer(), action: evInt("action"), x: evInt("x"), y: evInt("y"), z: evInt("z"), cancelled: false)
    for h in interactHandlers: h(e)
    finish(e.cancelled)
  of "on_block_place":
    var e = BlockPlaceEvent(player: evPlayer(), blockName: evStr("placed"), against: evStr("clicked"), x: evInt("x"), y: evInt("y"),
      z: evInt("z"), cancelled: false)
    for h in blockPlaceHandlers: h(e)
    finish(e.cancelled)
  of "on_player_exp_change":
    var e = ExpChangeEvent(player: evPlayer(), amount: evInt("amount"))
    for h in expHandlers: h(e)
  of "on_player_respawn":
    var e = RespawnEvent(player: evPlayer(), pos: vec3(evNum("x"), evNum("y"), evNum("z")), alive: evInt("alive") != 0)
    for h in respawnHandlers: h(e)
  of "on_player_death":
    var e = DeathEvent(player: evPlayer(), message: evStr("message"))
    for h in deathHandlers: h(e)
  of "on_server_command":
    var e = ServerCommandEvent(command: evStr("command"), cancelled: false)
    for h in serverCommandHandlers: h(e)
    finish(e.cancelled)
  of "on_server_broadcast":
    var e = BroadcastEvent(message: evStr("message"), sender: evStr("sender"), cancelled: false)
    for h in broadcastHandlers: h(e)
    finish(e.cancelled)
  of "on_server_load":
    var e = ServerLoadEvent(reload: evInt("reload") != 0)
    for h in serverLoadHandlers: h(e)
  of "on_server_tick_start":
    var e = TickStartEvent(tick: evInt("tick"))
    for h in tickStartHandlers: h(e)
  of "on_server_tick_end":
    var e = TickEndEvent(tick: evInt("tick"), durationNs: evInt("duration_ns"))
    for h in tickEndHandlers: h(e)
  of "on_packet_received":
    var e = PacketEvent(player: evPlayer(), packetId: evInt("packet_id"), length: evInt("length"), cancelled: false)
    for h in packetHandlers: h(e)
    finish(e.cancelled)
  of "on_block_redstone":
    var e = RedstoneEvent(x: evInt("x"), y: evInt("y"), z: evInt("z"), oldCurrent: evInt("old_current"),
      newCurrent: evInt("new_current"), cancelled: false)
    for h in redstoneHandlers: h(e)
    finish(e.cancelled)
  of "on_block_grow":
    var e = BlockGrowEvent(before: evStr("old_block"), after: evStr("new_block"), x: evInt("x"), y: evInt("y"), z: evInt("z"),
      cancelled: false)
    for h in blockGrowHandlers: h(e)
    finish(e.cancelled)
  of "on_spawn_change":
    var e = SpawnChangeEvent(previous: vec3(evNum("previous_x"), evNum("previous_y"), evNum("previous_z")),
      next: vec3(evNum("next_x"), evNum("next_y"), evNum("next_z")), yaw: evNum("yaw"), pitch: evNum("pitch"))
    for h in spawnChangeHandlers: h(e)
  of "on_chunk_send":
    var e = ChunkSendEvent(x: evInt("x"), z: evInt("z"), cancelled: false)
    for h in chunkSendHandlers: h(e)
    finish(e.cancelled)
  of "on_player_swing":
    var e = SwingEvent(player: evPlayer(), cancelled: false)
    for h in swingHandlers: h(e)
    finish(e.cancelled)
  of "on_player_use_item":
    var e = UseItemEvent(player: evPlayer(), cancelled: false)
    for h in useItemHandlers: h(e)
    finish(e.cancelled)
  of "on_player_interact_entity":
    let a = evInt("action")
    var e = InteractEntityEvent(player: evPlayer(), entityId: evInt("entity_id"),
      action: (if a == 1: eaAttack elif a == 2: eaInteractAt else: eaInteract), sneaking: evInt("sneaking") != 0,
      known: evInt("known") != 0, cancelled: false)
    for h in interactEntityHandlers: h(e)
    finish(e.cancelled)
  of "on_player_custom_payload":
    var e = CustomPayloadEvent(player: evPlayer(), channel: evStr("channel"), length: evInt("length"), cancelled: false)
    for h in customPayloadHandlers: h(e)
    finish(e.cancelled)
  of "on_player_main_hand_change":
    var e = MainHandChangeEvent(player: evPlayer(), hand: evInt("hand"))
    for h in mainHandHandlers: h(e)
  of "on_inventory_close":
    var e = InventoryCloseEvent(player: evPlayer(), window: evInt("window"))
    for h in inventoryCloseHandlers: h(e)
  of "on_inventory_click":
    var e = InventoryClickEvent(player: evPlayer(), window: evInt("window"), clickType: evInt("click_type"), slot: evInt("slot"),
      rawSlot: evInt("raw_slot"), hotbarButton: evInt("hotbar_button"), cancelled: false)
    for h in inventoryClickHandlers: h(e)
    finish(e.cancelled)
  of "on_block_break":
    var e = BlockBreakEvent(player: evPlayer(), blockName: evStr("block"), x: evInt("x"), y: evInt("y"), z: evInt("z"),
      drop: evInt("flag") != 0, cancelled: false)
    let dropBefore = e.drop
    for h in blockBreakHandlers: h(e)
    if e.drop != dropBefore: discard call1("event_set_flag", (if e.drop: "1" else: "0"))
    finish(e.cancelled)
  of "on_player_drop_item":
    var e = DropItemEvent(player: evPlayer(), item: evStr("item"), count: evInt("count"), cancelled: false)
    for h in dropItemHandlers: h(e)
    finish(e.cancelled)
  of "on_player_pickup_item":
    var e = PickupItemEvent(player: evPlayer(), item: evStr("item"), count: evInt("count"), entityId: evInt("entity_id"),
      cancelled: false)
    for h in pickupItemHandlers: h(e)
    finish(e.cancelled)
  of "on_player_item_consume":
    var e = ItemConsumeEvent(player: evPlayer(), item: evStr("item"), cancelled: false)
    for h in itemConsumeHandlers: h(e)
    finish(e.cancelled)
  of "on_player_bed_enter":
    var e = BedEnterEvent(player: evPlayer(), x: evInt("x"), y: evInt("y"), z: evInt("z"), cancelled: false)
    for h in bedEnterHandlers: h(e)
    finish(e.cancelled)
  of "on_player_bed_leave":
    var e = BedLeaveEvent(player: evPlayer(), x: evInt("x"), y: evInt("y"), z: evInt("z"), cancelled: false)
    for h in bedLeaveHandlers: h(e)
    finish(e.cancelled)
  of "on_sign_change":
    var e = SignChangeEvent(player: evPlayer(), x: evInt("x"), y: evInt("y"), z: evInt("z"),
      lines: @[evStr("line0"), evStr("line1"), evStr("line2"), evStr("line3")], cancelled: false)
    for h in signChangeHandlers: h(e)
    finish(e.cancelled)
  of "on_bucket_empty":
    var e = BucketEmptyEvent(player: evPlayer(), bucket: evStr("bucket"), x: evInt("x"), y: evInt("y"), z: evInt("z"),
      cancelled: false)
    for h in bucketEmptyHandlers: h(e)
    finish(e.cancelled)
  of "on_bucket_fill":
    var e = BucketFillEvent(player: evPlayer(), bucket: evStr("bucket"), x: evInt("x"), y: evInt("y"), z: evInt("z"),
      cancelled: false)
    for h in bucketFillHandlers: h(e)
    finish(e.cancelled)
  of "on_permission_check":
    var e = PermissionCheckEvent(player: evPlayer(), node: evStr("node"), granted: evInt("flag") != 0)
    let before = e.granted
    for h in permissionHandlers: h(e)
    if e.granted != before: discard call1("event_set_flag", (if e.granted: "1" else: "0"))
  of "on_player_fish":
    var e = FishEvent(player: evPlayer(), state: evInt("state"), caught: evStr("caught"), exp: evInt("exp"), cancelled: false)
    for h in fishHandlers: h(e)
    finish(e.cancelled)
  of "on_player_egg_throw":
    var e = EggThrowEvent(player: evPlayer(), hatching: evInt("hatching") != 0, numHatches: evInt("num_hatches"),
      hatchingType: evStr("hatching_type"), cancelled: false)
    let before = e.hatching
    for h in eggThrowHandlers: h(e)
    if e.hatching != before: discard call1("event_set_flag", (if e.hatching: "1" else: "0"))
    finish(e.cancelled)
  of "on_custom_click":
    var e = CustomClickEvent(player: evPlayer(), id: evStr("id"), length: evInt("length"))
    for h in customClickHandlers: h(e)
  of "on_player_change_world":
    var e = ChangeWorldEvent(player: evPlayer(), pos: vec3(evNum("x"), evNum("y"), evNum("z")), yaw: evNum("yaw"),
      pitch: evNum("pitch"), cancelled: false)
    for h in changeWorldHandlers: h(e)
    finish(e.cancelled)
  of "on_entity_damage":
    var e = EntityDamageEvent(entityId: evInt("entity_id"), entityType: evStr("entity_type"), damageType: evStr("damage_type"),
      amount: evNum("amount"), attackerId: evInt("attacker_id"), cancelled: false)
    let before = e.amount
    for h in entityDamageHandlers: h(e)
    if e.amount != before: discard call1("event_set_value", $e.amount)
    finish(e.cancelled)
  of "on_entity_death":
    var e = EntityDeathEvent(entityId: evInt("entity_id"), entityType: evStr("entity_type"), damageType: evStr("damage_type"),
      killerId: evInt("killer_id"))
    for h in entityDeathHandlers: h(e)
  of "on_entity_spawn":
    var e = EntitySpawnEvent(entityId: evInt("entity_id"), entityType: evStr("entity_type"),
      pos: vec3(evNum("x"), evNum("y"), evNum("z")))
    for h in entitySpawnHandlers: h(e)
  of "on_entity_remove":
    var e = EntityRemoveEvent(entityId: evInt("entity_id"), entityType: evStr("entity_type"))
    for h in entityRemoveHandlers: h(e)
  of "on_explosion":
    var e = ExplosionEvent(pos: vec3(evNum("x"), evNum("y"), evNum("z")), power: evNum("power"), cancelled: false)
    for h in explosionHandlers: h(e)
    finish(e.cancelled)
  of "on_weather_change":
    var e = WeatherChangeEvent(raining: evInt("raining") != 0, thundering: evInt("thundering") != 0)
    for h in weatherHandlers: h(e)
  of "on_player_level_change":
    var e = LevelChangeEvent(player: evPlayer(), previous: evInt("previous"), level: evInt("level"))
    for h in levelHandlers: h(e)
  of "on_world_save":
    var e = WorldSaveEvent(saved: true)
    for h in saveHandlers: h(e)
  of "on_time_set":
    var e = TimeSetEvent(previous: evInt("previous"), time: evInt("time"), cancelled: false)
    let before = e.time
    for h in timeHandlers: h(e)
    if e.time != before: discard call1("event_set_value", $e.time)
    finish(e.cancelled)
  of "on_entity_heal":
    var e = HealEvent(entityId: evInt("entity_id"), entityType: evStr("entity_type"), amount: evNum("amount"), cancelled: false)
    let before = e.amount
    for h in healHandlers: h(e)
    if e.amount != before: discard call1("event_set_value", $e.amount)
    finish(e.cancelled)
  of "on_player_food_change":
    var e = FoodLevelChangeEvent(player: evPlayer(), level: evInt("level"), previous: evInt("previous"), cancelled: false)
    let before = e.level
    for h in foodHandlers: h(e)
    if e.level != before: discard call1("event_set_value", $e.level)
    finish(e.cancelled)
  of "on_player_statistic":
    var e = StatisticEvent(player: evPlayer(), category: evInt("category"), statId: evInt("stat_id"), amount: evInt("amount"))
    for h in statisticHandlers: h(e)
  of "on_server_list_ping":
    var e = ServerListPingEvent(address: evStr("address"), motd: evStr("message"), online: evInt("online"), maxPlayers: evInt("max"))
    let motdBefore = e.motd
    let maxBefore = e.maxPlayers
    for h in serverListHandlers: h(e)
    if e.motd != motdBefore: discard call1("event_set_message", e.motd)
    if e.maxPlayers != maxBefore: discard call1("event_set_value", $e.maxPlayers)
  of "on_player_pre_login":
    var e = PreLoginEvent(name: evStr("player"), address: evStr("address"), kickMessage: evStr("message"), cancelled: false)
    let before = e.kickMessage
    for h in preLoginHandlers: h(e)
    if e.kickMessage != before: discard call1("event_set_message", e.kickMessage)
    finish(e.cancelled)
  of "on_command":
    let who = evStr("player")
    var ctx = CommandContext(sender: Player(name: who), isConsole: who.len == 0, name: evStr("command"), rawArgs: evStr("args"),
      args: splitWords(evStr("args")))
    for c in commands:
      if c.name == ctx.name:
        c.handler(ctx)
        return
  of "on_task":
    let id = evInt("id")
    for k in 0 ..< tasks.len:
      if tasks[k].id == id:
        let t = tasks[k]
        if not t.repeat:
          var kept: seq[TaskEntry] = @[]
          for j in 0 ..< tasks.len:
            if j != k: kept.add tasks[j]
          tasks = kept
        if t.hasData: t.dataHandler(t.data) else: t.handler()
        return
  else:
    discard
