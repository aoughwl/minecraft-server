## The SDK of a server plugin written in aowlmony.
##
## A plugin is one file, main.aowl: it imports this module, defines handlers and registers them at the top level.
##
##     import pluginsdk
##
##     proc greet(e: var JoinEvent) =
##       e.player.tell("Welcome, " & e.player.name & "!")
##
##     proc filterChat(e: var ChatEvent) =
##       if e.message == "!ping":
##         e.player.tell("pong!")
##         e.cancel()
##
##     registerEvent(greet)           # which event it is for comes from the handler's parameter type
##     registerEvent(filterChat)
##     command("hello", "Say hello", 0, proc ...)
##
## tools/build_plugin.sh compiles it (adding the three entry procedures the engine calls) and the server loads the result.
##
## HOW IT TALKS (an implementation detail): the engine's interpreter cannot hand the host a runtime string through a C string, so this
## module speaks integers and reads text back. `putSlot` sends a string as packed integers (seven characters to an integer), `rawCall`
## names the host function in slot 0 and its arguments in the slots after and runs it, and `callResult` reads the text it answered.

proc hostCallI(name: cstring; a0, a1, a2, a3: int): int {.importc: "aoe_hostcall_i", cdecl.}
proc hostCallR(name: cstring; s: cstring): int {.importc: "aoe_hostcall_r", cdecl.}
proc hostCallRByte(i: int): int {.importc: "aoe_hostcall_rb", cdecl.}

# ---- the wire ---------------------------------------------------------------------------------------------------------------------

proc putSlot(slot: int; s: string) =
  discard hostCallI("txt_clear", slot, 0, 0, 0)
  var i = 0
  while i < s.len:
    var w0 = 0
    var w1 = 0
    var w2 = 0
    var k = 0
    while k < 21 and i + k < s.len:
      let b = ord(s[i + k])
      let shift = 8 * (k mod 7)
      if k < 7: w0 = w0 or (b shl shift)
      elif k < 14: w1 = w1 or (b shl shift)
      else: w2 = w2 or (b shl shift)
      inc k
    discard hostCallI("txt_put", slot, w0, w1, w2)
    i += 21

proc callResult(): string =
  result = ""
  let n = hostCallR("call_result", "")
  var i = 0
  while i < n:
    result.add chr(hostCallRByte(i))
    inc i

proc rawCall(fn, a1, a2, a3, a4: string; nargs: int): string =
  putSlot(0, fn)
  if nargs >= 1: putSlot(1, a1)
  if nargs >= 2: putSlot(2, a2)
  if nargs >= 3: putSlot(3, a3)
  if nargs >= 4: putSlot(4, a4)
  discard hostCallI("call", nargs + 1, 0, 0, 0)
  callResult()

proc call0(fn: string): string = rawCall(fn, "", "", "", "", 0)
proc call1(fn, a: string): string = rawCall(fn, a, "", "", "", 1)
proc call2(fn, a, b: string): string = rawCall(fn, a, b, "", "", 2)
proc call3(fn, a, b, c: string): string = rawCall(fn, a, b, c, "", 3)
proc call4(fn, a, b, c, d: string): string = rawCall(fn, a, b, c, d, 4)

# ---- numbers as text ----------------------------------------------------------------------------------------------------------------

proc parseNum*(s: string): float =
  ## A decimal number ("-12", "3.5"); 0 when it is not one.
  var i = 0
  var neg = false
  if i < s.len and s[i] == '-':
    neg = true
    inc i
  var whole = 0.0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    whole = whole * 10.0 + float(ord(s[i]) - 48)
    inc i
  var frac = 0.0
  var scale = 1.0
  if i < s.len and s[i] == '.':
    inc i
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      frac = frac * 10.0 + float(ord(s[i]) - 48)
      scale = scale * 10.0
      inc i
  result = whole + frac / scale
  if neg: result = -result

proc parseInt*(s: string): int = int(parseNum(s))

# ---- types --------------------------------------------------------------------------------------------------------------------------

type
  Vec3* = object
    x*, y*, z*: float

  Gamemode* = enum
    gmSurvival, gmCreative, gmAdventure, gmSpectator

  Player* = object
    ## A player by name. The procedures below act on the server; the player may be offline (they then answer false or 0).
    name*: string

proc vec3*(x, y, z: float): Vec3 = Vec3(x: x, y: y, z: z)

# ---- the server and players ------------------------------------------------------------------------------------------------------------

proc log*(text: string) = discard call1("server_log", text)
proc broadcast*(text: string) = discard call1("server_broadcast", text)
proc onlineCount*(): int = parseInt(call0("server_player_count"))
proc playerNamed*(name: string): Player = Player(name: name)

proc isOnline*(p: Player): bool = call1("player_online", p.name) == "true"
proc tell*(p: Player; text: string): bool = call2("player_message_to", p.name, text) == "true"
proc kick*(p: Player; reason: string): bool = call2("player_kick", p.name, reason) == "true"
proc teleport*(p: Player; x, y, z: float): bool =
  call4("player_teleport", p.name, $x, $y, $z) == "true"
proc teleport*(p: Player; to: Vec3): bool = teleport(p, to.x, to.y, to.z)
proc setGamemode*(p: Player; mode: Gamemode): bool = call2("player_set_gamemode", p.name, $ord(mode)) == "true"
proc pos*(p: Player): Vec3 =
  Vec3(x: parseNum(call2("player_pos", p.name, "x")), y: parseNum(call2("player_pos", p.name, "y")),
       z: parseNum(call2("player_pos", p.name, "z")))

# ---- events: one type each, with the fields it carries; `cancelled` is read by the server after the handlers ran ----------------

type
  ChatEvent* = object
    player*: Player
    message*: string           ## what will be broadcast; change it to rewrite it
    cancelled*: bool

  PlayerCommandEvent* = object
    ## A command typed by a player, before the server looks at it (this is not a command of a plugin; see `command`).
    player*: Player
    command*: string
    cancelled*: bool

  JoinEvent* = object
    player*: Player
    cancelled*: bool

  LeaveEvent* = object
    player*: Player
    cancelled*: bool

  LoginEvent* = object
    player*: Player
    kickMessage*: string       ## the reason shown when the login is cancelled
    cancelled*: bool

  MoveEvent* = object
    player*: Player
    origin*, target*: Vec3
    cancelled*: bool

  TeleportEvent* = object
    player*: Player
    origin*, target*: Vec3
    cancelled*: bool

  ToggleEvent* = object
    ## Sneaking, sprinting or flying switched on or off.
    player*: Player
    kind*: int
    on*: bool
    cancelled*: bool

  GamemodeChangeEvent* = object
    player*: Player
    previous*, next*: Gamemode
    cancelled*: bool

  ItemHeldEvent* = object
    player*: Player
    previousSlot*, nextSlot*: int
    cancelled*: bool

  InteractEvent* = object
    player*: Player
    action*: int
    x*, y*, z*: int
    cancelled*: bool

  BlockPlaceEvent* = object
    player*: Player
    blockName*: string         ## the block placed, like "minecraft:stone"
    against*: string           ## the block it was placed against
    x*, y*, z*: int
    cancelled*: bool

  ExpChangeEvent* = object
    player*: Player
    amount*: int

  RespawnEvent* = object
    player*: Player
    pos*: Vec3
    alive*: bool

  DeathEvent* = object
    player*: Player
    message*: string

  ServerCommandEvent* = object
    ## A command typed at the server console.
    command*: string
    cancelled*: bool

  BroadcastEvent* = object
    message*, sender*: string
    cancelled*: bool

  ServerLoadEvent* = object
    reload*: bool

  TickStartEvent* = object
    tick*: int

  TickEndEvent* = object
    tick*: int
    durationNs*: int

  PacketEvent* = object
    player*: Player
    packetId*, length*: int
    cancelled*: bool

  RedstoneEvent* = object
    x*, y*, z*: int
    oldCurrent*, newCurrent*: int
    cancelled*: bool

  BlockGrowEvent* = object
    before*, after*: string
    x*, y*, z*: int
    cancelled*: bool

  SpawnChangeEvent* = object
    previous*, next*: Vec3
    yaw*, pitch*: float

  ChunkSendEvent* = object
    x*, z*: int
    cancelled*: bool

type
  SwingEvent* = object
    ## A left click on a block or the air (Bukkit's PlayerAnimationEvent / a left-click PlayerInteractEvent).
    player*: Player
    cancelled*: bool

  UseItemEvent* = object
    ## A right click with an item (a right-click PlayerInteractEvent).
    player*: Player
    cancelled*: bool

  EntityAction* = enum
    eaInteract, eaAttack, eaInteractAt

  InteractEntityEvent* = object
    player*: Player
    entityId*: int
    action*: EntityAction
    sneaking*: bool
    known*: bool               ## false when the entity is one the server does not know
    cancelled*: bool

  CustomPayloadEvent* = object
    ## A plugin message from the client (Bukkit's PlayerRegisterChannelEvent / plugin messaging).
    player*: Player
    channel*: string
    length*: int
    cancelled*: bool

  MainHandChangeEvent* = object
    player*: Player
    hand*: int                 ## 0 left, 1 right

  InventoryCloseEvent* = object
    player*: Player
    window*: int               ## the window type, -1 for the player's own inventory

  InventoryClickEvent* = object
    player*: Player
    window*, clickType*, slot*, rawSlot*, hotbarButton*: int
    cancelled*: bool

  BlockBreakEvent* = object
    player*: Player
    blockName*: string
    x*, y*, z*: int
    drop*: bool                ## whether the block drops its items; change it to stop or force the drops
    cancelled*: bool

  DropItemEvent* = object
    player*: Player
    item*: string
    count*: int
    cancelled*: bool

  PickupItemEvent* = object
    player*: Player
    item*: string
    count*, entityId*: int
    cancelled*: bool

  ItemConsumeEvent* = object
    player*: Player
    item*: string
    cancelled*: bool

  BedEnterEvent* = object
    player*: Player
    x*, y*, z*: int
    cancelled*: bool

  BedLeaveEvent* = object
    player*: Player
    x*, y*, z*: int
    cancelled*: bool

  SignChangeEvent* = object
    player*: Player
    x*, y*, z*: int
    lines*: seq[string]
    cancelled*: bool

  BucketEmptyEvent* = object
    player*: Player
    bucket*: string
    x*, y*, z*: int
    cancelled*: bool

  BucketFillEvent* = object
    player*: Player
    bucket*: string
    x*, y*, z*: int
    cancelled*: bool

  PermissionCheckEvent* = object
    ## Does the player have the permission? `granted` starts as the server's answer; set it to change the answer.
    player*: Player
    node*: string
    granted*: bool

  FishEvent* = object
    player*: Player
    state*: int
    caught*: string
    exp*: int
    cancelled*: bool

  EggThrowEvent* = object
    player*: Player
    hatching*: bool
    numHatches*: int
    hatchingType*: string
    cancelled*: bool

  CustomClickEvent* = object
    player*: Player
    id*: string
    length*: int

  ChangeWorldEvent* = object
    player*: Player
    pos*: Vec3
    yaw*, pitch*: float
    cancelled*: bool

  EntityDamageEvent* = object
    ## A living entity is about to take damage. `amount` may be changed; cancel it to prevent the damage.
    entityId*: int
    entityType*: string        ## like "zombie"
    damageType*: string        ## like "player_attack"
    amount*: float
    attackerId*: int           ## -1 when nothing caused it
    cancelled*: bool

  EntityDeathEvent* = object
    entityId*: int
    entityType*, damageType*: string
    killerId*: int             ## -1 when there was no killer

  EntitySpawnEvent* = object
    entityId*: int
    entityType*: string
    pos*: Vec3

  EntityRemoveEvent* = object
    entityId*: int
    entityType*: string

  ExplosionEvent* = object
    pos*: Vec3
    power*: float
    cancelled*: bool

  WeatherChangeEvent* = object
    raining*, thundering*: bool

type
  HealEvent* = object
    ## A living entity is about to regain health. `amount` may be changed.
    entityId*: int
    entityType*: string
    amount*: float
    cancelled*: bool

  FoodLevelChangeEvent* = object
    player*: Player
    level*: int                ## the new food level (0 to 20); change it to change what the player ends up with
    previous*: int
    cancelled*: bool

  StatisticEvent* = object
    player*: Player
    category*, statId*, amount*: int

  ServerListPingEvent* = object
    ## Someone asks for the server's entry in the multiplayer list. Change `motd` or `maxPlayers` to change what that one asker sees.
    address*: string
    motd*: string
    online*: int
    maxPlayers*: int

  LevelChangeEvent* = object
    player*: Player
    previous*, level*: int

  WorldSaveEvent* = object
    ## The server saved everything.
    saved*: bool

  TimeSetEvent* = object
    ## The time of the day is about to be set (by the `time` command). `time` may be changed.
    previous*: int
    time*: int
    cancelled*: bool

  PreLoginEvent* = object
    ## A client asks to log in. Cancel it to turn it away; `kickMessage` is what it is told.
    name*: string
    address*: string
    kickMessage*: string
    cancelled*: bool

## Stops the server from doing what is happening (the chat message is not sent, the block is not placed ...).
proc cancel*(e: var HealEvent) = e.cancelled = true
proc cancel*(e: var TimeSetEvent) = e.cancelled = true
proc cancel*(e: var FoodLevelChangeEvent) = e.cancelled = true
proc cancel*(e: var PreLoginEvent) = e.cancelled = true
proc cancel*(e: var ChatEvent) = e.cancelled = true
proc cancel*(e: var PlayerCommandEvent) = e.cancelled = true
proc cancel*(e: var JoinEvent) = e.cancelled = true
proc cancel*(e: var LeaveEvent) = e.cancelled = true
proc cancel*(e: var LoginEvent) = e.cancelled = true
proc cancel*(e: var MoveEvent) = e.cancelled = true
proc cancel*(e: var TeleportEvent) = e.cancelled = true
proc cancel*(e: var ToggleEvent) = e.cancelled = true
proc cancel*(e: var GamemodeChangeEvent) = e.cancelled = true
proc cancel*(e: var ItemHeldEvent) = e.cancelled = true
proc cancel*(e: var InteractEvent) = e.cancelled = true
proc cancel*(e: var BlockPlaceEvent) = e.cancelled = true
proc cancel*(e: var ServerCommandEvent) = e.cancelled = true
proc cancel*(e: var BroadcastEvent) = e.cancelled = true
proc cancel*(e: var PacketEvent) = e.cancelled = true
proc cancel*(e: var RedstoneEvent) = e.cancelled = true
proc cancel*(e: var BlockGrowEvent) = e.cancelled = true
proc cancel*(e: var ChunkSendEvent) = e.cancelled = true
proc cancel*(e: var SwingEvent) = e.cancelled = true
proc cancel*(e: var UseItemEvent) = e.cancelled = true
proc cancel*(e: var InteractEntityEvent) = e.cancelled = true
proc cancel*(e: var CustomPayloadEvent) = e.cancelled = true
proc cancel*(e: var InventoryClickEvent) = e.cancelled = true
proc cancel*(e: var BlockBreakEvent) = e.cancelled = true
proc cancel*(e: var DropItemEvent) = e.cancelled = true
proc cancel*(e: var PickupItemEvent) = e.cancelled = true
proc cancel*(e: var ItemConsumeEvent) = e.cancelled = true
proc cancel*(e: var BedEnterEvent) = e.cancelled = true
proc cancel*(e: var BedLeaveEvent) = e.cancelled = true
proc cancel*(e: var SignChangeEvent) = e.cancelled = true
proc cancel*(e: var BucketEmptyEvent) = e.cancelled = true
proc cancel*(e: var BucketFillEvent) = e.cancelled = true
proc cancel*(e: var FishEvent) = e.cancelled = true
proc cancel*(e: var EggThrowEvent) = e.cancelled = true
proc cancel*(e: var ChangeWorldEvent) = e.cancelled = true
proc cancel*(e: var EntityDamageEvent) = e.cancelled = true
proc cancel*(e: var ExplosionEvent) = e.cancelled = true

# ---- the current event, as the host holds it ---------------------------------------------------------------------------------------------

proc evStr(key: string): string = call1("event_str", key)
proc evNum(key: string): float = parseNum(call1("event_num", key))
proc evInt(key: string): int = int(evNum(key))
proc evPlayer(): Player = Player(name: evStr("player"))
proc evVec(prefix: string): Vec3 = Vec3(x: evNum(prefix & "x"), y: evNum(prefix & "y"), z: evNum(prefix & "z"))
proc evMode(key: string): Gamemode =
  let n = evInt(key)
  if n >= 0 and n <= 3: Gamemode(n) else: gmSurvival

# ---- registration: handlers are kept here; `start` tells the host which events the plugin listens to ---------------------------------

var chatHandlers: seq[proc (e: var ChatEvent) {.nimcall.}] = @[]
var playerCommandHandlers: seq[proc (e: var PlayerCommandEvent) {.nimcall.}] = @[]
var joinHandlers: seq[proc (e: var JoinEvent) {.nimcall.}] = @[]
var leaveHandlers: seq[proc (e: var LeaveEvent) {.nimcall.}] = @[]
var loginHandlers: seq[proc (e: var LoginEvent) {.nimcall.}] = @[]
var moveHandlers: seq[proc (e: var MoveEvent) {.nimcall.}] = @[]
var teleportHandlers: seq[proc (e: var TeleportEvent) {.nimcall.}] = @[]
var toggleHandlers: seq[proc (e: var ToggleEvent) {.nimcall.}] = @[]
var gamemodeHandlers: seq[proc (e: var GamemodeChangeEvent) {.nimcall.}] = @[]
var itemHeldHandlers: seq[proc (e: var ItemHeldEvent) {.nimcall.}] = @[]
var interactHandlers: seq[proc (e: var InteractEvent) {.nimcall.}] = @[]
var blockPlaceHandlers: seq[proc (e: var BlockPlaceEvent) {.nimcall.}] = @[]
var expHandlers: seq[proc (e: var ExpChangeEvent) {.nimcall.}] = @[]
var respawnHandlers: seq[proc (e: var RespawnEvent) {.nimcall.}] = @[]
var deathHandlers: seq[proc (e: var DeathEvent) {.nimcall.}] = @[]
var serverCommandHandlers: seq[proc (e: var ServerCommandEvent) {.nimcall.}] = @[]
var broadcastHandlers: seq[proc (e: var BroadcastEvent) {.nimcall.}] = @[]
var serverLoadHandlers: seq[proc (e: var ServerLoadEvent) {.nimcall.}] = @[]
var tickStartHandlers: seq[proc (e: var TickStartEvent) {.nimcall.}] = @[]
var tickEndHandlers: seq[proc (e: var TickEndEvent) {.nimcall.}] = @[]
var packetHandlers: seq[proc (e: var PacketEvent) {.nimcall.}] = @[]
var redstoneHandlers: seq[proc (e: var RedstoneEvent) {.nimcall.}] = @[]
var blockGrowHandlers: seq[proc (e: var BlockGrowEvent) {.nimcall.}] = @[]
var spawnChangeHandlers: seq[proc (e: var SpawnChangeEvent) {.nimcall.}] = @[]
var chunkSendHandlers: seq[proc (e: var ChunkSendEvent) {.nimcall.}] = @[]
var swingHandlers: seq[proc (e: var SwingEvent) {.nimcall.}] = @[]
var useItemHandlers: seq[proc (e: var UseItemEvent) {.nimcall.}] = @[]
var interactEntityHandlers: seq[proc (e: var InteractEntityEvent) {.nimcall.}] = @[]
var customPayloadHandlers: seq[proc (e: var CustomPayloadEvent) {.nimcall.}] = @[]
var mainHandHandlers: seq[proc (e: var MainHandChangeEvent) {.nimcall.}] = @[]
var inventoryCloseHandlers: seq[proc (e: var InventoryCloseEvent) {.nimcall.}] = @[]
var inventoryClickHandlers: seq[proc (e: var InventoryClickEvent) {.nimcall.}] = @[]
var blockBreakHandlers: seq[proc (e: var BlockBreakEvent) {.nimcall.}] = @[]
var dropItemHandlers: seq[proc (e: var DropItemEvent) {.nimcall.}] = @[]
var pickupItemHandlers: seq[proc (e: var PickupItemEvent) {.nimcall.}] = @[]
var itemConsumeHandlers: seq[proc (e: var ItemConsumeEvent) {.nimcall.}] = @[]
var bedEnterHandlers: seq[proc (e: var BedEnterEvent) {.nimcall.}] = @[]
var bedLeaveHandlers: seq[proc (e: var BedLeaveEvent) {.nimcall.}] = @[]
var signChangeHandlers: seq[proc (e: var SignChangeEvent) {.nimcall.}] = @[]
var bucketEmptyHandlers: seq[proc (e: var BucketEmptyEvent) {.nimcall.}] = @[]
var bucketFillHandlers: seq[proc (e: var BucketFillEvent) {.nimcall.}] = @[]
var permissionHandlers: seq[proc (e: var PermissionCheckEvent) {.nimcall.}] = @[]
var fishHandlers: seq[proc (e: var FishEvent) {.nimcall.}] = @[]
var eggThrowHandlers: seq[proc (e: var EggThrowEvent) {.nimcall.}] = @[]
var customClickHandlers: seq[proc (e: var CustomClickEvent) {.nimcall.}] = @[]
var changeWorldHandlers: seq[proc (e: var ChangeWorldEvent) {.nimcall.}] = @[]
var entityDamageHandlers: seq[proc (e: var EntityDamageEvent) {.nimcall.}] = @[]
var entityDeathHandlers: seq[proc (e: var EntityDeathEvent) {.nimcall.}] = @[]
var entitySpawnHandlers: seq[proc (e: var EntitySpawnEvent) {.nimcall.}] = @[]
var entityRemoveHandlers: seq[proc (e: var EntityRemoveEvent) {.nimcall.}] = @[]
var explosionHandlers: seq[proc (e: var ExplosionEvent) {.nimcall.}] = @[]
var weatherHandlers: seq[proc (e: var WeatherChangeEvent) {.nimcall.}] = @[]
var levelHandlers: seq[proc (e: var LevelChangeEvent) {.nimcall.}] = @[]
var saveHandlers: seq[proc (e: var WorldSaveEvent) {.nimcall.}] = @[]
var timeHandlers: seq[proc (e: var TimeSetEvent) {.nimcall.}] = @[]
var healHandlers: seq[proc (e: var HealEvent) {.nimcall.}] = @[]
var foodHandlers: seq[proc (e: var FoodLevelChangeEvent) {.nimcall.}] = @[]
var statisticHandlers: seq[proc (e: var StatisticEvent) {.nimcall.}] = @[]
var serverListHandlers: seq[proc (e: var ServerListPingEvent) {.nimcall.}] = @[]
var preLoginHandlers: seq[proc (e: var PreLoginEvent) {.nimcall.}] = @[]
var wanted: seq[string] = @[]          ## the entries the plugin listens to
var started = false

proc want(entry: string) =
  for w in wanted:
    if w == entry: return
  wanted.add entry
  if started: discard call1("subscribe_event", entry)

proc registerEvent*(h: proc (e: var ChatEvent) {.nimcall.}) =
  chatHandlers.add h
  want("on_player_chat")
proc registerEvent*(h: proc (e: var PlayerCommandEvent) {.nimcall.}) =
  playerCommandHandlers.add h
  want("on_player_command")
proc registerEvent*(h: proc (e: var JoinEvent) {.nimcall.}) =
  joinHandlers.add h
  want("on_player_join")
proc registerEvent*(h: proc (e: var LeaveEvent) {.nimcall.}) =
  leaveHandlers.add h
  want("on_player_leave")
proc registerEvent*(h: proc (e: var LoginEvent) {.nimcall.}) =
  loginHandlers.add h
  want("on_player_login")
proc registerEvent*(h: proc (e: var MoveEvent) {.nimcall.}) =
  moveHandlers.add h
  want("on_player_move")
proc registerEvent*(h: proc (e: var TeleportEvent) {.nimcall.}) =
  teleportHandlers.add h
  want("on_player_teleport")
proc registerEvent*(h: proc (e: var ToggleEvent) {.nimcall.}) =
  toggleHandlers.add h
  want("on_player_toggle")
proc registerEvent*(h: proc (e: var GamemodeChangeEvent) {.nimcall.}) =
  gamemodeHandlers.add h
  want("on_player_gamemode_change")
proc registerEvent*(h: proc (e: var ItemHeldEvent) {.nimcall.}) =
  itemHeldHandlers.add h
  want("on_player_item_held")
proc registerEvent*(h: proc (e: var InteractEvent) {.nimcall.}) =
  interactHandlers.add h
  want("on_player_interact")
proc registerEvent*(h: proc (e: var BlockPlaceEvent) {.nimcall.}) =
  blockPlaceHandlers.add h
  want("on_block_place")
proc registerEvent*(h: proc (e: var ExpChangeEvent) {.nimcall.}) =
  expHandlers.add h
  want("on_player_exp_change")
proc registerEvent*(h: proc (e: var RespawnEvent) {.nimcall.}) =
  respawnHandlers.add h
  want("on_player_respawn")
proc registerEvent*(h: proc (e: var DeathEvent) {.nimcall.}) =
  deathHandlers.add h
  want("on_player_death")
proc registerEvent*(h: proc (e: var ServerCommandEvent) {.nimcall.}) =
  serverCommandHandlers.add h
  want("on_server_command")
proc registerEvent*(h: proc (e: var BroadcastEvent) {.nimcall.}) =
  broadcastHandlers.add h
  want("on_server_broadcast")
proc registerEvent*(h: proc (e: var ServerLoadEvent) {.nimcall.}) =
  serverLoadHandlers.add h
  want("on_server_load")
proc registerEvent*(h: proc (e: var TickStartEvent) {.nimcall.}) =
  tickStartHandlers.add h
  want("on_server_tick_start")
proc registerEvent*(h: proc (e: var TickEndEvent) {.nimcall.}) =
  tickEndHandlers.add h
  want("on_server_tick_end")
proc registerEvent*(h: proc (e: var PacketEvent) {.nimcall.}) =
  packetHandlers.add h
  want("on_packet_received")
proc registerEvent*(h: proc (e: var RedstoneEvent) {.nimcall.}) =
  redstoneHandlers.add h
  want("on_block_redstone")
