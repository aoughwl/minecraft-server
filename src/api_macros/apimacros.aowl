## Port of pumpkin-api-macros/src/lib.rs
## PARTIAL: pumpkin-api-macros/src/lib.rs - upstream is a proc-macro crate. `#[with_runtime(global|local)]` is expressible: aowlmony has no `block_on` (there are no poll futures), so both modes are the body run in place (`withRuntime` below checks the mode word as upstream does). Not expressible: `#[plugin_method]` (rewrites a fn to return `PluginFuture` and stashes its source in a process-global table), `#[plugin_impl]` (drains that table to emit `GLOBAL_RUNTIME`, the `METADATA` and `PUMPKIN_API_VERSION` exported statics, `impl Plugin` and `plugin()`) - the plugin host here (src/plugin) calls a plugin's procs directly, and plugin authors fill the `Plugin` closure fields by hand.

const
  runtimeGlobal* = "global"
  runtimeLocal* = "local"

proc runtimeModeIsGlobal*(mode: string; ok: var bool): bool =
  ## Upstream's mode check: `global` is true, `local` is false, anything else aborts with
  ## "expected `global` or `local`, got `{other}`" (here `ok` is false and the message is `runtimeModeError`).
  ok = true
  if mode == runtimeGlobal: result = true
  elif mode == runtimeLocal: result = false
  else:
    ok = false
    result = false

proc runtimeModeError*(mode: string): string =
  "expected `global` or `local`, got `" & mode & "`"

template withRuntime*(mode: untyped; body: untyped) =
  ## `#[with_runtime(mode)]` on one method body: no runtime to enter, so the body runs in place.
  body
