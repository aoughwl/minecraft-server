import std/syncio
import apimacros

var failures = 0
proc check(ok: bool, what: string) =
  if not ok:
    echo "FAIL: ", what
    failures += 1

var ok = false
check runtimeModeIsGlobal("global", ok) and ok, "global"
check (not runtimeModeIsGlobal("local", ok)) and ok, "local"
discard runtimeModeIsGlobal("other", ok)
check not ok, "bad mode"
check runtimeModeError("x") == "expected `global` or `local`, got `x`", "message"
var n = 0
withRuntime(global):
  n = 5
check n == 5, "body runs"
if failures > 0: quit 1
echo "ok"
