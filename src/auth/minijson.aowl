## Small JSON reader this port uses for tokens, taken from the sibling jwt library before that
## library moved to std/json.
## A minimal JSON parser/value model - just enough to read a JWT header
## and payload (objects, strings, numbers, booleans, null, arrays, nested
## objects). Not a general-purpose JSON library: no writer, no pretty
## printing, no streaming. Nimony's stdlib has no JSON module to build on.

type
  JsonKind* = enum
    jkNull, jkBool, jkNumber, jkString, jkArray, jkObject

  JsonValue* = ref object
    case kind*: JsonKind
    of jkNull: discard
    of jkBool: boolVal*: bool
    of jkNumber: numVal*: float64
    of jkString: strVal*: string
    of jkArray: arrVal*: seq[JsonValue]
    of jkObject:
      objKeys*: seq[string]
      objVals*: seq[JsonValue]

  JsonParseResult* = object
    ok*: bool
    value*: nil JsonValue
    error*: string

proc objGet*(v: nil JsonValue, key: string): nil JsonValue =
  ## Returns the value for `key`, or nil if `v` isn't an object or lacks it.
  if v == nil or v.kind != jkObject:
    return nil
  for i in 0 ..< v.objKeys.len:
    if v.objKeys[i] == key:
      return v.objVals[i]
  nil

type Parser = object
  s: string
  pos: int

proc skipWs(p: var Parser) =
  while p.pos < p.s.len and (p.s[p.pos] == ' ' or p.s[p.pos] == '\t' or
                              p.s[p.pos] == '\n' or p.s[p.pos] == '\r'):
    inc p.pos

proc parseString(p: var Parser): (bool, string) =
  if p.pos >= p.s.len or p.s[p.pos] != '"':
    return (false, "")
  inc p.pos
  var res = ""
  while p.pos < p.s.len and p.s[p.pos] != '"':
    if p.s[p.pos] == '\\' and p.pos + 1 < p.s.len:
      inc p.pos
      let c = p.s[p.pos]
      case c
      of '"': res.add('"')
      of '\\': res.add('\\')
      of '/': res.add('/')
      of 'n': res.add('\n')
      of 't': res.add('\t')
      of 'r': res.add('\r')
      of 'b': res.add('\b')
      of 'f': res.add('\f')
      of 'u':
        # \uXXXX - parse the 4 hex digits and emit as UTF-8. Surrogate
        # pairs aren't handled (not needed for JWT header/payload
        # fields in practice); emit the raw code point as UTF-8 for the
        # BMP range, which covers this library's actual use.
        if p.pos + 4 < p.s.len:
          proc hv(ch: char): int =
            if ch >= '0' and ch <= '9': ord(ch) - ord('0')
            elif ch >= 'a' and ch <= 'f': ord(ch) - ord('a') + 10
            elif ch >= 'A' and ch <= 'F': ord(ch) - ord('A') + 10
            else: 0
          let cp = hv(p.s[p.pos+1])*4096 + hv(p.s[p.pos+2])*256 +
                   hv(p.s[p.pos+3])*16 + hv(p.s[p.pos+4])
          p.pos += 4
          if cp < 0x80:
            res.add(char(cp))
          elif cp < 0x800:
            res.add(char(0xC0 or (cp shr 6)))
            res.add(char(0x80 or (cp and 0x3F)))
          else:
            res.add(char(0xE0 or (cp shr 12)))
            res.add(char(0x80 or ((cp shr 6) and 0x3F)))
            res.add(char(0x80 or (cp and 0x3F)))
      else:
        res.add(c)
      inc p.pos
    else:
      res.add(p.s[p.pos])
      inc p.pos
  if p.pos >= p.s.len:
    return (false, "")
  inc p.pos  # closing quote
  (true, res)

proc parseNumber(p: var Parser): (bool, float64) =
  let start = p.pos
  if p.pos < p.s.len and p.s[p.pos] == '-': inc p.pos
  while p.pos < p.s.len and p.s[p.pos] >= '0' and p.s[p.pos] <= '9': inc p.pos
  if p.pos < p.s.len and p.s[p.pos] == '.':
    inc p.pos
    while p.pos < p.s.len and p.s[p.pos] >= '0' and p.s[p.pos] <= '9': inc p.pos
  if p.pos < p.s.len and (p.s[p.pos] == 'e' or p.s[p.pos] == 'E'):
    inc p.pos
    if p.pos < p.s.len and (p.s[p.pos] == '+' or p.s[p.pos] == '-'): inc p.pos
    while p.pos < p.s.len and p.s[p.pos] >= '0' and p.s[p.pos] <= '9': inc p.pos
  if p.pos == start:
    return (false, 0.0)
  var v = 0.0
  var neg = false
  var i = start
  if p.s[i] == '-': neg = true; inc i
  var intPart = 0.0
  while i < p.pos and p.s[i] >= '0' and p.s[i] <= '9':
    intPart = intPart * 10.0 + float64(ord(p.s[i]) - ord('0'))
    inc i
  v = intPart
  if i < p.pos and p.s[i] == '.':
    inc i
    var frac = 0.0
    var scale = 0.1
    while i < p.pos and p.s[i] >= '0' and p.s[i] <= '9':
      frac += float64(ord(p.s[i]) - ord('0')) * scale
      scale *= 0.1
      inc i
    v += frac
  # Exponent parsing omitted from the numeric result (JWT numeric claims
  # in practice - exp/iat/nbf timestamps - never use exponent notation);
  # the exponent's characters are still consumed above so parsing doesn't
  # desync on one if present.
  if neg: v = -v
  (true, v)

proc parseArray(p: var Parser): (bool, seq[JsonValue]) =
  inc p.pos  # '['
  var items: seq[JsonValue] = @[]
  skipWs(p)
  if p.pos < p.s.len and p.s[p.pos] == ']':
    inc p.pos
    return (true, items)
  while true:
    skipWs(p)
    let (ok, v) = parseValue(p)
    if not ok or v == nil: return (false, items)
    items.add(v)
    skipWs(p)
    if p.pos >= p.s.len: return (false, items)
    if p.s[p.pos] == ',':
      inc p.pos
      continue
    elif p.s[p.pos] == ']':
      inc p.pos
      break
    else:
      return (false, items)
  (true, items)

proc parseObject(p: var Parser): (bool, seq[string], seq[JsonValue]) =
  inc p.pos  # '{'
  var keys: seq[string] = @[]
  var vals: seq[JsonValue] = @[]
  skipWs(p)
  if p.pos < p.s.len and p.s[p.pos] == '}':
    inc p.pos
    return (true, keys, vals)
  while true:
    skipWs(p)
    let (okKey, key) = parseString(p)
    if not okKey: return (false, keys, vals)
    skipWs(p)
    if p.pos >= p.s.len or p.s[p.pos] != ':': return (false, keys, vals)
    inc p.pos
    skipWs(p)
    let (okVal, val) = parseValue(p)
    if not okVal or val == nil: return (false, keys, vals)
    keys.add(key)
    vals.add(val)
    skipWs(p)
    if p.pos >= p.s.len: return (false, keys, vals)
    if p.s[p.pos] == ',':
      inc p.pos
      continue
    elif p.s[p.pos] == '}':
      inc p.pos
      break
    else:
      return (false, keys, vals)
  (true, keys, vals)

proc parseValue(p: var Parser): (bool, nil JsonValue) =
  skipWs(p)
  if p.pos >= p.s.len:
    return (false, nil)
  case p.s[p.pos]
  of '"':
    let (ok, s) = parseString(p)
    if not ok: return (false, nil)
    let v: nil JsonValue = JsonValue(kind: jkString, strVal: s)
    return (true, v)
  of '{':
    let (ok, keys, vals) = parseObject(p)
    if not ok: return (false, nil)
    let v: nil JsonValue = JsonValue(kind: jkObject, objKeys: keys, objVals: vals)
    return (true, v)
  of '[':
    let (ok, items) = parseArray(p)
    if not ok: return (false, nil)
    let v: nil JsonValue = JsonValue(kind: jkArray, arrVal: items)
    return (true, v)
  of 't':
    if p.pos + 4 <= p.s.len and p.s[p.pos ..< p.pos+4] == "true":
      p.pos += 4
      let v: nil JsonValue = JsonValue(kind: jkBool, boolVal: true)
      return (true, v)
    else: return (false, nil)
  of 'f':
    if p.pos + 5 <= p.s.len and p.s[p.pos ..< p.pos+5] == "false":
      p.pos += 5
      let v: nil JsonValue = JsonValue(kind: jkBool, boolVal: false)
      return (true, v)
    else: return (false, nil)
  of 'n':
    if p.pos + 4 <= p.s.len and p.s[p.pos ..< p.pos+4] == "null":
      p.pos += 4
      let v: nil JsonValue = JsonValue(kind: jkNull)
      return (true, v)
    else: return (false, nil)
  else:
    let (ok, n) = parseNumber(p)
    if not ok: return (false, nil)
    let v: nil JsonValue = JsonValue(kind: jkNumber, numVal: n)
    return (true, v)

proc parseJson*(s: string): JsonParseResult =
  var p = Parser(s: s, pos: 0)
  let (ok, v) = parseValue(p)
  skipWs(p)
  if not ok:
    return JsonParseResult(ok: false, value: nil, error: "parse error at byte " & $p.pos)
  if p.pos != s.len:
    return JsonParseResult(ok: false, value: nil, error: "trailing data at byte " & $p.pos)
  JsonParseResult(ok: true, value: v, error: "")
