## Test for winhttp.aowl: URL parsing, the stand-in transports, and the real client when a URL is given.
##
##     winhttptest                      pure checks only, no network
##     winhttptest <url> <status> <text>   also GETs <url> and expects that status and a body containing <text>

import std/[os, syncio, assertions]
import winhttp

proc contains(s, sub: string): bool =
  if sub.len == 0:
    return true
  if s.len < sub.len:
    return false
  for i in 0 .. s.len - sub.len:
    if s[i ..< i + sub.len] == sub:
      return true
  false

proc run(): int =
  var u = parseUrl("https://sessionserver.mojang.com/session/minecraft/hasJoined?username=a&serverId=b")
  assert u.ok and u.secure and u.host == "sessionserver.mojang.com" and u.port == 443
  assert u.path == "/session/minecraft/hasJoined?username=a&serverId=b"
  u = parseUrl("http://127.0.0.1:43211/x")
  assert u.ok and not u.secure and u.host == "127.0.0.1" and u.port == 43211 and u.path == "/x"
  u = parseUrl("http://localhost")
  assert u.ok and u.port == 80 and u.path == "/"
  u = parseUrl("http://h?q=1")
  assert u.ok and u.path == "/?q=1"
  assert not parseUrl("ftp://h/").ok
  assert not parseUrl("http://h:99999/").ok
  assert not parseUrl("http://:80/").ok
  assert not parseUrl("http://h:/").ok

  let fake = newFakeTransport(200, "{\"id\":\"x\"}")
  let r = fake.get("http://x/y")
  assert r.ok and r.status == 200 and r.body == "{\"id\":\"x\"}"
  assert fake.urls.len == 1 and fake.urls[0] == "http://x/y"
  let down = newDownTransport()
  assert not down.get("http://x/y").ok

  if paramCount() >= 3:
    let real = newWinHttpTransport()
    let resp = real.get(paramStr(1), 5000, 8000)
    echo "GET ", paramStr(1), " -> ok=", resp.ok, " status=", resp.status, " body=", resp.body.len, " bytes ", resp.error
    if not resp.ok:
      return 1
    if $resp.status != paramStr(2):
      echo "FAIL: wanted status ", paramStr(2)
      return 1
    if not contains(resp.body, paramStr(3)):
      echo "FAIL: body lacks ", paramStr(3)
      return 1
    echo "body: ", resp.body
  echo "winhttptest ok"
  0

quit(run())
