    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial, r3.valueOrPartial, r4.valueOrPartial, r5.valueOrPartial), experimental())
  else:
    newErrorWithLifecycle[T](message, experimental())

proc apply6*[R, R2, R3, R4, R5, R6, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4, a5: R5, a6: R6): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3], r4: DataResult[R4], r5: DataResult[R5], r6: DataResult[R6]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError or r4.isError or r5.isError or r6.isError):
