    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial, r3.valueOrPartial, r4.valueOrPartial, r5.valueOrPartial, r6.valueOrPartial, r7.valueOrPartial), experimental())
