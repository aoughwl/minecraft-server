    newErrorWithLifecycle[T](message, experimental())

proc apply7*[R, R2, R3, R4, R5, R6, R7, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4, a5: R5, a6: R6, a7: R7): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3], r4: DataResult[R4], r5: DataResult[R5], r6: DataResult[R6], r7: DataResult[R7]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError or r4.isError or r5.isError or r6.isError or r7.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult, r4.successResult, r5.successResult, r6.successResult, r7.successResult))
