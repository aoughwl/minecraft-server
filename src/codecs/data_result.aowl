  else:
    newErrorWithLifecycle[T](message, experimental())

proc apply10*[R, R2, R3, R4, R5, R6, R7, R8, R9, R10, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4, a5: R5, a6: R6, a7: R7, a8: R8, a9: R9, a10: R10): T {.closure.},
