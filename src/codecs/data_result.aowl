## Port of pumpkin-codecs/src/data_result.rs
## A result that is a complete success, or a partial or no result with an error message, and a
## `Lifecycle` either way.
##
## `Option<R>` for the partial stays `seq[R]` (0 or 1 elements) because `partialResult`, `intoResult` and
## `intoResultOrPartial` are exports others read; std/options works for every `R` used here, so
## `intoOption`, `intoOptionOrPartial` and `resultOrPartial` give the `Option` view.
##
## Rust's `flat_map` closure: `flatMap` exists, but a closure built inside a generic proc may not call a
## closure-typed value (compiler bug), so generic callers write the combinator out:
##     if not d.hasResultOrPartial: return propagateError[R, T](d)
##     flatMapJoin(d, work(d.valueOrPartial))
## `flatMapJoin` is everything `flat_map` does after calling `f`. `combineMessages` plus `bothHaveValues`
## do the same for `apply_2`. `assert_success!` and friends are in codec_core.aowl.

{.feature: "untyped".}

import std/options
import lifecycle

type
  DataResult*[R] = object
    case isSuccess*: bool
    of true:
      successResult*: R
      successLifecycle*: Lifecycle
    of false:
      partialResult*: seq[R] ## 0 or 1 elements standing in for `Option<R>`.
      errorLifecycle*: Lifecycle
      message*: string

  Unit* = object ## Rust's `()`, for `DataResult<()>`.

  ApplyFn*[R, T] = proc (r: R): T {.closure.} ## The function type `apply` takes, see `apply`.

proc lifecycleOf*[R](d: DataResult[R]): Lifecycle =
  if d.isSuccess: d.successLifecycle else: d.errorLifecycle

proc withLifecycle*[R](d: sink DataResult[R], newLifecycle: Lifecycle): DataResult[R] =
  result = d
  if result.isSuccess:
    result.successLifecycle = newLifecycle
  else:
    result.errorLifecycle = newLifecycle

proc addLifecycle*[R](d: sink DataResult[R], added: Lifecycle): DataResult[R] =
  withLifecycle(d, add(lifecycleOf(d), added))

proc newSuccessWithLifecycle*[R](value: sink R, lifecycle: Lifecycle): DataResult[R] =
  DataResult[R](isSuccess: true, successResult: value, successLifecycle: lifecycle)

proc newSuccess*[R](value: sink R): DataResult[R] =
  newSuccessWithLifecycle(value, experimental())

proc newErrorWithLifecycle*[R](message: string, lifecycle: Lifecycle): DataResult[R] =
  DataResult[R](isSuccess: false, partialResult: @[], errorLifecycle: lifecycle, message: message)

proc newError*[R](message: string): DataResult[R] =
  newErrorWithLifecycle[R](message, experimental())

proc newPartialErrorWithLifecycle*[R](message: string, partial: sink R, lifecycle: Lifecycle): DataResult[R] =
  DataResult[R](isSuccess: false, partialResult: @[partial], errorLifecycle: lifecycle, message: message)

proc newPartialError*[R](message: string, partial: sink R): DataResult[R] =
  newPartialErrorWithLifecycle(message, partial, experimental())

proc newOptionErrorWithLifecycle*[R](message: string, partial: seq[R], lifecycle: Lifecycle): DataResult[R] =
  ## `partial` has 0 or 1 elements.
  DataResult[R](isSuccess: false, partialResult: partial, errorLifecycle: lifecycle, message: message)

proc defaultDataResult*[R](): DataResult[R] =
  ## `impl Default for DataResult`.
  newError[R]("Default DataResult")

proc isError*[R](d: DataResult[R]): bool {.inline.} =
  not d.isSuccess

proc intoResult*[R](d: sink DataResult[R]): seq[R] =
  ## 0 or 1 elements in place of `Option<R>`.
  if d.isSuccess: @[d.successResult] else: @[]

proc intoResultOrPartial*[R](d: sink DataResult[R]): seq[R] =
  if d.isSuccess:
    @[d.successResult]
  else:
    d.partialResult

proc intoOption*[R](d: DataResult[R]): Option[R] =
  ## `into_result` with a real `Option`.
  if d.isSuccess: some(d.successResult) else: none[R]()

proc intoOptionOrPartial*[R](d: DataResult[R]): Option[R] =
  ## `into_result_or_partial` with a real `Option`.
  if d.isSuccess: some(d.successResult)
  elif d.partialResult.len > 0: some(d.partialResult[0])
  else: none[R]()

proc resultOrPartial*[R](d: DataResult[R]): Option[R] =
  ## `result_or_partial_as_ref`.
  intoOptionOrPartial(d)

proc hasResultOrPartial*[R](d: DataResult[R]): bool =
  d.isSuccess or d.partialResult.len > 0

proc valueOrPartial*[R](d: DataResult[R]): R =
  ## The complete or partial value. Check `hasResultOrPartial` first.
  if d.isSuccess: d.successResult else: d.partialResult[0]

proc expect*[R](d: DataResult[R], message: string): R =
  if d.isSuccess: d.successResult
  else: quit(message)

proc expectOrPartial*[R](d: DataResult[R], message: string): R =
  if d.hasResultOrPartial: d.valueOrPartial
  else: quit(message)

proc unwrap*[R](d: DataResult[R]): R =
  expect(d, "No complete result found for DataResult")

proc unwrapOrPartial*[R](d: DataResult[R]): R =
  expectOrPartial(d, "No complete or partial result found for DataResult")

proc appendMessages*(first, second: string): string =
  first & "; " & second

proc map*[R, T](d: DataResult[R], op: proc (r: R): T {.closure.}): DataResult[T] =
  if d.isSuccess:
    newSuccessWithLifecycle(op(d.successResult), d.successLifecycle)
  elif d.partialResult.len > 0:
    newPartialErrorWithLifecycle(d.message, op(d.partialResult[0]), d.errorLifecycle)
  else:
    newErrorWithLifecycle[T](d.message, d.errorLifecycle)

proc mapOrElse*[R, T](d: DataResult[R], default: proc (d: DataResult[R]): T {.closure.},
                      f: proc (r: R): T {.closure.}): T =
  if d.isSuccess: f(d.successResult) else: default(d)

proc propagateError*[R, T](d: DataResult[R]): DataResult[T] =
  ## The arm of `flat_map` for an error with no result. `d` must have no value.
  newErrorWithLifecycle[T](d.message, d.errorLifecycle)

proc flatMapJoin*[R, T](first: DataResult[R], second: DataResult[T]): DataResult[T] =
  ## What `flat_map` does once `f` has returned `second`, for a `first` that had a value.
  if first.isSuccess:
    return addLifecycle(second, first.successLifecycle)
  let newLifecycle = add(lifecycleOf(second), first.errorLifecycle)
  if second.isSuccess:
    newPartialErrorWithLifecycle(first.message, second.successResult, newLifecycle)
  else:
    newOptionErrorWithLifecycle(appendMessages(first.message, second.message), second.partialResult, newLifecycle)

proc flatMap*[R, T](d: DataResult[R], f: proc (r: R): DataResult[T] {.closure.}): DataResult[T] =
  if d.hasResultOrPartial:
    flatMapJoin(d, f(d.valueOrPartial))
  else:
    propagateError[R, T](d)

proc apply*[R, T](d: DataResult[R], functionResult: DataResult[ApplyFn[R, T]]): DataResult[T] =
  ## Spell the function result's type with `ApplyFn`: a proc type written out does not match (compiler bug).
  let lifecycle = add(lifecycleOf(d), lifecycleOf(functionResult))
  if d.isSuccess and functionResult.isSuccess:
    let f = functionResult.successResult
    return newSuccessWithLifecycle(f(d.successResult), lifecycle)
  let message =
    if d.isSuccess: functionResult.message
    elif functionResult.isSuccess: d.message
    else: appendMessages(d.message, functionResult.message)
  if d.hasResultOrPartial and functionResult.hasResultOrPartial:
    let f = functionResult.valueOrPartial
    newPartialErrorWithLifecycle(message, f(d.valueOrPartial), lifecycle)
  else:
    newErrorWithLifecycle[T](message, lifecycle)

proc combineMessages*[R, R2](d: DataResult[R], second: DataResult[R2]): string =
  ## The `messages.join("; ")` of `apply_2`.
  if d.isError and second.isError: appendMessages(d.message, second.message)
  elif d.isError: d.message
  else: second.message

proc bothHaveValues*[R, R2](d: DataResult[R], second: DataResult[R2]): bool =
  d.hasResultOrPartial and second.hasResultOrPartial

proc apply2AndMakeStable*[R, R2, T](d: DataResult[R], f: proc (a: R, a2: R2): T {.closure.},
                                    second: DataResult[R2]): DataResult[T] =
  withLifecycle(apply2(d, f, second), stable())

proc mapError*[R](d: DataResult[R], f: proc (m: string): string {.closure.}): DataResult[R] =
  if d.isSuccess: d
  else: newOptionErrorWithLifecycle(f(d.message), d.partialResult, d.errorLifecycle)

proc promotePartial*[R](d: DataResult[R], f: proc (m: string) {.closure.}): DataResult[R] =
  if d.isSuccess:
    return d
  f(d.message)
  if d.partialResult.len > 0:
    newSuccessWithLifecycle(d.partialResult[0], d.errorLifecycle)
  else:
    newErrorWithLifecycle[R](d.message, d.errorLifecycle)

proc withPartial*[R](d: DataResult[R], partialValue: R): DataResult[R] =
  if d.isSuccess: d
  else: newPartialErrorWithLifecycle(d.message, partialValue, d.errorLifecycle)

proc withCompleteOrPartial*[R, T](d: DataResult[R], value: T): DataResult[T] =
  if d.isSuccess:
    newSuccessWithLifecycle(value, d.successLifecycle)
  elif d.partialResult.len > 0:
    newPartialErrorWithLifecycle(d.message, value, d.errorLifecycle)
  else:
    newErrorWithLifecycle[T](d.message, d.errorLifecycle)

proc addMessage*[R, T](d: DataResult[R], other: DataResult[T]): DataResult[R] =
  if d.isSuccess and other.isSuccess:
    newSuccessWithLifecycle(d.successResult, stable())
  elif d.isError and other.isError:
    let partial = if d.partialResult.len > 0 and other.partialResult.len > 0: d.partialResult else: @[]
    newOptionErrorWithLifecycle(appendMessages(d.message, other.message), partial, stable())
  elif d.isError:
    newOptionErrorWithLifecycle(d.message, d.partialResult, stable())
  else:
    let partial = if other.partialResult.len > 0: @[d.successResult] else: @[]
    newOptionErrorWithLifecycle(other.message, partial, stable())

proc withErrorsFrom*[R, T](d: DataResult[R], other: DataResult[T]): DataResult[R] =
  if d.isError or other.isSuccess:
    d
  else:
    newPartialErrorWithLifecycle(other.message, d.successResult, add(d.successLifecycle, other.errorLifecycle))

proc getMessage*[R](d: DataResult[R]): Option[string] =
  if d.isSuccess: none[string]() else: some(d.message)

# --- FlatTryFrom ---------------------------------------------------------------------------------

proc flatTryFrom*[T](target: typedesc[T], value: T): DataResult[T] =
  ## `impl FlatTryFrom<T> for T`. A conversion is an overload:
  ## `proc flatTryFrom*(target: typedesc[BlockPos], value: IntStream): DataResult[BlockPos]`.
  newSuccess(value)

proc flatTryInto*[T, U](value: T, target: typedesc[U]): DataResult[U] =
  mixin flatTryFrom
  flatTryFrom(U, value)

# --- apply_2 to apply_16 (impl_apply!), generated by writing out the macro ----------------------

proc apply2*[R, R2, T](d: DataResult[R], f: proc (a: R, a2: R2): T {.closure.},
    r2: DataResult[R2]): DataResult[T] =
  if not (d.isError or r2.isError):
    return newSuccess(f(d.successResult, r2.successResult))
  var message = ""
  var count = 0
  if d.isError:
    if count > 0: message.add "; "
    message.add d.message
    inc count
  if r2.isError:
    if count > 0: message.add "; "
    message.add r2.message
    inc count
  if d.hasResultOrPartial and r2.hasResultOrPartial:
    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial), experimental())
  else:
    newErrorWithLifecycle[T](message, experimental())

proc apply3*[R, R2, R3, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult))
  var message = ""
  var count = 0
  if d.isError:
    if count > 0: message.add "; "
    message.add d.message
    inc count
  if r2.isError:
    if count > 0: message.add "; "
    message.add r2.message
    inc count
  if r3.isError:
    if count > 0: message.add "; "
    message.add r3.message
    inc count
  if d.hasResultOrPartial and r2.hasResultOrPartial and r3.hasResultOrPartial:
    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial, r3.valueOrPartial), experimental())
  else:
    newErrorWithLifecycle[T](message, experimental())

proc apply4*[R, R2, R3, R4, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3], r4: DataResult[R4]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError or r4.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult, r4.successResult))
  var message = ""
  var count = 0
  if d.isError:
    if count > 0: message.add "; "
    message.add d.message
    inc count
  if r2.isError:
    if count > 0: message.add "; "
    message.add r2.message
    inc count
  if r3.isError:
    if count > 0: message.add "; "
    message.add r3.message
    inc count
  if r4.isError:
    if count > 0: message.add "; "
    message.add r4.message
    inc count
  if d.hasResultOrPartial and r2.hasResultOrPartial and r3.hasResultOrPartial and r4.hasResultOrPartial:
    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial, r3.valueOrPartial, r4.valueOrPartial), experimental())
  else:
    newErrorWithLifecycle[T](message, experimental())

proc apply5*[R, R2, R3, R4, R5, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4, a5: R5): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3], r4: DataResult[R4], r5: DataResult[R5]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError or r4.isError or r5.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult, r4.successResult, r5.successResult))
  var message = ""
