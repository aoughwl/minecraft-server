proc apply8*[R, R2, R3, R4, R5, R6, R7, R8, T](d: DataResult[R], f: proc (a: R, a2: R2, a3: R3, a4: R4, a5: R5, a6: R6, a7: R7, a8: R8): T {.closure.},
    r2: DataResult[R2], r3: DataResult[R3], r4: DataResult[R4], r5: DataResult[R5], r6: DataResult[R6], r7: DataResult[R7], r8: DataResult[R8]): DataResult[T] =
  if not (d.isError or r2.isError or r3.isError or r4.isError or r5.isError or r6.isError or r7.isError or r8.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult, r4.successResult, r5.successResult, r6.successResult, r7.successResult, r8.successResult))
  var message = ""
  var count = 0
  if d.isError:
    if count > 0: message.add "; "
    message.add d.message
    inc count
  if r2.isError:
    if count > 0: message.add "; "
    message.add r2.message
    inc count
  if r3.isError:
    if count > 0: message.add "; "
    message.add r3.message
    inc count
  if r4.isError:
    if count > 0: message.add "; "
    message.add r4.message
    inc count
  if r5.isError:
    if count > 0: message.add "; "
    message.add r5.message
    inc count
  if r6.isError:
    if count > 0: message.add "; "
    message.add r6.message
    inc count
  if r7.isError:
    if count > 0: message.add "; "
    message.add r7.message
    inc count
  if r8.isError:
    if count > 0: message.add "; "
    message.add r8.message
    inc count
  if d.hasResultOrPartial and r2.hasResultOrPartial and r3.hasResultOrPartial and r4.hasResultOrPartial and r5.hasResultOrPartial and r6.hasResultOrPartial and r7.hasResultOrPartial and r8.hasResultOrPartial:
    newPartialErrorWithLifecycle(message, f(d.valueOrPartial, r2.valueOrPartial, r3.valueOrPartial, r4.valueOrPartial, r5.valueOrPartial, r6.valueOrPartial, r7.valueOrPartial, r8.valueOrPartial), experimental())
