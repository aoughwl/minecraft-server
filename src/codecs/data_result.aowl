  if not (d.isError or r2.isError or r3.isError or r4.isError or r5.isError or r6.isError or r7.isError or r8.isError or r9.isError):
    return newSuccess(f(d.successResult, r2.successResult, r3.successResult, r4.successResult, r5.successResult, r6.successResult, r7.successResult, r8.successResult, r9.successResult))
  var message = ""
  var count = 0
  if d.isError:
    if count > 0: message.add "; "
    message.add d.message
    inc count
  if r2.isError:
    if count > 0: message.add "; "
    message.add r2.message
    inc count
  if r3.isError:
    if count > 0: message.add "; "
