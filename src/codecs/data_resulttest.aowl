## Known answers for data_result.aowl. Upstream has no tests of its own here; each case follows the Rust match arms.

{.feature: "untyped".}

import std/[syncio, options]
import data_result, lifecycle

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc checkLc(a, b: Lifecycle, what: string) =
  if not (a == b):
    echo "FAIL ", what, ": got ", $a, " want ", $b
    inc failures

proc ok(x: int32): DataResult[int32] = newSuccessWithLifecycle(x, stable())
proc partial(m: string, x: int32): DataResult[int32] = newPartialErrorWithLifecycle(m, x, deprecated(5'u32))
proc nores(m: string): DataResult[int32] = newErrorWithLifecycle[int32](m, stable())

proc addOne(x: int32): int32 = x + 1
let double = proc (x: int32): int32 {.closure.} = x * 2
let plus = proc (a: int32, b: int32): int32 {.closure.} = a + b

proc constructors() =
  checkLc(newSuccess(1'i32).lifecycleOf, experimental(), "new_success is experimental")
  checkLc(newError[int32]("e").lifecycleOf, experimental(), "new_error is experimental")
  checkLc(newPartialError("e", 1'i32).lifecycleOf, experimental(), "new_partial_error is experimental")
  checkEq(defaultDataResult[int32]().message, "Default DataResult", "default")
  check(ok(1).isSuccess and not ok(1).isError, "success flags")
  check(nores("e").isError and not nores("e").isSuccess, "error flags")
  checkLc(withLifecycle(ok(1), deprecated(1'u32)).lifecycleOf, deprecated(1'u32), "with_lifecycle success")
  checkLc(withLifecycle(nores("e"), deprecated(1'u32)).lifecycleOf, deprecated(1'u32), "with_lifecycle error")
  checkLc(addLifecycle(ok(1), deprecated(3'u32)).lifecycleOf, deprecated(3'u32), "add_lifecycle")
  checkLc(addLifecycle(partial("e", 1), deprecated(3'u32)).lifecycleOf, deprecated(3'u32), "add_lifecycle keeps earlier")
  checkLc(addLifecycle(partial("e", 1), experimental()).lifecycleOf, experimental(), "add_lifecycle experimental")

proc accessors() =
  check(intoResult(ok(1)) == @[1'i32], "into_result success")
  check(intoResult(partial("e", 1)).len == 0, "into_result partial")
  check(intoResultOrPartial(partial("e", 1)) == @[1'i32], "into_result_or_partial")
  check(intoResultOrPartial(nores("e")).len == 0, "into_result_or_partial none")
  check(intoOption(ok(1)).get == 1'i32, "intoOption success")
  check(intoOption(partial("e", 1)).isNone, "intoOption partial")
  check(intoOptionOrPartial(partial("e", 1)).get == 1'i32, "intoOptionOrPartial partial")
  check(intoOptionOrPartial(nores("e")).isNone, "intoOptionOrPartial none")
  check(resultOrPartial(ok(2)).get == 2'i32, "result_or_partial_as_ref")
  check(unwrap(ok(1)) == 1'i32, "unwrap")
  check(unwrapOrPartial(partial("e", 1)) == 1'i32, "unwrap_or_partial")
  check(expect(ok(1), "x") == 1'i32, "expect")
  check(expectOrPartial(partial("e", 1), "x") == 1'i32, "expect_or_partial")
  check(hasResultOrPartial(ok(1)), "has success")
  check(hasResultOrPartial(partial("e", 1)), "has partial")
  check(not hasResultOrPartial(nores("e")), "has none")
  check(getMessage(ok(1)).isNone, "get_message success")
  checkEq(getMessage(nores("m")).get, "m", "get_message error")
  checkEq(appendMessages("a", "b"), "a; b", "append_messages")

proc mapping() =
  let m1 = map(ok(1), addOne)
  check(m1.successResult == 2'i32, "map success")
  checkLc(m1.lifecycleOf, stable(), "map keeps lifecycle")
  let m2 = map(partial("e", 1), double)
  check(m2.partialResult == @[2'i32], "map partial")
  checkEq(m2.message, "e", "map partial message")
  checkLc(m2.lifecycleOf, deprecated(5'u32), "map partial lifecycle")
  let m3 = map(nores("e"), double)
  check(m3.isError and m3.partialResult.len == 0, "map none")

  let toStr = proc (x: int32): string {.closure.} = $x
  let fromErr = proc (d: DataResult[int32]): string {.closure.} = "err:" & d.message
  checkEq(mapOrElse(ok(3), fromErr, toStr), "3", "map_or_else success")
  checkEq(mapOrElse(partial("e", 3), fromErr, toStr), "err:e", "map_or_else partial")

proc flatMapping() =
  let good = proc (x: int32): DataResult[string] {.closure.} = newSuccessWithLifecycle($x, deprecated(9'u32))
  let bad = proc (x: int32): DataResult[string] {.closure.} = newErrorWithLifecycle[string]("second", stable())
  let badPartial = proc (x: int32): DataResult[string] {.closure.} = newPartialErrorWithLifecycle("second", "p", stable())

  # Success: f(result).add_lifecycle(lifecycle)
  let a = flatMap(ok(1), good)
  checkEq(a.successResult, "1", "flat_map success")
  checkLc(a.lifecycleOf, deprecated(9'u32), "flat_map success lifecycle")
  checkLc(flatMap(newSuccess(1'i32), good).lifecycleOf, experimental(), "flat_map experimental first")
  # Partial, then a success: the first message stays with the new value as a partial.
  let b = flatMap(partial("first", 1), good)
  checkEq(b.message, "first", "flat_map partial then success message")
  check(b.partialResult == @["1"], "flat_map partial then success value")
  checkLc(b.lifecycleOf, deprecated(5'u32), "flat_map partial then success lifecycle")
  # Partial, then an error: messages stack.
  let c = flatMap(partial("first", 1), bad)
  checkEq(c.message, "first; second", "flat_map partial then error message")
  check(c.partialResult.len == 0, "flat_map partial then error has no value")
  let d = flatMap(partial("first", 1), badPartial)
  checkEq(d.message, "first; second", "flat_map partial then partial message")
  check(d.partialResult == @["p"], "flat_map partial then partial value")
  # No result: f is not called.
  var called = false
  let e = flatMap(nores("first"), proc (x: int32): DataResult[string] {.closure.} =
    called = true
    newSuccess("x"))
  check(not called, "flat_map no result does not call f")
  checkEq(e.message, "first", "flat_map no result message")
  checkLc(e.lifecycleOf, stable(), "flat_map no result keeps lifecycle")

proc applying() =
  let f: ApplyFn[int32, string] = proc (r: int32): string {.closure.} = "v" & $r
  let fOk = newSuccessWithLifecycle(f, stable())
  let fPartial = newPartialErrorWithLifecycle("fe", f, deprecated(2'u32))
  let fNone = newErrorWithLifecycle[ApplyFn[int32, string]]("fe", stable())

  let a = apply(ok(1), fOk)
  checkEq(a.successResult, "v1", "apply both success")
  checkLc(a.lifecycleOf, stable(), "apply both success lifecycle")
  let b = apply(ok(1), fPartial)
  checkEq(b.message, "fe", "apply function partial message")
  check(b.partialResult == @["v1"], "apply function partial value")
  checkLc(b.lifecycleOf, deprecated(2'u32), "apply function partial lifecycle")
  let c = apply(ok(1), fNone)
  check(c.partialResult.len == 0, "apply function none")
  checkEq(c.message, "fe", "apply function none message")
  let d = apply(partial("e", 1), fOk)
  check(d.partialResult == @["v1"], "apply value partial")
  checkEq(d.message, "e", "apply value partial message")
  let e = apply(nores("e"), fOk)
  check(e.partialResult.len == 0, "apply value none")
  let g = apply(partial("e", 1), fPartial)
  checkEq(g.message, "e; fe", "apply both errors message")
  check(g.partialResult == @["v1"], "apply both partial value")
  let h = apply(nores("e"), fPartial)
  check(h.partialResult.len == 0, "apply no value")
  checkEq(h.message, "e; fe", "apply no value message")

proc applyN() =
  # apply_2
  let a = apply2(ok(1), plus, ok(2))
  check(a.successResult == 3'i32, "apply_2")
  checkLc(a.lifecycleOf, experimental(), "apply_2 success is new_success")
  let b = apply2(partial("x", 1), plus, partial("y", 2))
  checkEq(b.message, "x; y", "apply_2 two messages")
  check(b.partialResult == @[3'i32], "apply_2 both partial")
  checkLc(b.lifecycleOf, experimental(), "apply_2 error is experimental")
  let c = apply2(partial("x", 1), plus, nores("y"))
  check(c.partialResult.len == 0, "apply_2 one no result")
  let d = apply2(ok(1), plus, partial("y", 2))
  checkEq(d.message, "y", "apply_2 second message")
  check(d.partialResult == @[3'i32], "apply_2 success and partial")
  checkLc(apply2AndMakeStable(ok(1), plus, ok(2)).lifecycleOf, stable(), "apply_2_and_make_stable")
  checkLc(apply2AndMakeStable(ok(1), plus, nores("n")).lifecycleOf, stable(), "apply_2_and_make_stable error")

  # Different types
  let join = proc (a: int32, b: string, c: bool): string {.closure.} = $a & b & $c
  checkEq(apply3(ok(1), join, newSuccess("s"), newSuccess(true)).successResult, "1strue", "apply_3")
  let bad3 = apply3(nores("a"), join, newError[string]("b"), newError[bool]("c"))
  checkEq(bad3.message, "a; b; c", "apply_3 messages")

  let f4 = proc (a, b, c, d: int32): int32 {.closure.} = a + b + c + d
  check(apply4(ok(1), f4, ok(2), ok(3), ok(4)).successResult == 10'i32, "apply_4")
  let f5 = proc (a, b, c, d, e: int32): int32 {.closure.} = a + b + c + d + e
  check(apply5(ok(1), f5, ok(2), ok(3), ok(4), ok(5)).successResult == 15'i32, "apply_5")
  let f6 = proc (a, b, c, d, e, f: int32): int32 {.closure.} = a + b + c + d + e + f
  check(apply6(ok(1), f6, ok(2), ok(3), ok(4), ok(5), ok(6)).successResult == 21'i32, "apply_6")
  let f7 = proc (a, b, c, d, e, f, g: int32): int32 {.closure.} = a + b + c + d + e + f + g
  check(apply7(ok(1), f7, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7)).successResult == 28'i32, "apply_7")
  let f8 = proc (a, b, c, d, e, f, g, h: int32): int32 {.closure.} = a + b + c + d + e + f + g + h
  check(apply8(ok(1), f8, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8)).successResult == 36'i32, "apply_8")
  let f9 = proc (a, b, c, d, e, f, g, h, i: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i
  check(apply9(ok(1), f9, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9)).successResult == 45'i32, "apply_9")
  let f10 = proc (a, b, c, d, e, f, g, h, i, j: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j
  check(apply10(ok(1), f10, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10)).successResult == 55'i32, "apply_10")
  let f11 = proc (a, b, c, d, e, f, g, h, i, j, k: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k
  check(apply11(ok(1), f11, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11)).successResult == 66'i32, "apply_11")
  let f12 = proc (a, b, c, d, e, f, g, h, i, j, k, l: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k + l
  check(apply12(ok(1), f12, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12)).successResult == 78'i32, "apply_12")
  let f13 = proc (a, b, c, d, e, f, g, h, i, j, k, l, m: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k + l + m
  check(apply13(ok(1), f13, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12), ok(13)).successResult == 91'i32, "apply_13")
  let f14 = proc (a, b, c, d, e, f, g, h, i, j, k, l, m, n: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k + l + m + n
  check(apply14(ok(1), f14, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12), ok(13), ok(14)).successResult == 105'i32, "apply_14")
  let f15 = proc (a, b, c, d, e, f, g, h, i, j, k, l, m, n, o: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o
  check(apply15(ok(1), f15, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12), ok(13), ok(14), ok(15)).successResult == 120'i32, "apply_15")
  let f16 = proc (a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p: int32): int32 {.closure.} = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p
  let all16 = apply16(ok(1), f16, ok(2), ok(3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12), ok(13), ok(14), ok(15), ok(16))
  check(all16.successResult == 136'i32, "apply_16")
  let bad16 = apply16(nores("a"), f16, ok(2), partial("c", 3), ok(4), ok(5), ok(6), ok(7), ok(8), ok(9), ok(10), ok(11), ok(12), ok(13), ok(14), ok(15), nores("p"))
  checkEq(bad16.message, "a; c; p", "apply_16 messages")
  check(bad16.partialResult.len == 0, "apply_16 no result")

proc errorTools() =
  let up = proc (m: string): string {.closure.} = m & "!"
  check(mapError(ok(1), up).isSuccess, "map_error success")
  checkEq(mapError(partial("m", 1), up).message, "m!", "map_error message")
  check(mapError(partial("m", 1), up).partialResult == @[1'i32], "map_error keeps partial")
  checkLc(mapError(partial("m", 1), up).lifecycleOf, deprecated(5'u32), "map_error keeps lifecycle")

  var seen = ""
  let record = proc (m: string) {.closure.} = seen = m
  check(promotePartial(ok(1), record).isSuccess and seen == "", "promote_partial success")
  let p = promotePartial(partial("m", 1), record)
  check(p.isSuccess and p.successResult == 1'i32, "promote_partial partial")
  checkEq(seen, "m", "promote_partial reports")
  checkLc(p.lifecycleOf, deprecated(5'u32), "promote_partial lifecycle")
  seen = ""
  let q = promotePartial(nores("n"), record)
  check(q.isError, "promote_partial none")
  checkEq(seen, "n", "promote_partial none reports")

  check(withPartial(ok(1), 9'i32).successResult == 1'i32, "with_partial success")
  check(withPartial(nores("n"), 9'i32).partialResult == @[9'i32], "with_partial error")

  checkEq(withCompleteOrPartial(ok(1), "v").successResult, "v", "with_complete_or_partial success")
  check(withCompleteOrPartial(partial("e", 1), "v").partialResult == @["v"], "with_complete_or_partial partial")
  check(withCompleteOrPartial(nores("e"), "v").partialResult.len == 0, "with_complete_or_partial none")

proc messages() =
  # add_message always ends stable.
  let a = addMessage(newSuccess(1'i32), newSuccess("x"))
  check(a.isSuccess, "add_message both success")
  checkLc(a.lifecycleOf, stable(), "add_message stable")
  let b = addMessage(partial("a", 1), newPartialError("b", "x"))
  checkEq(b.message, "a; b", "add_message both errors")
  check(b.partialResult == @[1'i32], "add_message both partial")
  checkLc(b.lifecycleOf, stable(), "add_message both errors stable")
  let c = addMessage(partial("a", 1), newError[string]("b"))
  check(c.partialResult.len == 0, "add_message other has no result")
  let d = addMessage(nores("a"), newPartialError("b", "x"))
  check(d.partialResult.len == 0, "add_message self has no result")
  let e = addMessage(partial("a", 1), newSuccess("x"))
  checkEq(e.message, "a", "add_message self error")
  check(e.partialResult == @[1'i32], "add_message self error keeps partial")
  checkLc(e.lifecycleOf, stable(), "add_message self error stable")
  let f = addMessage(ok(1), newPartialError("b", "x"))
  checkEq(f.message, "b", "add_message other error")
  check(f.partialResult == @[1'i32], "add_message other partial")
  let g = addMessage(ok(1), newError[string]("b"))
  check(g.partialResult.len == 0, "add_message other none")

  # with_errors_from
  check(withErrorsFrom(ok(1), newSuccess("x")).isSuccess, "with_errors_from success")
  let h = withErrorsFrom(ok(1), newErrorWithLifecycle[string]("b", deprecated(2'u32)))
  checkEq(h.message, "b", "with_errors_from takes the message")
  check(h.partialResult == @[1'i32], "with_errors_from keeps the value as partial")
  checkLc(h.lifecycleOf, deprecated(2'u32), "with_errors_from adds lifecycles")
  let i = withErrorsFrom(nores("a"), newError[string]("b"))
  checkEq(i.message, "a", "with_errors_from leaves an error")

proc conversions() =
  check(flatTryFrom(int32, 5'i32).successResult == 5'i32, "flat_try_from identity")
  check(flatTryInto(5'i32, int32).successResult == 5'i32, "flat_try_into identity")

constructors()
accessors()
mapping()
flatMapping()
applying()
applyN()
errorTools()
messages()
conversions()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "data_resulttest ok"
