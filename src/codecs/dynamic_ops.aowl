## Port of pumpkin-codecs/src/dynamic_ops.rs
## Methods to read and write a format (JSON, NBT). Only `jsonOps()` and `nbtOps()` implement it.
##
## Every method that either format overrides or must provide is a closure field, set by a plain
## non-generic builder. The `default*` procs are Rust's default method bodies, for a builder to install.
## Methods neither format overrides are generic procs here, called the same way (`ops.emptyList()`).
## `impl Iterator` is a `seq`; `&'a Value` is a copy.
##
## `convert_to<U>` cannot be a field: it is an overload per format, in json_ops.aowl and nbt_ops.aowl,
## `convertTo*[U](ops: DynamicOps[JsonValue], outOps: DynamicOps[U], input: JsonValue): U`.
##
## `Value: PartialEq + Display` are the fields `valueEq` and `valueDisplay`, so generic code needs no
## overload of `==` or `$` on `V` in scope. `StructBuilder` associated type: the fields `structSeed`,
## `structAppend` and `buildWithBuilder` hold what differs, see struct_builder.aowl.
## `flat_map` closures are written out, see data_result.aowl.

{.feature: "untyped".}

import std/options
import number, data_result, map_like, lifecycle
export number, data_result, map_like, lifecycle

type
  DynamicOps*[V] = ref object
    valueEq*: proc (a, b: V): bool {.closure.}
    valueDisplay*: proc (a: V): string {.closure.}

    empty*: proc (): V {.closure.}
    createNumber*: proc (n: Number): V {.closure.}
    createByte*: proc (data: int8): V {.closure.}
    createShort*: proc (data: int16): V {.closure.}
    createInt*: proc (data: int32): V {.closure.}
    createLong*: proc (data: int64): V {.closure.}
    createFloat*: proc (data: float32): V {.closure.}
    createDouble*: proc (data: float64): V {.closure.}
    createBool*: proc (data: bool): V {.closure.}
    createString*: proc (data: string): V {.closure.}
    createList*: proc (values: seq[V]): V {.closure.}
    createMap*: proc (entries: seq[(V, V)]): V {.closure.}

    getBool*: proc (input: V): DataResult[bool] {.closure.}
    getNumber*: proc (input: V): DataResult[Number] {.closure.}
    getString*: proc (input: V): DataResult[string] {.closure.}
    getMapIter*: proc (input: V): DataResult[seq[(V, V)]] {.closure.}
    getMap*: proc (input: V): DataResult[MapLike[V]] {.closure.}
    getIter*: proc (input: V): DataResult[seq[V]] {.closure.}

    getByteList*: proc (input: V): DataResult[seq[int8]] {.closure.}
    createByteList*: proc (data: seq[int8]): V {.closure.}
    getIntList*: proc (input: V): DataResult[seq[int32]] {.closure.}
    createIntList*: proc (data: seq[int32]): V {.closure.}
    getLongList*: proc (input: V): DataResult[seq[int64]] {.closure.}
    createLongList*: proc (data: seq[int64]): V {.closure.}

    mergeIntoList*: proc (list, value: V): DataResult[V] {.closure.}
    mergeValuesIntoList*: proc (list: V, values: seq[V]): DataResult[V] {.closure.}
    mergeIntoMap*: proc (map, key, value: V): DataResult[V] {.closure.}
    mergeMapLikeIntoMap*: proc (map: V, other: MapLike[V]): DataResult[V] {.closure.}
    remove*: proc (input: V, key: string): V {.closure.}

    structSeed*: proc (): V {.closure.}
    structAppend*: proc (key: string, value, builder: V): V {.closure.}
    buildWithBuilder*: proc (builder, prefix: V): DataResult[V] {.closure.}

# --- default method bodies, for the builders ------------------------------------------------------

proc defaultCreateByte*[V](ops: DynamicOps[V], data: int8): V = ops.createNumber(numberByte(data))
proc defaultCreateShort*[V](ops: DynamicOps[V], data: int16): V = ops.createNumber(numberShort(data))
proc defaultCreateInt*[V](ops: DynamicOps[V], data: int32): V = ops.createNumber(numberInt(data))
proc defaultCreateLong*[V](ops: DynamicOps[V], data: int64): V = ops.createNumber(numberLong(data))
proc defaultCreateFloat*[V](ops: DynamicOps[V], data: float32): V = ops.createNumber(numberFloat(data))
proc defaultCreateDouble*[V](ops: DynamicOps[V], data: float64): V = ops.createNumber(numberDouble(data))

proc defaultGetByteList*[V](ops: DynamicOps[V], input: V): DataResult[seq[int8]] =
  ## `impl_get_list!(self, input, "bytes")`
  let it = ops.getIter(input)
  if not it.hasResultOrPartial: return propagateError[seq[V], seq[int8]](it)
  var values: seq[int8] = @[]
  for e in it.valueOrPartial:
    let n = ops.getNumber(e)
    if not n.isSuccess:
      return flatMapJoin(it, newError[seq[int8]]("Some elements are not bytes"))
    values.add toInt8(n.successResult)
  flatMapJoin(it, newSuccess(values))

proc defaultGetIntList*[V](ops: DynamicOps[V], input: V): DataResult[seq[int32]] =
  ## `impl_get_list!(self, input, "ints")`
  let it = ops.getIter(input)
  if not it.hasResultOrPartial: return propagateError[seq[V], seq[int32]](it)
  var values: seq[int32] = @[]
  for e in it.valueOrPartial:
    let n = ops.getNumber(e)
    if not n.isSuccess:
      return flatMapJoin(it, newError[seq[int32]]("Some elements are not ints"))
    values.add toInt32(n.successResult)
  flatMapJoin(it, newSuccess(values))

proc defaultGetLongList*[V](ops: DynamicOps[V], input: V): DataResult[seq[int64]] =
  ## `impl_get_list!(self, input, "longs")`
  let it = ops.getIter(input)
  if not it.hasResultOrPartial: return propagateError[seq[V], seq[int64]](it)
  var values: seq[int64] = @[]
  for e in it.valueOrPartial:
    let n = ops.getNumber(e)
    if not n.isSuccess:
      return flatMapJoin(it, newError[seq[int64]]("Some elements are not longs"))
    values.add toInt64(n.successResult)
  flatMapJoin(it, newSuccess(values))

proc defaultCreateByteList*[V](ops: DynamicOps[V], data: seq[int8]): V =
  var values: seq[V] = @[]
  for b in data: values.add ops.createByte(b)
  ops.createList(values)

proc defaultCreateIntList*[V](ops: DynamicOps[V], data: seq[int32]): V =
  var values: seq[V] = @[]
  for i in data: values.add ops.createInt(i)
  ops.createList(values)

proc defaultCreateLongList*[V](ops: DynamicOps[V], data: seq[int64]): V =
  var values: seq[V] = @[]
  for l in data: values.add ops.createLong(l)
  ops.createList(values)

proc defaultMergeValuesIntoList*[V](ops: DynamicOps[V], list: V, values: seq[V]): DataResult[V] =
  result = newSuccess(list)
  for value in values:
    if result.hasResultOrPartial:
      result = flatMapJoin(result, ops.mergeIntoList(result.valueOrPartial, value))

proc defaultMergeMapLikeIntoMap*[V](ops: DynamicOps[V], map: V, other: MapLike[V]): DataResult[V] =
  result = newSuccess(map)
  for i in 0 ..< other.keys.len:
    if result.hasResultOrPartial:
      result = flatMapJoin(result, ops.mergeIntoMap(result.valueOrPartial, other.keys[i], other.vals[i]))

# --- methods neither format overrides -------------------------------------------------------------

proc emptyList*[V](ops: DynamicOps[V]): V =
  let none: seq[V] = @[]
  ops.createList(none)

proc emptyMap*[V](ops: DynamicOps[V]): V =
  let none: seq[(V, V)] = @[]
  ops.createMap(none)

proc mergeEntriesIntoMap*[V](ops: DynamicOps[V], map: V, entries: seq[(V, V)]): DataResult[V] =
  result = newSuccess(map)
  for i in 0 ..< entries.len:
    if result.hasResultOrPartial:
      result = flatMapJoin(result, ops.mergeIntoMap(result.valueOrPartial, entries[i][0], entries[i][1]))

proc mergeIntoPrimitive*[V](ops: DynamicOps[V], prefix, value: V): DataResult[V] =
  if ops.valueEq(prefix, ops.empty()):
    newSuccess(value)
  else:
    newError[V]("Do not know how to append a primitive value " & ops.valueDisplay(value) & " to " &
                ops.valueDisplay(prefix))

proc getElementGeneric*[V](ops: DynamicOps[V], input, key: V): DataResult[V] =
  let it = ops.getMapIter(input)
  if not it.hasResultOrPartial: return propagateError[seq[(V, V)], V](it)
  let entries = it.valueOrPartial
  for i in 0 ..< entries.len:
    if ops.valueEq(entries[i][0], key):
      return flatMapJoin(it, newSuccess(entries[i][1]))
  flatMapJoin(it, newError[V]("No element " & ops.valueDisplay(key) & " in the map"))

proc getElement*[V](ops: DynamicOps[V], input: V, key: string): DataResult[V] =
  getElementGeneric(ops, input, ops.createString(key))

proc setElement*[V](ops: DynamicOps[V], input: V, key: string, value: V): V =
  let r = ops.mergeIntoMap(input, ops.createString(key), value)
  if r.isSuccess: r.successResult else: input

proc updateElement*[V](ops: DynamicOps[V], input: V, key: string, f: proc (v: V): V {.closure.}): V =
  let e = getElement(ops, input, key)
  if e.isSuccess: setElement(ops, input, key, f(e.successResult)) else: input

proc updateElementGeneric*[V](ops: DynamicOps[V], input, key: V, f: proc (v: V): V {.closure.}): V =
  let e = getElementGeneric(ops, input, key)
  if not e.hasResultOrPartial: return input
  let r = flatMapJoin(e, ops.mergeIntoMap(input, key, f(e.valueOrPartial)))
  if r.isSuccess: r.successResult else: input

proc convertList*[V, U](ops: DynamicOps[V], outOps: DynamicOps[U], input: V): U =
  mixin convertTo
  var values: seq[U] = @[]
  let it = ops.getIter(input)
  if it.isSuccess:
    for v in it.successResult:
      values.add convertTo(ops, outOps, v)
  outOps.createList(values)

proc convertMap*[V, U](ops: DynamicOps[V], outOps: DynamicOps[U], input: V): U =
  mixin convertTo
  var values: seq[(U, U)] = @[]
  let it = ops.getMapIter(input)
  if it.isSuccess:
    let entries = it.successResult
    for i in 0 ..< entries.len:
      values.add (convertTo(ops, outOps, entries[i][0]), convertTo(ops, outOps, entries[i][1]))
  outOps.createMap(values)
