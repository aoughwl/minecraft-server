## The API as pumpkin-util uses it: position.rs's codec test vectors for `BlockPos` through NBT, the generic
## `vector_codec_impl!` shape, and the same types through JSON. Other dynamic_ops vectors are in json_opstest
## and nbt_opstest, which exercise every field of both vtables.

{.feature: "untyped".}

import std/syncio
import codecs
import nbt/tag
import nbt/nbt_ops

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc tInt(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)
proc tFloat(v: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: v)
proc tByte(v: int8): NbtTag = NbtTag(kind: ntkByte, byteVal: v)
proc tStr(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)
proc tList(v: seq[NbtTag]): NbtTag = NbtTag(kind: ntkList, listVal: v)
proc tInts(v: seq[int32]): NbtTag = NbtTag(kind: ntkIntArray, intArrayVal: v)

# comap_flat_map_codec_impl!(IntStream => BlockPos, BlockPos::flat_try_from, IntStream::from)
type BlockPos = object
  x, y, z: int32

proc flatTryFrom(target: typedesc[BlockPos], value: IntStream): DataResult[BlockPos] =
  let v = validateFixedSize(value.data, 3)
  if not v.hasResultOrPartial:
    return propagateError[seq[int32], BlockPos](v)
  let d = v.valueOrPartial
  flatMapJoin(v, newSuccess(BlockPos(x: d[0], y: d[1], z: d[2])))

proc blockPosForward(value: IntStream): DataResult[BlockPos] = flatTryFrom(BlockPos, value)
proc blockPosBackward(p: BlockPos): IntStream = intStream(@[p.x, p.y, p.z])

comapFlatMapCodecImpl(IntStream, BlockPos, blockPosForward, blockPosBackward)

# vector_codec_impl!(Vector3<T>, 3, x, y, z)
type Vector3[T] = object
  x, y, z: T

proc flatTryFrom[T](target: typedesc[Vector3[T]], value: seq[T]): DataResult[Vector3[T]] =
  let v = validateFixedSize(value, 3)
  if not v.hasResultOrPartial:
    return propagateError[seq[T], Vector3[T]](v)
  let d = v.valueOrPartial
  flatMapJoin(v, newSuccess(Vector3[T](x: d[0], y: d[1], z: d[2])))

proc encode[T, V](v: Vector3[T], ops: DynamicOps[V], prefix: V): DataResult[V] =
  encode(@[v.x, v.y, v.z], ops, prefix)

proc decode[T, V](t: typedesc[Vector3[T]], input: V, ops: DynamicOps[V]): DataResult[(Vector3[T], V)] =
  let d = decode(seq[T], input, ops)
  if not d.hasResultOrPartial:
    return propagateError[(seq[T], V), (Vector3[T], V)](d)
  let pair = d.valueOrPartial
  flatMapJoin(d, withRemainder(flatTryFrom(Vector3[T], pair[0]), pair[1]))

proc blockPosNbt() =
  let ops = nbtOps()
  assertEncodeSuccess(BlockPos(x: 1, y: 2, z: 3), ops, tInts(@[1'i32, 2, 3]))
  assertEncodeSuccess(BlockPos(x: -1000, y: 200, z: 4521), ops, tInts(@[-1000'i32, 200, 4521]))
  assertDecodeIsSuccess(BlockPos, tInts(@[1'i32, 2, 3]), ops)
  assertDecodeIsError(BlockPos, tList(@[]), ops)
  assertDecodeIsSuccess(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tInt(3)]), ops)
  assertDecodeIsError(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tStr("69")]), ops)
  assertDecodeIsError(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tInt(3), tByte(3)]), ops)

  let p = parse(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tInt(3)]), ops).unwrap
  check(p.x == 1 and p.y == 2 and p.z == 3, "mixed list values")
  checkEq(parse(BlockPos, tList(@[]), ops).message, "Input is not a list of 3 elements", "empty list message")
  checkEq(parse(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tStr("69")]), ops).message, "Some elements are not ints", "bad element message")
  let long = parse(BlockPos, tList(@[tInt(1), tFloat(2.0'f32), tInt(3), tByte(3)]), ops)
  checkEq(long.message, "Input is not a list of 3 elements", "long list message")
  check(long.unwrapOrPartial.z == 3, "a long list leaves a partial cut to size")
  check(flatTryInto(intStream(@[7'i32, 8, 9]), BlockPos).unwrap.y == 8'i32, "flatTryInto finds the overload")

proc generic() =
  let n = nbtOps()
  let j = jsonOps()
  # Through NBT a float list is a List of Float, an int list is a List of Int: only IntStream chooses IntArray.
  checkEq($encodeStart(Vector3[float32](x: 1.5, y: 2.5, z: 3.5), n).unwrap, "[1.5f, 2.5f, 3.5f]", "float vector to nbt")
  checkEq($encodeStart(Vector3[int32](x: 1, y: 2, z: 3), n).unwrap, "[1, 2, 3]", "int vector to nbt")
  checkEq($encodeStart(Vector3[int32](x: 1, y: 2, z: 3), j).unwrap, "[1,2,3]", "int vector to json")
  checkEq($encodeStart(Vector3[float64](x: 1.0, y: 2.0, z: 3.0), j).unwrap, "[1.0,2.0,3.0]", "double vector to json")
  check(parse(Vector3[float32], js("[1,2.5,3]"), j).unwrap.y == 2.5'f32, "float vector from json")
  check(parse(Vector3[int32], tList(@[tInt(1), tInt(2), tInt(3)]), n).unwrap.z == 3'i32, "int vector from nbt")
  checkEq(parse(Vector3[int32], js("[1,2]"), j).message, "Input is not a list of 3 elements", "short vector")
  # A vector of vectors, and a list of them in a map.
  checkEq($encodeStart(@[Vector3[int8](x: 1, y: 2, z: 3)], j).unwrap, "[[1,2,3]]", "seq of vectors")
  check(parse(seq[Vector3[int32]], js("[[1,2,3],[4,5,6]]"), j).unwrap[1].x == 4'i32, "seq of vectors decode")
  var named = initTable[string, Vector3[int32]]()
  named["a"] = Vector3[int32](x: 1, y: 2, z: 3)
  checkEq($encodeStart(named, j).unwrap, """{"a":[1,2,3]}""", "map of vectors")
  check(parse(Table[string, Vector3[int32]], js("""{"a":[1,2,3]}"""), j).unwrap.getOrDefault("a", Vector3[int32]()).y == 2'i32, "map of vectors decode")
  check(parse(Table[string, seq[int32]], js("""{"a":[1]}"""), j).unwrap.getOrDefault("a", @[]) == @[1'i32], "map of seq")
  let either = parse(Either[Vector3[int32], string], js("\"s\""), j).unwrap
  check(either.isRight, "either of a vector")

proc convertBoth() =
  # The JSON form of a value, carried to NBT and back.
  let j = jsonOps()
  let n = nbtOps()
  let asNbt = convertTo(j, n, encodeStart(Vector3[int32](x: 1, y: 300, z: 70000), j).unwrap)
  checkEq($asNbt, "[1b, 300s, 70000]", "json to nbt narrows")
  check(parse(Vector3[int32], asNbt, n).unwrap.y == 300'i32, "decode the converted form")
  checkEq($convertTo(n, j, asNbt), "[1,300,70000]", "and back")

blockPosNbt()
generic()
convertBoth()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "dynamic_opstest ok"
