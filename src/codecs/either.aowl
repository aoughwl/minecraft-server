## Port of pumpkin-codecs/src/codec/either.rs

{.feature: "untyped".}

import codec_core

type
  EitherKind* = enum
    ekLeft
    ekRight

  Either*[L, R] = object
    case kind*: EitherKind
    of ekLeft: leftVal*: L
    of ekRight: rightVal*: R

proc newLeft*[L, R](value: L): Either[L, R] = Either[L, R](kind: ekLeft, leftVal: value)
proc newRight*[L, R](value: R): Either[L, R] = Either[L, R](kind: ekRight, rightVal: value)

proc isLeft*[L, R](e: Either[L, R]): bool {.inline.} = e.kind == ekLeft
proc isRight*[L, R](e: Either[L, R]): bool {.inline.} = e.kind == ekRight

proc left*[L, R](e: Either[L, R]): Option[L] =
  if e.kind == ekLeft: some(e.leftVal) else: none[L]()

proc right*[L, R](e: Either[L, R]): Option[R] =
  if e.kind == ekRight: some(e.rightVal) else: none[R]()

proc encode*[L, R, V](x: Either[L, R], ops: DynamicOps[V], prefix: V): DataResult[V] =
  mixin encode
  case x.kind
  of ekLeft: encode(x.leftVal, ops, prefix)
  of ekRight: encode(x.rightVal, ops, prefix)

proc decode*[L, R, V](t: typedesc[Either[L, R]], input: V, ops: DynamicOps[V]): DataResult[(Either[L, R], V)] =
  mixin decode
  let leftResult = decode(L, input, ops)
  if leftResult.isSuccess:
    let pair = leftResult.successResult
    return newSuccessWithLifecycle((newLeft[L, R](pair[0]), pair[1]), leftResult.successLifecycle)
  let rightResult = decode(R, input, ops)
  if rightResult.isSuccess:
    let pair = rightResult.successResult
    return newSuccessWithLifecycle((newRight[L, R](pair[0]), pair[1]), rightResult.successLifecycle)
  # No result is a complete success by this point, so look for partial results.
  if leftResult.hasResultOrPartial:
    let pair = leftResult.partialResult[0]
    return newPartialErrorWithLifecycle(leftResult.message, (newLeft[L, R](pair[0]), pair[1]), leftResult.errorLifecycle)
  if rightResult.hasResultOrPartial:
    let pair = rightResult.partialResult[0]
    return newPartialErrorWithLifecycle(rightResult.message, (newRight[L, R](pair[0]), pair[1]), rightResult.errorLifecycle)
  newError[(Either[L, R], V)]("Failed to parse either. First: " & leftResult.message & "; Second: " & rightResult.message)
