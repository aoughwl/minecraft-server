## Upstream's test of pumpkin-codecs/src/codec/either.rs, and known answers.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc simple() =
  let ops = jsonOps()
  assertEncodeSuccess(newLeft[int32, string](5'i32), ops, js("5"))
  assertEncodeSuccess(newRight[int32, string]("I am some text."), ops, js("\"I am some text.\""))

  type IS = Either[int32, string]
  type US = Either[uint32, string]
  assertDecodeIsSuccess(IS, js("-238"), ops)
  assertDecodeIsError(US, js("-238"), ops)
  assertDecodeIsSuccess(US, js("\"hello\""), ops)
  assertDecodeIsError(US, js("true"), ops)

proc knownAnswers() =
  let ops = jsonOps()
  type IS = Either[int32, string]
  type US = Either[uint32, string]
  let l = newLeft[int32, string](5'i32)
  let r = newRight[int32, string]("x")
  check(l.isLeft and not l.isRight, "isLeft")
  check(r.isRight and not r.isLeft, "isRight")
  check(l.left.get == 5'i32 and l.right.isNone, "left")
  check(r.right.get == "x" and r.left.isNone, "right")
  let d = parse(IS, js("-238"), ops).unwrap
  check(d.isLeft and d.leftVal == -238'i32, "decoded left")
  let e = parse(US, js("\"hello\""), ops).unwrap
  check(e.isRight and e.rightVal == "hello", "decoded right")
  checkEq(parse(US, js("true"), ops).message,
    "Failed to parse either. First: Not a number: true; Second: Not a string: true", "both fail")
  checkEq(parse(US, js("-238"), ops).message,
    "Failed to parse either. First: Could not fit i32 into u32; Second: Not a string: -238", "both fail, unsigned")

  # A partial on the left wins over a right with no result.
  type LP = Either[seq[int32], bool]
  let partial = decode(seq[seq[int32]], js("[[1],5]"), ops)
  check(partial.hasResultOrPartial == false, "no result for an element with none")
  checkEq(parse(LP, js("[\"a\"]"), ops).message,
    "Failed to parse either. First: Not a number: \"a\"; Second: Not a boolean: [\"a\"]", "partial chain")

simple()
knownAnswers()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "eithertest ok"
