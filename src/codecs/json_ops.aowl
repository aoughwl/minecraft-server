## Port of pumpkin-codecs/src/json_ops.rs
## `JsonOps` is the value from `jsonOps()`, its `DynamicOps[JsonValue]` vtable. `JsonStructBuilder` is
## `StringStructBuilder[JsonValue]`, see struct_builder.aowl. `Display for JsonMapLike` is not ported: the
## type is private upstream and nothing formats it.

{.feature: "untyped".}

import std/options
import json_value, dynamic_ops, struct_builder
export json_value

type
  JsonStructBuilder* = StringStructBuilder[JsonValue]

proc getAsString*(input: JsonValue): Option[string] =
  ## Gson's `getAsString()`: booleans, numbers, strings, and arrays of exactly one such element.
  case input.kind
  of jvArray:
    if input.items.len == 1: getAsString(input.items[0]) else: none[string]()
  of jvBool: some(if input.boolVal: "true" else: "false")
  of jvInt, jvUInt, jvFloat: some($input)
  of jvString: some(input.strVal)
  else: none[string]()

proc isValidKey(input: JsonValue): bool {.inline.} =
  input.kind == jvString

proc addPretty(s: var string, v: JsonValue, indent: int) =
  ## `serde_json::to_string_pretty`.
  case v.kind
  of jvArray:
    if v.items.len == 0:
      s.add "[]"
      return
    s.add "[\n"
    for i in 0 ..< v.items.len:
      if i > 0: s.add ",\n"
      for _ in 0 ..< indent + 1: s.add "  "
      addPretty(s, v.items[i], indent + 1)
    s.add '\n'
    for _ in 0 ..< indent: s.add "  "
    s.add ']'
  of jvObject:
    if v.keys.len == 0:
      s.add "{}"
      return
    s.add "{\n"
    for i in 0 ..< v.keys.len:
      if i > 0: s.add ",\n"
      for _ in 0 ..< indent + 1: s.add "  "
      s.addEscaped v.keys[i]
      s.add ": "
      addPretty(s, v.vals[i], indent + 1)
    s.add '\n'
    for _ in 0 ..< indent: s.add "  "
    s.add '}'
  else:
    s.addJson v

proc toJsonPretty*(v: JsonValue): string =
  result = ""
  addPretty(result, v, 0)

proc jsonCreateMap(entries: seq[(JsonValue, JsonValue)]): JsonValue =
  result = jsonObject()
  for i in 0 ..< entries.len:
    let k = getAsString(entries[i][0])
    if k.isSome:
      result.put(k.get, entries[i][1])

proc jsonGetBool(input: JsonValue): DataResult[bool] =
  if input.kind == jvBool: newSuccess(input.boolVal)
  else: newError[bool]("Not a boolean: " & $input)

proc jsonGetNumber(input: JsonValue): DataResult[Number] =
  let n = tryFromJson(input)
  if n.isSome: newSuccess(n.get)
  else: newError[Number]("Not a number: " & $input)

proc jsonGetString(input: JsonValue): DataResult[string] =
  if input.kind == jvString: newSuccess(input.strVal)
  else: newError[string]("Not a string: " & $input)

proc jsonGetMapIter(input: JsonValue): DataResult[seq[(JsonValue, JsonValue)]] =
  if input.kind != jvObject:
    return newError[seq[(JsonValue, JsonValue)]]("Not a JSON object: " & $input)
  var entries: seq[(JsonValue, JsonValue)] = @[]
  for i in 0 ..< input.keys.len:
    entries.add (jsonString(input.keys[i]), input.vals[i])
  newSuccess(entries)

proc jsonGetMap(input: JsonValue): DataResult[MapLike[JsonValue]] =
  if input.kind != jvObject:
    return newError[MapLike[JsonValue]]("Not a JSON object: " & $input)
  var m = newMapLike[JsonValue]()
  for i in 0 ..< input.keys.len:
    m.addNamed(input.keys[i], jsonString(input.keys[i]), input.vals[i])
  newSuccess(m)

proc jsonGetIter(input: JsonValue): DataResult[seq[JsonValue]] =
  if input.kind == jvArray: newSuccess(input.items)
  else: newError[seq[JsonValue]]("Not a JSON array: " & $input)

proc jsonMergeValuesIntoList(list: JsonValue, values: seq[JsonValue]): DataResult[JsonValue] =
  if list.kind == jvArray or list.kind == jvNull:
    var items: seq[JsonValue] = @[]
    if list.kind == jvArray: items = list.items
    for v in values: items.add v
    newSuccess(jsonArray(items))
  else:
    newPartialError("Not a list: " & $list, list)

proc jsonMergeIntoList(list, value: JsonValue): DataResult[JsonValue] =
  jsonMergeValuesIntoList(list, @[value])

proc jsonMergeIntoMap(map, key, value: JsonValue): DataResult[JsonValue] =
  if map.kind != jvObject and map.kind != jvNull:
    return newPartialError("Not a map: " & $map, map)
  if not isValidKey(key):
    return newPartialError("Key is not a string: " & $key, map)
  var output = if map.kind == jvObject: map else: jsonObject()
  output.put(key.strVal, value)
  newSuccess(output)

proc jsonMergeMapLikeIntoMap(map: JsonValue, other: MapLike[JsonValue]): DataResult[JsonValue] =
  if map.kind != jvObject and map.kind != jvNull:
    return newPartialError("Not a map: " & $map, map)
  var output = if map.kind == jvObject: map else: jsonObject()
  var missed: seq[JsonValue] = @[]
  for i in 0 ..< other.keys.len:
    if isValidKey(other.keys[i]):
      output.put(other.keys[i].strVal, other.vals[i])
    else:
      missed.add other.keys[i]
  if missed.len == 0:
    newSuccess(output)
  else:
    newPartialError("Some keys are not strings: " & toJsonPretty(jsonArray(missed)), output)

proc jsonRemove(input: JsonValue, key: string): JsonValue =
  result = input
  if result.kind == jvObject:
    discard result.remove(key)

proc jsonBuildWithBuilder(builder, prefix: JsonValue): DataResult[JsonValue] =
  case prefix.kind
  of jvNull:
    newSuccess(builder)
  of jvObject:
    if builder.kind != jvObject:
      return newError[JsonValue]("Expected object in builder, found " & $builder)
    var map = prefix
    for i in 0 ..< builder.keys.len:
      map.put(builder.keys[i], builder.vals[i])
    newSuccess(map)
  else:
    newPartialError("Prefix is not a map: " & $prefix, prefix)

proc jsonAppend(key: string, value, builder: JsonValue): JsonValue =
  result = builder
  result.put(key, value)

proc buildJsonOps(): DynamicOps[JsonValue] =
  result = DynamicOps[JsonValue]()
  result.valueEq = proc (a, b: JsonValue): bool {.closure.} = a == b
  result.valueDisplay = proc (a: JsonValue): string {.closure.} = $a
  result.empty = proc (): JsonValue {.closure.} = jsonNull()
  result.createNumber = proc (n: Number): JsonValue {.closure.} = toJsonValue(n)
  result.createByte = proc (data: int8): JsonValue {.closure.} = defaultCreateByte(jsonOps(), data)
  result.createShort = proc (data: int16): JsonValue {.closure.} = defaultCreateShort(jsonOps(), data)
  result.createInt = proc (data: int32): JsonValue {.closure.} = defaultCreateInt(jsonOps(), data)
  result.createLong = proc (data: int64): JsonValue {.closure.} = defaultCreateLong(jsonOps(), data)
  result.createFloat = proc (data: float32): JsonValue {.closure.} = defaultCreateFloat(jsonOps(), data)
  result.createDouble = proc (data: float64): JsonValue {.closure.} = defaultCreateDouble(jsonOps(), data)
  result.createBool = proc (data: bool): JsonValue {.closure.} = jsonBool(data)
  result.createString = proc (data: string): JsonValue {.closure.} = jsonString(data)
  result.createList = proc (values: seq[JsonValue]): JsonValue {.closure.} = jsonArray(values)
  result.createMap = proc (entries: seq[(JsonValue, JsonValue)]): JsonValue {.closure.} = jsonCreateMap(entries)
  result.getBool = proc (input: JsonValue): DataResult[bool] {.closure.} = jsonGetBool(input)
  result.getNumber = proc (input: JsonValue): DataResult[Number] {.closure.} = jsonGetNumber(input)
  result.getString = proc (input: JsonValue): DataResult[string] {.closure.} = jsonGetString(input)
  result.getMapIter = proc (input: JsonValue): DataResult[seq[(JsonValue, JsonValue)]] {.closure.} = jsonGetMapIter(input)
  result.getMap = proc (input: JsonValue): DataResult[MapLike[JsonValue]] {.closure.} = jsonGetMap(input)
  result.getIter = proc (input: JsonValue): DataResult[seq[JsonValue]] {.closure.} = jsonGetIter(input)
  result.getByteList = proc (input: JsonValue): DataResult[seq[int8]] {.closure.} = defaultGetByteList(jsonOps(), input)
  result.createByteList = proc (data: seq[int8]): JsonValue {.closure.} = defaultCreateByteList(jsonOps(), data)
  result.getIntList = proc (input: JsonValue): DataResult[seq[int32]] {.closure.} = defaultGetIntList(jsonOps(), input)
  result.createIntList = proc (data: seq[int32]): JsonValue {.closure.} = defaultCreateIntList(jsonOps(), data)
  result.getLongList = proc (input: JsonValue): DataResult[seq[int64]] {.closure.} = defaultGetLongList(jsonOps(), input)
  result.createLongList = proc (data: seq[int64]): JsonValue {.closure.} = defaultCreateLongList(jsonOps(), data)
  result.mergeIntoList = proc (list, value: JsonValue): DataResult[JsonValue] {.closure.} = jsonMergeIntoList(list, value)
  result.mergeValuesIntoList = proc (list: JsonValue, values: seq[JsonValue]): DataResult[JsonValue] {.closure.} =
    jsonMergeValuesIntoList(list, values)
  result.mergeIntoMap = proc (map, key, value: JsonValue): DataResult[JsonValue] {.closure.} = jsonMergeIntoMap(map, key, value)
  result.mergeMapLikeIntoMap = proc (map: JsonValue, other: MapLike[JsonValue]): DataResult[JsonValue] {.closure.} =
    jsonMergeMapLikeIntoMap(map, other)
  result.remove = proc (input: JsonValue, key: string): JsonValue {.closure.} = jsonRemove(input, key)
  result.structSeed = proc (): JsonValue {.closure.} = jsonObject()
  result.structAppend = proc (key: string, value, builder: JsonValue): JsonValue {.closure.} = jsonAppend(key, value, builder)
  result.buildWithBuilder = proc (builder, prefix: JsonValue): DataResult[JsonValue] {.closure.} = jsonBuildWithBuilder(builder, prefix)

var theJsonOps: DynamicOps[JsonValue] = buildJsonOps()

proc jsonOps*(): DynamicOps[JsonValue] =
  theJsonOps

proc get*(m: MapLike[JsonValue], key: JsonValue): Option[JsonValue] =
  ## `JsonMapLike::get`.
  let s = getAsString(key)
  if s.isSome: getStr(m, s.get) else: none[JsonValue]()

proc convertTo*[U](ops: DynamicOps[JsonValue], outOps: DynamicOps[U], input: JsonValue): U =
  case input.kind
  of jvNull: outOps.empty()
  of jvBool: outOps.createBool(input.boolVal)
  of jvString: outOps.createString(input.strVal)
  of jvArray: convertList(ops, outOps, input)
  of jvObject: convertMap(ops, outOps, input)
  of jvInt:
    let l = input.intVal
    if l >= -128'i64 and l <= 127'i64: outOps.createByte(int8(l))
    elif l >= -32768'i64 and l <= 32767'i64: outOps.createShort(int16(l))
    elif l >= -2147483648'i64 and l <= 2147483647'i64: outOps.createInt(int32(l))
    else: outOps.createLong(l)
  of jvUInt, jvFloat:
    let f = if input.kind == jvFloat: input.floatVal else: float64(input.uintVal)
    if float64(float32(f)) == f: outOps.createFloat(float32(f))
    else: outOps.createDouble(f)
