## Known answers for json_ops.aowl: upstream has no tests of its own, so these follow each arm of the Rust,
## with the exact JSON text and messages.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc getAsStringVectors() =
  checkEq(getAsString(js("true")).get, "true", "bool as string")
  checkEq(getAsString(js("5")).get, "5", "int as string")
  checkEq(getAsString(js("1.5")).get, "1.5", "float as string")
  checkEq(getAsString(js("1.0")).get, "1.0", "whole float as string")
  checkEq(getAsString(js("\"s\"")).get, "s", "string as string")
  checkEq(getAsString(js("[7]")).get, "7", "one-element array as string")
  checkEq(getAsString(js("[[\"x\"]]")).get, "x", "nested one-element array")
  check(getAsString(js("[1,2]")).isNone, "two-element array")
  check(getAsString(js("[]")).isNone, "empty array")
  check(getAsString(js("null")).isNone, "null")
  check(getAsString(js("{}")).isNone, "object")

proc create() =
  let ops = jsonOps()
  checkEq($ops.empty(), "null", "empty")
  checkEq($ops.emptyList(), "[]", "emptyList")
  checkEq($ops.emptyMap(), "{}", "emptyMap")
  checkEq($ops.createNumber(numberShort(5)), "5", "createNumber")
  checkEq($ops.createByte(-1), "-1", "createByte")
  checkEq($ops.createShort(300), "300", "createShort")
  checkEq($ops.createInt(70000), "70000", "createInt")
  checkEq($ops.createLong(5000000000'i64), "5000000000", "createLong")
  checkEq($ops.createFloat(0.5'f32), "0.5", "createFloat")
  checkEq($ops.createFloat(0.1'f32), "0.10000000149011612", "createFloat widens")
  checkEq($ops.createDouble(1.0), "1.0", "createDouble")
  checkEq($ops.createDouble(0.0 / 0.0), "null", "NaN is null")
  checkEq($ops.createBool(true), "true", "createBool")
  checkEq($ops.createString("a\"b"), "\"a\\\"b\"", "createString")
  checkEq($ops.createList(@[js("1"), js("\"x\"")]), "[1,\"x\"]", "createList")
  checkEq($ops.createByteList(@[1'i8, -2]), "[1,-2]", "createByteList")
  checkEq($ops.createIntList(@[1'i32, -2]), "[1,-2]", "createIntList")
  checkEq($ops.createLongList(@[1'i64, -2]), "[1,-2]", "createLongList")
  # Sorted keys, non-string keys go through getAsString, others are dropped, last one wins.
  checkEq($ops.createMap(@[(js("\"b\""), js("1")), (js("\"a\""), js("2")), (js("3"), js("4")), (js("true"), js("5")),
                           (js("null"), js("6")), (js("{}"), js("7")), (js("\"a\""), js("8"))]),
          """{"3":4,"a":8,"b":1,"true":5}""", "createMap")

proc read() =
  let ops = jsonOps()
  check(ops.getBool(js("true")).unwrap, "getBool")
  checkEq(ops.getBool(js("0")).message, "Not a boolean: 0", "getBool error")
  check(ops.getNumber(js("5")).unwrap == numberLong(5), "getNumber int is a long")
  check(ops.getNumber(js("1.5")).unwrap == numberDouble(1.5), "getNumber float is a double")
  check(ops.getNumber(js("18446744073709551615")).unwrap == numberDouble(18446744073709551616.0), "getNumber big is a double")
  checkEq(ops.getNumber(js("\"5\"")).message, "Not a number: \"5\"", "getNumber error")
  checkEq(ops.getString(js("\"s\"")).unwrap, "s", "getString")
  checkEq(ops.getString(js("1")).message, "Not a string: 1", "getString error")
  checkEq(ops.getString(js("[\"x\"]")).message, "Not a string: [\"x\"]", "getString on array is an error")

  let entries = ops.getMapIter(js("""{"b":1,"a":2}""")).unwrap
  checkEq($entries[0][0], "\"a\"", "getMapIter sorted key")
  checkEq($entries[0][1], "2", "getMapIter value")
  checkEq(ops.getMapIter(js("5")).message, "Not a JSON object: 5", "getMapIter error")
  checkEq(ops.getMap(js("[1]")).message, "Not a JSON object: [1]", "getMap error")

  let m = ops.getMap(js("""{"1":"one","a":"x"}""")).unwrap
  checkEq($m.getStr("a").get, "\"x\"", "MapLike getStr")
  check(m.getStr("zz").isNone, "MapLike getStr absent")
  checkEq($get(m, js("\"a\"")).get, "\"x\"", "MapLike get")
  checkEq($get(m, js("1")).get, "\"one\"", "MapLike get through getAsString")
  checkEq($get(m, js("[1]")).get, "\"one\"", "MapLike get through a one-element array")
  check(get(m, js("null")).isNone, "MapLike get null")
  checkEq($m.iter()[1][0], "\"a\"", "MapLike iter")

  check(ops.getIter(js("[1,2]")).unwrap.len == 2, "getIter")
  checkEq(ops.getIter(js("5")).message, "Not a JSON array: 5", "getIter error")
  check(ops.getByteList(js("[1,300]")).unwrap == @[1'i8, 44], "getByteList narrows")
  check(ops.getIntList(js("[1,2.5]")).unwrap == @[1'i32, 2], "getIntList")
  check(ops.getLongList(js("[5000000000]")).unwrap == @[5000000000'i64], "getLongList")
  checkEq(ops.getByteList(js("[\"x\"]")).message, "Some elements are not bytes", "getByteList error")
  checkEq(ops.getIntList(js("[\"x\"]")).message, "Some elements are not ints", "getIntList error")
  checkEq(ops.getLongList(js("[\"x\"]")).message, "Some elements are not longs", "getLongList error")
  checkEq(ops.getIntList(js("5")).message, "Not a JSON array: 5", "getIntList not an array")

proc merge() =
  let ops = jsonOps()
  checkEq($ops.mergeIntoList(js("null"), js("1")).unwrap, "[1]", "mergeIntoList null")
  checkEq($ops.mergeIntoList(js("[0]"), js("1")).unwrap, "[0,1]", "mergeIntoList list")
  let badList = ops.mergeIntoList(js("5"), js("1"))
  checkEq(badList.message, "Not a list: 5", "mergeIntoList error")
  checkEq($badList.unwrapOrPartial, "5", "mergeIntoList partial")
  checkEq($ops.mergeValuesIntoList(js("[0]"), @[js("1"), js("2")]).unwrap, "[0,1,2]", "mergeValuesIntoList")
  checkEq($ops.mergeValuesIntoList(js("null"), @[js("1")]).unwrap, "[1]", "mergeValuesIntoList null")
  checkEq(ops.mergeValuesIntoList(js("5"), @[js("1")]).message, "Not a list: 5", "mergeValuesIntoList error")

  checkEq($ops.mergeIntoMap(js("null"), js("\"a\""), js("1")).unwrap, """{"a":1}""", "mergeIntoMap null")
  checkEq($ops.mergeIntoMap(js("""{"a":1}"""), js("\"a\""), js("2")).unwrap, """{"a":2}""", "mergeIntoMap replaces")
  let notMap = ops.mergeIntoMap(js("5"), js("\"a\""), js("1"))
  checkEq(notMap.message, "Not a map: 5", "mergeIntoMap not a map")
  checkEq($notMap.unwrapOrPartial, "5", "mergeIntoMap not a map partial")
  let badKey = ops.mergeIntoMap(js("{}"), js("5"), js("1"))
  checkEq(badKey.message, "Key is not a string: 5", "mergeIntoMap bad key")
  checkEq($badKey.unwrapOrPartial, "{}", "mergeIntoMap bad key partial")

  var ml = newMapLike[JsonValue]()
  ml.addNamed("a", js("\"a\""), js("1"))
  checkEq($ops.mergeMapLikeIntoMap(js("""{"b":2}"""), ml).unwrap, """{"a":1,"b":2}""", "mergeMapLikeIntoMap")
  checkEq(ops.mergeMapLikeIntoMap(js("5"), ml).message, "Not a map: 5", "mergeMapLikeIntoMap not a map")
  ml.addUnnamed(js("1"), js("9"))
  ml.addUnnamed(js("[2,{\"k\":3},[]]"), js("9"))
  let missed = ops.mergeMapLikeIntoMap(js("null"), ml)
  checkEq(missed.message,
    "Some keys are not strings: [\n  1,\n  [\n    2,\n    {\n      \"k\": 3\n    },\n    []\n  ]\n]", "pretty missed keys")
  checkEq($missed.unwrapOrPartial, """{"a":1}""", "mergeMapLikeIntoMap partial")

  checkEq($ops.remove(js("""{"a":1,"b":2}"""), "a"), """{"b":2}""", "remove")
  checkEq($ops.remove(js("""{"a":1}"""), "z"), """{"a":1}""", "remove absent")
  checkEq($ops.remove(js("5"), "a"), "5", "remove non-object")

proc defaults() =
  let ops = jsonOps()
  checkEq($mergeEntriesIntoMap(ops, js("null"), @[(js("\"a\""), js("1")), (js("\"b\""), js("2"))]).unwrap, """{"a":1,"b":2}""", "mergeEntriesIntoMap")
  checkEq($mergeIntoPrimitive(ops, js("null"), js("1")).unwrap, "1", "mergeIntoPrimitive")
  checkEq(mergeIntoPrimitive(ops, js("[]"), js("\"s\"")).message, "Do not know how to append a primitive value \"s\" to []", "mergeIntoPrimitive error")
  checkEq($getElement(ops, js("""{"a":1}"""), "a").unwrap, "1", "getElement")
  checkEq(getElement(ops, js("""{"a":1}"""), "z").message, "No element \"z\" in the map", "getElement absent")
  checkEq(getElement(ops, js("5"), "z").message, "Not a JSON object: 5", "getElement not an object")
  checkEq($getElementGeneric(ops, js("""{"a":1}"""), js("\"a\"")).unwrap, "1", "getElementGeneric")
  checkEq(getElementGeneric(ops, js("""{"a":1}"""), js("5")).message, "No element 5 in the map", "getElementGeneric absent")
  checkEq($setElement(ops, js("""{"a":1}"""), "a", js("2")), """{"a":2}""", "setElement")
  checkEq($setElement(ops, js("5"), "a", js("2")), "5", "setElement non-object")
  let inc1 = proc (v: JsonValue): JsonValue {.closure.} = jsonInt(v.intVal + 1)
  checkEq($updateElement(ops, js("""{"a":1}"""), "a", inc1), """{"a":2}""", "updateElement")
  checkEq($updateElement(ops, js("""{"a":1}"""), "z", inc1), """{"a":1}""", "updateElement absent")
  checkEq($updateElementGeneric(ops, js("""{"a":1}"""), js("\"a\""), inc1), """{"a":2}""", "updateElementGeneric")
  checkEq($updateElementGeneric(ops, js("""{"a":1}"""), js("\"z\""), inc1), """{"a":1}""", "updateElementGeneric absent")

  # Partial errors stack through flat_map.
  checkEq(defaultMergeValuesIntoList(ops, js("5"), @[js("1"), js("2")]).message, "Not a list: 5; Not a list: 5", "default merge values")
  checkEq($defaultMergeValuesIntoList(ops, js("[0]"), @[js("1"), js("2")]).unwrap, "[0,1,2]", "default merge values ok")
  checkEq(mergeEntriesIntoMap(ops, js("{}"), @[(js("1"), js("1")), (js("2"), js("2"))]).message,
          "Key is not a string: 1; Key is not a string: 2", "merge entries stacks messages")
  var ml = newMapLike[JsonValue]()
  ml.addNamed("a", js("\"a\""), js("1"))
  ml.addUnnamed(js("9"), js("2"))
  let dm = defaultMergeMapLikeIntoMap(ops, js("null"), ml)
  checkEq(dm.message, "Key is not a string: 9", "default merge map-like message")
  checkEq($dm.unwrapOrPartial, """{"a":1}""", "default merge map-like partial")

  checkEq($defaultCreateByteList(ops, @[1'i8]), "[1]", "default create byte list")

proc convert() =
  let ops = jsonOps()
  # Integers take the narrowest form, seen through JSON as the same text; floats keep their value.
  let text = """{"a":1,"b":300,"c":70000,"d":5000000000,"e":0.5,"f":0.1,"g":18446744073709551615,"h":[true,null,"x"]}"""
  checkEq($convertTo(ops, ops, js(text)),
    """{"a":1,"b":300,"c":70000,"d":5000000000,"e":0.5,"f":0.1,"g":1.8446744073709552e19,"h":[true,null,"x"]}""", "convertTo")
  checkEq($convertList(ops, ops, js("[1]")), "[1]", "convertList")
  checkEq($convertList(ops, ops, js("5")), "[]", "convertList on a non-list")
  checkEq($convertMap(ops, ops, js("""{"a":1}""")), """{"a":1}""", "convertMap")
  checkEq($convertMap(ops, ops, js("5")), "{}", "convertMap on a non-map")

proc builder() =
  let ops = jsonOps()
  var b = ops.mapBuilder()
  check(b.builder.lifecycleOf == stable(), "map builder starts stable")
  b = addStringKeyValue(b, "b", js("1"))
  b = addStringKeyValueResult(b, "a", newSuccess(js("2")))
  check(b.builder.lifecycleOf == stable(), "string keys keep it stable")
  checkEq($build(b, js("null")).unwrap, """{"a":2,"b":1}""", "build with an empty prefix")
  checkEq($build(b, js("""{"a":0,"z":9}""")).unwrap, """{"a":2,"b":1,"z":9}""", "the builder replaces prefix values in JSON")
  let badPrefix = build(b, js("5"))
  checkEq(badPrefix.message, "Prefix is not a map: 5", "bad prefix")
  checkEq($badPrefix.unwrapOrPartial, "5", "bad prefix partial")
  check(build(b, js("null")).lifecycleOf == experimental(), "build goes through new_success")

proc lib() =
  let ops = jsonOps()
  check(toJsonPretty(js("[]")) == "[]", "pretty empty array")
  check(toJsonPretty(js("{}")) == "{}", "pretty empty object")
  checkEq(toJsonPretty(js("""{"a":[1],"b":null}""")), "{\n  \"a\": [\n    1\n  ],\n  \"b\": null\n}", "pretty")
  check(ops.valueEq(js("1"), js("1")), "valueEq")
  check(not ops.valueEq(js("1"), js("1.0")), "valueEq by representation")
  checkEq(ops.valueDisplay(js("[1]")), "[1]", "valueDisplay")

getAsStringVectors()
create()
read()
merge()
defaults()
convert()
builder()
lib()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "json_opstest ok"
