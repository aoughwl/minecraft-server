## Known-answer checks for json_value.aowl against what serde_json prints.

import std/syncio
import std/assertions
import json_value

proc rt(input, expected: string) =
  let o = parseJsonValue(input)
  if not o.ok:
    echo "parse failed: " & input & " -> " & o.error
    quit(1)
  if toJsonString(o.value) != expected:
    echo "got " & toJsonString(o.value) & " want " & expected
    quit(1)

proc bad(input: string) =
  if parseJsonValue(input).ok:
    echo "should not parse: " & input
    quit(1)

proc eqs(a, b: string) =
  if a != b:
    echo "got " & a & " want " & b
    quit(1)

rt("{\"b\":1,\"a\":[1,2.5,{\"z\":null}],\"c\":true}", "{\"a\":[1,2.5,{\"z\":null}],\"b\":1,\"c\":true}")
rt(" \"a\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0001\\u00e9\\ud83d\\ude00\" ", "\"a\\\"\\\\/\\b\\f\\n\\r\\t\\u0001\xC3\xA9\xF0\x9F\x98\x80\"")
rt("-0", "-0.0")
rt("18446744073709551615", "18446744073709551615")
rt("-9223372036854775808", "-9223372036854775808")
rt("18446744073709551616", "1.8446744073709552e19")
rt("1e3", "1000.0")
rt("1.5e-7", "1.5e-7")
rt("[]", "[]")
rt("{}", "{}")
bad("{")
bad("[1,]")
bad("01")
bad("1 2")
bad("\"\\ud800\"")
var deep = ""
for _ in 0 ..< 129: deep.add '['
for _ in 0 ..< 129: deep.add ']'
bad(deep)

eqs(formatF64(1.0), "1.0")
eqs(formatF64(0.1), "0.1")
eqs(formatF64(1e16), "1e16")
eqs(formatF64(1.5e300), "1.5e300")
eqs(formatF64(123456.789), "123456.789")
eqs(formatF64(0.00001), "0.00001")
eqs(formatF64(0.000001), "1e-6")
eqs(formatF64(-2.5), "-2.5")
eqs(formatF32(0.1'f32), "0.1")
eqs(displayF64(1.0), "1")
eqs(displayF64(1e16), "10000000000000000")
eqs(displayF64(0.000001), "0.000001")
eqs(displayF32(1.5'f32), "1.5")

var o = jsonObject()
o.put("b", jsonInt(1))
o.put("a", jsonFloat(1.0))
o.put("b", jsonInt(2))
eqs(toJsonString(o), "{\"a\":1.0,\"b\":2}")
assert hasKey(o, "a")
assert remove(o, "a")
assert not hasKey(o, "a")
assert jsonFloat(Inf).kind == jvNull
assert jsonInt(1) != jsonFloat(1.0)
echo "json_value: OK"
