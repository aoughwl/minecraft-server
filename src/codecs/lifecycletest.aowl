## Upstream's `add_lifecycles` test, and the remaining arms of `Lifecycle::add`.

import std/syncio
import lifecycle

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

check(add(stable(), stable()) == stable(), "stable + stable")
check(add(experimental(), deprecated(10'u32)) == experimental(), "experimental + deprecated")
check(add(deprecated(10'u32), deprecated(15'u32)) == deprecated(10'u32), "earlier deprecation wins")
check(add(deprecated(15'u32), deprecated(10'u32)) == deprecated(10'u32), "earlier deprecation wins, swapped")
check(add(deprecated(10'u32), experimental()) == experimental(), "deprecated + experimental")
check(add(stable(), experimental()) == experimental(), "stable + experimental")
check(add(deprecated(3'u32), stable()) == deprecated(3'u32), "deprecated + stable")
check(add(stable(), deprecated(3'u32)) == deprecated(3'u32), "stable + deprecated")
check($deprecated(3'u32) == "Deprecated(3)", "debug text")
check($stable() == "Stable", "debug text stable")
check(not (deprecated(3'u32) == deprecated(4'u32)), "different dates differ")

if failures > 0:
  echo failures, " failures"
  quit(1)
echo "lifecycletest ok"
