## Port of pumpkin-codecs/src/list_builder.rs
## `ListBuilder` is plain data with procs; `flat_map` and `apply_2_and_make_stable` are written out.

{.feature: "untyped".}

import dynamic_ops

type
  ListBuilder*[V] = object
    elements*: DataResult[seq[V]]
    ops*: DynamicOps[V]

proc newListBuilderImpl*[V](ops: DynamicOps[V]): ListBuilder[V] =
  let none: seq[V] = @[]
  ListBuilder[V](elements: newSuccess(none), ops: ops)

proc listBuilder*[V](ops: DynamicOps[V]): ListBuilder[V] =
  ## `DynamicOps::list_builder`.
  newListBuilderImpl(ops)

proc build*[V](b: ListBuilder[V], prefix: V): DataResult[V] =
  if not b.elements.hasResultOrPartial:
    return propagateError[seq[V], V](b.elements)
  flatMapJoin(b.elements, b.ops.mergeValuesIntoList(prefix, b.elements.valueOrPartial))

proc add*[V](b: ListBuilder[V], value: V): ListBuilder[V] =
  result = b
  if b.elements.hasResultOrPartial:
    var e = b.elements.valueOrPartial
    e.add value
    if b.elements.isSuccess:
      result.elements = newSuccessWithLifecycle(e, b.elements.successLifecycle)
    else:
      result.elements = newPartialErrorWithLifecycle(b.elements.message, e, b.elements.errorLifecycle)

proc addDataResult*[V](b: ListBuilder[V], value: DataResult[V]): ListBuilder[V] =
  result = b
  let message = combineMessages(b.elements, value)
  if b.elements.isSuccess and value.isSuccess:
    var e = b.elements.successResult
    e.add value.successResult
    result.elements = newSuccessWithLifecycle(e, stable())
  elif bothHaveValues(b.elements, value):
    var e = b.elements.valueOrPartial
    e.add value.valueOrPartial
    result.elements = newPartialErrorWithLifecycle(message, e, stable())
  else:
    result.elements = newErrorWithLifecycle[seq[V]](message, stable())
