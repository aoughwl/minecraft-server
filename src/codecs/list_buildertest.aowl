## Known answers for list_builder.aowl. Upstream has no tests of its own.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

let ops = jsonOps()

var b = listBuilder(ops)
b = add(b, js("1"))
b = addDataResult(b, newSuccess(js("2")))
check(b.elements.lifecycleOf == stable(), "add_data_result makes it stable")
checkEq($build(b, js("null")).unwrap, "[1,2]", "build empty prefix")
checkEq($build(b, js("[0]")).unwrap, "[0,1,2]", "build list prefix")
let badPrefix = build(b, js("5"))
checkEq(badPrefix.message, "Not a list: 5", "build bad prefix")
checkEq($badPrefix.unwrapOrPartial, "5", "build bad prefix partial")

# A partial element makes the builder partial and appends it, an element with no result empties it.
var p = addDataResult(listBuilder(ops), newPartialError("soft", js("1")))
checkEq(p.elements.message, "soft", "partial element message")
p = add(p, js("2"))
check(p.elements.partialResult[0].len == 2, "partial builder still adds")
let pb = build(p, js("null"))
checkEq(pb.message, "soft", "partial builder build message")
checkEq($pb.unwrapOrPartial, "[1,2]", "partial builder build value")
p = addDataResult(p, newPartialError("soft2", js("3")))
checkEq(p.elements.message, "soft; soft2", "messages stack")

var e = addDataResult(listBuilder(ops), newError[JsonValue]("bad"))
check(not e.elements.hasResultOrPartial, "no result")
e = add(e, js("2"))
check(not e.elements.hasResultOrPartial, "add leaves no result")
e = addDataResult(e, newSuccess(js("3")))
checkEq(e.elements.message, "bad", "success after error")
e = addDataResult(e, newError[JsonValue]("worse"))
checkEq(e.elements.message, "bad; worse", "errors stack")
checkEq(build(e, js("null")).message, "bad; worse", "build error")
check(not build(e, js("null")).hasResultOrPartial, "build no result")

if failures > 0:
  echo failures, " failures"
  quit(1)
echo "list_buildertest ok"
