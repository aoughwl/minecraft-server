## Port of pumpkin-codecs/src/codec/list.rs
## `Vec<T>` is `seq[T]`, and its `Encode` and `Decode` are in codec_core.aowl, see there. `BoundedVec<T, MIN, MAX>` has no const generics to use, so the bounds are a range type:
## `BoundedVec[int32, range[1 .. 2]]`.
## The `flat_map` closures are written out, see data_result.aowl.

{.feature: "untyped".}

import codec_core

type
  BoundedVec*[T, Bounds] = object
    ## A `seq` that can only hold between `low(Bounds)` and `high(Bounds)` elements, inclusive.
    data*: seq[T]

  NonEmptyVec*[T] = object
    ## A `seq` that cannot be empty, similar to Minecraft's `ExtraCodecs.nonEmptyList`.
    data*: seq[T]

template boundedMin(Bounds: untyped): int = int(low(Bounds))
template boundedMax(Bounds: untyped): int = int(high(Bounds))

proc createTooShortError*[R](min, max, size: int): DataResult[R] =
  newError[R]("List is too short: " & $size & ", expected range [" & $min & "-" & $max & "]")

proc createTooLongError*[R](min, max, size: int): DataResult[R] =
  newError[R]("List is too long: " & $size & ", expected range [" & $min & "-" & $max & "]")

proc toSeq*[T, Bounds](value: BoundedVec[T, Bounds]): seq[T] = value.data
proc toSeq*[T](value: NonEmptyVec[T]): seq[T] = value.data

proc flatTryFrom*[T, Bounds](target: typedesc[BoundedVec[T, Bounds]], value: seq[T]): DataResult[BoundedVec[T, Bounds]] =
  let size = value.len
  if size < boundedMin(Bounds):
    createTooShortError[BoundedVec[T, Bounds]](boundedMin(Bounds), boundedMax(Bounds), size)
  elif size > boundedMax(Bounds):
    createTooLongError[BoundedVec[T, Bounds]](boundedMin(Bounds), boundedMax(Bounds), size)
  else:
    newSuccess(BoundedVec[T, Bounds](data: value))

proc flatTryFrom*[T](target: typedesc[NonEmptyVec[T]], value: seq[T]): DataResult[NonEmptyVec[T]] =
  if value.len == 0:
    newError[NonEmptyVec[T]]("List must have contents")
  else:
    newSuccess(NonEmptyVec[T](data: value))

# --- BoundedVec ----------------------------------------------------------------------------------------

proc encode*[T, Bounds, V](x: BoundedVec[T, Bounds], ops: DynamicOps[V], prefix: V): DataResult[V] =
  let size = x.data.len
  if size < boundedMin(Bounds):
    createTooShortError[V](boundedMin(Bounds), boundedMax(Bounds), size)
  elif size > boundedMax(Bounds):
    createTooLongError[V](boundedMin(Bounds), boundedMax(Bounds), size)
  else:
    var builder = listBuilder(ops)
    for e in x.data:
      builder = addDataResult(builder, encodeStart(e, ops))
    build(builder, prefix)

proc decode*[T, Bounds, V](t: typedesc[BoundedVec[T, Bounds]], input: V, ops: DynamicOps[V]): DataResult[(BoundedVec[T, Bounds], V)] =
  mixin decode
  let it = withLifecycle(ops.getIter(input), stable())
  if not it.hasResultOrPartial:
    return propagateError[seq[V], (BoundedVec[T, Bounds], V)](it)
  var totalCount = 0
  var elements: seq[T] = @[]
  var failed: seq[V] = @[]
  # Partial if any element is partial, no result if any element has none.
  var res = newSuccess(Unit())
  for element in it.valueOrPartial:
    inc totalCount
    if elements.len >= boundedMax(Bounds):
      failed.add element
      continue
    let elementResult = decode(T, element, ops)
    res = addMessage(res, elementResult)
    if elementResult.hasResultOrPartial:
      elements.add elementResult.valueOrPartial[0]
  if totalCount < boundedMin(Bounds):
    return flatMapJoin(it, createTooShortError[(BoundedVec[T, Bounds], V)](boundedMin(Bounds), boundedMax(Bounds), totalCount))
  let pair = (BoundedVec[T, Bounds](data: elements), ops.createList(failed))
  if totalCount > boundedMax(Bounds):
    res = createTooLongError[Unit](boundedMin(Bounds), boundedMax(Bounds), totalCount)
  flatMapJoin(it, withCompleteOrPartial(res, pair))

# --- NonEmptyVec ---------------------------------------------------------------------------------------

proc encode*[T, V](x: NonEmptyVec[T], ops: DynamicOps[V], prefix: V): DataResult[V] =
  if x.data.len == 0:
    newError[V]("List must have contents")
  else:
    encode(x.data, ops, prefix)

proc decode*[T, V](t: typedesc[NonEmptyVec[T]], input: V, ops: DynamicOps[V]): DataResult[(NonEmptyVec[T], V)] =
  let d = decode(seq[T], input, ops)
  if not d.hasResultOrPartial:
    return propagateError[(seq[T], V), (NonEmptyVec[T], V)](d)
  let pair = d.valueOrPartial
  flatMapJoin(d, withRemainder(flatTryFrom(NonEmptyVec[T], pair[0]), pair[1]))

# --- utility functions ---------------------------------------------------------------------------------

proc validateFixedSize*[T](list: seq[T], size: int): DataResult[seq[T]] =
  ## A success when `list.len == size`. A longer list is a partial cut down to `size`, a shorter one no result.
  if list.len == size:
    newSuccess(list)
  else:
    let message = "Input is not a list of " & $size & " elements"
    if list.len > size:
      newPartialError(message, list[0 ..< size])
    else:
      newError[seq[T]](message)
