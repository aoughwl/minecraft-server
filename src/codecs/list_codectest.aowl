## Upstream's tests of pumpkin-codecs/src/codec/list.rs, and known answers for the bounded and non-empty lists.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

type NumberGrid = seq[seq[float64]]

proc encoding() =
  let ops = jsonOps()
  assertEncodeSuccess(@[1'i32, 2], ops, js("[1,2]"))
  let empty: seq[int32] = @[]
  assertEncodeSuccess(empty, ops, js("[]"))
  assertEncodeSuccess(@[-3'i32, 192, 182], ops, js("[-3,192,182]"))
  assertEncodeSuccess(@["a", "b"], ops, js("""["a","b"]"""))
  assertEncodeSuccess(@["one"], ops, js("""["one"]"""))
  assertEncodeSuccess(@["1", "2", "3"], ops, js("""["1","2","3"]"""))
  assertEncodeSuccess(@[true, false], ops, js("[true,false]"))
  assertEncodeSuccess(@[@[true, false], @[true, false]], ops, js("[[true,false],[true,false]]"))
  assertEncodeSuccess(@[@[@[true, true], @[false, false]]], ops, js("[[[true,true],[false,false]]]"))

proc decoding() =
  let ops = jsonOps()
  assertDecodeIsSuccess(seq[int16], js("[1,2,3]"), ops)
  assertDecodeIsSuccess(seq[int16], js("[1,2,6,24,120]"), ops)
  assertDecodeIsError(seq[int16], js("""["string","b"]"""), ops)
  assertDecodeIsError(seq[int16], js("false"), ops)

  assertDecodeIsSuccess(NumberGrid, js("[[0,0.5,1.0]]"), ops)
  assertDecodeIsSuccess(NumberGrid, js("[[0,0.5,1.0],[1,4,5],[-293.4,1,293]]"), ops)
  assertDecodeIsError(NumberGrid, js("[[0,0.5,1.0],[1,false,5],[-293.4,1,293]]"), ops)
  assertDecodeIsSuccess(NumberGrid, js("[[1,1.5,2.0],[-20]]"), ops)
  assertDecodeIsSuccess(NumberGrid, js("[[]]"), ops)
  assertDecodeIsError(NumberGrid, js("[[[[]]]]"), ops)

proc knownAnswers() =
  let ops = jsonOps()
  # Values and messages
  let grid = parse(NumberGrid, js("[[1,1.5],[-20]]"), ops).unwrap
  check(grid.len == 2 and grid[0][1] == 1.5 and grid[1][0] == -20.0, "grid values")
  checkEq(parse(seq[int16], js("false"), ops).message, "Not a JSON array: false", "not an array")
  checkEq(parse(seq[int16], js("""["a","b"]"""), ops).message, "Not a number: \"a\"; Not a number: \"b\"", "both elements fail")
  let d = decode(seq[int32], js("[1]"), ops)
  checkEq($d.successResult[1], "[]", "the remainder is an empty list")
  check(d.lifecycleOf == stable(), "decoded lifecycle is stable")

  # encode into a prefix
  checkEq($encode(@[3'i32], ops, js("[1,2]")).unwrap, "[1,2,3]", "encode into a list prefix")
  checkEq(encode(@[3'i32], ops, js("7")).message, "Not a list: 7", "encode into a bad prefix")
  checkEq($encode(@[3'i32], ops, js("7")).unwrapOrPartial, "7", "the bad prefix is the partial")

  # NonEmptyVec
  checkEq($encodeStart(NonEmptyVec[int32](data: @[1'i32]), ops).unwrap, "[1]", "non-empty encode")
  checkEq(encodeStart(NonEmptyVec[int32](data: @[]), ops).message, "List must have contents", "non-empty encode empty")
  check(toSeq(parse(NonEmptyVec[int32], js("[1,2]"), ops).unwrap) == @[1'i32, 2], "non-empty decode")
  checkEq(parse(NonEmptyVec[int32], js("[]"), ops).message, "List must have contents", "non-empty decode empty")
  checkEq(flatTryFrom(NonEmptyVec[int32], @[]).message, "List must have contents", "non-empty flatTryFrom")

  # BoundedVec
  type B = BoundedVec[int32, range[1 .. 2]]
  checkEq($encodeStart(B(data: @[1'i32, 2]), ops).unwrap, "[1,2]", "bounded encode")
  checkEq(encodeStart(B(data: @[]), ops).message, "List is too short: 0, expected range [1-2]", "bounded encode short")
  checkEq(encodeStart(B(data: @[1'i32, 2, 3]), ops).message, "List is too long: 3, expected range [1-2]", "bounded encode long")
  check(toSeq(parse(B, js("[1,2]"), ops).unwrap) == @[1'i32, 2], "bounded decode")
  checkEq(parse(B, js("[]"), ops).message, "List is too short: 0, expected range [1-2]", "bounded decode short")
  let long = decode(B, js("[1,2,3,4]"), ops)
  checkEq(long.message, "List is too long: 4, expected range [1-2]", "bounded decode long")
  check(long.partialResult.len == 0, "too long has no partial, as the error replaces the result")
  checkEq($flatTryFrom(B, @[1'i32, 2]).unwrap.data.len, "2", "bounded flatTryFrom")
  checkEq(flatTryFrom(B, @[1'i32, 2, 3]).message, "List is too long: 3, expected range [1-2]", "bounded flatTryFrom long")

  # validateFixedSize
  check(validateFixedSize(@[1'i32, 2], 2).unwrap == @[1'i32, 2], "fixed size exact")
  let over = validateFixedSize(@[1'i32, 2, 3], 2)
  checkEq(over.message, "Input is not a list of 2 elements", "fixed size long")
  check(over.unwrapOrPartial == @[1'i32, 2], "fixed size long partial is cut")
  let under = validateFixedSize(@[1'i32], 2)
  checkEq(under.message, "Input is not a list of 2 elements", "fixed size short")
  check(not under.hasResultOrPartial, "fixed size short has no result")

encoding()
decoding()
knownAnswers()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "list_codectest ok"
