## Upstream's tests of pumpkin-codecs/src/codec/map.rs, and known answers for its messages.

{.feature: "untyped".}

import std/[syncio, hashes, strutils]
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

# A `u32` wrapper that encodes a `String`.
type StringInteger = object
  n: uint32

func hash(x: StringInteger): Hash = hash(int(x.n))
func `==`(a, b: StringInteger): bool = a.n == b.n
proc `$`(x: StringInteger): string = $x.n
proc stringIntegerBackward(x: StringInteger): string = $x.n

proc stringIntegerForward(value: string): DataResult[StringInteger] =
  var n = 0'u64
  if value.len == 0: return newError[StringInteger]("Could not parse String")
  for c in value:
    if c < '0' or c > '9': return newError[StringInteger]("Could not parse String")
    n = n * 10'u64 + uint64(ord(c) - ord('0'))
  newSuccess(StringInteger(n: uint32(n)))

comapFlatMapCodecImpl(string, StringInteger, stringIntegerForward, stringIntegerBackward)

# A wrapper of a `String` that only allows a single letter.
type Letter = object
  s: string

func hash(x: Letter): Hash = hash(x.s)
func `==`(a, b: Letter): bool = a.s == b.s
proc `$`(x: Letter): string = x.s

proc letterForward(value: string): DataResult[Letter] =
  if value.len == 1: newSuccess(Letter(s: value))
  else: newError[Letter]("Not a letter: " & value)

proc letterBackward(value: Letter): DataResult[string] =
  let l = letterForward(value.s)
  if l.isSuccess: newSuccess(l.successResult.s) else: newError[string](l.message)

flatXmapCodecImpl(string, Letter, letterForward, letterBackward)

proc isPrime(number: uint32): bool =
  if number < 2'u32: return false
  var i = 2'u32
  while i < number:
    if number mod i == 0'u32: return false
    inc i
  true

proc simpleEncoding() =
  var map = initTable[string, int32]()
  map["Amy"] = 10
  map["Leo"] = 24
  map["Patrick"] = -65
  assertEncodeSuccess(map, jsonOps(), js("""{"Amy":10,"Leo":24,"Patrick":-65}"""))

proc stringIntegerMap() =
  let ops = jsonOps()
  var map = initTable[StringInteger, bool]()
  for i in 1'u32 .. 20'u32:
    map[StringInteger(n: i)] = isPrime(i)
  assertEncodeSuccess(map, ops, js("""{
    "1": false, "2": true, "3": true, "4": false, "5": true, "6": false, "7": true, "8": false, "9": false, "10": false,
    "11": true, "12": false, "13": true, "14": false, "15": false, "16": false, "17": true, "18": false, "19": true, "20": false
  }"""))
  type T = Table[StringInteger, bool]
  assertDecodeIsSuccess(T, js("""{"1": true, "2": true, "3": true, "4": false, "5": false}"""), ops)

proc letterFrequency() =
  let ops = jsonOps()
  type LetterData = Table[Letter, uint64]
  var map = initTable[Letter, uint64]()
  map[Letter(s: "b")] = 62
  map[Letter(s: "z")] = 2342
  assertEncodeSuccess(map, ops, js("""{"b":62,"z":2342}"""))

  var bad = initTable[Letter, uint64]()
  bad[Letter(s: "d")] = 12452
  bad[Letter(s: "candy")] = 2342
  check(encodeStart(bad, ops).isError, "bad letter does not encode")

  assertDecodeIsSuccess(LetterData, js("""{"a":13,"c":34,"x":1,"e":21}"""), ops)
  assertDecodeIsError(LetterData, js("""{"b":45,"w":10,"l":90,"word":5}"""), ops)

proc knownAnswers() =
  let ops = jsonOps()
  type LetterData = Table[Letter, uint64]
  type IntMap = Table[StringInteger, bool]

  let okMap = parse(LetterData, js("""{"a":13,"c":34}"""), ops).unwrap
  check(okMap.len == 2, "decoded map size")
  check(okMap.getOrDefault(Letter(s: "c"), 0'u64) == 34'u64, "decoded map value")

  checkEq(parse(LetterData, js("""{"b":45,"word":5}"""), ops).message,
    "Not a letter: word (Missed inputs: {\"word\":5})", "bad key message")
  checkEq(parse(LetterData, js("""{"b":true}"""), ops).message,
    "Not a number: true (Missed inputs: {\"b\":true})", "bad value message")
  checkEq(parse(LetterData, js("""{"bb":true}"""), ops).message,
    "Not a letter: bb; Not a number: true (Missed inputs: {\"bb\":true})", "bad key and value message")
  checkEq(parse(LetterData, js("5"), ops).message, "Not a JSON object: 5", "not a map")
  # "01" and "1" parse to the same key, "01" sorting first.
  checkEq(parse(IntMap, js("""{"01":true,"1":false}"""), ops).message,
    "Duplicate entry for key: 1 (Missed inputs: {\"1\":false})", "duplicate key message")

  # The remainder is the input, as upstream's `.map(|r| (r, input))`.
  let d = decode(LetterData, js("""{"a":13}"""), ops)
  checkEq($d.successResult[1], """{"a":13}""", "remainder")
  check(d.lifecycleOf == stable(), "lifecycle of a decoded map")

  # encode into a prefix
  var one = initTable[string, int32]()
  one["k"] = 1
  checkEq($encode(one, ops, js("""{"z":2}""")).unwrap, """{"k":1,"z":2}""", "encode into a map prefix")
  checkEq(encode(one, ops, js("3")).message, "Prefix is not a map: 3", "encode into a bad prefix")

simpleEncoding()
stringIntegerMap()
letterFrequency()
knownAnswers()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "map_codectest ok"
