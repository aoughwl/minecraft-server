## Port of pumpkin-codecs/src/map_like.rs
## A map view of a dynamic type, as plain data rather than a trait. `get` by dynamic key depends on
## the format, so it is an overload in json_ops.aowl and nbt_ops.aowl; `iter` is a `seq`.

{.feature: "untyped".}

import std/options

type
  MapLike*[V] = object
    keys*: seq[V]         ## dynamic keys, in iteration order
    names*: seq[string]   ## text of each key that has one, parallel to `keys`
    named*: seq[bool]     ## false for a key that `getStr` cannot reach, parallel to `keys`
    vals*: seq[V]

proc newMapLike*[V](): MapLike[V] =
  MapLike[V](keys: @[], names: @[], named: @[], vals: @[])

proc addNamed*[V](m: var MapLike[V], name: string, key, value: V) =
  m.keys.add key
  m.names.add name
  m.named.add true
  m.vals.add value

proc addUnnamed*[V](m: var MapLike[V], key, value: V) =
  ## An entry whose key is not a string.
  m.keys.add key
  m.names.add ""
  m.named.add false
  m.vals.add value

proc len*[V](m: MapLike[V]): int {.inline.} = m.keys.len

proc getStr*[V](m: MapLike[V], key: string): Option[V] =
  for i in 0 ..< m.names.len:
    if m.named[i] and m.names[i] == key:
      return some(m.vals[i])
  none[V]()

proc iter*[V](m: MapLike[V]): seq[(V, V)] =
  result = @[]
  for i in 0 ..< m.keys.len:
    result.add (m.keys[i], m.vals[i])
