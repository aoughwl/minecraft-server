## Known answers for map_like.aowl. Upstream has no tests; the format-specific `get`s are in json_opstest and nbt_opstest.

{.feature: "untyped".}

import std/[syncio, options]
import map_like

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

var m = newMapLike[int32]()
check(m.len == 0, "empty")
check(m.getStr("a").isNone, "empty getStr")
m.addNamed("a", 100'i32, 1'i32)
m.addUnnamed(200'i32, 2'i32)
m.addNamed("b", 300'i32, 3'i32)
check(m.len == 3, "len")
check(m.getStr("a").get == 1'i32, "getStr a")
check(m.getStr("b").get == 3'i32, "getStr b")
check(m.getStr("").isNone, "an unnamed key cannot be reached by name")
check(m.getStr("z").isNone, "getStr absent")
let entries = m.iter()
check(entries.len == 3, "iter size")
check(entries[0][0] == 100'i32 and entries[0][1] == 1'i32, "iter first")
check(entries[1][0] == 200'i32 and entries[1][1] == 2'i32, "iter keeps unnamed")
check(entries[2][0] == 300'i32 and entries[2][1] == 3'i32, "iter last")

if failures > 0:
  echo failures, " failures"
  quit(1)
echo "map_liketest ok"
