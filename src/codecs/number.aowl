## Port of pumpkin-codecs/src/number.rs
## A generic Java-style number and the numeric casts Java and Rust `as` use: integer narrowing
## truncates, float to integer saturates and NaN gives 0.

import std/options
import json_value

type
  NumberKind* = enum
    nkByte
    nkShort
    nkInt
    nkLong
    nkFloat
    nkDouble

  Number* = object
    case kind*: NumberKind
    of nkByte: byteVal*: int8
    of nkShort: shortVal*: int16
    of nkInt: intVal*: int32
    of nkLong: longVal*: int64
    of nkFloat: floatVal*: float32
    of nkDouble: doubleVal*: float64

proc numberByte*(v: int8): Number {.inline.} = Number(kind: nkByte, byteVal: v)
proc numberShort*(v: int16): Number {.inline.} = Number(kind: nkShort, shortVal: v)
proc numberInt*(v: int32): Number {.inline.} = Number(kind: nkInt, intVal: v)
proc numberLong*(v: int64): Number {.inline.} = Number(kind: nkLong, longVal: v)
proc numberFloat*(v: float32): Number {.inline.} = Number(kind: nkFloat, floatVal: v)
proc numberDouble*(v: float64): Number {.inline.} = Number(kind: nkDouble, doubleVal: v)

proc `==`*(a, b: Number): bool =
  if a.kind != b.kind: return false
  case a.kind
  of nkByte: a.byteVal == b.byteVal
  of nkShort: a.shortVal == b.shortVal
  of nkInt: a.intVal == b.intVal
  of nkLong: a.longVal == b.longVal
  of nkFloat: a.floatVal == b.floatVal
  of nkDouble: a.doubleVal == b.doubleVal

proc saturateI64(f: float64): int64 =
  if f != f: 0'i64
  elif f >= 9223372036854775808.0: high(int64)
  elif f <= -9223372036854775808.0: low(int64)
  else: int64(f)

proc saturateI32(f: float64): int32 =
  if f != f: 0'i32
  elif f >= 2147483647.0: high(int32)
  elif f <= -2147483648.0: low(int32)
  else: int32(f)

proc truncateI32(v: int64): int32 {.inline.} =
  cast[int32](uint32(cast[uint64](v) and 0xFFFF_FFFF'u64))

proc toInt64*(n: Number): int64 =
  case n.kind
  of nkByte: int64(n.byteVal)
  of nkShort: int64(n.shortVal)
  of nkInt: int64(n.intVal)
  of nkLong: n.longVal
  of nkFloat: saturateI64(float64(n.floatVal))
  of nkDouble: saturateI64(n.doubleVal)

proc toInt32*(n: Number): int32 =
  case n.kind
  of nkByte: int32(n.byteVal)
  of nkShort: int32(n.shortVal)
  of nkInt: n.intVal
  of nkLong: truncateI32(n.longVal)
  of nkFloat: saturateI32(float64(n.floatVal))
  of nkDouble: saturateI32(n.doubleVal)

proc toInt16*(n: Number): int16 =
  ## Upstream goes through `i32` first, matching Java's cast chain.
  cast[int16](uint16(cast[uint32](toInt32(n)) and 0xFFFF'u32))

proc toInt8*(n: Number): int8 =
  cast[int8](uint8(cast[uint32](toInt32(n)) and 0xFF'u32))

proc toUInt8*(n: Number): uint8 =
  uint8(cast[uint32](toInt32(n)) and 0xFF'u32)

proc toFloat32*(n: Number): float32 =
  case n.kind
  of nkByte: float32(n.byteVal)
  of nkShort: float32(n.shortVal)
  of nkInt: float32(n.intVal)
  of nkLong: float32(n.longVal)
  of nkFloat: n.floatVal
  of nkDouble: float32(n.doubleVal)

proc toFloat64*(n: Number): float64 =
  case n.kind
  of nkByte: float64(n.byteVal)
  of nkShort: float64(n.shortVal)
  of nkInt: float64(n.intVal)
  of nkLong: float64(n.longVal)
  of nkFloat: float64(n.floatVal)
  of nkDouble: n.doubleVal

proc `$`*(n: Number): string =
  ## Rust's Display.
  case n.kind
  of nkByte: $n.byteVal
  of nkShort: $n.shortVal
  of nkInt: $n.intVal
  of nkLong: $n.longVal
  of nkFloat: displayF32(n.floatVal)
  of nkDouble: displayF64(n.doubleVal)

proc toJsonValue*(n: Number): JsonValue =
  ## `From<Number> for serde_json::Value`. An f32 is widened as serde_json does, and a non-finite
  ## float becomes null.
  case n.kind
  of nkByte: jsonInt(int64(n.byteVal))
  of nkShort: jsonInt(int64(n.shortVal))
  of nkInt: jsonInt(int64(n.intVal))
  of nkLong: jsonInt(n.longVal)
  of nkFloat: jsonFloat(float64(n.floatVal))
  of nkDouble: jsonFloat(n.doubleVal)

proc tryFromJson*(v: JsonValue): Option[Number] =
  ## `TryFrom<serde_json::Value> for Number`: `as_i64` first, then `as_f64`; none stands in for
  ## `FromJsonValueError`.
  case v.kind
  of jvInt: some(numberLong(v.intVal))
  of jvUInt: some(numberDouble(float64(v.uintVal)))
  of jvFloat: some(numberDouble(v.floatVal))
  else: none[Number]()
