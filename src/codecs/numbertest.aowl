## Known answers for number.aowl. Upstream has no tests of its own here; the expected values follow Rust's `as`.

import std/[syncio, options]
import number, json_value

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

# Integer narrowing wraps.
check(toInt32(numberLong(0x1_0000_0005'i64)) == 5'i32, "long to int truncates")
check(toInt32(numberLong(-1'i64)) == -1'i32, "long to int keeps sign")
check(toInt16(numberInt(70000'i32)) == 4464'i16, "int to short")
check(toInt16(numberInt(-70000'i32)) == -4464'i16, "negative int to short")
check(toInt8(numberInt(200'i32)) == -56'i8, "int to byte")
check(toUInt8(numberInt(-1'i32)) == 255'u8, "int to u8")
check(toUInt8(numberInt(300'i32)) == 44'u8, "int to u8 wraps")
check(toInt8(numberLong(0x1_0000_0001'i64)) == 1'i8, "long to byte goes through int")
check(toInt16(numberDouble(1e10)) == -1'i16, "double to short saturates at i32 first")

# Float to integer saturates, NaN gives 0.
check(toInt32(numberDouble(1e10)) == high(int32), "double to int saturates up")
check(toInt32(numberDouble(-1e10)) == low(int32), "double to int saturates down")
check(toInt32(numberDouble(2147483647.0)) == high(int32), "double to int at the edge")
check(toInt32(numberFloat(1.9'f32)) == 1'i32, "float to int truncates")
check(toInt32(numberFloat(-1.9'f32)) == -1'i32, "negative float to int truncates")
check(toInt64(numberDouble(1e30)) == high(int64), "double to long saturates up")
check(toInt64(numberDouble(-1e30)) == low(int64), "double to long saturates down")
check(toInt64(numberDouble(1.5)) == 1'i64, "double to long")
let nan = 0.0 / 0.0
check(toInt32(numberDouble(nan)) == 0'i32, "NaN to int")
check(toInt64(numberDouble(nan)) == 0'i64, "NaN to long")
check(toInt64(numberFloat(float32(nan))) == 0'i64, "f32 NaN to long")

# To floats
check(toFloat32(numberByte(-1'i8)) == -1.0'f32, "byte to f32")
check(toFloat32(numberDouble(1.5)) == 1.5'f32, "double to f32")
check(toFloat64(numberFloat(1.5'f32)) == 1.5, "f32 to f64")
check(toFloat64(numberLong(5'i64)) == 5.0, "long to f64")
check(toFloat64(numberShort(5'i16)) == 5.0, "short to f64")
check(toFloat64(numberInt(5'i32)) == 5.0, "int to f64")
check(toInt64(numberByte(5'i8)) == 5'i64, "byte to long")
check(toInt64(numberShort(5'i16)) == 5'i64, "short to long")
check(toInt64(numberInt(5'i32)) == 5'i64, "int to long")

# Display
checkEq($numberByte(-1'i8), "-1", "display byte")
checkEq($numberShort(2'i16), "2", "display short")
checkEq($numberInt(3'i32), "3", "display int")
checkEq($numberLong(4'i64), "4", "display long")
checkEq($numberFloat(1.5'f32), "1.5", "display float")
checkEq($numberFloat(2.0'f32), "2", "display whole float")
checkEq($numberFloat(0.1'f32), "0.1", "display float shortest")
checkEq($numberDouble(1e21), "1000000000000000000000", "display double has no exponent")
checkEq($numberDouble(1.5e-7), "0.00000015", "display small double")
checkEq($numberDouble(nan), "NaN", "display NaN")
checkEq($numberDouble(1.0 / 0.0), "inf", "display inf")

# Equality
check(numberInt(1'i32) == numberInt(1'i32), "equal")
check(not (numberInt(1'i32) == numberLong(1'i64)), "different kinds differ")

# JSON
checkEq($toJsonValue(numberByte(1'i8)), "1", "byte to json")
checkEq($toJsonValue(numberLong(5000000000'i64)), "5000000000", "long to json")
checkEq($toJsonValue(numberFloat(0.5'f32)), "0.5", "float to json")
checkEq($toJsonValue(numberFloat(0.1'f32)), "0.10000000149011612", "float to json widens")
checkEq($toJsonValue(numberDouble(1.0)), "1.0", "double to json")
checkEq($toJsonValue(numberDouble(nan)), "null", "NaN to json")

check(tryFromJson(jsonInt(5'i64)).get == numberLong(5'i64), "int from json is a long")
check(tryFromJson(jsonFloat(1.5)).get == numberDouble(1.5), "float from json is a double")
check(tryFromJson(jsonUInt(18446744073709551615'u64)).get == numberDouble(18446744073709551616.0), "above i64 is a double")
check(tryFromJson(jsonString("x")).isNone, "string from json")
check(tryFromJson(jsonNull()).isNone, "null from json")

if failures > 0:
  echo failures, " failures"
  quit(1)
echo "numbertest ok"
