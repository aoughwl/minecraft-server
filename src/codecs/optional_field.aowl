## Port of pumpkin-codecs/src/codec/optional_field.rs
## Traits become generic procs. `encodeField` and `parse` are in codec_core.aowl, which imports this
## module, so they are reached with `mixin`. Import codec_core.aowl rather than this file.

{.feature: "untyped".}

import std/options
import dynamic_ops

proc encodeOptionalField*[T, V, B](value: Option[T], name: string, ops: DynamicOps[V], prefix: B): B =
  mixin encodeField
  if value.isSome:
    encodeField(value.get, name, ops, prefix)
  else:
    prefix

proc decodeOptionalField*[T, V](t: typedesc[T], name: string, input: MapLike[V], ops: DynamicOps[V],
                                lenient: bool): DataResult[Option[T]] =
  mixin parse
  let value = getStr(input, name)
  if value.isNone:
    return newSuccess(none[T]())
  let parsed = parse(T, value.get, ops)
  if parsed.isError and lenient:
    return newSuccess(none[T]())
  if parsed.isSuccess:
    newSuccessWithLifecycle(some(parsed.successResult), parsed.successLifecycle)
  elif parsed.partialResult.len > 0:
    newPartialErrorWithLifecycle(parsed.message, some(parsed.partialResult[0]), parsed.errorLifecycle)
  else:
    newErrorWithLifecycle[Option[T]](parsed.message, parsed.errorLifecycle)
