## Known answers for optional_field.aowl, with both formats. Upstream has no tests of its own.

{.feature: "untyped".}

import std/syncio
import codecs
import nbt/tag
import nbt/nbt_ops

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc json() =
  let ops = jsonOps()
  let m = ops.getMap(js("""{"good":5,"bad":"text"}""")).unwrap
  let absent = decodeOptionalField(int32, "zz", m, ops, false)
  check(absent.isSuccess and absent.successResult.isNone, "absent")
  let good = decodeOptionalField(int32, "good", m, ops, false)
  check(good.successResult.get == 5'i32, "present")
  check(decodeOptionalField(int32, "bad", m, ops, true).unwrap.isNone, "lenient")
  checkEq(decodeOptionalField(int32, "bad", m, ops, false).message, "Not a number: \"text\"", "strict")
  # A partial inside stays a partial.
  let m2 = ops.getMap(js("""{"list":[1,2]}""")).unwrap
  check(decodeOptionalField(seq[int32], "list", m2, ops, false).unwrap.get == @[1'i32, 2], "seq field")

  var b = ops.mapBuilder()
  b = encodeOptionalField(some("v"), "yes", ops, b)
  b = encodeOptionalField(none[string](), "no", ops, b)
  checkEq($build(b, jsonNull()).unwrap, """{"yes":"v"}""", "encode")

proc nbt() =
  let ops = nbtOps()
  var c = newCompound()
  c.put("a", NbtTag(kind: ntkInt, intVal: 5))
  let t = NbtTag(kind: ntkCompound, compoundVal: c)
  let m = ops.getMap(t).unwrap
  check(decodeOptionalField(int32, "a", m, ops, false).unwrap.get == 5'i32, "nbt present")
  check(decodeOptionalField(int32, "z", m, ops, false).unwrap.isNone, "nbt absent")
  check(decodeOptionalField(string, "a", m, ops, true).unwrap.isNone, "nbt lenient")
  checkEq(decodeOptionalField(string, "a", m, ops, false).message, "Not a string", "nbt strict")
  var b = ops.mapBuilder()
  b = encodeOptionalField(some(7'i32), "yes", ops, b)
  b = encodeOptionalField(none[int32](), "no", ops, b)
  checkEq($build(b, NbtTag(kind: ntkEnd)).unwrap, "{yes: 7}", "nbt encode")

json()
nbt()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "optional_fieldtest ok"
