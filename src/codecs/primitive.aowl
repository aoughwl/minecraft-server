## Port of pumpkin-codecs/src/codec/primitive.rs
## `Primitive` and `impl_number!` are overloads of `encode` and `decode` per type. Stream types keep their
## single tuple field as `data`. Import codec_core.aowl rather than this file.

{.feature: "untyped".}

import dynamic_ops

type
  ByteBuffer* = object ## A `seq[int8]` wrapper with built-in DFU support for encoding and decoding.
    data*: seq[int8]
  IntStream* = object ## A `seq[int32]` wrapper with built-in DFU support for encoding and decoding.
    data*: seq[int32]
  LongStream* = object ## A `seq[int64]` wrapper with built-in DFU support for encoding and decoding.
    data*: seq[int64]

proc byteBuffer*(data: seq[int8]): ByteBuffer {.inline.} = ByteBuffer(data: data)
proc intStream*(data: seq[int32]): IntStream {.inline.} = IntStream(data: data)
proc longStream*(data: seq[int64]): LongStream {.inline.} = LongStream(data: data)

proc withRemainder*[R, V](d: DataResult[R], rest: V): DataResult[(R, V)] =
  ## `d.map(|r| (r, rest))`.
  if d.isSuccess:
    newSuccessWithLifecycle((d.successResult, rest), d.successLifecycle)
  elif d.partialResult.len > 0:
    newPartialErrorWithLifecycle(d.message, (d.partialResult[0], rest), d.errorLifecycle)
  else:
    newErrorWithLifecycle[(R, V)](d.message, d.errorLifecycle)

# --- impl_number! ----------------------------------------------------------------------------------

proc encode*[V](x: int8, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createByte(x))

proc encode*[V](x: int16, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createShort(x))

proc encode*[V](x: int32, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createInt(x))

proc encode*[V](x: int64, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createLong(x))

proc encode*[V](x: float32, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createFloat(x))

proc encode*[V](x: float64, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createDouble(x))

proc encode*[V](x: bool, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createBool(x))

proc encode*[V](x: string, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createString(x))

proc encode*[V](x: ByteBuffer, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createByteList(x.data))

proc encode*[V](x: IntStream, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createIntList(x.data))

proc encode*[V](x: LongStream, ops: DynamicOps[V], prefix: V): DataResult[V] =
  mergeIntoPrimitive(ops, prefix, ops.createLongList(x.data))

proc decode*[V](t: typedesc[int8], input: V, ops: DynamicOps[V]): DataResult[(int8, V)] =
  withRemainder(map(ops.getNumber(input), toInt8), ops.empty())

proc decode*[V](t: typedesc[int16], input: V, ops: DynamicOps[V]): DataResult[(int16, V)] =
  withRemainder(map(ops.getNumber(input), toInt16), ops.empty())

proc decode*[V](t: typedesc[int32], input: V, ops: DynamicOps[V]): DataResult[(int32, V)] =
  withRemainder(map(ops.getNumber(input), toInt32), ops.empty())

proc decode*[V](t: typedesc[int64], input: V, ops: DynamicOps[V]): DataResult[(int64, V)] =
  withRemainder(map(ops.getNumber(input), toInt64), ops.empty())

proc decode*[V](t: typedesc[float32], input: V, ops: DynamicOps[V]): DataResult[(float32, V)] =
  withRemainder(map(ops.getNumber(input), toFloat32), ops.empty())

proc decode*[V](t: typedesc[float64], input: V, ops: DynamicOps[V]): DataResult[(float64, V)] =
  withRemainder(map(ops.getNumber(input), toFloat64), ops.empty())

proc decode*[V](t: typedesc[bool], input: V, ops: DynamicOps[V]): DataResult[(bool, V)] =
  withRemainder(ops.getBool(input), ops.empty())

proc decode*[V](t: typedesc[string], input: V, ops: DynamicOps[V]): DataResult[(string, V)] =
  withRemainder(ops.getString(input), ops.empty())

proc decode*[V](t: typedesc[ByteBuffer], input: V, ops: DynamicOps[V]): DataResult[(ByteBuffer, V)] =
  withRemainder(map(ops.getByteList(input), byteBuffer), ops.empty())

proc decode*[V](t: typedesc[IntStream], input: V, ops: DynamicOps[V]): DataResult[(IntStream, V)] =
  withRemainder(map(ops.getIntList(input), intStream), ops.empty())

proc decode*[V](t: typedesc[LongStream], input: V, ops: DynamicOps[V]): DataResult[(LongStream, V)] =
  withRemainder(map(ops.getLongList(input), longStream), ops.empty())

# --- impl_number_and_unsigned! -----------------------------------------------------------------------

proc encode*[V](x: uint8, ops: DynamicOps[V], prefix: V): DataResult[V] =
  if x > 127'u8: newError[V]("Could not fit u8 into i8")
  else: encode(int8(x), ops, prefix)

proc encode*[V](x: uint16, ops: DynamicOps[V], prefix: V): DataResult[V] =
  if x > 32767'u16: newError[V]("Could not fit u16 into i16")
  else: encode(int16(x), ops, prefix)

proc encode*[V](x: uint32, ops: DynamicOps[V], prefix: V): DataResult[V] =
  if x > 2147483647'u32: newError[V]("Could not fit u32 into i32")
  else: encode(int32(x), ops, prefix)

proc encode*[V](x: uint64, ops: DynamicOps[V], prefix: V): DataResult[V] =
  if x > 9223372036854775807'u64: newError[V]("Could not fit u64 into i64")
  else: encode(int64(x), ops, prefix)

proc decode*[V](t: typedesc[uint8], input: V, ops: DynamicOps[V]): DataResult[(uint8, V)] =
  let i = map(ops.getNumber(input), toInt8)
  if not i.hasResultOrPartial: return propagateError[int8, (uint8, V)](i)
  let v = i.valueOrPartial
  if v < 0'i8: flatMapJoin(i, newError[(uint8, V)]("Could not fit i8 into u8"))
  else: flatMapJoin(i, newSuccess((uint8(v), ops.empty())))

proc decode*[V](t: typedesc[uint16], input: V, ops: DynamicOps[V]): DataResult[(uint16, V)] =
  let i = map(ops.getNumber(input), toInt16)
  if not i.hasResultOrPartial: return propagateError[int16, (uint16, V)](i)
  let v = i.valueOrPartial
  if v < 0'i16: flatMapJoin(i, newError[(uint16, V)]("Could not fit i16 into u16"))
  else: flatMapJoin(i, newSuccess((uint16(v), ops.empty())))

proc decode*[V](t: typedesc[uint32], input: V, ops: DynamicOps[V]): DataResult[(uint32, V)] =
  let i = map(ops.getNumber(input), toInt32)
  if not i.hasResultOrPartial: return propagateError[int32, (uint32, V)](i)
  let v = i.valueOrPartial
  if v < 0'i32: flatMapJoin(i, newError[(uint32, V)]("Could not fit i32 into u32"))
  else: flatMapJoin(i, newSuccess((uint32(v), ops.empty())))

proc decode*[V](t: typedesc[uint64], input: V, ops: DynamicOps[V]): DataResult[(uint64, V)] =
  let i = map(ops.getNumber(input), toInt64)
  if not i.hasResultOrPartial: return propagateError[int64, (uint64, V)](i)
  let v = i.valueOrPartial
  if v < 0'i64: flatMapJoin(i, newError[(uint64, V)]("Could not fit i64 into u64"))
  else: flatMapJoin(i, newSuccess((uint64(v), ops.empty())))
