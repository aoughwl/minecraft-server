## Upstream's tests of pumpkin-codecs/src/codec/primitive.rs, and known answers for its conversions.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc encoding() =
  let ops = jsonOps()
  assertEncodeSuccess(3'i32, ops, js("3"))
  assertEncodeSuccess(-68'i8, ops, js("-68"))
  assertEncodeSuccess(-913_813_743'i32, ops, js("-913813743"))
  assertEncodeSuccess("Hello, world!", ops, js("\"Hello, world!\""))
  assertEncodeSuccess("", ops, js("\"\""))
  assertEncodeSuccess(byteBuffer(@[1'i8, 2, 3]), ops, js("[1,2,3]"))
  assertEncodeSuccess(intStream(@[3'i32, 6, 9, 11, 15]), ops, js("[3,6,9,11,15]"))
  assertEncodeSuccess(longStream(@[4'i64, 6, 9, 12]), ops, js("[4,6,9,12]"))
  assertEncodeSuccess(3'u8, ops, js("3"))
  assertEncodeSuccess(923_482_312'u64, ops, js("923482312"))

proc decoding() =
  let ops = jsonOps()
  assertDecodeIsSuccess(int32, js("-2"), ops)
  assertDecodeIsError(bool, js("\"hello\""), ops)
  assertDecodeIsError(bool, js("0"), ops)
  assertDecodeIsSuccess(IntStream, js("[1,2,3]"), ops)
  assertDecodeIsSuccess(LongStream, js("[]"), ops)
  assertDecodeIsError(ByteBuffer, js("""["not a number"]"""), ops)
  assertDecodeIsSuccess(string, js("\"cool\""), ops)
  assertDecodeIsError(string, js("1"), ops)
  assertDecodeIsError(uint32, js("-45"), ops)
  assertDecodeIsError(uint64, js("-132541235"), ops)
  assertDecodeIsSuccess(uint64, js("132541235"), ops)

proc knownAnswers() =
  let ops = jsonOps()
  # Every primitive, to exact JSON and back.
  checkEq($encodeStart(1'i16, ops).unwrap, "1", "i16")
  checkEq($encodeStart(1'i64, ops).unwrap, "1", "i64")
  checkEq($encodeStart(1.5'f32, ops).unwrap, "1.5", "f32")
  checkEq($encodeStart(0.1'f32, ops).unwrap, "0.10000000149011612", "f32 widens as serde_json does")
  checkEq($encodeStart(0.1'f64, ops).unwrap, "0.1", "f64")
  checkEq($encodeStart(true, ops).unwrap, "true", "bool")
  checkEq($encodeStart(1'u16, ops).unwrap, "1", "u16")
  checkEq($encodeStart(1'u32, ops).unwrap, "1", "u32")
  check(parse(int8, js("-5"), ops).unwrap == -5'i8, "decode i8")
  check(parse(int8, js("200"), ops).unwrap == -56'i8, "decode i8 truncates")
  check(parse(int16, js("70000"), ops).unwrap == 4464'i16, "decode i16 truncates")
  check(parse(int32, js("1.9"), ops).unwrap == 1'i32, "decode i32 from a float")
  check(parse(int64, js("9007199254740993"), ops).unwrap == 9007199254740993'i64, "decode i64")
  check(parse(float32, js("1.5"), ops).unwrap == 1.5'f32, "decode f32")
  check(parse(float64, js("2"), ops).unwrap == 2.0, "decode f64")
  check(parse(bool, js("true"), ops).unwrap, "decode bool")
  check(parse(string, js("\"a\""), ops).unwrap == "a", "decode string")
  check(parse(uint8, js("127"), ops).unwrap == 127'u8, "decode u8")
  check(parse(uint16, js("5"), ops).unwrap == 5'u16, "decode u16")
  check(parse(uint32, js("5"), ops).unwrap == 5'u32, "decode u32")
  check(parse(IntStream, js("[1,2.5]"), ops).unwrap.data == @[1'i32, 2], "decode IntStream")
  check(parse(LongStream, js("[1]"), ops).unwrap.data == @[1'i64], "decode LongStream")
  check(parse(ByteBuffer, js("[1]"), ops).unwrap.data == @[1'i8], "decode ByteBuffer")
  check(decode(int32, js("1"), ops).successResult[1].kind == jvNull, "remainder is empty")

  # Messages
  checkEq(encodeStart(200'u8, ops).message, "Could not fit u8 into i8", "u8 too large")
  checkEq(encodeStart(40000'u16, ops).message, "Could not fit u16 into i16", "u16 too large")
  checkEq(encodeStart(3000000000'u32, ops).message, "Could not fit u32 into i32", "u32 too large")
  checkEq(encodeStart(10000000000000000000'u64, ops).message, "Could not fit u64 into i64", "u64 too large")
  checkEq(parse(uint8, js("-1"), ops).message, "Could not fit i8 into u8", "u8 negative")
  checkEq(parse(uint16, js("-1"), ops).message, "Could not fit i16 into u16", "u16 negative")
  checkEq(parse(uint32, js("-45"), ops).message, "Could not fit i32 into u32", "u32 negative")
  checkEq(parse(uint64, js("-45"), ops).message, "Could not fit i64 into u64", "u64 negative")
  checkEq(parse(uint32, js("true"), ops).message, "Not a number: true", "u32 not a number")
  checkEq(parse(bool, js("0"), ops).message, "Not a boolean: 0", "bool")
  checkEq(parse(string, js("1"), ops).message, "Not a string: 1", "string")
  checkEq(parse(ByteBuffer, js("""["not a number"]"""), ops).message, "Some elements are not bytes", "bytes")
  checkEq(parse(IntStream, js("""["x"]"""), ops).message, "Some elements are not ints", "ints")
  checkEq(parse(LongStream, js("""["x"]"""), ops).message, "Some elements are not longs", "longs")
  checkEq(parse(IntStream, js("5"), ops).message, "Not a JSON array: 5", "not an array")
  checkEq(encode(1'i32, ops, js("2")).message, "Do not know how to append a primitive value 1 to 2", "non-empty prefix")

encoding()
decoding()
knownAnswers()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "primitivetest ok"
