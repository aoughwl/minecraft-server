## Port of pumpkin-codecs/src/struct_builder.rs
## The traits are procs overloaded per builder. `StringStructBuilder[V]` is what `impl_struct_builder!`
## plus `impl_string_struct_builder!(builder, $ops)` generate: `JsonStructBuilder` and `NbtStructBuilder`
## differ only in `append` and `build_with_builder`, which sit on `DynamicOps` (`structAppend`,
## `buildWithBuilder`), so both are this one type and `ops.mapBuilder()` needs no associated type.
## `MapBuilder[T]` is upstream's universal builder.
##
## The Rust combinator closures (`flat_map`, `map`, `apply_2_and_make_stable`) are written out as `if`s,
## because a closure in a generic proc may not call `ops`' closures (compiler bug).

{.feature: "untyped".}

import dynamic_ops

type
  StringStructBuilder*[V] = object
    builder*: DataResult[V]
    ops*: DynamicOps[V]

  MapBuilder*[T] = object
    builder*: DataResult[seq[(T, T)]]
    ops*: DynamicOps[T]

proc mapBuilder*[V](ops: DynamicOps[V]): StringStructBuilder[V] =
  ## `DynamicOps::map_builder`.
  StringStructBuilder[V](builder: newSuccessWithLifecycle(ops.structSeed(), stable()), ops: ops)

proc newMapBuilder*[T](ops: DynamicOps[T]): MapBuilder[T] =
  let none: seq[(T, T)] = @[]
  MapBuilder[T](builder: newSuccess(none), ops: ops)

# --- impl_struct_builder! --------------------------------------------------------------------------

proc setLifecycle*[V](b: StringStructBuilder[V], lifecycle: Lifecycle): StringStructBuilder[V] =
  result = b
  result.builder = withLifecycle(b.builder, lifecycle)

proc mapError*[V](b: StringStructBuilder[V], f: proc (m: string): string {.closure.}): StringStructBuilder[V] =
  result = b
  result.builder = mapError(b.builder, f)

proc withErrorsFrom*[V, U](b: StringStructBuilder[V], other: DataResult[U]): StringStructBuilder[V] =
  result = b
  result.builder = withErrorsFrom(b.builder, other)

proc build*[V](b: StringStructBuilder[V], prefix: V): DataResult[V] =
  if not b.builder.hasResultOrPartial:
    return propagateError[V, V](b.builder)
  flatMapJoin(b.builder, b.ops.buildWithBuilder(b.builder.valueOrPartial, prefix))

proc setLifecycle*[T](b: MapBuilder[T], lifecycle: Lifecycle): MapBuilder[T] =
  result = b
  result.builder = withLifecycle(b.builder, lifecycle)

proc mapError*[T](b: MapBuilder[T], f: proc (m: string): string {.closure.}): MapBuilder[T] =
  result = b
  result.builder = mapError(b.builder, f)

proc withErrorsFrom*[T, U](b: MapBuilder[T], other: DataResult[U]): MapBuilder[T] =
  result = b
  result.builder = withErrorsFrom(b.builder, other)

proc buildWithBuilder*[T](b: MapBuilder[T], builder: seq[(T, T)], prefix: T): DataResult[T] =
  mergeEntriesIntoMap(b.ops, prefix, builder)

proc build*[T](b: MapBuilder[T], prefix: T): DataResult[T] =
  if not b.builder.hasResultOrPartial:
    return propagateError[seq[(T, T)], T](b.builder)
  flatMapJoin(b.builder, buildWithBuilder(b, b.builder.valueOrPartial, prefix))

# --- impl_string_struct_builder! -------------------------------------------------------------------

proc appendMapped[V](b: StringStructBuilder[V], key: string, value: V): DataResult[V] =
  ## `builder.map(|r| self.append(key, value, r))`
  let d = b.builder
  if d.isSuccess:
    newSuccessWithLifecycle(b.ops.structAppend(key, value, d.successResult), d.successLifecycle)
  elif d.partialResult.len > 0:
    newPartialErrorWithLifecycle(d.message, b.ops.structAppend(key, value, d.partialResult[0]), d.errorLifecycle)
  else:
    newErrorWithLifecycle[V](d.message, d.errorLifecycle)

proc appendApplied[V](b: StringStructBuilder[V], key: string, value: DataResult[V]): DataResult[V] =
  ## `builder.apply_2_and_make_stable(|r, v| self.append(key, v, r), value)`
  let d = b.builder
  if d.isSuccess and value.isSuccess:
    newSuccessWithLifecycle(b.ops.structAppend(key, value.successResult, d.successResult), stable())
  elif bothHaveValues(d, value):
    newPartialErrorWithLifecycle(combineMessages(d, value),
      b.ops.structAppend(key, value.valueOrPartial, d.valueOrPartial), stable())
  else:
    newErrorWithLifecycle[V](combineMessages(d, value), stable())

proc addStringKeyValue*[V](b: StringStructBuilder[V], key: string, value: V): StringStructBuilder[V] =
  result = b
  result.builder = appendMapped(b, key, value)

proc addStringKeyValueResult*[V](b: StringStructBuilder[V], key: string, value: DataResult[V]): StringStructBuilder[V] =
  result = b
  result.builder = appendApplied(b, key, value)

proc addKeyValue*[V](b: StringStructBuilder[V], key, value: V): StringStructBuilder[V] =
  result = b
  let s = b.ops.getString(key)
  if s.hasResultOrPartial:
    result.builder = flatMapJoin(s, appendMapped(b, s.valueOrPartial, value))
  else:
    result.builder = propagateError[string, V](s)

proc addKeyValueResult*[V](b: StringStructBuilder[V], key: V, value: DataResult[V]): StringStructBuilder[V] =
  result = b
  let s = b.ops.getString(key)
  if s.hasResultOrPartial:
    result.builder = flatMapJoin(s, appendApplied(b, s.valueOrPartial, value))
  else:
    result.builder = propagateError[string, V](s)

proc addKeyResultValueResult*[V](b: StringStructBuilder[V], key, value: DataResult[V]): StringStructBuilder[V] =
  result = b
  if not key.hasResultOrPartial:
    result.builder = propagateError[V, V](key)
    return
  let s = flatMapJoin(key, b.ops.getString(key.valueOrPartial))
  if s.hasResultOrPartial:
    result.builder = flatMapJoin(s, appendApplied(b, s.valueOrPartial, value))
  else:
    result.builder = propagateError[string, V](s)

proc buildWithResultPrefix*[V](b: StringStructBuilder[V], prefix: DataResult[V]): DataResult[V] =
  if not prefix.hasResultOrPartial:
    return propagateError[V, V](prefix)
  flatMapJoin(prefix, build(b, prefix.valueOrPartial))

# --- impl_universal_struct_builder! ----------------------------------------------------------------

proc append*[T](b: MapBuilder[T], key, value: T, builder: seq[(T, T)]): seq[(T, T)] =
  result = builder
  result.add (key, value)

proc addKeyValue*[T](b: MapBuilder[T], key, value: T): MapBuilder[T] =
  result = b
  let d = b.builder
  if d.isSuccess:
    result.builder = newSuccessWithLifecycle(append(b, key, value, d.successResult), d.successLifecycle)
  elif d.partialResult.len > 0:
    result.builder = newPartialErrorWithLifecycle(d.message, append(b, key, value, d.partialResult[0]), d.errorLifecycle)

proc addKeyValueResult*[T](b: MapBuilder[T], key: T, value: DataResult[T]): MapBuilder[T] =
  result = b
  let d = b.builder
  if d.isSuccess and value.isSuccess:
    result.builder = newSuccessWithLifecycle(append(b, key, value.successResult, d.successResult), stable())
  elif bothHaveValues(d, value):
    result.builder = newPartialErrorWithLifecycle(combineMessages(d, value),
      append(b, key, value.valueOrPartial, d.valueOrPartial), stable())
  else:
    result.builder = newErrorWithLifecycle[seq[(T, T)]](combineMessages(d, value), stable())

proc addKeyResultValueResult*[T](b: MapBuilder[T], key, value: DataResult[T]): MapBuilder[T] =
  ## `self.builder.clone().apply(key.apply_2_and_make_stable(|k, v| (|b| self.append(k, v, b)), value))`
  result = b
  let d = b.builder
  # The function result: stable, and has a function when both key and value have a value.
  let lifecycle = add(lifecycleOf(d), stable())
  let pairHasValue = bothHaveValues(key, value)
  let pairIsSuccess = key.isSuccess and value.isSuccess
  if d.isSuccess and pairIsSuccess:
    result.builder = newSuccessWithLifecycle(append(b, key.successResult, value.successResult, d.successResult), lifecycle)
    return
  let pairMessage = if pairIsSuccess: "" else: combineMessages(key, value)
  let message =
    if d.isSuccess: pairMessage
    elif pairIsSuccess: d.message
    else: appendMessages(d.message, pairMessage)
  if d.hasResultOrPartial and pairHasValue:
    result.builder = newPartialErrorWithLifecycle(message,
      append(b, key.valueOrPartial, value.valueOrPartial, d.valueOrPartial), lifecycle)
  else:
    result.builder = newErrorWithLifecycle[seq[(T, T)]](message, lifecycle)

proc addStringKeyValue*[T](b: MapBuilder[T], key: string, value: T): MapBuilder[T] =
  addKeyValue(b, b.ops.createString(key), value)

proc addStringKeyValueResult*[T](b: MapBuilder[T], key: string, value: DataResult[T]): MapBuilder[T] =
  addKeyValueResult(b, b.ops.createString(key), value)

proc buildWithResultPrefix*[T](b: MapBuilder[T], prefix: DataResult[T]): DataResult[T] =
  if not prefix.hasResultOrPartial:
    return propagateError[T, T](prefix)
  flatMapJoin(prefix, build(b, prefix.valueOrPartial))
