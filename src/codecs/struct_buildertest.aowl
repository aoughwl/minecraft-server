## Known answers for struct_builder.aowl. Upstream has no tests of its own; each case follows the macros' Rust.

{.feature: "untyped".}

import std/syncio
import codecs

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc js(text: string): JsonValue =
  let o = parseJsonValue(text)
  if not o.ok:
    echo "bad json in test: ", text
    quit(1)
  o.value

proc stringBuilder() =
  let ops = jsonOps()
  var b = ops.mapBuilder()
  b = addKeyValue(b, js("\"a\""), js("1"))
  check(b.builder.lifecycleOf == experimental(), "dynamic keys take get_string's lifecycle")
  b = addKeyValueResult(b, js("\"b\""), newSuccess(js("2")))
  b = addKeyResultValueResult(b, newSuccess(js("\"c\"")), newSuccess(js("3")))
  checkEq($build(b, js("null")).unwrap, """{"a":1,"b":2,"c":3}""", "dynamic keys")

  # A value error with no result empties the builder; later errors stack.
  var e = ops.mapBuilder()
  e = addStringKeyValue(e, "a", js("1"))
  e = addStringKeyValueResult(e, "b", newError[JsonValue]("bad b"))
  e = addStringKeyValueResult(e, "c", newError[JsonValue]("bad c"))
  e = addStringKeyValue(e, "d", js("4"))
  checkEq(build(e, js("null")).message, "bad b; bad c", "value errors stack")
  check(not build(e, js("null")).hasResultOrPartial, "no result left")
  check(e.builder.lifecycleOf == stable(), "apply_2_and_make_stable")

  # A partial value keeps going, and the builder is a partial.
  var p = ops.mapBuilder()
  p = addStringKeyValueResult(p, "a", newPartialError("soft", js("1")))
  checkEq(p.builder.message, "soft", "partial value message")
  p = addStringKeyValue(p, "b", js("2"))
  checkEq($p.builder.unwrapOrPartial, """{"a":1,"b":2}""", "partial builder keeps appending")
  let pb = build(p, js("null"))
  checkEq(pb.message, "soft", "partial builder message")
  checkEq($pb.unwrapOrPartial, """{"a":1,"b":2}""", "partial builder value")

  # A bad dynamic key replaces the builder with get_string's error, as `self.builder = ...flat_map`.
  var k = addStringKeyValue(ops.mapBuilder(), "a", js("1"))
  k = addKeyValue(k, js("5"), js("1"))
  checkEq(k.builder.message, "Not a string: 5", "bad key")
  check(not k.builder.hasResultOrPartial, "bad key drops the builder")
  var kr = addStringKeyValue(ops.mapBuilder(), "a", js("1"))
  kr = addKeyValueResult(kr, js("5"), newSuccess(js("1")))
  checkEq(kr.builder.message, "Not a string: 5", "bad key with a result")
  var krr = ops.mapBuilder()
  krr = addKeyResultValueResult(krr, newError[JsonValue]("no key"), newSuccess(js("1")))
  checkEq(krr.builder.message, "no key", "key error")
  var krs = ops.mapBuilder()
  krs = addKeyResultValueResult(krs, newSuccess(js("5")), newSuccess(js("1")))
  checkEq(krs.builder.message, "Not a string: 5", "key result is not a string")
  # A partial key whose string is good: the key's message stays and the value is added as a partial.
  var kp = ops.mapBuilder()
  kp = addKeyResultValueResult(kp, newPartialError("soft key", js("\"a\"")), newSuccess(js("1")))
  checkEq(kp.builder.message, "soft key", "partial key message")
  checkEq($kp.builder.unwrapOrPartial, """{"a":1}""", "partial key value")

  # with_errors_from, set_lifecycle, map_error, build_with_result_prefix
  let w = withErrorsFrom(ops.mapBuilder(), newError[int32]("other"))
  checkEq(w.builder.message, "other", "with_errors_from")
  checkEq($w.builder.unwrapOrPartial, "{}", "with_errors_from keeps the builder as a partial")
  check(withErrorsFrom(ops.mapBuilder(), newSuccess(1'i32)).builder.isSuccess, "with_errors_from success")
  check(setLifecycle(ops.mapBuilder(), deprecated(4'u32)).builder.lifecycleOf == deprecated(4'u32), "set_lifecycle")
  let up = proc (m: string): string {.closure.} = "ctx: " & m
  checkEq(mapError(w, up).builder.message, "ctx: other", "map_error")

  let b1 = addStringKeyValue(ops.mapBuilder(), "a", js("1"))
  checkEq($buildWithResultPrefix(b1, newSuccess(js("""{"z":1}"""))).unwrap, """{"a":1,"z":1}""", "build_with_result_prefix")
  checkEq(buildWithResultPrefix(b1, newError[JsonValue]("no prefix")).message, "no prefix", "build_with_result_prefix error")
  let viaPartial = buildWithResultPrefix(b1, newPartialError("soft", js("{}")))
  checkEq(viaPartial.message, "soft", "build_with_result_prefix partial message")
  checkEq($viaPartial.unwrapOrPartial, """{"a":1}""", "build_with_result_prefix partial value")

proc universalBuilder() =
  let ops = jsonOps()
  var b = newMapBuilder(ops)
  check(b.builder.lifecycleOf == experimental(), "MapBuilder starts with new_success in this port's constructor")
  b = addKeyValue(b, js("\"a\""), js("1"))
  b = addKeyValueResult(b, js("\"b\""), newSuccess(js("2")))
  b = addKeyResultValueResult(b, newSuccess(js("\"c\"")), newSuccess(js("3")))
  b = addStringKeyValue(b, "d", js("4"))
  b = addStringKeyValueResult(b, "e", newSuccess(js("5")))
  checkEq($build(b, js("null")).unwrap, """{"a":1,"b":2,"c":3,"d":4,"e":5}""", "universal builder")
  checkEq($build(b, js("""{"z":0}""")).unwrap, """{"a":1,"b":2,"c":3,"d":4,"e":5,"z":0}""", "universal builder prefix")

  # Keys are kept dynamic: the error comes at build.
  var bad = addKeyValue(newMapBuilder(ops), js("5"), js("1"))
  check(bad.builder.isSuccess, "universal builder accepts any key")
  checkEq(build(bad, js("null")).message, "Key is not a string: 5", "universal builder bad key at build")

  var e = newMapBuilder(ops)
  e = addKeyValueResult(e, js("\"a\""), newError[JsonValue]("bad a"))
  e = addKeyValueResult(e, js("\"b\""), newError[JsonValue]("bad b"))
  checkEq(e.builder.message, "bad a; bad b", "universal builder stacks")
  checkEq(build(e, js("null")).message, "bad a; bad b", "universal builder build error")

  var p = newMapBuilder(ops)
  p = addKeyValueResult(p, js("\"a\""), newPartialError("soft", js("1")))
  check(p.builder.partialResult.len == 1, "universal builder partial")
  p = addKeyValue(p, js("\"b\""), js("2"))
  check(p.builder.partialResult[0].len == 2, "universal builder keeps appending")

  # The `apply` arm: builder error and pair error messages stack, builder first.
  var rr = newMapBuilder(ops)
  rr = addKeyResultValueResult(rr, newError[JsonValue]("no key"), newError[JsonValue]("no value"))
  checkEq(rr.builder.message, "no key; no value", "pair messages")
  check(not rr.builder.hasResultOrPartial, "pair no result")
  rr = addKeyResultValueResult(rr, newError[JsonValue]("k2"), newSuccess(js("1")))
  checkEq(rr.builder.message, "no key; no value; k2", "builder and pair messages")
  var rp = newMapBuilder(ops)
  rp = addKeyResultValueResult(rp, newPartialError("pk", js("\"a\"")), newSuccess(js("1")))
  checkEq(rp.builder.message, "pk", "partial pair message")
  check(rp.builder.partialResult[0].len == 1, "partial pair appended")

  let w = withErrorsFrom(newMapBuilder(ops), newError[int32]("other"))
  checkEq(w.builder.message, "other", "universal with_errors_from")
  check(setLifecycle(newMapBuilder(ops), stable()).builder.lifecycleOf == stable(), "universal set_lifecycle")
  let up = proc (m: string): string {.closure.} = "ctx: " & m
  checkEq(mapError(w, up).builder.message, "ctx: other", "universal map_error")
  checkEq($buildWithResultPrefix(addStringKeyValue(newMapBuilder(ops), "a", js("1")), newSuccess(js("null"))).unwrap, """{"a":1}""", "universal build_with_result_prefix")

stringBuilder()
universalBuilder()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "struct_buildertest ok"
