proc newMsgArgConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atString, behavior: spGreedyPhrase),
    overrideSuggestion: none[SuggestionProviders](), defaultName: "msg",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var word = RawArg()
      if not popRaw(args, word):
        return false
      var msg = word.value
      while popRaw(args, word):
        msg.add(' ')
        msg.add(word.value)
      res = Arg(kind: akMsg, str: msg)
      true)

proc parseGamemodeArg(s: string; mode: var GameMode): bool =
  ## An `i8` id first, then the name.
  var v = 0'i64
  var i = 0
  var neg = false
  if s.len > 0 and (s[0] == '-' or s[0] == '+'):
    neg = s[0] == '-'
    i = 1
  var numeric = i < s.len
  while numeric and i < s.len:
    if s[i] < '0' or s[i] > '9' or v > 128'i64:
      numeric = false
    else:
      v = v * 10'i64 + int64(ord(s[i]) - ord('0'))
    inc i
  if numeric:
    let id = if neg: -v else: v
    if id == 0'i64:
      mode = Survival
      return true
    if id == 1'i64:
      mode = Creative
      return true
    if id == 2'i64:
      mode = Adventure
      return true
    if id == 3'i64:
      mode = Spectator
      return true
  let (ok, g) = parseGameMode(s)
  if ok:
    mode = g
  ok

proc newGamemodeArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atGamemode), overrideSuggestion: none[SuggestionProviders](),
    defaultName: "gamemode",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var mode = Survival
      if parseGamemodeArg(raw.value, mode):
        res = Arg(kind: akGameMode, gameMode: mode)
        true
      else:
        false)

proc newSimpleArgConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atString, behavior: spSingleWord),
    overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      res = Arg(kind: akSimple, str: raw.value)
      true)

proc newBoolArgConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atBool), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      if raw.value == "false":
        res = Arg(kind: akBool, boolean: false)
        true
      elif raw.value == "true":
        res = Arg(kind: akBool, boolean: true)
        true
      else:
        false)

proc newTimeArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atTime, min: 0'i32), overrideSuggestion: none[SuggestionProviders](),
    defaultName: "time",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let s = raw.value
      var pos = -1
      var i = 0
      while i < s.len:
        if (s[i] >= 'a' and s[i] <= 'z') or (s[i] >= 'A' and s[i] <= 'Z'):
          pos = i
          break
        inc i
      let numStr = if pos >= 0: s[0 ..< pos] else: s
      let unit = if pos >= 0: s[pos ..< s.len] else: "t"
      var number = 0.0
      if not parseF64Checked(numStr, number):
        return false
      if float32(number) < 0.0'f32:
        return false
      var ticks = float32(number)
      if unit == "d":
        ticks = ticks * 24000.0'f32
      elif unit == "s":
        ticks = ticks * 20.0'f32
      elif unit != "t":
        return false
      res = Arg(kind: akTime, time: int32(round(ticks)))
      true)

proc findTime*(args: ConsumedArgs; name: string; res: var int32): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akTime:
    res = a.time
    return true
  false

# ---- args/entities.rs ---------------------------------------------------------------------------------------------

type
  TargetSelectorParseError* = object
    message*: string
    cursor*: int

proc entityFilterFromStr(s: string; f: var EntityFilter; err: var string): bool =
  let eq = s.find('=')
  if eq < 0:
    err = "Missing value in entity filter"
    return false
  let key = s[0 ..< eq]
  var value = s[eq + 1 ..< s.len]
  let negate = value.startsWith("!")
  if negate:
    value = value[1 ..< value.len]
  if key == "type":
    let name = if value.startsWith("minecraft:"): value[10 ..< value.len] else: value
    if fromName(EntityType, name).isNone:
      err = "Invalid entity type " & value
      return false
    f = EntityFilter(kind: efkType, negate: negate, value: name)
  elif key == "limit":
    var v = 0'u64
    if value.len == 0:
      err = "Invalid limit value"
      return false
    for c in value:
      if c < '0' or c > '9':
        err = "Invalid limit value"
        return false
      v = v * 10'u64 + uint64(ord(c) - ord('0'))
    if negate:
      err = "Negation of limit is not allowed"
      return false
    f = EntityFilter(kind: efkLimit, limit: v)
  elif key == "sort":
    var sort = efsArbitrary
    if value == "arbitrary": sort = efsArbitrary
    elif value == "nearest": sort = efsNearest
    elif value == "furthest": sort = efsFurthest
    elif value == "random": sort = efsRandom
    else:
      err = "Invalid sort type " & value
      return false
    if negate:
      err = "Negation of sort is not allowed"
      return false
    f = EntityFilter(kind: efkSort, sort: sort)
  elif key == "name":
    f = EntityFilter(kind: efkName, negate: negate, value: value)
  elif key == "tag":
    f = EntityFilter(kind: efkTag, negate: negate, value: value)
  elif key == "team":
    f = EntityFilter(kind: efkTeam, negate: negate, value: value)
  elif key == "scores":
    f = EntityFilter(kind: efkScore)
  elif key == "advancements" or key == "predicate":
    f = EntityFilter(kind: efkSort, sort: efsArbitrary)
  elif key == "nbt":
    f = EntityFilter(kind: efkNbt)
  else:
    err = "Unimplemented key: " & key
    return false
  true

proc newTargetSelector*(t: EntitySelectorType): TargetSelector =
  var conditions: seq[EntityFilter] = @[]
  case t
  of estSource:
    conditions.add(EntityFilter(kind: efkLimit, limit: 1'u64))
  of estNearestPlayer, estNearestEntity:
    conditions.add(EntityFilter(kind: efkSort, sort: efsNearest))
    conditions.add(EntityFilter(kind: efkLimit, limit: 1'u64))
  of estRandomPlayer:
    conditions.add(EntityFilter(kind: efkSort, sort: efsRandom))
    conditions.add(EntityFilter(kind: efkLimit, limit: 1'u64))
  of estNamedPlayer, estUuid:
    conditions.add(EntityFilter(kind: efkLimit, limit: 1'u64))
  of estAllPlayers, estAllEntities:
    discard
  TargetSelector(selectorType: t, conditions: conditions)

proc includesEntities*(s: TargetSelector): bool =
  result = s.selectorType == estAllEntities or s.selectorType == estNearestEntity
  for c in s.conditions:
    if c.kind == efkType:
      if not c.negate:
        result = c.value != "player"
      elif c.value == "player":
        result = true

proc getSort*(s: TargetSelector; sort: var EntityFilterSort): bool =
  var i = s.conditions.len - 1
  while i >= 0:
    if s.conditions[i].kind == efkSort:
      sort = s.conditions[i].sort
      return true
    dec i
  false

proc getLimit*(s: TargetSelector): uint64 =
  var i = s.conditions.len - 1
  while i >= 0:
    if s.conditions[i].kind == efkLimit:
      return s.conditions[i].limit
    dec i
  high(uint64)

proc parseSelectorFilter(selector: var TargetSelector; rawFilter: string; filterOffset: int;
                         err: var TargetSelectorParseError): bool =
  let trimmed = strip(rawFilter)
  if trimmed.len == 0:
    return true
  var localStart = 0
  while localStart < rawFilter.len and rawFilter[localStart] in {' ', '\t', '\n', '\r'}:
    inc localStart
  var f = EntityFilter(kind: efkNbt)
  var message = ""
  if not entityFilterFromStr(trimmed, f, message):
    err = TargetSelectorParseError(message: message, cursor: filterOffset + localStart)
    return false
  selector.conditions.add(f)
  true

proc parseTargetSelector*(arg: string; selector: var TargetSelector; err: var TargetSelectorParseError): bool =
  if not arg.startsWith("@"):
    let (ok, id) = parseStr(arg)
    if ok:
      selector = newTargetSelector(estUuid)
      selector.uuid = id
    else:
      selector = newTargetSelector(estNamedPlayer)
      selector.name = arg
    return true
  let bracket = arg.find('[')
  let typeEnd = if bracket >= 0: bracket else: arg.len
  let typeStr = arg[0 ..< typeEnd]
  var t = estSource
  if typeStr == "@a": t = estAllPlayers
  elif typeStr == "@e": t = estAllEntities
  elif typeStr == "@s": t = estSource
  elif typeStr == "@p": t = estNearestPlayer
  elif typeStr == "@r": t = estRandomPlayer
  elif typeStr == "@n": t = estNearestEntity
  else:
    err = TargetSelectorParseError(message: "Invalid target selector type " & typeStr, cursor: max(typeEnd - 1, 0))
    return false
  selector = newTargetSelector(t)
  if typeEnd == arg.len:
    return true
  if not arg.endsWith("]"):
    err = TargetSelectorParseError(message: "Target selector must end with ]", cursor: arg.len)
    return false
  let content = arg[typeEnd + 1 ..< arg.len - 1]
  var filterStart = 0
  var curlyDepth = 0
  var i = 0
  while i < content.len:
    let c = content[i]
    if c == '{':
      inc curlyDepth
    elif c == '}':
      dec curlyDepth
    elif c == ',' and curlyDepth == 0:
      if not parseSelectorFilter(selector, content[filterStart ..< i], typeEnd + 1 + filterStart, err):
        return false
      filterStart = i + 1
    inc i
  parseSelectorFilter(selector, content[filterStart ..< content.len], typeEnd + 1 + filterStart, err)

proc syntaxErrorForArgWithCursor(raw: RawArg; message: TextComponent; localCursor: int): CommandSyntaxError =
  var clamped = min(localCursor, raw.value.len)
  while clamped > 0 and clamped < raw.value.len and (uint8(raw.value[clamped]) and 0xC0'u8) == 0x80'u8:
    dec clamped
  syntaxErrorWith(dispatcherUnknownArgument(), message,
    CommandSyntaxErrorContext(input: raw.input, cursor: raw.start + clamped))

proc parseTargetSelectorWithContext*(raw: RawArg; selector: var TargetSelector): CmdVoidResult =
  var err = TargetSelectorParseError()
  if parseTargetSelector(raw.value, selector, err):
    return cmdOkVoid()
  cmdFailVoid(syntaxErrorForArgWithCursor(raw,
    translateCross(JAVA_ARGUMENT_ENTITY_INVALID, JAVA_ARGUMENT_ENTITY_INVALID), err.cursor))

proc ensurePlayerOnlySelector*(selector: TargetSelector; raw: RawArg): CmdVoidResult =
  if includesEntities(selector):
    cmdFailVoid(syntaxErrorForArgWithCursor(raw,
      translateCross(JAVA_ARGUMENT_PLAYER_ENTITIES, JAVA_ARGUMENT_PLAYER_ENTITIES), 0))
  else:
    cmdOkVoid()

proc selectEntitiesOf(server: nil CommandServer; selector: TargetSelector; sender: CommandSender): seq[CommandEntity] =
  var none0: seq[CommandEntity] = @[]
  if server != nil and server.selectEntities != nil:
    return server.selectEntities(selector, sender)
  none0

proc selectPlayersOf(server: nil CommandServer; selector: TargetSelector; sender: CommandSender): seq[CommandPlayer] =
  var none0: seq[CommandPlayer] = @[]
  if server != nil and server.selectPlayers != nil:
    return server.selectPlayers(selector, sender)
  none0

proc newEntitiesArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atEntity, flags: 0'u8),
    overrideSuggestion: none[SuggestionProviders](), defaultName: "targets",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var selector = newTargetSelector(estSource)
      var err = TargetSelectorParseError()
      if not parseTargetSelector(raw.value, selector, err):
        return false
      res = Arg(kind: akEntities, entities: selectEntitiesOf(server, selector, sender))
      true,
    consumeWithSyntax: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg;
                            found: var bool): CmdVoidResult {.closure.} =
      var raw = RawArg()
      found = false
      if not popRaw(args, raw):
        return cmdOkVoid()
      var selector = newTargetSelector(estSource)
      let p = parseTargetSelectorWithContext(raw, selector)
      if not p.isOk:
        return p
      res = Arg(kind: akEntities, entities: selectEntitiesOf(server, selector, sender))
      found = true
      cmdOkVoid())

proc newPlayersArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atEntity, flags: EntityFlagPlayersOnly),
    overrideSuggestion: none[SuggestionProviders](), defaultName: "target",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let s = raw.value
      var players: seq[CommandPlayer] = @[]
      if s == "@s" or s == "@n" or s == "@p":
        if sender.kind == cskPlayer:
          players.add(sender.player)
          res = Arg(kind: akPlayers, players: players)
          return true
      if server == nil:
        return false
      if s == "@r":
        if server.getRandomPlayer != nil:
          let p = server.getRandomPlayer()
          if p != nil:
            players.add(p)
      elif s == "@a" or s == "@e":
        if server.getAllPlayers != nil:
          players = server.getAllPlayers()
      else:
        if server.getPlayerByName == nil:
          return false
        let p = server.getPlayerByName(s)
        if p == nil:
          return false
        players.add(p)
      res = Arg(kind: akPlayers, players: players)
      true,
    consumeWithSyntax: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg;
                            found: var bool): CmdVoidResult {.closure.} =
      var raw = RawArg()
      found = false
      if not popRaw(args, raw):
        return cmdOkVoid()
      var selector = newTargetSelector(estSource)
      let p = parseTargetSelectorWithContext(raw, selector)
      if not p.isOk:
        return p
      let only = ensurePlayerOnlySelector(selector, raw)
      if not only.isOk:
        return only
      res = Arg(kind: akPlayers, players: selectPlayersOf(server, selector, sender))
      found = true
      cmdOkVoid())

# `findMsg` and friends: `FindArg`.
proc findMsg*(args: ConsumedArgs; name: string; res: var string): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akMsg:
    res = a.str
    return true
  false

proc findGameMode*(args: ConsumedArgs; name: string; res: var GameMode): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akGameMode:
    res = a.gameMode
    return true
  false

proc findPlayers*(args: ConsumedArgs; name: string; res: var seq[CommandPlayer]): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akPlayers:
    res = a.players
    return true
  false

# ---- args/bounded_num.rs ------------------------------------------------------------------------------------------

proc fixed2(v: float64): string = formatFloat(v, ffDecimal, 2)

proc `$`*(n: Number): string =
  ## `impl Display for Number`.
  case n.kind
  of nkF64: fixed2(n.f64)
  of nkF32: fixed2(float64(n.f32))
  of nkI32: $n.i32
  of nkI64: $n.i64

proc qualifier*(n: Number): string =
  case n.kind
  of nkF64, nkF32: "Float"
  of nkI32, nkI64: "Integer"

proc notInBoundsError*(a: Arg): CommandResult =
  ## `impl From<NotInBounds> for CommandError`.
  if a.numOverflowLow:
    cmdFailed(text(qualifier(a.num) & " must not be less than " & $a.numBound & ", found " & $a.num))
  else:
    cmdFailed(text(qualifier(a.num) & " must not be more than " & $a.numBound & ", found " & $a.num))

proc numArg(value, bound: Number; low, high0: bool): Arg =
  if high0:
    Arg(kind: akNum, numInBounds: false, numOverflowLow: false, num: value, numBound: bound)
  elif low:
    Arg(kind: akNum, numInBounds: false, numOverflowLow: true, num: value, numBound: bound)
  else:
    Arg(kind: akNum, numInBounds: true, num: value)

proc newBoundedI32*(name: string; minV: Option[int32] = none[int32](); maxV: Option[int32] = none[int32]()): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atInteger, integerMin: minV, integerMax: maxV),
    overrideSuggestion: none[SuggestionProviders](), defaultName: name,
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var v = 0'i64
      if not parseI64Checked(raw.value, int64(int32.low), int64(int32.high), v):
        return false
      let x = int32(v)
      if maxV.isSome and x > maxV.unsafeGet:
        res = numArg(Number(kind: nkI32, i32: x), Number(kind: nkI32, i32: maxV.unsafeGet), false, true)
      elif minV.isSome and x < minV.unsafeGet:
        res = numArg(Number(kind: nkI32, i32: x), Number(kind: nkI32, i32: minV.unsafeGet), true, false)
      else:
        res = numArg(Number(kind: nkI32, i32: x), Number(kind: nkI32, i32: x), false, false)
      true)

proc newBoundedI64*(name: string; minV: Option[int64] = none[int64](); maxV: Option[int64] = none[int64]()): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atLong, longMin: minV, longMax: maxV),
    overrideSuggestion: none[SuggestionProviders](), defaultName: name,
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var x = 0'i64
      if not parseI64Checked(raw.value, int64.low, int64.high, x):
        return false
      if maxV.isSome and x > maxV.unsafeGet:
        res = numArg(Number(kind: nkI64, i64: x), Number(kind: nkI64, i64: maxV.unsafeGet), false, true)
      elif minV.isSome and x < minV.unsafeGet:
        res = numArg(Number(kind: nkI64, i64: x), Number(kind: nkI64, i64: minV.unsafeGet), true, false)
      else:
        res = numArg(Number(kind: nkI64, i64: x), Number(kind: nkI64, i64: x), false, false)
      true)

proc newBoundedF32*(name: string; minV: Option[float32] = none[float32](); maxV: Option[float32] = none[float32]()): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atFloat, floatMin: minV, floatMax: maxV),
    overrideSuggestion: none[SuggestionProviders](), defaultName: name,
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var d = 0.0
      if not parseF64Checked(raw.value, d):
        return false
      let x = float32(d)
      if maxV.isSome and x > maxV.unsafeGet:
        res = numArg(Number(kind: nkF32, f32: x), Number(kind: nkF32, f32: maxV.unsafeGet), false, true)
      elif minV.isSome and x < minV.unsafeGet:
        res = numArg(Number(kind: nkF32, f32: x), Number(kind: nkF32, f32: minV.unsafeGet), true, false)
      else:
        res = numArg(Number(kind: nkF32, f32: x), Number(kind: nkF32, f32: x), false, false)
      true)

proc newBoundedF64*(name: string; minV: Option[float64] = none[float64](); maxV: Option[float64] = none[float64]()): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atDouble, doubleMin: minV, doubleMax: maxV),
    overrideSuggestion: none[SuggestionProviders](), defaultName: name,
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var x = 0.0
      if not parseF64Checked(raw.value, x):
        return false
      if maxV.isSome and x > maxV.unsafeGet:
        res = numArg(Number(kind: nkF64, f64: x), Number(kind: nkF64, f64: maxV.unsafeGet), false, true)
      elif minV.isSome and x < minV.unsafeGet:
        res = numArg(Number(kind: nkF64, f64: x), Number(kind: nkF64, f64: minV.unsafeGet), true, false)
      else:
        res = numArg(Number(kind: nkF64, f64: x), Number(kind: nkF64, f64: x), false, false)
      true)

proc findNum*(args: ConsumedArgs; name: string; res: var Arg): bool =
  ## False for upstream's `Err(InvalidConsumption)`. `res.numInBounds` is the inner `Result`.
  var a = Arg()
  if findArg(args, name, a) and a.kind == akNum:
    res = a
    return true
  false

proc requireI32*(args: ConsumedArgs; name: string; value: var int32): CommandResult =
  ## `find_arg(args, name)??` for an i32.
  var a = Arg()
  if not findNum(args, name, a) or a.num.kind != nkI32:
    return cmdInvalidConsumption(some(name))
  if not a.numInBounds:
    return notInBoundsError(a)
  value = a.num.i32
  cmdSuccess(0'i32)

proc requireI64*(args: ConsumedArgs; name: string; value: var int64): CommandResult =
  var a = Arg()
  if not findNum(args, name, a) or a.num.kind != nkI64:
    return cmdInvalidConsumption(some(name))
  if not a.numInBounds:
    return notInBoundsError(a)
  value = a.num.i64
  cmdSuccess(0'i32)

proc requireF32*(args: ConsumedArgs; name: string; value: var float32): CommandResult =
  var a = Arg()
  if not findNum(args, name, a) or a.num.kind != nkF32:
    return cmdInvalidConsumption(some(name))
  if not a.numInBounds:
    return notInBoundsError(a)
  value = a.num.f32
  cmdSuccess(0'i32)

proc requireF64*(args: ConsumedArgs; name: string; value: var float64): CommandResult =
  var a = Arg()
  if not findNum(args, name, a) or a.num.kind != nkF64:
    return cmdInvalidConsumption(some(name))
  if not a.numInBounds:
    return notInBoundsError(a)
  value = a.num.f64
  cmdSuccess(0'i32)

# ---- Consumers that hold a string ---------------------------------------------------------------------------------

proc stringConsumer(parser: ArgumentType; hint: Option[SuggestionProviders]; kind: ArgKind): ArgumentConsumer =
  ArgumentConsumer(clientParser: parser, overrideSuggestion: hint,
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      res = Arg(kind: kind, str: raw.value)
      true)

proc staticSuggestions(names: seq[string]): seq[CommandSuggestionOut] =
  result = @[]
  for n in names:
    result.add(CommandSuggestionOut(suggestion: n, tooltip: none[TextComponent]()))

proc withSuggestions(c: ArgumentConsumer; names: seq[string]): ArgumentConsumer =
  c.suggestProc = proc(sender: CommandSender; server: nil CommandServer; input: string; res: var seq[CommandSuggestionOut]): bool {.closure.} =
    res = staticSuggestions(names)
    true
  c

proc newBlockArgumentConsumer*(): ArgumentConsumer =
  stringConsumer(ArgumentType(kind: atBlockState), none[SuggestionProviders](), akBlock)

proc newBlockPredicateArgumentConsumer*(): ArgumentConsumer =
  stringConsumer(ArgumentType(kind: atBlockPredicate), none[SuggestionProviders](), akBlockPredicate)

proc newItemArgumentConsumer*(): ArgumentConsumer =
  stringConsumer(ArgumentType(kind: atItemStack), none[SuggestionProviders](), akItem)

proc newItemPredicateArgumentConsumer*(): ArgumentConsumer =
  ## Upstream's consumer stores `Arg::Item`, not `Arg::ItemPredicate`.
  stringConsumer(ArgumentType(kind: atItemPredicate), none[SuggestionProviders](), akItem)

proc newResourceLocationArgumentConsumer*(): ArgumentConsumer =
  stringConsumer(ArgumentType(kind: atResourceLocation), some(spAskServer), akResourceLocation)

proc newSoundArgumentConsumer*(): ArgumentConsumer =
  ## Upstream's `Arg::Block` holds the name here too.
  stringConsumer(ArgumentType(kind: atResourceLocation), some(spAvailableSounds), akBlock)

proc newSummonableEntitiesArgumentConsumer*(): ArgumentConsumer =
  stringConsumer(ArgumentType(kind: atResourceLocation), some(spSummonableEntities), akBlock)

proc stripMinecraft(s: string): string =
  if s.startsWith("minecraft:"): s[10 ..< s.len] else: s

proc oneOfConsumer(names: seq[string]; kind: ArgKind): ArgumentConsumer =
  result = ArgumentConsumer(clientParser: ArgumentType(kind: atResourceLocation), overrideSuggestion: some(spAskServer),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      if raw.value notin names:
        return false
      res = Arg(kind: kind, str: raw.value)
      true)
  result = withSuggestions(result, names)

proc newBossbarColorArgumentConsumer*(): ArgumentConsumer =
  oneOfConsumer(@["blue", "green", "pink", "purple", "red", "white", "yellow"], akBossbarColor)

proc newBossbarStyleArgumentConsumer*(): ArgumentConsumer =
  oneOfConsumer(@["notched_10", "notched_12", "notched_20", "notched_6", "progress"], akBossbarStyle)

proc newSoundCategoryArgumentConsumer*(): ArgumentConsumer =
  result = ArgumentConsumer(clientParser: ArgumentType(kind: atResourceLocation), overrideSuggestion: some(spAskServer),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let lowered = toLowerAscii(raw.value)
      if lowered notin ["master", "music", "record", "weather", "block", "hostile", "neutral", "player", "ambient", "voice"]:
        return false
      res = Arg(kind: akSoundCategory, str: lowered)
      true)
  result = withSuggestions(result, @["master", "music", "record", "weather", "block", "hostile", "neutral", "player", "ambient", "voice"])

proc newDifficultyArgumentConsumer*(): ArgumentConsumer =
  result = ArgumentConsumer(clientParser: ArgumentType(kind: atString, behavior: spSingleWord), overrideSuggestion: some(spAskServer),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let (ok, d) = parseDifficulty(raw.value)
      if not ok:
        return false
      res = Arg(kind: akDifficulty, difficulty: d)
      true)
  result = withSuggestions(result, @["easy", "normal", "hard", "peaceful"])

proc newEntityAnchorArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atEntityAnchor), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var anchor = eaFeet
      if not entityAnchorFromId(toLowerAscii(raw.value), anchor):
        return false
      res = Arg(kind: akEntityAnchor, anchor: anchor)
      true)

proc resourceType(name: string): ArgumentType =
  ArgumentType(kind: atResource, identifier: vanillaStatic(name))

proc newDamageTypeArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: resourceType("damage_type"), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let n = stripMinecraft(raw.value)
      let (ok, _) = damageTypeFromName(n)
      if not ok:
        return false
      res = Arg(kind: akDamageType, str: n)
      true)

proc newEffectTypeArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: resourceType("mob_effect"), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
