proc newSlotArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atItemSlot), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let (ok, range0) = getSlotRange(raw.value)
      if not ok or range0.len != 1:
        return false
      res = Arg(kind: akSlot, slot: range0[0], str: raw.value)
      true)

proc newSlotsArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atItemSlots), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let (ok, range0) = getSlotRange(raw.value)
      if not ok:
        return false
      res = Arg(kind: akSlots, slots: range0, str: raw.value)
      true)

proc newTextComponentArgConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atComponent), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      let s = raw.value
      let parsed = tb.fromJsonString(TextComponent, s)
      if parsed.ok:
        res = Arg(kind: akTextComponent, textComponent: parsed.value)
        return true
      if s.len >= 1 and s[0] == '"' and s[s.len - 1] == '"':
        res = Arg(kind: akTextComponent, textComponent: text(replace(s, "\"", "")))
        return true
      false)

# ---- args/coordinate.rs and the position consumers ----------------------------------------------------------------

proc parseMaybeRelativeCoordinate(s: string; isY: bool; relative: var bool; value: var float64): bool =
  if s.startsWith("~"):
    relative = true
    let rest = s[1 ..< s.len]
    if rest.len == 0:
      value = 0.0
      return true
    return parseF64Checked(rest, value)
  relative = false
  if not parseF64Checked(s, value):
    return false
  if not isY and '.' notin s:
    value += 0.5
  true

proc absoluteCoordinate(relative: bool; value: float64; hasOrigin: bool; origin: float64; res: var float64): bool =
  ## `into_absolute`.
  if not relative:
    res = value
    return true
  if not hasOrigin:
    return false
  res = origin + value
  true

proc newPosition2DArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atVec2), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var xs = RawArg()
      var zs = RawArg()
      let hasX = popRaw(args, xs)
      let hasZ = popRaw(args, zs)
      if not hasX or not hasZ:
        return false
      var xr = false
      var zr = false
      var x = 0.0
      var z = 0.0
      if not parseMaybeRelativeCoordinate(xs.value, false, xr, x) or not parseMaybeRelativeCoordinate(zs.value, false, zr, z):
        return false
      var origin = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
      let hasOrigin = position(sender, origin)
      var ax = 0.0
      var az = 0.0
      if not absoluteCoordinate(xr, x, hasOrigin, origin.x, ax) or not absoluteCoordinate(zr, z, hasOrigin, origin.z, az):
        return false
      res = Arg(kind: akPos2D, pos2D: Vector2[float64](x: ax, y: az))
      true)

proc newPosition3DArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atVec3), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var xs = RawArg()
      var ys = RawArg()
      var zs = RawArg()
      let hasX = popRaw(args, xs)
      let hasY = popRaw(args, ys)
      let hasZ = popRaw(args, zs)
      if not hasX or not hasY or not hasZ:
        return false
      var xr = false
      var yr = false
      var zr = false
      var x = 0.0
      var y = 0.0
      var z = 0.0
      if not parseMaybeRelativeCoordinate(xs.value, false, xr, x) or not parseMaybeRelativeCoordinate(ys.value, true, yr, y) or
          not parseMaybeRelativeCoordinate(zs.value, false, zr, z):
        return false
      var origin = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
      let hasOrigin = position(sender, origin)
      var ax = 0.0
      var ay = 0.0
      var az = 0.0
      if not absoluteCoordinate(xr, x, hasOrigin, origin.x, ax) or not absoluteCoordinate(yr, y, hasOrigin, origin.y, ay) or
          not absoluteCoordinate(zr, z, hasOrigin, origin.z, az):
        return false
      res = Arg(kind: akPos3D, pos3D: Vector3[float64](x: ax, y: ay, z: az))
      true)

proc parseBlockCoordinate(s: string; relative: var bool; absolute: var int32; offset: var float64): bool =
  if s.startsWith("~"):
    relative = true
    let rest = s[1 ..< s.len]
    if rest.len == 0:
      offset = 0.0
      return true
    return parseF64Checked(rest, offset)
  relative = false
  var v = 0'i64
  if not parseI64Checked(s, int64(int32.low), int64(int32.high), v):
    return false
  absolute = int32(v)
  true

proc blockCoordinateAbsolute(relative: bool; absolute: int32; offset: float64; hasOrigin: bool; origin: float64; res: var int32): bool =
  if not relative:
    res = absolute
    return true
  if not hasOrigin:
    return false
  res = int32(floor(origin + offset))
  true

proc parseLocalCoordinate(s: string; value: var float64): bool =
  if not s.startsWith("^"):
    return false
  let rest = s[1 ..< s.len]
  if rest.len == 0:
    value = 0.0
    return true
  parseF64Checked(rest, value)

proc applyLocalCoordinates(yaw, pitch: float64; left, up0, forward: float64): Vector3[float64] =
  let yCos = cos(degToRad(yaw + 90.0))
  let ySin = sin(degToRad(yaw + 90.0))
  let xCos = cos(degToRad(-pitch))
  let xSin = sin(degToRad(-pitch))
  let xCosUp = cos(degToRad(-pitch + 90.0))
  let xSinUp = sin(degToRad(-pitch + 90.0))
  let f = Vector3[float64](x: yCos * xCos, y: xSin, z: ySin * xCos)
  let u = Vector3[float64](x: yCos * xCosUp, y: xSinUp, z: ySin * xCosUp)
  let l = Vector3[float64](x: (f.y * u.z - f.z * u.y) * -1.0, y: (f.z * u.x - f.x * u.z) * -1.0, z: (f.x * u.y - f.y * u.x) * -1.0)
  Vector3[float64](x: f.x * forward + u.x * up0 + l.x * left, y: f.y * forward + u.y * up0 + l.y * left,
    z: f.z * forward + u.z * up0 + l.z * left)

proc newBlockPosArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atBlockPos), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var xs = RawArg()
      var ys = RawArg()
      var zs = RawArg()
      let hasX = popRaw(args, xs)
      let hasY = popRaw(args, ys)
      let hasZ = popRaw(args, zs)
      if not hasX or not hasY or not hasZ:
        return false
      var origin = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
      let hasOrigin = position(sender, origin)
      if xs.value.startsWith("^") or ys.value.startsWith("^") or zs.value.startsWith("^"):
        var l = 0.0
        var u = 0.0
        var f = 0.0
        if not parseLocalCoordinate(xs.value, l) or not parseLocalCoordinate(ys.value, u) or not parseLocalCoordinate(zs.value, f):
          return false
        if not hasOrigin or sender.kind != cskPlayer:
          # Only a player has `rotation()` here without a block lookup; a command block's goes through its hook.
          if not hasOrigin:
            return false
        var yaw = 0.0
        var pitch = 0.0
        if sender.kind == cskPlayer:
          let rot = sender.player.entity.getRotation()
          pitch = float64(rot.x)
          yaw = float64(rot.y)
        elif sender.kind == cskCommandBlock:
          let ry = sender.commandBlock.getRotationY()
          if ry.isNone:
            return false
          yaw = float64(ry.unsafeGet)
        let offset = applyLocalCoordinates(yaw, pitch, l, u, f)
        res = Arg(kind: akBlockPos, blockPos: BlockPos(vec: Vector3[int32](x: int32(floor(origin.x + offset.x)),
          y: int32(floor(origin.y + offset.y)), z: int32(floor(origin.z + offset.z)))))
        return true
      var xr = false
      var yr = false
      var zr = false
      var xa = 0'i32
      var ya = 0'i32
      var za = 0'i32
      var xo = 0.0
      var yo = 0.0
      var zo = 0.0
      if not parseBlockCoordinate(xs.value, xr, xa, xo) or not parseBlockCoordinate(ys.value, yr, ya, yo) or
          not parseBlockCoordinate(zs.value, zr, za, zo):
        return false
      var ax = 0'i32
      var ay = 0'i32
      var az = 0'i32
      if not blockCoordinateAbsolute(xr, xa, xo, hasOrigin, origin.x, ax) or not blockCoordinateAbsolute(yr, ya, yo, hasOrigin, origin.y, ay) or
          not blockCoordinateAbsolute(zr, za, zo, hasOrigin, origin.z, az):
        return false
      res = Arg(kind: akBlockPos, blockPos: BlockPos(vec: Vector3[int32](x: ax, y: ay, z: az)))
      true)

proc parseRotationComponent(s: string; value: var float32; relative: var bool): bool =
  if s.startsWith("~"):
    let rest = s[1 ..< s.len]
    relative = true
    if rest.len == 0:
      value = 0.0'f32
      return true
    var d = 0.0
    if not parseF64Checked(rest, d):
      return false
    value = float32(d)
    return true
  var d = 0.0
  if not parseF64Checked(s, d):
    return false
  relative = false
  var v = float32(d)
  v = v - 360.0'f32 * trunc(v / 360.0'f32)
  if v >= 180.0'f32:
    v -= 360.0'f32
  value = v
  true

proc newRotationArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atRotation), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var ys = RawArg()
      var ps = RawArg()
      let hasY = popRaw(args, ys)
      let hasP = popRaw(args, ps)
      if not hasY or not hasP:
        return false
      var yaw = 0.0'f32
      var pitch = 0.0'f32
      var yr = false
      var pr = false
      if not parseRotationComponent(ys.value, yaw, yr) or not parseRotationComponent(ps.value, pitch, pr):
        return false
      res = Arg(kind: akRotation, yaw: yaw, yawRelative: yr, pitch: pitch, pitchRelative: pr)
      true)

proc findBlockPos*(args: ConsumedArgs; name: string; res: var BlockPos): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akBlockPos:
    res = a.blockPos
    return true
  false

proc findLoadedBlockPos*(args: ConsumedArgs; name: string; world: CommandWorld; res: var BlockPos): CommandResult =
  ## `BlockPosArgumentConsumer::find_loaded_arg`.
  if not findBlockPos(args, name, res):
    return cmdInvalidConsumption(some(name))
  let p = res.vec
  if world.isChunkLoaded != nil and not world.isChunkLoaded(floorDiv(p.x, 16'i32), floorDiv(p.z, 16'i32)):
    return cmdFailed(translateCross("argument.pos.unloaded", "argument.pos.unloaded"))
  if world.isInBuildLimit != nil and not world.isInBuildLimit(p.x, p.y, p.z):
    return cmdFailed(translateCross("argument.pos.outofworld", "argument.pos.outofworld"))
  cmdSuccess(0'i32)

proc findPos3D*(args: ConsumedArgs; name: string; res: var Vector3[float64]): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akPos3D:
    res = a.pos3D
    return true
  false

proc findPos2D*(args: ConsumedArgs; name: string; res: var Vector2[float64]): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akPos2D:
    res = a.pos2D
    return true
  false

proc findRotation*(args: ConsumedArgs; name: string; res: var Arg): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akRotation:
    res = a
    return true
  false

proc findString*(args: ConsumedArgs; name: string; kind: ArgKind; res: var string): bool =
  ## `Arg::Simple`, `Arg::Block`, `Arg::Item`, `Arg::Effect`, and the others holding a name.
  var a = Arg()
  if findArg(args, name, a) and a.kind == kind:
    res = a.str
    return true
  false

proc findBool*(args: ConsumedArgs; name: string; res: var bool): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akBool:
    res = a.boolean
    return true
  false

proc findText*(args: ConsumedArgs; name: string; res: var TextComponent): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akTextComponent:
    res = a.textComponent
    return true
