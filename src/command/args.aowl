proc findEntities*(args: ConsumedArgs; name: string; res: var seq[CommandEntity]): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akEntities:
    res = a.entities
    return true
  false

proc findEntity*(args: ConsumedArgs; name: string; res: var seq[CommandEntity]): bool =
  ## `Arg::Entity`; the entity is `res[0]`.
  var a = Arg()
  if findArg(args, name, a) and a.kind == akEntity:
    res = a.entities
    return true
  false

proc findGameProfiles*(args: ConsumedArgs; name: string; res: var seq[CmdGameProfile]): bool =
  var a = Arg()
  if findArg(args, name, a) and a.kind == akGameProfiles:
    res = a.gameProfiles
