# ---- args/entity.rs -----------------------------------------------------------------------------------------------

proc newEntityArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atEntity, flags: EntityFlagOnlySingle),
    overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      var selector = newTargetSelector(estSource)
      var err = TargetSelectorParseError()
      if not parseTargetSelector(raw.value, selector, err) or getLimit(selector) > 1'u64:
        return false
      let list = selectEntitiesOf(server, selector, sender)
      if list.len == 0:
        return false
      res = Arg(kind: akEntity, entities: @[list[0]])
      true,
    consumeWithSyntax: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg;
                            found: var bool): CmdVoidResult {.closure.} =
      var raw = RawArg()
      found = false
      if not popRaw(args, raw):
        return cmdOkVoid()
      var selector = newTargetSelector(estSource)
      let p = parseTargetSelectorWithContext(raw, selector)
      if not p.isOk:
        return p
      if getLimit(selector) > 1'u64:
        return cmdOkVoid()
      let list = selectEntitiesOf(server, selector, sender)
      if list.len > 0:
        res = Arg(kind: akEntity, entities: @[list[0]])
        found = true
      cmdOkVoid())

# ---- args/gameprofile.rs ------------------------------------------------------------------------------------------

type
  GameProfileSuggestionMode* = enum
    gpsOnlinePlayers
    gpsNonOpOnlinePlayers
    gpsOpNames
    gpsBannedNames
    gpsNonWhitelistedOnlinePlayers
    gpsWhitelistedNames

proc syntaxPlayerUnknown*(raw: RawArg): CommandSyntaxError =
  syntaxErrorForArgWithCursor(raw, translateCross(JAVA_ARGUMENT_PLAYER_UNKNOWN, JAVA_ARGUMENT_PLAYER_UNKNOWN), 0)

proc findEntryByName(list: seq[CmdListEntry]; name: string; res: var CmdGameProfile): bool =
  let lower = toLowerAscii(name)
  for e in list:
    if toLowerAscii(e.name) == lower:
      res = CmdGameProfile(id: e.id, name: e.name)
      return true
  false

proc findEntryById(list: seq[CmdListEntry]; id: Uuid; res: var CmdGameProfile): bool =
  for e in list:
    if e.id == id:
      res = CmdGameProfile(id: e.id, name: e.name)
      return true
  false

proc resolveKnownProfileByName*(server: CommandServer; name: string; res: var CmdGameProfile): bool =
  if server.getOps != nil and findEntryByName(server.getOps(), name, res):
    return true
  if server.getBannedPlayers != nil and findEntryByName(server.getBannedPlayers(), name, res):
    return true
  server.getWhitelist != nil and findEntryByName(server.getWhitelist(), name, res)

proc resolveKnownProfileByUuid*(server: CommandServer; id: Uuid; res: var CmdGameProfile): bool =
  if server.getOps != nil and findEntryById(server.getOps(), id, res):
    return true
  if server.getBannedPlayers != nil and findEntryById(server.getBannedPlayers(), id, res):
    return true
  server.getWhitelist != nil and findEntryById(server.getWhitelist(), id, res)

proc resolveProfilesFromToken(sender: CommandSender; server: CommandServer; raw: RawArg; res: var seq[CmdGameProfile]): CmdVoidResult =
  if raw.value.startsWith("@"):
    var selector = newTargetSelector(estSource)
    let p = parseTargetSelectorWithContext(raw, selector)
    if not p.isOk:
      return p
    let only = ensurePlayerOnlySelector(selector, raw)
    if not only.isOk:
      return only
    let players = selectPlayersOf(server, selector, sender)
    if players.len == 0:
      return cmdFailVoid(syntaxPlayerUnknown(raw))
    res = @[]
    for player in players:
      res.add(player.gameProfile)
    return cmdOkVoid()
  var profile = CmdGameProfile()
  let (isUuid, id) = parseStr(raw.value)
  if isUuid:
    if server.getPlayerByUuid != nil:
      let player = server.getPlayerByUuid(id)
      if player != nil:
        res = @[player.gameProfile]
        return cmdOkVoid()
    if server.userCacheGetByUuid != nil and server.userCacheGetByUuid(id, profile):
      res = @[profile]
      return cmdOkVoid()
    if resolveKnownProfileByUuid(server, id, profile):
      res = @[profile]
      return cmdOkVoid()
    return cmdFailVoid(syntaxPlayerUnknown(raw))
  if server.getPlayerByName != nil:
    let player = server.getPlayerByName(raw.value)
    if player != nil:
      res = @[player.gameProfile]
      return cmdOkVoid()
  if server.userCacheGetByName != nil and server.userCacheGetByName(raw.value, profile):
    res = @[profile]
    return cmdOkVoid()
  if resolveKnownProfileByName(server, raw.value, profile):
    res = @[profile]
    return cmdOkVoid()
  if server.onlineMode != nil and server.onlineMode():
    if server.lookupProfileByName != nil and server.lookupProfileByName(raw.value, profile):
      if server.userCacheUpsert != nil:
        server.userCacheUpsert(profile.id, profile.name)
      res = @[profile]
      return cmdOkVoid()
    return cmdFailVoid(syntaxPlayerUnknown(raw))
  var offline = Uuid()
  if server.offlineUuid != nil and server.offlineUuid(raw.value, offline):
    if server.userCacheUpsert != nil:
      server.userCacheUpsert(offline, raw.value)
    res = @[CmdGameProfile(id: offline, name: raw.value)]
    return cmdOkVoid()
  cmdFailVoid(syntaxPlayerUnknown(raw))

proc pushNameIfMissing(names: var seq[string]; name: string) =
  let lower = toLowerAscii(name)
  for n in names:
    if toLowerAscii(n) == lower:
      return
  names.add(name)

proc newGameProfilesArgumentConsumer*(mode: GameProfileSuggestionMode; suggestSelectors: bool): ArgumentConsumer =
  ArgumentConsumer(clientParser: ArgumentType(kind: atGameProfile), overrideSuggestion: some(spAskServer),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      if server == nil:
        return false
      var list: seq[CmdGameProfile] = @[]
      if not resolveProfilesFromToken(sender, server, raw, list).isOk:
        return false
      res = Arg(kind: akGameProfiles, gameProfiles: list)
      true,
    consumeWithSyntax: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg;
                            found: var bool): CmdVoidResult {.closure.} =
      var raw = RawArg()
      found = false
      if not popRaw(args, raw):
        return cmdOkVoid()
      if server == nil:
        return cmdOkVoid()
      var list: seq[CmdGameProfile] = @[]
      let r = resolveProfilesFromToken(sender, server, raw, list)
      if not r.isOk:
        return r
      res = Arg(kind: akGameProfiles, gameProfiles: list)
      found = true
      cmdOkVoid(),
    suggestProc: proc(sender: CommandSender; server: nil CommandServer; input: string; res: var seq[CommandSuggestionOut]): bool {.closure.} =
      if server == nil:
        return false
      var suggestions: seq[CommandSuggestionOut] = @[]
      if suggestSelectors:
        suggestions = staticSuggestions(@["@s", "@p", "@r", "@a", "@e", "@n"])
      var names: seq[string] = @[]
      var players: seq[CommandPlayer] = @[]
      if server.getAllPlayers != nil:
        players = server.getAllPlayers()
      case mode
      of gpsOnlinePlayers:
        for player in players:
          pushNameIfMissing(names, player.gameProfile.name)
      of gpsNonOpOnlinePlayers:
        var ops: seq[CmdListEntry] = @[]
        if server.getOps != nil:
          ops = server.getOps()
        for player in players:
          var isOp = false
          for op in ops:
            if op.id == player.gameProfile.id:
              isOp = true
          if not isOp:
            pushNameIfMissing(names, player.gameProfile.name)
      of gpsOpNames:
        if server.getOps != nil:
          let list = server.getOps()
          for op in list:
            pushNameIfMissing(names, op.name)
      of gpsBannedNames:
        if server.getBannedPlayers != nil:
          let list = server.getBannedPlayers()
          for entry in list:
            pushNameIfMissing(names, entry.name)
      of gpsNonWhitelistedOnlinePlayers:
        for player in players:
          if server.isWhitelisted == nil or not server.isWhitelisted(player.gameProfile):
            pushNameIfMissing(names, player.gameProfile.name)
      of gpsWhitelistedNames:
        if server.getWhitelist != nil:
          let list = server.getWhitelist()
          for entry in list:
            pushNameIfMissing(names, entry.name)
      for s in staticSuggestions(names):
        suggestions.add(s)
      res = suggestions
      true)
