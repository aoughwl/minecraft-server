proc newEnchantmentArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: resourceType("enchantment"), overrideSuggestion: none[SuggestionProviders](),
    defaultName: "enchantment",
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
      var raw = RawArg()
      if not popRaw(args, raw):
        return false
      # Upstream does not strip the namespace here.
      if fromName(Enchantment, raw.value).isNone:
        return false
      res = Arg(kind: akEnchantment, str: raw.value)
      true)

proc newParticleArgumentConsumer*(): ArgumentConsumer =
  ArgumentConsumer(clientParser: resourceType("particle_type"), overrideSuggestion: none[SuggestionProviders](),
    consume: proc(sender: CommandSender; server: nil CommandServer; args: var RawArgs; res: var Arg): bool {.closure.} =
