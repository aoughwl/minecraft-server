## The brigadier leaf argument types.
## Port of pumpkin/src/command/argument_types/core/mod.rs
## Port of pumpkin/src/command/argument_types/core/bool.rs
## Port of pumpkin/src/command/argument_types/core/integer.rs
## Port of pumpkin/src/command/argument_types/core/long.rs
## Port of pumpkin/src/command/argument_types/core/float.rs
## Port of pumpkin/src/command/argument_types/core/double.rs
## Port of pumpkin/src/command/argument_types/core/string.rs
##
## Upstream's constructors are `any()`, `with_min`, `with_max` and `new`; the defaults on the one `newXArgumentType`
## cover all four. As upstream's do, the wire form sends a bound only if it differs from the type's own limit.

import std/options
import ../protocol/java/client/play/commands
import ../util/text/textbase, ../util/text/text
import cmderrors, string_reader, cmdtree

const
  F32Max = 3.4028234663852886e38'f32 ## `f32::MAX`.
  F64Max = 1.7976931348623157e308    ## `f64::MAX`.

proc newBoolArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atBool), overrideSuggestion: none[SuggestionProviders](),
    examples: @["true", "false"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let v = readBool(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      cmdOk[ArgValue](boxBool(v.value)))

proc newIntegerArgumentType*(min: int32 = int32.low; max: int32 = int32.high): AnyArgumentType =
  AnyArgumentType(
    clientParser: JavaClientArgumentType(kind: atInteger,
      integerMin: (if min != int32.low: some(min) else: none[int32]()),
      integerMax: (if max != int32.high: some(max) else: none[int32]())),
    overrideSuggestion: none[SuggestionProviders](), examples: @["0", "123", "-123"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let start = cursor(r)
      let v = readInt(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      if v.value < min:
        setCursor(r, start)
        return cmdFail[ArgValue](create(integerTooLow(), r, text($min), text($v.value)))
      if v.value > max:
        setCursor(r, start)
        return cmdFail[ArgValue](create(integerTooHigh(), r, text($max), text($v.value)))
      cmdOk[ArgValue](boxInt(v.value)))

