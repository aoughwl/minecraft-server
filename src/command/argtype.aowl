    overrideSuggestion: none[SuggestionProviders](), examples: @["0", "123", "-123"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let start = cursor(r)
      let v = readLong(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      if v.value < min:
        setCursor(r, start)
        return cmdFail[ArgValue](create(longTooLow(), r, text($min), text($v.value)))
      if v.value > max:
        setCursor(r, start)
        return cmdFail[ArgValue](create(longTooHigh(), r, text($max), text($v.value)))
      cmdOk[ArgValue](boxLong(v.value)))

proc newFloatArgumentType*(min: float32 = -F32Max; max: float32 = F32Max): AnyArgumentType =
  AnyArgumentType(
    clientParser: JavaClientArgumentType(kind: atFloat,
      floatMin: (if min != -F32Max: some(min) else: none[float32]()),
      floatMax: (if max != F32Max: some(max) else: none[float32]())),
    overrideSuggestion: none[SuggestionProviders](), examples: @["0", "1.2", ".5", "-1", "-.5", "-1234.56"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let start = cursor(r)
      let v = readFloat(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      if v.value < min:
        setCursor(r, start)
        return cmdFail[ArgValue](create(floatTooLow(), r, text($min), text($v.value)))
      if v.value > max:
        setCursor(r, start)
        return cmdFail[ArgValue](create(floatTooHigh(), r, text($max), text($v.value)))
      cmdOk[ArgValue](boxFloat(v.value)))

proc newDoubleArgumentType*(min: float64 = -F64Max; max: float64 = F64Max): AnyArgumentType =
  AnyArgumentType(
    clientParser: JavaClientArgumentType(kind: atDouble,
      doubleMin: (if min != -F64Max: some(min) else: none[float64]()),
      doubleMax: (if max != F64Max: some(max) else: none[float64]())),
    overrideSuggestion: none[SuggestionProviders](), examples: @["0", "1.2", ".5", "-1", "-.5", "-1234.56"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let start = cursor(r)
      let v = readDouble(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      if v.value < min:
        setCursor(r, start)
        return cmdFail[ArgValue](create(doubleTooLow(), r, text($min), text($v.value)))
      if v.value > max:
        setCursor(r, start)
        return cmdFail[ArgValue](create(doubleTooHigh(), r, text($max), text($v.value)))
      cmdOk[ArgValue](boxDouble(v.value)))

proc newStringArgumentType*(behavior: StringProtoArgBehavior): AnyArgumentType =
  ## `StringArgumentType::{SingleWord, QuotablePhrase, GreedyPhrase}`.
  let ex =
    case behavior
    of spSingleWord: @["word", "words_with_underscores"]
    of spQuotablePhrase: @["\"quoted phrase\"", "word", "\"\""]
    of spGreedyPhrase: @["word", "words with spaces", "\"and symbols\""]
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atString, behavior: behavior),
    overrideSuggestion: none[SuggestionProviders](), examples: ex,
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      case behavior
      of spSingleWord:
        cmdOk[ArgValue](boxString(readUnquotedString(r)))
      of spQuotablePhrase:
        let v = readString(r)
        if not v.isOk:
          return cmdFail[ArgValue](v.error)
        cmdOk[ArgValue](boxString(v.value))
      of spGreedyPhrase:
        let t = remainingPart(r)
        setCursor(r, totalLength(r))
        cmdOk[ArgValue](boxString(t)))
