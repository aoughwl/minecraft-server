## The fluent builder that assembles a detached node.
## Port of pumpkin/src/command/argument_builder.rs
##
## `LiteralArgumentBuilder`, `CommandArgumentBuilder` and `RequiredArgumentBuilder` are one type, told apart by the
## node kind, so `then` takes any of them where upstream takes `impl Into<DetachedNode>`. Upstream's builders move;
## these are refs that return themselves, so the chains read the same.
## The `assert!`s are kept; the `*Problem` procs hand their message to the tests, since a test cannot catch an assert.

import std/[assertions, strutils]
import cmdtree

type
  ArgumentBuilder* = ref object
    node*: DetachedNode

proc newBuilder(kind: NodeKind): ArgumentBuilder =
  ArgumentBuilder(node: DetachedNode(kind: kind, globalId: newGlobalNodeId(), requirements: @[],
    modifier: keepSource(), forks: false, children: @[], hasRedirect: false, argumentType: nil))

proc command*(literal, description: string): ArgumentBuilder =
  result = newBuilder(nkCommand)
  result.node.literal = literal
  result.node.literalLowercase = toLowerAscii(literal)
  result.node.description = description

proc literal*(literal: string): ArgumentBuilder =
  result = newBuilder(nkLiteral)
  result.node.literal = literal
  result.node.literalLowercase = toLowerAscii(literal)

proc argument*(name: string; argType: AnyArgumentType): ArgumentBuilder =
  result = newBuilder(nkArgument)
  result.node.name = name
  result.node.argumentType = argType

proc suggests*(b: ArgumentBuilder; provider: SuggestionProvider): ArgumentBuilder =
  b.node.suggestionProvider = provider
  b

proc thenProblem*(b, child: ArgumentBuilder): string =
  if b.node.hasRedirect:
    "Cannot add children to a redirected node"
  elif child.node.kind == nkCommand:
    "Cannot add a CommandDetachedNode as a child of a builder"
  else:
    ""

proc forwardProblem*(b: ArgumentBuilder): string =
  if b.node.children.len > 0:
    "Cannot forward a node with children. The node must have no children to redirect somewhere else"
  else:
    ""

proc detachedName(n: DetachedNode): string =
  if n.kind == nkArgument: n.name else: n.literal

proc then*(b, child: ArgumentBuilder): ArgumentBuilder =
  let problem = thenProblem(b, child)
  assert problem.len == 0, problem
  # `FxHashMap::insert`: a repeated name replaces the earlier child.
  let name = detachedName(child.node)
  var i = 0
  while i < b.node.children.len:
    if detachedName(b.node.children[i]) == name:
      b.node.children[i] = child.node
      return b
    inc i
  b.node.children.add(child.node)
  b

proc executes*(b: ArgumentBuilder; command: CommandExecutor): ArgumentBuilder =
  ## `executes` and `executes_arc`.
  b.node.command = command
  b

proc requires*(b: ArgumentBuilder; requirement: Requirement): ArgumentBuilder =
  b.node.requirements.add(requirement)
  b

proc requires*(b: ArgumentBuilder; permission: string): ArgumentBuilder =
  requires(b, permissionRequirement(permission))

proc overwriteRequirements*(b: ArgumentBuilder; requirements: seq[Requirement]): ArgumentBuilder =
  b.node.requirements = requirements
  b

proc forward*(b: ArgumentBuilder; redirection: Redirection; modifier: RedirectModifier; fork: bool): ArgumentBuilder =
  let problem = forwardProblem(b)
  assert problem.len == 0, problem
  b.node.hasRedirect = true
  b.node.redirect = redirection
  b.node.modifier = modifier
  b.node.forks = fork
  b

proc redirect*(b: ArgumentBuilder; redirection: Redirection): ArgumentBuilder =
  forward(b, redirection, keepSource(), false)

proc redirectWithModifier*(b: ArgumentBuilder; redirection: Redirection; modifier: RedirectModifier): ArgumentBuilder =
  forward(b, redirection, modifier, false)

proc fork*(b: ArgumentBuilder; redirection: Redirection; modifier: RedirectModifier): ArgumentBuilder =
  forward(b, redirection, modifier, true)

proc id*(b: ArgumentBuilder): GlobalNodeId =
  b.node.globalId

proc build*(b: ArgumentBuilder): DetachedNode =
  b.node
