## The brigadier argument types beyond the leaf ones of argtype.aowl and the coordinates.
## Port of pumpkin/src/command/argument_types/time.rs
## Port of pumpkin/src/command/argument_types/resource_key.rs
## Port of pumpkin/src/command/argument_types/hex_color.rs
## Port of pumpkin/src/command/argument_types/entity_anchor.rs
## Port of pumpkin/src/command/argument_types/slot.rs
## Port of pumpkin/src/command/argument_types/nbt.rs
## Port of pumpkin/src/command/argument_types/team_color.rs
## Port of pumpkin/src/command/argument_types/attribute.rs
## Port of pumpkin/src/command/argument_types/block.rs
## Port of pumpkin/src/command/argument_types/dialog.rs
## Port of pumpkin/src/command/argument_types/gamemode.rs
## Port of pumpkin/src/command/argument_types/team.rs
## Port of pumpkin/src/command/argument_types/objective.rs
## Port of pumpkin/src/command/argument_types/placed_feature.rs
## Port of pumpkin/src/command/argument_types/structure.rs
## Port of pumpkin/src/command/argument_types/uuid.rs
## Port of pumpkin/src/command/argument_types/template.rs
## Port of pumpkin/src/command/argument_types/pool.rs
## Port of pumpkin/src/command/argument_types/identifier.rs
## `get_advancement` and the advancement suggestions read `Advancement::get_identifier_list`, the generated table the manager lists.
##
## Template and pool names come from src/world, which this module should not pull into every command, so those two
## constructors take the list: pass `allTemplateNames()` and `allPoolNames()`
## (src/world/generation/structure/template/cache.aowl).

import ../util/closureset
import std/[math, options, strutils]
import ../generated/advancement as advgen
import ../generated/[attributes, biome, blockdata, placed_feature, slot_ranges, structures, translation]
import ../nbt/tag
import ../protocol/java/client/play/commands
import ../util/[gamemode, identifier, uuid]
import ../util/text/[color, textbase, text]
import cmderrors, cmdsource, cmdtree, fallbackdispatch, snbt, string_reader, suggestion

type
  ResourceKeyValue* = ref object of ArgValue
    registry*: Identifier
    identifier*: Identifier

  RgbValue* = ref object of ArgValue
    value*: RGBColor

  AnchorValue* = ref object of ArgValue
    value*: EntityAnchor

  NbtValue* = ref object of ArgValue
    value*: NbtTag

  ColorValue* = ref object of ArgValue
    value*: NamedColor

  AttributeValue* = ref object of ArgValue
    value*: Attribute

  BlockValue* = ref object of ArgValue
    value*: Block

  GameModeValue* = ref object of ArgValue
    value*: GameMode

  UuidValue* = ref object of ArgValue
    value*: Uuid

  IdentifierValue* = ref object of ArgValue
    value*: Identifier

  DialogArg* = object
    ## `DialogArg`: `Nbt(NbtCompound)` or `Id(Identifier)`.
    isNbt*: bool
    nbt*: NbtTag
    id*: Identifier

  DialogValue* = ref object of ArgValue
    value*: DialogArg

proc invalidUnitError*(): CommandErrorType = errorType0(JAVA_ARGUMENT_TIME_INVALID_UNIT, JAVA_ARGUMENT_TIME_INVALID_UNIT)
proc tickCountTooLowError*(): CommandErrorType = errorType2(JAVA_ARGUMENT_TIME_TICK_COUNT_TOO_LOW, JAVA_ARGUMENT_TIME_TICK_COUNT_TOO_LOW)
proc invalidHexError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_HEXCOLOR_INVALID, JAVA_ARGUMENT_HEXCOLOR_INVALID)
proc invalidAnchorError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ANCHOR_INVALID, JAVA_ARGUMENT_ANCHOR_INVALID)
proc unknownSlotError*(): CommandErrorType = errorType1(JAVA_SLOT_UNKNOWN, JAVA_SLOT_UNKNOWN)
proc onlySingleSlotError*(): CommandErrorType = errorType1(JAVA_SLOT_ONLY_SINGLE_ALLOWED, JAVA_SLOT_ONLY_SINGLE_ALLOWED)
proc invalidColorError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_COLOR_INVALID, JAVA_ARGUMENT_COLOR_INVALID)
proc invalidAttributeError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ID_INVALID, JAVA_ARGUMENT_ID_INVALID)
proc invalidBlockError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_BLOCK_ID_INVALID, JAVA_ARGUMENT_BLOCK_ID_INVALID)
proc invalidGameModeError*(): CommandErrorType = errorType1(JAVA_ARGUMENT_GAMEMODE_INVALID, JAVA_ARGUMENT_GAMEMODE_INVALID)
proc invalidUuidError*(): CommandErrorType = errorType0(JAVA_ARGUMENT_UUID_INVALID, JAVA_ARGUMENT_UUID_INVALID)
proc invalidIdentifierError*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ID_INVALID, JAVA_ARGUMENT_ID_INVALID)
proc expectedCompoundError*(): CommandErrorType = errorType0(JAVA_ARGUMENT_NBT_EXPECTED_COMPOUND, JAVA_ARGUMENT_NBT_EXPECTED_COMPOUND)
proc invalidBiomeError*(): CommandErrorType = errorType1("commands.fillbiome.invalid", "commands.fillbiome.invalid")

proc substringFrom(reader: StringReader; start: int): string = reader.str[start ..< reader.byteCursor]

proc plainType(kind: ArgumentTypeKind; examples: seq[string]): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: kind), overrideSuggestion: none[SuggestionProviders](),
    examples: examples)

proc argValue(v: ResourceKeyValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: RgbValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: AnchorValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: NbtValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: ColorValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: AttributeValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: BlockValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: DialogValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: GameModeValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: UuidValue): ArgValue =
  let a: ArgValue = v
  a

proc argValue(v: IdentifierValue): ArgValue =
  let a: ArgValue = v
  a

proc suggestingList(names: seq[string]): proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
  result = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    var b = builder
    for n in names:
      b = filterAndSuggestOne(b, n)
    build(b)

# ---- `Identifier::from_reader` -------------------------------------------------------------------------------------

proc identifierFromReader*(reader: var StringReader): CmdResult[Identifier] =
  ## `FromStringReader for Identifier`.
  let start = cursor(reader)
  while canReadChar(reader):
    let c = peek(reader)
    if c < 0'i32 or c > 127'i32 or not isValidChar(char(c)):
      break
    skip(reader)
  let raw = substringFrom(reader, start)
  let parsed = identifier.parse(raw)
  if not parsed.isOk:
    setCursor(reader, start)
    return cmdFail[Identifier](create(invalidIdentifierError(), reader))
  cmdOk[Identifier](parsed.value)

# ---- time.rs -------------------------------------------------------------------------------------------------------

proc newTimeArgumentType*(min: int32 = 0'i32): AnyArgumentType =
  result = AnyArgumentType(clientParser: JavaClientArgumentType(kind: atTime, min: min),
    overrideSuggestion: none[SuggestionProviders](), examples: @["12d", "14s", "789", "450t"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let value = readFloat(reader)
    if not value.isOk:
      return cmdFail[ArgValue](value.error)
    let unit = readUnquotedString(reader)
    var ticksPerUnit = 1'i32
    if unit == "t" or unit == "":
      ticksPerUnit = 1'i32
    elif unit == "s":
      ticksPerUnit = 20'i32
    elif unit == "d":
      ticksPerUnit = 24000'i32
    else:
      return cmdFail[ArgValue](create(invalidUnitError(), reader))
    let ticks = int32(round(float32(ticksPerUnit) * value.value))
    if ticks < min:
      return cmdFail[ArgValue](create(tickCountTooLowError(), reader, text($min), text($ticks)))
    cmdOk[ArgValue](boxInt(ticks))
  result.listSuggestionsProc = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    var r = newStringReader(remaining(builder))
    if not readFloat(r).isOk:
      return build(builder)
    build(filterAndSuggestOne(filterAndSuggestOne(filterAndSuggestOne(builder, "t"), "s"), "d"))

# ---- resource_key.rs -----------------------------------------------------------------------------------------------

proc advancementRegistry*(): Identifier = vanillaStatic("advancement")
proc biomeRegistry*(): Identifier = vanillaStatic("worldgen/biome")

proc newResourceKeyArgument*(registry: Identifier): AnyArgumentType =
  result = AnyArgumentType(clientParser: JavaClientArgumentType(kind: atResourceKey, identifier: registry),
    overrideSuggestion: none[SuggestionProviders](), examples: @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let id = identifierFromReader(reader)
    if not id.isOk:
      return cmdFail[ArgValue](id.error)
    cmdOk[ArgValue](argValue(ResourceKeyValue(registry: registry, identifier: id.value)))
  if $registry == $biomeRegistry():
    var names: seq[string] = @[]
    for b in ALL:
      names.add("minecraft:" & b.registryId)
    result.listSuggestionsProc = suggestingList(names)
  elif $registry == $advancementRegistry():
    var names: seq[string] = @[]
    for id in advgen.Advancement.getIdentifierList():
      names.add($id)
    result.listSuggestionsProc = suggestingList(names)

proc getRegistryKey*(context: CommandContext; name: string; registry: Identifier; error: CommandErrorType): CmdResult[Identifier] =
  ## `get_registry_key`: the identifier, when the key is of that registry.
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[Identifier](missingArgument(name))
  if not (v of ResourceKeyValue):
    return cmdFail[Identifier](wrongArgumentType(name))
  let key = ResourceKeyValue(v)
  if $key.registry != $registry:
    return cmdFail[Identifier](createWithoutContext(error, text(key.identifier.path)))
  cmdOk[Identifier](key.identifier)

proc invalidAdvancementError*(): CommandErrorType =
  errorType1(JAVA_ADVANCEMENT_ADVANCEMENTNOTFOUND, JAVA_ADVANCEMENT_ADVANCEMENTNOTFOUND)

proc getAdvancement*(context: CommandContext; name: string): CmdResult[advgen.Advancement] =
  ## `ResourceKeyArgument::get_advancement`.
  let id = getRegistryKey(context, name, advancementRegistry(), invalidAdvancementError())
  if not id.isOk:
    return cmdFail[advgen.Advancement](id.error)
  let found = advgen.Advancement.fromName(id.value.path)
  if found.isNone:
    return cmdFail[advgen.Advancement](createWithoutContext(invalidAdvancementError(), text(id.value.path)))
  cmdOk[advgen.Advancement](found.unsafeGet)

proc getBiome*(context: CommandContext; name: string): CmdResult[Biome] =
  let id = getRegistryKey(context, name, biomeRegistry(), invalidBiomeError())
  if not id.isOk:
    return cmdFail[Biome](id.error)
  for b in ALL:
    if b.registryId == id.value.path:
      return cmdOk[Biome](b)
  cmdFail[Biome](createWithoutContext(invalidBiomeError(), text($id.value)))

# ---- hex_color.rs --------------------------------------------------------------------------------------------------

proc hexDigit(reader: StringReader; slice: string; index: int; res: var uint8): CmdResult[int32] =
  let b = slice[index]
  case b
  of '0' .. '9':
    res = uint8(ord(b) - ord('0'))
  of 'a' .. 'f':
    res = uint8(ord(b) - ord('a') + 10)
  of 'A' .. 'F':
    res = uint8(ord(b) - ord('A') + 10)
  else:
    return cmdFail[int32](create(errorType1(JAVA_COMMAND_EXCEPTION, BEDROCK_COMMANDS_GENERIC_SYNTAX), reader, text("Error at index " & $index & " in: \"" & slice & "\"")))
  cmdOk[int32](0'i32)

proc newHexColorArgumentType*(): AnyArgumentType =
  result = plainType(atHexColor, @["F00", "FF0000"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let s = readUnquotedString(reader)
    var channels: array[3, uint8] = [0'u8, 0'u8, 0'u8]
    if s.len == 3:
      for i in 0 .. 2:
        var d = 0'u8
        let r = hexDigit(reader, s[i .. i], 0, d)
        if not r.isOk:
          return cmdFail[ArgValue](r.error)
        channels[i] = d * 0x11'u8
    elif s.len == 6:
      for i in 0 .. 2:
        var hi = 0'u8
        var lo = 0'u8
        let pair = s[i * 2 ..< i * 2 + 2]
        let a = hexDigit(reader, pair, 0, hi)
        if not a.isOk:
          return cmdFail[ArgValue](a.error)
        let b = hexDigit(reader, pair, 1, lo)
        if not b.isOk:
          return cmdFail[ArgValue](b.error)
        channels[i] = (hi shl 4) or lo
    else:
      return cmdFail[ArgValue](create(invalidHexError(), reader, text(s)))
    cmdOk[ArgValue](argValue(RgbValue(value: RGBColor(red: channels[0], green: channels[1], blue: channels[2]))))

# ---- entity_anchor.rs ----------------------------------------------------------------------------------------------

proc newEntityAnchorArgumentType*(): AnyArgumentType =
  result = plainType(atEntityAnchor, @["eyes", "feet"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let i = cursor(reader)
    let anchor = readUnquotedString(reader)
    if anchor == "feet":
      return cmdOk[ArgValue](argValue(AnchorValue(value: eaFeet)))
    if anchor == "eyes":
      return cmdOk[ArgValue](argValue(AnchorValue(value: eaEyes)))
    setCursor(reader, i)
    cmdFail[ArgValue](create(invalidAnchorError(), reader, text(anchor)))
  result.listSuggestionsProc = suggestingList(@["feet", "eyes"])

proc getEntityAnchor*(context: CommandContext; name: string): CmdResult[EntityAnchor] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[EntityAnchor](missingArgument(name))
  if not (v of AnchorValue):
    return cmdFail[EntityAnchor](wrongArgumentType(name))
  let a = AnchorValue(v)
  cmdOk[EntityAnchor](a.value)

# ---- slot.rs -------------------------------------------------------------------------------------------------------

proc newItemSlotArgumentType*(): AnyArgumentType =
  result = plainType(atItemSlot, @["weapon", "container.2", "enderchest.0"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let start = cursor(reader)
    readUntilSpace(reader)
    let name = substringFrom(reader, start)
    let (ok, slots) = getSlotRange(name)
    if not ok:
      return cmdFail[ArgValue](create(unknownSlotError(), reader, text(name)))
    if slots.len != 1:
      return cmdFail[ArgValue](create(onlySingleSlotError(), reader, text(name)))
    cmdOk[ArgValue](boxInt(int32(slots[0])))
  result.listSuggestionsProc = suggestingList(slotRangeSingleSlotNames())

# ---- nbt.rs --------------------------------------------------------------------------------------------------------

proc newNbtTagArgumentType*(): AnyArgumentType =
  result = plainType(atNbtTag, @["5", "7b", "1.6", "\"hi\"", "'bye'", "[2, 3]", "[L; 4]", "{x: 3}"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let tag = parseForCommands(reader)
    if not tag.isOk:
      return cmdFail[ArgValue](tag.error)
    cmdOk[ArgValue](argValue(NbtValue(value: tag.value)))
  result.listSuggestionsProc = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    parseForSuggestions(builder)

proc newNbtCompoundArgumentType*(): AnyArgumentType =
  result = plainType(atNbtCompound, @["{}", "{foo=bar}"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let tag = parseForCommands(reader)
    if not tag.isOk:
      return cmdFail[ArgValue](tag.error)
    if tag.value.kind != ntkCompound:
      return cmdFail[ArgValue](create(expectedCompoundError(), reader))
    cmdOk[ArgValue](argValue(NbtValue(value: tag.value)))
  result.listSuggestionsProc = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    parseForSuggestions(builder)

# ---- team_color.rs -------------------------------------------------------------------------------------------------

proc newTeamColorArgumentType*(): AnyArgumentType =
  result = plainType(atColor, @["red", "blue", "yellow"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let id = readUnquotedString(reader)
    let color = namedColorTryFrom(id)
    if color.isNone:
      return cmdFail[ArgValue](create(invalidColorError(), reader, text(id)))
    cmdOk[ArgValue](argValue(ColorValue(value: color.unsafeGet)))
  result.listSuggestionsProc = suggestingList(@["black", "dark_blue", "dark_green", "dark_aqua", "dark_red", "dark_purple",
    "gold", "gray", "dark_gray", "blue", "green", "aqua", "red", "light_purple", "yellow", "white"])

# ---- attribute.rs --------------------------------------------------------------------------------------------------

proc newAttributeArgumentType*(): AnyArgumentType =
  result = AnyArgumentType(clientParser: JavaClientArgumentType(kind: atResource, identifier: vanillaStatic("attribute")),
    overrideSuggestion: none[SuggestionProviders](), examples: @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let id = identifierFromReader(reader)
    if not id.isOk:
      return cmdFail[ArgValue](id.error)
    let shown = $id.value
    let every = allAttributes()
    for a in every:
      if a.name == shown:
        return cmdOk[ArgValue](argValue(AttributeValue(value: a)))
    cmdFail[ArgValue](create(invalidAttributeError(), reader, text(shown)))
  var names: seq[string] = @[]
  let every = allAttributes()
  for a in every:
    names.add(a.name)
  result.listSuggestionsProc = suggestingList(names)

proc getAttribute*(context: CommandContext; name: string): CmdResult[Attribute] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[Attribute](missingArgument(name))
  if not (v of AttributeValue):
    return cmdFail[Attribute](wrongArgumentType(name))
  let a = AttributeValue(v)
  cmdOk[Attribute](a.value)

# ---- block.rs ------------------------------------------------------------------------------------------------------

proc isBlockNameChar(c: int32): bool =
  ## `c.is_alphanumeric() || c == '_' || c == ':' || c == '/' || c == '.' || c == '-'`. Past ASCII every letter counts,
  ## and those are the only non-ASCII characters a block name could hold.
  if c >= 128'i32:
    return true
  if c < 0'i32:
    return false
  let ch = char(c)
  (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_' or ch == ':' or
    ch == '/' or ch == '.' or ch == '-'

proc newBlockArgumentType*(): AnyArgumentType =
  result = plainType(atBlockState, @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let start = cursor(reader)
    while canReadChar(reader) and isBlockNameChar(peek(reader)):
      skip(reader)
    let blockName = substringFrom(reader, start)
    let normalized = if blockName.contains(':'): blockName else: "minecraft:" & blockName
    let key = if normalized.startsWith("minecraft:"): normalized[10 ..< normalized.len] else: normalized
    let (ok, b) = blockByName(key)
    if not ok:
      return cmdFail[ArgValue](create(invalidBlockError(), reader, text(normalized)))
    cmdOk[ArgValue](argValue(BlockValue(value: b)))

proc getBlockArg*(context: CommandContext; name: string): CmdResult[Block] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[Block](missingArgument(name))
  if not (v of BlockValue):
    return cmdFail[Block](wrongArgumentType(name))
  let b = BlockValue(v)
  cmdOk[Block](b.value)

# ---- dialog.rs -----------------------------------------------------------------------------------------------------

proc newDialogArgumentType*(): AnyArgumentType =
  result = plainType(atDialog, @["minecraft:server_links", "custom:my_dialog", "{type:\"minecraft:notice\",title:\"Hello\"}"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    if canReadChar(reader) and peek(reader) == int32(ord('{')):
      let tag = parseForCommands(reader)
      if not tag.isOk:
        return cmdFail[ArgValue](tag.error)
      if tag.value.kind != ntkCompound:
        return cmdFail[ArgValue](create(expectedCompoundError(), reader))
      return cmdOk[ArgValue](argValue(DialogValue(value: DialogArg(isNbt: true, nbt: tag.value))))
    let id = identifierFromReader(reader)
    if not id.isOk:
      return cmdFail[ArgValue](id.error)
    cmdOk[ArgValue](argValue(DialogValue(value: DialogArg(isNbt: false, id: id.value))))

# ---- gamemode.rs ---------------------------------------------------------------------------------------------------

proc newGameModeArgumentType*(): AnyArgumentType =
  result = plainType(atGamemode, @["survival", "creative"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let s = readUnquotedString(reader)
    let (ok, mode) = parseGameMode(s)
    if not ok:
      return cmdFail[ArgValue](create(invalidGameModeError(), reader, text(s)))
    cmdOk[ArgValue](argValue(GameModeValue(value: mode)))
  result.listSuggestionsProc = suggestingList(@["survival", "creative", "adventure", "spectator"])

proc getGameMode*(context: CommandContext; name: string): CmdResult[GameMode] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[GameMode](missingArgument(name))
  if not (v of GameModeValue):
    return cmdFail[GameMode](wrongArgumentType(name))
  let g = GameModeValue(v)
  cmdOk[GameMode](g.value)

# ---- team.rs and objective.rs --------------------------------------------------------------------------------------

proc worldNames(context: CommandContext; team: bool): seq[string] =
  ## `context.world().scoreboard` keys, through the hooks.
  let world = context.source.world
  if world == nil:
    return @[]
  if team:
    if closureSet(world.getTeamNames): world.getTeamNames() else: @[]
  else:
    if closureSet(world.getObjectiveNames): world.getObjectiveNames() else: @[]

proc scoreboardName(kind: ArgumentTypeKind; team: bool): AnyArgumentType =
  result = plainType(kind, @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    cmdOk[ArgValue](boxString(readUnquotedString(reader)))
  result.listSuggestionsProc = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    var b = builder
    for n in worldNames(context, team):
      b = filterAndSuggestOne(b, n)
    build(b)

proc newTeamArgumentType*(): AnyArgumentType = scoreboardName(atTeam, true)
proc newObjectiveArgumentType*(): AnyArgumentType = scoreboardName(atObjective, false)

# ---- placed_feature.rs, structure.rs, template.rs, pool.rs, identifier.rs ------------------------------------------

proc identifierType(names: seq[string]; examples: seq[string]): AnyArgumentType =
  result = plainType(atResourceLocation, examples)
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let id = identifierFromReader(reader)
    if not id.isOk:
      return cmdFail[ArgValue](id.error)
    cmdOk[ArgValue](argValue(IdentifierValue(value: id.value)))
  if names.len > 0:
    result.listSuggestionsProc = suggestingList(names)

proc newIdentifierArgumentType*(): AnyArgumentType = identifierType(@[], @["foo", "foo:bar"])
proc newPlacedFeatureArgumentType*(): AnyArgumentType = identifierType(allNames(PlacedFeature), @[])
proc newStructureArgumentType*(): AnyArgumentType = identifierType(structureAllNames(), @[])

proc prefixed(names: seq[string]): seq[string] =
  result = @[]
  for n in names:
    result.add("minecraft:" & n)

proc newPoolArgumentType*(names: seq[string]): AnyArgumentType = identifierType(prefixed(names), @[])

proc newTemplateArgumentType*(names: seq[string]): AnyArgumentType =
  ## Upstream's value is the identifier's path alone.
  result = plainType(atResourceLocation, @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let id = identifierFromReader(reader)
    if not id.isOk:
      return cmdFail[ArgValue](id.error)
    cmdOk[ArgValue](boxString(id.value.path))
  result.listSuggestionsProc = suggestingList(prefixed(names))

proc getIdentifier*(context: CommandContext; name: string): CmdResult[Identifier] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[Identifier](missingArgument(name))
  if not (v of IdentifierValue):
    return cmdFail[Identifier](wrongArgumentType(name))
  let i = IdentifierValue(v)
  cmdOk[Identifier](i.value)

# ---- uuid.rs -------------------------------------------------------------------------------------------------------

proc isUuidChar(c: int32): bool =
  if c < 0'i32 or c > 127'i32:
    return false
  let ch = char(c)
  (ch >= 'A' and ch <= 'F') or (ch >= 'a' and ch <= 'f') or (ch >= '0' and ch <= '9') or ch == '-'

proc newUuidArgumentType*(): AnyArgumentType =
  result = plainType(atUuid, @["3d569d3a-93ef-44a0-9f1c-f69db9d37a56"])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} =
    let start = cursor(reader)
    while canReadChar(reader):
      let c = peek(reader)
      if not isUuidChar(c):
        break
      skip(reader)
    let (ok, id) = parseUuid(substringFrom(reader, start))
    if not ok:
      setCursor(reader, start)
      return cmdFail[ArgValue](create(invalidUuidError(), reader))
    cmdOk[ArgValue](argValue(UuidValue(value: id)))
