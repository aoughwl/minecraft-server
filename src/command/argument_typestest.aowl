## Upstream's `time.rs` vectors, and each type of argument_types.aowl parsing a good and a bad value.
import std/[assertions, syncio]
import ../generated/translation
import ../util/uuid
import ../util/text/color
import cmderrors, cmdtree, cmdsource, string_reader, argument_types

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc parses(t: AnyArgumentType; input: string): bool =
  var r = newStringReader(input)
  t.parseProc(r).isOk

proc ticks(t: AnyArgumentType; input: string): int32 =
  var r = newStringReader(input)
  let v = t.parseProc(r)
  check(v.isOk, "v.isOk")
  let box = v.value
  check(box of IntValue, "box of IntValue")
  let i = IntValue(box)
  i.value

proc timeTests() =
  # parse_ticks
  check(ticks(newTimeArgumentType(), "15") == 15'i32, "ticks(newTimeArgumentType(), \"15\") == 15'i32")
  check(ticks(newTimeArgumentType(10'i32), "15") == 15'i32, "ticks(newTimeArgumentType(10'i32), \"15\") == 15'i32")
  check(not parses(newTimeArgumentType(20'i32), "15"), "not parses(newTimeArgumentType(20'i32), \"15\")")
  check(ticks(newTimeArgumentType(), "95t") == 95'i32, "ticks(newTimeArgumentType(), \"95t\") == 95'i32")
  check(ticks(newTimeArgumentType(50'i32), "95t") == 95'i32, "ticks(newTimeArgumentType(50'i32), \"95t\") == 95'i32")
  check(not parses(newTimeArgumentType(150'i32), "95t"), "not parses(newTimeArgumentType(150'i32), \"95t\")")
  # parse_other_units
  check(ticks(newTimeArgumentType(), "6s") == 120'i32, "ticks(newTimeArgumentType(), \"6s\") == 120'i32")
  check(ticks(newTimeArgumentType(), "4.5s") == 90'i32, "ticks(newTimeArgumentType(), \"4.5s\") == 90'i32")
  check(ticks(newTimeArgumentType(), "4.633s") == 93'i32, "ticks(newTimeArgumentType(), \"4.633s\") == 93'i32")
  check(not parses(newTimeArgumentType(), "-0.2s"), "not parses(newTimeArgumentType(), \"-0.2s\")")
  check(ticks(newTimeArgumentType(), "9d") == 24000'i32 * 9'i32, "ticks(newTimeArgumentType(), \"9d\") == 24000'i32 * 9'i32")
  check(ticks(newTimeArgumentType(), "7.1234d") == 170962'i32, "ticks(newTimeArgumentType(), \"7.1234d\") == 170962'i32")
  check(not parses(newTimeArgumentType(), "14m"), "not parses(newTimeArgumentType(), \"14m\")")
  check(not parses(newTimeArgumentType(), "1w"), "not parses(newTimeArgumentType(), \"1w\")")

proc otherTypes() =
  var r = newStringReader("F00")
  let hex = newHexColorArgumentType().parseProc(r)
  check(hex.isOk, "hex.isOk")
  let hexBox = hex.value
  check(hexBox of RgbValue, "hexBox of RgbValue")
  let rgb = RgbValue(hexBox)
  check(rgb.value.red == 0xFF'u8 and rgb.value.green == 0'u8 and rgb.value.blue == 0'u8, "rgb.value.red == 0xFF'u8 and rgb.value.green == 0'u8 and rgb.value.blue == 0'u8")
  var r2 = newStringReader("00FF7f")
  let hex2 = newHexColorArgumentType().parseProc(r2)
  check(hex2.isOk, "hex2.isOk")
  let hex2Box = hex2.value
  let rgb2 = RgbValue(hex2Box)
  check(rgb2.value.green == 0xFF'u8 and rgb2.value.blue == 0x7F'u8, "rgb2.value.green == 0xFF'u8 and rgb2.value.blue == 0x7F'u8")
  check(not parses(newHexColorArgumentType(), "12"), "not parses(newHexColorArgumentType(), \"12\")")
  check(not parses(newHexColorArgumentType(), "GGG"), "not parses(newHexColorArgumentType(), \"GGG\")")
  check(parses(newEntityAnchorArgumentType(), "eyes"), "parses(newEntityAnchorArgumentType(), \"eyes\")")
  check(not parses(newEntityAnchorArgumentType(), "knees"), "not parses(newEntityAnchorArgumentType(), \"knees\")")
  check(parses(newItemSlotArgumentType(), "weapon"), "parses(newItemSlotArgumentType(), \"weapon\")")
  check(parses(newItemSlotArgumentType(), "container.2"), "parses(newItemSlotArgumentType(), \"container.2\")")
  check(not parses(newItemSlotArgumentType(), "container.*"), "not parses(newItemSlotArgumentType(), \"container.*\")")
  check(not parses(newItemSlotArgumentType(), "nowhere"), "not parses(newItemSlotArgumentType(), \"nowhere\")")
  check(parses(newNbtTagArgumentType(), "{x: 3}"), "parses(newNbtTagArgumentType(), \"{x: 3}\")")
  check(parses(newNbtCompoundArgumentType(), "{x: 3}"), "parses(newNbtCompoundArgumentType(), \"{x: 3}\")")
  check(not parses(newNbtCompoundArgumentType(), "5"), "not parses(newNbtCompoundArgumentType(), \"5\")")
  check(parses(newTeamColorArgumentType(), "light_purple"), "parses(newTeamColorArgumentType(), \"light_purple\")")
  check(not parses(newTeamColorArgumentType(), "beige"), "not parses(newTeamColorArgumentType(), \"beige\")")
  check(parses(newAttributeArgumentType(), "minecraft:armor"), "parses(newAttributeArgumentType(), \"minecraft:armor\")")
  check(not parses(newAttributeArgumentType(), "minecraft:not_an_attribute"), "not parses(newAttributeArgumentType(), \"minecraft:not_an_attribute\")")
  check(parses(newBlockArgumentType(), "stone"), "parses(newBlockArgumentType(), \"stone\")")
  check(parses(newBlockArgumentType(), "minecraft:stone"), "parses(newBlockArgumentType(), \"minecraft:stone\")")
  check(not parses(newBlockArgumentType(), "not_a_block"), "not parses(newBlockArgumentType(), \"not_a_block\")")
  check(parses(newDialogArgumentType(), "minecraft:server_links"), "parses(newDialogArgumentType(), \"minecraft:server_links\")")
  check(parses(newDialogArgumentType(), "{type:\"minecraft:notice\"}"), "parses(newDialogArgumentType(), \"{type:\\\"minecraft:notice\\\"}\")")
  check(parses(newGameModeArgumentType(), "creative"), "parses(newGameModeArgumentType(), \"creative\")")
  check(not parses(newGameModeArgumentType(), "nosuchmode"), "not parses(newGameModeArgumentType(), \"nosuchmode\")")
  check(parses(newTeamArgumentType(), "red_team"), "parses(newTeamArgumentType(), \"red_team\")")
  check(parses(newObjectiveArgumentType(), "kills"), "parses(newObjectiveArgumentType(), \"kills\")")
  check(parses(newIdentifierArgumentType(), "foo:bar"), "parses(newIdentifierArgumentType(), \"foo:bar\")")
  check(not parses(newIdentifierArgumentType(), "a:b:c"), "not parses(newIdentifierArgumentType(), \"a:b:c\")")
  check(parses(newPlacedFeatureArgumentType(), "minecraft:oak"), "parses(newPlacedFeatureArgumentType(), \"minecraft:oak\")")
  check(parses(newStructureArgumentType(), "minecraft:village_plains"), "parses(newStructureArgumentType(), \"minecraft:village_plains\")")
  check(parses(newPoolArgumentType(@["a"]), "minecraft:a"), "parses(newPoolArgumentType(@[\"a\"]), \"minecraft:a\")")
  check(parses(newTemplateArgumentType(@["a"]), "minecraft:a"), "parses(newTemplateArgumentType(@[\"a\"]), \"minecraft:a\")")
  check(parses(newUuidArgumentType(), "3d569d3a-93ef-44a0-9f1c-f69db9d37a56"), "parses(newUuidArgumentType(), \"3d569d3a-93ef-44a0-9f1c-f69db9d37a56\")")
  check(not parses(newUuidArgumentType(), "nonsense"), "not parses(newUuidArgumentType(), \"nonsense\")")
  check(parses(newResourceKeyArgument(biomeRegistry()), "minecraft:plains"), "parses(newResourceKeyArgument(biomeRegistry()), \"minecraft:plains\")")

proc main() =
  timeTests()
  otherTypes()
  echo "argument_types: all checks passed"

main()
