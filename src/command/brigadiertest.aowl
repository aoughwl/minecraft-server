## Suggestions through the dispatcher, and forks. Upstream has no `#[test]` for these, so the expected values are read
## off pumpkin/src/command/node/dispatcher.rs and context/command_context.rs.
import std/[assertions, syncio]
import string_range, cmderrors, suggestion, cmdsource, cmdtree, argument_builder, argtype, cmddispatch
import ../protocol/java/client/play/commands

proc ret(v: int32): CommandExecutor =
  result = proc(c: CommandContext): CmdResult[int32] {.closure.} = cmdOk[int32](v)

proc twoSources(c: CommandContext): CmdResult[seq[CommandSource]] =
  cmdOk[seq[CommandSource]](@[c.source, c.source])

proc noSources(c: CommandContext): CmdResult[seq[CommandSource]] =
  cmdFail[seq[CommandSource]](createWithoutContext(dispatcherUnknownArgument()))

proc texts(s: Suggestions): seq[string] =
  var res: seq[string] = @[]
  for x in s.suggestions:
    res.add(x.text.cachedText)
  res

proc suggestionTree(): CommandDispatcher =
  result = newCommandDispatcher()
  var foo = executes(command("foo", "d"), ret(1'i32))
  foo = then(foo, executes(literal("bar"), ret(2'i32)))
  foo = then(foo, executes(literal("baz"), ret(3'i32)))
  discard register(result, foo)
  discard register(result, executes(command("fob", "d"), ret(4'i32)))
  discard register(result, redirect(command("r", "d"), redirectRoot()))
  discard register(result, then(command("arg", "d"),
    executes(argument("n", newIntegerArgumentType()), ret(5'i32))))

proc at(d: CommandDispatcher; input: string): Suggestions =
  getCompletionSuggestionsAtEnd(d, parseInput(d, input, dummySource()))

proc suggestions() =
  let d = suggestionTree()
  let root = at(d, "f")
  assert texts(root) == @["fob", "foo"]
  assert root.range == between(0, 1)
  let children = at(d, "foo ")
  assert texts(children) == @["bar", "baz"]
  assert children.range == between(4, 4)
  let partial = at(d, "foo b")
  assert texts(partial) == @["bar", "baz"]
  assert partial.range == between(4, 5)
  assert isEmpty(at(d, "foo x"))
  # A redirect suggests from its target, past the redirecting literal.
  let redirected = at(d, "r fo")
  assert texts(redirected) == @["fob", "foo"]
  assert redirected.range == between(2, 4)
  # An argument with no provider and no list_suggestions offers nothing, and does not hide the literal path.
  assert isEmpty(at(d, "arg "))
  # At the cursor in the middle of a parsed command the parent is the node before it.
  let mid = getCompletionSuggestions(d, parseInput(d, "foo bar", dummySource()), 3)
  # `foo` is exactly what is typed, so `suggest` drops it, and `fob` does not start with `foo`.
  assert isEmpty(mid)

proc forks() =
  let d = newCommandDispatcher()
  discard register(d, executes(command("foo", "d"), ret(5'i32)))
  discard register(d, fork(command("as", "d"), redirectRoot(), customModifier(twoSources)))
  discard register(d, redirectWithModifier(command("each", "d"), redirectRoot(), customModifier(twoSources)))
  discard register(d, fork(command("none", "d"), redirectRoot(), customModifier(noSources)))
  discard register(d, redirectWithModifier(command("bad", "d"), redirectRoot(), customModifier(noSources)))
  let s = dummySource()
  # Upstream's `ContextChain::try_flatten` pushes `child`, where vanilla brigadier pushes `current`. So the modifier on
  # the node that redirects is skipped for the first context, and the last context is a modifier as well as the
  # executable. These are the values upstream's code gives, not vanilla's (which would be 2, 10, 4, 0 and an error).
  assert executeInput(d, "as foo", s).value == 5'i32
  assert executeInput(d, "each foo", s).value == 5'i32
  # The second `as` is a child context, so its modifier does run: two sources, each counting 1 in forked mode.
  assert executeInput(d, "as as foo", s).value == 2'i32
  assert executeInput(d, "none foo", s).value == 5'i32
  assert executeInput(d, "bad foo", s).value == 5'i32
  # Reached as a child, a failing modifier is swallowed while forked and returned otherwise.
  assert executeInput(d, "as none foo", s).value == 0'i32
  let returned = executeInput(d, "as bad foo", s)
  assert not returned.isOk and returned.error.isType(dispatcherUnknownArgument())

proc errorChoice() =
  let d = newCommandDispatcher()
  discard register(d, then(command("foo", "d"), executes(argument("n", newIntegerArgumentType()), ret(1'i32))))
  let s = dummySource()
  # Nothing matched at the root.
  assert executeInput(d, "nope", s).error.isType(dispatcherUnknownCommand())
  # One child failed, so its error is the answer.
  assert executeInput(d, "foo x", s).error.isType(readerExpectedInt())
  # A parsed number with trailing data.
  assert executeInput(d, "foo 1x", s).error.isType(dispatcherExpectedArgumentSeparator())
  # The literal parsed and has no executor, so nothing can be flattened to run.
  assert executeInput(d, "foo", s).error.isType(dispatcherUnknownCommand())

proc usage() =
  let d = suggestionTree()
  let s = dummySource()
  var u = ""
  assert getUsageOfCommand(d, getCommand(d.tree, "foo"), s, u)
  # Each child is optional under an executable parent and brackets itself, then the group brackets them again.
  assert u == "/foo [[bar]|[baz]]"
  assert getUsageOfCommand(d, getCommand(d.tree, "arg"), s, u)
  assert u == "/arg <n>"
  assert getUsageOfCommand(d, getCommand(d.tree, "r"), s, u)
  assert u == "/r -> "

suggestions()
forks()
errorChoice()
usage()
echo "brigadier: all checks passed"
