## Server mods compiled into the server (WorldEdit, ...), as opposed to loaded plugins. `/plugins` lists them after the
## plugins and `/help <mod name>` lists their commands, which live in the node dispatcher under their own root names.

import std/strutils
import ../util/text/textbase, ../util/text/text, ../util/text/color

type
  BuiltinMod* = object
    name*: string
    version*: string
    description*: string
    commands*: seq[string]   ## root command names, as registered (`/set` for the client's `//set`)

var gBuiltinMods: seq[BuiltinMod] = @[]

proc registerBuiltinMod*(m: BuiltinMod) =
  ## Replaces a mod of the same name (a reloaded dispatcher registers again).
  var i = 0
  while i < gBuiltinMods.len:
    if gBuiltinMods[i].name == m.name:
      gBuiltinMods[i] = m
      return
    inc i
  gBuiltinMods.add(m)

proc builtinMods*(): seq[BuiltinMod] =
  gBuiltinMods

proc addBuiltinModsLine*(message: TextComponent): TextComponent =
  ## `message` plus "\nBuilt-in server mods: A, B" (each name green, its commands on hover); unchanged when there are none.
  result = message
  if gBuiltinMods.len == 0:
    return
  result = addChild(result, text("\nBuilt-in server mods: "))
  var i = 0
  while i < gBuiltinMods.len:
    let m = gBuiltinMods[i]
    var cmds = ""
    for c in m.commands:
      if cmds.len > 0:
        cmds.add(", ")
      cmds.add("/" & c)
    let hover = "Version: " & m.version & "\nDescription: " & m.description & "\nCommands: " & cmds
    let shown = if i == gBuiltinMods.len - 1: m.name else: m.name & ", "
    result = addChild(result, hoverEvent(colorNamed(text(shown), ncGreen), showText(text(hover))))
    inc i

proc findBuiltinMod*(name: string; m: var BuiltinMod): bool =
  for b in gBuiltinMods:
    if cmpIgnoreCase(b.name, name) == 0:
      m = b
      return true
  false
