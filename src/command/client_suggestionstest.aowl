## The serialized command tree, against exact packet bytes for protocol 774.
## Upstream has no `#[test]` for pumpkin/src/command/client_suggestions.rs, so the expected bytes are worked out by
## hand from its order: fallback trees first (post-order), then the node tree by id, then the root's second children.
import std/[assertions, options, strutils, syncio]
import ../protocol/java/client/play/commands
import ../protocol/[protobase, netcodec, varint]
import ../util/javaversion
import ../util/text/text
import cmderrors, suggestion, cmdsource, cmdtree, argtype, argument_builder, cmddispatch, fallbackdispatch, client_suggestions

const V = jmvV1_21_11

proc hex(b: seq[byte]): string =
  const digits = "0123456789abcdef"
  result = ""
  for x in b:
    result.add(digits[int(x) shr 4])
    result.add(digits[int(x) and 15])

proc packetHex(p: CCommands): string =
  var w = newNetWriter()
  assert writePacket(p, w, V).isOk
  hex(w.buf)

proc noop(c: CommandContext): CmdResult[int32] = cmdOk[int32](1'i32)
proc noopLegacy(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult = cmdSuccess(1'i32)

proc plainTree() =
  ## Only the node tree: root, then `foo` with an integer child, then a redirect to the root.
  let d = newCommandDispatcher()
  discard register(d, then(command("foo", "d"), executes(argument("n", newIntegerArgumentType(0'i32, 10'i32)), noop)))
  discard register(d, redirect(command("r", "d"), redirectRoot()))
  let p = buildCCommands(senderConsole(), nil, d)
  assert packetHex(p) ==
    "04" &                                # node count
    "00" & "02" & "02" & "03" &           # 0 root: flags, two children, foo and r
    "06" & "00" & "01" & "6e" & "03" & "03" & "00000000" & "0000000a" & # 1 argument n: executable, integer in 0..10
    "01" & "01" & "01" & "03" & "666f6f" & # 2 literal foo: one child, node 1
    "09" & "00" & "00" & "01" & "72" &    # 3 literal r: redirect flag, target root
    "00"                                  # root index

proc withFallback() =
  ## A fallback command comes first and shifts every node-tree index past it.
  let d = newCommandDispatcher()
  register(d.fallbackDispatcher, execute(newCommandTree(["pl"], "list"), noopLegacy), "pumpkin:command.plugins")
  discard register(d, then(command("foo", "d"), executes(argument("n", newIntegerArgumentType(0'i32, 10'i32)), noop)))
  discard register(d, redirect(command("r", "d"), redirectRoot()))
  let p = buildCCommands(senderConsole(), nil, d)
  assert packetHex(p) ==
    "05" &
    "05" & "00" & "02" & "706c" &         # 0 literal pl, executable
    "00" & "03" & "00" & "03" & "04" &    # 1 root: pl, then foo and r
    "06" & "00" & "01" & "6e" & "03" & "03" & "00000000" & "0000000a" & # 2 argument n
    "01" & "01" & "02" & "03" & "666f6f" & # 3 literal foo
    "09" & "00" & "01" & "01" & "72" &    # 4 literal r, redirect to the root at 1
    "01"

proc fallbackPermissionFilter() =
  ## A dummy sender with no server cannot see a fallback command; the node tree is not filtered.
  let d = newCommandDispatcher()
  register(d.fallbackDispatcher, execute(newCommandTree(["pl"], "list"), noopLegacy), "pumpkin:command.plugins")
  let p = buildCCommands(senderDummy(), nil, d)
  assert packetHex(p) == "01" & "00" & "00" & "00"

proc requirementIsNotFiltered() =
  ## `satisfies_requirements` is a constant true upstream, so a node the player cannot use is still sent, unrestricted.
  let d = newCommandDispatcher()
  discard register(d, executes(requires(command("x", "d"), "no:such.permission"), noop))
  let p = buildCCommands(senderDummy(), nil, d)
  assert packetHex(p) == "02" & "00" & "01" & "01" & "05" & "00" & "01" & "78" & "00"

proc suggestionOverride() =
  ## A provider on an argument turns into the ask_server override with flag 0x10.
  let d = newCommandDispatcher()
  let provider: SuggestionProvider = proc(c: CommandContext; b: SuggestionsBuilder): Suggestions {.closure.} = build(b)
  discard register(d, then(command("x", "d"), suggests(argument("w", newStringArgumentType(spSingleWord)), provider)))
  let p = buildCCommands(senderDummy(), nil, d)
  assert packetHex(p) ==
    "03" &
    "00" & "01" & "02" &
    "12" & "00" & "01" & "77" & "05" & "00" & "14" & "6d696e6563726166743a61736b5f736572766572" &
    "01" & "01" & "01" & "01" & "78" &
    "00"

plainTree()
withFallback()
fallbackPermissionFilter()
requirementIsNotFiltered()
suggestionOverride()
echo "client_suggestions: all checks passed"
