## Port of the `#[test]` blocks of pumpkin/src/command/node/dispatcher.rs, node/tree.rs, argument_builder.rs and
## context/command_context.rs.
import std/[assertions, syncio]
import ../util/text/text
import cmderrors, string_range, string_reader, cmdsource, cmdtree, argument_builder, argtype, cmddispatch
import ../protocol/java/client/play/commands

proc ok(v: int32): CommandExecutor =
  result = proc(c: CommandContext): CmdResult[int32] {.closure.} = cmdOk[int32](v)

proc unknownCommand() =
  let d = newCommandDispatcher()
  discard register(d, command("unknown", "A command without an executor"))
  let r = executeInput(d, "unknown", dummySource())
  assert not r.isOk and r.error.isType(dispatcherUnknownCommand())

proc simpleCommand() =
  let d = newCommandDispatcher()
  discard register(d, executes(command("simple", "A simple command"), ok(1'i32)))
  let r = executeInput(d, "simple", dummySource())
  assert r.isOk and r.value == 1'i32

type Op = enum opAdd, opSub, opMul, opDiv

proc arith(op: Op): CommandExecutor =
  result = proc(c: CommandContext): CmdResult[int32] {.closure.} =
    let a = getInt(c, "operand1")
    if not a.isOk:
      return a
    let b = getInt(c, "operand2")
    if not b.isOk:
      return b
    case op
    of opAdd: cmdOk[int32](a.value + b.value)
    of opSub: cmdOk[int32](a.value - b.value)
    of opMul: cmdOk[int32](a.value * b.value)
    of opDiv: cmdOk[int32](a.value div b.value)

proc branch(sym: string; op: Op): ArgumentBuilder =
  then(literal(sym), executes(argument("operand2", newIntegerArgumentType()), arith(op)))

proc arithmeticCommand() =
  let d = newCommandDispatcher()
  var args = argument("operand1", newIntegerArgumentType())
  args = then(args, branch("+", opAdd))
  args = then(args, branch("-", opSub))
  args = then(args, branch("*", opMul))
  args = then(args, branch("/", opDiv))
  discard register(d, then(command("arithmetic", "A command which adds two integers, returning the result"), args))
  let s = dummySource()
  assert executeInput(d, "arithmetic 3 + -7", s).value == -4'i32
  assert executeInput(d, "arithmetic 4 - -8", s).value == 12'i32
  assert executeInput(d, "arithmetic 2 * 9", s).value == 18'i32
  assert executeInput(d, "arithmetic 9 / 2", s).value == 4'i32

proc aliasSimple() =
  let d = newCommandDispatcher()
  discard register(d, executes(command("a", "A command"), ok(1'i32)))
  discard register(d, executes(command("b", "An alias for /a"), ok(1'i32)))
  assert executeInput(d, "a", dummySource()).value == 1'i32
  assert executeInput(d, "b", dummySource()).value == 1'i32

proc aliasComplex() =
  let d = newCommandDispatcher()
  let ex: CommandExecutor = proc(c: CommandContext): CmdResult[int32] {.closure.} = getInt(c, "result")
  let a = register(d, then(command("a", "A command"), executes(argument("result", newIntegerArgumentType()), ex)))
  discard register(d, redirect(command("b", "An alias for /a"), redirectLocal(a)))
  assert executeInput(d, "a 5", dummySource()).value == 5'i32
  assert executeInput(d, "b 7", dummySource()).value == 7'i32

proc recurse() =
  let d = newCommandDispatcher()
  var builder = executes(command("recurse", "Recurses itself, doing nothing with the numbers provided"), ok(1'i32))
  let id0 = id(builder)
  builder = then(builder, redirect(executes(argument("value", newIntegerArgumentType()), ok(1'i32)), redirectGlobal(id0)))
  discard register(d, builder)
  let s = dummySource()
  assert executeInput(d, "recurse", s).value == 1'i32
  assert executeInput(d, "recurse 4", s).value == 1'i32
  assert executeInput(d, "recurse 9 -1", s).value == 1'i32
  assert executeInput(d, "recurse 9 7 -6 5 -4", s).value == 1'i32
  assert executeInput(d, "recurse 1 2 4 8 16 32 64 128 256 512", s).value == 1'i32

proc addingNodes() =
  let t = newTree()
  assert size(t) == 1
  discard addChildToRoot(t, build(command("foo", "A test command")))
  assert size(t) == 2
  discard addChildToRoot(t, build(then(then(command("bar", "Another test command"), literal("baz")), literal("qux"))))
  assert size(t) == 5

proc addingChildrenToAttachedNode() =
  let t = newTree()
  let parent = addChildToRoot(t, build(command("foo", "A test command")))
  discard addChild(t, parent, build(literal("baz")))
  discard addChild(t, parent, build(literal("qux")))
  assert size(t) == 4
  assert getChildren(t, parent).len == 2
  assert not canAddChild(parent, build(command("bar", "Another test command")))

proc findingAmbiguities() =
  let t = newTree()
  let parent = addChildToRoot(t, build(command("foo", "A test command")))
  discard addChild(t, parent, build(literal("hello")))
  discard addChild(t, parent, build(literal("bye")))
  let sibling = addChild(t, parent, build(argument("string", newStringArgumentType(spSingleWord))))
  var inputsReceived = 0
  let consumer: AmbiguityConsumer = proc(tree: Tree; p, child, sib: NodeId; inputs: seq[string]) {.closure.} =
    inputsReceived += inputs.len
    assert p == parent
    assert sib == sibling
  findAmbiguities(t, parent, consumer)
  assert inputsReceived == 2

proc builderTests() =
  let n = build(literal("test"))
  assert n.literal == "test"
  let req = build(argument("test", newIntegerArgumentType(1'i32, 10'i32)))
  assert req.name == "test"
  var r1 = newStringReader("5")
  var r2 = newStringReader("11")
  let at0 = req.argumentType
  assert at0 != nil
  let p1 = at0.parseProc(r1)
  assert p1.isOk
  let boxed = IntValue(p1.value)
  assert boxed.value == 5'i32
  let p2 = at0.parseProc(r2)
  assert not p2.isOk and p2.error.isType(integerTooHigh())
  var letters = command("letter", "A test command")
  for c in 'a' .. 'z':
    letters = then(letters, literal(encodeCp(int32(ord(c)))))
  assert build(letters).children.len == 26
  let two = then(then(command("test", "A test command"), argument("number", newDoubleArgumentType())),
    argument("word", newStringArgumentType(spSingleWord)))
  assert build(two).children.len == 2
  let t = newTree()
  let id0 = addChildToRoot(t, build(redirect(command("test", "A test command"), redirectRoot())))
  let node = nodeAt(t, id0)
  assert node.hasRedirect
  let target = resolve(t, node.redirect)
  assert target != 0 and nodeAt(t, target).kind == nkRoot
  assert forwardProblem(then(command("test", "t"), literal("child"))) ==
    "Cannot forward a node with children. The node must have no children to redirect somewhere else"
  assert thenProblem(redirect(command("test", "t"), redirectRoot()), literal("child")) ==
    "Cannot add children to a redirected node"
  assert thenProblem(command("foo", "t"), command("bar", "t")) ==
    "Cannot add a CommandDetachedNode as a child of a builder"

proc contextBuilder(d: CommandDispatcher): CommandContextBuilder =
  result = newCommandContextBuilder(d.tree, dummySource(), RootNodeId, 0)
  withArgument(result, "foo", parsedArgument(between(0, 1), boxInt(6789'i32)))

proc contextTests() =
  let d = newCommandDispatcher()
  let c = build(contextBuilder(d), "6789")
  let a = getInt(c, "foo")
  assert a.isOk and a.value == 6789'i32
  assert not getInt(c, "bar").isOk
  assert not getFloat(c, "foo").isOk

proc chainOf(d: CommandDispatcher; input: string): nil ContextChain =
  let top = build(parseInput(d, input, dummySource()).context, input)
  tryFlatten(top)

proc must(c: nil ContextChain): ContextChain =
  if c == nil:
    echo "expected a chain"
    quit(1)
  c

proc chainTests() =
  let d = newCommandDispatcher()
  discard register(d, executes(command("foo", "A test command"), ok(10'i32)))
  discard register(d, redirect(command("bar", "Another test command"), redirectRoot()))
  discard register(d, redirect(command("qux", "Yet another test command"), redirectRoot()))
  let s = dummySource()
  let single = must(chainOf(d, "foo"))
  assert executeAll(single, s, emptyConsumer()).value == 10'i32
  assert getStage(single) == stageExecute
  assert nextStage(single) == nil
  let redirected = must(chainOf(d, "bar foo"))
  assert executeAll(redirected, s, emptyConsumer()).value == 10'i32
  let multi = must(chainOf(d, "bar qux foo"))
  assert getStage(multi) == stageModify
  let chain2 = must(nextStage(multi))
  assert getStage(chain2) == stageModify
  let chain3 = must(nextStage(chain2))
  assert getStage(chain3) == stageExecute
  assert nextStage(chain3) == nil
  let d2 = newCommandDispatcher()
  discard register(d2, command("foo", "A test command"))
  assert chainOf(d2, "foo") == nil

proc parseReset(t: AnyArgumentType; r: var StringReader): CmdResult[ArgValue] =
  result = t.parseProc(r)
  setCursor(r, 0)

proc strOf(v: CmdResult[ArgValue]): string =
  assert v.isOk
  let s = StringValue(v.value)
  s.value

proc coreArgumentTests() =
  var r = newStringReader("123")
  assert parseReset(newIntegerArgumentType(), r).isOk
  assert parseReset(newIntegerArgumentType(120'i32), r).isOk
  assert parseReset(newIntegerArgumentType(130'i32), r).error.isType(integerTooLow())
  assert parseReset(newIntegerArgumentType(max = 200'i32), r).isOk
  assert parseReset(newIntegerArgumentType(max = 100'i32), r).error.isType(integerTooHigh())
  assert parseReset(newIntegerArgumentType(100'i32, 125'i32), r).isOk
  assert parseReset(newIntegerArgumentType(100'i32, 120'i32), r).error.isType(integerTooHigh())
  assert parseReset(newIntegerArgumentType(125'i32, 150'i32), r).error.isType(integerTooLow())
  r = newStringReader("5000000000")
  assert parseReset(newIntegerArgumentType(), r).error.isType(readerInvalidInt())
  r = newStringReader("1")
  assert parseReset(newBoolArgumentType(), r).error.isType(readerInvalidBool())
  r = newStringReader("-1234.56")
  assert parseReset(newFloatArgumentType(), r).isOk
  assert parseReset(newFloatArgumentType(-1230.0'f32), r).error.isType(floatTooLow())
  assert parseReset(newFloatArgumentType(max = -1240.0'f32), r).error.isType(floatTooHigh())
  r = newStringReader("'single-quoted string!'")
  assert strOf(parseReset(newStringArgumentType(spQuotablePhrase), r)) == "single-quoted string!"
  assert strOf(parseReset(newStringArgumentType(spSingleWord), r)) == ""
  assert strOf(parseReset(newStringArgumentType(spGreedyPhrase), r)) == "'single-quoted string!'"
  r = newStringReader("'incorrect\"")
  assert parseReset(newStringArgumentType(spQuotablePhrase), r).error.isType(readerExpectedEndQuote())

unknownCommand()
simpleCommand()
arithmeticCommand()
aliasSimple()
aliasComplex()
recurse()
addingNodes()
addingChildrenToAttachedNode()
findingAmbiguities()
builderTests()
contextTests()
chainTests()
coreArgumentTests()
echo "cmddispatch: all checks passed"
