## Command-parsing errors: the error-type constants and the error value they create.
## Port of pumpkin/src/command/errors/error_types.rs
## Port of pumpkin/src/command/errors/command_syntax_error.rs
## Port of pumpkin/src/command/errors/mod.rs
##
## `dyn AnyCommandErrorType` is one `CommandErrorType` object: `isLiteral` picks upstream's `LiteralCommandErrorType`,
## and `argCount` carries the const generic `N`. Identity is upstream's: text plus argument count.
## `ContextProvider` is the `CommandSyntaxErrorContext` value itself; string_reader.aowl adds the reader overloads.

import std/assertions
import ../util/text/textbase, ../util/text/text
import ../generated/translation

type
  CommandErrorType* = object
    javaTranslationKey*: string
    bedrockTranslationKey*: string
    literal*: string
    isLiteral*: bool
    argCount*: int

  CommandSyntaxErrorContext* = object
    input*: string
    cursor*: int

  CommandSyntaxError* = object
    errorType*: CommandErrorType
    message*: TextComponent
    hasContext*: bool
    context*: CommandSyntaxErrorContext

  CmdResult*[T] = object
    case isOk*: bool
    of true:
      value*: T
    of false:
      error*: CommandSyntaxError

  CmdVoidResult* = object
    isOk*: bool
    error*: CommandSyntaxError

proc errorType0*(java, bedrock: string): CommandErrorType =
  CommandErrorType(javaTranslationKey: java, bedrockTranslationKey: bedrock, argCount: 0)
proc errorType1*(java, bedrock: string): CommandErrorType =
  CommandErrorType(javaTranslationKey: java, bedrockTranslationKey: bedrock, argCount: 1)
proc errorType2*(java, bedrock: string): CommandErrorType =
  CommandErrorType(javaTranslationKey: java, bedrockTranslationKey: bedrock, argCount: 2)
proc errorType3*(java, bedrock: string): CommandErrorType =
  CommandErrorType(javaTranslationKey: java, bedrockTranslationKey: bedrock, argCount: 3)
proc errorType4*(java, bedrock: string): CommandErrorType =
  CommandErrorType(javaTranslationKey: java, bedrockTranslationKey: bedrock, argCount: 4)
proc literalErrorType*(literal: string): CommandErrorType =
  CommandErrorType(literal: literal, isLiteral: true)

proc `==`*(a, b: CommandErrorType): bool =
  a.isLiteral == b.isLiteral and a.literal == b.literal and a.argCount == b.argCount and
    a.javaTranslationKey == b.javaTranslationKey and a.bedrockTranslationKey == b.bedrockTranslationKey

proc messageOf(t: CommandErrorType; args: seq[TextComponent]): TextComponent =
  assert t.isLiteral or args.len == t.argCount, "wrong argument count for a command error type"
  if t.isLiteral:
    text(t.literal)
  else:
    translateCross(t.javaTranslationKey, t.bedrockTranslationKey, args)

proc createWithoutContext*(t: CommandErrorType; args: seq[TextComponent]): CommandSyntaxError =
  CommandSyntaxError(errorType: t, message: messageOf(t, args), hasContext: false)
proc createWithoutContext*(t: CommandErrorType): CommandSyntaxError = createWithoutContext(t, @[])
proc createWithoutContext*(t: CommandErrorType; a: TextComponent): CommandSyntaxError = createWithoutContext(t, @[a])
proc createWithoutContext*(t: CommandErrorType; a, b: TextComponent): CommandSyntaxError = createWithoutContext(t, @[a, b])
proc createWithoutContext*(t: CommandErrorType; a, b, c: TextComponent): CommandSyntaxError = createWithoutContext(t, @[a, b, c])

proc create*(t: CommandErrorType; ctx: CommandSyntaxErrorContext; args: seq[TextComponent]): CommandSyntaxError =
  CommandSyntaxError(errorType: t, message: messageOf(t, args), hasContext: true, context: ctx)
proc create*(t: CommandErrorType; ctx: CommandSyntaxErrorContext): CommandSyntaxError = create(t, ctx, @[])
proc create*(t: CommandErrorType; ctx: CommandSyntaxErrorContext; a: TextComponent): CommandSyntaxError = create(t, ctx, @[a])
proc create*(t: CommandErrorType; ctx: CommandSyntaxErrorContext; a, b: TextComponent): CommandSyntaxError = create(t, ctx, @[a, b])

proc syntaxErrorWith*(t: CommandErrorType; message: TextComponent): CommandSyntaxError =
  ## `CommandSyntaxError::create_without_context`.
  CommandSyntaxError(errorType: t, message: message, hasContext: false)

proc syntaxErrorWith*(t: CommandErrorType; message: TextComponent; ctx: CommandSyntaxErrorContext): CommandSyntaxError =
  ## `CommandSyntaxError::create`.
  CommandSyntaxError(errorType: t, message: message, hasContext: true, context: ctx)

proc isType*(e: CommandSyntaxError; t: CommandErrorType): bool =
  ## `CommandSyntaxError::is`; `is` is a keyword here.
  e.errorType == t

proc cmdOk*[T](value: sink T): CmdResult[T] =
  CmdResult[T](isOk: true, value: value)

proc cmdFail*[T](error: CommandSyntaxError): CmdResult[T] =
  CmdResult[T](isOk: false, error: error)

proc cmdOkVoid*(): CmdVoidResult =
  CmdVoidResult(isOk: true)

proc cmdFailVoid*(error: CommandSyntaxError): CmdVoidResult =
  CmdVoidResult(isOk: false, error: error)

proc readerExpectedStartQuote*(): CommandErrorType = errorType0(JAVA_PARSING_QUOTE_EXPECTED_START, JAVA_PARSING_QUOTE_EXPECTED_START)
proc readerExpectedEndQuote*(): CommandErrorType = errorType0(JAVA_PARSING_QUOTE_EXPECTED_END, JAVA_PARSING_QUOTE_EXPECTED_END)
proc readerInvalidEscape*(): CommandErrorType = errorType1(JAVA_PARSING_QUOTE_ESCAPE, JAVA_PARSING_QUOTE_ESCAPE)
proc readerInvalidBool*(): CommandErrorType = errorType1(JAVA_PARSING_BOOL_INVALID, JAVA_PARSING_BOOL_INVALID)
proc readerExpectedBool*(): CommandErrorType = errorType0(JAVA_PARSING_BOOL_EXPECTED, JAVA_PARSING_BOOL_EXPECTED)
proc readerInvalidInt*(): CommandErrorType = errorType1(JAVA_PARSING_INT_INVALID, JAVA_PARSING_INT_INVALID)
proc readerExpectedInt*(): CommandErrorType = errorType0(JAVA_PARSING_INT_EXPECTED, JAVA_PARSING_INT_EXPECTED)
proc readerInvalidLong*(): CommandErrorType = errorType1(JAVA_PARSING_LONG_INVALID, JAVA_PARSING_LONG_INVALID)
proc readerExpectedLong*(): CommandErrorType = errorType0(JAVA_PARSING_LONG_EXPECTED, JAVA_PARSING_LONG_EXPECTED)
proc readerInvalidDouble*(): CommandErrorType = errorType1(JAVA_PARSING_DOUBLE_INVALID, JAVA_PARSING_DOUBLE_INVALID)
proc readerExpectedDouble*(): CommandErrorType = errorType0(JAVA_PARSING_DOUBLE_EXPECTED, JAVA_PARSING_DOUBLE_EXPECTED)
proc readerInvalidFloat*(): CommandErrorType = errorType1(JAVA_PARSING_FLOAT_INVALID, JAVA_PARSING_FLOAT_INVALID)
proc readerExpectedFloat*(): CommandErrorType = errorType0(JAVA_PARSING_FLOAT_EXPECTED, JAVA_PARSING_FLOAT_EXPECTED)
proc readerExpectedSymbol*(): CommandErrorType = errorType1(JAVA_PARSING_EXPECTED, JAVA_PARSING_EXPECTED)
proc literalIncorrect*(): CommandErrorType = errorType1(JAVA_ARGUMENT_LITERAL_INCORRECT, JAVA_ARGUMENT_LITERAL_INCORRECT)
proc doubleTooLow*(): CommandErrorType = errorType2(JAVA_ARGUMENT_DOUBLE_LOW, JAVA_ARGUMENT_DOUBLE_LOW)
proc doubleTooHigh*(): CommandErrorType = errorType2(JAVA_ARGUMENT_DOUBLE_BIG, JAVA_ARGUMENT_DOUBLE_BIG)
proc floatTooLow*(): CommandErrorType = errorType2(JAVA_ARGUMENT_FLOAT_LOW, JAVA_ARGUMENT_FLOAT_LOW)
proc floatTooHigh*(): CommandErrorType = errorType2(JAVA_ARGUMENT_FLOAT_BIG, JAVA_ARGUMENT_FLOAT_BIG)
proc integerTooLow*(): CommandErrorType = errorType2(JAVA_ARGUMENT_INTEGER_LOW, JAVA_ARGUMENT_INTEGER_LOW)
proc integerTooHigh*(): CommandErrorType = errorType2(JAVA_ARGUMENT_INTEGER_BIG, JAVA_ARGUMENT_INTEGER_BIG)
proc longTooLow*(): CommandErrorType = errorType2(JAVA_ARGUMENT_LONG_LOW, JAVA_ARGUMENT_LONG_LOW)
proc longTooHigh*(): CommandErrorType = errorType2(JAVA_ARGUMENT_LONG_BIG, JAVA_ARGUMENT_LONG_BIG)
proc dispatcherUnknownCommand*(): CommandErrorType = errorType0(JAVA_COMMAND_UNKNOWN_COMMAND, BEDROCK_COMMANDS_GENERIC_UNKNOWN)
proc dispatcherUnknownArgument*(): CommandErrorType = errorType0(JAVA_COMMAND_UNKNOWN_ARGUMENT, JAVA_COMMAND_UNKNOWN_ARGUMENT)
proc dispatcherExpectedArgumentSeparator*(): CommandErrorType = errorType0(JAVA_COMMAND_EXPECTED_SEPARATOR, JAVA_COMMAND_EXPECTED_SEPARATOR)
proc dispatcherParseException*(): CommandErrorType = errorType1(JAVA_COMMAND_EXCEPTION, BEDROCK_COMMANDS_GENERIC_SYNTAX)
