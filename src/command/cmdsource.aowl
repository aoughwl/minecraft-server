## Who ran a command, and the server-side surface a command can touch.
## Port of pumpkin/src/command/mod.rs
## Port of pumpkin/src/command/context/command_source.rs
##
## Upstream reaches straight into `Server`, `World`, `Player` and `dyn EntityBase`. Those are being written by another
## worker and are hooked here instead: `CommandServer`, `CommandWorld`, `CommandPlayer` and `CommandEntity` are `ref
## object`s of `{.closure.}` fields, the port's form of a trait. The code that owns the real types builds one of each
## and fills in the fields; a nil field gives the result named on that field. Nothing in this module imports them.

import std/[options, math, times]
import ../util/vector2, ../util/vector3, ../util/uuid, ../util/permission, ../util/gamemode, ../util/difficulty
import ../util/text/textbase, ../util/text/text, ../util/text/color, ../util/text/click, ../util/text/locale
import ../util/math/[mathmod, boundingbox]
import ../generated/translation
import ../nbt/tag
import cmderrors

type
  ReturnValueKind* = enum
    rvkSuccess
    rvkFailure

  ReturnValue* = object
    ## `Success(i32)` or `Failure`.
    kind*: ReturnValueKind
    value*: int32

  ReturnValueCallback* = proc(value: ReturnValue) {.closure.}

  ResultValueTaker* = object
    callbacks*: seq[ReturnValueCallback]

  EntityAnchor* = enum
    eaFeet
    eaEyes

  PluginMetadata* = object
    ## The fields `/plugins` reads from `server.plugin_manager.active_plugins()`.
    name*: string
    version*: string
    authors*: seq[string]
    description*: string

  CmdListEntry* = object
    ## An entry of the ban lists, the operator list or the whitelist: `BannedPlayerEntry`, `BannedIpEntry`, `Op`,
    ## `WhitelistEntry`. `ip` holds the canonical text of an `IpAddr`.
    id*: Uuid
    name*: string
    source*: string
    reason*: string
    ip*: string
    level*: PermissionLvl

  CmdSpawn* = object
    ## `level_info.spawn_*`.
    x*, y*, z*: int32
    yaw*, pitch*: float32

  CmdGameRuleValue* = object
    ## `GameRuleValue`.
    isInt*: bool
    intValue*: int64
    boolValue*: bool

  CmdTitleMode* = enum
    ctmTitle
    ctmSubTitle
    ctmActionBar

  CmdItemStack* = object
    ## An `ItemStack` by name. The patch is component name and SNBT value, for `read_data` on the owner's side.
    itemKey*: string
    count*: int32
    patchNames*: seq[string]
    patchValues*: seq[NbtTag]

  CmdItemSlot* = ref object
    ## One `Arc<Mutex<ItemStack>>` of an inventory.
    getStack*: proc(): CmdItemStack {.closure.}
    setStack*: proc(stack: CmdItemStack) {.closure.}
    isEmpty*: proc(): bool {.closure.}

  CmdTeamInfo* = object
    ## A scoreboard team, as `/teammsg` and `/team` read it.
    name*: string
    displayName*: TextComponent
    color*: NamedColor
    players*: seq[string]
    options*: int8                  ## bit 0 friendly fire, bit 1 see friendly invisibles.
    nametagVisibility*: int32       ## `NameTagVisibility` as its ordinal.
    collisionRule*: int32           ## `CollisionRule` as its ordinal.
    playerPrefix*: TextComponent
    playerSuffix*: TextComponent

  CmdObjective* = object
    ## A scoreboard objective, as `/scoreboard` reads it.
    name*: string
    displayName*: TextComponent
    criterion*: string

  CmdScore* = object
    value*: int32
    locked*: bool

  CmdBorder* = object
    ## `Worldborder`'s fields `/worldborder` reads.
    centerX*, centerZ*: float64
    newDiameter*: float64
    warningBlocks*: int32
    warningTime*: int32
    damagePerBlock*: float32
    buffer*: float32

  CmdBossbar* = object
    ## `CustomBossbar` for `/bossbar`.
    namespace*: string
    title*: TextComponent
    max*, value*: int32
    visible*: bool
    color*: int32                   ## `BossbarColor` as its ordinal.
    division*: int32                ## `BossbarDivisions` as its ordinal.
    players*: seq[Uuid]

  CmdBossbarStatus* = object
    ## `Result<(), BossbarUpdateError>`: kind 0 is `Ok`, 1 `InvalidResourceLocation(location)`, 2 `NoChanges(what, detail)`.
    kind*: int32
    location*: string
    what*: string
    detail*: string

  CmdGenParams* = object
    ## What `ProtoChunk::new(cx, cz, &world_gen)` and `GenerationSettings::from_dimension` read from the world's generator.
    seed*: int64
    defaultBlock*: uint32
    biomeMixerSeed*: int64
    logicalHeight*: int32
    minY*: int32
    seaLevel*: int32

  CmdGameProfile* = object
    ## The fields of `crate::net::GameProfile` commands read.
    id*: Uuid
    name*: string

  CommandEntity* = ref object
    ## `Arc<dyn EntityBase>`.
    uuid*: Uuid
    entityId*: int32
    entityTypeId*: string                                  ## Registry id, `minecraft:player`.
    player*: nil CommandPlayer                             ## `get_player()`.
    getName*: proc(): TextComponent {.closure.}
    getDisplayName*: proc(): TextComponent {.closure.}
    getPos*: proc(): Vector3[float64] {.closure.}
    getRotation*: proc(): Vector2[float32] {.closure.}     ## (pitch, yaw) as `CommandSource.rotation` holds it.
    getEyeHeight*: proc(): float64 {.closure.}
    getWorld*: proc(): nil CommandWorld {.closure.}
    isAlive*: proc(): bool {.closure.}
    remove*: proc() {.closure.}                            ## `kill` on a non-living entity.
    kill*: proc() {.closure.}
    teleport*: proc(pos: Vector3[float64]; yaw, pitch: Option[float32]; world: CommandWorld) {.closure.}
    getScoreboardTags*: proc(): seq[string] {.closure.}
    addScoreboardTag*: proc(tag: string): bool {.closure.}
    removeScoreboardTag*: proc(tag: string): bool {.closure.}
    getBoundingBox*: proc(): BoundingBox {.closure.}
    getCustomName*: proc(): Option[TextComponent] {.closure.}
    entityTypeName*: string                                ## `entity_type.resource_name`, `creeper`.
    damageWithContext*: proc(amount: float32; damageType: string; location: Option[Vector3[float64]];
                             source, cause: nil CommandEntity): bool {.closure.}
    writeNbt*: proc(): NbtCompound {.closure.}             ## `write_nbt` on an empty compound.
    readNbt*: proc(nbt: NbtCompound) {.closure.}
    getVehicle*: proc(): nil CommandEntity {.closure.}      ## `vehicle`; nil when not riding.
    addPassenger*: proc(passenger: CommandEntity) {.closure.}  ## `add_passenger(self, passenger)` on the vehicle.
    removePassenger*: proc(entityId: int32) {.closure.}     ## `remove_passenger` on the vehicle.
    isLiving*: bool                                         ## `get_living_entity` is `Some`: `/attribute` works on it.
    hasAttribute*: proc(id: uint8): bool {.closure.}        ## `living.attributes.contains_key`.
    getAttributeBase*: proc(id: uint8): float64 {.closure.}
    getAttributeValue*: proc(id: uint8): float64 {.closure.}
    setAttributeBase*: proc(id: uint8; value: float64) {.closure.}
    getAttributeModifier*: proc(id: uint8; modifierId: string; amount: var float64): bool {.closure.}  ## False without that modifier.
    addAttributeModifier*: proc(id: uint8; modifierId: string; amount: float64; operation: int32): bool {.closure.}  ## False when the id is present; 0 add, 1 multiply base, 2 multiply total.
    removeAttributeModifier*: proc(id: uint8; modifierId: string): bool {.closure.}  ## False without that modifier.
    sendAttributeUpdate*: proc(id: uint8) {.closure.}       ## `send_attribute_updates_for_living` for the one attribute.
    setEquipment*: proc(slot: string; stack: CmdItemStack): bool {.closure.}  ## `/item` on a living entity: `mainhand`, `offhand`, `feet`, `legs`, `chest`, `head`, `body`, `saddle`; false when it has no such slot.
    getLootDrops*: proc(found: var bool): seq[CmdItemStack] {.closure.}  ## `entity_type.loot_table.get_loot` at the world's time; `found` is false for a type with no loot table.

  CommandPlayer* = ref object
    ## `Arc<Player>`.
    entity*: CommandEntity
    gameProfile*: CmdGameProfile
    getPermissionLvl*: proc(): PermissionLvl {.closure.}
    setPermissionLvl*: proc(lvl: PermissionLvl) {.closure.}
    hasPermission*: proc(node: string): bool {.closure.}
    sendSystemMessage*: proc(message: TextComponent) {.closure.}
    getLocale*: proc(): Locale {.closure.}
    getGameMode*: proc(): GameMode {.closure.}
    setGameMode*: proc(mode: GameMode): bool {.closure.}   ## Whether it changed; `set_gamemode`.
    getExperienceLevel*: proc(): int32 {.closure.}
    isAdvancementDone*: proc(id: string; exists: var bool): bool {.closure.}
    isBedrock*: bool                                       ## `client` is `ClientPlatform::Bedrock`.
    kick*: proc(reason: TextComponent) {.closure.}         ## `kick(DisconnectReason::Kicked, reason)`.
    sendMsgOutgoing*: proc(message, sender, target: TextComponent) {.closure.} ## `send_message(.., MSG_COMMAND_OUTGOING, ..)`.
    sendMsgIncoming*: proc(message, sender, target: TextComponent) {.closure.} ## `send_message(.., MSG_COMMAND_INCOMING, ..)`.
    getIp*: proc(): string {.closure.}                     ## `client.address().ip()` as canonical text.
    transfer*: proc(host: string; port: int32) {.closure.} ## JavaCTransfer or BedrockCTransfer.
    clearTitle*: proc(reset: bool) {.closure.}             ## CClearTitle.
    showTitle*: proc(text: TextComponent; mode: CmdTitleMode) {.closure.}
    sendTitleAnimation*: proc(fadeIn, stay, fadeOut: int32) {.closure.}
    stopSound*: proc(sound, category: Option[string]) {.closure.}  ## The sound as `minecraft:name`, the category's name.
    playSound*: proc(soundName, category: string; pos: Vector3[float64]; volume, pitch: float32; seed: float64) {.closure.}
    setRespawnPoint*: proc(dimension: string; x, y, z: int32; yaw, pitch: float32; force: bool) {.closure.}
    getEffectAmplifier*: proc(effect: string): int32 {.closure.}  ## -1 without the effect; `has_effect`, `get_effect`.
    addEffect*: proc(effect: string; duration: int32; amplifier: uint8; showParticles: bool) {.closure.}
    removeEffect*: proc(effect: string) {.closure.}
    removeAllEffects*: proc(): bool {.closure.}
    getExperiencePoints*: proc(): int32 {.closure.}
    addExperienceLevels*: proc(amount: int32) {.closure.}
    setExperienceLevel*: proc(amount: int32) {.closure.}   ## `set_experience_level(amount, true)`.
    addExperiencePoints*: proc(amount: int32) {.closure.}
    setExperiencePoints*: proc(amount: int32) {.closure.}
    insertOrDropStack*: proc(stack: CmdItemStack) {.closure.}  ## `insert_stack_anywhere`, then `drop_item` for the rest.
    getHeldStack*: proc(): CmdItemStack {.closure.}        ## Empty `itemKey` when the hand is empty.
    heldItemAccepts*: proc(enchantment: string): bool {.closure.}  ## `can_enchant` and `is_enchantment_compatible`.
    heldItemCanHold*: proc(enchantment: string): bool {.closure.}  ## `enchantment.can_enchant(item.item)`.
    enchantHeld*: proc(enchantment: string; level: int32) {.closure.}
    sendRecipeBook*: proc(replace: bool; ids: seq[string]) {.closure.}  ## `CRecipeBookAdd` with the dynamic recipes whose `get_recipe_id` is in `ids`.
    getInventorySlots*: proc(): seq[CmdItemSlot] {.closure.}  ## `main_inventory`, then `entity_equipment`.
    getSelectedSlot*: proc(): int32 {.closure.}            ## `inventory.get_selected_slot`.
    getEnderChestSlots*: proc(): seq[CmdItemSlot] {.closure.}  ## `ender_chest_inventory`.
    sendEquipmentChange*: proc(slot: string; stack: CmdItemStack) {.closure.}  ## `send_equipment_changes`, the slot named as in `setEquipment`.
    setCameraTarget*: proc(entityId: int32) {.closure.}    ## `camera_target_id` and CSetCamera; the player's own id stops it.
    advancementPerform*: proc(grant: bool; ids: seq[string]; showAdvancement: bool): int32 {.closure.}  ## `Action::perform` on this player: how many of the advancements (by `namespace:path`) changed.
    advancementPerformCriterion*: proc(grant: bool; id, criterion: string): bool {.closure.}  ## `Action::perform_criterion`.
    showDialog*: proc(dialog: NbtTag) {.closure.}          ## `CPlayShowDialog` with `IdOr::Value(DialogNBT::from_nbt(compound))`.
    clearDialog*: proc() {.closure.}                       ## `CPlayClearDialog`.

  CommandWorld* = ref object
    ## `Arc<World>`.
    dimensionName*: string
    getSeed*: proc(): int64 {.closure.}
    setSaveEnabled*: proc(enabled: bool): bool {.closure.} ## Whether the value changed; `Level.save_enabled.swap`.
    sendCommandFeedback*: proc(): bool {.closure.}         ## `level_info.game_rules.send_command_feedback`.
    commandBlockOutput*: proc(): bool {.closure.}          ## `level_info.game_rules.command_block_output`.
    getSpawnPoint*: proc(): Vector3[int32] {.closure.}
    getEntities*: proc(): seq[CommandEntity] {.closure.}
    getPlayers*: proc(): seq[CommandPlayer] {.closure.}
    isChunkLoaded*: proc(x, z: int32): bool {.closure.}
    isInBuildLimit*: proc(x, y, z: int32): bool {.closure.}
    getEntityByUuid*: proc(id: Uuid): nil CommandEntity {.closure.}
    getPlayerByUuid*: proc(id: Uuid): nil CommandPlayer {.closure.}
    getEntitiesInBox*: proc(box: BoundingBox): seq[CommandEntity] {.closure.} ## `extend_entities_in_box_where`.
    teamHasPlayer*: proc(team, playerName: string): bool {.closure.}          ## Scoreboard teams.
    getScore*: proc(playerName, objective: string): int32 {.closure.}         ## 0 when unset.
    getTeamNames*: proc(): seq[string] {.closure.}
    getTeamOf*: proc(playerName: string; team: var CmdTeamInfo): bool {.closure.}
    getObjectiveNames*: proc(): seq[string] {.closure.}
    getObjective*: proc(name: string; res: var CmdObjective): bool {.closure.}
    addObjective*: proc(name: string; displayName: TextComponent; criterion: string) {.closure.} ## RenderType::Integer, no number format.
    getScoreEntry*: proc(entity, objective: string; res: var CmdScore): bool {.closure.}
    setScoreEntry*: proc(entity, objective: string; value: int32; locked: bool) {.closure.} ## `update_score`, keeping the other fields.
    getTeam*: proc(name: string; res: var CmdTeamInfo): bool {.closure.}
    addTeam*: proc(team: CmdTeamInfo) {.closure.}
    updateTeam*: proc(team: CmdTeamInfo) {.closure.}
    removeTeam*: proc(name: string) {.closure.}
    addPlayerToTeam*: proc(team, player: string) {.closure.}
    removePlayerFromTeam*: proc(team, player: string) {.closure.}
    getBorder*: proc(): CmdBorder {.closure.}
    setBorderCenter*: proc(x, z: float64) {.closure.}
    setBorderDiameter*: proc(diameter: float64; hasSpeed: bool; speed: int64) {.closure.}
    setBorderWarningDelay*: proc(delay: int32) {.closure.}
    setBorderWarningDistance*: proc(distance: int32) {.closure.}
    setBorderDamageAmount*: proc(amount: float32) {.closure.}  ## Sets the field alone, as upstream's command does.
    setBorderDamageBuffer*: proc(buffer: float32) {.closure.}
    getForcedChunks*: proc(): seq[Vector2[int32]] {.closure.}  ## `forced_chunks`, as chunk coordinates (x, z).
    setForcedChunk*: proc(x, z: int32; forced: bool) {.closure.}  ## Inserts or removes one, then `update_active_chunks`.
    clearForcedChunks*: proc(): int32 {.closure.}              ## `clear`, then `update_active_chunks`; the count removed.
    requestSave*: proc() {.closure.}                       ## `level.should_save = true; level_channel.notify()`.
    setWeatherParameters*: proc(clearTime, rainTime: int32; raining, thundering: bool) {.closure.}
    queryDaytime*: proc(): int64 {.closure.}               ## `level_time.query_daytime`.
    queryGametime*: proc(): int64 {.closure.}
    queryDay*: proc(): int64 {.closure.}
    addTime*: proc(ticks: int64) {.closure.}               ## `level_time.add_time`, then `send_time`.
    setTime*: proc(ticks: int64) {.closure.}               ## `level_time.set_time`, then `send_time`.
    spawnParticle*: proc(pos: Vector3[float64]; delta: Vector3[float32]; speed: float32; count: int32; particle: string) {.closure.}
    spawnEntity*: proc(entityType: string; pos: Vector3[float64]): TextComponent {.closure.} ## `from_type`, `spawn_entity`; the display name.
    setBlockState*: proc(x, y, z: int32; stateId: uint16; flags: uint32) {.closure.}
    breakBlock*: proc(x, y, z: int32; flags: uint32) {.closure.}
    getBlockStateId*: proc(x, y, z: int32): uint16 {.closure.}
    isAirState*: proc(stateId: uint16): bool {.closure.}
    getBlockId*: proc(x, y, z: int32): int {.closure.}
    updateNeighbors*: proc(x, y, z: int32) {.closure.}
    getMinY*: proc(): int32 {.closure.}                    ## `min_y`.
    getGenParams*: proc(): CmdGenParams {.closure.}        ## The generator's parameters, for `/place`'s synthetic chunks.
    fillBiomeChunk*: proc(chunkX, chunkZ: int32; cells: seq[Vector3[int32]]; target: int32; hasReplace: bool; replace: int32): int32 {.closure.}
      ## The per-chunk half of `/fillbiome`: each cell is (x, y, z) relative to the chunk's biome grid, y counted from `min_y >> 2`.
      ## Sets the biome where `replace` matches (or everywhere), broadcasts the chunk when something changed, returns how many.
    getSurfaceHeight*: proc(x, z: int32): int32 {.closure.}  ## `get_heightmap_height_async(WorldSurface, x, z)`.
    isLiquidAt*: proc(x, y, z: int32): bool {.closure.}    ## `get_block_state_async(..).is_liquid()`.
    getBlockContainer*: proc(x, y, z: int32): seq[CmdItemSlot] {.closure.}  ## The slots of the block entity's inventory; empty without one.
    dropStack*: proc(x, y, z: int32; stack: CmdItemStack) {.closure.}  ## `drop_stack`: an item entity at the block.
    generateBlockLoot*: proc(x, y, z: int32; hasTool: bool; tool: string; found: var bool): seq[CmdItemStack] {.closure.}
      ## `/loot mine`: `block.loot_table.get_loot` with the block state at the position and the tool; `found` is false for a block with no table.

  CommandServer* = ref object
    ## `Arc<Server>`.
    permissionRegistry*: nil PermissionRegistry
    opPermissionLevel*: PermissionLvl
    getAllPlayers*: proc(): seq[CommandPlayer] {.closure.}
    getPlayerByName*: proc(name: string): nil CommandPlayer {.closure.}
    getPlayerByUuid*: proc(id: Uuid): nil CommandPlayer {.closure.}
    getWorlds*: proc(): seq[CommandWorld] {.closure.}
    getOverworld*: proc(): nil CommandWorld {.closure.}
    broadcastSystemMessage*: proc(message: TextComponent) {.closure.}
    sendCommandFeedback*: proc(): bool {.closure.}         ## `level_info.game_rules.send_command_feedback`.
    getRandomPlayer*: proc(): nil CommandPlayer {.closure.}
    selectPlayers*: proc(selector: TargetSelector; sender: CommandSender): seq[CommandPlayer] {.closure.}
    selectEntities*: proc(selector: TargetSelector; sender: CommandSender): seq[CommandEntity] {.closure.}
    stopServer*: proc() {.closure.}                        ## `crate::stop_server`.
    getTps*: proc(): float64 {.closure.}
    getRecipeIds*: proc(): seq[string] {.closure.}         ## `get_recipe_id` of each of `recipe_manager`'s dynamic recipes, in order.
    getMspt*: proc(): float64 {.closure.}
    getAverageTickTimeNanos*: proc(): int64 {.closure.}
    getTickTimesNanos*: proc(): seq[int64] {.closure.}     ## `get_tick_times_nanos_copy`, the filled prefix only (`min(tick_count, 100)` entries).
    getTickRate*: proc(): float32 {.closure.}              ## `tick_rate_manager.tickrate`.
    getNanosecondsPerTick*: proc(): int64 {.closure.}
    isTickFrozen*: proc(): bool {.closure.}
    isTickSprinting*: proc(): bool {.closure.}
    setTickRate*: proc(rate: float32) {.closure.}
    setTickFrozen*: proc(frozen: bool) {.closure.}
    stepGameIfPaused*: proc(ticks: int32): bool {.closure.}
    stopTickStepping*: proc(): bool {.closure.}
    requestGameToSprint*: proc(ticks: int64): bool {.closure.}
    stopTickSprinting*: proc(): bool {.closure.}
    bossbarGet*: proc(location: string; res: var CmdBossbar): bool {.closure.}
    bossbarAll*: proc(): seq[CmdBossbar] {.closure.}
    bossbarCreate*: proc(namespace: string; title: TextComponent) {.closure.}
    bossbarRemove*: proc(location: string): CmdBossbarStatus {.closure.}
    bossbarSetHealth*: proc(location: string; max, value: int32): CmdBossbarStatus {.closure.}
    bossbarSetVisible*: proc(location: string; visible: bool): CmdBossbarStatus {.closure.}
    bossbarSetName*: proc(location: string; title: TextComponent): CmdBossbarStatus {.closure.}
    bossbarSetColor*: proc(location: string; color: int32): CmdBossbarStatus {.closure.}
    bossbarSetDivision*: proc(location: string; division: int32): CmdBossbarStatus {.closure.}
    bossbarSetPlayers*: proc(location: string; players: seq[Uuid]): CmdBossbarStatus {.closure.}
    configuredTps*: proc(): float64 {.closure.}            ## `basic_config.tps`.
    javaMaxPlayers*: proc(): int32 {.closure.}             ## `advanced_config.networking.java.max_players`.
    bedrockMaxPlayers*: proc(): int32 {.closure.}          ## `advanced_config.networking.bedrock.max_players`.
    savePlayerData*: proc(): bool {.closure.}              ## `player_data_storage.save_all_players`; false on error.
    saveAdvancements*: proc(): bool {.closure.}            ## `advancement_manager.save_all_players`; false on error.
    getDifficulty*: proc(): Difficulty {.closure.}
    setDifficulty*: proc(d: Difficulty) {.closure.}        ## `set_difficulty(d, true)`.
    setPlayerIdleTimeout*: proc(minutes: int32) {.closure.}
    activePlugins*: proc(): seq[PluginMetadata] {.closure.}
    fetchContributors*: proc(): seq[string] {.closure.}  ## The logins of the GitHub contributors list (`/pumpkin`); a worker's job, nil answers none.
    forceGamemode*: proc(): bool {.closure.}               ## `basic_config.force_gamemode`.
    setDefaultGamemode*: proc(mode: GameMode) {.closure.}
    broadcastSay*: proc(message, sender: TextComponent) {.closure.}  ## `broadcast_message(.., SAY_COMMAND, None)`.
    broadcastEmote*: proc(message, sender: TextComponent) {.closure.} ## `broadcast_message(.., EMOTE_COMMAND, None)`.
    reloadDatapacks*: proc() {.closure.}
    getBannedPlayers*: proc(): seq[CmdListEntry] {.closure.}
    addBannedPlayer*: proc(entry: CmdListEntry) {.closure.}   ## Pushes and saves.
    renameBannedPlayer*: proc(id: Uuid; name: string) {.closure.} ## Renames and saves.
    removeBannedPlayer*: proc(id: Uuid): bool {.closure.}     ## Removes without saving; `saveBannedPlayers` follows.
    saveBannedPlayers*: proc() {.closure.}
    getBannedIps*: proc(): seq[CmdListEntry] {.closure.}
    addBannedIp*: proc(entry: CmdListEntry) {.closure.}
    removeBannedIp*: proc(ip: string): bool {.closure.}       ## Removes and saves.
    parseIp*: proc(text: string; canonical: var string): bool {.closure.} ## `IpAddr::from_str`, with its `to_string`.
    getPlayersByIp*: proc(ip: string): seq[CommandPlayer] {.closure.}
    getOps*: proc(): seq[CmdListEntry] {.closure.}
    putOp*: proc(entry: CmdListEntry) {.closure.}             ## Adds it, or updates the entry with its uuid.
    removeOp*: proc(id: Uuid): bool {.closure.}
    saveOps*: proc() {.closure.}
    getWhitelist*: proc(): seq[CmdListEntry] {.closure.}
    addWhitelist*: proc(entry: CmdListEntry) {.closure.}
    renameWhitelist*: proc(id: Uuid; name: string) {.closure.}
    removeWhitelist*: proc(id: Uuid): bool {.closure.}
    saveWhitelist*: proc() {.closure.}
    reloadWhitelist*: proc() {.closure.}                      ## `WhitelistConfig::load`.
    isWhitelisted*: proc(profile: CmdGameProfile): bool {.closure.}
    enforceWhitelist*: proc(): bool {.closure.}               ## `basic_config.enforce_whitelist`.
    swapWhiteList*: proc(value: bool): bool {.closure.}       ## `white_list.swap`; the previous value.
    whiteListEnabled*: proc(): bool {.closure.}
    userCacheGetByName*: proc(name: string; res: var CmdGameProfile): bool {.closure.}
    userCacheGetByUuid*: proc(id: Uuid; res: var CmdGameProfile): bool {.closure.}
    userCacheUpsert*: proc(id: Uuid; name: string) {.closure.}
    onlineMode*: proc(): bool {.closure.}                     ## `advanced_config.networking.java.online_mode`.
    lookupProfileByName*: proc(name: string; res: var CmdGameProfile): bool {.closure.}  ## Mojang lookup; a worker's job.
    offlineUuid*: proc(name: string; res: var Uuid): bool {.closure.}
    getGameRule*: proc(rule: string): CmdGameRuleValue {.closure.}
    setGameRule*: proc(rule: string; value: CmdGameRuleValue) {.closure.}
    getSpawn*: proc(): CmdSpawn {.closure.}
    setSpawn*: proc(spawn: CmdSpawn) {.closure.}
    fireSpawnChange*: proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} ## `SpawnChangeEvent`; what plugins left.
    generateChestLoot*: proc(key: string; seed: int64; found: var bool): seq[CmdItemStack] {.closure.}  ## `get_chest_loot_table(key)` then `generate_chest_loot`; `found` is false for an unknown table.

  EntitySelectorType* = enum
    estSource
    estNearestPlayer
    estNearestEntity
    estRandomPlayer
    estAllPlayers
    estAllEntities
    estNamedPlayer
    estUuid

  EntityFilterSort* = enum
    efsArbitrary
    efsNearest
    efsFurthest
    efsRandom

  EntityFilterKind* = enum
    efkScore
    efkTag
    efkTeam
    efkName
    efkType
    efkNbt
    efkLimit
    efkSort

  EntityFilter* = object
    ## The filters `EntityFilter::from_str` can produce; upstream parses none of the others.
    kind*: EntityFilterKind
    negate*: bool
    value*: string          ## Tag, team, name, or the entity type's resource name.
    limit*: uint64
    sort*: EntityFilterSort

  TargetSelector* = object
    ## pumpkin/src/command/args/entities.rs.
    selectorType*: EntitySelectorType
    name*: string
    uuid*: Uuid
    conditions*: seq[EntityFilter]

  CommandBlockHandle* = ref object
    ## `Arc<CommandBlockEntity>`.
    setLastOutput*: proc(text: string) {.closure.}
    setSuccessCount*: proc(count: uint32) {.closure.}
    getPosition*: proc(): Vector3[int32] {.closure.}
    getRotationY*: proc(): Option[float32] {.closure.}     ## `None` when the block is no longer a command block.

  CommandSenderKind* = enum
    cskRcon
    cskConsole
    cskPlayer
    cskCommandBlock
    cskDummy

  RconBuffer* = ref object
    lines*: seq[string]

  CommandSender* = object
    ## `Rcon` buffer, `Console`, `Player`, `CommandBlock` with its world, `Dummy`.
    case kind*: CommandSenderKind
    of cskRcon:
      rcon*: RconBuffer
    of cskPlayer:
      player*: CommandPlayer
    of cskCommandBlock:
      commandBlock*: CommandBlockHandle
      commandBlockWorld*: CommandWorld
    of cskConsole, cskDummy:
      discard

  CommandSource* = ref object
    output*: CommandSender
    world*: nil CommandWorld
    entity*: nil CommandEntity
    position*: Vector3[float64]
    rotation*: Vector2[float32]
    name*: string
    displayName*: TextComponent
    server*: nil CommandServer
    silent*: bool
    commandResultTaker*: ResultValueTaker
    entityAnchor*: EntityAnchor

const
  ## The `BlockFlags` commands pass, as bits.
  cbfForceState* = 1'u32
  cbfNotifyNeighbors* = 2'u32
  cbfSkipBlockAddedCallback* = 4'u32
  cbfSkipDrops* = 8'u32

var broadcastConsoleToOps = true ## BROADCAST_CONSOLE_TO_OPS.
var consoleWriter: proc(line: string) {.closure.}

proc setBroadcastConsoleToOps*(value: bool) =
  broadcastConsoleToOps = value

proc setConsoleWriter*(writer: proc(line: string) {.closure.}) =
  ## Where `Console` output goes: upstream `println!`s. Unset writes nothing, so a unit test stays quiet.
  consoleWriter = writer

proc requiresPlayer*(): CommandErrorType = errorType0(JAVA_PERMISSIONS_REQUIRES_PLAYER, JAVA_PERMISSIONS_REQUIRES_PLAYER)
proc requiresEntity*(): CommandErrorType = errorType0(JAVA_PERMISSIONS_REQUIRES_ENTITY, JAVA_PERMISSIONS_REQUIRES_ENTITY)

# ---- ReturnValue / ResultValueTaker -------------------------------------------------------------------------------

proc returnSuccess*(value: int32): ReturnValue = ReturnValue(kind: rvkSuccess, value: value)
proc returnFailure*(): ReturnValue = ReturnValue(kind: rvkFailure, value: 0'i32)
proc successValue*(v: ReturnValue): bool = v.kind == rvkSuccess
proc resultValue*(v: ReturnValue): int32 = (if v.kind == rvkSuccess: v.value else: 0'i32)

proc merge*(a, b: ResultValueTaker): ResultValueTaker =
  var list: seq[ReturnValueCallback] = @[]
  var i = 0
  while i < a.callbacks.len:
    list.add(a.callbacks[i])
    inc i
  i = 0
  while i < b.callbacks.len:
    list.add(b.callbacks[i])
    inc i
  ResultValueTaker(callbacks: list)

proc call*(t: ResultValueTaker; value: ReturnValue) =
  var i = 0
  while i < t.callbacks.len:
    let cb = t.callbacks[i]
    cb(value)
    inc i

# ---- CommandSender ------------------------------------------------------------------------------------------------

proc senderConsole*(): CommandSender = CommandSender(kind: cskConsole)
proc senderDummy*(): CommandSender = CommandSender(kind: cskDummy)
proc senderRcon*(buffer: RconBuffer): CommandSender = CommandSender(kind: cskRcon, rcon: buffer)
proc senderPlayer*(player: CommandPlayer): CommandSender = CommandSender(kind: cskPlayer, player: player)
proc senderCommandBlock*(block0: CommandBlockHandle; world: CommandWorld): CommandSender =
  CommandSender(kind: cskCommandBlock, commandBlock: block0, commandBlockWorld: world)

proc displayText*(s: CommandSender): string =
  ## `impl Display for CommandSender`.
  case s.kind
  of cskConsole: "Server"
  of cskRcon: "Rcon"
  of cskPlayer: s.player.gameProfile.name
  of cskCommandBlock: "@"
  of cskDummy: ""

proc twoDigits(v: int): string =
  if v < 10: "0" & $v else: $v

proc nowHms(): string =
  ## `[hour]:[minute]:[second]` of `now_utc`.
  let t = utc(getTime())
  twoDigits(ord(t.hour)) & ":" & twoDigits(ord(t.minute)) & ":" & twoDigits(ord(t.second))

proc sendMessage*(s: CommandSender; message: TextComponent) =
  case s.kind
  of cskConsole:
    if consoleWriter != nil:
      consoleWriter(toPrettyConsole(message))
  of cskPlayer:
    if s.player.sendSystemMessage != nil:
      s.player.sendSystemMessage(message)
  of cskRcon:
    s.rcon.lines.add(toPrettyConsole(message))
  of cskCommandBlock:
    if s.commandBlock.setLastOutput != nil:
      s.commandBlock.setLastOutput("[" & nowHms() & "] " & getText(message))
  of cskDummy:
    discard

proc setSuccessCount*(s: CommandSender; count: uint32) =
  if s.kind == cskCommandBlock and s.commandBlock.setSuccessCount != nil:
    s.commandBlock.setSuccessCount(count)

proc isPlayer*(s: CommandSender): bool = s.kind == cskPlayer
proc isConsole*(s: CommandSender): bool = s.kind == cskConsole

proc permissionLvl*(s: CommandSender): PermissionLvl =
  case s.kind
  of cskConsole, cskRcon: Four
  of cskPlayer: (if s.player.getPermissionLvl != nil: s.player.getPermissionLvl() else: Zero)
  of cskCommandBlock, cskDummy: Two

proc hasPermissionLvl*(s: CommandSender; lvl: PermissionLvl): bool =
  case s.kind
  of cskConsole, cskRcon: true
  of cskPlayer: ord(permissionLvl(s)) >= ord(lvl)
  of cskCommandBlock, cskDummy: ord(Two) >= ord(lvl)

proc hasPermission*(s: CommandSender; server: nil CommandServer; node: string): bool =
  case s.kind
  of cskConsole, cskRcon:
    true # Console and RCON always have all permissions
  of cskPlayer:
    s.player.hasPermission != nil and s.player.hasPermission(node)
  of cskCommandBlock, cskDummy:
    if server == nil:
      return false
    let registry = server.permissionRegistry
    if registry == nil:
      return false
    let (found, p) = getPermission(registry, node)
    if not found:
      return false
    case p.default.kind
    of pdkAllow: true
    of pdkDeny: false
    of pdkOp: ord(p.default.level) <= ord(Two)

var gSourceOverride*: nil CommandSource = nil
  ## DEVIATION from upstream: set while `/execute ... run` hands a command to the fallback dispatcher, whose commands see
  ## only a `CommandSender`. `position`, `world` and `intoSource` answer with this source's, so `in`, `positioned`, `at`
  ## and `as` reach commands that live there.

proc position*(s: CommandSender; pos: var Vector3[float64]): bool =
  ## `position()`; false for `None`.
  let o = gSourceOverride
  if o != nil:
    pos = o.position
    return true
  case s.kind
  of cskConsole, cskRcon, cskDummy:
    false
  of cskPlayer:
    pos = s.player.entity.getPos()
    true
  of cskCommandBlock:
    let p = s.commandBlock.getPosition()
    pos = Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 0.5, z: float64(p.z) + 0.5)
    true

proc world*(s: CommandSender): nil CommandWorld =
  let o = gSourceOverride
  if o != nil:
    let ow = o.world
    if ow != nil:
      return ow
  if s.kind == cskPlayer:
    return s.player.entity.getWorld()
  if s.kind == cskCommandBlock:
    return s.commandBlockWorld
  nil

proc worldOrFirst*(s: CommandSender; server: CommandServer): nil CommandWorld =
  let w = world(s)
  if w != nil:
    return w
  if server.getWorlds != nil:
    let all = server.getWorlds()
    if all.len > 0:
      return all[0]
  nil

proc getLocale*(s: CommandSender): Locale =
  if s.kind == cskPlayer and s.player.getLocale != nil:
    s.player.getLocale()
  else:
    lcEnUs

proc shouldReceiveFeedback*(s: CommandSender): bool =
  case s.kind
  of cskCommandBlock:
    s.commandBlockWorld.sendCommandFeedback != nil and s.commandBlockWorld.sendCommandFeedback()
  of cskPlayer:
    let w = s.player.entity.getWorld()
    if w == nil:
      return false
    w.sendCommandFeedback != nil and w.sendCommandFeedback()
  of cskConsole, cskRcon:
    true
  of cskDummy:
    false

proc shouldBroadcastConsoleToOps*(s: CommandSender): bool =
  case s.kind
  of cskCommandBlock:
    s.commandBlockWorld.commandBlockOutput != nil and s.commandBlockWorld.commandBlockOutput()
  of cskPlayer:
    true
  of cskConsole, cskRcon:
    broadcastConsoleToOps
  of cskDummy:
    false

proc shouldTrackOutput*(s: CommandSender): bool =
  s.kind != cskDummy

# ---- CommandSource ------------------------------------------------------------------------------------------------

proc clone*(s: CommandSource): CommandSource =
  CommandSource(output: s.output, world: s.world, entity: s.entity, position: s.position, rotation: s.rotation,
    name: s.name, displayName: s.displayName, server: s.server, silent: s.silent,
    commandResultTaker: s.commandResultTaker, entityAnchor: s.entityAnchor)

proc dummySource*(): CommandSource =
  CommandSource(output: senderDummy(), world: nil, entity: nil,
    position: Vector3[float64](x: 0.0, y: 0.0, z: 0.0), rotation: Vector2[float32](x: 0.0'f32, y: 0.0'f32),
    name: "", displayName: empty(), server: nil, silent: false,
    commandResultTaker: ResultValueTaker(callbacks: @[]), entityAnchor: eaFeet)

proc newCommandSource*(output: CommandSender; world: nil CommandWorld; entity: nil CommandEntity;
                       position: Vector3[float64]; rotation: Vector2[float32]; name: string;
                       displayName: TextComponent; server: CommandServer): CommandSource =
  CommandSource(output: output, world: world, entity: entity, position: position, rotation: rotation, name: name,
    displayName: displayName, server: server, silent: false,
    commandResultTaker: ResultValueTaker(callbacks: @[]), entityAnchor: eaFeet)

proc withOutput*(s: CommandSource; output: CommandSender): CommandSource =
  result = clone(s)
  result.output = output

proc withWorld*(s: CommandSource; world: CommandWorld): CommandSource =
  ## Upstream sets `silent: true` here; kept.
  result = clone(s)
  result.world = world
  result.silent = true

proc withEntity*(s: CommandSource; entity: CommandEntity): CommandSource =
  result = clone(s)
  result.name = getText(entity.getName())
  result.displayName = entity.getDisplayName()
  result.entity = entity

proc withPosition*(s: CommandSource; position: Vector3[float64]): CommandSource =
  result = clone(s)
  result.position = position

proc withRotation*(s: CommandSource; rotation: Vector2[float32]): CommandSource =
  result = clone(s)
  result.rotation = rotation

proc withCommandResultTaker*(s: CommandSource; taker: ResultValueTaker): CommandSource =
  result = clone(s)
  result.commandResultTaker = taker

proc mergeCommandResultTaker*(s: CommandSource; taker: ResultValueTaker): CommandSource =
  withCommandResultTaker(s, merge(s.commandResultTaker, taker))

proc withSilent*(s: CommandSource): CommandSource =
  result = clone(s)
  result.silent = true

proc withEntityAnchor*(s: CommandSource; anchor: EntityAnchor): CommandSource =
  ## Upstream sets `silent: true` here; kept.
  result = clone(s)
  result.silent = true
  result.entityAnchor = anchor

proc entityAnchorFromId*(id: string; anchor: var EntityAnchor): bool =
  if id == "feet":
    anchor = eaFeet
    true
  elif id == "eyes":
    anchor = eaEyes
    true
  else:
    false

proc entityAnchorId*(a: EntityAnchor): string =
  case a
  of eaFeet: "feet"
  of eaEyes: "eyes"

proc positionAtEntity*(a: EntityAnchor; entity: CommandEntity): Vector3[float64] =
  let pos = entity.getPos()
  case a
  of eaFeet: pos
  of eaEyes: Vector3[float64](x: pos.x, y: pos.y + entity.getEyeHeight(), z: pos.z)

proc positionAtSource*(a: EntityAnchor; s: CommandSource): Vector3[float64] =
  let e = s.entity
  if e == nil:
    s.position
  else:
    positionAtEntity(a, e)

proc withLookingAtPos*(s: CommandSource; pos: Vector3[float64]): CommandSource =
  let sourcePos = positionAtSource(s.entityAnchor, s)
  let delta = sub(pos, sourcePos)
  let horizontalLen = horizontalLength(delta)
  let pitch = -radToDeg(arctan2(delta.y, horizontalLen))
  let yaw = radToDeg(arctan2(delta.z, delta.x)) - 90.0
  withRotation(s, Vector2[float32](x: wrapDegrees(float32(pitch)), y: wrapDegrees(float32(yaw))))

proc withLookingAtEntity*(s: CommandSource; entity: CommandEntity; anchor: EntityAnchor): CommandSource =
  withLookingAtPos(s, positionAtEntity(anchor, entity))

proc entityOrErr*(s: CommandSource): CmdResult[CommandEntity] =
  let e = s.entity
  if e == nil:
    cmdFail[CommandEntity](createWithoutContext(requiresEntity()))
  else:
    cmdOk[CommandEntity](e)

proc playerOrNone*(s: CommandSource): nil CommandPlayer =
  let e = s.entity
  if e != nil:
    return e.player
  nil

proc playerOrErr*(s: CommandSource): CmdResult[CommandPlayer] =
  let p = playerOrNone(s)
  if p == nil:
    cmdFail[CommandPlayer](createWithoutContext(requiresPlayer()))
  else:
    cmdOk[CommandPlayer](p)

proc executedByPlayer*(s: CommandSource): bool = playerOrNone(s) != nil

proc sendMessage*(s: CommandSource; message: TextComponent) =
  if not s.silent:
    sendMessage(s.output, message)

proc sendToOps(s: CommandSource; message: TextComponent) =
  let msg = italic(colorNamed(translateCross("chat.type.admin", "chat.type.admin", @[s.displayName, message]), ncGray))
  let server = s.server
  if server == nil:
    return
  if server.sendCommandFeedback != nil and server.sendCommandFeedback() and server.getAllPlayers != nil:
    let allPlayers = server.getAllPlayers()
    for player in allPlayers:
      let isOutput = s.output.kind == cskPlayer and s.output.player.entity.uuid == player.entity.uuid
      if not isOutput and player.getPermissionLvl != nil and ord(player.getPermissionLvl()) >= ord(server.opPermissionLevel):
        if player.sendSystemMessage != nil:
          player.sendSystemMessage(msg)

proc sendFeedback*(s: CommandSource; message: TextComponent; broadcastToOps: bool) =
  if not s.silent:
    let shouldSendToOutput = shouldReceiveFeedback(s.output)
    let shouldSendToOps = broadcastToOps and shouldBroadcastConsoleToOps(s.output)
    if shouldSendToOutput:
      sendMessage(s.output, message)
    if shouldSendToOps:
      sendToOps(s, message)

proc sendError*(s: CommandSource; error: TextComponent) =
  if not s.silent and shouldTrackOutput(s.output):
    sendMessage(s.output, colorNamed(addChild(empty(), error), ncRed))

proc hasPermission*(s: CommandSource; permission: string): bool =
  hasPermission(s.output, s.server, permission)

proc hasPermissionFromOption*(s: CommandSource; permission: Option[string]): bool =
  if permission.isNone:
    true
  else:
    hasPermission(s, permission.unsafeGet)

proc intoSource*(s: CommandSender; server: CommandServer): CommandSource =
  let o = gSourceOverride
  if o != nil:
    return o
  let zero = Vector2[float32](x: 0.0'f32, y: 0.0'f32)
  case s.kind
  of cskRcon, cskConsole, cskDummy:
    # `get_world_and_spawn_point`.
    let world = server.getOverworld()
    var spawn = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
    if world != nil:
      let p = world.getSpawnPoint()
      spawn = Vector3[float64](x: float64(p.x), y: float64(p.y), z: float64(p.z))
    let name = displayText(s)
    newCommandSource(s, world, nil, spawn, zero, name, (if s.kind == cskDummy: empty() else: text(name)), server)
  of cskPlayer:
    let e = s.player.entity
    let dn = e.getDisplayName()
    newCommandSource(s, e.getWorld(), e, e.getPos(), e.getRotation(), getText(dn), dn, server)
  of cskCommandBlock:
    let p = s.commandBlock.getPosition()
    let yRot = s.commandBlock.getRotationY()
    let name = text("@")
    newCommandSource(s, s.commandBlockWorld, nil,
      Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 0.5, z: float64(p.z) + 0.5),
      Vector2[float32](x: 0.0'f32, y: (if yRot.isSome: yRot.unsafeGet else: 270.0'f32)), "@", name, server)
