## World and local coordinates, and the argument types built on them.
## Port of pumpkin/src/command/argument_types/coordinates/mod.rs
## Port of pumpkin/src/command/argument_types/coordinates/block_pos.rs
## Port of pumpkin/src/command/argument_types/coordinates/column_pos.rs
## Port of pumpkin/src/command/argument_types/coordinates/rotation.rs
## Port of pumpkin/src/command/argument_types/coordinates/vec3.rs

import ../util/closureset
import std/[math, options, strutils]
import ../util/text/textbase, ../util/text/text
import ../util/vector2, ../util/vector3
import ../util/math/[position, mathmod]
import ../generated/translation
import ../protocol/java/client/play/commands
import cmderrors, string_reader, suggestion, cmdsource, cmdtree

type
  WorldCoordinate* = object
    ## `Absolute(f64)` or `Relative(f64)`.
    relative*: bool
    value*: float64

  CoordinatesKind* = enum
    cokWorld
    cokLocal

  Coordinates* = object
    case kind*: CoordinatesKind
    of cokWorld:
      x*, y*, z*: WorldCoordinate
    of cokLocal:
      left*, up*, forward*: float64

  CoordinatesValue* = ref object of ArgValue
    value*: Coordinates

proc mixedTypeErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_MIXED, JAVA_ARGUMENT_POS_MIXED)
proc vec3IncompleteErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS3D_INCOMPLETE, JAVA_ARGUMENT_POS3D_INCOMPLETE)
proc columnIncompleteErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS2D_INCOMPLETE, JAVA_ARGUMENT_POS2D_INCOMPLETE)
proc rotationIncompleteErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ROTATION_INCOMPLETE, JAVA_ARGUMENT_ROTATION_INCOMPLETE)
proc notLoadedErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_UNLOADED, JAVA_ARGUMENT_POS_UNLOADED)
proc outOfWorldErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_OUTOFWORLD, JAVA_ARGUMENT_POS_OUTOFWORLD)
proc outOfBoundsErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_OUTOFBOUNDS, JAVA_ARGUMENT_POS_OUTOFBOUNDS)

proc absolute*(v: float64): WorldCoordinate = WorldCoordinate(relative: false, value: v)
proc relative*(v: float64): WorldCoordinate = WorldCoordinate(relative: true, value: v)
proc `==`*(a, b: WorldCoordinate): bool = a.relative == b.relative and a.value == b.value

proc `==`*(a, b: Coordinates): bool =
  if a.kind != b.kind:
    return false
  case a.kind
  of cokWorld: a.x == b.x and a.y == b.y and a.z == b.z
  of cokLocal: a.left == b.left and a.up == b.up and a.forward == b.forward

proc resolve*(w: WorldCoordinate; origin: float64): float64 =
  if w.relative: origin + w.value else: w.value

proc boxCoordinates*(c: Coordinates): ArgValue =
  let a: ArgValue = CoordinatesValue(value: c)
  a

proc consumeRelativeStart(r: var StringReader): bool =
  if peekIs(r, '~'):
    skip(r)
    true
  else:
    false

proc parseWorldCoordinate*(r: var StringReader; centerIntegers: bool): CmdResult[WorldCoordinate] =
  if peekIs(r, '^'):
    return cmdFail[WorldCoordinate](create(mixedTypeErrorType(), r))
  if not canReadChar(r):
    return cmdFail[WorldCoordinate](create(readerExpectedDouble(), r))
  let isRelative = consumeRelativeStart(r)
  let i = cursor(r)
  var value = 0.0
  if canReadChar(r) and not peekIs(r, ' '):
    let d = readDouble(r)
    if not d.isOk:
      return cmdFail[WorldCoordinate](d.error)
    value = d.value
  let slice = r.str[i ..< cursor(r)]
  if isRelative and slice.len == 0:
    return cmdOk[WorldCoordinate](relative(0.0))
  if '.' notin slice and not isRelative and centerIntegers:
    value += 0.5
  cmdOk[WorldCoordinate](WorldCoordinate(relative: isRelative, value: value))

proc parseWorldCoordinateInteger*(r: var StringReader): CmdResult[WorldCoordinate] =
  if peekIs(r, '^'):
    return cmdFail[WorldCoordinate](create(mixedTypeErrorType(), r))
  if not canReadChar(r):
    return cmdFail[WorldCoordinate](create(readerExpectedInt(), r))
  let isRelative = consumeRelativeStart(r)
  var value = 0.0
  if canReadChar(r) and not peekIs(r, ' '):
    if isRelative:
      let d = readDouble(r)
      if not d.isOk:
        return cmdFail[WorldCoordinate](d.error)
      value = d.value
    else:
      let n = readInt(r)
      if not n.isOk:
        return cmdFail[WorldCoordinate](n.error)
      value = float64(n.value)
  cmdOk[WorldCoordinate](WorldCoordinate(relative: isRelative, value: value))

proc expectSpace(r: var StringReader; i: int): CmdVoidResult =
  ## `check_for_space_char!`.
  if peekIs(r, ' '):
    skip(r)
    cmdOkVoid()
  else:
    setCursor(r, i)
    cmdFailVoid(create(vec3IncompleteErrorType(), r))

proc parseWorld*(r: var StringReader; centerIntegers: bool): CmdResult[Coordinates] =
  let i = cursor(r)
  let c1 = parseWorldCoordinate(r, centerIntegers)
  if not c1.isOk: return cmdFail[Coordinates](c1.error)
  let s1 = expectSpace(r, i)
  if not s1.isOk: return cmdFail[Coordinates](s1.error)
  let c2 = parseWorldCoordinate(r, false)
  if not c2.isOk: return cmdFail[Coordinates](c2.error)
  let s2 = expectSpace(r, i)
  if not s2.isOk: return cmdFail[Coordinates](s2.error)
  let c3 = parseWorldCoordinate(r, centerIntegers)
  if not c3.isOk: return cmdFail[Coordinates](c3.error)
  cmdOk[Coordinates](Coordinates(kind: cokWorld, x: c1.value, y: c2.value, z: c3.value))

proc parseWorldIntegers*(r: var StringReader): CmdResult[Coordinates] =
  let i = cursor(r)
  let c1 = parseWorldCoordinateInteger(r)
  if not c1.isOk: return cmdFail[Coordinates](c1.error)
  let s1 = expectSpace(r, i)
  if not s1.isOk: return cmdFail[Coordinates](s1.error)
  let c2 = parseWorldCoordinateInteger(r)
  if not c2.isOk: return cmdFail[Coordinates](c2.error)
  let s2 = expectSpace(r, i)
  if not s2.isOk: return cmdFail[Coordinates](s2.error)
  let c3 = parseWorldCoordinateInteger(r)
  if not c3.isOk: return cmdFail[Coordinates](c3.error)
  cmdOk[Coordinates](Coordinates(kind: cokWorld, x: c1.value, y: c2.value, z: c3.value))

proc parseLocalNumber(r: var StringReader; i: int): CmdResult[float64] =
  if not canReadChar(r):
    return cmdFail[float64](create(readerExpectedDouble(), r))
  if not peekIs(r, '^'):
    setCursor(r, i)
    return cmdFail[float64](create(mixedTypeErrorType(), r))
  skip(r)
  if canReadChar(r) and not peekIs(r, ' '):
    return readDouble(r)
  cmdOk[float64](0.0)

proc parseLocal*(r: var StringReader): CmdResult[Coordinates] =
  let i = cursor(r)
  let left = parseLocalNumber(r, i)
  if not left.isOk: return cmdFail[Coordinates](left.error)
  let s1 = expectSpace(r, i)
  if not s1.isOk: return cmdFail[Coordinates](s1.error)
  let up = parseLocalNumber(r, i)
  if not up.isOk: return cmdFail[Coordinates](up.error)
  let s2 = expectSpace(r, i)
  if not s2.isOk: return cmdFail[Coordinates](s2.error)
  let forward = parseLocalNumber(r, i)
  if not forward.isOk: return cmdFail[Coordinates](forward.error)
  cmdOk[Coordinates](Coordinates(kind: cokLocal, left: left.value, up: up.value, forward: forward.value))

proc convertLocalCoordinates(left, up, forward: float64; rotation: Vector2[float32]): Vector3[float64] =
  # Upstream converts through f32: `(yaw + 90.0).to_radians() as f64`.
  let pitch = rotation.x
  let yaw = rotation.y
  let y = float64(degToRad(yaw + 90.0'f32))
  let yCos = cos(y)
  let ySin = sin(y)
  let x = float64(degToRad(-pitch))
  let xCos = cos(x)
  let xSin = sin(x)
  let xUp = float64(degToRad(-pitch + 90.0'f32))
  let xUpCos = cos(xUp)
  let xUpSin = sin(xUp)
  let forwardVector = Vector3[float64](x: yCos * xCos, y: xSin, z: ySin * xCos)
  let upVector = Vector3[float64](x: yCos * xUpCos, y: xUpSin, z: ySin * xUpCos)
  let leftVector = cross(forwardVector, upVector) * -1.0
  Vector3[float64](
    x: forwardVector.x * forward + upVector.x * up + leftVector.x * left,
    y: forwardVector.y * forward + upVector.y * up + leftVector.y * left,
    z: forwardVector.z * forward + upVector.z * up + leftVector.z * left)

proc isRelative*(c: Coordinates; axis: Axis): bool =
  case c.kind
  of cokWorld:
    case axis
    of axisX: c.x.relative
    of axisY: c.y.relative
    of axisZ: c.z.relative
  of cokLocal:
    true

proc resolve*(c: Coordinates; source: CommandSource): Vector3[float64] =
  case c.kind
  of cokWorld:
    Vector3[float64](x: resolve(c.x, source.position.x), y: resolve(c.y, source.position.y),
      z: resolve(c.z, source.position.z))
  of cokLocal:
    add(convertLocalCoordinates(c.left, c.up, c.forward, source.rotation), positionAtSource(source.entityAnchor, source))

proc rotation*(c: Coordinates; source: CommandSource): Vector2[float32] =
  case c.kind
  of cokWorld:
    Vector2[float32](x: float32(resolve(c.x, float64(source.rotation.x))), y: float32(resolve(c.y, float64(source.rotation.y))))
  of cokLocal:
    Vector2[float32](x: 0.0'f32, y: 0.0'f32)

# ---- Argument types -----------------------------------------------------------------------------------------------

proc wrapCoords(v: CmdResult[Coordinates]): CmdResult[ArgValue] =
  if v.isOk: cmdOk[ArgValue](boxCoordinates(v.value)) else: cmdFail[ArgValue](v.error)

proc parseBlockPosArg*(r: var StringReader): CmdResult[Coordinates] =
  if peekIs(r, '^'): parseLocal(r) else: parseWorldIntegers(r)

proc parseVec3Arg*(r: var StringReader; centerIntegers: bool): CmdResult[Coordinates] =
  if peekIs(r, '^'): parseLocal(r) else: parseWorld(r, centerIntegers)

proc parseRotationArg*(r: var StringReader): CmdResult[Coordinates] =
  let i = cursor(r)
  if not canReadChar(r):
    return cmdFail[Coordinates](create(rotationIncompleteErrorType(), r))
  let y = parseWorldCoordinate(r, false)
  if not y.isOk:
    return cmdFail[Coordinates](y.error)
  if peekIs(r, ' '):
    skip(r)
    let x = parseWorldCoordinate(r, false)
    if not x.isOk:
      return cmdFail[Coordinates](x.error)
    return cmdOk[Coordinates](Coordinates(kind: cokWorld, x: x.value, y: y.value, z: relative(0.0)))
  setCursor(r, i)
  cmdFail[Coordinates](create(rotationIncompleteErrorType(), r))

proc parseColumnPosArg*(r: var StringReader): CmdResult[Coordinates] =
  if not canReadChar(r):
    return cmdFail[Coordinates](create(columnIncompleteErrorType(), r))
  let start = cursor(r)
  let x = parseWorldCoordinateInteger(r)
  if not x.isOk:
    return cmdFail[Coordinates](x.error)
  if peekIs(r, ' '):
    skip(r)
    let z = parseWorldCoordinateInteger(r)
    if not z.isOk:
      return cmdFail[Coordinates](z.error)
    return cmdOk[Coordinates](Coordinates(kind: cokWorld, x: x.value, y: relative(0.0), z: z.value))
  setCursor(r, start)
  cmdFail[Coordinates](create(columnIncompleteErrorType(), r))

proc textCoordinatesFor(b: SuggestionsBuilder): TextCoordinates =
  let remainder = remaining(b)
  if remainder.len > 0 and remainder[0] == '^': tcLocal else: tcGlobal

proc validBlockPos(value: string): bool =
  var r = newStringReader(value)
  parseBlockPosArg(r).isOk

proc newBlockPosArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atBlockPos),
    overrideSuggestion: none[SuggestionProviders](), examples: @["1 3 5", "-3 ~24 ~-1", "80 80 80", "^ ^9 ^56"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = wrapCoords(parseBlockPosArg(r)),
    listSuggestionsProc: proc(context: CommandContext; b: SuggestionsBuilder): Suggestions {.closure.} =
      suggest3dCoordinates(b, textCoordinatesFor(b), validBlockPos))

proc newVec3ArgumentType*(centerIntegers = true): AnyArgumentType =
  ## `Vec3ArgumentType::Default` centers integers, `Uncorrected` does not.
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atVec3),
    overrideSuggestion: none[SuggestionProviders](), examples: @["1 1 1", "3 ~34 ~-2", "40 50 60", "^ ^4 ^3"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = wrapCoords(parseVec3Arg(r, centerIntegers)),
    listSuggestionsProc: proc(context: CommandContext; b: SuggestionsBuilder): Suggestions {.closure.} =
      let validator = proc(value: string): bool {.closure.} =
        var r = newStringReader(value)
        parseVec3Arg(r, centerIntegers).isOk
      suggest3dCoordinates(b, textCoordinatesFor(b), validator))

proc newRotationArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atRotation),
    overrideSuggestion: none[SuggestionProviders](), examples: @["1 1", "~5 4", "~-6 ~-6"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = wrapCoords(parseRotationArg(r)))

proc validColumnPos(value: string): bool =
  var r = newStringReader(value)
  parseColumnPosArg(r).isOk

proc newColumnPosArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atColumnPos),
    overrideSuggestion: none[SuggestionProviders](), examples: @["0 0", "~ ~", "~-1 ~2"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = wrapCoords(parseColumnPosArg(r)),
    listSuggestionsProc: proc(context: CommandContext; b: SuggestionsBuilder): Suggestions {.closure.} =
      suggest2dCoordinates(b, textCoordinatesFor(b), validColumnPos))

proc getCoordinates*(c: CommandContext; name: string): CmdResult[Coordinates] =
  var found = false
  let v = argumentOf(c, name, found)
  if not found:
    return cmdFail[Coordinates](missingArgument(name))
  if not (v of CoordinatesValue):
    return cmdFail[Coordinates](wrongArgumentType(name))
  let typed = CoordinatesValue(v)
  cmdOk[Coordinates](typed.value)

proc getVector3*(c: CommandContext; name: string): CmdResult[Vector3[float64]] =
  let v = getCoordinates(c, name)
  if not v.isOk:
    return cmdFail[Vector3[float64]](v.error)
  cmdOk[Vector3[float64]](resolve(v.value, c.source))

proc flooredPos(v: Vector3[float64]): BlockPos =
  ## `BlockPos::floored_v`.
  BlockPos(vec: Vector3[int32](x: int32(floor(v.x)), y: int32(floor(v.y)), z: int32(floor(v.z))))

proc getBlockPos*(c: CommandContext; name: string): CmdResult[BlockPos] =
  let v = getVector3(c, name)
  if not v.isOk:
    return cmdFail[BlockPos](v.error)
  cmdOk[BlockPos](flooredPos(v.value))

proc getLoadedBlockPosInWorld*(c: CommandContext; name: string; world: CommandWorld): CmdResult[BlockPos] =
  let pos = getBlockPos(c, name)
  if not pos.isOk:
    return pos
  let p = pos.value
  if closureSet(world.isChunkLoaded) and not world.isChunkLoaded(floorDiv(p.vec.x, 16'i32), floorDiv(p.vec.z, 16'i32)):
    return cmdFail[BlockPos](createWithoutContext(notLoadedErrorType()))
  if closureSet(world.isInBuildLimit) and not world.isInBuildLimit(p.vec.x, p.vec.y, p.vec.z):
    return cmdFail[BlockPos](createWithoutContext(outOfWorldErrorType()))
  pos

proc getLoadedBlockPos*(c: CommandContext; name: string): CmdResult[BlockPos] =
  let w = c.source.world
  if w == nil:
    return cmdFail[BlockPos](createWithoutContext(notLoadedErrorType()))
  getLoadedBlockPosInWorld(c, name, w)

proc isValidWorldPos*(x, y, z: int32): bool =
  ## `World::is_valid`: within the horizontal world limits and the Y range a block position can hold.
  x >= -30000000'i32 and z >= -30000000'i32 and x < 30000000'i32 and z < 30000000'i32 and
    y >= -20000000'i32 and y < 20000000'i32

proc getSpawnablePos*(c: CommandContext; name: string): CmdResult[BlockPos] =
  let pos = getBlockPos(c, name)
  if not pos.isOk:
    return pos
  if isValidWorldPos(pos.value.vec.x, pos.value.vec.y, pos.value.vec.z):
    pos
  else:
    cmdFail[BlockPos](createWithoutContext(outOfBoundsErrorType()))
