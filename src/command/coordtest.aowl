## Port of the `#[test]` blocks of pumpkin/src/command/argument_types/coordinates/vec3.rs, plus block_pos.rs's examples.
##
## This test used to fail because its expectations were wrong, not the parser: it wanted "0 0 0" to resolve to
## (0, 0, 0) and "1 2 3" to (1.5, 2.5, 3.5) with centering on. Upstream's own test says X and Z gain the 0.5 and Y
## never does, so those two expectations are replaced by upstream's vectors.
import std/[assertions, syncio]
import ../util/vector2, ../util/vector3
import cmderrors, string_reader, cmdsource, coordinates

proc w(x, y, z: WorldCoordinate): Coordinates = Coordinates(kind: cokWorld, x: x, y: y, z: z)

proc parsesTo(input: string; center: bool; want: Coordinates) =
  var r = newStringReader(input)
  let v = parseVec3Arg(r, center)
  assert v.isOk
  assert v.value == want

proc failsWith(input: string; t: CommandErrorType) =
  var r = newStringReader(input)
  let v = parseVec3Arg(r, true)
  assert not v.isOk
  assert v.error.isType(t)

proc vec3ParseTest() =
  parsesTo("0 0 0", true, w(absolute(0.5), absolute(0.0), absolute(0.5)))
  parsesTo("0 0 0", false, w(absolute(0.0), absolute(0.0), absolute(0.0)))
  parsesTo("~ ~4 8", true, w(relative(0.0), relative(4.0), absolute(8.5)))
  parsesTo("~ ~4 8", false, w(relative(0.0), relative(4.0), absolute(8.0)))
  parsesTo("~-1 ~-2.5 ~-3", true, w(relative(-1.0), relative(-2.5), relative(-3.0)))
  parsesTo("~-1 ~-2.5 ~-3", false, w(relative(-1.0), relative(-2.5), relative(-3.0)))
  parsesTo("-3 4 5", true, w(absolute(-2.5), absolute(4.0), absolute(5.5)))
  failsWith("1000 2000", vec3IncompleteErrorType())

proc vec3Local() =
  parsesTo("^1 ^10 ^30", true, Coordinates(kind: cokLocal, left: 1.0, up: 10.0, forward: 30.0))
  failsWith("^1 ^10 ~20", mixedTypeErrorType())
  failsWith("^-3 ^-7 10", mixedTypeErrorType())
  failsWith("^1 ^2", vec3IncompleteErrorType())

proc blockPosExamples() =
  let source = dummySource()
  var r1 = newStringReader("1 3 5")
  let p1 = parseBlockPosArg(r1)
  assert p1.isOk
  let v1 = resolve(p1.value, source)
  assert v1.x == 1.0 and v1.y == 3.0 and v1.z == 5.0
  var r2 = newStringReader("-3 ~24 ~-1")
  let p2 = parseBlockPosArg(r2)
  assert p2.isOk
  let v2 = resolve(p2.value, source)
  assert v2.x == -3.0 and v2.y == 24.0 and v2.z == -1.0
  var r3 = newStringReader("^ ^9 ^56")
  let p3 = parseBlockPosArg(r3)
  assert p3.isOk
  let v3 = resolve(p3.value, source)
  assert abs(v3.y - 9.0) < 1e-9
  assert isValidWorldPos(0'i32, 0'i32, 0'i32)
  assert not isValidWorldPos(30000001'i32, 0'i32, 0'i32)

proc rotationAndColumn() =
  var r = newStringReader("~5 4")
  let v = parseRotationArg(r)
  assert v.isOk
  assert v.value == w(absolute(4.0), relative(5.0), relative(0.0))
  var r2 = newStringReader("1")
  assert parseRotationArg(r2).error.isType(rotationIncompleteErrorType())
  var r3 = newStringReader("~-1 ~2")
  let c = parseColumnPosArg(r3)
  assert c.isOk
  assert c.value == w(relative(-1.0), relative(0.0), relative(2.0))
  var r4 = newStringReader("")
  assert parseColumnPosArg(r4).error.isType(columnIncompleteErrorType())

vec3ParseTest()
vec3Local()
blockPosExamples()
rotationAndColumn()
echo "all coordinate tests passed"
