## Entity selectors (`@a[distance=..5]`) and the argument types that hold them.
## Port of pumpkin/src/command/argument_types/entity_selector/mod.rs
## Port of pumpkin/src/command/argument_types/entity_selector/parser.rs
## Port of pumpkin/src/command/argument_types/entity_selector/option.rs
## Port of pumpkin/src/command/argument_types/entity.rs
## Port of pumpkin/src/command/argument_types/mod.rs
## Port of pumpkin/src/command/argument_types/range.rs
##
## `Predicate` is as upstream's: always false before inversion. The `from_reader` bounds parsers from
## argument_types/mod.rs are here because only selectors and the range types use them.

import std/[algorithm, math, options, random, strutils]
import ../util/text/textbase, ../util/text/text
import ../util/vector3, ../util/uuid, ../util/gamemode
import ../util/math/[bounds, boundingbox, mathmod]
import ../generated/[translation, entity_type]
import ../nbt/tag
import ../protocol/java/client/play/commands
import cmderrors, string_reader, suggestion, cmdsource, cmdtree, snbt

const
  EntitySelectorPermission* = "minecraft:command.selector"
  FlagWorldLimited = 1'u32
  FlagNameEqualsSet = 2'u32
  FlagNameNotEqualsSet = 4'u32
  FlagGamemodeEqualsSet = 8'u32
  FlagGamemodeNotEqualsSet = 16'u32
  FlagTeamEqualsSet = 32'u32
  FlagTeamNotEqualsSet = 64'u32
  FlagLimitSet = 128'u32
  FlagSortSet = 256'u32
  FlagEntityTypeInverted = 512'u32
  FlagScoresSet = 1024'u32
  FlagAdvancementsSet = 2048'u32

type
  Order* = enum
    orderNearest
    orderFurthest
    orderRandom
    orderArbitrary

  RotationType* = enum
    rotationYaw
    rotationPitch

  PredicateKind* = enum
    pkIsAlive
    pkGameMode
    pkExperienceLevel
    pkRotation
    pkBoundingBox
    pkDistance
    pkEntityType
    pkName
    pkTag
    pkTeam
    pkScores
    pkAdvancements
    pkNbt
    pkPredicate

  EntitySelectorPredicate* = object
    kind*: PredicateKind
    invert*: bool
    gameMode*: GameMode
    intBounds*: IntBounds
    rotationBounds*: FloatDegreeBounds
    rotationType*: RotationType
    box*: BoundingBox
    doubleBounds*: DoubleBounds
    pos*: Vector3[float64]
    str*: string
    scoreNames*: seq[string]
    scoreBounds*: seq[IntBounds]
    advancementNames*: seq[string]
    advancementValues*: seq[bool]
    nbt*: NbtCompound

  EntitySelector* = ref object
    maxSelected*: int32
    includesEntities*: bool
    predicates*: seq[EntitySelectorPredicate]
    distance*: Option[DoubleBounds]
    posX*, posY*, posZ*: Option[float64] ## `PositionFunction`: all none is `Identity`.
    boundingBox*: Option[BoundingBox]
    order*: Order
    isCurrentEntity*: bool
    playerName*: Option[string]
    entityUuid*: Option[Uuid]
    entityType*: Option[string]
    usesSelectorVariable*: bool
    isWorldLimited*: bool

  EntitySelectorValue* = ref object of ArgValue
    value*: EntitySelector

  IntBoundsValue* = ref object of ArgValue
    value*: IntBounds

  DoubleBoundsValue* = ref object of ArgValue
    value*: DoubleBounds

  ParserSuggestions* = enum
    psNothing
    psSelector
    psOpenOptions
    psOptionsKeyOrClose
    psName
    psOptionsKey
    psOptionsNextOrClose
    psNameOrSelector
    psSort
    psGamemode

  EntitySelectorParser* = object
    maxSelected*: int32
    distance*: Option[DoubleBounds]
    experienceLevel*: Option[IntBounds]
    posX*, posY*, posZ*: Option[float64]
    deltaX*, deltaY*, deltaZ*: Option[float64]
    rotationX*, rotationY*: Option[FloatDegreeBounds]
    predicates*: seq[EntitySelectorPredicate]
    order*: Order
    playerName*: Option[string]
    entityUuid*: Option[Uuid]
    entityType*: Option[string]
    startPosition*: int
    allowsSelectorVariable*: bool
    usesSelectorVariable*: bool
    includesEntities*: bool
    isCurrentEntity*: bool
    suggestions*: ParserSuggestions
    flags*: uint32

  EntitySelectorOption* = enum
    esoName
    esoDistance
    esoLevel
    esoX
    esoY
    esoZ
    esoDx
    esoDy
    esoDz
    esoXRotation
    esoYRotation
    esoLimit
    esoSort
    esoGamemode
    esoTeam
    esoType
    esoTag
    esoNbt
    esoScores
    esoAdvancements
    esoPredicate

  EntityArgumentKind* = enum
    eakEntity
    eakEntities
    eakPlayer
    eakPlayers

proc emptyBoundsErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_RANGE_EMPTY, JAVA_ARGUMENT_RANGE_EMPTY)
proc swappedBoundsErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_RANGE_SWAPPED, JAVA_ARGUMENT_RANGE_SWAPPED)
proc invalidNameOrUuidErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_INVALID, JAVA_ARGUMENT_ENTITY_INVALID)
proc unknownSelectorTypeErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_SELECTOR_UNKNOWN, JAVA_ARGUMENT_ENTITY_SELECTOR_UNKNOWN)
proc selectorsNotAllowedErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_SELECTOR_NOT_ALLOWED, JAVA_ARGUMENT_ENTITY_SELECTOR_NOT_ALLOWED)
proc missingSelectorTypeErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_SELECTOR_MISSING, JAVA_ARGUMENT_ENTITY_SELECTOR_MISSING)
proc expectedEndOfOptionsErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_OPTIONS_UNTERMINATED, JAVA_ARGUMENT_ENTITY_OPTIONS_UNTERMINATED)
proc expectedOptionValueErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_VALUELESS, JAVA_ARGUMENT_ENTITY_OPTIONS_VALUELESS)
proc unknownOptionErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_UNKNOWN, JAVA_ARGUMENT_ENTITY_OPTIONS_UNKNOWN)
proc inapplicableOptionErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_INAPPLICABLE, JAVA_ARGUMENT_ENTITY_OPTIONS_INAPPLICABLE)
proc distanceNegativeErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_OPTIONS_DISTANCE_NEGATIVE, JAVA_ARGUMENT_ENTITY_OPTIONS_DISTANCE_NEGATIVE)
proc levelNegativeErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_OPTIONS_LEVEL_NEGATIVE, JAVA_ARGUMENT_ENTITY_OPTIONS_LEVEL_NEGATIVE)
proc limitTooSmallErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_OPTIONS_LIMIT_TOOSMALL, JAVA_ARGUMENT_ENTITY_OPTIONS_LIMIT_TOOSMALL)
proc sortUnknownErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_SORT_IRREVERSIBLE, JAVA_ARGUMENT_ENTITY_OPTIONS_SORT_IRREVERSIBLE)
proc gamemodeInvalidErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_MODE_INVALID, JAVA_ARGUMENT_ENTITY_OPTIONS_MODE_INVALID)
proc typeInvalidErrorType*(): CommandErrorType = errorType1(JAVA_ARGUMENT_ENTITY_OPTIONS_TYPE_INVALID, JAVA_ARGUMENT_ENTITY_OPTIONS_TYPE_INVALID)
proc noEntitiesErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_NOTFOUND_ENTITY, JAVA_ARGUMENT_ENTITY_NOTFOUND_ENTITY)
proc noPlayersErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_NOTFOUND_PLAYER, JAVA_ARGUMENT_ENTITY_NOTFOUND_PLAYER)
proc onlyPlayersAllowedErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_PLAYER_ENTITIES, JAVA_ARGUMENT_PLAYER_ENTITIES)
proc notSingleEntityErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_ENTITY_TOOMANY, JAVA_ARGUMENT_ENTITY_TOOMANY)
proc notSinglePlayerErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_PLAYER_TOOMANY, JAVA_ARGUMENT_PLAYER_TOOMANY)

# ---- argument_types/mod.rs: bounds --------------------------------------------------------------------------------

proc hasAllowedPeakedCharacter(r: StringReader): bool =
  let c = peek(r)
  if (c >= int32(ord('0')) and c <= int32(ord('9'))) or c == int32(ord('-')):
    return true
  c == int32(ord('.')) and (not canReadChars(r, 2) or peekWithOffset(r, 1) != int32(ord('.')))

proc readNumberToken(r: var StringReader): string =
  ## The scan of `read_number_from_reader`.
  let i = cursor(r)
  while hasAllowedPeakedCharacter(r):
    skip(r)
  r.str[i ..< cursor(r)]

proc withCursor(e: CommandSyntaxError; i: int): CommandSyntaxError =
  ## The `map_err` of `bounds_from_reader`: the error moves back to where the bounds began.
  result = e
  if e.hasContext:
    result.context.cursor = i

proc boundsSplit(r: var StringReader): bool =
  if peekIs(r, '.') and peekWithOffset(r, 1) == int32(ord('.')):
    skip(r)
    skip(r)
    true
  else:
    false

proc intBoundsFromReader*(r: var StringReader): CmdResult[IntBounds] =
  let start = cursor(r)
  if not canReadChar(r):
    return cmdFail[IntBounds](create(emptyBoundsErrorType(), r))
  var minV = none[int32]()
  var maxV = none[int32]()
  let tok = readNumberToken(r)
  if tok.len > 0:
    var v = 0'i64
    if not parseI64Checked(tok, int64(int32.low), int64(int32.high), v):
      return cmdFail[IntBounds](withCursor(create(readerInvalidInt(), r, text(tok)), start))
    minV = some(int32(v))
  maxV = minV
  if boundsSplit(r):
    maxV = none[int32]()
    let tok2 = readNumberToken(r)
    if tok2.len > 0:
      var v = 0'i64
      if not parseI64Checked(tok2, int64(int32.low), int64(int32.high), v):
        return cmdFail[IntBounds](withCursor(create(readerInvalidInt(), r, text(tok2)), start))
      maxV = some(int32(v))
  if minV.isNone and maxV.isNone:
    return cmdFail[IntBounds](withCursor(create(emptyBoundsErrorType(), r), start))
  let b = newBounds[int32](minV, maxV)
  if areSwapped(b):
    setCursor(r, start)
    return cmdFail[IntBounds](create(swappedBoundsErrorType(), r))
  cmdOk[IntBounds](fromBounds(b))

proc parseFloatBounds(r: var StringReader; invalid: CommandErrorType; minV, maxV: var Option[float64]): CmdVoidResult =
  let start = cursor(r)
  if not canReadChar(r):
    return cmdFailVoid(create(emptyBoundsErrorType(), r))
  let tok = readNumberToken(r)
  if tok.len > 0:
    var v = 0.0
    if not parseF64Checked(tok, v):
      return cmdFailVoid(withCursor(create(invalid, r, text(tok)), start))
    minV = some(v)
  maxV = minV
  if boundsSplit(r):
    maxV = none[float64]()
    let tok2 = readNumberToken(r)
    if tok2.len > 0:
      var v = 0.0
      if not parseF64Checked(tok2, v):
        return cmdFailVoid(withCursor(create(invalid, r, text(tok2)), start))
      maxV = some(v)
  if minV.isNone and maxV.isNone:
    return cmdFailVoid(withCursor(create(emptyBoundsErrorType(), r), start))
  cmdOkVoid()

proc doubleBoundsFromReader*(r: var StringReader): CmdResult[DoubleBounds] =
  let start = cursor(r)
  var minV = none[float64]()
  var maxV = none[float64]()
  let p = parseFloatBounds(r, readerInvalidDouble(), minV, maxV)
  if not p.isOk:
    return cmdFail[DoubleBounds](p.error)
  let b = newBounds[float64](minV, maxV)
  if areSwapped(b):
    setCursor(r, start)
    return cmdFail[DoubleBounds](create(swappedBoundsErrorType(), r))
  cmdOk[DoubleBounds](fromBounds(b))

proc floatDegreeBoundsFromReader*(r: var StringReader): CmdResult[FloatDegreeBounds] =
  let start = cursor(r)
  var minV = none[float64]()
  var maxV = none[float64]()
  let p = parseFloatBounds(r, readerInvalidFloat(), minV, maxV)
  if not p.isOk:
    return cmdFail[FloatDegreeBounds](p.error)
  var minF = none[float32]()
  var maxF = none[float32]()
  if minV.isSome:
    minF = some(float32(minV.unsafeGet))
  if maxV.isSome:
    maxF = some(float32(maxV.unsafeGet))
  let b = newBounds[float32](minF, maxF)
  if areSwapped(b):
    setCursor(r, start)
    return cmdFail[FloatDegreeBounds](create(swappedBoundsErrorType(), r))
  cmdOk[FloatDegreeBounds](fromBounds(b))

# ---- entity_selector/mod.rs: predicates ---------------------------------------------------------------------------

proc entityActualName(entity: CommandEntity): string =
  let p = entity.player
  if p != nil:
    return p.gameProfile.name
  if entity.getCustomName != nil:
    let custom = entity.getCustomName()
    if custom.isSome:
      return getText(custom.unsafeGet)
  entity.entityTypeName

proc matchesNbtCompound*(expected, actual: NbtCompound): bool

proc matchesNbt*(expected, actual: NbtTag): bool =
  if expected.kind == ntkCompound and actual.kind == ntkCompound:
    return matchesNbtCompound(expected.compoundVal, actual.compoundVal)
  if expected.kind == ntkList and actual.kind == ntkList:
    for e in expected.listVal:
      var found = false
      for a in actual.listVal:
        if matchesNbt(e, a):
          found = true
          break
      if not found:
        return false
    return true
  expected == actual

proc matchesNbtCompound*(expected, actual: NbtCompound): bool =
  var i = 0
  while i < expected.names.len:
    let (found, value) = get(actual, expected.names[i])
    if not found or not matchesNbt(expected.values[i], value):
      return false
    inc i
  true

proc testPredicate*(pr: EntitySelectorPredicate; entity: CommandEntity): bool =
  case pr.kind
  of pkIsAlive:
    entity.isAlive != nil and entity.isAlive()
  of pkGameMode:
    let p = entity.player
    if p == nil or p.getGameMode == nil:
      return false
    (p.getGameMode() == pr.gameMode) xor pr.invert
  of pkExperienceLevel:
    let p = entity.player
    if p == nil or p.getExperienceLevel == nil:
      return false
    matches(pr.intBounds, p.getExperienceLevel())
  of pkRotation:
    let minO = min(pr.rotationBounds)
    let maxO = max(pr.rotationBounds)
    let minD = wrapDegrees(if minO.isSome: minO.unsafeGet else: 0.0'f32)
    let maxD = wrapDegrees(if maxO.isSome: maxO.unsafeGet else: 360.0'f32)
    let rot = entity.getRotation()
    # `Rotation` holds (pitch, yaw), so yaw is `y` here.
    let degrees = wrapDegrees(if pr.rotationType == rotationYaw: rot.y else: rot.x)
    if minD > maxD:
      degrees >= minD or degrees <= maxD
    else:
      degrees >= minD and degrees <= maxD
  of pkBoundingBox:
    entity.getBoundingBox != nil and intersects(entity.getBoundingBox(), pr.box)
  of pkDistance:
    matchesSquare(pr.doubleBounds, squaredDistanceToVec(entity.getPos(), pr.pos))
  of pkEntityType:
    (entity.entityTypeName == pr.str) xor pr.invert
  of pkName:
    (entityActualName(entity) == pr.str) xor pr.invert
  of pkTag:
    var hasTag = false
    if entity.getScoreboardTags != nil:
      hasTag = pr.str in entity.getScoreboardTags()
    hasTag xor pr.invert
  of pkTeam:
    var hasTeam = false
    let w = entity.getWorld()
    if w != nil and w.teamHasPlayer != nil:
      hasTeam = w.teamHasPlayer(pr.str, entityActualName(entity))
    hasTeam xor pr.invert
  of pkScores:
    let actualName = entityActualName(entity)
    let w = entity.getWorld()
    var i = 0
    while i < pr.scoreNames.len:
      var score = 0'i32
      if w != nil and w.getScore != nil:
        score = w.getScore(actualName, pr.scoreNames[i])
      if not matches(pr.scoreBounds[i], score):
        return false
      inc i
    true
  of pkAdvancements:
    let p = entity.player
    if p == nil or p.isAdvancementDone == nil:
      return false
    var i = 0
    while i < pr.advancementNames.len:
      var exists = false
      let done = p.isAdvancementDone(pr.advancementNames[i], exists)
      if not exists or done != pr.advancementValues[i]:
        return false
      inc i
    true
  of pkNbt:
    var actual = newCompound()
    if entity.writeNbt != nil:
      actual = entity.writeNbt()
    matchesNbtCompound(pr.nbt, actual) xor pr.invert
  of pkPredicate:
    false xor pr.invert

proc testAll(predicates: seq[EntitySelectorPredicate]; entity: CommandEntity): bool =
  for pr in predicates:
    if not testPredicate(pr, entity):
      return false
  true

# ---- entity_selector/mod.rs: EntitySelector -----------------------------------------------------------------------

proc checkPermissions*(s: EntitySelector; source: CommandSource): CmdVoidResult =
  if s.usesSelectorVariable and not hasPermission(source, EntitySelectorPermission):
    cmdFailVoid(createWithoutContext(selectorsNotAllowedErrorType()))
  else:
    cmdOkVoid()

proc resultLimit(s: EntitySelector): uint64 =
  if s.order == orderArbitrary: uint64(s.maxSelected) else: high(uint64)

proc positionFunctionApply(s: EntitySelector; pos: Vector3[float64]): Vector3[float64] =
  Vector3[float64](x: (if s.posX.isSome: s.posX.unsafeGet else: pos.x),
    y: (if s.posY.isSome: s.posY.unsafeGet else: pos.y),
    z: (if s.posZ.isSome: s.posZ.unsafeGet else: pos.z))

proc absoluteBoundingBox*(s: EntitySelector; pos: Vector3[float64]): Option[BoundingBox] =
  if s.boundingBox.isSome:
    some(shift(s.boundingBox.unsafeGet, pos))
  else:
    none[BoundingBox]()

proc selectorPredicates(s: EntitySelector; pos: Vector3[float64]; box: Option[BoundingBox]): seq[EntitySelectorPredicate] =
  result = s.predicates
  if box.isSome:
    result.add(EntitySelectorPredicate(kind: pkBoundingBox, box: box.unsafeGet))
  if s.distance.isSome:
    result.add(EntitySelectorPredicate(kind: pkDistance, doubleBounds: s.distance.unsafeGet, pos: pos))

proc sortByDistance(entities: var seq[CommandEntity]; origin: Vector3[float64]; furthest: bool) =
  ## `sort_by` is stable; this insertion sort is too.
  var i = 1
  while i < entities.len:
    let current = entities[i]
    let d = squaredDistanceToVec(current.getPos(), origin)
    var j = i - 1
    while j >= 0:
      let other = squaredDistanceToVec(entities[j].getPos(), origin)
      if (if furthest: other >= d else: other <= d):
        break
      entities[j + 1] = entities[j]
      dec j
    entities[j + 1] = current
    inc i

proc sortEntities(order: Order; limit: uint64; origin: Vector3[float64]; list: seq[CommandEntity]): seq[CommandEntity] =
  ## `Order::sort_and_limit` over entities.
  var entities = list
  case order
  of orderNearest:
    sortByDistance(entities, origin, false)
  of orderFurthest:
    sortByDistance(entities, origin, true)
  of orderRandom:
    shuffle(entities)
  of orderArbitrary:
    discard
  var limited: seq[CommandEntity] = @[]
  var i = 0'u64
  for e in entities:
    if i >= limit:
      break
    limited.add(e)
    inc i
  limited

proc limitFor(s: EntitySelector; n: int): uint64 =
  min(uint64(n), uint64(s.maxSelected))

proc addEntities(s: EntitySelector; list: var seq[CommandEntity]; world: CommandWorld; box: Option[BoundingBox];
                 predicates: seq[EntitySelectorPredicate]) =
  let limit = resultLimit(s)
  var candidates: seq[CommandEntity] = @[]
  if box.isSome and world.getEntitiesInBox != nil:
    candidates = world.getEntitiesInBox(box.unsafeGet)
  elif world.getEntities != nil:
    candidates = world.getEntities()
  for e in candidates:
    if uint64(list.len) >= limit:
      return
    if testAll(predicates, e):
      list.add(e)

proc worldsOf(source: CommandSource): seq[CommandWorld] =
  result = @[]
  let server = source.server
  if server != nil and server.getWorlds != nil:
    result = server.getWorlds()

proc findPlayerEntityByName(source: CommandSource; name: string): seq[CommandEntity] =
  result = @[]
  let server = source.server
  if server != nil and server.getPlayerByName != nil:
    let p = server.getPlayerByName(name)
    if p != nil:
      result.add(p.entity)

proc findPlayers*(s: EntitySelector; source: CommandSource): CmdResult[seq[CommandPlayer]] =
  let perm = checkPermissions(s, source)
  if not perm.isOk:
    return cmdFail[seq[CommandPlayer]](perm.error)
  var res: seq[CommandPlayer] = @[]
  if s.playerName.isSome:
    let server = source.server
    if server != nil and server.getPlayerByName != nil:
      let p = server.getPlayerByName(s.playerName.unsafeGet)
      if p != nil:
        res.add(p)
    return cmdOk[seq[CommandPlayer]](res)
  if s.entityUuid.isSome:
    let worldList = worldsOf(source)
    for world in worldList:
      if world.getPlayerByUuid != nil:
        let p = world.getPlayerByUuid(s.entityUuid.unsafeGet)
        if p != nil:
          res.add(p)
          return cmdOk[seq[CommandPlayer]](res)
    return cmdOk[seq[CommandPlayer]](res)
  let origin = positionFunctionApply(s, source.position)
  let box = absoluteBoundingBox(s, origin)
  let predicates = selectorPredicates(s, origin, box)
  if s.isCurrentEntity:
    let e = source.entity
    let server = source.server
    if e != nil and server != nil and server.getPlayerByUuid != nil:
      let p = server.getPlayerByUuid(e.uuid)
      if p != nil:
        if testAll(predicates, p.entity):
          res.add(p)
    return cmdOk[seq[CommandPlayer]](res)
  let limit = resultLimit(s)
  var list: seq[CommandPlayer] = @[]
  if limit > 0'u64:
    var worlds: seq[CommandWorld] = @[]
    let current = source.world
    if s.isWorldLimited:
      if current != nil:
        worlds.add(current)
    else:
      worlds = worldsOf(source)
    for world in worlds:
      if world.getPlayers != nil:
        let worldPlayers = world.getPlayers()
        for p in worldPlayers:
          if uint64(list.len) >= limit:
            break
          if testAll(predicates, p.entity):
            list.add(p)
  var entities: seq[CommandEntity] = @[]
  for p in list:
    entities.add(p.entity)
  for e in sortEntities(s.order, limitFor(s, list.len), origin, entities):
    let ep = e.player
    if ep != nil:
      res.add(ep)
  cmdOk[seq[CommandPlayer]](res)

proc findEntities*(s: EntitySelector; source: CommandSource): CmdResult[seq[CommandEntity]] =
  let perm = checkPermissions(s, source)
  if not perm.isOk:
    return cmdFail[seq[CommandEntity]](perm.error)
  var res: seq[CommandEntity] = @[]
  if not s.includesEntities:
    let players = findPlayers(s, source)
    if not players.isOk:
      return cmdFail[seq[CommandEntity]](players.error)
    for p in players.value:
      res.add(p.entity)
    return cmdOk[seq[CommandEntity]](res)
  if s.playerName.isSome:
    return cmdOk[seq[CommandEntity]](findPlayerEntityByName(source, s.playerName.unsafeGet))
  if s.entityUuid.isSome:
    let worldList = worldsOf(source)
    for world in worldList:
      if world.getEntityByUuid != nil:
        let e = world.getEntityByUuid(s.entityUuid.unsafeGet)
        if e != nil:
          res.add(e)
          return cmdOk[seq[CommandEntity]](res)
    return cmdOk[seq[CommandEntity]](res)
  let origin = positionFunctionApply(s, source.position)
  let box = absoluteBoundingBox(s, origin)
  let predicates = selectorPredicates(s, origin, box)
  if s.isCurrentEntity:
    let e = source.entity
    if e != nil:
      if testAll(predicates, e):
        res.add(e)
    return cmdOk[seq[CommandEntity]](res)
  var list: seq[CommandEntity] = @[]
  if s.isWorldLimited:
    let w = source.world
    if w != nil:
      addEntities(s, list, w, box, predicates)
  else:
    let worldList = worldsOf(source)
    for world in worldList:
      addEntities(s, list, world, box, predicates)
  cmdOk[seq[CommandEntity]](sortEntities(s.order, limitFor(s, list.len), origin, list))

proc findSingleEntity*(s: EntitySelector; source: CommandSource): CmdResult[CommandEntity] =
  let list = findEntities(s, source)
  if not list.isOk:
    return cmdFail[CommandEntity](list.error)
  if list.value.len == 0:
    return cmdFail[CommandEntity](createWithoutContext(noEntitiesErrorType()))
  if list.value.len == 1:
    return cmdOk[CommandEntity](list.value[0])
  cmdFail[CommandEntity](createWithoutContext(notSingleEntityErrorType()))

proc findSinglePlayer*(s: EntitySelector; source: CommandSource): CmdResult[CommandPlayer] =
  let list = findPlayers(s, source)
  if not list.isOk:
    return cmdFail[CommandPlayer](list.error)
  if list.value.len == 1:
    return cmdOk[CommandPlayer](list.value[0])
  cmdFail[CommandPlayer](createWithoutContext(noPlayersErrorType()))

# ---- entity_selector/parser.rs ------------------------------------------------------------------------------------

proc newEntitySelectorParser*(allowSelectors: bool): EntitySelectorParser =
  EntitySelectorParser(maxSelected: 0'i32, distance: none[DoubleBounds](), experienceLevel: none[IntBounds](),
    posX: none[float64](), posY: none[float64](), posZ: none[float64](),
    deltaX: none[float64](), deltaY: none[float64](), deltaZ: none[float64](),
    rotationX: none[FloatDegreeBounds](), rotationY: none[FloatDegreeBounds](), predicates: @[],
    order: orderArbitrary, playerName: none[string](), entityUuid: none[Uuid](), entityType: none[string](),
    startPosition: 0, allowsSelectorVariable: allowSelectors, usesSelectorVariable: false, includesEntities: false,
    isCurrentEntity: false, suggestions: psNothing, flags: 0'u32)

proc hasFlag(p: EntitySelectorParser; f: uint32): bool = (p.flags and f) != 0'u32
proc setFlag(p: var EntitySelectorParser; f: uint32) = p.flags = p.flags or f

proc createBoundingBox(x, y, z: float64): BoundingBox =
  newBoundingBox(Vector3[float64](x: min(x, 0.0), y: min(y, 0.0), z: min(z, 0.0)),
    Vector3[float64](x: max(x, 0.0) + 1.0, y: max(y, 0.0) + 1.0, z: max(z, 0.0) + 1.0))

proc selector(p: EntitySelectorParser): EntitySelector =
  var predicates = p.predicates
  if p.rotationX.isSome:
    predicates.add(EntitySelectorPredicate(kind: pkRotation, rotationBounds: p.rotationX.unsafeGet, rotationType: rotationYaw))
  if p.rotationY.isSome:
    predicates.add(EntitySelectorPredicate(kind: pkRotation, rotationBounds: p.rotationY.unsafeGet, rotationType: rotationPitch))
  if p.experienceLevel.isSome:
    predicates.add(EntitySelectorPredicate(kind: pkExperienceLevel, intBounds: p.experienceLevel.unsafeGet))
  var box = none[BoundingBox]()
  if p.deltaX.isNone and p.deltaY.isNone and p.deltaZ.isNone:
    if p.distance.isSome:
      let m = max(p.distance.unsafeGet)
      if m.isSome:
        let v = m.unsafeGet
        box = some(newBoundingBox(Vector3[float64](x: -v, y: -v, z: -v),
          Vector3[float64](x: v + 1.0, y: v + 1.0, z: v + 1.0)))
  else:
    box = some(createBoundingBox(if p.deltaX.isSome: p.deltaX.unsafeGet else: 0.0,
      if p.deltaY.isSome: p.deltaY.unsafeGet else: 0.0,
      if p.deltaZ.isSome: p.deltaZ.unsafeGet else: 0.0))
  EntitySelector(maxSelected: p.maxSelected, includesEntities: p.includesEntities, predicates: predicates,
    distance: p.distance, posX: p.posX, posY: p.posY, posZ: p.posZ, boundingBox: box, order: p.order,
    isCurrentEntity: p.isCurrentEntity, playerName: p.playerName, entityUuid: p.entityUuid, entityType: p.entityType,
    usesSelectorVariable: p.usesSelectorVariable, isWorldLimited: hasFlag(p, FlagWorldLimited))

proc limitToPlayers(p: var EntitySelectorParser) =
  p.entityType = some("player")

proc consumeStart(r: var StringReader; c: char): bool =
  ## `consume_inverted_start` and `consume_tag_start`.
  skipWhitespace(r)
  if peekIs(r, c):
    skip(r)
    skipWhitespace(r)
    true
  else:
    false

proc optionName*(o: EntitySelectorOption): string =
  case o
  of esoName: "name"
  of esoDistance: "distance"
  of esoLevel: "level"
  of esoX: "x"
  of esoY: "y"
  of esoZ: "z"
  of esoDx: "dx"
  of esoDy: "dy"
  of esoDz: "dz"
  of esoXRotation: "x_rotation"
  of esoYRotation: "y_rotation"
  of esoLimit: "limit"
  of esoSort: "sort"
  of esoGamemode: "gamemode"
  of esoTeam: "team"
  of esoType: "type"
  of esoTag: "tag"
  of esoNbt: "nbt"
  of esoScores: "scores"
  of esoAdvancements: "advancements"
  of esoPredicate: "predicate"

proc optionFromStr(s: string; o: var EntitySelectorOption): bool =
  for v in esoName .. esoPredicate:
    if optionName(v) == s:
      o = v
      return true
  false

proc canUse(o: EntitySelectorOption; p: EntitySelectorParser): bool =
  case o
  of esoName: not hasFlag(p, FlagNameEqualsSet)
  of esoDistance: p.distance.isNone
  of esoLevel: p.experienceLevel.isNone
  of esoX: p.posX.isNone
  of esoY: p.posY.isNone
  of esoZ: p.posZ.isNone
  of esoDx: p.deltaX.isNone
  of esoDy: p.deltaY.isNone
  of esoDz: p.deltaZ.isNone
  of esoXRotation: p.rotationX.isNone
  of esoYRotation: p.rotationY.isNone
  of esoLimit: not p.isCurrentEntity and not hasFlag(p, FlagLimitSet)
  of esoSort: not p.isCurrentEntity and not hasFlag(p, FlagSortSet)
  of esoGamemode: not hasFlag(p, FlagGamemodeEqualsSet)
  of esoTeam: not hasFlag(p, FlagTeamEqualsSet)
  of esoType: p.entityType.isNone
  of esoScores: not hasFlag(p, FlagScoresSet)
  of esoAdvancements: not hasFlag(p, FlagAdvancementsSet)
  of esoTag, esoNbt, esoPredicate: true

proc modifyParser(o: EntitySelectorOption; p: var EntitySelectorParser; r: var StringReader): CmdVoidResult =
  let i = cursor(r)
  case o
  of esoDistance:
    let b = doubleBoundsFromReader(r)
    if not b.isOk:
      return cmdFailVoid(b.error)
    let lo = min(b.value)
    let hi = max(b.value)
    if (lo.isNone or lo.unsafeGet < 0.0) and (hi.isNone or hi.unsafeGet < 0.0):
      setCursor(r, i)
      return cmdFailVoid(create(distanceNegativeErrorType(), r))
    p.distance = some(b.value)
    setFlag(p, FlagWorldLimited)
  of esoLevel:
    let b = intBoundsFromReader(r)
    if not b.isOk:
      return cmdFailVoid(b.error)
    let lo = min(b.value)
    let hi = max(b.value)
    if (lo.isNone or lo.unsafeGet < 0'i32) and (hi.isNone or hi.unsafeGet < 0'i32):
      setCursor(r, i)
      return cmdFailVoid(create(levelNegativeErrorType(), r))
    p.experienceLevel = some(b.value)
    p.includesEntities = false
  of esoX, esoY, esoZ, esoDx, esoDy, esoDz:
    setFlag(p, FlagWorldLimited)
    let d = readDouble(r)
    if not d.isOk:
      return cmdFailVoid(d.error)
    case o
    of esoX: p.posX = some(d.value)
    of esoY: p.posY = some(d.value)
    of esoZ: p.posZ = some(d.value)
    of esoDx: p.deltaX = some(d.value)
    of esoDy: p.deltaY = some(d.value)
    else: p.deltaZ = some(d.value)
  of esoXRotation:
    let b = floatDegreeBoundsFromReader(r)
    if not b.isOk:
      return cmdFailVoid(b.error)
    p.rotationX = some(b.value)
  of esoYRotation:
    let b = floatDegreeBoundsFromReader(r)
    if not b.isOk:
      return cmdFailVoid(b.error)
    p.rotationY = some(b.value)
  of esoLimit:
    let limit = readInt(r)
    if not limit.isOk:
      return cmdFailVoid(limit.error)
    if limit.value < 1'i32:
      setCursor(r, i)
      return cmdFailVoid(create(limitTooSmallErrorType(), r))
    p.maxSelected = limit.value
    setFlag(p, FlagLimitSet)
  of esoSort:
    let s = readUnquotedString(r)
    p.suggestions = psSort
    if s == "nearest": p.order = orderNearest
    elif s == "furthest": p.order = orderFurthest
    elif s == "random": p.order = orderRandom
    elif s == "arbitrary": p.order = orderArbitrary
    else:
      setCursor(r, i)
      return cmdFailVoid(create(sortUnknownErrorType(), r, text(s)))
    setFlag(p, FlagSortSet)
  of esoGamemode:
    p.suggestions = psGamemode
    let start = cursor(r)
    let invert = consumeStart(r, '!')
    if hasFlag(p, FlagGamemodeNotEqualsSet) and not invert:
      setCursor(r, start)
      return cmdFailVoid(create(inapplicableOptionErrorType(), r, text(optionName(o))))
    let s = readUnquotedString(r)
    let (ok, gm) = parseGameMode(s)
    if not ok:
      setCursor(r, start)
      return cmdFailVoid(create(gamemodeInvalidErrorType(), r, text(s)))
    p.includesEntities = false
    p.predicates.add(EntitySelectorPredicate(kind: pkGameMode, gameMode: gm, invert: invert))
    setFlag(p, if invert: FlagGamemodeNotEqualsSet else: FlagGamemodeEqualsSet)
  of esoType:
    let start = cursor(r)
    let invert = consumeStart(r, '!')
    if hasFlag(p, FlagEntityTypeInverted) and not invert:
      setCursor(r, start)
      return cmdFailVoid(create(inapplicableOptionErrorType(), r, text(optionName(o))))
    var s = readUnquotedString(r)
    if s.startsWith("minecraft:"):
      s = s[10 ..< s.len]
    if fromName(EntityType, s).isNone:
      setCursor(r, start)
      return cmdFailVoid(create(typeInvalidErrorType(), r, text(s)))
    if s == "player" and not invert:
      limitToPlayers(p)
    p.predicates.add(EntitySelectorPredicate(kind: pkEntityType, str: s, invert: invert))
    if invert:
      setFlag(p, FlagEntityTypeInverted)
    else:
      p.entityType = some(s)
  of esoName:
    let start = cursor(r)
    let invert = consumeStart(r, '!')
    if hasFlag(p, if invert: FlagNameNotEqualsSet else: FlagNameEqualsSet):
      setCursor(r, start)
      return cmdFailVoid(create(inapplicableOptionErrorType(), r, text(optionName(o))))
    let s = readUnquotedString(r)
    p.predicates.add(EntitySelectorPredicate(kind: pkName, str: s, invert: invert))
    setFlag(p, if invert: FlagNameNotEqualsSet else: FlagNameEqualsSet)
  of esoTag:
    let invert = consumeStart(r, '!')
    let s = readUnquotedString(r)
    p.predicates.add(EntitySelectorPredicate(kind: pkTag, str: s, invert: invert))
  of esoTeam:
    let start = cursor(r)
    let invert = consumeStart(r, '!')
    if hasFlag(p, if invert: FlagTeamNotEqualsSet else: FlagTeamEqualsSet):
      setCursor(r, start)
      return cmdFailVoid(create(inapplicableOptionErrorType(), r, text(optionName(o))))
    let s = readUnquotedString(r)
    p.predicates.add(EntitySelectorPredicate(kind: pkTeam, str: s, invert: invert))
    setFlag(p, if invert: FlagTeamNotEqualsSet else: FlagTeamEqualsSet)
  of esoScores:
    let o1 = expect(r, '{')
    if not o1.isOk:
      return o1
    skipWhitespace(r)
    var names: seq[string] = @[]
    var boundsList: seq[IntBounds] = @[]
    while canReadChar(r) and not peekIs(r, '}'):
      skipWhitespace(r)
      let objective = readUnquotedString(r)
      skipWhitespace(r)
      let eq = expect(r, '=')
      if not eq.isOk:
        return eq
      skipWhitespace(r)
      let b = intBoundsFromReader(r)
      if not b.isOk:
        return cmdFailVoid(b.error)
      var k = 0
      var replaced = false
      while k < names.len:
        if names[k] == objective:
          boundsList[k] = b.value
          replaced = true
        inc k
      if not replaced:
        names.add(objective)
        boundsList.add(b.value)
      skipWhitespace(r)
      if canReadChar(r) and peekIs(r, ','):
        skip(r)
    let o2 = expect(r, '}')
    if not o2.isOk:
      return o2
    p.predicates.add(EntitySelectorPredicate(kind: pkScores, scoreNames: names, scoreBounds: boundsList))
    setFlag(p, FlagScoresSet)
  of esoAdvancements:
    let o1 = expect(r, '{')
    if not o1.isOk:
      return o1
    skipWhitespace(r)
    var names: seq[string] = @[]
    var values: seq[bool] = @[]
    while canReadChar(r) and not peekIs(r, '}'):
      skipWhitespace(r)
      let id = readUnquotedString(r)
      skipWhitespace(r)
      let eq = expect(r, '=')
      if not eq.isOk:
        return eq
      skipWhitespace(r)
      let v = readBool(r)
      if not v.isOk:
        return cmdFailVoid(v.error)
      var k = 0
      var replaced = false
      while k < names.len:
        if names[k] == id:
          values[k] = v.value
          replaced = true
        inc k
      if not replaced:
        names.add(id)
        values.add(v.value)
      skipWhitespace(r)
      if canReadChar(r) and peekIs(r, ','):
        skip(r)
    let o2 = expect(r, '}')
    if not o2.isOk:
      return o2
    p.predicates.add(EntitySelectorPredicate(kind: pkAdvancements, advancementNames: names, advancementValues: values))
    setFlag(p, FlagAdvancementsSet)
  of esoNbt:
    let start = cursor(r)
    let invert = consumeStart(r, '!')
    let t = parseForCommands(r)
    if not t.isOk:
      return cmdFailVoid(t.error)
    if t.value.kind != ntkCompound:
      setCursor(r, start)
      return cmdFailVoid(create(dispatcherUnknownArgument(), r))
    p.predicates.add(EntitySelectorPredicate(kind: pkNbt, nbt: t.value.compoundVal, invert: invert))
  of esoPredicate:
    let invert = consumeStart(r, '!')
    let s = readUnquotedString(r)
    p.predicates.add(EntitySelectorPredicate(kind: pkPredicate, str: s, invert: invert))
  cmdOkVoid()

proc parseOptions(p: var EntitySelectorParser; r: var StringReader): CmdVoidResult =
  p.suggestions = psOptionsKey
  skipWhitespace(r)
  while canReadChar(r) and not peekIs(r, ']'):
    skipWhitespace(r)
    let i = cursor(r)
    let s = readString(r)
    if not s.isOk:
      return cmdFailVoid(s.error)
    var option = esoName
    if not optionFromStr(s.value, option):
      setCursor(r, i)
      return cmdFailVoid(create(unknownOptionErrorType(), r, text(s.value)))
    if not canUse(option, p):
      return cmdFailVoid(create(inapplicableOptionErrorType(), r, text(s.value)))
    skipWhitespace(r)
    if not peekIs(r, '='):
      setCursor(r, i)
      return cmdFailVoid(create(expectedOptionValueErrorType(), r, text(s.value)))
    skip(r)
    skipWhitespace(r)
    p.suggestions = psNothing
    let m = modifyParser(option, p, r)
    if not m.isOk:
      return m
    skipWhitespace(r)
    p.suggestions = psOptionsNextOrClose
    let peeked = peek(r)
    if peeked != NoChar:
      if peeked != int32(ord(',')):
        if peeked != int32(ord(']')):
          return cmdFailVoid(create(expectedEndOfOptionsErrorType(), r))
        break
      skip(r)
      p.suggestions = psOptionsKey
  if canReadChar(r):
    skip(r)
    p.suggestions = psNothing
    cmdOkVoid()
  else:
    cmdFailVoid(create(expectedEndOfOptionsErrorType(), r))

proc parseSelector(p: var EntitySelectorParser; r: var StringReader): CmdVoidResult =
  p.usesSelectorVariable = true
  p.suggestions = psSelector
  if not canReadChar(r):
    return cmdFailVoid(create(missingSelectorTypeErrorType(), r))
  let i = cursor(r)
  let c = read(r)
  var addAlivePredicate = false
  if c == int32(ord('a')):
    p.maxSelected = int32.high
    p.includesEntities = false
    p.order = orderArbitrary
    limitToPlayers(p)
  elif c == int32(ord('e')):
    p.maxSelected = int32.high
    p.includesEntities = true
    p.order = orderArbitrary
    addAlivePredicate = true
  elif c == int32(ord('n')):
    p.maxSelected = 1'i32
    p.includesEntities = true
    p.order = orderNearest
    addAlivePredicate = true
  elif c == int32(ord('p')):
    p.maxSelected = 1'i32
    p.includesEntities = false
    p.order = orderNearest
    limitToPlayers(p)
  elif c == int32(ord('r')):
    p.maxSelected = 1'i32
    p.includesEntities = false
    p.order = orderRandom
    limitToPlayers(p)
  elif c == int32(ord('s')):
    p.maxSelected = 1'i32
    p.includesEntities = true
    p.isCurrentEntity = true
  else:
    setCursor(r, i)
    return cmdFailVoid(create(unknownSelectorTypeErrorType(), r, text("@" & encodeCp(c))))
  if addAlivePredicate:
    p.predicates.add(EntitySelectorPredicate(kind: pkIsAlive))
  p.suggestions = psOpenOptions
  if peekIs(r, '['):
    skip(r)
    p.suggestions = psOptionsKeyOrClose
    return parseOptions(p, r)
  cmdOkVoid()

proc parseNameOrUuid(p: var EntitySelectorParser; r: var StringReader): CmdVoidResult =
  if canReadChar(r):
    p.suggestions = psName
  let i = cursor(r)
  let s = readString(r)
  if not s.isOk:
    return cmdFailVoid(s.error)
  let (ok, id) = parseStr(s.value)
  if ok:
    p.entityUuid = some(id)
    p.includesEntities = true
  else:
    if s.value.len == 0 or s.value.len > 16:
      setCursor(r, i)
      return cmdFailVoid(create(invalidNameOrUuidErrorType(), r))
    p.includesEntities = false
    p.playerName = some(s.value)
  p.maxSelected = 1'i32
  cmdOkVoid()

proc parse*(p: var EntitySelectorParser; r: var StringReader): CmdVoidResult =
  p.startPosition = cursor(r)
  p.suggestions = psNameOrSelector
  if peekIs(r, '@'):
    if not p.allowsSelectorVariable:
      return cmdFailVoid(create(selectorsNotAllowedErrorType(), r))
    skip(r)
    parseSelector(p, r)
  else:
    parseNameOrUuid(p, r)

proc parseAndConsume*(r: var StringReader; allowSelectors: bool): CmdResult[EntitySelector] =
  var p = newEntitySelectorParser(allowSelectors)
  let v = parse(p, r)
  if not v.isOk:
    return cmdFail[EntitySelector](v.error)
  cmdOk[EntitySelector](selector(p))

# ---- Suggestions --------------------------------------------------------------------------------------------------

proc suggestNames(p: EntitySelectorParser; builder: SuggestionsBuilder): SuggestionsBuilder =
  result = builder
  # `EntitySelectorOption::VALUES` leaves out `Name`.
  for option in esoName .. esoPredicate:
    if option == esoName:
      continue
    if optionName(option).startsWith(remainingLowercase(result)) and canUse(option, p):
      let key = "argument.entity.options." & optionName(option) & ".description"
      result = suggestWithTooltip(result, optionName(option) & "=", translateCross(key, key))

proc fillSelectorSuggestions(b: SuggestionsBuilder): SuggestionsBuilder =
  result = suggestWithTooltip(b, "@p", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_NEARESTPLAYER, JAVA_ARGUMENT_ENTITY_SELECTOR_NEARESTPLAYER))
  result = suggestWithTooltip(result, "@a", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_ALLPLAYERS, JAVA_ARGUMENT_ENTITY_SELECTOR_ALLPLAYERS))
  result = suggestWithTooltip(result, "@r", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_RANDOMPLAYER, JAVA_ARGUMENT_ENTITY_SELECTOR_RANDOMPLAYER))
  result = suggestWithTooltip(result, "@s", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_SELF, JAVA_ARGUMENT_ENTITY_SELECTOR_SELF))
  result = suggestWithTooltip(result, "@e", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_ALLENTITIES, JAVA_ARGUMENT_ENTITY_SELECTOR_ALLENTITIES))
  result = suggestWithTooltip(result, "@n", translateCross(JAVA_ARGUMENT_ENTITY_SELECTOR_NEARESTENTITY, JAVA_ARGUMENT_ENTITY_SELECTOR_NEARESTENTITY))

proc playerNames(b: SuggestionsBuilder; names: seq[string]): SuggestionsBuilder =
  result = b
  for n in names:
    result = filterAndSuggestOne(result, n)

proc fillSuggestions(p: EntitySelectorParser; builder0: SuggestionsBuilder; names: seq[string]): Suggestions =
  var builder = builder0
  case p.suggestions
  of psNothing:
    discard
  of psSelector:
    builder = append(builder, fillSelectorSuggestions(createOffset(builder, max(builder.start - 1, 0))))
  of psOpenOptions:
    builder = suggest(builder, "[")
  of psOptionsKeyOrClose:
    builder = suggest(builder, "]")
    builder = suggestNames(p, builder)
  of psName:
    builder = append(builder, playerNames(createOffset(builder, p.startPosition), names))
  of psOptionsKey:
    builder = suggestNames(p, builder)
  of psOptionsNextOrClose:
    builder = suggest(builder, ",")
    builder = suggest(builder, "]")
  of psNameOrSelector:
    builder = playerNames(builder, names)
    if p.allowsSelectorVariable:
      builder = fillSelectorSuggestions(builder)
  of psSort:
    builder = filterAndSuggest(builder, ["nearest", "furthest", "random", "arbitrary"])
  of psGamemode:
    var prefix = remainingLowercase(builder)
    var addNormal = not hasFlag(p, FlagGamemodeNotEqualsSet)
    var addInverted = true
    if prefix.len > 0:
      if prefix[0] == '!':
        addNormal = false
        prefix = prefix[1 ..< prefix.len]
      else:
        addInverted = false
    for gamemode in [Survival, Creative, Adventure, Spectator]:
      if name(gamemode).startsWith(prefix):
        if addInverted:
          builder = suggest(builder, "!" & name(gamemode))
        if addNormal:
          builder = suggest(builder, name(gamemode))
  build(builder)

proc listSelectorSuggestions*(context: CommandContext; builder: SuggestionsBuilder): Suggestions =
  var reader = newStringReader(builder.input)
  setCursor(reader, builder.start)
  var parser = newEntitySelectorParser(hasPermission(context.source, EntitySelectorPermission))
  discard parse(parser, reader)
  var names: seq[string] = @[]
  let server = context.source.server
  if server != nil and server.getAllPlayers != nil:
    let allPlayers = server.getAllPlayers()
    for player in allPlayers:
      names.add(player.gameProfile.name)
  fillSuggestions(parser, createOffset(builder, cursor(reader)), names)

# ---- argument_types/entity.rs -------------------------------------------------------------------------------------

proc isSingle(k: EntityArgumentKind): bool = k == eakEntity or k == eakPlayer
proc isPlayersOnly(k: EntityArgumentKind): bool = k == eakPlayer or k == eakPlayers

proc parseWithAllowSelectors(k: EntityArgumentKind; r: var StringReader; allowSelectors: bool): CmdResult[ArgValue] =
  let s = parseAndConsume(r, allowSelectors)
  if not s.isOk:
    return cmdFail[ArgValue](s.error)
  let sel = s.value
  if sel.maxSelected > 1'i32 and isSingle(k):
    setCursor(r, 0)
    return cmdFail[ArgValue](create(if isPlayersOnly(k): notSinglePlayerErrorType() else: notSingleEntityErrorType(), r))
  if sel.includesEntities and isPlayersOnly(k) and not sel.isCurrentEntity:
    setCursor(r, 0)
    return cmdFail[ArgValue](create(onlyPlayersAllowedErrorType(), r))
  let a: ArgValue = EntitySelectorValue(value: sel)
  cmdOk[ArgValue](a)

proc newEntityArgumentType*(kind: EntityArgumentKind): AnyArgumentType =
  let flags = (if isSingle(kind): EntityFlagOnlySingle else: 0'u8) or (if isPlayersOnly(kind): EntityFlagPlayersOnly else: 0'u8)
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atEntity, flags: flags),
    overrideSuggestion: none[SuggestionProviders](),
    examples: @["Herobrine", "98765", "@a", "@p[limit=2]", "@e[type=creeper]", "5e5677dc-bb96-4669-a4ab-60468b574e8e"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = parseWithAllowSelectors(kind, r, true),
    parseWithSourceProc: proc(r: var StringReader; source: CommandSource): CmdResult[ArgValue] {.closure.} =
      parseWithAllowSelectors(kind, r, hasPermission(source, EntitySelectorPermission)),
    listSuggestionsProc: listSelectorSuggestions)

proc selectorArg(c: CommandContext; name: string): CmdResult[EntitySelector] =
  var found = false
  let v = argumentOf(c, name, found)
  if not found:
    return cmdFail[EntitySelector](missingArgument(name))
  if not (v of EntitySelectorValue):
    return cmdFail[EntitySelector](wrongArgumentType(name))
  let typed = EntitySelectorValue(v)
  cmdOk[EntitySelector](typed.value)

proc getEntity*(c: CommandContext; name: string): CmdResult[CommandEntity] =
  let s = selectorArg(c, name)
  if not s.isOk:
    return cmdFail[CommandEntity](s.error)
  findSingleEntity(s.value, c.source)

proc getOptionalEntities*(c: CommandContext; name: string): CmdResult[seq[CommandEntity]] =
  let s = selectorArg(c, name)
  if not s.isOk:
    return cmdFail[seq[CommandEntity]](s.error)
  findEntities(s.value, c.source)

proc getEntities*(c: CommandContext; name: string): CmdResult[seq[CommandEntity]] =
  let e = getOptionalEntities(c, name)
  if e.isOk and e.value.len == 0:
    return cmdFail[seq[CommandEntity]](createWithoutContext(noEntitiesErrorType()))
  e

proc getPlayer*(c: CommandContext; name: string): CmdResult[CommandPlayer] =
  let s = selectorArg(c, name)
  if not s.isOk:
    return cmdFail[CommandPlayer](s.error)
  findSinglePlayer(s.value, c.source)

proc getOptionalPlayers*(c: CommandContext; name: string): CmdResult[seq[CommandPlayer]] =
  let s = selectorArg(c, name)
  if not s.isOk:
    return cmdFail[seq[CommandPlayer]](s.error)
  findPlayers(s.value, c.source)

proc getPlayers*(c: CommandContext; name: string): CmdResult[seq[CommandPlayer]] =
  let p = getOptionalPlayers(c, name)
  if p.isOk and p.value.len == 0:
    return cmdFail[seq[CommandPlayer]](createWithoutContext(noPlayersErrorType()))
  p

# ---- argument_types/range.rs --------------------------------------------------------------------------------------

proc newIntRangeArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atIntRange),
    overrideSuggestion: none[SuggestionProviders](), examples: @["8", "2..", "..-3", "-4..5"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let b = intBoundsFromReader(r)
      if not b.isOk:
        return cmdFail[ArgValue](b.error)
      let a: ArgValue = IntBoundsValue(value: b.value)
      cmdOk[ArgValue](a))

proc newFloatRangeArgumentType*(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atFloatRange),
    overrideSuggestion: none[SuggestionProviders](), examples: @["8", "8.0", "5..", "..-3.8", "-4.2..5", "0.1..0.2"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let b = doubleBoundsFromReader(r)
      if not b.isOk:
        return cmdFail[ArgValue](b.error)
      let a: ArgValue = DoubleBoundsValue(value: b.value)
      cmdOk[ArgValue](a))
