## Port of the `#[test]` blocks of pumpkin/src/command/argument_types/range.rs, plus known answers for the selector parser
## read off parser.rs and option.rs (upstream has no test of those).
import std/[assertions, options, syncio]
import ../util/math/bounds
import ../util/vector3
import cmderrors, string_reader, cmdtree, cmdsource, entity_selector

proc intOk(s: string; lo, hi: Option[int32]) =
  var r = newStringReader(s)
  let b = intBoundsFromReader(r)
  assert b.isOk
  assert min(b.value) == lo
  assert max(b.value) == hi

proc doubleOk(s: string; lo, hi: Option[float64]) =
  var r = newStringReader(s)
  let b = doubleBoundsFromReader(r)
  assert b.isOk
  assert min(b.value) == lo
  assert max(b.value) == hi

proc parseIntRanges() =
  intOk("-7", some(-7'i32), some(-7'i32))
  intOk("3..", some(3'i32), none[int32]())
  intOk("..4", none[int32](), some(4'i32))
  intOk("3..4", some(3'i32), some(4'i32))
  intOk("-0..0", some(0'i32), some(0'i32))
  var r = newStringReader("2..1")
  assert intBoundsFromReader(r).error.isType(swappedBoundsErrorType())

proc parseFloatRanges() =
  doubleOk("-1", some(-1.0), some(-1.0))
  doubleOk("-1.0", some(-1.0), some(-1.0))
  doubleOk("0.", some(0.0), some(0.0))
  doubleOk("3..", some(3.0), none[float64]())
  doubleOk("..4", none[float64](), some(4.0))
  doubleOk("3..4", some(3.0), some(4.0))
  doubleOk("0.9", some(0.9), some(0.9))
  doubleOk("0..9", some(0.0), some(9.0))
  doubleOk("0...9", some(0.0), some(0.9))
  var r = newStringReader("2..1")
  assert doubleBoundsFromReader(r).error.isType(swappedBoundsErrorType())

proc parseOk(s: string): EntitySelector =
  var r = newStringReader(s)
  let v = parseAndConsume(r, true)
  if not v.isOk:
    echo "expected ", s, " to parse"
    quit(1)
  assert cursor(r) == s.len
  v.value

proc parseErr(s: string; t: CommandErrorType) =
  var r = newStringReader(s)
  let v = parseAndConsume(r, true)
  assert not v.isOk
  assert v.error.isType(t)

proc selectors() =
  let a = parseOk("@a")
  assert a.maxSelected == int32.high and not a.includesEntities and a.order == orderArbitrary and a.usesSelectorVariable
  assert a.entityType == some("player")
  let e = parseOk("@e")
  assert e.includesEntities and e.predicates.len == 1 and e.predicates[0].kind == pkIsAlive
  let n = parseOk("@n")
  assert n.maxSelected == 1'i32 and n.order == orderNearest
  let p = parseOk("@p")
  assert p.maxSelected == 1'i32 and not p.includesEntities and p.order == orderNearest
  let random0 = parseOk("@r")
  assert random0.order == orderRandom
  let s = parseOk("@s")
  assert s.isCurrentEntity and s.includesEntities
  parseErr("@", missingSelectorTypeErrorType())
  parseErr("@q", unknownSelectorTypeErrorType())

proc options0() =
  let d = parseOk("@e[distance=..5]")
  assert d.isWorldLimited
  assert d.boundingBox.isSome
  let lim = parseOk("@e[limit=3,sort=random]")
  assert lim.maxSelected == 3'i32 and lim.order == orderRandom
  let g = parseOk("@a[gamemode=!creative]")
  assert g.predicates[g.predicates.len - 1].kind == pkGameMode and g.predicates[g.predicates.len - 1].invert
  # DEVIATION from upstream: vanilla accepts namespaced ids, `type=!pig`, `#tags`, quoted names and namespaced
  # advancements. Upstream's `read_unquoted_string` stops at `:` so it rejects `minecraft:creeper`.
  let mc = parseOk("@e[type=minecraft:creeper]")
  assert mc.entityType == some("creeper")
  let inv = parseOk("@e[type=!minecraft:pig]")
  assert inv.predicates[inv.predicates.len - 1].kind == pkEntityType and inv.predicates[inv.predicates.len - 1].invert
  assert inv.predicates[inv.predicates.len - 1].str == "pig"
  let tg = parseOk("@e[type=#minecraft:undead]")
  assert tg.predicates[tg.predicates.len - 1].str == "#undead"
  parseErr("@e[type=#minecraft:nonexistent_tag]", typeInvalidErrorType())
  parseErr("@e[type=minecraft:nonexistent]", typeInvalidErrorType())
  let nm = parseOk("@e[name=\"Hello World\",team=red,tag=foo:bar]")
  assert nm.predicates[1].str == "Hello World" and nm.predicates[2].str == "red" and nm.predicates[3].str == "foo:bar"
  let adv = parseOk("@a[advancements={minecraft:story/root=true}]")
  assert adv.predicates[adv.predicates.len - 1].advancementNames == @["minecraft:story/root"]
  let gm2 = parseOk("@a[gamemode=minecraft:creative]")
  assert gm2.predicates[gm2.predicates.len - 1].kind == pkGameMode
  let t = parseOk("@e[type=creeper]")
  assert t.entityType == some("creeper")
  let sc = parseOk("@a[scores={a=1,b=2..3}]")
  assert sc.predicates[sc.predicates.len - 1].kind == pkScores
  assert sc.predicates[sc.predicates.len - 1].scoreNames == @["a", "b"]
  let ad = parseOk("@a[advancements={story=true}]")
  assert ad.predicates[ad.predicates.len - 1].kind == pkAdvancements
  parseErr("@e[bogus=1]", unknownOptionErrorType())
  parseErr("@e[limit=0]", limitTooSmallErrorType())
  parseErr("@e[limit=1,limit=2]", inapplicableOptionErrorType())
  parseErr("@s[limit=1]", inapplicableOptionErrorType())
  parseErr("@e[distance=..-1]", distanceNegativeErrorType())
  parseErr("@e[level=..-1]", levelNegativeErrorType())
  parseErr("@e[sort=up]", sortUnknownErrorType())
  parseErr("@e[gamemode=nope]", gamemodeInvalidErrorType())
  parseErr("@e[type=nope]", typeInvalidErrorType())
  parseErr("@e[limit]", expectedOptionValueErrorType())
  parseErr("@e[limit=1", expectedEndOfOptionsErrorType())

proc names() =
  let n = parseOk("Herobrine")
  assert n.playerName == some("Herobrine") and not n.includesEntities and n.maxSelected == 1'i32
  let u = parseOk("5e5677dc-bb96-4669-a4ab-60468b574e8e")
  assert u.entityUuid.isSome and u.includesEntities
  parseErr("abcdefghijklmnopq", invalidNameOrUuidErrorType())

proc argumentRules() =
  # `@a` on a single-entity argument fails with the cursor reset to 0, as parse_with_allow_selectors does.
  let at0 = newEntityArgumentType(eakEntity)
  var r = newStringReader("@a")
  let v = at0.parseProc(r)
  assert not v.isOk and v.error.isType(notSingleEntityErrorType())
  assert cursor(r) == 0
  let at1 = newEntityArgumentType(eakPlayers)
  var r2 = newStringReader("@e")
  let v2 = at1.parseProc(r2)
  assert not v2.isOk and v2.error.isType(onlyPlayersAllowedErrorType())
  # A dummy source has no permission for selectors, so parse_with_source refuses them.
  var r3 = newStringReader("@e")
  let v3 = at1.parseWithSourceProc(r3, dummySource())
  assert not v3.isOk and v3.error.isType(selectorsNotAllowedErrorType())

parseIntRanges()
parseFloatRanges()
selectors()
options0()
names()
argumentRules()
echo "entity_selector: all checks passed"
