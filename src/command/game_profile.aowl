## The brigadier game-profile argument.
## Port of pumpkin/src/command/argument_types/game_profile.rs

import ../util/closureset
import std/[options, strutils]
import ../protocol/java/client/play/commands
import ../util/uuid
import ../generated/translation
import cmderrors, string_reader, suggestion, cmdsource, cmdtree, entity_selector, args

type
  GameProfileResultKind* = enum
    gprSelector
    gprName
    gprUuid

  GameProfileResult* = ref object of ArgValue
    kind*: GameProfileResultKind
    selector*: nil EntitySelector
    name*: string
    uuid*: Uuid

proc unknownPlayerErrorType*(): CommandErrorType = errorType0(JAVA_ARGUMENT_PLAYER_UNKNOWN, JAVA_ARGUMENT_PLAYER_UNKNOWN)

proc unknownPlayer(): CommandSyntaxError = createWithoutContext(unknownPlayerErrorType())

proc resolve*(r: GameProfileResult; source: CommandSource; res: var seq[CmdGameProfile]): CmdVoidResult =
  if r.kind == gprSelector:
    let selector = r.selector
    if selector == nil:
      return cmdFailVoid(unknownPlayer())
    let players = findPlayers(selector, source)
    if not players.isOk:
      return cmdFailVoid(players.error)
    for p in players.value:
      res.add(p.gameProfile)
    return cmdOkVoid()
  if r.kind == gprName:
    let server = source.server
    if server == nil:
      return cmdFailVoid(unknownPlayer())
    if closureSet(server.getPlayerByName):
      let player = server.getPlayerByName(r.name)
      if player != nil:
        res.add(player.gameProfile)
        return cmdOkVoid()
    var profile = CmdGameProfile()
    if closureSet(server.userCacheGetByName) and server.userCacheGetByName(r.name, profile):
      res.add(profile)
      return cmdOkVoid()
    if resolveKnownProfileByName(server, r.name, profile):
      res.add(profile)
      return cmdOkVoid()
    if closureSet(server.onlineMode) and server.onlineMode():
      if closureSet(server.lookupProfileByName) and server.lookupProfileByName(r.name, profile):
        if closureSet(server.userCacheUpsert):
          server.userCacheUpsert(profile.id, profile.name)
        res.add(profile)
        return cmdOkVoid()
      return cmdFailVoid(unknownPlayer())
    var offline = Uuid()
    if closureSet(server.offlineUuid) and server.offlineUuid(r.name, offline):
      if closureSet(server.userCacheUpsert):
        server.userCacheUpsert(offline, r.name)
      res.add(CmdGameProfile(id: offline, name: r.name))
      return cmdOkVoid()
    return cmdFailVoid(unknownPlayer())
  if r.kind == gprUuid:
    let server = source.server
    if server == nil:
      return cmdFailVoid(unknownPlayer())
    if closureSet(server.getPlayerByUuid):
      let player = server.getPlayerByUuid(r.uuid)
      if player != nil:
        res.add(player.gameProfile)
        return cmdOkVoid()
    var profile = CmdGameProfile()
    if closureSet(server.userCacheGetByUuid) and server.userCacheGetByUuid(r.uuid, profile):
      res.add(profile)
      return cmdOkVoid()
    if resolveKnownProfileByUuid(server, r.uuid, profile):
      res.add(profile)
      return cmdOkVoid()
    return cmdFailVoid(unknownPlayer())
  cmdFailVoid(unknownPlayer())

proc parseWithAllowSelectors(r: var StringReader; allowSelectors: bool): CmdResult[ArgValue] =
  if peekIs(r, '@'):
    let s = parseAndConsume(r, allowSelectors)
    if not s.isOk:
      return cmdFail[ArgValue](s.error)
    if s.value.includesEntities:
      return cmdFail[ArgValue](create(onlyPlayersAllowedErrorType(), r))
    let a: ArgValue = GameProfileResult(kind: gprSelector, selector: s.value)
    return cmdOk[ArgValue](a)
  let i = cursor(r)
  while canReadChar(r) and not peekIs(r, ' '):
    skip(r)
  let str0 = r.str[i ..< cursor(r)]
  let (ok, id) = parseStr(str0)
  if ok:
    let a: ArgValue = GameProfileResult(kind: gprUuid, uuid: id)
    return cmdOk[ArgValue](a)
  let a: ArgValue = GameProfileResult(kind: gprName, name: str0)
  cmdOk[ArgValue](a)

proc newGameProfileArgumentType*(): AnyArgumentType =
  ## Upstream leaves `parse_with_source` at its default, so selectors are always allowed at parse time; the permission
  ## is checked when the selector runs.
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atGameProfile), overrideSuggestion: none[SuggestionProviders](),
    examples: @["Herobrine", "98765", "@a", "@p[limit=2]"],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} = parseWithAllowSelectors(r, true),
    listSuggestionsProc: listSelectorSuggestions)

proc getGameProfiles*(c: CommandContext; name: string; res: var seq[CmdGameProfile]): CmdVoidResult =
  ## `GameProfileArgumentType::get`.
  var found = false
  let v = argumentOf(c, name, found)
  if not found:
    return cmdFailVoid(missingArgument(name))
  if not (v of GameProfileResult):
    return cmdFailVoid(wrongArgumentType(name))
  let typed = GameProfileResult(v)
  resolve(typed, c.source, res)
