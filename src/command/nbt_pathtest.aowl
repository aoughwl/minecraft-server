## Known-answer checks for nbt_path.aowl, worked out from nbt_path.rs (it has no #[test] of its own).
import std/[assertions, syncio]
import ../nbt/tag
import ../util/text/text
import cmderrors, string_reader, snbt, nbt_path

var failures = 0

proc chk(cond: bool; what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc tagInt(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)

proc parseTag(s: string): NbtTag =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if not v.isOk:
    echo "bad snbt ", s
    inc failures
    return NbtTag(kind: ntkEnd)
  v.value

proc parsePath(s: string; p: var NbtPath): bool =
  var r = newStringReader(s)
  let v = parseNbtPath(r)
  if not v.isOk:
    return false
  p = v.value
  cursor(r) == s.len

proc pathOk(s: string): bool =
  var p = NbtPath()
  parsePath(s, p)

proc run() =
  let root0 = parseTag("{a:{b:[{id:1,n:\"x\"},{id:2,n:\"y\"},{id:3}]},c:[1,2,3],s:\"hi\"}")
  var p = NbtPath()
  chk(parsePath("a.b[0].n", p), "parse a.b[0].n")
  chk(p.nodes.len == 4 and p.nodes[0].kind == npnCompoundChild and p.nodes[2].kind == npnIndexedElement and p.nodes[2].index == 0, "nodes")
  chk(p.nodeToOriginalPosition == @[1, 3, 6, 8], "positions")
  let g = get(p, root0)
  chk(g.isOk and g.value.len == 1 and g.value[0] == parseTag("\"x\""), "get a.b[0].n")
  chk(parsePath("a.b[-1].id", p), "parse negative index")
  let g2 = get(p, root0)
  chk(g2.isOk and g2.value.len == 1 and g2.value[0] == tagInt(3'i32), "get a.b[-1].id")
  chk(parsePath("a.b[].id", p), "parse wildcard")
  let g3 = get(p, root0)
  chk(g3.isOk and g3.value.len == 3, "get a.b[].id is 3")
  chk(parsePath("a.b[{id:2}].n", p), "parse filter")
  let g4 = get(p, root0)
  chk(g4.isOk and g4.value.len == 1 and g4.value[0] == parseTag("\"y\""), "get filter")
  chk(parsePath("{s:\"hi\"}", p), "parse root match")
  chk(get(p, root0).isOk, "root match hits")
  chk(parsePath("{s:\"no\"}", p), "parse root match miss")
  chk(not get(p, root0).isOk, "root match misses")
  chk(parsePath("a.b[{id:1}]", p), "p")
  chk(get(p, root0).value.len == 1, "match element")
  chk(parsePath("a{b:[{id:1}]}", p), "parse match object")
  chk(get(p, root0).isOk, "match object compares list as subset")
  chk(parsePath("c[1]", p), "p")
  chk(get(p, root0).value[0] == tagInt(2'i32), "c[1]")
  # nothing found error text is the path prefix up to the failing node
  chk(parsePath("a.zz.q", p), "p")
  let miss = get(p, root0)
  chk(not miss.isOk and getText(miss.error.message).len > 0, "not found")
  chk(countMatching(p, root0) == 0, "count 0")
  chk(parsePath("a.b[]", p) and countMatching(p, root0) == 3, "count 3")
  # parse errors
  chk(not pathOk(""), "empty path invalid")
  chk(not pathOk("a.{b:1}"), "braces only first")
  chk(not pathOk("a..b"), "double dot")
  chk(pathOk("\"a b\".c"), "quoted name")
  chk(pathOk("[0]"), "leading index")
  chk(pathOk("[]"), "leading wildcard")
  # set
  var t = root0
  chk(parsePath("a.b[0].n", p), "p")
  var sr = set(p, t, parseTag("\"z\""))
  chk(sr.isOk and sr.value == 1, "set changes 1")
  chk(get(p, t).value[0] == parseTag("\"z\""), "set took")
  sr = set(p, t, parseTag("\"z\""))
  chk(sr.isOk and sr.value == 0, "set same is 0")
  chk(parsePath("new.deep[].k", p), "p")
  sr = set(p, t, tagInt(5'i32))
  chk(sr.isOk and sr.value == 1, "set creates parents")
  chk(get(p, t).isOk and get(p, t).value[0] == tagInt(5'i32), "created tree reads back")
  chk(parsePath("c[]", p), "p")
  sr = set(p, t, tagInt(9'i32))
  chk(sr.isOk and sr.value == 3, "set [] counts the changed")
  chk(parseTag("{a:{b:[{id:1,n:\"z\"},{id:2,n:\"y\"},{id:3}]},c:[9,9,9],s:\"hi\",new:{deep:[{k:5}]}}") == t, "tree after sets")
  # merge keeps the entries the source does not name
  var m = parseTag("{a:{x:1,y:2},l:[{k:1},{k:2}]}")
  chk(parsePath("a", p), "p")
  sr = set(p, m, parseTag("{y:5,z:6}"), true)
  chk(sr.isOk and sr.value == 1, "merge count")
  chk(m == parseTag("{a:{x:1,y:5,z:6},l:[{k:1},{k:2}]}"), "merge result")
  sr = set(p, m, parseTag("{y:5}"), true)
  chk(sr.isOk and sr.value == 0, "merge unchanged")
  chk(parsePath("l[]", p), "p")
  sr = set(p, m, parseTag("{w:0}"), true)
  chk(sr.isOk and sr.value == 2, "merge every element")
  chk(m == parseTag("{a:{x:1,y:5,z:6},l:[{k:1,w:0},{k:2,w:0}]}"), "merge elements")
  # insert
  var u = parseTag("{l:[1,2,3]}")
  chk(parsePath("l", p), "p")
  var ir = insert(p, 1'i32, u, @[tagInt(7'i32), tagInt(8'i32)])
  chk(ir.isOk and ir.value == 1, "insert count")
  chk(u == parseTag("{l:[1,7,8,2,3]}"), "insert at 1")
  ir = insert(p, -1'i32, u, @[tagInt(0'i32)])
  chk(u == parseTag("{l:[1,7,8,2,3,0]}"), "insert -1 appends")
  ir = insert(p, 99'i32, u, @[tagInt(0'i32)])
  chk(not ir.isOk, "insert out of range fails")
  chk(parsePath("s", p), "p")
  var u2 = parseTag("{s:\"x\"}")
  ir = insert(p, 0'i32, u2, @[tagInt(1'i32)])
  chk(not ir.isOk, "insert into non list fails")
  chk(parsePath("fresh", p), "p")
  ir = insert(p, 0'i32, u2, @[tagInt(1'i32)])
  chk(ir.isOk and u2 == parseTag("{s:\"x\",fresh:[1]}"), "insert creates list")
  # remove
  var v = root0
  chk(parsePath("a.b[{id:2}]", p), "p")
  chk(remove(p, v) == 1, "remove element")
  chk(parseTag("{a:{b:[{id:1,n:\"x\"},{id:3}]},c:[1,2,3],s:\"hi\"}") == v, "after remove")
  chk(parsePath("c[0]", p), "p")
  chk(remove(p, v) == 1, "remove index")
  chk(parsePath("c[]", p), "p")
  chk(remove(p, v) == 2, "remove all counts")
  chk(parsePath("nothing.here", p), "p")
  chk(remove(p, v) == 0, "remove missing")
  # compare
  chk(compareNbt(parseTag("{a:1}"), parseTag("{a:1,b:2}")), "compound subset")
  chk(not compareNbt(parseTag("{a:2}"), parseTag("{a:1,b:2}")), "compound mismatch")
  chk(compareNbt(parseTag("[]"), parseTag("[]")), "empty lists")
  chk(not compareNbt(parseTag("[]"), parseTag("[1]")), "empty list vs full")
  chk(compareNbt(parseTag("[2]"), parseTag("[1,2]")), "list subset")
  chk(not compareNbt(parseTag("[2,3]"), parseTag("[2]")), "list longer than target")
  # depth
  var deep = tagInt(1'i32)
  for _ in 0 ..< 600:
    deep = NbtTag(kind: ntkList, listVal: @[deep])
  chk(isTooDeep(deep, 0), "too deep")
  chk(not isTooDeep(parseTag("{a:[1]}"), 0), "shallow")

run()
if failures > 0:
  echo "nbt_pathtest: ", failures, " FAILED"
  quit(1)
echo "nbt_pathtest ok"
