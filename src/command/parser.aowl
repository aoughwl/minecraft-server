## Error and suggestion bookkeeping for a parser that tries several rules from one spot: the error furthest along wins.
## Port of pumpkin/src/command/parser.rs
##
## `store` merges the suggestions of everything that failed at the same cursor. The `Parser` trait's helpers take the
## reader directly here, since a parser owns its reader.

import ../util/text/textbase, ../util/text/text
import cmderrors, string_reader

type
  DelayedCommandSyntaxError* = object
    errorType*: CommandErrorType
    arguments*: seq[string]

  ParserErrors* = object
    cursor*: int
    hasCommandError*: bool
    commandError*: DelayedCommandSyntaxError
    suggestions*: seq[string]

proc store(e: var ParserErrors; r: StringReader; errorType: CommandErrorType; arguments, suggestions: seq[string]) =
  let current = e.cursor
  let new0 = cursor(r)
  if not e.hasCommandError or new0 > current:
    e.hasCommandError = true
    e.commandError = DelayedCommandSyntaxError(errorType: errorType, arguments: arguments)
    e.cursor = new0
    e.suggestions = suggestions
  elif new0 == current:
    for s in suggestions:
      e.suggestions.add(s)

proc storeSimpleError*(e: var ParserErrors; r: StringReader; t: CommandErrorType) =
  store(e, r, t, @[], @[])

proc storeSimpleErrorAndSuggest*(e: var ParserErrors; r: StringReader; t: CommandErrorType; suggestions: seq[string]) =
  store(e, r, t, @[], suggestions)

proc storeDynamicError*(e: var ParserErrors; r: StringReader; t: CommandErrorType; arg1: string) =
  store(e, r, t, @[arg1], @[])

proc storeDynamicErrorAndSuggest*(e: var ParserErrors; r: StringReader; t: CommandErrorType; arg1: string; suggestions: seq[string]) =
  store(e, r, t, @[arg1], suggestions)

proc messageOfDelayed*(d: DelayedCommandSyntaxError): TextComponent =
  var args: seq[TextComponent] = @[]
  for a in d.arguments:
    args.add(text(a))
  translateCross(d.errorType.javaTranslationKey, d.errorType.bedrockTranslationKey, args)
