## The legacy players argument consumer on the brigadier selector engine: options such as `distance`, `advancements`
## (with criteria) and `gamemode` apply, and `@e` is refused.
import std/[options, syncio]
import ../util/[uuid, vector2, vector3, gamemode, permission]
import ../util/math/boundingbox
import ../util/text/[textbase, text]
import cmderrors, cmdsource, fallbackdispatch, args, string_reader, entity_selector

var failures = 0

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAIL ", what
    inc failures

proc makePlayer(name: string; px: float64; mode: GameMode; world: CommandWorld; doneCriterion: bool): CommandPlayer =
  let p = CommandPlayer(gameProfile: CmdGameProfile(name: name))
  p.entity = CommandEntity(entityTypeId: "minecraft:player", player: p,
    getName: proc(): TextComponent {.closure.} = text(name),
    getDisplayName: proc(): TextComponent {.closure.} = text(name),
    getPos: proc(): Vector3[float64] {.closure.} = Vector3[float64](x: px, y: 0.0, z: 0.0),
    isAlive: proc(): bool {.closure.} = true,
    getBoundingBox: proc(): BoundingBox {.closure.} = newBoundingBox(Vector3[float64](x: px - 0.3, y: -0.5, z: -0.3), Vector3[float64](x: px + 0.3, y: 1.5, z: 0.3)),
    getRotation: proc(): Vector2[float32] {.closure.} = Vector2[float32](x: 0.0'f32, y: 0.0'f32),
    getWorld: proc(): nil CommandWorld {.closure.} = world)
  p.hasPermission = proc(node: string): bool {.closure.} = true
  p.getPermissionLvl = proc(): PermissionLvl {.closure.} = Four
  p.getGameMode = proc(): GameMode {.closure.} = mode
  p.isAdvancementDone = proc(id: string; exists: var bool): bool {.closure.} =
    exists = true
    false
  p.isAdvancementCriterionDone = proc(id, criterion: string; exists: var bool): bool {.closure.} =
    exists = criterion == "crit"
    doneCriterion
  p

proc consume(server: CommandServer; sender: CommandSender; input: string; players: var seq[CommandPlayer]): CmdVoidResult =
  var args: RawArgs = @[RawArg(value: input, start: 0, `end`: input.len, input: input)]
  var res = Arg()
  var found = false
  let consumer = newPlayersArgumentConsumer()
  let r = consumer.consumeWithSyntax(sender, server, args, res, found)
  if r.isOk and found and res.kind == akPlayers:
    players = res.players
  r

proc main() =
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  let near = makePlayer("Near", 2.0, Survival, world, true)
  let far = makePlayer("Far", 50.0, Creative, world, false)
  let all = @[near, far]
  world.getPlayers = proc(): seq[CommandPlayer] {.closure.} = all
  world.getEntities = proc(): seq[CommandEntity] {.closure.} = @[near.entity, far.entity]
  let server = CommandServer(opPermissionLevel: Four)
  let worlds = @[world]
  server.getWorlds = proc(): seq[CommandWorld] {.closure.} = worlds
  server.getOverworld = proc(): nil CommandWorld {.closure.} = world
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = all
  let sender = senderPlayer(near)
  var got: seq[CommandPlayer] = @[]
  check(consume(server, sender, "@a", got).isOk and got.len == 2, "@a is both players")
  check(consume(server, sender, "@a[distance=..10]", got).isOk and got.len == 1 and got[0].gameProfile.name == "Near", "distance option")
  check(consume(server, sender, "@a[gamemode=creative]", got).isOk and got.len == 1 and got[0].gameProfile.name == "Far", "gamemode option")
  check(consume(server, sender, "@a[advancements={minecraft:story/root={crit=true}}]", got).isOk and got.len == 1 and
    got[0].gameProfile.name == "Near", "advancement criterion option")
  check(consume(server, sender, "@a[advancements={minecraft:story/root={crit=false}}]", got).isOk and got.len == 1 and
    got[0].gameProfile.name == "Far", "criterion not done")
  check(consume(server, sender, "@s", got).isOk and got.len == 1 and got[0].gameProfile.name == "Near", "@s is the sender")
  let notPlayers = consume(server, sender, "@e", got)
  check(not notPlayers.isOk, "@e is refused by a players argument")
  check(not consume(server, sender, "@a[bogus=1]", got).isOk, "an unknown option is an error")

  if failures > 0:
    echo "playersargtest: ", failures, " FAILED"
    quit(1)

main()
echo "playersargtest ok"
