## Port of the #[test]s of score_holder.rs and operation.rs (newer tree), vectors unchanged.
import std/[options, syncio]
import cmderrors, cmdsource, cmdtree, string_reader, entity_selector, score_holder
import ../util/text/[textbase, text]

var failures = 0

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAIL ", what
    inc failures

proc holderOf(multiple: bool; input: string; reader: var StringReader): CmdResult[ArgValue] =
  reader = newStringReader(input)
  newScoreHolderArgumentType(multiple).parseProc(reader)

proc holderValue(v: ArgValue): ScoreHolder = ScoreHolderValue(v).value

proc literalNamesParseAsNames() =
  for name in ["detectGen", "#temp", "$x", "map:counter", "*suffix", "日本語"]:
    var r = newStringReader("")
    let res = holderOf(true, name & " objective", r)
    check(res.isOk and holderValue(res.value).kind == shName and holderValue(res.value).name == name, "name " & name)
    check(remainingPart(r) == " objective", "remaining after " & name)

proc starIsWildcard() =
  var r = newStringReader("")
  let res = holderOf(true, "*", r)
  check(res.isOk and holderValue(res.value).kind == shWildcard, "* is the wildcard")
  check(remainingLength(r) == 0, "* consumed")

proc selectorsParse() =
  var r = newStringReader("")
  let res = holderOf(true, "@s", r)
  check(res.isOk and holderValue(res.value).kind == shSelector, "@s is a selector")

proc singleRejectsMany() =
  for sel in ["@a", "@e", "@p[limit=2]"]:
    var r = newStringReader("")
    let res = holderOf(false, sel, r)
    check(not res.isOk and res.error.isType(notSingleEntityErrorType()), "single rejects " & sel)
    check(cursor(r) == sel.len, "cursor after " & sel)
  for sel in ["@s", "@p", "@e[limit=1]", "#temp"]:
    var r = newStringReader("")
    check(holderOf(false, sel, r).isOk, "single accepts " & sel)
  check(newScoreHolderArgumentType(false).clientParser.flags == 0'u8, "single has no multiple flag")
  check(newScoreHolderArgumentType(true).clientParser.flags == 1'u8, "multiple flag")

proc emptyIsNotAName() =
  for input in ["", " objective"]:
    var r = newStringReader("")
    check(not holderOf(true, input, r).isOk, "empty input " & input)

proc operationMath() =
  var r = 0'i32
  proc ap(op: ScoreboardOperation; a, b: int32): int32 =
    var x = 0'i32
    discard applyOperation(op, a, b, x)
    x
  check(ap(soAssign, 7, 3) == 3, "assign")
  check(ap(soPlus, 7, 3) == 10, "plus")
  check(ap(soMinus, 7, 3) == 4, "minus")
  check(ap(soMultiply, 7, 3) == 21, "multiply")
  check(ap(soDivide, 7, 2) == 3, "divide")
  check(ap(soDivide, -5, 3) == -2, "floor divide -5/3")
  check(ap(soDivide, 5, -3) == -2, "floor divide 5/-3")
  check(ap(soModulo, 7, 2) == 1, "modulo")
  check(ap(soModulo, -5, 4) == 3, "floor modulo -5%4")
  check(ap(soModulo, 5, -4) == -3, "floor modulo 5%-4")
  check(ap(soSwap, 7, 3) == 3, "swap")
  check(ap(soMin, 7, 3) == 3, "min")
  check(ap(soMax, 7, 3) == 7, "max")
  check(ap(soDivide, int32.low, -1'i32) == int32.low, "min / -1 wraps")
  check(ap(soModulo, int32.low, -1'i32) == 0'i32, "min % -1")
  check(ap(soDivide, int32.high, 1'i32) == int32.high, "max / 1")
  for op in [soDivide, soModulo]:
    let e = applyOperation(op, 7'i32, 0'i32, r)
    check(not e.isOk and e.error.isType(divideByZeroError()), "divide by zero")
    check(getText(e.error.message) == "Cannot divide by zero", "div0 text")

proc parseOp(input: string; rest: var string): CmdResult[ArgValue] =
  var r = newStringReader(input)
  let res = newOperationArgumentType().parseProc(r)
  rest = remainingPart(r)
  res

proc operationParsing() =
  for (sym, op) in [("+=", soPlus), ("-=", soMinus), ("*=", soMultiply), ("/=", soDivide), ("%=", soModulo),
      ("><", soSwap), ("=", soAssign), ("<", soMin), (">", soMax)]:
    var rest = ""
    let res = parseOp(sym & " source", rest)
    check(res.isOk and OperationValue(res.value).value == op, "parse " & sym)
    check(rest == " source", "did not consume " & sym)
  for token in ["", "+", "<=", ">=", "==", "+=extra", "><>"]:
    var rest = ""
    let res = parseOp(token, rest)
    check(not res.isOk and res.error.isType(invalidOperationError()), "reject " & token)
    check(getText(res.error.message) == "Invalid operation", "invalid text for " & token)

literalNamesParseAsNames()
starIsWildcard()
selectorsParse()
singleRejectsMany()
emptyIsNotAName()
operationMath()
operationParsing()
if failures > 0:
  echo "score_holdertest: ", failures, " FAILED"
  quit(1)
echo "score_holdertest ok"
