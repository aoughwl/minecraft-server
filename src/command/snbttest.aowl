## Port of pumpkin/src/command/snbt/tests.rs. Generated from it, so the vectors are upstream's, unchanged.
import std/[assertions, syncio]
import ../nbt/tag
import ../util/text/text
import cmderrors, string_reader, suggestion, snbt

const BuiltIn = @["(", "bool", "false", "true", "uuid"]

proc tagInt(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)
proc tagByte(v: int8): NbtTag = NbtTag(kind: ntkByte, byteVal: v)
proc tagShort(v: int16): NbtTag = NbtTag(kind: ntkShort, shortVal: v)
proc tagLong(v: int64): NbtTag = NbtTag(kind: ntkLong, longVal: v)
proc tagFloat(v: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: v)
proc tagDouble(v: float64): NbtTag = NbtTag(kind: ntkDouble, doubleVal: v)
proc tagStr(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)
proc tagList(v: seq[NbtTag]): NbtTag = NbtTag(kind: ntkList, listVal: v)
proc tagInts(v: seq[int32]): NbtTag = NbtTag(kind: ntkIntArray, intArrayVal: v)
proc tagLongs(v: seq[int64]): NbtTag = NbtTag(kind: ntkLongArray, longArrayVal: v)
proc tagBytes(v: seq[int8]): NbtTag = NbtTag(kind: ntkByteArray, byteArrayVal: v)
proc tagMap(v: seq[(string, NbtTag)]): NbtTag =
  var c = newCompound()
  for (k, t) in v:
    insert(c, k, t)
  NbtTag(kind: ntkCompound, compoundVal: c)

var failures = 0

proc fail(s, why: string) =
  echo "FAIL ", s, ": ", why
  inc failures

proc okTag(s: string; want: NbtTag) =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if not v.isOk:
    fail(s, "error: " & getText(v.error.message))
  elif not (v.value == want):
    fail(s, "wrong tag")
  elif cursor(r) != s.len:
    fail(s, "trailing data")

proc okTrailing(s, trailing: string) =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if not v.isOk:
    fail(s, "error: " & getText(v.error.message))
  elif remainingPart(r) != trailing:
    fail(s, "trailing was: " & remainingPart(r))

proc err(s, message: string; cursor0: int) =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if v.isOk:
    fail(s, "expected an error")
  elif getText(v.error.message) != message:
    fail(s, "message was: " & getText(v.error.message))
  elif v.error.context.cursor != cursor0:
    fail(s, "cursor was: " & $v.error.context.cursor)

proc err(s, message: string; cursor0: int; want: seq[string]) =
  err(s, message, cursor0)
  var got: seq[string] = @[]
  let sg = parseForSuggestions(newSuggestionsBuilder(s, 0))
  for x in sg.suggestions:
    got.add(textAsString(x))
  if got != want:
    var text0 = ""
    for g in got:
      text0.add(g & " ")
    fail(s, "suggestions were: " & text0)

proc integers() =
  okTag("9", tagInt(9'i32))
  okTag("5_0_0_0", tagInt(5000'i32))
  err("5_0_0_0_", "Expected literal (", 8, BuiltIn)
  err("5_0_0_0_", "Expected literal (", 8, BuiltIn)
  okTag("3ub", tagByte(3'i8))
  okTag("-7s", tagShort(-7'i16))
  okTag("255uB", tagByte(-1'i8))
  err("256ub", "Failed to parse number: out of range: 256", 5, @[])
  okTag("256ss", tagShort(256'i16))
  okTag("256 s s", tagShort(256'i16))
  err("3_000_000_000", "Expected literal .", 13, @[
            ".", "b", "B", "d", "D", "e", "E", "f", "F", "i", "I", "l", "L", "s", "S", "u", "U"
        ])
  okTag("+3_000_000_000uI", tagInt(-1294967296'i32))
  okTag("+3_000_000_000s L", tagLong(3000000000'i64))
  okTag("-3_000_000_000 sL", tagLong(-3000000000'i64))
  err("-3_000_000_000i", "Failed to parse number: For input string: \"-3000000000\"", 15, @[])
  err("-3_000_000_000UI", "Expected a non-negative number", 16, @[])
  err("00", "Expected literal .", 2, @[
            "(", ".", "bool", "d", "D", "e", "E", "f", "F", "false", "true", "uuid"
        ])
  err("0x", "Expected a hexadecimal number", 2, BuiltIn)
  okTag("0b", tagByte(0'i8))
  okTag("0b10101", tagInt(21'i32))
  okTag("0X111", tagInt(273'i32))
  err("0x_111", "Expected literal (", 6, BuiltIn)
  err("0xAbCdEfs", "Expected literal b|B", 9, @["b", "B", "i", "I", "l", "L", "s", "S"])
  okTrailing("0xABCDEFG", "G")
  okTag("0xABCDUS", tagShort(-21555'i16))
  okTag("0xABB", tagInt(2747'i32))

proc floats() =
  okTag("0.", tagDouble(0.0'f64))
  okTag("0.f", tagFloat(0.0'f32))
  okTag("0.D", tagDouble(0.0'f64))
  okTag(".0", tagDouble(0.0'f64))
  okTag(".0F", tagFloat(0.0'f32))
  okTag(".0d", tagDouble(0.0'f64))
  okTag("1.024", tagDouble(1.024'f64))
  err("1_.024", "Expected literal (", 6, BuiltIn)
  okTrailing("1._024", "_024")
  okTag("1.0_2_4", tagDouble(1.024'f64))
  okTag("1e1", tagDouble(10.0'f64))
  okTag("2e+2", tagDouble(200.0'f64))
  okTag("4e-2", tagDouble(0.04'f64))
  okTag("4e-2", tagDouble(0.04'f64))
  okTag("0E100_000_000", tagDouble(0.0'f64))
  okTrailing("0.1e100_000_000", ".1e100_000_000")
  okTag("0.1e-100_000_000", tagDouble(0.0'f64))
  okTag("1e38f", tagFloat(1.0e38'f32))
  okTrailing("1e39f", "e39f")
  okTag("1e39", tagDouble(1.0e39'f64))
  okTag("0.001e41f", tagFloat(1.0e38'f32))
  okTrailing("0.01E41f", ".01E41f")
  okTag("1.28E308", tagDouble(1.28E308'f64))
  okTrailing("1.8e308", ".8e308")
  okTrailing("1.E", "E")
  okTag("2000f", tagFloat(2000.0'f32))
  okTag("70d", tagDouble(70.0'f64))
  okTag("03f", tagFloat(3.0'f32))
  okTag("03.70", tagDouble(3.7'f64))
  okTag("+1e-1", tagDouble(0.1'f64))

proc quotedStringLiterals() =
  okTag("''", tagStr(""))
  okTag("\"\"", tagStr(""))
  okTag("\"'hello'\"", tagStr("'hello'"))
  okTag("'\"hello\"'", tagStr("\"hello\""))
  okTag("'\\\\'", tagStr("\\"))
  okTrailing("'\"'\"", "\"")
  err("'\\'", "Invalid string contents", 3, @["\"", "'", "\\"])
  okTag("'\\b'", tagStr("\x08"))
  okTag("'hello\\sword'", tagStr("hello word"))
  okTag("'hello\\tword\n'", tagStr("hello\tword\n"))
  okTag("'\\f\\r'", tagStr("\x0C\r"))
  okTag("'hello \\x65!'", tagStr("hello e!"))
  okTag("'\\x53\\x65\\u0063\\U00000072\\x65\\x74\\x21'", tagStr("Secret!"))
  err("'\\U1234567'", "Expected a character literal of length 8", 3, @[])
  okTag("'\\uD83C\\uDF83 or \\U0001F383'", tagStr("\xF0\x9F\x8E\x83 or \xF0\x9F\x8E\x83"))

proc unquotedStringLiterals() =
  okTag("abc", tagStr("abc"))
  okTag("abc-def_ghi+jkl.mno", tagStr("abc-def_ghi+jkl.mno"))
  okTag("_1234", tagStr("_1234"))
  okTag("x+1", tagStr("x+1"))
  okTrailing("x*1", "*1")
  okTag("true", tagByte(1'i8))
  okTag("false", tagByte(0'i8))
  okTag("maybe", tagStr("maybe"))
  okTag("bool", tagStr("bool"))

proc operations() =
  okTag("bool( true)", tagByte(1'i8))
  okTag("bool (false )", tagByte(0'i8))
  okTag("bool(0)", tagByte(0'i8))
  okTag("bool( 1 )", tagByte(1'i8))
  okTag("bool (2.5  )", tagByte(1'i8))
  okTag("bool ( -4.3412e+12  )", tagByte(1'i8))
  err("bool(", "Expected a valid unquoted string", 5, @[")"])
  err("bool()", "No such operation: bool/0", 6, @[])
  err("bool(1, 2)", "No such operation: bool/2", 10, @[])
  err("bool (1,2,3", "Expected literal .", 11, @[
            ")", ",", ".", "b", "B", "d", "D", "e", "E", "f", "F", "i", "I", "l", "L", "s", "S",
            "u", "U"
        ])
  okTag("uuid('3d569d3a-93ef-44a0-9f1c-f69db9d37a56')", tagInts(@[1029086522'i32, -1813035872'i32, -1625491811'i32, -1177322922'i32]))
  okTag("uuid(ad569d3a-93ef-44a0-9f1c-f69db9d37a56)", tagInts(@[-1386832582'i32, -1813035872'i32, -1625491811'i32, -1177322922'i32]))
  err("uuid(3d53a-f40-c-f69db9d37a56)", "Expected literal ,", 7, @[])
  okTag("uuid(fffffffffffffff-0-0-0-0)", tagInts(@[-1'i32, 0'i32, 0'i32, 0'i32]))
  okTag("uuid(AaaAaaAaaAaaAaA-BBbBbbBbBbbbBB-c-D-e)", tagInts(@[-1431655766'i32, -1145372660'i32, 851968'i32, 14'i32]))
  okTag("uuid(a1-+2-+3-+4-+5)", tagInts(@[161'i32, 131075'i32, 262144'i32, 5'i32]))
  err("uuid(x)", "Expected a string representing a valid UUID", 7, @[])

proc maps() =
  okTag("{x:5}", tagMap(@[("x", tagInt(5'i32))]))
  okTag("{ a:1b,B :2uS , c:3L  }", tagMap(@[("a", tagByte(1'i8)), ("B", tagShort(2'i16)), ("c", tagLong(3'i64))]))
  okTag("{ a:1b, \"a\":2b, 'a':\"hi\" }", tagMap(@[("a", tagStr("hi"))]))
  okTag("{ elem: 'this', next: { elem: 'is', next: { elem: 'a', next: { elem: 'linked', next: 'list' } } } }", tagMap(@[("elem", tagStr("this")), ("next", tagMap(@[("elem", tagStr("is")), ("next", tagMap(@[("elem", tagStr("a")), ("next", tagMap(@[("elem", tagStr("linked")), ("next", tagStr("list"))]))]))]))]))
  err("{'x': 5f", "Expected literal ,", 8, @[",", "}"])
  err("{text:\"cool\",\"color:dark_red}", "Invalid string contents", 29, @["\"", "'", "\\"])
  okTag("{9._+._+foo:1}", tagMap(@[("9._+._+foo", tagInt(1'i32))]))
  err("{9._+._+=foo:1}", "Expected literal :", 8, @[])
  err("{\"a\":b", "Expected literal (", 6, @["(", ",", "}"])
  err("{\"a\":25", "Expected literal .", 7, @[
            ",", ".", "b", "B", "d", "D", "e", "E", "f", "F", "i", "I", "l", "L", "s", "S", "u",
            "U", "}"
        ])
  err("{\"a\":25,", "Expected literal \"", 8, @["\"", "'", "}"])
  err("{,}", "Expected literal \"", 1, @[])
  err("{{}}", "Expected literal \"", 1, @[])
  okTag("{1:1}", tagMap(@[("1", tagInt(1'i32))]))

proc lists() =
  okTag("[  ]", tagList(@[]))
  okTag("[5, _]", tagList(@[tagInt(5'i32), tagStr("_")]))
  okTag("[a, [true, c], [4s, uuid(f-0-0-0-0), f, [[], 7f, [\"\\n\", [200Ub, {x: 1e1}]]]]]", tagList(@[tagStr("a"), tagList(@[tagByte(1'i8), tagStr("c")]), tagList(@[tagShort(4'i16), tagInts(@[15'i32, 0'i32, 0'i32, 0'i32]), tagStr("f"), tagList(@[tagList(@[]), tagFloat(7.0'f32), tagList(@[tagStr("\n"), tagList(@[tagByte(-56'i8), tagMap(@[("x", tagDouble(10.0'f64))])])])])])]))
  err("[1;1]", "Expected literal .", 2, @[])
  err("[{]}", "Expected literal \"", 2, @[])
  err("{[}]", "Expected literal \"", 1, @[])
  err("[,]", "Expected literal B", 1, @[])
  err("[Z;9]", "Expected literal (", 2, @[])

proc arrays() =
  okTag("[B;]", tagBytes(@[]))
  okTag("[I ;1  ,2 ,  3,]", tagInts(@[1'i32, 2'i32, 3'i32]))
  okTag("[L;1  ,2 ,  3,   4]", tagLongs(@[1'i64, 2'i64, 3'i64, 4'i64]))
  err("[B;1i]", "Invalid array element type", 6, @[])
  err("[I;1L]", "Invalid array element type", 6, @[])
  err("[B;128]", "Failed to parse number: Value out of range. Value:\"128\" Radix:10", 7, @[])
  err("[B;3000000000]", "Failed to parse number: For input string: \"3000000000\"", 14, @[])
  err("[I;3000000000]", "Failed to parse number: For input string: \"3000000000\"", 14, @[])
  err("[I; 1.0]", "Expected literal u|U", 5, @[])
  err("[I;{}]", "Expected literal +", 3, @[])
  err("[i;4]", "Expected literal (", 2, @[])
  okTag("[B; 0b11111111]", tagBytes(@[-1'i8]))
  okTag("[L; 0xFFFFFFFFFFFFFFFF]", tagLongs(@[-1'i64]))
  err("[L; 0xFFFFFFFFFFFFFFFFF]", "Failed to parse number: String value FFFFFFFFFFFFFFFFF exceeds range of unsigned long.", 24, @[])

integers()
floats()
quotedStringLiterals()
unquotedStringLiterals()
operations()
maps()
lists()
arrays()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "snbt: all checks passed"
