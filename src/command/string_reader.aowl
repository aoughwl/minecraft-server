## A cursor-based reader over a command string: the tokenizer every argument type builds on.
## Port of pumpkin/src/command/string_reader.rs
##
## The reader steps by UTF-8 scalar value as upstream does. `peek` gives the code point, or `NoChar` where upstream
## gives `None`; a comparison with an ASCII char is `peekIs(r, c)`. `Cow` is an owned string here.

import std/[math, parseutils]
import ../util/text/textbase, ../util/text/text
import cmderrors, string_range

type
  StringReader* = object
    str*: string
    byteCursor*: int

const
  NoChar* = -1'i32
  SyntaxEscape = int32(ord('\\'))
  SyntaxSingleQuote = int32(ord('\''))
  SyntaxDoubleQuote = int32(ord('"'))

proc newStringReader*(s: string): StringReader {.inline.} =
  StringReader(str: s, byteCursor: 0)

proc cursor*(r: StringReader): int {.inline.} = r.byteCursor
proc setCursor*(r: var StringReader; cursor: int) {.inline.} = r.byteCursor = cursor
proc totalLength*(r: StringReader): int {.inline.} = r.str.len
proc remainingLength*(r: StringReader): int {.inline.} = r.str.len - r.byteCursor
proc readPart*(r: StringReader): string = r.str[0 ..< r.byteCursor]
proc remainingPart*(r: StringReader): string = r.str[r.byteCursor ..< r.str.len]
proc canReadBytes*(r: StringReader; length: int): bool {.inline.} = r.byteCursor + length <= r.str.len
proc canReadByte*(r: StringReader): bool {.inline.} = canReadBytes(r, 1)

proc utf8Len(b: char): int {.inline.} =
  let v = uint8(b)
  if v < 0x80'u8: 1
  elif v < 0xE0'u8: 2
  elif v < 0xF0'u8: 3
  else: 4

proc decodeAt(s: string; i: int): int32 =
  ## Rust strings are valid UTF-8; a truncated tail reads as far as it goes.
  if i < 0 or i >= s.len:
    return NoChar
  let n = utf8Len(s[i])
  let v = int32(uint8(s[i]))
  if n == 1:
    return v
  var cp = if n == 2: v and 0x1F'i32 elif n == 3: v and 0x0F'i32 else: v and 0x07'i32
  var k = 1
  while k < n and i + k < s.len:
    cp = (cp shl 6) or (int32(uint8(s[i + k])) and 0x3F'i32)
    inc k
  cp

proc encodeCp*(cp: int32): string =
  ## `char::to_string`.
  if cp < 0x80'i32:
    result = newString(1)
    result[0] = char(cp)
  elif cp < 0x800'i32:
    result = newString(2)
    result[0] = char(0xC0'i32 or (cp shr 6))
    result[1] = char(0x80'i32 or (cp and 0x3F'i32))
  elif cp < 0x10000'i32:
    result = newString(3)
    result[0] = char(0xE0'i32 or (cp shr 12))
    result[1] = char(0x80'i32 or ((cp shr 6) and 0x3F'i32))
    result[2] = char(0x80'i32 or (cp and 0x3F'i32))
  else:
    result = newString(4)
    result[0] = char(0xF0'i32 or (cp shr 18))
    result[1] = char(0x80'i32 or ((cp shr 12) and 0x3F'i32))
    result[2] = char(0x80'i32 or ((cp shr 6) and 0x3F'i32))
    result[3] = char(0x80'i32 or (cp and 0x3F'i32))

proc canReadChars*(r: StringReader; length: int): bool =
  var i = r.byteCursor
  var n = 0
  while n < length:
    if i >= r.str.len:
      return false
    i += utf8Len(r.str[i])
    inc n
  true

proc canReadChar*(r: StringReader): bool = canReadChars(r, 1)

proc byteAt*(r: StringReader; i: int): int32 =
  ## `byte_at`, `NoChar` for `None`.
  if i >= 0 and i < r.str.len: int32(uint8(r.str[i])) else: NoChar

proc peekByte*(r: StringReader): int32 = byteAt(r, r.byteCursor)
proc peek*(r: StringReader): int32 = decodeAt(r.str, r.byteCursor)
proc peekIs*(r: StringReader; c: char): bool {.inline.} = peek(r) == int32(ord(c))

proc peekWithOffset*(r: StringReader; offset: int): int32 =
  if r.byteCursor + offset > r.str.len:
    return NoChar
  decodeAt(r.str, r.byteCursor + offset)

proc skip*(r: var StringReader) =
  if r.byteCursor < r.str.len:
    r.byteCursor += utf8Len(r.str[r.byteCursor])

proc read*(r: var StringReader): int32 =
  result = peek(r)
  if result != NoChar:
    skip(r)

proc isAllowedInNumber*(c: int32): bool =
  (c >= int32(ord('0')) and c <= int32(ord('9'))) or c == int32(ord('.')) or c == int32(ord('-'))

proc isAllowedAsQuotedStringStartEnd*(c: int32): bool =
  c == SyntaxSingleQuote or c == SyntaxDoubleQuote

proc isAllowedInUnquotedString*(c: int32): bool =
  (c >= int32(ord('0')) and c <= int32(ord('9'))) or (c >= int32(ord('A')) and c <= int32(ord('Z'))) or
    (c >= int32(ord('a')) and c <= int32(ord('z'))) or c == int32(ord('_')) or c == int32(ord('-')) or
    c == int32(ord('.')) or c == int32(ord('+'))

proc isWhitespace*(c: int32): bool =
  ## `char::is_whitespace`: the Unicode White_Space set.
  (c >= 0x09'i32 and c <= 0x0D'i32) or c == 0x20'i32 or c == 0x85'i32 or c == 0xA0'i32 or c == 0x1680'i32 or
    (c >= 0x2000'i32 and c <= 0x200A'i32) or c == 0x2028'i32 or c == 0x2029'i32 or c == 0x202F'i32 or
    c == 0x205F'i32 or c == 0x3000'i32

proc skipWhitespace*(r: var StringReader) =
  while true:
    let c = peek(r)
    if c != NoChar and isWhitespace(c):
      skip(r)
    else:
      break

proc context*(r: StringReader): CommandSyntaxErrorContext =
  ## `ContextProvider for StringReader`.
  CommandSyntaxErrorContext(input: r.str, cursor: r.byteCursor)

proc create*(t: CommandErrorType; r: StringReader): CommandSyntaxError = create(t, context(r))
proc create*(t: CommandErrorType; r: StringReader; a: TextComponent): CommandSyntaxError = create(t, context(r), a)
proc create*(t: CommandErrorType; r: StringReader; a, b: TextComponent): CommandSyntaxError = create(t, context(r), a, b)

proc sliceFromReader*(range: StringRange; r: StringReader): string =
  substringSlice(range, r.str)

proc parseI64Checked*(s: string; low, high: int64; outV: var int64): bool =
  ## `str::parse` for a signed integer: an optional sign then digits, without overflow.
  var i = 0
  var neg = false
  if s.len > 0 and (s[0] == '-' or s[0] == '+'):
    neg = s[0] == '-'
    i = 1
  if i >= s.len:
    return false
  var acc = 0'u64
  let limit = if neg: uint64(high) + 1'u64 else: uint64(high)
  while i < s.len:
    let c = s[i]
    if c < '0' or c > '9':
      return false
    let d = uint64(ord(c) - ord('0'))
    if d > limit or acc > (limit - d) div 10'u64:
      return false
    acc = acc * 10'u64 + d
    inc i
  if neg:
    if acc == uint64(high) + 1'u64:
      outV = int64.low
    else:
      outV = -int64(acc)
  else:
    outV = int64(acc)
  outV >= low and outV <= high

proc parseF64Checked*(s: string; outV: var float64): bool =
  ## `str::parse::<f64>`: an optional sign, then `inf`, `infinity`, `nan` in any case, or digits with at most one `.`
  ## and at least one digit, then an optional exponent. The number reader only lets digits, `.` and `-` reach this.
  var i = 0
  var neg = false
  if s.len > 0 and (s[0] == '-' or s[0] == '+'):
    neg = s[0] == '-'
    i = 1
  var lowered = ""
  var k = i
  while k < s.len:
    let c = s[k]
    lowered.add(if c >= 'A' and c <= 'Z': char(ord(c) + 32) else: c)
    inc k
  if lowered == "inf" or lowered == "infinity":
    outV = if neg: -Inf else: Inf
    return true
  if lowered == "nan":
    outV = NaN
    return true
  var digits = 0
  var dots = 0
  k = i
  while k < s.len and s[k] != 'e' and s[k] != 'E':
    if s[k] == '.':
      inc dots
    elif s[k] >= '0' and s[k] <= '9':
      inc digits
    else:
      return false
    inc k
  if digits == 0 or dots > 1:
    return false
  let mantissa = s[i ..< k]
  var exponent = ""
  if k < s.len:
    exponent = s[k + 1 ..< s.len]
    var e = 0
    if e < exponent.len and (exponent[e] == '-' or exponent[e] == '+'):
      inc e
    if e >= exponent.len:
      return false
    while e < exponent.len:
      if exponent[e] < '0' or exponent[e] > '9':
        return false
      inc e
  # parseBiggestFloat wants a digit on each side of the point, so normalize `.5` and `5.`.
  var norm = ""
  if neg:
    norm.add('-')
  if mantissa[0] == '.':
    norm.add('0')
  norm.add(mantissa)
  if norm[norm.len - 1] == '.':
    norm.add('0')
  if exponent.len > 0:
    norm.add('e')
    norm.add(exponent)
  var v = 0.0
  let consumed = parseBiggestFloat(norm, v)
  if consumed != norm.len:
    return false
  outV = v
  true

proc readNumberToken(r: var StringReader; expected: CommandErrorType; token: var string): CmdVoidResult =
  let start = r.byteCursor
  while true:
    let c = peek(r)
    if c != NoChar and isAllowedInNumber(c):
      skip(r)
    else:
      break
  token = r.str[start ..< r.byteCursor]
  if token.len == 0:
    return cmdFailVoid(create(expected, r))
  cmdOkVoid()

proc readInt*(r: var StringReader): CmdResult[int32] =
  let start = r.byteCursor
  var tok = ""
  let t = readNumberToken(r, readerExpectedInt(), tok)
  if not t.isOk:
    return cmdFail[int32](t.error)
  var v = 0'i64
  if parseI64Checked(tok, int64(int32.low), int64(int32.high), v):
    return cmdOk[int32](int32(v))
  r.byteCursor = start
  cmdFail[int32](create(readerInvalidInt(), r, text(tok)))

proc readLong*(r: var StringReader): CmdResult[int64] =
  let start = r.byteCursor
  var tok = ""
  let t = readNumberToken(r, readerExpectedLong(), tok)
  if not t.isOk:
    return cmdFail[int64](t.error)
  var v = 0'i64
  if parseI64Checked(tok, int64.low, int64.high, v):
    return cmdOk[int64](v)
  r.byteCursor = start
  cmdFail[int64](create(readerInvalidLong(), r, text(tok)))

proc readFloat*(r: var StringReader): CmdResult[float32] =
  let start = r.byteCursor
  var tok = ""
  let t = readNumberToken(r, readerExpectedFloat(), tok)
  if not t.isOk:
    return cmdFail[float32](t.error)
  var v = 0.0
  if parseF64Checked(tok, v):
    return cmdOk[float32](float32(v))
  r.byteCursor = start
  cmdFail[float32](create(readerInvalidFloat(), r, text(tok)))

proc readDouble*(r: var StringReader): CmdResult[float64] =
  let start = r.byteCursor
  var tok = ""
  let t = readNumberToken(r, readerExpectedDouble(), tok)
  if not t.isOk:
    return cmdFail[float64](t.error)
  var v = 0.0
  if parseF64Checked(tok, v):
    return cmdOk[float64](v)
  r.byteCursor = start
  cmdFail[float64](create(readerInvalidDouble(), r, text(tok)))

proc readUnquotedString*(r: var StringReader): string =
  let start = r.byteCursor
  while true:
    let c = peek(r)
    if c != NoChar and isAllowedInUnquotedString(c):
      skip(r)
    else:
      break
  r.str[start ..< r.byteCursor]

proc readStringUntil*(r: var StringReader; terminator: int32): CmdResult[string] =
  var res = ""
  var escaped = false
  while true:
    let c = peek(r)
    if c == NoChar:
      break
    if escaped:
      if c == terminator or c == SyntaxEscape:
        res.add(encodeCp(c))
        skip(r)
        escaped = false
      else:
        return cmdFail[string](create(readerInvalidEscape(), r, text(encodeCp(c))))
    else:
      skip(r)
      if c == SyntaxEscape:
        escaped = true
      elif c == terminator:
        return cmdOk[string](res)
      else:
        res.add(encodeCp(c))
  cmdFail[string](create(readerExpectedEndQuote(), r))

proc readString*(r: var StringReader): CmdResult[string] =
  let next = peek(r)
  if next == NoChar:
    return cmdOk[string]("")
  if isAllowedAsQuotedStringStartEnd(next):
    skip(r)
    readStringUntil(r, next)
  else:
    cmdOk[string](readUnquotedString(r))

proc readQuotedString*(r: var StringReader): CmdResult[string] =
  let next = peek(r)
  if next == NoChar:
    return cmdOk[string]("")
  if isAllowedAsQuotedStringStartEnd(next):
    skip(r)
    readStringUntil(r, next)
  else:
    cmdFail[string](create(readerExpectedStartQuote(), r))

proc readBool*(r: var StringReader): CmdResult[bool] =
  let start = r.byteCursor
  let value = readString(r)
  if not value.isOk:
    return cmdFail[bool](value.error)
  if value.value.len == 0:
    return cmdFail[bool](create(readerExpectedBool(), r))
  if value.value == "true":
    return cmdOk[bool](true)
  if value.value == "false":
    return cmdOk[bool](false)
  r.byteCursor = start
  cmdFail[bool](create(readerInvalidBool(), r, text(value.value)))

proc expect*(r: var StringReader; c: char): CmdVoidResult =
  if peekIs(r, c):
    skip(r)
    cmdOkVoid()
  else:
    cmdFailVoid(create(readerExpectedSymbol(), r, text(encodeCp(int32(ord(c))))))

proc readUntilSpace*(r: var StringReader) =
  while true:
    let c = peek(r)
    if c == NoChar or c == int32(ord(' ')):
      break
    skip(r)
