## Port of the `#[test]` block of pumpkin/src/command/string_reader.rs
import std/[assertions, syncio]
import cmderrors, string_reader

proc nonParsingMethods() =
  var reader = newStringReader("hello \xF0\x9F\x8E\x83! ")
  assert read(reader) == int32(ord('h'))
  assert peek(reader) == int32(ord('e'))
  assert read(reader) == int32(ord('e'))
  assert canReadChar(reader)
  assert canReadChars(reader, 7)
  assert not canReadChars(reader, 8)
  assert expect(reader, 'l').isOk
  skip(reader)
  assert expect(reader, 'o').isOk
  assert canReadBytes(reader, 6)
  assert remainingLength(reader) == 7
  assert not canReadBytes(reader, 8)
  assert readPart(reader) == "hello"
  setCursor(reader, 6)
  assert remainingPart(reader) == "\xF0\x9F\x8E\x83! "
  assert peekByte(reader) == 0xF0'i32
  assert read(reader) == 0x1F383'i32
  skipWhitespace(reader) # Should be a NO-OP
  assert read(reader) == int32(ord('!'))
  skipWhitespace(reader)
  assert not expect(reader, ' ').isOk

proc readTypes() =
  var reader = newStringReader("12 34  7890123456     1.233   1.592394582  false'false' faux")
  let a = readInt(reader)
  assert a.isOk and a.value == 12'i32
  skipWhitespace(reader)
  let b = readLong(reader)
  assert b.isOk and b.value == 34'i64
  skipWhitespace(reader)
  let c = readInt(reader)
  assert not c.isOk and c.error.isType(readerInvalidInt())
  skipWhitespace(reader)
  let d = readLong(reader)
  assert d.isOk and d.value == 7890123456'i64
  skipWhitespace(reader)
  let f = readFloat(reader)
  assert f.isOk and abs(f.value - 1.233'f32) < 1e-07'f32
  skipWhitespace(reader)
  let g = readDouble(reader)
  assert g.isOk and abs(g.value - 1.592394582) < 1e-15
  skipWhitespace(reader)
  let h = readBool(reader)
  assert h.isOk and h.value == false
  let i = readBool(reader)
  assert i.isOk and i.value == false
  skipWhitespace(reader)
  assert not readBool(reader).isOk

proc readStrings() =
  var reader = newStringReader("'apple' banana orange \"orange\" 'hello\"")
  let a = readQuotedString(reader)
  assert a.isOk and a.value == "apple"
  skipWhitespace(reader)
  assert readUnquotedString(reader) == "banana"
  skipWhitespace(reader)
  let b = readString(reader)
  assert b.isOk and b.value == "orange"
  skipWhitespace(reader)
  let c = readString(reader)
  assert c.isOk and c.value == "orange"
  skipWhitespace(reader)
  let d = readQuotedString(reader)
  assert not d.isOk and d.error.isType(readerExpectedEndQuote())

nonParsingMethods()
readTypes()
readStrings()
echo "string_reader: all checks passed"
