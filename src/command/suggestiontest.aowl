## Port of the `#[test]` block of pumpkin/src/command/suggestion/mod.rs
import std/[assertions, syncio]
import string_range, suggestion

proc w(r: StringRange; s: string): Suggestion = withoutTooltip(r, s)

proc applies() =
  assert apply(w(at(0), "Pumpkin once said: "), "'Server is now running'") == "Pumpkin once said: 'Server is now running'"
  assert apply(w(at(6), "Efficient, "), "Fast, and User-Friendly") == "Fast, Efficient, and User-Friendly"
  assert apply(w(at(10), " has stopped"), "The server") == "The server has stopped"
  assert apply(w(between(0, 5), "Goodbye"), "Hello world!") == "Goodbye world!"
  assert apply(w(between(6, 11), "melon"), "Hello world!") == "Hello melon!"
  assert apply(w(between(13, 23), "fruit."), "Pumpkin is a vegetable.") == "Pumpkin is a fruit."
  assert apply(w(between(0, 36), "This is a phrase."), "I'm not related to the other phrase.") == "This is a phrase."

proc expands() =
  let s = w(at(1), "oo")
  assert expand(s, "f", at(1)) == s
  assert expand(s, "f", between(0, 1)) == w(between(0, 1), "foo")
  assert expand(w(at(0), "ba"), "r", between(0, 1)) == w(between(0, 1), "bar")
  assert expand(w(at(30), "sheared to make a Carved Pumpkin and can be "),
    "A block called Pumpkin can be crafted into its seeds which can be planted", between(0, 52)) ==
    w(between(0, 52), "A block called Pumpkin can be sheared to make a Carved Pumpkin and can be crafted into its seeds")
  assert expand(w(between(6, 11), "everyone"), "Hello world!", between(0, 12)) == w(between(0, 12), "Hello everyone!")

proc merges() =
  assert isEmpty(mergeSuggestions("foo b", @[]))
  let one = newSuggestions(at(5), @[w(at(5), "ar")])
  assert mergeSuggestions("foo b", @[one]) == one
  let a = newSuggestions(at(5), @[w(at(5), "ar"), w(at(5), "az"), w(at(5), "ars")])
  let b = newSuggestions(between(4, 5), @[w(between(4, 5), "foo"), w(between(4, 5), "qux"), w(between(4, 5), "BAR")])
  let merged = mergeSuggestions("foo b", @[a, b])
  let want = @[w(between(4, 5), "bar"), w(between(4, 5), "BAR"), w(between(4, 5), "bars"),
               w(between(4, 5), "baz"), w(between(4, 5), "foo"), w(between(4, 5), "qux")]
  assert merged.suggestions == want

proc suggests() =
  let s1 = build(suggest(newSuggestionsBuilder("Hello w", 6), "world!"))
  assert s1.suggestions == @[w(between(6, 7), "world!")]
  assert s1.range == between(6, 7)
  let s2 = build(suggest(newSuggestionsBuilder("Hello w", 6), "everyone!"))
  assert s2.suggestions == @[w(between(6, 7), "everyone!")]
  assert s2.range == between(6, 7)
  assert isEmpty(build(newSuggestionsBuilder("hello", 6)))
  let s3 = build(suggest(suggest(suggest(newSuggestionsBuilder("Cut a b", 6), "banana"), "plum"), "tomato"))
  assert s3.suggestions == @[w(between(6, 7), "banana"), w(between(6, 7), "plum"), w(between(6, 7), "tomato")]
  assert s3.range == between(6, 7)
  let past = newSuggestionsBuilder("ab", 10)
  assert remaining(past) == ""
  assert remainingLowercase(past) == ""

proc sorts() =
  var b = newSuggestionsBuilder("A random thing to say is foobar", 25)
  b = suggest(b, "1")
  b = suggest(b, 9'i32)
  b = suggest(b, "4")
  b = suggest(b, 6'i32)
  b = suggest(b, "05")
  b = suggest(b, 533'i32)
  b = suggest(b, "x8")
  b = suggest(b, "a")
  b = suggest(b, "x")
  b = suggest(b, "6x")
  var got: seq[string] = @[]
  for s in build(b).suggestions:
    got.add(textAsString(s))
  assert got == @["05", "1", "4", "6", "6x", "9", "533", "a", "x", "x8"]

applies()
expands()
merges()
suggests()
sorts()
echo "suggestion: all checks passed"
