## Port of pumpkin-config/src/advancement.rs (advancement.rs)

import toml

type
  AdvancementConfig* = object
    saveAdvancements*: bool

proc defaultAdvancementConfig*(): AdvancementConfig =
  AdvancementConfig(
    saveAdvancements: true,
  )

proc toToml*(c: AdvancementConfig): TomlValue =
  result = newTomlTable()
  result.put("save_advancements", tomlBool(c.saveAdvancements))

proc fromToml*(t: typedesc[AdvancementConfig], v: TomlValue, d: var TomlDe): AdvancementConfig =
  result = defaultAdvancementConfig()
  if not d.expectTable(v, "AdvancementConfig"):
    return
  d.getBool(v, "save_advancements", result.saveAdvancements)
