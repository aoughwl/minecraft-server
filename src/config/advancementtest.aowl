## Test for advancement.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import advancement
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultAdvancementConfig()
assert c.saveAdvancements

assert textOf(toToml(c)) == "save_advancements = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(AdvancementConfig, parsed("save_advancements = false\n"), d)
  assert not d.failed, d.err
  assert not got.saveAdvancements

block roundTrip:
  var d = TomlDe()
  let back = fromToml(AdvancementConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(AdvancementConfig, parsed("save_advancements = 1\n"), d)
  assert d.err == "save_advancements: invalid type: integer `1`, expected a boolean", d.err

echo "advancementtest ok"
