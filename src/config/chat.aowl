## Port of pumpkin-config/src/chat.rs (chat.rs)

import toml

type
  ChatConfig* = object
    format*: string

proc defaultChatConfig*(): ChatConfig =
  ChatConfig(
    format: "<{DISPLAYNAME}> {MESSAGE}",
  )

proc toToml*(c: ChatConfig): TomlValue =
  result = newTomlTable()
  result.put("format", tomlStr(c.format))

proc fromToml*(t: typedesc[ChatConfig], v: TomlValue, d: var TomlDe): ChatConfig =
  result = defaultChatConfig()
  if not d.expectTable(v, "ChatConfig"):
    return
  d.getStr(v, "format", result.format)
