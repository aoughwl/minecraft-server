## Test for chat.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import chat
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultChatConfig()
assert c.format == "<{DISPLAYNAME}> {MESSAGE}"

assert textOf(toToml(c)) == "format = \"<{DISPLAYNAME}> {MESSAGE}\"\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(ChatConfig, parsed("format = \"{MESSAGE}\"\nunknown = 1\n"), d)
  assert not d.failed, d.err
  assert got.format == "{MESSAGE}"

block roundTrip:
  var d = TomlDe()
  let back = fromToml(ChatConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(ChatConfig, parsed("format = 1\n"), d)
  assert d.err == "format: invalid type: integer `1`, expected a string", d.err

echo "chattest ok"
