## Port of pumpkin-config/src/chunk.rs (chunk.rs)
##
## `ChunkConfig` is `#[serde(tag = "type")]`, with variants renamed "anvil", "linear" and "pump": the tag is
## written first, then the anvil fields beside it. `Compression` keeps its Rust spellings on the wire.

import toml

type
  Compression* = enum
    compGZip
    compZLib
    compLZ4
    compCustom

  ChunkCompression* = object
    algorithm*: Compression
    level*: uint32

  AnvilChunkConfig* = object
    compression*: ChunkCompression
    writeInPlace*: bool

  ChunkConfigKind* = enum
    cckAnvil
    cckLinear
    cckPump

  ChunkConfig* = object
    case kind*: ChunkConfigKind
    of cckAnvil: anvil*: AnvilChunkConfig
    of cckLinear: discard
    of cckPump: discard

const
  CompressionNames = ["GZip", "ZLib", "LZ4", "Custom"]
  ChunkTagNames = ["anvil", "linear", "pump"]

proc defaultChunkCompression*(): ChunkCompression =
  ChunkCompression(algorithm: compLZ4, level: 6'u32)

proc defaultAnvilChunkConfig*(): AnvilChunkConfig =
  AnvilChunkConfig(compression: defaultChunkCompression(), writeInPlace: false)

proc defaultChunkConfig*(): ChunkConfig =
  ChunkConfig(kind: cckAnvil, anvil: defaultAnvilChunkConfig())

proc toToml*(c: ChunkCompression): TomlValue =
  result = newTomlTable()
  result.put("algorithm", tomlStr(CompressionNames[ord(c.algorithm)]))
  result.put("level", tomlInt(int64(c.level)))

proc toToml*(c: AnvilChunkConfig): TomlValue =
  result = newTomlTable()
  result.put("compression", toToml(c.compression))
  result.put("write_in_place", tomlBool(c.writeInPlace))

proc toToml*(c: ChunkConfig): TomlValue =
  result = newTomlTable()
  result.put("type", tomlStr(ChunkTagNames[ord(c.kind)]))
  if c.kind == cckAnvil:
    result.flatten(toToml(c.anvil))

proc fromToml*(t: typedesc[ChunkCompression], v: TomlValue, d: var TomlDe): ChunkCompression =
  ## No `#[serde(default)]` here: both fields are required.
  result = defaultChunkCompression()
  if not d.expectTable(v, "ChunkCompression"):
    return
  var sub = TomlValue()
  if d.requireKey(v, "algorithm") and d.enter(v, "algorithm", sub):
    let idx = d.readVariant(sub, CompressionNames)
    if idx >= 0:
      result.algorithm = Compression(idx)
    d.leave()
  if d.requireKey(v, "level"):
    d.getU32(v, "level", result.level)

proc fromToml*(t: typedesc[AnvilChunkConfig], v: TomlValue, d: var TomlDe): AnvilChunkConfig =
  result = defaultAnvilChunkConfig()
  if not d.expectTable(v, "AnvilChunkConfig"):
    return
  var sub = TomlValue()
  if d.enter(v, "compression", sub):
    result.compression = fromToml(ChunkCompression, sub, d)
    d.leave()
  d.getBool(v, "write_in_place", result.writeInPlace)

proc fromToml*(t: typedesc[ChunkConfig], v: TomlValue, d: var TomlDe): ChunkConfig =
  ## Internally tagged: a unit variant ignores whatever else the table holds.
  result = defaultChunkConfig()
  if not d.expectTable(v, "ChunkConfig"):
    return
  var sub = TomlValue()
  if not d.requireKey(v, "type") or not d.enter(v, "type", sub):
    return
  let idx = d.readVariant(sub, ChunkTagNames)
  d.leave()
  if idx == ord(cckAnvil):
    result = ChunkConfig(kind: cckAnvil, anvil: fromToml(AnvilChunkConfig, v, d))
  elif idx == ord(cckLinear):
    result = ChunkConfig(kind: cckLinear)
  elif idx == ord(cckPump):
    result = ChunkConfig(kind: cckPump)
