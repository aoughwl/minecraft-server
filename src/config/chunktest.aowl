## Test for chunk.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import chunk
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultChunkConfig()
assert c.kind == cckAnvil
assert c.anvil.compression.algorithm == compLZ4
assert c.anvil.compression.level == 6'u32
assert not c.anvil.writeInPlace

assert textOf(toToml(c)) == "type = \"anvil\"\nwrite_in_place = false\n\n[compression]\nalgorithm = \"LZ4\"\nlevel = 6\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(ChunkConfig, parsed("type = \"anvil\"\nwrite_in_place = true\n"), d)
  assert not d.failed, d.err
  assert got.kind == cckAnvil
  assert got.anvil.writeInPlace
  assert got.anvil.compression.algorithm == compLZ4

block roundTrip:
  var d = TomlDe()
  let back = fromToml(ChunkConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(ChunkConfig, parsed("write_in_place = true\n"), d)
  assert d.err == "missing field `type`", d.err

block variants:
  var d = TomlDe()
  let linear = fromToml(ChunkConfig, parsed("type = \"linear\"\nwrite_in_place = true\n"), d)
  assert linear.kind == cckLinear
  let pump = fromToml(ChunkConfig, parsed("type = \"pump\"\n"), d)
  assert pump.kind == cckPump
  assert textOf(toToml(linear)) == "type = \"linear\"\n"
  assert textOf(toToml(pump)) == "type = \"pump\"\n"
  let gz = fromToml(ChunkConfig, parsed("type = \"anvil\"\n[compression]\nalgorithm = \"GZip\"\nlevel = 9\n"), d)
  assert gz.anvil.compression.algorithm == compGZip
  assert gz.anvil.compression.level == 9'u32
  assert not d.failed

block spellings:
  var d = TomlDe()
  let names = ["GZip", "ZLib", "LZ4", "Custom"]
  let values = [compGZip, compZLib, compLZ4, compCustom]
  for i in 0 ..< 4:
    let got = fromToml(ChunkCompression, parsed("algorithm = \"" & names[i] & "\"\nlevel = 1\n"), d)
    assert got.algorithm == values[i], names[i]
    assert textOf(toToml(got)) == "algorithm = \"" & names[i] & "\"\nlevel = 1\n"
  assert not d.failed

block compressionRequired:
  # No serde default on ChunkCompression: a partial table is an error.
  var d = TomlDe()
  discard fromToml(ChunkCompression, parsed("algorithm = \"LZ4\"\n"), d)
  assert d.err == "missing field `level`", d.err
  var e = TomlDe()
  discard fromToml(ChunkCompression, parsed("algorithm = \"lz4\"\nlevel = 1\n"), e)
  assert e.err == "algorithm: unknown variant `lz4`, expected one of `GZip`, `ZLib`, `LZ4`, `Custom`", e.err

echo "chunktest ok"
