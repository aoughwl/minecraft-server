## Port of pumpkin-config/src/commands.rs (commands.rs)
##
## Also holds the TOML form of `PermissionLvl`, used here and by lib.aowl: a u8 on the way out, and on the way
## in upstream's match, which leaves out 1.

import ../util/permission
import toml

export PermissionLvl

type
  CommandsConfig* = object
    useConsole*: bool
    useTty*: bool
    logConsole*: bool
    broadcastConsoleToOps*: bool
    defaultOpLevel*: PermissionLvl

proc permissionLvlFromU8*(value: uint64): (bool, PermissionLvl) =
  ## `impl Deserialize for PermissionLvl`.
  case value
  of 0'u64: (true, Zero)
  of 2'u64: (true, Two)
  of 3'u64: (true, Three)
  of 4'u64: (true, Four)
  else: (false, Zero)

proc toToml*(l: PermissionLvl): TomlValue =
  tomlInt(int64(ord(l)))

proc getPermissionLvl*(d: var TomlDe; v: TomlValue; key: string; dst: var PermissionLvl) =
  var sub = TomlValue()
  if d.enter(v, key, sub):
    let raw = d.readUnsigned(sub, 255'u64, "u8")
    if not d.failed:
      let (ok, lvl) = permissionLvlFromU8(raw)
      if ok:
        dst = lvl
      else:
        d.fail("Invalid value for OpLevel: " & $raw)
    d.leave()

proc defaultCommandsConfig*(): CommandsConfig =
  CommandsConfig(
    useConsole: true,
    useTty: true,
    logConsole: true,
    broadcastConsoleToOps: true,
    defaultOpLevel: Zero,
  )

proc toToml*(c: CommandsConfig): TomlValue =
  result = newTomlTable()
  result.put("use_console", tomlBool(c.useConsole))
  result.put("use_tty", tomlBool(c.useTty))
  result.put("log_console", tomlBool(c.logConsole))
  result.put("broadcast_console_to_ops", tomlBool(c.broadcastConsoleToOps))
  result.put("default_op_level", toToml(c.defaultOpLevel))

proc fromToml*(t: typedesc[CommandsConfig], v: TomlValue, d: var TomlDe): CommandsConfig =
  result = defaultCommandsConfig()
  if not d.expectTable(v, "CommandsConfig"):
    return
  d.getBool(v, "use_console", result.useConsole)
  d.getBool(v, "use_tty", result.useTty)
  d.getBool(v, "log_console", result.logConsole)
  d.getBool(v, "broadcast_console_to_ops", result.broadcastConsoleToOps)
  d.getPermissionLvl(v, "default_op_level", result.defaultOpLevel)
