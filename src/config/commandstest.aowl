## Test for commands.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import commands
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultCommandsConfig()
assert c.useConsole
assert c.useTty
assert c.logConsole
assert c.broadcastConsoleToOps
assert c.defaultOpLevel == Zero

assert textOf(toToml(c)) == "use_console = true\nuse_tty = true\nlog_console = true\nbroadcast_console_to_ops = true\ndefault_op_level = 0\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(CommandsConfig, parsed("default_op_level = 3\nuse_tty = false\n"), d)
  assert not d.failed, d.err
  assert got.defaultOpLevel == Three
  assert not got.useTty
  assert got.useConsole

block roundTrip:
  var d = TomlDe()
  let back = fromToml(CommandsConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(CommandsConfig, parsed("default_op_level = 1\n"), d)
  assert d.err == "default_op_level: Invalid value for OpLevel: 1", d.err

echo "commandstest ok"
