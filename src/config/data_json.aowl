## Port of pumpkin/src/data/mod.rs
## PARTIAL: pumpkin/src/data/mod.rs - `VanillaData` is left out: it also holds the banned lists and the user cache, which are not ported here.
##
## `LoadJSONConfiguration` and `SaveJSONConfiguration` as file steps that op.aowl and whitelist.aowl share: the
## traits' fallible steps return a result rather than panicking. Upstream reads the folder from the current
## directory; `defaultDataDir` gives that, and every proc takes the folder so a caller can choose. Also the
## `serde_json::to_string_pretty` layout both files are written in.

import std/[os, syncio]
from std/paths import path, Path
from std/dirs import tryCreateFinalDir
import ../codecs/json_value

const DataFolder* = "data/"

type
  JsonFileRead* = object
    ok*: bool
    exists*: bool    ## False: there was no file, and `defaults` was written.
    text*: string
    err*: string
    warning*: string ## Upstream logs these and carries on.

  JsonFileWrite* = object
    ok*: bool
    err*: string

proc joinDataPath(dir, name: string): string =
  ## `Path::join` for a relative name.
  if dir.len > 0 and (dir[dir.len - 1] == '/' or dir[dir.len - 1] == '\\'):
    dir & name
  else:
    dir & "/" & name

proc defaultDataDir*(): (bool, string) =
  ## `env::current_dir().join(DATA_FOLDER)`.
  result = (false, "")
  try:
    let cwd: string = getCurrentDir()
    result = (true, joinDataPath(cwd, DataFolder))
  except ErrorCode as e:
    result = (false, "Failed to get current directory: " & $e)

proc pathExists(path: string): bool =
  fileExists(path) or dirExists(path)

proc stripSlash(dir: string): string =
  result = dir
  while result.len > 1 and (result[result.len - 1] == '/' or result[result.len - 1] == '\\'):
    result = result[0 ..< result.len - 1]

proc ensureFolder*(dir, failMessage: string): (bool, string) =
  ## `if !dir.exists() { fs::create_dir(dir) }`: one level only, a missing parent is an error.
  let clean = stripSlash(dir)
  if pathExists(clean):
    return (true, "")
  let code = tryCreateFinalDir(path(clean))
  if code == Success or code == NameExists:
    (true, "")
  else:
    (false, failMessage & ": " & clean)

proc readOrCreateDataFile*(dataDir, name, defaults: string): JsonFileRead =
  ## The file half of `LoadJSONConfiguration::load`.
  let (made, why) = ensureFolder(dataDir, "Failed to create data root folder")
  if not made:
    return JsonFileRead(ok: false, err: why)
  let filePath = joinDataPath(dataDir, name)
  if pathExists(filePath):
    try:
      let text = readFile(filePath)
      return JsonFileRead(ok: true, exists: true, text: text)
    except ErrorCode:
      return JsonFileRead(ok: false, exists: true, err: "Couldn't read configuration file at " & filePath)
  try:
    writeFile(filePath, defaults)
    JsonFileRead(ok: true, exists: false, text: defaults)
  except ErrorCode as e:
    JsonFileRead(ok: true, exists: false, text: defaults,
                 warning: "Couldn't write default data config to " & filePath & ". Reason: " & $e)

proc writeDataFile*(dataDir, name, content: string): JsonFileWrite =
  ## The file half of `SaveJSONConfiguration::save`. Upstream logs a failure, this returns it.
  let (made, why) = ensureFolder(dataDir, "Failed to create data root folder")
  if not made:
    return JsonFileWrite(ok: false, err: why)
  let filePath = joinDataPath(dataDir, name)
  try:
    writeFile(filePath, content)
    JsonFileWrite(ok: true)
  except ErrorCode as e:
    JsonFileWrite(ok: false, err: "Couldn't write config to " & filePath & ". Reason: " & $e)

proc parseFailure*(path, why: string): string =
  ## Upstream's panic text when a data file does not parse.
  "Couldn't parse data config at " & path & ". Reason: " & why &
    ". This is probably caused by a config update. Just delete the old data config and restart."

proc hasTrailingContent*(text: string): bool =
  ## serde_json refuses anything after the value, and std/json does not report it. Takes text std/json has
  ## already parsed as an array, so the first bracket that closes at depth zero ends the value.
  var depth = 0
  var inString = false
  var i = 0
  while i < text.len:
    let c = text[i]
    if inString:
      if c == chr(92):
        inc i
      elif c == chr(34):
        inString = false
    elif c == chr(34):
      inString = true
    elif c == '[' or c == '{':
      inc depth
    elif c == ']' or c == '}':
      dec depth
      if depth == 0:
        inc i
        while i < text.len:
          if text[i] notin {' ', chr(9), chr(10), chr(13)}:
            return true
          inc i
        return false
    inc i
  false

proc prettyArrayOpen*(dst: var string; isFirst: bool) =
  ## Starts one object of a `to_string_pretty` array.
  dst.add(if isFirst: "[\n  {\n" else: ",\n  {\n")

proc prettyField*(dst: var string; key, rawValue: string; last: bool) =
  ## One field of an object two levels down.
  dst.add("    ")
  addEscaped(dst, key)
  dst.add(": ")
  dst.add(rawValue)
  dst.add(if last: "" else: ",\n")

proc prettyStr*(s: string): string =
  result = ""
  addEscaped(result, s)

proc prettyArrayClose*(dst: var string; isEmpty: bool) =
  dst.add(if isEmpty: "[]" else: "\n  }\n]")

proc prettyObjectClose*(dst: var string) =
  ## Ends one object when another follows.
  dst.add("\n  }")
