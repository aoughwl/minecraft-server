## Test for data_json.aowl: the file steps against a real folder.

import std/[assertions, syncio, os, envvars]
from std/paths import path, Path
from std/dirs import tryCreateFinalDir, tryRemoveFile
import data_json

proc scratchDir(name: string): string =
  ## Under CONFIGTEST_DIR, or beside the test executable.
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  result = base & "/" & name
  if not dirExists(result):
    discard tryCreateFinalDir(path(result))
  assert dirExists(result), result

proc readText(p: string): string =
  result = ""
  try:
    result = readFile(p)
  except ErrorCode:
    assert false, "cannot read " & p

proc writeText(p, text: string) =
  try:
    writeFile(p, text)
  except ErrorCode:
    assert false, "cannot write " & p

let dir = scratchDir("cfg_data_json")
discard tryRemoveFile(path(dir & "/a.json"))

let first = readOrCreateDataFile(dir, "a.json", "[]")
assert first.ok
assert not first.exists
assert first.text == "[]"
assert readText(dir & "/a.json") == "[]"

let w = writeDataFile(dir & "/", "a.json", "[1]")
assert w.ok, w.err
let second = readOrCreateDataFile(dir, "a.json", "[]")
assert second.ok
assert second.exists
assert second.text == "[1]"

# The folder is made one level at a time, as `fs::create_dir` does.
let nested = dir & "/no/such/parent"
let bad = readOrCreateDataFile(nested, "a.json", "[]")
assert not bad.ok
assert bad.err == "Failed to create data root folder: " & nested, bad.err
let badWrite = writeDataFile(nested, "a.json", "[]")
assert not badWrite.ok

let (ok, here) = defaultDataDir()
assert ok
assert here.len > DataFolder.len

var text = ""
prettyArrayClose(text, true)
assert text == "[]"
text = ""
prettyArrayOpen(text, true)
prettyField(text, "k", prettyStr("a\"b"), true)
prettyArrayClose(text, false)
assert text == "[\n  {\n    \"k\": \"a\\\"b\"\n  }\n]", text

echo "data_jsontest ok"
