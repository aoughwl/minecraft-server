## Port of pumpkin-config/src/fun.rs (fun.rs)

import toml

type
  FunConfig* = object
    aprilFools*: bool

proc defaultFunConfig*(): FunConfig =
  FunConfig(
    aprilFools: true,
  )

proc toToml*(c: FunConfig): TomlValue =
  result = newTomlTable()
  result.put("april_fools", tomlBool(c.aprilFools))

proc fromToml*(t: typedesc[FunConfig], v: TomlValue, d: var TomlDe): FunConfig =
  result = defaultFunConfig()
  if not d.expectTable(v, "FunConfig"):
    return
  d.getBool(v, "april_fools", result.aprilFools)
