## Test for fun.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import fun
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultFunConfig()
assert c.aprilFools

assert textOf(toToml(c)) == "april_fools = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(FunConfig, parsed(""), d)
  assert not d.failed, d.err
  assert got.aprilFools

block roundTrip:
  var d = TomlDe()
  let back = fromToml(FunConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(FunConfig, parsed("april_fools = \"x\"\n"), d)
  assert d.err == "april_fools: invalid type: string \"x\", expected a boolean", d.err

echo "funtest ok"
