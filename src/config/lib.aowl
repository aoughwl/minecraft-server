## Port of pumpkin-config/src/lib.rs (lib.rs)
##
## `LoadConfiguration` is a trait with one implementor, `PumpkinConfig`, so its steps are plain procs here. What
## panics upstream comes back in `ConfigLoad.err`: a failed folder creation, an unreadable or unparsable file, a
## merged table that does not deserialize, and every assert in `validate`. Failed writes stay what they are
## upstream, a warning and carry on, and show up in `ConfigLoad.warning`.

import std/[os, syncio, options]
import ../util/difficulty
import ../util/gamemode
import ../util/world_seed
from ../util/random/random import getSeed
import advancement, chat, chunk, commands, fun, lighting, logging, op, player_data, plugins, pvp, recipe,
  resource_pack, server_links, whitelist, world
import networking/networking
import data_json
import toml

export advancement, chat, chunk, commands, fun, lighting, logging, op, player_data, plugins, pvp, recipe,
  resource_pack, server_links, whitelist, world, networking, toml
export Difficulty, GameMode, Seed, seedFrom

const
  ConfigFileName* = "pumpkin.toml"
  DifficultyNames = ["Peaceful", "Easy", "Normal", "Hard"]
  GameModeNames = ["Survival", "Creative", "Adventure", "Spectator"]

type
  BasicConfiguration* = object
    seed*: Seed
    defaultDifficulty*: Difficulty
    opPermissionLevel*: PermissionLvl
    allowNether*: bool
    allowEnd*: bool
    hardcore*: bool
    tps*: float32
    defaultGamemode*: GameMode
    forceGamemode*: bool
    scrubIps*: bool
    useFavicon*: bool
    faviconPath*: Option[string]
    defaultLevelName*: string
    allowChatReports*: bool
    whiteList*: bool
    enforceWhitelist*: bool

  AdvancedConfiguration* = object
    logging*: LoggingConfig
    resourcePack*: ResourcePackConfig
    world*: LevelConfig
    networking*: NetworkingConfig
    commands*: CommandsConfig
    chat*: ChatConfig
    pvp*: PVPConfig
    serverLinks*: ServerLinksConfig
    playerData*: PlayerDataConfig
    fun*: FunConfig
    recipe*: RecipeConfig
    plugins*: PluginsConfig
    advancement*: AdvancementConfig

  PumpkinConfig* = object
    basic*: BasicConfiguration
    advanced*: AdvancedConfiguration

  ConfigMerge* = object
    ok*: bool
    config*: PumpkinConfig
    changed*: bool
    err*: string

  ConfigLoad* = object
    ok*: bool
    config*: PumpkinConfig
    changed*: bool   ## The file was rewritten with the missing values filled in.
    created*: bool   ## There was no file, and the defaults were written.
    err*: string
    warning*: string ## A write that failed; upstream logs it and uses the values anyway.

proc seedText*(s: Seed): string =
  ## `impl Serialize for Seed`: the signed decimal text.
  $cast[int64](s.value)

# --- defaults --------------------------------------------------------------------------------------

proc defaultBasicConfiguration*(): BasicConfiguration =
  BasicConfiguration(
    seed: Seed(value: getSeed()),
    defaultDifficulty: Normal,
    opPermissionLevel: Four,
    allowNether: true,
    allowEnd: true,
    hardcore: false,
    tps: 20.0'f32,
    defaultGamemode: Survival,
    forceGamemode: false,
    scrubIps: true,
    useFavicon: true,
    faviconPath: none[string](),
    defaultLevelName: "world",
    allowChatReports: false,
    whiteList: false,
    enforceWhitelist: false,
  )

proc defaultAdvancedConfiguration*(): AdvancedConfiguration =
  AdvancedConfiguration(
    logging: defaultLoggingConfig(),
    resourcePack: defaultResourcePackConfig(),
    world: defaultLevelConfig(),
    networking: defaultNetworkingConfig(),
    commands: defaultCommandsConfig(),
    chat: defaultChatConfig(),
    pvp: defaultPVPConfig(),
    serverLinks: defaultServerLinksConfig(),
    playerData: defaultPlayerDataConfig(),
    fun: defaultFunConfig(),
    recipe: defaultRecipeConfig(),
    plugins: defaultPluginsConfig(),
    advancement: defaultAdvancementConfig(),
  )

proc defaultPumpkinConfig*(): PumpkinConfig =
  PumpkinConfig(basic: defaultBasicConfiguration(), advanced: defaultAdvancedConfiguration())

proc getWorldPath*(c: BasicConfiguration): string =
  ## `BasicConfiguration::get_world_path`
  c.defaultLevelName

# --- serialize -------------------------------------------------------------------------------------

proc toToml*(c: BasicConfiguration): TomlValue =
  result = newTomlTable()
  result.put("seed", tomlStr(seedText(c.seed)))
  result.put("default_difficulty", tomlStr(DifficultyNames[ord(c.defaultDifficulty)]))
  result.put("op_permission_level", toToml(c.opPermissionLevel))
  result.put("allow_nether", tomlBool(c.allowNether))
  result.put("allow_end", tomlBool(c.allowEnd))
  result.put("hardcore", tomlBool(c.hardcore))
  result.put("tps", tomlF32(c.tps))
  result.put("default_gamemode", tomlStr(GameModeNames[ord(c.defaultGamemode)]))
  result.put("force_gamemode", tomlBool(c.forceGamemode))
  result.put("scrub_ips", tomlBool(c.scrubIps))
  result.put("use_favicon", tomlBool(c.useFavicon))
  if c.faviconPath.isSome:
    result.put("favicon_path", tomlStr(c.faviconPath.get()))
  result.put("default_level_name", tomlStr(c.defaultLevelName))
  result.put("allow_chat_reports", tomlBool(c.allowChatReports))
  result.put("white_list", tomlBool(c.whiteList))
  result.put("enforce_whitelist", tomlBool(c.enforceWhitelist))

proc toToml*(c: AdvancedConfiguration): TomlValue =
  result = newTomlTable()
  result.put("logging", toToml(c.logging))
  result.put("resource_pack", toToml(c.resourcePack))
  result.put("world", toToml(c.world))
  result.put("networking", toToml(c.networking))
  result.put("commands", toToml(c.commands))
  result.put("chat", toToml(c.chat))
  result.put("pvp", toToml(c.pvp))
  result.put("server_links", toToml(c.serverLinks))
  result.put("player_data", toToml(c.playerData))
  result.put("fun", toToml(c.fun))
  result.put("recipe", toToml(c.recipe))
  result.put("plugins", toToml(c.plugins))
  result.put("advancement", toToml(c.advancement))

proc toToml*(c: PumpkinConfig): TomlValue =
  ## Both halves are `#[serde(flatten)]`.
  result = toToml(c.basic)
  result.flatten(toToml(c.advanced))

proc toTomlString*(c: PumpkinConfig): TomlWriteResult =
  ## `toml::to_string`.
  writeToml(toToml(c))

# --- deserialize -----------------------------------------------------------------------------------

proc fromToml*(t: typedesc[BasicConfiguration], v: TomlValue, d: var TomlDe): BasicConfiguration =
  result = defaultBasicConfiguration()
  if not d.expectTable(v, "BasicConfiguration"):
    return
  var sub = TomlValue()
  if d.enter(v, "seed", sub):
    if sub.kind == tkString:
      result.seed = seedFrom(sub.strVal)
    else:
      d.fail("invalid type: " & unexpected(sub) & ", expected a string")
    d.leave()
  if d.enter(v, "default_difficulty", sub):
    let idx = d.readVariant(sub, DifficultyNames)
    if idx >= 0:
      result.defaultDifficulty = Difficulty(idx)
    d.leave()
  d.getPermissionLvl(v, "op_permission_level", result.opPermissionLevel)
  d.getBool(v, "allow_nether", result.allowNether)
  d.getBool(v, "allow_end", result.allowEnd)
  d.getBool(v, "hardcore", result.hardcore)
  d.getF32(v, "tps", result.tps)
  if d.enter(v, "default_gamemode", sub):
    let idx = d.readVariant(sub, GameModeNames)
    if idx >= 0:
      result.defaultGamemode = GameMode(idx)
    d.leave()
  d.getBool(v, "force_gamemode", result.forceGamemode)
  d.getBool(v, "scrub_ips", result.scrubIps)
  d.getBool(v, "use_favicon", result.useFavicon)
  d.getOptStr(v, "favicon_path", result.faviconPath)
  d.getStr(v, "default_level_name", result.defaultLevelName)
  d.getBool(v, "allow_chat_reports", result.allowChatReports)
  d.getBool(v, "white_list", result.whiteList)
  d.getBool(v, "enforce_whitelist", result.enforceWhitelist)

proc fromToml*(t: typedesc[AdvancedConfiguration], v: TomlValue, d: var TomlDe): AdvancedConfiguration =
  result = defaultAdvancedConfiguration()
  if not d.expectTable(v, "AdvancedConfiguration"):
    return
  var sub = TomlValue()
  if d.enter(v, "logging", sub):
    result.logging = fromToml(LoggingConfig, sub, d)
    d.leave()
  if d.enter(v, "resource_pack", sub):
    result.resourcePack = fromToml(ResourcePackConfig, sub, d)
    d.leave()
  if d.enter(v, "world", sub):
    result.world = fromToml(LevelConfig, sub, d)
    d.leave()
  if d.enter(v, "networking", sub):
    result.networking = fromToml(NetworkingConfig, sub, d)
    d.leave()
  if d.enter(v, "commands", sub):
    result.commands = fromToml(CommandsConfig, sub, d)
    d.leave()
  if d.enter(v, "chat", sub):
    result.chat = fromToml(ChatConfig, sub, d)
    d.leave()
  if d.enter(v, "pvp", sub):
    result.pvp = fromToml(PVPConfig, sub, d)
    d.leave()
  if d.enter(v, "server_links", sub):
    result.serverLinks = fromToml(ServerLinksConfig, sub, d)
    d.leave()
  if d.enter(v, "player_data", sub):
    result.playerData = fromToml(PlayerDataConfig, sub, d)
    d.leave()
  if d.enter(v, "fun", sub):
    result.fun = fromToml(FunConfig, sub, d)
    d.leave()
  if d.enter(v, "recipe", sub):
    result.recipe = fromToml(RecipeConfig, sub, d)
    d.leave()
  if d.enter(v, "plugins", sub):
    result.plugins = fromToml(PluginsConfig, sub, d)
    d.leave()
  if d.enter(v, "advancement", sub):
    result.advancement = fromToml(AdvancementConfig, sub, d)
    d.leave()

proc fromToml*(t: typedesc[PumpkinConfig], v: TomlValue, d: var TomlDe): PumpkinConfig =
  ## Both flattened halves read the one table.
  result = PumpkinConfig(
    basic: fromToml(BasicConfiguration, v, d),
    advanced: fromToml(AdvancedConfiguration, v, d),
  )

# --- LoadConfiguration -----------------------------------------------------------------------------

proc validate*(c: PumpkinConfig): (bool, string) =
  ## `impl LoadConfiguration for PumpkinConfig`'s `validate`, in order. The first failed assert's text.
  const
    MinVd = 2'u8
    MaxVd = 64'u8
  let java = c.advanced.networking.java
  let bedrock = c.advanced.networking.bedrock

  # Validate Java
  if java.viewDistance < MinVd:
    return (false, "Java View distance must be at least 2")
  if java.viewDistance > MaxVd:
    return (false, "Java View distance must be less than 64")
  if java.onlineMode and not java.encryption:
    return (false, "When online mode is enabled, encryption must be enabled")

  # Validate Bedrock
  if bedrock.viewDistance < MinVd:
    return (false, "Bedrock View distance must be at least 2")
  if bedrock.viewDistance > MaxVd:
    return (false, "Bedrock View distance must be less than 64")
  if bedrock.onlineMode and not bedrock.encryption:
    return (false, "When online mode is enabled, bedrock_encryption must be enabled")

  if c.basic.allowChatReports and not java.onlineMode:
    return (false, "When allow_chat_reports is enabled, java.online_mode must be enabled")
  (true, "")

proc mergeWithDefaultToml*(parsed: TomlValue): ConfigMerge =
  ## `LoadConfiguration::merge_with_default_toml`.
  let merged = mergeTomlValues(toToml(defaultPumpkinConfig()), parsed)
  var d = TomlDe()
  let config = fromToml(PumpkinConfig, merged.value, d)
  if d.failed:
    return ConfigMerge(ok: false, err: "Failed to convert merged config: " & d.err)
  ConfigMerge(ok: true, config: config, changed: merged.changed)

proc pathOf(configDir: string): string =
  if configDir.len > 0 and (configDir[configDir.len - 1] == '/' or configDir[configDir.len - 1] == '\\'):
    configDir & ConfigFileName
  else:
    configDir & "/" & ConfigFileName

proc writeConfigFile(path: string; c: PumpkinConfig; what: string): string =
  ## Writes the file; returns the warning text, empty on success.
  let text = toTomlString(c)
  if not text.ok:
    return "Couldn't write " & what & " config to " & path & ". Reason: " & text.err
  try:
    writeFile(path, text.text)
    ""
  except ErrorCode as e:
    "Couldn't write " & what & " config to " & path & ". Reason: " & $e

proc loadPumpkinConfig*(configDir: string): ConfigLoad =
  ## `LoadConfiguration::load`: create the folder, read and merge or write defaults, then validate.
  result = ConfigLoad(ok: false)
  let (made, why) = ensureFolder(configDir, "Failed to create config root folder")
  if not made:
    result.err = why
    return
  let path = pathOf(configDir)

  var config = PumpkinConfig()
  if fileExists(path) or dirExists(path):
    var content = ""
    try:
      content = readFile(path)
    except ErrorCode:
      result.err = "Couldn't read configuration file at " & path
      return

    let parsed = parseToml(content)
    if not parsed.ok:
      result.err = "Couldn't parse TOML at " & path & ". Reason: " & parsed.err &
        ". This is probably caused by invalid TOML syntax"
      return

    let merge = mergeWithDefaultToml(parsed.value)
    if not merge.ok:
      result.err = merge.err
      return
    config = merge.config

    if merge.changed:
      echo ConfigFileName & " changed because values were missing. The missing values were filled with default values."
      result.changed = true
      result.warning = writeConfigFile(path, config, "merged")
  else:
    config = defaultPumpkinConfig()
    result.created = true
    result.warning = writeConfigFile(path, config, "default")

  let (valid, invalidWhy) = validate(config)
  if not valid:
    result.err = invalidWhy
    return
  result.ok = true
  result.config = config
