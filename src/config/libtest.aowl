proc textOf(c: PumpkinConfig): string =
  let r = toTomlString(c)
  assert r.ok, r.err
  r.text

proc withSeed42(c: PumpkinConfig): PumpkinConfig =
  result = c
  result.basic.seed = Seed(value: 42'u64)

proc replaced(text, a, b: string): string =
  ## `text` with the first `a` swapped for `b`; `a` must be there.
  var i = 0
  while i + a.len <= text.len:
    if text[i ..< i + a.len] == a:
      return text[0 ..< i] & b & text[i + a.len ..< text.len]
    inc i
  assert false, a
  text

proc contains(text, needle: string): bool =
  var i = 0
  while i + needle.len <= text.len:
    if text[i ..< i + needle.len] == needle:
      return true
    inc i
  false

block defaults:
  let c = defaultPumpkinConfig()
  let b = c.basic
  assert b.defaultDifficulty == Normal
  assert b.opPermissionLevel == Four
  assert b.allowNether
  assert b.allowEnd
  assert not b.hardcore
  assert b.tps == 20.0'f32
  assert b.defaultGamemode == Survival
  assert not b.forceGamemode
  assert b.scrubIps
  assert b.useFavicon
  assert b.faviconPath.isNone
  assert b.defaultLevelName == "world"
  assert not b.allowChatReports
  assert not b.whiteList
  assert not b.enforceWhitelist
  assert b.getWorldPath() == "world"
  assert validate(c)[0]

block exactText:
  let text = textOf(withSeed42(defaultPumpkinConfig()))
  assert text == DefaultText, text

block seeds:
  # `impl From<&str> for Seed`.
  assert seedFrom("42").value == 42'u64
  assert seedFrom(" -1 ").value == 18446744073709551615'u64
  assert seedFrom("+7").value == 7'u64
  assert seedText(seedFrom("-1")) == "-1"
  assert seedText(Seed(value: 18446744073709551615'u64)) == "-1"
  # Too big for i64, so hashed as text, sign-extended like `i64::from(i32)`.
  assert seedFrom("9223372036854775808").value == cast[uint64](int64(javaStringHash("9223372036854775808")))
  assert seedFrom("abc").value == 96354'u64, $seedFrom("abc").value
  assert seedFrom("hello world").value == 1794106052'u64, $seedFrom("hello world").value
  # Blank draws at random: all this can check is that two draws differ.
  assert seedFrom("   ").value != seedFrom("").value

block mergeNoFile:
  let parsed = parseToml(DefaultText)
  assert parsed.ok
  let m = mergeWithDefaultToml(parsed.value)
  assert m.ok, m.err
  assert not m.changed
  assert textOf(m.config) == DefaultText
  assert m.config.basic.seed.value == 42'u64

proc freshDir(name: string): string =
  result = scratchDir(name)
  discard tryRemoveFile(path(result & "/pumpkin.toml"))

block writesDefaults:
  let dir = freshDir("cfg_lib_default")
  let got = loadPumpkinConfig(dir)
  assert got.ok, got.err
  assert got.created
  assert not got.changed
  assert got.warning == ""
  let onDisk = readText(dir & "/pumpkin.toml")
  assert onDisk == textOf(got.config), onDisk
  # Second load: the same seed, nothing to fill, file untouched.
  let again = loadPumpkinConfig(dir)
  assert again.ok, again.err
  assert not again.created
  assert not again.changed
  assert again.config.basic.seed.value == got.config.basic.seed.value
  assert readText(dir & "/pumpkin.toml") == onDisk

block partialFileMerges:
  let dir = freshDir("cfg_lib_partial")
  writeText(dir & "/pumpkin.toml", """
# A user's short file, comments and all.
seed = "42"
hardcore = true
tps = 40
default_difficulty = "Hard"
default_gamemode = "Creative"
favicon_path = "icon.png"
not_a_setting = "dropped"

[networking.java]
max_players = 5
view_distance = 12
address = "[::1]:25566"
motd = 'single "quoted"'

[networking.java.compression]
threshold = 512

[server_links]
website = "https://example.com"
custom = { "My Link" = "https://l", wiki = "https://w" }

[plugins]
blocked_permissions = ["a.b"]

[[resource_pack.bedrock.packs]]
uuid = "12345678-1234-1234-1234-123456789abc"
version = "1.0"
size = 9
download_url = "https://p"

[world.chunk]
type = "anvil"
write_in_place = true
""")
  let got = loadPumpkinConfig(dir)
  assert got.ok, got.err
  assert got.changed
  assert not got.created
  let c = got.config
  # Set values stayed.
  assert c.basic.seed.value == 42'u64
  assert c.basic.hardcore
  assert c.basic.tps == 40.0'f32
  assert c.basic.defaultDifficulty == Hard
  assert c.basic.defaultGamemode == Creative
  assert c.basic.faviconPath.get() == "icon.png"
  assert c.advanced.networking.java.maxPlayers == 5'u32
  assert c.advanced.networking.java.viewDistance == 12'u8
  assert $c.advanced.networking.java.address == "[::1]:25566"
  assert c.advanced.networking.java.compression.info.threshold == 512'u32
  assert c.advanced.serverLinks.website == "https://example.com"
  assert c.advanced.plugins.blockedPermissions == @["a.b"]
  assert c.advanced.resourcePack.bedrock.packs.len == 1
  assert c.advanced.world.chunk.anvil.writeInPlace
  # Missing values took their defaults.
  assert c.basic.allowNether
  assert c.basic.opPermissionLevel == Four
  assert c.basic.defaultLevelName == "world"
  assert c.advanced.networking.java.compression.info.level == 4'u32
  assert c.advanced.networking.java.simulationDistance == 10'u8
  assert c.advanced.networking.bedrock.viewDistance == 16'u8
  assert c.advanced.logging.file == "latest.log"
  assert c.advanced.world.chunk.anvil.compression.algorithm == compLZ4
  assert c.advanced.world.autosaveTicks == 6000'u64
  assert c.advanced.serverLinks.bugReport == "https://github.com/Pumpkin-MC/Pumpkin/issues"

  # The rewritten file holds everything, with the unknown key and the comment gone.
  let onDisk = readText(dir & "/pumpkin.toml")
  assert onDisk == textOf(c), onDisk
  var expected = DefaultText
  expected = replaced(expected, "hardcore = false", "hardcore = true")
  expected = replaced(expected, "tps = 20.0", "tps = 40.0")
  expected = replaced(expected, "default_difficulty = \"Normal\"", "default_difficulty = \"Hard\"")
  expected = replaced(expected, "default_gamemode = \"Survival\"", "default_gamemode = \"Creative\"")
  expected = replaced(expected, "use_favicon = true\n", "use_favicon = true\nfavicon_path = \"icon.png\"\n")
  expected = replaced(expected, "address = \"0.0.0.0:25565\"\nencryption", "address = \"[::1]:25566\"\nencryption")
  expected = replaced(expected, "max_players = 1000", "max_players = 5")
  expected = replaced(expected, "view_distance = 16", "view_distance = 12")
  expected = replaced(expected, "motd = \"A blazingly fast Pumpkin server!\"", "motd = 'single \"quoted\"'")
  expected = replaced(expected, "threshold = 256", "threshold = 512")
  expected = replaced(expected, "website = \"\"", "website = \"https://example.com\"")
  expected = replaced(expected, "[server_links.custom]\n", "[server_links.custom]\n\"My Link\" = \"https://l\"\nwiki = \"https://w\"\n")
  expected = replaced(expected, "blocked_permissions = []", "blocked_permissions = [\"a.b\"]")
  expected = replaced(expected, "packs = []\n", "\n[[resource_pack.bedrock.packs]]\nuuid = \"12345678-1234-1234-1234-123456789abc\"\nversion = \"1.0\"\nsize = 9\ndownload_url = \"https://p\"\ncontent_key = \"\"\nsub_pack_name = \"\"\ncontent_id = \"\"\nhas_scripts = false\naddon_pack = false\nrtx_enabled = false\n")
  expected = replaced(expected, "write_in_place = false", "write_in_place = true")
  assert onDisk == expected, onDisk

  # Now complete: the next load changes nothing.
  let again = loadPumpkinConfig(dir)
  assert again.ok, again.err
  assert not again.changed, "second load should not change the file"
  assert readText(dir & "/pumpkin.toml") == onDisk
  assert again.config.basic.seed.value == 42'u64

block missingSeedIsFilledOnce:
  let dir = freshDir("cfg_lib_seed")
  writeText(dir & "/pumpkin.toml", "hardcore = true\n")
  let first = loadPumpkinConfig(dir)
  assert first.ok, first.err
  assert first.changed
  let second = loadPumpkinConfig(dir)
  assert second.ok, second.err
  assert not second.changed
  assert first.config.basic.seed.value == second.config.basic.seed.value

block unitChunkVariantKeepsChanging:
  # Upstream's merge sees anvil keys missing from a linear table and fills them, then drops them on write,
  # so it reports a change on every load. Kept as it is.
  let dir = freshDir("cfg_lib_linear")
  let edited = replaced(DefaultText,
    "type = \"anvil\"\nwrite_in_place = false\n\n[world.chunk.compression]\nalgorithm = \"LZ4\"\nlevel = 6\n",
    "type = \"linear\"\n")
  writeText(dir & "/pumpkin.toml", edited)
  let a = loadPumpkinConfig(dir)
  assert a.ok, a.err
  assert a.changed
  assert a.config.advanced.world.chunk.kind == cckLinear
  assert readText(dir & "/pumpkin.toml") == edited
  let b = loadPumpkinConfig(dir)
  assert b.ok, b.err
  assert b.changed

proc loadText(name, text: string): ConfigLoad =
  let dir = freshDir(name)
  writeText(dir & "/pumpkin.toml", text)
  loadPumpkinConfig(dir)

block badFiles:
  let syntax = loadText("cfg_lib_bad", "a = \n")
  assert not syntax.ok
  assert contains(syntax.err, "TOML parse error at line 1, column 5: expected a value. This is probably caused by invalid TOML syntax"), syntax.err

  let badType = loadText("cfg_lib_bad", "hardcore = 1\n")
  assert not badType.ok
  assert badType.err == "Failed to convert merged config: hardcore: invalid type: integer `1`, expected a boolean", badType.err

  let seedInt = loadText("cfg_lib_bad", "seed = 42\n")
  assert not seedInt.ok
  assert seedInt.err == "Failed to convert merged config: seed: invalid type: integer `42`, expected a string", seedInt.err

  let badEnum = loadText("cfg_lib_bad", "default_difficulty = \"normal\"\n")
  assert not badEnum.ok
  assert badEnum.err == "Failed to convert merged config: default_difficulty: unknown variant `normal`, expected one of `Peaceful`, `Easy`, `Normal`, `Hard`", badEnum.err

  let opOne = loadText("cfg_lib_bad", "op_permission_level = 1\n")
  assert not opOne.ok
  assert opOne.err == "Failed to convert merged config: op_permission_level: Invalid value for OpLevel: 1", opOne.err

  # A table replaced by a value is not a merge change, and then does not deserialize.
  let badTable = loadText("cfg_lib_bad", "world = 5\n")
  assert not badTable.ok
  assert badTable.err == "Failed to convert merged config: world: invalid type: integer `5`, expected struct LevelConfig", badTable.err

proc refuses(text, why: string) =
  let got = loadText("cfg_lib_val", text)
  assert not got.ok, text
  assert got.err == why, got.err

block validation:
  refuses("[networking.java]\nview_distance = 1\n", "Java View distance must be at least 2")
  refuses("[networking.java]\nview_distance = 65\n", "Java View distance must be less than 64")
  refuses("[networking.java]\nencryption = false\n", "When online mode is enabled, encryption must be enabled")
  refuses("[networking.bedrock]\nview_distance = 1\n", "Bedrock View distance must be at least 2")
  refuses("[networking.bedrock]\nview_distance = 65\n", "Bedrock View distance must be less than 64")
  refuses("[networking.bedrock]\nencryption = false\n", "When online mode is enabled, bedrock_encryption must be enabled")
  refuses("allow_chat_reports = true\n[networking.java]\nonline_mode = false\n", "When allow_chat_reports is enabled, java.online_mode must be enabled")
  # The edges are allowed, and offline mode lifts the encryption rule.
  assert loadText("cfg_lib_val", "[networking.java]\nview_distance = 2\n").ok
  assert loadText("cfg_lib_val", "[networking.java]\nview_distance = 64\n").ok
  assert loadText("cfg_lib_val", "[networking.java]\nencryption = false\nonline_mode = false\n").ok
  # Upstream writes the merged file first, then validates.
  let dir = freshDir("cfg_lib_val")
  writeText(dir & "/pumpkin.toml", "[networking.java]\nview_distance = 1\n")
  assert not loadPumpkinConfig(dir).ok
  assert readText(dir & "/pumpkin.toml").len > 100

block folderFailures:
  let base = scratchDir("cfg_lib_folder")
  let missing = base & "/no/such/parent"
  let got = loadPumpkinConfig(missing)
  assert not got.ok
  assert got.err == "Failed to create config root folder: " & missing, got.err
  # One missing level is created.
  let one = base & "/made"
  discard tryRemoveFile(path(one & "/pumpkin.toml"))
  let made = loadPumpkinConfig(one)
  assert made.ok, made.err
  assert dirExists(one)
  assert fileExists(one & "/pumpkin.toml")

echo "libtest ok"
