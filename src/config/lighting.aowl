## Port of pumpkin-config/src/lighting.rs (lighting.rs)
##
## `#[serde(rename_all = "lowercase")]`: "default", "full", "dark".

import toml

type
  LightingEngineConfig* = enum
    lecDefault ## Default Vanilla lighting propagation.
    lecFull    ## Full skylight everywhere (no shadows).
    lecDark    ## Completely dark lighting everywhere (zero light).

const LightingNames = ["default", "full", "dark"]

proc defaultLightingEngineConfig*(): LightingEngineConfig {.inline.} =
  lecDefault

proc toToml*(c: LightingEngineConfig): TomlValue =
  tomlStr(LightingNames[ord(c)])

proc fromToml*(t: typedesc[LightingEngineConfig], v: TomlValue, d: var TomlDe): LightingEngineConfig =
  result = lecDefault
  let idx = d.readVariant(v, LightingNames)
  if idx >= 0:
    result = LightingEngineConfig(idx)
