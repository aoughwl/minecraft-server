## Test for lighting.aowl: the lowercase spellings and a bad name.

import std/[assertions, syncio]
import lighting
import toml

assert defaultLightingEngineConfig() == lecDefault
assert toToml(lecDefault).strVal == "default"
assert toToml(lecFull).strVal == "full"
assert toToml(lecDark).strVal == "dark"

var d = TomlDe()
assert fromToml(LightingEngineConfig, tomlStr("default"), d) == lecDefault
assert fromToml(LightingEngineConfig, tomlStr("full"), d) == lecFull
assert fromToml(LightingEngineConfig, tomlStr("dark"), d) == lecDark
assert not d.failed

var e = TomlDe()
discard fromToml(LightingEngineConfig, tomlStr("Full"), e)
assert e.err == "unknown variant `Full`, expected one of `default`, `full`, `dark`", e.err

echo "lightingtest ok"
