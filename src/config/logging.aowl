## Port of pumpkin-config/src/logging.rs (logging.rs)

import toml

type
  LoggingConfig* = object
    enabled*: bool
    threads*: bool
    color*: bool
    timestamp*: bool
    file*: string

proc defaultLoggingConfig*(): LoggingConfig =
  LoggingConfig(
    enabled: true,
    threads: true,
    color: true,
    timestamp: true,
    file: "latest.log",
  )

proc toToml*(c: LoggingConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("threads", tomlBool(c.threads))
  result.put("color", tomlBool(c.color))
  result.put("timestamp", tomlBool(c.timestamp))
  result.put("file", tomlStr(c.file))

proc fromToml*(t: typedesc[LoggingConfig], v: TomlValue, d: var TomlDe): LoggingConfig =
  result = defaultLoggingConfig()
  if not d.expectTable(v, "LoggingConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getBool(v, "threads", result.threads)
  d.getBool(v, "color", result.color)
  d.getBool(v, "timestamp", result.timestamp)
  d.getStr(v, "file", result.file)
