## Test for logging.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import logging
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultLoggingConfig()
assert c.enabled
assert c.threads
assert c.color
assert c.timestamp
assert c.file == "latest.log"

assert textOf(toToml(c)) == "enabled = true\nthreads = true\ncolor = true\ntimestamp = true\nfile = \"latest.log\"\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(LoggingConfig, parsed("threads = false\nfile = \"x.log\"\n"), d)
  assert not d.failed, d.err
  assert got.enabled
  assert not got.threads
  assert got.file == "x.log"

block roundTrip:
  var d = TomlDe()
  let back = fromToml(LoggingConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

echo "loggingtest ok"
