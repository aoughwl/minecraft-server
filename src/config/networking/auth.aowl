## Port of pumpkin-config/src/networking/auth.rs

import std/options
import ../../util/utillib
import ../toml

export ProfileAction

type
  PlayerProfileConfig* = object
    allowBannedPlayers*: bool
    allowedActions*: seq[ProfileAction]

  TextureTypes* = object
    skin*: bool
    cape*: bool
    elytra*: bool

  TextureConfig* = object
    enabled*: bool
    allowedUrlSchemes*: seq[string]
    allowedUrlDomains*: seq[string]
    types*: TextureTypes

  AuthenticationConfig* = object
    enabled*: bool
    url*: Option[string]
    connectTimeout*: uint32
    readTimeout*: uint32
    preventProxyConnections*: bool
    preventProxyConnectionAuthUrl*: Option[string]
    servicesUrl*: Option[string]
    playerProfile*: PlayerProfileConfig
    textures*: TextureConfig

const ProfileActionNames = ["FORCED_NAME_CHANGE", "USING_BANNED_SKIN"]

proc defaultPlayerProfileConfig*(): PlayerProfileConfig =
  PlayerProfileConfig(
    allowBannedPlayers: false,
    allowedActions: @[ForcedNameChange, UsingBannedSkin],
  )

proc defaultTextureTypes*(): TextureTypes =
  TextureTypes(skin: true, cape: true, elytra: true)

proc defaultTextureConfig*(): TextureConfig =
  TextureConfig(
    enabled: true,
    allowedUrlSchemes: @["http", "https"],
    allowedUrlDomains: @[".minecraft.net", ".mojang.com"],
    types: defaultTextureTypes(),
  )

proc defaultAuthenticationConfig*(): AuthenticationConfig =
  AuthenticationConfig(
    enabled: true,
    url: none[string](),
    connectTimeout: 5000'u32,
    readTimeout: 5000'u32,
    preventProxyConnections: false,
    preventProxyConnectionAuthUrl: none[string](),
    servicesUrl: none[string](),
    playerProfile: defaultPlayerProfileConfig(),
    textures: defaultTextureConfig(),
  )

proc toToml*(c: PlayerProfileConfig): TomlValue =
  result = newTomlTable()
  result.put("allow_banned_players", tomlBool(c.allowBannedPlayers))
  var actions: seq[string] = @[]
  for a in c.allowedActions:
    actions.add(ProfileActionNames[ord(a)])
  result.put("allowed_actions", tomlStrArr(actions))

proc toToml*(c: TextureTypes): TomlValue =
  result = newTomlTable()
  result.put("skin", tomlBool(c.skin))
  result.put("cape", tomlBool(c.cape))
  result.put("elytra", tomlBool(c.elytra))

proc toToml*(c: TextureConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("allowed_url_schemes", tomlStrArr(c.allowedUrlSchemes))
  result.put("allowed_url_domains", tomlStrArr(c.allowedUrlDomains))
  result.put("types", toToml(c.types))

proc toToml*(c: AuthenticationConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  if c.url.isSome:
    result.put("url", tomlStr(c.url.get()))
  result.put("connect_timeout", tomlInt(int64(c.connectTimeout)))
  result.put("read_timeout", tomlInt(int64(c.readTimeout)))
  result.put("prevent_proxy_connections", tomlBool(c.preventProxyConnections))
  if c.preventProxyConnectionAuthUrl.isSome:
    result.put("prevent_proxy_connection_auth_url", tomlStr(c.preventProxyConnectionAuthUrl.get()))
  if c.servicesUrl.isSome:
    result.put("services_url", tomlStr(c.servicesUrl.get()))
  result.put("player_profile", toToml(c.playerProfile))
  result.put("textures", toToml(c.textures))

proc fromToml*(t: typedesc[PlayerProfileConfig], v: TomlValue, d: var TomlDe): PlayerProfileConfig =
  result = defaultPlayerProfileConfig()
  if not d.expectTable(v, "PlayerProfileConfig"):
    return
  d.getBool(v, "allow_banned_players", result.allowBannedPlayers)
  var sub = TomlValue()
  if d.enter(v, "allowed_actions", sub):
    if sub.kind != tkArray:
      d.fail("invalid type: " & unexpected(sub) & ", expected a sequence")
    else:
      var actions: seq[ProfileAction] = @[]
      for item in sub.arr:
        let idx = d.readVariant(item, ProfileActionNames)
        if idx >= 0:
          actions.add(ProfileAction(idx))
      if not d.failed:
        result.allowedActions = actions
    d.leave()

proc fromToml*(t: typedesc[TextureTypes], v: TomlValue, d: var TomlDe): TextureTypes =
  result = defaultTextureTypes()
  if not d.expectTable(v, "TextureTypes"):
    return
  d.getBool(v, "skin", result.skin)
  d.getBool(v, "cape", result.cape)
  d.getBool(v, "elytra", result.elytra)

proc fromToml*(t: typedesc[TextureConfig], v: TomlValue, d: var TomlDe): TextureConfig =
  result = defaultTextureConfig()
  if not d.expectTable(v, "TextureConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getStrSeq(v, "allowed_url_schemes", result.allowedUrlSchemes)
  d.getStrSeq(v, "allowed_url_domains", result.allowedUrlDomains)
  var sub = TomlValue()
  if d.enter(v, "types", sub):
    result.types = fromToml(TextureTypes, sub, d)
    d.leave()

proc getOptStr*(d: var TomlDe; v: TomlValue; key: string; dst: var Option[string]) =
  ## `Option<String>`: present means Some.
  if v.hasKey(key):
    var text = ""
    d.getStr(v, key, text)
    dst = some(text)

proc fromToml*(t: typedesc[AuthenticationConfig], v: TomlValue, d: var TomlDe): AuthenticationConfig =
  result = defaultAuthenticationConfig()
  if not d.expectTable(v, "AuthenticationConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getOptStr(v, "url", result.url)
  d.getU32(v, "connect_timeout", result.connectTimeout)
  d.getU32(v, "read_timeout", result.readTimeout)
  d.getBool(v, "prevent_proxy_connections", result.preventProxyConnections)
  d.getOptStr(v, "prevent_proxy_connection_auth_url", result.preventProxyConnectionAuthUrl)
  d.getOptStr(v, "services_url", result.servicesUrl)
  var sub = TomlValue()
  if d.enter(v, "player_profile", sub):
    result.playerProfile = fromToml(PlayerProfileConfig, sub, d)
    d.leave()
  if d.enter(v, "textures", sub):
    result.textures = fromToml(TextureConfig, sub, d)
    d.leave()
