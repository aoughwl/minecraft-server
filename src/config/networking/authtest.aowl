## Test for auth.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import auth
import ../toml
import std/options

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultAuthenticationConfig()
assert c.enabled
assert c.url.isNone
assert c.connectTimeout == 5000'u32
assert c.readTimeout == 5000'u32
assert not c.preventProxyConnections
assert c.preventProxyConnectionAuthUrl.isNone
assert c.servicesUrl.isNone
assert not c.playerProfile.allowBannedPlayers
assert c.playerProfile.allowedActions == @[ForcedNameChange, UsingBannedSkin]
assert c.textures.enabled
assert c.textures.allowedUrlSchemes == @["http", "https"]
assert c.textures.allowedUrlDomains == @[".minecraft.net", ".mojang.com"]
assert c.textures.types.skin
assert c.textures.types.cape
assert c.textures.types.elytra

assert textOf(toToml(c)) == "enabled = true\nconnect_timeout = 5000\nread_timeout = 5000\nprevent_proxy_connections = false\n\n[player_profile]\nallow_banned_players = false\nallowed_actions = [\"FORCED_NAME_CHANGE\", \"USING_BANNED_SKIN\"]\n\n[textures]\nenabled = true\nallowed_url_schemes = [\"http\", \"https\"]\nallowed_url_domains = [\".minecraft.net\", \".mojang.com\"]\n\n[textures.types]\nskin = true\ncape = true\nelytra = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(AuthenticationConfig, parsed("url = \"http://a\"\nservices_url = \"http://s\"\n[player_profile]\nallowed_actions = [\"USING_BANNED_SKIN\"]\n[textures.types]\ncape = false\n"), d)
  assert not d.failed, d.err
  assert got.url.get() == "http://a"
  assert got.servicesUrl.get() == "http://s"
  assert got.playerProfile.allowedActions == @[UsingBannedSkin]
  assert not got.textures.types.cape
  assert got.textures.types.skin
  assert got.textures.allowedUrlSchemes.len == 2

block roundTrip:
  var d = TomlDe()
  let back = fromToml(AuthenticationConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(AuthenticationConfig, parsed("[player_profile]\nallowed_actions = [\"forced\"]\n"), d)
  assert d.err == "player_profile.allowed_actions: unknown variant `forced`, expected `FORCED_NAME_CHANGE` or `USING_BANNED_SKIN`", d.err

echo "authtest ok"
