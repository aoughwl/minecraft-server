## Port of pumpkin-config/src/networking/bedrock.rs
##
## `NonZeroU8` fields are `uint8`, with zero refused on read.

import std/options
import netaddr, compression
from auth import getOptStr
import ../toml

export netaddr

type
  BedrockAuthenticationConfig* = object
    enabled*: bool
    url*: Option[string]
    connectTimeout*: uint32
    readTimeout*: uint32

  BedrockConfig* = object
    enabled*: bool
    address*: SocketAddr
    encryption*: bool
    onlineMode*: bool
    maxPlayers*: uint32
    viewDistance*: uint8
    simulationDistance*: uint8
    compression*: CompressionConfig
    motd*: string
    authentication*: BedrockAuthenticationConfig

proc defaultBedrockAuthenticationConfig*(): BedrockAuthenticationConfig =
  BedrockAuthenticationConfig(
    enabled: true,
    url: none[string](),
    connectTimeout: 5000'u32,
    readTimeout: 5000'u32,
  )

proc defaultBedrockConfig*(): BedrockConfig =
  BedrockConfig(
    enabled: true,
    address: unspecified(19132'u16),
    encryption: true,
    onlineMode: true,
    maxPlayers: 1000'u32,
    viewDistance: 16'u8,
    simulationDistance: 10'u8,
    compression: defaultCompressionConfig(),
    motd: "A blazingly fast Pumpkin server!",
    authentication: defaultBedrockAuthenticationConfig(),
  )

proc toToml*(c: BedrockAuthenticationConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  if c.url.isSome:
    result.put("url", tomlStr(c.url.get()))
  result.put("connect_timeout", tomlInt(int64(c.connectTimeout)))
  result.put("read_timeout", tomlInt(int64(c.readTimeout)))

proc toToml*(c: BedrockConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("address", toToml(c.address))
  result.put("encryption", tomlBool(c.encryption))
  result.put("online_mode", tomlBool(c.onlineMode))
  result.put("max_players", tomlInt(int64(c.maxPlayers)))
  result.put("view_distance", tomlInt(int64(c.viewDistance)))
  result.put("simulation_distance", tomlInt(int64(c.simulationDistance)))
  result.put("compression", toToml(c.compression))
  result.put("motd", tomlStr(c.motd))
  result.put("authentication", toToml(c.authentication))

proc fromToml*(t: typedesc[BedrockAuthenticationConfig], v: TomlValue, d: var TomlDe): BedrockAuthenticationConfig =
  result = defaultBedrockAuthenticationConfig()
  if not d.expectTable(v, "BedrockAuthenticationConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getOptStr(v, "url", result.url)
  d.getU32(v, "connect_timeout", result.connectTimeout)
  d.getU32(v, "read_timeout", result.readTimeout)

proc fromToml*(t: typedesc[BedrockConfig], v: TomlValue, d: var TomlDe): BedrockConfig =
  result = defaultBedrockConfig()
  if not d.expectTable(v, "BedrockConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getSocketAddr(v, "address", result.address)
  d.getBool(v, "encryption", result.encryption)
  d.getBool(v, "online_mode", result.onlineMode)
  d.getU32(v, "max_players", result.maxPlayers)
  d.getNonZeroU8(v, "view_distance", result.viewDistance)
  d.getNonZeroU8(v, "simulation_distance", result.simulationDistance)
  var sub = TomlValue()
  if d.enter(v, "compression", sub):
    result.compression = fromToml(CompressionConfig, sub, d)
    d.leave()
  d.getStr(v, "motd", result.motd)
  if d.enter(v, "authentication", sub):
    result.authentication = fromToml(BedrockAuthenticationConfig, sub, d)
    d.leave()
