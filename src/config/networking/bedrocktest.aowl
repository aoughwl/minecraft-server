## Test for bedrock.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import bedrock
import ../toml
import std/options

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultBedrockConfig()
assert c.enabled
assert $c.address == "0.0.0.0:19132"
assert c.encryption
assert c.onlineMode
assert c.maxPlayers == 1000'u32
assert c.viewDistance == 16'u8
assert c.simulationDistance == 10'u8
assert c.motd == "A blazingly fast Pumpkin server!"
assert c.authentication.enabled
assert c.authentication.url.isNone
assert c.authentication.connectTimeout == 5000'u32

assert textOf(toToml(c)) == "enabled = true\naddress = \"0.0.0.0:19132\"\nencryption = true\nonline_mode = true\nmax_players = 1000\nview_distance = 16\nsimulation_distance = 10\nmotd = \"A blazingly fast Pumpkin server!\"\n\n[compression]\nenabled = true\nthreshold = 256\nlevel = 4\n\n[authentication]\nenabled = true\nconnect_timeout = 5000\nread_timeout = 5000\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(BedrockConfig, parsed("[authentication]\nurl = \"u\"\n"), d)
  assert not d.failed, d.err
  assert got.authentication.url.get() == "u"
  assert got.authentication.readTimeout == 5000'u32

block roundTrip:
  var d = TomlDe()
  let back = fromToml(BedrockConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(BedrockConfig, parsed("simulation_distance = 256\n"), d)
  assert d.err == "simulation_distance: invalid value: integer `256`, expected a nonzero u8", d.err

echo "bedrocktest ok"
