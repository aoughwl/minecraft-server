## Port of pumpkin-config/src/networking/compression.rs
## `#[serde(flatten)]` on `info`: its keys sit in the same table as `enabled`.

import ../toml

type
  CompressionInfo* = object
    threshold*: uint32
    level*: uint32

proc defaultCompressionInfo*(): CompressionInfo =
  CompressionInfo(
    threshold: 256'u32,
    level: 4'u32,
  )

proc toToml*(c: CompressionInfo): TomlValue =
  result = newTomlTable()
  result.put("threshold", tomlInt(int64(c.threshold)))
  result.put("level", tomlInt(int64(c.level)))

proc fromToml*(t: typedesc[CompressionInfo], v: TomlValue, d: var TomlDe): CompressionInfo =
  result = defaultCompressionInfo()
  if not d.expectTable(v, "CompressionInfo"):
    return
  d.getU32(v, "threshold", result.threshold)
  d.getU32(v, "level", result.level)

type
  CompressionConfig* = object
    enabled*: bool
    info*: CompressionInfo

proc defaultCompressionConfig*(): CompressionConfig =
  CompressionConfig(enabled: true, info: defaultCompressionInfo())

proc toToml*(c: CompressionConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.flatten(toToml(c.info))

proc fromToml*(t: typedesc[CompressionConfig], v: TomlValue, d: var TomlDe): CompressionConfig =
  result = defaultCompressionConfig()
  if not d.expectTable(v, "CompressionConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  result.info = fromToml(CompressionInfo, v, d)
