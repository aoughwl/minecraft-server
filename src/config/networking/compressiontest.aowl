## Test for compression.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import compression
import ../toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultCompressionConfig()
assert c.enabled
assert c.info.threshold == 256'u32
assert c.info.level == 4'u32

assert textOf(toToml(c)) == "enabled = true\nthreshold = 256\nlevel = 4\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(CompressionConfig, parsed("threshold = 64\n"), d)
  assert not d.failed, d.err
  assert got.enabled
  assert got.info.threshold == 64'u32
  assert got.info.level == 4'u32

block roundTrip:
  var d = TomlDe()
  let back = fromToml(CompressionConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(CompressionConfig, parsed("level = \"x\"\n"), d)
  assert d.err == "level: invalid type: string \"x\", expected u32", d.err

echo "compressiontest ok"
