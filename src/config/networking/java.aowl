## Port of pumpkin-config/src/networking/java.rs
##
## `NonZeroU8` fields are `uint8`, with zero refused on read.

import netaddr, compression, auth
import ../toml

export netaddr

type
  JavaConfig* = object
    enabled*: bool
    address*: SocketAddr
    encryption*: bool
    onlineMode*: bool
    maxPlayers*: uint32
    viewDistance*: uint8
    simulationDistance*: uint8
    compression*: CompressionConfig
    motd*: string
    authentication*: AuthenticationConfig

proc defaultJavaConfig*(): JavaConfig =
  JavaConfig(
    enabled: true,
    address: unspecified(25565'u16),
    encryption: true,
    onlineMode: true,
    maxPlayers: 1000'u32,
    viewDistance: 16'u8,
    simulationDistance: 10'u8,
    compression: defaultCompressionConfig(),
    motd: "A blazingly fast Pumpkin server!",
    authentication: defaultAuthenticationConfig(),
  )

proc toToml*(c: JavaConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("address", toToml(c.address))
  result.put("encryption", tomlBool(c.encryption))
  result.put("online_mode", tomlBool(c.onlineMode))
  result.put("max_players", tomlInt(int64(c.maxPlayers)))
  result.put("view_distance", tomlInt(int64(c.viewDistance)))
  result.put("simulation_distance", tomlInt(int64(c.simulationDistance)))
  result.put("compression", toToml(c.compression))
  result.put("motd", tomlStr(c.motd))
  result.put("authentication", toToml(c.authentication))

proc fromToml*(t: typedesc[JavaConfig], v: TomlValue, d: var TomlDe): JavaConfig =
  result = defaultJavaConfig()
  if not d.expectTable(v, "JavaConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getSocketAddr(v, "address", result.address)
  d.getBool(v, "encryption", result.encryption)
  d.getBool(v, "online_mode", result.onlineMode)
  d.getU32(v, "max_players", result.maxPlayers)
  d.getNonZeroU8(v, "view_distance", result.viewDistance)
  d.getNonZeroU8(v, "simulation_distance", result.simulationDistance)
  var sub = TomlValue()
  if d.enter(v, "compression", sub):
    result.compression = fromToml(CompressionConfig, sub, d)
    d.leave()
  d.getStr(v, "motd", result.motd)
  if d.enter(v, "authentication", sub):
    result.authentication = fromToml(AuthenticationConfig, sub, d)
    d.leave()
