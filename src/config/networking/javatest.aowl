## Test for java.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import java
import ../toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultJavaConfig()
assert c.enabled
assert $c.address == "0.0.0.0:25565"
assert c.encryption
assert c.onlineMode
assert c.maxPlayers == 1000'u32
assert c.viewDistance == 16'u8
assert c.simulationDistance == 10'u8
assert c.compression.enabled
assert c.motd == "A blazingly fast Pumpkin server!"
assert c.authentication.enabled

assert textOf(toToml(c)) == "enabled = true\naddress = \"0.0.0.0:25565\"\nencryption = true\nonline_mode = true\nmax_players = 1000\nview_distance = 16\nsimulation_distance = 10\nmotd = \"A blazingly fast Pumpkin server!\"\n\n[compression]\nenabled = true\nthreshold = 256\nlevel = 4\n\n[authentication]\nenabled = true\nconnect_timeout = 5000\nread_timeout = 5000\nprevent_proxy_connections = false\n\n[authentication.player_profile]\nallow_banned_players = false\nallowed_actions = [\"FORCED_NAME_CHANGE\", \"USING_BANNED_SKIN\"]\n\n[authentication.textures]\nenabled = true\nallowed_url_schemes = [\"http\", \"https\"]\nallowed_url_domains = [\".minecraft.net\", \".mojang.com\"]\n\n[authentication.textures.types]\nskin = true\ncape = true\nelytra = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(JavaConfig, parsed("view_distance = 32\nonline_mode = false\n"), d)
  assert not d.failed, d.err
  assert got.viewDistance == 32'u8
  assert not got.onlineMode

block roundTrip:
  var d = TomlDe()
  let back = fromToml(JavaConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(JavaConfig, parsed("view_distance = 0\n"), d)
  assert d.err == "view_distance: invalid value: integer `0`, expected a nonzero u8", d.err

echo "javatest ok"
