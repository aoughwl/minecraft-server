## Port of pumpkin-config/src/networking/lan_broadcast.rs

import std/options
import ../toml

type
  LANBroadcastConfig* = object
    enabled*: bool
    motd*: Option[string]
    port*: Option[uint16]

proc defaultLANBroadcastConfig*(): LANBroadcastConfig =
  LANBroadcastConfig(enabled: false, motd: none[string](), port: none[uint16]())

proc toToml*(c: LANBroadcastConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  if c.motd.isSome:
    result.put("motd", tomlStr(c.motd.get()))
  if c.port.isSome:
    result.put("port", tomlInt(int64(c.port.get())))

proc fromToml*(t: typedesc[LANBroadcastConfig], v: TomlValue, d: var TomlDe): LANBroadcastConfig =
  result = defaultLANBroadcastConfig()
  if not d.expectTable(v, "LANBroadcastConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  if v.hasKey("motd"):
    var text = ""
    d.getStr(v, "motd", text)
    result.motd = some(text)
  if v.hasKey("port"):
    var port = 0'u16
    d.getU16(v, "port", port)
    result.port = some(port)
