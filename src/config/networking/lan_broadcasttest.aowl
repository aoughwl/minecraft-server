## Test for lan_broadcast.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import lan_broadcast
import ../toml
import std/options

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultLANBroadcastConfig()
assert not c.enabled
assert c.motd.isNone
assert c.port.isNone

assert textOf(toToml(c)) == "enabled = false\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(LANBroadcastConfig, parsed("motd = \"hi\"\nport = 4445\n"), d)
  assert not d.failed, d.err
  assert got.motd.get() == "hi"
  assert got.port.get() == 4445'u16
  assert textOf(toToml(got)) == "enabled = false\nmotd = \"hi\"\nport = 4445\n"

block roundTrip:
  var d = TomlDe()
  let back = fromToml(LANBroadcastConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(LANBroadcastConfig, parsed("port = 70000\n"), d)
  assert d.err == "port: invalid value: integer `70000`, expected u16", d.err

echo "lan_broadcasttest ok"
