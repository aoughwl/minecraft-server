## Test for netaddr.aowl: Rust's `SocketAddr` parse and display.

import std/[assertions, syncio]
import netaddr

proc show(text: string): string =
  let (ok, a) = parseSocketAddr(text)
  assert ok, text
  $a

proc refuses(text: string) =
  let (ok, _) = parseSocketAddr(text)
  assert not ok, text

assert $unspecified(25565'u16) == "0.0.0.0:25565"
assert show("0.0.0.0:25565") == "0.0.0.0:25565"
assert show("127.0.0.1:0") == "127.0.0.1:0"
assert show("255.255.255.255:65535") == "255.255.255.255:65535"
assert show("1.2.3.4:080") == "1.2.3.4:80"
assert show("[::]:19132") == "[::]:19132"
assert show("[::1]:1") == "[::1]:1"
assert show("[1:2:3:4:5:6:7:8]:9") == "[1:2:3:4:5:6:7:8]:9"
assert show("[2001:DB8::1]:9") == "[2001:db8::1]:9"
assert show("[2001:0db8:0:0:1:0:0:1]:9") == "[2001:db8::1:0:0:1]:9"
assert show("[1:0:0:2:0:0:0:3]:9") == "[1:0:0:2::3]:9"
assert show("[1:0:2:3:4:5:6:7]:9") == "[1:0:2:3:4:5:6:7]:9"
assert show("[1::]:9") == "[1::]:9"
assert show("[::ffff:1.2.3.4]:9") == "[::ffff:1.2.3.4]:9"
assert show("[::1.2.3.4]:9") == "[::102:304]:9"
assert show("[fe80::1%3]:9") == "[fe80::1%3]:9"

let (ok, a) = parseSocketAddr("[::1]:7")
assert ok
assert a.isV6
assert a.ip[15] == 1'u8
assert a.port == 7'u16
assert a == parseSocketAddr("[0:0:0:0:0:0:0:1]:7")[1]
assert not (a == parseSocketAddr("[::1]:8")[1])

refuses("")
refuses("0.0.0.0")
refuses("0.0.0.0:")
refuses("0.0.0.0:65536")
refuses("0.0.0.0:+1")
refuses("0.0.0:1")
refuses("0.0.0.0.0:1")
refuses("256.0.0.1:1")
refuses("01.0.0.1:1")
refuses("localhost:1")
refuses("[::1]")
refuses("[::1]:")
refuses("::1:80")
refuses("[1:2:3:4:5:6:7]:1")
refuses("[1:2:3:4:5:6:7:8:9]:1")
refuses("[1::2::3]:1")
refuses("[:1]:1")
refuses("[1:]:1")
refuses("[12345::]:1")
refuses("[1:2:3:4:5:6:7:8::]:1")
refuses("[fe80::1%]:9")
refuses("[fe80::1%x]:9")

echo "netaddrtest ok"
