## Port of pumpkin-config/src/networking/mod.rs

import query, rcon, proxy, lan_broadcast, java, bedrock, auth, compression
import ../toml

export query, rcon, proxy, lan_broadcast, java, bedrock, auth, compression

type
  NetworkingConfig* = object
    query*: QueryConfig
    rcon*: RCONConfig
    proxy*: ProxyConfig
    lanBroadcast*: LANBroadcastConfig
    java*: JavaConfig
    bedrock*: BedrockConfig

proc defaultNetworkingConfig*(): NetworkingConfig =
  NetworkingConfig(
    query: defaultQueryConfig(),
    rcon: defaultRCONConfig(),
    proxy: defaultProxyConfig(),
    lanBroadcast: defaultLANBroadcastConfig(),
    java: defaultJavaConfig(),
    bedrock: defaultBedrockConfig(),
  )

proc toToml*(c: NetworkingConfig): TomlValue =
  result = newTomlTable()
  result.put("query", toToml(c.query))
  result.put("rcon", toToml(c.rcon))
  result.put("proxy", toToml(c.proxy))
  result.put("lan_broadcast", toToml(c.lanBroadcast))
  result.put("java", toToml(c.java))
  result.put("bedrock", toToml(c.bedrock))

proc fromToml*(t: typedesc[NetworkingConfig], v: TomlValue, d: var TomlDe): NetworkingConfig =
  result = defaultNetworkingConfig()
  if not d.expectTable(v, "NetworkingConfig"):
    return
  var sub = TomlValue()
  if d.enter(v, "query", sub):
    result.query = fromToml(QueryConfig, sub, d)
    d.leave()
  if d.enter(v, "rcon", sub):
    result.rcon = fromToml(RCONConfig, sub, d)
    d.leave()
  if d.enter(v, "proxy", sub):
    result.proxy = fromToml(ProxyConfig, sub, d)
    d.leave()
  if d.enter(v, "lan_broadcast", sub):
    result.lanBroadcast = fromToml(LANBroadcastConfig, sub, d)
    d.leave()
  if d.enter(v, "java", sub):
    result.java = fromToml(JavaConfig, sub, d)
    d.leave()
  if d.enter(v, "bedrock", sub):
    result.bedrock = fromToml(BedrockConfig, sub, d)
    d.leave()
