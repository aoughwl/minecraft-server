## Test for networking.aowl: defaults, table order, a partial read.

import std/[assertions, syncio, options]
import networking
import ../toml

let c = defaultNetworkingConfig()
assert c.query.enabled
assert not c.rcon.enabled
assert not c.proxy.enabled
assert not c.lanBroadcast.enabled
assert c.java.enabled
assert c.bedrock.enabled

let w = writeToml(toToml(c))
assert w.ok
# Tables in field order. The root has no values of its own here.
let headers = ["[query]", "[rcon]", "[rcon.logging]", "[proxy]", "[proxy.velocity]", "[proxy.bungeecord]",
  "[lan_broadcast]", "[java]", "[java.compression]", "[java.authentication]",
  "[java.authentication.player_profile]", "[java.authentication.textures]",
  "[java.authentication.textures.types]", "[bedrock]", "[bedrock.compression]", "[bedrock.authentication]"]
var seen: seq[string] = @[]
var line = ""
for ch in w.text:
  if ch == '\n':
    if line.len > 0 and line[0] == '[':
      seen.add(line)
    line = ""
  else:
    line.add(ch)
assert seen.len == headers.len, $seen.len
for i in 0 ..< headers.len:
  assert seen[i] == headers[i], seen[i]

let p = parseToml("[java]\nmax_players = 5\n[lan_broadcast]\nmotd = \"m\"\n[bedrock]\nenabled = false\n")
assert p.ok, p.err
var d = TomlDe()
let got = fromToml(NetworkingConfig, p.value, d)
assert not d.failed, d.err
assert got.java.maxPlayers == 5'u32
assert got.lanBroadcast.motd.get() == "m"
assert not got.bedrock.enabled
assert got.query.enabled

let bad = parseToml("[java.authentication.textures.types]\nskin = 1\n")
assert bad.ok
var e = TomlDe()
discard fromToml(NetworkingConfig, bad.value, e)
assert e.err == "java.authentication.textures.types.skin: invalid type: integer `1`, expected a boolean", e.err

echo "networkingtest ok"
