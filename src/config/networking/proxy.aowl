## Port of pumpkin-config/src/networking/proxy.rs

import ../toml

type
  BungeeCordConfig* = object
    enabled*: bool

  VelocityConfig* = object
    enabled*: bool
    secret*: string

  ProxyConfig* = object
    enabled*: bool
    velocity*: VelocityConfig
    bungeecord*: BungeeCordConfig

proc defaultBungeeCordConfig*(): BungeeCordConfig =
  BungeeCordConfig(enabled: false)

proc defaultVelocityConfig*(): VelocityConfig =
  VelocityConfig(enabled: false, secret: "")

proc defaultProxyConfig*(): ProxyConfig =
  ProxyConfig(enabled: false, velocity: defaultVelocityConfig(), bungeecord: defaultBungeeCordConfig())

proc toToml*(c: BungeeCordConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))

proc toToml*(c: VelocityConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("secret", tomlStr(c.secret))

proc toToml*(c: ProxyConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("velocity", toToml(c.velocity))
  result.put("bungeecord", toToml(c.bungeecord))

proc fromToml*(t: typedesc[BungeeCordConfig], v: TomlValue, d: var TomlDe): BungeeCordConfig =
  result = defaultBungeeCordConfig()
  if not d.expectTable(v, "BungeeCordConfig"):
    return
  d.getBool(v, "enabled", result.enabled)

proc fromToml*(t: typedesc[VelocityConfig], v: TomlValue, d: var TomlDe): VelocityConfig =
  result = defaultVelocityConfig()
  if not d.expectTable(v, "VelocityConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getStr(v, "secret", result.secret)

proc fromToml*(t: typedesc[ProxyConfig], v: TomlValue, d: var TomlDe): ProxyConfig =
  result = defaultProxyConfig()
  if not d.expectTable(v, "ProxyConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  var sub = TomlValue()
  if d.enter(v, "velocity", sub):
    result.velocity = fromToml(VelocityConfig, sub, d)
    d.leave()
  if d.enter(v, "bungeecord", sub):
    result.bungeecord = fromToml(BungeeCordConfig, sub, d)
    d.leave()
