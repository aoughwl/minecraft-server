## Test for proxy.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import proxy
import ../toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultProxyConfig()
assert not c.enabled
assert not c.velocity.enabled
assert c.velocity.secret == ""
assert not c.bungeecord.enabled

assert textOf(toToml(c)) == "enabled = false\n\n[velocity]\nenabled = false\nsecret = \"\"\n\n[bungeecord]\nenabled = false\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(ProxyConfig, parsed("[velocity]\nenabled = true\nsecret = \"s\"\n"), d)
  assert not d.failed, d.err
  assert got.velocity.enabled
  assert got.velocity.secret == "s"
  assert not got.bungeecord.enabled

block roundTrip:
  var d = TomlDe()
  let back = fromToml(ProxyConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

echo "proxytest ok"
