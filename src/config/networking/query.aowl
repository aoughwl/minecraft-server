## Port of pumpkin-config/src/networking/query.rs

import netaddr
import ../toml

export netaddr

type
  QueryConfig* = object
    enabled*: bool
    address*: SocketAddr

proc defaultQueryConfig*(): QueryConfig =
  QueryConfig(enabled: true, address: unspecified(25565'u16))

proc toToml*(c: QueryConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("address", toToml(c.address))

proc fromToml*(t: typedesc[QueryConfig], v: TomlValue, d: var TomlDe): QueryConfig =
  result = defaultQueryConfig()
  if not d.expectTable(v, "QueryConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getSocketAddr(v, "address", result.address)
