## Test for query.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import query
import ../toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultQueryConfig()
assert c.enabled
assert $c.address == "0.0.0.0:25565"

assert textOf(toToml(c)) == "enabled = true\naddress = \"0.0.0.0:25565\"\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(QueryConfig, parsed("address = \"127.0.0.1:1\"\n"), d)
  assert not d.failed, d.err
  assert got.enabled
  assert $got.address == "127.0.0.1:1"

block roundTrip:
  var d = TomlDe()
  let back = fromToml(QueryConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(QueryConfig, parsed("address = \"nope\"\n"), d)
  assert d.err == "address: invalid socket address syntax", d.err

echo "querytest ok"
