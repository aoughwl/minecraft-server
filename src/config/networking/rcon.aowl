## Port of pumpkin-config/src/networking/rcon.rs

import netaddr
import ../toml

export netaddr

type
  RCONLogging* = object
    loggedSuccessfully*: bool
    wrongPassword*: bool
    commands*: bool
    quit*: bool

  RCONConfig* = object
    enabled*: bool
    address*: SocketAddr
    password*: string
    maxConnections*: uint32
    logging*: RCONLogging

proc defaultRCONLogging*(): RCONLogging =
  RCONLogging(loggedSuccessfully: true, wrongPassword: true, commands: true, quit: true)

proc defaultRCONConfig*(): RCONConfig =
  RCONConfig(
    enabled: false,
    address: unspecified(25575'u16),
    password: "",
    maxConnections: 10'u32,
    logging: defaultRCONLogging(),
  )

proc toToml*(c: RCONLogging): TomlValue =
  result = newTomlTable()
  result.put("logged_successfully", tomlBool(c.loggedSuccessfully))
  result.put("wrong_password", tomlBool(c.wrongPassword))
  result.put("commands", tomlBool(c.commands))
  result.put("quit", tomlBool(c.quit))

proc toToml*(c: RCONConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("address", toToml(c.address))
  result.put("password", tomlStr(c.password))
  result.put("max_connections", tomlInt(int64(c.maxConnections)))
  result.put("logging", toToml(c.logging))

proc fromToml*(t: typedesc[RCONLogging], v: TomlValue, d: var TomlDe): RCONLogging =
  result = defaultRCONLogging()
  if not d.expectTable(v, "RCONLogging"):
    return
  d.getBool(v, "logged_successfully", result.loggedSuccessfully)
  d.getBool(v, "wrong_password", result.wrongPassword)
  d.getBool(v, "commands", result.commands)
  d.getBool(v, "quit", result.quit)

proc fromToml*(t: typedesc[RCONConfig], v: TomlValue, d: var TomlDe): RCONConfig =
  result = defaultRCONConfig()
  if not d.expectTable(v, "RCONConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getSocketAddr(v, "address", result.address)
  d.getStr(v, "password", result.password)
  d.getU32(v, "max_connections", result.maxConnections)
  var sub = TomlValue()
  if d.enter(v, "logging", sub):
    result.logging = fromToml(RCONLogging, sub, d)
    d.leave()
