## Test for rcon.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import rcon
import ../toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultRCONConfig()
assert not c.enabled
assert $c.address == "0.0.0.0:25575"
assert c.password == ""
assert c.maxConnections == 10'u32
assert c.logging.loggedSuccessfully
assert c.logging.wrongPassword
assert c.logging.commands
assert c.logging.quit

assert textOf(toToml(c)) == "enabled = false\naddress = \"0.0.0.0:25575\"\npassword = \"\"\nmax_connections = 10\n\n[logging]\nlogged_successfully = true\nwrong_password = true\ncommands = true\nquit = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(RCONConfig, parsed("password = \"s\"\n[logging]\nquit = false\n"), d)
  assert not d.failed, d.err
  assert got.password == "s"
  assert not got.logging.quit
  assert got.logging.commands

block roundTrip:
  var d = TomlDe()
  let back = fromToml(RCONConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(RCONConfig, parsed("max_connections = 4294967296\n"), d)
  assert d.err == "max_connections: invalid value: integer `4294967296`, expected u32", d.err

echo "rcontest ok"
