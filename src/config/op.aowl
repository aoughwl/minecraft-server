## Port of pumpkin-config/src/op.rs (op.rs) and of pumpkin/src/data/op.rs
##
## `ops.json`, the `OperatorConfig` file: a JSON array of `Op`, `#[serde(transparent)]`. Every `Op` field is
## required on read, unknown ones are ignored, and `level` goes through `PermissionLvl`'s reader, which leaves out 1.

import std/[json, options]
import ../util/uuid
import commands
import data_json

export PermissionLvl, Uuid

const OpsFileName* = "ops.json"

type
  Op* = object
    uuid*: Uuid
    name*: string
    level*: PermissionLvl
    bypassesPlayerLimit*: bool

  OperatorConfig* = object
    ops*: seq[Op]

  OperatorConfigResult* = object
    ok*: bool
    value*: OperatorConfig
    err*: string
    warning*: string

proc newOp*(uuid: Uuid; name: string; level: PermissionLvl; bypassesPlayerLimit: bool): Op =
  Op(uuid: uuid, name: name, level: level, bypassesPlayerLimit: bypassesPlayerLimit)

proc getEntry*(c: OperatorConfig; id: Uuid): Option[Op] =
  ## `OperatorConfig::get_entry`
  for entry in c.ops:
    if entry.uuid == id:
      return some(entry)
  none[Op]()

proc opsToJson*(c: OperatorConfig): string =
  ## `serde_json::to_string_pretty`.
  result = ""
  var first = true
  for op in c.ops:
    if not first:
      prettyObjectClose(result)
    prettyArrayOpen(result, first)
    first = false
    prettyField(result, "uuid", prettyStr($op.uuid), false)
    prettyField(result, "name", prettyStr(op.name), false)
    prettyField(result, "level", $ord(op.level), false)
    prettyField(result, "bypasses_player_limit", (if op.bypassesPlayerLimit: "true" else: "false"), true)
  prettyArrayClose(result, c.ops.len == 0)

proc opsFromJson*(text: string): OperatorConfigResult =
  ## `serde_json::from_str`.
  result = OperatorConfigResult(ok: false)
  var tree = parseJson(text)
  if tree.hasError:
    result.err = errorMsg(tree)
    return
  let top = root(tree)
  if top.kind != JArray:
    result.err = "invalid type, expected a sequence"
    return
  if hasTrailingContent(text):
    result.err = "trailing characters"
    return
  var ops: seq[Op] = @[]
  for item in top:
    if item.kind != JObject:
      result.err = "invalid type, expected struct Op"
      return
    var op = Op()
    var hasUuid = false
    var hasName = false
    var hasLevel = false
    var hasBypass = false
    for (key, value) in item.pairs:
      case key
      of "uuid":
        if value.kind != JString:
          result.err = "invalid type for `uuid`, expected UUID"
          return
        let (ok, id) = parseStr(value.getStr)
        if not ok:
          result.err = "UUID parsing failed: " & value.getStr
          return
        op.uuid = id
        hasUuid = true
      of "name":
        if value.kind != JString:
          result.err = "invalid type for `name`, expected a string"
          return
        op.name = value.getStr
        hasName = true
      of "level":
        if value.kind != JInt or value.getInt < 0 or value.getInt > 255:
          result.err = "invalid value for `level`, expected u8"
          return
        let (ok, lvl) = permissionLvlFromU8(uint64(value.getInt))
        if not ok:
          result.err = "Invalid value for OpLevel: " & $value.getInt
          return
        op.level = lvl
        hasLevel = true
      of "bypasses_player_limit":
        if value.kind != JBool:
          result.err = "invalid type for `bypasses_player_limit`, expected a boolean"
          return
        op.bypassesPlayerLimit = value.getBool
        hasBypass = true
      else:
        discard
    if not hasUuid:
      result.err = "missing field `uuid`"
      return
    if not hasName:
      result.err = "missing field `name`"
      return
    if not hasLevel:
      result.err = "missing field `level`"
      return
    if not hasBypass:
      result.err = "missing field `bypasses_player_limit`"
      return
    ops.add(op)
  result.ok = true
  result.value = OperatorConfig(ops: ops)

proc loadOperatorConfig*(dataDir: string): OperatorConfigResult =
  ## `LoadJSONConfiguration::load`: reads `ops.json`, or writes an empty one when absent.
  let file = readOrCreateDataFile(dataDir, OpsFileName, opsToJson(OperatorConfig()))
  if not file.ok:
    return OperatorConfigResult(ok: false, err: file.err)
  result = opsFromJson(file.text)
  if not result.ok:
    result.err = parseFailure(dataDir & OpsFileName, result.err)
  result.warning = file.warning

proc saveOperatorConfig*(c: OperatorConfig; dataDir: string): JsonFileWrite =
  ## `SaveJSONConfiguration::save`
  writeDataFile(dataDir, OpsFileName, opsToJson(c))
