## Test for op.aowl: the exact ops.json text, its load and save, and refusals.

import std/[assertions, syncio, os, options, envvars]
from std/paths import path, Path
from std/dirs import tryCreateFinalDir, tryRemoveFile
import ../util/uuid
import op

proc scratchDir(name: string): string =
  ## Under CONFIGTEST_DIR, or beside the test executable.
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  result = base & "/" & name
  if not dirExists(result):
    discard tryCreateFinalDir(path(result))
  assert dirExists(result), result

proc readText(p: string): string =
  result = ""
  try:
    result = readFile(p)
  except ErrorCode:
    assert false, "cannot read " & p

proc writeText(p, text: string) =
  try:
    writeFile(p, text)
  except ErrorCode:
    assert false, "cannot write " & p

let a = parseStr("12345678-1234-1234-1234-123456789abc")[1]
let b = parseStr("00000000-0000-0000-0000-000000000001")[1]
let dflt = Op()
assert dflt.name == ""
assert dflt.level == Zero
assert not dflt.bypassesPlayerLimit

block text:
  assert opsToJson(OperatorConfig()) == "[]"
  let cfg = OperatorConfig(ops: @[newOp(a, "Al\"ice", Four, false), newOp(b, "Bob", Two, true)])
  let expected = "[\n  {\n    \"uuid\": \"12345678-1234-1234-1234-123456789abc\",\n    \"name\": \"Al\\\"ice\",\n    \"level\": 4,\n    \"bypasses_player_limit\": false\n  },\n  {\n    \"uuid\": \"00000000-0000-0000-0000-000000000001\",\n    \"name\": \"Bob\",\n    \"level\": 2,\n    \"bypasses_player_limit\": true\n  }\n]"
  assert opsToJson(cfg) == expected, opsToJson(cfg)
  let back = opsFromJson(expected)
  assert back.ok, back.err
  assert back.value.ops.len == 2
  assert back.value.ops[0].name == "Al\"ice"
  assert back.value.ops[1].level == Two
  assert back.value.ops[1].bypassesPlayerLimit
  assert back.value.getEntry(b).get().name == "Bob"
  assert back.value.getEntry(NilUuid).isNone

block fileIo:
  let dir = scratchDir("cfg_op")
  discard tryRemoveFile(path(dir & "/ops.json"))
  let made = loadOperatorConfig(dir)
  assert made.ok, made.err
  assert made.value.ops.len == 0
  assert readText(dir & "/ops.json") == "[]"
  let cfg = OperatorConfig(ops: @[newOp(a, "Alice", Three, true)])
  let saved = saveOperatorConfig(cfg, dir)
  assert saved.ok, saved.err
  let loaded = loadOperatorConfig(dir)
  assert loaded.ok, loaded.err
  assert loaded.value.ops.len == 1
  assert loaded.value.ops[0].uuid == a
  assert loaded.value.ops[0].level == Three
  writeText(dir & "/ops.json", "not json")
  let broken = loadOperatorConfig(dir)
  assert not broken.ok
  assert broken.err.len > 0
  discard tryRemoveFile(path(dir & "/ops.json"))

proc refuses(text, why: string) =
  let r = opsFromJson(text)
  assert not r.ok, text
  assert r.err == why, r.err

refuses("{}", "invalid type, expected a sequence")
refuses("[1]", "invalid type, expected struct Op")
refuses("[{\"name\":\"n\",\"level\":0,\"bypasses_player_limit\":false}]", "missing field `uuid`")
refuses("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"level\":0,\"bypasses_player_limit\":false}]", "missing field `name`")
refuses("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"bypasses_player_limit\":false}]", "missing field `level`")
refuses("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"level\":0}]", "missing field `bypasses_player_limit`")
refuses("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"level\":1,\"bypasses_player_limit\":false}]", "Invalid value for OpLevel: 1")
refuses("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"level\":5,\"bypasses_player_limit\":false}]", "Invalid value for OpLevel: 5")
refuses("[{\"uuid\":\"nope\",\"name\":\"n\",\"level\":0,\"bypasses_player_limit\":false}]", "UUID parsing failed: nope")
# Unknown fields are ignored.
assert opsFromJson("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"level\":0,\"bypasses_player_limit\":false,\"x\":[1,{}]}]").ok
assert not opsFromJson("[] trailing").ok

echo "optest ok"
