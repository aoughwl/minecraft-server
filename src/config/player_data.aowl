## Port of pumpkin-config/src/player_data.rs (player_data.rs)

import toml

type
  PlayerDataConfig* = object
    savePlayerData*: bool
    savePlayerCronInterval*: uint64

proc defaultPlayerDataConfig*(): PlayerDataConfig =
  PlayerDataConfig(
    savePlayerData: true,
    savePlayerCronInterval: 300'u64,
  )

proc toToml*(c: PlayerDataConfig): TomlValue =
  result = newTomlTable()
  result.put("save_player_data", tomlBool(c.savePlayerData))
  result.put("save_player_cron_interval", tomlU64(c.savePlayerCronInterval))

proc fromToml*(t: typedesc[PlayerDataConfig], v: TomlValue, d: var TomlDe): PlayerDataConfig =
  result = defaultPlayerDataConfig()
  if not d.expectTable(v, "PlayerDataConfig"):
    return
  d.getBool(v, "save_player_data", result.savePlayerData)
  d.getU64(v, "save_player_cron_interval", result.savePlayerCronInterval)
