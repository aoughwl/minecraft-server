## Test for player_data.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import player_data
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultPlayerDataConfig()
assert c.savePlayerData
assert c.savePlayerCronInterval == 300'u64

assert textOf(toToml(c)) == "save_player_data = true\nsave_player_cron_interval = 300\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(PlayerDataConfig, parsed("save_player_cron_interval = 60\n"), d)
  assert not d.failed, d.err
  assert got.savePlayerData
  assert got.savePlayerCronInterval == 60'u64

block roundTrip:
  var d = TomlDe()
  let back = fromToml(PlayerDataConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(PlayerDataConfig, parsed("save_player_cron_interval = -1\n"), d)
  assert d.err == "save_player_cron_interval: invalid value: integer `-1`, expected u64", d.err

echo "player_datatest ok"
