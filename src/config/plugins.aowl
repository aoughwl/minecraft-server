## Port of pumpkin-config/src/plugins.rs (plugins.rs)

import toml

type
  PluginsConfig* = object
    blockedPermissions*: seq[string]

proc defaultPluginsConfig*(): PluginsConfig =
  PluginsConfig(blockedPermissions: @[])

proc toToml*(c: PluginsConfig): TomlValue =
  result = newTomlTable()
  result.put("blocked_permissions", tomlStrArr(c.blockedPermissions))

proc fromToml*(t: typedesc[PluginsConfig], v: TomlValue, d: var TomlDe): PluginsConfig =
  result = defaultPluginsConfig()
  if not d.expectTable(v, "PluginsConfig"):
    return
  d.getStrSeq(v, "blocked_permissions", result.blockedPermissions)
