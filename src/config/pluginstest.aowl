## Test for plugins.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import plugins
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultPluginsConfig()
assert c.blockedPermissions.len == 0

assert textOf(toToml(c)) == "blocked_permissions = []\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(PluginsConfig, parsed("blocked_permissions = [\"a.b\", \"c\"]\n"), d)
  assert not d.failed, d.err
  assert got.blockedPermissions == @["a.b", "c"]

block roundTrip:
  var d = TomlDe()
  let back = fromToml(PluginsConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(PluginsConfig, parsed("blocked_permissions = \"x\"\n"), d)
  assert d.err == "blocked_permissions: invalid type: string \"x\", expected a sequence", d.err

echo "pluginstest ok"
