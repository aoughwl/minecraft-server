## Port of pumpkin-config/src/pvp.rs (pvp.rs)

import toml

type
  PVPConfig* = object
    enabled*: bool
    hurtAnimation*: bool
    protectCreative*: bool
    knockback*: bool
    swing*: bool

proc defaultPVPConfig*(): PVPConfig =
  PVPConfig(
    enabled: true,
    hurtAnimation: true,
    protectCreative: true,
    knockback: true,
    swing: true,
  )

proc toToml*(c: PVPConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("hurt_animation", tomlBool(c.hurtAnimation))
  result.put("protect_creative", tomlBool(c.protectCreative))
  result.put("knockback", tomlBool(c.knockback))
  result.put("swing", tomlBool(c.swing))

proc fromToml*(t: typedesc[PVPConfig], v: TomlValue, d: var TomlDe): PVPConfig =
  result = defaultPVPConfig()
  if not d.expectTable(v, "PVPConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getBool(v, "hurt_animation", result.hurtAnimation)
  d.getBool(v, "protect_creative", result.protectCreative)
  d.getBool(v, "knockback", result.knockback)
  d.getBool(v, "swing", result.swing)
