## Test for pvp.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import pvp
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultPVPConfig()
assert c.enabled
assert c.hurtAnimation
assert c.protectCreative
assert c.knockback
assert c.swing

assert textOf(toToml(c)) == "enabled = true\nhurt_animation = true\nprotect_creative = true\nknockback = true\nswing = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(PVPConfig, parsed("knockback = false\n"), d)
  assert not d.failed, d.err
  assert got.enabled
  assert not got.knockback

block roundTrip:
  var d = TomlDe()
  let back = fromToml(PVPConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

echo "pvptest ok"
