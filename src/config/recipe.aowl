## Port of pumpkin-config/src/recipe.rs (recipe.rs)

import toml

type
  RecipeConfig* = object
    sendRecipes*: bool

proc defaultRecipeConfig*(): RecipeConfig =
  RecipeConfig(
    sendRecipes: true,
  )

proc toToml*(c: RecipeConfig): TomlValue =
  result = newTomlTable()
  result.put("send_recipes", tomlBool(c.sendRecipes))

proc fromToml*(t: typedesc[RecipeConfig], v: TomlValue, d: var TomlDe): RecipeConfig =
  result = defaultRecipeConfig()
  if not d.expectTable(v, "RecipeConfig"):
    return
  d.getBool(v, "send_recipes", result.sendRecipes)
