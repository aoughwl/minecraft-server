## Test for recipe.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import recipe
import toml

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultRecipeConfig()
assert c.sendRecipes

assert textOf(toToml(c)) == "send_recipes = true\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(RecipeConfig, parsed("send_recipes = false\n"), d)
  assert not d.failed, d.err
  assert not got.sendRecipes

block roundTrip:
  var d = TomlDe()
  let back = fromToml(RecipeConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

echo "recipetest ok"
