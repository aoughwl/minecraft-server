## Port of pumpkin-config/src/resource_pack.rs (resource_pack.rs)

import ../util/uuid
import toml

export Uuid

type
  JavaResourcePackConfig* = object
    enabled*: bool
    url*: string
    sha1*: string
    promptMessage*: string
    force*: bool

  BedrockPack* = object
    uuid*: Uuid
    version*: string
    size*: uint64
    downloadUrl*: string
    contentKey*: string
    subPackName*: string
    contentId*: string
    hasScripts*: bool
    addonPack*: bool
    rtxEnabled*: bool

  BedrockResourcePackConfig* = object
    enabled*: bool
    force*: bool
    packs*: seq[BedrockPack]

  ResourcePackConfig* = object
    java*: JavaResourcePackConfig
    bedrock*: BedrockResourcePackConfig

proc defaultJavaResourcePackConfig*(): JavaResourcePackConfig =
  JavaResourcePackConfig(enabled: false, url: "", sha1: "", promptMessage: "", force: false)

proc defaultBedrockResourcePackConfig*(): BedrockResourcePackConfig =
  BedrockResourcePackConfig(enabled: false, force: false, packs: @[])

proc defaultResourcePackConfig*(): ResourcePackConfig =
  ResourcePackConfig(
    java: defaultJavaResourcePackConfig(),
    bedrock: defaultBedrockResourcePackConfig(),
  )

proc toToml*(c: JavaResourcePackConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("url", tomlStr(c.url))
  result.put("sha1", tomlStr(c.sha1))
  result.put("prompt_message", tomlStr(c.promptMessage))
  result.put("force", tomlBool(c.force))

proc toToml*(c: BedrockPack): TomlValue =
  result = newTomlTable()
  result.put("uuid", tomlStr($c.uuid))
  result.put("version", tomlStr(c.version))
  result.put("size", tomlU64(c.size))
  result.put("download_url", tomlStr(c.downloadUrl))
  result.put("content_key", tomlStr(c.contentKey))
  result.put("sub_pack_name", tomlStr(c.subPackName))
  result.put("content_id", tomlStr(c.contentId))
  result.put("has_scripts", tomlBool(c.hasScripts))
  result.put("addon_pack", tomlBool(c.addonPack))
  result.put("rtx_enabled", tomlBool(c.rtxEnabled))

proc toToml*(c: BedrockResourcePackConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("force", tomlBool(c.force))
  var packs: seq[TomlValue] = @[]
  for pack in c.packs:
    packs.add(toToml(pack))
  result.put("packs", tomlArr(packs))

proc toToml*(c: ResourcePackConfig): TomlValue =
  result = newTomlTable()
  result.put("java", toToml(c.java))
  result.put("bedrock", toToml(c.bedrock))

proc fromToml*(t: typedesc[JavaResourcePackConfig], v: TomlValue, d: var TomlDe): JavaResourcePackConfig =
  result = defaultJavaResourcePackConfig()
  if not d.expectTable(v, "JavaResourcePackConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getStr(v, "url", result.url)
  d.getStr(v, "sha1", result.sha1)
  d.getStr(v, "prompt_message", result.promptMessage)
  d.getBool(v, "force", result.force)

proc fromToml*(t: typedesc[BedrockPack], v: TomlValue, d: var TomlDe): BedrockPack =
  ## The first four fields have no `#[serde(default)]`, the rest do.
  result = BedrockPack()
  if not d.expectTable(v, "BedrockPack"):
    return
  var sub = TomlValue()
  if d.requireKey(v, "uuid") and d.enter(v, "uuid", sub):
    if sub.kind != tkString:
      d.fail("invalid type: " & unexpected(sub) & ", expected UUID")
    else:
      let (ok, id) = parseStr(sub.strVal)
      if ok:
        result.uuid = id
      else:
        d.fail("UUID parsing failed: " & sub.strVal)
    d.leave()
  if d.requireKey(v, "version"):
    d.getStr(v, "version", result.version)
  if d.requireKey(v, "size"):
    d.getU64(v, "size", result.size)
  if d.requireKey(v, "download_url"):
    d.getStr(v, "download_url", result.downloadUrl)
  d.getStr(v, "content_key", result.contentKey)
  d.getStr(v, "sub_pack_name", result.subPackName)
  d.getStr(v, "content_id", result.contentId)
  d.getBool(v, "has_scripts", result.hasScripts)
  d.getBool(v, "addon_pack", result.addonPack)
  d.getBool(v, "rtx_enabled", result.rtxEnabled)

proc fromToml*(t: typedesc[BedrockResourcePackConfig], v: TomlValue, d: var TomlDe): BedrockResourcePackConfig =
  result = defaultBedrockResourcePackConfig()
  if not d.expectTable(v, "BedrockResourcePackConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getBool(v, "force", result.force)
  var sub = TomlValue()
  if d.enter(v, "packs", sub):
    if sub.kind != tkArray:
      d.fail("invalid type: " & unexpected(sub) & ", expected a sequence")
    else:
      for item in sub.arr:
        result.packs.add(fromToml(BedrockPack, item, d))
    d.leave()

proc fromToml*(t: typedesc[ResourcePackConfig], v: TomlValue, d: var TomlDe): ResourcePackConfig =
  result = defaultResourcePackConfig()
  if not d.expectTable(v, "ResourcePackConfig"):
    return
  var sub = TomlValue()
  if d.enter(v, "java", sub):
    result.java = fromToml(JavaResourcePackConfig, sub, d)
    d.leave()
  if d.enter(v, "bedrock", sub):
    result.bedrock = fromToml(BedrockResourcePackConfig, sub, d)
    d.leave()
