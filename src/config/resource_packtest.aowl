## Test for resource_pack.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import resource_pack
import toml
import ../util/uuid

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultResourcePackConfig()
assert not c.java.enabled
assert c.java.url == ""
assert not c.bedrock.enabled
assert c.bedrock.packs.len == 0

assert textOf(toToml(c)) == "[java]\nenabled = false\nurl = \"\"\nsha1 = \"\"\nprompt_message = \"\"\nforce = false\n\n[bedrock]\nenabled = false\nforce = false\npacks = []\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(ResourcePackConfig, parsed("[java]\nurl = \"http://x\"\n[[bedrock.packs]]\nuuid = \"12345678-1234-1234-1234-123456789abc\"\nversion = \"1.0\"\nsize = 5\ndownload_url = \"u\"\nhas_scripts = true\n"), d)
  assert not d.failed, d.err
  assert got.java.url == "http://x"
  assert got.bedrock.packs.len == 1
  assert $got.bedrock.packs[0].uuid == "12345678-1234-1234-1234-123456789abc"
  assert got.bedrock.packs[0].version == "1.0"
  assert got.bedrock.packs[0].size == 5'u64
  assert got.bedrock.packs[0].hasScripts
  assert not got.bedrock.packs[0].rtxEnabled
  assert got.bedrock.packs[0].contentKey == ""

block roundTrip:
  var d = TomlDe()
  let back = fromToml(ResourcePackConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(ResourcePackConfig, parsed("[[bedrock.packs]]\nuuid = \"12345678-1234-1234-1234-123456789abc\"\nversion = \"1\"\nsize = 1\n"), d)
  assert d.err == "bedrock.packs: missing field `download_url`", d.err

block packText:
  var cfg = defaultBedrockResourcePackConfig()
  var d = TomlDe()
  cfg = fromToml(BedrockResourcePackConfig, parsed("enabled = true\n[[packs]]\nuuid = \"12345678-1234-1234-1234-123456789abc\"\nversion = \"1.0\"\nsize = 5\ndownload_url = \"u\"\n"), d)
  assert not d.failed, d.err
  assert textOf(toToml(cfg)) == "enabled = true\nforce = false\n\n[[packs]]\nuuid = \"12345678-1234-1234-1234-123456789abc\"\nversion = \"1.0\"\nsize = 5\ndownload_url = \"u\"\ncontent_key = \"\"\nsub_pack_name = \"\"\ncontent_id = \"\"\nhas_scripts = false\naddon_pack = false\nrtx_enabled = false\n", textOf(toToml(cfg))

echo "resource_packtest ok"
