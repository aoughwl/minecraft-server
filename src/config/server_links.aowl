## Port of pumpkin-config/src/server_links.rs (server_links.rs)
##
## `custom` is a `HashMap` upstream, so the order it writes in is arbitrary there. Here it writes sorted by key,
## which keeps the file stable between saves.

import std/tables
import toml

type
  ServerLinksConfig* = object
    enabled*: bool
    bugReport*: string
    support*: string
    status*: string
    feedback*: string
    community*: string
    website*: string
    forums*: string
    news*: string
    announcements*: string
    custom*: Table[string, string]

proc defaultServerLinksConfig*(): ServerLinksConfig =
  ServerLinksConfig(
    enabled: true,
    bugReport: "https://github.com/Pumpkin-MC/Pumpkin/issues",
    support: "",
    status: "",
    feedback: "",
    community: "",
    website: "",
    forums: "",
    news: "",
    announcements: "",
    custom: initTable[string, string](),
  )

proc toToml*(c: ServerLinksConfig): TomlValue =
  result = newTomlTable()
  result.put("enabled", tomlBool(c.enabled))
  result.put("bug_report", tomlStr(c.bugReport))
  result.put("support", tomlStr(c.support))
  result.put("status", tomlStr(c.status))
  result.put("feedback", tomlStr(c.feedback))
  result.put("community", tomlStr(c.community))
  result.put("website", tomlStr(c.website))
  result.put("forums", tomlStr(c.forums))
  result.put("news", tomlStr(c.news))
  result.put("announcements", tomlStr(c.announcements))
  var names: seq[string] = @[]
  for k in c.custom.keys:
    # Insertion sort by key.
    names.add(k)
    var at = names.len - 1
    while at > 0 and names[at - 1] > k:
      let moved = names[at - 1]
      names[at] = moved
      dec at
    names[at] = k
  var custom = newTomlTable()
  for k in names:
    custom.put(k, tomlStr(c.custom.getOrDefault(k)))
  result.put("custom", custom)

proc fromToml*(t: typedesc[ServerLinksConfig], v: TomlValue, d: var TomlDe): ServerLinksConfig =
  result = defaultServerLinksConfig()
  if not d.expectTable(v, "ServerLinksConfig"):
    return
  d.getBool(v, "enabled", result.enabled)
  d.getStr(v, "bug_report", result.bugReport)
  d.getStr(v, "support", result.support)
  d.getStr(v, "status", result.status)
  d.getStr(v, "feedback", result.feedback)
  d.getStr(v, "community", result.community)
  d.getStr(v, "website", result.website)
  d.getStr(v, "forums", result.forums)
  d.getStr(v, "news", result.news)
  d.getStr(v, "announcements", result.announcements)
  var sub = TomlValue()
  if d.enter(v, "custom", sub):
    if not d.expectTable(sub, "a map"):
      discard
    else:
      var i = 0
      while i < sub.keys.len:
        if sub.vals[i].kind == tkString:
          result.custom[sub.keys[i]] = sub.vals[i].strVal
        else:
          d.fail("invalid type: " & unexpected(sub.vals[i]) & ", expected a string")
        inc i
    d.leave()
