## Test for server_links.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import server_links
import toml
import std/tables

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultServerLinksConfig()
assert c.enabled
assert c.bugReport == "https://github.com/Pumpkin-MC/Pumpkin/issues"
assert c.support == ""
assert c.custom.len == 0

assert textOf(toToml(c)) == "enabled = true\nbug_report = \"https://github.com/Pumpkin-MC/Pumpkin/issues\"\nsupport = \"\"\nstatus = \"\"\nfeedback = \"\"\ncommunity = \"\"\nwebsite = \"\"\nforums = \"\"\nnews = \"\"\nannouncements = \"\"\n\n[custom]\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(ServerLinksConfig, parsed("website = \"w\"\n[custom]\n\"My Site\" = \"a\"\nblog = \"b\"\n"), d)
  assert not d.failed, d.err
  assert got.website == "w"
  assert got.custom.len == 2
  assert got.custom.getOrDefault("blog") == "b"
  assert got.custom.getOrDefault("My Site") == "a"

block roundTrip:
  var d = TomlDe()
  let back = fromToml(ServerLinksConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(ServerLinksConfig, parsed("[custom]\nblog = 1\n"), d)
  assert d.err == "custom: invalid type: integer `1`, expected a string", d.err

block customOrder:
  var d = TomlDe()
  let got = fromToml(ServerLinksConfig, parsed("[custom]\nzed = \"z\"\n\"My Site\" = \"a\"\nblog = \"b\"\n"), d)
  let text = textOf(toToml(got))
  let tail = "\"My Site\" = \"a\"\nblog = \"b\"\nzed = \"z\"\n"
  assert text.len >= tail.len and text[text.len - tail.len .. text.len - 1] == tail, text

echo "server_linkstest ok"
