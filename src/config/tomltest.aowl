## Test for toml.aowl: known answers for the reader, the exact text of the writer, and the merge.

import std/[assertions, syncio]
import toml

proc mustParse(text: string): TomlValue =
  let r = parseToml(text)
  if not r.ok:
    echo "parse failed: " & r.err
  assert r.ok, text
  r.value

proc mustFail(text: string) =
  let r = parseToml(text)
  assert not r.ok, "should not parse: " & text

proc at(t: TomlValue; key: string): TomlValue =
  let i = findKey(t, key)
  assert i >= 0, key
  t.vals[i]

proc written(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

block scalars:
  let t = mustParse("""
# a comment
s = "a\tb\u00e9\x41\e" # trailing
lit = 'C:\temp'
n = 42
neg = -17
under = 1_000
hex = 0xDEAD_beef
oct = 0o755
bin = 0b101
f = 3.5
e = 1e3
fe = -2.5E-1
t = true
no = false
big = 9223372036854775807
low = -9223372036854775808
inf1 = inf
ninf = -inf
d = 1979-05-27T07:32:00Z
d2 = 1979-05-27 07:32:00.5-07:00
d3 = 1979-05-27
tm = 07:32:00
"quoted key" = 1
'lit key' = 2
""")
  assert at(t, "s").strVal == "a\tb\xC3\xA9A\x1B"
  assert at(t, "lit").strVal == "C:\\temp"
  assert at(t, "n").intVal == 42
  assert at(t, "neg").intVal == -17
  assert at(t, "under").intVal == 1000
  assert at(t, "hex").intVal == 0xDEADBEEF'i64
  assert at(t, "oct").intVal == 493
  assert at(t, "bin").intVal == 5
  assert at(t, "f").floatVal == 3.5
  assert at(t, "e").floatVal == 1000.0
  assert at(t, "fe").floatVal == -0.25
  assert at(t, "t").boolVal
  assert not at(t, "no").boolVal
  assert at(t, "big").intVal == high(int64)
  assert at(t, "low").intVal == low(int64)
  assert at(t, "inf1").floatVal == Inf
  assert at(t, "ninf").floatVal == -Inf
  assert at(t, "d").kind == tkDatetime
  assert at(t, "d").strVal == "1979-05-27T07:32:00Z"
  assert at(t, "d2").strVal == "1979-05-27 07:32:00.5-07:00"
  assert at(t, "d3").strVal == "1979-05-27"
  assert at(t, "tm").strVal == "07:32:00"
  assert at(t, "quoted key").intVal == 1
  assert at(t, "lit key").intVal == 2

block multilineStrings:
  let t = mustParse("a = \"\"\"\nline1\r\nline2\\\n    joined\"\"\"\nb = '''\nraw\\n\n'''\nc = \"\"\"x\"\"\"\"\"\nd = ''''y'''\n")
  assert at(t, "a").strVal == "line1\nline2joined"
  assert at(t, "b").strVal == "raw\\n\n"
  assert at(t, "c").strVal == "x\"\""
  assert at(t, "d").strVal == "'y"

block tablesAndDots:
  let t = mustParse("""
top = 1
a.b.c = 2
a.b.d = "x"

[server]
port = 80
tls.enabled = true

[server.limits]
max = 5

[deep.er.table]
k = [1, 2,
  3, # comment
]
nest = [[1], ["x"], {a = 1}]
inl = { x = 1, y.z = "two", }
""")
  assert at(t, "top").intVal == 1
  assert at(at(at(t, "a"), "b"), "c").intVal == 2
  assert at(at(at(t, "a"), "b"), "d").strVal == "x"
  let server = at(t, "server")
  assert at(server, "port").intVal == 80
  assert at(at(server, "tls"), "enabled").boolVal
  assert at(at(server, "limits"), "max").intVal == 5
  let dt = at(at(at(t, "deep"), "er"), "table")
  assert at(dt, "k").arr.len == 3
  assert at(dt, "k").arr[2].intVal == 3
  assert at(dt, "nest").arr.len == 3
  assert at(at(dt, "inl"), "x").intVal == 1
  assert at(at(at(dt, "inl"), "y"), "z").strVal == "two"

block arrayOfTables:
  let t = mustParse("""
[[fruit]]
name = "apple"
[fruit.physical]
color = "red"
[[fruit.variety]]
name = "red delicious"
[[fruit.variety]]
name = "granny"
[[fruit]]
name = "banana"
""")
  let f = at(t, "fruit")
  assert f.arr.len == 2
  assert at(f.arr[0], "name").strVal == "apple"
  assert at(at(f.arr[0], "physical"), "color").strVal == "red"
  assert at(f.arr[0], "variety").arr.len == 2
  assert at(at(f.arr[0], "variety").arr[1], "name").strVal == "granny"
  assert at(f.arr[1], "name").strVal == "banana"

block implicitThenHeader:
  # A parent made implicit by a deeper header may still get its own, once.
  let t = mustParse("[a.b]\nx = 1\n[a]\ny = 2\n")
  assert at(at(at(t, "a"), "b"), "x").intVal == 1
  assert at(at(t, "a"), "y").intVal == 2
  # Sub-tables of a dotted table are fine under a later header.
  discard mustParse("[f]\napple.color = 1\n[f.apple.texture]\nsmooth = true\n")
  discard mustParse("")
  discard mustParse("\xEF\xBB\xBFa = 1\r\n")

block rejected:
  mustFail("a = 1\na = 2\n")
  mustFail("[a]\n[a]\n")
  mustFail("a = 1\n[a]\n")
  mustFail("a = {x = 1}\n[a.b]\n")
  mustFail("a = {x = 1}\na.y = 2\n")
  mustFail("[[a]]\n[a]\n")
  mustFail("a = []\n[[a]]\n")
  mustFail("a.b = 1\n[a.b]\n")
  mustFail("[a.b.c]\nz = 9\n[a]\nb.c.t = 1\n")
  mustFail("[a]\nb = 1\n[a.b]\n")
  mustFail("a = \n")
  mustFail("a = 1 b = 2\n")
  mustFail("= 1\n")
  mustFail("a = \"x\n")
  mustFail("a = \"\\q\"\n")
  mustFail("a = 01\n")
  mustFail("a = 1__0\n")
  mustFail("a = _1\n")
  mustFail("a = 1_\n")
  mustFail("a = .5\n")
  mustFail("a = 5.\n")
  mustFail("a = 1e\n")
  mustFail("a = 9223372036854775808\n")
  mustFail("a = 0x\n")
  mustFail("a = 0o9\n")
  mustFail("a = [1, 2\n")
  mustFail("a = {x = 1\n")
  mustFail("[a\n")
  mustFail("[[a]\n")
  mustFail("a = 2020-13-01\n")
  mustFail("a = tru\n")
  mustFail("a = \"\xFF\"\n")
  mustFail("a = \"\\uD800\"\n")

block parseErrorLocation:
  let r = parseToml("a = 1\nb = \n")
  assert not r.ok
  assert r.err == "TOML parse error at line 2, column 5: expected a value", r.err

block writerOrder:
  # Plain values stay in field order even with a child table between them.
  var t = newTomlTable()
  t.put("first", tomlInt(1))
  var inner = newTomlTable()
  inner.put("x", tomlBool(true))
  var emptyT = newTomlTable()
  inner.put("empty", emptyT)
  t.put("child", inner)
  t.put("second", tomlStr("two"))
  var onlyKids = newTomlTable()
  var leaf = newTomlTable()
  leaf.put("v", tomlF64(1.5))
  onlyKids.put("leaf", leaf)
  t.put("only_kids", onlyKids)
  assert written(t) ==
    "first = 1\nsecond = \"two\"\n\n[child]\nx = true\n\n[child.empty]\n\n[only_kids.leaf]\nv = 1.5\n", written(t)

block writerValues:
  var t = newTomlTable()
  t.put("whole", tomlF64(20.0))
  t.put("f32", tomlF32(0.1'f32))
  t.put("zero", tomlF64(0.0))
  t.put("big", tomlF64(1e20))
  t.put("arr", tomlStrArr(@["http", "https"]))
  t.put("empty", tomlStrArr(@[]))
  t.put("nested", tomlArr(@[tomlInt(1), tomlStr("a")]))
  var inl = newTomlTable()
  inl.put("k", tomlInt(1))
  inl.put("j", tomlBool(false))
  t.put("mixed", tomlArr(@[inl, tomlInt(2)]))
  t.put("dotted.key", tomlInt(1))
  t.put("", tomlInt(2))
  assert written(t) ==
    "whole = 20.0\nf32 = 0.1\nzero = 0.0\nbig = 100000000000000000000.0\n" &
    "arr = [\"http\", \"https\"]\nempty = []\nnested = [1, \"a\"]\n" &
    "mixed = [{ k = 1, j = false }, 2]\n\"dotted.key\" = 1\n\"\" = 2\n", written(t)

block writerArrayOfTables:
  var t = newTomlTable()
  var a = newTomlTable()
  a.put("name", tomlStr("one"))
  var sub = newTomlTable()
  sub.put("z", tomlInt(1))
  a.put("sub", sub)
  var b = newTomlTable()
  var parent = newTomlTable()
  parent.put("items", tomlArr(@[a, b]))
  t.put("p", parent)
  assert written(t) == "[[p.items]]\nname = \"one\"\n\n[p.items.sub]\nz = 1\n\n[[p.items]]\n", written(t)

block writerStrings:
  assert tomlStringRepr("plain") == "\"plain\""
  assert tomlStringRepr("<{DISPLAYNAME}> {MESSAGE}") == "\"<{DISPLAYNAME}> {MESSAGE}\""
  assert tomlStringRepr("C:\\x") == "'C:\\x'"
  assert tomlStringRepr("say \"hi\"") == "'say \"hi\"'"
  assert tomlStringRepr("it's \"x\"") == "\"it's \\\"x\\\"\""
  assert tomlStringRepr("a\nb") == "\"\"\"\na\nb\"\"\""
  assert tomlStringRepr("a\x01b") == "\"a\\u0001b\""
  assert tomlStringRepr("tab\there") == "\"tab\there\""
  assert tomlKeyRepr("bare-key_1") == "bare-key_1"
  assert tomlKeyRepr("has space") == "\"has space\""

block writeReadBack:
  # What the writer emits, the reader returns unchanged.
  for s in ["plain", "C:\\x", "say \"hi\"", "it's \"x\"", "a\nb\n", "a\x01b", "x\"", "\"\"\"", "'''", "a\\\nb", ""]:
    var t = newTomlTable()
    t.put("k", tomlStr(s))
    let text = written(t)
    assert at(mustParse(text), "k").strVal == s, text

block u64OutOfRange:
  var t = newTomlTable()
  t.put("ok", tomlU64(9223372036854775807'u64))
  assert written(t) == "ok = 9223372036854775807\n"
  t.put("bad", tomlU64(9223372036854775808'u64))
  let r = writeToml(t)
  assert not r.ok

block merge:
  let base = mustParse("a = 1\nb = 2\n[t]\nx = 1\ny = 2\n[u]\nz = 3\n")
  let full = mergeTomlValues(base, mustParse("a = 9\nb = 2\n[t]\nx = 7\ny = 2\n[u]\nz = 3\nextra = 1\n"))
  assert not full.changed
  assert at(full.value, "a").intVal == 9
  assert at(at(full.value, "t"), "x").intVal == 7
  assert at(at(full.value, "u"), "extra").intVal == 1
  let part = mergeTomlValues(base, mustParse("a = 9\n[t]\nx = 7\n"))
  assert part.changed
  assert at(part.value, "a").intVal == 9
  assert at(part.value, "b").intVal == 2
  assert at(at(part.value, "t"), "x").intVal == 7
  assert at(at(part.value, "t"), "y").intVal == 2
  assert at(at(part.value, "u"), "z").intVal == 3
  # Missing only in a nested table still counts.
  let nested = mergeTomlValues(base, mustParse("a = 1\nb = 2\n[t]\nx = 1\n[u]\nz = 3\n"))
  assert nested.changed
  # A non-table overlay replaces a table, and that is not a change.
  let swapped = mergeTomlValues(base, mustParse("a = 1\nb = 2\nt = 5\n[u]\nz = 3\n"))
  assert not swapped.changed
  assert at(swapped.value, "t").intVal == 5

block deserialize:
  let t = mustParse("flag = true\nname = \"n\"\nsmall = 300\nnz = 0\nf = 20\ng = 2.5\nlist = [\"a\", \"b\"]\nbadlist = [1]\nkind = \"Two\"\n")
  var d = TomlDe()
  var b = false
  d.getBool(t, "flag", b)
  assert b
  var s = "keep"
  d.getStr(t, "name", s)
  assert s == "n"
  d.getStr(t, "absent", s)
  assert s == "n"
  var f = 0.0'f32
  d.getF32(t, "f", f)
  assert f == 20.0'f32
  d.getF32(t, "g", f)
  assert f == 2.5'f32
  var l: seq[string] = @[]
  d.getStrSeq(t, "list", l)
  assert l == @["a", "b"]
  assert not d.failed

  var e1 = TomlDe()
  var u8v = 0'u8
  e1.getU8(t, "small", u8v)
  assert e1.err == "small: invalid value: integer `300`, expected u8", e1.err

  var e2 = TomlDe()
  e2.getNonZeroU8(t, "nz", u8v)
  assert e2.err == "nz: invalid value: integer `0`, expected a nonzero u8", e2.err

  var e3 = TomlDe()
  var bb = false
  e3.getBool(t, "name", bb)
  assert e3.err == "name: invalid type: string \"n\", expected a boolean", e3.err

  var e4 = TomlDe()
  var ll: seq[string] = @[]
  e4.getStrSeq(t, "badlist", ll)
  assert e4.err == "badlist: invalid type: integer `1`, expected a string", e4.err

  var e5 = TomlDe()
  var sub = TomlValue()
  assert e5.enter(t, "kind", sub)
  assert readVariant(e5, sub, ["One", "Two"]) == 1
  let badName = tomlStr("Three")
  assert readVariant(e5, badName, ["One", "Two", "Four"]) == -1
  assert e5.err == "kind: unknown variant `Three`, expected one of `One`, `Two`, `Four`", e5.err
  e5.leave()

  var e6 = TomlDe()
  assert not e6.requireKey(t, "gone")
  assert e6.err == "missing field `gone`"

echo "tomltest ok"
