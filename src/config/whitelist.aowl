## Port of pumpkin-config/src/whitelist.rs (whitelist.rs) and of pumpkin/src/data/whitelist.rs
##
## `whitelist.json`, the `WhitelistConfig` file: a JSON array of entries, `#[serde(transparent)]`. Upstream's
## `is_whitelisted` takes a `GameProfile` and looks at its id; this takes the id, so the config does not depend
## on the network module.

import std/json
import ../util/uuid
import data_json

export Uuid

const WhitelistFileName* = "whitelist.json"

type
  WhitelistEntry* = object
    uuid*: Uuid
    name*: string

  WhitelistConfig* = object
    whitelist*: seq[WhitelistEntry]

  WhitelistConfigResult* = object
    ok*: bool
    value*: WhitelistConfig
    err*: string
    warning*: string

proc newWhitelistEntry*(uuid: Uuid; name: string): WhitelistEntry =
  WhitelistEntry(uuid: uuid, name: name)

proc `==`*(a, b: WhitelistEntry): bool =
  a.uuid == b.uuid and a.name == b.name

proc isWhitelisted*(c: WhitelistConfig; id: Uuid): bool =
  for entry in c.whitelist:
    if entry.uuid == id:
      return true
  false

proc whitelistToJson*(c: WhitelistConfig): string =
  ## `serde_json::to_string_pretty`.
  result = ""
  var first = true
  for entry in c.whitelist:
    if not first:
      prettyObjectClose(result)
    prettyArrayOpen(result, first)
    first = false
    prettyField(result, "uuid", prettyStr($entry.uuid), false)
    prettyField(result, "name", prettyStr(entry.name), true)
  prettyArrayClose(result, c.whitelist.len == 0)

proc whitelistFromJson*(text: string): WhitelistConfigResult =
  ## `serde_json::from_str`.
  result = WhitelistConfigResult(ok: false)
  var tree = parseJson(text)
  if tree.hasError:
    result.err = errorMsg(tree)
    return
  let top = root(tree)
  if top.kind != JArray:
    result.err = "invalid type, expected a sequence"
    return
  if hasTrailingContent(text):
    result.err = "trailing characters"
    return
  var entries: seq[WhitelistEntry] = @[]
  for item in top:
    if item.kind != JObject:
      result.err = "invalid type, expected struct WhitelistEntry"
      return
    var entry = WhitelistEntry()
    var hasUuid = false
    var hasName = false
    for (key, value) in item.pairs:
      case key
      of "uuid":
        if value.kind != JString:
          result.err = "invalid type for `uuid`, expected UUID"
          return
        let (ok, id) = parseStr(value.getStr)
        if not ok:
          result.err = "UUID parsing failed: " & value.getStr
          return
        entry.uuid = id
        hasUuid = true
      of "name":
        if value.kind != JString:
          result.err = "invalid type for `name`, expected a string"
          return
        entry.name = value.getStr
        hasName = true
      else:
        discard
    if not hasUuid:
      result.err = "missing field `uuid`"
      return
    if not hasName:
      result.err = "missing field `name`"
      return
    entries.add(entry)
  result.ok = true
  result.value = WhitelistConfig(whitelist: entries)

proc loadWhitelistConfig*(dataDir: string): WhitelistConfigResult =
  ## `LoadJSONConfiguration::load`: reads `whitelist.json`, or writes an empty one when absent.
  let file = readOrCreateDataFile(dataDir, WhitelistFileName, whitelistToJson(WhitelistConfig()))
  if not file.ok:
    return WhitelistConfigResult(ok: false, err: file.err)
  result = whitelistFromJson(file.text)
  if not result.ok:
    result.err = parseFailure(dataDir & WhitelistFileName, result.err)
  result.warning = file.warning

proc saveWhitelistConfig*(c: WhitelistConfig; dataDir: string): JsonFileWrite =
  ## `SaveJSONConfiguration::save`
  writeDataFile(dataDir, WhitelistFileName, whitelistToJson(c))
