## Test for whitelist.aowl: the exact whitelist.json text, its load and save, and refusals.

import std/[assertions, syncio, os, envvars]
from std/paths import path, Path
from std/dirs import tryCreateFinalDir, tryRemoveFile
import ../util/uuid
import whitelist

proc scratchDir(name: string): string =
  ## Under CONFIGTEST_DIR, or beside the test executable.
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  result = base & "/" & name
  if not dirExists(result):
    discard tryCreateFinalDir(path(result))
  assert dirExists(result), result

proc readText(p: string): string =
  result = ""
  try:
    result = readFile(p)
  except ErrorCode:
    assert false, "cannot read " & p

proc writeText(p, text: string) =
  try:
    writeFile(p, text)
  except ErrorCode:
    assert false, "cannot write " & p

let a = parseStr("12345678-1234-1234-1234-123456789abc")[1]
let b = parseStr("00000000-0000-0000-0000-000000000001")[1]

block text:
  assert whitelistToJson(WhitelistConfig()) == "[]"
  let cfg = WhitelistConfig(whitelist: @[newWhitelistEntry(a, "Alice"), newWhitelistEntry(b, "Bob")])
  let expected = "[\n  {\n    \"uuid\": \"12345678-1234-1234-1234-123456789abc\",\n    \"name\": \"Alice\"\n  },\n  {\n    \"uuid\": \"00000000-0000-0000-0000-000000000001\",\n    \"name\": \"Bob\"\n  }\n]"
  assert whitelistToJson(cfg) == expected, whitelistToJson(cfg)
  let back = whitelistFromJson(expected)
  assert back.ok, back.err
  assert back.value.whitelist.len == 2
  assert back.value.whitelist[0] == newWhitelistEntry(a, "Alice")
  assert back.value.isWhitelisted(b)
  assert not back.value.isWhitelisted(NilUuid)

block fileIo:
  let dir = scratchDir("cfg_whitelist")
  discard tryRemoveFile(path(dir & "/whitelist.json"))
  let made = loadWhitelistConfig(dir)
  assert made.ok, made.err
  assert made.value.whitelist.len == 0
  assert readText(dir & "/whitelist.json") == "[]"
  let saved = saveWhitelistConfig(WhitelistConfig(whitelist: @[newWhitelistEntry(a, "Alice")]), dir)
  assert saved.ok, saved.err
  let loaded = loadWhitelistConfig(dir)
  assert loaded.ok, loaded.err
  assert loaded.value.whitelist.len == 1
  assert loaded.value.whitelist[0].name == "Alice"
  writeText(dir & "/whitelist.json", "[{")
  assert not loadWhitelistConfig(dir).ok
  discard tryRemoveFile(path(dir & "/whitelist.json"))

block refused:
  assert whitelistFromJson("{}").err == "invalid type, expected a sequence"
  assert whitelistFromJson("[{\"name\":\"n\"}]").err == "missing field `uuid`"
  assert whitelistFromJson("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\"}]").err == "missing field `name`"
  assert whitelistFromJson("[{\"uuid\":\"bad\",\"name\":\"n\"}]").err == "UUID parsing failed: bad"
  assert whitelistFromJson("[{\"uuid\":\"12345678-1234-1234-1234-123456789abc\",\"name\":\"n\",\"extra\":1}]").ok

echo "whitelisttest ok"
