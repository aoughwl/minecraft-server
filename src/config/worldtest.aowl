## Test for world.aowl: defaults, the exact TOML text, a partial read and a bad value.

import std/[assertions, syncio]
import world
import toml
import chunk, lighting

proc textOf(v: TomlValue): string =
  let r = writeToml(v)
  assert r.ok, r.err
  r.text

proc parsed(text: string): TomlValue =
  let r = parseToml(text)
  assert r.ok, r.err
  r.value

let c = defaultLevelConfig()
assert c.chunk.kind == cckAnvil
assert c.lighting == lecDefault
assert c.autosaveTicks == 6000'u64

assert textOf(toToml(c)) == "lighting = \"default\"\nautosave_ticks = 6000\n\n[chunk]\ntype = \"anvil\"\nwrite_in_place = false\n\n[chunk.compression]\nalgorithm = \"LZ4\"\nlevel = 6\n", textOf(toToml(c))

block partial:
  var d = TomlDe()
  let got = fromToml(LevelConfig, parsed("lighting = \"dark\"\n[chunk]\ntype = \"pump\"\n"), d)
  assert not d.failed, d.err
  assert got.lighting == lecDark
  assert got.chunk.kind == cckPump
  assert got.autosaveTicks == 6000'u64

block roundTrip:
  var d = TomlDe()
  let back = fromToml(LevelConfig, parsed(textOf(toToml(c))), d)
  assert not d.failed, d.err
  assert textOf(toToml(back)) == textOf(toToml(c))

block bad:
  var d = TomlDe()
  discard fromToml(LevelConfig, parsed("lighting = \"dark\"\n"), d)
  assert d.err == "missing field `chunk`", d.err

echo "worldtest ok"
