## Port of pumpkin-data/src/advancement_data.rs (advancement_data.rs)
##
## Upstream's `AdvancementDisplay`, `FrameType`, `AdvancementReward`, `AdvancementNode` and `AdvancementTree`
## live here while `Advancement` and `ADVANCEMENT_TREE` are generated, and each names the other. Imports may
## not cycle in aowlmony, so src/generated/advancement.aowl declares those types (see gen_advancement.aowl) and
## this module is their methods. `Advancement::option_name` and `name`, generated upstream, are here too: they
## call `get_title` and `get_color`.
##
## `item_icon` is the bare item name in the generated table; `itemIconStack` is upstream's
## `ItemStack::static_new_java(1, &Item::X)`. `Arc<str>` is a `string`. The serde derives are `toJson`/`fromJson`.

import std/[hashes, options, tables]
import ../generated/advancement
import ../generated/translation
import ../codecs/json_value
import ../util/text/text
import ../util/text/color
import ../util/text/textbase
import item_stack/"mod"

export advancement

type
  AdvancementProgressData* = object
    id*: Identifier
    progress*: seq[Criteria]

  Criteria* = object
    criterionId*: string
    achieveDate*: Option[int64]

  AdvancementRequirement* = object
    ## Represents the requirements needed to complete an advancement.
    ## To mark as done, at least one criterion from each requirement group must be satisfied.
    requirements*: seq[seq[string]]

  Criterion* = object
    ## `pub trait Criterion {}`: upstream declares it empty and nothing implements it.

proc getTitle*(self: AdvancementDisplay): TextComponent =
  translate(self.title)

proc getDescription*(self: AdvancementDisplay): TextComponent =
  translate(self.description)

proc hasBackground*(self: AdvancementDisplay): bool =
  self.backgroundTexture.isSome

proc newAdvancementDisplay*(title, description, itemIcon: string; frameType: FrameType;
    backgroundTexture: Option[string]; showToast, hidden, announceToChat: bool; x, y: float32): AdvancementDisplay =
  AdvancementDisplay(title: title, description: description, itemIcon: itemIcon, frameType: frameType,
    backgroundTexture: backgroundTexture, showToast: showToast, hidden: hidden, announceToChat: announceToChat,
    x: x, y: y)

proc itemIconStack*(self: AdvancementDisplay): ItemStack =
  ## The `item_icon` field upstream holds. An icon the item table lacks is an empty stack: the advancement
  ## and item assets are one dump, and advancementtest covers the names.
  let item = fromRegistryKey(Item, self.itemIcon)
  if item == nil:
    return emptyItemStack()
  staticNewJava(1'u8, item)

proc getColor*(self: FrameType): NamedColor =
  case self
  of FrameType.Task: ncGreen
  of FrameType.Challenge: ncDarkPurple
  of FrameType.Goal: ncGreen

proc getTranslation*(self: FrameType): string =
  case self
  of FrameType.Task: JAVA_CHAT_TYPE_ADVANCEMENT_TASK
  of FrameType.Challenge: JAVA_CHAT_TYPE_ADVANCEMENT_CHALLENGE
  of FrameType.Goal: JAVA_CHAT_TYPE_ADVANCEMENT_GOAL

proc toJson*(self: FrameType): JsonValue =
  ## `#[serde(rename_all = "lowercase")]`.
  case self
  of FrameType.Task: jsonString("task")
  of FrameType.Challenge: jsonString("challenge")
  of FrameType.Goal: jsonString("goal")

proc frameTypeFromJson*(v: JsonValue): (bool, FrameType) =
  if v.kind == jvString:
    case v.strVal
    of "task": return (true, FrameType.Task)
    of "challenge": return (true, FrameType.Challenge)
    of "goal": return (true, FrameType.Goal)
    else: discard
  (false, FrameType.Task)

proc optionName*(self: Advancement): Option[TextComponent] =
  ## `Advancement::option_name`.
  if self.display.isNone:
    return none[TextComponent]()
  let display = self.display.unsafeGet
  var over = display.getTitle()
  let color = display.frameType.getColor()
  over.base.style = default(Style).colorNamed(color)
  over = over.addText("\n").addChild(display.getDescription())
  var text = display.getTitle()
  text.base.style.hoverEvent = some(HoverEvent(kind: heShowText, value: @[over.base]))
  some(text.wrapInSquareBrackets().colorNamed(color))

proc name*(self: Advancement): TextComponent =
  ## `Advancement::name`.
  let named = self.optionName()
  if named.isSome: named.unsafeGet else: text($self.id)

proc addChild*(self: var AdvancementNode; child: int) =
  self.children.add(child)

proc newAdvancementNode*(value: Advancement; parent: Option[int]): AdvancementNode =
  AdvancementNode(value: value, parent: parent, children: @[])

proc hasDisplay*(self: AdvancementNode): bool {.inline.} =
  self.value.display.isSome

proc root*(self: AdvancementNode): AdvancementNode =
  result = self
  while result.parent.isSome:
    result = ADVANCEMENT_TREE.nodesVector[result.parent.unsafeGet]

proc `==`*(a, b: AdvancementNode): bool = a.value == b.value

proc `$`*(self: AdvancementNode): string = $self.value.id

proc hash*(self: AdvancementNode): Hash = hash(self.value)

proc getIdx*(self: AdvancementTree; id: Identifier): Option[int] =
  let i = self.nodes.getOrDefault(id, -1)
  if i >= 0: some(i) else: none[int]()

proc getNodeFromIdx*(self: AdvancementTree; idx: int): Option[AdvancementNode] =
  if idx >= 0 and idx < self.nodesVector.len: some(self.nodesVector[idx]) else: none[AdvancementNode]()

proc getNodeFromId*(self: AdvancementTree; id: Identifier): Option[AdvancementNode] =
  let i = self.getIdx(id)
  if i.isSome: self.getNodeFromIdx(i.unsafeGet) else: none[AdvancementNode]()

proc toJson*(self: Criteria): JsonValue =
  result = jsonObject()
  result.put("criterion_id", jsonString(self.criterionId))
  result.put("achieve_date", (if self.achieveDate.isSome: jsonInt(self.achieveDate.unsafeGet) else: jsonNull()))

proc toJson*(self: AdvancementProgressData): JsonValue =
  result = jsonObject()
  result.put("id", jsonString($self.id))
  var progress: seq[JsonValue] = @[]
  for c in self.progress:
    progress.add(c.toJson())
  result.put("progress", jsonArray(progress))

proc fromConst*(_: typedesc[AdvancementRequirement]; staticRequirements: seq[seq[string]]): AdvancementRequirement =
  AdvancementRequirement(requirements: staticRequirements)

proc anyMatch(requirements: seq[string]; predicate: proc (s: string): bool {.closure.}): bool =
  ## check if any test pass
  var i = 0
  while i < requirements.len:
    if predicate(requirements[i]):
      return true
    inc i
  false

proc test*(self: AdvancementRequirement; predicate: proc (s: string): bool {.closure.}): bool =
  ## test if the requirements is complete
  if self.requirements.len == 0:
    return false
  var i = 0
  while i < self.requirements.len:
    if not anyMatch(self.requirements[i], predicate):
      return false
    inc i
  true

proc names*(self: AdvancementRequirement): seq[string] =
  result = @[]
  for group in self.requirements:
    for name in group:
      result.add(name)

proc toJson*(self: AdvancementRequirement): JsonValue =
  var groups: seq[JsonValue] = @[]
  for group in self.requirements:
    var names: seq[JsonValue] = @[]
    for name in group:
      names.add(jsonString(name))
    groups.add(jsonArray(names))
  result = jsonObject()
  result.put("requirements", jsonArray(groups))

proc requirementFromJson*(v: JsonValue): (bool, AdvancementRequirement) =
  var failed = AdvancementRequirement(requirements: @[])
  if v.kind != jvObject:
    return (false, failed)
  let (found, groups) = v.get("requirements")
  if not found or groups.kind != jvArray:
    return (false, failed)
  var res: seq[seq[string]] = @[]
  for group in groups.items:
    if group.kind != jvArray:
      return (false, failed)
    var names: seq[string] = @[]
    for name in group.items:
      if name.kind != jvString:
        return (false, failed)
      names.add(name.strVal)
    res.add(names)
  (true, AdvancementRequirement(requirements: res))
