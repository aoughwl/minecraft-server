## Tests for advancement_data.aowl. Upstream has no `#[cfg(test)]` in advancement_data.rs; the requirement cases
## follow pumpkin/src/entity/player/advancement.rs's use of it, the rest are read off generated/advancement.rs.

import std/[assertions, options, syncio, tables]
import advancement_data
import ../codecs/json_value
import ../generated/translation
import ../util/text/color
import ../util/text/text
import ../util/text/textbase
import item_stack/"mod"

block frameType:
  assert getColor(FrameType.Task) == ncGreen
  assert getColor(FrameType.Challenge) == ncDarkPurple
  assert getColor(FrameType.Goal) == ncGreen
  assert getTranslation(FrameType.Task) == "chat.type.advancement.task"
  assert getTranslation(FrameType.Challenge) == "chat.type.advancement.challenge"
  assert getTranslation(FrameType.Goal) == "chat.type.advancement.goal"
  assert ord(FrameType.Challenge) == 1
  assert toJson(FrameType.Goal).strVal == "goal"
  assert frameTypeFromJson(jsonString("challenge")) == (true, FrameType.Challenge)
  assert not frameTypeFromJson(jsonString("Task"))[0]

block display:
  let root = Advancement.fromName("adventure/root").get
  let d = root.display.get
  assert d.getTitle() == translate("advancements.adventure.root.title")
  assert d.getDescription() == translate("advancements.adventure.root.description")
  assert d.hasBackground()
  # ItemStack::static_new_java(1, &Item::MAP)
  let icon = d.itemIconStack()
  assert icon.itemCount == 1'u8
  assert icon.item.id == ITEM_MAP.id
  assert icon.uid == 1'i32
  let salvage = Advancement.fromName("adventure/salvage_sherd").get
  assert not salvage.display.get.hasBackground()
  assert salvage.display.get.itemIconStack().item.id == ITEM_BRUSH.id

block everyIconIsAnItem:
  for adv in gAdvancements:
    if adv.display.isSome:
      assert fromRegistryKey(Item, adv.display.get.itemIcon) != nil

block names:
  let root = Advancement.fromName("adventure/root").get
  let named = root.optionName().get
  assert named == root.name()
  # [title], in the frame's colour, whose hover is the title in that colour, a new line and the description.
  assert named.base.content.kind == tcTranslate
  assert named.base.content.translate == "chat.square_brackets"
  assert named.base.style.color.get == colorNamed(ncGreen)
  let inner = named.base.content.translateWith[0]
  assert inner.content.translate == "advancements.adventure.root.title"
  let hover = inner.style.hoverEvent.get
  assert hover.kind == heShowText
  assert hover.value[0].content.translate == "advancements.adventure.root.title"
  assert hover.value[0].style.color.get == colorNamed(ncGreen)
  assert hover.value[0].extra.len == 2
  assert hover.value[0].extra[0].content.text == "\n"
  assert hover.value[0].extra[1].content.translate == "advancements.adventure.root.description"
  # Without a display: None, and `name` falls back to the id.
  var plain: Advancement = root
  for adv in gAdvancements:
    if adv.display.isNone:
      plain = adv
      break
  assert plain.display.isNone
  assert plain.optionName().isNone
  assert plain.name() == text($plain.id)

block tree:
  let id = vanillaStatic("adventure/root")
  let idx = ADVANCEMENT_TREE.getIdx(id).get
  let node = ADVANCEMENT_TREE.getNodeFromId(id).get
  assert node.value.id == id
  assert node.hasDisplay()
  assert $node == "minecraft:adventure/root"
  assert ADVANCEMENT_TREE.getNodeFromIdx(idx).get == node
  assert ADVANCEMENT_TREE.getNodeFromIdx(-1).isNone
  assert ADVANCEMENT_TREE.getNodeFromIdx(ADVANCEMENT_TREE.nodesVector.len).isNone
  assert ADVANCEMENT_TREE.getIdx(vanillaStatic("no/such")).isNone
  assert ADVANCEMENT_TREE.getNodeFromId(vanillaStatic("no/such")).isNone
  # A child reaches the root of its own tab.
  let salvage = ADVANCEMENT_TREE.getNodeFromId(vanillaStatic("adventure/salvage_sherd")).get
  assert salvage.parent.isSome
  assert salvage.root() == node
  assert node.root() == node
  var fresh = newAdvancementNode(node.value, none[int]())
  fresh.addChild(3)
  assert fresh.children == @[3]

block requirements:
  let req = fromConst(AdvancementRequirement, @[@["a", "b"], @["c"]])
  assert req.names() == @["a", "b", "c"]
  # One from each group is enough.
  assert req.test(proc (s: string): bool {.closure.} = s == "b" or s == "c")
  assert not req.test(proc (s: string): bool {.closure.} = s == "a" or s == "b")
  assert not req.test(proc (s: string): bool {.closure.} = s == "c")
  # No requirements at all is not complete.
  assert not AdvancementRequirement(requirements: @[]).test(proc (s: string): bool {.closure.} = true)
  let json = req.toJson()
  assert toJsonString(json) == "{\"requirements\":[[\"a\",\"b\"],[\"c\"]]}"
  let (ok, back) = requirementFromJson(json)
  assert ok and back.requirements == req.requirements
  assert not requirementFromJson(jsonString("x"))[0]

block progressJson:
  # A JsonValue object keeps its keys sorted, as a serde_json::Value does.
  let data = AdvancementProgressData(id: vanillaStatic("story/root"), progress: @[
    Criteria(criterionId: "crafting_table", achieveDate: some(5'i64)),
    Criteria(criterionId: "other", achieveDate: none[int64]())])
  assert toJsonString(data.toJson()) == "{\"id\":\"minecraft:story/root\",\"progress\":[{\"achieve_date\":5,\"criterion_id\":\"crafting_table\"},{\"achieve_date\":null,\"criterion_id\":\"other\"}]}"

echo "advancement_data tests passed"
