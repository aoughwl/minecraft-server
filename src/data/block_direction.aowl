## Port of pumpkin-data/src/block_direction.rs (block_direction.rs).
##
## `random` and `random_horizontal` take a closure drawing the bounded int, so this
## module does not depend on which generator a caller holds.

import "../generated/block_enums"
import "../util/vector3" as mathvec

type
  BlockDirection* {.pure.} = enum
    Down = 0, Up, North, South, West, East

proc fromMathAxis*(a: mathvec.Axis): block_enums.Axis =
  ## `impl From<MathAxis> for Axis`.
  case a
  of axisX: block_enums.Axis.X
  of axisY: block_enums.Axis.Y
  of axisZ: block_enums.Axis.Z

proc toMathAxis*(a: block_enums.Axis): mathvec.Axis =
  ## `impl From<Axis> for MathAxis`.
  case a
  of block_enums.Axis.X: axisX
  of block_enums.Axis.Y: axisY
  of block_enums.Axis.Z: axisZ

proc tryFromI32*(value: int32): (bool, BlockDirection) =
  ## `TryFrom<i32>`; false is `InvalidBlockFace`.
  if value >= 0'i32 and value <= 5'i32:
    (true, BlockDirection(value))
  else:
    (false, BlockDirection.Down)

proc toIndex*(self: BlockDirection): uint8 {.inline.} = uint8(ord(self))

proc fromIndex*(T: typedesc[BlockDirection]; index: uint8): (bool, BlockDirection) =
  if index <= 5'u8:
    (true, BlockDirection(index))
  else:
    (false, BlockDirection.Down)

proc blockDirectionAll*(): array[6, BlockDirection] =
  [BlockDirection.Down, BlockDirection.Up, BlockDirection.North,
   BlockDirection.South, BlockDirection.West, BlockDirection.East]

proc blockDirectionHorizontal*(): array[4, HorizontalFacing] =
  [HorizontalFacing.North, HorizontalFacing.South, HorizontalFacing.West, HorizontalFacing.East]

proc random*(T: typedesc[BlockDirection]; nextBoundedI32: proc(bound: int32): int32 {.closure.}): BlockDirection =
  ## Bound is `len - 1` as upstream writes it, so East is never drawn.
  blockDirectionAll()[int(nextBoundedI32(5'i32))]

proc randomHorizontal*(T: typedesc[BlockDirection]; nextBoundedI32: proc(bound: int32): int32 {.closure.}): HorizontalFacing =
  ## Bound is `len - 1` as upstream writes it, so East is never drawn.
  blockDirectionHorizontal()[int(nextBoundedI32(3'i32))]

proc byIndex*(T: typedesc[BlockDirection]; index: int): BlockDirection =
  blockDirectionAll()[index mod 6]

proc toOffset*(self: BlockDirection): Vector3[int32] =
  case self
  of BlockDirection.Down: vec3(0'i32, -1'i32, 0'i32)
  of BlockDirection.Up: vec3(0'i32, 1'i32, 0'i32)
  of BlockDirection.North: vec3(0'i32, 0'i32, -1'i32)
  of BlockDirection.South: vec3(0'i32, 0'i32, 1'i32)
  of BlockDirection.West: vec3(-1'i32, 0'i32, 0'i32)
  of BlockDirection.East: vec3(1'i32, 0'i32, 0'i32)

proc opposite*(self: BlockDirection): BlockDirection =
  case self
  of BlockDirection.Down: BlockDirection.Up
  of BlockDirection.Up: BlockDirection.Down
  of BlockDirection.North: BlockDirection.South
  of BlockDirection.South: BlockDirection.North
  of BlockDirection.West: BlockDirection.East
  of BlockDirection.East: BlockDirection.West

proc positive*(self: BlockDirection): bool =
  self == BlockDirection.South or self == BlockDirection.East or self == BlockDirection.Up

proc blockDirectionUpdateOrder*(): array[6, BlockDirection] =
  [BlockDirection.West, BlockDirection.East, BlockDirection.Down,
   BlockDirection.Up, BlockDirection.North, BlockDirection.South]

proc blockDirectionAbstractBlockUpdateOrder*(): array[6, BlockDirection] =
  [BlockDirection.West, BlockDirection.East, BlockDirection.North,
   BlockDirection.South, BlockDirection.Down, BlockDirection.Up]

proc blockDirectionFlowDirections*(): array[5, BlockDirection] =
  [BlockDirection.Down, BlockDirection.North, BlockDirection.South,
   BlockDirection.West, BlockDirection.East]

proc isHorizontal*(self: BlockDirection): bool =
  self == BlockDirection.North or self == BlockDirection.South or
    self == BlockDirection.West or self == BlockDirection.East

proc blockDirectionVertical*(): array[2, BlockDirection] =
  [BlockDirection.Down, BlockDirection.Up]

proc toHorizontalFacing*(self: BlockDirection): (bool, HorizontalFacing) =
  case self
  of BlockDirection.North: (true, HorizontalFacing.North)
  of BlockDirection.South: (true, HorizontalFacing.South)
  of BlockDirection.West: (true, HorizontalFacing.West)
  of BlockDirection.East: (true, HorizontalFacing.East)
  else: (false, HorizontalFacing.North)

proc toHorizontalAxis*(self: BlockDirection): (bool, HorizontalAxis) =
  case self
  of BlockDirection.North, BlockDirection.South: (true, HorizontalAxis.Z)
  of BlockDirection.West, BlockDirection.East: (true, HorizontalAxis.X)
  else: (false, HorizontalAxis.X)

proc toCardinalDirection*(self: BlockDirection): HorizontalFacing =
  case self
  of BlockDirection.South: HorizontalFacing.South
  of BlockDirection.West: HorizontalFacing.West
  of BlockDirection.East: HorizontalFacing.East
  else: HorizontalFacing.North

proc fromCardinalDirection*(T: typedesc[BlockDirection]; direction: HorizontalFacing): BlockDirection =
  case direction
  of HorizontalFacing.North: BlockDirection.North
  of HorizontalFacing.South: BlockDirection.South
  of HorizontalFacing.West: BlockDirection.West
  of HorizontalFacing.East: BlockDirection.East

proc toAxis*(self: BlockDirection): block_enums.Axis =
  case self
  of BlockDirection.North, BlockDirection.South: block_enums.Axis.Z
  of BlockDirection.West, BlockDirection.East: block_enums.Axis.X
  of BlockDirection.Up, BlockDirection.Down: block_enums.Axis.Y

proc toFacing*(self: BlockDirection): Facing =
  case self
  of BlockDirection.North: Facing.North
  of BlockDirection.South: Facing.South
  of BlockDirection.West: Facing.West
  of BlockDirection.East: Facing.East
  of BlockDirection.Up: Facing.Up
  of BlockDirection.Down: Facing.Down

proc rotateClockwise*(self: BlockDirection): BlockDirection =
  case self
  of BlockDirection.East: BlockDirection.South
  of BlockDirection.West: BlockDirection.North
  of BlockDirection.Up, BlockDirection.North: BlockDirection.East
  of BlockDirection.Down, BlockDirection.South: BlockDirection.West

proc rotateCounterClockwise*(self: BlockDirection): BlockDirection =
  case self
  of BlockDirection.West: BlockDirection.South
  of BlockDirection.East: BlockDirection.North
  of BlockDirection.Up, BlockDirection.North: BlockDirection.West
  of BlockDirection.Down, BlockDirection.South: BlockDirection.East

proc toBlockDirection*(self: Facing): BlockDirection =
  ## `FacingExt`.
  case self
  of Facing.North: BlockDirection.North
  of Facing.South: BlockDirection.South
  of Facing.West: BlockDirection.West
  of Facing.East: BlockDirection.East
  of Facing.Up: BlockDirection.Up
  of Facing.Down: BlockDirection.Down

proc toHorizontalFacing*(self: Facing): (bool, HorizontalFacing) =
  ## `FacingExt`.
  case self
  of Facing.North: (true, HorizontalFacing.North)
  of Facing.South: (true, HorizontalFacing.South)
  of Facing.West: (true, HorizontalFacing.West)
  of Facing.East: (true, HorizontalFacing.East)
  else: (false, HorizontalFacing.North)

proc toBlockDirection*(self: HorizontalFacing): BlockDirection =
  ## `HorizontalFacingExt`.
  case self
  of HorizontalFacing.North: BlockDirection.North
  of HorizontalFacing.South: BlockDirection.South
  of HorizontalFacing.West: BlockDirection.West
  of HorizontalFacing.East: BlockDirection.East
