## The table-backed half of pumpkin-data/src/blocks.rs (blocks.rs) and
## pumpkin-data/src/block_state.rs (block_state.rs). In Rust these are further
## methods of Block and BlockState, able to reach the generated tables through
## the crate. Here that would be an import cycle, so they sit above
## generated/block_properties.aowl.
##
## `DynBlockProperties` stands for upstream's `Box<dyn BlockProperties>`. It holds
## a block and a state index and reads the property table generated/block_properties.aowl
## carries, so the same mixed-radix decoding serves every property group. Code that
## knows its block uses the typed structs in generated/block_properties.aowl instead.

import "../generated/block_properties"
import "../generated/gendecode"
import block_rotation
import block_direction

export block_properties, block_rotation, block_direction

type
  DynProperty = object
    name: string
    values: seq[string]

  DynBlockProperties* = object
    ## `dyn BlockProperties`: one block's property values as a state index.
    group: int
    index*: uint16

  ShapeBoxList* = seq[ShapeBox]

proc loadGroupTable(): seq[seq[DynProperty]] =
  result = @[]
  let d = PropertyGroupData
  var pos = 0
  while pos < d.len:
    var group: seq[DynProperty] = @[]
    while pos < d.len and d[pos] != '\n':
      var p = DynProperty(name: fieldStr(d, pos, '='), values: @[])
      skipSep(d, pos)
      while pos < d.len and d[pos] != ';' and d[pos] != '\n':
        let start = pos
        while pos < d.len and d[pos] != ',' and d[pos] != ';' and d[pos] != '\n':
          inc pos
        p.values.add(substr(d, start, pos - 1))
        if pos < d.len and d[pos] == ',':
          inc pos
      group.add(p)
      if pos < d.len and d[pos] == ';':
        inc pos
    skipSep(d, pos)
    result.add(group)

let gGroupTable: seq[seq[DynProperty]] = loadGroupTable()

proc properties*(b: Block; stateId: BlockStateId): (bool, DynBlockProperties) =
  ## `Block::properties`; false for a block with no properties.
  let group = blockGroupOf(b.id)
  if group < 0:
    return (false, DynBlockProperties(group: 0, index: 0'u16))
  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  var index = 0'u16
  if asU16(stateId) >= minId and asU16(stateId) <= maxId:
    index = asU16(stateId) - minId
  (true, DynBlockProperties(group: group, index: index))

proc toProps*(self: DynBlockProperties): seq[(string, string)] =
  ## `BlockProperties::to_props`, in property declaration order.
  let group = gGroupTable[self.group]
  result = newSeq[(string, string)](group.len)
  var index = int(self.index)
  var i = group.len - 1
  while i >= 0:
    let count = group[i].values.len
    result[i] = (group[i].name, group[i].values[index mod count])
    index = index div count
    dec i

proc toIndex*(self: DynBlockProperties): uint16 {.inline.} = self.index

proc toStateId*(self: DynBlockProperties; b: Block): BlockStateId =
  ## `BlockProperties::to_state_id`.
  if blockGroupOf(b.id) != self.group:
    genPanic(b.name & " is not a valid block for this property group")
  b.states[int(self.index)].id

proc fromProperties*(b: Block; props: openArray[(string, string)]): DynBlockProperties =
  ## `Block::from_properties`: the block's default state with `props` applied.
  ## An unknown key is skipped; an unknown int value falls to the property's
  ## minimum and an unknown enum value panics, as the typed `from_props` do.
  let group = blockGroupOf(b.id)
  if group < 0:
    genPanic("Invalid props")
  let table = gGroupTable[group]
  let base = asU16(b.states[0].id)
  var digits = newSeq[int](table.len)
  var remaining = int(asU16(b.defaultState.id) - base)
  var i = table.len - 1
  while i >= 0:
    digits[i] = remaining mod table[i].values.len
    remaining = remaining div table[i].values.len
    dec i
  for prop in props:
    for j in 0 ..< table.len:
      if table[j].name == prop[0]:
        var found = -1
        for k in 0 ..< table[j].values.len:
          if table[j].values[k] == prop[1]:
            found = k
            break
        if found >= 0:
          digits[j] = found
        elif table[j].values[0] == "true":
          digits[j] = 1
        elif table[j].values[0][0] >= '0' and table[j].values[0][0] <= '9':
          digits[j] = 0
        else:
          genPanic("Invalid value: " & prop[1])
  var index = 0
  for j in 0 ..< table.len:
    index = index * table[j].values.len + digits[j]
  DynBlockProperties(group: group, index: uint16(index))

proc isWaterlogged*(b: Block; id: BlockStateId): bool =
  ## `Block::is_waterlogged`.
  let (has, props) = b.properties(id)
  if not has: return false
  for entry in props.toProps():
    if entry[0] == "waterlogged" and entry[1] == "true":
      return true
  false

proc withWaterlogged*(b: Block; id: BlockStateId): (bool, BlockState) =
  ## `Block::with_waterlogged`: this state with `waterlogged` forced true. False
  ## for a block with no properties. As upstream, a block with properties but no
  ## such key keeps its state, since `from_props` ignores what it does not know.
  if b.isWaterlogged(id):
    return (true, BlockState.fromId(id))
  let (has, source) = b.properties(id)
  if not has:
    return (false, BlockState.fromId(id))
  var props = source.toProps()
  var found = false
  for i in 0 ..< props.len:
    if props[i][0] == "waterlogged":
      props[i] = ("waterlogged", "true")
      found = true
  if not found:
    props.add(("waterlogged", "true"))
  let newStateId = b.fromProperties(props).toStateId(b)
  (true, BlockState.fromId(newStateId))

proc mirror*(b: Block; id: BlockStateId; m: Mirror): BlockState =
  ## `Block::mirror`, which upstream leaves as the identity.
  BlockState.fromId(id)

proc rotate*(b: Block; id: BlockStateId; r: Rotation): BlockState =
  ## `Block::rotate`, which upstream leaves as the identity.
  BlockState.fromId(id)

proc isWaterlogged*(s: BlockState): bool =
  ## `BlockState::is_waterlogged`.
  Block.fromStateId(s.id).isWaterlogged(s.id)

proc withWaterlogged*(s: BlockState): (bool, BlockState) =
  ## `BlockState::with_waterlogged`.
  Block.fromStateId(s.id).withWaterlogged(s.id)

proc getBlockCollisionShapes*(s: BlockState): seq[ShapeBox] =
  ## `BlockState::get_block_collision_shapes`.
  result = newSeq[ShapeBox](s.collisionShapes.len)
  for i, id in s.collisionShapes:
    result[i] = COLLISION_SHAPES[int(id)]

proc getBlockOutlineShapes*(s: BlockState): seq[ShapeBox] =
  ## `BlockState::get_block_outline_shapes`: a waterlogged state also has the
  ## water surface box.
  result = newSeq[ShapeBox](s.outlineShapes.len)
  for i, id in s.outlineShapes:
    result[i] = COLLISION_SHAPES[int(id)]
  if s.isWaterlogged:
    result.add(ShapeBox(minX: 0.0, minY: 0.0, minZ: 0.0, maxX: 1.0, maxY: 0.875, maxZ: 1.0))

proc `$`*(id: BlockId): string =
  ## `Display for BlockId`.
  "BlockId(" & $asU16(id) & " = \"" & Block.fromId(id).name & "\")"

proc `$`*(id: BlockStateId): string =
  ## `Display for BlockStateId`.
  "BlockStateId(" & $asU16(id) & " = \"" & Block.fromStateId(id).name & "\")"
