## Port of pumpkin-data/src/block_rotation.rs (block_rotation.rs). Block rotation
## and mirroring, used when placing blocks, matching vanilla behaviour.
##
## `leak_str` has no counterpart: a returned string owns its text here.

import "../util/vector3" as mathvec

type
  Rotation* {.pure.} = enum
    None
      ## No rotation (0 degrees)
    Clockwise90
      ## 90 degrees clockwise
    Rotate180
      ## 180 degrees
    CounterClockwise90
      ## 270 degrees clockwise (90 degrees counter-clockwise)

  Mirror* {.pure.} = enum
    None
      ## No mirroring
    LeftRight
      ## Mirror along the X axis (left-right flip when looking north)
    FrontBack
      ## Mirror along the Z axis (front-back flip)

proc rotationValues*(): array[4, Rotation] =
  [Rotation.None, Rotation.Clockwise90, Rotation.Rotate180, Rotation.CounterClockwise90]

proc fromIndex*(T: typedesc[Rotation]; index: uint8): Rotation =
  ## A rotation from the given random value (0-3).
  case index mod 4'u8
  of 0'u8: Rotation.None
  of 1'u8: Rotation.Clockwise90
  of 2'u8: Rotation.Rotate180
  else: Rotation.CounterClockwise90

proc transformPos*(self: Rotation; pos, size: Vector3[int32]): Vector3[int32] =
  ## Rotates a position around the Y axis within the template bounds `size`.
  case self
  of Rotation.None: pos
  of Rotation.Clockwise90: vec3(size.z - 1'i32 - pos.z, pos.y, pos.x)
  of Rotation.Rotate180: vec3(size.x - 1'i32 - pos.x, pos.y, size.z - 1'i32 - pos.z)
  of Rotation.CounterClockwise90: vec3(pos.z, pos.y, size.x - 1'i32 - pos.x)

proc rotateOffset*(self: Rotation; x, z: int32): (int32, int32) =
  ## Rotates an X/Z offset around the origin, unlike `transformPos`.
  case self
  of Rotation.None: (x, z)
  of Rotation.Clockwise90: (-z, x)
  of Rotation.Rotate180: (-x, -z)
  of Rotation.CounterClockwise90: (z, -x)

proc transformSize*(self: Rotation; size: Vector3[int32]): Vector3[int32] =
  ## For 90 and 270 degree rotations, X and Z dimensions are swapped.
  case self
  of Rotation.None, Rotation.Rotate180: size
  of Rotation.Clockwise90, Rotation.CounterClockwise90: vec3(size.z, size.y, size.x)

proc rotateFacing*(self: Rotation; facing: string): string =
  ## Rotates a horizontal facing (north/south/east/west); others pass through.
  case self
  of Rotation.None:
    facing
  of Rotation.Clockwise90:
    case facing
    of "north": "east"
    of "east": "south"
    of "south": "west"
    of "west": "north"
    else: facing
  of Rotation.Rotate180:
    case facing
    of "north": "south"
    of "south": "north"
    of "east": "west"
    of "west": "east"
    else: facing
  of Rotation.CounterClockwise90:
    case facing
    of "north": "west"
    of "west": "south"
    of "south": "east"
    of "east": "north"
    else: facing

proc rotateAxis*(self: Rotation; axis: string): string =
  ## Rotates a horizontal axis (x/z); others pass through.
  case self
  of Rotation.None, Rotation.Rotate180:
    axis
  of Rotation.Clockwise90, Rotation.CounterClockwise90:
    case axis
    of "x": "z"
    of "z": "x"
    else: axis

proc rotateBlockRotation*(self: Rotation; rotation: int32): int32 =
  ## Rotates a block rotation value (0-15, used for signs and banners).
  case self
  of Rotation.None: rotation
  of Rotation.Clockwise90: (rotation + 4'i32) mod 16'i32
  of Rotation.Rotate180: (rotation + 8'i32) mod 16'i32
  of Rotation.CounterClockwise90: (rotation + 12'i32) mod 16'i32

proc then*(self, other: Rotation): Rotation =
  ## Combines this rotation with another rotation.
  case self
  of Rotation.None: other
  of Rotation.Clockwise90:
    case other
    of Rotation.None: Rotation.Clockwise90
    of Rotation.Clockwise90: Rotation.Rotate180
    of Rotation.Rotate180: Rotation.CounterClockwise90
    of Rotation.CounterClockwise90: Rotation.None
  of Rotation.Rotate180:
    case other
    of Rotation.None: Rotation.Rotate180
    of Rotation.Clockwise90: Rotation.CounterClockwise90
    of Rotation.Rotate180: Rotation.None
    of Rotation.CounterClockwise90: Rotation.Clockwise90
  of Rotation.CounterClockwise90:
    case other
    of Rotation.None: Rotation.CounterClockwise90
    of Rotation.Clockwise90: Rotation.None
    of Rotation.Rotate180: Rotation.Clockwise90
    of Rotation.CounterClockwise90: Rotation.Rotate180

proc inverse*(self: Rotation): Rotation =
  case self
  of Rotation.None: Rotation.None
  of Rotation.Clockwise90: Rotation.CounterClockwise90
  of Rotation.Rotate180: Rotation.Rotate180
  of Rotation.CounterClockwise90: Rotation.Clockwise90

proc toAxis*(self: Rotation): mathvec.Axis =
  ## The primary axis for bounding box creation.
  case self
  of Rotation.None, Rotation.Rotate180: axisZ
  of Rotation.Clockwise90, Rotation.CounterClockwise90: axisX

proc mirrorValues*(): array[3, Mirror] =
  [Mirror.None, Mirror.LeftRight, Mirror.FrontBack]

proc transformPos*(self: Mirror; pos, size: Vector3[int32]): Vector3[int32] =
  case self
  of Mirror.None: pos
  of Mirror.LeftRight: vec3(size.x - 1'i32 - pos.x, pos.y, pos.z)
  of Mirror.FrontBack: vec3(pos.x, pos.y, size.z - 1'i32 - pos.z)

proc mirrorFacing*(self: Mirror; facing: string): string =
  case self
  of Mirror.None:
    facing
  of Mirror.LeftRight:
    case facing
    of "east": "west"
    of "west": "east"
    else: facing
  of Mirror.FrontBack:
    case facing
    of "north": "south"
    of "south": "north"
    else: facing

proc mirrorBlockRotation*(self: Mirror; rotation: int32): int32 =
  ## Mirrors a block rotation value (0-15, used for signs and banners).
  case self
  of Mirror.None: rotation
  of Mirror.LeftRight: (16'i32 - rotation) mod 16'i32
  of Mirror.FrontBack: (8'i32 - rotation + 16'i32) mod 16'i32

proc getRotation*(self: Mirror; rotation: Rotation): Rotation =
  ## The rotation needed to achieve this mirror from a base rotation.
  case self
  of Mirror.None: rotation
  of Mirror.LeftRight:
    case rotation
    of Rotation.None: Rotation.None
    of Rotation.Clockwise90: Rotation.CounterClockwise90
    of Rotation.Rotate180: Rotation.Rotate180
    of Rotation.CounterClockwise90: Rotation.Clockwise90
  of Mirror.FrontBack:
    case rotation
    of Rotation.None: Rotation.Rotate180
    of Rotation.Clockwise90: Rotation.Clockwise90
    of Rotation.Rotate180: Rotation.None
    of Rotation.CounterClockwise90: Rotation.CounterClockwise90
