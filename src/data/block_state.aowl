## Port of pumpkin-data/src/block_state.rs (block_state.rs): the type and the
## predicates that need no table.
##
## Rust splits one `impl BlockState` over this file and the generated block.rs;
## aowlmony has no partial impl and imports may not cycle. So the table-backed
## parts sit above this module: `from_id` and friends in generated/block_properties.aowl,
## and `is_waterlogged`, `with_waterlogged`, `get_block_collision_shapes` and
## `get_block_outline_shapes` in data/block_ext.aowl.

import std/hashes
import "../generated/block_enums"
import block_direction

type
  BlockStateId* = distinct uint16
    ## The global palette id. `BlockStateId::new` checks the range and lives in
    ## generated/block_properties.aowl, where STATE_COUNT is known.

  PistonBehavior* = enum
    pbNormal, pbDestroy, pbBlock, pbIgnore, pbPushOnly

  BlockState* = object
    ## One state of a block. Rust's `&'static [u16]` shapes are seqs here.
    id*: BlockStateId
    stateFlags*: uint16
    sideFlags*: uint8
    instrument*: NoteblockInstrument
    luminance*: uint8
    pistonBehavior*: PistonBehavior
    hardness*: float32
    collisionShapes*: seq[uint16]
    outlineShapes*: seq[uint16]
    opacity*: uint8
    blockEntityType*: uint16
      ## `u16::MAX` if the block holds no NBT data.

  ShapeBox* = object
    ## One entry of COLLISION_SHAPES. Upstream stores pumpkin_util's BoundingBox.
    minX*, minY*, minZ*, maxX*, maxY*, maxZ*: float

const
  # state_flags, in layout order.
  IS_AIR = 1'u16 shl 0
  BURNABLE = 1'u16 shl 1
  TOOL_REQUIRED = 1'u16 shl 2
  SIDED_TRANSPARENCY = 1'u16 shl 3
  REPLACEABLE = 1'u16 shl 4
  IS_LIQUID = 1'u16 shl 5
  IS_SOLID = 1'u16 shl 6
  IS_FULL_CUBE = 1'u16 shl 7
  IS_SOLID_BLOCK = 1'u16 shl 8
  HAS_RANDOM_TICKS = 1'u16 shl 9
  # side_flags.
  DOWN_SIDE_SOLID = 1'u8 shl 0
  UP_SIDE_SOLID = 1'u8 shl 1
  NORTH_SIDE_SOLID = 1'u8 shl 2
  SOUTH_SIDE_SOLID = 1'u8 shl 3
  WEST_SIDE_SOLID = 1'u8 shl 4
  EAST_SIDE_SOLID = 1'u8 shl 5
  DOWN_CENTER_SOLID = 1'u8 shl 6
  UP_CENTER_SOLID = 1'u8 shl 7

proc `==`*(a, b: BlockStateId): bool {.borrow.}
proc `<`*(a, b: BlockStateId): bool {.borrow.}
proc `<=`*(a, b: BlockStateId): bool {.borrow.}
proc hash*(a: BlockStateId): Hash = hash(int(uint16(a)))

proc asU16*(id: BlockStateId): uint16 {.inline.} = uint16(id)
proc newBlockStateIdUnchecked*(inner: uint16): BlockStateId {.inline.} = BlockStateId(inner)

const blockStateIdAir* = BlockStateId(0'u16)
  ## `BlockStateId::AIR`, air being the first block's default state.

proc `==`*(a: BlockState; b: BlockStateId): bool {.inline.} = a.id == b
proc `==`*(a: BlockStateId; b: BlockState): bool {.inline.} = a == b.id
proc `==`*(a, b: BlockState): bool {.inline.} = a.id == b.id

proc isAir*(s: BlockState): bool {.inline.} = (s.stateFlags and IS_AIR) != 0'u16
proc burnable*(s: BlockState): bool {.inline.} = (s.stateFlags and BURNABLE) != 0'u16
proc toolRequired*(s: BlockState): bool {.inline.} = (s.stateFlags and TOOL_REQUIRED) != 0'u16
proc sidedTransparency*(s: BlockState): bool {.inline.} = (s.stateFlags and SIDED_TRANSPARENCY) != 0'u16
proc replaceable*(s: BlockState): bool {.inline.} = (s.stateFlags and REPLACEABLE) != 0'u16
proc isLiquid*(s: BlockState): bool {.inline.} = (s.stateFlags and IS_LIQUID) != 0'u16
proc isSolid*(s: BlockState): bool {.inline.} =
  ## The legacy value for whether a block is solid.
  (s.stateFlags and IS_SOLID) != 0'u16
proc isFullCube*(s: BlockState): bool {.inline.} = (s.stateFlags and IS_FULL_CUBE) != 0'u16
proc isSolidRender*(s: BlockState): bool {.inline.} =
  ## `BlockState::is_solid_render`. The pinned assets carry no such flag (the newer tree's bit 10), and the checked-in
  ## state_flags are kept as the pinned tree has them, so it is derived: a full cube that blocks light fully (light block 15),
  ## which is what vanilla's solidRender comes to.
  (s.stateFlags and IS_FULL_CUBE) != 0'u16 and s.opacity == 15'u8
proc isSolidBlock*(s: BlockState): bool {.inline.} =
  ## Solid blocks conduct redstone and block redstone wire.
  (s.stateFlags and IS_SOLID_BLOCK) != 0'u16
proc hasRandomTicks*(s: BlockState): bool {.inline.} = (s.stateFlags and HAS_RANDOM_TICKS) != 0'u16

proc isSideSolid*(s: BlockState; side: BlockDirection): bool =
  ## `isFaceSturdy()` in Java.
  case side
  of BlockDirection.Down: (s.sideFlags and DOWN_SIDE_SOLID) != 0'u8
  of BlockDirection.Up: (s.sideFlags and UP_SIDE_SOLID) != 0'u8
  of BlockDirection.North: (s.sideFlags and NORTH_SIDE_SOLID) != 0'u8
  of BlockDirection.South: (s.sideFlags and SOUTH_SIDE_SOLID) != 0'u8
  of BlockDirection.West: (s.sideFlags and WEST_SIDE_SOLID) != 0'u8
  of BlockDirection.East: (s.sideFlags and EAST_SIDE_SOLID) != 0'u8

proc isCenterSolid*(s: BlockState; side: BlockDirection): bool =
  ## isSideSolid(..., Direction.UP, SideShapeType.CENTER) in Java. Only valid
  ## for the UP and DOWN sides.
  case side
  of BlockDirection.Down: (s.sideFlags and DOWN_CENTER_SOLID) != 0'u8
  of BlockDirection.Up: (s.sideFlags and UP_CENTER_SOLID) != 0'u8
  else: false
