## Port of pumpkin-data/src/blocks.rs (blocks.rs): the Block type and BlockId.
##
## As with block_state.aowl, what needs the block table sits above this module:
## `Block::from_id` and friends in generated/block_properties.aowl, and the waterlogging,
## `mirror`, `rotate`, `has_tag` and Display parts in data/block_ext.aowl.
## `loot_table` lives in generated/block_loot.aowl, keyed by block id.
##
## `experience` is its IntProvider's inclusive range (a constant has min == max),
## which is all assets/blocks.json uses: the util port's IntProvider can be built
## from it without this module depending on that port.

import std/hashes
import block_state

type
  BlockId* = distinct uint16
    ## `BlockId::new` checks the range and lives in generated/block_properties.aowl, where
    ## BLOCK_COUNT is known.

  Flammable* = object
    spreadChance*: uint8
    burnChance*: uint8

  Block* = ref object
    ## The static definition of a block type. Immutable once loaded: Rust's
    ## `&'static Block` is this ref, `Option<&'static Block>` is `nil Block`.
    id*: BlockId
    name*: string
    hardness*: float32
    blastResistance*: float32
    mapColor*: uint8
    slipperiness*: float32
    velocityMultiplier*: float32
    jumpVelocityMultiplier*: float32
    itemId*: uint16
    defaultState*: BlockState
    states*: seq[BlockState]
    hasFlammable*: bool
    flammable*: Flammable
    hasExperience*: bool
    experienceMin*: int32
    experienceMax*: int32

proc `==`*(a, b: BlockId): bool {.borrow.}
proc `<`*(a, b: BlockId): bool {.borrow.}
proc `<=`*(a, b: BlockId): bool {.borrow.}
proc hash*(a: BlockId): Hash = hash(int(uint16(a)))

proc asU16*(id: BlockId): uint16 {.inline.} = uint16(id)
proc newBlockIdUnchecked*(inner: uint16): BlockId {.inline.} = BlockId(inner)

proc `==`*(a: Block; b: BlockId): bool {.inline.} = a.id == b
proc `==`*(a: BlockId; b: Block): bool {.inline.} = a == b.id
proc sameBlock*(a, b: Block): bool {.inline.} =
  ## `impl PartialEq for Block`: two blocks are equal when their ids are.
  a.id == b.id

proc hash*(a: Block): Hash = hash(a.id)

proc isSolid*(b: Block): bool {.inline.} =
  ## Whether this block is solid, based on its default state.
  b.defaultState.isSolid

proc isAir*(b: Block): bool {.inline.} =
  ## Whether this block is air, based on its default state.
  b.defaultState.isAir

proc toResourceLocation*(b: Block): string =
  ## `ToResourceLocation for &'static Block`.
  "minecraft:" & b.name
