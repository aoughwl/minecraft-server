## Known-answer checks for generated/block_properties.aowl and the src/data block modules.
## The expected numbers are read from upstream's own generated block.rs in the
## pinned tree, or from assets/blocks.json.

import std/syncio
import block_ext

var failed = 0

proc check(cond: bool; what: string) =
  if not cond:
    echo "FAIL: " & what
    inc failed

check(STATE_COUNT == 32366'u16, "state count")
check(BLOCK_COUNT == 1196'u16, "block count")
check(COLLISION_SHAPES.len == 683, "shapes")
check(BLOCK_ENTITY_TYPES.len == 49, "block entity types")
check(BLOCK_ENTITY_TYPES[0] == "furnace", "first block entity type")
check(COLLISION_SHAPES[1].minX == 0.125 and COLLISION_SHAPES[1].maxY == 0.75, "shape 1")

let air = Block.fromId(blockIdAir)
check(air.name == "air" and air.isAir, "air")
check(Block.fromName("minecraft:stone") != nil, "fromName with prefix")
check(Block.fromName("stone") != nil, "fromName without prefix")
check(Block.fromRegistryKey("minecraft:stone") == nil, "fromRegistryKey keeps the prefix out")
check(Block.fromName("no_such_block") == nil, "unknown name")

let diorite = Block.fromId(blockIdPolishedDiorite)
check(asU16(diorite.id) == 5'u16 and diorite.name == "polished_diorite", "polished diorite id")
check(diorite.itemId == 5'u16 and diorite.mapColor == 14'u8, "polished diorite fields")
check(diorite.hardness == 1.5'f32 and diorite.blastResistance == 6.0'f32, "polished diorite strength")
check(diorite.slipperiness == 0.6'f32, "polished diorite slipperiness")
let dst = diorite.defaultState
check(asU16(dst.id) == 5'u16 and dst.stateFlags == 452'u16 and dst.sideFlags == 255'u8, "polished diorite state")
check(dst.instrument == NoteblockInstrument.Basedrum and dst.opacity == 15'u8, "polished diorite state 2")
check(dst.pistonBehavior == pbNormal and dst.blockEntityType == 65535'u16, "polished diorite state 3")
check(dst.collisionShapes.len == 1 and dst.collisionShapes[0] == 0'u16, "polished diorite shape")
check(dst.isSolid and dst.isFullCube and dst.isSolidBlock, "polished diorite flags")
check(dst.isSideSolid(BlockDirection.Up) and dst.isCenterSolid(BlockDirection.Down), "polished diorite sides")
check(not dst.isCenterSolid(BlockDirection.North), "center solid is only up and down")

check(BlockId.fromStateId(newBlockStateIdUnchecked(5'u16)) == blockIdPolishedDiorite, "block from state")
check(Block.fromItemId(5'u16) != nil, "block from item")
check(isAir(blockStateIdAir), "state air")
check(not isAir(newBlockStateIdUnchecked(5'u16)), "state 5 is not air")

let water = Block.fromId(blockIdWater)
check(water.states[0].isLiquid, "water is liquid")
check(isLiquid(water.states[0].id), "water state id is liquid")

# isSolidRender is derived (full cube and opacity 15); the newer assets' bit 10 agrees on these.
check(dst.isSolidRender, "polished diorite renders solid")
let glassBlock = Block.fromName("glass")
let leavesBlock = Block.fromName("oak_leaves")
check(glassBlock != nil and not glassBlock.states[0].isSolidRender, "glass does not render solid")
check(leavesBlock != nil and not leavesBlock.states[0].isSolidRender, "leaves do not render solid")
check(not air.states[0].isSolidRender, "air does not render solid")

# Typed struct: an oak fence gate is facing x in_wall x open x powered.
let gate = Block.fromId(blockIdOakFenceGate)
let defaults = OakFenceGateLikeProperties.defaultFor(gate)
check(defaults.toStateId(gate) == gate.defaultState.id, "typed default round trip")
for st in gate.states:
  let p = OakFenceGateLikeProperties.fromStateId(st.id, gate)
  check(p.toStateId(gate) == st.id, "typed round trip")
var changed = OakFenceGateLikeProperties.fromProps([("open", "true"), ("facing", "east")], gate)
check(changed.open and changed.facing == HorizontalFacing.East, "typed from props")

# Dyn and typed agree on every fence gate state.
for st in gate.states:
  let (has, dyn) = gate.properties(st.id)
  check(has, "gate has properties")
  let typed = OakFenceGateLikeProperties.fromStateId(st.id, gate).toProps()
  let d = dyn.toProps()
  check(typed.len == d.len, "dyn prop count")
  for i in 0 ..< typed.len:
    check(typed[i][0] == d[i][0] and typed[i][1] == d[i][1], "dyn prop " & typed[i][0])
  check(gate.fromProperties(d).toStateId(gate) == st.id, "dyn round trip")

check(not diorite.properties(diorite.defaultState.id)[0], "no properties on polished diorite")

# Waterlogging, against an oak slab's default (type=bottom, waterlogged=false).
let slab = Block.fromId(blockIdOakSlab)
check(not slab.isWaterlogged(slab.defaultState.id), "slab starts dry")
let (hasWet, wet) = slab.withWaterlogged(slab.defaultState.id)
check(hasWet and slab.isWaterlogged(wet.id), "slab with water")
check(wet.isWaterlogged, "state form")
check(wet.getBlockOutlineShapes().len == slab.defaultState.getBlockOutlineShapes().len + 1, "water outline box")

# Upstream's table: state 0 is air, whose bedrock network id block.rs's
# STATE_ID_TO_BEDROCK starts with.
check(toBeNetworkId(blockStateIdAir) == 13094'u16, "air on bedrock")

check($blockIdAir == "BlockId(0 = \"air\")", "BlockId display")
check($blockStateIdAir == "BlockStateId(0 = \"air\")", "BlockStateId display")

# Direction and rotation vectors, from block_direction.rs and block_rotation.rs.
check(BlockDirection.North.toOffset().z == -1'i32, "north offset")
check(BlockDirection.Up.opposite() == BlockDirection.Down, "opposite")
check(BlockDirection.West.rotateClockwise() == BlockDirection.North, "rotate")
check(tryFromI32(6'i32)[0] == false, "bad face")
check(Rotation.Clockwise90.then(Rotation.Rotate180) == Rotation.CounterClockwise90, "then")
check(Rotation.Clockwise90.rotateFacing("south") == "west", "rotate facing")
check(Mirror.FrontBack.mirrorBlockRotation(4'i32) == 4'i32, "mirror rotation")
check(HorizontalFacing.North.rotateClockwise() == HorizontalFacing.East, "horizontal rotate")
check(Facing.Up.toBlockDirection() == BlockDirection.Up, "facing ext")

if failed > 0:
  echo $failed & " checks failed"
  quit(1)
echo "blocktest: ok"
