## Port of pumpkin-data/src/data_component_impl/basic.rs
##
## `SoundEvent` lives in impl_base.aowl and is re-exported, because `get_idor_hash` needs it below this
## file. Each type's `get_enum`/`to_dyn`/`get` are in mod.aowl, as those name the closed variant. A proc
## missing here means upstream's trait default: `write_data` gives `NbtTag::End`, `get_hash` gives 0.

import impl_base
import ../../nbt/tag
import ../../util/text/text

export impl_base, text

type
  CustomDataImpl* = object
    data*: NbtCompound

  MaxStackSizeImpl* = object
    size*: uint8

  MaxDamageImpl* = object
    maxDamage*: int32

  DamageImpl* = object
    damage*: int32

  UnbreakableImpl* = object

  CustomNameImpl* = object
    name*: TextComponent

  ItemNameImpl* = object
    name*: string

  ItemModelImpl* = object
    id*: string

  LoreImpl* = object

  RarityImpl* = object

  CustomModelDataImpl* = object
    floats*: seq[float32]
    flags*: seq[bool]
    strings*: seq[string]
    colors*: seq[int32]

  TooltipDisplayImpl* = object

  CreativeSlotLockImpl* = object

  EnchantmentGlintOverrideImpl* = object

  TooltipStyleImpl* = object
    id*: string

  NoteBlockSoundImpl* = object
    sound*: string

  BaseColorImpl* = object
    color*: string

  InstrumentImpl* = object

  ProvidesTrimMaterialImpl* = object

  ProvidesBannerPatternsImpl* = object

  BannerPatternsImpl* = object

  PotDecorationsImpl* = object

  LockImpl* = object
    ## The lock's item predicate, kept as its raw NBT compound since upstream does
    ## not yet model item predicates.
    predicate*: NbtCompound

  BreakSoundImpl* = object

proc newCustomDataImpl*(data: NbtCompound): CustomDataImpl = CustomDataImpl(data: data)

proc readData*(_: typedesc[CustomDataImpl]; tag: NbtTag): Option[CustomDataImpl] =
  if tag.kind == ntkCompound: some(CustomDataImpl(data: tag.compoundVal)) else: none[CustomDataImpl]()

proc writeData*(self: CustomDataImpl): NbtTag = newTagCompound(self.data)

proc `==`*(a, b: CustomDataImpl): bool = a.data == b.data

proc readData*(_: typedesc[MaxStackSizeImpl]; data: NbtTag): Option[MaxStackSizeImpl] =
  let size = extractInt(data)
  if size.isSome:
    # `size as u8`: only the low byte counts.
    some(MaxStackSizeImpl(size: uint8(cast[uint32](size.unsafeGet) and 0xFF'u32)))
  else:
    none[MaxStackSizeImpl]()

proc writeData*(self: MaxStackSizeImpl): NbtTag = newTagInt(int32(self.size))

proc getHash*(self: MaxStackSizeImpl): int32 = asI32(getI32Hash(int32(self.size)))

proc readData*(_: typedesc[DamageImpl]; data: NbtTag): Option[DamageImpl] =
  let damage = extractInt(data)
  if damage.isSome: some(DamageImpl(damage: damage.unsafeGet)) else: none[DamageImpl]()

proc writeData*(self: DamageImpl): NbtTag = newTagInt(self.damage)

proc getHash*(self: DamageImpl): int32 = asI32(getI32Hash(self.damage))

proc readData*(_: typedesc[UnbreakableImpl]; data: NbtTag): Option[UnbreakableImpl] =
  some(UnbreakableImpl())

proc writeData*(self: UnbreakableImpl): NbtTag = newTagCompound(newCompound())

proc readData*(_: typedesc[CustomNameImpl]; data: NbtTag): Option[CustomNameImpl] =
  let name = extractString(data)
  if name.isSome: some(CustomNameImpl(name: text(name.unsafeGet))) else: none[CustomNameImpl]()

proc writeData*(self: CustomNameImpl): NbtTag = newTagStr(self.name.getText())

proc getHash*(self: CustomNameImpl): int32 = asI32(getStrHash(self.name.getText()))

proc `==`*(a, b: CustomNameImpl): bool =
  ## Upstream derives this over the whole `TextComponent`.
  a.name == b.name

proc readData*(_: typedesc[ItemModelImpl]; data: NbtTag): Option[ItemModelImpl] =
  let id = extractString(data)
  if id.isSome: some(ItemModelImpl(id: id.unsafeGet)) else: none[ItemModelImpl]()

proc writeData*(self: ItemModelImpl): NbtTag = newTagStr(self.id)

proc getHash*(self: ItemModelImpl): int32 = asI32(getStrHash(self.id))

proc readData*(_: typedesc[CustomModelDataImpl]; data: NbtTag): Option[CustomModelDataImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone:
    return none[CustomModelDataImpl]()
  let compound = compoundOpt.unsafeGet
  var floats: seq[float32] = @[]
  var flags: seq[bool] = @[]
  var strings: seq[string] = @[]
  var colors: seq[int32] = @[]
  let floatList = getList(compound, "floats")
  if floatList.isSome:
    for t in floatList.unsafeGet:
      if t.kind == ntkFloat: floats.add(t.floatVal)
  let flagList = getList(compound, "flags")
  if flagList.isSome:
    for t in flagList.unsafeGet:
      if t.kind == ntkByte: flags.add(t.byteVal != 0'i8)
  let stringList = getList(compound, "strings")
  if stringList.isSome:
    for t in stringList.unsafeGet:
      if t.kind == ntkString: strings.add(t.stringVal)
  # Vanilla encodes the color list as ints, but tolerate a packed int array too.
  let colorArray = getIntArray(compound, "colors")
  if colorArray.isSome:
    colors = colorArray.unsafeGet
  else:
    let colorList = getList(compound, "colors")
    if colorList.isSome:
      for t in colorList.unsafeGet:
        if t.kind == ntkInt: colors.add(t.intVal)
  some(CustomModelDataImpl(floats: floats, flags: flags, strings: strings, colors: colors))

proc writeData*(self: CustomModelDataImpl): NbtTag =
  var compound = newCompound()
  var floats: seq[NbtTag] = @[]
  for f in self.floats: floats.add(NbtTag(kind: ntkFloat, floatVal: f))
  compound.putList("floats", floats)
  var flags: seq[NbtTag] = @[]
  for b in self.flags: flags.add(NbtTag(kind: ntkByte, byteVal: (if b: 1'i8 else: 0'i8)))
  compound.putList("flags", flags)
  var strings: seq[NbtTag] = @[]
  for s in self.strings: strings.add(newTagStr(s))
  compound.putList("strings", strings)
  var colors: seq[NbtTag] = @[]
  for c in self.colors: colors.add(newTagInt(c))
  compound.putList("colors", colors)
  newTagCompound(compound)

proc readData*(_: typedesc[TooltipStyleImpl]; data: NbtTag): Option[TooltipStyleImpl] =
  let id = extractString(data)
  if id.isSome: some(TooltipStyleImpl(id: id.unsafeGet)) else: none[TooltipStyleImpl]()

proc writeData*(self: TooltipStyleImpl): NbtTag = newTagStr(self.id)

proc getHash*(self: TooltipStyleImpl): int32 = asI32(getStrHash(self.id))

proc readData*(_: typedesc[NoteBlockSoundImpl]; data: NbtTag): Option[NoteBlockSoundImpl] =
  let sound = extractString(data)
  if sound.isSome: some(NoteBlockSoundImpl(sound: sound.unsafeGet)) else: none[NoteBlockSoundImpl]()

proc writeData*(self: NoteBlockSoundImpl): NbtTag = newTagStr(self.sound)

proc getHash*(self: NoteBlockSoundImpl): int32 = asI32(getStrHash(self.sound))

proc readData*(_: typedesc[BaseColorImpl]; data: NbtTag): Option[BaseColorImpl] =
  let color = extractString(data)
  if color.isSome: some(BaseColorImpl(color: color.unsafeGet)) else: none[BaseColorImpl]()

proc writeData*(self: BaseColorImpl): NbtTag = newTagStr(self.color)

proc getHash*(self: BaseColorImpl): int32 = asI32(getStrHash(self.color))

proc readData*(_: typedesc[LockImpl]; data: NbtTag): Option[LockImpl] =
  let predicate = extractCompound(data)
  if predicate.isSome: some(LockImpl(predicate: predicate.unsafeGet)) else: none[LockImpl]()

proc writeData*(self: LockImpl): NbtTag = newTagCompound(self.predicate)

proc `==`*(a, b: LockImpl): bool = a.predicate == b.predicate
