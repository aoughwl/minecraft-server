## Port of pumpkin-data/src/data_component_impl/block_entity.rs
##
## `ContainerImpl` holds `ItemStack`s, so its type is with `ItemStack` in mod.aowl and its `read_data` is
## with `read_item_stack` in ../item_stack/mod.aowl.

import std/algorithm
import impl_base
import ../../nbt/tag

type
  BlockEntityDataImpl* = object
    nbt*: NbtCompound

  EntityDataImpl* = object

  BucketEntityDataImpl* = object

  BlockStateImpl* = object
    properties*: seq[(string, string)]

  BeesImpl* = object

  ContainerLootImpl* = object
    lootTable*: string
    seed*: int64

  SulfurCubeContentImpl* = object

proc readData*(_: typedesc[BlockEntityDataImpl]; tag: NbtTag): Option[BlockEntityDataImpl] =
  if tag.kind == ntkCompound: some(BlockEntityDataImpl(nbt: tag.compoundVal)) else: none[BlockEntityDataImpl]()

proc `==`*(a, b: BlockEntityDataImpl): bool = a.nbt == b.nbt

proc sortedProperties(self: BlockStateImpl): seq[(string, string)] =
  result = self.properties
  result.sort(proc (a, b: (string, string)): int = cmp(a[0], b[0]))

proc `==`*(a, b: BlockStateImpl): bool =
  sortedProperties(a) == sortedProperties(b)

proc readData*(_: typedesc[BlockStateImpl]; data: NbtTag): Option[BlockStateImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone:
    return none[BlockStateImpl]()
  let compound = compoundOpt.unsafeGet
  var properties: seq[(string, string)] = @[]
  for i in 0 ..< compound.names.len:
    if compound.values[i].kind == ntkString:
      properties.add((compound.names[i], compound.values[i].stringVal))
  some(BlockStateImpl(properties: properties))

proc writeData*(self: BlockStateImpl): NbtTag =
  var compound = newCompound()
  for p in self.properties:
    compound.putString(p[0], p[1])
  newTagCompound(compound)

proc getHash*(self: BlockStateImpl): int32 =
  var digest = newDigest()
  for p in sortedProperties(self):
    digest.updateStr(p[0])
    digest.updateStr(p[1])
  digest.finalizeI32()

proc readData*(_: typedesc[ContainerLootImpl]; data: NbtTag): Option[ContainerLootImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone:
    return none[ContainerLootImpl]()
  let lootTable = getString(compoundOpt.unsafeGet, "loot_table")
  if lootTable.isNone:
    return none[ContainerLootImpl]()
  let seed = getLong(compoundOpt.unsafeGet, "seed")
  some(ContainerLootImpl(lootTable: lootTable.unsafeGet, seed: (if seed.isSome: seed.unsafeGet else: 0'i64)))

proc writeData*(self: ContainerLootImpl): NbtTag =
  var compound = newCompound()
  compound.putString("loot_table", self.lootTable)
  compound.putLong("seed", self.seed)
  newTagCompound(compound)
