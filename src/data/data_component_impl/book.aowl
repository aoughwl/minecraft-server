## Port of pumpkin-data/src/data_component_impl/book.rs

import impl_base
import ../../nbt/tag

type
  WritableBookContentImpl* = object
    pages*: seq[string]

  WrittenBookContentImpl* = object
    pages*: seq[string]

  DebugStickStateImpl* = object

proc emptyPages(tag: NbtTag): seq[string] =
  ## As upstream, one empty string per page: the page text is not read.
  result = @[]
  if tag.kind == ntkCompound:
    let (found, pages) = tag.compoundVal.get("pages")
    if found and pages.kind == ntkList:
      for i in 0 ..< pages.listVal.len:
        result.add("")

proc readData*(_: typedesc[WritableBookContentImpl]; tag: NbtTag): Option[WritableBookContentImpl] =
  some(WritableBookContentImpl(pages: emptyPages(tag)))

proc readData*(_: typedesc[WrittenBookContentImpl]; tag: NbtTag): Option[WrittenBookContentImpl] =
  some(WrittenBookContentImpl(pages: emptyPages(tag)))
