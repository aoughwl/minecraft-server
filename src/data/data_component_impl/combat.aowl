  case self
  of drtAlwaysHurtsEnderDragons: "#minecraft:always_hurts_ender_dragons"
  of drtAlwaysKillsArmorStands: "#minecraft:always_kills_armor_stands"
  of drtAlwaysMostSignificantFall: "#minecraft:always_most_significant_fall"
  of drtAlwaysTriggersSilverfish: "#minecraft:always_triggers_silverfish"
  of drtAvoidsGuardianThorns: "#minecraft:avoids_guardian_thorns"
  of drtBurnsArmorStands: "#minecraft:burns_armor_stands"
  of drtBurnFromStepping: "#minecraft:burn_from_stepping"
  of drtBypassesArmor: "#minecraft:bypasses_armor"
  of drtBypassesCooldown: "#minecraft:bypasses_cooldown"
  of drtBypassesEffects: "#minecraft:bypasses_effects"
  of drtBypassesEnchantments: "#minecraft:bypasses_enchantments"
  of drtBypassesInvulnerability: "#minecraft:bypasses_invulnerability"
  of drtBypassesResistance: "#minecraft:bypasses_resistance"
  of drtBypassesShield: "#minecraft:bypasses_shield"
  of drtBypassesWolfArmor: "#minecraft:bypasses_wolf_armor"
  of drtCanBreakArmorStands: "#minecraft:can_break_armor_stand"
  of drtDamagesHelmet: "#minecraft:damages_helmet"
  of drtIgnitesArmorStands: "#minecraft:ignites_armor_stands"
  of drtDrowning: "#minecraft:is_drowning"
  of drtExplosion: "#minecraft:is_explosion"
  of drtFall: "#minecraft:is_fall"
  of drtFire: "#minecraft:is_fire"
  of drtFreezing: "#minecraft:is_freezing"
  of drtLightning: "#minecraft:is_lightning"
  of drtPlayerAttack: "#minecraft:is_player_attack"
  of drtProjectile: "#minecraft:is_projectile"
  of drtMaceSmash: "#minecraft:mace_smash"
  of drtNoAnger: "#minecraft:no_anger"
  of drtNoImpact: "#minecraft:no_impact"
  of drtNoKnockback: "#minecraft:no_knockback"
  of drtPanicCauses: "#minecraft:panic_causes"
  of drtPanicEnvironmentalCauses: "#minecraft:panic_environmental_causes"
  of drtWitchResistantTo: "#minecraft:witch_resistant_to"
  of drtWitherImmuneTo: "#minecraft:wither_immune_to"
  of drtGeneric: "minecraft:generic"

proc readData*(_: typedesc[DamageResistantImpl]; data: NbtTag): Option[DamageResistantImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[DamageResistantImpl]()
  let typeStr = getString(compoundOpt.unsafeGet, "types")
  if typeStr.isNone: return none[DamageResistantImpl]()
  some(DamageResistantImpl(resType: fromTag(DamageResistantType, typeStr.unsafeGet)))

proc writeData*(self: DamageResistantImpl): NbtTag =
  var compound = newCompound()
  compound.putString("types", self.resType.asStr())
  newTagCompound(compound)

proc getHash*(self: DamageResistantImpl): int32 = asI32(getStrHash(self.resType.asStr()))

func `==`*(a, b: ToolRule): bool =
  a.blocks == b.blocks and a.speed == b.speed and a.correctForDrops == b.correctForDrops

func `==`*(a, b: ToolImpl): bool =
  a.rules == b.rules and a.defaultMiningSpeed == b.defaultMiningSpeed and
    a.damagePerBlock == b.damagePerBlock and a.canDestroyBlocksInCreative == b.canDestroyBlocksInCreative

proc readData*(_: typedesc[WeaponImpl]; data: NbtTag): Option[WeaponImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[WeaponImpl]()
  let raw = getInt(compoundOpt.unsafeGet, "item_damage_per_attack")
  let value = if raw.isSome: raw.unsafeGet else: 1'i32
  some(WeaponImpl(itemDamagePerAttack: uint32(max(value, 0'i32))))

proc writeData*(self: WeaponImpl): NbtTag =
  var compound = newCompound()
  compound.putInt("item_damage_per_attack", cast[int32](self.itemDamagePerAttack))
  newTagCompound(compound)

proc getHash*(self: WeaponImpl): int32 =
  # Upstream's hash here is the value itself.
  cast[int32](self.itemDamagePerAttack)

func `==`*(a, b: EquippableImpl): bool =
  a.slot == b.slot and a.equipSound == b.equipSound and a.assetId == b.assetId and
    a.cameraOverlay == b.cameraOverlay and a.allowedEntities == b.allowedEntities and
    a.dispensable == b.dispensable and a.swappable == b.swappable and a.damageOnHurt == b.damageOnHurt and
    a.equipOnInteract == b.equipOnInteract and a.canBeSheared == b.canBeSheared and
    a.shearingSound == b.shearingSound

proc boolOr(v: Option[bool]; default: bool): bool {.inline.} =
  if v.isSome: v.unsafeGet else: default

proc readData*(_: typedesc[EquippableImpl]; data: NbtTag): Option[EquippableImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[EquippableImpl]()
  let compound = compoundOpt.unsafeGet
  let slotName = getString(compound, "slot")
  if slotName.isNone: return none[EquippableImpl]()
  let (slotFound, slot) = getFromName(EquipmentSlot, slotName.unsafeGet)
  if not slotFound: return none[EquippableImpl]()
  var allowedEntities = none[IDSet]()
  let allowed = compoundTag(compound, "allowed_entities")
  if allowed.isSome:
    allowedEntities = readIDSet(allowed.unsafeGet, EntityTypeContent)
  # "shearing_sound_sound" is upstream's key here, though write_data uses "shearing_sound".
  some(EquippableImpl(slot: slot, equipSound: getIdor(compound, "equip_sound", sdItemArmorEquipGeneric),
    assetId: getString(compound, "asset_id"), cameraOverlay: getString(compound, "camera_overlay"),
    allowedEntities: allowedEntities, dispensable: boolOr(getBool(compound, "dispensable"), true),
    swappable: boolOr(getBool(compound, "swappable"), true),
    damageOnHurt: boolOr(getBool(compound, "damage_on_hurt"), true),
    equipOnInteract: boolOr(getBool(compound, "equip_on_interact"), false),
    canBeSheared: boolOr(getBool(compound, "can_be_sheared"), false),
    shearingSound: getIdor(compound, "shearing_sound_sound", sdItemShearsSnip)))

proc getHash*(self: EquippableImpl): int32 =
  var digest = newDigest()
  digest.updateByte(16'u8)
  digest.updateU32Le(getI32Hash(self.slot.getSlotIndex()))
  digest.updateU32Le(getIdorHash(self.equipSound))
  if self.assetId.isSome:
    digest.updateByte(1'u8)
    digest.updateU32Le(getStrHash(self.assetId.unsafeGet))
  if self.cameraOverlay.isSome:
    digest.updateByte(2'u8)
    digest.updateU32Le(getStrHash(self.cameraOverlay.unsafeGet))
  if self.allowedEntities.isSome:
    digest.updateByte(3'u8)
    digest.updateU32Le(getIdsetHash(self.allowedEntities.unsafeGet))
  digest.updateBool(self.dispensable)
  digest.updateBool(self.swappable)
  digest.updateBool(self.damageOnHurt)
  digest.updateBool(self.equipOnInteract)
  digest.updateBool(self.canBeSheared)
  digest.updateU32Le(getIdorHash(self.shearingSound))
  digest.finalizeI32()

proc writeData*(self: EquippableImpl): NbtTag =
  var compound = newCompound()
  compound.putString("slot", self.slot.toName())
  compound.putIdor("equip_sound", self.equipSound)
  compound.putIdor("shearing_sound", self.shearingSound)
  if self.assetId.isSome:
    compound.putString("asset_id", self.assetId.unsafeGet)
  if self.cameraOverlay.isSome:
    compound.putString("camera_overlay", self.cameraOverlay.unsafeGet)
  if self.allowedEntities.isSome:
    writeIDSet(self.allowedEntities.unsafeGet, compound, "allowed_entities", EntityTypeContent)
  compound.putBool("dispensable", self.dispensable)
  compound.putBool("swappable", self.swappable)
  compound.putBool("damage_on_hurt", self.damageOnHurt)
  compound.putBool("equip_on_interact", self.equipOnInteract)
  compound.putBool("can_be_sheared", self.canBeSheared)
  newTagCompound(compound)

proc readData*(_: typedesc[GliderImpl]; data: NbtTag): Option[GliderImpl] = some(GliderImpl())

proc writeData*(self: GliderImpl): NbtTag = newTagCompound(newCompound())

proc readData*(_: typedesc[StoredEnchantmentsImpl]; data: NbtTag): Option[StoredEnchantmentsImpl] =
  let (ok, enc) = readEnchantmentList(data)
  if ok: some(StoredEnchantmentsImpl(enchantment: enc)) else: none[StoredEnchantmentsImpl]()

proc writeData*(self: StoredEnchantmentsImpl): NbtTag = writeEnchantmentList(self.enchantment)

proc getHash*(self: StoredEnchantmentsImpl): int32 = hashEnchantmentList(self.enchantment)

func `==`*(a, b: StoredEnchantmentsImpl): bool = a.enchantment == b.enchantment

proc readData*(_: typedesc[OminousBottleAmplifierImpl]; data: NbtTag): Option[OminousBottleAmplifierImpl] =
  let amplifier = extractInt(data)
  if amplifier.isSome: some(OminousBottleAmplifierImpl(amplifier: amplifier.unsafeGet))
  else: none[OminousBottleAmplifierImpl]()

proc writeData*(self: OminousBottleAmplifierImpl): NbtTag = newTagInt(self.amplifier)

proc getHash*(self: OminousBottleAmplifierImpl): int32 = asI32(getI32Hash(self.amplifier))

proc readData*(_: typedesc[TrimImpl]; data: NbtTag): Option[TrimImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[TrimImpl]()
  let material = compoundTag(compoundOpt.unsafeGet, "material")
  let pattern = compoundTag(compoundOpt.unsafeGet, "pattern")
  if material.isNone or pattern.isNone: return none[TrimImpl]()
  some(TrimImpl(material: material.unsafeGet, pattern: pattern.unsafeGet))

proc writeData*(self: TrimImpl): NbtTag =
  var compound = newCompound()
  compound.put("material", self.material)
  compound.put("pattern", self.pattern)
  newTagCompound(compound)

proc `==`*(a, b: TrimImpl): bool =
  a.material == b.material and a.pattern == b.pattern
