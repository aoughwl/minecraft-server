## Port of pumpkin-data/src/data_component_impl/combat.rs
##
## `&'static Attributes` is the `Attribute` value, `&'static EquipmentSlot` the enum. `&'static Enchantment`
## is generated/item_refs.aowl's `EnchantmentRef`: nothing under src/generated has the full `Enchantment` yet,
## and these components only read its id and name. `IDSet<Block>` and `IDSet<EntityType>` hold registry ids.
## `AttributeModifierSlot` is generated with upstream's `Enchantment`, but this module is what needs it now,
## so it is declared here. A later `Enchantment` port should import this one.
##
## `#[derive(Hash)]`: see food.aowl.

import impl_base
import ../../nbt/tag
import ../../generated/attributes
import ../../generated/entity_type
import ../../generated/item_refs

export attributes, item_refs

type
  Operation* = enum
    opAddValue
    opAddMultipliedBase
    opAddMultipliedTotal

  AttributeModifierSlot* = enum
    amsAny
    amsMainHand
    amsOffHand
    amsHand
    amsFeet
    amsLegs
    amsChest
    amsHead
    amsArmor
    amsBody
    amsSaddle

  Modifier* = object
    attribute*: Attribute  ## Upstream's `r#type`.
    id*: string
    amount*: float64
    operation*: Operation
    slot*: AttributeModifierSlot

  AttributeModifiersImpl* = object
    attributeModifiers*: seq[Modifier]

  EnchantmentEntry* = object
    ## Upstream's `(&'static Enchantment, i32)`.
    enchantment*: EnchantmentRef
    level*: int32

  EnchantmentsImpl* = object
    enchantment*: seq[EnchantmentEntry]

  CanPlaceOnImpl* = object
    ## An adventure-mode block predicate, kept as its raw NBT (a compound or list)
    ## since upstream does not yet model block predicates.
    predicate*: NbtTag

  CanBreakImpl* = object
    predicate*: NbtTag

  RepairCostImpl* = object

  IntangibleProjectileImpl* = object

  DamageResistantType* = enum
    drtAlwaysHurtsEnderDragons
    drtAlwaysKillsArmorStands
    drtAlwaysMostSignificantFall
    drtAlwaysTriggersSilverfish
    drtAvoidsGuardianThorns
    drtBurnsArmorStands
    drtBurnFromStepping
    drtBypassesArmor
    drtBypassesCooldown
    drtBypassesEffects
    drtBypassesEnchantments
    drtBypassesInvulnerability
    drtBypassesResistance
    drtBypassesShield
    drtBypassesWolfArmor
    drtCanBreakArmorStands
    drtDamagesHelmet
    drtIgnitesArmorStands
    drtDrowning
    drtExplosion
    drtFall
    drtFire
    drtFreezing
    drtLightning
    drtPlayerAttack
    drtProjectile
    drtMaceSmash
    drtNoAnger
    drtNoImpact
    drtNoKnockback
    drtPanicCauses
    drtPanicEnvironmentalCauses
    drtWitchResistantTo
    drtWitherImmuneTo
    drtGeneric

  DamageResistantImpl* = object
    resType*: DamageResistantType

  ToolRule* = object
    blocks*: IDSet
    speed*: Option[float32]
    correctForDrops*: Option[bool]

  ToolImpl* = object
    rules*: seq[ToolRule]
    defaultMiningSpeed*: float32
    damagePerBlock*: uint32
    canDestroyBlocksInCreative*: bool

  WeaponImpl* = object
    itemDamagePerAttack*: uint32

  AttackRangeImpl* = object

  EnchantableImpl* = object
    value*: int32

  EquippableImpl* = object
    slot*: EquipmentSlot
    equipSound*: IdOr[SoundEvent]
    assetId*: Option[string]
    cameraOverlay*: Option[string]
    allowedEntities*: Option[IDSet]
    dispensable*: bool
    swappable*: bool
    damageOnHurt*: bool
    equipOnInteract*: bool
    canBeSheared*: bool
    shearingSound*: IdOr[SoundEvent]

  RepairableImpl* = object

  GliderImpl* = object

  DeathProtectionImpl* = object

  BlocksAttacksImpl* = object

  PiercingWeaponImpl* = object

  KineticWeaponImpl* = object

  SwingAnimationImpl* = object

  AdditionalTradeCostImpl* = object

  StoredEnchantmentsImpl* = object
    enchantment*: seq[EnchantmentEntry]

  OminousBottleAmplifierImpl* = object
    amplifier*: int32

  TrimImpl* = object
    ## An armor trim's material and pattern, kept as their raw NBT (each a registry
    ## id or an inline definition) since upstream does not yet model trim registries.
    material*: NbtTag
    pattern*: NbtTag

  MinimumAttackChargeImpl* = object

  DamageTypeImpl* = object

proc entityTypeFromStr(name: string): (bool, int32) =
  ## `EntityType::from_name`.
  let entity = fromName(EntityType, name)
  if entity.isSome: (true, int32(entity.unsafeGet.id)) else: (false, 0'i32)

proc entityTypeToStr(id: int32): string =
  ## `Taggable::registry_key`.
  let entity = fromRaw(EntityType, uint16(id))
  if entity.isSome: entity.unsafeGet.registryKey() else: ""

let EntityTypeContent* = IDSetContent(fromStr: entityTypeFromStr, toStr: entityTypeToStr)
  ## `impl IDSetContent for EntityType`.

func `==`*(a, b: Modifier): bool =
  a.attribute.id == b.attribute.id and a.id == b.id and a.amount == b.amount and
    a.operation == b.operation and a.slot == b.slot

func `==`*(a, b: AttributeModifiersImpl): bool = a.attributeModifiers == b.attributeModifiers

func `==`*(a, b: EnchantmentEntry): bool =
  a.enchantment.id == b.enchantment.id and a.level == b.level

proc readEnchantmentList(data: NbtTag): (bool, seq[EnchantmentEntry]) =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone:
    return (false, @[])
  let compound = compoundOpt.unsafeGet
  var enc: seq[EnchantmentEntry] = @[]
  for i in 0 ..< compound.names.len:
    let (found, enchantment) = enchantmentFromName(compound.names[i])
    let level = extractInt(compound.values[i])
    if not found or level.isNone:
      return (false, @[])
    enc.add(EnchantmentEntry(enchantment: enchantment, level: level.unsafeGet))
  (true, enc)

proc writeEnchantmentList(list: seq[EnchantmentEntry]): NbtTag =
  var data = newCompound()
  for entry in list:
    data.putInt(entry.enchantment.name, entry.level)
  newTagCompound(data)

proc hashEnchantmentList(list: seq[EnchantmentEntry]): int32 =
  var digest = newDigest()
  digest.updateByte(2'u8)
  for entry in list:
    digest.updateU32Le(getStrHash(entry.enchantment.name))
    digest.updateU32Le(getI32Hash(entry.level))
  digest.updateByte(3'u8)
  digest.finalizeI32()

proc readData*(_: typedesc[EnchantmentsImpl]; data: NbtTag): Option[EnchantmentsImpl] =
  let (ok, enc) = readEnchantmentList(data)
  if ok: some(EnchantmentsImpl(enchantment: enc)) else: none[EnchantmentsImpl]()

proc writeData*(self: EnchantmentsImpl): NbtTag = writeEnchantmentList(self.enchantment)

proc getHash*(self: EnchantmentsImpl): int32 = hashEnchantmentList(self.enchantment)

func `==`*(a, b: EnchantmentsImpl): bool = a.enchantment == b.enchantment

proc readData*(_: typedesc[CanPlaceOnImpl]; data: NbtTag): Option[CanPlaceOnImpl] =
  some(CanPlaceOnImpl(predicate: data))

proc writeData*(self: CanPlaceOnImpl): NbtTag = self.predicate

proc `==`*(a, b: CanPlaceOnImpl): bool = a.predicate == b.predicate

proc readData*(_: typedesc[CanBreakImpl]; data: NbtTag): Option[CanBreakImpl] =
  some(CanBreakImpl(predicate: data))

proc writeData*(self: CanBreakImpl): NbtTag = self.predicate

proc `==`*(a, b: CanBreakImpl): bool = a.predicate == b.predicate

proc readData*(_: typedesc[IntangibleProjectileImpl]; data: NbtTag): Option[IntangibleProjectileImpl] =
  some(IntangibleProjectileImpl())

proc writeData*(self: IntangibleProjectileImpl): NbtTag = newTagCompound(newCompound())

proc fromTag*(_: typedesc[DamageResistantType]; s: string): DamageResistantType =
  case s
  of "#minecraft:always_hurts_ender_dragons", "minecraft:always_hurts_ender_dragons", "always_hurts_ender_dragons":
    drtAlwaysHurtsEnderDragons
  of "#minecraft:always_kills_armor_stands", "minecraft:always_kills_armor_stands", "always_kills_armor_stands":
    drtAlwaysKillsArmorStands
  of "#minecraft:always_most_significant_fall", "minecraft:always_most_significant_fall", "always_most_significant_fall":
    drtAlwaysMostSignificantFall
  of "#minecraft:always_triggers_silverfish", "minecraft:always_triggers_silverfish", "always_triggers_silverfish":
    drtAlwaysTriggersSilverfish
  of "#minecraft:avoids_guardian_thorns", "minecraft:avoids_guardian_thorns", "avoids_guardian_thorns":
    drtAvoidsGuardianThorns
  of "#minecraft:burns_armor_stands", "minecraft:burns_armor_stands", "burns_armor_stands":
    drtBurnsArmorStands
  of "#minecraft:burn_from_stepping", "minecraft:burn_from_stepping", "burn_from_stepping":
    drtBurnFromStepping
  of "#minecraft:bypasses_armor", "minecraft:bypasses_armor", "bypasses_armor":
    drtBypassesArmor
  of "#minecraft:bypasses_cooldown", "minecraft:bypasses_cooldown", "bypasses_cooldown":
    drtBypassesCooldown
  of "#minecraft:bypasses_effects", "minecraft:bypasses_effects", "bypasses_effects":
    drtBypassesEffects
  of "#minecraft:bypasses_enchantments", "minecraft:bypasses_enchantments", "bypasses_enchantments":
    drtBypassesEnchantments
  of "#minecraft:bypasses_invulnerability", "minecraft:bypasses_invulnerability", "bypasses_invulnerability":
    drtBypassesInvulnerability
  of "#minecraft:bypasses_resistance", "minecraft:bypasses_resistance", "bypasses_resistance":
    drtBypassesResistance
  of "#minecraft:bypasses_shield", "minecraft:bypasses_shield", "bypasses_shield":
    drtBypassesShield
  of "#minecraft:bypasses_wolf_armor", "minecraft:bypasses_wolf_armor", "bypasses_wolf_armor":
    drtBypassesWolfArmor
  of "#minecraft:can_break_armor_stand", "minecraft:can_break_armor_stand", "can_break_armor_stand":
    drtCanBreakArmorStands
  of "#minecraft:damages_helmet", "minecraft:damages_helmet", "damages_helmet":
    drtDamagesHelmet
  of "#minecraft:ignites_armor_stands", "minecraft:ignites_armor_stands", "ignites_armor_stands":
    drtIgnitesArmorStands
  of "#minecraft:is_drowning", "minecraft:is_drowning", "is_drowning":
    drtDrowning
  of "#minecraft:is_explosion", "minecraft:is_explosion", "is_explosion", "explosion":
    drtExplosion
  of "#minecraft:is_fall", "minecraft:is_fall", "is_fall", "fall":
    drtFall
  of "#minecraft:is_fire", "minecraft:is_fire", "is_fire", "fire", "in_fire", "minecraft:in_fire":
    drtFire
  of "#minecraft:is_freezing", "minecraft:is_freezing", "is_freezing":
    drtFreezing
  of "#minecraft:is_lightning", "minecraft:is_lightning", "is_lightning":
    drtLightning
  of "#minecraft:is_player_attack", "minecraft:is_player_attack", "is_player_attack":
    drtPlayerAttack
  of "#minecraft:is_projectile", "minecraft:is_projectile", "is_projectile":
    drtProjectile
  of "#minecraft:mace_smash", "minecraft:mace_smash", "mace_smash":
    drtMaceSmash
  of "#minecraft:no_anger", "minecraft:no_anger", "no_anger":
    drtNoAnger
  of "#minecraft:no_impact", "minecraft:no_impact", "no_impact":
    drtNoImpact
  of "#minecraft:no_knockback", "minecraft:no_knockback", "no_knockback":
    drtNoKnockback
  of "#minecraft:panic_causes", "minecraft:panic_causes", "panic_causes":
    drtPanicCauses
  of "#minecraft:panic_environmental_causes", "minecraft:panic_environmental_causes", "panic_environmental_causes":
    drtPanicEnvironmentalCauses
  of "#minecraft:witch_resistant_to", "minecraft:witch_resistant_to", "witch_resistant_to":
    drtWitchResistantTo
  of "#minecraft:wither_immune_to", "minecraft:wither_immune_to", "wither_immune_to":
    drtWitherImmuneTo
  else:
    drtGeneric

