## Tests for src/data/data_component_impl/*: the `#[cfg(test)]` vectors of pumpkin-data/src/data_component_impl/mod.rs,
## then known answers for the rest of what the components do.

import std/[syncio, assertions]
import "mod"
import ../../generated/item_refs

proc tagOf(s: string): NbtTag = NbtTag(kind: ntkString, stringVal: s)

block hash:
  assert getStrHash("minecraft:sharpness") == 2734053906'u32
  assert getI32Hash(3'i32) == 3795317917'u32
  let (found, sharpness) = enchantmentFromName("minecraft:sharpness")
  assert found
  assert sharpness.id == 33'u8
  assert EnchantmentsImpl(enchantment: @[EnchantmentEntry(enchantment: sharpness, level: 2'i32)]).getHash() == -1580618251'i32
  assert MaxStackSizeImpl(size: 99'u8).getHash() == -1632321551'i32
  assert MapIdImpl(id: 10'i32).getHash() == -919192125'i32

block dyedColorRoundTrip:
  let value = DyedColorImpl(rgb: 0x00A0F0'i32)
  assert equal(toDyn(value), toDyn(readData(DyedColorImpl, value.writeData()).unsafeGet))

block baseColorRoundTrip:
  let value = BaseColorImpl(color: "light_blue")
  assert equal(toDyn(value), toDyn(readData(BaseColorImpl, value.writeData()).unsafeGet))

block noteBlockSoundRoundTrip:
  let value = NoteBlockSoundImpl(sound: "minecraft:block.note_block.pling")
  assert equal(toDyn(value), toDyn(readData(NoteBlockSoundImpl, value.writeData()).unsafeGet))

block tooltipStyleRoundTrip:
  let value = TooltipStyleImpl(id: "minecraft:my_style")
  assert equal(toDyn(value), toDyn(readData(TooltipStyleImpl, value.writeData()).unsafeGet))

block containerLootRoundTrip:
  let value = ContainerLootImpl(lootTable: "minecraft:chests/simple_dungeon", seed: 123_456_789'i64)
  let restored = readData(ContainerLootImpl, value.writeData()).unsafeGet
  assert equal(toDyn(value), toDyn(restored))
  assert restored.seed == 123_456_789'i64

block customModelDataRoundTrip:
  let value = CustomModelDataImpl(floats: @[1.5'f32, -2.0'f32], flags: @[true, false, true],
    strings: @["a", "b"], colors: @[0xFF0000'i32, 0x00FF00'i32])
  let restored = readData(CustomModelDataImpl, value.writeData()).unsafeGet
  assert equal(toDyn(value), toDyn(restored))
  assert restored.floats[1] == -2.0'f32
  assert restored.flags == @[true, false, true]
  assert restored.colors[1] == 0x00FF00'i32

block lodestoneTrackerRoundTrip:
  let value = LodestoneTrackerImpl(target: some(LodestoneTarget(dimension: "minecraft:overworld",
    x: 10'i32, y: 64'i32, z: -30'i32)), tracked: true)
  let restored = readData(LodestoneTrackerImpl, value.writeData()).unsafeGet
  assert equal(toDyn(value), toDyn(restored))
  assert restored.target.unsafeGet.z == -30'i32
  let empty = LodestoneTrackerImpl(target: none[LodestoneTarget](), tracked: false)
  assert equal(toDyn(empty), toDyn(readData(LodestoneTrackerImpl, empty.writeData()).unsafeGet))

block markerComponentsRoundTrip:
  assert readData(GliderImpl, writeData(GliderImpl())).isSome
  assert readData(IntangibleProjectileImpl, writeData(IntangibleProjectileImpl())).isSome
  assert equal(toDyn(GliderImpl()), toDyn(GliderImpl()))
  assert equal(toDyn(IntangibleProjectileImpl()), toDyn(IntangibleProjectileImpl()))

block rawNbtComponentsRoundTrip:
  var material = newCompound()
  material.putString("material", "minecraft:diamond")
  material.putString("pattern", "minecraft:coast")
  let trim = readData(TrimImpl, NbtTag(kind: ntkCompound, compoundVal: material)).unsafeGet
  assert equal(toDyn(trim), toDyn(readData(TrimImpl, trim.writeData()).unsafeGet))

  var predicate = newCompound()
  predicate.putString("blocks", "minecraft:stone")
  let canPlace = CanPlaceOnImpl(predicate: NbtTag(kind: ntkCompound, compoundVal: predicate))
  assert equal(toDyn(canPlace), toDyn(readData(CanPlaceOnImpl, canPlace.writeData()).unsafeGet))
  let lock = LockImpl(predicate: predicate)
  assert equal(toDyn(lock), toDyn(readData(LockImpl, lock.writeData()).unsafeGet))

# --- Past upstream's own vectors --------------------------------------------------------

block dispatch:
  # The dynamic procs answer what the typed ones do, and a default component answers the trait default.
  let value = toDyn(MapIdImpl(id: 10'i32))
  assert value.getSelfEnum() == dcMapId
  assert getEnum(MapIdImpl) == dcMapId
  assert value.getHash() == -919192125'i32
  assert value.writeData().intVal == 10'i32
  assert get(value, MapIdImpl).id == 10'i32
  assert toDyn(LoreImpl()).writeData().kind == ntkEnd
  assert toDyn(LoreImpl()).getHash() == 0'i32
  assert toDyn(ChickenVariantImpl(value: "minecraft:warm")).getHash() == asI32(getStrHash("minecraft:warm"))
  assert get(toDyn(ChickenVariantImpl(value: "minecraft:warm")), ChickenVariantImpl).value == "minecraft:warm"
  assert toDyn(ChickenVariantImpl(value: "minecraft:warm")).writeData().stringVal == "minecraft:warm"

block alwaysUnequal:
  # Upstream's `PartialEq` for these two answers false even against itself.
  assert not equal(toDyn(BundleContentsImpl(items: @[])), toDyn(BundleContentsImpl(items: @[])))
  assert not equal(toDyn(ContainerImpl(items: @[])), toDyn(ContainerImpl(items: @[])))

block blockStateIgnoresOrder:
  let a = BlockStateImpl(properties: @[("a", "1"), ("b", "2")])
  let b = BlockStateImpl(properties: @[("b", "2"), ("a", "1")])
  assert a == b
  assert a.getHash() == b.getHash()
  var digest = newDigest()
  digest.updateStr("a1b2")
  assert a.getHash() == digest.finalizeI32()

block equipmentSlot:
  assert getEntitySlotId(esChest) == 2'i32
  assert getSlotIndex(esOffHand) == 5'i32
  assert slotType(esBody) == etAnimalArmor
  assert isArmorSlot(esHead)
  assert not isArmorSlot(esSaddle)
  assert discriminant(esHead) == 5'i8
  assert toName(esMainHand) == "mainhand"
  assert getFromName(EquipmentSlot, "feet") == (true, esFeet)
  assert not getFromName(EquipmentSlot, "nope")[0]
  assert fromSlotIndex(7'i32) == (true, esSaddle)
  assert not fromSlotIndex(8'i32)[0]
  assert getOffsetEntitySlotId(esHead, 100'i32) == 103'i32

block idorAndIdset:
  var c = newCompound()
  c.putIdor("sound", idOrSound(sdEntityGenericEat))
  assert c.getString("sound").unsafeGet == "minecraft:entity.generic.eat"
  assert getIdor(c, "sound", sdItemShearsSnip) == idOrSound(sdEntityGenericEat)
  assert getIdor(c, "absent", sdItemShearsSnip) == idOrSound(sdItemShearsSnip)
  var custom = newCompound()
  custom.putIdor("s", IdOr[SoundEvent](kind: iokValue, value: newSoundEvent("x:y", some(2.5'f32))))
  let read = getIdor(custom, "s", sdItemShearsSnip)
  assert read.kind == iokValue
  assert read.value.soundName == "x:y"
  assert read.value.range.unsafeGet == 2.5'f32

  let viaTag = readIDSet(tagOf("#minecraft:skeletons"), EntityTypeContent).unsafeGet
  assert viaTag.kind == idsTag
  assert viaTag.tag == "minecraft:skeletons"
  let wolf = readIDSet(tagOf("minecraft:wolf"), EntityTypeContent).unsafeGet
  assert wolf.kind == idsIds
  assert wolf.ids == @[149'i32]
  assert not readIDSet(tagOf("minecraft:no_such_entity"), EntityTypeContent).isSome
  var out0 = newCompound()
  writeIDSet(wolf, out0, "e", EntityTypeContent)
  assert out0.getList("e").unsafeGet[0].stringVal == "wolf"
  let poison = readIDSet(tagOf("minecraft:poison"), StatusEffectContent).unsafeGet
  assert poison.ids.len == 1
  assert statusEffectMinecraftName(uint8(poison.ids[0])) == "minecraft:poison"

block damageResistant:
  assert fromTag(DamageResistantType, "#minecraft:is_fire") == drtFire
  assert fromTag(DamageResistantType, "in_fire") == drtFire
  assert fromTag(DamageResistantType, "minecraft:can_break_armor_stand") == drtCanBreakArmorStands
  assert fromTag(DamageResistantType, "anything else") == drtGeneric
  assert asStr(drtFire) == "#minecraft:is_fire"
  assert asStr(drtGeneric) == "minecraft:generic"
  let value = DamageResistantImpl(resType: drtFire)
  assert readData(DamageResistantImpl, value.writeData()).unsafeGet.resType == drtFire
  assert value.getHash() == asI32(getStrHash("#minecraft:is_fire"))

block consumable:
  let inst = StatusEffectInstance(effectId: "minecraft:regeneration", amplifier: 1'i32, duration: 100'i32,
    ambient: false, showParticles: true, showIcon: true)
  let value = ConsumableImpl(consumeSeconds: 1.6'f32, animation: caDrink, soundEvent: idOrSound(sdEntityGenericEat),
    consumeParticles: true, effects: @[
      ConsumeEffect(kind: ceApplyEffects, effects: @[inst], probability: 0.5'f32),
      ConsumeEffect(kind: ceClearAllEffects),
      ConsumeEffect(kind: ceTeleportRandomly, diameter: 16.0'f32),
      ConsumeEffect(kind: cePlaySound, sound: idOrSound(sdEntityGenericEat))])
  assert value.consumeTicks() == 32'i32
  let restored = readData(ConsumableImpl, value.writeData()).unsafeGet
  assert restored == value
  assert restored.getHash() == value.getHash()
  assert value.effects[0].registryId() == 0'u8
  assert value.effects[3].toStr() == "play_sound"
  assert parseConsumeAnimation("spear") == (true, caSpear)
  assert not parseConsumeAnimation("nope")[0]
  assert tryFromI32(ConsumeAnimation, 9'i32) == (true, caBrush)

block useCooldownAndPotion:
  let cooldown = UseCooldownImpl(seconds: 1.0'f32, cooldownGroup: some("minecraft:ender_pearl"))
  assert readData(UseCooldownImpl, cooldown.writeData()).unsafeGet == cooldown
  var potion = newCompound()
  potion.putString("potion", "minecraft:swiftness")
  potion.putInt("custom_color", 7'i32)
  var effect = newCompound()
  effect.putString("id", "minecraft:speed")
  effect.putByte("amplifier", 2'i8)
  potion.putList("custom_effects", @[NbtTag(kind: ntkCompound, compoundVal: effect)])
  let contents = readData(PotionContentsImpl, NbtTag(kind: ntkCompound, compoundVal: potion)).unsafeGet
  assert contents.potionId.unsafeGet == 13'i32
  assert contents.customColor.unsafeGet == 7'i32
  assert contents.customEffects[0].amplifier == 2'i32
  assert contents.customEffects[0].showIcon
  assert readData(PotionContentsImpl, contents.writeData()).unsafeGet == contents

block fireworksAndProfile:
  let explosion = FireworkExplosionImpl(shape: fesStar, colors: @[1'i32, 2'i32], fadeColors: @[3'i32],
    hasTrail: true, hasTwinkle: false)
  let fireworks = FireworksImpl(flightDuration: 2'i32, explosions: @[explosion])
  let restored = readData(FireworksImpl, fireworks.writeData()).unsafeGet
  assert restored == fireworks
  assert restored.getHash() == fireworks.getHash()
  assert fromName(FireworkExplosionShape, "burst") == (true, fesBurst)
  let profile = readData(ProfileImpl, tagOf("Notch")).unsafeGet
  assert profile.name.unsafeGet == "Notch"
  assert readData(ProfileImpl, profile.writeData()).unsafeGet == profile
  let full = ProfileImpl(name: some("a"), id: some([1'i32, 2'i32, 3'i32, 4'i32]),
    properties: @[ProfileProperty(name: "textures", value: "v", signature: some("s"))],
    texture: some("t"), cape: none[string](), elytra: none[string](), model: some("slim"))
  assert readData(ProfileImpl, full.writeData()).unsafeGet == full
  assert toDyn(full).getHash() == full.getHash()

block books:
  var book = newCompound()
  book.putList("pages", @[tagOf("x"), tagOf("y")])
  # As upstream, the page text is not kept.
  assert readData(WrittenBookContentImpl, NbtTag(kind: ntkCompound, compoundVal: book)).unsafeGet.pages == @["", ""]
  assert readData(WritableBookContentImpl, tagOf("not a compound")).unsafeGet.pages.len == 0

echo "data_component_impl tests passed"
