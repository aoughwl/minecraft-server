## Port of pumpkin-data/src/data_component_impl/entity_variant.rs
##
## Upstream's `string_variant!` declares 29 types with one field and one body. Here each stays a type of
## its own, since `get_data_component::<T>` keys on it, and the bodies are the three shared procs below.

import impl_base
import ../../nbt/tag

type
  VillagerVariantImpl* = object
    value*: string
  WolfVariantImpl* = object
    value*: string
  WolfSoundVariantImpl* = object
    value*: string
  WolfCollarImpl* = object
    value*: string
  FoxVariantImpl* = object
    value*: string
  SalmonSizeImpl* = object
    value*: string
  ParrotVariantImpl* = object
    value*: string
  TropicalFishPatternImpl* = object
    value*: string
  TropicalFishBaseColorImpl* = object
    value*: string
  TropicalFishPatternColorImpl* = object
    value*: string
  MooshroomVariantImpl* = object
    value*: string
  RabbitVariantImpl* = object
    value*: string
  PigVariantImpl* = object
    value*: string
  PigSoundVariantImpl* = object
    value*: string
  CowVariantImpl* = object
    value*: string
  CowSoundVariantImpl* = object
    value*: string
  ChickenVariantImpl* = object
    value*: string
  ChickenSoundVariantImpl* = object
    value*: string
  ZombieNautilusVariantImpl* = object
    value*: string
  FrogVariantImpl* = object
    value*: string
  HorseVariantImpl* = object
    value*: string
  PaintingVariantImpl* = object
    value*: string
  LlamaVariantImpl* = object
    value*: string
  AxolotlVariantImpl* = object
    value*: string
  CatVariantImpl* = object
    value*: string
  CatSoundVariantImpl* = object
    value*: string
  CatCollarImpl* = object
    value*: string
  SheepColorImpl* = object
    value*: string
  ShulkerColorImpl* = object
    value*: string

proc readStringVariant*(data: NbtTag): Option[string] =
  ## `read_data` of every `string_variant!` type.
  extractString(data)

proc writeStringVariant*(value: string): NbtTag =
  ## `write_data` of every `string_variant!` type.
  newTagStr(value)

proc getStringVariantHash*(value: string): int32 =
  ## `get_hash` of every `string_variant!` type.
  asI32(getStrHash(value))
