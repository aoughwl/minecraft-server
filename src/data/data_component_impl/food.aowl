## Port of pumpkin-data/src/data_component_impl/food.rs
## PARTIAL: pumpkin-data/src/data_component_impl/food.rs - `UseCooldownImpl`'s serde derives and the `Hash` impls are not ported.
##
## `#[derive(Hash)]` and the hand-written `Hash` impls are not ported: `DataComponentImpl` is not `Hash`
## and no upstream code keys a map on a component. `get_hash` is the one the wire uses, and is here.

import impl_base
import ../../nbt/tag
import ../../generated/item_refs

type
  FoodImpl* = object
    nutrition*: int32
    saturation*: float32
    canAlwaysEat*: bool

  StatusEffectInstance* = object
    effectId*: string
    amplifier*: int32
    duration*: int32
    ambient*: bool
    showParticles*: bool
    showIcon*: bool

  ConsumeAnimation* = enum
    # The declaration order is the wire id.
    caNone, caEat, caDrink, caBlock, caBow, caSpear, caCrossbow, caSpyglass, caHorn, caBrush

  ConsumeEffectKind* = enum
    # The declaration order is `registry_id`.
    ceApplyEffects
    ceRemoveEffects
    ceClearAllEffects
    ceTeleportRandomly
    cePlaySound

  ConsumeEffect* = object
    case kind*: ConsumeEffectKind
    of ceApplyEffects:
      effects*: seq[StatusEffectInstance]
      probability*: float32
    of ceRemoveEffects:
      removed*: IDSet
    of ceClearAllEffects:
      discard
    of ceTeleportRandomly:
      diameter*: float32
    of cePlaySound:
      sound*: IdOr[SoundEvent]

  ConsumableImpl* = object
    consumeSeconds*: float32
    animation*: ConsumeAnimation
    soundEvent*: IdOr[SoundEvent]
    consumeParticles*: bool
    effects*: seq[ConsumeEffect]

  UseEffectsImpl* = object

  UseRemainderImpl* = object

  UseCooldownImpl* = object
    seconds*: float32
    cooldownGroup*: Option[string]

  PotionContentsImpl* = object
    potionId*: Option[int32]
    customColor*: Option[int32]
    customEffects*: seq[StatusEffectInstance]
    customName*: Option[string]

  PotionDurationScaleImpl* = object

  SuspiciousStewEffectsImpl* = object

proc statusEffectFromStr(name: string): (bool, int32) =
  let (found, id) = statusEffectIdFromMinecraftName(name)
  (found, int32(id))

proc statusEffectToStr(id: int32): string =
  statusEffectMinecraftName(uint8(id))

let StatusEffectContent* = IDSetContent(fromStr: statusEffectFromStr, toStr: statusEffectToStr)
  ## `impl IDSetContent for StatusEffect`.

func `==`*(a, b: FoodImpl): bool =
  a.nutrition == b.nutrition and a.saturation == b.saturation and a.canAlwaysEat == b.canAlwaysEat

func `==`*(a, b: StatusEffectInstance): bool =
  a.effectId == b.effectId and a.amplifier == b.amplifier and a.duration == b.duration and
    a.ambient == b.ambient and a.showParticles == b.showParticles and a.showIcon == b.showIcon

proc readData*(_: typedesc[StatusEffectInstance]; nbt: NbtTag): Option[StatusEffectInstance] =
  let compoundOpt = extractCompound(nbt)
  if compoundOpt.isNone: return none[StatusEffectInstance]()
  let compound = compoundOpt.unsafeGet
  let effectId = getString(compound, "id")
  let amplifier = getInt(compound, "amplifier")
  let duration = getInt(compound, "duration")
  let ambient = getBool(compound, "ambient")
  let showParticles = getBool(compound, "show_particles")
  let showIcon = getBool(compound, "show_icon")
  if effectId.isNone or amplifier.isNone or duration.isNone or ambient.isNone or
      showParticles.isNone or showIcon.isNone:
    return none[StatusEffectInstance]()
  some(StatusEffectInstance(effectId: effectId.unsafeGet, amplifier: amplifier.unsafeGet,
    duration: duration.unsafeGet, ambient: ambient.unsafeGet, showParticles: showParticles.unsafeGet,
    showIcon: showIcon.unsafeGet))

proc asNbt*(self: StatusEffectInstance): NbtTag =
  var compound = newCompound()
  compound.putString("id", self.effectId)
  compound.putInt("amplifier", self.amplifier)
  compound.putInt("duration", self.duration)
  compound.putBool("ambient", self.ambient)
  compound.putBool("show_particles", self.showParticles)
  compound.putBool("show_icon", self.showIcon)
  newTagCompound(compound)

proc getHash*(self: StatusEffectInstance): int32 =
  var digest = newDigest()
  digest.updateU32Le(getStrHash(self.effectId))
  digest.updateU32Le(getI32Hash(self.amplifier))
  digest.updateU32Le(getI32Hash(self.duration))
  digest.updateBool(self.ambient)
  digest.updateBool(self.showParticles)
  digest.updateBool(self.showIcon)
  digest.finalizeI32()

proc toStr*(self: ConsumeAnimation): string =
  case self
  of caNone: "none"
  of caEat: "eat"
  of caDrink: "drink"
  of caBlock: "block"
  of caBow: "bow"
  of caSpear: "spear"
  of caCrossbow: "crossbow"
  of caSpyglass: "spyglass"
  of caHorn: "horn"
  of caBrush: "brush"

proc tryFromI32*(_: typedesc[ConsumeAnimation]; value: int32): (bool, ConsumeAnimation) =
  ## `TryFrom<i32>`.
  if value >= 0'i32 and value <= 9'i32: (true, ConsumeAnimation(value)) else: (false, caNone)

proc parseConsumeAnimation*(s: string): (bool, ConsumeAnimation) =
  ## `FromStr`.
  case s
  of "none": (true, caNone)
  of "eat": (true, caEat)
  of "drink": (true, caDrink)
  of "block": (true, caBlock)
  of "bow": (true, caBow)
  of "spear": (true, caSpear)
  of "crossbow": (true, caCrossbow)
  of "spyglass": (true, caSpyglass)
  of "horn": (true, caHorn)
  of "brush": (true, caBrush)
  else: (false, caNone)

func `==`*(a, b: ConsumeEffect): bool =
  if a.kind != b.kind: return false
  case a.kind
  of ceApplyEffects: a.effects == b.effects and a.probability == b.probability
  of ceRemoveEffects: a.removed == b.removed
  of ceClearAllEffects: true
  of ceTeleportRandomly: a.diameter == b.diameter
  of cePlaySound: a.sound == b.sound

proc toStr*(self: ConsumeEffect): string =
  case self.kind
  of ceApplyEffects: "apply_effects"
  of ceRemoveEffects: "remove_effects"
  of ceClearAllEffects: "clear_all_effects"
  of ceTeleportRandomly: "teleport_randomly"
  of cePlaySound: "play_sound"

proc registryId*(self: ConsumeEffect): uint8 {.inline.} = uint8(ord(self.kind))

proc readData*(_: typedesc[ConsumeEffect]; nbt: NbtTag): Option[ConsumeEffect] =
  let compoundOpt = extractCompound(nbt)
  if compoundOpt.isNone: return none[ConsumeEffect]()
  let compound = compoundOpt.unsafeGet
  let kindStr = getString(compound, "type")
  if kindStr.isNone: return none[ConsumeEffect]()
  case kindStr.unsafeGet
  of "remove_effects":
    let effects = compoundTag(compound, "effects")
    if effects.isNone: return none[ConsumeEffect]()
    let idset = readIDSet(effects.unsafeGet, StatusEffectContent)
    if idset.isNone: return none[ConsumeEffect]()
    some(ConsumeEffect(kind: ceRemoveEffects, removed: idset.unsafeGet))
  of "clear_all_effects":
    some(ConsumeEffect(kind: ceClearAllEffects))
  of "teleport_randomly":
    let dst = getFloat(compound, "diameter")
    if dst.isNone: return none[ConsumeEffect]()
    some(ConsumeEffect(kind: ceTeleportRandomly, diameter: dst.unsafeGet))
  of "play_sound":
    some(ConsumeEffect(kind: cePlaySound, sound: getIdor(compound, "sound", sdEntityGenericEat)))
  of "apply_effects":
    let probability = getFloat(compound, "probability")
    if probability.isNone: return none[ConsumeEffect]()
    let list = getList(compound, "effects")
    if list.isNone: return none[ConsumeEffect]()
    var effects: seq[StatusEffectInstance] = @[]
    for t in list.unsafeGet:
      let effect = readData(StatusEffectInstance, t)
      if effect.isSome:
        effects.add(effect.unsafeGet)
    some(ConsumeEffect(kind: ceApplyEffects, effects: effects, probability: probability.unsafeGet))
  else:
    none[ConsumeEffect]()

proc asNbt*(self: ConsumeEffect): NbtTag =
  var compound = newCompound()
  compound.putString("type", self.toStr())
  case self.kind
  of ceApplyEffects:
    var nbtArr: seq[NbtTag] = @[]
    for x in self.effects:
      nbtArr.add(x.asNbt())
    compound.putList("effects", nbtArr)
    compound.putFloat("probability", self.probability)
  of ceRemoveEffects:
    writeIDSet(self.removed, compound, "effects", StatusEffectContent)
  of ceClearAllEffects:
    discard
  of ceTeleportRandomly:
    compound.putFloat("diameter", self.diameter)
  of cePlaySound:
    compound.putIdor("sound", self.sound)
  newTagCompound(compound)

proc getHash*(self: ConsumeEffect): int32 =
  var digest = newDigest()
  case self.kind
  of ceApplyEffects:
    digest.updateByte(1'u8)
    for effect in self.effects:
      digest.updateI32Le(effect.getHash())
    digest.updateByte(13'u8)
    digest.updateU32Le(getF32Hash(self.probability))
  of ceRemoveEffects:
    digest.updateByte(2'u8)
    digest.updateU32Le(getIdsetHash(self.removed))
  of ceClearAllEffects:
    digest.updateByte(3'u8)
  of ceTeleportRandomly:
    digest.updateByte(4'u8)
    digest.updateU32Le(getF32Hash(self.diameter))
  of cePlaySound:
    digest.updateByte(5'u8)
    digest.updateU32Le(getIdorHash(self.sound))
  digest.finalizeI32()

func `==`*(a, b: ConsumableImpl): bool =
  a.consumeSeconds == b.consumeSeconds and a.animation == b.animation and a.soundEvent == b.soundEvent and
    a.consumeParticles == b.consumeParticles and a.effects == b.effects

proc newConsumableImpl*(consumeSeconds: float32; animation: ConsumeAnimation; soundEvent: IdOr[SoundEvent];
    consumeParticles: bool; effects: seq[ConsumeEffect]): ConsumableImpl =
  ConsumableImpl(consumeSeconds: consumeSeconds, animation: animation, soundEvent: soundEvent,
    consumeParticles: consumeParticles, effects: effects)

proc consumeTicks*(self: ConsumableImpl): int32 =
  # `as i32`: a float to int cast in Rust saturates, and these values never reach the ends.
  int32(self.consumeSeconds * 20.0'f32)

proc readData*(_: typedesc[ConsumableImpl]; data: NbtTag): Option[ConsumableImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[ConsumableImpl]()
  let compound = compoundOpt.unsafeGet
  let consumeSeconds = getFloat(compound, "consume_seconds")
  if consumeSeconds.isNone: return none[ConsumableImpl]()
  let animationStr = getString(compound, "animation")
  if animationStr.isNone: return none[ConsumableImpl]()
  let (known, animation) = parseConsumeAnimation(animationStr.unsafeGet)
  if not known: return none[ConsumableImpl]()
  let soundEvent = getIdor(compound, "sound", sdEntityGenericEat)
  let consumeParticles = getBool(compound, "has_consume_particles")
  var effects: seq[ConsumeEffect] = @[]
  let effectList = getList(compound, "on_consume_effects")
  if effectList.isSome:
    for t in effectList.unsafeGet:
      let effect = readData(ConsumeEffect, t)
      if effect.isSome:
        effects.add(effect.unsafeGet)
  some(ConsumableImpl(consumeSeconds: consumeSeconds.unsafeGet, animation: animation, soundEvent: soundEvent,
    consumeParticles: (if consumeParticles.isSome: consumeParticles.unsafeGet else: false), effects: effects))

proc writeData*(self: ConsumableImpl): NbtTag =
  var compound = newCompound()
  compound.putFloat("consume_seconds", self.consumeSeconds)
  compound.putString("animation", self.animation.toStr())
  compound.putIdor("sound", self.soundEvent)
  compound.putBool("has_consume_particles", self.consumeParticles)
  var nbtVec: seq[NbtTag] = @[]
  for x in self.effects:
    nbtVec.add(x.asNbt())
  compound.putList("on_consume_effects", nbtVec)
  newTagCompound(compound)

proc getHash*(self: ConsumableImpl): int32 =
  var digest = newDigest()
  digest.updateByte(2'u8)
  digest.updateU32Le(getF32Hash(self.consumeSeconds))
  digest.updateU32Le(getI32Hash(int32(ord(self.animation))))
  # Big-endian, as upstream has it.
  digest.updateU32Be(getIdorHash(self.soundEvent))
  digest.updateBool(self.consumeParticles)
  for effect in self.effects:
    digest.updateI32Le(effect.getHash())
  digest.updateByte(3'u8)
  digest.finalizeI32()

proc newUseCooldownImpl*(seconds: float32; cooldownGroup: Option[string]): UseCooldownImpl =
  UseCooldownImpl(seconds: seconds, cooldownGroup: cooldownGroup)

proc readData*(_: typedesc[UseCooldownImpl]; data: NbtTag): Option[UseCooldownImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[UseCooldownImpl]()
  let seconds = getFloat(compoundOpt.unsafeGet, "seconds")
  if seconds.isNone: return none[UseCooldownImpl]()
  some(UseCooldownImpl(seconds: seconds.unsafeGet, cooldownGroup: getString(compoundOpt.unsafeGet, "cooldown_group")))

proc writeData*(self: UseCooldownImpl): NbtTag =
  var compound = newCompound()
  compound.putFloat("seconds", self.seconds)
  if self.cooldownGroup.isSome:
    compound.putString("cooldown_group", self.cooldownGroup.unsafeGet)
  newTagCompound(compound)

proc getHash*(self: UseCooldownImpl): int32 =
  var digest = newDigest()
  digest.updateU32Le(getF32Hash(self.seconds))
  if self.cooldownGroup.isSome:
    digest.updateU32Le(getStrHash(self.cooldownGroup.unsafeGet))
  digest.finalizeI32()

func `==`*(a, b: UseCooldownImpl): bool =
  a.seconds == b.seconds and a.cooldownGroup == b.cooldownGroup

func `==`*(a, b: PotionContentsImpl): bool =
  a.potionId == b.potionId and a.customColor == b.customColor and a.customEffects == b.customEffects and
    a.customName == b.customName

proc readData*(_: typedesc[PotionContentsImpl]; tag: NbtTag): Option[PotionContentsImpl] =
  let compoundOpt = extractCompound(tag)
  if compoundOpt.isNone: return none[PotionContentsImpl]()
  let compound = compoundOpt.unsafeGet
  var potionId = getInt(compound, "potion")
  if potionId.isNone:
    let name = getString(compound, "potion")
    if name.isSome:
      let (found, id) = potionIdFromName(stripMinecraft(name.unsafeGet))
      if found:
        potionId = some(int32(id))
  var customEffects: seq[StatusEffectInstance] = @[]
  let list = getList(compound, "custom_effects")
  if list.isSome:
    for item in list.unsafeGet:
      let effectTagOpt = extractCompound(item)
      if effectTagOpt.isNone: continue
      let effectTag = effectTagOpt.unsafeGet
      let id = getString(effectTag, "id")
      if id.isNone: continue
      var amplifier = getInt(effectTag, "amplifier")
      if amplifier.isNone:
        let b = getByte(effectTag, "amplifier")
        if b.isSome: amplifier = some(int32(b.unsafeGet))
      var duration = getInt(effectTag, "duration")
      if duration.isNone:
        let b = getByte(effectTag, "duration")
        if b.isSome: duration = some(int32(b.unsafeGet))
      let ambient = getBool(effectTag, "ambient")
      let showParticles = getBool(effectTag, "show_particles")
      let showIcon = getBool(effectTag, "show_icon")
      customEffects.add(StatusEffectInstance(effectId: id.unsafeGet,
        amplifier: (if amplifier.isSome: amplifier.unsafeGet else: 0'i32),
        duration: (if duration.isSome: duration.unsafeGet else: 0'i32),
        ambient: (if ambient.isSome: ambient.unsafeGet else: false),
        showParticles: (if showParticles.isSome: showParticles.unsafeGet else: true),
        showIcon: (if showIcon.isSome: showIcon.unsafeGet else: true)))
  some(PotionContentsImpl(potionId: potionId, customColor: getInt(compound, "custom_color"),
    customEffects: customEffects, customName: getString(compound, "custom_name")))

proc writeData*(self: PotionContentsImpl): NbtTag =
  var compound = newCompound()
  if self.potionId.isSome:
    compound.putInt("potion", self.potionId.unsafeGet)
  if self.customColor.isSome:
    compound.putInt("custom_color", self.customColor.unsafeGet)
  if self.customEffects.len > 0:
    var effectsList: seq[NbtTag] = @[]
    for effect in self.customEffects:
      var effectCompound = newCompound()
      effectCompound.putString("id", effect.effectId)
      effectCompound.putInt("amplifier", effect.amplifier)
      effectCompound.putInt("duration", effect.duration)
      effectCompound.putBool("ambient", effect.ambient)
      effectCompound.putBool("show_particles", effect.showParticles)
      effectCompound.putBool("show_icon", effect.showIcon)
      effectsList.add(newTagCompound(effectCompound))
    compound.put("custom_effects", newTagList(effectsList))
  if self.customName.isSome:
    compound.putString("custom_name", self.customName.unsafeGet)
  newTagCompound(compound)

proc getHash*(self: PotionContentsImpl): int32 =
  var digest = newDigest()
  if self.potionId.isSome:
    digest.updateByte(1'u8)
    digest.updateU32Le(getI32Hash(self.potionId.unsafeGet))
  if self.customColor.isSome:
    digest.updateByte(2'u8)
    digest.updateU32Le(getI32Hash(self.customColor.unsafeGet))
  if self.customName.isSome:
    digest.updateByte(3'u8)
    digest.updateU32Le(getStrHash(self.customName.unsafeGet))
  if self.customEffects.len > 0:
    digest.updateByte(4'u8)
    for effect in self.customEffects:
      digest.updateI32Le(effect.getHash())
  digest.finalizeI32()
