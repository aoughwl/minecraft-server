## The leaf half of pumpkin-data/src/data_component_impl/mod.rs: hash helpers, `IDSet`, `IdOr`,
## `EquipmentSlot`, `EntityTypeOrTag`, plus `SoundEvent` from basic.rs because `get_idor_hash` needs it.
##
## Rust's mod.rs and its submodules import each other; aowlmony modules cannot form a cycle. So this
## file is what basic.aowl, combat.aowl and the rest stand on, and mod.aowl (the dispatch) stands on them.
##
## `IDSetContent` is an object of procs, passed to `readIDSet`/`writeIDSet`. `IDSet<T>` carries its
## entries as registry ids, the same shape src/protocol/datacomponent.aowl uses.

import std/options
import ../../generated/sound
import ../../nbt/tag

export options, tag, sound

# --- Small NbtTag builders ---------------------------------------------------------

proc compoundTag*(c: NbtCompound; name: string): Option[NbtTag] =
  ## `NbtCompound::get`, as an `Option`.
  let (found, t) = c.get(name)
  if found: some(t) else: none[NbtTag]()

proc newTagInt*(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)
proc newTagStr*(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)
proc newTagCompound*(c: NbtCompound): NbtTag = NbtTag(kind: ntkCompound, compoundVal: c)
proc newTagList*(l: seq[NbtTag]): NbtTag = NbtTag(kind: ntkList, listVal: l)

# --- Digest, for `crc_fast::Digest::new(Crc32Iscsi)` ------------------------------

proc makeCrcTable(): seq[uint32] =
  result = newSeq[uint32](256)
  for i in 0 ..< 256:
    var c = uint32(i)
    for k in 0 ..< 8:
      if (c and 1'u32) != 0'u32:
        c = (c shr 1) xor 0x82F63B78'u32
      else:
        c = c shr 1
    result[i] = c

let CrcTable = makeCrcTable()

type
  Digest* = object
    ## CRC-32C, the algorithm vanilla's component hashes use.
    crc: uint32

proc newDigest*(): Digest = Digest(crc: 0xFFFFFFFF'u32)

proc updateByte*(d: var Digest; b: uint8) =
  d.crc = CrcTable[int((d.crc xor uint32(b)) and 0xFF'u32)] xor (d.crc shr 8)

proc updateU32Le*(d: var Digest; v: uint32) =
  ## `digest.update(&v.to_le_bytes())`.
  d.updateByte(uint8(v and 0xFF'u32))
  d.updateByte(uint8((v shr 8) and 0xFF'u32))
  d.updateByte(uint8((v shr 16) and 0xFF'u32))
  d.updateByte(uint8((v shr 24) and 0xFF'u32))

proc updateU32Be*(d: var Digest; v: uint32) =
  d.updateByte(uint8((v shr 24) and 0xFF'u32))
  d.updateByte(uint8((v shr 16) and 0xFF'u32))
  d.updateByte(uint8((v shr 8) and 0xFF'u32))
  d.updateByte(uint8(v and 0xFF'u32))

proc updateI32Le*(d: var Digest; v: int32) = d.updateU32Le(cast[uint32](v))

proc updateBool*(d: var Digest; v: bool) =
  ## `digest.update(&[v as u8])`.
  d.updateByte(if v: 1'u8 else: 0'u8)

proc updateStr*(d: var Digest; s: string) =
  ## `digest.update(s.as_bytes())`.
  for ch in s:
    d.updateByte(uint8(ord(ch)))

proc finalize*(d: Digest): uint32 = d.crc xor 0xFFFFFFFF'u32

proc finalizeI32*(d: Digest): int32 = cast[int32](d.finalize())

proc asI32*(v: uint32): int32 {.inline.} =
  ## `v as i32`.
  cast[int32](v)

# --- get_*_hash -------------------------------------------------------------------

proc getStrHash*(val: string): uint32 =
  var digest = newDigest()
  digest.updateByte(12'u8)
  digest.updateU32Le(uint32(val.len))
  for ch in val:
    digest.updateByte(uint8(ord(ch)))
    digest.updateByte(0'u8)
  digest.finalize()

proc getI32Hash*(val: int32): uint32 =
  var digest = newDigest()
  digest.updateByte(8'u8)
  digest.updateI32Le(val)
  digest.finalize()

proc getF32Hash*(val: float32): uint32 =
  var digest = newDigest()
  digest.updateByte(7'u8)
  digest.updateU32Le(cast[uint32](val))
  digest.finalize()

# --- SoundEvent (basic.rs) and IdOr ------------------------------------------------

type
  SoundEvent* = object
    soundName*: string
    range*: Option[float32]

  IdOrKind* = enum
    iokId
    iokValue

  IdOr*[T] = object
    ## Upstream `IdOr<T>`. `Id` holds the `Sound` itself, not a raw id.
    case kind*: IdOrKind
    of iokId: id*: Sound
    of iokValue: value*: T

proc newSoundEvent*(soundName: string; range: Option[float32]): SoundEvent =
  SoundEvent(soundName: soundName, range: range)

proc idOrSound*(sound: Sound): IdOr[SoundEvent] =
  ## `IdOr::Id(sound)`.
  IdOr[SoundEvent](kind: iokId, id: sound)

func `==`*(a, b: SoundEvent): bool =
  a.soundName == b.soundName and a.range == b.range

func `==`*(a, b: IdOr[SoundEvent]): bool =
  if a.kind != b.kind: return false
  case a.kind
  of iokId: a.id == b.id
  of iokValue: a.value == b.value

proc getIdorHash*(val: IdOr[SoundEvent]): uint32 =
  var digest = newDigest()
  digest.updateByte(6'u8)
  case val.kind
  of iokId:
    digest.updateByte(1'u8)
    digest.updateU32Le(getStrHash(toName(val.id)))
  of iokValue:
    digest.updateByte(2'u8)
    digest.updateU32Le(getStrHash(val.value.soundName))
    if val.value.range.isSome:
      digest.updateByte(1'u8)
      digest.updateU32Le(getF32Hash(val.value.range.unsafeGet))
    else:
      digest.updateByte(0'u8)
  digest.finalize()

proc putIdor*(nbt: var NbtCompound; key: string; val: IdOr[SoundEvent]) =
  case val.kind
  of iokId:
    nbt.putString(key, "minecraft:" & toName(val.id))
  of iokValue:
    var soundCompound = newCompound()
    soundCompound.putString("sound_id", val.value.soundName)
    if val.value.range.isSome:
      soundCompound.putFloat("range", val.value.range.unsafeGet)
    nbt.put(key, newTagCompound(soundCompound))

proc stripMinecraft*(s: string): string =
  ## `s.strip_prefix("minecraft:").unwrap_or(s)`.
  const Prefix = "minecraft:"
  if s.len >= Prefix.len and substr(s, 0, Prefix.len - 1) == Prefix:
    substr(s, Prefix.len, s.len - 1)
  else:
    s

proc getIdor*(nbt: NbtCompound; key: string; default: Sound): IdOr[SoundEvent] =
  ## Upstream `expect`s `sound_id` on a compound. A compound without it counts as absent here, since
  ## this reads NBT a client or a world file supplies and a panic is not a reply.
  let asStr = getString(nbt, key)
  if asStr.isSome:
    let (known, sound) = fromName(stripMinecraft(asStr.unsafeGet))
    return idOrSound(if known: sound else: default)
  let asCompound = getCompound(nbt, key)
  if asCompound.isSome:
    let soundName = getString(asCompound.unsafeGet, "sound_id")
    if soundName.isSome:
      return IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: soundName.unsafeGet,
        range: getFloat(asCompound.unsafeGet, "range")))
  idOrSound(default)

# --- IDSet -------------------------------------------------------------------------

type
  IDSetKind* = enum
    idsTag
    idsIds

  IDSet* = object
    ## Upstream `IDSet<T>`, with `T` carried as its registry id.
    case kind*: IDSetKind
    of idsTag: tag*: string
    of idsIds: ids*: seq[int32]

  IDSetContent* = object
    ## Upstream's `IDSetContent` trait, which `Block`, `EntityType` and `StatusEffect` implement.
    ## `fromStr` answers (found, registry id).
    fromStr*: proc (name: string): (bool, int32) {.nimcall.}
    toStr*: proc (id: int32): string {.nimcall.}

func `==`*(a, b: IDSet): bool =
  if a.kind != b.kind: return false
  case a.kind
  of idsTag: a.tag == b.tag
  of idsIds: a.ids == b.ids

proc contains*(self: IDSet; id: int32): bool =
  ## `IDs(ids) => ids.contains(x)`; false on a tag.
  if self.kind == idsIds:
    for x in self.ids:
      if x == id: return true
  false

proc getIdsetHash*(val: IDSet): uint32 =
  var digest = newDigest()
  case val.kind
  of idsTag:
    digest.updateByte(1'u8)
    digest.updateU32Le(getStrHash(val.tag))
  of idsIds:
    digest.updateByte(2'u8)
    for id in val.ids:
      digest.updateByte(3'u8)
      digest.updateU32Le(getI32Hash(id))
  digest.finalize()

proc readIDSet*(data: NbtTag; content: IDSetContent): Option[IDSet] =
  ## `IDSet::<T>::read`.
  case data.kind
  of ntkString:
    let tag = data.stringVal
    if tag.len > 0 and tag[0] == '#':
      some(IDSet(kind: idsTag, tag: substr(tag, 1, tag.len - 1)))
    else:
      let (found, id) = content.fromStr(tag)
      if found: some(IDSet(kind: idsIds, ids: @[id])) else: none[IDSet]()
  of ntkList:
    var ids: seq[int32] = @[]
    for nbt in data.listVal:
      if nbt.kind == ntkString:
        let (found, id) = content.fromStr(nbt.stringVal)
        if found:
          ids.add(id)
    some(IDSet(kind: idsIds, ids: ids))
  else:
    none[IDSet]()

proc writeIDSet*(self: IDSet; compound: var NbtCompound; key: string; content: IDSetContent) =
  ## `IDSet::<T>::write`.
  case self.kind
  of idsTag:
    compound.putString(key, "#" & self.tag)
  of idsIds:
    var idVec: seq[NbtTag] = @[]
    for id in self.ids:
      idVec.add(newTagStr(content.toStr(id)))
    compound.putList(key, idVec)

# --- EquipmentSlot -----------------------------------------------------------------

type
  EquipmentType* = enum
    etHand
    etHumanoidArmor
    etAnimalArmor
    etSaddle

  EquipmentSlot* = enum
    ## The value is `get_slot_index`, as in src/protocol/datacomponent.aowl.
    esMainHand = 0, esFeet = 1, esLegs = 2, esChest = 3, esHead = 4, esOffHand = 5, esBody = 6, esSaddle = 7

proc getEntitySlotId*(self: EquipmentSlot): int32 =
  case self
  of esMainHand: 0'i32
  of esOffHand: 1'i32
  of esFeet: 0'i32
  of esLegs: 1'i32
  of esChest: 2'i32
  of esHead: 3'i32
  of esBody: 0'i32
  of esSaddle: 0'i32

proc getSlotIndex*(self: EquipmentSlot): int32 {.inline.} = int32(ord(self))

proc maxCount*(self: EquipmentSlot): int32 =
  ## `EquipmentSlotData::max_count`.
  case self
  of esMainHand, esOffHand: 0'i32
  else: 1'i32

proc fromSlotIndex*(index: int32): (bool, EquipmentSlot) =
  if index >= 0'i32 and index <= 7'i32: (true, EquipmentSlot(index)) else: (false, esMainHand)

proc getFromName*(_: typedesc[EquipmentSlot]; name: string): (bool, EquipmentSlot) =
  case name
  of "mainhand": (true, esMainHand)
  of "offhand": (true, esOffHand)
  of "feet": (true, esFeet)
  of "legs": (true, esLegs)
  of "chest": (true, esChest)
  of "head": (true, esHead)
  of "body": (true, esBody)
  of "saddle": (true, esSaddle)
  else: (false, esMainHand)

proc toName*(self: EquipmentSlot): string =
  case self
  of esMainHand: "mainhand"
  of esOffHand: "offhand"
  of esFeet: "feet"
  of esLegs: "legs"
  of esChest: "chest"
  of esHead: "head"
  of esBody: "body"
  of esSaddle: "saddle"

proc getOffsetEntitySlotId*(self: EquipmentSlot; offset: int32): int32 =
  self.getEntitySlotId() + offset

proc slotType*(self: EquipmentSlot): EquipmentType =
  case self
  of esMainHand, esOffHand: etHand
  of esFeet, esLegs, esChest, esHead: etHumanoidArmor
  of esBody: etAnimalArmor
  of esSaddle: etSaddle

proc isArmorSlot*(self: EquipmentSlot): bool =
  self.slotType() == etHumanoidArmor or self.slotType() == etAnimalArmor

proc discriminant*(self: EquipmentSlot): int8 =
  case self
  of esMainHand: 0'i8
  of esOffHand: 1'i8
  of esFeet: 2'i8
  of esLegs: 3'i8
  of esChest: 4'i8
  of esHead: 5'i8
  of esBody: 6'i8
  of esSaddle: 7'i8

# --- EntityTypeOrTag ---------------------------------------------------------------

type
  EntityTypeOrTagKind* = enum
    etotTag
    etotSingle

  EntityTypeOrTag* = object
    ## Upstream holds `&'static Tag` and `&'static EntityType`. Here, the tag's registry ids (`Tag.1`,
    ## all upstream's `Hash` reads) and the entity's registry id, so this module needs neither table.
    case kind*: EntityTypeOrTagKind
    of etotTag: tagIds*: seq[uint16]
    of etotSingle: entityId*: uint16

func `==`*(a, b: EntityTypeOrTag): bool =
  if a.kind != b.kind: return false
  case a.kind
  of etotTag: a.tagIds == b.tagIds
  of etotSingle: a.entityId == b.entityId
