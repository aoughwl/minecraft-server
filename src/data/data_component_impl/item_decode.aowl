## Decoders for the compact tables in src/generated/item_full.aowl, and the Bedrock types of upstream's
## generated item.rs (pumpkin-codegen/src/item.rs's output). Hand-written, in the place of gendecode.aowl,
## because these need the component types.
##
## Item table, one line per item in id order:
##   <registry key> TAB <component> | <component> ...
##   <component> is <name without minecraft:> : <payload>
## Payload separators, outermost first: `,` `;` `~` `^` `!`. See gen_item_full.aowl for each component's fields.
## An empty optional field is `None`.

import std/[parseutils, tables]
import "mod"
import ../../generated/gendecode

export `mod`

type
  BedrockItemVersion* = enum
    bivLegacy
    bivDataDriven
    bivNone

  BedrockItem* = ref object
    id*: int16
    registryKey*: string
    version*: BedrockItemVersion
    componentBased*: bool
    definitionComponents*: seq[byte]

  JavaToBedrockItemMapping* = ref object
    javaItem*: Item
    bedrockItem*: BedrockItem
    bedrockData*: uint32
    bedrockBlockState*: uint16

  BedrockTables* = object
    byKey: Table[string, int]
    mappings: seq[JavaToBedrockItemMapping]    ## By Java item id.
    pairs: Table[int64, int]                   ## (bedrock id, data) to the first Java item id, in name order.
    fallback: Table[int, int]                  ## Bedrock id to the first Java item id, in name order.

proc translatedName*(self: Item): TextComponent =
  ## `Item::translated_name`. Every item has an `ItemName`, as to_tokens writes it unconditionally.
  for component in self.components:
    if component.kind == dcItemName:
      return translate(component.itemName.name)
  genPanic("item without a name: " & self.registryKey)
  empty()

proc splitOn(s: string; sep: char): seq[string] =
  ## Empty input is an empty list.
  result = @[]
  if s.len == 0:
    return
  var start = 0
  for i in 0 ..< s.len:
    if s[i] == sep:
      result.add(substr(s, start, i - 1))
      start = i + 1
  result.add(substr(s, start, s.len - 1))

proc splitFields(s: string; sep: char): seq[string] =
  ## Every field, the empty ones too.
  result = @[]
  var start = 0
  for i in 0 ..< s.len:
    if s[i] == sep:
      result.add(substr(s, start, i - 1))
      start = i + 1
  result.add(substr(s, start, s.len - 1))

proc toI(s: string): int =
  var pos = 0
  fieldInt(s, pos, '\0')

proc toF64(s: string): float64 =
  result = 0.0
  discard parseBiggestFloat(s, result)

proc toF32(s: string): float32 =
  ## Upstream's `f32` fields hold what the text says, narrowed from the double.
  float32(toF64(s))

proc optStr(s: string): Option[string] =
  if s.len > 0: some(s) else: none[string]()

proc soundOf(name: string): IdOr[SoundEvent] =
  let (known, sound) = fromName(name)
  if not known:
    genPanic("item table names an unknown sound: " & name)
  idOrSound(sound)

proc decodeIDSet(text: string): IDSet =
  if text[0] == 't':
    IDSet(kind: idsTag, tag: substr(text, 1, text.len - 1))
  else:
    var ids: seq[int32] = @[]
    for part in splitOn(substr(text, 1, text.len - 1), '.'):
      ids.add(int32(toI(part)))
    IDSet(kind: idsIds, ids: ids)

proc decodeModifiers(text: string): seq[Modifier] =
  result = @[]
  let attributes = allAttributes()
  for one in splitOn(text, ';'):
    let f = splitFields(one, '~')
    var attribute = attributes[0]
    var found = false
    for a in attributes:
      if a.name == f[0]:
        attribute = a
        found = true
    if not found:
      genPanic("item table names an unknown attribute: " & f[0])
    let operation =
      case f[3]
      of "add_value": opAddValue
      of "add_multiplied_base": opAddMultipliedBase
      else: opAddMultipliedTotal
    let slot =
      case f[4]
      of "any": amsAny
      of "mainhand": amsMainHand
      of "offhand": amsOffHand
      of "hand": amsHand
      of "feet": amsFeet
      of "legs": amsLegs
      of "chest": amsChest
      of "head": amsHead
      of "armor": amsArmor
      of "body": amsBody
      of "saddle": amsSaddle
      else:
        genPanic("item table names an unknown slot: " & f[4])
        amsAny
    result.add(Modifier(attribute: attribute, id: f[1], amount: toF64(f[2]), operation: operation, slot: slot))

proc decodeTool(text: string): ToolImpl =
  let f = splitFields(text, ',')
  var rules: seq[ToolRule] = @[]
  for one in splitOn(f[3], ';'):
    let r = splitFields(one, '~')
    rules.add(ToolRule(blocks: decodeIDSet(r[0]),
      speed: (if r[1].len > 0: some(toF32(r[1])) else: none[float32]()),
      correctForDrops: (if r[2].len > 0: some(r[2] == "1") else: none[bool]())))
  ToolImpl(rules: rules, defaultMiningSpeed: toF32(f[0]), damagePerBlock: uint32(toI(f[1])),
    canDestroyBlocksInCreative: f[2] == "1")

proc decodeEffects(text: string): seq[ConsumeEffect] =
  result = @[]
  for one in splitOn(text, ';'):
    let f = splitFields(one, '~')
    case f[0]
    of "0":
      var instances: seq[StatusEffectInstance] = @[]
      for inst in splitOn(f[2], '^'):
        let i = splitFields(inst, '!')
        instances.add(StatusEffectInstance(effectId: i[0], amplifier: int32(toI(i[1])), duration: int32(toI(i[2])),
          ambient: i[3] == "1", showParticles: i[4] == "1", showIcon: i[5] == "1"))
      result.add(ConsumeEffect(kind: ceApplyEffects, effects: instances, probability: toF32(f[1])))
    of "1":
      result.add(ConsumeEffect(kind: ceRemoveEffects, removed: IDSet(kind: idsIds, ids: @[int32(toI(f[1]))])))
    of "2":
      result.add(ConsumeEffect(kind: ceClearAllEffects))
    of "3":
      result.add(ConsumeEffect(kind: ceTeleportRandomly, diameter: toF32(f[1])))
    else:
      result.add(ConsumeEffect(kind: cePlaySound, sound: soundOf(f[1])))

proc decodeConsumable(text: string): ConsumableImpl =
  let f = splitFields(text, ',')
  let (known, animation) = parseConsumeAnimation(f[1])
  if not known:
    genPanic("item table names an unknown animation: " & f[1])
  ConsumableImpl(consumeSeconds: toF32(f[0]), animation: animation, soundEvent: soundOf(f[2]),
    consumeParticles: f[3] == "1", effects: decodeEffects(f[4]))

proc decodeEquippable(text: string): EquippableImpl =
  let f = splitFields(text, ',')
  let (known, slot) = getFromName(EquipmentSlot, f[0])
  if not known:
    # Upstream's "Unknown equippable slot" panic, at its own build time.
    genPanic("Unknown equippable slot: " & f[0])
  EquippableImpl(slot: slot, equipSound: soundOf(f[1]), assetId: optStr(f[2]), cameraOverlay: optStr(f[3]),
    allowedEntities: (if f[4].len > 0: some(decodeIDSet(f[4])) else: none[IDSet]()),
    dispensable: f[5] == "1", swappable: f[6] == "1", damageOnHurt: f[7] == "1", equipOnInteract: f[8] == "1",
    canBeSheared: f[9] == "1", shearingSound: soundOf(f[10]))

proc decodeBlockState(text: string): seq[(string, string)] =
  result = @[]
  for one in splitOn(text, ';'):
    let f = splitFields(one, '~')
    result.add((f[0], f[1]))

proc decodeComponent(name, payload: string): DataComponentImpl =
  case name
  of "max_stack_size": toDyn(MaxStackSizeImpl(size: uint8(toI(payload))))
  of "use_cooldown":
    let f = splitFields(payload, ',')
    toDyn(UseCooldownImpl(seconds: toF32(f[0]), cooldownGroup: optStr(f[1])))
  of "jukebox_playable": toDyn(JukeboxPlayableImpl(song: payload))
  of "item_name": toDyn(ItemNameImpl(name: payload))
  of "damage": toDyn(DamageImpl(damage: int32(toI(payload))))
  of "max_damage": toDyn(MaxDamageImpl(maxDamage: int32(toI(payload))))
  of "attribute_modifiers": toDyn(AttributeModifiersImpl(attributeModifiers: decodeModifiers(payload)))
  of "tool": toDyn(decodeTool(payload))
  of "food":
    let f = splitFields(payload, ',')
    toDyn(FoodImpl(nutrition: int32(toI(f[0])), saturation: toF32(f[1]), canAlwaysEat: f[2] == "1"))
  of "consumable": toDyn(decodeConsumable(payload))
  of "blocks_attacks": toDyn(BlocksAttacksImpl())
  of "death_protection": toDyn(DeathProtectionImpl())
  of "weapon": toDyn(WeaponImpl(itemDamagePerAttack: uint32(toI(payload))))
  of "damage_resistant": toDyn(DamageResistantImpl(resType: fromTag(DamageResistantType, payload)))
  of "equippable": toDyn(decodeEquippable(payload))
  of "enchantable": toDyn(EnchantableImpl(value: int32(toI(payload))))
  of "attack_range": toDyn(AttackRangeImpl())
  of "banner_patterns": toDyn(BannerPatternsImpl())
  of "bees": toDyn(BeesImpl())
  of "block_state": toDyn(BlockStateImpl(properties: decodeBlockState(payload)))
  of "break_sound": toDyn(BreakSoundImpl())
  of "bucket_entity_data": toDyn(BucketEntityDataImpl())
  of "bundle_contents": toDyn(BundleContentsImpl(items: @[]))
  of "charged_projectiles": toDyn(ChargedProjectilesImpl(projectiles: @[]))
  of "chicken/variant": toDyn(ChickenVariantImpl(value: payload))
  of "container": toDyn(ContainerImpl(items: @[]))
  of "damage_type": toDyn(DamageTypeImpl())
  of "debug_stick_state": toDyn(DebugStickStateImpl())
  of "dye": toDyn(DyeImpl())
  of "enchantment_glint_override": toDyn(EnchantmentGlintOverrideImpl())
  of "enchantments": toDyn(EnchantmentsImpl(enchantment: @[]))
  of "entity_data": toDyn(EntityDataImpl())
  of "fireworks": toDyn(FireworksImpl(flightDuration: int32(toI(payload)), explosions: @[]))
  of "glider": toDyn(GliderImpl())
  of "instrument": toDyn(InstrumentImpl())
  of "item_model": toDyn(ItemModelImpl(id: payload))
  of "kinetic_weapon": toDyn(KineticWeaponImpl())
  of "lore": toDyn(LoreImpl())
  of "map_color": toDyn(MapColorImpl())
  of "map_decorations": toDyn(MapDecorationsImpl())
  of "minimum_attack_charge": toDyn(MinimumAttackChargeImpl())
  of "ominous_bottle_amplifier": toDyn(OminousBottleAmplifierImpl(amplifier: int32(toI(payload))))
  of "piercing_weapon": toDyn(PiercingWeaponImpl())
  of "pot_decorations": toDyn(PotDecorationsImpl())
  of "potion_contents":
    toDyn(PotionContentsImpl(potionId: none[int32](), customColor: none[int32](), customEffects: @[],
      customName: none[string]()))
  of "potion_duration_scale": toDyn(PotionDurationScaleImpl())
  of "provides_banner_patterns": toDyn(ProvidesBannerPatternsImpl())
  of "provides_trim_material": toDyn(ProvidesTrimMaterialImpl())
  of "rarity": toDyn(RarityImpl())
  of "recipes": toDyn(RecipesImpl())
  of "repair_cost": toDyn(RepairCostImpl())
  of "repairable": toDyn(RepairableImpl())
  of "stored_enchantments": toDyn(StoredEnchantmentsImpl(enchantment: @[]))
  of "suspicious_stew_effects": toDyn(SuspiciousStewEffectsImpl())
  of "swing_animation": toDyn(SwingAnimationImpl())
  of "tooltip_display": toDyn(TooltipDisplayImpl())
  of "use_effects": toDyn(UseEffectsImpl())
  of "use_remainder": toDyn(UseRemainderImpl())
  of "writable_book_content": toDyn(WritableBookContentImpl(pages: @[]))
  else:
    genPanic("item table names an unknown component: " & name)
    toDyn(LoreImpl())

proc decodeItems*(table: string): seq[Item] =
  result = @[]
  var pos = 0
  while pos < table.len:
    let key = fieldStr(table, pos, '\t')
    skipSep(table, pos)
    var components: seq[DataComponentImpl] = @[]
    while pos < table.len and table[pos] != '\n':
      let name = fieldStr(table, pos, ':', '|')
      skipSep(table, pos)
      let payload = fieldStr(table, pos, '|')
      components.add(decodeComponent(name, payload))
      if pos < table.len and table[pos] == '|':
        inc pos
    skipSep(table, pos)
    result.add(Item(id: uint16(result.len), registryKey: key, components: components))

proc indexItems*(items: seq[Item]): Table[string, int] =
  result = initTable[string, int]()
  for i, item in items:
    result[item.registryKey] = i

proc lookupItem*(items: seq[Item]; index: Table[string, int]; name: string): nil Item =
  ## `Item::from_registry_key`.
  let i = index.getOrDefault(stripMinecraft(name), -1)
  if i < 0:
    return nil
  return items[i]

proc hexNibble(c: char): int {.inline.} =
  if c >= 'a': ord(c) - ord('a') + 10 else: ord(c) - ord('0')

proc decodeBedrockItems*(table: string): seq[BedrockItem] =
  result = @[]
  var pos = 0
  while pos < table.len:
    let id = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    let key = fieldStr(table, pos, '\t')
    skipSep(table, pos)
    let version = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    let componentBased = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    let hex = fieldStr(table, pos, '\t')
    skipSep(table, pos)
    var bytes = newSeq[byte](hex.len div 2)
    for i in 0 ..< bytes.len:
      bytes[i] = byte((hexNibble(hex[i * 2]) shl 4) or hexNibble(hex[i * 2 + 1]))
    result.add(BedrockItem(id: int16(id), registryKey: key, version: BedrockItemVersion(version),
      componentBased: componentBased == 1, definitionComponents: bytes))

proc pairKey(bedrockId: int; data: int): int64 {.inline.} =
  (int64(bedrockId) shl 32) or int64(data)

proc decodeBedrockMappings*(table: string; bedrockItems: seq[BedrockItem]; items: seq[Item]): BedrockTables =
  var byKey = initTable[string, int]()
  var byId = initTable[int, int]()
  for i, b in bedrockItems:
    byKey[b.registryKey] = i
    byId[int(b.id)] = i
  var pairsTable = initTable[int64, int]()
  var fallback = initTable[int, int]()
  var mappings: seq[JavaToBedrockItemMapping] = @[]
  for i in 0 ..< items.len:
    mappings.add(JavaToBedrockItemMapping(javaItem: items[i], bedrockItem: bedrockItems[0], bedrockData: 0'u32,
      bedrockBlockState: 0'u16))
  var pos = 0
  while pos < table.len:
    let javaId = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    let bedrockId = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    let data = fieldInt(table, pos, '\t')
    skipSep(table, pos)
    mappings[javaId].bedrockItem = bedrockItems[byId.getOrDefault(bedrockId, 0)]
    mappings[javaId].bedrockData = uint32(data)
    let key = pairKey(bedrockId, data)
    if not pairsTable.hasKey(key):
      pairsTable[key] = javaId
    if not fallback.hasKey(bedrockId):
      fallback[bedrockId] = javaId
  BedrockTables(byKey: byKey, mappings: mappings, pairs: pairsTable, fallback: fallback)

proc lookupBedrockItem*(tables: BedrockTables; bedrockItems: seq[BedrockItem]; key: string): nil BedrockItem =
  let i = tables.byKey.getOrDefault(key, -1)
  if i < 0:
    return nil
  return bedrockItems[i]

proc mappingFromJava*(tables: BedrockTables; itemId: uint16): nil JavaToBedrockItemMapping =
  ## `JavaToBedrockItemMapping::from_java_item_id`.
  if int(itemId) >= tables.mappings.len:
    return nil
  return tables.mappings[int(itemId)]

proc mappingFromBedrock*(tables: BedrockTables; bedrockId: int16; bedrockData: uint32): nil JavaToBedrockItemMapping =
  ## `JavaToBedrockItemMapping::from_bedrock`: the exact pair, else the first item with that Bedrock id.
  var javaId = tables.pairs.getOrDefault(pairKey(int(bedrockId), int(bedrockData)), -1)
  if javaId < 0:
    javaId = tables.fallback.getOrDefault(int(bedrockId), -1)
  if javaId < 0:
    return nil
  return tables.mappings[javaId]
