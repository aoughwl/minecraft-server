## Port of pumpkin-data/src/data_component_impl/mod.rs
## PARTIAL: pumpkin-data/src/data_component_impl/mod.rs - `#[derive(Hash)]` and the hand-written `Hash` impls of the component types, `IDSet` and `EntityTypeOrTag` are not ported; no upstream map or set keys on them (`EquipmentSlot` and `Item` hash as usual).
##
## `Box<dyn DataComponentImpl>` is the closed `DataComponentImpl` case object, keyed by the `DataComponent` id
## itself; upstream's impl list has exactly the enum's 111 members, so every one is a branch. A case object
## suits this better than a `ref object` of closures: `get::<T>` has to give back the concrete type, which a
## closure field cannot, and value semantics give upstream's `clone_dyn` for free (an assignment is a deep
## copy). Its shape matches src/protocol/datacomponent.aowl's `DataComponentValue`.
##
## Trait methods become `getEnum(T)`, `getSelfEnum`, `toDyn`, `get(v, T)`, `writeData`, `getHash`, `equal`.
## `as_any`/`get_mut`: mutate the branch field directly (see `getDataComponentMut` in ../item_stack/mod.aowl).
##
## Layout, forced by aowlmony modules not being able to form an import cycle:
##   impl_base.aowl       the leaf half of mod.rs (hashes, IDSet, IdOr, EquipmentSlot)
##   basic.aowl ...       the component structs and their read/write/hash
##   this file            the recursive type group (DataComponentImpl, Item, ItemStack, ContainerImpl,
##                        BundleContentsImpl) and the dispatch
##   item_decode.aowl     turns generated/item_full's compact table into Items
##   generated/item_full  the item table
##   ../item_stack/mod    ItemStack's methods and `read_data`, since `read_data` and `read_item_stack` call
##                        each other and need `Item::from_registry_key`
##
## Upstream's `macro_rules! default_impl` would be a template here, but a template that declares a proc with
## a case object constructor stops the compiler (see the report), so its procs are written out per type.
##
## `#[cfg(test)]` vectors: data_component_impltest.aowl.

import std/hashes
import ../../generated/data_component
import ../../nbt/tag
import ../../generated/gendecode
import "impl_base"
import "basic"
import "block_entity"
import "book"
import "combat"
import "entity_variant"
import "food"
import "utility"

export data_component, impl_base, basic, block_entity, book, combat, entity_variant, food, utility

type
  ContainerSlot* = object
    ## Upstream's `(u8, ItemStack)`.
    slot*: uint8
    stack*: ItemStack

  ContainerImpl* = object
    items*: seq[ContainerSlot]

  BundleContentsImpl* = object
    items*: seq[ItemStack]

  DataComponentImpl* = object
    case kind*: DataComponent
    of dcCustomData: customData*: CustomDataImpl
    of dcMaxStackSize: maxStackSize*: MaxStackSizeImpl
    of dcMaxDamage: maxDamage*: MaxDamageImpl
    of dcDamage: damage*: DamageImpl
    of dcCustomName: customName*: CustomNameImpl
    of dcItemName: itemName*: ItemNameImpl
    of dcItemModel: itemModel*: ItemModelImpl
    of dcEnchantments: enchantments*: EnchantmentsImpl
    of dcCanPlaceOn: canPlaceOn*: CanPlaceOnImpl
    of dcCanBreak: canBreak*: CanBreakImpl
    of dcAttributeModifiers: attributeModifiers*: AttributeModifiersImpl
    of dcCustomModelData: customModelData*: CustomModelDataImpl
    of dcFood: food*: FoodImpl
    of dcConsumable: consumable*: ConsumableImpl
    of dcUseCooldown: useCooldown*: UseCooldownImpl
    of dcDamageResistant: damageResistant*: DamageResistantImpl
    of dcTool: tool*: ToolImpl
    of dcWeapon: weapon*: WeaponImpl
    of dcEnchantable: enchantable*: EnchantableImpl
    of dcEquippable: equippable*: EquippableImpl
    of dcTooltipStyle: tooltipStyle*: TooltipStyleImpl
    of dcStoredEnchantments: storedEnchantments*: StoredEnchantmentsImpl
    of dcDyedColor: dyedColor*: DyedColorImpl
    of dcMapId: mapId*: MapIdImpl
    of dcChargedProjectiles: chargedProjectiles*: ChargedProjectilesImpl
    of dcBundleContents: bundleContents*: BundleContentsImpl
    of dcPotionContents: potionContents*: PotionContentsImpl
    of dcWritableBookContent: writableBookContent*: WritableBookContentImpl
    of dcWrittenBookContent: writtenBookContent*: WrittenBookContentImpl
    of dcTrim: trim*: TrimImpl
    of dcBlockEntityData: blockEntityData*: BlockEntityDataImpl
    of dcOminousBottleAmplifier: ominousBottleAmplifier*: OminousBottleAmplifierImpl
    of dcJukeboxPlayable: jukeboxPlayable*: JukeboxPlayableImpl
    of dcLodestoneTracker: lodestoneTracker*: LodestoneTrackerImpl
    of dcFireworkExplosion: fireworkExplosion*: FireworkExplosionImpl
    of dcFireworks: fireworks*: FireworksImpl
    of dcProfile: profile*: ProfileImpl
    of dcNoteBlockSound: noteBlockSound*: NoteBlockSoundImpl
    of dcBaseColor: baseColor*: BaseColorImpl
    of dcContainer: container*: ContainerImpl
    of dcBlockState: blockState*: BlockStateImpl
    of dcLock: lock*: LockImpl
    of dcContainerLoot: containerLoot*: ContainerLootImpl
    of dcVillagerVariant, dcWolfVariant, dcWolfSoundVariant, dcWolfCollar, dcFoxVariant, dcSalmonSize, dcParrotVariant, dcTropicalFishPattern, dcTropicalFishBaseColor, dcTropicalFishPatternColor, dcMooshroomVariant, dcRabbitVariant, dcPigVariant, dcPigSoundVariant, dcCowVariant, dcCowSoundVariant, dcChickenVariant, dcChickenSoundVariant, dcZombieNautilusVariant, dcFrogVariant, dcHorseVariant, dcPaintingVariant, dcLlamaVariant, dcAxolotlVariant, dcCatVariant, dcCatSoundVariant, dcCatCollar, dcSheepColor, dcShulkerColor:
      stringVariant*: string
    of dcUnbreakable, dcUseEffects, dcMinimumAttackCharge, dcDamageType, dcLore, dcRarity, dcTooltipDisplay, dcRepairCost, dcCreativeSlotLock, dcEnchantmentGlintOverride, dcIntangibleProjectile, dcUseRemainder, dcAttackRange, dcRepairable, dcGlider, dcDeathProtection, dcBlocksAttacks, dcPiercingWeapon, dcKineticWeapon, dcSwingAnimation, dcAdditionalTradeCost, dcDye, dcMapColor, dcMapDecorations, dcMapPostProcessing, dcPotionDurationScale, dcSuspiciousStewEffects, dcDebugStickState, dcEntityData, dcBucketEntityData, dcInstrument, dcProvidesTrimMaterial, dcProvidesBannerPatterns, dcRecipes, dcBannerPatterns, dcPotDecorations, dcBees, dcSulfurCubeContent, dcBreakSound:
      discard

  PatchEntry* = object
    ## Upstream's `(DataComponent, Option<Box<dyn DataComponentImpl>>)`. Not `present` is the `None`, the
    ## component removed. A plain flag rather than `Option`, so `getDataComponentMut` can reach into `data`.
    id*: DataComponent
    present*: bool
    data*: DataComponentImpl

  Item* = ref object
    ## Upstream's generated `Item`; the table of them is generated/item_full.aowl.
    id*: uint16
    registryKey*: string
    components*: seq[DataComponentImpl]

  ItemStack* = object
    itemCount*: uint8
    item*: Item
    patch*: seq[PatchEntry]
    uid*: int32  ## Unique id for the Bedrock network; do not serialize. Upstream's `NonZeroI32`.

proc sameItem*(a, b: Item): bool {.inline.} =
  ## `impl PartialEq for Item`. Not `==`, which would shadow the compare with nil.
  a.id == b.id

proc hash*(a: Item): Hash {.inline.} = hash(int(a.id))

proc patchSet*(data: sink DataComponentImpl): PatchEntry =
  ## `(id, Some(data))`.
  let id = data.kind
  PatchEntry(id: id, present: true, data: data)

proc patchRemoved*(id: DataComponent): PatchEntry =
  ## `(id, None)`.
  PatchEntry(id: id, present: false, data: DataComponentImpl(kind: dcUnbreakable))

proc getSelfEnum*(self: DataComponentImpl): DataComponent {.inline.} = self.kind

proc checkKind(value: DataComponentImpl; want: DataComponent) =
  ## Upstream's `get::<T>` panic.
  if value.kind != want:
    genPanic("you are trying to cast " & value.kind.toName() & " to " & want.toName())

proc findComponent*(self: ItemStack; toGetId: DataComponent): (bool, DataComponentImpl) =
  ## `get_data_component` by id: the patch first, then the item's own.
  for entry in self.patch:
    if entry.id == toGetId:
      if entry.present:
        return (true, entry.data)
      return (false, entry.data)
  for component in self.item.components:
    if component.kind == toGetId:
      return (true, component)
  (false, DataComponentImpl(kind: dcUnbreakable))

proc getDataComponentMutById*(self: var ItemStack; toGetId: DataComponent): int =
  ## The index in `patch` of a component to mutate, -1 if the stack has none. If not in patch, clones it from
  ## the item to patch first.
  for i in 0 ..< self.patch.len:
    if self.patch[i].id == toGetId:
      return (if self.patch[i].present: i else: -1)
  for component in self.item.components:
    if component.kind == toGetId:
      self.patch.add(patchSet(component))
      return self.patch.len - 1
  -1

proc getEnum*(_: typedesc[CustomDataImpl]): DataComponent {.inline.} = dcCustomData
proc toDyn*(self: sink CustomDataImpl): DataComponentImpl = DataComponentImpl(kind: dcCustomData, customData: self)
proc get*(value: DataComponentImpl; _: typedesc[CustomDataImpl]): CustomDataImpl =
  checkKind(value, dcCustomData)
  value.customData
