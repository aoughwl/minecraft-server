  of dcFireworks: getHash(self.fireworks)
  of dcProfile: getHash(self.profile)
  of dcNoteBlockSound: getHash(self.noteBlockSound)
  of dcBaseColor: getHash(self.baseColor)
  of dcBlockState: getHash(self.blockState)
  of dcVillagerVariant, dcWolfVariant, dcWolfSoundVariant, dcWolfCollar, dcFoxVariant, dcSalmonSize, dcParrotVariant, dcTropicalFishPattern, dcTropicalFishBaseColor, dcTropicalFishPatternColor, dcMooshroomVariant, dcRabbitVariant, dcPigVariant, dcPigSoundVariant, dcCowVariant, dcCowSoundVariant, dcChickenVariant, dcChickenSoundVariant, dcZombieNautilusVariant, dcFrogVariant, dcHorseVariant, dcPaintingVariant, dcLlamaVariant, dcAxolotlVariant, dcCatVariant, dcCatSoundVariant, dcCatCollar, dcSheepColor, dcShulkerColor:
    getStringVariantHash(self.stringVariant)
  else: 0'i32

proc equal*(self, other: DataComponentImpl): bool =
  ## "make sure other is the same type component, or it will panic".
  checkKind(other, self.kind)
  case self.kind
  of dcCustomData: self.customData == other.customData
  of dcMaxStackSize: self.maxStackSize == other.maxStackSize
  of dcMaxDamage: self.maxDamage == other.maxDamage
  of dcDamage: self.damage == other.damage
