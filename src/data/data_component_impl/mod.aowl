proc writeData*(self: DataComponentImpl): NbtTag =
  ## A component whose Rust type keeps the trait default gives `NbtTag::End`.
  case self.kind
  of dcCustomData: writeData(self.customData)
  of dcMaxStackSize: writeData(self.maxStackSize)
  of dcDamage: writeData(self.damage)
  of dcUnbreakable: writeData(UnbreakableImpl())
  of dcCustomName: writeData(self.customName)
  of dcItemModel: writeData(self.itemModel)
  of dcEnchantments: writeData(self.enchantments)
  of dcCanPlaceOn: writeData(self.canPlaceOn)
  of dcCanBreak: writeData(self.canBreak)
  of dcCustomModelData: writeData(self.customModelData)
  of dcIntangibleProjectile: writeData(IntangibleProjectileImpl())
  of dcConsumable: writeData(self.consumable)
  of dcUseCooldown: writeData(self.useCooldown)
  of dcDamageResistant: writeData(self.damageResistant)
  of dcWeapon: writeData(self.weapon)
  of dcEquippable: writeData(self.equippable)
  of dcGlider: writeData(GliderImpl())
  of dcTooltipStyle: writeData(self.tooltipStyle)
  of dcStoredEnchantments: writeData(self.storedEnchantments)
  of dcDyedColor: writeData(self.dyedColor)
  of dcMapId: writeData(self.mapId)
  of dcChargedProjectiles: writeData(self.chargedProjectiles)
  of dcPotionContents: writeData(self.potionContents)
  of dcTrim: writeData(self.trim)
  of dcOminousBottleAmplifier: writeData(self.ominousBottleAmplifier)
  of dcLodestoneTracker: writeData(self.lodestoneTracker)
  of dcFireworkExplosion: writeData(self.fireworkExplosion)
  of dcFireworks: writeData(self.fireworks)
  of dcProfile: writeData(self.profile)
  of dcNoteBlockSound: writeData(self.noteBlockSound)
  of dcBaseColor: writeData(self.baseColor)
  of dcBlockState: writeData(self.blockState)
  of dcLock: writeData(self.lock)
  of dcContainerLoot: writeData(self.containerLoot)
  of dcVillagerVariant, dcWolfVariant, dcWolfSoundVariant, dcWolfCollar, dcFoxVariant, dcSalmonSize, dcParrotVariant, dcTropicalFishPattern, dcTropicalFishBaseColor, dcTropicalFishPatternColor, dcMooshroomVariant, dcRabbitVariant, dcPigVariant, dcPigSoundVariant, dcCowVariant, dcCowSoundVariant, dcChickenVariant, dcChickenSoundVariant, dcZombieNautilusVariant, dcFrogVariant, dcHorseVariant, dcPaintingVariant, dcLlamaVariant, dcAxolotlVariant, dcCatVariant, dcCatSoundVariant, dcCatCollar, dcSheepColor, dcShulkerColor:
    writeStringVariant(self.stringVariant)
  else: NbtTag(kind: ntkEnd)

proc getHash*(self: DataComponentImpl): int32 =
  ## A component whose Rust type keeps the trait default gives 0.
  case self.kind
  of dcMaxStackSize: getHash(self.maxStackSize)
  of dcDamage: getHash(self.damage)
  of dcCustomName: getHash(self.customName)
  of dcItemModel: getHash(self.itemModel)
  of dcEnchantments: getHash(self.enchantments)
  of dcConsumable: getHash(self.consumable)
  of dcUseCooldown: getHash(self.useCooldown)
