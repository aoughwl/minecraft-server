## Port of pumpkin-data/src/data_component_impl/utility.rs
##
## `BundleContentsImpl` holds `ItemStack`s, so its type is with `ItemStack` in mod.aowl, and its
## `read_data`, `get_weight`, `try_insert` and `try_extract` are in ../item_stack/mod.aowl. Everything else
## in the Rust file is here.

import impl_base
import ../../nbt/tag

type
  DyeImpl* = object

  DyedColorImpl* = object
    rgb*: int32

  MapColorImpl* = object

  MapIdImpl* = object
    id*: int32

  MapDecorationsImpl* = object

  MapPostProcessingImpl* = object

  ChargedProjectilesImpl* = object
    projectiles*: seq[NbtCompound]

  LodestoneTarget* = object
    ## The dimension and block position a lodestone compass points to.
    dimension*: string
    x*: int32
    y*: int32
    z*: int32

  LodestoneTrackerImpl* = object
    target*: Option[LodestoneTarget]
    tracked*: bool

  FireworkExplosionShape* = enum
    fesSmallBall = 0, fesLargeBall = 1, fesStar = 2, fesCreeper = 3, fesBurst = 4

  FireworkExplosionImpl* = object
    shape*: FireworkExplosionShape
    colors*: seq[int32]
    fadeColors*: seq[int32]
    hasTrail*: bool
    hasTwinkle*: bool

  FireworksImpl* = object
    flightDuration*: int32
    explosions*: seq[FireworkExplosionImpl]

  ProfileProperty* = object
    name*: string
    value*: string
    signature*: Option[string]

  ProfileImpl* = object
    name*: Option[string]
    id*: Option[array[4, int32]]
    properties*: seq[ProfileProperty]
    texture*: Option[string]
    cape*: Option[string]
    elytra*: Option[string]
    model*: Option[string]

  JukeboxPlayableImpl* = object
    song*: string

  RecipesImpl* = object

proc readData*(_: typedesc[DyedColorImpl]; data: NbtTag): Option[DyedColorImpl] =
  let rgb = extractInt(data)
  if rgb.isSome: some(DyedColorImpl(rgb: rgb.unsafeGet)) else: none[DyedColorImpl]()

proc writeData*(self: DyedColorImpl): NbtTag = newTagInt(self.rgb)

proc getHash*(self: DyedColorImpl): int32 = asI32(getI32Hash(self.rgb))

proc readData*(_: typedesc[MapIdImpl]; data: NbtTag): Option[MapIdImpl] =
  let id = extractInt(data)
  if id.isSome: some(MapIdImpl(id: id.unsafeGet)) else: none[MapIdImpl]()

proc writeData*(self: MapIdImpl): NbtTag = newTagInt(self.id)

proc getHash*(self: MapIdImpl): int32 = asI32(getI32Hash(self.id))

proc readData*(_: typedesc[ChargedProjectilesImpl]; data: NbtTag): Option[ChargedProjectilesImpl] =
  let list = extractList(data)
  if list.isNone: return none[ChargedProjectilesImpl]()
  var projectiles: seq[NbtCompound] = @[]
  for item in list.unsafeGet:
    if item.kind != ntkCompound:
      return none[ChargedProjectilesImpl]()
    projectiles.add(item.compoundVal)
  some(ChargedProjectilesImpl(projectiles: projectiles))

proc writeData*(self: ChargedProjectilesImpl): NbtTag =
  var list: seq[NbtTag] = @[]
  for item in self.projectiles:
    list.add(newTagCompound(item))
  newTagList(list)

proc `==`*(a, b: ChargedProjectilesImpl): bool =
  if a.projectiles.len != b.projectiles.len: return false
  for i in 0 ..< a.projectiles.len:
    if not (a.projectiles[i] == b.projectiles[i]): return false
  true

func `==`*(a, b: LodestoneTarget): bool =
  a.dimension == b.dimension and a.x == b.x and a.y == b.y and a.z == b.z

func `==`*(a, b: LodestoneTrackerImpl): bool =
  a.target == b.target and a.tracked == b.tracked

proc readData*(_: typedesc[LodestoneTrackerImpl]; data: NbtTag): Option[LodestoneTrackerImpl] =
  let compoundOpt = extractCompound(data)
  if compoundOpt.isNone: return none[LodestoneTrackerImpl]()
  let compound = compoundOpt.unsafeGet
  let trackedOpt = getBool(compound, "tracked")
  var target = none[LodestoneTarget]()
  let targetOpt = getCompound(compound, "target")
  if targetOpt.isSome:
    let dimension = getString(targetOpt.unsafeGet, "dimension")
    let pos = getIntArray(targetOpt.unsafeGet, "pos")
    if dimension.isSome and pos.isSome and pos.unsafeGet.len == 3:
      let p = pos.unsafeGet
      target = some(LodestoneTarget(dimension: dimension.unsafeGet, x: p[0], y: p[1], z: p[2]))
  some(LodestoneTrackerImpl(target: target, tracked: (if trackedOpt.isSome: trackedOpt.unsafeGet else: true)))

proc writeData*(self: LodestoneTrackerImpl): NbtTag =
  var compound = newCompound()
  if self.target.isSome:
    let target = self.target.unsafeGet
    var targetCompound = newCompound()
    targetCompound.putString("dimension", target.dimension)
    targetCompound.put("pos", NbtTag(kind: ntkIntArray, intArrayVal: @[target.x, target.y, target.z]))
    compound.put("target", newTagCompound(targetCompound))
  compound.putBool("tracked", self.tracked)
  newTagCompound(compound)

proc fromId*(_: typedesc[FireworkExplosionShape]; id: int32): (bool, FireworkExplosionShape) =
  if id >= 0'i32 and id <= 4'i32: (true, FireworkExplosionShape(id)) else: (false, fesSmallBall)

proc toId*(self: FireworkExplosionShape): int32 {.inline.} = int32(ord(self))

proc toName*(self: FireworkExplosionShape): string =
  case self
  of fesSmallBall: "small_ball"
  of fesLargeBall: "large_ball"
  of fesStar: "star"
  of fesCreeper: "creeper"
  of fesBurst: "burst"

proc fromName*(_: typedesc[FireworkExplosionShape]; name: string): (bool, FireworkExplosionShape) =
  case name
  of "small_ball": (true, fesSmallBall)
  of "large_ball": (true, fesLargeBall)
  of "star": (true, fesStar)
  of "creeper": (true, fesCreeper)
  of "burst": (true, fesBurst)
  else: (false, fesSmallBall)

func `==`*(a, b: FireworkExplosionImpl): bool =
  a.shape == b.shape and a.colors == b.colors and a.fadeColors == b.fadeColors and
    a.hasTrail == b.hasTrail and a.hasTwinkle == b.hasTwinkle

proc newFireworkExplosionImpl*(shape: FireworkExplosionShape; colors, fadeColors: seq[int32];
    hasTrail, hasTwinkle: bool): FireworkExplosionImpl =
  FireworkExplosionImpl(shape: shape, colors: colors, fadeColors: fadeColors, hasTrail: hasTrail,
    hasTwinkle: hasTwinkle)

proc readData*(_: typedesc[FireworkExplosionImpl]; tag: NbtTag): Option[FireworkExplosionImpl] =
  let compoundOpt = extractCompound(tag)
  if compoundOpt.isNone: return none[FireworkExplosionImpl]()
  let compound = compoundOpt.unsafeGet
  let shapeName = getString(compound, "shape")
  if shapeName.isNone: return none[FireworkExplosionImpl]()
  let (known, shape) = fromName(FireworkExplosionShape, shapeName.unsafeGet)
  if not known: return none[FireworkExplosionImpl]()
  let colors = getIntArray(compound, "colors")
  let fadeColors = getIntArray(compound, "fade_colors")
  let hasTrail = getBool(compound, "has_trail")
  let hasTwinkle = getBool(compound, "has_twinkle")
  var colorsVal: seq[int32] = @[]
  if colors.isSome: colorsVal = colors.unsafeGet
  var fadeVal: seq[int32] = @[]
  if fadeColors.isSome: fadeVal = fadeColors.unsafeGet
  some(FireworkExplosionImpl(shape: shape, colors: colorsVal, fadeColors: fadeVal,
    hasTrail: (if hasTrail.isSome: hasTrail.unsafeGet else: false),
    hasTwinkle: (if hasTwinkle.isSome: hasTwinkle.unsafeGet else: false)))

proc writeData*(self: FireworkExplosionImpl): NbtTag =
  var compound = newCompound()
  compound.putString("shape", self.shape.toName())
  compound.put("colors", NbtTag(kind: ntkIntArray, intArrayVal: self.colors))
  compound.put("fade_colors", NbtTag(kind: ntkIntArray, intArrayVal: self.fadeColors))
  compound.putBool("has_trail", self.hasTrail)
  compound.putBool("has_twinkle", self.hasTwinkle)
  newTagCompound(compound)

proc getHash*(self: FireworkExplosionImpl): int32 =
  var digest = newDigest()
  digest.updateByte(2'u8)
  digest.updateByte(uint8(self.shape.toId()))
  for color in self.colors:
    digest.updateU32Le(getI32Hash(color))
  digest.updateByte(3'u8)
  for color in self.fadeColors:
    digest.updateU32Le(getI32Hash(color))
  digest.updateByte(4'u8)
  digest.updateBool(self.hasTrail)
  digest.updateBool(self.hasTwinkle)
  digest.finalizeI32()

func `==`*(a, b: FireworksImpl): bool =
  a.flightDuration == b.flightDuration and a.explosions == b.explosions

proc newFireworksImpl*(flightDuration: int32; explosions: seq[FireworkExplosionImpl]): FireworksImpl =
  FireworksImpl(flightDuration: flightDuration, explosions: explosions)

proc readData*(_: typedesc[FireworksImpl]; tag: NbtTag): Option[FireworksImpl] =
  let compoundOpt = extractCompound(tag)
  if compoundOpt.isNone: return none[FireworksImpl]()
  let compound = compoundOpt.unsafeGet
  var flightDuration = 1'i32
  let asByte = getByte(compound, "flight_duration")
  if asByte.isSome:
    flightDuration = int32(asByte.unsafeGet)
  else:
    let asInt = getInt(compound, "flight_duration")
    if asInt.isSome:
      flightDuration = asInt.unsafeGet
  var explosions: seq[FireworkExplosionImpl] = @[]
  let list = getList(compound, "explosions")
  if list.isSome:
    for item in list.unsafeGet:
      let explosion = readData(FireworkExplosionImpl, item)
      if explosion.isSome:
        explosions.add(explosion.unsafeGet)
  some(FireworksImpl(flightDuration: flightDuration, explosions: explosions))

proc writeData*(self: FireworksImpl): NbtTag =
  var compound = newCompound()
  compound.putInt("flight_duration", self.flightDuration)
  var explosionsList: seq[NbtTag] = @[]
  for e in self.explosions:
    explosionsList.add(e.writeData())
  compound.putList("explosions", explosionsList)
  newTagCompound(compound)

proc getHash*(self: FireworksImpl): int32 =
  var digest = newDigest()
  digest.updateByte(2'u8)
  digest.updateU32Le(getI32Hash(self.flightDuration))
  for explosion in self.explosions:
    digest.updateU32Le(getI32Hash(explosion.getHash()))
  digest.updateByte(3'u8)
  digest.finalizeI32()

func `==`*(a, b: ProfileProperty): bool =
  a.name == b.name and a.value == b.value and a.signature == b.signature

func `==`*(a, b: ProfileImpl): bool =
  a.name == b.name and a.id == b.id and a.properties == b.properties and a.texture == b.texture and
    a.cape == b.cape and a.elytra == b.elytra and a.model == b.model

proc readData*(_: typedesc[ProfileImpl]; data: NbtTag): Option[ProfileImpl] =
  case data.kind
  of ntkString:
    some(ProfileImpl(name: some(data.stringVal), id: none[array[4, int32]](), properties: @[],
      texture: none[string](), cape: none[string](), elytra: none[string](), model: none[string]()))
  of ntkCompound:
    let compound = data.compoundVal
    var id = none[array[4, int32]]()
    let arr = getIntArray(compound, "id")
    if arr.isSome and arr.unsafeGet.len == 4:
      let a = arr.unsafeGet
      id = some([a[0], a[1], a[2], a[3]])
    var properties: seq[ProfileProperty] = @[]
    let propsList = getList(compound, "properties")
    if propsList.isSome:
      for propTag in propsList.unsafeGet:
        if propTag.kind == ntkCompound:
          let propName = getString(propTag.compoundVal, "name")
          let propValue = getString(propTag.compoundVal, "value")
          if propName.isSome and propValue.isSome:
            properties.add(ProfileProperty(name: propName.unsafeGet, value: propValue.unsafeGet,
              signature: getString(propTag.compoundVal, "signature")))
    some(ProfileImpl(name: getString(compound, "name"), id: id, properties: properties,
      texture: getString(compound, "texture"), cape: getString(compound, "cape"),
      elytra: getString(compound, "elytra"), model: getString(compound, "model")))
  else:
    none[ProfileImpl]()

proc writeData*(self: ProfileImpl): NbtTag =
  var compound = newCompound()
  if self.name.isSome:
    compound.putString("name", self.name.unsafeGet)
  if self.id.isSome:
    let a = self.id.unsafeGet
    compound.put("id", NbtTag(kind: ntkIntArray, intArrayVal: @[a[0], a[1], a[2], a[3]]))
  if self.properties.len > 0:
    var propsList: seq[NbtTag] = @[]
    for prop in self.properties:
      var propComp = newCompound()
      propComp.putString("name", prop.name)
      propComp.putString("value", prop.value)
      if prop.signature.isSome:
        propComp.putString("signature", prop.signature.unsafeGet)
      propsList.add(newTagCompound(propComp))
    compound.putList("properties", propsList)
  if self.texture.isSome:
    compound.putString("texture", self.texture.unsafeGet)
  if self.cape.isSome:
    compound.putString("cape", self.cape.unsafeGet)
  if self.elytra.isSome:
    compound.putString("elytra", self.elytra.unsafeGet)
  if self.model.isSome:
    compound.putString("model", self.model.unsafeGet)
  newTagCompound(compound)

proc getHash*(self: ProfileImpl): int32 =
  var digest = newDigest()
  if self.name.isSome:
    digest.updateByte(1'u8)
    digest.updateU32Le(getStrHash(self.name.unsafeGet))
  if self.id.isSome:
    digest.updateByte(2'u8)
    let a = self.id.unsafeGet
    for i in 0 ..< 4:
      digest.updateU32Le(getI32Hash(a[i]))
  if self.properties.len > 0:
    digest.updateByte(3'u8)
    for prop in self.properties:
      digest.updateU32Le(getStrHash(prop.name))
      digest.updateU32Le(getStrHash(prop.value))
      if prop.signature.isSome:
        digest.updateByte(1'u8)
        digest.updateU32Le(getStrHash(prop.signature.unsafeGet))
      else:
        digest.updateByte(0'u8)
  if self.texture.isSome:
    digest.updateByte(4'u8)
    digest.updateU32Le(getStrHash(self.texture.unsafeGet))
  if self.cape.isSome:
    digest.updateByte(5'u8)
    digest.updateU32Le(getStrHash(self.cape.unsafeGet))
  if self.elytra.isSome:
    digest.updateByte(6'u8)
    digest.updateU32Le(getStrHash(self.elytra.unsafeGet))
  if self.model.isSome:
    digest.updateByte(7'u8)
    digest.updateU32Le(getStrHash(self.model.unsafeGet))
  digest.finalizeI32()
