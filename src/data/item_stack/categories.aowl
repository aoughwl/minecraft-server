## Port of pumpkin-data/src/item_stack/categories.rs

import ../../generated/tag
import "mod"

proc isSword*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_SWORDS)

proc isHelmet*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_HEAD_ARMOR)

proc isSkull*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_SKULLS)

proc isChestplate*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_CHEST_ARMOR)

proc isLeggings*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_LEG_ARMOR)

proc isBoots*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_FOOT_ARMOR)

proc isArmor*(self: ItemStack): bool {.inline.} =
  ## `true` if item is in `#minecraft:enchantable/armor` (selects armor Unbreaking formula).
  hasTag(self.item.id, Item_MINECRAFT_ENCHANTABLE_ARMOR)

proc isAxe*(self: ItemStack): bool {.inline.} =
  ## Test-only predicates: identify 2-durability tools (axes/pickaxes/shovels/hoes).
  ## In production, durability cost is data-driven via the `Weapon` component.
  ## These helpers exist only to validate item categorization in tests.
  hasTag(self.item.id, Item_MINECRAFT_AXES)

proc isPickaxe*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_PICKAXES)

proc isShovel*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_SHOVELS)

proc isHoe*(self: ItemStack): bool {.inline.} =
  hasTag(self.item.id, Item_MINECRAFT_HOES)
