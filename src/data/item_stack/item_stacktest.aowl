## The `#[cfg(test)]` vectors of pumpkin-data/src/item_stack/mod.rs, in upstream's order, then known answers for
## what they leave out: tool rules, the NBT form, bundles and containers.

import std/[syncio, assertions]
import "mod"
import categories
import ../../util/gamemode
import ../blocks
import ../block_ext
import ../../generated/block_properties

proc ironSword(): ItemStack =
  ## Helper: creates a fresh Iron Sword (max_damage 250, damage 0).
  newItemStack(1'u8, ITEM_IRON_SWORD)

proc blockNamed(name: string): Block =
  let found = fromName(Block, name)
  if found != nil:
    return found
  quit(1)
  gBlocks[0]

proc tagByte(v: int8): NbtTag = NbtTag(kind: ntkByte, byteVal: v)
proc tagString(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)

block itemsWithDifferentComponentsAreNotEqualInEitherDirection:
  let plain = newItemStack(1'u8, ITEM_COAL)
  var customized = newItemStack(1'u8, ITEM_COAL)
  customized.patch.add(patchSet(toDyn(UnbreakableImpl())))
  assert not plain.areItemsAndComponentsEqual(customized)
  assert not customized.areItemsAndComponentsEqual(plain)
  let clone = customized
  assert customized.areItemsAndComponentsEqual(clone)

block customDataSetsAndReadsTypedValues:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  stack.setCustomData("test_plugin", "marker", tagByte(1'i8))
  stack.setCustomData("test_plugin", "mode", tagString("pos1"))
  stack.setCustomData("test_plugin", "payload", NbtTag(kind: ntkByteArray, byteArrayVal: @[0'i8, 1'i8, 127'i8, -128'i8, -1'i8]))
  assert stack.getCustomData("test_plugin", "marker").unsafeGet == tagByte(1'i8)
  assert stack.getCustomData("test_plugin", "mode").unsafeGet == tagString("pos1")
  assert stack.getCustomData("test_plugin", "payload").unsafeGet ==
    NbtTag(kind: ntkByteArray, byteArrayVal: @[0'i8, 1'i8, 127'i8, -128'i8, -1'i8])
  assert stack.hasCustomData("test_plugin", "marker")

block customDataSetsAndReadsFullNbtTags:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  var compound = newCompound()
  compound.insert("byte", tagByte(1'i8))
  compound.insert("short", NbtTag(kind: ntkShort, shortVal: 2'i16))
  compound.insert("int", NbtTag(kind: ntkInt, intVal: 3'i32))
  compound.insert("long", NbtTag(kind: ntkLong, longVal: 4'i64))
  compound.insert("float", NbtTag(kind: ntkFloat, floatVal: 5.0'f32))
  compound.insert("double", NbtTag(kind: ntkDouble, doubleVal: 6.0'f64))
  compound.insert("string", tagString("value"))
  compound.insert("list", NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkInt, intVal: 1'i32), NbtTag(kind: ntkInt, intVal: 2'i32)]))
  compound.insert("byte_array", NbtTag(kind: ntkByteArray, byteArrayVal: @[1'i8, 2'i8]))
  compound.insert("int_array", NbtTag(kind: ntkIntArray, intArrayVal: @[3'i32, 4'i32]))
  compound.insert("long_array", NbtTag(kind: ntkLongArray, longArrayVal: @[5'i64, 6'i64]))
  let tag = NbtTag(kind: ntkCompound, compoundVal: compound)
  stack.setCustomData("test_plugin", "full", tag)
  assert stack.getCustomData("test_plugin", "full").unsafeGet == tag

block customDataPreservesSiblingNamespacesAndKeys:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  stack.setCustomData("test_plugin", "marker", tagByte(1'i8))
  stack.setCustomData("test_plugin", "mode", tagString("pos1"))
  stack.setCustomData("other_plugin", "flag", tagByte(1'i8))
  stack.setCustomData("test_plugin", "marker", tagByte(0'i8))
  assert stack.getCustomData("test_plugin", "marker").unsafeGet == tagByte(0'i8)
  assert stack.getCustomData("test_plugin", "mode").unsafeGet == tagString("pos1")
  assert stack.getCustomData("other_plugin", "flag").unsafeGet == tagByte(1'i8)

block removeCustomDataRemovesOnlyTargetKeyAndCleansEmptyComponent:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  stack.setCustomData("test_plugin", "marker", tagByte(1'i8))
  stack.setCustomData("test_plugin", "mode", tagString("pos1"))
  stack.setCustomData("other_plugin", "flag", tagByte(1'i8))
  stack.removeCustomData("test_plugin", "marker")
  assert not stack.hasCustomData("test_plugin", "marker")
  assert stack.getCustomData("test_plugin", "mode").unsafeGet == tagString("pos1")
  assert stack.getCustomData("other_plugin", "flag").unsafeGet == tagByte(1'i8)
  assert stack.getDataComponent(CustomDataImpl)[0]
  stack.removeCustomData("test_plugin", "mode")
  stack.removeCustomData("other_plugin", "flag")
  assert not stack.getDataComponent(CustomDataImpl)[0]

block customDataPreservesOtherItemComponents:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  stack.patch.add(patchSet(toDyn(CustomNameImpl(name: text("Marked Item")))))
  stack.patch.add(patchSet(toDyn(UnbreakableImpl())))
  stack.setCustomData("test_plugin", "marker", tagByte(1'i8))
  stack.removeCustomData("test_plugin", "missing")
  assert stack.getDataComponent(CustomNameImpl)[0]
  assert stack.getDataComponent(UnbreakableImpl)[0]
  assert stack.getCustomData("test_plugin", "marker").unsafeGet == tagByte(1'i8)

block customDataSurvivesItemStackNbtRoundtrip:
  var stack = newItemStack(1'u8, ITEM_WOODEN_AXE)
  stack.setCustomData("test_plugin", "marker", tagByte(1'i8))
  stack.setCustomData("test_plugin", "mode", tagString("pos1"))
  stack.patch.add(patchSet(toDyn(UnbreakableImpl())))
  var compound = newCompound()
  stack.writeItemStack(compound)
  let decoded = readItemStack(compound).unsafeGet
  assert decoded.getCustomData("test_plugin", "marker").unsafeGet == tagByte(1'i8)
  assert decoded.getCustomData("test_plugin", "mode").unsafeGet == tagString("pos1")
  assert decoded.getDataComponent(UnbreakableImpl)[0]

# ── damage_item ───────────────────────────────────────────────

block damageZeroAmountIsNoop:
  var stack = ironSword()
  assert stack.damageItem(0'i32) == drUntouched
  assert stack.getDamage() == 0'i32

block damageNegativeAmountIsNoop:
  for amount in [-1'i32, -5'i32, -10'i32, -100'i32]:
    var stack = ironSword()
    assert stack.damageItem(amount) == drUntouched
    assert stack.getDamage() == 0'i32

block damageNonDamageableItemIsNoop:
  # AIR has no MaxDamage component.
  var stack = newItemStack(1'u8, ITEM_AIR)
  assert stack.damageItem(1'i32) == drUntouched

block damageUnbreakableItemIsNoop:
  for amount in [1'i32, 5'i32, 10'i32, 100'i32, 250'i32]:
    var stack = ironSword()
    stack.patch.add(patchSet(toDyn(UnbreakableImpl())))
    assert stack.damageItem(amount) == drUntouched
    assert stack.getDamage() == 0'i32

block damageIncreasesDamageValue:
  # Without Unbreaking, every point of damage is applied.
  for c in [(1'i32, 1'i32), (5'i32, 5'i32), (10'i32, 10'i32), (100'i32, 100'i32), (249'i32, 249'i32)]:
    var stack = ironSword()
    assert stack.damageItem(c[0]) == drDamaged
    assert stack.getDamage() == c[1]

block damageAccumulates:
  # Each entry: (first_amount, second_amount, expected_total)
  for c in [(100'i32, 50'i32, 150'i32), (10'i32, 20'i32, 30'i32), (1'i32, 1'i32, 2'i32), (50'i32, 100'i32, 150'i32)]:
    var stack = ironSword()
    discard stack.damageItem(c[0])
    discard stack.damageItem(c[1])
    assert stack.getDamage() == c[2]

block damageBreaksItemWhenExceedingMax:
  # Iron Sword max_damage = 250; any amount >= 250 should destroy it.
  for amount in [250'i32, 260'i32, 300'i32, 1000'i32]:
    var stack = ironSword()
    assert stack.damageItem(amount) == drBroken
    assert stack.isEmpty()

block damageBreaksSingleItemToEmpty:
  var stack = ironSword()
  discard stack.damageItem(300'i32)
  assert stack.isEmpty()
  assert stack.itemCount == 0'u8

# ── repair_item ──────────────────────────────────────────────────

block repairZeroAmountIsNoop:
  for initial in [1'i32, 5'i32, 10'i32, 100'i32, 249'i32]:
    var stack = ironSword()
    stack.setDamage(initial)
    assert stack.repairItem(0'i32) == 0'i32
    assert stack.getDamage() == initial

block repairNegativeAmountIsNoop:
  for amount in [-1'i32, -5'i32, -10'i32, -100'i32]:
    var stack = ironSword()
    stack.setDamage(10'i32)
    assert stack.repairItem(amount) == 0'i32
    assert stack.getDamage() == 10'i32

block repairUndamagedItemIsNoop:
  for amount in [1'i32, 5'i32, 10'i32, 100'i32]:
    var stack = ironSword()
    assert stack.repairItem(amount) == 0'i32
    assert stack.getDamage() == 0'i32

block repairPartial:
  # Each entry: (initial_damage, repair_amount, expected_repaired, expected_remaining)
  for c in [(20'i32, 8'i32, 8'i32, 12'i32), (50'i32, 25'i32, 25'i32, 25'i32), (100'i32, 30'i32, 30'i32, 70'i32),
            (249'i32, 1'i32, 1'i32, 248'i32)]:
    var stack = ironSword()
    stack.setDamage(c[0])
    let repaired = stack.repairItem(c[1])
    assert repaired == c[2]
    assert stack.getDamage() == c[3]

block repairCappedAtCurrentDamage:
  # Each entry: (initial_damage, repair_amount); repair exceeds damage, so repaired == initial.
  for c in [(5'i32, 6'i32), (5'i32, 100'i32), (10'i32, 11'i32), (100'i32, 200'i32)]:
    var stack = ironSword()
    stack.setDamage(c[0])
    assert stack.repairItem(c[1]) == c[0]
    assert stack.getDamage() == 0'i32

block repairFullyClearsDamageComponent:
  var stack = ironSword()
  stack.setDamage(10'i32)
  discard stack.repairItem(10'i32)
  assert stack.getDamage() == 0'i32
  # set_damage(0) removes the Damage patch entry.
  for entry in stack.patch:
    assert entry.id != dcDamage

# ── stacked item breaking ────────────────────────────────────────

block damageStackedItemBreaksOneAndResetsDurability:
  # Two Iron Swords (max_damage 250) at damage 249, one hit away from breaking.
  # Without Unbreaking the damage roll is always applied, so this is deterministic.
  var stack = newItemStack(2'u8, ITEM_IRON_SWORD)
  stack.setDamage(249'i32)
  let res = stack.damageItem(1'i32)
  assert res == drBroken
  assert stack.itemCount == 1'u8
  assert stack.getDamage() == 0'i32
  assert not stack.isEmpty()

# ── weapon category predicates ───────────────────────────────────

block weaponCategoriesIdentify2CostItems:
  # 2-durability combat weapons (axes/pickaxes/shovels/hoes) must match their category predicate.
  for item in [ITEM_WOODEN_AXE, ITEM_STONE_AXE, ITEM_IRON_AXE, ITEM_GOLDEN_AXE, ITEM_DIAMOND_AXE, ITEM_NETHERITE_AXE]:
    let stack = newItemStack(1'u8, item)
    assert stack.isAxe()
    assert not stack.isSword()
  for item in [ITEM_WOODEN_PICKAXE, ITEM_STONE_PICKAXE, ITEM_IRON_PICKAXE, ITEM_GOLDEN_PICKAXE, ITEM_DIAMOND_PICKAXE,
               ITEM_NETHERITE_PICKAXE]:
    assert newItemStack(1'u8, item).isPickaxe()
  for item in [ITEM_WOODEN_SHOVEL, ITEM_STONE_SHOVEL, ITEM_IRON_SHOVEL, ITEM_GOLDEN_SHOVEL, ITEM_DIAMOND_SHOVEL,
               ITEM_NETHERITE_SHOVEL]:
    assert newItemStack(1'u8, item).isShovel()
  for item in [ITEM_WOODEN_HOE, ITEM_STONE_HOE, ITEM_IRON_HOE, ITEM_GOLDEN_HOE, ITEM_DIAMOND_HOE, ITEM_NETHERITE_HOE]:
    assert newItemStack(1'u8, item).isHoe()
  # Swords should cost 1, so they must NOT match any 2-cost predicate.
  for item in [ITEM_IRON_SWORD, ITEM_DIAMOND_SWORD, ITEM_NETHERITE_SWORD]:
    let stack = newItemStack(1'u8, item)
    assert stack.isSword()
    assert not stack.isAxe()
    assert not stack.isPickaxe()

# ── Unbreaking (statistical) ─────────────────────────────────────

proc withUnbreaking(item: Item; level: int32): ItemStack =
  ## Helper: iron sword with Unbreaking at `level`.
  result = newItemStack(1'u8, item)
  result.patch.add(patchSet(toDyn(EnchantmentsImpl(enchantment: @[EnchantmentEntry(
    enchantment: ENCHANTMENT_UNBREAKING, level: level)]))))

block unbreakingIiiToolAppliesRoughly25PercentOfHits:
  # Unbreaking III tool: 25% apply probability. 4 000 trials, expect ~1 000 hits (window 865 to 1135).
  var stack = withUnbreaking(ITEM_NETHERITE_PICKAXE, 3'i32)
  var applied = 0
  for i in 0 ..< 4000:
    if stack.damageItem(1'i32) != drUntouched:
      inc applied
  assert applied >= 865 and applied <= 1135

block unbreakingIiiArmorAppliesRoughly70PercentOfHits:
  # Unbreaking III armor: 70% apply probability. 500 trials, expect ~350 hits (window 300 to 400).
  var stack = withUnbreaking(ITEM_DIAMOND_CHESTPLATE, 3'i32)
  var applied = 0
  for i in 0 ..< 500:
    if stack.damageItem(1'i32) != drUntouched:
      inc applied
  assert applied >= 300 and applied <= 400

# ── set_damage ───────────────────────────────────────────────────

block setDamageNegativeClampsToZero:
  for amount in [-1'i32, -10'i32, -100'i32, int32.low]:
    var stack = ironSword()
    stack.setDamage(amount)
    assert stack.getDamage() == 0'i32

# ── Past upstream's own vectors ──────────────────────────────────

block emptyAndCounts:
  let empty = emptyItemStack()
  assert empty.isEmpty()
  assert empty.getItem().id == ITEM_AIR.id
  var stack = newItemStack(10'u8, ITEM_COAL)
  assert stack.getMaxStackSize() == 64'u8
  assert stack.isStackable()
  assert not ironSword().isStackable()
  let half = stack.split(4'u8)
  assert half.itemCount == 4'u8
  assert stack.itemCount == 6'u8
  let over = stack.splitOff(100'u8)
  assert over.itemCount == 6'u8
  assert stack.itemCount == 0'u8
  stack.setCount(250'u8)
  stack.increment(10'u8)
  assert stack.itemCount == 255'u8
  stack.decrement(255'u8)
  assert stack.itemCount == 0'u8
  # Each new stack takes a fresh uid; the Java-only one is always 1.
  assert newItemStack(1'u8, ITEM_COAL).uid != newItemStack(1'u8, ITEM_COAL).uid
  assert staticNewJava(1'u8, ITEM_COAL).uid == 1'i32
  var gen = newItemStackIdGenerator()
  assert gen.nextId() == 1'i32
  assert gen.nextId() == 2'i32

block gamemodeSplits:
  var stack = newItemStack(10'u8, ITEM_COAL)
  discard stack.splitUnlessCreative(Creative, 3'u8)
  assert stack.itemCount == 10'u8
  discard stack.splitUnlessCreative(Survival, 3'u8)
  assert stack.itemCount == 7'u8
  stack.decrementUnlessCreative(Creative, 7'u8)
  assert stack.itemCount == 7'u8
  stack.decrementUnlessCreative(Survival, 7'u8)
  assert stack.isEmpty()
  assert stack.item.id == ITEM_AIR.id

block enchanting:
  var stack = newItemStack(1'u8, ITEM_IRON_SWORD)
  assert not stack.hasEnchantments()
  stack.enchant(ENCHANTMENT_SHARPNESS, 2'i32)
  assert stack.hasEnchantments()
  assert stack.getEnchantmentLevel(ENCHANTMENT_SHARPNESS) == 2'i32
  assert stack.getEnchantmentLevel(ENCHANTMENT_UNBREAKING) == 0'i32
  stack.enchant(ENCHANTMENT_SHARPNESS, 1'i32)
  assert stack.getEnchantmentLevel(ENCHANTMENT_SHARPNESS) == 2'i32
  stack.enchant(ENCHANTMENT_SHARPNESS, 1000'i32)
  assert stack.getEnchantmentLevel(ENCHANTMENT_SHARPNESS) == 255'i32
  stack.enchant(ENCHANTMENT_UNBREAKING, 3'i32)
  assert stack.getEnchantmentLevel(ENCHANTMENT_UNBREAKING) == 3'i32
  stack.enchant(ENCHANTMENT_MENDING, 0'i32)
  assert stack.getEnchantmentLevel(ENCHANTMENT_MENDING) == 0'i32
  # The item's own, empty enchantments were cloned to the patch, not changed.
  let (found, own) = findComponent(newItemStack(1'u8, ITEM_IRON_SWORD), dcEnchantments)
  assert found and own.enchantments.enchantment.len == 0
  var added = newItemStack(1'u8, ITEM_IRON_SWORD)
  added.addEnchantment(ENCHANTMENT_MENDING, 1'u16)
  assert added.getEnchantmentLevel(ENCHANTMENT_MENDING) == 1'i32

block removedComponent:
  # A `None` patch entry hides the item's own component.
  var stack = newItemStack(1'u8, ITEM_COAL)
  assert stack.getDataComponent(MaxStackSizeImpl)[0]
  stack.patch.add(patchRemoved(dcMaxStackSize))
  assert not stack.getDataComponent(MaxStackSizeImpl)[0]
  assert stack.getMaxStackSize() == 1'u8
  assert not stack.hasDataComponent(dcMaxStackSize)
  assert stack.getDataComponentMut(MaxStackSizeImpl) == -1

block equality:
  var a = newItemStack(1'u8, ITEM_COAL)
  var b = newItemStack(2'u8, ITEM_COAL)
  assert a.areItemsAndComponentsEqual(b)
  assert not a.areEqual(b)
  b.setCount(1'u8)
  assert a.areEqual(b)
  assert not a.areEqual(newItemStack(1'u8, ITEM_CHARCOAL))
  a.setDamage(4'i32)
  b.setDamage(5'i32)
  assert not a.areEqual(b)
  b.setDamage(4'i32)
  assert a.areEqual(b)
  a.patch.add(patchRemoved(dcLore))
  b.patch.add(patchSet(toDyn(LoreImpl())))
  assert not a.areEqual(b)

block useTimes:
  assert newItemStack(1'u8, ITEM_SHIELD).getMaxUseTime() == 72000'i32
  # The default of 1.6 seconds, written through upstream's `{:.1}`.
  assert newItemStack(1'u8, ITEM_APPLE).getMaxUseTime() == 32'i32
  assert newItemStack(1'u8, ITEM_COAL).getMaxUseTime() == 0'i32
  let (found, cooldown) = newItemStack(1'u8, ITEM_CHORUS_FRUIT).getDataComponent(UseCooldownImpl)
  assert found and cooldown.seconds == 1.0'f32
  assert newItemStack(1'u8, ITEM_CHORUS_FRUIT).getUseCooldown().isSome
  assert not newItemStack(1'u8, ITEM_COAL).getUseCooldown().isSome

block toolRules:
  let cobweb = blockNamed("cobweb")
  let stone = blockNamed("stone")
  let dirt = blockNamed("dirt")
  let sword = newItemStack(1'u8, ITEM_IRON_SWORD)
  # The rule that names the block itself: speed 15, correct for drops.
  assert sword.getSpeed(cobweb) == 15.0'f32
  assert sword.isCorrectForDrops(cobweb)
  assert sword.getSpeed(dirt) == 1.0'f32
  assert not sword.isCorrectForDrops(dirt)
  let pick = newItemStack(1'u8, ITEM_IRON_PICKAXE)
  # By tag: minecraft:mineable/pickaxe, at the iron tier's speed.
  assert pick.getSpeed(stone) == 6.0'f32
  assert pick.isCorrectForDrops(stone)
  assert pick.getSpeed(dirt) == 1.0'f32
  # No tool at all.
  assert newItemStack(1'u8, ITEM_COAL).getSpeed(stone) == 1.0'f32
  assert not newItemStack(1'u8, ITEM_COAL).isCorrectForDrops(stone)

block categoriesOfArmor:
  assert newItemStack(1'u8, ITEM_DIAMOND_HELMET).isHelmet()
  assert newItemStack(1'u8, ITEM_DIAMOND_CHESTPLATE).isChestplate()
  assert newItemStack(1'u8, ITEM_DIAMOND_LEGGINGS).isLeggings()
  assert newItemStack(1'u8, ITEM_DIAMOND_BOOTS).isBoots()
  assert newItemStack(1'u8, ITEM_DIAMOND_BOOTS).isArmor()
  assert not newItemStack(1'u8, ITEM_COAL).isArmor()
  assert newItemStack(1'u8, ITEM_SKELETON_SKULL).isSkull()

block nbtForm:
  var stack = newItemStack(3'u8, ITEM_IRON_SWORD)
  stack.setDamage(7'i32)
  stack.patch.add(patchRemoved(dcLore))
  var compound = newCompound()
  stack.writeItemStack(compound)
  assert compound.getString("id").unsafeGet == "minecraft:iron_sword"
  assert compound.getInt("count").unsafeGet == 3'i32
  let components = compound.getCompound("components").unsafeGet
  assert components.getInt("minecraft:damage").unsafeGet == 7'i32
  assert components.getCompound("!minecraft:lore").isSome
  let back = readItemStack(compound).unsafeGet
  assert back.areEqual(stack)
  assert back.getDamage() == 7'i32
  # Refusals, each as upstream.
  var noId = newCompound()
  noId.putInt("count", 1'i32)
  assert not readItemStack(noId).isSome
  var unknown = newCompound()
  unknown.putString("id", "minecraft:no_such_item")
  unknown.putInt("count", 1'i32)
  assert not readItemStack(unknown).isSome
  var noCount = newCompound()
  noCount.putString("id", "stone")
  assert not readItemStack(noCount).isSome
  var badComponent = newCompound()
  badComponent.putString("id", "stone")
  badComponent.putInt("count", 1'i32)
  var bad = newCompound()
  bad.putInt("minecraft:not_a_component", 1'i32)
  badComponent.putCompound("components", bad)
  assert not readItemStack(badComponent).isSome
  var noForm = newCompound()
  noForm.putString("id", "stone")
  noForm.putInt("count", 1'i32)
  var noFormComponents = newCompound()
  # No arm for minecraft:lore in `read_data`.
  noFormComponents.putCompound("minecraft:lore", newCompound())
  noForm.putCompound("components", noFormComponents)
  assert not readItemStack(noForm).isSome

block readDataDispatch:
  let damage = readData(dcDamage, NbtTag(kind: ntkInt, intVal: 5'i32)).unsafeGet
  assert damage.damage.damage == 5'i32
  assert not readData(dcDamage, NbtTag(kind: ntkString, stringVal: "x")).isSome
  let variant = readData(dcSheepColor, NbtTag(kind: ntkString, stringVal: "red")).unsafeGet
  assert variant.stringVariant == "red"
  assert readData(dcGlider, NbtTag(kind: ntkEnd)).unsafeGet.kind == dcGlider
  assert not readData(dcLore, NbtTag(kind: ntkEnd)).isSome

block containerAndBundle:
  var one = newCompound()
  newItemStack(2'u8, ITEM_COAL).writeItemStack(one)
  var slotted = newCompound()
  slotted.putInt("slot", 4'i32)
  slotted.putCompound("item", one)
  let container = readData(ContainerImpl, NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkCompound, compoundVal: slotted)])).unsafeGet
  assert container.items.len == 1
  assert container.items[0].slot == 4'u8
  assert container.items[0].stack.itemCount == 2'u8

  let viaDispatch = readData(dcBundleContents, NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkCompound, compoundVal: one)])).unsafeGet
  assert viaDispatch.bundleContents.items[0].item.id == ITEM_COAL.id

  var bundle = BundleContentsImpl(items: @[])
  var coal = newItemStack(10'u8, ITEM_COAL)
  assert bundle.tryInsert(coal)
  assert coal.itemCount == 0'u8
  assert bundle.items.len == 1
  assert bundle.items[0].itemCount == 10'u8
  assert bundle.getWeight() == 10'u32
  # A sword weighs a whole bundle, so it fills what is left only when nothing else is in.
  var sword = newItemStack(1'u8, ITEM_IRON_SWORD)
  assert not bundle.tryInsert(sword)
  assert sword.itemCount == 1'u8
  # A different item goes on top.
  var charcoal = newItemStack(1'u8, ITEM_CHARCOAL)
  assert bundle.tryInsert(charcoal)
  assert bundle.items[0].item.id == ITEM_CHARCOAL.id
  # No bundle in a bundle, and nothing from an empty stack.
  var inner = newItemStack(1'u8, ITEM_BUNDLE)
  assert not bundle.tryInsert(inner)
  var none0 = emptyItemStack()
  assert not bundle.tryInsert(none0)
  assert bundle.tryExtract().unsafeGet.item.id == ITEM_CHARCOAL.id
  assert bundle.tryExtract().unsafeGet.item.id == ITEM_COAL.id
  assert not bundle.tryExtract().isSome

block recipeResult:
  assert fromRecipeResult("minecraft:coal", 4'u8).itemCount == 4'u8
  assert fromRecipeResult("coal", 4'u8).item.id == ITEM_COAL.id

echo "item_stack tests passed"
