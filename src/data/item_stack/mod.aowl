proc readData*(_: typedesc[ContainerImpl]; tag: NbtTag): Option[ContainerImpl] =
  var items: seq[ContainerSlot] = @[]
  if tag.kind == ntkList:
    for itemTag in tag.listVal:
      if itemTag.kind == ntkCompound:
        let slot = getInt(itemTag.compoundVal, "slot")
        let itemCompound = getCompound(itemTag.compoundVal, "item")
        if slot.isSome and itemCompound.isSome:
          let stack = readItemStack(itemCompound.unsafeGet)
          if stack.isSome:
            # `slot as u8`.
            items.add(ContainerSlot(slot: uint8(cast[uint32](slot.unsafeGet) and 0xFF'u32), stack: stack.unsafeGet))
  some(ContainerImpl(items: items))

proc readData*(_: typedesc[BundleContentsImpl]; tag: NbtTag): Option[BundleContentsImpl] =
  var items: seq[ItemStack] = @[]
  if tag.kind == ntkList:
    for itemTag in tag.listVal:
      if itemTag.kind == ntkCompound:
        let stack = readItemStack(itemTag.compoundVal)
        if stack.isSome:
          items.add(stack.unsafeGet)
  some(BundleContentsImpl(items: items))

proc getWeight*(self: BundleContentsImpl): uint32 =
  result = 0'u32
  for item in self.items:
    result += uint32(item.itemCount) * max(64'u32 div uint32(item.getMaxStackSize()), 1'u32)

proc tryInsert*(self: var BundleContentsImpl; stack: var ItemStack): bool =
  if stack.isEmpty() or stack.hasDataComponent(dcBundleContents):
    return false
  let weightPerItem = max(64'u32 div uint32(stack.getMaxStackSize()), 1'u32)
  var insertedAnything = false
  while stack.itemCount > 0'u8 and self.getWeight() + weightPerItem <= 64'u32:
    if self.items.len > 0 and areItemsAndComponentsEqual(self.items[0], stack) and
        self.items[0].itemCount < self.items[0].getMaxStackSize():
      self.items[0].itemCount = self.items[0].itemCount + 1'u8
      stack.itemCount = stack.itemCount - 1'u8
      insertedAnything = true
      continue
    # `self.items.insert(0, ..)`.
    var moved = @[stack.copyWithCount(1'u8)]
    for existing in self.items:
      moved.add(existing)
    self.items = moved
    stack.itemCount = stack.itemCount - 1'u8
    insertedAnything = true
  insertedAnything

proc tryExtract*(self: var BundleContentsImpl): Option[ItemStack] =
  if self.items.len == 0:
    none[ItemStack]()
  else:
    let first = self.items[0]
    self.items.delete(0)
    some(first)

proc readItemStack*(compound: NbtCompound): Option[ItemStack] =
  # Get ID, which is a string like "minecraft:diamond_sword"
  let fullId = getString(compound, "id")
  if fullId.isNone:
    return none[ItemStack]()
  # Try to get item by registry key; this removes the "minecraft:" prefix if present.
  let item = fromRegistryKey(Item, fullId.unsafeGet)
  if item == nil:
    return none[ItemStack]()
  let count = getInt(compound, "count")
  if count.isNone:
    return none[ItemStack]()
  # Create the item stack; `count as u8`.
  var itemStack = newItemStack(uint8(cast[uint32](count.unsafeGet) and 0xFF'u32), item)
  # Process any additional data in the components compound
  let tag = getCompound(compound, "components")
  if tag.isSome:
    let components = tag.unsafeGet
    for i in 0 ..< components.names.len:
      let name = components.names[i]
      if name.len > 0 and name[0] == '!':
        let (known, id) = tryFromName(substr(name, 1, name.len - 1))
        if not known:
          return none[ItemStack]()
        itemStack.patch.add(patchRemoved(id))
      else:
        let (known, id) = tryFromName(name)
        if not known:
          return none[ItemStack]()
        let data = readData(id, components.values[i])
        if data.isNone:
          return none[ItemStack]()
        itemStack.patch.add(patchSet(data.unsafeGet))
  some(itemStack)

proc fromRecipeResult*(id: string; count: uint8): ItemStack =
  ## `impl From<&RecipeResultStruct> for ItemStack`.
  let item = fromRegistryKey(Item, id)
  if item == nil:
    return emptyItemStack()
  newItemStack(count, item)
