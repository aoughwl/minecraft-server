## Known answers read from upstream's pumpkin-data/src/generated/advancement.rs, positions included.

import std/[assertions, options, syncio, tables]
import ../generated/advancement

assert gAdvancements.len == 1688
assert Advancement.getAdvancementsList().len == 1688
assert Advancement.getIdentifierList().len == 1688

let root = Advancement.STORY_ROOT
assert root.id == vanillaStatic("story/root")
assert root.parent.isNone
assert root.isRoot
assert root.sendTelemetry
assert root.requirements == @[@["crafting_table"]]
assert root.criteria == @["crafting_table"]
assert root.reward.experience == 0'i32
let d = root.display.get
assert d.title == "advancements.story.root.title"
assert d.description == "advancements.story.root.description"
assert d.itemIcon == "grass_block"
assert d.frameType == FrameType.Task
assert d.backgroundTexture.get == "minecraft:gui/advancements/backgrounds/stone"
assert not d.showToast
assert not d.hidden
assert not d.announceToChat
assert d.x == 0.0'f32
assert d.y == 1.75'f32

let mine = Advancement.STORY_MINE_STONE
assert mine.parent.get == fromStatic("minecraft", "story/root")
assert mine.display.get.x == 1.0'f32
assert mine.display.get.y == 1.75'f32
assert mine.display.get.showToast
assert not mine.isRoot

assert Advancement.fromName("story/root").get == root
assert Advancement.fromMinecraftName("minecraft:story/root").get == root
assert Advancement.fromName("nope").isNone
assert Advancement.fromMinecraftName("story/root").isNone

assert ADVANCEMENT_TREE.nodesVector.len == 1688
assert ADVANCEMENT_TREE.roots == @[0, 10, 11, 19, 20, 107]
assert ADVANCEMENT_TREE.tasks[0] == 1
assert ADVANCEMENT_TREE.tasks.len == 1688 - 6
assert ADVANCEMENT_TREE.nodes.getOrDefault(fromStatic("minecraft", "story/smelt_iron"), -1) == 1672
assert ADVANCEMENT_TREE.nodesVector[0].parent.isNone

echo "advancement: all checks passed"
