assert netherAt([4000'i64, 3000'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64]) == "crimson_forest"
assert netherAt([-1000'i64, -3000'i64, 0'i64, 0'i64, 0'i64, 0'i64, 2000'i64]) == "soul_sand_valley"

# Passing the previous result back must not change the answer.
var previous = -1'i32
let firstAnswer = OVERWORLD_BIOME_SOURCE.get([0'i64, 0, 0, 0, 0, 0, 0], previous).registryId
assert previous >= 0
assert OVERWORLD_BIOME_SOURCE.get([0'i64, 0, 0, 0, 0, 0, 0], previous).registryId == firstAnswer
echo "biome: all checks passed"
