assert overworldAt([4876'i64, 11016'i64, 1801'i64, -6276'i64, 7153'i64, 1330'i64, 0'i64]) == "lush_caves"
assert netherAt([0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64]) == "nether_wastes"
assert netherAt([-5000'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64]) == "basalt_deltas"
