assert overworldAt([6233'i64, -9934'i64, 9123'i64, -2091'i64, 3762'i64, 11929'i64, 0'i64]) == "dripstone_caves"
assert overworldAt([-360'i64, -3269'i64, -3836'i64, 9478'i64, -5446'i64, 5428'i64, 0'i64]) == "ocean"
assert overworldAt([5372'i64, 9804'i64, -11368'i64, 4649'i64, -9687'i64, -1906'i64, 0'i64]) == "mushroom_fields"
assert overworldAt([-1072'i64, -7289'i64, 11265'i64, 3493'i64, 9540'i64, 4182'i64, 0'i64]) == "sunflower_plains"
