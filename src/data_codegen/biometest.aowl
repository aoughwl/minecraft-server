assert overworldAt([-684'i64, -8456'i64, 11024'i64, 10941'i64, -6850'i64, 7509'i64, 0'i64]) == "sunflower_plains"
assert overworldAt([-3175'i64, -6926'i64, 11597'i64, -1400'i64, 2636'i64, 9807'i64, 0'i64]) == "dripstone_caves"
