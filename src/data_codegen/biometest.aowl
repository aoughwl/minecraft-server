## Known answers from pumpkin-data/src/generated/biome.rs. The tree searches' answers come from the
## same search run over that file's tree in a scratch script.
import std/[assertions, syncio]
import ../generated/biome

assert ALL.len == 66
assert ALL[0].registryId == "badlands"

let plains = Biome.fromName("plains")
assert plains != nil
assert plains.id == 40'u8
assert plains == 40'u8
assert plains.beNetworkId == 1'u8
assert plains.weather.hasPrecipitation
assert plains.weather.temperature == 0.8'f32
assert plains.weather.temperatureModifier == TemperatureModifier.None
assert plains.weather.downfall == 0.4'f32
assert plains.features[0].len == 0
assert plains.features[1] == @[PlacedFeature.LakeLavaUnderground, PlacedFeature.LakeLavaSurface]
assert plains.features[2] == @[PlacedFeature.AmethystGeode]
assert plains.spawners.monster[0].`type` == "minecraft:spider"
assert plains.spawners.monster[0].minCount == 4'i32
assert plains.spawners.monster[1].`type` == "minecraft:zombie"
assert PLAINS.id == plains.id

let frozen = Biome.fromName("frozen_ocean")
assert frozen != nil
assert frozen.id == 22'u8 and frozen.beNetworkId == 46'u8
assert frozen.weather.temperatureModifier == TemperatureModifier.Frozen

let soul = Biome.fromName("soul_sand_valley")
assert soul != nil
let (hasCost, cost) = soul.spawnCost("enderman")
assert hasCost and cost.energyBudget == 0.15 and cost.charge == 0.7
assert not soul.spawnCost("zombie")[0]

let byId = Biome.fromId(40'u8)
assert byId != nil and byId.registryId == "plains"
assert Biome.fromId(200'u8) == nil
assert Biome.fromName("minecraft:plains") == nil
let viaDeserialize = deserializeBiome("minecraft:plains")
assert viaDeserialize != nil and viaDeserialize.id == 40'u8

assert calcDistance(ParameterRange(min: -5'i64, max: 5'i64), 7'i64) == 2'i64
assert calcDistance(ParameterRange(min: -5'i64, max: 5'i64), -7'i64) == 2'i64
assert calcDistance(ParameterRange(min: -5'i64, max: 5'i64), 0'i64) == 0'i64

assert OVERWORLD_BIOME_SOURCE.nodes.len == 9112
assert NETHER_BIOME_SOURCE.nodes.len == 6

proc overworldAt(p: array[7, int64]): string =
  var previous = -1'i32
  OVERWORLD_BIOME_SOURCE.get(p, previous).registryId

proc netherAt(p: array[7, int64]): string =
  var previous = -1'i32
  NETHER_BIOME_SOURCE.get(p, previous).registryId

assert overworldAt([0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64]) == "river"
assert overworldAt([-10000'i64, -10000'i64, -10000'i64, -10000'i64, -10000'i64, -10000'i64, 0'i64]) == "deep_frozen_ocean"
assert overworldAt([10000'i64, 10000'i64, 10000'i64, 10000'i64, 10000'i64, 10000'i64, 10000'i64]) == "mangrove_swamp"
assert overworldAt([2441'i64, -8172'i64, -11755'i64, -9030'i64, 7078'i64, -1428'i64, 0'i64]) == "mushroom_fields"
assert overworldAt([10005'i64, 10711'i64, -9250'i64, -8775'i64, -380'i64, 1879'i64, 0'i64]) == "warm_ocean"
assert overworldAt([-11429'i64, -10991'i64, -11481'i64, -660'i64, 9244'i64, 8211'i64, 0'i64]) == "mushroom_fields"
assert overworldAt([3867'i64, 8179'i64, 3189'i64, -7133'i64, -9009'i64, 999'i64, 0'i64]) == "bamboo_jungle"
