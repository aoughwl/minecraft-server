## Exercises `codegenutil.genU16Bitset` (port of upstream's `bitsets.rs`
## codegen helper) directly - not against a JSON asset (it has none of its
## own; it's a shared builder other generators call with ids they already
## have), so this test builds a small id set by hand and checks the emitted
## words. A unit test here cannot start the compiler, which it used to do by
## name from PATH, so the words are checked by value.

import std/[syncio, strutils, assertions]
import codegenutil

let testIds = @[3'u16, 5'u16, 64'u16, 130'u16, 9'u16]

let src = genU16Bitset("testset", testIds)
# Bits 3, 5 and 9 in the first word, 64 in the second, 130 in the third.
assert src.contains("const TESTSET_MAX_ID*: uint16 = 130")
assert src.contains("const TESTSET_WORDS = 3")
assert src.contains("array[3, uint64] = [552'u64, 1'u64, 4'u64]")
assert src.contains("proc testsetContains*(id: uint16): bool")

# An id on the last word boundary needs one more word, as `(max_id + 64) / 64` gives.
assert genU16Bitset("edge", @[64'u16]).contains("array[2, uint64] = [0'u64, 1'u64]")
# An empty set still has one word.
assert genU16Bitset("none", newSeq[uint16]()).contains("array[1, uint64] = [0'u64]")

echo "bitset generator: words match"
