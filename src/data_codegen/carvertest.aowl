## Known answers from pumpkin-data/src/generated/carver.rs.
import std/[assertions, syncio]
import ../generated/carver

assert CANYON.probability == 0.01'f32
assert CANYON.y.kind == HeightProviderKind.Uniform
assert CANYON.y.minInclusive.kind == yokAbsolute and CANYON.y.minInclusive.absolute == 10'i16
assert CANYON.y.maxInclusive.absolute == 67'i16
assert CANYON.yScale.kind == FloatProviderKind.Constant and CANYON.yScale.value == 3.0'f32
assert CANYON.lavaLevel.kind == yokAboveBottom and CANYON.lavaLevel.aboveBottom == 8'i8
assert CANYON.replaceable == "minecraft:overworld_carver_replaceables"
assert CANYON.additional.kind == CarverAdditionalKind.Canyon
let shape = CANYON.additional.canyon.shape
assert shape.thickness.kind == FloatProviderKind.Trapezoid
assert shape.thickness.maxExclusive == 6.0'f32
assert shape.thickness.plateau == 2.0'f32
assert shape.widthSmoothness == 3'i32
assert shape.verticalRadiusDefaultFactor == 1.0'f32
assert CANYON.additional.canyon.verticalRotation.minInclusive == -0.125'f32

assert CAVE.probability == 0.15'f32
assert CAVE.additional.kind == CarverAdditionalKind.Cave
assert CAVE.additional.cave.floorLevel.minInclusive == -1.0'f32
assert CAVE.additional.cave.floorLevel.maxExclusive == -0.4'f32

assert CAVE_EXTRA_UNDERGROUND.y.maxInclusive.absolute == 47'i16

assert NETHER_CAVE.additional.kind == CarverAdditionalKind.NetherCave
assert NETHER_CAVE.replaceable == "minecraft:nether_carver_replaceables"
assert NETHER_CAVE.y.maxInclusive.kind == yokBelowTop and NETHER_CAVE.y.maxInclusive.belowTop == 1'i8
assert NETHER_CAVE.additional.cave.floorLevel.value == -0.7'f32
echo "carver: all checks passed"
