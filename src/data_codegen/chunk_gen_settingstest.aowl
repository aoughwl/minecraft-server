## Known answers from pumpkin-data/src/generated/chunk_gen_settings.rs.
import std/[assertions, syncio]
import ../generated/chunk_gen_settings as cgs
import ../generated/dimension as dimmod
import ../generated/block_properties

let o = cgs.OVERWORLD
assert o.aquifersEnabled and o.oreVeinsEnabled and not o.legacyRandomSource
assert o.seaLevel == 63'i32
assert o.shape.minY == -64'i8
assert o.shape.height == 384'u16
assert o.shape.sizeHorizontal == 1'u8
assert o.shape.sizeVertical == 2'u8
assert o.shape.verticalCellBlockCount() == 8'u8
assert o.shape.horizontalCellBlockCount() == 4'u8
assert o.shape.maxY() == 320'u16

# Upstream's `crate::Block::X.default_state`, resolved through the block table's own lookup.
let stone = Block.fromRegistryKey("stone")
assert stone != nil
assert asU16(o.defaultBlock) == asU16(stone.defaultState.id)
let water = Block.fromRegistryKey("water")
assert water != nil
assert asU16(o.defaultFluid) == asU16(water.defaultState.id)

assert cgs.END.shape.sizeHorizontal == 2'u8
assert cgs.END.shape.sizeVertical == 1'u8
assert cgs.END.seaLevel == 0'i32
assert cgs.NETHER.shape.maxY() == 128'u16

let trimmed = o.shape.trimHeight(0'i8, 200'u16)
assert trimmed.minY == 0'i8
assert trimmed.height == 200'u16
let kept = o.shape.trimHeight(-64'i8, 320'u16)
assert kept.minY == -64'i8 and kept.height == 384'u16

assert fromDimension(dimmod.OVERWORLD) == cgs.OVERWORLD
assert fromDimension(dimmod.THE_NETHER) == cgs.NETHER
assert fromDimension(dimmod.THE_END) == cgs.END
assert fromDimension(dimmod.OVERWORLD_CAVES) == cgs.END

# Indices stay in range in every settings.
for gs in [cgs.AMPLIFIED, cgs.CAVES, cgs.END, cgs.FLOATING_ISLANDS, cgs.LARGE_BIOMES, cgs.NETHER, cgs.OVERWORLD]:
  assert int(gs.surfaceRule) < gs.surfaceRules.len
  for r in gs.surfaceRules:
    if r.kind == mrCondition:
      assert int(r.ifTrue) < gs.surfaceConditions.len
      assert int(r.thenRun) < gs.surfaceRules.len
echo "chunk_gen_settings: all checks passed"
