## Checks src/generated/chunk_status.aowl against pumpkin-data/src/generated/chunk_status.rs.
import std/[assertions, syncio]
import ../generated/chunk_status

assert ord(high(ChunkStatus)) == 11
assert ord(csEmpty) == 0
assert ord(csNoise) == 4
assert ord(csSurface) == 5
assert ord(csCarvers) == 6
assert ord(csFeatures) == 7
assert ord(csFull) == 11
assert chunkStatusToWireName(csStructureReferences) == "minecraft:structure_references"
assert chunkStatusToWireName(csInitializeLight) == "minecraft:initialize_light"
let (found, status) = chunkStatusFromName("carvers")
assert found and status == csCarvers
assert not chunkStatusFromName("terrain")[0]
echo "chunk_status: all checks passed"
