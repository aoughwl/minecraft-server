## Port of pumpkin-codegen/src/version.rs (version.rs).
##
## Upstream's codegen crate keeps its own copy of `pumpkin_util::version::JavaMinecraftVersion`, because it
## needs `ToTokens` and a field name on it. This port has one enum, src/util/javaversion.aowl, which already
## has `toFieldIdent`; what remains here is `ToTokens` and Rust's `{:?}`, spelled for emitted aowlmony source.

import ../util/javaversion
export javaversion

proc versionEnumName*(v: JavaMinecraftVersion): string =
  ## `ToTokens`: the variant as generated source names it, `jmvV1_21_11`.
  "jmvV" & v.toFieldIdent().substr(1)

proc versionDebugName*(v: JavaMinecraftVersion): string =
  ## `{:?}`: `V_1_21_11`.
  "V_" & v.toFieldIdent().substr(1)
