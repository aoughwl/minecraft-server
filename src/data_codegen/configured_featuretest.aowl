## Known answers from pumpkin-data/src/generated/configured_feature.rs and configured_features_generated.rs.
import std/[assertions, syncio, strutils]
import ../generated/configured_features_generated

assert ord(ConfiguredFeature.Acacia) == 0
assert ord(ConfiguredFeature.AmethystGeode) == 1
assert ord(high(ConfiguredFeature)) == 225
let (found, f) = ConfiguredFeature.fromName("minecraft:amethyst_geode")
assert found and f == ConfiguredFeature.AmethystGeode
assert not ConfiguredFeature.fromName("nope")[0]
assert toName(ConfiguredFeature.AmethystGeode) == "amethyst_geode"

assert ConfiguredFeatureEntries.len == 226
assert configuredFeatureEntry(ConfiguredFeature.AmethystGeode).kind == ConfiguredFeatureKind.Geode
assert configuredFeatureEntry(ConfiguredFeature.Acacia).kind == ConfiguredFeatureKind.Tree
assert configuredFeatureEntry(ConfiguredFeature.Acacia).json.startsWith("{\"config\":{\"trunk_provider\":")
let (hasJson, text) = configuredFeatureJson("acacia")
assert hasJson and text == configuredFeatureEntry(ConfiguredFeature.Acacia).json
assert not configuredFeatureJson("nope")[0]
echo "configured_feature: all checks passed"
