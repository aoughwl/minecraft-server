## Known answers read from upstream's pumpkin-data/src/generated/damage_type.rs.

import std/[assertions, syncio]
import ../generated/damage_type

assert allDamageTypes().len == 51, $allDamageTypes().len
assert DROWN.deathMessageType == dmtDefault
assert DROWN.exhaustion == 0.0'f32
assert DROWN.hasEffects
assert DROWN.effects == deDrowning
assert DROWN.messageId == "drown"
assert DROWN.scaling == dsWhenCausedByLivingNonPlayer
assert DROWN.id == 6'u8
assert ARROW.exhaustion == 0.1'f32
assert not ARROW.hasEffects
assert BAD_RESPAWN_POINT.deathMessageType == dmtIntentionalGameDesign
assert BAD_RESPAWN_POINT.messageId == "badRespawnPoint"
assert BAD_RESPAWN_POINT.scaling == dsAlways

let (found, d) = damageTypeFromName("drown")
assert found and d.id == 6'u8
assert not damageTypeFromName("nope")[0]
let (foundId, byId) = damageTypeFromId(6'u8)
assert foundId and byId.messageId == "drown"
assert DROWN.registryKey == "drown"
assert DROWN.registryId == 6'u16

echo "damage_type: all checks passed"
