## Known answers from pumpkin-data/src/generated/dimension.rs.
import std/[assertions, syncio]
import ../generated/dimension

assert allDimensions().len == 4
let (found, o) = dimensionFromName("minecraft:overworld")
assert found
assert o.id == 0'u8
assert o.minecraftName == "minecraft:overworld"
assert not o.hasFixedTime
assert o.hasSkylight
assert not o.hasCeiling
assert o.coordinateScale == 1.0
assert o.minY == -64'i32
assert o.height == 384'i32
assert o.logicalHeight == 384'i32
assert o.infiniburn == "#minecraft:infiniburn_overworld"
assert o.ambientLight == 0.0'f32
assert o.monsterSpawnLightLevel.kind == IntProviderKind.Uniform
assert o.monsterSpawnLightLevel.minInclusive == 0'i32
assert o.monsterSpawnLightLevel.maxInclusive == 7'i32
assert o.monsterSpawnBlockLightLimit == 0'u8
assert o.hasSkyColor and o.skyColor == 7907327'i32
assert o.hasFogColor and o.fogColor == 12638463'i32
# `#ccffffff` overflows i32, so upstream's cloud colour is None.
assert not o.hasCloudColor
assert o.hasTimelines and o.timelines == "#minecraft:in_overworld"

assert THE_NETHER.id == 3'u8
assert not THE_NETHER.hasFixedTime
assert THE_NETHER.coordinateScale == 8.0
assert THE_NETHER.logicalHeight == 128'i32
assert THE_NETHER.ambientLight == 0.1'f32
assert THE_NETHER.monsterSpawnLightLevel.kind == IntProviderKind.Constant
assert THE_NETHER.monsterSpawnLightLevel.value == 7'i32
assert THE_NETHER.monsterSpawnBlockLightLimit == 15'u8
assert not THE_NETHER.hasSkyColor
assert THE_END == THE_END
assert not (THE_END == OVERWORLD)
assert not dimensionFromName("minecraft:nope")[0]
echo "dimension: all checks passed"
