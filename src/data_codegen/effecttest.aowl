## Known answers read from upstream's pumpkin-data/src/generated/{effect,potion,potion_brewing}.rs.

import std/[assertions, options, syncio]
import ../generated/potion_brewing
import ../generated/attributes

let speed = StatusEffect.SPEED
assert speed.minecraftName == "minecraft:speed"
assert speed.id == 0'u8
assert speed.category == MobEffectCategory.Beneficial
assert speed.color == 3402751'i32
assert speed.translationKey == "effect.minecraft.speed"
assert speed.attributeModifiers.len == 1
assert speed.attributeModifiers[0].attribute.name == attributes.MOVEMENT_SPEED.name
assert speed.attributeModifiers[0].id == "minecraft:effect.speed"
assert speed.attributeModifiers[0].baseValue == 0.20000000298023224'f64
assert speed.attributeModifiers[0].operation == Operation.AddMultipliedTotal
assert StatusEffect.fromName("speed").get.id == 0'u8
assert StatusEffect.fromMinecraftName("minecraft:speed").get == speed
assert StatusEffect.fromName("nope").isNone
assert StatusEffect.fromId(0'u16).get.minecraftName == "minecraft:speed"
assert StatusEffect.fromId(255'u16).isNone
assert speed.registryId == 0'u16

let nv = Potion.NIGHT_VISION
assert nv.name == "night_vision"
assert nv.id == 4'u8
assert nv.effects.len == 1
assert nv.effects[0].effectType == StatusEffect.NIGHT_VISION
assert nv.effects[0].duration == 3600'i32
assert nv.effects[0].showIcon
assert not nv.effects[0].blend
assert Potion.fromName("oozing").get.id == 44'u8
assert Potion.fromName("nope").isNone

assert POTION_RECIPES.len == 63
assert POTION_RECIPES[0].fromPotion == Potion.WATER
assert POTION_RECIPES[0].ingredient == @["glowstone_dust"]
assert POTION_RECIPES[0].toPotion == Potion.THICK
assert ITEM_RECIPES.len == 2
assert ITEM_RECIPES[0].fromItem == "potion"
assert ITEM_RECIPES[0].toItem == "splash_potion"

echo "effect, potion, potion_brewing: all checks passed"
