## Known answers read from upstream's pumpkin-data/src/generated/enchantment.rs.

import std/[assertions, options, syncio]
import ../generated/enchantment
import ../util/text/text

let aqua = Enchantment.AQUA_AFFINITY
assert aqua.name == "minecraft:aqua_affinity"
assert aqua.registryKey == "aqua_affinity"
assert aqua.description == "enchantment.minecraft.aqua_affinity"
assert aqua.anvilCost == 4'u32
assert aqua.supportedItems == "minecraft:enchantable/head_armor"
assert aqua.exclusiveSet.isNone
assert aqua.maxLevel == 1'i32
assert aqua.slots == @[AttributeModifierSlot.Head]
assert aqua.weight == 2'i32
assert aqua.minCost.base == 1'i32
assert aqua.maxCost.base == 41'i32
assert aqua.minCost.calculate(3'i32) == 1'i32

let sharp = Enchantment.fromName("minecraft:sharpness").get
assert sharp.exclusiveSet.get == "minecraft:exclusive_set/damage"
assert sharp.minCost.calculate(2'i32) == sharp.minCost.base + sharp.minCost.perLevelAboveFirst
assert Enchantment.fromName("sharpness").isNone
assert Enchantment.fromId(aqua.id).get == aqua
assert Enchantment.all().len == gEnchantments.len

proc damageSet(tag: string; id: uint16): bool {.closure.} =
  tag == "minecraft:exclusive_set/damage" and id == uint16(Enchantment.SMITE.id)

proc swordTag(tag: string; id: uint16): bool {.closure.} =
  tag == "minecraft:enchantable/sharp_weapon" and id == 1'u16
assert sharp.supportedItems == "minecraft:enchantable/sharp_weapon"
assert sharp.canEnchant(1'u16, swordTag)
assert not sharp.areCompatible(sharp, damageSet)
assert not sharp.areCompatible(Enchantment.SMITE, damageSet)
assert sharp.areCompatible(aqua, damageSet)
assert sharp.isEnchantmentCompatible(@[aqua], damageSet)
assert not sharp.isEnchantmentCompatible(@[aqua, Enchantment.SMITE], damageSet)

discard aqua.getFullname(1'i32, false)
discard sharp.getFullname(3'i32, false)

echo "enchantment: all checks passed (" & $gEnchantments.len & ")"
