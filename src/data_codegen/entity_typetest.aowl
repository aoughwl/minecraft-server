## Known answers read from upstream's pumpkin-data/src/generated/{entity_type,spawn_egg}.rs.

import std/[assertions, options, syncio]
import "../generated/entity_type"
import "../generated/spawn_egg"
import "../generated/attributes"

let all = allEntityTypes()
assert all.len == 158, "expected 158 entity types, got " & $all.len

let (foundOrb, orb) = entityTypeByName("experience_orb")
assert foundOrb
assert orb.id == 49'u16
assert orb.mob == false
assert orb.dimensionW == 0.5'f32
assert orb.dimensionH == 0.5'f32

let (foundMarker, marker) = entityTypeByName("marker")
assert foundMarker
assert marker.dimensionW == 0.0'f32

let (foundSnowball, snowball) = entityTypeByName("snowball")
assert foundSnowball
assert snowball.dimensionW == 0.25'f32
assert snowball.eyeHeight == 0.2125'f32

let (foundMissing, _) = entityTypeByName("not_a_real_entity")
assert not foundMissing

let zombie = EntityType.ZOMBIE
assert zombie.id == 151'u16
assert zombie.resourceName == "zombie"
assert zombie.experienceReward == 5'u32
assert zombie.hurtSound == "entity.zombie.hurt"
assert zombie.category == MobCategory.MONSTER
assert zombie.category.despawnDistance == 128'i32
assert zombie.attributes[0].attribute.name == attributes.AIR_DRAG_MODIFIER.name
assert zombie.attributes[0].value == 1.0'f64
assert zombie.attributes[1].attribute.name == attributes.ARMOR.name
assert zombie.attributes[1].value == 2.0'f64
assert EntityType.PIG.dimension[0] == 0.9'f32
assert EntityType.PIG.spawnRestriction.location == SpawnLocation.OnGround
assert EntityType.PIG.spawnRestriction.heightmap == MotionBlockingNoLeaves
assert EntityType.fromRaw(151'u16).get == zombie
assert EntityType.fromRaw(9999'u16).isNone
assert EntityType.fromName("minecraft:zombie").get.id == 151'u16
assert EntityType.fromName("zombie").get.id == 151'u16
assert spawningCategories().len == 8
assert MobCategory.MISC.max == -1'i32

let loot = lootTable(zombie)
assert loot != nil
assert loot.pools.isSome
assert lootTable(EntityType.MARKER) == nil

assert spawnEggIds().len == 88
assert entityNameFromEgg(1159'u16) == "chicken"
assert entityFromEgg(1159'u16).get.resourceName == "chicken"
assert entityFromEgg(0'u16).isNone

echo "entity_type, spawn_egg: all checks passed"
