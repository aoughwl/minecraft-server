## Known answers read from upstream's pumpkin-data/src/generated/fluid.rs and assets/fluids.json.
## State ids are 26.2's.

import std/[assertions, options, syncio]
import ../generated/fluid

assert gFluids.len == 5
assert Fluid.EMPTY.id == 0'u16
assert Fluid.WATER.id == 2'u16
assert Fluid.WATER.flowSpeed == 5'u32
assert Fluid.WATER.flowDistance == 4'u32
assert Fluid.WATER.states.len == 2
assert Fluid.WATER.states[0].blockStateId == BlockStateId(86'u16)
assert Fluid.WATER.states[0].isSource
assert Fluid.FLOWING_WATER.states.len == 16
assert Fluid.FLOWING_WATER.states[0].height == 0.11111111'f32
assert Fluid.fromRegistryKey("lava").get == Fluid.LAVA
assert Fluid.fromId(3'u16).get == Fluid.FLOWING_LAVA
assert Fluid.fromId(9'u16).isNone
assert getFluid("minecraft:water").get == Fluid.WATER
assert getFluid("water").get == Fluid.WATER
assert Fluid.fromStateId(BlockStateId(0'u16)).get == Fluid.EMPTY
assert Fluid.fromStateId(BlockStateId(86'u16)).get == Fluid.WATER
assert Fluid.fromStateId(BlockStateId(87'u16)).get == Fluid.FLOWING_WATER
assert Fluid.fromStateId(BlockStateId(102'u16)).get == Fluid.LAVA
assert Fluid.fromStateId(BlockStateId(117'u16)).get == Fluid.FLOWING_LAVA
assert Fluid.fromStateId(BlockStateId(118'u16)).isNone
assert Fluid.identToFluidId("lava").get == 4'u8
assert Fluid.WATER.matchesType(Fluid.FLOWING_WATER)
assert not Fluid.WATER.matchesType(Fluid.LAVA)
assert Fluid.WATER.toFlowing() == Fluid.FLOWING_WATER
assert Fluid.LAVA.toFlowing() == Fluid.FLOWING_LAVA
assert Fluid.EMPTY.toFlowing() == Fluid.EMPTY
assert Fluid.WATER.toResourceLocation() == "minecraft:water"

# Property structs: to_index folds the last property first.
assert Falling.variantCount() == 2'u16
assert Level.variantCount() == 8'u16
assert Level.fromValue("3") == Level.L3
assert Level.L3.toValue() == "3"
assert Falling.True.toIndex() == 0'u16
let p = FlowingWaterLikeFluidProperties(falling: Falling.False, level: Level.L3)
assert p.toIndex() == 2'u16 + 8'u16
assert FlowingWaterLikeFluidProperties.fromIndex(10'u16) == p
assert p.toStateId(Fluid.FLOWING_WATER) == Fluid.FLOWING_WATER.states[10].blockStateId
assert p.toProps() == @[("falling", "false"), ("level", "3")]
assert FlowingWaterLikeFluidProperties.fromProps(@[("level", "3"), ("falling", "false")], Fluid.FLOWING_LAVA) == p
assert WaterLikeFluidProperties.default(Fluid.WATER).falling == Falling.True

# Both of water's states carry block state 86, so from_state_id finds the first, as upstream's does.
let boxedWater = Fluid.WATER.propertiesOf(BlockStateId(86'u16))
assert boxedWater.toIndex() == 0'u16
assert boxedWater.toProps() == @[("falling", "true")]
let boxed = Fluid.FLOWING_WATER.propertiesOf(BlockStateId(99'u16))
assert boxed.toIndex() == 2'u16
assert boxed.toProps() == @[("falling", "true"), ("level", "3")]

echo "fluid: all checks passed"
