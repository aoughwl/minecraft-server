## Known answers read from upstream's pumpkin-data/src/generated/{fuels,composter_increase_chance,recipe_remainder}.rs.

import std/[assertions, options, syncio]
import ../generated/fuels
import ../generated/composter_increase_chance
import ../generated/recipe_remainder

assert FUELS.len == 280, "FUELS: " & $FUELS.len
assert getItemBurnTicks(1042'u16).get == 20000'u16
assert getItemBurnTicks(110'u16).get == 16000'u16
assert getItemBurnTicks(0'u16).isNone
assert isFuel(1145'u16)
assert not isFuel(0'u16)

assert getComposterIncreaseChanceFromItemId(0'u16).isNone
var composterEntries = 0
for i in 0 .. 65535:
  if getComposterIncreaseChanceFromItemId(uint16(i)).isSome: inc composterEntries
assert composterEntries == 115
assert getRecipeRemainderId(975'u16).get == 920'u16
assert getRecipeRemainderId(1046'u16).get == 1040'u16
assert getRecipeRemainderId(1150'u16).get == 1149'u16
assert getRecipeRemainderId(0'u16).isNone

echo "fuels, composter, remainder: all checks passed"
