## Known answers read from upstream's pumpkin-data/src/generated/game_rules.rs and flower_pot_transformations.rs.

import std/[assertions, syncio]
import ../generated/game_rules
import ../generated/flower_pot_transformations

assert allGameRules().len == 59, $allGameRules().len
assert gameRuleName(grAdvanceTime) == "advance_time"
assert $grAdvanceTime == "advance_time"
let (found, rule) = gameRuleFromName("max_entity_cramming")
assert found and rule == grMaxEntityCramming
assert gameRuleKind(grMaxEntityCramming) == grkInt
assert gameRuleKind(grBlockDrops) == grkBool
assert defaultInt(grMaxEntityCramming) == 24'i64
assert defaultBool(grBlockDrops)

var reg = defaultGameRuleRegistry()
assert reg.advanceTime
assert reg.fireSpreadRadiusAroundPlayer == 128'i64
assert reg.maxBlockModifications == 32768'i64
assert reg.maxMinecartSpeed == 8'i64
let v = reg.get(grMaxEntityCramming)
assert v.kind == grkInt and v.intValue == 24'i64
assert $v == "24"
reg.set(grMaxEntityCramming, GameRuleValue(kind: grkInt, intValue: 3'i64))
assert reg.maxEntityCramming == 3'i64
reg.set(grBlockDrops, GameRuleValue(kind: grkBool, boolValue: false))
assert not reg.blockDrops
assert $reg.get(grBlockDrops) == "false"

let pairs = reg.toStringPairs()
assert pairs.len == 59
assert pairs[0] == ("advance_time", "true")
let back = fromStringPairs(pairs)
assert back == reg
let partial = fromStringPairs(@[("max_entity_cramming", "7"), ("block_drops", "false"), ("nope", "1")])
assert partial.maxEntityCramming == 7'i64
assert not partial.blockDrops
assert partial.advanceTime

assert getPottedItem(76'u16) == 413'u16
assert getPottedItem(77'u16) == 414'u16
assert getPottedItem(0'u16) == 0'u16

echo "game_rules, flower_pot_transformations: all checks passed"
