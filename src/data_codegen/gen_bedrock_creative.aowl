## Port of pumpkin-codegen/src/bedrock_creative.rs (bedrock_creative.rs)
##
## assets/bedrock/creative_items.nbt is not in the pinned tree. Upstream's generator in that case keeps
## the previously generated pumpkin-data/src/generated/bedrock_creative.rs and returns it unchanged, so
## this does the same: it reads that file's literals and writes them compactly. The NBT branch is not
## ported because there is nothing to run it on.
## PARTIAL: pumpkin-codegen/src/bedrock_creative.rs - the creative_items.nbt branch is not ported: the file is absent from the pinned tree, and upstream falls back the same way.
##
## Run from the repo root.

import std/[strutils, syncio]
import codegenutil

const
  InPath = "../ref/pumpkin-1.21.11/pumpkin-data/src/generated/bedrock_creative.rs"
  OutPath = "src/generated/bedrock_creative.aowl"

proc numberAt(s: string; pos: var int; key: string; limit: int): string =
  ## The digits right after the next `key` before `limit`, advancing past them.
  let at = s.find(key, pos)
  if at < 0 or at >= limit:
    echo "bedrock_creative: missing " & key
    quit(1)
  var i = at + key.len
  result = ""
  while i < s.len and (isAsciiDigit(s[i]) or s[i] == '-'):
    result.add(s[i])
    inc i
  pos = i

proc stringAt(s: string; pos: var int; key: string; limit: int): string =
  let at = s.find(key, pos)
  if at < 0 or at >= limit:
    echo "bedrock_creative: missing " & key
    quit(1)
  var i = at + key.len
  result = ""
  while s[i] != '"':
    result.add(s[i])
    inc i
  pos = i + 1

proc main() =
  var src = ""
  try:
    src = readFile(InPath)
  except ErrorCode as e:
    echo "read failed: " & $e
    quit(1)
  let groupsAt = src.find("pub const CREATIVE_GROUPS")
  let entriesAt = src.find("pub const CREATIVE_ENTRIES")
  var groups = ""
  var groupCount = 0
  var pos = groupsAt
  while true:
    let at = src.find("CreativeGroup {", pos)
    if at < 0 or at >= entriesAt: break
    pos = at
    let category = numberAt(src, pos, "category: ", entriesAt)
    let name = stringAt(src, pos, "name: \"", entriesAt)
    let icon = numberAt(src, pos, "icon_item_id: ", entriesAt)
    let aux = numberAt(src, pos, "icon_item_aux_value: ", entriesAt)
    groups.add(category & "\t" & name & "\t" & icon & "\t" & aux & "\n")
    inc groupCount
  var entries = ""
  var entryCount = 0
  pos = entriesAt
  while true:
    let at = src.find("CreativeEntry {", pos)
    if at < 0: break
    pos = at
    let item = numberAt(src, pos, "item_id: ", src.len)
    let aux = numberAt(src, pos, "item_aux_value: ", src.len)
    let group = numberAt(src, pos, "group_index: ", src.len)
    entries.add(item & "\t" & aux & "\t" & group & "\n")
    inc entryCount

  var o = "## Generated by src/data_codegen/gen_bedrock_creative.aowl from upstream's checked-in bedrock_creative.rs. Do not edit.\n\n"
  o.add("import gendecode\n\n")
  o.add("const GroupsText = " & aowlStr(groups) & "\n")
  o.add("const EntriesText = " & aowlStr(entries) & "\n\n")
  o.add("""type
  CreativeGroup* = object
    category*: int
    name*: string
    iconItemId*: int16
    iconItemAuxValue*: uint32

  CreativeEntry* = object
    itemId*: int16
    itemAuxValue*: uint32
    groupIndex*: uint32

proc loadGroups(): seq[CreativeGroup] =
  result = @[]
  let s = GroupsText
  var pos = 0
  while not atEnd(s, pos):
    let category = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    let name = fieldStr(s, pos, '\t')
    skipSep(s, pos)
    let icon = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    let aux = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    result.add(CreativeGroup(category: category, name: name, iconItemId: int16(icon), iconItemAuxValue: uint32(aux)))

proc loadEntries(): seq[CreativeEntry] =
  result = @[]
  let s = EntriesText
  var pos = 0
  while not atEnd(s, pos):
    let item = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    let aux = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    let group = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    result.add(CreativeEntry(itemId: int16(item), itemAuxValue: uint32(aux), groupIndex: uint32(group)))

let CREATIVE_GROUPS*: seq[CreativeGroup] = loadGroups()
let CREATIVE_ENTRIES*: seq[CreativeEntry] = loadEntries()

proc creativeGroups*(): seq[CreativeGroup] = CREATIVE_GROUPS
proc creativeEntries*(): seq[CreativeEntry] = CREATIVE_ENTRIES
""")
  writeGenerated(OutPath, o)

when isMainModule:
  main()
