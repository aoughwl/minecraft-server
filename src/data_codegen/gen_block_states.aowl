## Port of the per-state half of pumpkin-codegen/src/block.rs and the fluid and tag
## lookups the world crate reads: emits src/generated/block_states.aowl from the pinned
## tree's assets/blocks.json, properties.json, fluids.json, biome.json and
## tags/26_2_tags.json. gen_block.aowl and gen_blockprops.aowl deliberately leave the
## per-state data out.
##
## One byte string carries the per-state fields, because a seq literal of 32366 structs
## is slow to compile and a string constant is not. Seven bytes per state:
##   state_flags u16 | side_flags u8 | luminance u8 | opacity u8 | block id u16 (big-endian)
##
## Run from the repo root: aowlmony c -r -p:src/data_codegen src/data_codegen/gen_block_states.aowl

import std/[json, syncio, tables]

const
  Assets = "../ref/pumpkin-1.21.11/assets/"
  OutPath = "src/generated/block_states.aowl"
  HexDigits = "0123456789abcdef"

type
  Prop = object
    name: string
    values: seq[string]

proc joinComma(xs: seq[string]): string =
  result = ""
  for i, x in xs:
    if i > 0: result.add(", ")
    result.add(x)

proc esc(s: string): string =
  result = ""
  for ch in s:
    if ch == '"' or ch == '\\':
      result.add('\\')
    result.add(ch)

proc readProps(): (seq[Prop], Table[int, int]) =
  var tree = parseFile(Assets & "properties.json")
  var props: seq[Prop] = @[]
  var byHash = initTable[int, int]()
  for elem in items(tree.root()):
    var hash = 0
    var name = ""
    var kind = ""
    var minV = 0
    var maxV = 0
    var values: seq[string] = @[]
    for k, v in elem.pairs():
      case k
      of "hash_key": hash = int(v.getInt())
      of "serialized_name": name = v.getStr()
      of "type": kind = v.getStr()
      of "min": minV = int(v.getInt())
      of "max": maxV = int(v.getInt())
      of "values":
        for it in items(v):
          values.add(it.getStr())
      else: discard
    if kind == "boolean":
      values = @["true", "false"]
    elif kind == "int":
      values = @[]
      var i = minV
      while i <= maxV:
        values.add($i)
        inc i
    byHash[hash] = props.len
    props.add(Prop(name: name, values: values))
  (props, byHash)

proc addHexByte(s: var string, v: int) =
  s.add(HexDigits[(v shr 4) and 15])
  s.add(HexDigits[v and 15])

proc readLeaves(): seq[string] =
  var tree = parseFile(Assets & "tags/26_2_tags.json")
  result = @[]
  for cat, catVal in tree.root().pairs():
    if cat == "block":
      for tag, list in catVal.pairs():
        if tag == "minecraft:leaves":
          for it in items(list):
            result.add(it.getStr())

proc lavaRange(): (int, int) =
  ## Upstream's `Fluid::from_state_id` arms for LAVA and FLOWING_LAVA.
  var tree = parseFile(Assets & "fluids.json")
  var lo = high(int)
  var hi = -1
  for f in items(tree.root()):
    var name = ""
    var ids: seq[int] = @[]
    for k, v in f.pairs():
      if k == "name":
        name = v.getStr()
      elif k == "states":
        for st in items(v):
          for sk, sv in st.pairs():
            if sk == "block_state_id":
              ids.add(int(sv.getInt()))
    if name == "lava" or name == "flowing_lava":
      for i in ids:
        if i < lo: lo = i
        if i > hi: hi = i
  (lo, hi)

proc main() =
  let (props, byHash) = readProps()
  let leaves = readLeaves()
  let (lavaLo, lavaHi) = lavaRange()

  var header = "## GENERATED by src/data_codegen/gen_block_states.aowl - do not edit by hand.\n\n"
  var blocksSrc = ""
  var hexData = ""
  var stateCount = 0
  var blockCount = 0

  var tree = parseFile(Assets & "blocks.json")
  for topKey, topVal in tree.root().pairs():
    if topKey != "blocks":
      continue
    for elem in items(topVal):
      var name = ""
      var defaultState = 0
      var hashes: seq[int] = @[]
      var blockId = 0
      var first = -1
      var count = 0
      var body = ""
      for k, v in elem.pairs():
        case k
        of "id": blockId = int(v.getInt())
        of "name": name = v.getStr()
        of "default_state_id": defaultState = int(v.getInt())
        of "properties":
          for it in items(v):
            hashes.add(int(it.getInt()))
        of "states":
          for st in items(v):
            var id = 0
            var flags = 0
            var side = 0
            var lum = 0
            var opa = 0
            for sk, sv in st.pairs():
              case sk
              of "id": id = int(sv.getInt())
              of "state_flags": flags = int(sv.getInt())
              of "side_flags": side = int(sv.getInt())
              of "luminance": lum = int(sv.getInt())
              of "opacity": opa = int(sv.getInt())
              else: discard
            if first < 0: first = id
            if id != first + count:
              quit("state ids are not contiguous at block " & name)
            if id != stateCount:
              quit("state ids are not global-contiguous at block " & name)
            inc count
            inc stateCount
            addHexByte(body, flags shr 8)
            addHexByte(body, flags and 255)
            addHexByte(body, side)
            addHexByte(body, lum)
            addHexByte(body, opa)
            addHexByte(body, blockId shr 8)
            addHexByte(body, blockId and 255)
        else: discard
      hexData.add(body)
      if blockId != blockCount:
        quit("block ids are not contiguous at block " & name)
      inc blockCount
      # Mixed radix: the last property has multiplier 1 (see gen_blockprops.aowl).
      var refs = newSeq[string](hashes.len)
      var multiplier = 1
      var j = hashes.len - 1
      while j >= 0:
        let idx = byHash.getOrDefault(hashes[j], -1)
        if idx < 0:
          quit("unknown property hash in block " & name)
        refs[j] = "BsPropRef(prop: " & $idx & ", multiplier: " & $multiplier & ")"
        multiplier *= props[idx].values.len
        dec j
      if multiplier != count:
        quit("property product does not match state count at block " & name)
      blocksSrc.add("  BsBlock(name: \"" & esc(name) & "\", firstStateId: " & $first &
        ", stateCount: " & $count & ", defaultStateId: " & $defaultState &
        ", props: @[" & joinComma(refs) & "]),\n")

  var s = header
  s.add("type\n  BsProp* = object\n    name*: string\n    values*: seq[string]\n\n")
  s.add("  BsPropRef* = object\n    prop*: int\n    multiplier*: int\n\n")
  s.add("  BsBlock* = object\n    name*: string\n    firstStateId*: int\n    stateCount*: int\n")
  s.add("    defaultStateId*: int\n    props*: seq[BsPropRef]\n\n")
  s.add("const\n  BsStateCount* = " & $stateCount & "\n  BsLavaFirstState* = " & $lavaLo &
    "\n  BsLavaLastState* = " & $lavaHi & "\n\n")
  s.add("let BsProps*: seq[BsProp] = @[\n")
  for p in props:
    var quoted: seq[string] = @[]
    for v in p.values:
      quoted.add("\"" & esc(v) & "\"")
    s.add("  BsProp(name: \"" & esc(p.name) & "\", values: @[" & joinComma(quoted) & "]),\n")
  s.add("]\n\n")
  s.add("let BsBlocks*: seq[BsBlock] = @[\n" & blocksSrc & "]\n\n")
  var leafQuoted: seq[string] = @[]
  for l in leaves:
    leafQuoted.add("\"" & esc(l) & "\"")
  s.add("let BsLeavesTag*: seq[string] = @[" & joinComma(leafQuoted) & "]\n\n")

  # Biome ids are the explicit `id` field of each biome.json entry.
  var biomeNames = newSeq[string](0)
  var biomeTree = parseFile(Assets & "biome.json")
  for k, v in biomeTree.root().pairs():
    for fk, fv in v.pairs():
      if fk == "id":
        let id = int(fv.getInt())
        if id >= biomeNames.len:
          biomeNames.setLen(id + 1)
        biomeNames[id] = k
  s.add("## biome.json names indexed by their `id`.\n")
  var biomeQuoted: seq[string] = @[]
  for b in biomeNames:
    biomeQuoted.add("\"" & esc(b) & "\"")
  s.add("let BsBiomeNames*: seq[string] = @[" & joinComma(biomeQuoted) & "]\n\n")
  s.add("const BsStateData* = \"" & hexData & "\"\n")

  if not tryWriteFile(OutPath, s):
    quit("could not write " & OutPath)
  echo "wrote " & $blockCount & " blocks, " & $stateCount & " states, " & $props.len &
    " properties, " & $leaves.len & " leaves, " & $biomeNames.len & " biomes, lava " & $lavaLo & ".." & $lavaHi

main()
