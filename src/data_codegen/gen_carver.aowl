## Port of pumpkin-codegen/src/carver.rs (carver.rs)
##
## Reads `assets/carver.json` and writes src/generated/carver.aowl. `replaceable` is
## upstream's `crate::tag::Block::X` constant by its registry key, without the `#`.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const OutPath = "src/generated/carver.aowl"

proc floatProviderLit(v: JsonNode; present: bool): string =
  ## `value_to_float_provider`; a missing or unknown value is its `Constant(0.0)` fallback.
  if not present:
    return "floatConstant(0.0'f32)"
  if kind(v) == JInt or kind(v) == JFloat:
    return "floatConstant(" & f32Lit(num(v)) & ")"
  case strAt(v, "type")
  of "minecraft:uniform":
    "floatUniform(" & f32Lit(numAt(v, "min_inclusive")) & ", " & f32Lit(numAt(v, "max_exclusive")) & ")"
  of "minecraft:constant":
    "floatConstant(" & f32Lit(numAt(v, "value")) & ")"
  of "minecraft:trapezoid":
    "floatTrapezoid(" & f32Lit(numAt(v, "min")) & ", " & f32Lit(numAt(v, "max")) & ", " &
      f32Lit(numAt(v, "plateau")) & ")"
  else:
    "floatConstant(0.0'f32)"

proc fp(config: JsonNode; key: string): string =
  let (ok, v) = fieldOf(config, key)
  floatProviderLit(v, ok)

proc yo(v: JsonNode; key: string): string =
  ## `value_to_y_offset` of carver.rs: not an object means `Absolute(0)`.
  let (ok, n) = fieldOf(v, key)
  if ok and kind(n) == JObject: yOffsetLit(n)
  else: "YOffset(kind: yokAbsolute, absolute: 0'i16)"

proc heightProviderLit(v: JsonNode): string =
  ## `value_to_height_provider`.
  case strAt(v, "type")
  of "minecraft:uniform":
    "HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: " & yo(v, "min_inclusive") &
      ", maxInclusive: " & yo(v, "max_inclusive") & ")"
  of "minecraft:trapezoid":
    let (hasP, _) = fieldOf(v, "plateau")
    "HeightProvider(kind: HeightProviderKind.Trapezoid, minInclusive: " & yo(v, "min_inclusive") &
      ", maxInclusive: " & yo(v, "max_inclusive") & ", hasPlateau: " & boolLit(hasP) &
      ", plateau: " & $intAt(v, "plateau") & "'i32)"
  else:
    "HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: " &
      "YOffset(kind: yokAbsolute, absolute: 0'i16), maxInclusive: YOffset(kind: yokAbsolute, absolute: 0'i16))"

proc additionalLit(carverType: string; config: JsonNode): string =
  case carverType
  of "minecraft:cave", "minecraft:nether_cave":
    let kindName = if carverType == "minecraft:cave": "Cave" else: "NetherCave"
    "CarverAdditionalConfig(kind: CarverAdditionalKind." & kindName & ", cave: CaveCarverConfig(" &
      "horizontalRadiusMultiplier: " & fp(config, "horizontal_radius_multiplier") &
      ", verticalRadiusMultiplier: " & fp(config, "vertical_radius_multiplier") &
      ", floorLevel: " & fp(config, "floor_level") & "))"
  of "minecraft:canyon":
    let (_, shape) = fieldOf(config, "shape")
    "CarverAdditionalConfig(kind: CarverAdditionalKind.Canyon, canyon: CanyonCarverConfig(" &
      "verticalRotation: " & fp(config, "vertical_rotation") & ", shape: CanyonShapeConfig(" &
      "distanceFactor: " & fp(shape, "distance_factor") &
      ", thickness: " & fp(shape, "thickness") &
      ", widthSmoothness: " & $intAt(shape, "width_smoothness") & "'i32" &
      ", horizontalRadiusFactor: " & fp(shape, "horizontal_radius_factor") &
      ", verticalRadiusDefaultFactor: " & f32Lit(numAt(shape, "vertical_radius_default_factor")) &
      ", verticalRadiusCenterFactor: " & f32Lit(numAt(shape, "vertical_radius_center_factor")) & ")))"
  else:
    "CarverAdditionalConfig(kind: CarverAdditionalKind.Cave, cave: defaultCaveCarverConfig())"

const Types = """
import ../util/y_offset
import worldgen_providers
export y_offset, worldgen_providers

type
  HeightProviderKind* {.pure.} = enum
    Uniform
    Trapezoid
    VeryBiasedToBottom

  HeightProvider* = object
    ## Upstream's `HeightProvider` enum and its three structs, flattened.
    kind*: HeightProviderKind
    minInclusive*: YOffset
    maxInclusive*: YOffset
    hasPlateau*: bool
    plateau*: int32
    hasInner*: bool
    inner*: uint32

  CaveCarverConfig* = object
    horizontalRadiusMultiplier*: FloatProvider
    verticalRadiusMultiplier*: FloatProvider
    floorLevel*: FloatProvider

  CanyonShapeConfig* = object
    distanceFactor*: FloatProvider
    thickness*: FloatProvider
    widthSmoothness*: int32
    horizontalRadiusFactor*: FloatProvider
    verticalRadiusDefaultFactor*: float32
    verticalRadiusCenterFactor*: float32

  CanyonCarverConfig* = object
    verticalRotation*: FloatProvider
    shape*: CanyonShapeConfig

  CarverAdditionalKind* {.pure.} = enum
    Cave
    NetherCave
    Canyon

  CarverAdditionalConfig* = object
    kind*: CarverAdditionalKind
    cave*: CaveCarverConfig      ## `Cave` and `NetherCave`.
    canyon*: CanyonCarverConfig  ## `Canyon`.

  CarverConfig* = object
    probability*: float32
    y*: HeightProvider
    yScale*: FloatProvider
    lavaLevel*: YOffset
    replaceable*: string  ## The tag's registry key, `minecraft:overworld_carver_replaceables`.
    additional*: CarverAdditionalConfig

proc defaultCaveCarverConfig*(): CaveCarverConfig =
  CaveCarverConfig(horizontalRadiusMultiplier: floatConstant(1.0'f32),
    verticalRadiusMultiplier: floatConstant(1.0'f32),
    floorLevel: floatConstant(-0.7'f32))

"""

proc main() =
  let text = readAsset("carver.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))

  var s = "## GENERATED by src/data_codegen/gen_carver.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/carver.rs.\n\n")
  s.add(Types)
  var i = 0
  while i < entries.len:
    let name = entries[i][0]
    let data = entries[i][1]
    let (_, config) = fieldOf(data, "config")
    let carverType = strAt(data, "type")
    let (hasY, y) = fieldOf(config, "y")
    let heightLit = if hasY: heightProviderLit(y)
      else: "HeightProvider(kind: HeightProviderKind.Uniform)"
    var replaceable = strAt(config, "replaceable")
    if replaceable.startsWith("#"):
      replaceable = replaceable[1 .. ^1]
    else:
      # Upstream's fallback for a value that is not a tag.
      replaceable = "minecraft:overworld_carver_replaceables"
    s.add("let " & shouty(name) & "* = CarverConfig(\n")
    s.add("  probability: " & f32Lit(numAt(config, "probability")) & ",\n")
    s.add("  y: " & heightLit & ",\n")
    s.add("  yScale: " & fp(config, "yScale") & ",\n")
    s.add("  lavaLevel: " & yo(config, "lava_level") & ",\n")
    s.add("  replaceable: " & aowlStr(replaceable) & ",\n")
    s.add("  additional: " & additionalLit(carverType, config) & ",\n")
    s.add(")\n\n")
    inc i
  writeGenerated(OutPath, s)

main()
