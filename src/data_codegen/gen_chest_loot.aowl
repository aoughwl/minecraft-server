## Port of pumpkin-codegen/src/chest_loot.rs (chest_loot.rs)
##
## Reads every assets/loot_table/chests/**.json and writes src/generated/chest_loot.aowl: one text
## table decoded when the module loads, a `T.NAME` accessor per table, and `getChestLootTable(key)`.
## Run from the repo root.

import std/[algorithm, json, paths, dirs, strutils, syncio]
import codegenutil

const
  BaseDir = AssetsDir & "/loot_table/chests"
  OutPath = "src/generated/chest_loot.aowl"

proc collectJsonFiles(dir, prefix: string): seq[(string, string)] =
  ## `collect_json_files`: `(relative stem, file path)` pairs, walked first and read later (bug 10).
  ## Returned by value, not through a `var` accumulator (bug 12).
  result = @[]
  var subdirs: seq[string] = @[]
  try:
    for kind, entry in walkDir(path(dir)):
      let full = $entry
      let cut = max(lastIndexOf(full, '/'), lastIndexOf(full, '\\'))
      let base = full[(cut + 1) .. ^1]
      if kind == pcDir:
        subdirs.add(base)
      elif kind == pcFile and base.endsWith(".json"):
        result.add((prefix & base[0 ..< (base.len - 5)], dir & "/" & base))
  except ErrorCode as e:
    echo "walk " & dir & " failed: " & $e
  for sub in subdirs:
    let inner = collectJsonFiles(dir & "/" & sub, prefix & sub & "/")
    for item in inner: result.add(item)

proc roundI(v: float): int =
  ## `f32::round() as i32`: half away from zero.
  if v >= 0.0: int(v + 0.5) else: -int(-v + 0.5)

proc asFloat(v: JsonNode): float =
  if v.kind == JInt: float(v.getInt()) else: v.getFloat()

proc minMax(v: JsonNode): (int, int) =
  ## `RollsStruct`/`CountStruct`: a bare number or a `{type, min, max}` provider, min and max
  ## defaulting to 0.
  if v.kind != JObject:
    let r = roundI(asFloat(v))
    return (r, r)
  var a = 0
  var b = 0
  for k, x in v.pairs():
    if k == "min": a = roundI(asFloat(x))
    elif k == "max": b = roundI(asFloat(x))
  (a, b)

proc emitEntry(e: JsonNode; rows: var string; emptyWeight: var int) =
  var ty = ""
  var name = ""
  var hasName = false
  var weight = 1
  var minCount = 1
  var maxCount = 1
  var seenCount = false
  for k, x in e.pairs():
    case k
    of "type": ty = x.getStr()
    of "name":
      name = x.getStr()
      hasName = true
    of "weight": weight = int(x.getInt())
    of "functions":
      for fn in x.items():
        if seenCount: break
        var isSetCount = false
        var countNode = fn
        var hasCount = false
        for fk, fv in fn.pairs():
          if fk == "function": isSetCount = fv.getStr() == "minecraft:set_count"
          elif fk == "count":
            countNode = fv
            hasCount = true
        if isSetCount:
          seenCount = true
          if hasCount:
            let r = minMax(countNode)
            minCount = r[0]
            maxCount = r[1]
    else: discard
  case ty
  of "minecraft:empty":
    emptyWeight += weight
  of "minecraft:item":
    if hasName:
      rows.add("E\t" & name & "\t" & $weight & "\t" & $minCount & "\t" & $maxCount & "\n")
  else:
    discard

proc main() =
  var files = collectJsonFiles(BaseDir, "")
  files.sort(proc(a, b: (string, string)): int = cmp(a[0], b[0]))
  var text = ""
  var accessors = ""
  var i = 0
  while i < files.len:
    let relative = files[i][0]
    let ident = toShoutySnakeCase(relative.replace("/", "_"))
    text.add("T\tminecraft:chests/" & relative & "\n")
    accessors.add("template " & ident & "*(T: typedesc[ChestLootTable]): ChestLootTable = gChestLootTables[" & $i & "]\n")
    var body = ""
    try:
      body = readFile(files[i][1])
    except ErrorCode as e:
      echo "read " & files[i][1] & " failed: " & $e
    var tree = parseJson(body)
    let r = root(tree)
    for k, pools in r.pairs():
      if k != "pools": continue
      for pool in pools.items():
        var rows = ""
        var emptyWeight = 0
        var rolls = (0, 0)
        for pk, pv in pool.pairs():
          if pk == "rolls": rolls = minMax(pv)
          elif pk == "entries":
            for e in pv.items():
              emitEntry(e, rows, emptyWeight)
        text.add("P\t" & $rolls[0] & "\t" & $rolls[1] & "\t" & $emptyWeight & "\n")
        text.add(rows)
    inc i

  var o = "## Generated by src/data_codegen/gen_chest_loot.aowl from assets/loot_table/chests. Do not edit.\n\n"
  o.add("import std/[options, tables]\nimport gendecode\nimport ../util/chest_loot_table\nexport chest_loot_table\n\n")
  o.add("const ChestLootText = " & aowlStr(text) & "\n\n")
  o.add("""proc loadTables(names: var seq[string]): seq[ChestLootTable] =
  result = @[]
  let s = ChestLootText
  var pos = 0
  while not atEnd(s, pos):
    let tag = s[pos]
    pos += 2
    case tag
    of 'T':
      names.add(fieldStr(s, pos, '\n'))
      result.add(ChestLootTable(pools: @[]))
    of 'P':
      let minRolls = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let maxRolls = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let emptyWeight = fieldInt(s, pos, '\t')
      result[result.len - 1].pools.add(ChestLootPool(entries: @[], minRolls: int32(minRolls),
        maxRolls: int32(maxRolls), emptyWeight: int32(emptyWeight)))
    else:
      let item = fieldStr(s, pos, '\t')
      skipSep(s, pos)
      let weight = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let minCount = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let maxCount = fieldInt(s, pos, '\t')
      let t = result.len - 1
      let p = result[t].pools.len - 1
      result[t].pools[p].entries.add(ChestLootEntry(item: item, weight: int32(weight),
        minCount: int32(minCount), maxCount: int32(maxCount)))
    skipSep(s, pos)

var gChestLootKeys*: seq[string] = @[]
let gChestLootTables*: seq[ChestLootTable] = loadTables(gChestLootKeys)

proc buildIndex(): Table[string, int] =
  result = initTable[string, int]()
  for i, k in gChestLootKeys:
    result[k] = i

let gChestLootIndex: Table[string, int] = buildIndex()

proc getChestLootTable*(key: string): Option[ChestLootTable] =
  let i = gChestLootIndex.getOrDefault(key, -1)
  if i < 0: none[ChestLootTable]() else: some(gChestLootTables[i])

""")
  o.add(accessors)
  writeGenerated(OutPath, o)

when isMainModule:
  main()
