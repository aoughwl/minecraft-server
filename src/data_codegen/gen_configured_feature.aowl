## Port of pumpkin-codegen/src/configured_feature.rs (configured_feature.rs)
##
## Reads `assets/configured_features.json` and writes both of upstream's outputs:
## - `build_enum` as src/generated/configured_feature.aowl: the `ConfiguredFeature` enum.
## - `build` as src/generated/configured_features_generated.aowl.
##
## What is typed here is which variant of pumpkin-world's `ConfiguredFeature` each entry builds, from the
## `value_to_configured_feature` match. The configuration stays as the asset's own JSON, by name, as gendecode.aowl explains:
## src/world/generation/feature/decode.aowl is the rest of `value_to_configured_feature`, and builds `TreeFeature`,
## `BlockStateProvider`, `RuleTest` and the others from it, once per entry and when first asked for.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const EnumPath = "src/generated/configured_feature.aowl"
const DataPath = "src/generated/configured_features_generated.aowl"

const KindNames = [
  "NoOp", "Bamboo", "Seagrass", "SeaPickle", "NetherForestVegetation", "NetherrackReplaceBlobs",
  "SimpleBlock", "ScatteredOre", "Ore", "SpringFeature", "BlockColumn", "FallenTree", "Flower",
  "NoBonemealFlower", "RandomPatch", "RandomSelector", "SimpleRandomSelector", "RandomBooleanSelector",
  "EndSpike", "Tree", "PointedDripstone", "Geode", "MonsterRoom", "UnderwaterMagma", "VegetationPatch",
  "WaterloggedVegetationPatch", "GlowstoneBlob", "Disk", "BasaltColumns", "BasaltPillar", "ForestRock",
  "FreezeTopLayer", "IceSpike", "Iceberg", "ChorusPlant", "EndPlatform", "EndIsland", "Kelp", "Fossil",
  "Lake", "HugeBrownMushroom", "HugeRedMushroom", "Vines", "RootSystem", "MultifaceGrowth", "BlueIce",
  "EndGateway", "CoralTree", "CoralMushroom", "CoralClaw", "HugeFungus", "WeepingVines", "TwistingVines",
  "DeltaFeature", "FillLayer", "BonusChest", "DripstoneCluster", "LargeDripstone", "SculkPatch", "BlockPile",
  "ReplaceSingleBlock", "VoidStartPlatform", "DesertWell"]
  ## Every variant `value_to_configured_feature` can build.

proc die(msg: string) =
  echo "gen_configured_feature: " & msg
  quit(1)

proc kindOf(t: string): string =
  ## The arms of `value_to_configured_feature`, including the ones where the variant's name
  ## is not the asset's type.
  case t
  of "minecraft:no_op", "minecraft:sequence", "minecraft:weighted_random_selector": "NoOp"
  of "minecraft:bamboo": "Bamboo"
  of "minecraft:seagrass": "Seagrass"
  of "minecraft:sea_pickle": "SeaPickle"
  of "minecraft:nether_forest_vegetation": "NetherForestVegetation"
  of "minecraft:netherrack_replace_blobs": "NetherrackReplaceBlobs"
  of "minecraft:simple_block": "SimpleBlock"
  of "minecraft:ore": "Ore"
  of "minecraft:scattered_ore": "ScatteredOre"
  of "minecraft:spring_feature": "SpringFeature"
  of "minecraft:block_column": "BlockColumn"
  of "minecraft:fallen_tree": "FallenTree"
  of "minecraft:flower": "Flower"
  of "minecraft:no_bonemeal_flower": "NoBonemealFlower"
  of "minecraft:random_patch": "RandomPatch"
  of "minecraft:random_selector": "RandomSelector"
  of "minecraft:simple_random_selector": "SimpleRandomSelector"
  of "minecraft:random_boolean_selector": "RandomBooleanSelector"
  of "minecraft:end_spike": "EndSpike"
  of "minecraft:tree": "Tree"
  of "minecraft:pointed_dripstone", "minecraft:speleothem": "PointedDripstone"
  of "minecraft:geode": "Geode"
  of "minecraft:monster_room": "MonsterRoom"
  of "minecraft:underwater_magma": "UnderwaterMagma"
  of "minecraft:vegetation_patch": "VegetationPatch"
  of "minecraft:waterlogged_vegetation_patch": "WaterloggedVegetationPatch"
  of "minecraft:glowstone_blob": "GlowstoneBlob"
  of "minecraft:disk": "Disk"
  of "minecraft:basalt_columns": "BasaltColumns"
  of "minecraft:basalt_pillar": "BasaltPillar"
  of "minecraft:block_blob": "ForestRock"
  of "minecraft:freeze_top_layer": "FreezeTopLayer"
  of "minecraft:ice_spike", "minecraft:spike": "IceSpike"
  of "minecraft:iceberg": "Iceberg"
  of "minecraft:chorus_plant": "ChorusPlant"
  of "minecraft:end_platform": "EndPlatform"
  of "minecraft:end_island": "EndIsland"
  of "minecraft:kelp": "Kelp"
  of "minecraft:fossil": "Fossil"
  of "minecraft:lake": "Lake"
  of "minecraft:huge_brown_mushroom": "HugeBrownMushroom"
  of "minecraft:huge_red_mushroom": "HugeRedMushroom"
  of "minecraft:vines": "Vines"
  of "minecraft:root_system": "RootSystem"
  of "minecraft:multiface_growth": "MultifaceGrowth"
  of "minecraft:blue_ice": "BlueIce"
  of "minecraft:end_gateway": "EndGateway"
  of "minecraft:coral_tree": "CoralTree"
  of "minecraft:coral_mushroom": "CoralMushroom"
  of "minecraft:coral_claw": "CoralClaw"
  of "minecraft:huge_fungus": "HugeFungus"
  of "minecraft:weeping_vines": "WeepingVines"
  of "minecraft:twisting_vines": "TwistingVines"
  of "minecraft:delta_feature": "DeltaFeature"
  of "minecraft:fill_layer": "FillLayer"
  of "minecraft:bonus_chest": "BonusChest"
  of "minecraft:dripstone_cluster", "minecraft:speleothem_cluster": "DripstoneCluster"
  of "minecraft:large_dripstone": "LargeDripstone"
  of "minecraft:sculk_patch": "SculkPatch"
  of "minecraft:block_pile": "BlockPile"
  of "minecraft:replace_single_block": "ReplaceSingleBlock"
  of "minecraft:void_start_platform": "VoidStartPlatform"
  of "minecraft:desert_well": "DesertWell"
  else:
    die("unknown configured feature type: " & t)
    ""

proc buildEnum(names: seq[string]): string =
  result = "## GENERATED by src/data_codegen/gen_configured_feature.aowl - do not edit by hand.\n"
  result.add("## Port of pumpkin-data/src/generated/configured_feature.rs.\n\n")
  result.add("type\n  ConfiguredFeature* {.pure.} = enum\n")
  var i = 0
  while i < names.len:
    result.add("    " & toPascalCase(names[i]) & "\n")
    inc i
  result.add("\nconst ConfiguredFeatureNames: array[" & $names.len & ", string] = [\n")
  i = 0
  while i < names.len:
    result.add("  " & aowlStr(names[i]) & ",\n")
    inc i
  result.add("]\n\n")
  result.add("proc fromName*(T: typedesc[ConfiguredFeature]; name: string): (bool, ConfiguredFeature) =\n")
  result.add("  ## Takes the name with or without `minecraft:`. Names are sorted, as the variants are.\n")
  result.add("  var key = name\n")
  result.add("  if key.len > 10 and key[0 .. 9] == \"minecraft:\":\n    key = key[10 .. ^1]\n")
  result.add("  var lo = 0\n  var hi = ConfiguredFeatureNames.len - 1\n")
  result.add("  while lo <= hi:\n    let mid = (lo + hi) div 2\n")
  result.add("    if ConfiguredFeatureNames[mid] == key:\n      return (true, ConfiguredFeature(mid))\n")
  result.add("    if ConfiguredFeatureNames[mid] < key:\n      lo = mid + 1\n    else:\n      hi = mid - 1\n")
  result.add("  (false, ConfiguredFeature(0))\n\n")
  result.add("proc toName*(self: ConfiguredFeature): string =\n  ## The bare name.\n  ConfiguredFeatureNames[ord(self)]\n")

proc main() =
  let text = readAsset("configured_features.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))
  let raws = topLevelValues(minifyJson(text))
  if raws.len != entries.len:
    die("raw split found " & $raws.len & " entries, expected " & $entries.len)

  var names: seq[string] = @[]
  var i = 0
  while i < entries.len:
    names.add(entries[i][0])
    inc i
  writeGenerated(EnumPath, buildEnum(names))

  var rows = ""
  i = 0
  while i < entries.len:
    if raws[i][0] != entries[i][0]:
      die("raw split out of step at " & entries[i][0])
    rows.add(kindOf(strAt(entries[i][1], "type")) & "|" & raws[i][1] & "\n")
    inc i

  var s = "## GENERATED by src/data_codegen/gen_configured_feature.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/configured_features_generated.rs in compact form: see the generator.\n")
  s.add("## `json` in each entry is the input of src/world/generation/feature/decode.aowl, which builds the typed form.\n\n")
  s.add("import gendecode\nimport configured_feature\nexport configured_feature\n\n")
  s.add("type\n  ConfiguredFeatureKind* {.pure.} = enum\n    ## The variant of pumpkin-world's `ConfiguredFeature` an entry builds.\n")
  i = 0
  while i < KindNames.len:
    s.add("    " & KindNames[i] & "\n")
    inc i
  s.add("\n  ConfiguredFeatureEntry* = object\n")
  s.add("    kind*: ConfiguredFeatureKind\n")
  s.add("    json*: string  ## The asset's own entry, minified.\n\n")
  s.add("const ConfiguredFeatureData = " & aowlStr(rows) & "\n\n")
  s.add("proc kindFromName(name: string): ConfiguredFeatureKind =\n")
  s.add("  for k in low(ConfiguredFeatureKind) .. high(ConfiguredFeatureKind):\n")
  s.add("    if $k == name:\n      return k\n")
  s.add("  genPanic(\"configured_features_generated: bad kind \" & name)\n")
  s.add("  ConfiguredFeatureKind.NoOp\n\n")
  s.add("proc load(): seq[ConfiguredFeatureEntry] =\n")
  s.add("  result = @[]\n  var pos = 0\n  let d = ConfiguredFeatureData\n")
  s.add("  while pos < d.len:\n")
  s.add("    let k = kindFromName(fieldStr(d, pos, '|'))\n    skipSep(d, pos)\n")
  s.add("    let json = fieldStr(d, pos, '\\n')\n    skipSep(d, pos)\n")
  s.add("    result.add(ConfiguredFeatureEntry(kind: k, json: json))\n\n")
  s.add("let ConfiguredFeatureEntries*: seq[ConfiguredFeatureEntry] = load()\n")
  s.add("  ## Upstream's `build_configured_features()` map: indexed by `ord(ConfiguredFeature)`.\n\n")
  s.add("proc configuredFeatureEntry*(f: ConfiguredFeature): ConfiguredFeatureEntry {.inline.} =\n")
  s.add("  ConfiguredFeatureEntries[ord(f)]\n\n")
  s.add("proc configuredFeatureJson*(name: string): (bool, string) =\n")
  s.add("  ## The entry's JSON by name, with or without `minecraft:`.\n")
  s.add("  let (found, f) = ConfiguredFeature.fromName(name)\n")
  s.add("  if found: (true, ConfiguredFeatureEntries[ord(f)].json) else: (false, \"\")\n")
  writeGenerated(DataPath, s)

main()
