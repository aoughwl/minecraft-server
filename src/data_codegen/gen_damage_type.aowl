## Port of pumpkin-codegen/src/damage_type.rs (damage_type.rs)
##
## Reads assets/damage_type.json (`{name: {id, components: {...}}}`) in `BTreeMap` key order. Exported
## names are older than this port and kept: bare consts (`ARROW`), `damageTypeFromName`, and
## `hasEffects` + `effects` for upstream's `effects: Option<DamageEffects>`. Upstream's `Taggable`
## becomes `registryKey` and `registryId`. Run from the repo root.

import std/[algorithm, json, syncio]
import codegenutil

const OutPath = "src/generated/damage_type.aowl"

type
  DamageEntry = object
    name: string
    id: int
    deathMessageType: string ## "" -> Default
    exhaustion: float
    effects: string ## "" -> None
    messageId: string
    scaling: string

proc readEntries(): seq[DamageEntry] =
  var tree = parseJson(readAsset("damage_type.json"))
  let r = root(tree)
  result = @[]
  for name, val in r.pairs():
    var e = DamageEntry(name: name, id: 0, deathMessageType: "", exhaustion: 0.0, effects: "",
      messageId: "", scaling: "")
    for k, v in val.pairs():
      if k == "id":
        e.id = int(v.getInt())
      elif k == "components":
        for ck, cv in v.pairs():
          case ck
          of "death_message_type": e.deathMessageType = cv.getStr()
          of "exhaustion": e.exhaustion = if cv.kind == JInt: float(cv.getInt()) else: cv.getFloat()
          of "effects": e.effects = cv.getStr()
          of "message_id": e.messageId = cv.getStr()
          of "scaling": e.scaling = cv.getStr()
          else: discard
    result.add(e)
  var i = 1
  # Insertion sort: compiler bug 5 is about objects with enum fields; this keeps the shape simple.
  while i < result.len:
    var j = i
    while j > 0 and result[j - 1].name > result[j].name:
      let lower = result[j]
      let upper = result[j - 1]
      result[j - 1] = lower
      result[j] = upper
      dec j
    inc i

proc deathMsgIdent(v: string): string =
  case v
  of "fall_variants": "dmtFallVariants"
  of "intentional_game_design": "dmtIntentionalGameDesign"
  else: "dmtDefault"

proc effectsIdent(v: string): string =
  case v
  of "hurt": "deHurt"
  of "thorns": "deThorns"
  of "drowning": "deDrowning"
  of "burning": "deBurning"
  of "poking": "dePoking"
  of "freezing": "deFreezing"
  else: "deHurt"

proc scalingIdent(v: string): string =
  case v
  of "never": "dsNever"
  of "always": "dsAlways"
  else: "dsWhenCausedByLivingNonPlayer"

proc build(): string =
  let entries = readEntries()
  var s = "## GENERATED by src/data_codegen/gen_damage_type.aowl - do not edit by hand.\n\n"
  s.add("type\n")
  s.add("  DeathMessageType* = enum\n")
  s.add("    dmtDefault, dmtFallVariants, dmtIntentionalGameDesign\n\n")
  s.add("  DamageEffects* = enum\n")
  s.add("    deHurt, deThorns, deDrowning, deBurning, dePoking, deFreezing\n\n")
  s.add("  DamageScaling* = enum\n")
  s.add("    dsNever, dsWhenCausedByLivingNonPlayer, dsAlways\n\n")
  s.add("  DamageType* = object\n")
  s.add("    deathMessageType*: DeathMessageType\n")
  s.add("    exhaustion*: float32\n")
  s.add("    hasEffects*: bool\n")
  s.add("    effects*: DamageEffects\n")
  s.add("    messageId*: string\n")
  s.add("    scaling*: DamageScaling\n")
  s.add("    id*: uint8\n\n")

  for e in entries:
    s.add("const " & toShoutySnakeCase(e.name) & "*: DamageType = DamageType(\n")
    s.add("  deathMessageType: " & deathMsgIdent(e.deathMessageType) & ",\n")
    s.add("  exhaustion: " & $e.exhaustion & "'f32,\n")
    s.add("  hasEffects: " & (if e.effects.len > 0: "true" else: "false") & ",\n")
    s.add("  effects: " & effectsIdent(e.effects) & ",\n")
    s.add("  messageId: " & aowlStr(e.messageId) & ",\n")
    s.add("  scaling: " & scalingIdent(e.scaling) & ",\n")
    s.add("  id: " & $e.id & "'u8)\n\n")

  s.add("proc damageTypeFromName*(name: string): (bool, DamageType) =\n")
  s.add("  case name\n")
  for e in entries:
    s.add("  of " & aowlStr(e.name) & ": (true, " & toShoutySnakeCase(e.name) & ")\n")
  s.add("  else: (false, " & toShoutySnakeCase(entries[0].name) & ")\n\n")

  s.add("proc damageTypeFromId*(id: uint8): (bool, DamageType) =\n")
  s.add("  case id\n")
  for e in entries:
    s.add("  of " & $e.id & "'u8: (true, " & toShoutySnakeCase(e.name) & ")\n")
  s.add("  else: (false, " & toShoutySnakeCase(entries[0].name) & ")\n\n")

  s.add("proc registryKey*(self: DamageType): string = self.messageId\n")
  s.add("proc registryId*(self: DamageType): uint16 = uint16(self.id)\n\n")
  s.add("proc allDamageTypes*(): seq[DamageType] =\n  @[\n")
  for e in entries:
    s.add("    " & toShoutySnakeCase(e.name) & ",\n")
  s.add("  ]\n")
  s

when isMainModule:
  writeGenerated(OutPath, build())
