## Port of pumpkin-codegen/src/data_component.rs - emits the `DataComponent` enum
## and its id/name conversions from assets/data_component.json in the pinned
## tree, sorted by id. Run from the repo root:
##
##     aowlmony c -r --cc:gcc -p:src src/data_codegen/gen_data_component.aowl

import std/[strutils, syncio]
import codegenutil

const
  OutPath = "src/generated/data_component.aowl"
  AssetPath = "../ref/pumpkin-1.21.11/assets/data_component.json"

proc variantName(rawName: string): string =
  ## `strip_prefix("minecraft:")`, `/` to `_`, then pascal case.
  var strip = rawName.substr("minecraft:".len)
  strip = strip.replace('/', '_')
  "dc" & toPascalCase(strip)

proc build(): string =
  let byName = readStringIntMapSorted(AssetPath)
  # `sort_by_key` on the id: ids are unique, so placing each one by id is the same order.
  var sorted = newSeq[string](byName.len)
  for i in 0 ..< byName.len:
    sorted[byName[i][1]] = byName[i][0]

  result = "## GENERATED by src/data_codegen/gen_data_component.aowl from assets/data_component.json - do not edit by hand.\n\n"
  result.add("type\n  DataComponent* = enum\n")
  for id in 0 ..< sorted.len:
    result.add("    " & variantName(sorted[id]) & " = " & $id & "\n")
  result.add("\nproc toId*(self: DataComponent): uint8 {.inline.} = uint8(ord(self))\n\n")
  result.add("proc tryFromId*(id: uint8): (bool, DataComponent) =\n")
  result.add("  if int(id) < " & $sorted.len & ": (true, DataComponent(id)) else: (false, " & variantName(sorted[0]) & ")\n\n")
  result.add("proc tryFromName*(name: string): (bool, DataComponent) =\n  case name\n")
  for id in 0 ..< sorted.len:
    result.add("  of \"" & sorted[id] & "\": (true, " & variantName(sorted[id]) & ")\n")
  result.add("  else: (false, " & variantName(sorted[0]) & ")\n\n")
  result.add("proc toName*(self: DataComponent): string =\n  case self\n")
  for id in 0 ..< sorted.len:
    result.add("  of " & variantName(sorted[id]) & ": \"" & sorted[id] & "\"\n")
  result.add("\nproc debugName*(self: DataComponent): string =\n  ## Rust's `{:?}` of the variant.\n  case self\n")
  for id in 0 ..< sorted.len:
    result.add("  of " & variantName(sorted[id]) & ": \"" & variantName(sorted[id]).substr(2) & "\"\n")

when isMainModule:
  try:
    let generated = build()
    writeFile(OutPath, generated)
    echo "wrote " & OutPath & " (" & $generated.len & " bytes)"
  except ErrorCode as e:
    echo "generation failed: " & $e
    quit(1)
