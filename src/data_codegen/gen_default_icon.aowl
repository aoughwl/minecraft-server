## Generates src/generated/default_icon.aowl: the server's default favicon, as upstream's `include_bytes!` has it in
## connection_cache.rs. A 64x64 PNG, held as one base64 string.
##
## Run with `aowlmony c -r src/data_codegen/gen_default_icon.aowl` from the repo root.

import std/syncio

const
  InPath = "../ref/pumpkin-1.21.11/assets/default_icon.png"
  OutPath = "src/generated/default_icon.aowl"
  B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

proc encode(data: string): string =
  result = ""
  var i = 0
  while i + 2 < data.len:
    let n = (ord(data[i]) shl 16) or (ord(data[i + 1]) shl 8) or ord(data[i + 2])
    result.add(B64[(n shr 18) and 63])
    result.add(B64[(n shr 12) and 63])
    result.add(B64[(n shr 6) and 63])
    result.add(B64[n and 63])
    i += 3
  let rest = data.len - i
  if rest == 1:
    let n = ord(data[i]) shl 16
    result.add(B64[(n shr 18) and 63])
    result.add(B64[(n shr 12) and 63])
    result.add("==")
  elif rest == 2:
    let n = (ord(data[i]) shl 16) or (ord(data[i + 1]) shl 8)
    result.add(B64[(n shr 18) and 63])
    result.add(B64[(n shr 12) and 63])
    result.add(B64[(n shr 6) and 63])
    result.add('=')

proc run(): int =
  var png = ""
  try:
    png = readFile(InPath)
  except ErrorCode:
    echo "gen_default_icon: cannot read ", InPath
    return 1
  if png.len < 24:
    echo "gen_default_icon: ", InPath, " is not a PNG"
    return 1
  var text = "## Generated by src/data_codegen/gen_default_icon.aowl from assets/default_icon.png. Do not edit.\n\n"
  text.add("const DefaultIconPngBase64* = \"" & encode(png) & "\"\n")
  text.add("  ## " & $png.len & " bytes of PNG.\n")
  try:
    writeFile(OutPath, text)
  except ErrorCode:
    echo "gen_default_icon: cannot write ", OutPath
    return 1
  echo "wrote ", OutPath
  0

quit(run())
