## Port of pumpkin-codegen/src/dimension.rs (dimension.rs)
##
## Reads `assets/dimension.json` and writes src/generated/dimension.aowl. `Option` fields become a
## `hasX`/`x` pair. `monster_spawn_light_level` is the provider shape in worldgen_providers.aowl.
##
## `fixed_time` reads a key the asset does not have (it has `has_fixed_time`), so upstream's
## output is None for all four dimensions, and so is this one.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const OutPath = "src/generated/dimension.aowl"

proc intProviderLit(v: JsonNode): string =
  ## The two shapes of `value_to_int_provider` that dimension.json uses.
  if kind(v) == JInt:
    return "intConstant(" & $getInt(v) & "'i32)"
  let t = strAt(v, "type")
  if t == "minecraft:uniform":
    return "intUniform(" & $intAt(v, "min_inclusive") & "'i32, " & $intAt(v, "max_inclusive") & "'i32)"
  echo "gen_dimension: unknown int provider " & t
  quit(1)

proc colorFields(attrs: JsonNode; hasAttrs: bool; key, field: string): string =
  var found = false
  var color = 0'i32
  if hasAttrs:
    let (ok, v) = fieldOf(attrs, key)
    if ok and kind(v) == JString:
      let parsed = parseHexColor(getStr(v))
      found = parsed[0]
      color = parsed[1]
  "  has" & field & ": " & boolLit(found) & ",\n  " & toLowerAscii(field[0 .. 0]) & field[1 .. ^1] &
    ": " & $color & "'i32,\n"

proc withNamespace(s: string): string =
  if ':' in s: s else: "minecraft:" & s

proc main() =
  let text = readAsset("dimension.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))

  var s = "## GENERATED by src/data_codegen/gen_dimension.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/dimension.rs.\n\n")
  s.add("import worldgen_providers\nexport worldgen_providers\n\n")
  s.add("type Dimension* = object\n")
  s.add("  id*: uint8\n")
  s.add("  minecraftName*: string\n")
  s.add("  hasFixedTime*: bool\n")
  s.add("  fixedTime*: int64\n")
  s.add("  hasSkylight*: bool\n")
  s.add("  hasCeiling*: bool\n")
  s.add("  coordinateScale*: float64\n")
  s.add("  minY*: int32\n")
  s.add("  height*: int32\n")
  s.add("  logicalHeight*: int32\n")
  s.add("  infiniburn*: string\n")
  s.add("  ambientLight*: float32\n")
  s.add("  monsterSpawnLightLevel*: IntProvider\n")
  s.add("  monsterSpawnBlockLightLimit*: uint8\n")
  s.add("  hasSkyColor*: bool\n")
  s.add("  skyColor*: int32\n")
  s.add("  hasFogColor*: bool\n")
  s.add("  fogColor*: int32\n")
  s.add("  hasCloudColor*: bool\n")
  s.add("  cloudColor*: int32\n")
  s.add("  hasTimelines*: bool\n")
  s.add("  timelines*: string\n\n")
  s.add("proc `==`*(a, b: Dimension): bool =\n  ## Upstream's `PartialEq`: by id.\n  a.id == b.id\n\n")

  var constNames: seq[string] = @[]
  var i = 0
  while i < entries.len:
    let name = entries[i][0]
    let dim = entries[i][1]
    let formatName = shouty(stripMc(name))
    constNames.add(formatName)
    let (hasAttrs, attrs) = fieldOf(dim, "attributes")
    let (hasFixed, fixed) = fieldOf(dim, "fixed_time")
    let (hasLight, light) = fieldOf(dim, "monster_spawn_light_level")
    if not hasLight:
      echo "gen_dimension: no monster_spawn_light_level on " & name
      quit(1)
    let timelines = strAt(dim, "timelines")
    let fixedText = if hasFixed: $getInt(fixed) else: "0"
    s.add("let " & formatName & "* = Dimension(\n")
    s.add("  id: " & $i & "'u8,\n")
    s.add("  minecraftName: " & aowlStr(withNamespace(name)) & ",\n")
    s.add("  hasFixedTime: " & boolLit(hasFixed) & ",\n")
    s.add("  fixedTime: " & fixedText & "'i64,\n")
    s.add("  hasSkylight: " & boolLit(boolAt(dim, "has_skylight")) & ",\n")
    s.add("  hasCeiling: " & boolLit(boolAt(dim, "has_ceiling")) & ",\n")
    s.add("  coordinateScale: " & f64Lit(numAt(dim, "coordinate_scale")) & ",\n")
    s.add("  minY: " & $intAt(dim, "min_y") & "'i32,\n")
    s.add("  height: " & $intAt(dim, "height") & "'i32,\n")
    s.add("  logicalHeight: " & $intAt(dim, "logical_height") & "'i32,\n")
    s.add("  infiniburn: " & aowlStr(withNamespace(strAt(dim, "infiniburn"))) & ",\n")
    s.add("  ambientLight: " & f32Lit(numAt(dim, "ambient_light")) & ",\n")
    s.add("  monsterSpawnLightLevel: " & intProviderLit(light) & ",\n")
    s.add("  monsterSpawnBlockLightLimit: " & $intAt(dim, "monster_spawn_block_light_limit") & "'u8,\n")
    s.add(colorFields(attrs, hasAttrs, "minecraft:visual/sky_color", "SkyColor"))
    s.add(colorFields(attrs, hasAttrs, "minecraft:visual/fog_color", "FogColor"))
    s.add(colorFields(attrs, hasAttrs, "minecraft:visual/cloud_color", "CloudColor"))
    s.add("  hasTimelines: " & boolLit(has(dim, "timelines")) & ",\n")
    s.add("  timelines: " & aowlStr(if has(dim, "timelines"): withNamespace(timelines) else: "") & ",\n")
    s.add(")\n\n")
    inc i

  s.add("proc allDimensions*(): seq[Dimension] =\n  @[")
  i = 0
  while i < constNames.len:
    if i > 0: s.add(", ")
    s.add(constNames[i])
    inc i
  s.add("]\n\n")
  s.add("proc dimensionFromName*(name: string): (bool, Dimension) =\n")
  s.add("  ## Upstream's `from_name`, keyed by the namespaced name; the bare path is accepted too.\n")
  s.add("  case name\n")
  i = 0
  while i < constNames.len:
    let n = entries[i][0]
    s.add("  of " & aowlStr(n) & ", " & aowlStr(stripMc(n)) & ":\n    (true, " & constNames[i] & ")\n")
    inc i
  s.add("  else:\n    (false, Dimension())\n")
  writeGenerated(OutPath, s)

main()
