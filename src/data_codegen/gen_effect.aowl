## Port of pumpkin-codegen/src/effect.rs (effect.rs)
## Port of pumpkin-codegen/src/potion.rs (potion.rs)
## Port of pumpkin-codegen/src/potion_brewing.rs (potion_brewing.rs)
##
## Three small tables, literals because they are under a hundred elements each. `Item` references
## stay bare item names (upstream's `Item::GLOWSTONE_DUST` is "glowstone_dust"): src/generated's item
## table is another agent's and these ids are 26.2's either way. Upstream's associated consts become
## `T.NAME` accessors: `StatusEffect.SPEED`, `Potion.NIGHT_VISION`. Run from the repo root.

import std/[algorithm, json, strutils, syncio]
import codegenutil

proc stripMc(s: string): string =
  if s.startsWith("minecraft:"): s[10 .. ^1] else: s

proc sortedNames(obj: JsonNode): seq[string] =
  ## `BTreeMap<String, _>` key order.
  result = @[]
  for k, v in obj.pairs(): result.add(k)
  result.sort(proc(a, b: string): int = cmp(a, b))

proc pick(obj: JsonNode; key: string): JsonNode =
  ## The value of `key`, which the caller knows is there.
  result = obj
  for k, v in obj.pairs():
    if k == key: return v

proc genEffect() =
  var tree = parseJson(readAsset("effect.json"))
  let effects = root(tree)
  let names = sortedNames(effects)
  var o = "## Generated by src/data_codegen/gen_effect.aowl from assets/effect.json. Do not edit.\n\n"
  o.add("import std/[hashes, options]\nimport attributes\n\n")
  o.add("""type
  MobEffectCategory* {.pure.} = enum
    Beneficial, Harmful, Neutral

  Operation* {.pure.} = enum
    ## Upstream's `data_component_impl::Operation`, which is not ported yet.
    AddValue, AddMultipliedBase, AddMultipliedTotal

  Modifiers* = object
    attribute*: Attribute
    id*: string
    baseValue*: float64
    operation*: Operation

  StatusEffect* = object
    minecraftName*: string
    id*: uint8
    category*: MobEffectCategory
    color*: int32
    translationKey*: string
    attributeModifiers*: seq[Modifiers]

proc `==`*(a, b: StatusEffect): bool = a.id == b.id
proc hash*(a: StatusEffect): Hash = hash(a.id)

let gStatusEffects*: seq[StatusEffect] = @[
""")
  var accessors = ""
  var nameArms = ""
  var mcArms = ""
  var idArms = ""
  for i, name in names:
    let e = pick(effects, name)
    var category = "Neutral"
    case pick(e, "category").getStr()
    of "BENEFICIAL": category = "Beneficial"
    of "HARMFUL": category = "Harmful"
    else: discard
    let id = int(pick(e, "id").getInt())
    var mods = ""
    for m in pick(e, "attribute_modifiers").items():
      if mods.len > 0: mods.add(", ")
      mods.add("Modifiers(attribute: attributes." & toUpperAscii(pick(m, "attribute").getStr()) &
        ", id: " & aowlStr(pick(m, "id").getStr()) &
        ", baseValue: " & numText(pick(m, "baseValue")) & "'f64" &
        ", operation: Operation." & toPascalCase(pick(m, "operation").getStr()) & ")")
    o.add("  StatusEffect(minecraftName: " & aowlStr("minecraft:" & name) & ", id: " & $id &
      "'u8, category: MobEffectCategory." & category & ", color: " & $pick(e, "color").getInt() &
      "'i32, translationKey: " & aowlStr(pick(e, "translation_key").getStr()) &
      ", attributeModifiers: @[" & mods & "]),\n")
    accessors.add("template " & toShoutySnakeCase(name) & "*(T: typedesc[StatusEffect]): StatusEffect = gStatusEffects[" & $i & "]\n")
    nameArms.add("  of " & aowlStr(name) & ": some(gStatusEffects[" & $i & "])\n")
    mcArms.add("  of " & aowlStr("minecraft:" & name) & ": some(gStatusEffects[" & $i & "])\n")
    idArms.add("  of " & $id & "'u16: some(gStatusEffects[" & $i & "])\n")
  o.add("]\n\n" & accessors & "\n")
  o.add("proc fromName*(T: typedesc[StatusEffect]; name: string): Option[StatusEffect] =\n  case name\n" & nameArms & "  else: none[StatusEffect]()\n\n")
  o.add("proc fromMinecraftName*(T: typedesc[StatusEffect]; name: string): Option[StatusEffect] =\n  case name\n" & mcArms & "  else: none[StatusEffect]()\n\n")
  o.add("proc fromId*(T: typedesc[StatusEffect]; id: uint16): Option[StatusEffect] =\n  ## `IDSetContent::from_id`.\n  case id\n" & idArms & "  else: none[StatusEffect]()\n\n")
  o.add("proc fromStr*(T: typedesc[StatusEffect]; name: string): Option[StatusEffect] = StatusEffect.fromMinecraftName(name)\n")
  o.add("proc registryId*(self: StatusEffect): uint16 = uint16(self.id)\n")
  o.add("proc `$`*(self: StatusEffect): string = self.minecraftName\n")
  writeGenerated("src/generated/effect.aowl", o)

proc genPotion() =
  var tree = parseJson(readAsset("potion.json"))
  let potions = root(tree)
  let names = sortedNames(potions)
  var o = "## Generated by src/data_codegen/gen_effect.aowl from assets/potion.json. Do not edit.\n\n"
  o.add("import std/[hashes, options]\nimport effect\nexport effect\n\n")
  o.add("""type
  Effect* = object
    effectType*: StatusEffect
    duration*: int32
    amplifier*: uint8
    ambient*: bool
    showParticles*: bool
    showIcon*: bool
    blend*: bool

  Potion* = object
    id*: uint8
    name*: string
    effects*: seq[Effect]

proc `==`*(a, b: Potion): bool = a.id == b.id
proc hash*(a: Potion): Hash = hash(a.id)

let gPotions*: seq[Potion] = @[
""")
  var accessors = ""
  var nameArms = ""
  for i, name in names:
    let p = pick(potions, name)
    var slots = ""
    for e in pick(p, "effects").items():
      if slots.len > 0: slots.add(", ")
      slots.add("Effect(effectType: StatusEffect." & toUpperAscii(stripMc(pick(e, "effect_type").getStr())) &
        ", duration: " & $pick(e, "duration").getInt() & "'i32, amplifier: " & $pick(e, "amplifier").getInt() &
        "'u8, ambient: " & $pick(e, "ambient").getBool() & ", showParticles: " & $pick(e, "show_particles").getBool() &
        ", showIcon: " & $pick(e, "show_icon").getBool() & ", blend: false)")
    o.add("  Potion(id: " & $pick(p, "id").getInt() & "'u8, name: " & aowlStr(name) & ", effects: @[" & slots & "]),\n")
    accessors.add("template " & toShoutySnakeCase(name) & "*(T: typedesc[Potion]): Potion = gPotions[" & $i & "]\n")
    nameArms.add("  of " & aowlStr(name) & ": some(gPotions[" & $i & "])\n")
  o.add("]\n\n" & accessors & "\n")
  o.add("proc fromName*(T: typedesc[Potion]; name: string): Option[Potion] =\n  case name\n" & nameArms & "  else: none[Potion]()\n")
  writeGenerated("src/generated/potion.aowl", o)

proc recipeLines(list: JsonNode; isPotion: bool): string =
  result = ""
  for r in list.items():
    var slots = ""
    for s in pick(r, "ingredient").items():
      if slots.len > 0: slots.add(", ")
      slots.add(aowlStr(stripMc(s.getStr())))
    let fromName = toUpperAscii(stripMc(pick(r, "from").getStr()))
    let toName = toUpperAscii(stripMc(pick(r, "to").getStr()))
    if isPotion:
      result.add("  PotionRecipe(fromPotion: Potion." & fromName & ", ingredient: @[" & slots & "], toPotion: Potion." & toName & "),\n")
    else:
      result.add("  ItemRecipe(fromItem: " & aowlStr(stripMc(pick(r, "from").getStr())) & ", ingredient: @[" & slots & "], toItem: " & aowlStr(stripMc(pick(r, "to").getStr())) & "),\n")

proc genBrewing() =
  var tree = parseJson(readAsset("potion_brewing.json"))
  let data = root(tree)
  var o = "## Generated by src/data_codegen/gen_effect.aowl from assets/potion_brewing.json. Do not edit.\n"
  o.add("## Item references are bare item names, which is `Item::registry_key`.\n\n")
  o.add("import potion\nexport potion\n\n")
  o.add("""type
  PotionRecipe* = object
    fromPotion*: Potion
    ingredient*: seq[string]
    toPotion*: Potion

  ItemRecipe* = object
    fromItem*: string
    ingredient*: seq[string]
    toItem*: string

let ITEM_RECIPES*: seq[ItemRecipe] = @[
""")
  o.add(recipeLines(pick(data, "item_recipes"), false))
  o.add("]\n\nlet POTION_RECIPES*: seq[PotionRecipe] = @[\n")
  o.add(recipeLines(pick(data, "potion_recipes"), true))
  o.add("]\n")
  writeGenerated("src/generated/potion_brewing.aowl", o)

when isMainModule:
  genEffect()
  genPotion()
  genBrewing()
