## Port of pumpkin-codegen/src/enchantments.rs (enchantments.rs)
##
## assets/enchantments.json into src/generated/enchantment.aowl. Upstream's `&'static Tag` fields stay
## tag names ("minecraft:enchantable/head_armor"), and the methods that read a tag's members take that
## lookup as a closure, as src/protocol/recipe.aowl's `matchItem` does: src/generated has no tag table
## to bind to yet. Run from the repo root.

import std/[algorithm, json, strutils, syncio]
import codegenutil

proc pick(obj: JsonNode; key: string): JsonNode =
  result = obj
  for k, v in obj.pairs():
    if k == key: return v

proc slotName(s: string): string =
  case s
  of "any": "Any"
  of "mainhand": "MainHand"
  of "offhand": "OffHand"
  of "hand": "Hand"
  of "feet": "Feet"
  of "legs": "Legs"
  of "chest": "Chest"
  of "head": "Head"
  of "armor": "Armor"
  of "body": "Body"
  of "saddle": "Saddle"
  else:
    echo "unknown slot " & s
    "Any"

proc costText(c: JsonNode): string =
  "Cost(base: " & $pick(c, "base").getInt() & "'i32, perLevelAboveFirst: " & $pick(c, "per_level_above_first").getInt() & "'i32)"

proc main() =
  var tree = parseJson(readAsset("enchantments.json"))
  let all = root(tree)
  var names: seq[string] = @[]
  for k, v in all.pairs(): names.add(k)
  names.sort(proc(a, b: string): int = cmp(a, b))

  var o = "## Generated by src/data_codegen/gen_enchantments.aowl from assets/enchantments.json. Do not edit.\n\n"
  o.add("import std/[hashes, options]\nimport ../util/text/[text, color]\n\n")
  o.add("""type
  AttributeModifierSlot* {.pure.} = enum
    Any, MainHand, OffHand, Hand, Feet, Legs, Chest, Head, Armor, Body, Saddle

  Cost* = object
    base*: int32
    perLevelAboveFirst*: int32

  Enchantment* = object
    id*: uint8
    name*: string
    registryKey*: string
    description*: string
    anvilCost*: uint32
    supportedItems*: string
    exclusiveSet*: Option[string]
    maxLevel*: int32
    slots*: seq[AttributeModifierSlot]
    weight*: int32
    minCost*: Cost
    maxCost*: Cost

  TagContains* = proc(tag: string; id: uint16): bool {.closure.}
    ## `tag.1.contains(id)`, for whichever tag table the caller has.

proc calculate*(self: Cost; level: int32): int32 =
  self.base + self.perLevelAboveFirst * (level - 1)

proc `==`*(a, b: Enchantment): bool = a.id == b.id
proc hash*(a: Enchantment): Hash = hash(a.id)
proc registryId*(self: Enchantment): uint16 = uint16(self.id)

let gEnchantments*: seq[Enchantment] = @[
""")
  var accessors = ""
  var nameArms = ""
  var idArms = ""
  for i, name in names:
    let e = all.pick(name)
    let raw = name[10 .. ^1]
    let id = pick(e, "id").getInt()
    var slots = ""
    for s in pick(e, "slots").items():
      if slots.len > 0: slots.add(", ")
      slots.add("AttributeModifierSlot." & slotName(s.getStr()))
    var slotList = "@[" & slots & "]"
    if slots.len == 0: slotList = "newSeq[AttributeModifierSlot]()"
    var exclusive = "none[string]()"
    for k, v in e.pairs():
      if k == "exclusive_set":
        exclusive = "some(" & aowlStr(v.getStr()[1 .. ^1]) & ")"
    o.add("  Enchantment(id: " & $id & "'u8, name: " & aowlStr(name) & ", registryKey: " & aowlStr(raw) &
      ", description: " & aowlStr(pick(pick(e, "description"), "translate").getStr()) &
      ", anvilCost: " & $pick(e, "anvil_cost").getInt() & "'u32, supportedItems: " & aowlStr(pick(e, "supported_items").getStr()[1 .. ^1]) &
      ", exclusiveSet: " & exclusive & ", maxLevel: " & $pick(e, "max_level").getInt() & "'i32, slots: " & slotList &
      ", weight: " & $pick(e, "weight").getInt() & "'i32, minCost: " & costText(pick(e, "min_cost")) &
      ", maxCost: " & costText(pick(e, "max_cost")) & "),\n")
    accessors.add("template " & toShoutySnakeCase(raw) & "*(T: typedesc[Enchantment]): Enchantment = gEnchantments[" & $i & "]\n")
    nameArms.add("  of " & aowlStr(name) & ": some(gEnchantments[" & $i & "])\n")
    idArms.add("  of " & $id & "'u8: some(gEnchantments[" & $i & "])\n")
  o.add("]\n\n" & accessors & "\n")
  o.add("proc all*(T: typedesc[Enchantment]): seq[Enchantment] = gEnchantments\n\n")
  o.add("proc fromName*(T: typedesc[Enchantment]; name: string): Option[Enchantment] =\n  case name\n" & nameArms & "  else: none[Enchantment]()\n\n")
  o.add("proc fromId*(T: typedesc[Enchantment]; id: uint8): Option[Enchantment] =\n  case id\n" & idArms & "  else: none[Enchantment]()\n\n")
  o.add("""proc canEnchant*(self: Enchantment; itemId: uint16; contains: TagContains): bool =
  contains(self.supportedItems, itemId)

proc areCompatible*(self, other: Enchantment; contains: TagContains): bool =
  if self == other:
    return false
  if self.exclusiveSet.isSome and contains(self.exclusiveSet.get, uint16(other.id)):
    return false
  if other.exclusiveSet.isSome and contains(other.exclusiveSet.get, uint16(self.id)):
    return false
  true

proc isEnchantmentCompatible*(self: Enchantment; others: seq[Enchantment]; contains: TagContains): bool =
  ## `other: &EnchantmentsImpl`, passed as its enchantments.
  for other in others:
    if not self.areCompatible(other, contains):
      return false
  true

proc getFullname*(self: Enchantment; level: int32; isCurse: bool): TextComponent =
  ## `is_curse` is upstream's `self.has_tag(&EnchantmentTag::MINECRAFT_CURSE)`.
  result = translate(self.description).colorNamed(if isCurse: ncRed else: ncGray)
  if level != 1'i32 or self.maxLevel != 1'i32:
    result = result.addText(" ").addChild(translate("enchantment.level." & $level))
""")
  writeGenerated("src/generated/enchantment.aowl", o)

when isMainModule:
  main()
