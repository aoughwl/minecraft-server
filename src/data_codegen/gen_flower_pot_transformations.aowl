## Port of pumpkin-codegen/src/flower_pot_transformations.rs (flower_pot_transformations.rs)
##
## Reads `assets/flower_pot_transformations.json` (a `{item_id: potted_block_id}`
## map, both uint16 wire ids) and emits `getPottedItem(itemId): uint16`,
## returning the potted block's raw id or 0 (air) if the item has no potted
## form. Upstream wraps the result in a `BlockId` newtype (`BlockId::new_or_air`);
## wrapping it needs block_properties.aowl, a much larger module than this lookup, so this returns
## the raw uint16 id and callers wrap it with `newBlockIdOrAir` from there.
##
## Run with `aowlmony c -r src/data_codegen/gen_flower_pot_transformations.aowl`
## from the repo root.

import std/syncio
import codegenutil

const OutPath = "src/generated/flower_pot_transformations.aowl"

proc build(assetsPath: string): string =
  let pairs = readIntIntMapSorted(assetsPath & "/flower_pot_transformations.json")

  var s = "## GENERATED by src/data_codegen/gen_flower_pot_transformations.aowl - do not edit by hand.\n\n"
  s.add("proc getPottedItem*(itemId: uint16): uint16 =\n")
  s.add("  ## Returns the potted-block raw id for `itemId`, or 0 (air) if it has\n")
  s.add("  ## no potted form. Upstream wraps it as `BlockId::new_or_air(raw_id)`; callers use\n")
  s.add("  ## `newBlockIdOrAir` from block_properties.aowl.\n")
  s.add("  case itemId\n")
  for (itemId, pottedId) in pairs:
    s.add("  of " & $itemId & "'u16: " & $pottedId & "'u16\n")
  s.add("  else: 0'u16\n")

  s

when isMainModule:
  let assetsPath = "../ref/pumpkin-1.21.11/assets"
  try:
    let generated = build(assetsPath)
    writeFile(OutPath, generated)
    echo "wrote " & OutPath & " (" & $generated.len & " bytes)"
  except ErrorCode as e:
    echo "generation failed: " & $e
