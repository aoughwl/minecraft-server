## Port of pumpkin-codegen/src/fuels.rs (fuels.rs)
## Port of pumpkin-codegen/src/composter_increase_chance.rs (composter_increase_chance.rs)
## Port of pumpkin-codegen/src/recipe_remainder.rs (recipe_remainder.rs)
##
## Three item-id keyed lookups from flat JSON maps. Item ids are 26.2's, as upstream's are.
## Run from the repo root.

import std/[algorithm, json, strutils, syncio]
import codegenutil

proc readFloatMap(rel: string): seq[(int, float)] =
  ## `BTreeMap<u16, f32>`: numeric key order.
  var tree = parseJson(readAsset(rel))
  let obj = root(tree)
  result = @[]
  for key, val in obj.pairs():
    var id = 0
    for ch in key: id = id * 10 + (ord(ch) - ord('0'))
    result.add((id, if val.kind == JInt: float(val.getInt()) else: val.getFloat()))
  result.sort(proc(a, b: (int, float)): int = cmp(a[0], b[0]))

proc genFuels() =
  let fuels = readIntIntMapSorted(AssetsDir & "/fuels.json")
  var o = "## Generated by src/data_codegen/gen_fuels.aowl from assets/fuels.json. Do not edit.\n\n"
  o.add("import std/options\n\n")
  o.add("const FUELS*: array[" & $fuels.len & ", (uint16, uint16)] = [\n")
  for f in fuels:
    o.add("  (" & $f[0] & "'u16, " & $f[1] & "'u16),\n")
  o.add("]\n\nproc getItemBurnTicks*(itemId: uint16): Option[uint16] =\n  case itemId\n")
  for f in fuels:
    o.add("  of " & $f[0] & "'u16: some(" & $f[1] & "'u16)\n")
  o.add("  else: none[uint16]()\n\n")
  o.add("proc isFuel*(itemId: uint16): bool = getItemBurnTicks(itemId).isSome\n")
  writeGenerated("src/generated/fuels.aowl", o)

proc genComposter() =
  let chances = readFloatMap("composter_increase_chance.json")
  var o = "## Generated by src/data_codegen/gen_fuels.aowl from assets/composter_increase_chance.json. Do not edit.\n\n"
  o.add("import std/options\n\nproc getComposterIncreaseChanceFromItemId*(itemId: uint16): Option[float32] =\n  case itemId\n")
  for c in chances:
    o.add("  of " & $c[0] & "'u16: some(" & $c[1] & "'f32)\n")
  o.add("  else: none[float32]()\n")
  writeGenerated("src/generated/composter_increase_chance.aowl", o)

proc genRemainder() =
  let rem = readIntIntMapSorted(AssetsDir & "/recipe_remainder.json")
  var o = "## Generated by src/data_codegen/gen_fuels.aowl from assets/recipe_remainder.json. Do not edit.\n\n"
  o.add("import std/options\n\nproc getRecipeRemainderId*(itemId: uint16): Option[uint16] =\n  case itemId\n")
  for r in rem:
    o.add("  of " & $r[0] & "'u16: some(" & $r[1] & "'u16)\n")
  o.add("  else: none[uint16]()\n")
  writeGenerated("src/generated/recipe_remainder.aowl", o)

when isMainModule:
  genFuels()
  genComposter()
  genRemainder()
