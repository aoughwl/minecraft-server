## Port of pumpkin-codegen/src/game_rules.rs (game_rules.rs)
##
## Reads `assets/game_rules.json` (a name -> value map where each value is either a plain bool, a plain
## int, or `{"default": int, "min": .., "max": ..}`; only `default` matters, upstream ignores the rest),
## sorted by name (`BTreeMap<String, Value>` iteration order).
##
## Upstream's `GameRuleRegistry` with one field per rule, `get`/`get_mut` through `GameRuleValue`, and its
## serde form (every value a string, keyed by the raw rule name, a missing key taking its default) are here.
## `get_mut` hands back `&mut`, which becomes `set`. Run from the repo root.

import std/[syncio, json]
import codegenutil

const OutPath = "src/generated/game_rules.aowl"

type
  RuleKind = enum
    rkBool
    rkInt

  RuleEntry = object
    name: string
    kind: RuleKind
    defBool: bool
    defInt: int64

proc manualSortByName(s: var seq[RuleEntry]) =
  ## `algorithm.sort(seq[RuleEntry], proc(a,b): int = ...)` crashes at
  ## C-codegen (not at `aowlmony check`) when the element type is an object
  ## with an enum field - confirmed via a minimal repro, another variant
  ## of this port's closure-related aowlmony compiler bugs. Plain insertion
  ## sort with no closure sidesteps it; 59 entries, performance is moot.
  var i = 1
  while i < s.len:
    var j = i
    while j > 0 and s[j-1].name > s[j].name:
      let tmp = s[j-1]
      s[j-1] = s[j]
      s[j] = tmp
      dec j
    inc i

proc readGameRules(path: string): seq[RuleEntry] =
  var tree = parseFile(path)
  let obj = root(tree)
  result = @[]
  for name, val in obj.pairs():
    var e = RuleEntry(name: name, kind: rkBool, defBool: false, defInt: 0)
    let vk = val.kind
    case vk
    of JBool:
      e.kind = rkBool
      e.defBool = val.getBool()
    of JInt:
      e.kind = rkInt
      e.defInt = val.getInt()
    of JObject:
      e.kind = rkInt
      for k, v in val.pairs():
        if k == "default":
          e.defInt = v.getInt()
    else:
      discard
    result.add(e)
  manualSortByName(result)

proc build(assetsPath: string): string =
  let rules = readGameRules(assetsPath & "/game_rules.json")

  var s = "## GENERATED by src/data_codegen/gen_game_rules.aowl - do not edit by hand.\n\n"
  s.add("type\n")
  s.add("  GameRule* = enum\n")
  for r in rules:
    s.add("    gr" & toPascalCase(r.name) & "\n")
  s.add("\n")
  s.add("  GameRuleKind* = enum\n")
  s.add("    grkBool\n")
  s.add("    grkInt\n\n")

  s.add("proc gameRuleName*(r: GameRule): string =\n")
  s.add("  case r\n")
  for r in rules:
    s.add("  of gr" & toPascalCase(r.name) & ": \"" & r.name & "\"\n")
  s.add("\n")

  s.add("proc gameRuleFromName*(name: string): (bool, GameRule) =\n")
  s.add("  case name\n")
  for r in rules:
    s.add("  of \"" & r.name & "\": (true, gr" & toPascalCase(r.name) & ")\n")
  s.add("  else: (false, gr" & toPascalCase(rules[0].name) & ")\n\n")

  s.add("proc gameRuleKind*(r: GameRule): GameRuleKind =\n")
  s.add("  case r\n")
  for r in rules:
    let kindName = if r.kind == rkBool: "grkBool" else: "grkInt"
    s.add("  of gr" & toPascalCase(r.name) & ": " & kindName & "\n")
  s.add("\n")

  s.add("proc defaultBool*(r: GameRule): bool =\n")
  s.add("  ## Meaningful only when `gameRuleKind(r) == grkBool`.\n")
  s.add("  case r\n")
  for r in rules:
    let v = if r.kind == rkBool: $r.defBool else: "false"
    s.add("  of gr" & toPascalCase(r.name) & ": " & v & "\n")
  s.add("\n")

  s.add("proc defaultInt*(r: GameRule): int64 =\n")
  s.add("  ## Meaningful only when `gameRuleKind(r) == grkInt`.\n")
  s.add("  case r\n")
  for r in rules:
    let v = if r.kind == rkInt: $r.defInt else: "0"
    s.add("  of gr" & toPascalCase(r.name) & ": " & v & "'i64\n")
  s.add("\n")

  s.add("proc allGameRules*(): seq[GameRule] =\n")
  s.add("  @[\n")
  for r in rules:
    s.add("    gr" & toPascalCase(r.name) & ",\n")
  s.add("  ]\n\n")

  s.add("proc `$`*(r: GameRule): string = gameRuleName(r)\n\n")
  s.add("type\n  GameRuleRegistry* = object\n")
  for r in rules:
    s.add("    " & toLowerCamel(r.name) & "*: " & (if r.kind == rkBool: "bool" else: "int64") & "\n")
  s.add("\n  GameRuleValue* = object\n")
  s.add("    case kind*: GameRuleKind\n    of grkBool: boolValue*: bool\n    of grkInt: intValue*: int64\n\n")
  s.add("proc `$`*(v: GameRuleValue): string =\n  case v.kind\n  of grkBool: $v.boolValue\n  of grkInt: $v.intValue\n\n")
  s.add("proc defaultGameRuleRegistry*(): GameRuleRegistry =\n  GameRuleRegistry(\n")
  for r in rules:
    s.add("    " & toLowerCamel(r.name) & ": " & (if r.kind == rkBool: $r.defBool else: $r.defInt & "'i64") & ",\n")
  s.add("  )\n\n")
  s.add("proc get*(self: GameRuleRegistry; rule: GameRule): GameRuleValue =\n  case rule\n")
  for r in rules:
    if r.kind == rkBool:
      s.add("  of gr" & toPascalCase(r.name) & ": GameRuleValue(kind: grkBool, boolValue: self." & toLowerCamel(r.name) & ")\n")
    else:
      s.add("  of gr" & toPascalCase(r.name) & ": GameRuleValue(kind: grkInt, intValue: self." & toLowerCamel(r.name) & ")\n")
  s.add("\nproc set*(self: var GameRuleRegistry; rule: GameRule; value: GameRuleValue) =\n  ## `get_mut`. A value of the wrong kind leaves the rule alone.\n  case rule\n")
  for r in rules:
    if r.kind == rkBool:
      s.add("  of gr" & toPascalCase(r.name) & ":\n    if value.kind == grkBool: self." & toLowerCamel(r.name) & " = value.boolValue\n")
    else:
      s.add("  of gr" & toPascalCase(r.name) & ":\n    if value.kind == grkInt: self." & toLowerCamel(r.name) & " = value.intValue\n")
  s.add("""
proc toStringPairs*(self: GameRuleRegistry): seq[(string, string)] =
  ## The serde form: `(raw rule name, value as a string)`.
  result = @[]
  let rules = allGameRules()
  for r in rules:
    result.add((gameRuleName(r), $self.get(r)))

proc fromStringPairs*(pairs: seq[(string, string)]): GameRuleRegistry =
  ## The other way; a missing key takes its default and a value that does not parse is skipped.
  result = defaultGameRuleRegistry()
  for i in 0 ..< pairs.len:
    let (found, rule) = gameRuleFromName(pairs[i][0])
    if not found: continue
    let text = pairs[i][1]
    case gameRuleKind(rule)
    of grkBool:
      if text == "true": result.set(rule, GameRuleValue(kind: grkBool, boolValue: true))
      elif text == "false": result.set(rule, GameRuleValue(kind: grkBool, boolValue: false))
    of grkInt:
      var v = 0'i64
      var neg = false
      var ok = text.len > 0
      for ci, ch in text:
        if ci == 0 and ch == '-': neg = true
        elif ch >= '0' and ch <= '9': v = v * 10'i64 + int64(ord(ch) - ord('0'))
        else: ok = false
      if ok: result.set(rule, GameRuleValue(kind: grkInt, intValue: if neg: -v else: v))
""")

  s

when isMainModule:
  let assetsPath = "../ref/pumpkin-1.21.11/assets"
  try:
    let generated = build(assetsPath)
    writeFile(OutPath, generated)
    echo "wrote " & OutPath & " (" & $generated.len & " bytes)"
  except ErrorCode as e:
    echo "generation failed: " & $e
