## The name/id/max-stack-size table of pumpkin-codegen/src/item.rs, kept for src/server/item, src/inventory and
## src/protocol, which want no more than that. gen_item_full.aowl is the whole of that file.
## `assets/items.json` is a JSON *object* keyed by item name (not an array), value `{id, components: {...}}`;
## this reads `id` and `components["minecraft:max_stack_size"]` (default 64 when absent).

import std/[json, syncio, algorithm]
import codegenutil

type
  ItemEntry = object
    id: int
    name: string
    maxStackSize: int

proc readItems(path: string): seq[ItemEntry] =
  var tree = parseFile(path)
  let obj = root(tree)
  result = @[]
  for name, val in obj.pairs():
    var entry = ItemEntry(id: 0, name: name, maxStackSize: 64)
    for k, v in val.pairs():
      case k
      of "id": entry.id = int(v.getInt())
      of "components":
        for ck, cv in v.pairs():
          if ck == "minecraft:max_stack_size":
            entry.maxStackSize = int(cv.getInt())
      else: discard
    result.add(entry)
  result.sort(proc(a, b: ItemEntry): int = cmp(a.id, b.id))

proc main() =
  var items = readItems(AssetsDir & "/items.json")
  var table = newStringOfCap(items.len * 24)
  for i, it in items:
    if it.id != i:
      echo "item ids are not contiguous at " & it.name
      quit(1)
    table.add(it.name & "\t" & $it.maxStackSize & "\n")
  var s = "## Generated by src/data_codegen/gen_item.aowl from assets/items.json.\n"
  s.add("## SCOPED: name/id/maxStackSize only, for the callers that want no more than that. Every item with its\n")
  s.add("## typed components is src/generated/item_full.aowl (gen_item_full.aowl).\n")
  s.add("## Ids are 26.2's, as upstream's; item_id_remap.aowl turns them into another version's.\n\n")
  s.add("import gendecode\n\n")
  s.add("type\n  Item* = object\n    id*: int\n    name*: string\n    maxStackSize*: int\n\n")
  s.add("const ItemTable = " & aowlStr(table) & "\n\n")
  s.add("proc loadItems(): seq[Item] =\n  result = @[]\n  var pos = 0\n  while pos < ItemTable.len:\n")
  s.add("    let name = fieldStr(ItemTable, pos, '\\t')\n    skipSep(ItemTable, pos)\n")
  s.add("    let stack = fieldInt(ItemTable, pos, '\\t')\n    skipSep(ItemTable, pos)\n")
  s.add("    result.add(Item(id: result.len, name: name, maxStackSize: stack))\n\n")
  s.add("let AllItems*: seq[Item] = loadItems()\n\n")
  s.add("proc itemById*(id: int): (bool, Item) =\n")
  s.add("  for it in AllItems:\n    if it.id == id: return (true, it)\n")
  s.add("  (false, Item())\n\n")
  s.add("proc itemByName*(name: string): (bool, Item) =\n")
  s.add("  for it in AllItems:\n    if it.name == name: return (true, it)\n")
  s.add("  (false, Item())\n")
  writeGenerated("src/generated/item.aowl", s)
  echo "wrote " & $items.len & " items"

main()
