## Port of pumpkin-codegen/src/jukebox_song.rs (jukebox_song.rs)
##
## Song ids from assets/jukebox_song.json, lengths and comparator outputs from the `jukebox_song`
## section of assets/registry/1_21_11_synced_registries.json. Run from the repo root.

import std/[algorithm, json, syncio]
import codegenutil

proc variantIdent(stem: string): string =
  let pascal = toPascalCase(stem)
  if pascal.len > 0 and isAsciiDigit(pascal[0]): "Id" & pascal else: pascal

proc main() =
  var songsTree = parseJson(readAsset("jukebox_song.json"))
  let songsRoot = root(songsTree)
  var songs: seq[(string, int)] = @[]
  for name, id in songsRoot.pairs():
    songs.add((name, int(id.getInt())))
  songs.sort(proc(a, b: (string, int)): int = cmp(a[0], b[0]))

  var regTree = parseJson(readAsset("registry/1_21_11_synced_registries.json"))
  let regRoot = root(regTree)

  var variants = ""
  var fromNameArms = ""
  var toNameArms = ""
  var toIdArms = ""
  var toComparatorArms = ""
  var toLengthArms = ""
  for s in songs:
    let name = s[0]
    let v = "js" & variantIdent(name)
    # `map_or(0, ...)` for a song the registry does not list.
    var length = 0
    var comparator = 0
    for key, section in regRoot.pairs():
      if key != "jukebox_song": continue
      for songName, data in section.pairs():
        if songName != name: continue
        for field, value in data.pairs():
          if field == "length_in_seconds":
            length = if value.kind == JInt: int(value.getInt()) else: int(float32(value.getFloat()))
          elif field == "comparator_output":
            comparator = int(value.getInt())
    variants.add("    " & v & "\n")
    fromNameArms.add("  of " & aowlStr(name) & ": (true, " & v & ")\n")
    toNameArms.add("  of " & v & ": " & aowlStr(name) & "\n")
    toIdArms.add("  of " & v & ": " & $s[1] & "'u32\n")
    toComparatorArms.add("  of " & v & ": " & $comparator & "'u8\n")
    toLengthArms.add("  of " & v & ": " & $length & "'u32\n")

  let first = "js" & variantIdent(songs[0][0])
  let o = "## The `JukeboxSong` registry.\n" &
    "## Generated by gen_jukebox_song.aowl from assets/jukebox_song.json and the synced registries. Do not edit.\n\n" &
    "type\n  JukeboxSong* = enum\n" & variants & "\n" &
    "proc fromName*(name: string): (bool, JukeboxSong) =\n  ## From the bare song name, such as `pigstep`.\n  case name\n" & fromNameArms &
    "  else: (false, " & first & ")\n\n" &
    "proc toName*(s: JukeboxSong): string =\n  case s\n" & toNameArms & "\n" &
    "proc getId*(s: JukeboxSong): uint32 =\n  case s\n" & toIdArms & "\n" &
    "proc comparatorOutput*(s: JukeboxSong): uint8 =\n  ## 0 to 15.\n  case s\n" & toComparatorArms & "\n" &
    "proc lengthInSeconds*(s: JukeboxSong): uint32 =\n  case s\n" & toLengthArms & "\n" &
    "proc lengthInTicks*(s: JukeboxSong): uint64 =\n  uint64(lengthInSeconds(s)) * 20'u64\n"
  writeGenerated("src/generated/jukebox_song.aowl", o)

when isMainModule:
  main()
