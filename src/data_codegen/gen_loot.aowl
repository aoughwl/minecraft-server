## Port of pumpkin-codegen/src/loot.rs (loot.rs), with src/generated/loot_types.aowl: block.rs's `loot_table` field,
## the part block_properties.aowl leaves out.
##
## Upstream prints each block's table as a Rust literal inside `Block`. A literal of that shape would
## cost minutes here, so src/generated/block_loot.aowl carries the asset JSON minified in one string
## constant, indexed by block id, and decodes a table the first time it is asked for
## (src/generated/loot_types.aowl). Run from the repo root.

import std/[json, syncio]
import codegenutil

const OutPath = "src/generated/block_loot.aowl"

proc main() =
  var tree = parseJson(readAsset("blocks.json"))
  let r = root(tree)
  var blob = ""
  var rows: seq[(int, string, int, int)] = @[]
  for key, val in r.pairs():
    if key != "blocks": continue
    for b in val.items():
      var id = 0
      var name = ""
      var start = -1
      var stop = -1
      for k, x in b.pairs():
        case k
        of "id": id = int(x.getInt())
        of "name": name = x.getStr()
        of "loot_table":
          start = blob.len
          blob.add(jsonToText(x))
          stop = blob.len
        else: discard
      rows.add((id, name, start, stop))
  var index = ""
  for row in rows:
    index.add($row[0] & "\t" & row[1] & "\t" & $row[2] & "\t" & $row[3] & "\n")

  var o = "## Generated by src/data_codegen/gen_loot.aowl from assets/blocks.json. Do not edit.\n"
  o.add("## Upstream's generated `Block::loot_table`: block id to its loot table, decoded on first use.\n\n")
  o.add("import std/tables\nimport gendecode, loot_types\nexport loot_types\n\n")
  o.add("const BlockLootJson = " & aowlStr(blob) & "\n")
  o.add("const BlockLootIndex = " & aowlStr(index) & "\n")
  o.add("const BlockLootCount* = " & $rows.len & "\n\n")
  o.add("""type LootSpan = object
  start: int
  stop: int

proc loadSpans(): seq[LootSpan] =
  result = newSeq[LootSpan](BlockLootCount)
  var pos = 0
  while not atEnd(BlockLootIndex, pos):
    let id = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let start = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let stop = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    result[id] = LootSpan(start: start, stop: stop)

proc loadNames(): Table[string, int] =
  result = initTable[string, int]()
  var pos = 0
  while not atEnd(BlockLootIndex, pos):
    let id = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let name = fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    result[name] = id

let gSpans: seq[LootSpan] = loadSpans()
let gNames: Table[string, int] = loadNames()
var gCache: seq[nil LootTableRef] = newSeq[nil LootTableRef](BlockLootCount)

proc blockLootTable*(blockId: uint16): nil LootTableRef =
  ## `Block::from_id(id).loot_table`, nil where upstream has `None`.
  let i = int(blockId)
  if i >= BlockLootCount or gSpans[i].start < 0: return nil
  if gCache[i] == nil:
    gCache[i] = decodeLootTableText(substr(BlockLootJson, gSpans[i].start, gSpans[i].stop - 1))
  gCache[i]

proc blockLootTableByName*(name: string): nil LootTableRef =
  ## By bare block name, as in `Block.name`.
  let i = gNames.getOrDefault(name, -1)
  if i < 0: return nil
  blockLootTable(uint16(i))
""")
  writeGenerated(OutPath, o)

when isMainModule:
  main()
