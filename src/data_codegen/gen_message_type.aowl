## Port of pumpkin-codegen/src/message_type.rs (message_type.rs). Writes src/generated/message_type.aowl
## from assets/message_type.json: u8 ids, plus a synthetic RAW one past the vanilla ones.
## Run from the repo root: `aowlmony c -r -p:src src/data_codegen/gen_message_type.aowl`

import std/[json, strutils, algorithm]
import codegenutil

const OutPath = "src/generated/message_type.aowl"

proc build(): string =
  var tree = parseJson(readAsset("message_type.json"))
  let obj = root(tree)
  var entries: seq[(string, int)] = @[]
  for name, v in obj.pairs():
    for k, field in v.pairs():
      if k == "id":
        entries.add((name, int(field.getInt())))
  entries.sort(proc(a, b: (string, int)): int = cmp(a[0], b[0]))

  result = "## GENERATED by src/data_codegen/gen_message_type.aowl from assets/message_type.json - do not edit by hand.\n\n"
  for i in 0 ..< entries.len:
    result.add("const " & toUpperAscii(entries[i][0]) & "*: uint8 = " & $entries[i][1] & "\n")
  result.add("const RAW*: uint8 = " & $entries.len & " ## one higher than the highest vanilla id\n")

when isMainModule:
  writeGenerated(OutPath, build())
