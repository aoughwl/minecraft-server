## Port of pumpkin-codegen/src/meta_data_type.rs (meta_data_type.rs). Writes src/generated/meta_data_type.aowl
## from assets/meta_data_type/*_meta_data_type.json: serializer ids per version, -1 where a version lacks one.
## Run from the repo root: `aowlmony c -r -p:src src/data_codegen/gen_meta_data_type.aowl`

import std/[json, strutils, tables, algorithm]
import codegenutil
import codegenversion

const OutPath = "src/generated/meta_data_type.aowl"

type
  Asset = object
    version: JavaMinecraftVersion
    file: string

proc assets(): seq[Asset] =
  @[
    Asset(version: jmvV1_21, file: "1_21_meta_data_type.json"),
    Asset(version: jmvV1_21_2, file: "1_21_2_meta_data_type.json"),
    Asset(version: jmvV1_21_4, file: "1_21_4_meta_data_type.json"),
    Asset(version: jmvV1_21_5, file: "1_21_5_meta_data_type.json"),
    Asset(version: jmvV1_21_6, file: "1_21_6_meta_data_type.json"),
    Asset(version: jmvV1_21_7, file: "1_21_7_meta_data_type.json"),
    Asset(version: jmvV1_21_9, file: "1_21_9_meta_data_type.json"),
    Asset(version: jmvV1_21_11, file: "1_21_11_meta_data_type.json"),
    Asset(version: jmvV26_1, file: "26_1_meta_data_type.json"),
    Asset(version: jmvV26_2, file: "26_2_meta_data_type.json")
  ]

proc loadIds(file: string): Table[string, int] =
  result = initTable[string, int]()
  var tree = parseJson(readAsset("meta_data_type/" & file))
  let obj = root(tree)
  for name, v in obj.pairs():
    result[name] = int(v.getInt())

proc build(): string =
  let all = assets()
  var tables: seq[Table[string, int]] = @[]
  var seen = initTable[string, int]()
  var names: seq[string] = @[]
  for a in all:
    let t = loadIds(a.file)
    for name, id in t.pairs():
      if not seen.hasKey(name):
        seen[name] = 1
        names.add(name)
    tables.add(t)
  names.sort(proc(a, b: string): int = cmp(a, b))

  result = "## GENERATED by src/data_codegen/gen_meta_data_type.aowl from assets/meta_data_type/*.json - do not edit by hand.\n\n"
  result.add("import ../util/javaversion\n\n")
  result.add("type\n  MetaDataType* = object\n")
  for a in all:
    result.add("    " & a.version.toFieldIdent() & "*: int32\n")
  result.add("\nproc id*(self: MetaDataType; version: JavaMinecraftVersion): int32 =\n  case version\n")
  for a in all:
    result.add("  of " & versionEnumName(a.version) & ": self." & a.version.toFieldIdent() & "\n")
  result.add("  else: -1'i32\n\n")
  for name in names:
    var line = "const " & toUpperAscii(name) & "* = MetaDataType("
    for i in 0 ..< all.len:
      if i > 0: line.add(", ")
      line.add(all[i].version.toFieldIdent() & ": " & $tables[i].getOrDefault(name, -1) & "'i32")
    result.add(line & ")\n")

when isMainModule:
  writeGenerated(OutPath, build())
