## Port of pumpkin-codegen/src/noise_parameter.rs (noise_parameter.rs)
##
## Reads `assets/noise_parameters.json` and writes src/generated/noise_parameter.aowl: the ids,
## pre-computed MD5 halves and amplitude of each `DoublePerlinNoiseParameters`. 63 entries, small
## enough to stay literals.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const OutPath = "src/generated/noise_parameter.aowl"

proc main() =
  let text = readAsset("noise_parameters.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))

  var s = "## GENERATED by src/data_codegen/gen_noise_parameter.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/noise_parameter.rs.\n\n")
  s.add("import std/strutils\n\n")
  s.add("type\n")
  s.add("  DoublePerlinNoiseParameters* = object\n")
  s.add("    id*: int\n")
  s.add("    firstOctave*: int32\n")
  s.add("    amplitudes*: seq[float64]\n")
  s.add("    lo*: uint64\n")
  s.add("    hi*: uint64\n")
  s.add("    amplitude*: float64\n\n")
  s.add("const NOISE_PARAMETER_COUNT* = " & $entries.len & "\n\n")

  var names = ""
  var i = 0
  while i < entries.len:
    let rawName = entries[i][0]
    let param = entries[i][1]
    let name = stripMc(rawName).replace("/", "_")
    if i > 0: names.add(", ")
    names.add("\"" & name & "\"")
    let (lo, hi) = md5LoHi(rawName)

    # The non-zero span of the amplitudes, as upstream pre-computes it.
    var amps = "@["
    var minOctave = high(int32)
    var maxOctave = low(int32)
    let (_, ampNode) = fieldOf(param, "amplitudes")
    var index = 0'i32
    for a in items(ampNode):
      let v = num(a)
      if index > 0: amps.add(", ")
      amps.add(f64Lit(v))
      if v != 0.0:
        minOctave = min(minOctave, index)
        maxOctave = max(maxOctave, index)
      inc index
    amps.add("]")
    let octaves = maxOctave - minOctave
    let createAmpVal = 0.1'f64 * (1.0'f64 + 1.0'f64 / float64(octaves + 1))
    let finalAmplitude = 0.16666666666666666'f64 / createAmpVal

    s.add("let " & shouty(name) & "* = DoublePerlinNoiseParameters(id: " & $i &
      ", firstOctave: " & $intAt(param, "firstOctave") & "'i32, amplitudes: " & amps &
      ", lo: " & $lo & "'u64, hi: " & $hi & "'u64, amplitude: " & f64Lit(finalAmplitude) & ")\n")
    inc i

  s.add("\nlet NoiseParameters*: seq[DoublePerlinNoiseParameters] = @[")
  i = 0
  while i < entries.len:
    if i > 0: s.add(", ")
    s.add(shouty(stripMc(entries[i][0]).replace("/", "_")))
    inc i
  s.add("]\n\n")
  s.add("const NoiseParameterNames: array[" & $entries.len & ", string] = [" & names & "]\n\n")

  s.add("proc allNoiseParameters*(): seq[DoublePerlinNoiseParameters] =\n")
  s.add("  NoiseParameters\n\n")
  s.add("proc noiseParameterName*(id: int): string =\n")
  s.add("  ## The constant's name in lower case, which is also what density_function.json calls it.\n")
  s.add("  NoiseParameterNames[id]\n\n")
  s.add("proc idToParameters*(id: string): (bool, DoublePerlinNoiseParameters) =\n")
  s.add("  ## Upstream's `id_to_parameters`: takes `minecraft:a/b`, `a/b` or `a_b`.\n")
  s.add("  var key = id\n")
  s.add("  if key.startsWith(\"minecraft:\"):\n")
  s.add("    key = key[10 .. ^1]\n")
  s.add("  key = key.replace(\"/\", \"_\")\n")
  s.add("  for i in 0 ..< NoiseParameterNames.len:\n")
  s.add("    if NoiseParameterNames[i] == key:\n")
  s.add("      return (true, NoiseParameters[i])\n")
  s.add("  (false, DoublePerlinNoiseParameters())\n")
  writeGenerated(OutPath, s)

main()
