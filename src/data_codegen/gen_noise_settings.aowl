## Writes src/generated/noise_settings.aowl from `assets/chunk_gen_settings.json`.
##
## Upstream has no generator of this name: it is the per-dimension shape table that
## src/world/flatgen.aowl imports, and a subset of chunk_gen_settings.rs. The full upstream
## output, surface rules included, is gen_chunk_gen_settings.aowl. Same names and fields as this
## module always had, now fed from the pinned tree.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const OutPath = "src/generated/noise_settings.aowl"

proc main() =
  let text = readAsset("chunk_gen_settings.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))

  var s = "## GENERATED by src/data_codegen/gen_noise_settings.aowl - do not edit by hand.\n"
  s.add("## The shape fields of assets/chunk_gen_settings.json. The whole of upstream's table is\n")
  s.add("## generated/chunk_gen_settings.aowl.\n\n")
  s.add("type NoiseSettings* = object\n")
  s.add("  name*: string\n  seaLevel*: int32\n  defaultBlockName*: string\n  defaultFluidName*: string\n")
  s.add("  legacyRandomSource*: bool\n  minY*: int32\n  height*: int32\n")
  s.add("  sizeHorizontal*: uint8\n  sizeVertical*: uint8\n\n")

  var i = 0
  while i < entries.len:
    let name = entries[i][0]
    let v = entries[i][1]
    let (_, shape) = fieldOf(v, "noise")
    let (_, blk) = fieldOf(v, "default_block")
    let (_, fluid) = fieldOf(v, "default_fluid")
    s.add("const " & shouty(name) & "* = NoiseSettings(\n")
    s.add("  name: " & aowlStr("minecraft:" & name) & ",\n")
    s.add("  seaLevel: " & $intAt(v, "sea_level") & "'i32,\n")
    s.add("  defaultBlockName: " & aowlStr(strAt(blk, "Name")) & ",\n")
    s.add("  defaultFluidName: " & aowlStr(strAt(fluid, "Name")) & ",\n")
    s.add("  legacyRandomSource: " & boolLit(boolAt(v, "legacy_random_source")) & ",\n")
    s.add("  minY: " & $intAt(shape, "min_y") & "'i32,\n")
    s.add("  height: " & $intAt(shape, "height") & "'i32,\n")
    s.add("  sizeHorizontal: " & $intAt(shape, "size_horizontal") & "'u8,\n")
    s.add("  sizeVertical: " & $intAt(shape, "size_vertical") & "'u8,\n")
    s.add(")\n\n")
    inc i

  s.add("proc allNoiseSettings*(): seq[NoiseSettings] =\n  @[\n")
  i = 0
  while i < entries.len:
    s.add("    " & shouty(entries[i][0]) & ",\n")
    inc i
  s.add("  ]\n\n")
  s.add("proc noiseSettingsFromName*(name: string): (bool, NoiseSettings) =\n  case name\n")
  i = 0
  while i < entries.len:
    let n = entries[i][0]
    s.add("  of " & aowlStr("minecraft:" & n) & ", " & aowlStr(n) & ":\n    (true, " & shouty(n) & ")\n")
    inc i
  s.add("  else:\n    (false, NoiseSettings())\n")
  writeGenerated(OutPath, s)

main()
