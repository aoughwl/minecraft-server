## Port of pumpkin-codegen/src/packet.rs - emits src/generated/packet.aowl from
## assets/packet/*_packets.json in the pinned tree: `PacketId` with one id field
## per protocol version, `toId` lookup by `JavaMinecraftVersion`, and a constant
## per packet. Run from the repo root:
##
##     aowlmony c -r --cc:gcc -p:src src/data_codegen/gen_packet.aowl
##
## Upstream puts the constants in `serverbound`/`clientbound` modules, where a
## name such as `PLAY_KEEP_ALIVE` exists in both. One aowlmony module has one
## namespace, so the module becomes a prefix: `serverbound::PLAY_KEEP_ALIVE` is
## `SB_PLAY_KEEP_ALIVE`, `clientbound::PLAY_KEEP_ALIVE` is `CB_PLAY_KEEP_ALIVE`.
## Everything else matches upstream: name sanitizing, BTreeMap (byte) order,
## -1 for a packet absent from a version, and the fallback to the latest
## version's id in `toId`.

import std/[json, strutils, syncio]
import ../util/javaversion

const
  OutPath = "src/generated/packet.aowl"
  AssetDir = "../ref/pumpkin-1.21.11/assets/packet/"
  LatestVersion = jmvV26_2
    ## Upstream `LATEST_VERSION`.

type
  VersionAsset = object
    version: JavaMinecraftVersion
    file: string

  Entry = object
    name: string
    ids: seq[int]

proc assets(): seq[VersionAsset] =
  ## Upstream's `assets` array, already in `BTreeMap<JavaMinecraftVersion, _>`
  ## (declaration) order.
  @[
    VersionAsset(version: jmvV1_20_5, file: "1_20_5_packets.json"),
    VersionAsset(version: jmvV1_21, file: "1_21_packets.json"),
    VersionAsset(version: jmvV1_21_2, file: "1_21_2_packets.json"),
    VersionAsset(version: jmvV1_21_4, file: "1_21_4_packets.json"),
    VersionAsset(version: jmvV1_21_5, file: "1_21_5_packets.json"),
    VersionAsset(version: jmvV1_21_6, file: "1_21_6_packets.json"),
    VersionAsset(version: jmvV1_21_7, file: "1_21_7_packets.json"),
    VersionAsset(version: jmvV1_21_9, file: "1_21_9_packets.json"),
    VersionAsset(version: jmvV1_21_11, file: "1_21_11_packets.json"),
    VersionAsset(version: jmvV26_1, file: "26_1_packets.json"),
    VersionAsset(version: jmvV26_2, file: "26_2_packets.json")
  ]

proc enumName(v: JavaMinecraftVersion): string =
  ## `v1_21_11` -> `jmvV1_21_11`.
  let ident = v.toFieldIdent()
  "jmvV" & ident.substr(1)

proc constName(phase, packet: string): string =
  ## `format!("{}_{}", phase.to_uppercase(), name.replace(['/', '-'], "_").to_uppercase())`
  result = toUpperAscii(phase) & "_"
  for ch in packet:
    if ch == '/' or ch == '-':
      result.add('_')
    else:
      result.add(toUpperAscii(ch))

proc addId(entries: var seq[Entry]; name: string; versionIdx, versionCount, id: int) =
  for i in 0 ..< entries.len:
    if entries[i].name == name:
      entries[i].ids[versionIdx] = id
      return
  var ids = newSeq[int](versionCount)
  for i in 0 ..< versionCount:
    ids[i] = -1
  ids[versionIdx] = id
  entries.add(Entry(name: name, ids: ids))

proc sortByName(entries: var seq[Entry]) =
  ## Closure-free insertion sort: a `BTreeMap<String, _>` iterates in byte
  ## order, which is what `<` on strings compares.
  for i in 1 ..< entries.len:
    let e = entries[i]
    var j = i - 1
    while j >= 0 and e.name < entries[j].name:
      entries[j + 1] = entries[j]
      dec j
    entries[j + 1] = e

proc collect(vs: seq[VersionAsset]; direction: string): seq[Entry] =
  ## Port of the first half of `generate_mapped_consts`.
  result = @[]
  for vi in 0 ..< vs.len:
    var tree = parseFile(AssetDir & vs[vi].file)
    let rootNode = root(tree)
    for dirKey, phases in rootNode.pairs():
      if dirKey == direction:
        for phase, packets in phases.pairs():
          for name, idNode in packets.pairs():
            addId(result, constName(phase, name), vi, vs.len, int(idNode.getInt()))
  sortByName(result)

proc emitConsts(s: var string; prefix: string; vs: seq[VersionAsset]; entries: seq[Entry]) =
  s.add("const\n")
  for e in entries:
    s.add("  " & prefix & e.name & "* = PacketId(")
    for vi in 0 ..< vs.len:
      if vi > 0:
        s.add(", ")
      s.add(vs[vi].version.toFieldIdent() & ": " & $e.ids[vi] & "'i32")
    s.add(")\n")
  s.add("\n")

proc build(): string =
  let vs = assets()
  let latestField = LatestVersion.toFieldIdent()
  result = "## GENERATED by src/data_codegen/gen_packet.aowl from assets/packet/*_packets.json - do not edit by hand.\n"
  result.add("## The packet ids of pumpkin_data::packet (pumpkin-codegen/src/packet.rs). `SB_` is upstream's\n")
  result.add("## `serverbound` module, `CB_` its `clientbound` module. An id of -1 means the packet does not\n")
  result.add("## exist in that version.\n\n")
  result.add("import ../util/javaversion\n\n")
  result.add("const\n")
  result.add("  CURRENT_MC_VERSION* = " & enumName(LatestVersion) & "\n")
  result.add("  LOWEST_SUPPORTED_MC_VERSION* = jmvV1_7_2\n\n")
  result.add("type\n  PacketId* = object\n")
  for v in vs:
    result.add("    " & v.version.toFieldIdent() & "*: int32\n")
  result.add("\nproc toId*(self: PacketId; version: JavaMinecraftVersion): int32 =\n")
  result.add("  ## Converts the requested protocol version into the corresponding packet ID.\n")
  result.add("  ## Returns -1 if the packet does not exist in that version.\n")
  result.add("  case version\n")
  for v in vs:
    result.add("  of " & enumName(v.version) & ": self." & v.version.toFieldIdent() & "\n")
  result.add("  else: self." & latestField & "\n\n")
  result.add("proc `==`*(self: PacketId; other: int32): bool = self." & latestField & " == other\n")
  result.add("proc `==`*(self: int32; other: PacketId): bool = self == other." & latestField & "\n\n")
  emitConsts(result, "SB_", vs, collect(vs, "serverbound"))
  emitConsts(result, "CB_", vs, collect(vs, "clientbound"))

when isMainModule:
  try:
    let generated = build()
    writeFile(OutPath, generated)
    echo "wrote " & OutPath & " (" & $generated.len & " bytes)"
  except ErrorCode as e:
    echo "generation failed: " & $e
    quit(1)
