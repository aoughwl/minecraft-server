## Port of pumpkin-codegen/src/placed_feature.rs (placed_feature.rs)
##
## Reads `assets/placed_feature.json` and writes both of upstream's outputs:
## - `build_enum` as src/generated/placed_feature.aowl: the `PlacedFeature` enum.
## - `build` as src/generated/placed_features_generated.aowl.
##
## Typed here: the configured feature each entry names and the kind of each of its modifiers. The rest stays as the asset's
## own JSON, by name, as gendecode.aowl explains: src/world/generation/feature/decode.aowl is the rest of `build`, and
## builds `PlacementModifier`, `BlockPredicate` and `HeightProvider` from it, once per entry and when first asked for.
##
## The helpers upstream exports from this file (`value_to_int_provider`, `value_to_y_offset`,
## `value_to_block_predicate`, ...) serve its Rust generators; here dimension and carver have
## their own over the shapes they use, and block predicates are in the JSON.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const EnumPath = "src/generated/placed_feature.aowl"
const DataPath = "src/generated/placed_features_generated.aowl"

proc die(msg: string) =
  echo "gen_placed_feature: " & msg
  quit(1)

proc modifierKind(t: string): string =
  ## The arms of `value_to_placement_modifier`.
  case t
  of "minecraft:biome": "Biome"
  of "minecraft:in_square": "InSquare"
  of "minecraft:fixed_placement": "FixedPlacement"
  of "minecraft:heightmap": "Heightmap"
  of "minecraft:height_range": "HeightRange"
  of "minecraft:count": "Count"
  of "minecraft:count_on_every_layer": "CountOnEveryLayer"
  of "minecraft:rarity_filter": "RarityFilter"
  of "minecraft:block_predicate_filter": "BlockPredicateFilter"
  of "minecraft:surface_relative_threshold_filter": "SurfaceRelativeThresholdFilter"
  of "minecraft:surface_water_depth_filter": "SurfaceWaterDepthFilter"
  of "minecraft:noise_based_count": "NoiseBasedCount"
  of "minecraft:noise_threshold_count": "NoiseThresholdCount"
  of "minecraft:environment_scan": "EnvironmentScan"
  of "minecraft:random_offset": "RandomOffset"
  else:
    die("unknown placement modifier: " & t)
    ""

proc buildEnum(names: seq[string]): string =
  result = "## GENERATED by src/data_codegen/gen_placed_feature.aowl - do not edit by hand.\n"
  result.add("## Port of pumpkin-data/src/generated/placed_feature.rs.\n\n")
  result.add("type\n  PlacedFeature* {.pure.} = enum\n")
  var i = 0
  while i < names.len:
    result.add("    " & toPascalCase(names[i]) & "\n")
    inc i
  result.add("\nconst PlacedFeatureNames: array[" & $names.len & ", string] = [\n")
  i = 0
  while i < names.len:
    result.add("  " & aowlStr(names[i]) & ",\n")
    inc i
  result.add("]\n\n")
  result.add("proc fromName*(T: typedesc[PlacedFeature]; name: string): (bool, PlacedFeature) =\n")
  result.add("  ## Takes the name with or without `minecraft:`. Names are sorted, as the variants are.\n")
  result.add("  var key = name\n")
  result.add("  if key.len > 10 and key[0 .. 9] == \"minecraft:\":\n    key = key[10 .. ^1]\n")
  result.add("  var lo = 0\n  var hi = PlacedFeatureNames.len - 1\n")
  result.add("  while lo <= hi:\n    let mid = (lo + hi) div 2\n")
  result.add("    if PlacedFeatureNames[mid] == key:\n      return (true, PlacedFeature(mid))\n")
  result.add("    if PlacedFeatureNames[mid] < key:\n      lo = mid + 1\n    else:\n      hi = mid - 1\n")
  result.add("  (false, PlacedFeature(0))\n\n")
  result.add("proc toName*(self: PlacedFeature): string =\n  ## The bare name.\n  PlacedFeatureNames[ord(self)]\n\n")
  result.add("proc allNames*(T: typedesc[PlacedFeature]): seq[string] =\n")
  result.add("  ## Upstream's `all_names`: namespaced, in variant order.\n")
  result.add("  result = newSeq[string](PlacedFeatureNames.len)\n")
  result.add("  for i in 0 ..< PlacedFeatureNames.len:\n")
  result.add("    result[i] = \"minecraft:\" & PlacedFeatureNames[i]\n")

proc main() =
  let text = readAsset("placed_feature.json")
  var tree = parseJson(text)
  let entries = sortedPairs(root(tree))
  let raws = topLevelValues(minifyJson(text))
  if raws.len != entries.len:
    die("raw split found " & $raws.len & " entries, expected " & $entries.len)

  var names: seq[string] = @[]
  var i = 0
  while i < entries.len:
    names.add(entries[i][0])
    inc i
  writeGenerated(EnumPath, buildEnum(names))

  # The configured feature's name, each modifier kind, then the raw JSON, one line per entry.
  var rows = ""
  i = 0
  while i < entries.len:
    if raws[i][0] != entries[i][0]:
      die("raw split out of step at " & entries[i][0])
    let v = entries[i][1]
    let (_, feature) = fieldOf(v, "feature")
    if kind(feature) != JString:
      # Upstream stubs inline features to `NoOp`. The asset has none; stop rather than guess.
      die("inline feature in " & entries[i][0])
    let (_, placement) = fieldOf(v, "placement")
    var kinds = ""
    for m in items(placement):
      if kinds.len > 0: kinds.add(",")
      kinds.add(modifierKind(strAt(m, "type")))
    rows.add(stripMc(getStr(feature)) & "|" & kinds & "|" & raws[i][1] & "\n")
    inc i

  var s = "## GENERATED by src/data_codegen/gen_placed_feature.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/placed_features_generated.rs in compact form: see the generator.\n")
  s.add("## `json` in each entry is the input of src/world/generation/feature/decode.aowl, which builds the typed form.\n\n")
  s.add("import gendecode\nimport placed_feature\nimport configured_feature\nexport placed_feature, configured_feature\n\n")
  s.add("type\n  PlacementModifierKind* {.pure.} = enum\n")
  s.add("    Biome, InSquare, FixedPlacement, Heightmap, HeightRange, Count, CountOnEveryLayer, RarityFilter,\n")
  s.add("    BlockPredicateFilter, SurfaceRelativeThresholdFilter, SurfaceWaterDepthFilter, NoiseBasedCount,\n")
  s.add("    NoiseThresholdCount, EnvironmentScan, RandomOffset\n\n")
  s.add("  PlacedFeatureEntry* = object\n")
  s.add("    feature*: ConfiguredFeature  ## Upstream's `Feature::Named`. The asset has no inline feature.\n")
  s.add("    placement*: seq[PlacementModifierKind]  ## In order; parameters are in `json`.\n")
  s.add("    json*: string  ## The asset's own entry, minified.\n\n")
  s.add("const PlacedFeatureData = " & aowlStr(rows) & "\n\n")
  s.add("proc modifierKindFromName(name: string): PlacementModifierKind =\n")
  s.add("  for k in low(PlacementModifierKind) .. high(PlacementModifierKind):\n")
  s.add("    if $k == name:\n      return k\n")
  s.add("  genPanic(\"placed_features_generated: bad modifier \" & name)\n")
  s.add("  PlacementModifierKind.Biome\n\n")
  s.add("proc load(): seq[PlacedFeatureEntry] =\n")
  s.add("  result = @[]\n  var pos = 0\n  let d = PlacedFeatureData\n")
  s.add("  while pos < d.len:\n")
  s.add("    let featureName = fieldStr(d, pos, '|')\n    skipSep(d, pos)\n")
  s.add("    let (found, feature) = ConfiguredFeature.fromName(featureName)\n")
  s.add("    if not found:\n      genPanic(\"placed_features_generated: bad feature \" & featureName)\n")
  s.add("    var placement: seq[PlacementModifierKind] = @[]\n")
  s.add("    while pos < d.len and d[pos] != '|':\n")
  s.add("      placement.add(modifierKindFromName(fieldStr(d, pos, ',', '|')))\n")
  s.add("      if d[pos] == ',':\n        inc pos\n")
  s.add("    skipSep(d, pos)\n")
  s.add("    let json = fieldStr(d, pos, '\\n')\n    skipSep(d, pos)\n")
  s.add("    result.add(PlacedFeatureEntry(feature: feature, placement: placement, json: json))\n\n")
  s.add("let PlacedFeatureEntries*: seq[PlacedFeatureEntry] = load()\n")
  s.add("  ## Upstream's `build_placed_features()` map: indexed by `ord(PlacedFeature)`.\n\n")
  s.add("proc placedFeatureEntry*(f: PlacedFeature): PlacedFeatureEntry {.inline.} =\n")
  s.add("  PlacedFeatureEntries[ord(f)]\n\n")
  s.add("proc placedFeatureJson*(name: string): (bool, string) =\n")
  s.add("  ## The entry's JSON by name, with or without `minecraft:`.\n")
  s.add("  let (found, f) = PlacedFeature.fromName(name)\n")
  s.add("  if found: (true, PlacedFeatureEntries[ord(f)].json) else: (false, \"\")\n")
  writeGenerated(DataPath, s)

main()
