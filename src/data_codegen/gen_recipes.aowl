## Port of pumpkin-codegen/src/recipes.rs (recipes.rs)
##
## assets/recipes.json into src/generated/recipes.aowl: one text constant decoded when the module
## loads. Upstream's `RECIPES_CRAFTING`, `RECIPES_COOKING`, `RECIPES_STONECUTTING` are there, and the
## older split lists other code imports (`shapedRecipes` and friends) are the same data.
##
## Upstream reads but does not emit: smithing_transform, smithing_trim, and every other type, which
## its `#[serde(other)]` folds into `CraftingSpecial` (crafting_special_*, crafting_dye, crafting_imbue).
## Those stay out here too. Run from the repo root.

import std/[algorithm, json, strutils, syncio]
import codegenutil

const
  OutPath = "src/generated/recipes.aowl"
  Sep = "\x1f"  ## Between the items of a list field; recipe patterns may hold any printable.

proc pick(obj: JsonNode; key: string): (bool, JsonNode) =
  for k, v in obj.pairs():
    if k == key: return (true, v)
  (false, obj)

proc strOf(obj: JsonNode; key: string): string =
  let (has, v) = pick(obj, key)
  if has: v.getStr() else: ""

proc ingredientText(v: JsonNode): string =
  ## `Simple`/`Tagged` as written, `OneOf` as `|`-joined, marked by a leading `|`.
  if v.kind == JString:
    return v.getStr()
  result = "|"
  var first = true
  for x in v.items():
    if not first: result.add('|')
    first = false
    result.add(x.getStr())

proc resultText(obj: JsonNode): string =
  ## `id \t count`, count defaulting to 1.
  let (_, r) = pick(obj, "result")
  let (hasCount, count) = pick(r, "count")
  strOf(r, "id") & "\t" & (if hasCount: $count.getInt() else: "1")

proc commonText(obj: JsonNode): string =
  ## `category \t group \t hasGroup`. A missing category is Misc.
  let (hasGroup, group) = pick(obj, "group")
  let category = strOf(obj, "category")
  (if category.len > 0: category else: "misc") & "\t" & (if hasGroup: group.getStr() else: "") & "\t" & (if hasGroup: "1" else: "0")

proc cookingRow(tag: string; defaultTime: int; id: string; obj: JsonNode): string =
  let (_, ing) = pick(obj, "ingredient")
  let (hasTime, time) = pick(obj, "cookingtime")
  let (_, exp) = pick(obj, "experience")
  tag & "\t" & id & "\t" & commonText(obj) & "\t" & ingredientText(ing) & "\t" &
    (if hasTime: $time.getInt() else: $defaultTime) & "\t" & numText(exp) & "\t" & resultText(obj) & "\n"

proc main() =
  var tree = parseJson(readAsset("recipes.json"))
  let r = root(tree)
  var ids: seq[string] = @[]
  for k, v in r.pairs(): ids.add(k)
  ids.sort(proc(a, b: string): int = cmp(a, b))

  var text = ""
  for id in ids:
    let (_, obj) = pick(r, id)
    case strOf(obj, "type")
    of "minecraft:blasting": text.add(cookingRow("B", 100, id, obj))
    of "minecraft:campfire_cooking": text.add(cookingRow("C", 100, id, obj))
    of "minecraft:smelting": text.add(cookingRow("M", 200, id, obj))
    of "minecraft:smoking": text.add(cookingRow("K", 100, id, obj))
    of "minecraft:crafting_shaped":
      var keys: seq[string] = @[]
      let (_, keyNode) = pick(obj, "key")
      for k, v in keyNode.pairs(): keys.add(k)
      keys.sort(proc(a, b: string): int = cmp(a, b))  # BTreeMap order
      var keyText = ""
      for k in keys:
        let (_, ing) = pick(keyNode, k)
        if keyText.len > 0: keyText.add(Sep)
        keyText.add($k[0] & ingredientText(ing))
      var pattern = ""
      let (_, patternNode) = pick(obj, "pattern")
      var firstRow = true
      for row in patternNode.items():
        if not firstRow: pattern.add(Sep)
        firstRow = false
        pattern.add(row.getStr())
      let (hasShow, show) = pick(obj, "show_notification")
      text.add("S\t" & id & "\t" & commonText(obj) & "\t" & (if hasShow and not show.getBool(): "0" else: "1") &
        "\t" & keyText & "\t" & pattern & "\t" & resultText(obj) & "\n")
    of "minecraft:crafting_shapeless":
      var ings = ""
      let (_, ingNode) = pick(obj, "ingredients")
      var first = true
      for x in ingNode.items():
        if not first: ings.add(Sep)
        first = false
        ings.add(ingredientText(x))
      text.add("L\t" & id & "\t" & commonText(obj) & "\t" & ings & "\t" & resultText(obj) & "\n")
    of "minecraft:crafting_transmute":
      let (_, input) = pick(obj, "input")
      let (_, material) = pick(obj, "material")
      text.add("T\t" & id & "\t" & commonText(obj) & "\t" & ingredientText(input) & "\t" & ingredientText(material) & "\t" & resultText(obj) & "\n")
    of "minecraft:crafting_decorated_pot":
      let category = strOf(obj, "category")
      text.add("D\t" & id & "\t" & (if category.len > 0: category else: "misc") & "\n")
    of "minecraft:stonecutting":
      let (_, ing) = pick(obj, "ingredient")
      let (hasGroup, group) = pick(obj, "group")
      text.add("X\t" & id & "\t" & (if hasGroup: group.getStr() else: "") & "\t" & (if hasGroup: "1" else: "0") & "\t" & ingredientText(ing) & "\t" & resultText(obj) & "\n")
    else:
      discard # smithing_*, crafting_special_*, crafting_dye, crafting_imbue: upstream drops them.

  var o = "## Generated by src/data_codegen/gen_recipes.aowl from assets/recipes.json. Do not edit.\n"
  o.add("## Upstream's generated recipes.rs. Item names are strings, with ids resolved by the caller.\n\n")
  o.add("import std/options\nimport gendecode\n\n")
  o.add("const RecipesText = " & aowlStr(text) & "\n\n")
  o.add("""type
  RecipeCategory* = enum
    ## Upstream's `RecipeCategoryTypes`, whose `Restone` is spelt `rcRedstone` here.
    rcEquipment, rcBuilding, rcRedstone, rcMisc, rcFood, rcBlocks

  RecipeIngredientKind* = enum
    rikSimple, rikTagged, rikOneOf

  RecipeIngredient* = object
    ## Upstream's `RecipeIngredientTypes`.
    case kind*: RecipeIngredientKind
    of rikSimple, rikTagged:
      name*: string
    of rikOneOf:
      options*: seq[string]

  RecipeResult* = object
    ## Upstream's `RecipeResultStruct`.
    id*: string
    count*: uint8

  ShapedRecipe* = object
    id*: string
    category*: RecipeCategory
    group*: string
    hasGroup*: bool
    showNotification*: bool
    keyChars*: seq[char]
    keyIngredients*: seq[RecipeIngredient]
    pattern*: seq[string]
    result*: RecipeResult

  ShapelessRecipe* = object
    id*: string
    category*: RecipeCategory
    group*: string
    hasGroup*: bool
    ingredients*: seq[RecipeIngredient]
    result*: RecipeResult

  TransmuteRecipe* = object
    id*: string
    category*: RecipeCategory
    group*: string
    hasGroup*: bool
    input*: RecipeIngredient
    material*: RecipeIngredient
    result*: RecipeResult

  DecoratedPotRecipe* = object
    id*: string
    category*: RecipeCategory

  CraftingRecipeKind* = enum
    crkCraftingShaped, crkCraftingShapeless, crkCraftingTransmute, crkCraftingDecoratedPot

  CraftingRecipeTypes* = object
    ## Upstream's enum; `CraftingSpecial` is never emitted upstream either.
    case kind*: CraftingRecipeKind
    of crkCraftingShaped: shaped*: ShapedRecipe
    of crkCraftingShapeless: shapeless*: ShapelessRecipe
    of crkCraftingTransmute: transmute*: TransmuteRecipe
    of crkCraftingDecoratedPot: decoratedPot*: DecoratedPotRecipe

  CookingRecipeKind* = enum
    crkSmelting, crkBlasting, crkSmoking, crkCampfireCooking

  CookingRecipe* = object
    id*: string  ## Upstream's `recipe_id`, the full `minecraft:` key.
    kind*: CookingRecipeKind
    category*: RecipeCategory
    group*: string
    hasGroup*: bool
    ingredient*: RecipeIngredient
    cookingTime*: int32
    experience*: float32
    result*: RecipeResult

  StonecutterRecipe* = object
    id*: string
    group*: string
    hasGroup*: bool
    ingredient*: RecipeIngredient
    result*: RecipeResult

proc matches*(ing: RecipeIngredient, itemName: string): bool =
  ## `itemName` is the full `minecraft:xxx` registry key. A tag cannot be resolved here, so
  ## `rikTagged` is false and needs `matchItem`, which takes the tag lookup.
  case ing.kind
  of rikSimple: ing.name == itemName
  of rikTagged: false
  of rikOneOf: itemName in ing.options

proc matchItem*(ing: RecipeIngredient; registryKey: string;
    isTaggedWith: proc(tag: string): bool {.closure.}): bool =
  ## Upstream's `match_item`; `registryKey` is the bare `Item::registry_key`.
  case ing.kind
  of rikSimple: "minecraft:" & registryKey == ing.name
  of rikTagged: isTaggedWith(ing.name)
  of rikOneOf: ("minecraft:" & registryKey) in ing.options

proc categoryOf(s: string): RecipeCategory =
  case s
  of "equipment": rcEquipment
  of "building": rcBuilding
  of "redstone": rcRedstone
  of "food": rcFood
  of "blocks": rcBlocks
  else: rcMisc

proc splitOn(s: string; sep: char): seq[string] =
  result = @[]
  var pos = 0
  while pos <= s.len:
    if pos == s.len:
      result.add("")
      break
    result.add(fieldStr(s, pos, sep))
    if pos >= s.len: break
    inc pos

proc parseIngredient(s: string): RecipeIngredient =
  if s.len > 0 and s[0] == '|':
    RecipeIngredient(kind: rikOneOf, options: splitOn(substr(s, 1, s.len - 1), '|'))
  elif s.len > 0 and s[0] == '#':
    RecipeIngredient(kind: rikTagged, name: s)
  else:
    RecipeIngredient(kind: rikSimple, name: s)

proc parseIngredients(s: string): seq[RecipeIngredient] =
  result = @[]
  if s.len == 0: return
  let parts = splitOn(s, '\x1f')
  for p in parts: result.add(parseIngredient(p))

var shapedRecipes*: seq[ShapedRecipe] = @[]
var shapelessRecipes*: seq[ShapelessRecipe] = @[]
var transmuteRecipes*: seq[TransmuteRecipe] = @[]
var decoratedPotRecipes*: seq[DecoratedPotRecipe] = @[]
var cookingRecipes*: seq[CookingRecipe] = @[]
var stonecutterRecipes*: seq[StonecutterRecipe] = @[]
var RECIPES_CRAFTING*: seq[CraftingRecipeTypes] = @[]

proc loadRecipes() =
  let s = RecipesText
  var pos = 0
  template str(): string =
    let v = fieldStr(s, pos, '\t')
    skipSep(s, pos)
    v
  template num(): int =
    let v = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    v
  while not atEnd(s, pos):
    let tag = s[pos]
    pos += 2
    let id = str()
    case tag
    of 'B', 'C', 'M', 'K':
      let category = str()
      let group = str()
      let hasGroup = num() != 0
      let ing = str()
      let time = num()
      let exp = fieldFloat(s, pos, '\t')
      skipSep(s, pos)
      let resultId = str()
      let count = num()
      let kind = case tag
        of 'B': crkBlasting
        of 'C': crkCampfireCooking
        of 'K': crkSmoking
        else: crkSmelting
      cookingRecipes.add(CookingRecipe(id: id, kind: kind, category: categoryOf(category), group: group,
        hasGroup: hasGroup, ingredient: parseIngredient(ing), cookingTime: int32(time),
        experience: float32(exp), result: RecipeResult(id: resultId, count: uint8(count))))
    of 'S':
      let category = str()
      let group = str()
      let hasGroup = num() != 0
      let show = num() != 0
      let keys = str()
      let pattern = str()
      let resultId = str()
      let count = num()
      var keyChars: seq[char] = @[]
      var keyIngredients: seq[RecipeIngredient] = @[]
      let keyParts = splitOn(keys, '\x1f')
      for k in keyParts:
        keyChars.add(k[0])
        keyIngredients.add(parseIngredient(substr(k, 1, k.len - 1)))
      let recipe = ShapedRecipe(id: id, category: categoryOf(category), group: group, hasGroup: hasGroup,
        showNotification: show, keyChars: keyChars, keyIngredients: keyIngredients,
        pattern: splitOn(pattern, '\x1f'), result: RecipeResult(id: resultId, count: uint8(count)))
      shapedRecipes.add(recipe)
      RECIPES_CRAFTING.add(CraftingRecipeTypes(kind: crkCraftingShaped, shaped: recipe))
    of 'L':
      let category = str()
      let group = str()
      let hasGroup = num() != 0
      let ings = str()
      let resultId = str()
      let count = num()
      let recipe = ShapelessRecipe(id: id, category: categoryOf(category), group: group, hasGroup: hasGroup,
        ingredients: parseIngredients(ings), result: RecipeResult(id: resultId, count: uint8(count)))
      shapelessRecipes.add(recipe)
      RECIPES_CRAFTING.add(CraftingRecipeTypes(kind: crkCraftingShapeless, shapeless: recipe))
    of 'T':
      let category = str()
      let group = str()
      let hasGroup = num() != 0
      let input = str()
      let material = str()
      let resultId = str()
      let count = num()
      let recipe = TransmuteRecipe(id: id, category: categoryOf(category), group: group, hasGroup: hasGroup,
        input: parseIngredient(input), material: parseIngredient(material),
        result: RecipeResult(id: resultId, count: uint8(count)))
      transmuteRecipes.add(recipe)
      RECIPES_CRAFTING.add(CraftingRecipeTypes(kind: crkCraftingTransmute, transmute: recipe))
    of 'D':
      let category = str()
      let recipe = DecoratedPotRecipe(id: id, category: categoryOf(category))
      decoratedPotRecipes.add(recipe)
      RECIPES_CRAFTING.add(CraftingRecipeTypes(kind: crkCraftingDecoratedPot, decoratedPot: recipe))
    else:
      let group = str()
      let hasGroup = num() != 0
      let ing = str()
      let resultId = str()
      let count = num()
      stonecutterRecipes.add(StonecutterRecipe(id: id, group: group, hasGroup: hasGroup,
        ingredient: parseIngredient(ing), result: RecipeResult(id: resultId, count: uint8(count))))

loadRecipes()

let RECIPES_COOKING*: seq[CookingRecipe] = cookingRecipes
let RECIPES_STONECUTTING*: seq[StonecutterRecipe] = stonecutterRecipes

proc getCookingRecipeWithIngredient*(registryKey: string; recipeType: CookingRecipeKind;
    isTaggedWith: proc(tag: string): bool {.closure.}): Option[CookingRecipe] =
  ## `ingredient: &Item` is its bare `registry_key`.
  for r in cookingRecipes:
    if r.kind == recipeType and matchItem(r.ingredient, registryKey, isTaggedWith):
      return some(r)
  none[CookingRecipe]()

proc getRecipeExperience*(recipeId: string): Option[float32] =
  for r in cookingRecipes:
    if r.id == recipeId:
      return some(r.experience)
  none[float32]()
""")
  writeGenerated(OutPath, o)

when isMainModule:
  main()
