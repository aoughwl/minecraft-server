## Port of pumpkin-codegen/src/sound.rs (sound.rs).
## Generator for `Sound`.

import std/syncio
import codegenutil

proc main() =
  let sounds = readStringArray("../ref/pumpkin-1.21.11/assets/sounds.json")

  var variants = ""
  var fromNameArms = ""
  var toNameArms = ""

  for i, name in sounds:
    let v = "sd" & toPascalCase(name)
    variants.add("    " & v & "\n")
    fromNameArms.add("  of \"" & name & "\": (true, " & v & ")\n")
    toNameArms.add("  of " & v & ": \"" & name & "\"\n")

  let firstVariant = if sounds.len > 0: "sd" & toPascalCase(sounds[0]) else: "sdNone"

  let output = "## The `Sound` registry (id = declaration/array order, matching\n" &
    "## upstream's #[repr(u16)] enum).\n" &
    "## Generated by gen_sound.aowl from upstream/assets/sounds.json - do not edit by hand.\n\n" &
    "type\n" &
    "  Sound* = enum\n" &
    variants & "\n" &
    "proc fromName*(name: string): (bool, Sound) =\n" &
    "  case name\n" & fromNameArms &
    "  else: (false, " & firstVariant & ")\n\n" &
    "proc toName*(s: Sound): string =\n" &
    "  case s\n" & toNameArms & "\n" &
    "proc soundNames*(): seq[string] =\n" &
    "  ## `Sound::NAMES`, by id.\n" &
    "  result = newSeqOfCap[string](" & $sounds.len & ")\n" &
    "  for i in 0 ..< " & $sounds.len & ":\n" &
    "    result.add(toName(Sound(i)))\n\n" &
    "proc soundSlice*(): seq[Sound] =\n" &
    "  ## `Sound::slice`, by id.\n" &
    "  result = newSeqOfCap[Sound](" & $sounds.len & ")\n" &
    "  for i in 0 ..< " & $sounds.len & ":\n" &
    "    result.add(Sound(i))\n"

  try:
    writeFile("src/generated/sound.aowl", output)
  except ErrorCode as e:
    echo "write failed: " & $e
  echo "wrote src/generated/sound.aowl (" & $sounds.len & " sounds)"

main()
