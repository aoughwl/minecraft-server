## Port of pumpkin-codegen/src/spawn_egg.rs (spawn_egg.rs)
##
## assets/spawn_egg.json: spawn-egg item id (26.2's) to entity name. Run from the repo root.

import std/[algorithm, json, syncio]
import codegenutil

proc main() =
  var tree = parseJson(readAsset("spawn_egg.json"))
  let r = root(tree)
  var eggs: seq[(int, string)] = @[]
  for key, val in r.pairs():
    var id = 0
    for ch in key: id = id * 10 + (ord(ch) - ord('0'))
    eggs.add((id, val.getStr()))
  eggs.sort(proc(a, b: (int, string)): int = cmp(a[0], b[0]))

  var o = "## Generated by src/data_codegen/gen_spawn_egg.aowl from assets/spawn_egg.json. Do not edit.\n\n"
  o.add("import std/options\nimport entity_type\n\n")
  o.add("proc entityNameFromEgg*(id: uint16): string =\n  ## The entity's `resourceName`, empty if `id` is no spawn egg.\n  case id\n")
  for e in eggs:
    o.add("  of " & $e[0] & "'u16: " & aowlStr(e[1]) & "\n")
  o.add("  else: \"\"\n\n")
  o.add("proc entityFromEgg*(id: uint16): Option[EntityType] =\n")
  o.add("  let name = entityNameFromEgg(id)\n")
  o.add("  if name.len == 0: none[EntityType]() else: EntityType.fromName(name)\n\n")
  o.add("proc spawnEggIds*(): seq[uint16] =\n  @[")
  for i, e in eggs:
    if i > 0: o.add(", ")
    o.add($e[0] & "'u16")
  o.add("]\n")
  writeGenerated("src/generated/spawn_egg.aowl", o)

when isMainModule:
  main()
