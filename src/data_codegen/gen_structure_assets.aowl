## Generates src/generated/structure_assets.aowl: every structure template, template pool and processor list under
## pumpkin-world/assets, in the binary as upstream's `include_bytes!` and `include_str!` have them.
## Port of pumpkin-world/build.rs
##
## The `.nbt` files are gzipped already, so the template bytes go in as one base64 string with a name, offset and
## length per template, which keeps the C compiler's work to one literal. The JSON stays text, parsed where it is read.
##
## Run with `aowlmony c -r src/data_codegen/gen_structure_assets.aowl` from the repo root.

import std/[syncio, paths, dirs, algorithm, strutils]

const
  AssetsDir = "../ref/pumpkin-1.21.11/pumpkin-world/assets/"
  OutPath = "src/generated/structure_assets.aowl"
  B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

type
  FileEntry = object
    id: string
    path: string

proc baseName(p: Path): string =
  let s = $p
  var at = s.len - 1
  while at >= 0 and s[at] != '/' and s[at] != '\\':
    dec at
  if at >= 0: s[at + 1 .. ^1] else: s

proc listDirSorted(dir: Path): seq[(string, Path, bool)] =
  ## (name, path, isDir), sorted by name: `process_json_dir`'s `sort_by_key(file_name)`.
  var entries: seq[(string, Path, bool)] = @[]
  try:
    for kind, entryPath in walkDir(dir):
      entries.add((baseName(entryPath), entryPath, kind == pcDir))
  except ErrorCode:
    discard
  entries.sort(proc(a, b: (string, Path, bool)): int = cmp(a[0], b[0]))
  entries

proc scan(root, suffix: string): seq[FileEntry] =
  ## `process_dir` and `process_json_dir`: ids are paths under `root`, without the suffix. Order is by name; upstream's
  ## `process_dir` keeps `read_dir`'s, which is the filesystem's.
  result = @[]
  var stack: seq[(Path, string)] = @[(path(root), "")]
  while stack.len > 0:
    let (curDir, prefix) = stack.pop()
    for (name, entryPath, isDir) in listDirSorted(curDir):
      if isDir:
        stack.add((entryPath, if prefix.len == 0: name else: prefix & "/" & name))
      elif name.endsWith(suffix):
        let stem = name[0 ..< name.len - suffix.len]
        result.add(FileEntry(id: if prefix.len == 0: stem else: prefix & "/" & stem, path: $entryPath))
  result.sort(proc(a, b: FileEntry): int = cmp(a.id, b.id))

proc readAll(path: string): string =
  try:
    result = readFile(path)
  except ErrorCode:
    echo "gen_structure_assets: cannot read ", path
    quit(1)

proc encodeB64(data: string, output: var string) =
  var i = 0
  while i + 2 < data.len:
    let v = (uint32(ord(data[i])) shl 16) or (uint32(ord(data[i + 1])) shl 8) or uint32(ord(data[i + 2]))
    output.add(B64[int((v shr 18) and 63'u32)])
    output.add(B64[int((v shr 12) and 63'u32)])
    output.add(B64[int((v shr 6) and 63'u32)])
    output.add(B64[int(v and 63'u32)])
    i += 3
  if i + 1 == data.len:
    let v = uint32(ord(data[i])) shl 16
    output.add(B64[int((v shr 18) and 63'u32)])
    output.add(B64[int((v shr 12) and 63'u32)])
    output.add("==")
  elif i + 2 == data.len:
    let v = (uint32(ord(data[i])) shl 16) or (uint32(ord(data[i + 1])) shl 8)
    output.add(B64[int((v shr 18) and 63'u32)])
    output.add(B64[int((v shr 12) and 63'u32)])
    output.add(B64[int((v shr 6) and 63'u32)])
    output.add('=')

proc quoted(s: string): string =
  result = "\""
  for c in s:
    case c
    of '"': result.add("\\\"")
    of '\\': result.add("\\\\")
    of '\n': result.add("\\n")
    of '\r': discard
    of '\t': result.add("\\t")
    else: result.add(c)
  result.add('"')

proc main() =
  let templates = scan(AssetsDir & "structures", ".nbt")
  let pools = scan(AssetsDir & "worldgen/template_pool", ".json")
  let processors = scan(AssetsDir & "worldgen/processor_list", ".json")

  var data = ""
  var output = "## GENERATED by src/data_codegen/gen_structure_assets.aowl - do not edit by hand.\n"
  output.add("## Port of pumpkin-world/build.rs: `template_embeddings.rs`.\n\n")
  output.add("type\n  TemplateBytesEntry* = object\n    name*: string\n    offset*, length*: int\n\n")
  output.add("  JsonAssetEntry* = object\n    id*: string\n    json*: string\n\n")
  output.add("const TemplateBytesEntries*: array[" & $templates.len & ", TemplateBytesEntry] = [\n")
  for t in templates:
    let at = data.len
    encodeB64(readAll(t.path), data)
    output.add("  TemplateBytesEntry(name: " & quoted(t.id) & ", offset: " & $at & ", length: " & $(data.len - at) & "),\n")
  output.add("]\n\n")
  output.add("let TemplatePoolJson*: seq[JsonAssetEntry] = @[\n")
  for p in pools:
    output.add("  JsonAssetEntry(id: " & quoted(p.id) & ", json: " & quoted(readAll(p.path)) & "),\n")
  output.add("]\n\n")
  output.add("let ProcessorListJson*: seq[JsonAssetEntry] = @[\n")
  for p in processors:
    output.add("  JsonAssetEntry(id: " & quoted(p.id) & ", json: " & quoted(readAll(p.path)) & "),\n")
  output.add("]\n\n")
  output.add("const TemplateBytesBase64* = \"" & data & "\"\n")
  try:
    writeFile(OutPath, output)
  except ErrorCode:
    echo "gen_structure_assets: cannot write ", OutPath
    quit(1)
  echo "wrote ", OutPath, ": ", templates.len, " templates, ", pools.len, " pools, ", processors.len, " processor lists, ",
    data.len, " base64 bytes"

main()
