## Port of pumpkin-codegen/src/structures.rs (structures.rs)
##
## Reads `assets/structures.json` and `assets/structure_set.json` and writes
## src/generated/structures.aowl. Upstream's `Structure::X` and `StructureSet::X` associated
## constants share one module namespace here, so they are `STRUCTURE_X` and `STRUCTURE_SET_X`:
## both tables have a `TRAIL_RUINS`. `Option` fields become `hasX`/`x` pairs.

import std/[json, strutils, syncio]
import codegenutil, worldgenutil

const OutPath = "src/generated/structures.aowl"

proc die(msg: string) =
  echo "gen_structures: " & msg
  quit(1)

proc structureTypeToken(st: string): string =
  case st
  of "minecraft:jigsaw": "Jigsaw"
  of "minecraft:buried_treasure": "BuriedTreasure"
  of "minecraft:desert_pyramid": "DesertPyramid"
  of "minecraft:end_city": "EndCity"
  of "minecraft:fortress": "Fortress"
  of "minecraft:igloo": "Igloo"
  of "minecraft:jungle_temple": "JungleTemple"
  of "minecraft:woodland_mansion": "WoodlandMansion"
  of "minecraft:mineshaft": "Mineshaft"
  of "minecraft:ocean_monument": "OceanMonument"
  of "minecraft:nether_fossil": "NetherFossil"
  of "minecraft:ocean_ruin": "OceanRuin"
  of "minecraft:ruined_portal": "RuinedPortal"
  of "minecraft:shipwreck": "Shipwreck"
  of "minecraft:stronghold": "Stronghold"
  of "minecraft:swamp_hut": "SwampHut"
  else: "Unknown"

proc terrainAdaptationToken(ta: string): string =
  case ta
  of "beard_thin": "BeardThin"
  of "beard_box": "BeardBox"
  of "bury": "Bury"
  of "encapsulate": "Encapsulate"
  else: "None"

const StructureKeyNames = [
  "pillager_outpost", "mineshaft", "mineshaft_mesa", "mansion", "jungle_pyramid", "desert_pyramid",
  "igloo", "shipwreck", "shipwreck_beached", "swamp_hut", "stronghold", "monument", "ocean_ruin_cold",
  "ocean_ruin_warm", "fortress", "nether_fossil", "end_city", "buried_treasure", "bastion_remnant",
  "village_plains", "village_desert", "village_savanna", "village_snowy", "village_taiga", "ruined_portal",
  "ruined_portal_desert", "ruined_portal_jungle", "ruined_portal_swamp", "ruined_portal_mountain",
  "ruined_portal_ocean", "ruined_portal_nether", "ancient_city", "trail_ruins", "trial_chambers"]
  ## Upstream's hand-written `StructureKeys` variant order, which is not sorted.

proc structureKeyToken(key: string): string =
  let stripped = stripMc(key)
  var i = 0
  while i < StructureKeyNames.len:
    if StructureKeyNames[i] == stripped:
      return "StructureKeys." & toPascalCase(stripped)
    inc i
  die("Unknown structure key: " & stripped)
  ""

proc frequencyReductionToken(m: string): string =
  case m
  of "default": "Default"
  of "legacy_type_1": "LegacyType1"
  of "legacy_type_2": "LegacyType2"
  of "legacy_type_3": "LegacyType3"
  else: "Default"

proc spreadTypeToken(s: string): string =
  case s
  of "linear": "Linear"
  of "triangular": "Triangular"
  else: "Linear"

proc generationStepToken(step: string): string =
  case step
  of "raw_generation": "RawGeneration"
  of "lakes": "Lakes"
  of "local_modifications": "LocalModifications"
  of "underground_structures": "UndergroundStructures"
  of "surface_structures": "SurfaceStructures"
  of "strongholds": "Strongholds"
  of "underground_ores": "UndergroundOres"
  of "underground_decoration": "UndergroundDecoration"
  of "fluid_springs": "FluidSprings"
  of "vegetal_decoration": "VegetalDecoration"
  of "top_layer_modification": "TopLayerModification"
  else:
    die("Unknown generation step: " & step)
    ""

proc optStr(n: JsonNode; key, field: string): string =
  let (ok, v) = fieldOf(n, key)
  if ok and kind(v) == JString:
    "has" & field & ": true, " & toLowerAscii(field[0 .. 0]) & field[1 .. ^1] & ": " & aowlStr(getStr(v)) & ", "
  else:
    "has" & field & ": false, " & toLowerAscii(field[0 .. 0]) & field[1 .. ^1] & ": \"\", "

proc optInt(n: JsonNode; key, field: string): string =
  let (ok, v) = fieldOf(n, key)
  if ok and kind(v) == JInt:
    "has" & field & ": true, " & toLowerAscii(field[0 .. 0]) & field[1 .. ^1] & ": " & $getInt(v) & "'i32, "
  else:
    "has" & field & ": false, " & toLowerAscii(field[0 .. 0]) & field[1 .. ^1] & ": 0'i32, "

proc startHeightLit(n: JsonNode): string =
  ## Upstream reads `absolute`, or `min_inclusive.absolute`, and otherwise leaves None.
  var found = false
  var value = 0
  let (hasH, sh) = fieldOf(n, "start_height")
  if hasH:
    let (hasAbs, abs) = fieldOf(sh, "absolute")
    if hasAbs:
      found = true
      value = int(getInt(abs))
    else:
      let (hasMin, minInc) = fieldOf(sh, "min_inclusive")
      if hasMin:
        let (hasInner, inner) = fieldOf(minInc, "absolute")
        if hasInner:
          found = true
          value = int(getInt(inner))
  "hasStartHeight: " & boolLit(found) & ", startHeight: " & $value & "'i16, "

proc structureLit(n: JsonNode): string =
  let (hasHack, hack) = fieldOf(n, "use_expansion_hack")
  let ta = strAt(n, "terrain_adaptation")
  "Structure(biomes: " & aowlStr(strAt(n, "biomes")) &
    ", step: GenerationStep." & generationStepToken(strAt(n, "step")) & ", " &
    optStr(n, "start_pool", "StartPool") & optStr(n, "start_jigsaw_name", "StartJigsawName") &
    optInt(n, "size", "Size") &
    "terrainAdaptation: TerrainAdaptation." & terrainAdaptationToken(ta) & ", " &
    startHeightLit(n) &
    optStr(n, "project_start_to_heightmap", "ProjectStartToHeightmap") &
    optInt(n, "max_distance_from_center", "MaxDistanceFromCenter") &
    optStr(n, "liquid_settings", "LiquidSettings") &
    optInt(n, "dimension_padding", "DimensionPadding") &
    "hasUseExpansionHack: " & boolLit(hasHack and kind(hack) == JBool) &
    ", useExpansionHack: " & boolLit(hasHack and kind(hack) == JBool and getBool(hack)) &
    ", structureType: StructureType." & structureTypeToken(strAt(n, "type")) & ")"

proc placementLit(p: JsonNode): string =
  let (hasMethod, _) = fieldOf(p, "frequency_reduction_method")
  let methodText = strAt(p, "frequency_reduction_method")
  let (hasFreq, freq) = fieldOf(p, "frequency")
  let (hasEz, ez) = fieldOf(p, "exclusion_zone")
  result = "StructurePlacement(hasFrequencyReductionMethod: " & boolLit(hasMethod) &
    ", frequencyReductionMethod: FrequencyReductionMethod." &
    (if hasMethod: frequencyReductionToken(methodText) else: "Default") &
    ", hasFrequency: " & boolLit(hasFreq) &
    ", frequency: " & (if hasFreq: f32Lit(num(freq)) else: "0.0'f32") &
    ", salt: " & $intAt(p, "salt") & "'u32" &
    ", hasExclusionZone: " & boolLit(hasEz) &
    ", exclusionZone: ExclusionZone(otherSet: " &
    aowlStr(if hasEz: strAt(ez, "other_set") else: "") &
    ", chunkCount: " & (if hasEz: $intAt(ez, "chunk_count") else: "0") & "'i32), placementType: "
  case strAt(p, "type")
  of "minecraft:random_spread":
    let (hasSpread, _) = fieldOf(p, "spread_type")
    result.add("StructurePlacementType(kind: StructurePlacementKind.RandomSpread, randomSpread: " &
      "RandomSpreadStructurePlacement(spacing: " & $intAt(p, "spacing") & "'i32, separation: " &
      $intAt(p, "separation") & "'i32, hasSpreadType: " & boolLit(hasSpread) & ", spreadType: SpreadType." &
      (if hasSpread: spreadTypeToken(strAt(p, "spread_type")) else: "Linear") & "))")
  of "minecraft:concentric_rings":
    result.add("StructurePlacementType(kind: StructurePlacementKind.ConcentricRings, concentricRings: " &
      "ConcentricRingsStructurePlacement(spread: " & $intAt(p, "spread") & "'i32, distance: " &
      $intAt(p, "distance") & "'i32, count: " & $intAt(p, "count") & "'i32, preferredBiomes: " &
      aowlStr(strAt(p, "preferred_biomes")) & "))")
  else:
    die("unknown placement type " & strAt(p, "type"))
  result.add(")")

const Types = """
import ../util/random/random

type
  GenerationStep* {.pure.} = enum
    RawGeneration, Lakes, LocalModifications, UndergroundStructures, SurfaceStructures, Strongholds,
    UndergroundOres, UndergroundDecoration, FluidSprings, VegetalDecoration, TopLayerModification

  TerrainAdaptation* {.pure.} = enum
    None, BeardThin, BeardBox, Bury, Encapsulate

  StructureType* {.pure.} = enum
    Jigsaw, BuriedTreasure, DesertPyramid, EndCity, Fortress, Igloo, JungleTemple, WoodlandMansion,
    Mineshaft, OceanMonument, NetherFossil, OceanRuin, RuinedPortal, Shipwreck, Stronghold, SwampHut,
    Unknown

  FrequencyReductionMethod* {.pure.} = enum
    Default, LegacyType1, LegacyType2, LegacyType3

  SpreadType* {.pure.} = enum
    Linear, Triangular

  WeightedEntry* = object
    structure*: StructureKeys
    weight*: uint32

  ExclusionZone* = object
    otherSet*: string
    chunkCount*: int32

  RandomSpreadStructurePlacement* = object
    spacing*: int32
    separation*: int32
    hasSpreadType*: bool
    spreadType*: SpreadType

  ConcentricRingsStructurePlacement* = object
    spread*: int32
    distance*: int32
    count*: int32
    preferredBiomes*: string

  StructurePlacementKind* {.pure.} = enum
    RandomSpread, ConcentricRings

  StructurePlacementType* = object
    kind*: StructurePlacementKind
    randomSpread*: RandomSpreadStructurePlacement
    concentricRings*: ConcentricRingsStructurePlacement

  StructurePlacement* = object
    hasFrequencyReductionMethod*: bool
    frequencyReductionMethod*: FrequencyReductionMethod
    hasFrequency*: bool
    frequency*: float32
    salt*: uint32
    hasExclusionZone*: bool
    exclusionZone*: ExclusionZone
    placementType*: StructurePlacementType

  StructureSet* = object
    placement*: StructurePlacement
    structures*: seq[WeightedEntry]

  Structure* = object
    biomes*: string
    step*: GenerationStep
    hasStartPool*: bool
    startPool*: string
    hasStartJigsawName*: bool
    startJigsawName*: string
    hasSize*: bool
    size*: int32
    terrainAdaptation*: TerrainAdaptation
    hasStartHeight*: bool
    startHeight*: int16
    hasProjectStartToHeightmap*: bool
    projectStartToHeightmap*: string
    hasMaxDistanceFromCenter*: bool
    maxDistanceFromCenter*: int32
    hasLiquidSettings*: bool
    liquidSettings*: string
    hasDimensionPadding*: bool
    dimensionPadding*: int32
    hasUseExpansionHack*: bool
    useExpansionHack*: bool
    structureType*: StructureType

  StructurePlacementCalculator* = object
    seed*: int64

proc get*(self: SpreadType; rng: var RandomGenerator; bound: int32): int32 =
  ## `SpreadType::get`. `i32::midpoint` rounds towards zero; the two draws are in order.
  case self
  of SpreadType.Linear:
    rng.nextBoundedI32(bound)
  of SpreadType.Triangular:
    let a = int64(rng.nextBoundedI32(bound))
    let b = int64(rng.nextBoundedI32(bound))
    int32((a + b) div 2)

proc ordinal*(self: GenerationStep): int {.inline.} = ord(self)

proc newStructurePlacementCalculator*(seed: int64): StructurePlacementCalculator =
  StructurePlacementCalculator(seed: seed)

"""

proc main() =
  let structuresText = readAsset("structures.json")
  var structuresTree = parseJson(structuresText)
  let structures = sortedPairs(root(structuresTree))
  let setsText = readAsset("structure_set.json")
  var setsTree = parseJson(setsText)
  let sets = sortedPairs(root(setsTree))

  var s = "## GENERATED by src/data_codegen/gen_structures.aowl - do not edit by hand.\n"
  s.add("## Port of pumpkin-data/src/generated/structures.rs.\n\n")
  s.add("type\n  StructureKeys* {.pure.} = enum\n")
  var i = 0
  while i < StructureKeyNames.len:
    s.add("    " & toPascalCase(StructureKeyNames[i]) & "\n")
    inc i
  s.add("\n")
  s.add(Types)

  # from_name, to_name and all_names follow structures.json, not the variant list.
  s.add("proc fromName*(T: typedesc[StructureKeys]; name: string): (bool, StructureKeys) =\n")
  s.add("  var key = name\n  if key.len > 10 and key[0 .. 9] == \"minecraft:\":\n    key = key[10 .. ^1]\n")
  s.add("  case key\n")
  i = 0
  while i < structures.len:
    let stripped = stripMc(structures[i][0])
    s.add("  of " & aowlStr(stripped) & ": (true, " & structureKeyToken(stripped) & ")\n")
    inc i
  s.add("  else: (false, StructureKeys.PillagerOutpost)\n\n")
  s.add("proc toName*(self: StructureKeys): string =\n  case self\n")
  i = 0
  while i < StructureKeyNames.len:
    s.add("  of StructureKeys." & toPascalCase(StructureKeyNames[i]) & ": " &
      aowlStr("minecraft:" & StructureKeyNames[i]) & "\n")
    inc i
  s.add("\nproc structureAllNames*(): seq[string] =\n  @[")
  i = 0
  while i < structures.len:
    if i > 0: s.add(", ")
    s.add(aowlStr("minecraft:" & stripMc(structures[i][0])))
    inc i
  s.add("]\n\n")

  i = 0
  while i < structures.len:
    s.add("let STRUCTURE_" & shouty(stripMc(structures[i][0])) & "* = " & structureLit(structures[i][1]) & "\n")
    inc i
  s.add("\nproc get*(key: StructureKeys): Structure =\n  ## `Structure::get`.\n  case key\n")
  i = 0
  while i < structures.len:
    s.add("  of " & structureKeyToken(structures[i][0]) & ": STRUCTURE_" & shouty(stripMc(structures[i][0])) & "\n")
    inc i
  s.add("\n")

  i = 0
  while i < sets.len:
    let (_, placement) = fieldOf(sets[i][1], "placement")
    let (_, list) = fieldOf(sets[i][1], "structures")
    var entries = ""
    for e in items(list):
      if entries.len > 0: entries.add(", ")
      entries.add("WeightedEntry(structure: " & structureKeyToken(strAt(e, "structure")) &
        ", weight: " & $intAt(e, "weight") & "'u32)")
    s.add("let STRUCTURE_SET_" & shouty(stripMc(sets[i][0])) & "* = StructureSet(placement: " &
      placementLit(placement) & ", structures: @[" & entries & "])\n")
    inc i
  s.add("\nlet ALL_STRUCTURE_SETS*: seq[StructureSet] = @[")
  i = 0
  while i < sets.len:
    if i > 0: s.add(", ")
    s.add("STRUCTURE_SET_" & shouty(stripMc(sets[i][0])))
    inc i
  s.add("]\n\n")
  s.add("proc structureSetGet*(name: string): (bool, StructureSet) =\n")
  s.add("  ## `StructureSet::get`, keyed by the bare name as upstream's is.\n  case name\n")
  i = 0
  while i < sets.len:
    let stripped = stripMc(sets[i][0])
    s.add("  of " & aowlStr(stripped) & ": (true, STRUCTURE_SET_" & shouty(stripped) & ")\n")
    inc i
  s.add("  else: (false, StructureSet())\n")
  writeGenerated(OutPath, s)

main()
