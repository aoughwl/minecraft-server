## Port of pumpkin-codegen/src/tag.rs (tag.rs). Writes src/generated/tag.aowl from assets/tags/*_tags.json.
##
## Upstream emits a Rust module with a constant per tag per version, 6.5 MB. Here one text constant per asset
## file holds it all, decoded the first time a version is asked for. Layout: `=<registry key>` starts a
## registry, then one `<tag name>\t<value>,<value>...\t<hex-packed u16 ids>` line per tag, sorted by name as
## upstream's BTreeMap is. The ids resolve against the global 26.2 assets for every version, as upstream does.
##
## Upstream's `tag::Block::MINECRAFT_X` constants become `Block_MINECRAFT_X`: small `TagRef` numbers into 26.2's
## tables, the only version upstream exposes constants for. Run from the repo root:
## `aowlmony c -r -p:src src/data_codegen/gen_tag.aowl`

import std/[json, strutils, syncio, tables, algorithm]
import codegenutil
import codegenversion

const
  OutPath = "src/generated/tag.aowl"
  LatestVersion = jmvV26_2

type
  Asset = object
    version: JavaMinecraftVersion
    file: string

  TagEntry = object
    name: string
    values: seq[string]

  RegistryEntries = object
    key: string
    tags: seq[TagEntry]

proc assets(): seq[Asset] =
  ## Upstream's `assets` array; its TODO stands: no 1_21_tags.json was uploaded.
  @[
    Asset(version: jmvV1_20_5, file: "1_21_2_tags.json"),
    Asset(version: jmvV1_21, file: "1_21_2_tags.json"),
    Asset(version: jmvV1_21_2, file: "1_21_2_tags.json"),
    Asset(version: jmvV1_21_4, file: "1_21_4_tags.json"),
    Asset(version: jmvV1_21_5, file: "1_21_5_tags.json"),
    Asset(version: jmvV1_21_6, file: "1_21_6_tags.json"),
    Asset(version: jmvV1_21_7, file: "1_21_7_tags.json"),
    Asset(version: jmvV1_21_9, file: "1_21_9_tags.json"),
    Asset(version: jmvV1_21_11, file: "1_21_11_tags.json"),
    Asset(version: jmvV26_1, file: "26_1_tags.json"),
    Asset(version: jmvV26_2, file: "26_2_tags.json")
  ]

proc idsFromObject(rel: string; prefix: string): Table[string, int] =
  ## `BTreeMap<String, {id}>` read from a top-level JSON object.
  result = initTable[string, int]()
  var tree = parseJson(readAsset(rel))
  let obj = root(tree)
  for name, v in obj.pairs():
    for k, field in v.pairs():
      if k == "id":
        result[prefix & name] = int(field.getInt())

proc idsFromArray(node: JsonNode): Table[string, int] =
  ## A JSON array of `{name, id}` objects.
  result = initTable[string, int]()
  for elem in node.items:
    var name = ""
    var id = 0
    for k, field in elem.pairs():
      if k == "name": name = field.getStr()
      elif k == "id": id = int(field.getInt())
    result[name] = id

proc blockIds(): Table[string, int] =
  var tree = parseJson(readAsset("blocks.json"))
  let top = root(tree)
  result = initTable[string, int]()
  for k, v in top.pairs():
    if k == "blocks":
      result = idsFromArray(v)

proc fluidIds(): Table[string, int] =
  var tree = parseJson(readAsset("fluids.json"))
  idsFromArray(root(tree))

proc dimensionIds(): Table[string, int] =
  ## Name to index in sorted order: upstream reads dimension.json into a BTreeMap.
  var tree = parseJson(readAsset("dimension.json"))
  let top = root(tree)
  var names: seq[string] = @[]
  for k, v in top.pairs():
    names.add(k)
  names.sort(proc(a, b: string): int = cmp(a, b))
  result = initTable[string, int]()
  for i in 0 ..< names.len:
    result[names[i]] = i

proc timelineIds(): Table[string, int] =
  ## Name to index in file order, from 1.21.11's registry file as upstream takes it.
  var tree = parseJson(readAsset("registry/1_21_11_synced_registries.json"))
  let top = root(tree)
  result = initTable[string, int]()
  for k, v in top.pairs():
    if k == "timeline":
      var i = 0
      for name, entry in v.pairs():
        result[name] = i
        inc i

proc sortTags(s: var seq[TagEntry]) =
  ## By name. Plain insertion sort: `sort` with a closure stops the hexer on these objects.
  for i in 1 ..< s.len:
    var j = i
    while j > 0 and s[j - 1].name > s[j].name:
      let tmp = s[j - 1]
      s[j - 1] = s[j]
      s[j] = tmp
      dec j

proc sortRegistries(s: var seq[RegistryEntries]) =
  for i in 1 ..< s.len:
    var j = i
    while j > 0 and s[j - 1].key > s[j].key:
      let tmp = s[j - 1]
      s[j - 1] = s[j]
      s[j] = tmp
      dec j

proc readTags(file: string): seq[RegistryEntries] =
  ## `BTreeMap<String, BTreeMap<String, Vec<String>>>`.
  var tree = parseJson(readAsset("tags/" & file))
  let top = root(tree)
  result = @[]
  for key, tagMap in top.pairs():
    var reg = RegistryEntries(key: key, tags: @[])
    for tagName, values in tagMap.pairs():
      var entry = TagEntry(name: tagName, values: @[])
      for v in values.items:
        entry.values.add(v.getStr())
      reg.tags.add(entry)
    sortTags(reg.tags)
    result.add(reg)
  sortRegistries(result)

proc pascal(s: string): string =
  ## heck's `to_pascal_case`, for which `/` also ends a word.
  toPascalCase(s.replace("/", "_"))

proc constName(tagName: string): string =
  ## `tag_name.replace([':', '/'], "_").to_uppercase()`.
  toUpperAscii(tagName.replace(":", "_").replace("/", "_"))

proc staticPart(): string =
  ## The hand-written half of the module: upstream's `quote!` block at the end of build().
  """
const RegistryKeyCount* = RegistryKeyNames.len

proc identifierString*(key: RegistryKey): string =
  RegistryKeyNames[ord(key)]

proc registryKeyFromString*(s: string): (bool, RegistryKey) =
  ## `RegistryKey::from_string`.
  for i in 0 ..< RegistryKeyNames.len:
    if RegistryKeyNames[i] == s:
      return (true, RegistryKey(i))
  (false, RegistryKey(0))

type
  Tag* = ref object
    ## Upstream's `(values, ids)` pair.
    values*: seq[string]
    ids*: seq[uint16]

  TagMap* = ref object
    ## Upstream's `Option<&phf::Map<&str, &Tag>>` for one registry: `present` is false for its `None`,
    ## `names` is sorted and `tags` parallel to it.
    present*: bool
    names*: seq[string]
    tags*: seq[Tag]

  VersionTags = object
    loaded: bool
    maps: seq[TagMap] ## by RegistryKey

  TagRef* = distinct uint32
    ## A `Block_MINECRAFT_X` constant: registry key in the high half, index in 26.2's sorted tags in the low.

  Taggable* = object
    ## Upstream's `Taggable` trait, as the three values its implementors supply.
    tagKey*: RegistryKey
    registryKey*: string
    registryId*: uint16

proc decodeHexIds(s: string; start, stop: int): seq[uint16] =
  let n = (stop - start) div 4
  result = newSeq[uint16](n)
  for i in 0 ..< n:
    result[i] = hexU16At(substr(s, start + i * 4, start + i * 4 + 3), 0)

proc decodeVersion(blob: string): VersionTags =
  ## Undoes the layout gen_tag.aowl writes.
  result = VersionTags(loaded: true, maps: @[])
  for i in 0 ..< RegistryKeyCount:
    result.maps.add(TagMap(present: false, names: @[], tags: @[]))
  var pos = 0
  var current = 0
  while pos < blob.len:
    if blob[pos] == '=':
      inc pos
      let name = fieldStr(blob, pos, '\n')
      skipSep(blob, pos)
      let (found, key) = registryKeyFromString(name)
      current = ord(key)
      if found:
        result.maps[current].present = true
    else:
      let name = fieldStr(blob, pos, '\t')
      skipSep(blob, pos)
      var tag = Tag(values: @[], ids: @[])
      while pos < blob.len and blob[pos] != '\t':
        tag.values.add(fieldStr(blob, pos, ',', '\t'))
        if blob[pos] == ',': inc pos
      skipSep(blob, pos)
      let start = pos
      while pos < blob.len and blob[pos] != '\n':
        inc pos
      tag.ids = decodeHexIds(blob, start, pos)
      skipSep(blob, pos)
      result.maps[current].names.add(name)
      result.maps[current].tags.add(tag)

var decoded: array[FileCount, VersionTags]

proc mapOf(file: int; key: RegistryKey): TagMap =
  ## Decoded on first use and kept. Not synchronised: first call from one thread.
  if not decoded[file].loaded:
    decoded[file] = decodeVersion(fileBlob(file))
  decoded[file].maps[ord(key)]

proc getLatestMap*(key: RegistryKey): TagMap =
  ## `get_latest_map`: 26.2's tags for a registry; check `present`.
  mapOf(fileIndex(jmvV26_2), key)

proc getRegistryKeyTags*(version: JavaMinecraftVersion; key: RegistryKey): TagMap =
  ## `get_registry_key_tags`; `present` is false if that version has no such registry.
  mapOf(fileIndex(version), key)

proc find*(m: TagMap; name: string): nil Tag =
  ## `map.get(name)`, by binary search.
  var lo = 0
  var hi = m.names.len - 1
  while lo <= hi:
    let mid = (lo + hi) div 2
    let c = cmp(m.names[mid], name)
    if c == 0:
      let t = m.tags[mid]
      return t
    if c < 0: lo = mid + 1 else: hi = mid - 1
  return nil

proc lookup(key: RegistryKey; name: string): nil Tag =
  return find(getLatestMap(key), name)

proc getTagValues*(key: RegistryKey; tag: string): (bool, seq[string]) =
  ## `get_tag_values`. 26.2's, as upstream's is.
  let t = lookup(key, tag)
  if t == nil: return (false, newSeq[string]())
  (true, t.values)

proc getTagIds*(key: RegistryKey; tag: string): (bool, seq[uint16]) =
  ## `get_tag_ids`. 26.2's, as upstream's is.
  let t = lookup(key, tag)
  if t == nil: return (false, newSeq[uint16]())
  (true, t.ids)

proc refKey*(tag: TagRef): RegistryKey = RegistryKey(uint32(tag) shr 16)
proc refIndex(tag: TagRef): int = int(uint32(tag) and 0xFFFF'u32)

proc resolve*(tag: TagRef): Tag =
  ## The 26.2 tag behind a constant.
  let m = getLatestMap(refKey(tag))
  m.tags[refIndex(tag)]

proc tagName*(tag: TagRef): string =
  ## The constant's tag name, `minecraft:mineable/pickaxe`.
  getLatestMap(refKey(tag)).names[refIndex(tag)]

proc resolveFor*(tag: TagRef; version: JavaMinecraftVersion): nil Tag =
  ## The same-named tag in another version's data, nil if that version lacks it.
  return find(getRegistryKeyTags(version, refKey(tag)), tagName(tag))

proc containsId(ids: seq[uint16]; id: uint16): bool =
  for x in ids:
    if x == id: return true
  false

proc hasTag*(id: uint16; tag: Tag): bool =
  ## `has_tag` on a bare registry id.
  containsId(tag.ids, id)

proc hasTag*(id: uint16; tag: TagRef): bool =
  containsId(resolve(tag).ids, id)

proc hasTag*(self: Taggable; tag: TagRef): bool =
  ## `Taggable::has_tag`.
  hasTag(self.registryId, tag)

proc hasTag*(self: Taggable; tag: Tag): bool =
  hasTag(self.registryId, tag)

proc stripHash(tag: string): string =
  if tag.len > 0 and tag[0] == '#': substr(tag, 1, tag.len - 1) else: tag

proc isTaggedWith*(self: Taggable; tag: string): (bool, bool) =
  ## `Taggable::is_tagged_with`: first is false when no such tag exists (upstream's `None`).
  let t = lookup(self.tagKey, stripHash(tag))
  if t == nil: return (false, false)
  (true, containsId(t.ids, self.registryId))

proc getTagValues*(self: Taggable; tag: string): (bool, seq[string]) =
  ## `Taggable::get_tag_values`.
  getTagValues(self.tagKey, stripHash(tag))
"""

proc build(): string =
  let items = idsFromObject("items.json", "")
  let biomes = idsFromObject("biome.json", "")
  let enchantments = idsFromObject("enchantments.json", "")
  let entities = idsFromObject("entities.json", "")
  let blocks = blockIds()
  let fluids = fluidIds()
  let dimensions = dimensionIds()
  let timelines = timelineIds()

  let allAssets = assets()
  var files: seq[string] = @[]
  for a in allAssets:
    var seen = false
    for f in files:
      if f == a.file: seen = true
    if not seen: files.add(a.file)

  var keys: seq[string] = @["dimension_type"]
  var blobs: seq[string] = @[]
  var latest: seq[RegistryEntries] = @[]
  for file in files:
    let regs = readTags(file)
    var blob = ""
    for reg in regs:
      if reg.key notin keys: keys.add(reg.key)
      blob.add("=" & reg.key & "\n")
      for t in reg.tags:
        var ids: seq[int] = @[]
        for v in t.values:
          var id = -1
          if reg.key == "worldgen/biome": id = biomes.getOrDefault(v, -1)
          elif reg.key == "fluid": id = fluids.getOrDefault(v, -1)
          elif reg.key == "item": id = items.getOrDefault(v, -1)
          elif reg.key == "block": id = blocks.getOrDefault(v, -1)
          elif reg.key == "enchantment": id = enchantments.getOrDefault("minecraft:" & v, -1)
          elif reg.key == "entity_type": id = entities.getOrDefault(v, -1)
          elif reg.key == "dimension_type": id = dimensions.getOrDefault(v, -1)
          elif reg.key == "timeline": id = timelines.getOrDefault(v, -1)
          if id >= 0: ids.add(id)
        blob.add(t.name & "\t")
        for i in 0 ..< t.values.len:
          if i > 0: blob.add(",")
          blob.add(t.values[i])
        blob.add("\t" & hexU16Table(ids) & "\n")
    blobs.add(blob)
    if file == "26_2_tags.json": latest = regs
  keys.sort(proc(a, b: string): int = cmp(a, b))

  result = "## GENERATED by src/data_codegen/gen_tag.aowl from assets/tags/*_tags.json - do not edit by hand.\n"
  result.add("## Port of the output of pumpkin-codegen/src/tag.rs. Tag ids are in the 26.2 id space for every version.\n\n")
  result.add("import ../util/javaversion\n")
  result.add("import gendecode\n\n")
  result.add("type\n  RegistryKey* = enum\n")
  for k in keys:
    result.add("    rk" & pascal(k) & "\n")
  result.add("\nconst RegistryKeyNames = [")
  for i in 0 ..< keys.len:
    if i > 0: result.add(", ")
    result.add(aowlStr(keys[i]))
  result.add("]\n\nconst FileCount = " & $files.len & "\n\n")
  for i in 0 ..< files.len:
    result.add("const Blob" & $i & " = " & aowlStr(blobs[i]) & " ## " & files[i] & "\n\n")
  result.add("proc fileBlob(file: int): string =\n  case file\n")
  for i in 0 ..< files.len:
    if i == files.len - 1:
      result.add("  else: Blob" & $i & "\n\n")
    else:
      result.add("  of " & $i & ": Blob" & $i & "\n")
  result.add("proc fileIndex(version: JavaMinecraftVersion): int =\n  case version\n")
  var latestIdx = 0
  for a in allAssets:
    for i in 0 ..< files.len:
      if files[i] == a.file:
        result.add("  of " & versionEnumName(a.version) & ": " & $i & "\n")
        if a.version == LatestVersion: latestIdx = i
  result.add("  else: " & $latestIdx & " ## upstream's `_ => get_latest_map`\n\n")
  result.add(staticPart())
  result.add("\n# Upstream's per-registry constants for 26.2, the version it exports them for.\n")
  for reg in latest:
    let keyIndex = keys.find(reg.key)
    for i in 0 ..< reg.tags.len:
      result.add("const " & pascal(reg.key) & "_" & constName(reg.tags[i].name) & "* = TagRef(" &
                 $((keyIndex shl 16) or i) & "'u32)\n")

when isMainModule:
  writeGenerated(OutPath, build())
