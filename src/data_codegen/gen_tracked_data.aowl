## Port of pumpkin-codegen/src/tracked_data.rs (tracked_data.rs). Writes src/generated/tracked_data.aowl
## from assets/tracked_data/*_tracked_data.json: entity metadata indices per version.
##
## Upstream's `TrackedData::WOLF_VARIANT_ID` becomes `TrackedData_WOLF_VARIANT_ID`. A version without the
## tracker reads 255. Run from the repo root: `aowlmony c -r -p:src src/data_codegen/gen_tracked_data.aowl`

import std/[json, strutils, tables, algorithm]
import codegenutil
import codegenversion

const
  OutPath = "src/generated/tracked_data.aowl"
  LatestVersion = jmvV26_2

type
  Asset = object
    version: JavaMinecraftVersion
    file: string
    data: Table[string, int]

proc assets(): seq[Asset] =
  ## Upstream's `assets` array, oldest first as its BTreeMap iterates.
  result = @[]
  for (v, file) in [
      (jmvV1_21, "1_21_tracked_data.json"),
      (jmvV1_21_2, "1_21_2_tracked_data.json"),
      (jmvV1_21_4, "1_21_4_tracked_data.json"),
      (jmvV1_21_5, "1_21_5_tracked_data.json"),
      (jmvV1_21_6, "1_21_6_tracked_data.json"),
      (jmvV1_21_7, "1_21_7_tracked_data.json"),
      (jmvV1_21_9, "1_21_9_tracked_data.json"),
      (jmvV1_21_11, "1_21_11_tracked_data.json"),
      (jmvV26_1, "26_1_tracked_data.json"),
      (jmvV26_2, "26_2_tracked_data.json")]:
    result.add(Asset(version: v, file: file, data: initTable[string, int]()))

proc normalizeName(name: string): string =
  let upper = toUpperAscii(name)
  let normalized = if upper.startsWith("DATA_"): upper.substr(5) else: upper
  # Mojang renamed the shared custom-name visibility tracker from NAME_VISIBLE to
  # DATA_CUSTOM_NAME_VISIBLE; one constant serves both schemes.
  if normalized == "NAME_VISIBLE": "CUSTOM_NAME_VISIBLE" else: normalized

proc loadVersion(file: string; version: JavaMinecraftVersion): Table[string, int] =
  result = initTable[string, int]()
  var tree = parseJson(readAsset("tracked_data/" & file))
  let obj = root(tree)
  for name, v in obj.pairs():
    result[name] = int(v.getInt())
  # The flattened asset loses duplicate Mojang field names. Before 26.1 the wolf tracker was
  # VARIANT; newer mappings use DATA_VARIANT_ID, which collides with unrelated entity fields,
  # so the entity-scoped id is set explicitly.
  if version == jmvV26_1 or version == jmvV26_2:
    result["WOLF_VARIANT_ID"] = 23
  elif result.hasKey("VARIANT"):
    result["WOLF_VARIANT_ID"] = result.getOrDefault("VARIANT", 0)

proc build(): string =
  var versions = assets()
  for i in 0 ..< versions.len:
    versions[i].data = loadVersion(versions[i].file, versions[i].version)

  result = "## GENERATED by src/data_codegen/gen_tracked_data.aowl from assets/tracked_data/*.json - do not edit by hand.\n\n"
  result.add("import ../util/javaversion\n\n")
  result.add("type\n  TrackedId* = object\n")
  for a in versions:
    result.add("    " & a.version.toFieldIdent() & "*: uint8\n")
  result.add("\nproc get*(self: TrackedId; version: JavaMinecraftVersion): uint8 =\n  case version\n")
  for a in versions:
    result.add("  of " & versionEnumName(a.version) & ": self." & a.version.toFieldIdent() & "\n")
  result.add("  else: self." & LatestVersion.toFieldIdent() & "\n\n")
  result.add("proc toU8*(id: TrackedId): uint8 =\n  ## `impl From<TrackedId> for u8`.\n  id." &
             LatestVersion.toFieldIdent() & "\n\n")

  # Union of all normalized names across every version, sorted as a BTreeSet.
  var seen = initTable[string, int]()
  var allNames: seq[string] = @[]
  for a in versions:
    for name, id in a.data.pairs():
      let n = normalizeName(name)
      if not seen.hasKey(n):
        seen[n] = 1
        allNames.add(n)
  allNames.sort(proc(a, b: string): int = cmp(a, b))

  for finalName in allNames:
    # Some versions prefix keys with DATA_, others do not: try both, and the alias.
    let prefixed = "DATA_" & finalName
    var line = "const TrackedData_" & finalName & "* = TrackedId("
    var first = true
    for a in versions:
      var id = a.data.getOrDefault(finalName, -1)
      if id < 0: id = a.data.getOrDefault(prefixed, -1)
      if id < 0 and finalName == "CUSTOM_NAME_VISIBLE": id = a.data.getOrDefault("NAME_VISIBLE", -1)
      if id < 0: id = 255
      if not first: line.add(", ")
      first = false
      line.add(a.version.toFieldIdent() & ": " & $id & "'u8")
    result.add(line & ")\n")

when isMainModule:
  writeGenerated(OutPath, build())
