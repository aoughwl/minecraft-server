## Port of pumpkin-codegen/src/translations.rs (translations.rs). Writes src/generated/translation.aowl
## from assets/en_us_java.json and assets/en_us_bedrock.lang: one string constant per translation key.
##
## Upstream's `translation::java::FOO` and `translation::bedrock::FOO` become `JAVA_FOO` and `BEDROCK_FOO`.
## Upstream attaches each English value as a doc comment and nothing reads it, so the values are left out here;
## they are available at runtime from src/generated/translations.aowl, the pumpkin-util embed.
## Run from the repo root: `aowlmony c -r -p:src src/data_codegen/gen_translation.aowl`

import std/[json, strutils, algorithm]
import codegenutil

const OutPath = "src/generated/translation.aowl"

proc toValidIdent(name: string): string =
  ## `to_valid_ident`, minus the leading `_` it gives a digit: the prefix makes the name valid here.
  toUpperAscii(name).replace(".", "_").replace(":", "_").replace("-", "_")

proc bedrockKeys(): seq[string] =
  ## `name` of each `name=value` line, in file order, with upstream's skips.
  result = @[]
  let content = readAsset("en_us_bedrock.lang")
  for rawLine in content.splitLines():
    let line = rawLine.strip()
    if line.len == 0 or line[0] == '#' or line[0] == '/':
      continue
    let eq = line.find('=')
    if eq >= 0:
      result.add(line.substr(0, eq - 1).strip())

proc build(): string =
  result = "## GENERATED by src/data_codegen/gen_translation.aowl from assets/en_us_java.json and en_us_bedrock.lang - do not edit by hand.\n\n"
  var tree = parseJson(readAsset("en_us_java.json"))
  let obj = root(tree)
  var javaKeys: seq[string] = @[]
  for name, v in obj.pairs():
    javaKeys.add(name)
  javaKeys.sort(proc(a, b: string): int = cmp(a, b))
  for name in javaKeys:
    result.add("const JAVA_" & toValidIdent(name) & "* = " & aowlStr(name) & "\n")
  let bedrock = bedrockKeys()
  for name in bedrock:
    result.add("const BEDROCK_" & toValidIdent(name) & "* = " & aowlStr(name) & "\n")

when isMainModule:
  writeGenerated(OutPath, build())
