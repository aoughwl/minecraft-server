## Embeds the assets pumpkin-util/src/translation.rs pulls in with `include_str!`. There is no upstream
## generator for these, because Rust embeds them at compile time; this writes each file byte for byte
## into src/generated/translations.aowl as string chunks.
##
## Run with `aowlmony c -r src/data_codegen/gen_translations.aowl` from the repo root.

import std/syncio
import codegenutil

const
  OutPath = "src/generated/translations.aowl"
  ChunkSize = 8192
  # Same order as upstream's table.
  PumpkinFiles = ["en_us", "brb", "de_de", "es_es", "fr_fr", "it_it", "ja_jp", "ka_ge", "ko_kr", "nds_de",
    "nl_be", "nl_nl", "ro_ro", "ru_ru", "sq_al", "zh_cn", "zh_hk", "zh_tw", "lzh", "tr_tr", "uk_ua", "vi_vn",
    "pt_br", "pl_pl"]
  HexDigits = "0123456789abcdef"

proc addAsset(s: var string, procName, path: string) =
  var data = ""
  try:
    data = readFile(path)
  except ErrorCode as e:
    echo "cannot read " & path & ": " & $e
    quit(1)
  s.add "proc " & procName & "*(): string =\n  result = \"\"\n"
  var i = 0
  while i < data.len:
    s.add "  result.add \""
    let stop = min(i + ChunkSize, data.len)
    while i < stop:
      let c = data[i]
      if c == '"' or c == '\\' or ord(c) < 0x20 or ord(c) >= 0x7F:
        s.add "\\x"
        s.add HexDigits[ord(c) shr 4]
        s.add HexDigits[ord(c) and 15]
      else:
        s.add c
      inc i
    s.add "\"\n"
  s.add "\n"

proc procNameOf(file: string): string =
  "pumpkin" & toPascalCase(file) & "Json"

proc build(): string =
  var s = "## GENERATED by src/data_codegen/gen_translations.aowl - do not edit by hand.\n\n"
  s.add "const PumpkinTranslationFiles* = ["
  for i in 0 ..< PumpkinFiles.len:
    if i > 0: s.add ", "
    s.add "\"" & PumpkinFiles[i] & "\""
  s.add "]\n\n"
  addAsset(s, "vanillaEnUsJson", AssetsDir & "/en_us_java.json")
  addAsset(s, "bedrockEnUsLang", AssetsDir & "/en_us_bedrock.lang")
  for f in PumpkinFiles:
    addAsset(s, procNameOf(f), AssetsDir & "/translations/" & f & ".json")
  s.add "proc pumpkinTranslationJson*(file: string): string =\n  case file\n"
  for f in PumpkinFiles:
    s.add "  of \"" & f & "\": " & procNameOf(f) & "()\n"
  s.add "  else: \"\"\n"
  s

when isMainModule:
  try:
    writeFile(OutPath, build())
  except ErrorCode as e:
    echo "cannot write " & OutPath & ": " & $e
    quit(1)
