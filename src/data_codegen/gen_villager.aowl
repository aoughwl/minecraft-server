## Port of pumpkin-codegen/src/villager.rs (villager.rs)
##
## assets/villager_data.json into src/generated/villager.aowl. Item references stay bare item names,
## which are upstream's `Item::registry_key` (26.2's), and `workSound` the asset's sound name.
## JSON key order is upstream's `IndexMap` order. Run from the repo root.

import std/[json, strutils, syncio]
import codegenutil

const OutPath = "src/generated/villager.aowl"

proc pick(obj: JsonNode; key: string): (bool, JsonNode) =
  for k, v in obj.pairs():
    if k == key: return (true, v)
  (false, obj)

proc stripMc(s: string): string =
  if s.startsWith("minecraft:"): s[10 .. ^1] else: s

proc itemText(v: JsonNode): string =
  ## `name,count`; count defaults to 1, truncated from f32 as upstream does.
  let (_, id) = pick(v, "id")
  let (hasCount, count) = pick(v, "count")
  stripMc(id.getStr()) & "," & (if hasCount: $int(if count.kind == JInt: float(count.getInt()) else: count.getFloat()) else: "1")

proc f(v: JsonNode): float =
  if v.kind == JInt: float(v.getInt()) else: v.getFloat()

proc tradeRow(t: JsonNode): string =
  let (_, wants) = pick(t, "wants")
  let (hasB, wantsB) = pick(t, "wants_b")
  let (_, gives) = pick(t, "gives")
  let (hasUses, maxUses) = pick(t, "max_uses")
  let (hasXp, xp) = pick(t, "xp")
  let (hasMul, mul) = pick(t, "price_multiplier")
  "R\t" & itemText(wants) & "\t" & (if hasB: itemText(wantsB) else: "") & "\t" & itemText(gives) & "\t" &
    (if hasUses: $int(f(maxUses)) else: "16") & "\t" & (if hasXp: $int(f(xp)) else: "2") & "\t" &
    (if hasMul: numText(mul) else: "0.05") & "\n"

proc main() =
  var tree = parseJson(readAsset("villager_data.json"))
  let r = root(tree)
  let (_, professions) = pick(r, "professions")
  let (_, types) = pick(r, "types")
  let (_, tradeSets) = pick(r, "trade_sets")
  let (_, trades) = pick(r, "villager_trades")

  # Pre-process every trade set: tag name to its table index.
  var text = ""
  var tagNames: seq[string] = @[]
  var accessors = ""
  var tableCount = 0
  for setKey, setData in tradeSets.pairs():
    let (_, tagNode) = pick(setData, "trades")
    let tag = tagNode.getStr()
    if not tag.startsWith("#minecraft:"): continue
    let tagContent = tag[11 .. ^1]
    let slash = tagContent.find('/')
    if slash < 0: continue
    let prof = tagContent[0 ..< slash]
    var rest = tagContent[(slash + 1) .. ^1]
    let slash2 = rest.find('/')
    if slash2 >= 0: rest = rest[0 ..< slash2]
    let levelStr = if rest.startsWith("level_"): rest[6 .. ^1] else: rest
    let prefix = prof & "/" & levelStr & "/"
    var rows = ""
    for key, trade in trades.pairs():
      if key.startsWith(prefix): rows.add(tradeRow(trade))
    if rows.len == 0 and (prof == "armorer" or prof == "toolsmith" or prof == "weaponsmith"):
      let smithPrefix = "smith/" & levelStr & "/"
      for key, trade in trades.pairs():
        if key.startsWith(smithPrefix): rows.add(tradeRow(trade))
    if rows.len > 0:
      text.add("T\n" & rows)
      tagNames.add(tag)
      accessors.add("let TRADES_" & toShoutySnakeCase(tagContent.replace("/", "_")) & "*: seq[VillagerTrade] = gVillagerTradeTables[" & $tableCount & "]\n")
      inc tableCount

  var enumNames: seq[string] = @[]
  for name, prof in professions.pairs(): enumNames.add(toPascalCase(name))

  var o = "## Generated by src/data_codegen/gen_villager.aowl from assets/villager_data.json. Do not edit.\n\n"
  o.add("import std/options\nimport gendecode\n\n")
  o.add("const VillagerTradesText = " & aowlStr(text) & "\n\n")
  o.add("""type
  VillagerTradeItem* = object
    item*: string
    count*: int32

  VillagerTrade* = object
    wants*: VillagerTradeItem
    wantsB*: Option[VillagerTradeItem]
    gives*: VillagerTradeItem
    maxUses*: int32
    xp*: int32
    priceMultiplier*: float32

  VillagerTradeSet* = object
    trades*: seq[VillagerTrade]
    amount*: int32

proc parseItem(s: string): VillagerTradeItem =
  var pos = 0
  let name = fieldStr(s, pos, ',')
  skipSep(s, pos)
  VillagerTradeItem(item: name, count: int32(fieldInt(s, pos, ',')))

proc loadTables(): seq[seq[VillagerTrade]] =
  result = @[]
  let s = VillagerTradesText
  var pos = 0
  while not atEnd(s, pos):
    let tag = s[pos]
    pos += 2
    if tag == 'T':
      result.add(@[])
    else:
      let wants = fieldStr(s, pos, '\t')
      skipSep(s, pos)
      let wantsB = fieldStr(s, pos, '\t')
      skipSep(s, pos)
      let gives = fieldStr(s, pos, '\t')
      skipSep(s, pos)
      let maxUses = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let xp = fieldInt(s, pos, '\t')
      skipSep(s, pos)
      let mul = fieldFloat(s, pos, '\t')
      skipSep(s, pos)
      result[result.len - 1].add(VillagerTrade(wants: parseItem(wants),
        wantsB: if wantsB.len > 0: some(parseItem(wantsB)) else: none[VillagerTradeItem](),
        gives: parseItem(gives), maxUses: int32(maxUses), xp: int32(xp), priceMultiplier: float32(mul)))

let gVillagerTradeTables*: seq[seq[VillagerTrade]] = loadTables()

""")
  o.add(accessors)
  o.add("\ntype VillagerProfession* {.pure.} = enum\n  ")
  for i, n in enumNames:
    if i > 0: o.add(", ")
    o.add(n)
  o.add("\n\nproc fromI32*(T: typedesc[VillagerProfession]; id: int32): Option[VillagerProfession] =\n  case id\n")
  for i, n in enumNames:
    o.add("  of " & $i & "'i32: some(VillagerProfession." & n & ")\n")
  o.add("  else: none[VillagerProfession]()\n\n")

  var soundArms = ""
  var itemArms = ""
  var keyArms = ""
  var setArms = ""
  for name, prof in professions.pairs():
    let v = "VillagerProfession." & toPascalCase(name)
    let (hasSound, sound) = pick(prof, "work_sound")
    soundArms.add("  of " & v & ": " & (if hasSound: "some(" & aowlStr(sound.getStr()) & ")" else: "none[string]()") & "\n")
    let (_, requested) = pick(prof, "requested_items")
    var items = ""
    for x in requested.items():
      if items.len > 0: items.add(", ")
      items.add(aowlStr(stripMc(x.getStr())))
    itemArms.add("  of " & v & ": " & (if items.len > 0: "@[" & items & "]" else: "newSeq[string]()") & "\n")
    let (_, nameNode) = pick(prof, "name")
    let (_, translate) = pick(nameNode, "translate")
    keyArms.add("  of " & v & ": " & aowlStr(translate.getStr()) & "\n")
    var levels = ""
    let (_, sets) = pick(prof, "trade_sets")
    for level, setKey in sets.pairs():
      let clean = stripMc(setKey.getStr())
      for k, data in tradeSets.pairs():
        if k != clean: continue
        let (_, tagNode) = pick(data, "trades")
        let (_, amount) = pick(data, "amount")
        for ti, tag in tagNames:
          if tag == tagNode.getStr():
            levels.add("    of " & level & "'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[" & $ti & "], amount: " & $int(f(amount)) & "'i32))\n")
            break
    if levels.len == 0:
      setArms.add("  of " & v & ": none[VillagerTradeSet]()\n")
    else:
      setArms.add("  of " & v & ":\n    case level\n" & levels & "    else: none[VillagerTradeSet]()\n")
  o.add("proc workSound*(self: VillagerProfession): Option[string] =\n  case self\n" & soundArms & "\n")
  o.add("proc requestedItems*(self: VillagerProfession): seq[string] =\n  case self\n" & itemArms & "\n")
  o.add("proc translationKey*(self: VillagerProfession): string =\n  case self\n" & keyArms & "\n")
  o.add("proc tradeSet*(self: VillagerProfession; level: int32): Option[VillagerTradeSet] =\n  case self\n" & setArms & "\n")
  o.add("proc allVillagerProfessions*(): seq[VillagerProfession] =\n  @[")
  for i, n in enumNames:
    if i > 0: o.add(", ")
    o.add("VillagerProfession." & n)
  o.add("]\n\n")

  var typeNames: seq[string] = @[]
  var typeArms = ""
  var nsArms = ""
  for name, ns in types.pairs():
    typeArms.add("  of " & $typeNames.len & "'i32: some(VillagerType." & toPascalCase(name) & ")\n")
    nsArms.add("  of " & aowlStr(name) & ": " & aowlStr(ns.getStr()) & "\n")
    typeNames.add(name)
  o.add("type VillagerType* {.pure.} = enum\n  ")
  for i, n in typeNames:
    if i > 0: o.add(", ")
    o.add(toPascalCase(n))
  o.add("\n\nproc fromI32*(T: typedesc[VillagerType]; id: int32): Option[VillagerType] =\n  case id\n" & typeArms & "  else: none[VillagerType]()\n\n")
  o.add("proc villagerTypeNames*(): seq[string] =\n  @[")
  for i, n in typeNames:
    if i > 0: o.add(", ")
    o.add(aowlStr(n))
  o.add("]\n\nproc villagerTypeNamespace*(name: string): string =\n  case name\n" & nsArms & "  else: \"\"\n")
  writeGenerated(OutPath, o)

when isMainModule:
  main()
