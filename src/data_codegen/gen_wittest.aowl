## Checks that gen_wit.aowl's list of unported files is still the whole of the pinned tree's wit/ directory,
## so a re-pin that adds one shows up here. Writes nothing.
import std/[assertions, syncio, paths, dirs, strutils, algorithm]
import gen_wit
import codegenutil

proc listed(): seq[string] =
  result = @[]
  try:
    for kind, entry in walkDir(path("../ref/pumpkin-1.21.11/pumpkin-codegen/src/wit")):
      if kind == pcFile and ($entry).endsWith(".rs"):
        var base = $entry
        let slash = max(lastIndexOf(base, '/'), lastIndexOf(base, '\\'))
        result.add(base.substr(slash + 1))
  except ErrorCode as e:
    echo "walkDir failed: " & $e
  result.sort(proc(a, b: string): int = cmp(a, b))

let found = listed()
assert found.len == UnportedFiles.len
for i in 0 ..< found.len:
  assert found[i] == UnportedFiles[i]

echo "gen_wit list matches the pinned tree"
