## Known-answer test for the small id tables the same-named generators write. Values read from upstream's
## pumpkin-data/src/generated: attributes, sound, sound_category, particle, world_event, entity_pose,
## entity_status, statistic, screen, scoreboard_slot, slot_ranges, game_event.
import std/[assertions, syncio]
import ../generated/attributes
import ../generated/sound
import ../generated/sound_category
import ../generated/particle
import ../generated/game_event
import ../generated/world_event
import ../generated/entity_pose
import ../generated/entity_status
import ../generated/statistic
import ../generated/screen
import ../generated/scoreboard_slot
import ../generated/slot_ranges

assert ARMOR.id == 1'u8 and ARMOR.name == "minecraft:armor"
assert allAttributes()[0].id == 0'u8

assert sound.toName(sdEntityAllayAmbientWithItem) == "entity.allay.ambient_with_item"
let (hasSound, foundSound) = sound.fromName("entity.allay.death")
assert hasSound and foundSound == sdEntityAllayDeath
assert ord(sdEntityAllayDeath) == 2
assert soundNames()[0] == "entity.allay.ambient_with_item"
assert soundSlice()[2] == sdEntityAllayDeath

let (hasCat, cat) = soundCategoryFromName("music")
assert hasCat and cat == scMusic and soundCategoryToName(scUi) == "ui"

assert particleToName(ptAngryVillager) == "angry_villager"
let (hasParticle, particleValue) = particleFromId(1'u16)
assert hasParticle and particleValue == ptBlock

assert game_event.name(gvBlockActivate) == "block_activate"
assert ord(weComposterFill) == 1500
assert ord(epFallFlying) == 1
assert ord(esDeath) == 3
assert ord(scCustom) == 8
assert ord(csDeaths) == 32
assert ord(wtGeneric9x2) == 1
assert ord(sdsSidebar) == 1

let (hasRange, range) = getSlotRange("armor.head")
assert hasRange and range == @[103]
assert slotRangeAllNames()[0] == "armor.*"

echo "all id enum checks passed"
