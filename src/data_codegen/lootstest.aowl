## Known answers read from upstream's pumpkin-data/src/generated/{block,chest_loot}.rs, against the
## loot decoder (loot_types.aowl), block_loot.aowl and chest_loot.aowl.

import std/[assertions, json, options, syncio]
import ../generated/block_loot
import ../generated/chest_loot
import ../util/random/random
import ../util/xoroshiro128

# Stone: alternatives(item stone if silk touch; item cobblestone if survives explosion).
let stone = blockLootTableByName("stone")
assert stone != nil
assert stone.`type` == lttBlock
assert stone.randomSequence.get == "minecraft:blocks/stone"
let pools = stone.pools.get
assert pools.len == 1
assert pools[0].rolls.kind == lntConstant
assert pools[0].rolls.constant == 1.0'f32
assert pools[0].bonusRolls.constant == 0.0'f32
assert pools[0].entries[0].content.kind == lpeAlternatives
let kids = pools[0].entries[0].content.children
assert kids.len == 2
assert kids[0].content.kind == lpeItem
assert kids[0].content.item.name == "minecraft:stone"
assert kids[0].weight == 1'i32
assert kids[1].content.item.name == "minecraft:cobblestone"
assert kids[1].conditions.get[0].kind == lcSurvivesExplosion

# Block id lookups.
assert blockLootTable(1'u16) == stone
assert blockLootTable(0'u16) == nil        # air has none
assert blockLootTable(60000'u16) == nil
assert blockLootTableByName("nope") == nil

# Cached: a second lookup hands back the same table.
assert blockLootTable(1'u16) == blockLootTable(1'u16)

# The decoder on hand-written tables: one case per shape that is rare in the data.
var tree = parseJson("""{"type":"minecraft:entity","pools":[{"rolls":{"type":"minecraft:uniform","min":1,"max":3},"bonus_rolls":2.0,
  "conditions":[{"condition":"minecraft:killed_by_player"},{"condition":"minecraft:inverted","term":{"condition":"minecraft:random_chance","chance":0.5}}],
  "functions":[{"function":"minecraft:set_count","count":{"type":"minecraft:binomial","n":3,"p":0.25},"add":true}],
  "entries":[{"type":"minecraft:tag","name":"minecraft:logs","expand":true,"weight":7,"quality":2},
             {"type":"minecraft:empty"},
             {"type":"minecraft:loot_table","value":"minecraft:x"},
             {"type":"minecraft:dynamic","name":"minecraft:contents"}]}]}""")
let r = root(tree)
let t = decodeLootTable(r)
assert t.`type` == lttEntity
assert t.randomSequence.isNone
let p0 = t.pools.get[0]
assert p0.rolls.kind == lntObject
assert p0.rolls.provider.uniform.min == 1.0'f32
assert p0.rolls.provider.uniform.max == 3.0'f32
assert p0.bonusRolls.constant == 2.0'f32
assert p0.conditions.get[0].kind == lcKilledByPlayer
assert p0.conditions.get[1].inverted[0].chance == 0.5'f32
assert p0.functions.get[0].content.setCount.kind == lfnBinomial
assert p0.functions.get[0].content.setCount.p == 0.25'f32
assert p0.functions.get[0].content.add
assert p0.entries[0].content.tag.expand
assert p0.entries[0].weight == 7'i32
assert p0.entries[0].quality == 2'i32
assert p0.entries[1].content.kind == lpeEmpty
assert p0.entries[2].content.lootTable.value == "minecraft:x"
assert p0.entries[3].content.dynamic.name == "minecraft:contents"

# LootNumberProviderTypes::get: a constant is itself, a uniform stays inside its range.
var rng = toRandomGenerator(fromSeed(12345'u64))
assert get(constantProvider(4.0'f32), rng) == 4.0'f32
for i in 0 ..< 32:
  let v = get(uniformProvider(1.0'f32, 3.0'f32), rng)
  assert v >= 1.0'f32 and v <= 3.0'f32

# Chest loot.
assert gChestLootTables.len == 56
let mineshaft = getChestLootTable("minecraft:chests/abandoned_mineshaft").get
assert mineshaft.pools[0].entries[0].item == "minecraft:golden_apple"
assert mineshaft.pools[0].entries[0].weight == 20'i32
assert mineshaft.pools[0].entries[0].minCount == 1'i32
assert getChestLootTable("minecraft:chests/nope").isNone
assert ChestLootTable.ABANDONED_MINESHAFT.pools.len == mineshaft.pools.len
assert getChestLootTable("minecraft:chests/trial_chambers/entrance").isSome
assert getChestLootTable("minecraft:chests/village/village_armorer").isSome

echo "loot: all checks passed"
