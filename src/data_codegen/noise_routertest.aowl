## Known answers from pumpkin-data/src/generated/noise_router.rs. The anchors here are the ones most
## sensitive to node order.
import std/[assertions, syncio]
import "../generated/noise_router"

let o = OVERWORLD_BASE_NOISE_ROUTER
assert o.noise.barrierNoise == 199'i32
assert o.noise.fluidLevelFloodednessNoise == 200'i32
assert o.noise.fluidLevelSpreadNoise == 201'i32
assert o.noise.lavaNoise == 202'i32
assert o.noise.erosion == 19'i32
assert o.noise.depth == 33'i32
assert o.noise.finalDensity == 198'i32
assert o.noise.veinToggle == 205'i32
assert o.noise.veinRidged == 215'i32
assert o.noise.veinGap == 216'i32

let stack = o.noise.fullComponentStack.components
let c0 = stack[0]
assert c0.kind == BaseNoiseFunctionComponentKind.ClampedYGradient
assert c0.fromY == -64.0 and c0.toY == -40.0 and c0.fromValue == 0.0 and c0.toValue == 1.0
let c1 = stack[1]
assert c1.fromY == 240.0 and c1.toY == 256.0 and c1.fromValue == 1.0 and c1.toValue == 0.0

# `fix_final_density!`: a CellCache wrapper over `final + Beardifier`.
let finalNode = stack[int(o.noise.finalDensity)]
assert finalNode.kind == BaseNoiseFunctionComponentKind.Wrapper
assert finalNode.wrapper == WrapperType.CellCache
let added = stack[int(finalNode.inputIndex)]
assert added.kind == BaseNoiseFunctionComponentKind.Binary
assert added.binaryOperation == BinaryOperation.Add
assert stack[int(added.argument2Index)].kind == BaseNoiseFunctionComponentKind.Beardifier

# Every index points below itself: the stack is evaluated front to back.
for i in 0 ..< stack.len:
  if stack[i].kind == BaseNoiseFunctionComponentKind.Wrapper:
    assert int(stack[i].inputIndex) < i

let e = END_BASE_NOISE_ROUTER
assert e.noise.barrierNoise == 15'i32
assert e.noise.erosion == 16'i32
assert e.noise.finalDensity == 14'i32
assert e.noise.fullComponentStack.components.len == 17
assert e.noise.fullComponentStack.components[2].kind == BaseNoiseFunctionComponentKind.EndIslands
assert e.noise.fullComponentStack.components[15].kind == BaseNoiseFunctionComponentKind.Constant
assert e.noise.fullComponentStack.components[15].value == 0.0
assert e.noise.fullComponentStack.components[16].wrapper == WrapperType.Cache2D
assert e.surfaceEstimator.fullComponentStack.components.len == 1
assert e.multiNoise.fullComponentStack.components.len == 3
assert e.multiNoise.erosion == 2'i32

assert applyDensity(UnaryOperation.Square, -3.0) == 9.0
assert applyDensity(UnaryOperation.Cube, -2.0) == -8.0
assert applyDensity(UnaryOperation.HalfNegative, -2.0) == -1.0
assert applyDensity(UnaryOperation.QuarterNegative, -2.0) == -0.5
assert applyDensity(UnaryOperation.Squeeze, 1.0) == 0.5 - 1.0 / 24.0
assert applyDensity(UnaryOperation.Invert, 4.0) == 0.25
assert applyDensity(LinearOperation.Add, 2.0, 3.0) == 5.0
assert applyDensity(LinearOperation.Mul, 2.0, 3.0) == 6.0
assert applyClamp(0.0, 1.0, 2.0) == 1.0

assert NETHER_BASE_NOISE_ROUTER.noise.fullComponentStack.components.len > 0
echo "noise_router: all checks passed"
