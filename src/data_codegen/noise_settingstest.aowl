## Checks src/generated/noise_settings.aowl against assets/chunk_gen_settings.json's values, and that
## the lookup src/world/flatgen.aowl uses works under both spellings.
import std/[assertions, syncio]
import "../generated/noise_settings"

assert allNoiseSettings().len == 7

let (found, o) = noiseSettingsFromName("overworld")
assert found
assert o.name == "minecraft:overworld"
assert o.seaLevel == 63'i32
assert o.minY == -64'i32
assert o.height == 384'i32
assert o.defaultBlockName == "minecraft:stone"
assert o.defaultFluidName == "minecraft:water"
assert not o.legacyRandomSource
assert o.sizeHorizontal == 1'u8
assert o.sizeVertical == 2'u8

let (foundN, n) = noiseSettingsFromName("minecraft:nether")
assert foundN
assert n.defaultBlockName == "minecraft:netherrack"
assert n.defaultFluidName == "minecraft:lava"
assert n.seaLevel == 32'i32
assert n.height == 128'i32

assert END.sizeHorizontal == 2'u8
assert END.sizeVertical == 1'u8
assert END.defaultFluidName == "minecraft:air"
assert FLOATING_ISLANDS.seaLevel == -64'i32
assert CAVES.height == 192'i32
assert not noiseSettingsFromName("missing")[0]
echo "noise_settings: all checks passed"
