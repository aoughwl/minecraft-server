## Known answers from pumpkin-data/src/generated/placed_feature.rs and placed_features_generated.rs.
import std/[assertions, syncio, strutils]
import ../generated/placed_features_generated

assert ord(PlacedFeature.Acacia) == 0
assert ord(PlacedFeature.AcaciaChecked) == 1
assert ord(high(PlacedFeature)) == 261
let (found, f) = PlacedFeature.fromName("minecraft:birch_bees_0002")
assert found and f == PlacedFeature.BirchBees0002
assert PlacedFeature.fromName("birch_bees_0002")[0]
assert not PlacedFeature.fromName("nope")[0]
assert toName(PlacedFeature.BirchBees0002) == "birch_bees_0002"
assert PlacedFeature.allNames().len == 262
assert PlacedFeature.allNames()[0] == "minecraft:acacia"

assert PlacedFeatureEntries.len == 262
let acacia = placedFeatureEntry(PlacedFeature.Acacia)
assert acacia.feature == ConfiguredFeature.Acacia
assert acacia.placement == @[PlacementModifierKind.BlockPredicateFilter]
assert acacia.json.startsWith("{\"feature\":\"minecraft:acacia\",\"placement\":[{\"predicate\":")
let (hasJson, text) = placedFeatureJson("minecraft:acacia")
assert hasJson and text == acacia.json
assert not placedFeatureJson("nope")[0]
echo "placed_feature: all checks passed"
