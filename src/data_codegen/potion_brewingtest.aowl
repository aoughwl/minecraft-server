## Known answers read from upstream's pumpkin-data/src/generated/potion_brewing.rs.
## Fuller checks of the same module are in effecttest.aowl.

import std/[assertions, syncio]
import ../generated/potion_brewing

assert POTION_RECIPES.len == 63, "POTION_RECIPES: " & $POTION_RECIPES.len
assert ITEM_RECIPES.len == 2, "ITEM_RECIPES: " & $ITEM_RECIPES.len

let first = POTION_RECIPES[0]
assert first.fromPotion == Potion.WATER
assert first.ingredient == @["glowstone_dust"]
assert first.toPotion == Potion.THICK

let last = ITEM_RECIPES[1]
assert last.fromItem == "splash_potion"
assert last.ingredient == @["dragon_breath"]
assert last.toItem == "lingering_potion"

for r in POTION_RECIPES:
  assert r.ingredient.len > 0

echo "potion_brewing: all checks passed"
