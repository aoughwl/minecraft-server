## Known answers read from upstream's pumpkin-data/src/generated/recipes.rs and assets/recipes.json.

import std/[assertions, options, syncio]
import ../generated/recipes

assert RECIPES_CRAFTING.len == shapedRecipes.len + shapelessRecipes.len + transmuteRecipes.len + decoratedPotRecipes.len
assert shapedRecipes.len == 733
assert shapelessRecipes.len == 323
assert transmuteRecipes.len == 33
assert decoratedPotRecipes.len == 1
assert stonecutterRecipes.len == 319
assert RECIPES_STONECUTTING.len == 319
assert cookingRecipes.len == 73 + 25 + 9 + 9
assert RECIPES_COOKING.len == cookingRecipes.len

block:
  var found = false
  for r in shapedRecipes:
    if r.id == "minecraft:acacia_boat":
      found = true
      assert r.pattern == @["# #", "###"]
      assert r.keyChars == @['#']
      assert r.keyIngredients.len == 1
      assert r.keyIngredients[0].kind == rikSimple
      assert r.keyIngredients[0].name == "minecraft:acacia_planks"
      assert r.result.id == "minecraft:acacia_boat"
      assert r.result.count == 1
      assert r.category == rcMisc
      assert r.group == "boat"
      assert r.hasGroup
      assert r.showNotification
  assert found, "acacia_boat shaped recipe not found"

block:
  var found = false
  for r in shapelessRecipes:
    if r.id == "minecraft:acacia_button":
      found = true
      assert r.category == rcRedstone
      assert r.group == "wooden_button"
      assert r.ingredients.len == 1
      assert r.ingredients[0].name == "minecraft:acacia_planks"
      assert r.result.id == "minecraft:acacia_button"
  assert found, "acacia_button shapeless recipe not found"

block:
  var found = false
  for r in cookingRecipes:
    if r.id == "minecraft:baked_potato":
      found = true
      assert r.kind == crkSmelting
      assert r.category == rcFood
      assert r.cookingTime == 200
      assert r.experience == 0.35'f32
      assert r.ingredient.name == "minecraft:potato"
      assert r.result.id == "minecraft:baked_potato"
  assert found, "baked_potato smelting recipe not found"

block:
  var found = false
  for r in transmuteRecipes:
    if r.id == "minecraft:black_bundle":
      found = true
      assert r.group == "bundle_dye"
      assert r.category == rcEquipment
      assert r.input.kind == rikOneOf
      assert r.input.options[0] == "minecraft:bundle"
  assert found, "black_bundle transmute recipe not found"

assert getRecipeExperience("minecraft:baked_potato_from_smoking").get == 0.35'f32
assert getRecipeExperience("minecraft:nope").isNone

proc noTags(tag: string): bool {.closure.} = false
assert getCookingRecipeWithIngredient("potato", crkSmoking, noTags).get.id == "minecraft:baked_potato_from_smoking"
assert getCookingRecipeWithIngredient("stick", crkSmelting, noTags).isNone

block:
  let ing = RecipeIngredient(kind: rikSimple, name: "minecraft:stick")
  assert matches(ing, "minecraft:stick")
  assert not matches(ing, "minecraft:stone")
  let oneOf = RecipeIngredient(kind: rikOneOf, options: @["minecraft:oak_log", "minecraft:spruce_log"])
  assert matches(oneOf, "minecraft:spruce_log")
  assert not matches(oneOf, "minecraft:birch_log")
  let tagged = RecipeIngredient(kind: rikTagged, name: "#minecraft:planks")
  assert not matches(tagged, "minecraft:oak_planks")

echo "all recipe spot-checks passed"
