## Known-answer test for src/generated/*_remap.aowl (gen_remap.aowl); values read from upstream's
## pumpkin-data/src/generated/*_remap.rs.
import std/[assertions, syncio]
import ../generated/[block_state_remap, entity_id_remap, particle_id_remap, sound_id_remap, item_id_remap]
import ../util/javaversion

# 26.2 to 1.21.11, the table the wire needs: identity up to the first change, then shifted.
assert remapBlockStateForVersion(0'u16, jmvV1_21_11) == 0'u16
assert remapBlockStateForVersion(1380'u16, jmvV1_21_11) == 1380'u16
assert remapBlockStateForVersion(1381'u16, jmvV1_21_11) == 1181'u16
assert remapBlockStateForVersion(8091'u16, jmvV1_21_11) == 7890'u16
assert remapBlockStateForVersion(16183'u16, jmvV1_21_11) == 15981'u16
assert remapBlockStateForVersion(32365'u16, jmvV1_21_11) == 29670'u16
assert BLOCK_STATE_REMAP_V_26_2_TO_V_1_21_11.len == 32366 * 4

# Composed across the whole chain.
assert remapBlockStateForVersion(22'u16, jmvV1_20_5) == 195'u16
assert remapBlockStateForVersion(16183'u16, jmvV1_20_5) == 13849'u16
assert remapBlockStateForVersion(32365'u16, jmvV1_20_5) == 2005'u16

# Past the table: blocks and entities fall to 0, the rest to the id itself.
assert remapBlockStateForVersion(40000'u16, jmvV1_21_11) == 0'u16
assert remapEntityIdForVersion(40000'u16, jmvV1_21_11) == 0'u16
assert remapParticleIdForVersion(40000'u16, jmvV1_21_11) == 40000'u16
assert remapSoundIdForVersion(40000'u16, jmvV1_21_11) == 40000'u16
assert remapItemIdForVersion(40000'u16, jmvV1_21_11) == 40000'u16

# A version with no table passes through: 26.2 itself, the newer 26.3, and anything older than 1.20.5.
assert remapBlockStateForVersion(1381'u16, jmvV26_2) == 1381'u16
assert remapBlockStateForVersion(1381'u16, jmvV26_3) == 1381'u16
assert remapBlockStateForVersion(1381'u16, jmvV1_20_3) == 1381'u16

assert remapEntityIdForVersion(130'u16, jmvV1_21_11) == 117'u16
assert remapEntityIdForVersion(157'u16, jmvV1_21_11) == 156'u16
assert remapParticleIdForVersion(4'u16, jmvV1_21_11) == 72'u16
assert remapParticleIdForVersion(124'u16, jmvV1_21_11) == 50'u16
assert remapSoundIdForVersion(228'u16, jmvV1_21_11) == 226'u16
assert remapSoundIdForVersion(1967'u16, jmvV1_21_11) == 112'u16
assert remapItemIdForVersion(26'u16, jmvV1_21_5) == 198'u16
assert remapItemIdForVersion(1536'u16, jmvV1_21_5) == 1395'u16
# The last id mapping to a target wins in the reverse table, as upstream's `reverse_mapping` has it.
assert remapItemIdFromVersion(1395'u16, jmvV1_21_5) == 1536'u16

echo "all remap checks passed"
