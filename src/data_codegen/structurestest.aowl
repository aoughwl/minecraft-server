## Known answers from pumpkin-data/src/generated/structures.rs.
import std/[assertions, syncio]
import ../generated/structures
import ../util/random/random
import ../util/xoroshiro128

assert ord(StructureKeys.PillagerOutpost) == 0
assert ord(StructureKeys.TrialChambers) == 33
let (found, key) = StructureKeys.fromName("minecraft:ancient_city")
assert found and key == StructureKeys.AncientCity
assert StructureKeys.fromName("ancient_city")[0]
assert not StructureKeys.fromName("nope")[0]
assert toName(StructureKeys.Mansion) == "minecraft:mansion"
assert structureAllNames().len == 34

let city = get(StructureKeys.AncientCity)
assert city.biomes == "#minecraft:has_structure/ancient_city"
assert city.step == GenerationStep.UndergroundDecoration
assert city.terrainAdaptation == TerrainAdaptation.BeardBox
assert city.hasStartPool and city.startPool == "minecraft:ancient_city/city_center"
assert city.hasStartJigsawName and city.startJigsawName == "minecraft:city_anchor"
assert city.hasSize and city.size == 7'i32
assert city.hasStartHeight and city.startHeight == -27'i16
assert city.hasUseExpansionHack and not city.useExpansionHack
assert city.hasMaxDistanceFromCenter and city.maxDistanceFromCenter == 116'i32
assert city.structureType == StructureType.Jigsaw
assert ordinal(GenerationStep.TopLayerModification) == 10

assert ALL_STRUCTURE_SETS.len == 20
let (setFound, ringed) = structureSetGet("strongholds")
assert setFound
assert not ringed.placement.hasFrequency
assert ringed.placement.salt == 0'u32
assert ringed.placement.placementType.kind == StructurePlacementKind.ConcentricRings
assert ringed.placement.placementType.concentricRings.spread == 3'i32
assert ringed.placement.placementType.concentricRings.distance == 32'i32
assert ringed.placement.placementType.concentricRings.count == 128'i32
assert ringed.placement.placementType.concentricRings.preferredBiomes == "#minecraft:stronghold_biased_to"
assert ringed.structures.len == 1 and ringed.structures[0].structure == StructureKeys.Stronghold

let cities = STRUCTURE_SET_ANCIENT_CITIES
assert cities.placement.salt == 20083232'u32
assert cities.placement.placementType.randomSpread.spacing == 24'i32
assert cities.placement.placementType.randomSpread.separation == 8'i32
assert not structureSetGet("minecraft:strongholds")[0]

# The linear spread is one draw, the triangular the midpoint of two, from the same stream.
var a = toRandomGenerator(fromSeed(42'u64))
var b = toRandomGenerator(fromSeed(42'u64))
let linear = SpreadType.Linear.get(a, 100'i32)
assert linear == b.nextBoundedI32(100'i32)
var c = toRandomGenerator(fromSeed(42'u64))
var d = toRandomGenerator(fromSeed(42'u64))
let first = int64(d.nextBoundedI32(100'i32))
let second = int64(d.nextBoundedI32(100'i32))
assert int64(SpreadType.Triangular.get(c, 100'i32)) == (first + second) div 2
echo "structures: all checks passed"
