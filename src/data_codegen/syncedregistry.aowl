## Reads one registry out of assets/registry/1_21_11_synced_registries.json for the generators whose old input,
## a directory of per-entry JSON files in a datapack tree, is not in the pinned tree. Entries come back in file
## order, which is the order the client numbers them in, each with its JSON text, and the field readers below
## take that text where codegenutil's take a path. Hand-written support code with no upstream counterpart.

import std/json
import codegenutil

const SyncedFile = "registry/1_21_11_synced_registries.json"

proc skipWs(s: string; pos: var int) =
  while pos < s.len and (s[pos] == ' ' or s[pos] == '\n' or s[pos] == '\r' or s[pos] == '\t'):
    inc pos

proc skipString(s: string; pos: var int) =
  ## `pos` on the opening quote; leaves it past the closing one.
  inc pos
  while pos < s.len and s[pos] != '"':
    if s[pos] == '\\': inc pos
    inc pos
  inc pos

proc skipValue(s: string; pos: var int) =
  skipWs(s, pos)
  if s[pos] == '"':
    skipString(s, pos)
  elif s[pos] == '{' or s[pos] == '[':
    var depth = 0
    while pos < s.len:
      let c = s[pos]
      if c == '"':
        skipString(s, pos)
        continue
      if c == '{' or c == '[': inc depth
      elif c == '}' or c == ']': dec depth
      inc pos
      if depth == 0: break
  else:
    while pos < s.len and s[pos] != ',' and s[pos] != '}' and s[pos] != ']':
      inc pos

proc readKey(s: string; pos: var int): string =
  ## A plain object key and its colon; registry and entry names hold no escapes.
  skipWs(s, pos)
  let start = pos + 1
  skipString(s, pos)
  result = substr(s, start, pos - 2)
  skipWs(s, pos)
  inc pos

proc syncedRegistry*(name: string): seq[(string, string)] =
  ## (entry name, entry JSON text) for every entry of registry `name`, empty if 1.21.11 has none.
  result = @[]
  let text = readAsset(SyncedFile)
  var pos = 0
  skipWs(text, pos)
  inc pos
  while pos < text.len:
    skipWs(text, pos)
    if text[pos] == '}': break
    if text[pos] == ',':
      inc pos
      continue
    let reg = readKey(text, pos)
    if reg != name:
      skipValue(text, pos)
      continue
    skipWs(text, pos)
    inc pos
    while pos < text.len:
      skipWs(text, pos)
      if text[pos] == '}': break
      if text[pos] == ',':
        inc pos
        continue
      let entry = readKey(text, pos)
      skipWs(text, pos)
      let start = pos
      skipValue(text, pos)
      result.add((entry, substr(text, start, pos - 1)))
    return result

proc jsonStringField*(entry: string; key: string): string =
  ## A top-level string field, "" if absent.
  var tree = parseJson(entry)
  let obj = root(tree)
  result = ""
  for k, val in obj.pairs():
    if k == key: result = val.getStr()

proc jsonNestedStringField*(entry: string; outerKey, innerKey: string): string =
  ## `obj[outerKey][innerKey]`, "" if either is absent.
  var tree = parseJson(entry)
  let obj = root(tree)
  result = ""
  for k, val in obj.pairs():
    if k == outerKey:
      for ik, iv in val.pairs():
        if ik == innerKey: result = iv.getStr()

proc jsonBoolField*(entry: string; key: string; default: bool): bool =
  var tree = parseJson(entry)
  let obj = root(tree)
  result = default
  for k, val in obj.pairs():
    if k == key: result = val.getBool()

proc jsonFloatField*(entry: string; key: string; default: float): float =
  var tree = parseJson(entry)
  let obj = root(tree)
  result = default
  for k, val in obj.pairs():
    if k == key: result = val.getFloat()

proc jsonIntField*(entry: string; key: string; default: int): int =
  var tree = parseJson(entry)
  let obj = root(tree)
  result = default
  for k, val in obj.pairs():
    if k == key: result = int(val.getInt())
