## Known-answer test for src/generated/tag.aowl (gen_tag.aowl); values read from upstream's
## pumpkin-data/src/generated/tag.rs and assets/tags.
import std/[assertions, syncio]
import ../generated/tag
import ../util/javaversion

assert identifierString(rkWorldgenBiome) == "worldgen/biome"
let (foundBlock, blockKey) = registryKeyFromString("block")
assert foundBlock and blockKey == rkBlock
let (foundNone, _) = registryKeyFromString("nope")
assert not foundNone

# A constant, as upstream's tag::Block::C_BARRELS: (["barrel"], [839]).
assert tagName(Block_C_BARRELS) == "c:barrels"
assert refKey(Block_C_BARRELS) == rkBlock
let barrels = resolve(Block_C_BARRELS)
assert barrels.values.len == 1 and barrels.values[0] == "barrel"
assert barrels.ids.len == 1 and barrels.ids[0] == 839'u16

# has_tag.
assert hasTag(839'u16, Block_C_BARRELS)
assert not hasTag(840'u16, Block_C_BARRELS)
let barrel = Taggable(tagKey: rkBlock, registryKey: "barrel", registryId: 839'u16)
assert hasTag(barrel, Block_C_BARRELS)
assert hasTag(barrel, barrels)

# is_tagged_with accepts the # prefix; an unknown tag is upstream's None.
let (known, tagged) = isTaggedWith(barrel, "#c:barrels")
assert known and tagged
let (known2, _) = isTaggedWith(barrel, "c:no_such_tag")
assert not known2
let (hasValues, values) = getTagValues(barrel, "c:barrels")
assert hasValues and values.len == 1

# Lookups without a constant are 26.2's.
let (hasPickaxe, pickaxe) = getTagValues(rkBlock, "minecraft:mineable/pickaxe")
assert hasPickaxe and pickaxe.len == 510 and pickaxe[0] == "stone"
let (hasIds, _) = getTagIds(rkBlock, "minecraft:mineable/pickaxe")
assert hasIds

# Per version: the wire target's data differs from 26.2's, and each version gets its own.
let wire = getRegistryKeyTags(jmvV1_21_11, rkBlock)
assert wire.present and wire.names.len == 329
let wirePick = find(wire, "minecraft:mineable/pickaxe")
assert wirePick != nil
let wirePickTag = resolveFor(Block_MINECRAFT_MINEABLE_PICKAXE, jmvV1_21_11)
assert wirePickTag != nil

# 1.20.5 reads 1.21.2's file, as upstream's table has it; cat_variant is gone by 26.2.
assert getRegistryKeyTags(jmvV1_20_5, rkCatVariant).present
assert getRegistryKeyTags(jmvV1_21_2, rkCatVariant).present
assert not getRegistryKeyTags(jmvV26_2, rkCatVariant).present
assert not getLatestMap(rkCatVariant).present

# Upstream's fallback: an unlisted version reads 26.2.
assert getRegistryKeyTags(jmvV1_8, rkBlock).names.len == getLatestMap(rkBlock).names.len

echo "all tag checks passed"
