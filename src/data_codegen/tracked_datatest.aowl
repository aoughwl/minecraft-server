## Port of the #[test]s in pumpkin-codegen/src/tracked_data.rs, plus meta_data_type.rs's per-version ids and
## message_type.rs's ids; values read from upstream's pumpkin-data/src/generated.
import std/[assertions, syncio]
import ../generated/tracked_data
import ../generated/meta_data_type
import ../generated/message_type
import ../util/javaversion

# wolf_variant_keeps_its_entity_specific_v26_2_tracker_id
assert TrackedData_WOLF_VARIANT_ID.v1_21_11 == 20'u8
assert TrackedData_WOLF_VARIANT_ID.v26_2 == 23'u8
assert get(TrackedData_WOLF_VARIANT_ID, jmvV1_21_11) == 20'u8
assert toU8(TrackedData_WOLF_VARIANT_ID) == 23'u8
# Upstream's `_ => latest`.
assert get(TrackedData_WOLF_VARIANT_ID, jmvV1_8) == 23'u8

# Both spellings of the name-visible tracker land on one constant.
assert TrackedData_CUSTOM_NAME_VISIBLE.v26_2 == TrackedData_CUSTOM_NAME_VISIBLE.v1_21_11

# meta_data_type: an unlisted version reads -1, and a type absent from an old version too.
assert id(BYTE, jmvV1_21_11) == BYTE.v1_21_11
assert id(BYTE, jmvV1_8) == -1'i32

assert CHAT == 0'u8
assert RAW == 7'u8

echo "all tracked data checks passed"
