## Known answers read from upstream's pumpkin-data/src/generated/villager.rs.

import std/[syncio, assertions, options]
import "../generated/villager"

assert allVillagerProfessions().len == 15
assert VillagerProfession.fromI32(0'i32).get == VillagerProfession.None
assert VillagerProfession.fromI32(1'i32).get == VillagerProfession.Armorer
assert VillagerProfession.fromI32(99'i32).isNone

let farmer = VillagerProfession.Farmer
assert farmer.translationKey == "entity.minecraft.villager.farmer"
assert farmer.requestedItems == @["wheat", "wheat_seeds", "beetroot_seeds", "bone_meal"]
assert farmer.workSound.get == "minecraft:entity.villager.work_farmer"
assert VillagerProfession.None.workSound.isNone

let set1 = VillagerProfession.Armorer.tradeSet(1'i32).get
assert set1.amount == 2'i32
let t0 = set1.trades[0]
assert t0.wants.item == "emerald"
assert t0.wants.count == 4'i32
assert t0.wantsB.isNone
assert t0.gives.item == "iron_boots"
assert t0.gives.count == 1'i32
assert t0.maxUses == 12'i32
assert t0.xp == 2'i32
assert t0.priceMultiplier == 0.05'f32
assert TRADES_ARMORER_LEVEL_1.len == set1.trades.len
assert VillagerProfession.None.tradeSet(1'i32).isNone
assert VillagerProfession.Armorer.tradeSet(9'i32).isNone

assert VillagerType.fromI32(0'i32).get == VillagerType.Desert
assert VillagerType.fromI32(7'i32).isNone
assert villagerTypeNames().len == 7
assert villagerTypeNamespace("desert") == "minecraft:desert"
assert villagerTypeNamespace("nonexistent") == ""

echo "villager: all checks passed"
