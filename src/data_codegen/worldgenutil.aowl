## JSON and literal helpers shared by the worldgen generators (gen_biome, gen_noise_router,
## gen_carver, gen_structures, gen_placed_feature, gen_configured_feature, ...).
##
## `JsonNode` has no field index, and its `{}` operator crashes on a missing key, so
## every read scans `pairs()`. Getters take the same defaults upstream's
## `v["x"].as_i64().unwrap_or(d)` chains use.

import std/[json, md5, strutils]

proc fieldOf*(n: JsonNode; key: string): (bool, JsonNode) =
  ## The value under `key`; the node is meaningful only when the bool is true.
  if kind(n) != JObject:
    return (false, n)
  for k, v in pairs(n):
    if k == key:
      return (true, v)
  return (false, n)

proc has*(n: JsonNode; key: string): bool =
  fieldOf(n, key)[0]

proc num*(n: JsonNode): float64 =
  ## Upstream's `as_f64`: a JSON integer reads as a float too.
  if kind(n) == JInt: float64(getInt(n)) else: getFloat(n)

proc strAt*(n: JsonNode; key: string; default = ""): string =
  let (ok, v) = fieldOf(n, key)
  if ok and kind(v) == JString: getStr(v) else: default

proc intAt*(n: JsonNode; key: string; default = 0): int =
  let (ok, v) = fieldOf(n, key)
  if ok and kind(v) == JInt: int(getInt(v)) else: default

proc numAt*(n: JsonNode; key: string; default = 0.0): float64 =
  let (ok, v) = fieldOf(n, key)
  if ok and (kind(v) == JInt or kind(v) == JFloat): num(v) else: default

proc boolAt*(n: JsonNode; key: string; default = false): bool =
  let (ok, v) = fieldOf(n, key)
  if ok and kind(v) == JBool: getBool(v) else: default

proc sortedPairs*(n: JsonNode): seq[(string, JsonNode)] =
  ## `BTreeMap<String, _>` iteration order, which is also what `serde_json::Value`
  ## objects give upstream. Closure-free sort: see COMPILER-BUGS.md bug 5.
  result = @[]
  for k, v in pairs(n):
    result.add((k, v))
  for i in 1 ..< result.len:
    var j = i
    while j > 0 and result[j - 1][0] > result[j][0]:
      let later = result[j]
      let earlier = result[j - 1]
      result[j - 1] = later
      result[j] = earlier
      dec j

proc stripMc*(s: string): string =
  ## `strip_prefix("minecraft:").unwrap_or(s)`.
  if s.startsWith("minecraft:"): s[10 .. ^1] else: s

proc shouty*(s: string): string =
  ## The constant spelling upstream's generators use for a registry path.
  result = newStringOfCap(s.len)
  for ch in s:
    if ch == '/' or ch == '-' or ch == ':' or ch == '.':
      result.add('_')
    else:
      result.add(toUpperAscii(ch))

proc f32Lit*(x: float64): string =
  ## The float32 upstream's `as f32` keeps, as a literal: the widened value prints exactly.
  $float64(float32(x)) & "'f32"

proc f64Lit*(x: float64): string =
  $x

proc boolLit*(b: bool): string =
  if b: "true" else: "false"

proc hexOf(v: uint64; digits: int): string =
  const Hex = "0123456789abcdef"
  result = newString(digits)
  var rest = v
  var i = digits - 1
  while i >= 0:
    result[i] = Hex[int(rest and 15'u64)]
    rest = rest shr 4
    dec i

proc hexBits64*(x: float64): string =
  ## A float64 by its bits, so a load-time decoder never has to round.
  hexOf(cast[uint64](x), 16)

proc hexBits32*(x: float64): string =
  ## The float32 `x as f32` by its bits.
  hexOf(uint64(cast[uint32](float32(x))), 8)

proc md5LoHi*(s: string): (uint64, uint64) =
  ## `u64::from_be_bytes` of an MD5's two halves.
  let digest = toMD5(s)
  var lo = 0'u64
  for k in 0 ..< 8:
    lo = (lo shl 8) or uint64(digest[k])
  var hi = 0'u64
  for k in 8 ..< 16:
    hi = (hi shl 8) or uint64(digest[k])
  (lo, hi)

proc parseHexColor*(s: string): (bool, int32) =
  ## dimension.rs's `parse_hex_color`: `i32::from_str_radix` of what follows `#`, so a value
  ## past i32::MAX (an eight-digit colour with alpha, say) is None.
  if s.len < 2 or s[0] != '#':
    return (false, 0'i32)
  var v = 0'u64
  for i in 1 ..< s.len:
    let c = s[i]
    var d = 0
    if c >= '0' and c <= '9': d = ord(c) - ord('0')
    elif c >= 'a' and c <= 'f': d = ord(c) - ord('a') + 10
    elif c >= 'A' and c <= 'F': d = ord(c) - ord('A') + 10
    else: return (false, 0'i32)
    v = v * 16'u64 + uint64(d)
    if v > 0x7fffffff'u64:
      return (false, 0'i32)
  (true, int32(v))

proc yOffsetLit*(v: JsonNode): string =
  ## placed_feature.rs's `value_to_y_offset`, as a `YOffset` literal of util/y_offset.aowl.
  let (hasAbs, abs) = fieldOf(v, "absolute")
  if hasAbs:
    return "YOffset(kind: yokAbsolute, absolute: " & $getInt(abs) & "'i16)"
  let (hasAb, ab) = fieldOf(v, "above_bottom")
  if hasAb:
    return "YOffset(kind: yokAboveBottom, aboveBottom: " & $getInt(ab) & "'i8)"
  let (hasBt, bt) = fieldOf(v, "below_top")
  if hasBt:
    return "YOffset(kind: yokBelowTop, belowTop: " & $getInt(bt) & "'i8)"
  "YOffset(kind: yokAbsolute, absolute: 0'i16)"

proc topLevelValues*(minified: string): seq[(string, string)] =
  ## Splits a minified JSON object into `key`, raw value text, sorted by key as a `BTreeMap`
  ## would. The raw text is the asset's own, so a number's spelling and key order survive.
  result = @[]
  var i = 1
  while i < minified.len and minified[i] != '}':
    # The key: asset keys hold no escapes.
    inc i
    let keyStart = i
    while minified[i] != '"':
      inc i
    let key = minified[keyStart ..< i]
    i += 2  # closing quote and colon
    let valueStart = i
    var depth = 0
    var inString = false
    while i < minified.len:
      let ch = minified[i]
      if inString:
        if ch == '\\':
          inc i
        elif ch == '"':
          inString = false
      elif ch == '"':
        inString = true
      elif ch == '{' or ch == '[':
        inc depth
      elif ch == '}' or ch == ']':
        if depth == 0:
          break
        dec depth
      elif ch == ',' and depth == 0:
        break
      inc i
    result.add((key, minified[valueStart ..< i]))
    if i < minified.len and minified[i] == ',':
      inc i
  for a in 1 ..< result.len:
    var j = a
    while j > 0 and result[j - 1][0] > result[j][0]:
      let later = result[j]
      let earlier = result[j - 1]
      result[j - 1] = later
      result[j] = earlier
      dec j
