type
  FrameType* {.pure.} = enum
    Task = 0, Challenge = 1, Goal = 2

  AdvancementDisplay* = object
    title*: string
    description*: string
    itemIcon*: string
    frameType*: FrameType
    backgroundTexture*: Option[string]
    showToast*: bool
    hidden*: bool
    announceToChat*: bool
    x*: float32
    y*: float32

  AdvancementReward* = object
    experience*: int32
    recipes*: seq[string]

  Advancement* = ref object
    id*: Identifier
    parent*: Option[Identifier]
    sendTelemetry*: bool
    display*: Option[AdvancementDisplay]
    reward*: AdvancementReward
    requirements*: seq[seq[string]]
    criteria*: seq[string]

  AdvancementNode* = object
    children*: seq[int]
    parent*: Option[int]
    value*: Advancement

  AdvancementTree* = object
    nodes*: Table[Identifier, int]
    nodesVector*: seq[AdvancementNode]
    roots*: seq[int]
    tasks*: seq[int]

proc `==`*(a, b: Advancement): bool = a.id == b.id
proc hash*(a: Advancement): Hash = hash(a.id)
proc `$`*(a: Advancement): string = a.id.namespace & ":" & a.id.path
proc isRoot*(self: Advancement): bool = self.parent.isNone

proc splitOn(s: string; sep: char): seq[string] =
  result = @[]
  if s.len == 0: return
  var pos = 0
  while true:
    result.add(fieldStr(s, pos, sep))
    if pos >= s.len: break
    inc pos

var gAdvancements*: seq[Advancement] = @[]
var ADVANCEMENT_TREE*: AdvancementTree = AdvancementTree(nodes: initTable[Identifier, int](),
  nodesVector: @[], roots: @[], tasks: @[])

proc loadAdvancements() =
  let s = AdvancementText
  var pos = 0
  template str(): string =
    let v = fieldStr(s, pos, '\t')
    skipSep(s, pos)
    v
  template num(): int =
    let v = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    v
  template flag(): bool = num() != 0
  template real(): float =
    let v = fieldFloat(s, pos, '\t')
    skipSep(s, pos)
    v
  while not atEnd(s, pos):
    let raw = str()
    let parentIdx = num()
    let telemetry = flag()
    let hasDisplay = flag()
    let title = str()
    let description = str()
    let icon = str()
    let frame = num()
    let background = str()
    let hasBackground = flag()
    let showToast = flag()
    let hidden = flag()
    let announce = flag()
    let x = real()
    let y = real()
    let experience = num()
    let requirements = str()
    let criteria = str()
    var requirementGroups: seq[seq[string]] = @[]
    let groups = splitOn(requirements, '\x1e')
    for g in groups: requirementGroups.add(splitOn(g, '\x1f'))
    var display = none[AdvancementDisplay]()
    if hasDisplay:
      let frameType = case frame
        of 1: FrameType.Challenge
        of 2: FrameType.Goal
        else: FrameType.Task
      display = some(AdvancementDisplay(title: title, description: description, itemIcon: icon,
        frameType: frameType, backgroundTexture: if hasBackground: some(background) else: none[string](),
        showToast: showToast, hidden: hidden, announceToChat: announce, x: float32(x), y: float32(y)))
    let idx = gAdvancements.len
    var parentId = none[Identifier]()
    if parentIdx >= 0:
      parentId = some(gAdvancements[parentIdx].id)
    let adv = Advancement(id: vanillaStatic(raw), parent: parentId, sendTelemetry: telemetry, display: display,
      reward: AdvancementReward(experience: int32(experience), recipes: @[]),
      requirements: requirementGroups, criteria: splitOn(criteria, '\x1f'))
    gAdvancements.add(adv)
    ADVANCEMENT_TREE.nodes[adv.id] = idx
    ADVANCEMENT_TREE.nodesVector.add(AdvancementNode(children: @[],
      parent: if parentIdx >= 0: some(parentIdx) else: none[int](), value: adv))
    if parentIdx >= 0:
      ADVANCEMENT_TREE.nodesVector[parentIdx].children.add(idx)
      ADVANCEMENT_TREE.tasks.add(idx)
    else:
      ADVANCEMENT_TREE.roots.add(idx)

loadAdvancements()

proc buildNames(): Table[string, int] =
  result = initTable[string, int]()
  for i, a in gAdvancements:
    result[a.id.path] = i

let gAdvancementNames: Table[string, int] = buildNames()

proc fromName*(T: typedesc[Advancement]; name: string): Option[Advancement] =
  ## By bare path, such as `story/root`.
  let i = gAdvancementNames.getOrDefault(name, -1)
  if i < 0: none[Advancement]() else: some(gAdvancements[i])

proc fromMinecraftName*(T: typedesc[Advancement]; name: string): Option[Advancement] =
  ## By full name, such as `minecraft:story/root`.
  if name.len <= 10 or substr(name, 0, 9) != "minecraft:": return none[Advancement]()
  Advancement.fromName(substr(name, 10, name.len - 1))

proc getAdvancementsList*(T: typedesc[Advancement]): seq[Advancement] = gAdvancements

proc getIdentifierList*(T: typedesc[Advancement]): seq[Identifier] =
  result = @[]
  for a in gAdvancements: result.add(a.id)

template ADVENTURE_ROOT*(T: typedesc[Advancement]): Advancement = gAdvancements[0]
