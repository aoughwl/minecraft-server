proc opposite*(self: Facing): Facing =
  case self
  of Facing.North: Facing.South
  of Facing.South: Facing.North
  of Facing.East: Facing.West
  of Facing.West: Facing.East
  of Facing.Up: Facing.Down
  of Facing.Down: Facing.Up

proc horizontalFacingAll*(): array[4, HorizontalFacing] =
  [HorizontalFacing.North, HorizontalFacing.South, HorizontalFacing.West, HorizontalFacing.East]

proc toOffset*(self: HorizontalFacing): Vector3[int32] =
  case self
  of HorizontalFacing.North: vec3(0'i32, 0'i32, -1'i32)
  of HorizontalFacing.South: vec3(0'i32, 0'i32, 1'i32)
  of HorizontalFacing.West: vec3(-1'i32, 0'i32, 0'i32)
  of HorizontalFacing.East: vec3(1'i32, 0'i32, 0'i32)

proc toAxis*(self: HorizontalFacing): HorizontalAxis =
  case self
  of HorizontalFacing.North, HorizontalFacing.South: HorizontalAxis.Z
  of HorizontalFacing.West, HorizontalFacing.East: HorizontalAxis.X

proc toFacing*(self: HorizontalFacing): HorizontalFacing = self

proc opposite*(self: HorizontalFacing): HorizontalFacing =
  case self
  of HorizontalFacing.North: HorizontalFacing.South
  of HorizontalFacing.South: HorizontalFacing.North
  of HorizontalFacing.West: HorizontalFacing.East
  of HorizontalFacing.East: HorizontalFacing.West

proc rotateClockwise*(self: HorizontalFacing): HorizontalFacing =
  case self
  of HorizontalFacing.North: HorizontalFacing.East
  of HorizontalFacing.South: HorizontalFacing.West
  of HorizontalFacing.West: HorizontalFacing.North
  of HorizontalFacing.East: HorizontalFacing.South

proc rotateCounterClockwise*(self: HorizontalFacing): HorizontalFacing =
  case self
  of HorizontalFacing.North: HorizontalFacing.West
  of HorizontalFacing.South: HorizontalFacing.East
  of HorizontalFacing.West: HorizontalFacing.South
  of HorizontalFacing.East: HorizontalFacing.North

proc isAscending*(self: RailShape): bool =
  self == RailShape.AscendingEast or self == RailShape.AscendingWest or
    self == RailShape.AscendingNorth or self == RailShape.AscendingSouth

proc isAscending*(self: RailShapeStraight): bool =
  self == RailShapeStraight.AscendingEast or self == RailShapeStraight.AscendingWest or
    self == RailShapeStraight.AscendingNorth or self == RailShapeStraight.AscendingSouth
