deepslate_stairs\t377282\t377538\n1158\tpolished_deepslate_slab\t377538\t377969\n1159\tpolished_deepslate_wall\t377969\t378221\n1160\tdeepslate_tiles\t378221\t378457\n1161\tdeepslate_tile_stairs\t378457\t378705\n1162\tdeepslate_tile_slab\t378705\t379124\n1163\tdeepslate_tile_wall\t379124\t379368\n1164\tdeepslate_bricks\t379368\t379606\n1165\tdeepslate_brick_stairs\t379606\t379856\n1166\tdeepslate_brick_slab\t379856\t380278\n1167\tdeepslate_brick_wall\t380278\t380524\n1168\tchiseled_deepslate\t380524\t380766\n1169\tcracked_deepslate_bricks\t380766\t381020\n1170\tcracked_deepslate_tiles\t381020\t381272\n1171\tinfested_deepslate\t381272\t381612\n1172\tsmooth_basalt\t381612\t381844\n1173\traw_iron_block\t381844\t382078\n1174\traw_copper_block\t382078\t382316\n1175\traw_gold_block\t382316\t382550\n1176\tpotted_azalea_bush\t382550\t382922\n1177\tpotted_flowering_azalea_bush\t382922\t383314\n1178\tochre_froglight\t383314\t383550\n1179\tverdant_froglight\t383550\t383790\n1180\tpearlescent_froglight\t383790\t384038\n1181\tfrogspawn\t384038\t384111\n1182\treinforced_deepslate\t384111\t384195\n1183\tdecorated_pot\t384195\t384716\n1184\tcrafter\t384716\t384936\n1185\ttrial_spawner\t384936\t385013\n1186\tvault\t385013\t385082\n1187\theavy_core\t385082\t385308\n1188\tpale_moss_block\t385308\t385544\n1189\tpale_moss_carpet\t385544\t385907\n1190\tpale_hanging_moss\t385907\t386375\n1191\topen_eyeblossom\t386375\t386611\n1192\tclosed_eyeblossom\t386611\t386851\n1193\tpotted_open_eyeblossom\t386851\t387236\n1194\tpotted_closed_eyeblossom\t387236\t387625\n1195\tfirefly_bush\t387625\t387855\n"
const BlockLootCount* = 1196

type LootSpan = object
  start: int
  stop: int

proc loadSpans(): seq[LootSpan] =
  result = newSeq[LootSpan](BlockLootCount)
  var pos = 0
  while not atEnd(BlockLootIndex, pos):
    let id = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let start = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let stop = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    result[id] = LootSpan(start: start, stop: stop)

proc loadNames(): Table[string, int] =
  result = initTable[string, int]()
  var pos = 0
  while not atEnd(BlockLootIndex, pos):
    let id = fieldInt(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    let name = fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    discard fieldStr(BlockLootIndex, pos, '\t')
    skipSep(BlockLootIndex, pos)
    result[name] = id

let gSpans: seq[LootSpan] = loadSpans()
let gNames: Table[string, int] = loadNames()
var gCache: seq[nil LootTableRef] = newSeq[nil LootTableRef](BlockLootCount)

proc blockLootTable*(blockId: uint16): nil LootTableRef =
  ## `Block::from_id(id).loot_table`, nil where upstream has `None`.
  let i = int(blockId)
  if i >= BlockLootCount or gSpans[i].start < 0: return nil
  if gCache[i] == nil:
    gCache[i] = decodeLootTableText(substr(BlockLootJson, gSpans[i].start, gSpans[i].stop - 1))
  gCache[i]

proc blockLootTableByName*(name: string): nil LootTableRef =
  ## By bare block name, as in `Block.name`.
  let i = gNames.getOrDefault(name, -1)
  if i < 0: return nil
  blockLootTable(uint16(i))
