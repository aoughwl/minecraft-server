type
  CrafterLikeProperties* = object
    crafting*: bool
    orientation*: Orientation
    triggered*: bool

proc toIndex*(self: CrafterLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += (if self.triggered: 0'u16 else: 1'u16) * mul
  mul *= 2'u16
  result += toIndex(self.orientation) * mul
  mul *= 12'u16
  result += (if self.crafting: 0'u16 else: 1'u16) * mul
  mul *= 2'u16

proc fromIndex*(T: typedesc[CrafterLikeProperties]; idx: uint16): CrafterLikeProperties =
  var index = idx
  result = CrafterLikeProperties()
  result.triggered = index mod 2'u16 == 0'u16
  index = index div 2'u16
  result.orientation = Orientation.fromIndex(index mod 12'u16)
  index = index div 12'u16
  result.crafting = index mod 2'u16 == 0'u16
  index = index div 2'u16

proc handlesBlockId*(T: typedesc[CrafterLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 110

