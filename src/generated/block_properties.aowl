proc blocksMovement*(blockState: BlockState; id: BlockId): bool =
  ## `blocks_movement`.
  blockState.isSolid and id != blockIdCobweb and id != blockIdBambooSapling

type
  GrassBlockLikeProperties* = object
    snowy*: bool

proc toIndex*(self: GrassBlockLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += (if self.snowy: 0'u16 else: 1'u16) * mul
  mul *= 2'u16

proc fromIndex*(T: typedesc[GrassBlockLikeProperties]; idx: uint16): GrassBlockLikeProperties =
  var index = idx
  result = GrassBlockLikeProperties()
  result.snowy = index mod 2'u16 == 0'u16
  index = index div 2'u16

proc handlesBlockId*(T: typedesc[GrassBlockLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 0

proc toStateId*(self: GrassBlockLikeProperties; b: Block): BlockStateId =
  if not GrassBlockLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for GrassBlockLikeProperties")
  b.states[int(toIndex(self))].id

proc fromStateId*(T: typedesc[GrassBlockLikeProperties]; id: BlockStateId; b: Block): GrassBlockLikeProperties =
  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  if asU16(id) >= minId and asU16(id) <= maxId:
    GrassBlockLikeProperties.fromIndex(asU16(id) - minId)
  else:
    GrassBlockLikeProperties.fromIndex(0'u16)

proc defaultFor*(T: typedesc[GrassBlockLikeProperties]; b: Block): GrassBlockLikeProperties =
  if not GrassBlockLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for GrassBlockLikeProperties")
  GrassBlockLikeProperties.fromStateId(b.defaultState.id, b)

proc toProps*(self: GrassBlockLikeProperties): seq[(string, string)] =
  result = @[]
  result.add(("snowy", (if self.snowy: "true" else: "false")))

proc fromProps*(T: typedesc[GrassBlockLikeProperties]; props: openArray[(string, string)]; b: Block): GrassBlockLikeProperties =
  result = GrassBlockLikeProperties.defaultFor(b)
  for prop in props:
    case prop[0]
    of "snowy":
      result.snowy = prop[1] == "true"
    else: discard

type
  PaleOakWoodLikeProperties* = object
    axis*: Axis

proc toIndex*(self: PaleOakWoodLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += toIndex(self.axis) * mul
  mul *= 3'u16

proc fromIndex*(T: typedesc[PaleOakWoodLikeProperties]; idx: uint16): PaleOakWoodLikeProperties =
  var index = idx
  result = PaleOakWoodLikeProperties()
  result.axis = Axis.fromIndex(index mod 3'u16)
  index = index div 3'u16

proc handlesBlockId*(T: typedesc[PaleOakWoodLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 1

proc toStateId*(self: PaleOakWoodLikeProperties; b: Block): BlockStateId =
  if not PaleOakWoodLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for PaleOakWoodLikeProperties")
  b.states[int(toIndex(self))].id

proc fromStateId*(T: typedesc[PaleOakWoodLikeProperties]; id: BlockStateId; b: Block): PaleOakWoodLikeProperties =
  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  if asU16(id) >= minId and asU16(id) <= maxId:
    PaleOakWoodLikeProperties.fromIndex(asU16(id) - minId)
  else:
    PaleOakWoodLikeProperties.fromIndex(0'u16)

proc defaultFor*(T: typedesc[PaleOakWoodLikeProperties]; b: Block): PaleOakWoodLikeProperties =
  if not PaleOakWoodLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for PaleOakWoodLikeProperties")
  PaleOakWoodLikeProperties.fromStateId(b.defaultState.id, b)

proc toProps*(self: PaleOakWoodLikeProperties): seq[(string, string)] =
  result = @[]
  result.add(("axis", toValue(self.axis)))

proc fromProps*(T: typedesc[PaleOakWoodLikeProperties]; props: openArray[(string, string)]; b: Block): PaleOakWoodLikeProperties =
  result = PaleOakWoodLikeProperties.defaultFor(b)
  for prop in props:
    case prop[0]
    of "axis":
      result.axis = Axis.fromValue(prop[1])
    else: discard

type
  OakSaplingLikeProperties* = object
    stage*: uint8

proc toIndex*(self: OakSaplingLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += uint16(self.stage - 0'u8) * mul
  mul *= 2'u16

proc fromIndex*(T: typedesc[OakSaplingLikeProperties]; idx: uint16): OakSaplingLikeProperties =
  var index = idx
  result = OakSaplingLikeProperties()
  result.stage = uint8(index mod 2'u16) + 0'u8
  index = index div 2'u16

proc handlesBlockId*(T: typedesc[OakSaplingLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 2

proc toStateId*(self: OakSaplingLikeProperties; b: Block): BlockStateId =
  if not OakSaplingLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for OakSaplingLikeProperties")
  b.states[int(toIndex(self))].id

proc fromStateId*(T: typedesc[OakSaplingLikeProperties]; id: BlockStateId; b: Block): OakSaplingLikeProperties =
  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  if asU16(id) >= minId and asU16(id) <= maxId:
    OakSaplingLikeProperties.fromIndex(asU16(id) - minId)
  else:
    OakSaplingLikeProperties.fromIndex(0'u16)

proc defaultFor*(T: typedesc[OakSaplingLikeProperties]; b: Block): OakSaplingLikeProperties =
  if not OakSaplingLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for OakSaplingLikeProperties")
  OakSaplingLikeProperties.fromStateId(b.defaultState.id, b)

proc toProps*(self: OakSaplingLikeProperties): seq[(string, string)] =
  result = @[]
  result.add(("stage", $self.stage))

proc fromProps*(T: typedesc[OakSaplingLikeProperties]; props: openArray[(string, string)]; b: Block): OakSaplingLikeProperties =
  result = OakSaplingLikeProperties.defaultFor(b)
  for prop in props:
    case prop[0]
    of "stage":
      result.stage = uint8(propIntOr(prop[1], 0, 1))
    else: discard

type
  MangrovePropaguleLikeProperties* = object
    age*: uint8
    hanging*: bool
    stage*: uint8
    waterlogged*: bool

proc toIndex*(self: MangrovePropaguleLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += (if self.waterlogged: 0'u16 else: 1'u16) * mul
  mul *= 2'u16
  result += uint16(self.stage - 0'u8) * mul
  mul *= 2'u16
  result += (if self.hanging: 0'u16 else: 1'u16) * mul
  mul *= 2'u16
  result += uint16(self.age - 0'u8) * mul
  mul *= 5'u16

proc fromIndex*(T: typedesc[MangrovePropaguleLikeProperties]; idx: uint16): MangrovePropaguleLikeProperties =
  var index = idx
  result = MangrovePropaguleLikeProperties()
  result.waterlogged = index mod 2'u16 == 0'u16
  index = index div 2'u16
  result.stage = uint8(index mod 2'u16) + 0'u8
  index = index div 2'u16
  result.hanging = index mod 2'u16 == 0'u16
  index = index div 2'u16
  result.age = uint8(index mod 5'u16) + 0'u8
  index = index div 5'u16

proc handlesBlockId*(T: typedesc[MangrovePropaguleLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 3

proc toStateId*(self: MangrovePropaguleLikeProperties; b: Block): BlockStateId =
  if not MangrovePropaguleLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for MangrovePropaguleLikeProperties")
  b.states[int(toIndex(self))].id

proc fromStateId*(T: typedesc[MangrovePropaguleLikeProperties]; id: BlockStateId; b: Block): MangrovePropaguleLikeProperties =
  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  if asU16(id) >= minId and asU16(id) <= maxId:
    MangrovePropaguleLikeProperties.fromIndex(asU16(id) - minId)
  else:
    MangrovePropaguleLikeProperties.fromIndex(0'u16)

proc defaultFor*(T: typedesc[MangrovePropaguleLikeProperties]; b: Block): MangrovePropaguleLikeProperties =
  if not MangrovePropaguleLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for MangrovePropaguleLikeProperties")
  MangrovePropaguleLikeProperties.fromStateId(b.defaultState.id, b)

proc toProps*(self: MangrovePropaguleLikeProperties): seq[(string, string)] =
  result = @[]
  result.add(("age", $self.age))
  result.add(("hanging", (if self.hanging: "true" else: "false")))
  result.add(("stage", $self.stage))
  result.add(("waterlogged", (if self.waterlogged: "true" else: "false")))

proc fromProps*(T: typedesc[MangrovePropaguleLikeProperties]; props: openArray[(string, string)]; b: Block): MangrovePropaguleLikeProperties =
  result = MangrovePropaguleLikeProperties.defaultFor(b)
  for prop in props:
    case prop[0]
    of "age":
      result.age = uint8(propIntOr(prop[1], 0, 4))
    of "hanging":
      result.hanging = prop[1] == "true"
    of "stage":
      result.stage = uint8(propIntOr(prop[1], 0, 1))
    of "waterlogged":
      result.waterlogged = prop[1] == "true"
    else: discard

type
  WaterLikeProperties* = object
    level*: uint8

proc toIndex*(self: WaterLikeProperties): uint16 =
  var mul = 1'u16
  result = 0'u16
  result += uint16(self.level - 0'u8) * mul
  mul *= 16'u16

proc fromIndex*(T: typedesc[WaterLikeProperties]; idx: uint16): WaterLikeProperties =
  var index = idx
  result = WaterLikeProperties()
  result.level = uint8(index mod 16'u16) + 0'u8
  index = index div 16'u16

proc handlesBlockId*(T: typedesc[WaterLikeProperties]; blockId: BlockId): bool =
  blockGroupOf(blockId) == 4

proc toStateId*(self: WaterLikeProperties; b: Block): BlockStateId =
  if not WaterLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for WaterLikeProperties")
