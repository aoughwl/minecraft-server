  let minId = asU16(b.states[0].id)
  let maxId = asU16(b.states[b.states.len - 1].id)
  if asU16(id) >= minId and asU16(id) <= maxId:
    CrafterLikeProperties.fromIndex(asU16(id) - minId)
  else:
    CrafterLikeProperties.fromIndex(0'u16)

proc defaultFor*(T: typedesc[CrafterLikeProperties]; b: Block): CrafterLikeProperties =
  if not CrafterLikeProperties.handlesBlockId(b.id):
    genPanic(b.name & " is not a valid block for CrafterLikeProperties")
