  index = index div 3'u16
  result.south = SouthWall.fromIndex(index mod 3'u16)
  index = index div 3'u16
  result.north = NorthWall.fromIndex(index mod 3'u16)
  index = index div 3'u16
  result.east = EastWall.fromIndex(index mod 3'u16)
  index = index div 3'u16
  result.bottom = index mod 2'u16 == 0'u16
  index = index div 2'u16

