proc blockById*(id: int): (bool, Block) =
  for b in AllBlocks:
    if b.id == id: return (true, b)
  (false, Block())

proc blockByName*(name: string): (bool, Block) =
  for b in AllBlocks:
    if b.name == name: return (true, b)
  (false, Block())
