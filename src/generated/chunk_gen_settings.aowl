proc fromDimension*(dim: Dimension): GenerationSettings =
  ## `GenerationSettings::from_dimension`.
  if dim == dimension.OVERWORLD:
    OVERWORLD
  elif dim == dimension.THE_NETHER:
    NETHER
  else:
    END
