proc verticalCellBlockCount*(self: GenerationShapeConfig): uint8 {.inline.} =
  self.sizeVertical shl 2

proc horizontalCellBlockCount*(self: GenerationShapeConfig): uint8 {.inline.} =
  self.sizeHorizontal shl 2

proc maxY*(self: GenerationShapeConfig): uint16 =
  if self.minY >= 0'i8:
    self.height + uint16(self.minY)
  else:
    uint16(int32(self.height) + int32(self.minY))

proc unsignedAbs(v: int8): uint16 {.inline.} =
  uint16(if v < 0'i8: -int32(v) else: int32(v))

proc trimHeight*(self: GenerationShapeConfig; bottomY: int8; topY: uint16): GenerationShapeConfig =
  let newMin = max(self.minY, bottomY)
  let thisTop = if self.minY >= 0'i8: self.height + uint16(self.minY)
                else: self.height - unsignedAbs(self.minY)
  let newTop = min(thisTop, topY)
  let newHeight = if newMin >= 0'i8: newTop - uint16(newMin)
                  else: newTop + unsignedAbs(newMin)
  GenerationShapeConfig(minY: newMin, height: newHeight, sizeHorizontal: self.sizeHorizontal,
    sizeVertical: self.sizeVertical)

proc readYOffset(s: string; pos: var int): YOffset =
  let tag = s[pos]
  inc pos
  let v = fieldInt(s, pos, '|')
  case tag
  of 'a': YOffset(kind: yokAbsolute, absolute: int16(v))
  of 'b': YOffset(kind: yokAboveBottom, aboveBottom: int8(v))
  else: YOffset(kind: yokBelowTop, belowTop: int8(v))

proc decodeRules(s: string): seq[MaterialRule] =
  result = @[]
  var pos = 0
  while pos < s.len:
    let tag = s[pos]
    inc pos
    if pos < s.len and s[pos] == '|': inc pos
    case tag
    of 'B':
      result.add(MaterialRule(kind: mrBlock,
        resultState: newBlockStateIdUnchecked(uint16(fieldInt(s, pos, '|')))))
    of 'S':
      var children: seq[int32] = @[]
      while pos < s.len and s[pos] != '\n':
        children.add(int32(fieldInt(s, pos, ',')))
        if s[pos] == ',': inc pos
      result.add(MaterialRule(kind: mrSequence, sequence: children))
    of 'C':
      let cond = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      let then = int32(fieldInt(s, pos, '|'))
      result.add(MaterialRule(kind: mrCondition, ifTrue: cond, thenRun: then))
    else:
      result.add(MaterialRule(kind: mrBadlands))
    skipSep(s, pos)

proc decodeConditions(s: string): seq[MaterialCondition] =
  result = @[]
  var pos = 0
  while pos < s.len:
    let tag = s[pos]
    inc pos
    if pos < s.len and s[pos] == '|': inc pos
    var c = MaterialCondition()
    case tag
    of 'b':
      c.kind = mcBiome
      c.biomeIs = @[]
      while pos < s.len and s[pos] != '\n':
        c.biomeIs.add(uint8(fieldInt(s, pos, ',')))
        if s[pos] == ',': inc pos
    of 'n':
      c.kind = mcNoiseThreshold
      c.noise = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.minThreshold = fieldF64Bits(s, pos, '|'); skipSep(s, pos)
      c.maxThreshold = fieldF64Bits(s, pos, '|')
    of 'v':
      c.kind = mcVerticalGradient
      c.randomLo = fieldHexU64(s, pos, '|'); skipSep(s, pos)
      c.randomHi = fieldHexU64(s, pos, '|'); skipSep(s, pos)
      c.trueAtAndBelow = readYOffset(s, pos); skipSep(s, pos)
      c.falseAtAndAbove = readYOffset(s, pos)
    of 'y':
      c.kind = mcYAbove
      c.anchor = readYOffset(s, pos); skipSep(s, pos)
      c.surfaceDepthMultiplier = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.addStoneDepth = s[pos] == '1'
      inc pos
    of 'w':
      c.kind = mcWater
      c.offset = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.surfaceDepthMultiplier = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.addStoneDepth = s[pos] == '1'
      inc pos
    of 'T': c.kind = mcTemperature
    of 's': c.kind = mcSteep
    of 'N':
      c.kind = mcNot
      c.invert = int32(fieldInt(s, pos, '|'))
    of 'h': c.kind = mcHole
    of 'p': c.kind = mcAbovePreliminarySurface
    else:
      c.kind = mcStoneDepth
      c.offset = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.addSurfaceDepth = s[pos] == '1'
      pos += 2
      c.secondaryDepthRange = int32(fieldInt(s, pos, '|')); skipSep(s, pos)
      c.surfaceType = if s[pos] == 'c': vstCeiling else: vstFloor
      inc pos
    result.add(c)
    skipSep(s, pos)

