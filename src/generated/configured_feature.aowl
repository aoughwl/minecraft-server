proc fromName*(T: typedesc[ConfiguredFeature]; name: string): (bool, ConfiguredFeature) =
  ## Takes the name with or without `minecraft:`. Names are sorted, as the variants are.
  var key = name
  if key.len > 10 and key[0 .. 9] == "minecraft:":
    key = key[10 .. ^1]
  var lo = 0
  var hi = ConfiguredFeatureNames.len - 1
  while lo <= hi:
    let mid = (lo + hi) div 2
    if ConfiguredFeatureNames[mid] == key:
      return (true, ConfiguredFeature(mid))
    if ConfiguredFeatureNames[mid] < key:
      lo = mid + 1
    else:
      hi = mid - 1
  (false, ConfiguredFeature(0))

proc toName*(self: ConfiguredFeature): string =
  ## The bare name.
  ConfiguredFeatureNames[ord(self)]
