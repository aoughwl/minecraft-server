    ## Upstream's `data_component_impl::Operation`, which is not ported yet.
    AddValue, AddMultipliedBase, AddMultipliedTotal

  Modifiers* = object
    attribute*: Attribute
    id*: string
    baseValue*: float64
    operation*: Operation

  StatusEffect* = object
    minecraftName*: string
    id*: uint8
    category*: MobEffectCategory
    color*: int32
    translationKey*: string
    attributeModifiers*: seq[Modifiers]

proc `==`*(a, b: StatusEffect): bool = a.id == b.id
proc hash*(a: StatusEffect): Hash = hash(a.id)

