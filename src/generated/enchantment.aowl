proc canEnchant*(self: Enchantment; itemId: uint16; contains: TagContains): bool =
  contains(self.supportedItems, itemId)

proc areCompatible*(self, other: Enchantment; contains: TagContains): bool =
  if self == other:
    return false
  if self.exclusiveSet.isSome and contains(self.exclusiveSet.get, uint16(other.id)):
    return false
  if other.exclusiveSet.isSome and contains(other.exclusiveSet.get, uint16(self.id)):
    return false
  true

proc isEnchantmentCompatible*(self: Enchantment; others: seq[Enchantment]; contains: TagContains): bool =
  ## `other: &EnchantmentsImpl`, passed as its enchantments.
  for other in others:
    if not self.areCompatible(other, contains):
      return false
  true

proc getFullname*(self: Enchantment; level: int32; isCurse: bool): TextComponent =
  ## `is_curse` is upstream's `self.has_tag(&EnchantmentTag::MINECRAFT_CURSE)`.
  result = translate(self.description).colorNamed(if isCurse: ncRed else: ncGray)
  if level != 1'i32 or self.maxLevel != 1'i32:
    result = result.addText(" ").addChild(translate("enchantment.level." & $level))
