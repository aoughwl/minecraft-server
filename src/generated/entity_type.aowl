\":[{\"name\":\"minecraft:iron_ingot\",\"type\":\"minecraft:item\"},{\"name\":\"minecraft:carrot\",\"type\":\"minecraft:item\"},{\"name\":\"minecraft:potato\",\"functions\":[{\"conditions\":[{\"terms\":[{\"predicate\":{\"minecraft:flags\":{\"is_on_fire\":true}},\"entity\":\"this\",\"condition\":\"minecraft:entity_properties\"},{\"predicate\":{\"minecraft:equipment\":{\"mainhand\":{\"predicates\":{\"minecraft:enchantments\":[{\"enchantments\":\"#minecraft:smelts_loot\"}]}}}},\"entity\":\"direct_attacker\",\"condition\":\"minecraft:entity_properties\"}],\"condition\":\"minecraft:any_of\"}],\"function\":\"minecraft:furnace_smelt\"}],\"type\":\"minecraft:item\"}],\"conditions\":[{\"condition\":\"minecraft:killed_by_player\"},{\"unenchanted_chance\":0.025,\"enchanted_chance\":{\"base\":0.035,\"per_level_above_first\":0.01,\"type\":\"minecraft:linear\"},\"enchantment\":\"minecraft:looting\",\"condition\":\"minecraft:random_chance_with_enchanted_bonus\"}],\"rolls\":1.0}]}{\"type\":\"minecraft:entity\",\"random_sequence\":\"minecraft:entities/zombified_piglin\",\"pools\":[{\"entries\":[{\"name\":\"minecraft:rotten_flesh\",\"functions\":[{\"count\":{\"min\":0.0,\"max\":1.0,\"type\":\"minecraft:uniform\"},\"function\":\"minecraft:set_count\"},{\"enchantment\":\"minecraft:looting\",\"count\":{\"min\":0.0,\"max\":1.0,\"type\":\"minecraft:uniform\"},\"function\":\"minecraft:enchanted_count_increase\"}],\"type\":\"minecraft:item\"}],\"rolls\":1.0},{\"entries\":[{\"name\":\"minecraft:gold_nugget\",\"functions\":[{\"count\":{\"min\":0.0,\"max\":1.0,\"type\":\"minecraft:uniform\"},\"function\":\"minecraft:set_count\"},{\"enchantment\":\"minecraft:looting\",\"count\":{\"min\":0.0,\"max\":1.0,\"type\":\"minecraft:uniform\"},\"function\":\"minecraft:enchanted_count_increase\"}],\"type\":\"minecraft:item\"}],\"rolls\":1.0},{\"entries\":[{\"name\":\"minecraft:gold_ingot\",\"type\":\"minecraft:item\"}],\"conditions\":[{\"condition\":\"minecraft:killed_by_player\"},{\"unenchanted_chance\":0.025,\"enchanted_chance\":{\"base\":0.035,\"per_level_above_first\":0.01,\"type\":\"minecraft:linear\"},\"enchantment\":\"minecraft:looting\",\"condition\":\"minecraft:random_chance_with_enchanted_bonus\"}],\"rolls\":1.0}]}"

type
  SpawnLocation* {.pure.} = enum
    InLava, InWater, OnGround, Unrestricted

  SpawnRestriction* = object
    location*: SpawnLocation
    heightmap*: HeightMap

  MobCategory* = object
    id*: int
    max*: int32
    isFriendly*: bool
    isPersistent*: bool
    despawnDistance*: int32

  EntityAttribute* = object
    attribute*: Attribute
    value*: float64

  EntityType* = object
    id*: uint16
    name*: string
    resourceName*: string
    attributes*: seq[EntityAttribute]
    experienceReward*: uint32
    hurtSound*: string
    deathSound*: string
    attackableKnown*: bool
    attackable*: bool
    mob*: bool
    saveable*: bool
    limitPerChunk*: int32
    summonable*: bool
    fireImmune*: bool
    category*: MobCategory
    canSpawnFarFromPlayer*: bool
    dimension*: array[2, float32]
    dimensionW*: float32
    dimensionH*: float32
    eyeHeight*: float32
    spawnRestriction*: SpawnRestriction
    trackDeltas*: bool
    clientTrackingRange*: uint32
    updateInterval*: uint32
    spawnDimensionsScale*: float32
    lootStart: int
    lootStop: int

proc `==`*(a, b: EntityType): bool = a.id == b.id
proc hash*(a: EntityType): Hash = hash(a.id)
proc `==`*(a, b: MobCategory): bool = a.id == b.id
proc registryKey*(self: EntityType): string = self.resourceName
proc registryId*(self: EntityType): uint16 = self.id

const NO_DESPAWN_DISTANCE* = 32'i32

template MONSTER*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 0, max: 70'i32, isFriendly: false, isPersistent: false, despawnDistance: 128'i32)
template CREATURE*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 1, max: 10'i32, isFriendly: true, isPersistent: true, despawnDistance: 128'i32)
template AMBIENT*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 2, max: 15'i32, isFriendly: true, isPersistent: false, despawnDistance: 128'i32)
template AXOLOTLS*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 3, max: 5'i32, isFriendly: true, isPersistent: false, despawnDistance: 128'i32)
template UNDERGROUND_WATER_CREATURE*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 4, max: 5'i32, isFriendly: true, isPersistent: false, despawnDistance: 128'i32)
template WATER_CREATURE*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 5, max: 5'i32, isFriendly: true, isPersistent: true, despawnDistance: 128'i32)
template WATER_AMBIENT*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 6, max: 20'i32, isFriendly: true, isPersistent: false, despawnDistance: 64'i32)
template MISC*(T: typedesc[MobCategory]): MobCategory = MobCategory(id: 7, max: -1'i32, isFriendly: true, isPersistent: true, despawnDistance: 128'i32)

proc spawningCategories*(): seq[MobCategory] =
  ## `MobCategory::SPAWNING_CATEGORIES`.
  @[MobCategory.MONSTER, MobCategory.CREATURE, MobCategory.AMBIENT, MobCategory.AXOLOTLS,
    MobCategory.UNDERGROUND_WATER_CREATURE, MobCategory.WATER_CREATURE, MobCategory.WATER_AMBIENT, MobCategory.MISC]

proc categoryOf(s: string): MobCategory =
  case s
  of "MONSTER": MobCategory.MONSTER
  of "CREATURE": MobCategory.CREATURE
  of "AMBIENT": MobCategory.AMBIENT
  of "AXOLOTLS": MobCategory.AXOLOTLS
  of "UNDERGROUND_WATER_CREATURE": MobCategory.UNDERGROUND_WATER_CREATURE
  of "WATER_CREATURE": MobCategory.WATER_CREATURE
  of "WATER_AMBIENT": MobCategory.WATER_AMBIENT
  of "MISC": MobCategory.MISC
  else:
    genPanic("entity_type: unknown category " & s)
    MobCategory.MISC

proc locationOf(s: string): SpawnLocation =
  case s
  of "IN_LAVA": SpawnLocation.InLava
  of "IN_WATER": SpawnLocation.InWater
  of "ON_GROUND": SpawnLocation.OnGround
  of "NO_RESTRICTIONS", "UNRESTRICTED": SpawnLocation.Unrestricted
  else:
    genPanic("entity_type: unknown spawn location " & s)
    SpawnLocation.Unrestricted

proc heightmapOf(s: string): HeightMap =
  case s
  of "WORLD_SURFACE_WG": WorldSurfaceWg
  of "WORLD_SURFACE": WorldSurface
  of "OCEAN_FLOOR_WG": OceanFloorWg
  of "OCEAN_FLOOR": OceanFloor
  of "MOTION_BLOCKING": MotionBlocking
  of "MOTION_BLOCKING_NO_LEAVES": MotionBlockingNoLeaves
  else:
    genPanic("entity_type: unknown heightmap " & s)
    WorldSurface

proc attributeIndex(): Table[string, Attribute] =
  result = initTable[string, Attribute]()
  let all = allAttributes()
  for i in 0 ..< all.len:
    result[all[i].name] = all[i]

proc parseAttributes(text: string; index: Table[string, Attribute]): seq[EntityAttribute] =
  result = @[]
  var pos = 0
  while not atEnd(text, pos):
    let key = fieldStr(text, pos, '=')
    skipSep(text, pos)
    let value = fieldFloat(text, pos, ';')
    skipSep(text, pos)
    let attr = index.getOrDefault("minecraft:" & key, Attribute(id: 0'u8, defaultValue: 0.0, name: ""))
    if attr.name.len == 0: genPanic("entity_type: unknown attribute " & key)
    result.add(EntityAttribute(attribute: attr, value: value))

proc loadEntityTypes(): seq[EntityType] =
  result = @[]
  let index = attributeIndex()
  let s = EntityRows
  var pos = 0
  template str(): string =
    let v = fieldStr(s, pos, '\t')
    skipSep(s, pos)
    v
  template num(): int =
    let v = fieldInt(s, pos, '\t')
    skipSep(s, pos)
    v
  template flag(): bool = num() != 0
  template real(): float =
    let v = fieldFloat(s, pos, '\t')
    skipSep(s, pos)
    v
  while not atEnd(s, pos):
    let name = str()
    let id = num()
    let reward = num()
    let hurt = str()
    let death = str()
    let attackableText = str()
    let mob = flag()
    let saveable = flag()
    let limit = num()
    let summonable = flag()
    let fireImmune = flag()
    let category = str()
    let farSpawn = flag()
    let dimW = real()
    let dimH = real()
    let eye = real()
    let location = str()
    let heightmap = str()
    let track = flag()
    let trackingRange = num()
    let interval = num()
    let scale = real()
    let attrs = str()
    let lootStart = num()
    let lootStop = num()
    result.add(EntityType(id: uint16(id), name: name, resourceName: name,
      attributes: parseAttributes(attrs, index), experienceReward: uint32(reward),
      hurtSound: hurt, deathSound: death, attackableKnown: attackableText != "-",
      attackable: attackableText == "1", mob: mob, saveable: saveable, limitPerChunk: int32(limit),
      summonable: summonable, fireImmune: fireImmune, category: categoryOf(category),
      canSpawnFarFromPlayer: farSpawn, dimension: [float32(dimW), float32(dimH)],
      dimensionW: float32(dimW), dimensionH: float32(dimH), eyeHeight: float32(eye),
      spawnRestriction: SpawnRestriction(location: locationOf(location), heightmap: heightmapOf(heightmap)),
      trackDeltas: track, clientTrackingRange: uint32(trackingRange), updateInterval: uint32(interval),
      spawnDimensionsScale: float32(scale), lootStart: lootStart, lootStop: lootStop))

let gEntityTypes*: seq[EntityType] = loadEntityTypes()

proc buildNames(): Table[string, int] =
  result = initTable[string, int]()
  for i, e in gEntityTypes:
    result[e.name] = i

proc buildIds(): Table[uint16, int] =
  result = initTable[uint16, int]()
  for i, e in gEntityTypes:
    result[e.id] = i

let gEntityNames: Table[string, int] = buildNames()
let gEntityIds: Table[uint16, int] = buildIds()
var gEntityLoot: seq[nil LootTableRef] = newSeq[nil LootTableRef](gEntityTypes.len)

proc allEntityTypes*(): seq[EntityType] = gEntityTypes

proc fromRaw*(T: typedesc[EntityType]; id: uint16): Option[EntityType] =
  let i = gEntityIds.getOrDefault(id, -1)
  if i < 0: none[EntityType]() else: some(gEntityTypes[i])

proc fromName*(T: typedesc[EntityType]; name: string): Option[EntityType] =
  ## With or without the `minecraft:` prefix.
  var key = name
  if key.len > 10 and substr(key, 0, 9) == "minecraft:":
    key = substr(key, 10, key.len - 1)
  let i = gEntityNames.getOrDefault(key, -1)
  if i < 0: none[EntityType]() else: some(gEntityTypes[i])

proc entityTypeByName*(name: string): (bool, EntityType) =
  ## Older spelling of `EntityType.fromName`; the result is meaningful only with `true`.
  let i = gEntityNames.getOrDefault(name, -1)
  if i < 0: (false, gEntityTypes[0]) else: (true, gEntityTypes[i])

proc lootTable*(self: EntityType): nil LootTableRef =
  ## `self.loot_table`, nil where upstream has `None`.
  if self.lootStart < 0: return nil
  let i = gEntityNames.getOrDefault(self.name, -1)
  if gEntityLoot[i] == nil:
    gEntityLoot[i] = decodeLootTableText(substr(EntityLootJson, self.lootStart, self.lootStop - 1))
  gEntityLoot[i]

