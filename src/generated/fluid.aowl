template EMPTY*(T: typedesc[Fluid]): Fluid = gFluids[0]
template FLOWING_WATER*(T: typedesc[Fluid]): Fluid = gFluids[1]
template WATER*(T: typedesc[Fluid]): Fluid = gFluids[2]
template FLOWING_LAVA*(T: typedesc[Fluid]): Fluid = gFluids[3]
template LAVA*(T: typedesc[Fluid]): Fluid = gFluids[4]

proc fromRegistryKey*(T: typedesc[Fluid]; name: string): Option[Fluid] =
  case name
  of "empty": some(gFluids[0])
  of "flowing_water": some(gFluids[1])
  of "water": some(gFluids[2])
  of "flowing_lava": some(gFluids[3])
  of "lava": some(gFluids[4])
  else: none[Fluid]()

proc fromId*(T: typedesc[Fluid]; id: uint16): Option[Fluid] =
  case id
  of 0'u16: some(gFluids[0])
  of 1'u16: some(gFluids[1])
  of 2'u16: some(gFluids[2])
  of 3'u16: some(gFluids[3])
  of 4'u16: some(gFluids[4])
  else: none[Fluid]()

proc fromStateId*(T: typedesc[Fluid]; id: BlockStateId): Option[Fluid] =
  let raw = uint16(id)
  if raw >= 0'u16 and raw <= 0'u16: return some(gFluids[0])
  if raw >= 86'u16 and raw <= 86'u16: return some(gFluids[2])
  if raw >= 102'u16 and raw <= 102'u16: return some(gFluids[4])
  if raw >= 86'u16 and raw <= 101'u16: return some(gFluids[1])
  if raw >= 102'u16 and raw <= 117'u16: return some(gFluids[3])
  none[Fluid]()

proc identToFluidId*(T: typedesc[Fluid]; name: string): Option[uint8] =
  case name
  of "empty": some(0'u8)
  of "flowing_water": some(1'u8)
  of "water": some(2'u8)
  of "flowing_lava": some(3'u8)
  of "lava": some(4'u8)
  else: none[uint8]()

proc getFluid*(registryId: string): Option[Fluid] =
  var key = registryId
  if key.len > 10 and substr(key, 0, 9) == "minecraft:":
    key = substr(key, 10, key.len - 1)
  Fluid.fromRegistryKey(key)

proc fromResourceLocation*(T: typedesc[Fluid]; resourceLocation: string): Option[Fluid] = getFluid(resourceLocation)

proc sameFluidType*(T: typedesc[Fluid]; a, b: uint16): bool =
  a == b or (a == 1'u16 and b == 2'u16) or (a == 2'u16 and b == 1'u16) or
    (a == 3'u16 and b == 4'u16) or (a == 4'u16 and b == 3'u16)

proc matchesType*(self, other: Fluid): bool = Fluid.sameFluidType(self.id, other.id)

proc toFlowing*(self: Fluid): Fluid =
  case self.id
  of 2'u16: Fluid.FLOWING_WATER
  of 4'u16: Fluid.FLOWING_LAVA
  else:
    let f = Fluid.fromId(self.id)
    if f.isSome: f.get else: Fluid.EMPTY

proc stateIndexOf(self: Fluid; stateId: BlockStateId): int =
  int(uint16(stateId)) mod self.states.len

proc isSource*(self: Fluid; stateId: BlockStateId): bool = self.states[self.stateIndexOf(stateId)].isSource
proc isFalling*(self: Fluid; stateId: BlockStateId): bool = self.states[self.stateIndexOf(stateId)].falling
proc getLevel*(self: Fluid; stateId: BlockStateId): int16 = self.states[self.stateIndexOf(stateId)].level
proc getHeight*(self: Fluid; stateId: BlockStateId): float32 = self.states[self.stateIndexOf(stateId)].height

type Falling* {.pure.} = enum
  True, False

proc variantCount*(T: typedesc[Falling]): uint16 = 2'u16
proc toIndex*(self: Falling): uint16 = uint16(ord(self))
proc fromIndex*(T: typedesc[Falling]; index: uint16): Falling =
  case index
  of 0'u16: Falling.True
  of 1'u16: Falling.False
  else:
    genPanic("Invalid index: " & $index)
    Falling.True
proc toValue*(self: Falling): string =
  case self
  of Falling.True: "true"
  of Falling.False: "false"
proc fromValue*(T: typedesc[Falling]; value: string): Falling =
  case value
  of "true": Falling.True
  of "false": Falling.False
  else:
    genPanic("Invalid value: " & value)
    Falling.True

type Level* {.pure.} = enum
  L1, L2, L3, L4, L5, L6, L7, L8

proc variantCount*(T: typedesc[Level]): uint16 = 8'u16
proc toIndex*(self: Level): uint16 = uint16(ord(self))
proc fromIndex*(T: typedesc[Level]; index: uint16): Level =
  case index
  of 0'u16: Level.L1
  of 1'u16: Level.L2
  of 2'u16: Level.L3
  of 3'u16: Level.L4
  of 4'u16: Level.L5
  of 5'u16: Level.L6
  of 6'u16: Level.L7
  of 7'u16: Level.L8
  else:
    genPanic("Invalid index: " & $index)
    Level.L1
proc toValue*(self: Level): string =
  case self
  of Level.L1: "1"
  of Level.L2: "2"
  of Level.L3: "3"
  of Level.L4: "4"
  of Level.L5: "5"
  of Level.L6: "6"
  of Level.L7: "7"
  of Level.L8: "8"
proc fromValue*(T: typedesc[Level]; value: string): Level =
  case value
  of "1": Level.L1
  of "2": Level.L2
  of "3": Level.L3
  of "4": Level.L4
  of "5": Level.L5
  of "6": Level.L6
  of "7": Level.L7
  of "8": Level.L8
  else:
    genPanic("Invalid value: " & value)
    Level.L1

type WaterLikeFluidProperties* = object
  falling*: Falling

proc toIndex*(self: WaterLikeFluidProperties): uint16 =
  var index = 0'u16
  var multiplier = 1'u16
  index += self.falling.toIndex() * multiplier
  multiplier *= Falling.variantCount()
  discard multiplier
  index

proc fromIndex*(T: typedesc[WaterLikeFluidProperties]; index: uint16): WaterLikeFluidProperties =
  var rest = index
  let fallingIndex = rest mod Falling.variantCount()
  rest = rest div Falling.variantCount()
  discard rest
  WaterLikeFluidProperties(falling: Falling.fromIndex(fallingIndex))

proc toStateId*(self: WaterLikeFluidProperties; fluid: Fluid): BlockStateId =
  if fluid.name notin @["water", "lava"]:
    genPanic(fluid.name & " is not a valid fluid for WaterLikeFluidProperties")
  let propIndex = self.toIndex()
  if propIndex < uint16(fluid.states.len):
    fluid.states[int(propIndex)].blockStateId
  else:
    fluid.states[int(fluid.defaultStateIndex)].blockStateId

proc fromStateId*(T: typedesc[WaterLikeFluidProperties]; id: BlockStateId; fluid: Fluid): WaterLikeFluidProperties =
  if fluid.name notin @["water", "lava"]:
    genPanic(fluid.name & " is not a valid fluid for WaterLikeFluidProperties")
  for idx, state in fluid.states:
    if state.blockStateId == id:
      return WaterLikeFluidProperties.fromIndex(uint16(idx))
  WaterLikeFluidProperties.fromIndex(fluid.defaultStateIndex)

proc default*(T: typedesc[WaterLikeFluidProperties]; fluid: Fluid): WaterLikeFluidProperties =
  if fluid.name notin @["water", "lava"]:
    genPanic(fluid.name & " is not a valid fluid for WaterLikeFluidProperties")
  WaterLikeFluidProperties.fromIndex(fluid.defaultStateIndex)

proc toProps*(self: WaterLikeFluidProperties): seq[(string, string)] =
  @[("falling", self.falling.toValue())]

proc fromProps*(T: typedesc[WaterLikeFluidProperties]; props: seq[(string, string)]; fluid: Fluid): WaterLikeFluidProperties =
  if fluid.name notin @["water", "lava"]:
    genPanic(fluid.name & " is not a valid fluid for WaterLikeFluidProperties")
  result = WaterLikeFluidProperties.default(fluid)
  for i in 0 ..< props.len:
    let key = props[i][0]
    let value = props[i][1]
    case key
    of "falling": result.falling = Falling.fromValue(value)
    else: genPanic("Invalid key: " & key)

proc boxed(self: WaterLikeFluidProperties): FluidPropertiesRef =
  let s = self
  FluidPropertiesRef(
    toIndex: proc(): uint16 {.closure.} = s.toIndex(),
    toStateId: proc(fluid: Fluid): BlockStateId {.closure.} = s.toStateId(fluid),
    toProps: proc(): seq[(string, string)] {.closure.} = s.toProps())

type FlowingWaterLikeFluidProperties* = object
  falling*: Falling
  level*: Level

proc toIndex*(self: FlowingWaterLikeFluidProperties): uint16 =
  var index = 0'u16
  var multiplier = 1'u16
  index += self.level.toIndex() * multiplier
  multiplier *= Level.variantCount()
  index += self.falling.toIndex() * multiplier
  multiplier *= Falling.variantCount()
  discard multiplier
  index

proc fromIndex*(T: typedesc[FlowingWaterLikeFluidProperties]; index: uint16): FlowingWaterLikeFluidProperties =
  var rest = index
  let levelIndex = rest mod Level.variantCount()
  rest = rest div Level.variantCount()
  let fallingIndex = rest mod Falling.variantCount()
  rest = rest div Falling.variantCount()
  discard rest
  FlowingWaterLikeFluidProperties(falling: Falling.fromIndex(fallingIndex), level: Level.fromIndex(levelIndex))

proc toStateId*(self: FlowingWaterLikeFluidProperties; fluid: Fluid): BlockStateId =
  if fluid.name notin @["flowing_water", "flowing_lava"]:
    genPanic(fluid.name & " is not a valid fluid for FlowingWaterLikeFluidProperties")
  let propIndex = self.toIndex()
  if propIndex < uint16(fluid.states.len):
    fluid.states[int(propIndex)].blockStateId
  else:
    fluid.states[int(fluid.defaultStateIndex)].blockStateId

proc fromStateId*(T: typedesc[FlowingWaterLikeFluidProperties]; id: BlockStateId; fluid: Fluid): FlowingWaterLikeFluidProperties =
  if fluid.name notin @["flowing_water", "flowing_lava"]:
    genPanic(fluid.name & " is not a valid fluid for FlowingWaterLikeFluidProperties")
  for idx, state in fluid.states:
    if state.blockStateId == id:
      return FlowingWaterLikeFluidProperties.fromIndex(uint16(idx))
  FlowingWaterLikeFluidProperties.fromIndex(fluid.defaultStateIndex)

proc default*(T: typedesc[FlowingWaterLikeFluidProperties]; fluid: Fluid): FlowingWaterLikeFluidProperties =
  if fluid.name notin @["flowing_water", "flowing_lava"]:
    genPanic(fluid.name & " is not a valid fluid for FlowingWaterLikeFluidProperties")
  FlowingWaterLikeFluidProperties.fromIndex(fluid.defaultStateIndex)

proc toProps*(self: FlowingWaterLikeFluidProperties): seq[(string, string)] =
  @[("falling", self.falling.toValue()), ("level", self.level.toValue())]

proc fromProps*(T: typedesc[FlowingWaterLikeFluidProperties]; props: seq[(string, string)]; fluid: Fluid): FlowingWaterLikeFluidProperties =
  if fluid.name notin @["flowing_water", "flowing_lava"]:
    genPanic(fluid.name & " is not a valid fluid for FlowingWaterLikeFluidProperties")
  result = FlowingWaterLikeFluidProperties.default(fluid)
  for i in 0 ..< props.len:
    let key = props[i][0]
    let value = props[i][1]
    case key
    of "falling": result.falling = Falling.fromValue(value)
    of "level": result.level = Level.fromValue(value)
    else: genPanic("Invalid key: " & key)

proc boxed(self: FlowingWaterLikeFluidProperties): FluidPropertiesRef =
  let s = self
  FluidPropertiesRef(
    toIndex: proc(): uint16 {.closure.} = s.toIndex(),
    toStateId: proc(fluid: Fluid): BlockStateId {.closure.} = s.toStateId(fluid),
    toProps: proc(): seq[(string, string)] {.closure.} = s.toProps())

proc propertiesOf*(self: Fluid; id: BlockStateId): FluidPropertiesRef =
  ## Upstream's `Fluid::properties`.
  case self.name
  of "water": boxed(WaterLikeFluidProperties.fromStateId(id, Fluid.WATER))
  of "lava": boxed(WaterLikeFluidProperties.fromStateId(id, Fluid.LAVA))
  of "flowing_water": boxed(FlowingWaterLikeFluidProperties.fromStateId(id, Fluid.FLOWING_WATER))
  of "flowing_lava": boxed(FlowingWaterLikeFluidProperties.fromStateId(id, Fluid.FLOWING_LAVA))
  else:
    genPanic("Invalid state_id")
    FluidPropertiesRef()

proc fromProperties*(self: Fluid; props: seq[(string, string)]): FluidPropertiesRef =
  case self.name
  of "water": boxed(WaterLikeFluidProperties.fromProps(props, Fluid.WATER))
  of "lava": boxed(WaterLikeFluidProperties.fromProps(props, Fluid.LAVA))
  of "flowing_water": boxed(FlowingWaterLikeFluidProperties.fromProps(props, Fluid.FLOWING_WATER))
  of "flowing_lava": boxed(FlowingWaterLikeFluidProperties.fromProps(props, Fluid.FLOWING_LAVA))
  else:
    genPanic("Invalid props")
    FluidPropertiesRef()
