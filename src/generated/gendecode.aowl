## Load-time decoders for the compact tables in src/generated.
##
## Hand-written, unlike its neighbours. Upstream's generated Rust is static data;
## a seq-of-objects literal of that size would make aowlmony compile times
## unusable, so generators emit one string constant per table and the module
## decodes it when loaded. See src/data_codegen/codegenutil.aowl for the writers.

import std/[parseutils, syncio]

proc genPanic*(msg: string) =
  ## Upstream's `panic!` for a caller's programming error, such as asking a
  ## property struct about a block it does not cover. Not for I/O failures.
  echo "panic: " & msg
  quit(1)

proc hexDigit(c: char): int {.inline.} =
  if c >= 'a': ord(c) - ord('a') + 10 else: ord(c) - ord('0')

proc hexU16At*(s: string, cell: int): uint16 {.inline.} =
  ## Cell `cell` of a hex-packed u16 table, read without unpacking it.
  let i = cell * 4
  uint16((hexDigit(s[i]) shl 12) or (hexDigit(s[i + 1]) shl 8) or
         (hexDigit(s[i + 2]) shl 4) or hexDigit(s[i + 3]))

proc hexU16Seq*(s: string): seq[uint16] =
  ## Unpacks a whole hex-packed u16 table.
  let n = s.len div 4
  result = newSeq[uint16](n)
  for i in 0 ..< n:
    result[i] = hexU16At(s, i)

proc atEnd*(s: string, pos: int): bool {.inline.} = pos >= s.len

proc skipSep*(s: string, pos: var int) {.inline.} =
  ## Steps over the separator a field reader stopped on.
  if pos < s.len: inc pos

proc fieldStr*(s: string, pos: var int, sep: char, lineEnd = '\n'): string =
  ## Text up to `sep` or `lineEnd`, leaving `pos` on that separator.
  let start = pos
  while pos < s.len and s[pos] != sep and s[pos] != lineEnd:
    inc pos
  result = substr(s, start, pos - 1)

proc fieldInt*(s: string, pos: var int, sep: char, lineEnd = '\n'): int =
  ## Decimal integer up to `sep` or `lineEnd`; an empty field reads as 0.
  var neg = false
  if pos < s.len and s[pos] == '-':
    neg = true
    inc pos
  result = 0
  while pos < s.len and s[pos] != sep and s[pos] != lineEnd:
    result = result * 10 + (ord(s[pos]) - ord('0'))
    inc pos
  if neg: result = -result

proc fieldFloat*(s: string, pos: var int, sep: char, lineEnd = '\n'): float =
  ## Decimal float up to `sep` or `lineEnd`; an empty field reads as 0.
  let text = fieldStr(s, pos, sep, lineEnd)
  result = 0.0
  discard parseBiggestFloat(text, result)

proc intList*(s: string, sep: char): seq[uint16] =
  ## `1.2.3` into its values; empty input is an empty list.
  result = @[]
  var pos = 0
  while pos < s.len:
    result.add(uint16(fieldInt(s, pos, sep)))
    skipSep(s, pos)

proc fieldHexU64*(s: string, pos: var int, sep: char, lineEnd = '\n'): uint64 =
  ## Lowercase hex up to `sep` or `lineEnd`; an empty field reads as 0.
  result = 0'u64
  while pos < s.len and s[pos] != sep and s[pos] != lineEnd:
    result = (result shl 4) or uint64(hexDigit(s[pos]))
    inc pos

proc fieldF64Bits*(s: string, pos: var int, sep: char, lineEnd = '\n'): float64 =
  ## A float64 written by its bits, so decoding never rounds.
  cast[float64](fieldHexU64(s, pos, sep, lineEnd))

proc fieldF32Bits*(s: string, pos: var int, sep: char, lineEnd = '\n'): float32 =
  ## A float32 written by its bits.
  cast[float32](uint32(fieldHexU64(s, pos, sep, lineEnd)))
