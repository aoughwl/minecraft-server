proc loadItems(): seq[Item] =
  result = @[]
  var pos = 0
  while pos < ItemTable.len:
    let name = fieldStr(ItemTable, pos, '\t')
    skipSep(ItemTable, pos)
    let stack = fieldInt(ItemTable, pos, '\t')
    skipSep(ItemTable, pos)
    result.add(Item(id: result.len, name: name, maxStackSize: stack))

let AllItems*: seq[Item] = loadItems()

proc itemById*(id: int): (bool, Item) =
  for it in AllItems:
    if it.id == id: return (true, it)
  (false, Item())

proc itemByName*(name: string): (bool, Item) =
  for it in AllItems:
    if it.name == name: return (true, it)
  (false, Item())
