let gItems*: seq[Item] = decodeItems(ItemData)
  ## Every item, indexed by id.

let gItemsByName = indexItems(gItems)

proc fromRegistryKey*(_: typedesc[Item]; name: string): nil Item =
  ## Try to parse an item from a resource location string.
  lookupItem(gItems, gItemsByName, name)

proc fromId*(_: typedesc[Item]; id: uint16): nil Item =
  ## Try to parse an item from a raw id.
  if int(id) >= gItems.len:
    return nil
  return gItems[int(id)]

