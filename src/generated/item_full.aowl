let gBedrockTables = decodeBedrockMappings(BedrockMappingData, ALL_BEDROCK_ITEMS, gItems)

proc bedrockItemByKey*(key: string): nil BedrockItem =
  ## `BedrockItem::X` by its registry key, such as `minecraft:stick`.
  lookupBedrockItem(gBedrockTables, ALL_BEDROCK_ITEMS, key)

proc fromJavaItemId*(_: typedesc[JavaToBedrockItemMapping]; itemId: uint16): nil JavaToBedrockItemMapping =
  mappingFromJava(gBedrockTables, itemId)

proc fromBedrock*(_: typedesc[JavaToBedrockItemMapping]; bedrockId: int16; bedrockData: uint32): nil JavaToBedrockItemMapping =
  mappingFromBedrock(gBedrockTables, bedrockId, bedrockData)
