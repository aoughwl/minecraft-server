## Known answers read from upstream's pumpkin-data/src/generated/item.rs, one or more items for each component
## kind that carries data. Every item's every value was also compared to that file by a script in the
## scratchpad; this keeps a sample of it in the tree. Ids are 26.2's, as upstream's.

import std/[assertions, syncio]
import item_full
import entity_type

proc comp(name: string; id: DataComponent): DataComponentImpl =
  let item = fromRegistryKey(Item, name)
  if item != nil:
    for c in item.components:
      if c.kind == id:
        return c
  echo "no " & toName(id) & " on " & name
  quit(1)
  DataComponentImpl(kind: dcLore)

proc hasComp(name: string; id: DataComponent): bool =
  let item = fromRegistryKey(Item, name)
  if item != nil:
    for c in item.components:
      if c.kind == id:
        return true
  false

proc idOf(item: nil Item): int =
  if item == nil: -1 else: int(item.id)

block table:
  assert ITEM_COUNT == 1537
  assert gItems.len == 1537
  for i, item in gItems:
    assert int(item.id) == i
  assert ITEM_AIR.id == 0'u16
  assert ITEM_IRON_SWORD.id == 959'u16
  assert ITEM_IRON_SWORD.registryKey == "iron_sword"
  assert ITEM_OMINOUS_BOTTLE.id == 1536'u16
  assert idOf(fromRegistryKey(Item, "minecraft:iron_sword")) == 959
  assert idOf(fromRegistryKey(Item, "iron_sword")) == 959
  assert fromRegistryKey(Item, "minecraft:not_an_item") == nil
  assert idOf(fromId(Item, 959'u16)) == 959
  assert fromId(Item, 1537'u16) == nil
  assert translatedName(ITEM_IRON_SWORD) == translate("item.minecraft.iron_sword")
  assert translatedName(ITEM_STONE) == translate("block.minecraft.stone")

block upstreamComponentOrder:
  # `ItemComponents::to_tokens`' order.
  let c = ITEM_IRON_SWORD.components
  assert c[0].kind == dcMaxStackSize
  assert c[1].kind == dcItemName
  assert c[2].kind == dcDamage
  assert c[3].kind == dcMaxDamage
  assert c[4].kind == dcAttributeModifiers
  assert c[5].kind == dcTool
  assert c[6].kind == dcWeapon
  assert c[7].kind == dcEnchantable

block ironSword:
  assert comp("iron_sword", dcMaxStackSize).maxStackSize.size == 1'u8
  assert comp("iron_sword", dcItemName).itemName.name == "item.minecraft.iron_sword"
  assert comp("iron_sword", dcDamage).damage.damage == 0'i32
  assert comp("iron_sword", dcMaxDamage).maxDamage.maxDamage == 250'i32
  assert comp("iron_sword", dcItemModel).itemModel.id == "minecraft:iron_sword"
  assert comp("iron_sword", dcWeapon).weapon.itemDamagePerAttack == 1'u32
  assert comp("iron_sword", dcEnchantable).enchantable.value == 14'i32
  let mods = comp("iron_sword", dcAttributeModifiers).attributeModifiers.attributeModifiers
  assert mods.len == 2
  assert mods[0].attribute.name == "minecraft:attack_damage"
  assert mods[0].id == "minecraft:base_attack_damage"
  assert mods[0].amount == 5.0'f64
  assert mods[0].operation == opAddValue
  assert mods[0].slot == amsMainHand
  assert mods[1].attribute.name == "minecraft:attack_speed"
  assert mods[1].amount == -2.4000000953674316'f64
  let tool = comp("iron_sword", dcTool).tool
  assert tool.defaultMiningSpeed == 1.0'f32
  assert tool.damagePerBlock == 2'u32
  assert not tool.canDestroyBlocksInCreative
  assert tool.rules.len == 3
  assert tool.rules[0].blocks.kind == idsIds
  assert tool.rules[0].speed.unsafeGet == 15.0'f32
  assert tool.rules[0].correctForDrops.unsafeGet
  assert tool.rules[1].blocks.tag == "minecraft:sword_instantly_mines"
  assert tool.rules[1].speed.unsafeGet == 3.4028235e+38'f32
  assert tool.rules[1].correctForDrops.isNone
  assert tool.rules[2].blocks.tag == "minecraft:sword_efficient"
  assert tool.rules[2].speed.unsafeGet == 1.5'f32
  # A tool with no rules at all.
  assert comp("trident", dcTool).tool.rules.len == 0

block goldenApple:
  let food = comp("golden_apple", dcFood).food
  assert food.nutrition == 4'i32
  assert food.saturation == 9.6'f32
  assert food.canAlwaysEat
  let c = comp("golden_apple", dcConsumable).consumable
  assert c.consumeSeconds == 1.6'f32
  assert c.animation == caEat
  assert c.soundEvent == idOrSound(sdEntityGenericEat)
  assert c.consumeParticles
  assert c.effects.len == 1
  assert c.effects[0].kind == ceApplyEffects
  assert c.effects[0].probability == 1.0'f32
  let inst = c.effects[0].effects
  assert inst.len == 2
  assert inst[0].effectId == "minecraft:regeneration"
  assert inst[0].amplifier == 1'i32
  assert inst[0].duration == 100'i32
  assert not inst[0].ambient
  assert inst[0].showParticles
  assert inst[0].showIcon
  assert inst[1].effectId == "minecraft:absorption"
  assert inst[1].amplifier == 0'i32
  assert inst[1].duration == 2400'i32

block consumeEffects:
  let chorus = comp("chorus_fruit", dcConsumable).consumable
  assert chorus.effects[0].kind == ceTeleportRandomly
  assert chorus.effects[0].diameter == 16.0'f32
  assert comp("chorus_fruit", dcUseCooldown).useCooldown.seconds == 1.0'f32
  assert comp("chorus_fruit", dcUseCooldown).useCooldown.cooldownGroup.isNone
  let milk = comp("milk_bucket", dcConsumable).consumable
  assert milk.animation == caDrink
  assert milk.soundEvent == idOrSound(sdEntityGenericDrink)
  assert not milk.consumeParticles
  assert milk.effects[0].kind == ceClearAllEffects
  let honey = comp("honey_bottle", dcConsumable).consumable
  assert honey.consumeSeconds == 2.0'f32
  assert honey.soundEvent == idOrSound(sdItemHoneyBottleDrink)
  assert honey.effects[0].kind == ceRemoveEffects
  assert honey.effects[0].removed.kind == idsIds
  assert statusEffectMinecraftName(uint8(honey.effects[0].removed.ids[0])) == "minecraft:poison"
  let bottle = comp("ominous_bottle", dcConsumable).consumable
  assert bottle.effects[0].kind == cePlaySound
  assert bottle.effects[0].sound == idOrSound(sdItemOminousBottleDispose)
  assert comp("ominous_bottle", dcOminousBottleAmplifier).ominousBottleAmplifier.amplifier == 0'i32

block equippable:
  let wolf = comp("wolf_armor", dcEquippable).equippable
  assert wolf.slot == esBody
  assert wolf.equipSound == idOrSound(sdItemArmorEquipWolf)
  assert wolf.assetId.unsafeGet == "minecraft:armadillo_scute"
  assert wolf.cameraOverlay.isNone
  assert wolf.allowedEntities.unsafeGet.ids == @[int32(fromName(EntityType, "wolf").unsafeGet.id)]
  assert wolf.dispensable
  assert wolf.swappable
  assert wolf.damageOnHurt
  assert not wolf.equipOnInteract
  assert wolf.canBeSheared
  assert wolf.shearingSound == idOrSound(sdItemArmorUnequipWolf)
  let carpet = comp("white_carpet", dcEquippable).equippable
  assert carpet.allowedEntities.unsafeGet.ids == @[int32(fromName(EntityType, "llama").unsafeGet.id),
    int32(fromName(EntityType, "trader_llama").unsafeGet.id)]
  # The defaults: the generic sound, the shears' snip, no asset.
  let pumpkin = comp("carved_pumpkin", dcEquippable).equippable
  assert pumpkin.slot == esHead
  assert pumpkin.equipSound == idOrSound(sdItemArmorEquipGeneric)
  assert pumpkin.shearingSound == idOrSound(sdItemShearsSnip)
  assert pumpkin.assetId.isNone
  assert pumpkin.cameraOverlay.unsafeGet == "minecraft:misc/pumpkinblur"
  assert not pumpkin.swappable
  assert not comp("elytra", dcEquippable).equippable.damageOnHurt
  assert comp("shield", dcEquippable).equippable.slot == esOffHand

block otherData:
  assert comp("netherite_sword", dcDamageResistant).damageResistant.resType == drtFire
  assert comp("music_disc_13", dcJukeboxPlayable).jukeboxPlayable.song == "minecraft:13"
  assert comp("light", dcBlockState).blockState.properties == @[("level", "15")]
  assert comp("egg", dcChickenVariant).stringVariant == "minecraft:temperate"
  assert get(comp("egg", dcChickenVariant), ChickenVariantImpl).value == "minecraft:temperate"
  assert comp("firework_rocket", dcFireworks).fireworks.flightDuration == 1'i32
  assert comp("firework_rocket", dcFireworks).fireworks.explosions.len == 0

block emptiedValues:
  # Upstream keeps these components with default contents, whatever items.json says of them.
  assert comp("iron_sword", dcEnchantments).enchantments.enchantment.len == 0
  assert comp("enchanted_book", dcStoredEnchantments).storedEnchantments.enchantment.len == 0
  assert comp("bundle", dcBundleContents).bundleContents.items.len == 0
  assert comp("chest", dcContainer).container.items.len == 0
  assert comp("crossbow", dcChargedProjectiles).chargedProjectiles.projectiles.len == 0
  assert comp("writable_book", dcWritableBookContent).writableBookContent.pages.len == 0
  assert comp("potion", dcPotionContents).potionContents.potionId.isNone

block markers:
  assert hasComp("shield", dcBlocksAttacks)
  assert hasComp("totem_of_undying", dcDeathProtection)
  assert hasComp("elytra", dcGlider)
  assert hasComp("iron_sword", dcRarity)
  assert hasComp("iron_sword", dcBreakSound)
  assert not hasComp("iron_sword", dcGlider)
  assert not hasComp("stone", dcTool)

block bedrock:
  assert ALL_BEDROCK_ITEMS.len == 1933
  let apple = bedrockItemByKey("minecraft:apple")
  assert apple != nil
  assert bedrockItemByKey("minecraft:not_there") == nil
  if apple != nil:
    assert apple.id == 285'i16
    assert apple.version == bivDataDriven
    assert apple.componentBased
    assert apple.definitionComponents.len > 3
  let sword = bedrockItemByKey("minecraft:iron_sword")
  if sword != nil:
    assert sword.id == 338'i16
    assert sword.version == bivNone
    assert not sword.componentBased
    assert sword.definitionComponents == @[10'u8, 0'u8, 0'u8]
  let mapping = fromJavaItemId(JavaToBedrockItemMapping, ITEM_IRON_SWORD.id)
  assert mapping != nil
  if mapping != nil:
    assert mapping.bedrockItem.id == 338'i16
    assert mapping.bedrockData == 0'u32
    assert mapping.bedrockBlockState == 0'u16
    assert sameItem(mapping.javaItem, ITEM_IRON_SWORD)
  assert fromJavaItemId(JavaToBedrockItemMapping, 1537'u16) == nil
  let granite = fromJavaItemId(JavaToBedrockItemMapping, ITEM_GRANITE.id)
  if granite != nil:
    assert granite.bedrockData == 1'u32
    assert granite.bedrockItem.registryKey == "minecraft:granite"
  # Upstream: an exact (id, data) first, else the first item with that id, else None.
  let back = fromBedrock(JavaToBedrockItemMapping, 338'i16, 0'u32)
  if back != nil:
    assert sameItem(back.javaItem, ITEM_IRON_SWORD)
  let fallback = fromBedrock(JavaToBedrockItemMapping, 338'i16, 77'u32)
  if fallback != nil:
    assert sameItem(fallback.javaItem, ITEM_IRON_SWORD)
  assert back != nil and fallback != nil
  assert fromBedrock(JavaToBedrockItemMapping, -32000'i16, 0'u32) == nil

block itemRefs:
  assert ENCHANTMENT_SHARPNESS.id == 33'u8
  assert ENCHANTMENT_SHARPNESS.name == "minecraft:sharpness"
  assert enchantmentFromId(33'u8)[1].name == "minecraft:sharpness"
  assert not enchantmentFromName("sharpness")[0]
  assert statusEffectIdFromMinecraftName("minecraft:absorption") == (true, 21'u8)
  assert not statusEffectIdFromMinecraftName("absorption")[0]
  assert statusEffectMinecraftName(30'u8) == "minecraft:bad_omen"
  assert potionIdFromName("swiftness") == (true, 13'u8)
  assert not potionIdFromName("minecraft:swiftness")[0]

echo "item_full tests passed"
