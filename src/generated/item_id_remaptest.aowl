## Known-answer test for generated/item_id_remap.aowl, values from upstream's
## pumpkin-data/src/generated/item_id_remap.rs.
import std/assertions
import std/syncio
import item_id_remap
import ../util/javaversion

# Server (26.2) id to 1.21.11 client id: air, stone, diamond_sword, ominous_bottle.
assert remapItemIdForVersion(0'u16, jmvV1_21_11) == 0'u16
assert remapItemIdForVersion(1'u16, jmvV1_21_11) == 1'u16
assert remapItemIdForVersion(964'u16, jmvV1_21_11) == 936'u16
assert remapItemIdForVersion(1536'u16, jmvV1_21_11) == 1504'u16

# And back.
assert remapItemIdFromVersion(936'u16, jmvV1_21_11) == 964'u16
assert remapItemIdFromVersion(1504'u16, jmvV1_21_11) == 1536'u16

# Beyond the table, and for a version without one, an id is unchanged.
assert remapItemIdForVersion(60000'u16, jmvV1_21_11) == 60000'u16
assert remapItemIdForVersion(964'u16, jmvV26_2) == 964'u16
assert remapItemIdFromVersion(964'u16, jmvV26_2) == 964'u16
assert remapItemIdForVersion(964'u16, jmvV1_8) == 964'u16

echo "all item id remap checks passed"
