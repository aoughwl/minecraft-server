proc enchantmentFromName*(name: string): (bool, EnchantmentRef) =
  ## `Enchantment::from_name`: the full `minecraft:` name.
  for e in gEnchantments:
    if e.name == name: return (true, e)
  (false, EnchantmentRef(id: 0'u8, name: ""))

proc enchantmentFromId*(id: uint8): (bool, EnchantmentRef) =
  for e in gEnchantments:
    if e.id == id: return (true, e)
  (false, EnchantmentRef(id: 0'u8, name: ""))

