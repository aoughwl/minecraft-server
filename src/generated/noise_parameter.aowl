proc allNoiseParameters*(): seq[DoublePerlinNoiseParameters] =
  NoiseParameters

proc noiseParameterName*(id: int): string =
  ## The constant's name in lower case, which is also what density_function.json calls it.
  NoiseParameterNames[id]

proc idToParameters*(id: string): (bool, DoublePerlinNoiseParameters) =
  ## Upstream's `id_to_parameters`: takes `minecraft:a/b`, `a/b` or `a_b`.
  var key = id
  if key.startsWith("minecraft:"):
    key = key[10 .. ^1]
  key = key.replace("/", "_")
  for i in 0 ..< NoiseParameterNames.len:
    if NoiseParameterNames[i] == key:
      return (true, NoiseParameters[i])
  (false, DoublePerlinNoiseParameters())
