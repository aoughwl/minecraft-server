## Known-answer test for generated/packet.aowl, values read from
## assets/packet/*_packets.json in the pinned tree.
import std/assertions
import std/syncio
import packet
import ../util/javaversion

# Protocol 774 resolves to 1.21.11, and its ids are those of 1_21_11_packets.json.
let v774 = fromProtocol(774'u32)
assert v774 == jmvV1_21_11

assert CB_PLAY_SET_ENTITY_MOTION.toId(v774) == 99'i32
assert CB_PLAY_LOGIN.toId(v774) == 48'i32
assert CB_PLAY_KEEP_ALIVE.toId(v774) == 43'i32
assert SB_PLAY_KEEP_ALIVE.toId(v774) == 27'i32
assert SB_HANDSHAKE_INTENTION.toId(v774) == 0'i32
assert CB_LOGIN_LOGIN_DISCONNECT.toId(v774) == 0'i32
assert CB_LOGIN_HELLO.toId(v774) == 1'i32
assert CB_LOGIN_LOGIN_FINISHED.toId(v774) == 2'i32
assert CB_LOGIN_LOGIN_COMPRESSION.toId(v774) == 3'i32
assert CB_LOGIN_CUSTOM_QUERY.toId(v774) == 4'i32
assert CB_LOGIN_COOKIE_REQUEST.toId(v774) == 5'i32
assert SB_CONFIG_CLIENT_INFORMATION.toId(v774) == 0'i32
assert SB_CONFIG_ACCEPT_CODE_OF_CONDUCT.toId(v774) == 9'i32
assert CB_CONFIG_FINISH_CONFIGURATION.toId(v774) == 3'i32
assert CB_PLAY_BUNDLE_DELIMITER.toId(v774) == 0'i32
assert CB_PLAY_ADD_ENTITY.toId(v774) == 1'i32

# Per-version lookup, and -1 for a packet absent from a version.
assert CB_PLAY_SET_ENTITY_MOTION.toId(jmvV1_20_5) == 99'i32
assert CB_PLAY_SET_ENTITY_MOTION.toId(jmvV26_2) == 101'i32
assert SB_PLAY_DEBUG_SAMPLE_SUBSCRIPTION.toId(jmvV1_20_5) == -1'i32
assert SB_PLAY_DEBUG_SAMPLE_SUBSCRIPTION.toId(jmvV1_21) == 19'i32
assert SB_PLAY_DEBUG_SAMPLE_SUBSCRIPTION.toId(jmvV1_21_2) == 21'i32
assert SB_PLAY_DEBUG_SAMPLE_SUBSCRIPTION.toId(jmvV1_21_9) == -1'i32

# A version without a table falls back to the latest, as upstream's `_` arm does.
assert CB_PLAY_SET_ENTITY_MOTION.toId(jmvV1_8) == 101'i32
assert CB_PLAY_SET_ENTITY_MOTION.toId(jmvUnknown) == 101'i32

# `PartialEq<i32>` compares the latest version's id, both ways round.
assert CB_PLAY_SET_ENTITY_MOTION == 101'i32
assert 101'i32 == CB_PLAY_SET_ENTITY_MOTION
assert not (CB_PLAY_SET_ENTITY_MOTION == 99'i32)

assert CURRENT_MC_VERSION == jmvV26_2
assert LOWEST_SUPPORTED_MC_VERSION == jmvV1_7_2

echo "all packet id checks passed"
