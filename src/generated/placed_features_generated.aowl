proc modifierKindFromName(name: string): PlacementModifierKind =
  for k in low(PlacementModifierKind) .. high(PlacementModifierKind):
    if $k == name:
      return k
  genPanic("placed_features_generated: bad modifier " & name)
  PlacementModifierKind.Biome

proc load(): seq[PlacedFeatureEntry] =
  result = @[]
  var pos = 0
  let d = PlacedFeatureData
  while pos < d.len:
    let featureName = fieldStr(d, pos, '|')
    skipSep(d, pos)
    let (found, feature) = ConfiguredFeature.fromName(featureName)
    if not found:
      genPanic("placed_features_generated: bad feature " & featureName)
    var placement: seq[PlacementModifierKind] = @[]
    while pos < d.len and d[pos] != '|':
      placement.add(modifierKindFromName(fieldStr(d, pos, ',', '|')))
      if d[pos] == ',':
        inc pos
    skipSep(d, pos)
    let json = fieldStr(d, pos, '\n')
    skipSep(d, pos)
    result.add(PlacedFeatureEntry(feature: feature, placement: placement, json: json))

let PlacedFeatureEntries*: seq[PlacedFeatureEntry] = load()
  ## Upstream's `build_placed_features()` map: indexed by `ord(PlacedFeature)`.

proc placedFeatureEntry*(f: PlacedFeature): PlacedFeatureEntry {.inline.} =
  PlacedFeatureEntries[ord(f)]

proc placedFeatureJson*(name: string): (bool, string) =
  ## The entry's JSON by name, with or without `minecraft:`.
  let (found, f) = PlacedFeature.fromName(name)
  if found: (true, PlacedFeatureEntries[ord(f)].json) else: (false, "")
