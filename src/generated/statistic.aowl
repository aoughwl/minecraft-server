proc categoryFromId*(id: int): (bool, StatisticCategory) =
  case id
  of 0: (true, scMined)
  of 1: (true, scCrafted)
  of 2: (true, scUsed)
  of 3: (true, scBroken)
  of 4: (true, scPickedUp)
  of 5: (true, scDropped)
  of 6: (true, scKilled)
  of 7: (true, scKilledBy)
  of 8: (true, scCustom)
  else: (false, StatisticCategory(0))

proc categoryFromRegistryKey*(name: string): (bool, StatisticCategory) =
  case name
  of "mined": (true, scMined)
  of "crafted": (true, scCrafted)
  of "used": (true, scUsed)
  of "broken": (true, scBroken)
  of "picked_up": (true, scPickedUp)
  of "dropped": (true, scDropped)
  of "killed": (true, scKilled)
  of "killed_by": (true, scKilledBy)
  of "custom": (true, scCustom)
  else: (false, StatisticCategory(0))

