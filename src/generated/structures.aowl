proc get*(key: StructureKeys): Structure =
  ## `Structure::get`.
  case key
  of StructureKeys.AncientCity: STRUCTURE_ANCIENT_CITY
  of StructureKeys.BastionRemnant: STRUCTURE_BASTION_REMNANT
  of StructureKeys.BuriedTreasure: STRUCTURE_BURIED_TREASURE
  of StructureKeys.DesertPyramid: STRUCTURE_DESERT_PYRAMID
  of StructureKeys.EndCity: STRUCTURE_END_CITY
  of StructureKeys.Fortress: STRUCTURE_FORTRESS
  of StructureKeys.Igloo: STRUCTURE_IGLOO
  of StructureKeys.JunglePyramid: STRUCTURE_JUNGLE_PYRAMID
  of StructureKeys.Mansion: STRUCTURE_MANSION
  of StructureKeys.Mineshaft: STRUCTURE_MINESHAFT
  of StructureKeys.MineshaftMesa: STRUCTURE_MINESHAFT_MESA
  of StructureKeys.Monument: STRUCTURE_MONUMENT
  of StructureKeys.NetherFossil: STRUCTURE_NETHER_FOSSIL
  of StructureKeys.OceanRuinCold: STRUCTURE_OCEAN_RUIN_COLD
  of StructureKeys.OceanRuinWarm: STRUCTURE_OCEAN_RUIN_WARM
  of StructureKeys.PillagerOutpost: STRUCTURE_PILLAGER_OUTPOST
  of StructureKeys.RuinedPortal: STRUCTURE_RUINED_PORTAL
  of StructureKeys.RuinedPortalDesert: STRUCTURE_RUINED_PORTAL_DESERT
  of StructureKeys.RuinedPortalJungle: STRUCTURE_RUINED_PORTAL_JUNGLE
  of StructureKeys.RuinedPortalMountain: STRUCTURE_RUINED_PORTAL_MOUNTAIN
  of StructureKeys.RuinedPortalNether: STRUCTURE_RUINED_PORTAL_NETHER
  of StructureKeys.RuinedPortalOcean: STRUCTURE_RUINED_PORTAL_OCEAN
  of StructureKeys.RuinedPortalSwamp: STRUCTURE_RUINED_PORTAL_SWAMP
  of StructureKeys.Shipwreck: STRUCTURE_SHIPWRECK
  of StructureKeys.ShipwreckBeached: STRUCTURE_SHIPWRECK_BEACHED
  of StructureKeys.Stronghold: STRUCTURE_STRONGHOLD
  of StructureKeys.SwampHut: STRUCTURE_SWAMP_HUT
  of StructureKeys.TrailRuins: STRUCTURE_TRAIL_RUINS
  of StructureKeys.TrialChambers: STRUCTURE_TRIAL_CHAMBERS
  of StructureKeys.VillageDesert: STRUCTURE_VILLAGE_DESERT
  of StructureKeys.VillagePlains: STRUCTURE_VILLAGE_PLAINS
  of StructureKeys.VillageSavanna: STRUCTURE_VILLAGE_SAVANNA
  of StructureKeys.VillageSnowy: STRUCTURE_VILLAGE_SNOWY
  of StructureKeys.VillageTaiga: STRUCTURE_VILLAGE_TAIGA

