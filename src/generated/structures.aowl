proc get*(self: SpreadType; rng: var RandomGenerator; bound: int32): int32 =
  ## `SpreadType::get`. `i32::midpoint` rounds towards zero; the two draws are in order.
  case self
  of SpreadType.Linear:
    rng.nextBoundedI32(bound)
  of SpreadType.Triangular:
    let a = int64(rng.nextBoundedI32(bound))
    let b = int64(rng.nextBoundedI32(bound))
    int32((a + b) div 2)

proc ordinal*(self: GenerationStep): int {.inline.} = ord(self)

proc newStructurePlacementCalculator*(seed: int64): StructurePlacementCalculator =
  StructurePlacementCalculator(seed: seed)

