proc structureSetGet*(name: string): (bool, StructureSet) =
  ## `StructureSet::get`, keyed by the bare name as upstream's is.
  case name
  of "ancient_cities": (true, STRUCTURE_SET_ANCIENT_CITIES)
  of "buried_treasures": (true, STRUCTURE_SET_BURIED_TREASURES)
  of "desert_pyramids": (true, STRUCTURE_SET_DESERT_PYRAMIDS)
  of "end_cities": (true, STRUCTURE_SET_END_CITIES)
  of "igloos": (true, STRUCTURE_SET_IGLOOS)
  of "jungle_temples": (true, STRUCTURE_SET_JUNGLE_TEMPLES)
  of "mineshafts": (true, STRUCTURE_SET_MINESHAFTS)
  of "nether_complexes": (true, STRUCTURE_SET_NETHER_COMPLEXES)
  of "nether_fossils": (true, STRUCTURE_SET_NETHER_FOSSILS)
  of "ocean_monuments": (true, STRUCTURE_SET_OCEAN_MONUMENTS)
  of "ocean_ruins": (true, STRUCTURE_SET_OCEAN_RUINS)
  of "pillager_outposts": (true, STRUCTURE_SET_PILLAGER_OUTPOSTS)
  of "ruined_portals": (true, STRUCTURE_SET_RUINED_PORTALS)
  of "shipwrecks": (true, STRUCTURE_SET_SHIPWRECKS)
  of "strongholds": (true, STRUCTURE_SET_STRONGHOLDS)
