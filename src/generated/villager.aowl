proc allVillagerProfessions*(): seq[VillagerProfession] =
  @[VillagerProfession.None, VillagerProfession.Armorer, VillagerProfession.Butcher, VillagerProfession.Cartographer, VillagerProfession.Cleric, VillagerProfession.Farmer, VillagerProfession.Fisherman, VillagerProfession.Fletcher, VillagerProfession.Leatherworker, VillagerProfession.Librarian, VillagerProfession.Mason, VillagerProfession.Nitwit, VillagerProfession.Shepherd, VillagerProfession.Toolsmith, VillagerProfession.Weaponsmith]

type VillagerType* {.pure.} = enum
  Desert, Jungle, Plains, Savanna, Snow, Swamp, Taiga

proc fromI32*(T: typedesc[VillagerType]; id: int32): Option[VillagerType] =
  case id
  of 0'i32: some(VillagerType.Desert)
  of 1'i32: some(VillagerType.Jungle)
  of 2'i32: some(VillagerType.Plains)
  of 3'i32: some(VillagerType.Savanna)
  of 4'i32: some(VillagerType.Snow)
  of 5'i32: some(VillagerType.Swamp)
  of 6'i32: some(VillagerType.Taiga)
  else: none[VillagerType]()

proc villagerTypeNames*(): seq[string] =
  @["desert", "jungle", "plains", "savanna", "snow", "swamp", "taiga"]

proc villagerTypeNamespace*(name: string): string =
  case name
  of "desert": "minecraft:desert"
  of "jungle": "minecraft:jungle"
  of "plains": "minecraft:plains"
  of "savanna": "minecraft:savanna"
  of "snow": "minecraft:snow"
  of "swamp": "minecraft:swamp"
  of "taiga": "minecraft:taiga"
  else: ""
