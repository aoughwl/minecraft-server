type VillagerProfession* {.pure.} = enum
  None, Armorer, Butcher, Cartographer, Cleric, Farmer, Fisherman, Fletcher, Leatherworker, Librarian, Mason, Nitwit, Shepherd, Toolsmith, Weaponsmith

proc fromI32*(T: typedesc[VillagerProfession]; id: int32): Option[VillagerProfession] =
  case id
  of 0'i32: some(VillagerProfession.None)
  of 1'i32: some(VillagerProfession.Armorer)
  of 2'i32: some(VillagerProfession.Butcher)
  of 3'i32: some(VillagerProfession.Cartographer)
  of 4'i32: some(VillagerProfession.Cleric)
  of 5'i32: some(VillagerProfession.Farmer)
  of 6'i32: some(VillagerProfession.Fisherman)
  of 7'i32: some(VillagerProfession.Fletcher)
  of 8'i32: some(VillagerProfession.Leatherworker)
  of 9'i32: some(VillagerProfession.Librarian)
  of 10'i32: some(VillagerProfession.Mason)
  of 11'i32: some(VillagerProfession.Nitwit)
  of 12'i32: some(VillagerProfession.Shepherd)
  of 13'i32: some(VillagerProfession.Toolsmith)
  of 14'i32: some(VillagerProfession.Weaponsmith)
  else: none[VillagerProfession]()

proc workSound*(self: VillagerProfession): Option[string] =
  case self
  of VillagerProfession.None: none[string]()
  of VillagerProfession.Armorer: some("minecraft:entity.villager.work_armorer")
  of VillagerProfession.Butcher: some("minecraft:entity.villager.work_butcher")
  of VillagerProfession.Cartographer: some("minecraft:entity.villager.work_cartographer")
  of VillagerProfession.Cleric: some("minecraft:entity.villager.work_cleric")
  of VillagerProfession.Farmer: some("minecraft:entity.villager.work_farmer")
  of VillagerProfession.Fisherman: some("minecraft:entity.villager.work_fisherman")
  of VillagerProfession.Fletcher: some("minecraft:entity.villager.work_fletcher")
  of VillagerProfession.Leatherworker: some("minecraft:entity.villager.work_leatherworker")
  of VillagerProfession.Librarian: some("minecraft:entity.villager.work_librarian")
  of VillagerProfession.Mason: some("minecraft:entity.villager.work_mason")
  of VillagerProfession.Nitwit: none[string]()
  of VillagerProfession.Shepherd: some("minecraft:entity.villager.work_shepherd")
  of VillagerProfession.Toolsmith: some("minecraft:entity.villager.work_toolsmith")
  of VillagerProfession.Weaponsmith: some("minecraft:entity.villager.work_weaponsmith")

proc requestedItems*(self: VillagerProfession): seq[string] =
  case self
  of VillagerProfession.None: newSeq[string]()
  of VillagerProfession.Armorer: newSeq[string]()
  of VillagerProfession.Butcher: newSeq[string]()
  of VillagerProfession.Cartographer: newSeq[string]()
  of VillagerProfession.Cleric: newSeq[string]()
  of VillagerProfession.Farmer: @["wheat", "wheat_seeds", "beetroot_seeds", "bone_meal"]
  of VillagerProfession.Fisherman: newSeq[string]()
  of VillagerProfession.Fletcher: newSeq[string]()
  of VillagerProfession.Leatherworker: newSeq[string]()
  of VillagerProfession.Librarian: newSeq[string]()
  of VillagerProfession.Mason: newSeq[string]()
  of VillagerProfession.Nitwit: newSeq[string]()
  of VillagerProfession.Shepherd: newSeq[string]()
  of VillagerProfession.Toolsmith: newSeq[string]()
  of VillagerProfession.Weaponsmith: newSeq[string]()

proc translationKey*(self: VillagerProfession): string =
  case self
  of VillagerProfession.None: "entity.minecraft.villager.none"
  of VillagerProfession.Armorer: "entity.minecraft.villager.armorer"
  of VillagerProfession.Butcher: "entity.minecraft.villager.butcher"
  of VillagerProfession.Cartographer: "entity.minecraft.villager.cartographer"
  of VillagerProfession.Cleric: "entity.minecraft.villager.cleric"
  of VillagerProfession.Farmer: "entity.minecraft.villager.farmer"
  of VillagerProfession.Fisherman: "entity.minecraft.villager.fisherman"
  of VillagerProfession.Fletcher: "entity.minecraft.villager.fletcher"
  of VillagerProfession.Leatherworker: "entity.minecraft.villager.leatherworker"
  of VillagerProfession.Librarian: "entity.minecraft.villager.librarian"
  of VillagerProfession.Mason: "entity.minecraft.villager.mason"
  of VillagerProfession.Nitwit: "entity.minecraft.villager.nitwit"
  of VillagerProfession.Shepherd: "entity.minecraft.villager.shepherd"
  of VillagerProfession.Toolsmith: "entity.minecraft.villager.toolsmith"
  of VillagerProfession.Weaponsmith: "entity.minecraft.villager.weaponsmith"

proc tradeSet*(self: VillagerProfession; level: int32): Option[VillagerTradeSet] =
  case self
  of VillagerProfession.None: none[VillagerTradeSet]()
  of VillagerProfession.Armorer:
    case level
    of 1'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[0], amount: 2'i32))
    of 2'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[1], amount: 2'i32))
    of 3'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[2], amount: 2'i32))
    of 4'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[3], amount: 2'i32))
    of 5'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[4], amount: 2'i32))
    else: none[VillagerTradeSet]()
  of VillagerProfession.Butcher:
    case level
    of 1'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[5], amount: 2'i32))
    of 2'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[6], amount: 2'i32))
    of 3'i32: some(VillagerTradeSet(trades: gVillagerTradeTables[7], amount: 2'i32))
