## The data shape of pumpkin-util's `math/int_provider.rs` and `math/float_provider.rs`, which
## generated tables hold values of. Hand-written, and data only: those files' sampling logic
## has no port yet, and belongs with it when src/util gets one.
##
## Upstream's `Provider::Object(Normal::Uniform(..))` nesting flattens to one kind each. A bare
## JSON number stays distinct from the `minecraft:constant` object, as upstream keeps them.

type
  IntProviderKind* {.pure.} = enum
    Constant        ## `IntProvider::Constant(i32)`
    ObjectConstant  ## `NormalIntProvider::Constant`
    Uniform
    BiasedToBottom
    Clamped
    Trapezoid
    ClampedNormal
    WeightedList

  IntProvider* = object
    kind*: IntProviderKind
    value*: int32
    minInclusive*: int32
    maxInclusive*: int32
    plateau*: int32
    mean*: float32
    deviation*: float32
    source*: seq[IntProvider]        ## `Clamped`: its one inner provider.
    distribution*: seq[IntProvider]  ## `WeightedList`: the entries' data.
    weights*: seq[int32]             ## `WeightedList`: the entries' weights.

  FloatProviderKind* {.pure.} = enum
    Constant
    Uniform
    Trapezoid

  FloatProvider* = object
    ## carver.rs's `value_to_float_provider` is the one source of these and only ever
    ## builds these three.
    kind*: FloatProviderKind
    value*: float32
    minInclusive*: float32  ## `Uniform` min; `Trapezoid` min.
    maxExclusive*: float32  ## `Uniform` max; `Trapezoid` max.
    plateau*: float32

proc intConstant*(v: int32): IntProvider =
  IntProvider(kind: IntProviderKind.Constant, value: v)

proc intUniform*(minV, maxV: int32): IntProvider =
  IntProvider(kind: IntProviderKind.Uniform, minInclusive: minV, maxInclusive: maxV)

proc floatConstant*(v: float32): FloatProvider =
  FloatProvider(kind: FloatProviderKind.Constant, value: v)

proc floatUniform*(minV, maxV: float32): FloatProvider =
  FloatProvider(kind: FloatProviderKind.Uniform, minInclusive: minV, maxExclusive: maxV)

proc floatTrapezoid*(minV, maxV, plateauV: float32): FloatProvider =
  FloatProvider(kind: FloatProviderKind.Trapezoid, minInclusive: minV, maxExclusive: maxV,
    plateau: plateauV)
