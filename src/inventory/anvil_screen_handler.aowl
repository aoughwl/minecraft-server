## Port of pumpkin-inventory/src/anvil/anvil_screen_handler.rs
## Port of pumpkin-inventory/src/anvil/mod.rs
##
## Upstream's anvil only renames ("we'll skip complex anvil logic for now"): a rename costs 1 level, and combining
## two items does nothing. So does this.

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import inventory, screenhandler, slot, window_property

type
  AnvilScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory
    renameText*: string
    repairCost*: int16

proc setRepairCost*(self: AnvilScreenHandler; cost: int16) =
  self.repairCost = cost
  let syncHandler = self.behaviour.syncHandler
  if syncHandler != nil:
    let (propertyId, propertyValue) = intoTuple(newWindowProperty(akRepairCost, cost))
    syncHandler.updateProperty(self.behaviour.syncId, int32(propertyId), int32(propertyValue))

proc updateResultSlot*(self: AnvilScreenHandler) =
  let inputA = self.inventory.getStack(0)

  if inputA.isEmpty():
    self.inventory.setStack(2, emptyItemStack())
    self.setRepairCost(0'i16)
    return

  var resultItem = inputA
  var cost = 0'i16

  # Basic renaming logic for now
  if self.renameText.len > 0:
    resultItem.setCustomName(self.renameText)
    cost += 1'i16

  # If combining with another item... we'll skip complex anvil logic for now
  # and just support renaming.
  if cost > 0'i16:
    self.inventory.setStack(2, resultItem)
    self.setRepairCost(cost)
  else:
    self.inventory.setStack(2, emptyItemStack())
    self.setRepairCost(0'i16)

proc updateItemName*(self: AnvilScreenHandler; name: string) =
  self.renameText = name
  self.updateResultSlot()
  ScreenHandler(self).sendContentUpdates()

proc anvilOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  let a = AnvilScreenHandler(self)
  self.defaultOnClosed(player)
  a.inventory.onClose()
  # Drop inputs from anvil
  for i in 0 ..< 2:
    let stack = a.inventory.removeStack(i)
    if not stack.isEmpty():
      offerOrDropStack(player, stack)
  a.inventory.setStack(2, emptyItemStack())

proc anvilQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if s.hasStack():
    var slotStackMut = s.getStack()
    stackLeft = slotStackMut

    if slotIndex < 3'i32:
      # From anvil to player
      if not self.insertItem(slotStackMut, 3'i32, int32(self.behaviour.slots.len), true):
        return emptyItemStack()
    else:
      # From player to anvil input 0 and 1
      if not self.insertItem(slotStackMut, 0'i32, 2'i32, false):
        return emptyItemStack()
    s.storeStack(slotStackMut)

    if slotStackMut.isEmpty():
      s.setStack(emptyItemStack())
    else:
      s.markDirty()

  stackLeft

proc anvilOnSlotClick(self: ScreenHandler; slotIndex, button: int32; actionType: SlotActionType;
    player: InventoryPlayer) =
  let a = AnvilScreenHandler(self)
  if slotIndex == 2'i32:
    # Taking from output slot
    let resultSlot = self.behaviour.slots[2]
    if resultSlot.hasStack():
      let resultStack = resultSlot.getClonedStack()
      if not resultStack.isEmpty():
        if player.experienceLevel() >= int32(a.repairCost) or player.isCreative():
          # Consume experience
          if not player.isCreative():
            player.addExperienceLevels(-int32(a.repairCost))

          # Consume inputs
          a.inventory.setStack(0, emptyItemStack())
          self.behaviour.slots[0].markDirty()
        else:
          # Cancel click
          self.sendContentUpdates()
          return

  self.internalOnSlotClick(slotIndex, button, actionType, player)
  if slotIndex == 0'i32 or slotIndex == 1'i32 or slotIndex == 2'i32:
    a.updateResultSlot()
    self.sendContentUpdates()

proc newAnvilScreenHandler*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): AnvilScreenHandler =
  result = AnvilScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtAnvil)), inventory: inventory,
    renameText: "", repairCost: 0'i16)
  result.onClosedImpl = anvilOnClosed
  result.quickMoveImpl = anvilQuickMove
  result.onSlotClickImpl = anvilOnSlotClick

  # Anvil specific slots: 2 input, 1 output
  for i in 0 ..< 3:
    ScreenHandler(result).addSlot(newNormalSlot(inventory, i))

  ScreenHandler(result).addPlayerSlots(playerInventory)
