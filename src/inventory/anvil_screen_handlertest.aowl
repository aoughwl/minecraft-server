## anvil_screen_handler.rs: upstream's anvil renames, and a rename costs 1 level.

import invtestkit, anvil_screen_handler, inventory, screenhandler, slot

proc handler(p: TestPlayer): AnvilScreenHandler =
  newAnvilScreenHandler(1'u8, p.inventory, newArrayInventory(3))

proc customName(s: ItemStack): bool = s.hasDataComponent(dcCustomName)

block costOfARename:
  let p = newTestPlayer(level = 5'i32)
  let h = handler(p)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateResultSlot()
  check(h.repairCost == 0'i16, "no rename, no cost")
  check(h.inventory.getStack(2).isEmpty(), "no rename, no result")

  h.updateItemName("Sting")
  check(h.repairCost == 1'i16, "a rename costs 1")
  checkStack(h.inventory.getStack(2), ITEM_DIAMOND_SWORD, 1, "result")
  check(customName(h.inventory.getStack(2)), "result is named")
  check(not customName(h.inventory.getStack(0)), "the input is not")

  h.updateItemName("")
  check(h.repairCost == 0'i16, "an empty name costs nothing")
  check(h.inventory.getStack(2).isEmpty(), "and makes nothing")

block noInputNoResult:
  let p = newTestPlayer()
  let h = handler(p)
  h.updateItemName("Sting")
  check(h.repairCost == 0'i16, "no input, no cost")
  check(h.inventory.getStack(2).isEmpty(), "no input, no result")

block combiningDoesNothingUpstream:
  let p = newTestPlayer()
  let h = handler(p)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.inventory.setStack(1, stackOf(ITEM_DIAMOND, 1))
  h.updateResultSlot()
  check(h.repairCost == 0'i16, "combining, no cost")
  check(h.inventory.getStack(2).isEmpty(), "combining, no result")

block takingTheResultSpendsLevelsAndInput:
  let p = newTestPlayer(level = 5'i32)
  let h = handler(p)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateItemName("Sting")
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  check(p.level == 4'i32, "one level spent")
  check(h.inventory.getStack(0).isEmpty(), "input spent")
  checkStack(h.behaviour.cursorStack, ITEM_DIAMOND_SWORD, 1, "cursor has the result")
  check(customName(h.behaviour.cursorStack), "named")
  check(h.inventory.getStack(2).isEmpty(), "result cleared")
  check(h.repairCost == 0'i16, "cost cleared")

block tooFewLevelsCancels:
  let p = newTestPlayer(level = 0'i32)
  let h = handler(p)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateItemName("Sting")
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  check(p.level == 0'i32, "no levels spent")
  check(h.behaviour.cursorStack.isEmpty(), "nothing taken")
  checkStack(h.inventory.getStack(0), ITEM_DIAMOND_SWORD, 1, "input stays")
  checkStack(h.inventory.getStack(2), ITEM_DIAMOND_SWORD, 1, "result stays")

block creativeTakesWithoutLevels:
  let p = newTestPlayer(creative = true, level = 0'i32)
  let h = handler(p)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateItemName("Sting")
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  check(p.level == 0'i32, "no levels spent")
  checkStack(h.behaviour.cursorStack, ITEM_DIAMOND_SWORD, 1, "taken")

block placingAnInputUpdatesTheResult:
  let p = newTestPlayer()
  let h = handler(p)
  h.renameText = "Sting"
  h.behaviour.cursorStack = stackOf(ITEM_DIAMOND_SWORD, 1)
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.inventory.getStack(2), ITEM_DIAMOND_SWORD, 1, "result appears")
  check(h.repairCost == 1'i16, "cost appears")

block costReachesTheClient:
  let p = newTestPlayer()
  let h = handler(p)
  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(p)
  ScreenHandler(h).updateSyncHandler(syncHandler)
  h.setRepairCost(7'i16)
  check(p.propertyPackets.len == 1, "one property")
  check(p.propertyPackets[0].windowId.value == 1'i32, "window")
  check(p.propertyPackets[0].property == 0'i16 and p.propertyPackets[0].value == 7'i16, "repair cost")

block quickMoveAndClose:
  let p = newTestPlayer()
  let h = handler(p)
  p.setMain(9, stackOf(ITEM_DIRT, 2))
  # Slots: 3 anvil, then main from 3: main 9 is handler slot 3.
  ScreenHandler(h).onSlotClick(3'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(0), ITEM_DIRT, 2, "player to the first input")
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_DIRT, 2, "input to the player's end")
  h.inventory.setStack(1, stackOf(ITEM_EGG, 1))
  h.inventory.setStack(2, stackOf(ITEM_STONE, 1))
  ScreenHandler(h).onClosed(p)
  checkStack(p.mainStack(0), ITEM_EGG, 1, "inputs offered back")
  check(h.inventory.getStack(2).isEmpty(), "output cleared")

echo "anvil_screen_handler: OK"
