## Port of pumpkin-inventory/src/beacon_screen_handler.rs

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import inventory, screenhandler, slot

type
  BeaconScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory  ## Exactly 1 slot, for payment.

proc beaconOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  let b = BeaconScreenHandler(self)
  b.inventory.onClose()

proc beaconQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  ## From the payment slot (0) to the player inventory; from the player inventory (1+) to the payment slot.
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if s.hasStack():
    var slotStackMut = s.getStack()
    stackLeft = slotStackMut

    if slotIndex == 0'i32:
      if not self.insertItem(slotStackMut, 1'i32, int32(self.behaviour.slots.len), true):
        return emptyItemStack()
    else:
      if not self.insertItem(slotStackMut, 0'i32, 1'i32, false):
        return emptyItemStack()
    s.storeStack(slotStackMut)

    if slotStackMut.isEmpty():
      s.setStack(emptyItemStack())
    else:
      s.markDirty()

  stackLeft

proc createBeaconHandler*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): BeaconScreenHandler =
  result = BeaconScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtBeacon)), inventory: inventory)
  result.onClosedImpl = beaconOnClosed
  result.quickMoveImpl = beaconQuickMove

  inventory.onOpen()

  # The single payment slot, then the player's 27 + 9.
  ScreenHandler(result).addSlot(newNormalSlot(inventory, 0))
  ScreenHandler(result).addPlayerSlots(playerInventory)
