## beacon_screen_handler.rs.

import std/options
import invtestkit, beaconhandler, inventory, screenhandler
import ../generated/screen

block beacon:
  let p = newTestPlayer()
  let inv = newArrayInventory(1)
  let h = createBeaconHandler(1'u8, p.inventory, inv)
  check(h.behaviour.slots.len == 37, "1 + 36 slots")
  check(h.behaviour.windowType == some(wtBeacon), "window")
  p.setMain(9, stackOf(ITEM_IRON_INGOT, 5))
  ScreenHandler(h).onSlotClick(1'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(inv).getStack(0), ITEM_IRON_INGOT, 5, "player to the payment slot")
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_IRON_INGOT, 5, "payment to the player's end")

echo "beaconhandler: OK"
