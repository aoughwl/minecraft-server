## Port of pumpkin-inventory/src/brewing/brewing_screen_handler.rs
## Port of pumpkin-inventory/src/brewing/mod.rs
##
## Slots: 0-2 potions, 3 ingredient, 4 fuel. Properties: 0 brew time (0-400), 1 fuel time (0-20).

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import ../generated/tag
import inventory, screenhandler, slot, window_property

type
  BrewingScreenHandler* = ref object of ScreenHandler
    inventory: Inventory  ## 5 slots.
    propertyDelegate: PropertyDelegate

  BrewingScreenListener = ref object of ScreenHandlerListener

proc listenerOnPropertyUpdate(self: ScreenHandlerListener; screenHandler: ScreenHandlerBehaviour; property: uint8;
    value: int32) =
  let syncHandler = screenHandler.syncHandler
  if syncHandler != nil:
    syncHandler.updateProperty(screenHandler.syncId, int32(property), value)

proc brewingQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  ## To the player from any stand slot. From the player: potions to 0-2, fuel to 4, else to the ingredient slot.
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if not s.hasStack():
    return stackLeft

  var stack = s.getStack()
  stackLeft = stack

  var success = false
  if slotIndex < 5'i32:
    # Moving from brewing stand to player inventory
    success = self.insertItem(stack, 5'i32, int32(self.behaviour.slots.len), true)
  else:
    # Moving from player inventory to brewing stand
    let hasPotionContents = stack.hasDataComponent(dcPotionContents)
    let isFuel = hasTag(toTaggable(stack.getItem()), Item_MINECRAFT_BREWING_FUEL)

    if hasPotionContents:
      success = self.insertItem(stack, 0'i32, 3'i32, false)
    elif isFuel:
      success = self.insertItem(stack, 4'i32, 5'i32, false)
    else:
      success = self.insertItem(stack, 3'i32, 4'i32, false)

  if not success:
    return emptyItemStack()
  s.storeStack(stack)

  if stack.isEmpty():
    s.setStack(emptyItemStack())
  else:
    s.markDirty()

  stackLeft

proc newBrewingScreenHandler*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory;
    propertyDelegate: PropertyDelegate): BrewingScreenHandler =
  result = BrewingScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtBrewingStand)),
    inventory: inventory, propertyDelegate: propertyDelegate)
  result.quickMoveImpl = brewingQuickMove

  # BrewTime (index 0) and Fuel (index 1)
  ScreenHandler(result).addProperty(newScreenProperty(propertyDelegate, 0'u8))
  ScreenHandler(result).addProperty(newScreenProperty(propertyDelegate, 1'u8))

  ScreenHandler(result).addListener(BrewingScreenListener(onPropertyUpdateImpl: listenerOnPropertyUpdate))

  # All 5 stand slots
  for i in 0 ..< 5:
    ScreenHandler(result).addSlot(newNormalSlot(inventory, i))

  ScreenHandler(result).addPlayerSlots(playerInventory)

proc createBrewing*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory;
    propertyDelegate: PropertyDelegate): BrewingScreenHandler =
  ## The factory the server uses when a player opens a brewing stand.
  newBrewingScreenHandler(syncId, playerInventory, inventory, propertyDelegate)
