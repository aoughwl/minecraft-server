## brewing_screen_handler.rs: where `quick_move` sends things, and the two properties.

import std/options
import invtestkit, brewing_screen_handler, inventory, screenhandler, window_property
import ../generated/screen

type
  TwoValues = ref object of PropertyDelegate
    values: seq[int32]

proc twoGet(self: PropertyDelegate; index: int32): int32 =
  let d = TwoValues(self)
  d.values[int(index)]

proc twoSet(self: PropertyDelegate; index: int32; value: int32) =
  let d = TwoValues(self)
  d.values[int(index)] = value

proc twoSize(self: PropertyDelegate): int32 = 2'i32

block brewingQuickMove:
  # Slots 0-2 potions, 3 ingredient, 4 fuel; main 9 is handler slot 5.
  let p = newTestPlayer()
  let delegate = TwoValues(values: @[0'i32, 0'i32], getPropertyImpl: twoGet, setPropertyImpl: twoSet,
    getPropertiesSizeImpl: twoSize)
  let stand = newArrayInventory(5)
  let h = createBrewing(1'u8, p.inventory, stand, delegate)
  check(h.behaviour.windowType == some(wtBrewingStand), "window")
  check(h.behaviour.slots.len == 41, "slots")
  check(h.behaviour.properties.len == 2, "properties")

  p.setMain(9, stackOf(ITEM_POTION, 1))
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(stand).getStack(0), ITEM_POTION, 1, "potion to the first bottle slot")

  p.setMain(9, stackOf(ITEM_BLAZE_POWDER, 2))
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(stand).getStack(4), ITEM_BLAZE_POWDER, 2, "fuel to the fuel slot")

  p.setMain(9, stackOf(ITEM_NETHER_WART, 3))
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(stand).getStack(3), ITEM_NETHER_WART, 3, "anything else to the ingredient slot")

  ScreenHandler(h).onSlotClick(3'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_NETHER_WART, 3, "out to the player's end")

  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(p)
  ScreenHandler(h).updateSyncHandler(syncHandler)
  delegate.values[0] = 400'i32
  ScreenHandler(h).sendContentUpdates()
  check(p.propertyPackets[p.propertyPackets.len - 1].value == 400'i16, "brew time sent")

echo "brewing_screen_handler: OK"
