## Port of pumpkin-inventory/src/container_click.rs
##
## `Result<Self, InventoryError>` is `ClickResult`: `ok`, then either `click` or `error`. Upstream's enum `Slot` is
## `ClickSlot` and its `ClickType` is `ContainerClickType`, so neither clashes with slot.aowl's `Slot` or
## screenhandler.aowl's `ClickType`.

import ../protocol/java/server/play/click_container
import invbase

type
  MouseClick* = enum
    mcLeft
    mcRight

  KeyClickKind* = enum
    kckSlot     ## Hotbar slot index (0-8).
    kckOffhand  ## Swap with offhand.

  KeyClick* = object
    case kind*: KeyClickKind
    of kckSlot: slot*: uint8
    of kckOffhand: discard

  ClickSlotKind* = enum
    cskNormal
    cskOutsideInventory

  ClickSlot* = object
    ## Upstream's `Slot`: a specific slot or outside the inventory.
    case kind*: ClickSlotKind
    of cskNormal: index*: int
    of cskOutsideInventory: discard

  DropType* = enum
    dtSingleItem  ## Drop a single item (Ctrl+Q).
    dtFullStack   ## Drop the full stack (Q).

  MouseDragType* = enum
    mdtLeft    ## Even distribution.
    mdtRight   ## One item per slot.
    mdtMiddle  ## Full stacks (creative only).

  MouseDragStateKind* = enum
    mdsStart
    mdsAddSlot
    mdsEnd

  MouseDragState* = object
    case kind*: MouseDragStateKind
    of mdsStart: dragType*: MouseDragType
    of mdsAddSlot: slot*: int
    of mdsEnd: discard

  ContainerClickKind* = enum
    cctMouseClick
    cctShiftClick
    cctKeyClick
    cctCreativePickItem
    cctDropType
    cctMouseDrag
    cctDoubleClick

  ContainerClickType* = object
    ## Upstream's `ClickType` here.
    case kind*: ContainerClickKind
    of cctMouseClick: mouseClick*: MouseClick
    of cctShiftClick: discard
    of cctKeyClick: keyClick*: KeyClick
    of cctCreativePickItem: discard
    of cctDropType: dropType*: DropType
    of cctMouseDrag: dragState*: MouseDragState
    of cctDoubleClick: discard

  Click* = object
    slot*: ClickSlot
    clickType*: ContainerClickType

  ClickResult* = object
    case ok*: bool
    of true: click*: Click
    of false: error*: InventoryError

const
  ButtonClickLeft = 0'i8
  ButtonClickRight = 1'i8
  KeyClickOffhand = 40'i8     ## F key by default.
  KeyClickHotbarStart = 0'i8
  KeyClickHotbarEnd = 9'i8    ## Exclusive.
  SlotIndexOutside = -999'i16

proc clickOk(slot: ClickSlot; clickType: ContainerClickType): ClickResult =
  ClickResult(ok: true, click: Click(slot: slot, clickType: clickType))

proc clickErr(error: InventoryError): ClickResult =
  ClickResult(ok: false, error: error)

proc normalSlot(index: int): ClickSlot = ClickSlot(kind: cskNormal, index: index)

proc outside(): ClickSlot = ClickSlot(kind: cskOutsideInventory)

proc dropTypeFromI8*(value: int8): (bool, DropType) =
  ## `DropType::from_i8`: false is `InventoryError::InvalidPacket`.
  case value
  of 0'i8: (true, dtSingleItem)
  of 1'i8: (true, dtFullStack)
  else: (false, dtSingleItem)

proc newNormalClick(button: int8; slot: int16): ClickResult =
  # `slot.try_into().unwrap_or(0)`: a negative slot other than outside is slot 0.
  let clickSlot =
    if slot == SlotIndexOutside: outside()
    elif slot < 0'i16: normalSlot(0)
    else: normalSlot(int(slot))
  if button == ButtonClickLeft:
    clickOk(clickSlot, ContainerClickType(kind: cctMouseClick, mouseClick: mcLeft))
  elif button == ButtonClickRight:
    clickOk(clickSlot, ContainerClickType(kind: cctMouseClick, mouseClick: mcRight))
  else:
    clickErr(invalidPacket())

proc newShiftClick(slot: int16): ClickResult =
  if slot < 0'i16:
    return clickErr(invalidSlot())
  clickOk(normalSlot(int(slot)), ContainerClickType(kind: cctShiftClick))

proc newKeyClick(button: int8; slot: int16): ClickResult =
  var key = KeyClick(kind: kckOffhand)
  if button >= KeyClickHotbarStart and button < KeyClickHotbarEnd:
    key = KeyClick(kind: kckSlot, slot: uint8(button))
  elif button == KeyClickOffhand:
    key = KeyClick(kind: kckOffhand)
  else:
    return clickErr(invalidSlot())
  if slot < 0'i16:
    return clickErr(invalidSlot())
  clickOk(normalSlot(int(slot)), ContainerClickType(kind: cctKeyClick, keyClick: key))

proc newDropItem(button: int8; slot: int16): ClickResult =
  let (known, dropType) = dropTypeFromI8(button)
  if not known:
    return clickErr(invalidPacket())
  let clickSlot =
    if slot == SlotIndexOutside: outside()
    elif slot < 0'i16: normalSlot(0)
    else: normalSlot(int(slot))
  clickOk(clickSlot, ContainerClickType(kind: cctDropType, dropType: dropType))

proc newDragItem(button: int8; slot: int16): ClickResult =
  var state = MouseDragState(kind: mdsEnd)
  case button
  of 0'i8: state = MouseDragState(kind: mdsStart, dragType: mdtLeft)
  of 4'i8: state = MouseDragState(kind: mdsStart, dragType: mdtRight)
  of 8'i8: state = MouseDragState(kind: mdsStart, dragType: mdtMiddle)
  of 1'i8, 5'i8, 9'i8:
    if slot < 0'i16:
      return clickErr(invalidSlot())
    state = MouseDragState(kind: mdsAddSlot, slot: int(slot))
  of 2'i8, 6'i8, 10'i8: state = MouseDragState(kind: mdsEnd)
  else: return clickErr(invalidPacket())
  let clickSlot = (if state.kind == mdsAddSlot: normalSlot(state.slot) else: outside())
  clickOk(clickSlot, ContainerClickType(kind: cctMouseDrag, dragState: state))

proc newClick*(mode: SlotActionType; button: int8; slot: int16): ClickResult =
  case mode
  of satPickup: newNormalClick(button, slot)
  of satQuickMove: newShiftClick(slot)  # Both buttons do the same here, so we omit it.
  of satSwap: newKeyClick(button, slot)
  of satClone:
    if slot < 0'i16:
      clickErr(invalidSlot())
    else:
      clickOk(normalSlot(int(slot)), ContainerClickType(kind: cctCreativePickItem))
  of satThrow: newDropItem(button, slot)
  of satQuickCraft: newDragItem(button, slot)
  of satPickupAll:
    if slot < 0'i16:
      clickErr(invalidSlot())
    else:
      clickOk(normalSlot(int(slot)), ContainerClickType(kind: cctDoubleClick))
