## container_click.rs: `Click::new` for each mode, by the slot, button and errors it decodes.

import invtestkit, container_click, invbase
import ../protocol/java/server/play/click_container

block normalClick:
  let left = newClick(satPickup, 0'i8, 5'i16)
  check(left.ok and left.click.clickType.kind == cctMouseClick, "left")
  check(left.click.clickType.mouseClick == mcLeft, "left button")
  check(left.click.slot.kind == cskNormal and left.click.slot.index == 5, "left slot")
  check(newClick(satPickup, 1'i8, 5'i16).click.clickType.mouseClick == mcRight, "right")
  check(newClick(satPickup, 0'i8, -999'i16).click.slot.kind == cskOutsideInventory, "outside")
  # `slot.try_into().unwrap_or(0)`.
  check(newClick(satPickup, 0'i8, -1'i16).click.slot.index == 0, "negative is slot 0")
  let bad = newClick(satPickup, 2'i8, 5'i16)
  check(not bad.ok and bad.error.kind == iekInvalidPacket, "bad button")

block shiftClick:
  check(newClick(satQuickMove, 1'i8, 7'i16).click.clickType.kind == cctShiftClick, "shift")
  check(newClick(satQuickMove, 0'i8, -1'i16).error.kind == iekInvalidSlot, "shift negative")

block keyClick:
  let hotbar = newClick(satSwap, 8'i8, 3'i16)
  check(hotbar.click.clickType.keyClick.kind == kckSlot and hotbar.click.clickType.keyClick.slot == 8'u8, "hotbar")
  check(newClick(satSwap, 40'i8, 3'i16).click.clickType.keyClick.kind == kckOffhand, "off hand")
  check(newClick(satSwap, 9'i8, 3'i16).error.kind == iekInvalidSlot, "key out of range")
  check(newClick(satSwap, 0'i8, -1'i16).error.kind == iekInvalidSlot, "key negative slot")

block creativeAndDouble:
  check(newClick(satClone, 2'i8, 3'i16).click.clickType.kind == cctCreativePickItem, "clone")
  check(newClick(satClone, 2'i8, -1'i16).error.kind == iekInvalidSlot, "clone negative")
  check(newClick(satPickupAll, 0'i8, 3'i16).click.clickType.kind == cctDoubleClick, "double")
  check(newClick(satPickupAll, 0'i8, -1'i16).error.kind == iekInvalidSlot, "double negative")

block dropItem:
  check(newClick(satThrow, 0'i8, 3'i16).click.clickType.dropType == dtSingleItem, "drop one")
  check(newClick(satThrow, 1'i8, 3'i16).click.clickType.dropType == dtFullStack, "drop stack")
  check(newClick(satThrow, 1'i8, -999'i16).click.slot.kind == cskOutsideInventory, "drop outside")
  check(newClick(satThrow, 2'i8, 3'i16).error.kind == iekInvalidPacket, "bad drop")

block dragItem:
  let start = newClick(satQuickCraft, 4'i8, -999'i16)
  check(start.click.clickType.dragState.kind == mdsStart, "start")
  check(start.click.clickType.dragState.dragType == mdtRight, "start right")
  check(start.click.slot.kind == cskOutsideInventory, "start is outside")
  check(newClick(satQuickCraft, 0'i8, -999'i16).click.clickType.dragState.dragType == mdtLeft, "start left")
  check(newClick(satQuickCraft, 8'i8, -999'i16).click.clickType.dragState.dragType == mdtMiddle, "start middle")
  let add = newClick(satQuickCraft, 5'i8, 12'i16)
  check(add.click.clickType.dragState.kind == mdsAddSlot and add.click.clickType.dragState.slot == 12, "add")
  check(add.click.slot.index == 12, "add slot")
  check(newClick(satQuickCraft, 1'i8, -1'i16).error.kind == iekInvalidSlot, "add negative")
  check(newClick(satQuickCraft, 6'i8, -999'i16).click.clickType.dragState.kind == mdsEnd, "end")
  check(newClick(satQuickCraft, 3'i8, 0'i16).error.kind == iekInvalidPacket, "bad drag")

block errorMessages:
  check($invalidSlot() == "Invalid slot", "error text")
  check($closedContainerInteract(7'i32) == "Player '7' tried to interact with a closed container", "closed text")

echo "container_click: OK"
