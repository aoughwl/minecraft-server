## Port of pumpkin-inventory/src/crafting/crafting_inventory.rs

import inventory, recipes

type
  CraftingInventory* = ref object of RecipeInputInventory
    width*: uint8
    height*: uint8

proc craftingWidth(self: RecipeInputInventory): int =
  let c = CraftingInventory(self)
  int(c.width)

proc craftingHeight(self: RecipeInputInventory): int =
  let c = CraftingInventory(self)
  int(c.height)

let gCraftingOps = arrayInventoryOps()

proc newCraftingInventory*(width, height: uint8): CraftingInventory =
  ## 2x2 for the player's own grid, 3x3 for a crafting table.
  CraftingInventory(ops: gCraftingOps, items: emptyStacks(int(width) * int(height)), width: width, height: height,
    getWidthImpl: craftingWidth, getHeightImpl: craftingHeight)
