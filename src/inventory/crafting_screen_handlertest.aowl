## crafting_screen_handler.rs, crafting_inventory.rs and recipe_provider.rs: crafting results, by hand.
## Table slots: 0 result, 1-9 grid, 10-36 main, 37-45 hotbar.

import std/options
import invtestkit, crafting, crafting_screen_handler, inventory, recipe_provider, recipes, screenhandler, slot
import ../generated/recipes as generated
import ../generated/statistic
import ../protocol/recipe

proc table(p: TestPlayer; provider: nil RecipeProvider = nil): ScreenHandler =
  newCraftingTableScreenHandler(1'u8, p.inventory, provider)

proc grid(h: ScreenHandler; cell: int; stack: ItemStack) =
  ## Puts a stack in a grid cell and lets the listener see it, as the end of a click does.
  h.behaviour.slots[1 + cell].setStack(stack)

block craftingInventory:
  let c = newCraftingInventory(2'u8, 3'u8)
  check(RecipeInputInventory(c).getWidth() == 2, "width")
  check(RecipeInputInventory(c).getHeight() == 3, "height")
  check(Inventory(c).size() == 6, "size")

block shapeless:
  # One log anywhere gives 4 planks.
  let p = newTestPlayer()
  let h = table(p)
  h.grid(4, stackOf(ITEM_OAK_LOG, 1))
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_OAK_PLANKS, 4, "log to planks")
  h.grid(0, stackOf(ITEM_OAK_LOG, 1))
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_OAK_PLANKS, 0, "two logs make nothing")

block shapedWithTheOffsetAnywhere:
  # Two planks in a column give 4 sticks, in any column.
  for column in 0 ..< 3:
    let p = newTestPlayer()
    let h = table(p)
    h.grid(column, stackOf(ITEM_OAK_PLANKS, 1))
    h.grid(column + 3, stackOf(ITEM_OAK_PLANKS, 1))
    h.sendContentUpdates()
    checkStack(h.behaviour.slots[0].getStack(), ITEM_STICK, 4, "sticks")

block shapedMirrored:
  # Stairs are not symmetrical, so both hands of the pattern match.
  for mirrored in [false, true]:
    let p = newTestPlayer()
    let h = table(p)
    let cells = (if mirrored: @[2, 4, 5, 6, 7, 8] else: @[0, 3, 4, 6, 7, 8])
    for cell in cells:
      h.grid(cell, stackOf(ITEM_OAK_PLANKS, 1))
    h.sendContentUpdates()
    checkStack(h.behaviour.slots[0].getStack(), ITEM_OAK_STAIRS, 4, "stairs")

block shapedRejectsAnExtraItem:
  let p = newTestPlayer()
  let h = table(p)
  h.grid(0, stackOf(ITEM_OAK_PLANKS, 1))
  h.grid(3, stackOf(ITEM_OAK_PLANKS, 1))
  h.grid(8, stackOf(ITEM_DIRT, 1))
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_STICK, 0, "no sticks")

block decoratedPot:
  let p = newTestPlayer()
  let h = table(p)
  for cell in [1, 3, 5, 7]:
    h.grid(cell, stackOf(ITEM_BRICK, 1))
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_DECORATED_POT, 1, "pot")

block takingTheResultConsumesOneOfEach:
  let p = newTestPlayer()
  let h = table(p)
  h.grid(0, stackOf(ITEM_OAK_PLANKS, 2))
  h.grid(3, stackOf(ITEM_OAK_PLANKS, 3))
  h.sendContentUpdates()
  h.onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_STICK, 4, "cursor has the result")
  checkStack(h.behaviour.slots[1].getStack(), ITEM_OAK_PLANKS, 1, "first ingredient")
  checkStack(h.behaviour.slots[4].getStack(), ITEM_OAK_PLANKS, 2, "second ingredient")
  check(p.stats.len == 1, "one stat")
  check(p.stats[0].category == scCrafted and p.stats[0].statId == int32(ITEM_STICK.id) and p.stats[0].amount == 4'i32,
    "crafted stat")
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_STICK, 4, "refilled by the listener")

block theResultSlotTakesNothing:
  let p = newTestPlayer()
  let h = table(p)
  h.behaviour.cursorStack = stackOf(ITEM_DIRT, 1)
  h.onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.slots[0].getStack(), ITEM_DIRT, 0, "nothing placed")
  checkStack(h.behaviour.cursorStack, ITEM_DIRT, 1, "cursor keeps it")

block aSameItemCursorTakesTheResultIfItFits:
  let p = newTestPlayer()
  let h = table(p)
  h.grid(0, stackOf(ITEM_OAK_PLANKS, 2))
  h.grid(3, stackOf(ITEM_OAK_PLANKS, 2))
  h.sendContentUpdates()
  h.behaviour.cursorStack = stackOf(ITEM_STICK, 60)
  h.onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_STICK, 64, "topped up")
  h.sendContentUpdates()
  h.onSlotClick(0'i32, 0'i32, satPickup, p)
  # A full cursor: max - count is 0, less than the result's 4, and no partial take from a result slot.
  checkStack(h.behaviour.cursorStack, ITEM_STICK, 64, "no room")
  checkStack(h.behaviour.slots[1].getStack(), ITEM_OAK_PLANKS, 1, "nothing consumed")

block shiftClickCraftsUntilTheGridIsEmpty:
  let p = newTestPlayer()
  let h = table(p)
  h.grid(0, stackOf(ITEM_OAK_PLANKS, 3))
  h.grid(3, stackOf(ITEM_OAK_PLANKS, 3))
  h.sendContentUpdates()
  h.onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_STICK, 12, "three crafts, into the last hotbar slot")
  checkStack(h.behaviour.slots[0].getStack(), ITEM_STICK, 0, "result empty")
  checkStack(h.behaviour.slots[1].getStack(), ITEM_OAK_PLANKS, 0, "first ingredient spent")
  checkStack(h.behaviour.slots[4].getStack(), ITEM_OAK_PLANKS, 0, "second ingredient spent")
  check(p.stats.len == 3, "three crafted stats")

block quickMoveRoutes:
  let p = newTestPlayer()
  let h = table(p)
  # Main to grid first.
  p.setMain(9, stackOf(ITEM_STONE, 5))
  h.onSlotClick(10'i32, 0'i32, satQuickMove, p)
  checkStack(h.behaviour.slots[1].getStack(), ITEM_STONE, 5, "main to the grid")
  # Grid back to the player, from the front.
  h.onSlotClick(1'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_STONE, 5, "grid to the first main slot")
  # A full grid: main to hotbar, hotbar to main.
  for cell in 0 ..< 9:
    h.grid(cell, stackOf(ITEM_DIRT, 64))
  h.onSlotClick(10'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(0), ITEM_STONE, 5, "main to hotbar")
  h.onSlotClick(37'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_STONE, 5, "hotbar to main")

block closingReturnsTheGrid:
  let p = newTestPlayer()
  let h = table(p)
  h.grid(0, stackOf(ITEM_OAK_PLANKS, 3))
  h.behaviour.cursorStack = stackOf(ITEM_DIRT, 1)
  h.onClosed(p)
  checkStack(p.mainStack(0), ITEM_DIRT, 1, "cursor first")
  checkStack(p.mainStack(1), ITEM_OAK_PLANKS, 3, "then the grid")
  checkStack(h.behaviour.slots[1].getStack(), ITEM_OAK_PLANKS, 0, "grid emptied")

type DiamondFromDirt = ref object of RecipeProvider

proc diamondRecipes(self: RecipeProvider): seq[DynamicRecipe] =
  @[DynamicRecipe(kind: drCrafting, crafting: OwnedCraftingRecipe(category: rcMisc, group: none[string](),
    result: OwnedRecipeResult(itemId: "minecraft:diamond", count: 2'u8), kind: ocrShaped, showNotification: false,
    key: @[RecipeKeyEntry(symbol: 'D', ingredient: OwnedRecipeIngredient(kind: oriSimple, id: "minecraft:dirt"))],
    pattern: @["D", "D"])),
    DynamicRecipe(kind: drCrafting, crafting: OwnedCraftingRecipe(category: rcMisc, group: none[string](),
    result: OwnedRecipeResult(itemId: "minecraft:emerald", count: 1'u8), kind: ocrShapeless,
    ingredients: @[OwnedRecipeIngredient(kind: oriSimple, id: "minecraft:egg"),
      OwnedRecipeIngredient(kind: oriSimple, id: "minecraft:dirt")]))]

block dynamicRecipes:
  let provider = DiamondFromDirt(getDynamicRecipesImpl: diamondRecipes)
  let p = newTestPlayer()
  let h = table(p, provider)
  h.grid(1, stackOf(ITEM_DIRT, 1))
  h.grid(4, stackOf(ITEM_DIRT, 1))
  h.sendContentUpdates()
  checkStack(h.behaviour.slots[0].getStack(), ITEM_DIAMOND, 2, "dynamic shaped")
  let q = newTestPlayer()
  let g = table(q, provider)
  g.grid(8, stackOf(ITEM_DIRT, 1))
  g.grid(0, stackOf(ITEM_EGG, 1))
  g.sendContentUpdates()
  checkStack(g.behaviour.slots[0].getStack(), ITEM_EMERALD, 1, "dynamic shapeless")

block ingredientMatching:
  check(RecipeIngredient(kind: rikSimple, name: "minecraft:stone").matchItem(ITEM_STONE), "simple")
  check(not RecipeIngredient(kind: rikSimple, name: "minecraft:stone").matchItem(ITEM_DIRT), "simple no")
  check(RecipeIngredient(kind: rikTagged, name: "#minecraft:planks").matchItem(ITEM_OAK_PLANKS), "tagged")
  check(not RecipeIngredient(kind: rikTagged, name: "#minecraft:planks").matchItem(ITEM_STONE), "tagged no")
  check(not RecipeIngredient(kind: rikTagged, name: "#minecraft:no_such_tag").matchItem(ITEM_STONE), "no such tag")
  check(RecipeIngredient(kind: rikOneOf, options: @["minecraft:dirt", "minecraft:stone"]).matchItem(ITEM_STONE), "one of")

block lateListenerRevisionIsSent:
  # A grid change sends the result to the client as slot 0.
  let p = newTestPlayer()
  let h = table(p)
  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(p)
  h.updateSyncHandler(syncHandler)
  h.grid(0, stackOf(ITEM_OAK_LOG, 1))
  h.sendContentUpdates()
  var sawResult = false
  for packet in p.slotPackets:
    if packet.slot == 0'i16 and packet.slotData.stack.itemId == ITEM_OAK_PLANKS.id and
        packet.slotData.stack.itemCount == 4'u8:
      sawResult = true
  check(sawResult, "result sent to the client")

echo "crafting_screen_handler: OK"
