## crafting_inventory.rs and recipes.rs: the grid's shape and the seven methods it shares with `ArrayInventory`.

import invtestkit, crafting, inventory, recipes

let c = newCraftingInventory(2'u8, 3'u8)
check(RecipeInputInventory(c).getWidth() == 2, "width")
check(RecipeInputInventory(c).getHeight() == 3, "height")
let inv = Inventory(c)
check(inv.size() == 6, "size")
check(inv.isEmpty(), "empty")
inv.setStack(5, stackOf(ITEM_STONE, 5))
checkStack(inv.getStack(5), ITEM_STONE, 5, "get")
checkStack(inv.removeStackSpecific(5, 2'u8), ITEM_STONE, 2, "split")
checkStack(inv.removeStack(5), ITEM_STONE, 3, "remove")
inv.setStack(0, stackOf(ITEM_STONE, 5))
inv.clear()
check(inv.isEmpty(), "clear")

echo "crafting: OK"
