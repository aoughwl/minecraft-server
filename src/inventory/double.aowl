## Port of pumpkin-inventory/src/double.rs

import "../data/item_stack/mod"
import inventory

type
  DoubleInventory* = ref object of Inventory
    first: Inventory   ## Lower slot indices, 0 to first.size()-1.
    second: Inventory  ## Higher slot indices, first.size() to total-1.

proc doubleSize(self: Inventory): int =
  let d = DoubleInventory(self)
  d.first.size() + d.second.size()

proc doubleIsEmpty(self: Inventory): bool =
  let d = DoubleInventory(self)
  d.first.isEmpty() and d.second.isEmpty()

proc doubleGetStack(self: Inventory; slot: int): ItemStack =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.getStack(slot - d.first.size())
  else: d.first.getStack(slot)

proc doubleRemoveStack(self: Inventory; slot: int): ItemStack =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.removeStack(slot - d.first.size())
  else: d.first.removeStack(slot)

proc doubleRemoveStackSpecific(self: Inventory; slot: int; amount: uint8): ItemStack =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.removeStackSpecific(slot - d.first.size(), amount)
  else: d.first.removeStackSpecific(slot, amount)

proc doubleSetStack(self: Inventory; slot: int; stack: ItemStack) =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.setStack(slot - d.first.size(), stack)
  else: d.first.setStack(slot, stack)

proc doubleStoreStack(self: Inventory; slot: int; stack: ItemStack) =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.storeStack(slot - d.first.size(), stack)
  else: d.first.storeStack(slot, stack)

proc doubleOnOpen(self: Inventory) =
  let d = DoubleInventory(self)
  d.first.onOpen()
  d.second.onOpen()

proc doubleOnClose(self: Inventory) =
  let d = DoubleInventory(self)
  d.first.onClose()
  d.second.onClose()

proc doubleGetMaxCountPerStack(self: Inventory): uint8 =
  let d = DoubleInventory(self)
  d.first.getMaxCountPerStack()

proc doubleMarkDirty(self: Inventory) =
  let d = DoubleInventory(self)
  d.first.markDirty()
  d.second.markDirty()

proc doubleIsValidSlotFor(self: Inventory; slot: int; stack: ItemStack): bool =
  let d = DoubleInventory(self)
  if slot >= d.first.size(): d.second.isValidSlotFor(slot - d.first.size(), stack)
  else: d.first.isValidSlotFor(slot, stack)

proc doubleClear(self: Inventory) =
  let d = DoubleInventory(self)
  d.first.clear()
  d.second.clear()

let gDoubleOps = InventoryOps(size: doubleSize, isEmpty: doubleIsEmpty, getStack: doubleGetStack,
  removeStack: doubleRemoveStack, removeStackSpecific: doubleRemoveStackSpecific, setStack: doubleSetStack,
  storeStack: doubleStoreStack, onOpen: doubleOnOpen, onClose: doubleOnClose,
  getMaxCountPerStack: doubleGetMaxCountPerStack, markDirty: doubleMarkDirty,
  isValidSlotFor: doubleIsValidSlotFor, clear: doubleClear)

proc newDoubleInventory*(first, second: Inventory): DoubleInventory =
  DoubleInventory(ops: gDoubleOps, first: first, second: second)
