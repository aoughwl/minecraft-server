## double.rs: the first inventory's slots, then the second's.

import invtestkit, double, inventory

let first = newArrayInventory(27)
let second = newArrayInventory(27)
let d = Inventory(newDoubleInventory(first, second))

check(d.size() == 54, "size")
check(d.isEmpty(), "empty")

d.setStack(26, stackOf(ITEM_STONE, 1))
d.setStack(27, stackOf(ITEM_DIRT, 2))
checkStack(Inventory(first).getStack(26), ITEM_STONE, 1, "lower slot in the first")
checkStack(Inventory(second).getStack(0), ITEM_DIRT, 2, "upper slot in the second")
checkStack(d.getStack(27), ITEM_DIRT, 2, "get reads across")
check(not d.isEmpty(), "not empty")

checkStack(d.removeStackSpecific(27, 1'u8), ITEM_DIRT, 1, "remove specific")
checkStack(d.removeStack(27), ITEM_DIRT, 1, "remove")
d.storeStack(53, stackOf(ITEM_EGG, 3))
checkStack(Inventory(second).getStack(26), ITEM_EGG, 3, "store reaches the second")

check(d.getMaxCountPerStack() == 99'u8, "first's max")
check(d.isValidSlotFor(30, stackOf(ITEM_STONE, 1)), "valid")

d.clear()
check(d.isEmpty(), "clear empties both")
check(Inventory(first).isEmpty() and Inventory(second).isEmpty(), "both halves")

echo "double: OK"
