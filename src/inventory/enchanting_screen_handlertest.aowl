## enchanting_screen_handler.rs. Upstream's own `#[test]` first. The level requirements are known answers, worked
## with an independent Java `Random` from the same formula.

import std/options
import invtestkit, enchanting_screen_handler, inventory, screenhandler, slot
import ../generated/statistic
import ../util/legacy_rand

# Upstream: lapis_slot_only_accepts_lapis_lazuli.
check(isLapis(stackOf(ITEM_LAPIS_LAZULI, 1)), "lapis")
check(not isLapis(stackOf(ITEM_DIRT, 1)), "dirt is not lapis")

proc handler(p: TestPlayer; seed, shelves: int32): EnchantingTableScreenHandler =
  newEnchantingTableScreenHandler(1'u8, p.inventory, newArrayInventory(2), seed, shelves)

block lapisSlot:
  let p = newTestPlayer()
  let h = handler(p, 0'i32, 0'i32)
  check(h.behaviour.slots[1].canInsert(stackOf(ITEM_LAPIS_LAZULI, 1)), "lapis slot takes lapis")
  check(not h.behaviour.slots[1].canInsert(stackOf(ITEM_DIRT, 1)), "and nothing else")
  check(h.behaviour.slots[0].canInsert(stackOf(ITEM_DIRT, 1)), "the item slot takes anything")
  check(h.behaviour.slots.len == 38, "2 + 36 slots")

block levelRequirements:
  let cases = [(12345'i32, 15'i32, [6'i32, 26'i32, 30'i32]), (0'i32, 0'i32, [2'i32, 8'i32, 6'i32]),
    (-7'i32, 8'i32, [4'i32, 13'i32, 16'i32])]
  for c in cases:
    let p = newTestPlayer()
    let h = handler(p, c[0], c[1])
    h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
    h.updateEnchantments(p)
    check(h.levelRequirements[0] == c[2][0], "first requirement")
    check(h.levelRequirements[1] == c[2][1], "second requirement")
    check(h.levelRequirements[2] == c[2][2], "third requirement")

block notEnchantable:
  let p = newTestPlayer()
  let h = handler(p, 12345'i32, 15'i32)
  h.inventory.setStack(0, stackOf(ITEM_STONE, 1))
  h.updateEnchantments(p)
  check(h.levelRequirements[0] == 0'i32 and h.enchantmentId[0] == -1'i32 and h.enchantmentLevel[0] == -1'i32,
    "stone offers nothing")

block alreadyEnchanted:
  let p = newTestPlayer()
  let h = handler(p, 12345'i32, 15'i32)
  var sword = stackOf(ITEM_DIAMOND_SWORD, 1)
  sword.addEnchantment(gEnchantments[0], 1'u16)
  h.inventory.setStack(0, sword)
  h.updateEnchantments(p)
  check(h.levelRequirements[2] == 0'i32 and h.enchantmentId[2] == -1'i32, "an enchanted item offers nothing")

block offersAreDeterministicAndRealForTheItem:
  let p = newTestPlayer()
  let h = handler(p, 12345'i32, 15'i32)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateEnchantments(p)
  let first = h.enchantmentId
  let firstLevel = h.enchantmentLevel
  check(first[2] >= 0'i32, "a level 30 sword has an offer")
  check(firstLevel[2] >= 1'i32, "at a real level")
  h.updateEnchantments(p)
  check(h.enchantmentId == first and h.enchantmentLevel == firstLevel, "the same seed gives the same offer")

block listIsAlwaysCompatible:
  # Whatever the seed, the list holds no two enchantments that exclude each other: two protections, two damages.
  for seed in 0'i32 ..< 200'i32:
    var r = fromSeed(cast[uint64](int64(seed)))
    let list = getEnchantmentList(r, stackOf(ITEM_DIAMOND_CHESTPLATE, 1), 2, 30'i32)
    var protections = 0
    for chosen in list:
      if chosen.enchantment.registryKey == "protection" or chosen.enchantment.registryKey == "fire_protection" or
          chosen.enchantment.registryKey == "blast_protection" or chosen.enchantment.registryKey == "projectile_protection":
        protections += 1
      check(chosen.level >= 1'i32 and chosen.level <= chosen.enchantment.maxLevel, "level in range")
    check(protections <= 1, "one protection at most")

block buttonChecks:
  let p = newTestPlayer(level = 40'i32)
  let h = handler(p, 12345'i32, 15'i32)
  check(not ScreenHandler(h).onButtonClick(p, 3'i32), "button out of range")
  check(not ScreenHandler(h).onButtonClick(p, -1'i32), "button negative")
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateEnchantments(p)
  check(not ScreenHandler(h).onButtonClick(p, 2'i32), "no lapis")
  h.inventory.setStack(1, stackOf(ITEM_LAPIS_LAZULI, 2))
  check(not ScreenHandler(h).onButtonClick(p, 2'i32), "too little lapis: 3 needed")
  p.level = 1'i32
  h.inventory.setStack(1, stackOf(ITEM_LAPIS_LAZULI, 5))
  check(not ScreenHandler(h).onButtonClick(p, 2'i32), "too few levels")
  check(h.inventory.getStack(1).itemCount == 5'u8, "nothing spent")

block enchanting:
  let p = newTestPlayer(level = 40'i32)
  let h = handler(p, 12345'i32, 15'i32)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.inventory.setStack(1, stackOf(ITEM_LAPIS_LAZULI, 5))
  h.updateEnchantments(p)
  check(ScreenHandler(h).onButtonClick(p, 2'i32), "third button")
  check(p.level == 37'i32, "the button's cost is button + 1 levels, not the requirement")
  check(h.inventory.getStack(1).itemCount == 2'u8, "three lapis")
  check(h.inventory.getStack(0).hasEnchantments(), "the item is enchanted")
  check(h.enchantmentSeed == p.seed, "the seed is the player's new one")
  check(h.levelRequirements[0] == 0'i32, "an enchanted item offers nothing more")
  check(p.stats.len == 1 and p.stats[0].category == scCustom and p.stats[0].statId == int32(ord(csEnchantItem)) and
    p.stats[0].amount == 1'i32, "enchant stat")

block creativeSpendsNothing:
  let p = newTestPlayer(creative = true)
  let h = handler(p, 12345'i32, 15'i32)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.updateEnchantments(p)
  check(ScreenHandler(h).onButtonClick(p, 2'i32), "creative needs no lapis")
  check(p.level == 0'i32, "no levels spent")

block quickMoveAndClicksRefreshOffers:
  let p = newTestPlayer()
  let h = handler(p, 12345'i32, 15'i32)
  # Main 9 is handler slot 2.
  p.setMain(9, stackOf(ITEM_LAPIS_LAZULI, 5))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(1), ITEM_LAPIS_LAZULI, 5, "lapis to its slot")
  p.setMain(9, stackOf(ITEM_DIAMOND_SWORD, 1))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(0), ITEM_DIAMOND_SWORD, 1, "the rest to the item slot")
  check(h.levelRequirements[2] == 30'i32, "offers refreshed")
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_DIAMOND_SWORD, 1, "picked up")
  check(h.levelRequirements[2] == 0'i32, "offers cleared by the click")

block propertiesReachTheClient:
  let p = newTestPlayer()
  let h = handler(p, 0x12345'i32, 15'i32)
  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(p)
  ScreenHandler(h).updateSyncHandler(syncHandler)
  h.updateEnchantments(p)
  check(p.propertyPackets.len == 10, "three of three, and the seed")
  check(p.propertyPackets[0].property == 0'i16, "level requirement 0")
  check(p.propertyPackets[1].property == 4'i16, "enchantment id 0")
  check(p.propertyPackets[2].property == 7'i16, "enchantment level 0")
  check(p.propertyPackets[9].property == 3'i16 and p.propertyPackets[9].value == 0x2345'i16, "the seed, low 16 bits")

block closingReturnsBoth:
  let p = newTestPlayer()
  let h = handler(p, 0'i32, 0'i32)
  h.inventory.setStack(0, stackOf(ITEM_DIAMOND_SWORD, 1))
  h.inventory.setStack(1, stackOf(ITEM_LAPIS_LAZULI, 2))
  ScreenHandler(h).onClosed(p)
  checkStack(p.mainStack(0), ITEM_DIAMOND_SWORD, 1, "item back")
  checkStack(p.mainStack(1), ITEM_LAPIS_LAZULI, 2, "lapis back")

echo "enchanting_screen_handler: OK"
