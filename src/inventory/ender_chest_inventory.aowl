## Port of pumpkin-inventory/src/player/ender_chest_inventory.rs

import inventory, viewer

const InventorySize* = 27

type
  EnderChestInventory* = ref object of ArrayInventory
    tracker: nil ViewerCountTracker  ## For the lid animation.

proc enderOnOpen(self: Inventory) =
  let e = EnderChestInventory(self)
  let tracker = e.tracker
  if tracker != nil:
    tracker.openContainer()

proc enderOnClose(self: Inventory) =
  let e = EnderChestInventory(self)
  let tracker = e.tracker
  if tracker != nil:
    tracker.closeContainer()

proc enderOps(): InventoryOps =
  result = arrayInventoryOps()
  result.onOpen = enderOnOpen
  result.onClose = enderOnClose

let gEnderOps = enderOps()

proc newEnderChestInventory*(): EnderChestInventory =
  EnderChestInventory(ops: gEnderOps, items: emptyStacks(InventorySize), tracker: nil)

proc setTracker*(self: EnderChestInventory; tracker: ViewerCountTracker) =
  self.tracker = tracker

proc hasTracker*(self: EnderChestInventory): bool =
  self.tracker != nil

proc isTracker*(self: EnderChestInventory; tracker: ViewerCountTracker): bool =
  ## `Arc::ptr_eq`.
  let value = self.tracker
  value != nil and cast[pointer](value) == cast[pointer](tracker)
