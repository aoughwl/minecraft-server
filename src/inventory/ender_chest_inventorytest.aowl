## ender_chest_inventory.rs and block/viewer.rs: 27 slots, and the viewer count.

import invtestkit, ender_chest_inventory, inventory, viewer

let chest = newEnderChestInventory()
let inv = Inventory(chest)
check(inv.size() == 27, "size")
inv.onOpen()  # No tracker yet: nothing to count.
check(not chest.hasTracker(), "no tracker")

let tracker = newViewerCountTracker()
let other = newViewerCountTracker()
chest.setTracker(tracker)
check(chest.hasTracker(), "tracker set")
check(chest.isTracker(tracker), "same tracker")
check(not chest.isTracker(other), "other tracker")

inv.onOpen()
inv.onOpen()
check(tracker.getViewerCount() == 2'u16, "two viewers")
inv.onClose()
check(tracker.getViewerCount() == 1'u16, "one left")

inv.setStack(26, stackOf(ITEM_STONE, 5))
checkStack(inv.removeStackSpecific(26, 2'u8), ITEM_STONE, 2, "split")
inv.clear()
check(inv.isEmpty(), "clear")

echo "ender_chest_inventory: OK"
