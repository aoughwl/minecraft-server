## Port of pumpkin-inventory/src/entity_equipment.rs
##
## Upstream's `HashMap<EquipmentSlot, Arc<Mutex<ItemStack>>>` is a `seq` indexed by the enum's ordinal (an `array`
## over the enum stops the compiler; see the port report), with an empty stack for a key the map lacks: `get`
## already answers that, `clear` empties the map, and `get_or_insert` differs only in handing out a shared handle.
## `Arc<Mutex<EntityEquipment>>` is this `ref object`, shared with the entity.

import "../data/item_stack/mod"

type
  EntityEquipment* = ref object
    equipment*: seq[ItemStack]  ## Indexed by `ord(EquipmentSlot)`.

proc newEntityEquipment*(): EntityEquipment =
  result = EntityEquipment(equipment: @[])
  for k in low(EquipmentSlot) .. high(EquipmentSlot):
    result.equipment.add(emptyItemStack())

proc put*(e: EntityEquipment; slot: EquipmentSlot; stack: ItemStack): ItemStack =
  ## Equips an item, returning the previous one or an empty stack.
  result = e.equipment[ord(slot)]
  e.equipment[ord(slot)] = stack

proc getOrInsert*(e: EntityEquipment; slot: EquipmentSlot): ItemStack {.inline.} =
  e.equipment[ord(slot)]

proc get*(e: EntityEquipment; slot: EquipmentSlot): ItemStack {.inline.} =
  e.equipment[ord(slot)]

proc isEmpty*(e: EntityEquipment): bool =
  for k in low(EquipmentSlot) .. high(EquipmentSlot):
    if not e.equipment[ord(k)].isEmpty():
      return false
  true

proc clear*(e: EntityEquipment) =
  for k in low(EquipmentSlot) .. high(EquipmentSlot):
    e.equipment[ord(k)] = emptyItemStack()
