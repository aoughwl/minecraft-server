## entity_equipment.rs.

import invtestkit, entity_equipment

let e = newEntityEquipment()
check(e.isEmpty(), "starts empty")
checkStack(e.put(esHead, stackOf(ITEM_DIAMOND_HELMET, 1)), ITEM_DIAMOND_HELMET, 0, "first put answers empty")
checkStack(e.put(esHead, stackOf(ITEM_IRON_HELMET, 1)), ITEM_DIAMOND_HELMET, 1, "second put answers the old")
checkStack(e.get(esHead), ITEM_IRON_HELMET, 1, "get")
checkStack(e.get(esFeet), ITEM_STONE, 0, "get a slot never set")
checkStack(e.getOrInsert(esHead), ITEM_IRON_HELMET, 1, "get or insert")
check(not e.isEmpty(), "not empty")
e.clear()
check(e.isEmpty(), "clear")

echo "entity_equipment: OK"
