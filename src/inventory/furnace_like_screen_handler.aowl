## Port of pumpkin-inventory/src/furnace_like/furnace_like_screen_handler.rs
## Port of pumpkin-inventory/src/furnace_like/mod.rs
##
## Slots: 0 input, 1 fuel, 2 output. Properties: 0 fire icon, 1 maximum fuel burn time, 2 progress arrow,
## 3 maximum progress. The furnace's tick, which burns the fuel, is the block entity's: pumpkin-world.
##
## As upstream, fuel goes to the range 1..3, so it merges into a matching stack in the output slot too.

import std/options
import "../data/item_stack/mod"
import ../generated/fuels
import ../generated/screen
import furnace_like_slot, inventory, screenhandler, slot, window_property

const
  FuelSlot = 1'i32
  OutputSlot = 2'i32

type
  FurnaceLikeScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory  ## 3 slots: input, fuel, output.
    experienceContainer: ExperienceContainer

  FurnaceLikeScreenListener = ref object of ScreenHandlerListener

proc listenerOnPropertyUpdate(self: ScreenHandlerListener; screenHandler: ScreenHandlerBehaviour; property: uint8;
    value: int32) =
  let syncHandler = screenHandler.syncHandler
  if syncHandler != nil:
    syncHandler.updateProperty(screenHandler.syncId, int32(property), value)

proc furnaceOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  # TODO upstream: self.inventory.on_closed(player).await;

proc furnaceQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  ## From furnace slots to the player; fuel to the fuel slot; anything else to the input.
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if not s.hasStack():
    return stackLeft

  var stack = s.getStack()
  stackLeft = stack

  var success = false
  if slotIndex < 3'i32:
    # Try to move to player inventory (slots 3 onwards, starting from the end)
    success = self.insertItem(stack, 3'i32, int32(self.behaviour.slots.len), true)
  elif isFuel(stack.item.id):
    # Try to move to the Furnace's Fuel slot (slot 1)
    success = self.insertItem(stack, FuelSlot, 3'i32, false)
  else:
    # Try to move to the Furnace's Input/Smelting slot (slot 0)
    success = self.insertItem(stack, 0'i32, 3'i32, false)

  if not success:
    return emptyItemStack()
  s.storeStack(stack)

  if stack.isEmpty():
    s.setStack(emptyItemStack())
  else:
    s.markDirty()

  # Award XP when taking from output slot (slot 2)
  if slotIndex == OutputSlot:
    s.onTakeItem(player, stackLeft)

  stackLeft

proc addInventorySlots(self: FurnaceLikeScreenHandler) =
  ScreenHandler(self).addSlot(newFurnaceLikeSlot(self.inventory, flstTop))
  ScreenHandler(self).addSlot(newFurnaceLikeSlot(self.inventory, flstBottom))
  # Output slot awards experience when items are taken
  ScreenHandler(self).addSlot(newFurnaceOutputSlot(self.inventory, self.experienceContainer))

proc newFurnaceLikeScreenHandler*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory;
    propertyDelegate: PropertyDelegate; experienceContainer: ExperienceContainer;
    windowType: WindowType): FurnaceLikeScreenHandler =
  ## `windowType` is `Furnace`, `Smoker` or `BlastFurnace`.
  result = FurnaceLikeScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(windowType)),
    inventory: inventory, experienceContainer: experienceContainer)
  result.onClosedImpl = furnaceOnClosed
  result.quickMoveImpl = furnaceQuickMove

  # 0: Fire icon (fuel left) counting from fuel burn time down to 0 (in-game ticks)
  # 1: Maximum fuel burn time fuel burn time or 0 (in-game ticks)
  # 2: Progress arrow counting from 0 to maximum progress (in-game ticks)
  # 3: Maximum progress always 200 on the vanilla server
  for i in 0'u8 ..< 4'u8:
    ScreenHandler(result).addProperty(newScreenProperty(propertyDelegate, i))

  ScreenHandler(result).addListener(FurnaceLikeScreenListener(onPropertyUpdateImpl: listenerOnPropertyUpdate))
  result.addInventorySlots()
  ScreenHandler(result).addPlayerSlots(playerInventory)
