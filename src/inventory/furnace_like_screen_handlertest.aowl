## furnace_like_screen_handler.rs and furnace_like_slot.rs: the fuel slot, the output slot's experience, and the
## four properties. Burning is the block entity's tick; this crate decides what may be fuel and how much it burns.

import std/options
import invtestkit, furnace_like_screen_handler, inventory, screenhandler, slot, window_property
import ../generated/fuels
import ../generated/screen
import ../generated/statistic

type
  ArrayDelegate = ref object of PropertyDelegate
    values: seq[int32]

  OneShotExperience = ref object of ExperienceContainer
    stored: int32

proc arrayGet(self: PropertyDelegate; index: int32): int32 =
  let d = ArrayDelegate(self)
  d.values[int(index)]

proc arraySet(self: PropertyDelegate; index: int32; value: int32) =
  let d = ArrayDelegate(self)
  d.values[int(index)] = value

proc arraySize(self: PropertyDelegate): int32 =
  let d = ArrayDelegate(self)
  int32(d.values.len)

proc newDelegate(): ArrayDelegate =
  ArrayDelegate(values: @[0'i32, 0'i32, 0'i32, 200'i32], getPropertyImpl: arrayGet, setPropertyImpl: arraySet,
    getPropertiesSizeImpl: arraySize)

proc oneShotExtract(self: ExperienceContainer): int32 =
  let e = OneShotExperience(self)
  result = e.stored
  e.stored = 0'i32

proc handler(p: TestPlayer; delegate: PropertyDelegate; xp = 0'i32): FurnaceLikeScreenHandler =
  newFurnaceLikeScreenHandler(1'u8, p.inventory, newArrayInventory(3), delegate,
    OneShotExperience(stored: xp, extractExperienceImpl: oneShotExtract), wtFurnace)

block burnTimes:
  # generated from assets/fuels.json, as upstream's `get_item_burn_ticks`.
  check(getItemBurnTicks(ITEM_COAL.id).unsafeGet == 1600'u16, "coal")
  check(getItemBurnTicks(ITEM_COAL_BLOCK.id).unsafeGet == 16000'u16, "coal block")
  check(getItemBurnTicks(ITEM_LAVA_BUCKET.id).unsafeGet == 20000'u16, "lava bucket")
  check(getItemBurnTicks(ITEM_STICK.id).unsafeGet == 100'u16, "stick")
  check(getItemBurnTicks(ITEM_STONE.id).isNone, "stone does not burn")
  check(isFuel(ITEM_OAK_PLANKS.id), "planks burn")
  check(not isFuel(ITEM_BUCKET.id), "an empty bucket does not burn")

block slotRestrictions:
  let p = newTestPlayer()
  let h = handler(p, newDelegate())
  let top = h.behaviour.slots[0]
  let fuel = h.behaviour.slots[1]
  let output = h.behaviour.slots[2]
  check(top.index == 0 and fuel.index == 1 and output.index == 2, "indices")
  check(top.canInsert(stackOf(ITEM_STONE, 1)), "anything on top")
  check(fuel.canInsert(stackOf(ITEM_COAL, 1)), "coal as fuel")
  check(fuel.canInsert(stackOf(ITEM_BUCKET, 1)), "empty bucket allowed in the fuel slot")
  check(not fuel.canInsert(stackOf(ITEM_STONE, 1)), "stone not as fuel")
  check(not output.canInsert(stackOf(ITEM_STONE, 1)), "nothing into the output")

block clicksRespectThem:
  let p = newTestPlayer()
  let h = handler(p, newDelegate())
  h.behaviour.cursorStack = stackOf(ITEM_STONE, 5)
  ScreenHandler(h).onSlotClick(1'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_STONE, 5, "stone refused by the fuel slot")
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_STONE, 5, "stone refused by the output")
  h.behaviour.cursorStack = stackOf(ITEM_COAL, 5)
  ScreenHandler(h).onSlotClick(1'i32, 0'i32, satPickup, p)
  checkStack(h.inventory.getStack(1), ITEM_COAL, 5, "coal accepted")

block quickMoveRoutes:
  # Main 9 is handler slot 3.
  let p = newTestPlayer()
  let h = handler(p, newDelegate())
  p.setMain(9, stackOf(ITEM_COAL, 5))
  ScreenHandler(h).onSlotClick(3'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(1), ITEM_COAL, 5, "fuel to the fuel slot")
  p.setMain(9, stackOf(ITEM_IRON_ORE, 5))
  ScreenHandler(h).onSlotClick(3'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(0), ITEM_IRON_ORE, 5, "anything else to the input")
  ScreenHandler(h).onSlotClick(1'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_COAL, 5, "out to the player's end")

block aFullFuelSlotOverflowsNowhereButTheOutputIfItMatches:
  # The range is 1..3, so a burnable result in the output takes the rest. Upstream's range.
  let p = newTestPlayer()
  let h = handler(p, newDelegate())
  h.inventory.setStack(1, stackOf(ITEM_COAL, 64))
  h.inventory.setStack(2, stackOf(ITEM_COAL, 1))
  p.setMain(9, stackOf(ITEM_COAL, 5))
  ScreenHandler(h).onSlotClick(3'i32, 0'i32, satQuickMove, p)
  checkStack(h.inventory.getStack(2), ITEM_COAL, 6, "merged into the output")
  checkStack(p.mainStack(9), ITEM_COAL, 0, "source spent")

block takingTheOutputAwardsExperience:
  let p = newTestPlayer()
  let h = handler(p, newDelegate(), xp = 7'i32)
  h.inventory.setStack(2, stackOf(ITEM_IRON_INGOT, 3))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_IRON_INGOT, 3, "taken")
  check(p.xp == 7'i32, "experience awarded")
  check(p.stats.len == 1 and p.stats[0].category == scCrafted and p.stats[0].statId == int32(ITEM_IRON_INGOT.id) and
    p.stats[0].amount == 3'i32, "crafted stat")

block shiftClickingTheOutputAwardsExperience:
  let p = newTestPlayer()
  let h = handler(p, newDelegate(), xp = 7'i32)
  h.inventory.setStack(2, stackOf(ITEM_IRON_INGOT, 3))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_IRON_INGOT, 3, "moved")
  check(p.xp == 7'i32, "experience awarded once: the second pass finds no stack")

block aFullCursorTakesNoPartOfAnOutputStack:
  # `allow_modification` is false for the output, so a stack bigger than the room is refused whole.
  let p = newTestPlayer()
  let h = handler(p, newDelegate())
  h.inventory.setStack(2, stackOf(ITEM_IRON_INGOT, 60))
  h.behaviour.cursorStack = stackOf(ITEM_IRON_INGOT, 10)
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  checkStack(h.inventory.getStack(2), ITEM_IRON_INGOT, 60, "output untouched")
  checkStack(h.behaviour.cursorStack, ITEM_IRON_INGOT, 10, "cursor untouched")
  h.inventory.setStack(2, stackOf(ITEM_IRON_INGOT, 50))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_IRON_INGOT, 60, "fits: all of it")
  checkStack(h.inventory.getStack(2), ITEM_IRON_INGOT, 0, "output spent")

block propertiesReachTheClient:
  let p = newTestPlayer()
  let delegate = newDelegate()
  let h = handler(p, delegate)
  check(h.behaviour.properties.len == 4, "four properties")
  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(p)
  ScreenHandler(h).updateSyncHandler(syncHandler)
  # The full state sends all four: fire 0, max burn 0, arrow 0, max progress 200.
  check(p.propertyPackets.len == 4, "full state sends the properties")
  check(p.propertyPackets[3].property == 3'i16 and p.propertyPackets[3].value == 200'i16, "max progress")

  # The furnace lights: fuel burn time 1600.
  delegate.values[0] = 1600'i32
  delegate.values[1] = 1600'i32
  ScreenHandler(h).sendContentUpdates()
  check(p.propertyPackets.len == 6, "the two changed, through the listener")
  check(p.propertyPackets[4].property == 0'i16 and p.propertyPackets[4].value == 1600'i16, "fire icon")
  check(p.propertyPackets[5].property == 1'i16 and p.propertyPackets[5].value == 1600'i16, "max burn time")

  ScreenHandler(h).sendContentUpdates()
  check(p.propertyPackets.len == 6, "no change, nothing sent")

  # It burns a tick.
  delegate.values[0] = 1599'i32
  ScreenHandler(h).sendContentUpdates()
  check(p.propertyPackets.len == 7 and p.propertyPackets[6].value == 1599'i16, "the burn is sent")

echo "furnace_like_screen_handler: OK"
