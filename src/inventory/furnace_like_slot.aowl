## Port of pumpkin-inventory/src/furnace_like/furnace_like_slot.rs

import "../data/item_stack/mod"
import ../generated/fuels
import ../generated/statistic
import inventory, player_inventory, slot, window_property

type
  FurnaceLikeSlotType* = enum
    ## The ordinal is the slot's index in the furnace's inventory.
    flstTop = 0     ## Input: accepts items to smelt.
    flstBottom = 1  ## Fuel: accepts fuel items.

  FurnaceLikeSlot* = ref object of Slot
    slotType*: FurnaceLikeSlotType

  FurnaceOutputSlot* = ref object of Slot
    experienceContainer*: ExperienceContainer

proc furnaceCanInsert(self: Slot; stack: ItemStack): bool =
  ## The top slot takes anything; the bottom one fuel, and buckets.
  let f = FurnaceLikeSlot(self)
  case f.slotType
  of flstTop: true
  of flstBottom: isFuel(stack.item.id) or stack.item.id == ITEM_BUCKET.id

proc newFurnaceLikeSlot*(inventory: Inventory; slotType: FurnaceLikeSlotType): FurnaceLikeSlot =
  result = FurnaceLikeSlot(inventory: inventory, index: ord(slotType), id: 0'u8, slotType: slotType)
  result.canInsertImpl = furnaceCanInsert

proc outputOnTakeItem(self: Slot; player: InventoryPlayer; stack: ItemStack) =
  ## Awards the accumulated experience when items are taken.
  player.incrementStat(scCrafted, int32(stack.item.id), int32(stack.itemCount))
  let output = FurnaceOutputSlot(self)
  let experience = output.experienceContainer.extractExperience()
  if experience > 0'i32:
    player.awardExperience(experience)
  self.markDirty()

proc outputCanInsert(self: Slot; stack: ItemStack): bool = false

proc newFurnaceOutputSlot*(inventory: Inventory; experienceContainer: ExperienceContainer): FurnaceOutputSlot =
  result = FurnaceOutputSlot(inventory: inventory, index: 2, id: 0'u8, experienceContainer: experienceContainer)
  result.onTakeItemImpl = outputOnTakeItem
  result.canInsertImpl = outputCanInsert
