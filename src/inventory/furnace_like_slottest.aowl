## furnace_like_slot.rs on its own: what each slot takes, and that the output's experience goes once.

import invtestkit, furnace_like_slot, inventory, slot, window_property
import ../generated/statistic

type OneShot = ref object of ExperienceContainer
  stored: int32

proc oneShotExtract(self: ExperienceContainer): int32 =
  let e = OneShot(self)
  result = e.stored
  e.stored = 0'i32

let inv = newArrayInventory(3)
let top = newFurnaceLikeSlot(inv, flstTop)
let bottom = newFurnaceLikeSlot(inv, flstBottom)
check(top.index == 0 and bottom.index == 1, "indices")
check(top.canInsert(stackOf(ITEM_STONE, 1)), "top takes anything")
check(bottom.canInsert(stackOf(ITEM_COAL, 1)), "bottom takes fuel")
check(bottom.canInsert(stackOf(ITEM_BUCKET, 1)), "bottom takes a bucket")
check(not bottom.canInsert(stackOf(ITEM_STONE, 1)), "bottom refuses stone")

let player = newTestPlayer()
let output = newFurnaceOutputSlot(inv, OneShot(stored: 9'i32, extractExperienceImpl: oneShotExtract))
check(output.index == 2, "output index")
check(not output.canInsert(stackOf(ITEM_STONE, 1)), "output takes nothing")
output.onTakeItem(player, stackOf(ITEM_IRON_INGOT, 2))
check(player.xp == 9'i32, "experience")
check(player.stats.len == 1 and player.stats[0].category == scCrafted and player.stats[0].amount == 2'i32, "stat")
output.onTakeItem(player, stackOf(ITEM_IRON_INGOT, 2))
check(player.xp == 9'i32, "nothing more to extract")

echo "furnace_like_slot: OK"
