## Port of pumpkin-inventory/src/generic_container_screen_handler.rs
##
## As upstream, `quick_move` uses `rows * 9` as the boundary, not `rows * columns`: right for every 9-wide container,
## and for a 3x3 or the 1x5 hopper it sits past the container's own slots.

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import inventory, screenhandler, slot

type
  GenericContainerScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory
    rows*: uint8
    columns*: uint8

proc genericOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  let g = GenericContainerScreenHandler(self)
  g.inventory.onClose()

proc genericQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  let g = GenericContainerScreenHandler(self)
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if s.hasStack():
    var slotStackMut = s.getStack()
    stackLeft = slotStackMut

    let boundary = int32(g.rows) * 9'i32
    if slotIndex < boundary:
      # Move from inventory to player area (end)
      if not self.insertItem(slotStackMut, boundary, int32(self.behaviour.slots.len), true):
        return emptyItemStack()
    elif not self.insertItem(slotStackMut, 0'i32, boundary, false):
      # Move from player area to inventory (start)
      return emptyItemStack()
    s.storeStack(slotStackMut)

    # Check the resulting state of the slot stack after insert_item
    if slotStackMut.isEmpty():
      s.setStack(emptyItemStack())
    else:
      s.markDirty()

  stackLeft

proc addInventorySlots(g: GenericContainerScreenHandler) =
  for i in 0'u8 ..< g.rows:
    for j in 0'u8 ..< g.columns:
      ScreenHandler(g).addSlot(newNormalSlot(g.inventory, int(j) + int(i) * int(g.columns)))

proc newGenericContainerScreenHandler(screenType: WindowType; syncId: uint8; playerInventory: PlayerInventory;
    inventory: Inventory; rows, columns: uint8): GenericContainerScreenHandler =
  result = GenericContainerScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(screenType)),
    inventory: inventory, rows: rows, columns: columns)
  result.onClosedImpl = genericOnClosed
  result.quickMoveImpl = genericQuickMove

  # TODO upstream: add player entity as a parameter
  inventory.onOpen()

  result.addInventorySlots()
  ScreenHandler(result).addPlayerSlots(playerInventory)

proc createGeneric9x3*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): GenericContainerScreenHandler =
  ## Single chests, ender chests and similar.
  newGenericContainerScreenHandler(wtGeneric9x3, syncId, playerInventory, inventory, 3'u8, 9'u8)

proc createGeneric9x6*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): GenericContainerScreenHandler =
  ## Double chests and similar.
  newGenericContainerScreenHandler(wtGeneric9x6, syncId, playerInventory, inventory, 6'u8, 9'u8)

proc createGeneric3x3*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): GenericContainerScreenHandler =
  ## Dispensers, droppers and similar.
  newGenericContainerScreenHandler(wtGeneric3x3, syncId, playerInventory, inventory, 3'u8, 3'u8)

proc createCrafter3x3*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): GenericContainerScreenHandler =
  newGenericContainerScreenHandler(wtCrafter3x3, syncId, playerInventory, inventory, 3'u8, 3'u8)

proc createHopper*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory): GenericContainerScreenHandler =
  ## A single row of 5 slots.
  newGenericContainerScreenHandler(wtHopper, syncId, playerInventory, inventory, 1'u8, 5'u8)
