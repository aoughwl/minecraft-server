## generic_container_screen_handler.rs: the five factories' shapes, and `quick_move` at the `rows * 9` boundary.

import std/options
import invtestkit, genericcontainer, inventory, screenhandler
import ../generated/screen

block shapes:
  let player = newTestPlayer()
  let chest = createGeneric9x3(0'u8, player.inventory, newArrayInventory(27))
  check(chest.rows == 3'u8 and chest.columns == 9'u8, "9x3 shape")
  check(chest.behaviour.slots.len == 27 + 36, "9x3 slots")
  check(chest.behaviour.windowType == some(wtGeneric9x3), "9x3 window")

  let large = createGeneric9x6(0'u8, player.inventory, newArrayInventory(54))
  check(large.behaviour.slots.len == 54 + 36, "9x6 slots")

  let dispenser = createGeneric3x3(0'u8, player.inventory, newArrayInventory(9))
  check(dispenser.behaviour.slots.len == 9 + 36, "3x3 slots")

  let crafter = createCrafter3x3(0'u8, player.inventory, newArrayInventory(9))
  check(crafter.behaviour.windowType == some(wtCrafter3x3), "crafter window")

  let hopper = createHopper(1'u8, player.inventory, newArrayInventory(5))
  check(hopper.rows == 1'u8 and hopper.columns == 5'u8, "hopper shape")
  check(hopper.behaviour.slots.len == 5 + 36, "hopper slots")

block slotsAreInGridOrderThenMainThenHotbar:
  let player = newTestPlayer()
  let inv = newArrayInventory(27)
  let h = createGeneric9x3(0'u8, player.inventory, inv)
  check(h.behaviour.slots[10].index == 10, "grid slot index")
  check(h.behaviour.slots[27].index == 9, "first main slot")
  check(h.behaviour.slots[53].index == 35, "last main slot")
  check(h.behaviour.slots[54].index == 0, "first hotbar slot")
  check(h.behaviour.slots[62].index == 8, "last hotbar slot")
  check(h.behaviour.slots[62].id == 62'u8, "slot ids follow")

block hopperQuickMoveKeepsTheRows9Boundary:
  # As upstream, the boundary is rows * 9 = 9, so player slots 5-8 of the handler count as the container.
  let player = newTestPlayer()
  let inv = newArrayInventory(5)
  let h = createHopper(1'u8, player.inventory, inv)
  player.setMain(9, stackOf(ITEM_STONE, 3))  # handler slot 5, below the boundary
  let moved = ScreenHandler(h).quickMove(player, 5'i32)
  checkStack(moved, ITEM_STONE, 3, "hopper quick move answers the stack")
  checkStack(player.mainStack(9), ITEM_STONE, 0, "hopper quick move, source")
  checkStack(player.mainStack(8), ITEM_STONE, 3, "hopper quick move goes to the player's end")

block closeReachesTheInventory:
  let player = newTestPlayer()
  let h = createGeneric9x3(0'u8, player.inventory, newArrayInventory(27))
  h.behaviour.cursorStack = stackOf(ITEM_DIRT, 2)
  ScreenHandler(h).onClosed(player)
  check(h.behaviour.cursorStack.isEmpty(), "cursor cleared on close")
  checkStack(player.mainStack(0), ITEM_DIRT, 2, "cursor offered on close")

echo "genericcontainer: OK"
