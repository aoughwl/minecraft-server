## Port of pumpkin-inventory/src/gui_builder.rs

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import inventory, screenhandler, slot

type
  GUIBuilder* = object
    screenType: WindowType
    rows: uint8
    columns: uint8
    target: Inventory
    allowGrabItems: bool
    allowPutItems: bool

  GUIScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory
    rows*: uint8
    columns*: uint8

proc newGUIBuilder*(screenType: WindowType; inventory: Inventory): GUIBuilder =
  ## Starts from the screen type's own layout; anything else is 9x3.
  var rows = 3'u8
  var columns = 9'u8
  case screenType
  of wtGeneric9x1:
    rows = 1'u8
  of wtGeneric9x2:
    rows = 2'u8
  of wtGeneric9x4:
    rows = 4'u8
  of wtGeneric9x5:
    rows = 5'u8
  of wtGeneric9x6:
    rows = 6'u8
  of wtGeneric3x3, wtCrafter3x3:
    rows = 3'u8
    columns = 3'u8
  of wtHopper:
    rows = 1'u8
    columns = 5'u8
  else:
    discard
  GUIBuilder(screenType: screenType, rows: rows, columns: columns, target: inventory, allowGrabItems: true,
    allowPutItems: true)

proc allowGrabItems*(self: GUIBuilder; allow: bool): GUIBuilder =
  ## Whether players can grab items out of the inventory.
  result = self
  result.allowGrabItems = allow

proc allowPutItems*(self: GUIBuilder; allow: bool): GUIBuilder =
  ## Whether players can put items into the inventory from their own.
  result = self
  result.allowPutItems = allow

proc guiOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  let g = GUIScreenHandler(self)
  g.inventory.onClose()

proc guiQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  let g = GUIScreenHandler(self)
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if s.hasStack():
    var slotStackMut = s.getStack()
    stackLeft = slotStackMut
    let containerSlots = int32(g.rows) * int32(g.columns)

    if slotIndex < containerSlots:
      # From container to player
      if not self.behaviour.allowGrabItems:
        return emptyItemStack()
      if not self.insertItem(slotStackMut, containerSlots, int32(self.behaviour.slots.len), true):
        return emptyItemStack()
    else:
      # From player to container
      if not self.behaviour.allowPutItems:
        return emptyItemStack()
      if not self.insertItem(slotStackMut, 0'i32, containerSlots, false):
        return emptyItemStack()
    s.storeStack(slotStackMut)

    if slotStackMut.isEmpty():
      s.setStack(emptyItemStack())
    else:
      s.markDirty()

  stackLeft

proc addInventorySlots(g: GUIScreenHandler) =
  for i in 0'u8 ..< g.rows:
    for j in 0'u8 ..< g.columns:
      ScreenHandler(g).addSlot(newNormalSlot(g.inventory, int(j) + int(i) * int(g.columns)))

proc build*(self: GUIBuilder; syncId: uint8; playerInventory: PlayerInventory): GUIScreenHandler =
  let target = self.target
  let behaviour = newScreenHandlerBehaviour(syncId, some(self.screenType))
  behaviour.allowGrabItems = self.allowGrabItems
  behaviour.allowPutItems = self.allowPutItems
  behaviour.containerSlots = int(self.rows) * int(self.columns)

  result = GUIScreenHandler(behaviour: behaviour, inventory: target, rows: self.rows, columns: self.columns)
  result.onClosedImpl = guiOnClosed
  result.quickMoveImpl = guiQuickMove

  target.onOpen()

  result.addInventorySlots()
  ScreenHandler(result).addPlayerSlots(playerInventory)
