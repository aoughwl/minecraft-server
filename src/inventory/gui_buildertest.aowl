## gui_builder.rs: layouts, and the grab and put flags.

import invtestkit, gui_builder, inventory, screenhandler
import ../generated/screen

block guiBuilder:
  let p = newTestPlayer()
  let hopper = newGUIBuilder(wtHopper, Inventory(newArrayInventory(5))).build(1'u8, p.inventory)
  check(hopper.rows == 1'u8 and hopper.columns == 5'u8, "hopper layout")
  check(hopper.behaviour.containerSlots == 5, "container slots")
  check(hopper.behaviour.slots.len == 41, "slots")
  let furnaceShaped = newGUIBuilder(wtFurnace, Inventory(newArrayInventory(27))).build(1'u8, p.inventory)
  check(furnaceShaped.rows == 3'u8 and furnaceShaped.columns == 9'u8, "anything else is 9x3")
  let six = newGUIBuilder(wtGeneric9x6, Inventory(newArrayInventory(54))).build(1'u8, p.inventory)
  check(six.rows == 6'u8, "9x6 layout")

  # Grab and put are checked on quick move only, as upstream.
  let inv = newArrayInventory(9)
  let locked = newGUIBuilder(wtGeneric3x3, Inventory(inv)).allowGrabItems(false).allowPutItems(false).build(1'u8, p.inventory)
  check(not locked.behaviour.allowGrabItems and not locked.behaviour.allowPutItems, "flags")
  Inventory(inv).setStack(0, stackOf(ITEM_STONE, 1))
  ScreenHandler(locked).onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(inv).getStack(0), ITEM_STONE, 1, "no grabbing")
  p.setMain(9, stackOf(ITEM_DIRT, 1))
  ScreenHandler(locked).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_DIRT, 1, "no putting")

  let openInv = newArrayInventory(9)
  let free = newGUIBuilder(wtGeneric3x3, Inventory(openInv)).build(1'u8, p.inventory)
  Inventory(openInv).setStack(0, stackOf(ITEM_STONE, 1))
  ScreenHandler(free).onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_STONE, 1, "grabbing, to the player's end")
  ScreenHandler(free).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(openInv).getStack(0), ITEM_DIRT, 1, "putting")

echo "gui_builder: OK"
