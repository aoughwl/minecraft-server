## error.rs: `#[error(..)]`'s text, as written upstream.

import invtestkit, invbase

check($lockError() == "Unable to lock", "lock")
check($invalidSlot() == "Invalid slot", "slot")
check($closedContainerInteract(7'i32) == "Player '7' tried to interact with a closed container", "closed")
check($multiplePlayersDragging() == "Multiple players dragging in a container at once", "dragging")
check($outOfOrderDragging() == "Out of order dragging", "out of order")
check($invalidPacket() == "Invalid inventory packet", "packet")
check($permissionError() == "Player does not have enough permissions", "permission")

echo "invbase: OK"
