## Port of pumpkin-world/src/inventory/inventory.rs
##
## `Inventory: Send + Sync + Clearable` is a `ref object`. A concrete inventory in this crate subclasses it, so
## upstream's coercion from `Arc<PlayerInventory>` to `Arc<dyn Inventory>` is a plain conversion and two
## references compare by identity, and fills `ops`: a table of plain procs taking the inventory as `self`. An
## inventory elsewhere may instead fill the `*Impl` closure fields, as src/world/simpleinventory.aowl does.
## The wrappers below take `ops` if it is set. Both call through a local, and the plain procs carry no
## environment, which keeps this crate clear of the closure hazards in the port report.
##
## `get_stack` upstream answers `Arc<Mutex<ItemStack>>`. Here `getStack` answers a copy (an `ItemStack`
## assignment is upstream's `clone`), and `storeStack` is the other half of `*stack.lock() = ..`: it writes the
## slot without going through `set_stack`, which an inventory may override with side effects. It defaults to
## `setStack`. A read, change, `storeStack` is what upstream's held lock does, in the same order.

import std/options
import "../data/item_stack/mod"
import ../nbt/tag

type
  InventoryOps* = ref object
    ## The trait's methods for an inventory in this crate. The optional ones may be left nil.
    size*: proc(self: Inventory): int {.nimcall.}
    isEmpty*: proc(self: Inventory): bool {.nimcall.}
    getStack*: proc(self: Inventory; slot: int): ItemStack {.nimcall.}
    removeStack*: proc(self: Inventory; slot: int): ItemStack {.nimcall.}
    removeStackSpecific*: proc(self: Inventory; slot: int; amount: uint8): ItemStack {.nimcall.}
    setStack*: proc(self: Inventory; slot: int; stack: ItemStack) {.nimcall.}
    storeStack*: proc(self: Inventory; slot: int; stack: ItemStack) {.nimcall.}  ## default: setStack
    onOpen*: proc(self: Inventory) {.nimcall.}  ## default: no-op
    onClose*: proc(self: Inventory) {.nimcall.}  ## default: no-op
    getMaxCountPerStack*: proc(self: Inventory): uint8 {.nimcall.}  ## default: 99
    markDirty*: proc(self: Inventory) {.nimcall.}  ## default: no-op
    isValidSlotFor*: proc(self: Inventory; slot: int; stack: ItemStack): bool {.nimcall.}  ## default: true
    clear*: proc(self: Inventory) {.nimcall.}  ## Clearable::clear

  Inventory* = ref object of RootObj
    ops*: nil InventoryOps
    sizeImpl*: proc(): int {.closure.}
    isEmptyImpl*: proc(): bool {.closure.}
    getStackImpl*: proc(slot: int): ItemStack {.closure.}
    removeStackImpl*: proc(slot: int): ItemStack {.closure.}
    removeStackSpecificImpl*: proc(slot: int, amount: uint8): ItemStack {.closure.}
    setStackImpl*: proc(slot: int, stack: ItemStack) {.closure.}
    storeStackImpl*: proc(slot: int, stack: ItemStack) {.closure.}  ## default: setStackImpl
    onOpenImpl*: proc() {.closure.}  ## default: no-op
    onCloseImpl*: proc() {.closure.}  ## default: no-op
    getMaxCountPerStackImpl*: proc(): uint8 {.closure.}  ## default: 99
    markDirtyImpl*: proc() {.closure.}  ## default: no-op
    isValidSlotForImpl*: proc(slot: int, stack: ItemStack): bool {.closure.}  ## default: true
    clearImpl*: proc() {.closure.}  ## Clearable::clear

proc size*(inv: Inventory): int =
  let ops = inv.ops
  if ops != nil:
    let f = ops.size
    f(inv)
  else:
    let f = inv.sizeImpl
    f()

proc isEmpty*(inv: Inventory): bool =
  let ops = inv.ops
  if ops != nil:
    let f = ops.isEmpty
    f(inv)
  else:
    let f = inv.isEmptyImpl
    f()

proc getStack*(inv: Inventory; slot: int): ItemStack =
  let ops = inv.ops
  if ops != nil:
    let f = ops.getStack
    f(inv, slot)
  else:
    let f = inv.getStackImpl
    f(slot)

proc removeStack*(inv: Inventory; slot: int): ItemStack =
  let ops = inv.ops
  if ops != nil:
    let f = ops.removeStack
    f(inv, slot)
  else:
    let f = inv.removeStackImpl
    f(slot)

proc removeStackSpecific*(inv: Inventory; slot: int; amount: uint8): ItemStack =
  let ops = inv.ops
  if ops != nil:
    let f = ops.removeStackSpecific
    f(inv, slot, amount)
  else:
    let f = inv.removeStackSpecificImpl
    f(slot, amount)

proc setStack*(inv: Inventory; slot: int; stack: ItemStack) =
  let ops = inv.ops
  if ops != nil:
    let f = ops.setStack
    f(inv, slot, stack)
  else:
    let f = inv.setStackImpl
    f(slot, stack)

proc storeStack*(inv: Inventory; slot: int; stack: ItemStack) =
  ## The write half of `*inv.get_stack(slot).await.lock().await = stack`.
  let ops = inv.ops
  if ops != nil:
    let f = ops.storeStack
    if f != nil:
      f(inv, slot, stack)
      return
  else:
    let f = inv.storeStackImpl
    if f != nil:
      f(slot, stack)
      return
  inv.setStack(slot, stack)

proc onOpen*(inv: Inventory) =
  let ops = inv.ops
  if ops != nil:
    let f = ops.onOpen
    if f != nil: f(inv)
  else:
    let f = inv.onOpenImpl
    if f != nil: f()

proc onClose*(inv: Inventory) =
  let ops = inv.ops
  if ops != nil:
    let f = ops.onClose
    if f != nil: f(inv)
  else:
    let f = inv.onCloseImpl
    if f != nil: f()

proc getMaxCountPerStack*(inv: Inventory): uint8 =
  let ops = inv.ops
  if ops != nil:
    let f = ops.getMaxCountPerStack
    if f != nil:
      return f(inv)
  else:
    let f = inv.getMaxCountPerStackImpl
    if f != nil:
      return f()
  99'u8

proc markDirty*(inv: Inventory) =
  let ops = inv.ops
  if ops != nil:
    let f = ops.markDirty
    if f != nil: f(inv)
  else:
    let f = inv.markDirtyImpl
    if f != nil: f()

proc isValidSlotFor*(inv: Inventory; slot: int; stack: ItemStack): bool =
  let ops = inv.ops
  if ops != nil:
    let f = ops.isValidSlotFor
    if f != nil:
      return f(inv, slot, stack)
  else:
    let f = inv.isValidSlotForImpl
    if f != nil:
      return f(slot, stack)
  true

proc clear*(inv: Inventory) =
  ## `Clearable::clear`.
  let ops = inv.ops
  if ops != nil:
    let f = ops.clear
    if f != nil: f(inv)
  else:
    let f = inv.clearImpl
    if f != nil: f()

proc count*(inv: Inventory; item: Item): uint8 =
  result = 0'u8
  for i in 0 ..< inv.size():
    let stack = inv.getStack(i)
    if stack.getItem().id == item.id:
      result += stack.itemCount

proc containsAnyPredicate*(inv: Inventory; predicate: proc(s: ItemStack): bool {.closure.}): bool =
  for i in 0 ..< inv.size():
    if predicate(inv.getStack(i)):
      return true
  false

proc containsAny*(inv: Inventory; items: seq[Item]): bool =
  ## Upstream's `contains_any_predicate(&|stack| ...)`, as a loop: no closure over `items`.
  for i in 0 ..< inv.size():
    let stack = inv.getStack(i)
    if stack.isEmpty():
      continue
    for it in items:
      if it.id == stack.getItem().id:
        return true
  false

proc canTransferTo*(inv: Inventory; hopperInventory: Inventory; slot: int; stack: ItemStack): bool =
  ## The default body.
  true

proc writeInventoryNbt*(inv: Inventory; nbt: var NbtCompound; includeEmpty: bool) =
  var slots: seq[NbtTag] = @[]
  let size = inv.size()
  for i in 0 ..< size:
    let stack = inv.getStack(i)
    if not stack.isEmpty():
      var itemCompound = newCompound()
      putByte(itemCompound, "Slot", cast[int8](uint8(i and 0xFF)))
      stack.writeItemStack(itemCompound)
      slots.add(nbtTag(itemCompound))
  if includeEmpty or slots.len > 0:
    put(nbt, "Items", NbtTag(kind: ntkList, listVal: slots))

proc syncReadItemsFromNbt*(nbt: NbtCompound; stacks: var seq[ItemStack]) =
  ## `read_data`'s body.
  let inventoryList = getList(nbt, "Items")
  if inventoryList.isSome:
    for tag in inventoryList.unsafeGet:
      if tag.kind == ntkCompound:
        let slotByte = getByte(tag.compoundVal, "Slot")
        if slotByte.isSome:
          let slot = int(slotByte.unsafeGet)
          if slot >= 0 and slot < stacks.len:
            let itemStack = readItemStack(tag.compoundVal)
            if itemStack.isSome:
              stacks[slot] = itemStack.unsafeGet

proc readData*(inv: Inventory; nbt: NbtCompound; stacks: var seq[ItemStack]) =
  syncReadItemsFromNbt(nbt, stacks)

proc syncWriteItemsToNbt*(items: seq[ItemStack]; nbt: var NbtCompound) =
  var slots: seq[NbtTag] = @[]
  for i in 0 ..< items.len:
    if not items[i].isEmpty():
      var itemNbt = newCompound()
      putByte(itemNbt, "Slot", cast[int8](uint8(i and 0xFF)))
      items[i].writeItemStack(itemNbt)
      slots.add(nbtTag(itemNbt))
  if slots.len > 0:
    putList(nbt, "Items", slots)

type
  ComparableInventory* = object
    ## `ComparableInventory(pub Arc<dyn Inventory>)`: equal and hashed by identity, not content.
    inv*: Inventory

proc `==`*(a, b: ComparableInventory): bool {.inline.} =
  cast[pointer](a.inv) == cast[pointer](b.inv)

proc hash*(c: ComparableInventory): int {.inline.} =
  cast[int](cast[pointer](c.inv))

# --- A fixed run of stacks -----------------------------------------------------------------------------------

type
  ArrayInventory* = ref object of Inventory
    ## Not an upstream type. `CraftingInventory`, `EnderChestInventory` and the inventories in
    ## `StonecutterScreenHandler` all hold upstream's `[Arc<Mutex<ItemStack>>; N]` and the same seven methods;
    ## this is those methods, the same bodies, over one `seq`. A subclass takes `arrayInventoryOps()` and adds
    ## its own `onOpen` and `onClose`. The stonecutter's two are upstream's `SimpleInventory`.
    items*: seq[ItemStack]

proc arraySize(self: Inventory): int =
  let a = ArrayInventory(self)
  a.items.len

proc arrayIsEmpty(self: Inventory): bool =
  let a = ArrayInventory(self)
  for i in 0 ..< a.items.len:
    if not a.items[i].isEmpty():
      return false
  true

proc arrayGetStack(self: Inventory; slot: int): ItemStack =
  let a = ArrayInventory(self)
  a.items[slot]

proc arrayRemoveStack(self: Inventory; slot: int): ItemStack =
  let a = ArrayInventory(self)
  result = a.items[slot]
  a.items[slot] = emptyItemStack()

proc arrayRemoveStackSpecific(self: Inventory; slot: int; amount: uint8): ItemStack =
  ## `split_stack`.
  let a = ArrayInventory(self)
  if slot < a.items.len and not a.items[slot].isEmpty() and amount > 0'u8:
    a.items[slot].split(amount)
  else:
    emptyItemStack()

proc arraySetStack(self: Inventory; slot: int; stack: ItemStack) =
  let a = ArrayInventory(self)
  a.items[slot] = stack

proc arrayClear(self: Inventory) =
  let a = ArrayInventory(self)
  for i in 0 ..< a.items.len:
    a.items[i] = emptyItemStack()

proc arrayInventoryOps*(): InventoryOps =
  InventoryOps(size: arraySize, isEmpty: arrayIsEmpty, getStack: arrayGetStack, removeStack: arrayRemoveStack,
    removeStackSpecific: arrayRemoveStackSpecific, setStack: arraySetStack, clear: arrayClear)

let gArrayInventoryOps = arrayInventoryOps()

proc emptyStacks*(size: int): seq[ItemStack] =
  result = newSeq[ItemStack](size)
  for i in 0 ..< size:
    result[i] = emptyItemStack()

proc newArrayInventory*(size: int): ArrayInventory =
  ArrayInventory(ops: gArrayInventoryOps, items: emptyStacks(size))
