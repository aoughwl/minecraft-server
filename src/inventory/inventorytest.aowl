## inventory.rs's default bodies over `ArrayInventory`, the NBT form, and an inventory filled with closures in this
## module's defining one is covered by src/world's test.

import std/options
import invtestkit, inventory
import ../nbt/tag

block basics:
  let a = newArrayInventory(3)
  let inv = Inventory(a)
  check(inv.size() == 3, "size")
  check(inv.isEmpty(), "empty")
  inv.setStack(1, stackOf(ITEM_STONE, 5))
  check(not inv.isEmpty(), "not empty")
  checkStack(inv.getStack(1), ITEM_STONE, 5, "get")
  checkStack(inv.removeStackSpecific(1, 2'u8), ITEM_STONE, 2, "remove specific")
  checkStack(inv.getStack(1), ITEM_STONE, 3, "remove specific leaves the rest")
  checkStack(inv.removeStackSpecific(1, 0'u8), ITEM_STONE, 0, "remove zero answers empty")
  checkStack(inv.removeStack(1), ITEM_STONE, 3, "remove")
  check(inv.isEmpty(), "empty again")
  check(inv.getMaxCountPerStack() == 99'u8, "default max")
  check(inv.isValidSlotFor(0, stackOf(ITEM_STONE, 1)), "default valid")

block counting:
  let inv = Inventory(newArrayInventory(3))
  inv.setStack(0, stackOf(ITEM_STONE, 5))
  inv.setStack(1, stackOf(ITEM_DIRT, 1))
  inv.setStack(2, stackOf(ITEM_STONE, 2))
  check(inv.count(ITEM_STONE) == 7'u8, "count")
  check(inv.containsAny(@[ITEM_DIRT]), "contains")
  check(not inv.containsAny(@[ITEM_EGG]), "does not contain")

block storeDefaultsToSet:
  let inv = Inventory(newArrayInventory(1))
  inv.storeStack(0, stackOf(ITEM_STONE, 5))
  checkStack(inv.getStack(0), ITEM_STONE, 5, "store")

block clearing:
  let inv = Inventory(newArrayInventory(2))
  inv.setStack(0, stackOf(ITEM_STONE, 5))
  inv.clear()
  check(inv.isEmpty(), "clear")

block nbtForm:
  let inv = Inventory(newArrayInventory(3))
  var nbt = newCompound()
  inv.writeInventoryNbt(nbt, false)
  check(getList(nbt, "Items").isNone, "nothing written when empty")
  inv.writeInventoryNbt(nbt, true)
  check(getList(nbt, "Items").unsafeGet.len == 0, "empty list when asked to include")

  inv.setStack(2, stackOf(ITEM_STONE, 5))
  var written = newCompound()
  inv.writeInventoryNbt(written, false)
  let items = getList(written, "Items").unsafeGet
  check(items.len == 1, "one item")
  check(getByte(items[0].compoundVal, "Slot").unsafeGet == 2'i8, "slot byte")
  check(getString(items[0].compoundVal, "id").unsafeGet == "minecraft:stone", "id")
  check(getInt(items[0].compoundVal, "count").unsafeGet == 5'i32, "count")

  var stacks = emptyStacks(3)
  syncReadItemsFromNbt(written, stacks)
  checkStack(stacks[2], ITEM_STONE, 5, "read back")
  checkStack(stacks[0], ITEM_STONE, 0, "other slots untouched")

  var fromList = emptyStacks(3)
  var synced = newCompound()
  stacks[0] = stackOf(ITEM_DIRT, 1)
  syncWriteItemsToNbt(stacks, synced)
  syncReadItemsFromNbt(synced, fromList)
  checkStack(fromList[0], ITEM_DIRT, 1, "sync write, first")
  checkStack(fromList[2], ITEM_STONE, 5, "sync write, third")

block identity:
  let a = newArrayInventory(1)
  let b = newArrayInventory(1)
  check(ComparableInventory(inv: a) == ComparableInventory(inv: a), "same")
  check(not (ComparableInventory(inv: a) == ComparableInventory(inv: b)), "different though equal in content")

echo "inventory: OK"
