## What the inventory tests share: a player that records what it is sent, and short checks. Not upstream; no
## production module imports this.

import std/syncio
import "../data/item_stack/mod" as itemstack
import ../generated/statistic
import ../protocol/java/client/play/set_container_content
import ../protocol/java/client/play/set_container_property
import ../protocol/java/client/play/set_container_slot
import ../protocol/java/client/play/set_cursor_slot
import ../protocol/java/client/play/set_held_item
import ../protocol/java/client/play/set_player_inventory
import entity_equipment, inventory, lib, player_inventory

export itemstack, syncio

type
  DropRecord* = object
    stack*: ItemStack
    retainOwnership*: bool

  EquipRecord* = object
    slot*: EquipmentSlot
    stack*: ItemStack

  StatRecord* = object
    category*: StatisticCategory
    statId*: int32
    amount*: int32

  TestPlayer* = ref object of InventoryPlayer
    inventory*: PlayerInventory
    creative*: bool
    level*: int32
    seed*: int32
    xp*: int32
    drops*: seq[DropRecord]
    contentPackets*: seq[CSetContainerContent]
    slotPackets*: seq[CSetContainerSlot]
    cursorPackets*: seq[CSetCursorItem]
    propertyPackets*: seq[CSetContainerProperty]
    slotSetPackets*: seq[CSetPlayerInventory]
    heldPackets*: seq[CSetSelectedSlot]
    equipment*: seq[EquipRecord]
    stats*: seq[StatRecord]

proc check*(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

proc tpDropItem(self: InventoryPlayer; item: ItemStack; retainOwnership: bool) =
  let p = TestPlayer(self)
  p.drops.add(DropRecord(stack: item, retainOwnership: retainOwnership))

proc tpGetInventory(self: InventoryPlayer): PlayerInventory =
  let p = TestPlayer(self)
  p.inventory

proc tpHasInfiniteMaterials(self: InventoryPlayer): bool =
  let p = TestPlayer(self)
  p.creative

proc tpIsCreative(self: InventoryPlayer): bool =
  let p = TestPlayer(self)
  p.creative

proc tpExperienceLevel(self: InventoryPlayer): int32 =
  let p = TestPlayer(self)
  p.level

proc tpAddExperienceLevels(self: InventoryPlayer; levels: int32) =
  let p = TestPlayer(self)
  p.level += levels

proc tpEnchantmentSeed(self: InventoryPlayer): int32 =
  let p = TestPlayer(self)
  p.seed

proc tpSetEnchantmentSeed(self: InventoryPlayer; seed: int32) =
  let p = TestPlayer(self)
  p.seed = seed

proc tpEnqueueInventoryPacket(self: InventoryPlayer; packet: CSetContainerContent) =
  let p = TestPlayer(self)
  p.contentPackets.add(packet)

proc tpEnqueueSlotPacket(self: InventoryPlayer; packet: CSetContainerSlot) =
  let p = TestPlayer(self)
  p.slotPackets.add(packet)

proc tpEnqueueCursorPacket(self: InventoryPlayer; packet: CSetCursorItem) =
  let p = TestPlayer(self)
  p.cursorPackets.add(packet)

proc tpEnqueuePropertyPacket(self: InventoryPlayer; packet: CSetContainerProperty) =
  let p = TestPlayer(self)
  p.propertyPackets.add(packet)

proc tpEnqueueSlotSetPacket(self: InventoryPlayer; packet: CSetPlayerInventory) =
  let p = TestPlayer(self)
  p.slotSetPackets.add(packet)

proc tpEnqueueSetHeldItemPacket(self: InventoryPlayer; packet: CSetSelectedSlot) =
  let p = TestPlayer(self)
  p.heldPackets.add(packet)

proc tpEnqueueEquipmentChange(self: InventoryPlayer; slot: EquipmentSlot; stack: ItemStack) =
  let p = TestPlayer(self)
  p.equipment.add(EquipRecord(slot: slot, stack: stack))

proc tpAwardExperience(self: InventoryPlayer; amount: int32) =
  let p = TestPlayer(self)
  p.xp += amount

proc tpIncrementStat(self: InventoryPlayer; category: StatisticCategory; statId: int32; amount: int32) =
  let p = TestPlayer(self)
  p.stats.add(StatRecord(category: category, statId: statId, amount: amount))

proc newTestPlayer*(creative = false; level = 0'i32): TestPlayer =
  TestPlayer(inventory: newPlayerInventory(newEntityEquipment(), buildEquipmentSlots()), creative: creative,
    level: level, seed: 0'i32, xp: 0'i32, dropItemImpl: tpDropItem, getInventoryImpl: tpGetInventory,
    hasInfiniteMaterialsImpl: tpHasInfiniteMaterials, isCreativeImpl: tpIsCreative,
    experienceLevelImpl: tpExperienceLevel, addExperienceLevelsImpl: tpAddExperienceLevels,
    enchantmentSeedImpl: tpEnchantmentSeed, setEnchantmentSeedImpl: tpSetEnchantmentSeed,
    enqueueInventoryPacketImpl: tpEnqueueInventoryPacket, enqueueSlotPacketImpl: tpEnqueueSlotPacket,
    enqueueCursorPacketImpl: tpEnqueueCursorPacket, enqueuePropertyPacketImpl: tpEnqueuePropertyPacket,
    enqueueSlotSetPacketImpl: tpEnqueueSlotSetPacket, enqueueSetHeldItemPacketImpl: tpEnqueueSetHeldItemPacket,
    enqueueEquipmentChangeImpl: tpEnqueueEquipmentChange, awardExperienceImpl: tpAwardExperience,
    incrementStatImpl: tpIncrementStat)

proc stackOf*(item: Item; count: int): ItemStack =
  newItemStack(uint8(count), item)

proc checkStack*(s: ItemStack; item: Item; count: int; what: string) =
  ## The stack holds `count` of `item`, or is empty if `count` is 0.
  if count == 0:
    if not s.isEmpty():
      echo "FAILED: ", what, ": expected empty, got ", s.item.registryKey, " x", int(s.itemCount)
      quit(1)
  elif s.isEmpty() or s.item.id != item.id or int(s.itemCount) != count:
    echo "FAILED: ", what, ": expected ", item.registryKey, " x", count, ", got ", s.item.registryKey, " x",
      int(s.itemCount)
    quit(1)

proc mainStack*(p: TestPlayer; slot: int): ItemStack =
  Inventory(p.inventory).getStack(slot)

proc setMain*(p: TestPlayer; slot: int; stack: ItemStack) =
  Inventory(p.inventory).setStack(slot, stack)
