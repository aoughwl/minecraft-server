## Not a stub any more: the real `Item` and `ItemStack`, src/data/item_stack/mod.aowl, under the old name, for the
## modules outside src/inventory that still import this (src/world, src/server). New code imports the real module.
##
## What the old stub's callers need beyond it stays here. `getMaxStackSize` and `getName` look the id up in
## generated/item.aowl, because those callers build fake stacks as `ItemStack(item: Item(id: x), itemCount: n)`, whose
## `Item` has no components for the real `getMaxStackSize` to read. A stack built from the table gets the same answer.
##
## PARTIAL: pumpkin-data/src/item_stack/mod.rs - this shim stays until src/server/entity and src/server/item build
## their stacks from `Item::from_id` and src/server/entity/entity.aowl drops its own `decrementUnlessCreative`.

import "../data/item_stack/mod" as itemstack
import ../generated/item as realitem

export itemstack except getMaxStackSize, decrementUnlessCreative

proc findRealItem(id: uint16): (bool, realitem.Item) =
  for it in realitem.AllItems:
    if it.id == int(id):
      return (true, it)
  (false, realitem.Item())

proc emptyStack*(): ItemStack {.inline.} =
  emptyItemStack()

proc getMaxStackSize*(s: ItemStack): uint8 {.inline.} =
  ## Falls back to the vanilla default (64) for an id the table does not cover.
  let (found, it) = findRealItem(s.item.id)
  if found: uint8(it.maxStackSize) else: 64'u8

proc getName*(s: ItemStack): string =
  ## The item's name, `diamond_pickaxe`. Empty if the id is not found.
  let (found, it) = findRealItem(s.item.id)
  if found: it.name else: ""
