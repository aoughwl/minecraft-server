## Screen handler for Lectern blocks: a single book slot, no player slots, and the current page synced as
## container property 0.
##
## Not in the pinned tree: its pumpkin-inventory has no lectern_screen_handler.rs. Kept from an earlier pass over a
## newer checkout, with `LecternController` as upstream's trait for the lectern block's side.

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import inventory, screenhandler, slot, window_property

type
  LecternController* = ref object of RootObj
    currentPageImpl*: proc(self: LecternController): int32 {.closure.}
    setPageImpl*: proc(self: LecternController; page: int32) {.closure.}
    onBookTakenImpl*: proc(self: LecternController) {.closure.}

  LecternScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory
    controller*: LecternController

  PageDelegate = ref object of PropertyDelegate
    controller: LecternController

proc currentPage*(c: LecternController): int32 =
  let f = c.currentPageImpl
  f(c)

proc setPage*(c: LecternController; page: int32) =
  let f = c.setPageImpl
  f(c, page)

proc onBookTaken*(c: LecternController) =
  let f = c.onBookTakenImpl
  f(c)

const
  PreviousPageButtonId = 1'i32
  NextPageButtonId = 2'i32
  TakeBookButtonId = 3'i32
  JumpToPageOffset = 100'i32  ## Button ids at or above this jump directly to `id - JumpToPageOffset`.

proc pageGetProperty(self: PropertyDelegate; index: int32): int32 =
  let d = PageDelegate(self)
  if index == 0'i32: currentPage(d.controller) else: 0'i32

proc pageSetProperty(self: PropertyDelegate; index: int32; value: int32) =
  discard

proc pageGetPropertiesSize(self: PropertyDelegate): int32 = 1'i32

proc lecternQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  ## The lectern screen has no player slots, so nothing can be shift-clicked.
  emptyItemStack()

proc lecternOnButtonClick(self: ScreenHandler; player: InventoryPlayer; id: int32): bool =
  let l = LecternScreenHandler(self)
  if id == PreviousPageButtonId:
    setPage(l.controller, currentPage(l.controller) - 1'i32)
    true
  elif id == NextPageButtonId:
    setPage(l.controller, currentPage(l.controller) + 1'i32)
    true
  elif id == TakeBookButtonId:
    let stack = l.inventory.removeStack(0)
    if stack.isEmpty():
      false
    else:
      l.inventory.markDirty()
      onBookTaken(l.controller)
      offerOrDropStack(player, stack)
      self.sendContentUpdates()
      true
  elif id >= JumpToPageOffset:
    setPage(l.controller, id - JumpToPageOffset)
    true
  else:
    false

proc newLecternScreenHandler*(syncId: uint8; inventory: Inventory; controller: LecternController): LecternScreenHandler =
  result = LecternScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtLectern)), inventory: inventory,
    controller: controller)
  result.quickMoveImpl = lecternQuickMove
  result.onButtonClickImpl = lecternOnButtonClick

  ScreenHandler(result).addSlot(newNormalSlot(inventory, 0))
  let delegate = PageDelegate(controller: controller, getPropertyImpl: pageGetProperty,
    setPropertyImpl: pageSetProperty, getPropertiesSizeImpl: pageGetPropertiesSize)
  ScreenHandler(result).addProperty(newScreenProperty(delegate, 0'u8))
