## lectern.aowl: the buttons, against a fake `LecternController`.

import invtestkit, inventory, lectern, screenhandler

type
  FakeController = ref object of LecternController
    page: int32
    taken: int

proc fakeCurrentPage(self: LecternController): int32 =
  let f = FakeController(self)
  f.page

proc fakeSetPage(self: LecternController; page: int32) =
  let f = FakeController(self)
  f.page = page

proc fakeOnBookTaken(self: LecternController) =
  let f = FakeController(self)
  f.taken += 1

block lecternButtons:
  let p = newTestPlayer()
  let controller = FakeController(page: 5'i32, taken: 0, currentPageImpl: fakeCurrentPage, setPageImpl: fakeSetPage,
    onBookTakenImpl: fakeOnBookTaken)
  let inv = newArrayInventory(1)
  let h = newLecternScreenHandler(1'u8, inv, controller)
  check(ScreenHandler(h).onButtonClick(p, 1'i32), "previous")
  check(controller.page == 4'i32, "previous page")
  check(ScreenHandler(h).onButtonClick(p, 2'i32), "next")
  check(controller.page == 5'i32, "next page")
  check(ScreenHandler(h).onButtonClick(p, 142'i32), "jump")
  check(controller.page == 42'i32, "jumped")
  check(not ScreenHandler(h).onButtonClick(p, 3'i32), "no book to take")
  Inventory(inv).setStack(0, stackOf(ITEM_WRITTEN_BOOK, 1))
  check(ScreenHandler(h).onButtonClick(p, 3'i32), "take")
  check(controller.taken == 1, "book taken")
  checkStack(p.mainStack(0), ITEM_WRITTEN_BOOK, 1, "offered to the player")
  check(not ScreenHandler(h).onButtonClick(p, 50'i32), "an unknown button")
  checkStack(ScreenHandler(h).quickMove(p, 0'i32), ITEM_STONE, 0, "nothing shift-clicks")

echo "lectern: OK"
