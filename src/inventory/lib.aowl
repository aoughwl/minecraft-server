## Port of pumpkin-inventory/src/lib.rs
## Port of pumpkin-inventory/src/crafting/mod.rs
## Port of pumpkin-inventory/src/player/mod.rs
##
## `build_equipment_slots`. The crate's `mod.rs` files only declare modules, which aowlmony does by importing.
## Upstream inserts OFF_HAND twice; the second changes nothing.

import "../data/item_stack/mod"
import player_inventory

proc buildEquipmentSlots*(): EquipmentSlots =
  ## The mapping between UI slot indices and equipment slots the player screen handler uses.
  let offset = int32(MainSize)
  @[
    EquipmentSlotEntry(index: int(getOffsetEntitySlotId(esFeet, offset)), slot: esFeet),
    EquipmentSlotEntry(index: int(getOffsetEntitySlotId(esLegs, offset)), slot: esLegs),
    EquipmentSlotEntry(index: int(getOffsetEntitySlotId(esChest, offset)), slot: esChest),
    EquipmentSlotEntry(index: int(getOffsetEntitySlotId(esHead, offset)), slot: esHead),
    EquipmentSlotEntry(index: OffHandSlot, slot: esOffHand)
  ]
