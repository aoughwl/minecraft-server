## Port of pumpkin-inventory/src/merchant/merchant_screen_handler.rs
## Port of pumpkin-inventory/src/merchant/mod.rs
##
## `offers` are the packet's `MerchantOffer`, as upstream, whose stacks are the wire's: stackbridge.aowl converts
## them to compare. `on_trade`'s `Box<dyn Fn(usize)>` is a closure field called through a local.

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import ../protocol/java/client/play/merchant_offers
import inventory, screenhandler, slot, stackbridge

export merchant_offers

type
  MerchantScreenHandler* = ref object of ScreenHandler
    inventory*: Inventory
    selectedOffer: int
    offers*: seq[MerchantOffer]
    onTrade*: proc(index: int) {.closure.}

proc updateResultSlot*(self: MerchantScreenHandler) =
  if self.selectedOffer >= self.offers.len:
    self.inventory.setStack(2, emptyItemStack())
    return

  let offer = self.offers[self.selectedOffer]
  let inputA = self.inventory.getStack(0)
  let inputB = self.inventory.getStack(1)

  let baseCostA = fromSerializer(offer.baseCostA)
  let matchA = inputA.areItemsAndComponentsEqual(baseCostA) and inputA.itemCount >= baseCostA.itemCount

  var matchB = inputB.isEmpty()
  if offer.costB.isSome:
    let costB = fromSerializer(offer.costB.unsafeGet)
    matchB = inputB.areItemsAndComponentsEqual(costB) and inputB.itemCount >= costB.itemCount

  if matchA and matchB:
    self.inventory.setStack(2, fromSerializer(offer.output))
  else:
    self.inventory.setStack(2, emptyItemStack())

proc setSelectedOffer*(self: MerchantScreenHandler; index: int) =
  self.selectedOffer = index
  self.updateResultSlot()
  ScreenHandler(self).sendContentUpdates()

proc merchantOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  let m = MerchantScreenHandler(self)
  self.defaultOnClosed(player)
  m.inventory.onClose()
  # Vanilla drops items from merchant container on close
  for i in 0 ..< 2:
    # Drop inputs only, output is virtual/ghost in some sense or just cleared
    let stack = m.inventory.removeStack(i)
    if not stack.isEmpty():
      offerOrDropStack(player, stack)
  # Clear output slot
  m.inventory.setStack(2, emptyItemStack())

proc merchantQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  var stackLeft = emptyItemStack()
  let s = self.behaviour.slots[int(slotIndex)]

  if s.hasStack():
    var slotStackMut = s.getStack()
    stackLeft = slotStackMut

    if slotIndex < 3'i32:
      # From merchant slots to player inventory
      if not self.insertItem(slotStackMut, 3'i32, int32(self.behaviour.slots.len), true):
        return emptyItemStack()
    else:
      # From player inventory to merchant inputs (0 and 1)
      if not self.insertItem(slotStackMut, 0'i32, 2'i32, false):
        return emptyItemStack()
    s.storeStack(slotStackMut)

    if slotStackMut.isEmpty():
      s.setStack(emptyItemStack())
    else:
      s.markDirty()

  stackLeft

proc merchantOnSlotClick(self: ScreenHandler; slotIndex, button: int32; actionType: SlotActionType;
    player: InventoryPlayer) =
  let m = MerchantScreenHandler(self)
  if slotIndex == 2'i32:
    # Special handling for taking from output slot
    let resultSlot = self.behaviour.slots[2]
    if resultSlot.hasStack():
      let resultStack = resultSlot.getClonedStack()
      if not resultStack.isEmpty():
        # Consume inputs
        m.offers[m.selectedOffer].uses += 1'i32
        let countA = m.offers[m.selectedOffer].baseCostA.stack.itemCount
        let hasCostB = m.offers[m.selectedOffer].costB.isSome
        let countB = (if hasCostB: m.offers[m.selectedOffer].costB.unsafeGet.stack.itemCount else: 0'u8)
        let offerXp = m.offers[m.selectedOffer].xp

        var inputA = m.inventory.getStack(0)
        inputA.decrement(countA)
        if inputA.isEmpty():
          inputA = emptyItemStack()
        m.inventory.storeStack(0, inputA)
        self.behaviour.slots[0].markDirty()

        if hasCostB:
          var inputB = m.inventory.getStack(1)
          inputB.decrement(countB)
          if inputB.isEmpty():
            inputB = emptyItemStack()
          m.inventory.storeStack(1, inputB)
          self.behaviour.slots[1].markDirty()

        # Award XP
        player.awardExperience(offerXp)

        let onTrade = m.onTrade
        if onTrade != nil:
          onTrade(m.selectedOffer)

  self.internalOnSlotClick(slotIndex, button, actionType, player)
  # Vanilla's `slotsChanged`: a shift-click from the inventory fills a cost slot as well, and the result follows.
  if slotIndex == 0'i32 or slotIndex == 1'i32 or slotIndex == 2'i32 or actionType == satQuickMove:
    m.updateResultSlot()
    self.sendContentUpdates()

proc newMerchantScreenHandler*(syncId: uint8; playerInventory: PlayerInventory; inventory: Inventory;
    offers: seq[MerchantOffer]): MerchantScreenHandler =
  result = MerchantScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtMerchant)), inventory: inventory,
    selectedOffer: 0, offers: offers)
  result.onClosedImpl = merchantOnClosed
  result.quickMoveImpl = merchantQuickMove
  result.onSlotClickImpl = merchantOnSlotClick

  inventory.onOpen()

  # Merchant specific slots: 2 input, 1 output
  for i in 0 ..< 3:
    ScreenHandler(result).addSlot(newNormalSlot(inventory, i))

  ScreenHandler(result).addPlayerSlots(playerInventory)
