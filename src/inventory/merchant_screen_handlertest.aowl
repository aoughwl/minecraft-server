## merchant_screen_handler.rs: which offers match, and what a trade spends.

import std/options
import invtestkit, inventory, merchant_screen_handler, screenhandler, stackbridge
import ../generated/screen
import ../protocol/itemstackserializer

var gLastTrade = -1

proc recordTrade(index: int) =
  gLastTrade = index

proc offer(costA: ItemStack; output: ItemStack; costB: Option[ItemStack] = none[ItemStack]()): MerchantOffer =
  var wireB = none[ItemStackSerializer]()
  if costB.isSome:
    wireB = some(toSerializer(costB.unsafeGet))
  MerchantOffer(baseCostA: toSerializer(costA), output: toSerializer(output), costB: wireB, isDisabled: false,
    uses: 0'i32, maxUses: 12'i32, xp: 5'i32, specialPrice: 0'i32, priceMultiplier: 0.05'f32, demand: 0'i32)

block merchant:
  let p = newTestPlayer()
  let inv = newArrayInventory(3)
  let offers = @[offer(stackOf(ITEM_EMERALD, 2), stackOf(ITEM_BREAD, 3)),
    offer(stackOf(ITEM_EMERALD, 1), stackOf(ITEM_APPLE, 1), some(stackOf(ITEM_STICK, 2)))]
  let h = newMerchantScreenHandler(1'u8, p.inventory, Inventory(inv), offers)
  h.onTrade = recordTrade
  check(h.behaviour.windowType == some(wtMerchant), "window")

  # One emerald is not enough.
  Inventory(inv).setStack(0, stackOf(ITEM_EMERALD, 1))
  h.updateResultSlot()
  check(Inventory(inv).getStack(2).isEmpty(), "too few")

  Inventory(inv).setStack(0, stackOf(ITEM_EMERALD, 3))
  h.updateResultSlot()
  checkStack(Inventory(inv).getStack(2), ITEM_BREAD, 3, "enough")

  # The second offer needs its second cost.
  h.setSelectedOffer(1)
  check(Inventory(inv).getStack(2).isEmpty(), "second cost missing")
  Inventory(inv).setStack(1, stackOf(ITEM_STICK, 2))
  h.updateResultSlot()
  checkStack(Inventory(inv).getStack(2), ITEM_APPLE, 1, "second cost met")

  # Taking the output spends both, awards experience, counts the use and tells the villager.
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_APPLE, 1, "traded")
  checkStack(Inventory(inv).getStack(0), ITEM_EMERALD, 2, "first cost spent")
  check(Inventory(inv).getStack(1).isEmpty(), "second cost spent")
  check(p.xp == 5'i32, "experience")
  check(h.offers[1].uses == 1'i32, "use counted")
  check(gLastTrade == 1, "on trade")
  check(Inventory(inv).getStack(2).isEmpty(), "no more of the second offer")

  # An offer with no second cost needs that slot empty.
  h.setSelectedOffer(0)
  checkStack(Inventory(inv).getStack(2), ITEM_BREAD, 3, "first offer again")
  Inventory(inv).setStack(1, stackOf(ITEM_DIRT, 1))
  h.updateResultSlot()
  check(Inventory(inv).getStack(2).isEmpty(), "second slot must be empty")

  ScreenHandler(h).onClosed(p)
  check(Inventory(inv).getStack(0).isEmpty(), "inputs returned")
  check(p.mainStack(0).itemCount == 1'u8 and p.mainStack(0).item.id == ITEM_APPLE.id, "cursor returned first")

echo "merchant_screen_handler: OK"
