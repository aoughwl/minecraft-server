## Port of pumpkin-inventory/src/player/player_inventory.rs
##
## `InventoryPlayer` from pumpkin-inventory/src/screen_handler.rs is declared here: it takes a `PlayerInventory`
## and `PlayerInventory.offer` takes it, and modules cannot import each other. screenhandler.aowl exports it.
## `as_any` is not needed: the implementor subclasses it. The fields take the player as `self`, so a subclass in
## any module fills them with plain procs and no closure over itself.
##
## `held_item` and `off_hand_item` answer copies; `setHeldItem` and `setOffHandItem` are the write half of their
## locks. `is_already_equipped` is not here: it exists upstream only to avoid a self-deadlock on those locks, by
## comparing `Arc` identity, and there is no lock or shared handle to compare.

import std/[assertions, options]
import "../data/item_stack/mod"
import ../generated/statistic
import ../protocol/varint
import ../protocol/java/client/play/set_container_content
import ../protocol/java/client/play/set_container_property
import ../protocol/java/client/play/set_container_slot
import ../protocol/java/client/play/set_cursor_slot
import ../protocol/java/client/play/set_held_item
import ../protocol/java/client/play/set_player_inventory
import inventory, entity_equipment, stackbridge

const
  MainSize* = 36     ## Size of the main inventory (27 storage + 9 hotbar).
  HotbarSize = 9
  OffHandSlot* = 40  ## Slot index for the off-hand.

type
  EquipmentSlotEntry* = object
    ## An entry of upstream's `HashMap<usize, EquipmentSlot>`.
    index*: int
    slot*: EquipmentSlot

  EquipmentSlots* = seq[EquipmentSlotEntry]

  PlayerInventory* = ref object of Inventory
    mainInventory*: seq[ItemStack]   ## The 36 main slots; 0-8 are the hotbar.
    equipmentSlots*: EquipmentSlots  ## Slot index to equipment slot.
    selectedSlot: uint8
    entityEquipment*: EntityEquipment

  InventoryPlayer* = ref object of RootObj
    dropItemImpl*: proc(self: InventoryPlayer; item: ItemStack; retainOwnership: bool) {.closure.}
    getInventoryImpl*: proc(self: InventoryPlayer): PlayerInventory {.closure.}
    hasInfiniteMaterialsImpl*: proc(self: InventoryPlayer): bool {.closure.}
    isCreativeImpl*: proc(self: InventoryPlayer): bool {.closure.}
    experienceLevelImpl*: proc(self: InventoryPlayer): int32 {.closure.}
    addExperienceLevelsImpl*: proc(self: InventoryPlayer; levels: int32) {.closure.}
    enchantmentSeedImpl*: proc(self: InventoryPlayer): int32 {.closure.}
    setEnchantmentSeedImpl*: proc(self: InventoryPlayer; seed: int32) {.closure.}
    enqueueInventoryPacketImpl*: proc(self: InventoryPlayer; packet: CSetContainerContent) {.closure.}
    enqueueSlotPacketImpl*: proc(self: InventoryPlayer; packet: CSetContainerSlot) {.closure.}
    enqueueCursorPacketImpl*: proc(self: InventoryPlayer; packet: CSetCursorItem) {.closure.}
    enqueuePropertyPacketImpl*: proc(self: InventoryPlayer; packet: CSetContainerProperty) {.closure.}
    enqueueSlotSetPacketImpl*: proc(self: InventoryPlayer; packet: CSetPlayerInventory) {.closure.}
    enqueueSetHeldItemPacketImpl*: proc(self: InventoryPlayer; packet: CSetSelectedSlot) {.closure.}
    enqueueEquipmentChangeImpl*: proc(self: InventoryPlayer; slot: EquipmentSlot; stack: ItemStack) {.closure.}
    awardExperienceImpl*: proc(self: InventoryPlayer; amount: int32) {.closure.}
    incrementStatImpl*: proc(self: InventoryPlayer; category: StatisticCategory; statId: int32; amount: int32) {.closure.}

proc dropItem*(p: InventoryPlayer; item: ItemStack; retainOwnership: bool) =
  let f = p.dropItemImpl
  f(p, item, retainOwnership)

proc getInventory*(p: InventoryPlayer): PlayerInventory =
  let f = p.getInventoryImpl
  f(p)

proc hasInfiniteMaterials*(p: InventoryPlayer): bool =
  let f = p.hasInfiniteMaterialsImpl
  f(p)

proc isCreative*(p: InventoryPlayer): bool =
  let f = p.isCreativeImpl
  f(p)

proc experienceLevel*(p: InventoryPlayer): int32 =
  let f = p.experienceLevelImpl
  f(p)

proc addExperienceLevels*(p: InventoryPlayer; levels: int32) =
  let f = p.addExperienceLevelsImpl
  f(p, levels)

proc enchantmentSeed*(p: InventoryPlayer): int32 =
  let f = p.enchantmentSeedImpl
  f(p)

proc setEnchantmentSeed*(p: InventoryPlayer; seed: int32) =
  let f = p.setEnchantmentSeedImpl
  f(p, seed)

proc enqueueInventoryPacket*(p: InventoryPlayer; packet: CSetContainerContent) =
  let f = p.enqueueInventoryPacketImpl
  f(p, packet)

proc enqueueSlotPacket*(p: InventoryPlayer; packet: CSetContainerSlot) =
  let f = p.enqueueSlotPacketImpl
  f(p, packet)

proc enqueueCursorPacket*(p: InventoryPlayer; packet: CSetCursorItem) =
  let f = p.enqueueCursorPacketImpl
  f(p, packet)

proc enqueuePropertyPacket*(p: InventoryPlayer; packet: CSetContainerProperty) =
  let f = p.enqueuePropertyPacketImpl
  f(p, packet)

proc enqueueSlotSetPacket*(p: InventoryPlayer; packet: CSetPlayerInventory) =
  let f = p.enqueueSlotSetPacketImpl
  f(p, packet)

proc enqueueSetHeldItemPacket*(p: InventoryPlayer; packet: CSetSelectedSlot) =
  let f = p.enqueueSetHeldItemPacketImpl
  f(p, packet)

proc enqueueEquipmentChange*(p: InventoryPlayer; slot: EquipmentSlot; stack: ItemStack) =
  let f = p.enqueueEquipmentChangeImpl
  f(p, slot, stack)

proc awardExperience*(p: InventoryPlayer; amount: int32) =
  let f = p.awardExperienceImpl
  f(p, amount)

proc incrementStat*(p: InventoryPlayer; category: StatisticCategory; statId: int32; amount: int32) =
  let f = p.incrementStatImpl
  f(p, category, statId, amount)

# --- PlayerInventory -----------------------------------------------------------------------------------------

proc equipmentSlotOf(self: PlayerInventory; slot: int): (bool, EquipmentSlot) =
  ## `self.equipment_slots.get(&slot)`.
  for entry in self.equipmentSlots:
    if entry.index == slot:
      return (true, entry.slot)
  (false, esMainHand)

proc piSize(self: Inventory): int =
  let p = PlayerInventory(self)
  p.mainInventory.len + p.equipmentSlots.len

proc piIsEmpty(self: Inventory): bool =
  let p = PlayerInventory(self)
  for i in 0 ..< p.mainInventory.len:
    if not p.mainInventory[i].isEmpty():
      return false
  for entry in p.equipmentSlots:
    if not p.entityEquipment.get(entry.slot).isEmpty():
      return false
  true

proc piGetStack(self: Inventory; slot: int): ItemStack =
  ## Upstream unwraps the map lookup and panics on a slot past the equipment; a click cannot reach one, since
  ## the `Swap` button is 0-8 or 40 and every slot on a screen handler is built from a known index.
  let p = PlayerInventory(self)
  if slot < p.mainInventory.len:
    p.mainInventory[slot]
  else:
    let (found, equipment) = p.equipmentSlotOf(slot)
    if found: p.entityEquipment.get(equipment) else: emptyItemStack()

proc piRemoveStack(self: Inventory; slot: int): ItemStack =
  let p = PlayerInventory(self)
  if slot < p.mainInventory.len:
    result = p.mainInventory[slot]
    p.mainInventory[slot] = emptyItemStack()
  else:
    let (found, equipment) = p.equipmentSlotOf(slot)
    if found:
      result = p.entityEquipment.put(equipment, emptyItemStack())
    else:
      result = emptyItemStack()

proc piRemoveStackSpecific(self: Inventory; slot: int; amount: uint8): ItemStack =
  let p = PlayerInventory(self)
  if slot < p.mainInventory.len:
    # `split_stack`.
    if not p.mainInventory[slot].isEmpty() and amount > 0'u8:
      result = p.mainInventory[slot].split(amount)
    else:
      result = emptyItemStack()
  else:
    let (found, equipment) = p.equipmentSlotOf(slot)
    if found and not p.entityEquipment.equipment[ord(equipment)].isEmpty():
      result = p.entityEquipment.equipment[ord(equipment)].split(amount)
    else:
      result = emptyItemStack()

proc piSetStack(self: Inventory; slot: int; stack: ItemStack) =
  let p = PlayerInventory(self)
  if slot < p.mainInventory.len:
    p.mainInventory[slot] = stack
  else:
    let (found, equipment) = p.equipmentSlotOf(slot)
    if found:
      discard p.entityEquipment.put(equipment, stack)

proc piClear(self: Inventory) =
  let p = PlayerInventory(self)
  for i in 0 ..< p.mainInventory.len:
    p.mainInventory[i] = emptyItemStack()
  p.entityEquipment.clear()

let gPlayerInventoryOps = InventoryOps(size: piSize, isEmpty: piIsEmpty, getStack: piGetStack,
  removeStack: piRemoveStack, removeStackSpecific: piRemoveStackSpecific, setStack: piSetStack, clear: piClear)

proc newPlayerInventory*(entityEquipment: EntityEquipment; equipmentSlots: EquipmentSlots): PlayerInventory =
  ## TODO upstream: add inventory load from nbt.
  PlayerInventory(ops: gPlayerInventoryOps, mainInventory: emptyStacks(MainSize), equipmentSlots: equipmentSlots,
    selectedSlot: 0'u8, entityEquipment: entityEquipment)

proc isValidHotbarIndex*(slot: int): bool {.inline.} =
  slot < HotbarSize

proc getSelectedSlot*(self: PlayerInventory): uint8 {.inline.} =
  self.selectedSlot

proc setSelectedSlot*(self: PlayerInventory; slot: uint8) =
  ## Upstream panics on an invalid slot, and so does this. The packet handler rejects one first, as upstream's does.
  assert isValidHotbarIndex(int(slot)), "Invalid hotbar slot"
  self.selectedSlot = slot

proc heldItem*(self: PlayerInventory): ItemStack =
  ## Mojang name: `getSelectedStack`.
  self.mainInventory[int(self.selectedSlot)]

proc setHeldItem*(self: PlayerInventory; stack: ItemStack) =
  ## `*held_item().lock().await = stack`.
  self.mainInventory[int(self.selectedSlot)] = stack

proc offHandItem*(self: PlayerInventory): ItemStack =
  ## Mojang name: `getOffHandStack`.
  let (_, slot) = self.equipmentSlotOf(OffHandSlot)
  self.entityEquipment.get(slot)

proc setOffHandItem*(self: PlayerInventory; stack: ItemStack) =
  ## `*off_hand_item().await.lock().await = stack`.
  let (_, slot) = self.equipmentSlotOf(OffHandSlot)
  discard self.entityEquipment.put(slot, stack)

proc getStackInHand*(self: PlayerInventory; offHand: bool): ItemStack =
  ## `Hand::Left` is the off hand.
  if offHand: self.offHandItem() else: self.heldItem()

proc swapItem*(self: PlayerInventory): (ItemStack, ItemStack) =
  ## Swaps main hand and off hand; answers the new main hand item and new off hand item.
  let (_, slot) = self.equipmentSlotOf(OffHandSlot)
  let offHandItem = self.heldItem()
  self.setHeldItem(self.entityEquipment.put(slot, offHandItem))
  (self.heldItem(), offHandItem)

proc addStackToSlot(self: PlayerInventory; slot: int; stack: ItemStack): int =
  ## Answers the number of items that could not fit.
  var stackCount = stack.itemCount
  var selfStack = Inventory(self).getStack(slot)

  if selfStack.isEmpty():
    selfStack = stack.copyWithCount(0'u8)

  let countLeft = selfStack.getMaxStackSize() - selfStack.itemCount
  let countMin = min(stackCount, countLeft)

  if countMin != 0'u8:
    stackCount -= countMin
    selfStack.increment(countMin)
  Inventory(self).storeStack(slot, selfStack)
  int(stackCount)

proc getEmptySlot(self: PlayerInventory): int16 =
  ## The slot index, or -1 if the inventory is full.
  for i in 0 ..< MainSize:
    if self.mainInventory[i].isEmpty():
      return int16(i)
  -1'i16

proc canStackAddMore(existingStack, stack: ItemStack): bool =
  not existingStack.isEmpty() and existingStack.areItemsAndComponentsEqual(stack) and
    existingStack.isStackable() and existingStack.itemCount < existingStack.getMaxStackSize()

proc getOccupiedSlotWithRoomForStack(self: PlayerInventory; stack: ItemStack): int16 =
  ## Checks the selected slot, the off hand, then the others.
  if canStackAddMore(Inventory(self).getStack(int(self.selectedSlot)), stack):
    int16(self.selectedSlot)
  elif canStackAddMore(Inventory(self).getStack(OffHandSlot), stack):
    int16(OffHandSlot)
  else:
    for i in 0 ..< MainSize:
      if canStackAddMore(self.mainInventory[i], stack):
        return int16(i)
    -1'i16

proc addStack(self: PlayerInventory; stack: ItemStack): int =
  var slotIndex = self.getOccupiedSlotWithRoomForStack(stack)
  if slotIndex == -1'i16:
    slotIndex = self.getEmptySlot()
  if slotIndex == -1'i16:
    int(stack.itemCount)
  else:
    self.addStackToSlot(int(slotIndex), stack)

proc insertStack*(self: PlayerInventory; slot: int16; stack: var ItemStack): bool =
  ## `slot` -1 is any slot. True if any items were inserted; `stack` keeps the rest.
  if stack.isEmpty():
    return false
  # TODO upstream: if (stack.isDamaged()) {
  var i = stack.itemCount
  while true:
    i = stack.itemCount
    if slot == -1'i16:
      stack.setCount(uint8(self.addStack(stack) and 0xFF))
    else:
      stack.setCount(uint8(self.addStackToSlot(int(slot), stack) and 0xFF))
    if stack.isEmpty() or stack.itemCount >= i:
      break
  # TODO upstream: creative mode check
  stack.itemCount < i

proc insertStackAnywhere*(self: PlayerInventory; stack: var ItemStack): bool =
  self.insertStack(-1'i16, stack)

proc getSlotWithStack*(self: PlayerInventory; stack: ItemStack): int16 =
  ## The first slot holding a matching stack, or -1.
  for i in 0 ..< MainSize:
    if not self.mainInventory[i].isEmpty() and self.mainInventory[i].areItemsAndComponentsEqual(stack):
      return int16(i)
  -1'i16

proc getSwappableHotbarSlot(self: PlayerInventory): int =
  ## First an empty slot, from the selected one onward; failing that, the selected slot. Upstream's second
  ## loop answers on its first pass, so it is `(0 + selected) % 9`.
  let selectedSlot = int(self.selectedSlot)
  for i in 0 ..< HotbarSize:
    let checkIndex = (i + selectedSlot) mod 9
    if self.mainInventory[checkIndex].isEmpty():
      return checkIndex
  selectedSlot mod 9

proc swapStackWithHotbar*(self: PlayerInventory; stack: ItemStack) =
  self.setSelectedSlot(uint8(self.getSwappableHotbarSlot()))
  if not self.mainInventory[int(self.selectedSlot)].isEmpty():
    let emptySlot = self.getEmptySlot()
    if emptySlot != -1'i16:
      Inventory(self).setStack(int(emptySlot), self.mainInventory[int(self.selectedSlot)])
  Inventory(self).setStack(int(self.selectedSlot), stack)

proc swapSlotWithHotbar*(self: PlayerInventory; slot: int) =
  self.setSelectedSlot(uint8(self.getSwappableHotbarSlot()))
  let stack = self.mainInventory[int(self.selectedSlot)]
  Inventory(self).setStack(int(self.selectedSlot), self.mainInventory[slot])
  Inventory(self).setStack(slot, stack)

proc offer*(self: PlayerInventory; stackIn: ItemStack; notifyClient: bool; player: InventoryPlayer) =
  ## Gives a stack to the player, dropping what will not fit.
  var stack = stackIn
  while not stack.isEmpty():
    var roomForStack = self.getOccupiedSlotWithRoomForStack(stack)
    if roomForStack == -1'i16:
      roomForStack = self.getEmptySlot()

    if roomForStack == -1'i16:
      player.dropItem(stack, false)
      break

    let itemsFit = stack.getMaxStackSize() - Inventory(self).getStack(int(roomForStack)).itemCount
    var part = stack.split(itemsFit)
    if self.insertStack(roomForStack, part) and notifyClient:
      player.enqueueSlotSetPacket(CSetPlayerInventory(slot: newVarInt(int32(roomForStack)),
        item: toSerializer(Inventory(self).getStack(int(roomForStack)))))

proc offerOrDropStack*(self: PlayerInventory; stack: ItemStack; player: InventoryPlayer) =
  self.offer(stack, true, player)
