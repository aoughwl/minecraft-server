## player_inventory.rs and lib.rs's `build_equipment_slots`, worked by hand.

import invtestkit, entity_equipment, inventory, lib, player_inventory

block equipmentSlots:
  let slots = buildEquipmentSlots()
  check(slots.len == 5, "five")
  check(slots[0].index == 36 and slots[0].slot == esFeet, "feet")
  check(slots[1].index == 37 and slots[1].slot == esLegs, "legs")
  check(slots[2].index == 38 and slots[2].slot == esChest, "chest")
  check(slots[3].index == 39 and slots[3].slot == esHead, "head")
  check(slots[4].index == 40 and slots[4].slot == esOffHand, "off hand")

block sizeAndSlots:
  let p = newTestPlayer()
  let inv = Inventory(p.inventory)
  check(inv.size() == 41, "36 + 5")
  check(inv.isEmpty(), "empty")
  inv.setStack(39, stackOf(ITEM_DIAMOND_HELMET, 1))
  checkStack(p.inventory.entityEquipment.get(esHead), ITEM_DIAMOND_HELMET, 1, "39 is the head")
  check(not inv.isEmpty(), "armor counts")
  checkStack(inv.removeStack(39), ITEM_DIAMOND_HELMET, 1, "remove armor")
  checkStack(inv.getStack(41), ITEM_STONE, 0, "past the equipment answers empty")
  inv.setStack(40, stackOf(ITEM_STONE, 5))
  checkStack(inv.removeStackSpecific(40, 2'u8), ITEM_STONE, 2, "split the off hand")
  checkStack(p.inventory.offHandItem(), ITEM_STONE, 3, "off hand keeps the rest")
  inv.clear()
  check(inv.isEmpty(), "clear")

block hands:
  let p = newTestPlayer()
  p.inventory.setSelectedSlot(3'u8)
  p.setMain(3, stackOf(ITEM_STONE, 5))
  p.inventory.setOffHandItem(stackOf(ITEM_DIRT, 2))
  checkStack(p.inventory.heldItem(), ITEM_STONE, 5, "held")
  checkStack(p.inventory.getStackInHand(true), ITEM_DIRT, 2, "left hand")
  checkStack(p.inventory.getStackInHand(false), ITEM_STONE, 5, "right hand")
  let (mainHand, offHand) = p.inventory.swapItem()
  checkStack(mainHand, ITEM_DIRT, 2, "swap answers the new main hand")
  checkStack(offHand, ITEM_STONE, 5, "swap answers the new off hand")
  checkStack(p.inventory.heldItem(), ITEM_DIRT, 2, "swapped main")
  checkStack(p.inventory.offHandItem(), ITEM_STONE, 5, "swapped off")
  check(isValidHotbarIndex(8), "hotbar 8")
  check(not isValidHotbarIndex(9), "not hotbar 9")

block insertStackStacksThenFills:
  let p = newTestPlayer()
  p.setMain(5, stackOf(ITEM_STONE, 60))
  var stack = stackOf(ITEM_STONE, 10)
  check(p.inventory.insertStackAnywhere(stack), "inserted")
  check(stack.isEmpty(), "all went in")
  checkStack(p.mainStack(5), ITEM_STONE, 64, "topped up")
  checkStack(p.mainStack(0), ITEM_STONE, 6, "rest in the first empty")

block insertPrefersTheSelectedSlotThenTheOffHand:
  let p = newTestPlayer()
  p.inventory.setSelectedSlot(2'u8)
  p.setMain(1, stackOf(ITEM_STONE, 1))
  p.setMain(2, stackOf(ITEM_STONE, 1))
  p.inventory.setOffHandItem(stackOf(ITEM_STONE, 1))
  var one = stackOf(ITEM_STONE, 1)
  discard p.inventory.insertStackAnywhere(one)
  checkStack(p.mainStack(2), ITEM_STONE, 2, "selected first")
  p.setMain(2, stackOf(ITEM_DIRT, 1))
  var two = stackOf(ITEM_STONE, 1)
  discard p.inventory.insertStackAnywhere(two)
  checkStack(p.inventory.offHandItem(), ITEM_STONE, 2, "then the off hand")
  checkStack(p.mainStack(1), ITEM_STONE, 1, "before the main slots")

block insertIntoAFullInventory:
  let p = newTestPlayer()
  for i in 0 ..< MainSize:
    p.setMain(i, stackOf(ITEM_DIRT, 64))
  var stack = stackOf(ITEM_STONE, 3)
  check(not p.inventory.insertStackAnywhere(stack), "nothing inserted")
  checkStack(stack, ITEM_STONE, 3, "unchanged")

block slotWithStack:
  let p = newTestPlayer()
  p.setMain(7, stackOf(ITEM_STONE, 1))
  check(p.inventory.getSlotWithStack(stackOf(ITEM_STONE, 9)) == 7'i16, "found")
  check(p.inventory.getSlotWithStack(stackOf(ITEM_DIRT, 9)) == -1'i16, "not found")

block offerNotifiesAndDropsTheOverflow:
  let p = newTestPlayer()
  p.inventory.offer(stackOf(ITEM_STONE, 70), true, p)
  checkStack(p.mainStack(0), ITEM_STONE, 64, "first stack")
  checkStack(p.mainStack(1), ITEM_STONE, 6, "second stack")
  check(p.slotSetPackets.len == 2, "two packets")
  check(p.slotSetPackets[0].slot.value == 0'i32, "first packet's slot")
  check(p.slotSetPackets[0].item.stack.itemCount == 64'u8, "first packet's count")
  check(p.drops.len == 0, "no drop")

  let full = newTestPlayer()
  for i in 0 ..< MainSize:
    full.setMain(i, stackOf(ITEM_DIRT, 64))
  full.inventory.offerOrDropStack(stackOf(ITEM_STONE, 3), full)
  check(full.drops.len == 1, "dropped")
  checkStack(full.drops[0].stack, ITEM_STONE, 3, "dropped all")
  check(not full.drops[0].retainOwnership, "offer drops without ownership")

block swapWithHotbar:
  let p = newTestPlayer()
  p.inventory.setSelectedSlot(2'u8)
  p.setMain(2, stackOf(ITEM_DIRT, 1))
  # The first empty slot from the selected one onward is 3.
  p.inventory.swapStackWithHotbar(stackOf(ITEM_STONE, 1))
  check(p.inventory.getSelectedSlot() == 3'u8, "selected moves")
  checkStack(p.mainStack(3), ITEM_STONE, 1, "stack placed")

  let q = newTestPlayer()
  q.setMain(20, stackOf(ITEM_STONE, 4))
  q.inventory.swapSlotWithHotbar(20)
  checkStack(q.mainStack(0), ITEM_STONE, 4, "pick block moved it")
  checkStack(q.mainStack(20), ITEM_STONE, 0, "and took what was there")

  let r = newTestPlayer()
  for i in 0 ..< 9:
    r.setMain(i, stackOf(ITEM_DIRT, 1))
  r.inventory.setSelectedSlot(4'u8)
  r.inventory.swapStackWithHotbar(stackOf(ITEM_STONE, 1))
  check(r.inventory.getSelectedSlot() == 4'u8, "no empty hotbar slot: selected stays")
  checkStack(r.mainStack(4), ITEM_STONE, 1, "replaced")
  checkStack(r.mainStack(9), ITEM_DIRT, 1, "the old one moved to the first empty")

echo "player_inventory: OK"
