## Port of pumpkin-inventory/src/player/player_screen_handler.rs
##
## Slots: 0 crafting result, 1-4 crafting grid, 5-8 armor (head, chest, legs, feet), 9-35 main, 36-44 hotbar,
## 45 off hand.

import std/options
import "../data/item_stack/mod"
import ../generated/screen
import crafting, crafting_screen_handler, inventory, recipe_provider, recipes, screenhandler, slot

const EquipmentSlotOrder: array[4, EquipmentSlot] = [esHead, esChest, esLegs, esFeet]

type
  PlayerScreenHandler* = ref object of ScreenHandler
    craftingInventory*: RecipeInputInventory  ## The 2x2 grid.

proc isInHotbar*(slot: uint8): bool =
  ## As upstream, 36..=45: the off hand counts.
  slot >= 36'u8 and slot <= 45'u8

proc getSlot*(self: PlayerScreenHandler; slot: int): Slot =
  self.behaviour.slots[slot]

proc playerOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  # TODO upstream: this.craftingResultInventory.clear();
  let h = PlayerScreenHandler(self)
  self.dropInventory(player, h.craftingInventory)

proc playerQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  let s = self.behaviour.slots[int(slotIndex)]

  # TODO upstream: Equippable component

  if s.hasStack():
    var slotStack = s.getStack()
    let stackPrev = slotStack

    let (hasEquippable, equippable) = slotStack.getDataComponent(EquippableImpl)
    let equipmentSlot = (if hasEquippable: equippable.slot else: esMainHand)

    var success = false
    if slotIndex == 0'i32:
      # From crafting result slot (0) -> Player Inventory (9-45, from end)
      success = self.insertItem(slotStack, 9'i32, 45'i32, true)
    elif slotIndex >= 1'i32 and slotIndex < 5'i32:
      # From craft ingredient slots (1-4) -> Player Inventory (9-45, from start)
      success = self.insertItem(slotStack, 9'i32, 45'i32, false)
    elif slotIndex >= 5'i32 and slotIndex < 9'i32:
      # From armour slots (5-8) -> Player Inventory (9-45, from start)
      success = self.insertItem(slotStack, 9'i32, 45'i32, false)
      if success:
        player.enqueueEquipmentChange(equipmentSlot, emptyItemStack())
    elif equipmentSlot.slotType() == etHumanoidArmor and
        self.behaviour.slots[int(8'i32 - equipmentSlot.getEntitySlotId())].getClonedStack().isEmpty():
      # Into empty armour slots (5-8)
      let index = 8'i32 - equipmentSlot.getEntitySlotId()
      success = self.insertItem(slotStack, index, index + 1'i32, false)
      if success:
        player.enqueueEquipmentChange(equipmentSlot, stackPrev)
    elif equipmentSlot == esOffHand and slotIndex != 45'i32 and self.behaviour.slots[45].getClonedStack().isEmpty():
      # Into empty offhand slot (45)
      let index = 45'i32
      success = self.insertItem(slotStack, index, index + 1'i32, false)
    elif slotIndex >= 9'i32 and slotIndex < 36'i32:
      # From main inventory (9-35) -> Hotbar (36-44)
      success = self.insertItem(slotStack, 36'i32, 45'i32, false)
    elif slotIndex >= 36'i32 and slotIndex < 45'i32:
      # From hotbar (36-44) -> Main inventory (9-35)
      success = self.insertItem(slotStack, 9'i32, 36'i32, false)
    else:
      # Fallback to moving into the player inventory area
      success = self.insertItem(slotStack, 9'i32, 45'i32, false)

    if not success:
      return emptyItemStack()

    s.storeStack(slotStack)
    let stack = slotStack

    if stack.isEmpty():
      s.setStackPrev(emptyItemStack(), stackPrev)
    else:
      s.markDirty()

    if stack.itemCount == stackPrev.itemCount:
      return emptyItemStack()

    var takenStack = stackPrev
    takenStack.setCount(stackPrev.itemCount - stack.itemCount)
    s.onTakeItem(player, takenStack)

    if slotIndex == 0'i32:
      # Notify the result slot to refill
      s.onQuickMoveCrafted(stack, stackPrev)
      # For crafting result slot, drop any remaining items
      if not stack.isEmpty():
        player.dropItem(stack, false)

    return stackPrev

  # Nothing changed
  emptyItemStack()

proc newPlayerScreenHandler*(playerInventory: PlayerInventory; windowType: Option[WindowType]; syncId: uint8;
    provider: nil RecipeProvider): PlayerScreenHandler =
  let craftingInventory = newCraftingInventory(2'u8, 2'u8)
  result = PlayerScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, windowType),
    craftingInventory: craftingInventory)
  result.onClosedImpl = playerOnClosed
  result.quickMoveImpl = playerQuickMove

  ScreenHandler(result).addRecipeSlots(craftingInventory, provider)

  # Armor slots (head, chest, legs, feet)
  for i in 0 ..< 4:
    ScreenHandler(result).addSlot(newArmorSlot(playerInventory, 39 - i, EquipmentSlotOrder[i]))

  # Main inventory and hotbar
  ScreenHandler(result).addPlayerSlots(playerInventory)

  # Offhand slot (index 40 in player inventory, 45 in screen handler)
  # TODO upstream: onEquipStack callback for offhand
  ScreenHandler(result).addSlot(newNormalSlot(playerInventory, 40))
