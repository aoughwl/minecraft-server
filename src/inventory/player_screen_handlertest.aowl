## player_screen_handler.rs. Slots: 0 result, 1-4 grid, 5-8 armor, 9-35 main, 36-44 hotbar, 45 off hand.

import std/options
import invtestkit, entity_equipment, inventory, player_screen_handler, screenhandler, slot
import ../generated/screen

proc handler(p: TestPlayer): PlayerScreenHandler =
  newPlayerScreenHandler(p.inventory, none[WindowType](), 0'u8, nil)

block layout:
  let p = newTestPlayer()
  let h = handler(p)
  check(h.behaviour.slots.len == 46, "46 slots")
  check(h.behaviour.windowType.isNone, "no window")
  check(h.getSlot(5).index == 39, "head")
  check(h.getSlot(8).index == 36, "feet")
  check(h.getSlot(9).index == 9, "main")
  check(h.getSlot(36).index == 0, "hotbar")
  check(h.getSlot(45).index == 40, "off hand")
  check(isInHotbar(36'u8) and isInHotbar(45'u8) and not isInHotbar(35'u8), "is in hotbar, 36..=45 as upstream")

block twoByTwoCrafting:
  let p = newTestPlayer()
  let h = handler(p)
  h.behaviour.cursorStack = stackOf(ITEM_OAK_PLANKS, 2)
  # A right click places one; grid cells 0 and 2 are slots 1 and 3.
  ScreenHandler(h).onSlotClick(1'i32, 1'i32, satPickup, p)
  ScreenHandler(h).onSlotClick(3'i32, 1'i32, satPickup, p)
  ScreenHandler(h).sendContentUpdates()
  checkStack(h.getSlot(0).getStack(), ITEM_STICK, 4, "sticks")
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_STICK, 4, "taken")
  ScreenHandler(h).sendContentUpdates()
  checkStack(h.getSlot(0).getStack(), ITEM_STICK, 0, "nothing left to craft")
  checkStack(h.getSlot(1).getStack(), ITEM_OAK_PLANKS, 0, "grid spent")

block shiftClickCraft:
  let p = newTestPlayer()
  let h = handler(p)
  h.getSlot(1).setStack(stackOf(ITEM_OAK_PLANKS, 2))
  h.getSlot(3).setStack(stackOf(ITEM_OAK_PLANKS, 2))
  ScreenHandler(h).sendContentUpdates()
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(8), ITEM_STICK, 8, "two crafts into hotbar 8")
  checkStack(h.getSlot(1).getStack(), ITEM_OAK_PLANKS, 0, "grid spent")

block quickMoveRoutes:
  let p = newTestPlayer()
  let h = handler(p)
  # Main to hotbar.
  p.setMain(9, stackOf(ITEM_STONE, 5))
  ScreenHandler(h).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(0), ITEM_STONE, 5, "main to hotbar")
  # Hotbar to main.
  ScreenHandler(h).onSlotClick(36'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_STONE, 5, "hotbar to main")
  # Grid to the player's front.
  p.setMain(9, emptyItemStack())
  h.getSlot(2).setStack(stackOf(ITEM_DIRT, 1))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_DIRT, 1, "grid to main")

block armorByShiftClick:
  let p = newTestPlayer()
  let h = handler(p)
  p.setMain(9, stackOf(ITEM_DIAMOND_HELMET, 1))
  ScreenHandler(h).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(h.getSlot(5).getStack(), ITEM_DIAMOND_HELMET, 1, "helmet to the head slot")
  checkStack(p.inventory.entityEquipment.get(esHead), ITEM_DIAMOND_HELMET, 1, "in the equipment")
  checkStack(p.mainStack(9), ITEM_STONE, 0, "source empty")
  check(p.equipment.len == 1, "client told")
  check(p.equipment[0].slot == esHead, "head changed")
  checkStack(p.equipment[0].stack, ITEM_DIAMOND_HELMET, 1, "to the helmet")

  # And off again, to the player's front.
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(9), ITEM_DIAMOND_HELMET, 1, "helmet back")
  check(h.getSlot(5).getStack().isEmpty(), "head empty")
  check(p.equipment.len == 2 and p.equipment[1].slot == esHead and p.equipment[1].stack.isEmpty(), "unequip told")

block anOccupiedArmorSlotIsSkipped:
  let p = newTestPlayer()
  let h = handler(p)
  h.getSlot(5).setStack(stackOf(ITEM_IRON_HELMET, 1))
  p.setMain(9, stackOf(ITEM_DIAMOND_HELMET, 1))
  ScreenHandler(h).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(p.mainStack(0), ITEM_DIAMOND_HELMET, 1, "falls through to main to hotbar")
  checkStack(h.getSlot(5).getStack(), ITEM_IRON_HELMET, 1, "iron stays")

block offHandByShiftClick:
  let p = newTestPlayer()
  let h = handler(p)
  p.setMain(9, stackOf(ITEM_SHIELD, 1))
  ScreenHandler(h).onSlotClick(9'i32, 0'i32, satQuickMove, p)
  checkStack(h.getSlot(45).getStack(), ITEM_SHIELD, 1, "shield to the off hand")

block armorByClick:
  let p = newTestPlayer()
  let h = handler(p)
  h.behaviour.cursorStack = stackOf(ITEM_DIAMOND_BOOTS, 1)
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_DIAMOND_BOOTS, 1, "boots refused by the head slot")
  # As upstream, the equipment change is enqueued before the insert is tried, so a refused one is told too.
  check(p.equipment.len == 1 and p.equipment[0].slot == esFeet, "refused, still told")
  ScreenHandler(h).onSlotClick(8'i32, 0'i32, satPickup, p)
  checkStack(h.getSlot(8).getStack(), ITEM_DIAMOND_BOOTS, 1, "boots on the feet")
  check(h.behaviour.cursorStack.isEmpty(), "cursor empty")
  check(p.equipment.len == 2 and p.equipment[1].slot == esFeet, "equip told")
  ScreenHandler(h).onSlotClick(8'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, ITEM_DIAMOND_BOOTS, 1, "picked up")
  check(p.equipment.len == 3 and p.equipment[2].slot == esFeet and p.equipment[2].stack.isEmpty(), "unequip told")

block swapIntoAnArmorSlotSplitsACopy:
  # "button_stack might need to be a ref instead of a clone": as upstream, the hotbar keeps its count.
  let p = newTestPlayer()
  let h = handler(p)
  p.setMain(0, stackOf(ITEM_DIAMOND_HELMET, 2))
  ScreenHandler(h).onSlotClick(5'i32, 0'i32, satSwap, p)
  checkStack(h.getSlot(5).getStack(), ITEM_DIAMOND_HELMET, 1, "one on the head")
  checkStack(p.mainStack(0), ITEM_DIAMOND_HELMET, 2, "hotbar unchanged")

block closingReturnsTheGrid:
  let p = newTestPlayer()
  let h = handler(p)
  h.getSlot(1).setStack(stackOf(ITEM_DIRT, 3))
  ScreenHandler(h).onClosed(p)
  checkStack(p.mainStack(0), ITEM_DIRT, 3, "grid offered back")

echo "player_screen_handler: OK"
