## Port of pumpkin-inventory/src/crafting/recipe_provider.rs
##
## `match_item` needs the tag lookup that generated/recipes.aowl and protocol/recipe.aowl leave to the caller. Both
## take it as a closure; the same three cases are written here against `Item`, with none.

import "../data/item_stack/mod"
import ../generated/recipes as generated
import ../generated/tag as tagdata
import ../protocol/recipe

type
  RecipeProvider* = ref object of RootObj
    getDynamicRecipesImpl*: proc(self: RecipeProvider): seq[DynamicRecipe] {.closure.}

proc getDynamicRecipes*(self: RecipeProvider): seq[DynamicRecipe] =
  let f = self.getDynamicRecipesImpl
  f(self)

proc itemHasTag(item: Item; tag: string): bool =
  ## `item.has_tag(tag)`, for the tag's name.
  let (found, tagged) = tagdata.isTaggedWith(toTaggable(item), tag)
  found and tagged

proc matchItem*(self: generated.RecipeIngredient; item: Item): bool =
  ## `RecipeIngredientTypes::match_item`.
  case self.kind
  of rikSimple: "minecraft:" & item.registryKey == self.name
  of rikTagged: itemHasTag(item, self.name)
  of rikOneOf: ("minecraft:" & item.registryKey) in self.options

proc matchItem*(self: OwnedRecipeIngredient; item: Item): bool =
  ## `OwnedRecipeIngredient::match_item`.
  case self.kind
  of oriSimple: "minecraft:" & item.registryKey == self.id
  of oriTagged: itemHasTag(item, self.tag)
  of oriOneOf: ("minecraft:" & item.registryKey) in self.ids
