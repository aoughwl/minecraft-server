## recipe_provider.rs: `match_item` on both kinds of ingredient, and a provider.

import invtestkit, recipe_provider
import ../generated/recipes as generated
import ../protocol/recipe

check(RecipeIngredient(kind: rikSimple, name: "minecraft:stone").matchItem(ITEM_STONE), "simple")
check(not RecipeIngredient(kind: rikSimple, name: "minecraft:stone").matchItem(ITEM_DIRT), "simple, no")
check(RecipeIngredient(kind: rikTagged, name: "#minecraft:planks").matchItem(ITEM_OAK_PLANKS), "tagged")
check(not RecipeIngredient(kind: rikTagged, name: "#minecraft:planks").matchItem(ITEM_STONE), "tagged, no")
check(not RecipeIngredient(kind: rikTagged, name: "#minecraft:no_such_tag").matchItem(ITEM_STONE), "no such tag")
check(RecipeIngredient(kind: rikOneOf, options: @["minecraft:dirt", "minecraft:stone"]).matchItem(ITEM_STONE), "one of")
check(not RecipeIngredient(kind: rikOneOf, options: @["minecraft:dirt"]).matchItem(ITEM_STONE), "one of, no")

check(OwnedRecipeIngredient(kind: oriSimple, id: "minecraft:stone").matchItem(ITEM_STONE), "owned simple")
check(OwnedRecipeIngredient(kind: oriTagged, tag: "minecraft:planks").matchItem(ITEM_OAK_PLANKS), "owned tagged")
check(OwnedRecipeIngredient(kind: oriOneOf, ids: @["minecraft:stone"]).matchItem(ITEM_STONE), "owned one of")
check(not OwnedRecipeIngredient(kind: oriOneOf, ids: @["minecraft:dirt"]).matchItem(ITEM_STONE), "owned one of, no")

proc noRecipes(self: RecipeProvider): seq[DynamicRecipe] = @[]

let provider = RecipeProvider(getDynamicRecipesImpl: noRecipes)
check(provider.getDynamicRecipes().len == 0, "a provider")

echo "recipe_provider: OK"
