## Port of pumpkin-inventory/src/crafting/recipes.rs
##
## `RecipeInputInventory: Inventory` adds a grid's dimensions. Every implementor upstream is `CraftingInventory`,
## whose storage is `ArrayInventory`, so this subclasses that. The marker types have no body upstream either.

import inventory

type
  RecipeMatcher* = object
    ## RecipeMatcher.java.

  RecipeFinder* = object
    ## RecipeFinder.java.

  RecipeInputInventory* = ref object of ArrayInventory
    getWidthImpl*: proc(self: RecipeInputInventory): int {.closure.}
    getHeightImpl*: proc(self: RecipeInputInventory): int {.closure.}
    # TODO upstream: fn get_held_stacks(), createRecipeInput, createPositionedRecipeInput

proc getWidth*(self: RecipeInputInventory): int =
  let f = self.getWidthImpl
  f(self)

proc getHeight*(self: RecipeInputInventory): int =
  let f = self.getHeightImpl
  f(self)
