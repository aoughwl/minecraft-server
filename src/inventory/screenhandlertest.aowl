## Known answers for every click kind, worked out by hand from `internal_on_slot_click` in screen_handler.rs:
## pickup, quick move, swap, clone, throw, quick craft (drag), pickup all. Run against a 9x3 chest: slots 0-26 are the
## chest, 27-53 the player's 9-35, 54-62 the hotbar 0-8.

import std/options
import invtestkit, genericcontainer, inventory, player_inventory, screenhandler, slot, sync_handler
import ../protocol/itemstackserializer
import ../generated/screen

const OutsideSlot = -999'i32

type
  Rig = object
    player: TestPlayer
    chest: ArrayInventory
    handler: ScreenHandler

proc rig(creative = false): Rig =
  let player = newTestPlayer(creative)
  let chest = newArrayInventory(27)
  Rig(player: player, chest: chest, handler: createGeneric9x3(1'u8, player.inventory, chest))

proc click(r: Rig; slot, button: int32; action: SlotActionType) =
  r.handler.onSlotClick(slot, button, action, r.player)

proc cursor(r: Rig): ItemStack = r.handler.behaviour.cursorStack

proc setCursor(r: Rig; stack: ItemStack) =
  r.handler.behaviour.cursorStack = stack

proc at(r: Rig; slot: int): ItemStack = Inventory(r.chest).getStack(slot)

proc put(r: Rig; slot: int; stack: ItemStack) = Inventory(r.chest).setStack(slot, stack)

# --- Pickup ---------------------------------------------------------------------------------------------------

block leftClickTakesTheWholeStack:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 10))
  r.click(0'i32, 0'i32, satPickup)
  checkStack(r.cursor(), ITEM_STONE, 10, "pickup left, cursor")
  checkStack(r.at(0), ITEM_STONE, 0, "pickup left, slot")

block rightClickTakesHalfRoundedUp:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 5))
  r.click(0'i32, 1'i32, satPickup)
  checkStack(r.cursor(), ITEM_STONE, 3, "pickup right, cursor")
  checkStack(r.at(0), ITEM_STONE, 2, "pickup right, slot")

block leftClickPlacesAll:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(0'i32, 0'i32, satPickup)
  checkStack(r.at(0), ITEM_STONE, 10, "place left, slot")
  checkStack(r.cursor(), ITEM_STONE, 0, "place left, cursor")

block rightClickPlacesOne:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(0'i32, 1'i32, satPickup)
  checkStack(r.at(0), ITEM_STONE, 1, "place right, slot")
  checkStack(r.cursor(), ITEM_STONE, 9, "place right, cursor")

block leftClickMergesUpToTheMax:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 60))
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(0'i32, 0'i32, satPickup)
  checkStack(r.at(0), ITEM_STONE, 64, "merge left, slot")
  checkStack(r.cursor(), ITEM_STONE, 6, "merge left, cursor")

block rightClickMergesOne:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 5))
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(0'i32, 1'i32, satPickup)
  checkStack(r.at(0), ITEM_STONE, 6, "merge right, slot")
  checkStack(r.cursor(), ITEM_STONE, 9, "merge right, cursor")

block differentItemsSwapOnEitherButton:
  for button in [0'i32, 1'i32]:
    let r = rig()
    r.put(0, stackOf(ITEM_STONE, 3))
    r.setCursor(stackOf(ITEM_DIRT, 5))
    r.click(0'i32, button, satPickup)
    checkStack(r.at(0), ITEM_DIRT, 5, "swap, slot")
    checkStack(r.cursor(), ITEM_STONE, 3, "swap, cursor")

block unstackableDoesNotMerge:
  let r = rig()
  r.put(0, stackOf(ITEM_DIAMOND_PICKAXE, 1))
  r.setCursor(stackOf(ITEM_DIAMOND_PICKAXE, 1))
  r.click(0'i32, 0'i32, satPickup)
  checkStack(r.at(0), ITEM_DIAMOND_PICKAXE, 1, "unstackable, slot")
  checkStack(r.cursor(), ITEM_DIAMOND_PICKAXE, 1, "unstackable, cursor keeps its own")

block outsideLeftDropsTheCursor:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(OutsideSlot, 0'i32, satPickup)
  check(r.player.drops.len == 1, "outside left, one drop")
  checkStack(r.player.drops[0].stack, ITEM_STONE, 10, "outside left, dropped")
  check(r.player.drops[0].retainOwnership, "outside left, retains ownership")
  checkStack(r.cursor(), ITEM_STONE, 0, "outside left, cursor")

block outsideRightDropsOne:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(OutsideSlot, 1'i32, satPickup)
  checkStack(r.player.drops[0].stack, ITEM_STONE, 1, "outside right, dropped")
  checkStack(r.cursor(), ITEM_STONE, 9, "outside right, cursor")

block aNegativeSlotIsNothing:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(-1'i32, 0'i32, satPickup)
  checkStack(r.cursor(), ITEM_STONE, 10, "negative slot, cursor")
  check(r.player.drops.len == 0, "negative slot, no drop")

# --- Quick move -----------------------------------------------------------------------------------------------

block quickMoveFromChestGoesToTheLastHotbarSlot:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 10))
  r.click(0'i32, 0'i32, satQuickMove)
  checkStack(r.at(0), ITEM_STONE, 0, "quick move out, chest")
  checkStack(r.player.mainStack(8), ITEM_STONE, 10, "quick move out, hotbar 8")

block quickMoveFromPlayerMergesThenFillsFromTheFront:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 60))
  r.player.setMain(0, stackOf(ITEM_STONE, 64))
  r.click(54'i32, 0'i32, satQuickMove)
  checkStack(r.at(0), ITEM_STONE, 64, "quick move in, merged")
  checkStack(r.at(1), ITEM_STONE, 60, "quick move in, rest in first empty")
  checkStack(r.player.mainStack(0), ITEM_STONE, 0, "quick move in, source")

block quickMoveWithNoRoomChangesNothing:
  let r = rig()
  for i in 0 ..< 27:
    r.put(i, stackOf(ITEM_DIRT, 64))
  r.player.setMain(0, stackOf(ITEM_STONE, 5))
  r.click(54'i32, 0'i32, satQuickMove)
  checkStack(r.player.mainStack(0), ITEM_STONE, 5, "quick move no room")

block quickMoveLeavesTheRemainderWhenPartlyFull:
  let r = rig()
  for i in 0 ..< 27:
    r.put(i, stackOf(ITEM_STONE, 64))
  r.put(26, stackOf(ITEM_STONE, 62))
  r.player.setMain(0, stackOf(ITEM_STONE, 5))
  r.click(54'i32, 0'i32, satQuickMove)
  checkStack(r.at(26), ITEM_STONE, 64, "quick move partial, filled")
  checkStack(r.player.mainStack(0), ITEM_STONE, 3, "quick move partial, remainder")

# --- Swap -----------------------------------------------------------------------------------------------------

block swapToAnEmptyHotbarSlot:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 5))
  r.click(0'i32, 2'i32, satSwap)
  checkStack(r.player.mainStack(2), ITEM_STONE, 5, "swap out, hotbar")
  checkStack(r.at(0), ITEM_STONE, 0, "swap out, slot")

block swapFromAHotbarSlotToAnEmptySlot:
  let r = rig()
  r.player.setMain(3, stackOf(ITEM_DIRT, 7))
  r.click(1'i32, 3'i32, satSwap)
  checkStack(r.at(1), ITEM_DIRT, 7, "swap in, slot")
  checkStack(r.player.mainStack(3), ITEM_DIRT, 0, "swap in, hotbar")

block swapWithBothOccupiedDoesNothing:
  # Upstream has no branch for it.
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 5))
  r.player.setMain(3, stackOf(ITEM_DIRT, 7))
  r.click(0'i32, 3'i32, satSwap)
  checkStack(r.at(0), ITEM_STONE, 5, "swap both, slot")
  checkStack(r.player.mainStack(3), ITEM_DIRT, 7, "swap both, hotbar")

block swapWithTheOffHand:
  let r = rig()
  r.put(2, stackOf(ITEM_STONE, 1))
  r.click(2'i32, 40'i32, satSwap)
  checkStack(r.player.inventory.offHandItem(), ITEM_STONE, 1, "swap off hand")
  checkStack(r.at(2), ITEM_STONE, 0, "swap off hand, slot")

block button40SwapsWhateverTheActionIs:
  # `action_type == Swap && (0..9).contains(&button) || button == 40`: the `||` is not under the `Swap`.
  let r = rig()
  r.put(2, stackOf(ITEM_STONE, 1))
  r.click(2'i32, 40'i32, satQuickMove)
  checkStack(r.player.inventory.offHandItem(), ITEM_STONE, 1, "button 40, off hand")

# --- Clone ----------------------------------------------------------------------------------------------------

block cloneInCreativeFillsTheCursorToTheMax:
  let r = rig(creative = true)
  r.put(0, stackOf(ITEM_STONE, 3))
  r.click(0'i32, 2'i32, satClone)
  checkStack(r.cursor(), ITEM_STONE, 64, "clone, cursor")
  checkStack(r.at(0), ITEM_STONE, 3, "clone, slot untouched")

block cloneOutsideCreativeDoesNothing:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 3))
  r.click(0'i32, 2'i32, satClone)
  checkStack(r.cursor(), ITEM_STONE, 0, "clone survival, cursor")

block cloneWithAFullCursorDoesNothing:
  let r = rig(creative = true)
  r.put(0, stackOf(ITEM_STONE, 3))
  r.setCursor(stackOf(ITEM_DIRT, 1))
  r.click(0'i32, 2'i32, satClone)
  checkStack(r.cursor(), ITEM_DIRT, 1, "clone with cursor")

# --- Throw ----------------------------------------------------------------------------------------------------

block throwOne:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 3))
  r.click(0'i32, 0'i32, satThrow)
  check(r.player.drops.len == 1, "throw one, one drop")
  checkStack(r.player.drops[0].stack, ITEM_STONE, 1, "throw one, dropped")
  check(r.player.drops[0].retainOwnership, "throw one, retains ownership")
  checkStack(r.at(0), ITEM_STONE, 2, "throw one, slot")

block throwAll:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 3))
  r.click(0'i32, 1'i32, satThrow)
  check(r.player.drops.len == 1, "throw all, one drop")
  checkStack(r.player.drops[0].stack, ITEM_STONE, 3, "throw all, dropped")
  checkStack(r.at(0), ITEM_STONE, 0, "throw all, slot")

block throwWithACursorDoesNothing:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 3))
  r.setCursor(stackOf(ITEM_DIRT, 1))
  r.click(0'i32, 0'i32, satThrow)
  check(r.player.drops.len == 0, "throw with cursor")
  checkStack(r.at(0), ITEM_STONE, 3, "throw with cursor, slot")

# --- Quick craft (drag) ---------------------------------------------------------------------------------------

proc drag(r: Rig; dragButton: int32; slots: openArray[int32]) =
  ## `button` is `(drag_button << 2) | drag_type`: 0 starts, 1 adds a slot, 2 ends.
  r.click(OutsideSlot, dragButton shl 2, satQuickCraft)
  for s in slots:
    r.click(s, (dragButton shl 2) or 1'i32, satQuickCraft)
  r.click(OutsideSlot, (dragButton shl 2) or 2'i32, satQuickCraft)

block leftDragSharesEvenly:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(0'i32, [0'i32, 1'i32, 2'i32])
  for i in 0 ..< 3:
    checkStack(r.at(i), ITEM_STONE, 3, "left drag, slot")
  checkStack(r.cursor(), ITEM_STONE, 1, "left drag, remainder")
  check(r.handler.behaviour.dragSlots.len == 0, "left drag, slots cleared")

block rightDragPlacesOneEach:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(1'i32, [0'i32, 1'i32, 2'i32])
  for i in 0 ..< 3:
    checkStack(r.at(i), ITEM_STONE, 1, "right drag, slot")
  checkStack(r.cursor(), ITEM_STONE, 7, "right drag, cursor")

block rightDragStopsWhenTheCursorRunsOut:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 2))
  r.drag(1'i32, [0'i32, 1'i32, 2'i32])
  checkStack(r.at(0), ITEM_STONE, 1, "right drag short, first")
  checkStack(r.at(1), ITEM_STONE, 1, "right drag short, second")
  checkStack(r.at(2), ITEM_STONE, 0, "right drag short, third")
  checkStack(r.cursor(), ITEM_STONE, 0, "right drag short, cursor")

block middleDragInCreativeFillsStacks:
  let r = rig(creative = true)
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(2'i32, [0'i32, 1'i32])
  checkStack(r.at(0), ITEM_STONE, 64, "middle drag, first")
  checkStack(r.at(1), ITEM_STONE, 64, "middle drag, second")
  checkStack(r.cursor(), ITEM_STONE, 0, "middle drag, cursor cleared")

block middleDragOutsideCreativeDoesNothing:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(2'i32, [0'i32, 1'i32])
  checkStack(r.at(0), ITEM_STONE, 0, "middle drag survival, slot")
  checkStack(r.cursor(), ITEM_STONE, 10, "middle drag survival, cursor")

block dragOverOneSlotIsAPickup:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(0'i32, [4'i32])
  checkStack(r.at(4), ITEM_STONE, 10, "one-slot left drag places all")
  checkStack(r.cursor(), ITEM_STONE, 0, "one-slot left drag, cursor")
  let r2 = rig()
  r2.setCursor(stackOf(ITEM_STONE, 10))
  r2.drag(1'i32, [4'i32])
  checkStack(r2.at(4), ITEM_STONE, 1, "one-slot right drag places one")

block dragClampsToWhatASlotHolds:
  let r = rig()
  r.put(0, stackOf(ITEM_STONE, 63))
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(0'i32, [0'i32, 1'i32])
  checkStack(r.at(0), ITEM_STONE, 64, "drag clamp, full slot")
  checkStack(r.at(1), ITEM_STONE, 5, "drag clamp, empty slot")
  checkStack(r.cursor(), ITEM_STONE, 4, "drag clamp, cursor")

block dragSkipsADifferentItem:
  let r = rig()
  r.put(1, stackOf(ITEM_DIRT, 1))
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.click(OutsideSlot, 0'i32, satQuickCraft)
  r.click(0'i32, 1'i32, satQuickCraft)
  r.click(1'i32, 1'i32, satQuickCraft)
  check(r.handler.behaviour.dragSlots.len == 1, "drag over a different item is not added")
  r.click(2'i32, 1'i32, satQuickCraft)
  r.click(OutsideSlot, 2'i32, satQuickCraft)
  checkStack(r.at(0), ITEM_STONE, 5, "drag skip, first")
  checkStack(r.at(1), ITEM_DIRT, 1, "drag skip, other item")
  checkStack(r.at(2), ITEM_STONE, 5, "drag skip, third")
  checkStack(r.cursor(), ITEM_STONE, 0, "drag skip, cursor")

block dragWithAnEmptyCursorAddsNothing:
  let r = rig()
  r.drag(0'i32, [0'i32, 1'i32])
  check(r.handler.behaviour.dragSlots.len == 0, "drag empty cursor")
  checkStack(r.at(0), ITEM_STONE, 0, "drag empty cursor, slot")

block dragButtonThreeIsIgnoredRatherThanPanicking:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.drag(3'i32, [0'i32, 1'i32])
  checkStack(r.cursor(), ITEM_STONE, 10, "drag button 3, cursor")
  checkStack(r.at(0), ITEM_STONE, 0, "drag button 3, slot")

# --- Pickup all -----------------------------------------------------------------------------------------------

block pickupAllGathersUpToTheMax:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.put(0, stackOf(ITEM_STONE, 5))
  r.put(1, stackOf(ITEM_DIRT, 3))
  r.put(2, stackOf(ITEM_STONE, 60))
  r.click(5'i32, 0'i32, satPickupAll)
  checkStack(r.cursor(), ITEM_STONE, 64, "pickup all, cursor")
  checkStack(r.at(0), ITEM_STONE, 0, "pickup all, emptied")
  checkStack(r.at(1), ITEM_DIRT, 3, "pickup all, other item")
  checkStack(r.at(2), ITEM_STONE, 11, "pickup all, partly taken")

block pickupAllOnlyOnButtonZero:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.put(0, stackOf(ITEM_STONE, 5))
  r.click(5'i32, 1'i32, satPickupAll)
  checkStack(r.cursor(), ITEM_STONE, 10, "pickup all button 1, cursor")
  checkStack(r.at(0), ITEM_STONE, 5, "pickup all button 1, slot")

# --- insert_item, directly ------------------------------------------------------------------------------------

block insertItemFromLastGoesBackwards:
  let r = rig()
  r.put(1, stackOf(ITEM_STONE, 62))
  var incoming = stackOf(ITEM_STONE, 5)
  check(r.handler.insertItem(incoming, 0'i32, 3'i32, true), "insert from last")
  checkStack(r.at(1), ITEM_STONE, 64, "insert from last, merged")
  checkStack(r.at(2), ITEM_STONE, 3, "insert from last, empty slot from the end")
  checkStack(incoming, ITEM_STONE, 0, "insert from last, consumed")

block insertItemFailsWithNoRoom:
  let r = rig()
  r.put(0, stackOf(ITEM_DIRT, 1))
  var incoming = stackOf(ITEM_STONE, 5)
  check(not r.handler.insertItem(incoming, 0'i32, 1'i32, false), "insert no room")
  checkStack(incoming, ITEM_STONE, 5, "insert no room, unchanged")

# --- Sync -----------------------------------------------------------------------------------------------------

block updatesReachTheClient:
  let r = rig()
  let syncHandler = newSyncHandler()
  syncHandler.storePlayer(r.player)
  r.handler.updateSyncHandler(syncHandler)
  # The full state: revision 1, all 63 slots, no properties.
  check(r.player.contentPackets.len == 1, "full state sent")
  check(r.player.contentPackets[0].windowId.value == 1'i32, "full state window")
  check(r.player.contentPackets[0].stateId.value == 1'i32, "full state revision")
  check(r.player.contentPackets[0].slotData.len == 63, "full state slots")

  r.put(0, stackOf(ITEM_STONE, 10))
  r.handler.sendContentUpdates()
  check(r.player.slotPackets.len == 1, "one slot update")
  check(r.player.slotPackets[0].slot == 0'i16, "slot update, slot")
  check(r.player.slotPackets[0].windowId == 1'i8, "slot update, window")
  check(r.player.slotPackets[0].stateId.value == 2'i32, "slot update, revision")
  check(r.player.slotPackets[0].slotData.stack.itemCount == 10'u8, "slot update, count")
  check(r.player.slotPackets[0].slotData.stack.itemId == ITEM_STONE.id, "slot update, item")
  check(r.player.cursorPackets.len == 0, "no cursor update")

  # The client already agrees: nothing more is sent.
  r.handler.sendContentUpdates()
  check(r.player.slotPackets.len == 1, "no repeated update")

  r.click(0'i32, 0'i32, satPickup)
  r.handler.sendContentUpdates()
  check(r.player.slotPackets.len == 2, "slot emptied")
  check(r.player.slotPackets[1].slotData.stack.isEmpty(), "slot emptied, empty")
  check(r.player.cursorPackets.len == 1, "cursor update")
  check(r.player.cursorPackets[0].stack.stack.itemCount == 10'u8, "cursor update, count")

block closingOffersTheCursorToThePlayer:
  let r = rig()
  r.setCursor(stackOf(ITEM_STONE, 10))
  r.handler.onClosed(r.player)
  checkStack(r.cursor(), ITEM_STONE, 0, "closed, cursor")
  checkStack(r.player.mainStack(0), ITEM_STONE, 10, "closed, offered to the first slot")
  check(r.player.slotSetPackets.len == 1, "closed, client told")

block nextRevisionWrapsAt32767:
  let b = newScreenHandlerBehaviour(0'u8, none[WindowType]())
  check(b.nextRevision() == 1'u32, "first revision")
  b.revision = 32767'u32
  check(b.nextRevision() == 0'u32, "wraps")
  check(b.revision == 0'u32, "wrapped in place")

echo "screenhandler: every click kind OK"
