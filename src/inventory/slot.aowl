## Port of pumpkin-inventory/src/slot.rs
##
## Rust's `Slot: Send + Sync` trait is a `ref object` whose fields take the slot as `self`, so a concrete slot in
## any module subclasses it and fills them with plain procs, needing no closure over itself. A field left nil is
## upstream's default body. Methods no implementor overrides upstream are free procs.
##
## `get_stack` answers a copy; see inventory.aowl. `storeStack` is the write half of upstream's
## `*slot.get_stack().await.lock().await = stack`, and is what `ResultSlot` redirects to its cached result.

import std/options
import "../data/item_stack/mod"
import "../data/item_stack/categories"
import ../generated/item_full
import inventory, player_inventory

type
  Slot* = ref object of RootObj
    inventory*: Inventory      ## `get_inventory`.
    index*: int                ## `get_index`.
    id*: uint8                 ## Protocol id, assigned by the screen handler.
    onQuickMoveCraftedImpl*: proc(self: Slot; stack, stackPrev: ItemStack) {.closure.}  ## default: no-op
    onTakeItemImpl*: proc(self: Slot; player: InventoryPlayer; stack: ItemStack) {.closure.}  ## default: markDirty
    onClickImpl*: proc(self: Slot; player: InventoryPlayer) {.closure.}  ## default: no-op
    canInsertImpl*: proc(self: Slot; stack: ItemStack): bool {.closure.}  ## default: true
    getStackImpl*: proc(self: Slot): ItemStack {.closure.}  ## default: the inventory's stack
    storeStackImpl*: proc(self: Slot; stack: ItemStack) {.closure.}  ## default: the inventory's stack
    setStackImpl*: proc(self: Slot; stack: ItemStack) {.closure.}  ## default: setStackNoCallbacks
    setStackPrevImpl*: proc(self: Slot; stack, previousStack: ItemStack) {.closure.}  ## default: setStackNoCallbacks
    markDirtyImpl*: proc(self: Slot) {.closure.}  ## "must be implemented"; every one marks the inventory
    getMaxItemCountImpl*: proc(self: Slot): uint8 {.closure.}  ## default: inventory.getMaxCountPerStack
    takeStackImpl*: proc(self: Slot; amount: uint8): ItemStack {.closure.}  ## default: removeStackSpecific
    canTakeItemsImpl*: proc(self: Slot; player: InventoryPlayer): bool {.closure.}  ## default: true

proc getInventory*(s: Slot): Inventory {.inline.} = s.inventory

proc getIndex*(s: Slot): int {.inline.} = s.index

proc setId*(s: Slot; id: int) {.inline.} =
  s.id = uint8(id and 0xFF)

proc markDirty*(s: Slot) =
  let f = s.markDirtyImpl
  if f != nil:
    f(s)
  else:
    s.inventory.markDirty()

proc onQuickMoveCrafted*(s: Slot; stack, stackPrev: ItemStack) =
  let f = s.onQuickMoveCraftedImpl
  if f != nil: f(s, stack, stackPrev)

proc onTakeItem*(s: Slot; player: InventoryPlayer; stack: ItemStack) =
  let f = s.onTakeItemImpl
  if f != nil:
    f(s, player, stack)
  else:
    s.markDirty()

proc onClick*(s: Slot; player: InventoryPlayer) =
  let f = s.onClickImpl
  if f != nil: f(s, player)

proc canInsert*(s: Slot; stack: ItemStack): bool =
  let f = s.canInsertImpl
  if f != nil: f(s, stack) else: true

proc getStack*(s: Slot): ItemStack =
  let f = s.getStackImpl
  if f != nil: f(s) else: s.inventory.getStack(s.index)

proc getClonedStack*(s: Slot): ItemStack {.inline.} =
  s.getStack()

proc storeStack*(s: Slot; stack: ItemStack) =
  let f = s.storeStackImpl
  if f != nil:
    f(s, stack)
  else:
    s.inventory.storeStack(s.index, stack)

proc hasStack*(s: Slot): bool =
  not s.getStack().isEmpty()

proc setStackNoCallbacks*(s: Slot; stack: ItemStack) =
  s.inventory.setStack(s.index, stack)
  s.markDirty()

proc setStack*(s: Slot; stack: ItemStack) =
  let f = s.setStackImpl
  if f != nil:
    f(s, stack)
  else:
    s.setStackNoCallbacks(stack)

proc setStackPrev*(s: Slot; stack, previousStack: ItemStack) =
  let f = s.setStackPrevImpl
  if f != nil:
    f(s, stack, previousStack)
  else:
    s.setStackNoCallbacks(stack)

proc getMaxItemCount*(s: Slot): uint8 =
  let f = s.getMaxItemCountImpl
  if f != nil: f(s) else: s.inventory.getMaxCountPerStack()

proc getMaxItemCountForStack*(s: Slot; stack: ItemStack): uint8 =
  min(s.getMaxItemCount(), stack.getMaxStackSize())

proc takeStack*(s: Slot; amount: uint8): ItemStack =
  ## Mojang name: `remove`.
  let f = s.takeStackImpl
  if f != nil: f(s, amount) else: s.inventory.removeStackSpecific(s.index, amount)

proc canTakeItems*(s: Slot; player: InventoryPlayer): bool =
  ## Mojang name: `mayPickup`.
  let f = s.canTakeItemsImpl
  if f != nil: f(s, player) else: true

proc allowModification*(s: Slot; player: InventoryPlayer): bool =
  ## Mojang name: `allowModification`.
  s.canInsert(s.getClonedStack()) and s.canTakeItems(player)

proc tryTakeStackRange*(s: Slot; minCount, maxCount: uint8; player: InventoryPlayer): Option[ItemStack] =
  ## Mojang name: `tryRemove`. None if items cannot be taken or the slot is empty; a result slot gives no
  ## partial stack.
  if not s.canTakeItems(player):
    return none[ItemStack]()
  if not s.allowModification(player) and s.getClonedStack().itemCount > maxCount:
    return none[ItemStack]()
  let taking = min(minCount, maxCount)
  let stack = s.takeStack(taking)
  if stack.isEmpty():
    none[ItemStack]()
  else:
    if s.getClonedStack().isEmpty():
      s.setStackPrev(emptyItemStack(), stack)
    some(stack)

proc safeTake*(s: Slot; minCount, maxCount: uint8; player: InventoryPlayer): ItemStack =
  ## Mojang name: `safeTake`. An empty stack if none can be taken. Triggers the callback.
  let stack = s.tryTakeStackRange(minCount, maxCount, player)
  if stack.isSome:
    s.onTakeItem(player, stack.unsafeGet)
    stack.unsafeGet
  else:
    emptyItemStack()

proc insertStackCount*(s: Slot; stackIn: ItemStack; count: uint8): ItemStack =
  ## Inserts a specific count from a stack, answering the leftovers.
  var stack = stackIn
  if not stack.isEmpty() and s.canInsert(stack):
    var stackSelf = s.getStack()
    let minCount = min(min(count, stack.itemCount), s.getMaxItemCountForStack(stack) - stackSelf.itemCount)
    if minCount != 0'u8:
      if stackSelf.isEmpty():
        s.setStack(stack.split(minCount))
      elif stack.areItemsAndComponentsEqual(stackSelf):
        stack.decrement(minCount)
        stackSelf.increment(minCount)
        s.setStack(stackSelf)
  if stack.isEmpty(): emptyItemStack() else: stack

proc insertStack*(s: Slot; stack: ItemStack): ItemStack =
  s.insertStackCount(stack, stack.itemCount)

# --- NormalSlot -----------------------------------------------------------------------------------------------

proc newNormalSlot*(inventory: Inventory; index: int): Slot =
  ## Just called `Slot` in vanilla. Every default body is upstream's.
  Slot(inventory: inventory, index: index, id: 0'u8)

# --- ArmorSlot ------------------------------------------------------------------------------------------------

type
  ArmorSlot* = ref object of Slot
    equipmentSlot*: EquipmentSlot

proc armorCanInsert(self: Slot; stack: ItemStack): bool =
  let a = ArmorSlot(self)
  case a.equipmentSlot
  of esHead: stack.isHelmet() or stack.isSkull() or stack.item.id == ITEM_CARVED_PUMPKIN.id
  of esChest: stack.isChestplate() or stack.item.id == ITEM_ELYTRA.id
  of esLegs: stack.isLeggings()
  of esFeet: stack.isBoots()
  else: true

proc armorSetStackPrev(self: Slot; stack, previousStack: ItemStack) =
  # TODO upstream: this.entity.onEquipStack(this.equipmentSlot, previousStack, stack);
  self.setStackNoCallbacks(stack)

proc armorGetMaxItemCount(self: Slot): uint8 = 1'u8

proc armorCanTakeItems(self: Slot; player: InventoryPlayer): bool =
  # TODO upstream: check for curse of binding.
  true

proc newArmorSlot*(inventory: Inventory; index: int; equipmentSlot: EquipmentSlot): ArmorSlot =
  result = ArmorSlot(inventory: inventory, index: index, id: 0'u8, equipmentSlot: equipmentSlot)
  result.canInsertImpl = armorCanInsert
  result.setStackPrevImpl = armorSetStackPrev
  result.getMaxItemCountImpl = armorGetMaxItemCount
  result.canTakeItemsImpl = armorCanTakeItems
