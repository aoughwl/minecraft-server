## slot.rs: the default bodies, by hand, and `ArmorSlot`'s restrictions.

import std/options
import invtestkit, inventory, player_inventory, slot
import "../data/item_stack/categories"

let player = newTestPlayer()

block takeAndInsert:
  let inv = newArrayInventory(2)
  let s = newNormalSlot(inv, 1)
  check(not s.hasStack(), "starts empty")
  checkStack(s.insertStack(stackOf(ITEM_STONE, 70)), ITEM_STONE, 6, "insert keeps what will not fit")
  checkStack(s.getStack(), ITEM_STONE, 64, "insert fills to the item's max")
  checkStack(s.takeStack(4'u8), ITEM_STONE, 4, "take")
  checkStack(s.getStack(), ITEM_STONE, 60, "take leaves the rest")
  checkStack(s.insertStackCount(stackOf(ITEM_STONE, 10), 3'u8), ITEM_STONE, 7, "insert count")
  checkStack(s.getStack(), ITEM_STONE, 63, "insert count merged")
  checkStack(s.insertStack(stackOf(ITEM_DIRT, 1)), ITEM_DIRT, 1, "insert refuses a different item")

block tryTakeRange:
  let inv = newArrayInventory(1)
  let s = newNormalSlot(inv, 0)
  check(s.tryTakeStackRange(1'u8, 1'u8, player).isNone, "nothing to take")
  s.setStack(stackOf(ITEM_STONE, 5))
  let taken = s.tryTakeStackRange(10'u8, 3'u8, player)
  checkStack(taken.unsafeGet, ITEM_STONE, 3, "min of min and max")
  checkStack(s.getStack(), ITEM_STONE, 2, "rest stays")
  checkStack(s.safeTake(2'u8, 2'u8, player), ITEM_STONE, 2, "safe take")
  check(not s.hasStack(), "safe take empties")
  checkStack(s.safeTake(2'u8, 2'u8, player), ITEM_STONE, 0, "safe take from nothing")

block maxCountIsTheLowerOfSlotAndItem:
  let inv = newArrayInventory(1)
  let s = newNormalSlot(inv, 0)
  check(s.getMaxItemCount() == 99'u8, "inventory's default")
  check(s.getMaxItemCountForStack(stackOf(ITEM_STONE, 1)) == 64'u8, "stone")
  check(s.getMaxItemCountForStack(stackOf(ITEM_EGG, 1)) == 16'u8, "egg")

block armorSlots:
  let inv = newArrayInventory(4)
  let head = newArmorSlot(inv, 0, esHead)
  let chest = newArmorSlot(inv, 1, esChest)
  let legs = newArmorSlot(inv, 2, esLegs)
  let feet = newArmorSlot(inv, 3, esFeet)
  check(head.canInsert(stackOf(ITEM_DIAMOND_HELMET, 1)), "helmet on head")
  check(head.canInsert(stackOf(ITEM_CARVED_PUMPKIN, 1)), "pumpkin on head")
  check(head.canInsert(stackOf(ITEM_SKELETON_SKULL, 1)), "skull on head")
  check(not head.canInsert(stackOf(ITEM_STONE, 1)), "stone not on head")
  check(not head.canInsert(stackOf(ITEM_DIAMOND_BOOTS, 1)), "boots not on head")
  check(chest.canInsert(stackOf(ITEM_DIAMOND_CHESTPLATE, 1)), "chestplate")
  check(chest.canInsert(stackOf(ITEM_ELYTRA, 1)), "elytra")
  check(not chest.canInsert(stackOf(ITEM_DIAMOND_HELMET, 1)), "helmet not on chest")
  check(legs.canInsert(stackOf(ITEM_DIAMOND_LEGGINGS, 1)), "leggings")
  check(feet.canInsert(stackOf(ITEM_DIAMOND_BOOTS, 1)), "boots")
  check(head.getMaxItemCount() == 1'u8, "armor holds one")
  checkStack(head.insertStack(stackOf(ITEM_DIAMOND_HELMET, 2)), ITEM_DIAMOND_HELMET, 1, "one fits")
  check(head.canTakeItems(player), "armor can be taken")

echo "slot: OK"
