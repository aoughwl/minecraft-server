## Between the item stack the game holds and the one packets carry. Not an upstream file: upstream has one
## `ItemStack`, and `ItemStackSerializer` borrows it.
##
## Here there are two. src/data/item_stack/mod.aowl's `ItemStack` is the real one, with the `Item`, every component
## and the logic. src/protocol/datacomponent.aowl's is the wire's: count, raw item id, and the closed
## `DataComponentValue`, which holds the components upstream's codec `serialize` and `deserialize` handle.
## Inventory code uses the real one only and converts here, at the packet. `toSerializer` and `fromSerializer` are
## what a packet needs.
##
## PARTIAL: pumpkin-protocol/src/codec/item_stack_seralizer.rs - a component the codec has no case for (`dcLore`,
## `dcMaxDamage`, ...) is left out of the stack on the wire. Upstream's dispatch would fail the whole packet there,
## and a missing lore line is better than an inventory that never syncs. A sound id the `Sound` enum lacks, or a
## status effect id the table lacks, is dropped the same way coming off the wire.

import std/options
import "../data/item_stack/mod" as ds
import ../protocol/datacomponent as pdc
import ../protocol/itemstackserializer
import ../protocol/proto as pp
import ../generated/data_component
import ../generated/effect
import ../generated/sound as soundtable

proc toWireEnchantments(list: seq[ds.EnchantmentEntry]): seq[pdc.EnchantmentEntry] =
  result = @[]
  for e in list:
    result.add(pdc.EnchantmentEntry(id: e.enchantment.id, level: e.level))

proc toWireFireworkExplosion(e: ds.FireworkExplosionImpl): pdc.FireworkExplosionImpl =
  pdc.FireworkExplosionImpl(shape: pdc.FireworkExplosionShape(ord(e.shape)), colors: e.colors,
    fadeColors: e.fadeColors, hasTrail: e.hasTrail, hasTwinkle: e.hasTwinkle)

proc toWireSound(v: ds.IdOr[ds.SoundEvent]): pp.IdOr[pp.SoundEvent] =
  case v.kind
  of ds.iokId:
    pp.IdOr[pp.SoundEvent](kind: pp.iokId, id: uint16(ord(v.id)))
  of ds.iokValue:
    pp.IdOr[pp.SoundEvent](kind: pp.iokValue, value: pp.SoundEvent(soundName: v.value.soundName, range: v.value.range))

proc toWireIdSet(v: ds.IDSet): pdc.IDSet =
  case v.kind
  of ds.idsTag: pdc.IDSet(kind: pdc.idsTag, tag: v.tag)
  of ds.idsIds: pdc.IDSet(kind: pdc.idsIds, ids: v.ids)

proc toWireEffects(list: seq[ds.StatusEffectInstance]): seq[pdc.StatusEffectInstance] =
  result = @[]
  for e in list:
    let known = fromMinecraftName(StatusEffect, e.effectId)
    if known.isSome:
      result.add(pdc.StatusEffectInstance(effectId: known.unsafeGet.minecraftName, amplifier: e.amplifier,
        duration: e.duration, ambient: e.ambient, showParticles: e.showParticles, showIcon: e.showIcon))

proc toWireConsumeEffect(e: ds.ConsumeEffect): pdc.ConsumeEffect =
  case e.kind
  of ds.ceApplyEffects:
    pdc.ConsumeEffect(kind: pdc.ceApplyEffects, effects: toWireEffects(e.effects), probability: e.probability)
  of ds.ceRemoveEffects:
    pdc.ConsumeEffect(kind: pdc.ceRemoveEffects, removed: toWireIdSet(e.removed))
  of ds.ceClearAllEffects:
    pdc.ConsumeEffect(kind: pdc.ceClearAllEffects)
  of ds.ceTeleportRandomly:
    pdc.ConsumeEffect(kind: pdc.ceTeleportRandomly, diameter: e.diameter)
  of ds.cePlaySound:
    pdc.ConsumeEffect(kind: pdc.cePlaySound, sound: toWireSound(e.sound))

proc toWireStack*(stack: ds.ItemStack): pdc.ItemStack

proc toWireValue(data: ds.DataComponentImpl; ok: var bool): pdc.DataComponentValue =
  ## The closed `DataComponentValue` for one set component. `ok` is false for one the codec has no case for.
  ok = true
  case data.kind
  of dcMaxStackSize:
    pdc.DataComponentValue(kind: dcvMaxStackSize, maxStackSize: pdc.MaxStackSizeImpl(size: data.maxStackSize.size))
  of dcDamage:
    pdc.DataComponentValue(kind: dcvDamage, damage: pdc.DamageImpl(damage: data.damage.damage))
  of dcEnchantments:
    pdc.DataComponentValue(kind: dcvEnchantments,
      enchantments: pdc.EnchantmentsImpl(enchantment: toWireEnchantments(data.enchantments.enchantment)))
  of dcStoredEnchantments:
    pdc.DataComponentValue(kind: dcvStoredEnchantments, storedEnchantments: pdc.StoredEnchantmentsImpl(
      enchantment: toWireEnchantments(data.storedEnchantments.enchantment)))
  of dcUnbreakable:
    pdc.DataComponentValue(kind: dcvUnbreakable, unbreakable: pdc.UnbreakableImpl())
  of dcItemModel:
    pdc.DataComponentValue(kind: dcvItemModel, itemModel: pdc.ItemModelImpl(id: data.itemModel.id))
  of dcCustomName:
    pdc.DataComponentValue(kind: dcvCustomName, customName: pdc.CustomNameImpl(name: data.customName.name))
  of dcCustomData:
    pdc.DataComponentValue(kind: dcvCustomData, customData: pdc.CustomDataImpl(data: data.customData.data))
  of dcConsumable:
    var effects: seq[pdc.ConsumeEffect] = @[]
    for e in data.consumable.effects:
      effects.add(toWireConsumeEffect(e))
    pdc.DataComponentValue(kind: dcvConsumable, consumable: pdc.ConsumableImpl(
      consumeSeconds: data.consumable.consumeSeconds, animation: pdc.ConsumeAnimation(ord(data.consumable.animation)),
      soundEvent: toWireSound(data.consumable.soundEvent), consumeParticles: data.consumable.consumeParticles,
      effects: effects))
  of dcEquippable:
    let e = data.equippable
    var allowed = pdc.IDSet(kind: pdc.idsIds, ids: @[])
    if e.allowedEntities.isSome:
      allowed = toWireIdSet(e.allowedEntities.unsafeGet)
    pdc.DataComponentValue(kind: dcvEquippable, equippable: pdc.EquippableImpl(
      slot: pdc.EquipmentSlot(ord(e.slot)), equipSound: toWireSound(e.equipSound), assetId: e.assetId,
      cameraOverlay: e.cameraOverlay, hasAllowedEntities: e.allowedEntities.isSome, allowedEntities: allowed,
      dispensable: e.dispensable, swappable: e.swappable, damageOnHurt: e.damageOnHurt,
      equipOnInteract: e.equipOnInteract, canBeSheared: e.canBeSheared, shearingSound: toWireSound(e.shearingSound)))
  of dcPotionContents:
    let p = data.potionContents
    pdc.DataComponentValue(kind: dcvPotionContents, potionContents: pdc.PotionContentsImpl(
      potionId: p.potionId, customColor: p.customColor, customEffects: toWireEffects(p.customEffects),
      customName: p.customName))
  of dcFireworkExplosion:
    pdc.DataComponentValue(kind: dcvFireworkExplosion, fireworkExplosion: toWireFireworkExplosion(data.fireworkExplosion))
  of dcFireworks:
    var explosions: seq[pdc.FireworkExplosionImpl] = @[]
    for e in data.fireworks.explosions:
      explosions.add(toWireFireworkExplosion(e))
    pdc.DataComponentValue(kind: dcvFireworks, fireworks: pdc.FireworksImpl(
      flightDuration: data.fireworks.flightDuration, explosions: explosions))
  of dcMapId:
    pdc.DataComponentValue(kind: dcvMapId, mapId: pdc.MapIdImpl(id: data.mapId.id))
  of dcUseCooldown:
    pdc.DataComponentValue(kind: dcvUseCooldown, useCooldown: pdc.UseCooldownImpl(
      seconds: data.useCooldown.seconds, cooldownGroup: data.useCooldown.cooldownGroup))
  of dcBundleContents:
    var items: seq[pdc.ItemStack] = @[]
    for s in data.bundleContents.items:
      items.add(toWireStack(s))
    pdc.DataComponentValue(kind: dcvBundleContents, bundleContents: pdc.BundleContentsImpl(items: items))
  else:
    ok = false
    pdc.DataComponentValue(kind: dcvRemoved)

proc toWireStack*(stack: ds.ItemStack): pdc.ItemStack =
  ## The conversion half of `impl From<ItemStack> for ItemStackSerializer`.
  if stack.isEmpty():
    return pdc.emptyItemStack()
  var patch: seq[pdc.PatchEntry] = @[]
  for entry in stack.patch:
    if not entry.present:
      patch.add(pdc.PatchEntry(id: entry.id, data: pdc.DataComponentValue(kind: dcvRemoved)))
    else:
      var ok = false
      let value = toWireValue(entry.data, ok)
      if ok:
        patch.add(pdc.PatchEntry(id: entry.id, data: value))
  pdc.newItemStack(stack.itemCount, stack.item.id, patch)

proc toSerializer*(stack: ds.ItemStack): ItemStackSerializer =
  ItemStackSerializer(stack: toWireStack(stack))

proc fromWireEnchantments(list: seq[pdc.EnchantmentEntry]): seq[ds.EnchantmentEntry] =
  result = @[]
  for e in list:
    let index = int(e.id)
    if index < ds.gEnchantments.len:
      result.add(ds.EnchantmentEntry(enchantment: ds.gEnchantments[index], level: e.level))

proc fromWireFireworkExplosion(e: pdc.FireworkExplosionImpl): ds.FireworkExplosionImpl =
  ds.FireworkExplosionImpl(shape: ds.FireworkExplosionShape(ord(e.shape)), colors: e.colors,
    fadeColors: e.fadeColors, hasTrail: e.hasTrail, hasTwinkle: e.hasTwinkle)

proc fromWireSound(v: pp.IdOr[pp.SoundEvent]): ds.IdOr[ds.SoundEvent] =
  case v.kind
  of pp.iokId:
    if int(v.id) <= ord(high(soundtable.Sound)):
      ds.IdOr[ds.SoundEvent](kind: ds.iokId, id: soundtable.Sound(int(v.id)))
    else:
      ds.IdOr[ds.SoundEvent](kind: ds.iokId, id: low(soundtable.Sound))
  of pp.iokValue:
    ds.IdOr[ds.SoundEvent](kind: ds.iokValue, value: ds.SoundEvent(soundName: v.value.soundName, range: v.value.range))

proc fromWireIdSet(v: pdc.IDSet): ds.IDSet =
  case v.kind
  of pdc.idsTag: ds.IDSet(kind: ds.idsTag, tag: v.tag)
  of pdc.idsIds: ds.IDSet(kind: ds.idsIds, ids: v.ids)

proc fromWireEffects(list: seq[pdc.StatusEffectInstance]): seq[ds.StatusEffectInstance] =
  result = @[]
  for e in list:
    let known = fromMinecraftName(StatusEffect, e.effectId)
    if known.isSome:
      result.add(ds.StatusEffectInstance(effectId: known.unsafeGet.minecraftName, amplifier: e.amplifier,
        duration: e.duration, ambient: e.ambient, showParticles: e.showParticles, showIcon: e.showIcon))

proc fromWireConsumeEffect(e: pdc.ConsumeEffect): ds.ConsumeEffect =
  case e.kind
  of pdc.ceApplyEffects:
    ds.ConsumeEffect(kind: ds.ceApplyEffects, effects: fromWireEffects(e.effects), probability: e.probability)
  of pdc.ceRemoveEffects:
    ds.ConsumeEffect(kind: ds.ceRemoveEffects, removed: fromWireIdSet(e.removed))
  of pdc.ceClearAllEffects:
    ds.ConsumeEffect(kind: ds.ceClearAllEffects)
  of pdc.ceTeleportRandomly:
    ds.ConsumeEffect(kind: ds.ceTeleportRandomly, diameter: e.diameter)
  of pdc.cePlaySound:
    ds.ConsumeEffect(kind: ds.cePlaySound, sound: fromWireSound(e.sound))

proc fromWireStack*(stack: pdc.ItemStack): ds.ItemStack

proc fromWireValue(data: pdc.DataComponentValue; ok: var bool): ds.DataComponentImpl =
  ok = true
  case data.kind
  of dcvMaxStackSize: toDyn(ds.MaxStackSizeImpl(size: data.maxStackSize.size))
  of dcvDamage: toDyn(ds.DamageImpl(damage: data.damage.damage))
  of dcvEnchantments: toDyn(ds.EnchantmentsImpl(enchantment: fromWireEnchantments(data.enchantments.enchantment)))
  of dcvStoredEnchantments:
    toDyn(ds.StoredEnchantmentsImpl(enchantment: fromWireEnchantments(data.storedEnchantments.enchantment)))
  of dcvUnbreakable: toDyn(ds.UnbreakableImpl())
  of dcvItemModel: toDyn(ds.ItemModelImpl(id: data.itemModel.id))
  of dcvCustomName: toDyn(ds.CustomNameImpl(name: data.customName.name))
  of dcvCustomData: toDyn(ds.CustomDataImpl(data: data.customData.data))
  of dcvConsumable:
    var effects: seq[ds.ConsumeEffect] = @[]
    for e in data.consumable.effects:
      effects.add(fromWireConsumeEffect(e))
    toDyn(ds.ConsumableImpl(consumeSeconds: data.consumable.consumeSeconds,
      animation: ds.ConsumeAnimation(ord(data.consumable.animation)),
      soundEvent: fromWireSound(data.consumable.soundEvent), consumeParticles: data.consumable.consumeParticles,
      effects: effects))
  of dcvEquippable:
    let e = data.equippable
    var allowed = none[ds.IDSet]()
    if e.hasAllowedEntities:
      allowed = some(fromWireIdSet(e.allowedEntities))
    toDyn(ds.EquippableImpl(slot: ds.EquipmentSlot(ord(e.slot)), equipSound: fromWireSound(e.equipSound),
      assetId: e.assetId, cameraOverlay: e.cameraOverlay, allowedEntities: allowed, dispensable: e.dispensable,
      swappable: e.swappable, damageOnHurt: e.damageOnHurt, equipOnInteract: e.equipOnInteract,
      canBeSheared: e.canBeSheared, shearingSound: fromWireSound(e.shearingSound)))
  of dcvPotionContents:
    let p = data.potionContents
    toDyn(ds.PotionContentsImpl(potionId: p.potionId, customColor: p.customColor,
      customEffects: fromWireEffects(p.customEffects), customName: p.customName))
  of dcvFireworkExplosion: toDyn(fromWireFireworkExplosion(data.fireworkExplosion))
  of dcvFireworks:
    var explosions: seq[ds.FireworkExplosionImpl] = @[]
    for e in data.fireworks.explosions:
      explosions.add(fromWireFireworkExplosion(e))
    toDyn(ds.FireworksImpl(flightDuration: data.fireworks.flightDuration, explosions: explosions))
  of dcvMapId: toDyn(ds.MapIdImpl(id: data.mapId.id))
  of dcvUseCooldown:
    toDyn(ds.UseCooldownImpl(seconds: data.useCooldown.seconds, cooldownGroup: data.useCooldown.cooldownGroup))
  of dcvBundleContents:
    var items: seq[ds.ItemStack] = @[]
    for s in data.bundleContents.items:
      items.add(fromWireStack(s))
    toDyn(ds.BundleContentsImpl(items: items))
  of dcvRemoved:
    ok = false
    ds.DataComponentImpl(kind: dcUnbreakable)

proc fromWireStack*(stack: pdc.ItemStack): ds.ItemStack =
  ## A stack off the wire, as the game holds it. An unknown item id is air, `Item::from_id(id).unwrap_or(&AIR)`.
  let item = fromId(ds.Item, stack.itemId)
  if item == nil:
    return ds.emptyItemStack()
  var patch: seq[ds.PatchEntry] = @[]
  for entry in stack.patch:
    if entry.data.kind == dcvRemoved:
      patch.add(patchRemoved(entry.id))
    else:
      var ok = false
      let value = fromWireValue(entry.data, ok)
      if ok:
        patch.add(patchSet(value))
  ds.newItemStackWithComponent(stack.itemCount, item, patch)

proc fromSerializer*(s: ItemStackSerializer): ds.ItemStack =
  fromWireStack(s.stack)

proc hashEquals*(hash: OptionalItemStackHash; stack: ds.ItemStack): bool =
  ## `OptionalItemStackHash::hash_equals` on the game's stack.
  hashEquals(hash, toWireStack(stack))
