## stackbridge.aowl: the game's stack to the wire's and back, with the exact bytes of a `CSetContainerSlot`, and an
## `OptionalItemStackHash` compared with the game's stack.

import std/options
import invtestkit, stackbridge
import ../protocol/datacomponent as pdc
import ../protocol/itemstackserializer
import ../protocol/netcodec
import ../protocol/protobase
import ../protocol/varint
import ../protocol/java/client/play/set_container_slot
import ../protocol/java/client/play/playtestutil
import ../util/javaversion

const V = jmvV1_21_11

proc full(p: CSetContainerSlot): seq[byte] =
  var w = newNetWriter()
  writeJavaPacketId(w, toId(CSetContainerSlot, V))
  let written = writePacket(p, w, V)
  check(written.isOk, "packet writes")
  w.buf

block plainStack:
  let wire = toWireStack(stackOf(ITEM_STONE, 5))
  check(wire.itemCount == 5'u8 and wire.itemId == ITEM_STONE.id and wire.patch.len == 0, "plain stack")
  check(toWireStack(stackOf(ITEM_AIR, 0)).isEmpty(), "empty stays empty")
  check(toWireStack(stackOf(ITEM_STONE, 0)).isEmpty(), "a zero count is empty")

block exactBytes:
  let p = CSetContainerSlot(windowId: 2'i8, stateId: newVarInt(300'i32), slot: 258'i16,
    slotData: toSerializer(stackOf(ITEM_STONE, 5)))
  eqHex(full(p), "14 02 ac02 0102 05010000", "set_container_slot from the game's stack")
  let e = CSetContainerSlot(windowId: 2'i8, stateId: newVarInt(1'i32), slot: 0'i16,
    slotData: toSerializer(stackOf(ITEM_AIR, 0)))
  eqHex(full(e), "14 02 01 0000 00", "set_container_slot, empty")

block componentsRoundTrip:
  var s = stackOf(ITEM_DIAMOND_SWORD, 1)
  s.setCustomName("Sting")
  s.setDamage(3'i32)
  s.addEnchantment(gEnchantments[0], 2'u16)
  s.patch.add(patchRemoved(dcFood))
  let wire = toWireStack(s)
  check(wire.patch.len == s.patch.len, "every component carried")
  let back = fromWireStack(wire)
  check(back.itemCount == 1'u8 and back.item.id == ITEM_DIAMOND_SWORD.id, "item comes back as the real one")
  check(back.areItemsAndComponentsEqual(s), "components equal after the round trip")
  check(back.getDamage() == 3'i32, "damage")
  check(back.hasEnchantments(), "enchantments")

block aComponentTheCodecLacksIsLeftOut:
  var s = stackOf(ITEM_STONE, 1)
  s.patch.add(patchSet(toDyn(MaxDamageImpl(maxDamage: 10'i32))))
  check(toWireStack(s).patch.len == 0, "max_damage has no codec case")

block unknownItemIdOffTheWire:
  check(fromWireStack(pdc.newItemStack(1'u8, 65535'u16, newSeq[pdc.PatchEntry]())).isEmpty(), "unknown id is empty")

block hash:
  let empty = OptionalItemStackHash(value: none[ItemStackHash]())
  check(hashEquals(empty, stackOf(ITEM_AIR, 0)), "no hash matches an empty stack")
  check(not hashEquals(empty, stackOf(ITEM_STONE, 1)), "no hash does not match a stack")

echo "stackbridge: OK"
