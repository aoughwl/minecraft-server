## Port of pumpkin-inventory/src/stonecutter_screen_handler.rs
##
## Upstream's two `SimpleInventory`s are `ArrayInventory`. As upstream, nothing here sets `selectedRecipe` (no
## `on_button_click`), and the player range in `quick_move` is the literal 2..38.

import std/options
import "../data/item_stack/mod"
import ../generated/recipes
import ../generated/screen
import ../generated/statistic
import inventory, recipe_provider, screenhandler, slot

type
  StonecutterScreenHandler* = ref object of ScreenHandler
    inputInventory*: ArrayInventory
    outputInventory*: ArrayInventory
    selectedRecipe*: uint8

  StonecutterOutputSlot* = ref object of Slot
    inputInventory*: Inventory

proc getAvailableRecipes*(input: ItemStack): seq[int] =
  ## The indices into `RECIPES_STONECUTTING`.
  result = @[]
  for i in 0 ..< RECIPES_STONECUTTING.len:
    if RECIPES_STONECUTTING[i].ingredient.matchItem(input.item):
      result.add(i)

proc updateOutput(self: StonecutterScreenHandler) =
  let inputStack = Inventory(self.inputInventory).getStack(0)

  if inputStack.isEmpty():
    Inventory(self.outputInventory).setStack(0, emptyItemStack())
    self.selectedRecipe = 255'u8
    return

  let availableRecipes = getAvailableRecipes(inputStack)
  let recipeIndex = self.selectedRecipe

  if recipeIndex != 255'u8 and int(recipeIndex) < availableRecipes.len:
    let recipe = RECIPES_STONECUTTING[availableRecipes[int(recipeIndex)]]
    Inventory(self.outputInventory).setStack(0, fromRecipeResult(recipe.result.id, recipe.result.count))
  else:
    Inventory(self.outputInventory).setStack(0, emptyItemStack())

proc stonecutterOnSlotClick(self: ScreenHandler; slotIndex, button: int32; actionType: SlotActionType;
    player: InventoryPlayer) =
  self.internalOnSlotClick(slotIndex, button, actionType, player)
  if slotIndex == 0'i32:
    StonecutterScreenHandler(self).updateOutput()

proc stonecutterQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  var stack = emptyItemStack()
  if int(slotIndex) < self.behaviour.slots.len:
    let s = self.behaviour.slots[int(slotIndex)]
    var slotStack = s.getClonedStack()
    if not slotStack.isEmpty():
      stack = slotStack
      if slotIndex < 2'i32:
        # From Stonecutter to Player
        if not self.insertItem(slotStack, 2'i32, 38'i32, true):
          return emptyItemStack()
        s.onQuickMoveCrafted(slotStack, stack)
      else:
        # From Player to Stonecutter. Try input slot (0)
        if not self.insertItem(slotStack, 0'i32, 1'i32, false):
          return emptyItemStack()

      if slotStack.isEmpty():
        s.setStack(emptyItemStack())
      else:
        s.setStack(slotStack)
  stack

proc outputOnTakeItem(self: Slot; player: InventoryPlayer; stack: ItemStack) =
  player.incrementStat(scCrafted, int32(stack.item.id), int32(stack.itemCount))
  let output = StonecutterOutputSlot(self)
  let inputInventory = output.inputInventory
  var inputStack = inputInventory.getStack(0)
  if not inputStack.isEmpty():
    inputStack.itemCount -= 1'u8
    if inputStack.itemCount == 0'u8:
      inputStack = emptyItemStack()
    inputInventory.storeStack(0, inputStack)
  self.markDirty()

proc outputCanInsert(self: Slot; stack: ItemStack): bool = false

proc outputSetStack(self: Slot; stack: ItemStack) =
  self.inventory.setStack(self.index, stack)

proc outputSetStackPrev(self: Slot; stack, previousStack: ItemStack) =
  discard  # Do nothing

proc newStonecutterOutputSlot*(inventory, inputInventory: Inventory; index: int): StonecutterOutputSlot =
  result = StonecutterOutputSlot(inventory: inventory, index: index, id: 0'u8, inputInventory: inputInventory)
  result.onTakeItemImpl = outputOnTakeItem
  result.canInsertImpl = outputCanInsert
  result.setStackImpl = outputSetStack
  result.setStackPrevImpl = outputSetStackPrev

proc newStonecutterScreenHandler*(syncId: uint8; playerInventory: PlayerInventory): StonecutterScreenHandler =
  let inputInventory = newArrayInventory(1)
  let outputInventory = newArrayInventory(1)
  result = StonecutterScreenHandler(behaviour: newScreenHandlerBehaviour(syncId, some(wtStonecutter)),
    inputInventory: inputInventory, outputInventory: outputInventory, selectedRecipe: 255'u8)
  result.quickMoveImpl = stonecutterQuickMove
  result.onSlotClickImpl = stonecutterOnSlotClick

  ScreenHandler(result).addSlot(newNormalSlot(inputInventory, 0))
  ScreenHandler(result).addSlot(newStonecutterOutputSlot(outputInventory, inputInventory, 0))
  ScreenHandler(result).addPlayerSlots(playerInventory)
