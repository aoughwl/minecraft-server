## stonecutter_screen_handler.rs: as upstream, no click selects a recipe; the test sets `selectedRecipe`.

import invtestkit, inventory, screenhandler, slot, stonecutter_screen_handler
import ../generated/statistic

block stonecutter:
  let p = newTestPlayer()
  let h = newStonecutterScreenHandler(1'u8, p.inventory)
  check(h.behaviour.slots.len == 38, "slots")
  check(h.selectedRecipe == 255'u8, "nothing selected")
  check(not h.behaviour.slots[1].canInsert(stackOf(ITEM_STONE, 1)), "nothing into the output")

  # Placing stone with no recipe selected gives nothing.
  h.behaviour.cursorStack = stackOf(ITEM_STONE, 3)
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satPickup, p)
  checkStack(Inventory(h.inputInventory).getStack(0), ITEM_STONE, 3, "input")
  check(Inventory(h.outputInventory).getStack(0).isEmpty(), "no recipe, no output")

  let available = getAvailableRecipes(stackOf(ITEM_STONE, 1))
  check(available.len > 0, "stone has recipes")

  h.selectedRecipe = 0'u8
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satClone, p)  # Any click on slot 0 refreshes; clone changes nothing here.
  let output = Inventory(h.outputInventory).getStack(0)
  check(not output.isEmpty(), "selected recipe gives output")

  # Taking the output spends one input.
  let produced = output.item
  let count = int(output.itemCount)
  ScreenHandler(h).onSlotClick(1'i32, 0'i32, satPickup, p)
  checkStack(h.behaviour.cursorStack, produced, count, "taken")
  checkStack(Inventory(h.inputInventory).getStack(0), ITEM_STONE, 2, "one input spent")
  check(p.stats.len == 1 and p.stats[0].category == scCrafted, "crafted stat")

  # An emptied input clears the selection.
  Inventory(h.inputInventory).setStack(0, emptyItemStack())
  ScreenHandler(h).onSlotClick(0'i32, 0'i32, satClone, p)
  check(h.selectedRecipe == 255'u8, "selection cleared")
  check(Inventory(h.outputInventory).getStack(0).isEmpty(), "output cleared")

  # From the player to the input (main 9 is handler slot 2).
  h.behaviour.cursorStack = emptyItemStack()
  p.setMain(9, stackOf(ITEM_STONE, 4))
  ScreenHandler(h).onSlotClick(2'i32, 0'i32, satQuickMove, p)
  checkStack(Inventory(h.inputInventory).getStack(0), ITEM_STONE, 4, "player to the input")

echo "stonecutter_screen_handler: OK"
