## Port of pumpkin-inventory/src/sync_handler.rs
##
## Upstream's methods take `screen_handler: &ScreenHandlerBehaviour` and use only its `sync_id`. Here they take
## the id: `ScreenHandlerBehaviour` holds the `SyncHandler`, so it is declared after this module.

import std/options
import "../data/item_stack/mod"
import ../protocol/varint
import ../protocol/itemstackserializer
import ../protocol/java/client/play/set_container_content
import ../protocol/java/client/play/set_container_property
import ../protocol/java/client/play/set_container_slot
import ../protocol/java/client/play/set_cursor_slot
import player_inventory, stackbridge

type
  SyncHandler* = ref object
    ## nil until `storePlayer` attaches one.
    player: nil InventoryPlayer

  TrackedStack* = object
    ## The last known state of a slot, as the full stack or as the hash the client sent.
    receivedStack*: Option[ItemStack]
    receivedHash*: Option[OptionalItemStackHash]

proc newSyncHandler*(): SyncHandler =
  SyncHandler(player: nil)

proc storePlayer*(self: SyncHandler; player: InventoryPlayer) =
  self.player = player

proc updateState*(self: SyncHandler; syncId: uint8; stacks: seq[ItemStack]; cursorStack: ItemStack;
    properties: seq[int32]; nextRevision: uint32) =
  ## A full container update: all slots, the cursor item and the properties.
  let player = self.player
  if player != nil:
    var slotData: seq[ItemStackSerializer] = @[]
    for i in 0 ..< stacks.len:
      slotData.add(toSerializer(stacks[i]))
    player.enqueueInventoryPacket(CSetContainerContent(windowId: newVarInt(int32(syncId)),
      stateId: newVarInt(int32(nextRevision)), slotData: slotData, carriedItem: toSerializer(cursorStack)))
    for i in 0 ..< properties.len:
      player.enqueuePropertyPacket(CSetContainerProperty(windowId: newVarInt(int32(syncId)), property: int16(i),
        value: cast[int16](uint16(cast[uint32](properties[i]) and 0xFFFF'u32))))

proc updateSlot*(self: SyncHandler; syncId: uint8; slot: int; stack: ItemStack; nextRevision: uint32) =
  let player = self.player
  if player != nil:
    player.enqueueSlotPacket(CSetContainerSlot(windowId: cast[int8](syncId), stateId: newVarInt(int32(nextRevision)),
      slot: int16(slot), slotData: toSerializer(stack)))

proc updateCursorStack*(self: SyncHandler; stack: ItemStack) =
  let player = self.player
  if player != nil:
    player.enqueueCursorPacket(CSetCursorItem(stack: toSerializer(stack)))

proc updateProperty*(self: SyncHandler; syncId: uint8; property: int32; value: int32) =
  let player = self.player
  if player != nil:
    player.enqueuePropertyPacket(CSetContainerProperty(windowId: newVarInt(int32(syncId)),
      property: cast[int16](uint16(cast[uint32](property) and 0xFFFF'u32)),
      value: cast[int16](uint16(cast[uint32](value) and 0xFFFF'u32))))

proc emptyTrackedStack*(): TrackedStack =
  ## `TrackedStack::EMPTY`: no known state.
  TrackedStack(receivedStack: none[ItemStack](), receivedHash: none[OptionalItemStackHash]())

proc setReceivedStack*(self: var TrackedStack; stack: ItemStack) =
  self.receivedStack = some(stack)
  self.receivedHash = none[OptionalItemStackHash]()

proc setReceivedHash*(self: var TrackedStack; hash: OptionalItemStackHash) =
  self.receivedHash = some(hash)
  self.receivedStack = none[ItemStack]()

proc isInSync*(self: var TrackedStack; actualStack: ItemStack): bool =
  ## Whether the actual stack matches what is tracked. A matching hash becomes the stack.
  if self.receivedStack.isSome:
    return self.receivedStack.unsafeGet.areEqual(actualStack)
  elif self.receivedHash.isSome and hashEquals(self.receivedHash.unsafeGet, actualStack):
    self.receivedStack = some(actualStack)
    return true
  false
