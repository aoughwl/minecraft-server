## sync_handler.rs: the packets it builds, with no player attached and with one, and `TrackedStack`.

import std/options
import invtestkit, stackbridge, sync_handler
import ../protocol/itemstackserializer

block noPlayerNoPackets:
  let s = newSyncHandler()
  s.updateSlot(1'u8, 0, stackOf(ITEM_STONE, 1), 1'u32)
  s.updateCursorStack(stackOf(ITEM_STONE, 1))
  s.updateProperty(1'u8, 0'i32, 0'i32)
  s.updateState(1'u8, @[], emptyItemStack(), @[], 1'u32)

block packets:
  let p = newTestPlayer()
  let s = newSyncHandler()
  s.storePlayer(p)

  s.updateState(3'u8, @[stackOf(ITEM_STONE, 5), emptyItemStack()], stackOf(ITEM_DIRT, 2), @[7'i32, -1'i32, 70000'i32], 9'u32)
  check(p.contentPackets.len == 1, "content")
  let content = p.contentPackets[0]
  check(content.windowId.value == 3'i32 and content.stateId.value == 9'i32, "content ids")
  check(content.slotData.len == 2, "content slots")
  check(content.slotData[0].stack.itemId == ITEM_STONE.id and content.slotData[0].stack.itemCount == 5'u8, "content stone")
  check(content.slotData[1].stack.isEmpty(), "content empty")
  check(content.carriedItem.stack.itemId == ITEM_DIRT.id, "content cursor")
  check(p.propertyPackets.len == 3, "a property each")
  check(p.propertyPackets[0].property == 0'i16 and p.propertyPackets[0].value == 7'i16, "first property")
  check(p.propertyPackets[1].value == -1'i16, "negative")
  check(p.propertyPackets[2].value == 4464'i16, "`as i16` truncates 70000")

  s.updateSlot(255'u8, 300, stackOf(ITEM_STONE, 1), 12'u32)
  check(p.slotPackets[0].windowId == -1'i8, "`sync_id as i8`")
  check(p.slotPackets[0].slot == 300'i16 and p.slotPackets[0].stateId.value == 12'i32, "slot packet")

  s.updateCursorStack(stackOf(ITEM_DIRT, 3))
  check(p.cursorPackets[0].stack.stack.itemCount == 3'u8, "cursor packet")

  s.updateProperty(3'u8, 2'i32, 9'i32)
  check(p.propertyPackets[3].windowId.value == 3'i32 and p.propertyPackets[3].property == 2'i16 and
    p.propertyPackets[3].value == 9'i16, "property packet")

block trackedStack:
  var t = emptyTrackedStack()
  check(not t.isInSync(stackOf(ITEM_STONE, 1)), "nothing known is never in sync")
  t.setReceivedStack(stackOf(ITEM_STONE, 1))
  check(t.isInSync(stackOf(ITEM_STONE, 1)), "same stack")
  check(not t.isInSync(stackOf(ITEM_STONE, 2)), "another count")
  check(not t.isInSync(stackOf(ITEM_DIRT, 1)), "another item")

  # The empty hash matches an empty stack, and then the stack is what is tracked.
  t.setReceivedHash(OptionalItemStackHash(value: none[ItemStackHash]()))
  check(t.receivedStack.isNone, "a hash replaces the stack")
  check(not t.isInSync(stackOf(ITEM_STONE, 1)), "a hash that does not match")
  check(t.receivedStack.isNone, "and no stack is learned from it")
  check(t.isInSync(emptyItemStack()), "a hash that matches")
  check(t.receivedStack.isSome, "learns the stack")
  t.setReceivedStack(stackOf(ITEM_STONE, 1))
  check(t.receivedHash.isNone, "a stack replaces the hash")

echo "sync_handler: OK"
