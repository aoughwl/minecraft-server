## Port of pumpkin-world/src/block/viewer.rs
##
## aowlmony's `std/atomics` operates on a plain `var T` location. The fields are plain `uint16`, and every access
## goes through `atomicLoad`/`atomicFetchAdd`/`atomicFetchSub`. A `ref object` is the `Arc` it is shared by.

import std/atomics

type
  ViewerCountTracker* = ref object
    old*: uint16
    current*: uint16

proc newViewerCountTracker*(): ViewerCountTracker =
  ViewerCountTracker(old: 0'u16, current: 0'u16)

proc openContainer*(t: ViewerCountTracker) =
  discard atomicFetchAdd(t.current, 1'u16, moRelaxed)

proc closeContainer*(t: ViewerCountTracker) =
  discard atomicFetchSub(t.current, 1'u16, moRelaxed)

proc getViewerCount*(t: ViewerCountTracker): uint16 =
  atomicLoad(t.current, moRelaxed)
