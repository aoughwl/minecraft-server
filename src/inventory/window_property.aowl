## Port of pumpkin-inventory/src/window_property.rs
##
## Rust's generic `WindowProperty<T: WindowPropertyTrait>` is one `WindowProperty` holding the resolved `(id,
## value)`: `new` calls `toId` at once rather than at `into_tuple`. Only `EnchantmentTable` and `Anvil` implement
## the trait upstream, so only they have a `toId`.
##
## `PropertyDelegate` and `ExperienceContainer` are from pumpkin-world/src/block/entities.rs: the fields take the
## object as `self`, so an implementor subclasses and needs no closure over itself.

type
  Furnace* = enum
    fpFireIcon
    fpMaximumFuelBurnTime
    fpProgressArrow
    fpMaximumProgress

  EnchantmentTableKind* = enum
    etkLevelRequirement
    etkEnchantmentSeed
    etkEnchantmentId
    etkEnchantmentLevel

  EnchantmentTable* = object
    case kind*: EnchantmentTableKind
    of etkLevelRequirement: levelReqSlot*: uint8
    of etkEnchantmentSeed: discard
    of etkEnchantmentId: enchantIdSlot*: uint8
    of etkEnchantmentLevel: enchantLevelSlot*: uint8

  Beacon* = enum
    bkPowerLevel
    bkFirstPotionEffect
    bkSecondPotionEffect

  Anvil* = enum
    akRepairCost

  BrewingStand* = enum
    bskBrewTime
    bskFuelTime

  Stonecutter* = enum
    skSelectedRecipe

  Loom* = enum
    lkSelectedPattern

  Lectern* = enum
    lekPageNumber

  WindowProperty* = object
    id*: int16
    value*: int16

proc toId*(p: EnchantmentTable): int16 =
  ## TODO upstream: "No more magic numbers".
  case p.kind
  of etkLevelRequirement: int16(p.levelReqSlot)
  of etkEnchantmentSeed: 3'i16
  of etkEnchantmentId: 4'i16 + int16(p.enchantIdSlot)
  of etkEnchantmentLevel: 7'i16 + int16(p.enchantLevelSlot)

proc toId*(p: Anvil): int16 =
  case p
  of akRepairCost: 0'i16

proc newWindowProperty*(p: EnchantmentTable; value: int16): WindowProperty =
  WindowProperty(id: toId(p), value: value)

proc newWindowProperty*(p: Anvil; value: int16): WindowProperty =
  WindowProperty(id: toId(p), value: value)

proc intoTuple*(w: WindowProperty): (int16, int16) =
  (w.id, w.value)

type
  PropertyDelegate* = ref object of RootObj
    ## The `PropertyDelegate: Sync + Send` trait.
    getPropertyImpl*: proc(self: PropertyDelegate; index: int32): int32 {.closure.}
    setPropertyImpl*: proc(self: PropertyDelegate; index: int32; value: int32) {.closure.}
    getPropertiesSizeImpl*: proc(self: PropertyDelegate): int32 {.closure.}

proc getProperty*(d: PropertyDelegate; index: int32): int32 =
  let f = d.getPropertyImpl
  f(d, index)

proc setProperty*(d: PropertyDelegate; index: int32; value: int32) =
  let f = d.setPropertyImpl
  f(d, index, value)

proc getPropertiesSize*(d: PropertyDelegate): int32 =
  let f = d.getPropertiesSizeImpl
  f(d)

type
  ExperienceContainer* = ref object of RootObj
    ## The `ExperienceContainer: Send + Sync` trait.
    extractExperienceImpl*: proc(self: ExperienceContainer): int32 {.closure.}

proc extractExperience*(c: ExperienceContainer): int32 =
  let f = c.extractExperienceImpl
  f(c)
