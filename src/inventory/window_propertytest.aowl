## window_property.rs: the property ids.

import invtestkit, window_property

check(toId(EnchantmentTable(kind: etkLevelRequirement, levelReqSlot: 2'u8)) == 2'i16, "level requirement")
check(toId(EnchantmentTable(kind: etkEnchantmentSeed)) == 3'i16, "seed")
check(toId(EnchantmentTable(kind: etkEnchantmentId, enchantIdSlot: 1'u8)) == 5'i16, "enchantment id")
check(toId(EnchantmentTable(kind: etkEnchantmentLevel, enchantLevelSlot: 2'u8)) == 9'i16, "enchantment level")
check(toId(akRepairCost) == 0'i16, "repair cost")

let t = intoTuple(newWindowProperty(akRepairCost, 7'i16))
check(t[0] == 0'i16 and t[1] == 7'i16, "into tuple")

echo "window_property: OK"
