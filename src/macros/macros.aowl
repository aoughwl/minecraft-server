## Port of pumpkin-macros/src/lib.rs
## PARTIAL: pumpkin-macros/src/lib.rs - upstream is a proc-macro crate (syn/quote token rewriting at compile time). What aowlmony can say with plain procs and templates is here: `sendCancellable*` (generic procs over closures, the `after`/`cancelled` branching of `send_cancellable!`), the name rules of `pumpkin_block` (`minecraft:` strip + SHOUTY_SNAKE constant name), and the `cancelled` field contract. Not expressible: `#[derive(Event)]` and `#[cancellable]` (inject trait impls and a struct field - each event type declares `cancelled` and its name by hand), `#[packet]`/`#[java_packet]` (a packet declares its `packetId` const by hand), `pumpkin_block`/`pumpkin_block_from_tag` (resolve block names and tags against generated data at compile time; here a runtime lookup into src/generated), `#[derive(PacketWrite/PacketRead)]` (the packet types in src/protocol hand-write their codecs), and the compile-time key checks.

type
  CancellableBase* = object
    cancelled*: bool

proc stripMinecraftPrefix*(name: string): string =
  ## `pumpkin_block`: `arg_value.strip_prefix("minecraft:").unwrap_or(&arg_value)`.
  if name.len >= 10 and name[0 ..< 10] == "minecraft:": name[10 ..< name.len] else: name

proc toShoutySnakeCase*(name: string): string =
  ## heck's `ToShoutySnakeCase` for block names (`oak_planks`, `NoteBlock`): a word break at `_`, `-`, ` `,
  ## and at a lower-to-upper step; every letter upper case.
  result = ""
  var prevLower = false
  for c in name:
    if c == '_' or c == '-' or c == ' ':
      if result.len > 0 and result[result.len - 1] != '_': result.add '_'
      prevLower = false
    elif c >= 'A' and c <= 'Z':
      if prevLower: result.add '_'
      result.add c
      prevLower = false
    elif c >= 'a' and c <= 'z':
      result.add char(ord(c) - 32)
      prevLower = true
    else:
      result.add c
      prevLower = false

proc blockConstName*(arg: string): string =
  ## The constant `pumpkin_block` resolves for `arg`.
  toShoutySnakeCase(stripMinecraftPrefix(arg))

proc sendCancellable*(wasCancelled: bool, afterBlock: proc (), cancelledBlock: proc ()) =
  ## `send_cancellable!` with both blocks: `let event = server.plugin_manager.fire(event); if !event.cancelled { after } else { cancelled }`.
  ## `wasCancelled` is `server.pluginManager.fire(event).cancelled`, read once (the event type has no common base here).
  if not wasCancelled:
    afterBlock()
  else:
    cancelledBlock()

proc sendCancellableAfter*(wasCancelled: bool, afterBlock: proc ()) =
  ## `send_cancellable!` with only an `after` block.
  if not wasCancelled:
    afterBlock()

proc sendCancellableCancelled*(wasCancelled: bool, cancelledBlock: proc ()) =
  ## `send_cancellable!` with only a `cancelled` block.
  if wasCancelled:
    cancelledBlock()
