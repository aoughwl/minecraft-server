import std/[syncio, strutils]
import macros

type Ev = ref object
  cancelled: bool
  n: int

proc fireOk(e: Ev): Ev = e
proc fireCancel(e: Ev): Ev =
  e.cancelled = true
  e

var failures = 0
proc check(ok: bool, what: string) =
  if not ok:
    echo "FAIL: ", what
    failures += 1

check stripMinecraftPrefix("minecraft:stone") == "stone", "strip"
check stripMinecraftPrefix("stone") == "stone", "strip none"
check toShoutySnakeCase("oak_planks") == "OAK_PLANKS", "shouty"
check toShoutySnakeCase("NoteBlock") == "NOTE_BLOCK", "camel"
check blockConstName("minecraft:iron_ore") == "IRON_ORE", "const name"

var log = ""
proc addAfter() = log.add "after"
proc addCancelled() = log.add "cancelled"
proc addA() = log.add "A"
proc addC() = log.add "|C"
proc addX() = log.add "X"
proc addBang() = log.add "!"
sendCancellable(fireOk(Ev(n: 1)).cancelled, addAfter, addCancelled)
check log == "after", "after branch"
sendCancellable(fireCancel(Ev(n: 2)).cancelled, addA, addC)
check log == "after|C", "cancelled branch"
sendCancellableAfter(fireCancel(Ev(n: 3)).cancelled, addX)
check log == "after|C", "no after when cancelled"
sendCancellableCancelled(fireCancel(Ev(n: 4)).cancelled, addBang)
check log == "after|C!", "cancelled only"
if failures > 0: quit 1
echo "ok"
