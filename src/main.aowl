## Port of pumpkin/src/main.rs
## PARTIAL: pumpkin/src/main.rs - reads a world folder and a port from the command line rather than configuration files, and has no console, logger or crash handler. A console interrupt saves and stops, as upstream's `STOP_INTERRUPT` does.
##
## The server's network-transport entrypoint. Everything it does is in src/server/pumpkinlib.aowl and what that
## drives; src/server/servercore.aowl stays the seam for an in-process host.
##
##     main --world:<save folder> [--port:<port>] [--encryption] [--online] [--max-seconds:<n>]
##
## Offline mode by default. `--encryption` turns the login's cipher on, offline. `--online` asks for Mojang's check, which
## is a clean refusal for now (src/server/net/java/login.aowl). `--max-seconds` saves and stops after that long, for tests.

import std/[os, syncio]
import server/net/winsock
import config/lib as configlib
import server/[serverbase, servermod, pumpkinlib]

const DefaultPort = 25565'u16

proc parsePort(s: string): (bool, uint16) =
  var n = 0
  if s.len == 0:
    return (false, 0'u16)
  for c in s:
    if c < '0' or c > '9':
      return (false, 0'u16)
    n = n * 10 + (ord(c) - ord('0'))
    if n > 65535:
      return (false, 0'u16)
  (true, uint16(n))

proc startsWith(s, prefix: string): bool =
  s.len >= prefix.len and s[0 ..< prefix.len] == prefix

proc runMain(): int =
  var world = "world"
  var port = DefaultPort
  var encryption = false
  var online = false
  var maxSeconds = 0
  for i in 1 .. paramCount():
    let arg = paramStr(i)
    if startsWith(arg, "--world:"):
      world = arg[8 ..< arg.len]
    elif startsWith(arg, "--port:"):
      let (ok, p) = parsePort(arg[7 ..< arg.len])
      if not ok:
        echo "FATAL: bad port ", arg
        return 1
      port = p
    elif arg == "--encryption":
      encryption = true
    elif arg == "--online":
      online = true
      encryption = true
    elif startsWith(arg, "--max-seconds:"):
      let (ok, seconds) = parsePort(arg[14 ..< arg.len])
      if not ok:
        echo "FATAL: bad duration ", arg
        return 1
      maxSeconds = int(seconds)
    else:
      echo "FATAL: unknown argument ", arg
      return 1

  let basic = defaultBasicConfiguration()
  var advanced = defaultAdvancedConfiguration()
  advanced.networking.java.onlineMode = online
  advanced.networking.java.encryption = encryption

  let loaded = loadServer(basic, advanced, world)
  let server = loaded.server
  if server == nil:
    echo "FATAL: ", loaded.error
    return 1
  if maxSeconds > 0:
    server.stopAtMs = nowMs() + int64(maxSeconds) * 1000'i64
  installStopHandler(server)
  if not serverLoop(server, port):
    return 1
  0

when isMainModule:
  quit(runMain())
