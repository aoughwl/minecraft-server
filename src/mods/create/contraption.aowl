## Rotating contraption: pure geometry for a block body that is TURNED BY A MACHINE (a mechanical bearing) instead of by gravity,
## and for the riders that stand on it. NO world, NO entity imports: the body is the plain `Body` of physics/body.aowl.
##
## KINEMATIC BODY. The pose is a function of the driver's angle, not of forces: each tick `spinBody` turns the body by `ang` radians
## about the axis through `pivot` (right hand rule). The body's velocity fields are kept CONSISTENT with that motion so everything
## that already reads them (the collision provider's surface velocity, the Jester STATE stream, mobs that bump the body) is right:
##     angVel = axis * ang                         (rad per tick, world frame)
##     vel    = angVel x (centreOfMass - pivot)    (blocks per tick, velocity of the centre of mass)
## so that  vel + angVel x (p - centreOfMass) = angVel x (p - pivot)  for every point p of the body (the surface velocity formula).
##
## RIDERS. `standsOn` asks whether a point (an entity's feet) rests on the body's top surface at its CURRENT pose; `carryPoint` is where
## the rider is after the body turns by `ang`: the same rotation about the same pivot, EXACT (a tangent step v*dt would let the rider
## drift outwards by 0.1 % per tick). The caller carries riders BEFORE turning the body (the standing test uses the pose the rider
## stands on). For a vertical axis the rider also turns: `yawDeltaDeg`.

import std/[math]
import ../../physics/[body, integrator]

const
  StandTol* = 0.05                     ## how far the feet may sit above the surface and still count as standing on it

proc unitAxis*(axis: int; positive: bool = true): Vec3 =
  let s = (if positive: 1.0 else: -1.0)
  if axis == 0: Vec3(x: s, y: 0.0, z: 0.0)
  elif axis == 1: Vec3(x: 0.0, y: s, z: 0.0)
  else: Vec3(x: 0.0, y: 0.0, z: s)

proc quatAxisAngle*(axis: Vec3; ang: float64): Quat =
  let h = 0.5 * ang
  let s = sin(h)
  Quat(w: cos(h), x: axis.x * s, y: axis.y * s, z: axis.z * s)

proc rotateAbout*(p, pivot, axis: Vec3; ang: float64): Vec3 =
  ## p turned by `ang` (right hand rule) about the line through `pivot` along the unit vector `axis`.
  pivot + rotate(quatAxisAngle(axis, ang), p - pivot)

proc spinBody*(b: Body; pivot, axis: Vec3; ang: float64) =
  ## One tick of a kinematic rotation; see the header. The body is never put to sleep by this.
  let dq = quatAxisAngle(axis, ang)
  b.pos = pivot + rotate(dq, b.pos - pivot)
  b.orient = qnormalize(qmul(dq, b.orient))
  b.angVel = scale(axis, ang)
  b.vel = cross(b.angVel, comWorld(b) - pivot)
  b.sleeping = false
  b.sleepTicks = 0

proc stopBody*(b: Body) =
  b.angVel = Vec3()
  b.vel = Vec3()

proc surfaceVelocity*(b: Body; p: Vec3): Vec3 =
  ## v + omega x (p - centre of mass): the formula `bodyentity.surfaceVelocityAt` and the collision provider use.
  b.vel + cross(b.angVel, p - comWorld(b))

proc toLocal*(b: Body; p: Vec3): Vec3 =
  ## World point to body-local coordinates (inverse rotation: the conjugate quaternion).
  rotate(Quat(w: b.orient.w, x: -b.orient.x, y: -b.orient.y, z: -b.orient.z), p - b.pos)

proc cellIsSolid(b: Body; q: Vec3): bool =
  getCell(b, int(floor(q.x)), int(floor(q.y)), int(floor(q.z))) != 0

proc standsOn*(b: Body; feet: Vec3): bool =
  ## True when `feet` rests on a top surface of the body: the point just below (along the body's own "up", i.e. the world up expressed
  ## in the body frame) is inside a solid cell and the point just above is not, within `StandTol`. Exact for bodies turned about a
  ## vertical axis; a tilted body is treated by the same local test (the surface below the feet, whatever its slope, as long as the
  ## cell boundary is within the tolerance).
  let q = toLocal(b, feet)
  let up = rotate(Quat(w: b.orient.w, x: -b.orient.x, y: -b.orient.y, z: -b.orient.z), Vec3(x: 0.0, y: 1.0, z: 0.0))
  let below = q - scale(up, StandTol)
  let above = q + scale(up, 0.01)
  cellIsSolid(b, below) and not cellIsSolid(b, above)

proc carryPoint*(p, pivot, axis: Vec3; ang: float64): Vec3 =
  rotateAbout(p, pivot, axis, ang)

proc yawDeltaDeg*(axis: Vec3; ang: float64): float64 =
  ## How much an entity's Minecraft yaw changes when the platform turns by `ang` about `axis`: only the vertical component of the
  ## axis turns it. Minecraft yaw grows CLOCKWISE seen from above (south 0, west 90), the right hand rule about +y is counter
  ## clockwise, hence the minus.
  -axis.y * ang * 180.0 / PI
