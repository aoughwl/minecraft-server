## contraption.aowl: a 5x1x5 platform turned by a kinematic spin: exact poses, consistent velocities, riders carried and non-riders left alone.
## Hand-computed references: 8 rpm = 8 * 2 pi / 1200 = 0.0418879 rad per tick; 75 ticks = half a turn, 150 ticks = one turn.
import std/[syncio, math]
import ../../physics/[body, bodymass, integrator]
import kinetic
import contraption

var failures = 0
var checks = 0

proc check(name: string; cond: bool) =
  inc checks
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

proc near(a, b: float64; eps: float64 = 1e-9): bool = abs(a - b) <= eps

proc v3(x, y, z: float64): Vec3 = Vec3(x: x, y: y, z: z)

proc platform(): Body =
  ## cells x 0..4, y 0, z 0..4; local origin at world (10, 64, 10); the top surface is at y = 65
  let b = newBody(1'u64, 2'u64)
  for x in 0 .. 4:
    for z in 0 .. 4:
      setCell(b, x, 0, z, 1)
  recomputeMass(b, defaultProps)
  b.pos = v3(10.0, 64.0, 10.0)
  b

let up = unitAxis(1)
let pivot = v3(12.5, 64.5, 12.5)               # the centre of the platform
let step = rpmToRadPerTick(8.0)

check("8 rpm is 0.0418879 rad per tick", near(step, 0.04188790204786391))

# ---- 1. pose after half a turn and after a full turn
block poses:
  let b = platform()
  check("centre of mass is the pivot (12.5, 64.5, 12.5)", near(comWorld(b).x, 12.5) and near(comWorld(b).y, 64.5) and near(comWorld(b).z, 12.5))
  for i in 0 ..< 75:
    spinBody(b, pivot, up, step)
  # local cell (4,0,2) centre (4.5,0.5,2.5) starts at world (14.5,64.5,12.5), radius 2 on +x; half a turn puts it at (10.5, 64.5, 12.5)
  let w = b.pos + rotate(b.orient, v3(4.5, 0.5, 2.5))
  check("half a turn: the cell that was at +x is at -x (10.5, 64.5, 12.5)", near(w.x, 10.5, 1e-9) and near(w.y, 64.5, 1e-9) and near(w.z, 12.5, 1e-9))
  for i in 0 ..< 75:
    spinBody(b, pivot, up, step)
  let w2 = b.pos + rotate(b.orient, v3(4.5, 0.5, 2.5))
  check("a full turn: back at (14.5, 64.5, 12.5)", near(w2.x, 14.5, 1e-9) and near(w2.y, 64.5, 1e-9) and near(w2.z, 12.5, 1e-9))
  check("a full turn: the orientation is the identity (up to sign)", near(abs(b.orient.w), 1.0, 1e-9))
  check("the orientation stays a unit quaternion", near(b.orient.w * b.orient.w + b.orient.x * b.orient.x + b.orient.y * b.orient.y + b.orient.z * b.orient.z, 1.0, 1e-12))

# ---- 2. right hand rule: a quarter turn about +y takes +x to -z
block hand:
  let p = rotateAbout(v3(14.5, 65.0, 12.5), pivot, up, PI / 2.0)
  check("right hand rule: a quarter turn about +y takes +x to -z", near(p.x, 12.5, 1e-12) and near(p.z, 10.5, 1e-12) and near(p.y, 65.0, 1e-12))
  check("yaw delta: counter clockwise seen from above is a NEGATIVE Minecraft yaw change (-90 degrees)", near(yawDeltaDeg(up, PI / 2.0), -90.0, 1e-9))
  check("a horizontal axis does not turn an entity's yaw", near(yawDeltaDeg(unitAxis(0), PI / 2.0), 0.0, 1e-12))

# ---- 3. velocity consistency (centre pivot and off-centre pivot)
block velocity:
  let b = platform()
  spinBody(b, pivot, up, step)
  check("pivot at the centre: the centre of mass does not move", near(b.vel.x, 0.0, 1e-12) and near(b.vel.z, 0.0, 1e-12))
  check("angular velocity is axis * step", near(b.angVel.y, step, 1e-15) and near(b.angVel.x, 0.0, 1e-15))
  let p = v3(14.5, 65.0, 12.5)
  let sv = surfaceVelocity(b, p)
  # omega x (p - pivot): the point at +x of the pivot (r = 2) moves with speed 2 * step toward -z
  check("surface velocity at r = 2 is 2 * step toward -z", near(sv.z, -2.0 * step, 1e-5) and near(sv.x, 0.0, 1e-5))
  # off centre pivot: a corner of the platform
  let c = platform()
  let corner = v3(10.0, 64.0, 10.0)
  spinBody(c, corner, up, step)
  let probe = v3(13.0, 65.0, 11.0)
  let want = cross(c.angVel, probe - corner)
  let got = surfaceVelocity(c, probe)
  check("off centre pivot: velocity field equals omega x (p - pivot)", near(got.x, want.x, 1e-12) and near(got.y, want.y, 1e-12) and near(got.z, want.z, 1e-12))
  check("off centre pivot: the centre of mass orbits (velocity is not 0)", abs(c.vel.x) + abs(c.vel.z) > 0.05)

# ---- 4. riders
block riders:
  let b = platform()
  var onTop = v3(14.5, 65.0, 12.5)             # standing at the +x side, radius 2
  var rider2 = v3(12.5, 65.0, 14.0)            # standing at +z side
  var hover = v3(14.5, 66.5, 12.5)             # 1.5 above the surface: not standing
  var beside = v3(16.5, 65.0, 12.5)            # beside the platform (cell x=6 is empty)
  var control = onTop                          # never carried: the check below proves the carry matters
  check("standing: feet on the top surface", standsOn(b, onTop) and standsOn(b, rider2))
  check("not standing: hovering 1.5 above", not standsOn(b, hover))
  check("not standing: beside the platform", not standsOn(b, beside))
  var carried = 0
  for i in 0 ..< 75:
    let a = standsOn(b, onTop)
    let a2 = standsOn(b, rider2)
    if a:
      onTop = carryPoint(onTop, pivot, up, step)
      inc carried
    if a2:
      rider2 = carryPoint(rider2, pivot, up, step)
    spinBody(b, pivot, up, step)
  check("rider carried on every tick", carried == 75)
  check("half a turn: the rider at +x is at -x (10.5, 65.0, 12.5)", near(onTop.x, 10.5, 1e-9) and near(onTop.y, 65.0, 1e-12) and near(onTop.z, 12.5, 1e-9))
  check("half a turn: the second rider (0, +1.5) is at (0, -1.5) = (12.5, 65.0, 11.0)", near(rider2.x, 12.5, 1e-9) and near(rider2.z, 11.0, 1e-9))
  check("the radius never changes (exact rotation, no drift): 2.0", near(sqrt((onTop.x - 12.5) * (onTop.x - 12.5) + (onTop.z - 12.5) * (onTop.z - 12.5)), 2.0, 1e-9))
  check("the carried rider still stands on the turned platform", standsOn(b, onTop))
  check("control rider that was not carried stayed behind at x = 14.5", near(control.x, 14.5, 1e-12))
  check("the control rider is NOT where the carried one is", abs(control.x - onTop.x) > 3.9)
  check("the not-standing riders stay put (hovering, beside)", near(hover.x, 14.5, 1e-12) and near(beside.x, 16.5, 1e-12))
  # a rider carried by 75 steps of a turned platform lands at the position of the platform cell it stood on
  let local = toLocal(b, onTop)
  check("in the body frame the rider did not move: (4.5, 1.0, 2.5)", near(local.x, 4.5, 1e-9) and near(local.y, 1.0, 1e-9) and near(local.z, 2.5, 1e-9))
  # opposite direction
  let d = platform()
  var r3 = v3(14.5, 65.0, 12.5)
  for i in 0 ..< 75:
    r3 = carryPoint(r3, pivot, up, -step)
    spinBody(d, pivot, up, -step)
  check("reversed rotation also carries to -x", near(r3.x, 10.5, 1e-9) and standsOn(d, r3))

# ---- 5. the driver: the kinetic network turns the body
block driven:
  var g = newGraph()
  discard g.add(source(0, 0, 0, 0, 8.0, 16.0))
  discard g.add(shaft(1, 0, 0, 0))
  let bearing = g.add(consumer(2, 0, 0, 1, 0, ImpactBearing))
  let sol = solve(g)
  let rpm = sol.speed[int(bearing)]
  check("the bearing sees 8 rpm from the network", near(rpm, 8.0))
  let b = platform()
  for i in 0 ..< 150:
    spinBody(b, pivot, up, rpmToRadPerTick(rpm))
  check("150 ticks at the network's 8 rpm is exactly one turn", near(abs(b.orient.w), 1.0, 1e-9))
  var g2 = g
  g2.nodes[0].genRpm = -8.0
  let b2 = platform()
  for i in 0 ..< 75:
    spinBody(b2, pivot, up, rpmToRadPerTick(solve(g2).speed[int(bearing)]))
  let w = b2.pos + rotate(b2.orient, v3(4.5, 0.5, 2.5))
  check("a reversed motor turns the platform the other way (still half a turn: (10.5, 64.5, 12.5))", near(w.x, 10.5, 1e-9) and b2.angVel.y < 0.0)

echo "contraptiontest: ", checks, " checks"
if failures > 0:
  echo "contraptiontest: ", failures, " FAILED"
  quit(1)
echo "contraptiontest: ALL PASS"
