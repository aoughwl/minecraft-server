## createworld.aowl on an in-memory world: motor -> gearbox -> bearing -> a 5x5 platform body that turns, an item standing on it that is
## carried, an opposing second motor that jams the network and stops the platform, release back into blocks.
## Layout (all stand-in blocks, see createworld.aowl):
##   motor (registered) at (23,59,24) facing +x  ->  gearbox (copper_block) at (24,59,24)  ->  bearing (registered) at (24,60,24), facing up
##   platform of stone at y = 61, x 22..26, z 22..26 (top surface y = 62), one DIRT block at (26,61,24) on its +x side as a marker.
##   Motor +8 rpm enters the gearbox through its -x face; the up output is perpendicular, so the bearing turns -8 rpm: clockwise seen from above.
## Exit 0 and "ALL PASS" when everything holds.

import std/[syncio, cmdline, tables, options, math, strutils]
import ../../config/lib as configlib
import ../../world/[chunkdata, level, lightingruntime, palette, playerdata, worldfs, worldinfo]
import ../../world/blockstates as states
import ../../util/math/position
import ../../util/math/boundingbox
import ../../util/vector3
import ../../data/block_ext
from ../../data/block_state import newBlockStateIdUnchecked, asU16
import "../../data/item_stack/mod"
import ../../generated/item_full
import ../../server/data/datamod
import ../../server/recipe
import ../../server/scheduler
import ../../server/serverbase
import ../../server/tick_rate_manager
import ../../server/net/winsock
import "../../server/block/worldadapter"
import ../../server/world/[bulkedit, worldmod]
import ../../server/entity/[collision_providers, entitymod, entitytype, itementity]
import ../../server/worldedit/wecore
import ../../physics/[body, integrator]
import ../../server/body/[bodymanager, bodyworld]
import kinetic, contraption, createworld, createcmd

var failures = 0
var checks = 0

proc check(name: string; cond: bool) =
  inc checks
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

proc scratch(): string =
  result = parentDirW(paramStr(0)) & "/create_scratch"
  discard createDirAllW(result)

const Sections = 8   # y 0..127

let adv = defaultAdvancedConfiguration()
let theLevel = fromRootFolder(adv.world, scratch(), 1'i64, OVERWORLD)
let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD],
  tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
  recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let bw = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, 0'i32, server)
server.worlds.add(bw)

proc mkChunk(x, z: int32): ChunkData =
  let c = newChunkData(x, z, newChunkSections(Sections, 0'i32))
  c.lightEngine.skyLight = newSeq[LightContainer](Sections)
  c.lightEngine.blockLight = newSeq[LightContainer](Sections)
  for i in 0 ..< Sections:
    c.lightEngine.skyLight[i] = newLightEmpty(0'u8)
    c.lightEngine.blockLight[i] = newLightEmpty(0'u8)
  c

proc stateOf(text: string): uint32 =
  var s = 0'u32
  var err = ""
  if not parseBlockState(text, s, err):
    echo "BAD TEST BLOCK ", text, ": ", err
    quit(2)
  s

let stone = stateOf("stone")
let dirt = stateOf("dirt")
let gearboxState = stateOf("copper_block")
let shaftX = stateOf("stripped_oak_log[axis=x]")
let shaftY = stateOf("stripped_oak_log[axis=y]")
let cogSmallY = stateOf("stripped_birch_log[axis=y]")
let cogLargeZ = stateOf("stripped_dark_oak_log[axis=z]")

var chunks: seq[ChunkData] = @[]
for cz in 0'i32 .. 1'i32:
  for cx in 0'i32 .. 1'i32:
    let c = mkChunk(cx, cz)
    addLoadedChunk(theLevel, c)
    chunks.add(c)

proc fillBox(x0, y0, z0, x1, y1, z1: int32; id: uint32) =
  for y in y0 .. y1:
    for z in z0 .. z1:
      for x in x0 .. x1:
        discard setBlockState(theLevel, newBlockPos(x, y, z), id)

proc stateAt(x, y, z: int32): uint32 = getBlockState(theLevel, newBlockPos(x, y, z))

proc near(a, b: float64; eps: float64 = 1e-9): bool = abs(a - b) <= eps

proc at(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)

proc clearJournal() =
  for rec in journalList(bw):
    journalDelete(bw, rec.body.idHi, rec.body.idLo)

proc buildRig() =
  ## stone platform, marker, gearbox; the registered parts are added by each scene
  fillBox(22, 61, 22, 26, 61, 26, stone)
  discard setBlockState(theLevel, newBlockPos(26'i32, 61'i32, 24'i32), dirt)
  discard setBlockState(theLevel, newBlockPos(24'i32, 59'i32, 24'i32), gearboxState)

proc clearRig() =
  fillBox(0, 55, 0, 31, 70, 31, 0'u32)

proc yawOf(b: Body): float64 =
  ## rotation about +y in radians (-pi..pi) from the quaternion of a pure y rotation
  2.0 * arctan2(b.orient.y, b.orient.w)

proc yawAngle(q: Quat): float64 = 2.0 * arctan2(q.y, q.w)

# a tick of everything the server does for this mod
var gItems: seq[EntityBase] = @[]
proc tickAll(n: int) =
  for i in 0 ..< n:
    inc server.tickCounter
    tickBodies(server)
    createTick(server)
    for it in gItems:
      it.tick(it, server)

# --- baseline world ------------------------------------------------------------------------------------------------------------
fillBox(0, 0, 0, 31, 17, 31, stone)
fillBox(0, 18, 0, 31, 19, 31, dirt)
for c in chunks:
  c.heightmap = calculateHeightmap(c)
clearJournal()
bodyReset()
createReset()
gCfg.journal = false

# ======================================================================================================================
# A. classify and scan: the world is read through the stand-in table
# ======================================================================================================================
block classifyBlocks:
  var k = kkShaft
  var ax = 0
  check("classify: stripped oak log x = shaft on axis 0", classify(shaftX, k, ax) and k == kkShaft and ax == 0)
  check("classify: stripped oak log y = shaft on axis 1", classify(shaftY, k, ax) and k == kkShaft and ax == 1)
  check("classify: birch = small cog", classify(cogSmallY, k, ax) and k == kkCogSmall and ax == 1)
  check("classify: dark oak z = large cog on axis 2", classify(cogLargeZ, k, ax) and k == kkCogLarge and ax == 2)
  check("classify: copper block = gearbox", classify(gearboxState, k, ax) and k == kkGearbox)
  check("classify: stone and air are not components", not classify(stone, k, ax) and not classify(0'u32, k, ax))

block scanPureWorld:
  # a motor and three shafts in a row, a gap, then one more: the scan stops at the gap
  clearRig()
  discard addSource(bw, 4'i32, 60'i32, 4'i32, 0, 16.0, 16.0)
  fillBox(5, 60, 4, 7, 60, 4, shaftX)
  fillBox(9, 60, 4, 9, 60, 4, shaftX)
  rescan(bw)
  var rpm = 0.0
  var net = NetInfo()
  check("scan: the third shaft turns at 16 rpm", speedAt(bw, 7'i32, 60'i32, 4'i32, rpm, net) and near(rpm, 16.0) and net.state == nsRunning)
  check("scan: the shaft behind the gap is not part of the network", not speedAt(bw, 9'i32, 60'i32, 4'i32, rpm, net))
  # a small cog on the end of the line turns the other way on the cog beside it
  discard setBlockState(theLevel, newBlockPos(8'i32, 60'i32, 4'i32), stateOf("stripped_birch_log[axis=x]"))
  discard setBlockState(theLevel, newBlockPos(8'i32, 61'i32, 4'i32), stateOf("stripped_birch_log[axis=x]"))
  rescan(bw)
  check("scan: the meshed cog above the cog on the line turns at -16", speedAt(bw, 8'i32, 61'i32, 4'i32, rpm, net) and near(rpm, -16.0))
  check("scan: a shaft the motor reaches through the cog still turns (the one at x=9 now connects: 16)", speedAt(bw, 9'i32, 60'i32, 4'i32, rpm, net) and near(rpm, 16.0))
  discard removeSource(bw, 4'i32, 60'i32, 4'i32)
  clearRig()

# ======================================================================================================================
# B. motor -> gearbox -> bearing -> platform: direction, speed, pose, riders
# ======================================================================================================================
proc setupDrive(rpm: float64): BodyEntity =
  clearRig()
  clearJournal()
  bodyReset()
  createReset()
  gCfg.journal = false
  gCfg.autoSettle = false
  buildRig()
  discard addSource(bw, 23'i32, 59'i32, 24'i32, 0, rpm, 16.0)
  let r = addBearing(bw, 24'i32, 60'i32, 24'i32, 2, volumeBox(22'i32, 61'i32, 22'i32, 26'i32, 61'i32, 26'i32), server.tickCounter)
  if not r.ok:
    echo "setupDrive: ", r.reason
    quit(2)
  bodyById(r.bodyId).get

block drive:
  let be = setupDrive(8.0)
  check("bearing: the platform became ONE body of 25 cells, the blocks are out of the world", bodyCount() == 1 and stateAt(22'i32, 61'i32, 22'i32) == 0'u32 and
    stateAt(24'i32, 59'i32, 24'i32) == gearboxState)
  check("bearing: the body is kinematic", be.kinematic)
  check("bearing: solved at once, the bearing sees -8 rpm (gearbox flips a perpendicular output)", near(gBearings[0].rpm, -8.0) and gBearings[0].state == nsRunning)
  tickAll(1)
  check("pose after one tick: angle = -8 rpm = -0.0418879 rad", near(yawAngle(be.body.orient), -0.04188790204786391, 1e-12))
  tickAll(36)
  check("pose after 37 ticks: angle = -37 * 0.0418879 = -1.5499 rad", near(yawAngle(be.body.orient), -37.0 * 0.04188790204786391, 1e-9))
  let centre = be.body.pos + rotate(be.body.orient, Vec3(x: 2.5, y: 0.5, z: 2.5))
  check("pivot stays put: the middle cell stays on the bearing axis (24.5, ., 24.5)", near(centre.x, 24.5, 1e-9) and near(centre.z, 24.5, 1e-9))
  check("angular velocity is -0.0418879 about y", near(be.body.angVel.y, -0.04188790204786391, 1e-12))
  # the marker (local (4,0,2) = world (26,61,24) at the start) after 37 ticks, hand computed: theta = -1.549926 rad,
  # offset (2,0) -> (2 cos t, -2 sin t) = (0.0283, 1.99980)
  let marker = be.body.pos + rotate(be.body.orient, Vec3(x: 4.5, y: 0.5, z: 2.5))
  check("the dirt marker moved from +x towards +z (clockwise seen from above): x " & $marker.x & " z " & $marker.z,
    near(marker.x - 24.5, 2.0 * cos(-37.0 * 0.04188790204786391), 1e-9) and near(marker.z - 24.5, -2.0 * sin(-37.0 * 0.04188790204786391), 1e-9) and marker.z > 26.0)
  check("the surface velocity feed: the manager answers collisions for the turned platform", not isSpaceEmpty(bw, newBoundingBox(at(24.1, 61.2, 24.1), at(24.9, 61.8, 24.9))))
  check("a state event was queued for the network feed", bodyEventsPending() > 0)
  # the kinematic body is not stepped by physics: it did not fall
  check("not stepped by gravity: still at y = 61", near(be.body.pos.y, 61.0, 1e-12))

block carryItem:
  let be = setupDrive(8.0)
  let ie = newEntity(bw, at(26.5, 62.0, 24.5), EntityType.ITEM)
  let item = newItemEntityWithVelocity(ie, newItemStack(1'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 0'u8)
  gItems = @[]
  let itemBase: EntityBase = item
  gItems.add itemBase
  addEntitySilent(bw, itemBase)
  tickAll(60)
  # after 60 ticks at -8 rpm: theta = -2.5132741 (-144 degrees): offset (2,0) -> (-1.618034, +1.175571)
  let px = item.entity.pos.x
  let pz = item.entity.pos.z
  check("rider: carried to (22.882, 62, 25.676); got (" & $px & ", " & $item.entity.pos.y & ", " & $pz & ")",
    near(px, 24.5 - 1.6180339887, 0.01) and near(pz, 24.5 + 1.1755705046, 0.01) and near(item.entity.pos.y, 62.0, 0.01))
  check("rider: the radius did not drift (2.0)", near(sqrt((px - 24.5) * (px - 24.5) + (pz - 24.5) * (pz - 24.5)), 2.0, 0.01))
  check("rider: the carry counter says it was carried on every tick", gBearings[0].carriedTotal >= 59)
  check("rider: it still stands on the platform", standsOn(be.body, Vec3(x: px, y: item.entity.boundingBox.min.y, z: pz)))
  # control: the same run WITHOUT the carry leaves the item behind
  let be2 = setupDrive(8.0)
  gCarry = false
  let ie2 = newEntity(bw, at(26.5, 62.0, 24.5), EntityType.ITEM)
  let item2 = newItemEntityWithVelocity(ie2, newItemStack(1'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 0'u8)
  gItems = @[]
  let itemBase2: EntityBase = item2
  gItems.add itemBase2
  addEntitySilent(bw, itemBase2)
  tickAll(60)
  let d = sqrt((item2.entity.pos.x - px) * (item2.entity.pos.x - px) + (item2.entity.pos.z - pz) * (item2.entity.pos.z - pz))
  check("control: without the carry the item is far from where the carried one is (" & $d & " blocks)", d > 3.0)
  check("control: it stayed exactly where it was dropped (26.5, 24.5): nothing else moves it", near(item2.entity.pos.x, 26.5, 0.02) and near(item2.entity.pos.z, 24.5, 0.02))
  check("control: the second body is the same rig", yawAngle(be2.body.orient) < -2.0)
  gCarry = true
  gItems = @[]
  removeEntity(bw, item.entity)
  removeEntity(bw, item2.entity)

# ======================================================================================================================
# C. jam: a second motor that opposes the first stops the platform; removing it restarts it
# ======================================================================================================================
block jam:
  let be = setupDrive(8.0)
  tickAll(5)
  let a0 = yawAngle(be.body.orient)
  check("jam: turning before", a0 < -0.1)
  # a second motor underneath the gearbox facing up forces +8 on the gearbox's down port; the first motor makes it -8 there
  discard addSource(bw, 24'i32, 58'i32, 24'i32, 2, 8.0, 16.0)
  rescan(bw)
  check("jam: the bearing's network is jammed", gBearings[0].state == nsJammed and near(gBearings[0].rpm, 0.0))
  var jamReason = ""
  for nt in gSol.nets:
    if nt.state == nsJammed:
      jamReason = nt.reason
  check("jam: a reason is reported (" & jamReason & ")", jamReason.len > 0)
  tickAll(20)
  check("jam: the platform stopped turning", near(yawAngle(be.body.orient), a0, 1e-12) and near(be.body.angVel.y, 0.0, 1e-15))
  # the same second motor turning the other way is consistent: +8 forced on the down port = -(-8)... use -8: no jam
  discard addSource(bw, 24'i32, 58'i32, 24'i32, 2, -8.0, 16.0)
  rescan(bw)
  check("no jam: the second motor reversed agrees with the gearbox, the bearing turns again", gBearings[0].state == nsRunning and near(gBearings[0].rpm, -8.0))
  tickAll(10)
  check("no jam: the platform moved on", yawAngle(be.body.orient) < a0 - 0.3)
  check("no jam: capacity doubled (two motors, 2 * 16 * 8 = 256 su)", block:
    var cap = 0.0
    for nt in gSol.nets:
      cap += nt.capacity
    near(cap, 256.0))
  discard removeSource(bw, 24'i32, 58'i32, 24'i32)
  rescan(bw)
  check("the first motor alone: running again", gBearings[0].state == nsRunning and near(gBearings[0].rpm, -8.0))
  # removing the gearbox cuts the power
  discard setBlockState(theLevel, newBlockPos(24'i32, 59'i32, 24'i32), 0'u32)
  rescan(bw)
  check("cut: without the gearbox the bearing is idle", near(gBearings[0].rpm, 0.0) and gBearings[0].state == nsIdle)
  let a1 = yawAngle(be.body.orient)
  tickAll(15)
  check("cut: the platform stopped", near(yawAngle(be.body.orient), a1, 1e-12))

# ======================================================================================================================
# D. release: stop at exactly a quarter turn, the blocks come back rotated
# ======================================================================================================================
block release:
  let be = setupDrive(12.0)                       # 12 rpm = 0.0628319 rad per tick, 25 ticks = pi/2
  tickAll(25)
  check("release: a quarter turn after 25 ticks at 12 rpm (-pi/2)", near(yawAngle(be.body.orient), -PI / 2.0, 1e-9))
  let (ok, why) = releaseBearing(bw, 24'i32, 60'i32, 24'i32, server.tickCounter)
  check("release: succeeded (" & why & ")", ok)
  check("release: the body is gone, the bearing is gone", bodyCount() == 0 and gBearings.len == 0)
  var n = 0
  for z in 22'i32 .. 26'i32:
    for x in 22'i32 .. 26'i32:
      if stateAt(x, 61'i32, z) != 0'u32:
        inc n
  check("release: 25 blocks back in the 5x5 footprint", n == 25)
  check("release: the dirt marker that was at +x (26,61,24) is now at +z (24,61,26) after a clockwise quarter turn", stateAt(24'i32, 61'i32, 26'i32) == dirt and
    stateAt(26'i32, 61'i32, 24'i32) == stone)
  check("release: the gearbox is untouched", stateAt(24'i32, 59'i32, 24'i32) == gearboxState)
  clearRig()

# ======================================================================================================================
# E. the manager does not touch a kinematic body: no fall, no auto settle
# ======================================================================================================================
block notStepped:
  let be = setupDrive(0.0)
  gCfg.autoSettle = true
  tickAll(80)
  check("a stopped contraption hangs in the air: no gravity, no auto settle", bodyCount() == 1 and near(be.body.pos.y, 61.0, 1e-12) and be.kinematic)
  gCfg.autoSettle = false
  discard releaseBearing(bw, 24'i32, 60'i32, 24'i32, server.tickCounter)
  clearRig()

# ======================================================================================================================
# F. /create text commands
# ======================================================================================================================
block commands:
  clearRig()
  clearJournal()
  bodyReset()
  createReset()
  gCfg.journal = false
  buildRig()
  proc say(parts: seq[string]): string =
    let lines = createExec(bw, 24'i32, 60'i32, 24'i32, parts, server.tickCounter)
    result = ""
    for l in lines:
      result.add l
      result.add '\n'
  check("/create: help text on no arguments", say(@[]).contains("motor"))
  check("/create motor: registers a source", say(@["motor", "23", "59", "24", "8", "east"]).contains("Motor"))
  let b = say(@["bearing", "24", "60", "24", "up", "22", "61", "22", "26", "61", "26"])
  check("/create bearing: assembles the platform (" & b & ")", b.contains("25") and bodyCount() == 1)
  let sc = say(@["scan"])
  check("/create scan: lists the running network (" & sc.replace("\n", " | ") & ")", sc.contains("running"))
  let sp = say(@["speed", "24", "59", "24"])
  check("/create speed: the gearbox reports 8 rpm (" & sp & ")", sp.contains("8"))
  tickAll(10)
  let st = say(@["status"])
  check("/create status: one bearing, one body (" & st.replace("\n", " | ") & ")", st.contains("bearing") and st.contains("-8"))
  check("/create bearing refuses a box without the cell beside the bearing", say(@["bearing", "30", "61", "30", "up", "1", "61", "1", "2", "61", "2"]).contains("must contain"))
  let rel = say(@["release", "24", "60", "24"])
  check("/create release: puts the blocks back (" & rel & ")", rel.contains("released") and bodyCount() == 0)
  check("/create: an unknown subcommand is refused", say(@["frobnicate"]).contains("Unknown"))
  check("/create clear: forgets the motors", say(@["clear"]).contains("Cleared") and gSources.len == 0)
  clearRig()

echo "createworldtest: ", checks, " checks"
if failures > 0:
  echo "createworldtest: ", failures, " FAILED"
  quit(1)
echo "createworldtest: ALL PASS"
