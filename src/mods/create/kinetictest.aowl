## kinetic.aowl on hand-built graphs: shaft lines, gear trains (ratio and direction), gearboxes, clutches, jams, stress.
## Every expected number is computed by hand in the comment next to the check. Exit 0 = all passed.
import std/[syncio, math]
import kinetic

var failures = 0
var checks = 0

proc check(name: string; cond: bool) =
  inc checks
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

proc near(a, b: float64): bool = abs(a - b) < 1e-9

const East = 0
const West = 1

proc speedOf(g: Graph; i: int32): float64 = solve(g).speed[int(i)]

# ---- 1. a shaft line: motor (0,0,0) facing +x at 16 rpm, shafts at x=1,2, a press at x=3 taking the -x end
block shaftLine:
  var g = newGraph()
  let m = g.add(source(0, 0, 0, East, 16.0, 16.0))
  let s1 = g.add(shaft(1, 0, 0, 0))
  let s2 = g.add(shaft(2, 0, 0, 0))
  let p = g.add(consumer(3, 0, 0, West, 0, 8.0))
  let far = g.add(shaft(9, 0, 0, 0))          # not connected
  let sol = solve(g)
  check("line: every part turns at 16 rpm", near(sol.speed[int(m)], 16.0) and near(sol.speed[int(s1)], 16.0) and near(sol.speed[int(s2)], 16.0) and near(sol.speed[int(p)], 16.0))
  check("line: one network, running", sol.nets.len == 1 and sol.nets[0].state == nsRunning and sol.nets[0].nodes.len == 4)
  check("line: capacity 16*16 = 256 su, demand 8*16 = 128 su", near(sol.nets[0].capacity, 256.0) and near(sol.nets[0].demand, 128.0))
  check("line: the loose shaft is idle (speed 0, no network)", sol.speed[int(far)] == 0.0 and sol.netId[int(far)] == -1)
  var g2 = newGraph()
  discard g2.add(source(0, 0, 0, East, 16.0, 16.0))
  let gap = g2.add(shaft(2, 0, 0, 0))
  check("line: a gap breaks the line", speedOf(g2, gap) == 0.0)
  var g3 = newGraph()
  discard g3.add(source(0, 0, 0, East, 16.0, 16.0))
  let wrongAxis = g3.add(shaft(1, 0, 0, 1))
  check("line: a shaft on the wrong axis does not connect", speedOf(g3, wrongAxis) == 0.0)

# ---- 2. gear train: small A (8 teeth) -> large L (16) -> small B. Ratios -8/16 then -16/8.
block gearTrain:
  var g = newGraph()
  discard g.add(source(0, 0, 0, East, 16.0, 16.0))
  discard g.add(shaft(1, 0, 0, 0))
  let a = g.add(cogSmall(2, 0, 0, 0))            # 16 rpm, on the shaft
  let l = g.add(cogLarge(2, 1, 1, 0))            # diagonal to A: 16 * (-8/16) = -8
  let b = g.add(cogSmall(2, 2, 2, 0))            # diagonal to L: -8 * (-16/8) = +16
  let sol = solve(g)
  check("train: A turns with the shaft (16)", near(sol.speed[int(a)], 16.0))
  check("train: the large cog turns half as fast the other way (-8)", near(sol.speed[int(l)], -8.0))
  check("train: the second small cog is back at +16", near(sol.speed[int(b)], 16.0))
  check("train: all running", sol.nets[0].state == nsRunning)
  # two small cogs side by side: ratio -1
  var g2 = newGraph()
  discard g2.add(source(0, 0, 0, East, 20.0, 16.0))
  discard g2.add(shaft(1, 0, 0, 0))
  discard g2.add(cogSmall(2, 0, 0, 0))
  let c = g2.add(cogSmall(2, 1, 0, 0))
  let d = g2.add(cogSmall(2, 1, 1, 0))
  let sol2 = solve(g2)
  check("small-small side by side reverses, same speed (-20)", near(sol2.speed[int(c)], -20.0))
  check("a third small cog turns like the first (+20)", near(sol2.speed[int(d)], 20.0))
  # a large cog and a small cog side by side (not diagonal) do not mesh
  var g3 = newGraph()
  discard g3.add(source(0, 0, 0, East, 16.0, 16.0))
  discard g3.add(shaft(1, 0, 0, 0))
  discard g3.add(cogSmall(2, 0, 0, 0))
  let far = g3.add(cogLarge(2, 1, 0, 0))
  check("orthogonal small-large does not mesh", speedOf(g3, far) == 0.0)
  # cogs on different axes in the same plane position do not mesh
  var g4 = newGraph()
  discard g4.add(source(0, 0, 0, East, 16.0, 16.0))
  discard g4.add(shaft(1, 0, 0, 0))
  discard g4.add(cogSmall(2, 0, 0, 0))
  let wrong = g4.add(cogSmall(2, 1, 0, 1))
  check("cogs on different axes do not mesh", speedOf(g4, wrong) == 0.0)
  # speed-up is exactly the tooth ratio at an exotic speed
  var g5 = newGraph()
  discard g5.add(source(0, 0, 0, East, -48.0, 16.0))
  discard g5.add(shaft(1, 0, 0, 0))
  discard g5.add(cogLarge(2, 0, 0, 0))
  let small = g5.add(cogSmall(2, 1, 1, 0))
  check("large to small doubles the speed: -48 * (-16/8) = +96", near(speedOf(g5, small), 96.0))

# ---- 3. jams
block jams:
  # opposing motors on one shaft
  var g = newGraph()
  let m1 = g.add(source(0, 0, 0, East, 16.0, 16.0))
  discard g.add(shaft(1, 0, 0, 0))
  let m2 = g.add(source(2, 0, 0, West, -16.0, 16.0))
  let sol = solve(g)
  check("jam: two motors turning against each other", sol.nets.len == 1 and sol.nets[0].state == nsJammed)
  check("jam: everything stops", sol.speed[int(m1)] == 0.0 and sol.speed[int(m2)] == 0.0 and sol.speed[1] == 0.0)
  check("jam: a reason is given", sol.nets[0].reason.len > 0)
  # the same two motors turning the same way are fine and add their capacity
  var gb = newGraph()
  discard gb.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gb.add(shaft(1, 0, 0, 0))
  discard gb.add(source(2, 0, 0, West, 16.0, 16.0))
  let solb = solve(gb)
  check("two motors turning together run", solb.nets[0].state == nsRunning and solb.nets[0].sources == 2 and near(solb.nets[0].capacity, 512.0))
  # two motors at different speeds on one shaft
  var gc = newGraph()
  discard gc.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gc.add(shaft(1, 0, 0, 0))
  discard gc.add(source(2, 0, 0, West, 32.0, 16.0))
  check("jam: 16 rpm against 32 rpm", solve(gc).nets[0].state == nsJammed)
  # a motor on the second cog turning the same way as its neighbour: A (16) meshes B so B must turn -16
  var gd = newGraph()
  discard gd.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gd.add(shaft(1, 0, 0, 0))
  discard gd.add(cogSmall(2, 0, 0, 0))
  discard gd.add(cogSmall(2, 1, 0, 0))
  discard gd.add(shaft(3, 1, 0, 0))
  discard gd.add(source(4, 1, 0, West, 16.0, 16.0))
  check("jam: a motor on the second cog turning the same way as its neighbour", solve(gd).nets[0].state == nsJammed)
  var ge = newGraph()
  discard ge.add(source(0, 0, 0, East, 16.0, 16.0))
  discard ge.add(shaft(1, 0, 0, 0))
  discard ge.add(cogSmall(2, 0, 0, 0))
  discard ge.add(cogSmall(2, 1, 0, 0))
  discard ge.add(shaft(3, 1, 0, 0))
  discard ge.add(source(4, 1, 0, West, -16.0, 16.0))
  check("no jam: the same motor turning the right way (-16)", solve(ge).nets[0].state == nsRunning)
  # a ring of four small cogs closes (even loop)
  var gf = newGraph()
  discard gf.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gf.add(shaft(1, 0, 0, 0))
  discard gf.add(cogSmall(2, 0, 0, 0))
  discard gf.add(cogSmall(2, 1, 0, 0))
  discard gf.add(cogSmall(2, 1, 1, 0))
  discard gf.add(cogSmall(2, 0, 1, 0))
  check("a ring of four small cogs closes", solve(gf).nets[0].state == nsRunning)
  # a ring of two small and two large cogs closes: (-8/16) * (-16/8) * (-8/16) * (-16/8) = 1
  var gg = newGraph()
  discard gg.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gg.add(shaft(1, 0, 0, 0))
  discard gg.add(cogSmall(2, 0, 0, 0))
  let l1 = gg.add(cogLarge(2, 1, 1, 0))
  let b2 = gg.add(cogSmall(2, 2, 0, 0))
  let l2 = gg.add(cogLarge(2, 1, -1, 0))
  let solg = solve(gg)
  check("a mixed ring of small and large cogs closes", solg.nets[0].state == nsRunning and near(solg.speed[int(l1)], -8.0) and
    near(solg.speed[int(b2)], 16.0) and near(solg.speed[int(l2)], -8.0))
  # the same ring with a motor forcing 9 rpm into the second small cog does not
  gg.nodes.add source(3, 0, 0, West, 9.0, 16.0)
  gg.nodes.add shaft(3, 0, 0, 0)
  check("jam: the ring with a 9 rpm motor on the second small cog (16 expected)", block:
    var gh = gg
    gh.nodes[gh.nodes.len - 2] = shaft(3, 0, 0, 0)
    gh.nodes[gh.nodes.len - 1] = source(4, 0, 0, West, 9.0, 16.0)
    solve(gh).nets[0].state == nsJammed)

  # a loop of four gearboxes joined by shafts closes; the same loop with a reversing gearshift in one side does not
  proc gearLoop(reversed: bool): Graph =
    var gl = newGraph()
    discard gl.add(source(-1, 0, 0, East, 10.0, 16.0))
    discard gl.add(gearbox(0, 0, 0))
    discard gl.add(gearbox(2, 0, 0))
    discard gl.add(gearbox(2, 0, 2))
    discard gl.add(gearbox(0, 0, 2))
    discard gl.add(gearshift(1, 0, 0, 0, reversed))
    discard gl.add(shaft(2, 0, 1, 2))
    discard gl.add(shaft(0, 0, 1, 2))
    discard gl.add(shaft(1, 0, 2, 0))
    gl
  check("a loop of four gearboxes closes", solve(gearLoop(false)).nets[0].state == nsRunning)
  let loopJam = solve(gearLoop(true))
  check("jam: the same loop with a reversing gearshift in one side (the closing edge disagrees)", loopJam.nets[0].state == nsJammed and loopJam.nets[0].reason.len > 0)

# ---- 4. stress
block stress:
  var g = newGraph()
  discard g.add(source(0, 0, 0, East, 16.0, 16.0))      # capacity 16 * 16 = 256 su
  discard g.add(shaft(1, 0, 0, 0))
  discard g.add(cogLarge(2, 0, 0, 0))
  discard g.add(cogSmall(2, 1, 1, 0))                    # diagonal to the large cog: 16 * (-16/8) = -32 rpm
  let press = g.add(consumer(3, 1, 1, West, 0, 8.0))     # touches the small cog's +x end
  var sol = solve(g)
  check("stress: the press turns at -32 after the speed-up", near(sol.speed[int(press)], -32.0))
  check("stress: demand 8 * 32 = 256 su equals the capacity 256 su, still running", near(sol.nets[0].demand, 256.0) and sol.nets[0].state == nsRunning)
  g.nodes[int(press)].impactPerRpm = 8.5
  sol = solve(g)
  check("stress: 8.5 * 32 = 272 su > 256 su overstresses", sol.nets[0].state == nsOverstressed and near(sol.nets[0].demand, 272.0))
  check("stress: an overstressed network stops", sol.speed[int(press)] == 0.0 and sol.speed[0] == 0.0)
  g.nodes[0].genRpm = 8.0                                # half the speed: capacity 128, demand 8.5 * 16 = 136
  sol = solve(g)
  check("stress: demand and capacity both scale with speed", near(sol.nets[0].capacity, 128.0) and near(sol.nets[0].demand, 136.0) and
    sol.nets[0].state == nsOverstressed)
  g.nodes[int(press)].impactPerRpm = 8.0
  sol = solve(g)
  check("stress: 8 * 16 = 128 su fits 128 su", sol.nets[0].state == nsRunning and near(sol.speed[int(press)], -16.0))
  var g2 = newGraph()
  discard g2.add(source(0, 0, 0, East, 16.0, 16.0))
  discard g2.add(shaft(1, 0, 0, 0))
  discard g2.add(consumer(2, 0, 0, West, 0, 8.0))
  var gb = newGraph()
  discard gb.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gb.add(shaft(1, 0, 0, 0))
  discard gb.add(consumer(2, 0, 0, -1, 0, 100.0))     # through shaft: 100 * 16 = 1600 > 256
  discard gb.add(consumer(3, 0, 0, -1, 0, 100.0))
  check("stress: a heavy consumer chain overstresses", solve(gb).nets[0].state == nsOverstressed)
  check("stress: a light one does not", solve(g2).nets[0].state == nsRunning)

# ---- 5. gearbox, clutch, gearshift
block parts:
  var g = newGraph()
  discard g.add(source(0, 0, 0, East, 24.0, 16.0))
  discard g.add(shaft(1, 0, 0, 0))
  let gb = g.add(gearbox(2, 0, 0))
  let straight = g.add(shaft(3, 0, 0, 0))
  let up = g.add(shaft(2, 1, 0, 1))
  let sideways = g.add(shaft(2, 0, 1, 2))
  let sol = solve(g)
  check("gearbox: the straight output turns the same way", near(sol.speed[int(straight)], 24.0))
  check("gearbox: both perpendicular outputs turn the other way", near(sol.speed[int(up)], -24.0) and near(sol.speed[int(sideways)], -24.0))
  check("gearbox: it reports its entry speed", near(sol.speed[int(gb)], 24.0))
  var gc = newGraph()
  discard gc.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gc.add(clutch(1, 0, 0, 0, true))
  let after = gc.add(shaft(2, 0, 0, 0))
  check("clutch engaged passes", near(speedOf(gc, after), 16.0))
  gc.nodes[1].engaged = false
  check("clutch released blocks", speedOf(gc, after) == 0.0)
  var gs = newGraph()
  discard gs.add(source(0, 0, 0, East, 16.0, 16.0))
  discard gs.add(gearshift(1, 0, 0, 0, false))
  let outp = gs.add(shaft(2, 0, 0, 0))
  check("gearshift idle passes straight", near(speedOf(gs, outp), 16.0))
  gs.nodes[1].engaged = true
  check("gearshift reversed flips the direction", near(speedOf(gs, outp), -16.0))

# ---- 6. determinism and ordering
proc buildTrain(rev: bool): seq[float64] =
  var nodes: seq[KNode] = @[]
  nodes.add source(0, 0, 0, East, 16.0, 16.0)
  nodes.add shaft(1, 0, 0, 0)
  nodes.add cogSmall(2, 0, 0, 0)
  nodes.add cogLarge(2, 1, 1, 0)
  nodes.add cogSmall(2, 2, 2, 0)
  var g = newGraph()
  if rev:
    var i = nodes.len - 1
    while i >= 0:
      discard g.add(nodes[i])
      dec i
  else:
    for n in nodes:
      discard g.add(n)
  let sol = solve(g)
  result = @[]
  for i in 0 ..< nodes.len:
    result.add (if rev: sol.speed[nodes.len - 1 - i] else: sol.speed[i])

block order:
  let a = buildTrain(false)
  let b = buildTrain(true)
  var same = true
  for i in 0 ..< a.len:
    if not near(a[i], b[i]):
      same = false
  check("insertion order does not change the speeds", same)
  check("solving twice gives the same answer", buildTrain(false) == a)

check("rpm to rad per tick: 60 rpm is one turn per second = 2 pi / 20", near(rpmToRadPerTick(60.0), TwoPi / 20.0))
var gcap = newGraph()
discard gcap.add(source(0, 0, 0, East, 999.0, 1.0))
let capShaft = gcap.add(shaft(1, 0, 0, 0))
check("speeds are capped at 256 rpm", near(speedOf(gcap, capShaft), 256.0))

echo "kinetictest: ", checks, " checks"
if failures > 0:
  echo "kinetictest: ", failures, " FAILED"
  quit(1)
echo "kinetictest: ALL PASS"
