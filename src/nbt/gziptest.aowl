## Known-answer checks for nbt_compress.aowl: every #[test] of pumpkin-nbt/src/nbt_compress.rs, plus real
## gzip bytes made by python's gzip module, the 64 MiB cap, and the error text.

{.feature: "untyped".}

import std/[syncio, options, tables, dirs, paths]
import tag, nbtbase, nbt_compress, zlibgz

var failures = 0

proc chk(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failures

proc gzipReadWriteCompound() =
  var compound = newCompound()
  compound.putByte("byte_value", 123'i8)
  compound.putShort("short_value", 12345'i16)
  compound.putInt("int_value", 1234567'i32)
  compound.putLong("long_value", 123456789'i64)
  compound.putFloat("float_value", 123.456'f32)
  compound.putDouble("double_value", 123456.789)
  compound.put("bool_value", true)
  compound.put("string_value", NbtTag(kind: ntkString, stringVal: "test string"))
  var nested = newCompound()
  nested.putInt("nested_int", 42'i32)
  compound.putCompound("nested_compound", nested)

  var buffer = newSeq[byte](0)
  let w = writeGzipCompoundTag(compound, buffer)
  chk(w.isOk, "gzip_read_write_compound: compress")
  chk(buffer[0] == 0x1F'u8 and buffer[1] == 0x8B'u8, "gzip magic")
  # flate2's GzBuilder header: CM 8, no flags, mtime 0, XFL 0, OS 255.
  chk(buffer[2] == 8'u8 and buffer[3] == 0'u8 and buffer[4] == 0'u8 and buffer[8] == 0'u8 and buffer[9] == 255'u8,
    "flate2 header bytes")
  let rr = readGzipCompoundTag(buffer)
  chk(rr.isOk, "gzip_read_write_compound: decompress")
  let read = rr.value
  chk(read.getByte("byte_value") == some(123'i8), "byte_value")
  chk(read.getShort("short_value") == some(12345'i16), "short_value")
  chk(read.getInt("int_value") == some(1234567'i32), "int_value")
  chk(read.getLong("long_value") == some(123456789'i64), "long_value")
  chk(read.getFloat("float_value") == some(123.456'f32), "float_value")
  chk(read.getDouble("double_value") == some(123456.789), "double_value")
  chk(read.getBool("bool_value") == some(true), "bool_value")
  chk(read.getString("string_value") == some("test string"), "string_value")
  let n = read.getCompound("nested_compound")
  chk(n.isSome, "nested_compound present")
  chk(n.unsafeGet.getInt("nested_int") == some(42'i32), "nested_int")

proc gzipConvenienceMethods() =
  var compound = newCompound()
  compound.putInt("test_value", 12345'i32)
  let buffer = writeGzipCompoundTagToBytes(compound)
  chk(buffer.isOk, "gzip_convenience_methods: compress")
  let read = readGzipCompoundTag(buffer.value)
  chk(read.isOk and read.value.getInt("test_value") == some(12345'i32), "gzip_convenience_methods: read")
  # The original entry point stays.
  let old = writeGzipCompoundTag(compound)
  chk(old.isOk and readGzipCompoundTag(old.value).isOk, "writeGzipCompoundTag returning bytes")

proc gzipEmptyCompound() =
  var buffer = newSeq[byte](0)
  chk(writeGzipCompoundTag(newCompound(), buffer).isOk, "gzip_empty_compound: compress")
  let read = readGzipCompoundTag(buffer)
  chk(read.isOk and read.value.len == 0, "gzip_empty_compound: read")

proc gzipLargeCompound() =
  var compound = newCompound()
  for i in 0 ..< 1000:
    compound.putInt("value_" & $i, int32(i))
  var buffer = newSeq[byte](0)
  chk(writeGzipCompoundTag(compound, buffer).isOk, "gzip_large_compound: compress")
  let read = readGzipCompoundTag(buffer)
  chk(read.isOk and read.value.len == 1000, "gzip_large_compound: 1000 entries")
  chk(read.value.getInt("value_0") == some(0'i32), "value_0")
  chk(read.value.getInt("value_500") == some(500'i32), "value_500")
  chk(read.value.getInt("value_999") == some(999'i32), "value_999")

type
  NestedStruct = object
    value: int64
    name: string

  TestStruct = object
    string_field: string
    int_field: int32
    bool_field: bool
    float_field: float32
    string_list: seq[string]
    nested: NestedStruct

  ArrayTest = object
    byte_array: seq[uint8]
    int_array: seq[int32]
    string_array: seq[string]

  MapTest = object
    string_map: Table[string, string]
    int_map: Table[string, int32]

proc same(a, b: TestStruct): bool =
  a.string_field == b.string_field and a.int_field == b.int_field and a.bool_field == b.bool_field and
    a.float_field == b.float_field and a.string_list == b.string_list and
    a.nested.value == b.nested.value and a.nested.name == b.nested.name

proc gzipSerializeDeserialize() =
  let testStruct = TestStruct(string_field: "test string", int_field: 12345'i32, bool_field: true,
    float_field: 123.456'f32, string_list: @["one", "two", "three"],
    nested: NestedStruct(value: 9876543210'i64, name: "nested_test"))
  var buffer = newSeq[byte](0)
  chk(toGzipBytes(testStruct, buffer).isOk, "gzip_serialize_deserialize: to_gzip_bytes")
  let read = fromGzipBytes[TestStruct](buffer)
  chk(read.isOk and same(read.value, testStruct), "gzip_serialize_deserialize: round trip")
  let buffer2 = toGzipBytesVec(testStruct)
  chk(buffer2.isOk, "to_gzip_bytes_vec")
  let read2 = fromGzipBytes[TestStruct](buffer2.value)
  chk(read2.isOk and same(read2.value, testStruct), "gzip_serialize_deserialize: vec round trip")

proc gzipCompressionRatio() =
  var compound = newCompound()
  for i in 0 ..< 1000:
    compound.put("repeated_key", NbtTag(kind: ntkString,
      stringVal: "this is a test string that will be repeated many times to demonstrate compression"))
  chk(compound.len == 1, "put keeps one repeated_key")
  var buffer = newSeq[byte](0)
  chk(writeGzipCompoundTag(compound, buffer).isOk, "gzip_compression_ratio: compress")
  chk(readGzipCompoundTag(buffer).isOk, "gzip_compression_ratio: read back")

proc gzipInvalidData() =
  let bad = readGzipCompoundTag(@[1'u8, 2'u8, 3'u8, 4'u8, 5'u8])
  chk(not bad.isOk, "gzip_invalid_data")
  chk(bad.error.kind == nekIncomplete, "gzip_invalid_data: Error::Incomplete")
  chk(bad.error.msg == "NBT reading was cut short: invalid gzip header", "gzip_invalid_data text: " & bad.error.msg)

proc roundtripWithArrays() =
  let testStruct = ArrayTest(byte_array: @[1'u8, 2'u8, 3'u8, 4'u8, 5'u8],
    int_array: @[100'i32, 200'i32, 300'i32, 400'i32, 500'i32],
    string_array: @["one", "two", "three"])
  var buffer = newSeq[byte](0)
  let w = toGzipBytes(testStruct, buffer)
  chk(w.isOk, "roundtrip_with_arrays: write")
  let read = fromGzipBytes[ArrayTest](buffer)
  chk(read.isOk, "roundtrip_with_arrays: read")
  chk(read.value.byte_array == testStruct.byte_array and read.value.int_array == testStruct.int_array and
    read.value.string_array == testStruct.string_array, "roundtrip_with_arrays: equal")

proc roundtripWithMap() =
  var stringMap = initTable[string, string]()
  stringMap["key1"] = "value1"
  stringMap["key2"] = "value2"
  var intMap = initTable[string, int32]()
  intMap["one"] = 1'i32
  intMap["two"] = 2'i32
  let testStruct = MapTest(string_map: stringMap, int_map: intMap)
  var buffer = newSeq[byte](0)
  chk(toGzipBytes(testStruct, buffer).isOk, "roundtrip_with_map: write")
  let read = fromGzipBytes[MapTest](buffer)
  chk(read.isOk, "roundtrip_with_map: read")
  let m = read.value
  chk(m.string_map.len == 2 and m.string_map.getOrDefault("key1", "") == "value1" and
    m.string_map.getOrDefault("key2", "") == "value2", "string_map")
  chk(m.int_map.len == 2 and m.int_map.getOrDefault("one", 0'i32) == 1'i32 and
    m.int_map.getOrDefault("two", 0'i32) == 2'i32, "int_map")

proc directFileIo() =
  const path = "gziptest_direct_file_io.dat"
  var compound = newCompound()
  compound.putInt("test_value", 42'i32)
  var f: File
  chk(open(f, path, fmWrite), "direct_file_io: create")
  chk(writeGzipCompoundTag(compound, f).isOk, "direct_file_io: write")
  close(f)
  var g: File
  chk(open(g, path, fmRead), "direct_file_io: open")
  let read = readGzipCompoundTag(g)
  close(g)
  discard tryRemoveFile(paths.path(path))
  chk(read.isOk and read.value.getInt("test_value") == some(42'i32), "direct_file_io: read")

# --- not in upstream ----------------------------------------------------------

const pyGzip = [ # python gzip of {hello: 42, name: "Bananrama"} under an empty root name
  0x1F'u8, 0x8B, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0xFF, 0xE3, 0x62, 0x60, 0x60, 0x66, 0x60,
  0xCD, 0x48, 0xCD, 0xC9, 0xC9, 0x67, 0x60, 0x60, 0xD0, 0xE2, 0x60, 0x60, 0xC9, 0x4B, 0xCC, 0x4D,
  0x65, 0xE0, 0x74, 0x4A, 0xCC, 0x4B, 0xCC, 0x2B, 0x4A, 0xCC, 0x4D, 0x64, 0x00, 0x00, 0x2B, 0x52,
  0x3F, 0xF5, 0x22, 0x00, 0x00, 0x00]

proc pyBytes(): seq[byte] =
  result = newSeq[byte](pyGzip.len)
  for i in 0 ..< pyGzip.len:
    result[i] = pyGzip[i]

proc knownAnswerDecompress() =
  let read = readGzipCompoundTag(pyBytes())
  chk(read.isOk, "python gzip: read")
  chk(read.value.getInt("hello") == some(42'i32), "python gzip: hello")
  chk(read.value.getString("name") == some("Bananrama"), "python gzip: name")
  chk(read.value.names == @["hello", "name"], "python gzip: order")
  # Bytes after the first member are not read, as GzDecoder does.
  var trailing = pyBytes()
  trailing.add 0xAA'u8
  trailing.add 0xBB'u8
  chk(readGzipCompoundTag(trailing).isOk, "python gzip: trailing bytes ignored")

proc corruptStreams() =
  var crc = pyBytes()
  crc[crc.len - 8] = crc[crc.len - 8] xor 0xFF'u8
  let c = readGzipCompoundTag(crc)
  chk(not c.isOk and c.error.msg == "NBT reading was cut short: corrupt gzip stream does not have a matching checksum",
    "bad crc: " & c.error.msg)
  var size = pyBytes()
  size[size.len - 1] = 0x01'u8
  let s = readGzipCompoundTag(size)
  chk(not s.isOk and s.error.msg == "NBT reading was cut short: corrupt gzip stream does not have a matching checksum",
    "bad size: " & s.error.msg)
  let truncated = readGzipCompoundTag(pyBytes()[0 ..< 20])
  chk(not truncated.isOk and truncated.error.kind == nekIncomplete, "truncated body")
  let empty = readGzipCompoundTag(newSeq[byte](0))
  chk(not empty.isOk and empty.error.kind == nekIncomplete, "empty input is an error")
  var body = pyBytes()
  body[10] = 0xFF'u8
  let b = readGzipCompoundTag(body)
  chk(not b.isOk and b.error.msg == "NBT reading was cut short: corrupt deflate stream", "bad deflate: " & b.error.msg)

proc decompressCap() =
  # 65 MiB of zeros: `take` hands back exactly 64 MiB, with no error of its own.
  let raw = newSeq[byte](65 * 1024 * 1024)
  let c = gzipCompressBytes(raw)
  chk(c.ok, "cap: compress")
  let d = gzipDecompressBytes(c.data, MaxDecompressedSize)
  chk(d.ok and d.data.len == 64 * 1024 * 1024, "cap: exactly 64 MiB, got " & $d.data.len)
  let read = readGzipCompoundTag(c.data)
  chk(not read.isOk and read.error.kind == nekNoRootCompound and
    read.error.msg == "The root tag of the NBT file is not a compound tag. Received tag id: 0", "cap: read fails on content")

proc capTruncatesNbt() =
  let chunk = newSeq[int8](1_500_000)
  var under = newCompound()
  for i in 0 ..< 42:
    under.put("chunk" & $i, nbtTag(chunk))
  var buffer = newSeq[byte](0)
  chk(writeGzipCompoundTag(under, buffer).isOk, "cap nbt: compress")
  let read = readGzipCompoundTag(buffer)
  chk(read.isOk and read.value.len == 42, "under the cap reads whole")
  # Over the cap, the cut lands inside an array, where EOF is an error.
  var over = under
  for i in 42 ..< 45:
    over.put("chunk" & $i, nbtTag(chunk))
  var buffer2 = newSeq[byte](0)
  chk(writeGzipCompoundTag(over, buffer2).isOk, "cap nbt over: compress")
  let cut = readGzipCompoundTag(buffer2)
  chk(not cut.isOk and cut.error.kind == nekIncomplete and cut.error.unexpectedEof, "over the cap is cut short")

gzipReadWriteCompound()
gzipConvenienceMethods()
gzipEmptyCompound()
gzipLargeCompound()
gzipSerializeDeserialize()
gzipCompressionRatio()
gzipInvalidData()
roundtripWithArrays()
roundtripWithMap()
directFileIo()
knownAnswerDecompress()
corruptStreams()
decompressCap()
capTruncatesNbt()

if failures > 0:
  echo $failures & " gzip checks FAILED"
  quit(1)
echo "gzip NBT checks: OK"
