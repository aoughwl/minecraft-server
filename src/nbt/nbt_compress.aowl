## Reading and writing gzip-compressed NBT.
## Port of pumpkin-nbt/src/nbt_compress.rs
##
## Gzip comes from zlibgz.aowl, linked statically on Windows; gziptest.aowl runs it here. Compressed bytes
## differ from upstream's flate2 output with the miniz_oxide backend, while the header matches. As upstream:
## decompressed data is cut off at 64 MiB with no error of its own, and trailing bytes after the first
## gzip member are ignored.
##
## `impl Read`/`impl Write` become a byte buffer or a File. The original `writeGzipCompoundTag(compound)`
## returning the bytes stays, the same as `writeGzipCompoundTagToBytes`.

{.feature: "untyped".}

import std/syncio
import nbtbase, nbtdoc, tag, deserializer
import serde_ser, serde_de
import zlibgz

const MaxDecompressedSize* = 64 * 1024 * 1024

proc gunzip(input: openArray[byte], output: var seq[byte]): NbtVoidResult =
  let d = gzipDecompressBytes(input, MaxDecompressedSize)
  if not d.ok:
    return errVoid(incomplete(d.msg))
  output = d.data
  okVoid()

proc gzip(input: openArray[byte], output: var seq[byte]): NbtVoidResult =
  let c = gzipCompressBytes(input)
  if not c.ok:
    return errVoid(incomplete(c.msg))
  addAll(output, c.data)
  okVoid()

proc readWholeFile(f: File, output: var seq[byte]): NbtVoidResult =
  var chunk = newSeq[byte](65536)
  while true:
    let n = readBuffer(f, addr chunk[0], chunk.len)
    if n <= 0:
      return okVoid()
    for i in 0 ..< n:
      output.add chunk[i]

proc readGzipCompoundTag*(input: seq[byte]): NbtResult[NbtCompound] =
  ## A gzip-compressed, named NBT compound.
  var buf = newSeq[byte](0)
  let d = gunzip(input, buf)
  if not d.isOk:
    return errRes[NbtCompound](d.error)
  var reader = newNbtReader(nrmJava, buf)
  let nbtRes = read(reader)
  if not nbtRes.isOk:
    return errRes[NbtCompound](nbtRes.error)
  ok[NbtCompound](nbtRes.value.rootTag)

proc readGzipCompoundTag*(input: File): NbtResult[NbtCompound] =
  var raw = newSeq[byte](0)
  let r = readWholeFile(input, raw)
  if not r.isOk:
    return errRes[NbtCompound](r.error)
  readGzipCompoundTag(raw)

proc writeGzipCompoundTag*(compound: sink NbtCompound, output: var seq[byte]): NbtVoidResult =
  ## The root name is written as an empty string.
  gzip(write(newNbt("", compound)), output)

proc writeGzipCompoundTag*(compound: sink NbtCompound, output: File): NbtVoidResult =
  var buf = newSeq[byte](0)
  let r = writeGzipCompoundTag(compound, buf)
  if not r.isOk:
    return r
  writeBytesTo(buf, output)

proc writeGzipCompoundTagToBytes*(compound: sink NbtCompound): NbtResult[seq[byte]] =
  var buf = newSeq[byte](0)
  let r = writeGzipCompoundTag(compound, buf)
  if not r.isOk:
    return errRes[seq[byte]](r.error)
  ok[seq[byte]](buf)

proc writeGzipCompoundTag*(compound: sink NbtCompound): NbtResult[seq[byte]] =
  writeGzipCompoundTagToBytes(compound)

proc fromGzipBytes*[T](input: seq[byte]): NbtResult[T] =
  ## A value from gzip-compressed, named Java Edition NBT.
  var buf = newSeq[byte](0)
  let d = gunzip(input, buf)
  if not d.isOk:
    return errRes[T](d.error)
  fromBytes[T](buf)

proc toGzipBytes*[T](value: T, output: var seq[byte]): NbtVoidResult =
  ## The root name is written as an empty string.
  var raw = newSeq[byte](0)
  let r = toBytes(value, raw)
  if not r.isOk:
    return r
  gzip(raw, output)

proc toGzipBytesVec*[T](value: T): NbtResult[seq[byte]] =
  var buf = newSeq[byte](0)
  let r = toGzipBytes(value, buf)
  if not r.isOk:
    return errRes[seq[byte]](r.error)
  ok[seq[byte]](buf)
