## Known answers for nbt_ops.aowl, with upstream's `list_collecting` test and those from pumpkin-util's position.rs.

{.feature: "untyped".}

import std/syncio
import tag, nbt_ops
import codecs/codec_core
import codecs/json_ops

var failures = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc checkEq(a, b: string, what: string) =
  if a != b:
    echo "FAIL ", what, ": got [", a, "] want [", b, "]"
    inc failures

proc checkTag(a, b: NbtTag, what: string) =
  if not (a == b):
    echo "FAIL ", what, ": got [", $(a), "] want [", $(b), "]"
    inc failures

proc tEnd(): NbtTag = NbtTag(kind: ntkEnd)
proc tByte(v: int8): NbtTag = NbtTag(kind: ntkByte, byteVal: v)
proc tShort(v: int16): NbtTag = NbtTag(kind: ntkShort, shortVal: v)
proc tInt(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)
proc tLong(v: int64): NbtTag = NbtTag(kind: ntkLong, longVal: v)
proc tFloat(v: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: v)
proc tDouble(v: float64): NbtTag = NbtTag(kind: ntkDouble, doubleVal: v)
proc tStr(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)
proc tList(v: seq[NbtTag]): NbtTag = NbtTag(kind: ntkList, listVal: v)
proc tBytes(v: seq[int8]): NbtTag = NbtTag(kind: ntkByteArray, byteArrayVal: v)
proc tInts(v: seq[int32]): NbtTag = NbtTag(kind: ntkIntArray, intArrayVal: v)
proc tLongs(v: seq[int64]): NbtTag = NbtTag(kind: ntkLongArray, longArrayVal: v)
proc tMap(names: seq[string], vals: seq[NbtTag]): NbtTag =
  var c = newCompound()
  for i in 0 ..< names.len: c.put(names[i], vals[i])
  NbtTag(kind: ntkCompound, compoundVal: c)

proc listCollecting() =
  # Int list collector
  checkTag(toResult(newListCollector(tInts(@[10'i32, 15, 20])).get), tInts(@[10'i32, 15, 20]), "int collector")
  # Byte list collector
  checkTag(toResult(newListCollector(tBytes(@[-1'i8, 45, 100])).get), tBytes(@[-1'i8, 45, 100]), "byte collector")
  # Long list
  checkTag(toResult(newListCollector(tLongs(@[11_234_567_890'i64, -986, 1, -937_238_122])).get),
           tLongs(@[11_234_567_890'i64, -986, 1, -937_238_122]), "long collector")
  # Generic, homogeneous
  var c = newCollector()
  c = accept(c, tFloat(-123.4'f32))
  c = accept(c, tFloat(12.5'f32))
  checkTag(toResult(c), tList(@[tFloat(-123.4'f32), tFloat(12.5'f32)]), "generic homogeneous")
  # Generic, heterogeneous
  var h = newCollector()
  h = accept(h, tByte(99))
  h = accept(h, tStr("99"))
  h = accept(h, tLongs(@[1'i64, 2, 3]))
  checkTag(toResult(h), tList(@[tByte(99), tStr("99"), tLongs(@[1'i64, 2, 3])]), "generic heterogeneous")
  # Array collectors stay arrays for their own element and widen for another.
  checkTag(toResult(accept(newListCollector(tInts(@[1'i32])).get, tInt(2))), tInts(@[1'i32, 2]), "int stays")
  checkTag(toResult(accept(newListCollector(tInts(@[1'i32])).get, tByte(2))), tList(@[tInt(1), tByte(2)]), "int widens")
  checkTag(toResult(accept(newListCollector(tBytes(@[1'i8])).get, tByte(2))), tBytes(@[1'i8, 2]), "byte stays")
  checkTag(toResult(accept(newListCollector(tBytes(@[1'i8])).get, tInt(2))), tList(@[tByte(1), tInt(2)]), "byte widens")
  checkTag(toResult(accept(newListCollector(tLongs(@[1'i64])).get, tLong(2))), tLongs(@[1'i64, 2]), "long stays")
  checkTag(toResult(accept(newListCollector(tLongs(@[1'i64])).get, tInt(2))), tList(@[tLong(1), tInt(2)]), "long widens")
  # Empty lists, End, and tags with no collector.
  checkTag(toResult(newListCollector(tInts(@[])).get), tList(@[]), "empty int array collects as list")
  checkTag(toResult(newListCollector(tEnd()).get), tList(@[]), "end collector")
  check(newListCollector(tInt(1)).isNone, "int has no collector")

proc display() =
  checkEq($(tEnd()), "", "display end")
  checkEq($(tByte(1)), "1b", "display byte")
  checkEq($(tShort(2)), "2s", "display short")
  checkEq($(tInt(3)), "3", "display int")
  checkEq($(tLong(4)), "4L", "display long")
  checkEq($(tFloat(1.5'f32)), "1.5f", "display float")
  checkEq($(tFloat(2.0'f32)), "2f", "display whole float")
  checkEq($(tDouble(2.5)), "2.5d", "display double")
  checkEq($(tStr("hi")), "\"hi\"", "display string")
  checkEq($(tBytes(@[1'i8, -2])), "[B; 1b, -2b]", "display byte array")
  checkEq($(tInts(@[1'i32, -2])), "[I; 1, -2]", "display int array")
  checkEq($(tLongs(@[1'i64, -2])), "[L; 1L, -2L]", "display long array")
  checkEq($(tList(@[tInt(1), tStr("a")])), "[1, \"a\"]", "display list")
  checkEq($(tMap(@["a", "b"], @[tInt(1), tByte(2)])), "{a: 1, b: 2b}", "display compound")

  checkEq(nbtDebug(tEnd()), "End", "debug end")
  checkEq(nbtDebug(tFloat(1.0'f32)), "Float(1.0)", "debug float")
  checkEq(nbtDebug(tDouble(1e16)), "Double(1e16)", "debug large double")
  checkEq(nbtDebug(tDouble(1.5e-5)), "Double(1.5e-5)", "debug small double")
  checkEq(nbtDebug(tStr("a\"b")), "String(\"a\\\"b\")", "debug string")
  checkEq(nbtDebug(tList(@[tInt(1), tLong(2)])), "List([Int(1), Long(2)])", "debug list")
  checkEq(nbtDebug(tMap(@["a"], @[tInt(1)])), "Compound(NbtCompound { child_tags: {\"a\": Int(1)} })", "debug compound")

  check(tMap(@["a", "b"], @[tInt(1), tInt(2)]) == tMap(@["b", "a"], @[tInt(2), tInt(1)]), "compound compares as a map")
  check(not (tMap(@["a"], @[tInt(1)]) == tMap(@["a"], @[tInt(2)])), "compound differs")

proc ops1() =
  let ops = nbtOps()
  checkTag(ops.empty(), tEnd(), "empty")
  checkTag(ops.emptyList(), tList(@[]), "emptyList")
  checkTag(ops.emptyMap(), tMap(@[], @[]), "emptyMap")
  # Upstream's create_number always makes a double.
  checkTag(ops.createNumber(numberInt(3)), tDouble(3.0), "createNumber")
  checkTag(ops.createByte(1), tByte(1), "createByte")
  checkTag(ops.createShort(1), tShort(1), "createShort")
  checkTag(ops.createInt(1), tInt(1), "createInt")
  checkTag(ops.createLong(1), tLong(1), "createLong")
  checkTag(ops.createFloat(1.5'f32), tFloat(1.5'f32), "createFloat")
  checkTag(ops.createDouble(1.5), tDouble(1.5), "createDouble")
  checkTag(ops.createBool(true), tByte(1), "createBool true")
  checkTag(ops.createBool(false), tByte(0), "createBool false")
  checkTag(ops.createString("s"), tStr("s"), "createString")
  checkTag(ops.createList(@[tInt(1), tInt(2)]), tList(@[tInt(1), tInt(2)]), "createList")
  checkTag(ops.createByteList(@[1'i8]), tBytes(@[1'i8]), "createByteList")
  checkTag(ops.createIntList(@[1'i32]), tInts(@[1'i32]), "createIntList")
  checkTag(ops.createLongList(@[1'i64]), tLongs(@[1'i64]), "createLongList")
  checkTag(ops.createMap(@[(tStr("a"), tInt(1)), (tInt(9), tInt(2))]), tMap(@["a"], @[tInt(1)]), "createMap skips a bad key")

  check(ops.getBool(tByte(1)).unwrap == true, "getBool byte")
  check(ops.getBool(tDouble(0.0)).unwrap == false, "getBool double")
  checkEq(ops.getBool(tStr("x")).message, "Not a number", "getBool error")
  check(ops.getNumber(tShort(5)).unwrap == numberShort(5), "getNumber")
  checkEq(ops.getNumber(tStr("x")).message, "Not a number", "getNumber error")
  check(ops.getString(tStr("x")).unwrap == "x", "getString")
  checkEq(ops.getString(tInt(1)).message, "Not a string", "getString error")

  checkEq(ops.getMapIter(tInt(1)).message, "Not a map: 1", "getMapIter error")
  check(ops.getMapIter(tMap(@["a"], @[tInt(1)])).unwrap.len == 1, "getMapIter")
  checkEq(ops.getMap(tEnd()).message, "Not a map: ", "getMap error")
  let m = ops.getMap(tMap(@["a"], @[tInt(1)])).unwrap
  checkTag(m.getStr("a").get, tInt(1), "MapLike getStr")
  checkTag(get(m, tStr("a")).get, tInt(1), "MapLike get")
  check(get(m, tInt(1)).isNone, "MapLike get bad key")
  check(m.getStr("z").isNone, "MapLike get absent")
  checkTag(m.iter()[0][0], tStr("a"), "MapLike iter key")

  # get_iter
  checkEq(ops.getIter(tInt(1)).message, "Not a list: 1", "getIter error")
  let wrapped = tList(@[tMap(@[""], @[tInt(1)]), tMap(@["a"], @[tInt(2)]), tInt(3)])
  let unwrapped = ops.getIter(wrapped).unwrap
  checkTag(unwrapped[0], tInt(1), "getIter unwraps")
  checkTag(unwrapped[1], tMap(@["a"], @[tInt(2)]), "getIter keeps")
  checkTag(unwrapped[2], tInt(3), "getIter keeps non-compound")
  checkTag(ops.getIter(tBytes(@[1'i8])).unwrap[0], tByte(1), "getIter bytes")
  checkTag(ops.getIter(tInts(@[1'i32])).unwrap[0], tInt(1), "getIter ints")
  checkTag(ops.getIter(tLongs(@[1'i64])).unwrap[0], tLong(1), "getIter longs")

  # typed lists
  check(ops.getByteList(tBytes(@[1'i8])).unwrap == @[1'i8], "getByteList array")
  check(ops.getByteList(tList(@[tInt(300)])).unwrap == @[44'i8], "getByteList narrows")
  checkEq(ops.getByteList(tList(@[tStr("x")])).message, "Some elements are not bytes", "getByteList error")
  check(ops.getIntList(tInts(@[1'i32])).unwrap == @[1'i32], "getIntList array")
  check(ops.getIntList(tList(@[tFloat(2.5'f32)])).unwrap == @[2'i32], "getIntList truncates")
  checkEq(ops.getIntList(tList(@[tStr("x")])).message, "Some elements are not ints", "getIntList error")
  check(ops.getLongList(tLongs(@[1'i64])).unwrap == @[1'i64], "getLongList array")
  checkEq(ops.getLongList(tList(@[tStr("x")])).message, "Some elements are not longs", "getLongList error")

  # merges
  checkTag(ops.mergeIntoList(tEnd(), tInt(1)).unwrap, tList(@[tInt(1)]), "mergeIntoList end")
  checkTag(ops.mergeIntoList(tInts(@[1'i32]), tInt(2)).unwrap, tInts(@[1'i32, 2]), "mergeIntoList array")
  let notList = ops.mergeIntoList(tInt(1), tInt(2))
  checkEq(notList.message, "Not a list", "mergeIntoList error")
  checkTag(notList.unwrapOrPartial, tInt(1), "mergeIntoList partial")
  checkTag(ops.mergeValuesIntoList(tList(@[tInt(1)]), @[tInt(2), tByte(3)]).unwrap, tList(@[tInt(1), tInt(2), tByte(3)]), "mergeValuesIntoList")
  checkEq(ops.mergeValuesIntoList(tInt(1), @[tInt(2)]).message, "Not a list", "mergeValuesIntoList error")

  checkTag(ops.mergeIntoMap(tEnd(), tStr("a"), tInt(1)).unwrap, tMap(@["a"], @[tInt(1)]), "mergeIntoMap end")
  # compound.put keeps the first value, upstream's behaviour.
  checkTag(ops.mergeIntoMap(tMap(@["a"], @[tInt(1)]), tStr("a"), tInt(2)).unwrap, tMap(@["a"], @[tInt(1)]), "mergeIntoMap keeps the first value")
  checkEq(ops.mergeIntoMap(tInt(1), tStr("a"), tInt(1)).message, "Not a map: 1", "mergeIntoMap not map")
  let badKey = ops.mergeIntoMap(tEnd(), tInt(5), tInt(1))
  checkEq(badKey.message, "Key is not a string: 5", "mergeIntoMap bad key")
  checkTag(badKey.unwrapOrPartial, tEnd(), "mergeIntoMap bad key partial")

  var ml = newMapLike[NbtTag]()
  ml.addNamed("a", tStr("a"), tInt(1))
  checkTag(ops.mergeMapLikeIntoMap(tEnd(), ml).unwrap, tMap(@["a"], @[tInt(1)]), "mergeMapLikeIntoMap")
  checkEq(ops.mergeMapLikeIntoMap(tInt(1), ml).message, "Not a map: 1", "mergeMapLikeIntoMap not map")
  ml.addUnnamed(tInt(9), tLong(2))
  let mlBad = ops.mergeMapLikeIntoMap(tEnd(), ml)
  checkEq(mlBad.message, "Some keys are not strings: [(Int(9), Long(2))]", "mergeMapLikeIntoMap bad key")
  checkTag(mlBad.unwrapOrPartial, tMap(@["a"], @[tInt(1)]), "mergeMapLikeIntoMap partial")

  checkTag(ops.remove(tMap(@["a", "b"], @[tInt(1), tInt(2)]), "a"), tMap(@["b"], @[tInt(2)]), "remove")
  checkTag(ops.remove(tInt(1), "a"), tInt(1), "remove non-map")

  # default methods
  checkTag(mergeEntriesIntoMap(ops, tEnd(), @[(tStr("a"), tInt(1)), (tStr("b"), tInt(2))]).unwrap, tMap(@["a", "b"], @[tInt(1), tInt(2)]), "mergeEntriesIntoMap")
  checkEq(mergeIntoPrimitive(ops, tInt(1), tInt(2)).message, "Do not know how to append a primitive value 2 to 1", "mergeIntoPrimitive")
  checkTag(mergeIntoPrimitive(ops, tEnd(), tInt(2)).unwrap, tInt(2), "mergeIntoPrimitive empty")
  checkTag(getElement(ops, tMap(@["a"], @[tInt(1)]), "a").unwrap, tInt(1), "getElement")
  checkEq(getElement(ops, tMap(@["a"], @[tInt(1)]), "z").message, "No element \"z\" in the map", "getElement absent")
  checkEq(getElement(ops, tInt(1), "z").message, "Not a map: 1", "getElement not a map")
  checkTag(setElement(ops, tMap(@[], @[]), "a", tInt(1)), tMap(@["a"], @[tInt(1)]), "setElement")
  checkTag(setElement(ops, tInt(1), "a", tInt(1)), tInt(1), "setElement non-map")
  let inc1 = proc (v: NbtTag): NbtTag {.closure.} = tInt(v.intVal + 1)
  checkTag(updateElement(ops, tMap(@["a"], @[tInt(1)]), "a", inc1), tMap(@["a"], @[tInt(1)]), "updateElement on NBT keeps the first value")
  checkTag(updateElement(ops, tMap(@["a"], @[tInt(1)]), "z", inc1), tMap(@["a"], @[tInt(1)]), "updateElement absent")
  checkTag(updateElementGeneric(ops, tMap(@["a"], @[tInt(1)]), tStr("a"), inc1), tMap(@["a"], @[tInt(1)]), "updateElementGeneric on NBT")

  # struct builder
  var b = ops.mapBuilder()
  b = addStringKeyValue(b, "a", tInt(1))
  b = addStringKeyValueResult(b, "b", newSuccess(tInt(2)))
  b = addKeyValue(b, tStr("c"), tInt(3))
  b = addKeyValueResult(b, tStr("d"), newSuccess(tInt(4)))
  b = addKeyResultValueResult(b, newSuccess(tStr("e")), newSuccess(tInt(5)))
  checkTag(build(b, tEnd()).unwrap,
           tMap(@["a", "b", "c", "d", "e"], @[tInt(1), tInt(2), tInt(3), tInt(4), tInt(5)]), "struct builder")
  var pb = addStringKeyValue(ops.mapBuilder(), "x", tInt(1))
  checkTag(build(pb, tMap(@["y"], @[tInt(2)])).unwrap, tMap(@["y", "x"], @[tInt(2), tInt(1)]), "build merges into prefix")
  let notMap = build(pb, tInt(9))
  checkEq(notMap.message, "Prefix is not a map: 9", "build with bad prefix")
  checkTag(notMap.unwrapOrPartial, tInt(9), "build with bad prefix partial")

  # Primitive encoding chooses the array and single tags.
  checkTag(encodeStart(intStream(@[1'i32, 2, 3]), ops).unwrap, tInts(@[1'i32, 2, 3]), "encode IntStream")
  checkTag(encodeStart(byteBuffer(@[1'i8]), ops).unwrap, tBytes(@[1'i8]), "encode ByteBuffer")
  checkTag(encodeStart(longStream(@[1'i64]), ops).unwrap, tLongs(@[1'i64]), "encode LongStream")
  checkTag(encodeStart(true, ops).unwrap, tByte(1), "encode bool")
  checkTag(encodeStart(1.5'f32, ops).unwrap, tFloat(1.5'f32), "encode float")
  check(parse(int32, tByte(4), ops).unwrap == 4'i32, "decode int from byte")
  check(parse(bool, tByte(4), ops).unwrap == true, "decode bool")

proc convert() =
  let nbt = nbtOps()
  let json = jsonOps()
  # NBT to JSON: the numbers keep their value, arrays become arrays, compounds become objects.
  let t = tMap(@["b", "a", "l", "ia", "s", "d", "bytes", "longs", "e"],
               @[tByte(1), tFloat(1.5'f32), tList(@[tInt(1), tStr("x")]), tInts(@[1'i32, 2]), tStr("str"), tDouble(0.25),
                 tBytes(@[3'i8]), tLongs(@[4'i64]), tEnd()])
  checkEq($convertTo(nbt, json, t),
    """{"a":1.5,"b":1,"bytes":[3],"d":0.25,"e":null,"ia":[1,2],"l":[1,"x"],"longs":[4],"s":"str"}""", "nbt to json")
  # JSON to NBT: the narrowest integer, float if it survives.
  let parsed = parseJsonValue("""{"a":1,"b":300,"c":70000,"d":5000000000,"e":1.5,"f":0.1,"g":true,"h":null,"i":[1,"x"],"j":"s"}""")
  checkTag(convertTo(json, nbt, parsed.value),
    tMap(@["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"],
         @[tByte(1), tShort(300), tInt(70000), tLong(5000000000'i64), tFloat(1.5'f32), tDouble(0.1), tByte(1), tEnd(),
           tList(@[tByte(1), tStr("x")]), tStr("s")]), "json to nbt")
  # Same format.
  checkTag(convertTo(nbt, nbt, t), t, "nbt to nbt")
  let same = convertTo(json, json, parsed.value)
  checkEq($same, """{"a":1,"b":300,"c":70000,"d":5000000000,"e":1.5,"f":0.1,"g":true,"h":null,"i":[1,"x"],"j":"s"}""", "json to json")
  # Non-container input to convertList yields an empty list, as upstream's flatten does.
  checkTag(convertList(json, nbt, jsonBool(true)), tList(@[]), "convertList on a non-list")
  checkTag(convertMap(json, nbt, jsonBool(true)), tMap(@[], @[]), "convertMap on a non-map")

listCollecting()
display()
ops1()
convert()
if failures > 0:
  echo failures, " failures"
  quit(1)
echo "nbt_opstest ok"
