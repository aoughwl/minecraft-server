## A complete NBT document: a named root compound, with its top-level read and write entry points.
## Port of pumpkin-nbt/src/lib.rs (`Nbt`; constants and `Error` are in nbtbase.aowl, the tests in nbttest.aowl).
##
## `write` with a mode stands in for `write` and `write_bedrock`; both spellings exist. A buffer writer
## cannot fail except on an over-long string, where upstream's `unwrap` panics; here the bytes so far come
## back, because there is no raise at a boundary.

import std/syncio
import nbtbase, serializer, deserializer, tag

type
  Nbt* = object
    name*: string
    rootTag*: NbtCompound

proc newNbt*(name: string, tag: sink NbtCompound): Nbt =
  Nbt(name: name, rootTag: tag)

proc toNbtDoc*(value: sink NbtCompound): Nbt =
  ## From<NbtCompound> for Nbt.
  Nbt(name: "", rootTag: value)

proc toCompound*(value: sink Nbt): NbtCompound =
  ## From<Nbt> for NbtCompound.
  value.rootTag

proc `==`*(a, b: Nbt): bool =
  a.name == b.name and a.rootTag == b.rootTag

proc read*(r: var NbtReader): NbtResult[Nbt] =
  ## Reads a named document. `noRootCompound` if the first tag is not a compound.
  let idRes = getU8(r)
  if not idRes.isOk:
    return errRes[Nbt](idRes.error)
  if idRes.value != CompoundId:
    return errRes[Nbt](noRootCompound(idRes.value))
  let nameRes = getString(r)
  if not nameRes.isOk:
    return errRes[Nbt](nameRes.error)
  let contentRes = deserializeContent(r)
  if not contentRes.isOk:
    return errRes[Nbt](contentRes.error)
  ok[Nbt](Nbt(name: nameRes.value, rootTag: contentRes.value))

proc readUnnamed*(r: var NbtReader): NbtResult[Nbt] =
  ## Reads a document that omits the root compound's name; `name` comes back empty.
  let idRes = getU8(r)
  if not idRes.isOk:
    return errRes[Nbt](idRes.error)
  if idRes.value != CompoundId:
    return errRes[Nbt](noRootCompound(idRes.value))
  let contentRes = deserializeContent(r)
  if not contentRes.isOk:
    return errRes[Nbt](contentRes.error)
  ok[Nbt](Nbt(name: "", rootTag: contentRes.value))

proc write*(doc: Nbt, mode: NbtWriteMode): seq[byte] =
  var w = newNbtWriter(mode)
  w.writeU8(CompoundId)
  let nameRes = w.writeString(doc.name)
  if nameRes.isOk:
    discard serializeContent(doc.rootTag, w)
  w.buf

proc write*(doc: Nbt): seq[byte] =
  ## The Java Edition representation.
  write(doc, nwmJava)

proc writeBedrock*(doc: Nbt): seq[byte] =
  ## The Bedrock network representation.
  write(doc, nwmBedrock)

proc writeUnnamed*(doc: Nbt, mode: NbtWriteMode): seq[byte] =
  var w = newNbtWriter(mode)
  w.writeU8(CompoundId)
  discard serializeContent(doc.rootTag, w)
  w.buf

proc writeUnnamed*(doc: Nbt): seq[byte] =
  writeUnnamed(doc, nwmJava)

proc writeBytesTo*(data: seq[byte], f: File): NbtVoidResult =
  ## `write_all` on a File.
  if data.len > 0 and writeBuffer(f, unsafeAddr data[0], data.len) != data.len:
    return errVoid(incomplete("failed to write whole buffer"))
  okVoid()

proc writeToWriter*(doc: Nbt, w: var seq[byte]) =
  addAll(w, write(doc))

proc writeToWriter*(doc: Nbt, f: File): NbtVoidResult =
  writeBytesTo(write(doc), f)

proc writeToWriterBedrock*(doc: Nbt, w: var seq[byte]) =
  addAll(w, writeBedrock(doc))

proc writeToWriterBedrock*(doc: Nbt, f: File): NbtVoidResult =
  writeBytesTo(writeBedrock(doc), f)

proc writeUnnamedToWriter*(doc: Nbt, w: var seq[byte]) =
  addAll(w, writeUnnamed(doc))

proc writeUnnamedToWriter*(doc: Nbt, f: File): NbtVoidResult =
  writeBytesTo(writeUnnamed(doc), f)
