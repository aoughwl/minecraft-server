## Known-answer checks for pumpkin-nbt/src/lib.rs: every #[test] of its `mod test`. Upstream's round trips
## also assert the exact bytes here; the expected hex was produced by a separate script from the wire
## format, not by this port. The Nbt document type is checked at the end.

{.feature: "untyped".}

import std/[syncio, options]
import tag, serializer, deserializer, nbtbase, nbtdoc, serde_ser, serde_de

var failures = 0

proc chk(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failures

proc hexVal(c: char): uint8 =
  if c >= '0' and c <= '9': uint8(ord(c) - ord('0'))
  else: uint8(ord(c) - ord('A') + 10)

proc hexBytes(s: string): seq[byte] =
  result = newSeq[byte](s.len div 2)
  for i in 0 ..< result.len:
    result[i] = (hexVal(s[2 * i]) shl 4) or hexVal(s[2 * i + 1])

const
  testUnnamed = "0A010004627974657B02000573686F7274053E030003696E74000010D90400046C6F6E670000000000000022050005666C6F61743F800000080006737472696E67000A48656C6C6F207465737400"
  testNamed = "0A000454657374010004627974657B02000573686F7274053E030003696E74000010D90400046C6F6E670000000000000022050005666C6F61743F800000080006737472696E67000A48656C6C6F207465737400"
  testBedrock = "0A000104627974657B020573686F72743E050303696E74B24304046C6F6E67440505666C6F61740000803F0806737472696E670A48656C6C6F207465737400"
  testNamedBedrock = "0A04546573740104627974657B020573686F72743E050303696E74B24304046C6F6E67440505666C6F61740000803F0806737472696E670A48656C6C6F207465737400"
  arrUnnamed = "0A07000A627974655F6172726179000000030003020B0009696E745F6172726179000000030000000D00000529000000020C000A6C6F6E675F617272617900000004000000000000000100000000000000000000000000030E6D000000000000000100"
  arrBedrock = "0A00070A627974655F6172726179060003020B09696E745F6172726179061AD214040C0A6C6F6E675F6172726179080200DAB9180200"
  arrNamed = "0A00045465737407000A627974655F6172726179000000030003020B0009696E745F6172726179000000030000000D00000529000000020C000A6C6F6E675F617272617900000004000000000000000100000000000000000000000000030E6D000000000000000100"
  arrNamedBedrock = "0A0454657374070A627974655F6172726179060003020B09696E745F6172726179061AD214040C0A6C6F6E675F6172726179080200DAB9180200"
  listUnnamed = ""
  listBedrock = ""
  listNamed = ""
  listNamedBedrock = ""
  tupleOkJava = "0A0000090001780300000002000000010000000200"
  tupleOkBedrock = "0A000901780304020400"

type
  Test = object
    byte: int8
    short: int16
    int: int32
    long: int64
    float: float32
    string: string

  BorrowedTest = object
    byte: int8
    string: string

  TestArray = object
    byte_array: NbtByteArray[seq[uint8]]
    int_array: NbtIntArray[seq[int32]]
    long_array: NbtLongArray[seq[int64]]

  Egg = object
    food: string

  Breakfast = object
    food: Egg

  TestList = object
    option: Option[Egg]
    nested_compound: Breakfast
    compounds: seq[Test]
    list_string: seq[string]
    empty: seq[Test]

  Tagged = object
    l: NbtLongArray[array[1, int64]]
    i: NbtIntArray[array[1, int32]]
    b: NbtByteArray[array[1, uint8]]

  NotTagged = object
    l: array[1, int64]
    i: array[1, int32]
    b: array[1, uint8]

  BadData = object
    x: (int32, int64)

  GoodData = object
    x: (int32, int32)

proc same(a, b: Test): bool =
  a.byte == b.byte and a.short == b.short and a.int == b.int and a.long == b.long and
    a.float == b.float and a.string == b.string

proc same(a, b: TestArray): bool =
  a.byte_array.items == b.byte_array.items and a.int_array.items == b.int_array.items and
    a.long_array.items == b.long_array.items

proc same(a, b: TestList): bool =
  if a.option.isSome != b.option.isSome: return false
  if a.option.isSome and a.option.unsafeGet.food != b.option.unsafeGet.food: return false
  if a.nested_compound.food.food != b.nested_compound.food.food: return false
  if a.compounds.len != b.compounds.len or a.empty.len != b.empty.len: return false
  for i in 0 ..< a.compounds.len:
    if not same(a.compounds[i], b.compounds[i]): return false
  a.list_string == b.list_string

proc sampleTest(s: string): Test =
  Test(byte: 123'i8, short: 1342'i16, int: 4313'i32, long: 34'i64, float: 1.0'f32, string: s)

proc sampleArray(): TestArray =
  TestArray(byte_array: nbtByteArray(@[0'u8, 3'u8, 2'u8]),
    int_array: nbtIntArray(@[13'i32, 1321'i32, 2'i32]),
    long_array: nbtLongArray(@[1'i64, 0'i64, 200301'i64, 1'i64]))

proc sampleList(withOption: bool): TestList =
  let test1 = sampleTest("Hello test")
  let test2 = Test(byte: 13'i8, short: 342'i16, int: -4313'i32, long: -132334'i64,
    float: -69.420'f32, string: "Hello compounds")
  TestList(
    option: (if withOption: some(Egg(food: "Skibid")) else: none[Egg]()),
    nested_compound: Breakfast(food: Egg(food: "Over easy")),
    compounds: @[test1, test2],
    list_string: @["", "abcbcbcbbc"],
    empty: newSeq[Test](0))

# --- the tests of lib.rs ------------------------------------------------------

proc zeroAllocFromSlice() =
  var bytes = newSeq[byte](0)
  chk(toBytesUnnamed(sampleTest("Zero alloc NBT"), bytes).isOk, "zero_alloc_from_slice: write")
  let borrowed = fromSliceUnnamed[BorrowedTest](bytes)
  chk(borrowed.isOk, "zero_alloc_from_slice: read " & (if borrowed.isOk: "" else: borrowed.error.msg))
  chk(borrowed.value.byte == 123'i8, "zero_alloc_from_slice: byte")
  chk(borrowed.value.string == "Zero alloc NBT", "zero_alloc_from_slice: string")

proc simpleSerDeUnnamed() =
  let test = sampleTest("Hello test")
  var bytes = newSeq[byte](0)
  chk(toBytesUnnamed(test, bytes).isOk, "simple_ser_de_unnamed: write")
  chk(bytes == hexBytes(testUnnamed), "simple_ser_de_unnamed: bytes")
  let re = fromBytesUnnamed[Test](bytes)
  chk(re.isOk and same(test, re.value), "simple_ser_de_unnamed: read")

proc simpleSerDeUnnamedBedrock() =
  let test = sampleTest("Hello test")
  var bytes = newSeq[byte](0)
  chk(toBytesBedrock(test, bytes).isOk, "simple_ser_de_unnamed_bedrock: write")
  chk(bytes == hexBytes(testBedrock), "simple_ser_de_unnamed_bedrock: bytes")
  let re = fromBytesBedrock[Test](bytes)
  chk(re.isOk and same(test, re.value), "simple_ser_de_unnamed_bedrock: read")

proc simpleSerDeArray() =
  var bytes = newSeq[byte](0)
  chk(toBytesUnnamed(sampleArray(), bytes).isOk, "simple_ser_de_array: write")
  chk(bytes == hexBytes(arrUnnamed), "simple_ser_de_array: bytes")
  let re = fromBytesUnnamed[TestArray](bytes)
  chk(re.isOk and same(sampleArray(), re.value), "simple_ser_de_array: read")

proc simpleSerDeArrayBedrock() =
  var bytes = newSeq[byte](0)
  chk(toBytesBedrock(sampleArray(), bytes).isOk, "simple_ser_de_array_bedrock: write")
  chk(bytes == hexBytes(arrBedrock), "simple_ser_de_array_bedrock: bytes")
  let re = fromBytesBedrock[TestArray](bytes)
  chk(re.isOk and same(sampleArray(), re.value), "simple_ser_de_array_bedrock: read")

proc simpleSerDeNamed() =
  let test = sampleTest("Hello test")
  var bytes = newSeq[byte](0)
  chk(toBytesNamed(test, "Test", bytes).isOk, "simple_ser_de_named: write")
  chk(bytes == hexBytes(testNamed), "simple_ser_de_named: bytes")
  let re = fromBytes[Test](bytes)
  chk(re.isOk and same(test, re.value), "simple_ser_de_named: read")

proc simpleSerDeNamedBedrock() =
  let test = sampleTest("Hello test")
  var bytes = newSeq[byte](0)
  chk(toBytesNamedBedrock(test, "Test", bytes).isOk, "simple_ser_de_named_bedrock: write")
  chk(bytes == hexBytes(testNamedBedrock), "simple_ser_de_named_bedrock: bytes")
  let re = fromBytesBedrock[Test](bytes)
  chk(re.isOk and same(test, re.value), "simple_ser_de_named_bedrock: read")

proc simpleSerDeArrayNamed() =
  var bytes = newSeq[byte](0)
  chk(toBytesNamed(sampleArray(), "Test", bytes).isOk, "simple_ser_de_array_named: write")
  chk(bytes == hexBytes(arrNamed), "simple_ser_de_array_named: bytes")
  let re = fromBytes[TestArray](bytes)
  chk(re.isOk and same(sampleArray(), re.value), "simple_ser_de_array_named: read")

proc simpleSerDeArrayNamedBedrock() =
  var bytes = newSeq[byte](0)
  chk(toBytesNamedBedrock(sampleArray(), "Test", bytes).isOk, "simple_ser_de_array_named_bedrock: write")
  chk(bytes == hexBytes(arrNamedBedrock), "simple_ser_de_array_named_bedrock: bytes")
  let re = fromBytesBedrock[TestArray](bytes)
  chk(re.isOk and same(sampleArray(), re.value), "simple_ser_de_array_named_bedrock: read")

proc list() =
  let v = sampleList(true)
  var bytes = newSeq[byte](0)
  chk(toBytesUnnamed(v, bytes).isOk, "list: write")
  chk(bytes == hexBytes(listUnnamed), "list: bytes")
  let re = fromBytesUnnamed[TestList](bytes)
  chk(re.isOk and same(v, re.value), "list: read")

proc listBedrockTest() =
  let v = sampleList(true)
  var bytes = newSeq[byte](0)
  chk(toBytesBedrock(v, bytes).isOk, "list_bedrock: write")
  chk(bytes == hexBytes(listBedrock), "list_bedrock: bytes")
  let re = fromBytesBedrock[TestList](bytes)
  chk(re.isOk and same(v, re.value), "list_bedrock: read")

proc listNamedTest() =
  let v = sampleList(false)
  var bytes = newSeq[byte](0)
  chk(toBytesNamed(v, "a", bytes).isOk, "list_named: write")
  chk(bytes == hexBytes(listNamed), "list_named: bytes")
  let re = fromBytes[TestList](bytes)
  chk(re.isOk and same(v, re.value), "list_named: read")

proc listNamedBedrockTest() =
  let v = sampleList(false)
  var bytes = newSeq[byte](0)
  chk(toBytesNamedBedrock(v, "a", bytes).isOk, "list_named_bedrock: write")
  chk(bytes == hexBytes(listNamedBedrock), "list_named_bedrock: bytes")
  let re = fromBytesBedrock[TestList](bytes)
  chk(re.isOk and same(v, re.value), "list_named_bedrock: read")

proc wrapperVec(): seq[NbtTag] =
  result = @[
    NbtTag(kind: ntkInt, intVal: -1823'i32),
    NbtTag(kind: ntkInt, intVal: 123'i32),
    NbtTag(kind: ntkString, stringVal: "Not an int"),
    NbtTag(kind: ntkByte, byteVal: 2'i8)]
  var a = newCompound()
  a.putShort("example", 1234'i16)
  result.add NbtTag(kind: ntkCompound, compoundVal: a)
  var b = newCompound()
  b.putLong("", 1'i64)
  result.add NbtTag(kind: ntkCompound, compoundVal: b)

proc wrapperCompoundLists() =
  let expected = @[
    0x09'u8, 0x0A,
    0x00, 0x00, 0x00, 0x06,
    0x03, 0x00, 0x00, 0xFF, 0xFF, 0xF8, 0xE1, 0x00,
    0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7B, 0x00,
    0x08, 0x00, 0x00, 0x00, 0x0A,
    0x4E, 0x6F, 0x74, 0x20, 0x61, 0x6E, 0x20, 0x69, 0x6E, 0x74,
    0x00,
    0x01, 0x00, 0x00, 0x02, 0x00,
    0x02, 0x00, 0x07, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0x04, 0xD2, 0x00,
    0x0A, 0x00, 0x00,
    0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
    0x00, 0x00]
  var w = newNbtWriter(nwmJava)
  chk(serialize(NbtTag(kind: ntkList, listVal: wrapperVec()), w).isOk, "wrapper_compound_lists: write")
  chk(w.buf == expected, "wrapper_compound_lists: bytes")

proc wrapperCompoundListsBedrock() =
  let expected = @[
    0x09'u8, 0x0A,
    0x0C,
    0x03, 0x00, 0xBD, 0x1C, 0x00,
    0x03, 0x00, 0xF6, 0x01, 0x00,
    0x08, 0x00, 0x0A,
    0x4E, 0x6F, 0x74, 0x20, 0x61, 0x6E, 0x20, 0x69, 0x6E, 0x74,
    0x00,
    0x01, 0x00, 0x02, 0x00,
    0x02, 0x07, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0xD2, 0x04, 0x00,
    0x0A, 0x00,
    0x04, 0x00, 0x02, 0x00,
    0x00]
  var w = newNbtWriter(nwmBedrock)
  chk(serialize(NbtTag(kind: ntkList, listVal: wrapperVec()), w).isOk, "wrapper_compound_lists_bedrock: write")
  chk(w.buf == expected, "wrapper_compound_lists_bedrock: bytes")

proc wrapperListReadsBack() =
  # Not upstream: the read side of those bytes. Wrappers flatten; the plain compound stays.
  var w = newNbtWriter(nwmJava)
  discard serialize(NbtTag(kind: ntkList, listVal: wrapperVec()), w)
  var r = newNbtReader(nrmJava, w.buf)
  let back = deserialize(r)
  chk(back.isOk and back.value == NbtTag(kind: ntkList, listVal: wrapperVec()), "wrapper list reads back")

proc taggedValue(): Tagged =
  Tagged(l: nbtLongArray([0'i64]), i: nbtIntArray([0'i32]), b: nbtByteArray([0'u8]))

proc nbtArrays() =
  let expected = @[
    0x0A'u8, 0x00, 0x00,
    0x0C, 0x00, 0x01, 0x6C, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x0B, 0x00, 0x01, 0x69, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
    0x07, 0x00, 0x01, 0x62, 0x00, 0x00, 0x00, 0x01, 0x00,
    0x00]
  var bytes = newSeq[byte](0)
  chk(toBytes(taggedValue(), bytes).isOk, "nbt_arrays: tagged write")
  chk(bytes == expected, "nbt_arrays: tagged bytes")
  let expected2 = @[
    0x0A'u8, 0x00, 0x00,
    0x09, 0x00, 0x01, 0x6C, 0x04, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x09, 0x00, 0x01, 0x69, 0x03, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
    0x09, 0x00, 0x01, 0x62, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00,
    0x00]
  var bytes2 = newSeq[byte](0)
  chk(toBytes(default(NotTagged), bytes2).isOk, "nbt_arrays: untagged write")
  chk(bytes2 == expected2, "nbt_arrays: untagged bytes")

proc nbtArraysBedrock() =
  let expected = @[
    0x0A'u8, 0x00,
    0x0C, 0x01, 0x6C, 0x02, 0x00,
    0x0B, 0x01, 0x69, 0x02, 0x00,
    0x07, 0x01, 0x62, 0x02, 0x00,
    0x00]
  var bytes = newSeq[byte](0)
  chk(toBytesBedrock(taggedValue(), bytes).isOk, "nbt_arrays_bedrock: tagged write")
  chk(bytes == expected, "nbt_arrays_bedrock: tagged bytes")
  let expected2 = @[
    0x0A'u8, 0x00,
    0x09, 0x01, 0x6C, 0x04, 0x02, 0x00,
    0x09, 0x01, 0x69, 0x03, 0x02, 0x00,
    0x09, 0x01, 0x62, 0x01, 0x02, 0x00,
    0x00]
  var bytes2 = newSeq[byte](0)
  chk(toBytesBedrock(default(NotTagged), bytes2).isOk, "nbt_arrays_bedrock: untagged write")
  chk(bytes2 == expected2, "nbt_arrays_bedrock: untagged bytes")

proc tupleFail() =
  var bytes = newSeq[byte](0)
  let r = toBytes(BadData(x: (0'i32, 0'i64)), bytes)
  chk(not r.isOk and r.error.kind == nekSerde, "tuple_fail")
  chk(r.error.msg == "Serde error: List values must all be of the same type! Expected 3 but found 4!",
    "tuple_fail text: " & r.error.msg)

proc tupleFailBedrock() =
  var bytes = newSeq[byte](0)
  let r = toBytesBedrock(BadData(x: (0'i32, 0'i64)), bytes)
  chk(not r.isOk and r.error.kind == nekSerde, "tuple_fail_bedrock")

proc tupleOk() =
  let value = GoodData(x: (1'i32, 2'i32))
  var bytes = newSeq[byte](0)
  chk(toBytes(value, bytes).isOk, "tuple_ok: write")
  chk(bytes == hexBytes(tupleOkJava), "tuple_ok: bytes")
  let re = fromBytes[GoodData](bytes)
  chk(re.isOk and re.value.x == value.x, "tuple_ok: read")

proc tupleOkBedrockTest() =
  let value = GoodData(x: (1'i32, 2'i32))
  var bytes = newSeq[byte](0)
  chk(toBytesBedrock(value, bytes).isOk, "tuple_ok_bedrock: write")
  chk(bytes == hexBytes(tupleOkBedrock), "tuple_ok_bedrock: bytes")
  let re = fromBytesBedrock[GoodData](bytes)
  chk(re.isOk and re.value.x == value.x, "tuple_ok_bedrock: read")

# --- the crate doc example ----------------------------------------------------

type Player = object
  name: string
  health: int16

proc docExample() =
  var encoded = newSeq[byte](0)
  chk(toBytes(Player(name: "Steve", health: 20'i16), encoded).isOk, "doc example: write")
  let decoded = fromSlice[Player](encoded)
  chk(decoded.isOk and decoded.value.name == "Steve" and decoded.value.health == 20'i16, "doc example: read")

# --- Nbt ----------------------------------------------------------------------

proc nbtDocument() =
  var c = newCompound()
  c.putInt("v", 7'i32)
  let doc = newNbt("hi", c)
  let java = @[0x0A'u8, 0x00, 0x02, 0x68, 0x69, 0x03, 0x00, 0x01, 0x76, 0x00, 0x00, 0x00, 0x07, 0x00]
  chk(write(doc) == java, "Nbt::write")
  chk(write(doc, nwmJava) == java, "Nbt write with a mode")
  let bedrock = @[0x0A'u8, 0x02, 0x68, 0x69, 0x03, 0x01, 0x76, 0x0E, 0x00]
  chk(writeBedrock(doc) == bedrock, "Nbt::write_bedrock")
  chk(write(doc, nwmBedrock) == bedrock, "Nbt bedrock with a mode")
  let unnamed = @[0x0A'u8, 0x03, 0x00, 0x01, 0x76, 0x00, 0x00, 0x00, 0x07, 0x00]
  chk(writeUnnamed(doc) == unnamed, "Nbt::write_unnamed")

  var ra = newNbtReader(nrmJava, java)
  let a = read(ra)
  chk(a.isOk and a.value.name == "hi" and a.value.rootTag.getInt("v") == some(7'i32), "Nbt::read")
  var rb = newNbtReader(nrmBedrock, bedrock)
  let b = read(rb)
  chk(b.isOk and b.value.name == "hi" and b.value.rootTag.getInt("v") == some(7'i32), "Nbt::read bedrock")
  var ru = newNbtReader(nrmJava, unnamed)
  let u = readUnnamed(ru)
  chk(u.isOk and u.value.name == "" and u.value.rootTag.getInt("v") == some(7'i32), "Nbt::read_unnamed")

  var bad = newNbtReader(nrmJava, @[0x03'u8, 0x00])
  let e = read(bad)
  chk(not e.isOk and e.error.kind == nekNoRootCompound and
    e.error.msg == "The root tag of the NBT file is not a compound tag. Received tag id: 3", "NoRootCompound")
  var badU = newNbtReader(nrmJava, @[0x08'u8])
  let eu = readUnnamed(badU)
  chk(not eu.isOk and eu.error.kind == nekNoRootCompound, "NoRootCompound unnamed")
  var emptyDoc = newNbtReader(nrmJava, newSeq[byte](0))
  let ee = read(emptyDoc)
  chk(not ee.isOk and ee.error.kind == nekIncomplete, "Nbt::read on nothing")

  var sink1 = @[0xAA'u8]
  writeToWriter(doc, sink1)
  chk(sink1.len == java.len + 1 and sink1[1] == 0x0A'u8, "write_to_writer appends")
  var sink2 = newSeq[byte](0)
  writeUnnamedToWriter(doc, sink2)
  chk(sink2 == unnamed, "write_unnamed_to_writer")
  var sink3 = newSeq[byte](0)
  writeToWriterBedrock(doc, sink3)
  chk(sink3 == bedrock, "write_to_writer_bedrock")

  chk(toNbtDoc(c).name == "", "From<NbtCompound> for Nbt")
  chk(doc == newNbt("hi", c) and not (doc == newNbt("x", c)), "PartialEq for Nbt")
  chk(toCompound(doc) == c, "From<Nbt> for NbtCompound")

zeroAllocFromSlice()
simpleSerDeUnnamed()
simpleSerDeUnnamedBedrock()
simpleSerDeArray()
simpleSerDeArrayBedrock()
simpleSerDeNamed()
simpleSerDeNamedBedrock()
simpleSerDeArrayNamed()
simpleSerDeArrayNamedBedrock()
list()
listBedrockTest()
listNamedTest()
listNamedBedrockTest()
wrapperCompoundLists()
wrapperCompoundListsBedrock()
wrapperListReadsBack()
nbtArrays()
nbtArraysBedrock()
tupleFail()
tupleFailBedrock()
tupleOk()
tupleOkBedrockTest()
docExample()
nbtDocument()

if failures > 0:
  echo $failures & " nbt checks FAILED"
  quit(1)
echo "nbt checks: OK"
