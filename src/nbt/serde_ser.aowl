## serde's `Serializer` for NBT, and the `Serialize` impls of NbtTag, NbtCompound and the derive.
## Port of pumpkin-nbt/src/serializer.rs (`Serializer`, `State`, `to_bytes*`; the primitive writers are in
## serializer.aowl)
## Port of pumpkin-nbt/src/lib.rs (`nbt_int_array`, `nbt_long_array`, `nbt_byte_array`)
##
## There is no serde, so a `#[derive(Serialize)]` struct is any aowlmony `object`, walked by compile-time
## field reflection in `serializeValue`, driving the same state machine with the same calls in the same
## order. To honour a `#[serde(...)]` attribute, write `serializeValue` for that type: an overload visible
## where `toBytes` is instantiated takes priority over the object walker.
##
## `#[serde(serialize_with = "nbt_int_array")]` is the field type `NbtIntArray[T]`, likewise byte and long.
## A Rust `[T; N]` is `array[N, T]` and a tuple a tuple, both through `serialize_tuple`.
##
## One deliberate divergence: upstream's `Serialize for NbtTag` writes a mixed list with the first
## element's type and corrupt payloads after it. `serializeValue` for a mixed `seq[NbtTag]` wraps it the
## way `serialize_data` does, so it stays valid NBT. Same-typed lists are byte-identical to upstream.

{.feature: "untyped".}

import std/[options, tables]
import nbtbase, serializer, deserializer, tag, nbtdoc

const
  NbtArrayTag* = "__nbt_array"
  NbtIntArrayTag* = "__nbt_int_array"
  NbtLongArrayTag* = "__nbt_long_array"
  NbtByteArrayTag* = "__nbt_byte_array"

iterator internalFieldPairs*[T: tuple|object](x: T): tuple[key: string, val: untyped] {.
  magic: "InternalFieldPairs", noSideEffect.}

proc bareFieldName*(mangled: string): string =
  ## internalFieldPairs yields `x.0`; the source name is the part before the first dot.
  result = ""
  for c in mangled:
    if c == '.':
      break
    result.add c

type
  NbtByteArray*[T] = object
    items*: T
  NbtIntArray*[T] = object
    items*: T
  NbtLongArray*[T] = object
    items*: T

  SerStateKind = enum
    ssRoot, ssNamed, ssMapKey, ssFirstListElement, ssListElement, ssCheckedListElement, ssArray

  SerState = object
    kind: SerStateKind
    hasName: bool   ## ssRoot: the Option<String>
    name: string    ## ssRoot, ssNamed, ssArray
    len: int32      ## ssFirstListElement
    arrayType: string ## ssArray

  NbtSerializer* = object
    output*: NbtWriter
    state: SerState
    handledRoot: bool
    expectedListTag: uint8

proc nbtByteArray*[T](items: T): NbtByteArray[T] = NbtByteArray[T](items: items)
proc nbtIntArray*[T](items: T): NbtIntArray[T] = NbtIntArray[T](items: items)
proc nbtLongArray*[T](items: T): NbtLongArray[T] = NbtLongArray[T](items: items)

proc newNbtSerializer*(mode: NbtWriteMode, hasName: bool, name: string): NbtSerializer =
  ## `hasName` false writes unnamed network NBT.
  NbtSerializer(output: newNbtWriter(mode),
    state: SerState(kind: ssRoot, hasName: hasName, name: name, len: 0, arrayType: ""),
    handledRoot: false, expectedListTag: 0'u8)

proc setNamed*(s: var NbtSerializer, name: string) =
  s.state = SerState(kind: ssNamed, hasName: false, name: name, len: 0, arrayType: "")

proc setSimple(s: var NbtSerializer, kind: SerStateKind) =
  s.state = SerState(kind: kind, hasName: false, name: "", len: 0, arrayType: "")

proc parseState*(s: var NbtSerializer, tag: uint8): NbtVoidResult =
  case s.state.kind
  of ssNamed, ssArray:
    s.output.writeU8(tag)
    let r = s.output.writeString(s.state.name)
    if not r.isOk:
      return r
  of ssFirstListElement:
    s.output.writeU8(tag)
    s.output.writeI32(s.state.len)
    s.expectedListTag = tag
  of ssMapKey:
    if tag != StringId:
      return errVoid(serdeError("Map key can only be `String`, not " & $tag))
  of ssListElement:
    discard # Rust rules mandate this is all the same type
  of ssCheckedListElement:
    if tag != s.expectedListTag:
      return errVoid(serdeError("List values must all be of the same type! Expected " &
        $s.expectedListTag & " but found " & $tag & "!"))
  of ssRoot:
    if s.handledRoot:
      return errVoid(serdeError("Invalid state: already handled root component!"))
    if tag != CompoundId:
      return errVoid(serdeError("Invalid state: root is not a `Compound`! (" & $tag & ")"))
    s.handledRoot = true
    s.output.writeU8(tag)
    if s.state.hasName:
      let r = s.output.writeString(s.state.name)
      if not r.isOk:
        return r
  okVoid()

proc serializeI8*(s: var NbtSerializer, v: int8): NbtVoidResult =
  let r = parseState(s, ByteId)
  if not r.isOk: return r
  s.output.writeI8(v)
  okVoid()

proc serializeBool*(s: var NbtSerializer, v: bool): NbtVoidResult =
  serializeI8(s, if v: 1'i8 else: 0'i8)

proc serializeI16*(s: var NbtSerializer, v: int16): NbtVoidResult =
  let r = parseState(s, ShortId)
  if not r.isOk: return r
  s.output.writeI16(v)
  okVoid()

proc serializeI32*(s: var NbtSerializer, v: int32): NbtVoidResult =
  let r = parseState(s, IntId)
  if not r.isOk: return r
  s.output.writeI32(v)
  okVoid()

proc serializeI64*(s: var NbtSerializer, v: int64): NbtVoidResult =
  let r = parseState(s, LongId)
  if not r.isOk: return r
  s.output.writeI64(v)
  okVoid()

proc serializeU8*(s: var NbtSerializer, v: uint8): NbtVoidResult =
  if s.state.kind == ssNamed:
    return errVoid(unsupportedType("u8; NBT only supports signed values"))
  let r = parseState(s, ByteId)
  if not r.isOk: return r
  s.output.writeU8(v)
  okVoid()

proc serializeU16*(s: var NbtSerializer, v: uint16): NbtVoidResult =
  serializeI16(s, cast[int16](v))

proc serializeU32*(s: var NbtSerializer, v: uint32): NbtVoidResult =
  serializeI32(s, cast[int32](v))

proc serializeU64*(s: var NbtSerializer, v: uint64): NbtVoidResult =
  serializeI64(s, cast[int64](v))

proc serializeF32*(s: var NbtSerializer, v: float32): NbtVoidResult =
  let r = parseState(s, FloatId)
  if not r.isOk: return r
  s.output.writeF32(v)
  okVoid()

proc serializeF64*(s: var NbtSerializer, v: float64): NbtVoidResult =
  let r = parseState(s, DoubleId)
  if not r.isOk: return r
  s.output.writeF64(v)
  okVoid()

proc serializeChar*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("char"))

proc serializeStr*(s: var NbtSerializer, v: string): NbtVoidResult =
  let r = parseState(s, StringId)
  if not r.isOk: return r
  if s.state.kind == ssMapKey:
    setNamed(s, v)
    okVoid()
  else:
    s.output.writeString(v)

proc serializeNone*(s: var NbtSerializer): NbtVoidResult =
  ## Just skip serializing if the value is none.
  case s.state.kind
  of ssFirstListElement, ssListElement, ssCheckedListElement:
    errVoid(serdeError("NBT lists do not support null/none values"))
  else:
    okVoid()

proc serializeUnit*(s: var NbtSerializer): NbtVoidResult =
  okVoid()

proc serializeUnitVariant*(s: var NbtSerializer, variant: string): NbtVoidResult =
  serializeStr(s, variant)

proc serializeBytes*(s: var NbtSerializer, v: openArray[byte]): NbtVoidResult =
  let r = parseState(s, ListId)
  if not r.isOk: return r
  s.output.writeU8(ByteId)
  if v.len > int(int32.high):
    return errVoid(largeLength(v.len))
  s.output.writeI32(int32(v.len))
  s.output.writeSlice(v)
  okVoid()

proc serializeUnitStruct*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("unit struct"))

proc serializeNewtypeStruct*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("newtype struct"))

proc serializeTupleStruct*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("tuple struct"))

proc serializeTupleVariant*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("tuple variant"))

proc serializeStructVariant*(s: var NbtSerializer): NbtVoidResult =
  errVoid(unsupportedType("struct variant"))

proc serializeSeq*(s: var NbtSerializer, len: int): NbtVoidResult =
  if len > int(int32.high):
    return errVoid(largeLength(len))
  if s.state.kind == ssArray:
    var id = EndId
    var expectedTag = EndId
    case s.state.arrayType
    of NbtByteArrayTag:
      id = ByteArrayId
      expectedTag = ByteId
    of NbtIntArrayTag:
      id = IntArrayId
      expectedTag = IntId
    of NbtLongArrayTag:
      id = LongArrayId
      expectedTag = LongId
    else:
      return errVoid(serdeError("Array supports only `byte`, `int`, and `long`"))
    let r = parseState(s, id)
    if not r.isOk: return r
    s.output.writeI32(int32(len))
    # Anything can be marked as an NBT array, so the elements get checked.
    s.expectedListTag = expectedTag
    setSimple(s, ssCheckedListElement)
  else:
    let r = parseState(s, ListId)
    if not r.isOk: return r
    s.state = SerState(kind: ssFirstListElement, hasName: false, name: "", len: int32(len), arrayType: "")
    if len == 0:
      # FirstListElement will never be invoked, so write the (unknown) list type and length here.
      s.output.writeU8(EndId)
      s.output.writeI32(0'i32)
  okVoid()

proc serializeNewtypeVariant*(s: var NbtSerializer, name, variant: string): NbtVoidResult =
  ## serialize_newtype_variant up to the point where the value is serialized.
  if name != NbtArrayTag:
    return errVoid(unsupportedType("newtype variant"))
  if s.state.kind != ssNamed:
    return errVoid(serdeError("Invalid `Serializer` state!"))
  s.state = SerState(kind: ssArray, hasName: false, name: s.state.name, len: 0, arrayType: variant)
  okVoid()

proc endElementSeq*(s: var NbtSerializer) =
  ## SerializeSeq::serialize_element, after the value.
  setSimple(s, ssListElement)

proc endElementTuple*(s: var NbtSerializer) =
  ## SerializeTuple::serialize_element, after the value.
  setSimple(s, ssCheckedListElement)

proc serializeMapStart*(s: var NbtSerializer): NbtVoidResult =
  ## serialize_map and serialize_struct.
  parseState(s, CompoundId)

proc serializeMapKeyStart*(s: var NbtSerializer) =
  setSimple(s, ssMapKey)

proc serializeMapEnd*(s: var NbtSerializer): NbtVoidResult =
  s.output.writeU8(EndId)
  okVoid()

# --- Serialize impls ----------------------------------------------------------

proc serializeValue*(s: var NbtSerializer, v: bool): NbtVoidResult = serializeBool(s, v)
proc serializeValue*(s: var NbtSerializer, v: int8): NbtVoidResult = serializeI8(s, v)
proc serializeValue*(s: var NbtSerializer, v: int16): NbtVoidResult = serializeI16(s, v)
proc serializeValue*(s: var NbtSerializer, v: int32): NbtVoidResult = serializeI32(s, v)
proc serializeValue*(s: var NbtSerializer, v: int64): NbtVoidResult = serializeI64(s, v)
proc serializeValue*(s: var NbtSerializer, v: uint8): NbtVoidResult = serializeU8(s, v)
proc serializeValue*(s: var NbtSerializer, v: uint16): NbtVoidResult = serializeU16(s, v)
proc serializeValue*(s: var NbtSerializer, v: uint32): NbtVoidResult = serializeU32(s, v)
proc serializeValue*(s: var NbtSerializer, v: uint64): NbtVoidResult = serializeU64(s, v)
proc serializeValue*(s: var NbtSerializer, v: float32): NbtVoidResult = serializeF32(s, v)
proc serializeValue*(s: var NbtSerializer, v: float64): NbtVoidResult = serializeF64(s, v)
proc serializeValue*(s: var NbtSerializer, v: char): NbtVoidResult = serializeChar(s)
proc serializeValue*(s: var NbtSerializer, v: string): NbtVoidResult = serializeStr(s, v)

proc serializeValue*[E: enum](s: var NbtSerializer, v: E): NbtVoidResult =
  serializeUnitVariant(s, $v)

proc serializeValue*[T](s: var NbtSerializer, v: Option[T]): NbtVoidResult =
  if v.isSome:
    serializeValue(s, v.unsafeGet)
  else:
    serializeNone(s)

proc serializeValue*[T](s: var NbtSerializer, v: ref T): NbtVoidResult =
  ## Box<T>. A nil ref, which a Box cannot be, counts as None.
  if v == nil:
    serializeNone(s)
  else:
    serializeValue(s, v[])

proc serializeValue*[T](s: var NbtSerializer, v: seq[T]): NbtVoidResult =
  let r = serializeSeq(s, v.len)
  if not r.isOk: return r
  for i in 0 ..< v.len:
    let e = serializeValue(s, v[i])
    if not e.isOk: return e
    endElementSeq(s)
  okVoid()

proc serializeValue*[I, T](s: var NbtSerializer, v: array[I, T]): NbtVoidResult =
  let r = serializeSeq(s, v.len)
  if not r.isOk: return r
  for i in 0 ..< v.len: # low(v)..high(v) fails to compile for a length-1 array
    let e = serializeValue(s, v[i])
    if not e.isOk: return e
    endElementTuple(s)
  okVoid()

proc serializeValue*[O: tuple](s: var NbtSerializer, v: O): NbtVoidResult =
  var count = 0
  for name, f in internalFieldPairs(v):
    inc count
  let r = serializeSeq(s, count)
  if not r.isOk: return r
  for name, f in internalFieldPairs(v):
    let e = serializeValue(s, f)
    if not e.isOk: return e
    endElementTuple(s)
  okVoid()

proc serializeValue*[V](s: var NbtSerializer, v: Table[string, V]): NbtVoidResult =
  let r = serializeMapStart(s)
  if not r.isOk: return r
  for k, x in pairs(v):
    serializeMapKeyStart(s)
    let kr = serializeStr(s, k)
    if not kr.isOk: return kr
    let vr = serializeValue(s, x)
    if not vr.isOk: return vr
  serializeMapEnd(s)

proc serializeValue*[T](s: var NbtSerializer, v: NbtByteArray[T]): NbtVoidResult =
  let r = serializeNewtypeVariant(s, NbtArrayTag, NbtByteArrayTag)
  if not r.isOk: return r
  serializeValue(s, v.items)

proc serializeValue*[T](s: var NbtSerializer, v: NbtIntArray[T]): NbtVoidResult =
  let r = serializeNewtypeVariant(s, NbtArrayTag, NbtIntArrayTag)
  if not r.isOk: return r
  serializeValue(s, v.items)

proc serializeValue*[T](s: var NbtSerializer, v: NbtLongArray[T]): NbtVoidResult =
  let r = serializeNewtypeVariant(s, NbtArrayTag, NbtLongArrayTag)
  if not r.isOk: return r
  serializeValue(s, v.items)

proc serializeValue*(s: var NbtSerializer, v: NbtCompound): NbtVoidResult =
  let r = serializeMapStart(s)
  if not r.isOk: return r
  for i in 0 ..< v.names.len:
    serializeMapKeyStart(s)
    let kr = serializeStr(s, v.names[i])
    if not kr.isOk: return kr
    let vr = serializeValue(s, v.values[i])
    if not vr.isOk: return vr
  serializeMapEnd(s)

proc serializeValue*(s: var NbtSerializer, v: NbtTag): NbtVoidResult =
  case v.kind
  of ntkEnd: serializeUnit(s)
  of ntkByte: serializeI8(s, v.byteVal)
  of ntkShort: serializeI16(s, v.shortVal)
  of ntkInt: serializeI32(s, v.intVal)
  of ntkLong: serializeI64(s, v.longVal)
  of ntkFloat: serializeF32(s, v.floatVal)
  of ntkDouble: serializeF64(s, v.doubleVal)
  of ntkByteArray:
    let r = serializeNewtypeVariant(s, NbtArrayTag, NbtByteArrayTag)
    if not r.isOk: return r
    serializeValue(s, v.byteArrayVal)
  of ntkString: serializeStr(s, v.stringVal)
  of ntkList:
    let r = serializeSeq(s, v.listVal.len)
    if not r.isOk: return r
    let elemId = getListElementTypeId(v.listVal)
    let mixed = elemId == CompoundId and hasNonCompound(v.listVal)
    for i in 0 ..< v.listVal.len:
      let e =
        if mixed and needsWrap(elemId, v.listVal[i]): serializeValue(s, wrapTag(v.listVal[i]))
        else: serializeValue(s, v.listVal[i])
      if not e.isOk: return e
      endElementSeq(s)
    okVoid()
  of ntkCompound: serializeValue(s, v.compoundVal)
  of ntkIntArray:
    let r = serializeNewtypeVariant(s, NbtArrayTag, NbtIntArrayTag)
    if not r.isOk: return r
    serializeValue(s, v.intArrayVal)
  of ntkLongArray:
    let r = serializeNewtypeVariant(s, NbtArrayTag, NbtLongArrayTag)
    if not r.isOk: return r
    serializeValue(s, v.longArrayVal)

proc hasNonCompound(list: seq[NbtTag]): bool =
  for i in 0 ..< list.len:
    if list[i].kind != ntkCompound:
      return true
  false

proc serializeValue*[O: object](s: var NbtSerializer, v: O): NbtVoidResult =
  let r = serializeMapStart(s)
  if not r.isOk: return r
  for name, f in internalFieldPairs(v):
    setNamed(s, bareFieldName(name))
    let e = serializeValue(s, f)
    if not e.isOk: return e
  serializeMapEnd(s)

# --- to_bytes -----------------------------------------------------------------

proc toBytesWith[T](value: T, mode: NbtWriteMode, hasName: bool, name: string, w: var seq[byte]): NbtVoidResult =
  var s = newNbtSerializer(mode, hasName, name)
  let r = serializeValue(s, value)
  addAll(w, s.output.buf)
  r

proc toBytesUnnamed*[T](value: T, w: var seq[byte]): NbtVoidResult =
  ## Unnamed Java Edition network NBT. On failure `w` keeps what was written, as a Rust writer would.
  toBytesWith(value, nwmJava, false, "", w)

proc toBytesNamed*[T](value: T, name: string, w: var seq[byte]): NbtVoidResult =
  toBytesWith(value, nwmJava, true, name, w)

proc toBytesNamedBedrock*[T](value: T, name: string, w: var seq[byte]): NbtVoidResult =
  toBytesWith(value, nwmBedrock, true, name, w)

proc toBytes*[T](value: T, w: var seq[byte]): NbtVoidResult =
  ## Java Edition NBT with an empty root name.
  toBytesNamed(value, "", w)

proc toBytesBedrock*[T](value: T, w: var seq[byte]): NbtVoidResult =
  toBytesNamedBedrock(value, "", w)

proc toBytes*[T](value: T): NbtResult[seq[byte]] =
  var buf = newSeq[byte](0)
  let r = toBytes(value, buf)
  if not r.isOk:
    return errRes[seq[byte]](r.error)
  ok[seq[byte]](buf)

proc toNbt*[T](value: T): NbtResult[NbtCompound] =
  ## The compound `value` serializes to. It goes through the bytes, so the result is what a reader of
  ## those bytes would get, list flattening included.
  var buf = newSeq[byte](0)
  let r = toBytesUnnamed(value, buf)
  if not r.isOk:
    return errRes[NbtCompound](r.error)
  var reader = newNbtReader(nrmJava, buf)
  let doc = readUnnamed(reader)
  if not doc.isOk:
    return errRes[NbtCompound](doc.error)
  ok[NbtCompound](doc.value.rootTag)
