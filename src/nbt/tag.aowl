## The in-memory NBT tree: `NbtTag` and `NbtCompound`, with their reading, writing, skipping and accessors.
## Port of pumpkin-nbt/src/tag.rs
## Port of pumpkin-nbt/src/compound.rs
##
## One file because the two types recurse into each other. serde's `Serialize`/`Deserialize` for them is
## in serde_ser.aowl and serde_de.aowl.
##
## `child_tags` is a HashMap in the pinned tree; here it stays the parallel `names`/`values` seqs, in
## insertion order, which is one valid HashMap order. `put` keeps the first value, as the pinned tree does;
## `insert` is `child_tags.insert`, which replaces. Rust `Option` is std/options, except the original `get`.
##
## The depth limit (MaxNbtDepth) is the newer checkout's logic, counted the same way: a compound costs two
## levels, one entering its tag and one entering its content, a list one per element. Everything else
## about reading follows the pinned tree.

import std/[options, tables]
import ../codecs/json_value
import nbtbase, serializer, deserializer

const
  wrapperKey = ""
  indexedInsertFrom = 64 ## compounds this large stop rescanning `names` for each tag read

type
  NbtTagKind* = enum
    ntkEnd = 0'u8
    ntkByte = 1'u8
    ntkShort = 2'u8
    ntkInt = 3'u8
    ntkLong = 4'u8
    ntkFloat = 5'u8
    ntkDouble = 6'u8
    ntkByteArray = 7'u8
    ntkString = 8'u8
    ntkList = 9'u8
    ntkCompound = 10'u8
    ntkIntArray = 11'u8
    ntkLongArray = 12'u8

  NbtTag* = object
    case kind*: NbtTagKind
    of ntkEnd: discard
    of ntkByte: byteVal*: int8
    of ntkShort: shortVal*: int16
    of ntkInt: intVal*: int32
    of ntkLong: longVal*: int64
    of ntkFloat: floatVal*: float32
    of ntkDouble: doubleVal*: float64
    of ntkByteArray: byteArrayVal*: seq[int8]
    of ntkString: stringVal*: string
    of ntkList: listVal*: seq[NbtTag]
    of ntkCompound: compoundVal*: NbtCompound
    of ntkIntArray: intArrayVal*: seq[int32]
    of ntkLongArray: longArrayVal*: seq[int64]

  NbtCompound* = object
    names*: seq[string]
    values*: seq[NbtTag]

proc getTypeId*(tag: NbtTag): uint8 {.inline.} =
  ord(tag.kind).uint8

proc newCompound*(): NbtCompound =
  NbtCompound(names: @[], values: @[])

proc len*(c: NbtCompound): int {.inline.} =
  c.names.len

proc isEmpty*(c: NbtCompound): bool {.inline.} =
  c.names.len == 0

proc indexOf(c: NbtCompound, name: string): int =
  for i in 0 ..< c.names.len:
    if c.names[i] == name:
      return i
  result = -1

proc containsKey*(c: NbtCompound, name: string): bool {.inline.} =
  indexOf(c, name) >= 0

proc has*(c: NbtCompound, name: string): bool {.inline.} =
  indexOf(c, name) >= 0

proc insert*(c: var NbtCompound, name: string, tag: sink NbtTag) =
  ## `child_tags.insert`: replaces an existing value, in its existing position.
  let i = indexOf(c, name)
  if i >= 0:
    c.values[i] = tag
  else:
    c.names.add(name)
    c.values.add(tag)

proc put*(c: var NbtCompound, name: string, tag: sink NbtTag) =
  ## Inserts a tag when `name` is not already present. Existing entries are left unchanged.
  if indexOf(c, name) < 0:
    c.names.add(name)
    c.values.add(tag)

proc get*(c: NbtCompound, name: string): (bool, NbtTag) =
  let i = indexOf(c, name)
  if i >= 0:
    (true, c.values[i])
  else:
    (false, NbtTag(kind: ntkEnd))

proc remove*(c: var NbtCompound, name: string): (bool, NbtTag) =
  ## `child_tags.remove`: removes and returns the value, if present.
  let i = indexOf(c, name)
  if i >= 0:
    result = (true, c.values[i])
    c.names.delete(i)
    c.values.delete(i)
  else:
    result = (false, NbtTag(kind: ntkEnd))

iterator pairs*(c: NbtCompound): (string, NbtTag) =
  for i in 0 ..< c.names.len:
    yield (c.names[i], c.values[i])

# --- From<T> for NbtTag -------------------------------------------------------

proc nbtTag*(value: string): NbtTag = NbtTag(kind: ntkString, stringVal: value)
proc nbtTag*(value: openArray[int8]): NbtTag = NbtTag(kind: ntkByteArray, byteArrayVal: @value)
proc nbtTag*(value: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: value)
proc nbtTag*(value: float64): NbtTag = NbtTag(kind: ntkDouble, doubleVal: value)
proc nbtTag*(value: bool): NbtTag = NbtTag(kind: ntkByte, byteVal: (if value: 1'i8 else: 0'i8))
proc nbtTag*(value: sink NbtCompound): NbtTag = NbtTag(kind: ntkCompound, compoundVal: value)

proc put*(c: var NbtCompound, name: string, value: string) = put(c, name, nbtTag(value))
proc put*(c: var NbtCompound, name: string, value: openArray[int8]) = put(c, name, nbtTag(value))
proc put*(c: var NbtCompound, name: string, value: float32) = put(c, name, nbtTag(value))
proc put*(c: var NbtCompound, name: string, value: float64) = put(c, name, nbtTag(value))
proc put*(c: var NbtCompound, name: string, value: bool) = put(c, name, nbtTag(value))
proc put*(c: var NbtCompound, name: string, value: sink NbtCompound) = put(c, name, nbtTag(value))

# --- compound.rs accessors ----------------------------------------------------

proc putString*(c: var NbtCompound, name: string, value: string) =
  put(c, name, NbtTag(kind: ntkString, stringVal: value))

proc putList*(c: var NbtCompound, name: string, value: sink seq[NbtTag]) =
  put(c, name, NbtTag(kind: ntkList, listVal: value))

proc putByte*(c: var NbtCompound, name: string, value: int8) =
  put(c, name, NbtTag(kind: ntkByte, byteVal: value))

proc putBool*(c: var NbtCompound, name: string, value: bool) =
  put(c, name, nbtTag(value))

proc putShort*(c: var NbtCompound, name: string, value: int16) =
  put(c, name, NbtTag(kind: ntkShort, shortVal: value))

proc putInt*(c: var NbtCompound, name: string, value: int32) =
  put(c, name, NbtTag(kind: ntkInt, intVal: value))

proc putLong*(c: var NbtCompound, name: string, value: int64) =
  put(c, name, NbtTag(kind: ntkLong, longVal: value))

proc putFloat*(c: var NbtCompound, name: string, value: float32) =
  put(c, name, NbtTag(kind: ntkFloat, floatVal: value))

proc putDouble*(c: var NbtCompound, name: string, value: float64) =
  put(c, name, NbtTag(kind: ntkDouble, doubleVal: value))

proc putCompound*(c: var NbtCompound, name: string, value: sink NbtCompound) =
  put(c, name, NbtTag(kind: ntkCompound, compoundVal: value))

proc putUuid*(c: var NbtCompound, name: string, hi, lo: uint64) =
  ## A UUID as a 4-element int array, most significant bits first (vanilla's `UUID` layout). A UUID is its
  ## two 64-bit halves here, as in src/protocol/uuid.aowl, which imports this crate.
  put(c, name, NbtTag(kind: ntkIntArray, intArrayVal: @[
    cast[int32](uint32(hi shr 32)), cast[int32](uint32(hi and 0xFFFF_FFFF'u64)),
    cast[int32](uint32(lo shr 32)), cast[int32](uint32(lo and 0xFFFF_FFFF'u64))]))

# --- tag.rs extract_* ---------------------------------------------------------

proc extractByte*(tag: NbtTag): Option[int8] =
  if tag.kind == ntkByte: some(tag.byteVal) else: none[int8]()

proc extractShort*(tag: NbtTag): Option[int16] =
  if tag.kind == ntkShort: some(tag.shortVal) else: none[int16]()

proc extractInt*(tag: NbtTag): Option[int32] =
  if tag.kind == ntkInt: some(tag.intVal) else: none[int32]()

proc extractLong*(tag: NbtTag): Option[int64] =
  if tag.kind == ntkLong: some(tag.longVal) else: none[int64]()

proc extractFloat*(tag: NbtTag): Option[float32] =
  if tag.kind == ntkFloat: some(tag.floatVal) else: none[float32]()

proc extractDouble*(tag: NbtTag): Option[float64] =
  if tag.kind == ntkDouble: some(tag.doubleVal) else: none[float64]()

proc extractBool*(tag: NbtTag): Option[bool] =
  if tag.kind == ntkByte: some(tag.byteVal != 0'i8) else: none[bool]()

proc extractByteArray*(tag: NbtTag): Option[seq[int8]] =
  if tag.kind == ntkByteArray: some(tag.byteArrayVal) else: none[seq[int8]]()

proc extractString*(tag: NbtTag): Option[string] =
  if tag.kind == ntkString: some(tag.stringVal) else: none[string]()

proc extractList*(tag: NbtTag): Option[seq[NbtTag]] =
  if tag.kind == ntkList: some(tag.listVal) else: none[seq[NbtTag]]()

proc extractCompound*(tag: NbtTag): Option[NbtCompound] =
  if tag.kind == ntkCompound: some(tag.compoundVal) else: none[NbtCompound]()

proc extractIntArray*(tag: NbtTag): Option[seq[int32]] =
  if tag.kind == ntkIntArray: some(tag.intArrayVal) else: none[seq[int32]]()

proc extractLongArray*(tag: NbtTag): Option[seq[int64]] =
  if tag.kind == ntkLongArray: some(tag.longArrayVal) else: none[seq[int64]]()

proc getByte*(c: NbtCompound, name: string): Option[int8] =
  let i = indexOf(c, name)
  if i >= 0: extractByte(c.values[i]) else: none[int8]()

proc getShort*(c: NbtCompound, name: string): Option[int16] =
  let i = indexOf(c, name)
  if i >= 0: extractShort(c.values[i]) else: none[int16]()

proc getInt*(c: NbtCompound, name: string): Option[int32] =
  let i = indexOf(c, name)
  if i >= 0: extractInt(c.values[i]) else: none[int32]()

proc getLong*(c: NbtCompound, name: string): Option[int64] =
  let i = indexOf(c, name)
  if i >= 0: extractLong(c.values[i]) else: none[int64]()

proc getFloat*(c: NbtCompound, name: string): Option[float32] =
  let i = indexOf(c, name)
  if i >= 0: extractFloat(c.values[i]) else: none[float32]()

proc getDouble*(c: NbtCompound, name: string): Option[float64] =
  let i = indexOf(c, name)
  if i >= 0: extractDouble(c.values[i]) else: none[float64]()

proc getBool*(c: NbtCompound, name: string): Option[bool] =
  let i = indexOf(c, name)
  if i >= 0: extractBool(c.values[i]) else: none[bool]()

proc getString*(c: NbtCompound, name: string): Option[string] =
  let i = indexOf(c, name)
  if i >= 0: extractString(c.values[i]) else: none[string]()

proc getList*(c: NbtCompound, name: string): Option[seq[NbtTag]] =
  let i = indexOf(c, name)
  if i >= 0: extractList(c.values[i]) else: none[seq[NbtTag]]()

proc getCompound*(c: NbtCompound, name: string): Option[NbtCompound] =
  let i = indexOf(c, name)
  if i >= 0: extractCompound(c.values[i]) else: none[NbtCompound]()

proc getIntArray*(c: NbtCompound, name: string): Option[seq[int32]] =
  let i = indexOf(c, name)
  if i >= 0: extractIntArray(c.values[i]) else: none[seq[int32]]()

proc getLongArray*(c: NbtCompound, name: string): Option[seq[int64]] =
  let i = indexOf(c, name)
  if i >= 0: extractLongArray(c.values[i]) else: none[seq[int64]]()

proc getUuid*(c: NbtCompound, name: string): Option[(uint64, uint64)] =
  ## (hi, lo), as written by `putUuid`. None unless the tag is an int array of exactly 4.
  let i = indexOf(c, name)
  if i < 0 or c.values[i].kind != ntkIntArray or c.values[i].intArrayVal.len != 4:
    return none[(uint64, uint64)]()
  let a = c.values[i].intArrayVal
  some((
    (uint64(cast[uint32](a[0])) shl 32) or uint64(cast[uint32](a[1])),
    (uint64(cast[uint32](a[2])) shl 32) or uint64(cast[uint32](a[3]))))

proc fromIter*(entries: openArray[(string, NbtTag)]): NbtCompound =
  ## FromIterator<(String, NbtTag)>: goes through `put`, so the first of two equal names wins.
  result = newCompound()
  for i in 0 ..< entries.len:
    put(result, entries[i][0], entries[i][1])

proc extend*(c: var NbtCompound, entries: openArray[(string, NbtTag)]) =
  ## Extend<(String, NbtTag)>: goes through `put`.
  for i in 0 ..< entries.len:
    put(c, entries[i][0], entries[i][1])

proc nbtCompoundTag*(entries: openArray[(string, NbtTag)]): NbtTag =
  ## `nbt_compound_tag!`.
  NbtTag(kind: ntkCompound, compoundVal: fromIter(entries))

proc nbtCompoundTag*(): NbtTag =
  NbtTag(kind: ntkCompound, compoundVal: newCompound())

# --- PartialEq and Display ----------------------------------------------------

proc `==`*(a, b: NbtTag): bool =
  if a.kind != b.kind:
    return false
  case a.kind
  of ntkEnd: true
  of ntkByte: a.byteVal == b.byteVal
  of ntkShort: a.shortVal == b.shortVal
  of ntkInt: a.intVal == b.intVal
  of ntkLong: a.longVal == b.longVal
  of ntkFloat: a.floatVal == b.floatVal
  of ntkDouble: a.doubleVal == b.doubleVal
  of ntkByteArray: a.byteArrayVal == b.byteArrayVal
  of ntkString: a.stringVal == b.stringVal
  of ntkList:
    if a.listVal.len != b.listVal.len:
      return false
    for i in 0 ..< a.listVal.len:
      if not (a.listVal[i] == b.listVal[i]):
        return false
    true
  of ntkCompound: a.compoundVal == b.compoundVal
  of ntkIntArray: a.intArrayVal == b.intArrayVal
  of ntkLongArray: a.longArrayVal == b.longArrayVal

proc `==`*(a, b: NbtCompound): bool =
  ## HashMap equality: order does not matter.
  if a.names.len != b.names.len:
    return false
  for i in 0 ..< a.names.len:
    let j = indexOf(b, a.names[i])
    if j < 0 or not (a.values[i] == b.values[j]):
      return false
  true

proc `$`*(c: NbtCompound): string =
  result = "{"
  for i in 0 ..< c.names.len:
    if i > 0:
      result.add ", "
    result.add c.names[i]
    result.add ": "
    result.add $c.values[i]
  result.add "}"

proc `$`*(tag: NbtTag): string =
  ## SNBT display. Strings are not escaped, as upstream's TODO says.
  result = ""
  case tag.kind
  of ntkEnd: discard
  of ntkByte: result = $tag.byteVal & "b"
  of ntkShort: result = $tag.shortVal & "s"
  of ntkInt: result = $tag.intVal
  of ntkLong: result = $tag.longVal & "L"
  of ntkFloat: result = displayF32(tag.floatVal) & "f"
  of ntkDouble: result = displayF64(tag.doubleVal) & "d"
  of ntkString: result = "\"" & tag.stringVal & "\""
  of ntkCompound: result = $tag.compoundVal
  of ntkByteArray:
    result = "[B;"
    for i in 0 ..< tag.byteArrayVal.len:
      if i > 0: result.add ","
      result.add " " & $tag.byteArrayVal[i] & "b"
    result.add "]"
  of ntkList:
    result = "["
    for i in 0 ..< tag.listVal.len:
      if i > 0: result.add ", "
      result.add $tag.listVal[i]
    result.add "]"
  of ntkIntArray:
    result = "[I;"
    for i in 0 ..< tag.intArrayVal.len:
      if i > 0: result.add ","
      result.add " " & $tag.intArrayVal[i]
    result.add "]"
  of ntkLongArray:
    result = "[L;"
    for i in 0 ..< tag.longArrayVal.len:
      if i > 0: result.add ","
      result.add " " & $tag.longArrayVal[i] & "L"
    result.add "]"

# --- list wrapping ------------------------------------------------------------

proc getListElementTypeId*(list: seq[NbtTag]): uint8 =
  ## The element type a list tag is written with; COMPOUND_ID when the elements differ.
  var elementId = EndId
  for i in 0 ..< list.len:
    let id = list[i].getTypeId()
    if elementId == EndId:
      elementId = id
    elif elementId != id:
      return CompoundId
  elementId

proc isWrapperCompound*(c: NbtCompound): bool {.inline.} =
  ## Exactly one entry, under the empty key.
  c.names.len == 1 and c.names[0] == wrapperKey

proc flatten*(tag: sink NbtTag): NbtTag =
  ## Unwraps a wrapper compound; anything else comes back unchanged.
  if tag.kind == ntkCompound and isWrapperCompound(tag.compoundVal):
    tag.compoundVal.values[0]
  else:
    tag

proc wrapTag*(tag: sink NbtTag): NbtTag =
  var compound = newCompound()
  put(compound, wrapperKey, tag)
  NbtTag(kind: ntkCompound, compoundVal: compound)

proc needsWrap*(elementType: uint8, tag: NbtTag): bool {.inline.} =
  elementType == CompoundId and
    not (tag.kind == ntkCompound and not isWrapperCompound(tag.compoundVal))

proc wrapTagIfNeeded*(elementType: uint8, tag: sink NbtTag): NbtTag =
  if needsWrap(elementType, tag):
    wrapTag(tag)
  else:
    tag

# --- serialize_data / serialize_content --------------------------------------

proc serializeContent*(c: NbtCompound, w: var NbtWriter): NbtVoidResult =
  for i in 0 ..< c.names.len:
    w.writeU8(c.values[i].getTypeId())
    let nameRes = w.writeString(c.names[i])
    if not nameRes.isOk:
      return nameRes
    let valRes = serializeData(c.values[i], w)
    if not valRes.isOk:
      return valRes
  w.writeU8(EndId)
  okVoid()

proc serializeData*(tag: NbtTag, w: var NbtWriter): NbtVoidResult =
  case tag.kind
  of ntkEnd:
    discard
  of ntkByte:
    w.writeI8(tag.byteVal)
  of ntkShort:
    w.writeI16(tag.shortVal)
  of ntkInt:
    w.writeI32(tag.intVal)
  of ntkLong:
    w.writeI64(tag.longVal)
  of ntkFloat:
    w.writeF32(tag.floatVal)
  of ntkDouble:
    w.writeF64(tag.doubleVal)
  of ntkByteArray:
    let len = tag.byteArrayVal.len
    if len > int(int32.high):
      return errVoid(largeLength(len))
    w.writeI32(int32(len))
    for i in 0 ..< len:
      w.writeI8(tag.byteArrayVal[i])
  of ntkString:
    let r = w.writeString(tag.stringVal)
    if not r.isOk:
      return r
  of ntkList:
    let len = tag.listVal.len
    if len > int(int32.high):
      return errVoid(largeLength(len))
    let elemId = getListElementTypeId(tag.listVal)
    w.writeU8(elemId)
    w.writeI32(int32(len))
    for i in 0 ..< len:
      # Tags in one list tag must share a type, so mixed elements go in wrapper compounds.
      let r =
        if needsWrap(elemId, tag.listVal[i]): serializeData(wrapTag(tag.listVal[i]), w)
        else: serializeData(tag.listVal[i], w)
      if not r.isOk:
        return r
  of ntkCompound:
    let r = serializeContent(tag.compoundVal, w)
    if not r.isOk:
      return r
  of ntkIntArray:
    let len = tag.intArrayVal.len
    if len > int(int32.high):
      return errVoid(largeLength(len))
    w.writeI32(int32(len))
    for i in 0 ..< len:
      w.writeI32(tag.intArrayVal[i])
  of ntkLongArray:
    let len = tag.longArrayVal.len
    if len > int(int32.high):
      return errVoid(largeLength(len))
    w.writeI32(int32(len))
    for i in 0 ..< len:
      w.writeI64(tag.longArrayVal[i])
  okVoid()

proc serialize*(tag: NbtTag, w: var NbtWriter): NbtVoidResult =
  ## The tag's type id followed by its payload.
  w.writeU8(tag.getTypeId())
  serializeData(tag, w)

# --- deserialize_data / deserialize_content -----------------------------------

proc insertIndexed(c: var NbtCompound, index: var Table[string, int], name: string, tag: sink NbtTag) =
  ## `child_tags.insert`, without rescanning a huge compound once per tag.
  if c.names.len < indexedInsertFrom:
    insert(c, name, tag)
    return
  if index.len == 0:
    for i in 0 ..< c.names.len:
      index[c.names[i]] = i
  let i = index.getOrDefault(name, -1)
  if i >= 0:
    c.values[i] = tag
  else:
    index[name] = c.names.len
    c.names.add(name)
    c.values.add(tag)

proc readContentInto(r: var NbtReader, depth: int, c: var NbtCompound): NbtVoidResult =
  if depth > MaxNbtDepth:
    return errVoid(maxDepthExceeded())
  var index = default(Table[string, int])
  while true:
    let idRes = getU8(r)
    if not idRes.isOk:
      if idRes.error.kind == nekIncomplete and idRes.error.unexpectedEof:
        break # upstream: EOF where a tag id belongs ends the compound
      return errVoid(idRes.error)
    let tagId = idRes.value
    if tagId == EndId:
      break
    let nameRes = getString(r)
    if not nameRes.isOk:
      return errVoid(nameRes.error)
    var tag = NbtTag(kind: ntkEnd)
    let tagRes = readDataInto(r, tagId, depth + 1, tag)
    if not tagRes.isOk:
      return tagRes
    insertIndexed(c, index, nameRes.value, tag)
  okVoid()

proc readLength(r: var NbtReader, n: var int): NbtVoidResult =
  ## The array and list length prefix: negative first, then the cap.
  let lenRes = getI32(r)
  if not lenRes.isOk:
    return errVoid(lenRes.error)
  if lenRes.value < 0:
    return errVoid(negativeLength(lenRes.value))
  n = int(lenRes.value)
  if n > MaxArrayLength:
    return errVoid(largeLength(n))
  okVoid()

proc readDataInto(r: var NbtReader, tagId: uint8, depth: int, t: var NbtTag): NbtVoidResult =
  if depth > MaxNbtDepth:
    return errVoid(maxDepthExceeded())
  case tagId
  of EndId:
    t = NbtTag(kind: ntkEnd)
  of ByteId:
    let v = getI8(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkByte, byteVal: v.value)
  of ShortId:
    let v = getI16(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkShort, shortVal: v.value)
  of IntId:
    let v = getI32(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkInt, intVal: v.value)
  of LongId:
    let v = getI64(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkLong, longVal: v.value)
  of FloatId:
    let v = getF32(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkFloat, floatVal: v.value)
  of DoubleId:
    let v = getF64(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkDouble, doubleVal: v.value)
  of ByteArrayId:
    var n = 0
    let lenRes = readLength(r, n)
    if not lenRes.isOk: return lenRes
    let arr = getByteArray(r, n)
    if not arr.isOk: return errVoid(arr.error)
    t = NbtTag(kind: ntkByteArray, byteArrayVal: arr.value)
  of StringId:
    let v = getString(r)
    if not v.isOk: return errVoid(v.error)
    t = NbtTag(kind: ntkString, stringVal: v.value)
  of ListId:
    let elemIdRes = getU8(r)
    if not elemIdRes.isOk: return errVoid(elemIdRes.error)
    let elemId = elemIdRes.value
    var n = 0
    let lenRes = readLength(r, n)
    if not lenRes.isOk: return lenRes
    var list = newSeq[NbtTag](0)
    for _ in 0 ..< n:
      var elem = NbtTag(kind: ntkEnd)
      let elemRes = readDataInto(r, elemId, depth + 1, elem)
      if not elemRes.isOk: return elemRes
      list.add(flatten(elem))
    t = NbtTag(kind: ntkList, listVal: list)
  of CompoundId:
    var inner = newCompound()
    let c = readContentInto(r, depth + 1, inner)
    if not c.isOk: return c
    t = NbtTag(kind: ntkCompound, compoundVal: inner)
  of IntArrayId:
    var n = 0
    let lenRes = readLength(r, n)
    if not lenRes.isOk: return lenRes
    let arr = getI32Array(r, n)
    if not arr.isOk: return errVoid(arr.error)
    t = NbtTag(kind: ntkIntArray, intArrayVal: arr.value)
  of LongArrayId:
    var n = 0
    let lenRes = readLength(r, n)
    if not lenRes.isOk: return lenRes
    let arr = getI64Array(r, n)
    if not arr.isOk: return errVoid(arr.error)
    t = NbtTag(kind: ntkLongArray, longArrayVal: arr.value)
  else:
    return errVoid(unknownTagId(tagId))
  okVoid()

proc deserializeContentDepth*(r: var NbtReader, depth: int): NbtResult[NbtCompound] =
  var c = newCompound()
  let res = readContentInto(r, depth, c)
  if not res.isOk:
    return errRes[NbtCompound](res.error)
  ok[NbtCompound](c)

proc deserializeContent*(r: var NbtReader): NbtResult[NbtCompound] =
  deserializeContentDepth(r, 0)

proc deserializeDataDepth*(r: var NbtReader, tagId: uint8, depth: int): NbtResult[NbtTag] =
  var t = NbtTag(kind: ntkEnd)
  let res = readDataInto(r, tagId, depth, t)
  if not res.isOk:
    return errRes[NbtTag](res.error)
  ok[NbtTag](t)

proc deserializeData*(r: var NbtReader, tagId: uint8): NbtResult[NbtTag] =
  deserializeDataDepth(r, tagId, 0)

proc deserialize*(r: var NbtReader): NbtResult[NbtTag] =
  ## A type id and its payload.
  let idRes = getU8(r)
  if not idRes.isOk:
    return errRes[NbtTag](idRes.error)
  deserializeDataDepth(r, idRes.value, 0)

# --- skip_data / skip_content -------------------------------------------------

proc skipContentDepth*(r: var NbtReader, depth: int): NbtVoidResult =
  if depth > MaxNbtDepth:
    return errVoid(maxDepthExceeded())
  while true:
    let idRes = getU8(r)
    if not idRes.isOk:
      if idRes.error.kind == nekIncomplete and idRes.error.unexpectedEof:
        break
      return errVoid(idRes.error)
    let tagId = idRes.value
    if tagId == EndId:
      break
    let sRes = skipString(r)
    if not sRes.isOk:
      return sRes
    let vRes = skipDataDepth(r, tagId, depth + 1)
    if not vRes.isOk:
      return vRes
  okVoid()

proc skipContent*(r: var NbtReader): NbtVoidResult =
  skipContentDepth(r, 0)

proc skipLength(r: var NbtReader, n: var int): NbtVoidResult =
  ## Skipping checks the sign but not MAX_ARRAY_LENGTH.
  let lenRes = getI32(r)
  if not lenRes.isOk:
    return errVoid(lenRes.error)
  if lenRes.value < 0:
    return errVoid(negativeLength(lenRes.value))
  n = int(lenRes.value)
  okVoid()

proc skipDataDepth*(r: var NbtReader, tagId: uint8, depth: int): NbtVoidResult =
  if depth > MaxNbtDepth:
    return errVoid(maxDepthExceeded())
  case tagId
  of EndId: okVoid()
  of ByteId: skipI8(r)
  of ShortId: skipI16(r)
  of IntId: skipI32(r)
  of LongId: skipI64(r)
  of FloatId: skipF32(r)
  of DoubleId: skipF64(r)
  of ByteArrayId:
    var n = 0
    let lenRes = skipLength(r, n)
    if not lenRes.isOk: return lenRes
    skipBytes(r, n)
  of StringId: skipString(r)
  of ListId:
    let elemIdRes = getU8(r)
    if not elemIdRes.isOk: return errVoid(elemIdRes.error)
    let elemId = elemIdRes.value
    var n = 0
    let lenRes = skipLength(r, n)
    if not lenRes.isOk: return lenRes
    if elemId == EndId:
      return okVoid() # every element would skip nothing
    for _ in 0 ..< n:
      let r2 = skipDataDepth(r, elemId, depth + 1)
      if not r2.isOk: return r2
    okVoid()
  of CompoundId:
    skipContentDepth(r, depth + 1)
  of IntArrayId:
    var n = 0
    let lenRes = skipLength(r, n)
    if not lenRes.isOk: return lenRes
    if r.mode == nrmJava:
      return skipBytes(r, n * 4)
    for _ in 0 ..< n:
      let r2 = skipI32(r)
      if not r2.isOk: return r2
    okVoid()
  of LongArrayId:
    var n = 0
    let lenRes = skipLength(r, n)
    if not lenRes.isOk: return lenRes
    if r.mode == nrmJava:
      return skipBytes(r, n * 8)
    for _ in 0 ..< n:
      let r2 = skipI64(r)
      if not r2.isOk: return r2
    okVoid()
  else:
    errVoid(unknownTagId(tagId))

proc skipData*(r: var NbtReader, tagId: uint8): NbtVoidResult =
  skipDataDepth(r, tagId, 0)
