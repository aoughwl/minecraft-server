## Known-answer checks for tag.aowl: the #[test] of pumpkin-nbt/src/compound.rs, and hand-derived answers for
## the accessors, conversions, Display and PartialEq of compound.rs and tag.rs, which have no tests upstream.

import std/[syncio, options]
import tag, nbtbase, serializer

var failures = 0

proc chk(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failures

proc uuidIntArrayRoundTrip() =
  const hi = 0x0123_4567_89AB_CDEF'u64
  const lo = 0xFEDC_BA98_7654_3210'u64
  var nbt = newCompound()
  nbt.putUuid("UUID", hi, lo)
  chk(nbt.getUuid("UUID") == some((hi, lo)), "uuid_int_array_round_trip")
  let arr = nbt.getIntArray("UUID")
  chk(arr.isSome and arr.unsafeGet == @[0x0123_4567'i32, cast[int32](0x89AB_CDEF'u32),
    cast[int32](0xFEDC_BA98'u32), 0x7654_3210'i32], "uuid layout, most significant first")
  chk(nbt.getUuid("missing").isNone, "uuid missing")
  var short = newCompound()
  short.put("UUID", NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32, 3'i32]))
  chk(short.getUuid("UUID").isNone, "uuid malformed")

proc putKeepsFirst() =
  var c = newCompound()
  c.putInt("a", 1'i32)
  c.putInt("a", 2'i32)
  chk(c.getInt("a") == some(1'i32), "put leaves an existing entry")
  c.insert("a", NbtTag(kind: ntkInt, intVal: 3'i32))
  chk(c.getInt("a") == some(3'i32) and c.len == 1, "insert replaces")
  c.putString("b", "x")
  c.putLong("c", 5'i64)
  chk(c.names == @["a", "b", "c"], "insertion order")
  c.insert("a", NbtTag(kind: ntkInt, intVal: 4'i32))
  chk(c.names == @["a", "b", "c"], "insert keeps position")
  let (found, tag) = c.remove("b")
  chk(found and tag.stringVal == "x" and c.names == @["a", "c"], "remove")
  let (found2, _) = c.remove("zzz")
  chk(not found2, "remove missing")

proc accessors() =
  var c = newCompound()
  chk(c.isEmpty, "is_empty")
  c.putByte("b", -1'i8)
  c.putBool("t", true)
  c.putBool("f", false)
  c.putShort("s", -2'i16)
  c.putInt("i", -3'i32)
  c.putLong("l", -4'i64)
  c.putFloat("fl", 1.5'f32)
  c.putDouble("d", 2.5)
  c.putString("str", "text")
  c.putList("li", @[NbtTag(kind: ntkInt, intVal: 1'i32)])
  var inner = newCompound()
  inner.putInt("x", 9'i32)
  c.putCompound("co", inner)
  c.put("ia", NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32]))
  c.put("la", NbtTag(kind: ntkLongArray, longArrayVal: @[2'i64]))
  c.put("ba", [7'i8, 8'i8])
  c.put("putstr", "s2")
  c.put("putf32", 1.25'f32)
  c.put("putf64", 1.25)
  c.put("putbool", true)
  c.put("putco", inner)
  chk(not c.isEmpty and c.has("b") and c.containsKey("b") and not c.has("zzz"), "has")
  chk(c.getByte("b") == some(-1'i8), "get_byte")
  chk(c.getBool("t") == some(true) and c.getBool("f") == some(false), "get_bool")
  chk(c.getBool("b") == some(true), "get_bool reads any non-zero byte")
  chk(c.getShort("s") == some(-2'i16), "get_short")
  chk(c.getInt("i") == some(-3'i32), "get_int")
  chk(c.getLong("l") == some(-4'i64), "get_long")
  chk(c.getFloat("fl") == some(1.5'f32), "get_float")
  chk(c.getDouble("d") == some(2.5), "get_double")
  chk(c.getString("str") == some("text"), "get_string")
  chk(c.getList("li").isSome and c.getList("li").unsafeGet.len == 1, "get_list")
  chk(c.getCompound("co").isSome and c.getCompound("co").unsafeGet.getInt("x") == some(9'i32), "get_compound")
  chk(c.getIntArray("ia") == some(@[1'i32]), "get_int_array")
  chk(c.getLongArray("la") == some(@[2'i64]), "get_long_array")
  chk(c.values[c.names.len - 6].byteArrayVal == @[7'i8, 8'i8], "put From<&[i8]>")
  chk(c.getString("putstr") == some("s2"), "put From<&str>")
  chk(c.getFloat("putf32") == some(1.25'f32), "put From<f32>")
  chk(c.getDouble("putf64") == some(1.25), "put From<f64>")
  chk(c.getByte("putbool") == some(1'i8), "put From<bool>")
  chk(c.getCompound("putco").isSome, "put From<NbtCompound>")
  # Absent, or another type, is None.
  chk(c.getByte("zzz").isNone and c.getByte("s").isNone, "get_byte none")
  chk(c.getShort("b").isNone and c.getInt("s").isNone and c.getLong("i").isNone, "numeric types do not widen")
  chk(c.getFloat("d").isNone and c.getDouble("fl").isNone, "floats do not widen")
  chk(c.getBool("s").isNone and c.getString("b").isNone and c.getList("ia").isNone, "wrong type none")
  chk(c.getCompound("li").isNone and c.getIntArray("la").isNone and c.getLongArray("ia").isNone, "wrong type none 2")
  let (found, tag) = c.get("i")
  chk(found and tag.kind == ntkInt and tag.intVal == -3'i32, "get")
  let (found2, tag2) = c.get("zzz")
  chk(not found2 and tag2.kind == ntkEnd, "get missing")

proc extractors() =
  let byteTag = NbtTag(kind: ntkByte, byteVal: 5'i8)
  let intTag = NbtTag(kind: ntkInt, intVal: 5'i32)
  chk(byteTag.extractByte == some(5'i8) and intTag.extractByte.isNone, "extract_byte")
  chk(NbtTag(kind: ntkShort, shortVal: 5'i16).extractShort == some(5'i16) and intTag.extractShort.isNone, "extract_short")
  chk(intTag.extractInt == some(5'i32) and byteTag.extractInt.isNone, "extract_int")
  chk(NbtTag(kind: ntkLong, longVal: 5'i64).extractLong == some(5'i64) and intTag.extractLong.isNone, "extract_long")
  chk(NbtTag(kind: ntkFloat, floatVal: 0.5'f32).extractFloat == some(0.5'f32) and intTag.extractFloat.isNone, "extract_float")
  chk(NbtTag(kind: ntkDouble, doubleVal: 0.5).extractDouble == some(0.5) and intTag.extractDouble.isNone, "extract_double")
  chk(byteTag.extractBool == some(true) and NbtTag(kind: ntkByte, byteVal: 0'i8).extractBool == some(false) and
    intTag.extractBool.isNone, "extract_bool")
  chk(NbtTag(kind: ntkByteArray, byteArrayVal: @[1'i8]).extractByteArray == some(@[1'i8]) and intTag.extractByteArray.isNone, "extract_byte_array")
  chk(NbtTag(kind: ntkString, stringVal: "a").extractString == some("a") and intTag.extractString.isNone, "extract_string")
  chk(NbtTag(kind: ntkList, listVal: @[intTag]).extractList.isSome and intTag.extractList.isNone, "extract_list")
  chk(NbtTag(kind: ntkCompound, compoundVal: newCompound()).extractCompound.isSome and intTag.extractCompound.isNone, "extract_compound")
  chk(NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32]).extractIntArray == some(@[1'i32]) and intTag.extractIntArray.isNone, "extract_int_array")
  chk(NbtTag(kind: ntkLongArray, longArrayVal: @[1'i64]).extractLongArray == some(@[1'i64]) and intTag.extractLongArray.isNone, "extract_long_array")

proc typeIds() =
  chk(NbtTag(kind: ntkEnd).getTypeId == EndId, "END_ID")
  chk(NbtTag(kind: ntkByte).getTypeId == ByteId, "BYTE_ID")
  chk(NbtTag(kind: ntkShort).getTypeId == ShortId, "SHORT_ID")
  chk(NbtTag(kind: ntkInt).getTypeId == IntId, "INT_ID")
  chk(NbtTag(kind: ntkLong).getTypeId == LongId, "LONG_ID")
  chk(NbtTag(kind: ntkFloat).getTypeId == FloatId, "FLOAT_ID")
  chk(NbtTag(kind: ntkDouble).getTypeId == DoubleId, "DOUBLE_ID")
  chk(NbtTag(kind: ntkByteArray).getTypeId == ByteArrayId, "BYTE_ARRAY_ID")
  chk(NbtTag(kind: ntkString).getTypeId == StringId, "STRING_ID")
  chk(NbtTag(kind: ntkList).getTypeId == ListId, "LIST_ID")
  chk(NbtTag(kind: ntkCompound).getTypeId == CompoundId, "COMPOUND_ID")
  chk(NbtTag(kind: ntkIntArray).getTypeId == IntArrayId, "INT_ARRAY_ID")
  chk(NbtTag(kind: ntkLongArray).getTypeId == LongArrayId, "LONG_ARRAY_ID")
  chk(MaxArrayLength == 2_000_000, "MAX_ARRAY_LENGTH of the pinned tree")

proc listHelpers() =
  let i = NbtTag(kind: ntkInt, intVal: 1'i32)
  let s = NbtTag(kind: ntkString, stringVal: "x")
  chk(getListElementTypeId(newSeq[NbtTag](0)) == EndId, "empty list is END")
  chk(getListElementTypeId(@[i, i]) == IntId, "same type")
  chk(getListElementTypeId(@[i, s]) == CompoundId, "mixed is COMPOUND")
  var wrapper = newCompound()
  wrapper.put("", i)
  var plain = newCompound()
  plain.put("a", i)
  var two = newCompound()
  two.put("", i)
  two.put("b", i)
  chk(isWrapperCompound(wrapper) and not isWrapperCompound(plain) and not isWrapperCompound(two) and
    not isWrapperCompound(newCompound()), "is_wrapper_compound")
  chk(flatten(NbtTag(kind: ntkCompound, compoundVal: wrapper)) == i, "flatten unwraps")
  chk(flatten(i) == i, "flatten scalar")
  chk(flatten(NbtTag(kind: ntkCompound, compoundVal: plain)).kind == ntkCompound, "flatten leaves plain")
  chk(wrapTagIfNeeded(IntId, i) == i, "no wrap outside a compound list")
  chk(wrapTagIfNeeded(CompoundId, i) == NbtTag(kind: ntkCompound, compoundVal: wrapper), "scalar wrapped")
  let plainTag = NbtTag(kind: ntkCompound, compoundVal: plain)
  chk(wrapTagIfNeeded(CompoundId, plainTag) == plainTag, "plain compound not wrapped")
  let w2 = wrapTagIfNeeded(CompoundId, NbtTag(kind: ntkCompound, compoundVal: wrapper))
  chk(w2.kind == ntkCompound and w2.compoundVal.names == @[""] and w2.compoundVal.values[0].kind == ntkCompound, "wrapper wrapped again")

proc emptyList() =
  var w = newNbtWriter(nwmJava)
  chk(serialize(NbtTag(kind: ntkList, listVal: newSeq[NbtTag](0)), w).isOk, "empty list write")
  chk(w.buf == @[0x09'u8, 0x00, 0x00, 0x00, 0x00, 0x00], "empty list is typed END")

proc display() =
  chk($NbtTag(kind: ntkEnd) == "", "Display End")
  chk($NbtTag(kind: ntkByte, byteVal: -1'i8) == "-1b", "Display Byte")
  chk($NbtTag(kind: ntkShort, shortVal: 2'i16) == "2s", "Display Short")
  chk($NbtTag(kind: ntkInt, intVal: 3'i32) == "3", "Display Int")
  chk($NbtTag(kind: ntkLong, longVal: 4'i64) == "4L", "Display Long")
  chk($NbtTag(kind: ntkFloat, floatVal: 1.5'f32) == "1.5f", "Display Float")
  chk($NbtTag(kind: ntkFloat, floatVal: 1.0'f32) == "1f", "Display Float whole: " & $NbtTag(kind: ntkFloat, floatVal: 1.0'f32))
  chk($NbtTag(kind: ntkDouble, doubleVal: 2.5) == "2.5d", "Display Double")
  chk($NbtTag(kind: ntkString, stringVal: "a\"b") == "\"a\"b\"", "Display String has no escaping")
  chk($NbtTag(kind: ntkByteArray, byteArrayVal: @[1'i8, 2'i8]) == "[B; 1b, 2b]", "Display ByteArray")
  chk($NbtTag(kind: ntkByteArray, byteArrayVal: newSeq[int8](0)) == "[B;]", "Display empty ByteArray")
  chk($NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32]) == "[I; 1, 2]", "Display IntArray")
  chk($NbtTag(kind: ntkLongArray, longArrayVal: @[1'i64, 2'i64]) == "[L; 1L, 2L]", "Display LongArray")
  chk($NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkInt, intVal: 1'i32), NbtTag(kind: ntkByte, byteVal: 2'i8)]) == "[1, 2b]", "Display List")
  var c = newCompound()
  c.putInt("a", 1'i32)
  c.putString("b", "x")
  chk($c == "{a: 1, b: \"x\"}", "Display compound")
  chk($newCompound() == "{}", "Display empty compound")
  chk($NbtTag(kind: ntkCompound, compoundVal: c) == "{a: 1, b: \"x\"}", "Display Compound tag")

proc equality() =
  var a = newCompound()
  a.putInt("x", 1'i32)
  a.putInt("y", 2'i32)
  var b = newCompound()
  b.putInt("y", 2'i32)
  b.putInt("x", 1'i32)
  chk(a == b, "compound equality ignores order")
  b.insert("x", NbtTag(kind: ntkInt, intVal: 9'i32))
  chk(not (a == b), "compound values differ")
  chk(not (NbtTag(kind: ntkInt, intVal: 1'i32) == NbtTag(kind: ntkLong, longVal: 1'i64)), "kinds differ")
  chk(not (NbtTag(kind: ntkDouble, doubleVal: 0.0 / 0.0) == NbtTag(kind: ntkDouble, doubleVal: 0.0 / 0.0)), "NaN is not equal to NaN")
  chk(NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkByte, byteVal: 1'i8)]) ==
    NbtTag(kind: ntkList, listVal: @[NbtTag(kind: ntkByte, byteVal: 1'i8)]), "lists equal")

proc conversions() =
  chk(nbtTag("s") == NbtTag(kind: ntkString, stringVal: "s"), "From<&str>")
  chk(nbtTag([1'i8, 2'i8]) == NbtTag(kind: ntkByteArray, byteArrayVal: @[1'i8, 2'i8]), "From<&[i8]>")
  chk(nbtTag(1.5'f32) == NbtTag(kind: ntkFloat, floatVal: 1.5'f32), "From<f32>")
  chk(nbtTag(1.5) == NbtTag(kind: ntkDouble, doubleVal: 1.5), "From<f64>")
  chk(nbtTag(true) == NbtTag(kind: ntkByte, byteVal: 1'i8) and nbtTag(false) == NbtTag(kind: ntkByte, byteVal: 0'i8), "From<bool>")
  chk(nbtTag(newCompound()) == NbtTag(kind: ntkCompound, compoundVal: newCompound()), "From<NbtCompound>")
  let i1 = NbtTag(kind: ntkInt, intVal: 1'i32)
  let i2 = NbtTag(kind: ntkInt, intVal: 2'i32)
  let fromI = fromIter([("a", i1), ("b", i2), ("a", i2)])
  chk(fromI.getInt("a") == some(1'i32) and fromI.len == 2, "FromIterator<String> keeps the first")
  var ext = newCompound()
  ext.putInt("a", 5'i32)
  ext.extend([("a", i2), ("b", i2)])
  chk(ext.getInt("a") == some(5'i32) and ext.getInt("b") == some(2'i32), "Extend<String> keeps the first")
  chk(nbtCompoundTag() == NbtTag(kind: ntkCompound, compoundVal: newCompound()), "nbt_compound_tag! empty")
  let tagged = nbtCompoundTag([("k", i1)])
  chk(tagged.kind == ntkCompound and tagged.compoundVal.getInt("k") == some(1'i32), "nbt_compound_tag!")
  var seen = newSeq[string](0)
  for name, v in pairs(fromI):
    seen.add name
  chk(seen == @["a", "b"], "IntoIterator")

uuidIntArrayRoundTrip()
putKeepsFirst()
accessors()
extractors()
typeIds()
listHelpers()
emptyList()
display()
equality()
conversions()

if failures > 0:
  echo $failures & " tag checks FAILED"
  quit(1)
echo "tag checks: OK"
