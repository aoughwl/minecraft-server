## Gzip byte codec for nbt_compress.aowl. Support module with no upstream file of its own: it is what
## the `flate2` crate is to pumpkin-nbt/src/nbt_compress.rs.
##
## z_stream is declared through <zlib.h>, so the C compiler lays it out and uLong is 4 bytes on LLP64
## Windows and 8 on LP64. zlib is linked statically on Windows so an exe needs no DLL beside it.

when defined(windows):
  {.passL: "-l:libz.a".}
else:
  {.passL: "-lz".}
{.feature: "lenientnils".}

type
  ZStream {.importc: "z_stream", header: "<zlib.h>", bycopy.} = object
    next_in: ptr byte
    avail_in: cuint
    next_out: ptr byte
    avail_out: cuint
    msg: cstring

  GzResult* = object
    ok*: bool
    data*: seq[byte]
    msg*: string ## the io::Error text flate2 gives for this failure

const
  zNoFlush = 0.cint
  zFinish = 4.cint
  zOk = 0.cint
  zStreamEnd = 1.cint
  zBufError = -5.cint
  zDeflated = 8.cint
  zDefaultCompression = -1.cint
  zDefaultStrategy = 0.cint
  wbitsGzip = 31.cint ## 15 + 16: write or expect a gzip wrapper
  gzHeaderLen = 10

proc deflateInit2Raw(s: ptr ZStream, level, meth, wbits, memLevel, strategy: cint,
                     version: cstring, size: cint): cint {.importc: "deflateInit2_", header: "<zlib.h>".}
proc zDeflate(s: ptr ZStream, flush: cint): cint {.importc: "deflate", header: "<zlib.h>".}
proc zDeflateEnd(s: ptr ZStream): cint {.importc: "deflateEnd", header: "<zlib.h>".}
proc zDeflateBound(s: ptr ZStream, n: culong): culong {.importc: "deflateBound", header: "<zlib.h>".}
proc inflateInit2Raw(s: ptr ZStream, wbits: cint, version: cstring, size: cint): cint
  {.importc: "inflateInit2_", header: "<zlib.h>".}
proc zInflate(s: ptr ZStream, flush: cint): cint {.importc: "inflate", header: "<zlib.h>".}
proc zInflateEnd(s: ptr ZStream): cint {.importc: "inflateEnd", header: "<zlib.h>".}
proc zVersion(): cstring {.importc: "zlibVersion", header: "<zlib.h>".}

proc okGz(d: sink seq[byte]): GzResult = GzResult(ok: true, data: d, msg: "")
proc errGz(m: string): GzResult = GzResult(ok: false, data: @[], msg: m)

proc gzipCompressBytes*(input: openArray[byte]): GzResult =
  ## GzEncoder with Compression::default(): level 6 and flate2's header, whose OS byte is 255.
  var s {.noinit.}: ZStream
  zeroMem(addr s, sizeof(ZStream))
  if deflateInit2Raw(addr s, zDefaultCompression, zDeflated, wbitsGzip, 8.cint, zDefaultStrategy,
                     zVersion(), cint(sizeof(ZStream))) != zOk:
    return errGz("deflateInit failed")
  var output = newSeq[byte](int(zDeflateBound(addr s, culong(input.len))) + 64)
  s.next_in = if input.len > 0: unsafeAddr input[0] else: nil
  s.avail_in = cuint(input.len)
  s.next_out = addr output[0]
  s.avail_out = cuint(output.len)
  let rc = zDeflate(addr s, zFinish)
  let left = int(s.avail_out)
  discard zDeflateEnd(addr s)
  if rc != zStreamEnd:
    return errGz("deflate failed: " & $int(rc))
  output.setLen(output.len - left)
  if output.len >= gzHeaderLen:
    output[9] = 255'u8
  okGz(output)

proc msgText(c: cstring): string =
  result = ""
  if c != nil:
    var i = 0
    while uint8(c[i]) != 0:
      result.add c[i]
      inc i

proc inflateError(s: var ZStream): string =
  case msgText(s.msg)
  of "incorrect header check", "unknown compression method", "unknown header flags set",
     "header crc mismatch":
    "invalid gzip header"
  of "incorrect data check", "incorrect length check":
    "corrupt gzip stream does not have a matching checksum"
  else:
    "corrupt deflate stream"

proc gzipDecompressBytes*(input: openArray[byte], limit: int): GzResult =
  ## GzDecoder::new(input).take(limit).read_to_end: output past `limit` is cut off, not an error, and
  ## then the trailer is never reached. Bytes after the first gzip member are ignored.
  var s {.noinit.}: ZStream
  zeroMem(addr s, sizeof(ZStream))
  if inflateInit2Raw(addr s, wbitsGzip, zVersion(), cint(sizeof(ZStream))) != zOk:
    return errGz("inflateInit failed")
  var output = newSeq[byte](min(max(input.len * 4, 4096), limit))
  s.next_in = if input.len > 0: unsafeAddr input[0] else: nil
  s.avail_in = cuint(input.len)
  s.next_out = addr output[0]
  s.avail_out = cuint(output.len)
  var used = 0
  while true:
    let rc = zInflate(addr s, zNoFlush)
    used = output.len - int(s.avail_out)
    if rc == zStreamEnd:
      break
    if rc != zOk and rc != zBufError:
      let m = inflateError(s)
      discard zInflateEnd(addr s)
      return errGz(m)
    if s.avail_out != 0:
      if s.avail_in == 0:
        discard zInflateEnd(addr s)
        return errGz("unexpected end of file")
      continue
    if output.len >= limit:
      break
    output.setLen(min(output.len * 2, limit))
    s.next_out = addr output[used]
    s.avail_out = cuint(output.len - used)
  discard zInflateEnd(addr s)
  output.setLen(used)
  okGz(output)
