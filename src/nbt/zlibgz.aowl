## Gzip byte codec for nbt_compress.aowl. Support module with no upstream file of its own: it is what
## the `flate2` crate is to pumpkin-nbt/src/nbt_compress.rs.
##
## A wrapper over src/util/zlibcore.aowl, the one zlib binding: this fixes the gzip wrapper.

import ../util/zlibcore

const gzHeaderLen = 10

type
  GzResult* = object
    ok*: bool
    data*: seq[byte]
    msg*: string ## the io::Error text flate2 gives for this failure

proc okGz(d: sink seq[byte]): GzResult = GzResult(ok: true, data: d, msg: "")
proc errGz(m: string): GzResult = GzResult(ok: false, data: @[], msg: m)

proc gzipCompressBytes*(input: openArray[byte]): GzResult =
  ## GzEncoder with Compression::default(): level 6 and flate2's header, whose OS byte is 255.
  let r = zlibDeflate(input, DefaultLevel, WbitsGzip)
  case r.failure
  of zfNone:
    var output = r.data
    if output.len >= gzHeaderLen:
      output[9] = 255'u8
    okGz(output)
  of zfInit: errGz("deflateInit failed")
  else: errGz("deflate failed: " & $r.rc)

proc gzipDecompressBytes*(input: openArray[byte], limit: int): GzResult =
  ## GzDecoder::new(input).take(limit).read_to_end: output past `limit` is cut off, not an error, and
  ## then the trailer is never reached. Bytes after the first gzip member are ignored.
  let r = zlibInflate(input, WbitsGzip, limit, lmTruncate)
  case r.failure
  of zfNone: okGz(r.data)
  of zfInit: errGz("inflateInit failed")
  of zfTruncated: errGz("unexpected end of file")
  else:
    case r.zmsg
    of "incorrect header check", "unknown compression method", "unknown header flags set",
       "header crc mismatch":
      errGz("invalid gzip header")
    of "incorrect data check", "incorrect length check":
      errGz("corrupt gzip stream does not have a matching checksum")
    else:
      errGz("corrupt deflate stream")
