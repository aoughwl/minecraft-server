## Scene tests for blast.aowl with REAL vanilla blocks (materials.aowl on the generated block data). Prints PASS/FAIL per check
## and "ALL PASS" (exit 0) when everything holds.
##
## VANILLA-LIKE REFERENCE RULE for crater volume (independent of the ray code): in a homogeneous medium of blast resistance r a
## ray pays a = (r + 0.3) * 0.3 at every sample it takes and 0.225 per 0.3-block step. The union over rays is governed by the
## STRONGEST ray aimed at a cell, not the mean: k = 1352 / (4 pi) / max(d^2, 1) rays aim at a cell at distance d and the best of
## k draws in 0.7..1.3 is h0 = power (0.7 + 0.6 k / (k + 1)). A ray of energy h0 that has
## taken n + 1 samples (n steps) destroys the cell it is in when h0 > (n + 1) a + n * 0.225, so it reaches R = 0.3 (h0 - a) / (a + 0.225)
## blocks. A cell is destroyed in the reference when its NEAREST point to the centre is within R (nearest = max(0, centre
## distance - 0.5)); the cell holding the centre counts when h0 > a. The reference counts those cells exactly. The model must land
## within max(2 cells, 40 percent) of it (real rays have h0 uniform in 0.7..1.3 power and 1352 discrete directions: a band).

{.feature: "untyped".}

import std/[syncio, monotimes, math]
import "../generated/block_properties"
import body
import bodymass
import materials
import solver
import solveradapter
import blast

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "  PASS ", what
  else:
    echo "  FAIL ", what
    inc failures

proc scene(name: string) = echo "SCENE ", name

proc sid(name: string): int =
  let b = Block.fromName(name)
  if b == nil:
    echo "FAIL unknown block ", name
    inc failures
    return 0
  return int(asU16(b.defaultState.id))

proc vanillaResistance(name: string): float64 =
  let b = Block.fromName(name)
  if b == nil: return -1.0
  return float64(b.blastResistance)

type Scene = object
  nx, ny, nz: int
  ids: seq[int]

proc newScene(nx, ny, nz: int): Scene = Scene(nx: nx, ny: ny, nz: nz, ids: newSeq[int](nx * ny * nz))
proc ci(s: Scene; x, y, z: int): int = x + s.nx * (z + s.nz * y)
proc put(s: var Scene; x, y, z: int; id: int) = s.ids[ci(s, x, y, z)] = id
proc fill(s: var Scene; id: int) =
  for i in 0 ..< s.ids.len: s.ids[i] = id

proc matOf(id: int): BlastMat =
  let m = materialOf(id)
  let air = m.matClass == mcVoid
  let solid = not (m.matClass == mcVoid or m.matClass == mcFluid or m.matClass == mcFoliage)
  var mass = 0.0
  if solid: mass = m.density * m.fill
  return BlastMat(present: not air, solid: solid, liquid: m.liquid, resistance: resistanceFromBreakKJ(m.breakThreshold, m.liquid),
                  state: id, mass: mass)

proc fnOf(s: Scene): CellFn =
  let ids = s.ids
  let nx = s.nx
  let nz = s.nz
  return proc (x, y, z: int): BlastMat {.closure.} = matOf(ids[x + nx * (z + nz * y)])

proc paramsFor(s: Scene; cx, cy, cz, power: float64; seed: uint64): BlastParams =
  return defaultBlastParams(cx, cy, cz, power, 0, 0, 0, s.nx, s.ny, s.nz, seed)

proc noTargets(): seq[BlastTarget] = @[]

let stone = sid("stone")
let dirt = sid("dirt")
let obsidian = sid("obsidian")
let water = sid("water")
let planks = sid("oak_planks")
let wool = sid("white_wool")
let iron = sid("iron_block")
let air = 0

proc refCount(s: Scene; cx, cy, cz, power, resistance: float64): int =
  let a = (resistance + 0.3) * 0.3
  var n = 0
  for y in 0 ..< s.ny:
    for z in 0 ..< s.nz:
      for x in 0 ..< s.nx:
        let dx = float64(x) + 0.5 - cx
        let dy = float64(y) + 0.5 - cy
        let dz = float64(z) + 0.5 - cz
        let d = sqrt(dx * dx + dy * dy + dz * dz)
        var dn = d - 0.5
        if dn < 0.0: dn = 0.0
        # rays aimed at this cell: 1352 / (4 pi) per steradian, the cell subtends 1 / max(d^2, 1); the strongest of k uniform
        # draws in 0.7..1.3 is about 0.7 + 0.6 k / (k + 1)
        var k = int(107.6 / (if d * d > 1.0: d * d else: 1.0))
        if k < 1: k = 1
        let h0 = power * (0.7 + 0.6 * float64(k) / float64(k + 1))
        if h0 <= a: continue
        let R = 0.3 * (h0 - a) / (a + 0.225)
        if dn <= R: inc n
  return n

# ---- 0. the energy criterion reproduces vanilla resistances -------------------------------------------------------------
scene "0 breakThreshold -> vanilla blast resistance"
block:
  var ok = true
  for nm in ["stone", "dirt", "obsidian", "oak_planks", "white_wool", "iron_block", "cobblestone", "sand"]:
    let vr = vanillaResistance(nm)
    let id = sid(nm)
    let m = materialOf(id)
    let r = resistanceFromBreakKJ(m.breakThreshold, m.liquid)
    if abs(r - vr) > 1.0e-3:
      echo "     mismatch ", nm, " ", r, " vs ", vr
      ok = false
  check(ok, "resistanceFromBreakKJ(table breakThreshold) equals Block.blastResistance for stone dirt obsidian planks wool iron cobble sand")
  check(resistanceFromBreakKJ(0.0, true) == 100.0, "water resistance is 100")

# ---- 1. crater volume ---------------------------------------------------------------------------------------------------
scene "1 power-4 blast: crater volume vs the reference rule"
proc crater(mat: int; resistance: float64; label: string) =
  var s = newScene(21, 21, 21)
  fill(s, mat)
  let c = 10.5
  let r = runBlast(paramsFor(s, c, c, c, 4.0, 12345'u64), fnOf(s), noTargets())
  let ref0 = refCount(s, c, c, c, 4.0, resistance)
  echo "     ", label, ": destroyed=", r.destroyed.len, " cracked=", r.cracked.len, " reference=", ref0, " debris=", r.debris.len,
       " ops=", r.ops
  var slack = (ref0 * 4) div 10
  if slack < 2: slack = 2
  check(abs(r.destroyed.len - ref0) <= slack, label & " crater within max(2 cells, 40 percent) of the reference")
crater(stone, 6.0, "stone")
crater(dirt, 0.5, "dirt")
crater(planks, 3.0, "oak planks")
block:
  # open air above a stone floor: half space crater is about half of the full one
  var s = newScene(21, 21, 21)
  for y in 0 ..< 11:
    for z in 0 ..< 21:
      for x in 0 ..< 21: put(s, x, y, z, dirt)
  let r = runBlast(paramsFor(s, 10.5, 11.0, 10.5, 4.0, 777'u64), fnOf(s), noTargets())
  var full = newScene(21, 21, 21)
  fill(full, dirt)
  let rf = runBlast(paramsFor(full, 10.5, 11.0, 10.5, 4.0, 777'u64), fnOf(full), noTargets())
  echo "     dirt surface blast: ", r.destroyed.len, " cells; same centre fully buried: ", rf.destroyed.len
  check(r.destroyed.len > 20 and r.destroyed.len < (rf.destroyed.len * 7) div 10, "surface blast digs a crater smaller than the buried one")

# ---- 2. obsidian, 3. water ----------------------------------------------------------------------------------------------
scene "2 obsidian survives power 4"
block:
  var s = newScene(21, 21, 21)
  fill(s, obsidian)
  let r = runBlast(paramsFor(s, 10.5, 10.5, 10.5, 4.0, 5'u64), fnOf(s), noTargets())
  check(r.destroyed.len == 0, "no obsidian cell destroyed by power 4 (destroyed=" & $r.destroyed.len & ")")
  var a = newScene(21, 21, 21)
  for z in 0 ..< 21:
    for x in 0 ..< 21: put(a, x, 5, z, obsidian)
  let r2 = runBlast(paramsFor(a, 10.5, 9.5, 10.5, 4.0, 6'u64), fnOf(a), noTargets())
  check(r2.destroyed.len == 0, "an obsidian slab 4 blocks below an open-air blast is intact")

scene "3 water shields what is behind it"
block:
  # centre in the air at y = 7.5; one layer of water (or air as the control) at y = 6; dirt below
  proc build(layer: int): Scene =
    var s = newScene(21, 14, 21)
    for z in 0 ..< 21:
      for x in 0 ..< 21:
        for y in 0 .. 5: put(s, x, y, z, dirt)
        put(s, x, 6, z, layer)
    return s
  let dry = build(air)
  let wet = build(water)
  let rd = runBlast(paramsFor(dry, 10.5, 7.5, 10.5, 4.0, 99'u64), fnOf(dry), noTargets())
  let rw = runBlast(paramsFor(wet, 10.5, 7.5, 10.5, 4.0, 99'u64), fnOf(wet), noTargets())
  echo "     dry: destroyed=", rd.destroyed.len, " wet: destroyed=", rw.destroyed.len
  check(rd.destroyed.len > 10, "control: without the water the blast digs the dirt")
  check(rw.destroyed.len == 0, "with one water layer between, no dirt cell and no water cell is destroyed")
  check(rw.cracked.len == 0, "and nothing is cracked either")


# ---- 4. plank bridge -----------------------------------------------------------------------------------------------------
scene "4 blast under one end of a plank bridge: solver drops the span (16 planks on two plank posts, TNT beside the left post)"
const BridgeLen = 16
proc bridgeScene(): Scene =
  var s = newScene(BridgeLen + 2, 12, 5)
  for z in 0 ..< 5:
    for x in 0 ..< BridgeLen + 2: put(s, x, 0, z, stone)
  for y in 1 .. 4:
    put(s, 1, y, 2, planks)
    put(s, BridgeLen, y, 2, planks)
  for x in 1 .. BridgeLen: put(s, x, 5, 2, planks)
  return s
block:
  var P = defaultAdapterParams()
  let s = bridgeScene()
  let before = solveSnapshot(s.ids, s.nx, s.ny, s.nz, P, floorAnchor, @[])
  check(before.broken.len == 0 and before.components.len == 0, "control: the intact bridge stands")
  let r = runBlast(paramsFor(s, 2.5, 3.0, 2.5, 4.0, 2024'u64), fnOf(s), noTargets())
  var planksGone = 0
  for c in r.destroyed:
    if s.ids[c] == planks: inc planksGone
  echo "     blast removed ", r.destroyed.len, " cells (", planksGone, " planks), cracked ", r.cracked.len
  var firstGone = 99
  var lastGone = -1
  for c in r.destroyed:
    if s.ids[c] == planks:
      let x = c mod s.nx
      if x < firstGone: firstGone = x
      if x > lastGone: lastGone = x
  echo "     planks removed span x=", firstGone, "..", lastGone, " of 1..", BridgeLen
  check(planksGone >= 4, "the blast removes the end post and plank cells (>= 4)")
  var inp = snapshotToSolverInput(s.ids, s.nx, s.ny, s.nz, P, floorAnchor)
  let added = applyBlastToSolverInput(inp, r)
  echo "     weakened-material clones: ", added
  var weaker = added > 0
  if r.cracked.len > 0:
    let cc = r.cracked[0]
    let base = snapshotToSolverInput(s.ids, s.nx, s.ny, s.nz, P, floorAnchor)
    if inp.cells[cc.cell] != 0'u16 and base.cells[cc.cell] != 0'u16:
      let m1 = inp.materials[int(inp.cells[cc.cell])]
      let m0 = base.materials[int(base.cells[cc.cell])]
      weaker = m1.compressive < m0.compressive and m1.compressive > 0.25 * m0.compressive and m1.mass == m0.mass
  check(weaker, "a cracked cell gets a clone with reduced strength (0.25x..1x) and the same mass")
  let after = solve(inp, adapterSolverParams())
  var planksFell = 0
  for comp in after.components:
    for c in comp.cells:
      if s.ids[c] == planks: inc planksFell
  for b in after.broken:
    if s.ids[b.cell] == planks: inc planksFell
  echo "     solver on the remainder: broken=", after.broken.len, " components=", after.components.len, " planks fallen/broken=", planksFell,
       " maxRatio=", after.maxRatio
  check(planksFell >= 6, "the span drops (at least 6 plank cells broken or detached)")
  # the cracked-strength path matters: apply only the destroyed cells, without weakening
  var inp2 = snapshotToSolverInput(s.ids, s.nx, s.ny, s.nz, P, floorAnchor)
  var r2 = r
  r2.cracked = @[]
  discard applyBlastToSolverInput(inp2, r2)
  let after2 = solve(inp2, adapterSolverParams())
  echo "     (without cracked weakening: broken=", after2.broken.len, " components=", after2.components.len, ")"

# ---- 5. light vs heavy body -----------------------------------------------------------------------------------------------
scene "5 a blast pushes a wool body farther than an iron body"
proc cubeBody(id: int; hi: uint64; x, y, z: float64): Body =
  var b = newBody(hi, 1'u64)
  for cz in 0 .. 1:
    for cy in 0 .. 1:
      for cx in 0 .. 1: setCell(b, cx, cy, cz, id)
  recomputeMass(b, defaultProps)
  b.pos = vec3(x, y, z)
  return b
block:
  var s = newScene(21, 21, 21)
  let wb = cubeBody(wool, 1'u64, 14.0, 10.0, 10.0)
  let ib = cubeBody(iron, 2'u64, 14.0, 10.0, 6.0)
  var ts: seq[BlastTarget] = @[]
  ts.add BlastTarget(kind: tkBody, idHi: 1'u64, idLo: 1'u64, body: wb)
  ts.add BlastTarget(kind: tkBody, idHi: 2'u64, idLo: 1'u64, body: ib)
  let r = runBlast(paramsFor(s, 8.5, 10.5, 8.0, 4.0, 3'u64), fnOf(s), ts)
  check(r.impulses.len == 2, "two impulse events")
  applyImpulseEvent(wb, r.impulses[0])
  applyImpulseEvent(ib, r.impulses[1])
  let vw = sqrt(wb.vel.x * wb.vel.x + wb.vel.y * wb.vel.y + wb.vel.z * wb.vel.z)
  let vi = sqrt(ib.vel.x * ib.vel.x + ib.vel.y * ib.vel.y + ib.vel.z * ib.vel.z)
  echo "     wool mass=", wb.mass, " speed=", vw, " b/t; iron mass=", ib.mass, " speed=", vi, " b/t; exposed cells ", r.impulses[0].exposed,
       "/", r.impulses[1].exposed
  check(vw > 4.0 * vi, "the wool body is pushed at least 4x faster than the iron body (mass ratio " & $(ib.mass / wb.mass) & ")")
  check(vw <= 3.0001, "speed is capped at 3 blocks/tick")
  check(wb.vel.x > 0.0, "pushed away from the blast")
  check(wb.angVel.x != 0.0 or wb.angVel.y != 0.0 or wb.angVel.z != 0.0, "an off-centre push also spins the body")

scene "5b debris: heavy cells fly slower, same resistance"
block:
  # custom world: uniform resistance 0.5, left half mass 300, right half mass 3000
  let fn: CellFn = proc (x, y, z: int): BlastMat {.closure.} =
    BlastMat(present: true, solid: true, liquid: false, resistance: 0.5, state: 1, mass: (if x < 10: 300.0 else: 3000.0))
  var p = defaultBlastParams(10.0, 10.0, 10.0, 4.0, 0, 0, 0, 21, 21, 21, 31'u64)
  p.debrisChance = 1.0
  let r = runBlast(p, fn, noTargets())
  var sl = 0.0
  var nl = 0
  var sh = 0.0
  var nh = 0
  for d in r.debris:
    let sp = sqrt(d.vx * d.vx + d.vy * d.vy + d.vz * d.vz)
    if d.mass < 1000.0:
      sl += sp
      inc nl
    else:
      sh += sp
      inc nh
  let ml = sl / float64(nl)
  let mh = sh / float64(nh)
  echo "     fragments ", r.debris.len, " light mean speed ", ml, " heavy mean speed ", mh
  check(nl > 5 and nh > 5, "both kinds produce fragments")
  check(ml > 3.0 * mh, "light fragments fly > 3x faster than heavy ones")
  var kindsOk = true
  for d in r.debris:
    if (d.mass < 1200.0) != (d.kind == dkParticle): kindsOk = false
  check(kindsOk, "light fragments are particles, heavy ones bodies")
  var found = false
  for d in r.debris:
    if d.kind == dkBody:
      let b = makeDebrisBody(d, 9'u64, 9'u64)
      found = abs(b.mass - 3000.0) < 1e-9 and cellCount(b) == 1
      break
  check(found, "a heavy fragment becomes a 1-cell body with the cell's mass")

scene "5c shielding: a stone wall protects bodies and entities"
block:
  var s = newScene(21, 21, 21)
  for y in 0 ..< 21:
    for z in 0 ..< 21: put(s, 12, y, z, obsidian)     # a wall at x = 12 that cannot be broken
  let open = newScene(21, 21, 21)
  let b1 = cubeBody(wool, 1'u64, 14.0, 10.0, 10.0)
  let b2 = cubeBody(wool, 1'u64, 14.0, 10.0, 10.0)
  var ts1: seq[BlastTarget] = @[]
  ts1.add BlastTarget(kind: tkBody, idHi: 1'u64, idLo: 1'u64, body: b1)
  ts1.add BlastTarget(kind: tkEntity, idHi: 5'u64, idLo: 5'u64, x: 14.0, y: 10.0, z: 10.5, w: 0.6, h: 1.8, mass: 70.0)
  var ts2: seq[BlastTarget] = @[]
  ts2.add BlastTarget(kind: tkBody, idHi: 1'u64, idLo: 1'u64, body: b2)
  ts2.add BlastTarget(kind: tkEntity, idHi: 5'u64, idLo: 5'u64, x: 14.0, y: 10.0, z: 10.5, w: 0.6, h: 1.8, mass: 70.0)
  let rOpen = runBlast(paramsFor(open, 9.5, 10.5, 10.5, 4.0, 8'u64), fnOf(open), ts1)
  let rWall = runBlast(paramsFor(s, 9.5, 10.5, 10.5, 4.0, 8'u64), fnOf(s), ts2)
  echo "     body exposed cells open/wall: ", rOpen.impulses[0].exposed, "/", rWall.impulses[0].exposed,
       "; entity exposure open/wall: ", rOpen.impulses[1].exposed, "/", rWall.impulses[1].exposed
  let ent = rOpen.impulses[1]
  let vEnt = sqrt(ent.linear.x * ent.linear.x + ent.linear.y * ent.linear.y + ent.linear.z * ent.linear.z) / 70.0
  echo "     entity at 4.5 blocks, open: knockback ", vEnt, " b/t (vanilla (1 - d/8) * exposure = ", (1.0 - 4.5 / 8.0) * rOpen.impulses[1].exposed, ")"
  check(rOpen.impulses[0].exposed >= 8.0, "open: all 8 cells of the body see the blast")
  check(rWall.impulses[0].exposed == 0.0, "wall: the body is fully shielded")
  check(rWall.impulses[0].linear.x == 0.0, "wall: no linear impulse")
  check(rOpen.impulses[1].exposed > 0.9 and rWall.impulses[1].exposed == 0.0, "entity exposure 1 in the open, 0 behind the wall")
  check(abs(vEnt - (1.0 - 4.5 / 8.0) * rOpen.impulses[1].exposed) < 0.08, "entity knockback matches vanilla's (1 - d/(2 power)) * exposure")

# ---- 6. determinism, budget slicing ----------------------------------------------------------------------------------------
scene "6 determinism and budgeted slicing"
proc same(a, b: BlastResult): bool =
  if a.destroyed.len != b.destroyed.len or a.cracked.len != b.cracked.len or a.debris.len != b.debris.len: return false
  for i in 0 ..< a.destroyed.len:
    if a.destroyed[i] != b.destroyed[i]: return false
  for i in 0 ..< a.cracked.len:
    if a.cracked[i].cell != b.cracked[i].cell or a.cracked[i].mult != b.cracked[i].mult: return false
  for i in 0 ..< a.debris.len:
    if a.debris[i].cell != b.debris[i].cell or a.debris[i].vx != b.debris[i].vx or a.debris[i].vy != b.debris[i].vy or
       a.debris[i].vz != b.debris[i].vz: return false
  return true
block:
  var s = newScene(31, 31, 31)
  for i in 0 ..< s.ids.len:
    s.ids[i] = (if (i mod 7) == 0: stone elif (i mod 5) == 0: planks else: dirt)
  let p = paramsFor(s, 15.5, 15.5, 15.5, 6.0, 4242'u64)
  let a = runBlast(p, fnOf(s), noTargets())
  let b = runBlast(p, fnOf(s), noTargets())
  check(a.destroyed.len > 100, "scene is non-trivial (destroyed=" & $a.destroyed.len & ")")
  check(same(a, b), "same seed: identical destroyed, cracked and debris")
  let c = runBlast(paramsFor(s, 15.5, 15.5, 15.5, 6.0, 4243'u64), fnOf(s), noTargets())
  check(not same(a, c), "different seed: different result")
  var j = newBlastJob(p, fnOf(s), noTargets())
  var calls = 0
  var maxCall = 0'i64
  while true:
    let before = j.res.ops
    inc calls
    let fin = stepBlast(j, 300)
    let used = j.res.ops - before
    if used > maxCall: maxCall = used
    if fin: break
  echo "     sliced: ", calls, " calls of budget 300, largest call ", maxCall, " ops, total ", j.res.ops, " ops"
  check(same(a, j.res), "budget 300 slicing gives the identical result")
  check(calls > 20, "the work was spread over many calls")
  check(maxCall < 4200, "no call exceeded 4200 ops (budget + one indivisible chunk)")

# ---- 7. performance --------------------------------------------------------------------------------------------------------
scene "7 performance: power 20 blast"
block:
  let (ox, oy, oz, size) = blastBox(0.0, 0.0, 0.0, 20.0)
  var s = newScene(size, size, size)
  for i in 0 ..< s.ids.len:
    s.ids[i] = (if (i mod 11) == 0: stone elif (i mod 3) == 0: dirt else: air)
  let c = float64(size) * 0.5
  let p = paramsFor(s, c, c, c, 20.0, 1'u64)
  let t0 = getMonoTime()
  let r = runBlast(p, fnOf(s), noTargets())
  let ms = (ticks(getMonoTime()) - ticks(t0)) div 1000000'i64
  echo "     box ", size, "^3 = ", size * size * size, " cells, destroyed ", r.destroyed.len, " cracked ", r.cracked.len, " debris ", r.debris.len,
       " ops ", r.ops, " in ", ms, " ms"
  check(ms < 1500, "power 20 blast in one go within 1500 ms")
  var j = newBlastJob(p, fnOf(s), noTargets())
  var worst = 0'i64
  var calls = 0
  while true:
    let t1 = getMonoTime()
    let fin = stepBlast(j, 20000)
    let m = (ticks(getMonoTime()) - ticks(t1)) div 1000'i64
    if m > worst: worst = m
    inc calls
    if fin: break
  echo "     incremental (budget 20000 ops): ", calls, " calls, slowest call ", worst, " us"
  check(worst < 20000, "incremental form: every call under 20 ms (tick-friendly)")
  check(same(r, j.res), "incremental result equals one-shot")

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
