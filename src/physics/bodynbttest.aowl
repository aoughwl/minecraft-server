## Unit tests for bodynbt.aowl: save/load round trip (tag level and through the NBT byte codec). "ALL PASS" on success.

{.feature: "untyped".}

import std/[syncio, options]
import ../nbt/tag
import ../nbt/nbtbase
import ../nbt/serializer
import ../nbt/deserializer
import body
import bodymass
import bodynbt
import materials

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc tprops(state: int): CellProps =
  case state
  of 1: CellProps(density: 1000.0, fill: 1.0)
  of 2: CellProps(density: 3000.0, fill: 1.0)
  of 3: CellProps(density: 500.0, fill: 0.5)
  else: CellProps(density: 0.0, fill: 0.0)

let props: PropsFn = tprops

proc sample(): Body =
  let b = newBody(0x0123456789ABCDEF'u64, 0xFEDCBA9876543210'u64)
  # three sections, one with negative coordinates, 3 states, interleaved palette history
  setCell(b, 0, 0, 0, 2)
  setCell(b, 1, 0, 0, 1)
  setCell(b, 2, 0, 0, 3)
  setCell(b, -20, 3, 40, 1)
  setCell(b, 17, 16, -1, 2)
  setCell(b, 1, 0, 0, 0)       # leaves an unused palette entry behind in memory
  setCell(b, 1, 0, 0, 3)
  b.pos = vec3(-100.5, 64.25, 3.0e5 + 0.125)
  b.orient = qnormalize(Quat(w: 0.9, x: 0.1, y: -0.3, z: 0.2))
  b.vel = vec3(0.01, -0.5, 0.0003)
  b.angVel = vec3(0.001, 0.002, -0.003)
  b.sleeping = true
  b.sleepTicks = 33
  recomputeMass(b, props)
  b

let a = sample()
let tg = bodyToNbt(a)
let (ok, back) = bodyFromNbt(tg, props)
check(ok, "load succeeds")
check(sameVolumeAndPose(a, back), "round trip equal: id, cells, pose, velocities, sleep")
check(back.mass == a.mass and back.com.x == a.com.x and back.com.y == a.com.y and back.com.z == a.com.z,
      "mass and com recomputed identically")
var inertiaSame = true
for i in 0 ..< 6: inertiaSame = inertiaSame and back.inertia[i] == a.inertia[i]
check(inertiaSame, "inertia recomputed identically")
check(back.cellCount == 5 and back.sections.len == 3, "5 cells in 3 sections")

# canonical output: saving the loaded body gives the identical NBT
check(NbtTag(kind: ntkCompound, compoundVal: bodyToNbt(back)) == NbtTag(kind: ntkCompound, compoundVal: tg),
      "save(load(save(b))) == save(b)")

# through the byte codec
var w = newNbtWriter(nwmJava)
check(serialize(NbtTag(kind: ntkCompound, compoundVal: tg), w).isOk, "serialize to bytes")
var r = newNbtReader(nrmJava, w.buf)
let dec = deserialize(r)
check(dec.isOk and dec.value.kind == ntkCompound, "deserialize from bytes")
let (ok2, back2) = bodyFromNbt(dec.value.compoundVal, props)
check(ok2 and sameVolumeAndPose(a, back2), "byte round trip equal")

# an empty body
let e = newBody(5'u64, 6'u64)
let (ok3, eb) = bodyFromNbt(bodyToNbt(e), props)
check(ok3 and sameVolumeAndPose(e, eb) and eb.mass == 0.0, "empty body round trip")

# malformed input is rejected, not crashed on
var bad = tg
discard remove(bad, "Id")
check(not bodyFromNbt(bad, props)[0], "missing Id rejected")
var bad2 = tg
insert(bad2, "Version", NbtTag(kind: ntkInt, intVal: 99'i32))
check(not bodyFromNbt(bad2, props)[0], "unknown version rejected")
var bad3 = tg
insert(bad3, "Pos", NbtTag(kind: ntkList, listVal: @[nbtTag(1.0'f64)]))
check(not bodyFromNbt(bad3, props)[0], "short Pos rejected")

# real material seam round trip
let rb = newBody(1'u64, 1'u64)
setCell(rb, 0, 0, 0, 1)
setCell(rb, 1, 0, 0, 1)
recomputeMass(rb, defaultProps)
let (ok4, rb2) = bodyFromNbt(bodyToNbt(rb), defaultProps)
check(ok4 and rb2.mass == rb.mass and rb.mass == 2.0 * massOfState(1), "real materials: round trip and mass = 2 * massOfState")

echo checks, " checks, ", failures, " failures"
if failures == 0:
  echo "ALL PASS"
else:
  quit(1)
