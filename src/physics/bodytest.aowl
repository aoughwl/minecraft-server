## Unit tests for body.aowl and bodymass.aowl with hand-computed values. Exit 0 and "ALL PASS" when everything holds.
## Uses materials_stub.aowl for the fallback table and an injected PropsFn so the numbers are exact.

{.feature: "untyped".}

import std/[syncio, math]
import body
import bodymass
import materials_stub

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc near(a, b: float64, eps: float64 = 1e-9): bool = abs(a - b) <= eps * (1.0 + abs(b))

proc nearV(a: Vec3, x, y, z: float64): bool = near(a.x, x) and near(a.y, y) and near(a.z, z)

# test table: state 1 = 1000 kg/m3, 2 = 3000, 3 = 500 with fill 0.5 (a slab: 250 kg per cell)
proc tprops(state: int): CellProps =
  case state
  of 1: CellProps(density: 1000.0, fill: 1.0)
  of 2: CellProps(density: 3000.0, fill: 1.0)
  of 3: CellProps(density: 500.0, fill: 0.5)
  else: CellProps(density: 0.0, fill: 0.0)

let props: PropsFn = tprops

proc build(cells: openArray[(int, int, int, int)]): Body =
  var b = newBody(1'u64, 2'u64)
  for c in cells: setCell(b, c[0], c[1], c[2], c[3])
  recomputeMass(b, props)
  b

# --- stub table ---
check(materialOf(1).density == 2400.0 and materialOf(5).fill == 0.5 and materialOf(0).fill == 0.0, "stub table values")

# --- single block ---
# M = 1000. com = cell centre (.5,.5,.5). Inertia of a unit cube of mass m: m/6 per axis = 166.667, no products.
let single = build([(0, 0, 0, 1)])
check(near(single.mass, 1000.0), "single block mass")
check(nearV(single.com, 0.5, 0.5, 0.5), "single block com is the cell centre")
check(near(single.inertia[0], 1000.0 / 6.0) and near(single.inertia[1], 1000.0 / 6.0) and
      near(single.inertia[2], 1000.0 / 6.0), "single block inertia m/6")
check(near(single.inertia[3], 0.0) and near(single.inertia[4], 0.0) and near(single.inertia[5], 0.0),
      "single block products of inertia zero")

# --- translation invariance, negative coordinates, several sections ---
let far = build([(-3, 5, 20, 1)])
check(nearV(far.com, -2.5, 5.5, 20.5), "far single block com")
check(near(far.inertia[0], 1000.0 / 6.0), "far single block inertia unchanged by translation")
check(far.sections.len == 1 and far.sections[0].sx == -1 and far.sections[0].sz == 1, "section coordinates floor-divide")

# --- slab: mass = density * fill ---
let slab = build([(0, 0, 0, 3)])
check(near(slab.mass, 250.0), "slab mass = density * fill")

# --- 2x1x1 bar of two materials ---
# A (1000) at x=0, B (3000) at x=1. M = 4000. comx = (1000*.5 + 3000*1.5)/4000 = 1.25, comy = comz = .5.
# Ixx = self = 4000/6 = 666.667 (y,z offsets are 0). Iyy = Izz = self + sum m dx^2 = 666.667 + (1000*.75^2 + 3000*.25^2) = 1416.667
let bar = build([(0, 0, 0, 1), (1, 0, 0, 2)])
check(near(bar.mass, 4000.0), "bar mass")
check(nearV(bar.com, 1.25, 0.5, 0.5), "bar com")
check(near(bar.inertia[0], 4000.0 / 6.0), "bar Ixx")
check(near(bar.inertia[1], 4000.0 / 6.0 + 750.0) and near(bar.inertia[2], 4000.0 / 6.0 + 750.0), "bar Iyy Izz")

# --- cubes: I = M a^2 / 6 about the centre ---
var cube2: seq[(int, int, int, int)] = @[]
for x in 0 ..< 2:
  for y in 0 ..< 2:
    for z in 0 ..< 2: cube2.add (x, y, z, 1)
let c2 = build(cube2)
check(near(c2.mass, 8000.0) and nearV(c2.com, 1.0, 1.0, 1.0), "2x2x2 cube mass and com")
check(near(c2.inertia[0], 8000.0 * 4.0 / 6.0) and near(c2.inertia[1], 8000.0 * 4.0 / 6.0) and
      near(c2.inertia[2], 8000.0 * 4.0 / 6.0), "2x2x2 cube inertia M a^2/6")
check(near(c2.inertia[3], 0.0, 1e-9) and near(c2.inertia[4], 0.0, 1e-9) and near(c2.inertia[5], 0.0, 1e-9),
      "2x2x2 cube products zero")
var cube3: seq[(int, int, int, int)] = @[]
for x in -1 ..< 2:
  for y in 0 ..< 3:
    for z in 17 ..< 20: cube3.add (x, y, z, 1)
let c3 = build(cube3)
check(near(c3.mass, 27000.0) and nearV(c3.com, 0.5, 1.5, 18.5), "3x3x3 cube mass and com (spans sections)")
check(near(c3.inertia[1], 27000.0 * 9.0 / 6.0), "3x3x3 cube inertia M a^2/6 = 40500")
check(c3.sections.len == 2, "3x3x3 cube spans 2 x sections")

# --- dumbbell ---
# cells x=0..4, ends (x=0,4) state 2 (3000), middle (x=1,2,3) state 1 (1000). M = 6000 + 3000 = 9000, comx = 2.5.
# Ixx = 9000/6 = 1500. Iyy = Izz = 1500 + 2*3000*2^2 + 1000*(1 + 0 + 1) = 1500 + 24000 + 2000 = 27500.
let dumbbell = build([(0, 0, 0, 2), (1, 0, 0, 1), (2, 0, 0, 1), (3, 0, 0, 1), (4, 0, 0, 2)])
check(near(dumbbell.mass, 9000.0) and nearV(dumbbell.com, 2.5, 0.5, 0.5), "dumbbell mass and com")
check(near(dumbbell.inertia[0], 1500.0) and near(dumbbell.inertia[1], 27500.0) and near(dumbbell.inertia[2], 27500.0),
      "dumbbell inertia")

# --- splitConnected ---
let diag = [Cell(x: 0, y: 0, z: 0, state: 1), Cell(x: 1, y: 1, z: 0, state: 1)]
check(splitConnected(diag).len == 2, "diagonal contact is not connected")
let line = [Cell(x: 0, y: 0, z: 0, state: 1), Cell(x: 5, y: 5, z: 5, state: 1), Cell(x: 1, y: 0, z: 0, state: 1),
            Cell(x: 5, y: 5, z: 6, state: 1), Cell(x: 2, y: 0, z: 0, state: 1)]
let comps = splitConnected(line)
check(comps.len == 2 and comps[0] == @[0, 2, 4] and comps[1] == @[1, 3], "splitConnected components and order")
check(splitConnected(newSeq[Cell](0)).len == 0, "splitConnected of nothing")

# --- break the dumbbell's middle cell: incremental mass equals full recompute, then split in two ---
let n = breakCells(dumbbell, [Cell(x: 2, y: 0, z: 0, state: 0), Cell(x: 9, y: 9, z: 9, state: 0)], props)
check(n == 1 and dumbbell.cellCount == 4, "breakCells removes only existing cells")
check(near(dumbbell.mass, 8000.0) and nearV(dumbbell.com, 2.5, 0.5, 0.5), "mass after break (incremental)")
let inc1 = dumbbell.inertia
recomputeMass(dumbbell, props)
var same = near(dumbbell.mass, 8000.0)
for i in 0 ..< 6: same = same and near(inc1[i], dumbbell.inertia[i], 1e-9)
check(same, "incremental inertia equals full recompute")
dumbbell.angVel = vec3(0.0, 0.0, 0.1)
dumbbell.pos = vec3(10.0, 20.0, 30.0)
let parts = splitBody(dumbbell, props)
check(parts.len == 2, "dumbbell splits into 2 bodies")
check(near(parts[0].mass + parts[1].mass, 8000.0) and near(parts[0].mass, 4000.0), "split masses sum to the original")
check(nearV(parts[0].com, 0.75, 0.5, 0.5) and nearV(parts[1].com, 4.25, 0.5, 0.5), "split centres of mass")
check(parts[0].idHi == dumbbell.idHi and parts[0].idLo == dumbbell.idLo and
      (parts[1].idHi != dumbbell.idHi or parts[1].idLo != dumbbell.idLo), "first child keeps the id, the other is new")
# v = omega x r, omega = (0,0,.1), r = (-1.75,0,0): (0, -0.175, 0)
check(nearV(parts[0].vel, 0.0, -0.175, 0.0) and nearV(parts[1].vel, 0.0, 0.175, 0.0), "children inherit omega x r")
check(nearV(parts[1].pos, 10.0, 20.0, 30.0), "children keep the parent frame")
check(splitBody(single, props).len == 1, "connected body is not split")

# --- incremental setCellMass vs recompute on an irregular layout ---
let irr = build([(0, 0, 0, 1), (1, 0, 0, 2), (1, 1, 0, 3), (-5, 2, 17, 1)])
setCellMass(irr, 3, 3, 3, 2, props)
setCellMass(irr, 0, 0, 0, 0, props)
setCellMass(irr, 1, 0, 0, 1, props)
let before = irr.inertia
let bm = irr.mass
recomputeMass(irr, props)
var ok = near(bm, irr.mass)
for i in 0 ..< 6: ok = ok and near(before[i], irr.inertia[i], 1e-9)
check(ok, "setCellMass incremental equals recompute")

# --- sections come and go ---
let sb = newBody(0'u64, 0'u64)
setCell(sb, -1, 0, 0, 1)
setCell(sb, 16, 0, 0, 2)
setCell(sb, 0, 0, 0, 1)
check(sb.sections.len == 3 and sb.cellCount == 3, "three sections")
check(sb.sections[0].sx == -1 and sb.sections[1].sx == 0 and sb.sections[2].sx == 1, "sections sorted by coordinate")
check(getCell(sb, -1, 0, 0) == 1 and getCell(sb, 16, 0, 0) == 2 and getCell(sb, 5, 5, 5) == 0, "getCell")
setCell(sb, 16, 0, 0, 0)
check(sb.sections.len == 2, "emptied section is deleted")
check(cellList(sb).len == 2 and cellList(sb)[0].x == -1, "cellList canonical order")

# --- pose history ---
# tick t has pos.x = 2t, orientation about +y by angle 0.1 t. 31 samples are recorded; 24 survive (ticks 107..130).
proc yq(angle: float64): Quat = Quat(w: cos(angle / 2.0), x: 0.0, y: sin(angle / 2.0), z: 0.0)
let ph = newBody(3'u64, 4'u64)
check(not poseAt(ph, 5.0)[0], "empty history answers false")
for t in 100 .. 130:
  ph.pos = vec3(2.0 * float64(t), 0.0, 0.0)
  ph.orient = yq(0.1 * float64(t))
  recordPose(ph, t)
check(poseAt(ph, 130.0)[0] and near(poseAt(ph, 130.0)[1].x, 260.0), "newest sample")
check(poseAt(ph, 107.0)[0] and near(poseAt(ph, 107.0)[1].x, 214.0), "oldest retained sample")
check(not poseAt(ph, 106.0)[0] and not poseAt(ph, 100.0)[0], "overwritten samples are gone")
check(not poseAt(ph, 106.5)[0], "between a gone sample and the oldest retained is not answerable")
check(not poseAt(ph, 130.5)[0], "the future is not answerable")
let mid = poseAt(ph, 120.25)
check(mid[0] and near(mid[1].x, 240.5), "interpolated position")
let want = yq(0.1 * 120.25)
check(near(mid[2].w, want.w, 1e-9) and near(mid[2].y, want.y, 1e-9) and near(mid[2].x, 0.0), "slerped orientation")
let q0 = yq(0.0)
let qh = slerp(q0, yq(1.0), 0.5)
check(near(qh.w, cos(0.25), 1e-12) and near(qh.y, sin(0.25), 1e-12), "slerp halfway")
let rot = rotate(yq(PI / 2.0), vec3(1.0, 0.0, 0.0))
check(nearV(rot, 0.0, 0.0, -1.0), "rotate +x by 90 degrees about +y gives -z")

# --- sleep ---
let sl = newBody(0'u64, 0'u64)
for i in 0 ..< 19: updateSleep(sl, 0.01, 0.005, 20)
check(not sl.sleeping, "not asleep after 19 quiet ticks")
updateSleep(sl, 0.01, 0.005, 20)
check(sl.sleeping, "asleep after 20 quiet ticks")
sl.vel = vec3(0.5, 0.0, 0.0)
updateSleep(sl, 0.01, 0.005, 20)
check(not sl.sleeping and sl.sleepTicks == 0, "motion wakes the body")

# --- the real material seam produces a positive mass for a real state (state 1 is stone in the vanilla table) ---
let real = newBody(0'u64, 0'u64)
setCell(real, 0, 0, 0, 1)
recomputeMass(real, defaultProps)
check(real.mass > 0.0, "defaultProps (materials.aowl) gives a positive mass")

echo checks, " checks, ", failures, " failures"
if failures == 0:
  echo "ALL PASS"
else:
  quit(1)
