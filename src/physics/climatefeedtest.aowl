## Tests for climatefeed.aowl (the pure feed). Prints PASS/FAIL lines, "ALL PASS" and exit 0 when everything holds.

{.feature: "untyped".}

import std/syncio
import std/math
import windfield
import climate
import climatefeed
import "../server/net/jester/windmsg"

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc fabs(v: float): float = (if v < 0.0: -v else: v)

let seed = 20240607
const Day = 24000.0

# 1. the yaw convention of PROTOCOL.md: 0 = +Z, pi/2 = -X
check(fabs(windYaw(0.0, 5.0)) < 1e-9, "wind toward +Z has yaw 0")
check(fabs(windYaw(-5.0, 0.0) - 1.5707963) < 1e-6, "wind toward -X has yaw pi/2")
check(fabs(windYaw(5.0, 0.0) + 1.5707963) < 1e-6, "wind toward +X has yaw -pi/2")

# 2. the gust factor of the REAL weather multiplies the synoptic wind, the synoptic part is the same
block:
  let calm = feedAt(seed, 5000.0, 100.0, 63.0, 200.0, 0.0, 0.0)
  let storm = feedAt(seed, 5000.0, 100.0, 63.0, 200.0, 1.0, 1.0)
  check(fabs(calm.synX - storm.synX) < 1e-12 and fabs(calm.synZ - storm.synZ) < 1e-12, "real weather does not change the synoptic wind")
  let rc = sqrt(calm.windX * calm.windX + calm.windZ * calm.windZ)
  let rs = sqrt(storm.windX * storm.windX + storm.windZ * storm.windZ)
  check(rc > 0.01, "the synoptic wind here is not zero (" & $rc & ")")
  check(fabs(rs / rc - 1.9) < 1e-9, "thunderstorm weather multiplies the wind by 1.9 (" & $(rs / rc) & ")")

# 3. time of day / date: the same place a half year apart has a different climate (temperature follows the season)
block:
  let yr = yearDays() * Day
  var warm = 0.0
  var cold = 0.0
  var n = 0
  var px = 0.0
  while px < 6000.0:
    warm += feedAt(seed, 0.375 * yr, px, 63.0, 100.0, 0.0, 0.0).temp
    cold += feedAt(seed, 0.875 * yr, px, 63.0, 100.0, 0.0, 0.0).temp
    n += 1
    px += 500.0
  check(warm / float(n) - cold / float(n) > 15.0, "midsummer is more than 15 C warmer than midwinter (" & $(warm / float(n) - cold / float(n)) & ")")
  check(feedAt(seed, 0.375 * yr, 0.0, 63.0, 0.0, 0.0, 0.0).season == 1 and feedAt(seed, 0.875 * yr, 0.0, 63.0, 0.0, 0.0, 0.0).season == 3,
        "season 1 (summer) at 0.375 year, 3 (winter) at 0.875")
  let a = feedAt(seed, 1000.0, 300.0, 63.0, 300.0, 0.0, 0.0)
  let b = feedAt(seed, 1000.0 + 3.0 * Day, 300.0, 63.0, 300.0, 0.0, 0.0)
  check(fabs(a.synX - b.synX) + fabs(a.synZ - b.synZ) > 0.05, "three days later the wind at the same place differs")

# 4. parameters: base fields kept, speed and yaw replaced, clamped
block:
  var base = defaultWindParams()
  base.turbulence = 0.9'f32
  base.flags = 1'u8
  let f = FeedSample(temp: 5.0, season: 0, synX: 0.0, synZ: 6.0, windX: 0.0, windZ: 6.0, speed: 6.0)
  let p = feedWindParams(base, f)
  check(fabs(float(p.baseSpeed) - 6.0) < 1e-6 and fabs(float(p.baseYaw)) < 1e-6, "feedWindParams: speed 6, yaw 0 for a +Z wind")
  check(p.turbulence == 0.9'f32 and p.flags == 1'u8 and p.spatialScale == base.spatialScale and p.weatherGain == base.weatherGain,
        "feedWindParams keeps every other parameter of the base")
  let g = FeedSample(temp: 5.0, season: 0, synX: 100.0, synZ: 0.0, windX: 100.0, windZ: 0.0, speed: 100.0)
  check(feedWindParams(base, g).baseSpeed == float32(FeedMaxSpeed), "base speed is clamped to " & $FeedMaxSpeed)
  let calm = FeedSample(speed: 0.0)
  check(feedWindParams(base, calm).baseYaw == base.baseYaw, "no wind keeps the previous yaw")

# 5. hysteresis
block:
  var a = defaultWindParams()
  var b = a
  check(not feedChanged(a, b), "identical parameters are not a change")
  b.baseSpeed = a.baseSpeed + 0.05'f32
  check(not feedChanged(a, b), "0.05 b/s is below the hysteresis")
  b.baseSpeed = a.baseSpeed + 0.2'f32
  check(feedChanged(a, b), "0.2 b/s is a change")
  b = a
  b.baseYaw = 0.1'f32
  check(feedChanged(a, b), "0.1 rad is a change")
  a.baseYaw = 3.13'f32
  b.baseYaw = -3.13'f32
  check(not feedChanged(a, b), "yaw difference wraps around pi")

# 6. through the windfield: with the feed provider windAtWorld blows along the feed direction and follows the real weather
block:
  setWindSeed(seed)
  clearWindTerrain()
  var bestX = 0.0
  var bestSpeed = 0.0
  var px = 0.0
  while px < 9000.0:      # find a place with a clear wind
    let f = feedAt(seed, 4000.0, px, 63.0, 0.0, 0.0, 0.0)
    if f.speed > bestSpeed:
      bestSpeed = f.speed
      bestX = px
    px += 300.0
  let f0 = feedAt(seed, 4000.0, bestX, 63.0, 0.0, 0.0, 0.0)
  setWindWeather(0.0, 0.0)
  setWeatherProvider(feedProvider(seed, bestX, 0.0, 0.0, 0.0, 4000.0))
  var dot = 0.0
  var sumv = 0.0
  for t in 0 ..< 40:
    let v = windAtWorld(float(t) * 37.0, bestX, 70.0, 0.0)
    dot += v.x * f0.synX + v.z * f0.synZ
    sumv += v.speed
  check(bestSpeed > 1.0 and dot > 0.0, "windAtWorld blows along the feed direction (dot " & $dot & ", feed speed " & $bestSpeed & ")")
  setWeatherProvider(feedProvider(seed, bestX, 0.0, 1.0, 1.0, 4000.0))
  var sumStorm = 0.0
  for t in 0 ..< 40:
    sumStorm += windAtWorld(float(t) * 37.0, bestX, 70.0, 0.0).speed
  check(sumStorm > sumv * 1.2, "with real thunder the field is stronger than in calm weather (" & $sumv & " -> " & $sumStorm & ")")
  clearWeatherProvider()

echo "checks ", checks, " failures ", failures
if failures == 0:
  echo "ALL PASS"
else:
  quit(1)
