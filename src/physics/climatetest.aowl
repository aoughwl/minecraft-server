## Tests for climate.aowl. Prints PASS/FAIL lines, "ALL PASS" and exit 0 when everything holds.

{.feature: "untyped".}

import std/syncio
import std/math
import windfield
import climate

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc r3(v: float): float = float(int(v * 1000.0 + (if v < 0.0: -0.5 else: 0.5))) / 1000.0
proc fabs(v: float): float = (if v < 0.0: -v else: v)
proc cdiv(a, b: float): float = a / b

let seed = 20240607
const Day = 24000.0

# deterministic pseudo-random sample points, independent of climate's own hash
var rng = 88172645
proc nextUnit(): float =
  rng = (rng * 1103515245 + 12345) and 0x7FFFFFFF
  float(rng) / 2147483648.0

# 1. determinism
block:
  let a = climateAt(seed, 123456.5, 77.25, 90.0, -1234.5)
  let _ = climateAt(seed + 1, 999.0, 5.0, 70.0, 5.0)
  let b = climateAt(seed, 123456.5, 77.25, 90.0, -1234.5)
  check(a.temp == b.temp and a.humidity == b.humidity and a.pressure == b.pressure and a.rain == b.rain and
        a.thunder == b.thunder and a.snow == b.snow and a.windX == b.windX and a.windZ == b.windZ,
        "same inputs give identical output (interleaved call between)")
  let c = climateAt(seed + 1, 123456.5, 77.25, 90.0, -1234.5)
  check(c.temp != a.temp or c.pressure != a.pressure, "a different seed gives a different climate")
  check(yearDays() == 24.0, "default year is 24 days")

# 2. continuity: step 1 tick and 1 block everywhere in a random cloud of points
block:
  var maxT = 0.0
  var maxH = 0.0
  var maxP = 0.0
  var maxR = 0.0
  var maxTh = 0.0
  var maxS = 0.0
  var maxW = 0.0
  var maxXT = 0.0
  var maxXH = 0.0
  var maxXP = 0.0
  var maxXR = 0.0
  var maxXTh = 0.0
  var maxXW = 0.0
  for i in 0 ..< 1500:
    let t = nextUnit() * 100.0 * Day
    let x = (nextUnit() - 0.5) * 40000.0
    let z = (nextUnit() - 0.5) * 40000.0
    let y = 40.0 + nextUnit() * 120.0
    let a = climateAt(seed, t, x, y, z)
    let bt = climateAt(seed, t + 1.0, x, y, z)
    maxT = max(maxT, fabs(bt.temp - a.temp))
    maxH = max(maxH, fabs(bt.humidity - a.humidity))
    maxP = max(maxP, fabs(bt.pressure - a.pressure))
    maxR = max(maxR, fabs(bt.rain - a.rain))
    maxTh = max(maxTh, fabs(bt.thunder - a.thunder))
    maxS = max(maxS, fabs(bt.snow - a.snow))
    maxW = max(maxW, max(fabs(bt.windX - a.windX), fabs(bt.windZ - a.windZ)))
    let bx = climateAt(seed, t, x + 1.0, y, z)
    let bz = climateAt(seed, t, x, y, z + 1.0)
    maxXT = max(maxXT, max(fabs(bx.temp - a.temp), fabs(bz.temp - a.temp)))
    maxXH = max(maxXH, max(fabs(bx.humidity - a.humidity), fabs(bz.humidity - a.humidity)))
    maxXP = max(maxXP, max(fabs(bx.pressure - a.pressure), fabs(bz.pressure - a.pressure)))
    maxXR = max(maxXR, max(fabs(bx.rain - a.rain), fabs(bz.rain - a.rain)))
    maxXTh = max(maxXTh, max(fabs(bx.thunder - a.thunder), fabs(bz.thunder - a.thunder)))
    maxXW = max(maxXW, max(max(fabs(bx.windX - a.windX), fabs(bx.windZ - a.windZ)),
                           max(fabs(bz.windX - a.windX), fabs(bz.windZ - a.windZ))))
  echo "[continuity] max per tick: temp ", r3(maxT), " hum ", r3(maxH), " pres ", r3(maxP), " rain ", r3(maxR),
       " thunder ", r3(maxTh), " snow ", r3(maxS), " wind ", r3(maxW)
  echo "[continuity] max per block: temp ", r3(maxXT), " hum ", r3(maxXH), " pres ", r3(maxXP), " rain ", r3(maxXR),
       " thunder ", r3(maxXTh), " wind ", r3(maxXW)
  check(maxT < 0.01 and maxH < 0.001 and maxP < 0.01 and maxR < 0.01 and maxTh < 0.02 and maxW < 0.02,
        "per-tick change is small (temp<0.01 C, hum<0.001, pres<0.01 hPa, rain<0.01, thunder<0.02, wind<0.02 b/s)")
  check(maxXT < 0.02 and maxXH < 0.01 and maxXP < 0.05 and maxXR < 0.03 and maxXTh < 0.06 and maxXW < 0.05,
        "per-block change is small (temp<0.02 C, hum<0.01, pres<0.05 hPa, rain<0.03, thunder<0.06, wind<0.05 b/s)")

# 3. temperature falls with altitude
block:
  var ok = true
  var n = 0
  for i in 0 ..< 200:
    let t = nextUnit() * 50.0 * Day
    let x = (nextUnit() - 0.5) * 30000.0
    let z = (nextUnit() - 0.5) * 30000.0
    let lo = climateAt(seed, t, x, 63.0, z)
    let hi = climateAt(seed, t, x, 200.0, z)
    if not (hi.temp < lo.temp): ok = false
    inc n
  check(ok, "temperature at y=200 below y=63 at 200 random places and times")
  let a = climateAt(seed, 5000.0, 10.0, 0.0, 10.0)
  let b = climateAt(seed, 5000.0, 10.0, 100.0, 10.0)
  echo "[altitude] dT over 100 blocks (dry): ", r3(b.temp - a.temp), " C"

# 4. winter colder than summer; seasons
block:
  var colder = 0
  var sumS = 0.0
  var sumW = 0.0
  var total = 0
  let yt = yearDays() * Day
  for i in 0 ..< 200:
    let x = (nextUnit() - 0.5) * 30000.0
    let z = (nextUnit() - 0.5) * 30000.0
    var s = 0.0
    var w = 0.0
    for d in 0 ..< 4:
      let yr = float(d) * yt
      # same place, same time of day, midsummer and midwinter
      s += climateAt(seed, yr + 0.375 * yt, x, 63.0, z).temp
      w += climateAt(seed, yr + 0.875 * yt, x, 63.0, z).temp
    sumS += s
    sumW += w
    if w < s: inc colder
    inc total
  echo "[seasons] mean T midsummer ", r3(sumS / 800.0), " C, midwinter ", r3(sumW / 800.0), " C, winter colder at ", colder, "/", total
  check(colder >= 190, "winter colder than summer at the same place (>=95% of places)")
  check(sumS / 800.0 - sumW / 800.0 > 15.0, "mean summer-winter difference > 15 C")
  check(seasonOf(0.0) == 0 and seasonOf(0.3 * yt) == 1 and seasonOf(0.6 * yt) == 2 and seasonOf(0.9 * yt) == 3 and
        seasonOf(1.1 * yt) == 0, "seasonOf walks spring, summer, autumn, winter and wraps")
  let tintSpring = foliageTint(0)
  check(tintSpring != foliageTint(1) and foliageTint(2) != foliageTint(3), "foliage tints differ by season")
  var maxStep = 0
  var prev = foliageTintAt(0.0)
  var tt = 0.0
  while tt < 2.0 * yt:
    tt += 600.0
    let c = foliageTintAt(tt)
    let dr = (c shr 16) - (prev shr 16)
    let dg = ((c shr 8) and 255) - ((prev shr 8) and 255)
    let db = (c and 255) - (prev and 255)
    let m = max(max(fabs(float(dr)), fabs(float(dg))), fabs(float(db)))
    if int(m) > maxStep: maxStep = int(m)
    prev = c
  echo "[tint] max channel step per 600 ticks: ", maxStep
  check(maxStep <= 2, "foliageTintAt is smooth (<=2 per channel per 600 ticks)")
  check(foliageTintAt(0.125 * yt) == foliageTint(0), "foliageTintAt hits the spring anchor mid-spring")
  # snow line: higher in summer than winter
  var higher = 0
  for i in 0 ..< 100:
    let x = (nextUnit() - 0.5) * 30000.0
    let z = (nextUnit() - 0.5) * 30000.0
    if snowLineAt(seed, 0.375 * yt, x, z) > snowLineAt(seed, 0.875 * yt, x, z): inc higher
  check(higher >= 95, "snow line is higher in summer than in winter")

# 5. storm frequency over 100 simulated days at three places, every 120 ticks
block:
  var n = 0
  var rainAny = 0
  var rainHeavy = 0
  var thunderAny = 0
  var thunderStrong = 0
  var snowAny = 0
  var seasonN: array[4, int]
  var seasonRain: array[4, int]
  var seasonThunder: array[4, int]
  var seasonSnow: array[4, int]
  for k in 0 ..< 4:
    seasonN[k] = 0
    seasonRain[k] = 0
    seasonThunder[k] = 0
    seasonSnow[k] = 0
  for place in 0 ..< 3:
    let x = float(place) * 7000.0 - 5000.0
    let z = float(place) * -4000.0 + 1500.0
    var t = 0.0
    while t < 100.0 * Day:
      let c = climateAt(seed, t, x, 63.0, z)
      let s = seasonOf(t)
      inc n
      inc seasonN[s]
      if c.rain > 0.1:
        inc rainAny
        inc seasonRain[s]
      if c.rain > 0.5: inc rainHeavy
      if c.thunder > 0.1:
        inc thunderAny
        inc seasonThunder[s]
      if c.thunder > 0.5: inc thunderStrong
      if c.snow > 0.1:
        inc snowAny
        inc seasonSnow[s]
      t += 120.0
  let fr = cdiv(float(rainAny), float(n))
  let fh = cdiv(float(rainHeavy), float(n))
  let ft = cdiv(float(thunderAny), float(n))
  let fs = cdiv(float(thunderStrong), float(n))
  let fsn = cdiv(float(snowAny), float(n))
  echo "[storms] over 100 days x 3 places (", n, " samples): rain>0.1 ", r3(fr), "  rain>0.5 ", r3(fh), "  thunder>0.1 ", r3(ft),
       "  thunder>0.5 ", r3(fs), "  snow>0.1 ", r3(fsn)
  for s in 0 ..< 4:
    echo "[storms] ", seasonName(s), ": rain ", r3(cdiv(float(seasonRain[s]), float(seasonN[s]))), " thunder ",
         r3(cdiv(float(seasonThunder[s]), float(seasonN[s]))), " snow ", r3(cdiv(float(seasonSnow[s]), float(seasonN[s])))
  check(fr > 0.08 and fr < 0.45, "rain fraction plausible (0.08..0.45)")
  check(ft > 0.005 and ft < 0.15, "thunder fraction plausible (0.005..0.15)")
  check(ft < fr, "thunder rarer than rain")
  check(seasonThunder[1] >= seasonThunder[3], "thunder at least as common in summer as in winter")
  check(seasonSnow[3] > seasonSnow[1], "snow more common in winter than in summer")

# 6. pressure gradient and wind direction consistency
block:
  var good = 0
  var tried = 0
  var minAng = 2.0
  var maxAng = 0.0
  var maxSpeed = 0.0
  for i in 0 ..< 400:
    let t = nextUnit() * 60.0 * Day
    let x = (nextUnit() - 0.5) * 30000.0
    let z = (nextUnit() - 0.5) * 30000.0
    let ps = pressureSea(seed, t, x, z)
    # numeric gradient (central difference) must agree with the analytic one
    let pxp = pressureSea(seed, t, x + 1.0, z).p
    let pxm = pressureSea(seed, t, x - 1.0, z).p
    let pzp = pressureSea(seed, t, x, z + 1.0).p
    let pzm = pressureSea(seed, t, x, z - 1.0).p
    let ngx = (pxp - pxm) / 2.0
    let ngz = (pzp - pzm) / 2.0
    let mag = sqrt(ngx * ngx + ngz * ngz)
    let c = climateAt(seed, t, x, 63.0, z)
    let wsp = sqrt(c.windX * c.windX + c.windZ * c.windZ)
    if wsp > maxSpeed: maxSpeed = wsp
    if mag > 0.0008 and wsp > 0.0:
      inc tried
      # low on the left of the wind: cross(wind, G) sign with G = -grad; angle between wind and G is 70 degrees
      let lx = -ngx
      let lz = -ngz
      let cosA = (c.windX * lx + c.windZ * lz) / (wsp * mag)
      # rotation sense: G rotated by -90 deg on the map is (-lz, lx); wind must have a positive component on it
      let along = (c.windX * (-lz) + c.windZ * lx) / (wsp * mag)
      let ang = cosA
      if ang < minAng: minAng = ang
      if ang > maxAng: maxAng = ang
      if along > 0.0 and cosA > 0.0 and fabs(ang - 0.3402) < 0.004 and fabs(ps.gx - ngx) < 0.0002 and fabs(ps.gz - ngz) < 0.0002:
        inc good
  echo "[pressure] ", tried, " points with a real gradient; cos(angle(wind, toward-low)) in ", r3(minAng), "..", r3(maxAng),
       " (expect 0.340 = 70 deg); max synoptic wind ", r3(maxSpeed), " b/s"
  check(tried > 100, "enough points with a real pressure gradient")
  check(good == tried, "wind = geostrophic rotation of the pressure gradient (70 deg to the low, analytic = numeric gradient)")
  check(maxSpeed < 12.0 * 1.9 + 0.01, "synoptic wind bounded")

# 7. cyclone rotation sense: locate a low and a high, circle them
proc extremum(t: float, low: bool): (float, float) =
  var bx = 0.0
  var bz = 0.0
  var bp = (if low: 1.0e9 else: -1.0e9)
  var x = -9000.0
  while x <= 9000.0:
    var z = -9000.0
    while z <= 9000.0:
      let p = pressureSea(seed, t, x, z).p
      if (low and p < bp) or ((not low) and p > bp):
        bp = p
        bx = x
        bz = z
      z += 150.0
    x += 150.0
  # refine
  var step = 100.0
  while step > 0.5:
    var moved = true
    while moved:
      moved = false
      for k in 0 ..< 4:
        let nx = bx + (if k == 0: step elif k == 1: -step else: 0.0)
        let nz = bz + (if k == 2: step elif k == 3: -step else: 0.0)
        let p = pressureSea(seed, t, nx, nz).p
        if (low and p < bp) or ((not low) and p > bp):
          bp = p
          bx = nx
          bz = nz
          moved = true
    step = step / 2.0
  (bx, bz)

block:
  var lowOk = 0
  var lowN = 0
  var highOk = 0
  var highN = 0
  var inflowLow = 0
  var outflowHigh = 0
  var lowDepth = 1013.0
  var highTop = 1013.0
  for trial in 0 ..< 4:
    let t = float(trial) * 9.0 * Day + 3.3 * Day
    let (lx, lz) = extremum(t, true)
    let (hx, hz) = extremum(t, false)
    let pl = pressureSea(seed, t, lx, lz).p
    let ph = pressureSea(seed, t, hx, hz).p
    if pl < lowDepth: lowDepth = pl
    if ph > highTop: highTop = ph
    for k in 0 ..< 8:
      # unit ring offsets without trig: 8 compass points
      let ux = (if k == 0 or k == 1 or k == 7: 1.0 elif k == 3 or k == 4 or k == 5: -1.0 else: 0.0)
      let uz = (if k == 1 or k == 2 or k == 3: 1.0 elif k == 5 or k == 6 or k == 7: -1.0 else: 0.0)
      let l = sqrt(ux * ux + uz * uz)
      let rx = ux / l * 500.0
      let rz = uz / l * 500.0
      if pl < 1005.0:
        let c = climateAt(seed, t, lx + rx, 63.0, lz + rz)
        inc lowN
        # map-ccw (north = -z): rx*vz - rz*vx < 0
        if rx * c.windZ - rz * c.windX < 0.0: inc lowOk
        if rx * c.windX + rz * c.windZ < 0.0: inc inflowLow
      if ph > 1021.0:
        let c = climateAt(seed, t, hx + rx, 63.0, hz + rz)
        inc highN
        if rx * c.windZ - rz * c.windX > 0.0: inc highOk
        if rx * c.windX + rz * c.windZ > 0.0: inc outflowHigh
  echo "[cyclone] deepest low ", r3(lowDepth), " hPa, highest high ", r3(highTop), " hPa; ring samples low ", lowOk, "/", lowN,
       " counter-clockwise (inflow ", inflowLow, "), high ", highOk, "/", highN, " clockwise (outflow ", outflowHigh, ")"
  check(lowN >= 8 and highN >= 8, "found pronounced lows and highs to test")
  check(lowOk == lowN and inflowLow * 10 >= lowN * 9, "cyclone (low): counter-clockwise rotation at all ring points, inflow at >=90%")
  check(highOk == highN and outflowHigh * 10 >= highN * 9, "anticyclone (high): clockwise rotation at all ring points, outflow at >=90%")
  check(lowDepth < 1000.0 and highTop > 1026.0, "pressure range realistic (low <1000, high >1026 hPa)")

# 8. snow only when cold; rain/snow split
block:
  var snowN = 0
  var badSnow = 0
  var maxSnowTemp = -100.0
  var liquidWarm = 0
  var coldRain = 0
  var rainN = 0
  var snowFrac = 0.0
  for i in 0 ..< 6000:
    let t = nextUnit() * 100.0 * Day
    let x = (nextUnit() - 0.5) * 40000.0
    let z = (nextUnit() - 0.5) * 40000.0
    let y = 40.0 + nextUnit() * 200.0
    let c = climateAt(seed, t, x, y, z)
    if c.snow > 0.0:
      inc snowN
      if c.temp > maxSnowTemp: maxSnowTemp = c.temp
      if c.temp >= 0.5: inc badSnow
    if c.snow > c.rain + 1.0e-9: inc badSnow
    if c.rain > 0.1:
      inc rainN
      if c.temp > 2.0 and c.snow > 0.0: inc badSnow
      if c.temp > 2.0: inc liquidWarm
      if c.temp < -2.0 and c.snow < c.rain * 0.99: inc coldRain
  echo "[snow] samples with snow ", snowN, "; warmest snow temp ", r3(maxSnowTemp), " C; rain samples ", rainN, ", warm (liquid) ", liquidWarm
  check(snowN > 20, "some snow occurs")
  check(badSnow == 0, "snow only when T < 0.5 C, never above rain, none when T > 2 C")
  check(liquidWarm > 20, "warm precipitation falls as rain")
  check(coldRain == 0, "precipitation below -2 C is all snow")

# 9. year length is configurable
block:
  setYearDays(8.0)
  check(seasonOf(0.30 * 8.0 * Day) == 1 and seasonOf(0.9 * 8.0 * Day) == 3, "setYearDays(8) rescales the seasons")
  setYearDays(24.0)

# 10. windfield integration: climate wind as the provider vs calm
block:
  var diff = 0
  var dotGood = 0
  var dotN = 0
  var stormSpeed = 0.0
  var stormN = 0
  var calmSpeed = 0.0
  var calmN = 0
  var sameCount = 0
  var finite = true
  var maxSp = 0.0
  var feedCases = 0
  for place in 0 ..< 4:
    let x = float(place) * 3333.0 - 4000.0
    let z = float(place) * 1777.0 - 2500.0
    let prov = weatherProviderFor(seed, x, z)
    var t = 0.0
    while t < 30.0 * Day:
      setWindSeed(seed)
      clearWindTerrain()
      setWindWeather(0.0, 0.0)
      clearWeatherProvider()
      let calm = windAtWorld(t, x, 70.0, z)
      setWeatherProvider(prov)
      let wf = windAtWorld(t, x, 70.0, z)
      let cl = climateAt(seed, t, x, 63.0, z)
      if wf.speed != wf.speed or wf.speed > 60.0: finite = false
      if wf.speed > maxSp: maxSp = wf.speed
      if fabs(wf.x - calm.x) + fabs(wf.z - calm.z) > 0.01: inc diff
      if wf.x == calm.x and wf.z == calm.z: inc sameCount
      let csp = sqrt(cl.windX * cl.windX + cl.windZ * cl.windZ)
      if csp > 0.5:
        inc dotN
        if wf.x * cl.windX + wf.z * cl.windZ > 0.0: inc dotGood
      if cl.rain > 0.6 and cl.thunder > 0.3:
        stormSpeed += wf.speed
        inc stormN
        calmSpeed += calm.speed
        inc calmN
      inc feedCases
      t += 211.0
  clearWeatherProvider()
  echo "[windfield] ", feedCases, " samples; differs from calm in ", diff, ", identical ", sameCount, "; climate-fed storms ", stormN,
       " mean speed ", (if stormN > 0: r3(stormSpeed / float(stormN)) else: 0.0), " b/s vs calm-field at the same moments ",
       (if calmN > 0: r3(calmSpeed / float(calmN)) else: 0.0), " b/s; max fed speed ", r3(maxSp)
  check(finite, "climate-fed wind is finite and below 60 b/s")
  check(diff * 2 > feedCases, "climate feed changes the wind in most samples vs calm")
  check(dotN > 100 and dotGood == dotN, "fed wind points along the climate wind (open terrain)")
  # also the weather levels reach windcore: rain from the provider raises the windcore factor over the dry call
  let dry = windAt(seed, 5000.0, 10.0, 70.0, 10.0, 0.0, 0.0)
  let wet = windAt(seed, 5000.0, 10.0, 70.0, 10.0, 1.0, 1.0)
  check(wet.speed > dry.speed, "windcore sanity: storm wind above calm (reference for the feed)")

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
