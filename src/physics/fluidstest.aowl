## Tests for fluids.aowl (pure). Prints PASS/FAIL per check and "ALL PASS" (exit 0) when everything holds.

{.feature: "untyped".}

import std/[syncio, tables]
import fluids

const Full = 1024

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "  PASS ", what
  else:
    echo "  FAIL ", what
    inc failures

# A world: a box [0,w) x [0,h) x [0,d); everything outside is solid; `walls` are extra solid cells.
type World = ref object
  w, h, d: int
  walls: Table[int64, bool]

proc newWorld(w, h, d: int): World = World(w: w, h: h, d: d, walls: initTable[int64, bool]())
proc wall(wo: World; x, y, z: int) = wo.walls[cellKey(x, y, z)] = true
proc unwall(wo: World; x, y, z: int) = wo.walls.del(cellKey(x, y, z))
proc solid(wo: World; x, y, z: int): bool =
  x < 0 or y < 0 or z < 0 or x >= wo.w or y >= wo.h or z >= wo.d or wo.walls.hasKey(cellKey(x, y, z))
proc sim(wo: World; cap: int = 1024; comp: int = 48; lavaPeriod: int = 3): FluidSim =
  newFluidSim(proc(x, y, z: int): bool {.closure.} = solid(wo, x, y, z), cap, comp, lavaPeriod)

proc scene(name: string) = echo "SCENE ", name

proc layerMass(s: FluidSim; wo: World; y: int): int =
  result = 0
  for z in 0 ..< wo.d:
    for x in 0 ..< wo.w:
      result += s.massAt(x, y, z)

proc conserved(s: FluidSim): bool = s.totalMass() == s.injected - s.drained

# 1. falling -----------------------------------------------------------------------------------------------------------
scene "a pour falls down a shaft and fills it from the bottom"
block:
  let wo = newWorld(1, 12, 1)
  let s = sim(wo)
  var ok = true
  # 5.5 cells of water poured in at the top, one cell at a time
  var poured = 0
  for i in 0 ..< 6:
    poured += s.addFluid(0, 11, 0, KindWater, Full)
    for k in 0 ..< 3:
      discard s.step(100)
      if not conserved(s):
        ok = false
  poured += s.addFluid(0, 11, 0, KindWater, Full div 2)
  let n = s.settle(100, 500)
  check(ok, "mass conserved after every step while pouring")
  check(poured == 6 * Full + Full div 2, "all water accepted (" & $poured & ")")
  check(s.idle(), "settles (" & $n & " steps)")
  check(s.totalMass() == int64(poured), "total mass equals what was poured (" & $s.totalMass() & ")")
  check(s.massAt(0, 0, 0) >= Full and s.massAt(0, 4, 0) >= Full and s.massAt(0, 11, 0) == 0, "water is at the bottom, none left at the top")
  check(s.columnTop(0, 0, 0, 11) >= 5 and s.columnTop(0, 0, 0, 11) <= 6, "column top is at the expected height (" & $s.columnTop(0, 0, 0, 11) & ")")

# 2. settling on a flat floor --------------------------------------------------------------------------------------------
scene "a puddle spreads flat and stops"
block:
  let wo = newWorld(9, 12, 9)
  let s = sim(wo)
  for y in 0 ..< 10:
    discard s.addFluid(4, y, 4, KindWater, Full)
  let n = s.settle(1000, 5000)
  check(s.idle(), "settles (" & $n & " steps)")
  check(conserved(s) and s.totalMass() == 10 * Full, "mass 10*Full conserved")
  var lo = 1000
  var hi = 0
  for z in 0 ..< 9:
    for x in 0 ..< 9:
      let m = s.massAt(x, 0, z)
      if m < lo: lo = m
      if m > hi: hi = m
  check(hi - lo <= 8, "floor layer is flat to 8 units of 1024 (min " & $lo & " max " & $hi & ")")
  check(layerMass(s, wo, 1) < 4 * Full, "the water lies on the floor, not in a column (layer 1 holds " & $layerMass(s, wo, 1) & ")")
  let ops = s.step(100)
  check(ops == 0, "a settled puddle costs 0 ops per step")

scene "four-way symmetry: a drop on the floor spreads without a preferred direction"
block:
  let wo = newWorld(11, 4, 11)
  let s = sim(wo)
  discard s.addFluid(5, 0, 5, KindWater, Full)
  for i in 0 ..< 3:
    discard s.step(100)
  # compare the four arms: +x, -x, +z, -z at distance 1..2
  var ok = true
  for dist in 1 .. 2:
    let a = s.massAt(5 + dist, 0, 5)
    let b = s.massAt(5 - dist, 0, 5)
    let c = s.massAt(5, 0, 5 + dist)
    let d = s.massAt(5, 0, 5 - dist)
    if max(max(a, b), max(c, d)) - min(min(a, b), min(c, d)) > 40:
      ok = false
    echo "     dist ", dist, ": ", a, " ", b, " ", c, " ", d
  check(ok, "arms differ by <= 40 units of 1024")

# 3. communicating vessels -------------------------------------------------------------------------------------------------
scene "communicating vessels: a U tube reaches the same level on both legs"
block:
  # x 0 = left leg, x 1..4 wall except the bottom row, x 5 = right leg; y 0 is the connecting channel.
  let wo = newWorld(6, 26, 1)
  for x in 1 .. 4:
    for y in 1 ..< 26:
      wo.wall(x, y, 0)
  let s = sim(wo)
  var total = 0
  # fill the left leg 20 cells high
  for y in 0 ..< 20:
    total += s.addFluid(0, y, 0, KindWater, Full)
  var steps = 0
  while steps < 4000 and (steps < 5 or not s.idle()):
    discard s.step(1000)
    inc steps
  check(s.idle(), "settles (" & $steps & " steps)")
  check(s.totalMass() == int64(total), "mass conserved (" & $s.totalMass() & " of " & $total & ")")
  let tl = s.columnTop(0, 0, 0, 25)
  let tr = s.columnTop(5, 0, 0, 25)
  echo "     tops left ", tl, " right ", tr
  check(abs(tl - tr) <= 1, "both legs end at the same level (+-1 cell)")
  check(tr >= 6, "the right leg really filled (top " & $tr & ")")
  check(tl <= 10, "the left leg really dropped (top " & $tl & ")")

scene "communicating vessels: a wide and a narrow vessel share a level"
block:
  # left 1 wide, right 3 wide (z), joined along y 0
  let wo = newWorld(6, 26, 3)
  for x in 1 .. 4:
    for y in 1 ..< 26:
      for z in 0 ..< 3:
        wo.wall(x, y, z)
  # left leg is one column at z=1 only
  for y in 0 ..< 26:
    wo.wall(0, y, 0)
    wo.wall(0, y, 2)
  for x in 1 .. 4:
    wo.wall(x, 0, 0)
    wo.wall(x, 0, 2)
  let s = sim(wo)
  var total = 0
  for y in 0 ..< 22:
    total += s.addFluid(0, y, 1, KindWater, Full)
  var steps = 0
  while steps < 6000 and (steps < 5 or not s.idle()):
    discard s.step(1000)
    inc steps
  check(s.idle(), "settles (" & $steps & " steps)")
  check(s.totalMass() == int64(total), "mass conserved")
  var rt = -1
  for z in 0 ..< 3:
    let t = s.columnTop(5, z, 0, 25)
    if t > rt: rt = t
  let tl = s.columnTop(0, 1, 0, 25)
  echo "     tops narrow ", tl, " wide ", rt
  check(abs(tl - rt) <= 1, "surfaces within 1 cell")
  check(tl <= 8 and rt >= 2, "the water moved to the wide vessel (narrow top " & $tl & ")")

# 4. conservation under abuse -----------------------------------------------------------------------------------------------
scene "conservation with pours, drains, a removed wall and a tiny budget"
block:
  let wo = newWorld(10, 10, 10)
  for y in 0 ..< 4:
    for x in 0 ..< 10:
      wo.wall(x, y, 5)
  let s = sim(wo)
  var bad = 0
  var net: array[3, int64] = [0'i64, 0, 0]
  check(sim(wo).addFluid(0, 5, 5, KindWater, 0) == 0 and sim(wo).addFluid(0, 0, 5, KindWater, 100) == 0, "adding fluid into a wall or nothing is refused")
  var seed = 12345
  for t in 0 ..< 400:
    seed = (seed * 1103515245 + 12345) and 0x7fffffff
    let x = (seed shr 8) mod 10
    let z = (seed shr 12) mod 10
    let y = 4 + (seed shr 16) mod 6
    if t mod 7 == 0:
      let kk = if (seed and 1) == 0: KindWater else: KindLava
      net[kk] += int64(s.addFluid(x, y, z, kk, 1 + (seed shr 4) mod Full))
    if t mod 11 == 0:
      let rk = s.kindAt(x, y, z)
      net[rk] -= int64(s.removeFluid(x, y, z, 20))
    if t == 200:
      for x2 in 0 ..< 10:
        wo.unwall(x2, 0, 5)
        s.wakeAround(x2, 0, 5)
    discard s.step(7)
    if not conserved(s):
      inc bad
  check(bad == 0, "totalMass == injected - drained after each of 400 steps")
  var leaked = 0
  for k, c in s.cells:
    if solid(wo, keyX(k), keyY(k), keyZ(k)) or c.mass <= 0:
      inc leaked
  check(leaked == 0, "no fluid inside a wall or outside the box, no empty records")
  var mixed = 0
  for k, c in s.cells:
    if c.kind != KindWater and c.kind != KindLava:
      inc mixed
  check(mixed == 0, "every occupied cell has exactly one valid kind")
  check(s.totalMass(KindWater) == net[KindWater] and s.totalMass(KindLava) == net[KindLava], "each kind's mass equals its own injected - drained (water " & $net[KindWater] & ", lava " & $net[KindLava] & ")")
  check(s.contacts > 0, "water/lava contacts were refused, not mixed (" & $s.contacts & ")")

# 5. determinism --------------------------------------------------------------------------------------------------------------
scene "determinism"
block:
  proc run(budget: int): (int64, int64) =
    let wo = newWorld(8, 8, 8)
    for x in 2 .. 5:
      wo.wall(x, 1, 3)
    let s = sim(wo)
    for i in 0 ..< 5:
      discard s.addFluid(1 + i, 6, 2, KindWater, Full)
      discard s.addFluid(6, 5, 1 + i, KindLava, 640)
    var n = 0
    while n < 300:
      discard s.step(budget)
      inc n
    (s.checksum(), s.totalMass())
  let a = run(1000)
  let b = run(1000)
  check(a == b, "two identical runs give the same state (checksum " & $a[0] & ")")
  let c = run(5)
  let d = run(5)
  check(c == d, "two identical budget-5 runs give the same state")
  check(a[1] == c[1] and a[1] == 5 * Full + 5 * 640, "total mass is the same for any budget (" & $a[1] & ")")

# 6. budget ---------------------------------------------------------------------------------------------------------------------
scene "budget"
block:
  let wo = newWorld(20, 5, 20)
  let s = sim(wo)
  for x in 0 ..< 20:
    for z in 0 ..< 20:
      discard s.addFluid(x, 3, z, KindWater, 480)
  let ops = s.step(25)
  check(ops == 25, "step(25) processed exactly 25 cells (" & $ops & ")")
  check(not s.idle(), "the rest stays awake")
  let n = s.settle(25, 100000)
  check(s.idle() and conserved(s), "a 25-cell budget still settles (" & $n & " steps) and conserves")

# 7. lava -----------------------------------------------------------------------------------------------------------------------
scene "lava is slower than water and the two never mix"
block:
  proc settleSteps(kind: int): int =
    let wo = newWorld(12, 3, 1)
    let s = sim(wo)
    discard s.addFluid(0, 0, 0, kind, Full)
    discard s.addFluid(1, 0, 0, kind, Full)
    discard s.addFluid(2, 0, 0, kind, Full)
    s.settle(1000, 5000)
  let w = settleSteps(KindWater)
  let l = settleSteps(KindLava)
  echo "     settle steps: water ", w, " lava ", l
  check(l >= 2 * w, "lava needs at least twice the steps (" & $l & " vs " & $w & ")")
  let wo = newWorld(12, 3, 1)
  let s = sim(wo)
  discard s.addFluid(0, 0, 0, KindWater, Full)
  discard s.addFluid(11, 0, 0, KindLava, Full)
  discard s.settle(1000, 5000)
  var wmass = 0
  var lmass = 0
  for x in 0 ..< 12:
    let c = s.cellOf(x, 0, 0)
    if c.kind == KindWater: wmass += int(c.mass)
    if c.kind == KindLava: lmass += int(c.mass)
  check(wmass == Full and lmass == Full, "each kind keeps its own mass (water " & $wmass & " lava " & $lmass & ")")

# 8. pressure ---------------------------------------------------------------------------------------------------------------------
scene "pressure pushes water up an open pipe"
block:
  # a reservoir (x 0, 10 high) with a full column drains through a channel into a pipe (x 3) that rises 6 cells
  let wo = newWorld(4, 12, 1)
  for x in 1 .. 2:
    for y in 1 ..< 12:
      wo.wall(x, y, 0)
  let s = sim(wo)
  for y in 0 ..< 10:
    discard s.addFluid(0, y, 0, KindWater, Full)
  discard s.settle(1000, 5000)
  let top = s.columnTop(3, 0, 0, 11)
  echo "     pipe top ", top, " reservoir top ", s.columnTop(0, 0, 0, 11)
  check(top >= 3 and abs(top - s.columnTop(0, 0, 0, 11)) <= 1, "the pipe rises to the reservoir level by pressure alone (top " & $top & ")")

echo ""
if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo failures, " FAILED of ", checks
  quit(1)
