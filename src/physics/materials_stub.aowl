## Fallback material table with the same names as materials.aowl (materialOf(stateId: int): Material with density and
## fill), for builds or tests that must not depend on the generated block tables or on the other agent's file.
## Switch: in bodymass.aowl replace `import materials` by `import materials_stub` (one line). The state ids here are
## ABSTRACT test ids, not vanilla ids: 0 air, 1 stone-like, 2 planks-like, 3 dirt-like, 4 sand-like, 5 bottom-slab planks.
## Units as in materials.aowl: density kg/m3, fill = collision-shape volume fraction.

type
  Material* = object
    density*: float64
    fill*: float64

proc materialOf*(stateId: int): Material =
  case stateId
  of 1: Material(density: 2400.0, fill: 1.0)
  of 2: Material(density: 700.0, fill: 1.0)
  of 3: Material(density: 1600.0, fill: 1.0)
  of 4: Material(density: 1500.0, fill: 1.0)
  of 5: Material(density: 700.0, fill: 0.5)
  else: Material(density: 1.2, fill: 0.0)   # air and unknown ids: no solid volume, so no mass
