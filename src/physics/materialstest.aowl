## Unit tests for materials.aowl against the vanilla block data. Exit 0 and "ALL PASS" when everything holds.

{.feature: "untyped".}

import std/syncio
import materials
import std/rawthreads
import "../generated/block_properties"

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc mat(name: string): Material =
  let (ok, m) = materialByName(name)
  if not ok:
    echo "FAIL unknown block ", name
    inc failures
  m

let stone = mat("stone")
let planks = mat("oak_planks")
let wool = mat("white_wool")
let dirt = mat("dirt")
let sand = mat("sand")
let log = mat("oak_log")
let leaves = mat("oak_leaves")
let iron = mat("iron_block")
let water = mat("water")
let lava = mat("lava")
let air = mat("air")
let bedrock = mat("bedrock")
let grass = mat("short_grass")
let slab = mat("oak_slab")

echo "classes: stone=", className(stone.matClass), " planks=", className(planks.matClass), " wool=", className(wool.matClass),
     " dirt=", className(dirt.matClass), " leaves=", className(leaves.matClass), " grass=", className(grass.matClass)
echo "density: stone=", stone.density, " planks=", planks.density, " wool=", wool.density, " dirt=", dirt.density,
     " iron=", iron.density, " leaves=", leaves.density, " grass=", grass.density

check(stone.density > planks.density and planks.density > wool.density, "density: stone > oak planks > wool")
check(stone.compressive > planks.compressive and planks.compressive > wool.compressive, "compressive: stone > planks > wool")
check(stone.stiffness > planks.stiffness and planks.stiffness > wool.stiffness, "stiffness: stone > planks > wool")
check(stone.breakThreshold > planks.breakThreshold and planks.breakThreshold > wool.breakThreshold,
      "break threshold: stone > planks > wool")
check(planks.tensile > stone.tensile, "wood holds tension better than stone")
check(stone.tensile < stone.compressive, "stone is weaker in tension than compression")
check(iron.density > stone.density, "iron block heavier than stone")
check(log.matClass == mcWood and planks.matClass == mcWood, "logs and planks are wood class")
check(stone.matClass == mcRock, "stone is rock class")
check(dirt.matClass == mcGranular and sand.matClass == mcGranular, "dirt and sand are granular")
check(wool.matClass == mcSoft and leaves.matClass == mcSoft, "wool and leaves are soft")
check(grass.matClass == mcFoliage and grass.density < 200.0, "short grass is light foliage")
check(leaves.dragArea < stone.dragArea and leaves.dragArea > 0.0, "leaves are porous: drag below a solid cube")
check(stone.dragArea > 0.99 and stone.dragArea < 1.01, "a full cube has drag area 1")
check(wool.flammability > stone.flammability, "wool is more flammable than stone")
check(planks.ignitability > 0.0 and stone.ignitability == 0.0, "planks catch fire, stone does not")
check(water.liquid and water.density == 1000.0, "water is a liquid of density 1000")
check(lava.density > water.density, "lava denser than water")
check(air.density < 2.0 and massOfState(0) == 0.0, "air has no placed mass")
check(bedrock.indestructible and bedrock.breakThreshold > 1.0e6, "bedrock is indestructible")
check(slab.fill > 0.4 and slab.fill < 0.6, "a bottom slab fills half a cell")
check(mass(stone, 2.0) == 2.0 * stone.density and massOfCube(stone) == stone.density, "mass(volume) = density * volume")

# overrides
let stoneBase = stone.density
let ok1 = loadMaterialOverrides("{\"version\":1,\"blocks\":{\"minecraft:stone\":{\"density\":1234,\"compressive\":99}}}")
check(ok1[0] and ok1[1] == "", "block override document loads")
let stone2 = mat("stone")
check(stone2.density == 1234.0 and stone2.compressive == 99.0, "block override applies")
check(stone2.stiffness == stone.stiffness, "fields not overridden keep defaults")
check(mat("granite").density == mat("granite").density and mat("granite").density != 1234.0, "other blocks untouched")
clearMaterialOverrides()
check(mat("stone").density == stoneBase, "clearMaterialOverrides restores defaults")

let ok2 = loadMaterialOverrides("{\"tags\":{\"minecraft:logs\":{\"density\":777}},\"blocks\":{\"oak_log\":{\"density\":555}}}")
check(ok2[0], "tag override document loads")
check(mat("birch_log").density == 777.0, "tag override applies to every block in the tag")
check(mat("oak_log").density == 555.0, "block override beats tag override")
check(mat("oak_planks").density == planks.density, "tag override does not leak to planks")
clearMaterialOverrides()

let bad = loadMaterialOverrides("{\"blocks\":{\"stone\":{\"density\":\"heavy\"}}}")
check(not bad[0], "non-numeric field rejected")
let bad2 = loadMaterialOverrides("{not json")
check(not bad2[0], "malformed JSON rejected")
let unk = loadMaterialOverrides("{\"blocks\":{\"mymod:nothing\":{\"density\":1}},\"tags\":{\"minecraft:wool\":{\"density\":42}}}")
check(unk[0] and unk[1].len > 0, "unknown block reported as warning, rest applied")
check(mat("white_wool").density == 42.0, "wool tag override applied despite the unknown block")
check(not setBlockOverride("mymod:nothing", MaterialOverride()), "setBlockOverride false for unknown block")
clearMaterialOverrides()
check(mat("white_wool").density == wool.density, "defaults restored after clear")

# prewarm: after prewarmMaterials (also the one a reload/clear runs itself) concurrent readers do no lazy fills
var gSums: array[3, float64]
proc readerMain(arg: pointer) {.nimcall.} =
  let k = cast[int](arg)
  var sum = 0.0
  for rep in 0 ..< 3:
    for s in 0 ..< int(STATE_COUNT):
      sum += materialOf(s).density
  gSums[k] = sum
clearMaterialOverrides()                       # invalidates, then prewarms itself
check(materialFills() >= int(STATE_COUNT), "clearMaterialOverrides refilled the whole table")
let f0 = materialFills()
discard loadMaterialOverrides("{\"blocks\":{\"stone\":{\"density\":4321}}}")
check(materialFills() >= f0 + int(STATE_COUNT), "loadMaterialOverrides prewarms again after its invalidate")
let f1 = materialFills()
var ths: array[3, RawThread]
for k in 0 ..< 3:
  try:
    create(ths[k], readerMain, cast[pointer](k))
  except:
    check(false, "thread create")
for k in 0 ..< 3:
  join(ths[k])
check(materialFills() == f1, "3 concurrent readers over every state did no lazy fill")
check(gSums[0] == gSums[1] and gSums[1] == gSums[2] and gSums[0] > 0.0, "readers saw identical tables")
check(mat("stone").density == 4321.0, "override visible after the prewarm")
clearMaterialOverrides()

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
