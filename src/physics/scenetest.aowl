## The deterministic physics scene suite (overnight goal item 23): ONE command re-runs every end-to-end physics scene against GOLDEN
## numbers, so any later change that shifts the physics fails loudly. Scenes and the golden table live in scenes.aowl.
##
##   sh src/physics/run_scenes.sh        (builds C:/m/scene.exe from a fresh nimcache and runs it)
##
## Output per scene: "SCENE name", the checks, then PASS / FAIL (INCONCLUSIVE when a scene cannot run at all). A golden that moved
## prints `GOLDEN-UPDATE gd("key", value, tol)` which can be pasted into initGolden once the change is understood. Last lines:
## the golden table and "ALL PASS (n checks)" with exit code 0, or "FAILED k" with exit code 1.

{.feature: "untyped".}

import std/syncio
import materials
import solver
import solveradapter
import scenes

type SceneFn = proc (): uint64 {.nimcall.}

var nPass = 0
var nFail = 0
var nInconclusive = 0

proc runScene(name: string; f: SceneFn): uint64 =
  echo "SCENE ", name
  let before = gFailures
  let h = f()
  if gFailures == before:
    inc nPass
    echo "PASS ", name
  else:
    inc nFail
    echo "FAIL ", name
  return h

proc inconclusive(name, why: string) =
  echo "SCENE ", name
  echo "INCONCLUSIVE ", name, ": ", why
  inc nInconclusive

proc same(a, b: uint64; what: string) =
  chk(a == b, what & (if a == b: "" else: " (" & $a & " vs " & $b & ")"))

var hBridge = 0'u64
var hCantilever = 0'u64
var hCaveIn = 0'u64
var hStorm = 0'u64
var hFire = 0'u64
var hBlast = 0'u64
var hClimate = 0'u64
var hBody = 0'u64
var hErosion = 0'u64

proc sceneBridgeW(): uint64 =
  hBridge = sceneBridge()
  return hBridge
proc sceneCantileverW(): uint64 =
  hCantilever = sceneCantilever()
  return hCantilever
proc sceneCaveInW(): uint64 =
  hCaveIn = sceneCaveIn()
  return hCaveIn
proc sceneStormW(): uint64 =
  hStorm = sceneStorm()
  return hStorm
proc sceneFireW(): uint64 =
  hFire = sceneFire()
  return hFire
proc sceneBlastW(): uint64 =
  hBlast = sceneBlast()
  return hBlast
proc sceneClimateW(): uint64 =
  hClimate = sceneClimate()
  return hClimate
proc sceneErosionW(): uint64 =
  hErosion = sceneErosion()
  return hErosion

proc sceneBodyW(): uint64 =
  hBody = sceneBodyMass()
  return hBody

proc sceneDeterminismW(): uint64 =
  # full chain twice: bridge, cave-in and fire (solver + bodies + integrator + settle + fire) must reproduce every output bit
  gQuiet = true
  let b2 = sceneBridge()
  let c2 = sceneCaveIn()
  let f2 = sceneFire()
  gQuiet = false
  same(hBridge, b2, "bridge: second full run has the same hash of all outputs")
  same(hCaveIn, c2, "cave-in: second full run has the same hash of all outputs")
  same(hFire, f2, "fire: second full run has the same hash of all outputs")
  var all = hInit()
  hm(all, cast[int64](hBridge))
  hm(all, cast[int64](hCaveIn))
  hm(all, cast[int64](hFire))
  var all2 = hInit()
  hm(all2, cast[int64](b2))
  hm(all2, cast[int64](c2))
  hm(all2, cast[int64](f2))
  same(all, all2, "combined hash of scenes 1, 3, 5")
  goldH("determinism.bridge", hBridge)
  goldH("determinism.cavein", hCaveIn)
  goldH("determinism.fire", hFire)
  goldH("determinism.all", all)
  # solver budget slicing: the result must not depend on where the work pauses
  let sBridge = bridgeScene("iron_block", 9)
  let sRoof = roofScene(false)
  let sFire = fireAfterScene()
  let sTree = pillarScene(1, 24, "oak_log")
  let noLoads: seq[ExtLoad] = @[]
  let p1 = plainHash(sBridge, noLoads)
  same(p1, slicedHash(sBridge, noLoads, 1), "bridge solve: budget 1 equals one go")
  same(p1, slicedHash(sBridge, noLoads, 1000), "bridge solve: budget 1000 equals one go")
  let p3 = plainHash(sRoof, noLoads)
  same(p3, slicedHash(sRoof, noLoads, 1), "cave-in solve: budget 1 equals one go")
  same(p3, slicedHash(sRoof, noLoads, 1000), "cave-in solve: budget 1000 equals one go")
  let p5 = plainHash(sFire, noLoads)
  same(p5, slicedHash(sFire, noLoads, 1), "post-fire solve: budget 1 equals one go")
  same(p5, slicedHash(sFire, noLoads, 1000), "post-fire solve: budget 1000 equals one go")
  let wl = windLoadFromField(sTree.ids, sTree.nx, sTree.ny, sTree.nz, adapterP(), uniformWind(35.0))
  let p4 = plainHash(sTree, wl)
  same(p4, slicedHash(sTree, wl, 1), "wind-loaded pillar solve: budget 1 equals one go")
  same(p4, slicedHash(sTree, wl, 1000), "wind-loaded pillar solve: budget 1000 equals one go")
  goldH("determinism.solve.bridge", p1)
  goldH("determinism.solve.cavein", p3)
  goldH("determinism.solve.postfire", p5)
  goldH("determinism.solve.windpillar", p4)
  # blast job slicing (budget 64 ops) equals the one-shot result
  let bb = blastHash(0)
  same(bb, blastHash(64), "blast: budget 64 equals one go")
  same(bb, blastHash(1000000), "blast: budget 1e6 equals one go")
  goldH("determinism.blast", bb)
  return all

proc printTable() =
  echo ""
  echo "GOLDEN TABLE (", rowKey.len, " numbers)"
  echo "  status  key  actual  expected"
  var drift = 0
  var missing = 0
  for i in 0 ..< rowKey.len:
    var st = "ok   "
    if rowStatus[i] == 1:
      st = "DRIFT"
      inc drift
    elif rowStatus[i] == 2:
      st = "NEW  "
      inc missing
    if rowStatus[i] == 0:
      echo "  ", st, "  ", rowKey[i], "  ", rowActual[i]
    else:
      echo "  ", st, "  ", rowKey[i], "  ", rowActual[i], "  (expected ", rowExpected[i], ")"
  echo "golden numbers: ", rowKey.len, " checked, ", drift, " drifted, ", missing, " without a row"

initGolden()
clearMaterialOverrides()
discard runScene("1 bridge: 12 oak planks between stone pillars, +9 iron blocks breaks mid-span, pieces fall and settle", sceneBridgeW)
discard runScene("2 cantilever with weight", sceneCantileverW)
discard runScene("3 cave-in: 5x5 stone roof on one pillar breaks off and falls as a body", sceneCaveInW)
discard runScene("4 tree in a storm: 1x1 vs 2x2 oak log (24 high) under a ramp from calm to 40 b/s, tree with leaf drag", sceneStormW)
discard runScene("5 fire: a log pillar burns away, the stone deck falls", sceneFireW)
discard runScene("6 blast: TNT-sized blast beside a plank-post bridge", sceneBlastW)
discard runScene("7 climate: 100 simulated days, storm fractions in their bands", sceneClimateW)
discard runScene("8 body mass, inertia and NBT round trip", sceneBodyW)
discard runScene("E erosion (erosion.aowl): a dirt tower slumps cell for cell, an earthquake cracks the plank bridge", sceneErosionW)
discard runScene("9 determinism: full chain twice (bridge, cave-in, fire) and solver budget 1 vs 1000", sceneDeterminismW)

printTable()
echo "SUMMARY scenes: ", nPass, " PASS, ", nFail, " FAIL, ", nInconclusive, " INCONCLUSIVE"
if gFailures == 0 and nFail == 0:
  echo "ALL PASS (", gChecks, " checks)"
else:
  echo "FAILED ", gFailures, " of ", gChecks, " checks"
  quit(1)
