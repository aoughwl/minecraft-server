## Scene tests for solveradapter.aowl with REAL vanilla blocks (materials.aowl on the generated block data).
## Exit 0 and "ALL PASS" when everything holds. Anchor rule used here: the bottom layer (y == 0) of every box is the world floor.

{.feature: "untyped".}

import std/syncio
import "../generated/block_properties"
import materials
import solver
import solveradapter

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "  ok   ", what
  else:
    echo "  FAIL ", what
    inc failures

proc scene(name: string) = echo "SCENE ", name

proc sid(name: string): int =
  let b = Block.fromName(name)
  if b == nil:
    echo "FAIL unknown block ", name
    inc failures
    return 0
  return int(asU16(b.defaultState.id))

type Scene = object
  nx, ny, nz: int
  ids: seq[int]

proc newScene(nx, ny, nz: int): Scene = Scene(nx: nx, ny: ny, nz: nz, ids: newSeq[int](nx * ny * nz))
proc ci(s: Scene; x, y, z: int): int = x + s.nx * (z + s.nz * y)
proc put(s: var Scene; x, y, z: int; name: string) = s.ids[ci(s, x, y, z)] = sid(name)
proc ground(s: var Scene) =
  for z in 0 ..< s.nz:
    for x in 0 ..< s.nx: put(s, x, 0, z, "stone")
proc cx(s: Scene; c: int): int = (c mod (s.nx * s.nz)) mod s.nx
proc cy(s: Scene; c: int): int = c div (s.nx * s.nz)
proc cz(s: Scene; c: int): int = (c mod (s.nx * s.nz)) div s.nx

var P = defaultAdapterParams()

proc run(s: Scene): SolverResult =
  return solveSnapshot(s.ids, s.nx, s.ny, s.nz, P, floorAnchor, @[])

proc goneCell(r: SolverResult; c: int): bool =
  for b in r.broken:
    if b.cell == c: return true
  for comp in r.components:
    for x in comp.cells:
      if x == c: return true
  return false

proc anyGone(r: SolverResult): bool = r.broken.len > 0 or r.components.len > 0

proc info(r: SolverResult) =
  echo "     rounds=", r.rounds, " broken=", r.broken.len, " components=", r.components.len, " maxRatio=", r.maxRatio

# ---- scene builders -----------------------------------------------------------------------------------------------------
proc floorScene(): Scene =
  var s = newScene(10, 3, 10)
  ground(s)
  for z in 1 .. 8:
    for x in 1 .. 8: put(s, x, 1, z, "stone")
  return s

proc bridge(load: string; n: int): Scene =
  var s = newScene(14, 16, 3)
  ground(s)
  for y in 1 .. 5:
    put(s, 0, y, 1, "stone")
    put(s, 13, y, 1, "stone")
  for x in 1 .. 12: put(s, x, 5, 1, "oak_planks")
  for k in 0 ..< n: put(s, 7, 6 + k, 1, load)
  return s

proc cantilever(len: int; load: string; n: int): Scene =
  var s = newScene(10, 14, 3)
  ground(s)
  for y in 1 .. 4: put(s, 0, y, 1, "stone")
  for x in 1 .. len: put(s, x, 4, 1, "oak_planks")
  for k in 0 ..< n: put(s, len, 5 + k, 1, load)
  return s

proc slab(corners: bool): Scene =
  var s = newScene(7, 6, 7)
  ground(s)
  if corners:
    for y in 1 .. 2:
      put(s, 0, y, 0, "stone")
      put(s, 4, y, 0, "stone")
      put(s, 0, y, 4, "stone")
      put(s, 4, y, 4, "stone")
  else:
    put(s, 0, 1, 0, "stone")
    put(s, 0, 2, 0, "stone")
  for z in 0 .. 4:
    for x in 0 .. 4: put(s, x, 3, z, "stone")
  return s

proc span(len: int; mat: string): Scene =
  var s = newScene(len + 2, 8, 3)
  ground(s)
  for y in 1 .. 4:
    put(s, 0, y, 1, "stone")
    put(s, len + 1, y, 1, "stone")
  for x in 1 .. len: put(s, x, 4, 1, mat)
  return s

proc pillar(w, h: int; mat: string): Scene =
  var s = newScene(w + 2, h + 2, w + 2)
  ground(s)
  for y in 1 .. h:
    for z in 1 .. w:
      for x in 1 .. w: put(s, x, y, z, mat)
  return s

proc uniformWind(v: float64): WindSampler =
  return proc (x, y, z: int): (float64, float64) {.closure.} = (v, 0.0)

proc windBreaks(s: Scene; v: float64): bool =
  let loads = windLoadFromField(s.ids, s.nx, s.ny, s.nz, P, uniformWind(v))
  let r = solveSnapshot(s.ids, s.nx, s.ny, s.nz, P, floorAnchor, loads)
  return anyGone(r)

## lowest uniform wind speed (b/s) at which the scene fails, to 0.1; 0 if it fails with no wind, -1 if it holds up to vmax.
proc breakSpeed(s: Scene; vmax: float64): float64 =
  if windBreaks(s, 0.0): return 0.0
  if not windBreaks(s, vmax): return -1.0
  var lo = 0.0
  var hi = vmax
  while hi - lo > 0.1:
    let mid = 0.5 * (lo + hi)
    if windBreaks(s, mid): hi = mid
    else: lo = mid
  return hi

proc fewest(maker: proc (n: int): Scene {.closure.}): int =
  for n in 1 .. 9:
    if anyGone(run(maker(n))): return n
  return 0

# ---- scenes -------------------------------------------------------------------------------------------------------------
scene "a stone floor, oak bridge 12, stone tower 3, log pillar 20 hold"
block:
  let f = run(floorScene())
  info f
  check(not anyGone(f) and f.converged, "stone floor holds")
  let b = run(bridge("air", 0))
  info b
  check(not anyGone(b), "12-long oak plank bridge holds")
  let t = run(pillar(1, 3, "stone"))
  info t
  check(not anyGone(t), "3-high stone tower holds")
  let l = run(pillar(1, 20, "oak_log"))
  info l
  check(not anyGone(l), "20-high log pillar holds")

scene "b bridge: 9 iron blocks break the middle, one cobblestone holds"
block:
  let s = bridge("iron_block", 9)
  let r = run(s)
  info r
  check(r.broken.len > 0, "9 iron blocks: the span fails")
  if r.broken.len > 0:
    let x0 = cx(s, r.broken[0].cell)
    echo "     first failure x=", x0, " y=", cy(s, r.broken[0].cell), " ratio=", r.broken[0].ratio
    check(x0 >= 5 and x0 <= 9, "first failure in the middle part of the span")
  let c = run(bridge("cobblestone", 1))
  info c
  echo "     (margins: one cobblestone loads the bridge to ratio ", c.maxRatio, "; the cantilever scene below sits just above 1 for one iron block,",
       " so wood strength is pinned between those two)"
  check(not anyGone(c), "one cobblestone block holds")
  echo "     fewest iron blocks that break the bridge: ", fewest(proc (n: int): Scene {.closure.} = bridge("iron_block", n))
  echo "     fewest cobblestone that break the bridge: ", fewest(proc (n: int): Scene {.closure.} = bridge("cobblestone", n))

scene "c cantilever: 6 long breaks at the root under iron, 2 long holds"
block:
  let s = cantilever(6, "iron_block", 1)
  let r = run(s)
  info r
  check(r.broken.len > 0, "6-long cantilever with ONE iron block at the tip fails")
  if r.broken.len > 0:
    echo "     first failure x=", cx(s, r.broken[0].cell), " y=", cy(s, r.broken[0].cell), " ratio=", r.broken[0].ratio
    check(cx(s, r.broken[0].cell) == 1 and cy(s, r.broken[0].cell) == 4, "worst cell is the root plank (x=1)")
  let r2 = run(cantilever(2, "iron_block", 1))
  info r2
  check(not anyGone(r2), "2-long cantilever with the same block holds")
  let r3 = run(cantilever(6, "air", 0))
  info r3
  check(not anyGone(r3), "6-long cantilever holds under its own weight")
  echo "     fewest iron blocks at the tip: 6-long breaks at ", fewest(proc (n: int): Scene {.closure.} = cantilever(6, "iron_block", n)),
       ", 2-long breaks at ", fewest(proc (n: int): Scene {.closure.} = cantilever(2, "iron_block", n))

scene "d 5x5 stone slab: one corner column breaks away, four corner columns hold"
block:
  let s = slab(false)
  let r = run(s)
  info r
  var gone = 0
  for z in 0 .. 4:
    for x in 0 .. 4:
      if goneCell(r, ci(s, x, 3, z)): inc gone
  echo "     slab cells gone: ", gone, " of 25, first failure ratio ", (if r.broken.len > 0: r.broken[0].ratio else: 0.0)
  check(gone >= 20, "one-corner slab: nearly the whole slab breaks away")
  let r4 = run(slab(true))
  info r4
  check(not anyGone(r4), "four-corner slab holds")

scene "e stone span of 8 held at both ends holds"
block:
  let r = run(span(8, "stone"))
  info r
  check(not anyGone(r), "8-long stone span holds under its weight")
  let r2 = run(span(12, "stone"))
  info r2
  echo "     (12-long stone span: ", (if anyGone(r2): "fails" else: "holds"), ")"

scene "f granular: sand/gravel with air below are reported"
block:
  var s = newScene(6, 8, 6)
  ground(s)
  put(s, 1, 1, 1, "sand")      # on the ground: holds
  put(s, 3, 3, 3, "sand")      # floating
  put(s, 3, 4, 3, "gravel")    # on the floating sand
  put(s, 5, 2, 5, "gravel")    # floating
  let r = run(s)
  info r
  check(r.granular.len == 3, "three granular cells reported (floating sand, gravel on it, floating gravel)")
  check(r.components.len == 0 and r.broken.len == 0, "no bodies, no stress failures")
  var onGround = true
  for g in r.granular:
    if g == ci(s, 1, 1, 1): onGround = false
  check(onGround, "the sand block on the ground is not reported")

scene "g indestructible anchors, liquids and void ignored"
block:
  var s = newScene(8, 18, 3)
  put(s, 0, 5, 1, "bedrock")                        # floating bedrock: an anchor
  for x in 1 .. 2: put(s, x, 5, 1, "stone")
  for k in 0 .. 8: put(s, 2, 6 + k, 1, "iron_block") # heavy load on the beam tip (bedrock cells never fail)
  put(s, 0, 6, 1, "barrier")
  put(s, 0, 7, 1, "iron_block")
  let r = run(s)
  info r
  var bedrockBroke = false
  for b in r.broken:
    if b.cell == ci(s, 0, 5, 1) or b.cell == ci(s, 0, 6, 1): bedrockBroke = true
  check(not bedrockBroke, "bedrock and barrier never fail")
  check(not goneCell(r, ci(s, 0, 5, 1)) and not goneCell(r, ci(s, 0, 6, 1)), "bedrock and barrier are not free bodies")
  var w = newScene(5, 5, 5)
  put(w, 2, 0, 2, "stone")        # on the floor layer: anchor
  put(w, 2, 1, 2, "stone")
  put(w, 2, 2, 2, "water")
  put(w, 2, 3, 2, "stone")        # above water: no support
  put(w, 1, 1, 1, "lava")
  put(w, 3, 3, 3, "short_grass")
  let rw = run(w)
  info rw
  var cell23 = false
  for comp in rw.components:
    for c in comp.cells:
      if c == ci(w, 2, 3, 2): cell23 = true
  check(cell23, "water gives no support: the stone above it is a free component")
  let si = snapshotToSolverInput(w.ids, 5, 5, 5, P, floorAnchor)
  check(si.cells[ci(w, 2, 2, 2)] == 0'u16 and si.cells[ci(w, 1, 1, 1)] == 0'u16 and si.cells[ci(w, 3, 3, 3)] == 0'u16,
        "water, lava and grass are empty cells in the solver input")

scene "h wind: gale vs buildings and pillars"
block:
  # house: 7x7 plank walls 4 high, plank roof
  var h = newScene(9, 8, 9)
  ground(h)
  for y in 1 .. 4:
    for i in 1 .. 7:
      put(h, i, y, 1, "oak_planks")
      put(h, i, y, 7, "oak_planks")
      put(h, 1, y, i, "oak_planks")
      put(h, 7, y, i, "oak_planks")
  for z in 1 .. 7:
    for x in 1 .. 7: put(h, x, 5, z, "oak_planks")
  let hv = breakSpeed(h, 300.0)
  echo "     plank house breaks at wind speed: ", hv
  check(not windBreaks(h, 25.0), "25 b/s gale does not break the plank house")
  let t1 = pillar(1, 24, "oak_log")
  let t2 = pillar(2, 24, "oak_log")
  let v1 = breakSpeed(t1, 300.0)
  let v2 = breakSpeed(t2, 600.0)
  echo "     1x1 oak log pillar, 24 high: snaps at ", v1, " b/s"
  echo "     2x2 oak log pillar, 24 high: snaps at ", v2, " b/s"
  check(not windBreaks(t1, 25.0), "25 b/s gale does not snap the 1x1 pillar either (it takes more)")
  check(v1 > 25.0 and v1 < 300.0, "the 1x1 pillar does snap, at a finite wind speed")
  check(not windBreaks(t2, v1 + 0.5), "the 2x2 pillar of the same height holds at the speed that snaps the 1x1")
  check(v2 < 0.0 or v2 > 1.3 * v1, "the 2x2 pillar needs a clearly stronger wind than the 1x1")
  check(not windBreaks(pillar(1, 10, "stone"), 25.0), "a 10-high stone pillar holds at 25 b/s")

scene "i array form of the wind input equals the sampler form"
block:
  let t1 = pillar(1, 24, "oak_log")
  let n = t1.nx * t1.ny * t1.nz
  var wxs = newSeq[float64](n)
  var wzs = newSeq[float64](n)
  for i in 0 ..< n: wxs[i] = 30.0
  let la = windLoadFromArrays(t1.ids, t1.nx, t1.ny, t1.nz, P, wxs, wzs)
  let ls = windLoadFromField(t1.ids, t1.nx, t1.ny, t1.nz, P, uniformWind(30.0))
  var same = la.len == ls.len and la.len > 0
  if same:
    for i in 0 ..< la.len:
      if la[i].cell != ls[i].cell or la[i].fx != ls[i].fx: same = false
  check(same, "arrays and sampler agree")
  if ls.len > 0: echo "     force on one exposed log cell at 30 b/s: ", ls[0].fx, " kgf"

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
