## Scene tests for the structural solver (solver.aowl + solvergraph.aowl). Exit 0 and "ALL PASS" when every scene passes.
##
## Materials here are GAME-scaled on purpose (strengths in kgf per m2 of a cell face, see solver.aowl): a real 1 m wooden beam
## would carry 70 tonnes over 13 m, a game bridge should not. Masses are real (kg per 1 m3 cell).

{.feature: "untyped".}

import std/[syncio, monotimes]
import solver

const
  Air = 0'u16
  Stone = 1'u16
  Wood = 2'u16
  Heavy = 3'u16     # 9 iron cells of mass in one cell
  Sand = 4'u16
  Dirt = 5'u16

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "  ok   ", what
  else:
    echo "  FAIL ", what
    inc failures

proc scene(name: string) = echo "SCENE ", name

proc mats(): seq[SolverMaterial] =
  var m = newSeq[SolverMaterial](6)
  m[1] = SolverMaterial(mass: 2400.0, tensile: 60000.0, compressive: 400000.0, shear: 100000.0, breakThreshold: 1.0,
                        friction: 0.6, stiffness: 30.0, terrain: true)
  m[2] = SolverMaterial(mass: 700.0, tensile: 300000.0, compressive: 400000.0, shear: 150000.0, breakThreshold: 1.0,
                        friction: 0.5, stiffness: 10.0)
  m[3] = SolverMaterial(mass: 70830.0, tensile: 2000000.0, compressive: 20000000.0, shear: 2000000.0, breakThreshold: 1.0,
                        friction: 0.4, stiffness: 200.0)
  m[4] = SolverMaterial(mass: 1600.0, tensile: 0.0, compressive: 100000.0, shear: 1000.0, breakThreshold: 1.0, granular: true)
  m[5] = SolverMaterial(mass: 1600.0, tensile: 20000.0, compressive: 100000.0, shear: 30000.0, breakThreshold: 1.0, terrain: true)
  return m

proc newScene(nx, ny, nz: int): SolverInput =
  var s = newSolverInput(nx, ny, nz)
  s.materials = mats()
  return s

proc put(s: var SolverInput; x, y, z: int; m: uint16; anchor: bool = false) =
  let c = cellIdx(s, x, y, z)
  s.cells[c] = m
  s.anchor[c] = anchor

proc cx(s: SolverInput; c: int): int = (c mod (s.nx * s.nz)) mod s.nx
proc cy(s: SolverInput; c: int): int = c div (s.nx * s.nz)
proc cz(s: SolverInput; c: int): int = (c mod (s.nx * s.nz)) div s.nx

proc ground(s: var SolverInput) =
  for z in 0 ..< s.nz:
    for x in 0 ..< s.nx:
      put(s, x, 0, z, Stone, true)

proc bridge(heavyAt: int): SolverInput =
  var s = newScene(14, 8, 3)
  for y in 0 .. 5:
    put(s, 0, y, 1, Stone, true)
    put(s, 13, y, 1, Stone, true)
  for x in 1 .. 12: put(s, x, 5, 1, Wood)
  if heavyAt > 0: put(s, heavyAt, 6, 1, Heavy)
  return s

proc cantilever(len: int; heavyMass: bool): SolverInput =
  var s = newScene(10, 6, 3)
  for y in 0 .. 3: put(s, 0, y, 1, Stone, true)
  for x in 1 .. len: put(s, x, 3, 1, Wood)
  if heavyMass: put(s, len, 4, 1, Heavy)
  return s

proc slabScene(): SolverInput =
  var s = newScene(7, 6, 7)
  ground(s)
  put(s, 0, 1, 0, Stone)
  put(s, 0, 2, 0, Stone)
  for z in 0 .. 4:
    for x in 0 .. 4: put(s, x, 3, z, Stone)
  return s

proc sameResult(a, b: SolverResult): bool =
  if a.broken.len != b.broken.len or a.components.len != b.components.len or a.granular.len != b.granular.len: return false
  if a.rounds != b.rounds or a.converged != b.converged or a.maxRatio != b.maxRatio or a.ratio.len != b.ratio.len: return false
  for i in 0 ..< a.broken.len:
    if a.broken[i].cell != b.broken[i].cell or a.broken[i].ratio != b.broken[i].ratio or a.broken[i].kind != b.broken[i].kind or
       a.broken[i].round != b.broken[i].round: return false
  for i in 0 ..< a.components.len:
    if a.components[i].cells.len != b.components[i].cells.len or a.components[i].mass != b.components[i].mass: return false
    for j in 0 ..< a.components[i].cells.len:
      if a.components[i].cells[j] != b.components[i].cells[j]: return false
  for i in 0 ..< a.granular.len:
    if a.granular[i] != b.granular[i]: return false
  for i in 0 ..< a.ratio.len:
    if a.ratio[i] != b.ratio[i]: return false
  return true

proc solveBudget(s: SolverInput; budget: int): SolverResult =
  var job = newSolverJob(s, defaultSolverParams())
  var calls = 0
  while not step(job, budget):
    inc calls
  return job.res

proc inComponent(r: SolverResult; c: int): bool =
  for comp in r.components:
    for x in comp.cells:
      if x == c: return true
  return false

proc brokenHas(r: SolverResult; c: int): bool =
  for b in r.broken:
    if b.cell == c: return true
  return false

# ---------------------------------------------------------------------------------------------------------------------
scene "1 stone floor on the ground holds"
block:
  var s = newScene(10, 3, 10)
  ground(s)
  for z in 1 .. 8:
    for x in 1 .. 8: put(s, x, 1, z, Stone)
  let r = solve(s, defaultSolverParams())
  echo "  rounds=", r.rounds, " broken=", r.broken.len, " components=", r.components.len, " maxRatio=", r.maxRatio
  check(r.broken.len == 0 and r.components.len == 0 and r.converged, "nothing breaks, nothing detaches")
  check(r.maxRatio < 0.1, "floor stress is a small fraction of strength")
let f1 = failures

scene "2 wooden bridge, 12 long, anchored at both ends, holds under its own weight"
block:
  let s = bridge(0)
  let r = solve(s, defaultSolverParams())
  echo "  rounds=", r.rounds, " broken=", r.broken.len, " maxRatio=", r.maxRatio
  check(r.broken.len == 0 and r.components.len == 0 and r.converged, "bridge holds")
  check(r.maxRatio > 0.1 and r.maxRatio < 0.6, "own-weight bending is real but below the limit (0.1 < ratio < 0.6)")
let f2 = failures

scene "3 the same bridge with a 9-iron-cells block at the middle breaks in the middle"
block:
  let s = bridge(7)
  let r = solve(s, defaultSolverParams())
  echo "  rounds=", r.rounds, " broken=", r.broken.len, " components=", r.components.len, " converged=", r.converged
  check(r.broken.len > 0, "the span fails")
  if r.broken.len > 0:
    let x0 = cx(s, r.broken[0].cell)
    echo "  first failure at x=", x0, " ratio=", r.broken[0].ratio, " kind=", ord(r.broken[0].kind)
    check(x0 >= 5 and x0 <= 9, "worst cell is in the middle of the span (x 5..9 of 1..12)")
    var allMid = true
    for b in r.broken:
      if b.round == 0 and (cx(s, b.cell) < 3 or cx(s, b.cell) > 10): allMid = false
    check(allMid, "every round-0 failure is in the middle part (x 3..10)")
  check(inComponent(r, cellIdx(s, 7, 6, 1)), "the iron block ends up in a free component (it falls)")
let f3 = failures

scene "4 cantilever 6 long with a heavy tip fails at the root; a short one holds"
block:
  let s = cantilever(6, true)
  let r = solve(s, defaultSolverParams())
  echo "  rounds=", r.rounds, " broken=", r.broken.len
  check(r.broken.len > 0, "long cantilever with heavy tip fails")
  if r.broken.len > 0:
    echo "  first failure at x=", cx(s, r.broken[0].cell), " ratio=", r.broken[0].ratio
    check(cx(s, r.broken[0].cell) == 1, "worst cell is the root cell (x=1, next to the wall)")
  check(inComponent(r, cellIdx(s, 6, 4, 1)), "the heavy block falls with the beam")
  let s2 = cantilever(2, true)
  let r2 = solve(s2, defaultSolverParams())
  echo "  short: broken=", r2.broken.len, " maxRatio=", r2.maxRatio
  check(r2.broken.len == 0 and r2.components.len == 0, "short cantilever with the same block holds")
  let s3 = cantilever(6, false)
  let r3 = solve(s3, defaultSolverParams())
  echo "  long unloaded: broken=", r3.broken.len, " maxRatio=", r3.maxRatio
  check(r3.broken.len == 0, "long cantilever under its own weight holds")
let f4 = failures

scene "5 a pillar whose base cell is removed becomes a free component and falls"
block:
  var s = newScene(3, 8, 3)
  ground(s)
  for y in 1 .. 5: put(s, 1, y, 1, Stone)
  let rIntact = solve(s, defaultSolverParams())
  check(rIntact.broken.len == 0 and rIntact.components.len == 0, "intact pillar holds")
  s.cells[cellIdx(s, 1, 1, 1)] = Air
  let r = solve(s, defaultSolverParams())
  echo "  components=", r.components.len
  check(r.components.len == 1 and r.broken.len == 0, "exactly one free component, no stress failure")
  if r.components.len == 1:
    check(r.components[0].cells.len == 4 and not r.components[0].fromFailure, "4 cells, unsupported in the input")
    check(r.components[0].mass == 4.0 * 2400.0, "mass is the sum of the cell masses")
    check(r.components[0].terrain and r.caveIns.len == 1, "terrain-flag stone is reported as a cave-in candidate")
let f5 = failures

scene "6 cave roof: a 5x5 slab supported at one corner column breaks off"
block:
  let s = slabScene()
  let r = solve(s, defaultSolverParams())
  echo "  rounds=", r.rounds, " broken=", r.broken.len, " components=", r.components.len, " converged=", r.converged
  check(r.broken.len > 0, "the slab fails")
  var slabGone = 0
  for z in 0 .. 4:
    for x in 0 .. 4:
      let c = cellIdx(s, x, 3, z)
      if brokenHas(r, c) or inComponent(r, c): inc slabGone
  echo "  slab cells broken or detached: ", slabGone, " of 25"
  check(slabGone >= 20, "nearly the whole slab breaks off")
  check(inComponent(r, cellIdx(s, 4, 3, 4)) or brokenHas(r, cellIdx(s, 4, 3, 4)), "the far corner is gone")
  check(not brokenHas(r, cellIdx(s, 0, 1, 0)) and not inComponent(r, cellIdx(s, 0, 1, 0)), "the supporting column base stays")
let f6 = failures

scene "7 determinism: identical results for budget 1, 7 and 1000"
block:
  let sceneList = [bridge(7), slabScene(), cantilever(6, true)]
  for k in 0 ..< 3:
    let s = sceneList[k]
    let a = solveBudget(s, 1)
    let b = solveBudget(s, 7)
    let c = solveBudget(s, 1000)
    let d = solve(s, defaultSolverParams())
    check(sameResult(a, b) and sameResult(b, c) and sameResult(c, d), "scene " & $k & ": budgets 1 / 7 / 1000 / unsliced agree")
    check(a.broken.len > 0, "scene " & $k & ": the compared result is non-trivial")
let f7 = failures

scene "extra: granular blocks, wind"
block:
  var s = newScene(5, 8, 5)
  ground(s)
  put(s, 1, 1, 1, Sand)
  put(s, 1, 2, 1, Sand)
  put(s, 3, 3, 3, Sand)
  put(s, 3, 4, 3, Sand)
  let r = solve(s, defaultSolverParams())
  check(r.granular.len == 2 and r.granular[0] == cellIdx(s, 3, 3, 3) and r.granular[1] == cellIdx(s, 3, 4, 3),
        "a floating sand column is reported (2 cells), the sand on the ground holds")
  check(r.components.len == 0, "granular cells are not reported as bodies")
  var w = newScene(3, 10, 3)
  ground(w)
  for y in 1 .. 6: put(w, 1, y, 1, Stone)
  let calm = solve(w, defaultSolverParams())
  w.loads.add ExtLoad(cell: cellIdx(w, 1, 6, 1), fx: 8000.0, fy: 0.0, fz: 0.0)
  let storm = solve(w, defaultSolverParams())
  check(calm.broken.len == 0, "pillar holds in calm air")
  check(storm.broken.len > 0 and cy(w, storm.broken[0].cell) == 1, "a strong lateral load snaps the pillar at its base")
let f8 = failures

scene "8 performance: 50k cells"
block:
  var s = newScene(100, 9, 100)
  ground(s)
  var count = 0
  var y = 1
  while y <= 4:
    var z = 0
    while z < 100:
      var x = 0
      while x < 100:
        if x mod 5 == 0 and z mod 5 == 0:
          put(s, x, y, z, Stone)
          inc count
        x += 1
      z += 1
    y += 1
  for yy in 5 .. 8:
    for z in 0 ..< 100:
      for x in 0 ..< 100:
        put(s, x, yy, z, Wood)
        inc count
  let total = count + 100 * 100
  let t0 = getMonoTime()
  let r = solve(s, defaultSolverParams())
  let ms = (ticks(getMonoTime()) - ticks(t0)) div 1000000'i64
  echo "  solid cells=", total, " time=", ms, " ms rounds=", r.rounds, " broken=", r.broken.len, " maxRatio=", r.maxRatio
  check(total >= 50000, "scene has at least 50k solid cells")
  check(r.broken.len == 0 and r.converged, "the structure holds")
  check(ms < 3000, "solved within the 3000 ms budget on this machine")
let f9 = failures

proc verdict(name: string; before, after: int) =
  if after == before: echo "PASS ", name else: echo "FAIL ", name

verdict("scene 1 stone floor holds", 0, f1)
verdict("scene 2 wooden bridge holds", f1, f2)
verdict("scene 3 heavy block breaks the bridge in the middle", f2, f3)
verdict("scene 4 cantilever root failure / short holds", f3, f4)
verdict("scene 5 pillar base removed -> free component", f4, f5)
verdict("scene 6 cave roof slab breaks off", f5, f6)
verdict("scene 7 determinism over budget slicing", f6, f7)
verdict("extra granular and wind", f7, f8)
verdict("scene 8 performance 50k cells", f8, f9)

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
