## Unit tests for windcore.aowl (verbatim client copy) and windfield.aowl (server shelter/drafts/feed).
## Exit 0 and "ALL PASS" when everything holds.
##
## REFERENCE VALUES for the client to compare with its '[wind] windcore check ...' line (printed by this test as
## "[wind-ref] ..." lines). Values from the server build of the verbatim client windcore:
##   seed=12345 t=6000 p=(100,70,-50) clear      -> x=-1.3320041386156056 y=0.14272050333816128 z=-0.6968019244706735 speed=1.5032524562544827
##   seed=0 t=30000 p=(-300,120,800) rain=1 thunder=1 -> x=-7.958219166618955 y=1.411212848711302 z=-8.358550673486604 speed=11.541170723335854

{.feature: "untyped".}

import std/syncio
import windfield

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc flat(x, z: int): int = 64
proc ridgeWest(x, z: int): int =
  if x >= -40 and x < -20: 100 else: 64
proc nothingSolid(x, y, z: int): bool = false

let seed = 123456789
let fp = defaultFieldParams()

proc same(a, b: WindVec): bool = a.x == b.x and a.y == b.y and a.z == b.z

proc field(sd: int, t, x, y, z, rain, thunder: float, h: HeightFn): WindVec =
  windAtField(sd, t, x, y, z, rain, thunder, h, nothingSolid, fp, false, 0.0, 0.0)

# reference points for the client
let r1 = windAt(12345, 6000.0, 100.0, 70.0, -50.0, 0.0, 0.0)
echo "[wind-ref] seed=12345 t=6000 p=(100,70,-50) clear -> x=", r1.x, " y=", r1.y, " z=", r1.z, " speed=", r1.speed
let r2 = windAt(0, 30000.0, -300.0, 120.0, 800.0, 1.0, 1.0)
echo "[wind-ref] seed=0 t=30000 p=(-300,120,800) storm -> x=", r2.x, " y=", r2.y, " z=", r2.z, " speed=", r2.speed

# determinism
let a1 = field(seed, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0, flat)
let a2 = field(seed, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0, flat)
check(same(a1, a2), "same inputs give the same output")
let other = field(seed, 9000.0, 300.0, 80.0, 40.0, 0.0, 0.0, flat)
let a3 = field(seed, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0, flat)
check(same(a1, a3), "output unaffected by an interleaved call")
check(not same(a1, field(seed + 1, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0, flat)), "different seed differs")
check(not same(a1, other), "different place and time differ")
check(a1.speed > 0.0 and a1.speed < 40.0, "wind speed is plausible")
let core1 = windAt(seed, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0)
check(same(a1, core1), "open terrain equals windcore exactly")

# averages over positions to wash out the gust noise
proc meanSpeed(t, y, rain, thunder: float): float =
  var s = 0.0
  for i in 0 ..< 60:
    s += field(seed, t, float(i * 37), y, float(i * 11 - 200), rain, thunder, flat).speed
  s / 60.0

check(meanSpeed(5000.0, 180.0, 0.0, 0.0) > meanSpeed(5000.0, 70.0, 0.0, 0.0), "altitude increases wind")
check(meanSpeed(5000.0, 80.0, 1.0, 0.0) > meanSpeed(5000.0, 80.0, 0.0, 0.0), "rain raises wind")
check(meanSpeed(5000.0, 80.0, 1.0, 1.0) > meanSpeed(5000.0, 80.0, 1.0, 0.0), "thunder raises wind further")
check(meanSpeed(8000.0, 80.0, 0.0, 0.0) > meanSpeed(2000.0, 80.0, 0.0, 0.0), "afternoon windier than the small hours")

# shelter: a day whose wind blows east, compare open ground to the lee of a ridge
var shelterOk = false
var tested = false
var tt = 3000.0
while tt < 24000.0 * 40.0 and not tested:
  let g = windGlobal(seed, tt, 0.0, 0.0)
  if g.x > 0.9 * g.speed and g.speed > 0.5:
    let open = field(seed, tt, -10.0, 66.0, 0.0, 0.0, 0.0, flat)
    let lee = field(seed, tt, -10.0, 66.0, 0.0, 0.0, 0.0, ridgeWest)
    shelterOk = lee.speed < open.speed
    tested = true
  tt += 24000.0
check(tested, "found a day with an eastward wind to test shelter")
check(shelterOk, "terrain shelter reduces wind downwind of a tall ridge")

let under = field(seed, 5000.0, 0.5, 20.0, 0.5, 0.0, 0.0, flat)
check(under.speed < 0.0001, "underground column has no surface wind")

# cave drafts: a vertical shaft at x=0,z=0 open to the sky above a cave room
proc hShaft(x, z: int): int =
  if x == 0 and z == 0: 20 else: 64
proc sShaft(x, y, z: int): bool =
  if y < 10: return true
  if x == 0 and z == 0: return false
  if y >= 18 and y <= 22 and x >= -4 and x <= 4 and z >= -4 and z <= 4: return false
  y < 64
var maxDraft = 0.0
var minDraft = 0.0
var wt = 0.0
while wt < 24000.0 * 3.0:
  let d = windAtField(seed, wt, 2.5, 20.5, 0.5, 0.0, 0.0, hShaft, sShaft, fp, false, 0.0, 0.0)
  if d.x > maxDraft: maxDraft = d.x
  if d.x < minDraft: minDraft = d.x
  wt += 150.0
check(maxDraft > 0.05 and minDraft < -0.05, "cave draft reverses with the pressure swing")
check(maxDraft <= 1.5001 and minDraft >= -1.5001, "cave draft is bounded")

# server glue
setWindSeed(seed)
clearWindTerrain()
setWindWeather(0.0, 0.0)
let g1 = windAtWorld(5000.0, 10.5, 80.0, -7.25)
check(same(g1, windAt(seed, 5000.0, 10.5, 80.0, -7.25, 0.0, 0.0)), "glue equals core with no terrain")
setWindWeather(1.0, 0.0)
check(windAtWorld(5000.0, 10.5, 80.0, -7.25).speed > g1.speed, "glue applies local weather")
setWeatherProvider(proc (ticks: float): WeatherSample {.closure.} =
  WeatherSample(rain: 0.0, thunder: 0.0, hasWind: true, windX: 10.0, windZ: 0.0))
let feed = windAtWorld(6000.0, 0.5, 64.0, 0.5)
check(feed.x > 4.0 and feed.z == 0.0, "weather provider feed replaces the prevailing wind")

if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
