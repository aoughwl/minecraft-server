## Port of pumpkin/src/plugin/api/mod.rs: `PluginMetadata` and the `Plugin` trait (`on_load`, `on_unload`). The trait is a
## `ref object` of closure fields; each returns "" for `Ok(())` or the error text. `PluginFuture` (a boxed future) is the
## plain return value: the tick loop drives the plugin synchronously (see PORTING.md, async becomes plain calls).
##
## Named `PluginMetadata` as upstream; src/command/cmdsource.aowl has a four-field type of the same name for `/plugins`
## (`CmdPluginMetadata` below converts), so import this module qualified where both are in scope.
import ../../command/cmdsource

type
  PluginMetadata* = object
    name*: string
    version*: string
    authors*: seq[string]
    description*: string
    dependencies*: seq[string]
    permissions*: seq[string]

  PluginStateKind* = enum
    psLoading
    psLoaded
    psFailed

  PluginState* = object
    kind*: PluginStateKind
    error*: string        ## `Failed(String)`

proc cmdMetadata*(m: PluginMetadata): cmdsource.PluginMetadata =
  ## What `/plugins` reads.
  cmdsource.PluginMetadata(name: m.name, version: m.version, authors: m.authors, description: m.description)
