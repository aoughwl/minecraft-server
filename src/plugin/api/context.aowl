## Port of pumpkin/src/plugin/api/context.rs: the `Context` a plugin gets in `on_load` / `on_unload`. It holds the plugin's
## metadata, the permission registry and the closures into the server that upstream reaches through `Arc<Server>`
## (`ContextHooks`, filled by pluginmgr.aowl): register / unregister a command (with the plugin's namespace on the
## permission node and the plugin's name as the tree's source), send the command tree again to every player, look up a
## player, ask whether a player has a permission, log. `register_event` goes to the `HandlerMap` (eventsmod.aowl), a
## service is a `RootRef` kept under its name (`register_service` / `get_service`; the Rust downcasts by type name, the
## caller casts here).
## Also the `Plugin` trait of api/mod.rs, which refers to `Context`: `onLoad` / `onUnload` closures answering "" or an error.
## `register_plugin_loader` is `registerPluginLoader` in managercore.aowl (this module is imported by the loader module, so it cannot
## name `PluginLoader`). `init_log` installs a tracing subscriber upstream; the server log needs none, so `initLog` only says so once.
## PARTIAL: pumpkin/src/plugin/api/context.rs - `player_has_permission` for an offline player (the hook answers false when it has no server).
import ../../util/closureset
import std/[strutils, options, dirs, paths]
import ../../command/fallbackdispatch
import ../../util/permission
import apimod, eventsmod

type
  ContextHooks* = ref object
    registerTree*: proc (tree: CommandTree; permission: string) {.closure.}
    unregisterCommand*: proc (name: string) {.closure.}
    reloadCommands*: proc () {.closure.}                    ## `reload_commands_for_everyone`
    playerByName*: proc (name: string): int {.closure.}     ## entity id, -1 offline
    playerHasPermission*: proc (playerId: int; permission: string): bool {.closure.}
    log*: proc (line: string) {.closure.}

  PluginContext* = ref object
    metadata: PluginMetadata
    hooks*: ContextHooks
    handlers*: HandlerMap
    registry*: nil PermissionRegistry
    pluginId*: int
    dataRoot*: string
    serviceNames: seq[string]
    services: seq[RootRef]

  Plugin* = ref object
    ## The `Plugin` trait. A nil closure is the trait's default (`Ok(())`).
    onLoad*: proc (ctx: PluginContext): string {.closure.}
    onUnload*: proc (ctx: PluginContext): string {.closure.}

proc newPluginContext*(metadata: PluginMetadata; pluginId: int; hooks: ContextHooks; handlers: HandlerMap;
                       registry: nil PermissionRegistry; dataRoot: string): PluginContext =
  PluginContext(metadata: metadata, hooks: hooks, handlers: handlers, registry: registry, pluginId: pluginId,
                dataRoot: dataRoot, serviceNames: @[], services: @[])

proc getMetadata*(c: PluginContext): PluginMetadata = c.metadata

proc getDataFolder*(c: PluginContext): string =
  ## `plugins/data/<name>`, created when missing.
  result = c.dataRoot & "/" & c.metadata.name
  try:
    createDir(path(result))
  except:
    discard

proc getPlayerByName*(c: PluginContext; name: string): int =
  if c.hooks != nil and closureSet(c.hooks.playerByName): c.hooks.playerByName(name) else: -1

proc registerService*(c: PluginContext; name: string; service: RootRef) =
  var i = 0
  while i < c.serviceNames.len:
    if c.serviceNames[i] == name:
      c.services[i] = service
      return
    inc i
  c.serviceNames.add name
  c.services.add service

proc getService*(c: PluginContext; name: string): RootRef =
  result = nil
  var i = 0
  while i < c.serviceNames.len:
    if c.serviceNames[i] == name: result = c.services[i]
    inc i

proc fullPermissionNode*(c: PluginContext; permission: string): string =
  ## `permission` with the plugin's name in front unless it is already namespaced.
  if permission.contains(':'): permission else: c.metadata.name & ":" & permission

proc reloadCommandsForEveryone*(c: PluginContext) =
  if c.hooks != nil and closureSet(c.hooks.reloadCommands): c.hooks.reloadCommands()

proc registerCommand*(c: PluginContext; tree: CommandTree; permission: string) =
  ## `tree.source = Some(plugin name)`, the namespaced node, registered in the fallback dispatcher, then the commands
  ## packet again for everybody.
  tree.source = some(c.metadata.name)
  if c.hooks != nil and c.hooks.registerTree != nil:
    c.hooks.registerTree(tree, fullPermissionNode(c, permission))
  reloadCommandsForEveryone(c)

proc unregisterCommand*(c: PluginContext; name: string) =
  if c.hooks != nil and closureSet(c.hooks.unregisterCommand): c.hooks.unregisterCommand(name)
  reloadCommandsForEveryone(c)

proc registerPermission*(c: PluginContext; permission: Permission): string =
  ## "" on success, else the error `Err(String)` carries: the node must use the plugin's namespace.
  if not permission.node.startsWith(c.metadata.name & ":"):
    return "Permission " & permission.node & " must use the plugin's namespace (" & c.metadata.name & ")"
  let reg = c.registry
  if reg == nil: return "no permission registry"
  let (ok, err) = registerPermission(reg, permission)
  if ok: "" else: err

proc playerHasPermission*(c: PluginContext; playerId: int; permission: string): bool =
  c.hooks != nil and closureSet(c.hooks.playerHasPermission) and c.hooks.playerHasPermission(playerId, permission)

proc registerEvent*(c: PluginContext; eventName: string; handlerId: int; priority: EventPriority; blocking: bool) =
  ## `Context::register_event`: the handler goes under the event's name in the shared map.
  if c.handlers != nil:
    c.handlers.register(HandlerReg(pluginId: c.pluginId, handlerId: handlerId, eventName: eventName, priority: priority,
                                   blocking: blocking))

proc initLog*(c: PluginContext) =
  ## `Context::init_log`: nothing to install, `log` already writes to the server log.
  if c.hooks != nil and c.hooks.log != nil: c.hooks.log("[" & c.metadata.name & "] log ready")

proc log*(c: PluginContext; message: string) =
  if c.hooks != nil and c.hooks.log != nil: c.hooks.log("[" & c.metadata.name & "] " & message)
