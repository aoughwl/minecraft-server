## Port of pumpkin/src/plugin/api/events/block/block_break.rs
##
## An event that occurs when a block is broken: the player breaking it (none for a break with no cause), the block, its
## position, the experience gained and whether it drops items. Fired by `World::break_block` (server/world/worldmod.aowl),
## which today reaches the plugins through `PlayerEv` pekBlockBreak (plugin/wit/witeventsplayer2.aowl) for a player cause.
import std/options
import ../../../../data/block_ext
import ../../../../util/math/position
import ../../../../server/serverbase

type
  BlockBreakEvent* = object
    player*: Option[Player]       ## The player who is breaking the block, if applicable.
    blockRef*: Block              ## The block that is being broken (`block`, a keyword here).
    blockPosition*: BlockPos
    exp*: uint32                  ## The amount of experience gained from breaking the block.
    drop*: bool                   ## Whether the block should drop items.
    cancelled*: bool

proc newBlockBreakEvent*(player: Option[Player]; blockRef: Block; blockPosition: BlockPos; exp: uint32; drop: bool): BlockBreakEvent =
  BlockBreakEvent(player: player, blockRef: blockRef, blockPosition: blockPosition, exp: exp, drop: drop, cancelled: false)

proc getBlock*(self: BlockBreakEvent): Block = self.blockRef
  ## `BlockEvent::get_block`
