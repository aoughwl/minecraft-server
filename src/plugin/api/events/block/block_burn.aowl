## Port of pumpkin/src/plugin/api/events/block/block_burn.rs
##
## An event that occurs when a block is burned: the block that ignited the fire and the block that is burning. Upstream
## defines it and converts it for WASM plugins but fires it from nowhere, and so does this port.
import ../../../../data/block_ext

type
  BlockBurnEvent* = object
    ignitingBlock*: Block   ## The block that is igniting the fire.
    blockRef*: Block        ## The block that is burning.
    cancelled*: bool

proc newBlockBurnEvent*(ignitingBlock, blockRef: Block): BlockBurnEvent =
  ## Upstream has no `new` (the fields are public and `cancelled` is added by `#[cancellable]`).
  BlockBurnEvent(ignitingBlock: ignitingBlock, blockRef: blockRef, cancelled: false)

proc getBlock*(self: BlockBurnEvent): Block = self.blockRef
