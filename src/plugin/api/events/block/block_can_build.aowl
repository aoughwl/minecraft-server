## Port of pumpkin/src/plugin/api/events/block/block_can_build.rs
##
## An event that occurs when a player attempts to build on a block: the block to build, whether building is allowed, the
## player and the block built upon. Upstream defines it and converts it for WASM plugins but fires it from nowhere.
import ../../../../data/block_ext
import ../../../../server/serverbase

type
  BlockCanBuildEvent* = object
    blockToBuild*: Block    ## The block that the player is attempting to build.
    buildable*: bool        ## Whether building is allowed.
    player*: Player
    blockRef*: Block        ## The block being built upon.
    cancelled*: bool

proc newBlockCanBuildEvent*(blockToBuild: Block; buildable: bool; player: Player; blockRef: Block): BlockCanBuildEvent =
  BlockCanBuildEvent(blockToBuild: blockToBuild, buildable: buildable, player: player, blockRef: blockRef, cancelled: false)

proc getBlock*(self: BlockCanBuildEvent): Block = self.blockRef
