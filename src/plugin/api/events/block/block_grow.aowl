## Port of pumpkin/src/plugin/api/events/block/block_grow.rs
##
## An event that occurs when a block grows. Scope as upstream: fired for crop random-tick growth
## (server/block/blocks/plant/crop/cropmod.aowl); not for bonemeal, sapling/tree, kelp/cactus/sugar cane or mushroom growth.
import ../../../../data/block_ext
from ../../../../data/block_state import BlockStateId
import ../../../../util/math/position
import ../../../../server/serverbase

type
  BlockGrowEvent* = object
    world*: World               ## The world where growth is happening.
    oldBlock*: Block            ## The original block before growth.
    oldStateId*: BlockStateId
    newBlock*: Block            ## The new block targeted by growth.
    newStateId*: BlockStateId   ## The new block state id to apply.
    blockPos*: BlockPos
    cancelled*: bool

proc newBlockGrowEvent*(world: World; oldBlock: Block; oldStateId: BlockStateId; newBlock: Block; newStateId: BlockStateId;
                        blockPos: BlockPos): BlockGrowEvent =
  BlockGrowEvent(world: world, oldBlock: oldBlock, oldStateId: oldStateId, newBlock: newBlock, newStateId: newStateId,
                 blockPos: blockPos, cancelled: false)

proc getBlock*(self: BlockGrowEvent): Block = self.oldBlock
