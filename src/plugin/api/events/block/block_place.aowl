## Port of pumpkin/src/plugin/api/events/block/block_place.rs
##
## An event that occurs when a block is placed: the player, the block placed, the block it is placed against, the position
## and whether the player can build. Fired by `place_block` (server/block/block_place.aowl) through `gPluginBlockPlaceHook`
## (plugin/pluginhooks.aowl), which pluginmgr.aowl fills with `blockPlaceEvent` (plugin/wit/witeventsplayer2.aowl).
import ../../../../data/block_ext
import ../../../../util/math/position
import ../../../../server/serverbase

type
  BlockPlaceEvent* = object
    player*: Player
    blockPlaced*: Block
    blockPlacedAgainst*: Block
    blockPosition*: BlockPos
    canBuild*: bool
    cancelled*: bool

proc newBlockPlaceEvent*(player: Player; blockPlaced, blockPlacedAgainst: Block; blockPosition: BlockPos;
                         canBuild: bool): BlockPlaceEvent =
  BlockPlaceEvent(player: player, blockPlaced: blockPlaced, blockPlacedAgainst: blockPlacedAgainst,
                  blockPosition: blockPosition, canBuild: canBuild, cancelled: false)

proc getBlock*(self: BlockPlaceEvent): Block = self.blockPlaced
