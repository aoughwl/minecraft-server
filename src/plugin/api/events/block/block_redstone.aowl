## Port of pumpkin/src/plugin/api/events/block/block_redstone.rs
##
## An event that occurs when a block's redstone level changes. Fired by the pressure plate's `update_plate_state`
## (server/block/blocks/redstone/pressure_plate/pressure_platemod.aowl), the only place upstream fires it.
import ../../../../data/block_ext
from ../../../../data/block_state import BlockStateId
import ../../../../util/math/position
import ../../../../server/serverbase

type
  BlockRedstoneEvent* = object
    world*: World
    blockStateId*: BlockStateId   ## The block state id whose redstone power changed.
    blockPos*: BlockPos
    oldCurrent*: int32
    newCurrent*: int32
    cancelled*: bool

proc newBlockRedstoneEvent*(world: World; blockStateId: BlockStateId; blockPos: BlockPos; oldCurrent, newCurrent: int32): BlockRedstoneEvent =
  BlockRedstoneEvent(world: world, blockStateId: blockStateId, blockPos: blockPos, oldCurrent: oldCurrent,
                     newCurrent: newCurrent, cancelled: false)

proc getBlock*(self: BlockRedstoneEvent): Block =
  ## `Block::from_state_id(self.block_state_id)`
  Block.fromStateId(self.blockStateId)
