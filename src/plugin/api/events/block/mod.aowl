## Port of pumpkin/src/plugin/api/events/block/mod.rs
##
## The `BlockEvent` trait (`get_block`) is a proc per event type here, as aowlmony has no trait objects: each event file below
## has its own `getBlock`, and this module only re-exports them so `import events/block/mod` gives all six events.
import block_break, block_burn, block_can_build, block_grow, block_place, block_redstone
export block_break, block_burn, block_can_build, block_grow, block_place, block_redstone
