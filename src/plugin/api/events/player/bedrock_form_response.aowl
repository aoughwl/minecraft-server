## Port of pumpkin/src/plugin/api/events/player/bedrock_form_response.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/bedrock_form_response.rs - the event and the hook the Bedrock play side fires it through; this tree's plugin host (src/plugin/pluginmgr.aowl) has no event bus keyed by event type yet, so nothing is subscribed to `gBedrockFormResponseHook` until the host's owner connects it (the host's wasm side has no Bedrock form event either).
##
## `BedrockFormResponseEvent` is fired by `handle_modal_form_response` (src/server/net/bedrock/bedrockplay.aowl) when a Bedrock
## client answers a custom form.

import std/options
import ../../../../server/serverbase

type
  BedrockFormResponseEvent* = object
    ## The player who responded, the ID of the form, and the response data as a JSON string (none if the form was closed).
    player*: Player
    formId*: uint32
    responseData*: Option[string]

proc newBedrockFormResponseEvent*(player: Player; formId: uint32; responseData: Option[string]): BedrockFormResponseEvent =
  BedrockFormResponseEvent(player: player, formId: formId, responseData: responseData)

proc getPlayer*(self: BedrockFormResponseEvent): Player = self.player

var gBedrockFormResponseHook*: proc(event: BedrockFormResponseEvent) {.closure.} =
  proc(event: BedrockFormResponseEvent) {.closure.} = discard
  ## `plugin_manager.fire(event)`: the plugin host sets this to deliver the event; the default drops it.

proc fireBedrockFormResponse*(event: BedrockFormResponseEvent) =
  gBedrockFormResponseHook(event)
