## Port of pumpkin/src/plugin/api/events/player/changed_main_hand.rs
##
## `PlayerChangedMainHandEvent`: fired by `handleClientInformation` when the main hand setting changed. Not cancellable.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../server/net/netbase

type
  PlayerChangedMainHandEvent* = object
    player*: Player
    mainHand*: Hand

proc newPlayerChangedMainHandEvent*(player: Player; mainHand: Hand): PlayerChangedMainHandEvent =
  PlayerChangedMainHandEvent(player: player, mainHand: mainHand)

proc getPlayer*(self: PlayerChangedMainHandEvent): Player = self.player

proc firePlayerChangedMainHand*(event: PlayerChangedMainHandEvent) =
  var ev = newPlayerEv(pekChangedMainHand)
  ev.n = (if event.mainHand == hLeft: 0'i64 else: 1'i64)
  discard callPluginPlayerEventHook(event.player, ev)
