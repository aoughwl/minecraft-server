## Port of pumpkin/src/plugin/api/events/player/custom_click_action.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/custom_click_action.rs - the event type only: the dialog custom-click packet is not handled by the server, so nothing fires it, and the host has no WIT conversion for it.
##
## `CustomClickActionEvent`: a dialog custom click action. The server does not have dialogs wired to it yet, so nothing fires it.

import ../../../../server/serverbase
import ../../../pluginhooks

import std/options

type
  CustomClickActionEvent* = object
    player*: Player
    id*: string
    payload*: Option[seq[byte]]

proc newCustomClickActionEvent*(player: Player; id: string; payload: Option[seq[byte]]): CustomClickActionEvent =
  CustomClickActionEvent(player: player, id: id, payload: payload)

proc getPlayer*(self: CustomClickActionEvent): Player = self.player

var gCustomClickActionHook*: proc(event: CustomClickActionEvent) {.closure.} =
  proc(event: CustomClickActionEvent) {.closure.} = discard
  ## `plugin_manager.fire(event)`: nothing sets it (no WIT conversion for it in src/plugin/wit).

proc fireCustomClickAction*(event: CustomClickActionEvent) = gCustomClickActionHook(event)
