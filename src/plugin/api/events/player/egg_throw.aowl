## Port of pumpkin/src/plugin/api/events/player/egg_throw.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/egg_throw.rs - the event type only: the egg entity does not fire it and the host has no WIT conversion for it; `hatchingType` is a resource name, not an `EntityType` reference.
##
## `PlayerEggThrowEvent`: a thrown egg lands. The egg projectile does not fire it here.

import ../../../../server/serverbase
import ../../../pluginhooks

import ../../../../util/uuid

type
  PlayerEggThrowEvent* = object
    player*: Player
    eggUuid*: Uuid
    hatching*: bool
    numHatches*: uint8
    hatchingType*: string   ## upstream's `&'static EntityType`, by resource name
    cancelled*: bool

proc newPlayerEggThrowEvent*(player: Player; eggUuid: Uuid; hatching: bool; numHatches: uint8; hatchingType: string): PlayerEggThrowEvent =
  PlayerEggThrowEvent(player: player, eggUuid: eggUuid, hatching: hatching, numHatches: numHatches, hatchingType: hatchingType, cancelled: false)

proc getPlayer*(self: PlayerEggThrowEvent): Player = self.player
proc isCancelled*(self: PlayerEggThrowEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerEggThrowEvent; value: bool) = self.cancelled = value

var gEggThrowHook*: proc(event: var PlayerEggThrowEvent) {.closure.} =
  proc(event: var PlayerEggThrowEvent) {.closure.} = discard
  ## `plugin_manager.fire(event)`: nothing sets it (no WIT conversion for it in src/plugin/wit).

proc firePlayerEggThrow*(event: var PlayerEggThrowEvent) = gEggThrowHook(event)
