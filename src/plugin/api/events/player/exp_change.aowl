## Port of pumpkin/src/plugin/api/events/player/exp_change.rs
##
## `PlayerExpChangeEvent`: fired when a player gains experience (`gPlayerHooks.addExperiencePoints` wrapper, src/plugin/pluginmgr.aowl). Not cancellable; `amount` is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerExpChangeEvent* = object
    player*: Player
    amount*: int32

proc newPlayerExpChangeEvent*(player: Player; amount: int32): PlayerExpChangeEvent =
  PlayerExpChangeEvent(player: player, amount: amount)

proc getPlayer*(self: PlayerExpChangeEvent): Player = self.player

proc firePlayerExpChange*(event: var PlayerExpChangeEvent) =
  event.amount = gPluginExpChangeHook(event.player, event.amount)
