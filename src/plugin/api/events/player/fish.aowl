## Port of pumpkin/src/plugin/api/events/player/fish.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/fish.rs - the event type only: the fishing bobber does not fire it and the host has no WIT conversion for it.
##
## `PlayerFishEvent` and `PlayerFishState`: fishing rod events. Fishing bobbers do not fire it here.

import ../../../../server/serverbase
import ../../../pluginhooks

import std/options
import ../../../../util/uuid
import ../../../../server/net/netbase

type
  PlayerFishState* = enum
    pfsFishing
    pfsCaughtFish
    pfsCaughtEntity
    pfsInGround
    pfsFailedAttempt
    pfsReelIn
    pfsBite

  PlayerFishEvent* = object
    player*: Player
    caughtUuid*: Option[Uuid]
    caughtType*: string
    hookUuid*: Uuid
    state*: PlayerFishState
    hand*: Hand
    expToDrop*: int32
    cancelled*: bool

proc newPlayerFishEvent*(player: Player; caughtUuid: Option[Uuid]; hookUuid: Uuid; caughtType: string; state: PlayerFishState;
                         hand: Hand; expToDrop: int32): PlayerFishEvent =
  PlayerFishEvent(player: player, caughtUuid: caughtUuid, hookUuid: hookUuid, caughtType: caughtType, state: state, hand: hand,
                  expToDrop: expToDrop, cancelled: false)

proc getPlayer*(self: PlayerFishEvent): Player = self.player
proc isCancelled*(self: PlayerFishEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerFishEvent; value: bool) = self.cancelled = value

var gFishHook*: proc(event: var PlayerFishEvent) {.closure.} =
  proc(event: var PlayerFishEvent) {.closure.} = discard
  ## `plugin_manager.fire(event)`: nothing sets it (no WIT conversion for it in src/plugin/wit).

proc firePlayerFish*(event: var PlayerFishEvent) = gFishHook(event)
