## Port of pumpkin/src/plugin/api/events/player/inventory_close.rs
##
## `InventoryCloseEvent`: fired by `Player.onHandledScreenClosed` (src/server/entity/player.aowl); `windowType` is none for the player's own inventory. Not cancellable.

import ../../../../server/serverbase
import ../../../pluginhooks
import std/options
import ../../../../generated/screen

type
  InventoryCloseEvent* = object
    player*: Player
    windowType*: Option[WindowType]

proc newInventoryCloseEvent*(player: Player; windowType: Option[WindowType]): InventoryCloseEvent =
  InventoryCloseEvent(player: player, windowType: windowType)

proc getPlayer*(self: InventoryCloseEvent): Player = self.player

proc fireInventoryClose*(event: InventoryCloseEvent) =
  var ev = newPlayerEv(pekInventoryClose)
  ev.n = (if event.windowType.isSome: int64(ord(event.windowType.unsafeGet)) else: -1'i64)
  discard gPluginPlayerEventHook(event.player, ev)
