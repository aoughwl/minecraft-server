## Port of pumpkin/src/plugin/api/events/player/inventory_interact.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/inventory_interact.rs - `clickedItem`/`cursor` are plain `ItemStack`s (the empty stack for upstream's `None`) and `clickType` is the WIT index, not a `ClickType` enum.
##
## `InventoryClickEvent`: fired by `handleClickContainer` (src/server/net/java/play.aowl); a cancel cancels the click. `clickType` is the WIT `click-type` index (0 left, 1 right, 2 shift-left, 3 shift-right, 4 middle, 5 drop, 6 control-drop, 7 double-click, 8 number-key, 9 unknown).

import ../../../../server/serverbase
import ../../../pluginhooks
import std/options
import ../../../../generated/screen
import "../../../../data/item_stack/mod"

type
  InventoryClickEvent* = object
    player*: Player
    windowType*: Option[WindowType]
    clickType*: int
    slot*, rawSlot*: int16
    clickedItem*, cursor*: ItemStack
    hotbarButton*: int32
    cancelled*: bool

proc newInventoryClickEvent*(player: Player; windowType: Option[WindowType]; clickType: int; slot, rawSlot: int16; clickedItem, cursor: ItemStack; hotbarButton: int32): InventoryClickEvent =
  InventoryClickEvent(player: player, windowType: windowType, clickType: clickType, slot: slot, rawSlot: rawSlot, clickedItem: clickedItem, cursor: cursor, hotbarButton: hotbarButton, cancelled: false)

proc getPlayer*(self: InventoryClickEvent): Player = self.player
proc isCancelled*(self: InventoryClickEvent): bool = self.cancelled
proc setCancelled*(self: var InventoryClickEvent; value: bool) = self.cancelled = value

proc fireInventoryClick*(event: var InventoryClickEvent) =
  var ev = newPlayerEv(pekInventoryClick)
  ev.n = (if event.windowType.isSome: int64(ord(event.windowType.unsafeGet)) else: -1'i64)
  ev.n2 = int64(event.clickType)
  ev.n3 = int64(event.slot)
  ev.n4 = int64(event.rawSlot)
  ev.n5 = int64(event.hotbarButton)
  ev.stack = event.clickedItem
  ev.stack2 = event.cursor
  event.cancelled = gPluginPlayerEventHook(event.player, ev)[0]
