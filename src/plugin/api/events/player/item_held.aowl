## Port of pumpkin/src/plugin/api/events/player/item_held.rs
##
## `PlayerItemHeldEvent`: fired by `handleSetHeldItem` (src/server/net/java/play.aowl); a cancel puts the selected slot back.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerItemHeldEvent* = object
    player*: Player
    previousSlot*, newSlot*: uint8
    cancelled*: bool

proc newPlayerItemHeldEvent*(player: Player; previousSlot, newSlot: uint8): PlayerItemHeldEvent =
  PlayerItemHeldEvent(player: player, previousSlot: previousSlot, newSlot: newSlot, cancelled: false)

proc getPlayer*(self: PlayerItemHeldEvent): Player = self.player
proc isCancelled*(self: PlayerItemHeldEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerItemHeldEvent; value: bool) = self.cancelled = value

proc firePlayerItemHeld*(event: var PlayerItemHeldEvent) =
  event.cancelled = callPluginItemHeldHook(event.player, int(event.previousSlot), int(event.newSlot))
