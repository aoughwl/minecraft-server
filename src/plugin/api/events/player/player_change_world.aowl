## Port of pumpkin/src/plugin/api/events/player/player_change_world.rs
##
## `PlayerChangeWorldEvent`: fired when a player moves between worlds (src/server/world/worldmod.aowl); position and rotation are rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/vector3

type
  PlayerChangeWorldEvent* = object
    player*: Player
    previousWorld*, newWorld*: World
    position*: Vector3[float64]
    yaw*, pitch*: float32
    cancelled*: bool

proc newPlayerChangeWorldEvent*(player: Player; previousWorld, newWorld: World; position: Vector3[float64]; yaw, pitch: float32): PlayerChangeWorldEvent =
  PlayerChangeWorldEvent(player: player, previousWorld: previousWorld, newWorld: newWorld, position: position, yaw: yaw, pitch: pitch, cancelled: false)

proc getPlayer*(self: PlayerChangeWorldEvent): Player = self.player
proc isCancelled*(self: PlayerChangeWorldEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerChangeWorldEvent; value: bool) = self.cancelled = value

proc firePlayerChangeWorld*(event: var PlayerChangeWorldEvent) =
  let (cancelled, pos, yaw, pitch) = callPluginChangeWorldHook(event.player, event.previousWorld, event.newWorld, event.position, event.yaw, event.pitch)
  event.cancelled = cancelled
  event.position = pos
  event.yaw = yaw
  event.pitch = pitch
