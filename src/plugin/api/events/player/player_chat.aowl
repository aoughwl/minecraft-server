## Port of pumpkin/src/plugin/api/events/player/player_chat.rs
##
## `PlayerChatEvent`: fired by `handleChatMessage` (src/server/net/java/play.aowl); the message is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerChatEvent* = object
    player*: Player
    message*: string
    recipients*: seq[Player]
    cancelled*: bool

proc newPlayerChatEvent*(player: Player; message: string; recipients: seq[Player]): PlayerChatEvent =
  PlayerChatEvent(player: player, message: message, recipients: recipients, cancelled: false)

proc getPlayer*(self: PlayerChatEvent): Player = self.player
proc isCancelled*(self: PlayerChatEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerChatEvent; value: bool) = self.cancelled = value

proc firePlayerChat*(event: var PlayerChatEvent) =
  ## The recipients are the sender's world's players (the host rebuilds them); plugins cannot change them.
  let (cancelled, message) = gPluginChatHook(event.player, event.message)
  event.cancelled = cancelled
  event.message = message
