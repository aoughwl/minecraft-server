## Port of pumpkin/src/plugin/api/events/player/player_command_send.rs
##
## `PlayerCommandSendEvent`: fired by `handleChatCommand` (src/server/net/java/play.aowl); the command is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerCommandSendEvent* = object
    player*: Player
    command*: string
    cancelled*: bool

proc newPlayerCommandSendEvent*(player: Player; command: string): PlayerCommandSendEvent =
  PlayerCommandSendEvent(player: player, command: command, cancelled: false)

proc getPlayer*(self: PlayerCommandSendEvent): Player = self.player
proc isCancelled*(self: PlayerCommandSendEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerCommandSendEvent; value: bool) = self.cancelled = value

proc firePlayerCommandSend*(event: var PlayerCommandSendEvent) =
  let (cancelled, command) = callPluginCommandHook(event.player, event.command)
  event.cancelled = cancelled
  event.command = command
