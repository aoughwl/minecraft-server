## Port of pumpkin/src/plugin/api/events/player/player_custom_payload.rs
##
## `PlayerCustomPayloadEvent`: fired by `handleCustomPayload` for a plugin-channel message. Not cancellable.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerCustomPayloadEvent* = object
    player*: Player
    channel*: string
    data*: seq[byte]

proc newPlayerCustomPayloadEvent*(player: Player; channel: string; data: seq[byte]): PlayerCustomPayloadEvent =
  PlayerCustomPayloadEvent(player: player, channel: channel, data: data)

proc getPlayer*(self: PlayerCustomPayloadEvent): Player = self.player

proc firePlayerCustomPayload*(event: PlayerCustomPayloadEvent) =
  var ev = newPlayerEv(pekCustomPayload)
  ev.text = event.channel
  ev.data = event.data
  discard gPluginPlayerEventHook(event.player, ev)
