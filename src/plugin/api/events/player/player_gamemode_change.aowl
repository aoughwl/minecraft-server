## Port of pumpkin/src/plugin/api/events/player/player_gamemode_change.rs
##
## `PlayerGamemodeChangeEvent`: fired by `Player.setGamemode` (src/server/entity/player.aowl); the new mode is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/gamemode

type
  PlayerGamemodeChangeEvent* = object
    player*: Player
    previousGamemode*, newGamemode*: GameMode
    cancelled*: bool

proc newPlayerGamemodeChangeEvent*(player: Player; previousGamemode, newGamemode: GameMode): PlayerGamemodeChangeEvent =
  PlayerGamemodeChangeEvent(player: player, previousGamemode: previousGamemode, newGamemode: newGamemode, cancelled: false)

proc getPlayer*(self: PlayerGamemodeChangeEvent): Player = self.player
proc isCancelled*(self: PlayerGamemodeChangeEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerGamemodeChangeEvent; value: bool) = self.cancelled = value

proc firePlayerGamemodeChange*(event: var PlayerGamemodeChangeEvent) =
  let (cancelled, mode) = callPluginGameModeHook(event.player, event.previousGamemode, event.newGamemode)
  event.cancelled = cancelled
  event.newGamemode = mode
