## Port of pumpkin/src/plugin/api/events/player/player_interact_entity_event.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/player_interact_entity_event.rs - upstream holds the target as `Arc<dyn EntityBase>`; here the target is its entity id (`targetId`), the call site holds the entity itself.
##
## `PlayerInteractEntityEvent`: fired by `handleInteract` (src/server/net/java/play.aowl) when the target entity exists; a cancel stops the interaction.

import ../../../../server/serverbase
import ../../../pluginhooks
import std/options
import ../../../../util/vector3
import ../../../../protocol/java/server/play/interact

type
  PlayerInteractEntityEvent* = object
    player*: Player
    targetId*: int32
    action*: ActionType
    targetPosition*: Option[Vector3[float64]]
    sneaking*: bool
    cancelled*: bool

proc newPlayerInteractEntityEvent*(player: Player; targetId: int32; action: ActionType; targetPosition: Option[Vector3[float64]]; sneaking: bool): PlayerInteractEntityEvent =
  PlayerInteractEntityEvent(player: player, targetId: targetId, action: action, targetPosition: targetPosition, sneaking: sneaking, cancelled: false)

proc getPlayer*(self: PlayerInteractEntityEvent): Player = self.player
proc isCancelled*(self: PlayerInteractEntityEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerInteractEntityEvent; value: bool) = self.cancelled = value

proc firePlayerInteractEntity*(event: var PlayerInteractEntityEvent) =
  var ev = newPlayerEv(pekInteractEntity)
  ev.n = int64(event.targetId)
  ev.n2 = int64(ord(event.action))
  ev.flag = event.sneaking
  event.cancelled = callPluginPlayerEventHook(event.player, ev)[0]
