## Port of pumpkin/src/plugin/api/events/player/player_interact_event.rs
## PARTIAL: pumpkin/src/plugin/api/events/player/player_interact_event.rs - `block` is the registry name of the clicked block (a string), not the `Block` reference; for the left-click and air actions the host re-raycasts the target block itself rather than taking `clickedPos`.
##
## `PlayerInteractEvent`: left/right click on a block or the air. Fired by `handleSwingArm` (left), `handleUseItemOn` (right click block) and `handleUseItem` (right click air).

import ../../../../server/serverbase
import ../../../pluginhooks

import std/options
import ../../../../util/math/position

type
  InteractAction* = enum
    ## Named as upstream; the same names exist in src/plugin_api/eventdata.aowl (the WIT mirror), so qualify when both are in scope.
    iaLeftClickBlock
    iaLeftClickAir
    iaRightClickAir
    iaRightClickBlock

  PlayerInteractEvent* = object
    player*: Player
    action*: InteractAction
    clickedPos*: Option[BlockPos]
    blockName*: string   ## upstream's `&'static Block`, by registry name
    cancelled*: bool

proc isLeftClick*(self: InteractAction): bool = self == iaLeftClickAir or self == iaLeftClickBlock
proc isRightClick*(self: InteractAction): bool = self == iaRightClickAir or self == iaRightClickBlock

proc newPlayerInteractEvent*(player: Player; action: InteractAction; blockName: string; clickedPos: Option[BlockPos]): PlayerInteractEvent =
  PlayerInteractEvent(player: player, action: action, clickedPos: clickedPos, blockName: blockName, cancelled: false)

proc getPlayer*(self: PlayerInteractEvent): Player = self.player
proc isCancelled*(self: PlayerInteractEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerInteractEvent; value: bool) = self.cancelled = value

proc firePlayerInteract*(event: var PlayerInteractEvent) =
  ## A right click on a block goes through `gPluginInteractHook` with the position; the clicks on the air and the left click
  ## on a block are the swing/use events of the host, which raycasts the block itself.
  case event.action
  of iaRightClickBlock:
    event.cancelled = gPluginInteractHook(event.player, 3, event.clickedPos)
  of iaLeftClickBlock, iaLeftClickAir:
    event.cancelled = gPluginPlayerEventHook(event.player, newPlayerEv(pekSwingArm))[0]
  of iaRightClickAir:
    event.cancelled = gPluginPlayerEventHook(event.player, newPlayerEv(pekUseItem))[0]
