## Port of pumpkin/src/plugin/api/events/player/player_interact_unknown_entity_event.rs
##
## `PlayerInteractUnknownEntityEvent`: fired by `handleInteract` when no entity has that id; a cancel stops the kick for an attack.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../protocol/java/server/play/interact

type
  PlayerInteractUnknownEntityEvent* = object
    player*: Player
    entityId*: int32
    action*: ActionType
    cancelled*: bool

proc newPlayerInteractUnknownEntityEvent*(player: Player; entityId: int32; action: ActionType): PlayerInteractUnknownEntityEvent =
  PlayerInteractUnknownEntityEvent(player: player, entityId: entityId, action: action, cancelled: false)

proc getPlayer*(self: PlayerInteractUnknownEntityEvent): Player = self.player
proc isCancelled*(self: PlayerInteractUnknownEntityEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerInteractUnknownEntityEvent; value: bool) = self.cancelled = value

proc firePlayerInteractUnknownEntity*(event: var PlayerInteractUnknownEntityEvent) =
  var ev = newPlayerEv(pekInteractUnknownEntity)
  ev.n = int64(event.entityId)
  ev.n2 = int64(ord(event.action))
  event.cancelled = gPluginPlayerEventHook(event.player, ev)[0]
