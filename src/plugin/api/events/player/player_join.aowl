## Port of pumpkin/src/plugin/api/events/player/player_join.rs
##
## `PlayerJoinEvent`: a player was spawned and joined; `joinMessage` is what is broadcast. Fired by `firePlayerJoin` (src/plugin/pluginmgr.aowl).

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/text/text

type
  PlayerJoinEvent* = object
    player*: Player
    joinMessage*: TextComponent
    cancelled*: bool

proc newPlayerJoinEvent*(player: Player; joinMessage: TextComponent): PlayerJoinEvent =
  PlayerJoinEvent(player: player, joinMessage: joinMessage, cancelled: false)

proc getPlayer*(self: PlayerJoinEvent): Player = self.player
proc isCancelled*(self: PlayerJoinEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerJoinEvent; value: bool) = self.cancelled = value

proc firePlayerJoinEvent*(event: var PlayerJoinEvent) =
  ## `plugin_manager.fire(event)`: the plugin host fills the hook; the plugins may cancel and rewrite the message.
  let (cancelled, message) = callPluginJoinHook(event.player, event.joinMessage)
  event.cancelled = cancelled
  event.joinMessage = message
