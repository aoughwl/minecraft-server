## Port of pumpkin/src/plugin/api/events/player/player_leave.rs
##
## `PlayerLeaveEvent`: a player left; `leaveMessage` is what is broadcast. Fired by `firePlayerLeave` (src/plugin/pluginmgr.aowl).

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/text/text

type
  PlayerLeaveEvent* = object
    player*: Player
    leaveMessage*: TextComponent
    cancelled*: bool

proc newPlayerLeaveEvent*(player: Player; leaveMessage: TextComponent): PlayerLeaveEvent =
  PlayerLeaveEvent(player: player, leaveMessage: leaveMessage, cancelled: false)

proc getPlayer*(self: PlayerLeaveEvent): Player = self.player
proc isCancelled*(self: PlayerLeaveEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerLeaveEvent; value: bool) = self.cancelled = value

proc firePlayerLeaveEvent*(event: var PlayerLeaveEvent) =
  ## `plugin_manager.fire(event)`: the plugin host fills the hook; the plugins may cancel and rewrite the message.
  let (cancelled, message) = callPluginLeaveHook(event.player, event.leaveMessage)
  event.cancelled = cancelled
  event.leaveMessage = message
