## Port of pumpkin/src/plugin/api/events/player/player_login.rs
##
## `PlayerLoginEvent`: fired by `servermod.aowl` after the player object exists and before it joins; a cancel kicks with `kickMessage`.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/text/text

type
  PlayerLoginEvent* = object
    player*: Player
    kickMessage*: TextComponent
    cancelled*: bool

proc newPlayerLoginEvent*(player: Player; kickMessage: TextComponent): PlayerLoginEvent =
  PlayerLoginEvent(player: player, kickMessage: kickMessage, cancelled: false)

proc getPlayer*(self: PlayerLoginEvent): Player = self.player
proc isCancelled*(self: PlayerLoginEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerLoginEvent; value: bool) = self.cancelled = value

proc firePlayerLogin*(event: var PlayerLoginEvent) =
  ## `plugin_manager.fire`: the hook (`gPluginLoginHook`) takes the default kick message from the plugins' answer.
  let (cancelled, message) = gPluginLoginHook(event.player)
  event.cancelled = cancelled
  if cancelled: event.kickMessage = message
