## Port of pumpkin/src/plugin/api/events/player/player_move.rs
##
## `PlayerMoveEvent`: fired by `handleMovePlayer`/`handleMovePlayerPosRot` (src/server/net/java/play.aowl); a cancel keeps the player where it is. `to` is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/vector3

type
  PlayerMoveEvent* = object
    player*: Player
    `from`*, to*: Vector3[float64]
    cancelled*: bool

proc newPlayerMoveEvent*(player: Player; fromPos, to: Vector3[float64]): PlayerMoveEvent =
  PlayerMoveEvent(player: player, `from`: fromPos, to: to, cancelled: false)

proc getPlayer*(self: PlayerMoveEvent): Player = self.player
proc isCancelled*(self: PlayerMoveEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerMoveEvent; value: bool) = self.cancelled = value

proc firePlayerMove*(event: var PlayerMoveEvent) =
  let (cancelled, pos) = gPluginMoveHook(event.player, event.`from`, event.to)
  event.cancelled = cancelled
  event.to = pos
