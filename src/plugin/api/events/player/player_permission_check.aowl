## Port of pumpkin/src/plugin/api/events/player/player_permission_check.rs
##
## `PlayerPermissionCheckEvent`: fired by `Player.has_permission` (the `hasPermission` wrapper of src/plugin/pluginmgr.aowl); plugins may change `result`. Not cancellable.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerPermissionCheckEvent* = object
    player*: Player
    permission*: string
    result*: bool

proc newPlayerPermissionCheckEvent*(player: Player; permission: string; initial: bool): PlayerPermissionCheckEvent =
  PlayerPermissionCheckEvent(player: player, permission: permission, result: initial)

proc getPlayer*(self: PlayerPermissionCheckEvent): Player = self.player

proc firePlayerPermissionCheck*(event: var PlayerPermissionCheckEvent) =
  var ev = newPlayerEv(pekPermissionCheck)
  ev.text = event.permission
  ev.flag = event.result
  event.result = gPluginPlayerEventHook(event.player, ev)[1]
