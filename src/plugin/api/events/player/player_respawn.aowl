## Port of pumpkin/src/plugin/api/events/player/player_respawn.rs
##
## `PlayerRespawnEvent`: fired after a respawn (`gPlayerRespawnedHook`, wrapped in src/plugin/pluginmgr.aowl). Not cancellable.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/vector3

type
  PlayerRespawnEvent* = object
    player*: Player
    previousWorld*, respawnedWorld*: World
    position*: Vector3[float64]
    yaw*, pitch*: float32
    alive*: bool

proc newPlayerRespawnEvent*(player: Player; previousWorld, respawnedWorld: World; position: Vector3[float64]; yaw, pitch: float32; alive: bool): PlayerRespawnEvent =
  PlayerRespawnEvent(player: player, previousWorld: previousWorld, respawnedWorld: respawnedWorld, position: position, yaw: yaw, pitch: pitch, alive: alive)

proc getPlayer*(self: PlayerRespawnEvent): Player = self.player

proc firePlayerRespawn*(event: PlayerRespawnEvent) =
  callPluginRespawnHook(event.player, event.previousWorld, event.respawnedWorld, event.position, event.yaw, event.pitch, event.alive)
