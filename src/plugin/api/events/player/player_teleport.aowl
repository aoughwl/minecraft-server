## Port of pumpkin/src/plugin/api/events/player/player_teleport.rs
##
## `PlayerTeleportEvent`: fired by `Player.teleport` (src/server/entity/player.aowl); the destination is rewritten by plugins.

import ../../../../server/serverbase
import ../../../pluginhooks
import ../../../../util/vector3

type
  PlayerTeleportEvent* = object
    player*: Player
    `from`*, to*: Vector3[float64]
    cancelled*: bool

proc newPlayerTeleportEvent*(player: Player; fromPos, to: Vector3[float64]): PlayerTeleportEvent =
  PlayerTeleportEvent(player: player, `from`: fromPos, to: to, cancelled: false)

proc getPlayer*(self: PlayerTeleportEvent): Player = self.player
proc isCancelled*(self: PlayerTeleportEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerTeleportEvent; value: bool) = self.cancelled = value

proc firePlayerTeleport*(event: var PlayerTeleportEvent) =
  let (cancelled, pos) = gPluginTeleportHook(event.player, event.`from`, event.to)
  event.cancelled = cancelled
  event.to = pos
