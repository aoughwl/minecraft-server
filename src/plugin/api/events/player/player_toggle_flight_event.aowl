## Port of pumpkin/src/plugin/api/events/player/player_toggle_flight_event.rs
##
## `PlayerToggleFlightEvent`: fired by `handlePlayerAbilities` (src/server/net/java/play.aowl).

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerToggleFlightEvent* = object
    player*: Player
    isFlying*: bool
    cancelled*: bool

proc newPlayerToggleFlightEvent*(player: Player; isFlying: bool): PlayerToggleFlightEvent =
  PlayerToggleFlightEvent(player: player, isFlying: isFlying, cancelled: false)

proc getPlayer*(self: PlayerToggleFlightEvent): Player = self.player
proc isCancelled*(self: PlayerToggleFlightEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerToggleFlightEvent; value: bool) = self.cancelled = value

proc firePlayerToggleFlight*(event: var PlayerToggleFlightEvent) =
  event.cancelled = gPluginToggleHook(event.player, 2, event.isFlying)
