## Port of pumpkin/src/plugin/api/events/player/player_toggle_sneak_event.rs
##
## `PlayerToggleSneakEvent`: fired by `handlePlayerCommand`.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerToggleSneakEvent* = object
    player*: Player
    isSneaking*: bool
    cancelled*: bool

proc newPlayerToggleSneakEvent*(player: Player; isSneaking: bool): PlayerToggleSneakEvent =
  PlayerToggleSneakEvent(player: player, isSneaking: isSneaking, cancelled: false)

proc getPlayer*(self: PlayerToggleSneakEvent): Player = self.player
proc isCancelled*(self: PlayerToggleSneakEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerToggleSneakEvent; value: bool) = self.cancelled = value

proc firePlayerToggleSneak*(event: var PlayerToggleSneakEvent) =
  event.cancelled = callPluginToggleHook(event.player, 0, event.isSneaking)
