## Port of pumpkin/src/plugin/api/events/player/player_toggle_sprint_event.rs
##
## `PlayerToggleSprintEvent`: fired by `handlePlayerCommand`.

import ../../../../server/serverbase
import ../../../pluginhooks

type
  PlayerToggleSprintEvent* = object
    player*: Player
    isSprinting*: bool
    cancelled*: bool

proc newPlayerToggleSprintEvent*(player: Player; isSprinting: bool): PlayerToggleSprintEvent =
  PlayerToggleSprintEvent(player: player, isSprinting: isSprinting, cancelled: false)

proc getPlayer*(self: PlayerToggleSprintEvent): Player = self.player
proc isCancelled*(self: PlayerToggleSprintEvent): bool = self.cancelled
proc setCancelled*(self: var PlayerToggleSprintEvent; value: bool) = self.cancelled = value

proc firePlayerToggleSprint*(event: var PlayerToggleSprintEvent) =
  event.cancelled = callPluginToggleHook(event.player, 1, event.isSprinting)
