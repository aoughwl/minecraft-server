## Tests for the player events (pumpkin/src/plugin/api/events/player/*.rs): each event is built with its constructor, fired through
## its `fire*` proc into recording hooks standing in for the plugin host, and what the plugins changed or cancelled is read back.
import std/[syncio, assertions, options]
import "mod"
import ../../../pluginhooks
import ../../../../server/serverbase
import ../../../../util/vector3
import ../../../../util/gamemode
import ../../../../util/text/text
import ../../../../server/net/netbase
import ../../../../generated/screen
import ../../../../protocol/java/server/play/interact
import ../../../../util/uuid
import ../../../../util/math/position
import "../../../../data/item_stack/mod" as itemmod

proc v(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)

let player = Player(entityId: 7'i32)
let world1 = World()
let world2 = World()

# move: cancelled by the hook when the destination x > 100; otherwise rewritten
gPluginMoveHook = proc(p: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
  if toPos.x > 100.0: (true, toPos) else: (false, v(toPos.x, toPos.y + 1.0, toPos.z))
var mvEv = newPlayerMoveEvent(player, v(0, 0, 0), v(1, 2, 3))
assert mvEv.getPlayer().entityId == 7'i32
firePlayerMove(mvEv)
assert not mvEv.cancelled and mvEv.to.y == 3.0
var mv2Ev = newPlayerMoveEvent(player, v(0, 0, 0), v(500, 0, 0))
firePlayerMove(mv2Ev)
assert mv2Ev.cancelled
mv2Ev.setCancelled(false)
assert not mv2Ev.isCancelled()

gPluginTeleportHook = proc(p: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, v(9, 9, 9))
var tpEv = newPlayerTeleportEvent(player, v(0, 0, 0), v(1, 1, 1))
firePlayerTeleport(tpEv)
assert tpEv.to.x == 9.0 and not tpEv.cancelled

gPluginChatHook = proc(p: Player; message: string): (bool, string) {.closure.} = (message == "spam", message & "!")
var chatEv = newPlayerChatEvent(player, "hi", @[player])
firePlayerChat(chatEv)
assert chatEv.message == "hi!" and not chatEv.cancelled and chatEv.recipients.len == 1
var chat2Ev = newPlayerChatEvent(player, "spam", @[])
firePlayerChat(chat2Ev)
assert chat2Ev.cancelled

gPluginCommandHook = proc(p: Player; command: string): (bool, string) {.closure.} = (false, "say " & command)
var cmdEv = newPlayerCommandSendEvent(player, "x")
firePlayerCommandSend(cmdEv)
assert cmdEv.command == "say x"

gPluginToggleHook = proc(p: Player; kind: int; value: bool): bool {.closure.} = kind == 1 and value
var snEv = newPlayerToggleSneakEvent(player, true)
firePlayerToggleSneak(snEv)
assert not snEv.cancelled
var spEv = newPlayerToggleSprintEvent(player, true)
firePlayerToggleSprint(spEv)
assert spEv.cancelled
var flEv = newPlayerToggleFlightEvent(player, true)
firePlayerToggleFlight(flEv)
assert not flEv.cancelled

gPluginGameModeHook = proc(p: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = (false, Creative)
var gmEv = newPlayerGamemodeChangeEvent(player, Survival, Adventure)
firePlayerGamemodeChange(gmEv)
assert gmEv.newGamemode == Creative and gmEv.previousGamemode == Survival

gPluginItemHeldHook = proc(p: Player; previous, next: int): bool {.closure.} = next == 8
var heldEv = newPlayerItemHeldEvent(player, 0'u8, 8'u8)
firePlayerItemHeld(heldEv)
assert heldEv.cancelled

gPluginChangeWorldHook = proc(p: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32) {.closure.} =
  (false, v(pos.x, 70, pos.z), yaw + 90.0'f32, pitch)
var cwEv = newPlayerChangeWorldEvent(player, world1, world2, v(1, 2, 3), 10.0'f32, 5.0'f32)
firePlayerChangeWorld(cwEv)
assert cwEv.position.y == 70.0 and cwEv.yaw == 100.0'f32 and cwEv.pitch == 5.0'f32

gPluginLoginHook = proc(p: Player): (bool, TextComponent) {.closure.} = (true, text("no"))
var loginEv = newPlayerLoginEvent(player, text("default"))
firePlayerLogin(loginEv)
assert loginEv.cancelled

gPluginJoinHook = proc(p: Player; message: TextComponent): (bool, TextComponent) {.closure.} = (false, text("welcome"))
var joinEv = newPlayerJoinEvent(player, text("x joined"))
firePlayerJoinEvent(joinEv)
assert not joinEv.cancelled
gPluginLeaveHook = proc(p: Player; message: TextComponent): (bool, TextComponent) {.closure.} = (true, message)
var leaveEv = newPlayerLeaveEvent(player, text("x left"))
firePlayerLeaveEvent(leaveEv)
assert leaveEv.cancelled

var respawned = 0
gPluginRespawnHook = proc(p: Player; previous, respawnedWorld: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} =
  if alive and pos.x == 4.0: inc respawned
firePlayerRespawn(newPlayerRespawnEvent(player, world1, world2, v(4, 0, 0), 0.0'f32, 0.0'f32, true))
assert respawned == 1

gPluginExpChangeHook = proc(p: Player; amount: int32): int32 {.closure.} = amount * 2'i32
var expEv = newPlayerExpChangeEvent(player, 5'i32)
firePlayerExpChange(expEv)
assert expEv.amount == 10'i32

# the PlayerEv based events: one recording hook
var seen: seq[PlayerEv] = @[]
gPluginPlayerEventHook = proc(p: Player; ev: PlayerEv): (bool, bool) {.closure.} =
  seen.add ev
  (ev.kind == pekInteractEntity or ev.kind == pekInventoryClick or ev.kind == pekSwingArm, ev.flag or ev.kind == pekPermissionCheck)
var permEv = newPlayerPermissionCheckEvent(player, "minecraft.command.op", false)
firePlayerPermissionCheck(permEv)
assert permEv.result and seen[^1].kind == pekPermissionCheck and seen[^1].text == "minecraft.command.op"

firePlayerChangedMainHand(newPlayerChangedMainHandEvent(player, hLeft))
assert seen[^1].kind == pekChangedMainHand and seen[^1].n == 0
firePlayerChangedMainHand(newPlayerChangedMainHandEvent(player, hRight))
assert seen[^1].n == 1
firePlayerCustomPayload(newPlayerCustomPayloadEvent(player, "mc:test", @[1'u8, 2'u8]))
assert seen[^1].kind == pekCustomPayload and seen[^1].text == "mc:test" and seen[^1].data.len == 2
fireInventoryClose(newInventoryCloseEvent(player, none[WindowType]()))
assert seen[^1].kind == pekInventoryClose and seen[^1].n == -1
fireInventoryClose(newInventoryCloseEvent(player, some(wtAnvil)))
assert seen[^1].n == int64(ord(wtAnvil))

var clickEv = newInventoryClickEvent(player, some(wtFurnace), 1, 3'i16, 3'i16, emptyItemStack(), emptyItemStack(), -1'i32)
fireInventoryClick(clickEv)
assert clickEv.cancelled and seen[^1].n3 == 3 and seen[^1].n2 == 1 and seen[^1].n == int64(ord(wtFurnace))

var ieEv = newPlayerInteractEntityEvent(player, 42'i32, atAttack, none[Vector3[float64]](), true)
firePlayerInteractEntity(ieEv)
assert ieEv.cancelled and seen[^1].n == 42 and seen[^1].n2 == int64(ord(atAttack)) and seen[^1].flag
var iuEv = newPlayerInteractUnknownEntityEvent(player, 43'i32, atInteract)
firePlayerInteractUnknownEntity(iuEv)
assert not iuEv.cancelled and seen[^1].kind == pekInteractUnknownEntity

# interact: right clickEv on a block goes through gPluginInteractHook, the others through PlayerEv
var interactAction = -1
gPluginInteractHook = proc(p: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
  interactAction = action
  pos.isSome
var rcbEv = newPlayerInteractEvent(player, iaRightClickBlock, "stone", some(newBlockPos(1'i32, 2'i32, 3'i32)))
firePlayerInteract(rcbEv)
assert rcbEv.cancelled and interactAction == 3
var lcaEv = newPlayerInteractEvent(player, iaLeftClickAir, "air", none[BlockPos]())
firePlayerInteract(lcaEv)
assert lcaEv.cancelled and seen[^1].kind == pekSwingArm
var rcaEv = newPlayerInteractEvent(player, iaRightClickAir, "air", none[BlockPos]())
firePlayerInteract(rcaEv)
assert not rcaEv.cancelled and seen[^1].kind == pekUseItem
assert iaLeftClickBlock.isLeftClick() and iaRightClickBlock.isRightClick() and not iaLeftClickAir.isRightClick()

# the events with no firing site keep their data
var fishedEv = newPlayerFishEvent(player, none[Uuid](), NilUuid, "cod", pfsBite, hLeft, 3'i32)
firePlayerFish(fishedEv)
assert fishedEv.state == pfsBite and fishedEv.expToDrop == 3'i32 and not fishedEv.cancelled
var eggEv = newPlayerEggThrowEvent(player, NilUuid, true, 1'u8, "chicken")
firePlayerEggThrow(eggEv)
assert eggEv.hatching
fireCustomClickAction(newCustomClickActionEvent(player, "id", none[seq[byte]]()))
echo "playerevents ok"
