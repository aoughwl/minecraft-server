## Port of pumpkin/src/plugin/api/events/server/packet.rs
##
## `PacketReceivedEvent` (before a play packet is handled) and `PacketSentEvent` (before one is written), both cancellable.
## `payload` is upstream's `Bytes`. `packet` of the sent event is upstream's `Arc<dyn Any>` (the typed packet, which the WASM
## host turns into the generated WIT record); the writer here has the payload only (`writePacketFor` encodes first), so it
## is `RootRef` and nil.
import ../../../../server/serverbase

type
  PacketReceivedEvent* = object
    player*: Player
    packetId*: int32
    payload*: seq[byte]
    cancelled*: bool

  PacketSentEvent* = object
    player*: Player
    packetId*: int32
    payload*: seq[byte]
    packet*: RootRef
    cancelled*: bool

proc newPacketReceivedEvent*(player: Player; packetId: int32; payload: seq[byte]): PacketReceivedEvent =
  PacketReceivedEvent(player: player, packetId: packetId, payload: payload, cancelled: false)

proc newPacketSentEvent*(player: Player; packetId: int32; payload: seq[byte]; packet: RootRef): PacketSentEvent =
  PacketSentEvent(player: player, packetId: packetId, payload: payload, packet: packet, cancelled: false)
