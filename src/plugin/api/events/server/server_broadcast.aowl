## Port of pumpkin/src/plugin/api/events/server/server_broadcast.rs
##
## An event that occurs when something tries to broadcast a message to the server: the message and the name of the sender
## as a `TextComponent`. Fired by `Server::broadcast_message` (`send_cancellable!`).
import ../../../../util/text/text

type
  ServerBroadcastEvent* = object
    message*: TextComponent
    sender*: TextComponent
    cancelled*: bool

proc newServerBroadcastEvent*(message, sender: TextComponent): ServerBroadcastEvent =
  ServerBroadcastEvent(message: message, sender: sender, cancelled: false)
