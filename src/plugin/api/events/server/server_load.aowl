## Port of pumpkin/src/plugin/api/events/server/server_load.rs
##
## An event that fires once the server has finished loading (not cancellable).
type
  LoadType* = enum
    ## The reason a `ServerLoadEvent` fired.
    ltStartup   ## The server finished its normal startup sequence.
    ltReload    ## The server finished a full reload sequence.

  ServerLoadEvent* = object
    loadType*: LoadType

proc newServerLoadEvent*(loadType: LoadType): ServerLoadEvent = ServerLoadEvent(loadType: loadType)
