## Port of pumpkin/src/plugin/api/events/server/server_tick_end.rs
##
## An event that fires at the end of every server tick (not cancellable): the 0-indexed number of the tick that just
## finished and its duration in nanoseconds.
type
  ServerTickEndEvent* = object
    tick*: int32
    durationNanos*: int64

proc newServerTickEndEvent*(tick: int32; durationNanos: int64): ServerTickEndEvent =
  ServerTickEndEvent(tick: tick, durationNanos: durationNanos)
