## An event that fires at the start of every server tick (not cancellable): the 0-indexed number of the tick about to run.
type
  ServerTickStartEvent* = object
    tick*: int32

proc newServerTickStartEvent*(tick: int32): ServerTickStartEvent = ServerTickStartEvent(tick: tick)
