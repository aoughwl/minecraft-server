## Port of pumpkin/src/plugin/api/events/world/chunk_load.rs
##
## An event that occurs when a chunk is loaded in a world: the world and the chunk data (upstream's `Arc<RwLock<ChunkData>>` is
## the shared `ChunkData` ref here). Upstream defines it and fires it from nowhere, and its WASM host has no conversion
## for it, so it is only the type here too.
import ../../../../world/chunkdata
import ../../../../server/serverbase

type
  ChunkLoad* = object
    world*: World
    chunk*: ChunkData
    cancelled*: bool

proc newChunkLoad*(world: World; chunk: ChunkData): ChunkLoad =
  ChunkLoad(world: world, chunk: chunk, cancelled: false)
