## Port of pumpkin/src/plugin/api/events/world/chunk_save.rs
##
## An event that occurs when a chunk is saved in a world: the world and the chunk data (upstream's `Arc<RwLock<ChunkData>>` is
## the shared `ChunkData` ref here). Upstream defines it and fires it from nowhere, and its WASM host has no conversion
## for it, so it is only the type here too.
import ../../../../world/chunkdata
import ../../../../server/serverbase

type
  ChunkSave* = object
    world*: World
    chunk*: ChunkData
    cancelled*: bool

proc newChunkSave*(world: World; chunk: ChunkData): ChunkSave =
  ChunkSave(world: world, chunk: chunk, cancelled: false)
