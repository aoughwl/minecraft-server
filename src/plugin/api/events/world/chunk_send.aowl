## Port of pumpkin/src/plugin/api/events/world/chunk_send.rs
##
## An event that occurs when a chunk is sent to a client: the world and the chunk. Upstream fires it from the Java and
## Bedrock chunk senders (net/java/mod.rs, net/bedrock/mod.rs) and its WASM host converts it only in the newer tree
## (wit/witeventsworld.aowl); the call site is net/java/javamod.aowl's `gChunkSendHook`, set by pluginwireevents.aowl.
import ../../../../world/chunkdata
import ../../../../server/serverbase

type
  ChunkSend* = object
    world*: World
    chunk*: ChunkData
    cancelled*: bool

proc newChunkSend*(world: World; chunk: ChunkData): ChunkSend =
  ChunkSend(world: world, chunk: chunk, cancelled: false)
