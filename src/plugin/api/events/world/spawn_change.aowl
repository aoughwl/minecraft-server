## Port of pumpkin/src/plugin/api/events/world/spawn_change.rs
##
## An event that occurs when the world spawn point changes (not cancellable): the previous and the new position, yaw and
## pitch. Fired by `/setworldspawn` (server/command/setworldspawn.aowl); its plugin-edited new position, yaw and pitch are
## what the command applies.
import ../../../../util/math/position
import ../../../../server/serverbase

type
  SpawnChangeEvent* = object
    world*: World
    previousPosition*: BlockPos
    previousYaw*: float32
    previousPitch*: float32
    newPosition*: BlockPos
    newYaw*: float32
    newPitch*: float32

proc newSpawnChangeEvent*(world: World; previousPosition: BlockPos; previousYaw, previousPitch: float32;
                          newPosition: BlockPos; newYaw, newPitch: float32): SpawnChangeEvent =
  SpawnChangeEvent(world: world, previousPosition: previousPosition, previousYaw: previousYaw, previousPitch: previousPitch,
                   newPosition: newPosition, newYaw: newYaw, newPitch: newPitch)
