## Port of pumpkin/src/plugin/api/events/mod.rs (`Payload`, `Cancellable`, `EventPriority`) and of the handler map of
## pumpkin/src/plugin/mod.rs (`HandlerMap`, `TypedEventHandler`, and the ordering `PluginManager::fire` applies).
##
## An event is its WIT variant case name and its fields (the `Payload` of the Rust trait is the case name here, the
## fields are the lifted `CVal` record the host builds from the plugin's own `event` type, see pluginhost.aowl). A handler is
## a registration (plugin, handler id, priority, blocking). `fire` upstream runs the blocking handlers first, in
## registration order and each with `&mut event`, then the non-blocking ones; `priority` is stored and orders nothing. That
## is `handlersFor`.
## PARTIAL: pumpkin/src/plugin/mod.rs - handlers run one after another, not concurrently (`join_all`). pluginhost.aowl's
## `fireEvent` runs the blocking pass and then the non-blocking one over its plugins' own registrations and keeps this map
## in step (register on `register-event`, `unregisterPlugin` on unload).

type
  EventPriority* = enum
    ## The order of the WIT `event-priority` enum.
    epHighest
    epHigh
    epNormal
    epLow
    epLowest

  Cancellable* = object
    cancelled*: bool

  HandlerReg* = object
    pluginId*: int
    handlerId*: int
    eventName*: string
    priority*: EventPriority
    blocking*: bool

  HandlerMap* = ref object
    regs: seq[HandlerReg]

proc cancelled*(c: Cancellable): bool = c.cancelled
proc setCancelled*(c: var Cancellable; value: bool) = c.cancelled = value

proc priorityOf*(i: int): EventPriority =
  if i <= 0: epHighest
  elif i == 1: epHigh
  elif i == 2: epNormal
  elif i == 3: epLow
  else: epLowest

proc newHandlerMap*(): HandlerMap = HandlerMap(regs: @[])

proc register*(m: HandlerMap; reg: HandlerReg) =
  ## `PluginManager::register` / `Context::register_event`: appended under the event's name.
  m.regs.add reg

proc unregisterPlugin*(m: HandlerMap; pluginId: int) =
  ## A plugin's handlers go with it (upstream drops the plugin's `Arc`s when it is unloaded).
  var kept: seq[HandlerReg] = @[]
  for r in m.regs:
    if r.pluginId != pluginId: kept.add r
  m.regs = kept

proc handlersFor*(m: HandlerMap; eventName: string): seq[HandlerReg] =
  ## `fire`'s order: the blocking handlers, then the non-blocking ones, each in registration order.
  result = @[]
  for r in m.regs:
    if r.eventName == eventName and r.blocking: result.add r
  for r in m.regs:
    if r.eventName == eventName and not r.blocking: result.add r

proc count*(m: HandlerMap): int = m.regs.len
