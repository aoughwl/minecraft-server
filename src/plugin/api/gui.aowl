## Port of pumpkin/src/plugin/api/gui.rs: `PluginGui` (window type, title, a `PluginInventory`, the two allow flags),
## `PluginInventory` (`size` stacks, all empty at first) and `PluginScreenHandler`, the screen handler that shows the
## inventory's slots to a player. `PluginInventory` is an `ArrayInventory` (src/inventory/inventory.aowl: upstream's
## `[Arc<Mutex<ItemStack>>; N]` and the same seven methods over a `seq`), whose `on_open` and `on_close` do nothing as
## upstream's. As upstream the handler adds only the container's own slots (no player inventory slots) and its
## `quick_move` answers an empty stack.
## The `gui` interface (wit/witgui.aowl) keeps its `PluginGui`s here, so a plugin that changes an item of an open gui
## changes what the player's screen handler holds.
import std/options
import "../../data/item_stack/mod"
import ../../generated/screen
import ../../inventory/[inventory, screenhandler, slot]
import ../../util/text/text

type
  PluginInventory* = ArrayInventory

  PluginGui* = ref object
    windowType*: WindowType
    title*: TextComponent
    inventory*: PluginInventory
    allowGrabItems*: bool
    allowPutItems*: bool

  PluginScreenHandler* = ref object of ScreenHandler
    inventory*: PluginInventory

proc newPluginInventory*(size: int): PluginInventory =
  ## `PluginInventory::new`
  newArrayInventory(size)

proc newPluginGui*(windowType: WindowType; title: TextComponent; size: int): PluginGui =
  PluginGui(windowType: windowType, title: title, inventory: newPluginInventory(size), allowGrabItems: true, allowPutItems: true)

proc pluginOnClosed(self: ScreenHandler; player: InventoryPlayer) =
  self.defaultOnClosed(player)
  PluginScreenHandler(self).inventory.onClose()

proc pluginQuickMove(self: ScreenHandler; player: InventoryPlayer; slotIndex: int32): ItemStack =
  emptyItemStack()

proc newPluginScreenHandler*(syncId: uint8; windowType: WindowType; inventory: PluginInventory; allowGrabItems: bool;
                             allowPutItems: bool): PluginScreenHandler =
  ## `PluginScreenHandler::new`
  let behaviour = newScreenHandlerBehaviour(syncId, some(windowType))
  behaviour.allowGrabItems = allowGrabItems
  behaviour.allowPutItems = allowPutItems
  behaviour.containerSlots = inventory.size()
  result = PluginScreenHandler(behaviour: behaviour, inventory: inventory)
  result.onClosedImpl = pluginOnClosed
  result.quickMoveImpl = pluginQuickMove
  for i in 0 ..< inventory.size():
    ScreenHandler(result).addSlot(newNormalSlot(inventory, i))
