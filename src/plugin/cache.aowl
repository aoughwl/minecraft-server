## Port of pumpkin/src/plugin/cache.rs: the permission cache (`plugins/permission_cache.json`), the answers the server owner
## gave about the permissions a plugin asked for, keyed by the SHA-256 (lowercase hex) of the plugin file. `load` of a
## missing or unreadable file is an empty cache, as upstream's `unwrap_or_default`. serde_json writes
## `{"entries": {"<hash>": {"permissions_requested": [...], "approved": true}}}`, pretty printed.
## SHA-256 is sha2.nim of the sibling `jwt` library (the one the Bedrock login already uses).
import std/[syncio, strutils]
import sha2
import ../codecs/json_value

type
  PermissionCacheEntry* = object
    permissionsRequested*: seq[string]
    approved*: bool

  PermissionCache* = object
    hashes*: seq[string]                  ## keys, in order of insertion
    entries*: seq[PermissionCacheEntry]

proc calculateHashForBytes*(bytes: string): string =
  ## `calculate_hash_for_bytes`
  var buf: seq[byte] = @[]
  for c in bytes: buf.add byte(ord(c))
  let digest = sha256(buf)
  result = ""
  for b in digest:
    result.add "0123456789abcdef"[int(b) shr 4]
    result.add "0123456789abcdef"[int(b) and 15]

proc calculateHash*(path: string): string =
  ## `calculate_hash`: "" when the file cannot be read.
  try:
    result = calculateHashForBytes(readFile(path))
  except:
    result = ""

proc indexOf*(c: PermissionCache; hash: string): int =
  result = -1
  var i = 0
  while i < c.hashes.len:
    if c.hashes[i] == hash: result = i
    inc i

proc put*(c: var PermissionCache; hash: string; entry: PermissionCacheEntry) =
  ## `entries.insert(hash, entry)`
  let i = indexOf(c, hash)
  if i >= 0: c.entries[i] = entry
  else:
    c.hashes.add hash
    c.entries.add entry

proc parseCache*(data: string): PermissionCache =
  result = PermissionCache(hashes: @[], entries: @[])
  let outcome = parseJsonValue(data)
  if not outcome.ok or outcome.value.kind != jvObject: return
  let root = outcome.value
  let (hasEntries, entries) = root.get("entries")
  if not hasEntries or entries.kind != jvObject: return
  var i = 0
  while i < entries.keys.len:
    let v = entries.vals[i]
    var perms: seq[string] = @[]
    var approved = false
    if v.kind == jvObject:
      let (hp, ps) = v.get("permissions_requested")
      if hp and ps.kind == jvArray:
        for p in ps.items:
          if p.kind == jvString: perms.add p.strVal
      let (ha, ap) = v.get("approved")
      if ha and ap.kind == jvBool: approved = ap.boolVal
    put(result, entries.keys[i], PermissionCacheEntry(permissionsRequested: perms, approved: approved))
    inc i

proc load*(path: string): PermissionCache =
  try:
    result = parseCache(readFile(path))
  except:
    result = PermissionCache(hashes: @[], entries: @[])

proc quoted(s: string): string =
  result = ""
  addEscaped(result, s)

proc toJsonText*(c: PermissionCache): string =
  ## `serde_json::to_string_pretty`: two-space indent, `"key": value`, empty arrays as `[]`.
  if c.hashes.len == 0: return "{\n  \"entries\": {}\n}"
  result = "{\n  \"entries\": {\n"
  var i = 0
  while i < c.hashes.len:
    result.add "    " & quoted(c.hashes[i]) & ": {\n"
    if c.entries[i].permissionsRequested.len == 0:
      result.add "      \"permissions_requested\": [],\n"
    else:
      result.add "      \"permissions_requested\": [\n"
      var k = 0
      while k < c.entries[i].permissionsRequested.len:
        result.add "        " & quoted(c.entries[i].permissionsRequested[k])
        if k < c.entries[i].permissionsRequested.len - 1: result.add ","
        result.add "\n"
        inc k
      result.add "      ],\n"
    result.add "      \"approved\": " & (if c.entries[i].approved: "true" else: "false") & "\n"
    result.add "    }"
    if i < c.hashes.len - 1: result.add ","
    result.add "\n"
    inc i
  result.add "  }\n}"

proc save*(c: PermissionCache; path: string): bool =
  try:
    writeFile(path, toJsonText(c))
    true
  except:
    false
