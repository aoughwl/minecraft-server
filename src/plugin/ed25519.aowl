## Ed25519 (RFC 8032, section 5.1) over the `jwt` package's BigInt and SHA-512: the `ed25519_dalek` calls the plugin
## signature code makes (`SigningKey::from_bytes`, `verifying_key`, `sign`, `VerifyingKey::verify`). No upstream file:
## the Rust uses the ed25519-dalek crate, this is its aowlmony stand-in. Variable time, which is fine for verifying
## published plugins; do not use it to sign with a secret exposed to a timing attacker.
## Verification is dalek's non-strict `verify`: [s]B - [k]A is compressed and compared with the R bytes of the signature.
import bignum, sha2

type
  Pt = object
    x, y, z, t: BigInt   ## extended homogeneous coordinates

proc fromHex(s: string): BigInt =
  var buf: seq[byte] = @[]
  var i = 0
  while i < s.len:
    var v = 0
    for k in 0 ..< 2:
      let c = s[i + k]
      var d = 0
      if c >= '0' and c <= '9': d = ord(c) - ord('0')
      else: d = ord(c) - ord('a') + 10
      v = v * 16 + d
    buf.add byte(v)
    i += 2
  bnFromBytesBE(buf)

proc bytesOf(s: string): seq[byte] =
  result = @[]
  for c in s: result.add byte(ord(c))

proc strOf(b: openArray[byte]): string =
  result = ""
  for x in b: result.add char(x)

proc leToBn(s: string): BigInt =
  var r: seq[byte] = @[]
  var i = s.len - 1
  while i >= 0:
    r.add byte(ord(s[i]))
    dec i
  bnFromBytesBE(r)

proc bnToLe32(a: BigInt): string =
  let be = bnToBytesBE(a, 32)
  result = ""
  var i = be.len - 1
  while i >= 0:
    result.add char(be[i])
    dec i

var gP: BigInt
var gL: BigInt
var gD: BigInt
var gD2: BigInt
var gSqrtM1: BigInt
var gBase: Pt
var gReady = false

proc fadd(a, b: BigInt): BigInt = bnAddMod(a, b, gP)
proc fsub(a, b: BigInt): BigInt = bnSubMod(a, b, gP)
proc fmul(a, b: BigInt): BigInt = bnMulMod(a, b, gP)
proc finv(a: BigInt): BigInt = bnModInv(a, gP)

proc recoverX(y: BigInt; sign: bool; x: var BigInt): bool =
  ## RFC 8032 5.1.3 steps 2 to 4. False when there is no such point.
  if bnCmp(y, gP) >= 0: return false
  let one = bnFromU32(1'u32)
  let y2 = fmul(y, y)
  let u = fsub(y2, one)
  let v = fadd(fmul(gD, y2), one)
  let x2 = fmul(u, finv(v))
  if bnIsZero(x2):
    if sign: return false
    x = bnZero()
    return true
  var e = bnAdd(gP, bnFromU32(3'u32))
  e = bnShr1(bnShr1(bnShr1(e)))
  var c = bnModPow(x2, e, gP)
  if bnCmp(fmul(c, c), x2) != 0:
    c = fmul(c, gSqrtM1)
  if bnCmp(fmul(c, c), x2) != 0: return false
  if bnTestBit(c, 0) != sign:
    c = bnSub(gP, c)
  x = c
  true

proc setup() =
  if gReady: return
  gP = fromHex("7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffed")
  gL = fromHex("1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed")
  let one = bnFromU32(1'u32)
  gD = bnMulMod(bnSub(gP, bnFromU32(121665'u32)), bnModInv(bnFromU32(121666'u32), gP), gP)
  gD2 = bnAddMod(gD, gD, gP)
  var q = bnSub(gP, one)
  q = bnShr1(bnShr1(q))
  gSqrtM1 = bnModPow(bnFromU32(2'u32), q, gP)
  let by = bnMulMod(bnFromU32(4'u32), bnModInv(bnFromU32(5'u32), gP), gP)
  var bx = bnZero()
  discard recoverX(by, false, bx)
  gBase = Pt(x: bx, y: by, z: one, t: bnMulMod(bx, by, gP))
  gReady = true

proc identity(): Pt =
  Pt(x: bnZero(), y: bnFromU32(1'u32), z: bnFromU32(1'u32), t: bnZero())

proc padd(p, q: Pt): Pt =
  let a = fmul(fsub(p.y, p.x), fsub(q.y, q.x))
  let b = fmul(fadd(p.y, p.x), fadd(q.y, q.x))
  let c = fmul(fmul(p.t, gD2), q.t)
  let d = fmul(fadd(p.z, p.z), q.z)
  let e = fsub(b, a)
  let f = fsub(d, c)
  let g = fadd(d, c)
  let h = fadd(b, a)
  Pt(x: fmul(e, f), y: fmul(g, h), t: fmul(e, h), z: fmul(f, g))

proc pneg(p: Pt): Pt =
  var nx = p.x
  var nt = p.t
  if not bnIsZero(nx): nx = bnSub(gP, nx)
  if not bnIsZero(nt): nt = bnSub(gP, nt)
  Pt(x: nx, y: p.y, z: p.z, t: nt)

proc pmul(p: Pt; s: BigInt): Pt =
  result = identity()
  var q = p
  let n = bnBitLen(s)
  for i in 0 ..< n:
    if bnTestBit(s, i): result = padd(result, q)
    q = padd(q, q)

proc compress(p: Pt): string =
  let zi = finv(p.z)
  let x = fmul(p.x, zi)
  let y = fmul(p.y, zi)
  result = bnToLe32(y)
  if bnTestBit(x, 0):
    result[31] = char(ord(result[31]) or 0x80)

proc decompress(s: string; p: var Pt): bool =
  if s.len != 32: return false
  var t = s
  let sign = (ord(t[31]) and 0x80) != 0
  t[31] = char(ord(t[31]) and 0x7f)
  let y = leToBn(t)
  var x = bnZero()
  if not recoverX(y, sign, x): return false
  p = Pt(x: x, y: y, z: bnFromU32(1'u32), t: bnMulMod(x, y, gP))
  true

proc sha512Str(s: string): string =
  strOf(sha512(bytesOf(s)))

proc hashModL(s: string): BigInt =
  bnMod(leToBn(sha512Str(s)), gL)

proc clampedScalar(h: string): string =
  result = h[0 ..< 32]
  result[0] = char(ord(result[0]) and 248)
  result[31] = char((ord(result[31]) and 127) or 64)

proc ed25519PublicKey*(seed: string): string =
  ## `SigningKey::from_bytes(seed).verifying_key().to_bytes()`; `seed` is 32 bytes.
  setup()
  compress(pmul(gBase, leToBn(clampedScalar(sha512Str(seed)))))

proc ed25519Sign*(seed, message: string): string =
  ## `SigningKey::sign`: the 64-byte signature.
  setup()
  let h = sha512Str(seed)
  let an = leToBn(clampedScalar(h))
  let pub = compress(pmul(gBase, an))
  let r = hashModL(h[32 ..< 64] & message)
  let rs = compress(pmul(gBase, r))
  let k = hashModL(rs & pub & message)
  let s = bnMod(bnAdd(r, bnMul(k, an)), gL)
  rs & bnToLe32(s)

proc ed25519Verify*(publicKey, message, signature: string): bool =
  ## `VerifyingKey::verify` (RFC 8032 5.1.7, cofactorless as dalek's non-strict verify).
  setup()
  if publicKey.len != 32 or signature.len != 64: return false
  var a = identity()
  if not decompress(publicKey, a): return false
  let rBytes = signature[0 ..< 32]
  let s = leToBn(signature[32 ..< 64])
  if bnCmp(s, gL) >= 0: return false
  let k = hashModL(rBytes & publicKey & message)
  let r = padd(pmul(gBase, s), pneg(pmul(a, k)))
  compress(r) == rBytes
