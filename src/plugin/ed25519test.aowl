## RFC 8032 section 7.1 test vectors for ed25519.aowl, and SHA-512 known answers (FIPS 180-4).
import std/syncio
import ed25519, sha2

var failures = 0

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    inc failures

proc unhex(s: string): string =
  result = ""
  var i = 0
  while i < s.len:
    var v = 0
    for k in 0 ..< 2:
      let c = s[i + k]
      v = v * 16 + (if c >= '0' and c <= '9': ord(c) - ord('0') else: ord(c) - ord('a') + 10)
    result.add char(v)
    i += 2

proc hex(s: string): string =
  result = ""
  const digits = "0123456789abcdef"
  for c in s:
    result.add digits[ord(c) shr 4]
    result.add digits[ord(c) and 15]

proc sha512hex(s: string): string =
  var buf: seq[byte] = @[]
  for c in s: buf.add byte(ord(c))
  let d = sha512(buf)
  var o = ""
  for b in d: o.add char(b)
  hex(o)

proc vector(n: string; secret, pub, msg, sig: string) =
  let seed = unhex(secret)
  let m = unhex(msg)
  ck(hex(ed25519PublicKey(seed)) == pub, n & " public key")
  ck(hex(ed25519Sign(seed, m)) == sig, n & " signature")
  ck(ed25519Verify(unhex(pub), m, unhex(sig)), n & " verifies")
  ck(not ed25519Verify(unhex(pub), m & "x", unhex(sig)), n & " tampered message rejected")
  var bad = unhex(sig)
  bad[40] = char(ord(bad[40]) xor 1)
  ck(not ed25519Verify(unhex(pub), m, bad), n & " tampered signature rejected")
  var badKey = unhex(pub)
  badKey[3] = char(ord(badKey[3]) xor 4)
  ck(not ed25519Verify(badKey, m, unhex(sig)), n & " other key rejected")

proc main() =
  ck(sha512hex("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "sha512 empty")
  ck(sha512hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512 abc")
  vector("rfc8032 test 1", "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
         "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "",
         "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
  vector("rfc8032 test 2", "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
         "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", "72",
         "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
  ck(not ed25519Verify("short", "m", "sig"), "bad lengths rejected")
  if failures > 0: quit(1)
  echo "ed25519 ok"

main()
