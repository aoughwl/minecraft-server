## Binding to the aoughwl engine's embedding API (aoughwl_embed.h, ABI 2) through aoe_engine.dll.
##
## The engine is linked into its own DLL (`aoughwl-engine/build/dll`, made from libaoughwl_embed.a by tools/build_engine_dll.sh) and bound
## at run time with LoadLibrary and GetProcAddress, not at program start: a server without the DLL still starts, it only cannot run
## plugins (`aoeLoad` answers false). The DLL is found the way Windows finds any: next to the executable, in the working directory,
## or on PATH. Every engine call must be made on the thread that called `aoe_init`. Only the part the plugin host uses is declared;
## names and layouts are the header's.

import std/envvars

proc loadLibraryA(name: cstring): nil pointer {.stdcall, importc: "LoadLibraryA", dynlib: "kernel32.dll".}
proc getProcAddress(h: pointer; name: cstring): nil pointer {.stdcall, importc: "GetProcAddress", dynlib: "kernel32.dll".}

const
  AoeOk* = 0'i32
  AoeKindAuto* = 0'i32
  AoeKindJs* = 1'i32
  AoeKindAowlmony* = 2'i32
  AoeModeAuto* = 0'i32
  AoeModeNative* = 1'i32
  AoeModeInterpreted* = 2'i32
  AoeVNil* = 0'i32
  AoeVInt* = 1'i32
  AoeVNumber* = 2'i32
  AoeVBool* = 3'i32
  AoeVString* = 4'i32

type
  AoeValue* = object
    kind*: int32
    i*: int64
    n*: float64
    s*: nil cstring

  AoeLoadOptions* = object
    size*: uint32
    path*: cstring
    kind*: int32
    mode*: int32
    context*: int64
    copyNative*: int32

  AoeHostFn* = proc (context: int64; name: cstring; args: ptr AoeValue; argc: int32; res: ptr AoeValue): int32 {.cdecl.}

var
  gLib: nil pointer = nil
  pInit: nil pointer = nil
  pShutdown: nil pointer = nil
  pSetHost: nil pointer = nil
  pLastError: nil pointer = nil
  pLoad: nil pointer = nil
  pUnload: nil pointer = nil
  pHasEntry: nil pointer = nil
  pCall: nil pointer = nil
  pModeOf: nil pointer = nil
  pModeReason: nil pointer = nil
  pStdout: nil pointer = nil
  pStderr: nil pointer = nil
  pReplace: nil pointer = nil

var
  gWorkerMode: bool = false
  pClientOpen: nil pointer = nil
  pClientSelect: nil pointer = nil
  pClientClose: nil pointer = nil

proc aoeLoaded*(): bool = gLib != nil
proc aoeWorkerMode*(): bool = gWorkerMode or getEnv("AOE_PLUGIN_WORKERS") == "1"

proc aoeLoad*(): bool =
  ## Finds aoe_engine.dll and binds the calls below. False when the DLL is not there or lacks one of them; true from then on.
  if gLib != nil: return true
  # AOE_PLUGIN_WORKERS=1: every plugin runs in a worker process of its own (aoe_client.dll, which starts aoe_worker.exe), so loading or
  # unloading one never touches another. Otherwise the engine runs inside the server (aoe_engine.dll).
  let wantWorkers = getEnv("AOE_PLUGIN_WORKERS") == "1"
  var found: nil pointer = nil
  if wantWorkers:
    found = loadLibraryA("aoe_client.dll")
  else:
    found = loadLibraryA("aoe_engine.dll")
  if found == nil: return false
  if wantWorkers:
    pClientOpen = getProcAddress(found, "aoe_client_open")
    pClientSelect = getProcAddress(found, "aoe_client_select")
    pClientClose = getProcAddress(found, "aoe_client_close")
    if pClientOpen == nil or pClientSelect == nil or pClientClose == nil: return false
    gWorkerMode = true
  pInit = getProcAddress(found, "aoe_init")
  pShutdown = getProcAddress(found, "aoe_shutdown")
  pSetHost = getProcAddress(found, "aoe_set_host_callback")
  pLastError = getProcAddress(found, "aoe_last_error")
  pLoad = getProcAddress(found, "aoe_load")
  pUnload = getProcAddress(found, "aoe_unload")
  pHasEntry = getProcAddress(found, "aoe_has_entry")
  pCall = getProcAddress(found, "aoe_call")
  pModeOf = getProcAddress(found, "aoe_mode_of")
  pModeReason = getProcAddress(found, "aoe_mode_reason")
  pStdout = getProcAddress(found, "aoe_stdout")
  pStderr = getProcAddress(found, "aoe_stderr")
  pReplace = getProcAddress(found, "aoe_replace")
  if pInit == nil or pShutdown == nil or pSetHost == nil or pLastError == nil or pLoad == nil or pUnload == nil or pHasEntry == nil:
    return false
  if pCall == nil or pModeOf == nil or pModeReason == nil or pStdout == nil or pStderr == nil or pReplace == nil:
    return false
  gLib = found
  true

proc aoe_init*(): int32 =
  if pInit == nil: return -1
  type Fn = proc (): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pInit)
  let f = slot[]
  f()

proc aoe_shutdown*(): int32 =
  if pShutdown == nil: return -1
  type Fn = proc (): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pShutdown)
  let f = slot[]
  f()

proc aoe_set_host_callback*(fn: AoeHostFn): int32 =
  if pSetHost == nil: return -1
  type Fn = proc (fn: AoeHostFn): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pSetHost)
  let f = slot[]
  f(fn)

proc aoe_last_error*(): nil cstring =
  if pLastError == nil: return nil
  type Fn = proc (): nil cstring {.cdecl.}
  let slot = cast[ptr Fn](addr pLastError)
  let f = slot[]
  f()

proc aoe_load*(opts: ptr AoeLoadOptions): int32 =
  if pLoad == nil: return -1
  type Fn = proc (opts: ptr AoeLoadOptions): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pLoad)
  let f = slot[]
  f(opts)

proc aoe_unload*(handle: int32): int32 =
  if pUnload == nil: return -1
  type Fn = proc (handle: int32): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pUnload)
  let f = slot[]
  f(handle)

proc aoe_has_entry*(handle: int32; name: cstring): int32 =
  if pHasEntry == nil: return -1
  type Fn = proc (handle: int32; name: cstring): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pHasEntry)
  let f = slot[]
  f(handle, name)

proc aoe_call*(handle: int32; name: cstring): int32 =
  if pCall == nil: return -1
  type Fn = proc (handle: int32; name: cstring): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pCall)
  let f = slot[]
  f(handle, name)

proc aoe_mode_of*(handle: int32): int32 =
  if pModeOf == nil: return -1
  type Fn = proc (handle: int32): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pModeOf)
  let f = slot[]
  f(handle)

proc aoe_mode_reason*(handle: int32): nil cstring =
  if pModeReason == nil: return nil
  type Fn = proc (handle: int32): nil cstring {.cdecl.}
  let slot = cast[ptr Fn](addr pModeReason)
  let f = slot[]
  f(handle)

proc aoe_stdout*(handle: int32): nil cstring =
  if pStdout == nil: return nil
  type Fn = proc (handle: int32): nil cstring {.cdecl.}
  let slot = cast[ptr Fn](addr pStdout)
  let f = slot[]
  f(handle)

proc aoe_stderr*(handle: int32): nil cstring =
  if pStderr == nil: return nil
  type Fn = proc (handle: int32): nil cstring {.cdecl.}
  let slot = cast[ptr Fn](addr pStderr)
  let f = slot[]
  f(handle)

proc aoe_replace*(handle: int32): int32 =
  if pReplace == nil: return -1
  type Fn = proc (handle: int32): int32 {.cdecl.}
  let slot = cast[ptr Fn](addr pReplace)
  let f = slot[]
  f(handle)

proc aoe_client_open*(workerExe: cstring; err: nil cstring; errCap: int32): nil pointer =
  if pClientOpen == nil: return nil
  type Fn = proc (workerExe: cstring; err: nil cstring; errCap: int32): nil pointer {.cdecl.}
  let slot = cast[ptr Fn](addr pClientOpen)
  let f = slot[]
  f(workerExe, err, errCap)

proc aoe_client_select*(c: nil pointer): nil pointer =
  if pClientSelect == nil: return nil
  type Fn = proc (c: nil pointer): nil pointer {.cdecl.}
  let slot = cast[ptr Fn](addr pClientSelect)
  let f = slot[]
  f(c)

proc aoe_client_close*(c: nil pointer) =
  if pClientClose == nil: return
  type Fn = proc (c: nil pointer) {.cdecl.}
  let slot = cast[ptr Fn](addr pClientClose)
  let f = slot[]
  f(c)
