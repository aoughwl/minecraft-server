## Binding to the aoughwl engine's embedding API (aoughwl_embed.h, ABI 2) through aoe_engine.dll.
##
## The engine is linked into its own DLL (`aoughwl-engine/build/dll`, made from libaoughwl_embed.a) and loaded at run
## time, so it never shares a runtime with this program. aoe_engine.dll must be on the DLL search path (next to the
## executable, or on PATH). Every call must be made on the thread that called `aoe_init`.
## Only the part the plugin host uses is declared; names and layouts are the header's.

const AoeDll = "aoe_engine.dll"

const
  AoeOk* = 0'i32
  AoeKindAuto* = 0'i32
  AoeKindJs* = 1'i32
  AoeKindAowlmony* = 2'i32
  AoeModeAuto* = 0'i32
  AoeModeNative* = 1'i32
  AoeModeInterpreted* = 2'i32
  AoeVNil* = 0'i32
  AoeVInt* = 1'i32
  AoeVNumber* = 2'i32
  AoeVBool* = 3'i32
  AoeVString* = 4'i32

type
  AoeValue* = object
    kind*: int32
    i*: int64
    n*: float64
    s*: nil cstring

  AoeLoadOptions* = object
    size*: uint32
    path*: cstring
    kind*: int32
    mode*: int32
    context*: int64
    copyNative*: int32

  AoeHostFn* = proc (context: int64; name: cstring; args: ptr AoeValue; argc: int32; res: ptr AoeValue): int32 {.cdecl.}

proc aoe_abi_version*(): uint32 {.cdecl, importc: "aoe_abi_version", dynlib: AoeDll.}
proc aoe_init*(): int32 {.cdecl, importc: "aoe_init", dynlib: AoeDll.}
proc aoe_shutdown*(): int32 {.cdecl, importc: "aoe_shutdown", dynlib: AoeDll.}
proc aoe_set_host_callback*(fn: AoeHostFn): int32 {.cdecl, importc: "aoe_set_host_callback", dynlib: AoeDll.}
proc aoe_last_error*(): nil cstring {.cdecl, importc: "aoe_last_error", dynlib: AoeDll.}
proc aoe_load*(opts: ptr AoeLoadOptions): int32 {.cdecl, importc: "aoe_load", dynlib: AoeDll.}
proc aoe_unload*(handle: int32): int32 {.cdecl, importc: "aoe_unload", dynlib: AoeDll.}
proc aoe_has_entry*(handle: int32; name: cstring): int32 {.cdecl, importc: "aoe_has_entry", dynlib: AoeDll.}
proc aoe_call*(handle: int32; name: cstring): int32 {.cdecl, importc: "aoe_call", dynlib: AoeDll.}
proc aoe_mode_of*(handle: int32): int32 {.cdecl, importc: "aoe_mode_of", dynlib: AoeDll.}
proc aoe_mode_reason*(handle: int32): nil cstring {.cdecl, importc: "aoe_mode_reason", dynlib: AoeDll.}
proc aoe_stdout*(handle: int32): nil cstring {.cdecl, importc: "aoe_stdout", dynlib: AoeDll.}
proc aoe_stderr*(handle: int32): nil cstring {.cdecl, importc: "aoe_stderr", dynlib: AoeDll.}
proc aoe_replace*(handle: int32): int32 {.cdecl, importc: "aoe_replace", dynlib: AoeDll.}
