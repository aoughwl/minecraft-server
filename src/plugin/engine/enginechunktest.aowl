## Test for the chunk-send entry of engineplugins.aowl through the real `sendChunks` (entity/player.aowl), with a client that has no
## socket: a plugin's `on_chunk_send` sees each chunk's coordinates and cancels one, and the client's outgoing packets show it was
## left out. Needs aoe_engine.dll on PATH. Run in a scratch directory: it creates `plugins/`.

import std/[assertions, options, syncio, strutils, dirs, paths]
import ../../protocol/java/packet_decoder
import ../../world/playerdata
import ../../server/key_store
import ../../server/recipe
import ../../server/scheduler
import ../../server/tick_rate_manager
import ../../server/data/datamod
import ../../world/chunkdata
import ../../server/serverbase
import ../../server/entity/player
import ../../server/net/winsock
import ../../server/net/java/[javamod, handshake]
import ../../protocol/java/server/handshake/handshakemod
import ../../generated/packet
import enginehost
import engineplugins

proc newServer(): Server =
  var advanced = defaultAdvancedConfiguration()
  advanced.networking.java.onlineMode = false
  advanced.networking.java.encryption = false
  advanced.networking.java.compression.enabled = false
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: advanced, worlds: @[], dimensions: @[],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc hasLog(want: string): bool =
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: return true
  false

proc run(): int =
  let nl = "\n"
  try:
    createDir(path("plugins"))
    writeFile("plugins/chunkwatch.js",
      "function on_chunk_send() {" & nl &
      "  var x = hostv(\"event_num\", \"x\");" & nl &
      "  hostS(\"server_log\", \"chunk \" + x);" & nl &
      "  if (x == 1) host(\"event_cancel\");" & nl &
      "}" & nl)
  except:
    quit "could not write the test plugin"
  let server = newServer()
  startEnginePlugins(server)

  let c = newJavaClient(InvalidSocket, 1'u64)
  c.handleHandshake(SHandShake(protocolVersion: newVarInt(774'i32), serverAddress: "localhost", serverPort: 25565'u16,
    nextState: csLogin))
  c.connectionState = csPlay
  var chunks: seq[ChunkData] = @[]
  for x in 0'i32 ..< 3'i32:
    chunks.add newChunkData(x, 0'i32, newChunkSections(1, 0'i32))
  sendChunks(c, chunks)

  assert hasLog("chunk 0"), "the entry saw chunk 0"
  assert hasLog("chunk 1"), "the entry saw chunk 1"
  assert hasLog("chunk 2"), "the entry saw chunk 2"

  # BatchStart, two chunks (the one at x = 1 was cancelled), BatchEnd
  var decoder = newTCPNetworkDecoder()
  decoder.feed(c.networkWriter.flush())
  var packets = 0
  while decoder.packetReady():
    let res = decoder.getRawPacket()
    assert res.isOk
    inc packets
  assert packets == 4, "start + 2 chunks + end, got " & $packets
  echo "enginechunktest ok"
  0

quit(run())
