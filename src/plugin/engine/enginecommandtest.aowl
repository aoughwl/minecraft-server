## Test for register_command in engineplugins.aowl: a plugin registers /hello and /fail in its start entry, the real fallback
## dispatcher runs them with a console sender, and the plugin sees the command name and its text argument, answers with
## command_reply, and makes /fail fail. Needs aoe_engine.dll on PATH. Run in a scratch directory: it creates `plugins/`.

import std/[assertions, options, syncio, strutils, dirs, paths]
import ../../world/playerdata
import ../../server/key_store
import ../../server/recipe
import ../../server/scheduler
import ../../server/tick_rate_manager
import ../../server/data/datamod
import ../../server/serverbase
import ../../command/[cmdsource, cmddispatch, fallbackdispatch]
import enginehost
import engineplugins

proc newServer(): Server =
  var advanced = defaultAdvancedConfiguration()
  advanced.networking.java.onlineMode = false
  advanced.networking.java.encryption = false
  advanced.networking.java.compression.enabled = false
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: advanced, worlds: @[], dimensions: @[],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc hasLog(want: string): bool =
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: return true
  false

proc run(): int =
  let nl = "\n"
  try:
    createDir(path("plugins"))
    writeFile("plugins/cmds.js",
      "function start() {" & nl &
      "  hostS(\"server_log\", \"registered hello: \" + hostv(\"register_command\", \"hello\", \"Says hello\", 0));" & nl &
      "  hostv(\"register_command\", \"fail\", \"Always fails\", 0);" & nl &
      "}" & nl &
      "function on_command() {" & nl &
      "  var c = hostv(\"event_str\", \"command\");" & nl &
      "  var a = hostv(\"event_str\", \"args\");" & nl &
      "  hostS(\"server_log\", \"cmd \" + c + \" args=\" + a);" & nl &
      "  if (c == \"hello\") hostv(\"command_reply\", \"Hello, \" + (a == \"\" ? \"world\" : a) + \"!\");" & nl &
      "  if (c == \"fail\") hostv(\"command_fail\", \"nope\");" & nl &
      "}" & nl)
  except:
    quit "could not write the test plugin"
  let server = newServer()
  let dispatcher = newCommandDispatcher()
  server.commandDispatcher = dispatcher
  startEnginePlugins(server)
  assert hasLog("registered hello: true"), "register_command answered true"

  let d = dispatcher.fallbackDispatcher
  let sender = CommandSender(kind: cskConsole)
  let withArg = dispatch(d, sender, nil, "hello Alice and Bob")
  assert withArg.isOk, "/hello with text runs"
  assert hasLog("cmd hello args=Alice and Bob"), "the plugin saw the whole text argument"
  let bare = dispatch(d, sender, nil, "hello")
  assert bare.isOk, "/hello with no text runs"
  assert hasLog("cmd hello args="), "the plugin saw an empty argument"
  let failed = dispatch(d, sender, nil, "fail")
  assert not failed.isOk, "/fail fails because the plugin called command_fail"
  echo "enginecommandtest ok"
  0

quit(run())
