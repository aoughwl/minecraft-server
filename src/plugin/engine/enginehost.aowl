## The server's plugin host on the aoughwl engine: plugins are programs (JavaScript or aowlmony) the engine runs, and they
## reach the server through named host functions, as Jester's mods reach Jester (`host("name", ...)`, `hostS("name", s)`).
##
## This replaces the WebAssembly component host (src/plugin/wasm, src/plugin/wit) as the plugin mechanism. The event
## wiring (pluginhooks.aowl, pluginwireevents.aowl) keeps its call sites and will fire into `callPlugin`.
##
## Everything runs on the thread that called `engineInit`. Host functions are plain procedures looked up by name; none is a
## closure, so nothing crosses the C boundary but the engine's own `aoe_value` rows.

import std/[strutils, envvars]
import aoe

type
  HostArg* = object
    kind*: int32          ## AoeVNil, AoeVInt, AoeVNumber, AoeVBool, AoeVString
    i*: int64
    n*: float64
    s*: string

  HostFn* = proc (context: int64; args: seq[HostArg]; res: var HostArg): int32 {.nimcall.}
    ## > 0 handled (fill `res` when the routine has a result), 0 not mine, < 0 failed.

  HostEntry = object
    name: string
    fn: HostFn

var
  hostTable: seq[HostEntry] = @[]
  resultText: string = ""          ## keeps a string result alive until the engine has copied it
  engineUp = false

proc textOf(p: nil cstring): string =
  ## A C string the engine may have left null, as a string (empty when null).
  if p == nil: "" else: $p

proc argOf(v: AoeValue): HostArg =
  result = HostArg(kind: v.kind, i: v.i, n: v.n, s: "")
  if v.kind == AoeVString: result.s = textOf(v.s)

var
  gSlots: seq[string] = @["", "", "", "", "", ""]   ## text an interpreted aowlmony plugin has sent, as packed integers (see below)
  gCallResult = ""                                  ## the text answer of the last "call", read with "call_result"

proc resultAsText(r: HostArg): string =
  case r.kind
  of AoeVString: r.s
  of AoeVInt: $r.i
  of AoeVBool: (if r.i != 0: "true" else: "false")
  of AoeVNumber: $r.n
  else: ""

proc findHost(key: string): nil HostFn =
  result = nil
  for e in hostTable:
    if e.name == key:
      result = e.fn
      break

proc hostCallback(context: int64; name: cstring; args: ptr AoeValue; argc: int32; res: ptr AoeValue): int32 {.cdecl.} =
  ## The one callback the engine has. An aowlmony program that is interpreted cannot hand the host a runtime string (a `toCString`
  ## view of a variable arrives empty), so it talks in integers and reads text back: "txt_clear"(slot) empties a text slot,
  ## "txt_put"(slot, w0, w1, w2) appends the bytes packed seven to an integer (low byte first, a zero byte ends the text),
  ## "call"(n) runs the host function named by slot 0 with slots 1 ..< n as its string arguments and keeps its answer as text, and
  ## "call_result" answers that text. Every other name is a host function called directly (what JavaScript uses).
  let key = $name
  let rows = cast[ptr UncheckedArray[AoeValue]](args)
  if key == "txt_clear" or key == "txt_put" or key == "call" or key == "call_result" or key == "calls":
    if res != nil:
      res.kind = AoeVInt
      res.i = 1
      res.n = 0.0
      res.s = nil
    if key == "call_result":
      if res != nil:
        res.kind = AoeVString
        resultText = gCallResult
        res.s = toCString(resultText)
      return 1
    if argc < 1: return -1
    if key == "calls":
      # One runtime string: the host function's name and its arguments, joined by the unit separator (what a plugin built for an engine
      # that passes runtime strings sends).
      let joined = argOf(rows[0]).s
      var parts: seq[string] = @[]
      var cur = ""
      for ch in joined:
        if ch == '\x1f':
          parts.add cur
          cur = ""
        else:
          cur.add ch
      parts.add cur
      let fn1: nil HostFn = findHost(parts[0])
      if fn1 == nil:
        gCallResult = ""
        if res != nil: res.i = 0
        return 1
      var callArgs1: seq[HostArg] = @[]
      for k in 1 ..< parts.len:
        callArgs1.add HostArg(kind: AoeVString, i: 0, n: 0.0, s: parts[k])
      var answer1 = HostArg(kind: AoeVNil, i: 0, n: 0.0, s: "")
      let status1 = fn1(context, callArgs1, answer1)
      gCallResult = resultAsText(answer1)
      if res != nil: res.i = int64(status1)
      return 1
    if key == "txt_clear":
      let slot = int(rows[0].i)
      if slot >= 0 and slot < gSlots.len: gSlots[slot] = ""
      return 1
    if key == "txt_put":
      let slot = int(rows[0].i)
      if slot < 0 or slot >= gSlots.len or argc < 4: return -1
      var done = false
      for w in 1 .. 3:
        if done: break
        let word = rows[w].i
        for b in 0 ..< 7:
          let byte = int((word shr (8 * b)) and 255)
          if byte == 0:
            done = true
            break
          gSlots[slot].add char(byte)
      return 1
    # "call"
    let n = int(rows[0].i)
    var fn0: nil HostFn = findHost(gSlots[0])
    if fn0 == nil:
      gCallResult = ""
      if res != nil: res.i = 0
      return 1
    var callArgs: seq[HostArg] = @[]
    for k in 1 ..< min(n, gSlots.len):
      callArgs.add HostArg(kind: AoeVString, i: 0, n: 0.0, s: gSlots[k])
    var answer = HostArg(kind: AoeVNil, i: 0, n: 0.0, s: "")
    let status = fn0(context, callArgs, answer)
    gCallResult = resultAsText(answer)
    if res != nil: res.i = int64(status)
    return 1
  var fn: nil HostFn = findHost(key)
  if fn == nil: return 0
  var a: seq[HostArg] = @[]
  for k in 0 ..< int(argc):
    a.add argOf(rows[k])
  var r = HostArg(kind: AoeVNil, i: 0, n: 0.0, s: "")
  let code = fn(context, a, r)
  if code > 0 and res != nil:
    res.kind = r.kind
    res.i = r.i
    res.n = r.n
    if r.kind == AoeVString:
      resultText = r.s
      res.s = toCString(resultText)
    else:
      res.s = nil
  code

proc registerHost*(name: string; fn: HostFn) =
  ## Adds (or replaces) the host function a plugin reaches by `name`.
  for k in 0 ..< hostTable.len:
    if hostTable[k].name == name:
      hostTable[k].fn = fn
      return
  hostTable.add HostEntry(name: name, fn: fn)

var
  gClients: seq[nil pointer] = @[]    ## worker mode: the worker of each program, by program id (nil once the program is unloaded)
  gHandles: seq[int32] = @[]          ## and the program's handle inside that worker
  gWorkerError: string = ""           ## the engine's last error, taken from the worker that raised it

proc engineError*(): string =
  if not aoeLoaded(): return "aoe_engine.dll could not be loaded (put it next to the server executable or on PATH; tools/build_engine_dll.sh builds it)"
  if aoeWorkerMode(): return gWorkerError
  textOf(aoe_last_error())

proc engineInit*(): bool =
  ## Starts the engine on this thread and installs the host callback. False with `engineError` on failure.
  if engineUp: return true
  if not aoeLoad(): return false
  if aoeWorkerMode():
    # each program starts its own worker (and initialises and gets the host callback) when it is loaded
    engineUp = true
    return true
  if aoe_init() != AoeOk: return false
  if aoe_set_host_callback(hostCallback) != AoeOk: return false
  engineUp = true
  true

proc engineShutdown*() =
  if engineUp:
    if aoeWorkerMode():
      for k in 0 ..< gClients.len:
        if gClients[k] != nil:
          aoe_client_close(gClients[k])
          gClients[k] = nil
    else:
      discard aoe_shutdown()
    engineUp = false

proc loadPlugin*(path: string; context: int64 = 0): int32 =
  ## Loads a program (`.js` or a typed `.s.nif`, by suffix); AUTO mode (native when a native build exists). The handle, or -1.
  let kind = if path.endsWith(".js"): AoeKindJs else: AoeKindAuto
  var pathC = path
  var opts = AoeLoadOptions(size: uint32(sizeof(AoeLoadOptions)), path: toCString(pathC), kind: kind, mode: AoeModeAuto,
                            context: context, copyNative: 1'i32)
  if not aoeWorkerMode():
    return aoe_load(addr opts)
  # worker mode: a worker process of its own for this program; the id handed back stands for (worker, handle)
  var exe = getEnv("AOE_WORKER_EXE")
  if exe.len == 0: exe = "aoe_worker.exe"
  let c = aoe_client_open(toCString(exe), nil, 0'i32)
  if c == nil:
    gWorkerError = "could not start " & exe & " (put it next to the server executable or on PATH, or set AOE_WORKER_EXE)"
    return -1
  let prev = aoe_client_select(c)
  var h = -1'i32
  if aoe_init() != AoeOk:
    gWorkerError = textOf(aoe_last_error())
  elif aoe_set_host_callback(hostCallback) != AoeOk:
    gWorkerError = textOf(aoe_last_error())
  else:
    h = aoe_load(addr opts)
    if h < 0: gWorkerError = textOf(aoe_last_error())
  discard aoe_client_select(prev)
  if h < 0:
    aoe_client_close(c)
    return -1
  gClients.add c
  gHandles.add h
  int32(gClients.len - 1)

proc hasEntry*(h: int32; name: string): bool =
  var n = name
  if not aoeWorkerMode():
    return aoe_has_entry(h, toCString(n)) == 1'i32
  if h < 0 or int(h) >= gClients.len or gClients[int(h)] == nil: return false
  let prev = aoe_client_select(gClients[int(h)])
  let r = aoe_has_entry(gHandles[int(h)], toCString(n))
  discard aoe_client_select(prev)
  r == 1'i32

proc callPlugin*(h: int32; name: string): int32 =
  var n = name
  if not aoeWorkerMode():
    return aoe_call(h, toCString(n))
  if h < 0 or int(h) >= gClients.len or gClients[int(h)] == nil: return -1
  # the worker may call the host, and the host may call another worker: put the selection back afterwards
  let prev = aoe_client_select(gClients[int(h)])
  let r = aoe_call(gHandles[int(h)], toCString(n))
  if r < 0: gWorkerError = textOf(aoe_last_error())
  discard aoe_client_select(prev)
  r

proc unloadPlugin*(h: int32): int32 =
  if not aoeWorkerMode():
    return aoe_unload(h)
  if h < 0 or int(h) >= gClients.len or gClients[int(h)] == nil: return -1
  let c = gClients[int(h)]
  let prev = aoe_client_select(c)
  result = aoe_unload(gHandles[int(h)])     # runs the program's `stop` entry
  discard aoe_client_select(prev)
  gClients[int(h)] = nil
  aoe_client_close(c)                       # and the worker process ends

proc pluginMode*(h: int32): string =
  if not aoeWorkerMode():
    case aoe_mode_of(h)
    of AoeModeNative: return "native"
    of AoeModeInterpreted: return "interpreted: " & textOf(aoe_mode_reason(h))
    else: return "unknown"
  if h < 0 or int(h) >= gClients.len or gClients[int(h)] == nil: return "unknown"
  let prev = aoe_client_select(gClients[int(h)])
  let m = aoe_mode_of(gHandles[int(h)])
  var text = "unknown"
  if m == AoeModeNative: text = "native"
  elif m == AoeModeInterpreted: text = "interpreted: " & textOf(aoe_mode_reason(gHandles[int(h)]))
  discard aoe_client_select(prev)
  "worker, " & text

proc pluginStdout*(h: int32): string =
  if not aoeWorkerMode():
    return textOf(aoe_stdout(h))
  if h < 0 or int(h) >= gClients.len or gClients[int(h)] == nil: return ""
  let prev = aoe_client_select(gClients[int(h)])
  result = textOf(aoe_stdout(gHandles[int(h)]))
  discard aoe_client_select(prev)
