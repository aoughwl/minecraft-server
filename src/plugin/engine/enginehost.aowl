## The server's plugin host on the aoughwl engine: plugins are programs (JavaScript or aowlmony) the engine runs, and they
## reach the server through named host functions, as Jester's mods reach Jester (`host("name", ...)`, `hostS("name", s)`).
##
## This replaces the WebAssembly component host (src/plugin/wasm, src/plugin/wit) as the plugin mechanism. The event
## wiring (pluginhooks.aowl, pluginwireevents.aowl) keeps its call sites and will fire into `callPlugin`.
##
## Everything runs on the thread that called `engineInit`. Host functions are plain procedures looked up by name; none is a
## closure, so nothing crosses the C boundary but the engine's own `aoe_value` rows.

import std/[strutils]
import aoe

type
  HostArg* = object
    kind*: int32          ## AoeVNil, AoeVInt, AoeVNumber, AoeVBool, AoeVString
    i*: int64
    n*: float64
    s*: string

  HostFn* = proc (context: int64; args: seq[HostArg]; res: var HostArg): int32 {.nimcall.}
    ## > 0 handled (fill `res` when the routine has a result), 0 not mine, < 0 failed.

  HostEntry = object
    name: string
    fn: HostFn

var
  hostTable: seq[HostEntry] = @[]
  resultText: string = ""          ## keeps a string result alive until the engine has copied it
  engineUp = false

proc textOf(p: nil cstring): string =
  ## A C string the engine may have left null, as a string (empty when null).
  if p == nil: "" else: $p

proc argOf(v: AoeValue): HostArg =
  result = HostArg(kind: v.kind, i: v.i, n: v.n, s: "")
  if v.kind == AoeVString: result.s = textOf(v.s)

proc hostCallback(context: int64; name: cstring; args: ptr AoeValue; argc: int32; res: ptr AoeValue): int32 {.cdecl.} =
  let key = $name
  var fn: nil HostFn = nil
  for e in hostTable:
    if e.name == key:
      fn = e.fn
      break
  if fn == nil: return 0
  var a: seq[HostArg] = @[]
  let rows = cast[ptr UncheckedArray[AoeValue]](args)
  for k in 0 ..< int(argc):
    a.add argOf(rows[k])
  var r = HostArg(kind: AoeVNil, i: 0, n: 0.0, s: "")
  let code = fn(context, a, r)
  if code > 0 and res != nil:
    res.kind = r.kind
    res.i = r.i
    res.n = r.n
    if r.kind == AoeVString:
      resultText = r.s
      res.s = toCString(resultText)
    else:
      res.s = nil
  code

proc registerHost*(name: string; fn: HostFn) =
  ## Adds (or replaces) the host function a plugin reaches by `name`.
  for k in 0 ..< hostTable.len:
    if hostTable[k].name == name:
      hostTable[k].fn = fn
      return
  hostTable.add HostEntry(name: name, fn: fn)

proc engineError*(): string =
  textOf(aoe_last_error())

proc engineInit*(): bool =
  ## Starts the engine on this thread and installs the host callback. False with `engineError` on failure.
  if engineUp: return true
  if aoe_init() != AoeOk: return false
  if aoe_set_host_callback(hostCallback) != AoeOk: return false
  engineUp = true
  true

proc engineShutdown*() =
  if engineUp:
    discard aoe_shutdown()
    engineUp = false

proc loadPlugin*(path: string; context: int64 = 0): int32 =
  ## Loads a program (`.js` or a typed `.s.nif`, by suffix); AUTO mode (native when a native build exists). The handle, or -1.
  let kind = if path.endsWith(".js"): AoeKindJs else: AoeKindAuto
  var pathC = path
  var opts = AoeLoadOptions(size: uint32(sizeof(AoeLoadOptions)), path: toCString(pathC), kind: kind, mode: AoeModeAuto,
                            context: context, copyNative: 1'i32)
  aoe_load(addr opts)

proc hasEntry*(h: int32; name: string): bool =
  var n = name
  aoe_has_entry(h, toCString(n)) == 1'i32
proc callPlugin*(h: int32; name: string): int32 =
  var n = name
  aoe_call(h, toCString(n))
proc unloadPlugin*(h: int32): int32 = aoe_unload(h)
proc pluginMode*(h: int32): string =
  case aoe_mode_of(h)
  of AoeModeNative: "native"
  of AoeModeInterpreted: "interpreted: " & textOf(aoe_mode_reason(h))
  else: "unknown"
proc pluginStdout*(h: int32): string =
  textOf(aoe_stdout(h))
