## Test for enginehost.aowl: loads a real JavaScript plugin through aoe_engine.dll, lets it call two host functions
## (a log that records, and an add that answers), then unloads it. Needs aoe_engine.dll on PATH.

import std/[assertions, syncio, strutils]
import enginehost

var logged: seq[string] = @[]

proc hostLog(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  if args.len >= 1: logged.add args[0].s
  1

proc hostAdd(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  if args.len < 2: return -1
  res.kind = 1'i32
  res.i = args[0].i + args[1].i
  1

proc run(): int =
  let nl = "\n"
  let src = "function start() { hostS(\"server_log\", \"hello from js\"); }" & nl &
    "function sum() { hostS(\"server_log\", \"sum=\" + host(\"server_add\", 2, 3)); }" & nl &
    "function stop() { hostS(\"server_log\", \"bye\"); }" & nl
  try:
    writeFile("hello.plugin.js", src)
  except:
    quit "could not write the test plugin"
  assert engineInit(), engineError()
  registerHost("server_log", hostLog)
  registerHost("server_add", hostAdd)
  let h = loadPlugin("hello.plugin.js", 42)
  assert h >= 0, engineError()
  echo "mode: ", pluginMode(h)
  assert hasEntry(h, "start")
  assert callPlugin(h, "start") == 0, engineError()
  assert callPlugin(h, "sum") == 0, engineError()
  assert logged.len == 2, $logged.len
  assert logged[0] == "hello from js", logged[0]
  assert logged[1] == "sum=5", logged[1]
  assert unloadPlugin(h) == 0, engineError()
  assert logged.len == 3 and logged[2] == "bye", "stop entry runs on unload"
  engineShutdown()
  echo "enginehosttest ok"
  0

quit(run())
