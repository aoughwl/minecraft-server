## Test for the plugin job host calls (enginejobs.aowl through engineplugins.aowl) with a real JavaScript plugin on aoe_engine.dll: the plugin
## submits jobs with the SDK's `job()`, sees nothing before the tick's delivery, gets the answers as `on_job` in submission order, reads
## `job_status`, `job_abi_version`. Needs aoe_engine.dll on PATH.
## Run in a scratch directory: it creates `enginejobhosttest_plugins/`.

import std/[assertions, syncio, strutils, dirs, paths]
import engineplugins
import enginejobs

proc put(file, content: string) =
  try:
    writeFile(file, content)
  except:
    quit "could not write " & file

proc hasLog(want: string): bool =
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: return true
  false

proc run(): int =
  let nl = "\n"
  let folder = "enginejobhosttest_plugins"
  try:
    createDir(path(folder))
  except:
    quit "could not create the test folder"
  put(folder & "/jobber.js",
    "function start() {" & nl &
    "  hostS(\"server_log\", \"abi \" + jobAbiVersion());" & nl &
    "  var a = job(\"fnv1a\", \"hello\", function (r) { hostS(\"server_log\", \"fnv \" + r.value + \" \" + r.text + \" \" + r.failed); });" & nl &
    "  var b = job(\"sort\", \"9 2 5\", function (r) { hostS(\"server_log\", \"sorted \" + r.text); });" & nl &
    "  var c = job(\"primes\", \"1000\", function (r) { hostS(\"server_log\", \"primes \" + r.value); });" & nl &
    "  hostS(\"server_log\", \"bad \" + job(\"nosuch\", \"\", function (r) {}));" & nl &
    "  hostS(\"server_log\", \"early \" + jobStatus(a));" & nl &
    "}" & nl)
  let found = scanEnginePlugins(folder)
  assert found.len == 1, $found.len
  assert loadEnginePlugins(found, folder & "/.engine-bundle.js") == 1
  assert hasLog("abi 1"), "job_abi_version answers 1"
  assert hasLog("bad -1"), "an unknown kind answers -1"
  assert hasLog("early 0"), "a job is pending before the tick's delivery"
  assert not hasLog("sorted 2 5 9"), "nothing is delivered before the poll"
  tickEngineJobs()
  assert hasLog("fnv 1335831723 1335831723 false"), "fnv1a(hello) delivered"
  assert hasLog("sorted 2 5 9"), "sort delivered"
  assert hasLog("primes 168"), "primes delivered"
  let logs = pluginLogLines()
  var at: seq[int] = @[]
  for k in 0 ..< logs.len:
    if logs[k].startsWith("fnv ") or logs[k].startsWith("sorted ") or logs[k].startsWith("primes "): at.add k
  assert at.len == 3 and at[0] < at[1] and at[1] < at[2], "answers arrive in submission order"
  shutdownJobs()
  echo "enginejobhosttest ok"
  0

quit(run())
