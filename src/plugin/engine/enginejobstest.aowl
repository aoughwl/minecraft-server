## Test for enginejobs.aowl (plugin jobs on sim/plugjob), without the engine: kernels, in-order delivery after the poll only, status,
## unknown kind and oversized input, two plugins, drop on unload, shutdown. Runs at threads = 1 (inline) and threads = 4 (workers).

import std/syncio
import ../../server/sim/threadcfg
import enginejobs

var failures = 0
proc check(ok: bool, name: string) =
  if ok:
    echo "PASS " & name
  else:
    echo "FAIL " & name
    inc failures

proc settle(want: int): seq[ReadyJob] =
  ## Polls (tick thread) until `want` results arrived or the tries are used up.
  result = @[]
  var tries = 0
  while result.len < want and tries < 20000:
    let got = tickJobs()
    for r in got: result.add r
    inc tries

proc suite(label: string; threads: int) =
  var plan = planThreads(threads, 0, threads, -1, -1)
  enableJobs(plan)
  check(jobsWorkers() == threads - 1, label & " workers")

  let h = submitJob("alpha", "fnv1a", "hello")
  check(h > 0, label & " submit answers an id")
  check(jobStatus(h) == JobPending, label & " nothing is done before the poll")
  check(submitJob("alpha", "nosuch", "") == -1, label & " unknown kind")
  var big = ""
  for i in 0 ..< MaxJobInput + 1: big.add 'x'
  check(submitJob("alpha", "fnv1a", big) == -2, label & " oversized input")
  let first = settle(1)
  check(first.len == 1 and first[0].id == h and first[0].value == 1335831723 and first[0].text == "1335831723" and first[0].owner == "alpha",
    label & " fnv1a(hello)")
  check(jobStatus(h) == JobUnknown, label & " delivered jobs are forgotten")

  let p = submitJob("alpha", "primes", "100000")
  let s = submitJob("alpha", "sort", "5 -3 10 0 7 -3")
  let r2 = settle(2)
  check(r2.len == 2 and r2[0].id == p and r2[0].value == 9592, label & " primes below 100000")
  check(r2.len == 2 and r2[1].id == s and r2[1].text == "-3 -3 0 5 7 10" and r2[1].value == 6, label & " sort")

  # 40 jobs of two plugins: per plugin in submission order, none lost
  var idsA: seq[int] = @[]
  var idsB: seq[int] = @[]
  for i in 0 ..< 20:
    idsA.add submitJob("alpha", "primes", $(20000 + i * 3000))
    idsB.add submitJob("beta", "fnv1a", "job" & $i)
  let all = settle(40)
  var gotA: seq[int] = @[]
  var gotB: seq[int] = @[]
  for r in all:
    if r.owner == "alpha": gotA.add r.id else: gotB.add r.id
  check(all.len == 40, label & " all 40 delivered")
  check(gotA == idsA and gotB == idsB, label & " per-plugin submission order")

  # unload: running jobs are waited for and their answers dropped
  let d1 = submitJob("gamma", "primes", "3000000")
  let d2 = submitJob("gamma", "fnv1a", "x")
  check(d1 > 0 and d2 > 0, label & " gamma submitted")
  dropJobOwner("gamma")
  check(pendingJobs("gamma") == 0, label & " nothing of an unloaded plugin is pending")
  check(settle(1).len == 0, label & " an unloaded plugin gets nothing")
  check(jobStatus(d1) == JobUnknown, label & " its status is gone")
  # a reloaded plugin of the same name starts clean
  let d3 = submitJob("gamma", "fnv1a", "y")
  let g3 = settle(1)
  check(g3.len == 1 and g3[0].id == d3, label & " a reloaded plugin gets its own jobs")

  # stop with jobs still queued
  discard submitJob("alpha", "primes", "2000000")
  shutdownJobs()
  check(jobsWorkers() == 0, label & " shutdown")

suite("t1", 1)
suite("t4", 4)
echo "failures: " & $failures
if failures > 0:
  quit(1)
