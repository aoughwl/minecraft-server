## The server's plugins on the aoughwl engine: `plugins/<name>/main.js` (or `plugins/<name>.js`) are JavaScript programs the engine
## runs. Each is loaded once at start (its `start` entry runs when it has one) and is offered the server's events by name:
## the entry `on_player_chat`, `on_player_command`, `on_player_join` or `on_player_leave` is called when the event fires, and
## the plugin reads and answers the event through host functions: `hostv("event_str", "message")` (also "player" and "event")
## returns a string, `host("event_cancel")`, `hostS("event_set_message", text)`, `hostS("player_message", text)`,
## `hostS("server_log", text)`. Only `hostv` returns strings to JavaScript: `host` and `hostS` answer a number.
## The engine runs one JavaScript program per process, so every plugin is bundled into one program (see `bundleOf`).
## This is the plugin mechanism that replaces the WebAssembly component host; both run side by side until that host is removed.
##
## Plugins are classic scripts for now (no `import`/`export`): a module-style program needs the staged `.interp/` copy the
## engine's node tool writes. Nothing here touches the engine until a plugin exists, so a server with no JS plugins never loads
## aoe_engine.dll.

import std/[syncio, strutils, dirs, paths, options]
import aoe, enginehost, jssdk
import ../../server/serverbase
import ../../server/entity/player
import ../../server/entity/entitymod
import ../../server/entity/playerextras
import ../../inventory/[inventory, player_inventory, screenhandler]
import "../../data/item_stack/mod" as itemstackmod
import ../pluginhooks
import ../../util/text/text
import ../../util/vector3
import ../../util/gamemode
import ../../util/math/position
import ../pluginhooksevents
import ../api/events/player/[fish, egg_throw, custom_click_action]
import ../../data/blocks
import ../../command/cmdsource
import ../../command/fallbackdispatch
import ../../command/client_suggestions
import ../../command/args
import ../../util/permission
import ../../server/world/worldmod
import "../../server/block/blockstateid"
import ../../world/world as worldtraits
import ../../data/block_ext
import ../../world/chunkdata
import ../../server/net/java/javamod
from "../../server/block/blockbehaviour" import BlockWorld
from ../../data/block_state import BlockStateId

const PluginsFolder = "plugins"

type
  EnginePlugin = object
    name: string
    handle: int32
    native: bool        ## an aowlmony program of its own; false for the one program all the JavaScript plugins are bundled into

var
  gPlugins: seq[EnginePlugin] = @[]
  gEngineServer: Option[Server] = none[Server]()
  gCurPlayer: Option[Player] = none[Player]()
  gEvName = ""
  gEvPlayerName = ""
  gEvMessage = ""
  gEvCancelled = false
  gEvValue = 0.0                           ## the event's number a plugin may change (the damage amount), set with event_set_value
  gEvFlag = false                          ## the event's boolean, for the events that have one (a plugin sets it with event_set_flag)
  gScope = ""                              ## the plugin whose code is running: commands and tasks it registers are its own
  gEvOwner = ""                            ## when set, the event is for this plugin only (a command or task it registered)
  gLive: seq[string] = @[]                 ## the entry names some loaded plugin defines (hot hooks check it)
  gSubs: seq[(string, string)] = @[]       ## (plugin, entry): an aowlmony plugin that listens to an event (its generic `event` entry is called)
  gSourceText = ""                         ## the plugins' own sources, to see which entries any plugin defines
  gEvStrs: seq[(string, string)] = @[]     ## the current event's extra string fields, read with hostv("event_str", key)
  gEvNums: seq[(string, float64)] = @[]    ## its numeric fields, read with hostv("event_num", key)

proc subscribed(plugin, entry: string): bool =
  for kv in gSubs:
    if kv[0] == plugin and kv[1] == entry: return true
  false

proc textArg(args: seq[HostArg]; k: int): string =
  if k < args.len: args[k].s else: ""

var
  gLogLines: seq[string] = @[]   ## everything the plugins have logged, for tests
  gLogPending: seq[string] = @[] ## logged during the current call, printed once it returns

proc pluginLogLines*(): seq[string] = gLogLines

proc flushPluginLog() =
  ## The engine captures the process's output while a plugin runs, so a line printed from inside a host call never shows; the host
  ## function buffers it and the caller prints it after the engine call has returned.
  for line in gLogPending: echo "[plugin] ", line
  gLogPending = @[]

proc hostServerLog(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gLogLines.add textArg(args, 0)
  gLogPending.add textArg(args, 0)
  1

proc hostEventStr(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  let key = textArg(args, 0)
  res.kind = AoeVString
  res.s = (if key == "player": gEvPlayerName elif key == "message": gEvMessage elif key == "event": gEvName
           elif key == "owner": gEvOwner else: "")
  for kv in gEvStrs:
    if kv[0] == key: res.s = kv[1]
  1

proc hostEventNum(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## A numeric field of the current event (x, y, z, from_x, ..., mode, slot, ...); 0 when the event has none by that name.
  let key = textArg(args, 0)
  res.kind = AoeVNumber
  res.n = 0.0
  for kv in gEvNums:
    if kv[0] == key: res.n = kv[1]
  1

proc hostPluginScope(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gScope = textArg(args, 0)
  1

proc hostEventSetMessage(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvMessage = textArg(args, 0)
  1

proc hostEventCancel(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvCancelled = true
  1

proc hostPlayerMessage(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  if gCurPlayer.isSome:
    let target: Player = gCurPlayer.unsafeGet
    target.sendSystemMessage(text(textArg(args, 0)))
  1

proc hostPlayerCount(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVInt
  res.i = 0
  if gEngineServer.isSome:
    let srv: Server = gEngineServer.unsafeGet
    var total = 0
    for w in srv.worlds: total += w.players.len
    res.i = int64(total)
  1

proc parseNumText(s: string): float64 =
  ## A decimal number in text ("-12", "3.5"); 0 when it is not one. aowlmony plugins send every argument as text.
  var i = 0
  var neg = false
  if i < s.len and s[i] == '-':
    neg = true
    inc i
  var whole = 0.0
  while i < s.len and s[i] >= '0' and s[i] <= '9':
    whole = whole * 10.0 + float64(ord(s[i]) - 48)
    inc i
  var frac = 0.0
  var scale = 1.0
  if i < s.len and s[i] == '.':
    inc i
    while i < s.len and s[i] >= '0' and s[i] <= '9':
      frac = frac * 10.0 + float64(ord(s[i]) - 48)
      scale = scale * 10.0
      inc i
  result = whole + frac / scale
  if neg: result = -result

proc numArg(args: seq[HostArg]; k: int): float64 =
  ## A number as the engine passes it: a float, an int when the value is integral, or text from an aowlmony plugin.
  if k >= args.len: return 0.0
  if args[k].kind == AoeVNumber: args[k].n
  elif args[k].kind == AoeVString: parseNumText(args[k].s)
  else: float64(args[k].i)

proc findPlayer(name: string): Option[Player] =
  result = none[Player]()
  if gEngineServer.isNone: return
  let srv: Server = gEngineServer.unsafeGet
  for w in srv.worlds:
    for p in w.players:
      if p.gameprofile.name == name: result = some(p)

proc overworld(): Option[World] =
  result = none[World]()
  if gEngineServer.isSome:
    let srv: Server = gEngineServer.unsafeGet
    if srv.worlds.len > 0: result = some(srv.worlds[0])

proc hostPlayerItemCount(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_item_count(name, item): how many of the item ("minecraft:stone") the player carries (inventory and equipment); -1 when
  ## the player is not online.
  res.kind = AoeVNumber
  res.n = -1.0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    var key = textArg(args, 1)
    if key.startsWith("minecraft:"): key = key[10 ..< key.len]
    let inv = Inventory(target.inventory)
    var total = 0
    var i = 0
    let size = inventory.size(inv)
    while i < size:
      let stack = inventory.getStack(inv, i)
      if not stack.isEmpty() and stack.item.registryKey == key:
        total += int(stack.itemCount)
      inc i
    res.n = float64(total)
  1

proc hostPlayerSetFood(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_set_food(name, level): 0 to 20 (plugins listening to the food level event may change or cancel it).
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    target.setFoodLevel(uint8(max(0, min(20, int(numArg(args, 1))))))
    res.i = 1
  1

proc hostPlayerGive(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_give(name, item, count): put the items in the player's inventory, dropping what does not fit. False when the player is not
  ## online or the item is unknown.
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    var key = textArg(args, 1)
    if key.startsWith("minecraft:"): key = key[10 ..< key.len]
    let it = Item.fromRegistryKey(key)
    if it != nil:
      var remaining = int(numArg(args, 2))
      while remaining > 0:
        var probe = newItemStack(1'u8, it)
        let take = min(remaining, int(probe.getMaxStackSize()))
        var s = newItemStack(uint8(take), it)
        discard insertStackAnywhere(target.inventory, s)
        if not s.isEmpty():
          target.asInventoryPlayer().dropItem(s, false)
        remaining -= take
      target.currentScreenHandler.sendContentUpdates()
      res.i = 1
  1

proc entityOf(id: int32): nil EntityBase =
  ## The entity with that id in the overworld, nil when there is none.
  let w = overworld()
  if w.isNone: return nil
  getEntityById(w.unsafeGet, id)

proc hostEntityHealth(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## entity_health(id): a living entity's health, -1 when there is no such living entity.
  res.kind = AoeVNumber
  res.n = -1.0
  let e = entityOf(int32(numArg(args, 0)))
  if e != nil:
    let living = e.getLivingEntity()
    if living != nil: res.n = float64(living.health)
  1

proc hostEntitySetHealth(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## entity_set_health(id, health): false when there is no such living entity. 0 kills it.
  res.kind = AoeVBool
  res.i = 0
  let e = entityOf(int32(numArg(args, 0)))
  if e != nil:
    let living = e.getLivingEntity()
    if living != nil:
      living.setHealth(float32(numArg(args, 1)))
      res.i = 1
  1

proc hostEntityPos(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## entity_pos(id, axis): "x", "y" or "z"; 0 when there is no such entity.
  res.kind = AoeVNumber
  res.n = 0.0
  let e = entityOf(int32(numArg(args, 0)))
  if e != nil:
    let axis = textArg(args, 1)
    let p = e.getEntity().pos
    res.n = (if axis == "x": p.x elif axis == "y": p.y else: p.z)
  1

proc hostEntityTeleport(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## entity_teleport(id, x, y, z): false when there is no such entity. Players are moved with player_teleport.
  res.kind = AoeVBool
  res.i = 0
  let e = entityOf(int32(numArg(args, 0)))
  if e != nil:
    let ent = e.getEntity()
    if ent.entityType.resourceName != "player":
      ent.teleportEntity(Vector3[float64](x: numArg(args, 1), y: numArg(args, 2), z: numArg(args, 3)),
        none[float32](), none[float32](), ent.world)
      res.i = 1
  1

proc hostEntityRemove(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## entity_remove(id): take the entity out of the world; false when there is none or it is a player (use player_kick).
  res.kind = AoeVBool
  res.i = 0
  let e = entityOf(int32(numArg(args, 0)))
  if e != nil:
    let ent = e.getEntity()
    if ent.entityType.resourceName != "player":
      ent.remove()
      res.i = 1
  1

proc hostWorldGetBlock(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## world_get_block(x, y, z): the block's name at that position in the overworld ("" when the chunk is not loaded).
  res.kind = AoeVString
  res.s = ""
  let w = overworld()
  if w.isSome:
    let world: World = w.unsafeGet
    let pos = newBlockPos(int32(numArg(args, 0)), int32(numArg(args, 1)), int32(numArg(args, 2)))
    if world.isLoaded(pos):
      let bare = world.getBlock(pos).name
      res.s = (if bare.contains(':'): bare else: "minecraft:" & bare)
  1

proc hostWorldSetBlock(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## world_set_block(x, y, z, name): put the block (its default state) there; false when the name is unknown or the chunk not loaded.
  res.kind = AoeVBool
  res.i = 0
  let w = overworld()
  if w.isSome:
    let world: World = w.unsafeGet
    let pos = newBlockPos(int32(numArg(args, 0)), int32(numArg(args, 1)), int32(numArg(args, 2)))
    let state = defaultStateId(textArg(args, 3))
    if state[0] and world.isLoaded(pos):
      discard world.setBlockState(pos, uint32(state[1]), BfNotifyAll)
      res.i = 1
  1

proc hostWorldTime(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## world_time(): the overworld's time of day in ticks.
  res.kind = AoeVNumber
  res.n = 0.0
  let w = overworld()
  if w.isSome: res.n = float64(w.unsafeGet.getTimeOfDay())
  1

proc hostWorldSetTime(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## world_set_time(ticks)
  res.kind = AoeVBool
  res.i = 0
  let w = overworld()
  if w.isSome:
    w.unsafeGet.setTimeOfDay(int64(numArg(args, 0)))
    res.i = 1
  1

proc hostPlayerOnline(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVBool
  res.i = (if findPlayer(textArg(args, 0)).isSome: 1 else: 0)
  1

proc hostPlayerMessageTo(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_message_to(name, text): true when the player was online.
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    target.sendSystemMessage(text(textArg(args, 1)))
    res.i = 1
  1

proc hostPlayerKick(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_kick(name, reason)
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    target.client.kick(text(textArg(args, 1)))
    res.i = 1
  1

proc hostPlayerTeleport(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_teleport(name, x, y, z): keeps the player's facing.
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    target.requestTeleport(Vector3[float64](x: numArg(args, 1), y: numArg(args, 2), z: numArg(args, 3)), target.yaw, target.pitch)
    res.i = 1
  1

proc hostPlayerSetGamemode(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_set_gamemode(name, mode): 0 survival, 1 creative, 2 adventure, 3 spectator.
  res.kind = AoeVBool
  res.i = 0
  let who = findPlayer(textArg(args, 0))
  let mode = int(numArg(args, 1))
  if who.isSome and mode >= 0 and mode <= 3:
    let target: Player = who.unsafeGet
    res.i = (if target.setGamemode(GameMode(mode)): 1 else: 0)
  1

proc hostPlayerPos(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## player_pos(name, axis): the player's x, y or z ("x", "y", "z"); 0 when the player is not online.
  res.kind = AoeVNumber
  res.n = 0.0
  let who = findPlayer(textArg(args, 0))
  if who.isSome:
    let target: Player = who.unsafeGet
    let axis = textArg(args, 1)
    if axis == "x": res.n = target.pos.x
    elif axis == "y": res.n = target.pos.y
    elif axis == "z": res.n = target.pos.z
  1

proc hostServerBroadcast(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## server_broadcast(text): a system message to every player in every world.
  if gEngineServer.isSome:
    let srv: Server = gEngineServer.unsafeGet
    for w in srv.worlds:
      w.broadcastSystemMessage(text(textArg(args, 0)), false)
  1

# ---- scheduled tasks: schedule_after(ticks) / schedule_repeat(ticks) answer a task id, schedule_cancel(id) stops it; each run calls
# the entry `on_task`, where hostv("event_num", "id") is the id ----

type EngTask = object
  id: int
  owner: string
  due: int64
  period: int64     ## 0 for a one-shot task

var
  gTasks: seq[EngTask] = @[]
  gNextTask = 1
  gNowTick = 0'i64

proc addTask(delayTicks: float64; repeat: bool): int =
  var d = int64(delayTicks)
  if d < 1: d = 1
  result = gNextTask
  inc gNextTask
  gTasks.add EngTask(id: result, owner: gScope, due: gNowTick + d, period: (if repeat: d else: 0'i64))

proc hostScheduleAfter(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVInt
  res.i = int64(addTask(numArg(args, 0), false))
  1

proc hostScheduleRepeat(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVInt
  res.i = int64(addTask(numArg(args, 0), true))
  1

proc hostScheduleCancel(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  let id = int(numArg(args, 0))
  var kept: seq[EngTask] = @[]
  for t in gTasks:
    if t.id != id: kept.add t
  gTasks = kept
  1

proc registerServerHost() =
  registerHost("plugin_scope", hostPluginScope)
  registerHost("player_online", hostPlayerOnline)
  registerHost("player_message_to", hostPlayerMessageTo)
  registerHost("player_kick", hostPlayerKick)
  registerHost("player_teleport", hostPlayerTeleport)
  registerHost("player_set_gamemode", hostPlayerSetGamemode)
  registerHost("player_pos", hostPlayerPos)
  registerHost("player_item_count", hostPlayerItemCount)
  registerHost("player_give", hostPlayerGive)
  registerHost("player_set_food", hostPlayerSetFood)
  registerHost("entity_health", hostEntityHealth)
  registerHost("entity_set_health", hostEntitySetHealth)
  registerHost("entity_pos", hostEntityPos)
  registerHost("entity_teleport", hostEntityTeleport)
  registerHost("entity_remove", hostEntityRemove)
  registerHost("world_get_block", hostWorldGetBlock)
  registerHost("world_set_block", hostWorldSetBlock)
  registerHost("world_time", hostWorldTime)
  registerHost("world_set_time", hostWorldSetTime)
  registerHost("server_broadcast", hostServerBroadcast)
  registerHost("schedule_after", hostScheduleAfter)
  registerHost("schedule_repeat", hostScheduleRepeat)
  registerHost("schedule_cancel", hostScheduleCancel)
  registerHost("server_log", hostServerLog)
  registerHost("event_str", hostEventStr)
  registerHost("event_num", hostEventNum)
  registerHost("event_set_message", hostEventSetMessage)
  registerHost("event_cancel", hostEventCancel)
  registerHost("player_message", hostPlayerMessage)
  registerHost("server_player_count", hostPlayerCount)

proc slashedPath(p: string): string =
  result = ""
  for c in p:
    result.add (if c == '\\': '/' else: c)

proc lastSlash(s: string): int =
  result = -1
  for k in 0 ..< s.len:
    if s[k] == '/': result = k

proc scanEnginePlugins*(folder: string): seq[(string, string)] =
  ## (name, file) for each `<folder>/<name>/main.js` and `<folder>/<name>.js`.
  result = @[]
  try:
    for kind, entry in walkDir(path(folder)):
      let full = slashedPath($entry)
      if kind == pcFile and full.toLowerAscii.endsWith(".js"):
        var base = full
        let slash = lastSlash(base)
        if slash >= 0: base = base.substr(slash + 1)
        if not base.startsWith("."):   # `.engine-bundle.js` is ours
          result.add (base.substr(0, base.len - 4), full)
      elif kind == pcDir:
        let main = full & "/main.js"
        var found = false
        try:
          for k2, e2 in walkDir(path(full)):
            if k2 == pcFile and slashedPath($e2).toLowerAscii.endsWith("/main.js"): found = true
        except ErrorCode:
          discard
        if found:
          var base = full
          let slash = lastSlash(base)
          if slash >= 0: base = base.substr(slash + 1)
          result.add (base, main)
  except ErrorCode:
    discard

proc fireEngineOwned*(entry, playerName, message, owner: string; strs: seq[(string, string)]; nums: seq[(string, float64)];
    player: Option[Player]): (bool, string) =
  ## Offers the event to every plugin that has the entry (to the plugin `owner` alone when it is not empty); (cancelled, the message
  ## after the plugins). `strs` and `nums` are the event's extra fields, which a plugin reads with `hostv("event_str", key)` and
  ## `hostv("event_num", key)`.
  gEvName = entry
  gEvOwner = owner
  gEvPlayerName = playerName
  gEvMessage = message
  gEvStrs = strs
  gEvNums = nums
  gEvCancelled = false
  let outer = gCurPlayer
  gCurPlayer = player
  for p in gPlugins:
    if owner.len > 0 and p.native and p.name != owner: continue
    if p.native:
      gScope = p.name
      if subscribed(p.name, entry):
        if callPlugin(p.handle, "event") < 0:
          echo "[plugin] ", p.name, ": ", entry, " failed: ", engineError()
      elif hasEntry(p.handle, entry):
        if callPlugin(p.handle, entry) < 0:
          echo "[plugin] ", p.name, ": ", entry, " failed: ", engineError()
      gScope = ""
    elif hasEntry(p.handle, entry):
      if callPlugin(p.handle, entry) < 0:
        echo "[plugin] ", p.name, ": ", entry, " failed: ", engineError()
  gCurPlayer = outer
  gEvOwner = ""
  flushPluginLog()
  (gEvCancelled, gEvMessage)

proc fireEngineEv*(entry, playerName, message: string; strs: seq[(string, string)]; nums: seq[(string, float64)];
    player: Option[Player]): (bool, string) =
  fireEngineOwned(entry, playerName, message, "", strs, nums, player)

proc fireEngineAs*(entry, playerName, message: string; player: Option[Player]): (bool, string) =
  fireEngineEv(entry, playerName, message, @[], @[], player)

proc fireEngine(entry: string; player: Player; message: string): (bool, string) =
  fireEngineAs(entry, player.gameprofile.name, message, some(player))

proc fireEngineFields(entry: string; player: Player; strs: seq[(string, string)]; nums: seq[(string, float64)]): (bool, string) =
  fireEngineEv(entry, player.gameprofile.name, "", strs, nums, some(player))

proc moveNums(fromPos, toPos: Vector3[float64]): seq[(string, float64)] =
  result = @[]
  result.add ("from_x", fromPos.x)
  result.add ("from_y", fromPos.y)
  result.add ("from_z", fromPos.z)
  result.add ("to_x", toPos.x)
  result.add ("to_y", toPos.y)
  result.add ("to_z", toPos.z)

# ---- chaining onto the hooks pluginmgr.aowl installs (a captured closure called inside a closure asserts in hexer, so the
# previous hooks are kept in globals and called through procs that take them as parameters) ----

proc passChat(player: Player; message: string): (bool, string) {.closure.} = (false, message)
proc passText(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = (false, message)

var gPrevChat: proc(player: Player; message: string): (bool, string) {.closure.} = passChat
var gPrevCommand: proc(player: Player; command: string): (bool, string) {.closure.} = passChat
var gPrevJoin: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = passText
var gPrevLeave: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = passText

proc callChatPrev(prev: proc(player: Player; message: string): (bool, string) {.closure.}; player: Player; message: string): (bool, string) =
  prev(player, message)

proc callCommandPrev(prev: proc(player: Player; command: string): (bool, string) {.closure.}; player: Player; command: string): (bool, string) =
  prev(player, command)

proc callJoinPrev(prev: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.}; player: Player;
    message: TextComponent): (bool, TextComponent) =
  prev(player, message)

proc passMove(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
proc passToggle(player: Player; kind: int; value: bool): bool {.closure.} = false
proc passMode(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = (false, next)
proc passHeld(player: Player; previous, next: int): bool {.closure.} = false
proc passLogin(player: Player): (bool, TextComponent) {.closure.} = (false, text(""))
proc passInteract(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = false
proc passPlace(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = false

var gPrevMove: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = passMove
var gPrevTeleport: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = passMove
var gPrevToggle: proc(player: Player; kind: int; value: bool): bool {.closure.} = passToggle
var gPrevMode: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = passMode
var gPrevHeld: proc(player: Player; previous, next: int): bool {.closure.} = passHeld
var gPrevLogin: proc(player: Player): (bool, TextComponent) {.closure.} = passLogin
var gPrevInteract: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = passInteract
var gPrevPlace: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = passPlace

proc callMovePrev(prev: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.}; player: Player;
    fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) =
  prev(player, fromPos, toPos)

proc callTogglePrev(prev: proc(player: Player; kind: int; value: bool): bool {.closure.}; player: Player; kind: int; value: bool): bool =
  prev(player, kind, value)

proc callModePrev(prev: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.}; player: Player;
    previous, next: GameMode): (bool, GameMode) =
  prev(player, previous, next)

proc callHeldPrev(prev: proc(player: Player; previous, next: int): bool {.closure.}; player: Player; previous, next: int): bool =
  prev(player, previous, next)

proc callLoginPrev(prev: proc(player: Player): (bool, TextComponent) {.closure.}; player: Player): (bool, TextComponent) =
  prev(player)

proc callInteractPrev(prev: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.}; player: Player; action: int;
    pos: Option[BlockPos]): bool =
  prev(player, action, pos)

proc callPlacePrev(prev: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.}; player: Player;
    placedBlock, clickedBlock: string; position: BlockPos): bool =
  prev(player, placedBlock, clickedBlock, position)

proc passCommand(command: string): bool {.closure.} = false
proc passBroadcast(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = (false, message, sender)
proc passTickStart(tick: int32) {.closure.} = discard
proc passTickEnd(tick: int32; durationNanos: int64) {.closure.} = discard
proc passLoad(reload: bool) {.closure.} = discard
proc passPacket(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
proc passRedstone(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  (false, newCurrent)

var gPrevCommandSrv: proc(command: string): bool {.closure.} = passCommand
var gPrevBroadcast: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = passBroadcast
var gPrevTickStart: proc(tick: int32) {.closure.} = passTickStart
var gPrevTickEnd: proc(tick: int32; durationNanos: int64) {.closure.} = passTickEnd
var gPrevLoad: proc(reload: bool) {.closure.} = passLoad
var gPrevPacket: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = passPacket
var gPrevRedstone: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  passRedstone

proc callCommandSrvPrev(prev: proc(command: string): bool {.closure.}; command: string): bool = prev(command)

proc callBroadcastPrev(prev: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.};
    message, sender: TextComponent): (bool, TextComponent, TextComponent) =
  prev(message, sender)

proc callTickStartPrev(prev: proc(tick: int32) {.closure.}; tick: int32) = prev(tick)
proc callTickEndPrev(prev: proc(tick: int32; durationNanos: int64) {.closure.}; tick: int32; durationNanos: int64) = prev(tick, durationNanos)
proc callLoadPrev(prev: proc(reload: bool) {.closure.}; reload: bool) = prev(reload)

proc callPacketPrev(prev: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.}; player: Player; packetId: int32;
    payload: seq[byte]): bool =
  prev(player, packetId, payload)

proc callRedstonePrev(prev: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.};
    world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) =
  prev(world, stateId, pos, oldCurrent, newCurrent)

proc passSpawn(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} = next
proc passGrow(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.} = (false, newState)
proc passChunk(client: JavaClient; chunk: ChunkData): bool {.closure.} = false

var gPrevSpawn: proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} = passSpawn
var gPrevGrow: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.} = passGrow
var gPrevChunk: proc(client: JavaClient; chunk: ChunkData): bool {.closure.} = passChunk

proc callSpawnPrev(prev: proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.}; world: CommandWorld;
    previous, next: CmdSpawn): CmdSpawn =
  prev(world, previous, next)

proc callGrowPrev(prev: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.}; world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
    newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) =
  prev(world, oldBlock, oldState, newBlock, newState, pos)

proc callChunkPrev(prev: proc(client: JavaClient; chunk: ChunkData): bool {.closure.}; client: JavaClient; chunk: ChunkData): bool =
  prev(client, chunk)

const HotEntries = ["on_server_tick_start", "on_server_tick_end", "on_packet_received", "on_block_redstone", "on_block_grow",
  "on_chunk_send"]

proc noteSource*(text: string) =
  ## Adds a plugin's source to what is known about the loaded plugins, and notes which hot entries it mentions.
  gSourceText.add text
  gSourceText.add "\n"
  for e in HotEntries:
    var known = false
    for g in gLive:
      if g == e: known = true
    if text.find(e) >= 0 and not known: gLive.add e

proc forgetSources*() =
  gSourceText = ""
  gLive = @[]

proc listened(entry: string): bool =
  ## True when some loaded plugin subscribed to the event, or (a JavaScript or raw entry) its source mentions the entry.
  for kv in gSubs:
    if kv[1] == entry: return true
  gSourceText.find(entry) >= 0

proc entryUsed(name: string): bool =
  ## True when some loaded plugin's source mentions the entry; the hot hooks (tick, packet, redstone ...) do nothing otherwise.
  for e in gLive:
    if e == name: return true
  false

proc fireServer(entry: string; strs: seq[(string, string)]; nums: seq[(string, float64)]): (bool, string) =
  fireEngineEv(entry, "", "", strs, nums, none[Player]())

# ---- commands: register_command(name, description, level) adds /name (level 0 anyone, 1-4 operators of that level), taking an
# optional greedy text argument. Running it calls the plugin entry `on_command` (hostv("event_str", "command" | "args" | "player"));
# the plugin answers with command_reply(text), which goes to whoever ran it (a player or the console), and may call
# command_fail(text) to make the command fail with that message. ----

var
  gReply: seq[string] = @[]
  gCmdFail = ""
  gCmdOwners: seq[(string, string)] = @[]   ## (command name, the plugin that registered it)

proc ownerOfCommand(name: string): string =
  result = ""
  for kv in gCmdOwners:
    if kv[0] == name: result = kv[1]

proc hostCommandReply(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gReply.add textArg(args, 0)
  1

proc hostCommandFail(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gCmdFail = textArg(args, 0)
  1

proc runEngineCommand(cmdName, rest: string; sender: CommandSender): CommandResult =
  var who = ""
  if sender.kind == cskPlayer: who = sender.player.gameProfile.name
  gReply = @[]
  gCmdFail = ""
  discard fireEngineOwned("on_command", who, "", ownerOfCommand(cmdName), @[("command", cmdName), ("args", rest)], @[], none[Player]())
  for line in gReply:
    sender.sendMessage(text(line))
  gReply = @[]
  if gCmdFail.len > 0:
    let message = gCmdFail
    gCmdFail = ""
    return cmdFailed(text(message))
  cmdSuccess(1'i32)

proc hostRegisterCommand(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVBool
  res.i = 0
  if gEngineServer.isNone: return 1
  let srv: Server = gEngineServer.unsafeGet
  let name = textArg(args, 0)
  let dispatcher = srv.commandDispatcher
  if name.len == 0: return 1
  if dispatcher == nil: return 1
  let level = int(numArg(args, 2))
  let node = "engine:command." & name
  let commandServer = srv.commandServer
  if commandServer != nil:
    let registry = commandServer.permissionRegistry
    if registry != nil:
      let def = (if level <= 0: permissionAllow() else: permissionOp(PermissionLvl(min(level, 4))))
      discard registerPermission(registry, newPermission(node, textArg(args, 1), def))
  let cmdName = name
  var keptOwners: seq[(string, string)] = @[]
  for kv in gCmdOwners:
    if kv[0] != name: keptOwners.add kv
  gCmdOwners = keptOwners
  gCmdOwners.add (name, gScope)
  let exec: FallbackExecutor = proc(sender: CommandSender; server: nil CommandServer; consumed: ConsumedArgs): CommandResult {.closure.} =
    var rest = ""
    discard findString(consumed, "args", akMsg, rest)
    runEngineCommand(cmdName, rest, sender)
  var tree = newCommandTree([name], textArg(args, 1))
  tree = then(tree, execute(argument("args", newMsgArgConsumer()), exec))
  tree = execute(tree, exec)
  register(dispatcher.fallbackDispatcher, tree, node)
  res.i = 1
  1

proc hostSubscribeEvent(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## subscribe_event(entry): the plugin that is running listens to that event. Busy events are only offered while someone listens.
  let entry = textArg(args, 0)
  if not subscribed(gScope, entry): gSubs.add (gScope, entry)
  for e in HotEntries:
    if e == entry:
      var known = false
      for g in gLive:
        if g == e: known = true
      if not known: gLive.add e
  1

proc hostEventSetFlag(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvFlag = numArg(args, 0) != 0.0
  1

proc hostEventSetValue(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvValue = numArg(args, 0)
  1

proc registerCommandHost() =
  registerHost("event_set_flag", hostEventSetFlag)
  registerHost("event_set_value", hostEventSetValue)
  registerHost("subscribe_event", hostSubscribeEvent)
  registerHost("register_command", hostRegisterCommand)
  registerHost("command_reply", hostCommandReply)
  registerHost("command_fail", hostCommandFail)

proc runDueTasks*(tick: int64) =
  ## Called once per server tick: runs `on_task` for each task whose time has come, repeating tasks are set again. The task list is
  ## copied first, so a plugin that schedules or cancels inside `on_task` changes the next tick's list and not this one.
  gNowTick = tick
  var due: seq[(int, string)] = @[]
  var next: seq[EngTask] = @[]
  for t in gTasks:
    if t.due <= tick:
      due.add (t.id, t.owner)
      if t.period > 0:
        var again = t
        again.due = tick + t.period
        next.add again
    else:
      next.add t
  gTasks = next
  for d in due:
    discard fireEngineOwned("on_task", "", "", d[1], @[], @[("id", float64(d[0]))], none[Player]())

const EntryNames = ["start", "stop", "on_player_chat", "on_player_command", "on_player_join", "on_player_leave",
  "on_player_move", "on_player_teleport", "on_player_toggle", "on_player_gamemode_change", "on_player_item_held",
  "on_player_login", "on_player_interact", "on_block_place", "on_server_command", "on_server_broadcast", "on_server_tick_start",
  "on_server_tick_end", "on_server_load", "on_packet_received", "on_block_redstone", "on_spawn_change", "on_block_grow", "on_chunk_send", "on_task", "on_command", "on_player_exp_change", "on_player_respawn", "on_player_death",
  "on_player_swing", "on_player_swap_hands", "on_inventory_open", "on_entity_potion_effect", "on_player_use_item", "on_player_interact_entity", "on_player_custom_payload", "on_player_main_hand_change",
  "on_inventory_close", "on_inventory_click", "on_block_break", "on_player_drop_item", "on_player_pickup_item", "on_player_item_consume",
  "on_player_bed_enter", "on_player_bed_leave", "on_sign_change", "on_bucket_empty", "on_bucket_fill", "on_permission_check",
  "on_player_fish", "on_player_egg_throw", "on_custom_click", "on_player_change_world",
  "on_entity_damage", "on_entity_death", "on_entity_spawn", "on_entity_remove", "on_explosion", "on_weather_change",
  "on_entity_heal", "on_player_food_change", "on_player_statistic", "on_server_list_ping", "on_player_pre_login",
  "on_player_level_change", "on_world_save", "on_time_set"]

proc jsString(s: string): string =
  ## A double-quoted JavaScript string literal.
  result = "\""
  for c in s:
    if c == '"': result.add "\\\""
    elif c == '\\': result.add "\\\\"
    elif c == '\n': result.add "\\n"
    elif c == '\r': discard
    else: result.add c
  result.add "\""

proc readText(file: string): string =
  try:
    result = readFile(file)
  except:
    result = ""

proc stripModuleSyntax(src: string): string =
  ## A plugin may be written module-style. Everything in the bundle shares one program and reaches the server through the global
  ## `host`/`hostS`/`hostv`, so a module needs only its syntax removed: a one-line `import ... ;` is dropped, `export default ` and
  ## `export ` before a declaration are dropped, and a one-line `export { ... };` is dropped. (A multi-line import or export list
  ## is left alone and will fail to load, which the loader reports.)
  result = ""
  let lines = src.splitLines()
  for k in 0 ..< lines.len:
    var line = lines[k]
    if line.startsWith("import ") and (line.find(" from ") >= 0 or line.find("\"") >= 0):
      line = ""
    elif line.startsWith("export {"):
      line = ""
    elif line.startsWith("export default "):
      line = line.substr(len("export default "))
    elif line.startsWith("export "):
      line = line.substr(len("export "))
    result.add line
    result.add "\n"

proc bundleOf(found: seq[(string, string)]): string =
  ## The engine runs one JavaScript program per process, so the plugins are bundled into one: each source in its own function
  ## scope (its `start`, `stop` and `on_player_*` functions are collected, nothing leaks between plugins), and the program's own
  ## entry points call each plugin's, a throw in one plugin logged and not passed on.
  result = "var __aoeP = [];\n"
  for (name, file) in found:
    result.add "(function () {\n"
    # the entry names are declared local first: without that, `typeof start` in a plugin that has no `start` finds the program's own
    # global `start` (the dispatcher below), which would then call itself
    result.add "var "
    for k in 0 ..< EntryNames.len:
      if k > 0: result.add ", "
      result.add EntryNames[k]
    result.add ";\n"
    result.add JsSdkSource
    result.add "\n"
    result.add stripModuleSyntax(readText(file))
    result.add "\n;var __h = {};\n"
    for e in EntryNames:
      result.add "if (typeof " & e & " === \"function\") __h." & e & " = " & e & ";\n"
    result.add "__h.__sdk = __sdk;\n"
    result.add "__aoeP.push({ name: " & jsString(name) & ", h: __h });\n})();\n"
  for e in EntryNames:
    result.add "function " & e & "() {\n"
    result.add "  for (var i = 0; i < __aoeP.length; i++) {\n"
    result.add "    var p = __aoeP[i];\n"
    if e == "on_command" or e == "on_task":
      result.add "    if (hostv(\"event_str\", \"owner\") != \"\" && hostv(\"event_str\", \"owner\") != p.name) continue;\n"
    result.add "    hostS(\"plugin_scope\", p.name);\n"
    result.add "    if (p.h." & e & ") { try { p.h." & e & "(); } catch (x) { hostS(\"server_log\", p.name + \": " & e & " threw: \" + String(x)); } }\n"
    result.add "    if (p.h.__sdk) { try { p.h.__sdk.fire(\"" & e & "\"); } catch (x) { hostS(\"server_log\", p.name + \": " & e & " threw: \" + String(x)); } }\n"
    result.add "  }\n  hostS(\"plugin_scope\", \"\");\n}\n"

var gHostReady = false

proc setEngineServer*(server: Server) =
  ## The server the host calls act on. Set before any plugin loads: a plugin registers its commands in `start`.
  gEngineServer = some(server)

proc initEngineHost*(): bool =
  ## Starts the engine and registers the server's host functions; once. False (with the reason printed) when the engine cannot start.
  if gHostReady: return true
  if not engineInit():
    echo "[plugin] the engine could not start (is aoe_engine.dll on the DLL path?): ", engineError()
    return false
  registerServerHost()
  registerCommandHost()
  gHostReady = true
  true

proc attachProgram*(name: string; handle: int32; native: bool) =
  gPlugins.add EnginePlugin(name: name, handle: handle, native: native)

proc detachProgram*(name: string): int32 =
  ## Takes the program out of the list events go to; its handle, or -1 when there is none by that name.
  result = -1
  var kept: seq[EnginePlugin] = @[]
  for p in gPlugins:
    if p.name == name: result = p.handle
    else: kept.add p
  gPlugins = kept

proc programLoaded*(name: string): bool =
  for p in gPlugins:
    if p.name == name: return true
  false

proc refreshCommandLists*() =
  ## `Context::reload_commands_for_everyone`: the commands packet again, for every player, after commands were added or removed.
  if gEngineServer.isNone: return
  let server: Server = gEngineServer.unsafeGet
  let d = server.commandDispatcher
  if d == nil: return
  for w in server.worlds:
    for p in w.players:
      p.client.writePacketFor(buildCCommands(senderPlayer(server.commandPlayerOf(p)), server.commandServer, d))

proc dropOwnedBy*(owner: string) =
  ## Forgets what a plugin registered: its commands leave the dispatcher and its scheduled tasks stop.
  var keptTasks: seq[EngTask] = @[]
  for t in gTasks:
    if t.owner != owner: keptTasks.add t
  gTasks = keptTasks
  var keptSubs: seq[(string, string)] = @[]
  for kv in gSubs:
    if kv[0] != owner: keptSubs.add kv
  gSubs = keptSubs
  var keptCmds: seq[(string, string)] = @[]
  var removed = false
  for kv in gCmdOwners:
    if kv[1] == owner:
      if gEngineServer.isSome:
        let server: Server = gEngineServer.unsafeGet
        let d = server.commandDispatcher
        if d != nil:
          unregister(d.fallbackDispatcher, kv[0])
          removed = true
    else:
      keptCmds.add kv
  gCmdOwners = keptCmds
  if removed: refreshCommandLists()

proc loadJsBundle*(found: seq[(string, string)]; bundleFile: string): int32 =
  ## Bundles the JavaScript plugins into one program (the engine runs one JavaScript program per process), loads it and runs the
  ## plugins' `start` entries. The program's handle, or -1.
  if found.len == 0: return -1
  if not initEngineHost(): return -1
  forgetSources()
  for (name, file) in found:
    noteSource(readText(file))
  try:
    writeFile(bundleFile, bundleOf(found))
  except:
    echo "[plugin] could not write ", bundleFile
    return -1
  let h = loadPlugin(bundleFile, 0)
  if h < 0:
    echo "[plugin] could not load the plugin bundle: ", engineError()
    return -1
  attachProgram("js", h, false)
  var names = ""
  for (name, file) in found:
    if names.len > 0: names.add ", "
    names.add name
  echo "[plugin] loaded ", found.len, " JavaScript plugin(s): ", names, " (", pluginMode(h), ")"
  if callPlugin(h, "start") < 0:
    echo "[plugin] start failed: ", engineError()
  flushPluginLog()
  h

proc loadEnginePlugins*(found: seq[(string, string)]; bundleFile: string = "plugins/.engine-bundle.js"): int =
  ## The JavaScript plugins as one bundled program; how many it holds.
  if loadJsBundle(found, bundleFile) < 0: return 0
  found.len

proc loadNativeProgram*(name, artifact, sourceText: string): string =
  ## An aowlmony plugin: its typed artifact (the main module's `.s.nif`, its other modules beside it) as a program of its own, its
  ## `start` entry run. "" when it loaded, else the reason.
  if not initEngineHost(): return "the engine could not start"
  if programLoaded(name): return "plugin " & name & " is already loaded"
  gScope = name
  let h = loadPlugin(artifact, 0)
  gScope = ""
  if h < 0: return "could not load " & artifact & ": " & engineError()
  attachProgram(name, h, true)
  noteSource(sourceText)
  echo "[plugin] loaded aowlmony plugin ", name, " (", pluginMode(h), ")"
  result = ""
  if hasEntry(h, "start"):
    gScope = name
    if callPlugin(h, "start") < 0: result = "start failed: " & engineError()
    gScope = ""
  flushPluginLog()

proc unloadProgram*(name: string): string =
  ## Unloads a program (the engine runs its `stop` entry) and forgets its commands and tasks. "" when done, else the reason.
  if not programLoaded(name): return "plugin " & name & " is not loaded"
  let h = detachProgram(name)
  gScope = name
  discard unloadPlugin(h)
  gScope = ""
  flushPluginLog()
  dropOwnedBy(name)
  ""

proc installEngineEventHooks*(server: Server) =
  ## Chains the engine onto the server's event hooks, once: each hook offers its event to the loaded plugins after the hook that was
  ## there. Hooks for entries only some plugins define (tick, packet, redstone, block grow, chunk send) check at run time.
  gEngineServer = some(server)
  gPrevChat = gPluginChatHook
  gPluginChatHook = proc(player: Player; message: string): (bool, string) {.closure.} =
    let before = callChatPrev(gPrevChat, player, message)
    if before[0]: return before
    fireEngine("on_player_chat", player, before[1])
  gPrevCommand = gPluginCommandHook
  gPluginCommandHook = proc(player: Player; command: string): (bool, string) {.closure.} =
    let before = callCommandPrev(gPrevCommand, player, command)
    if before[0]: return before
    fireEngine("on_player_command", player, before[1])
  gPrevJoin = gPluginJoinHook
  gPluginJoinHook = proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} =
    let before = callJoinPrev(gPrevJoin, player, message)
    if before[0]: return before
    let o = fireEngine("on_player_join", player, "")
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    answer
  gPrevLeave = gPluginLeaveHook
  gPluginLeaveHook = proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} =
    let before = callJoinPrev(gPrevLeave, player, message)
    if before[0]: return before
    let o = fireEngine("on_player_leave", player, "")
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    answer
  # movement and state: the cancel is honoured, a plugin cannot change the destination or the value
  gPrevMove = gPluginMoveHook
  gPluginMoveHook = proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
    let before = callMovePrev(gPrevMove, player, fromPos, toPos)
    if before[0]: return before
    let o = fireEngineFields("on_player_move", player, @[], moveNums(fromPos, before[1]))
    var answer: (bool, Vector3[float64]) = before
    answer[0] = o[0]
    answer
  gPrevTeleport = gPluginTeleportHook
  gPluginTeleportHook = proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
    let before = callMovePrev(gPrevTeleport, player, fromPos, toPos)
    if before[0]: return before
    let o = fireEngineFields("on_player_teleport", player, @[], moveNums(fromPos, before[1]))
    var answer: (bool, Vector3[float64]) = before
    answer[0] = o[0]
    answer
  gPrevToggle = gPluginToggleHook
  gPluginToggleHook = proc(player: Player; kind: int; value: bool): bool {.closure.} =
    if callTogglePrev(gPrevToggle, player, kind, value): return true
    fireEngineFields("on_player_toggle", player, @[], @[("kind", float64(kind)), ("value", (if value: 1.0 else: 0.0))])[0]
  gPrevMode = gPluginGameModeHook
  gPluginGameModeHook = proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} =
    let before = callModePrev(gPrevMode, player, previous, next)
    if before[0]: return before
    let o = fireEngineFields("on_player_gamemode_change", player, @[], @[("previous", float64(ord(previous))), ("next", float64(ord(before[1])))])
    var answer: (bool, GameMode) = before
    answer[0] = o[0]
    answer
  gPrevHeld = gPluginItemHeldHook
  gPluginItemHeldHook = proc(player: Player; previous, next: int): bool {.closure.} =
    if callHeldPrev(gPrevHeld, player, previous, next): return true
    fireEngineFields("on_player_item_held", player, @[], @[("previous", float64(previous)), ("next", float64(next))])[0]
  gPrevLogin = gPluginLoginHook
  gPluginLoginHook = proc(player: Player): (bool, TextComponent) {.closure.} =
    let before = callLoginPrev(gPrevLogin, player)
    if before[0]: return before
    let o = fireEngineFields("on_player_login", player, @[], @[])
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    if o[0] and o[1].len > 0: answer[1] = text(o[1])   # a plugin that set a message gives the kick reason
    answer
  gPrevInteract = gPluginInteractHook
  gPluginInteractHook = proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
    if callInteractPrev(gPrevInteract, player, action, pos): return true
    var nums: seq[(string, float64)] = @[("action", float64(action))]
    if pos.isSome:
      let at: BlockPos = pos.unsafeGet
      nums.add ("x", float64(at.vec.x))
      nums.add ("y", float64(at.vec.y))
      nums.add ("z", float64(at.vec.z))
    fireEngineFields("on_player_interact", player, @[], nums)[0]
  gPrevPlace = gPluginBlockPlaceHook
  gPluginBlockPlaceHook = proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} =
    if callPlacePrev(gPrevPlace, player, placedBlock, clickedBlock, position): return true
    fireEngineFields("on_block_place", player, @[("placed", placedBlock), ("clicked", clickedBlock)],
      @[("x", float64(position.vec.x)), ("y", float64(position.vec.y)), ("z", float64(position.vec.z))])[0]
  # server events
  gPrevCommandSrv = gPluginServerCommandHook
  gPluginServerCommandHook = proc(command: string): bool {.closure.} =
    if callCommandSrvPrev(gPrevCommandSrv, command): return true
    fireServer("on_server_command", @[("command", command)], @[])[0]
  gPrevBroadcast = gPluginServerBroadcastHook
  gPluginServerBroadcastHook = proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} =
    let before = callBroadcastPrev(gPrevBroadcast, message, sender)
    if before[0]: return before
    let o = fireServer("on_server_broadcast", @[("message", before[1].getText), ("sender", before[2].getText)], @[])
    var answer: (bool, TextComponent, TextComponent) = before
    answer[0] = o[0]
    answer
  gPrevLoad = gPluginServerLoadHook
  gPluginServerLoadHook = proc(reload: bool) {.closure.} =
    callLoadPrev(gPrevLoad, reload)
    discard fireServer("on_server_load", @[], @[("reload", (if reload: 1.0 else: 0.0))])
  # `/setworldspawn`: SpawnChangeEvent is not cancellable and a plugin cannot move the spawn here, it only sees the change
  let commandServer = server.commandServer
  if commandServer != nil:
    gPrevSpawn = commandServer.fireSpawnChange
    commandServer.fireSpawnChange = proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} =
      let result0 = callSpawnPrev(gPrevSpawn, world, previous, next)
      discard fireServer("on_spawn_change", @[],
        @[("previous_x", float64(previous.x)), ("previous_y", float64(previous.y)), ("previous_z", float64(previous.z)),
          ("next_x", float64(result0.x)), ("next_y", float64(result0.y)), ("next_z", float64(result0.z)),
          ("yaw", float64(result0.yaw)), ("pitch", float64(result0.pitch))])
      result0
  block:
    gPrevGrow = gPluginBlockGrowHook
    gPluginBlockGrowHook = proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
        pos: BlockPos): (bool, BlockStateId) {.closure.} =
      let before = callGrowPrev(gPrevGrow, world, oldBlock, oldState, newBlock, newState, pos)
      if before[0]: return before
      if not entryUsed("on_block_grow"): return before
      let o = fireServer("on_block_grow", @[("old_block", "minecraft:" & oldBlock.name), ("new_block", "minecraft:" & newBlock.name)],
        @[("x", float64(pos.vec.x)), ("y", float64(pos.vec.y)), ("z", float64(pos.vec.z))])
      var answer: (bool, BlockStateId) = before
      answer[0] = o[0]
      answer
  block:
    gPrevChunk = gChunkSendHook
    gChunkSendHook = proc(client: JavaClient; chunk: ChunkData): bool {.closure.} =
      if callChunkPrev(gPrevChunk, client, chunk): return true
      if not entryUsed("on_chunk_send"): return false
      # the event names the chunk, not a player (upstream's ChunkSend holds the world and the chunk)
      fireServer("on_chunk_send", @[], @[("x", float64(chunk.x)), ("z", float64(chunk.z))])[0]
  # hot hooks: installed only when a plugin defines the entry
  block:
    gPrevTickStart = gPluginTickStartHook
    gPluginTickStartHook = proc(tick: int32) {.closure.} =
      callTickStartPrev(gPrevTickStart, tick)
      if entryUsed("on_server_tick_start"): discard fireServer("on_server_tick_start", @[], @[("tick", float64(tick))])
  block:
    # one tick hook serves both: scheduled tasks run first, then the plugins' own tick-end entry when one exists
    gPrevTickEnd = gPluginTickEndHook
    gPluginTickEndHook = proc(tick: int32; durationNanos: int64) {.closure.} =
      callTickEndPrev(gPrevTickEnd, tick, durationNanos)
      runDueTasks(int64(tick))
      if entryUsed("on_server_tick_end"):
        discard fireServer("on_server_tick_end", @[], @[("tick", float64(tick)), ("duration_ns", float64(durationNanos))])
  block:
    gPrevPacket = gPluginPacketReceivedHook
    gPluginPacketReceivedHook = proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
      if callPacketPrev(gPrevPacket, player, packetId, payload): return true
      if not entryUsed("on_packet_received"): return false
      fireEngineEv("on_packet_received", player.gameprofile.name, "", @[],
        @[("packet_id", float64(packetId)), ("length", float64(payload.len))], some(player))[0]
  block:
    gPrevRedstone = gPluginBlockRedstoneHook
    gPluginBlockRedstoneHook = proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
      let before = callRedstonePrev(gPrevRedstone, world, stateId, pos, oldCurrent, newCurrent)
      if before[0]: return before
      if not entryUsed("on_block_redstone"): return before
      let o = fireServer("on_block_redstone", @[], @[("x", float64(pos.vec.x)), ("y", float64(pos.vec.y)), ("z", float64(pos.vec.z)),
        ("old_current", float64(oldCurrent)), ("new_current", float64(before[1]))])
      var answer: (bool, int32) = before
      answer[0] = o[0]
      answer

proc passHeal(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.} = (false, amount)
proc passFood(player: Player; level, previous: int): (bool, int) {.closure.} = (false, level)
proc passStat(player: Player; category, statId, amount: int32) {.closure.} = discard
proc passPing(address, motd: string; online, maxPlayers: int): (string, int) {.closure.} = (motd, maxPlayers)
proc passPreLogin(name, address: string): string {.closure.} = ""

var gPrevLevel: proc(player: Player; previous, level: int) {.closure.} = proc(player: Player; previous, level: int) {.closure.} = discard
var gPrevSave: proc() {.closure.} = proc() {.closure.} = discard
var gPrevTime: proc(world: World; previous, time: int64): (bool, int64) {.closure.} =
  proc(world: World; previous, time: int64): (bool, int64) {.closure.} = (false, time)

proc callLevelPrev(prev: proc(player: Player; previous, level: int) {.closure.}; player: Player; previous, level: int) =
  prev(player, previous, level)

proc callSavePrev(prev: proc() {.closure.}) =
  prev()

proc callTimePrev(prev: proc(world: World; previous, time: int64): (bool, int64) {.closure.}; world: World;
    previous, time: int64): (bool, int64) =
  prev(world, previous, time)

var gPrevEffect: proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.} =
  proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.} = (false, duration)

proc callEffectPrev(prev: proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.};
    world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) =
  prev(world, entityId, entityType, effect, duration, amplifier)

var gPrevHeal: proc(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.} = passHeal
var gPrevFood: proc(player: Player; level, previous: int): (bool, int) {.closure.} = passFood
var gPrevStat: proc(player: Player; category, statId, amount: int32) {.closure.} = passStat
var gPrevPing: proc(address, motd: string; online, maxPlayers: int): (string, int) {.closure.} = passPing
var gPrevPreLogin: proc(name, address: string): string {.closure.} = passPreLogin

proc callHealPrev(prev: proc(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.};
    world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) =
  prev(world, entityId, entityType, amount)

proc callFoodPrev(prev: proc(player: Player; level, previous: int): (bool, int) {.closure.}; player: Player; level, previous: int): (bool, int) =
  prev(player, level, previous)

proc callStatPrev(prev: proc(player: Player; category, statId, amount: int32) {.closure.}; player: Player; category, statId, amount: int32) =
  prev(player, category, statId, amount)

proc callPingPrev(prev: proc(address, motd: string; online, maxPlayers: int): (string, int) {.closure.}; address, motd: string;
    online, maxPlayers: int): (string, int) =
  prev(address, motd, online, maxPlayers)

proc callPreLoginPrev(prev: proc(name, address: string): string {.closure.}; name, address: string): string =
  prev(name, address)

proc passDamage(world: World; entityId: int32; entityType: string; amount: float32; damageType: string; attackerId: int32):
    (bool, float32) {.closure.} = (false, amount)
proc passEntityDeath(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.} = discard
proc passEntitySpawn(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.} = discard
proc passEntityRemove(world: World; entityId: int32; entityType: string) {.closure.} = discard
proc passExplosion(world: World; pos: Vector3[float64]; power: float32): bool {.closure.} = false
proc passWeather(world: World; raining, thundering: bool) {.closure.} = discard

var gPrevDamage: proc(world: World; entityId: int32; entityType: string; amount: float32; damageType: string; attackerId: int32):
    (bool, float32) {.closure.} = passDamage
var gPrevEntityDeath: proc(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.} = passEntityDeath
var gPrevEntitySpawn: proc(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.} = passEntitySpawn
var gPrevEntityRemove: proc(world: World; entityId: int32; entityType: string) {.closure.} = passEntityRemove
var gPrevExplosion: proc(world: World; pos: Vector3[float64]; power: float32): bool {.closure.} = passExplosion
var gPrevWeather: proc(world: World; raining, thundering: bool) {.closure.} = passWeather

proc callDamagePrev(prev: proc(world: World; entityId: int32; entityType: string; amount: float32; damageType: string;
    attackerId: int32): (bool, float32) {.closure.}; world: World; entityId: int32; entityType: string; amount: float32;
    damageType: string; attackerId: int32): (bool, float32) =
  prev(world, entityId, entityType, amount, damageType, attackerId)

proc callEntityDeathPrev(prev: proc(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.};
    world: World; entityId: int32; entityType, damageType: string; killerId: int32) =
  prev(world, entityId, entityType, damageType, killerId)

proc callEntitySpawnPrev(prev: proc(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.};
    world: World; entityId: int32; entityType: string; pos: Vector3[float64]) =
  prev(world, entityId, entityType, pos)

proc callEntityRemovePrev(prev: proc(world: World; entityId: int32; entityType: string) {.closure.}; world: World; entityId: int32;
    entityType: string) =
  prev(world, entityId, entityType)

proc callExplosionPrev(prev: proc(world: World; pos: Vector3[float64]; power: float32): bool {.closure.}; world: World;
    pos: Vector3[float64]; power: float32): bool =
  prev(world, pos, power)

proc callWeatherPrev(prev: proc(world: World; raining, thundering: bool) {.closure.}; world: World; raining, thundering: bool) =
  prev(world, raining, thundering)

proc passPlayerEv(player: Player; ev: PlayerEv): (bool, bool) {.closure.} = (false, ev.flag)
proc passChangeWorld(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32)
    {.closure.} = (false, pos, yaw, pitch)
proc passFish(event: var PlayerFishEvent) {.closure.} = discard
proc passEgg(event: var PlayerEggThrowEvent) {.closure.} = discard
proc passClick(event: CustomClickActionEvent) {.closure.} = discard

var gPrevPlayerEv: proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} = passPlayerEv
var gPrevChangeWorld: proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32):
    (bool, Vector3[float64], float32, float32) {.closure.} = passChangeWorld
var gPrevFish: proc(event: var PlayerFishEvent) {.closure.} = passFish
var gPrevEgg: proc(event: var PlayerEggThrowEvent) {.closure.} = passEgg
var gPrevClick: proc(event: CustomClickActionEvent) {.closure.} = passClick

proc callPlayerEvPrev(prev: proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.}; player: Player; ev: PlayerEv): (bool, bool) =
  prev(player, ev)

proc callChangeWorldPrev(prev: proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32):
    (bool, Vector3[float64], float32, float32) {.closure.}; player: Player; previous, next: World; pos: Vector3[float64];
    yaw, pitch: float32): (bool, Vector3[float64], float32, float32) =
  prev(player, previous, next, pos, yaw, pitch)

proc callFishPrev(prev: proc(event: var PlayerFishEvent) {.closure.}; event: var PlayerFishEvent) = prev(event)
proc callEggPrev(prev: proc(event: var PlayerEggThrowEvent) {.closure.}; event: var PlayerEggThrowEvent) = prev(event)
proc callClickPrev(prev: proc(event: CustomClickActionEvent) {.closure.}; event: CustomClickActionEvent) = prev(event)

proc entryOfPlayerEv(kind: PlayerEvKind): string =
  case kind
  of pekSwingArm: "on_player_swing"
  of pekUseItem: "on_player_use_item"
  of pekInteractEntity, pekInteractUnknownEntity: "on_player_interact_entity"
  of pekCustomPayload: "on_player_custom_payload"
  of pekChangedMainHand: "on_player_main_hand_change"
  of pekInventoryClose: "on_inventory_close"
  of pekInventoryClick: "on_inventory_click"
  of pekBlockBreak: "on_block_break"
  of pekDropItem: "on_player_drop_item"
  of pekItemPickup: "on_player_pickup_item"
  of pekItemConsume: "on_player_item_consume"
  of pekBedEnter: "on_player_bed_enter"
  of pekBedLeave: "on_player_bed_leave"
  of pekSignChange: "on_sign_change"
  of pekBucketEmpty: "on_bucket_empty"
  of pekBucketFill: "on_bucket_fill"
  of pekPermissionCheck: "on_permission_check"
  of pekSwapHands: "on_player_swap_hands"
  of pekInventoryOpen: "on_inventory_open"

proc playerEvFields(ev: PlayerEv; strs: var seq[(string, string)]; nums: var seq[(string, float64)]) =
  ## What each `PlayerEv` kind carries, as the named fields a plugin reads.
  case ev.kind
  of pekInteractEntity, pekInteractUnknownEntity:
    nums.add ("entity_id", float64(ev.n))
    nums.add ("action", float64(ev.n2))
    nums.add ("sneaking", (if ev.flag: 1.0 else: 0.0))
    nums.add ("known", (if ev.kind == pekInteractEntity: 1.0 else: 0.0))
  of pekCustomPayload:
    strs.add ("channel", ev.text)
    nums.add ("length", float64(ev.data.len))
  of pekChangedMainHand:
    nums.add ("hand", float64(ev.n))
  of pekInventoryClose, pekInventoryOpen:
    nums.add ("window", float64(ev.n))
  of pekInventoryClick:
    nums.add ("window", float64(ev.n))
    nums.add ("click_type", float64(ev.n2))
    nums.add ("slot", float64(ev.n3))
    nums.add ("raw_slot", float64(ev.n4))
    nums.add ("hotbar_button", float64(ev.n5))
  of pekBlockBreak:
    strs.add ("block", ev.text)
    nums.add ("x", float64(ev.pos.vec.x))
    nums.add ("y", float64(ev.pos.vec.y))
    nums.add ("z", float64(ev.pos.vec.z))
  of pekDropItem:
    strs.add ("item", ev.text)
    nums.add ("count", float64(ev.n))
  of pekItemPickup:
    strs.add ("item", ev.text)
    nums.add ("count", float64(ev.n))
    nums.add ("entity_id", float64(ev.n2))
  of pekItemConsume:
    strs.add ("item", ev.text)
  of pekBedEnter, pekBedLeave:
    nums.add ("x", float64(ev.pos.vec.x))
    nums.add ("y", float64(ev.pos.vec.y))
    nums.add ("z", float64(ev.pos.vec.z))
  of pekSignChange:
    nums.add ("x", float64(ev.pos.vec.x))
    nums.add ("y", float64(ev.pos.vec.y))
    nums.add ("z", float64(ev.pos.vec.z))
    for k in 0 ..< ev.lines.len:
      strs.add ("line" & $k, ev.lines[k])
  of pekBucketEmpty, pekBucketFill:
    strs.add ("bucket", ev.text)
    nums.add ("x", float64(ev.pos.vec.x))
    nums.add ("y", float64(ev.pos.vec.y))
    nums.add ("z", float64(ev.pos.vec.z))
  of pekPermissionCheck:
    strs.add ("node", ev.text)
  else:
    discard

proc passExp(player: Player; amount: int32): int32 {.closure.} = amount
proc passRespawn(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} = discard

var gPrevExp: proc(player: Player; amount: int32): int32 {.closure.} = passExp
var gPrevRespawn: proc(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} =
  passRespawn

proc callExpPrevE(prev: proc(player: Player; amount: int32): int32 {.closure.}; player: Player; amount: int32): int32 =
  prev(player, amount)

proc callRespawnPrevE(prev: proc(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32;
    alive: bool) {.closure.}; player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) =
  prev(player, previous, respawned, pos, yaw, pitch, alive)

proc fireEnginePlayerDeath*(player: Player; message: string) =
  ## `on_player_death`: the death message is `hostv("event_str", "message")`.
  discard fireEngineEv("on_player_death", player.gameprofile.name, message, @[], @[], some(player))

proc installEngineMiscHooks*() =
  ## The experience and respawn events (the death event is fired by `fireEnginePlayerDeath`, which pluginmgr.aowl calls).
  gPrevExp = gPluginExpChangeHook
  gPluginExpChangeHook = proc(player: Player; amount: int32): int32 {.closure.} =
    let before = callExpPrevE(gPrevExp, player, amount)
    discard fireEngineFields("on_player_exp_change", player, @[], @[("amount", float64(before))])
    before
  gPrevRespawn = gPluginRespawnHook
  gPluginRespawnHook = proc(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} =
    callRespawnPrevE(gPrevRespawn, player, previous, respawned, pos, yaw, pitch, alive)
    discard fireEngineFields("on_player_respawn", player, @[], @[("x", pos.x), ("y", pos.y), ("z", pos.z), ("alive", (if alive: 1.0 else: 0.0))])
  # the generic player events (swing, use item, interact entity, inventory, block break, drop, pickup, consume, bed, sign, bucket,
  # permission check ...): one hook, each kind its own entry, offered only while a plugin listens
  gPrevPlayerEv = gPluginPlayerEventHook
  gPluginPlayerEventHook = proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} =
    let before = callPlayerEvPrev(gPrevPlayerEv, player, ev)
    if before[0]: return before
    let entry = entryOfPlayerEv(ev.kind)
    if not listened(entry): return before
    var strs: seq[(string, string)] = @[]
    var nums: seq[(string, float64)] = @[]
    playerEvFields(ev, strs, nums)
    nums.add ("flag", (if before[1]: 1.0 else: 0.0))
    gEvFlag = before[1]
    let o = fireEngineFields(entry, player, strs, nums)
    (o[0], gEvFlag)
  gPrevChangeWorld = gPluginChangeWorldHook
  gPluginChangeWorldHook = proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32):
      (bool, Vector3[float64], float32, float32) {.closure.} =
    let before = callChangeWorldPrev(gPrevChangeWorld, player, previous, next, pos, yaw, pitch)
    if before[0]: return before
    if not listened("on_player_change_world"): return before
    let o = fireEngineFields("on_player_change_world", player, @[], @[("x", pos.x), ("y", pos.y), ("z", pos.z), ("yaw", float64(yaw)), ("pitch", float64(pitch))])
    var answer: (bool, Vector3[float64], float32, float32) = before
    answer[0] = o[0]
    answer
  gPrevFish = gFishHook
  gFishHook = proc(event: var PlayerFishEvent) {.closure.} =
    callFishPrev(gPrevFish, event)
    if event.cancelled or not listened("on_player_fish"): return
    let o = fireEngineFields("on_player_fish", event.player, @[("caught", event.caughtType)],
      @[("state", float64(ord(event.state))), ("exp", float64(event.expToDrop))])
    if o[0]: event.cancelled = true
  gPrevEgg = gEggThrowHook
  gEggThrowHook = proc(event: var PlayerEggThrowEvent) {.closure.} =
    callEggPrev(gPrevEgg, event)
    if event.cancelled or not listened("on_player_egg_throw"): return
    gEvFlag = event.hatching
    let o = fireEngineFields("on_player_egg_throw", event.player, @[("hatching_type", event.hatchingType)],
      @[("num_hatches", float64(event.numHatches)), ("hatching", (if event.hatching: 1.0 else: 0.0))])
    event.hatching = gEvFlag
    if o[0]: event.cancelled = true
  # entities, explosions and weather
  gPrevDamage = gPluginEntityDamageHook
  gPluginEntityDamageHook = proc(world: World; entityId: int32; entityType: string; amount: float32; damageType: string;
      attackerId: int32): (bool, float32) {.closure.} =
    let before = callDamagePrev(gPrevDamage, world, entityId, entityType, amount, damageType, attackerId)
    if before[0]: return before
    if not listened("on_entity_damage"): return before
    gEvValue = float64(before[1])
    let o = fireEngineEv("on_entity_damage", "", "", @[("entity_type", entityType), ("damage_type", damageType)],
      @[("entity_id", float64(entityId)), ("amount", float64(before[1])), ("attacker_id", float64(attackerId))], none[Player]())
    (o[0], float32(gEvValue))
  gPrevEntityDeath = gPluginEntityDeathHook
  gPluginEntityDeathHook = proc(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.} =
    callEntityDeathPrev(gPrevEntityDeath, world, entityId, entityType, damageType, killerId)
    if listened("on_entity_death"):
      discard fireEngineEv("on_entity_death", "", "", @[("entity_type", entityType), ("damage_type", damageType)],
        @[("entity_id", float64(entityId)), ("killer_id", float64(killerId))], none[Player]())
  gPrevEntitySpawn = gPluginEntitySpawnHook
  gPluginEntitySpawnHook = proc(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.} =
    callEntitySpawnPrev(gPrevEntitySpawn, world, entityId, entityType, pos)
    if listened("on_entity_spawn"):
      discard fireEngineEv("on_entity_spawn", "", "", @[("entity_type", entityType)],
        @[("entity_id", float64(entityId)), ("x", pos.x), ("y", pos.y), ("z", pos.z)], none[Player]())
  gPrevEntityRemove = gPluginEntityRemoveHook
  gPluginEntityRemoveHook = proc(world: World; entityId: int32; entityType: string) {.closure.} =
    callEntityRemovePrev(gPrevEntityRemove, world, entityId, entityType)
    if listened("on_entity_remove"):
      discard fireEngineEv("on_entity_remove", "", "", @[("entity_type", entityType)], @[("entity_id", float64(entityId))], none[Player]())
  gPrevExplosion = gPluginExplosionHook
  gPluginExplosionHook = proc(world: World; pos: Vector3[float64]; power: float32): bool {.closure.} =
    if callExplosionPrev(gPrevExplosion, world, pos, power): return true
    if not listened("on_explosion"): return false
    fireEngineEv("on_explosion", "", "", @[], @[("x", pos.x), ("y", pos.y), ("z", pos.z), ("power", float64(power))], none[Player]())[0]
  gPrevWeather = gPluginWeatherHook
  gPluginWeatherHook = proc(world: World; raining, thundering: bool) {.closure.} =
    callWeatherPrev(gPrevWeather, world, raining, thundering)
    if listened("on_weather_change"):
      discard fireEngineEv("on_weather_change", "", "", @[],
        @[("raining", (if raining: 1.0 else: 0.0)), ("thundering", (if thundering: 1.0 else: 0.0))], none[Player]())
  # health, hunger, statistics, the server list and the login
  gPrevHeal = gPluginEntityHealHook
  gPluginEntityHealHook = proc(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.} =
    let before = callHealPrev(gPrevHeal, world, entityId, entityType, amount)
    if before[0]: return before
    if not listened("on_entity_heal"): return before
    gEvValue = float64(before[1])
    let o = fireEngineEv("on_entity_heal", "", "", @[("entity_type", entityType)],
      @[("entity_id", float64(entityId)), ("amount", float64(before[1]))], none[Player]())
    (o[0], float32(gEvValue))
  gPrevFood = gPluginFoodLevelHook
  gPluginFoodLevelHook = proc(player: Player; level, previous: int): (bool, int) {.closure.} =
    let before = callFoodPrev(gPrevFood, player, level, previous)
    if before[0]: return before
    if not listened("on_player_food_change"): return before
    gEvValue = float64(before[1])
    let o = fireEngineFields("on_player_food_change", player, @[], @[("level", float64(before[1])), ("previous", float64(previous))])
    (o[0], int(gEvValue))
  gPrevStat = gPluginStatHook
  gPluginStatHook = proc(player: Player; category, statId, amount: int32) {.closure.} =
    callStatPrev(gPrevStat, player, category, statId, amount)
    if listened("on_player_statistic"):
      discard fireEngineFields("on_player_statistic", player, @[],
        @[("category", float64(category)), ("stat_id", float64(statId)), ("amount", float64(amount))])
  gPrevPing = gPluginServerListPingHook
  gPluginServerListPingHook = proc(address, motd: string; online, maxPlayers: int): (string, int) {.closure.} =
    let before = callPingPrev(gPrevPing, address, motd, online, maxPlayers)
    if not listened("on_server_list_ping"): return before
    gEvValue = float64(before[1])
    let o = fireEngineEv("on_server_list_ping", "", before[0], @[("address", address)],
      @[("online", float64(online)), ("max", float64(before[1]))], none[Player]())
    (o[1], int(gEvValue))
  gPrevEffect = gPluginEffectHook
  gPluginEffectHook = proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.} =
    let before = callEffectPrev(gPrevEffect, world, entityId, entityType, effect, duration, amplifier)
    if before[0]: return before
    if not listened("on_entity_potion_effect"): return before
    gEvValue = float64(before[1])
    let o = fireEngineEv("on_entity_potion_effect", "", "", @[("entity_type", entityType), ("effect", effect)],
      @[("entity_id", float64(entityId)), ("duration", float64(before[1])), ("amplifier", float64(amplifier))], none[Player]())
    (o[0], int(gEvValue))
  gPrevLevel = gPluginLevelChangeHook
  gPluginLevelChangeHook = proc(player: Player; previous, level: int) {.closure.} =
    callLevelPrev(gPrevLevel, player, previous, level)
    if listened("on_player_level_change"):
      discard fireEngineFields("on_player_level_change", player, @[], @[("previous", float64(previous)), ("level", float64(level))])
  gPrevSave = gPluginSaveHook
  gPluginSaveHook = proc() {.closure.} =
    callSavePrev(gPrevSave)
    if listened("on_world_save"):
      discard fireEngineEv("on_world_save", "", "", @[], @[], none[Player]())
  gPrevTime = gPluginTimeSetHook
  gPluginTimeSetHook = proc(world: World; previous, time: int64): (bool, int64) {.closure.} =
    let before = callTimePrev(gPrevTime, world, previous, time)
    if before[0]: return before
    if not listened("on_time_set"): return before
    gEvValue = float64(before[1])
    let o = fireEngineEv("on_time_set", "", "", @[], @[("previous", float64(previous)), ("time", float64(before[1]))], none[Player]())
    (o[0], int64(gEvValue))
  gPrevPreLogin = gPluginPreLoginHook
  gPluginPreLoginHook = proc(name, address: string): string {.closure.} =
    let before = callPreLoginPrev(gPrevPreLogin, name, address)
    if before.len > 0: return before
    if not listened("on_player_pre_login"): return ""
    let o = fireEngineEv("on_player_pre_login", name, "You are not allowed to join this server.", @[("address", address)], @[],
      none[Player]())
    if o[0]: o[1] else: ""
  gPrevClick = gCustomClickActionHook
  gCustomClickActionHook = proc(event: CustomClickActionEvent) {.closure.} =
    callClickPrev(gPrevClick, event)
    if not listened("on_custom_click"): return
    var length = 0
    if event.payload.isSome: length = event.payload.unsafeGet.len
    discard fireEngineFields("on_custom_click", event.player, @[("id", event.id)], @[("length", float64(length))])

proc startEnginePlugins*(server: Server) =
  ## The JavaScript plugins in `plugins/` as one program, with the event hooks installed. Does nothing (and never loads the engine)
  ## when there is none. The plugin manager (pluginmanager.aowl) does this and more for the server.
  gEngineServer = some(server)
  if loadEnginePlugins(scanEnginePlugins(PluginsFolder)) == 0: return
  installEngineEventHooks(server)
  installEngineMiscHooks()
