## The server's plugins on the aoughwl engine: `plugins/<name>/main.js` (or `plugins/<name>.js`) are JavaScript programs the engine
## runs. Each is loaded once at start (its `start` entry runs when it has one) and is offered the server's events by name:
## the entry `on_player_chat`, `on_player_command`, `on_player_join` or `on_player_leave` is called when the event fires, and
## the plugin reads and answers the event through host functions: `hostv("event_str", "message")` (also "player" and "event")
## returns a string, `host("event_cancel")`, `hostS("event_set_message", text)`, `hostS("player_message", text)`,
## `hostS("server_log", text)`. Only `hostv` returns strings to JavaScript: `host` and `hostS` answer a number.
## The engine runs one JavaScript program per process, so every plugin is bundled into one program (see `bundleOf`).
## This is the plugin mechanism that replaces the WebAssembly component host; both run side by side until that host is removed.
##
## Plugins are classic scripts for now (no `import`/`export`): a module-style program needs the staged `.interp/` copy the
## engine's node tool writes. Nothing here touches the engine until a plugin exists, so a server with no JS plugins never loads
## aoe_engine.dll.

import std/[syncio, strutils, dirs, paths, options]
import aoe, enginehost
import ../../server/serverbase
import ../../server/entity/player
import ../pluginhooks
import ../../util/text/text
import ../../util/vector3
import ../../util/gamemode
import ../../util/math/position
import ../pluginhooksevents
import ../../data/blocks
import ../../command/cmdsource
import ../../world/chunkdata
import ../../server/net/java/javamod
from "../../server/block/blockbehaviour" import BlockWorld
from ../../data/block_state import BlockStateId

const PluginsFolder = "plugins"

type
  EnginePlugin = object
    name: string
    handle: int32

var
  gPlugins: seq[EnginePlugin] = @[]
  gEngineServer: Option[Server] = none[Server]()
  gCurPlayer: Option[Player] = none[Player]()
  gEvName = ""
  gEvPlayerName = ""
  gEvMessage = ""
  gEvCancelled = false
  gSourceText = ""                         ## the plugins' own sources, to see which entries any plugin defines
  gEvStrs: seq[(string, string)] = @[]     ## the current event's extra string fields, read with hostv("event_str", key)
  gEvNums: seq[(string, float64)] = @[]    ## its numeric fields, read with hostv("event_num", key)

proc textArg(args: seq[HostArg]; k: int): string =
  if k < args.len: args[k].s else: ""

var
  gLogLines: seq[string] = @[]   ## everything the plugins have logged, for tests
  gLogPending: seq[string] = @[] ## logged during the current call, printed once it returns

proc pluginLogLines*(): seq[string] = gLogLines

proc flushPluginLog() =
  ## The engine captures the process's output while a plugin runs, so a line printed from inside a host call never shows; the host
  ## function buffers it and the caller prints it after the engine call has returned.
  for line in gLogPending: echo "[plugin] ", line
  gLogPending = @[]

proc hostServerLog(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gLogLines.add textArg(args, 0)
  gLogPending.add textArg(args, 0)
  1

proc hostEventStr(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  let key = textArg(args, 0)
  res.kind = AoeVString
  res.s = (if key == "player": gEvPlayerName elif key == "message": gEvMessage elif key == "event": gEvName else: "")
  for kv in gEvStrs:
    if kv[0] == key: res.s = kv[1]
  1

proc hostEventNum(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  ## A numeric field of the current event (x, y, z, from_x, ..., mode, slot, ...); 0 when the event has none by that name.
  let key = textArg(args, 0)
  res.kind = AoeVNumber
  res.n = 0.0
  for kv in gEvNums:
    if kv[0] == key: res.n = kv[1]
  1

proc hostEventSetMessage(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvMessage = textArg(args, 0)
  1

proc hostEventCancel(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  gEvCancelled = true
  1

proc hostPlayerMessage(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  if gCurPlayer.isSome:
    let target: Player = gCurPlayer.unsafeGet
    target.sendSystemMessage(text(textArg(args, 0)))
  1

proc hostPlayerCount(context: int64; args: seq[HostArg]; res: var HostArg): int32 =
  res.kind = AoeVInt
  res.i = 0
  if gEngineServer.isSome:
    let srv: Server = gEngineServer.unsafeGet
    var total = 0
    for w in srv.worlds: total += w.players.len
    res.i = int64(total)
  1

proc registerServerHost() =
  registerHost("server_log", hostServerLog)
  registerHost("event_str", hostEventStr)
  registerHost("event_num", hostEventNum)
  registerHost("event_set_message", hostEventSetMessage)
  registerHost("event_cancel", hostEventCancel)
  registerHost("player_message", hostPlayerMessage)
  registerHost("server_player_count", hostPlayerCount)

proc slashedPath(p: string): string =
  result = ""
  for c in p:
    result.add (if c == '\\': '/' else: c)

proc lastSlash(s: string): int =
  result = -1
  for k in 0 ..< s.len:
    if s[k] == '/': result = k

proc scanEnginePlugins*(folder: string): seq[(string, string)] =
  ## (name, file) for each `<folder>/<name>/main.js` and `<folder>/<name>.js`.
  result = @[]
  try:
    for kind, entry in walkDir(path(folder)):
      let full = slashedPath($entry)
      if kind == pcFile and full.toLowerAscii.endsWith(".js"):
        var base = full
        let slash = lastSlash(base)
        if slash >= 0: base = base.substr(slash + 1)
        if not base.startsWith("."):   # `.engine-bundle.js` is ours
          result.add (base.substr(0, base.len - 4), full)
      elif kind == pcDir:
        let main = full & "/main.js"
        var found = false
        try:
          for k2, e2 in walkDir(path(full)):
            if k2 == pcFile and slashedPath($e2).toLowerAscii.endsWith("/main.js"): found = true
        except ErrorCode:
          discard
        if found:
          var base = full
          let slash = lastSlash(base)
          if slash >= 0: base = base.substr(slash + 1)
          result.add (base, main)
  except ErrorCode:
    discard

proc fireEngineEv*(entry, playerName, message: string; strs: seq[(string, string)]; nums: seq[(string, float64)];
    player: Option[Player]): (bool, string) =
  ## Offers the event to every plugin that has the entry; (cancelled, the message after the plugins). `strs` and `nums` are the
  ## event's extra fields, which a plugin reads with `hostv("event_str", key)` and `hostv("event_num", key)`.
  gEvName = entry
  gEvPlayerName = playerName
  gEvMessage = message
  gEvStrs = strs
  gEvNums = nums
  gEvCancelled = false
  let outer = gCurPlayer
  gCurPlayer = player
  for p in gPlugins:
    if hasEntry(p.handle, entry):
      if callPlugin(p.handle, entry) < 0:
        echo "[plugin] ", p.name, ": ", entry, " failed: ", engineError()
  gCurPlayer = outer
  flushPluginLog()
  (gEvCancelled, gEvMessage)

proc fireEngineAs*(entry, playerName, message: string; player: Option[Player]): (bool, string) =
  fireEngineEv(entry, playerName, message, @[], @[], player)

proc fireEngine(entry: string; player: Player; message: string): (bool, string) =
  fireEngineAs(entry, player.gameprofile.name, message, some(player))

proc fireEngineFields(entry: string; player: Player; strs: seq[(string, string)]; nums: seq[(string, float64)]): (bool, string) =
  fireEngineEv(entry, player.gameprofile.name, "", strs, nums, some(player))

proc moveNums(fromPos, toPos: Vector3[float64]): seq[(string, float64)] =
  result = @[]
  result.add ("from_x", fromPos.x)
  result.add ("from_y", fromPos.y)
  result.add ("from_z", fromPos.z)
  result.add ("to_x", toPos.x)
  result.add ("to_y", toPos.y)
  result.add ("to_z", toPos.z)

# ---- chaining onto the hooks pluginmgr.aowl installs (a captured closure called inside a closure asserts in hexer, so the
# previous hooks are kept in globals and called through procs that take them as parameters) ----

proc passChat(player: Player; message: string): (bool, string) {.closure.} = (false, message)
proc passText(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = (false, message)

var gPrevChat: proc(player: Player; message: string): (bool, string) {.closure.} = passChat
var gPrevCommand: proc(player: Player; command: string): (bool, string) {.closure.} = passChat
var gPrevJoin: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = passText
var gPrevLeave: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} = passText

proc callChatPrev(prev: proc(player: Player; message: string): (bool, string) {.closure.}; player: Player; message: string): (bool, string) =
  prev(player, message)

proc callCommandPrev(prev: proc(player: Player; command: string): (bool, string) {.closure.}; player: Player; command: string): (bool, string) =
  prev(player, command)

proc callJoinPrev(prev: proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.}; player: Player;
    message: TextComponent): (bool, TextComponent) =
  prev(player, message)

proc passMove(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
proc passToggle(player: Player; kind: int; value: bool): bool {.closure.} = false
proc passMode(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = (false, next)
proc passHeld(player: Player; previous, next: int): bool {.closure.} = false
proc passLogin(player: Player): (bool, TextComponent) {.closure.} = (false, text(""))
proc passInteract(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = false
proc passPlace(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = false

var gPrevMove: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = passMove
var gPrevTeleport: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = passMove
var gPrevToggle: proc(player: Player; kind: int; value: bool): bool {.closure.} = passToggle
var gPrevMode: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = passMode
var gPrevHeld: proc(player: Player; previous, next: int): bool {.closure.} = passHeld
var gPrevLogin: proc(player: Player): (bool, TextComponent) {.closure.} = passLogin
var gPrevInteract: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = passInteract
var gPrevPlace: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = passPlace

proc callMovePrev(prev: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.}; player: Player;
    fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) =
  prev(player, fromPos, toPos)

proc callTogglePrev(prev: proc(player: Player; kind: int; value: bool): bool {.closure.}; player: Player; kind: int; value: bool): bool =
  prev(player, kind, value)

proc callModePrev(prev: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.}; player: Player;
    previous, next: GameMode): (bool, GameMode) =
  prev(player, previous, next)

proc callHeldPrev(prev: proc(player: Player; previous, next: int): bool {.closure.}; player: Player; previous, next: int): bool =
  prev(player, previous, next)

proc callLoginPrev(prev: proc(player: Player): (bool, TextComponent) {.closure.}; player: Player): (bool, TextComponent) =
  prev(player)

proc callInteractPrev(prev: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.}; player: Player; action: int;
    pos: Option[BlockPos]): bool =
  prev(player, action, pos)

proc callPlacePrev(prev: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.}; player: Player;
    placedBlock, clickedBlock: string; position: BlockPos): bool =
  prev(player, placedBlock, clickedBlock, position)

proc passCommand(command: string): bool {.closure.} = false
proc passBroadcast(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = (false, message, sender)
proc passTickStart(tick: int32) {.closure.} = discard
proc passTickEnd(tick: int32; durationNanos: int64) {.closure.} = discard
proc passLoad(reload: bool) {.closure.} = discard
proc passPacket(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
proc passRedstone(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  (false, newCurrent)

var gPrevCommandSrv: proc(command: string): bool {.closure.} = passCommand
var gPrevBroadcast: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = passBroadcast
var gPrevTickStart: proc(tick: int32) {.closure.} = passTickStart
var gPrevTickEnd: proc(tick: int32; durationNanos: int64) {.closure.} = passTickEnd
var gPrevLoad: proc(reload: bool) {.closure.} = passLoad
var gPrevPacket: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = passPacket
var gPrevRedstone: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  passRedstone

proc callCommandSrvPrev(prev: proc(command: string): bool {.closure.}; command: string): bool = prev(command)

proc callBroadcastPrev(prev: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.};
    message, sender: TextComponent): (bool, TextComponent, TextComponent) =
  prev(message, sender)

proc callTickStartPrev(prev: proc(tick: int32) {.closure.}; tick: int32) = prev(tick)
proc callTickEndPrev(prev: proc(tick: int32; durationNanos: int64) {.closure.}; tick: int32; durationNanos: int64) = prev(tick, durationNanos)
proc callLoadPrev(prev: proc(reload: bool) {.closure.}; reload: bool) = prev(reload)

proc callPacketPrev(prev: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.}; player: Player; packetId: int32;
    payload: seq[byte]): bool =
  prev(player, packetId, payload)

proc callRedstonePrev(prev: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.};
    world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) =
  prev(world, stateId, pos, oldCurrent, newCurrent)

proc passSpawn(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} = next
proc passGrow(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.} = (false, newState)
proc passChunk(client: JavaClient; chunk: ChunkData): bool {.closure.} = false

var gPrevSpawn: proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} = passSpawn
var gPrevGrow: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.} = passGrow
var gPrevChunk: proc(client: JavaClient; chunk: ChunkData): bool {.closure.} = passChunk

proc callSpawnPrev(prev: proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.}; world: CommandWorld;
    previous, next: CmdSpawn): CmdSpawn =
  prev(world, previous, next)

proc callGrowPrev(prev: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
    pos: BlockPos): (bool, BlockStateId) {.closure.}; world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
    newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) =
  prev(world, oldBlock, oldState, newBlock, newState, pos)

proc callChunkPrev(prev: proc(client: JavaClient; chunk: ChunkData): bool {.closure.}; client: JavaClient; chunk: ChunkData): bool =
  prev(client, chunk)

proc entryUsed(name: string): bool =
  ## True when some plugin's source mentions the entry; the hot hooks (tick, packet, redstone) are installed only then.
  gSourceText.find(name) >= 0

proc fireServer(entry: string; strs: seq[(string, string)]; nums: seq[(string, float64)]): (bool, string) =
  fireEngineEv(entry, "", "", strs, nums, none[Player]())

const EntryNames = ["start", "stop", "on_player_chat", "on_player_command", "on_player_join", "on_player_leave",
  "on_player_move", "on_player_teleport", "on_player_toggle", "on_player_gamemode_change", "on_player_item_held",
  "on_player_login", "on_player_interact", "on_block_place", "on_server_command", "on_server_broadcast", "on_server_tick_start",
  "on_server_tick_end", "on_server_load", "on_packet_received", "on_block_redstone", "on_spawn_change", "on_block_grow", "on_chunk_send"]

proc jsString(s: string): string =
  ## A double-quoted JavaScript string literal.
  result = "\""
  for c in s:
    if c == '"': result.add "\\\""
    elif c == '\\': result.add "\\\\"
    elif c == '\n': result.add "\\n"
    elif c == '\r': discard
    else: result.add c
  result.add "\""

proc readText(file: string): string =
  try:
    result = readFile(file)
  except:
    result = ""

proc stripModuleSyntax(src: string): string =
  ## A plugin may be written module-style. Everything in the bundle shares one program and reaches the server through the global
  ## `host`/`hostS`/`hostv`, so a module needs only its syntax removed: a one-line `import ... ;` is dropped, `export default ` and
  ## `export ` before a declaration are dropped, and a one-line `export { ... };` is dropped. (A multi-line import or export list
  ## is left alone and will fail to load, which the loader reports.)
  result = ""
  let lines = src.splitLines()
  for k in 0 ..< lines.len:
    var line = lines[k]
    if line.startsWith("import ") and (line.find(" from ") >= 0 or line.find("\"") >= 0):
      line = ""
    elif line.startsWith("export {"):
      line = ""
    elif line.startsWith("export default "):
      line = line.substr(len("export default "))
    elif line.startsWith("export "):
      line = line.substr(len("export "))
    result.add line
    result.add "\n"

proc bundleOf(found: seq[(string, string)]): string =
  ## The engine runs one JavaScript program per process, so the plugins are bundled into one: each source in its own function
  ## scope (its `start`, `stop` and `on_player_*` functions are collected, nothing leaks between plugins), and the program's own
  ## entry points call each plugin's, a throw in one plugin logged and not passed on.
  result = "var __aoeP = [];\n"
  for (name, file) in found:
    result.add "(function () {\n"
    # the entry names are declared local first: without that, `typeof start` in a plugin that has no `start` finds the program's own
    # global `start` (the dispatcher below), which would then call itself
    result.add "var "
    for k in 0 ..< EntryNames.len:
      if k > 0: result.add ", "
      result.add EntryNames[k]
    result.add ";\n"
    result.add stripModuleSyntax(readText(file))
    result.add "\n;var __h = {};\n"
    for e in EntryNames:
      result.add "if (typeof " & e & " === \"function\") __h." & e & " = " & e & ";\n"
    result.add "__aoeP.push({ name: " & jsString(name) & ", h: __h });\n})();\n"
  for e in EntryNames:
    result.add "function " & e & "() {\n"
    result.add "  for (var i = 0; i < __aoeP.length; i++) {\n"
    result.add "    var p = __aoeP[i];\n"
    result.add "    if (p.h." & e & ") { try { p.h." & e & "(); } catch (x) { hostS(\"server_log\", p.name + \": " & e & " threw: \" + String(x)); } }\n"
    result.add "  }\n}\n"

proc loadEnginePlugins*(found: seq[(string, string)]; bundleFile: string = "plugins/.engine-bundle.js"): int =
  ## Starts the engine (only when there is something to load), loads the plugins as one bundled program and runs their `start`
  ## entries. The number of plugins in it.
  if found.len == 0: return 0
  if not engineInit():
    echo "[plugin] the engine could not start (is aoe_engine.dll on the DLL path?): ", engineError()
    return 0
  registerServerHost()
  gSourceText = ""
  for (name, file) in found:
    gSourceText.add readText(file)
    gSourceText.add "\n"
  try:
    writeFile(bundleFile, bundleOf(found))
  except:
    echo "[plugin] could not write ", bundleFile
    return 0
  let h = loadPlugin(bundleFile, 0)
  if h < 0:
    echo "[plugin] could not load the plugin bundle: ", engineError()
    return 0
  gPlugins.add EnginePlugin(name: "bundle", handle: h)
  var names = ""
  for (name, file) in found:
    if names.len > 0: names.add ", "
    names.add name
  echo "[plugin] loaded ", found.len, " engine plugin(s): ", names, " (", pluginMode(h), ")"
  if callPlugin(h, "start") < 0:
    echo "[plugin] start failed: ", engineError()
  flushPluginLog()
  found.len

proc startEnginePlugins*(server: Server) =
  ## Loads the JavaScript plugins in `plugins/` and chains the engine onto the chat, command, join and leave hooks. Does nothing
  ## (and never loads the engine) when there is no JavaScript plugin.
  gEngineServer = some(server)
  if loadEnginePlugins(scanEnginePlugins(PluginsFolder)) == 0: return
  gPrevChat = gPluginChatHook
  gPluginChatHook = proc(player: Player; message: string): (bool, string) {.closure.} =
    let before = callChatPrev(gPrevChat, player, message)
    if before[0]: return before
    fireEngine("on_player_chat", player, before[1])
  gPrevCommand = gPluginCommandHook
  gPluginCommandHook = proc(player: Player; command: string): (bool, string) {.closure.} =
    let before = callCommandPrev(gPrevCommand, player, command)
    if before[0]: return before
    fireEngine("on_player_command", player, before[1])
  gPrevJoin = gPluginJoinHook
  gPluginJoinHook = proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} =
    let before = callJoinPrev(gPrevJoin, player, message)
    if before[0]: return before
    let o = fireEngine("on_player_join", player, "")
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    answer
  gPrevLeave = gPluginLeaveHook
  gPluginLeaveHook = proc(player: Player; message: TextComponent): (bool, TextComponent) {.closure.} =
    let before = callJoinPrev(gPrevLeave, player, message)
    if before[0]: return before
    let o = fireEngine("on_player_leave", player, "")
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    answer
  # movement and state: the cancel is honoured, a plugin cannot change the destination or the value
  gPrevMove = gPluginMoveHook
  gPluginMoveHook = proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
    let before = callMovePrev(gPrevMove, player, fromPos, toPos)
    if before[0]: return before
    let o = fireEngineFields("on_player_move", player, @[], moveNums(fromPos, before[1]))
    var answer: (bool, Vector3[float64]) = before
    answer[0] = o[0]
    answer
  gPrevTeleport = gPluginTeleportHook
  gPluginTeleportHook = proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
    let before = callMovePrev(gPrevTeleport, player, fromPos, toPos)
    if before[0]: return before
    let o = fireEngineFields("on_player_teleport", player, @[], moveNums(fromPos, before[1]))
    var answer: (bool, Vector3[float64]) = before
    answer[0] = o[0]
    answer
  gPrevToggle = gPluginToggleHook
  gPluginToggleHook = proc(player: Player; kind: int; value: bool): bool {.closure.} =
    if callTogglePrev(gPrevToggle, player, kind, value): return true
    fireEngineFields("on_player_toggle", player, @[], @[("kind", float64(kind)), ("value", (if value: 1.0 else: 0.0))])[0]
  gPrevMode = gPluginGameModeHook
  gPluginGameModeHook = proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} =
    let before = callModePrev(gPrevMode, player, previous, next)
    if before[0]: return before
    let o = fireEngineFields("on_player_gamemode_change", player, @[], @[("previous", float64(ord(previous))), ("next", float64(ord(before[1])))])
    var answer: (bool, GameMode) = before
    answer[0] = o[0]
    answer
  gPrevHeld = gPluginItemHeldHook
  gPluginItemHeldHook = proc(player: Player; previous, next: int): bool {.closure.} =
    if callHeldPrev(gPrevHeld, player, previous, next): return true
    fireEngineFields("on_player_item_held", player, @[], @[("previous", float64(previous)), ("next", float64(next))])[0]
  gPrevLogin = gPluginLoginHook
  gPluginLoginHook = proc(player: Player): (bool, TextComponent) {.closure.} =
    let before = callLoginPrev(gPrevLogin, player)
    if before[0]: return before
    let o = fireEngineFields("on_player_login", player, @[], @[])
    var answer: (bool, TextComponent) = before
    answer[0] = o[0]
    if o[0] and o[1].len > 0: answer[1] = text(o[1])   # a plugin that set a message gives the kick reason
    answer
  gPrevInteract = gPluginInteractHook
  gPluginInteractHook = proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
    if callInteractPrev(gPrevInteract, player, action, pos): return true
    var nums: seq[(string, float64)] = @[("action", float64(action))]
    if pos.isSome:
      let at: BlockPos = pos.unsafeGet
      nums.add ("x", float64(at.vec.x))
      nums.add ("y", float64(at.vec.y))
      nums.add ("z", float64(at.vec.z))
    fireEngineFields("on_player_interact", player, @[], nums)[0]
  gPrevPlace = gPluginBlockPlaceHook
  gPluginBlockPlaceHook = proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} =
    if callPlacePrev(gPrevPlace, player, placedBlock, clickedBlock, position): return true
    fireEngineFields("on_block_place", player, @[("placed", placedBlock), ("clicked", clickedBlock)],
      @[("x", float64(position.vec.x)), ("y", float64(position.vec.y)), ("z", float64(position.vec.z))])[0]
  # server events
  gPrevCommandSrv = gPluginServerCommandHook
  gPluginServerCommandHook = proc(command: string): bool {.closure.} =
    if callCommandSrvPrev(gPrevCommandSrv, command): return true
    fireServer("on_server_command", @[("command", command)], @[])[0]
  gPrevBroadcast = gPluginServerBroadcastHook
  gPluginServerBroadcastHook = proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} =
    let before = callBroadcastPrev(gPrevBroadcast, message, sender)
    if before[0]: return before
    let o = fireServer("on_server_broadcast", @[("message", before[1].getText), ("sender", before[2].getText)], @[])
    var answer: (bool, TextComponent, TextComponent) = before
    answer[0] = o[0]
    answer
  gPrevLoad = gPluginServerLoadHook
  gPluginServerLoadHook = proc(reload: bool) {.closure.} =
    callLoadPrev(gPrevLoad, reload)
    discard fireServer("on_server_load", @[], @[("reload", (if reload: 1.0 else: 0.0))])
  # `/setworldspawn`: SpawnChangeEvent is not cancellable and a plugin cannot move the spawn here, it only sees the change
  let commandServer = server.commandServer
  if commandServer != nil:
    gPrevSpawn = commandServer.fireSpawnChange
    commandServer.fireSpawnChange = proc(world: CommandWorld; previous, next: CmdSpawn): CmdSpawn {.closure.} =
      let result0 = callSpawnPrev(gPrevSpawn, world, previous, next)
      discard fireServer("on_spawn_change", @[],
        @[("previous_x", float64(previous.x)), ("previous_y", float64(previous.y)), ("previous_z", float64(previous.z)),
          ("next_x", float64(result0.x)), ("next_y", float64(result0.y)), ("next_z", float64(result0.z)),
          ("yaw", float64(result0.yaw)), ("pitch", float64(result0.pitch))])
      result0
  if entryUsed("on_block_grow"):
    gPrevGrow = gPluginBlockGrowHook
    gPluginBlockGrowHook = proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
        pos: BlockPos): (bool, BlockStateId) {.closure.} =
      let before = callGrowPrev(gPrevGrow, world, oldBlock, oldState, newBlock, newState, pos)
      if before[0]: return before
      let o = fireServer("on_block_grow", @[("old_block", "minecraft:" & oldBlock.name), ("new_block", "minecraft:" & newBlock.name)],
        @[("x", float64(pos.vec.x)), ("y", float64(pos.vec.y)), ("z", float64(pos.vec.z))])
      var answer: (bool, BlockStateId) = before
      answer[0] = o[0]
      answer
  if entryUsed("on_chunk_send"):
    gPrevChunk = gChunkSendHook
    gChunkSendHook = proc(client: JavaClient; chunk: ChunkData): bool {.closure.} =
      if callChunkPrev(gPrevChunk, client, chunk): return true
      var owner: Option[Player] = none[Player]()
      for w in server.worlds:
        for p in w.players:
          if p.client == client: owner = some(p)
      if owner.isNone: return false
      let who: Player = owner.unsafeGet
      fireEngineEv("on_chunk_send", who.gameprofile.name, "", @[], @[("x", float64(chunk.x)), ("z", float64(chunk.z))], owner)[0]
  # hot hooks: installed only when a plugin defines the entry
  if entryUsed("on_server_tick_start"):
    gPrevTickStart = gPluginTickStartHook
    gPluginTickStartHook = proc(tick: int32) {.closure.} =
      callTickStartPrev(gPrevTickStart, tick)
      discard fireServer("on_server_tick_start", @[], @[("tick", float64(tick))])
  if entryUsed("on_server_tick_end"):
    gPrevTickEnd = gPluginTickEndHook
    gPluginTickEndHook = proc(tick: int32; durationNanos: int64) {.closure.} =
      callTickEndPrev(gPrevTickEnd, tick, durationNanos)
      discard fireServer("on_server_tick_end", @[], @[("tick", float64(tick)), ("duration_ns", float64(durationNanos))])
  if entryUsed("on_packet_received"):
    gPrevPacket = gPluginPacketReceivedHook
    gPluginPacketReceivedHook = proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
      if callPacketPrev(gPrevPacket, player, packetId, payload): return true
      fireEngineEv("on_packet_received", player.gameprofile.name, "", @[],
        @[("packet_id", float64(packetId)), ("length", float64(payload.len))], some(player))[0]
  if entryUsed("on_block_redstone"):
    gPrevRedstone = gPluginBlockRedstoneHook
    gPluginBlockRedstoneHook = proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
      let before = callRedstonePrev(gPrevRedstone, world, stateId, pos, oldCurrent, newCurrent)
      if before[0]: return before
      let o = fireServer("on_block_redstone", @[], @[("x", float64(pos.vec.x)), ("y", float64(pos.vec.y)), ("z", float64(pos.vec.z)),
        ("old_current", float64(oldCurrent)), ("new_current", float64(before[1]))])
      var answer: (bool, int32) = before
      answer[0] = o[0]
      answer
