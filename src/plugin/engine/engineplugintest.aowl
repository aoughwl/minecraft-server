## Test for engineplugins.aowl: two JavaScript plugins (one a folder with main.js, one a bare file) are found, loaded and offered
## chat, command, join and leave events; a plugin cancels one chat message, rewrites another, and the order of plugins holds.
## Needs aoe_engine.dll on PATH.

import std/[assertions, syncio, strutils, dirs, paths, options]
import engineplugins
import ../../server/serverbase

proc put(file, content: string) =
  try:
    writeFile(file, content)
  except:
    quit "could not write " & file

proc run(): int =
  let nl = "\n"
  let folder = "engineplugintest_plugins"
  try:
    createDir(path(folder))
    createDir(path(folder & "/filter"))
  except:
    quit "could not create the test folder"
  put(folder & "/filter/main.js",
    "function start() { hostS(\"server_log\", \"filter loaded\"); }" & nl &
    "function on_player_chat() {" & nl &
    "  var m = hostv(\"event_str\", \"message\");" & nl &
    "  if (m.indexOf(\"spam\") >= 0) { host(\"event_cancel\"); return; }" & nl &
    "  hostS(\"event_set_message\", m.toUpperCase());" & nl &
    "}" & nl &
    "function on_player_join() { host(\"event_cancel\"); }" & nl)
  put(folder & "/tagger.js",
    "function on_player_chat() {" & nl &
    "  hostS(\"event_set_message\", hostv(\"event_str\", \"player\") + \": \" + hostv(\"event_str\", \"message\"));" & nl &
    "}" & nl &
    "function on_player_command() { hostS(\"server_log\", \"command \" + hostv(\"event_str\", \"message\")); }" & nl)

  let found = scanEnginePlugins(folder)
  assert found.len == 2, $found.len
  assert loadEnginePlugins(found, folder & "/.engine-bundle.js") == 2

  assert pluginLogLines().len >= 1 and pluginLogLines()[0] == "filter loaded", "start ran and logged: " & $pluginLogLines().len

  let ok = fireEngineAs("on_player_chat", "Steve", "hello", none[Player]())
  assert not ok[0]
  # plugins run in discovery order; both rewrite, so the message carries the effect of each
  let low = ok[1].toLowerAscii
  assert low.find("hello") >= 0 and low.find("steve") >= 0, ok[1]

  let spam = fireEngineAs("on_player_chat", "Steve", "buy spam now", none[Player]())
  assert spam[0], "the filter cancels spam"

  let cmd = fireEngineAs("on_player_command", "Steve", "gamemode creative", none[Player]())
  assert not cmd[0]
  assert pluginLogLines().len >= 2 and pluginLogLines()[1] == "command gamemode creative", "the command entry logged"
  let joined = fireEngineAs("on_player_join", "Steve", "", none[Player]())
  assert joined[0], "the filter cancels the join"
  let left = fireEngineAs("on_player_leave", "Steve", "", none[Player]())
  assert not left[0], "no plugin has on_player_leave"
  echo "engineplugintest ok: ", ok[1]
  0

quit(run())
