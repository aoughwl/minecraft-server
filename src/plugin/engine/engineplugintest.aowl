## Test for engineplugins.aowl: two JavaScript plugins (one a folder with main.js, one a bare file) are found, loaded and offered
## chat, command, join and leave events; a plugin cancels one chat message, rewrites another, and the order of plugins holds.
## Needs aoe_engine.dll on PATH.

import std/[assertions, syncio, strutils, dirs, paths, options]
import engineplugins
import ../../server/serverbase

proc put(file, content: string) =
  try:
    writeFile(file, content)
  except:
    quit "could not write " & file

proc hasLog(want: string): bool =
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: return true
  false

proc run(): int =
  let nl = "\n"
  let folder = "engineplugintest_plugins"
  try:
    createDir(path(folder))
    createDir(path(folder & "/filter"))
  except:
    quit "could not create the test folder"
  put(folder & "/filter/main.js",
    "function start() { hostS(\"server_log\", \"filter loaded\"); }" & nl &
    "function on_player_chat() {" & nl &
    "  var m = hostv(\"event_str\", \"message\");" & nl &
    "  if (m.indexOf(\"spam\") >= 0) { host(\"event_cancel\"); return; }" & nl &
    "  hostS(\"event_set_message\", m.toUpperCase());" & nl &
    "}" & nl &
    "function on_player_join() { host(\"event_cancel\"); }" & nl &
    "function on_player_move() { if (hostv(\"event_num\", \"to_x\") > 100) host(\"event_cancel\"); }" & nl &
    "function on_block_grow() { if (hostv(\"event_str\", \"new_block\") == \"minecraft:cactus\") host(\"event_cancel\"); }" & nl &
    "function on_spawn_change() { hostS(\"server_log\", \"spawn \" + hostv(\"event_num\", \"next_x\")); }" & nl &
    "function on_server_command() { if (hostv(\"event_str\", \"command\") == \"stop\") host(\"event_cancel\"); }" & nl &
    "function on_block_place() { if (hostv(\"event_str\", \"placed\") == \"minecraft:bedrock\") host(\"event_cancel\"); }" & nl)
  put(folder & "/tagger.js",
    "function on_player_chat() {" & nl &
    "  hostS(\"event_set_message\", hostv(\"event_str\", \"player\") + \": \" + hostv(\"event_str\", \"message\"));" & nl &
    "}" & nl &
    "function on_player_command() { hostS(\"server_log\", \"command \" + hostv(\"event_str\", \"message\")); }" & nl)

  put(folder & "/modstyle.js",
    "import { x } from \"server\";" & nl &
    "export const unused = 1;" & nl &
    "export function start() { hostS(\"server_log\", \"module loaded\"); }" & nl &
    "export function on_player_command() { hostS(\"server_log\", \"module saw \" + hostv(\"event_str\", \"message\")); }" & nl)

  put(folder & "/sched.js",
    "var repeats = 0;" & nl &
    "function start() {" & nl &
    "  hostv(\"schedule_after\", 3);" & nl &
    "  hostv(\"schedule_repeat\", 2);" & nl &
    "  hostS(\"server_log\", \"online \" + hostv(\"player_online\", \"Nobody\"));" & nl &
    "}" & nl &
    "function on_task() {" & nl &
    "  var id = hostv(\"event_num\", \"id\");" & nl &
    "  hostS(\"server_log\", \"task ran \" + id);" & nl &
    "  if (id == 2) { repeats++; if (repeats == 2) host(\"schedule_cancel\", 2); }" & nl &
    "}" & nl)

  let found = scanEnginePlugins(folder)
  assert found.len == 4, $found.len
  assert loadEnginePlugins(found, folder & "/.engine-bundle.js") == 4

  assert hasLog("online false"), "player_online answers false for a player that is not on"
  runDueTasks(1'i64)
  assert not hasLog("task ran 1") and not hasLog("task ran 2"), "nothing is due at tick 1"
  runDueTasks(2'i64)
  assert hasLog("task ran 2"), "the repeating task ran at tick 2"
  runDueTasks(3'i64)
  assert hasLog("task ran 1"), "the one-shot task ran at tick 3"
  runDueTasks(4'i64)    # the repeating task's second run; the plugin cancels it
  runDueTasks(5'i64)
  runDueTasks(6'i64)
  runDueTasks(8'i64)
  var twos = 0
  let all = pluginLogLines()
  for k in 0 ..< all.len:
    if all[k] == "task ran 2": inc twos
  assert twos == 2, "the repeating task ran twice, then was cancelled: " & $twos

  assert hasLog("filter loaded"), "start ran and logged"
  assert hasLog("module loaded"), "a module-style plugin loaded and ran start"

  let ok = fireEngineAs("on_player_chat", "Steve", "hello", none[Player]())
  assert not ok[0]
  # plugins run in discovery order; both rewrite, so the message carries the effect of each
  let low = ok[1].toLowerAscii
  assert low.find("hello") >= 0 and low.find("steve") >= 0, ok[1]

  let spam = fireEngineAs("on_player_chat", "Steve", "buy spam now", none[Player]())
  assert spam[0], "the filter cancels spam"

  let cmd = fireEngineAs("on_player_command", "Steve", "gamemode creative", none[Player]())
  assert not cmd[0]
  assert hasLog("command gamemode creative"), "the command entry logged"
  assert hasLog("module saw gamemode creative"), "the module-style plugin saw the command"
  let joined = fireEngineAs("on_player_join", "Steve", "", none[Player]())
  assert joined[0], "the filter cancels the join"
  let nearMove = fireEngineEv("on_player_move", "Steve", "", @[], @[("from_x", 0.0), ("to_x", 5.5)], none[Player]())
  assert not nearMove[0], "a short move passes"
  let farMove = fireEngineEv("on_player_move", "Steve", "", @[], @[("from_x", 0.0), ("to_x", 250.0)], none[Player]())
  assert farMove[0], "the filter cancels a move past x = 100"
  let okBlock = fireEngineEv("on_block_place", "Steve", "", @[("placed", "minecraft:stone")], @[("x", 1.0)], none[Player]())
  assert not okBlock[0]
  let badBlock = fireEngineEv("on_block_place", "Steve", "", @[("placed", "minecraft:bedrock")], @[("x", 1.0)], none[Player]())
  assert badBlock[0], "the filter cancels bedrock"
  let stopCmd = fireEngineEv("on_server_command", "", "", @[("command", "stop")], @[], none[Player]())
  assert stopCmd[0], "the filter cancels the server's stop command"
  let listCmd = fireEngineEv("on_server_command", "", "", @[("command", "list")], @[], none[Player]())
  assert not listCmd[0]
  let growOk = fireEngineEv("on_block_grow", "", "", @[("old_block", "minecraft:sapling"), ("new_block", "minecraft:oak_log")], @[], none[Player]())
  assert not growOk[0]
  let growBad = fireEngineEv("on_block_grow", "", "", @[("old_block", "minecraft:air"), ("new_block", "minecraft:cactus")], @[], none[Player]())
  assert growBad[0], "the filter cancels cactus growth"
  discard fireEngineEv("on_spawn_change", "", "", @[], @[("next_x", 42.0)], none[Player]())
  var sawSpawn = false
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == "spawn 42": sawSpawn = true
  assert sawSpawn, "the spawn change entry read next_x"
  let left = fireEngineAs("on_player_leave", "Steve", "", none[Player]())
  assert not left[0], "no plugin has on_player_leave"
  echo "engineplugintest ok: ", ok[1]
  0

quit(run())
