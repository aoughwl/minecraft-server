## Test for pluginmanager.aowl: the manager finds an aowlmony plugin (plugins/echo, built by tools/build_plugin.sh) and a JavaScript
## plugin (plugins/jsone.js), loads both, runs their commands through the real command dispatcher, and unloads, reloads and loads
## them again. Run it with tools/test_engine_plugins.sh, which prepares plugins/ in a scratch directory.

import std/[assertions, options, syncio, strutils]
import ../world/playerdata
import ../server/key_store
import ../server/recipe
import ../server/scheduler
import ../server/tick_rate_manager
import ../server/data/datamod
import ../server/serverbase
import ../command/[cmdsource, cmddispatch, fallbackdispatch]
import engine/engineplugins
import pluginmanager

proc newServer(): Server =
  var advanced = defaultAdvancedConfiguration()
  advanced.networking.java.onlineMode = false
  advanced.networking.java.encryption = false
  advanced.networking.java.compression.enabled = false
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: advanced, worlds: @[], dimensions: @[],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc hasLog(want: string): bool =
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: return true
  false

proc countLog(want: string): int =
  result = 0
  let logs = pluginLogLines()
  for k in 0 ..< logs.len:
    if logs[k] == want: inc result

proc run(): int =
  let server = newServer()
  let dispatcher = newCommandDispatcher()
  server.commandDispatcher = dispatcher
  startPluginManager(server)
  assert isLoaded("echo"), "the aowlmony plugin loaded at start"
  assert isLoaded("jsone"), "the JavaScript plugin loaded at start"
  assert loadedPluginCount() == 2, "line 1: loadedPluginCount() == 2"
  assert hasLog("echo started"), "start ran"
  assert hasLog("jsone started"), "line 2: hasLog('jsone started')"

  let d = dispatcher.fallbackDispatcher
  let sender = CommandSender(kind: cskConsole)
  assert dispatch(d, sender, nil, "echo hello there").isOk, "the echo command ran (isOk)"
  assert hasLog("echo cmd echo:hello there run 1"), "the aowlmony plugin got its command and text"
  assert dispatch(d, sender, nil, "jsone ping").isOk, "the jsone command ran (isOk)"
  assert hasLog("jsone cmd jsone:ping run 1"), "the JavaScript plugin got its command"

  # a typed event handler: a chat message starting with x is cancelled, any other gets a suffix
  let blocked = fireEngineAs("on_player_chat", "Steve", "xsecret", none[Player]())
  assert blocked[0], "the chat handler cancelled the message"
  let jsBlocked = fireEngineAs("on_player_chat", "Steve", "zzz", none[Player]())
  assert jsBlocked[0], "the JavaScript plugin's typed chat handler cancelled the message"
  let passed = fireEngineAs("on_player_chat", "Steve", "hello", none[Player]())
  assert not passed[0] and passed[1] == "hello!", "the chat handler rewrote the message: " & passed[1]
  # a handler for an event with no player (entity damage) runs and may cancel or change the event
  discard fireEngineEv("on_entity_damage", "", "", @[("entity_type", "zombie"), ("damage_type", "generic")],
    @[("entity_id", 7.0), ("amount", 8.0), ("attacker_id", -1.0)], none[Player]())
  assert hasLog("echo damage zombie 8.0"), "the damage handler saw the entity and the amount"

  # unload the aowlmony plugin: its stop entry runs and its command is gone
  assert unloadPluginNamed("echo") == "", "line 3: unloadPluginNamed('echo') == ''"
  assert hasLog("echo stopped"), "stop ran on unload"
  assert not isLoaded("echo"), "line 4: not isLoaded('echo')"
  assert not dispatch(d, sender, nil, "echo again").isOk, "the command left with the plugin"
  assert unloadPluginNamed("echo").len > 0, "unloading twice is an error"
  # the JavaScript plugin is untouched
  assert dispatch(d, sender, nil, "jsone still").isOk
  assert hasLog("jsone cmd jsone:still run 2"), "line 5: hasLog('jsone cmd jsone:still run 2')"

  # reload brings it back with fresh state (its run counter starts again)
  assert reloadPluginNamed("echo") == "", "line 6: reloadPluginNamed('echo') == ''"
  assert isLoaded("echo"), "line 7: isLoaded('echo')"
  assert dispatch(d, sender, nil, "echo back").isOk
  assert hasLog("echo cmd echo:back run 1"), "reloaded with fresh state"
  assert countLog("echo started") == 2, "line 8: countLog('echo started') == 2"

  # the JavaScript plugin shares one program: unloading it restarts the program without it
  assert unloadPluginNamed("jsone") == "", "line 9: unloadPluginNamed('jsone') == ''"
  assert hasLog("jsone stopped"), "line 10: hasLog('jsone stopped')"
  assert not dispatch(d, sender, nil, "jsone gone").isOk, "the command left with the plugin"
  assert loadPluginNamed("jsone") == "", "line 11: loadPluginNamed('jsone') == ''"
  assert dispatch(d, sender, nil, "jsone back").isOk
  assert hasLog("jsone cmd jsone:back run 1"), "loaded again with fresh state"

  assert loadPluginNamed("nosuchplugin").len > 0, "an unknown plugin is an error"
  assert loadPluginNamed("echo").len > 0, "loading a loaded plugin is an error"
  echo "enginemanagertest ok"
  0

quit(run())
