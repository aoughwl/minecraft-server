## Server glue for invite codes (server/net/hosting/invite.aowl, docs/DESIGN_20_HOSTING.md): `/invite <ipv4> <port>` prints a code,
## `/invite decode <code>` shows what a code carries. The server does not yet know its own public address (that needs the UPnP /
## NAT-PMP I/O loop, see the design doc), so the address is an argument. The token is a placeholder derived from address and port,
## NOT a secret: it is reserved for the relay / join-guard work.

import std/[syncio, strutils]
import engine/engineplugins
import ../server/serverbase
import ../command/[cmdsource, fallbackdispatch]
import ../util/text/text
import ../server/net/hosting/invite

proc placeholderToken(host: seq[byte]; port: int): seq[byte] =
  var h = 2166136261
  for b in host:
    h = ((h xor int(b)) * 16777619) and 0xFFFFFFFF
  h = ((h xor port) * 16777619) and 0xFFFFFFFF
  @[byte((h shr 24) and 255), byte((h shr 16) and 255), byte((h shr 8) and 255), byte(h and 255)]

proc runInvite(sender: CommandSender; argText: string): CommandResult =
  let parts = argText.strip().split(' ')
  if parts.len == 2 and parts[0] == "decode":
    let r = decodeInvite(parts[1])
    if not r.ok:
      return cmdFailed(text("invite: " & r.error))
    sender.sendMessage(text("invite points at " & formatInviteAddress(r.invite)))
    return cmdSuccess(1'i32)
  if parts.len == 2 and parts[0].len > 0:
    var host: seq[byte] = @[]
    if not parseIPv4(parts[0], host):
      return cmdFailed(text("usage: /invite <ipv4> <port> | /invite decode <code>"))
    var port = 0
    for c in parts[1]:
      if c < '0' or c > '9':
        return cmdFailed(text("invite: port must be a number"))
      port = port * 10 + (int(c) - int('0'))
      if port > 65535: break
    let code = encodeInvite(Invite(kind: KindDirect4, host: host, port: port, token: placeholderToken(host, port)))
    if code.len == 0:
      return cmdFailed(text("invite: port must be 1..65535"))
    sender.sendMessage(text("invite code for " & parts[0] & ":" & $port & ": " & code))
    return cmdSuccess(1'i32)
  cmdFailed(text("usage: /invite <ipv4> <port> | /invite decode <code>"))

proc startInvite*(server: Server) =
  ## Called once after the plugin manager started (it provides the command registration).
  discard registerBuiltinCommand("invite", "Invite codes: /invite <ipv4> <port> | decode <code>", 0, runInvite)
