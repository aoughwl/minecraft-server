## Port of pumpkin/src/plugin/loader/mod.rs: the `PluginLoader` trait (`load`, `can_load`, `unload`, `can_unload`) and the
## loader error. `LoaderError` and its constructors are src/server/plugin/native.aowl's (it ported the enum when it ported
## the native loader); `PluginLoadFuture`'s `(Arc<dyn Plugin>, PluginMetadata, Box<dyn Any>)` is `LoadedPlugin` here, the
## loader's own data being an integer (the wasm loader's is the plugin's id in the `PluginHost`). A loader is a
## `ref object` of closures; one field per line.
## PARTIAL: pumpkin/src/plugin/loader/mod.rs - `LoaderError::WasmInitializationError(PluginInitError)` is carried as
## the `lekInitializationFailed` message; the native (dynamic library) loader is not in this tree.
import "../../server/plugin/native" as nativeplugin
import ../api/[apimod, context]

export nativeplugin.LoaderError, nativeplugin.LoaderErrorKind

type
  LoadedPlugin* = object
    instance*: Plugin
    metadata*: PluginMetadata
    loaderData*: int

  LoadResult* = object
    ## `Result<(Arc<dyn Plugin>, PluginMetadata, Box<dyn Any>), LoaderError>`
    isOk*: bool
    loaded*: LoadedPlugin
    error*: nativeplugin.LoaderError

  PluginLoader* = ref object
    loadImpl*: proc (path: string): LoadResult {.closure.}
    canLoadImpl*: proc (path: string): bool {.closure.}
    unloadImpl*: proc (loaderData: int): string {.closure.}           ## "" or the error
    canUnloadImpl*: proc (): bool {.closure.}

proc loadOk*(l: LoadedPlugin): LoadResult = LoadResult(isOk: true, loaded: l)
proc loadErr*(e: nativeplugin.LoaderError): LoadResult = LoadResult(isOk: false, error: e)

proc load*(l: PluginLoader; path: string): LoadResult = l.loadImpl(path)
proc canLoad*(l: PluginLoader; path: string): bool = l.canLoadImpl(path)
proc unload*(l: PluginLoader; loaderData: int): string = l.unloadImpl(loaderData)
proc canUnload*(l: PluginLoader): bool = l.canUnloadImpl()
