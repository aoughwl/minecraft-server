## Known-answer test for logtracing.aowl: postcard bytes built by hand.
import std/[syncio, assertions]
import logtracing

proc vi(n: int): string =
  result = ""
  var x = n
  while true:
    let b = x and 0x7F
    x = x shr 7
    if x == 0:
      result.add char(b)
      break
    result.add char(b or 0x80)

proc ps(s: string): string = vi(s.len) & s

block:
  var b = ""
  b.add vi(3)                                  # three fields
  b.add ps("count") & vi(4) & vi(300)          # u64
  b.add ps("message") & vi(0) & ps("hello world")
  b.add ps("neg") & vi(3) & vi(5)              # i64, zigzag 5 = -3
  b.add ps("my_plugin::run") & ps("my_plugin::run")   # metadata.name, target
  b.add vi(3)                                  # warn
  b.add "\x01" & ps("src/lib.rs")              # module_path
  b.add "\x01" & ps("src/lib.rs")              # file
  b.add "\x01" & vi(42)                        # line
  b.add vi(1) & ps("message")                  # field set
  b.add "\x00\x01"                             # is_span, is_event
  let e = decodeTracingEvent(b)
  assert e.ok
  assert e.level == 3
  assert e.message == "hello world"
  assert e.target == "my_plugin::run"
  assert e.line == 42
  assert fieldsText(e) == "count=300, neg=-3"
  let (lv, line) = logTracing(b)
  assert lv == 3
  assert line == "hello world plugin.target=my_plugin::run plugin.module=src/lib.rs plugin.file=src/lib.rs plugin.line=42 plugin.fields=count=300, neg=-3"

block:
  var b = vi(0) & ps("n") & ps("t") & vi(2) & "\x00" & "\x00" & "\x00" & vi(0) & "\x00\x01"
  let e = decodeTracingEvent(b)
  assert e.ok
  assert e.file == "unknown" and e.line == 0 and e.message == ""
  assert tracingLine(e) == " plugin.target=t plugin.module= plugin.file=unknown plugin.line=0"

block:
  let (lv, line) = logTracing("\x05")
  assert lv == 4
  assert line.len > 0 and line[0] == '['

echo "logtracingtest ok"
