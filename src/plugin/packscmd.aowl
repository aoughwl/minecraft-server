## Server glue for content packs (physics/packs.aowl, docs/PACKS.md): loads `packs/` at start-up, registers `/packs list|reload|info <id>`
## and one command per pack command, and forwards the packs' jester:wind parameters to the wind sync.
## Packs are applied for the world named like the save folder (enabled.json "worlds" key).

import std/[syncio, strutils, os]
import engine/engineplugins
import ../server/serverbase
import ../server/net/queryserver
import ../command/[cmdsource, fallbackdispatch]
import ../util/text/text
import ../server/net/jester/windsync
import ../physics/packs

const PacksFolder = "packs"

var gPackWorld = "world"

proc sendLines(sender: CommandSender; lines: seq[string]) =
  for l in lines: sender.sendMessage(text(l))

proc packCommandReply(name: string): proc(sender: CommandSender; args: string): CommandResult {.closure.} =
  let nm = name
  result = proc(sender: CommandSender; args: string): CommandResult {.closure.} =
    let (found, c) = findPackCommand(nm)
    if not found:
      return cmdFailed(text("/" & nm & " is no longer provided by any pack (restart the server to drop the command)"))
    sendLines(sender, expandReply(c, args.strip()))
    cmdSuccess(1'i32)

proc doReload(): PackReport =
  let rep = reloadPacks(PacksFolder, gPackWorld)
  setJesterWindParams(packWindParams())
  for nm in rep.newCommands:
    let (found, c) = findPackCommand(nm)
    if found and registerBuiltinCommand(c.name, c.description, c.level, packCommandReply(c.name)):
      markCommandRegistered(c.name, c.level)
  rep

proc summary(rep: PackReport): seq[string] =
  result = @["packs: " & $rep.found & " found, " & $rep.valid & " valid, " & $rep.active & " active for world \"" & rep.world & "\""]
  for l in rep.lines: result.add l

proc runPacks(sender: CommandSender; argText: string): CommandResult =
  let parts = argText.strip().split(' ')
  let sub = if parts.len > 0: parts[0] else: ""
  if sub == "list":
    sendLines(sender, listLines())
  elif sub == "reload":
    sendLines(sender, summary(doReload()))
  elif sub == "info":
    if parts.len < 2 or parts[1].len == 0: return cmdFailed(text("usage: /packs info <id>"))
    sendLines(sender, infoLines(parts[1]))
  else:
    return cmdFailed(text("usage: /packs list | reload | info <id>"))
  cmdSuccess(1'i32)

proc startPacks*(server: Server) =
  ## Called once after the plugin manager started (it provides the command registration).
  gPackWorld = worldNameOf(server.levelFolder)
  discard registerBuiltinCommand("packs", "Content packs: /packs list | reload | info <id>", 4, runPacks)
  if dirExists(PacksFolder):
    let lines = summary(doReload())
    for l in lines: echo "[packs] ", l
