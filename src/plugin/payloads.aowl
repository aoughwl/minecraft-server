## Custom payloads for plugins: the channels each player's client declared (`minecraft:register` / `minecraft:unregister`) and the hex form a
## byte buffer takes on the plugin wire (a plugin reaches the host through text, so bytes travel as lowercase hex).
## Depends on nothing, so the network code and the plugin host can both import it.

import std/[strutils]

var gPayloadChannels: seq[(string, seq[string])] = @[]   ## player name -> channels the client declared

proc channelSlot(player: string): int =
  for i in 0 ..< gPayloadChannels.len:
    if gPayloadChannels[i][0] == player: return i
  gPayloadChannels.add (player, newSeq[string]())
  gPayloadChannels.len - 1

proc payloadChannels*(player: string): seq[string] =
  for e in gPayloadChannels:
    if e[0] == player: return e[1]
  @[]

proc payloadChannelDeclared*(player, channel: string): bool =
  for c in payloadChannels(player):
    if c == channel: return true
  false

proc payloadForget*(player: string) =
  ## The player left: their declared channels go.
  var kept: seq[(string, seq[string])] = @[]
  for e in gPayloadChannels:
    if e[0] != player: kept.add e
  gPayloadChannels = kept

proc payloadSplitChannels(data: seq[byte]): seq[string] =
  ## The body of a register / unregister message: channel names separated by a zero byte.
  result = @[]
  var cur = ""
  for b in data:
    if b == 0'u8:
      if cur.len > 0: result.add cur
      cur = ""
    else:
      cur.add char(b)
  if cur.len > 0: result.add cur

proc payloadNote*(player, channel: string; data: seq[byte]): bool =
  ## Called for every payload the client sends. Records what a register / unregister message declares; true when it was one of those.
  if channel == "minecraft:register" or channel == "register":
    let slot = channelSlot(player)
    for c in payloadSplitChannels(data):
      var have = false
      for h in gPayloadChannels[slot][1]:
        if h == c: have = true
      if not have: gPayloadChannels[slot][1].add c
    return true
  if channel == "minecraft:unregister" or channel == "unregister":
    let slot = channelSlot(player)
    let gone = payloadSplitChannels(data)
    var kept: seq[string] = @[]
    for h in gPayloadChannels[slot][1]:
      var drop = false
      for c in gone:
        if c == h: drop = true
      if not drop: kept.add h
    gPayloadChannels[slot][1] = kept
    return true
  false

const HexDigits = "0123456789abcdef"

proc payloadToHex*(data: seq[byte]): string =
  result = ""
  for b in data:
    result.add HexDigits[int(b) shr 4]
    result.add HexDigits[int(b) and 15]

proc hexNibble(c: char): int =
  if c >= '0' and c <= '9': ord(c) - 48
  elif c >= 'a' and c <= 'f': ord(c) - 87
  elif c >= 'A' and c <= 'F': ord(c) - 55
  else: -1

proc payloadFromHex*(s: string): seq[byte] =
  ## Bytes from hex text (an odd tail or a non-hex character is ignored).
  result = @[]
  var i = 0
  while i + 1 < s.len:
    let a = hexNibble(s[i])
    let b = hexNibble(s[i + 1])
    if a >= 0 and b >= 0: result.add byte(a * 16 + b)
    i += 2
