  gPluginInteractHook(player, action, pos)

var gPluginBlockPlaceHook*: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} =
  proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = false
  ## `BlockPlaceEvent` (block names without the namespace, can_build true): true when cancelled. Fired by server/block/block_place.aowl;
  ## nothing fills it yet, the plugin host (pluginmgr.aowl) has no `block-place` conversion to the WIT event.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBlockPlaceHook*(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool =
  gPluginBlockPlaceHook(player, placedBlock, clickedBlock, position)

var gServerCreateWorldHook*: proc(name: string; dimension: int): int {.closure.} =
  proc(name: string; dimension: int): int {.closure.} = -1
  ## `Server::create_world` (dimension is the WIT enum: 0 overworld, 1 nether, 2 end): the world's index in `server.worlds`.
  ## servermod fills it: it sits above the plugin host.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callServerCreateWorldHook*(name: string; dimension: int): int =
  gServerCreateWorldHook(name, dimension)

var gServerUnloadWorldHook*: proc(name: string): string {.closure.} =
  proc(name: string): string {.closure.} = "unloading worlds is not available"
  ## `Server::unload_world`: "" or upstream's error text.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callServerUnloadWorldHook*(name: string): string =
  gServerUnloadWorldHook(name)

var gServerSaveAllHook*: proc(): string {.closure.} =
  proc(): string {.closure.} = "save-all is not available"
  ## `Server::save_all`: "" or an error text.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callServerSaveAllHook*(): string =
  gServerSaveAllHook()

type
  PlayerEvKind* = enum
    ## The player events with a call site in the server that take their data from `PlayerEv` (the ones above have a hook of
    ## their own). Each is converted to its WIT event record by src/plugin/wit/witeventsplayer2.aowl.
    pekSwingArm              ## `handle_swing_arm`: a left click on a block or the air (`PlayerInteractEvent`)
    pekUseItem               ## `handle_use_item`: a right click on a block or the air (`PlayerInteractEvent`)
    pekInteractEntity        ## n entity id, n2 action (0 interact, 1 attack, 2 interact-at), flag sneaking
    pekInteractUnknownEntity ## n entity id, n2 action
    pekCustomPayload         ## text channel, data
    pekChangedMainHand       ## n the hand (0 left, 1 right)
    pekInventoryClose        ## n the window type, -1 for the player's own
    pekInventoryClick        ## n window type (-1: none), n2 click type, n3 slot, n4 raw slot, n5 hotbar button, stack clicked, stack2 cursor
    pekBlockBreak            ## text block name, pos, flag should-drop
    pekDropItem              ## text item name, n count
    pekItemPickup            ## text item name, n count, n2 the item entity's id
    pekItemConsume           ## text item name
    pekBedEnter              ## pos
    pekBedLeave              ## pos
    pekSignChange            ## pos, lines
    pekBucketEmpty           ## pos, text bucket
    pekBucketFill            ## pos, text bucket
    pekPermissionCheck       ## text node, flag the result so far

  PlayerEv* = object
    kind*: PlayerEvKind
    text*: string
    n*, n2*, n3*, n4*, n5*: int64
    flag*: bool
    data*: seq[byte]
    lines*: seq[string]
    pos*: BlockPos
    stack*, stack2*: ItemStack

proc newPlayerEv*(kind: PlayerEvKind): PlayerEv =
  PlayerEv(kind: kind, text: "", n: 0'i64, n2: 0'i64, n3: 0'i64, n4: 0'i64, n5: 0'i64, flag: false, data: @[], lines: @[],
           pos: newBlockPos(0'i32, 0'i32, 0'i32), stack: emptyItemStack(), stack2: emptyItemStack())

var gPluginBedrockSessionHook*: proc(player: Player): bool {.closure.} =
  proc(player: Player): bool {.closure.} = false
  ## Whether the player is a Bedrock client (`sessionOfPlayer(player) != nil`), set by pluginmgr.aowl.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBedrockSessionHook*(player: Player): bool =
  gPluginBedrockSessionHook(player)

var gPluginBedrockFormHook*: proc(player: Player; formData: string): uint32 {.closure.} =
  proc(player: Player; formData: string): uint32 {.closure.} = 0'u32
  ## `bedrock-player.open-form` (src/server/net/bedrock/bedrockplay.aowl `sendBedrockForm`, set by pluginmgr.aowl): the form id the
  ## response event will carry, 0 for a player who is not on Bedrock. The same answer is `as-bedrock`'s test.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBedrockFormHook*(player: Player; formData: string): uint32 =
  gPluginBedrockFormHook(player, formData)

var gPluginBedrockVersionHook*: proc(player: Player): int {.closure.} =
  proc(player: Player): int {.closure.} = 2
  ## `bedrock-player.get-version`: the case of the WIT `bedrock-minecraft-version` (0 v-1-21, 1 v-1-26-30, 2 unknown) of the player's
  ## Bedrock client; 2 for a player who is not on Bedrock. Set by bedrockplay.aowl from its `sessionOfPlayer`, as the other Bedrock hooks are.

proc callPluginBedrockVersionHook*(player: Player): int =
  gPluginBedrockVersionHook(player)

var gPluginBedrockDataHook*: proc(player: Player): Option[slogin.ClientData] {.closure.} =
  proc(player: Player): Option[slogin.ClientData] {.closure.} = none[slogin.ClientData]()
  ## `bedrock-player.get-settings`: the login `ClientData` of the player's Bedrock client, none for a Java player or a client whose
  ## data is not there.

proc callPluginBedrockDataHook*(player: Player): Option[slogin.ClientData] =
  gPluginBedrockDataHook(player)

var gPluginBedrockSendHook*: proc(player: Player; packetId: int32; body: seq[byte]): bool {.closure.} =
  proc(player: Player; packetId: int32; body: seq[byte]): bool {.closure.} = false
  ## `bedrock-player.send-packet`: `send_game_packet` of an already written body; false for a player who is not on Bedrock.

proc callPluginBedrockSendHook*(player: Player; packetId: int32; body: seq[byte]): bool =
  gPluginBedrockSendHook(player, packetId, body)

var gPluginPlayerEventHook*: proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} =
  proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} = (false, ev.flag)
  ## One entry for the events of `PlayerEvKind`, called from play.aowl, player.aowl, worldmod.aowl and the item code:
  ## (cancelled, the event's boolean after the plugins: should-drop of a block break, the result of a permission check).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginPlayerEventHook*(player: Player; ev: PlayerEv): (bool, bool) =
  gPluginPlayerEventHook(player, ev)
