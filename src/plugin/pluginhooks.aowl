## The hooks the server's network code calls to offer an event to the plugins before it acts on it. They are plain
## closure variables with do-nothing defaults so that src/server/net/java/play.aowl can call them without importing the
## plugin host (pluginmgr.aowl, which sits above the whole server, fills them in `startPlugins`).
## Port of the call sites of `send_cancellable!` for PlayerChatEvent, PlayerCommandSendEvent and PlayerMoveEvent in
## pumpkin/src/net/java/play.rs: each hook returns whether the event was cancelled, plus what the plugins left in it.
import std/options
import ../server/serverbase
import ../util/vector3
import ../util/gamemode
import ../util/math/position
import ../util/text/text

var gPluginChatHook*: proc(player: Player; message: string): (bool, string) {.closure.} =
  proc(player: Player; message: string): (bool, string) {.closure.} = (false, message)
  ## `PlayerChatEvent`: (cancelled, the message after the plugins).

var gPluginCommandHook*: proc(player: Player; command: string): (bool, string) {.closure.} =
  proc(player: Player; command: string): (bool, string) {.closure.} = (false, command)
  ## `PlayerCommandSendEvent`: (cancelled, the command after the plugins).

var gPluginMoveHook*: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
  proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
  ## `PlayerMoveEvent`: (cancelled, the destination after the plugins).

var gPluginToggleHook*: proc(player: Player; kind: int; value: bool): bool {.closure.} =
  proc(player: Player; kind: int; value: bool): bool {.closure.} = false
  ## `PlayerToggleSneakEvent` (kind 0), `PlayerToggleSprintEvent` (1) and `PlayerToggleFlightEvent` (2): true when cancelled.

var gPluginGameModeHook*: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} =
  proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = (false, next)
  ## `PlayerGamemodeChangeEvent`: (cancelled, the new game mode after the plugins).

var gPluginItemHeldHook*: proc(player: Player; previous, next: int): bool {.closure.} =
  proc(player: Player; previous, next: int): bool {.closure.} = false
  ## `PlayerItemHeldEvent`: true when cancelled.

var gPluginTeleportHook*: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
  proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
  ## `PlayerTeleportEvent`: (cancelled, the destination after the plugins).

var gPluginChangeWorldHook*: proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32) {.closure.} =
  proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32) {.closure.} = (false, pos, yaw, pitch)
  ## `PlayerChangeWorldEvent`: (cancelled, position, yaw, pitch after the plugins). The plugins' `new-world` is not followed.

var gPluginLoginHook*: proc(player: Player): (bool, TextComponent) {.closure.} =
  proc(player: Player): (bool, TextComponent) {.closure.} = (false, text(""))
  ## `PlayerLoginEvent`: (cancelled, the kick message).

var gPluginInteractHook*: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
  proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = false
  ## `PlayerInteractEvent` (action is the WIT `interact-action` case: 0 left-click-block, 1 left-click-air,
  ## 2 right-click-air, 3 right-click-block): true when cancelled.
