## The hooks the server's network code calls to offer an event to the plugins before it acts on it. They are plain
## closure variables with do-nothing defaults so that src/server/net/java/play.aowl can call them without importing the
## plugin host (pluginmgr.aowl, which sits above the whole server, fills them in `startPlugins`).
## Port of the call sites of `send_cancellable!` for PlayerChatEvent, PlayerCommandSendEvent and PlayerMoveEvent in
## pumpkin/src/net/java/play.rs: each hook returns whether the event was cancelled, plus what the plugins left in it.
import std/options
import ../server/serverbase
import ../util/vector3
import ../util/gamemode
import ../util/math/position
import ../util/text/text
import "../data/item_stack/mod"

var gPluginChatHook*: proc(player: Player; message: string): (bool, string) {.closure.} =
  proc(player: Player; message: string): (bool, string) {.closure.} = (false, message)
  ## `PlayerChatEvent`: (cancelled, the message after the plugins).

var gPluginCommandHook*: proc(player: Player; command: string): (bool, string) {.closure.} =
  proc(player: Player; command: string): (bool, string) {.closure.} = (false, command)
  ## `PlayerCommandSendEvent`: (cancelled, the command after the plugins).

var gPluginMoveHook*: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
  proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
  ## `PlayerMoveEvent`: (cancelled, the destination after the plugins).

var gPluginToggleHook*: proc(player: Player; kind: int; value: bool): bool {.closure.} =
  proc(player: Player; kind: int; value: bool): bool {.closure.} = false
  ## `PlayerToggleSneakEvent` (kind 0), `PlayerToggleSprintEvent` (1) and `PlayerToggleFlightEvent` (2): true when cancelled.

var gPluginGameModeHook*: proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} =
  proc(player: Player; previous, next: GameMode): (bool, GameMode) {.closure.} = (false, next)
  ## `PlayerGamemodeChangeEvent`: (cancelled, the new game mode after the plugins).

var gPluginItemHeldHook*: proc(player: Player; previous, next: int): bool {.closure.} =
  proc(player: Player; previous, next: int): bool {.closure.} = false
  ## `PlayerItemHeldEvent`: true when cancelled.

var gPluginTeleportHook*: proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} =
  proc(player: Player; fromPos, toPos: Vector3[float64]): (bool, Vector3[float64]) {.closure.} = (false, toPos)
  ## `PlayerTeleportEvent`: (cancelled, the destination after the plugins).

var gPluginChangeWorldHook*: proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32) {.closure.} =
  proc(player: Player; previous, next: World; pos: Vector3[float64]; yaw, pitch: float32): (bool, Vector3[float64], float32, float32) {.closure.} = (false, pos, yaw, pitch)
  ## `PlayerChangeWorldEvent`: (cancelled, position, yaw, pitch after the plugins). The plugins' `new-world` is not followed.

var gPluginLoginHook*: proc(player: Player): (bool, TextComponent) {.closure.} =
  proc(player: Player): (bool, TextComponent) {.closure.} = (false, text(""))
  ## `PlayerLoginEvent`: (cancelled, the kick message).

var gPluginInteractHook*: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
  proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = false
  ## `PlayerInteractEvent` (action is the WIT `interact-action` case: 0 left-click-block, 1 left-click-air,
  ## 2 right-click-air, 3 right-click-block): true when cancelled.

var gPluginBlockPlaceHook*: proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} =
  proc(player: Player; placedBlock, clickedBlock: string; position: BlockPos): bool {.closure.} = false
  ## `BlockPlaceEvent` (block names without the namespace, can_build true): true when cancelled. Fired by server/block/block_place.aowl;
  ## nothing fills it yet, the plugin host (pluginmgr.aowl) has no `block-place` conversion to the WIT event.

var gServerCreateWorldHook*: proc(name: string; dimension: int): int {.closure.} =
  proc(name: string; dimension: int): int {.closure.} = -1
  ## `Server::create_world` (dimension is the WIT enum: 0 overworld, 1 nether, 2 end): the world's index in `server.worlds`.
  ## servermod fills it: it sits above the plugin host.

var gServerUnloadWorldHook*: proc(name: string): string {.closure.} =
  proc(name: string): string {.closure.} = "unloading worlds is not available"
  ## `Server::unload_world`: "" or upstream's error text.

var gServerSaveAllHook*: proc(): string {.closure.} =
  proc(): string {.closure.} = "save-all is not available"
  ## `Server::save_all`: "" or an error text.

type
  PlayerEvKind* = enum
    ## The player events with a call site in the server that take their data from `PlayerEv` (the ones above have a hook of
    ## their own). Each is converted to its WIT event record by src/plugin/wit/witeventsplayer2.aowl.
    pekSwingArm              ## `handle_swing_arm`: a left click on a block or the air (`PlayerInteractEvent`)
    pekUseItem               ## `handle_use_item`: a right click on a block or the air (`PlayerInteractEvent`)
    pekInteractEntity        ## n entity id, n2 action (0 interact, 1 attack, 2 interact-at), flag sneaking
    pekInteractUnknownEntity ## n entity id, n2 action
    pekCustomPayload         ## text channel, data
    pekChangedMainHand       ## n the hand (0 left, 1 right)
    pekInventoryClose        ## n the window type, -1 for the player's own
    pekInventoryClick        ## n window type (-1: none), n2 click type, n3 slot, n4 raw slot, n5 hotbar button, stack clicked, stack2 cursor
    pekBlockBreak            ## text block name, pos, flag should-drop
    pekDropItem              ## text item name, n count
    pekItemPickup            ## text item name, n count, n2 the item entity's id
    pekItemConsume           ## text item name
    pekBedEnter              ## pos
    pekBedLeave              ## pos
    pekSignChange            ## pos, lines
    pekBucketEmpty           ## pos, text bucket
    pekBucketFill            ## pos, text bucket
    pekPermissionCheck       ## text node, flag the result so far

  PlayerEv* = object
    kind*: PlayerEvKind
    text*: string
    n*, n2*, n3*, n4*, n5*: int64
    flag*: bool
    data*: seq[byte]
    lines*: seq[string]
    pos*: BlockPos
    stack*, stack2*: ItemStack

proc newPlayerEv*(kind: PlayerEvKind): PlayerEv =
  PlayerEv(kind: kind, text: "", n: 0'i64, n2: 0'i64, n3: 0'i64, n4: 0'i64, n5: 0'i64, flag: false, data: @[], lines: @[],
           pos: newBlockPos(0'i32, 0'i32, 0'i32), stack: emptyItemStack(), stack2: emptyItemStack())

var gPluginBedrockSessionHook*: proc(player: Player): bool {.closure.} =
  proc(player: Player): bool {.closure.} = false
  ## Whether the player is a Bedrock client (`sessionOfPlayer(player) != nil`), set by pluginmgr.aowl.

var gPluginBedrockFormHook*: proc(player: Player; formData: string): uint32 {.closure.} =
  proc(player: Player; formData: string): uint32 {.closure.} = 0'u32
  ## `bedrock-player.open-form` (src/server/net/bedrock/bedrockplay.aowl `sendBedrockForm`, set by pluginmgr.aowl): the form id the
  ## response event will carry, 0 for a player who is not on Bedrock. The same answer is `as-bedrock`'s test.

var gPluginPlayerEventHook*: proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} =
  proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} = (false, ev.flag)
  ## One entry for the events of `PlayerEvKind`, called from play.aowl, player.aowl, worldmod.aowl and the item code:
  ## (cancelled, the event's boolean after the plugins: should-drop of a block break, the result of a permission check).
