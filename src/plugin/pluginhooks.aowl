var gPluginRespawnHook*: proc(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} =
  proc(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) {.closure.} = discard
  ## `PlayerRespawnEvent` (not cancellable).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginRespawnHook*(player: Player; previous, respawned: World; pos: Vector3[float64]; yaw, pitch: float32; alive: bool) =
