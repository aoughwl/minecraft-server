## The plugin hook that sits in the block code itself (src/server/block/blockbehaviour.aowl), so it depends on nothing: block state ids and
## plain numbers only.

var gPluginBlockChangeHook*: proc(x, y, z: int; oldState, newState: int): bool {.closure.} =
  proc(x, y, z: int; oldState, newState: int): bool {.closure.} = false
  ## A block at x, y, z is about to change from state `oldState` to `newState` (burning, fading, forming, spreading, fluid flow, growth,
  ## decay, and what players, explosions and pistons do): true to keep it as it is.

var gPluginBlockChangeListened*: bool = false
  ## Whether any plugin listens: the block code asks this first, because it writes blocks very often.

proc callPluginBlockChangeHook*(x, y, z: int; oldState, newState: int): bool =
  gPluginBlockChangeHook(x, y, z, oldState, newState)

proc pluginBlockChangeListened*(): bool = gPluginBlockChangeListened
