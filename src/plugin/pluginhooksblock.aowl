## The plugin hook that sits in the block code itself (src/server/block/blockbehaviour.aowl), so it depends on nothing: block state ids and
## plain numbers only.

var gPluginBlockChangeHook*: proc(x, y, z: int; oldState, newState: int): bool {.closure.} =
  proc(x, y, z: int; oldState, newState: int): bool {.closure.} = false
  ## A block at x, y, z is about to change from state `oldState` to `newState` (burning, fading, forming, spreading, fluid flow, growth,
  ## decay, and what players, explosions and pistons do): true to keep it as it is.

var gPluginBlockChangeListened*: bool = false
  ## Whether any plugin listens: the block code asks this first, because it writes blocks very often.

proc callPluginBlockChangeHook*(x, y, z: int; oldState, newState: int): bool =
  gPluginBlockChangeHook(x, y, z, oldState, newState)

proc pluginBlockChangeListened*(): bool = gPluginBlockChangeListened

var gPluginPortalHook*: proc(entityId: int; entityType: string; x, y, z: int; target: string): bool {.closure.} =
  proc(entityId: int; entityType: string; x, y, z: int; target: string): bool {.closure.} = false
  ## An entity stands in a nether portal at x, y, z and would go to the dimension `target` ("minecraft:the_nether"): true to stop it.

proc callPluginPortalHook*(entityId: int; entityType: string; x, y, z: int; target: string): bool =
  gPluginPortalHook(entityId, entityType, x, y, z, target)

var gPluginFurnaceHook*: proc(x, y, z: int; input, output: string): bool {.closure.} =
  proc(x, y, z: int; input, output: string): bool {.closure.} = false
  ## A furnace (or smoker, blast furnace) at x, y, z finished smelting `input` into `output`: true to cancel (the progress restarts).

proc callPluginFurnaceHook*(x, y, z: int; input, output: string): bool =
  gPluginFurnaceHook(x, y, z, input, output)
