## The hooks the server's block, world and server code call to offer an event to the plugins before it acts on it. Same
## shape as pluginhooks.aowl (plain closure variables with do-nothing defaults, filled by pluginmgr.aowl's `startPlugins`),
## for the events of pumpkin/src/plugin/api/events/{block,world,server}: each hook returns whether the event was cancelled
## plus what the plugins left in it, as `send_cancellable!` / `plugin_manager.fire(event)` give the call site.
## Call sites (upstream file: here):
##   BlockGrowEvent       block/blocks/plant/crop/mod.rs: server/block/blocks/plant/crop/cropmod.aowl
##   BlockRedstoneEvent   block/blocks/redstone/pressure_plate/mod.rs: .../pressure_plate/pressure_platemod.aowl
##   SpawnChangeEvent     command/commands/setworldspawn.rs: server/command/setworldspawn.aowl via `CommandServer.fireSpawnChange`
##   ServerCommandEvent   lib.rs `setup_stdin_console`: server/commandbridge.aowl `takeConsoleLines`
##   ServerBroadcastEvent server/mod.rs `broadcast_message`: server/commandbridge.aowl `broadcastSay` / `broadcastEmote`
##   ServerTick{Start,End}Event server/ticker.rs: server/ticker.aowl `stepTicker`
##   ServerLoadEvent      lib.rs `PumpkinServer::start`: server/pumpkinlib.aowl before its accept loop
##   PacketReceivedEvent  net/java/mod.rs `handle_play_packet`: server/net/java/dispatch.aowl
##   PacketSentEvent      net/java/mod.rs `enqueue_packet`: server/net/java/javamod.aowl `gPacketSentHook`, in `writePacketFor`
import std/options
import ../server/serverbase
from "../server/block/blockbehaviour" import BlockWorld
import ../util/math/position
import ../util/text/text
import ../data/block_ext
from ../data/block_state import BlockStateId

var gPluginBlockGrowHook*: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
                                newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) {.closure.} =
  proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
       pos: BlockPos): (bool, BlockStateId) {.closure.} = (false, newState)
  ## `BlockGrowEvent`: (cancelled, the new state id after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBlockGrowHook*(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
                                newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) =
  gPluginBlockGrowHook(world, oldBlock, oldState, newBlock, newState, pos)

var gPluginBlockRedstoneHook*: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos;
                                    oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
    (false, newCurrent)
  ## `BlockRedstoneEvent`: (cancelled, the new current after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBlockRedstoneHook*(world: BlockWorld; stateId: BlockStateId; pos: BlockPos;
                                    oldCurrent, newCurrent: int32): (bool, int32) =
  gPluginBlockRedstoneHook(world, stateId, pos, oldCurrent, newCurrent)

var gPluginSpawnChangeHook*: proc(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
                                  nextYaw, nextPitch: float32): (BlockPos, float32, float32) {.closure.} =
  proc(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
       nextYaw, nextPitch: float32): (BlockPos, float32, float32) {.closure.} = (next, nextYaw, nextPitch)
  ## `SpawnChangeEvent` (not cancellable): the new position, yaw and pitch after the plugins.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginSpawnChangeHook*(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
                                  nextYaw, nextPitch: float32): (BlockPos, float32, float32) =
  gPluginSpawnChangeHook(world, previous, previousYaw, previousPitch, next, nextYaw, nextPitch)

var gPluginServerCommandHook*: proc(command: string): bool {.closure.} =
  proc(command: string): bool {.closure.} = false
  ## `ServerCommandEvent`: true when cancelled.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerCommandHook*(command: string): bool =
  gPluginServerCommandHook(command)

var gPluginServerBroadcastHook*: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} =
  proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = (false, message, sender)
  ## `ServerBroadcastEvent`: (cancelled, the message and the sender after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerBroadcastHook*(message, sender: TextComponent): (bool, TextComponent, TextComponent) =
  gPluginServerBroadcastHook(message, sender)

var gPluginTickStartHook*: proc(tick: int32) {.closure.} =
  proc(tick: int32) {.closure.} = discard
  ## `ServerTickStartEvent`.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginTickStartHook*(tick: int32) =
  gPluginTickStartHook(tick)

var gPluginTickEndHook*: proc(tick: int32; durationNanos: int64) {.closure.} =
  proc(tick: int32; durationNanos: int64) {.closure.} = discard
  ## `ServerTickEndEvent`.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginTickEndHook*(tick: int32; durationNanos: int64) =
  gPluginTickEndHook(tick, durationNanos)

var gPluginServerLoadHook*: proc(reload: bool) {.closure.} =
  proc(reload: bool) {.closure.} = discard
  ## `ServerLoadEvent` (`LoadType::Startup`, or `Reload` when true).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerLoadHook*(reload: bool) =
  gPluginServerLoadHook(reload)

var gPluginPacketReceivedHook*: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
  proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
  ## `PacketReceivedEvent`: true when cancelled (the packet is not handled).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginPacketReceivedHook*(player: Player; packetId: int32; payload: seq[byte]): bool =
  gPluginPacketReceivedHook(player, packetId, payload)
