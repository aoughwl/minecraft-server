## The hooks the server's block, world and server code call to offer an event to the plugins before it acts on it. Same
## shape as pluginhooks.aowl (plain closure variables with do-nothing defaults, filled by pluginmgr.aowl's `startPlugins`),
## for the events of pumpkin/src/plugin/api/events/{block,world,server}: each hook returns whether the event was cancelled
## plus what the plugins left in it, as `send_cancellable!` / `plugin_manager.fire(event)` give the call site.
## Call sites (upstream file: here):
##   BlockGrowEvent       block/blocks/plant/crop/mod.rs: server/block/blocks/plant/crop/cropmod.aowl
##   BlockRedstoneEvent   block/blocks/redstone/pressure_plate/mod.rs: .../pressure_plate/pressure_platemod.aowl
##   SpawnChangeEvent     command/commands/setworldspawn.rs: server/command/setworldspawn.aowl via `CommandServer.fireSpawnChange`
##   ServerCommandEvent   lib.rs `setup_stdin_console`: server/commandbridge.aowl `takeConsoleLines`
##   ServerBroadcastEvent server/mod.rs `broadcast_message`: server/commandbridge.aowl `broadcastSay` / `broadcastEmote`
##   ServerTick{Start,End}Event server/ticker.rs: server/ticker.aowl `stepTicker`
##   ServerLoadEvent      lib.rs `PumpkinServer::start`: server/pumpkinlib.aowl before its accept loop
##   PacketReceivedEvent  net/java/mod.rs `handle_play_packet`: server/net/java/dispatch.aowl
##   PacketSentEvent      net/java/mod.rs `enqueue_packet`: server/net/java/javamod.aowl `gPacketSentHook`, in `writePacketFor`
import std/options
import ../server/serverbase
from "../server/block/blockbehaviour" import BlockWorld
import ../util/math/position
import ../util/vector3
import ../util/text/text
import ../data/block_ext
from ../data/block_state import BlockStateId

var gPluginBlockGrowHook*: proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
                                newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) {.closure.} =
  proc(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block; newState: BlockStateId;
       pos: BlockPos): (bool, BlockStateId) {.closure.} = (false, newState)
  ## `BlockGrowEvent`: (cancelled, the new state id after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBlockGrowHook*(world: BlockWorld; oldBlock: Block; oldState: BlockStateId; newBlock: Block;
                                newState: BlockStateId; pos: BlockPos): (bool, BlockStateId) =
  gPluginBlockGrowHook(world, oldBlock, oldState, newBlock, newState, pos)

var gPluginBlockRedstoneHook*: proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos;
                                    oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
  proc(world: BlockWorld; stateId: BlockStateId; pos: BlockPos; oldCurrent, newCurrent: int32): (bool, int32) {.closure.} =
    (false, newCurrent)
  ## `BlockRedstoneEvent`: (cancelled, the new current after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginBlockRedstoneHook*(world: BlockWorld; stateId: BlockStateId; pos: BlockPos;
                                    oldCurrent, newCurrent: int32): (bool, int32) =
  gPluginBlockRedstoneHook(world, stateId, pos, oldCurrent, newCurrent)

var gPluginSpawnChangeHook*: proc(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
                                  nextYaw, nextPitch: float32): (BlockPos, float32, float32) {.closure.} =
  proc(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
       nextYaw, nextPitch: float32): (BlockPos, float32, float32) {.closure.} = (next, nextYaw, nextPitch)
  ## `SpawnChangeEvent` (not cancellable): the new position, yaw and pitch after the plugins.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginSpawnChangeHook*(world: World; previous: BlockPos; previousYaw, previousPitch: float32; next: BlockPos;
                                  nextYaw, nextPitch: float32): (BlockPos, float32, float32) =
  gPluginSpawnChangeHook(world, previous, previousYaw, previousPitch, next, nextYaw, nextPitch)

var gPluginServerCommandHook*: proc(command: string): bool {.closure.} =
  proc(command: string): bool {.closure.} = false
  ## `ServerCommandEvent`: true when cancelled.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerCommandHook*(command: string): bool =
  gPluginServerCommandHook(command)

var gPluginServerBroadcastHook*: proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} =
  proc(message, sender: TextComponent): (bool, TextComponent, TextComponent) {.closure.} = (false, message, sender)
  ## `ServerBroadcastEvent`: (cancelled, the message and the sender after the plugins).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerBroadcastHook*(message, sender: TextComponent): (bool, TextComponent, TextComponent) =
  gPluginServerBroadcastHook(message, sender)

var gPluginTickStartHook*: proc(tick: int32) {.closure.} =
  proc(tick: int32) {.closure.} = discard
  ## `ServerTickStartEvent`.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginTickStartHook*(tick: int32) =
  gPluginTickStartHook(tick)

var gPluginTickEndHook*: proc(tick: int32; durationNanos: int64) {.closure.} =
  proc(tick: int32; durationNanos: int64) {.closure.} = discard
  ## `ServerTickEndEvent`.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginTickEndHook*(tick: int32; durationNanos: int64) =
  gPluginTickEndHook(tick, durationNanos)

var gPluginServerLoadHook*: proc(reload: bool) {.closure.} =
  proc(reload: bool) {.closure.} = discard
  ## `ServerLoadEvent` (`LoadType::Startup`, or `Reload` when true).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginServerLoadHook*(reload: bool) =
  gPluginServerLoadHook(reload)

var gPluginPacketReceivedHook*: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
  proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
  ## `PacketReceivedEvent`: true when cancelled (the packet is not handled).


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callPluginPacketReceivedHook*(player: Player; packetId: int32; payload: seq[byte]): bool =
  gPluginPacketReceivedHook(player, packetId, payload)

# ---- entity, explosion and weather events (the Bukkit equivalents of EntityDamageEvent, EntityDeathEvent, EntitySpawnEvent,
# EntityRemoveEvent, ExplosionPrimeEvent and WeatherChangeEvent). The server code that has the thing happening calls these.

var gPluginEntityDamageHook*: proc(world: World; entityId: int32; entityType: string; amount: float32; damageType: string;
                                   attackerId: int32): (bool, float32) {.closure.} =
  proc(world: World; entityId: int32; entityType: string; amount: float32; damageType: string; attackerId: int32): (bool, float32) {.closure.} =
    (false, amount)
  ## A living entity is about to take damage: (cancelled, the amount after the plugins). `attackerId` is -1 when nothing caused it.

proc callPluginEntityDamageHook*(world: World; entityId: int32; entityType: string; amount: float32; damageType: string;
                                 attackerId: int32): (bool, float32) =
  gPluginEntityDamageHook(world, entityId, entityType, amount, damageType, attackerId)

var gPluginEntityDeathHook*: proc(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.} =
  proc(world: World; entityId: int32; entityType, damageType: string; killerId: int32) {.closure.} = discard
  ## A living entity died. `killerId` is -1 when there was no killer.

proc callPluginEntityDeathHook*(world: World; entityId: int32; entityType, damageType: string; killerId: int32) =
  gPluginEntityDeathHook(world, entityId, entityType, damageType, killerId)

var gPluginEntitySpawnHook*: proc(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.} =
  proc(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) {.closure.} = discard
  ## An entity was added to a world.

proc callPluginEntitySpawnHook*(world: World; entityId: int32; entityType: string; pos: Vector3[float64]) =
  gPluginEntitySpawnHook(world, entityId, entityType, pos)

var gPluginEntityRemoveHook*: proc(world: World; entityId: int32; entityType: string) {.closure.} =
  proc(world: World; entityId: int32; entityType: string) {.closure.} = discard
  ## An entity was removed from a world.

proc callPluginEntityRemoveHook*(world: World; entityId: int32; entityType: string) =
  gPluginEntityRemoveHook(world, entityId, entityType)

var gPluginExplosionHook*: proc(world: World; pos: Vector3[float64]; power: float32): bool {.closure.} =
  proc(world: World; pos: Vector3[float64]; power: float32): bool {.closure.} = false
  ## An explosion is about to happen: true when a plugin cancelled it.

proc callPluginExplosionHook*(world: World; pos: Vector3[float64]; power: float32): bool =
  gPluginExplosionHook(world, pos, power)

var gPluginWeatherHook*: proc(world: World; raining, thundering: bool) {.closure.} =
  proc(world: World; raining, thundering: bool) {.closure.} = discard
  ## The weather of a world changed to this.

proc callPluginWeatherHook*(world: World; raining, thundering: bool) =
  gPluginWeatherHook(world, raining, thundering)

# ---- health, hunger, statistics, the server list and the login (EntityRegainHealthEvent, FoodLevelChangeEvent,
# PlayerStatisticIncrementEvent, ServerListPingEvent, AsyncPlayerPreLoginEvent)

var gPluginEntityHealHook*: proc(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.} =
  proc(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) {.closure.} = (false, amount)
  ## A living entity is about to regain health: (cancelled, the amount after the plugins).

proc callPluginEntityHealHook*(world: World; entityId: int32; entityType: string; amount: float32): (bool, float32) =
  gPluginEntityHealHook(world, entityId, entityType, amount)

var gPluginFoodLevelHook*: proc(player: Player; level, previous: int): (bool, int) {.closure.} =
  proc(player: Player; level, previous: int): (bool, int) {.closure.} = (false, level)
  ## A player's food level is about to change to `level`: (cancelled, the level after the plugins).

proc callPluginFoodLevelHook*(player: Player; level, previous: int): (bool, int) =
  gPluginFoodLevelHook(player, level, previous)

var gPluginStatHook*: proc(player: Player; category, statId, amount: int32) {.closure.} =
  proc(player: Player; category, statId, amount: int32) {.closure.} = discard
  ## A player's statistic went up.

proc callPluginStatHook*(player: Player; category, statId, amount: int32) =
  gPluginStatHook(player, category, statId, amount)

var gPluginServerListPingHook*: proc(address, motd: string; online, maxPlayers: int): (string, int) {.closure.} =
  proc(address, motd: string; online, maxPlayers: int): (string, int) {.closure.} = (motd, maxPlayers)
  ## Someone asks for the server list entry: the MOTD and the maximum player count it will see.

proc callPluginServerListPingHook*(address, motd: string; online, maxPlayers: int): (string, int) =
  gPluginServerListPingHook(address, motd, online, maxPlayers)

var gPluginPreLoginHook*: proc(name, address: string): string {.closure.} =
  proc(name, address: string): string {.closure.} = ""
  ## A client asks to log in: "" to let it, else the reason it is turned away with.

proc callPluginPreLoginHook*(name, address: string): string =
  gPluginPreLoginHook(name, address)

# ---- experience level, saving and the time of day (PlayerLevelChangeEvent, WorldSaveEvent, TimeSkipEvent)

var gPluginLevelChangeHook*: proc(player: Player; previous, level: int) {.closure.} =
  proc(player: Player; previous, level: int) {.closure.} = discard
  ## A player's experience level changed.

proc callPluginLevelChangeHook*(player: Player; previous, level: int) =
  gPluginLevelChangeHook(player, previous, level)

var gPluginSaveHook*: proc() {.closure.} = proc() {.closure.} = discard
  ## The server saved everything (the `save-all` command, the periodic save).

proc callPluginSaveHook*() =
  gPluginSaveHook()

var gPluginTimeSetHook*: proc(world: World; previous, time: int64): (bool, int64) {.closure.} =
  proc(world: World; previous, time: int64): (bool, int64) {.closure.} = (false, time)
  ## The time of the day is about to be set (the `time` command): (cancelled, the time after the plugins).

proc callPluginTimeSetHook*(world: World; previous, time: int64): (bool, int64) =
  gPluginTimeSetHook(world, previous, time)

# ---- status effects (EntityPotionEffectEvent)

var gPluginEffectHook*: proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.} =
  proc(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) {.closure.} = (false, duration)
  ## A living entity is about to get a status effect: (cancelled, the duration in ticks after the plugins).

proc callPluginEffectHook*(world: World; entityId: int32; entityType, effect: string; duration, amplifier: int): (bool, int) =
  gPluginEffectHook(world, entityId, entityType, effect, duration, amplifier)

# ---- fire and entity teleports (EntityCombustEvent, EntityTeleportEvent)

var gPluginCombustHook*: proc(world: World; entityId: int32; entityType: string; ticks: int): (bool, int) {.closure.} =
  proc(world: World; entityId: int32; entityType: string; ticks: int): (bool, int) {.closure.} = (false, ticks)
  ## An entity is about to be set on fire for `ticks`: (cancelled, the ticks after the plugins).

proc callPluginCombustHook*(world: World; entityId: int32; entityType: string; ticks: int): (bool, int) =
  gPluginCombustHook(world, entityId, entityType, ticks)

var gPluginEntityTeleportHook*: proc(world: World; entityId: int32; entityType: string; fromPos, toPos: Vector3[float64]): bool {.closure.} =
  proc(world: World; entityId: int32; entityType: string; fromPos, toPos: Vector3[float64]): bool {.closure.} = false
  ## An entity is about to be teleported: true to keep it where it is.

proc callPluginEntityTeleportHook*(world: World; entityId: int32; entityType: string; fromPos, toPos: Vector3[float64]): bool =
  gPluginEntityTeleportHook(world, entityId, entityType, fromPos, toPos)

# ---- pistons (BlockPistonExtendEvent, BlockPistonRetractEvent)

var gPluginPistonHook*: proc(x, y, z: int; extend: bool; moved, broken: int): bool {.closure.} =
  proc(x, y, z: int; extend: bool; moved, broken: int): bool {.closure.} = false
  ## A piston at x, y, z is about to push (`extend`) or pull `moved` blocks and break `broken`: true to stop it.

proc callPluginPistonHook*(x, y, z: int; extend: bool; moved, broken: int): bool =
  gPluginPistonHook(x, y, z, extend, moved, broken)

# ---- projectiles (ProjectileHitEvent)

var gPluginProjectileHitHook*: proc(world: World; entityId: int32; entityType: string; ownerId: int; onEntity: bool; targetId: int;
    pos: Vector3[float64]): bool {.closure.} =
  proc(world: World; entityId: int32; entityType: string; ownerId: int; onEntity: bool; targetId: int;
    pos: Vector3[float64]): bool {.closure.} = false
  ## A thrown projectile hit a block or an entity (`targetId`): true to let it fly on.

proc callPluginProjectileHitHook*(world: World; entityId: int32; entityType: string; ownerId: int; onEntity: bool; targetId: int;
    pos: Vector3[float64]): bool =
  gPluginProjectileHitHook(world, entityId, entityType, ownerId, onEntity, targetId, pos)
