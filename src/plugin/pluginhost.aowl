## The plugin host: loads WebAssembly components, provides the host interfaces they import, and drives their
## exports. Port of pumpkin/src/plugin/loader/wasm/wasm_host/{mod,state,logging,signature}.rs,
## wit/v0_1/{mod,context,logging}.rs, wit/v0_1/commands/{mod,executor}.rs and wit/v0_1/events/mod.rs, with the
## wasmtime Store/Linker replaced by src/plugin/wasm (component.aowl over the titicaca WebAssembly interpreter).
##
## The host objects behind resource handles live in arenas here: the handle a plugin holds is its own table
## index (canonabi.aowl), whose `rep` is an index into one of `PluginHost`'s seqs (commands, nodes, senders, args)
## or a plain id supplied by the server (players, texts).
##
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/*.rs - this file provides the interfaces `logging` (log), `context`
## (register-event, register-command, register-permission, get-data-folder, get-server), `command` (command, command-node,
## consumed-args get-value; command-sender send-message/get-name/is-player/is-console) and the events dispatch
## (`handle-event` with player join/leave) are provided. Every other interface (player, world, entity, item-stack,
## block-entity, boss-bar, scoreboard, gui, forms, recipe, text, server, scheduler, ...; 90+ of the 98 WIT files in
## the newer tree's v0.1; text, scheduler, boss-bar, world, server, uuid, i18n, item-stack, block-entity, scoreboard, gui, recipe, forms and WASI are now in wit/, see their headers) is a host function that the plugin may import but that traps when called with
## "unimplemented host function <iface>#<fn>": the import is accepted so the plugin still loads.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/mod.rs - WASI p2 is wit/witwasi.aowl (stdio, environment by permission, clocks, random, the `data` preopen; no sockets or http); signature verification only warns (no market key fetch), no fuel or memory limits, no marketplace metadata.

## PARTIAL: pumpkin/src/plugin/loader/wasm/mod.rs - `WasmPluginLoader`'s load path is `preparePlugin` + `startPlugin` here (`loadPlugin` runs both); the loader object, the directory scan, unload by name and `can_load` (the `.wasm` extension) are pluginserver.aowl / managercore.aowl
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/mod.rs - instantiate, `init-plugin`, metadata and `on-load`; WASI is wit/witwasi.aowl; signature check warns only, no store limits, one wasm API version (v0.1) only, no v0.2 host
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/state.rs - the host state is `PluginHost` plus per-plugin `PluginEntry`; the WASI context is witwasi.aowl's `WasiHost`, no resource limiter, no permission checks on host calls
## Port of pumpkin/src/plugin/loader/wasm/wasm_host/logging.rs: `log-tracing` is decoded by logtracing.aowl (its PARTIAL line).
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/mod.rs - the registry of interfaces (installInterfaces) holds logging, context and command; the other 40+ interfaces are absent
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/context.rs - register-event, register-command, register-permission (accepts, registers nothing), get-data-folder; get-server and get-marketplace-metadata missing
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/commands/mod.rs - command, command-node (literal; argument of bool, float, double, integer, long with bounds, string, players, entities, entity, block-pos, rotation, block-state, block-predicate, item, item-predicate, component, particle, gamemode, difficulty, time, resource-location, mob-effect, entity-anchor, item-slot, message; every other argument type reads one word as `simple`), consumed-args.get-value for every `arg` case, every command-sender method (a command block sender answers `dummy`); `suggest-with-handler-id` and `require-with-handler-id` are kept but never asked of the plugin
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/commands/executor.rs - runs `handle-command` and maps the `command-error` variant; suggestions (`handle-command-suggestion`) are not wired
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/mod.rs - `fireEvent` builds any event variant case from its own declared type, by field name, and hands each handler's returned fields to the next and back to the caller (`EventOutcome.fieldVals`); the player events are produced by wit/witeventsplayer.aowl (see its PARTIAL), no other event family; priorities order nothing (as upstream: blocking handlers first, then non-blocking)
import std/[options, syncio, strutils]
import wasm/[wasmvm, canonabi, component]
import logtracing
import ../command/[fallbackdispatch, cmdsource, args]
import ../util/text/[textbase, text, color]
import ../util/vector3
import ../util/permission
import wit/[witstate, witall]
import api/eventsmod
import ../server/scheduler
import wit/[witplayer, witplayer3, witentity, witentity3]
import signature

const
  IfaceLogging = "pumpkin:plugin/logging"
  IfaceContext = "pumpkin:plugin/context"
  IfaceCommand = "pumpkin:plugin/command"

type
  EventReg* = object
    handlerId*: int
    eventName*: string
    priority*: int
    blocking*: bool

  PluginEntry* = ref object
    id*: int
    path*: string
    name*: string
    version*: string
    description*: string
    authors*: seq[string]
    permissions*: seq[string]
    dependencies*: seq[string]
    ci*: CompInst
    onLoad*: int
    onUnload*: int
    handleEvent*: int
    handleCommand*: int
    eventRegs*: seq[EventReg]
    dataFolder*: string
    active*: bool

  CmdNode = object
    isArgument: bool
    name: string
    argType: string          ## the `argument-type` case name (`integer`, `players`, `string`, ...)
    children: seq[int]
    handler: int
    suggestHandler: int      ## `suggest-with-handler-id` (kept; suggestions are not asked of the plugin yet)
    requireHandler: int      ## `require-with-handler-id` (kept; requirements are not asked of the plugin yet)
    hasMin: bool
    hasMax: bool
    minV: float64
    maxV: float64
    minI: int64
    maxI: int64
    strKind: int             ## string-type: 0 single-word, 1 quotable, 2 greedy

  CmdBuilder = object
    names: seq[string]
    description: string
    children: seq[int]
    handler: int

  PendingCommand = object
    pluginId: int
    builder: int
    permission: string

  EventOutcome* = object
    cancelled*: bool
    handled*: int            ## handlers that ran
    fieldNames*: seq[string] ## the fields the caller gave ...
    fieldVals*: seq[CVal]    ## ... as the last handler left them (a chat message a plugin rewrote, a join message)

  PluginHost* = ref object
    reg*: HostRegistry
    plugins*: seq[PluginEntry]
    nodes: seq[CmdNode]
    cmds: seq[CmdBuilder]
    senders: seq[CommandSender]
    argStore: seq[ConsumedArgs]
    texts*: seq[string]
    pending: seq[PendingCommand]
    registerTree*: proc (tree: CommandTree; permission: string) {.closure.}
    logLine*: proc (line: string) {.closure.}
    dataRoot*: string
    ws*: WitState                  ## state of the interfaces under wit/ (text arena, boss bars, hooks into the server)
    ext*: WitExt                   ## the state of the later interfaces: WASI, item stacks, block entities, scoreboard, gui, recipes
    events*: HandlerMap            ## the registered event handlers, in `PluginManager::fire`'s order
    unregisterName*: proc (name: string) {.closure.}              ## takes a command out of the dispatcher (plugin unload)
    reloadCommands*: proc () {.closure.}                          ## sends every player the command tree again
    registerPermission*: proc (node, description: string; defaultKind, level: int; childNodes: seq[string];
                               childValues: seq[bool]): string {.closure.}   ## "" or why it was refused

proc say(h: PluginHost; line: string) =
  if h.logLine != nil: h.logLine(line)
  else: echo line

proc pluginOf(h: PluginHost; ci: CompInst): PluginEntry = h.plugins[ci.user]

# ---- small helpers over CVal / CmType ------------------------------------------------------

proc defaultVal*(t: CmType): CVal =
  ## A zero value of any type, for fields the host has nothing to say about.
  case t.kind
  of ckString: result = vStr("")
  of ckF32, ckF64: result = vFloat(0.0)
  of ckList: result = vList(@[])
  of ckRecord, ckTuple:
    result = vRecord(@[])
    var i = 0
    while i < t.types.len:
      result.items.add defaultVal(t.types[i])
      inc i
  of ckVariant, ckOption, ckResult, ckEnum, ckFlags: result = vInt(0)
  else: result = vInt(0)

proc fieldOf*(t: CmType; v: CVal; name: string; found: var bool): CVal =
  let i = fieldIndex(t, name)
  found = i >= 0 and i < v.items.len
  if found: result = v.items[i]
  else: result = vInt(0)

proc paramType(ci: CompInst; i: int): CmType = ci.sigs[ci.funcs[ci.curFn].sig].params[i]
proc resultType0(ci: CompInst): CmType = ci.sigs[ci.funcs[ci.curFn].sig].results[0]

proc stringsOf(v: CVal): seq[string] =
  result = @[]
  var i = 0
  while i < v.items.len:
    result.add v.items[i].s
    inc i

# ---- command construction --------------------------------------------------------------------

proc consumerFor(n: CmdNode): ArgumentConsumer =
  ## The fallback dispatcher's consumer for a plugin argument type (`commands/mod.rs`'s `argument_type_to_consumer`). The types
  ## whose consumer this server lacks read one word (`simple`).
  case n.argType
  of "bool": newBoolArgConsumer()
  of "message": newMsgArgConsumer()
  of "float":
    newBoundedF32(n.name, (if n.hasMin: some(float32(n.minV)) else: none[float32]()), (if n.hasMax: some(float32(n.maxV)) else: none[float32]()))
  of "double":
    newBoundedF64(n.name, (if n.hasMin: some(n.minV) else: none[float64]()), (if n.hasMax: some(n.maxV) else: none[float64]()))
  of "integer":
    newBoundedI32(n.name, (if n.hasMin: some(int32(n.minI)) else: none[int32]()), (if n.hasMax: some(int32(n.maxI)) else: none[int32]()))
  of "long":
    newBoundedI64(n.name, (if n.hasMin: some(n.minI) else: none[int64]()), (if n.hasMax: some(n.maxI) else: none[int64]()))
  of "string": (if n.strKind == 2: newMsgArgConsumer() else: newSimpleArgConsumer())
  of "players": newPlayersArgumentConsumer()
  of "entities": newEntitiesArgumentConsumer()
  of "entity": newEntityArgumentConsumer()
  of "block-pos": newBlockPosArgumentConsumer()
  of "rotation": newRotationArgumentConsumer()
  of "block-state": newBlockArgumentConsumer()
  of "block-predicate": newBlockPredicateArgumentConsumer()
  of "item": newItemArgumentConsumer()
  of "item-predicate": newItemPredicateArgumentConsumer()
  of "component": newTextComponentArgConsumer()
  of "particle": newParticleArgumentConsumer()
  of "gamemode": newGamemodeArgumentConsumer()
  of "difficulty": newDifficultyArgumentConsumer()
  of "time": newTimeArgumentConsumer()
  of "resource-location": newResourceLocationArgumentConsumer()
  of "mob-effect": newEffectTypeArgumentConsumer()
  of "entity-anchor": newEntityAnchorArgumentConsumer()
  of "item-slot": newSlotArgumentConsumer()
  else: newSimpleArgConsumer()

proc execFor(h: PluginHost; pluginId, handlerId: int): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let pe = h.plugins[pluginId]
    h.senders.add sender
    let senderRep = h.senders.len - 1
    h.argStore.add args
    let argsRep = h.argStore.len - 1
    var res: seq[CVal] = @[]
    let ci = pe.ci
    let e = callExport(ci, pe.handleCommand, @[vInt(int64(handlerId)), vInt(int64(senderRep)), vInt(0), vInt(int64(argsRep))], res)
    if e.len > 0:
      say(h, "[" & pe.name & "] command handler failed: " & e)
      return cmdFailed(text("The plugin command failed: " & e))
    let rt = ci.sigs[ci.funcs[pe.handleCommand].sig].results[0]
    if res.len == 0: return cmdSuccess(0'i32)
    if res[0].i == 0: return cmdSuccess(int32(res[0].items[0].i))
    # the err case: a command-error variant
    let errT = rt.types[1]
    let ecase = int(res[0].items[0].i)
    let ename = (if ecase < errT.names.len: errT.names[ecase] else: "")
    if ename == "invalid-consumption": return cmdInvalidConsumption(none[string]())
    if ename == "invalid-requirement": return cmdInvalidRequirement()
    if ename == "permission-denied": return cmdPermissionDenied()
    cmdFailed(text("The plugin command failed."))

proc buildNode(h: PluginHost; pluginId, idx: int): NonLeafNodeBuilder =
  if h.nodes[idx].isArgument: result = argument(h.nodes[idx].name, consumerFor(h.nodes[idx]))
  else: result = literal(h.nodes[idx].name)
  var i = 0
  while i < h.nodes[idx].children.len:
    result = then(result, buildNode(h, pluginId, h.nodes[idx].children[i]))
    inc i
  if h.nodes[idx].handler >= 0:
    result = execute(result, execFor(h, pluginId, h.nodes[idx].handler))

proc buildTree(h: PluginHost; pluginId, idx: int): CommandTree =
  result = newCommandTree(h.cmds[idx].names, h.cmds[idx].description)
  var i = 0
  while i < h.cmds[idx].children.len:
    result = then(result, buildNode(h, pluginId, h.cmds[idx].children[i]))
    inc i
  if h.cmds[idx].handler >= 0:
    result = execute(result, execFor(h, pluginId, h.cmds[idx].handler))

# ---- host interfaces ---------------------------------------------------------------------------

proc levelName(i: int): string =
  case i
  of 0: "TRACE"
  of 1: "DEBUG"
  of 2: "INFO"
  of 3: "WARN"
  else: "ERROR"

proc installInterfaces*(h: PluginHost) =
  let r = h.reg
  # logging
  r.defineHostFn(IfaceLogging, "log", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    say(h, "[" & pluginOf(h, ci).name & "] " & levelName(int(args[0].i)) & ": " & args[1].s)
    result = "")
  r.defineHostFn(IfaceLogging, "log-tracing", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    var bytes = ""
    for it in args[0].items: bytes.add char(it.i and 0xFF)
    let (lv, line) = logTracing(bytes)
    say(h, "[" & pluginOf(h, ci).name & "] " & levelName(lv) & ": " & line)
    result = "")
  # context
  r.defineHostFn(IfaceContext, "[method]context.get-data-folder", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vStr(pluginOf(h, ci).dataFolder)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-event", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let et = paramType(ci, 2)
    let ev = int(args[3].i)
    let pe = pluginOf(h, ci)
    let evName = (if int(args[2].i) < et.names.len: et.names[int(args[2].i)] else: "")
    pe.eventRegs.add EventReg(handlerId: int(args[1].i), eventName: evName, priority: ev, blocking: args[4].i != 0)
    h.events.register(HandlerReg(pluginId: pe.id, handlerId: int(args[1].i), eventName: evName, priority: priorityOf(ev),
                                 blocking: args[4].i != 0))
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-permission", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    # args: self, permission{node, description, default, children: list<permission-child{node, value}>}
    let pe = pluginOf(h, ci)
    let node = args[1].items[0].s
    if not node.startsWith(pe.name & ":"):
      results.add vVariant(1, vStr("Permission " & node & " must use the plugin's namespace (" & pe.name & ")"))
    else:
      var childNodes: seq[string] = @[]
      var childValues: seq[bool] = @[]
      for c in args[1].items[3].items:
        childNodes.add c.items[0].s
        childValues.add c.items[1].i != 0
      let dflt = args[1].items[2]
      let lvl = (if dflt.items.len > 0: int(dflt.items[0].i) else: 0)
      var msg = ""
      if h.registerPermission != nil:
        msg = h.registerPermission(node, args[1].items[1].s, int(dflt.i), lvl, childNodes, childValues)
      if msg.len > 0: results.add vVariant(1, vStr(msg))
      else: results.add vVariant(0)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.get-server", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vInt(0)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.get-marketplace-metadata", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vNone()
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-command", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let pe = pluginOf(h, ci)
    # `Context::register_command`: the tree is tagged with the plugin as its source, the permission node is the plugin's
    # namespace unless it has one, and every player gets the command tree again.
    let perm = (if args[2].s.contains(':'): args[2].s else: pe.name & ":" & args[2].s)
    h.pending.add PendingCommand(pluginId: pe.id, builder: int(args[1].i), permission: perm)
    if h.registerTree != nil:
      let tree = buildTree(h, pe.id, int(args[1].i))
      tree.source = some(pe.name)
      h.registerTree(tree, perm)
      if h.reloadCommands != nil: h.reloadCommands()
    result = "")
  # command
  r.defineHostFn(IfaceCommand, "[constructor]command", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds.add CmdBuilder(names: stringsOf(args[0]), description: args[1].s, children: @[], handler: -1)
    results.add vInt(int64(h.cmds.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command.then", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds[int(args[0].i)].children.add int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command.execute-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds[int(args[0].i)].handler = int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[static]command-node.literal", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes.add CmdNode(isArgument: false, name: args[0].s, argType: "", children: @[], handler: -1, suggestHandler: -1, requireHandler: -1)
    results.add vInt(int64(h.nodes.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[static]command-node.argument", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let at = paramType(ci, 1)
    let cname = (if int(args[1].i) < at.names.len: at.names[int(args[1].i)] else: "string")
    var node = CmdNode(isArgument: true, name: args[0].s, argType: cname, children: @[], handler: -1, suggestHandler: -1, requireHandler: -1)
    if args[1].items.len > 0:
      let pl = args[1].items[0]
      case cname
      of "float", "double":
        if pl.items[0].i != 0:
          node.hasMin = true
          node.minV = pl.items[0].items[0].f
        if pl.items[1].i != 0:
          node.hasMax = true
          node.maxV = pl.items[1].items[0].f
      of "integer", "long":
        if pl.items[0].i != 0:
          node.hasMin = true
          node.minI = pl.items[0].items[0].i
        if pl.items[1].i != 0:
          node.hasMax = true
          node.maxI = pl.items[1].items[0].i
      of "string": node.strKind = int(pl.i)
      else: discard
    h.nodes.add node
    results.add vInt(int64(h.nodes.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.then", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].children.add int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.execute-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].handler = int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.suggest-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].suggestHandler = int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.require-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].requireHandler = int(args[1].i)
    result = "")
  # ---- command-sender
  r.defineHostFn(IfaceCommand, "[method]command-sender.send-message", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    sendMessage(h.senders[int(args[0].i)], textAt(h.ws, int(args[1].i)))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.send-system-message", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    sendMessage(h.senders[int(args[0].i)], textAt(h.ws, int(args[1].i)))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.send-error", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    # `send_error`: the message in red
    let m = textAt(h.ws, int(args[1].i))
    sendMessage(h.senders[int(args[0].i)], m.colorNamed(ncRed))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.get-name", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vStr(displayText(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.set-success-count", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    setSuccessCount(h.senders[int(args[0].i)], uint32(max(0'i64, args[1].i)))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.is-player", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(isPlayer(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.is-console", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(isConsole(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.get-command-sender-type", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    # command-sender-type { rcon, console, player(player), command-block(tuple<..>), dummy }; a command block answers `dummy`
    # (the block-entity and world handles of its payload are not made here)
    let snd = h.senders[int(args[0].i)]
    case snd.kind
    of cskRcon: results.add vVariant(0)
    of cskConsole: results.add vVariant(1)
    of cskPlayer: results.add vVariant(2, vInt(int64(snd.player.entity.entityId)))
    of cskCommandBlock, cskDummy: results.add vVariant(4)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.as-player", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let snd = h.senders[int(args[0].i)]
    if snd.kind == cskPlayer: results.add vSome(vInt(int64(snd.player.entity.entityId)))
    else: results.add vNone()
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.permission-level", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vInt(int64(ord(permissionLvl(h.senders[int(args[0].i)]))))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.has-permission-level", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(hasPermissionLvl(h.senders[int(args[0].i)], PermissionLvl(int(args[1].i))))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.has-permission", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(hasPermission(h.senders[int(args[0].i)], nil, args[2].s))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.position", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
    if position(h.senders[int(args[0].i)], pos): results.add vSome(vRecord(@[vFloat(pos.x), vFloat(pos.y), vFloat(pos.z)]))
    else: results.add vNone()
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.world", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    # the world handle is the index in server.worlds; found through the sender's player when it has one
    let snd = h.senders[int(args[0].i)]
    if snd.kind == cskPlayer and h.ws.hooks.playerWorld != nil:
      let w = h.ws.hooks.playerWorld(int(snd.player.entity.entityId))
      if w >= 0:
        results.add vSome(vInt(int64(w)))
        return ""
    results.add vNone()
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.should-receive-feedback", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(shouldReceiveFeedback(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.should-broadcast-console-to-ops", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(shouldBroadcastConsoleToOps(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.should-track-output", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vBool(shouldTrackOutput(h.senders[int(args[0].i)]))
    result = "")
  # ---- consumed-args
  r.defineHostFn(IfaceCommand, "[method]consumed-args.get-value", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let rt = resultType0(ci)
    let rep = int(args[0].i)
    var idx = -1
    var i = 0
    while i < h.argStore[rep].len:
      if h.argStore[rep][i].name == args[1].s: idx = i
      inc i
    if idx < 0: return "consumed-args: no argument called " & args[1].s
    results.add argValue(h, rt, h.argStore[rep][idx].arg)
    result = "")

proc numberVal(n: Number): CVal =
  case n.kind
  of nkF64: vVariant(0, vFloat(n.f64))
  of nkF32: vVariant(1, vFloat(float64(n.f32)))
  of nkI32: vVariant(2, vInt(int64(n.i32)))
  of nkI64: vVariant(3, vInt(n.i64))

proc enumPayload(rt: CmType; caseName: string; value: string): CVal =
  ## A variant case whose payload is an enum spelled by `value`.
  let ci0 = caseIndex(rt, caseName)
  let pt = rt.types[max(ci0, 0)]
  vVariant(max(ci0, 0), vInt(int64(max(0, caseIndex(pt, value.toLowerAscii().replace("_", "-"))))))

proc strCaseOf(rt: CmType; name, v: string): CVal = vVariant(max(0, caseIndex(rt, name)), vStr(v))

proc argValue(h: PluginHost; rt: CmType; a: Arg): CVal =
  ## An `Arg` of the dispatcher as the WIT `arg` variant (`ArgImpl` of commands/mod.rs). The entity arguments answer their
  ## players (the WIT `arg` has no entity case); `pos3d` / `pos2d` take the coordinates as parsed.
  case a.kind
  of akBool: vVariant(max(0, caseIndex(rt, "bool")), vBool(a.boolean))
  of akMsg: strCaseOf(rt, "msg", a.str)
  of akItem: strCaseOf(rt, "item", a.str)
  of akItemPredicate: strCaseOf(rt, "item-predicate", a.str)
  of akResourceLocation: strCaseOf(rt, "resource-location", a.str)
  of akBlock: strCaseOf(rt, "block", a.str)
  of akBlockPredicate: strCaseOf(rt, "block-predicate", a.str)
  of akParticle: strCaseOf(rt, "particle", a.str)
  of akDamageType: strCaseOf(rt, "damage-type", a.str)
  of akEffect: strCaseOf(rt, "effect", a.str)
  of akEnchantment: strCaseOf(rt, "enchantment", a.str)
  of akAdvancement: strCaseOf(rt, "advancement", a.str)
  of akTime: vVariant(max(0, caseIndex(rt, "time")), vInt(int64(a.time)))
  of akNum:
    if a.numInBounds:
      vVariant(max(0, caseIndex(rt, "num")), vVariant(0, numberVal(a.num)))
    else:
      vVariant(max(0, caseIndex(rt, "num")), vVariant(1, vVariant((if a.numOverflowLow: 0 else: 1), vRecord(@[numberVal(a.num), numberVal(a.numBound)]))))
  of akBlockPos:
    vVariant(max(0, caseIndex(rt, "block-pos")), vRecord(@[vInt(int64(a.blockPos.x)), vInt(int64(a.blockPos.y)), vInt(int64(a.blockPos.z))]))
  of akPos3D: vVariant(max(0, caseIndex(rt, "pos3d")), vRecord(@[vFloat(a.pos3D.x), vFloat(a.pos3D.y), vFloat(a.pos3D.z)]))
  of akPos2D: vVariant(max(0, caseIndex(rt, "pos2d")), vRecord(@[vFloat(a.pos2D.x), vFloat(a.pos2D.y)]))
  of akRotation:
    vVariant(max(0, caseIndex(rt, "rotation")), vRecord(@[vFloat(float64(a.yaw)), vBool(a.yawRelative), vFloat(float64(a.pitch)), vBool(a.pitchRelative)]))
  of akGameMode: vVariant(max(0, caseIndex(rt, "gamemode")), vInt(int64(ord(a.gameMode))))
  of akDifficulty: vVariant(max(0, caseIndex(rt, "difficulty")), vInt(int64(ord(a.difficulty))))
  of akPlayers, akEntities, akEntity:
    var ids: seq[CVal] = @[]
    for p in a.players: ids.add vInt(int64(p.entity.entityId))
    for e in a.entities:
      if e.player != nil: ids.add vInt(int64(e.entityId))
    vVariant(max(0, caseIndex(rt, "players")), vList(ids))
  of akTextComponent: vVariant(max(0, caseIndex(rt, "text-component")), vInt(int64(newTextRep(h.ws, a.textComponent))))
  of akBossbarColor: enumPayload(rt, "bossbar-color", a.str)
  of akBossbarStyle: enumPayload(rt, "bossbar-style", a.str)
  of akSoundCategory: enumPayload(rt, "sound-category", a.str)
  of akEntityAnchor: vVariant(max(0, caseIndex(rt, "entity-anchor")), vInt(int64(ord(a.anchor))))
  else: strCaseOf(rt, "simple", a.str)

proc newPluginHost*(dataRoot: string): PluginHost =
  result = PluginHost(reg: newHostRegistry(), plugins: @[], nodes: @[], cmds: @[], senders: @[], argStore: @[],
                      texts: @[], pending: @[], dataRoot: dataRoot, ws: newWitState(), events: newHandlerMap())
  let hh = result
  result.ws.legacyText = proc (rep: int): string {.closure.} =
    if rep >= 0 and rep < hh.texts.len: hh.texts[rep] else: ""
  result.ext = installWitInterfaces(result.reg, result.ws)
  result.ext.wasi.log = proc (pluginId: int; isErr: bool; line: string) {.closure.} =
    say(hh, "[" & (if pluginId >= 0 and pluginId < hh.plugins.len: hh.plugins[pluginId].name else: "?") & "] " &
        (if isErr: "stderr: " else: "stdout: ") & line)
  result.ext.wasi.permissions = proc (pluginId: int): seq[string] {.closure.} =
    if pluginId >= 0 and pluginId < hh.plugins.len: hh.plugins[pluginId].permissions else: @[]
  result.ext.wasi.fs.dataFolder = proc (pluginId: int): string {.closure.} =
    if pluginId >= 0 and pluginId < hh.plugins.len: hh.plugins[pluginId].dataFolder else: ""
  installPlayer(result.reg, result.ws)
  installPlayer3(result.reg, result.ws, result.ext.stacks, result.ext.guis)
  installEntity(result.reg, result.ws)
  installEntity3(result.reg, result.ws, result.ext.stacks)
  installInterfaces(result)

# ---- loading ---------------------------------------------------------------------------------

proc dropPluginState(h: PluginHost; id: int) =
  ## What a plugin leaves in the host: scheduled tasks (`cancel_all_tasks`), event handlers, the commands it registered, a
  ## partial last line of its stdout.
  let pe = h.plugins[id]
  pe.active = false
  h.ws.sched.cancelAllTasks(id)
  h.events.unregisterPlugin(id)
  pe.eventRegs = @[]
  var kept: seq[PendingCommand] = @[]
  for pc in h.pending:
    if pc.pluginId == id:
      if h.unregisterName != nil:
        for nm in h.cmds[pc.builder].names: h.unregisterName(nm)
    else:
      kept.add pc
  let hadCommands = kept.len != h.pending.len
  h.pending = kept
  if hadCommands and h.reloadCommands != nil: h.reloadCommands()
  flushPlugin(h.ext.wasi, id)

proc discardPlugin*(h: PluginHost; id: int) =
  ## A plugin that was prepared but will not be started (its load failed, or its permissions were refused).
  dropPluginState(h, id)

proc preparePlugin*(h: PluginHost; path: string; bytes: string; idOut: var int): string =
  ## `WasmPluginLoader::load`: instantiates the component and runs `init-plugin`, then reads its metadata. Nothing is
  ## registered yet; `startPlugin` runs `on-load`. Returns "" or the reason.
  let id = h.plugins.len
  idOut = id
  let vm = newWasmVm()
  let ci = newCompInst(vm, h.reg, id)
  let pe = PluginEntry(id: id, path: path, name: path, version: "", description: "", authors: @[], permissions: @[],
                       dependencies: @[], ci: ci, onLoad: -1, onUnload: -1, handleEvent: -1, handleCommand: -1,
                       eventRegs: @[], dataFolder: h.dataRoot & "/" & path, active: false)
  h.plugins.add pe
  # `verify_wasm_plugin`: warns about an unsigned plugin or a failed signature, never refuses to load
  verifyWasmPlugin(bytes, path, "", proc (line: string) {.closure.} = say(h, line))
  if not instantiateComponent(ci, bytes): return "load failed: " & ci.err
  pe.onLoad = findExportFunc(ci, "on-load")
  pe.onUnload = findExportFunc(ci, "on-unload")
  pe.handleEvent = findExportFunc(ci, "handle-event")
  pe.handleCommand = findExportFunc(ci, "handle-command")
  if pe.onLoad < 0: return "missing export on-load"
  var res: seq[CVal] = @[]
  let initFn = findExportFunc(ci, "init-plugin")
  if initFn >= 0:
    let e0 = callExport(ci, initFn, @[], res)
    if e0.len > 0: return "init-plugin: " & e0
  # metadata
  let mf = findExportFunc(ci, "pumpkin:plugin/metadata#get-metadata")
  if mf >= 0:
    res = @[]
    let e1 = callExport(ci, mf, @[], res)
    if e1.len > 0: return "metadata: " & e1
    let mt = ci.sigs[ci.funcs[mf].sig].results[0]
    var found = false
    pe.name = fieldOf(mt, res[0], "name", found).s
    pe.version = fieldOf(mt, res[0], "version", found).s
    pe.description = fieldOf(mt, res[0], "description", found).s
    pe.authors = stringsOf(fieldOf(mt, res[0], "authors", found))
    pe.permissions = stringsOf(fieldOf(mt, res[0], "permissions", found))
    let deps = fieldOf(mt, res[0], "dependencies", found)
    if found: pe.dependencies = stringsOf(deps)
    pe.dataFolder = h.dataRoot & "/" & pe.name
  var i = 0
  while i < ci.unresolved.len:
    say(h, "[" & pe.name & "] imports " & ci.unresolved[i] & ", which this server does not provide")
    inc i
  result = ""

proc startPlugin*(h: PluginHost; id: int): string =
  ## `WasmPlugin::on_load`: runs `on-load(context)`. Returns "" or the reason; the plugin is active on success. A failure
  ## calls `on-unload` and drops everything the plugin registered, as `spawn_plugin_initialization` does.
  let pe = h.plugins[id]
  var res: seq[CVal] = @[]
  let e2 = callExport(pe.ci, pe.onLoad, @[vInt(int64(id))], res)
  var err = ""
  if e2.len > 0: err = "on-load: " & e2
  elif res.len > 0 and res[0].i != 0:
    err = "on-load returned an error: " & (if res[0].items.len > 0: res[0].items[0].s else: "")
  if err.len > 0:
    if pe.onUnload >= 0:
      var r2: seq[CVal] = @[]
      discard callExport(pe.ci, pe.onUnload, @[vInt(int64(id))], r2)
    dropPluginState(h, id)
    return err
  pe.active = true
  result = ""

proc loadPlugin*(h: PluginHost; path: string; bytes: string): string =
  ## Instantiates the component, reads its metadata and runs `init-plugin` and `on-load`. Returns "" or the reason.
  var id = -1
  let e = preparePlugin(h, path, bytes, id)
  if e.len > 0:
    dropPluginState(h, id)
    return e
  result = startPlugin(h, id)

proc unloadPlugin*(h: PluginHost; id: int): string =
  ## `WasmPlugin::on_unload` and the manager's unload: the plugin's scheduled tasks are cancelled first, then its
  ## `on-unload` runs, then its handlers and commands go.
  let pe = h.plugins[id]
  if not pe.active: return ""
  h.ws.sched.cancelAllTasks(id)
  var failure = ""
  if pe.onUnload >= 0:
    var res: seq[CVal] = @[]
    let e = callExport(pe.ci, pe.onUnload, @[vInt(int64(id))], res)
    if e.len > 0: failure = "on-unload: " & e
  dropPluginState(h, id)
  result = failure

proc findActive*(h: PluginHost; name: string): int =
  ## The id of the active plugin called `name`, -1 if none.
  result = -1
  for p in h.plugins:
    if p.active and p.name == name: result = p.id

# ---- events ----------------------------------------------------------------------------------

proc fireEvent*(h: PluginHost; eventName: string; fieldNames: seq[string]; fieldVals: seq[CVal]): EventOutcome =
  ## Offers `eventName` to every active plugin that registered for it. The event value is built from each plugin's own
  ## `event` variant type: the case named `eventName`, its record filled by field name (the ones given, defaults for the
  ## rest). Upstream: `PluginManager::fire` and `WasmPlugin::handle_event`: the blocking handlers run first, in
  ## registration order, each seeing what the one before left in the event (`handle_blocking` stores the returned event
  ## back), and `cancelled` comes from them. The non-blocking handlers run after, on the final event, and what they
  ## return is dropped (`handle`). The WIT `priority` is stored by upstream and orders nothing, and a cancelled event
  ## still reaches every handler: neither is done here either.
  result = EventOutcome(cancelled: false, handled: 0, fieldNames: fieldNames, fieldVals: fieldVals)
  var pass = 0
  while pass < 2:
    var p = 0
    while p < h.plugins.len:
      let pe = h.plugins[p]
      if pe.active and pe.handleEvent >= 0:
        var r = 0
        while r < pe.eventRegs.len:
          if pe.eventRegs[r].eventName == eventName and pe.eventRegs[r].blocking == (pass == 0):
            let sig = funcSig(pe.ci, pe.handleEvent)
            let evT = sig.params[2]
            let ci0 = caseIndex(evT, eventName)
            if ci0 >= 0:
              let payloadT = evT.types[ci0]
              var rec = vRecord(@[])
              var f = 0
              while f < payloadT.types.len:
                var v = defaultVal(payloadT.types[f])
                var k = 0
                while k < fieldNames.len:
                  if payloadT.names[f] == fieldNames[k]: v = result.fieldVals[k]
                  inc k
                rec.items.add v
                inc f
              var res: seq[CVal] = @[]
              let e = callExport(pe.ci, pe.handleEvent, @[vInt(int64(pe.eventRegs[r].handlerId)), vInt(0), vVariant(ci0, rec)], res)
              if e.len > 0:
                say(h, "[" & pe.name & "] event handler failed: " & e)
              else:
                inc result.handled
                if pass == 0 and res.len > 0 and res[0].items.len > 0:
                  var found = false
                  let c = fieldOf(payloadT, res[0].items[0], "cancelled", found)
                  if found and c.i != 0: result.cancelled = true
                  if res[0].i == int64(ci0):
                    # the next handler sees what this one left in the event
                    var k2 = 0
                    while k2 < fieldNames.len:
                      let nv = fieldOf(payloadT, res[0].items[0], fieldNames[k2], found)
                      if found: result.fieldVals[k2] = nv
                      inc k2
          inc r
      inc p
    inc pass

proc activeCount*(h: PluginHost): int =
  result = 0
  for p in h.plugins:
    if p.active: inc result

proc runTask*(h: PluginHost; pluginId, handlerId: int): string =
  ## Calls the plugin's `handle-task(handler-id, server)` for a due scheduled task (`WasmPlugin::handle_task`).
  ## Returns "" or why it failed. Tasks of an unloaded plugin or of a plugin without the export are skipped.
  if pluginId < 0 or pluginId >= h.plugins.len: return ""
  let pe = h.plugins[pluginId]
  if not pe.active: return ""
  let f = findExportFunc(pe.ci, "handle-task")
  if f < 0: return ""
  var res: seq[CVal] = @[]
  let e = callExport(pe.ci, f, @[vInt(int64(handlerId)), vInt(0)], res)
  if e.len > 0:
    say(h, "[" & pe.name & "] scheduled task failed: " & e)
    return e
  result = ""
