## The plugin host: loads WebAssembly components, provides the host interfaces they import, and drives their
## exports. Port of pumpkin/src/plugin/loader/wasm/wasm_host/{mod,state,logging,signature}.rs,
## wit/v0_1/{mod,context,logging}.rs, wit/v0_1/commands/{mod,executor}.rs and wit/v0_1/events/mod.rs, with the
## wasmtime Store/Linker replaced by src/plugin/wasm (component.aowl over the titicaca WebAssembly interpreter).
##
## The host objects behind resource handles live in arenas here: the handle a plugin holds is its own table
## index (canonabi.aowl), whose `rep` is an index into one of `PluginHost`'s seqs (commands, nodes, senders, args)
## or a plain id supplied by the server (players, texts).
##
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/*.rs - only the interfaces `logging` (log), `context`
## (register-event, register-command, register-permission, get-data-folder), `command` (command, command-node,
## consumed-args get-value; command-sender send-message/get-name/is-player/is-console) and the events dispatch
## (`handle-event` with player join/leave) are provided. Every other interface (player, world, entity, item-stack,
## block-entity, boss-bar, scoreboard, gui, forms, recipe, text, server, scheduler, ...; 90+ of the 98 WIT files in
## the newer tree's v0.1) is a host function that the plugin may import but that traps when called with
## "unimplemented host function <iface>#<fn>": the import is accepted so the plugin still loads.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/mod.rs - WASI p2 (wasi:cli, wasi:io, wasi:clocks, wasi:random,
## wasi:filesystem, wasi:http, which Rust std plugins import) is not provided, so a plugin built for wasm32-wasip2 loads
## but traps on its first WASI call; no signature verification, no fuel or memory limits, no marketplace metadata.

## PARTIAL: pumpkin/src/plugin/loader/wasm/mod.rs - `WasmPluginLoader`'s load path is `loadPlugin` here; no directory scan of its own (pluginmgr.aowl scans), no unload-by-name, no `can_load` check beyond the `.wasm` extension
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/mod.rs - instantiate, `init-plugin`, metadata and `on-load`; no WASI, no signature check, no store limits, one wasm API version (v0.1) only, no v0.2 host
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/state.rs - the host state is `PluginHost` plus per-plugin `PluginEntry`; no WASI ctx, no resource limiter, no permission checks on host calls
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/logging.rs - `logging.log` only (to the host's log line writer); `log-tracing` is not decoded
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/mod.rs - the registry of interfaces (installInterfaces) holds logging, context and command; the other 40+ interfaces are absent
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/context.rs - register-event, register-command, register-permission (accepts, registers nothing), get-data-folder; get-server and get-marketplace-metadata missing
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/commands/mod.rs - command, command-node (literal, argument as simple/bool/message consumers), consumed-args.get-value for simple and bool, command-sender send-message and get-name; the other ~40 argument types and the rest of command-sender are missing
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/commands/executor.rs - runs `handle-command` and maps the `command-error` variant; suggestions (`handle-command-suggestion`) are not wired
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/mod.rs - `fireEvent` builds any event variant case from its own declared type, by field name; only the player join and leave payloads are produced by the server, and the returned event is read for `cancelled` only
import std/[options, syncio]
import wasm/[wasmvm, canonabi, component]
import ../command/[fallbackdispatch, cmdsource, args]
import ../util/text/[textbase, text]

const
  IfaceLogging = "pumpkin:plugin/logging"
  IfaceContext = "pumpkin:plugin/context"
  IfaceCommand = "pumpkin:plugin/command"

type
  EventReg* = object
    handlerId*: int
    eventName*: string
    priority*: int
    blocking*: bool

  PluginEntry* = ref object
    id*: int
    path*: string
    name*: string
    version*: string
    description*: string
    authors*: seq[string]
    permissions*: seq[string]
    ci*: CompInst
    onLoad*: int
    onUnload*: int
    handleEvent*: int
    handleCommand*: int
    eventRegs*: seq[EventReg]
    dataFolder*: string
    active*: bool

  CmdNode = object
    isArgument: bool
    name: string
    argType: string
    children: seq[int]
    handler: int

  CmdBuilder = object
    names: seq[string]
    description: string
    children: seq[int]
    handler: int

  PendingCommand = object
    pluginId: int
    builder: int
    permission: string

  EventOutcome* = object
    cancelled*: bool
    handled*: int            ## handlers that ran

  PluginHost* = ref object
    reg*: HostRegistry
    plugins*: seq[PluginEntry]
    nodes: seq[CmdNode]
    cmds: seq[CmdBuilder]
    senders: seq[CommandSender]
    argStore: seq[ConsumedArgs]
    texts*: seq[string]
    pending: seq[PendingCommand]
    registerTree*: proc (tree: CommandTree; permission: string) {.closure.}
    logLine*: proc (line: string) {.closure.}
    dataRoot*: string

proc say(h: PluginHost; line: string) =
  if h.logLine != nil: h.logLine(line)
  else: echo line

proc pluginOf(h: PluginHost; ci: CompInst): PluginEntry = h.plugins[ci.user]

# ---- small helpers over CVal / CmType ------------------------------------------------------

proc defaultVal*(t: CmType): CVal =
  ## A zero value of any type, for fields the host has nothing to say about.
  case t.kind
  of ckString: result = vStr("")
  of ckF32, ckF64: result = vFloat(0.0)
  of ckList: result = vList(@[])
  of ckRecord, ckTuple:
    result = vRecord(@[])
    var i = 0
    while i < t.types.len:
      result.items.add defaultVal(t.types[i])
      inc i
  of ckVariant, ckOption, ckResult, ckEnum, ckFlags: result = vInt(0)
  else: result = vInt(0)

proc fieldOf*(t: CmType; v: CVal; name: string; found: var bool): CVal =
  let i = fieldIndex(t, name)
  found = i >= 0 and i < v.items.len
  if found: result = v.items[i]
  else: result = vInt(0)

proc paramType(ci: CompInst; i: int): CmType = ci.sigs[ci.funcs[ci.curFn].sig].params[i]
proc resultType0(ci: CompInst): CmType = ci.sigs[ci.funcs[ci.curFn].sig].results[0]

proc stringsOf(v: CVal): seq[string] =
  result = @[]
  var i = 0
  while i < v.items.len:
    result.add v.items[i].s
    inc i

# ---- command construction --------------------------------------------------------------------

proc consumerFor(argType: string): ArgumentConsumer =
  case argType
  of "bool": newBoolArgConsumer()
  of "message": newMsgArgConsumer()
  else: newSimpleArgConsumer()

proc execFor(h: PluginHost; pluginId, handlerId: int): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let pe = h.plugins[pluginId]
    h.senders.add sender
    let senderRep = h.senders.len - 1
    h.argStore.add args
    let argsRep = h.argStore.len - 1
    var res: seq[CVal] = @[]
    let ci = pe.ci
    let e = callExport(ci, pe.handleCommand, @[vInt(int64(handlerId)), vInt(int64(senderRep)), vInt(0), vInt(int64(argsRep))], res)
    if e.len > 0:
      say(h, "[" & pe.name & "] command handler failed: " & e)
      return cmdFailed(text("The plugin command failed: " & e))
    let rt = ci.sigs[ci.funcs[pe.handleCommand].sig].results[0]
    if res.len == 0: return cmdSuccess(0'i32)
    if res[0].i == 0: return cmdSuccess(int32(res[0].items[0].i))
    # the err case: a command-error variant
    let errT = rt.types[1]
    let ecase = int(res[0].items[0].i)
    let ename = (if ecase < errT.names.len: errT.names[ecase] else: "")
    if ename == "invalid-consumption": return cmdInvalidConsumption(none[string]())
    if ename == "invalid-requirement": return cmdInvalidRequirement()
    if ename == "permission-denied": return cmdPermissionDenied()
    cmdFailed(text("The plugin command failed."))

proc buildNode(h: PluginHost; pluginId, idx: int): NonLeafNodeBuilder =
  if h.nodes[idx].isArgument: result = argument(h.nodes[idx].name, consumerFor(h.nodes[idx].argType))
  else: result = literal(h.nodes[idx].name)
  var i = 0
  while i < h.nodes[idx].children.len:
    result = then(result, buildNode(h, pluginId, h.nodes[idx].children[i]))
    inc i
  if h.nodes[idx].handler >= 0:
    result = execute(result, execFor(h, pluginId, h.nodes[idx].handler))

proc buildTree(h: PluginHost; pluginId, idx: int): CommandTree =
  result = newCommandTree(h.cmds[idx].names, h.cmds[idx].description)
  var i = 0
  while i < h.cmds[idx].children.len:
    result = then(result, buildNode(h, pluginId, h.cmds[idx].children[i]))
    inc i
  if h.cmds[idx].handler >= 0:
    result = execute(result, execFor(h, pluginId, h.cmds[idx].handler))

# ---- host interfaces ---------------------------------------------------------------------------

proc levelName(i: int): string =
  case i
  of 0: "TRACE"
  of 1: "DEBUG"
  of 2: "INFO"
  of 3: "WARN"
  else: "ERROR"

proc installInterfaces*(h: PluginHost) =
  let r = h.reg
  # logging
  r.defineHostFn(IfaceLogging, "log", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    say(h, "[" & pluginOf(h, ci).name & "] " & levelName(int(args[0].i)) & ": " & args[1].s)
    result = "")
  # context
  r.defineHostFn(IfaceContext, "[method]context.get-data-folder", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vStr(pluginOf(h, ci).dataFolder)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-event", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let et = paramType(ci, 2)
    let ev = int(args[3].i)
    let pe = pluginOf(h, ci)
    pe.eventRegs.add EventReg(handlerId: int(args[1].i), eventName: (if int(args[2].i) < et.names.len: et.names[int(args[2].i)] else: ""),
                              priority: ev, blocking: args[4].i != 0)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-permission", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vVariant(0)
    result = "")
  r.defineHostFn(IfaceContext, "[method]context.register-command", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let pe = pluginOf(h, ci)
    h.pending.add PendingCommand(pluginId: pe.id, builder: int(args[1].i), permission: args[2].s)
    if h.registerTree != nil:
      h.registerTree(buildTree(h, pe.id, int(args[1].i)), args[2].s)
    result = "")
  # command
  r.defineHostFn(IfaceCommand, "[constructor]command", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds.add CmdBuilder(names: stringsOf(args[0]), description: args[1].s, children: @[], handler: -1)
    results.add vInt(int64(h.cmds.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command.then", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds[int(args[0].i)].children.add int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command.execute-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.cmds[int(args[0].i)].handler = int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[static]command-node.literal", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes.add CmdNode(isArgument: false, name: args[0].s, argType: "", children: @[], handler: -1)
    results.add vInt(int64(h.nodes.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[static]command-node.argument", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let at = paramType(ci, 1)
    let cname = (if int(args[1].i) < at.names.len: at.names[int(args[1].i)] else: "string")
    var kind = cname
    if cname == "string" and args[1].items.len > 0 and args[1].items[0].i == 2: kind = "message"   # string-type greedy
    h.nodes.add CmdNode(isArgument: true, name: args[0].s, argType: kind, children: @[], handler: -1)
    results.add vInt(int64(h.nodes.len - 1))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.then", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].children.add int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-node.execute-with-handler-id", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    h.nodes[int(args[0].i)].handler = int(args[1].i)
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.send-message", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let rep = int(args[0].i)
    let ti = int(args[1].i)
    sendMessage(h.senders[rep], text(if ti >= 0 and ti < h.texts.len: h.texts[ti] else: ""))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]command-sender.get-name", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    results.add vStr(displayText(h.senders[int(args[0].i)]))
    result = "")
  r.defineHostFn(IfaceCommand, "[method]consumed-args.get-value", proc (ci: CompInst; args: seq[CVal]; results: var seq[CVal]): string {.closure.} =
    let rt = resultType0(ci)
    var found = ""
    var i = 0
    let rep = int(args[0].i)
    var isBool = false
    var bval = false
    while i < h.argStore[rep].len:
      if h.argStore[rep][i].name == args[1].s:
        found = h.argStore[rep][i].arg.str
        if h.argStore[rep][i].arg.kind == akBool:
          isBool = true
          bval = h.argStore[rep][i].arg.boolean
      inc i
    if isBool: results.add vVariant(max(0, caseIndex(rt, "bool")), vBool(bval))
    else: results.add vVariant(max(0, caseIndex(rt, "simple")), vStr(found))
    result = "")

proc newPluginHost*(dataRoot: string): PluginHost =
  result = PluginHost(reg: newHostRegistry(), plugins: @[], nodes: @[], cmds: @[], senders: @[], argStore: @[],
                      texts: @[], pending: @[], dataRoot: dataRoot)
  installInterfaces(result)

# ---- loading ---------------------------------------------------------------------------------

proc loadPlugin*(h: PluginHost; path: string; bytes: string): string =
  ## Instantiates the component, reads its metadata and runs `init-plugin` and `on-load`. Returns "" or the reason.
  let id = h.plugins.len
  let vm = newWasmVm()
  let ci = newCompInst(vm, h.reg, id)
  let pe = PluginEntry(id: id, path: path, name: path, version: "", description: "", authors: @[], permissions: @[],
                       ci: ci, onLoad: -1, onUnload: -1, handleEvent: -1, handleCommand: -1, eventRegs: @[],
                       dataFolder: h.dataRoot & "/" & path, active: false)
  h.plugins.add pe
  if not instantiateComponent(ci, bytes): return "load failed: " & ci.err
  pe.onLoad = findExportFunc(ci, "on-load")
  pe.onUnload = findExportFunc(ci, "on-unload")
  pe.handleEvent = findExportFunc(ci, "handle-event")
  pe.handleCommand = findExportFunc(ci, "handle-command")
  if pe.onLoad < 0: return "missing export on-load"
  var res: seq[CVal] = @[]
  let initFn = findExportFunc(ci, "init-plugin")
  if initFn >= 0:
    let e0 = callExport(ci, initFn, @[], res)
    if e0.len > 0: return "init-plugin: " & e0
  # metadata
  let mf = findExportFunc(ci, "pumpkin:plugin/metadata#get-metadata")
  if mf >= 0:
    res = @[]
    let e1 = callExport(ci, mf, @[], res)
    if e1.len > 0: return "metadata: " & e1
    let mt = ci.sigs[ci.funcs[mf].sig].results[0]
    var found = false
    pe.name = fieldOf(mt, res[0], "name", found).s
    pe.version = fieldOf(mt, res[0], "version", found).s
    pe.description = fieldOf(mt, res[0], "description", found).s
    pe.authors = stringsOf(fieldOf(mt, res[0], "authors", found))
    pe.permissions = stringsOf(fieldOf(mt, res[0], "permissions", found))
    pe.dataFolder = h.dataRoot & "/" & pe.name
  var i = 0
  while i < ci.unresolved.len:
    say(h, "[" & pe.name & "] imports " & ci.unresolved[i] & ", which this server does not provide")
    inc i
  res = @[]
  let e2 = callExport(ci, pe.onLoad, @[vInt(int64(id))], res)
  if e2.len > 0: return "on-load: " & e2
  if res.len > 0 and res[0].i != 0:
    return "on-load returned an error: " & (if res[0].items.len > 0: res[0].items[0].s else: "")
  pe.active = true
  result = ""

proc unloadPlugin*(h: PluginHost; id: int): string =
  let pe = h.plugins[id]
  if not pe.active: return ""
  pe.active = false
  if pe.onUnload >= 0:
    var res: seq[CVal] = @[]
    let e = callExport(pe.ci, pe.onUnload, @[vInt(int64(id))], res)
    if e.len > 0: return "on-unload: " & e
  result = ""

# ---- events ----------------------------------------------------------------------------------

proc fireEvent*(h: PluginHost; eventName: string; fieldNames: seq[string]; fieldVals: seq[CVal]): EventOutcome =
  ## Offers `eventName` to every active plugin that registered for it, in registration order. The event value is built
  ## from each plugin's own `event` variant type: the case named `eventName`, its record filled by field name (the
  ## ones given, defaults for the rest). Upstream: `WasmPlugin::handle_event` and `PluginManager::fire`.
  result = EventOutcome(cancelled: false, handled: 0)
  var p = 0
  while p < h.plugins.len:
    let pe = h.plugins[p]
    if pe.active and pe.handleEvent >= 0:
      var r = 0
      while r < pe.eventRegs.len:
        if pe.eventRegs[r].eventName == eventName:
          let sig = funcSig(pe.ci, pe.handleEvent)
          let evT = sig.params[2]
          let ci0 = caseIndex(evT, eventName)
          if ci0 >= 0:
            let payloadT = evT.types[ci0]
            var rec = vRecord(@[])
            var f = 0
            while f < payloadT.types.len:
              var v = defaultVal(payloadT.types[f])
              var k = 0
              while k < fieldNames.len:
                if payloadT.names[f] == fieldNames[k]: v = fieldVals[k]
                inc k
              rec.items.add v
              inc f
            var res: seq[CVal] = @[]
            let e = callExport(pe.ci, pe.handleEvent, @[vInt(int64(pe.eventRegs[r].handlerId)), vInt(0), vVariant(ci0, rec)], res)
            if e.len > 0:
              say(h, "[" & pe.name & "] event handler failed: " & e)
            else:
              inc result.handled
              if res.len > 0 and res[0].items.len > 0:
                var found = false
                let c = fieldOf(payloadT, res[0].items[0], "cancelled", found)
                if found and c.i != 0: result.cancelled = true
        inc r
    inc p

proc activeCount*(h: PluginHost): int =
  result = 0
  for p in h.plugins:
    if p.active: inc result
