## The server's plugin start-up: hands the server to the plugin manager (pluginmanager.aowl), fires the join and leave events, and
## wraps the experience, respawn and death hooks of the entity code so those events reach the plugins.
## Plugins run on the aoughwl engine; the manager that finds, loads, unloads and reloads them is pluginmanager.aowl, and the
## events the engine hears are chained on by engine/engineplugins.aowl. Port of the call sites of `PluginManager::fire` for player
## join and leave in pumpkin/src/net and pumpkin/src/entity/player.rs.

import ../server/serverbase
import ../util/text/text
import ../server/entity/entitymod
import ../server/world/worldmod
import pluginhooks
import pluginmanager
import packscmd, invitecmd
import engine/engineplugins
import api/events/player/[player_join, player_leave, player_respawn, exp_change]

proc callExpPrev(prev: proc(player: Player; amount: int32) {.closure.}; player: Player; amount: int32) =
  prev(player, amount)

proc callRespawnedPrev(prev: proc(world: World; player: Player) {.closure.}; world: World; player: Player) =
  prev(world, player)

proc callKilledPrev(prev: proc(player: Player; deathMessage: TextComponent) {.closure.}; player: Player;
    deathMessage: TextComponent) =
  prev(player, deathMessage)

proc installEntityEventHooks() =
  ## The entity code calls these hooks; each fires the event on its way (to the plugins, through the hook the engine chained).
  let prevExp = gPlayerHooks.addExperiencePoints
  gPlayerHooks.addExperiencePoints = proc(player: Player; amount: int32) {.closure.} =
    var ev = newPlayerExpChangeEvent(player, amount)
    firePlayerExpChange(ev)
    callExpPrev(prevExp, player, ev.amount)
  let prevRespawned = gPlayerRespawnedHook
  gPlayerRespawnedHook = proc(world: World; player: Player) {.closure.} =
    callRespawnedPrev(prevRespawned, world, player)
    firePlayerRespawn(newPlayerRespawnEvent(player, world, world, player.pos, player.yaw, player.pitch, true))
  let prevKilled = gPlayerHooks.handleKilled
  gPlayerHooks.handleKilled = proc(player: Player; deathMessage: TextComponent) {.closure.} =
    callKilledPrev(prevKilled, player, deathMessage)
    fireEnginePlayerDeath(player, deathMessage.getText)

proc startPlugins*(server: Server) =
  ## Called once by `loadServer`, after the command dispatcher exists: loads the plugins in `plugins/` and starts the manager.
  installEntityEventHooks()
  startPluginManager(server)
  startPacks(server)
  startInvite(server)

proc firePlayerJoin*(player: Player) =
  ## `PluginManager::fire(PlayerJoinEvent)`: the player and `<name> joined the game`.
  var ev = newPlayerJoinEvent(player, text(player.gameprofile.name & " joined the game"))
  firePlayerJoinEvent(ev)

proc firePlayerLeave*(player: Player) =
  var ev = newPlayerLeaveEvent(player, text(player.gameprofile.name & " left the game"))
  firePlayerLeaveEvent(ev)
