## The server's plugin manager: owns the `PluginHost`, loads `plugins/*.wasm` at start, wires plugin commands into the
## server's command dispatcher and fires the server's events into the plugins.
## Port of pumpkin/src/plugin/mod.rs (`PluginManager`: `load_plugins`, `try_load_plugin`, `active_plugins`, `fire`) and
## the call sites of `PluginManager::fire` for player join and leave in pumpkin/src/net and pumpkin/src/entity/player.rs.
## PARTIAL: pumpkin/src/plugin/mod.rs - loads WebAssembly components from `./plugins` only (no native `.dll` loader, no
## `load_plugin`/`unload_plugin` at run time, no plugin dependency ordering, no `PluginsDirChanged`, no permission
## registry); events fired: player join and leave only (upstream fires ~270; the dispatcher in pluginhost.aowl takes
## any event name, the call sites in the server are the missing part); the host interfaces behind them are listed in
## pluginhost.aowl.

import std/[syncio, strutils, dirs, paths]
import pluginhost
import wasm/canonabi
import ../command/[fallbackdispatch, cmdsource]
import ../server/serverbase
import ../util/text/text

const
  PluginsFolder = "plugins"

var gHost = newPluginHost("plugins")

proc readWasm(file: string): string =
  try:
    result = readFile(file)
  except:
    result = ""

proc startPlugins*(server: Server) =
  ## `PluginManager::load_plugins` for the WebAssembly loader. Called once by `loadServer`, after the dispatcher exists.
  gHost.logLine = proc (line: string) {.closure.} = echo line
  gHost.registerTree = proc (tree: CommandTree; permission: string) {.closure.} =
    let d = server.commandDispatcher
    if d != nil:
      register(d.fallbackDispatcher, tree, permission)
  var files: seq[string] = @[]
  try:
    for kind, entry in walkDir(path(PluginsFolder)):
      if kind == pcFile and ($entry).endsWith(".wasm"):
        files.add($entry)
  except ErrorCode:
    return
  for f in files:
    let bytes = readWasm(f)
    if bytes.len == 0:
      echo "Failed to read plugin ", f
      continue
    let err = loadPlugin(gHost, f, bytes)
    if err.len > 0:
      echo "Failed to load plugin ", f, ": ", err
    else:
      echo "Loaded plugin ", gHost.plugins[gHost.plugins.len - 1].name
  let cs = server.commandServer
  if cs != nil:
    cs.activePlugins = proc(): seq[PluginMetadata] {.closure.} =
      result = @[]
      for p in gHost.plugins:
        if p.active:
          result.add PluginMetadata(name: p.name, version: p.version, authors: p.authors, description: p.description)

proc firePlayerJoin*(player: Player) =
  ## `PluginManager::fire(PlayerJoinEvent)`: the player and `<name> joined the game`, cancellable upstream (a cancel
  ## suppresses the broadcast; the broadcast itself is not routed through here yet).
  if gHost.activeCount() == 0: return
  gHost.texts.add player.gameprofile.name & " joined the game"
  discard fireEvent(gHost, "player-join-event", @["player", "join-message", "cancelled"],
    @[vInt(int64(player.entityId)), vInt(int64(gHost.texts.len - 1)), vBool(false)])

proc firePlayerLeave*(player: Player) =
  if gHost.activeCount() == 0: return
  gHost.texts.add player.gameprofile.name & " left the game"
  discard fireEvent(gHost, "player-leave-event", @["player", "leave-message", "cancelled"],
    @[vInt(int64(player.entityId)), vInt(int64(gHost.texts.len - 1)), vBool(false)])
