## Connects the interfaces of wit/witblockentity, witscoreboard and witrecipe to the real `Server`: fills their hooks
## (`BlockEntityHooks`, `ScoreboardHooks`, `RecipeHooks`) with closures over the worlds' block entities, a scoreboard per
## world and `server.recipeManager`. The same job as pluginwire.aowl for the first half of the interfaces; a separate file so
## that the two halves can change without touching one another. `wireExt` is called by `startPlugins` (pluginmgr.aowl).
## A world handle is the index in `server.worlds`, a block entity is found by position through `getBlockEntity` of the
## world's `BlockWorld`, as `World::get_block_entity` does.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/scoreboard.rs - `World` holds no scoreboard in this tree, so
## the scoreboard plugins reach is one `Scoreboard` per world kept here, not the one the /scoreboard command edits.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/block_entity.rs - sign text written by a plugin is not sent to
## the clients until the chunk is resent (upstream does not send it either, the block entity is only marked through the
## sign's own `update`); a creaking heart answers no creaking uuid (the server keeps none).
import std/[options, tables]
import ../server/serverbase
import ../server/world/worldmod
import ../server/world/scoreboard
import ../server/recipe
import "../server/block/blockbehaviour"
import "../server/block/entities/sign" as signbe
import "../server/block/entities/command_block" as cmdbe
import "../server/block/entities/jukebox" as jukebe
import "../server/block/entities/mob_spawner" as spawnbe
import "../server/block/entities/chest_like_block_entity" as chestbe
import "../server/block/entities/hanging_sign" as hangbe
import "../server/block/entities/banner" as bannerbe
import "../server/block/entities/barrel" as barrelbe
import "../server/block/entities/beacon" as beaconbe
import "../server/block/entities/beehive" as beehivebe
import "../server/block/entities/bell" as bellbe
import "../server/block/entities/brewing_stand" as brewbe
import "../server/block/entities/chiseled_bookshelf" as bookbe
import "../server/block/entities/comparator" as comparatorbe
import "../server/block/entities/crafter" as crafterbe
import "../server/block/entities/end_gateway" as gatewaybe
import "../server/block/entities/ender_chest" as enderbe
import "../server/block/entities/furnace_like_block_entity" as furnacebe
import "../server/block/entities/hopper" as hopperbe
import "../server/block/entities/jigsaw_block" as jigsawbe
import "../server/block/entities/lectern" as lecternbe
import "../server/block/entities/piston" as pistonbe
import "../server/block/entities/sculk_shrieker" as shriekerbe
import "../server/block/entities/shulker_box" as shulkerbe
import "../server/block/entities/skull" as skullbe
import "../server/block/entities/structure_block" as structurebe
import ../inventory/inventory
import ../inventory/viewer
import ../generated/block_properties
import ../generated/scoreboard_slot
import ../protocol/java/client/play/[display_objective, update_objectives, update_score]
import ../protocol/proto
import ../util/math/position
import ../util/text/text
import ../util/text/color
import wasm/canonabi
import wit/[witstate, witall, witblockentity, witscoreboard]

var gBoards: seq[Scoreboard] = @[]         ## one per world index

proc board(w: int): int =
  while gBoards.len <= w: gBoards.add newScoreboard()
  w

proc worldAt(server: Server; i: int): nil World =
  if i >= 0 and i < server.worlds.len: return server.worlds[i]
  nil

proc entityAt(server: Server; w, x, y, z: int): Option[BlockEntity] =
  let wd = worldAt(server, w)
  if wd == nil: return none[BlockEntity]()
  getBlockEntity(BlockWorld(wd.blockWorld), newBlockPos(int32(x), int32(y), int32(z)))

proc numberFormatOf(f: NumFmt): Option[NumberFormat] =
  case f.kind
  of 1: some(NumberFormat(kind: nfBlank))
  of 2: some(NumberFormat(kind: nfFixed, fixedText: f.fixed))
  else: none[NumberFormat]()

proc teamOf(t: SbTeam): Team =
  var options = 0'i8
  if t.friendlyFire: options = options or 0x01'i8
  if t.seeFriendlyInvisibles: options = options or 0x02'i8
  Team(name: t.name, displayName: t.displayName, options: options, nametagVisibility: NameTagVisibility(t.nametagVisibility),
       collisionRule: CollisionRule(t.collisionRule), color: NamedColor(t.color), playerPrefix: t.prefix, playerSuffix: t.suffix,
       players: t.players)

proc kindName(e: BlockEntity): string =
  ## The WIT `block-entity-type` case of a block entity: its registry name in kebab-case plus `-block-entity`
  ## (`furnace` -> `furnace-block-entity`; the two names that do not follow the rule are `command_block` and `blast_furnace`).
  let loc = e.resourceLocation()
  var n = loc.substr(loc.find(':') + 1)
  if n == "command_block": return "command-block-entity"
  if n == "blast_furnace": n = "blasting_furnace"
  result = ""
  let seq1Src = n
  for idx1 in 0 ..< seq1Src.len:
    let c = seq1Src[idx1]
    result.add(if c == '_': '-' else: c)
  result.add "-block-entity"

proc wireExt*(ext: WitExt; server: Server) =
  # ---- recipes
  ext.recipes.hooks.addRecipe = proc (recipe: DynamicRecipe) {.closure.} =
    server.recipeManager.addRecipe(recipe)
  # ---- block entities
  let be = ext.blockEntities.hooks
  be.info = proc (w, x, y, z: int; res: var BeInfo): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let loc = e.unsafeGet.resourceLocation()
    let short = loc.substr(loc.find(':') + 1)
    var typeId = 0
    for i in 0 ..< BLOCK_ENTITY_TYPES.len:
      if BLOCK_ENTITY_TYPES[i] == short: typeId = i
    res = BeInfo(resourceLocation: loc, id: typeId, dirty: e.unsafeGet.isDirty())
    true
  be.clearDirty = proc (w, x, y, z: int) {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isSome: e.unsafeGet.clearDirty()
  be.command = proc (w, x, y, z: int; res: var BeCommand): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of cmdbe.CommandBlockEntity
    if not isKind: return false
    let c = cmdbe.CommandBlockEntity(eb)
    res = BeCommand(lastOutput: c.lastOutput, command: c.command, trackOutput: c.trackOutput, successCount: int(c.successCount),
                    auto: c.auto, conditionMet: c.conditionMet, powered: c.powered)
    true
  be.sign = proc (w, x, y, z: int; res: var BeSign): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    var front: signbe.Text
    var back: signbe.Text
    var waxed = false
    let eb = e.unsafeGet
    let isSign = eb of signbe.SignBlockEntity
    let isHanging = eb of hangbe.HangingSignBlockEntity
    if isSign:
      let s = signbe.SignBlockEntity(eb)
      front = s.frontText
      back = s.backText
      waxed = s.isWaxed
    elif isHanging:
      let s = hangbe.HangingSignBlockEntity(eb)
      front = s.frontText
      back = s.backText
      waxed = s.isWaxed
    else:
      return false
    res = BeSign(front: SignFace(messages: @[front.messages[0], front.messages[1], front.messages[2], front.messages[3]],
                                 color: int(front.color), glowing: front.hasGlowingText),
                 back: SignFace(messages: @[back.messages[0], back.messages[1], back.messages[2], back.messages[3]],
                                color: int(back.color), glowing: back.hasGlowingText),
                 waxed: waxed)
    true
  be.setSignFace = proc (w, x, y, z: int; front: bool; face: SignFace): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    var t: signbe.Text
    let eb = e.unsafeGet
    let isSign = eb of signbe.SignBlockEntity
    let isHanging = eb of hangbe.HangingSignBlockEntity
    if isSign:
      let s = signbe.SignBlockEntity(eb)
      t = (if front: s.frontText else: s.backText)
    elif isHanging:
      let s = hangbe.HangingSignBlockEntity(eb)
      t = (if front: s.frontText else: s.backText)
    else:
      return false
    t.hasGlowingText = face.glowing
    t.color = int8(face.color)
    for i in 0 ..< 4: t.messages[i] = face.messages[i]
    true
  be.setSignWaxed = proc (w, x, y, z: int; waxed: bool): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isSign = eb of signbe.SignBlockEntity
    let isHanging = eb of hangbe.HangingSignBlockEntity
    if isSign:
      let sv = signbe.SignBlockEntity(eb)
      sv.isWaxed = waxed
    elif isHanging:
      let hv = hangbe.HangingSignBlockEntity(eb)
      hv.isWaxed = waxed
    else:
      return false
    true
  be.jukeboxPlaying = proc (w, x, y, z: int; playing: var bool): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of jukebe.JukeboxBlockEntity
    if not isKind: return false
    let jb = jukebe.JukeboxBlockEntity(eb)
    playing = jb.isPlaying()
    true
  be.jukeboxStop = proc (w, x, y, z: int): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of jukebe.JukeboxBlockEntity
    if not isKind: return false
    let jb = jukebe.JukeboxBlockEntity(eb)
    jb.stopPlaying()
    true
  be.jukeboxStart = proc (w, x, y, z: int; lengthInTicks: uint64): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of jukebe.JukeboxBlockEntity
    if not isKind: return false
    let jb = jukebe.JukeboxBlockEntity(eb)
    jb.startPlaying(lengthInTicks)
    true
  be.viewerCount = proc (w, x, y, z: int; count: var int): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of chestbe.ChestLikeBlockEntity
    if not isKind: return false
    let cb = chestbe.ChestLikeBlockEntity(eb)
    count = int(cb.getViewerCount())
    true
  be.spawner = proc (w, x, y, z: int; res: var BeSpawner): bool {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return false
    let eb = e.unsafeGet
    let isKind = eb of spawnbe.MobSpawnerBlockEntity
    if not isKind: return false
    let s = spawnbe.MobSpawnerBlockEntity(eb)
    res = BeSpawner(spawnCount: int(s.spawnCount), spawnRange: int(s.spawnRange), delay: int(s.delay))
    true
  be.kind = proc (w, x, y, z: int): string {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: "" else: kindName(e.unsafeGet)
  be.inventory = proc (w, x, y, z: int): nil Inventory {.closure.} =
    let e = entityAt(server, w, x, y, z)
    if e.isNone: return nil
    let inv = e.unsafeGet.getInventory()
    if inv.isSome: return inv.unsafeGet
    nil
  be.field = proc (w, x, y, z: int; view, name: string; res: var CVal): bool {.closure.} =
    let eo = entityAt(server, w, x, y, z)
    if eo.isNone: return false
    let e = eo.unsafeGet
    if kindName(e) != view: return false
    case view
    of "furnace-block-entity", "blasting-furnace-block-entity", "smoker-block-entity":
      let f = furnacebe.FurnaceLikeBlockEntity(e)
      case name
      of "get-cooking-time-spent": res = vInt(int64(f.inv.cookingTimeSpent))
      of "get-cooking-total-time": res = vInt(int64(f.inv.cookingTotalTime))
      of "get-lit-time-remaining": res = vInt(int64(f.inv.litTimeRemaining))
      of "get-lit-total-time": res = vInt(int64(f.inv.litTotalTime))
      of "is-burning": res = vBool(f.inv.litTimeRemaining > 0'u16)
      else: return false
    of "beacon-block-entity":
      let b = beaconbe.BeaconBlockEntity(e)
      case name
      of "get-primary-effect": res = vInt(int64(b.primaryEffect))
      of "get-secondary-effect": res = vInt(int64(b.secondaryEffect))
      of "get-levels": res = vInt(int64(b.levels))
      else: return false
    of "banner-block-entity":
      let b = bannerbe.BannerBlockEntity(e)
      res = (if b.customName.isSome: vSome(vStr(b.customName.unsafeGet)) else: vNone())
    of "barrel-block-entity":
      let bv = barrelbe.BarrelBlockEntity(e)
      let v = bv.inv.viewers
      res = vInt(if v == nil: 0'i64 else: int64(v.getViewerCount()))
    of "shulker-box-block-entity":
      let sv = shulkerbe.ShulkerBoxBlockEntity(e)
      let v = sv.inv.viewers
      res = vInt(if v == nil: 0'i64 else: int64(v.getViewerCount()))
    of "ender-chest-block-entity":
      let ev = enderbe.EnderChestBlockEntity(e)
      res = vInt(int64(ev.viewers.getViewerCount()))
    of "chest-block-entity", "trapped-chest-block-entity":
      let cv = chestbe.ChestLikeBlockEntity(e)
      res = vInt(int64(cv.getViewerCount()))
    of "beehive-block-entity":
      let hive = beehivebe.BeehiveBlockEntity(e)
      var n = 0
      n = hive.bees.len
      res = vInt(int64(n))
    of "bell-block-entity":
      let b = bellbe.BellBlockEntity(e)
      if name == "is-ringing": res = vBool(b.ringing)
      elif name == "get-ring-ticks": res = vInt(int64(b.ringTicks))
      else: return false
    of "brewing-stand-block-entity":
      let b = brewbe.BrewingStandBlockEntity(e)
      if name == "get-brew-time": res = vInt(int64(b.inv.brewTime))
      elif name == "get-fuel": res = vInt(int64(b.inv.fuel))
      else: return false
    of "chiseled-bookshelf-block-entity":
      let kv = bookbe.ChiseledBookshelfBlockEntity(e)
      res = vInt(int64(kv.lastInteractedSlot))
    of "comparator-block-entity":
      let mv = comparatorbe.ComparatorBlockEntity(e)
      res = vInt(int64(mv.outputSignal))
    of "crafter-block-entity":
      let b = crafterbe.CrafterBlockEntity(e)
      if name == "get-crafting-ticks-remaining": res = vInt(int64(b.craftingTicksRemaining))
      elif name == "is-triggered": res = vBool(b.triggered)
      else: return false
    of "creaking-heart-block-entity":
      res = vNone()           # PARTIAL: the heart keeps no creaking uuid here
    of "end-gateway-block-entity":
      let b = gatewaybe.EndGatewayBlockEntity(e)
      if name == "get-age": res = vInt(b.age)
      elif name == "is-exact-teleport": res = vBool(b.exactTeleport)
      else: return false
    of "hopper-block-entity":
      let hv = hopperbe.HopperBlockEntity(e)
      res = vInt(int64(hv.inv.cooldownTime))
    of "jigsaw-block-entity":
      let b = jigsawbe.JigsawBlockEntity(e)
      case name
      of "get-name": res = vStr(b.name)
      of "get-target": res = vStr(b.target)
      of "get-pool": res = vStr(b.pool)
      of "get-final-state": res = vStr(b.finalState)
      of "get-selection-priority": res = vInt(int64(b.selectionPriority))
      of "get-placement-priority": res = vInt(int64(b.placementPriority))
      else: return false
    of "lectern-block-entity":
      let lv = lecternbe.LecternBlockEntity(e)
      res = vInt(int64(lv.page))
    of "piston-block-entity":
      let b = pistonbe.PistonBlockEntity(e)
      if name == "get-progress": res = vFloat(float64(b.currentProgress))
      elif name == "is-extending": res = vBool(b.extending)
      elif name == "is-source": res = vBool(b.source)
      else: return false
    of "sculk-shrieker-block-entity":
      let rv = shriekerbe.SculkShriekerBlockEntity(e)
      res = vInt(int64(rv.warningLevel))
    of "skull-block-entity":
      let b = skullbe.SkullBlockEntity(e)
      res = (if b.noteBlockSound.isSome: vSome(vStr(b.noteBlockSound.unsafeGet)) else: vNone())
    of "structure-block-block-entity":
      let b = structurebe.StructureBlockBlockEntity(e)
      case name
      of "get-name": res = vStr(b.name)
      of "get-author": res = vStr(b.author)
      of "get-mode": res = vStr(b.mode)
      of "get-integrity": res = vFloat(float64(b.integrity))
      of "get-seed": res = vInt(b.seed)
      else: return false
    else:
      return false
    true
  # ---- scoreboard
  let sb = ext.scoreboard.hooks
  sb.addObjective = proc (w: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) {.closure.} =
    let wd = worldAt(server, w)
    if wd == nil: return
    let b = board(w)
    gBoards[b].addObjective(wd, ScoreboardObjective(name: name, displayName: title, renderType: RenderType(renderType),
                                                    numberFormat: numberFormatOf(fmt), criterion: "dummy"))
  sb.updateObjective = proc (w: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) {.closure.} =
    let wd = worldAt(server, w)
    if wd == nil: return
    let b = board(w)
    for i in 0 ..< gBoards[b].objectives.len:
      if gBoards[b].objectives[i].name == name:
        gBoards[b].objectives[i].displayName = title
        gBoards[b].objectives[i].renderType = RenderType(renderType)
        gBoards[b].objectives[i].numberFormat = numberFormatOf(fmt)
        wd.broadcastPacketAll(newCUpdateObjectives(name, mUpdate, title, RenderType(renderType), numberFormatOf(fmt)))
  sb.removeObjective = proc (w: int; name: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].removeObjective(wd, name)
  sb.setDisplaySlot = proc (w: int; slot: int; objective: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil and slot >= 0 and slot <= ord(high(ScoreboardDisplaySlot)):
      wd.broadcastPacketAll(newCDisplayObjective(ScoreboardDisplaySlot(slot), objective))
  sb.clearDisplaySlot = proc (w: int; slot: int) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil and slot >= 0 and slot <= ord(high(ScoreboardDisplaySlot)):
      wd.broadcastPacketAll(newCDisplayObjective(ScoreboardDisplaySlot(slot), ""))
  sb.updateScore = proc (w: int; entity, objective: string; value: int; fmt: NumFmt) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil:
      gBoards[board(w)].updateScore(wd, newScoreboardScore(entity, objective, newVarInt(int32(value)), none[TextComponent](),
                                                           numberFormatOf(fmt)))
  sb.getScore = proc (w: int; entity, objective: string; value: var int): bool {.closure.} =
    let b = board(w)
    let seq2Src = gBoards[b].scores
    for idx2 in 0 ..< seq2Src.len:
      let s = seq2Src[idx2]
      if s.entityName == entity and s.objectiveName == objective:
        value = int(s.value.value)
        return true
    false
  sb.removeScore = proc (w: int; entity, objective: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].removeScore(wd, entity, objective)
  sb.resetEntityScores = proc (w: int; entity: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd == nil: return
    let b = board(w)
    var names: seq[string] = @[]
    let seq3Src = gBoards[b].scores
    for idx3 in 0 ..< seq3Src.len:
      let s = seq3Src[idx3]
      if s.entityName == entity: names.add s.objectiveName
    for n in names: gBoards[b].removeScore(wd, entity, n)
  sb.createTeam = proc (w: int; team: SbTeam) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].addTeam(wd, teamOf(team))
  sb.updateTeam = proc (w: int; team: SbTeam) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].updateTeam(wd, teamOf(team))
  sb.removeTeam = proc (w: int; name: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].removeTeam(wd, name)
  sb.addPlayerToTeam = proc (w: int; team, player: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].addPlayerToTeam(wd, team, player)
  sb.removePlayerFromTeam = proc (w: int; team, player: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd != nil: gBoards[board(w)].removePlayerFromTeam(wd, team, player)
  sb.clearTeamPlayers = proc (w: int; team: string) {.closure.} =
    let wd = worldAt(server, w)
    if wd == nil: return
    let b = board(w)
    var players: seq[string] = @[]
    let seq4Src = gBoards[b].teams
    for idx4 in 0 ..< seq4Src.len:
      let t = seq4Src[idx4]
      if t.name == team: players = t.players
    for p in players: gBoards[b].removePlayerFromTeam(wd, team, p)
  sb.teams = proc (w: int): seq[SbTeam] {.closure.} =
    result = @[]
    let seq5Src = gBoards[board(w)].teams
    for idx5 in 0 ..< seq5Src.len:
      let t = seq5Src[idx5]
      result.add SbTeam(name: t.name, displayName: t.displayName, friendlyFire: (t.options and 0x01'i8) != 0,
                        seeFriendlyInvisibles: (t.options and 0x02'i8) != 0, nametagVisibility: ord(t.nametagVisibility),
                        collisionRule: ord(t.collisionRule), color: ord(t.color), prefix: t.playerPrefix, suffix: t.playerSuffix,
                        players: t.players)
