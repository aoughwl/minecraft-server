## Runs a hand-assembled core module through the plugin runtime: a host import called from wasm,
## wasm exports called from the host, linear memory read and written from both sides, a trap.
import std/[syncio, assertions]
import wasmvm

proc bytesOf(xs: openArray[int]): string =
  result = ""
  for x in xs: result.add char(x)

# (module (import "env" "host_add" (func (param i32 i32) (result i32)))
#   (func (export "run") (param i32 i32) (result i32) local.get 0 local.get 1 call 0 i32.const 10 i32.mul)
#   (func (export "peek") (param i32) (result i32) local.get 0 i32.load8_u)
#   (memory (export "memory") 1) (data (i32.const 0) "hello"))
let modA = bytesOf([0x00,0x61,0x73,0x6d,0x01,0x00,0x00,0x00,
  0x01,0x0c,0x02,0x60,0x02,0x7f,0x7f,0x01,0x7f,0x60,0x01,0x7f,0x01,0x7f,
  0x02,0x10,0x01,0x03,0x65,0x6e,0x76,0x08,0x68,0x6f,0x73,0x74,0x5f,0x61,0x64,0x64,0x00,0x00,
  0x03,0x03,0x02,0x00,0x01,
  0x05,0x03,0x01,0x00,0x01,
  0x07,0x17,0x03, 0x03,0x72,0x75,0x6e,0x00,0x01, 0x04,0x70,0x65,0x65,0x6b,0x00,0x02,
     0x06,0x6d,0x65,0x6d,0x6f,0x72,0x79,0x02,0x00,
  0x0a,0x15,0x02, 0x0b,0x00,0x20,0x00,0x20,0x01,0x10,0x00,0x41,0x0a,0x6c,0x0b,
     0x07,0x00,0x20,0x00,0x2d,0x00,0x00,0x0b,
  0x0b,0x0b,0x01,0x00,0x41,0x00,0x0b,0x05,0x68,0x65,0x6c,0x6c,0x6f])

var hostCalls = 0

proc main() =
  let vm = newWasmVm()
  vm.defineHost("env", "host_add", proc (vm: WasmVm; args: seq[WSlot]; results: var seq[WSlot]): int =
    inc hostCalls
    discard memWrite(vm, 0, 100, "X")
    results.add i32(asI32(args[0]) + asI32(args[1]))
    result = wsOk)
  let mid = vm.loadModule(modA)
  if mid < 0:
    echo "decode failed: ", vm.lastError
    quit 1
  var inst = -1
  let st = vm.instantiate(mid, inst)
  if st != wsOk:
    echo "instantiate failed: ", vm.lastError
    quit 1
  let run = vm.exportFunc(inst, "run")
  let peek = vm.exportFunc(inst, "peek")
  let mem = vm.exportMem(inst, "memory")
  assert run >= 0 and peek >= 0 and mem >= 0
  var res: seq[WSlot] = @[]
  assert vm.call(run, @[i32(3), i32(4)], res) == wsOk
  assert asI32(res[0]) == 70
  assert hostCalls == 1
  res = @[]
  assert vm.call(peek, @[i32(100)], res) == wsOk
  assert asI32(res[0]) == int32(ord('X'))
  var ok = false
  assert memRead(vm, mem, 0, 5, ok) == "hello" and ok
  res = @[]
  assert vm.call(peek, @[i32(70000)], res) == wsTrap
  let vm2 = newWasmVm()
  let m2 = vm2.loadModule(modA)
  var i2 = -1
  assert vm2.instantiate(m2, i2) != wsOk
  echo "wasmvmtest ok"

main()
