## Registers the host interfaces of this half of the plugin API (text, scheduler, boss-bar, world, server, uuid, i18n, item-stack, block-entity, scoreboard, gui,
## recipe) and WASI preview 2 (witwasi.aowl)
## in one call, for `installInterfaces` in pluginhost.aowl. Port of the registration list in
## pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/mod.rs (`add_to_linker`) for those interfaces; common.rs,
## permission.rs and java_dialogs.rs are type-only upstream (empty `Host` impls) and need no host function.
## The state of the interfaces added after the first half (item stacks, block entities, scoreboard, gui, recipes and
## WASI) is one `WitExt`, owned by the `PluginHost`; each has its own hooks, which pluginwire2.aowl fills from the server.
## `forms` has no host function (witforms.aowl is its JSON serialisation).
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/mod.rs - see the PARTIAL lines of each interface file; the
## interfaces nobody has started are `inventory`, `screens`-based screen handlers, `ipc`, `display`, `datapack`,
## `advancement`, `status-effect` and the packet interfaces.
import ../wasm/component
import witstate, wittext, witscheduler, witbossbar, witworld, witsrv, wituuid, witi18n
import witwasi, witstack, witblockentity, witscoreboard, witgui, witrecipe

export witwasi, witstack, witblockentity, witscoreboard, witgui, witrecipe

type
  WitExt* = ref object
    wasi*: WasiHost
    stacks*: StackState
    blockEntities*: BlockEntityState
    scoreboard*: ScoreboardState
    guis*: GuiState
    recipes*: RecipeState

proc newWitExt*(): WitExt =
  WitExt(wasi: newWasiHost(), stacks: newStackState(), blockEntities: newBlockEntityState(), scoreboard: newScoreboardState(),
         guis: newGuiState(), recipes: newRecipeState())

proc installWitInterfaces*(r: HostRegistry; st: WitState; ext: nil WitExt = nil): WitExt =
  ## Registers every interface of this directory. The `WitExt` is the caller's, or a fresh one that is returned.
  installText(r, st)
  installScheduler(r, st)
  installBossBar(r, st)
  installWorld(r, st)
  installServer(r, st)
  installUuid(r, st)
  installI18n(r, st)
  if ext != nil: result = ext
  else: result = newWitExt()
  installWasi(r, st, result.wasi)
  installItemStack(r, st, result.stacks)
  installBlockEntity(r, result.blockEntities)
  installScoreboard(r, st, result.scoreboard)
  installGui(r, st, result.guis, result.stacks)
  installRecipe(r, result.recipes, result.stacks)
