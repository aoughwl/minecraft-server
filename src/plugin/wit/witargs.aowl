## Port of pumpkin/src/plugin/loader/wasm/wasm_host/args.rs: `OwnedArg` and `ConsumedArgsResource`.
##
## Upstream's `Arg<'_>` borrows from the command's raw arguments, so a plugin's command handler (which outlives the dispatch)
## gets an `OwnedArg`: the same variants with the borrowed ones (`&str`) cloned to `String`. The `Arg` of fallbackdispatch.aowl
## is already flat and owns its strings, so an `OwnedArg` is a copy of it (a value copy: sequences are copied, entity and
## player handles are shared refs, as an `Arc` clone is), kept as a distinct type so that what a plugin resource holds cannot
## be mistaken for what the dispatcher is still using. `Slot` and `Slots` are the two kinds upstream marks `unreachable!`
## (they exist only for the item-modify commands, never reach a plugin command): `fromArg` answers false for them instead of
## aborting.
import std/tables
import ../../command/fallbackdispatch

type
  OwnedArg* = object
    arg: Arg

  ConsumedArgsResource* = object
    ## `ConsumedArgsResource { provider: HashMap<String, OwnedArg> }`: the arguments of one command call by name.
    provider*: Table[string, OwnedArg]

proc kind*(a: OwnedArg): ArgKind = a.arg.kind

proc value*(a: OwnedArg): Arg = a.arg
  ## The `Arg` held, for the lowering of a plugin's `command-arg` resource (witplayer.aowl, pluginhost.aowl `argStore`).

proc fromArg*(arg: Arg): (bool, OwnedArg) =
  ## `OwnedArg::from_arg`; false for the kinds upstream marks unreachable (`Slot`, `Slots`).
  if arg.kind == akSlot or arg.kind == akSlots:
    return (false, OwnedArg(arg: Arg()))
  (true, OwnedArg(arg: arg))

proc newConsumedArgsResource*(args: ConsumedArgs): ConsumedArgsResource =
  ## The provider a command call builds from its `ConsumedArgs` (`name -> OwnedArg`); a later argument of the same name
  ## replaces an earlier one, as `HashMap::insert` does, and an unreachable kind is left out.
  result = ConsumedArgsResource(provider: initTable[string, OwnedArg]())
  for c in args:
    let (ok, owned) = fromArg(c.arg)
    if ok: result.provider[c.name] = owned

proc get*(r: ConsumedArgsResource; name: string; found: var bool): OwnedArg =
  found = r.provider.hasKey(name)
  r.provider.getOrDefault(name, OwnedArg(arg: Arg()))
