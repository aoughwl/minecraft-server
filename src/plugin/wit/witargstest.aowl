## Tests for witargs.aowl (`OwnedArg::from_arg`, `ConsumedArgsResource`): an owned copy keeps the kind and the value of every
## variant it is made from, is independent of the borrowed original afterwards, `Slot` and `Slots` are refused (upstream's
## `unreachable!`), and the resource built from a call's arguments is keyed by name, the last one of a name winning.
import std/[syncio, tables]
import ../../command/fallbackdispatch
import ../../util/math/position
import ../../util/vector3
import ../../util/gamemode
import witargs

var failed = false

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    failed = true

proc main() =
  var msg = Arg(kind: akMsg, str: "hello world")
  let (ok1, ownedMsg) = fromArg(msg)
  ck(ok1 and ownedMsg.kind == akMsg and ownedMsg.value.str == "hello world", "Msg is copied")
  msg.str = "changed"
  ck(ownedMsg.value.str == "hello world", "the copy does not follow the original")

  let (ok2, ownedPos) = fromArg(Arg(kind: akBlockPos, blockPos: newBlockPos(1'i32, -2'i32, 3'i32)))
  ck(ok2 and ownedPos.kind == akBlockPos and ownedPos.value.blockPos == newBlockPos(1'i32, -2'i32, 3'i32), "BlockPos")

  let (ok3, ownedPos3) = fromArg(Arg(kind: akPos3D, pos3D: Vector3[float64](x: 0.5, y: 64.0, z: -3.25)))
  ck(ok3 and ownedPos3.value.pos3D.y == 64.0 and ownedPos3.value.pos3D.z == -3.25, "Pos3D")

  let (ok4, ownedRot) = fromArg(Arg(kind: akRotation, yaw: 90.0'f32, yawRelative: true, pitch: -45.0'f32, pitchRelative: false))
  ck(ok4 and ownedRot.value.yaw == 90.0'f32 and ownedRot.value.yawRelative and ownedRot.value.pitch == -45.0'f32 and
     not ownedRot.value.pitchRelative, "Rotation (angle, relative flag, angle, relative flag)")

  let (ok5, ownedMode) = fromArg(Arg(kind: akGameMode, gameMode: GameMode.Creative))
  ck(ok5 and ownedMode.value.gameMode == GameMode.Creative, "GameMode")

  let (ok6, ownedNum) = fromArg(Arg(kind: akNum, numInBounds: true, num: Number(kind: nkI32, i32: 42'i32)))
  ck(ok6 and ownedNum.value.numInBounds and ownedNum.value.num.i32 == 42'i32, "Num(Ok)")
  let (ok7, ownedBad) = fromArg(Arg(kind: akNum, numInBounds: false, numOverflowLow: true, numBound: Number(kind: nkI32, i32: 0'i32)))
  ck(ok7 and not ownedBad.value.numInBounds and ownedBad.value.numOverflowLow, "Num(Err(NotInBounds)) keeps the error")

  let (ok8, ownedBool) = fromArg(Arg(kind: akBool, boolean: true))
  ck(ok8 and ownedBool.value.boolean and ownedBool.kind == akBool, "Bool")
  let (ok9, ownedTime) = fromArg(Arg(kind: akTime, time: 200'i32))
  ck(ok9 and ownedTime.value.time == 200'i32, "Time")

  # every string-holding variant of the Rust enum is `.to_string()`ed: the id stays in `str`
  proc stringKind(k: ArgKind) =
    let r = fromArg(Arg(kind: k, str: "minecraft:thing"))
    ck(r[0] and r[1].kind == k and r[1].value.str == "minecraft:thing", "string kind " & $k)
  stringKind(akItem)
  stringKind(akItemPredicate)
  stringKind(akResourceLocation)
  stringKind(akBlock)
  stringKind(akBlockPredicate)
  stringKind(akSimple)
  stringKind(akParticle)
  stringKind(akDamageType)
  stringKind(akEffect)
  stringKind(akEnchantment)
  stringKind(akAdvancement)
  stringKind(akBossbarColor)
  stringKind(akBossbarStyle)
  stringKind(akSoundCategory)

  # the two kinds upstream marks unreachable
  let (slotOk, _) = fromArg(Arg(kind: akSlot, slot: 3))
  ck(not slotOk, "Slot is refused")
  let (slotsOk, _) = fromArg(Arg(kind: akSlots, slots: @[1, 2]))
  ck(not slotsOk, "Slots is refused")

  # the resource a command call builds
  let res = newConsumedArgsResource(@[
    ConsumedArg(name: "target", arg: Arg(kind: akSimple, str: "first")),
    ConsumedArg(name: "count", arg: Arg(kind: akTime, time: 5'i32)),
    ConsumedArg(name: "slot", arg: Arg(kind: akSlot, slot: 1)),
    ConsumedArg(name: "target", arg: Arg(kind: akSimple, str: "second"))])
  ck(res.provider.len == 2, "two names: the unreachable one is left out, the repeated one replaces")
  var found = false
  let t = res.get("target", found)
  ck(found and t.value.str == "second", "the last argument of a name wins")
  discard res.get("slot", found)
  ck(not found, "an unreachable argument is not in the provider")
  discard res.get("nothing", found)
  ck(not found, "an unknown name is not found")

  if failed:
    quit 1
  echo "witargstest ok"

main()
