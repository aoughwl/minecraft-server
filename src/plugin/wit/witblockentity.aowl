## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/block_entity.rs: the `block-entity` resource and the typed
## views the pinned loader implements (`command-block-entity`, `sign-block-entity`, `jukebox-block-entity`,
## `chest-block-entity`, `mob-spawner-block-entity`). Upstream keeps an `Arc<dyn BlockEntity>` per handle and downcasts it
## (`as_any().downcast_ref::<Internal...>`); here a handle's rep is a slot of `BlockEntityState.slots` naming the block
## entity by (world, position), and every access goes through `BlockEntityHooks`, which pluginwire2.aowl fills from the
## real `BlockEntity` of the world (a hook answers false when there is no block entity of that kind at the position, which
## is upstream's "Not a ... block entity" error and traps the call).
## A view's `get-block-entity` answers the same slot (upstream makes a new resource over the same provider).
## `newBlockEntityRep` is how `world.get-block-entity` (witworld, the other half) turns a position into a handle.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/block_entity.rs - the 45 other typed views of the newer WIT
## (furnace, hopper, beacon, ...), `container-block-entity` and the custom-data methods are not in the pinned loader and
## trap as unimplemented; the sign colour is the dye index 0..15 of the WIT enum; nothing creates a handle yet except
## `newBlockEntityRep` (the world interface does not call it until its `get-block-entity` is written); handles are never
## freed.
import std/[tables, options]
import ../wasm/[canonabi, component]
import ../../nbt/tag
import ../../inventory/inventory
import witstate

const
  IfBe = "pumpkin:plugin/block-entity"

type
  BeInfo* = object
    resourceLocation*: string
    id*: int
    dirty*: bool

  SignFace* = object
    messages*: seq[string]       ## four lines
    color*: int                  ## `DyeColor` ordinal
    glowing*: bool

  BeSign* = object
    front*: SignFace
    back*: SignFace
    waxed*: bool

  BeCommand* = object
    lastOutput*: string
    command*: string
    trackOutput*: bool
    successCount*: int
    auto*: bool
    conditionMet*: bool
    powered*: bool

  BeSpawner* = object
    spawnCount*: int
    spawnRange*: int
    delay*: int

  BeSlot = object
    world: int
    x: int
    y: int
    z: int

  BlockEntityHooks* = ref object
    field*: proc (world, x, y, z: int; view, name: string; res: var CVal): bool {.closure.}   ## a typed view's getter (witblockentity2.aowl): `view` is `furnace-block-entity`, `name` `get-lit-total-time`; false when the block entity is not of that view
    inventory*: proc (world, x, y, z: int): nil Inventory {.closure.}     ## `BlockEntity::get_inventory`
    kind*: proc (world, x, y, z: int): string {.closure.}            ## the WIT `block-entity-type` case of the block entity there (`furnace-block-entity`), "" for none
    info*: proc (world, x, y, z: int; res: var BeInfo): bool {.closure.}            ## false: no block entity there
    clearDirty*: proc (world, x, y, z: int) {.closure.}
    command*: proc (world, x, y, z: int; res: var BeCommand): bool {.closure.}
    sign*: proc (world, x, y, z: int; res: var BeSign): bool {.closure.}
    setSignFace*: proc (world, x, y, z: int; front: bool; face: SignFace): bool {.closure.}
    setSignWaxed*: proc (world, x, y, z: int; waxed: bool): bool {.closure.}
    jukeboxPlaying*: proc (world, x, y, z: int; playing: var bool): bool {.closure.}
    jukeboxStop*: proc (world, x, y, z: int): bool {.closure.}
    jukeboxStart*: proc (world, x, y, z: int; lengthInTicks: uint64): bool {.closure.}
    viewerCount*: proc (world, x, y, z: int; count: var int): bool {.closure.}      ## chest
    spawner*: proc (world, x, y, z: int; res: var BeSpawner): bool {.closure.}

  BlockEntityState* = ref object
    hooks*: BlockEntityHooks
    slots: seq[BeSlot]
    custom*: Table[string, NbtCompound]      ## the namespaced custom data of block entities (in memory only), keyed by position

proc newBlockEntityState*(): BlockEntityState =
  BlockEntityState(hooks: BlockEntityHooks(), slots: @[], custom: initTable[string, NbtCompound]())

proc newBlockEntityRep*(s: BlockEntityState; world, x, y, z: int): int =
  ## `PluginHostState::add_block_entity`.
  s.slots.add BeSlot(world: world, x: x, y: y, z: z)
  s.slots.len - 1

proc slotPos*(s: BlockEntityState; rep: int; world, x, y, z: var int): bool =
  ## The (world, position) a handle names.
  if rep < 0 or rep >= s.slots.len: return false
  world = s.slots[rep].world
  x = s.slots[rep].x
  y = s.slots[rep].y
  z = s.slots[rep].z
  true

proc cdSet*(c: var NbtCompound; ns, key: string; value: NbtTag) =
  ## The namespaced custom data layout of `ItemStack::set_custom_data`: compound[ns][key].
  let (had, nsTag) = c.remove(ns)
  var data = if had and nsTag.kind == ntkCompound: nsTag.compoundVal else: newCompound()
  data.insert(key, value)
  c.insert(ns, NbtTag(kind: ntkCompound, compoundVal: data))

proc cdGet*(c: NbtCompound; ns, key: string): Option[NbtTag] =
  let (has, nsTag) = c.get(ns)
  if not has or nsTag.kind != ntkCompound: return none[NbtTag]()
  let (found, v) = nsTag.compoundVal.get(key)
  if found: some(v) else: none[NbtTag]()

proc cdRemove*(c: var NbtCompound; ns, key: string) =
  let (had, nsTag) = c.remove(ns)
  if not had or nsTag.kind != ntkCompound: return
  var data = nsTag.compoundVal
  discard data.remove(key)
  if not data.isEmpty():
    c.insert(ns, NbtTag(kind: ntkCompound, compoundVal: data))

proc slotAt(s: BlockEntityState; rep: int): int =
  if rep >= 0 and rep < s.slots.len: rep else: -1

proc signFaceVal(f: SignFace): CVal =
  var ms: seq[CVal] = @[]
  for m in f.messages: ms.add vStr(m)
  vRecord(@[vList(ms), vInt(int64(f.color)), vBool(f.glowing)])

proc signFaceOf(v: CVal): SignFace =
  ## `from_wasm_sign_text`: at most four lines, the rest empty.
  result = SignFace(messages: @["", "", "", ""], color: int(v.items[1].i), glowing: v.items[2].i != 0)
  var i = 0
  while i < v.items[0].items.len and i < 4:
    result.messages[i] = v.items[0].items[i].s
    inc i

proc callBeSign(bs: BlockEntityState; s: int; g: var BeSign): bool =
  bs.hooks.sign(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, g)

proc callBeSetSignFace(bs: BlockEntityState; s: int; front: bool; face: SignFace): bool =
  bs.hooks.setSignFace(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, front, face)

proc callBeSetSignWaxed(bs: BlockEntityState; s: int; waxed: bool): bool =
  bs.hooks.setSignWaxed(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, waxed)

proc callBeCommand(bs: BlockEntityState; s: int; c: var BeCommand): bool =
  bs.hooks.command(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, c)

proc callBeInfo(bs: BlockEntityState; s: int; res: var BeInfo): bool =
  bs.hooks.info(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, res)

proc callBeJukeboxPlaying(bs: BlockEntityState; s: int; playing: var bool): bool =
  bs.hooks.jukeboxPlaying(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, playing)

proc callBeJukeboxStop(bs: BlockEntityState; s: int): bool =
  bs.hooks.jukeboxStop(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z)

proc callBeJukeboxStart(bs: BlockEntityState; s: int; lengthInTicks: uint64): bool =
  bs.hooks.jukeboxStart(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, lengthInTicks)

proc callBeViewerCount(bs: BlockEntityState; s: int; count: var int): bool =
  bs.hooks.viewerCount(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, count)

proc callBeSpawner(bs: BlockEntityState; s: int; res: var BeSpawner): bool =
  bs.hooks.spawner(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z, res)

proc callBeClearDirty(bs: BlockEntityState; s: int) =
  bs.hooks.clearDirty(bs.slots[s].world, bs.slots[s].x, bs.slots[s].y, bs.slots[s].z)

proc installGetBlockEntity(r: HostRegistry; bs: BlockEntityState; view: string) =
  witFn(r, IfBe, "[method]" & view & ".get-block-entity"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0: return "invalid " & view & " resource handle"
    results.add vInt(int64(s))

proc installSignView(r: HostRegistry; bs: BlockEntityState; view: string) =
  ## The `sign-block-entity` and `hanging-sign-block-entity` methods are the same.
  let hk = bs.hooks
  witFn(r, IfBe, "[method]" & view & ".get-front-text"):
    let s = slotAt(bs, int(args[0].i))
    var g = BeSign()
    if s < 0 or hk.sign == nil or not callBeSign(bs, s, g):
      return "Not a sign block entity"
    results.add signFaceVal(g.front)
  witFn(r, IfBe, "[method]" & view & ".set-front-text"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.setSignFace == nil or
        not callBeSetSignFace(bs, s, true, signFaceOf(args[1])):
      return "Not a sign block entity"
  witFn(r, IfBe, "[method]" & view & ".get-back-text"):
    let s = slotAt(bs, int(args[0].i))
    var g = BeSign()
    if s < 0 or hk.sign == nil or not callBeSign(bs, s, g):
      return "Not a sign block entity"
    results.add signFaceVal(g.back)
  witFn(r, IfBe, "[method]" & view & ".set-back-text"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.setSignFace == nil or
        not callBeSetSignFace(bs, s, false, signFaceOf(args[1])):
      return "Not a sign block entity"
  witFn(r, IfBe, "[method]" & view & ".is-waxed"):
    let s = slotAt(bs, int(args[0].i))
    var g = BeSign()
    if s < 0 or hk.sign == nil or not callBeSign(bs, s, g):
      return "Not a sign block entity"
    results.add vBool(g.waxed)
  witFn(r, IfBe, "[method]" & view & ".set-waxed"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.setSignWaxed == nil or
        not callBeSetSignWaxed(bs, s, args[1].i != 0):
      return "Not a sign block entity"

proc installBlockEntity*(r: HostRegistry; bs: BlockEntityState) =
  let hk = bs.hooks
  # ---- block-entity
  witFn(r, IfBe, "[method]block-entity.resource-location"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.info == nil: return "invalid block entity resource handle"
    var inf = BeInfo()
    if not callBeInfo(bs, s, inf): return "invalid block entity resource handle"
    results.add vStr(inf.resourceLocation)
  witFn(r, IfBe, "[method]block-entity.get-position"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0: return "invalid block entity resource handle"
    results.add vRecord(@[vInt(int64(bs.slots[s].x)), vInt(int64(bs.slots[s].y)), vInt(int64(bs.slots[s].z))])
  witFn(r, IfBe, "[method]block-entity.get-id"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.info == nil: return "invalid block entity resource handle"
    var inf = BeInfo()
    if not callBeInfo(bs, s, inf): return "invalid block entity resource handle"
    results.add vInt(int64(inf.id))
  witFn(r, IfBe, "[method]block-entity.is-dirty"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.info == nil: return "invalid block entity resource handle"
    var inf = BeInfo()
    if not callBeInfo(bs, s, inf): return "invalid block entity resource handle"
    results.add vBool(inf.dirty)
  witFn(r, IfBe, "[method]block-entity.clear-dirty"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.clearDirty == nil: return "invalid block entity resource handle"
    callBeClearDirty(bs, s)
  # ---- the views that only hand back the block entity
  for view in ["command-block-entity", "sign-block-entity", "hanging-sign-block-entity", "jukebox-block-entity",
               "chest-block-entity", "mob-spawner-block-entity"]:
    installGetBlockEntity(r, bs, view)
  # ---- command-block-entity
  witFn(r, IfBe, "[method]command-block-entity.last-output"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vStr(c.lastOutput)
  witFn(r, IfBe, "[method]command-block-entity.track-output"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vBool(c.trackOutput)
  witFn(r, IfBe, "[method]command-block-entity.success-count"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vInt(int64(c.successCount))
  witFn(r, IfBe, "[method]command-block-entity.command"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vStr(c.command)
  witFn(r, IfBe, "[method]command-block-entity.auto"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vBool(c.auto)
  witFn(r, IfBe, "[method]command-block-entity.condition-met"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vBool(c.conditionMet)
  witFn(r, IfBe, "[method]command-block-entity.powered"):
    let s = slotAt(bs, int(args[0].i))
    var c = BeCommand()
    if s < 0 or hk.command == nil or not callBeCommand(bs, s, c):
      return "Not a command block entity"
    results.add vBool(c.powered)
  for view in ["sign-block-entity", "hanging-sign-block-entity"]:
    installSignView(r, bs, view)
  # ---- jukebox-block-entity
  witFn(r, IfBe, "[method]jukebox-block-entity.is-playing"):
    let s = slotAt(bs, int(args[0].i))
    var playing = false
    if s < 0 or hk.jukeboxPlaying == nil or
        not callBeJukeboxPlaying(bs, s, playing):
      return "Not a jukebox block entity"
    results.add vBool(playing)
  witFn(r, IfBe, "[method]jukebox-block-entity.stop-playing"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.jukeboxStop == nil or not callBeJukeboxStop(bs, s):
      return "Not a jukebox block entity"
  witFn(r, IfBe, "[method]jukebox-block-entity.start-playing"):
    let s = slotAt(bs, int(args[0].i))
    if s < 0 or hk.jukeboxStart == nil or
        not callBeJukeboxStart(bs, s, cast[uint64](args[1].i)):
      return "Not a jukebox block entity"
  # ---- chest-block-entity
  witFn(r, IfBe, "[method]chest-block-entity.viewer-count"):
    let s = slotAt(bs, int(args[0].i))
    var n = 0
    if s < 0 or hk.viewerCount == nil or not callBeViewerCount(bs, s, n):
      return "Not a chest block entity"
    results.add vInt(int64(n))
  # ---- mob-spawner-block-entity
  witFn(r, IfBe, "[method]mob-spawner-block-entity.get-spawn-count"):
    let s = slotAt(bs, int(args[0].i))
    var sp = BeSpawner()
    if s < 0 or hk.spawner == nil or not callBeSpawner(bs, s, sp):
      return "Not a mob spawner block entity"
    results.add vInt(int64(sp.spawnCount))
  witFn(r, IfBe, "[method]mob-spawner-block-entity.get-spawn-range"):
    let s = slotAt(bs, int(args[0].i))
    var sp = BeSpawner()
    if s < 0 or hk.spawner == nil or not callBeSpawner(bs, s, sp):
      return "Not a mob spawner block entity"
    results.add vInt(int64(sp.spawnRange))
  witFn(r, IfBe, "[method]mob-spawner-block-entity.get-delay"):
    let s = slotAt(bs, int(args[0].i))
    var sp = BeSpawner()
    if s < 0 or hk.spawner == nil or not callBeSpawner(bs, s, sp):
      return "Not a mob spawner block entity"
    results.add vInt(int64(sp.delay))
