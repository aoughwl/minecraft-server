## The rest of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/block_entity.rs (the newer tree's
## crates/pumpkin-wasm-host-v0_1/src/block_entity.rs): the typed views the pinned loader lacks, `container-block-entity`, the
## `get-container` of the views that hold items, and the custom data of a `block-entity`.
## A view's handle is the same slot of `BlockEntityState` as the plain `block-entity` (upstream makes one resource per view
## over the same provider), so `get-block-entity` and `get-container` answer the rep they were given. A view's getters go
## through `BlockEntityHooks.field(world, x, y, z, view, method, value)`, which pluginwire2.aowl answers from the real block
## entity (false = "Not a <view>" and the call traps, as upstream's downcast failure does); `container-block-entity` works on
## `BlockEntityHooks.inventory`, the real `Inventory` of the block entity, and hands stacks out as `item-stack` handles over copies.
## The custom data of a block entity is kept in `BlockEntityState.custom` by position (in memory only).
## PARTIAL: pumpkin/crates/pumpkin-wasm-host-v0_1/src/block_entity.rs - `container-block-entity.get-inventory` (the `inventory`
## resource of inventory.wit) is not provided and traps; the `map-block-entity` getters and setters trap (this server has no
## map block entity); the setters of views other than the sign, jukebox and command block are the ones upstream has (none).
import std/[options, tables, syncio]
import ../wasm/[canonabi, component]
import "../../data/item_stack/mod"
import ../../inventory/inventory
import ../../nbt/tag
import witstate, witstack, witblockentity

const IfBe = "pumpkin:plugin/block-entity"

type
  Getter = tuple[view: string, methods: seq[string]]

proc viewList(): seq[Getter] =
  ## Every view of the WIT that the pinned loader does not have, with its getters (all take no argument).
  @[
    (view: "banner-block-entity", methods: @["get-custom-name"]),
    (view: "barrel-block-entity", methods: @["viewer-count"]),
    (view: "beacon-block-entity", methods: @["get-primary-effect", "get-secondary-effect", "get-levels"]),
    (view: "bed-block-entity", methods: @[]),
    (view: "beehive-block-entity", methods: @["get-bee-count"]),
    (view: "bell-block-entity", methods: @["is-ringing", "get-ring-ticks"]),
    (view: "blasting-furnace-block-entity", methods: @["get-cooking-time-spent", "get-cooking-total-time", "get-lit-time-remaining", "get-lit-total-time", "is-burning"]),
    (view: "brewing-stand-block-entity", methods: @["get-brew-time", "get-fuel"]),
    (view: "brushable-block-block-entity", methods: @[]),
    (view: "calibrated-sculk-sensor-block-entity", methods: @[]),
    (view: "campfire-block-entity", methods: @[]),
    (view: "chiseled-bookshelf-block-entity", methods: @["get-last-interacted-slot"]),
    (view: "comparator-block-entity", methods: @["get-output-signal"]),
    (view: "conduit-block-entity", methods: @[]),
    (view: "copper-golem-statue-block-entity", methods: @[]),
    (view: "crafter-block-entity", methods: @["get-crafting-ticks-remaining", "is-triggered"]),
    (view: "creaking-heart-block-entity", methods: @["get-creaking-uuid"]),
    (view: "daylight-detector-block-entity", methods: @[]),
    (view: "decorated-pot-block-entity", methods: @[]),
    (view: "dispenser-block-entity", methods: @[]),
    (view: "dropper-block-entity", methods: @[]),
    (view: "enchanting-table-block-entity", methods: @[]),
    (view: "end-gateway-block-entity", methods: @["get-age", "is-exact-teleport"]),
    (view: "end-portal-block-entity", methods: @[]),
    (view: "ender-chest-block-entity", methods: @["viewer-count"]),
    (view: "furnace-block-entity", methods: @["get-cooking-time-spent", "get-cooking-total-time", "get-lit-time-remaining", "get-lit-total-time", "is-burning"]),
    (view: "hopper-block-entity", methods: @["get-cooldown"]),
    (view: "jigsaw-block-entity", methods: @["get-name", "get-target", "get-pool", "get-final-state", "get-selection-priority", "get-placement-priority"]),
    (view: "lectern-block-entity", methods: @["get-page"]),
    (view: "map-block-entity", methods: @["get-map-id", "get-colors", "update"]),
    (view: "piston-block-entity", methods: @["get-progress", "is-extending", "is-source"]),
    (view: "potent-sulfur-block-entity", methods: @[]),
    (view: "sculk-catalyst-block-entity", methods: @[]),
    (view: "sculk-sensor-block-entity", methods: @[]),
    (view: "sculk-shrieker-block-entity", methods: @["get-warning-level"]),
    (view: "shelf-block-entity", methods: @[]),
    (view: "shulker-box-block-entity", methods: @["viewer-count"]),
    (view: "skull-block-entity", methods: @["get-note-block-sound"]),
    (view: "smoker-block-entity", methods: @["get-cooking-time-spent", "get-cooking-total-time", "get-lit-time-remaining", "get-lit-total-time", "is-burning"]),
    (view: "structure-block-block-entity", methods: @["get-name", "get-author", "get-mode", "get-integrity", "get-seed"]),
    (view: "test-block-block-entity", methods: @[]),
    (view: "test-instance-block-block-entity", methods: @[]),
    (view: "trapped-chest-block-entity", methods: @["viewer-count"]),
    (view: "trial-spawner-block-entity", methods: @[]),
    (view: "vault-block-entity", methods: @[])]

const ContainerViews = ["jukebox-block-entity", "chest-block-entity", "trapped-chest-block-entity", "barrel-block-entity",
  "beacon-block-entity", "blasting-furnace-block-entity", "brewing-stand-block-entity", "campfire-block-entity",
  "chiseled-bookshelf-block-entity", "crafter-block-entity", "dispenser-block-entity", "dropper-block-entity",
  "furnace-block-entity", "hopper-block-entity", "lectern-block-entity", "shelf-block-entity", "shulker-box-block-entity",
  "smoker-block-entity"]

proc posKey(w, x, y, z: int): string = "b" & $w & ":" & $x & ":" & $y & ":" & $z

proc invOf(bs: BlockEntityState; rep: int): nil Inventory =
  var w = 0
  var x = 0
  var y = 0
  var z = 0
  if not bs.slotPos(rep, w, x, y, z) or bs.hooks.inventory == nil: return nil
  bs.hooks.inventory(w, x, y, z)

proc callFieldHook(bs: BlockEntityState; w, x, y, z: int; view, name: string; res: var CVal): bool =
  ## A closure field of a captured value called inside a closure asserts in hexer; the call is made here.
  bs.hooks.field(w, x, y, z, view, name, res)

proc installViewGetBlockEntity(r: HostRegistry; bs: BlockEntityState; view: string) =
  witFn(r, IfBe, "[method]" & view & ".get-block-entity"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid " & view & " resource handle"
    results.add vInt(args[0].i)

proc installViewMethod(r: HostRegistry; bs: BlockEntityState; view, name: string) =
  witFn(r, IfBe, "[method]" & view & "." & name):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid " & view & " resource handle"
    var v = vInt(0)
    if bs.hooks.field == nil or not callFieldHook(bs, w, x, y, z, view, name, v): return "Not a " & view
    results.add v

proc installViewGetContainer(r: HostRegistry; bs: BlockEntityState; vw: string) =
  witFn(r, IfBe, "[method]" & vw & ".get-container"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid " & vw & " resource handle"
    results.add vInt(args[0].i)

proc installBlockEntity2*(r: HostRegistry; bs: BlockEntityState; ss: StackState) =
  # ---- the typed views
  let viewsToInstall = viewList()   # bound first: `for x in f()` over a returned seq of tuples fails (borrow)
  let seq1Src = viewsToInstall
  for idx1 in 0 ..< seq1Src.len:
    let g = seq1Src[idx1]
    let view = g.view
    installViewGetBlockEntity(r, bs, view)
    let seq2Src = g.methods
    for idx2 in 0 ..< seq2Src.len:
      installViewMethod(r, bs, view, seq2Src[idx2])
  let seq3Src = ContainerViews
  for idx3 in 0 ..< seq3Src.len:
    installViewGetContainer(r, bs, seq3Src[idx3])
  # ---- the plain block-entity's custom data
  witFn(r, IfBe, "[method]block-entity.set-custom-data"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid block entity resource handle"
    var err = ""
    let tag = fromWitNbtTree(args[3], err)
    if err.len > 0: return err
    let key = posKey(w, x, y, z)
    var c = bs.custom.getOrDefault(key, newCompound())
    cdSet(c, args[1].s, args[2].s, tag)
    bs.custom[key] = c
  witFn(r, IfBe, "[method]block-entity.get-custom-data"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid block entity resource handle"
    let c = bs.custom.getOrDefault(posKey(w, x, y, z), newCompound())
    let v = cdGet(c, args[1].s, args[2].s)
    if v.isNone: results.add vNone()
    else: results.add vSome(toWitNbtTree(v.unsafeGet))
  witFn(r, IfBe, "[method]block-entity.remove-custom-data"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid block entity resource handle"
    let key = posKey(w, x, y, z)
    var c = bs.custom.getOrDefault(key, newCompound())
    cdRemove(c, args[1].s, args[2].s)
    bs.custom[key] = c
  witFn(r, IfBe, "[method]block-entity.has-custom-data"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid block entity resource handle"
    let c = bs.custom.getOrDefault(posKey(w, x, y, z), newCompound())
    results.add vBool(cdGet(c, args[1].s, args[2].s).isSome)
  # ---- container-block-entity
  witFn(r, IfBe, "[method]container-block-entity.get-block-entity"):
    var w = 0
    var x = 0
    var y = 0
    var z = 0
    if not bs.slotPos(int(args[0].i), w, x, y, z): return "invalid container block entity resource handle"
    results.add vInt(args[0].i)
  witFn(r, IfBe, "[method]container-block-entity.get-inventory"):
    return "container-block-entity.get-inventory: the inventory resource is not provided"
  witFn(r, IfBe, "[method]container-block-entity.get-size"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    results.add vInt(int64(inv.size()))
  witFn(r, IfBe, "[method]container-block-entity.is-empty"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    results.add vBool(inv.isEmpty())
  witFn(r, IfBe, "[method]container-block-entity.get-stack"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    let slot = int(args[1].i)
    if slot < 0 or slot >= inv.size(): results.add vNone()
    else:
      let stack = inv.getStack(slot)
      if stack.isEmpty(): results.add vNone()
      else: results.add vSome(vInt(int64(addStack(ss, stack))))
  witFn(r, IfBe, "[method]container-block-entity.set-stack"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    let slot = int(args[1].i)
    if slot < 0 or slot >= inv.size(): return "slot " & $slot & " is out of range"
    if args[2].i == 0:
      inv.setStack(slot, emptyItemStack())
    else:
      let rep = int(args[2].items[0].i)
      if not validStack(ss, rep): return "item-stack: invalid handle"
      inv.setStack(slot, ss.items[rep])
  witFn(r, IfBe, "[method]container-block-entity.remove-stack"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    let slot = int(args[1].i)
    if slot < 0 or slot >= inv.size(): results.add vNone()
    else:
      let stack = inv.removeStack(slot)
      if stack.isEmpty(): results.add vNone()
      else: results.add vSome(vInt(int64(addStack(ss, stack))))
  witFn(r, IfBe, "[method]container-block-entity.clear"):
    let inv = invOf(bs, int(args[0].i))
    if inv == nil: return "Not a container block entity"
    inv.clear()
