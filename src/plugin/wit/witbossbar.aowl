## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/boss_bar.rs: the `boss-bar` resource (`PluginBossBar`: the
## bar plus the players it was shown to). A bar is a slot of `WitState.bars` (rep = slot index). The packets go
## through `hooks.barOp`, which pluginmgr.aowl wires to `sendBossbar` / `updateBossbar*` / `removeBossbar`
## (src/server/world/bossbar.aowl); the colour/division/metadata enums are numerically the server's (WIT order = Rust order).
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/boss_bar.rs - bars are never freed (no `resource.drop`
## callback, so a dropped bar is not `remove-all`ed); a player who leaves is not pruned from a bar until its next use.
import ../../util/closureset
import ../wasm/[canonabi, component]
import ../../util/text/text
import witstate

const IfBar = "pumpkin:plugin/boss-bar"

proc metaVal(flags: int): CVal =
  vRecord(@[vBool((flags and BarFlagDarkenSky) != 0), vBool((flags and BarFlagDragonBar) != 0),
            vBool((flags and BarFlagCreateFog) != 0)])

proc metaFlags(v: CVal): int =
  result = 0
  if v.items[0].i != 0: result = result or BarFlagDarkenSky
  if v.items[1].i != 0: result = result or BarFlagDragonBar
  if v.items[2].i != 0: result = result or BarFlagCreateFog

proc online(st: WitState; id: int): bool =
  if not closureSet(st.hooks.playerIds): return false
  let ids = hkPlayerIds(st.hooks)
  for p in ids:
    if p == id: return true
  false

proc emit(st: WitState; op: BarOp; bar: int) =
  ## Sends `op` for every player that has the bar (`for uuid in &pbb.players { ... }`).
  if not closureSet(st.hooks.barOp): return
  for p in st.bars[bar].players:
    hkBarOp(st.hooks, op, p, st.bars[bar])

proc badBar(st: WitState; rep: int): bool = rep < 0 or rep >= st.bars.len

proc installBossBar*(r: HostRegistry; st: WitState) =
  witFn(r, IfBar, "[constructor]boss-bar"):
    st.bars.add WBar(n: st.bars.len, title: textAt(st, int(args[0].i)), health: 0.0'f32, color: int(args[1].i),
                     division: int(args[2].i), flags: 0, players: @[])
    results.add vInt(int64(st.bars.len - 1))
  witFn(r, IfBar, "[method]boss-bar.get-title"):
    if badBar(st, int(args[0].i)): return "boss-bar: invalid handle"
    results.add vInt(int64(newTextRep(st, st.bars[int(args[0].i)].title)))
  witFn(r, IfBar, "[method]boss-bar.set-title"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    st.bars[b].title = textAt(st, int(args[1].i))
    emit(st, boTitle, b)
  witFn(r, IfBar, "[method]boss-bar.get-health"):
    if badBar(st, int(args[0].i)): return "boss-bar: invalid handle"
    results.add vFloat(float64(st.bars[int(args[0].i)].health))
  witFn(r, IfBar, "[method]boss-bar.set-health"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    st.bars[b].health = float32(args[1].f)
    emit(st, boHealth, b)
  witFn(r, IfBar, "[method]boss-bar.get-color"):
    if badBar(st, int(args[0].i)): return "boss-bar: invalid handle"
    results.add vInt(int64(st.bars[int(args[0].i)].color))
  witFn(r, IfBar, "[method]boss-bar.set-color"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    st.bars[b].color = int(args[1].i)
    emit(st, boStyle, b)
  witFn(r, IfBar, "[method]boss-bar.get-division"):
    if badBar(st, int(args[0].i)): return "boss-bar: invalid handle"
    results.add vInt(int64(st.bars[int(args[0].i)].division))
  witFn(r, IfBar, "[method]boss-bar.set-division"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    st.bars[b].division = int(args[1].i)
    emit(st, boStyle, b)
  witFn(r, IfBar, "[method]boss-bar.get-metadata"):
    if badBar(st, int(args[0].i)): return "boss-bar: invalid handle"
    results.add metaVal(st.bars[int(args[0].i)].flags)
  witFn(r, IfBar, "[method]boss-bar.set-metadata"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    st.bars[b].flags = metaFlags(args[1])
    emit(st, boFlags, b)
  witFn(r, IfBar, "[method]boss-bar.get-players"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    var items: seq[CVal] = @[]
    for p in st.bars[b].players:
      if online(st, p): items.add vInt(int64(p))
    results.add vList(items)
  witFn(r, IfBar, "[method]boss-bar.add-player"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    let p = int(args[1].i)
    if p notin st.bars[b].players:
      st.bars[b].players.add p
      if closureSet(st.hooks.barOp): hkBarOp(st.hooks, boAdd, p, st.bars[b])
  witFn(r, IfBar, "[method]boss-bar.remove-player"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    let p = int(args[1].i)
    var idx = -1
    var i = 0
    while i < st.bars[b].players.len:
      if st.bars[b].players[i] == p: idx = i
      inc i
    if idx >= 0:
      st.bars[b].players.delete(idx)
      if closureSet(st.hooks.barOp): hkBarOp(st.hooks, boRemove, p, st.bars[b])
  witFn(r, IfBar, "[method]boss-bar.remove-all"):
    let b = int(args[0].i)
    if badBar(st, b): return "boss-bar: invalid handle"
    emit(st, boRemove, b)
