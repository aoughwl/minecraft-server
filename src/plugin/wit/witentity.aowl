## The `entity` host interface: the `entity` and `living-entity` resources (declared in world.wit; entity.wit only
## re-exports them). Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/entity.rs. An entity handle's rep is the
## entity id (witserver.aowl); a player is an entity too, so every method first copies the `Player`'s fields onto the
## adapter `Entity` that `playerBase` keeps (`syncFromPlayer`) and the setters that change a player write both.
##
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/entity.rs - third batch (witentity3.aowl): remaining/max air,
## set-vehicle, custom data, raycast and the entity ray traces, living max health, attributes, equipment and the `mob` resource
## (see that file's PARTIAL line); second batch (witentity2.aowl): bounding box, portal cooldown, visual fire, vehicle read,
## add/remove/eject passengers, nearby entities, typed living damage, silent and gravity (real `Entity.silent` / `noGravity`
## fields the server reads). First batch: identity, type, position, rotation,
## world, velocity, pose, names, invulnerable, fire, fall distance, ticks lived, the movement flags, dimensions, eye
## height, ground/fire/water/lava state, passengers read, remove, `as-living`/`is-living`/`is-mob`, living health, max
## health, absorption, age, `send-system-message`. Missing: see witentity3.aowl.
import std/[options]
import ../wasm/[component, canonabi]
import ../../util/vector3
import ../../util/text/text
import ../../generated/entity_pose
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/entity/player as playermod
import witstate, witserver, witentity2

proc gone(): string = "entity is gone"

proc entOf(rep: int): nil EntityBase =
  let eb = entityById(rep)
  if eb != nil and eb.player != nil:
    syncFromPlayer(eb)
  eb

proc installEntity*(r: HostRegistry; w: WitState) =
  # ---- identity ----
  hostFn(r, IfaceEntity, "[method]entity.get-id"):
    results.add vInt(args[0].i)
  hostFn(r, IfaceEntity, "[method]entity.get-uuid"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vRecord(@[u64Val(eb.entity.entityUuid.hi), u64Val(eb.entity.entityUuid.lo)])
  hostFn(r, IfaceEntity, "[method]entity.get-type"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(enumIndex(resultTy(ci), eb.entity.entityType.name)))
  hostFn(r, IfaceEntity, "[method]entity.get-name"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(newTextRep(w, getName(eb))))
  hostFn(r, IfaceEntity, "[method]entity.get-custom-name"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.entity.customName.isSome: results.add vSome(vInt(int64(newTextRep(w, eb.entity.customName.unsafeGet))))
    else: results.add vNone()
  hostFn(r, IfaceEntity, "[method]entity.set-custom-name"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setCustomName(eb.entity, textAt(w, int(args[1].i)))
  hostFn(r, IfaceEntity, "[method]entity.is-custom-name-visible"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.customNameVisible)
  hostFn(r, IfaceEntity, "[method]entity.set-custom-name-visible"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setCustomNameVisible(eb.entity, args[1].i != 0)
  # ---- position and rotation ----
  hostFn(r, IfaceEntity, "[method]entity.get-position"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vPos(eb.entity.pos)
  hostFn(r, IfaceEntity, "[method]entity.get-world"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(worldRep(eb.entity.world)))
  hostFn(r, IfaceEntity, "[method]entity.get-yaw"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.yaw))
  hostFn(r, IfaceEntity, "[method]entity.get-pitch"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.pitch))
  hostFn(r, IfaceEntity, "[method]entity.get-head-yaw"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.headYaw))
  hostFn(r, IfaceEntity, "[method]entity.set-rotation"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player != nil: playermod.setRotation(mustPlayer(eb), float32(args[1].f), float32(args[2].f))
    else:
      eb.entity.yaw = float32(args[1].f)
      eb.entity.headYaw = float32(args[1].f)
      eb.entity.pitch = float32(args[2].f)
  hostFn(r, IfaceEntity, "[method]entity.teleport"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    let pos = posOf(args[1])
    if eb.player != nil:
      playermod.requestTeleport(mustPlayer(eb), pos, mustPlayer(eb).yaw, mustPlayer(eb).pitch)
    else:
      var target = worldAt(int(args[2].i))
      if target == nil: target = eb.entity.world
      entitymod.teleport(eb, pos, none[float32](), none[float32](), target)
  hostFn(r, IfaceEntity, "[method]entity.get-velocity"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vPos(eb.entity.velocity)
  hostFn(r, IfaceEntity, "[method]entity.set-velocity"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setVelocity(eb.entity, posOf(args[1]))
    if eb.player != nil: syncToPlayer(eb)
  hostFn(r, IfaceEntity, "[method]entity.get-pose"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(min(ord(eb.entity.pose), max(0, resultTy(ci).names.len - 1))))
  # ---- flags ----
  hostFn(r, IfaceEntity, "[method]entity.is-invulnerable"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.invulnerable)
  hostFn(r, IfaceEntity, "[method]entity.set-invulnerable"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    eb.entity.invulnerable = args[1].i != 0
  hostFn(r, IfaceEntity, "[method]entity.get-fire-ticks"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(eb.entity.fireTicks))
  hostFn(r, IfaceEntity, "[method]entity.set-fire-ticks"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    eb.entity.fireTicks = int32(args[1].i)
    setOnFire(eb.entity, eb.entity.fireTicks > 0'i32)
  hostFn(r, IfaceEntity, "[method]entity.is-on-fire"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.fireTicks > 0'i32)
  hostFn(r, IfaceEntity, "[method]entity.set-on-fire"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setOnFire(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.get-fall-distance"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(if eb.living != nil: float64(mustLiving(eb).fallDistance) else: 0.0)
  hostFn(r, IfaceEntity, "[method]entity.set-fall-distance"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.living != nil: mustLiving(eb).fallDistance = float32(args[1].f)
    if eb.player != nil: syncToPlayer(eb)
  hostFn(r, IfaceEntity, "[method]entity.get-ticks-lived"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(eb.entity.age))
  hostFn(r, IfaceEntity, "[method]entity.set-ticks-lived"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setAge(eb.entity, int32(args[1].i))
  hostFn(r, IfaceEntity, "[method]entity.is-sneaking"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.sneaking)
  hostFn(r, IfaceEntity, "[method]entity.set-sneaking"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player != nil: playermod.setSneaking(mustPlayer(eb), args[1].i != 0)
    else: setSneaking(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-sprinting"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.sprinting)
  hostFn(r, IfaceEntity, "[method]entity.set-sprinting"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player != nil: playermod.setSprinting(mustPlayer(eb), args[1].i != 0)
    else: setSprinting(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-swimming"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.swimming)
  hostFn(r, IfaceEntity, "[method]entity.set-swimming"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setSwimming(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-invisible"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.invisible)
  hostFn(r, IfaceEntity, "[method]entity.set-invisible"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setInvisible(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-glowing"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.glowing)
  hostFn(r, IfaceEntity, "[method]entity.set-glowing"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setGlowing(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-fall-flying"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.fallFlying)
  hostFn(r, IfaceEntity, "[method]entity.set-fall-flying"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player != nil: playermod.setFallFlying(mustPlayer(eb), args[1].i != 0)
    else: setFallFlying(eb.entity, args[1].i != 0)
  hostFn(r, IfaceEntity, "[method]entity.is-on-ground"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.onGround)
  hostFn(r, IfaceEntity, "[method]entity.is-in-water"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.touchingWater)
  hostFn(r, IfaceEntity, "[method]entity.is-in-lava"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.touchingLava)
  # ---- size ----
  hostFn(r, IfaceEntity, "[method]entity.get-width"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.entityDimension.width))
  hostFn(r, IfaceEntity, "[method]entity.get-height"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.entityDimension.height))
  hostFn(r, IfaceEntity, "[method]entity.get-eye-height"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vFloat(float64(eb.entity.entityDimension.eyeHeight))
  hostFn(r, IfaceEntity, "[method]entity.get-eye-position"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vPos(getEyePos(eb.entity))
  # ---- passengers, removal, kinds ----
  hostFn(r, IfaceEntity, "[method]entity.get-passengers"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    var l: seq[CVal] = @[]
    var i = 0
    while i < eb.entity.passengers.len:
      l.add vInt(int64(eb.entity.passengers[i].entity.entityId))
      inc i
    results.add vList(l)
  hostFn(r, IfaceEntity, "[method]entity.remove"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player == nil: entitymod.remove(eb.entity)
  hostFn(r, IfaceEntity, "[method]entity.is-living"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.living != nil)
  hostFn(r, IfaceEntity, "[method]entity.as-living"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.living != nil: results.add vSome(vInt(args[0].i))
    else: results.add vNone()
  # ---- living-entity ----
  hostFn(r, IfaceEntity, "[method]living-entity.as-entity"):
    results.add vInt(args[0].i)
  hostFn(r, IfaceEntity, "[method]living-entity.get-health"):
    let eb = entOf(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    results.add vFloat(float64(mustLiving(eb).health))
  hostFn(r, IfaceEntity, "[method]living-entity.set-health"):
    let eb = entOf(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    mustLiving(eb).health = float32(args[1].f)
    if eb.player != nil:
      syncToPlayer(eb)
      playermod.sendHealth(mustPlayer(eb))
  hostFn(r, IfaceEntity, "[method]living-entity.is-dead"):
    let eb = entOf(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    results.add vBool(mustLiving(eb).dead)
  hostFn(r, IfaceEntity, "[method]living-entity.get-absorption"):
    let eb = entOf(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    results.add vFloat(float64(mustLiving(eb).absorption))
  hostFn(r, IfaceEntity, "[method]living-entity.set-absorption"):
    let eb = entOf(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    mustLiving(eb).absorption = float32(args[1].f)
    if eb.player != nil: syncToPlayer(eb)
  hostFn(r, IfaceEntity, "[method]living-entity.get-age"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(eb.entity.age))
  hostFn(r, IfaceEntity, "[method]living-entity.set-age"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    setAge(eb.entity, int32(args[1].i))
  hostFn(r, IfaceEntity, "[method]living-entity.send-system-message"):
    let eb = entOf(int(args[0].i))
    if eb == nil: return gone()
    if eb.player != nil: gLink.sendSystemMessage(mustPlayer(eb), textAt(w, int(args[1].i)), false)
  installEntityMore(r, w)
