## The second half of the `entity` and `living-entity` resources of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/entity.rs
## (the newer tree's pumpkin-wasm-host-v0_1/src/entity.rs for the methods the pinned host lacks), over the same
## `EntityBase` lookups as witentity.aowl, which calls `installEntityMore` at its end.
import std/[options, strutils, tables]
import ../wasm/[component, canonabi]
import ../../util/vector3
import ../../util/math/boundingbox
import ../../generated/damage_type
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/entity/player as playermod
import witstate, witserver

proc gone(): string = "entity is gone"

proc entOf2(rep: int): nil EntityBase =
  let eb = entityById(rep)
  if eb != nil and eb.player != nil:
    syncFromPlayer(eb)
  eb

var gSilent*: Table[int32, bool] = initTable[int32, bool]()
var gNoGravity*: Table[int32, bool] = initTable[int32, bool]()

proc installEntityMore*(r: HostRegistry; w: WitState) =
  hostFn(r, IfaceEntity, "[method]entity.get-bounding-box"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    let b = eb.entity.boundingBox
    results.add vRecord(@[vPos(b.min), vPos(b.max)])
  hostFn(r, IfaceEntity, "[method]entity.get-portal-cooldown"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    results.add vInt(int64(eb.entity.portalCooldown))
  hostFn(r, IfaceEntity, "[method]entity.set-portal-cooldown"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    eb.entity.portalCooldown = uint32(args[1].i)
  hostFn(r, IfaceEntity, "[method]entity.has-visual-fire"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(eb.entity.hasVisualFire)
  hostFn(r, IfaceEntity, "[method]entity.set-visual-fire"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    eb.entity.hasVisualFire = args[1].i != 0
  hostFn(r, IfaceEntity, "[method]entity.is-silent"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(gSilent.getOrDefault(eb.entity.entityId))
  hostFn(r, IfaceEntity, "[method]entity.set-silent"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    gSilent[eb.entity.entityId] = args[1].i != 0
  hostFn(r, IfaceEntity, "[method]entity.has-gravity"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    results.add vBool(not gNoGravity.getOrDefault(eb.entity.entityId))
  hostFn(r, IfaceEntity, "[method]entity.set-has-gravity"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    gNoGravity[eb.entity.entityId] = args[1].i == 0
  hostFn(r, IfaceEntity, "[method]entity.get-vehicle"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    if eb.entity.vehicle != nil: results.add vSome(vInt(int64(eb.entity.vehicle.entity.entityId)))
    else: results.add vNone()
  hostFn(r, IfaceEntity, "[method]entity.add-passenger"):
    let eb = entOf2(int(args[0].i))
    let pa = entOf2(int(args[1].i))
    if eb == nil or pa == nil: return gone()
    addPassenger(eb.entity, eb, pa)
  hostFn(r, IfaceEntity, "[method]entity.remove-passenger"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    removePassenger(eb.entity, int32(args[1].i))
  hostFn(r, IfaceEntity, "[method]entity.eject-passengers"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    var ids: seq[int32] = @[]
    for p in eb.entity.passengers: ids.add p.entity.entityId
    for id in ids: removePassenger(eb.entity, id)
  hostFn(r, IfaceEntity, "[method]entity.get-nearby-entities"):
    let eb = entOf2(int(args[0].i))
    if eb == nil: return gone()
    # the entities of the world within (x, y, z) blocks of this one on each axis, itself excluded
    let rx = args[1].f
    let ry = args[2].f
    let rz = args[3].f
    let c = eb.entity.pos
    var items: seq[CVal] = @[]
    for wp in eb.entity.world.players:
      let q = wp.pos
      if wp.entityId != eb.entity.entityId and abs(q.x - c.x) <= rx and abs(q.y - c.y) <= ry and abs(q.z - c.z) <= rz:
        items.add vInt(int64(wp.entityId))
    for e in allEntities(eb.entity.world):
      let q = e.entity.pos
      if e.entity.entityId != eb.entity.entityId and abs(q.x - c.x) <= rx and abs(q.y - c.y) <= ry and abs(q.z - c.z) <= rz:
        items.add vInt(int64(e.entity.entityId))
    results.add vList(items)
  hostFn(r, IfaceEntity, "[method]living-entity.damage"):
    let eb = entOf2(int(args[0].i))
    if eb == nil or eb.living == nil: return gone()
    let nm = enumName(paramTy(ci, 2), int(args[2].i)).replace("-", "_")
    let (ok, dt) = damageTypeFromName(nm)
    if not ok: return "unknown damage type " & nm
    discard damage(eb, eb, float32(args[1].f), dt)
