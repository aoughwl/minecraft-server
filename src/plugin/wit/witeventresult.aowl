## What the event conversions (witeventsblock.aowl, witeventsworld.aowl, witeventsserver.aowl) read an event back from: the
## outcome of `fireEvent` (pluginhost.aowl) without its other fields, so the conversions need nothing of the plugin host and
## can be tested on their own. `pluginwireevents.aowl` makes one from an `EventOutcome`.
import ../wasm/canonabi

type
  EventResult* = object
    ## `cancelled`: a blocking handler cancelled it; `fieldNames` / `fieldVals`: the event's fields as the last handler left them.
    cancelled*: bool
    fieldNames*: seq[string]
    fieldVals*: seq[CVal]

proc outField*(o: EventResult; name: string): CVal =
  ## The value of field `name` after the handlers; the zero value when the call had no such field.
  result = vInt(0)
  var i = 0
  while i < o.fieldNames.len:
    if o.fieldNames[i] == name: result = o.fieldVals[i]
    inc i

proc cancelledOf*(o: EventResult): bool = o.cancelled or outField(o, "cancelled").i != 0
