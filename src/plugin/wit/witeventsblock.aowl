## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/block.rs: `ToFromWasmEvent` for BlockRedstoneEvent,
## BlockBreakEvent, BlockBurnEvent, BlockCanBuildEvent, BlockGrowEvent and BlockPlaceEvent. Each event has a `toWasm`
## (the values given to `fireEvent` of pluginhost.aowl by pluginwireevents.aowl, in the order of the field-name list beside it: the WIT record's
## names, kebab-case) and a `fromWasm` (the event read back from the `EventResult`, what the last blocking handler left in
## it), and a `fire` that is both around `fireEvent`. As upstream: a block is its `minecraft:` name, a block state its id
## (`BlockStateId::new_or_air` when read back), a position a record of three ints, a world or player a rep that `worldAt` /
## `playerById` (witserver.aowl) find again.
## Deviations from upstream, which `expect`s: a block name a plugin changed to one that does not exist (upstream panics with
## "invalid block name") keeps the event's own block, and a world or player rep that is gone keeps the event's own.
## `witeventsplayer2.aowl` converts the same break and place for the player path with strings; these are the typed ones.
import std/options
import ../wasm/canonabi
import ../../data/block_ext
from ../../data/block_state import BlockStateId, asU16
import ../../util/math/position
import ../../server/serverbase
import "../api/events/block/mod"
import witserver, witeventresult

proc toWasmBlockName*(b: Block): string = "minecraft:" & b.name

proc fromWasmBlockName*(name: string; fallback: Block): Block =
  ## `from_wasm_block_name`: `Block::from_registry_key` of the name without `minecraft:`.
  var key = name
  if key.len > 10 and key[0 ..< 10] == "minecraft:": key = key[10 ..< key.len]
  let b = Block.fromRegistryKey(key)
  if b == nil: fallback else: b

proc toWasmBlockPosition*(p: BlockPos): CVal =
  vRecord(@[vInt(int64(p.vec.x)), vInt(int64(p.vec.y)), vInt(int64(p.vec.z))])

proc fromWasmBlockPosition*(v: CVal; fallback: BlockPos): BlockPos =
  if v.items.len == 3: newBlockPos(int32(v.items[0].i), int32(v.items[1].i), int32(v.items[2].i)) else: fallback

proc worldOrElse*(rep: CVal; fallback: World): World =
  let w = worldAt(int(rep.i))
  if w == nil: fallback else: w

proc playerOrElse*(rep: CVal; fallback: Player): Player =
  let p = playerById(int(rep.i))
  if p == nil: fallback else: p

# ---- BlockRedstoneEvent --------------------------------------------------------------------------

let RedstoneFields* = @["target-world", "state-id", "block-pos", "old-current", "new-current", "cancelled"]

proc toWasm*(e: BlockRedstoneEvent): seq[CVal] =
  @[vInt(int64(worldRep(e.world))), vInt(int64(asU16(e.blockStateId))), toWasmBlockPosition(e.blockPos),
    vInt(int64(e.oldCurrent)), vInt(int64(e.newCurrent)), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockRedstoneEvent): BlockRedstoneEvent =
  BlockRedstoneEvent(world: worldOrElse(outField(o, "target-world"), e.world),
    blockStateId: newBlockStateIdOrAir(uint16(outField(o, "state-id").i)),
    blockPos: fromWasmBlockPosition(outField(o, "block-pos"), e.blockPos),
    oldCurrent: int32(outField(o, "old-current").i), newCurrent: int32(outField(o, "new-current").i),
    cancelled: cancelledOf(o))

# ---- BlockBreakEvent -----------------------------------------------------------------------------

let BreakFields* = @["player", "block", "block-pos", "exp", "should-drop", "cancelled"]

proc toWasm*(e: BlockBreakEvent): seq[CVal] =
  let player = if e.player.isSome: vSome(vInt(int64(e.player.unsafeGet.entityId))) else: vNone()
  @[player, vStr(toWasmBlockName(e.blockRef)), toWasmBlockPosition(e.blockPosition), vInt(int64(e.exp)),
    vBool(e.drop), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockBreakEvent): BlockBreakEvent =
  var player = e.player
  let pv = outField(o, "player")
  if pv.i != 0 and pv.items.len == 1:
    let found = playerById(int(pv.items[0].i))
    if found != nil: player = some[Player](found)
  BlockBreakEvent(player: player, blockRef: fromWasmBlockName(outField(o, "block").s, e.blockRef),
    blockPosition: fromWasmBlockPosition(outField(o, "block-pos"), e.blockPosition),
    exp: uint32(outField(o, "exp").i), drop: outField(o, "should-drop").i != 0, cancelled: cancelledOf(o))

# ---- BlockBurnEvent ------------------------------------------------------------------------------

let BurnFields* = @["igniting-block", "block", "cancelled"]

proc toWasm*(e: BlockBurnEvent): seq[CVal] =
  @[vStr(toWasmBlockName(e.ignitingBlock)), vStr(toWasmBlockName(e.blockRef)), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockBurnEvent): BlockBurnEvent =
  BlockBurnEvent(ignitingBlock: fromWasmBlockName(outField(o, "igniting-block").s, e.ignitingBlock),
    blockRef: fromWasmBlockName(outField(o, "block").s, e.blockRef), cancelled: cancelledOf(o))

# ---- BlockCanBuildEvent --------------------------------------------------------------------------

let CanBuildFields* = @["block-to-build", "buildable", "player", "block", "cancelled"]

proc toWasm*(e: BlockCanBuildEvent): seq[CVal] =
  @[vStr(toWasmBlockName(e.blockToBuild)), vBool(e.buildable), vInt(int64(e.player.entityId)),
    vStr(toWasmBlockName(e.blockRef)), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockCanBuildEvent): BlockCanBuildEvent =
  BlockCanBuildEvent(blockToBuild: fromWasmBlockName(outField(o, "block-to-build").s, e.blockToBuild),
    buildable: outField(o, "buildable").i != 0, player: playerOrElse(outField(o, "player"), e.player),
    blockRef: fromWasmBlockName(outField(o, "block").s, e.blockRef), cancelled: cancelledOf(o))

# ---- BlockGrowEvent ------------------------------------------------------------------------------

let GrowFields* = @["target-world", "old-block", "old-state-id", "new-block", "new-state-id", "block-pos", "cancelled"]

proc toWasm*(e: BlockGrowEvent): seq[CVal] =
  @[vInt(int64(worldRep(e.world))), vStr(toWasmBlockName(e.oldBlock)), vInt(int64(asU16(e.oldStateId))),
    vStr(toWasmBlockName(e.newBlock)), vInt(int64(asU16(e.newStateId))), toWasmBlockPosition(e.blockPos), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockGrowEvent): BlockGrowEvent =
  BlockGrowEvent(world: worldOrElse(outField(o, "target-world"), e.world),
    oldBlock: fromWasmBlockName(outField(o, "old-block").s, e.oldBlock),
    oldStateId: newBlockStateIdOrAir(uint16(outField(o, "old-state-id").i)),
    newBlock: fromWasmBlockName(outField(o, "new-block").s, e.newBlock),
    newStateId: newBlockStateIdOrAir(uint16(outField(o, "new-state-id").i)),
    blockPos: fromWasmBlockPosition(outField(o, "block-pos"), e.blockPos), cancelled: cancelledOf(o))

# ---- BlockPlaceEvent -----------------------------------------------------------------------------

let PlaceFields* = @["player", "block-placed", "block-placed-against", "block-pos", "can-build", "cancelled"]

proc toWasm*(e: BlockPlaceEvent): seq[CVal] =
  @[vInt(int64(e.player.entityId)), vStr(toWasmBlockName(e.blockPlaced)), vStr(toWasmBlockName(e.blockPlacedAgainst)),
    toWasmBlockPosition(e.blockPosition), vBool(e.canBuild), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: BlockPlaceEvent): BlockPlaceEvent =
  BlockPlaceEvent(player: playerOrElse(outField(o, "player"), e.player),
    blockPlaced: fromWasmBlockName(outField(o, "block-placed").s, e.blockPlaced),
    blockPlacedAgainst: fromWasmBlockName(outField(o, "block-placed-against").s, e.blockPlacedAgainst),
    blockPosition: fromWasmBlockPosition(outField(o, "block-pos"), e.blockPosition),
    canBuild: outField(o, "can-build").i != 0, cancelled: cancelledOf(o))

