## Tests for the block, theWorld and server event conversions (witeventsblock.aowl, witeventsworld.aowl, witeventsserver.aowl) and
## the event types of plugin/api/events/{block,theWorld,server}. No plugin is loaded: `toWasm` is checked against the values the
## WIT records hold (known answers, in the order of the field-name lists), `fromWasm` against an `EventResult` built by hand
## as a handler that rewrote fields would leave it, and the fields given back unchanged (what `fireEvent` returns with no plugin registered: the
## event must come back as it was and not cancelled). A real component handling these events is not part of this test.
import std/[syncio, assertions, options]
import ../wasm/canonabi
import ../pluginhooksevents
import witstate, witserver, witeventresult, witeventsblock, witeventsworld, witeventsserver
import ../../data/block_ext
from ../../data/block_state import BlockStateId, asU16, newBlockStateIdUnchecked
import ../../util/math/position
import ../../util/text/text
import ../../server/serverbase
from "../../server/block/blockbehaviour" import BlockWorld
import "../api/events/block/mod"
import "../api/events/world/mod"
import "../api/events/server/mod"

var failed = false

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    failed = true

proc outcome(names: seq[string]; vals: seq[CVal]; cancelled: bool): EventResult =
  EventResult(cancelled: cancelled, fieldNames: names, fieldVals: vals)

proc unchanged(names: seq[string]; vals: seq[CVal]): EventResult =
  ## What `fireEvent` returns when no plugin is registered: the fields as given, not cancelled.
  outcome(names, vals, false)

proc blockNamed(name: string): Block =
  let b = Block.fromRegistryKey(name)
  if b == nil:
    echo "FAILED no block ", name
    quit 1
  else:
    b

let thePlayer = Player(entityId: 5'i32)
let theWorld = World(players: @[thePlayer])
let otherWorld = World(players: @[])
gLink.server = Server(worlds: @[theWorld, otherWorld])
let stone = blockNamed("stone")
let dirt = blockNamed("dirt")
let wheat = blockNamed("wheat")
let pos = newBlockPos(10'i32, -4'i32, 7'i32)
let ws = newWitState()
let st = stone.defaultState.id
let growEv = newBlockGrowEvent(theWorld, wheat, st, dirt, st, pos)
let brk = newBlockBreakEvent(some(thePlayer), stone, pos, 3'u32, true)


proc section0() =
  # -- the event types ---------------------------------------------------------------------------
  ck(not brk.cancelled and brk.exp == 3'u32 and brk.drop and getBlock(brk) == stone, "BlockBreakEvent::new, get_block")
  ck(getBlock(newBlockBurnEvent(wheat, dirt)) == dirt, "BlockBurnEvent::get_block is the burning block")
  ck(getBlock(newBlockCanBuildEvent(stone, true, thePlayer, dirt)) == dirt, "BlockCanBuildEvent::get_block is the one built upon")
  ck(getBlock(growEv) == wheat, "BlockGrowEvent::get_block is the old block")
  ck(getBlock(newBlockPlaceEvent(thePlayer, stone, dirt, pos, true)) == stone, "BlockPlaceEvent::get_block is the placed block")
  ck(getBlock(newBlockRedstoneEvent(theWorld, st, pos, 0'i32, 15'i32)) == stone, "BlockRedstoneEvent::get_block is from the state id")


proc section1() =
  # -- block-redstone: toWasm known answer, fromWasm of a rewrite, a call that changed nothing -------------
  let red = newBlockRedstoneEvent(otherWorld, st, pos, 0'i32, 15'i32)
  let rv = toWasm(red)
  ck(RedstoneFields.len == rv.len, "redstone: one value per field")
  ck(rv[0].i == 1 and rv[1].i == int64(asU16(st)) and rv[2].items.len == 3 and rv[2].items[1].i == -4 and rv[3].i == 0 and
     rv[4].i == 15 and rv[5].i == 0, "redstone: toWasm values")
  var edited = rv
  edited[4] = vInt(7)
  edited[5] = vBool(true)
  let rb = fromWasm(outcome(RedstoneFields, edited, false), red)
  ck(rb.newCurrent == 7 and rb.cancelled and rb.world == otherWorld and rb.blockPos == pos and rb.oldCurrent == 0, "redstone: fromWasm")
  ck(fromWasm(outcome(RedstoneFields, rv, true), red).cancelled, "redstone: the outcome's own cancelled counts")
  let rf = fromWasm(unchanged(RedstoneFields, toWasm(red)), red)
  ck(not rf.cancelled and rf.newCurrent == 15 and rf.world == otherWorld and rf.blockStateId == st, "redstone: a call that changed nothing")


proc section2() =
  # -- block-break -------------------------------------------------------------------------------
  let bv = toWasm(brk)
  ck(bv[0].i == 1 and bv[0].items[0].i == 5 and bv[1].s == "minecraft:stone" and bv[3].i == 3 and bv[4].i == 1,
     "break: toWasm player, minecraft: name, exp, should-drop")
  ck(toWasm(newBlockBreakEvent(none[Player](), stone, pos, 0'u32, false))[0].i == 0, "break: no player is none")
  var be = bv
  be[1] = vStr("minecraft:dirt")
  be[4] = vBool(false)
  be[3] = vInt(9)
  let bb = fromWasm(outcome(BreakFields, be, false), brk)
  ck(bb.blockRef == dirt and not bb.drop and bb.exp == 9'u32 and bb.player.isSome and bb.player.unsafeGet == thePlayer,
     "break: fromWasm block, drop, exp, player")
  be[1] = vStr("minecraft:no_such_block")
  ck(fromWasm(outcome(BreakFields, be, false), brk).blockRef == stone, "break: an unknown block name keeps the event's block")
  be[1] = vStr("stone")
  ck(fromWasm(outcome(BreakFields, be, false), brk).blockRef == stone, "break: a name without the namespace is accepted")
  let bf = fromWasm(unchanged(BreakFields, toWasm(brk)), brk)
  ck(not bf.cancelled and bf.drop and bf.exp == 3'u32 and bf.blockRef == stone and bf.player.unsafeGet == thePlayer,
     "break: a call that changed nothing")


proc section3() =
  # -- block-burn, block-can-build ---------------------------------------------------------------
  let burn = newBlockBurnEvent(wheat, dirt)
  let bu = toWasm(burn)
  ck(bu[0].s == "minecraft:wheat" and bu[1].s == "minecraft:dirt", "burn: toWasm")
  ck(fromWasm(outcome(BurnFields, @[vStr("minecraft:stone"), bu[1], vBool(true)], false), burn).ignitingBlock == stone,
     "burn: fromWasm")
  ck(not fromWasm(unchanged(BurnFields, toWasm(burn)), burn).cancelled, "burn: a call that changed nothing")
  let cb = newBlockCanBuildEvent(stone, true, thePlayer, dirt)
  let cv = toWasm(cb)
  ck(cv[0].s == "minecraft:stone" and cv[1].i == 1 and cv[2].i == 5 and cv[3].s == "minecraft:dirt", "can-build: toWasm")
  let cbb = fromWasm(outcome(CanBuildFields, @[cv[0], vBool(false), cv[2], cv[3], vBool(true)], false), cb)
  ck(not cbb.buildable and cbb.cancelled and cbb.player == thePlayer, "can-build: fromWasm")
  ck(fromWasm(unchanged(CanBuildFields, toWasm(cb)), cb).buildable, "can-build: a call that changed nothing")


proc section4() =
  # -- block-grow --------------------------------------------------------------------------------
  let gv = toWasm(growEv)
  ck(gv[0].i == 0 and gv[1].s == "minecraft:wheat" and gv[2].i == int64(asU16(st)) and gv[3].s == "minecraft:dirt", "grow: toWasm")
  var ge = gv
  ge[4] = vInt(int64(asU16(wheat.defaultState.id)))
  ge[6] = vBool(true)
  let gb = fromWasm(outcome(GrowFields, ge, false), growEv)
  ck(gb.cancelled and gb.newStateId == wheat.defaultState.id, "grow: fromWasm new state and cancel")
  ge[4] = vInt(60000)
  ck(fromWasm(outcome(GrowFields, ge, false), growEv).newStateId == newBlockStateIdUnchecked(0'u16), "grow: a state id out of range is air")
  let gf = fromWasm(unchanged(GrowFields, toWasm(growEv)), growEv)
  ck(not gf.cancelled and gf.newStateId == st and gf.newBlock == dirt, "grow: a call that changed nothing")


proc section5() =
  # -- block-place -------------------------------------------------------------------------------
  let place = newBlockPlaceEvent(thePlayer, stone, dirt, pos, true)
  let pv = toWasm(place)
  ck(pv[0].i == 5 and pv[1].s == "minecraft:stone" and pv[2].s == "minecraft:dirt" and pv[4].i == 1, "place: toWasm")
  let pb = fromWasm(outcome(PlaceFields, @[pv[0], pv[1], pv[2], pv[3], vBool(false), vBool(true)], false), place)
  ck(pb.cancelled and not pb.canBuild and pb.blockPosition == pos, "place: fromWasm")
  ck(not fromWasm(unchanged(PlaceFields, toWasm(place)), place).cancelled, "place: a call that changed nothing")


proc section6() =
  # -- spawn-change ------------------------------------------------------------------------------
  let sp = newSpawnChangeEvent(theWorld, newBlockPos(0'i32, 64'i32, 0'i32), 0.0'f32, 0.0'f32, pos, 90.0'f32, -10.5'f32)
  let sv = toWasm(sp)
  ck(sv.len == SpawnChangeFields.len and sv[0].i == 0 and sv[4].items[2].i == 7 and sv[5].f == 90.0 and sv[6].f == -10.5,
     "spawn-change: toWasm")
  var se = sv
  se[4] = vRecord(@[vInt(1), vInt(2), vInt(3)])
  se[5] = vFloat(45.0)
  let sb = fromWasm(outcome(SpawnChangeFields, se, false), sp)
  ck(sb.newPosition == newBlockPos(1'i32, 2'i32, 3'i32) and sb.newYaw == 45.0'f32 and sb.newPitch == -10.5'f32 and
     sb.previousPosition == newBlockPos(0'i32, 64'i32, 0'i32), "spawn-change: fromWasm")
  let sf = fromWasm(unchanged(SpawnChangeFields, toWasm(sp)), sp)
  ck(sf.newPosition == pos and sf.newYaw == 90.0'f32 and sf.world == theWorld, "spawn-change: a call that changed nothing")


proc section7() =
  # -- server events -----------------------------------------------------------------------------
  let cmd = newServerCommandEvent("say hi")
  let cmv = toWasm(cmd)
  ck(cmv[0].s == "say hi" and cmv[1].i == 0, "server-command: toWasm")
  let cmb = fromWasm(outcome(CommandFields, @[vStr("say changed"), vBool(true)], false), cmd)
  ck(cmb.command == "say changed" and cmb.cancelled, "server-command: fromWasm")
  ck(fromWasm(unchanged(CommandFields, toWasm(cmd)), cmd).command == "say hi", "server-command: a call that changed nothing")

  let bc = newServerBroadcastEvent(text("hello"), text("Server"))
  let bcv = toWasm(ws, bc)
  ck(bcv[0].i >= TextTag and bcv[1].i == bcv[0].i + 1, "server-broadcast: two arena handles")
  ck(getText(textAt(ws, int(bcv[0].i))) == "hello" and getText(textAt(ws, int(bcv[1].i))) == "Server",
     "server-broadcast: the handles hold the components")
  let rewritten = int64(newTextRep(ws, text("edited")))
  let bcb = fromWasm(ws, outcome(BroadcastFields, @[vInt(rewritten), bcv[1], vBool(true)], false), bc)
  ck(getText(bcb.message) == "edited" and getText(bcb.sender) == "Server" and bcb.cancelled, "server-broadcast: fromWasm consumes the handles")
  let bcf = fromWasm(ws, unchanged(BroadcastFields, toWasm(ws, bc)), bc)
  ck(getText(bcf.message) == "hello" and not bcf.cancelled, "server-broadcast: a call that changed nothing")

  ck(toWasm(newServerLoadEvent(ltReload))[0].i == 1 and toWasm(newServerLoadEvent(ltStartup))[0].i == 0, "server-load: enum index")
  ck(fromWasm(outcome(LoadFields, @[vInt(1)], false), newServerLoadEvent(ltStartup)).loadType == ltReload, "server-load: fromWasm")
  ck(fromWasm(unchanged(LoadFields, toWasm(newServerLoadEvent(ltReload))), newServerLoadEvent(ltReload)).loadType == ltReload, "server-load: a call that changed nothing")

  let te = newServerTickEndEvent(41'i32, 1_234_567_890'i64)
  let tev = toWasm(te)
  ck(tev[0].i == 41 and tev[1].i == 1_234_567_890'i64, "tick-end: toWasm")
  let teb = fromWasm(unchanged(TickEndFields, toWasm(te)), te)
  ck(teb.tick == 41'i32 and teb.durationNanos == 1_234_567_890'i64, "tick-end: a call that changed nothing")
  ck(toWasm(newServerTickStartEvent(7'i32))[0].i == 7 and fromWasm(unchanged(TickStartFields, toWasm(newServerTickStartEvent(7'i32))), newServerTickStartEvent(7'i32)).tick == 7'i32,
     "tick-start")

  let pr = newPacketReceivedEvent(thePlayer, 36'i32, @[1'u8, 2'u8, 255'u8])
  let prv = toWasm(pr)
  ck(prv.len == PacketFields.len and prv[0].i == 5 and prv[1].i == int64(PacketUnknownCase) and prv[2].i == 36 and
     prv[3].items.len == 3 and prv[3].items[2].i == 255 and prv[4].i == 0, "packet-received: toWasm")
  ck(fromWasm(outcome(PacketFields, @[prv[0], prv[1], prv[2], prv[3], vBool(true)], false), pr).cancelled, "packet-received: fromWasm cancel")
  ck(not fromWasm(unchanged(PacketFields, toWasm(pr)), pr).cancelled, "packet-received: a call that changed nothing")
  let ps = newPacketSentEvent(thePlayer, 9'i32, @[7'u8], nil)
  ck(toWasm(ps)[2].i == 9 and not fromWasm(unchanged(PacketFields, toWasm(ps)), ps).cancelled, "packet-sent: toWasm, a call that changed nothing")


proc section8() =
  # -- the hooks have do-nothing defaults ----------------------------------------------------------
  ck(not gPluginServerCommandHook("x") and not gPluginPacketReceivedHook(thePlayer, 1'i32, @[]), "hook defaults do not cancel")
  let (hc, hs) = gPluginBlockGrowHook(BlockWorld(), wheat, st, dirt, st, pos)
  ck(not hc and hs == st, "grow hook default")
  let (rc, rn) = gPluginBlockRedstoneHook(BlockWorld(), st, pos, 0'i32, 9'i32)
  ck(not rc and rn == 9'i32, "redstone hook default")
  let (bcc, bcm, bcs) = gPluginServerBroadcastHook(text("m"), text("s"))
  ck(not bcc and getText(bcm) == "m" and getText(bcs) == "s", "broadcast hook default")


proc main() =
  section0()
  section1()
  section2()
  section3()
  section4()
  section5()
  section6()
  section7()
  section8()
  if failed:
    quit 1
  echo "witeventsblocktest ok"

main()
