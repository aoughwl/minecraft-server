## More player events and their conversion to the WIT `event` variant: the events of `PlayerEvKind` (pluginhooks.aowl) that the
## server raises through `gPluginPlayerEventHook`. Port of the `ToFromWasmEvent` impls of the newer tree's
## pumpkin-wasm-host-v0_1/src/events/{player,inventory,block}.rs for the events below, over `fireEvent` of pluginhost.aowl.
## Events: player-interact (left and right click on a block or the air, the raycast of pumpkin/src/net/java/play.rs), player-
## interact-entity, player-interact-unknown-entity, player-custom-payload, player-changed-main-hand, inventory-click,
## inventory-close, block-break (the player or none), block-place, player-drop-item, entity-pickup-item (a player picking up),
## player-bed-enter (a cancel stops the sleep, not what the bed block did before) and -leave, sign-change, player-permission-check;
## player-item-consume (entitymod.aowl `consumeItem`; a cancel clears the active hand); `pekBucketEmpty` and `pekBucketFill` are converted but have
## no call site yet.
## PARTIAL: pumpkin-wasm-host-v0_1/src/events/player.rs - not fired for want of a call site or a value to lower: player-fish,
## player-egg-throw, player-item-damage, block-can-build, block-damage, dialog-click-action / show / clear, and the entity,
## world and server events (another part of the port). What a plugin writes back is read for: the drop flag of block-break, the
## permission result; the other fields (an edited count, the sign lines) are not.
import std/[options]
import ../wasm/canonabi
import ../../util/vector3
import ../../util/math/position
import ../../util/text/text
import "../../data/item_stack/mod"
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/world/worldmod
import ../pluginhost
import ../pluginhooks
import witstate, witserver, witstack, witray, witeventsplayer

proc playerRepOf(p: Player): CVal = vInt(int64(p.entityId))

proc outVal(o: EventOutcome; name: string): CVal =
  result = vInt(0)
  var i = 0
  while i < o.fieldNames.len:
    if o.fieldNames[i] == name: result = o.fieldVals[i]
    inc i

proc blockPosVal2(p: BlockPos): CVal = vRecord(@[vInt(int64(p.vec.x)), vInt(int64(p.vec.y)), vInt(int64(p.vec.z))])

proc stackRep(h: PluginHost; s: ItemStack): CVal =
  if s.isEmpty(): vNone() else: vSome(vInt(int64(addStack(h.ext.stacks, s))))

proc windowVal(n: int64): CVal =
  if n >= 0: vSome(vInt(n)) else: vNone()

proc blockNameAt(w: World; pos: BlockPos): string =
  dataBlockOf(uint32(w.getBlockStateId(pos))).name

proc isAirName(n: string): bool = n.len >= 3 and n[n.len - 3 ..< n.len] == "air"

proc interactEvent(h: PluginHost; player: Player; left: bool): bool =
  ## The raycast of `handle_swing_arm` / `handle_use_item` (4.5 blocks, no fluids), then `PlayerInteractEvent`.
  let eye = getEyePos(playerBase(player))
  let look = rotationVector(float64(player.pitch), float64(player.yaw))
  let hit = traceBlock(player.world, eye, look, 4.5, false)
  var action = (if left: 1 else: 2)
  var pos = none[BlockPos]()
  var name = "minecraft:air"
  if hit.found:
    action = (if left: 0 else: 3)
    pos = some(hit.pos)
    name = blockNameAt(player.world, hit.pos)
  playerInteractEvent(h, player, action, pos, name).cancelled

proc playerEvent*(h: PluginHost; player: Player; ev: PlayerEv): (bool, bool) =
  ## (cancelled, the event's boolean after the plugins).
  var o: EventOutcome
  case ev.kind
  of pekSwingArm:
    return (interactEvent(h, player, true), ev.flag)
  of pekUseItem:
    return (interactEvent(h, player, false), ev.flag)
  of pekInteractEntity:
    o = fireEvent(h, "player-interact-entity-event", @["player", "entity-id", "action", "sneaking", "cancelled"],
      @[playerRepOf(player), vInt(ev.n), vInt(ev.n2), vBool(ev.flag), vBool(false)])
  of pekInteractUnknownEntity:
    o = fireEvent(h, "player-interact-unknown-entity-event", @["player", "entity-id", "action", "cancelled"],
      @[playerRepOf(player), vInt(ev.n), vInt(ev.n2), vBool(false)])
  of pekCustomPayload:
    var bytes: seq[CVal] = @[]
    for b in ev.data: bytes.add vInt(int64(b))
    o = fireEvent(h, "player-custom-payload-event", @["player", "channel", "data"],
      @[playerRepOf(player), vStr(ev.text), vList(bytes)])
  of pekChangedMainHand:
    o = fireEvent(h, "player-changed-main-hand-event", @["player", "main-hand"], @[playerRepOf(player), vInt(ev.n)])
  of pekInventoryClose:
    o = fireEvent(h, "inventory-close-event", @["player", "window-type"], @[playerRepOf(player), windowVal(ev.n)])
  of pekInventoryClick:
    o = fireEvent(h, "inventory-click-event",
      @["player", "window-type", "click-type", "slot", "raw-slot", "clicked-item", "cursor", "hotbar-button", "cancelled"],
      @[playerRepOf(player), windowVal(ev.n), vInt(ev.n2), vInt(ev.n3), vInt(ev.n4), stackRep(h, ev.stack), stackRep(h, ev.stack2),
        vInt(ev.n5), vBool(false)])
  of pekBlockBreak:
    o = fireEvent(h, "block-break-event", @["player", "block", "block-pos", "exp", "should-drop", "cancelled"],
      @[vSome(playerRepOf(player)), vStr(ev.text), blockPosVal2(ev.pos), vInt(0), vBool(ev.flag), vBool(false)])
    if isAirName(ev.text): return (false, ev.flag)
    return (o.cancelled, outVal(o, "should-drop").i != 0)
  of pekDropItem:
    o = fireEvent(h, "player-drop-item-event", @["player", "item-name", "count", "cancelled"],
      @[playerRepOf(player), vStr(ev.text), vInt(ev.n), vBool(false)])
  of pekItemPickup:
    o = fireEvent(h, "entity-pickup-item-event", @["entity-id", "item-name", "count", "cancelled"],
      @[vInt(int64(player.entityId)), vStr(ev.text), vInt(ev.n), vBool(false)])
  of pekItemConsume:
    o = fireEvent(h, "player-item-consume-event", @["player", "item-name", "cancelled"],
      @[playerRepOf(player), vStr(ev.text), vBool(false)])
  of pekBedEnter:
    o = fireEvent(h, "player-bed-enter-event", @["player", "bed-pos", "cancelled"],
      @[playerRepOf(player), blockPosVal2(ev.pos), vBool(false)])
  of pekBedLeave:
    o = fireEvent(h, "player-bed-leave-event", @["player", "bed-pos"], @[playerRepOf(player), blockPosVal2(ev.pos)])
  of pekSignChange:
    var ls: seq[CVal] = @[]
    for l in ev.lines: ls.add vStr(l)
    o = fireEvent(h, "sign-change-event", @["player", "block-pos", "lines", "cancelled"],
      @[playerRepOf(player), blockPosVal2(ev.pos), vList(ls), vBool(false)])
  of pekBucketEmpty:
    o = fireEvent(h, "player-bucket-empty-event", @["player", "block-pos", "bucket", "cancelled"],
      @[playerRepOf(player), blockPosVal2(ev.pos), vStr(ev.text), vBool(false)])
  of pekBucketFill:
    o = fireEvent(h, "player-bucket-fill-event", @["player", "block-pos", "bucket", "cancelled"],
      @[playerRepOf(player), blockPosVal2(ev.pos), vStr(ev.text), vBool(false)])
  of pekPermissionCheck:
    o = fireEvent(h, "player-permission-check-event", @["player", "permission", "permission-result"],
      @[playerRepOf(player), vStr(ev.text), vBool(ev.flag)])
    return (false, outVal(o, "permission-result").i != 0)
  (o.cancelled, ev.flag)

proc blockPlaceEvent*(h: PluginHost; player: Player; placed, against: string; pos: BlockPos): bool =
  ## `BlockPlaceEvent`: `{ player, block-placed, block-placed-against, block-pos, can-build, cancelled }`.
  let o = fireEvent(h, "block-place-event", @["player", "block-placed", "block-placed-against", "block-pos", "can-build", "cancelled"],
    @[playerRepOf(player), vStr(placed), vStr(against), blockPosVal2(pos), vBool(true), vBool(false)])
  o.cancelled
