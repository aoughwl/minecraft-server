## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/server.rs: `ToFromWasmEvent` for PacketReceivedEvent,
## PacketSentEvent, ServerCommandEvent, ServerBroadcastEvent, ServerLoadEvent, ServerTickEndEvent and ServerTickStartEvent.
## Same layout as witeventsblock.aowl: `toWasm` (values in the order of the `...Fields` list beside it), `fromWasm` (the event
## from the `EventResult`) and `fire...` around `fireEvent` of pluginhost.aowl. Text components are arena reps of the
## host's `WitState` (`newTextRep` / `textAt`), as upstream's `add_text_component` / `consume_text_component`.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/server.rs - the packet events carry `packet-id`, the
## raw payload and `cancelled`, and their `packet` is always the `unknown` case of `serverbound-packet` / `clientbound-packet`:
## upstream decodes the payload into the generated WIT record of the packet (`generated_packets::deserialize_java_serverbound_packet`,
## `clientbound_java_any_to_wit`, ~1500 generated variants not ported here). Upstream's `from_wasm_event` of both packet events
## panics ("Modifying packets from WASM is not supported"): only `cancelled` is read back here.
import ../wasm/canonabi
import ../../util/text/text
import ../../server/serverbase
import "../api/events/server/mod"
import witstate, witeventresult

const
  PacketUnknownCase* = 2        ## `unknown` in `serverbound-packet` / `clientbound-packet` (java, bedrock, unknown)

proc bytesVal(payload: seq[byte]): CVal =
  var items: seq[CVal] = @[]
  for b in payload: items.add vInt(int64(b))
  vList(items)

# ---- PacketReceivedEvent / PacketSentEvent -------------------------------------------------------

let PacketFields* = @["player", "packet", "packet-id", "raw-payload", "cancelled"]

proc toWasm*(e: PacketReceivedEvent): seq[CVal] =
  @[vInt(int64(e.player.entityId)), vVariant(PacketUnknownCase), vInt(int64(e.packetId)), bytesVal(e.payload), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: PacketReceivedEvent): PacketReceivedEvent =
  PacketReceivedEvent(player: e.player, packetId: e.packetId, payload: e.payload,
                      cancelled: o.cancelled or outField(o, "cancelled").i != 0)

proc toWasm*(e: PacketSentEvent): seq[CVal] =
  @[vInt(int64(e.player.entityId)), vVariant(PacketUnknownCase), vInt(int64(e.packetId)), bytesVal(e.payload), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: PacketSentEvent): PacketSentEvent =
  PacketSentEvent(player: e.player, packetId: e.packetId, payload: e.payload, packet: e.packet,
                  cancelled: o.cancelled or outField(o, "cancelled").i != 0)

# ---- ServerCommandEvent --------------------------------------------------------------------------

let CommandFields* = @["command", "cancelled"]

proc toWasm*(e: ServerCommandEvent): seq[CVal] = @[vStr(e.command), vBool(e.cancelled)]

proc fromWasm*(o: EventResult; e: ServerCommandEvent): ServerCommandEvent =
  var command = e.command
  var i = 0
  while i < o.fieldNames.len:
    if o.fieldNames[i] == "command": command = o.fieldVals[i].s
    inc i
  ServerCommandEvent(command: command, cancelled: o.cancelled or outField(o, "cancelled").i != 0)

# ---- ServerBroadcastEvent ------------------------------------------------------------------------

let BroadcastFields* = @["message", "sender", "cancelled"]

proc toWasm*(ws: WitState; e: ServerBroadcastEvent): seq[CVal] =
  ## Two new text-component handles, as upstream's two `add_text_component`.
  @[vInt(int64(newTextRep(ws, e.message))), vInt(int64(newTextRep(ws, e.sender))), vBool(e.cancelled)]

proc fromWasm*(ws: WitState; o: EventResult; e: ServerBroadcastEvent): ServerBroadcastEvent =
  ## `consume_text_component` of both: the component behind each handle, as the handlers left it.
  ServerBroadcastEvent(message: textAt(ws, int(outField(o, "message").i)), sender: textAt(ws, int(outField(o, "sender").i)),
                       cancelled: o.cancelled or outField(o, "cancelled").i != 0)

# ---- ServerLoadEvent -----------------------------------------------------------------------------

let LoadFields* = @["load-type"]

proc toWasm*(e: ServerLoadEvent): seq[CVal] = @[vInt(int64(ord(e.loadType)))]
  ## `ServerLoadType::{Startup, Reload}` is enum index 0 / 1, the order of `LoadType`.

proc fromWasm*(o: EventResult; e: ServerLoadEvent): ServerLoadEvent =
  ServerLoadEvent(loadType: (if outField(o, "load-type").i == 1: ltReload else: ltStartup))

# ---- ServerTickEndEvent / ServerTickStartEvent ---------------------------------------------------

let TickEndFields* = @["tick", "duration-nanos"]
let TickStartFields* = @["tick"]

proc toWasm*(e: ServerTickEndEvent): seq[CVal] = @[vInt(int64(e.tick)), vInt(e.durationNanos)]

proc fromWasm*(o: EventResult; e: ServerTickEndEvent): ServerTickEndEvent =
  ServerTickEndEvent(tick: int32(outField(o, "tick").i), durationNanos: outField(o, "duration-nanos").i)

proc toWasm*(e: ServerTickStartEvent): seq[CVal] = @[vInt(int64(e.tick))]

proc fromWasm*(o: EventResult; e: ServerTickStartEvent): ServerTickStartEvent =
  ServerTickStartEvent(tick: int32(outField(o, "tick").i))

