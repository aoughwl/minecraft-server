## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/events/world.rs: `ToFromWasmEvent` for SpawnChangeEvent (the
## only world event upstream converts: ChunkLoad, ChunkSave and ChunkSend have a WIT record but no conversion at the pinned
## commit, so there is none here either). `toWasm` is the field values in the order of `SpawnChangeFields` (the WIT
## `spawn-change-event-data` names), `fromWasm` reads them back from the `EventResult`, `fireSpawnChange` is both around
## `fireEvent` of pluginhost.aowl (`PluginManager::fire`). The event is not cancellable.
## A world rep that is gone keeps the event's own world (upstream `expect`s).
import ../wasm/canonabi
import ../../util/math/position
import ../../server/serverbase
import ../api/events/world/spawn_change
import witserver, witeventresult, witeventsblock

let SpawnChangeFields* = @["target-world", "previous-position", "previous-yaw", "previous-pitch", "new-position", "new-yaw",
                             "new-pitch"]

proc toWasm*(e: SpawnChangeEvent): seq[CVal] =
  @[vInt(int64(worldRep(e.world))), toWasmBlockPosition(e.previousPosition), vFloat(float64(e.previousYaw)),
    vFloat(float64(e.previousPitch)), toWasmBlockPosition(e.newPosition), vFloat(float64(e.newYaw)), vFloat(float64(e.newPitch))]

proc fromWasm*(o: EventResult; e: SpawnChangeEvent): SpawnChangeEvent =
  SpawnChangeEvent(world: worldOrElse(outField(o, "target-world"), e.world),
    previousPosition: fromWasmBlockPosition(outField(o, "previous-position"), e.previousPosition),
    previousYaw: float32(outField(o, "previous-yaw").f), previousPitch: float32(outField(o, "previous-pitch").f),
    newPosition: fromWasmBlockPosition(outField(o, "new-position"), e.newPosition),
    newYaw: float32(outField(o, "new-yaw").f), newPitch: float32(outField(o, "new-pitch").f))
