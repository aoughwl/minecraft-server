## Host-function level tests of the interfaces added in witstack, witblockentity, witscoreboard, witgui, witrecipe and
## witforms: each call goes through the registry as the canonical ABI would make it (lifted `CVal`s), against recording
## fakes for the server hooks. The component-level path (wasm calling the host) is witwasitest.aowl for WASI and
## witcomptest.aowl for the first half.
import std/[syncio, options]
import ../wasm/[wasmvm, canonabi, component]
import ../../util/text/text
import ../../generated/item_refs
import "../../protocol/recipe"
import witstate, witall, witforms

var failures = 0

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    inc failures

proc call(r: HostRegistry; ci: CompInst; iface, fname: string; args: seq[CVal]; results: var seq[CVal]): string =
  let key = iface & "#" & fname
  var i = 0
  while i < r.keys.len:
    if r.keys[i] == key:
      return r.fns[i].fn(ci, args, results)
    inc i
  result = "no host function " & key

proc c(r: HostRegistry; ci: CompInst; iface, fname: string; args: seq[CVal]): seq[CVal] =
  var res: seq[CVal] = @[]
  let e = call(r, ci, iface, fname, args, res)
  if e.len > 0:
    echo "FAILED call ", fname, ": ", e
    inc failures
  res

const
  S = "pumpkin:plugin/item-stack"
  G = "pumpkin:plugin/gui"
  R = "pumpkin:plugin/recipe"
  B = "pumpkin:plugin/scoreboard"
  E = "pumpkin:plugin/block-entity"

var sbLog: seq[string] = @[]
var gotRecipes: seq[DynamicRecipe] = @[]
var beLog: seq[string] = @[]

proc nbtCompound(entries: seq[CVal]): CVal = vVariant(9, vList(entries))
proc entry(key: string; idx: int): CVal = vRecord(@[vStr(key), vInt(int64(idx))])

proc main() =
  let r = newHostRegistry()
  let st = newWitState()
  let ext = installWitInterfaces(r, st)
  let ci = newCompInst(newWasmVm(), r, 0)

  # ---- item-stack
  var res = c(r, ci, S, "[constructor]item-stack", @[vStr("minecraft:diamond"), vInt(3)])
  let s1 = res[0].i
  res = c(r, ci, S, "[method]item-stack.get-registry-key", @[vInt(s1)])
  ck(res[0].s == "diamond", "registry key " & res[0].s)
  res = c(r, ci, S, "[method]item-stack.get-count", @[vInt(s1)])
  ck(res[0].i == 3, "count")
  discard c(r, ci, S, "[method]item-stack.set-count", @[vInt(s1), vInt(5)])
  res = c(r, ci, S, "[method]item-stack.get-count", @[vInt(s1)])
  ck(res[0].i == 5, "set-count")
  res = c(r, ci, S, "[method]item-stack.get-max-count", @[vInt(s1)])
  ck(res[0].i == 64, "diamond stacks to 64")
  res = c(r, ci, S, "[constructor]item-stack", @[vStr("ender_pearl"), vInt(1)])
  let pearl = res[0].i
  res = c(r, ci, S, "[method]item-stack.get-registry-key", @[vInt(pearl)])
  ck(res[0].s == "ender_pearl", "key without the namespace is accepted " & res[0].s)
  res = c(r, ci, S, "[method]item-stack.get-max-count", @[vInt(pearl)])
  ck(res[0].i == 16, "ender pearl stacks to 16")
  res = c(r, ci, S, "[constructor]item-stack", @[vStr("minecraft:no_such_item"), vInt(1)])
  res = c(r, ci, S, "[method]item-stack.get-registry-key", @[res[0]])
  ck(res[0].s == "air", "unknown item is air " & res[0].s)
  # enchantments
  var sharp = -1
  for e in gEnchantments:
    if e.name == "minecraft:sharpness": sharp = int(e.id)
  ck(sharp >= 0, "sharpness is in the table")
  res = c(r, ci, S, "[method]item-stack.get-enchantments", @[vInt(s1)])
  ck(res[0].items.len == 0, "no enchantments yet")
  discard c(r, ci, S, "[method]item-stack.add-enchantment", @[vInt(s1), vInt(int64(sharp)), vInt(3)])
  discard c(r, ci, S, "[method]item-stack.add-enchantment", @[vInt(s1), vInt(int64(sharp)), vInt(5)])
  res = c(r, ci, S, "[method]item-stack.get-enchantments", @[vInt(s1)])
  ck(res[0].items.len == 1 and res[0].items[0].items[0].i == int64(sharp) and res[0].items[0].items[1].i == 5, "enchantment replaced, level 5")
  discard c(r, ci, S, "[method]item-stack.remove-enchantment", @[vInt(s1), vInt(int64(sharp))])
  res = c(r, ci, S, "[method]item-stack.get-enchantments", @[vInt(s1)])
  ck(res[0].items.len == 0, "enchantment removed")
  var bad: seq[CVal] = @[]
  ck(call(r, ci, S, "[method]item-stack.add-enchantment", @[vInt(s1), vInt(9999), vInt(1)], bad).len > 0, "unknown enchantment traps")
  ck(call(r, ci, S, "[method]item-stack.get-count", @[vInt(77)], bad).len > 0, "bad handle traps")
  # custom name
  res = c(r, ci, S, "[method]item-stack.get-custom-name", @[vInt(s1)])
  ck(res[0].i == 0, "no custom name")
  let nameRep = newTextRep(st, text("Shiny"))
  discard c(r, ci, S, "[method]item-stack.set-custom-name", @[vInt(s1), vSome(vInt(int64(nameRep)))])
  res = c(r, ci, S, "[method]item-stack.get-custom-name", @[vInt(s1)])
  ck(res[0].i == 1 and getText(textAt(st, int(res[0].items[0].i))) == "Shiny", "custom name round trip")
  discard c(r, ci, S, "[method]item-stack.set-custom-name", @[vInt(s1), vNone()])
  res = c(r, ci, S, "[method]item-stack.get-custom-name", @[vInt(s1)])
  ck(res[0].i == 0, "custom name cleared")
  # custom data: {a: 7 (int), b: ["x", 2L]} as the flat tag table
  let tree = vRecord(@[vInt(0), vList(@[
    nbtCompound(@[entry("a", 1), entry("b", 2)]),         # 0: root compound
    vVariant(2, vInt(7)),                                  # 1: int 7
    vVariant(8, vList(@[vInt(3), vInt(4)])),               # 2: list of tags 3 and 4
    vVariant(7, vStr("x")),                                # 3: string "x"
    vVariant(3, vInt(2))])])                               # 4: long 2
  discard c(r, ci, S, "[method]item-stack.set-custom-data", @[vInt(s1), vStr("plug"), vStr("k"), tree])
  res = c(r, ci, S, "[method]item-stack.has-custom-data", @[vInt(s1), vStr("plug"), vStr("k")])
  ck(res[0].i == 1, "has custom data")
  res = c(r, ci, S, "[method]item-stack.has-custom-data", @[vInt(s1), vStr("plug"), vStr("other")])
  ck(res[0].i == 0, "no other key")
  res = c(r, ci, S, "[method]item-stack.get-custom-data", @[vInt(s1), vStr("plug"), vStr("k")])
  ck(res[0].i == 1, "get custom data")
  let back = res[0].items[0]
  # the flat table is rebuilt in the order of `push_wit_nbt_tag`: the root first, then each child as it is met
  ck(back.items[1].items.len == 5 and back.items[0].i == 0, "tree has five tags, root 0")
  ck(back.items[1].items[0].i == 9 and back.items[1].items[0].items[0].items.len == 2, "root is a compound of two")
  var sawInt = false
  var sawStr = false
  var sawLong = false
  for t in back.items[1].items:
    if t.i == 2 and t.items[0].i == 7: sawInt = true
    if t.i == 7 and t.items[0].s == "x": sawStr = true
    if t.i == 3 and t.items[0].i == 2: sawLong = true
  ck(sawInt and sawStr and sawLong, "int, string and long survive")
  discard c(r, ci, S, "[method]item-stack.remove-custom-data", @[vInt(s1), vStr("plug"), vStr("k")])
  res = c(r, ci, S, "[method]item-stack.has-custom-data", @[vInt(s1), vStr("plug"), vStr("k")])
  ck(res[0].i == 0, "custom data removed")
  # a cycle and a bad index are refused
  let cyc = vRecord(@[vInt(0), vList(@[vVariant(8, vList(@[vInt(0)]))])])
  ck(call(r, ci, S, "[method]item-stack.set-custom-data", @[vInt(s1), vStr("n"), vStr("k"), cyc], bad) ==
     "NBT tag tree contains a cycle at index 0", "cycle is refused")
  let oob = vRecord(@[vInt(4), vList(@[vVariant(2, vInt(1))])])
  ck(call(r, ci, S, "[method]item-stack.set-custom-data", @[vInt(s1), vStr("n"), vStr("k"), oob], bad) ==
     "NBT tag index 4 is out of bounds", "bad index is refused")

  # ---- gui
  let title = newTextRep(st, text("Shop"))
  res = c(r, ci, G, "[constructor]gui", @[vInt(2), vInt(int64(title))])
  let g1 = res[0].i
  res = c(r, ci, G, "[method]gui.get-size", @[vInt(g1)])
  ck(res[0].i == 27, "9x3 has 27 slots")
  res = c(r, ci, G, "[constructor]gui", @[vInt(0), vInt(int64(title))])
  res = c(r, ci, G, "[method]gui.get-size", @[res[0]])
  ck(res[0].i == 5, "generic-9x1 has 5 slots, as upstream's table says")
  res = c(r, ci, G, "[constructor]gui", @[vInt(5), vInt(int64(title))])
  res = c(r, ci, G, "[method]gui.get-size", @[res[0]])
  ck(res[0].i == 54, "9x6 has 54 slots")
  res = c(r, ci, G, "[method]gui.get-type", @[vInt(g1)])
  ck(res[0].i == 2, "type")
  res = c(r, ci, G, "[method]gui.get-title", @[vInt(g1)])
  ck(getText(textAt(st, int(res[0].i))) == "Shop", "title")
  discard c(r, ci, G, "[method]gui.set-item", @[vInt(g1), vInt(3), vInt(s1)])
  discard c(r, ci, G, "[method]gui.set-item", @[vInt(g1), vInt(999), vInt(s1)])   # outside the inventory: ignored
  res = c(r, ci, G, "[method]gui.get-item", @[vInt(g1), vInt(3)])
  ck(res[0].i == 1, "slot 3 holds the stack")
  res = c(r, ci, S, "[method]item-stack.get-registry-key", @[res[0].items[0]])
  ck(res[0].s == "diamond", "get-item hands back a copy of the diamonds " & res[0].s)
  res = c(r, ci, G, "[method]gui.get-item", @[vInt(g1), vInt(4)])
  ck(res[0].i == 0, "empty slot is none")
  discard c(r, ci, G, "[method]gui.clear-items", @[vInt(g1)])
  res = c(r, ci, G, "[method]gui.get-item", @[vInt(g1), vInt(3)])
  ck(res[0].i == 0, "cleared")
  res = c(r, ci, G, "[method]gui.get-allow-grab-items", @[vInt(g1)])
  ck(res[0].i == 1, "grabbing is allowed by default")
  discard c(r, ci, G, "[method]gui.set-allow-grab-items", @[vInt(g1), vBool(false)])
  discard c(r, ci, G, "[method]gui.set-allow-put-items", @[vInt(g1), vBool(false)])
  res = c(r, ci, G, "[method]gui.get-allow-grab-items", @[vInt(g1)])
  ck(res[0].i == 0 and not ext.guis.guis[int(g1)].allowPutItems, "flags")

  # ---- recipe
  ext.recipes.hooks.addRecipe = proc (recipe: DynamicRecipe) {.closure.} = gotRecipes.add recipe
  let shaped = vRecord(@[
    vList(@[vStr("AA"), vStr("A ")]),
    vList(@[vRecord(@[vStr("A"), vVariant(0, vStr("minecraft:stick"))])]),
    vInt(s1), vNone(), vNone(), vNone()])
  discard c(r, ci, R, "[method]recipe-manager.register-shaped", @[vInt(0), vStr("plug:thing"), shaped])
  let shapeless = vRecord(@[
    vList(@[vVariant(1, vStr("minecraft:logs")), vVariant(2, vList(@[vStr("minecraft:a"), vStr("minecraft:b")]))]),
    vInt(pearl), vSome(vStr("grp")), vNone()])
  discard c(r, ci, R, "[method]recipe-manager.register-shapeless", @[vInt(0), vStr("plug:other"), shapeless])
  let cooking = vRecord(@[vVariant(0, vStr("minecraft:iron_ore")), vInt(s1), vFloat(0.7), vInt(200), vNone(), vNone()])
  discard c(r, ci, R, "[method]recipe-manager.register-cooking", @[vInt(0), vStr("plug:smelt"), vInt(1), cooking])
  ck(gotRecipes.len == 3, "three recipes registered")
  if gotRecipes.len == 3:
    ck(gotRecipes[0].kind == drCrafting and gotRecipes[0].crafting.kind == ocrShaped and gotRecipes[0].crafting.pattern == @["AA", "A "], "shaped pattern")
    ck(gotRecipes[0].crafting.key.len == 1 and gotRecipes[0].crafting.key[0].symbol == 'A' and
       gotRecipes[0].crafting.key[0].ingredient.kind == oriSimple and gotRecipes[0].crafting.key[0].ingredient.id == "minecraft:stick", "shaped key")
    ck(gotRecipes[0].crafting.result.itemId == "diamond" and gotRecipes[0].crafting.result.count == 5, "shaped result is the stack")
    ck(gotRecipes[0].crafting.category == rcMisc and gotRecipes[0].crafting.showNotification, "category misc, notification shown")
    ck(gotRecipes[1].crafting.kind == ocrShapeless and gotRecipes[1].crafting.ingredients.len == 2 and
       gotRecipes[1].crafting.ingredients[0].kind == oriTagged and gotRecipes[1].crafting.ingredients[1].kind == oriOneOf and
       gotRecipes[1].crafting.group.isSome and gotRecipes[1].crafting.group.get() == "grp", "shapeless")
    ck(gotRecipes[2].kind == drCooking and gotRecipes[2].cooking.kind == ockBlasting and gotRecipes[2].cooking.recipe.recipeId == "plug:smelt" and
       gotRecipes[2].cooking.recipe.cookingTime == 200 and gotRecipes[2].cooking.recipe.result.itemId == "diamond", "cooking: blasting")

  # ---- scoreboard
  let hk = ext.scoreboard.hooks
  hk.addObjective = proc (w: int; name: string; t: TextComponent; rt: int; fmt: NumFmt) {.closure.} =
    sbLog.add "obj+ " & $w & " " & name & " " & getText(t) & " " & $rt & " " & $fmt.kind
  hk.setDisplaySlot = proc (w: int; slot: int; o: string) {.closure.} = sbLog.add "slot " & $w & " " & $slot & " " & o
  hk.updateScore = proc (w: int; e, o: string; v: int; fmt: NumFmt) {.closure.} = sbLog.add "score " & e & " " & o & " " & $v
  hk.getScore = proc (w: int; e, o: string; v: var int): bool {.closure.} =
    v = 40
    true
  hk.createTeam = proc (w: int; t: SbTeam) {.closure.} =
    sbLog.add "team+ " & t.name & " " & getText(t.displayName) & " ff=" & $t.friendlyFire & " inv=" & $t.seeFriendlyInvisibles &
      " nt=" & $t.nametagVisibility & " col=" & $t.collisionRule & " c=" & $t.color & " " & getText(t.prefix) & "/" & getText(t.suffix)
  hk.teams = proc (w: int): seq[SbTeam] {.closure.} =
    @[SbTeam(name: "red", displayName: text("Red"), players: @["Steve", "Alex"], color: 12, prefix: text("["), suffix: text("]")),
      SbTeam(name: "blue", displayName: text("Blue"), players: @["Bob"], prefix: text(""), suffix: text(""))]
  let disp = newTextRep(st, text("Kills"))
  discard c(r, ci, B, "[method]scoreboard.add-objective", @[vInt(1), vStr("kills"), vInt(int64(disp)), vInt(1)])
  discard c(r, ci, B, "[method]scoreboard.add-objective", @[vInt(1), vStr("deaths"), vInt(int64(disp)), vInt(0), vSome(vVariant(0))])
  discard c(r, ci, B, "[method]scoreboard.set-display-slot", @[vInt(1), vInt(1), vStr("kills")])
  discard c(r, ci, B, "[method]scoreboard.update-score", @[vInt(1), vStr("Steve"), vStr("kills"), vInt(3)])
  res = c(r, ci, B, "[method]scoreboard.add-score", @[vInt(1), vStr("Steve"), vStr("kills"), vInt(2)])
  ck(res[0].i == 42, "add-score adds to the current value")
  let settings = vRecord(@[vInt(int64(disp)), vBool(true), vBool(false), vInt(2), vInt(3), vInt(12), vInt(int64(newTextRep(st, text("<")))),
                           vInt(int64(newTextRep(st, text(">"))))])
  discard c(r, ci, B, "[method]scoreboard.create-team", @[vInt(1), vStr("red"), settings])
  ck(sbLog == @["obj+ 1 kills Kills 1 0", "obj+ 1 deaths Kills 0 1", "slot 1 1 kills", "score Steve kills 3", "score Steve kills 42",
                "team+ red Kills ff=true inv=false nt=2 col=3 c=12 </>"], "scoreboard calls reach the hooks: " & $sbLog.len)
  res = c(r, ci, B, "[method]scoreboard.get-teams", @[vInt(1)])
  ck(res[0].items.len == 2 and res[0].items[1].s == "blue", "get-teams")
  res = c(r, ci, B, "[method]scoreboard.get-team", @[vInt(1), vStr("red")])
  ck(res[0].i == 1 and res[0].items[0].items[5].i == 12, "get-team colour")
  res = c(r, ci, B, "[method]scoreboard.get-team", @[vInt(1), vStr("green")])
  ck(res[0].i == 0, "no such team")
  res = c(r, ci, B, "[method]scoreboard.get-team-players", @[vInt(1), vStr("red")])
  ck(res[0].items.len == 2 and res[0].items[0].s == "Steve", "team players")
  res = c(r, ci, B, "[method]scoreboard.get-player-team", @[vInt(1), vStr("Bob")])
  ck(res[0].i == 1 and res[0].items[0].s == "blue", "player team")
  res = c(r, ci, B, "[method]scoreboard.get-player-team", @[vInt(1), vStr("Nobody")])
  ck(res[0].i == 0, "player without team")

  # ---- block entity
  let bh = ext.blockEntities.hooks
  bh.info = proc (w, x, y, z: int; res: var BeInfo): bool {.closure.} =
    if x == 1 and y == 64 and z == 2:
      res = BeInfo(resourceLocation: "minecraft:sign", id: 7, dirty: true)
      return true
    false
  bh.clearDirty = proc (w, x, y, z: int) {.closure.} = beLog.add "clean " & $x
  bh.sign = proc (w, x, y, z: int; res: var BeSign): bool {.closure.} =
    res = BeSign(front: SignFace(messages: @["a", "b", "c", "d"], color: 14, glowing: true),
                 back: SignFace(messages: @["", "", "", ""], color: 0, glowing: false), waxed: true)
    true
  bh.setSignFace = proc (w, x, y, z: int; front: bool; face: SignFace): bool {.closure.} =
    beLog.add (if front: "front " else: "back ") & face.messages[0] & "|" & face.messages[3] & " " & $face.color & " " & $face.glowing
    true
  bh.setSignWaxed = proc (w, x, y, z: int; waxed: bool): bool {.closure.} =
    beLog.add "waxed " & $waxed
    true
  bh.command = proc (w, x, y, z: int; res: var BeCommand): bool {.closure.} = false
  let be = newBlockEntityRep(ext.blockEntities, 0, 1, 64, 2)
  res = c(r, ci, E, "[method]block-entity.resource-location", @[vInt(int64(be))])
  ck(res[0].s == "minecraft:sign", "resource location")
  res = c(r, ci, E, "[method]block-entity.get-position", @[vInt(int64(be))])
  ck(res[0].items[0].i == 1 and res[0].items[1].i == 64 and res[0].items[2].i == 2, "position")
  res = c(r, ci, E, "[method]block-entity.get-id", @[vInt(int64(be))])
  ck(res[0].i == 7, "id")
  res = c(r, ci, E, "[method]block-entity.is-dirty", @[vInt(int64(be))])
  ck(res[0].i == 1, "dirty")
  discard c(r, ci, E, "[method]block-entity.clear-dirty", @[vInt(int64(be))])
  res = c(r, ci, E, "[method]sign-block-entity.get-block-entity", @[vInt(int64(be))])
  ck(res[0].i == int64(be), "the view's block entity is the same slot")
  res = c(r, ci, E, "[method]sign-block-entity.get-front-text", @[vInt(int64(be))])
  ck(res[0].items[0].items.len == 4 and res[0].items[0].items[2].s == "c" and res[0].items[1].i == 14 and res[0].items[2].i == 1, "front text")
  discard c(r, ci, E, "[method]sign-block-entity.set-back-text", @[vInt(int64(be)), vRecord(@[vList(@[vStr("x"), vStr("y"), vStr("z"), vStr("w"), vStr("extra")]), vInt(3), vBool(false)])])
  discard c(r, ci, E, "[method]sign-block-entity.set-waxed", @[vInt(int64(be)), vBool(true)])
  res = c(r, ci, E, "[method]sign-block-entity.is-waxed", @[vInt(int64(be))])
  ck(res[0].i == 1, "waxed")
  ck(beLog == @["clean 1", "back x|w 3 false", "waxed true"], "block entity writes: " & $beLog.len)
  ck(call(r, ci, E, "[method]command-block-entity.command", @[vInt(int64(be))], bad) == "Not a command block entity", "not a command block")
  ck(call(r, ci, E, "[method]block-entity.get-id", @[vInt(99)], bad) == "invalid block entity resource handle", "bad block entity handle")
  let nowhere = newBlockEntityRep(ext.blockEntities, 0, 5, 5, 5)
  ck(call(r, ci, E, "[method]block-entity.resource-location", @[vInt(int64(nowhere))], bad) == "invalid block entity resource handle", "no block entity at the position")

  # ---- forms
  let ft = newTextRep(st, text("T"))
  let fc = newTextRep(st, text("C"))
  let fb = newTextRep(st, text("B"))
  let simple = vVariant(0, vRecord(@[vInt(int64(ft)), vInt(int64(fc)), vList(@[
    vRecord(@[vInt(int64(fb)), vSome(vRecord(@[vInt(0), vStr("http://x/y.png")]))]),
    vRecord(@[vInt(int64(fb)), vNone()])])]))
  ck(serializeForm(st, simple) ==
     "{\"buttons\":[{\"image\":{\"data\":\"http://x/y.png\",\"type\":\"url\"},\"text\":\"B\"},{\"text\":\"B\"}],\"content\":\"C\",\"title\":\"T\",\"type\":\"form\"}",
     "simple form json: " & serializeForm(st, simple))
  let modal = vVariant(1, vRecord(@[vInt(int64(ft)), vInt(int64(fc)), vInt(int64(newTextRep(st, text("yes")))), vInt(int64(newTextRep(st, text("no"))))]))
  ck(serializeForm(st, modal) == "{\"button1\":\"yes\",\"button2\":\"no\",\"content\":\"C\",\"title\":\"T\",\"type\":\"modal\"}", "modal form json")
  let custom = vVariant(2, vRecord(@[vInt(int64(ft)), vList(@[
    vVariant(0, vInt(int64(fb))),
    vVariant(1, vRecord(@[vInt(int64(fb)), vBool(true)])),
    vVariant(2, vRecord(@[vInt(int64(fb)), vFloat(0.0), vFloat(10.0), vFloat(0.5), vFloat(5.0)])),
    vVariant(3, vRecord(@[vInt(int64(fb)), vList(@[vStr("a"), vStr("b\"q")]), vInt(1)])),
    vVariant(4, vRecord(@[vInt(int64(fb)), vList(@[vStr("o")]), vInt(0)])),
    vVariant(5, vRecord(@[vInt(int64(fb)), vStr("ph"), vStr("df")]))])]))
  ck(serializeForm(st, custom) ==
     "{\"content\":[{\"text\":\"B\",\"type\":\"label\"},{\"default\":true,\"text\":\"B\",\"type\":\"toggle\"}," &
     "{\"default\":5.0,\"max\":10.0,\"min\":0.0,\"step\":0.5,\"text\":\"B\",\"type\":\"slider\"}," &
     "{\"default\":1,\"steps\":[\"a\",\"b\\\"q\"],\"text\":\"B\",\"type\":\"step_slider\"}," &
     "{\"default\":0,\"options\":[\"o\"],\"text\":\"B\",\"type\":\"dropdown\"}," &
     "{\"default\":\"df\",\"placeholder\":\"ph\",\"text\":\"B\",\"type\":\"input\"}],\"title\":\"T\",\"type\":\"custom_form\"}",
     "custom form json: " & serializeForm(st, custom))
  if failures > 0: quit 1
  echo "witexttest ok"

main()
