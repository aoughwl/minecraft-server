## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/forms.rs: the `forms` interface has no host function (its
## `Host` impl is empty); the file is the serialisation of a WIT `form` into the JSON a Bedrock form request carries
## (`translate_res`, `serialize_simple_form`, `serialize_modal_form`, `serialize_custom_form`). `serializeForm` takes the
## lifted `form` variant (`simple | modal | custom`) and answers the JSON text; the player half
## (`player.send-form`, which wraps it in a `CModalFormRequest`) calls it.
## serde_json's `json!` object is a sorted map, so the keys are written in alphabetical order, exactly as upstream
## prints them; numbers are the shortest form of the float32 (`1.0`, `0.5`).
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/forms.rs - `translate_res` takes the player's locale
## upstream, here every text is its English (US) text (`getText`).
import std/strutils
import ../wasm/[canonabi, component]
import ../../util/text/text
import witstate

proc jstr*(s: string): string =
  ## A JSON string literal (serde_json's escaping: `"` `\` and the control characters; `\u00XX` for the rest).
  result = "\""
  for c in s:
    case c
    of '"': result.add "\\\""
    of '\\': result.add "\\\\"
    of '\n': result.add "\\n"
    of '\r': result.add "\\r"
    of '\t': result.add "\\t"
    of '\b': result.add "\\b"
    of '\f': result.add "\\f"
    else:
      if ord(c) < 0x20:
        result.add "\\u00"
        result.add "0123456789abcdef"[ord(c) shr 4]
        result.add "0123456789abcdef"[ord(c) and 15]
      else: result.add c
  result.add "\""

proc jfloat(f: float64): string =
  let s = $float32(f)
  if s.endsWith(".0") or s.contains('.') or s.contains('e'): s else: s & ".0"

proc tr(st: WitState; v: CVal): string =
  ## `translate_res`: the text behind a `text-component` handle.
  jstr(getText(textAt(st, int(v.i))))

proc jlist(xs: seq[CVal]): string =
  result = "["
  var i = 0
  while i < xs.len:
    if i > 0: result.add ","
    result.add jstr(xs[i].s)
    inc i
  result.add "]"

proc simpleForm(st: WitState; f: CVal): string =
  # simple-form{title, content, buttons: list<simple-form-button{text, image: option<form-image{type, data}>}>}
  var buttons = "["
  var i = 0
  while i < f.items[2].items.len:
    let b = f.items[2].items[i]
    if i > 0: buttons.add ","
    buttons.add "{"
    if b.items[1].i != 0:
      let img = b.items[1].items[0]
      buttons.add "\"image\":{\"data\":" & jstr(img.items[1].s) & ",\"type\":" & (if img.items[0].i == 0: "\"url\"" else: "\"path\"") & "},"
    buttons.add "\"text\":" & tr(st, b.items[0]) & "}"
    inc i
  buttons.add "]"
  "{\"buttons\":" & buttons & ",\"content\":" & tr(st, f.items[1]) & ",\"title\":" & tr(st, f.items[0]) & ",\"type\":\"form\"}"

proc modalForm(st: WitState; f: CVal): string =
  "{\"button1\":" & tr(st, f.items[2]) & ",\"button2\":" & tr(st, f.items[3]) & ",\"content\":" & tr(st, f.items[1]) &
    ",\"title\":" & tr(st, f.items[0]) & ",\"type\":\"modal\"}"

proc customElement(st: WitState; e: CVal): string =
  let p = e.items[0]
  case int(e.i)
  of 0: "{\"text\":" & tr(st, p) & ",\"type\":\"label\"}"
  of 1: "{\"default\":" & (if p.items[1].i != 0: "true" else: "false") & ",\"text\":" & tr(st, p.items[0]) & ",\"type\":\"toggle\"}"
  of 2:
    "{\"default\":" & jfloat(p.items[4].f) & ",\"max\":" & jfloat(p.items[2].f) & ",\"min\":" & jfloat(p.items[1].f) &
      ",\"step\":" & jfloat(p.items[3].f) & ",\"text\":" & tr(st, p.items[0]) & ",\"type\":\"slider\"}"
  of 3:
    "{\"default\":" & $p.items[2].i & ",\"steps\":" & jlist(p.items[1].items) & ",\"text\":" & tr(st, p.items[0]) &
      ",\"type\":\"step_slider\"}"
  of 4:
    "{\"default\":" & $p.items[2].i & ",\"options\":" & jlist(p.items[1].items) & ",\"text\":" & tr(st, p.items[0]) &
      ",\"type\":\"dropdown\"}"
  else:
    "{\"default\":" & jstr(p.items[2].s) & ",\"placeholder\":" & jstr(p.items[1].s) & ",\"text\":" & tr(st, p.items[0]) &
      ",\"type\":\"input\"}"

proc customForm(st: WitState; f: CVal): string =
  var content = "["
  var i = 0
  while i < f.items[1].items.len:
    if i > 0: content.add ","
    content.add customElement(st, f.items[1].items[i])
    inc i
  content.add "]"
  "{\"content\":" & content & ",\"title\":" & tr(st, f.items[0]) & ",\"type\":\"custom_form\"}"

proc serializeForm*(st: WitState; form: CVal): string =
  ## `form` is `simple(simple-form) | modal(modal-form) | custom(custom-form)`.
  case int(form.i)
  of 0: simpleForm(st, form.items[0])
  of 1: modalForm(st, form.items[0])
  else: customForm(st, form.items[0])
