## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/gui.rs: the `gui` resource (`PluginGui`: window type, title,
## a `PluginInventory` of `size` slots, and the two allow flags). A handle's rep is a slot of `GuiState.guis`; the slots
## hold real `ItemStack`s. `set-item` copies the stack out of an `item-stack` handle (witstack.aowl) into the slot,
## `get-item` hands back a new `item-stack` handle over a copy, or none for an empty slot.
## The window type is the `screen` enum of screens.wit, in the order of `pumpkin_data::screen::WindowType` (the Rust maps
## them one for one), so the ordinal is kept as it is. The default sizes are upstream's, including `generic-9x1` and
## `hopper` having 5 slots.
## `guiAt` is what the player half (`player.open-gui`) reads to build the screen handler.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/gui.rs - `get-inventory` of the newer WIT (the `inventory`
## resource) is not provided and traps; a dropped gui is not freed; opening the gui for a player is `player.open-gui`.
import "../../data/item_stack/mod"
import ../wasm/[canonabi, component]
import ../../util/text/text
import witstate, witstack

const
  IfGui = "pumpkin:plugin/gui"
  Generic9x1* = 0
  Generic9x2* = 1
  Generic9x4* = 3
  Generic9x5* = 4
  Generic9x6* = 5
  Generic3x3* = 6
  Hopper* = 16
  ScreenCount* = 25

type
  GuiData* = object
    screen*: int
    title*: TextComponent
    slots*: seq[ItemStack]
    allowGrabItems*: bool
    allowPutItems*: bool

  GuiState* = ref object
    guis*: seq[GuiData]

proc newGuiState*(): GuiState = GuiState(guis: @[])

proc guiSize*(screen: int): int =
  ## The `match window_type` of `HostGui::new`.
  case screen
  of Generic9x2: 18
  of Generic9x4: 36
  of Generic9x5: 45
  of Generic9x6: 54
  of Generic3x3: 9
  of Generic9x1, Hopper: 5
  else: 27

proc addGui*(g: GuiState; screen: int; title: TextComponent): int =
  var slots: seq[ItemStack] = @[]
  var i = 0
  while i < guiSize(screen):
    slots.add emptyItemStack()
    inc i
  g.guis.add GuiData(screen: screen, title: title, slots: slots, allowGrabItems: true, allowPutItems: true)
  g.guis.len - 1

proc validGui*(g: GuiState; rep: int): bool = rep >= 0 and rep < g.guis.len

proc installGui*(r: HostRegistry; st: WitState; g: GuiState; ss: StackState) =
  witFn(r, IfGui, "[constructor]gui"):
    let screen = int(args[0].i)
    if screen < 0 or screen >= ScreenCount: return "gui: unknown screen type"
    results.add vInt(int64(addGui(g, screen, textAt(st, int(args[1].i)))))
  witFn(r, IfGui, "[method]gui.set-item"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    let slot = int(args[1].i)
    if not validStack(ss, int(args[2].i)): return "item-stack: invalid handle"
    if slot >= 0 and slot < g.guis[rep].slots.len:
      g.guis[rep].slots[slot] = ss.items[int(args[2].i)]
  witFn(r, IfGui, "[method]gui.get-item"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    let slot = int(args[1].i)
    if slot >= 0 and slot < g.guis[rep].slots.len and not g.guis[rep].slots[slot].isEmpty():
      results.add vSome(vInt(int64(addStack(ss, g.guis[rep].slots[slot]))))
    else:
      results.add vNone()
  witFn(r, IfGui, "[method]gui.get-type"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    results.add vInt(int64(g.guis[rep].screen))
  witFn(r, IfGui, "[method]gui.get-title"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    results.add vInt(int64(newTextRep(st, g.guis[rep].title)))
  witFn(r, IfGui, "[method]gui.get-size"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    results.add vInt(int64(g.guis[rep].slots.len))
  witFn(r, IfGui, "[method]gui.clear-items"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    var i = 0
    while i < g.guis[rep].slots.len:
      g.guis[rep].slots[i] = emptyItemStack()
      inc i
  witFn(r, IfGui, "[method]gui.set-allow-grab-items"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    g.guis[rep].allowGrabItems = args[1].i != 0
  witFn(r, IfGui, "[method]gui.get-allow-grab-items"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    results.add vBool(g.guis[rep].allowGrabItems)
  witFn(r, IfGui, "[method]gui.set-allow-put-items"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    g.guis[rep].allowPutItems = args[1].i != 0
  witFn(r, IfGui, "[method]gui.get-allow-put-items"):
    let rep = int(args[0].i)
    if not validGui(g, rep): return "gui: invalid handle"
    results.add vBool(g.guis[rep].allowPutItems)
