## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/i18n.rs: `translate` (translation lookup, falling back to
## English then the key) and `load-translations` (a flat JSON map under a namespace) over src/util/translation.aowl.
import std/strutils
import ../wasm/[canonabi, component]
import ../../util/translation
import ../../util/text/locale
import witstate

const IfI18n = "pumpkin:plugin/i18n"

proc witLocale(ci: CompInst; paramIdx: int; v: CVal): Locale =
  ## `wit_to_util_locale`: the enum case name (`en-us`) as `en_us`; unknown names are English (US).
  let t = ci.sigs[ci.funcs[ci.curFn].sig].params[paramIdx]
  let i = int(v.i)
  if i >= 0 and i < t.names.len: localeFromStr(t.names[i].replace("-", "_"))
  else: lcEnUs

proc installI18n*(r: HostRegistry; st: WitState) =
  witFn(r, IfI18n, "translate"):
    results.add vStr(getTranslation(args[0].s, witLocale(ci, 1, args[1])))
  witFn(r, IfI18n, "load-translations"):
    addTranslationFile(args[0].s, args[1].s, witLocale(ci, 2, args[2]))
