## Host-function level tests of the interfaces in this directory: each is called through the registry exactly as the
## canonical ABI would (lifted `CVal` arguments in, `CVal` results out), with a recording fake in place of the server.
## The component-level path (wasm calling these through the linker) is witcomptest.aowl.
import std/[syncio, assertions]
import ../wasm/[wasmvm, canonabi, component]
import ../../server/scheduler
import ../../util/text/text
import witstate, witall, wituuid

var failures = 0

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    inc failures

proc call(r: HostRegistry; ci: CompInst; iface, fname: string; args: seq[CVal]; results: var seq[CVal]): string =
  let key = iface & "#" & fname
  var i = 0
  while i < r.keys.len:
    if r.keys[i] == key:
      return r.fns[i].fn(ci, args, results)
    inc i
  result = "no host function " & key

proc c(r: HostRegistry; ci: CompInst; iface, fname: string; args: seq[CVal]): seq[CVal] =
  var res: seq[CVal] = @[]
  let e = call(r, ci, iface, fname, args, res)
  if e.len > 0:
    echo "FAILED call ", fname, ": ", e
    inc failures
  res

const
  T = "pumpkin:plugin/text"
  S = "pumpkin:plugin/scheduler"
  B = "pumpkin:plugin/boss-bar"
  W = "pumpkin:plugin/world"
  V = "pumpkin:plugin/server"
  U = "pumpkin:plugin/uuid"

var barLog: seq[string] = @[]
var blockWrites: seq[string] = @[]
var tick = 10'u64
var raining = false

proc main() =
  let r = newHostRegistry()
  let st = newWitState()
  installWitInterfaces(r, st)
  let ci = newCompInst(newWasmVm(), r, 3)
  let hk = st.hooks
  hk.tickCount = proc (): uint64 {.closure.} = tick
  hk.playerIds = proc (): seq[int] {.closure.} = @[7, 9]
  hk.playerWorld = proc (p: int): int {.closure.} = (if p == 7: 0 else: 1)
  hk.playerByName = proc (n: string): int {.closure.} = (if n == "Steve": 7 else: -1)
  hk.playerByUuid = proc (hi, lo: uint64): int {.closure.} = (if hi == 1'u64 and lo == 2'u64: 9 else: -1)
  hk.worldCount = proc (): int {.closure.} = 2
  hk.worldName = proc (w: int): string {.closure.} = (if w == 0: "minecraft:overworld" else: "minecraft:the_nether")
  hk.worldDimension = proc (w: int): string {.closure.} = (if w == 0: "minecraft:overworld" else: "minecraft:the_nether")
  hk.getBlockState = proc (w, x, y, z: int): int {.closure.} = 1
  hk.setBlockState = proc (w, x, y, z, state, flags: int): int {.closure.} =
    blockWrites.add $w & ":" & $x & "," & $y & "," & $z & "=" & $state & "/" & $flags
    result = 1
  hk.blockStateByName = proc (n: string): int {.closure.} = (if n == "minecraft:stone": 1 else: -1)
  hk.defaultStateOfBlock = proc (b: int): int {.closure.} = (if b == 5: 50 else: -1)
  hk.blockIdOfState = proc (s: int): int {.closure.} = s div 10
  hk.raining = proc (w: int): bool {.closure.} = raining
  hk.setRaining = proc (w: int; v: bool) {.closure.} = raining = v
  hk.barOp = proc (op: BarOp; p: int; bar: WBar) {.closure.} =
    barLog.add $ord(op) & ":" & $p & ":" & $bar.n & ":" & $bar.health & ":" & $bar.color
  hk.serverInfo = proc (): ServerInfo {.closure.} =
    ServerInfo(maxPlayers: 20, motd: "hi", viewDistance: 10, tps: 20.0, mspt: 1.5, difficulty: 2)

  # ---- uuid
  var res = c(r, ci, U, "parse", @[vStr("123e4567-e89b-12d3-a456-426614174000")])
  ck(res.len == 1 and res[0].i == 1, "uuid parse some")
  ck(cast[uint64](res[0].items[0].items[0].i) == 0x123e4567e89b12d3'u64, "uuid high")
  ck(cast[uint64](res[0].items[0].items[1].i) == 0xa456426614174000'u64, "uuid low")
  res = c(r, ci, U, "to-string", @[vRecord(@[vInt(cast[int64](0x123e4567e89b12d3'u64)), vInt(cast[int64](0xa456426614174000'u64))])])
  ck(res[0].s == "123e4567-e89b-12d3-a456-426614174000", "uuid to-string " & res[0].s)
  res = c(r, ci, U, "parse", @[vStr("not-a-uuid")])
  ck(res[0].i == 0, "uuid parse none")
  res = c(r, ci, U, "generate", @[])
  let hi = cast[uint64](res[0].items[0].i)
  let lo = cast[uint64](res[0].items[1].i)
  ck(((hi shr 12) and 0xF'u64) == 4'u64 and (lo shr 62) == 2'u64, "uuid v4 bits")
  res = c(r, ci, U, "generate", @[])
  ck(cast[uint64](res[0].items[1].i) != lo, "uuid generate differs")

  # ---- text
  res = c(r, ci, T, "[static]text-component.text", @[vStr("hi")])
  let t1 = int(res[0].i)
  discard c(r, ci, T, "[method]text-component.bold", @[vInt(int64(t1)), vBool(true)])
  discard c(r, ci, T, "[method]text-component.add-text", @[vInt(int64(t1)), vStr(" there")])
  res = c(r, ci, T, "[method]text-component.get-text", @[vInt(int64(t1))])
  ck(res[0].s == "hi there", "text get-text " & res[0].s)
  res = c(r, ci, T, "[method]text-component.to-json", @[vInt(int64(t1))])
  ck(res[0].s == "{\"text\":\"hi\",\"bold\":true,\"extra\":[{\"text\":\" there\"}]}", "text to-json " & res[0].s)
  res = c(r, ci, T, "[static]text-component.text", @[vStr("child")])
  let t2 = int(res[0].i)
  discard c(r, ci, T, "[method]text-component.add-child", @[vInt(int64(t1)), vInt(int64(t2))])
  discard c(r, ci, T, "[method]text-component.color-named", @[vInt(int64(t2)), vInt(14)])
  res = c(r, ci, T, "[method]text-component.get-text", @[vInt(int64(t1))])
  ck(res[0].s == "hi therechild", "text add-child " & res[0].s)
  res = c(r, ci, T, "[static]text-component.from-json", @[vStr("{\"text\":\"j\"}")])
  ck(res[0].i == 0, "from-json ok")
  res = c(r, ci, T, "[static]text-component.from-legacy-string", @[vStr("\xC2\xA7cred")])
  res = c(r, ci, T, "[method]text-component.to-json", @[vInt(int64(res[0].i))])
  ck(res[0].s.len > 0, "legacy to-json")

  # ---- scheduler
  res = c(r, ci, S, "schedule-delayed-task", @[vInt(77), vInt(5)])
  let task1 = res[0].i
  res = c(r, ci, S, "schedule-repeating-task", @[vInt(78), vInt(2), vInt(3)])
  let task2 = res[0].i
  ck(task1 != task2, "task ids differ")
  var due = st.sched.tick(11'u64)
  ck(due.len == 0, "nothing due at 11")
  due = st.sched.tick(12'u64)
  ck(due.len == 1 and due[0].handlerId == 78'u32 and due[0].pluginId == 3, "repeating due at 12")
  due = st.sched.tick(15'u64)
  ck(due.len == 2, "both due at 15")
  discard c(r, ci, S, "cancel-task", @[vInt(task2)])
  due = st.sched.tick(18'u64)
  ck(due.len == 0, "cancelled repeating task gone")

  # ---- boss bar
  res = c(r, ci, T, "[static]text-component.text", @[vStr("Boss")])
  res = c(r, ci, B, "[constructor]boss-bar", @[vInt(res[0].i), vInt(2), vInt(1)])
  let bar = res[0].i
  discard c(r, ci, B, "[method]boss-bar.add-player", @[vInt(bar), vInt(7)])
  discard c(r, ci, B, "[method]boss-bar.add-player", @[vInt(bar), vInt(7)])
  discard c(r, ci, B, "[method]boss-bar.add-player", @[vInt(bar), vInt(9)])
  ck(barLog.len == 2 and barLog[0] == "0:7:0:0.0:2", "bar add " & $barLog.len)
  discard c(r, ci, B, "[method]boss-bar.set-health", @[vInt(bar), vFloat(0.5)])
  ck(barLog.len == 4 and barLog[2] == "3:7:0:0.5:2", "bar health " & $barLog.len)
  res = c(r, ci, B, "[method]boss-bar.get-health", @[vInt(bar)])
  ck(res[0].f == 0.5, "get-health")
  discard c(r, ci, B, "[method]boss-bar.set-color", @[vInt(bar), vInt(3)])
  res = c(r, ci, B, "[method]boss-bar.get-color", @[vInt(bar)])
  ck(res[0].i == 3 and barLog.len == 6, "bar color")
  discard c(r, ci, B, "[method]boss-bar.set-metadata", @[vInt(bar), vRecord(@[vBool(true), vBool(false), vBool(true)])])
  res = c(r, ci, B, "[method]boss-bar.get-metadata", @[vInt(bar)])
  ck(res[0].items[0].i == 1 and res[0].items[1].i == 0 and res[0].items[2].i == 1, "bar metadata")
  res = c(r, ci, B, "[method]boss-bar.get-players", @[vInt(bar)])
  ck(res[0].items.len == 2, "bar players")
  discard c(r, ci, B, "[method]boss-bar.remove-player", @[vInt(bar), vInt(7)])
  ck(barLog[barLog.len - 1] == "1:7:0:0.5:3", "bar remove " & barLog[barLog.len - 1])
  res = c(r, ci, B, "[method]boss-bar.get-players", @[vInt(bar)])
  ck(res[0].items.len == 1 and res[0].items[0].i == 9, "bar players after remove")
  discard c(r, ci, B, "[method]boss-bar.remove-all", @[vInt(bar)])
  ck(barLog[barLog.len - 1] == "1:9:0:0.5:3", "bar remove-all")

  # ---- world
  let pos = vRecord(@[vInt(10), vInt(64), vInt(-3)])
  res = c(r, ci, W, "[method]world.get-id", @[vInt(1)])
  ck(res[0].s == "minecraft:the_nether", "world id")
  discard c(r, ci, W, "[method]world.set-block-state", @[vInt(0), pos, vInt(1234), vInt(3)])
  ck(blockWrites.len == 1 and blockWrites[0] == "0:10,64,-3=1234/3", "set-block-state " & $blockWrites.len)
  res = c(r, ci, W, "[method]world.set-block-by-name", @[vInt(0), pos, vStr("minecraft:stone"), vInt(1)])
  ck(res[0].i == 1 and blockWrites[1] == "0:10,64,-3=1/1", "set-block-by-name")
  res = c(r, ci, W, "[method]world.set-block-by-name", @[vInt(0), pos, vStr("minecraft:nope"), vInt(1)])
  ck(res[0].i == 0 and blockWrites.len == 2, "set-block-by-name unknown")
  discard c(r, ci, W, "[method]world.set-block-by-id", @[vInt(0), pos, vInt(5), vInt(0)])
  ck(blockWrites[2] == "0:10,64,-3=50/0", "set-block-by-id")
  var e = call(r, ci, W, "[method]world.set-block-by-id", @[vInt(0), pos, vInt(99), vInt(0)], res)
  ck(e.len > 0, "set-block-by-id unknown traps")
  e = call(r, ci, W, "[method]world.get-id", @[vInt(5)], res)
  ck(e.len > 0, "bad world handle traps")
  res = c(r, ci, W, "[method]world.get-block-id", @[vInt(0), pos])
  ck(res[0].i == 0, "get-block-id")
  discard c(r, ci, W, "[method]world.set-raining", @[vInt(0), vBool(true)])
  res = c(r, ci, W, "[method]world.is-raining", @[vInt(0)])
  ck(res[0].i == 1, "raining")

  # ---- server
  res = c(r, ci, V, "[method]server.get-all-players", @[vInt(0)])
  ck(res[0].items.len == 2, "all players")
  res = c(r, ci, V, "[method]server.get-player-by-name", @[vInt(0), vStr("Steve")])
  ck(res[0].i == 1 and res[0].items[0].i == 7, "player by name")
  res = c(r, ci, V, "[method]server.get-player-by-name", @[vInt(0), vStr("Nobody")])
  ck(res[0].i == 0, "player by name none")
  res = c(r, ci, V, "[method]server.get-player-by-uuid", @[vInt(0), vRecord(@[vInt(1), vInt(2)])])
  ck(res[0].i == 1 and res[0].items[0].i == 9, "player by uuid")
  res = c(r, ci, V, "[method]server.get-world-by-name", @[vInt(0), vStr("minecraft:the_nether")])
  ck(res[0].i == 1 and res[0].items[0].i == 1, "world by name")
  res = c(r, ci, V, "[method]server.get-all-worlds", @[vInt(0)])
  ck(res[0].items.len == 2, "all worlds")
  res = c(r, ci, V, "[method]server.get-player-count-in-world", @[vInt(0), vInt(1)])
  ck(res[0].i == 1, "players in world")
  res = c(r, ci, V, "[method]server.get-max-players", @[vInt(0)])
  ck(res[0].i == 20, "max players")
  res = c(r, ci, V, "[method]server.get-motd", @[vInt(0)])
  ck(res[0].s == "hi", "motd")
  res = c(r, ci, V, "[method]server.get-tps", @[vInt(0)])
  ck(res[0].f == 20.0, "tps")

  if failures > 0: quit 1
  echo "witifacetest ok"

main()
