    let pk = js_ping_response.CPingResponse(payload: int64(f[0].i))
    let pid = typeof(pk).toId(ver)
    if pid == -1'i32: return false
    var jw = newNetWriter()
    writeJavaPacketId(jw, pid)
    let pres = writePacket(pk, jw, ver)
    if not pres.isOk: return false
    id = pid
    body = jw.buf
  of "status-c-status-response":
    let pk = js_status_response.CStatusResponse(jsonResponse: f[0].s)
    let pid = typeof(pk).toId(ver)
    if pid == -1'i32: return false
    var jw = newNetWriter()
    writeJavaPacketId(jw, pid)
    let pres = writePacket(pk, jw, ver)
    if not pres.isOk: return false
    id = pid
    body = jw.buf
  else:
    return false
  true

proc bedrockPacketWire*(name: string; v: CVal; id: var int32; body: var seq[byte]): bool =
  ## The packet id and the body before the frame header (`serialize_bedrock_packet`); false for a case without an arm.
  var wr = newNetWriter()
  let f = v.items
  case name
  of "c-change-dimension":
    id = b_change_dimension.CChangeDimensionPacketId
    packetWrite(b_change_dimension.CChangeDimension(dimension: newVarInt(int32(f[0].i)), position: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), respawn: f[2].i != 0, hasLoadingScreenId: f[3].i != 0), wr)
  of "c-chunk-radius-update":
    id = b_chunk_radius_update.CChunkRadiusUpdatePacketId
    packetWrite(b_chunk_radius_update.CChunkRadiusUpdate(chunkRadius: newVarInt(int32(f[0].i))), wr)
  of "c-container-open":
    id = b_container_open.CContainerOpenPacketId
    packetWrite(b_container_open.CContainerOpen(containerId: uint8(f[0].i), containerType: uint8(f[1].i), position: newBlockPos(int32(f[2].items[0].i), int32(f[2].items[1].i), int32(f[2].items[2].i)), targetEntityId: newVarLong(f[3].i)), wr)
  of "c-correct-player-move":
    id = b_correct_player_move.CCorrectPlayerMovePacketId
    packetWrite(b_correct_player_move.CCorrectPlayerMove(predictionType: uint8(f[0].i), pos: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), posDelta: Vector3[float32](x: float32(f[2].items[0].f), y: float32(f[2].items[1].f), z: float32(f[2].items[2].f)), onGround: f[3].i != 0, tick: newVarULong(uint64(f[4].i))), wr)
  of "c-disconnect-player":
    id = b_disconnect_player.CDisconnectPlayerPacketId
    packetWrite(b_disconnect_player.CDisconnectPlayer(reason: newVarInt(int32(f[0].i)), skipMessage: f[1].i != 0, message: f[2].s, filteredMessage: f[3].s), wr)
  of "c-level-event":
    id = b_level_event.CLevelEventPacketId
    packetWrite(b_level_event.CLevelEvent(eventId: newVarInt(int32(f[0].i)), position: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), data: newVarInt(int32(f[2].i))), wr)
  of "c-level-sound-event":
    id = b_level_sound_event.CLevelSoundEventPacketId
    packetWrite(b_level_sound_event.CLevelSoundEvent(soundId: newVarUInt(uint32(f[0].i)), position: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), extraData: newVarInt(int32(f[2].i)), entityType: f[3].s, isBabyMob: f[4].i != 0, isGlobal: f[5].i != 0), wr)
  of "c-modal-form-request":
    id = b_modal_form_request.CModalFormRequestPacketId
    packetWrite(b_modal_form_request.CModalFormRequest(formId: newVarInt(int32(f[0].i)), formData: f[1].s), wr)
  of "c-move-actor-absolute":
    id = b_move_actor_absolute.CMoveActorAbsolutePacketId
    packetWrite(b_move_actor_absolute.CMoveActorAbsolute(entityRuntimeId: newVarULong(uint64(f[0].i)), flags: uint8(f[1].i), position: Vector3[float32](x: float32(f[2].items[0].f), y: float32(f[2].items[1].f), z: float32(f[2].items[2].f)), pitch: uint8(f[3].i), yaw: uint8(f[4].i), headYaw: uint8(f[5].i)), wr)
  of "c-move-actor-delta":
    id = b_move_actor_delta.CMoveActorDeltaPacketId
    packetWrite(b_move_actor_delta.CMoveActorDelta(entityRuntimeId: newVarULong(uint64(f[0].i)), flags: uint16(f[1].i), x: float32(f[2].f), y: float32(f[3].f), z: float32(f[4].f), pitch: uint8(f[5].i), yaw: uint8(f[6].i), headYaw: uint8(f[7].i)), wr)
  of "c-move-player":
    id = b_move_player.CMovePlayerPacketId
    packetWrite(b_move_player.CMovePlayer(playerRuntimeId: newVarULong(uint64(f[0].i)), position: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), pitch: float32(f[2].f), yaw: float32(f[3].f), headYaw: float32(f[4].f), mode: uint8(f[5].i), onGround: f[6].i != 0, ridingRuntimeId: newVarULong(uint64(f[7].i)), teleportCause: int32(f[8].i), teleportSourceEntityType: int32(f[9].i), tick: newVarULong(uint64(f[10].i))), wr)
  of "c-network-settings":
    id = b_network_settings.CNetworkSettingsPacketId
    packetWrite(b_network_settings.CNetworkSettings(compressionThreshold: uint16(f[0].i), compressionMethod: uint16(f[1].i), clientThrottleEnabled: f[2].i != 0, clientThrottleThreshold: int8(f[3].i), clientThrottleScalar: float32(f[4].f)), wr)
  of "c-player-hotbar":
    id = b_player_hotbar.CPlayerHotbarPacketId
    packetWrite(b_player_hotbar.CPlayerHotbar(selectedSlot: newVarUInt(uint32(f[0].i)), containerId: uint8(f[1].i), shouldSelectBlock: f[2].i != 0), wr)
  of "c-remove-actor":
    id = b_remove_actor.CRemoveActorPacketId
    packetWrite(b_remove_actor.CRemoveActor(entityUniqueId: newVarLong(f[0].i)), wr)
  of "c-set-display-objective":
    id = b_scoreboard.CSetDisplayObjectivePacketId
    packetWrite(b_scoreboard.CSetDisplayObjective(displaySlot: f[0].s, objectiveName: f[1].s, displayName: f[2].s, criteriaName: f[3].s, sortOrder: newVarInt(int32(f[4].i))), wr)
  of "c-remove-objective":
    id = b_scoreboard.CRemoveObjectivePacketId
    packetWrite(b_scoreboard.CRemoveObjective(objectiveName: f[0].s), wr)
  of "c-set-actor-motion":
    id = b_set_actor_motion.CSetActorMotionPacketId
    packetWrite(b_set_actor_motion.CSetActorMotion(targetRuntimeId: newVarULong(uint64(f[0].i)), motion: Vector3[float32](x: float32(f[1].items[0].f), y: float32(f[1].items[1].f), z: float32(f[1].items[2].f)), tick: newVarULong(uint64(f[2].i))), wr)
  of "c-set-difficulty":
    id = b_set_difficulty.CSetDifficultyPacketId
    packetWrite(b_set_difficulty.CSetDifficulty(difficulty: newVarUInt(uint32(f[0].i))), wr)
  of "c-set-health":
    id = b_set_health.CSetHealthPacketId
    packetWrite(b_set_health.CSetHealth(health: newVarInt(int32(f[0].i))), wr)
  of "c-set-spawn-position":
    id = b_set_spawn_position.CSetSpawnPositionPacketId
    packetWrite(b_set_spawn_position.CSetSpawnPosition(spawnType: newVarInt(int32(f[0].i)), position: newBlockPos(int32(f[1].items[0].i), int32(f[1].items[1].i), int32(f[1].items[2].i)), dimension: newVarInt(int32(f[2].i)), spawnPosition: newBlockPos(int32(f[3].items[0].i), int32(f[3].items[1].i), int32(f[3].items[2].i))), wr)
  of "c-set-time":
    id = b_set_time.CSetTimePacketId
    packetWrite(b_set_time.CSetTime(time: newVarInt(int32(f[0].i))), wr)
  of "c-set-title":
    id = b_set_title.CSetTitlePacketId
    packetWrite(b_set_title.CSetTitle(actionType: newVarInt(int32(f[0].i)), text: f[1].s, fadeInDuration: newVarInt(int32(f[2].i)), remainDuration: newVarInt(int32(f[3].i)), fadeOutDuration: newVarInt(int32(f[4].i)), xuid: f[5].s, platformOnlineId: f[6].s, filteredMessage: f[7].s), wr)
  of "c-show-credits":
    id = b_show_credits.CShowCreditsPacketId
    packetWrite(b_show_credits.CShowCredits(playerRuntimeId: newVarULong(uint64(f[0].i)), status: newVarInt(int32(f[1].i))), wr)
  of "c-take-item-actor":
    id = b_take_item_actor.CTakeItemActorPacketId
    packetWrite(b_take_item_actor.CTakeItemActor(itemRuntimeId: newVarULong(uint64(f[0].i)), actorRuntimeId: newVarULong(uint64(f[1].i))), wr)
  of "c-transfer":
    id = b_transfer.CTransferPacketId
    packetWrite(b_transfer.CTransfer(address: f[0].s, port: uint16(f[1].i), reloadWorld: f[2].i != 0), wr)
  of "c-update-block":
    id = b_update_block.CUpdateBlockPacketId
    packetWrite(b_update_block.CUpdateBlock(position: newBlockPos(int32(f[0].items[0].i), int32(f[0].items[1].i), int32(f[0].items[2].i)), blockRuntimeId: newVarUInt(uint32(f[1].i)), flags: newVarUInt(uint32(f[2].i)), layer: newVarUInt(uint32(f[3].i))), wr)
  else:
    return false
  body = wr.buf
  true
