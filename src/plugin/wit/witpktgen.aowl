proc liftBytes(v: CVal): seq[byte] =
  result = @[]
  for b in v.items: result.add byte(b.i)

proc liftVarInts(v: CVal): seq[VarInt] =
  result = @[]
  for b in v.items: result.add newVarInt(int32(b.i))

proc liftUuids(v: CVal): seq[Uuid] =
  result = @[]
  for b in v.items: result.add Uuid(hi: uint64(b.items[0].i), lo: uint64(b.items[1].i))

proc liftI64s(v: CVal): seq[int64] =
  result = @[]
  for b in v.items: result.add b.i

