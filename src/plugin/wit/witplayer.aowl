## The `player` host interface: the `player` and `java-player` resources. Port of
## pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/player.rs (the `HostPlayer` and `HostJavaPlayer` impls). A player
## handle's rep is the player's entity id (witserver.aowl); every method looks the `Player` up again, so a handle to a
## player that has left traps its next call ("player is gone"), as the Rust host's `expect` on the Arc would.
## What the server already hooks for commands (`CommandPlayer`: permission level, titles, transfer, experience, kick,
## locale, effects, ...) is called through `server.commandPlayerOf`; the rest reads or writes the `Player` itself.
##
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/player.rs - done (witplayer.aowl and witplayer2.aowl):
## identity, position and rotation, world, game mode, locale, ping, permission level and node checks, display name,
## system messages, titles, teleport (cross-world included) and `teleport-world`, transfer, heal, kill, health/food/
## saturation/exhaustion/absorption/experience, flying and the ability setters, abilities as a record, selected slot,
## `as-java`/`as-bedrock`, java kick, tab list name/order/latency/listed/header-footer, cameras, registry sounds and
## stop-sound, particles, block-change/reset, sign editor, hurt animation, velocity, knockback, server links, respawn,
## ban and ban-ip (the lists the commands use, no expiry), typed damage, statistics, cooldowns (kept here, with the
## packet), ip, skin and skin parts (no metadata resend), per-player time/weather/compass/respawn location.
## Plugin-side only (a plugin reads it back, the server never consults it): permission overrides (`set-permission`,
## `unset-permission`, `has-permission-set`: the server has no per-player attachments), movement lock, freeze ticks,
## hide/show, per-player time and weather. Still trapping with "unimplemented host function": `set-display-name`,
## `delete-message-*`, custom (non-registry) sounds, status effects (the effect resources belong to the status-effect
## interface), inventory/ender chest/item-in-hand (item-stack resources), `open-gui`, `open-book`, advancements,
## ray tracing and projectiles, `set-experience-progress` packets, and every `java-player` method except `kick`
## (packets, dialogs, resource packs, scoreboards, game events).
import std/[options, syncio, tables]
import ../wasm/[component, canonabi]
import ../../command/cmdsource
import ../../protocol/varint
import ../../util/permission
import ../../util/gamemode
import ../../util/text/text
import ../../util/vector3
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/entity/player as playermod
import ../../server/net/java/javamod
import ../../server/world/worldmod
import witstate, witserver, witplayer2

proc gone(): string = "player is gone"

proc cpOf(p: Player): nil CommandPlayer =
  result = p.commandPlayer
  if result == nil:
    let srv = gLink.server
    if srv != nil and srv.commandPlayerOf != nil:
      result = srv.commandPlayerOf(p)

proc installPlayer*(r: HostRegistry; w: WitState) =
  # ---- identity and state ----
  hostFn(r, IfacePlayer, "[method]player.as-entity"):
    results.add vInt(args[0].i)
  hostFn(r, IfacePlayer, "[method]player.get-id"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vRecord(@[u64Val(p.gameprofile.id.hi), u64Val(p.gameprofile.id.lo)])
  hostFn(r, IfacePlayer, "[method]player.get-name"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vStr(p.gameprofile.name)
  hostFn(r, IfacePlayer, "[method]player.get-position"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vPos(p.pos)
  hostFn(r, IfacePlayer, "[method]player.get-yaw"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.yaw))
  hostFn(r, IfacePlayer, "[method]player.get-pitch"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.pitch))
  hostFn(r, IfacePlayer, "[method]player.get-world"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(worldRep(p.world)))
  hostFn(r, IfacePlayer, "[method]player.get-gamemode"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(ord(p.gamemode)))
  hostFn(r, IfacePlayer, "[method]player.set-gamemode"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vBool(playermod.setGamemode(p, GameMode(int(args[1].i))))
  hostFn(r, IfacePlayer, "[method]player.get-locale"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vStr(p.config.locale)
  hostFn(r, IfacePlayer, "[method]player.get-ping"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(p.ping))
  # ---- permissions and names ----
  hostFn(r, IfacePlayer, "[method]player.get-permission-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(ord(p.permissionLvl)))
  hostFn(r, IfacePlayer, "[method]player.set-permission-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.setPermissionLvl(PermissionLvl(int(args[1].i)))
  hostFn(r, IfacePlayer, "[method]player.has-permission"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let ov = gPermOverrides.getOrDefault(p.entityId)
    if ov.hasKey(args[1].s):
      results.add vBool(ov.getOrDefault(args[1].s))
    else:
      let cp = cpOf(p)
      results.add vBool(cp != nil and cp.hasPermission(args[1].s))
  hostFn(r, IfacePlayer, "[method]player.get-display-name"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(newTextRep(w, text(p.gameprofile.name))))
  # ---- messages and titles ----
  hostFn(r, IfacePlayer, "[method]player.send-system-message"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    gLink.sendSystemMessage(p, textAt(w, int(args[1].i)), args[2].i != 0)
  hostFn(r, IfacePlayer, "[method]player.show-title"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.showTitle(textAt(w, int(args[1].i)), ctmTitle)
  hostFn(r, IfacePlayer, "[method]player.show-subtitle"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.showTitle(textAt(w, int(args[1].i)), ctmSubTitle)
  hostFn(r, IfacePlayer, "[method]player.show-actionbar"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.showTitle(textAt(w, int(args[1].i)), ctmActionBar)
  hostFn(r, IfacePlayer, "[method]player.send-title-animation"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.sendTitleAnimation(int32(args[1].i), int32(args[2].i), int32(args[3].i))
  # ---- movement ----
  hostFn(r, IfacePlayer, "[method]player.teleport"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    var yaw = p.yaw
    var pitch = p.pitch
    if args[2].i != 0: yaw = float32(args[2].items[0].f)
    if args[3].i != 0: pitch = float32(args[3].items[0].f)
    let target = if args.len > 4: worldAt(int(args[4].i)) else: nil
    if target != nil and target != p.world:
      worldmod.teleportWorld(target, p, posOf(args[1]), some(yaw), some(pitch))
    else:
      playermod.requestTeleport(p, posOf(args[1]), yaw, pitch)
  hostFn(r, IfacePlayer, "[method]player.transfer"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.transfer(args[1].s, int32(args[2].i))
  # ---- health and damage ----
  hostFn(r, IfacePlayer, "[method]player.heal"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    playermod.heal(p, float32(args[1].f))
  hostFn(r, IfacePlayer, "[method]player.kill"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let b = playerBase(p)
    kill(b, b)
  hostFn(r, IfacePlayer, "[method]player.get-health"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.health))
  hostFn(r, IfacePlayer, "[method]player.set-health"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.health = max(0.0'f32, float32(args[1].f))
    playermod.sendHealth(p)
  hostFn(r, IfacePlayer, "[method]player.get-max-health"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.maxHealth))
  hostFn(r, IfacePlayer, "[method]player.set-max-health"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.maxHealth = float32(args[1].f)
  hostFn(r, IfacePlayer, "[method]player.get-food-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(p.hungerManager.level))
  hostFn(r, IfacePlayer, "[method]player.set-food-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.hungerManager.level = uint8(min(20, int(args[1].i)))
    playermod.sendHealth(p)
  hostFn(r, IfacePlayer, "[method]player.get-saturation"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.hungerManager.saturation))
  hostFn(r, IfacePlayer, "[method]player.set-saturation"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.hungerManager.saturation = float32(args[1].f)
    playermod.sendHealth(p)
  hostFn(r, IfacePlayer, "[method]player.get-exhaustion"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.hungerManager.exhaustion))
  hostFn(r, IfacePlayer, "[method]player.set-exhaustion"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.hungerManager.exhaustion = float32(args[1].f)
  hostFn(r, IfacePlayer, "[method]player.get-absorption"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.absorption))
  hostFn(r, IfacePlayer, "[method]player.set-absorption"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.absorption = float32(args[1].f)
  # ---- experience ----
  hostFn(r, IfacePlayer, "[method]player.get-experience-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(p.experienceLevel))
  hostFn(r, IfacePlayer, "[method]player.get-experience-progress"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vFloat(float64(p.experienceProgress))
  hostFn(r, IfacePlayer, "[method]player.get-experience-points"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vInt(int64(p.experiencePoints))
  hostFn(r, IfacePlayer, "[method]player.set-experience-level"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.setExperienceLevel(int32(args[1].i))
  hostFn(r, IfacePlayer, "[method]player.set-experience-points"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.setExperiencePoints(int32(args[1].i))
  hostFn(r, IfacePlayer, "[method]player.add-experience-levels"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.addExperienceLevels(int32(args[1].i))
  hostFn(r, IfacePlayer, "[method]player.add-experience-points"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    if cp != nil: cp.addExperiencePoints(int32(args[1].i))
  # ---- abilities ----
  hostFn(r, IfacePlayer, "[method]player.is-flying"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    results.add vBool(p.abilities.flying)
  hostFn(r, IfacePlayer, "[method]player.set-flying"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.abilities.flying = args[1].i != 0
    playermod.sendAbilitiesUpdate(p)
  hostFn(r, IfacePlayer, "[method]player.set-allow-flight"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.abilities.allowFlying = args[1].i != 0
    if not p.abilities.allowFlying: p.abilities.flying = false
    playermod.sendAbilitiesUpdate(p)
  hostFn(r, IfacePlayer, "[method]player.set-fly-speed"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.abilities.flySpeed = float32(args[1].f)
    playermod.sendAbilitiesUpdate(p)
  hostFn(r, IfacePlayer, "[method]player.set-walk-speed"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.abilities.walkSpeed = float32(args[1].f)
    playermod.sendAbilitiesUpdate(p)
  hostFn(r, IfacePlayer, "[method]player.set-invulnerable"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    p.abilities.invulnerable = args[1].i != 0
    playermod.sendAbilitiesUpdate(p)
  hostFn(r, IfacePlayer, "[method]player.get-selected-slot"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    let cp = cpOf(p)
    results.add vInt(int64(if cp != nil: cp.getSelectedSlot() else: 0'i32))
  hostFn(r, IfacePlayer, "[method]player.get-team"):
    results.add vNone()
  # ---- platform views ----
  hostFn(r, IfacePlayer, "[method]player.as-java"):
    results.add vSome(vInt(args[0].i))
  hostFn(r, IfacePlayer, "[method]player.as-bedrock"):
    results.add vNone()
  hostFn(r, IfacePlayer, "[method]java-player.kick"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone()
    # java-kick-options { reason: text-component, log-to-console: bool, teardown-policy }
    let reason = textAt(w, int(args[1].items[0].i))
    if args[1].items[1].i != 0:
      echo "Kicking ", p.gameprofile.name, ": ", getText(reason)
    javamod.kick(p.client, reason)
  installPlayerMore(r, w)
