import ../../protocol/bedrock/client/set_actor_data
import ../../protocol/java/client/play/[open_book, delete_chat, resource_pack, game_event]
import ../../protocol/java/client/play/entity_status as entitystatuspkt
import ../../util/uuid
import ../../command/cmdsource
import ../../util/vector3
import ../../util/text/text
import ../../util/math/position
import ../../server/serverbase
import ../../server/net/netbase
import ../../server/net/java/javamod
import ../../server/entity/entitymod
import ../../server/entity/player as playermod
import ../../server/entity/playerextras
import ../../server/entity/player/advancement as advmod
import ../../server/entity/player/advancement/trigger
import ../../server/entity/projectile/[thrown, thrown_items]
import ../../server/world/worldmod
import ../../util/javaversion
import ../pluginhooks
import witstate, witserver, witstack, witgui, witray, witplayer2, witforms

const
  IfInventory = "pumpkin:plugin/inventory"
  MainSize = 36
  EnderSize = 27
  ThrowSpeed = 1.5'f32
  EffectNames = ["speed", "slowness", "haste", "mining-fatigue", "strength", "instant-health", "instant-damage",
    "jump-boost", "nausea", "regeneration", "resistance", "fire-resistance", "water-breathing", "invisibility",
    "blindness", "night-vision", "hunger", "weakness", "poison", "wither", "health-boost", "absorption", "saturation",
    "glowing", "levitation", "luck", "unluck", "slow-falling", "conduit-power", "dolphins-grace", "bad-omen",
    "hero-of-the-village", "darkness", "trial-omen", "raid-omen", "wind-charged", "weaving", "oozing", "infested"]

proc gone3(): string = "player is gone"

## `from_wasm_bedrock_status_flag`: the WIT `bedrock-status-flag` case index (upstream's match arm order) to the Bedrock
## `entity_data_flag` bit.
const BedrockStatusFlagBits* = [
  EDF_ON_FIRE, EDF_SNEAKING, EDF_RIDING, EDF_SPRINTING, EDF_USING_ITEM, EDF_INVISIBLE, EDF_TEMPTED, EDF_IN_LOVE,
  EDF_SADDLED, EDF_POWERED, EDF_IGNITED, EDF_BABY, EDF_CONVERTING, EDF_CRITICAL, EDF_SHOW_NAME, EDF_ALWAYS_SHOW_NAME,
  EDF_NO_AI, EDF_SILENT, EDF_WALL_CLIMBING, EDF_CLIMB, EDF_SWIM, EDF_FLY, EDF_WALK, EDF_RESTING, EDF_SITTING,
  EDF_ANGRY, EDF_INTERESTED, EDF_CHARGED, EDF_TAMED, EDF_ORPHANED, EDF_LEASHED, EDF_SHEARED, EDF_GLIDING, EDF_ELDER,
  EDF_MOVING, EDF_BREATHING, EDF_CHESTED, EDF_STACKABLE, EDF_SHOW_BOTTOM, EDF_STANDING, EDF_SHAKING, EDF_IDLING,
  EDF_CASTING, EDF_CHARGING, EDF_KEYBOARD_CONTROLLED, EDF_POWER_JUMP, EDF_DASH, EDF_LINGERING, EDF_HAS_COLLISION,
  EDF_HAS_GRAVITY, EDF_FIRE_IMMUNE, EDF_DANCING, EDF_ENCHANTED, EDF_RETURN_TRIDENT, EDF_CONTAINER_PRIVATE,
  EDF_TRANSFORMING, EDF_DAMAGE_NEARBY_MOBS, EDF_SWIMMING, EDF_BRIBED, EDF_PREGNANT, EDF_LAYING_EGG,
  EDF_PASSENGER_CAN_PICK, EDF_TRANSITION_SITTING, EDF_EATING, EDF_LAYING_DOWN, EDF_SNEEZING, EDF_TRUSTING,
  EDF_ROLLING, EDF_SCARED, EDF_IN_SCAFFOLDING, EDF_OVER_SCAFFOLDING, EDF_DESCEND_THROUGH_BLOCK, EDF_BLOCKING,
  EDF_TRANSITION_BLOCKING, EDF_BLOCKED_USING_SHIELD, EDF_BLOCKED_USING_DAMAGED_SHIELD, EDF_SLEEPING,
  EDF_WANTS_TO_WAKE, EDF_TRADE_INTEREST, EDF_DOOR_BREAKER, EDF_BREAKING_OBSTRUCTION, EDF_DOOR_OPENER, EDF_CAPTAIN,
  EDF_STUNNED, EDF_ROARING, EDF_DELAYED_ATTACK, EDF_AVOIDING_MOBS, EDF_AVOIDING_BLOCK,
  EDF_FACING_TARGET_TO_RANGE_ATTACK, EDF_HIDDEN_WHEN_INVISIBLE, EDF_IN_UI, EDF_STALKING, EDF_EMOTING,
  EDF_CELEBRATING, EDF_ADMIRING, EDF_CELEBRATING_SPECIAL, EDF_OUT_OF_CONTROL, EDF_RAM_ATTACK, EDF_PLAYING_DEAD,
  EDF_IN_ASCENDING_BLOCK, EDF_OVER_DESCENDING_BLOCK, EDF_CROAKING, EDF_DIGEST_MOB, EDF_JUMP_GOAL, EDF_EMERGING,
  EDF_SNIFFING, EDF_DIGGING, EDF_SONIC_BOOM, EDF_HAS_DASH_TIMEOUT, EDF_PUSH_TOWARDS_CLOSEST_SPACE, EDF_SCENTING,
  EDF_RISING, EDF_FEELING_HAPPY, EDF_SEARCHING, EDF_CRAWLING, EDF_BODY_ROTATION_BLOCKED, EDF_RENDER_WHEN_INVISIBLE,
  EDF_BODY_ROTATION_AXIS_ALIGNED, EDF_COLLIDABLE, EDF_WASD_AIR_CONTROLLED, EDF_DOES_SERVER_AUTH_ONLY_DISMOUNT,
  EDF_BODY_ROTATION_ALWAYS_FOLLOWS_HEAD, EDF_CAN_USE_VERTICAL_MOVEMENT_ACTION]

var gBedrockFlags: Table[int, (uint64, uint64)] = initTable[int, (uint64, uint64)]()

proc bedrockFlagGet*(entityId, flag: int): bool =
  ## `get-status-flag`: bits below 64 are `bedrock_flags`, the rest `bedrock_flags_two`. Kept here per entity id (the
  ## server's `Entity` has no Bedrock flag words); an unknown case reads false.
  if flag < 0 or flag >= BedrockStatusFlagBits.len: return false
  let idx = int(BedrockStatusFlagBits[flag])
  let (a, b) = gBedrockFlags.getOrDefault(entityId, (0'u64, 0'u64))
  if idx < 64: (a and (1'u64 shl uint64(idx))) != 0'u64
  else: (b and (1'u64 shl uint64(idx - 64))) != 0'u64

proc bedrockFlagSet*(entityId, flag: int; value: bool) =
  if flag < 0 or flag >= BedrockStatusFlagBits.len: return
  let idx = int(BedrockStatusFlagBits[flag])
  var cur = gBedrockFlags.getOrDefault(entityId, (0'u64, 0'u64))
  if idx < 64:
    let m = 1'u64 shl uint64(idx)
    cur[0] = if value: (cur[0] or m) else: (cur[0] and not m)
  else:
    let m = 1'u64 shl uint64(idx - 64)
    cur[1] = if value: (cur[1] or m) else: (cur[1] and not m)
  gBedrockFlags[entityId] = cur

proc bedrockAbilityGet*(ab: Abilities; ability: int): bool =
  ## `get-ability` over the shared `Abilities`: build/mine are `allow_modify_world`; the Bedrock-only abilities read false.
  case ability
  of 0, 1: ab.allowModifyWorld
  of 8: ab.invulnerable
  of 9: ab.flying
  of 10: ab.allowFlying
  of 11: ab.creative
  else: false

proc bedrockAbilitySet*(ab: var Abilities; ability: int; value: bool) =
  case ability
  of 0, 1: ab.allowModifyWorld = value
  of 8: ab.invulnerable = value
  of 9: ab.flying = value
  of 10: ab.allowFlying = value
  of 11: ab.creative = value
  else: discard

proc bareKey(k: string): string =
  if k.startsWith("minecraft:"): k[10 ..< k.len] else: k

proc stackOpt(ss: StackState; s: ItemStack): CVal =
  if s.isEmpty(): vNone() else: vSome(vInt(int64(addStack(ss, s))))

proc stackIn(ss: StackState; v: CVal): ItemStack =
  ## An `option<item-stack>` argument as a stack (empty for none or a bad handle).
  if v.i == 0 or not validStack(ss, int(v.items[0].i)): emptyItemStack() else: ss.items[int(v.items[0].i)]

proc cpOf3(p: Player): nil CommandPlayer =
  result = p.commandPlayer
  if result == nil:
    let srv = gLink.server
    if srv != nil and srv.commandPlayerOf != nil:
      result = srv.commandPlayerOf(p)

proc effectOfWit(idx: int; res: var StatusEffect): bool =
  if idx < 0 or idx >= EffectNames.len: return false
  let e = StatusEffect.fromMinecraftName("minecraft:" & EffectNames[idx].replace("-", "_"))
  if e.isNone: return false
  res = e.unsafeGet
  true

proc witOfEffect(e: StatusEffect): int =
  let n = bareKey(e.minecraftName).replace("_", "-")
  result = -1
  var i = 0
  while i < EffectNames.len:
    if EffectNames[i] == n: result = i
    inc i

proc effectVal(e: Effect): CVal =
  vRecord(@[vInt(int64(max(0, witOfEffect(e.effectType)))), vInt(int64(e.duration)), vInt(int64(e.amplifier)),
            vBool(e.ambient), vBool(e.showParticles), vBool(e.showIcon)])

proc slotOf(p: Player; slot: int): ItemStack = inventory.getStack(Inventory(p.inventory), slot)

proc putSlot(p: Player; slot: int; s: ItemStack) =
  ## `set_stack` and the client sync: the hand slots by `sync_hand_slot`, the others by the player screen's content update.
  inventory.setStack(Inventory(p.inventory), slot, s)
  if slot == OffHandSlot or (slot >= 0 and slot < 9): p.syncHandSlot(slot, s)
  else: p.currentScreenHandler.sendContentUpdates()

proc handSlot(p: Player; hand: int): int =
  ## WIT `hand`: left is the off hand, right the selected slot.
  if hand == 0: OffHandSlot else: int(p.inventory.getSelectedSlot())

proc invOf(rep: int): nil Player = playerById(rep div 4)
proc invKind(rep: int): int = rep mod 4

proc invSize(kind: int): int =
  if kind == 2: EnderSize else: MainSize

proc invGet(p: Player; kind, slot: int): ItemStack =
  if slot < 0 or slot >= invSize(kind): return emptyItemStack()
  if kind == 2: inventory.getStack(Inventory(p.enderChestInventory), slot) else: slotOf(p, slot)

proc invPut(p: Player; kind, slot: int; s: ItemStack) =
  if slot < 0 or slot >= invSize(kind): return
  if kind == 2: inventory.setStack(Inventory(p.enderChestInventory), slot, s) else: putSlot(p, slot, s)

proc eyeLook(p: Player): (Vector3[float64], Vector3[float64]) =
  (getEyePos(playerBase(p)), rotationVector(float64(p.pitch), float64(p.yaw)))

proc advOf(id: string): Option[advgen.Advancement] =
  result = advgen.Advancement.fromName(id)
  if result.isNone: result = advgen.Advancement.fromMinecraftName(id)

proc versionName(v: JavaMinecraftVersion): string =
  ## `jmvV1_21_11` -> `v-1-21-11`
  let s = $v
  if s.len > 4 and s.startsWith("jmvV"): "v-" & s[4 ..< s.len].replace("_", "-") else: "unknown"

