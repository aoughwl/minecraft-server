proc statusCode(idx: int; t: CmType): int =
  ## The wire byte of the WIT `entity-status` case `idx`: the generated table has the same names in camelCase (the enum has
  ## holes, so it is a table of its values here).
  let want = t.names[idx].replace("-", "")
  result = 0
  for e in EntityStatusCodes:
    if e[0] == want: result = e[1]

proc uuidOf(v: CVal): Uuid = Uuid(hi: cast[uint64](v.items[0].i), lo: cast[uint64](v.items[1].i))

proc installPlayer3*(r: HostRegistry; w: WitState; ss: StackState; gs: GuiState) =
  # ---- names and chat ----
  hostFn(r, IfacePlayer, "[method]player.set-display-name"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    gDisplayNames[p.entityId] = textAt(w, int(args[1].i))
  hostFn(r, IfacePlayer, "[method]player.delete-message-by-signature"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    var sig: seq[byte] = @[]
    for b in args[1].items: sig.add byte(b.i)
    p.client.writePacketFor(cDeleteChatFromSignature(sig))
  hostFn(r, IfacePlayer, "[method]player.delete-message-by-id"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    p.client.writePacketFor(cDeleteChatFromCacheId(int32(args[1].i)))
  hostFn(r, IfacePlayer, "[method]player.open-book"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    p.client.writePacketFor(COpenBook(hand: (if args[1].i == 1: 0'i32 else: 1'i32)))
  hostFn(r, IfacePlayer, "[method]player.teleport-world"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let target = worldAt(int(args[1].i))
    var yaw = p.yaw
    var pitch = p.pitch
    if args[3].i != 0: yaw = float32(args[3].items[0].f)
    if args[4].i != 0: pitch = float32(args[4].items[0].f)
    if target != nil and target != p.world:
      worldmod.teleportWorld(target, p, posOf(args[2]), some(yaw), some(pitch))
    else:
      playermod.requestTeleport(p, posOf(args[2]), yaw, pitch)
  # ---- gui ----
  hostFn(r, IfacePlayer, "[method]player.open-gui"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let rep = int(args[1].i)
    if not validGui(gs, rep): return "invalid gui resource handle"
    let gui = gs.guis[rep]
    p.incrementScreenHandlerSyncId()
    let h = newPluginScreenHandler(p.screenHandlerSyncId, gui.windowType, gui.inventory, gui.allowGrabItems,
                                   gui.allowPutItems)
    discard p.openHandledScreenDirect(ScreenHandler(h), gui.title)
  # ---- items ----
  hostFn(r, IfacePlayer, "[method]player.get-item-in-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, handSlot(p, int(args[1].i))))
  hostFn(r, IfacePlayer, "[method]player.set-item-in-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, handSlot(p, int(args[1].i)), stackIn(ss, args[2]))
  hostFn(r, IfacePlayer, "[method]player.get-inventory-item"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, invGet(p, 1, int(args[1].i)))
  hostFn(r, IfacePlayer, "[method]player.set-inventory-item"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    invPut(p, 1, int(args[1].i), stackIn(ss, args[2]))
  hostFn(r, IfacePlayer, "[method]player.get-ender-chest-item"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, invGet(p, 2, int(args[1].i)))
  hostFn(r, IfacePlayer, "[method]player.set-ender-chest-item"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    invPut(p, 2, int(args[1].i), stackIn(ss, args[2]))
  hostFn(r, IfacePlayer, "[method]player.clear-ender-chest"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    inventory.clear(Inventory(p.enderChestInventory))
  hostFn(r, IfacePlayer, "[method]player.get-inventory"):
    results.add vInt(args[0].i)
  hostFn(r, IfacePlayer, "[method]player.get-ender-chest"):
    results.add vInt(args[0].i * 4 + 2)
  hostFn(r, IfacePlayer, "[method]player.open-ender-chest"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    # `EnderChestScreenFactory`
    p.incrementScreenHandlerSyncId()
    let h = createGeneric9x3(p.screenHandlerSyncId, p.inventory, Inventory(p.enderChestInventory))
    discard p.openHandledScreenDirect(ScreenHandler(h), translateCross(JAVA_CONTAINER_ENDERCHEST, BEDROCK_CONTAINER_ENDERCHEST))
  # ---- the inventory resources ----
  hostFn(r, IfInventory, "[method]player-inventory.as-inventory"):
    results.add vInt(args[0].i * 4 + 1)
  hostFn(r, IfInventory, "[method]player-inventory.get-item-in-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, handSlot(p, int(args[1].i))))
  hostFn(r, IfInventory, "[method]player-inventory.set-item-in-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, handSlot(p, int(args[1].i)), stackIn(ss, args[2]))
  hostFn(r, IfInventory, "[method]player-inventory.get-selected-slot"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add vInt(int64(p.inventory.getSelectedSlot()))
  hostFn(r, IfInventory, "[method]player-inventory.set-selected-slot"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    if args[1].i >= 0 and args[1].i < 9: p.inventory.setSelectedSlot(uint8(args[1].i))
  # armor and off hand: helmet 39, chestplate 38, leggings 37, boots 36, off hand 40
  hostFn(r, IfInventory, "[method]player-inventory.get-helmet"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, 39))
  hostFn(r, IfInventory, "[method]player-inventory.set-helmet"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, 39, stackIn(ss, args[1]))
  hostFn(r, IfInventory, "[method]player-inventory.get-chestplate"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, 38))
  hostFn(r, IfInventory, "[method]player-inventory.set-chestplate"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, 38, stackIn(ss, args[1]))
  hostFn(r, IfInventory, "[method]player-inventory.get-leggings"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, 37))
  hostFn(r, IfInventory, "[method]player-inventory.set-leggings"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, 37, stackIn(ss, args[1]))
  hostFn(r, IfInventory, "[method]player-inventory.get-boots"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, 36))
  hostFn(r, IfInventory, "[method]player-inventory.set-boots"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, 36, stackIn(ss, args[1]))
  hostFn(r, IfInventory, "[method]player-inventory.get-off-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    results.add stackOpt(ss, slotOf(p, 40))
  hostFn(r, IfInventory, "[method]player-inventory.set-off-hand"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    putSlot(p, 40, stackIn(ss, args[1]))
  hostFn(r, IfInventory, "[method]player-inventory.clear-armor"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    for sl in [39, 38, 37, 36]: putSlot(p, sl, emptyItemStack())
  hostFn(r, IfInventory, "[method]player-inventory.clear-main"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    for sl in 0 ..< MainSize: putSlot(p, sl, emptyItemStack())
  hostFn(r, IfInventory, "[method]player-inventory.clear-all"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    for sl in 0 ..< MainSize: putSlot(p, sl, emptyItemStack())
    for sl in [39, 38, 37, 36, 40]: putSlot(p, sl, emptyItemStack())
  hostFn(r, IfInventory, "[method]inventory.get-size"):
    results.add vInt(int64(invSize(invKind(int(args[0].i)))))
  hostFn(r, IfInventory, "[method]inventory.is-empty"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    var empty = true
    for sl in 0 ..< invSize(invKind(rep)):
      if not invGet(p, invKind(rep), sl).isEmpty(): empty = false
    results.add vBool(empty)
  hostFn(r, IfInventory, "[method]inventory.get-item"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    results.add stackOpt(ss, invGet(p, invKind(rep), int(args[1].i)))
  hostFn(r, IfInventory, "[method]inventory.set-item"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    invPut(p, invKind(rep), int(args[1].i), stackIn(ss, args[2]))
  hostFn(r, IfInventory, "[method]inventory.remove-item"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    let old = invGet(p, invKind(rep), int(args[1].i))
    invPut(p, invKind(rep), int(args[1].i), emptyItemStack())
    results.add stackOpt(ss, old)
  hostFn(r, IfInventory, "[method]inventory.clear"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    for sl in 0 ..< invSize(invKind(rep)): invPut(p, invKind(rep), sl, emptyItemStack())
  hostFn(r, IfInventory, "[method]inventory.get-all-items"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    var l: seq[CVal] = @[]
    for sl in 0 ..< invSize(invKind(rep)): l.add stackOpt(ss, invGet(p, invKind(rep), sl))
    results.add vList(l)
  hostFn(r, IfInventory, "[method]inventory.set-all-items"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    var sl = 0
    while sl < args[1].items.len and sl < invSize(invKind(rep)):
      invPut(p, invKind(rep), sl, stackIn(ss, args[1].items[sl]))
      inc sl
  hostFn(r, IfInventory, "[method]inventory.count-item"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    var total = 0
    for sl in 0 ..< invSize(invKind(rep)):
      let s = invGet(p, invKind(rep), sl)
      if not s.isEmpty() and bareKey(s.item.registryKey) == bareKey(args[1].s): total += int(s.itemCount)
    results.add vInt(int64(total))
  hostFn(r, IfInventory, "[method]inventory.contains-item"):
    let rep = int(args[0].i)
    let p = invOf(rep)
    if p == nil: return gone3()
    var found = false
    for sl in 0 ..< invSize(invKind(rep)):
      let s = invGet(p, invKind(rep), sl)
      if not s.isEmpty() and bareKey(s.item.registryKey) == bareKey(args[1].s): found = true
    results.add vBool(found)
  # ---- status effects ----
  hostFn(r, IfacePlayer, "[method]player.add-effect"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    var et = gStatusEffects[0]
    if not effectOfWit(int(args[1].items[0].i), et): return "unknown status effect"
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    mustLiving(eb).addEffect(Effect(effectType: et, duration: int32(args[1].items[1].i), amplifier: uint8(args[1].items[2].i),
      ambient: args[1].items[3].i != 0, showParticles: args[1].items[4].i != 0, showIcon: args[1].items[5].i != 0, blend: false))
  hostFn(r, IfacePlayer, "[method]player.remove-effect"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    var et = gStatusEffects[0]
    if not effectOfWit(int(args[1].i), et): return "unknown status effect"
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    discard mustLiving(eb).removeEffect(et)
  hostFn(r, IfacePlayer, "[method]player.clear-effects"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    var kinds: seq[StatusEffect] = @[]
    for e in mustLiving(eb).activeEffects: kinds.add e.effectType
    for k in kinds: discard mustLiving(eb).removeEffect(k)
  hostFn(r, IfacePlayer, "[method]player.has-effect"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    var et = gStatusEffects[0]
    if not effectOfWit(int(args[1].i), et): return "unknown status effect"
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    results.add vBool(mustLiving(eb).hasEffect(et))
  hostFn(r, IfacePlayer, "[method]player.get-effect"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    var et = gStatusEffects[0]
    if not effectOfWit(int(args[1].i), et): return "unknown status effect"
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    let e = mustLiving(eb).getEffect(et)
    if e.isSome: results.add vSome(effectVal(e.unsafeGet)) else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.get-active-effects"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let eb = entityById(int(p.entityId))
    if eb == nil or eb.living == nil: return gone3()
    var l: seq[CVal] = @[]
    for e in mustLiving(eb).activeEffects: l.add effectVal(e)
    results.add vList(l)
  # ---- advancements ----
  hostFn(r, IfacePlayer, "[method]player.has-advancement"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var yes = false
    if ta != nil:
      if adv.isSome: yes = ta.hasAdvancement(adv.unsafeGet)
    results.add vBool(yes)
  hostFn(r, IfacePlayer, "[method]player.get-advancement-progress"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var answer = vNone()
    if ta != nil:
      if adv.isSome:
        let pa = ta.advancements
        let pr = pa.progress.getMutOrStartProgress(adv.unsafeGet)
        var done: seq[CVal] = @[]
        var left: seq[CVal] = @[]
        for c in pr.getCompletedCriteria(): done.add vStr(c)
        for c in pr.getRemainingCriteria(): left.add vStr(c)
        answer = vSome(vRecord(@[vStr($adv.unsafeGet), vBool(pr.isDone()), vList(done), vList(left)]))
    results.add answer
  hostFn(r, IfacePlayer, "[method]player.award-advancement-criterion"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var yes = false
    if ta != nil:
      if adv.isSome: yes = ta.advancements.award(adv.unsafeGet, args[2].s)
    results.add vBool(yes)
  hostFn(r, IfacePlayer, "[method]player.revoke-advancement-criterion"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var yes = false
    if ta != nil:
      if adv.isSome: yes = ta.advancements.revoke(adv.unsafeGet, args[2].s)
    results.add vBool(yes)
  hostFn(r, IfacePlayer, "[method]player.award-advancement"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var any = false
    if ta != nil:
      if adv.isSome:
        let pa = ta.advancements
        for c in pa.progress.getMutOrStartProgress(adv.unsafeGet).getRemainingCriteria():
          if pa.award(adv.unsafeGet, c): any = true
    results.add vBool(any)
  hostFn(r, IfacePlayer, "[method]player.revoke-advancement"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let adv = advOf(args[1].s)
    let ta = p.advancements
    var any = false
    if ta != nil:
      if adv.isSome:
        let pa = ta.advancements
        for c in pa.progress.getMutOrStartProgress(adv.unsafeGet).getCompletedCriteria():
          if pa.revoke(adv.unsafeGet, c): any = true
    results.add vBool(any)
  hostFn(r, IfacePlayer, "[method]player.get-completed-advancements"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let ta = p.advancements
    var l: seq[CVal] = @[]
    if ta != nil:
      let pa = ta.advancements
      var i = 0
      while i < pa.progress.keys.len:
        if pa.progress.values[i].isDone(): l.add vStr($pa.progress.keys[i])
        inc i
    results.add vList(l)
  hostFn(r, IfacePlayer, "[method]player.get-selected-advancement-tab"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let ta = p.advancements
    var answer = vNone()
    if ta != nil:
      let pa = ta.advancements
      if pa.lastSelectedTab.isSome: answer = vSome(vStr($pa.lastSelectedTab.unsafeGet))
    results.add answer
  hostFn(r, IfacePlayer, "[method]player.set-selected-advancement-tab"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let ta = p.advancements
    if ta != nil:
      let pa = ta.advancements
      if args[1].i != 0: pa.setSelectedTab(advOf(args[1].items[0].s))
      else: pa.setSelectedTab(none[advgen.Advancement]())
  # ---- ray tracing and projectiles ----
  hostFn(r, IfacePlayer, "[method]player.ray-trace-block"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let (eye, look) = eyeLook(p)
    let h = traceBlock(p.world, eye, look, args[1].f, args[2].i != 0)
    if h.found: results.add vSome(vRecord(@[blockPosVal(h.pos), vInt(int64(faceIndex(h.face))), vPos(h.hit)]))
    else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.get-target-block-exact"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let (eye, look) = eyeLook(p)
    let h = traceBlock(p.world, eye, look, args[1].f, args[2].i != 0)
    if h.found: results.add vSome(vRecord(@[blockPosVal(h.pos), vInt(int64(faceIndex(h.face))), vPos(h.hit)]))
    else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.get-target-block"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let (eye, look) = eyeLook(p)
    let h = traceBlock(p.world, eye, look, float64(args[1].i), false)
    if h.found:
      results.add vSome(vPos(Vector3[float64](x: float64(h.pos.vec.x), y: float64(h.pos.vec.y), z: float64(h.pos.vec.z))))
    else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.ray-trace-entity"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let (eye, look) = eyeLook(p)
    let h = traceEntity(p.world, playerBase(p), eye, look, args[1].f)
    let he = h.entity
    if he != nil: results.add vSome(vRecord(@[vInt(int64(he.entity.entityId)), vPos(h.hit), vFloat(h.distance)]))
    else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.get-target-entity"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let (eye, look) = eyeLook(p)
    let h = traceEntity(p.world, playerBase(p), eye, look, args[1].f)
    let he = h.entity
    if he != nil: results.add vSome(vInt(int64(he.entity.entityId)))
    else: results.add vNone()
  hostFn(r, IfacePlayer, "[method]player.launch-projectile"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    let shooter = playerBase(p).entity
    let world = p.world
    var spawned: nil EntityBase = nil
    # projectile-type: arrow, snowball, egg, ender-pearl, splash-potion, fireball, small-fireball, trident, wind-charge
    case int(args[1].i)
    of 1:
      let sb = newSnowballShot(newEntity(world, p.pos, EntityType.SNOWBALL), shooter)
      sb.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(sb)
    of 2:
      let egg = newEggShot(newEntity(world, p.pos, EntityType.EGG), shooter)
      egg.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(egg)
    of 3:
      let pearl = newEnderPearlShot(newEntity(world, p.pos, EntityType.ENDER_PEARL), shooter)
      pearl.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(pearl)
    of 5:
      let fb = newFireballShot(newEntity(world, p.pos, EntityType.FIREBALL), shooter)
      fb.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(fb)
    of 6:
      let fb = newSmallFireballShot(newEntity(world, p.pos, EntityType.SMALL_FIREBALL), shooter)
      fb.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(fb)
    of 8:
      let wc = newWindChargeShot(newEntity(world, p.pos, EntityType.WIND_CHARGE), shooter)
      wc.setVelocityFrom(shooter, p.pitch, p.yaw, 0.0'f32, ThrowSpeed, 1.0'f32)
      spawned = projectileBase(wc)
    else: discard
    if spawned == nil:
      results.add vNone()
    else:
      spawnEntity(world, spawned)
      results.add vSome(vInt(int64(spawned.entity.entityId)))
  # ---- bedrock-player (a Bedrock client is a `Player` with a ghost Java client; its session is bedrockplay.aowl's) ----
  hostFn(r, IfacePlayer, "[method]player.as-bedrock"):
    let p = playerById(int(args[0].i))
    if p == nil: return gone3()
    # `gPluginBedrockSessionHook` answers whether the player is on Bedrock
    if callPluginBedrockSessionHook(p): results.add vSome(vInt(args[0].i))
    else: results.add vNone()
  # ---- bedrock-player abilities and status flags, and the player interface's `get-world-players` ----
  hostFn(r, IfacePlayer, "get-world-players"):
    # `world.players`: every player of the world, as player handles (the entity id)
    let wr = int(args[0].i)
    let srv = gLink.server
    if srv == nil or wr < 0 or wr >= srv.worlds.len: return "invalid world resource handle"
    var items: seq[CVal] = @[]
    for p in srv.worlds[wr].players: items.add vInt(int64(p.entityId))
    results.add vList(items)
  hostFn(r, IfacePlayer, "[method]bedrock-player.get-ability"):
    let p = playerById(int(args[0].i))
