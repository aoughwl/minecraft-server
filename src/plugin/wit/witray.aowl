## Ray tracing for the `player` and `entity` host interfaces (ray-trace-block, ray-trace-entity, get-target-entity,
## get-target-block, raycast). Port of the helpers the newer tree's pumpkin-wasm-host-v0_1 (player.rs, entity.rs) builds
## on `World::raycast` and `World::get_entities_at_box`: a block hit is the first non-air block (fluid blocks only when
## asked) along the eye's look vector, an entity hit is the nearest bounding box the segment enters.
## PARTIAL: pumpkin-wasm-host-v0_1/src/entity.rs (ray tracing) - `hit-pos` of a block hit is where the ray meets the
## hit face's plane of the full cube (`World::raycast` only answers the block and the face).
import std/[options, strutils]
import ../wasm/canonabi
import ../../util/vector3
import ../../util/math/[position, boundingbox]
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/entity/raycast
import ../../server/entity/projectile/thrown
import ../../server/world/worldmod

type
  BlockHit* = object
    found*: bool
    pos*: BlockPos
    face*: int                 ## `ord` of the WIT `block-direction`: down, up, north, south, west, east
    hit*: Vector3[float64]

  EntityHit* = object
    entity*: nil EntityBase
    hit*: Vector3[float64]
    distance*: float64

proc isFluidName(name: string): bool =
  name.endsWith("water") or name.endsWith("lava")

proc isAirName(name: string): bool =
  name.endsWith("air")

proc traceBlock*(world: World; eye, look: Vector3[float64]; maxDistance: float64; includeFluids: bool): BlockHit =
  result = BlockHit(found: false, pos: newBlockPos(0'i32, 0'i32, 0'i32), face: 1,
                    hit: Vector3[float64](x: 0.0, y: 0.0, z: 0.0))
  let endPos = Vector3[float64](x: eye.x + look.x * maxDistance, y: eye.y + look.y * maxDistance, z: eye.z + look.z * maxDistance)
  let inc0 = includeFluids
  let r = world.raycast(eye, endPos, proc (p: BlockPos; w: World): bool {.closure.} =
    let name = dataBlockOf(uint32(w.getBlockStateId(p))).name
    if isAirName(name): return false
    if isFluidName(name) and not inc0: return false
    true)
  if r.isNone: return
  let (bp, face) = r.unsafeGet
  result.found = true
  result.pos = bp
  result.face = ord(face)
  # where the ray meets the plane of the hit face
  var plane = 0.0
  var t = 0.0
  case ord(face)
  of 4:
    plane = float64(bp.vec.x)
    if look.x != 0.0: t = (plane - eye.x) / look.x
  of 5:
    plane = float64(bp.vec.x) + 1.0
    if look.x != 0.0: t = (plane - eye.x) / look.x
  of 0:
    plane = float64(bp.vec.y)
    if look.y != 0.0: t = (plane - eye.y) / look.y
  of 1:
    plane = float64(bp.vec.y) + 1.0
    if look.y != 0.0: t = (plane - eye.y) / look.y
  of 2:
    plane = float64(bp.vec.z)
    if look.z != 0.0: t = (plane - eye.z) / look.z
  of 3:
    plane = float64(bp.vec.z) + 1.0
    if look.z != 0.0: t = (plane - eye.z) / look.z
  else: discard
  result.hit = Vector3[float64](x: eye.x + look.x * t, y: eye.y + look.y * t, z: eye.z + look.z * t)

proc traceEntity*(world: World; self: nil EntityBase; eye, look: Vector3[float64]; maxDistance: float64): EntityHit =
  result = EntityHit(entity: nil, hit: eye, distance: maxDistance)
  let seg = Vector3[float64](x: look.x * maxDistance, y: look.y * maxDistance, z: look.z * maxDistance)
  let endPos = Vector3[float64](x: eye.x + seg.x, y: eye.y + seg.y, z: eye.z + seg.z)
  let box = BoundingBox(
    min: Vector3[float64](x: min(eye.x, endPos.x) - 1.0, y: min(eye.y, endPos.y) - 1.0, z: min(eye.z, endPos.z) - 1.0),
    max: Vector3[float64](x: max(eye.x, endPos.x) + 1.0, y: max(eye.y, endPos.y) + 1.0, z: max(eye.z, endPos.z) + 1.0))
  var best = 2.0
  for e in world.getEntitiesAtBox(box):
    if self != nil and e.entity.entityId == self.entity.entityId: continue
    if e.isSpectator() or not e.canHit(): continue
    let t = calculateRayIntersection(eye, seg, e.entity.boundingBox)
    if t.isSome and t.unsafeGet < best:
      best = t.unsafeGet
      result.entity = e
      result.distance = t.unsafeGet * maxDistance
      result.hit = Vector3[float64](x: eye.x + seg.x * best, y: eye.y + seg.y * best, z: eye.z + seg.z * best)

proc faceIndex*(d: int): int = d

proc blockPosVal*(p: BlockPos): CVal = vRecord(@[vInt(int64(p.vec.x)), vInt(int64(p.vec.y)), vInt(int64(p.vec.z))])
