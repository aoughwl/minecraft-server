## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/recipe.rs: the `recipe-manager` resource (`register-shaped`,
## `register-shapeless`, `register-cooking`). Each builds an `OwnedCraftingRecipe` / `OwnedCookingRecipe` from the WIT
## record, taking the result item and count from the `item-stack` handle (witstack.aowl), and hands it to
## `RecipeHooks.addRecipe`, which pluginwire2.aowl points at `server.recipeManager.addRecipe` (src/server/recipe.aowl).
## As upstream the category is always Misc ("TODO: Allow specifying category"), a shaped recipe always shows its
## notification, a key's symbol is the first character of its string (a space when empty), and `ingredient::tag` /
## `item` become `Tagged` / `Simple` (`one-of` of the newer WIT becomes `OneOf`). The recipe manager handle's rep is
## ignored (there is one manager), and a cooking recipe is stored under the `id` the plugin gave.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/recipe.rs - the recipe id of the shaped and shapeless
## registrations is not kept (upstream drops it too, `_id`); a recipe registered after clients joined reaches them only at
## their next join (the recipe book packet is sent on join).
import ../../util/closureset
import std/options
import ../wasm/[canonabi, component]
import "../../protocol/recipe"
import witstate, witstack

const
  IfRecipe = "pumpkin:plugin/recipe"

type
  RecipeHooks* = ref object
    addRecipe*: proc (recipe: DynamicRecipe) {.closure.}

  RecipeState* = ref object
    hooks*: RecipeHooks

proc newRecipeState*(): RecipeState = RecipeState(hooks: RecipeHooks())

proc ingredientOf(v: CVal): OwnedRecipeIngredient =
  ## `to_owned_ingredient`: `item(string) | tag(string) | one-of(list<string>)`.
  case int(v.i)
  of 0: OwnedRecipeIngredient(kind: oriSimple, id: v.items[0].s)
  of 1: OwnedRecipeIngredient(kind: oriTagged, tag: v.items[0].s)
  else:
    var ids: seq[string] = @[]
    for it in v.items[0].items: ids.add it.s
    OwnedRecipeIngredient(kind: oriOneOf, ids: ids)

proc groupOf(v: CVal): Option[string] =
  if v.i != 0: some(v.items[0].s) else: none[string]()

proc resultOf(ss: StackState; rep: int; res: var OwnedRecipeResult): bool =
  if not validStack(ss, rep): return false
  res = OwnedRecipeResult(itemId: ss.items[rep].item.registryKey, count: ss.items[rep].itemCount)
  true

proc hkAddRecipe(hk: RecipeHooks; recipe: DynamicRecipe) =
  hk.addRecipe(recipe)

proc installRecipe*(r: HostRegistry; rs: RecipeState; ss: StackState) =
  let hk = rs.hooks
  witFn(r, IfRecipe, "[method]recipe-manager.register-shaped"):
    # args: self, id, shaped-recipe{pattern, key, output, group, category, show-notification}
    let v = args[2]
    var res = OwnedRecipeResult()
    if not resultOf(ss, int(v.items[2].i), res): return "item-stack: invalid handle"
    if not closureSet(hk.addRecipe): return "Server not available"
    var keys: seq[RecipeKeyEntry] = @[]
    for e in v.items[1].items:
      let k = e.items[0].s
      keys.add RecipeKeyEntry(symbol: (if k.len > 0: k[0] else: ' '), ingredient: ingredientOf(e.items[1]))
    var pattern: seq[string] = @[]
    for p in v.items[0].items: pattern.add p.s
    hkAddRecipe(hk, DynamicRecipe(kind: drCrafting, crafting: OwnedCraftingRecipe(category: rcMisc, group: groupOf(v.items[3]),
      result: res, kind: ocrShaped, showNotification: true, key: keys, pattern: pattern)))
  witFn(r, IfRecipe, "[method]recipe-manager.register-shapeless"):
    let v = args[2]
    var res = OwnedRecipeResult()
    if not resultOf(ss, int(v.items[1].i), res): return "item-stack: invalid handle"
    if not closureSet(hk.addRecipe): return "Server not available"
    var ings: seq[OwnedRecipeIngredient] = @[]
    for it in v.items[0].items: ings.add ingredientOf(it)
    hkAddRecipe(hk, DynamicRecipe(kind: drCrafting, crafting: OwnedCraftingRecipe(category: rcMisc, group: groupOf(v.items[2]),
      result: res, kind: ocrShapeless, ingredients: ings)))
  witFn(r, IfRecipe, "[method]recipe-manager.register-cooking"):
    # args: self, id, station-type (smelting | blasting | smoking | campfire), cooking-recipe{ingredient, output,
    # experience, cooking-time, group, category}
    let v = args[3]
    var res = OwnedRecipeResult()
    if not resultOf(ss, int(v.items[1].i), res): return "item-stack: invalid handle"
    if not closureSet(hk.addRecipe): return "Server not available"
    let cooking = OwnedCookingRecipe(recipeId: args[1].s, category: rcMisc, group: groupOf(v.items[4]),
      ingredient: ingredientOf(v.items[0]), cookingTime: int32(v.items[3].i), experience: float32(v.items[2].f), result: res)
    var kind = ockSmelting
    case int(args[2].i)
    of 0: kind = ockSmelting
    of 1: kind = ockBlasting
    of 2: kind = ockSmoking
    else: kind = ockCampfireCooking
    hkAddRecipe(hk, DynamicRecipe(kind: drCooking, cooking: OwnedCookingRecipeType(kind: kind, recipe: cooking)))
