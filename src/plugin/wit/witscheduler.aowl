## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/scheduler.rs: schedule-delayed-task, schedule-repeating-task
## and cancel-task over the server's `TaskScheduler` (src/server/scheduler.aowl). The tick count is the server's
## (`hooks.tickCount`); the tasks that fall due are handed to the plugin's `handle-task` export by pluginhost.aowl's
## `runTask`, which pluginmgr calls for each due task of the server tick.
import ../wasm/[canonabi, component]
import ../../server/scheduler
import witstate

const IfSched = "pumpkin:plugin/scheduler"

proc nowTick(st: WitState): uint64 =
  if st.hooks.tickCount != nil: st.hooks.tickCount() else: 0'u64

proc installScheduler*(r: HostRegistry; st: WitState) =
  witFn(r, IfSched, "schedule-delayed-task"):
    let id = scheduleDelayedTask(st.sched, ci.user, uint32(args[0].i), uint64(args[1].i), nowTick(st))
    results.add vInt(int64(id))
  witFn(r, IfSched, "schedule-repeating-task"):
    let id = scheduleRepeatingTask(st.sched, ci.user, uint32(args[0].i), uint64(args[1].i), uint64(args[2].i), nowTick(st))
    results.add vInt(int64(id))
  witFn(r, IfSched, "cancel-task"):
    cancelTask(st.sched, TaskId(args[0].i))
