## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/scoreboard.rs: the `scoreboard` resource. A handle's rep is
## the index of the world whose scoreboard it is (upstream's `ScoreboardResource { provider: Arc<World> }`; `world.get-scoreboard`
## makes the handle). Every mutation is a `ScoreboardHooks` call, which pluginwire2.aowl runs against the world's
## `Scoreboard` (src/server/world/scoreboard.aowl: objectives, scores, teams and the packets that go with them).
## `map_team_settings` is `teamOf`: options bit 0x01 friendly fire, 0x02 see friendly invisibles are the hook's, the WIT
## enums (nametag-visibility, collision-rule, named-color, display-slot) keep their ordinals, which are the server's.
## `add-score` and the queries are the newer WIT's (the pinned Rust has add_objective, remove_objective, set_display_slot,
## update_score, remove_score, create_team, remove_team, update_team, add_player_to_team, remove_player_from_team): the
## number-format option of `add-objective` / `update-objective` / `update-score` is read when the plugin's own function
## type carries it.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/scoreboard.rs - `bedrock-scoreboard` (the Bedrock packets)
## is not provided and traps; `World` holds no scoreboard here, so the one plugins use is the plugin host's own per world
## and is not the one the /scoreboard command edits (pluginwire2.aowl); a dropped scoreboard handle frees nothing.
import ../wasm/[canonabi, component]
import ../../util/text/text
import witstate

const
  IfSb = "pumpkin:plugin/scoreboard"

type
  NumFmt* = object
    kind*: int                  ## 0 none, 1 blank, 2 fixed
    fixed*: TextComponent

  SbTeam* = object
    name*: string
    displayName*: TextComponent
    friendlyFire*: bool
    seeFriendlyInvisibles*: bool
    nametagVisibility*: int
    collisionRule*: int
    color*: int
    prefix*: TextComponent
    suffix*: TextComponent
    players*: seq[string]

  ScoreboardHooks* = ref object
    addObjective*: proc (world: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) {.closure.}
    updateObjective*: proc (world: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) {.closure.}
    removeObjective*: proc (world: int; name: string) {.closure.}
    setDisplaySlot*: proc (world: int; slot: int; objective: string) {.closure.}
    clearDisplaySlot*: proc (world: int; slot: int) {.closure.}
    updateScore*: proc (world: int; entity, objective: string; value: int; fmt: NumFmt) {.closure.}
    getScore*: proc (world: int; entity, objective: string; value: var int): bool {.closure.}
    removeScore*: proc (world: int; entity, objective: string) {.closure.}
    resetEntityScores*: proc (world: int; entity: string) {.closure.}
    createTeam*: proc (world: int; team: SbTeam) {.closure.}
    updateTeam*: proc (world: int; team: SbTeam) {.closure.}
    removeTeam*: proc (world: int; name: string) {.closure.}
    addPlayerToTeam*: proc (world: int; team, player: string) {.closure.}
    removePlayerFromTeam*: proc (world: int; team, player: string) {.closure.}
    clearTeamPlayers*: proc (world: int; team: string) {.closure.}
    teams*: proc (world: int): seq[SbTeam] {.closure.}

  ScoreboardState* = ref object
    hooks*: ScoreboardHooks

proc newScoreboardState*(): ScoreboardState = ScoreboardState(hooks: ScoreboardHooks())

proc numFmtOf(st: WitState; v: CVal): NumFmt =
  ## `option<number-format>`; `number-format` is `blank | fixed(text-component)`.
  result = NumFmt(kind: 0, fixed: text(""))
  if v.i != 0 and v.items.len > 0:
    let f = v.items[0]
    if f.i == 0: result.kind = 1
    else:
      result.kind = 2
      if f.items.len > 0: result.fixed = textAt(st, int(f.items[0].i))

proc teamOf(st: WitState; name: string; v: CVal): SbTeam =
  ## `map_team_settings`: the record of `team-settings`.
  SbTeam(name: name, displayName: textAt(st, int(v.items[0].i)), friendlyFire: v.items[1].i != 0,
         seeFriendlyInvisibles: v.items[2].i != 0, nametagVisibility: int(v.items[3].i), collisionRule: int(v.items[4].i),
         color: int(v.items[5].i), prefix: textAt(st, int(v.items[6].i)), suffix: textAt(st, int(v.items[7].i)), players: @[])

proc teamVal(st: WitState; t: SbTeam): CVal =
  vRecord(@[vInt(int64(newTextRep(st, t.displayName))), vBool(t.friendlyFire), vBool(t.seeFriendlyInvisibles),
            vInt(int64(t.nametagVisibility)), vInt(int64(t.collisionRule)), vInt(int64(t.color)),
            vInt(int64(newTextRep(st, t.prefix))), vInt(int64(newTextRep(st, t.suffix)))])

proc hkAddObjective(hk: ScoreboardHooks; world: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) =
  hk.addObjective(world, name, title, renderType, fmt)

proc hkAddPlayerToTeam(hk: ScoreboardHooks; world: int; team, player: string) =
  hk.addPlayerToTeam(world, team, player)

proc hkClearDisplaySlot(hk: ScoreboardHooks; world: int; slot: int) =
  hk.clearDisplaySlot(world, slot)

proc hkClearTeamPlayers(hk: ScoreboardHooks; world: int; team: string) =
  hk.clearTeamPlayers(world, team)

proc hkCreateTeam(hk: ScoreboardHooks; world: int; team: SbTeam) =
  hk.createTeam(world, team)

proc hkGetScore(hk: ScoreboardHooks; world: int; entity, objective: string; value: var int): bool =
  let res = hk.getScore(world, entity, objective, value)
  res

proc hkRemoveObjective(hk: ScoreboardHooks; world: int; name: string) =
  hk.removeObjective(world, name)

proc hkRemovePlayerFromTeam(hk: ScoreboardHooks; world: int; team, player: string) =
  hk.removePlayerFromTeam(world, team, player)

proc hkRemoveScore(hk: ScoreboardHooks; world: int; entity, objective: string) =
  hk.removeScore(world, entity, objective)

proc hkRemoveTeam(hk: ScoreboardHooks; world: int; name: string) =
  hk.removeTeam(world, name)

proc hkResetEntityScores(hk: ScoreboardHooks; world: int; entity: string) =
  hk.resetEntityScores(world, entity)

proc hkSetDisplaySlot(hk: ScoreboardHooks; world: int; slot: int; objective: string) =
  hk.setDisplaySlot(world, slot, objective)

proc hkTeams(hk: ScoreboardHooks; world: int): seq[SbTeam] =
  let res = hk.teams(world)
  res

proc hkUpdateObjective(hk: ScoreboardHooks; world: int; name: string; title: TextComponent; renderType: int; fmt: NumFmt) =
  hk.updateObjective(world, name, title, renderType, fmt)

proc hkUpdateScore(hk: ScoreboardHooks; world: int; entity, objective: string; value: int; fmt: NumFmt) =
  hk.updateScore(world, entity, objective, value, fmt)

proc hkUpdateTeam(hk: ScoreboardHooks; world: int; team: SbTeam) =
  hk.updateTeam(world, team)

proc installScoreboard*(r: HostRegistry; st: WitState; sb: ScoreboardState) =
  let hk = sb.hooks
  witFn(r, IfSb, "[method]scoreboard.add-objective"):
    if hk.addObjective == nil: return "scoreboard: no server"
    let fmt = (if args.len > 4: numFmtOf(st, args[4]) else: NumFmt(kind: 0, fixed: text("")))
    hkAddObjective(hk, int(args[0].i), args[1].s, textAt(st, int(args[2].i)), int(args[3].i), fmt)
  witFn(r, IfSb, "[method]scoreboard.update-objective"):
    if hk.updateObjective == nil: return "scoreboard: no server"
    let fmt = (if args.len > 4: numFmtOf(st, args[4]) else: NumFmt(kind: 0, fixed: text("")))
    hkUpdateObjective(hk, int(args[0].i), args[1].s, textAt(st, int(args[2].i)), int(args[3].i), fmt)
  witFn(r, IfSb, "[method]scoreboard.remove-objective"):
    if hk.removeObjective == nil: return "scoreboard: no server"
    hkRemoveObjective(hk, int(args[0].i), args[1].s)
  witFn(r, IfSb, "[method]scoreboard.set-display-slot"):
    if hk.setDisplaySlot == nil: return "scoreboard: no server"
    hkSetDisplaySlot(hk, int(args[0].i), int(args[1].i), args[2].s)
  witFn(r, IfSb, "[method]scoreboard.clear-display-slot"):
    if hk.clearDisplaySlot == nil: return "scoreboard: no server"
    hkClearDisplaySlot(hk, int(args[0].i), int(args[1].i))
  witFn(r, IfSb, "[method]scoreboard.update-score"):
    if hk.updateScore == nil: return "scoreboard: no server"
    let fmt = (if args.len > 4: numFmtOf(st, args[4]) else: NumFmt(kind: 0, fixed: text("")))
    hkUpdateScore(hk, int(args[0].i), args[1].s, args[2].s, int(int32(args[3].i)), fmt)
  witFn(r, IfSb, "[method]scoreboard.add-score"):
    if hk.updateScore == nil or hk.getScore == nil: return "scoreboard: no server"
    var cur = 0
    discard hkGetScore(hk, int(args[0].i), args[1].s, args[2].s, cur)
    let nv = int(int32(cur + int(int32(args[3].i))))
    hkUpdateScore(hk, int(args[0].i), args[1].s, args[2].s, nv, NumFmt(kind: 0, fixed: text("")))
    results.add vInt(int64(nv))
  witFn(r, IfSb, "[method]scoreboard.remove-score"):
    if hk.removeScore == nil: return "scoreboard: no server"
    hkRemoveScore(hk, int(args[0].i), args[1].s, args[2].s)
  witFn(r, IfSb, "[method]scoreboard.reset-entity-scores"):
    if hk.resetEntityScores == nil: return "scoreboard: no server"
    hkResetEntityScores(hk, int(args[0].i), args[1].s)
  witFn(r, IfSb, "[method]scoreboard.create-team"):
    if hk.createTeam == nil: return "scoreboard: no server"
    hkCreateTeam(hk, int(args[0].i), teamOf(st, args[1].s, args[2]))
  witFn(r, IfSb, "[method]scoreboard.remove-team"):
    if hk.removeTeam == nil: return "scoreboard: no server"
    hkRemoveTeam(hk, int(args[0].i), args[1].s)
  witFn(r, IfSb, "[method]scoreboard.update-team"):
    if hk.updateTeam == nil: return "scoreboard: no server"
    hkUpdateTeam(hk, int(args[0].i), teamOf(st, args[1].s, args[2]))
  witFn(r, IfSb, "[method]scoreboard.add-player-to-team"):
    if hk.addPlayerToTeam == nil: return "scoreboard: no server"
    hkAddPlayerToTeam(hk, int(args[0].i), args[1].s, args[2].s)
  witFn(r, IfSb, "[method]scoreboard.remove-player-from-team"):
    if hk.removePlayerFromTeam == nil: return "scoreboard: no server"
    hkRemovePlayerFromTeam(hk, int(args[0].i), args[1].s, args[2].s)
  witFn(r, IfSb, "[method]scoreboard.clear-team-players"):
    if hk.clearTeamPlayers == nil: return "scoreboard: no server"
    hkClearTeamPlayers(hk, int(args[0].i), args[1].s)
  witFn(r, IfSb, "[method]scoreboard.get-teams"):
    if hk.teams == nil: return "scoreboard: no server"
    var names: seq[CVal] = @[]
    let ts = hkTeams(hk, int(args[0].i))
    var i = 0
    while i < ts.len:
      names.add vStr(ts[i].name)
      inc i
    results.add vList(names)
  witFn(r, IfSb, "[method]scoreboard.get-team"):
    if hk.teams == nil: return "scoreboard: no server"
    let ts = hkTeams(hk, int(args[0].i))
    var found = -1
    var i = 0
    while i < ts.len:
      if ts[i].name == args[1].s: found = i
      inc i
    if found < 0: results.add vNone()
    else: results.add vSome(teamVal(st, ts[found]))
  witFn(r, IfSb, "[method]scoreboard.get-team-players"):
    if hk.teams == nil: return "scoreboard: no server"
    let ts = hkTeams(hk, int(args[0].i))
    var xs: seq[CVal] = @[]
    var i = 0
    while i < ts.len:
      if ts[i].name == args[1].s:
        for p in ts[i].players: xs.add vStr(p)
      inc i
    results.add vList(xs)
  witFn(r, IfSb, "[method]scoreboard.get-player-team"):
    if hk.teams == nil: return "scoreboard: no server"
    let ts = hkTeams(hk, int(args[0].i))
    var found = ""
    var any = false
    var i = 0
    while i < ts.len:
      for p in ts[i].players:
        if p == args[1].s and not any:
          found = ts[i].name
          any = true
      inc i
    if any: results.add vSome(vStr(found))
    else: results.add vNone()
