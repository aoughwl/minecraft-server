## What the player, entity and event host interfaces share: the link to the real `Server`, the lookups from a resource
## rep to the server's objects, and the `hostFn` template. Port of the resource tables of
## pumpkin/src/plugin/loader/wasm/wasm_host/state.rs (`PluginHostState::{add_player, add_entity, add_world}` and the
## `consume_player`/`consume_world` calls in wit/v0_1/events/mod.rs): a resource's `rep` is what a handle holds here.
##
##   player          rep = the entity id of the player (`Player.entityId`), found again in the server's worlds
##   entity          rep = the entity id (players included: `getEntityById` finds both)
##   world           rep = the index of the world in `server.worlds`
##   text-component  rep = the arena slot of witstate.aowl (`newTextRep`/`textAt`)
##
## Handles are never freed (the Rust host keeps them in the wasmtime table until the plugin drops them): the arenas are
## tick-long here and `[resource-drop]` is a no-op.
import std/[strutils]
import ../wasm/[component, canonabi]
import ../../server/serverbase
import ../../server/entity/entitymod
import ../../server/entity/player as playermod
import ../../util/text/text
import ../../util/vector3
import witstate

const
  IfaceText* = "pumpkin:plugin/text"
  IfacePlayer* = "pumpkin:plugin/player"
  IfaceEntity* = "pumpkin:plugin/world"       ## the `entity` resource lives in world.wit; entity.wit only re-exports it

type
  ServerLink* = ref object
    server*: nil Server                   ## nil in unit tests
    sendSystemMessage*: proc (player: Player; message: TextComponent; overlay: bool) {.closure.}
      ## The seam player.send-system-message goes through (a test replaces it; the default writes the packet).

proc newServerLink*(): ServerLink =
  result = ServerLink(server: nil)
  result.sendSystemMessage = proc (player: Player; message: TextComponent; overlay: bool) {.closure.} =
    playermod.sendSystemMessageRaw(player, message, overlay)

var gLink* = newServerLink()

template hostFn*(r: HostRegistry; iface, fname: string; body: untyped) =
  ## One host function: `args` are the lifted parameters, push results onto `results`, `return "<why>"` traps.
  r.defineHostFn(iface, fname, proc (ci {.inject.}: CompInst; args {.inject.}: seq[CVal];
      results {.inject.}: var seq[CVal]): string {.closure.} =
    result = ""
    body)

# ---- server objects ------------------------------------------------------------------------------

proc playerById*(id: int): nil Player =
  let srv = gLink.server
  if srv == nil: return nil
  for w in srv.worlds:
    for p in w.players:
      if int(p.entityId) == id: return p
  nil

proc entityById*(id: int): nil EntityBase =
  let srv = gLink.server
  if srv == nil: return nil
  for w in srv.worlds:
    let e = getEntityById(w, int32(id))
    if e != nil: return e
  nil

proc worldRep*(w: World): int =
  result = 0
  let srv = gLink.server
  if srv == nil: return
  var i = 0
  while i < srv.worlds.len:
    if srv.worlds[i] == w: return i
    inc i

proc worldAt*(rep: int): nil World =
  let srv = gLink.server
  if srv == nil or rep < 0 or rep >= srv.worlds.len: return nil
  srv.worlds[rep]

# ---- value helpers -------------------------------------------------------------------------------

proc vPos*(v: Vector3[float64]): CVal = vRecord(@[vFloat(v.x), vFloat(v.y), vFloat(v.z)])
proc posOf*(v: CVal): Vector3[float64] =
  Vector3[float64](x: v.items[0].f, y: v.items[1].f, z: v.items[2].f)

proc u64Val*(u: uint64): CVal = vInt(cast[int64](u))

proc kebab*(s: string): string =
  ## `ZOMBIE_VILLAGER` or `zombie_villager` -> `zombie-villager`: how WIT spells an enum case.
  result = s.toLowerAscii().replace("_", "-")

proc enumIndex*(t: CmType; name: string): int =
  ## The case of enum type `t` called `name` (kebab-case), or 0 when the enum has no such case.
  let i = caseIndex(t, kebab(name))
  if i >= 0: i else: 0

proc enumName*(t: CmType; i: int): string =
  if i >= 0 and i < t.names.len: t.names[i] else: ""

proc paramTy*(ci: CompInst; i: int): CmType = ci.sigs[ci.funcs[ci.curFn].sig].params[i]
proc resultTy*(ci: CompInst): CmType = ci.sigs[ci.funcs[ci.curFn].sig].results[0]
