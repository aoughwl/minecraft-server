## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/server.rs: the `server` resource (the handle's rep is
## ignored, there is one server) over `WitState.hooks`. Players cross the boundary as their entity id, worlds as their
## index in `server.worlds` (the same reps part 1 uses for `player` and `world`).
## The op/ban/whitelist/enchantment/datapack managers, create-world and the rest are witsrv2.aowl. `broadcast` carries no
## sender name or chat type. `get-sys-info` answers real values (cores, RAM and the OS from server/crash.aowl's
## `querySystem`) without the plugin's `sys.info` permission gate.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/server.rs - see witsrv2.aowl for the datapack manager.
import ../../util/closureset
import std/[options]
import ../wasm/[canonabi, component]
import ../../util/text/text
import ../../command/[cmdsource, cmddispatch]
import ../../protocol/proto
import ../../protocol/java/client/play/[tab_list, server_links]
import ../../server/serverbase
import ../../server/net/java/javamod
import ../../server/commandbridge
import ../../server/crash
import witstate, witserver

const IfServer = "pumpkin:plugin/server"

proc installServer*(r: HostRegistry; st: WitState) =
  witFn(r, IfServer, "[method]server.get-difficulty"):
    results.add vInt(int64(hkServerInfo(st.hooks).difficulty))
  witFn(r, IfServer, "[method]server.get-player-count"):
    results.add vInt(int64(hkPlayerIds(st.hooks).len))
  witFn(r, IfServer, "[method]server.get-mspt"):
    results.add vFloat(hkServerInfo(st.hooks).mspt)
  witFn(r, IfServer, "[method]server.get-tps"):
    results.add vFloat(hkServerInfo(st.hooks).tps)
  witFn(r, IfServer, "[method]server.get-all-players"):
    var items: seq[CVal] = @[]
    let ids = hkPlayerIds(st.hooks)
    for p in ids: items.add vInt(int64(p))
    results.add vList(items)
  witFn(r, IfServer, "[method]server.get-player-by-name"):
    let p = hkPlayerByName(st.hooks, args[1].s)
    if p < 0: results.add vNone()
    else: results.add vSome(vInt(int64(p)))
  witFn(r, IfServer, "[method]server.get-player-by-uuid"):
    let p = hkPlayerByUuid(st.hooks, cast[uint64](args[1].items[0].i), cast[uint64](args[1].items[1].i))
    if p < 0: results.add vNone()
    else: results.add vSome(vInt(int64(p)))
  witFn(r, IfServer, "[method]server.get-all-worlds"):
    var items: seq[CVal] = @[]
    var i = 0
    while i < hkWorldCount(st.hooks):
      items.add vInt(int64(i))
      inc i
    results.add vList(items)
  witFn(r, IfServer, "[method]server.get-world-by-name"):
    var found = -1
    var i = 0
    while i < hkWorldCount(st.hooks):
      if hkWorldName(st.hooks, i) == args[1].s: found = i
      inc i
    if found < 0: results.add vNone()
    else: results.add vSome(vInt(int64(found)))
  witFn(r, IfServer, "[method]server.has-world"):
    var found = false
    var i = 0
    while i < hkWorldCount(st.hooks):
      if hkWorldName(st.hooks, i) == args[1].s: found = true
      inc i
    results.add vBool(found)
  witFn(r, IfServer, "[method]server.broadcast"):
    hkBroadcast(st.hooks, text(args[1].s))
  witFn(r, IfServer, "[method]server.get-max-players"):
    results.add vInt(int64(hkServerInfo(st.hooks).maxPlayers))
  witFn(r, IfServer, "[method]server.is-hardcore"):
    results.add vBool(hkServerInfo(st.hooks).hardcore)
  witFn(r, IfServer, "[method]server.is-online-mode"):
    results.add vBool(hkServerInfo(st.hooks).onlineMode)
  witFn(r, IfServer, "[method]server.get-motd"):
    results.add vStr(hkServerInfo(st.hooks).motd)
  witFn(r, IfServer, "[method]server.get-allow-nether"):
    results.add vBool(hkServerInfo(st.hooks).allowNether)
  witFn(r, IfServer, "[method]server.get-allow-end"):
    results.add vBool(hkServerInfo(st.hooks).allowEnd)
  witFn(r, IfServer, "[method]server.get-view-distance"):
    results.add vInt(int64(hkServerInfo(st.hooks).viewDistance))
  witFn(r, IfServer, "[method]server.get-simulation-distance"):
    results.add vInt(int64(hkServerInfo(st.hooks).simulationDistance))
  witFn(r, IfServer, "[method]server.get-default-gamemode"):
    results.add vInt(int64(hkServerInfo(st.hooks).defaultGameMode))
  witFn(r, IfServer, "[method]server.get-players-in-world"):
    var items: seq[CVal] = @[]
    let ids = hkPlayerIds(st.hooks)
    for p in ids:
      if hkPlayerWorld(st.hooks, p) == int(args[1].i): items.add vInt(int64(p))
    results.add vList(items)
  witFn(r, IfServer, "[method]server.get-player-count-in-world"):
    var n = 0
    let ids = hkPlayerIds(st.hooks)
    for p in ids:
      if hkPlayerWorld(st.hooks, p) == int(args[1].i): inc n
    results.add vInt(int64(n))
  witFn(r, IfServer, "[method]server.save-all"):
    var err = ""
    if closureSet(st.hooks.saveAll): err = hkSaveAll(st.hooks)
    if err.len == 0: results.add vVariant(0)
    else: results.add vVariant(1, vStr(err))
  witFn(r, IfServer, "[method]server.has-whitelist"):
    let srv = gLink.server
    results.add vBool(srv != nil and srv.basicConfig.whiteList)
  witFn(r, IfServer, "[method]server.get-sys-info"):
    # sys-info { cpu-count, total-memory, used-memory, os-name, os-version, pumpkin-version }; memory in bytes.
    let sys = querySystem()
    if not sys.available:
      results.add vRecord(@[vNone(), vNone(), vNone(), vNone(), vNone(), vStr("0.1.0-aowlmony")])
    else:
      var osVersion = sys.osVersion
      if osVersion.len > 8 and osVersion[0 ..< 8] == "Windows ": osVersion = osVersion[8 ..< osVersion.len]
      results.add vRecord(@[vSome(vInt(int64(sys.cores))), vSome(vInt(int64(sys.totalMemoryMib * 1048576'u64))),
        vSome(vInt(int64(sys.usedMemoryMib * 1048576'u64))), vSome(vStr("Windows")), vSome(vStr(osVersion)),
        vStr("0.1.0-aowlmony")])
  witFn(r, IfServer, "[method]server.broadcast-tab-list-header-footer"):
    let srv = gLink.server
    if srv == nil: return "Server not available"
    let header = textAt(st, int(args[1].i))
    let footer = textAt(st, int(args[2].i))
    for wd in srv.worlds:
      for p in wd.players:
        p.client.writePacketFor(CTabList(header: header, footer: footer))
  witFn(r, IfServer, "[method]server.set-server-links"):
    let srv = gLink.server
    if srv == nil: return "Server not available"
    var links: seq[Link] = @[]
    for l in args[1].items:
      let lab = l.items[0]
      if lab.i == 0:
        links.add newLink(Label(kind: lkBuiltIn, builtIn: LinkType(int(lab.items[0].i))), l.items[1].s)
      else:
        links.add newLink(Label(kind: lkTextComponent, textComponent: textAt(st, int(lab.items[0].i))), l.items[1].s)
    for wd in srv.worlds:
      for p in wd.players:
        p.client.writePacketFor(CPlayServerLinks(links: links))
  witFn(r, IfServer, "[method]server.execute-command"):
    # command-sender { console, player(player) }: the dispatcher runs it as that sender.
    let srv = gLink.server
    if srv == nil: return "Server not available"
    if args[2].i == 0:
      runConsoleCommand(srv, args[1].s)
    else:
      let p = playerById(int(args[2].items[0].i))
      if p == nil: return "player is gone"
      let disp = srv.commandDispatcher
      let cs = srv.commandServer
      if disp != nil and cs != nil and closureSet(srv.commandPlayerOf):
        let line = if args[1].s.len > 0 and args[1].s[0] == '/': args[1].s[1 ..< args[1].s.len] else: args[1].s
        handleCommand(disp, intoSource(senderPlayer(srv.commandPlayerOf(p)), cs), line)
