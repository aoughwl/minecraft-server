## Shared state of the WIT host interfaces whose server access is a hook: boss bars and the closures through which the
## interfaces reach the real server (witbase.aowl, from the player/entity half, holds the text arena and the server).
## Port of the parts of pumpkin/src/plugin/loader/wasm/wasm_host/state.rs that `BossBarResource` lives in
## (an arena slot here, as the handle a plugin holds is its own table index whose `rep` is the slot), and of the type-only files
## pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/common.rs and permission.rs (both are empty `Host` impls upstream:
## their WIT types are plain values, lowered by canonabi.aowl).
##
## The server is reached through closures (`WitHooks`) rather than an import, so the interfaces can be tested without
## a `Server`: src/plugin/pluginmgr.aowl fills them from the real one.
import ../../util/closureset
import ../wasm/[component, canonabi]
import ../../util/text/text
import ../../server/scheduler

const
  TextTag* = 1000000      ## text-component reps at or above this are `WitState.tcs` slots; below, `PluginHost.texts`
  BarFlagDarkenSky* = 1
  BarFlagDragonBar* = 2
  BarFlagCreateFog* = 4

type
  BarOp* = enum
    boAdd          ## show the bar to `playerId` (CBossEvent Add)
    boRemove       ## hide it
    boTitle
    boHealth
    boStyle        ## color and division
    boFlags

  WBar* = object
    ## `PluginBossBar`: the bar and the players it was shown to (by entity id).
    n*: int                 ## stable number, the server side keys its `Bossbar` (uuid) on it
    title*: TextComponent
    health*: float32
    color*: int
    division*: int
    flags*: int
    players*: seq[int]

  ServerInfo* = object
    ## What `server` answers that is configuration or a counter.
    maxPlayers*: int
    motd*: string
    hardcore*: bool
    onlineMode*: bool
    viewDistance*: int
    simulationDistance*: int
    allowNether*: bool
    allowEnd*: bool
    defaultGameMode*: int
    difficulty*: int
    tps*: float64
    mspt*: float64

  WitHooks* = ref object
    tickCount*: proc (): uint64 {.closure.}
    playerIds*: proc (): seq[int] {.closure.}
    playerWorld*: proc (playerId: int): int {.closure.}
    playerByName*: proc (name: string): int {.closure.}                  ## -1 when offline
    playerByUuid*: proc (high, low: uint64): int {.closure.}
    playerUuid*: proc (playerId: int; high, low: var uint64) {.closure.}
    playerName*: proc (playerId: int): string {.closure.}
    worldCount*: proc (): int {.closure.}
    worldName*: proc (world: int): string {.closure.}
    worldDimension*: proc (world: int): string {.closure.}
    getBlockState*: proc (world, x, y, z: int): int {.closure.}
    setBlockState*: proc (world, x, y, z, state, witFlags: int): int {.closure.}   ## WIT block-flags bits; the old state id
    blockIdOfState*: proc (state: int): int {.closure.}
    defaultStateOfBlock*: proc (blockId: int): int {.closure.}      ## -1 unknown
    blockStateByName*: proc (name: string): int {.closure.}              ## default state of a block, -1 unknown
    minY*: proc (world: int): int {.closure.}
    seaLevel*: proc (world: int): int {.closure.}
    topBlockY*: proc (world, x, z: int): int {.closure.}
    timeOfDay*: proc (world: int): uint64 {.closure.}
    setTimeOfDay*: proc (world: int; time: uint64) {.closure.}
    worldAge*: proc (world: int): uint64 {.closure.}
    raining*: proc (world: int): bool {.closure.}
    setRaining*: proc (world: int; v: bool) {.closure.}
    thundering*: proc (world: int): bool {.closure.}
    setThundering*: proc (world: int; v: bool) {.closure.}
    broadcastWorld*: proc (world: int; message: TextComponent; overlay: bool) {.closure.}
    broadcast*: proc (message: TextComponent) {.closure.}
    barOp*: proc (op: BarOp; playerId: int; bar: WBar) {.closure.}
    serverInfo*: proc (): ServerInfo {.closure.}
    random64*: proc (): uint64 {.closure.}
    saveAll*: proc (): string {.closure.}
    createWorld*: proc (name: string; dimension: int): int {.closure.}     ## index in server.worlds, -1 when the server cannot
    unloadWorld*: proc (name: string): string {.closure.}               ## "" or upstream's error
    createExplosion*: proc (world: int; x, y, z: float64; power: float32) {.closure.}   ## server/world/explosion.aowl `explode`

  WitState* = ref object
    hooks*: WitHooks
    tcs*: seq[TextComponent]
    bars*: seq[WBar]
    sched*: TaskScheduler    ## the server's once pluginmgr has set it
    rng: uint64
    legacyText*: proc (rep: int): string {.closure.}   ## `PluginHost.texts` (plain strings), set by pluginhost.aowl

## Calls of a hook from another module (inside a closure) are miscompiled when written as `x.hooks.name(..)`; these wrappers make the call a plain same-module one (COMPILER-BUGS.md).
proc hkTickCount*(h: WitHooks): uint64 =
  h.tickCount()
proc hkPlayerIds*(h: WitHooks): seq[int] =
  h.playerIds()
proc hkPlayerWorld*(h: WitHooks; playerId: int): int =
  h.playerWorld(playerId)
proc hkPlayerByName*(h: WitHooks; name: string): int =
  h.playerByName(name)
proc hkPlayerByUuid*(h: WitHooks; high, low: uint64): int =
  h.playerByUuid(high, low)
proc hkPlayerUuid*(h: WitHooks; playerId: int; high, low: var uint64) =
  h.playerUuid(playerId, high, low)
proc hkPlayerName*(h: WitHooks; playerId: int): string =
  h.playerName(playerId)
proc hkWorldCount*(h: WitHooks): int =
  h.worldCount()
proc hkWorldName*(h: WitHooks; world: int): string =
  h.worldName(world)
proc hkWorldDimension*(h: WitHooks; world: int): string =
  h.worldDimension(world)
proc hkGetBlockState*(h: WitHooks; world, x, y, z: int): int =
  h.getBlockState(world, x, y, z)
proc hkSetBlockState*(h: WitHooks; world, x, y, z, state, witFlags: int): int =
  h.setBlockState(world, x, y, z, state, witFlags)
proc hkBlockIdOfState*(h: WitHooks; state: int): int =
  h.blockIdOfState(state)
proc hkDefaultStateOfBlock*(h: WitHooks; blockId: int): int =
  h.defaultStateOfBlock(blockId)
proc hkBlockStateByName*(h: WitHooks; name: string): int =
  h.blockStateByName(name)
proc hkMinY*(h: WitHooks; world: int): int =
  h.minY(world)
proc hkSeaLevel*(h: WitHooks; world: int): int =
  h.seaLevel(world)
proc hkTopBlockY*(h: WitHooks; world, x, z: int): int =
  h.topBlockY(world, x, z)
proc hkTimeOfDay*(h: WitHooks; world: int): uint64 =
  h.timeOfDay(world)
proc hkSetTimeOfDay*(h: WitHooks; world: int; time: uint64) =
  h.setTimeOfDay(world, time)
proc hkWorldAge*(h: WitHooks; world: int): uint64 =
  h.worldAge(world)
proc hkRaining*(h: WitHooks; world: int): bool =
  h.raining(world)
proc hkSetRaining*(h: WitHooks; world: int; v: bool) =
  h.setRaining(world, v)
proc hkThundering*(h: WitHooks; world: int): bool =
  h.thundering(world)
proc hkSetThundering*(h: WitHooks; world: int; v: bool) =
  h.setThundering(world, v)
proc hkBroadcastWorld*(h: WitHooks; world: int; message: TextComponent; overlay: bool) =
  h.broadcastWorld(world, message, overlay)
proc hkBroadcast*(h: WitHooks; message: TextComponent) =
  h.broadcast(message)
proc hkBarOp*(h: WitHooks; op: BarOp; playerId: int; bar: WBar) =
  h.barOp(op, playerId, bar)
proc hkServerInfo*(h: WitHooks): ServerInfo =
  h.serverInfo()
proc hkRandom64*(h: WitHooks): uint64 =
  h.random64()
proc hkSaveAll*(h: WitHooks): string =
  h.saveAll()
proc hkCreateWorld*(h: WitHooks; name: string; dimension: int): int =
  h.createWorld(name, dimension)
proc hkUnloadWorld*(h: WitHooks; name: string): string =
  h.unloadWorld(name)
proc hkCreateExplosion*(h: WitHooks; world: int; x, y, z: float64; power: float32) =
  h.createExplosion(world, x, y, z, power)

proc newWitState*(): WitState =
  WitState(hooks: WitHooks(), tcs: @[], bars: @[], sched: newTaskScheduler(), rng: 0x9E3779B97F4A7C15'u64)

proc next64*(w: WitState): uint64 =
  ## xorshift64*, the fallback when the server gave no `random64`.
  if closureSet(w.hooks.random64): return w.hooks.random64()
  w.rng = w.rng xor (w.rng shr 12)
  w.rng = w.rng xor (w.rng shl 25)
  w.rng = w.rng xor (w.rng shr 27)
  result = w.rng * 2685821657736338717'u64

proc newTextRep*(w: WitState; tc: TextComponent): int =
  w.tcs.add tc
  result = TextTag + w.tcs.len - 1

proc textAt*(w: WitState; rep: int): TextComponent =
  ## The component behind a text-component handle's rep: an arena slot, or one of the plain strings the server pushed
  ## into `PluginHost.texts` (join messages).
  if rep >= TextTag and rep - TextTag < w.tcs.len: return w.tcs[rep - TextTag]
  if rep >= 0 and rep < TextTag and closureSet(w.legacyText): return text(w.legacyText(rep))
  text("")

proc setText*(w: WitState; rep: int; tc: TextComponent): bool =
  ## Replaces the component behind a handle (the Rust host mutates it in place); false for a rep that is no arena slot.
  if rep >= TextTag and rep - TextTag < w.tcs.len:
    w.tcs[rep - TextTag] = tc
    return true
  false

template witFn*(r: HostRegistry; iface, fname: string; body: untyped) =
  ## One host function: `args` are the lifted parameters, push results onto `results`, `return "<why>"` traps.
  r.defineHostFn(iface, fname, proc (ci {.inject.}: CompInst; args {.inject.}: seq[CVal];
      results {.inject.}: var seq[CVal]): string {.closure.} =
    result = ""
    body)
