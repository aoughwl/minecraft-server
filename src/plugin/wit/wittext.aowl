## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/text.rs: the `text-component` resource, a slot of
## `WitState.tcs` (witstate.aowl, rep = `TextTag` + slot) whose index is the handle's rep. Upstream `take_text`s (deletes) the children it is
## given; here the slot is only read, so a plugin that reuses a child it passed sees it unchanged.
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/text.rs - `entity-names`, `keybind`, `custom` and
## `from-json`/`to-json`/`to-pretty-console`/`click-open-file`/`click-change-page` are provided although the pinned
## text.rs has no body for them (the newer WIT lists them); `custom` takes its locale from the WIT locale name;
## slots are never freed (no `resource.drop` callback from canonabi.aowl).
import std/[options, strutils]
import ../wasm/[canonabi, component]
import ../../util/text/[textbase, text, legacy, locale, click, color]
import witstate

const IfText = "pumpkin:plugin/text"

proc rgbOf(v: CVal): RGBColor = newRGBColor(uint8(v.items[0].i), uint8(v.items[1].i), uint8(v.items[2].i))

proc utf8Of(cp: int64): string =
  result = ""
  let c = int(cp)
  if c < 0x80: result.add char(c)
  elif c < 0x800:
    result.add char(0xC0 or (c shr 6))
    result.add char(0x80 or (c and 0x3F))
  elif c < 0x10000:
    result.add char(0xE0 or (c shr 12))
    result.add char(0x80 or ((c shr 6) and 0x3F))
    result.add char(0x80 or (c and 0x3F))
  else:
    result.add char(0xF0 or (c shr 18))
    result.add char(0x80 or ((c shr 12) and 0x3F))
    result.add char(0x80 or ((c shr 6) and 0x3F))
    result.add char(0x80 or (c and 0x3F))

proc withList(st: WitState; v: CVal): seq[TextComponent] =
  result = @[]
  var i = 0
  while i < v.items.len:
    result.add textAt(st, int(v.items[i].i))
    inc i

proc badHandle(st: WitState; rep: int): bool = rep < TextTag or rep - TextTag >= st.tcs.len

proc installText*(r: HostRegistry; st: WitState) =
  witFn(r, IfText, "[static]text-component.text"):
    results.add vInt(int64(newTextRep(st, text(args[0].s))))
  witFn(r, IfText, "[static]text-component.translate"):
    results.add vInt(int64(newTextRep(st, translate(args[0].s, withList(st, args[1])))))
  witFn(r, IfText, "[static]text-component.translate-cross"):
    results.add vInt(int64(newTextRep(st, translateCross(args[0].s, args[1].s, withList(st, args[2])))))
  witFn(r, IfText, "[static]text-component.entity-names"):
    var sep = none[string]()
    if args[1].i != 0 and args[1].items.len > 0: sep = some(args[1].items[0].s)
    results.add vInt(int64(newTextRep(st, fromContent(TextContent(kind: tcEntityNames, selector: args[0].s, separator: sep)))))
  witFn(r, IfText, "[static]text-component.keybind"):
    results.add vInt(int64(newTextRep(st, fromContent(TextContent(kind: tcKeybind, keybind: args[0].s)))))
  witFn(r, IfText, "[static]text-component.custom"):
    let lt = ci.sigs[ci.funcs[ci.curFn].sig].params[2]
    let loc = localeFromStr((if int(args[2].i) < lt.names.len: lt.names[int(args[2].i)] else: "en-us").replace("-", "_"))
    results.add vInt(int64(newTextRep(st, custom(args[0].s, args[1].s, loc, withList(st, args[3])))))
  witFn(r, IfText, "[static]text-component.from-legacy-string"):
    results.add vInt(int64(newTextRep(st, fromLegacyStringWithCode(args[0].s, utf8Of(0xA7)))))
  witFn(r, IfText, "[static]text-component.from-legacy-string-with-code"):
    results.add vInt(int64(newTextRep(st, fromLegacyStringWithCode(args[0].s, utf8Of(args[1].i)))))
  witFn(r, IfText, "[static]text-component.from-json"):
    let parsed = fromJsonString(TextComponent, args[0].s)
    if parsed.ok: results.add vVariant(0, vInt(int64(newTextRep(st, parsed.value))))
    else: results.add vVariant(1, vStr(parsed.error))
  witFn(r, IfText, "[method]text-component.to-json"):
    results.add vStr(toJsonString(textAt(st, int(args[0].i))))
  witFn(r, IfText, "[method]text-component.add-child"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    discard setText(st, s, addChild(textAt(st, s), textAt(st, int(args[1].i))))
  witFn(r, IfText, "[method]text-component.add-text"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    discard setText(st, s, addText(textAt(st, s), args[1].s))
  witFn(r, IfText, "[method]text-component.get-text"):
    results.add vStr(getText(textAt(st, int(args[0].i))))
  witFn(r, IfText, "[method]text-component.encode"):
    let bytes = encode(textAt(st, int(args[0].i)))
    var items: seq[CVal] = @[]
    for b in bytes: items.add vInt(int64(b))
    results.add vList(items)
  witFn(r, IfText, "[method]text-component.to-pretty-console"):
    results.add vStr(toPrettyConsole(textAt(st, int(args[0].i))))
  # ---- style
  witFn(r, IfText, "[method]text-component.color-named"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    discard setText(st, s, colorNamed(textAt(st, s), NamedColor(int(args[1].i))))
  witFn(r, IfText, "[method]text-component.color-rgb"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    discard setText(st, s, colorRgb(textAt(st, s), rgbOf(args[1])))
  witFn(r, IfText, "[method]text-component.gradient-named"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var cols: seq[NamedColor] = @[]
    for c in args[1].items: cols.add NamedColor(int(c.i))
    discard setText(st, s, gradientNamed(textAt(st, s), cols))
  witFn(r, IfText, "[method]text-component.gradient"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var cols: seq[RGBColor] = @[]
    for c in args[1].items: cols.add rgbOf(c)
    discard setText(st, s, gradient(textAt(st, s), cols))
  witFn(r, IfText, "[method]text-component.rainbow"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    discard setText(st, s, rainbow(textAt(st, s)))
  witFn(r, IfText, "[method]text-component.bold"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.bold = some(args[1].i != 0)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.italic"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.italic = some(args[1].i != 0)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.underlined"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.underlined = some(args[1].i != 0)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.strikethrough"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.strikethrough = some(args[1].i != 0)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.obfuscated"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.obfuscated = some(args[1].i != 0)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.insertion"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.insertion = some(args[1].s)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.font"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.font = some(args[1].s)
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.shadow-color"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.shadowColor = some(newARGBColor(uint8(args[1].items[0].i), uint8(args[1].items[1].i), uint8(args[1].items[2].i), uint8(args[1].items[3].i)))
    discard setText(st, s, tc)
  # ---- click events
  witFn(r, IfText, "[method]text-component.click-open-url"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(openUrl(args[1].s))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.click-open-file"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(openFile(args[1].s))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.click-run-command"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(runCommand(args[1].s))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.click-suggest-command"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(suggestCommand(args[1].s))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.click-change-page"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(changePage(uint32(args[1].i)))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.click-copy-to-clipboard"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.clickEvent = some(copyToClipboard(args[1].s))
    discard setText(st, s, tc)
  # ---- hover events
  witFn(r, IfText, "[method]text-component.hover-show-text"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.hoverEvent = some(showText(textAt(st, int(args[1].i))))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.hover-show-item"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    tc.base.style.hoverEvent = some(showItem(args[1].s))
    discard setText(st, s, tc)
  witFn(r, IfText, "[method]text-component.hover-show-entity"):
    let s = int(args[0].i)
    if badHandle(st, s): return "text-component: invalid handle"
    var tc = textAt(st, s)
    if args[3].i != 0 and args[3].items.len > 0:
      tc.base.style.hoverEvent = some(showEntity(args[2].s, args[1].s, some(textAt(st, int(args[3].items[0].i)))))
    else:
      tc.base.style.hoverEvent = some(showEntity(args[2].s, args[1].s))
    discard setText(st, s, tc)
