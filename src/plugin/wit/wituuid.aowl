## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/uuid.rs: generate (v4), parse (hyphenated or 32 hex digits,
## `none` otherwise), to-string (lowercase, hyphenated). A uuid is the record {high: u64, low: u64}.
import ../wasm/[canonabi, component]
import witstate

const IfUuid = "pumpkin:plugin/uuid"
const HexDigits = "0123456789abcdef"

proc hexVal(c: char): int =
  if c >= '0' and c <= '9': int(c) - int('0')
  elif c >= 'a' and c <= 'f': int(c) - int('a') + 10
  elif c >= 'A' and c <= 'F': int(c) - int('A') + 10
  else: -1

proc parseUuid*(s: string; high, low: var uint64): bool =
  ## `Uuid::parse_str` for the simple and hyphenated forms.
  var digits: seq[int] = @[]
  if s.len == 36:
    var i = 0
    while i < 36:
      if i == 8 or i == 13 or i == 18 or i == 23:
        if s[i] != '-': return false
      else:
        let v = hexVal(s[i])
        if v < 0: return false
        digits.add v
      inc i
  elif s.len == 32:
    for c in s:
      let v = hexVal(c)
      if v < 0: return false
      digits.add v
  else:
    return false
  high = 0'u64
  low = 0'u64
  var k = 0
  while k < 16:
    high = (high shl 4) or uint64(digits[k])
    low = (low shl 4) or uint64(digits[16 + k])
    inc k
  result = true

proc uuidString*(high, low: uint64): string =
  result = ""
  var i = 0
  while i < 32:
    let word = (if i < 16: high else: low)
    let shift = (15 - (i mod 16)) * 4
    result.add HexDigits[int((word shr uint64(shift)) and 0xF'u64)]
    inc i
    if i == 8 or i == 12 or i == 16 or i == 20: result.add '-'

proc vUuid*(high, low: uint64): CVal =
  vRecord(@[vInt(cast[int64](high)), vInt(cast[int64](low))])

proc installUuid*(r: HostRegistry; st: WitState) =
  witFn(r, IfUuid, "generate"):
    var hi = next64(st)
    var lo = next64(st)
    hi = (hi and 0xFFFFFFFFFFFF0FFF'u64) or 0x0000000000004000'u64          # version 4
    lo = (lo and 0x3FFFFFFFFFFFFFFF'u64) or 0x8000000000000000'u64          # variant 10
    results.add vUuid(hi, lo)
  witFn(r, IfUuid, "parse"):
    var hi = 0'u64
    var lo = 0'u64
    if parseUuid(args[0].s, hi, lo): results.add vSome(vUuid(hi, lo))
    else: results.add vNone()
  witFn(r, IfUuid, "to-string"):
    results.add vStr(uuidString(cast[uint64](args[0].items[0].i), cast[uint64](args[0].items[1].i)))
