## Port of pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/world.rs, the `world` resource (rep = index into
## `server.worlds`). The server is reached through `WitState.hooks` (witstate.aowl; pluginmgr.aowl wires them to
## `World`/`BlockWorld`). WIT `block-flags` bits are passed on as given: pluginmgr maps them to `BfNotifyNeighbors`..
## PARTIAL: pumpkin/src/plugin/loader/wasm/wasm_host/wit/v0_1/world.rs - provided: get-id, get-name, get-block-state-id,
## set-block-state, get-block-id, set-block-by-id, set-block-by-name, get-time-of-day, set-time-of-day,
## get-world-age, get-dimension, get-top-block-y, get-motion-blocking-height, is/set-raining, is/set-thundering,
## broadcast-system-message, get-sea-level, get-min-y, save. Missing (still trap): get-world-border and the
## world-border resource, get-chunk and the chunk resource, get-block-state / get-block (the big `block-state` /
## `block` records), set-block, get-scoreboard,
## sky/block light get/set, get-biome, strike-lightning, the ray-trace-* functions, get-block-entity(-nbt),
## set-block-entity-nbt, set-chunk-generator, custom-data. Provided in the second batch: get-spawn-location, game rules,
## play-sound, play-custom-sound (registry sounds only), spawn-particle (no particle data), create-explosion (power only:
## no fire, no interaction kind), get-entities, spawn-entity (through the world's spawn hook).
import ../../util/closureset
import std/[options, strutils]
import ../wasm/[canonabi, component]
import ../../command/cmdsource
import ../../protocol/varint
import ../../protocol/java/client/play/particle as particlepkt
import ../../generated/game_rules
import ../../generated/sound as soundtable
import ../../generated/particle as particletable
import ../../util/vector3
import ../../server/serverbase
import ../../server/entity/entitymod
import witstate, witserver

const IfWorld = "pumpkin:plugin/world"

proc posOf(v: CVal; x, y, z: var int) =
  x = int(v.items[0].i)
  y = int(v.items[1].i)
  z = int(v.items[2].i)

proc soundCategoryName(idx: int): string =
  case idx
  of 0: "master"
  of 1: "music"
  of 2: "records"
  of 3: "weather"
  of 4: "blocks"
  of 5: "hostile"
  of 6: "neutral"
  of 7: "players"
  of 8: "ambient"
  of 9: "voice"
  else: "ui"

proc badWorld(st: WitState; rep: int): bool =
  not closureSet(st.hooks.worldCount) or rep < 0 or rep >= hkWorldCount(st.hooks)

proc installWorld*(r: HostRegistry; st: WitState) =
  witFn(r, IfWorld, "[method]world.get-id"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vStr(hkWorldName(st.hooks, int(args[0].i)))
  witFn(r, IfWorld, "[method]world.get-name"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vStr(hkWorldName(st.hooks, int(args[0].i)))
  witFn(r, IfWorld, "[method]world.get-dimension"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vStr(hkWorldDimension(st.hooks, int(args[0].i)))
  witFn(r, IfWorld, "[method]world.get-block-state-id"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    var x = 0
    var y = 0
    var z = 0
    posOf(args[1], x, y, z)
    results.add vInt(int64(hkGetBlockState(st.hooks, int(args[0].i), x, y, z)))
  witFn(r, IfWorld, "[method]world.get-block-id"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    var x = 0
    var y = 0
    var z = 0
    posOf(args[1], x, y, z)
    results.add vInt(int64(hkBlockIdOfState(st.hooks, hkGetBlockState(st.hooks, int(args[0].i), x, y, z))))
  witFn(r, IfWorld, "[method]world.set-block-state"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    var x = 0
    var y = 0
    var z = 0
    posOf(args[1], x, y, z)
    discard hkSetBlockState(st.hooks, int(args[0].i), x, y, z, int(args[2].i), int(args[3].i))
  witFn(r, IfWorld, "[method]world.set-block-by-id"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    var x = 0
    var y = 0
    var z = 0
    posOf(args[1], x, y, z)
    let state = hkDefaultStateOfBlock(st.hooks, int(args[2].i))
    if state < 0: return "world: invalid block id"
    discard hkSetBlockState(st.hooks, int(args[0].i), x, y, z, state, int(args[3].i))
  witFn(r, IfWorld, "[method]world.set-block-by-name"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    var x = 0
    var y = 0
    var z = 0
    posOf(args[1], x, y, z)
    let state = hkBlockStateByName(st.hooks, args[2].s)
    if state < 0: results.add vBool(false)
    else:
      discard hkSetBlockState(st.hooks, int(args[0].i), x, y, z, state, int(args[3].i))
      results.add vBool(true)
  witFn(r, IfWorld, "[method]world.get-time-of-day"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(cast[int64](hkTimeOfDay(st.hooks, int(args[0].i))))
  witFn(r, IfWorld, "[method]world.set-time-of-day"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    hkSetTimeOfDay(st.hooks, int(args[0].i), cast[uint64](args[1].i))
  witFn(r, IfWorld, "[method]world.get-world-age"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(cast[int64](hkWorldAge(st.hooks, int(args[0].i))))
  witFn(r, IfWorld, "[method]world.get-top-block-y"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(int64(hkTopBlockY(st.hooks, int(args[0].i), int(args[1].i), int(args[2].i))))
  witFn(r, IfWorld, "[method]world.get-motion-blocking-height"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(int64(hkTopBlockY(st.hooks, int(args[0].i), int(args[1].i), int(args[2].i))))
  witFn(r, IfWorld, "[method]world.is-raining"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vBool(hkRaining(st.hooks, int(args[0].i)))
  witFn(r, IfWorld, "[method]world.set-raining"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    hkSetRaining(st.hooks, int(args[0].i), args[1].i != 0)
  witFn(r, IfWorld, "[method]world.is-thundering"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vBool(hkThundering(st.hooks, int(args[0].i)))
  witFn(r, IfWorld, "[method]world.set-thundering"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    hkSetThundering(st.hooks, int(args[0].i), args[1].i != 0)
  witFn(r, IfWorld, "[method]world.broadcast-system-message"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    hkBroadcastWorld(st.hooks, int(args[0].i), textAt(st, int(args[1].i)), args[2].i != 0)
  witFn(r, IfWorld, "[method]world.get-sea-level"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(int64(hkSeaLevel(st.hooks, int(args[0].i))))
  witFn(r, IfWorld, "[method]world.get-min-y"):
    if badWorld(st, int(args[0].i)): return "world: invalid handle"
    results.add vInt(int64(hkMinY(st.hooks, int(args[0].i))))
  witFn(r, IfWorld, "[method]world.save"):
    var err = ""
    if closureSet(st.hooks.saveAll): err = hkSaveAll(st.hooks)
    if err.len == 0: results.add vVariant(0)
    else: results.add vVariant(1, vStr(err))
  witFn(r, IfWorld, "[method]world.get-spawn-location"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    let info = wd.levelInfo
    results.add vRecord(@[vRecord(@[vInt(int64(info.spawnX)), vInt(int64(info.spawnY)), vInt(int64(info.spawnZ))]),
      vFloat(float64(info.spawnYaw)), vFloat(float64(info.spawnPitch))])
  witFn(r, IfWorld, "[method]world.get-game-rule"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    let v = wd.levelInfo.gameRules.get(GameRule(int(args[1].i)))
    case v.kind
    of grkInt: results.add vVariant(0, vInt(v.intValue))
    of grkBool: results.add vVariant(1, vBool(v.boolValue))
  witFn(r, IfWorld, "[method]world.set-game-rule"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    let rule = GameRule(int(args[1].i))
    if args[2].i == 0:
      wd.levelInfo.gameRules.set(rule, GameRuleValue(kind: grkInt, intValue: args[2].items[0].i))
    else:
      wd.levelInfo.gameRules.set(rule, GameRuleValue(kind: grkBool, boolValue: args[2].items[0].i != 0))
  witFn(r, IfWorld, "[method]world.play-sound"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    if args[1].i < 0 or args[1].i > int64(ord(high(Sound))): return "unknown sound"
    let n = soundtable.toName(Sound(int(args[1].i)))
    for p in wd.players:
      let cp = p.commandPlayer
      if cp != nil and closureSet(cp.playSound):
        cp.playSound(n, soundCategoryName(int(args[2].i)), posOf(args[3]), float32(args[4].f), float32(args[5].f), 0.0)
  witFn(r, IfWorld, "[method]world.play-custom-sound"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    for p in wd.players:
      let cp = p.commandPlayer
      if cp != nil and closureSet(cp.playSound):
        cp.playSound(args[1].s, soundCategoryName(int(args[2].i)), posOf(args[3]), float32(args[4].f), float32(args[5].f), 0.0)
  witFn(r, IfWorld, "[method]world.spawn-particle"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    let (ok, part) = particleFromId(uint16(args[1].i))
    if not ok: return "unknown particle"
    let pos = posOf(args[2])
    let off = posOf(args[3])
    for p in wd.players:
      p.client.writePacketFor(particlepkt.CParticle(forceSpawn: false, important: false, position: pos,
        offset: Vector3[float32](x: float32(off.x), y: float32(off.y), z: float32(off.z)),
        maxSpeed: float32(args[4].f), particleCount: int32(args[5].i),
        particleId: newVarInt(int32(particleToId(part))), data: @[]))
  witFn(r, IfWorld, "[method]world.create-explosion"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    let at = posOf(args[1])
    if closureSet(st.hooks.createExplosion):
      hkCreateExplosion(st.hooks, int(args[0].i), at.x, at.y, at.z, float32(args[2].f))
  witFn(r, IfWorld, "[method]world.get-entities"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    var items: seq[CVal] = @[]
    for p in wd.players: items.add vInt(int64(p.entityId))
    for e in allEntities(wd): items.add vInt(int64(e.entity.entityId))
    results.add vList(items)
  witFn(r, IfWorld, "[method]world.spawn-entity"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world: invalid handle"
    if not closureSet(wd.spawnEntityHook): return "world: no entity spawner"
    var before: seq[int32] = @[]
    for e in allEntities(wd): before.add e.entity.entityId
    let nm = "minecraft:" & enumName(paramTy(ci, 1), int(args[1].i)).replace("-", "_")
    discard wd.spawnEntityHook(nm, posOf(args[2]))
    var found = -1
    for e in allEntities(wd):
      if not (e.entity.entityId in before): found = int(e.entity.entityId)
    if found < 0: return "world: entity was not spawned"
    results.add vInt(int64(found))
