  # ---- chunk
  witFn(r, IfWorld, "[method]chunk.get-x"):
    let c = chunkOf(we, int(args[0].i))
    if c == nil: return "Chunk unloaded"
    results.add vInt(int64(c.x))
  witFn(r, IfWorld, "[method]chunk.get-z"):
