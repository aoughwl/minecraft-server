  witFn(r, IfWorld, "[method]chunk.set-block-state"):
    let rc = int(args[0].i)
    let c = chunkOf(we, rc)
    if c == nil: return "Chunk unloaded"
    if badState(int(args[2].i)): return "Invalid BlockStateId"
    chunkSetState(we, rc, c, args[1], uint32(args[2].i))
  witFn(r, IfWorld, "[method]chunk.set-block"):
    let rc = int(args[0].i)
    let c = chunkOf(we, rc)
    if c == nil: return "Chunk unloaded"
    let b = bx.Block.fromId(bx.newBlockIdOrAir(uint16(args[2].items[0].i)))
    chunkSetState(we, rc, c, args[1], uint32(asU16(b.defaultState.id)))
  witFn(r, IfWorld, "[method]chunk.set-block-by-id"):
    let rc = int(args[0].i)
    let c = chunkOf(we, rc)
    if c == nil: return "Chunk unloaded"
    if badBlock(int(args[2].i)): return "Invalid BlockId"
    let b = bx.Block.fromId(bx.newBlockIdUnchecked(uint16(args[2].i)))
    chunkSetState(we, rc, c, args[1], uint32(asU16(b.defaultState.id)))
  witFn(r, IfWorld, "[method]chunk.get-biome"):
    let c = chunkOf(we, int(args[0].i))
    if c == nil: return "Chunk unloaded"
    let p = args[1]
    var id = 0
    if p.items[0].i >= 0 and p.items[0].i < 16 and p.items[2].i >= 0 and p.items[2].i < 16:
      let (ok, v) = getRoughBiomeAbsoluteY(c.section, int(p.items[0].i), int32(p.items[1].i), int(p.items[2].i))
      if ok: id = int(v)
    var b = biomedata.Biome.fromId(uint8(id))
    if b == nil: b = biomedata.Biome.fromName("the_void")
    var nm = "the_void"
    if b != nil: nm = b.registryId
    results.add vInt(int64(enumIndex(resultTy(ci), nm)))
  witFn(r, IfWorld, "[method]chunk.get-block-entity"):
    let rc = int(args[0].i)
    let c = chunkOf(we, rc)
    if c == nil: return "Chunk unloaded"
    let p = args[1]
    let ax = int(c.x) * 16 + int(p.items[0].i)
    let az = int(c.z) * 16 + int(p.items[2].i)
    let kind = (if we.be.hooks.kind != nil: we.be.hooks.kind(we.chunks[rc].world, ax, int(p.items[1].i), az) else: "")
    if kind.len == 0 or beCase(ci, kind) < 0:
      results.add vNone()
    else:
      let rep = newBlockEntityRep(we.be, we.chunks[rc].world, ax, int(p.items[1].i), az)
      results.add vSome(vVariant(beCase(ci, kind), vInt(int64(rep))))
  witFn(r, IfWorld, "[method]chunk.get-top-block-y"):
    let c = chunkOf(we, int(args[0].i))
    if c == nil: return "Chunk unloaded"
    results.add vInt(int64(getHeightmap(c.heightmap, chmWorldSurface, int32(args[1].i), int32(args[2].i), c.section.minY)))
  witFn(r, IfWorld, "[method]chunk.get-sky-light"):
    let c = chunkOf(we, int(args[0].i))
    if c == nil: return "Chunk unloaded"
    let p = args[1]
    results.add vInt(int64(chunkLight(c, true, int(p.items[0].i), int(p.items[1].i), int(p.items[2].i))))
  witFn(r, IfWorld, "[method]chunk.get-block-light"):
    let c = chunkOf(we, int(args[0].i))
    if c == nil: return "Chunk unloaded"
    let p = args[1]
    results.add vInt(int64(chunkLight(c, false, int(p.items[0].i), int(p.items[1].i), int(p.items[2].i))))
  installCustomData(r, we, "chunk", proc (rep: int): string {.closure.} =
    if rep >= 0 and rep < we.chunks.len: "c" & $we.chunks[rep].world & ":" & $we.chunks[rep].x & ":" & $we.chunks[rep].z
    else: "c?")
