  witFn(r, IfWorld, "[method]world-border.set-size-transition"):
    let wd = worldAt(int(args[0].i))
    if wd == nil: return "world-border: invalid handle"
    let secs = cast[uint64](args[2].i)
    let millis = if secs > 9_000_000_000_000_000'u64: 9_000_000_000_000_000'i64 else: int64(secs) * 1000'i64
    var wb = wd.worldborder
    wb.setDiameter(wd, args[1].f, true, millis)
    wd.worldborder = wb
