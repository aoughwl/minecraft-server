## Known-answer test for aescfb8.aowl: FIPS-197 appendix C.1 and NIST SP 800-38A
## F.3.7/F.3.8 (CFB8-AES128).
import std/assertions
import std/syncio
import aescfb8

proc fromHex(s: string): seq[uint8] =
  proc nib(c: char): int =
    if c >= '0' and c <= '9': ord(c) - ord('0') else: ord(c) - ord('a') + 10
  result = @[]
  var i = 0
  while i < s.len:
    result.add(uint8(nib(s[i]) * 16 + nib(s[i + 1])))
    i += 2

block fips197:
  let cipher = newAes128(fromHex("000102030405060708090a0b0c0d0e0f"))
  let plain = fromHex("00112233445566778899aabbccddeeff")
  var state {.noinit.}: array[16, uint8]
  for i in 0 ..< 16:
    state[i] = plain[i]
  cipher.encryptBlock(state)
  let expected = fromHex("69c4e0d86a7b0430d8cdb78070b4c55a")
  for i in 0 ..< 16:
    assert state[i] == expected[i]

let key = fromHex("2b7e151628aed2a6abf7158809cf4f3c")
let iv = fromHex("000102030405060708090a0b0c0d0e0f")
let plain = fromHex("6bc1bee22e409f96e93d7e117393172aae2d")
let ct = fromHex("3b79424c9c0dd436bace9e0ed4586a4f32b9")

block cfb8Encrypt:
  var c = newAes128Cfb8(key, iv)
  for i in 0 ..< plain.len:
    assert c.encryptByte(plain[i]) == ct[i]

block cfb8Decrypt:
  var c = newAes128Cfb8(key, iv)
  for i in 0 ..< ct.len:
    assert c.decryptByte(ct[i]) == plain[i]

echo "all aescfb8 checks passed"
