## Port of pumpkin-protocol/src/bedrock/ack.rs
## RakNet ACK (0xC0) and NACK (0xA0) records. `write` takes the id byte, as upstream's `id: u8`.

import std/algorithm
import ../protobase, ../netcodec, ../serial

const MAX_ACK_RECORDS = 4096'u16

proc cmpSeq(a, b: uint32): int =
  if a < b: -1
  elif a > b: 1
  else: 0

type
  Acknowledge* = object
    sequences*: seq[uint32]

proc newAcknowledge*(sequences: seq[uint32]): Acknowledge =
  Acknowledge(sequences: sequences)

proc writeRange(start, finish: uint32; w: var NetWriter) =
  ## `Acknowledge::write_range`: a single record is `01 u24`, a range `00 u24 u24`.
  if start == finish:
    packetWrite(1'u8, w)
    packetWrite(U24(value: start), w)
  else:
    packetWrite(0'u8, w)
    packetWrite(U24(value: start), w)
    packetWrite(U24(value: finish), w)

proc readAcknowledge*(r: var NetReader): ProtoReadResult[Acknowledge] =
  ## `Acknowledge::read`. The record count is big-endian, each sequence a little-endian u24.
  let size = tryRead(Acknowledge, packetReadBe(uint16, r))
  if size > MAX_ACK_RECORDS:
    return readErr[Acknowledge](messageRead("Acknowledge packet range is too large."))
  var sequences: seq[uint32] = @[]
  for _ in 0 ..< int(size):
    let single = tryRead(Acknowledge, packetRead(bool, r))
    if single:
      sequences.add(tryRead(Acknowledge, packetRead(U24, r)).value)
    else:
      let start = tryRead(Acknowledge, packetRead(U24, r)).value
      let finish = tryRead(Acknowledge, packetRead(U24, r)).value
      var i = start
      while i <= finish:
        sequences.add(i)
        i += 1
  readOk(Acknowledge(sequences: sequences))

proc write*(self: Acknowledge; w: var NetWriter; id: uint8) =
  ## `Acknowledge::write`: id, big-endian record count, then the records. Sequences are sorted, and
  ## consecutive runs become ranges. An empty set writes a count of zero and nothing else.
  packetWrite(id, w)
  if self.sequences.len == 0:
    packetWriteBe(0'u16, w)
    return
  var count = 0'u16
  var buf = newNetWriter()
  var sequences = self.sequences
  sort(sequences, cmpSeq)
  var start = sequences[0]
  var finish = start
  for i in 1 ..< sequences.len:
    let s = sequences[i]
    if s != finish + 1'u32:
      writeRange(start, finish, buf)
      count += 1'u16
      start = s
    finish = s
  writeRange(start, finish, buf)
  count += 1'u16
  packetWriteBe(count, w)
  writeSlice(w, buf.buf)
