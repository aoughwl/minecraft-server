## AES-256 block cipher and its CTR mode (`Ctr128BE<Aes256>`), for crypto.aowl. Support module with no
## upstream file of its own: it is what the `aes` and `ctr` crates are to pumpkin-protocol/src/bedrock/crypto.rs.
## aescfb8.aowl is the AES-128 twin; its tables are private, so the S-box is repeated here. Only encryption of
## a block is needed, since CTR runs the block cipher forward in both directions.
## Checked against FIPS-197 appendix C.3 and upstream's own `gcm_compatibility` vector in cryptotest.aowl.

const
  SBox: array[256, uint8] = [
    0x63'u8, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16]
  RCon: array[10, uint8] = [0x01'u8, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36]


type
  Aes256* = object
    roundKeys: array[240, uint8]

  Aes256Ctr* = object
    ## `Ctr128BE`: the whole 16-byte counter block is a big-endian integer incremented per block, and the
    ## keystream carries over between `applyKeystream` calls.
    cipher: Aes256
    counter: array[16, uint8]
    stream: array[16, uint8]
    used: int  ## bytes of `stream` already consumed; 16 means a fresh block is needed

proc newAes256*(key: openArray[uint8]): Aes256 =
  ## `key` must be 32 bytes. FIPS-197 key expansion with Nk = 8 and 14 rounds (60 words).
  result = Aes256()
  for i in 0 ..< 32:
    result.roundKeys[i] = key[i]
  for i in 8 ..< 60:
    var t0 = result.roundKeys[(i - 1) * 4]
    var t1 = result.roundKeys[(i - 1) * 4 + 1]
    var t2 = result.roundKeys[(i - 1) * 4 + 2]
    var t3 = result.roundKeys[(i - 1) * 4 + 3]
    if i mod 8 == 0:
      let rotated = t0
      t0 = SBox[int(t1)] xor RCon[i div 8 - 1]
      t1 = SBox[int(t2)]
      t2 = SBox[int(t3)]
      t3 = SBox[int(rotated)]
    elif i mod 8 == 4:
      t0 = SBox[int(t0)]
      t1 = SBox[int(t1)]
      t2 = SBox[int(t2)]
      t3 = SBox[int(t3)]
    result.roundKeys[i * 4] = result.roundKeys[(i - 8) * 4] xor t0
    result.roundKeys[i * 4 + 1] = result.roundKeys[(i - 8) * 4 + 1] xor t1
    result.roundKeys[i * 4 + 2] = result.roundKeys[(i - 8) * 4 + 2] xor t2
    result.roundKeys[i * 4 + 3] = result.roundKeys[(i - 8) * 4 + 3] xor t3

proc xtime(x: uint8): uint8 {.inline.} =
  let shifted = uint8((uint32(x) shl 1) and 0xFF'u32)
  if (x and 0x80'u8) != 0'u8: shifted xor 0x1b'u8 else: shifted

proc encryptBlock*(self: Aes256; state: var array[16, uint8]) =
  for i in 0 ..< 16:
    state[i] = state[i] xor self.roundKeys[i]
  for round in 1 .. 14:
    # SubBytes and ShiftRows; the state is column-major.
    var t {.noinit.}: array[16, uint8]
    for c in 0 ..< 4:
      for row in 0 ..< 4:
        t[c * 4 + row] = SBox[int(state[((c + row) mod 4) * 4 + row])]
    if round < 14:
      # MixColumns
      for c in 0 ..< 4:
        let a0 = t[c * 4]
        let a1 = t[c * 4 + 1]
        let a2 = t[c * 4 + 2]
        let a3 = t[c * 4 + 3]
        state[c * 4] = xtime(a0) xor (xtime(a1) xor a1) xor a2 xor a3
        state[c * 4 + 1] = a0 xor xtime(a1) xor (xtime(a2) xor a2) xor a3
        state[c * 4 + 2] = a0 xor a1 xor xtime(a2) xor (xtime(a3) xor a3)
        state[c * 4 + 3] = (xtime(a0) xor a0) xor a1 xor a2 xor xtime(a3)
    else:
      state = t
    for i in 0 ..< 16:
      state[i] = state[i] xor self.roundKeys[round * 16 + i]

proc newAes256Ctr*(key, iv: openArray[uint8]): Aes256Ctr =
  ## `BedrockCtr::new(key, iv)`: `key` 32 bytes, `iv` 16 bytes (the initial counter block).
  result = Aes256Ctr(cipher: newAes256(key), used: 16)
  for i in 0 ..< 16:
    result.counter[i] = iv[i]

proc nextBlock(self: var Aes256Ctr) =
  self.stream = self.counter
  self.cipher.encryptBlock(self.stream)
  # Increment the counter as a 128-bit big-endian integer.
  var i = 15
  while i >= 0:
    self.counter[i] = self.counter[i] + 1'u8
    if self.counter[i] != 0'u8:
      break
    i -= 1
  self.used = 0

proc applyKeystream*(self: var Aes256Ctr; data: var seq[byte]) =
  ## `StreamCipher::apply_keystream`: XORs the keystream into `data` in place.
  for i in 0 ..< data.len:
    if self.used >= 16:
      nextBlock(self)
    data[i] = data[i] xor self.stream[self.used]
    self.used += 1
