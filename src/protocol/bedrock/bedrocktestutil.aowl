{.feature: "untyped".}
## Helpers shared by the tests under src/protocol/bedrock. Support module for tests, with no upstream file.
## `eqHex` exits non-zero and prints both sides on a mismatch; `hx` reads bytes from hex with spaces ignored.
## `wrote(expr)` is a template so the packet can be any `packetWrite` overload.

import std/assertions
import std/syncio
import ../protobase, ../netcodec, ../serial, ../varint

export assertions, syncio, protobase, netcodec, serial, varint

const HexDigits = "0123456789abcdef"

proc hx*(s: string): seq[byte] =
  proc nib(c: char): int =
    if c >= '0' and c <= '9': ord(c) - ord('0')
    elif c >= 'a' and c <= 'f': ord(c) - ord('a') + 10
    else: ord(c) - ord('A') + 10
  result = @[]
  var have = false
  var hi = 0
  for c in s:
    if c == ' ':
      continue
    if have:
      result.add(uint8(hi * 16 + nib(c)))
      have = false
    else:
      hi = nib(c)
      have = true

proc hexOf*(b: openArray[byte]): string =
  result = ""
  for x in b:
    result.add(HexDigits[int(x shr 4)])
    result.add(HexDigits[int(x and 15)])

proc stripped*(s: string): string =
  result = ""
  for c in s:
    if c != ' ':
      result.add(c)

proc eqHex*(got: openArray[byte]; want: string; what: string) =
  let w = stripped(want)
  let g = hexOf(got)
  if g != w:
    echo "FAIL ", what
    echo "  got  ", g
    echo "  want ", w
    quit(1)

proc utf8Hex*(s: string): string =
  result = ""
  for ch in s:
    result.add(HexDigits[ord(ch) shr 4])
    result.add(HexDigits[ord(ch) and 15])

template wrote*(p: untyped): seq[byte] =
  ## The bytes `packetWrite` produces for `p`.
  block:
    var wr = newNetWriter()
    packetWrite(p, wr)
    wr.buf

template check*(cond: bool; what: string) =
  if not cond:
    echo "FAIL ", what
    quit(1)

template wire*(id: untyped; p: untyped): seq[byte] =
  ## An offline RakNet packet: the id byte, then the body `packetWrite` produces for `p`.
  block:
    var wwr = newNetWriter()
    wwr.buf.add(uint8(id))
    packetWrite(p, wwr)
    wwr.buf
