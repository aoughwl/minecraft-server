## Port of pumpkin-protocol/src/bedrock/client/add_actor.rs
## Writes through a `ProtoWriteVoidResult`, because entity metadata can fail (see set_actor_data.aowl).

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3
import common, set_actor_data

const CAddActorPacketId* = 13'i32

type
  AttributeValue* = object
    name*: string
    min*: float32
    value*: float32
    max*: float32

  CAddActor* = object
    entityUniqueId*: VarLong
    entityRuntimeId*: VarULong
    entityType*: string
    position*: Vector3[float32]
    velocity*: Vector3[float32]
    pitch*: float32
    yaw*: float32
    headYaw*: float32
    bodyYaw*: float32
    attributes*: seq[AttributeValue]
    metadata*: EntityMetadata
    syncedProperties*: PropertySyncData
    links*: seq[EntityLink]

proc newCAddActor*(entityUniqueId: VarLong; entityRuntimeId: VarULong; entityType: string;
    position, velocity: Vector3[float32]; pitch, yaw, headYaw, bodyYaw: float32; attributes: seq[AttributeValue];
    metadata: EntityMetadata; syncedProperties: PropertySyncData; links: seq[EntityLink]): CAddActor =
  CAddActor(entityUniqueId: entityUniqueId, entityRuntimeId: entityRuntimeId, entityType: entityType,
    position: position, velocity: velocity, pitch: pitch, yaw: yaw, headYaw: headYaw, bodyYaw: bodyYaw,
    attributes: attributes, metadata: metadata, syncedProperties: syncedProperties, links: links)

proc packetWrite*(self: AttributeValue; w: var NetWriter) =
  packetWrite(self.name, w)
  packetWrite(self.min, w)
  packetWrite(self.value, w)
  packetWrite(self.max, w)

proc packetWrite*(self: CAddActor; w: var NetWriter): ProtoWriteVoidResult =
  packetWrite(self.entityUniqueId, w)
  packetWrite(self.entityRuntimeId, w)
  packetWrite(self.entityType, w)
  packetWrite(self.position, w)
  packetWrite(self.velocity, w)
  packetWrite(self.pitch, w)
  packetWrite(self.yaw, w)
  packetWrite(self.headYaw, w)
  packetWrite(self.bodyYaw, w)
  packetWrite(newVarUInt(uint32(self.attributes.len)), w)
  for i in 0 ..< self.attributes.len:
    packetWrite(self.attributes[i], w)
  tryWrite packetWrite(self.metadata, w)
  packetWrite(self.syncedProperties, w)
  packetWrite(newVarUInt(uint32(self.links.len)), w)
  for i in 0 ..< self.links.len:
    packetWrite(self.links[i], w)
  writeOkVoid()
