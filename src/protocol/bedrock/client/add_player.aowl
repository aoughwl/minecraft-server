## Port of pumpkin-protocol/src/bedrock/client/add_player.rs
## Writes through a `ProtoWriteVoidResult`, because entity metadata can fail (see set_actor_data.aowl).

import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../uuid
import ../../../util/vector3
import ../network_item, common, set_actor_data

const CAddPlayerPacketId* = 12'i32

type
  IntPropertyPair* = object
    id*: VarUInt
    value*: VarInt

  FloatPropertyPair* = object
    id*: VarUInt
    value*: float32

  EntityProperties* = object
    ints*: seq[IntPropertyPair]
    floats*: seq[FloatPropertyPair]

  AbilityData* = object
    entityUniqueId*: int64
    playerPermissions*: uint8
    commandPermissions*: uint8
    layers*: seq[AbilityLayer]

  CAddPlayer* = object
    uuid*: Uuid
    username*: string
    entityRuntimeId*: VarULong
    platformChatId*: string
    position*: Vector3[float32]
    velocity*: Vector3[float32]
    pitch*: float32
    yaw*: float32
    headYaw*: float32
    heldItem*: NetworkItemDescriptor
    gameMode*: VarInt
    metadata*: EntityMetadata
    properties*: EntityProperties
    abilityData*: AbilityData
    links*: seq[EntityLink]
    deviceId*: string
    buildPlatform*: int32

proc newCAddPlayer*(uuid: Uuid; username: string; entityRuntimeId: VarULong; platformChatId: string;
    position, velocity: Vector3[float32]; pitch, yaw, headYaw: float32; heldItem: NetworkItemDescriptor;
    gameMode: VarInt; metadata: EntityMetadata; properties: EntityProperties; abilityData: AbilityData;
    links: seq[EntityLink]; deviceId: string; buildPlatform: int32): CAddPlayer =
  CAddPlayer(uuid: uuid, username: username, entityRuntimeId: entityRuntimeId, platformChatId: platformChatId,
    position: position, velocity: velocity, pitch: pitch, yaw: yaw, headYaw: headYaw, heldItem: heldItem,
    gameMode: gameMode, metadata: metadata, properties: properties, abilityData: abilityData, links: links,
    deviceId: deviceId, buildPlatform: buildPlatform)

proc packetWrite*(self: EntityProperties; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(self.ints.len)), w)
  for p in self.ints:
    packetWrite(p.id, w)
    packetWrite(p.value, w)
  packetWrite(newVarUInt(uint32(self.floats.len)), w)
  for p in self.floats:
    packetWrite(p.id, w)
    packetWrite(p.value, w)

proc packetWrite*(self: AbilityData; w: var NetWriter) =
  ## The layer count is a single byte here, not a VarUInt.
  packetWrite(self.entityUniqueId, w)
  packetWrite(self.playerPermissions, w)
  packetWrite(self.commandPermissions, w)
  packetWrite(uint8(self.layers.len and 0xFF), w)
  for i in 0 ..< self.layers.len:
    packetWrite(self.layers[i], w)

proc packetWrite*(self: CAddPlayer; w: var NetWriter): ProtoWriteVoidResult =
  packetWrite(self.uuid, w)
  packetWrite(self.username, w)
  packetWrite(self.entityRuntimeId, w)
  packetWrite(self.platformChatId, w)
  packetWrite(self.position, w)
  packetWrite(self.velocity, w)
  packetWrite(self.pitch, w)
  packetWrite(self.yaw, w)
  packetWrite(self.headYaw, w)
  packetWrite(self.heldItem, w)
  packetWrite(self.gameMode, w)
  tryWrite packetWrite(self.metadata, w)
  packetWrite(self.properties, w)
  packetWrite(self.abilityData, w)
  packetWrite(newVarUInt(uint32(self.links.len)), w)
  for i in 0 ..< self.links.len:
    packetWrite(self.links[i], w)
  packetWrite(self.deviceId, w)
  packetWrite(self.buildPlatform, w)
  writeOkVoid()
