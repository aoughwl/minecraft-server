## Port of pumpkin-protocol/src/bedrock/client/available_commands.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const
  CAvailableCommandsPacketId* = 76'i32
  # Constants matching PocketMine's ARG_FLAG_* and ARG_TYPE_* values (`arg_flags`, `arg_types`)
  ARG_FLAG_VALID* = 0x100000'u32
  ARG_FLAG_ENUM* = 0x200000'u32
  ARG_FLAG_POSTFIX* = 0x1000000'u32
  ARG_FLAG_SOFT_ENUM* = 0x4000000'u32
  ARG_TYPE_INT* = 0x01'u32
  ARG_TYPE_FLOAT* = 0x03'u32
  ARG_TYPE_VALUE* = 0x04'u32
  ARG_TYPE_WILDCARD_INT* = 0x05'u32
  ARG_TYPE_OPERATOR* = 0x06'u32
  ARG_TYPE_COMPARE_OPERATOR* = 0x07'u32
  ARG_TYPE_TARGET* = 0x08'u32
  ARG_TYPE_WILDCARD_TARGET* = 0x0a'u32
  ARG_TYPE_FILE_PATH* = 0x0f'u32
  ARG_TYPE_INT_RANGE* = 0x17'u32
  ARG_TYPE_EQUIPMENT_SLOT* = 0x26'u32
  ARG_TYPE_STRING* = 0x27'u32
  ARG_TYPE_BLOCK_POS* = 0x2d'u32
  ARG_TYPE_ENTITY_POS* = 0x2e'u32
  ARG_TYPE_RAW_TEXT* = 0x33'u32
  ARG_TYPE_JSON* = 0x36'u32
  ARG_TYPE_MESSAGE* = 0x3c'u32
  ARG_TYPE_COMMAND* = 0x46'u32
  # `command_permissions`
  COMMAND_PERMISSION_ANY* = "any"
  COMMAND_PERMISSION_GAME_DIRECTORS* = "gamedirectors"
  COMMAND_PERMISSION_ADMIN* = "admin"
  COMMAND_PERMISSION_HOST* = "host"
  COMMAND_PERMISSION_OWNER* = "owner"
  COMMAND_PERMISSION_INTERNAL* = "internal"

type
  ChainedSubcommandValue* = object
    index*: uint32
    value*: uint32

  ChainedSubcommand* = object
    ## A subcommand that can chain commands, e.g. /execute. Written as a flat list in section 3 of the packet;
    ## commands reference entries by index via `chainedSubcommandOffsets`.
    name*: string
    values*: seq[ChainedSubcommandValue]

  CommandEnum* = object
    name*: string
    valueIndices*: seq[int] ## `Vec<usize>`, each written as a little-endian u32

  CommandParameter* = object
    name*: string
    typeInfo*: uint32
    optional*: bool
    options*: uint8

  CommandOverload* = object
    chaining*: bool
    parameters*: seq[CommandParameter]

  Command* = object
    name*: string
    description*: string
    flags*: uint16
    permission*: string
    aliasesEnumIndex*: int32
    chainedSubcommandOffsets*: seq[uint32]
    overloads*: seq[CommandOverload]

  SoftEnum* = object
    name*: string
    values*: seq[string]

  CommandEnumConstraint* = object
    affectedValueIndex*: int32
    enumIndex*: int32
    constraints*: seq[uint8]

  CAvailableCommands* = object
    enumValues*: seq[string]
    chainedSubcommandValues*: seq[string]
    suffixes*: seq[string]
    enums*: seq[CommandEnum]
    chainedSubcommands*: seq[ChainedSubcommand]
    commands*: seq[Command]
    softEnums*: seq[SoftEnum]
    constraints*: seq[CommandEnumConstraint]

proc writeCount(n: int; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(n)), w)

proc writeStringSlice(slice: seq[string]; w: var NetWriter) =
  writeCount(slice.len, w)
  for s in slice:
    packetWrite(s, w)

proc packetWrite*(self: ChainedSubcommand; w: var NetWriter) =
  packetWrite(self.name, w)
  writeCount(self.values.len, w)
  for v in self.values:
    packetWrite(newVarUInt(v.index), w)
    packetWrite(newVarUInt(v.value), w)

proc packetWrite*(self: CommandEnum; w: var NetWriter) =
  packetWrite(self.name, w)
  writeCount(self.valueIndices.len, w)
  for index in self.valueIndices:
    packetWrite(uint32(index and 0xFFFFFFFF), w)

proc packetWrite*(self: CommandParameter; w: var NetWriter) =
  packetWrite(self.name, w)
  packetWrite(self.typeInfo, w)
  packetWrite(self.optional, w)
  packetWrite(self.options, w)

proc packetWrite*(self: CommandOverload; w: var NetWriter) =
  # Chaining bool: the client reads this byte first
  packetWrite(self.chaining, w)
  writeCount(self.parameters.len, w)
  for i in 0 ..< self.parameters.len:
    packetWrite(self.parameters[i], w)

proc packetWrite*(self: Command; w: var NetWriter) =
  packetWrite(self.name, w)
  packetWrite(self.description, w)
  packetWrite(self.flags, w)
  packetWrite(self.permission, w)
  packetWrite(self.aliasesEnumIndex, w)
  # Chained subcommand offsets
  writeCount(self.chainedSubcommandOffsets.len, w)
  for offset in self.chainedSubcommandOffsets:
    packetWrite(offset, w)
  writeCount(self.overloads.len, w)
  for i in 0 ..< self.overloads.len:
    packetWrite(self.overloads[i], w)

proc packetWrite*(self: SoftEnum; w: var NetWriter) =
  packetWrite(self.name, w)
  writeCount(self.values.len, w)
  for v in self.values:
    packetWrite(v, w)

proc packetWrite*(self: CommandEnumConstraint; w: var NetWriter) =
  packetWrite(self.affectedValueIndex, w)
  packetWrite(self.enumIndex, w)
  writeCount(self.constraints.len, w)
  for c in self.constraints:
    writeU8(w, c)

proc packetWrite*(self: CAvailableCommands; w: var NetWriter) =
  # 1. Enum values
  writeStringSlice(self.enumValues, w)
  # 2. Chained subcommand values (the flat string list)
  writeStringSlice(self.chainedSubcommandValues, w)
  # 3. Suffixes
  writeStringSlice(self.suffixes, w)
  # 4. Enums
  writeCount(self.enums.len, w)
  for i in 0 ..< self.enums.len:
    packetWrite(self.enums[i], w)
  # 5. Chained Subcommands
  writeCount(self.chainedSubcommands.len, w)
  for i in 0 ..< self.chainedSubcommands.len:
    packetWrite(self.chainedSubcommands[i], w)
  # 6. Commands
  writeCount(self.commands.len, w)
  for i in 0 ..< self.commands.len:
    packetWrite(self.commands[i], w)
  # 7. Dynamic (Soft) Enums
  writeCount(self.softEnums.len, w)
  for i in 0 ..< self.softEnums.len:
    packetWrite(self.softEnums[i], w)
  # 8. Constraints
  writeCount(self.constraints.len, w)
  for i in 0 ..< self.constraints.len:
    packetWrite(self.constraints[i], w)
