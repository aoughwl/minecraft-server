## Port of pumpkin-protocol/src/bedrock/client/boss_event.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CBossEventPacketId* = 74'i32

type
  BossEventActionKind* = enum
    beaAdd
    beaRemove
    beaUpdateHealth
    beaUpdateTitle
    beaUpdateProperties

  BossEventAction* = object
    ## `Add { title, health_percent, color, overlay }`, `Remove`, `UpdateHealth(f32)`, `UpdateTitle(String)`
    ## and `UpdateProperties { color, overlay }`, in one object: each variant uses the fields it names.
    kind*: BossEventActionKind
    title*: string          ## Add, UpdateTitle
    healthPercent*: float32 ## Add, UpdateHealth
    color*: VarInt          ## Add, UpdateProperties
    overlay*: VarInt        ## Add, UpdateProperties

  CBossEvent* = object
    bossEntityId*: VarLong
    action*: BossEventAction

proc packetWrite*(self: CBossEvent; w: var NetWriter) =
  ## The packet always writes title twice (title and filtered title), the health, then color and overlay as
  ## single bytes, with the fields a variant does not carry zeroed.
  packetWrite(self.bossEntityId, w)
  packetWrite(newVarLong(0'i64), w) # player_entity_id
  var eventType = 0'u8
  var title = ""
  var healthPercent = 0.0'f32
  var color = 0'u8
  var overlay = 0'u8
  case self.action.kind
  of beaAdd:
    eventType = 0'u8
    title = self.action.title
    healthPercent = self.action.healthPercent
    color = uint8(self.action.color.value and 0xFF)
    overlay = uint8(self.action.overlay.value and 0xFF)
  of beaRemove:
    eventType = 2'u8
  of beaUpdateHealth:
    eventType = 3'u8
    healthPercent = self.action.healthPercent
  of beaUpdateTitle:
    eventType = 4'u8
    title = self.action.title
  of beaUpdateProperties:
    eventType = 5'u8
    color = uint8(self.action.color.value and 0xFF)
    overlay = uint8(self.action.overlay.value and 0xFF)
  packetWrite(eventType, w)
  packetWrite(title, w) # title
  packetWrite(title, w) # filtered_title
  packetWrite(healthPercent, w)
  packetWrite(color, w)
  packetWrite(overlay, w)
