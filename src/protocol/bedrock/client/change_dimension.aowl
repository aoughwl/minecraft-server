## Port of pumpkin-protocol/src/bedrock/client/change_dimension.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const CChangeDimensionPacketId* = 61'i32

type
  CChangeDimension* = object
    dimension*: VarInt
    position*: Vector3[float32]
    respawn*: bool
    hasLoadingScreenId*: bool

proc newCChangeDimension*(dimension: int32; position: Vector3[float32]; respawn: bool): CChangeDimension =
  CChangeDimension(dimension: newVarInt(dimension), position: position, respawn: respawn, hasLoadingScreenId: false)

proc packetWrite*(self: CChangeDimension; w: var NetWriter) =
  packetWrite(self.dimension, w)
  packetWrite(self.position, w)
  packetWrite(self.respawn, w)
  packetWrite(self.hasLoadingScreenId, w)
