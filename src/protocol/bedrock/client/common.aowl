## Port of pumpkin-protocol/src/bedrock/client/common.rs
## Shapes shared by several clientbound packets. Both are derived `PacketWrite`: fields in order, little-endian.

import ../../protobase, ../../netcodec, ../../serial, ../../varint

type
  AbilityLayer* = object
    serializedLayer*: uint16
    abilitiesSet*: uint32
    abilityValue*: uint32
    flySpeed*: float32
    verticalFlySpeed*: float32
    walkSpeed*: float32

  EntityLink* = object
    riddenUniqueId*: VarLong
    riderUniqueId*: VarLong
    linkType*: uint8
    immediate*: bool
    riderInitiated*: bool
    vehicleAngularVelocity*: float32

proc packetWrite*(self: AbilityLayer; w: var NetWriter) =
  packetWrite(self.serializedLayer, w)
  packetWrite(self.abilitiesSet, w)
  packetWrite(self.abilityValue, w)
  packetWrite(self.flySpeed, w)
  packetWrite(self.verticalFlySpeed, w)
  packetWrite(self.walkSpeed, w)

proc packetWrite*(self: EntityLink; w: var NetWriter) =
  packetWrite(self.riddenUniqueId, w)
  packetWrite(self.riderUniqueId, w)
  packetWrite(self.linkType, w)
  packetWrite(self.immediate, w)
  packetWrite(self.riderInitiated, w)
  packetWrite(self.vehicleAngularVelocity, w)
