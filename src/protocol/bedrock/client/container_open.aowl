## Port of pumpkin-protocol/src/bedrock/client/container_open.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position

const CContainerOpenPacketId* = 46'i32

type
  CContainerOpen* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/ContainerOpenPacket.html
    containerId*: uint8
    containerType*: uint8
    position*: BlockPos
    targetEntityId*: VarLong

proc packetWrite*(self: CContainerOpen; w: var NetWriter) =
  packetWrite(self.containerId, w)
  packetWrite(self.containerType, w)
  packetWrite(self.position, w)
  packetWrite(self.targetEntityId, w)
