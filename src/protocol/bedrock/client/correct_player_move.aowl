## Port of pumpkin-protocol/src/bedrock/client/correct_player_move.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const CCorrectPlayerMovePacketId* = 161'i32

type
  CCorrectPlayerMove* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/CorrectPlayerMovePredictionPacket.html
    predictionType*: uint8
    pos*: Vector3[float32]
    posDelta*: Vector3[float32]
    onGround*: bool
    tick*: VarULong

proc packetWrite*(self: CCorrectPlayerMove; w: var NetWriter) =
  packetWrite(self.predictionType, w)
  packetWrite(self.pos, w)
  packetWrite(self.posDelta, w)
  packetWrite(self.onGround, w)
  packetWrite(self.tick, w)
