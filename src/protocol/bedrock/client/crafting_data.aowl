## Port of pumpkin-protocol/src/bedrock/client/crafting_data.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const CCraftingDataPacketId* = 52'i32

type
  ItemDescriptorCount* = object
    networkId*: int16
    metadataValue*: int16
    count*: int32

  RecipeUnlockRequirement* = object
    context*: uint8

  BedrockShapelessRecipe* = object
    recipeId*: string
    input*: seq[ItemDescriptorCount]
    output*: seq[NetworkItemDescriptor]
    uuid*: array[16, uint8]
    blockName*: string ## upstream field `block`; `block` is a keyword here
    priority*: VarInt
    unlockRequirement*: RecipeUnlockRequirement
    recipeNetworkId*: VarUInt

  BedrockShapedRecipe* = object
    recipeId*: string
    width*: VarInt
    height*: VarInt
    input*: seq[ItemDescriptorCount]
    output*: seq[NetworkItemDescriptor]
    uuid*: array[16, uint8]
    blockName*: string ## upstream field `block`; `block` is a keyword here
    priority*: VarInt
    assumeSymmetry*: bool
    unlockRequirement*: RecipeUnlockRequirement
    recipeNetworkId*: VarUInt

  BedrockRecipeKind* = enum
    brShapeless
    brShaped

  BedrockRecipe* = object
    case kind*: BedrockRecipeKind
    of brShapeless: shapeless*: BedrockShapelessRecipe
    of brShaped: shaped*: BedrockShapedRecipe

  CCraftingData* = object
    recipes*: seq[BedrockRecipe]
    cleanRecipes*: bool

proc packetWrite*(self: ItemDescriptorCount; w: var NetWriter) =
  if self.networkId == 0'i16:
    # Invalid item descriptor (type 0)
    packetWrite(0'u8, w)
  else:
    # Default item descriptor (type 1)
    packetWrite(1'u8, w)
    packetWrite(self.networkId, w)
    packetWrite(self.metadataValue, w)
  packetWrite(newVarInt(self.count), w)

proc packetWrite*(self: RecipeUnlockRequirement; w: var NetWriter) =
  packetWrite(self.context, w)

proc writeUuid16(u: array[16, uint8]; w: var NetWriter) =
  for b in u:
    writeU8(w, b)

proc packetWrite*(self: BedrockShapelessRecipe; w: var NetWriter) =
  packetWrite(self.recipeId, w)
  # input slice with VarUInt length prefix
  packetWrite(newVarUInt(uint32(self.input.len)), w)
  for i in 0 ..< self.input.len:
    packetWrite(self.input[i], w)
  # output slice with VarUInt length prefix
  packetWrite(newVarUInt(uint32(self.output.len)), w)
  for i in 0 ..< self.output.len:
    packetWrite(self.output[i], w)
  writeUuid16(self.uuid, w)
  packetWrite(self.blockName, w)
  packetWrite(self.priority, w)
  packetWrite(self.unlockRequirement, w)
  packetWrite(self.recipeNetworkId, w)

proc packetWrite*(self: BedrockShapedRecipe; w: var NetWriter) =
  packetWrite(self.recipeId, w)
  packetWrite(self.width, w)
  packetWrite(self.height, w)
  # input slice: width * height elements sequentially (no count prefix)
  for i in 0 ..< self.input.len:
    packetWrite(self.input[i], w)
  # output slice with VarUInt length prefix
  packetWrite(newVarUInt(uint32(self.output.len)), w)
  for i in 0 ..< self.output.len:
    packetWrite(self.output[i], w)
  writeUuid16(self.uuid, w)
  packetWrite(self.blockName, w)
  packetWrite(self.priority, w)
  packetWrite(self.assumeSymmetry, w)
  packetWrite(self.unlockRequirement, w)
  packetWrite(self.recipeNetworkId, w)

proc packetWrite*(self: BedrockRecipe; w: var NetWriter) =
  case self.kind
  of brShapeless:
    packetWrite(newVarInt(0'i32), w) # type 0: Shapeless
    packetWrite(self.shapeless, w)
  of brShaped:
    packetWrite(newVarInt(1'i32), w) # type 1: Shaped
    packetWrite(self.shaped, w)

proc packetWrite*(self: CCraftingData; w: var NetWriter) =
  # recipes slice with VarUInt prefix
  packetWrite(newVarUInt(uint32(self.recipes.len)), w)
  for i in 0 ..< self.recipes.len:
    packetWrite(self.recipes[i], w)
  # potion recipes count prefix (0)
  packetWrite(newVarUInt(0'u32), w)
  # potion container change recipes count prefix (0)
  packetWrite(newVarUInt(0'u32), w)
  # material reducers count prefix (0)
  packetWrite(newVarUInt(0'u32), w)
  packetWrite(self.cleanRecipes, w)
