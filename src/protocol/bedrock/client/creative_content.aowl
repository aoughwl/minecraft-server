## Port of pumpkin-protocol/src/bedrock/client/creative_content.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const CCreativeContentPacketId* = 145'i32

type
  CreativeCategory* = enum
    ## `#[repr(i32)]`; written as a little-endian i32 (not a VarInt) of the variant's value.
    ccConstruction = 1
    ccNature = 2
    ccEquipment = 3
    ccItems = 4
    ccCommandOnly = 5
    ccUndefined = 6

  Group* = object
    creativeCategory*: CreativeCategory
    name*: string
    iconItem*: NetworkItemDescriptor

  Entry* = object
    id*: VarUInt
    item*: NetworkItemDescriptor
    groupIndex*: VarUInt

  CCreativeContent* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/CreativeContentPacket.html
    groups*: seq[Group]
    entries*: seq[Entry]

proc packetWrite*(self: CreativeCategory; w: var NetWriter) =
  packetWrite(int32(ord(self)), w)

proc packetWrite*(self: Group; w: var NetWriter) =
  packetWrite(self.creativeCategory, w)
  packetWrite(self.name, w)
  packetWrite(self.iconItem, w)

proc packetWrite*(self: Entry; w: var NetWriter) =
  packetWrite(self.id, w)
  packetWrite(self.item, w)
  packetWrite(self.groupIndex, w)

proc packetWrite*(self: CCreativeContent; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(self.groups.len)), w)
  for i in 0 ..< self.groups.len:
    packetWrite(self.groups[i], w)
  packetWrite(newVarUInt(uint32(self.entries.len)), w)
  for i in 0 ..< self.entries.len:
    packetWrite(self.entries[i], w)
