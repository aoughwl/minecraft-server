## Port of pumpkin-protocol/src/bedrock/client/disconnect_player.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CDisconnectPlayerPacketId* = 5'i32

type
  CDisconnectPlayer* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/DisconnectPacket.html
    reason*: VarInt
    skipMessage*: bool
    message*: string
    filteredMessage*: string

proc newCDisconnectPlayer*(reason: int32; message: string): CDisconnectPlayer =
  ## An empty message sets `skipMessage`, and then neither message is written.
  CDisconnectPlayer(reason: newVarInt(reason), skipMessage: message.len == 0, message: message,
    filteredMessage: "")

proc packetWrite*(self: CDisconnectPlayer; w: var NetWriter) =
  packetWrite(self.reason, w)
  packetWrite(self.skipMessage, w)
  if not self.skipMessage:
    packetWrite(self.message, w)
    packetWrite(self.filteredMessage, w)
