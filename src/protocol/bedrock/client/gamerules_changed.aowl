## Port of pumpkin-protocol/src/bedrock/client/gamerules_changed.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CGamerulesChangedPacketId* = 0x48'i32

type
  GameRules* = object
    ## TODO upstream: https://mojang.github.io/bedrock-protocol-docs/html/GameRulesChangedPacketData.html
    ## Only the list size is modelled, so the list is always empty.
    listSize*: VarUInt

  CGamerulesChanged* = object
    ruleData*: GameRules

proc packetWrite*(self: GameRules; w: var NetWriter) =
  packetWrite(self.listSize, w)

proc packetWrite*(self: CGamerulesChanged; w: var NetWriter) =
  packetWrite(self.ruleData, w)
