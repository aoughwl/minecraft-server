## Port of pumpkin-protocol/src/bedrock/client/inventory_content.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const CInventoryContentPacketId* = 49'i32

type
  CInventoryContent* = object
    ## https://mojang.github.io/bedrock-protocol-docs/docs/InventoryContentPacket.html
    containerId*: VarUInt
    slots*: seq[NetworkItemStackDescriptor]
    fullContainerName*: FullContainerName
    storageItem*: NetworkItemStackDescriptor

proc packetWrite*(self: CInventoryContent; w: var NetWriter) =
  packetWrite(self.containerId, w)
  packetWrite(newVarUInt(uint32(self.slots.len)), w)
  for i in 0 ..< self.slots.len:
    packetWrite(self.slots[i], w)
  packetWrite(self.fullContainerName, w)
  packetWrite(self.storageItem, w)
