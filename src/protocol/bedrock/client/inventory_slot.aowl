## Port of pumpkin-protocol/src/bedrock/client/inventory_slot.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const CInventorySlotPacketId* = 50'i32

type
  CInventorySlot* = object
    windowId*: VarUInt
    inventorySlot*: VarUInt
    containerName*: Option[FullContainerName]
    storage*: Option[NetworkItemStackDescriptor]
    item*: NetworkItemStackDescriptor

proc packetWrite*(self: CInventorySlot; w: var NetWriter) =
  packetWrite(self.windowId, w)
  packetWrite(self.inventorySlot, w)
  packetWrite(self.containerName.isSome, w)
  if self.containerName.isSome:
    packetWrite(self.containerName.unsafeGet, w)
  packetWrite(self.storage.isSome, w)
  if self.storage.isSome:
    packetWrite(self.storage.unsafeGet, w)
  packetWrite(self.item, w)
