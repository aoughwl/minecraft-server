## Port of pumpkin-protocol/src/bedrock/client/item_registry.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CItemRegistryPacketId* = 162'i32

type
  ItemDefinition* = object
    name*: string
    id*: int16
    componentBased*: bool
    itemVersion*: VarInt
    ## Normally would be `Nbt`, but for simplicity elsewhere, this is preserialized (via `Nbt::write_bedrock`).
    ## `#[serial(no_prefix)]`: written as raw bytes.
    componentData*: seq[byte]

  CItemRegistry* = object
    ## https://mojang.github.io/bedrock-protocol-docs/docs/ItemRegistryPacket.html
    items*: seq[ItemDefinition]

proc packetWrite*(self: ItemDefinition; w: var NetWriter) =
  packetWrite(self.name, w)
  packetWrite(self.id, w)
  packetWrite(self.componentBased, w)
  packetWrite(self.itemVersion, w)
  writeSlice(w, self.componentData)

proc packetWrite*(self: CItemRegistry; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(self.items.len)), w)
  for i in 0 ..< self.items.len:
    packetWrite(self.items[i], w)
