## Port of pumpkin-protocol/src/bedrock/client/item_stack_response.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const CItemStackResponsePacketId* = 148'i32

type
  ItemStackResponseSlotInfo* = object
    slot*: uint8
    hotbarSlot*: uint8
    count*: uint8
    itemStackId*: VarInt
    customName*: string
    filteredCustomName*: string
    durabilityCorrection*: VarInt

  ItemStackResponseContainerInfo* = object
    containerName*: FullContainerName
    slots*: seq[ItemStackResponseSlotInfo]

  ItemStackResponse* = object
    result*: uint8 ## 0 = SUCCESS, 1 = ERROR
    requestId*: VarInt
    containerInfos*: seq[ItemStackResponseContainerInfo]

  CItemStackResponse* = object
    responses*: seq[ItemStackResponse]

proc packetWrite*(self: ItemStackResponseSlotInfo; w: var NetWriter) =
  packetWrite(self.slot, w)
  packetWrite(self.hotbarSlot, w)
  packetWrite(self.count, w)
  packetWrite(self.itemStackId, w)
  packetWrite(self.customName, w)
  packetWrite(self.filteredCustomName, w)
  packetWrite(self.durabilityCorrection, w)

proc packetWrite*(self: ItemStackResponseContainerInfo; w: var NetWriter) =
  packetWrite(self.containerName, w)
  packetWrite(newVarUInt(uint32(self.slots.len)), w)
  for i in 0 ..< self.slots.len:
    packetWrite(self.slots[i], w)

proc packetWrite*(self: ItemStackResponse; w: var NetWriter) =
  ## The container infos are written only for a success (`result == 0`).
  packetWrite(self.result, w)
  packetWrite(self.requestId, w)
  if self.result == 0'u8:
    packetWrite(newVarUInt(uint32(self.containerInfos.len)), w)
    for i in 0 ..< self.containerInfos.len:
      packetWrite(self.containerInfos[i], w)

proc packetWrite*(self: CItemStackResponse; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(self.responses.len)), w)
  for i in 0 ..< self.responses.len:
    packetWrite(self.responses[i], w)
