## Port of pumpkin-protocol/src/bedrock/client/level_chunk.rs
##
## `CLevelChunk` borrows a `ChunkData` and writes its block and biome palettes in the Bedrock sub chunk
## layout: version 9, one storage per sub chunk, bits-per-entry with the runtime flag, the packed little-endian
## u32 words, then the palette as VarInts. Block ids go through `BlockState::to_be_network_id` and biome ids
## through `Biome::be_network_id` (1 for an unknown biome), as upstream's `convert_be_network` does; the
## palette conversion itself is world/palette.aowl's `blockConvertBeNetwork` / `biomeConvertBeNetwork`.
##
## The packet is written with no locking: upstream takes the `RwLock`s of `block_sections` and
## `biome_sections`, whose poisoning is its only error; plain fields here.

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../world/chunkdata
import ../../../world/palette
import ../../../generated/biome as genbiome
import ../../../generated/block_properties
import ../../../data/block_state

const
  CLevelChunkPacketId* = 58'i32
  Version = 9'u8

type
  CLevelChunk* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/LevelChunkPacket.html
    ## https://gist.github.com/Tomcc/a96af509e275b1af483b25c543cfbf37
    dimension*: int32
    cacheEnabled*: bool
    chunk*: ChunkData

proc mapBlock(v: uint32): uint32 =
  uint32(toBeNetworkId(BlockStateId(uint16(v))))

proc mapBiome(v: uint32): uint32 =
  let b = Biome.fromId(uint8(v))
  if b == nil: 1'u32 else: uint32(b.beNetworkId)

proc writeNetworkPalette(repr: BeNetworkSerialization; w: var NetWriter) =
  ## The part of the loop body shared by blocks and biomes.
  packetWrite(uint8((repr.bitsPerEntry shl 1) or 1'u8), w)
  for word in repr.packedData:
    packetWrite(word, w)
  case repr.paletteKind
  of npSingle:
    packetWrite(newVarInt(int32(repr.value)), w)
  of npIndirect:
    packetWrite(newVarInt(int32(repr.values.len)), w)
    for id in repr.values:
      packetWrite(newVarInt(int32(id)), w)
  of npDirect:
    discard

proc packetWrite*(self: CLevelChunk; w: var NetWriter) =
  packetWrite(newVarInt(self.chunk.x), w)
  packetWrite(newVarInt(self.chunk.z), w)
  packetWrite(newVarInt(self.dimension), w)
  let subChunkCount = uint32(self.chunk.section.count)
  packetWrite(newVarUInt(subChunkCount), w)
  packetWrite(self.cacheEnabled, w)
  var chunkData = newNetWriter()
  let minYSection = int8(self.chunk.section.minY shr 4)
  let numStorages = 1'u8
  for i in 0 ..< self.chunk.section.blockSections.len:
    # Version 9: [version:byte][num_storages:byte][sub_chunk_index:byte]
    let y = cast[uint8](int8(i) + minYSection)
    writeU8(chunkData, Version)
    writeU8(chunkData, numStorages)
    writeU8(chunkData, y)
    let repr = blockConvertBeNetwork(self.chunk.section.blockSections[i], mapBlock)
    writeNetworkPalette(repr, chunkData)
  for i in 0 ..< self.chunk.section.biomeSections.len:
    let y = cast[uint8](int8(i) + minYSection)
    writeU8(chunkData, Version)
    writeU8(chunkData, numStorages)
    writeU8(chunkData, y)
    let repr = biomeConvertBeNetwork(self.chunk.section.biomeSections[i], mapBiome)
    writeNetworkPalette(repr, chunkData)
  writeU8(chunkData, 0'u8)
  packetWrite(newVarUInt(uint32(chunkData.buf.len)), w)
  writeSlice(w, chunkData.buf)
