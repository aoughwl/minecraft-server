## Port of pumpkin-protocol/src/bedrock/client/level_event.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const
  CLevelEventPacketId* = 25'i32
  ## `LevelEvent` (`#[repr(i32)]`): there are hundreds, upstream adds only what it needs.
  LevelEventBlockStartBreak* = 3600'i32
  LevelEventBlockStopBreak* = 3601'i32
  LevelEventBlockUpdateBreak* = 3602'i32

type
  CLevelEvent* = object
    eventId*: VarInt
    position*: Vector3[float32]
    data*: VarInt

proc packetWrite*(self: CLevelEvent; w: var NetWriter) =
  packetWrite(self.eventId, w)
  packetWrite(self.position, w)
  packetWrite(self.data, w)
