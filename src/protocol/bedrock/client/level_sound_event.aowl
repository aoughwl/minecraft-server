## Port of pumpkin-protocol/src/bedrock/client/level_sound_event.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const CLevelSoundEventPacketId* = 123'i32 # upstream's pinned tree has 27, which is ActorEvent; the newer tree's #[packet(123)] is Mojang's id

type
  CLevelSoundEvent* = object
    soundId*: VarUInt
    position*: Vector3[float32]
    extraData*: VarInt
    entityType*: string
    isBabyMob*: bool
    isGlobal*: bool

proc packetWrite*(self: CLevelSoundEvent; w: var NetWriter) =
  packetWrite(self.soundId, w)
  packetWrite(self.position, w)
  packetWrite(self.extraData, w)
  packetWrite(self.entityType, w)
  packetWrite(self.isBabyMob, w)
  packetWrite(self.isGlobal, w)
