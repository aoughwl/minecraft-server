## Port of pumpkin-protocol/src/bedrock/client/modal_form_request.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CModalFormRequestPacketId* = 100'i32

type
  CModalFormRequest* = object
    formId*: VarInt
    formData*: string

proc packetWrite*(self: CModalFormRequest; w: var NetWriter) =
