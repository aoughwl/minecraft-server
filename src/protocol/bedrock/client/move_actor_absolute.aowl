## Port of pumpkin-protocol/src/bedrock/client/move_actor_absolute.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const
  CMoveActorAbsolutePacketId* = 18'i32
  CMoveActorAbsoluteFlagOnGround* = 0x01'u8
  CMoveActorAbsoluteFlagTeleport* = 0x02'u8
  CMoveActorAbsoluteFlagForceMove* = 0x04'u8

type
  CMoveActorAbsolute* = object
    entityRuntimeId*: VarULong
    flags*: uint8
    position*: Vector3[float32]
    pitch*: uint8
    yaw*: uint8
    headYaw*: uint8

proc newCMoveActorAbsolute*(entityRuntimeId: VarULong; flags: uint8; position: Vector3[float32];
    pitch, yaw, headYaw: uint8): CMoveActorAbsolute =
  CMoveActorAbsolute(entityRuntimeId: entityRuntimeId, flags: flags, position: position, pitch: pitch, yaw: yaw,
    headYaw: headYaw)

proc packetWrite*(self: CMoveActorAbsolute; w: var NetWriter) =
  packetWrite(self.entityRuntimeId, w)
  packetWrite(self.flags, w)
  packetWrite(self.position, w)
  packetWrite(self.pitch, w)
  packetWrite(self.yaw, w)
  packetWrite(self.headYaw, w)
