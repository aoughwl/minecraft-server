## Port of pumpkin-protocol/src/bedrock/client/move_actor_delta.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const
  CMoveActorDeltaPacketId* = 111'i32
  MOVE_ACTOR_DELTA_FLAG_HAS_X* = 0x0001'u16
  MOVE_ACTOR_DELTA_FLAG_HAS_Y* = 0x0002'u16
  MOVE_ACTOR_DELTA_FLAG_HAS_Z* = 0x0004'u16
  MOVE_ACTOR_DELTA_FLAG_HAS_PITCH* = 0x0008'u16
  MOVE_ACTOR_DELTA_FLAG_HAS_YAW* = 0x0010'u16
  MOVE_ACTOR_DELTA_FLAG_HAS_HEAD_YAW* = 0x0020'u16
  MOVE_ACTOR_DELTA_FLAG_ON_GROUND* = 0x0040'u16
  MOVE_ACTOR_DELTA_FLAG_TELEPORT* = 0x0080'u16
  MOVE_ACTOR_DELTA_FLAG_FORCE_MOVE* = 0x0100'u16

type
  CMoveActorDelta* = object
    entityRuntimeId*: VarULong
    flags*: uint16
    x*: float32
    y*: float32
    z*: float32
    pitch*: uint8
    yaw*: uint8
    headYaw*: uint8

proc newCMoveActorDelta*(entityRuntimeId: VarULong; flags: uint16; x, y, z: float32;
    pitch, yaw, headYaw: uint8): CMoveActorDelta =
  CMoveActorDelta(entityRuntimeId: entityRuntimeId, flags: flags, x: x, y: y, z: z, pitch: pitch, yaw: yaw,
    headYaw: headYaw)

proc packetWrite*(self: CMoveActorDelta; w: var NetWriter) =
  ## Only the components named by `flags` are written.
  packetWrite(self.entityRuntimeId, w)
  packetWrite(self.flags, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_X) != 0'u16:
    packetWrite(self.x, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_Y) != 0'u16:
    packetWrite(self.y, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_Z) != 0'u16:
    packetWrite(self.z, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_PITCH) != 0'u16:
    packetWrite(self.pitch, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_YAW) != 0'u16:
    packetWrite(self.yaw, w)
  if (self.flags and MOVE_ACTOR_DELTA_FLAG_HAS_HEAD_YAW) != 0'u16:
    packetWrite(self.headYaw, w)
