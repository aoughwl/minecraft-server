## Port of pumpkin-protocol/src/bedrock/client/move_player.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const
  CMovePlayerPacketId* = 19'i32
  CMovePlayerModeNormal* = 0'u8
  CMovePlayerModeReset* = 1'u8
  CMovePlayerModeTeleport* = 2'u8
  CMovePlayerModeRotation* = 3'u8

type
  CMovePlayer* = object
    playerRuntimeId*: VarULong
    position*: Vector3[float32]
    pitch*: float32
    yaw*: float32
    headYaw*: float32
    mode*: uint8
    onGround*: bool
    ridingRuntimeId*: VarULong
    teleportCause*: int32
    teleportSourceEntityType*: int32
    tick*: VarULong

proc newCMovePlayer*(playerRuntimeId: VarULong; position: Vector3[float32]; pitch, yaw, headYaw: float32;
    mode: uint8; onGround: bool; ridingRuntimeId: VarULong; teleportCause, teleportSourceEntityType: int32;
    tick: VarULong): CMovePlayer =
  CMovePlayer(playerRuntimeId: playerRuntimeId, position: position, pitch: pitch, yaw: yaw, headYaw: headYaw,
    mode: mode, onGround: onGround, ridingRuntimeId: ridingRuntimeId, teleportCause: teleportCause,
    teleportSourceEntityType: teleportSourceEntityType, tick: tick)

proc packetWrite*(self: CMovePlayer; w: var NetWriter) =
  ## The teleport cause and source type are written only in teleport mode.
  packetWrite(self.playerRuntimeId, w)
  packetWrite(self.position, w)
  packetWrite(self.pitch, w)
  packetWrite(self.yaw, w)
  packetWrite(self.headYaw, w)
  packetWrite(self.mode, w)
  packetWrite(self.onGround, w)
  packetWrite(self.ridingRuntimeId, w)
  if self.mode == CMovePlayerModeTeleport:
    packetWrite(self.teleportCause, w)
    packetWrite(self.teleportSourceEntityType, w)
  packetWrite(self.tick, w)
