## Port of pumpkin-protocol/src/bedrock/client/network_chunk_publisher_update.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position
import ../../../util/vector2

const CNetworkChunkPublisherUpdatePacketId* = 121'i32

type
  CNetworkChunkPublisherUpdate* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/NetworkChunkPublisherUpdatePacket.html
    posForView*: BlockPos
    newRadius*: VarUInt ## Is in blocks, not chunks!
    serverBuildChunkList*: seq[Vector2[int32]] ## TODO upstream

proc newCNetworkChunkPublisherUpdate*(posForView: BlockPos; newRadius: uint32): CNetworkChunkPublisherUpdate =
  CNetworkChunkPublisherUpdate(posForView: posForView, newRadius: newVarUInt(newRadius), serverBuildChunkList: @[])

proc packetWrite*(self: CNetworkChunkPublisherUpdate; w: var NetWriter) =
  ## The chunk list count is a little-endian u32 (`len as u32`), not a VarUInt.
  packetWrite(self.posForView, w)
  packetWrite(self.newRadius, w)
  packetWrite(uint32(self.serverBuildChunkList.len), w)
  for i in 0 ..< self.serverBuildChunkList.len:
    packetWrite(newVarInt(self.serverBuildChunkList[i].x), w)
    packetWrite(newVarInt(self.serverBuildChunkList[i].y), w)
