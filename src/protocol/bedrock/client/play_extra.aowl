## Port of pumpkin-protocol/src/bedrock/client/{mob_equipment,mob_armor_equipment,mob_effect}.rs and
## server/respawn.rs of the NEWER upstream tree (../ref/pumpkin); the pinned tree has none of them. Plus `CActorEvent`, the
## clientbound `ActorEvent` (id 27), which the pinned tree only has as a serverbound-named writer (server/actor_event.aowl).
##
## EVIDENCE. None of these has bytes captured from a real client in either upstream tree: the upstream tests build the packet
## and decode it again, or (mob_armor_equipment) assert the empty-descriptor bytes the writer gives. The layouts are Mojang's
## field order as the newer upstream writes it; they are used here with the 1001 item stack form (`NetworkItemStackDescriptor`
## of network_item.aowl), which is what the 1001 inventory packets in this server already carry. GUESSED for 1001:
## `CMobEffect` (the later trailing `ambient` bool of the 1.26.60 tree is not written) and `CMobArmorEquipment`'s body slot.
## The packet ids are the newer tree's `#[packet(N)]`: ActorEvent 27, MobEffect 28, MobEquipment 31, MobArmorEquipment 32,
## Respawn 45.

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3
import ../network_item

const
  CActorEventPacketId* = 27'i32
  CMobEffectPacketId* = 28'i32
  CMobEquipmentPacketId* = 31'i32
  CMobArmorEquipmentPacketId* = 32'i32
  RespawnPacketId* = 45'i32 ## `SRespawn`: the same packet both ways.

  MobEffectAdd* = 1'u8
  MobEffectModify* = 2'u8
  MobEffectRemove* = 3'u8

  ActorEventHurt* = 2'u8
  ActorEventDeath* = 3'u8

type
  CActorEvent* = object
    targetRuntimeId*: VarULong
    eventId*: uint8
    data*: VarInt

  CMobEffect* = object
    targetRuntimeId*: VarULong
    eventId*: uint8
    effectId*: VarInt
    effectAmplifier*: VarInt
    showParticles*: bool
    effectDurationTicks*: VarInt
    tick*: VarULong

  CMobEquipment* = object
    targetRuntimeId*: VarULong
    item*: NetworkItemStackDescriptor
    slot*: uint8
    selectedSlot*: uint8
    containerId*: uint8

  CMobArmorEquipment* = object
    targetRuntimeId*: VarULong
    head*, chest*, legs*, feet*, body*: NetworkItemStackDescriptor

  RespawnState* = enum
    rsSearchingForSpawn
    rsReadyToSpawn
    rsClientReadyToSpawn

  SRespawn* = object
    position*: Vector3[float32]
    state*: RespawnState
    playerRuntimeId*: VarULong

proc packetWrite*(self: CActorEvent; w: var NetWriter) =
  packetWrite(self.targetRuntimeId, w)
  packetWrite(self.eventId, w)
  packetWrite(self.data, w)

proc packetWrite*(self: CMobEffect; w: var NetWriter) =
  packetWrite(self.targetRuntimeId, w)
  packetWrite(self.eventId, w)
  packetWrite(self.effectId, w)
  packetWrite(self.effectAmplifier, w)
  packetWrite(self.showParticles, w)
  packetWrite(self.effectDurationTicks, w)
  packetWrite(self.tick, w)

proc packetWrite*(self: CMobEquipment; w: var NetWriter) =
  packetWrite(self.targetRuntimeId, w)
  packetWrite(self.item, w)
  packetWrite(self.slot, w)
  packetWrite(self.selectedSlot, w)
  packetWrite(self.containerId, w)

proc packetWrite*(self: CMobArmorEquipment; w: var NetWriter) =
  packetWrite(self.targetRuntimeId, w)
  packetWrite(self.head, w)
  packetWrite(self.chest, w)
  packetWrite(self.legs, w)
  packetWrite(self.feet, w)
  packetWrite(self.body, w)

proc packetWrite*(self: SRespawn; w: var NetWriter) =
  packetWrite(self.position, w)
  packetWrite(uint8(ord(self.state)), w)
  packetWrite(self.playerRuntimeId, w)

proc packetRead*(_: typedesc[SRespawn]; r: var NetReader): ProtoReadResult[SRespawn] =
  let position = tryRead(SRespawn, packetRead(Vector3[float32], r))
  let state = tryRead(SRespawn, packetRead(uint8, r))
  if state > 2'u8:
    return readErr[SRespawn](messageRead("Invalid respawn state: " & $state))
  let runtimeId = tryRead(SRespawn, packetRead(VarULong, r))
  readOk(SRespawn(position: position, state: RespawnState(int(state)), playerRuntimeId: runtimeId))
