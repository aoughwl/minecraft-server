## Port of pumpkin-protocol/src/bedrock/client/play_status.rs

import ../../protobase, ../../netcodec, ../../serial

const CPlayStatusPacketId* = 2'i32

type
  CPlayStatus* = enum
    ## The variant's value is what goes on the wire, as a BIG-endian i32 (`(*self as i32).write_be`).
    cpsLoginSuccess = 0
    cpsOutdatedClient = 1
    cpsOutdatedServer = 2
    cpsPlayerSpawn = 3
    cpsInvalidTenant = 4
    cpsEditionMismatchEduToVanilla = 5
    cpsEditionMismatchVanillaToEdu = 6
    cpsServerFullSubClient = 7
    cpsEditorMismatchEditorToVanilla = 8
    cpsEditorMismatchVanillaToEditor = 9

proc packetWrite*(self: CPlayStatus; w: var NetWriter) =
  packetWriteBe(int32(ord(self)), w)
