## Port of pumpkin-protocol/src/bedrock/client/player_hotbar.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CPlayerHotbarPacketId* = 48'i32

type
  CPlayerHotbar* = object
    selectedSlot*: VarUInt
    containerId*: uint8
    shouldSelectBlock*: bool

proc packetWrite*(self: CPlayerHotbar; w: var NetWriter) =
  packetWrite(self.selectedSlot, w)
  packetWrite(self.containerId, w)
  packetWrite(self.shouldSelectBlock, w)
