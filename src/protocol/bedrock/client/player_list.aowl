## Port of pumpkin-protocol/src/bedrock/client/player_list.rs
## `CPlayerList` writes through a `ProtoWriteVoidResult`: an action other than add or remove is an error
## ("Invalid PlayerList action"), reported after the action byte and the entry count have been written.

import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../uuid

const
  CPlayerListPacketId* = 63'i32
  CPlayerListActionAdd* = 0'u8
  CPlayerListActionRemove* = 1'u8

type
  SkinAnimation* = object
    imageWidth*: uint32
    imageHeight*: uint32
    imageData*: seq[byte]
    animationType*: uint32
    frames*: float32
    expressionType*: uint32

  PersonaPiece* = object
    pieceId*: string
    pieceType*: string
    packId*: string
    isDefault*: bool
    productId*: string

  PieceTintColor* = object
    pieceType*: string
    colors*: seq[string]

  Skin* = object
    skinId*: string
    playFabId*: string
    resourcePatch*: seq[byte]
    imageWidth*: uint32
    imageHeight*: uint32
    skinData*: seq[byte]
    animations*: seq[SkinAnimation]
    capeWidth*: uint32
    capeHeight*: uint32
    capeData*: seq[byte]
    geometryData*: seq[byte]
    animationData*: seq[byte]
    geometryDataEngineVersion*: seq[byte]
    capeId*: string
    fullId*: string
    armSize*: string
    skinColor*: string
    personaPieces*: seq[PersonaPiece]
    pieceTintColors*: seq[PieceTintColor]
    isPremium*: bool
    isPersona*: bool
    personaCapeOnClassic*: bool
    isPrimaryUser*: bool
    overrideAppearance*: bool
    isTrusted*: bool

  PlayerListEntry* = object
    uuid*: Uuid
    entityUniqueId*: VarLong
    username*: string
    xuid*: string
    platformChatId*: string
    buildPlatform*: int32
    skin*: Skin
    isTeacher*: bool
    isHost*: bool
    isSubClient*: bool
    playerColor*: array[4, uint8] ## ARGB

  CPlayerList* = object
    action*: uint8
    entries*: seq[PlayerListEntry]

proc steve*(): Skin =
  ## `Skin::steve()`: a solid white 64x64 `Standard_Custom`, so it is visible rather than transparent.
  var data = newSeq[byte](16384)
  for i in 0 ..< data.len:
    data[i] = 255'u8
  var patch: seq[byte] = @[]
  for ch in "{\"geometry\":{\"default\":\"geometry.humanoid\"}}":
    patch.add(uint8(ch))
  Skin(skinId: "Standard_Custom", playFabId: "", resourcePatch: patch, imageWidth: 64'u32, imageHeight: 64'u32,
    skinData: data, animations: @[], capeWidth: 0'u32, capeHeight: 0'u32, capeData: @[], geometryData: @[],
    animationData: @[], geometryDataEngineVersion: @[], capeId: "", fullId: "Standard_Custom", armSize: "wide",
    skinColor: "#0", personaPieces: @[], pieceTintColors: @[], isPremium: false, isPersona: false,
    personaCapeOnClassic: false, isPrimaryUser: false, overrideAppearance: false, isTrusted: true)

proc writeBytes(b: seq[byte]; w: var NetWriter) =
  ## `VarUInt(len)` then the bytes.
  packetWrite(newVarUInt(uint32(b.len)), w)
  writeSlice(w, b)

proc packetWrite*(self: SkinAnimation; w: var NetWriter) =
  ## Derived: `image_data` is a `Vec<u8>`, so it has a VarUInt length.
  packetWrite(self.imageWidth, w)
  packetWrite(self.imageHeight, w)
  writeBytes(self.imageData, w)
  packetWrite(self.animationType, w)
  packetWrite(self.frames, w)
  packetWrite(self.expressionType, w)

proc packetWrite*(self: PersonaPiece; w: var NetWriter) =
  packetWrite(self.pieceId, w)
  packetWrite(self.pieceType, w)
  packetWrite(self.packId, w)
  packetWrite(self.isDefault, w)
  packetWrite(self.productId, w)

proc packetWrite*(self: PieceTintColor; w: var NetWriter) =
  ## Derived: `colors` is a `Vec<String>`, so it has a VarUInt count.
  packetWrite(self.pieceType, w)
  packetWrite(newVarUInt(uint32(self.colors.len)), w)
  for c in self.colors:
    packetWrite(c, w)

proc packetWrite*(self: Skin; w: var NetWriter) =
  ## `is_trusted` is not part of the skin: `CPlayerList` writes it after all entries.
  packetWrite(self.skinId, w)
  packetWrite(self.playFabId, w)
  writeBytes(self.resourcePatch, w)
  packetWrite(self.imageWidth, w)
  packetWrite(self.imageHeight, w)
  writeBytes(self.skinData, w)
  packetWrite(uint32(self.animations.len), w)
  for i in 0 ..< self.animations.len:
    packetWrite(self.animations[i], w)
  packetWrite(self.capeWidth, w)
  packetWrite(self.capeHeight, w)
  writeBytes(self.capeData, w)
  writeBytes(self.geometryData, w)
  writeBytes(self.animationData, w)
  writeBytes(self.geometryDataEngineVersion, w)
  packetWrite(self.capeId, w)
  packetWrite(self.fullId, w)
  packetWrite(self.armSize, w)
  packetWrite(self.skinColor, w)
  packetWrite(uint32(self.personaPieces.len), w)
  for i in 0 ..< self.personaPieces.len:
    packetWrite(self.personaPieces[i], w)
  packetWrite(uint32(self.pieceTintColors.len), w)
  for i in 0 ..< self.pieceTintColors.len:
    packetWrite(self.pieceTintColors[i], w)
  packetWrite(self.isPremium, w)
  packetWrite(self.isPersona, w)
  packetWrite(self.personaCapeOnClassic, w)
  packetWrite(self.isPrimaryUser, w)
  packetWrite(self.overrideAppearance, w)

proc packetWrite*(self: PlayerListEntry; w: var NetWriter) =
  packetWrite(self.uuid, w)
  packetWrite(self.entityUniqueId, w)
  packetWrite(self.username, w)
  packetWrite(self.xuid, w)
  packetWrite(self.platformChatId, w)
  packetWrite(self.buildPlatform, w)
  packetWrite(self.skin, w)
  packetWrite(self.isTeacher, w)
  packetWrite(self.isHost, w)
  packetWrite(self.isSubClient, w)
  for b in self.playerColor:
    writeU8(w, b)

proc packetWrite*(self: CPlayerList; w: var NetWriter): ProtoWriteVoidResult =
  packetWrite(self.action, w)
  packetWrite(newVarUInt(uint32(self.entries.len)), w)
  case self.action
  of CPlayerListActionAdd:
    for i in 0 ..< self.entries.len:
      packetWrite(self.entries[i], w)
    for i in 0 ..< self.entries.len:
      packetWrite(self.entries[i].skin.isTrusted, w)
  of CPlayerListActionRemove:
    for i in 0 ..< self.entries.len:
      packetWrite(self.entries[i].uuid, w)
  else:
    return writeErrVoid(ioError("Invalid PlayerList action"))
  writeOkVoid()
