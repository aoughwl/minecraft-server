## Port of pumpkin-protocol/src/bedrock/client/raknet/connection.rs
## Connected RakNet packets the server sends. Ids are `#[packet(..)]`; the id byte is written by the caller.

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod, ../../rakaddr

const
  CConnectedPongPacketId* = 0x03'i32
  CConnectionRequestAcceptedPacketId* = 0x10'i32
  CAlreadyConnectedPacketId* = 0x12'i32
  CNoFreeIncomingConnectionsPacketId* = 0x14'i32
  CConnectionBannedPacketId* = 0x17'i32
  CIpRecentlyConnectedPacketId* = 0x1A'i32
  CDisconnectPacketId* = 0x15'i32

type
  CConnectedPong* = object
    ## Sent in response to a `ConnectedPing` (`0x00`) to calculate round-trip latency and synchronize time
    ## across an established connection. DEVIATION: both fields are little-endian in upstream's derive, RakNet
    ## reads them big-endian, so they are written big-endian here (like every RakNet integer in this file).
    ping*: uint64
    pong*: uint64

  CConnectionRequestAccepted* = object
    ## Sent by the server to accept an incoming `ConnectionRequest` (`0x09`). `systemAddresses` must hold
    ## ten addresses (`[SocketAddr; 10]`).
    clientAddress*: SocketAddr
    systemIndex*: uint16
    systemAddresses*: seq[SocketAddr]
    requestedTimestamp*: uint64
    timestamp*: uint64

  CAlreadyConnected* = object
    magic*: array[16, uint8]
    serverGuid*: uint64

  CNoFreeIncomingConnections* = object
    magic*: array[16, uint8]
    serverGuid*: uint64

  CConnectionBanned* = object
    magic*: array[16, uint8]
    serverGuid*: uint64

  CIpRecentlyConnected* = object
    magic*: array[16, uint8]
    serverGuid*: uint64

  CDisconnect* = object
    ## Sent by the server to initiate graceful termination of the connection session. No fields.

proc newCConnectedPong*(ping, pong: uint64): CConnectedPong =
  CConnectedPong(ping: ping, pong: pong)

proc newCConnectionRequestAccepted*(clientAddress: SocketAddr; systemIndex: uint16;
    systemAddresses: seq[SocketAddr]; requestedTimestamp, timestamp: uint64): CConnectionRequestAccepted =
  CConnectionRequestAccepted(clientAddress: clientAddress, systemIndex: systemIndex,
    systemAddresses: systemAddresses, requestedTimestamp: requestedTimestamp, timestamp: timestamp)

proc newCAlreadyConnected*(serverGuid: uint64): CAlreadyConnected =
  CAlreadyConnected(magic: RAKNET_MAGIC, serverGuid: serverGuid)

proc newCNoFreeIncomingConnections*(serverGuid: uint64): CNoFreeIncomingConnections =
  CNoFreeIncomingConnections(magic: RAKNET_MAGIC, serverGuid: serverGuid)

proc newCConnectionBanned*(serverGuid: uint64): CConnectionBanned =
  CConnectionBanned(magic: RAKNET_MAGIC, serverGuid: serverGuid)

proc newCIpRecentlyConnected*(serverGuid: uint64): CIpRecentlyConnected =
  CIpRecentlyConnected(magic: RAKNET_MAGIC, serverGuid: serverGuid)

proc packetWrite*(self: CConnectedPong; w: var NetWriter) =
  packetWriteBe(self.ping, w)
  packetWriteBe(self.pong, w)

proc packetWrite*(self: CConnectionRequestAccepted; w: var NetWriter) =
  packetWriteRakAddr(self.clientAddress, w)
  packetWriteBe(self.systemIndex, w)
  for i in 0 ..< self.systemAddresses.len:
    packetWriteRakAddr(self.systemAddresses[i], w)
  packetWriteBe(self.requestedTimestamp, w)
  packetWriteBe(self.timestamp, w)

proc writeMagicGuid(magic: array[16, uint8]; guid: uint64; w: var NetWriter) =
  for b in magic:
    writeU8(w, b)
  packetWriteBe(guid, w) # DEVIATION: upstream little-endian, RakNet big-endian

proc packetWrite*(self: CAlreadyConnected; w: var NetWriter) = writeMagicGuid(self.magic, self.serverGuid, w)
proc packetWrite*(self: CNoFreeIncomingConnections; w: var NetWriter) = writeMagicGuid(self.magic, self.serverGuid, w)
proc packetWrite*(self: CConnectionBanned; w: var NetWriter) = writeMagicGuid(self.magic, self.serverGuid, w)
proc packetWrite*(self: CIpRecentlyConnected; w: var NetWriter) = writeMagicGuid(self.magic, self.serverGuid, w)

proc packetWrite*(self: CDisconnect; w: var NetWriter) =
  ## `CDisconnect` is a unit struct with a derived `PacketWrite`: nothing is written.
  discard
