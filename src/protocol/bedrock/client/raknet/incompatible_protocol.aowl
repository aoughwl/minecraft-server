## Port of pumpkin-protocol/src/bedrock/client/raknet/incompatible_protocol.rs

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod

const CIncompatibleProtocolVersionPacketId* = 0x19'i32

type
  CIncompatibleProtocolVersion* = object
    ## Sent by the server when the client's RakNet protocol version does not match the server's (11).
    protocolVersion*: uint8
    magic*: array[16, uint8]
    serverGuid*: uint64

proc newCIncompatibleProtocolVersion*(protocolVersion: uint8; serverGuid: uint64): CIncompatibleProtocolVersion =
  CIncompatibleProtocolVersion(protocolVersion: protocolVersion, magic: RAKNET_MAGIC, serverGuid: serverGuid)

proc packetWrite*(self: CIncompatibleProtocolVersion; w: var NetWriter) =
  packetWrite(self.protocolVersion, w)
  for b in self.magic:
    writeU8(w, b)
  packetWrite(self.serverGuid, w)
