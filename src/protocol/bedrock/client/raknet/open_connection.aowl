## Port of pumpkin-protocol/src/bedrock/client/raknet/open_connection.rs
## `server_guid` and `mtu` are plain `PacketWrite` fields (no `big_endian`), so they are little-endian.
## That is what upstream sends (the derive has no big_endian on these fields): kept as is, and tested so.
## Flagged for the network layer: a real RakNet client expects big-endian guid and MTU.

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod

const
  COpenConnectionReply1PacketId* = 0x06'i32
  COpenConnectionReply2PacketId* = 0x08'i32

type
  COpenConnectionReply1* = object
    ## Reply to `OpenConnectionRequest1`. The `cookie` that upstream's comment mentions is not written.
    magic*: array[16, uint8]
    serverGuid*: uint64
    hasServerSecurity*: bool
    mtu*: uint16

  COpenConnectionReply2* = object
    magic*: array[16, uint8]
    serverGuid*: uint64
    clientAddress*: SocketAddr
    mtu*: uint16
    security*: bool

proc newCOpenConnectionReply1*(serverGuid: uint64; hasServerSecurity: bool; mtu: uint16): COpenConnectionReply1 =
  COpenConnectionReply1(magic: RAKNET_MAGIC, serverGuid: serverGuid, hasServerSecurity: hasServerSecurity, mtu: mtu)

proc newCOpenConnectionReply2*(serverGuid: uint64; clientAddress: SocketAddr; mtu: uint16;
    security: bool): COpenConnectionReply2 =
  COpenConnectionReply2(magic: RAKNET_MAGIC, serverGuid: serverGuid, clientAddress: clientAddress, mtu: mtu,
    security: security)

proc packetWrite*(self: COpenConnectionReply1; w: var NetWriter) =
  for b in self.magic:
    writeU8(w, b)
  packetWrite(self.serverGuid, w)
  packetWrite(self.hasServerSecurity, w)
  packetWrite(self.mtu, w)

proc packetWrite*(self: COpenConnectionReply2; w: var NetWriter) =
  for b in self.magic:
    writeU8(w, b)
  packetWrite(self.serverGuid, w)
  packetWrite(self.clientAddress, w)
  packetWrite(self.mtu, w)
  packetWrite(self.security, w)
