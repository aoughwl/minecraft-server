## Port of pumpkin-protocol/src/bedrock/client/raknet/unconnected_pong.rs

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod

const CUnconnectedPongPacketId* = 0x1c'i32

type
  CUnconnectedPong* = object
    ## Sent by the server in response to an `UnconnectedPing` (`0x01` / `0x02`), containing server
    ## metadata (MOTD, protocol version, player counts, edition). Hand-written `PacketWrite` upstream:
    ## big-endian time and guid, the magic, then a big-endian u16 length and the raw string bytes.
    time*: uint64
    serverGuid*: uint64
    magic*: array[16, uint8]
    serverId*: string

  ServerInfo* = object
    edition*: string ## BE, or MCEE for Education Edition
    motdLine1*: string
    protocolVersion*: uint32
    versionName*: string
    playerCount*: int32
    maxPlayerCount*: uint32
    serverUniqueId*: uint64
    motdLine2*: string
    gameMode*: string
    gameModeNumeric*: uint32
    portIpv4*: uint16
    portIpv6*: uint16

proc newCUnconnectedPong*(time, serverGuid: uint64; magic: array[16, uint8]; serverId: string): CUnconnectedPong =
  CUnconnectedPong(time: time, serverGuid: serverGuid, magic: magic, serverId: serverId)

proc packetWrite*(self: CUnconnectedPong; w: var NetWriter) =
  packetWriteBe(self.time, w)
  packetWriteBe(self.serverGuid, w)
  for b in self.magic:
    writeU8(w, b)
  writeU16Be(w, uint16(self.serverId.len))
  for ch in self.serverId:
    writeU8(w, uint8(ch))

proc `$`*(self: ServerInfo): string =
  ## `impl Display for ServerInfo`: the semicolon-separated status string, ending in `0;`.
  self.edition & ";" & self.motdLine1 & ";" & $self.protocolVersion & ";" & self.versionName & ";" &
    $self.playerCount & ";" & $self.maxPlayerCount & ";" & $self.serverUniqueId & ";" & self.motdLine2 & ";" &
    self.gameMode & ";" & $self.gameModeNumeric & ";" & $self.portIpv4 & ";" & $self.portIpv6 & ";0;"
