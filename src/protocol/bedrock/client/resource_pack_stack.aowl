## Port of pumpkin-protocol/src/bedrock/client/resource_pack_stack.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import start_game

const CResourcePackStackPacketPacketId* = 7'i32

type
  ResourcePackStackEntry* = object
    uuid*: string
    version*: string
    subPackName*: string

  CResourcePackStackPacket* = object
    resourcePackRequired*: bool
    resourcePacks*: seq[ResourcePackStackEntry]
    gameVersion*: string
    experiments*: Experiments
    includeEditorPacks*: bool

proc newCResourcePackStackPacket*(resourcePackRequired: bool; resourcePacks: seq[ResourcePackStackEntry];
    gameVersion: string; experiments: Experiments; includeEditorPacks: bool): CResourcePackStackPacket =
  CResourcePackStackPacket(resourcePackRequired: resourcePackRequired, resourcePacks: resourcePacks,
    gameVersion: gameVersion, experiments: experiments, includeEditorPacks: includeEditorPacks)

proc packetWrite*(self: ResourcePackStackEntry; w: var NetWriter) =
  packetWrite(self.uuid, w)
  packetWrite(self.version, w)
  packetWrite(self.subPackName, w)

proc packetWrite*(self: CResourcePackStackPacket; w: var NetWriter) =
  packetWrite(self.resourcePackRequired, w)
  packetWrite(newVarUInt(uint32(self.resourcePacks.len)), w)
  for i in 0 ..< self.resourcePacks.len:
    packetWrite(self.resourcePacks[i], w)
  packetWrite(self.gameVersion, w)
  packetWrite(self.experiments, w)
  packetWrite(self.includeEditorPacks, w)
