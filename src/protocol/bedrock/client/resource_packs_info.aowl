## Port of pumpkin-protocol/src/bedrock/client/resource_packs_info.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../uuid

const CResourcePacksInfoPacketId* = 6'i32

type
  ResourcePackEntry* = object
    uuid*: Uuid
    version*: string
    size*: uint64
    contentKey*: string
    subPackName*: string
    contentId*: string
    hasScripts*: bool
    addonPack*: bool
    rtxEnabled*: bool
    downloadUrl*: string

  CResourcePacksInfo* = object
    resourcePackRequired*: bool
    hasAddonPacks*: bool
    hasScripts*: bool
    isVibrantVisualsForceDisabled*: bool
    worldTemplateId*: Uuid
    worldTemplateVersion*: string
    resourcePacks*: seq[ResourcePackEntry]

proc packetWrite*(self: ResourcePackEntry; w: var NetWriter) =
  packetWrite(self.uuid, w)
  packetWrite(self.version, w)
  # Bedrock uses Little Endian u64 for size
  packetWrite(self.size, w)
  packetWrite(self.contentKey, w)
  packetWrite(self.subPackName, w)
  packetWrite(self.contentId, w)
  packetWrite(self.hasScripts, w)
  packetWrite(self.addonPack, w)
  packetWrite(self.rtxEnabled, w)
  packetWrite(self.downloadUrl, w)

proc packetWrite*(self: CResourcePacksInfo; w: var NetWriter) =
  ## The pack count is a little-endian u16, not a VarUInt.
  packetWrite(self.resourcePackRequired, w)
  packetWrite(self.hasAddonPacks, w)
  packetWrite(self.hasScripts, w)
  packetWrite(self.isVibrantVisualsForceDisabled, w)
  packetWrite(self.worldTemplateId, w)
  packetWrite(self.worldTemplateVersion, w)
  packetWrite(uint16(self.resourcePacks.len and 0xFFFF), w)
  for i in 0 ..< self.resourcePacks.len:
    packetWrite(self.resourcePacks[i], w)
