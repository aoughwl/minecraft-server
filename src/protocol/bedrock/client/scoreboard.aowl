## Port of pumpkin-protocol/src/bedrock/client/scoreboard.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const
  CSetDisplayObjectivePacketId* = 107'i32
  CSetScorePacketId* = 108'i32
  CRemoveObjectivePacketId* = 106'i32

type
  CSetDisplayObjective* = object
    displaySlot*: string
    objectiveName*: string
    displayName*: string
    criteriaName*: string
    sortOrder*: VarInt

  ScoreEntry* = object
    scoreboardId*: int64
    objectiveName*: string
    score*: VarInt
    entryType*: VarInt ## 1 = player, 2 = entity, 3 = fake player
    entityUniqueId*: int64
    customName*: string

  CSetScore* = object
    action*: VarInt ## 0 = change, 1 = remove
    entries*: seq[ScoreEntry]

  CRemoveObjective* = object
    objectiveName*: string

proc packetWrite*(self: CSetDisplayObjective; w: var NetWriter) =
  packetWrite(self.displaySlot, w)
  packetWrite(self.objectiveName, w)
  packetWrite(self.displayName, w)
  packetWrite(self.criteriaName, w)
  packetWrite(self.sortOrder, w)

proc packetWrite*(self: ScoreEntry; w: var NetWriter) =
  ## An entity-typed entry (1 or 2) carries `entityUniqueId`, a fake player (3) its `customName`.
  packetWrite(self.scoreboardId, w)
  packetWrite(self.objectiveName, w)
  packetWrite(self.score, w)
  packetWrite(self.entryType, w)
  case self.entryType.value
  of 1'i32, 2'i32:
    packetWrite(self.entityUniqueId, w)
  of 3'i32:
    packetWrite(self.customName, w)
  else:
    discard

proc packetWrite*(self: CSetScore; w: var NetWriter) =
  packetWrite(self.action, w)
  packetWrite(newVarUInt(uint32(self.entries.len)), w)
  for i in 0 ..< self.entries.len:
    packetWrite(self.entries[i], w)

proc packetWrite*(self: CRemoveObjective; w: var NetWriter) =
  packetWrite(self.objectiveName, w)
