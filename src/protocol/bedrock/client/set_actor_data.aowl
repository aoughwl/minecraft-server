type
  MetadataValueKind* = enum
    mvByte
    mvShort
    mvInt
    mvFloat
    mvString
    mvCompoundTag
    mvBlockPos
    mvLong
    mvVec3

  MetadataValue* = object
    ## `Byte(i8)`, `Short(i16)`, `Int(i32)`, `Float(f32)`, `String(String)`, `CompoundTag`, `BlockPos`,
    ## `Long(i64)`, `Vec3`. The enum order is the wire type id.
    case kind*: MetadataValueKind
    of mvByte: byteValue*: int8
    of mvShort: shortValue*: int16
    of mvInt: intValue*: int32
    of mvFloat: floatValue*: float32
    of mvString: stringValue*: string
    of mvCompoundTag: discard
    of mvBlockPos: blockPosValue*: BlockPos
    of mvLong: longValue*: int64
    of mvVec3: vec3Value*: Vector3[float32]

  MetadataEntry* = object
    key*: uint32
    value*: MetadataValue

  EntityMetadata* = object
    entries*: seq[MetadataEntry]

  IntProperty* = object
    key*: uint32
    value*: int32

  FloatProperty* = object
    key*: uint32
    value*: float32

  PropertySyncData* = object
    intProperties*: seq[IntProperty]
    floatProperties*: seq[FloatProperty]

  CSetActorData* = object
    actorRuntimeId*: VarULong
    metadata*: EntityMetadata
    syncedProperties*: PropertySyncData
    tick*: VarULong

proc mvByteOf*(v: int8): MetadataValue = MetadataValue(kind: mvByte, byteValue: v)
proc mvShortOf*(v: int16): MetadataValue = MetadataValue(kind: mvShort, shortValue: v)
proc mvIntOf*(v: int32): MetadataValue = MetadataValue(kind: mvInt, intValue: v)
proc mvFloatOf*(v: float32): MetadataValue = MetadataValue(kind: mvFloat, floatValue: v)
proc mvStringOf*(v: string): MetadataValue = MetadataValue(kind: mvString, stringValue: v)
proc mvCompoundTagOf*(): MetadataValue = MetadataValue(kind: mvCompoundTag)
proc mvBlockPosOf*(v: BlockPos): MetadataValue = MetadataValue(kind: mvBlockPos, blockPosValue: v)
proc mvLongOf*(v: int64): MetadataValue = MetadataValue(kind: mvLong, longValue: v)
proc mvVec3Of*(v: Vector3[float32]): MetadataValue = MetadataValue(kind: mvVec3, vec3Value: v)

proc typeId*(self: MetadataValue): uint32 =
  uint32(ord(self.kind))

proc find(self: EntityMetadata; key: uint32): int =
  for i in 0 ..< self.entries.len:
    if self.entries[i].key == key:
      return i
  -1

proc set*(self: var EntityMetadata; key: uint32; value: MetadataValue) =
  ## `HashMap::insert`: replaces the value of an existing key.
  let at = find(self, key)
  if at >= 0:
    self.entries[at].value = value
  else:
    self.entries.add(MetadataEntry(key: key, value: value))

proc newEntityMetadata*(): EntityMetadata =
  ## `EntityMetadata::new()`: FLAGS and FLAGS_TWO as `Long(0)`, PLAYER_FLAGS as `Byte(0)`.
  result = EntityMetadata(entries: @[])
  result.set(EDK_FLAGS, mvLongOf(0'i64))
  result.set(EDK_FLAGS_TWO, mvLongOf(0'i64))
  result.set(EDK_PLAYER_FLAGS, mvByteOf(0'i8))

proc setFlag*(self: var EntityMetadata; key: uint32; index: uint8; value: bool) =
  let at = find(self, key)
  if key == EDK_PLAYER_FLAGS:
    var current = 0'i8
    if at >= 0 and self.entries[at].value.kind == mvByte:
      current = self.entries[at].value.byteValue
    let bit = cast[int8](1'u8 shl (index and 7'u8))
    let newValue = if value: current or bit else: current and not bit
    self.set(key, mvByteOf(newValue))
  else:
    var current = 0'i64
    if at >= 0 and self.entries[at].value.kind == mvLong:
      current = self.entries[at].value.longValue
    let bit = cast[int64](1'u64 shl (index and 63'u8))
    let newValue = if value: current or bit else: current and not bit
    self.set(key, mvLongOf(newValue))

proc writeValue*(self: MetadataValue; w: var NetWriter): ProtoWriteVoidResult =
  ## `MetadataValue::write`. A `CompoundTag` is an error.
  case self.kind
  of mvByte: packetWrite(self.byteValue, w)
  of mvShort: packetWrite(self.shortValue, w)
  of mvInt: packetWrite(newVarInt(self.intValue), w)
  of mvFloat: packetWrite(self.floatValue, w)
  of mvString: packetWrite(self.stringValue, w)
  of mvCompoundTag: return writeErrVoid(ioError("CompoundTag not implemented"))
  of mvBlockPos: packetWrite(self.blockPosValue, w)
  of mvLong: packetWrite(newVarLong(self.longValue), w)
  of mvVec3: packetWrite(self.vec3Value, w)
  writeOkVoid()

proc packetWrite*(self: EntityMetadata; w: var NetWriter): ProtoWriteVoidResult =
  packetWrite(newVarUInt(uint32(self.entries.len)), w)
  for i in 0 ..< self.entries.len:
    packetWrite(newVarUInt(self.entries[i].key), w)
    packetWrite(newVarUInt(self.entries[i].value.typeId()), w)
    tryWrite writeValue(self.entries[i].value, w)
  writeOkVoid()

proc packetWrite*(self: PropertySyncData; w: var NetWriter) =
  # Int Properties
  packetWrite(newVarUInt(uint32(self.intProperties.len)), w)
  for p in self.intProperties:
    packetWrite(newVarUInt(p.key), w)
    packetWrite(newVarInt(p.value), w) # Signed VarInt
  # Float Properties
  packetWrite(newVarUInt(uint32(self.floatProperties.len)), w)
  for p in self.floatProperties:
    packetWrite(newVarUInt(p.key), w)
    packetWrite(p.value, w) # LE Float

proc packetWrite*(self: CSetActorData; w: var NetWriter): ProtoWriteVoidResult =
  packetWrite(self.actorRuntimeId, w)
  tryWrite packetWrite(self.metadata, w)
  packetWrite(self.syncedProperties, w)
  packetWrite(self.tick, w)
  writeOkVoid()
