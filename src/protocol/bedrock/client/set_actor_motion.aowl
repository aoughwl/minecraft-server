## Port of pumpkin-protocol/src/bedrock/client/set_actor_motion.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const CSetActorMotionPacketId* = 40'i32

type
  CSetActorMotion* = object
    targetRuntimeId*: VarULong
    motion*: Vector3[float32]
    tick*: VarULong

proc newCSetActorMotion*(targetRuntimeId: VarULong; motion: Vector3[float32]; tick: VarULong): CSetActorMotion =
  CSetActorMotion(targetRuntimeId: targetRuntimeId, motion: motion, tick: tick)

proc packetWrite*(self: CSetActorMotion; w: var NetWriter) =
  packetWrite(self.targetRuntimeId, w)
  packetWrite(self.motion, w)
  packetWrite(self.tick, w)
