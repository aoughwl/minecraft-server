## Port of pumpkin-protocol/src/bedrock/client/set_difficulty.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CSetDifficultyPacketId* = 60'i32

type
  CSetDifficulty* = object
    difficulty*: VarUInt

proc newCSetDifficulty*(difficulty: uint32): CSetDifficulty =
  CSetDifficulty(difficulty: newVarUInt(difficulty))

proc packetWrite*(self: CSetDifficulty; w: var NetWriter) =
  packetWrite(self.difficulty, w)
