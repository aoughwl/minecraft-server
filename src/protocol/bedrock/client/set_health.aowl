## Port of pumpkin-protocol/src/bedrock/client/set_health.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CSetHealthPacketId* = 42'i32

type
  CSetHealth* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/SetHealthPacket.html
    health*: VarInt

proc newCSetHealth*(health: int32): CSetHealth =
  CSetHealth(health: newVarInt(health))

proc packetWrite*(self: CSetHealth; w: var NetWriter) =
  packetWrite(self.health, w)
