## Port of pumpkin-protocol/src/bedrock/client/set_player_gamemode.rs

import ../../protobase, ../../netcodec, ../../serial
import ../../../util/gamemode

const CSetPlayerGamemodePacketId* = 62'i32

type
  CSetPlayerGamemode* = object
    gamemode*: GameMode

proc packetWrite*(self: CSetPlayerGamemode; w: var NetWriter) =
  ## `GameMode`'s Bedrock encoding: a ZigZag VarInt, with Spectator as 6.
  packetWrite(self.gamemode, w)
