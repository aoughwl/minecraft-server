## Port of pumpkin-protocol/src/bedrock/client/set_spawn_position.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position

const CSetSpawnPositionPacketId* = 43'i32

type
  CSetSpawnPosition* = object
    spawnType*: VarInt
    position*: BlockPos
    dimension*: VarInt
    spawnPosition*: BlockPos

proc newCSetSpawnPosition*(spawnType: int32; position: BlockPos; dimension: int32;
    spawnPosition: BlockPos): CSetSpawnPosition =
  CSetSpawnPosition(spawnType: newVarInt(spawnType), position: position, dimension: newVarInt(dimension),
    spawnPosition: spawnPosition)

proc packetWrite*(self: CSetSpawnPosition; w: var NetWriter) =
  packetWrite(self.spawnType, w)
  packetWrite(self.position, w)
  packetWrite(self.dimension, w)
  packetWrite(self.spawnPosition, w)
