## Port of pumpkin-protocol/src/bedrock/client/set_time.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CSetTimePacketId* = 10'i32

type
  CSetTime* = object
    time*: VarInt

proc newCSetTime*(time: int32): CSetTime =
  CSetTime(time: newVarInt(time))

proc packetWrite*(self: CSetTime; w: var NetWriter) =
  packetWrite(self.time, w)
