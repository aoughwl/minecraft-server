## Port of pumpkin-protocol/src/bedrock/client/set_title.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CSetTitlePacketId* = 88'i32

type
  CSetTitle* = object
    actionType*: VarInt
    text*: string
    fadeInDuration*: VarInt
    remainDuration*: VarInt
    fadeOutDuration*: VarInt
    xuid*: string
    platformOnlineId*: string
    filteredMessage*: string

proc newCSetTitle*(actionType: int32; text: string; fadeInDuration, remainDuration, fadeOutDuration: int32): CSetTitle =
  CSetTitle(actionType: newVarInt(actionType), text: text, fadeInDuration: newVarInt(fadeInDuration),
    remainDuration: newVarInt(remainDuration), fadeOutDuration: newVarInt(fadeOutDuration), xuid: "",
    platformOnlineId: "", filteredMessage: "")

proc packetWrite*(self: CSetTitle; w: var NetWriter) =
  packetWrite(self.actionType, w)
  packetWrite(self.text, w)
  packetWrite(self.fadeInDuration, w)
  packetWrite(self.remainDuration, w)
  packetWrite(self.fadeOutDuration, w)
  packetWrite(self.xuid, w)
  packetWrite(self.platformOnlineId, w)
  packetWrite(self.filteredMessage, w)
