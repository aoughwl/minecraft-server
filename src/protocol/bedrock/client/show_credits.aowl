## Port of pumpkin-protocol/src/bedrock/client/show_credits.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CShowCreditsPacketId* = 75'i32

type
  CShowCredits* = object
    playerRuntimeId*: VarULong
    status*: VarInt

proc newCShowCredits*(playerRuntimeId: VarULong; status: VarInt): CShowCredits =
  CShowCredits(playerRuntimeId: playerRuntimeId, status: status)

proc packetWrite*(self: CShowCredits; w: var NetWriter) =
  packetWrite(self.playerRuntimeId, w)
  packetWrite(self.status, w)
