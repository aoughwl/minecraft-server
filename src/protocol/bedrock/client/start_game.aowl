## Port of pumpkin-protocol/src/bedrock/client/start_game.rs
## Every struct is a derived `PacketWrite`: fields in order, little-endian numbers, ZigZag `VarInt`.
## `Option<T>` is a bool, then the value. `ServerJoinInformation` and its parts have private fields upstream;
## they are plain public fields here.

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../uuid
import ../../../util/gamemode
import ../../../util/math/position
import ../../../util/vector3
import gamerules_changed

const CStartGamePacketId* = 11'i32

type
  GamePublishSetting* = enum
    ## Written as a VarInt of the variant's value.
    gpsNoMultiPlay = 0
    gpsInviteOnly = 1
    gpsFriendsOnly = 2
    gpsFriendsOfFriends = 3
    gpsPublic = 4

  Experiments* = object
    ## TODO upstream: https://mojang.github.io/bedrock-protocol-docs/html/Experiments.html
    namesSize*: uint32
    experimentsEverToggled*: bool

  GatheringJoinInfo* = object
    experienceId*: Uuid
    experienceName*: string
    experienceWorldId*: Uuid
    experienceWorldName*: string
    creatorId*: string
    unknownUuid1*: Uuid
    unknownUuid2*: Uuid
    serverId*: string

  StoreEntryPointInfo* = object
    storeId*: string
    storeName*: string

  PresenceInfo* = object
    experienceName*: string
    worldName*: string

  ServerJoinInformation* = object
    gathering*: Option[GatheringJoinInfo]
    storeEntryPoint*: Option[StoreEntryPointInfo]
    presence*: Option[PresenceInfo]

  ServerTelemetryData* = object
    serverId*: string
    scenarioId*: string
    worldId*: string
    ownerId*: string

  LevelSettings* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/LevelSettings.html
    seed*: uint64
    # Spawn Settings: https://mojang.github.io/bedrock-protocol-docs/html/SpawnSettings.html
    spawnBiomeType*: int16
    customBiomeName*: string
    dimension*: VarInt
    # Level Settings
    generatorType*: VarInt
    worldGamemode*: GameMode
    hardcore*: bool
    difficulty*: VarInt
    spawnPosition*: BlockPos
    hasAchievementsDisabled*: bool
    editorWorldType*: VarInt
    isCreatedInEditor*: bool
    isExportedFromEditor*: bool
    dayCycleStopTime*: VarInt
    educationEditionOffer*: VarInt
    hasEducationFeaturesEnabled*: bool
    educationProductId*: string
    rainLevel*: float32
    lightningLevel*: float32
    hasConfirmedPlatformLockedContent*: bool
    wasMultiplayerIntended*: bool
    wasLanBroadcastingIntended*: bool
    xboxLiveBroadcastSetting*: GamePublishSetting
    platformBroadcastSetting*: GamePublishSetting
    commandsEnabled*: bool
    isTexturePacksRequired*: bool
    ruleData*: GameRules
    experiments*: Experiments
    bonusChest*: bool
    hasStartWithMapEnabled*: bool
    permissionLevel*: VarInt
    serverSimulationDistance*: int32
    hasLockedBehaviorPack*: bool
    hasLockedResourcePack*: bool
    isFromLockedWorldTemplate*: bool
    isUsingMsaGamertagsOnly*: bool
    isFromWorldTemplate*: bool
    isWorldTemplateOptionLocked*: bool
    isOnlySpawningV1Villagers*: bool
    isDisablingPersonas*: bool
    isDisablingCustomSkins*: bool
    emoteChatMuted*: bool
    # TODO upstream: BaseGameVersion
    gameVersion*: string
    # TODO upstream: LE
    limitedWorldWidth*: int32
    limitedWorldHeight*: int32
    newNether*: bool
    eduSharedUriButtonName*: string
    eduSharedUriLinkUri*: string
    overrideForceExperimentalGameplayHasValue*: bool
    chatRestrictionLevel*: int8
    disablePlayerInteractions*: bool
    serverEditorConnectionPolicy*: VarInt
    allowAnonymousBlockDropsInEditorWorlds*: bool

  CStartGame* = object
    ## The unique ID is a value that remains consistent across different sessions of the same world, but most
    ## servers simply fill the runtime ID of the entity out for this field.
    entityId*: VarLong
    ## The runtime ID is unique for each world session, and entities are generally identified in packets
    ## using this runtime ID.
    runtimeEntityId*: VarULong
    playerGamemode*: GameMode
    position*: Vector3[float32]
    pitch*: float32
    yaw*: float32
    levelSettings*: LevelSettings
    levelId*: string
    levelName*: string
    premiumWorldTemplateId*: string
    isTrial*: bool
    rewindHistorySize*: VarInt
    serverAuthoritativeBlockBreaking*: bool
    currentLevelTime*: uint64
    enchantmentSeed*: VarInt
    blockPropertiesSize*: VarUInt
    multiplayerCorrelationId*: string
    enableItemstackNetManager*: bool
    serverVersion*: string
    # pub player_property_data: NbtCompound
    compoundId*: int8
    compoundLen*: VarUInt
    compoundEnd*: int8
    blockRegistryChecksum*: uint64
    worldTemplateId*: Uuid
    enableClientsideGeneration*: bool
    blocknetworkIdsAreHashed*: bool
    serverAuthSounds*: bool
    isLoggingChat*: bool
    # 2 Optionals is what we need Mojang :cap:
    serverJoinInformation*: Option[ServerJoinInformation]
    telemetry*: ServerTelemetryData

  GG* = object
    name*: string
    id*: int8
    len*: VarUInt
    `end`*: int8

proc packetWrite*(self: GamePublishSetting; w: var NetWriter) =
  packetWrite(newVarInt(int32(ord(self))), w)

proc packetWrite*(self: Experiments; w: var NetWriter) =
  packetWrite(self.namesSize, w)
  packetWrite(self.experimentsEverToggled, w)

proc packetWrite*(self: GatheringJoinInfo; w: var NetWriter) =
  packetWrite(self.experienceId, w)
  packetWrite(self.experienceName, w)
  packetWrite(self.experienceWorldId, w)
  packetWrite(self.experienceWorldName, w)
  packetWrite(self.creatorId, w)
  packetWrite(self.unknownUuid1, w)
  packetWrite(self.unknownUuid2, w)
  packetWrite(self.serverId, w)

proc packetWrite*(self: StoreEntryPointInfo; w: var NetWriter) =
  packetWrite(self.storeId, w)
  packetWrite(self.storeName, w)

proc packetWrite*(self: PresenceInfo; w: var NetWriter) =
  packetWrite(self.experienceName, w)
  packetWrite(self.worldName, w)

proc packetWrite*(self: ServerJoinInformation; w: var NetWriter) =
  packetWrite(self.gathering.isSome, w)
  if self.gathering.isSome:
    packetWrite(self.gathering.unsafeGet, w)
  packetWrite(self.storeEntryPoint.isSome, w)
  if self.storeEntryPoint.isSome:
    packetWrite(self.storeEntryPoint.unsafeGet, w)
  packetWrite(self.presence.isSome, w)
  if self.presence.isSome:
    packetWrite(self.presence.unsafeGet, w)

proc packetWrite*(self: ServerTelemetryData; w: var NetWriter) =
  packetWrite(self.serverId, w)
  packetWrite(self.scenarioId, w)
  packetWrite(self.worldId, w)
  packetWrite(self.ownerId, w)

proc packetWrite*(self: LevelSettings; w: var NetWriter) =
  packetWrite(self.seed, w)
  packetWrite(self.spawnBiomeType, w)
  packetWrite(self.customBiomeName, w)
  packetWrite(self.dimension, w)
  packetWrite(self.generatorType, w)
  packetWrite(self.worldGamemode, w)
  packetWrite(self.hardcore, w)
  packetWrite(self.difficulty, w)
  packetWrite(self.spawnPosition, w)
  packetWrite(self.hasAchievementsDisabled, w)
  packetWrite(self.editorWorldType, w)
  packetWrite(self.isCreatedInEditor, w)
  packetWrite(self.isExportedFromEditor, w)
  packetWrite(self.dayCycleStopTime, w)
  packetWrite(self.educationEditionOffer, w)
  packetWrite(self.hasEducationFeaturesEnabled, w)
  packetWrite(self.educationProductId, w)
  packetWrite(self.rainLevel, w)
  packetWrite(self.lightningLevel, w)
  packetWrite(self.hasConfirmedPlatformLockedContent, w)
  packetWrite(self.wasMultiplayerIntended, w)
  packetWrite(self.wasLanBroadcastingIntended, w)
  packetWrite(self.xboxLiveBroadcastSetting, w)
  packetWrite(self.platformBroadcastSetting, w)
  packetWrite(self.commandsEnabled, w)
  packetWrite(self.isTexturePacksRequired, w)
  packetWrite(self.ruleData, w)
  packetWrite(self.experiments, w)
  packetWrite(self.bonusChest, w)
  packetWrite(self.hasStartWithMapEnabled, w)
  packetWrite(self.permissionLevel, w)
  packetWrite(self.serverSimulationDistance, w)
  packetWrite(self.hasLockedBehaviorPack, w)
  packetWrite(self.hasLockedResourcePack, w)
  packetWrite(self.isFromLockedWorldTemplate, w)
  packetWrite(self.isUsingMsaGamertagsOnly, w)
  packetWrite(self.isFromWorldTemplate, w)
  packetWrite(self.isWorldTemplateOptionLocked, w)
  packetWrite(self.isOnlySpawningV1Villagers, w)
  packetWrite(self.isDisablingPersonas, w)
  packetWrite(self.isDisablingCustomSkins, w)
  packetWrite(self.emoteChatMuted, w)
  packetWrite(self.gameVersion, w)
  packetWrite(self.limitedWorldWidth, w)
  packetWrite(self.limitedWorldHeight, w)
  packetWrite(self.newNether, w)
  packetWrite(self.eduSharedUriButtonName, w)
  packetWrite(self.eduSharedUriLinkUri, w)
  packetWrite(self.overrideForceExperimentalGameplayHasValue, w)
  packetWrite(self.chatRestrictionLevel, w)
  packetWrite(self.disablePlayerInteractions, w)
  packetWrite(self.serverEditorConnectionPolicy, w)
  packetWrite(self.allowAnonymousBlockDropsInEditorWorlds, w)

proc packetWrite*(self: CStartGame; w: var NetWriter) =
  packetWrite(self.entityId, w)
  packetWrite(self.runtimeEntityId, w)
  packetWrite(self.playerGamemode, w)
  packetWrite(self.position, w)
  packetWrite(self.pitch, w)
  packetWrite(self.yaw, w)
  packetWrite(self.levelSettings, w)
  packetWrite(self.levelId, w)
  packetWrite(self.levelName, w)
  packetWrite(self.premiumWorldTemplateId, w)
  packetWrite(self.isTrial, w)
  packetWrite(self.rewindHistorySize, w)
  packetWrite(self.serverAuthoritativeBlockBreaking, w)
  packetWrite(self.currentLevelTime, w)
  packetWrite(self.enchantmentSeed, w)
  packetWrite(self.blockPropertiesSize, w)
  packetWrite(self.multiplayerCorrelationId, w)
  packetWrite(self.enableItemstackNetManager, w)
  packetWrite(self.serverVersion, w)
  packetWrite(self.compoundId, w)
  packetWrite(self.compoundLen, w)
  packetWrite(self.compoundEnd, w)
  packetWrite(self.blockRegistryChecksum, w)
  packetWrite(self.worldTemplateId, w)
  packetWrite(self.enableClientsideGeneration, w)
  packetWrite(self.blocknetworkIdsAreHashed, w)
  packetWrite(self.serverAuthSounds, w)
  packetWrite(self.isLoggingChat, w)
  packetWrite(self.serverJoinInformation.isSome, w)
  if self.serverJoinInformation.isSome:
    packetWrite(self.serverJoinInformation.unsafeGet, w)
  packetWrite(self.telemetry, w)

proc packetWrite*(self: GG; w: var NetWriter) =
  packetWrite(self.name, w)
  packetWrite(self.id, w)
  packetWrite(self.len, w)
  packetWrite(self.`end`, w)
