import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CTakeItemActorPacketId* = 17'i32

type
  CTakeItemActor* = object
    ## https://github.com/Sandertv/gophertunnel/blob/master/minecraft/protocol/packet/take_item_actor.go
    itemRuntimeId*: VarULong
    actorRuntimeId*: VarULong

proc newCTakeItemActor*(itemRuntimeId, actorRuntimeId: VarULong): CTakeItemActor =
  CTakeItemActor(itemRuntimeId: itemRuntimeId, actorRuntimeId: actorRuntimeId)

proc packetWrite*(self: CTakeItemActor; w: var NetWriter) =
