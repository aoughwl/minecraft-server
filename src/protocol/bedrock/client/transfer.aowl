## Port of pumpkin-protocol/src/bedrock/client/transfer.rs

import ../../protobase, ../../netcodec, ../../serial

const CTransferPacketId* = 85'i32

type
  CTransfer* = object
    address*: string
    port*: uint16
    reloadWorld*: bool

proc newCTransfer*(address: string; port: uint16; reloadWorld: bool): CTransfer =
  CTransfer(address: address, port: port, reloadWorld: reloadWorld)

proc packetWrite*(self: CTransfer; w: var NetWriter) =
  packetWrite(self.address, w)
  packetWrite(self.port, w)
  packetWrite(self.reloadWorld, w)
