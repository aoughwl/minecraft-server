## Port of pumpkin-protocol/src/bedrock/client/update_abilities.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import common

const CUpdateAbilitiesPacketId* = 187'i32

type
  CUpdateAbilities* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/UpdateAbilitiesPacket.html
    ## https://mojang.github.io/bedrock-protocol-docs/html/SerializedAbilitiesData.html
    targetPlayerRawId*: int64
    playerPermission*: uint8
    commandPermission*: uint8
    layers*: seq[AbilityLayer]

  Ability* = enum
    ## `#[repr(u32)]`: the variant's value is its ordinal.
    abBuild = 0
    abMine = 1
    abDoorsAndSwitches = 2
    abOpenContainers = 3
    abAttackPlayers = 4
    abAttackMobs = 5
    abOperatorCommands = 6
    abTeleport = 7
    abInvulnerable = 8
    abFlying = 9
    abMayFly = 10
    abInstabuild = 11
    abLightning = 12
    abFlySpeed = 13
    abWalkSpeed = 14
    abMuted = 15
    abWorldBuilder = 16
    abNoClip = 17
    abPrivilegedBuilder = 18
    abVerticalFlySpeed = 19
    abAbilityCount = 20

proc packetWrite*(self: CUpdateAbilities; w: var NetWriter) =
  ## Derived: `layers` is a `Vec`, so it carries a VarUInt count.
  packetWrite(self.targetPlayerRawId, w)
  packetWrite(self.playerPermission, w)
  packetWrite(self.commandPermission, w)
  packetWrite(newVarUInt(uint32(self.layers.len)), w)
  for i in 0 ..< self.layers.len:
    packetWrite(self.layers[i], w)
