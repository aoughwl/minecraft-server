## Port of pumpkin-protocol/src/bedrock/client/update_attributes.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const CUpdateAttributesPacketId* = 29'i32

type
  Attribute* = object
    minValue*: float32
    maxValue*: float32
    currentValue*: float32
    defaultMinValue*: float32
    defaultMaxValue*: float32
    defaultValue*: float32
    name*: string
    modifiersListSize*: VarUInt

  CUpdateAttributes* = object
    runtimeId*: VarULong
    attributes*: seq[Attribute]
    playerTick*: VarULong

proc packetWrite*(self: Attribute; w: var NetWriter) =
  packetWrite(self.minValue, w)
  packetWrite(self.maxValue, w)
  packetWrite(self.currentValue, w)
  packetWrite(self.defaultMinValue, w)
  packetWrite(self.defaultMaxValue, w)
  packetWrite(self.defaultValue, w)
  packetWrite(self.name, w)
  packetWrite(self.modifiersListSize, w)

proc packetWrite*(self: CUpdateAttributes; w: var NetWriter) =
  packetWrite(self.runtimeId, w)
  packetWrite(newVarUInt(uint32(self.attributes.len)), w)
  for i in 0 ..< self.attributes.len:
    packetWrite(self.attributes[i], w)
  packetWrite(self.playerTick, w)
