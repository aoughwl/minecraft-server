## Port of pumpkin-protocol/src/bedrock/client/update_block.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position

const CUpdateBlockPacketId* = 21'i32

type
  CUpdateBlock* = object
    position*: BlockPos
    blockRuntimeId*: VarUInt
    flags*: VarUInt
    layer*: VarUInt

proc newCUpdateBlock*(position: BlockPos; blockRuntimeId: uint32): CUpdateBlock =
  ## `flags` is 0x3: neighbors | network.
  CUpdateBlock(position: position, blockRuntimeId: newVarUInt(blockRuntimeId), flags: newVarUInt(0x3'u32),
    layer: newVarUInt(0'u32))

proc packetWrite*(self: CUpdateBlock; w: var NetWriter) =
  packetWrite(self.position, w)
  packetWrite(self.blockRuntimeId, w)
  packetWrite(self.flags, w)
  packetWrite(self.layer, w)
