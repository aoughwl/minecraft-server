## Test for the plain clientbound Bedrock packets. Protocol 1001. Each expected byte string was laid out from the
## pinned Rust's field order and encodings with struct.pack in a scratch script (little-endian numbers, ZigZag
## VarInt/VarLong, VarUInt lengths), not taken from this port's output.
import bedrocktestutil
import ../../util/vector3
import ../../util/math/position
import ../../util/gamemode
import ../../util/vector2
import client/[common, play_status, network_settings, handshake, chunk_radius_update, container_open,
  correct_player_move, disconnect_player, gamerules_changed, level_event, level_sound_event, modal_form_request,
  set_difficulty, set_health, set_player_gamemode, set_spawn_position, set_time, set_title, show_credits,
  take_item_actor, transfer, update_abilities, update_attributes, update_block, player_hotbar, remove_actor,
  set_actor_link, set_actor_motion, move_actor_absolute, move_actor_delta, move_player, change_dimension,
  network_chunk_publisher_update, boss_event]

proc v3(x, y, z: float32): Vector3[float32] = Vector3[float32](x: x, y: y, z: z)

let ability = AbilityLayer(serializedLayer: 1'u16, abilitiesSet: 0x3FFFF'u32, abilityValue: 0x1FF'u32,
  flySpeed: 0.05'f32, verticalFlySpeed: 1.0'f32, walkSpeed: 0.1'f32)
eqHex(wrote(ability), "0100ffff0300ff010000cdcc4c3d0000803fcdcccc3d", "ability layer")
let link = EntityLink(riddenUniqueId: newVarLong(-3'i64), riderUniqueId: newVarLong(300'i64), linkType: 1'u8,
  immediate: true, riderInitiated: false, vehicleAngularVelocity: 0.5'f32)
eqHex(wrote(link), "05d8040101000000003f", "entity link")

# Packet ids are upstream's #[packet(N)].
check(CPlayStatusPacketId == 2'i32 and CNetworkSettingsPacketId == 143'i32 and CHandshakePacketId == 3'i32 and
  CChunkRadiusUpdatePacketId == 70'i32 and CContainerOpenPacketId == 46'i32 and
  CCorrectPlayerMovePacketId == 161'i32 and CDisconnectPlayerPacketId == 5'i32 and
  CGamerulesChangedPacketId == 0x48'i32 and CLevelEventPacketId == 25'i32 and CLevelSoundEventPacketId == 123'i32 and
  CModalFormRequestPacketId == 100'i32 and CSetDifficultyPacketId == 60'i32 and CSetHealthPacketId == 42'i32 and
  CSetPlayerGamemodePacketId == 62'i32 and CSetSpawnPositionPacketId == 43'i32 and CSetTimePacketId == 10'i32 and
  CSetTitlePacketId == 88'i32 and CShowCreditsPacketId == 75'i32 and CTakeItemActorPacketId == 17'i32 and
  CTransferPacketId == 85'i32 and CUpdateAbilitiesPacketId == 187'i32 and CUpdateAttributesPacketId == 29'i32 and
  CUpdateBlockPacketId == 21'i32 and CPlayerHotbarPacketId == 48'i32 and CRemoveActorPacketId == 14'i32 and
  CSetActorLinkPacketId == 41'i32 and CSetActorMotionPacketId == 40'i32 and CMoveActorAbsolutePacketId == 18'i32 and
  CMoveActorDeltaPacketId == 111'i32 and CMovePlayerPacketId == 19'i32 and CChangeDimensionPacketId == 61'i32 and
  CNetworkChunkPublisherUpdatePacketId == 121'i32 and CBossEventPacketId == 74'i32, "packet ids")

# PlayStatus is a big-endian i32 of the variant's value.
eqHex(wrote(cpsLoginSuccess), "00000000", "play status 0")
eqHex(wrote(cpsPlayerSpawn), "00000003", "play status spawn")
eqHex(wrote(cpsEditorMismatchVanillaToEditor), "00000009", "play status 9")

eqHex(wrote(newCNetworkSettings(256'u16, 1'u16, true, -1'i8, 0.5'f32)), "0001010001ff0000003f", "network settings")
eqHex(wrote(newCHandshake("a.b.c")), "05612e622e63", "handshake")
eqHex(wrote(CChunkRadiusUpdate(chunkRadius: newVarInt(-4'i32))), "07", "chunk radius update")
eqHex(wrote(CContainerOpen(containerId: 1'u8, containerType: 2'u8, position: newBlockPos(-1'i32, 64'i32, 100'i32),
  targetEntityId: newVarLong(-1'i64))), "0102018001c80101", "container open")
eqHex(wrote(CCorrectPlayerMove(predictionType: 1'u8, pos: v3(1.5, 2.5, -3.5), posDelta: v3(0.0, -0.5, 0.25),
  onGround: true, tick: newVarULong(300'u64))), "010000c03f00002040000060c000000000000000bf0000803e01ac02", "correct player move")

# Disconnect: an empty message sets skipMessage and writes neither string.
eqHex(wrote(newCDisconnectPlayer(-2'i32, "bye")), "03000362796500", "disconnect with message")
let skip = newCDisconnectPlayer(5'i32, "")
check(skip.skipMessage, "empty message skips")
eqHex(wrote(skip), "0a01", "disconnect skipped")

eqHex(wrote(CGamerulesChanged()), "00", "gamerules changed")
eqHex(wrote(CLevelEvent(eventId: newVarInt(LevelEventBlockStartBreak), position: v3(1.0, 64.0, -1.0),
  data: newVarInt(-100'i32))), "a0380000803f00008042000080bfc701", "level event")
check(LevelEventBlockStopBreak == 3601'i32 and LevelEventBlockUpdateBreak == 3602'i32, "level event ids")
eqHex(wrote(CLevelSoundEvent(soundId: newVarUInt(300'u32), position: v3(0.5, 1.5, 2.5), extraData: newVarInt(-1'i32),
  entityType: "minecraft:cow", isBabyMob: true, isGlobal: false)), "ac020000003f0000c03f00002040010d6d696e6563726166743a636f770100", "level sound event")
eqHex(wrote(CModalFormRequest(formId: newVarInt(7'i32), formData: "{\"a\":1}")), "0e077b2261223a317d", "modal form")
eqHex(wrote(newCSetDifficulty(2'u32)), "02", "difficulty")
eqHex(wrote(newCSetHealth(-20'i32)), "27", "health")
eqHex(wrote(CSetPlayerGamemode(gamemode: Creative)), "02", "gamemode creative")
eqHex(wrote(CSetPlayerGamemode(gamemode: Spectator)), "0c", "gamemode spectator is 6")
eqHex(wrote(newCSetSpawnPosition(1'i32, newBlockPos(10'i32, 64'i32, -10'i32), 0'i32,
  newBlockPos(11'i32, 65'i32, -11'i32))), "02148001130016820115", "spawn position")
eqHex(wrote(newCSetTime(-6000'i32)), "df5d", "time")
eqHex(wrote(newCSetTitle(2'i32, "Hi", 10'i32, 70'i32, 20'i32)), "04024869148c0128000000", "title")
eqHex(wrote(newCShowCredits(newVarULong(5'u64), newVarInt(-1'i32))), "0501", "credits")
eqHex(wrote(newCTakeItemActor(newVarULong(7'u64), newVarULong(300'u64))), "07ac02", "take item")
eqHex(wrote(newCTransfer("example.com", 19132'u16, true)), "0b6578616d706c652e636f6dbc4a01", "transfer")
eqHex(wrote(CUpdateAbilities(targetPlayerRawId: -2'i64, playerPermission: 2'u8, commandPermission: 3'u8,
  layers: @[ability, ability])), "feffffffffffffff0203020100ffff0300ff010000cdcc4c3d0000803fcdcccc3d0100ffff0300ff010000cdcc4c3d0000803fcdcccc3d", "update abilities")
check(ord(abAbilityCount) == 20 and ord(abVerticalFlySpeed) == 19 and ord(abMayFly) == 10, "ability values")
eqHex(wrote(CUpdateAttributes(runtimeId: newVarULong(1'u64), attributes: @[Attribute(minValue: 0.0'f32,
  maxValue: 20.0'f32, currentValue: 18.5'f32, defaultMinValue: 0.0'f32, defaultMaxValue: 20.0'f32,
  defaultValue: 20.0'f32, name: "minecraft:health", modifiersListSize: newVarUInt(0'u32))],
  playerTick: newVarULong(300'u64))), "0101000000000000a04100009441000000000000a0410000a041106d696e6563726166743a6865616c746800ac02", "update attributes")
let ub = newCUpdateBlock(newBlockPos(1'i32, 2'i32, 3'i32), 13094'u32)
check(ub.flags.value == 3'u32 and ub.layer.value == 0'u32, "update block defaults")
eqHex(wrote(ub), "020406a6660300", "update block")
eqHex(wrote(CPlayerHotbar(selectedSlot: newVarUInt(4'u32), containerId: 0'u8, shouldSelectBlock: true)),
  "040001", "player hotbar")
eqHex(wrote(newCRemoveActor(newVarLong(-9'i64))), "11", "remove actor")
eqHex(wrote(CSetActorLink(link: link)), "05d8040101000000003f", "set actor link")
eqHex(wrote(newCSetActorMotion(newVarULong(2'u64), v3(0.0, -0.08'f32, 0.0), newVarULong(5'u64))), "02000000000ad7a3bd0000000005",
  "actor motion")
eqHex(wrote(newCMoveActorAbsolute(newVarULong(2'u64), 3'u8, v3(1.0, 2.0, 3.0), 64'u8, 128'u8, 129'u8)),
  "02030000803f0000004000004040408081", "move actor absolute")
check(CMoveActorAbsoluteFlagOnGround == 1'u8 and CMoveActorAbsoluteFlagTeleport == 2'u8 and
  CMoveActorAbsoluteFlagForceMove == 4'u8, "move absolute flags")
eqHex(wrote(newCMoveActorDelta(newVarULong(2'u64), 0x3F'u16, 1.0'f32, 2.0'f32, 3.0'f32, 4'u8, 5'u8, 6'u8)),
  "023f000000803f0000004000004040040506", "move actor delta all")
# Only the components the flags name are written: x and z, with the on-ground flag.
eqHex(wrote(newCMoveActorDelta(newVarULong(2'u64), MOVE_ACTOR_DELTA_FLAG_HAS_X or MOVE_ACTOR_DELTA_FLAG_HAS_Z or
  MOVE_ACTOR_DELTA_FLAG_ON_GROUND, 1.0'f32, 2.0'f32, 3.0'f32, 4'u8, 5'u8, 6'u8)), "0245000000803f00004040",
  "move actor delta partial")
eqHex(wrote(newCMovePlayer(newVarULong(1'u64), v3(1.0, 2.0, 3.0), 10.0'f32, 20.0'f32, 30.0'f32, CMovePlayerModeNormal,
  true, newVarULong(0'u64), 3'i32, 1'i32, newVarULong(9'u64))), "010000803f0000004000004040000020410000a0410000f04100010009", "move player normal")
# Teleport mode adds the cause and source entity type.
eqHex(wrote(newCMovePlayer(newVarULong(1'u64), v3(1.0, 2.0, 3.0), 10.0'f32, 20.0'f32, 30.0'f32, CMovePlayerModeTeleport,
  false, newVarULong(0'u64), 3'i32, 1'i32, newVarULong(9'u64))), "010000803f0000004000004040000020410000a0410000f041020000030000000100000009", "move player teleport")
eqHex(wrote(newCChangeDimension(1'i32, v3(0.0, 100.0, 0.0), true)), "02000000000000c842000000000100", "change dimension")
eqHex(wrote(newCNetworkChunkPublisherUpdate(newBlockPos(0'i32, 64'i32, 0'i32), 96'u32)),
  "008001006000000000", "chunk publisher update")
# The chunk list count is a little-endian u32.
var cpu = newCNetworkChunkPublisherUpdate(newBlockPos(0'i32, 64'i32, 0'i32), 96'u32)
cpu.serverBuildChunkList = @[Vector2[int32](x: 1'i32, y: -2'i32), Vector2[int32](x: 3'i32, y: 4'i32)]
eqHex(wrote(cpu), "00800100600200000002030608", "chunk publisher update with chunks")

proc boss(a: BossEventAction): CBossEvent = CBossEvent(bossEntityId: newVarLong(5'i64), action: a)
eqHex(wrote(boss(BossEventAction(kind: beaAdd, title: "Dragon", healthPercent: 1.0'f32, color: newVarInt(3'i32),
  overlay: newVarInt(2'i32)))), "0a000006447261676f6e06447261676f6e0000803f0302", "boss add")
eqHex(wrote(boss(BossEventAction(kind: beaRemove))), "0a00020000000000000000", "boss remove")
eqHex(wrote(boss(BossEventAction(kind: beaUpdateHealth, healthPercent: 0.5'f32))), "0a000300000000003f0000", "boss health")
eqHex(wrote(boss(BossEventAction(kind: beaUpdateTitle, title: "T"))), "0a000401540154000000000000", "boss title")
eqHex(wrote(boss(BossEventAction(kind: beaUpdateProperties, color: newVarInt(1'i32), overlay: newVarInt(6'i32)))),
  "0a00050000000000000106", "boss properties")

echo "all clientbound simple packet checks passed"
