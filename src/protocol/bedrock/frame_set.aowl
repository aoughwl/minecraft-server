## Port of pumpkin-protocol/src/bedrock/frame_set.rs
## RakNet frame sets (datagrams 0x80..0x8f) and the frames inside them.
##
## One difference from upstream: `Frame::read` computes the byte length `(bit_length + 7) >> 3` in 32 bits.
## Upstream does it in u16, which wraps in release builds for a bit length above 65528 and panics in
## debug builds; here such a frame is rejected by the MTU check, as every oversized frame is.

import ../protobase, ../netcodec, ../serial
import bedrockmod

type
  Frame* = object
    reliability*: RakReliability
    payload*: seq[byte]
    reliableNumber*: uint32
    sequenceIndex*: uint32
    orderIndex*: uint32
    orderChannel*: uint8
    splitSize*: uint32
    splitId*: uint16
    splitIndex*: uint32

  FrameSet* = object
    sequence*: U24
    frames*: seq[Frame]

proc defaultFrame*(): Frame =
  ## `Frame::default()`: reliability `ReliableOrdered`, everything else zero.
  Frame(reliability: rrReliableOrdered, payload: @[])

proc newUnreliable*(payload: seq[byte]): Frame =
  ## `Frame::new_unreliable`.
  Frame(reliability: rrUnreliable, payload: payload)

proc defaultFrameSet*(): FrameSet =
  FrameSet(sequence: U24(value: 0'u32), frames: @[])

proc readFrames*(r: var NetReader): ProtoReadResult[seq[Frame]] =
  ## `Frame::read`: frames until the reader is empty.
  var frames: seq[Frame] = @[]
  while remaining(r) > 0:
    let header = tryRead(seq[Frame], getU8(r))
    var frame = defaultFrame()
    let reliabilityId = (header and 0xE0'u8) shr 5
    let (known, reliability) = rakReliabilityFromId(reliabilityId)
    if not known:
      return readErr[seq[Frame]](messageRead("Invalid reliability"))
    let split = (header and RAKNET_SPLIT) != 0'u8
    let bitLength = tryRead(seq[Frame], packetReadBe(uint16, r))
    let byteLength = (uint32(bitLength) + 7'u32) shr 3
    if byteLength > uint32(MTU):
      return readErr[seq[Frame]](messageRead("Frame payload length exceeds RakNet MTU"))
    if reliability.isReliable():
      frame.reliableNumber = tryRead(seq[Frame], packetRead(U24, r)).value
    if reliability.isSequenced():
      frame.sequenceIndex = tryRead(seq[Frame], packetRead(U24, r)).value
    if reliability.isOrdered():
      frame.orderIndex = tryRead(seq[Frame], packetRead(U24, r)).value
      frame.orderChannel = tryRead(seq[Frame], packetRead(uint8, r))
    if split:
      frame.splitSize = tryRead(seq[Frame], packetReadBe(uint32, r))
      frame.splitId = tryRead(seq[Frame], packetReadBe(uint16, r))
      frame.splitIndex = tryRead(seq[Frame], packetReadBe(uint32, r))
    frame.reliability = reliability
    frame.payload = tryRead(seq[Frame], readSlice(r, int(byteLength)))
    frames.add(frame)
  readOk(frames)

proc write*(self: Frame; w: var NetWriter) =
  ## `Frame::write`.
  let isSplit = self.splitSize > 0'u32
  var flags = self.reliability.toId() shl 5
  if isSplit:
    flags = flags or RAKNET_SPLIT
  packetWrite(flags, w)
  # Size, in bits
  packetWriteBe(uint16(self.payload.len) shl 3, w)
  if self.reliability.isReliable():
    packetWrite(U24(value: self.reliableNumber), w)
  if self.reliability.isSequenced():
    packetWrite(U24(value: self.sequenceIndex), w)
  if self.reliability.isOrdered():
    packetWrite(U24(value: self.orderIndex), w)
    packetWrite(self.orderChannel, w)
  if isSplit:
    packetWriteBe(self.splitSize, w)
    packetWriteBe(self.splitId, w)
    packetWriteBe(self.splitIndex, w)
  writeSlice(w, self.payload)

proc readFrameSet*(r: var NetReader): ProtoReadResult[FrameSet] =
  ## `FrameSet::read`: the u24 sequence number, then the frames.
  let sequence = tryRead(FrameSet, packetRead(U24, r))
  let frames = tryRead(FrameSet, readFrames(r))
  readOk(FrameSet(sequence: sequence, frames: frames))

proc writePacketData*(self: FrameSet; w: var NetWriter; id: uint8) =
  ## `FrameSet::write_packet_data`.
  packetWrite(id, w)
  packetWrite(self.sequence, w)
  for i in 0 ..< self.frames.len:
    self.frames[i].write(w)
