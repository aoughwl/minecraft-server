## Known-answer test for inventory_transaction_v2.aowl. The four payloads are the real-client bytes pinned in the upstream
## tests: two from commit cfef83339 (1.26.40) and two from the 1.26.60 tree (../ref/pumpkin), copied byte for byte. The
## asserted values are the ones those Rust tests assert (RUN here); nothing is asserted about protocol 1001.
import std/options
import bedrocktestutil
import ../../util/math/position
import server/[inventory_transaction, inventory_transaction_v2]
import network_item

proc parsedV2(hex: string; layout: TransactionLayout): SInventoryTransaction =
  var r = newNetReader(hx(hex))
  let res = packetReadInventoryTransactionV2(r, layout)
  if not res.isOk:
    echo "FAIL: transaction did not decode: ", res.error.msg
    quit(1)
  check(r.remaining() == 0, "every captured byte consumed")
  res.value

proc main() =
  # --- 1.26.40, empty hand, a click on a block (no actions)
  let a1 = parsedV2("0000010201000001ec048001cb06030000000000000000008cf69b43723d8342f3e1d1c30090613f008d263f0000803ffd590100", tlV1_26_40)
  check(a1.transactionData.kind == tdUseItem and a1.actions.len == 0, "1.26.40 empty hand: use item, no actions")
  let d1 = a1.transactionData.useItem
  check(d1.actionType.value == 0'u32 and d1.blockFace == 3'i32 and d1.itemInHand.id.value == 0'i32, "1.26.40 empty hand fields")
  check(d1.blockPosition == newBlockPos(310'i32, 64'i32, -422'i32), "1.26.40 block position is three ZigZag VarInts")
  check(d1.blockRuntimeId.value == 11517'u32 and d1.clientPrediction == 1'u8, "1.26.40 block runtime id and prediction")
  # --- 1.26.40, crafting table in hand
  let a2 = parsedV2("000001020101000101000100023a0001000000fd590a0000000000000000000000000000000000000001a6057ed90601043a0001000000fd590a000000000000000000005f0faa43723d8342b839d5c30016153f0000803f00c8813eb65e0100", tlV1_26_40)
  check(a2.actions.len == 1 and a2.actions[0].oldItem.id.value == 58'i32 and a2.actions[0].newItem.id.value == 0'i32, "1.26.40 crafting table: action items")
  check(a2.actions[0].windowId.isSome and a2.actions[0].windowId.unsafeGet == 0'i32 and a2.actions[0].inventorySlot == 2'u32, "1.26.40 action window and slot")
  let d2 = a2.transactionData.useItem
  check(d2.blockFace == 1'i32 and d2.hotBarSlot.value == 2'i32 and d2.itemInHand.id.value == 58'i32 and d2.itemInHand.stackSize == 1'u16 and
    d2.itemInHand.blockRuntimeId.value == 11517'i32, "1.26.40 crafting table: use item fields")
  # --- 1.26.60 (latest), empty hand with the hand byte
  let b1 = parsedV2("000002000001ec048001cb0603000100000000000000008cf69b43723d8342f3e1d1c30090613f008d263f0000803ffd590100", tlLatest)
  let e1 = b1.transactionData.useItem
  check(e1.hand == 1'u8 and e1.blockFace == 3'i32 and e1.itemInHand.id.value == 0'i32 and e1.actionType.value == 0'u32, "latest empty hand: off hand")
  check(e1.blockPosition == newBlockPos(310'i32, 64'i32, -422'i32), "latest block position")
  # --- 1.26.60 (latest), crafting table
  let b2 = parsedV2("0000020100010000023a0001000000fd590a0000000000000000000000000000000000000001a6057ed9060104003a0001000000fd590a000000000000000000005f0faa43723d8342b839d5c30016153f0000803f00c8813eb65e0100", tlLatest)
  check(b2.actions.len == 1 and b2.actions[0].oldItem.id.value == 58'i32 and b2.actions[0].newItem.id.value == 0'i32, "latest crafting table: action items")
  let e2 = b2.transactionData.useItem
  check(e2.hand == 0'u8 and e2.blockFace == 1'i32 and e2.hotBarSlot.value == 2'i32 and e2.itemInHand.id.value == 58'i32 and
    e2.itemInHand.stackSize == 1'u16 and e2.itemInHand.blockRuntimeId.value == 11517'i32, "latest crafting table: use item fields")
  # the cross-reads fail or stop short, so the layout cannot be guessed from a payload that is not captured
  var r = newNetReader(hx("000002000001ec048001cb0603000100000000000000008cf69b43723d8342f3e1d1c30090613f008d263f0000803ffd590100"))
  let wrong = packetReadInventoryTransactionV2(r, tlV1_26_40)
  check(not wrong.isOk or r.remaining() != 0, "a latest payload is not a valid 1.26.40 one")
  # the pinned 1001 reader does NOT decode the captured 1.26.40 bytes: the layout changed after 1001 (this is not a claim about 1001 itself)
  var r1001 = newNetReader(hx("0000010201000001ec048001cb06030000000000000000008cf69b43723d8342f3e1d1c30090613f008d263f0000803ffd590100"))
  let old1001 = packetRead(SInventoryTransaction, r1001)
  check(not old1001.isOk or r1001.remaining() != 0 or old1001.value.transactionData.kind != tdUseItem, "the 1001 reader and the 1.26.40 capture disagree")
  echo "inventory_transaction_v2test ok"

main()
