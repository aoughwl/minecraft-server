{.feature: "untyped".}
## Test for client/level_chunk.aowl: the sub chunk layout of a real `ChunkData`. Expected bytes were laid out from
## the pinned level_chunk.rs and palette.rs with struct.pack in a scratch script: header VarInts, then per sub chunk
## `09 01 <y>`, the bits-per-entry byte with the runtime flag, the packed little-endian u32 words, and the palette as
## ZigZag VarInts of the Bedrock runtime ids. The runtime id of air (13094) and of plains (1) are asserted in
## data/blocktest.aowl and data_codegen/biometest.aowl; the stone id is read from the same table.
import bedrocktestutil
import ../../world/chunkdata
import ../../world/palette
import ../../generated/biome as genbiome
import ../../generated/block_properties
import ../../data/block_state
import client/level_chunk

proc varInt(n: int32): string =
  var w = newNetWriter()
  packetWrite(newVarInt(n), w)
  hexOf(w.buf)

let airId = int32(toBeNetworkId(BlockStateId(0'u16)))
let stoneId = int32(toBeNetworkId(BlockStateId(1'u16)))
check(airId == 13094'i32, "air is runtime id 13094")

# Two sub chunks from y = -64 (sections -4 and -3). Section 0 is all air; section 1 has one stone at the cell that
# `get(1, 2, 3)` reads, which the Bedrock layout visits as x = 1, y = 3, z = 2: word 9, bit 18 (index x*256+y*16+z = 306).
var sections = newChunkSections(2, -64'i32, 0'u32, uint32(PLAINS.id))
discard sections.blockSections[1].set(1, 2, 3, 1'u32)
let chunk = newChunkData(5'i32, -7'i32, sections)

var words = ""
for i in 0 ..< 128:
  words.add(if i == 9: "00000400" else: "00000000")  # 1 << 18 = 0x00040000, little-endian: 00 00 04 00

let airSection = "09 01 fc 01 " & varInt(airId)                    # y = -4 as a byte, bits 0 -> (0 << 1) | 1
let stoneSection = "09 01 fd 03 " & words & " " & varInt(2) & " " & varInt(airId) & " " & varInt(stoneId)
let plains = "01 " & varInt(1)                                       # single palette, plains is Bedrock biome 1
let biome0 = "09 01 fc " & plains
let biome1 = "09 01 fd " & plains
let data = airSection & stoneSection & biome0 & biome1 & "00"
var payload = newNetWriter()
let nBytes = hx(data).len
let header = varInt(5'i32) & varInt(-7'i32) & varInt(0'i32) & "02" & "00"

var w = newNetWriter()
packetWrite(CLevelChunk(dimension: 0'i32, cacheEnabled: false, chunk: chunk), w)
var lenW = newNetWriter()
packetWrite(newVarUInt(uint32(nBytes)), lenW)
eqHex(w.buf, header & hexOf(lenW.buf) & data, "level chunk")
check(CLevelChunkPacketId == 58'i32, "level chunk id")

# A different dimension and the cache flag change only the header.
var w2 = newNetWriter()
packetWrite(CLevelChunk(dimension: 1'i32, cacheEnabled: true, chunk: chunk), w2)
eqHex(w2.buf, varInt(5'i32) & varInt(-7'i32) & varInt(1'i32) & "0201" & hexOf(lenW.buf) & data, "level chunk, dimension 1 with cache")

echo "all level chunk checks passed"
