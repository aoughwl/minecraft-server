{.feature: "untyped".}
## Test for server/login.aowl: `SLogin`'s read (with upstream's own `reads_raw_token_larger_than_two_mib`) and the
## serde-style client data decoding. The packet bytes are the layout in the pinned login.rs (big-endian protocol
## number, VarUInt connection request length, then a little-endian u32 length before each token).
import bedrocktestutil
import ../../codecs/json_value
import server/login

# Upstream `reads_raw_token_larger_than_two_mib`: protocol 975, jwt "{}", a 2 MiB + 1 byte raw token.
block:
  const RawTokenLen = 2 * 1024 * 1024 + 1
  var jwt: seq[byte] = @[]
  for ch in "{}":
    jwt.add(uint8(ch))
  var clientToken = newSeq[byte](RawTokenLen)
  for i in 0 ..< RawTokenLen:
    clientToken[i] = 0x41'u8
  let connectionRequestLen = 4 + jwt.len + 4 + clientToken.len
  var w = newNetWriter()
  packetWriteBe(975'i32, w)
  packetWrite(newVarUInt(uint32(connectionRequestLen)), w)
  packetWrite(uint32(jwt.len), w)
  writeSlice(w, jwt)
  packetWrite(uint32(clientToken.len), w)
  writeSlice(w, clientToken)
  var r = newNetReader(w.buf)
  let packet = packetRead(SLogin, r)
  check(packet.isOk, "read login packet")
  check(packet.value.protocolVersion == 975'i32, "protocol version")
  check(packet.value.jwt == jwt, "jwt")
  check(packet.value.rawToken.len == RawTokenLen, "raw token length")
  check(packet.value.rawToken == clientToken, "raw token")

# Limits: a part longer than MAX_PACKET_DATA_SIZE is refused before it is read.
block:
  var jwtTooLong = newNetReader(hx("000003e9 0a 00008001"))
  let a = packetRead(SLogin, jwtTooLong)
  check(not a.isOk and a.error.msg == "JWT length 25165824 exceeds limit 8388608", "jwt too long: " & a.error.msg)
  var tokenTooLong = newNetReader(hx("000003e9 0a 00000000 00008001"))
  let b = packetRead(SLogin, tokenTooLong)
  check(not b.isOk and b.error.msg == "Raw token length 25165824 exceeds limit 8388608", "raw token too long")
  var shortJwt = newNetReader(hx("000003e9 0a 05000000 6162"))
  check(not packetRead(SLogin, shortJwt).isOk, "a jwt shorter than its length is an error")
  check(SLoginPacketId == 1'i32, "login id")

# --- client data -------------------------------------------------------------------------------------------
const MinimalJson = "{\"ClientRandomId\":-123456789012,\"DeviceOS\":7,\"DeviceId\":\"dev-1\",\"GameVersion\":\"1.26.30\"," &
  "\"LanguageCode\":\"en_US\",\"CurrentInputMode\":1,\"DefaultInputMode\":2,\"UIProfile\":0,\"ServerAddress\":\"localhost:19132\"," &
  "\"MaxViewDistance\":12,\"SomethingNew\":[1,2,3]}"

proc parse(text: string): JsonValue =
  let p = parseJsonValue(text)
  check(p.ok, "json parses")
  p.value

block:
  let cd = clientDataFromJson(parse(MinimalJson))
  check(cd.isOk, "minimal client data")
  check(cd.value.clientRandomId == -123456789012'i64 and cd.value.deviceOs == 7'i32 and cd.value.deviceId == "dev-1" and
    cd.value.gameVersion == "1.26.30" and cd.value.languageCode == "en_US" and cd.value.currentInputMode == 1'i32 and
    cd.value.defaultInputMode == 2'i32 and cd.value.uiProfile == 0'i32 and cd.value.serverAddress == "localhost:19132" and
    cd.value.maxViewDistance == 12'i32, "required fields")
  # Everything with #[serde(default)] is zero or empty, and unknown keys are ignored.
  check(cd.value.deviceModel == "" and cd.value.guiScale == 0'i32 and not cd.value.clientIsEditorCapable and
    cd.value.platformOnlineId == "" and cd.value.skinId == "" and cd.value.animatedImageData.len == 0 and
    cd.value.personaPieces.len == 0 and cd.value.pieceTintColours.len == 0 and not cd.value.personaSkin, "defaults")

block:
  let full = "{\"ClientRandomId\":1,\"DeviceOS\":2,\"DeviceId\":\"d\",\"GameVersion\":\"g\",\"LanguageCode\":\"l\"," &
    "\"CurrentInputMode\":3,\"DefaultInputMode\":4,\"UIProfile\":5,\"ServerAddress\":\"s\",\"MaxViewDistance\":6," &
    "\"DeviceModel\":\"model\",\"GuiScale\":-1,\"ClientIsEditorCapable\":true,\"ClientEditorConnectionIntent\":8," &
    "\"MemoryTier\":2,\"PlatformType\":1,\"GraphicsMode\":3,\"CompatibleWithClientSideChunkGen\":true," &
    "\"PlatformOfflineId\":\"po\",\"PlatformOnlineId\":\"pn\",\"PlatformUserId\":\"pu\",\"SelfSignedId\":\"ss\"," &
    "\"PlayFabId\":\"pf\",\"ThirdPartyName\":\"tp\",\"ThirdPartyNameOnly\":true,\"SkinId\":\"sk\",\"SkinData\":\"AAAA\"," &
    "\"SkinImageHeight\":64,\"SkinImageWidth\":128,\"SkinColor\":\"#fff\",\"ArmSize\":\"slim\",\"PersonaSkin\":true," &
    "\"PremiumSkin\":true,\"TrustedSkin\":true,\"OverrideSkin\":true,\"CapeData\":\"cd\",\"CapeId\":\"ci\"," &
    "\"CapeImageHeight\":32,\"CapeImageWidth\":64,\"CapeOnClassicSkin\":true,\"SkinGeometryData\":\"geo\"," &
    "\"SkinGeometryDataEngineVersion\":\"1.0\",\"SkinResourcePatch\":\"rp\",\"SkinAnimationData\":\"ad\"," &
    "\"AnimatedImageData\":[{\"Frames\":2.5,\"Image\":\"img\",\"ImageHeight\":2,\"ImageWidth\":3,\"Type\":1," &
    "\"AnimationExpression\":4}],\"PersonaPieces\":[{\"IsDefault\":true,\"PackId\":\"pk\",\"PieceId\":\"pc\"," &
    "\"PieceType\":\"skin\",\"ProductId\":\"pr\"}],\"PieceTintColors\":[{\"Colors\":[\"a\",\"b\",\"c\",\"d\"],\"PieceType\":\"hair\"}]}"
  let cd = clientDataFromJson(parse(full))
  check(cd.isOk, "full client data: " & cd.error.msg)
  let v = cd.value
  check(v.deviceModel == "model" and v.guiScale == -1'i32 and v.clientIsEditorCapable and v.clientEditorConnectionIntent == 8'i32 and
    v.memoryTier == 2'i32 and v.platformType == 1'i32 and v.graphicsMode == 3'i32 and v.compatibleWithClientSideChunkGen,
    "defaulted fields, set")
  check(v.platformOfflineId == "po" and v.platformOnlineId == "pn" and v.platformUserId == "pu" and v.selfSignedId == "ss" and
    v.playFabId == "pf" and v.thirdPartyName == "tp" and v.thirdPartyNameOnly, "platform ids")
  check(v.skinId == "sk" and v.skinData == "AAAA" and v.skinImageHeight == 64'i32 and v.skinImageWidth == 128'i32 and
    v.skinColour == "#fff" and v.armSize == "slim" and v.personaSkin and v.premiumSkin and v.trustedSkin and v.overrideSkin and
    v.capeData == "cd" and v.capeId == "ci" and v.capeImageHeight == 32'i32 and v.capeImageWidth == 64'i32 and
    v.capeOnClassicSkin and v.skinGeometry == "geo" and v.skinGeometryVersion == "1.0" and v.skinResourcePatch == "rp" and
    v.skinAnimationData == "ad", "skin fields")
  check(v.animatedImageData.len == 1 and v.animatedImageData[0].frames == 2.5 and v.animatedImageData[0].image == "img" and
    v.animatedImageData[0].imageHeight == 2'i32 and v.animatedImageData[0].imageWidth == 3'i32 and
    v.animatedImageData[0].animationType == 1'i32 and v.animatedImageData[0].animationExpression == 4'i32, "animations")
  check(v.personaPieces.len == 1 and v.personaPieces[0].isDefault and v.personaPieces[0].packId == "pk" and
    v.personaPieces[0].pieceId == "pc" and v.personaPieces[0].pieceType == "skin" and v.personaPieces[0].productId == "pr",
    "persona pieces")
  check(v.pieceTintColours.len == 1 and v.pieceTintColours[0].colours == ["a", "b", "c", "d"] and
    v.pieceTintColours[0].pieceType == "hair", "tint colours")

# Errors follow serde's wording.
block:
  let noDevice = clientDataFromJson(parse("{\"ClientRandomId\":1}"))
  check(not noDevice.isOk and noDevice.error.msg == "missing field `DeviceOS`", "missing field: " & noDevice.error.msg)
  let notObject = clientDataFromJson(parse("[1]"))
  check(not notObject.isOk and notObject.error.msg == "invalid type: sequence, expected struct ClientData", "not an object")
  let wrongType = clientDataFromJson(parse("{\"ClientRandomId\":\"x\"}"))
  check(not wrongType.isOk and wrongType.error.msg == "invalid type: string \"x\", expected i64", "wrong type")
  let tooBig = clientDataFromJson(parse("{\"ClientRandomId\":1,\"DeviceOS\":4294967296}"))
  check(not tooBig.isOk and tooBig.error.msg == "invalid value: integer `4294967296`, expected i32", "i32 range")
  let badColours = personaPieceTintColourFromJson(parse("{\"Colors\":[\"a\"],\"PieceType\":\"x\"}"))
  check(not badColours.isOk and badColours.error.msg == "invalid length 1, expected an array of length 4", "colours length")
  let badPiece = personaPieceFromJson(parse("{\"IsDefault\":true}"))
  check(not badPiece.isOk and badPiece.error.msg == "missing field `PackId`", "persona piece needs every field")

echo "all login checks passed"
