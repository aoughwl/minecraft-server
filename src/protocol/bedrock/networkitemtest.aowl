## Test for network_item.aowl. Protocol 1001. Bedrock ids come from assets/bedrock/runtime_item_states.json
## (minecraft:stick is 352, minecraft:shield 387). Each expected byte string was laid out from the pinned Rust
## with struct.pack in a scratch script. The reads include upstream's asymmetries: `NetworkItemDescriptor` writes
## no net-id flag but reads one, `ItemStackWrapper` writes its id as a VarInt but reads an i16, and the two block
## lists are written with a little-endian u32 count and read with a VarUInt one (see the unit tests below).
import std/options
import bedrocktestutil
import network_item
import ../../nbt/[nbtbase, nbtdoc, tag]
import "../../data/item_stack/mod"
import ../../generated/item_full

proc readNid(hex: string): NetworkItemDescriptor =
  var r = newNetReader(hx(hex))
  let res = packetRead(NetworkItemDescriptor, r)
  check(res.isOk, "read nid " & hex)
  check(remaining(r) == 0, "read nid consumed " & hex)
  res.value

# --- NetworkItemDescriptor, write -----------------------------------------------------------------------
eqHex(wrote(defaultNetworkItemDescriptor()), "00", "air descriptor")
let stick = NetworkItemDescriptor(id: newVarInt(352'i32), stackSize: 3'u16, auxValue: newVarUInt(0'u32),
  blockRuntimeId: newVarInt(0'i32), nbtData: Nbt(), placeOnBlocks: @[], destroyBlocks: @[], shieldBlockingTick: 0'i64)
eqHex(wrote(stick), "c005030000000a00000000000000000000", "stick descriptor")
var withLists = stick
withLists.stackSize = 64'u16
withLists.auxValue = newVarUInt(2'u32)
withLists.blockRuntimeId = newVarInt(12'i32)
withLists.placeOnBlocks = @["minecraft:stone"]
withLists.destroyBlocks = @["a", "bc"]
eqHex(wrote(withLists), "c005400002181f0000010000000f6d696e6563726166743a73746f6e65020000000161026263", "descriptor with block lists")

# A non-empty NBT compound: -1 as an i16, version byte 1, then the compound in Bedrock network form.
var comp = NbtCompound()
comp.putInt("x", 5'i32)
var withNbt = stick
withNbt.stackSize = 1'u16
withNbt.nbtData = toNbtDoc(comp)
eqHex(wrote(withNbt), "c0050100000012ffff010a000301780a000000000000000000", "descriptor with nbt")

var shield = stick
shield.id = newVarInt(387'i32)
shield.stackSize = 1'u16
shield.shieldBlockingTick = 100'i64
eqHex(wrote(shield), "86060100000012000000000000000000006400000000000000", "shield descriptor has the blocking tick")

# --- NetworkItemDescriptor, read ------------------------------------------------------------------------
let air = readNid("00")
check(air.id.value == 0'i32 and air.stackSize == 0'u16, "read air")
let netRead = readNid("c00505000701036e03080000010170010164")
check(netRead.id.value == 352'i32 and netRead.stackSize == 5'u16 and netRead.auxValue.value == 7'u32 and
  netRead.blockRuntimeId.value == -2'i32, "read with net id")
check(netRead.placeOnBlocks == @["p"] and netRead.destroyBlocks == @["d"], "read block lists")
let plain = readNid("c00505000700120400000000")
check(plain.blockRuntimeId.value == 9'i32 and plain.placeOnBlocks.len == 0 and plain.nbtData.rootTag.isEmpty(), "read plain")
let nbtRead = readNid("c00502000000000effff010a000301780a0001017800")
check(not nbtRead.nbtData.rootTag.isEmpty() and nbtRead.placeOnBlocks == @["x"], "read nbt")
let shieldRead = readNid("860601000000000c00000000f9ffffffffffffff")
check(shieldRead.id.value == 387'i32 and shieldRead.shieldBlockingTick == -7'i64, "read shield tick")
var truncated = newNetReader(hx("c005 0300"))
check(not packetRead(NetworkItemDescriptor, truncated).isOk, "truncated descriptor")

# --- ItemStackWrapper -----------------------------------------------------------------------------------
var wrapper = defaultItemStackWrapper()
eqHex(wrote(wrapper), "00", "air wrapper")
wrapper = ItemStackWrapper(id: 352'i16, stackSize: 2'u16, auxValue: newVarUInt(1'u32), blockRuntimeId: newVarInt(4'i32),
  nbtData: Nbt(), placeOnBlocks: @[], destroyBlocks: @[], shieldBlockingTick: 0'i64, netId: 0'i32)
eqHex(wrote(wrapper), "c00502000100080a00000000000000000000", "wrapper without net id")
wrapper.netId = 300'i32
eqHex(wrote(wrapper), "c00502000101d804080a00000000000000000000", "wrapper with net id")
var wshield = defaultItemStackWrapper()
wshield.id = 387'i16
wshield.stackSize = 1'u16
wshield.netId = -5'i32
wshield.shieldBlockingTick = 9'i64
eqHex(wrote(wshield), "860601000001090012000000000000000000000900000000000000", "wrapper shield")
var wr = newNetReader(hx("600102000101d8040806000000010171"))
let wnet = packetRead(ItemStackWrapper, wr)
check(wnet.isOk and remaining(wr) == 0, "read wrapper")
check(wnet.value.id == 352'i16 and wnet.value.netId == 300'i32 and wnet.value.destroyBlocks == @["q"] and
  wnet.value.blockRuntimeId.value == 4'i32, "wrapper fields")
var wr2 = newNetReader(hx("600102000100080400000000"))
check(packetRead(ItemStackWrapper, wr2).value.netId == 0'i32, "wrapper without net id")
var wr3 = newNetReader(hx("0000"))
check(packetRead(ItemStackWrapper, wr3).value.id == 0'i16 and remaining(wr3) == 0, "wrapper air")

# --- NetworkItemStackDescriptor -------------------------------------------------------------------------
eqHex(wrote(defaultNetworkItemStackDescriptor()), "0000000000000000", "air stack descriptor")
var d = defaultNetworkItemStackDescriptor()
d.id = 352'i16
d.stackSize = 3'u16
eqHex(wrote(d), "6001030000000000", "stack descriptor")
d.auxValue = newVarUInt(1'u32)
d.blockRuntimeId = newVarUInt(5'u32)
d.extraData = @[0'u8, 0'u8]
d.netId = 77'i32
eqHex(wrote(d), "600103000101009a0105020000", "stack descriptor with net id writes variant 0")
d.extraData = @[9'u8]
d.netId = -3'i32
d.netIdVariant = some(newVarUInt(2'u32))
eqHex(wrote(d), "6001030001010205050109", "stack descriptor with variant")
var dr = newNetReader(hx("6001030001010205050109"))
let dback = packetRead(NetworkItemStackDescriptor, dr)
check(dback.isOk and remaining(dr) == 0 and dback.value.netId == -3'i32 and dback.value.netIdVariant.get().value == 2'u32 and
  dback.value.extraData == @[9'u8] and dback.value.blockRuntimeId.value == 5'u32, "stack descriptor read")

# --- ContainerName / FullContainerName ------------------------------------------------------------------
check(ord(cnAnvilInput) == 0 and ord(cnInventory) == 29 and ord(cnHotBar) == 28 and ord(cnDynamic) == 63 and
  ord(cnRecipeFurnaceItems) == 66, "container name values")
eqHex(wrote(FullContainerName(containerName: cnCombinedHotBarAndInventory, dynamicId: none[uint32]())),
  "0c00", "full container name, no dynamic id")
eqHex(wrote(FullContainerName(containerName: cnDynamic, dynamicId: some(0xABCD'u32))), "3f01cdab0000",
  "full container name with dynamic id")
var fr = newNetReader(hx("3f01cdab0000"))
let fback = packetRead(FullContainerName, fr)
check(fback.isOk and fback.value == FullContainerName(containerName: cnDynamic, dynamicId: some(0xABCD'u32)),
  "full container name read")
var fbad = newNetReader(hx("43 00"))
let fb = packetRead(FullContainerName, fbad)
check(not fb.isOk and fb.error.msg == "Invalid ContainerName ID: 67", "container name 67 is rejected")
check(containerNameFromU8(66'u8).isOk, "container name 66 is the last")

# --- NetworkItemStack -----------------------------------------------------------------------------------
var ar = newNetReader(hx("00"))
let nair = packetRead(NetworkItemStack, ar)
check(nair.isOk and nair.value.id.value == 0'i32 and nair.value.count == 0'u16 and nair.value.extraData.len == 0, "stack air")
var ir = newNetReader(hx("c00504000210020102"))
let nitem = packetRead(NetworkItemStack, ir)
check(nitem.isOk and remaining(ir) == 0 and nitem.value.id.value == 352'i32 and nitem.value.count == 4'u16 and
  nitem.value.auxValue.value == 2'u32 and nitem.value.blockRuntimeId.value == 8'i32 and
  nitem.value.extraData == @[1'u8, 2'u8], "stack item")

# --- From<&ItemStack> -----------------------------------------------------------------------------------
let stickStack = newItemStack(3'u8, ITEM_STICK)
let fromStack = networkItemDescriptorFromItemStack(stickStack)
check(fromStack.id.value == 352'i32 and fromStack.stackSize == 3'u16 and fromStack.auxValue.value == 0'u32, "descriptor from stack")
let wfrom = itemStackWrapperFromItemStack(stickStack)
check(wfrom.id == 352'i16 and wfrom.stackSize == 3'u16 and wfrom.netId == stickStack.uid, "wrapper from stack carries the uid")
let sfrom = networkItemStackDescriptorFromItemStack(stickStack)
check(sfrom.id == 352'i16 and sfrom.extraData == @[0'u8, 0'u8] and sfrom.netIdVariant.get().value == 0'u32 and
  sfrom.netId == stickStack.uid, "stack descriptor from stack")
check(networkItemDescriptorFromItemStack(emptyItemStack()).id.value == 0'i32, "empty stack is air")
check(itemStackWrapperFromItemStack(emptyItemStack()).id == 0'i16, "empty stack wrapper is air")

echo "all network item checks passed"
