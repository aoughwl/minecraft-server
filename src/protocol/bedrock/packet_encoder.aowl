## Port of pumpkin-protocol/src/bedrock/packet_encoder.rs
## `EncryptionAlreadyEnabledError` is packet_decoder.aowl's, as upstream's encoder uses it from there.
##
## raw -> compress -> encrypt
##
## Upstream's `UDPNetworkEncoder` builds one game packet into any `Write`; that is a `NetWriter` here. What
## upstream does not do in `write_game_packet` is encrypt: the network layer reaches the encryptor through
## `encryptor_mut()` and calls `encrypt` on the finished bytes (after the 0xfe byte). Here the encryptor is a
## public field pair, `hasEncryptor` and `encryptor`, for that caller.
##
## Gone with the async runtime, as in ../java/packet_encoder.aowl: `EncryptionWriter` (the AES-128 CFB8
## `AsyncWrite` wrapper, which Bedrock never uses; its encryption is the AES-256 CTR in crypto.aowl) and
## `write_packet`, which is `UdpSocket::send_to` and so belongs to whoever owns the socket.

import ../protobase, ../proto, ../varint, ../netcodec
import bedrockmod, crypto, rawdeflate
from packet_decoder import EncryptionAlreadyEnabledError

type
  UDPNetworkEncoder* = object
    ## Encoder: Server -> Client
    ## Supports zlib (raw deflate) compression and AES-256 encryption.
    hasCompression*: bool
    compressionThreshold*: CompressionThreshold
    compressionLevel*: CompressionLevel
    hasEncryptor*: bool
    encryptor*: BedrockEncryptor

  SetEncryptionResult* = object
    isOk*: bool
    error*: EncryptionAlreadyEnabledError

proc newUDPNetworkEncoder*(): UDPNetworkEncoder =
  UDPNetworkEncoder(hasCompression: false, hasEncryptor: false)

proc setCompression*(self: var UDPNetworkEncoder; threshold: CompressionThreshold; level: CompressionLevel) =
  ## `set_compression((threshold, level))`.
  self.hasCompression = true
  self.compressionThreshold = threshold
  self.compressionLevel = level

proc setEncryption*(self: var UDPNetworkEncoder; key: array[32, uint8]): SetEncryptionResult =
  if self.hasEncryptor:
    return SetEncryptionResult(isOk: false, error: EncryptionAlreadyEnabledError(msg: "Encryption already enabled"))
  self.encryptor = newBedrockEncryptor(key)
  self.hasEncryptor = true
  SetEncryptionResult(isOk: true)

proc writeGamePacket*(self: UDPNetworkEncoder; packetId: uint16; subClientSender, subClientTarget: SubClient;
    packetPayload: openArray[byte]; w: var NetWriter): ProtoWriteVoidResult =
  ## `write_game_packet`: the 0xfe byte, then (when compression is on) a 0x00 method byte and the raw
  ## deflate of the inner batch, which is `VarUInt(len)`, the 14-bit header `VarUInt(id | sender << 10 |
  ## target << 12)` and the payload. The batch holds exactly one packet.
  var inner = newNetWriter()

  # Gamepacket ID Header (14 bits)
  let headerValue = uint32(packetId) or (subClientValue(subClientSender) shl 10) or
    (subClientValue(subClientTarget) shl 12)
  let fourteenBitHeader = headerValue and 0x3FFF'u32

  let headerVarint = newVarUInt(fourteenBitHeader)
  let totalContentLength = uint32(writtenSizeVarUInt(headerVarint) + packetPayload.len)

  writeVarUInt(inner, newVarUInt(totalContentLength))
  writeVarUInt(inner, headerVarint)
  writeSlice(inner, packetPayload)

  # Handle Outer Container
  writeU8(w, 0xfe'u8) # Bedrock Game Packet Header

  if self.hasCompression:
    # Write Compression Method (0x00 for Zlib)
    writeU8(w, 0x00'u8)
    let compressed = rawDeflateCompress(inner.buf, self.compressionLevel)
    if not compressed.ok:
      return writeErrVoid(ioError(compressed.msg))
    writeSlice(w, compressed.data)
  else:
    writeSlice(w, inner.buf)
  writeOkVoid()
