## Test for client/play_extra.aowl. Each expected byte string was laid out by hand from the field order (little-endian numbers,
## ZigZag VarInt, VarUInt), not taken from this port's output. NOT captured from a real client: see the module header.
import bedrocktestutil
import ../../util/vector3
import network_item
import client/[play_extra, level_sound_event]

proc v3(x, y, z: float32): Vector3[float32] = Vector3[float32](x: x, y: y, z: z)

# ids
check(CActorEventPacketId == 27'i32 and CMobEffectPacketId == 28'i32 and CMobEquipmentPacketId == 31'i32 and
  CMobArmorEquipmentPacketId == 32'i32 and RespawnPacketId == 45'i32 and CLevelSoundEventPacketId == 123'i32, "packet ids")

# ActorEvent: runtime id 7, death animation, data 0
eqHex(wrote(CActorEvent(targetRuntimeId: newVarULong(7'u64), eventId: ActorEventDeath, data: newVarInt(0'i32))), "070300", "actor event death")
# MobEffect: speed (1) amplifier 1 (zigzag 2), particles, 1200 ticks (zigzag 2400 = b0 12)
eqHex(wrote(CMobEffect(targetRuntimeId: newVarULong(7'u64), eventId: MobEffectAdd, effectId: newVarInt(1'i32),
  effectAmplifier: newVarInt(1'i32), showParticles: true, effectDurationTicks: newVarInt(1200'i32), tick: newVarULong(0'u64))),
  "07010202" & "01" & "e012" & "00", "mob effect add")
eqHex(wrote(CMobEffect(targetRuntimeId: newVarULong(300'u64), eventId: MobEffectRemove, effectId: newVarInt(10'i32),
  effectAmplifier: newVarInt(0'i32), showParticles: false, effectDurationTicks: newVarInt(0'i32), tick: newVarULong(5'u64))),
  "ac02" & "03" & "14" & "00" & "00" & "00" & "05", "mob effect remove")
# MobEquipment: empty item = id i16 0, count u16 0, aux 0, no net id, block 0, no extra data: eight zero bytes
eqHex(wrote(CMobEquipment(targetRuntimeId: newVarULong(5'u64), item: defaultNetworkItemStackDescriptor(), slot: 2'u8,
  selectedSlot: 2'u8, containerId: 0'u8)), "05" & "0000000000000000" & "020200", "mob equipment empty")
var stick = defaultNetworkItemStackDescriptor()
stick.id = 300'i16
stick.stackSize = 3'u16
stick.extraData = @[0'u8, 0'u8]
eqHex(wrote(CMobEquipment(targetRuntimeId: newVarULong(5'u64), item: stick, slot: 0'u8, selectedSlot: 0'u8, containerId: 119'u8)),
  "05" & "2c01" & "0300" & "00" & "00" & "00" & "020000" & "00" & "00" & "77", "mob equipment item")
# MobArmorEquipment: runtime id then five empty descriptors (upstream's own test asserts 5 * 8 zero bytes)
var armor = CMobArmorEquipment(targetRuntimeId: newVarULong(7'u64), head: defaultNetworkItemStackDescriptor(),
  chest: defaultNetworkItemStackDescriptor(), legs: defaultNetworkItemStackDescriptor(), feet: defaultNetworkItemStackDescriptor(),
  body: defaultNetworkItemStackDescriptor())
eqHex(wrote(armor), "07" & "0000000000000000" & "0000000000000000" & "0000000000000000" & "0000000000000000" & "0000000000000000", "armor empty")
# Respawn: (1.5, 64, -2.25), ready to spawn, runtime id 42
let resp = SRespawn(position: v3(1.5'f32, 64.0'f32, -2.25'f32), state: rsReadyToSpawn, playerRuntimeId: newVarULong(42'u64))
eqHex(wrote(resp), "0000c03f" & "00008042" & "000010c0" & "01" & "2a", "respawn")
var rr = newNetReader(hx("0000c03f00008042000010c0022a"))
let back = packetRead(SRespawn, rr)
check(back.isOk and back.value.state == rsClientReadyToSpawn and back.value.playerRuntimeId.value == 42'u64 and
  back.value.position.y == 64.0'f32, "respawn read")
var bad = newNetReader(hx("0000c03f00008042000010c0092a"))
check(not packetRead(SRespawn, bad).isOk, "respawn state 9 is refused")
echo "playextratest ok"
