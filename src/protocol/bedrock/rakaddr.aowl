## RakNet's `SystemAddress` as it goes on the wire. No upstream file: pumpkin-protocol writes a `SocketAddr` with
## `PacketWrite for SocketAddr` (the raw octets), but a RakNet peer expects an IPv4 address with every octet
## inverted (`~octet`; PocketMine's `putAddress` and RakNet's own `BitStream::Write(SystemAddress)` do this), a big-endian
## port, and for IPv6 the layout upstream already writes. Used by the connection packets in client/raknet and
## server/raknet instead of the plain `SocketAddr` codec.

import ../protobase, ../netcodec, ../serial

proc packetWriteRakAddr*(self: SocketAddr; w: var NetWriter) =
  if not self.isV6:
    packetWrite(4'u8, w)
    for b in self.ip:
      writeU8(w, not b)
    packetWriteBe(self.port, w)
  else:
    packetWrite(self, w)

proc packetReadRakAddr*(r: var NetReader): ProtoReadResult[SocketAddr] =
  let res = packetRead(SocketAddr, r)
  if not res.isOk:
    return res
  var a = res.value
  if not a.isV6:
    for i in 0 ..< a.ip.len:
      a.ip[i] = not a.ip[i]
  readOk(a)
