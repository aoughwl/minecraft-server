## Port of pumpkin-protocol/src/bedrock/server/actor_event.rs
## Despite its `S` name upstream derives `PacketWrite` for this packet, so it has a `packetWrite`.

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const SActorEventPacketId* = 27'i32

type
  ActorEventType* = enum
    ## `#[repr(u8)]`, written as a single byte of the variant's value. The values are not contiguous: the
    ## enum keeps upstream's explicit ones.
    aetJump = 1
    aetHurt = 2
    aetDeath = 3
    aetStartAttacking = 4
    aetStopAttacking = 5
    aetTamingFailed = 6
    aetTamingSucceeded = 7
    aetShakeWetness = 8
    aetUseItem = 9
    aetEatGrass = 10
    aetFishhookBubble = 11
    aetFishhookFishPosition = 12
    aetFishhookHookTime = 13
    aetFishhookTease = 14
    aetSquidFleeing = 15
    aetZombieConverting = 16
    aetPlayAmbient = 17
    aetSpawnAlive = 18
    aetStartOfferFlower = 19
    aetStopOfferFlower = 20
    aetLoveHearts = 21
    aetVillagerAngry = 22
    aetVillagerHappy = 23
    aetWitchHatMagic = 24
    aetFireworksExplode = 25
    aetInLoveHearts = 26
    aetSilverfishMergeAnimation = 27
    aetGuardianAttackSound = 28
    aetDrinkPotion = 29
    aetThrowPotion = 30
    aetCartWithPrimeTNT = 31
    aetPrimeCreeper = 32
    aetAirSupply = 33
    aetAddPlayerLevels = 34
    aetGuardianMiningFatigue = 35
    aetAgentSwingArm = 36
    aetDragonStartDeathAnim = 37
    aetGroundDust = 38
    aetShake = 39
    aetFeed = 57
    aetBabyEat = 60
    aetInstantDeath = 61
    aetNotifyTrade = 62
    aetLeashDestroyed = 63
    aetCaravanUpdated = 64
    aetTalismanActivate = 65
    aetUpdateStructureFeature = 66
    aetPlayerSpawnedMob = 67
    aetPuke = 68
    aetUpdateStackSize = 69
    aetStartSwimming = 70
    aetBalloonPop = 71
    aetTreasureHunt = 72
    aetSummonAgent = 73
    aetFinishedChargingItem = 74
    aetLandedOnGround = 75
    aetActorGrowUp = 76
    aetVibrationDetected = 77
    aetDrinkMilk = 78
    aetWetnessStop = 79
    aetKineticDamageDealt = 80
    aetHurtWithoutReceivingDamage = 81

  SActorEvent* = object
    entityRuntimeId*: VarLong
    eventType*: ActorEventType
    eventData*: VarInt
    fireAtPosition*: Option[Vector3[float32]]

proc packetWrite*(self: ActorEventType; w: var NetWriter) =
  packetWrite(uint8(ord(self)), w)

proc packetWrite*(self: SActorEvent; w: var NetWriter) =
  packetWrite(self.entityRuntimeId, w)
  packetWrite(self.eventType, w)
  packetWrite(self.eventData, w)
  packetWrite(self.fireAtPosition.isSome, w)
  if self.fireAtPosition.isSome:
    packetWrite(self.fireAtPosition.unsafeGet, w)
