## Port of pumpkin-protocol/src/bedrock/server/animate.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint

const SAnimatePacketId* = 44'i32

type
  AnimateAction* = enum
    aaSwingArm = 1
    aaWakeUp = 2
    aaStopSleep = 3
    aaCriticalHit = 4
    aaMagicCriticalHit = 5

  AnimateSwingSource* = enum
    assNone = 1
    assBuild = 2
    assMine = 3
    assInteract = 4
    assAttack = 5
    assUseItem = 6
    assThrowItem = 7
    assDropItem = 8
    assEvent = 9

  SwingSourceResult* = object
    ## `Result<AnimateSwingSource, Error>` of `FromStr`.
    isOk*: bool
    value*: AnimateSwingSource
    error*: string

  SAnimate* = object
    action*: AnimateAction
    runtimeEntityId*: VarULong
    data*: float32
    swingSource*: Option[AnimateSwingSource]

proc packetRead*(_: typedesc[AnimateAction]; r: var NetReader): ProtoReadResult[AnimateAction] =
  let action = tryRead(AnimateAction, packetRead(uint8, r))
  if action >= 1'u8 and action <= 5'u8:
    readOk(AnimateAction(int(action)))
  else:
    readErr[AnimateAction](messageRead("Invalid animate action ID: " & $action))

proc packetWrite*(self: AnimateAction; w: var NetWriter) =
  packetWrite(uint8(ord(self)), w)

proc swingSourceFromStr*(s: string): SwingSourceResult =
  ## `AnimateSwingSource::from_str`.
  case s
  of "none": SwingSourceResult(isOk: true, value: assNone)
  of "build": SwingSourceResult(isOk: true, value: assBuild)
  of "mine": SwingSourceResult(isOk: true, value: assMine)
  of "interact": SwingSourceResult(isOk: true, value: assInteract)
  of "attack": SwingSourceResult(isOk: true, value: assAttack)
  of "useitem": SwingSourceResult(isOk: true, value: assUseItem)
  of "throwitem": SwingSourceResult(isOk: true, value: assThrowItem)
  of "dropitem": SwingSourceResult(isOk: true, value: assDropItem)
  of "event": SwingSourceResult(isOk: true, value: assEvent)
  else: SwingSourceResult(isOk: false, value: assNone, error: "Unknown swing source: " & s)

proc asStr*(self: AnimateSwingSource): string =
  case self
  of assNone: "none"
  of assBuild: "build"
  of assMine: "mine"
  of assInteract: "interact"
  of assAttack: "attack"
  of assUseItem: "useitem"
  of assThrowItem: "throwitem"
  of assDropItem: "dropitem"
  of assEvent: "event"

proc packetRead*(_: typedesc[SAnimate]; r: var NetReader): ProtoReadResult[SAnimate] =
  let action = tryRead(SAnimate, packetRead(AnimateAction, r))
  let runtimeEntityId = tryRead(SAnimate, packetRead(VarULong, r))
  let data = tryRead(SAnimate, packetRead(float32, r))
  var swingSource = none[AnimateSwingSource]()
  if tryRead(SAnimate, packetRead(bool, r)):
    let s = tryRead(SAnimate, packetRead(string, r))
    let parsed = swingSourceFromStr(s)
    if not parsed.isOk:
      return readErr[SAnimate](messageRead(parsed.error))
    swingSource = some(parsed.value)
  readOk(SAnimate(action: action, runtimeEntityId: runtimeEntityId, data: data, swingSource: swingSource))

proc packetWrite*(self: SAnimate; w: var NetWriter) =
  packetWrite(self.action, w)
  packetWrite(self.runtimeEntityId, w)
  packetWrite(self.data, w)
  packetWrite(self.swingSource.isSome, w)
  if self.swingSource.isSome:
    packetWrite(self.swingSource.unsafeGet.asStr(), w)
