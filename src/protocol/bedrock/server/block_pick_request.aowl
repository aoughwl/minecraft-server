## Port of pumpkin-protocol/src/bedrock/server/block_pick_request.rs

import ../../protobase, ../../netcodec, ../../serial
import ../../../util/math/position

const SBlockPickRequestPacketId* = 34'i32

type
  SBlockPickRequest* = object
    blockPos*: BlockPos
    addBlockNbt*: bool
    hotbarSlot*: uint8

proc packetRead*(_: typedesc[SBlockPickRequest]; r: var NetReader): ProtoReadResult[SBlockPickRequest] =
  let blockPos = tryRead(SBlockPickRequest, packetRead(BlockPos, r))
  let addBlockNbt = tryRead(SBlockPickRequest, packetRead(bool, r))
  let hotbarSlot = tryRead(SBlockPickRequest, packetRead(uint8, r))
  readOk(SBlockPickRequest(blockPos: blockPos, addBlockNbt: addBlockNbt, hotbarSlot: hotbarSlot))
