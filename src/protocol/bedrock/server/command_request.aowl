## Port of pumpkin-protocol/src/bedrock/server/command_request.rs
## Upstream has a borrowing read (`PacketReadSlice`, `Cow::Borrowed`) and an owning one; one buffer-backed read
## covers both here, and the strings are owned.

import ../../protobase, ../../netcodec, ../../serial, ../../uuid

const SCommandRequestPacketId* = 77'i32

type
  SCommandRequest* = object
    command*: string
    commandType*: string
    commandUuid*: Uuid
    requestId*: string
    playerActorUniqueId*: int64
    isInternalSource*: bool
    version*: string

proc packetRead*(_: typedesc[SCommandRequest]; r: var NetReader): ProtoReadResult[SCommandRequest] =
  let command = tryRead(SCommandRequest, packetRead(string, r))
  let commandType = tryRead(SCommandRequest, packetRead(string, r))
  let commandUuid = tryRead(SCommandRequest, packetRead(Uuid, r))
  let requestId = tryRead(SCommandRequest, packetRead(string, r))
  let playerActorUniqueId = tryRead(SCommandRequest, packetRead(int64, r))
  let isInternalSource = tryRead(SCommandRequest, packetRead(bool, r))
  let version = tryRead(SCommandRequest, packetRead(string, r))
  readOk(SCommandRequest(command: command, commandType: commandType, commandUuid: commandUuid,
    requestId: requestId, playerActorUniqueId: playerActorUniqueId, isInternalSource: isInternalSource,
    version: version))
