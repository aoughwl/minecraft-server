## Port of pumpkin-protocol/src/bedrock/server/container_close.rs
## Derives both `PacketWrite` and `PacketRead`.

import ../../protobase, ../../netcodec, ../../serial

const SContainerClosePacketId* = 47'i32

type
  SContainerClose* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/ContainerClosePacket.html
    containerId*: uint8
    containerType*: uint8
    serverInitiated*: bool

proc packetWrite*(self: SContainerClose; w: var NetWriter) =
  packetWrite(self.containerId, w)
  packetWrite(self.containerType, w)
  packetWrite(self.serverInitiated, w)

proc packetRead*(_: typedesc[SContainerClose]; r: var NetReader): ProtoReadResult[SContainerClose] =
  let containerId = tryRead(SContainerClose, packetRead(uint8, r))
  let containerType = tryRead(SContainerClose, packetRead(uint8, r))
  let serverInitiated = tryRead(SContainerClose, packetRead(bool, r))
  readOk(SContainerClose(containerId: containerId, containerType: containerType, serverInitiated: serverInitiated))
