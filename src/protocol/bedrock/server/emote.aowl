## Port of pumpkin-protocol/src/bedrock/server/emote.rs
## Upstream's borrowed (`PacketReadSlice`) and owned reads are one buffer-backed read here.

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const
  SEmotePacketId* = 138'i32
  EMOTE_FLAG_SERVER_SIDE* = 1'u8 shl 0
  EMOTE_FLAG_MUTE_CHAT* = 1'u8 shl 1

type
  SEmote* = object
    runtimeEntityId*: VarULong
    emoteId*: string
    emoteLength*: uint32
    xuid*: string
    platformId*: string
    flags*: uint8

proc packetRead*(_: typedesc[SEmote]; r: var NetReader): ProtoReadResult[SEmote] =
  let runtimeEntityId = tryRead(SEmote, packetRead(VarULong, r))
  let emoteId = tryRead(SEmote, packetRead(string, r))
  let emoteLength = tryRead(SEmote, packetRead(uint32, r))
  let xuid = tryRead(SEmote, packetRead(string, r))
  let platformId = tryRead(SEmote, packetRead(string, r))
  let flags = tryRead(SEmote, packetRead(uint8, r))
  readOk(SEmote(runtimeEntityId: runtimeEntityId, emoteId: emoteId, emoteLength: emoteLength, xuid: xuid,
    platformId: platformId, flags: flags))

proc packetWrite*(self: SEmote; w: var NetWriter) =
  packetWrite(self.runtimeEntityId, w)
  packetWrite(self.emoteId, w)
  packetWrite(self.emoteLength, w)
  packetWrite(self.xuid, w)
  packetWrite(self.platformId, w)
  packetWrite(self.flags, w)
