## Port of pumpkin-protocol/src/bedrock/server/emote_list.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../uuid

const SEmoteListPacketId* = 152'i32

type
  SEmoteList* = object
    runtimeEntityId*: VarULong
    emotePieces*: seq[Uuid]

proc packetRead*(_: typedesc[SEmoteList]; r: var NetReader): ProtoReadResult[SEmoteList] =
  let runtimeEntityId = tryRead(SEmoteList, packetRead(VarULong, r))
  let len = int(tryRead(SEmoteList, packetRead(VarUInt, r)).value)
  var emotePieces: seq[Uuid] = @[]
  for _ in 0 ..< len:
    emotePieces.add(tryRead(SEmoteList, packetRead(Uuid, r)))
  readOk(SEmoteList(runtimeEntityId: runtimeEntityId, emotePieces: emotePieces))

proc packetWrite*(self: SEmoteList; w: var NetWriter) =
  packetWrite(self.runtimeEntityId, w)
  packetWrite(newVarUInt(uint32(self.emotePieces.len)), w)
  for piece in self.emotePieces:
    packetWrite(piece, w)
