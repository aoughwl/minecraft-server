## Port of pumpkin-protocol/src/bedrock/server/interaction.rs
## Upstream's `Action` here is re-exported by server/mod.rs as `InteractAction`, which is its name here.

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/vector3

const SInteractionPacketId* = 33'i32

type
  InteractAction* = enum
    ## `#[repr(i8)]`.
    iaInvalid = 0
    iaInteract = 1
    iaAttack = 2 ## No longer used in newer versions
    iaStopRiding = 3
    iaInteractUpdate = 4
    iaNpcOpen = 5
    iaOpenInventory = 6

  SInteraction* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/InteractPacket.html
    action*: InteractAction
    targetRuntimeId*: VarULong
    position*: Option[Vector3[float32]]

proc packetRead*(_: typedesc[InteractAction]; r: var NetReader): ProtoReadResult[InteractAction] =
  ## One byte; anything above 6 is an error with an empty message (`Error::other("")`).
  let b = tryRead(InteractAction, packetRead(uint8, r))
  if b <= 6'u8:
    readOk(InteractAction(int(b)))
  else:
    readErr[InteractAction](messageRead(""))

proc packetRead*(_: typedesc[SInteraction]; r: var NetReader): ProtoReadResult[SInteraction] =
  let action = tryRead(SInteraction, packetRead(InteractAction, r))
  let targetRuntimeId = tryRead(SInteraction, packetRead(VarULong, r))
  var position = none[Vector3[float32]]()
  if tryRead(SInteraction, packetRead(bool, r)):
    position = some(tryRead(SInteraction, packetRead(Vector3[float32], r)))
  readOk(SInteraction(action: action, targetRuntimeId: targetRuntimeId, position: position))
