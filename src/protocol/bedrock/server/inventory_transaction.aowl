## Port of pumpkin-protocol/src/bedrock/server/inventory_transaction.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position
import ../../../util/vector3
import ../network_item

const
  SInventoryTransactionPacketId* = 30'i32
  WINDOW_ID_INVENTORY* = 0'i32
  WINDOW_ID_OFF_HAND* = 119'i32
  WINDOW_ID_ARMOUR* = 120'i32
  WINDOW_ID_UI* = 124'i32

type
  InventoryActionSourceKind* = enum
    iasContainer
    iasWorld
    iasCreative
    iasTodo
    iasUnknown

  InventoryActionSource* = object
    kind*: InventoryActionSourceKind
    value*: uint32 ## the raw value of `Unknown(u32)`

  LegacySetItemSlot* = object
    containerId*: uint8
    slots*: seq[uint8]

  InventoryAction* = object
    sourceType*: uint32
    windowId*: Option[int32]
    sourceFlags*: Option[uint32]
    inventorySlot*: uint32
    oldItem*: NetworkItemDescriptor
    newItem*: NetworkItemDescriptor

  NormalTransactionData* = object
    ## No fields.

  MismatchTransactionData* = object
    ## No fields.

  UseItemTransactionData* = object
    actionType*: VarUInt
    triggerType*: uint8
    blockPosition*: BlockPos
    blockFace*: int32
    hotBarSlot*: VarInt
    itemInHand*: NetworkItemDescriptor
    playerPosition*: Vector3[float32]
    clickPosition*: Vector3[float32]
    blockRuntimeId*: VarUInt
    clientPrediction*: uint8
    clientCooldownState*: uint8
    hand*: uint8 ## 0 main hand, 1 off hand: read only by the later-protocol layouts (inventory_transaction_v2.aowl), else 0.

  UseItemOnEntityTransactionData* = object
    targetEntityRuntimeId*: VarULong
    actionType*: VarUInt
    hotBarSlot*: VarInt
    itemInHand*: NetworkItemDescriptor
    playerPosition*: Vector3[float32]
    clickPosition*: Vector3[float32]

  ReleaseItemTransactionData* = object
    actionType*: VarUInt
    hotBarSlot*: VarInt
    itemInHand*: NetworkItemDescriptor
    headPosition*: Vector3[float32]

  TransactionDataKind* = enum
    tdNormal
    tdMismatch
    tdUseItem
    tdUseItemOnEntity
    tdReleaseItem

  TransactionData* = object
    case kind*: TransactionDataKind
    of tdNormal: normal*: NormalTransactionData
    of tdMismatch: mismatch*: MismatchTransactionData
    of tdUseItem: useItem*: UseItemTransactionData
    of tdUseItemOnEntity: useItemOnEntity*: UseItemOnEntityTransactionData
    of tdReleaseItem: releaseItem*: ReleaseItemTransactionData

  SInventoryTransaction* = object
    legacyRequestId*: VarInt
    legacySetItemSlots*: seq[LegacySetItemSlot]
    hasValue*: bool
    actions*: seq[InventoryAction]
    transactionType*: VarUInt
    transactionData*: TransactionData

proc inventoryActionSourceFrom*(value: uint32): InventoryActionSource =
  ## `From<u32> for InventoryActionSource`.
  case value
  of 0'u32: InventoryActionSource(kind: iasContainer)
  of 2'u32: InventoryActionSource(kind: iasWorld)
  of 3'u32: InventoryActionSource(kind: iasCreative)
  of 99999'u32: InventoryActionSource(kind: iasTodo)
  else: InventoryActionSource(kind: iasUnknown, value: value)

proc packetRead*(_: typedesc[LegacySetItemSlot]; r: var NetReader): ProtoReadResult[LegacySetItemSlot] =
  ## Derived: `slots` is a `Vec<u8>`, read with a VarUInt length.
  let containerId = tryRead(LegacySetItemSlot, packetRead(uint8, r))
  let slots = tryRead(LegacySetItemSlot, packetRead(seq[byte], r))
  readOk(LegacySetItemSlot(containerId: containerId, slots: slots))

proc packetRead*(_: typedesc[InventoryAction]; r: var NetReader): ProtoReadResult[InventoryAction] =
  let sourceType = uint32(tryRead(InventoryAction, packetRead(VarULong, r)).value and 0xFFFFFFFF'u64)
  var windowId = none[int32]()
  var sourceFlags = none[uint32]()
  let source = inventoryActionSourceFrom(sourceType)
  case source.kind
  of iasContainer, iasTodo:
    windowId = some(tryRead(InventoryAction, packetRead(VarInt, r)).value)
  of iasWorld:
    sourceFlags = some(uint32(tryRead(InventoryAction, packetRead(VarULong, r)).value and 0xFFFFFFFF'u64))
  else:
    discard
  let inventorySlot = uint32(tryRead(InventoryAction, packetRead(VarULong, r)).value and 0xFFFFFFFF'u64)
  let oldItem = tryRead(InventoryAction, packetRead(NetworkItemDescriptor, r))
  let newItem = tryRead(InventoryAction, packetRead(NetworkItemDescriptor, r))
  readOk(InventoryAction(sourceType: sourceType, windowId: windowId, sourceFlags: sourceFlags,
    inventorySlot: inventorySlot, oldItem: oldItem, newItem: newItem))

proc packetRead*(_: typedesc[NormalTransactionData]; r: var NetReader): ProtoReadResult[NormalTransactionData] =
  readOk(NormalTransactionData())

proc packetRead*(_: typedesc[MismatchTransactionData]; r: var NetReader): ProtoReadResult[MismatchTransactionData] =
  readOk(MismatchTransactionData())

proc packetRead*(_: typedesc[UseItemTransactionData]; r: var NetReader): ProtoReadResult[UseItemTransactionData] =
  let actionType = tryRead(UseItemTransactionData, packetRead(VarUInt, r))
  let triggerType = tryRead(UseItemTransactionData, packetRead(uint8, r))
  let blockPosition = tryRead(UseItemTransactionData, packetRead(BlockPos, r))
  let blockFace = int32(tryRead(UseItemTransactionData, packetRead(uint8, r)))
  let hotBarSlot = tryRead(UseItemTransactionData, packetRead(VarInt, r))
  let itemInHand = tryRead(UseItemTransactionData, packetRead(NetworkItemDescriptor, r))
  let playerPosition = tryRead(UseItemTransactionData, packetRead(Vector3[float32], r))
  let clickPosition = tryRead(UseItemTransactionData, packetRead(Vector3[float32], r))
  let blockRuntimeId = tryRead(UseItemTransactionData, packetRead(VarUInt, r))
  let clientPrediction = tryRead(UseItemTransactionData, packetRead(uint8, r))
  let clientCooldownState = tryRead(UseItemTransactionData, packetRead(uint8, r))
  readOk(UseItemTransactionData(actionType: actionType, triggerType: triggerType, blockPosition: blockPosition,
    blockFace: blockFace, hotBarSlot: hotBarSlot, itemInHand: itemInHand, playerPosition: playerPosition,
    clickPosition: clickPosition, blockRuntimeId: blockRuntimeId, clientPrediction: clientPrediction,
    clientCooldownState: clientCooldownState))

proc packetRead*(_: typedesc[UseItemOnEntityTransactionData]; r: var NetReader):
    ProtoReadResult[UseItemOnEntityTransactionData] =
  let targetEntityRuntimeId = tryRead(UseItemOnEntityTransactionData, packetRead(VarULong, r))
  let actionType = tryRead(UseItemOnEntityTransactionData, packetRead(VarUInt, r))
  let hotBarSlot = tryRead(UseItemOnEntityTransactionData, packetRead(VarInt, r))
  let itemInHand = tryRead(UseItemOnEntityTransactionData, packetRead(NetworkItemDescriptor, r))
  let playerPosition = tryRead(UseItemOnEntityTransactionData, packetRead(Vector3[float32], r))
  let clickPosition = tryRead(UseItemOnEntityTransactionData, packetRead(Vector3[float32], r))
  readOk(UseItemOnEntityTransactionData(targetEntityRuntimeId: targetEntityRuntimeId, actionType: actionType,
    hotBarSlot: hotBarSlot, itemInHand: itemInHand, playerPosition: playerPosition, clickPosition: clickPosition))

proc packetRead*(_: typedesc[ReleaseItemTransactionData]; r: var NetReader):
    ProtoReadResult[ReleaseItemTransactionData] =
  let actionType = tryRead(ReleaseItemTransactionData, packetRead(VarUInt, r))
  let hotBarSlot = tryRead(ReleaseItemTransactionData, packetRead(VarInt, r))
  let itemInHand = tryRead(ReleaseItemTransactionData, packetRead(NetworkItemDescriptor, r))
  let headPosition = tryRead(ReleaseItemTransactionData, packetRead(Vector3[float32], r))
  readOk(ReleaseItemTransactionData(actionType: actionType, hotBarSlot: hotBarSlot, itemInHand: itemInHand,
    headPosition: headPosition))

proc packetRead*(_: typedesc[SInventoryTransaction]; r: var NetReader): ProtoReadResult[SInventoryTransaction] =
  let legacyRequestId = tryRead(SInventoryTransaction, packetRead(VarInt, r))
  let hasLegacySlots = tryRead(SInventoryTransaction, packetRead(bool, r))
  var legacySetItemSlots: seq[LegacySetItemSlot] = @[]
  if hasLegacySlots:
    let len = tryRead(SInventoryTransaction, packetRead(VarUInt, r)).value
    var i = 0'u32
    while i < len:
      legacySetItemSlots.add(tryRead(SInventoryTransaction, packetRead(LegacySetItemSlot, r)))
      i += 1'u32
  discard tryRead(SInventoryTransaction, packetRead(bool, r)) # has_transaction_type
  let transactionType = tryRead(SInventoryTransaction, packetRead(VarUInt, r))
  discard tryRead(SInventoryTransaction, packetRead(bool, r)) # has_tr_data
  let hasValue = tryRead(SInventoryTransaction, packetRead(bool, r))
  var actions: seq[InventoryAction] = @[]
  if hasValue:
    let actionsLen = tryRead(SInventoryTransaction, packetRead(VarUInt, r)).value
    var i = 0'u32
    while i < actionsLen:
      actions.add(tryRead(SInventoryTransaction, packetRead(InventoryAction, r)))
      i += 1'u32
  var data: TransactionData
  case transactionType.value
  of 0'u32:
    data = TransactionData(kind: tdNormal, normal: tryRead(SInventoryTransaction, packetRead(NormalTransactionData, r)))
  of 1'u32:
    data = TransactionData(kind: tdMismatch, mismatch: tryRead(SInventoryTransaction, packetRead(MismatchTransactionData, r)))
  of 2'u32:
    data = TransactionData(kind: tdUseItem, useItem: tryRead(SInventoryTransaction, packetRead(UseItemTransactionData, r)))
  of 3'u32:
    data = TransactionData(kind: tdUseItemOnEntity,
      useItemOnEntity: tryRead(SInventoryTransaction, packetRead(UseItemOnEntityTransactionData, r)))
  of 4'u32:
    data = TransactionData(kind: tdReleaseItem,
      releaseItem: tryRead(SInventoryTransaction, packetRead(ReleaseItemTransactionData, r)))
  else:
    return readErr[SInventoryTransaction](messageRead("Unknown inventory transaction type: " & $transactionType.value))
  readOk(SInventoryTransaction(legacyRequestId: legacyRequestId, legacySetItemSlots: legacySetItemSlots,
    hasValue: hasValue, actions: actions, transactionType: transactionType, transactionData: data))
