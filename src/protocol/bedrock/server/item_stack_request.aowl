## Port of pumpkin-protocol/src/bedrock/server/item_stack_request.rs
##
## `ItemStackRequestAction` is an enum with a different payload per variant, many reusing the names `count`,
## `source` and `destination`. aowlmony's variant objects cannot repeat a field name across branches, so it is
## one object holding the union of every variant's fields; `kind` says which of them are meaningful.
## Fields: Take/Place/PlaceInContainer/TakeOutContainer use count, source, destination; Swap slot1, slot2;
## Drop count, source, randomly; Destroy/Consume count, source; Create resultIndex; BeaconPayment
## primaryEffectId, secondaryEffectId; MineBlock hotbarSlot, predictedDurability, stackId; CraftRecipe recipeId,
## repetitions; CraftRecipeAuto recipeId, repetitions, repetitions2; CraftCreative creativeItemId, repetitions;
## Optional recipeId, filterStringIndex; Grindstone recipeId, repairCost, repetitions; Loom patternId,
## repetitions; CraftResultsDeprecated resultItems, timesCrafted.

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const SItemStackRequestPacketId* = 147'i32

type
  ItemStackRequestSlotInfo* = object
    containerName*: FullContainerName
    slotId*: uint8
    stackId*: VarInt

  ItemStackRequestActionKind* = enum
    ## In wire order: the action type byte is the ordinal.
    isaTake
    isaPlace
    isaSwap
    isaDrop
    isaDestroy
    isaConsume
    isaCreate
    isaPlaceInContainer
    isaTakeOutContainer
    isaLabTableCombine
    isaBeaconPayment
    isaMineBlock
    isaCraftRecipe
    isaCraftRecipeAuto
    isaCraftCreative
    isaOptional
    isaGrindstone
    isaLoom
    isaCraftNonImplemented
    isaCraftResultsDeprecated

  ItemStackRequestAction* = object
    kind*: ItemStackRequestActionKind
    count*: uint8
    source*: ItemStackRequestSlotInfo
    destination*: ItemStackRequestSlotInfo
    slot1*: ItemStackRequestSlotInfo
    slot2*: ItemStackRequestSlotInfo
    randomly*: bool
    resultIndex*: uint8
    primaryEffectId*: VarInt
    secondaryEffectId*: VarInt
    hotbarSlot*: VarInt
    predictedDurability*: VarInt
    stackId*: VarInt
    recipeId*: VarUInt
    repetitions*: uint8
    repetitions2*: uint8
    creativeItemId*: VarUInt
    filterStringIndex*: int32
    repairCost*: VarInt
    patternId*: string
    resultItems*: seq[NetworkItemStack]
    timesCrafted*: uint8

  ItemStackRequest* = object
    requestId*: VarInt
    actions*: seq[ItemStackRequestAction]
    filterStrings*: seq[string]
    filterCause*: int32

  SItemStackRequest* = object
    requests*: seq[ItemStackRequest]

proc packetRead*(_: typedesc[ItemStackRequestSlotInfo]; r: var NetReader): ProtoReadResult[ItemStackRequestSlotInfo] =
  let containerName = tryRead(ItemStackRequestSlotInfo, packetRead(FullContainerName, r))
  let slotId = tryRead(ItemStackRequestSlotInfo, packetRead(uint8, r))
  let stackId = tryRead(ItemStackRequestSlotInfo, packetRead(VarInt, r))
  readOk(ItemStackRequestSlotInfo(containerName: containerName, slotId: slotId, stackId: stackId))

proc packetWrite*(self: ItemStackRequestSlotInfo; w: var NetWriter) =
  packetWrite(self.containerName, w)
  packetWrite(self.slotId, w)
  packetWrite(self.stackId, w)

proc packetRead*(_: typedesc[ItemStackRequestAction]; r: var NetReader): ProtoReadResult[ItemStackRequestAction] =
  let actionType = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  var a = ItemStackRequestAction()
  case actionType
  of 0'u8, 1'u8, 7'u8, 8'u8:
    a.kind = ItemStackRequestActionKind(int(actionType))
    a.count = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    a.source = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
    a.destination = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
  of 2'u8:
    a.kind = isaSwap
    a.slot1 = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
    a.slot2 = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
  of 3'u8:
    a.kind = isaDrop
    a.count = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    a.source = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
    a.randomly = tryRead(ItemStackRequestAction, packetRead(bool, r))
  of 4'u8, 5'u8:
    a.kind = ItemStackRequestActionKind(int(actionType))
    a.count = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    a.source = tryRead(ItemStackRequestAction, packetRead(ItemStackRequestSlotInfo, r))
  of 6'u8:
    a.kind = isaCreate
    a.resultIndex = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  of 9'u8:
    a.kind = isaLabTableCombine
  of 10'u8:
    a.kind = isaBeaconPayment
    a.primaryEffectId = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
    a.secondaryEffectId = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
  of 11'u8:
    a.kind = isaMineBlock
    a.hotbarSlot = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
    a.predictedDurability = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
    a.stackId = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
  of 12'u8:
    a.kind = isaCraftRecipe
    a.recipeId = tryRead(ItemStackRequestAction, packetRead(VarUInt, r))
    a.repetitions = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  of 13'u8:
    a.kind = isaCraftRecipeAuto
    a.recipeId = tryRead(ItemStackRequestAction, packetRead(VarUInt, r))
    a.repetitions = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    a.repetitions2 = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    let count = tryRead(ItemStackRequestAction, packetRead(uint8, r))
    # Read and discard ingredients if present (we don't need them server-side)
    for _ in 0 ..< int(count):
      discard tryRead(ItemStackRequestAction, packetRead(NetworkItemStack, r))
  of 14'u8:
    a.kind = isaCraftCreative
    a.creativeItemId = tryRead(ItemStackRequestAction, packetRead(VarUInt, r))
    a.repetitions = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  of 15'u8:
    a.kind = isaOptional
    a.recipeId = tryRead(ItemStackRequestAction, packetRead(VarUInt, r))
    a.filterStringIndex = tryRead(ItemStackRequestAction, packetRead(int32, r))
  of 16'u8:
    a.kind = isaGrindstone
    a.recipeId = tryRead(ItemStackRequestAction, packetRead(VarUInt, r))
    a.repairCost = tryRead(ItemStackRequestAction, packetRead(VarInt, r))
    a.repetitions = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  of 17'u8:
    a.kind = isaLoom
    a.patternId = tryRead(ItemStackRequestAction, packetRead(string, r))
    a.repetitions = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  of 18'u8:
    a.kind = isaCraftNonImplemented
  of 19'u8:
    a.kind = isaCraftResultsDeprecated
    let n = tryRead(ItemStackRequestAction, packetRead(VarUInt, r)).value
    var i = 0'u32
    while i < n:
      a.resultItems.add(tryRead(ItemStackRequestAction, packetRead(NetworkItemStack, r)))
      i += 1'u32
    a.timesCrafted = tryRead(ItemStackRequestAction, packetRead(uint8, r))
  else:
    return readErr[ItemStackRequestAction](messageRead("Unknown ItemStackRequestAction ID: " & $actionType))
  readOk(a)

proc packetRead*(_: typedesc[ItemStackRequest]; r: var NetReader): ProtoReadResult[ItemStackRequest] =
  let requestId = tryRead(ItemStackRequest, packetRead(VarInt, r))
  let actionsLen = tryRead(ItemStackRequest, packetRead(VarUInt, r)).value
  var actions: seq[ItemStackRequestAction] = @[]
  var i = 0'u32
  while i < actionsLen:
    actions.add(tryRead(ItemStackRequest, packetRead(ItemStackRequestAction, r)))
    i += 1'u32
  let filterStringsLen = tryRead(ItemStackRequest, packetRead(VarUInt, r)).value
  var filterStrings: seq[string] = @[]
  i = 0'u32
  while i < filterStringsLen:
    filterStrings.add(tryRead(ItemStackRequest, packetRead(string, r)))
    i += 1'u32
  let filterCause = tryRead(ItemStackRequest, packetRead(int32, r))
  readOk(ItemStackRequest(requestId: requestId, actions: actions, filterStrings: filterStrings,
    filterCause: filterCause))

proc packetRead*(_: typedesc[SItemStackRequest]; r: var NetReader): ProtoReadResult[SItemStackRequest] =
  let requestsLen = tryRead(SItemStackRequest, packetRead(VarUInt, r)).value
  var requests: seq[ItemStackRequest] = @[]
  var i = 0'u32
  while i < requestsLen:
    requests.add(tryRead(SItemStackRequest, packetRead(ItemStackRequest, r)))
    i += 1'u32
  readOk(SItemStackRequest(requests: requests))
