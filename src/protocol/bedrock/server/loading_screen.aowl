## Port of pumpkin-protocol/src/bedrock/server/loading_screen.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint

const SLoadingScreenPacketId* = 312'i32

type
  SLoadingScreen* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/ServerboundLoadingScreenPacket.html
    ## Loading screen packet type: 0 invalid, 1 start, 2 end. Both fields are private upstream.
    status*: VarInt
    id*: Option[uint32] ## upstream `_id`

proc isLoadingDone*(self: SLoadingScreen): bool =
  self.status.value == 2'i32

proc packetRead*(_: typedesc[SLoadingScreen]; r: var NetReader): ProtoReadResult[SLoadingScreen] =
  let status = tryRead(SLoadingScreen, packetRead(VarInt, r))
  var id = none[uint32]()
  if tryRead(SLoadingScreen, packetRead(bool, r)):
    id = some(tryRead(SLoadingScreen, packetRead(uint32, r)))
  readOk(SLoadingScreen(status: status, id: id))
