## Port of pumpkin-protocol/src/bedrock/server/login.rs
##
## `SLogin` reads the login packet's three length-prefixed parts. The serde-derived `ClientData`,
## `SkinAnimation`, `PersonaPiece` and `PersonaPieceTintColour` that the network layer fills from the client
## JWT payload are plain objects here, with one `...FromJson` per struct built on codecs/json_value.aowl:
## `#[serde(rename_all = "PascalCase")]` and the explicit renames give the JSON key, `#[serde(default)]` a zero
## default, and any other field is required (error `missing field` plus the key). Unknown keys are ignored, as
## serde does. An integer field takes a JSON integer in range, `frames` takes any number. The messages follow
## serde's wording, without serde_json's "at line L column C" suffix. `type` is `animationType`.
##
## The upstream `#[test]` `reads_raw_token_larger_than_two_mib` is ported in logintest.aowl.

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../codecs/json_value

const
  SLoginPacketId* = 1'i32
  MAX_PACKET_DATA_SIZE = 8_388_608

type
  SLogin* = object
    ## https://mojang.github.io/bedrock-protocol-docs/html/LoginPacket.html
    protocolVersion*: int32 ## big-endian
    ## https://mojang.github.io/bedrock-protocol-docs/html/connectionRequest.html
    jwt*: seq[byte]
    rawToken*: seq[byte]

  JsonDecodeError* = object
    msg*: string


  SkinAnimation* = object
    frames*: float64 ## JSON `Frames`
    image*: string ## JSON `Image`
    imageHeight*: int32 ## JSON `ImageHeight`
    imageWidth*: int32 ## JSON `ImageWidth`
    animationType*: int32 ## JSON `Type`
    animationExpression*: int32 ## JSON `AnimationExpression`

  PersonaPiece* = object
    isDefault*: bool ## JSON `IsDefault`
    packId*: string ## JSON `PackId`
    pieceId*: string ## JSON `PieceId`
    pieceType*: string ## JSON `PieceType`
    productId*: string ## JSON `ProductId`

  PersonaPieceTintColour* = object
    colours*: array[4, string] ## JSON `Colors`
    pieceType*: string ## JSON `PieceType`

  ClientData* = object
    clientRandomId*: int64 ## JSON `ClientRandomId`
    deviceOs*: int32 ## JSON `DeviceOS`
    deviceId*: string ## JSON `DeviceId`
    gameVersion*: string ## JSON `GameVersion`
    languageCode*: string ## JSON `LanguageCode`
    currentInputMode*: int32 ## JSON `CurrentInputMode`
    defaultInputMode*: int32 ## JSON `DefaultInputMode`
    uiProfile*: int32 ## JSON `UIProfile`
    serverAddress*: string ## JSON `ServerAddress`
    deviceModel*: string ## JSON `DeviceModel` (default)
    guiScale*: int32 ## JSON `GuiScale` (default)
    clientIsEditorCapable*: bool ## JSON `ClientIsEditorCapable` (default)
    clientEditorConnectionIntent*: int32 ## JSON `ClientEditorConnectionIntent` (default)
    maxViewDistance*: int32 ## JSON `MaxViewDistance`
    memoryTier*: int32 ## JSON `MemoryTier` (default)
    platformType*: int32 ## JSON `PlatformType` (default)
    graphicsMode*: int32 ## JSON `GraphicsMode` (default)
    compatibleWithClientSideChunkGen*: bool ## JSON `CompatibleWithClientSideChunkGen` (default)
    platformOfflineId*: string ## JSON `PlatformOfflineId` (default)
    platformOnlineId*: string ## JSON `PlatformOnlineId` (default)
    platformUserId*: string ## JSON `PlatformUserId` (default)
    selfSignedId*: string ## JSON `SelfSignedId` (default)
    playFabId*: string ## JSON `PlayFabId` (default)
    thirdPartyName*: string ## JSON `ThirdPartyName` (default)
    thirdPartyNameOnly*: bool ## JSON `ThirdPartyNameOnly` (default)
    skinId*: string ## JSON `SkinId` (default)
    skinData*: string ## JSON `SkinData` (default)
    skinImageHeight*: int32 ## JSON `SkinImageHeight` (default)
    skinImageWidth*: int32 ## JSON `SkinImageWidth` (default)
    skinColour*: string ## JSON `SkinColor` (default)
    armSize*: string ## JSON `ArmSize` (default)
    personaSkin*: bool ## JSON `PersonaSkin` (default)
    premiumSkin*: bool ## JSON `PremiumSkin` (default)
    trustedSkin*: bool ## JSON `TrustedSkin` (default)
    overrideSkin*: bool ## JSON `OverrideSkin` (default)
    capeData*: string ## JSON `CapeData` (default)
    capeId*: string ## JSON `CapeId` (default)
    capeImageHeight*: int32 ## JSON `CapeImageHeight` (default)
    capeImageWidth*: int32 ## JSON `CapeImageWidth` (default)
    capeOnClassicSkin*: bool ## JSON `CapeOnClassicSkin` (default)
    skinGeometry*: string ## JSON `SkinGeometryData` (default)
    skinGeometryVersion*: string ## JSON `SkinGeometryDataEngineVersion` (default)
    skinResourcePatch*: string ## JSON `SkinResourcePatch` (default)
    animatedImageData*: seq[SkinAnimation] ## JSON `AnimatedImageData` (default)
    skinAnimationData*: string ## JSON `SkinAnimationData` (default)
    personaPieces*: seq[PersonaPiece] ## JSON `PersonaPieces` (default)
    pieceTintColours*: seq[PersonaPieceTintColour] ## JSON `PieceTintColors` (default)

proc packetRead*(_: typedesc[SLogin]; r: var NetReader): ProtoReadResult[SLogin] =
  let protocolVersion = tryRead(SLogin, packetReadBe(int32, r))
  let connectionRequestLen = int(tryRead(SLogin, packetRead(VarUInt, r)).value)
  if connectionRequestLen > MAX_PACKET_DATA_SIZE:
    return readErr[SLogin](messageRead("Connection request length " & $connectionRequestLen &
      " exceeds limit " & $MAX_PACKET_DATA_SIZE))
  let jwtLen = int(tryRead(SLogin, packetRead(uint32, r)))
  if jwtLen > MAX_PACKET_DATA_SIZE:
    return readErr[SLogin](messageRead("JWT length " & $jwtLen & " exceeds limit " & $MAX_PACKET_DATA_SIZE))
  let jwt = tryRead(SLogin, readSlice(r, jwtLen))
  let rawTokenLen = int(tryRead(SLogin, packetRead(uint32, r)))
  if rawTokenLen > MAX_PACKET_DATA_SIZE:
    return readErr[SLogin](messageRead("Raw token length " & $rawTokenLen & " exceeds limit " &
      $MAX_PACKET_DATA_SIZE))
  let rawToken = tryRead(SLogin, readSlice(r, rawTokenLen))
  readOk(SLogin(protocolVersion: protocolVersion, jwt: jwt, rawToken: rawToken))

# --- serde-style decoding of the client data JSON ------------------------------------------------------

type
  JsonDecode*[T] = object
    case isOk*: bool
    of true: value*: T
    of false: error*: JsonDecodeError

proc decErr[T](msg: string): JsonDecode[T] =
  JsonDecode[T](isOk: false, error: JsonDecodeError(msg: msg))

proc decOk[T](v: sink T): JsonDecode[T] =
  JsonDecode[T](isOk: true, value: v)

proc kindName(v: JsonValue): string =
  case v.kind
  of jvNull: "null"
  of jvBool: "boolean `" & (if v.boolVal: "true" else: "false") & "`"
  of jvInt, jvUInt, jvFloat: "number"
  of jvString: "string \"" & v.strVal & "\""
  of jvArray: "sequence"
  of jvObject: "map"

proc missing(key: string): string = "missing field `" & key & "`"

proc fieldI32(obj: JsonValue; key: string; required: bool; into: var int32): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    into = 0'i32
    return ""
  if got[1].kind != jvInt:
    return "invalid type: " & kindName(got[1]) & ", expected i32"
  if got[1].intVal < -2147483648'i64 or got[1].intVal > 2147483647'i64:
    return "invalid value: integer `" & $got[1].intVal & "`, expected i32"
  into = int32(got[1].intVal)
  ""

proc fieldI64(obj: JsonValue; key: string; required: bool; into: var int64): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    into = 0'i64
    return ""
  if got[1].kind != jvInt:
    return "invalid type: " & kindName(got[1]) & ", expected i64"
  into = got[1].intVal
  ""

proc fieldF64(obj: JsonValue; key: string; required: bool; into: var float64): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    into = 0.0
    return ""
  case got[1].kind
  of jvInt: into = float64(got[1].intVal)
  of jvUInt: into = float64(got[1].uintVal)
  of jvFloat: into = got[1].floatVal
  else: return "invalid type: " & kindName(got[1]) & ", expected f64"
  ""

proc fieldStr(obj: JsonValue; key: string; required: bool; into: var string): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    into = ""
    return ""
  if got[1].kind != jvString:
    return "invalid type: " & kindName(got[1]) & ", expected a string"
  into = got[1].strVal
  ""

proc fieldBool(obj: JsonValue; key: string; required: bool; into: var bool): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    into = false
    return ""
  if got[1].kind != jvBool:
    return "invalid type: " & kindName(got[1]) & ", expected a boolean"
  into = got[1].boolVal
  ""

proc fieldArray(obj: JsonValue; key: string; required: bool; items: var seq[JsonValue]): string =
  let got = obj.get(key)
  if not got[0]:
    if required:
      return missing(key)
    items = @[]
    return ""
  if got[1].kind != jvArray:
    return "invalid type: " & kindName(got[1]) & ", expected a sequence"
  items = got[1].items
  ""

proc requireObject(v: JsonValue; name: string): string =
  if v.kind != jvObject:
    return "invalid type: " & kindName(v) & ", expected struct " & name
  ""

proc skinAnimationFromJson*(v: JsonValue): JsonDecode[SkinAnimation] =
  var res = SkinAnimation()
  var err = requireObject(v, "SkinAnimation")
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldF64(v, "Frames", true, res.frames)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldStr(v, "Image", true, res.image)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldI32(v, "ImageHeight", true, res.imageHeight)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldI32(v, "ImageWidth", true, res.imageWidth)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldI32(v, "Type", true, res.animationType)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  err = fieldI32(v, "AnimationExpression", true, res.animationExpression)
  if err.len > 0:
    return decErr[SkinAnimation](err)
  decOk(res)

proc personaPieceFromJson*(v: JsonValue): JsonDecode[PersonaPiece] =
  var res = PersonaPiece()
  var err = requireObject(v, "PersonaPiece")
  if err.len > 0:
    return decErr[PersonaPiece](err)
  err = fieldBool(v, "IsDefault", true, res.isDefault)
  if err.len > 0:
    return decErr[PersonaPiece](err)
  err = fieldStr(v, "PackId", true, res.packId)
  if err.len > 0:
    return decErr[PersonaPiece](err)
  err = fieldStr(v, "PieceId", true, res.pieceId)
  if err.len > 0:
    return decErr[PersonaPiece](err)
  err = fieldStr(v, "PieceType", true, res.pieceType)
  if err.len > 0:
    return decErr[PersonaPiece](err)
  err = fieldStr(v, "ProductId", true, res.productId)
  if err.len > 0:
    return decErr[PersonaPiece](err)
  decOk(res)

proc personaPieceTintColourFromJson*(v: JsonValue): JsonDecode[PersonaPieceTintColour] =
  var res = PersonaPieceTintColour()
  var err = requireObject(v, "PersonaPieceTintColour")
  if err.len > 0:
    return decErr[PersonaPieceTintColour](err)
  var coloursItems: seq[JsonValue] = @[]
  err = fieldArray(v, "Colors", true, coloursItems)
  if err.len == 0:
    if coloursItems.len != 4:
      err = "invalid length " & $coloursItems.len & ", expected an array of length 4"
    else:
      for ci in 0 ..< 4:
        if coloursItems[ci].kind != jvString:
          err = "invalid type: " & kindName(coloursItems[ci]) & ", expected a string"
        else:
          res.colours[ci] = coloursItems[ci].strVal
  if err.len > 0:
    return decErr[PersonaPieceTintColour](err)
  err = fieldStr(v, "PieceType", true, res.pieceType)
  if err.len > 0:
    return decErr[PersonaPieceTintColour](err)
  decOk(res)

proc clientDataFromJson*(v: JsonValue): JsonDecode[ClientData] =
  var res = ClientData()
  var err = requireObject(v, "ClientData")
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI64(v, "ClientRandomId", true, res.clientRandomId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "DeviceOS", true, res.deviceOs)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "DeviceId", true, res.deviceId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "GameVersion", true, res.gameVersion)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "LanguageCode", true, res.languageCode)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "CurrentInputMode", true, res.currentInputMode)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "DefaultInputMode", true, res.defaultInputMode)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "UIProfile", true, res.uiProfile)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "ServerAddress", true, res.serverAddress)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "DeviceModel", false, res.deviceModel)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "GuiScale", false, res.guiScale)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "ClientIsEditorCapable", false, res.clientIsEditorCapable)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "ClientEditorConnectionIntent", false, res.clientEditorConnectionIntent)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "MaxViewDistance", true, res.maxViewDistance)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "MemoryTier", false, res.memoryTier)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "PlatformType", false, res.platformType)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "GraphicsMode", false, res.graphicsMode)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "CompatibleWithClientSideChunkGen", false, res.compatibleWithClientSideChunkGen)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "PlatformOfflineId", false, res.platformOfflineId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "PlatformOnlineId", false, res.platformOnlineId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "PlatformUserId", false, res.platformUserId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SelfSignedId", false, res.selfSignedId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "PlayFabId", false, res.playFabId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "ThirdPartyName", false, res.thirdPartyName)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "ThirdPartyNameOnly", false, res.thirdPartyNameOnly)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinId", false, res.skinId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinData", false, res.skinData)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "SkinImageHeight", false, res.skinImageHeight)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "SkinImageWidth", false, res.skinImageWidth)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinColor", false, res.skinColour)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "ArmSize", false, res.armSize)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "PersonaSkin", false, res.personaSkin)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "PremiumSkin", false, res.premiumSkin)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "TrustedSkin", false, res.trustedSkin)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "OverrideSkin", false, res.overrideSkin)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "CapeData", false, res.capeData)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "CapeId", false, res.capeId)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "CapeImageHeight", false, res.capeImageHeight)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldI32(v, "CapeImageWidth", false, res.capeImageWidth)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldBool(v, "CapeOnClassicSkin", false, res.capeOnClassicSkin)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinGeometryData", false, res.skinGeometry)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinGeometryDataEngineVersion", false, res.skinGeometryVersion)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinResourcePatch", false, res.skinResourcePatch)
  if err.len > 0:
    return decErr[ClientData](err)
  var animatedImageDataItems: seq[JsonValue] = @[]
  err = fieldArray(v, "AnimatedImageData", false, animatedImageDataItems)
  if err.len == 0:
    for it in animatedImageDataItems:
      let sub = skinAnimationFromJson(it)
      if not sub.isOk:
        err = sub.error.msg
        break
      res.animatedImageData.add(sub.value)
  if err.len > 0:
    return decErr[ClientData](err)
  err = fieldStr(v, "SkinAnimationData", false, res.skinAnimationData)
  if err.len > 0:
    return decErr[ClientData](err)
  var personaPiecesItems: seq[JsonValue] = @[]
  err = fieldArray(v, "PersonaPieces", false, personaPiecesItems)
  if err.len == 0:
    for it in personaPiecesItems:
      let sub = personaPieceFromJson(it)
      if not sub.isOk:
        err = sub.error.msg
        break
      res.personaPieces.add(sub.value)
  if err.len > 0:
    return decErr[ClientData](err)
  var pieceTintColoursItems: seq[JsonValue] = @[]
  err = fieldArray(v, "PieceTintColors", false, pieceTintColoursItems)
  if err.len == 0:
    for it in pieceTintColoursItems:
      let sub = personaPieceTintColourFromJson(it)
      if not sub.isOk:
        err = sub.error.msg
        break
      res.pieceTintColours.add(sub.value)
  if err.len > 0:
    return decErr[ClientData](err)
  decOk(res)

