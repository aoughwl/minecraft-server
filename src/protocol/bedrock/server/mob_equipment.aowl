## Port of pumpkin-protocol/src/bedrock/server/mob_equipment.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../network_item

const SMobEquipmentPacketId* = 31'i32

type
  SMobEquipment* = object
    entityRuntimeId*: VarULong
    stackId*: VarInt
    item*: Option[NetworkItemDescriptor]
    inventorySlot*: uint8
    hotbarSlot*: uint8
    windowId*: uint8

proc packetRead*(_: typedesc[SMobEquipment]; r: var NetReader): ProtoReadResult[SMobEquipment] =
  ## The item is present only when `stackId` is not 0.
  let entityRuntimeId = tryRead(SMobEquipment, packetRead(VarULong, r))
  let stackId = tryRead(SMobEquipment, packetRead(VarInt, r))
  var item = none[NetworkItemDescriptor]()
  if stackId.value != 0'i32:
    item = some(tryRead(SMobEquipment, packetRead(NetworkItemDescriptor, r)))
  let inventorySlot = tryRead(SMobEquipment, packetRead(uint8, r))
  let hotbarSlot = tryRead(SMobEquipment, packetRead(uint8, r))
  let windowId = tryRead(SMobEquipment, packetRead(uint8, r))
  readOk(SMobEquipment(entityRuntimeId: entityRuntimeId, stackId: stackId, item: item,
    inventorySlot: inventorySlot, hotbarSlot: hotbarSlot, windowId: windowId))
