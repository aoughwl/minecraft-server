## Port of pumpkin-protocol/src/bedrock/server/modal_form_response.rs
## Upstream's borrowed and owned reads are one buffer-backed read here.

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint

const SModalFormResponsePacketId* = 101'i32

type
  SModalFormResponse* = object
    formId*: VarInt
    formData*: Option[string]

proc packetRead*(_: typedesc[SModalFormResponse]; r: var NetReader): ProtoReadResult[SModalFormResponse] =
  let formId = tryRead(SModalFormResponse, packetRead(VarInt, r))
  var formData = none[string]()
  if tryRead(SModalFormResponse, packetRead(bool, r)):
    formData = some(tryRead(SModalFormResponse, packetRead(string, r)))
  readOk(SModalFormResponse(formId: formId, formData: formData))
