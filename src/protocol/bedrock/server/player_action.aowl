## Port of pumpkin-protocol/src/bedrock/server/player_action.rs
## Upstream's `Action` here is re-exported by server/mod.rs as `PlayerActionType`, which is its name here.

import ../../protobase, ../../netcodec, ../../serial, ../../varint
import ../../../util/math/position

const SPlayerActionPacketId* = 36'i32

type
  PlayerActionType* = enum
    ## `#[repr(i32)]`; the value is the ordinal.
    patStartBreak = 0
    patAbortBreak = 1
    patStopBreak = 2
    patGetUpdatedBlock = 3
    patDropItem = 4
    patStartSleeping = 5
    patStopSleeping = 6
    patRespawn = 7
    patJump = 8
    patStartSprint = 9
    patStopSprint = 10
    patStartSneak = 11
    patStopSneak = 12
    patCreativePlayerDestroyBlock = 13
    patDimensionChangeAck = 14
    patStartGlide = 15
    patStopGlide = 16
    patBuildDenied = 17
    patCrackBreak = 18
    patChangeSkin = 19
    patSetEnchantmentSeed = 20
    patSwimming = 21
    patStopSwimming = 22
    patStartSpinAttack = 23
    patStopSpinAttack = 24
    patInteractBlock = 25
    patPredictDestroyBlock = 26
    patContinueDestroyBlock = 27
    patStartItemUseOn = 28
    patStopItemUseOn = 29
    patHandledTeleport = 30
    patMissedSwing = 31
    patStartCrawling = 32
    patStopCrawling = 33
    patStartFlying = 34
    patStopFlying = 35
    patClientAckServerData = 36

  SPlayerAction* = object
    runtimeId*: VarInt
    action*: PlayerActionType
    blockPos*: BlockPos
    resultPos*: BlockPos
    face*: VarInt

proc packetRead*(_: typedesc[PlayerActionType]; r: var NetReader): ProtoReadResult[PlayerActionType] =
  ## A VarInt; `TryFrom<i32>` errors with "Invalid action ID: N".
  let action = tryRead(PlayerActionType, packetRead(VarInt, r))
  if action.value >= 0'i32 and action.value <= 36'i32:
    readOk(PlayerActionType(int(action.value)))
  else:
    readErr[PlayerActionType](messageRead("Invalid action ID: " & $action.value))

proc packetRead*(_: typedesc[SPlayerAction]; r: var NetReader): ProtoReadResult[SPlayerAction] =
  let runtimeId = tryRead(SPlayerAction, packetRead(VarInt, r))
  let action = tryRead(SPlayerAction, packetRead(PlayerActionType, r))
  let blockPos = tryRead(SPlayerAction, packetRead(BlockPos, r))
  let resultPos = tryRead(SPlayerAction, packetRead(BlockPos, r))
  let face = tryRead(SPlayerAction, packetRead(VarInt, r))
  readOk(SPlayerAction(runtimeId: runtimeId, action: action, blockPos: blockPos, resultPos: resultPos, face: face))
