## Port of pumpkin-protocol/src/bedrock/server/player_auth_input.rs

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint, ../../bitset
import ../../../util/math/position
import ../../../util/[vector2, vector3]
import inventory_transaction, item_stack_request

const
  SPlayerAuthInputPacketId* = 144'i32
  InputDataBits = 65

type
  InputMode* = enum
    ## `#[repr(u32)]`
    imMouse = 1
    imTouch = 2
    imGamePad = 3
    imMotionController = 4

  PlayMode* = enum
    pmNormal = 0
    pmTeaser = 1
    pmScreen = 2
    pmExitLevel = 7
    pmNumModes = 9

  InteractionModel* = enum
    imodTouch = 0
    imodCrosshair = 1
    imodClassic = 2

  InputData* = enum
    ## Bit positions of `input_data`.
    idAscend = 0
    idDescend = 1
    idNorthJump = 2
    idJumpDown = 3
    idSprintDown = 4
    idChangeHeight = 5
    idJumping = 6
    idAutoJumpingInWater = 7
    idSneaking = 8
    idSneakDown = 9
    idUp = 10
    idDown = 11
    idLeft = 12
    idRight = 13
    idUpLeft = 14
    idUpRight = 15
    idWantUp = 16
    idWantDown = 17
    idWantDownSlow = 18
    idWantUpSlow = 19
    idSprinting = 20
    idAscendBlock = 21
    idDescendBlock = 22
    idSneakToggleDown = 23
    idPersistSneak = 24
    idStartSprinting = 25
    idStopSprinting = 26
    idStartSneaking = 27
    idStopSneaking = 28
    idStartSwimming = 29
    idStopSwimming = 30
    idStartJumping = 31
    idStartGliding = 32
    idStopGliding = 33
    idPerformItemInteraction = 34
    idPerformBlockActions = 35
    idPerformItemStackRequest = 36
    idHandledTeleport = 37
    idEmoting = 38
    idMissedSwing = 39
    idStartCrawling = 40
    idStopCrawling = 41
    idStartFlying = 42
    idStopFlying = 43
    idClientAckServerData = 44
    idClientPredictedVehicle = 45
    idPaddlingLeft = 46
    idPaddlingRight = 47
    idBlockBreakingDelayEnabled = 48
    idHorizontalCollision = 49
    idVerticalCollision = 50
    idDownLeft = 51
    idDownRight = 52
    idStartUsingItem = 53
    idCameraRelativeMovementEnabled = 54
    idRotControlledByMoveDirection = 55
    idStartSpinAttack = 56
    idStopSpinAttack = 57
    idIsHotbarTouchOnly = 58
    idJumpReleasedRaw = 59
    idJumpPressedRaw = 60
    idJumpCurrentRaw = 61
    idSneakReleasedRaw = 62
    idSneakPressedRaw = 63
    idSneakCurrentRaw = 64

  PlayerBlockAction* = object
    action*: VarInt
    blockPos*: BlockPos
    face*: VarInt

  PlayerInventoryAction* = object
    legacyRequestId*: VarInt
    legacySlots*: seq[LegacySetItemSlot]
    actions*: seq[InventoryAction]
    transaction*: UseItemTransactionData

  SPlayerAuthInput* = object
    pitch*: float32
    yaw*: float32
    position*: Vector3[float32]
    moveVec*: Vector2[float32]
    headYaw*: float32
    inputData*: FixedBedrockBitset ## `Bitset<65>`
    inputMode*: VarUInt
    playMode*: VarUInt
    interactionModel*: VarUInt
    interactPitch*: float32
    interactYaw*: float32
    tick*: VarULong
    delta*: Vector3[float32]
    blockActions*: Option[seq[PlayerBlockAction]]
    itemInteraction*: Option[PlayerInventoryAction]
    itemStackRequest*: Option[ItemStackRequest]
    vehicleRotation*: Option[Vector2[float32]]
    vehicleUniqueId*: Option[VarLong]
    analogMove*: Vector2[float32]
    cameraOrientation*: Vector3[float32]
    rawMove*: Vector2[float32]

proc packetRead*(_: typedesc[PlayerBlockAction]; r: var NetReader): ProtoReadResult[PlayerBlockAction] =
  let action = tryRead(PlayerBlockAction, packetRead(VarInt, r))
  let blockPos = tryRead(PlayerBlockAction, packetRead(BlockPos, r))
  let face = tryRead(PlayerBlockAction, packetRead(VarInt, r))
  readOk(PlayerBlockAction(action: action, blockPos: blockPos, face: face))

proc packetRead*(_: typedesc[PlayerInventoryAction]; r: var NetReader): ProtoReadResult[PlayerInventoryAction] =
  let legacyRequestId = tryRead(PlayerInventoryAction, packetRead(VarInt, r))
  var legacySlots: seq[LegacySetItemSlot] = @[]
  if legacyRequestId.value < -1'i32 and (legacyRequestId.value and 1'i32) == 0'i32:
    let slotsLen = tryRead(PlayerInventoryAction, packetRead(VarUInt, r)).value
    var i = 0'u32
    while i < slotsLen:
      legacySlots.add(tryRead(PlayerInventoryAction, packetRead(LegacySetItemSlot, r)))
      i += 1'u32
  let actionsLen = tryRead(PlayerInventoryAction, packetRead(VarUInt, r)).value
  var actions: seq[InventoryAction] = @[]
  var j = 0'u32
  while j < actionsLen:
    actions.add(tryRead(PlayerInventoryAction, packetRead(InventoryAction, r)))
    j += 1'u32
  let transaction = tryRead(PlayerInventoryAction, packetRead(UseItemTransactionData, r))
  readOk(PlayerInventoryAction(legacyRequestId: legacyRequestId, legacySlots: legacySlots, actions: actions,
    transaction: transaction))

proc getInput*(self: SPlayerAuthInput; bit: InputData): bool =
  ## `input_data.get(InputData::X as usize)`.
  self.inputData.get(ord(bit))

proc packetRead*(_: typedesc[SPlayerAuthInput]; r: var NetReader): ProtoReadResult[SPlayerAuthInput] =
  let pitch = tryRead(SPlayerAuthInput, packetRead(float32, r))
  let yaw = tryRead(SPlayerAuthInput, packetRead(float32, r))
  let position = tryRead(SPlayerAuthInput, packetRead(Vector3[float32], r))
  let moveVec = tryRead(SPlayerAuthInput, packetRead(Vector2[float32], r))
  let headYaw = tryRead(SPlayerAuthInput, packetRead(float32, r))
  let inputData = tryRead(SPlayerAuthInput, packetRead(InputDataBits, r))
  let inputMode = tryRead(SPlayerAuthInput, packetRead(VarUInt, r))
  let playMode = tryRead(SPlayerAuthInput, packetRead(VarUInt, r))
  let interactionModel = tryRead(SPlayerAuthInput, packetRead(VarUInt, r))
  let interactPitch = tryRead(SPlayerAuthInput, packetRead(float32, r))
  let interactYaw = tryRead(SPlayerAuthInput, packetRead(float32, r))
  let tick = tryRead(SPlayerAuthInput, packetRead(VarULong, r))
  let delta = tryRead(SPlayerAuthInput, packetRead(Vector3[float32], r))
  # 1. Perform Item Interaction
  var itemInteraction = none[PlayerInventoryAction]()
  if inputData.get(ord(idPerformItemInteraction)):
    itemInteraction = some(tryRead(SPlayerAuthInput, packetRead(PlayerInventoryAction, r)))
  # 2. Item Stack Request
  var itemStackRequest = none[ItemStackRequest]()
  if inputData.get(ord(idPerformItemStackRequest)):
    itemStackRequest = some(tryRead(SPlayerAuthInput, packetRead(ItemStackRequest, r)))
  # 3. Block Actions
  var blockActions = none[seq[PlayerBlockAction]]()
  if inputData.get(ord(idPerformBlockActions)):
    let count = int(tryRead(SPlayerAuthInput, packetRead(VarInt, r)).value)
    var actions: seq[PlayerBlockAction] = @[]
    for _ in 0 ..< count:
      actions.add(tryRead(SPlayerAuthInput, packetRead(PlayerBlockAction, r)))
    blockActions = some(actions)
  # 4. Vehicle Info (matches the Go logic)
  var vehicleRotation = none[Vector2[float32]]()
  var vehicleUniqueId = none[VarLong]()
  if inputData.get(ord(idClientPredictedVehicle)):
    vehicleRotation = some(tryRead(SPlayerAuthInput, packetRead(Vector2[float32], r)))
    vehicleUniqueId = some(tryRead(SPlayerAuthInput, packetRead(VarLong, r)))
  # 5. Trailing Data
  let analogMove = tryRead(SPlayerAuthInput, packetRead(Vector2[float32], r))
  let cameraOrientation = tryRead(SPlayerAuthInput, packetRead(Vector3[float32], r))
  let rawMove = tryRead(SPlayerAuthInput, packetRead(Vector2[float32], r))
  readOk(SPlayerAuthInput(pitch: pitch, yaw: yaw, position: position, moveVec: moveVec, headYaw: headYaw,
    inputData: inputData, inputMode: inputMode, playMode: playMode, interactionModel: interactionModel,
    interactPitch: interactPitch, interactYaw: interactYaw, tick: tick, delta: delta, blockActions: blockActions,
    itemInteraction: itemInteraction, itemStackRequest: itemStackRequest, vehicleRotation: vehicleRotation,
    vehicleUniqueId: vehicleUniqueId, analogMove: analogMove, cameraOrientation: cameraOrientation,
    rawMove: rawMove))
