## Port of pumpkin-protocol/src/bedrock/server/player_hotbar.rs

import ../../protobase, ../../netcodec, ../../serial

const SPlayerHotbarPacketId* = 48'i32

type
  SPlayerHotbar* = object
    selectedSlot*: uint32
    containerId*: uint8
    selectSlot*: bool

proc packetRead*(_: typedesc[SPlayerHotbar]; r: var NetReader): ProtoReadResult[SPlayerHotbar] =
  ## `selected_slot` is a plain little-endian u32 here, where the clientbound twin uses a VarUInt.
  let selectedSlot = tryRead(SPlayerHotbar, packetRead(uint32, r))
  let containerId = tryRead(SPlayerHotbar, packetRead(uint8, r))
  let selectSlot = tryRead(SPlayerHotbar, packetRead(bool, r))
  readOk(SPlayerHotbar(selectedSlot: selectedSlot, containerId: containerId, selectSlot: selectSlot))
