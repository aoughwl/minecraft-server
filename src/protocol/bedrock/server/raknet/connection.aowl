## Port of pumpkin-protocol/src/bedrock/server/raknet/connection.rs
## Connected RakNet packets the server receives. The id byte has already been consumed by the caller.

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod, ../../rakaddr

const
  SConnectedPingPacketId* = 0x00'i32
  SConnectionRequestPacketId* = 0x09'i32
  SNewIncomingConnectionPacketId* = 0x13'i32
  SDisconnectPacketId* = 0x15'i32
  SConnectionLostPacketId* = 0x16'i32

type
  SConnectedPing* = object
    ## Sent periodically by a connected client to measure round-trip time. `time` is big-endian.
    time*: uint64

  SConnectionRequest* = object
    ## Sent by the client after `OpenConnectionReply2`. `clientGuid` and `time` are big-endian.
    clientGuid*: uint64
    time*: uint64
    security*: bool

  SNewIncomingConnection* = object
    ## Sent by the client to confirm local network address and finish connection establishment.
    serverAddress*: SocketAddr
    internalAddress*: SocketAddr
    pingTime*: uint64
    pongTime*: uint64

  SDisconnect* = object
    ## Graceful disconnection notification. No fields.

  SConnectionLost* = object
    ## Internal notification for a connection lost to a socket error or timeout. No fields.

proc packetRead*(_: typedesc[SConnectedPing]; r: var NetReader): ProtoReadResult[SConnectedPing] =
  let time = tryRead(SConnectedPing, packetReadBe(uint64, r))
  readOk(SConnectedPing(time: time))

proc packetRead*(_: typedesc[SConnectionRequest]; r: var NetReader): ProtoReadResult[SConnectionRequest] =
  let clientGuid = tryRead(SConnectionRequest, packetReadBe(uint64, r))
  let time = tryRead(SConnectionRequest, packetReadBe(uint64, r))
  let security = tryRead(SConnectionRequest, packetRead(bool, r))
  readOk(SConnectionRequest(clientGuid: clientGuid, time: time, security: security))

proc packetRead*(_: typedesc[SNewIncomingConnection]; r: var NetReader): ProtoReadResult[SNewIncomingConnection] =
  let serverAddress = tryRead(SNewIncomingConnection, packetReadRakAddr(r))
  let internalAddress = tryRead(SNewIncomingConnection, packetReadRakAddr(r))
  let pingTime = tryRead(SNewIncomingConnection, packetReadBe(uint64, r))
  let pongTime = tryRead(SNewIncomingConnection, packetReadBe(uint64, r))
  readOk(SNewIncomingConnection(serverAddress: serverAddress, internalAddress: internalAddress,
    pingTime: pingTime, pongTime: pongTime))
