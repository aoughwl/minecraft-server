## Port of pumpkin-protocol/src/bedrock/server/raknet/open_connection.rs

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod, ../../rakaddr

const
  SOpenConnectionRequest1PacketId* = 0x05'i32
  SOpenConnectionRequest2PacketId* = 0x07'i32

type
  SOpenConnectionRequest1* = object
    ## Sent by a connecting client to start the RakNet handshake and probe the MTU. `mtu` is big-endian.
    magic*: array[16, uint8]
    protocolVersion*: uint8
    mtu*: uint16

  SOpenConnectionRequest2* = object
    ## Sent after `OpenConnectionReply1`. `mtu` and `clientGuid` are big-endian.
    magic*: array[16, uint8]
    serverAddress*: SocketAddr
    mtu*: uint16
    clientGuid*: uint64

proc packetRead*(_: typedesc[SOpenConnectionRequest1]; r: var NetReader): ProtoReadResult[SOpenConnectionRequest1] =
  let magic = tryRead(SOpenConnectionRequest1, readRakMagic(r))
  let protocolVersion = tryRead(SOpenConnectionRequest1, packetRead(uint8, r))
  let mtu = tryRead(SOpenConnectionRequest1, packetReadBe(uint16, r))
  readOk(SOpenConnectionRequest1(magic: magic, protocolVersion: protocolVersion, mtu: mtu))

proc packetRead*(_: typedesc[SOpenConnectionRequest2]; r: var NetReader): ProtoReadResult[SOpenConnectionRequest2] =
  let magic = tryRead(SOpenConnectionRequest2, readRakMagic(r))
  let serverAddress = tryRead(SOpenConnectionRequest2, packetReadRakAddr(r))
  let mtu = tryRead(SOpenConnectionRequest2, packetReadBe(uint16, r))
  let clientGuid = tryRead(SOpenConnectionRequest2, packetReadBe(uint64, r))
  readOk(SOpenConnectionRequest2(magic: magic, serverAddress: serverAddress, mtu: mtu, clientGuid: clientGuid))
