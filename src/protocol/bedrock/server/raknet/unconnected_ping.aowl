## Port of pumpkin-protocol/src/bedrock/server/raknet/unconnected_ping.rs

import ../../../protobase, ../../../netcodec, ../../../serial
import ../../bedrockmod

const
  SUnconnectedPingPacketId* = 0x01'i32
  SUnconnectedPingOpenConnectionsPacketId* = 0x02'i32

type
  SUnconnectedPing* = object
    ## Sent by an unconnected client to request server information. `time` and `clientGuid` are big-endian.
    time*: uint64
    magic*: array[16, uint8]
    clientGuid*: uint64

  SUnconnectedPingOpenConnections* = object
    ## The same layout, sent when the client only wants servers with open connections.
    time*: uint64
    magic*: array[16, uint8]
    clientGuid*: uint64

proc packetRead*(_: typedesc[SUnconnectedPing]; r: var NetReader): ProtoReadResult[SUnconnectedPing] =
  let time = tryRead(SUnconnectedPing, packetReadBe(uint64, r))
  let magic = tryRead(SUnconnectedPing, readRakMagic(r))
  let clientGuid = tryRead(SUnconnectedPing, packetReadBe(uint64, r))
  readOk(SUnconnectedPing(time: time, magic: magic, clientGuid: clientGuid))

proc packetRead*(_: typedesc[SUnconnectedPingOpenConnections]; r: var NetReader):
    ProtoReadResult[SUnconnectedPingOpenConnections] =
  let time = tryRead(SUnconnectedPingOpenConnections, packetReadBe(uint64, r))
  let magic = tryRead(SUnconnectedPingOpenConnections, readRakMagic(r))
  let clientGuid = tryRead(SUnconnectedPingOpenConnections, packetReadBe(uint64, r))
  readOk(SUnconnectedPingOpenConnections(time: time, magic: magic, clientGuid: clientGuid))
