## Port of pumpkin-protocol/src/bedrock/server/request_ability.rs

import ../../protobase, ../../netcodec, ../../serial, ../../varint

const SRequestAbilityPacketId* = 102'i32

type
  AbilityValueKind* = enum
    avBool
    avFloat

  AbilityValue* = object
    case kind*: AbilityValueKind
    of avBool: boolValue*: bool
    of avFloat: floatValue*: float32

  SRequestAbility* = object
    ability*: VarInt
    value*: AbilityValue

proc packetRead*(_: typedesc[AbilityValue]; r: var NetReader): ProtoReadResult[AbilityValue] =
  ## All three of the type byte, a bool and a float are read, whichever the type picks.
  let valType = tryRead(AbilityValue, packetRead(uint8, r))
  let boolVal = tryRead(AbilityValue, packetRead(bool, r))
  let floatVal = tryRead(AbilityValue, packetRead(float32, r))
  case valType
  of 1'u8: readOk(AbilityValue(kind: avBool, boolValue: boolVal))
  of 2'u8: readOk(AbilityValue(kind: avFloat, floatValue: floatVal))
  else: readErr[AbilityValue](messageRead("Invalid ability value type: " & $valType))

proc packetRead*(_: typedesc[SRequestAbility]; r: var NetReader): ProtoReadResult[SRequestAbility] =
  let ability = tryRead(SRequestAbility, packetRead(VarInt, r))
  let value = tryRead(SRequestAbility, packetRead(AbilityValue, r))
  readOk(SRequestAbility(ability: ability, value: value))
