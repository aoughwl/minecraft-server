## Port of pumpkin-protocol/src/bedrock/server/resource_pack_response.rs

import ../../protobase, ../../netcodec, ../../serial

const
  SResourcePackResponsePacketId* = 8'i32
  SResourcePackResponseStatusRefused* = 1'u8
  SResourcePackResponseStatusSendPacks* = 2'u8
  SResourcePackResponseStatusHaveAllPacks* = 3'u8
  SResourcePackResponseStatusCompleted* = 4'u8

type
  SResourcePackResponse* = object
    response*: uint8
    downloadSize*: uint16

proc packetRead*(_: typedesc[SResourcePackResponse]; r: var NetReader): ProtoReadResult[SResourcePackResponse] =
  let response = tryRead(SResourcePackResponse, packetRead(uint8, r))
  let downloadSize = tryRead(SResourcePackResponse, packetRead(uint16, r))
  readOk(SResourcePackResponse(response: response, downloadSize: downloadSize))
