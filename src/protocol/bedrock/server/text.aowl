## Port of pumpkin-protocol/src/bedrock/server/text.rs
## Upstream's borrowed (`PacketReadSlice`) and owned reads are one buffer-backed read here, with owned strings.
## `r#type` is `typ`. `get_category` is private upstream.

import std/options
import ../../protobase, ../../netcodec, ../../serial, ../../varint

const STextPacketId* = 9'i32

type
  TextPacketType* = enum
    tptRaw = 0
    tptChat = 1
    tptTranslation = 2
    tptPopup = 3
    tptJukeboxPopup = 4
    tptTip = 5
    tptSystem = 6
    tptWhisper = 7
    tptAnnouncement = 8
    tptJsonWhisper = 9
    tptJson = 10
    tptJsonAnnouncement = 11

  SText* = object
    needsTranslation*: bool
    typ*: TextPacketType
    sourceName*: string
    message*: string
    parameters*: seq[string]
    xuid*: string
    platformChatId*: string
    filteredMessage*: Option[string]

proc getCategory(self: SText): uint8 =
  case self.typ
  of tptRaw, tptTip, tptSystem, tptJsonWhisper, tptJsonAnnouncement, tptJson: 0'u8
  of tptChat, tptWhisper, tptAnnouncement: 1'u8
  of tptTranslation, tptPopup, tptJukeboxPopup: 2'u8

proc newSText*(message: string; sourceName: string): SText =
  ## A chat message; an empty message becomes a single space.
  SText(needsTranslation: false, typ: tptChat, sourceName: sourceName,
    message: if message.len == 0: " " else: message, parameters: @[], xuid: "", platformChatId: "",
    filteredMessage: none[string]())

proc translation*(_: typedesc[SText]; message: string; parameters: seq[string]): SText =
  SText(needsTranslation: true, typ: tptTranslation, sourceName: "", message: message, parameters: parameters,
    xuid: "", platformChatId: "", filteredMessage: none[string]())

proc systemMessage*(_: typedesc[SText]; message: string): SText =
  SText(needsTranslation: false, typ: tptSystem, sourceName: "",
    message: if message.len == 0: " " else: message, parameters: @[], xuid: "", platformChatId: "",
    filteredMessage: none[string]())

proc json*(_: typedesc[SText]; message: string): SText =
  SText(needsTranslation: false, typ: tptJson, sourceName: "", message: message, parameters: @[], xuid: "",
    platformChatId: "", filteredMessage: none[string]())

proc packetRead*(_: typedesc[TextPacketType]; r: var NetReader): ProtoReadResult[TextPacketType] =
  let b = tryRead(TextPacketType, packetRead(uint8, r))
  if b <= 11'u8:
    readOk(TextPacketType(int(b)))
  else:
    readErr[TextPacketType](messageRead("Unknown Text Type"))

proc packetWrite*(self: TextPacketType; w: var NetWriter) =
  packetWrite(uint8(ord(self)), w)

proc packetRead*(_: typedesc[SText]; r: var NetReader): ProtoReadResult[SText] =
  ## The category byte is read and ignored; what follows depends on the type.
  let needsTranslation = tryRead(SText, packetRead(bool, r))
  discard tryRead(SText, packetRead(uint8, r)) # category
  let typ = tryRead(SText, packetRead(TextPacketType, r))
  var sourceName = ""
  var message = ""
  var parameters: seq[string] = @[]
  case typ
  of tptChat, tptWhisper, tptAnnouncement:
    sourceName = tryRead(SText, packetRead(string, r))
    message = tryRead(SText, packetRead(string, r))
  of tptRaw, tptTip, tptSystem, tptJsonWhisper, tptJson, tptJsonAnnouncement:
    message = tryRead(SText, packetRead(string, r))
  of tptTranslation, tptPopup, tptJukeboxPopup:
    message = tryRead(SText, packetRead(string, r))
    let count = int(tryRead(SText, packetRead(VarUInt, r)).value)
    for _ in 0 ..< count:
      parameters.add(tryRead(SText, packetRead(string, r)))
  let xuid = tryRead(SText, packetRead(string, r))
  let platformChatId = tryRead(SText, packetRead(string, r))
  var filteredMessage = none[string]()
  if tryRead(SText, packetRead(bool, r)):
    filteredMessage = some(tryRead(SText, packetRead(string, r)))
  readOk(SText(needsTranslation: needsTranslation, typ: typ, sourceName: sourceName, message: message,
    parameters: parameters, xuid: xuid, platformChatId: platformChatId, filteredMessage: filteredMessage))

proc packetWrite*(self: SText; w: var NetWriter) =
  packetWrite(self.needsTranslation, w)
  packetWrite(getCategory(self), w)
  packetWrite(self.typ, w)
  case self.typ
  of tptChat, tptWhisper, tptAnnouncement:
    packetWrite(self.sourceName, w)
    packetWrite(self.message, w)
  of tptRaw, tptTip, tptSystem, tptJsonWhisper, tptJson, tptJsonAnnouncement:
    packetWrite(self.message, w)
  of tptTranslation, tptPopup, tptJukeboxPopup:
    packetWrite(self.message, w)
    packetWrite(newVarUInt(uint32(self.parameters.len)), w)
    for p in self.parameters:
      packetWrite(p, w)
  packetWrite(self.xuid, w)
  packetWrite(self.platformChatId, w)
  if self.filteredMessage.isSome:
    packetWrite(true, w)
    packetWrite(self.filteredMessage.unsafeGet, w)
  else:
    packetWrite(false, w)
