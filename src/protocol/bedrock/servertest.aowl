{.feature: "untyped".}
## Test for the serverbound Bedrock packets. Protocol 1001. The inputs are the bytes a client sends, laid out
## from the pinned Rust's `PacketRead` impls with struct.pack in a scratch script, and every packet that also has
## a `PacketWrite` (text, animate, emote, emote list, container close, actor event) is checked in both directions.
import std/options
import bedrocktestutil
import ../uuid
import ../bitset
import ../../util/vector2
import ../../util/vector3
import ../../util/math/position
import network_item
import server/[actor_event, animate, block_pick_request, client_cache_status, client_to_server_handshake,
  command_request, container_close, emote, emote_list, interaction, loading_screen, login, mob_equipment,
  modal_form_response, player_hotbar, request_ability, request_chunk_radius, request_network_settings,
  resource_pack_response, set_local_player_as_initialized, set_player_inventory_options, player_action, text,
  inventory_transaction, item_stack_request, player_auth_input]

template parsed(T: untyped; hex: string): untyped =
  ## The value `packetRead` makes of `hex`, which must succeed and consume every byte.
  block:
    var pr = newNetReader(hx(hex))
    let prRes = packetRead(T, pr)
    if not prRes.isOk:
      echo "FAIL read ", astToStr(T), ": ", prRes.error.msg
      quit(1)
    if remaining(pr) != 0:
      echo "FAIL read ", astToStr(T), ": ", remaining(pr), " bytes left over"
      quit(1)
    prRes.value

template failsWith(T: untyped; hex: string; message: string) =
  block:
    var fr = newNetReader(hx(hex))
    let frRes = packetRead(T, fr)
    if frRes.isOk or frRes.error.msg != message:
      echo "FAIL expected error for ", astToStr(T), ": ", message
      if not frRes.isOk:
        echo "  got ", frRes.error.msg
      quit(1)

proc bitsOf(hex: string): FixedBedrockBitset =
  var r = newNetReader(hx(hex))
  let res = packetRead(65, r)
  res.value

proc v3(x, y, z: float32): Vector3[float32] = Vector3[float32](x: x, y: y, z: z)

# Packet ids are upstream's #[packet(N)].
check(SActorEventPacketId == 27'i32 and SAnimatePacketId == 44'i32 and SBlockPickRequestPacketId == 34'i32 and
  SClientCacheStatusPacketId == 129'i32 and SClientToServerHandshakePacketId == 4'i32 and
  SCommandRequestPacketId == 77'i32 and SContainerClosePacketId == 47'i32 and SEmotePacketId == 138'i32 and
  SEmoteListPacketId == 152'i32 and SInteractionPacketId == 33'i32 and SLoadingScreenPacketId == 312'i32 and
  SMobEquipmentPacketId == 31'i32 and SModalFormResponsePacketId == 101'i32 and SPlayerHotbarPacketId == 48'i32 and
  SRequestAbilityPacketId == 102'i32 and SRequestChunkRadiusPacketId == 69'i32 and
  SRequestNetworkSettingsPacketId == 0xC1'i32 and SResourcePackResponsePacketId == 8'i32 and
  SSetLocalPlayerAsInitializedPacketId == 113'i32 and SSetPlayerInventoryOptionsPacketId == 307'i32 and
  SPlayerActionPacketId == 36'i32 and STextPacketId == 9'i32 and SInventoryTransactionPacketId == 30'i32 and
  SItemStackRequestPacketId == 147'i32 and SPlayerAuthInputPacketId == 144'i32, "packet ids")

# --- trivial ones -------------------------------------------------------------------------------------------
discard parsed(SClientToServerHandshake, "")
check(parsed(SClientCacheStatus, "01").cacheSupported, "client cache status")
check(parsed(SRequestNetworkSettings, "000003e9").protocolVersion == 1001'i32, "request network settings is big-endian")
let pr = parsed(SResourcePackResponse, "040000")
check(pr.response == SResourcePackResponseStatusCompleted and pr.downloadSize == 0'u16, "resource pack response")
check(SResourcePackResponseStatusRefused == 1'u8 and SResourcePackResponseStatusSendPacks == 2'u8 and
  SResourcePackResponseStatusHaveAllPacks == 3'u8, "resource pack statuses")
let rcr = parsed(SRequestChunkRadius, "1010")
check(rcr.chunkRadius.value == 8'i32 and rcr.maxRadius == 16'u8, "request chunk radius")
check(parsed(SSetLocalPlayerAsInitialized, "ac02").runtimeEntityId.value == 300'u64, "initialized")
let ls = parsed(SLoadingScreen, "040107000000")
check(ls.isLoadingDone() and ls.id.get() == 7'u32, "loading screen end")
let ls2 = parsed(SLoadingScreen, "0200")
check(not ls2.isLoadingDone() and ls2.id.isNone, "loading screen start")
let opts = parsed(SSetPlayerInventoryOptions, "0102010304")
check(opts.leftInventoryTab == 1'u8 and opts.rightInventoryTab == 2'u8 and opts.filtering and opts.inventoryLayout == 3'u8 and
  opts.craftingLayout == 4'u8, "inventory options")
let hb = parsed(SPlayerHotbar, "040000000001")
check(hb.selectedSlot == 4'u32 and hb.containerId == 0'u8 and hb.selectSlot, "player hotbar")
let bpr = parsed(SBlockPickRequest, "0a0c0e0103")
check(bpr.blockPos == newBlockPos(5'i32, 6'i32, 7'i32) and bpr.addBlockNbt and bpr.hotbarSlot == 3'u8, "block pick")
let mf = parsed(SModalFormResponse, "0e01035b305d")
check(mf.formId.value == 7'i32 and mf.formData.get() == "[0]", "form response")
check(parsed(SModalFormResponse, "0e00").formData.isNone, "form closed")

# --- login -------------------------------------------------------------------------------------------------------
let loginPkt = parsed(SLogin, "000003e91306000000616263646566050000003132333435")
check(loginPkt.protocolVersion == 1001'i32 and loginPkt.jwt == hx(utf8Hex("abcdef")) and loginPkt.rawToken == hx(utf8Hex("12345")), "login")
let loginEmpty = parsed(SLogin, "000003cf080000000000000000")
check(loginEmpty.protocolVersion == 975'i32 and loginEmpty.jwt.len == 0 and loginEmpty.rawToken.len == 0, "empty login")
failsWith(SLogin, "000003e9 ffffffff0f", "Connection request length 4294967295 exceeds limit 8388608")

# --- command request, text, emote ------------------------------------------------------------------------------
let cr = parsed(SCommandRequest, "072f73617920686906706c61796572000102030405060708090a0b0c0d0e0f057265712d31f7ffffffffffffff0007312e32362e3330")
check(cr.command == "/say hi" and cr.commandType == "player" and cr.requestId == "req-1" and cr.playerActorUniqueId == -9'i64 and
  not cr.isInternalSource and cr.version == "1.26.30" and cr.commandUuid == Uuid(hi: 0x0001020304050607'u64, lo: 0x08090a0b0c0d0e0f'u64),
  "command request")
let chat = parsed(SText, "00010105537465766502686903313233047063696400")
check(chat.typ == tptChat and chat.sourceName == "Steve" and chat.message == "hi" and chat.xuid == "123" and
  chat.platformChatId == "pcid" and chat.filteredMessage.isNone and not chat.needsTranslation, "text chat")
eqHex(wrote(chat), "00010105537465766502686903313233047063696400", "text chat writes back")
let chatF = parsed(SText, "0001010553746576650268690331323304706369640103686921")
check(chatF.filteredMessage.get() == "hi!", "filtered message")
eqHex(wrote(chatF), "0001010553746576650268690331323304706369640103686921", "filtered chat writes back")
let tr = parsed(SText, "0102020e636861742e747970652e746578740201610162000000")
check(tr.typ == tptTranslation and tr.needsTranslation and tr.message == "chat.type.text" and tr.parameters == @["a", "b"], "translation")
eqHex(wrote(SText.translation("chat.type.text", @["a", "b"])), "0102020e636861742e747970652e746578740201610162000000", "translation text writes")
let sys = parsed(SText, "000006046e6f7465000000")
check(sys.typ == tptSystem and sys.message == "note" and sys.sourceName == "", "system text")
eqHex(wrote(SText.systemMessage("note")), "000006046e6f7465000000", "system message writes")
eqHex(wrote(SText.json("{}")), "00000a027b7d000000", "json text writes with category 0")
# An empty message becomes a space for chat and system messages.
check(newSText("", "x").message == " " and SText.systemMessage("").message == " ", "empty message is a space")
check(newSText("m", "me").typ == tptChat and newSText("m", "me").sourceName == "me", "chat constructor")
failsWith(SText, "00000c", "Unknown Text Type")
# Whisper takes the chat shape; the category byte read is ignored, and written it is 1 for chat-like types.
let whisper = parsed(SText, "0001070141016d000000")
check(whisper.typ == tptWhisper and whisper.sourceName == "A", "whisper")
eqHex(wrote(whisper), "0001070141016d000000", "whisper writes category 1")
let popup = parsed(SText, "010203017000000000")
check(popup.typ == tptPopup and popup.parameters.len == 0, "popup")
eqHex(wrote(popup), "010203017000000000", "popup writes category 2")
check(ord(tptJsonAnnouncement) == 11 and ord(tptJukeboxPopup) == 4, "text types")

let em = parsed(SEmote, "0508656d6f74652d6964d0070000047875696404706c617403")
check(em.runtimeEntityId.value == 5'u64 and em.emoteId == "emote-id" and em.emoteLength == 2000'u32 and em.xuid == "xuid" and
  em.platformId == "plat" and em.flags == (EMOTE_FLAG_SERVER_SIDE or EMOTE_FLAG_MUTE_CHAT), "emote")
eqHex(wrote(em), "0508656d6f74652d6964d0070000047875696404706c617403", "emote writes back")
# Upstream `emote_list_serialization`, with fixed ids instead of random ones.
let el = parsed(SEmoteList, "0502000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
check(el.runtimeEntityId.value == 5'u64 and el.emotePieces.len == 2 and
  el.emotePieces[0] == Uuid(hi: 0x0001020304050607'u64, lo: 0x08090a0b0c0d0e0f'u64) and
  el.emotePieces[1] == Uuid(hi: 0x1011121314151617'u64, lo: 0x18191a1b1c1d1e1f'u64), "emote list")
eqHex(wrote(el), "0502000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "emote list round trip")
let cc = parsed(SContainerClose, "010201")
check(cc.containerId == 1'u8 and cc.containerType == 2'u8 and cc.serverInitiated, "container close")
eqHex(wrote(cc), "010201", "container close writes back")

# --- animate, interaction, actions -----------------------------------------------------------------------------
let an = parsed(SAnimate, "010500000000010661747461636b")
check(an.action == aaSwingArm and an.runtimeEntityId.value == 5'u64 and an.swingSource.get() == assAttack, "animate")
eqHex(wrote(an), "010500000000010661747461636b", "animate writes back with the swing source as text")
let an2 = parsed(SAnimate, "05050000c03f00")
check(an2.action == aaMagicCriticalHit and an2.data == 1.5'f32 and an2.swingSource.isNone, "animate without source")
failsWith(SAnimate, "09", "Invalid animate action ID: 9")
failsWith(SAnimate, "010500000000010570756e6368", "Unknown swing source: punch")
check(swingSourceFromStr("useitem").value == assUseItem and swingSourceFromStr("dropitem").value == assDropItem and
  assEvent.asStr() == "event" and assNone.asStr() == "none" and assThrowItem.asStr() == "throwitem", "swing source strings")
let it = parsed(SInteraction, "02ac02010000803f0000004000004040")
check(it.action == iaAttack and it.targetRuntimeId.value == 300'u64 and it.position.get() == v3(1.0, 2.0, 3.0), "interaction")
check(parsed(SInteraction, "060000").action == iaOpenInventory, "interaction without position")
failsWith(SInteraction, "070000", "")
let pa = parsed(SPlayerAction, "0148020406070a0b02")
check(pa.runtimeId.value == -1'i32 and pa.action == patClientAckServerData and pa.blockPos == newBlockPos(1'i32, 2'i32, 3'i32) and
  pa.resultPos == newBlockPos(-4'i32, 5'i32, -6'i32) and pa.face.value == 1'i32, "player action")
failsWith(SPlayerAction, "014a", "Invalid action ID: 37")
let ae = SActorEvent(entityRuntimeId: newVarLong(7'i64), eventType: aetHurt, eventData: newVarInt(-1'i32),
  fireAtPosition: some(v3(1.0, 2.0, 3.0)))
eqHex(wrote(ae), "0e0201010000803f0000004000004040", "actor event")
eqHex(wrote(SActorEvent(entityRuntimeId: newVarLong(7'i64), eventType: aetFeed, eventData: newVarInt(0'i32),
  fireAtPosition: none[Vector3[float32]]())), "0e390000", "actor event without position")
check(ord(aetKineticDamageDealt) == 80 and ord(aetHurtWithoutReceivingDamage) == 81 and ord(aetBabyEat) == 60, "actor event values")

# --- request ability, mob equipment ------------------------------------------------------------------------------
let ra = parsed(SRequestAbility, "12010100000000")
check(ra.ability.value == 9'i32 and ra.value.kind == avBool and ra.value.boolValue, "ability bool")
let ra2 = parsed(SRequestAbility, "1a02000000803e")
check(ra2.value.kind == avFloat and ra2.value.floatValue == 0.25'f32, "ability float")
failsWith(SRequestAbility, "12030100000000", "Invalid ability value type: 3")
let me = parsed(SMobEquipment, "010ac00503000000000400000000090000")
check(me.entityRuntimeId.value == 1'u64 and me.stackId.value == 5'i32 and me.item.get().id.value == 352'i32 and
  me.item.get().stackSize == 3'u16 and me.inventorySlot == 9'u8 and me.windowId == 0'u8, "mob equipment")
let me2 = parsed(SMobEquipment, "0100090177")
check(me2.item.isNone and me2.hotbarSlot == 1'u8 and me2.windowId == 119'u8, "mob equipment with a zero stack id has no item")

# --- inventory transaction -----------------------------------------------------------------------------------
var ar = newNetReader(hx("00ee010300c00501000000000400000000"))
let a1 = packetRead(InventoryAction, ar)
check(a1.isOk and remaining(ar) == 0 and a1.value.sourceType == 0'u32 and a1.value.windowId.get() == 119'i32 and
  a1.value.inventorySlot == 3'u32 and a1.value.oldItem.id.value == 0'i32 and a1.value.newItem.id.value == 352'i32 and
  a1.value.sourceFlags.isNone, "container action")
let a2 = parsed(InventoryAction, "020100c0050200000000040000000000")
check(a2.sourceFlags.get() == 1'u32 and a2.windowId.isNone and a2.oldItem.stackSize == 2'u16, "world action")
let a3 = parsed(InventoryAction, "030100c00501000000000400000000")
check(a3.windowId.isNone and a3.sourceFlags.isNone and a3.newItem.id.value == 352'i32, "creative action has neither")
let a4 = parsed(InventoryAction, "9f8d0603020000")
check(a4.sourceType == 99999'u32 and a4.windowId.get() == -2'i32, "todo action reads a window id")
let a5 = parsed(InventoryAction, "01040000")
check(a5.sourceType == 1'u32 and a5.windowId.isNone and a5.sourceFlags.isNone and a5.inventorySlot == 4'u32, "unknown action source")
check(inventoryActionSourceFrom(0'u32).kind == iasContainer and inventoryActionSourceFrom(2'u32).kind == iasWorld and
  inventoryActionSourceFrom(3'u32).kind == iasCreative and inventoryActionSourceFrom(99999'u32).kind == iasTodo and
  inventoryActionSourceFrom(1'u32).kind == iasUnknown and inventoryActionSourceFrom(1'u32).value == 1'u32,
  "InventoryActionSource::from")
check(WINDOW_ID_INVENTORY == 0'i32 and WINDOW_ID_OFF_HAND == 119'i32 and WINDOW_ID_ARMOUR == 120'i32 and WINDOW_ID_UI == 124'i32,
  "window ids")
let tn = parsed(SInventoryTransaction, "0000010001010100ee010300c00501000000000400000000")
check(tn.transactionData.kind == tdNormal and tn.hasValue and tn.actions.len == 1 and tn.transactionType.value == 0'u32, "normal transaction")
let tm = parsed(SInventoryTransaction, "000001010100")
check(tm.transactionData.kind == tdMismatch and not tm.hasValue and tm.actions.len == 0, "mismatch transaction")
let tu = parsed(SInventoryTransaction, "000001020101000100028001010104c005010000000004000000000000803f00008242000080bf0000003f0000003f0000003fa6660100")
check(tu.transactionData.kind == tdUseItem, "use item transaction")
let ui = tu.transactionData.useItem
check(ui.actionType.value == 1'u32 and ui.triggerType == 0'u8 and ui.blockPosition == newBlockPos(1'i32, 64'i32, -1'i32) and
  ui.blockFace == 1'i32 and ui.hotBarSlot.value == 2'i32 and ui.itemInHand.id.value == 352'i32 and
  ui.playerPosition == v3(1.0, 65.0, -1.0) and ui.clickPosition == v3(0.5, 0.5, 0.5) and ui.blockRuntimeId.value == 13094'u32 and
  ui.clientPrediction == 1'u8 and ui.clientCooldownState == 0'u8, "use item fields")
let te = parsed(SInventoryTransaction, "050101070201020103010102020100c0050200000000040000000000030100c00501000000000400000000ac020104c005010000000004000000000000803f00000040000040400000003f0000003f0000003f")
check(te.transactionData.kind == tdUseItemOnEntity and te.legacyRequestId.value == -3'i32 and te.legacySetItemSlots.len == 1 and
  te.legacySetItemSlots[0].containerId == 7'u8 and te.legacySetItemSlots[0].slots == @[1'u8, 2'u8] and te.actions.len == 2,
  "use item on entity")
let ue = te.transactionData.useItemOnEntity
check(ue.targetEntityRuntimeId.value == 300'u64 and ue.actionType.value == 1'u32 and ue.hotBarSlot.value == 2'i32 and
  ue.playerPosition == v3(1.0, 2.0, 3.0), "use item on entity fields")
let trl = parsed(SInventoryTransaction, "0000010401000104c005010000000004000000000000803f0000004000004040")
check(trl.transactionData.kind == tdReleaseItem and trl.transactionData.releaseItem.headPosition == v3(1.0, 2.0, 3.0) and
  trl.transactionData.releaseItem.hotBarSlot.value == 2'i32, "release item")
failsWith(SInventoryTransaction, "000001050100", "Unknown inventory transaction type: 5")
check(parsed(SInventoryTransaction, "0000010001010500ee010300c00501000000000400000000020100c0050200000000040000000000030100c005010000000004000000009f8d060302000001040000").actions.len == 5, "five actions")

# --- item stack request ----------------------------------------------------------------------------------------
let si = parsed(ItemStackRequestSlotInfo, "1c000710")
check(si.containerName.containerName == cnHotBar and si.slotId == 7'u8 and si.stackId.value == 8'i32, "slot info")
eqHex(wrote(si), "1c000710", "slot info writes back")
var actr = newNetReader(hx("00011c0002141c000301021c00040a1c00050c03021c0001020104011c00010205011c0001020600090a02010b000a120c4d010d4e020301c005040002100201020e05010f06020000001007060111077061747465726e01121301c005040002100201020201021c0002061c00030807031c00020a1c00030c08041c00020e1c000310"))
var acts: seq[ItemStackRequestAction] = @[]
while remaining(actr) > 0:
  let one = packetRead(ItemStackRequestAction, actr)
  if not one.isOk:
    echo "FAIL action ", acts.len, ": ", one.error.msg
    quit(1)
  acts.add(one.value)
check(acts.len == 20, "twenty actions")
check(acts[0].kind == isaTake and acts[0].count == 1'u8 and acts[0].source.slotId == 2'u8 and acts[0].source.stackId.value == 10'i32 and
  acts[0].destination.stackId.value == -1'i32, "take")
check(acts[1].kind == isaSwap and acts[1].slot1.slotId == 4'u8 and acts[1].slot2.stackId.value == 6'i32, "swap")
check(acts[2].kind == isaDrop and acts[2].count == 2'u8 and acts[2].randomly, "drop")
check(acts[3].kind == isaDestroy and acts[4].kind == isaConsume and acts[5].kind == isaCreate and acts[5].resultIndex == 0'u8, "destroy consume create")
check(acts[6].kind == isaLabTableCombine and acts[7].kind == isaBeaconPayment and acts[7].primaryEffectId.value == 1'i32 and
  acts[7].secondaryEffectId.value == -1'i32, "lab table, beacon")
check(acts[8].kind == isaMineBlock and acts[8].stackId.value == 9'i32 and acts[8].predictedDurability.value == 5'i32, "mine block")
check(acts[9].kind == isaCraftRecipe and acts[9].recipeId.value == 77'u32 and acts[9].repetitions == 1'u8, "craft recipe")
check(acts[10].kind == isaCraftRecipeAuto and acts[10].recipeId.value == 78'u32 and acts[10].repetitions == 2'u8 and
  acts[10].repetitions2 == 3'u8, "craft recipe auto discards its ingredients")
check(acts[11].kind == isaCraftCreative and acts[11].creativeItemId.value == 5'u32, "craft creative")
check(acts[12].kind == isaOptional and acts[12].filterStringIndex == 2'i32, "optional")
check(acts[13].kind == isaGrindstone and acts[13].repairCost.value == 3'i32, "grindstone")
check(acts[14].kind == isaLoom and acts[14].patternId == "pattern", "loom")
check(acts[15].kind == isaCraftNonImplemented, "craft non implemented")
check(acts[16].kind == isaCraftResultsDeprecated and acts[16].resultItems.len == 1 and acts[16].resultItems[0].count == 4'u16 and
  acts[16].timesCrafted == 2'u8, "craft results deprecated")
check(acts[17].kind == isaPlace and acts[17].count == 2'u8 and acts[17].destination.stackId.value == 4'i32, "place")
check(acts[18].kind == isaPlaceInContainer and acts[18].count == 3'u8 and acts[18].source.stackId.value == 5'i32, "place in container")
check(acts[19].kind == isaTakeOutContainer and acts[19].count == 4'u8 and acts[19].destination.stackId.value == 8'i32,
  "take out container")
failsWith(ItemStackRequestAction, "14", "Unknown ItemStackRequestAction ID: 20")
let req = parsed(SItemStackRequest, "010902060109010666696c74657203000000")
check(req.requests.len == 1 and req.requests[0].requestId.value == -5'i32 and req.requests[0].actions.len == 2 and
  req.requests[0].filterStrings == @["filter"] and req.requests[0].filterCause == 3'i32, "item stack request")

# --- player auth input -----------------------------------------------------------------------------------------
var bsr = newNetReader(hx("c18040"))
let bsRes = packetRead(65, bsr)
check(bsRes.isOk and remaining(bsr) == 0 and bsRes.value.get(0) and bsRes.value.get(6) and bsRes.value.get(20) and
  not bsRes.value.get(1) and not bsRes.value.get(64), "bitset read")
let bs64 = bitsOf("80808080808080808002")
check(bs64.get(64) and not bs64.get(0), "bitset bit 64")
let bsLong = bitsOf("81808080808080808002")
check(bsLong.get(0) and bsLong.get(64), "bitset bits 0 and 64")
var bsBad = newNetReader(hx("ffffffffffffffffffff"))
check(not packetRead(65, bsBad).isOk, "an unterminated bitset is too large")

let plain = parsed(SPlayerAuthInput, "000020410000a0410000803f00008042000000400000003f000000bf0000f041c180400100010000803f00000040d209000000000ad7a3bd000000000000803e0000403f000000000000803f000000000000803f000080bf")
check(plain.pitch == 10.0'f32 and plain.yaw == 20.0'f32 and plain.position == v3(1.0, 64.0, 2.0) and
  plain.moveVec == Vector2[float32](x: 0.5'f32, y: -0.5'f32) and plain.headYaw == 30.0'f32, "auth input head")
check(plain.getInput(idAscend) and plain.getInput(idJumping) and plain.getInput(idSprinting) and not plain.getInput(idDescend),
  "auth input bits")
check(plain.inputMode.value == 1'u32 and plain.playMode.value == 0'u32 and plain.interactionModel.value == 1'u32 and
  plain.interactPitch == 1.0'f32 and plain.interactYaw == 2.0'f32 and plain.tick.value == 1234'u64 and
  plain.delta == v3(0.0, -0.08'f32, 0.0), "auth input mid")
check(plain.blockActions.isNone and plain.itemInteraction.isNone and plain.itemStackRequest.isNone and
  plain.vehicleRotation.isNone and plain.vehicleUniqueId.isNone, "auth input has no optional parts")
check(plain.analogMove == Vector2[float32](x: 0.25'f32, y: 0.75'f32) and plain.cameraOrientation == v3(0.0, 1.0, 0.0) and
  plain.rawMove == Vector2[float32](x: 1.0'f32, y: -1.0'f32), "auth input trailer")
let blocks = parsed(SPlayerAuthInput, "000020410000a0410000803f00008042000000400000003f000000bf0000f0418080808080010100010000803f00000040d209000000000ad7a3bd0000000004000204060200020406020000803e0000403f000000000000803f000000000000803f000080bf")
check(blocks.blockActions.get().len == 2 and blocks.blockActions.get()[0].blockPos == newBlockPos(1'i32, 2'i32, 3'i32) and
  blocks.blockActions.get()[1].face.value == 1'i32, "auth input block actions")
let veh = parsed(SPlayerAuthInput, "000020410000a0410000803f00008042000000400000003f000000bf0000f041808080808080080100010000803f00000040d209000000000ad7a3bd000000000000a0400000c040070000803e0000403f000000000000803f000000000000803f000080bf")
check(veh.vehicleRotation.get() == Vector2[float32](x: 5.0'f32, y: 6.0'f32) and veh.vehicleUniqueId.get().value == -4'i64,
  "auth input vehicle")
let all = parsed(SPlayerAuthInput, "")
check(all.itemInteraction.isSome and all.itemInteraction.get().legacyRequestId.value == -2'i32 and
  all.itemInteraction.get().legacySlots.len == 1 and all.itemInteraction.get().legacySlots[0].containerId == 9'u8 and
  all.itemInteraction.get().transaction.blockRuntimeId.value == 13094'u32, "auth input item interaction")
check(all.itemStackRequest.isSome and all.itemStackRequest.get().requestId.value == -5'i32 and
  all.blockActions.get().len == 1 and all.vehicleUniqueId.get().value == -4'i64 and all.getInput(idSneakCurrentRaw),
  "auth input with every optional part")
check(ord(imMouse) == 1 and ord(imMotionController) == 4 and ord(pmExitLevel) == 7 and ord(pmNumModes) == 9 and
  ord(imodClassic) == 2 and ord(idClientPredictedVehicle) == 45 and ord(idSneakCurrentRaw) == 64, "auth input enums")

echo "all serverbound packet checks passed"
