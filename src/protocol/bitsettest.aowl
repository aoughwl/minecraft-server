## Verifies BitSet against upstream bit_set.rs's own #[cfg(test)] vectors.
## Run with `aowlmony c -r src/protocol/bitsettest.aowl`.

import std/assertions
import std/syncio
import bitset, netcodec, protobase
import ../util/javaversion

block roundTripByteArray:
  var b = newBitSet()
  setBit(b, 0, true)
  setBit(b, 8, true)
  setBit(b, 70, true)

  var w = newNetWriter()
  let enc = encodeWithVersion(b, w, jmvV26_3)
  assert enc.isOk

  # upstream: [9, 0x01, 0x01, 0, 0, 0, 0, 0, 0, 0x40]
  let expected: seq[byte] = @[9'u8, 0x01, 0x01, 0, 0, 0, 0, 0, 0, 0x40]
  assert w.buf == expected

  var r = newNetReader(w.buf)
  let dec = decodeWithVersion(r, jmvV26_3)
  assert dec.isOk
  assert getBit(dec.value, 0)
  assert getBit(dec.value, 8)
  assert getBit(dec.value, 70)
  assert not getBit(dec.value, 1)

block emptyEncodesEmpty:
  let b = newBitSet()
  var w = newNetWriter()
  let enc = encodeWithVersion(b, w, jmvV26_3)
  assert enc.isOk
  assert w.buf == @[0'u8]

  var r = newNetReader(w.buf)
  let dec = decodeWithVersion(r, jmvV26_3)
  assert dec.isOk
  assert not getBit(dec.value, 0)

block preVersionStaysLongArray:
  let b = fromU64(1)
  var w = newNetWriter()
  let enc = encodeWithVersion(b, w, jmvV1_21_11)
  assert enc.isOk
  assert w.buf == @[1'u8, 0, 0, 0, 0, 0, 0, 0, 1]

block rejectsOutOfRangeLength:
  # Negative when read as a var int
  let negative: seq[byte] = @[0xFF'u8, 0xFF, 0xFF, 0xFF, 0x0F]
  for v26 in [jmvV26_3, jmvV1_21_11]:
    var r = newNetReader(negative)
    let dec = decodeWithVersion(r, v26)
    assert not dec.isOk
    assert dec.error.kind == reTooLarge

block longArray:
  # The pinned bit_set.rs shape.
  var w = newNetWriter()
  assert writeBitset(w, fromI64(-1'i64)).isOk
  assert w.buf == @[1'u8, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]
  var r = newNetReader(w.buf)
  assert decode(r).value.asI64() == -1'i64

block bedrockFixed:
  # Bitset<N>: 7 payload bits a byte, high bit means more.
  var r = newNetReader(@[0x81'u8, 0x01])
  let got = packetRead(80, r)
  assert got.isOk
  assert got.value.get(0) and got.value.get(7) and not got.value.get(1)

  # Bit 77 sits in the eleventh byte, past the first 64-bit half.
  var bytes = newSeq[byte](12)
  for i in 0 ..< 11:
    bytes[i] = 0x80'u8
  bytes[11] = 0x08'u8
  var r2 = newNetReader(bytes)
  let high = packetRead(84, r2)
  assert high.isOk and high.value.get(80) and not high.value.get(77)

  # One byte straddling the two halves: bits 63 and 64.
  var straddle = newSeq[byte](10)
  for i in 0 ..< 9:
    straddle[i] = 0x80'u8
  straddle[9] = 0x03'u8
  var r3 = newNetReader(straddle)
  let mid = packetRead(70, r3)
  assert mid.isOk and mid.value.get(63) and mid.value.get(64) and not mid.value.get(65)

  # All N.div_ceil(7) bytes with the high bit set is too large.
  var r4 = newNetReader(@[0x80'u8, 0x80])
  assert not packetRead(14, r4).isOk

  var b = newFixedBedrockBitset(80)
  b.set(70, true)
  assert b.get(70)
  b.set(70, false)
  assert not b.get(70)

echo "all bitset checks passed"
