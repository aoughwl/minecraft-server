## PARTIAL: pumpkin-util/src/math/position.rs - minimal `BlockPos` for the protocol crate: the three coordinates and the packed long (as_long, from_i64) only. Replace with src/util's when that file is ported.

type
  BlockPos* = object
    x*: int32
    y*: int32
    z*: int32

proc asLong*(self: BlockPos): int64 =
  ## Bits 38-63: X (26 bits), bits 12-37: Z (26 bits), bits 0-11: Y (12 bits).
  ((int64(self.x) and 0x03FF_FFFF'i64) shl 38) or
    ((int64(self.z) and 0x03FF_FFFF'i64) shl 12) or
    (int64(self.y) and 0xFFF'i64)

proc fromI64*(encodedPosition: int64): BlockPos =
  ## Sign-extends each field by shifting it to the top and back.
  BlockPos(
    x: int32(encodedPosition shr 38),
    y: int32((encodedPosition shl 52) shr 52),
    z: int32((encodedPosition shl 26) shr 38))
