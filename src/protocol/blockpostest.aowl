## Known-answer test for blockpos.aowl.
import std/assertions
import std/syncio
import blockpos

let p = BlockPos(x: 1, y: 2, z: 3)
assert p.asLong() == ((1'i64 shl 38) or (3'i64 shl 12) or 2'i64)
for pos in [p, BlockPos(x: -1, y: -64, z: -30000000), BlockPos(x: 30000000, y: 319, z: 5)]:
  let back = fromI64(pos.asLong())
  assert back.x == pos.x and back.y == pos.y and back.z == pos.z
# All ones is -1 in every field.
let neg = fromI64(-1'i64)
assert neg.x == -1 and neg.y == -1 and neg.z == -1
echo "all block pos checks passed"
