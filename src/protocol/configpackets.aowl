## Concrete Java-edition configuration-state packet, in the convention documented at
## the top of proto.aowl.
## Port of pumpkin-protocol/src/java/client/config/registry_data.rs

import protobase, netcodec, varint
import ../generated/packet
import ../util/javaversion

type
  RegistryEntryData* = object
    ## Port of `pumpkin_data::registry::RegistryEntryData`. `data` is a
    ## caller-supplied, already-NBT-encoded byte blob (this packet writes
    ## it verbatim, it doesn't itself know or care about NBT structure) -
    ## `hasData == false` means the entry uses the registry's default/no
    ## override, matching upstream's `data: Option<Vec<u8>>`.
    entryId*: string
    hasData*: bool
    data*: seq[byte]

  CRegistryData* = object
    registryId*: string
    entries*: seq[RegistryEntryData]

proc toId*(_: typedesc[CRegistryData]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_REGISTRY_DATA.toId(v)

proc writePacket*(p: CRegistryData; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.registryId)
  writeVarInt(w, newVarInt(int32(p.entries.len)))
  for entry in p.entries:
    tryWrite writeString(w, entry.entryId)
    writeBool(w, entry.hasData)
    if entry.hasData:
      writeSlice(w, entry.data)
  writeOkVoid()

proc readPacket*(_: typedesc[CRegistryData]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CRegistryData] =
  ## Not upstream's (it only writes this packet): for the round-trip test. An entry's
  ## NBT has no length prefix, so a data blob takes the rest of the packet, and only
  ## the last entry can have one.
  let registryId = tryRead(CRegistryData, getStr(r))
  let count = tryRead(CRegistryData, getVarInt(r)).value
  var entries: seq[RegistryEntryData] = @[]
  for i in 0 ..< count:
    let entryId = tryRead(CRegistryData, getStr(r))
    let hasData = tryRead(CRegistryData, getBool(r))
    var blob: seq[byte] = @[]
    if hasData:
      blob = tryRead(CRegistryData, readRemainingSlice(r, remaining(r)))
    entries.add(RegistryEntryData(entryId: entryId, hasData: hasData, data: blob))
  readOk(CRegistryData(registryId: registryId, entries: entries))
