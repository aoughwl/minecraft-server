## More small Java-edition configuration-state packets, in the convention documented
## at the top of proto.aowl.
## Port of pumpkin-protocol/src/java/client/config/feature_flags.rs
##
## `CConfigResetChat` and `CConfigPing` have no file in the pinned tree: they are
## earlier additions for ids the tables do have, not ports of upstream packets.

import protobase, netcodec, varint
import ../generated/packet
import ../util/javaversion

# --- CConfigResetChat (empty body) -----------------------------------------

type
  CConfigResetChat* = object

proc toId*(_: typedesc[CConfigResetChat]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_RESET_CHAT.toId(v)

proc writePacket*(p: CConfigResetChat; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeOkVoid()

proc readPacket*(_: typedesc[CConfigResetChat]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CConfigResetChat] =
  readOk(CConfigResetChat())

# --- CFeatureFlags -----------------------------------------------------

type
  CFeatureFlags* = object
    features*: seq[string]

proc toId*(_: typedesc[CFeatureFlags]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_UPDATE_ENABLED_FEATURES.toId(v)

proc writePacket*(p: CFeatureFlags; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.features.len)))
  for feature in p.features:
    tryWrite writeString(w, feature)
  writeOkVoid()

proc readPacket*(_: typedesc[CFeatureFlags]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CFeatureFlags] =
  let count = tryRead(CFeatureFlags, getVarInt(r)).value
  var features: seq[string] = @[]
  for i in 0 ..< count:
    features.add(tryRead(CFeatureFlags, getStr(r)))
  readOk(CFeatureFlags(features: features))

# --- CConfigPing -----------------------------------------------------------

type
  CConfigPing* = object
    id*: int32

proc toId*(_: typedesc[CConfigPing]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_PING.toId(v)

proc writePacket*(p: CConfigPing; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.id)
  writeOkVoid()

proc readPacket*(_: typedesc[CConfigPing]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CConfigPing] =
  let id = tryRead(CConfigPing, getI32Be(r))
  readOk(CConfigPing(id: id))
