## Round-trip test for configpackets2.aowl, run via `aowlmony c -r`.
import std/assertions
import std/syncio
import ../util/javaversion
import protobase, netcodec, configpackets2

block resetChat:
  var w = newNetWriter()
  assert writePacket(CConfigResetChat(), w, jmvV1_21_11).isOk
  var r = newNetReader(w.buf)
  let rr = readPacket(CConfigResetChat, r, jmvV1_21_11)
  assert rr.isOk
  assert w.buf.len == 0

block featureFlags:
  let p = CFeatureFlags(features: @["minecraft:vanilla", "minecraft:bundle", "minecraft:trade_rebalance"])
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  var r = newNetReader(w.buf)
  let rr = readPacket(CFeatureFlags, r, jmvV1_21_11)
  assert rr.isOk
  assert rr.value.features == p.features

block emptyFeatureFlags:
  let p = CFeatureFlags(features: @[])
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  var r = newNetReader(w.buf)
  let rr = readPacket(CFeatureFlags, r, jmvV1_21_11)
  assert rr.isOk
  assert rr.value.features.len == 0

block ping:
  for testId in [0'i32, 1, -1, 2147483647'i32, -2147483648'i32]:
    let p = CConfigPing(id: testId)
    var w = newNetWriter()
    assert writePacket(p, w, jmvV1_21_11).isOk
    var r = newNetReader(w.buf)
    let rr = readPacket(CConfigPing, r, jmvV1_21_11)
    assert rr.isOk
    assert rr.value.id == testId

block exactBytes:
  var w = newNetWriter()
  assert writePacket(CFeatureFlags(features: @["a:b"]), w, jmvV1_21_11).isOk
  assert w.buf == @[1'u8, 3, 0x61, 0x3A, 0x62]
  w = newNetWriter()
  assert writePacket(CConfigPing(id: 258'i32), w, jmvV1_21_11).isOk
  assert w.buf == @[0'u8, 0, 1, 2]
  assert CFeatureFlags.toId(jmvV1_21_11) == 12'i32
  assert CConfigResetChat.toId(jmvV1_21_11) == 6'i32
  assert CConfigPing.toId(jmvV1_21_11) == 5'i32

echo "configpackets2 round-trip: OK"
