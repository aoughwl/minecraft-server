## Known-answer test for itemstackserializer.aowl and the id remap under it.
import std/assertions
import std/syncio
import std/options
import protobase, netcodec, varint, datacomponent, itemstackserializer
import ../nbt/[nbtbase, serializer, tag]
import ../util/javaversion
import ../util/text/text

const
  # Ids from assets/items.json and mappings-26.2to26.1.nbt/mappings-26.1to1.21.11.nbt,
  # composed: ITEM_ID_REMAP_V_26_2_TO_V_1_21_11 in pumpkin-data/src/generated.
  ServerStone = 1'u16

let noPatch: seq[PatchEntry] = @[]

let damaged = newItemStack(3'u8, ServerStone, @[
  PatchEntry(id: dcDamage, data: DataComponentValue(kind: dcvDamage, damage: DamageImpl(damage: 5'i32))),
  PatchEntry(id: dcUnbreakable, data: DataComponentValue(kind: dcvRemoved))])

block writeBytes:
  var w = newNetWriter()
  assert fromItemStack(damaged).write(w).isOk
  # count, item, added, removed, damage id and value, unbreakable id.
  assert w.buf == @[3'u8, 1, 1, 1, 3, 5, 4]

block emptyIsOneZero:
  var w = newNetWriter()
  assert fromItemStack(emptyItemStack()).write(w).isOk
  assert w.buf == @[0'u8]
  var w2 = newNetWriter()
  assert fromOptionalItemStack(none[ItemStack]()).write(w2).isOk
  assert w2.buf == @[0'u8]
  # Air with a count is empty too.
  var w3 = newNetWriter()
  assert fromItemStack(newItemStack(5'u8, 0'u16, noPatch)).write(w3).isOk
  assert w3.buf == @[0'u8]

block templateSwapsCountAndItem:
  var w = newNetWriter()
  assert ItemStackTemplateSerializer(stack: damaged).write(w).isOk
  assert w.buf == @[1'u8, 3, 1, 1, 3, 5, 4]

block templateGateOn26_1:
  var old = newNetWriter()
  assert ItemStackTemplateSerializer(stack: newItemStack(3'u8, ServerStone, noPatch)).writeWithVersion(old, jmvV1_21_11).isOk
  assert old.buf == @[3'u8, 1, 0, 0]
  var modern = newNetWriter()
  assert ItemStackTemplateSerializer(stack: newItemStack(3'u8, ServerStone, noPatch)).writeWithVersion(modern, jmvV26_1).isOk
  assert modern.buf == @[1'u8, 3, 0, 0]

block readBack:
  # read consumes a byte length after each added component's id.
  var r = newNetReader(@[3'u8, 1, 1, 1, 3, 1, 5, 4])
  let got = read(ItemStackSerializer, r)
  assert got.isOk, got.error.msg
  let stack = got.value.toStack()
  assert stack.itemCount == 3'u8 and stack.itemId == 1'u16 and stack.patch.len == 2
  assert stack.patch[0].id == dcDamage and stack.patch[0].data.damage.damage == 5'i32
  assert stack.patch[1].data.kind == dcvRemoved

  var empty0 = newNetReader(@[0'u8])
  assert read(ItemStackSerializer, empty0).value.toStack().isEmpty()

block readRejections:
  var negative = newNetReader(@[1'u8, 1, 0xFF, 0xFF, 0xFF, 0xFF, 0x0F, 0])
  assert not read(ItemStackSerializer, negative).isOk
  var tooMany = newNetReader(@[1'u8, 1, 0x80, 0x02, 0x01])
  assert not read(ItemStackSerializer, tooMany).isOk
  var unknown = newNetReader(@[1'u8, 1, 1, 0, 250, 0])
  assert not read(ItemStackSerializer, unknown).isOk

block unknownItemIsAir:
  var r = newNetReader(@[1'u8, 0xFF, 0xFF, 0x03, 0, 0])
  let got = read(ItemStackSerializer, r)
  assert got.isOk
  assert got.value.toStack().itemId == 0'u16

block lengthPrefixed:
  # The byte length bounds the component's own reader.
  var r = newNetReader(@[2'u8, 1, 1, 1, 3, 1, 5, 4])
  let got = readLengthPrefixedOptional(r)
  assert got.isOk, got.error.msg
  assert got.value.stack.patch[0].data.damage.damage == 5'i32
  assert got.value.stack.patch[1].id == dcUnbreakable

  # CustomName comes as NBT here, as a string tag or a compound with `text`.
  var nameTag = @[0x08'u8, 0, 2, 0x68, 0x69]
  var data = @[1'u8, 1, 1, 0, 6, uint8(nameTag.len)]
  for b in nameTag:
    data.add(b)
  var r2 = newNetReader(data)
  let named = readLengthPrefixedOptional(r2)
  assert named.isOk, named.error.msg
  assert named.value.stack.patch[0].data.customName.name.getText() == "hi"

  var compound = newCompound()
  compound.put("text", NbtTag(kind: ntkString, stringVal: "yo"))
  var nw = newNbtWriter(nwmJava)
  assert serialize(NbtTag(kind: ntkCompound, compoundVal: compound), nw).isOk
  var data2 = @[1'u8, 1, 1, 0, 6, uint8(nw.buf.len)]
  for b in nw.buf:
    data2.add(b)
  var r3 = newNetReader(data2)
  let named2 = readLengthPrefixedOptional(r3)
  assert named2.isOk, named2.error.msg
  assert named2.value.stack.patch[0].data.customName.name.getText() == "yo"

  var badCount = newNetReader(@[0x80'u8, 0x02])
  assert not readLengthPrefixedOptional(badCount).isOk
  var negativeLen = newNetReader(@[1'u8, 1, 1, 0, 3, 0xFF, 0xFF, 0xFF, 0xFF, 0x0F])
  assert not readLengthPrefixedOptional(negativeLen).isOk

block remapFor774:
  # Upstream's ITEM_ID_REMAP_V_26_2_TO_V_1_21_11: diamond_sword is 964 on the server
  # and 936 for a 1.21.11 client, and 26.2 has no table because it is the server's own.
  var w = newNetWriter()
  assert fromItemStack(newItemStack(1'u8, 964'u16, noPatch)).writeWithVersion(w, jmvV1_21_11).isOk
  assert w.buf == @[1'u8, 0xA8, 0x07, 0, 0]
  var same = newNetWriter()
  assert fromItemStack(newItemStack(1'u8, 964'u16, noPatch)).writeWithVersion(same, jmvV26_2).isOk
  assert same.buf == @[1'u8, 0xC4, 0x07, 0, 0]
  # And back, for a stack a 1.21.11 client sends.
  let fromClient = fromItemStack(newItemStack(1'u8, 936'u16, noPatch)).toStackForVersion(jmvV1_21_11)
  assert fromClient.itemId == 964'u16
  # The empty stack is not remapped.
  assert fromItemStack(emptyItemStack()).toStackForVersion(jmvV1_21_11).itemId == 0'u16

block hashes:
  var data = newNetWriter()
  let compHash = ItemComponentHash(added: @[ComponentHashEntry(id: newVarInt(3'i32), hash: 258'i32)], removed: @[newVarInt(4'i32)])
  compHash.write(data)
  assert data.buf == @[1'u8, 3, 0, 0, 1, 2, 1, 4]
  var r = newNetReader(data.buf)
  let got = read(ItemComponentHash, r)
  assert got.isOk and got.value.added[0].hash == 258'i32 and got.value.removed[0].value == 4'i32
  var tooMany = newNetReader(@[0x81'u8, 0x02])
  assert not read(ItemComponentHash, tooMany).isOk

  var someHash = newNetWriter()
  putBool(someHash, true)
  putVarInt(someHash, newVarInt(1'i32))
  putVarInt(someHash, newVarInt(3'i32))
  compHash.write(someHash)
  var r2 = newNetReader(someHash.buf)
  let opt = read(OptionalItemStackHash, r2)
  assert opt.isOk, opt.error.msg
  var back = newNetWriter()
  opt.value.write(back)
  assert back.buf == someHash.buf
  assert opt.value.hashEquals(damaged)
  assert not opt.value.hashEquals(newItemStack(4'u8, ServerStone, noPatch))

  var noneHash = newNetReader(@[0'u8])
  let optNone = read(OptionalItemStackHash, noneHash)
  assert optNone.isOk
  assert optNone.value.hashEquals(emptyItemStack())
  assert not optNone.value.hashEquals(damaged)

echo "all item stack serializer checks passed"
