## Port of pumpkin-protocol/src/java/client/mod.rs
## `mod` is an operator here, so a mod.rs is named after its directory.
##
## Clientbound Packets, Server -> Client. Upstream's are `pub mod`s, each its own namespace.

import config/configmod as clientconfig
import dialog
import login/loginmod as clientlogin
import play/playmod as clientplay
import status/statusmod as clientstatus

export clientconfig, dialog, clientlogin, clientplay, clientstatus
