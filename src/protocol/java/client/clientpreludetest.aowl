## Known-byte tests for the clientbound status and login packets.

import std/[options, syncio]
import ../../proto, ../../uuid, ../../varint
import ../../../util/javaversion
import ../pkttestutil
import login/[cookie_request, encryption_request, login_disconnect, login_success, plugin_request, set_compression]
import status/[ping_response, status_response]

const V = jmvV1_21_11

let id = Uuid(hi: 0x0011223344556677'u64, lo: 0x8899aabbccddeeff'u64)
let session = Uuid(hi: 1'u64, lo: 2'u64)

block statusResponse:
  let p = CStatusResponse(jsonResponse: "{\"a\":1}")
  assert encoded(p, V) == hx("07 7b2261223a317d")
  assert CStatusResponse.toId(V) == 0
  assert decoded(CStatusResponse, hx("07 7b2261223a317d"), V).jsonResponse == "{\"a\":1}"

block pingResponse:
  assert encoded(CPingResponse(payload: 0x0102030405060708'i64), V) == hx("0102030405060708")
  assert CPingResponse.toId(V) == 1
  assert decoded(CPingResponse, hx("ffffffffffffffff"), V).payload == -1'i64

block loginCookieRequest:
  assert encoded(CLoginCookieRequest(key: "a:b"), V) == hx("03 613a62")
  assert CLoginCookieRequest.toId(V) == 5

block encryptionRequest:
  let p = CEncryptionRequest(serverId: "", publicKey: hx("aabb"), verifyToken: hx("cc"), shouldAuthenticate: true)
  assert encoded(p, V) == hx("00 02 aabb 01 cc 01")
  assert CEncryptionRequest.toId(V) == 1
  # Before 1.19 there is no online-mode flag.
  assert encoded(p, jmvV1_18_2) == hx("00 02 aabb 01 cc")

block loginDisconnect:
  let p = CLoginDisconnect(jsonReason: "{}")
  assert encoded(p, V) == hx("02 7b7d")
  assert CLoginDisconnect.toId(V) == 0
  assert decoded(CLoginDisconnect, hx("02 7b7d"), V).jsonReason == "{}"

block loginSuccess774:
  let p = CLoginSuccess(uuid: id, username: "Notch",
    properties: @[Property(name: "t", value: "v", signature: none[string]()),
                  Property(name: "u", value: "w", signature: some("s"))],
    strictErrorHandling: true, sessionId: session)
  assert encoded(p, V) == hx("00112233445566778899aabbccddeeff 05 4e6f746368 02 01 74 01 76 00 01 75 01 77 01 01 73")
  assert CLoginSuccess.toId(V) == 2

block loginSuccessEmptyProperties:
  let p = CLoginSuccess(uuid: id, username: "a", properties: @[])
  assert encoded(p, V) == hx("00112233445566778899aabbccddeeff 01 61 00")

block loginSuccessGates:
  let p = CLoginSuccess(uuid: id, username: "a", properties: @[], strictErrorHandling: true, sessionId: session)
  # 1.20.2 to before 1.21.2 has the strict flag.
  assert encoded(p, jmvV1_21) == hx("00112233445566778899aabbccddeeff 01 61 00 01")
  assert encoded(p, jmvV1_20_2) == hx("00112233445566778899aabbccddeeff 01 61 00 01")
  assert encoded(p, jmvV1_21_2) == hx("00112233445566778899aabbccddeeff 01 61 00")
  # 26.2 has the session id.
  assert encoded(p, jmvV26_1) == hx("00112233445566778899aabbccddeeff 01 61 00")
  assert encoded(p, jmvV26_2) == hx("00112233445566778899aabbccddeeff 01 61 00 00000000000000010000000000000002")
  # Before 1.19 no properties, and before 1.16 the uuid is its text form.
  assert encoded(p, jmvV1_18_2) == hx("00112233445566778899aabbccddeeff 01 61")
  assert encoded(p, jmvV1_15) == hx("24 " & utf8Hex("00112233-4455-6677-8899-aabbccddeeff") & " 01 61")
  # The one version where the id comes from another table.
  assert CLoginSuccess.toId(jmvV1_21) == 2

block loginPluginRequest:
  let p = CLoginPluginRequest(messageId: newVarInt(5), channel: "a", data: hx("aabb"))
  assert encoded(p, V) == hx("05 01 61 aabb")
  assert CLoginPluginRequest.toId(V) == 4

block setCompressionPacket:
  assert encoded(CSetCompression(threshold: newVarInt(256)), V) == hx("8002")
  assert encoded(CSetCompression(threshold: newVarInt(-1)), V) == hx("ffffffff0f")
  assert CSetCompression.toId(V) == 3

echo "all clientbound prelude checks passed"
