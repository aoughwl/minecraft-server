## PARTIAL: pumpkin-protocol/src/java/client/config/add_resource_pack.rs - a Some prompt writes `true` with no text after it, exactly as upstream's TODO does, which is a malformed packet for a client. Send None until upstream writes it.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../uuid
import ../../../../util/text/text

type
  CConfigAddResourcePack* = object
    uuid*: Uuid
    url*: string
    hash*: string  ## max 40
    forced*: bool
    promptMessage*: Option[TextComponent]

proc toId*(_: typedesc[CConfigAddResourcePack]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_RESOURCE_PACK_PUSH.toId(v)

proc writePacket*(p: CConfigAddResourcePack; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeUuid(w, p.uuid)
  tryWrite writeString(w, p.url)
  tryWrite writeString(w, p.hash)
  writeBool(w, p.forced)
  # Upstream writes only `true` here, with a TODO where the prompt's bytes belong.
  writeBool(w, p.promptMessage.isSome)
  writeOkVoid()
