## Port of pumpkin-protocol/src/java/client/config/add_resource_pack.rs
## Upstream writes `true` and then nothing for a Some prompt (a TODO); here the prompt's NBT follows, as the client reads it.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../uuid
import ../play/playwire
import ../../../../util/text/text

type
  CConfigAddResourcePack* = object
    uuid*: Uuid
    url*: string
    hash*: string  ## max 40
    forced*: bool
    promptMessage*: Option[TextComponent]

proc toId*(_: typedesc[CConfigAddResourcePack]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_RESOURCE_PACK_PUSH.toId(v)

proc writePacket*(p: CConfigAddResourcePack; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeUuid(w, p.uuid)
  tryWrite writeString(w, p.url)
  tryWrite writeString(w, p.hash)
  writeBool(w, p.forced)
  writeBool(w, p.promptMessage.isSome)
  if p.promptMessage.isSome:
    tryWrite writeText(w, p.promptMessage.unsafeGet)
  writeOkVoid()
