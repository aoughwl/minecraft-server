## Known-byte tests for the clientbound configuration packets.

import std/[options, syncio]
import ../../../netcodec, ../../../proto, ../../../protobase, ../../../uuid, ../../../varint
import ../../../../generated/tag as gentag
import ../../../../generated/registry as genregistry
import ../../../../nbt/tag as nbttag
import ../../../../util/javaversion
import ../../../../util/text/text as realtext
import ../../pkttestutil
import ../dialog
import add_resource_pack, clear_dialog, config_disconnect, config_ping, config_reset_chat, cookie_request,
  feature_flags, finish_config, known_packs, plugin_message, registry_data, server_links, show_dialog, store_cookie,
  transfer, update_tags

const V = jmvV1_21_11

let packId = Uuid(hi: 0x0011223344556677'u64, lo: 0x8899aabbccddeeff'u64)

block addResourcePack:
  let p = CConfigAddResourcePack(uuid: packId, url: "u", hash: "h", forced: true,
    promptMessage: none[realtext.TextComponent]())
  assert encoded(p, V) == hx("00112233445566778899aabbccddeeff 01 75 01 68 01 00")
  assert CConfigAddResourcePack.toId(V) == 9

block addResourcePackWithPrompt:
  # Upstream writes `true` and then nothing (a TODO); the prompt's NBT text follows here.
  let p = CConfigAddResourcePack(uuid: packId, url: "u", hash: "h", forced: false,
    promptMessage: some(realtext.text("x")))
  assert encoded(p, V) == hx("00112233445566778899aabbccddeeff 01 75 01 68 00 01 0a 08 0004 74657874 0001 78 00")

block clearDialog:
  assert encoded(CConfigClearDialog(), V).len == 0
  assert CConfigClearDialog.toId(V) == 17

block configDisconnect:
  assert encoded(CConfigDisconnect(reason: "bye"), V) == hx("03 627965")
  assert CConfigDisconnect.toId(V) == 2

block cookieRequest:
  assert encoded(CCookieRequest(key: "a:b"), V) == hx("03 613a62")
  assert CCookieRequest.toId(V) == 0

block featureFlags:
  assert encoded(CFeatureFlags(features: @["a:b", "c:d"]), V) == hx("02 03 613a62 03 633a64")
  assert encoded(CFeatureFlags(features: @[]), V) == hx("00")
  assert CFeatureFlags.toId(V) == 12

block finishConfig:
  assert encoded(CFinishConfig(), V).len == 0
  discard decoded(CFinishConfig, hx(""), V)
  assert CFinishConfig.toId(V) == 3

block knownPacks:
  let p = CKnownPacks(knownPacks: @[KnownPack(namespace: "minecraft", id: "core", version: "1.21.11")])
  assert encoded(p, V) == hx("01 09 6d696e656372616674 04 636f7265 07 312e32312e3131")
  assert CKnownPacks.toId(V) == 14

block pluginMessage:
  let p = CPluginMessage(channel: "a", data: hx("aabb"))
  assert encoded(p, V) == hx("01 61 aabb")
  assert CPluginMessage.toId(V) == 1

block registryData:
  let p = CRegistryData(registryId: "a", entries: @[
    RegistryEntryData(entryId: "b", hasData: false, data: @[]),
    RegistryEntryData(entryId: "c", hasData: true, data: @[10'u8, 0])])
  assert encoded(p, V) == hx("01 61 02 01 62 00 01 63 01 0a00")
  assert CRegistryData.toId(V) == 7

block serverLinksBuiltIn:
  let p = CConfigServerLinks(links: @[newLink(Label(kind: lkBuiltIn, builtIn: ltStatus), "u")])
  assert encoded(p, V) == hx("01 01 03 01 75")
  assert CConfigServerLinks.toId(V) == 16

block serverLinksText:
  # Network NBT: compound, `text` string tag, `x`, end.
  let p = CConfigServerLinks(links: @[newLink(Label(kind: lkTextComponent, textComponent: realtext.text("x")), "u")])
  assert encoded(p, V) == hx("01 00 0a 08 0004 74657874 0001 78 00 01 75")

block showDialogById:
  let p = CConfigShowDialog(dialog: IdOr[DialogNBT](kind: iokId, id: 4'u16))
  assert encoded(p, V) == hx("05")
  assert CConfigShowDialog.toId(V) == 18

block showDialogByNbt:
  var compound = newCompound()
  compound.put("a", NbtTag(kind: ntkString, stringVal: "b"))
  let p = CConfigShowDialog(dialog: IdOr[DialogNBT](kind: iokValue, value: fromNbt(compound)))
  assert encoded(p, V) == hx("00 0a 08 0001 61 0001 62 00")

block showDialogFromStructIsNotWritable:
  # Upstream's is `todo!()`.
  let d = Dialog(dialogType: "minecraft:notice", title: realtext.text("t"))
  let p = CConfigShowDialog(dialog: IdOr[DialogNBT](kind: iokValue, value: fromDialog(d)))
  var w = newNetWriter()
  let res = writePacket(p, w, V)
  assert not res.isOk
  assert res.error.kind == weMessage

block storeCookie:
  let p = CStoreCookie(key: "a:b", payload: hx("0708"))
  assert encoded(p, V) == hx("03 613a62 02 0708")
  assert CStoreCookie.toId(V) == 10

block transferPacket:
  let p = CTransfer(host: "h", port: newVarInt(25565))
  assert encoded(p, V) == hx("01 68 ddc701")
  assert CTransfer.toId(V) == 11

block updateTagsExact:
  # assets/tags/1_21_11_tags.json: dialog has two empty tags.
  let name = utf8Hex("minecraft:dialog")
  let a = utf8Hex("minecraft:pause_screen_additions")
  let b = utf8Hex("minecraft:quick_actions")
  assert encoded(CUpdateTags(tags: @[rkDialog]), V) == hx("01 10 " & name & " 02 20 " & a & " 00 17 " & b & " 00")
  assert CUpdateTags.toId(V) == 13

block updateTagsAbsentRegistry:
  # cat_variant has no tags in that file, so upstream's `None` writes an empty list.
  assert not getRegistryKeyTags(V, rkCatVariant).present
  let name = utf8Hex("minecraft:cat_variant")
  assert encoded(CUpdateTags(tags: @[rkCatVariant]), V) == hx("01 15 " & name & " 00")

block updateTagsWalk:
  # Every tag and id in a registry with real contents, several registries in one packet.
  let bytes = encoded(CUpdateTags(tags: @[rkBannerPattern, rkFluid]), V)
  var r = newNetReader(bytes)
  assert getVarInt(r).value.value == 2
  for key in [rkBannerPattern, rkFluid]:
    assert getStr(r).value == "minecraft:" & identifierString(key)
    let want = getRegistryKeyTags(V, key)
    assert want.present
    assert int(getVarInt(r).value.value) == want.names.len
    for i in 0 ..< want.names.len:
      assert getStr(r).value == want.names[i]
      let count = int(getVarInt(r).value.value)
      assert count == want.tags[i].ids.len
      for k in 0 ..< count:
        assert getVarInt(r).value.value == int32(want.tags[i].ids[k])
  assert remaining(r) == 0

block oldConfigAdditions:
  assert encoded(CConfigPing(id: 258'i32), V) == hx("00000102")
  assert decoded(CConfigPing, hx("00000102"), V).id == 258'i32
  assert CConfigPing.toId(V) == 5
  assert encoded(CConfigResetChat(), V).len == 0
  discard decoded(CConfigResetChat, hx(""), V)
  assert CConfigResetChat.toId(V) == 6

echo "all clientbound config checks passed"
