## `CConfigPing` has no file in the pinned tree: an earlier addition for an id the tables do have, not a port
## of an upstream packet. Moved here from the old configuration modules.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CConfigPing* = object
    id*: int32

proc toId*(_: typedesc[CConfigPing]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_PING.toId(v)

proc writePacket*(p: CConfigPing; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.id)
  writeOkVoid()

proc readPacket*(_: typedesc[CConfigPing]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CConfigPing] =
  let id = tryRead(CConfigPing, getI32Be(r))
  readOk(CConfigPing(id: id))
