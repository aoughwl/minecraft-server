## Port of pumpkin-protocol/src/java/client/config/cookie_request.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/resource_location

type
  CCookieRequest* = object
    ## Requests a cookie that was previously stored.
    key*: ResourceLocation

proc toId*(_: typedesc[CCookieRequest]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_COOKIE_REQUEST.toId(v)

proc writePacket*(p: CCookieRequest; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.key)
  writeOkVoid()
