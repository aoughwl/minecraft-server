## Port of pumpkin-protocol/src/java/client/config/known_packs.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto

type
  CKnownPacks* = object
    knownPacks*: seq[KnownPack]

proc toId*(_: typedesc[CKnownPacks]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_SELECT_KNOWN_PACKS.toId(v)

proc writePacket*(p: CKnownPacks; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.knownPacks.len)))
  for pack in p.knownPacks:
    tryWrite pack.write(w)
  writeOkVoid()
