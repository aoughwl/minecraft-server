## Port of pumpkin-protocol/src/java/client/config/plugin_message.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CPluginMessage* = object
    channel*: string
    data*: seq[byte]

proc toId*(_: typedesc[CPluginMessage]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_CUSTOM_PAYLOAD.toId(v)

proc writePacket*(p: CPluginMessage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.channel)
  writeSlice(w, p.data)
  writeOkVoid()
