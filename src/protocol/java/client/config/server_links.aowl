## Port of pumpkin-protocol/src/java/client/config/server_links.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto

type
  CConfigServerLinks* = object
    links*: seq[Link]

proc toId*(_: typedesc[CConfigServerLinks]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_SERVER_LINKS.toId(v)

proc writePacket*(p: CConfigServerLinks; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.links.len)))
  for link in p.links:
    tryWrite link.write(w)
  writeOkVoid()
