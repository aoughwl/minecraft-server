## Port of pumpkin-protocol/src/java/client/config/show_dialog.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../dialog

type
  CConfigShowDialog* = object
    dialog*: IdOr[DialogNBT]

proc toId*(_: typedesc[CConfigShowDialog]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_SHOW_DIALOG.toId(v)

proc writePacket*(p: CConfigShowDialog; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  # `IdOr::write`, inline: writeIdOr's closure parameter is what proto.aowl warns about under tryWrite.
  case p.dialog.kind
  of iokId:
    writeVarInt(w, newVarInt(int32(p.dialog.id) + 1))
    writeOkVoid()
  of iokValue:
    writeVarInt(w, newVarInt(0))
    writePacketData(p.dialog.value, w, v)
