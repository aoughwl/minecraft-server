## Port of pumpkin-protocol/src/java/client/config/transfer.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CTransfer* = object
    host*: string
    port*: VarInt

proc toId*(_: typedesc[CTransfer]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_TRANSFER.toId(v)

proc writePacket*(p: CTransfer; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.host)
  writeVarInt(w, p.port)
  writeOkVoid()
