## Port of pumpkin-protocol/src/java/client/config/update_tags.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../generated/tag

type
  CUpdateTags* = object
    tags*: seq[RegistryKey]

proc toId*(_: typedesc[CUpdateTags]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_UPDATE_TAGS.toId(v)

proc writePacket*(p: CUpdateTags; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.tags.len)))
  for registryKey in p.tags:
    tryWrite writeString(w, "minecraft:" & identifierString(registryKey))

    let values = getRegistryKeyTags(v, registryKey)
    if not values.present:
      # no tags defined for that registry key in this version
      # write an empty list and continue
      writeVarInt(w, newVarInt(0))
      continue
    writeVarInt(w, newVarInt(int32(values.names.len)))

    # Upstream's phf map iterates in hash order; here the names are sorted. The client
    # keys on the name, so the order carries nothing.
    for i in 0 ..< values.names.len:
      # This is technically a `ResourceLocation` but same thing
      tryWrite writeStringBounded(w, values.names[i], int(uint16.high))
      let ids = values.tags[i].ids
      writeVarInt(w, newVarInt(int32(ids.len)))
      for id in ids:
        writeVarInt(w, newVarInt(int32(id)))
  writeOkVoid()
