## Port of pumpkin-protocol/src/java/client/config/update_tags.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../generated/tag
import ../../../../generated/[block_states, block_state_remap, item_id_remap, entity_id_remap]

type
  CUpdateTags* = object
    tags*: seq[RegistryKey]

proc clientBlockIds*(v: JavaMinecraftVersion): seq[uint16] =
  ## 26.2 block registry id -> the id the same block has in version `v`'s registry.
  ## generated/tag.aowl stores every version's tag ids in the 26.2 id space, but a client reads a tag entry as a
  ## position in ITS OWN block registry. A block's client id is its rank among the client's blocks ordered by first
  ## state id; `remapBlockStateForVersion` gives each block's first state in the client's numbering, so the rank
  ## is computable without the client's registry (a block the client lacks lands on another block's state and so
  ## adds no rank; the per-version tag files never list such blocks).
  var present = newSeq[bool](BsStateCount + 1)
  var firstOf = newSeq[int](BsBlocks.len)
  for i in 0 ..< BsBlocks.len:
    let m = int(remapBlockStateForVersion(uint16(BsBlocks[i].firstStateId), v))
    firstOf[i] = m
    if m <= BsStateCount: present[m] = true
  var below = newSeq[int](present.len)
  var run = 0
  for s in 0 ..< present.len:
    below[s] = run
    if present[s]: inc run
  result = newSeq[uint16](BsBlocks.len)
  for i in 0 ..< BsBlocks.len:
    result[i] = uint16(below[min(firstOf[i], BsStateCount)])

proc clientTagId*(key: RegistryKey; v: JavaMinecraftVersion; blockMap: seq[uint16]; id: uint16): uint16 =
  ## One tag entry in the connected client's id space (tag.aowl's are 26.2's).
  if v == jmvV26_2: return id
  case key
  of rkBlock:
    if int(id) < blockMap.len: blockMap[int(id)] else: id
  of rkItem: remapItemIdForVersion(id, v)
  of rkEntityType: remapEntityIdForVersion(id, v)
  else: id

proc toId*(_: typedesc[CUpdateTags]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_UPDATE_TAGS.toId(v)

proc writePacket*(p: CUpdateTags; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.tags.len)))
  for registryKey in p.tags:
    tryWrite writeString(w, "minecraft:" & identifierString(registryKey))

    let values = getRegistryKeyTags(v, registryKey)
    if not values.present:
      # no tags defined for that registry key in this version
      # write an empty list and continue
      writeVarInt(w, newVarInt(0))
      continue
    writeVarInt(w, newVarInt(int32(values.names.len + values.extraNames.len)))   # + the tags a data pack added

    var blockMap: seq[uint16] = @[]
    if registryKey == rkBlock and v != jmvV26_2: blockMap = clientBlockIds(v)

    # Upstream's phf map iterates in hash order; here the names are sorted. The client
    # keys on the name, so the order carries nothing.
    for i in 0 ..< values.names.len:
      # This is technically a `ResourceLocation` but same thing
      tryWrite writeStringBounded(w, values.names[i], int(uint16.high))
      let ids = values.tags[i].ids
      writeVarInt(w, newVarInt(int32(ids.len)))
      for id in ids:
        writeVarInt(w, newVarInt(int32(clientTagId(registryKey, v, blockMap, id))))
    for i in 0 ..< values.extraNames.len:
      tryWrite writeStringBounded(w, values.extraNames[i], int(uint16.high))
      let ids = values.extraTags[i].ids
      writeVarInt(w, newVarInt(int32(ids.len)))
      for id in ids:
        writeVarInt(w, newVarInt(int32(clientTagId(registryKey, v, blockMap, id))))
  writeOkVoid()
