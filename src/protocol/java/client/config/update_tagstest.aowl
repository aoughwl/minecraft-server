## Test for update_tags.aowl: the tag ids a 1.21.11 client is sent must be positions in ITS registries, not 26.2's.
## Decodes the written packet and resolves every id through the client's own registry (tagclientnames.aowl)
## back to a name, then compares it with the name the tag lists.
import std/[assertions, strutils, syncio]
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/tag
import ../../../../util/javaversion
import update_tags, tagclientnames

type Cur = object
  b: seq[byte]
  p: int

proc rdVar(c: var Cur): int =
  var shift = 0
  result = 0
  while true:
    let x = int(c.b[c.p])
    inc c.p
    result = result or ((x and 0x7f) shl shift)
    if (x and 0x80) == 0: break
    shift += 7

proc rdStr(c: var Cur): string =
  let n = rdVar(c)
  result = newString(n)
  for i in 0 ..< n: result[i] = char(c.b[c.p + i])
  c.p += n

type Sent = object
  registry: string
  names: seq[string]
  ids: seq[seq[int]]

proc decode(v: JavaMinecraftVersion): seq[Sent] =
  var w = newNetWriter()
  let pkt = CUpdateTags(tags: @[rkBlock, rkItem, rkEntityType])
  let r = writePacket(pkt, w, v)
  assert r.isOk
  var c = Cur(b: w.buf, p: 0)
  let nreg = rdVar(c)
  result = @[]
  for _ in 0 ..< nreg:
    var s = Sent(registry: rdStr(c), names: @[], ids: @[])
    let nt = rdVar(c)
    for _ in 0 ..< nt:
      s.names.add(rdStr(c))
      let n = rdVar(c)
      var ids: seq[int] = @[]
      for _ in 0 ..< n: ids.add(rdVar(c))
      s.ids.add(ids)
    result.add(s)
  assert c.p == w.buf.len

proc tagIds(s: Sent; name: string): seq[int] =
  for i in 0 ..< s.names.len:
    if s.names[i] == name: return s.ids[i]
  assert false

proc clientIndex(table: string): seq[string] = table.split('\n')

let clientNames = [clientIndex(ClientBlocks), clientIndex(ClientItems), clientIndex(ClientEntityTypes)]
assert clientNames[0].len == 1166
assert clientNames[0][276] == "ice" and clientNames[0][787] == "blue_ice"

let sent = decode(jmvV1_21_11)
assert sent.len == 3

# The reported bug: ice must be 276 and blue_ice 787 (26.2's 277 / 789 made a client's ice take snow's tags).
let iceTag = sent[0].tagIds("minecraft:ice")
assert 276 in iceTag and 787 in iceTag
assert not (277 in iceTag)
echo "minecraft:ice (1.21.11 client ids): ", iceTag.len, " entries, has 276: ", (276 in iceTag), ", has 277: ", (277 in iceTag)
let replaceable = sent[0].tagIds("minecraft:replaceable")
assert not (276 in replaceable)   # ice is not replaceable; client id 276 used to inherit snow's
assert not (787 in sent[0].tagIds("minecraft:wall_corals"))

# Name-level round trip for every tag of every remapped registry.
var failures = 0
for ri in 0 ..< 3:
  let regKey = [rkBlock, rkItem, rkEntityType][ri]
  let tm = getRegistryKeyTags(jmvV1_21_11, regKey)
  assert sent[ri].names.len == tm.names.len + tm.extraNames.len
  var entries = 0
  var bad = 0
  for i in 0 ..< tm.names.len:
    let t = tm.tags[i]
    let got = sent[ri].tagIds(tm.names[i])
    if got.len != t.ids.len or t.values.len != t.ids.len:
      inc bad
      continue
    for j in 0 ..< got.len:
      inc entries
      var want = t.values[j]
      if want.startsWith("minecraft:"): want = want[10 .. ^1]
      if got[j] >= clientNames[ri].len or clientNames[ri][got[j]] != want:
        inc bad
        if bad <= 5: echo "MISMATCH ", sent[ri].registry, " ", tm.names[i], " [", j, "] sent ", got[j], " want ", want
  echo sent[ri].registry, ": ", tm.names.len, " tags, ", entries, " entries, mismatches ", bad
  failures += bad
assert failures == 0

# 26.2 is the table's own id space: unchanged.
let latest = decode(jmvV26_2)
assert 277 in latest[0].tagIds("minecraft:ice")

echo "update_tags: all checks passed"
