## Port of pumpkin-protocol/src/java/client/dialog.rs
## PARTIAL: pumpkin-protocol/src/java/client/dialog.rs - a `Dialog` struct source cannot be written, because upstream's own path is `todo!()`. It returns a write error here where upstream panics. An NBT source writes.

import std/options
import ../../protobase, ../../netcodec, ../../proto
import ../../../nbt/tag
import ../../../util/javaversion
import ../../../util/text/text

type
  DialogBodyKind* = enum
    dbkPlainMessage
    dbkItem

  DialogBody* = object
    case kind*: DialogBodyKind
    of dbkPlainMessage:
      contents*: TextComponent
    of dbkItem:
      item*: int32  ## TODO upstream: ItemStack serialization to NBT

  DialogInputKind* = enum
    dikBoolean
    dikText
    dikNumberRange
    dikSingleOption

  DialogInput* = object
    ## Every upstream variant has a `label`, so it sits before the case. Two variants have a
    ## `default_value` of different types, which a case object cannot share a name for.
    label*: TextComponent
    case kind*: DialogInputKind
    of dikBoolean:
      booleanDefault*: bool
    of dikText:
      placeholder*: TextComponent
      textDefault*: string
    of dikNumberRange:
      min*: float32
      max*: float32
      initial*: float32
      step*: float32
      labelFormat*: Option[string]
    of dikSingleOption:
      options*: seq[TextComponent]
      initialIndex*: uint32

  DialogActionKind* = enum
    dakOpenUrl
    dakCustom

  DialogAction* = object
    case kind*: DialogActionKind
    of dakOpenUrl:
      url*: string
    of dakCustom:
      id*: string
      payload*: Option[seq[byte]]

  ActionButton* = object
    text*: TextComponent
    tooltip*: Option[TextComponent]
    width*: Option[uint32]
    action*: DialogAction

  DialogLink* = object
    label*: Label
    url*: string

  Dialog* = object
    dialogType*: string  ## Upstream's `r#type`.
    title*: TextComponent
    body*: seq[DialogBody]
    inputs*: seq[DialogInput]
    buttons*: seq[ActionButton]
    links*: seq[DialogLink]
    exitAction*: Option[DialogAction]
    afterAction*: Option[string]
    canCloseWithEscape*: bool
    externalTitle*: Option[TextComponent]

  DialogNBTSourceKind* = enum
    dnsStruct
    dnsNbt

  DialogNBT* = object
    ## Upstream's `DialogNBT(DialogNBTSource)`, with the enum flattened into it.
    case kind*: DialogNBTSourceKind
    of dnsStruct:
      dialog*: Dialog
    of dnsNbt:
      nbt*: NbtCompound

proc fromDialog*(dialog: Dialog): DialogNBT =
  DialogNBT(kind: dnsStruct, dialog: dialog)

proc fromNbt*(compound: NbtCompound): DialogNBT =
  DialogNBT(kind: dnsNbt, nbt: compound)

proc writePacketData*(self: DialogNBT; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  case self.kind
  of dnsStruct:
    writeErrVoid(messageWrite("Serialize Dialog to NbtCompound manually"))
  of dnsNbt:
    writeNbt(w, NbtTag(kind: ntkCompound, compoundVal: self.nbt))
