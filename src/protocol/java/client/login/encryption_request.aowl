## Port of pumpkin-protocol/src/java/client/login/encryption_request.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CEncryptionRequest* = object
    ## Sent by the server to initiate the encryption handshake.
    serverId*: string  ## Usually empty unless the server is using legacy authentication.
    publicKey*: seq[byte]  ## The server's DER-encoded RSA public key.
    verifyToken*: seq[byte]  ## Verifies the client can encrypt with the server's public key.
    shouldAuthenticate*: bool  ## Whether the server is in online mode and requires Mojang authentication.

proc toId*(_: typedesc[CEncryptionRequest]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_HELLO.toId(v)

proc writePacket*(p: CEncryptionRequest; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.serverId)
  writeVarInt(w, newVarInt(int32(p.publicKey.len)))
  writeSlice(w, p.publicKey)
  writeVarInt(w, newVarInt(int32(p.verifyToken.len)))
  writeSlice(w, p.verifyToken)
  if v >= jmvV1_19:
    writeBool(w, p.shouldAuthenticate)
  writeOkVoid()
