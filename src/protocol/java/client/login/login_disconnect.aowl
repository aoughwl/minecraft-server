## Port of pumpkin-protocol/src/java/client/login/login_disconnect.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CLoginDisconnect* = object
    ## Sent by the server to reject a login attempt or kick a player during the login phase.
    jsonReason*: string  ## A JSON-encoded chat component explaining why the player was disconnected.

proc toId*(_: typedesc[CLoginDisconnect]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_LOGIN_DISCONNECT.toId(v)

proc readPacket*(_: typedesc[CLoginDisconnect]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CLoginDisconnect] =
  let jsonReason = tryRead(CLoginDisconnect, getStr(r))
  readOk(CLoginDisconnect(jsonReason: jsonReason))

proc writePacket*(p: CLoginDisconnect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.jsonReason)
  writeOkVoid()
