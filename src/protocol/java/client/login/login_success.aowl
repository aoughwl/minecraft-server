## Port of pumpkin-protocol/src/java/client/login/login_success.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto, ../../../uuid

type
  CLoginSuccess* = object
    ## Sent by the server to signal a successful login and transition to the configuration phase.
    uuid*: Uuid  ## The unique identifier assigned to the player.
    username*: string  ## The player's verified username.
    properties*: seq[Property]  ## The player's profile properties, such as skin data and signatures.
    strictErrorHandling*: bool  ## (<1.21.2) Whether strict error handling should be enabled.
    sessionId*: Uuid  ## Added in 26.2

proc toId*(_: typedesc[CLoginSuccess]; v: JavaMinecraftVersion): int32 =
  # TODO: this is hacky :c
  if v == jmvV1_21:
    CB_LOGIN_GAME_PROFILE.toId(v)
  else:
    CB_LOGIN_LOGIN_FINISHED.toId(v)

proc writePacket*(p: CLoginSuccess; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  if v < jmvV1_16:
    tryWrite writeString(w, $p.uuid)
  else:
    writeUuid(w, p.uuid)
  tryWrite writeString(w, p.username)
  if v >= jmvV1_19:
    writeVarInt(w, newVarInt(int32(p.properties.len)))
    for property in p.properties:
      tryWrite property.write(w)
  if v >= jmvV1_20_2 and v < jmvV1_21_2:
    writeBool(w, p.strictErrorHandling)
  if v >= jmvV26_2:
    writeUuid(w, p.sessionId)
  writeOkVoid()
