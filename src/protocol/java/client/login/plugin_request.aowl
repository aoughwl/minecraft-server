## Port of pumpkin-protocol/src/java/client/login/plugin_request.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CLoginPluginRequest* = object
    ## Sent by the server to initiate a custom plugin messaging exchange during login.
    messageId*: VarInt  ## A unique id for this request, echoed in the client's response.
    channel*: string  ## The name of the custom channel, e.g. `velocity:main`.
    data*: seq[byte]  ## The raw payload. No length prefix: it runs to the end of the packet.

proc toId*(_: typedesc[CLoginPluginRequest]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_CUSTOM_QUERY.toId(v)

proc writePacket*(p: CLoginPluginRequest; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.messageId)
  tryWrite writeString(w, p.channel)
  writeSlice(w, p.data)
  writeOkVoid()
