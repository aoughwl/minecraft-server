## Port of pumpkin-protocol/src/java/client/login/set_compression.rs
##
## The read is not upstream's (it only writes this packet): loginpacketstest.aowl round-trips it.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetCompression* = object
    ## Sent by the server to enable network compression for all subsequent packets.
    threshold*: VarInt  ## The packet size threshold, in bytes, at which compression is applied. Negative disables it.

proc toId*(_: typedesc[CSetCompression]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_LOGIN_COMPRESSION.toId(v)

proc readPacket*(_: typedesc[CSetCompression]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CSetCompression] =
  let threshold = tryRead(CSetCompression, getVarInt(r))
  readOk(CSetCompression(threshold: threshold))

proc writePacket*(p: CSetCompression; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.threshold)
  writeOkVoid()
