## Port of pumpkin-protocol/src/java/client/play/acknowledge_block.rs
## Acknowledges a sequence of block changes initiated by the client.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CAcknowledgeBlockChange* = object
    sequenceId*: VarInt  ## The ID of the last sequence processed by the server.

proc toId*(_: typedesc[CAcknowledgeBlockChange]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BLOCK_CHANGED_ACK.toId(v)

proc writePacket*(p: CAcknowledgeBlockChange; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.sequenceId)
  writeOkVoid()
