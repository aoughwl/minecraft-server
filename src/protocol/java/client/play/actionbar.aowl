## Port of pumpkin-protocol/src/java/client/play/actionbar.rs
## Updates the text displayed above the player's hotbar.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  CActionBar* = object
    actionBar*: TextComponent

proc toId*(_: typedesc[CActionBar]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_ACTION_BAR_TEXT.toId(v)

proc writePacket*(p: CActionBar; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.actionBar)
  writeOkVoid()
