## Port of pumpkin-protocol/src/java/client/play/award_stats.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  Statistic* = object
    categoryId*: VarInt
    statisticId*: VarInt
    value*: VarInt

  CAwardStats* = object
    stats*: seq[Statistic]

proc write*(self: Statistic; w: var NetWriter) =
  writeVarInt(w, self.categoryId)
  writeVarInt(w, self.statisticId)
  writeVarInt(w, self.value)

proc toId*(_: typedesc[CAwardStats]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_AWARD_STATS.toId(v)

proc writePacket*(p: CAwardStats; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.stats.len)))
  for stat in p.stats:
    stat.write(w)
  writeOkVoid()
