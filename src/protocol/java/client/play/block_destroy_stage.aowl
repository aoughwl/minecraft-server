## Port of pumpkin-protocol/src/java/client/play/block_destroy_stage.rs
## Updates the visual breaking progress of a block for all clients.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import playwire

type
  CSetBlockDestroyStage* = object
    entityId*: VarInt     ## Usually the miner's entity id.
    location*: BlockPos
    destroyStage*: int8   ## 0 to 9; anything else removes the overlay.

proc toId*(_: typedesc[CSetBlockDestroyStage]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BLOCK_DESTRUCTION.toId(v)

proc writePacket*(p: CSetBlockDestroyStage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeBlockPos(w, p.location)
  writeI8(w, p.destroyStage)
  writeOkVoid()
