## Port of pumpkin-protocol/src/java/client/play/block_entity_data.rs
## Updates the NBT data of a block entity.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import playwire

type
  CBlockEntityData* = object
    location*: BlockPos
    typ*: VarInt         ## Upstream's `r#type`: the block entity type.
    nbtData*: seq[byte]  ## The raw NBT payload.

proc toId*(_: typedesc[CBlockEntityData]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BLOCK_ENTITY_DATA.toId(v)

proc writePacket*(p: CBlockEntityData; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBlockPos(w, p.location)
  writeVarInt(w, p.typ)
  writeSlice(w, p.nbtData)
  writeOkVoid()
