## Port of pumpkin-protocol/src/java/client/play/block_event.rs
## Triggers a block animation or sound, such as a chest opening or a note block playing.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import playwire

type
  CBlockEvent* = object
    location*: BlockPos
    actionId*: uint8
    actionParameter*: uint8
    blockType*: VarInt   ## The block id, not the state id.

proc toId*(_: typedesc[CBlockEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BLOCK_EVENT.toId(v)

proc writePacket*(p: CBlockEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBlockPos(w, p.location)
  writeU8(w, p.actionId)
  writeU8(w, p.actionParameter)
  writeVarInt(w, p.blockType)
  writeOkVoid()
