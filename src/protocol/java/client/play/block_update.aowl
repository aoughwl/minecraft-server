## Port of pumpkin-protocol/src/java/client/play/block_update.rs
## Updates a single block state at a location in the world.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import ../../../../generated/block_state_remap
import playwire

type
  CBlockUpdate* = object
    location*: BlockPos
    stateId*: VarInt

proc toId*(_: typedesc[CBlockUpdate]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BLOCK_UPDATE.toId(v)

proc writePacket*(p: CBlockUpdate; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBlockPos(w, p.location)
  # `u16::try_from` fails for anything out of range, which is then sent unchanged.
  let remappedState =
    if p.stateId.value >= 0 and p.stateId.value <= 65535:
      int32(remapBlockStateForVersion(uint16(p.stateId.value), v))
    else:
      p.stateId.value
  writeVarInt(w, newVarInt(remappedState))
  writeOkVoid()
