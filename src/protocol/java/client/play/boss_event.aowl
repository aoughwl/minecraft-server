## Port of pumpkin-protocol/src/java/client/play/boss_event.rs
## Updates the boss bar displayed at the top of the player's screen.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/uuid
import playwire, bossevent_action

type
  CBossEvent* = object
    uuid*: Uuid
    action*: BosseventAction

proc toId*(_: typedesc[CBossEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_BOSS_EVENT.toId(v)

proc writePacket*(p: CBossEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeUuid(w, p.uuid)
  case p.action.kind
  of baAdd:
    writeVarInt(w, newVarInt(0))
    tryWrite writeText(w, p.action.title)
    writeF32Be(w, p.action.health)
    writeVarInt(w, p.action.color)
    writeVarInt(w, p.action.division)
    writeU8(w, p.action.flags)
  of baRemove:
    writeVarInt(w, newVarInt(1))
  of baUpdateHealth:
    writeVarInt(w, newVarInt(2))
    writeF32Be(w, p.action.updatedHealth)
  of baUpdateTile:
    writeVarInt(w, newVarInt(3))
    tryWrite writeText(w, p.action.updatedTitle)
  of baUpdateStyle:
    writeVarInt(w, newVarInt(4))
    writeVarInt(w, p.action.styleColor)
    writeVarInt(w, p.action.dividers)
  of baUpdateFlags:
    writeVarInt(w, newVarInt(5))
    writeU8(w, p.action.updatedFlags)
  writeOkVoid()
