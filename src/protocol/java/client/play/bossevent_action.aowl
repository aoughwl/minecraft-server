## Port of pumpkin-protocol/src/java/client/play/bossevent_action.rs
import ../../../varint
import ../../../../util/text/text

type
  BosseventActionKind* = enum
    baAdd
    baRemove
    baUpdateHealth
    baUpdateTile  ## Upstream's spelling of the variant.
    baUpdateStyle
    baUpdateFlags

  BosseventAction* = object
    case kind*: BosseventActionKind
    of baAdd:
      title*: TextComponent
      health*: float32
      color*: VarInt
      division*: VarInt
      flags*: uint8
    of baRemove:
      discard
    of baUpdateHealth:
      updatedHealth*: float32
    of baUpdateTile:
      updatedTitle*: TextComponent
    of baUpdateStyle:
      styleColor*: VarInt
      dividers*: VarInt
    of baUpdateFlags:
      updatedFlags*: uint8
