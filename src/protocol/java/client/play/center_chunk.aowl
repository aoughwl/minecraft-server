## Port of pumpkin-protocol/src/java/client/play/center_chunk.rs
## Updates the center of the player's loaded chunk radius.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CCenterChunk* = object
    chunkX*: VarInt
    chunkZ*: VarInt

proc toId*(_: typedesc[CCenterChunk]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_CHUNK_CACHE_CENTER.toId(v)

proc writePacket*(p: CCenterChunk; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.chunkX)
  writeVarInt(w, p.chunkZ)
  writeOkVoid()
