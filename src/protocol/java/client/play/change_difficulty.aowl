## Port of pumpkin-protocol/src/java/client/play/change_difficulty.rs
## Notifies the client of a change in the world's difficulty or its lock.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CChangeDifficulty* = object
    difficulty*: uint8  ## 0 peaceful, 1 easy, 2 normal, 3 hard.
    locked*: bool

proc toId*(_: typedesc[CChangeDifficulty]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CHANGE_DIFFICULTY.toId(v)

proc writePacket*(p: CChangeDifficulty; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeU8(w, p.difficulty)
  writeBool(w, p.locked)
  writeOkVoid()
