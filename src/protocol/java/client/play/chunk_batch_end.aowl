## Port of pumpkin-protocol/src/java/client/play/chunk_batch_end.rs
## Notifies the client that the server has finished sending a batch of chunks.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CChunkBatchEnd* = object
    batchSize*: VarInt

proc newCChunkBatchEnd*(count: uint16): CChunkBatchEnd =
  CChunkBatchEnd(batchSize: newVarInt(int32(count)))

proc toId*(_: typedesc[CChunkBatchEnd]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CHUNK_BATCH_FINISHED.toId(v)

proc writePacket*(p: CChunkBatchEnd; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.batchSize)
  writeOkVoid()
