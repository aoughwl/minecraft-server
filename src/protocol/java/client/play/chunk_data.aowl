## Port of pumpkin-protocol/src/java/client/play/chunk_data.rs
## Provides the client with the full data for a chunk: heightmaps, block and biome sections, block entities and
## light.
##
## Not upstream: `remapBiomeForVersion`. Upstream writes the pinned tree's biome ids to every version, but a client
## reads them as positions in the biome registry it was sent, and 26.2's has one more biome than 1.21.11's, so
## from index 53 on they name the wrong biome or none at all. Every other id in this packet goes through a remap
## table; this one has none upstream, so it is built from the registries themselves.
##
## Also not upstream: a light section that is uniform but not zero (`Empty(15)`, what an absent `SkyLight` above the
## terrain reads as, see chunkformat.aowl) goes out as a filled array. Upstream's empty mask means zero to the client,
## which would show everything in those sections unlit.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../bitset
import ../../../../generated/block_state_remap, ../../../../generated/block_properties
import ../../../../nbt/tag
import ../../../../util/math/position
import ../../../../world/[chunkdata, palette]
import ../../../../generated/registry
from ../../../../world/blockstates import biomeCount, biomeNameById

type
  CChunkData* = object
    data*: ChunkData  ## Upstream's tuple field `.0`.

proc heightmapsToNbt(h: ChunkHeightmaps): NbtTag =
  ## Upstream's serde form: `rename_all = "UPPERCASE"`, long arrays, and `None` skipped.
  var c = newCompound()
  if h.worldSurface.len > 0:
    c.put("WORLD_SURFACE", NbtTag(kind: ntkLongArray, longArrayVal: h.worldSurface))
  if h.motionBlocking.len > 0:
    c.put("MOTION_BLOCKING", NbtTag(kind: ntkLongArray, longArrayVal: h.motionBlocking))
  if h.motionBlockingNoLeaves.len > 0:
    c.put("MOTION_BLOCKING_NO_LEAVES", NbtTag(kind: ntkLongArray, longArrayVal: h.motionBlockingNoLeaves))
  NbtTag(kind: ntkCompound, compoundVal: c)

proc writeHeightmap(w: var NetWriter; index: int32; data: seq[int64]) =
  writeVarInt(w, newVarInt(index))
  # `unwrap_or(&[0; 37])`
  if data.len == 0:
    writeVarInt(w, newVarInt(int32(HeightmapWords)))
    for i in 0 ..< HeightmapWords:
      writeI64Be(w, 0'i64)
  else:
    writeVarInt(w, newVarInt(int32(data.len)))
    for val in data:
      writeI64Be(w, val)

proc remapState(id: uint32; version: JavaMinecraftVersion): uint32 =
  uint32(remapBlockStateForVersion(uint16(id and 0xFFFF'u32), version))

proc remapForVersion(network: var NetworkSerialization; version: JavaMinecraftVersion) =
  case network.paletteKind
  of npSingle:
    network.value = remapState(network.value, version)
  of npIndirect:
    for i in 0 ..< network.values.len:
      network.values[i] = remapState(network.values[i], version)
  of npDirect:
    let bitsPerEntry = int(network.bitsPerEntry)
    let valuesPerI64 = 64 div bitsPerEntry
    let idMask = (1'u64 shl bitsPerEntry) - 1'u64

    for wordIndex in 0 ..< network.packedData.len:
      var remappedWord = 0'u64
      let packedWordU64 = cast[uint64](network.packedData[wordIndex])
      for index in 0 ..< valuesPerI64:
        let shift = index * bitsPerEntry
        let stateId = uint16((packedWordU64 shr shift) and idMask)
        let remappedId = remapBlockStateForVersion(stateId, version)
        remappedWord = remappedWord or (uint64(remappedId) shl shift)
      network.packedData[wordIndex] = cast[int64](remappedWord)

var biomeRemaps: seq[seq[uint8]] = @[]  ## By `ord(version)`, built when first asked for.

proc buildBiomeRemap(version: JavaMinecraftVersion): seq[uint8] =
  ## Position of each pinned biome in `version`'s registry. One the version lacks becomes plains.
  var names: seq[string] = @[]
  let tables = staticRegistries(version)
  for reg in tables:
    if reg.registryId == "worldgen/biome":
      for entry in reg.entries:
        names.add(entry.name)
  var plains = 0'u8
  for i in 0 ..< names.len:
    if names[i] == "plains":
      plains = uint8(i)
  result = newSeq[uint8](biomeCount())
  for id in 0 ..< biomeCount():
    result[id] = plains
    for i in 0 ..< names.len:
      if names[i] == biomeNameById(id)[1]:
        result[id] = uint8(i)
        break

proc remapBiomeForVersion*(id: uint32; version: JavaMinecraftVersion): uint32 =
  let v = ord(version)
  while biomeRemaps.len <= v:
    biomeRemaps.add(newSeq[uint8](0))
  if biomeRemaps[v].len == 0:
    biomeRemaps[v] = buildBiomeRemap(version)
  if int(id) < biomeRemaps[v].len:
    return uint32(biomeRemaps[v][int(id)])
  id

proc remapBiomesForVersion(network: var NetworkSerialization; version: JavaMinecraftVersion) =
  case network.paletteKind
  of npSingle:
    network.value = remapBiomeForVersion(network.value, version)
  of npIndirect:
    for i in 0 ..< network.values.len:
      network.values[i] = remapBiomeForVersion(network.values[i], version)
  of npDirect:
    let bitsPerEntry = int(network.bitsPerEntry)
    let valuesPerI64 = 64 div bitsPerEntry
    let idMask = (1'u64 shl bitsPerEntry) - 1'u64
    for wordIndex in 0 ..< network.packedData.len:
      var remappedWord = 0'u64
      let packedWordU64 = cast[uint64](network.packedData[wordIndex])
      for index in 0 ..< valuesPerI64:
        let shift = index * bitsPerEntry
        let biomeId = uint32((packedWordU64 shr shift) and idMask)
        let remappedId = remapBiomeForVersion(biomeId, version)
        remappedWord = remappedWord or (uint64(remappedId) shl shift)
      network.packedData[wordIndex] = cast[int64](remappedWord)

proc biomeNetworkFor(palette: BiomePalette; v: JavaMinecraftVersion): NetworkSerialization =
  result = biomeConvertNetwork(palette)
  if v < CURRENT_MC_VERSION:
    remapBiomesForVersion(result, v)

proc writeNetworkSerialization(buf: var NetWriter; network: NetworkSerialization; version: JavaMinecraftVersion) =
  writeU8(buf, network.bitsPerEntry)

  case network.paletteKind
  of npSingle:
    writeVarInt(buf, newVarInt(int32(network.value)))
  of npIndirect:
    writeVarInt(buf, newVarInt(int32(network.values.len)))
    for registryId in network.values:
      writeVarInt(buf, newVarInt(int32(registryId)))
  of npDirect:
    discard

  if version <= jmvV1_21_4:
    writeVarInt(buf, newVarInt(int32(network.packedData.len)))
  for packed in network.packedData:
    writeI64Be(buf, packed)

proc blockEntityTypeId(name: Option[string]): int32 =
  ## `nbt.get_string("id")`, past the last `:`, as a position in `BLOCK_ENTITY_TYPES`; 0 if anything is absent.
  if name.isNone:
    return 0'i32
  let idStr = name.unsafeGet
  var start = 0
  for i in 0 ..< idStr.len:
    if idStr[i] == ':':
      start = i + 1
  let short = idStr[start ..< idStr.len]
  for i in 0 ..< BLOCK_ENTITY_TYPES.len:
    if BLOCK_ENTITY_TYPES[i] == short:
      return int32(i)
  0'i32

proc lightHasData(l: LightContainer): bool {.inline.} =
  not l.isEmpty or l.default != 0'u8

proc writeLightArray(w: var NetWriter; l: LightContainer) =
  if l.isEmpty:
    let filled = (l.default shl 4) or l.default
    for i in 0 ..< LightArraySize:
      writeU8(w, filled)
  else:
    writeSlice(w, l.data)

proc toId*(_: typedesc[CChunkData]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_LEVEL_CHUNK_WITH_LIGHT.toId(v)

proc writePacket*(p: CChunkData; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  # Chunk X
  writeI32Be(w, p.data.x)
  # Chunk Z
  writeI32Be(w, p.data.z)

  if v <= jmvV1_21_4:
    tryWrite writeNbt(w, heightmapsToNbt(p.data.heightmap))
  else:
    writeVarInt(w, newVarInt(3))  # Map size
    writeHeightmap(w, 1, p.data.heightmap.worldSurface)
    writeHeightmap(w, 4, p.data.heightmap.motionBlocking)
    writeHeightmap(w, 5, p.data.heightmap.motionBlockingNoLeaves)

  block:
    var blocksAndBiomesBuf = newNetWriter()
    let sections = min(p.data.section.blockSections.len, p.data.section.biomeSections.len)
    for i in 0 ..< sections:
      let blockPalette = p.data.section.blockSections[i]
      let biomePalette = p.data.section.biomeSections[i]
      writeI16Be(blocksAndBiomesBuf, cast[int16](nonAirBlockCount(blockPalette)))
      if v >= jmvV26_1:
        # New in 26.1, fluid count
        writeI16Be(blocksAndBiomesBuf, cast[int16](liquidBlockCount(blockPalette)))

      var blockNetwork = blockConvertNetwork(blockPalette)
      if v < CURRENT_MC_VERSION:
        remapForVersion(blockNetwork, v)
      writeNetworkSerialization(blocksAndBiomesBuf, blockNetwork, v)

      writeNetworkSerialization(blocksAndBiomesBuf, biomeNetworkFor(biomePalette, v), v)

    writeVarInt(w, newVarInt(int32(blocksAndBiomesBuf.buf.len)))
    writeSlice(w, blocksAndBiomesBuf.buf)

  let blockEntities = p.data.pendingBlockEntities
  writeVarInt(w, newVarInt(int32(blockEntities.len)))
  for entry in blockEntities:
    let localXz = ((getLocalCord(entry.pos.x) and 0xF'i32) shl 4) or (getLocalCord(entry.pos.z) and 0xF'i32)

    writeU8(w, uint8(localXz))
    writeI16Be(w, cast[int16](entry.pos.y))

    writeVarInt(w, newVarInt(blockEntityTypeId(entry.nbt.getString("id"))))

    var clientNbt = entry.nbt
    discard clientNbt.remove("id")
    discard clientNbt.remove("x")
    discard clientNbt.remove("y")
    discard clientNbt.remove("z")
    tryWrite writeNbt(w, NbtTag(kind: ntkCompound, compoundVal: clientNbt))

  block:
    # Light masks include sections from -1 (below world) to num_sections (above world)
    # This means we need to account for 2 extra sections in the bitset
    let lightEngine = p.data.lightEngine
    let numSections = lightEngine.skyLight.len

    var skyLightEmptyMask = 0'u64
    var blockLightEmptyMask = 0'u64
    var skyLightMask = 0'u64
    var blockLightMask = 0'u64

    # Bit 0 represents the section below the world (always empty)
    skyLightEmptyMask = skyLightEmptyMask or (1'u64 shl 0)
    blockLightEmptyMask = blockLightEmptyMask or (1'u64 shl 0)

    # Bits 1..=num_sections represent the actual world sections
    for sectionIndex in 0 ..< numSections:
      let bitIndex = sectionIndex + 1  # Offset by 1 for the below-world section

      if lightHasData(lightEngine.skyLight[sectionIndex]):
        skyLightMask = skyLightMask or (1'u64 shl bitIndex)
      else:
        skyLightEmptyMask = skyLightEmptyMask or (1'u64 shl bitIndex)

      if lightHasData(lightEngine.blockLight[sectionIndex]):
        blockLightMask = blockLightMask or (1'u64 shl bitIndex)
      else:
        blockLightEmptyMask = blockLightEmptyMask or (1'u64 shl bitIndex)

    # Bit num_sections+1 represents the section above the world (always empty)
    skyLightEmptyMask = skyLightEmptyMask or (1'u64 shl (numSections + 1))
    blockLightEmptyMask = blockLightEmptyMask or (1'u64 shl (numSections + 1))

    # Write Sky Light Mask
    tryWrite writeBitset(w, fromU64(skyLightMask))
    # Write Block Light Mask
    tryWrite writeBitset(w, fromU64(blockLightMask))
    # Write Empty Sky Light Mask
    tryWrite writeBitset(w, fromU64(skyLightEmptyMask))
    # Write Empty Block Light Mask
    tryWrite writeBitset(w, fromU64(blockLightEmptyMask))

    let lightDataSize = newVarInt(int32(LightArraySize))

    # Write Sky Light arrays
    writeVarInt(w, newVarInt(int32(countOnes(fromU64(skyLightMask)))))
    for sectionIndex in 0 ..< numSections:
      if lightHasData(lightEngine.skyLight[sectionIndex]):
        writeVarInt(w, lightDataSize)
        writeLightArray(w, lightEngine.skyLight[sectionIndex])

    # Write Block Light arrays
    writeVarInt(w, newVarInt(int32(countOnes(fromU64(blockLightMask)))))
    for sectionIndex in 0 ..< numSections:
      if lightHasData(lightEngine.blockLight[sectionIndex]):
        writeVarInt(w, lightDataSize)
        writeLightArray(w, lightEngine.blockLight[sectionIndex])
  writeOkVoid()
