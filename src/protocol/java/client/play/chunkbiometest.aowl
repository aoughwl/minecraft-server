## Known answers for chunk_data.aowl's biome remap: positions in the 1.21.11 and 26.2 registries, from
## assets/registry/{1_21_11,26_2}_synced_registries.json in the pinned tree. And its non-upstream light case.
import std/assertions
import std/syncio
import ../../../../util/javaversion
import ../../../../world/[blockstates, chunkdata]
import ../../../netcodec
import chunk_data

proc idOf(name: string): uint32 =
  let (known, id) = biomeIdByName(name)
  assert known
  uint32(id)

# Below the biome 26.2 inserts, both agree.
assert remapBiomeForVersion(idOf("badlands"), jmvV1_21_11) == 0'u32
assert remapBiomeForVersion(idOf("plains"), jmvV1_21_11) == idOf("plains")
# Above it, 1.21.11 is one lower, and its last biome is 64 of 65.
assert idOf("wooded_badlands") == 65'u32
assert remapBiomeForVersion(idOf("wooded_badlands"), jmvV1_21_11) == 64'u32
assert remapBiomeForVersion(idOf("taiga"), jmvV1_21_11) == idOf("taiga") - 1'u32
# 26.2 is unchanged, and 26.1, which has 1.21.11's list, is remapped the same way.
assert remapBiomeForVersion(idOf("wooded_badlands"), jmvV26_2) == 65'u32
assert remapBiomeForVersion(idOf("wooded_badlands"), jmvV26_1) == 64'u32

# Uniform light that is not zero goes out as an array: an empty mask would mean zero to the client.
block:
  let c = newChunkData(0'i32, 0'i32, newChunkSections(1, -64'i32))
  c.lightEngine = ChunkLight(skyLight: @[newLightEmpty(15'u8)], blockLight: @[newLightEmpty(0'u8)])
  var w = newNetWriter()
  assert writePacket(CChunkData(data: c), w, jmvV1_21_11).isOk
  var expected: seq[byte] = @[]
  for b in [2'u8, 0'u8, 5'u8, 7'u8]:  # sky, block, empty sky, empty block
    expected.add(1'u8)
    for i in 0 ..< 7:
      expected.add(0'u8)
    expected.add(b)
  expected.add(1'u8)
  expected.add(0x80'u8)
  expected.add(0x10'u8)
  for i in 0 ..< 2048:
    expected.add(0xFF'u8)
  expected.add(0'u8)
  assert w.buf.len > expected.len
  assert w.buf[w.buf.len - expected.len ..< w.buf.len] == expected

echo "all chunk biome remap and light checks passed"
