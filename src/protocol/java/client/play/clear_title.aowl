## Port of pumpkin-protocol/src/java/client/play/clear_title.rs
## Removes any title or subtitle currently on the player's screen.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CClearTitle* = object
    reset*: bool  ## Also reset the title timings to their defaults.

proc toId*(_: typedesc[CClearTitle]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CLEAR_TITLES.toId(v)

proc writePacket*(p: CClearTitle; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.reset)
  writeOkVoid()
