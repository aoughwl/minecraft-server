## Port of pumpkin-protocol/src/java/client/play/close_container.rs
## Notifies the client that a container has been closed.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CCloseContainer* = object
    syncId*: VarInt

proc toId*(_: typedesc[CCloseContainer]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CONTAINER_CLOSE.toId(v)

proc writePacket*(p: CCloseContainer; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.syncId)
  writeOkVoid()
