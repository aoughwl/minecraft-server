## Port of pumpkin-protocol/src/java/client/play/combat_death.rs
## Notifies the client that a player has died.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  CCombatDeath* = object
    playerId*: VarInt
    message*: TextComponent

proc toId*(_: typedesc[CCombatDeath]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_COMBAT_KILL.toId(v)

proc writePacket*(p: CCombatDeath; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.playerId)
  tryWrite writeText(w, p.message)
  writeOkVoid()
