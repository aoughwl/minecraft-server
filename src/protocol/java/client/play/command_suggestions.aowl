## Port of pumpkin-protocol/src/java/client/play/command_suggestions.rs
## Sent to provide a list of tab-completion suggestions.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  CommandSuggestion* = object
    suggestion*: string
    tooltip*: Option[TextComponent]

  CCommandSuggestions* = object
    id*: VarInt     ## Must match the id in the client's request.
    start*: VarInt
    length*: VarInt
    matches*: seq[CommandSuggestion]

proc write*(self: CommandSuggestion; w: var NetWriter): ProtoWriteVoidResult =
  tryWrite writeString(w, self.suggestion)
  if self.tooltip.isSome:
    writeBool(w, true)
    tryWrite writeText(w, self.tooltip.unsafeGet)
  else:
    writeBool(w, false)
  writeOkVoid()

proc toId*(_: typedesc[CCommandSuggestions]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_COMMAND_SUGGESTIONS.toId(v)

proc writePacket*(p: CCommandSuggestions; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.id)
  writeVarInt(w, p.start)
  writeVarInt(w, p.length)
  writeVarInt(w, newVarInt(int32(p.matches.len)))
  for match in p.matches:
    tryWrite match.write(w)
  writeOkVoid()
