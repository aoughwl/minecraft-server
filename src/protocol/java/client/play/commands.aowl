## Port of pumpkin-protocol/src/java/client/play/commands.rs
## Sends the entire command tree to the client for client-side parsing and tab-completion.
##
## `ProtoNodeType` holds the fields of upstream's `Literal` and `Argument` variants flat, because a case
## object cannot repeat a field name across branches. `ArgumentType`'s kinds keep upstream's order, since the
## ordinal is the wire id, as Rust's `repr(u32)` discriminant is.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/identifier

const
  EntityFlagOnlySingle* = 1'u8          ## ArgumentType::ENTITY_FLAG_ONLY_SINGLE
  EntityFlagPlayersOnly* = 2'u8         ## ArgumentType::ENTITY_FLAG_PLAYERS_ONLY
  ScoreHolderFlagAllowMultiple* = 1'u8  ## ArgumentType::SCORE_HOLDER_FLAG_ALLOW_MULTIPLE

  FlagIsExecutable = 4'u8
  FlagHasRedirect = 8'u8
  FlagHasSuggestionType = 16'u8
  FlagIsRestricted = 32'u8

type
  StringProtoArgBehavior* = enum
    spSingleWord
    spQuotablePhrase
    spGreedyPhrase  ## Does not stop after a space.

  SuggestionProviders* = enum
    spAskServer
    spAllRecipes
    spAvailableSounds
    spSummonableEntities

  ArgumentTypeKind* = enum
    atBool
    atFloat
    atDouble
    atInteger
    atLong
    atString
    atEntity
    atGameProfile
    atBlockPos
    atColumnPos
    atVec3
    atVec2
    atBlockState
    atBlockPredicate
    atItemStack
    atItemPredicate
    atColor
    atHexColor
    atComponent
    atStyle
    atMessage
    atNbtCompound
    atNbtTag
    atNbtPath
    atObjective
    atObjectiveCriteria
    atOperation
    atParticle
    atAngle
    atRotation
    atScoreboardSlot
    atScoreHolder
    atSwizzle
    atTeam
    atItemSlot
    atItemSlots
    atResourceLocation
    atFunction
    atEntityAnchor
    atIntRange
    atFloatRange
    atDimension
    atGamemode
    atTime
    atResourceOrTag
    atResourceOrTagKey
    atResource
    atResourceKey
    atResourceSelector
    atTemplateMirror
    atTemplateRotation
    atHeightmap
    atLootTable
    atLootPredicate
    atLootModifier
    atDialog
    atUuid

  ArgumentType* = object
    case kind*: ArgumentTypeKind
    of atFloat:
      floatMin*: Option[float32]
      floatMax*: Option[float32]
    of atDouble:
      doubleMin*: Option[float64]
      doubleMax*: Option[float64]
    of atInteger:
      integerMin*: Option[int32]
      integerMax*: Option[int32]
    of atLong:
      longMin*: Option[int64]
      longMax*: Option[int64]
    of atString:
      behavior*: StringProtoArgBehavior
    of atEntity, atScoreHolder:
      flags*: uint8
    of atTime:
      min*: int32
    of atResourceOrTag, atResourceOrTagKey, atResource, atResourceKey:
      identifier*: Identifier
    else:
      discard

  ProtoNodeKind* = enum
    pnkRoot
    pnkLiteral
    pnkArgument

  ProtoNodeType* = object
    kind*: ProtoNodeKind
    name*: string                                         ## Literal and argument.
    isExecutable*: bool                                   ## Literal and argument.
    redirectTarget*: Option[int32]                        ## Literal and argument.
    restricted*: bool                                     ## Literal and argument.
    parser*: ArgumentType                                 ## Argument.
    overrideSuggestionType*: Option[SuggestionProviders]  ## Argument.

  ProtoNode* = object
    children*: seq[VarInt]
    nodeType*: ProtoNodeType

  CCommands* = object
    nodes*: seq[ProtoNode]  ## A flat list; nodes refer to each other by index here.
    rootNodeIndex*: VarInt

proc resourceLocation(self: SuggestionProviders): string =
  case self
  of spAskServer: "minecraft:ask_server"
  of spAllRecipes: "minecraft:all_recipes"
  of spAvailableSounds: "minecraft:available_sounds"
  of spSummonableEntities: "minecraft:summonable_entities"

proc toId*(self: ArgumentType; version: JavaMinecraftVersion): int32 =
  ## The numbers are upstream's. Its comments name 47 as ResourceSelector and 54 as Dialog, but by its own enum
  ## 47 is ResourceKey and 54 LootModifier (ResourceSelector is 48, Dialog 55). Kept as they are; this only
  ## touches versions before 1.21.6.
  let id = int32(ord(self.kind))
  if version < jmvV1_21_5:
    if id <= 16: id
    elif id >= 18 and id <= 46: id - 1
    elif id >= 48 and id <= 53: id - 2
    elif id >= 55: id - 3
    else: 5'i32  # 17 | 47 | 54
  elif version < jmvV1_21_6:
    if id <= 16: id
    elif id >= 18 and id <= 53: id - 1
    elif id >= 55: id - 2
    else: 5'i32  # 17 | 54
  else:
    id

proc writeNumberFlags(w: var NetWriter; hasMin, hasMax: bool) =
  var flags = 0'u8
  if hasMin:
    flags = flags or 1'u8
  if hasMax:
    flags = flags or 2'u8
  writeU8(w, flags)

proc writeWithIdentifier(extraIdentifier: Identifier; w: var NetWriter): ProtoWriteVoidResult =
  writeString(w, $extraIdentifier)

proc writeToBuffer*(self: ArgumentType; w: var NetWriter; version: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(self.toId(version)))
  case self.kind
  of atFloat:
    writeNumberFlags(w, self.floatMin.isSome, self.floatMax.isSome)
    if self.floatMin.isSome:
      writeF32Be(w, self.floatMin.unsafeGet)
    if self.floatMax.isSome:
      writeF32Be(w, self.floatMax.unsafeGet)
  of atDouble:
    writeNumberFlags(w, self.doubleMin.isSome, self.doubleMax.isSome)
    if self.doubleMin.isSome:
      writeF64Be(w, self.doubleMin.unsafeGet)
    if self.doubleMax.isSome:
      writeF64Be(w, self.doubleMax.unsafeGet)
  of atInteger:
    writeNumberFlags(w, self.integerMin.isSome, self.integerMax.isSome)
    if self.integerMin.isSome:
      writeI32Be(w, self.integerMin.unsafeGet)
    if self.integerMax.isSome:
      writeI32Be(w, self.integerMax.unsafeGet)
  of atLong:
    writeNumberFlags(w, self.longMin.isSome, self.longMax.isSome)
    if self.longMin.isSome:
      writeI64Be(w, self.longMin.unsafeGet)
    if self.longMax.isSome:
      writeI64Be(w, self.longMax.unsafeGet)
  of atString:
    let i =
      case self.behavior
      of spSingleWord: 0'i32
      of spQuotablePhrase: 1'i32
      of spGreedyPhrase: 2'i32
    writeVarInt(w, newVarInt(i))
  of atEntity, atScoreHolder:
    writeU8(w, self.flags)
  of atTime:
    writeI32Be(w, self.min)
  of atResourceOrTag, atResourceOrTagKey, atResource, atResourceKey:
    tryWrite writeWithIdentifier(self.identifier, w)
  else:
    discard
  writeOkVoid()

proc writeTo*(self: ProtoNode; w: var NetWriter; version: JavaMinecraftVersion): ProtoWriteVoidResult =
  # flags
  var redirectTargetOnFlag = 0'i32
  var flags = 0'u8
  case self.nodeType.kind
  of pnkRoot:
    flags = 0'u8
  of pnkLiteral:
    flags = 1'u8
    if self.nodeType.restricted:
      flags = flags or FlagIsRestricted
    if self.nodeType.isExecutable:
      flags = flags or FlagIsExecutable
    if self.nodeType.redirectTarget.isSome:
      flags = flags or FlagHasRedirect
      redirectTargetOnFlag = self.nodeType.redirectTarget.unsafeGet
  of pnkArgument:
    flags = 2'u8
    if self.nodeType.restricted:
      flags = flags or FlagIsRestricted
    if self.nodeType.overrideSuggestionType.isSome:
      flags = flags or FlagHasSuggestionType
    if self.nodeType.isExecutable:
      flags = flags or FlagIsExecutable
    if self.nodeType.redirectTarget.isSome:
      flags = flags or FlagHasRedirect
      redirectTargetOnFlag = self.nodeType.redirectTarget.unsafeGet
  writeU8(w, flags)

  # child count + children
  writeVarInt(w, newVarInt(int32(self.children.len)))
  for child in self.children:
    writeVarInt(w, child)

  # redirect node
  if (flags and FlagHasRedirect) != 0'u8:
    writeVarInt(w, newVarInt(redirectTargetOnFlag))

  # name
  if self.nodeType.kind != pnkRoot:
    tryWrite writeString(w, self.nodeType.name)

  # parser id + properties
  if self.nodeType.kind == pnkArgument:
    tryWrite self.nodeType.parser.writeToBuffer(w, version)

  # suggestion type: the flag is only set for an argument that has one, so upstream's two errors cannot occur.
  if (flags and FlagHasSuggestionType) != 0'u8:
    tryWrite writeString(w, self.nodeType.overrideSuggestionType.unsafeGet.resourceLocation())

  writeOkVoid()

proc toId*(_: typedesc[CCommands]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_COMMANDS.toId(v)

proc writePacket*(p: CCommands; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.nodes.len)))
  for node in p.nodes:
    tryWrite node.writeTo(w, v)
  writeVarInt(w, p.rootNodeIndex)
  writeOkVoid()

proc emptyCommandTree*(): CCommands =
  ## A lone root node, for a server with no command tree to send yet. Not upstream's.
  CCommands(nodes: @[ProtoNode(children: @[], nodeType: ProtoNodeType(kind: pnkRoot))], rootNodeIndex: newVarInt(0))
