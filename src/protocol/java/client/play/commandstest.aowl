## Test for commands.aowl, exact bytes for protocol 774, and the id gates.
import std/options
import playtestutil
import ../../../varint, ../../../protobase
import ../../../../util/javaversion
import ../../../../util/identifier
import commands

const V = jmvV1_21_11

proc arg(t: ArgumentType; v: JavaMinecraftVersion = V): seq[byte] =
  var w = newNetWriter()
  if not t.writeToBuffer(w, v).isOk:
    echo "FAIL write"
    quit(1)
  w.buf

let res = parseStatic("minecraft:ab")
const ResStr = "0c 6d696e6563726166743a6162"

eqHex(arg(ArgumentType(kind: atBool)), "00", "bool")
eqHex(arg(ArgumentType(kind: atFloat, floatMin: some(1.0'f32), floatMax: some(2.0'f32))), "01 03 3f800000 40000000", "float")
eqHex(arg(ArgumentType(kind: atDouble, doubleMin: none[float64](), doubleMax: some(1.0'f64))), "02 02 3ff0000000000000", "double")
eqHex(arg(ArgumentType(kind: atInteger, integerMin: some(1'i32), integerMax: none[int32]())), "03 01 00000001", "integer")
eqHex(arg(ArgumentType(kind: atLong, longMin: none[int64](), longMax: none[int64]())), "04 00", "long, no bounds")
eqHex(arg(ArgumentType(kind: atLong, longMin: some(1'i64), longMax: some(2'i64))), "04 03 0000000000000001 0000000000000002", "long")
eqHex(arg(ArgumentType(kind: atString, behavior: spGreedyPhrase)), "05 02", "string")
eqHex(arg(ArgumentType(kind: atEntity, flags: EntityFlagOnlySingle or EntityFlagPlayersOnly)), "06 03", "entity")
eqHex(arg(ArgumentType(kind: atHexColor)), "11", "hex color")
eqHex(arg(ArgumentType(kind: atScoreHolder, flags: ScoreHolderFlagAllowMultiple)), "1f 01", "score holder")
eqHex(arg(ArgumentType(kind: atTime, min: 1'i32)), "2b 00000001", "time")
eqHex(arg(ArgumentType(kind: atResourceOrTag, identifier: res)), "2c" & ResStr, "resource or tag")
eqHex(arg(ArgumentType(kind: atResourceOrTagKey, identifier: res)), "2d" & ResStr, "resource or tag key")
eqHex(arg(ArgumentType(kind: atResource, identifier: res)), "2e" & ResStr, "resource")
eqHex(arg(ArgumentType(kind: atResourceKey, identifier: res)), "2f" & ResStr, "resource key")
eqHex(arg(ArgumentType(kind: atUuid)), "38", "uuid")

# The gates, at upstream's numbers.
proc idOf(k: ArgumentTypeKind; v: JavaMinecraftVersion): int32 =
  case k
  of atHexColor: ArgumentType(kind: atHexColor).toId(v)
  of atComponent: ArgumentType(kind: atComponent).toId(v)
  of atResourceKey: ArgumentType(kind: atResourceKey, identifier: res).toId(v)
  of atLootModifier: ArgumentType(kind: atLootModifier).toId(v)
  of atUuid: ArgumentType(kind: atUuid).toId(v)
  else: ArgumentType(kind: atBool).toId(v)

proc same(got, want: int32; what: string) =
  if got != want:
    echo "FAIL ", what, ": got ", got, " want ", want
    quit(1)

same(idOf(atBool, jmvV1_21_4), 0'i32, "bool before 1.21.5")
same(idOf(atHexColor, jmvV1_21_4), 5'i32, "hex color before 1.21.5")
same(idOf(atComponent, jmvV1_21_4), 17'i32, "component before 1.21.5")
same(idOf(atResourceKey, jmvV1_21_4), 5'i32, "47 before 1.21.5")
same(idOf(atLootModifier, jmvV1_21_4), 5'i32, "54 before 1.21.5")
same(idOf(atUuid, jmvV1_21_4), 53'i32, "uuid before 1.21.5")
same(idOf(atHexColor, jmvV1_21_5), 5'i32, "hex color on 1.21.5")
same(idOf(atComponent, jmvV1_21_5), 17'i32, "component on 1.21.5")
same(idOf(atResourceKey, jmvV1_21_5), 46'i32, "47 on 1.21.5")
same(idOf(atLootModifier, jmvV1_21_5), 5'i32, "54 on 1.21.5")
same(idOf(atUuid, jmvV1_21_5), 54'i32, "uuid on 1.21.5")
same(idOf(atHexColor, jmvV1_21_6), 17'i32, "hex color on 1.21.6")
same(idOf(atUuid, V), 56'i32, "uuid on 774")

# The whole packet: a root, a literal with every flag, an argument with a suggestion type.
let packet = CCommands(nodes: @[
  ProtoNode(children: @[newVarInt(1)], nodeType: ProtoNodeType(kind: pnkRoot)),
  ProtoNode(children: @[newVarInt(2)], nodeType: ProtoNodeType(kind: pnkLiteral, name: "a", isExecutable: true,
    redirectTarget: some(5'i32), restricted: true)),
  ProtoNode(children: @[], nodeType: ProtoNodeType(kind: pnkArgument, name: "b", isExecutable: true,
    redirectTarget: none[int32](), restricted: false,
    parser: ArgumentType(kind: atInteger, integerMin: some(1'i32), integerMax: none[int32]()),
    overrideSuggestionType: some(spAskServer)))],
  rootNodeIndex: newVarInt(0))
var w = newNetWriter()
writeJavaPacketId(w, CCommands.toId(V))
if not writePacket(packet, w, V).isOk:
  echo "FAIL write"
  quit(1)
eqHex(w.buf, "10 03" &
  "00 01 01" &
  "2d 01 02 05 01 61" &
  "16 00 01 62 03 01 00000001 14 6d696e6563726166743a61736b5f736572766572" &
  "00", "commands")

echo "ok"
