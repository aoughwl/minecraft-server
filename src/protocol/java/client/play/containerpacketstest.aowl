{.feature: "untyped".}
## Test for the client/play packets about containers and item stacks: set_container_content,
## set_container_property, set_container_slot, set_cursor_slot, set_equipment, set_player_inventory.
## Exact bytes for protocol 774, with a stack's id remapped per version.
import std/assertions
import playtestutil
import ../../../protobase, ../../../varint, ../../../itemstackserializer, ../../../datacomponent
import ../../../../generated/item as itemdata
import ../../../../generated/item_id_remap
import ../../../../util/javaversion
import set_container_content, set_container_property, set_container_slot, set_cursor_slot, set_equipment,
  set_player_inventory

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

proc stack(count: uint8; id: uint16): ItemStackSerializer =
  ItemStackSerializer(stack: newItemStack(count, id, newSeq[PatchEntry]()))

let empty = ItemStackSerializer(stack: emptyItemStack())
let stone = stack(5'u8, 1'u16)  # 05 01 00 00: count, id, components added, components removed

block content:
  let p = CSetContainerContent(windowId: newVarInt(2), stateId: newVarInt(300),
    slotData: @[stone, empty], carriedItem: stack(1'u8, 2'u16))
  eqHex(full(CSetContainerContent, p, V), "12 02 ac02 02 05010000 00 01020000", "set_container_content")
  let none = CSetContainerContent(windowId: newVarInt(0), stateId: newVarInt(0), slotData: @[], carriedItem: empty)
  eqHex(full(CSetContainerContent, none, V), "12 00 00 00 00", "set_container_content, nothing")

block property:
  let p = CSetContainerProperty(windowId: newVarInt(2), property: 1'i16, value: -1'i16)
  eqHex(full(CSetContainerProperty, p, V), "13 02 0001 ffff", "set_container_property")

block slot:
  let p = CSetContainerSlot(windowId: -1'i8, stateId: newVarInt(300), slot: 258'i16, slotData: stone)
  eqHex(full(CSetContainerSlot, p, V), "14 ff ac02 0102 05010000", "set_container_slot")

block cursor:
  eqHex(full(CSetCursorItem, CSetCursorItem(stack: stone), V), "5e 05010000", "set_cursor_slot")
  eqHex(full(CSetCursorItem, CSetCursorItem(stack: empty), V), "5e 00", "set_cursor_slot, empty")

block equipment:
  # Every slot but the last has the top bit set.
  let p = CSetEquipment(entityId: newVarInt(9), equipment: @[(0'i8, stone), (1'i8, empty), (5'i8, stone)])
  eqHex(full(CSetEquipment, p, V), "64 09 80 05010000 81 00 05 05010000", "set_equipment")
  let one = CSetEquipment(entityId: newVarInt(9), equipment: @[(5'i8, empty)])
  eqHex(full(CSetEquipment, one, V), "64 09 05 00", "set_equipment, one slot")

block inventory:
  eqHex(full(CSetPlayerInventory, CSetPlayerInventory(slot: newVarInt(36), item: stone), V), "6a 24 05010000", "set_player_inventory")

block remap:
  # The id on the wire is the version's: find an item whose id differs.
  var id = -1
  for i in 0 ..< AllItems.len:
    if remapItemIdForVersion(uint16(i), V) != uint16(i):
      id = i
      break
  assert id >= 0
  var w = newNetWriter()
  assert writePacket(CSetCursorItem(stack: stack(1'u8, uint16(id))), w, V).isOk
  var r = newNetReader(w.buf)
  assert getVarInt(r).value.value == 1'i32
  assert getVarInt(r).value.value == int32(remapItemIdForVersion(uint16(id), V))
  assert getVarInt(r).value.value == 0'i32
  assert getVarInt(r).value.value == 0'i32

echo "ok"
