## Port of pumpkin-protocol/src/java/client/play/custom_payload.rs
## Custom communication between the server and client.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CCustomPayload* = object
    channel*: string
    data*: seq[byte]

proc toId*(_: typedesc[CCustomPayload]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CUSTOM_PAYLOAD.toId(v)

proc writePacket*(p: CCustomPayload; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.channel)
  writeSlice(w, p.data)
  writeOkVoid()
