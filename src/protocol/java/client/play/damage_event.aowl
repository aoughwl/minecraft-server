## Port of pumpkin-protocol/src/java/client/play/damage_event.rs
## Notifies the client that an entity has taken damage.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

type
  CDamageEvent* = object
    entityId*: VarInt
    sourceTypeId*: VarInt     ## An id in the `minecraft:damage_type` registry.
    sourceCauseId*: VarInt    ## 0 for none, otherwise the entity id plus one.
    sourceDirectId*: VarInt   ## 0 for none, otherwise the entity id plus one.
    sourcePosition*: Option[Vector3[float64]]

proc newCDamageEvent*(entityId, sourceTypeId: VarInt; sourceCauseId, sourceDirectId: Option[VarInt];
    sourcePosition: Option[Vector3[float64]]): CDamageEvent =
  let cause = if sourceCauseId.isSome: newVarInt(sourceCauseId.unsafeGet.value + 1) else: newVarInt(0)
  let direct = if sourceDirectId.isSome: newVarInt(sourceDirectId.unsafeGet.value + 1) else: newVarInt(0)
  CDamageEvent(entityId: entityId, sourceTypeId: sourceTypeId, sourceCauseId: cause, sourceDirectId: direct,
    sourcePosition: sourcePosition)

proc toId*(_: typedesc[CDamageEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_DAMAGE_EVENT.toId(v)

proc writePacket*(p: CDamageEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, p.sourceTypeId)
  writeVarInt(w, p.sourceCauseId)
  writeVarInt(w, p.sourceDirectId)
  if p.sourcePosition.isSome:
    let pos = p.sourcePosition.unsafeGet
    writeBool(w, true)
    writeF64(w, pos.x)
    writeF64(w, pos.y)
    writeF64(w, pos.z)
  else:
    writeBool(w, false)
  writeOkVoid()
