## Port of pumpkin-protocol/src/java/client/play/debug_sample.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CDebugSample* = object
    sample*: seq[int64]
    sampleType*: VarInt

proc toId*(_: typedesc[CDebugSample]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_DEBUG_SAMPLE.toId(v)

proc writePacket*(p: CDebugSample; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.sample.len)))
  for val in p.sample:
    writeI64Be(w, val)
  writeVarInt(w, p.sampleType)
  writeOkVoid()
