## Port of pumpkin-protocol/src/java/client/play/delete_chat.rs (newer tree: the pinned one has no delete-chat packet).
## `MessageSignature.Packed`: a cache id is written as `id + 1`, a full signature as VarInt 0 and its 256 bytes.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CDeleteChat* = object
    signatureId*: int32
    signature*: Option[seq[byte]]

proc cDeleteChatFromId*(signatureId: int32): CDeleteChat =
  CDeleteChat(signatureId: signatureId, signature: none[seq[byte]]())

proc cDeleteChatFromCacheId*(cacheId: int32): CDeleteChat =
  CDeleteChat(signatureId: cacheId + 1'i32, signature: none[seq[byte]]())

proc cDeleteChatFromSignature*(signature: seq[byte]): CDeleteChat =
  CDeleteChat(signatureId: 0'i32, signature: some(signature))

proc toId*(_: typedesc[CDeleteChat]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_DELETE_CHAT.toId(v)

proc writePacket*(p: CDeleteChat; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(p.signatureId))
  if p.signature.isSome:
    writeSlice(w, p.signature.unsafeGet)
  writeOkVoid()
