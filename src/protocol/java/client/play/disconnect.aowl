## Port of pumpkin-protocol/src/java/client/play/disconnect.rs
## Forces the client to disconnect from the server while in the play state.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  CPlayDisconnect* = object
    reason*: TextComponent

proc toId*(_: typedesc[CPlayDisconnect]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_DISCONNECT.toId(v)

proc writePacket*(p: CPlayDisconnect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.reason)
  writeOkVoid()
