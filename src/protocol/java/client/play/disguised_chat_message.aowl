## Port of pumpkin-protocol/src/java/client/play/disguised_chat_message.rs
## Sends a chat message that is not cryptographically signed by a player.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  CDisguisedChatMessage* = object
    message*: TextComponent
    chatType*: VarInt        ## An index into the `minecraft:chat_type` registry.
    senderName*: TextComponent
    targetName*: Option[TextComponent]

proc toId*(_: typedesc[CDisguisedChatMessage]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_DISGUISED_CHAT.toId(v)

proc writePacket*(p: CDisguisedChatMessage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.message)
  writeVarInt(w, p.chatType)
  tryWrite writeText(w, p.senderName)
  if p.targetName.isSome:
    writeBool(w, true)
    tryWrite writeText(w, p.targetName.unsafeGet)
  else:
    writeBool(w, false)
  writeOkVoid()
