## Port of pumpkin-protocol/src/java/client/play/display_objective.rs
## Displays a scoreboard objective in a given slot.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../generated/scoreboard_slot

type
  CDisplayObjective* = object
    position*: VarInt
    scoreName*: string  ## Empty to hide the objective in this slot.

proc newCDisplayObjective*(position: ScoreboardDisplaySlot; scoreName: string): CDisplayObjective =
  CDisplayObjective(position: newVarInt(int32(ord(position))), scoreName: scoreName)

proc toId*(_: typedesc[CDisplayObjective]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_DISPLAY_OBJECTIVE.toId(v)

proc writePacket*(p: CDisplayObjective; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.position)
  tryWrite writeString(w, p.scoreName)
  writeOkVoid()
