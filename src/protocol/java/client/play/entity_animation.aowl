## Port of pumpkin-protocol/src/java/client/play/entity_animation.rs
## Triggers an animation for an entity visible to the client.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  Animation* = enum
    anSwingMainArm = 0
    anLeaveBed = 2
    anSwingOffhand = 3
    anCriticalEffect = 4
    anMagicCriticaleffect = 5

  CEntityAnimation* = object
    entityId*: VarInt
    animation*: uint8

proc newCEntityAnimation*(entityId: VarInt; animation: Animation): CEntityAnimation =
  CEntityAnimation(entityId: entityId, animation: uint8(ord(animation)))

proc toId*(_: typedesc[CEntityAnimation]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_ANIMATE.toId(v)

proc writePacket*(p: CEntityAnimation; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeU8(w, p.animation)
  writeOkVoid()
