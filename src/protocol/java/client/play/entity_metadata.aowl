## Port of pumpkin-protocol/src/java/client/play/entity_metadata.rs
## Updates the data tracker values of an entity.
##
## Upstream's `Metadata<T: MetadataSerializer>` calls `write_metadata` on its value when it is written.
## aowlmony generics do not look up a proc on their type parameter, so `newMetadata` is a template, which does,
## and `Metadata` holds the bytes and the result of `writeMetadata`. An error is still reported by `write`, at
## the point upstream reports it. A new value type needs only its own `writeMetadata` overload.
{.feature: "untyped".}

import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer, ../../../optionalint
import ../../../../generated/meta_data_type, ../../../../generated/tracked_data
import ../../../../generated/block_state_remap, ../../../../generated/item_id_remap
import ../../../../util/math/position
import ../../../../util/text/text
import particle, playwire

type
  CSetEntityMetadata* = object
    entityId*: VarInt
    metadata*: seq[byte]  ## Serialized entries, ending with a terminal byte (0xFF).

  Metadata* = object
    index*: TrackedId
    typ*: MetaDataType            ## Upstream's `r#type`.
    value*: seq[byte]             ## What `writeMetadata` wrote for the value.
    valueResult*: ProtoWriteVoidResult

proc toId*(_: typedesc[CSetEntityMetadata]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_ENTITY_DATA.toId(v)

proc writePacket*(p: CSetEntityMetadata; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  # 1. Entity ID
  writeVarInt(w, p.entityId)
  writeSlice(w, p.metadata)
  writeOkVoid()

proc writeMetadata*(self: bool; w: var NetWriter): ProtoWriteVoidResult =
  writeBool(w, self)
  writeOkVoid()

proc writeMetadata*(self: int8; w: var NetWriter): ProtoWriteVoidResult =
  writeI8(w, self)
  writeOkVoid()

proc writeMetadata*(self: uint8; w: var NetWriter): ProtoWriteVoidResult =
  writeU8(w, self)
  writeOkVoid()

proc writeMetadata*(self: int16; w: var NetWriter): ProtoWriteVoidResult =
  writeI16(w, self)
  writeOkVoid()

proc writeMetadata*(self: uint16; w: var NetWriter): ProtoWriteVoidResult =
  writeU16(w, self)
  writeOkVoid()

proc writeMetadata*(self: int32; w: var NetWriter): ProtoWriteVoidResult =
  writeI32(w, self)
  writeOkVoid()

proc writeMetadata*(self: uint32; w: var NetWriter): ProtoWriteVoidResult =
  writeU32(w, self)
  writeOkVoid()

proc writeMetadata*(self: float32; w: var NetWriter): ProtoWriteVoidResult =
  writeF32(w, self)
  writeOkVoid()

proc writeMetadata*(self: VarInt; w: var NetWriter): ProtoWriteVoidResult =
  writeVarInt(w, self)
  writeOkVoid()

proc writeMetadata*(self: string; w: var NetWriter): ProtoWriteVoidResult =
  writeString(w, self)

proc writeMetadata*(self: TextComponent; w: var NetWriter): ProtoWriteVoidResult =
  writeText(w, self)

proc writeMetadata*(self: Option[TextComponent]; w: var NetWriter): ProtoWriteVoidResult =
  if self.isSome:
    writeBool(w, true)
    tryWrite writeText(w, self.unsafeGet)
  else:
    writeBool(w, false)
  writeOkVoid()

proc writeMetadata*(self: ItemStackSerializer; w: var NetWriter): ProtoWriteVoidResult =
  self.write(w)

proc writeMetadata*(self: Option[string]; w: var NetWriter): ProtoWriteVoidResult =
  if self.isSome:
    writeBool(w, true)
    tryWrite writeString(w, self.unsafeGet)
  else:
    writeBool(w, false)
  writeOkVoid()

proc writeMetadata*(self: BlockPos; w: var NetWriter): ProtoWriteVoidResult =
  writeBlockPos(w, self)
  writeOkVoid()

proc writeMetadata*(self: Option[BlockPos]; w: var NetWriter): ProtoWriteVoidResult =
  if self.isSome:
    writeBool(w, true)
    writeBlockPos(w, self.unsafeGet)
  else:
    writeBool(w, false)
  writeOkVoid()

proc writeMetadata*(self: OptionalInt; w: var NetWriter): ProtoWriteVoidResult =
  let val = if self.value.isSome: self.value.unsafeGet + 1'i32 else: 0'i32
  writeVarInt(w, newVarInt(val))
  writeOkVoid()

proc metadataOf*(index: TrackedId; typ: MetaDataType; value: sink seq[byte];
    valueResult: ProtoWriteVoidResult): Metadata =
  Metadata(index: index, typ: typ, value: value, valueResult: valueResult)

template newMetadata*(index, typ, val: untyped): Metadata =
  ## `Metadata::new`.
  block:
    var valueWriter = newNetWriter()
    let valueResult = writeMetadata(val, valueWriter)
    metadataOf(index, typ, valueWriter.buf, valueResult)

proc sameType(a, b: MetaDataType): bool =
  a.id(jmvV26_2) == b.id(jmvV26_2)

proc write*(self: Metadata; w: var NetWriter; version: JavaMinecraftVersion): ProtoWriteVoidResult =
  let resolvedIndex = self.index.get(version)

  if resolvedIndex == 255'u8:
    return writeOkVoid()

  let remappedTypeId = self.typ.id(version)
  if remappedTypeId < 0:
    # Metadata type does not exist in this protocol version.
    return writeOkVoid()

  writeU8(w, resolvedIndex)
  writeVarInt(w, newVarInt(remappedTypeId))

  tryWrite self.valueResult

  if sameType(self.typ, BLOCK_STATE):
    var pos = 0
    let decodedState = decodeJava(self.value, pos)
    if not decodedState.isOk:
      return writeErrVoid(messageWrite("Failed to decode block state metadata: " & decodedState.error.msg))
    let state = decodedState.value.value
    let remappedState =
      if state >= 0 and state <= 65535:
        int32(remapBlockStateForVersion(uint16(state), version))
      else:
        state
    writeVarInt(w, newVarInt(remappedState))
    return writeOkVoid()

  if sameType(self.typ, ITEM_STACK):
    var pos = 0
    let itemCount = decodeJava(self.value, pos)
    if not itemCount.isOk:
      return writeErrVoid(messageWrite("Failed to decodeitem stack count: " & itemCount.error.msg))

    if itemCount.value.value <= 0:
      writeVarInt(w, itemCount.value)
    else:
      let itemId = decodeJava(self.value, pos)
      if not itemId.isOk:
        return writeErrVoid(messageWrite("Failed to decode item id: " & itemId.error.msg))
      let id = itemId.value.value
      let remappedId =
        if id >= 0 and id <= 65535:
          remapItemIdForVersion(uint16(id), version)
        else:
          0'u16
      writeVarInt(w, itemCount.value)
      writeVarInt(w, newVarInt(int32(remappedId)))
      writeSlice(w, self.value.toOpenArray(pos, self.value.len - 1))
    return writeOkVoid()

  if sameType(self.typ, PARTICLE):
    var pos = 0
    let particleId = decodeJava(self.value, pos)
    if not particleId.isOk:
      return writeErrVoid(messageWrite("Failed to decode particle metadata: " & particleId.error.msg))
    writeVarInt(w, particleIdForVersion(particleId.value, version))
    writeSlice(w, self.value.toOpenArray(pos, self.value.len - 1))
    return writeOkVoid()

  writeSlice(w, self.value)
  writeOkVoid()
