{.feature: "untyped".}
## Test for entity_metadata.aowl, with upstream's particle vectors. Exact bytes for protocol 774.
import std/options
import playtestutil
import ../../../varint, ../../../protobase, ../../../optionalint, ../../../itemstackserializer, ../../../datacomponent
import ../../../../generated/meta_data_type, ../../../../generated/tracked_data
import ../../../../generated/particle as genparticle
import ../../../../util/javaversion
import ../../../../util/math/position
import ../../../../util/text/text
import entity_metadata

const V = jmvV1_21_11

type
  ParticleMetadata = object
    particleId: VarInt
    data: seq[byte]

proc writeMetadata(self: ParticleMetadata; w: var NetWriter): ProtoWriteVoidResult =
  writeVarInt(w, self.particleId)
  writeSlice(w, self.data)
  writeOkVoid()

proc encoded(m: Metadata; v: JavaMinecraftVersion): seq[byte] =
  var w = newNetWriter()
  if not m.write(w, v).isOk:
    echo "FAIL metadata write"
    quit(1)
  w.buf

# Index 10 and type 16 are the table's on 774.
let particleValue = ParticleMetadata(particleId: newVarInt(int32(ord(ptExplosionEmitter))), data: @[0x12'u8, 0x34, 0x56, 0x78])
let particleMeta = newMetadata(TrackedData_PARTICLE, PARTICLE, particleValue)
eqHex(encoded(particleMeta, V), "0a 10 16 12345678", "particle remaps for 1.21.11")
eqHex(encoded(particleMeta, jmvV26_2), "0a" & hexOf(@[uint8(PARTICLE.id(jmvV26_2))]) & "1d 12345678", "particle stays latest for 26.2")

# A slot this version does not have writes nothing.
eqHex(encoded(particleMeta, jmvV1_21), "", "index 255")
eqHex(encoded(newMetadata(TrackedData_PARTICLE, MetaDataType(v1_21_11: -1'i32), true), V), "", "type absent")

# Block state goes through the state table: 26.2's 1381 is 1181 on 774.
eqHex(encoded(newMetadata(TrackedData_PARTICLE, BLOCK_STATE, newVarInt(1381)), V), "0a 0e 9d09", "block state")
eqHex(encoded(newMetadata(TrackedData_PARTICLE, BLOCK_STATE, newVarInt(-1)), V), "0a 0e ffffffff0f", "block state out of range")

# Item stack goes through the item table, keeping what follows the id.
let oneItem = fromItemStack(newItemStack(2'u8, 1'u16, newSeq[PatchEntry](0)))
eqHex(encoded(newMetadata(TrackedData_PARTICLE, ITEM_STACK, oneItem), V), "0a 07 02 01 00 00", "item stack")
eqHex(encoded(newMetadata(TrackedData_PARTICLE, ITEM_STACK, fromItemStack(emptyItemStack())), V), "0a 07 00", "empty item stack")

# Anything else is the value as written.
eqHex(encoded(newMetadata(TrackedData_PARTICLE, BOOLEAN, true), V), "0a" & hexOf(@[uint8(BOOLEAN.id(V))]) & "01", "bool")

# Every serializer.
template ser(value: untyped): seq[byte] =
  block:
    var serWriter = newNetWriter()
    if not writeMetadata(value, serWriter).isOk:
      echo "FAIL serializer"
      quit(1)
    serWriter.buf

let pos = newBlockPos(1, 2, 3)
const HI = "0a 08 0004 74657874 0002 6869 00"
eqHex(ser(true), "01", "bool")
eqHex(ser(-1'i8), "ff", "i8")
eqHex(ser(2'u8), "02", "u8")
eqHex(ser(-2'i16), "fffe", "i16")
eqHex(ser(3'u16), "0003", "u16")
eqHex(ser(-2'i32), "fffffffe", "i32")
eqHex(ser(3'u32), "00000003", "u32")
eqHex(ser(1.0'f32), "3f800000", "f32")
eqHex(ser(newVarInt(300)), "ac02", "varint")
eqHex(ser("a"), "01 61", "string")
eqHex(ser(text("hi")), HI, "text")
eqHex(ser(some(text("hi"))), "01" & HI, "some text")
eqHex(ser(none[TextComponent]()), "00", "no text")
eqHex(ser(some("a")), "01 01 61", "some string")
eqHex(ser(none[string]()), "00", "no string")
eqHex(ser(pos), "0000004000003002", "block pos")
eqHex(ser(some(pos)), "01 0000004000003002", "some block pos")
eqHex(ser(none[BlockPos]()), "00", "no block pos")
eqHex(ser(OptionalInt(value: some(4'i32))), "05", "some int")
eqHex(ser(OptionalInt(value: none[int32]())), "00", "no int")
eqHex(ser(fromItemStack(newItemStack(2'u8, 3'u16, newSeq[PatchEntry](0)))), "02 03 00 00", "item stack")

# The packet.
var w = newNetWriter()
writeJavaPacketId(w, CSetEntityMetadata.toId(V))
if not writePacket(CSetEntityMetadata(entityId: newVarInt(1), metadata: @[0x0a'u8, 0xff]), w, V).isOk:
  echo "FAIL packet"
  quit(1)
eqHex(w.buf, "61 01 0a ff", "set entity metadata")

echo "ok"
