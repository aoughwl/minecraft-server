## Port of pumpkin-protocol/src/java/client/play/entity_position_sync.rs
## Updates the exact position, rotation and velocity of an entity. Not for the player receiving it or
## anything that player rides.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

type
  CEntityPositionSync* = object
    entityId*: VarInt
    position*: Vector3[float64]
    delta*: Vector3[float64]
    yaw*: float32
    pitch*: float32
    onGround*: bool

proc toId*(_: typedesc[CEntityPositionSync]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_ENTITY_POSITION_SYNC.toId(v)

proc writePacket*(p: CEntityPositionSync; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeF64(w, p.position.x)
  writeF64(w, p.position.y)
  writeF64(w, p.position.z)
  writeF64(w, p.delta.x)
  writeF64(w, p.delta.y)
  writeF64(w, p.delta.z)
  writeF32(w, p.yaw)
  writeF32(w, p.pitch)
  writeBool(w, p.onGround)
  writeOkVoid()
