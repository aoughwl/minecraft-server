## Port of pumpkin-protocol/src/java/client/play/entity_sound_effect.rs
## Plays a sound effect that originates from an entity and follows it.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../generated/sound_category, ../../../../generated/sound_id_remap

type
  CEntitySoundEffect* = object
    soundEvent*: IdOr[SoundEvent]
    soundCategory*: VarInt
    entityId*: VarInt
    volume*: float32
    pitch*: float32
    seed*: int64

proc newCEntitySoundEffect*(soundEvent: IdOr[SoundEvent]; soundCategory: SoundCategory; entityId: VarInt;
    volume, pitch: float32; seed: int64): CEntitySoundEffect =
  CEntitySoundEffect(soundEvent: soundEvent, soundCategory: newVarInt(int32(ord(soundCategory))),
    entityId: entityId, volume: volume, pitch: pitch, seed: seed)

proc toId*(_: typedesc[CEntitySoundEffect]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SOUND_ENTITY.toId(v)

proc writePacket*(p: CEntitySoundEffect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  case p.soundEvent.kind
  of iokId:
    writeVarInt(w, newVarInt(int32(remapSoundIdForVersion(p.soundEvent.id, v)) + 1))
  of iokValue:
    writeVarInt(w, newVarInt(0))
    tryWrite writeSoundEvent(w, p.soundEvent.value)
  writeVarInt(w, p.soundCategory)
  writeVarInt(w, p.entityId)
  writeF32(w, p.volume)
  writeF32(w, p.pitch)
  writeI64(w, p.seed)
  writeOkVoid()
