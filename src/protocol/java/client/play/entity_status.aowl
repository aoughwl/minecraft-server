## Port of pumpkin-protocol/src/java/client/play/entity_status.rs
## Sends a status update for an entity, such as a tool breaking or a totem being used.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CEntityStatus* = object
    entityId*: int32
    entityStatus*: int8

proc toId*(_: typedesc[CEntityStatus]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_ENTITY_EVENT.toId(v)

proc writePacket*(p: CEntityStatus; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.entityId)
  writeI8(w, p.entityStatus)
  writeOkVoid()
