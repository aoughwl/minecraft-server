## Port of pumpkin-protocol/src/java/client/play/entity_velocity.rs
## Updates the velocity of an entity.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../lpvector3d
import ../../../../util/vector3

type
  CEntityVelocity* = object
    entityId*: VarInt
    velocity*: LpVector3d

proc newCEntityVelocity*(entityId: VarInt; velocity: Vector3[float64]): CEntityVelocity =
  CEntityVelocity(entityId: entityId, velocity: LpVector3d(value: velocity))

proc toId*(_: typedesc[CEntityVelocity]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_ENTITY_MOTION.toId(v)

proc writePacket*(p: CEntityVelocity; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  # Protocol 773+ uses packed velocity; 772 and below use three i16 components.
  if v >= jmvV1_21_9:
    p.velocity.write(w)
  else:
    p.velocity.writeLegacy(w)
  writeOkVoid()
