{.feature: "untyped".}
## Test for the client/play packets about entities: spawn_entity, remove_entities, remove_mob_effect,
## update_mob_effect, set_entity_link, set_passengers, take_item, teleport_entity, update_attributes,
## update_entity_pos, update_entity_pos_rot, update_entity_rot. Exact bytes for protocol 774, plus upstream's
## own spawn_entity #[test]s.
import std/assertions
import playtestutil
import ../../../protobase, ../../../varint, ../../../lpvector3d
import ../../../proto except Property
import ../../../../generated/block_state_remap
import ../../../../generated/entity_type
import ../../../../util/javaversion
import ../../../../util/uuid
import ../../../../util/vector3
import spawn_entity, remove_entities, remove_mob_effect, update_mob_effect, set_entity_link, set_passengers,
  take_item, teleport_entity, update_attributes, update_entity_pos, update_entity_pos_rot, update_entity_rot

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

proc encodeSpawn(version: JavaMinecraftVersion): seq[byte] =
  let velocity = Vector3[float64](x: 0.5, y: -0.5, z: 0.25)
  let p = newCSpawnEntity(newVarInt(1), NilUuid, newVarInt(1), Vector3[float64](x: 1.0, y: 2.0, z: 3.0),
    0.0'f32, 90.0'f32, 90.0'f32, newVarInt(42), velocity)
  var w = newNetWriter()
  assert writePacket(p, w, version).isOk
  w.buf

proc legacyTail(velocity: Vector3[float64]): seq[byte] =
  var w = newNetWriter()
  LpVector3d(value: velocity).writeLegacy(w)
  w.buf

proc endsWith(a, b: seq[byte]): bool =
  a.len >= b.len and a[a.len - b.len .. ^1] == b

const SpawnHead = "01 00000000000000000000000000000000 01 3ff0000000000000 4000000000000000 4008000000000000"

block spawnExact:
  eqHex(encodeSpawn(V), SpawnHead & "f9ff 9ffe8002 00 40 40 2a", "spawn_entity 774")
  eqHex(encodeSpawn(jmvV1_21_7), SpawnHead & "00 40 40 2a 0fa0 f060 07d0", "spawn_entity below 1.21.9")
  assert CSpawnEntity.toId(V) == 1'i32

block spawnEntityUsesLegacyVelocityTailFor1_21_8:
  # V_1_21_7 enum variant represents protocol 772 (used by 1.21.7 and 1.21.8).
  let tail = legacyTail(Vector3[float64](x: 0.5, y: -0.5, z: 0.25))
  assert endsWith(encodeSpawn(jmvV1_21_7), tail)

block spawnEntityDoesNotUseLegacyVelocityTailFor1_21_9:
  let tail = legacyTail(Vector3[float64](x: 0.5, y: -0.5, z: 0.25))
  assert not endsWith(encodeSpawn(jmvV1_21_9), tail)

block spawnAngles:
  template spawn(pitch, yaw, head: float32): CSpawnEntity =
    newCSpawnEntity(newVarInt(1), NilUuid, newVarInt(1), Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
      pitch, yaw, head, newVarInt(0), Vector3[float64](x: 0.0, y: 0.0, z: 0.0))
  # yaw wraps through rem_euclid; pitch does not, so `as u8` saturates a negative one to 0.
  assert spawn(45.0'f32, 90.0'f32, -90.0'f32).pitch == 32'u8
  assert spawn(45.0'f32, 90.0'f32, -90.0'f32).yaw == 64'u8
  assert spawn(45.0'f32, 90.0'f32, -90.0'f32).headYaw == 192'u8
  assert spawn(-45.0'f32, 720.0'f32, 359.0'f32).pitch == 0'u8
  assert spawn(-45.0'f32, 720.0'f32, 359.0'f32).yaw == 0'u8
  assert spawn(-45.0'f32, 720.0'f32, 359.0'f32).headYaw == 255'u8
  assert spawn(720.0'f32, 0.0'f32, 0.0'f32).pitch == 255'u8

block fallingBlockData:
  # A falling block's data is a block state, which is remapped. Nothing else's is.
  var state = -1
  for s in 0 .. 65535:
    if remapBlockStateForVersion(uint16(s), jmvV1_21_2) != uint16(s):
      state = s
      break
  assert state >= 0
  template dataOf(entityType: int32; data: int32): int32 =
    block:
      let p = newCSpawnEntity(newVarInt(1), NilUuid, newVarInt(entityType), Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
        0.0'f32, 0.0'f32, 0.0'f32, newVarInt(data), Vector3[float64](x: 0.0, y: 0.0, z: 0.0))
      var w = newNetWriter()
      assert writePacket(p, w, jmvV1_21_2).isOk
      # After the packed velocity's single zero byte comes the three angles, then the data.
      var r = newNetReader(w.buf)
      assert getVarInt(r).isOk
      assert getU64Be(r).isOk and getU64Be(r).isOk
      assert getVarInt(r).isOk
      assert getF64Be(r).isOk and getF64Be(r).isOk and getF64Be(r).isOk
      assert getU8(r).isOk and getU8(r).isOk and getU8(r).isOk
      let res = getVarInt(r)
      assert res.isOk
      res.value.value
  let falling = int32(EntityType.FALLING_BLOCK.id)
  assert dataOf(falling, int32(state)) == int32(remapBlockStateForVersion(uint16(state), jmvV1_21_2))
  assert dataOf(falling, -5'i32) == -5'i32
  assert dataOf(falling + 1, int32(state)) == int32(state)

block lists:
  eqHex(full(CRemoveEntities, CRemoveEntities(entityIds: @[newVarInt(1), newVarInt(300)]), V), "4b 02 01 ac02", "remove_entities")
  eqHex(full(CSetPassengers, CSetPassengers(entityId: newVarInt(9), passengers: @[newVarInt(1), newVarInt(300)]), V),
    "69 09 02 01 ac02", "set_passengers")

block effects:
  eqHex(full(CRemoveMobEffect, CRemoveMobEffect(entityId: newVarInt(9), effectId: newVarInt(3)), V), "4c 09 03", "remove_mob_effect")
  let p = CUpdateMobEffect(entityId: newVarInt(9), effectId: newVarInt(3), amplifier: newVarInt(1),
    duration: newVarInt(300), flags: -1'i8)
  eqHex(full(CUpdateMobEffect, p, V), "8201 09 03 01 ac02 ff", "update_mob_effect")

block links:
  eqHex(full(CSetEntityLink, CSetEntityLink(attachedEntityId: 1'i32, holdingEntityId: -1'i32), V),
    "62 00000001 ffffffff", "set_entity_link")
  eqHex(full(CTakeItemEntity, CTakeItemEntity(entityId: newVarInt(1), collectorEntityId: newVarInt(2), stackAmount: newVarInt(3)), V),
    "7a 01 02 03", "take_item")

block teleport:
  let p = CTeleportEntity(entityId: newVarInt(300),
    position: Vector3[float64](x: 1.0, y: 2.0, z: 3.0),
    delta: Vector3[float64](x: 0.5, y: -0.5, z: 0.0),
    yaw: 1.0'f32, pitch: 2.0'f32, relatives: @[pfY, pfDeltaX], onGround: true)
  eqHex(full(CTeleportEntity, p, V), "7b ac02 3ff0000000000000 4000000000000000 4008000000000000 " &
    "3fe0000000000000 bfe0000000000000 0000000000000000 3f800000 40000000 00000022 01", "teleport_entity")

block attributes:
  let p = CUpdateAttributes(entityId: newVarInt(1), properties: @[
    Property(id: newVarInt(5), value: 2.0, modifiers: @[
      AttributeModifier(id: "a:b", amount: 0.5, operation: 2'i8)]),
    Property(id: newVarInt(6), value: 1.0, modifiers: @[])])
  eqHex(full(CUpdateAttributes, p, V),
    "8101 01 02 05 4000000000000000 01 03 613a62 3fe0000000000000 02 06 3ff0000000000000 00", "update_attributes")

block moves:
  let delta = Vector3[int16](x: 1'i16, y: -1'i16, z: 256'i16)
  eqHex(full(CUpdateEntityPos, CUpdateEntityPos(entityId: newVarInt(1), delta: delta, onGround: true), V),
    "33 01 0001 ffff 0100 01", "update_entity_pos")
  eqHex(full(CUpdateEntityPosRot, CUpdateEntityPosRot(entityId: newVarInt(1), delta: delta, yaw: 2'u8, pitch: 3'u8, onGround: false), V),
    "34 01 0001 ffff 0100 02 03 00", "update_entity_pos_rot")
  eqHex(full(CUpdateEntityRot, CUpdateEntityRot(entityId: newVarInt(1), yaw: 2'u8, pitch: 3'u8, onGround: true), V),
    "36 01 02 03 01", "update_entity_rot")

echo "ok"
