## Port of pumpkin-protocol/src/java/client/play/explode.rs
## Notifies the client that an explosion has occurred: particles, sound and knockback in one packet.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../util/vector3
import particle
import ../../../../generated/sound_id_remap

type
  CExplosion* = object
    center*: Vector3[float64]
    radius*: float32
    blockCount*: int32
    knockback*: Option[Vector3[float64]]
    particle*: VarInt
    sound*: IdOr[SoundEvent]
    blockParticlesPoolSize*: VarInt

proc newCExplosion*(center: Vector3[float64]; radius: float32; blockCount: int32;
    knockback: Option[Vector3[float64]]; particle: VarInt; sound: IdOr[SoundEvent]): CExplosion =
  CExplosion(center: center, radius: radius, blockCount: blockCount, knockback: knockback, particle: particle,
    sound: sound, blockParticlesPoolSize: newVarInt(0))

proc toId*(_: typedesc[CExplosion]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_EXPLODE.toId(v)

proc writePacket*(p: CExplosion; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeF64Be(w, p.center.x)
  writeF64Be(w, p.center.y)
  writeF64Be(w, p.center.z)
  writeF32Be(w, p.radius)
  writeI32Be(w, p.blockCount)
  if p.knockback.isSome:
    let k = p.knockback.unsafeGet
    writeBool(w, true)
    writeF64Be(w, k.x)
    writeF64Be(w, k.y)
    writeF64Be(w, k.z)
  else:
    writeBool(w, false)
  writeVarInt(w, particleIdForVersion(p.particle, v))
  case p.sound.kind
  of iokId:
    # Upstream forgot the sound remap here (particle is remapped, sound is not): fixed, as SoundEffect does.
    writeVarInt(w, newVarInt(int32(remapSoundIdForVersion(p.sound.id, v)) + 1))
  of iokValue:
    writeVarInt(w, newVarInt(0))
    tryWrite writeSoundEvent(w, p.sound.value)
  writeVarInt(w, p.blockParticlesPoolSize)
  writeOkVoid()
