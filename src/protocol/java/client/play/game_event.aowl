## Port of pumpkin-protocol/src/java/client/play/game_event.rs
## Updates the game state or triggers an environmental change, such as weather or a gamemode switch.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  GameEvent* = enum
    geNoRespawnBlockAvailable
    geBeginRaining
    geEndRaining
    geChangeGameMode
    geWinGame
    geDemoEvent
    geArrowHitPlayer
    geRainLevelChange
    geThunderLevelChange
    gePlayPufferfishStringSound
    gePlayElderGuardianMobAppearance
    geEnabledRespawnScreen
    geLimitedCrafting
    geStartWaitingChunks

  CGameEvent* = object
    event*: uint8
    value*: float32

proc newCGameEvent*(event: GameEvent; value: float32): CGameEvent =
  CGameEvent(event: uint8(ord(event)), value: value)

proc toId*(_: typedesc[CGameEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_GAME_EVENT.toId(v)

proc writePacket*(p: CGameEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeU8(w, p.event)
  writeF32Be(w, p.value)
  writeOkVoid()
