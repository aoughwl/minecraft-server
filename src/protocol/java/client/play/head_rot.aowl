## Port of pumpkin-protocol/src/java/client/play/head_rot.rs
## Rotates an entity's head to a yaw.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CHeadRot* = object
    entityId*: VarInt
    headYaw*: uint8    ## In steps of 1/256 of a full turn.

proc toId*(_: typedesc[CHeadRot]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_ROTATE_HEAD.toId(v)

proc writePacket*(p: CHeadRot; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeU8(w, p.headYaw)
  writeOkVoid()
