## Port of pumpkin-protocol/src/java/client/play/hurt_animation.rs
## Triggers the hurt visual effect on an entity.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CHurtAnimation* = object
    entityId*: VarInt
    yaw*: float32

proc toId*(_: typedesc[CHurtAnimation]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_HURT_ANIMATION.toId(v)

proc writePacket*(p: CHurtAnimation; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeF32Be(w, p.yaw)
  writeOkVoid()
