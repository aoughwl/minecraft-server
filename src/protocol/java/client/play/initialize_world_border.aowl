## Port of pumpkin-protocol/src/java/client/play/initialize_world_border.rs
## Fully initializes the world border for the client.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CInitializeWorldBorder* = object
    x*: float64
    z*: float64
    oldDiameter*: float64
    newDiameter*: float64
    speed*: VarLong                 ## Milliseconds to reach `newDiameter`.
    portalTeleportBoundary*: VarInt
    warningBlocks*: VarInt
    warningTime*: VarInt

proc toId*(_: typedesc[CInitializeWorldBorder]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_INITIALIZE_BORDER.toId(v)

proc writePacket*(p: CInitializeWorldBorder; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeF64Be(w, p.x)
  writeF64Be(w, p.z)
  writeF64Be(w, p.oldDiameter)
  writeF64Be(w, p.newDiameter)
  writeVarLong(w, p.speed)
  writeVarInt(w, p.portalTeleportBoundary)
  writeVarInt(w, p.warningBlocks)
  writeVarInt(w, p.warningTime)
  writeOkVoid()
