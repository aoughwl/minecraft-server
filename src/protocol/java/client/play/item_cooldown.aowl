## Port of pumpkin-protocol/src/java/client/play/item_cooldown.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CItemCooldown* = object
    group*: string
    cooldown*: VarInt

proc toId*(_: typedesc[CItemCooldown]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_COOLDOWN.toId(v)

proc writePacket*(p: CItemCooldown; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.group)
  writeVarInt(w, p.cooldown)
  writeOkVoid()
