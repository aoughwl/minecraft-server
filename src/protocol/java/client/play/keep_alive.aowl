## Port of pumpkin-protocol/src/java/client/play/keep_alive.rs
## Maintains the connection and measures latency. The client must answer with the same id.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CKeepAlive* = object
    keepAliveId*: int64

proc toId*(_: typedesc[CKeepAlive]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_KEEP_ALIVE.toId(v)

proc writePacket*(p: CKeepAlive; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.keepAliveId)
  writeOkVoid()
