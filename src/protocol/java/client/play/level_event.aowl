## Port of pumpkin-protocol/src/java/client/play/level_event.rs
## Triggers a sound or particle effect at a world location.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../generated/block_state_remap, ../../../../generated/world_event
import ../../../../util/math/position
import playwire

type
  CLevelEvent* = object
    event*: int32
    location*: BlockPos
    data*: int32
    disableRelativeVolume*: bool

proc toId*(_: typedesc[CLevelEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_LEVEL_EVENT.toId(v)

proc writePacket*(p: CLevelEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.event)
  writeBlockPos(w, p.location)

  let data =
    if p.event == int32(ord(weParticlesDestroyBlock)) and p.data >= 0 and p.data <= 65535:
      int32(remapBlockStateForVersion(uint16(p.data), v))
    else:
      p.data
  writeI32Be(w, data)
  writeBool(w, p.disableRelativeVolume)
  writeOkVoid()
