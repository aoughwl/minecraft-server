## Port of pumpkin-protocol/src/java/client/play/login.rs
## The join game packet, which moves the client from configuration to play.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/resource_location
import player_spawn_data

type
  CLogin* = object
    entityId*: int32
    isHardcore*: bool
    dimensionNames*: seq[ResourceLocation]
    maxPlayers*: VarInt
    viewDistance*: VarInt
    simulatedDistance*: VarInt
    reducedDebugInfo*: bool
    enabledRespawnScreen*: bool
    limitedCrafting*: bool
    spawnData*: PlayerSpawnData
    onlineMode*: bool
    enforceSecureChat*: bool

proc toId*(_: typedesc[CLogin]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_LOGIN.toId(v)

proc writePacket*(p: CLogin; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.entityId)
  writeBool(w, p.isHardcore)
  if v >= jmvV1_16:
    writeVarInt(w, newVarInt(int32(p.dimensionNames.len)))
    for dim in p.dimensionNames:
      tryWrite writeString(w, dim)
  if v >= jmvV1_16:
    writeVarInt(w, p.maxPlayers)
  else:
    writeU8(w, cast[uint8](p.maxPlayers.value))
  if v >= jmvV1_14:
    writeVarInt(w, p.viewDistance)
  if v >= jmvV1_18:
    writeVarInt(w, p.simulatedDistance)
  if v >= jmvV1_8:
    writeBool(w, p.reducedDebugInfo)
  if v >= jmvV1_15:
    writeBool(w, p.enabledRespawnScreen)
  if v >= jmvV1_19_3:
    writeBool(w, p.limitedCrafting)
  tryWrite p.spawnData.writePacket(w, v)
  if v >= jmvV26_2:
    writeBool(w, p.onlineMode)
  if v >= jmvV1_19_1:
    writeBool(w, p.enforceSecureChat)
  writeOkVoid()
