## Port of pumpkin-protocol/src/java/client/play/map_item_data.rs
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  MapIcon* = object
    iconType*: VarInt
    x*: int8
    z*: int8
    direction*: int8
    displayName*: Option[string]

  MapPatch* = object
    columns*: uint8
    rows*: uint8
    x*: int8
    z*: int8
    data*: seq[byte]

  CMapItemData* = object
    mapId*: VarInt
    scale*: int8
    locked*: bool
    icons*: Option[seq[MapIcon]]
    data*: Option[MapPatch]

proc toId*(_: typedesc[CMapItemData]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_MAP_ITEM_DATA.toId(v)

proc writePacket*(p: CMapItemData; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.mapId)
  writeI8(w, p.scale)
  writeBool(w, p.locked)

  if p.icons.isSome:
    let icons = p.icons.unsafeGet
    writeBool(w, true)
    writeVarInt(w, newVarInt(int32(icons.len)))
    for icon in icons:
      writeVarInt(w, icon.iconType)
      writeI8(w, icon.x)
      writeI8(w, icon.z)
      writeI8(w, icon.direction)
      if icon.displayName.isSome:
        writeBool(w, true)
        # Upstream's `format!`, which does not escape the name.
        tryWrite writeString(w, "{\"text\":\"" & icon.displayName.unsafeGet & "\"}")
      else:
        writeBool(w, false)
  else:
    writeBool(w, false)

  if p.data.isSome:
    let patch = p.data.unsafeGet
    writeU8(w, patch.columns)
    if patch.columns > 0'u8:
      writeU8(w, patch.rows)
      writeI8(w, patch.x)
      writeI8(w, patch.z)
      writeVarInt(w, newVarInt(int32(patch.data.len)))
      writeSlice(w, patch.data)
  else:
    writeU8(w, 0'u8)

  writeOkVoid()
