## Port of pumpkin-protocol/src/java/client/play/merchant_offers.rs
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  MerchantOffer* = object
    baseCostA*: ItemStackSerializer  ## TODO upstream: item cost.
    output*: ItemStackSerializer
    costB*: Option[ItemStackSerializer]  ## TODO upstream: item cost.
    isDisabled*: bool
    uses*: int32
    maxUses*: int32
    xp*: int32
    specialPrice*: int32
    priceMultiplier*: float32
    demand*: int32

  CMerchantOffers* = object
    windowId*: VarInt
    offers*: seq[MerchantOffer]
    villagerLevel*: VarInt
    experience*: VarInt
    isRegularVillager*: bool
    canRestock*: bool

proc write(self: MerchantOffer; w: var NetWriter; version: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite self.baseCostA.writeWithVersion(w, version)
  tryWrite self.output.writeWithVersion(w, version)
  if self.costB.isSome:
    writeBool(w, true)
    tryWrite self.costB.unsafeGet.writeWithVersion(w, version)
  else:
    writeBool(w, false)
  writeBool(w, self.isDisabled)
  writeI32Be(w, self.uses)
  writeI32Be(w, self.maxUses)
  writeI32Be(w, self.xp)
  writeI32Be(w, self.specialPrice)
  writeF32Be(w, self.priceMultiplier)
  writeI32Be(w, self.demand)
  writeOkVoid()

proc toId*(_: typedesc[CMerchantOffers]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_MERCHANT_OFFERS.toId(v)

proc writePacket*(p: CMerchantOffers; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.windowId)
  writeVarInt(w, newVarInt(int32(p.offers.len)))
  for offer in p.offers:
    tryWrite offer.write(w, v)
  writeVarInt(w, p.villagerLevel)
  writeVarInt(w, p.experience)
  writeBool(w, p.isRegularVillager)
  writeBool(w, p.canRestock)
  writeOkVoid()
