## Port of pumpkin-protocol/src/java/client/play/multi_block_update.rs
## Updates multiple blocks within a single chunk section.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../data/block_state
import ../../../../generated/block_state_remap
import ../../../../util/math/position
import ../../../../util/vector3

type
  CMultiBlockUpdate* = object
    chunkSection*: int64    ## x << 42 | z << 20 | y
    updates*: seq[VarLong]  ## Block state id << 12 | relative position.

proc newCMultiBlockUpdate*(updates: openArray[(BlockPos, BlockStateId)]): CMultiBlockUpdate =
  let firstPos = updates[0][0]

  let chunkSectionVec = chunkSectionFromPos(firstPos)
  let chunkSection = packedChunkPos(chunkSectionVec)

  var packedUpdates: seq[VarLong] = @[]
  for i in 0 ..< updates.len:
    let localPos = cast[uint64](int64(packLocalChunkSection(updates[i][0])))
    let packed = (uint64(updates[i][1].asU16()) shl 12) or (localPos and 0xFFF'u64)
    packedUpdates.add(newVarLong(cast[int64](packed)))

  CMultiBlockUpdate(chunkSection: chunkSection, updates: packedUpdates)

proc toId*(_: typedesc[CMultiBlockUpdate]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SECTION_BLOCKS_UPDATE.toId(v)

proc writePacket*(p: CMultiBlockUpdate; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.chunkSection)
  writeVarInt(w, newVarInt(int32(p.updates.len)))

  for update in p.updates:
    let packedUpdate = cast[uint64](update.value)
    let localPos = packedUpdate and 0xFFF'u64
    let stateId = cast[uint16](packedUpdate shr 12)
    let remappedStateId = remapBlockStateForVersion(stateId, v)
    let remappedPacked = (uint64(remappedStateId) shl 12) or localPos
    writeVarLong(w, newVarLong(cast[int64](remappedPacked)))

  writeOkVoid()
