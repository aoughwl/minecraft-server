## Port of pumpkin-protocol/src/java/client/play/open_book.rs (newer tree: the pinned one has no open-book packet).
## Opens the written book the player holds in `hand` (0 main hand, 1 off hand).
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  COpenBook* = object
    hand*: int32

proc toId*(_: typedesc[COpenBook]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_OPEN_BOOK.toId(v)

proc writePacket*(p: COpenBook; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(p.hand))
  writeOkVoid()
