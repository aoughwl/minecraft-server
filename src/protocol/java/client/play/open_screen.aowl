## Port of pumpkin-protocol/src/java/client/play/open_screen.rs
## Instructs the client to open a GUI such as a chest, establishing the `syncId` of its window.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/text/text
import playwire

type
  COpenScreen* = object
    syncId*: VarInt
    windowType*: VarInt
    windowTitle*: TextComponent

proc toId*(_: typedesc[COpenScreen]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_OPEN_SCREEN.toId(v)

proc writePacket*(p: COpenScreen; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.syncId)
  writeVarInt(w, p.windowType)
  tryWrite writeText(w, p.windowTitle)
  writeOkVoid()
