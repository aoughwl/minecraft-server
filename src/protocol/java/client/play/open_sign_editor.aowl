## Port of pumpkin-protocol/src/java/client/play/open_sign_editor.rs
## Opens the sign text input screen for the client.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import playwire

type
  COpenSignEditor* = object
    location*: BlockPos
    isFrontText*: bool

proc toId*(_: typedesc[COpenSignEditor]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_OPEN_SIGN_EDITOR.toId(v)

proc writePacket*(p: COpenSignEditor; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBlockPos(w, p.location)
  writeBool(w, p.isFrontText)
  writeOkVoid()
