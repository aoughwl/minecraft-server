## Port of pumpkin-protocol/src/java/client/play/particle.rs
## Spawns a cluster of particles at a location.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../generated/particle_id_remap
import ../../../../util/vector3

type
  CParticle* = object
    forceSpawn*: bool
    important*: bool
    position*: Vector3[float64]
    offset*: Vector3[float32]
    maxSpeed*: float32
    particleCount*: int32
    particleId*: VarInt
    data*: seq[byte]     ## Extra data some particles need, such as a block state or a dust colour.

proc particleIdForVersion*(particleId: VarInt; version: JavaMinecraftVersion): VarInt =
  ## `u16::try_from` fails for anything out of range, which is then sent unchanged.
  if particleId.value >= 0 and particleId.value <= 65535:
    newVarInt(int32(remapParticleIdForVersion(uint16(particleId.value), version)))
  else:
    particleId

proc toId*(_: typedesc[CParticle]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_LEVEL_PARTICLES.toId(v)

proc writePacket*(p: CParticle; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.forceSpawn)
  writeBool(w, p.important)

  writeF64Be(w, p.position.x)
  writeF64Be(w, p.position.y)
  writeF64Be(w, p.position.z)

  writeF32Be(w, p.offset.x)
  writeF32Be(w, p.offset.y)
  writeF32Be(w, p.offset.z)

  writeF32Be(w, p.maxSpeed)
  writeI32Be(w, p.particleCount)
  writeVarInt(w, particleIdForVersion(p.particleId, v))

  writeSlice(w, p.data)
  writeOkVoid()
