## Port of pumpkin-protocol/src/java/client/play/ping_response.rs
## Responds to a client-initiated ping.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CPingResponse* = object
    payload*: int64

proc toId*(_: typedesc[CPingResponse]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PONG_RESPONSE.toId(v)

proc writePacket*(p: CPingResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.payload)
  writeOkVoid()
