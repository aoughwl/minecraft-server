## Port of pumpkin-protocol/src/java/client/play/player_abilities.rs
## Updates the player's movement and interaction abilities.
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CPlayerAbilities* = object
    flags*: int8  ## 0x01 invulnerable, 0x02 flying, 0x04 allow flying, 0x08 creative.
    flyingSpeed*: float32
    fieldOfView*: float32

proc toId*(_: typedesc[CPlayerAbilities]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_ABILITIES.toId(v)

proc writePacket*(p: CPlayerAbilities; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI8(w, p.flags)
  writeF32Be(w, p.flyingSpeed)
  writeF32Be(w, p.fieldOfView)
  writeOkVoid()
