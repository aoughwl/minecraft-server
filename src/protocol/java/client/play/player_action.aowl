## Port of pumpkin-protocol/src/java/client/play/player_action.rs
import std/options
import ../../../varint
import ../../../proto
import ../../../../util/text/text
import ../../../../util/uuid

type
  InitChat* = object
    sessionId*: Uuid
    expiresAt*: int64
    publicKey*: seq[byte]
    signature*: seq[byte]

  PlayerActionKind* = enum
    paAddPlayer
    paInitializeChat
    paUpdateGameMode
    paUpdateListed
    paUpdateLatency
    paUpdateDisplayName
    paUpdateListOrder

  PlayerAction* = object
    case kind*: PlayerActionKind
    of paAddPlayer:
      name*: string
      properties*: seq[Property]
    of paInitializeChat:
      initChat*: Option[InitChat]
    of paUpdateGameMode:
      gameMode*: VarInt
    of paUpdateListed:
      listed*: bool
    of paUpdateLatency:
      latency*: VarInt
    of paUpdateDisplayName:
      displayName*: Option[TextComponent]
    of paUpdateListOrder:
      listOrder*: VarInt
