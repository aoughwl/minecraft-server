## Port of pumpkin-protocol/src/java/client/play/player_chat_message.rs
## Sends a cryptographically signed player chat message to the client.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../bitset
import ../../../../util/text/text
import ../../../../util/uuid
import playwire

type
  PreviousMessage* = object
    id*: VarInt
    signature*: Option[seq[byte]]  ## Always 256 bytes.

  FilterTypeKind* = enum
    ftPassThrough        ## Message is not filtered at all.
    ftFullyFiltered      ## Message is fully filtered.
    ftPartiallyFiltered  ## Only some characters in the message are filtered.

  FilterType* = object
    case kind*: FilterTypeKind
    of ftPartiallyFiltered:
      mask*: BitSet
    else:
      discard

  CPlayerChatMessage* = object
    globalIndex*: VarInt            ## Index of messages sent to this client, from 0 on login.
    sender*: Uuid
    index*: VarInt                  ## Index of messages sent by the sender.
    messageSignature*: Option[seq[byte]]
    message*: string
    timestamp*: int64
    salt*: int64
    previousMessages*: seq[PreviousMessage]
    unsignedContent*: Option[TextComponent]
    filterType*: FilterType
    chatType*: VarInt
    senderName*: TextComponent
    targetName*: Option[TextComponent]

proc toId*(_: typedesc[CPlayerChatMessage]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_CHAT.toId(v)

proc writePacket*(p: CPlayerChatMessage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.globalIndex)
  writeUuid(w, p.sender)
  writeVarInt(w, p.index)
  writeBool(w, p.messageSignature.isSome)
  if p.messageSignature.isSome:
    writeSlice(w, p.messageSignature.unsafeGet)
  tryWrite writeString(w, p.message)
  writeI64Be(w, p.timestamp)
  writeI64Be(w, p.salt)
  writeVarInt(w, newVarInt(int32(p.previousMessages.len)))
  for previous in p.previousMessages:
    writeVarInt(w, previous.id)
    if previous.signature.isSome:
      writeSlice(w, previous.signature.unsafeGet)
  writeBool(w, p.unsignedContent.isSome)
  if p.unsignedContent.isSome:
    tryWrite writeText(w, p.unsignedContent.unsafeGet)
  # Upstream writes only the kind, not the bitset of `PartiallyFiltered`.
  let filterType =
    case p.filterType.kind
    of ftPassThrough: 0'i32
    of ftFullyFiltered: 1'i32
    of ftPartiallyFiltered: 2'i32
  writeVarInt(w, newVarInt(filterType))
  writeVarInt(w, p.chatType)
  tryWrite writeText(w, p.senderName)
  writeBool(w, p.targetName.isSome)
  if p.targetName.isSome:
    tryWrite writeText(w, p.targetName.unsafeGet)
  writeOkVoid()
