## Port of pumpkin-protocol/src/java/client/play/player_info_update.rs
## Updates one or more players' information on the client. Only the fields in `actions` are sent.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../util/text/text
import ../../../../util/uuid
import playwire, player_action

const
  # `PlayerInfoFlags`
  PlayerInfoAddPlayer* = 0x01'u8           ## ADD_PLAYER
  PlayerInfoInitializeChat* = 0x02'u8      ## INITIALIZE_CHAT
  PlayerInfoUpdateGameMode* = 0x04'u8      ## UPDATE_GAME_MODE
  PlayerInfoUpdateListed* = 0x08'u8        ## UPDATE_LISTED
  PlayerInfoUpdateLatency* = 0x10'u8       ## UPDATE_LATENCY
  PlayerInfoUpdateDisplayName* = 0x20'u8   ## UPDATE_DISPLAY_NAME
  PlayerInfoUpdateListPriority* = 0x40'u8  ## UPDATE_LIST_PRIORITY
  PlayerInfoUpdateHat* = 0x80'u8           ## UPDATE_HAT

type
  Player* = object
    uuid*: Uuid
    actions*: seq[PlayerAction]

  CPlayerInfoUpdate* = object
    actions*: uint8         ## The `PlayerInfoFlags` bitmask of what follows.
    players*: seq[Player]

proc toId*(_: typedesc[CPlayerInfoUpdate]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_INFO_UPDATE.toId(v)

proc writePacket*(p: CPlayerInfoUpdate; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeU8(w, p.actions)
  writeVarInt(w, newVarInt(int32(p.players.len)))
  for player in p.players:
    writeUuid(w, player.uuid)
    for action in player.actions:
      case action.kind
      of paAddPlayer:
        tryWrite writeString(w, action.name)
        writeVarInt(w, newVarInt(int32(action.properties.len)))
        for property in action.properties:
          tryWrite writeString(w, property.name)
          tryWrite writeString(w, property.value)
          writeBool(w, property.signature.isSome)
          if property.signature.isSome:
            tryWrite writeString(w, property.signature.unsafeGet)
      of paInitializeChat:
        writeBool(w, action.initChat.isSome)
        if action.initChat.isSome:
          let chat = action.initChat.unsafeGet
          writeUuid(w, chat.sessionId)
          writeI64Be(w, chat.expiresAt)
          writeVarInt(w, newVarInt(int32(chat.publicKey.len)))
          writeSlice(w, chat.publicKey)
          writeVarInt(w, newVarInt(int32(chat.signature.len)))
          writeSlice(w, chat.signature)
      of paUpdateGameMode:
        writeVarInt(w, action.gameMode)
      of paUpdateListed:
        writeBool(w, action.listed)
      of paUpdateLatency:
        writeVarInt(w, action.latency)
      of paUpdateDisplayName:
        writeBool(w, action.displayName.isSome)
        if action.displayName.isSome:
          tryWrite writeText(w, action.displayName.unsafeGet)
      of paUpdateListOrder:
        writeVarInt(w, action.listOrder)
  writeOkVoid()
