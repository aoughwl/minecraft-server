## Port of pumpkin-protocol/src/java/client/play/player_position.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../util/vector3

type
  CPlayerPosition* = object
    ## Updates the player's position and rotation on the client. The client must respond
    ## with a `Teleport Confirm` packet matching `teleportId`.
    teleportId*: VarInt
    position*: Vector3[float64]
    delta*: Vector3[float64]
    yaw*: float32
    pitch*: float32
    relatives*: seq[PositionFlag]

proc toId*(_: typedesc[CPlayerPosition]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_POSITION.toId(v)

proc writePacket*(p: CPlayerPosition; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  if v >= jmvV1_21_2:
    writeVarInt(w, p.teleportId)
    writeF64Be(w, p.position.x)
    writeF64Be(w, p.position.y)
    writeF64Be(w, p.position.z)
    writeF64Be(w, p.delta.x)
    writeF64Be(w, p.delta.y)
    writeF64Be(w, p.delta.z)
    writeF32Be(w, p.yaw)
    writeF32Be(w, p.pitch)
    writeI32Be(w, getBitfield(p.relatives))
  else:
    writeF64Be(w, p.position.x)
    writeF64Be(w, p.position.y)
    writeF64Be(w, p.position.z)
    writeF32Be(w, p.yaw)
    writeF32Be(w, p.pitch)
    if v >= jmvV1_19_4:
      writeI32Be(w, getBitfield(p.relatives))
    else:
      writeU8(w, cast[uint8](getBitfield(p.relatives)))
    if v >= jmvV1_9:
      writeVarInt(w, p.teleportId)
  writeOkVoid()

proc readPacket*(_: typedesc[CPlayerPosition]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CPlayerPosition] =
  # Upstream's `read` takes only the id and zeroes the rest ("TODO"), so does this.
  let teleportId = tryRead(CPlayerPosition, getVarInt(r))
  readOk(CPlayerPosition(teleportId: teleportId,
    position: Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    delta: Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    yaw: 0.0'f32, pitch: 0.0'f32, relatives: @[]))
