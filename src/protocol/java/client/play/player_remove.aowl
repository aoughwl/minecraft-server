## Port of pumpkin-protocol/src/java/client/play/player_remove.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/uuid

type
  CRemovePlayerInfo* = object
    ## Sent by the server to remove one or more players from the client's player list (tab list).
    players*: seq[Uuid]

proc toId*(_: typedesc[CRemovePlayerInfo]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_PLAYER_INFO_REMOVE.toId(v)

proc writePacket*(p: CRemovePlayerInfo; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.players.len)))
  for uuid in p.players:
    writeUuid(w, uuid)
  writeOkVoid()
