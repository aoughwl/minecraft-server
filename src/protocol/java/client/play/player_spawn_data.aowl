## Port of pumpkin-protocol/src/java/client/play/player_spawn_data.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import std/options
import ../../../../generated/dimension
import ../../../../util/math/position
import ../../../../util/resource_location

export dimension

type
  PlayerSpawnData* = object
    ## Not a packet of its own: CRespawn and the login packet embed it.
    dimension*: Dimension
    hashedSeed*: int64
    gameMode*: uint8
    previousGamemode*: int8
    debug*: bool
    isFlat*: bool
    deathDimensionName*: Option[(ResourceLocation, BlockPos)]
    portalCooldown*: VarInt
    sealevel*: VarInt

proc writePacket*(p: PlayerSpawnData; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  ## Upstream's `write_packet_data`.
  if v >= jmvV1_21_2:
    writeVarInt(w, newVarInt(int32(p.dimension.id)))
  elif v >= jmvV1_16:
    tryWrite writeString(w, p.dimension.minecraftName)
  elif v >= jmvV1_9:
    writeI32Be(w, int32(p.dimension.id))
  else:
    writeI8(w, cast[int8](p.dimension.id))
  tryWrite writeString(w, p.dimension.minecraftName)
  writeI64Be(w, p.hashedSeed)
  writeU8(w, p.gameMode)
  writeI8(w, p.previousGamemode)
  writeBool(w, p.debug)
  writeBool(w, p.isFlat)
  if v >= jmvV1_19:
    writeBool(w, p.deathDimensionName.isSome)
    if p.deathDimensionName.isSome:
      let death = p.deathDimensionName.unsafeGet
      tryWrite writeString(w, death[0])
      writeI64Be(w, asLong(death[1]))
  if v >= jmvV1_20:
    writeVarInt(w, p.portalCooldown)
  if v >= jmvV1_21_2:
    writeVarInt(w, p.sealevel)
  writeOkVoid()
