## Port of pumpkin-protocol/src/java/client/play/player_spawn_position.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/math/position

type
  CPlayerSpawnPosition* = object
    ## Sets the client's default spawn point and compass target.
    dimensionName*: string
    location*: BlockPos
    yaw*: float32
    pitch*: float32

proc toId*(_: typedesc[CPlayerSpawnPosition]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_DEFAULT_SPAWN_POSITION.toId(v)

proc writePacket*(p: CPlayerSpawnPosition; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  if v >= jmvV1_21_9:
    tryWrite writeString(w, p.dimensionName)
  writeI64Be(w, asLong(p.location))
  writeF32Be(w, p.yaw)
  if v >= jmvV1_21_9:
    writeF32Be(w, p.pitch)
  writeOkVoid()
