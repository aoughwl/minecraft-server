{.feature: "untyped".}
## Test for the client/play packets about the player and the connection: player_position, player_remove,
## player_spawn_data, player_spawn_position, respawn, set_camera, set_experience, set_health, set_held_item,
## select_advancements_tab, store_cookie, transfer. Exact bytes for protocol 774 and each side of a gate.
import std/options
import std/assertions
import playtestutil
import ../../../protobase, ../../../varint, ../../../proto
import ../../../../generated/dimension
import ../../../../util/javaversion
import ../../../../util/identifier
import ../../../../util/math/position
import ../../../../util/uuid
import ../../../../util/vector3
import player_position, player_remove, player_spawn_data, player_spawn_position, respawn, set_camera,
  set_experience, set_health, set_held_item, select_advancements_tab, store_cookie, transfer

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

proc strHex(s: string): string =
  ## A string shorter than 128 bytes: its VarInt length, then the bytes.
  var b = @[byte(s.len)]
  for c in s:
    b.add(byte(c))
  hexOf(b)

proc body(p: PlayerSpawnData; v: JavaMinecraftVersion): seq[byte] =
  var w = newNetWriter()
  assert writePacket(p, w, v).isOk
  w.buf

const
  Pos123 = "4000000000000000" & "4008000000000000" & "4010000000000000"  # 2.0 3.0 4.0
  Delta = "3fe0000000000000" & "bfe0000000000000" & "0000000000000000"   # 0.5 -0.5 0.0

block playerPosition:
  let p = CPlayerPosition(teleportId: newVarInt(300),
    position: Vector3[float64](x: 2.0, y: 3.0, z: 4.0),
    delta: Vector3[float64](x: 0.5, y: -0.5, z: 0.0),
    yaw: 1.0'f32, pitch: 2.0'f32, relatives: @[pfX, pfRotateDelta])
  eqHex(full(CPlayerPosition, p, V),
    "46 ac02" & Pos123 & Delta & "3f800000 40000000 00000101", "player_position 774")

  # Below 1.21.2 there is no delta and the id comes last.
  eqHex(full(CPlayerPosition, p, jmvV1_21),
    "40" & Pos123 & "3f800000 40000000 00000101 ac02", "player_position 1.21")

  # Below 1.19.4 the flags are a byte; below 1.9 there is no id at all.
  var w194 = newNetWriter()
  assert writePacket(p, w194, jmvV1_19).isOk
  eqHex(w194.buf, Pos123 & "3f800000 40000000 01 ac02", "player_position 1.19")
  var w18 = newNetWriter()
  assert writePacket(p, w18, jmvV1_8).isOk
  eqHex(w18.buf, Pos123 & "3f800000 40000000 01", "player_position 1.8")

  # Upstream's read takes the id and zeroes the rest.
  var r = newNetReader(@[0xAC'u8, 0x02])
  let back = readPacket(CPlayerPosition, r, V)
  assert back.isOk and back.value.teleportId.value == 300'i32
  assert back.value.position.x == 0.0 and back.value.relatives.len == 0
  var empty = newNetReader(newSeq[byte]())
  assert not readPacket(CPlayerPosition, empty, V).isOk

block playerRemove:
  let p = CRemovePlayerInfo(players: @[Uuid(hi: 1'u64, lo: 2'u64), Uuid(hi: 3'u64, lo: 4'u64)])
  eqHex(full(CRemovePlayerInfo, p, V),
    "43 02 0000000000000001 0000000000000002 0000000000000003 0000000000000004", "player_remove")

block spawnData:
  let name = strHex("minecraft:overworld")
  assert OVERWORLD.id == 0'u8
  var p = PlayerSpawnData(dimension: OVERWORLD, hashedSeed: 1'i64, gameMode: 1'u8, previousGamemode: -1'i8,
    debug: false, isFlat: true, deathDimensionName: none[(string, BlockPos)](),
    portalCooldown: newVarInt(5), sealevel: newVarInt(63))
  eqHex(body(p, V), "00" & name & "0000000000000001 01 ff 00 01 00 05 3f", "spawn data 774")

  # Each gate, from the newest down.
  eqHex(body(p, jmvV1_21), name & name & "0000000000000001 01 ff 00 01 00 05", "spawn data 1.21: no sea level, name twice")
  eqHex(body(p, jmvV1_19), name & name & "0000000000000001 01 ff 00 01 00", "spawn data 1.19: no cooldown")
  eqHex(body(p, jmvV1_18), name & name & "0000000000000001 01 ff 00 01", "spawn data 1.18: no death location")
  eqHex(body(p, jmvV1_15), "00000000" & name & "0000000000000001 01 ff 00 01", "spawn data 1.15: i32 dimension")
  eqHex(body(p, jmvV1_8), "00" & name & "0000000000000001 01 ff 00 01", "spawn data 1.8: i8 dimension")

  p.deathDimensionName = some(("minecraft:the_end", newBlockPos(1, 2, 3)))
  eqHex(body(p, V), "00" & name & "0000000000000001 01 ff 00 01 01" & strHex("minecraft:the_end") &
    "0000004000003002 05 3f", "spawn data 774 with a death location")

block respawnPacket:
  let p = CRespawn(playerSpawnInfo: PlayerSpawnData(dimension: OVERWORLD, hashedSeed: 0'i64, gameMode: 0'u8,
      previousGamemode: -1'i8, debug: false, isFlat: false, deathDimensionName: none[(string, BlockPos)](),
      portalCooldown: newVarInt(0), sealevel: newVarInt(63)),
    dataKept: KeepAllData)
  eqHex(full(CRespawn, p, V), "50 00" & strHex("minecraft:overworld") &
    "0000000000000000 00 ff 00 00 00 00 3f 03", "respawn")
  assert KeepAttributeModifiers == 1'u8 and KeepEntityData == 2'u8

block spawnPosition:
  let p = CPlayerSpawnPosition(dimensionName: "a:b", location: newBlockPos(1, 2, 3), yaw: 1.0'f32, pitch: 2.0'f32)
  eqHex(full(CPlayerSpawnPosition, p, V), "5f 03 613a62 0000004000003002 3f800000 40000000", "spawn position 774")
  eqHex(full(CPlayerSpawnPosition, p, jmvV1_21_7), "5a 0000004000003002 3f800000", "spawn position below 1.21.9")

block small:
  eqHex(full(CSetCamera, CSetCamera(cameraId: newVarInt(7)), V), "5b 07", "set_camera")
  eqHex(full(CSetExperience, CSetExperience(progress: 0.5'f32, level: newVarInt(3), totalExperience: newVarInt(300)), V),
    "65 3f000000 03 ac02", "set_experience")
  eqHex(full(CSetHealth, CSetHealth(health: 20.0'f32, food: newVarInt(20), foodSaturation: 5.0'f32), V),
    "66 41a00000 14 40a00000", "set_health")
  eqHex(full(CSetSelectedSlot, CSetSelectedSlot(slot: 4'i8), V), "67 04", "set_held_item 774")
  # 1.21 alone sends the carried-item packet.
  eqHex(full(CSetSelectedSlot, CSetSelectedSlot(slot: 4'i8), jmvV1_21), "53 04", "set_held_item 1.21")
  assert CSetSelectedSlot.toId(jmvV1_20_5) == 103'i32
  eqHex(full(CTransfer, CTransfer(host: "h", port: newVarInt(25565)), V), "7f 01 68 ddc701", "transfer")
  eqHex(full(CStoreCookie, CStoreCookie(key: "a:b", payload: @[1'u8, 2, 3]), V), "76 03 613a62 03 010203", "store_cookie")

block selectTab:
  eqHex(full(CSelectAdvancementsTab, CSelectAdvancementsTab(tabId: none[Identifier]()), V), "53 00", "select tab none")
  let tab = CSelectAdvancementsTab(tabId: some(fromStatic("minecraft", "story")))
  eqHex(full(CSelectAdvancementsTab, tab, V), "53 01" & strHex("minecraft:story"), "select tab some")

echo "ok"
