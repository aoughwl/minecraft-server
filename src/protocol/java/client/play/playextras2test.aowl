{.feature: "untyped".}
## Exact bytes (protocol 774) of the play packets the player host interfaces send: open-book, delete-chat (a cache id and a full
## signature) and the play resource pack push and pop.
import std/options
import playtestutil
import ../../../varint, ../../../protobase
import ../../../uuid
import ../../../../util/javaversion
import ../../../../util/text/text
import delete_chat, open_book, resource_pack

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

eqHex(full(COpenBook, COpenBook(hand: 1'i32), V), "38 01", "open book, off hand")
eqHex(full(COpenBook, COpenBook(hand: 0'i32), V), "38 00", "open book, main hand")
eqHex(full(CDeleteChat, cDeleteChatFromCacheId(7'i32), V), "1f 08", "delete chat by cache id (written as id + 1)")
eqHex(full(CDeleteChat, cDeleteChatFromSignature(@[0xAA'u8, 0xBB'u8]), V), "1f 00 aabb", "delete chat by signature")
eqHex(full(CPlayResourcePackPop, CPlayResourcePackPop(uuid: none[Uuid]()), V), "4e 00", "clear resource packs")
eqHex(full(CPlayResourcePackPop, CPlayResourcePackPop(uuid: some(Uuid(hi: 1'u64, lo: 2'u64))), V),
  "4e 01 0000000000000001 0000000000000002", "remove one resource pack")
eqHex(full(CPlayResourcePackPush, CPlayResourcePackPush(uuid: Uuid(hi: 1'u64, lo: 2'u64), url: "a", hash: "b", forced: true,
  promptMessage: none[TextComponent]()), V), "4f 0000000000000001 0000000000000002 0161 0162 01 00", "resource pack push")
echo "playextras2test ok"
