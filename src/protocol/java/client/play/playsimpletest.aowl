{.feature: "untyped".}
## Test for the client/play packets made of plain numbers, ids and positions. Exact bytes for protocol 774.
import std/options
import playtestutil
import ../../../varint, ../../../lpvector3d, ../../../protobase
import ../../../../generated/block_state_remap, ../../../../generated/particle as genparticle
import ../../../../generated/scoreboard_slot, ../../../../generated/world_event
import ../../../../data/block_state
import ../../../../util/javaversion
import ../../../../util/math/position
import ../../../../util/vector3
import acknowledge_block, award_stats, block_destroy_stage, block_entity_data, block_event, block_update
import center_chunk, change_difficulty, chunk_batch_end, chunk_batch_start, clear_dialog, clear_title
import close_container, cookie_request, custom_payload, damage_event, debug_sample, display_objective
import entity_animation, entity_position_sync, entity_status, entity_velocity, game_event, head_rot
import hurt_animation, initialize_world_border, item_cooldown, keep_alive, level_event, multi_block_update
import open_sign_editor, particle, ping_response, player_abilities

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

let pos = newBlockPos(1, 2, 3)
const P = "0000004000003002"  # pos: x << 38 | z << 12 | y

eqHex(full(CAcknowledgeBlockChange, CAcknowledgeBlockChange(sequenceId: newVarInt(300)), V), "04 ac02", "ack")

eqHex(full(CAwardStats, CAwardStats(stats: @[Statistic(categoryId: newVarInt(1), statisticId: newVarInt(2),
  value: newVarInt(300))]), V), "03 01 01 02 ac02", "award stats")

eqHex(full(CSetBlockDestroyStage, CSetBlockDestroyStage(entityId: newVarInt(7), location: pos, destroyStage: -1'i8), V),
  "05 07" & P & "ff", "destroy stage")

eqHex(full(CBlockEntityData, CBlockEntityData(location: pos, typ: newVarInt(9), nbtData: @[0x0a'u8, 0x00]), V),
  "06" & P & "09 0a00", "block entity data")

eqHex(full(CBlockEvent, CBlockEvent(location: pos, actionId: 1'u8, actionParameter: 2'u8, blockType: newVarInt(300)), V),
  "07" & P & "01 02 ac02", "block event")

# The state id goes through the table: 26.2's 1381 is 1181 on 774, and unchanged on 26.2 itself.
eqHex(full(CBlockUpdate, CBlockUpdate(location: pos, stateId: newVarInt(1381)), V), "08" & P & "9d09", "block update 774")
block:
  var w = newNetWriter()
  discard writePacket(CBlockUpdate(location: pos, stateId: newVarInt(1381)), w, jmvV26_2)
  eqHex(w.buf, P & "e50a", "block update 26.2")
  # Out of u16 range is sent as it is.
  var neg = newNetWriter()
  discard writePacket(CBlockUpdate(location: pos, stateId: newVarInt(-1)), neg, V)
  eqHex(neg.buf, P & "ffffffff0f", "block update out of range")

eqHex(full(CCenterChunk, CCenterChunk(chunkX: newVarInt(-1), chunkZ: newVarInt(1)), V), "5c ffffffff0f 01", "center chunk")
eqHex(full(CChangeDifficulty, CChangeDifficulty(difficulty: 3'u8, locked: true), V), "0a 03 01", "difficulty")
eqHex(full(CChunkBatchEnd, newCChunkBatchEnd(64'u16), V), "0b 40", "batch end")
eqHex(full(CChunkBatchStart, CChunkBatchStart(), V), "0c", "batch start")
eqHex(full(CPlayClearDialog, CPlayClearDialog(), V), "8901", "clear dialog")
if CPlayClearDialog.toId(jmvV1_21) != -1'i32:
  echo "FAIL clear dialog has no id on 1.21"
  quit(1)
eqHex(full(CClearTitle, CClearTitle(reset: true), V), "0e 01", "clear title")
eqHex(full(CCloseContainer, CCloseContainer(syncId: newVarInt(5)), V), "11 05", "close container")
eqHex(full(CPlayCookieRequest, CPlayCookieRequest(key: "a:b"), V), "15 03 613a62", "cookie request")
eqHex(full(CCustomPayload, CCustomPayload(channel: "a:b", data: @[1'u8, 2]), V), "18 03 613a62 0102", "custom payload")

eqHex(full(CDamageEvent, newCDamageEvent(newVarInt(1), newVarInt(2), some(newVarInt(3)), none[VarInt](),
  some(vec3[float64](1.0, 2.0, 3.0))), V),
  "19 01 02 04 00 01 3ff0000000000000 4000000000000000 4008000000000000", "damage event")
eqHex(full(CDamageEvent, newCDamageEvent(newVarInt(1), newVarInt(2), none[VarInt](), some(newVarInt(0)),
  none[Vector3[float64]]()), V), "19 01 02 00 01 00", "damage event, no position")

eqHex(full(CDebugSample, CDebugSample(sample: @[1'i64], sampleType: newVarInt(2)), V),
  "1e 01 0000000000000001 02", "debug sample")
eqHex(full(CDisplayObjective, newCDisplayObjective(sdsSidebar, "x"), V), "60 01 01 78", "display objective")

eqHex(full(CEntityAnimation, newCEntityAnimation(newVarInt(1), anLeaveBed), V), "02 01 02", "animation, hole in the enum")
eqHex(full(CEntityAnimation, newCEntityAnimation(newVarInt(1), anMagicCriticaleffect), V), "02 01 05", "animation, last")

eqHex(full(CEntityPositionSync, CEntityPositionSync(entityId: newVarInt(1), position: vec3[float64](1.0, 2.0, 3.0),
  delta: vec3[float64](0.5, 0.0, -2.0), yaw: 1.0'f32, pitch: 2.0'f32, onGround: true), V),
  "23 01 3ff0000000000000 4000000000000000 4008000000000000 3fe0000000000000 0000000000000000 c000000000000000" &
  "3f800000 40000000 01", "position sync")

eqHex(full(CEntityStatus, CEntityStatus(entityId: 7'i32, entityStatus: -3'i8), V), "22 00000007 fd", "entity status")

# The same vector as prototest.aowl's worked example, and both sides of the gate.
block:
  let p = newCEntityVelocity(newVarInt(300), vec3[float64](0.5, -0.5, 0.0))
  eqHex(full(CEntityVelocity, p, V), "63 ac02 f9ff7ffe8002", "velocity, packed")
  var old = newNetWriter()
  discard writePacket(p, old, jmvV1_21_7)
  eqHex(old.buf, "ac02 0fa0 f060 0000", "velocity, legacy")

eqHex(full(CGameEvent, newCGameEvent(geChangeGameMode, 1.0'f32), V), "26 03 3f800000", "game event")
eqHex(full(CGameEvent, newCGameEvent(geStartWaitingChunks, 0.0'f32), V), "26 0d 00000000", "game event, last")
eqHex(full(CHeadRot, CHeadRot(entityId: newVarInt(1), headYaw: 0x80'u8), V), "51 01 80", "head rotation")
eqHex(full(CHurtAnimation, CHurtAnimation(entityId: newVarInt(1), yaw: 1.0'f32), V), "29 01 3f800000", "hurt animation")

eqHex(full(CInitializeWorldBorder, CInitializeWorldBorder(x: 1.0, z: 2.0, oldDiameter: 3.0, newDiameter: 4.0,
  speed: newVarLong(300'i64), portalTeleportBoundary: newVarInt(1), warningBlocks: newVarInt(2), warningTime: newVarInt(3)), V),
  "2a 3ff0000000000000 4000000000000000 4008000000000000 4010000000000000 ac02 01 02 03", "world border")

eqHex(full(CItemCooldown, CItemCooldown(group: "a", cooldown: newVarInt(5)), V), "16 01 61 05", "cooldown")
eqHex(full(CKeepAlive, CKeepAlive(keepAliveId: 99'i64), V), "2b 0000000000000063", "keep alive")

eqHex(full(CLevelEvent, CLevelEvent(event: 1000'i32, location: pos, data: 1381'i32, disableRelativeVolume: false), V),
  "2d 000003e8" & P & "00000565 00", "level event, data as it is")
eqHex(full(CLevelEvent, CLevelEvent(event: int32(ord(weParticlesDestroyBlock)), location: pos, data: 1381'i32,
  disableRelativeVolume: true), V), "2d 000007d1" & P & "0000049d 01", "level event, block break remaps")

# Position 17, 34, 51 is section (1, 2, 3), local (1, 2, 3): section x << 42 | z << 20 | y, local x << 8 | z << 4 | y.
# 1381 << 12 | 0x132 is sent as 1181 << 12 | 0x132 on 774.
block:
  let p = newCMultiBlockUpdate(@[(newBlockPos(17, 34, 51), BlockStateId(1381'u16))])
  eqHex(full(CMultiBlockUpdate, p, V), "52 0000040000300002 01 b2a2a702", "multi block, 774")

eqHex(full(COpenSignEditor, COpenSignEditor(location: pos, isFrontText: false), V), "3a" & P & "00", "sign editor")
eqHex(full(CPingResponse, CPingResponse(payload: 1'i64), V), "3c 0000000000000001", "ping response")
eqHex(full(CPlayerAbilities, CPlayerAbilities(flags: 15'i8, flyingSpeed: 0.05'f32, fieldOfView: 0.1'f32), V),
  "3e 0f 3d4ccccd 3dcccccd", "abilities")

# Upstream's particle tests: the id at byte 46 of the body remaps on 774, and stays on 26.2.
block:
  proc particleOf(id: int32): CParticle =
    CParticle(forceSpawn: false, important: true, position: vec3[float64](1.0, 2.0, 3.0),
      offset: vec3[float32](1.0'f32, 2.0'f32, 0.5'f32), maxSpeed: 2.0'f32, particleCount: 1'i32,
      particleId: newVarInt(id), data: @[0xaa'u8])
  let id = int32(ord(ptExplosionEmitter))
  const Body = "00 01 3ff0000000000000 4000000000000000 4008000000000000 3f800000 40000000 3f000000 40000000 00000001"
  eqHex(full(CParticle, particleOf(id), V), "2e" & Body & "16 aa", "particle remaps for 1.21.11")
  var latest = newNetWriter()
  discard writePacket(particleOf(id), latest, jmvV26_2)
  eqHex(latest.buf, Body & "1d aa", "particle stays latest for 26.2")
  eqHex(full(CParticle, particleOf(-1), V), "2e" & Body & "ffffffff0f aa", "particle id out of range")

echo "ok"
