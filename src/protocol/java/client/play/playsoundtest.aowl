{.feature: "untyped".}
## Test for the packets that carry sounds and items: entity_sound_effect, explode, merchant_offers. Upstream's
## vectors plus exact bytes for protocol 774.
import std/options
import playtestutil
import ../../../varint, ../../../proto, ../../../protobase, ../../../itemstackserializer, ../../../datacomponent
import ../../../../generated/sound_category, ../../../../generated/sound_id_remap
import ../../../../generated/particle as genparticle
import ../../../../util/javaversion
import ../../../../util/vector3
import entity_sound_effect, explode, merchant_offers

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

# 26.2's sound 228 is 226 on 774, and goes out plus one.
let sound228 = newCEntitySoundEffect(IdOr[SoundEvent](kind: iokId, id: 228'u16), scPlayers, newVarInt(123), 1.0'f32, 1.0'f32, 42'i64)
eqHex(full(CEntitySoundEffect, sound228, V), "72 e301 07 7b 3f800000 3f800000 000000000000002a", "numeric sound id remaps for 1.21.11")
block:
  var w = newNetWriter()
  discard writePacket(sound228, w, jmvV26_2)
  eqHex(w.buf, "e501 07 7b 3f800000 3f800000 000000000000002a", "numeric sound id stays latest for 26.2")
let direct = newCEntitySoundEffect(IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: "a:b", range: none[float32]())),
  scPlayers, newVarInt(123), 1.0'f32, 1.0'f32, 42'i64)
eqHex(full(CEntitySoundEffect, direct, V), "72 00 03 613a62 00 07 7b 3f800000 3f800000 000000000000002a", "direct sound event")
let ranged = newCEntitySoundEffect(IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: "a:b", range: some(2.0'f32))),
  scMaster, newVarInt(1), 1.0'f32, 2.0'f32, -1'i64)
eqHex(full(CEntitySoundEffect, ranged, V), "72 00 03 613a62 01 40000000 00 01 3f800000 40000000 ffffffffffffffff", "direct sound event, range")

# Upstream's explosion vectors: particle at byte 33 of the body. The sound id is remapped (upstream forgot it).
let id = newVarInt(int32(ord(ptExplosionEmitter)))
let zero = vec3[float64](0.0, 0.0, 0.0)
const Zeros = "0000000000000000 0000000000000000 0000000000000000"
let plain = newCExplosion(zero, 4.0'f32, 0'i32, none[Vector3[float64]](), id, IdOr[SoundEvent](kind: iokId, id: 0'u16))
eqHex(full(CExplosion, plain, V), "24" & Zeros & "40800000 00000000 00 16 01 00", "explosion remaps for 1.21.11")
block:
  # Sound id 228 of the latest tables is 226 for 1.21.11: the wire carries 226 + 1 = 0xe3. Upstream sent 229.
  let moved = newCExplosion(zero, 4.0'f32, 0'i32, none[Vector3[float64]](), id, IdOr[SoundEvent](kind: iokId, id: 228'u16))
  eqHex(full(CExplosion, moved, V), "24" & Zeros & "40800000 00000000 00 16 e301 00", "explosion sound id remapped for 1.21.11")
block:
  var w = newNetWriter()
  discard writePacket(plain, w, jmvV26_2)
  eqHex(w.buf, Zeros & "40800000 00000000 00 1d 01 00", "explosion stays latest for 26.2")
let rich = newCExplosion(vec3[float64](1.0, 2.0, 3.0), 4.0'f32, 5'i32, some(vec3[float64](0.5, 0.0, 0.0)), id,
  IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: "a", range: some(1.0'f32))))
eqHex(full(CExplosion, rich, V), "24 3ff0000000000000 4000000000000000 4008000000000000 40800000 00000005" &
  "01 3fe0000000000000 0000000000000000 0000000000000000 16 00 01 61 01 3f800000 00", "explosion with everything")

# Merchant: the stacks go by writeWithVersion, the second offer has no second cost.
proc stack(count: uint8; item: uint16): ItemStackSerializer =
  fromItemStack(newItemStack(count, item, newSeq[PatchEntry](0)))

let merchant = CMerchantOffers(windowId: newVarInt(1), offers: @[
    MerchantOffer(baseCostA: stack(2'u8, 1'u16), output: fromItemStack(emptyItemStack()),
      costB: some(stack(3'u8, 1'u16)), isDisabled: true, uses: 1'i32, maxUses: 2'i32, xp: 3'i32, specialPrice: 4'i32,
      priceMultiplier: 1.0'f32, demand: 5'i32),
    MerchantOffer(baseCostA: stack(1'u8, 1'u16), output: stack(1'u8, 1'u16),
      costB: none[ItemStackSerializer](), isDisabled: false, uses: 0'i32, maxUses: 0'i32, xp: 0'i32, specialPrice: 0'i32,
      priceMultiplier: 0.0'f32, demand: 0'i32)],
  villagerLevel: newVarInt(2), experience: newVarInt(3), isRegularVillager: true, canRestock: false)
eqHex(full(CMerchantOffers, merchant, V),
  "32 01 02" &
  "02 01 00 00 00 01 03 01 00 00 01 00000001 00000002 00000003 00000004 3f800000 00000005" &
  "01 01 00 00 01 01 00 00 00 00 00000000 00000000 00000000 00000000 00000000 00000000" &
  "02 03 01 00", "merchant offers")

echo "ok"
