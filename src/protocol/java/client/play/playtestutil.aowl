## Not an upstream file: the shared checks of the client/play packet tests.
import std/syncio
import ../../../netcodec, ../../../packetbase
export syncio, netcodec, packetbase

proc hexOf*(b: openArray[byte]): string =
  const Hex = "0123456789abcdef"
  result = ""
  for x in b:
    result.add(Hex[int(x) shr 4])
    result.add(Hex[int(x) and 15])

proc stripped(s: string): string =
  result = ""
  for c in s:
    if c != ' ':
      result.add(c)

proc eqHex*(got: openArray[byte]; want: string; what: string) =
  ## Exits non-zero on a mismatch, and says where.
  let w = stripped(want)
  let g = hexOf(got)
  if g != w:
    echo "FAIL ", what
    echo "  got  ", g
    echo "  want ", w
    quit(1)
