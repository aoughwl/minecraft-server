{.feature: "untyped".}
## Test for the client/play packets that carry text, strings and uuids. Exact bytes for protocol 774.
import std/options
import playtestutil
import ../../../varint, ../../../proto, ../../../protobase
import ../../../../util/javaversion
import ../../../../util/text/text
import ../../../../util/uuid
import actionbar, boss_event, bossevent_action, combat_death, command_suggestions, disconnect
import disguised_chat_message, map_item_data, open_screen, player_action, player_chat_message, player_info_update

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

let hi = text("hi")
const
  HI = "0a 08 0004 74657874 0002 6869 00"  # {text: "hi"}, as unnamed network NBT
  U = "0102030405060708 090a0b0c0d0e0f10"
let uid = Uuid(hi: 0x0102030405060708'u64, lo: 0x090a0b0c0d0e0f10'u64)

eqHex(full(CActionBar, CActionBar(actionBar: hi), V), "55" & HI, "action bar")
eqHex(full(CCombatDeath, CCombatDeath(playerId: newVarInt(7), message: hi), V), "42 07" & HI, "combat death")
eqHex(full(CPlayDisconnect, CPlayDisconnect(reason: hi), V), "20" & HI, "disconnect")
eqHex(full(COpenScreen, COpenScreen(syncId: newVarInt(1), windowType: newVarInt(2), windowTitle: hi), V),
  "39 01 02" & HI, "open screen")

eqHex(full(CCommandSuggestions, CCommandSuggestions(id: newVarInt(1), start: newVarInt(2), length: newVarInt(3),
  matches: @[CommandSuggestion(suggestion: "ab", tooltip: some(hi)),
             CommandSuggestion(suggestion: "c", tooltip: none[TextComponent]())]), V),
  "0f 01 02 03 02 02 6162 01" & HI & "01 63 00", "suggestions")

eqHex(full(CDisguisedChatMessage, CDisguisedChatMessage(message: hi, chatType: newVarInt(5), senderName: hi,
  targetName: none[TextComponent]()), V), "21" & HI & "05" & HI & "00", "disguised chat")
eqHex(full(CDisguisedChatMessage, CDisguisedChatMessage(message: hi, chatType: newVarInt(5), senderName: hi,
  targetName: some(hi)), V), "21" & HI & "05" & HI & "01" & HI, "disguised chat, target")

eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baAdd, title: hi, health: 1.0'f32,
  color: newVarInt(1), division: newVarInt(2), flags: 3'u8)), V), "09" & U & "00" & HI & "3f800000 01 02 03", "boss add")
eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baRemove)), V), "09" & U & "01", "boss remove")
eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baUpdateHealth, updatedHealth: 1.0'f32)), V),
  "09" & U & "02 3f800000", "boss health")
eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baUpdateTile, updatedTitle: hi)), V),
  "09" & U & "03" & HI, "boss title")
eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baUpdateStyle, styleColor: newVarInt(1),
  dividers: newVarInt(2))), V), "09" & U & "04 01 02", "boss style")
eqHex(full(CBossEvent, CBossEvent(uuid: uid, action: BosseventAction(kind: baUpdateFlags, updatedFlags: 7'u8)), V),
  "09" & U & "05 07", "boss flags")

# The signatures have no length prefix, and PartiallyFiltered's bitset is not written: both are upstream's.
eqHex(full(CPlayerChatMessage, CPlayerChatMessage(globalIndex: newVarInt(1), sender: uid, index: newVarInt(2),
  messageSignature: some(@[0xaa'u8, 0xbb]), message: "hi", timestamp: 3'i64, salt: 4'i64,
  previousMessages: @[PreviousMessage(id: newVarInt(1), signature: some(@[0xcc'u8])),
                      PreviousMessage(id: newVarInt(2), signature: none[seq[byte]]())],
  unsignedContent: none[TextComponent](), filterType: FilterType(kind: ftPartiallyFiltered),
  chatType: newVarInt(5), senderName: hi, targetName: some(hi)), V),
  "3f 01" & U & "02 01 aabb 02 6869 0000000000000003 0000000000000004 02 01 cc 02 00 02 05" & HI & "01" & HI, "chat")
eqHex(full(CPlayerChatMessage, CPlayerChatMessage(globalIndex: newVarInt(1), sender: uid, index: newVarInt(2),
  messageSignature: none[seq[byte]](), message: "", timestamp: 0'i64, salt: 0'i64, previousMessages: @[],
  unsignedContent: some(hi), filterType: FilterType(kind: ftPassThrough),
  chatType: newVarInt(5), senderName: hi, targetName: none[TextComponent]()), V),
  "3f 01" & U & "02 00 00 0000000000000000 0000000000000000 00 01" & HI & "00 05" & HI & "00", "chat, the other options")

eqHex(full(CPlayerInfoUpdate, CPlayerInfoUpdate(actions: PlayerInfoAddPlayer or PlayerInfoInitializeChat or
  PlayerInfoUpdateGameMode or PlayerInfoUpdateListed or PlayerInfoUpdateLatency or PlayerInfoUpdateDisplayName or
  PlayerInfoUpdateListPriority, players: @[Player(uuid: uid, actions: @[
    PlayerAction(kind: paAddPlayer, name: "ab",
      properties: @[Property(name: "n", value: "v", signature: some("s")),
                    Property(name: "m", value: "w", signature: none[string]())]),
    PlayerAction(kind: paInitializeChat, initChat: some(InitChat(sessionId: uid, expiresAt: 1'i64,
      publicKey: @[0xaa'u8], signature: @[0xbb'u8, 0xcc]))),
    PlayerAction(kind: paUpdateGameMode, gameMode: newVarInt(1)),
    PlayerAction(kind: paUpdateListed, listed: true),
    PlayerAction(kind: paUpdateLatency, latency: newVarInt(300)),
    PlayerAction(kind: paUpdateDisplayName, displayName: some(hi)),
    PlayerAction(kind: paUpdateListOrder, listOrder: newVarInt(5))])]), V),
  "44 7f 01" & U & "02 6162 02 01 6e 01 76 01 01 73 01 6d 01 77 00" &
  "01" & U & "0000000000000001 01 aa 02 bbcc" &
  "01 01 ac02 01" & HI & "05", "player info, every action")
eqHex(full(CPlayerInfoUpdate, CPlayerInfoUpdate(actions: PlayerInfoInitializeChat or PlayerInfoUpdateDisplayName,
  players: @[Player(uuid: uid, actions: @[
    PlayerAction(kind: paInitializeChat, initChat: none[InitChat]()),
    PlayerAction(kind: paUpdateDisplayName, displayName: none[TextComponent]())])]), V),
  "44 22 01" & U & "00 00", "player info, empty options")

eqHex(full(CMapItemData, CMapItemData(mapId: newVarInt(1), scale: 2'i8, locked: true,
  icons: some(@[MapIcon(iconType: newVarInt(3), x: 1'i8, z: 2'i8, direction: 3'i8, displayName: some("a")),
                MapIcon(iconType: newVarInt(4), x: -1'i8, z: 0'i8, direction: 0'i8, displayName: none[string]())]),
  data: some(MapPatch(columns: 2'u8, rows: 3'u8, x: 1'i8, z: -1'i8, data: @[0xaa'u8]))), V),
  "31 01 02 01 01 02 03 01 02 03 01 0c 7b2274657874223a2261227d 04 ff 00 00 00 02 03 01 ff 01 aa", "map data")
eqHex(full(CMapItemData, CMapItemData(mapId: newVarInt(1), scale: 2'i8, locked: false, icons: none[seq[MapIcon]](),
  data: none[MapPatch]()), V), "31 01 02 00 00 00", "map data, nothing")
eqHex(full(CMapItemData, CMapItemData(mapId: newVarInt(1), scale: 2'i8, locked: false, icons: none[seq[MapIcon]](),
  data: some(MapPatch(columns: 0'u8, rows: 3'u8, x: 1'i8, z: 1'i8, data: @[1'u8]))), V),
  "31 01 02 00 00 00", "map data, a patch of no columns stops there")

# A text too long for NBT comes back as an error rather than empty bytes.
block:
  var long = ""
  for i in 0 ..< 70000:
    long.add('x')
  var w = newNetWriter()
  if writePacket(CActionBar(actionBar: text(long)), w, V).isOk:
    echo "FAIL a too-long text should not write"
    quit(1)

echo "ok"
