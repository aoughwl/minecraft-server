## Not an upstream file: the writes client/play needs for the real util types, which
## src/protocol/netcodec.aowl and uuid.aowl only offer for their own stand-ins.
##
## - `writeText` is `write_slice(&text.encode())`. Upstream's `encode` panics on a string too long for NBT's
##   u16 prefix, and `encode` in util/text returns empty bytes there, which would corrupt the stream, so this
##   returns the error instead.
## - `writeBlockPos` is `write_block_pos` for util/math/position's `BlockPos`.
## - `writeUuid` is `write_uuid` for util/uuid's `Uuid`.

import ../../../protobase, ../../../netcodec
import ../../../../util/text/text
import ../../../../util/math/position
import ../../../../util/uuid

proc writeText*(w: var NetWriter; t: TextComponent): ProtoWriteVoidResult =
  let res = tryEncode(t)
  if not res.ok:
    return writeErrVoid(messageWrite(res.error))
  writeSlice(w, res.value)
  writeOkVoid()

proc writeBlockPos*(w: var NetWriter; pos: BlockPos) =
  writeI64Be(w, pos.asLong())

proc writeUuid*(w: var NetWriter; data: Uuid) =
  writeUuidPair(w, data.hi, data.lo)
