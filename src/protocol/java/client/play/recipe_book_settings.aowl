## Port of pumpkin-protocol/src/java/client/play/recipe_book_settings.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CRecipeBookSettings* = object
    ## Wire format: 4 `TypeSettings` pairs (crafting, furnace, blast_furnace, smoker),
    ## each pair is (is_open: bool, is_filtering: bool).
    craftingOpen*: bool
    craftingFiltering*: bool
    furnaceOpen*: bool
    furnaceFiltering*: bool
    blastFurnaceOpen*: bool
    blastFurnaceFiltering*: bool
    smokerOpen*: bool
    smokerFiltering*: bool

proc defaultClosed*(_: typedesc[CRecipeBookSettings]): CRecipeBookSettings =
  CRecipeBookSettings()

proc toId*(_: typedesc[CRecipeBookSettings]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_RECIPE_BOOK_SETTINGS.toId(v)

proc writePacket*(p: CRecipeBookSettings; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.craftingOpen)
  writeBool(w, p.craftingFiltering)
  writeBool(w, p.furnaceOpen)
  writeBool(w, p.furnaceFiltering)
  writeBool(w, p.blastFurnaceOpen)
  writeBool(w, p.blastFurnaceFiltering)
  writeBool(w, p.smokerOpen)
  writeBool(w, p.smokerFiltering)
  writeOkVoid()
