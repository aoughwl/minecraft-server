## Port of pumpkin-protocol/src/java/client/play/remove_entities.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CRemoveEntities* = object
    ## Instructs the client to remove (despawn) one or more entities.
    entityIds*: seq[VarInt]

proc toId*(_: typedesc[CRemoveEntities]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_REMOVE_ENTITIES.toId(v)

proc writePacket*(p: CRemoveEntities; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.entityIds.len)))
  for id in p.entityIds:
    writeVarInt(w, id)
  writeOkVoid()
