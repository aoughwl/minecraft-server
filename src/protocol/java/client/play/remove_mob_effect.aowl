## Port of pumpkin-protocol/src/java/client/play/remove_mob_effect.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CRemoveMobEffect* = object
    entityId*: VarInt
    effectId*: VarInt

proc toId*(_: typedesc[CRemoveMobEffect]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_REMOVE_MOB_EFFECT.toId(v)

proc writePacket*(p: CRemoveMobEffect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, p.effectId)
  writeOkVoid()
