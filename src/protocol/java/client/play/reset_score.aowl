## Port of pumpkin-protocol/src/java/client/play/reset_score.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

type
  CResetScore* = object
    entityName*: string
    objectiveName*: Option[string]

proc toId*(_: typedesc[CResetScore]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_RESET_SCORE.toId(v)

proc writePacket*(p: CResetScore; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.entityName)
  writeBool(w, p.objectiveName.isSome)
  if p.objectiveName.isSome:
    tryWrite writeString(w, p.objectiveName.unsafeGet)
  writeOkVoid()
