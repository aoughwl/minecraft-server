## Play-state resource pack packets, `CB_PLAY_RESOURCE_PACK_PUSH` and `CB_PLAY_RESOURCE_PACK_POP` (the config-state push is
## config/add_resource_pack.aowl; upstream's play versions are in the newer tree's java-player host). Same body as config.
import std/options
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../uuid
import playwire
import ../../../../util/text/text

type
  CPlayResourcePackPush* = object
    uuid*: Uuid
    url*: string
    hash*: string  ## max 40
    forced*: bool
    promptMessage*: Option[TextComponent]

  CPlayResourcePackPop* = object
    uuid*: Option[Uuid]  ## none clears every pack

proc toId*(_: typedesc[CPlayResourcePackPush]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_RESOURCE_PACK_PUSH.toId(v)

proc writePacket*(p: CPlayResourcePackPush; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeUuid(w, p.uuid)
  tryWrite writeString(w, p.url)
  tryWrite writeString(w, p.hash)
  writeBool(w, p.forced)
  writeBool(w, p.promptMessage.isSome)
  if p.promptMessage.isSome:
    tryWrite writeText(w, p.promptMessage.unsafeGet)
  writeOkVoid()

proc toId*(_: typedesc[CPlayResourcePackPop]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_RESOURCE_PACK_POP.toId(v)

proc writePacket*(p: CPlayResourcePackPop; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.uuid.isSome)
  if p.uuid.isSome:
    writeUuid(w, p.uuid.unsafeGet)
  writeOkVoid()
