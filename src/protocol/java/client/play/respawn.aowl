## Port of pumpkin-protocol/src/java/client/play/respawn.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import player_spawn_data

export player_spawn_data

const
  KeepAttributeModifiers* = 1'u8
  KeepEntityData* = 2'u8
  KeepAllData* = 3'u8

type
  CRespawn* = object
    playerSpawnInfo*: PlayerSpawnData
    dataKept*: uint8

proc toId*(_: typedesc[CRespawn]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_RESPAWN.toId(v)

proc writePacket*(p: CRespawn; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writePacket(p.playerSpawnInfo, w, v)
  writeI8(w, cast[int8](p.dataKept))
  writeOkVoid()
