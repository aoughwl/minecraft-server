## Port of pumpkin-protocol/src/java/client/play/select_advancements_tab.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../../util/identifier

type
  CSelectAdvancementsTab* = object
    tabId*: Option[Identifier]

proc toId*(_: typedesc[CSelectAdvancementsTab]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SELECT_ADVANCEMENTS_TAB.toId(v)

proc writePacket*(p: CSelectAdvancementsTab; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.tabId.isSome)
  if p.tabId.isSome:
    tryWrite writeString(w, $p.tabId.unsafeGet)
  writeOkVoid()
