## Port of pumpkin-protocol/src/java/client/play/server_links.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
## Upstream declares this packet without a `ClientPacket` impl, so it cannot send it. This writes
## what `CConfigServerLinks`, the identical configuration packet, writes.
## `Label`, `Link` and `Link::write` are lib.rs's, in proto.aowl.
import ../../../proto

export proto

type
  CPlayServerLinks* = object
    links*: seq[Link]

proc toId*(_: typedesc[CPlayServerLinks]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SERVER_LINKS.toId(v)

proc writePacket*(p: CPlayServerLinks; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.links.len)))
  for link in p.links:
    tryWrite link.write(w)
  writeOkVoid()
