## Port of pumpkin-protocol/src/java/client/play/server_links.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
## Upstream declares this packet without a `ClientPacket` impl, so it cannot send it. This writes
## what `CConfigServerLinks`, the identical configuration packet, writes.
## `Label` and `Link` are lib.rs's, here with the real TextComponent: proto.aowl's hold the old stub.
import ../../../proto except Label, LabelKind, Link, newLink, lkBuiltIn, lkTextComponent
import ../../../../util/text/text

export LinkType

type
  LabelKind* = enum
    lkBuiltIn
    lkTextComponent

  Label* = object
    case kind*: LabelKind
    of lkBuiltIn: builtIn*: LinkType
    of lkTextComponent: textComponent*: TextComponent

  Link* = object
    isBuiltIn*: bool
    label*: Label
    url*: string

  CPlayServerLinks* = object
    links*: seq[Link]

proc newLink*(label: Label; url: string): Link =
  Link(isBuiltIn: label.kind == lkBuiltIn, label: label, url: url)

proc write*(self: Link; w: var NetWriter): ProtoWriteVoidResult =
  case self.label.kind
  of lkBuiltIn:
    writeBool(w, true)
    writeVarInt(w, newVarInt(int32(ord(self.label.builtIn))))
  of lkTextComponent:
    writeBool(w, false)
    tryWrite writeText(w, self.label.textComponent)
  writeString(w, self.url)

proc toId*(_: typedesc[CPlayServerLinks]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SERVER_LINKS.toId(v)

proc writePacket*(p: CPlayServerLinks; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.links.len)))
  for link in p.links:
    tryWrite link.write(w)
  writeOkVoid()
