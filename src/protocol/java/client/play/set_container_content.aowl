## Port of pumpkin-protocol/src/java/client/play/set_container_content.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  CSetContainerContent* = object
    windowId*: VarInt
    stateId*: VarInt
    slotData*: seq[ItemStackSerializer]
    carriedItem*: ItemStackSerializer

proc toId*(_: typedesc[CSetContainerContent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CONTAINER_SET_CONTENT.toId(v)

proc writePacket*(p: CSetContainerContent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.windowId)
  writeVarInt(w, p.stateId)
  if p.slotData.len > int(int32.high):
    return writeErrVoid(messageWrite($p.slotData.len & " slot entries do not fit in VarInt"))
  writeVarInt(w, newVarInt(int32(p.slotData.len)))
  for stack in p.slotData:
    tryWrite stack.writeWithVersion(w, v)
  tryWrite p.carriedItem.writeWithVersion(w, v)
  writeOkVoid()
