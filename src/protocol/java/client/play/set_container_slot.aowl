## Port of pumpkin-protocol/src/java/client/play/set_container_slot.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  CSetContainerSlot* = object
    windowId*: int8
    stateId*: VarInt
    slot*: int16
    slotData*: ItemStackSerializer

proc toId*(_: typedesc[CSetContainerSlot]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_CONTAINER_SET_SLOT.toId(v)

proc writePacket*(p: CSetContainerSlot; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI8(w, p.windowId)
  writeVarInt(w, p.stateId)
  writeI16Be(w, p.slot)
  tryWrite p.slotData.writeWithVersion(w, v)
  writeOkVoid()
