## Port of pumpkin-protocol/src/java/client/play/set_entity_link.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetEntityLink* = object
    ## Attaches (leashes) or detaches an entity to another entity (leash knot, player, mob).
    attachedEntityId*: int32
    holdingEntityId*: int32

proc toId*(_: typedesc[CSetEntityLink]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_ENTITY_LINK.toId(v)

proc writePacket*(p: CSetEntityLink; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.attachedEntityId)
  writeI32Be(w, p.holdingEntityId)
  writeOkVoid()
