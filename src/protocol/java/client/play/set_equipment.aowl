## Port of pumpkin-protocol/src/java/client/play/set_equipment.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  CSetEquipment* = object
    entityId*: VarInt
    equipment*: seq[(int8, ItemStackSerializer)]

proc toId*(_: typedesc[CSetEquipment]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_EQUIPMENT.toId(v)

proc writePacket*(p: CSetEquipment; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  for i in 0 ..< p.equipment.len:
    let slot = p.equipment[i][0]
    if i == p.equipment.len - 1:
      writeI8(w, slot)
    else:
      writeI8(w, slot or -128'i8)
    tryWrite p.equipment[i][1].writeWithVersion(w, v)
  writeOkVoid()
