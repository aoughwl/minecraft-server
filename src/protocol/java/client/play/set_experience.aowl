## Port of pumpkin-protocol/src/java/client/play/set_experience.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetExperience* = object
    progress*: float32
    level*: VarInt
    totalExperience*: VarInt

proc toId*(_: typedesc[CSetExperience]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_EXPERIENCE.toId(v)

proc writePacket*(p: CSetExperience; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeF32(w, p.progress)
  writeVarInt(w, p.level)
  writeVarInt(w, p.totalExperience)
  writeOkVoid()
