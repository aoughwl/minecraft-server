## Port of pumpkin-protocol/src/java/client/play/set_health.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetHealth* = object
    health*: float32
    food*: VarInt
    foodSaturation*: float32

proc toId*(_: typedesc[CSetHealth]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_HEALTH.toId(v)

proc writePacket*(p: CSetHealth; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeF32(w, p.health)
  writeVarInt(w, p.food)
  writeF32(w, p.foodSaturation)
  writeOkVoid()
