## Port of pumpkin-protocol/src/java/client/play/set_held_item.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetSelectedSlot* = object
    slot*: int8

proc toId*(_: typedesc[CSetSelectedSlot]; v: JavaMinecraftVersion): int32 =
  if v >= jmvV1_21_2:
    CB_PLAY_SET_HELD_SLOT.toId(v)
  elif v == jmvV1_21:
    CB_PLAY_SET_CARRIED_ITEM.toId(v)
  else:
    CB_PLAY_SET_HELD_SLOT.toId(v)

proc writePacket*(p: CSetSelectedSlot; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI8(w, p.slot)
  writeOkVoid()
