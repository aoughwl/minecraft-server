## Port of pumpkin-protocol/src/java/client/play/set_passengers.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CSetPassengers* = object
    entityId*: VarInt
    passengers*: seq[VarInt]

proc toId*(_: typedesc[CSetPassengers]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_PASSENGERS.toId(v)

proc writePacket*(p: CSetPassengers; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, newVarInt(int32(p.passengers.len)))
  for passenger in p.passengers:
    writeVarInt(w, passenger)
  writeOkVoid()
