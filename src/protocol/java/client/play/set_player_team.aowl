## Port of pumpkin-protocol/src/java/client/play/set_player_team.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import std/options
import ../../../../util/text/text

type
  TeamMethod* = enum
    tmCreate = 0
    tmRemove = 1
    tmUpdate = 2
    tmAddPlayers = 3
    tmRemovePlayers = 4

  TeamParameters* = object
    displayName*: TextComponent
    options*: int8
    nametagVisibility*: string
    collisionRule*: string
    color*: int32
    playerPrefix*: TextComponent
    playerSuffix*: TextComponent

  CSetPlayerTeam* = object
    teamName*: string
    teamMethod*: TeamMethod   ## Upstream's `method`, a keyword here.
    parameters*: Option[TeamParameters]
    players*: seq[string]

proc toId*(_: typedesc[CSetPlayerTeam]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_PLAYER_TEAM.toId(v)

proc writePacket*(p: CSetPlayerTeam; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.teamName)
  writeI8(w, int8(ord(p.teamMethod)))

  case p.teamMethod
  of tmCreate, tmUpdate:
    if p.parameters.isSome:
      let params = p.parameters.unsafeGet
      tryWrite writeText(w, params.displayName)
      writeI8(w, params.options)
      tryWrite writeString(w, params.nametagVisibility)
      tryWrite writeString(w, params.collisionRule)
      writeVarInt(w, newVarInt(params.color))
      tryWrite writeText(w, params.playerPrefix)
      tryWrite writeText(w, params.playerSuffix)
    else:
      return writeErrVoid(messageWrite("Parameters missing for Create/Update"))
  else:
    discard

  case p.teamMethod
  of tmCreate, tmAddPlayers, tmRemovePlayers:
    writeVarInt(w, newVarInt(int32(p.players.len)))
    for player in p.players:
      tryWrite writeString(w, player)
  else:
    discard

  writeOkVoid()
