## Port of pumpkin-protocol/src/java/client/play/set_time.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CUpdateTime* = object
    gameTime*: int64
    clockUpdates*: seq[(int32, int64, float32, float32)]
      ## (clock_registry_id, total_ticks, partial_tick, rate)

proc newCUpdateTime*(gameTime, dayTime: int64; increasing: bool): CUpdateTime =
  let overworldId = 0'i32
  let partialTick = 0.0'f32
  let rate = if increasing: 1.0'f32 else: 0.0'f32  # Normal speed
  CUpdateTime(gameTime: gameTime, clockUpdates: @[(overworldId, dayTime, partialTick, rate)])

proc toId*(_: typedesc[CUpdateTime]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_TIME.toId(v)

proc writePacket*(p: CUpdateTime; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.gameTime)

  if v >= jmvV26_1:
    writeVarInt(w, newVarInt(int32(p.clockUpdates.len)))
    for update in p.clockUpdates:
      writeVarInt(w, newVarInt(update[0]))
      writeVarLong(w, newVarLong(update[1]))
      writeF32Be(w, update[2])
      writeF32Be(w, update[3])
  else:
    var dayTime = 0'i64
    var rate = 1.0'f32  # Fallback defaults
    if p.clockUpdates.len > 0:
      dayTime = p.clockUpdates[0][1]
      rate = p.clockUpdates[0][3]

    writeI64Be(w, dayTime)

    if v >= jmvV1_21_2:
      let isIncreasing = rate > 0.0'f32
      writeBool(w, isIncreasing)
  writeOkVoid()
