## Port of pumpkin-protocol/src/java/client/play/set_title.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/text/text

type
  CTitleText* = object
    title*: TextComponent

proc toId*(_: typedesc[CTitleText]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_TITLE_TEXT.toId(v)

proc writePacket*(p: CTitleText; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.title)
  writeOkVoid()
