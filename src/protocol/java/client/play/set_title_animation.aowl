## Port of pumpkin-protocol/src/java/client/play/set_title_animation.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CTitleAnimation* = object
    fadeInTicks*: int32
    stayTicks*: int32
    fadeOutTicks*: int32

proc toId*(_: typedesc[CTitleAnimation]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_TITLES_ANIMATION.toId(v)

proc writePacket*(p: CTitleAnimation; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.fadeInTicks)
  writeI32Be(w, p.stayTicks)
  writeI32Be(w, p.fadeOutTicks)
  writeOkVoid()
