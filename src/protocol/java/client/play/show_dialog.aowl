## Port of pumpkin-protocol/src/java/client/play/show_dialog.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../dialog

type
  CPlayShowDialog* = object
    dialog*: IdOr[DialogNBT]

proc toId*(_: typedesc[CPlayShowDialog]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SHOW_DIALOG.toId(v)

proc writePacket*(p: CPlayShowDialog; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  # `IdOr::write`, inline, as config/show_dialog.aowl has it.
  case p.dialog.kind
  of iokId:
    writeVarInt(w, newVarInt(int32(p.dialog.id) + 1))
    writeOkVoid()
  of iokValue:
    writeVarInt(w, newVarInt(0))
    writePacketData(p.dialog.value, w, v)
