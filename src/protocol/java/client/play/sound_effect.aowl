## Port of pumpkin-protocol/src/java/client/play/sound_effect.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../generated/sound_category
import ../../../../generated/sound_id_remap
import ../../../../util/vector3
import ../../../../util/math/rustnum

export sound_category

proc asI64(value: float64): int64 =
  ## `as i64`: NaN gives 0, out-of-range values saturate.
  if value != value: 0'i64
  elif value >= 9223372036854775808.0'f64: int64.high
  elif value <= -9223372036854775808.0'f64: int64.low
  else: int64(value)

type
  CSoundEffect* = object
    soundEvent*: IdOr[SoundEvent]
    soundCategory*: VarInt
    position*: Vector3[int32]
    volume*: float32
    pitch*: float32
    seed*: float64

proc newCSoundEffect*(soundEvent: IdOr[SoundEvent]; soundCategory: SoundCategory; position: Vector3[float64];
    volume, pitch: float32; seed: float64): CSoundEffect =
  CSoundEffect(
    soundEvent: soundEvent,
    soundCategory: newVarInt(int32(ord(soundCategory))),
    position: Vector3[int32](
      x: asI32(position.x * 8.0),
      y: asI32(position.y * 8.0),
      z: asI32(position.z * 8.0)),
    volume: volume,
    pitch: pitch,
    seed: seed)

proc toId*(_: typedesc[CSoundEffect]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SOUND.toId(v)

proc writePacket*(p: CSoundEffect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  case p.soundEvent.kind
  of iokId:
    # `IdOr::write` is id + 1, after the remap.
    writeVarInt(w, newVarInt(int32(remapSoundIdForVersion(p.soundEvent.id, v)) + 1))
  of iokValue:
    writeVarInt(w, newVarInt(0))
    tryWrite writeSoundEvent(w, p.soundEvent.value)
  writeVarInt(w, p.soundCategory)
  writeI32Be(w, p.position.x)
  writeI32Be(w, p.position.y)
  writeI32Be(w, p.position.z)
  writeF32Be(w, p.volume)
  writeF32Be(w, p.pitch)
  writeI64Be(w, asI64(p.seed))
  writeOkVoid()
