## Port of pumpkin-protocol/src/java/client/play/spawn_entity.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../lpvector3d
import ../../../../generated/block_state_remap
import ../../../../generated/entity_id_remap
import ../../../../generated/entity_type
import ../../../../util/uuid
import ../../../../util/vector3

proc floorf(a: cfloat): cfloat {.importc: "floorf", header: "<math.h>".}
proc fmodf(a, b: cfloat): cfloat {.importc: "fmodf", header: "<math.h>".}

proc remEuclid(a, b: float32): float32 =
  ## `f32::rem_euclid`.
  let r = float32(fmodf(cfloat(a), cfloat(b)))
  if r < 0.0'f32: r + abs(b) else: r

proc angleByte(value: float32): uint8 =
  ## `(value * 256.0 / 360.0).floor() as u8`: NaN gives 0, out-of-range values saturate.
  let f = float32(floorf(cfloat(value * 256.0'f32 / 360.0'f32)))
  if f != f or f <= 0.0'f32: 0'u8
  elif f >= 255.0'f32: 255'u8
  else: uint8(f)

type
  CSpawnEntity* = object
    entityId*: VarInt
    entityUuid*: Uuid
    typ*: VarInt             ## Upstream's `r#type`.
    position*: Vector3[float64]
    velocity*: LpVector3d
    pitch*: uint8            ## angle
    yaw*: uint8              ## angle
    headYaw*: uint8          ## angle
    data*: VarInt

proc newCSpawnEntity*(entityId: VarInt; entityUuid: Uuid; typ: VarInt; position: Vector3[float64];
    pitch, yaw, headYaw: float32; data: VarInt; velocity: Vector3[float64]): CSpawnEntity =
  CSpawnEntity(
    entityId: entityId,
    entityUuid: entityUuid,
    typ: typ,
    position: position,
    pitch: angleByte(pitch),
    yaw: angleByte(remEuclid(yaw, 360.0'f32)),
    headYaw: angleByte(remEuclid(headYaw, 360.0'f32)),
    data: data,
    velocity: LpVector3d(value: velocity))

proc toId*(_: typedesc[CSpawnEntity]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_ADD_ENTITY.toId(v)

proc writePacket*(p: CSpawnEntity; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeUuid(w, p.entityUuid)
  let remappedType = newVarInt(int32(remapEntityIdForVersion(cast[uint16](p.typ.value), v)))
  writeVarInt(w, remappedType)

  writeF64Be(w, p.position.x)
  writeF64Be(w, p.position.y)
  writeF64Be(w, p.position.z)

  # Angles
  if v >= jmvV1_21_9:
    p.velocity.write(w)
  writeU8(w, p.pitch)
  writeU8(w, p.yaw)
  writeU8(w, p.headYaw)

  var data = p.data
  if p.typ.value == int32(EntityType.FALLING_BLOCK.id) and p.data.value >= 0'i32 and p.data.value <= 65535'i32:
    data = newVarInt(int32(remapBlockStateForVersion(uint16(p.data.value), v)))
  writeVarInt(w, data)

  if v < jmvV1_21_9:
    p.velocity.writeLegacy(w)

  writeOkVoid()
