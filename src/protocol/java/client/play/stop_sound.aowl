## Port of pumpkin-protocol/src/java/client/play/stop_sound.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../../generated/sound_category
import ../../../../util/resource_location

export sound_category

const
  NoCategoryNoSound = 0'u8
  CategoryOnly = 1'u8
  SoundOnly = 2'u8
  CategoryAndSound = 3'u8

type
  CStopSound* = object
    soundId*: Option[ResourceLocation]
    category*: Option[SoundCategory]

proc toId*(_: typedesc[CStopSound]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_STOP_SOUND.toId(v)

proc writePacket*(p: CStopSound; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  if p.category.isSome and p.soundId.isSome:
    writeU8(w, CategoryAndSound)
    writeVarInt(w, newVarInt(int32(ord(p.category.unsafeGet))))
    writeString(w, p.soundId.unsafeGet)
  elif p.category.isSome:
    writeU8(w, CategoryOnly)
    writeVarInt(w, newVarInt(int32(ord(p.category.unsafeGet))))
    writeOkVoid()
  elif p.soundId.isSome:
    writeU8(w, SoundOnly)
    writeString(w, p.soundId.unsafeGet)
  else:
    writeU8(w, NoCategoryNoSound)
    writeOkVoid()
