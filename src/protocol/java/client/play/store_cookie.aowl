## Port of pumpkin-protocol/src/java/client/play/store_cookie.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/resource_location

type
  CStoreCookie* = object
    ## Stores some arbitrary data on the client, which persists between server transfers.
    ## The Notchian client only accepts cookies of up to 5 kiB in size.
    key*: ResourceLocation
    payload*: seq[byte]  # 5120

proc toId*(_: typedesc[CStoreCookie]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_STORE_COOKIE.toId(v)

proc writePacket*(p: CStoreCookie; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.key)
  writeVarInt(w, newVarInt(int32(p.payload.len)))
  writeSlice(w, p.payload)
  writeOkVoid()
