## Port of pumpkin-protocol/src/java/client/play/subtitle.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/text/text

type
  CSubtitle* = object
    subtitle*: TextComponent

proc toId*(_: typedesc[CSubtitle]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_SUBTITLE_TEXT.toId(v)

proc writePacket*(p: CSubtitle; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.subtitle)
  writeOkVoid()
