## Port of pumpkin-protocol/src/java/client/play/system_chat_message.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/text/text

type
  CSystemChatMessage* = object
    content*: TextComponent
    overlay*: bool

proc toId*(_: typedesc[CSystemChatMessage]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SYSTEM_CHAT.toId(v)

proc writePacket*(p: CSystemChatMessage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.content)
  writeBool(w, p.overlay)
  writeOkVoid()
