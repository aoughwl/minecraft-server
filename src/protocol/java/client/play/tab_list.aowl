## Port of pumpkin-protocol/src/java/client/play/tab_list.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../util/text/text

type
  CTabList* = object
    ## Updates the header and footer of the player list (Tab List).
    header*: TextComponent
    footer*: TextComponent

proc toId*(_: typedesc[CTabList]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_TAB_LIST.toId(v)

proc writePacket*(p: CTabList; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeText(w, p.header)
  tryWrite writeText(w, p.footer)
  writeOkVoid()
