## Port of pumpkin-protocol/src/java/client/play/take_item.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CTakeItemEntity* = object
    entityId*: VarInt           ## The entity id of the item entity.
    collectorEntityId*: VarInt  ## The entity id of the entity who is collecting the item.
    stackAmount*: VarInt        ## The Number of items in the Stack

proc toId*(_: typedesc[CTakeItemEntity]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_TAKE_ITEM_ENTITY.toId(v)

proc writePacket*(p: CTakeItemEntity; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, p.collectorEntityId)
  writeVarInt(w, p.stackAmount)
  writeOkVoid()
