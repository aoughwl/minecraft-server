## Port of pumpkin-protocol/src/java/client/play/teleport_entity.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto
import ../../../../util/vector3

type
  CTeleportEntity* = object
    ## Only used when teleporting a player's vehicle, this packet is sent to the player.
    entityId*: VarInt
    position*: Vector3[float64]
    delta*: Vector3[float64]
    yaw*: float32
    pitch*: float32
    relatives*: seq[PositionFlag]
    onGround*: bool

proc toId*(_: typedesc[CTeleportEntity]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_TELEPORT_ENTITY.toId(v)

proc writePacket*(p: CTeleportEntity; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeF64Be(w, p.position.x)
  writeF64Be(w, p.position.y)
  writeF64Be(w, p.position.z)
  writeF64Be(w, p.delta.x)
  writeF64Be(w, p.delta.y)
  writeF64Be(w, p.delta.z)
  writeF32Be(w, p.yaw)
  writeF32Be(w, p.pitch)
  # not sure about that
  writeI32Be(w, getBitfield(p.relatives))
  writeBool(w, p.onGround)
  writeOkVoid()
