{.feature: "untyped".}
## Test for the client/play packets that carry text or NBT: reset_score, server_links, set_player_team,
## set_title, set_title_animation, show_dialog, subtitle, system_chat_message, tab_list, update_advancement,
## update_objectives, update_score. Exact bytes for protocol 774.
import std/[options, strutils]
import std/assertions
import playtestutil
import ../../../protobase, ../../../varint
import ../../../proto except NumberFormat, NumberFormatKind, nfBlank, nfStyled, nfFixed, Label, LabelKind, Link, newLink, lkBuiltIn, lkTextComponent
import ../../../../nbt/tag
import ../../../../util/javaversion
import ../../../../util/text/text
import ../dialog
import reset_score, server_links, set_player_team, set_title, set_title_animation, show_dialog, subtitle,
  system_chat_message, tab_list, update_advancement, update_objectives, update_score

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

proc strHex(s: string): string =
  var b = @[byte(s.len)]
  for c in s:
    b.add(byte(c))
  hexOf(b)

proc txt(s: string): string =
  ## `TextComponent::text(s).encode()`, written out by hand for a short s: unnamed network NBT of {text: s}.
  var b = @[0x0A'u8, 0x08, 0x00, 0x04, byte('t'), byte('e'), byte('x'), byte('t'), 0x00, byte(s.len)]
  for c in s:
    b.add(byte(c))
  b.add(0x00'u8)
  hexOf(b)

block plainText:
  eqHex(text("hi").encode(), "0a 08 0004 74657874 0002 6869 00", "text encoding")
  eqHex(full(CTitleText, CTitleText(title: text("hi")), V), "70" & txt("hi"), "set_title")
  eqHex(full(CSubtitle, CSubtitle(subtitle: text("hi")), V), "6e" & txt("hi"), "subtitle")
  eqHex(full(CSystemChatMessage, CSystemChatMessage(content: text("hi"), overlay: true), V), "77" & txt("hi") & "01", "system_chat_message")
  eqHex(full(CTabList, CTabList(header: text("a"), footer: text("b")), V), "78" & txt("a") & txt("b"), "tab_list")
  eqHex(full(CTitleAnimation, CTitleAnimation(fadeInTicks: 1'i32, stayTicks: 2'i32, fadeOutTicks: 3'i32), V),
    "71 00000001 00000002 00000003", "set_title_animation")

block realComponents:
  # Not the stub: style and children reach the wire.
  let styled = text("hi").bold()
  assert hexOf(styled.encode()) != hexOf(text("hi").encode())
  eqHex(full(CSubtitle, CSubtitle(subtitle: styled), V), "6e" & hexOf(styled.encode()), "subtitle, styled")

block tooLong:
  # A string too long for NBT is an error, not a corrupt stream.
  var long = newString(70000)
  for i in 0 ..< long.len:
    long[i] = 'a'
  var w = newNetWriter()
  assert not writePacket(CTitleText(title: text(long)), w, V).isOk

block resetScore:
  eqHex(full(CResetScore, CResetScore(entityName: "a", objectiveName: none[string]()), V), "4d 01 61 00", "reset_score none")
  eqHex(full(CResetScore, CResetScore(entityName: "a", objectiveName: some("b")), V), "4d 01 61 01 01 62", "reset_score some")

block links:
  let builtIn = newLink(Label(kind: lkBuiltIn, builtIn: ltSupport), "u")
  let named = newLink(Label(kind: lkTextComponent, textComponent: text("x")), "v")
  assert builtIn.isBuiltIn and not named.isBuiltIn
  eqHex(full(CPlayServerLinks, CPlayServerLinks(links: @[builtIn, named]), V),
    "8701 02 01 02 01 75 00" & txt("x") & "01 76", "server_links")

block team:
  let params = TeamParameters(displayName: text("d"), options: 3'i8, nametagVisibility: "always",
    collisionRule: "never", color: 21'i32, playerPrefix: text("p"), playerSuffix: text("s"))
  let paramsHex = txt("d") & "03" & strHex("always") & strHex("never") & "15" & txt("p") & txt("s")
  eqHex(full(CSetPlayerTeam, CSetPlayerTeam(teamName: "t", teamMethod: tmCreate, parameters: some(params), players: @["a", "b"]), V),
    "6b 01 74 00" & paramsHex & "02 01 61 01 62", "team create")
  eqHex(full(CSetPlayerTeam, CSetPlayerTeam(teamName: "t", teamMethod: tmRemove, parameters: none[TeamParameters](), players: @["a"]), V),
    "6b 01 74 01", "team remove")
  eqHex(full(CSetPlayerTeam, CSetPlayerTeam(teamName: "t", teamMethod: tmUpdate, parameters: some(params), players: @["a"]), V),
    "6b 01 74 02" & paramsHex, "team update")
  eqHex(full(CSetPlayerTeam, CSetPlayerTeam(teamName: "t", teamMethod: tmAddPlayers, parameters: none[TeamParameters](), players: @["a"]), V),
    "6b 01 74 03 01 01 61", "team add")
  eqHex(full(CSetPlayerTeam, CSetPlayerTeam(teamName: "t", teamMethod: tmRemovePlayers, parameters: none[TeamParameters](), players: @["a"]), V),
    "6b 01 74 04 01 01 61", "team remove players")
  var w = newNetWriter()
  assert not writePacket(CSetPlayerTeam(teamName: "t", teamMethod: tmCreate, parameters: none[TeamParameters](), players: @[]), w, V).isOk

block objectives:
  let fmtBlank = NumberFormat(kind: nfBlank)
  let fmtFixed = NumberFormat(kind: nfFixed, fixedText: text("f"))
  let fmtStyled = NumberFormat(kind: nfStyled, style: Style())
  template objective(mode: Mode; format: Option[NumberFormat]): CUpdateObjectives =
    newCUpdateObjectives("o", mode, text("d"), rtHearts, format)
  eqHex(full(CUpdateObjectives, objective(mAdd, none[NumberFormat]()), V), "68 01 6f 00" & txt("d") & "01 00", "objective add")
  eqHex(full(CUpdateObjectives, objective(mUpdate, some(fmtBlank)), V), "68 01 6f 02" & txt("d") & "01 01 00", "objective update, blank")
  eqHex(full(CUpdateObjectives, objective(mAdd, some(fmtFixed)), V), "68 01 6f 00" & txt("d") & "01 01 02" & txt("f"), "objective add, fixed")
  # Here a style goes on the wire, as an empty compound for an empty style.
  eqHex(full(CUpdateObjectives, objective(mAdd, some(fmtStyled)), V), "68 01 6f 00" & txt("d") & "01 01 01 0a 00", "objective add, styled")
  eqHex(full(CUpdateObjectives, objective(mRemove, some(fmtBlank)), V), "68 01 6f 01", "objective remove")

block score:
  eqHex(full(CUpdateScore, CUpdateScore.newRemove("e", "o"), V), "6c 01 65 01 6f 00 00 00", "score, new_remove")
  let p = CUpdateScore(entityName: "e", objectiveName: "o", value: newVarInt(300),
    displayName: some(text("d")), numberFormat: some(NumberFormat(kind: nfFixed, fixedText: text("f"))))
  eqHex(full(CUpdateScore, p, V), "6c 01 65 01 6f ac02 01" & txt("d") & "01 02" & txt("f"), "score, all")
  # Upstream's NumberFormat::write has "TODO: Style write": the variant id and no style.
  let styled = CUpdateScore(entityName: "e", objectiveName: "o", value: newVarInt(1), displayName: none[TextComponent](),
    numberFormat: some(NumberFormat(kind: nfStyled, style: Style())))
  eqHex(full(CUpdateScore, styled, V), "6c 01 65 01 6f 01 00 01 01", "score, styled")

block dialog:
  var compound = newCompound()
  compound.put("a", "b")
  let id = CPlayShowDialog(dialog: IdOr[DialogNBT](kind: iokId, id: 4'u16))
  eqHex(full(CPlayShowDialog, id, V), "8a01 05", "show_dialog by id")
  let direct = CPlayShowDialog(dialog: IdOr[DialogNBT](kind: iokValue, value: fromNbt(compound)))
  eqHex(full(CPlayShowDialog, direct, V), "8a01 00 0a 08 0001 61 0001 62 00", "show_dialog direct")

block advancement:
  let empty = CUpdateAdvancements(reset: true, added: @[], removed: @[], progress: @[], showAdvancements: false)
  eqHex(full(CUpdateAdvancements, empty, V), "8001 01 00 00 00 00", "advancements, nothing")

  let root = fromStatic("minecraft", "story/root")
  let display = AdvancementDisplay(title: "t.key", description: "d.key", itemIcon: "stone", frameType: FrameType.Goal,
    backgroundTexture: some("b:g"), showToast: true, hidden: false, announceToChat: true, x: 1.0'f32, y: 2.0'f32)
  let adv = Advancement(id: fromStatic("minecraft", "story/next"), parent: some(root), sendTelemetry: true,
    display: some(display), reward: AdvancementReward(experience: 0'i32, recipes: @[]),
    requirements: @[@["c1", "c2"], @["c3"]], criteria: @[])
  let bare = Advancement(id: root, parent: none[Identifier](), sendTelemetry: false,
    display: none[AdvancementDisplay](), reward: AdvancementReward(experience: 0'i32, recipes: @[]),
    requirements: @[], criteria: @[])
  let p = CUpdateAdvancements(reset: false, added: @[adv, bare], removed: @[root],
    progress: @[AdvancementProgressData(id: root, progress: @[
      Criteria(criterionId: "c1", achieveDate: some(5'i64)),
      Criteria(criterionId: "c2", achieveDate: none[int64]())])],
    showAdvancements: true)
  eqHex(full(CUpdateAdvancements, p, V),
    "8001 00 02" &
      # story/next: parent, then a display
      strHex("minecraft:story/next") & "01" & strHex("minecraft:story/root") & "01" &
      hexOf(translate("t.key").encode()) & hexOf(translate("d.key").encode()) &
      "01010000" &                 # icon: count first on 774, stone is id 1
      "02" &                       # frame: goal
      "00000003" &                 # flags: background | toast
      strHex("b:g") & "3f800000 40000000" &
      "02 02" & strHex("c1") & strHex("c2") & "01" & strHex("c3") & "01" &
      # story/root: nothing but its id
      strHex("minecraft:story/root") & "00 00 00 00" &
    "01" & strHex("minecraft:story/root") &
    "01" & strHex("minecraft:story/root") & "02" &
      strHex("c1") & "01 0000000000000005" & strHex("c2") & "00" &
    "01", "advancements, all")

  # 26.1 writes a template stack id first.
  let icon = CUpdateAdvancements(reset: false, added: @[adv], removed: @[], progress: @[], showAdvancements: false)
  var w = newNetWriter()
  assert writePacket(icon, w, jmvV26_1).isOk
  assert hexOf(w.buf).find("01010000") >= 0

echo "ok"
