## Port of pumpkin-protocol/src/java/client/play/ticking_state.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CTickingState* = object
    tickRate*: float32
    isFrozen*: bool

proc toId*(_: typedesc[CTickingState]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_TICKING_STATE.toId(v)

proc writePacket*(p: CTickingState; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeF32Be(w, p.tickRate)
  writeBool(w, p.isFrozen)
  writeOkVoid()
