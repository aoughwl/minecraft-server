## Port of pumpkin-protocol/src/java/client/play/ticking_step.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CTickingStep* = object
    tickSteps*: VarInt

proc toId*(_: typedesc[CTickingStep]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_TICKING_STEP.toId(v)

proc writePacket*(p: CTickingStep; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.tickSteps)
  writeOkVoid()
