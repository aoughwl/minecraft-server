## Port of pumpkin-protocol/src/java/client/play/update_advancement.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
## `display.item_icon` is an `ItemStack` upstream and the bare item name in src/generated/advancement.aowl.
## It is resolved through the item table here, with an empty stack for a name the table lacks, as
## `itemIconStack` in src/data/advancement_data.aowl does, because itemstackserializer's stack is
## datacomponent.aowl's rather than src/data/item_stack's.
import std/options
import ../../../itemstackserializer
import ../../../datacomponent
import ../../../../data/advancement_data
import ../../../../generated/item as itemdata
import ../../../../util/text/text

export advancement_data

type
  CUpdateAdvancements* = object
    reset*: bool
    added*: seq[Advancement]
    removed*: seq[Identifier]
    progress*: seq[AdvancementProgressData]
    showAdvancements*: bool

proc iconStack(display: AdvancementDisplay): ItemStack =
  let (found, item) = itemByName(display.itemIcon)
  if found: newItemStack(1'u8, uint16(item.id), newSeq[PatchEntry]()) else: emptyItemStack()

proc toId*(_: typedesc[CUpdateAdvancements]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_UPDATE_ADVANCEMENTS.toId(v)

proc writePacket*(p: CUpdateAdvancements; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeBool(w, p.reset)

  writeVarInt(w, newVarInt(int32(p.added.len)))
  for adv in p.added:
    tryWrite writeString(w, $adv.id)

    writeBool(w, adv.parent.isSome)
    if adv.parent.isSome:
      tryWrite writeString(w, $adv.parent.unsafeGet)

    writeBool(w, adv.display.isSome)
    if adv.display.isSome:
      let display = adv.display.unsafeGet
      tryWrite writeText(w, display.getTitle())
      tryWrite writeText(w, display.getDescription())

      # Item icon
      let icon = ItemStackTemplateSerializer(stack: iconStack(display))
      tryWrite icon.writeWithVersion(w, v)

      writeVarInt(w, newVarInt(int32(ord(display.frameType))))
      let flags = int32(ord(display.hasBackground())) or
        (int32(ord(display.showToast)) shl 1) or
        (int32(ord(display.hidden)) shl 2)
      writeI32Be(w, flags)
      if display.backgroundTexture.isSome:
        tryWrite writeString(w, display.backgroundTexture.unsafeGet)
      writeF32Be(w, display.x)
      writeF32Be(w, display.y)

    writeVarInt(w, newVarInt(int32(adv.requirements.len)))
    for req in adv.requirements:
      writeVarInt(w, newVarInt(int32(req.len)))
      for r in req:
        tryWrite writeString(w, r)

    writeBool(w, adv.sendTelemetry)

  writeVarInt(w, newVarInt(int32(p.removed.len)))
  for rem in p.removed:
    tryWrite writeString(w, $rem)

  writeVarInt(w, newVarInt(int32(p.progress.len)))
  for prog in p.progress:
    tryWrite writeString(w, $prog.id)
    writeVarInt(w, newVarInt(int32(prog.progress.len)))
    for crit in prog.progress:
      tryWrite writeString(w, crit.criterionId)
      writeBool(w, crit.achieveDate.isSome)
      if crit.achieveDate.isSome:
        writeI64Be(w, crit.achieveDate.unsafeGet)

  writeBool(w, p.showAdvancements)
  writeOkVoid()
