## Port of pumpkin-protocol/src/java/client/play/update_attributes.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  AttributeModifier* = object
    id*: string
    amount*: float64
    operation*: int8

  Property* = object
    id*: VarInt
    value*: float64
    modifiers*: seq[AttributeModifier]

  CUpdateAttributes* = object
    entityId*: VarInt
    properties*: seq[Property]

proc toId*(_: typedesc[CUpdateAttributes]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_UPDATE_ATTRIBUTES.toId(v)

proc writePacket*(p: CUpdateAttributes; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, newVarInt(int32(p.properties.len)))
  for prop in p.properties:
    writeVarInt(w, prop.id)
    writeF64(w, prop.value)
    writeVarInt(w, newVarInt(int32(prop.modifiers.len)))
    for modifier in prop.modifiers:
      tryWrite writeString(w, modifier.id)
      writeF64(w, modifier.amount)
      writeU8(w, cast[uint8](modifier.operation))
  writeOkVoid()
