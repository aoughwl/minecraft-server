## Port of pumpkin-protocol/src/java/client/play/update_entity_pos.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

type
  CUpdateEntityPos* = object
    entityId*: VarInt
    delta*: Vector3[int16]
    onGround*: bool

proc toId*(_: typedesc[CUpdateEntityPos]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_MOVE_ENTITY_POS.toId(v)

proc writePacket*(p: CUpdateEntityPos; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeI16Be(w, p.delta.x)
  writeI16Be(w, p.delta.y)
  writeI16Be(w, p.delta.z)
  writeBool(w, p.onGround)
  writeOkVoid()
