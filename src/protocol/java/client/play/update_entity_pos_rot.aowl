## Port of pumpkin-protocol/src/java/client/play/update_entity_pos_rot.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

type
  CUpdateEntityPosRot* = object
    entityId*: VarInt
    delta*: Vector3[int16]
    yaw*: uint8
    pitch*: uint8
    onGround*: bool

proc toId*(_: typedesc[CUpdateEntityPosRot]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_MOVE_ENTITY_POS_ROT.toId(v)

proc writePacket*(p: CUpdateEntityPosRot; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeI16(w, p.delta.x)
  writeI16(w, p.delta.y)
  writeI16(w, p.delta.z)
  writeU8(w, p.yaw)
  writeU8(w, p.pitch)
  writeBool(w, p.onGround)
  writeOkVoid()
