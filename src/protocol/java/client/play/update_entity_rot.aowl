## Port of pumpkin-protocol/src/java/client/play/update_entity_rot.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CUpdateEntityRot* = object
    entityId*: VarInt
    yaw*: uint8
    pitch*: uint8
    onGround*: bool

proc toId*(_: typedesc[CUpdateEntityRot]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_MOVE_ENTITY_ROT.toId(v)

proc writePacket*(p: CUpdateEntityRot; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeU8(w, p.yaw)
  writeU8(w, p.pitch)
  writeBool(w, p.onGround)
  writeOkVoid()
