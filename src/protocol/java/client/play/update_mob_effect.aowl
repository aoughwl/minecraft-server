## Port of pumpkin-protocol/src/java/client/play/update_mob_effect.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CUpdateMobEffect* = object
    entityId*: VarInt
    effectId*: VarInt
    amplifier*: VarInt
    duration*: VarInt
    flags*: int8

proc toId*(_: typedesc[CUpdateMobEffect]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_UPDATE_MOB_EFFECT.toId(v)

proc writePacket*(p: CUpdateMobEffect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.entityId)
  writeVarInt(w, p.effectId)
  writeVarInt(w, p.amplifier)
  writeVarInt(w, p.duration)
  writeI8(w, p.flags)
  writeOkVoid()
