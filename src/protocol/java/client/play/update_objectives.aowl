## Port of pumpkin-protocol/src/java/client/play/update_objectives.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
## `NumberFormat` is lib.rs's, here with the real TextComponent and Style: proto.aowl's holds the old stub.
## Upstream's two writers really differ. This packet writes a `Styled` format's style as NBT; `write`, which
## CUpdateScore uses, stops after the variant id ("TODO: Style write"). A real client would misread the latter.
import std/options
import ../../../../nbt/[nbtbase, serializer]
import ../../../../util/text/text

type
  NumberFormatKind* = enum
    nfBlank   ## Show nothing.
    nfStyled  ## The styling to be used when formatting the score number.
    nfFixed   ## The text to be used as a placeholder.

  NumberFormat* = object
    case kind*: NumberFormatKind
    of nfBlank: discard
    of nfStyled: style*: Style
    of nfFixed: fixedText*: TextComponent

  Mode* = enum
    mAdd
    mRemove
    mUpdate

  RenderType* = enum
    rtInteger
    rtHearts

  CUpdateObjectives* = object
    objectiveName*: string
    mode*: uint8
    displayName*: TextComponent
    renderType*: VarInt
    numberFormat*: Option[NumberFormat]

proc write*(self: NumberFormat; w: var NetWriter): ProtoWriteVoidResult =
  ## `NumberFormat::write` from lib.rs.
  case self.kind
  of nfBlank:
    writeVarInt(w, newVarInt(0))
  of nfStyled:
    # Upstream: "TODO: Style write". The style's bytes are absent there too.
    writeVarInt(w, newVarInt(1))
  of nfFixed:
    writeVarInt(w, newVarInt(2))
    tryWrite writeText(w, self.fixedText)
  writeOkVoid()

proc writeStyleUnnamed(w: var NetWriter; style: Style): ProtoWriteVoidResult =
  ## `pumpkin_nbt::serializer::to_bytes_unnamed(style, p)`.
  var err = ""
  let s = toSer(style, err)
  if err.len > 0:
    return writeErrVoid(WritingError(kind: weSerde, msg: err))
  var nbtWriter = newNbtWriter(nwmJava)
  let res = serialize(serToNbt(s), nbtWriter)
  if not res.isOk:
    return writeErrVoid(WritingError(kind: weSerde, msg: res.error.msg))
  writeSlice(w, nbtWriter.buf)
  writeOkVoid()

proc newCUpdateObjectives*(objectiveName: string; mode: Mode; displayName: TextComponent;
    renderType: RenderType; numberFormat: Option[NumberFormat]): CUpdateObjectives =
  CUpdateObjectives(objectiveName: objectiveName, mode: uint8(ord(mode)), displayName: displayName,
    renderType: newVarInt(int32(ord(renderType))), numberFormat: numberFormat)

proc toId*(_: typedesc[CUpdateObjectives]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_OBJECTIVE.toId(v)

proc writePacket*(p: CUpdateObjectives; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.objectiveName)
  writeU8(w, p.mode)
  if p.mode == 0'u8 or p.mode == 2'u8:
    tryWrite writeText(w, p.displayName)
    writeVarInt(w, p.renderType)
    writeBool(w, p.numberFormat.isSome)
    if p.numberFormat.isSome:
      let format = p.numberFormat.unsafeGet
      case format.kind
      of nfBlank:
        writeVarInt(w, newVarInt(0))
      of nfStyled:
        writeVarInt(w, newVarInt(1))
        # TODO
        tryWrite writeStyleUnnamed(w, format.style)
      of nfFixed:
        writeVarInt(w, newVarInt(2))
        tryWrite writeText(w, format.fixedText)
  writeOkVoid()
