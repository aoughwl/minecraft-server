## Port of pumpkin-protocol/src/java/client/play/update_objectives.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
## `NumberFormat` is lib.rs's, in proto.aowl.
## Upstream's two writers differed: this packet wrote a `Styled` format's style as NBT, while `write`, which
## CUpdateScore uses, stopped after the variant id ("TODO: Style write"). Fixed here: both write the style.
import std/options
import ../../../../nbt/[nbtbase, serializer]
import ../../../../util/text/text
import ../../../proto

export proto

type
  Mode* = enum
    mAdd
    mRemove
    mUpdate

  RenderType* = enum
    rtInteger
    rtHearts

  CUpdateObjectives* = object
    objectiveName*: string
    mode*: uint8
    displayName*: TextComponent
    renderType*: VarInt
    numberFormat*: Option[NumberFormat]

proc newCUpdateObjectives*(objectiveName: string; mode: Mode; displayName: TextComponent;
    renderType: RenderType; numberFormat: Option[NumberFormat]): CUpdateObjectives =
  CUpdateObjectives(objectiveName: objectiveName, mode: uint8(ord(mode)), displayName: displayName,
    renderType: newVarInt(int32(ord(renderType))), numberFormat: numberFormat)

proc toId*(_: typedesc[CUpdateObjectives]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_OBJECTIVE.toId(v)

proc writePacket*(p: CUpdateObjectives; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.objectiveName)
  writeU8(w, p.mode)
  if p.mode == 0'u8 or p.mode == 2'u8:
    tryWrite writeText(w, p.displayName)
    writeVarInt(w, p.renderType)
    writeBool(w, p.numberFormat.isSome)
    if p.numberFormat.isSome:
      let format = p.numberFormat.unsafeGet
      case format.kind
      of nfBlank:
        writeVarInt(w, newVarInt(0))
      of nfStyled:
        writeVarInt(w, newVarInt(1))
        # TODO
        tryWrite writeStyleUnnamed(w, format.style)
      of nfFixed:
        writeVarInt(w, newVarInt(2))
        tryWrite writeText(w, format.fixedText)
  writeOkVoid()
