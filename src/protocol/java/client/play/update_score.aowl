## Port of pumpkin-protocol/src/java/client/play/update_score.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import std/options
import update_objectives
import ../../../../util/text/text


type
  CUpdateScore* = object
    ## Creates or updates a score for an entity on a specific objective.
    entityName*: string        ## A player's username or a non-player entry like "Kills".
    objectiveName*: string     ## The internal name of the objective this score belongs to.
    value*: VarInt             ## The actual integer value of the score.
    displayName*: Option[TextComponent]
    numberFormat*: Option[NumberFormat]

proc newRemove*(_: typedesc[CUpdateScore]; entityName, objectiveName: string): CUpdateScore =
  CUpdateScore(entityName: entityName, objectiveName: objectiveName, value: newVarInt(0),
    displayName: none[TextComponent](), numberFormat: none[NumberFormat]())

proc toId*(_: typedesc[CUpdateScore]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_SET_SCORE.toId(v)

proc writePacket*(p: CUpdateScore; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.entityName)
  tryWrite writeString(w, p.objectiveName)
  writeVarInt(w, p.value)
  writeBool(w, p.displayName.isSome)
  if p.displayName.isSome:
    tryWrite writeText(w, p.displayName.unsafeGet)
  writeBool(w, p.numberFormat.isSome)
  if p.numberFormat.isSome:
    tryWrite p.numberFormat.unsafeGet.write(w)
  writeOkVoid()
