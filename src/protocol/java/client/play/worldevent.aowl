## Port of pumpkin-protocol/src/java/client/play/worldevent.rs
import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import playwire
import ../../../../generated/block_state_remap
import ../../../../generated/world_event
import ../../../../util/math/position

type
  CWorldEvent* = object
    ## Triggers a specific sound or particle effect at a world location.
    event*: int32
    location*: BlockPos
    data*: int32
    disableRelativeVolume*: bool

proc toId*(_: typedesc[CWorldEvent]; v: JavaMinecraftVersion): int32 =
  CB_PLAY_LEVEL_EVENT.toId(v)

proc writePacket*(p: CWorldEvent; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.event)
  writeI64Be(w, asLong(p.location))

  var data = p.data
  if p.event == int32(ord(weParticlesDestroyBlock)) and p.data >= 0'i32 and p.data <= 65535'i32:
    data = int32(remapBlockStateForVersion(uint16(p.data), v))
  writeI32Be(w, data)
  writeBool(w, p.disableRelativeVolume)

  writeOkVoid()
