{.feature: "untyped".}
## Test for the client/play packets about the world: set_border_*, set_time, ticking_*, unload_chunk,
## worldevent, sound_effect, stop_sound. Exact bytes for protocol 774 and each side of a gate, plus
## upstream's own sound_effect #[test]s.
import std/options
import std/assertions
import playtestutil
import ../../../protobase, ../../../varint, ../../../proto
import ../../../../generated/block_state_remap
import ../../../../generated/sound_id_remap
import ../../../../util/javaversion
import ../../../../util/math/position
import ../../../../util/vector3
import set_border_center, set_border_lerp_size, set_border_size, set_border_warning_delay,
  set_border_warning_distance, set_time, ticking_state, ticking_step, unload_chunk, worldevent,
  sound_effect, stop_sound

const V = jmvV1_21_11

template full(Pk, p, v: untyped): seq[byte] =
  block:
    var fullWriter = newNetWriter()
    writeJavaPacketId(fullWriter, Pk.toId(v))
    let fullResult = writePacket(p, fullWriter, v)
    if not fullResult.isOk:
      echo "FAIL write: ", fullResult.error.msg
      quit(1)
    fullWriter.buf

block border:
  eqHex(full(CSetBorderCenter, CSetBorderCenter(x: 1.0, z: 2.0), V),
    "56 3ff0000000000000 4000000000000000", "border center")
  eqHex(full(CSetBorderLerpSize, CSetBorderLerpSize(oldDiameter: 1.0, newDiameter: 2.0, speed: newVarLong(300)), V),
    "57 3ff0000000000000 4000000000000000 ac02", "border lerp")
  eqHex(full(CSetBorderSize, CSetBorderSize(diameter: 1.0), V), "58 3ff0000000000000", "border size")
  eqHex(full(CSetBorderWarningDelay, CSetBorderWarningDelay(warningTime: newVarInt(15)), V), "59 0f", "border delay")
  eqHex(full(CSetBorderWarningDistance, CSetBorderWarningDistance(warningBlocks: newVarInt(5)), V), "5a 05", "border distance")

block time:
  let day = newCUpdateTime(100'i64, 200'i64, true)
  eqHex(full(CUpdateTime, day, V), "6f 0000000000000064 00000000000000c8 01", "set_time 774")
  eqHex(full(CUpdateTime, newCUpdateTime(100'i64, 200'i64, false), V),
    "6f 0000000000000064 00000000000000c8 00", "set_time 774, not increasing")
  # 1.21 stops at the day time; 26.1 sends clocks.
  eqHex(full(CUpdateTime, day, jmvV1_21), "64 0000000000000064 00000000000000c8", "set_time 1.21")
  eqHex(full(CUpdateTime, day, jmvV26_1),
    "71 0000000000000064 01 00 c801 00000000 3f800000", "set_time 26.1")
  # No clocks: the fallback is day time 0, rate 1.
  eqHex(full(CUpdateTime, CUpdateTime(gameTime: 1'i64, clockUpdates: @[]), V),
    "6f 0000000000000001 0000000000000000 01", "set_time 774, no clocks")

block ticking:
  eqHex(full(CTickingState, CTickingState(tickRate: 20.0'f32, isFrozen: true), V), "7d 41a00000 01", "ticking_state")
  eqHex(full(CTickingStep, CTickingStep(tickSteps: newVarInt(300)), V), "7e ac02", "ticking_step")

block unloadChunk:
  # z goes first.
  eqHex(full(CUnloadChunk, CUnloadChunk(z: 2'i32, x: 1'i32), V), "25 00000002 00000001", "unload_chunk")

block worldEvent:
  let p = CWorldEvent(event: 1000'i32, location: newBlockPos(1, 2, 3), data: 7'i32, disableRelativeVolume: true)
  eqHex(full(CWorldEvent, p, V), "2d 000003e8 0000004000003002 00000007 01", "worldevent")

  # 2001 carries a block state, which is remapped; a negative one is left alone.
  var state = -1
  for s in 0 .. 65535:
    if remapBlockStateForVersion(uint16(s), jmvV1_21_2) != uint16(s):
      state = s
      break
  assert state >= 0
  let remapped = remapBlockStateForVersion(uint16(state), jmvV1_21_2)
  var w = newNetWriter()
  let destroy = CWorldEvent(event: 2001'i32, location: newBlockPos(0, 0, 0), data: int32(state), disableRelativeVolume: false)
  assert writePacket(destroy, w, jmvV1_21_2).isOk
  assert w.buf[12] == byte(uint32(remapped) shr 24) and w.buf[13] == byte((uint32(remapped) shr 16) and 255'u32)
  assert w.buf[14] == byte((uint32(remapped) shr 8) and 255'u32) and w.buf[15] == byte(uint32(remapped) and 255'u32)
  # The same state on another event stays as it is.
  var other = newNetWriter()
  let notDestroy = CWorldEvent(event: 2000'i32, location: newBlockPos(0, 0, 0), data: int32(state), disableRelativeVolume: false)
  assert writePacket(notDestroy, other, jmvV1_21_2).isOk
  assert other.buf[15] == byte(state and 255)
  var neg = newNetWriter()
  let negative = CWorldEvent(event: 2001'i32, location: newBlockPos(0, 0, 0), data: -1'i32, disableRelativeVolume: false)
  assert writePacket(negative, neg, V).isOk
  assert neg.buf[12] == 0xFF'u8 and neg.buf[15] == 0xFF'u8

# --- sound_effect ---------------------------------------------------------------

proc soundId(id: uint16): IdOr[SoundEvent] =
  IdOr[SoundEvent](kind: iokId, id: id)

proc firstRemappedSoundId(version: JavaMinecraftVersion): uint16 =
  for id in 0 .. 65535:
    if remapSoundIdForVersion(uint16(id), version) != uint16(id):
      return uint16(id)
  assert false, "sound remap table should contain at least one changed id"

proc firstVarInt(bytes: seq[byte]): int32 =
  var r = newNetReader(bytes)
  let res = getVarInt(r)
  assert res.isOk
  res.value.value

proc soundBody(p: CSoundEffect; v: JavaMinecraftVersion): seq[byte] =
  var w = newNetWriter()
  assert writePacket(p, w, v).isOk
  w.buf

block soundExact:
  let p = newCSoundEffect(soundId(0'u16), scPlayers, Vector3[float64](x: 2.5, y: 3.5, z: 4.5), 1.0'f32, 2.0'f32, 42.0)
  eqHex(full(CSoundEffect, p, V),
    "73 01 07 00000014 0000001c 00000024 3f800000 40000000 000000000000002a", "sound_effect by id")
  let direct = newCSoundEffect(
    IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: "a:b", range: some(16.0'f32))),
    scMaster, Vector3[float64](x: 0.0, y: 0.0, z: 0.0), 1.0'f32, 1.0'f32, -1.0)
  eqHex(full(CSoundEffect, direct, V),
    "73 00 03 613a62 01 41800000 00 00000000 00000000 00000000 3f800000 3f800000 ffffffffffffffff",
    "sound_effect direct")

block numericSoundIdRemapsFor1_21_11:
  let id = firstRemappedSoundId(jmvV1_21_11)
  let p = newCSoundEffect(soundId(id), scPlayers, Vector3[float64](x: 1.0, y: 2.0, z: 3.0), 1.0'f32, 1.0'f32, 42.0)
  assert firstVarInt(soundBody(p, jmvV1_21_11)) == int32(remapSoundIdForVersion(id, jmvV1_21_11)) + 1

block numericSoundIdStaysLatestFor26_2:
  let id = firstRemappedSoundId(jmvV1_21_11)
  let p = newCSoundEffect(soundId(id), scPlayers, Vector3[float64](x: 1.0, y: 2.0, z: 3.0), 1.0'f32, 1.0'f32, 42.0)
  assert firstVarInt(soundBody(p, jmvV26_2)) == int32(id) + 1

block directSoundEventKeepsDirectHolderEncoding:
  let p = newCSoundEffect(
    IdOr[SoundEvent](kind: iokValue, value: SoundEvent(soundName: "minecraft:test.sound", range: none[float32]())),
    scPlayers, Vector3[float64](x: 1.0, y: 2.0, z: 3.0), 1.0'f32, 1.0'f32, 42.0)
  assert firstVarInt(soundBody(p, jmvV1_21_11)) == 0'i32

block positionScalingIsAppliedOnlyOnce:
  let p = newCSoundEffect(soundId(0'u16), scPlayers, Vector3[float64](x: 2.5, y: 3.5, z: 4.5), 1.0'f32, 1.0'f32, 42.0)
  var r = newNetReader(soundBody(p, jmvV26_2))
  assert getVarInt(r).isOk  # skip sound ID varint
  assert getVarInt(r).isOk  # skip sound category varint
  # position should be floor(input * 8), applied exactly once
  assert getI32Be(r).value == 20'i32
  assert getI32Be(r).value == 28'i32
  assert getI32Be(r).value == 36'i32

block saturatingCasts:
  # `as i32` and `as i64` saturate, and NaN gives 0.
  let nan = 0.0 / 0.0
  let p = newCSoundEffect(soundId(0'u16), scMaster, Vector3[float64](x: 1e300, y: -1e300, z: nan), 1.0'f32, 1.0'f32, 1e300)
  assert p.position.x == int32.high and p.position.y == int32.low and p.position.z == 0'i32
  let b = soundBody(p, V)
  eqHex(b[b.len - 8 .. ^1], "7fffffffffffffff", "seed saturates")

block stopSound:
  eqHex(full(CStopSound, CStopSound(soundId: none[string](), category: none[SoundCategory]()), V), "75 00", "stop none")
  eqHex(full(CStopSound, CStopSound(soundId: none[string](), category: some(scPlayers)), V), "75 01 07", "stop category")
  eqHex(full(CStopSound, CStopSound(soundId: some("a:b"), category: none[SoundCategory]()), V), "75 02 03 613a62", "stop sound")
  eqHex(full(CStopSound, CStopSound(soundId: some("a:b"), category: some(scUi)), V), "75 03 0a 03 613a62", "stop both")

echo "ok"
