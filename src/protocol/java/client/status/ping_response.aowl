type
  CPingResponse* = object
    ## Sent by the server to complete a latency check initiated by a `SStatusPingRequest`.
    payload*: int64  ## The exact value received from the client's ping request.

proc toId*(_: typedesc[CPingResponse]; v: JavaMinecraftVersion): int32 =
  CB_STATUS_PONG_RESPONSE.toId(v)

proc readPacket*(_: typedesc[CPingResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CPingResponse] =
  let payload = tryRead(CPingResponse, getI64Be(r))
  readOk(CPingResponse(payload: payload))

proc writePacket*(p: CPingResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.payload)
  writeOkVoid()
