## Port of pumpkin-protocol/src/java/client/status/status_response.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  CStatusResponse* = object
    ## Sent by the server in response to a `SStatusRequest`.
    jsonResponse*: string  ## The JSON-encoded status: `version`, `players`, `description` and `favicon`. At most 32767 characters.

proc toId*(_: typedesc[CStatusResponse]; v: JavaMinecraftVersion): int32 =
  CB_STATUS_STATUS_RESPONSE.toId(v)

proc readPacket*(_: typedesc[CStatusResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CStatusResponse] =
  let jsonResponse = tryRead(CStatusResponse, getStr(r))
  readOk(CStatusResponse(jsonResponse: jsonResponse))

proc writePacket*(p: CStatusResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.jsonResponse)
  writeOkVoid()
