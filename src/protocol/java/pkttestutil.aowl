{.feature: "untyped".}
## Helpers shared by the packet tests under src/protocol/java. Support module for tests, with no upstream
## file. `encoded` and `decoded` are templates because a generic proc cannot look up `writePacket` or
## `readPacket` on its type parameter.

import std/assertions
import ../protobase, ../netcodec
import ../../util/javaversion

export assertions, protobase, netcodec, javaversion

proc hx*(s: string): seq[byte] =
  ## Bytes from hex, ignoring spaces: `hx("01 ff")`.
  proc nib(c: char): int =
    if c >= '0' and c <= '9': ord(c) - ord('0')
    elif c >= 'a' and c <= 'f': ord(c) - ord('a') + 10
    else: ord(c) - ord('A') + 10
  result = @[]
  var have = false
  var hi = 0
  for c in s:
    if c == ' ':
      continue
    if have:
      result.add(uint8(hi * 16 + nib(c)))
      have = false
    else:
      hi = nib(c)
      have = true

proc utf8Hex*(s: string): string =
  ## The hex of a string's bytes, for building an expected byte string around readable text.
  const Hex = "0123456789abcdef"
  result = ""
  for ch in s:
    result.add(Hex[ord(ch) shr 4])
    result.add(Hex[ord(ch) and 15])

template encoded*(p, v: untyped): seq[byte] =
  ## What `writePacket` produces for `p`, which must succeed.
  block:
    var wr = newNetWriter()
    let wres = writePacket(p, wr, v)
    assert wres.isOk
    wr.buf

template decoded*(T: untyped; bytes: seq[byte]; v: untyped): untyped =
  ## What `readPacket` makes of `bytes`, which it must accept and consume entirely.
  block:
    var rd = newNetReader(bytes)
    let rres = readPacket(T, rd, v)
    assert rres.isOk
    assert remaining(rd) == 0
    rres.value

template rejects*(T: untyped; bytes: seq[byte]; v: untyped; message: string) =
  ## `readPacket` must fail on `bytes` with exactly this error text.
  block:
    var rd = newNetReader(bytes)
    let rres = readPacket(T, rd, v)
    assert not rres.isOk
    assert rres.error.msg == message
