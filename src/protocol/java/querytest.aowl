## Tests for query.aowl: upstream's `#[test]`s, vector for vector.

import std/[options, syncio]
import pkttestutil
import query

block handshakeRequest:
  var raw = decode(RawQueryPacket, hx("FEFD09 00000001"))
  assert raw.isOk
  assert raw.value.packetType == ptHandshake
  let pkt = decode(SHandshake, raw.value)
  assert pkt.isOk
  assert pkt.value.sessionId == 1

block handshakeResponse:
  let pkt = CHandshake(sessionId: 1, challengeToken: 9513307)
  assert pkt.encode().get == hx("09 00000001 39353133333037 00")

block negativeChallengeToken:
  let pkt = CHandshake(sessionId: -1, challengeToken: -7)
  assert pkt.encode().get == hx("09 ffffffff 2d37 00")

block basicStatRequest:
  var raw = decode(RawQueryPacket, hx("FEFD00 00000001 0091295B"))
  assert raw.isOk
  assert raw.value.packetType == ptStatus
  let pkt = decode(SStatusRequest, raw.value)
  assert pkt.isOk
  assert pkt.value.sessionId == 1
  assert pkt.value.challengeToken == 9513307
  assert not pkt.value.isFullRequest

block basicStatResponse:
  let expected = hx("00 00000001 41204D696E65637261667420536572766572 00 534D50 00 776F726C64 00 32 00 3230 00 DD63 3132372E302E302E31 00")
  let pkt = CBasicStatus(sessionId: 1, motd: "A Minecraft Server", map: "world", numPlayers: 2, maxPlayers: 20,
    hostPort: 25565'u16, hostIp: "127.0.0.1")
  assert pkt.encode().get == expected

block fullStatRequest:
  var raw = decode(RawQueryPacket, hx("FEFD00 00000001 0091295B 00000000"))
  assert raw.isOk
  let pkt = decode(SStatusRequest, raw.value)
  assert pkt.isOk
  assert pkt.value.sessionId == 1
  assert pkt.value.challengeToken == 9513307
  assert pkt.value.isFullRequest

block fullStatResponse:
  let expected = hx(
    "00 00 00 00 01 73 70 6C 69 74 6E 75 6D 00" &
    "80 00 68 6F 73 74 6E 61 6D 65 00 41 20 4D" &
    "69 6E 65 63 72 61 66 74 20 53 65 72 76 65" &
    "72 00 67 61 6D 65 74 79 70 65 00 53 4D 50" &
    "00 67 61 6D 65 5F 69 64 00 4D 49 4E 45 43" &
    "52 41 46 54 00 76 65 72 73 69 6F 6E 00 42" &
    "65 74 61 20 31 2E 39 20 50 72 65 72 65 6C" &
    "65 61 73 65 20 34 00 70 6C 75 67 69 6E 73" &
    "00 00 6D 61 70 00 77 6F 72 6C 64 00 6E 75" &
    "6D 70 6C 61 79 65 72 73 00 32 00 6D 61 78" &
    "70 6C 61 79 65 72 73 00 32 30 00 68 6F 73" &
    "74 70 6F 72 74 00 32 35 35 36 35 00 68 6F" &
    "73 74 69 70 00 31 32 37 2E 30 2E 30 2E 31" &
    "00 00 01 70 6C 61 79 65 72 5F 00 00 62 61" &
    "72 6E 65 79 67 61 6C 65 00 56 69 76 61 6C" &
    "61 68 65 6C 76 69 67 00 00")
  let pkt = CFullStatus(sessionId: 1, hostname: "A Minecraft Server", version: "Beta 1.9 Prerelease 4", plugins: "",
    map: "world", numPlayers: 2, maxPlayers: 20, hostPort: 25565'u16, hostIp: "127.0.0.1",
    players: @["barneygale", "Vivalahelvig"])
  assert pkt.encode().get == expected

block badMagicRejected:
  let res = decode(RawQueryPacket, hx("DEAD09 00000001"))
  assert not res.isOk
  assert res.error.kind == qdeBadMagic

block unknownPacketTypeRejected:
  let res = decode(RawQueryPacket, hx("FEFDFF"))
  assert not res.isOk
  assert res.error.kind == qdeUnknownPacketType
  assert res.error.packetType == 0xFF'u8
  assert $res.error == "unknown packet type: 0xff"

block truncatedPacketRejected:
  let res = decode(RawQueryPacket, hx("FEFD"))
  assert not res.isOk
  assert res.error.kind == qdeUnexpectedEof

# --- Paths upstream has and its tests do not reach ------------------------------

block truncatedBeforeMagic:
  let res = decode(RawQueryPacket, hx("FE"))
  assert not res.isOk
  assert res.error.kind == qdeUnexpectedEof

block truncatedHandshakeBody:
  var raw = decode(RawQueryPacket, hx("FEFD09 000000"))
  assert raw.isOk
  let res = decode(SHandshake, raw.value)
  assert not res.isOk
  assert res.error.kind == qdeUnexpectedEof

block malformedStatusPayload:
  var raw = decode(RawQueryPacket, hx("FEFD00 00000001 0091295B 00"))
  assert raw.isOk
  let res = decode(SStatusRequest, raw.value)
  assert not res.isOk
  assert res.error.kind == qdeMalformedPayload
  assert $res.error == "malformed packet payload"

block truncatedStatusToken:
  var raw = decode(RawQueryPacket, hx("FEFD00 00000001 0091"))
  assert raw.isOk
  let res = decode(SStatusRequest, raw.value)
  assert not res.isOk
  assert res.error.kind == qdeUnexpectedEof

block interiorNulFailsTheEncode:
  assert CBasicStatus(motd: "a\0b").encode().isNone
  assert CFullStatus(players: @["a\0b"]).encode().isNone
  assert CFullStatus(hostname: "a\0b").encode().isNone

echo "all query checks passed"
