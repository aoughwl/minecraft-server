## `SConfigPong` has no file in the pinned tree: an earlier addition for an id the tables do have, not a port
## of an upstream packet. Moved here from the old configuration modules.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SConfigPong* = object
    id*: int32

proc toId*(_: typedesc[SConfigPong]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_PONG.toId(v)

proc writePacket*(p: SConfigPong; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.id)
  writeOkVoid()

proc readPacket*(_: typedesc[SConfigPong]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SConfigPong] =
  let id = tryRead(SConfigPong, getI32Be(r))
  readOk(SConfigPong(id: id))
