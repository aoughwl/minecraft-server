## Port of pumpkin-protocol/src/java/server/config/cookie_response.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

const MaxCookieLength = 5120
  ## The maximum allowed size for a cookie payload (5 KiB).

type
  SConfigCookieResponse* = object
    key*: string  ## The unique identifier for the cookie being returned.
    hasPayload*: bool  ## Indicates whether a payload is attached to this response.
    payload*: Option[seq[byte]]  ## The data stored in the cookie. At most 5120 bytes.

proc toId*(_: typedesc[SConfigCookieResponse]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_COOKIE_RESPONSE.toId(v)

proc readPacket*(_: typedesc[SConfigCookieResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SConfigCookieResponse] =
  let key = tryRead(SConfigCookieResponse, getStr(r))
  let hasPayload = tryRead(SConfigCookieResponse, getBool(r))
  if not hasPayload:
    return readOk(SConfigCookieResponse(key: key, hasPayload: hasPayload, payload: none[seq[byte]]()))
  let payloadLength = int(tryRead(SConfigCookieResponse, getVarInt(r)).value)
  # Upstream's `as usize` makes a negative length too large as well.
  if payloadLength < 0 or payloadLength > MaxCookieLength:
    return readErr[SConfigCookieResponse](tooLarge("SConfigCookieResponse"))
  let payload = tryRead(SConfigCookieResponse, readSlice(r, payloadLength))
  readOk(SConfigCookieResponse(key: key, hasPayload: hasPayload, payload: some(payload)))
