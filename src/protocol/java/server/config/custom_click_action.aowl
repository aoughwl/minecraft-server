import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

type
  SCustomClickAction* = object
    actionId*: string
    payload*: Option[seq[byte]]

proc toId*(_: typedesc[SCustomClickAction]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_CUSTOM_CLICK_ACTION.toId(v)

proc readPacket*(_: typedesc[SCustomClickAction]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SCustomClickAction] =
  let actionId = tryRead(SCustomClickAction, getStr(r))
  var payload = none[seq[byte]]()
  if tryRead(SCustomClickAction, getBool(r)):
    payload = some(tryRead(SCustomClickAction, readRemainingSlice(r, 32767)))
  readOk(SCustomClickAction(actionId: actionId, payload: payload))
