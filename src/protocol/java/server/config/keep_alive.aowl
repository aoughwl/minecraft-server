## Port of pumpkin-protocol/src/java/server/config/keep_alive.rs
##
## The write is not upstream's (it only reads this packet): loginpacketstest.aowl round-trips it.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SKeepAlive* = object
    keepAliveId*: int64

proc toId*(_: typedesc[SKeepAlive]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_KEEP_ALIVE.toId(v)

proc readPacket*(_: typedesc[SKeepAlive]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SKeepAlive] =
  let keepAliveId = tryRead(SKeepAlive, getI64Be(r))
  readOk(SKeepAlive(keepAliveId: keepAliveId))

proc writePacket*(p: SKeepAlive; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.keepAliveId)
  writeOkVoid()
