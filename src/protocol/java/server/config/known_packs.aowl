## Port of pumpkin-protocol/src/java/server/config/known_packs.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto

type
  SKnownPacks* = object
    knownPacks*: seq[KnownPack]

proc toId*(_: typedesc[SKnownPacks]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_SELECT_KNOWN_PACKS.toId(v)

proc readPacket*(_: typedesc[SKnownPacks]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SKnownPacks] =
  let count = tryRead(SKnownPacks, getVarInt(r)).value
  if count < 0 or count > 64:
    return readErr[SKnownPacks](messageRead("Known packs count out of bounds"))
  var knownPacks: seq[KnownPack] = @[]
  for i in 0 ..< count:
    let namespace = tryRead(SKnownPacks, getStr(r))
    let id = tryRead(SKnownPacks, getStr(r))
    let version = tryRead(SKnownPacks, getStr(r))
    knownPacks.add(KnownPack(namespace: namespace, id: id, version: version))
  readOk(SKnownPacks(knownPacks: knownPacks))
