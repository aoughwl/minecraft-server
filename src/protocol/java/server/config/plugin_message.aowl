## Port of pumpkin-protocol/src/java/server/config/plugin_message.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

const MaxPayloadSize = 1_048_576
  ## The maximum allowed size for a plugin message payload (1 MiB).

type
  SPluginMessage* = object
    ## A packet used for custom communication between the client and server.
    channel*: string  ## The name of the channel, e.g. `minecraft:brand` or `velocity:main`.
    data*: seq[byte]  ## The payload sent by the client.

proc toId*(_: typedesc[SPluginMessage]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_CUSTOM_PAYLOAD.toId(v)

proc readPacket*(_: typedesc[SPluginMessage]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPluginMessage] =
  let channel = tryRead(SPluginMessage, getStr(r))
  let data = tryRead(SPluginMessage, readRemainingSlice(r, MaxPayloadSize))
  readOk(SPluginMessage(channel: channel, data: data))
