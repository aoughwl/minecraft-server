## Port of pumpkin-protocol/src/java/server/config/resource_pack_response.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../uuid

type
  ResourcePackResponseResultKind* = enum
    rprrDownloadSuccess
    rprrDownloadFail
    rprrDownloaded
    rprrAccepted
    rprrDeclined
    rprrInvalidUrl
    rprrReloadFailed
    rprrDiscarded
    rprrUnknown

  ResourcePackResponseResult* = object
    case kind*: ResourcePackResponseResultKind
    of rprrUnknown:
      unknown*: int32
    else:
      discard

  SConfigResourcePack* = object
    ## Sent by the client to inform the server of the status of a requested resource pack.
    uuid*: Uuid     ## The unique identifier of the resource pack this response refers to.
    result*: VarInt ## The status code of the operation, mapped by `responseResult`.

proc toId*(_: typedesc[SConfigResourcePack]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_RESOURCE_PACK.toId(v)

proc readPacket*(_: typedesc[SConfigResourcePack]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SConfigResourcePack] =
  let packId = tryRead(SConfigResourcePack, getUuid(r))
  let status = tryRead(SConfigResourcePack, getVarInt(r))
  readOk(SConfigResourcePack(uuid: packId, result: status))

proc responseResult*(self: SConfigResourcePack): ResourcePackResponseResult =
  case self.result.value
  of 0: ResourcePackResponseResult(kind: rprrDownloadSuccess)
  of 1: ResourcePackResponseResult(kind: rprrDeclined)
  of 2: ResourcePackResponseResult(kind: rprrDownloadFail)
  of 3: ResourcePackResponseResult(kind: rprrAccepted)
  of 4: ResourcePackResponseResult(kind: rprrDownloaded)
  of 5: ResourcePackResponseResult(kind: rprrInvalidUrl)
  of 6: ResourcePackResponseResult(kind: rprrReloadFailed)
  of 7: ResourcePackResponseResult(kind: rprrDiscarded)
  else: ResourcePackResponseResult(kind: rprrUnknown, unknown: self.result.value)
