## Known-byte tests for the serverbound configuration packets.

import std/[options, syncio]
import ../../../proto, ../../../varint
import ../../../../util/javaversion
import ../../pkttestutil
import acknowledge_finish_config, client_information, config_pong, cookie_response, custom_click_action, keep_alive,
  known_packs, plugin_message, resource_pack_response

const V = jmvV1_21_11

block acknowledgeFinishConfig:
  discard decoded(SAcknowledgeFinishConfig, hx(""), V)
  assert encoded(SAcknowledgeFinishConfig(), V).len == 0
  assert SAcknowledgeFinishConfig.toId(V) == 3

block clientInformation:
  let p = decoded(SClientInformationConfig, hx("05 656e5f7573 0c 01 01 7f 00 01 00"), V)
  assert p.locale == "en_us"
  assert p.viewDistance == 12'i8
  assert p.chatMode.value == 1
  assert p.chatColors
  assert p.skinParts == 0x7f'u8
  assert p.mainHand.value == 0
  assert p.textFiltering
  assert not p.serverListing
  assert SClientInformationConfig.toId(V) == 0

block clientInformationGates:
  let old = decoded(SClientInformationConfig, hx("05 656e5f7573 0c 00 00 7f"), jmvV1_8)
  assert old.mainHand.value == 1
  assert not old.textFiltering
  assert old.serverListing
  let v116 = decoded(SClientInformationConfig, hx("05 656e5f7573 0c 00 00 7f 00"), jmvV1_16)
  assert v116.mainHand.value == 0
  assert not v116.textFiltering
  let v117 = decoded(SClientInformationConfig, hx("05 656e5f7573 0c 00 00 7f 00 01"), jmvV1_17)
  assert v117.textFiltering
  assert v117.serverListing

block cookieResponseWith:
  let p = decoded(SConfigCookieResponse, hx("03 613a62 01 02 0708"), V)
  assert p.key == "a:b"
  assert p.hasPayload
  assert p.payload.get == hx("0708")
  assert SConfigCookieResponse.toId(V) == 1

block cookieResponseWithout:
  let p = decoded(SConfigCookieResponse, hx("03 613a62 00"), V)
  assert p.key == "a:b"
  assert not p.hasPayload
  assert p.payload.isNone

block cookieResponseBounds:
  rejects(SConfigCookieResponse, hx("03 613a62 01 8128"), V, "too large: SConfigCookieResponse")
  rejects(SConfigCookieResponse, hx("03 613a62 01 ffffffff0f"), V, "too large: SConfigCookieResponse")

block customClick:
  let p = decoded(SCustomClickAction, hx("03 613a62 01 0a0b"), V)
  assert p.actionId == "a:b"
  assert p.payload.get == hx("0a0b")
  assert decoded(SCustomClickAction, hx("03 613a62 00"), V).payload.isNone
  assert SCustomClickAction.toId(V) == 8

block keepAlive:
  let p = decoded(SKeepAlive, hx("0102030405060708"), V)
  assert p.keepAliveId == 0x0102030405060708'i64
  assert encoded(p, V) == hx("0102030405060708")
  assert SKeepAlive.toId(V) == 4

block knownPacks:
  let p = decoded(SKnownPacks, hx("01 09 6d696e656372616674 04 636f7265 07 312e32312e3131"), V)
  assert p.knownPacks.len == 1
  assert p.knownPacks[0].namespace == "minecraft"
  assert p.knownPacks[0].id == "core"
  assert p.knownPacks[0].version == "1.21.11"
  assert decoded(SKnownPacks, hx("00"), V).knownPacks.len == 0
  assert SKnownPacks.toId(V) == 7

block knownPacksBounds:
  rejects(SKnownPacks, hx("41"), V, "Known packs count out of bounds")
  rejects(SKnownPacks, hx("ffffffff0f"), V, "Known packs count out of bounds")

block pluginMessage:
  let p = decoded(SPluginMessage, hx("0f 6d696e6563726166743a6272616e64 06 76616e696c6c61"), V)
  assert p.channel == "minecraft:brand"
  assert p.data == hx("06 76616e696c6c61")
  assert SPluginMessage.toId(V) == 2

block pluginMessageBound:
  var bytes = hx("01 61")
  bytes.setLen(bytes.len + 1_048_577)
  rejects(SPluginMessage, bytes, V, "too large: Read remaining too long")

block resourcePackResponse:
  let p = decoded(SConfigResourcePack, hx("00112233445566778899aabbccddeeff 03"), V)
  assert p.uuid.hi == 0x0011223344556677'u64
  assert p.uuid.lo == 0x8899aabbccddeeff'u64
  assert p.result.value == 3
  assert p.responseResult().kind == rprrAccepted
  assert SConfigResourcePack.toId(V) == 6

block resourcePackResponseMapping:
  # Upstream's mapping is not the enum's order.
  assert SConfigResourcePack(result: newVarInt(0)).responseResult().kind == rprrDownloadSuccess
  assert SConfigResourcePack(result: newVarInt(1)).responseResult().kind == rprrDeclined
  assert SConfigResourcePack(result: newVarInt(2)).responseResult().kind == rprrDownloadFail
  assert SConfigResourcePack(result: newVarInt(3)).responseResult().kind == rprrAccepted
  assert SConfigResourcePack(result: newVarInt(4)).responseResult().kind == rprrDownloaded
  assert SConfigResourcePack(result: newVarInt(5)).responseResult().kind == rprrInvalidUrl
  assert SConfigResourcePack(result: newVarInt(6)).responseResult().kind == rprrReloadFailed
  assert SConfigResourcePack(result: newVarInt(7)).responseResult().kind == rprrDiscarded
  let unknown = SConfigResourcePack(result: newVarInt(8)).responseResult()
  assert unknown.kind == rprrUnknown
  assert unknown.unknown == 8'i32

block configPong:
  let p = decoded(SConfigPong, hx("ffffffd6"), V)
  assert p.id == -42'i32
  assert encoded(p, V) == hx("ffffffd6")
  assert SConfigPong.toId(V) == 5

echo "all serverbound config checks passed"
