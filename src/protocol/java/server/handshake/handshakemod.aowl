## Port of pumpkin-protocol/src/java/server/handshake/mod.rs
##
## `mod` is an operator here, so this mod.rs, which holds the packet itself, is handshakemod.aowl.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../proto

type
  SHandShake* = object
    ## The very first packet sent by the client to initiate a connection. It determines whether the
    ## client wants to check the server status (SLP) or actually login to play.
    protocolVersion*: VarInt  ## The protocol version of the client, e.g. 767 for 1.21.
    serverAddress*: string    ## The hostname or IP used by the client to connect.
    serverPort*: uint16       ## The port number used by the client to connect.
    nextState*: ConnectionState  ## The state the client wants to transition to: 1 for Status, 2 for Login.

proc toId*(_: typedesc[SHandShake]; v: JavaMinecraftVersion): int32 =
  SB_HANDSHAKE_INTENTION.toId(v)

var maxServerAddress* = 255
  ## Characters of server address read, vanilla's limit as upstream reads it. A server behind a BungeeCord proxy raises it
  ## (src/main.aowl): the proxy puts the host, ip, uuid and the profile's properties as JSON in this field, which a skin
  ## makes over a thousand characters.

proc readPacket*(_: typedesc[SHandShake]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SHandShake] =
  let protocolVersion = tryRead(SHandShake, getVarInt(r))
  let serverAddress = tryRead(SHandShake, getStrBounded(r, maxServerAddress))
  let serverPort = tryRead(SHandShake, getU16Be(r))
  let state = tryRead(SHandShake, getVarInt(r))
  let (known, nextState) = connectionStateFromVarInt(state.value)
  if not known:
    return readErr[SHandShake](messageRead("Invalid status"))
  readOk(SHandShake(protocolVersion: protocolVersion, serverAddress: serverAddress, serverPort: serverPort,
    nextState: nextState))

proc writePacket*(p: SHandShake; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.protocolVersion)
  tryWrite writeString(w, p.serverAddress)
  writeU16Be(w, p.serverPort)
  writeVarInt(w, newVarInt(int32(ord(p.nextState))))
  writeOkVoid()
