## Port of pumpkin-protocol/src/java/server/login/cookie_response.rs
##
## `hasPayload`/`payload` stand for upstream's `Option<&[u8]>`, and the write is not upstream's:
## loginpacketstest.aowl, written before this file was split out, builds and round-trips this shape.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

const MaxCookieLength = 5120

type
  SLoginCookieResponse* = object
    ## Response to a `CCookieRequest` (login) from the server. The Notchian server only accepts responses
    ## of up to 5 kiB in size.
    key*: string
    hasPayload*: bool
    payload*: seq[byte]  ## meaningful only when hasPayload

proc toId*(_: typedesc[SLoginCookieResponse]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_COOKIE_RESPONSE.toId(v)

proc readPacket*(_: typedesc[SLoginCookieResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SLoginCookieResponse] =
  let key = tryRead(SLoginCookieResponse, getStr(r))
  if not tryRead(SLoginCookieResponse, getBool(r)):
    return readOk(SLoginCookieResponse(key: key, hasPayload: false, payload: @[]))
  let length = int(tryRead(SLoginCookieResponse, getVarInt(r)).value)
  # Upstream's `as usize` makes a negative length too large as well.
  if length < 0 or length > MaxCookieLength:
    return readErr[SLoginCookieResponse](tooLarge("SLoginCookieResponse"))
  let payload = tryRead(SLoginCookieResponse, readSlice(r, length))
  readOk(SLoginCookieResponse(key: key, hasPayload: true, payload: payload))

proc writePacket*(p: SLoginCookieResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.key)
  writeBool(w, p.hasPayload)
  if p.hasPayload:
    writeVarInt(w, newVarInt(int32(p.payload.len)))
    writeSlice(w, p.payload)
  writeOkVoid()
