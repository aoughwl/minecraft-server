## Port of pumpkin-protocol/src/java/server/login/encryption_response.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SEncryptionResponse* = object
    sharedSecret*: seq[byte]
    verifyToken*: seq[byte]

proc readEncryptionBuffer(r: var NetReader): ProtoReadResult[seq[byte]] =
  let length = int(tryRead(seq[byte], getVarInt(r)).value)
  # Upstream's `as usize` makes a negative length too large as well.
  if length < 0 or length > 256:
    return readErr[seq[byte]](messageRead("Encryption payload too large"))
  readSlice(r, length)

proc toId*(_: typedesc[SEncryptionResponse]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_KEY.toId(v)

proc readPacket*(_: typedesc[SEncryptionResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SEncryptionResponse] =
  let sharedSecret = tryRead(SEncryptionResponse, readEncryptionBuffer(r))
  let verifyToken = tryRead(SEncryptionResponse, readEncryptionBuffer(r))
  readOk(SEncryptionResponse(sharedSecret: sharedSecret, verifyToken: verifyToken))

proc writePacket*(p: SEncryptionResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(p.sharedSecret.len)))
  writeSlice(w, p.sharedSecret)
  writeVarInt(w, newVarInt(int32(p.verifyToken.len)))
  writeSlice(w, p.verifyToken)
  writeOkVoid()
