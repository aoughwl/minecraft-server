## Port of pumpkin-protocol/src/java/server/login/login_start.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../uuid

type
  SLoginStart* = object
    name*: string  ## 16
    uuid*: Uuid

proc toId*(_: typedesc[SLoginStart]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_HELLO.toId(v)

proc readPacket*(_: typedesc[SLoginStart]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SLoginStart] =
  let name = tryRead(SLoginStart, getStrBounded(r, 16))
  if v >= jmvV1_20_2:
    let playerId = tryRead(SLoginStart, getUuid(r))
    return readOk(SLoginStart(name: name, uuid: playerId))
  readOk(SLoginStart(name: name, uuid: newV3(NilUuid, "OfflinePlayer:" & name)))

proc writePacket*(p: SLoginStart; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeStringBounded(w, p.name, 16)
  if v >= jmvV1_20_2:
    writeUuid(w, p.uuid)
  writeOkVoid()
