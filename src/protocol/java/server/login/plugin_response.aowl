## Port of pumpkin-protocol/src/java/server/login/plugin_response.rs
##
## `hasData`/`data` stand for upstream's `Option<Box<[u8]>>`, and the write is not upstream's:
## loginpacketstest.aowl, written before this file was split out, builds and round-trips this shape.
## `data` has no length prefix: it is the rest of the packet.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

const MaxPayloadSize = 1_048_576

type
  SLoginPluginResponse* = object
    messageId*: VarInt
    hasData*: bool
    data*: seq[byte]  ## meaningful only when hasData

proc toId*(_: typedesc[SLoginPluginResponse]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_CUSTOM_QUERY_ANSWER.toId(v)

proc readPacket*(_: typedesc[SLoginPluginResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SLoginPluginResponse] =
  let messageId = tryRead(SLoginPluginResponse, getVarInt(r))
  if not tryRead(SLoginPluginResponse, getBool(r)):
    return readOk(SLoginPluginResponse(messageId: messageId, hasData: false, data: @[]))
  let data = tryRead(SLoginPluginResponse, readRemainingSlice(r, MaxPayloadSize))
  readOk(SLoginPluginResponse(messageId: messageId, hasData: true, data: data))

proc writePacket*(p: SLoginPluginResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.messageId)
  writeBool(w, p.hasData)
  if p.hasData:
    writeSlice(w, p.data)
  writeOkVoid()
