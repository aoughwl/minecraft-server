## Port of pumpkin-protocol/src/java/server/play/attack.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SAttack* = object
    entityId*: VarInt

proc toId*(_: typedesc[SAttack]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_ATTACK.toId(v)

proc readPacket*(_: typedesc[SAttack]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SAttack] =
  let entityId = tryRead(SAttack, getVarInt(r))
  readOk(SAttack(entityId: entityId))
