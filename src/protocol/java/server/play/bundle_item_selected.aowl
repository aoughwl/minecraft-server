## Port of pumpkin-protocol/src/java/server/play/bundle_item_selected.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SBundleItemSelected* = object
    slotId*: VarInt
    selectedItemIndex*: VarInt

proc toId*(_: typedesc[SBundleItemSelected]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_BUNDLE_ITEM_SELECTED.toId(v)

proc readPacket*(_: typedesc[SBundleItemSelected]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SBundleItemSelected] =
  let slotId = tryRead(SBundleItemSelected, getVarInt(r))
  let selectedItemIndex = tryRead(SBundleItemSelected, getVarInt(r))
  readOk(SBundleItemSelected(slotId: slotId, selectedItemIndex: selectedItemIndex))
