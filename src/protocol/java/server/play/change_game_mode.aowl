## Port of pumpkin-protocol/src/java/server/play/change_game_mode.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/gamemode

type
  SChangeGameMode* = object
    gameMode*: GameMode

proc toId*(_: typedesc[SChangeGameMode]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CHANGE_GAME_MODE.toId(v)

proc readPacket*(_: typedesc[SChangeGameMode]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SChangeGameMode] =
  let raw = tryRead(SChangeGameMode, getU8(r))
  let (known, gameMode) = gameModeFromI8(cast[int8](raw))
  if not known:
    return readErr[SChangeGameMode](messageRead("Invalid game mode"))
  readOk(SChangeGameMode(gameMode: gameMode))
