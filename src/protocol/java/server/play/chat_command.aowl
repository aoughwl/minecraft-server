## Port of pumpkin-protocol/src/java/server/play/chat_command.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SChatCommand* = object
    command*: string

proc toId*(_: typedesc[SChatCommand]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CHAT_COMMAND.toId(v)

proc readPacket*(_: typedesc[SChatCommand]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SChatCommand] =
  let command = tryRead(SChatCommand, getStr(r))
  readOk(SChatCommand(command: command))
