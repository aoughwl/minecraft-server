## Port of pumpkin-protocol/src/java/server/play/chat_message.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

type
  SChatMessage* = object
    message*: string
    timestamp*: int64
    salt*: int64
    signature*: Option[seq[byte]]
    messageCount*: VarInt
    acknowledged*: seq[byte]  ## Bitset fixed 20 bits
    checksum*: uint8          ## 1.21.5 "fingerprint" checksum

proc toId*(_: typedesc[SChatMessage]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CHAT.toId(v)

proc readPacket*(_: typedesc[SChatMessage]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SChatMessage] =
  let message = tryRead(SChatMessage, getStrBounded(r, 256))
  let timestamp = tryRead(SChatMessage, getI64Be(r))
  let salt = tryRead(SChatMessage, getI64Be(r))
  var signature = none[seq[byte]]()
  if tryRead(SChatMessage, getBool(r)):
    signature = some(tryRead(SChatMessage, readSlice(r, 256)))
  let messageCount = tryRead(SChatMessage, getVarInt(r))
  let acknowledged = tryRead(SChatMessage, readSlice(r, 3))
  var checksum = 0'u8
  if v >= jmvV1_21_5:
    checksum = tryRead(SChatMessage, getU8(r))
  readOk(SChatMessage(message: message, timestamp: timestamp, salt: salt, signature: signature,
    messageCount: messageCount, acknowledged: acknowledged, checksum: checksum))

proc writePacket*(p: SChatMessage; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.message)
  writeI64Be(w, p.timestamp)
  writeI64Be(w, p.salt)
  writeBool(w, p.signature.isSome)
  if p.signature.isSome:
    writeSlice(w, p.signature.unsafeGet)
  writeVarInt(w, p.messageCount)
  writeSlice(w, p.acknowledged)
  if v >= jmvV1_21_5:
    writeU8(w, p.checksum)
  writeOkVoid()
