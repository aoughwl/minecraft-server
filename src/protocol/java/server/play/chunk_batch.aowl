## Port of pumpkin-protocol/src/java/server/play/chunk_batch.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SChunkBatch* = object
    chunksPerTick*: float32

proc toId*(_: typedesc[SChunkBatch]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CHUNK_BATCH_RECEIVED.toId(v)

proc readPacket*(_: typedesc[SChunkBatch]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SChunkBatch] =
  let chunksPerTick = tryRead(SChunkBatch, getF32Be(r))
  readOk(SChunkBatch(chunksPerTick: chunksPerTick))
