## Port of pumpkin-protocol/src/java/server/play/click_container.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  SlotActionType* = enum
    satPickup
      ## Performs a normal slot click. This can pick up or place items in the slot, possibly merging the
      ## cursor stack into the slot, or swapping the slot stack with the cursor stack if they can't be merged.
    satQuickMove
      ## Performs a shift-click. This usually quickly moves items between the player's inventory and the
      ## open screen handler.
    satSwap
      ## Exchanges items between a slot and a hotbar slot. The click data is the hotbar slot to swap with (0-8).
    satClone
      ## Clones the item in the slot. Usually triggered by middle clicking an item in creative mode.
    satThrow
      ## Throws the item out of the inventory. The click data determines whether to throw a whole stack (1)
      ## or a single item from that stack (0).
    satQuickCraft
      ## Drags items between multiple slots. Stage 0 signals that the drag has begun and stage 2 that it has
      ## ended. In between, multiple stage 1s signal which slots were dragged on.
    satPickupAll
      ## Replenishes the cursor stack with items from the screen handler. Usually a double click.

  SClickSlot* = object
    syncId*: VarInt
    revision*: VarInt
    slot*: int16
    button*: int8
    mode*: SlotActionType
    lengthOfArray*: VarInt
    arrayOfChangedSlots*: seq[(int16, OptionalItemStackHash)]
    carriedItem*: OptionalItemStackHash

proc slotActionTypeFromI32*(value: int32): (bool, SlotActionType) =
  ## Port of `TryFrom<i32> for SlotActionType`.
  case value
  of 0: (true, satPickup)
  of 1: (true, satQuickMove)
  of 2: (true, satSwap)
  of 3: (true, satClone)
  of 4: (true, satThrow)
  of 5: (true, satQuickCraft)
  of 6: (true, satPickupAll)
  else: (false, satPickup)

proc readSlotActionType*(r: var NetReader): ProtoReadResult[SlotActionType] =
  let mode = tryRead(SlotActionType, getVarInt(r))
  let (known, action) = slotActionTypeFromI32(mode.value)
  if not known:
    return readErr[SlotActionType](messageRead("Invalid slot action type"))
  readOk(action)

proc toId*(_: typedesc[SClickSlot]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CONTAINER_CLICK.toId(v)

proc readPacket*(_: typedesc[SClickSlot]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SClickSlot] =
  let syncId = tryRead(SClickSlot, getVarInt(r))
  var revision = newVarInt(0)
  if v >= jmvV1_17_1:
    revision = tryRead(SClickSlot, getVarInt(r))
  else:
    revision = newVarInt(int32(tryRead(SClickSlot, getI16Be(r))))
  let slot = tryRead(SClickSlot, getI16Be(r))
  let button = tryRead(SClickSlot, getI8(r))
  let mode = tryRead(SClickSlot, readSlotActionType(r))

  let lengthOfArray = tryRead(SClickSlot, getVarInt(r))
  if lengthOfArray.value < 0 or lengthOfArray.value > 256:
    return readErr[SClickSlot](messageRead("Changed slots length out of bounds"))
  var arrayOfChangedSlots: seq[(int16, OptionalItemStackHash)] = @[]
  for i in 0 ..< lengthOfArray.value:
    let changedSlot = tryRead(SClickSlot, getI16Be(r))
    let changedHash = tryRead(SClickSlot, read(OptionalItemStackHash, r))
    arrayOfChangedSlots.add((changedSlot, changedHash))

  let carriedItem = tryRead(SClickSlot, read(OptionalItemStackHash, r))
  readOk(SClickSlot(syncId: syncId, revision: revision, slot: slot, button: button, mode: mode,
    lengthOfArray: lengthOfArray, arrayOfChangedSlots: arrayOfChangedSlots, carriedItem: carriedItem))
