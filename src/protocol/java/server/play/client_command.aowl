## Port of pumpkin-protocol/src/java/server/play/client_command.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SClientCommand* = object
    actionId*: VarInt

proc toId*(_: typedesc[SClientCommand]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CLIENT_COMMAND.toId(v)

proc readPacket*(_: typedesc[SClientCommand]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SClientCommand] =
  let actionId = tryRead(SClientCommand, getVarInt(r))
  readOk(SClientCommand(actionId: actionId))
