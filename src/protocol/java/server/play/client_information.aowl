## Port of pumpkin-protocol/src/java/server/play/client_information.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SClientInformationPlay* = object
    locale*: string  ## The language code used by the client, e.g. `en_us`.
    viewDistance*: int8  ## The maximum number of chunks the client renders.
    chatMode*: VarInt  ## 0: enabled, 1: commands only, 2: hidden.
    chatColors*: bool  ## Whether the client wants chat colors rendered.
    skinParts*: uint8  ## Bitmask of displayed skin parts.
    mainHand*: VarInt  ## 0: left, 1: right.
    textFiltering*: bool  ## Whether the client wants text filtering.
    serverListing*: bool  ## Whether the player should appear in the online player list.

proc toId*(_: typedesc[SClientInformationPlay]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CLIENT_INFORMATION.toId(v)

proc readPacket*(_: typedesc[SClientInformationPlay]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SClientInformationPlay] =
  let locale = tryRead(SClientInformationPlay, getStr(r))
  let viewDistance = tryRead(SClientInformationPlay, getI8(r))
  let chatMode = tryRead(SClientInformationPlay, getVarInt(r))
  let chatColors = tryRead(SClientInformationPlay, getBool(r))
  let skinParts = tryRead(SClientInformationPlay, getU8(r))
  var mainHand = newVarInt(1)
  if v >= jmvV1_9:
    mainHand = tryRead(SClientInformationPlay, getVarInt(r))
  var textFiltering = false
  if v >= jmvV1_17:
    textFiltering = tryRead(SClientInformationPlay, getBool(r))
  var serverListing = true
  if v >= jmvV1_18:
    serverListing = tryRead(SClientInformationPlay, getBool(r))
  readOk(SClientInformationPlay(locale: locale, viewDistance: viewDistance, chatMode: chatMode, chatColors: chatColors,
    skinParts: skinParts, mainHand: mainHand, textFiltering: textFiltering, serverListing: serverListing))
