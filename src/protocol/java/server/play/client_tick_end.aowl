## Port of pumpkin-protocol/src/java/server/play/client_tick_end.rs
##
## Upstream declares only the id: its handler matches on it and never reads a body. The empty read is
## not upstream's; it gives this packet the same shape as every other serverbound one.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SClientTickEnd* = object

proc toId*(_: typedesc[SClientTickEnd]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CLIENT_TICK_END.toId(v)

proc readPacket*(_: typedesc[SClientTickEnd]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SClientTickEnd] =
  readOk(SClientTickEnd())
