## Port of pumpkin-protocol/src/java/server/play/close_container.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SCloseContainer* = object
    windowId*: VarInt

proc toId*(_: typedesc[SCloseContainer]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CONTAINER_CLOSE.toId(v)

proc readPacket*(_: typedesc[SCloseContainer]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SCloseContainer] =
  let windowId = tryRead(SCloseContainer, getVarInt(r))
  readOk(SCloseContainer(windowId: windowId))
