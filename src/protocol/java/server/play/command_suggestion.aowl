## Port of pumpkin-protocol/src/java/server/play/command_suggestion.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SCommandSuggestion* = object
    id*: VarInt
    command*: string

proc toId*(_: typedesc[SCommandSuggestion]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_COMMAND_SUGGESTION.toId(v)

proc readPacket*(_: typedesc[SCommandSuggestion]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SCommandSuggestion] =
  let id = tryRead(SCommandSuggestion, getVarInt(r))
  let command = tryRead(SCommandSuggestion, getStr(r))
  readOk(SCommandSuggestion(id: id, command: command))
