## Port of pumpkin-protocol/src/java/server/play/confirm_teleport.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SConfirmTeleport* = object
    teleportId*: VarInt

proc toId*(_: typedesc[SConfirmTeleport]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_ACCEPT_TELEPORTATION.toId(v)

proc readPacket*(_: typedesc[SConfirmTeleport]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SConfirmTeleport] =
  let teleportId = tryRead(SConfirmTeleport, getVarInt(r))
  readOk(SConfirmTeleport(teleportId: teleportId))
