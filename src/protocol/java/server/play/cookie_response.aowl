## Port of pumpkin-protocol/src/java/server/play/cookie_response.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

const MaxCookieLength = 5120
  ## The maximum allowed size for a cookie payload (5 KiB).

type
  SCookieResponse* = object
    key*: string
    payload*: Option[seq[byte]]  ## At most 5120 bytes.

proc toId*(_: typedesc[SCookieResponse]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_COOKIE_RESPONSE.toId(v)

proc readPacket*(_: typedesc[SCookieResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SCookieResponse] =
  let key = tryRead(SCookieResponse, getStr(r))
  let hasPayload = tryRead(SCookieResponse, getBool(r))
  if not hasPayload:
    return readOk(SCookieResponse(key: key, payload: none[seq[byte]]()))
  let payloadLength = int(tryRead(SCookieResponse, getVarInt(r)).value)
  # Upstream's `as usize` makes a negative length too large as well.
  if payloadLength < 0 or payloadLength > MaxCookieLength:
    return readErr[SCookieResponse](tooLarge("SCookieResponse"))
  let payload = tryRead(SCookieResponse, readSlice(r, payloadLength))
  readOk(SCookieResponse(key: key, payload: some(payload)))
