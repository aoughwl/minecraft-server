## Port of pumpkin-protocol/src/java/server/play/custom_payload.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

const MaxPayloadSize = 32_767
  ## The maximum allowed size for a play custom payload (32 KiB).

type
  SCustomPayload* = object
    ## A packet used for custom communication between the client and server.
    channel*: string  ## The name of the channel, e.g. `minecraft:brand`.
    data*: seq[byte]  ## The payload sent by the client.

proc toId*(_: typedesc[SCustomPayload]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CUSTOM_PAYLOAD.toId(v)

proc readPacket*(_: typedesc[SCustomPayload]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SCustomPayload] =
  let channel = tryRead(SCustomPayload, getStr(r))
  let data = tryRead(SCustomPayload, readRemainingSlice(r, MaxPayloadSize))
  readOk(SCustomPayload(channel: channel, data: data))
