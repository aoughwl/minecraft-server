## Port of pumpkin-protocol/src/java/server/play/interact.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../lpvector3d
import ../../../../util/vector3

type
  ActionType* = enum
    atInteract
    atAttack
    atInteractAt

  SInteract* = object
    entityId*: VarInt
    interactType*: VarInt  ## Upstream's `r#type`.
    targetPosition*: Option[Vector3[float64]]
    hand*: Option[VarInt]
    sneaking*: bool

proc actionTypeFromI32*(value: int32): (bool, ActionType) =
  ## Port of `TryFrom<i32> for ActionType`.
  case value
  of 0: (true, atInteract)
  of 1: (true, atAttack)
  of 2: (true, atInteractAt)
  else: (false, atInteract)

proc toId*(_: typedesc[SInteract]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_INTERACT.toId(v)

# Great job Mojang ;D
proc readPacket*(_: typedesc[SInteract]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SInteract] =
  # 26.1+ removes the 'type' field and uses doubles for location
  if v >= jmvV26_1:
    let entityId = tryRead(SInteract, getVarInt(r))
    let hand = some(tryRead(SInteract, getVarInt(r)))
    let targetPosition = some(tryRead(SInteract, read(LpVector3d, r)).value)
    let sneaking = tryRead(SInteract, getBool(r))
    # InteractAt for compatibility
    return readOk(SInteract(entityId: entityId, interactType: newVarInt(2), targetPosition: targetPosition,
      hand: hand, sneaking: sneaking))

  let entityId = tryRead(SInteract, getVarInt(r))
  let interactType = tryRead(SInteract, getVarInt(r))
  let (known, action) = actionTypeFromI32(interactType.value)
  if not known:
    return readErr[SInteract](messageRead("invalid action type"))

  var targetPosition = none[Vector3[float64]]()
  if action == atInteractAt:
    let tx = tryRead(SInteract, getF32Be(r))
    let ty = tryRead(SInteract, getF32Be(r))
    let tz = tryRead(SInteract, getF32Be(r))
    targetPosition = some(toF64(vec3[float32](tx, ty, tz)))

  var hand = none[VarInt]()
  if action == atInteract or action == atInteractAt:
    hand = some(tryRead(SInteract, getVarInt(r)))

  let sneaking = tryRead(SInteract, getBool(r))
  readOk(SInteract(entityId: entityId, interactType: interactType, targetPosition: targetPosition,
    hand: hand, sneaking: sneaking))
