## Port of pumpkin-protocol/src/java/server/play/jigsaw_generate.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  SJigsawGenerate* = object
    pos*: BlockPos
    levels*: VarInt
    keepJigsaws*: bool

proc toId*(_: typedesc[SJigsawGenerate]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_JIGSAW_GENERATE.toId(v)

proc readPacket*(_: typedesc[SJigsawGenerate]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SJigsawGenerate] =
  let pos = fromI64(tryRead(SJigsawGenerate, getI64Be(r)))
  let levels = tryRead(SJigsawGenerate, getVarInt(r))
  let keepJigsaws = tryRead(SJigsawGenerate, getBool(r))
  readOk(SJigsawGenerate(pos: pos, levels: levels, keepJigsaws: keepJigsaws))
