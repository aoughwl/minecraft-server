## Port of pumpkin-protocol/src/java/server/play/keep_alive.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SKeepAlive* = object
    keepAliveId*: int64

proc toId*(_: typedesc[SKeepAlive]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_KEEP_ALIVE.toId(v)

proc readPacket*(_: typedesc[SKeepAlive]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SKeepAlive] =
  let keepAliveId = tryRead(SKeepAlive, getI64Be(r))
  readOk(SKeepAlive(keepAliveId: keepAliveId))
