## Port of pumpkin-protocol/src/java/server/play/move_vehicle.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SMoveVehicle* = object
    x*: float64
    y*: float64
    z*: float64
    yaw*: float32
    pitch*: float32

proc toId*(_: typedesc[SMoveVehicle]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_MOVE_VEHICLE.toId(v)

proc readPacket*(_: typedesc[SMoveVehicle]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SMoveVehicle] =
  let x = tryRead(SMoveVehicle, getF64Be(r))
  let y = tryRead(SMoveVehicle, getF64Be(r))
  let z = tryRead(SMoveVehicle, getF64Be(r))
  let yaw = tryRead(SMoveVehicle, getF32Be(r))
  let pitch = tryRead(SMoveVehicle, getF32Be(r))
  readOk(SMoveVehicle(x: x, y: y, z: z, yaw: yaw, pitch: pitch))
