## Port of pumpkin-protocol/src/java/server/play/paddle_boat.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SPaddleBoat* = object
    leftPaddle*: bool
    rightPaddle*: bool

proc toId*(_: typedesc[SPaddleBoat]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PADDLE_BOAT.toId(v)

proc readPacket*(_: typedesc[SPaddleBoat]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPaddleBoat] =
  let leftPaddle = tryRead(SPaddleBoat, getBool(r))
  let rightPaddle = tryRead(SPaddleBoat, getBool(r))
  readOk(SPaddleBoat(leftPaddle: leftPaddle, rightPaddle: rightPaddle))
