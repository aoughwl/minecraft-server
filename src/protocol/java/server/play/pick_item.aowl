## Port of pumpkin-protocol/src/java/server/play/pick_item.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  SPickItemFromBlock* = object
    pos*: BlockPos
    includeData*: bool

  SPickItemFromEntity* = object
    id*: VarInt
    includeData*: bool

proc toId*(_: typedesc[SPickItemFromBlock]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PICK_ITEM_FROM_BLOCK.toId(v)

proc readPacket*(_: typedesc[SPickItemFromBlock]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPickItemFromBlock] =
  let pos = fromI64(tryRead(SPickItemFromBlock, getI64Be(r)))
  let includeData = tryRead(SPickItemFromBlock, getBool(r))
  readOk(SPickItemFromBlock(pos: pos, includeData: includeData))

proc toId*(_: typedesc[SPickItemFromEntity]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PICK_ITEM_FROM_ENTITY.toId(v)

proc readPacket*(_: typedesc[SPickItemFromEntity]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPickItemFromEntity] =
  let id = tryRead(SPickItemFromEntity, getVarInt(r))
  let includeData = tryRead(SPickItemFromEntity, getBool(r))
  readOk(SPickItemFromEntity(id: id, includeData: includeData))
