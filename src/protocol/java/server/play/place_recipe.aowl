## Port of pumpkin-protocol/src/java/server/play/place_recipe.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SPlaceRecipe* = object
    containerId*: int8
    recipeDisplayId*: VarInt
    useMaxItems*: bool

proc toId*(_: typedesc[SPlaceRecipe]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PLACE_RECIPE.toId(v)

proc readPacket*(_: typedesc[SPlaceRecipe]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlaceRecipe] =
  let containerId = tryRead(SPlaceRecipe, getI8(r))
  let recipeDisplayId = tryRead(SPlaceRecipe, getVarInt(r))
  let useMaxItems = tryRead(SPlaceRecipe, getBool(r))
  readOk(SPlaceRecipe(containerId: containerId, recipeDisplayId: recipeDisplayId, useMaxItems: useMaxItems))
