## Known-byte tests for the serverbound play packets about blocks and entities: digging, placing, using,
## interacting, signs, command blocks, jigsaws and test blocks.

import std/[options, syncio]
import ../../../varint
import ../../../../data/block_rotation
import ../../../../util/[javaversion, vector3]
import ../../../../util/math/position
import ../../pkttestutil
import attack, interact, jigsaw_generate, player_action, set_command_block, set_jigsaw_block, set_test_block,
  swing_arm, test_instance_block_action, update_sign, use_item, use_item_on

const V = jmvV1_21_11
const Pos = "0000007fffffd040" # x 1, y 64, z -3

block blockPosEncoding:
  assert decoded(SJigsawGenerate, hx("ffffffffffffffff 00 00"), V).pos == newBlockPos(-1'i32, -1'i32, -1'i32)
  assert decoded(SJigsawGenerate, hx(Pos & " 00 00"), V).pos == newBlockPos(1'i32, 64'i32, -3'i32)

block playerAction:
  let p = decoded(SPlayerAction, hx("00" & Pos & "01 07"), V)
  assert p.status.value == 0
  assert p.position == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.face == 1'u8
  assert p.sequence.value == 7
  assert SPlayerAction.toId(V) == 40
  assert statusFromI32(0) == (true, stStartedDigging)
  assert statusFromI32(7) == (true, stSpearJab)
  assert not statusFromI32(8)[0]

block useItem:
  let p = decoded(SUseItem, hx("01 07 42b40000 c2340000"), V)
  assert p.hand.value == 1
  assert p.sequence.value == 7
  assert p.yaw == 90.0'f32
  assert p.pitch == -45.0'f32
  assert SUseItem.toId(V) == 64
  # Before 1.21.2 there is no rotation.
  let old = decoded(SUseItem, hx("00 07"), jmvV1_21)
  assert old.hand.value == 0
  assert old.sequence.value == 7
  assert old.yaw == 0.0'f32
  assert old.pitch == 0.0'f32

block useItemOn:
  let p = decoded(SUseItemOn, hx("00" & Pos & "01 3f000000 3f800000 00000000 01 01 07"), V)
  assert p.hand.value == 0
  assert p.position == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.face.value == 1
  assert p.cursorPos.x == 0.5'f32
  assert p.cursorPos.y == 1.0'f32
  assert p.cursorPos.z == 0.0'f32
  assert p.insideBlock
  assert p.isAgainstWorldBorder
  assert p.sequence.value == 7
  assert SUseItemOn.toId(V) == 63
  # Before 1.21.5 there is no world border flag.
  let old = decoded(SUseItemOn, hx("00" & Pos & "01 3f000000 3f800000 00000000 00 07"), jmvV1_21_4)
  assert not old.insideBlock
  assert not old.isAgainstWorldBorder
  assert old.sequence.value == 7

block swingArm:
  assert decoded(SSwingArm, hx("01"), V).hand.value == 1
  assert SSwingArm.toId(V) == 60

block attackPacket:
  assert decoded(SAttack, hx("07"), jmvV26_1).entityId.value == 7
  # Not in 774: it has interact's attack action instead.
  assert SAttack.toId(V) == -1
  assert SAttack.toId(jmvV26_1) == 1

block interactOn:
  let p = decoded(SInteract, hx("07 00 01 01"), V)
  assert p.entityId.value == 7
  assert p.interactType.value == 0
  assert p.targetPosition.isNone
  assert p.hand.get.value == 1
  assert p.sneaking
  assert SInteract.toId(V) == 25

block interactAttack:
  let p = decoded(SInteract, hx("07 01 00"), V)
  assert p.entityId.value == 7
  assert p.interactType.value == 1
  assert p.targetPosition.isNone
  assert p.hand.isNone
  assert not p.sneaking

block interactAt:
  let p = decoded(SInteract, hx("07 02 3f800000 40000000 bf000000 00 01"), V)
  assert p.interactType.value == 2
  let t = p.targetPosition.get
  assert t.x == 1.0
  assert t.y == 2.0
  assert t.z == -0.5
  assert p.hand.get.value == 0
  assert p.sneaking

block interactInvalid:
  rejects(SInteract, hx("07 03"), V, "invalid action type")

block interact26:
  # 26.1 has no type field and a packed position, here the two zero bytes of a zero vector.
  let p = decoded(SInteract, hx("07 01 0000 01"), jmvV26_1)
  assert p.entityId.value == 7
  assert p.interactType.value == 2
  assert p.hand.get.value == 1
  let t = p.targetPosition.get
  assert t.x == 0.0 and t.y == 0.0 and t.z == 0.0
  assert p.sneaking

block updateSign:
  let p = decoded(SUpdateSign, hx(Pos & "01 01 61 01 62 00 02 6364"), V)
  assert p.location == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.isFrontText
  assert p.line1 == "a"
  assert p.line2 == "b"
  assert p.line3 == ""
  assert p.line4 == "cd"
  assert SUpdateSign.toId(V) == 59

block updateSignLineBound:
  # 387 characters against the cap of 386, as a 0x83 0x03 length prefix.
  var bytes = hx(Pos & "01 8303")
  for i in 0 ..< 387:
    bytes.add(0x61'u8)
  rejects(SUpdateSign, bytes, V, "too large: string has too many UTF-16 characters (more than the maximum limit 386)")

block setCommandBlock:
  let p = decoded(SSetCommandBlock, hx(Pos & "04 73617920 02 05"), V)
  assert p.pos == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.command == "say "
  assert p.mode.value == 2
  assert p.flags == 5'i8
  assert SSetCommandBlock.toId(V) == 53
  assert commandBlockModeFromVarInt(newVarInt(0)) == (true, cbmChain)
  assert commandBlockModeFromVarInt(newVarInt(1)) == (true, cbmRepeating)
  assert commandBlockModeFromVarInt(newVarInt(2)) == (true, cbmImpulse)
  assert not commandBlockModeFromVarInt(newVarInt(3))[0]

block setJigsawBlock:
  let p = decoded(SSetJigsawBlock, hx(Pos & "01 61 01 62 01 63 01 64 01 65 03 04"), V)
  assert p.pos == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.name == "a"
  assert p.target == "b"
  assert p.pool == "c"
  assert p.finalState == "d"
  assert p.joint == "e"
  assert p.selectionPriority.value == 3
  assert p.placementPriority.value == 4
  assert SSetJigsawBlock.toId(V) == 56

block jigsawGenerate:
  let p = decoded(SJigsawGenerate, hx(Pos & "05 01"), V)
  assert p.pos == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.levels.value == 5
  assert p.keepJigsaws
  assert SJigsawGenerate.toId(V) == 26

block setTestBlock:
  let p = decoded(SSetTestBlock, hx(Pos & "02 03 6d7367"), V)
  assert p.position == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.mode == tbmFail
  assert p.message == "msg"
  assert SSetTestBlock.toId(V) == 58
  assert decoded(SSetTestBlock, hx(Pos & "00 00"), V).mode == tbmStart
  assert decoded(SSetTestBlock, hx(Pos & "01 00"), V).mode == tbmLog
  assert decoded(SSetTestBlock, hx(Pos & "03 00"), V).mode == tbmAccept
  rejects(SSetTestBlock, hx(Pos & "04 00"), V, "Invalid TestBlockMode")

block testInstanceBlockAction:
  let p = decoded(STestInstanceBlockAction, hx(Pos & "06 01 03 613a62 01 02 03 01 01 03 01 01 65"), V)
  assert p.pos == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.action == tibaRun
  assert p.data.test.get == "a:b"
  assert p.data.size.x.value == 1
  assert p.data.size.y.value == 2
  assert p.data.size.z.value == 3
  assert p.data.rotation == Rotation.Clockwise90
  assert p.data.ignoreEntities
  assert p.data.status == tibsFailed
  assert p.data.errorMessage.get == "e"
  assert STestInstanceBlockAction.toId(V) == 62

block testInstanceBlockActionNones:
  let p = decoded(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 00 00 00 00"), V)
  assert p.action == tibaInit
  assert p.data.test.isNone
  assert p.data.rotation == Rotation.None
  assert not p.data.ignoreEntities
  assert p.data.status == tibsCleared
  assert p.data.errorMessage.isNone

block testInstanceBlockActionEnums:
  assert decoded(STestInstanceBlockAction, hx(Pos & "01 00 00 00 00 02 00 01 00"), V).action == tibaQuery
  assert decoded(STestInstanceBlockAction, hx(Pos & "02 00 00 00 00 03 00 02 00"), V).action == tibaSet
  assert decoded(STestInstanceBlockAction, hx(Pos & "03 00 00 00 00 02 00 01 00"), V).action == tibaReset
  assert decoded(STestInstanceBlockAction, hx(Pos & "04 00 00 00 00 02 00 01 00"), V).action == tibaSave
  assert decoded(STestInstanceBlockAction, hx(Pos & "05 00 00 00 00 02 00 01 00"), V).action == tibaExport
  assert decoded(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 02 00 01 00"), V).data.rotation == Rotation.Rotate180
  assert decoded(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 03 00 01 00"), V).data.rotation == Rotation.CounterClockwise90
  assert decoded(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 00 00 01 00"), V).data.status == tibsRunning
  assert decoded(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 00 00 02 00"), V).data.status == tibsSuccess
  rejects(STestInstanceBlockAction, hx(Pos & "07 00 00 00 00 00 00 00 00"), V, "Invalid TestInstanceBlockAction")
  rejects(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 04 00 00 00"), V, "Invalid Rotation")
  rejects(STestInstanceBlockAction, hx(Pos & "00 00 00 00 00 00 00 04 00"), V, "Invalid TestInstanceBlockStatus")

echo "all serverbound play block checks passed"
