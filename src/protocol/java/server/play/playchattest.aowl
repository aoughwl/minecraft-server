## Known-byte tests for the serverbound play packets about chat and the connection: chat, commands,
## sessions, cookies, custom payloads, keep-alive, ping, chunk batches, advancements and debug subscriptions.

import std/[options, syncio]
import ../../../netcodec, ../../../protobase
import ../../../../util/[identifier, javaversion]
import ../../pkttestutil
import chat_command, chat_message, chunk_batch, command_suggestion, cookie_response, custom_click_action,
  custom_payload, debug_sample_subscription, debug_subscription_request, keep_alive, ping_request, player_session,
  seen_advancement

const V = jmvV1_21_11

block chatCommand:
  assert decoded(SChatCommand, hx("04 68656c70"), V).command == "help"
  assert SChatCommand.toId(V) == 6

block chatMessage:
  let bytes = hx("02 6869 0000000000000001 00000000000000ff 00 03 ff0f00 7f")
  let p = decoded(SChatMessage, bytes, V)
  assert p.message == "hi"
  assert p.timestamp == 1'i64
  assert p.salt == 255'i64
  assert p.signature.isNone
  assert p.messageCount.value == 3
  assert p.acknowledged == hx("ff0f00")
  assert p.checksum == 0x7f'u8
  assert SChatMessage.toId(V) == 8
  # Upstream also writes this packet.
  assert encoded(p, V) == bytes

block chatMessageSigned:
  var signature = newSeq[byte](256)
  for i in 0 ..< 256:
    signature[i] = uint8(i)
  var bytes = hx("00 0000000000000001 0000000000000002 01")
  for b in signature:
    bytes.add(b)
  for b in hx("00 000000 00"):
    bytes.add(b)
  let p = decoded(SChatMessage, bytes, V)
  assert p.message == ""
  assert p.signature.get == signature
  assert encoded(p, V) == bytes

block chatMessageChecksumGate:
  # Before 1.21.5 there is no checksum, on either side.
  let bytes = hx("02 6869 0000000000000001 00000000000000ff 00 03 ff0f00")
  let p = decoded(SChatMessage, bytes, jmvV1_21_4)
  assert p.checksum == 0'u8
  assert encoded(p, jmvV1_21_4) == bytes

block chatMessageBound:
  var bytes = hx("8102")
  for i in 0 ..< 257:
    bytes.add(0x61'u8)
  rejects(SChatMessage, bytes, V, "too large: string has too many UTF-16 characters (more than the maximum limit 256)")

block commandSuggestion:
  let p = decoded(SCommandSuggestion, hx("07 03 2f6d65"), V)
  assert p.id.value == 7
  assert p.command == "/me"
  assert SCommandSuggestion.toId(V) == 14

block playerSession:
  let p = decoded(SPlayerSession, hx("00112233445566778899aabbccddeeff 0000000000000064 03 010203 02 0405"), V)
  assert p.sessionId.hi == 0x0011223344556677'u64
  assert p.sessionId.lo == 0x8899aabbccddeeff'u64
  assert p.expiresAt == 100'i64
  assert p.publicKey == hx("010203")
  assert p.keySignature == hx("0405")
  assert SPlayerSession.toId(V) == 9

block playerSessionBadLengths:
  # A negative key length, then one far longer than the packet.
  var negative = newNetReader(hx("00112233445566778899aabbccddeeff 0000000000000064 ffffffff0f"))
  assert not readPacket(SPlayerSession, negative, V).isOk
  var overlong = newNetReader(hx("00112233445566778899aabbccddeeff 0000000000000064 ffffff7f 00"))
  assert not readPacket(SPlayerSession, overlong, V).isOk

block cookieResponse:
  let p = decoded(SCookieResponse, hx("03 613a62 01 02 0708"), V)
  assert p.key == "a:b"
  assert p.payload.get == hx("0708")
  let none1 = decoded(SCookieResponse, hx("03 613a62 00"), V)
  assert none1.key == "a:b"
  assert none1.payload.isNone
  assert SCookieResponse.toId(V) == 20

block cookieResponseBounds:
  # 5121, one over the cap, then a negative length. Neither needs the payload to be there.
  rejects(SCookieResponse, hx("03 613a62 01 8128"), V, "too large: SCookieResponse")
  rejects(SCookieResponse, hx("03 613a62 01 ffffffff0f"), V, "too large: SCookieResponse")

block customClickAction:
  let p = decoded(SCustomClickAction, hx("03 613a62 01 0a0b"), V)
  assert p.actionId == "a:b"
  assert p.payload.get == hx("0a0b")
  assert decoded(SCustomClickAction, hx("03 613a62 00"), V).payload.isNone
  assert SCustomClickAction.toId(V) == 65

block customClickActionBound:
  var bytes = hx("03 613a62 01")
  for i in 0 ..< 32768:
    bytes.add(0'u8)
  rejects(SCustomClickAction, bytes, V, "too large: Read remaining too long")

block customPayload:
  let p = decoded(SCustomPayload, hx("01 61 aabb"), V)
  assert p.channel == "a"
  assert p.data == hx("aabb")
  assert SCustomPayload.toId(V) == 21

block customPayloadBound:
  var bytes = hx("01 61")
  for i in 0 ..< 32768:
    bytes.add(0'u8)
  rejects(SCustomPayload, bytes, V, "too large: Read remaining too long")

block keepAlivePlay:
  assert decoded(SKeepAlive, hx("0102030405060708"), V).keepAliveId == 0x0102030405060708'i64
  assert SKeepAlive.toId(V) == 27

block pingRequest:
  assert decoded(SPlayPingRequest, hx("ffffffffffffffff"), V).payload == -1'i64
  assert SPlayPingRequest.toId(V) == 37

block chunkBatch:
  assert decoded(SChunkBatch, hx("41200000"), V).chunksPerTick == 10.0'f32
  assert SChunkBatch.toId(V) == 10

block seenAdvancementOpen:
  let p = decoded(SSeenAdvancement, hx("00 14 6d696e6563726166743a73746f72792f726f6f74"), V)
  assert p.kind == ssaOpenTab
  assert $p.openTab == "minecraft:story/root"
  assert SSeenAdvancement.toId(V) == 49

block seenAdvancementClose:
  assert decoded(SSeenAdvancement, hx("01"), V).kind == ssaCloseTab

block seenAdvancementBad:
  rejects(SSeenAdvancement, hx("02"), V, "Invalid SeenAdvancement action: 2")
  # An identifier with an upper-case path and a space.
  var rd = newNetReader(hx("00 03 412042"))
  assert not readPacket(SSeenAdvancement, rd, V).isOk

block debugSampleSubscription:
  assert decoded(SDebugSampleSubscription, hx("00"), jmvV1_21_7).sampleType.value == 0
  # Replaced in 1.21.9 by the subscription request.
  assert SDebugSampleSubscription.toId(V) == -1
  assert SDebugSampleSubscription.toId(jmvV1_21_7) == 22

block debugSubscriptionRequest:
  assert decoded(SDebugSubscriptionRequest, hx("01"), V).sampleType.value == 1
  assert SDebugSubscriptionRequest.toId(V) == 22

echo "all serverbound play chat checks passed"
