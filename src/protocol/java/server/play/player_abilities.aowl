## Port of pumpkin-protocol/src/java/server/play/player_abilities.rs
##
## The vanilla client sends this packet when the player starts/stops flying. Bitmask 0x02 is set when the player is flying.

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SPlayerAbilities* = object
    flags*: int8

proc toId*(_: typedesc[SPlayerAbilities]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PLAYER_ABILITIES.toId(v)

proc readPacket*(_: typedesc[SPlayerAbilities]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerAbilities] =
  let flags = tryRead(SPlayerAbilities, getI8(r))
  readOk(SPlayerAbilities(flags: flags))
