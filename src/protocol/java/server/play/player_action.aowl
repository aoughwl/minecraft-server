## Port of pumpkin-protocol/src/java/server/play/player_action.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  Status* = enum
    stStartedDigging = 0
      ## Sent when the player starts digging a block. If the block was insta-mined or the player is in
      ## creative mode, the client will not send `FinishedDigging`, and will assume the server completed the
      ## destruction. To detect this, it is necessary to calculate the block destruction speed server-side.
    stCancelledDigging
      ## Sent when the player lets go of the Mine Block key (default: left click). Face is always set to -Y.
    stFinishedDigging
      ## Sent when the client thinks it is finished.
    stDropItemStack
      ## The Drop Item key with the modifier to drop the entire selected stack. Location is always 0/0/0,
      ## Face is always -Y, Sequence is always 0.
    stDropItem
      ## The Drop Item key (default: Q). Location is always 0/0/0, Face is always -Y, Sequence is always 0.
    stReleaseItemInUse
      ## The held item should have its state updated: eating food, pulling back bows, using buckets.
      ## Location is always 0/0/0, Face is always -Y, Sequence is always 0.
    stSwapItem
      ## Swap or assign an item to the second hand. Location is always 0/0/0, Face is always -Y, Sequence is
      ## always 0.
    stSpearJab
      ## Sent when a player is holding a spear and performs a jab attack.

proc statusFromI32*(value: int32): (bool, Status) =
  ## Port of `TryFrom<i32> for Status`.
  case value
  of 0: (true, stStartedDigging)
  of 1: (true, stCancelledDigging)
  of 2: (true, stFinishedDigging)
  of 3: (true, stDropItemStack)
  of 4: (true, stDropItem)
  of 5: (true, stReleaseItemInUse)
  of 6: (true, stSwapItem)
  of 7: (true, stSpearJab)
  else: (false, stStartedDigging)

type
  SPlayerAction* = object
    status*: VarInt
    position*: BlockPos
    face*: uint8
    sequence*: VarInt

proc toId*(_: typedesc[SPlayerAction]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PLAYER_ACTION.toId(v)

proc readPacket*(_: typedesc[SPlayerAction]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerAction] =
  let status = tryRead(SPlayerAction, getVarInt(r))
  let position = fromI64(tryRead(SPlayerAction, getI64Be(r)))
  let face = tryRead(SPlayerAction, getU8(r))
  let sequence = tryRead(SPlayerAction, getVarInt(r))
  readOk(SPlayerAction(status: status, position: position, face: face, sequence: sequence))
