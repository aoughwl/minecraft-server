## Port of pumpkin-protocol/src/java/server/play/player_command.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  Action* = enum
    acStartSneaking  ## <=1.21.5
    acStopSneaking   ## <=1.21.5
    acLeaveBed
    acStartSprinting
    acStopSprinting
    acStartHorseJump
    acStopHorseJump
    acOpenVehicleInventory
    acStartFlyingElytra

  SPlayerCommand* = object
    entityId*: VarInt
    action*: Action
    jumpBoost*: VarInt

proc toId*(_: typedesc[SPlayerCommand]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PLAYER_COMMAND.toId(v)

proc readPacket*(_: typedesc[SPlayerCommand]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerCommand] =
  let entityId = tryRead(SPlayerCommand, getVarInt(r))
  let actionId = tryRead(SPlayerCommand, getVarInt(r))
  let jumpBoost = tryRead(SPlayerCommand, getVarInt(r))

  var action = acLeaveBed
  if v < jmvV1_21_6:
    case actionId.value
    of 0: action = acStartSneaking
    of 1: action = acStopSneaking
    of 2: action = acLeaveBed
    of 3: action = acStartSprinting
    of 4: action = acStopSprinting
    of 5: action = acStartHorseJump
    of 6: action = acStopHorseJump
    of 7: action = acOpenVehicleInventory
    of 8: action = acStartFlyingElytra
    else: return readErr[SPlayerCommand](messageRead("Invalid player command"))
  else:
    case actionId.value
    of 0: action = acLeaveBed
    of 1: action = acStartSprinting
    of 2: action = acStopSprinting
    of 3: action = acStartHorseJump
    of 4: action = acStopHorseJump
    of 5: action = acOpenVehicleInventory
    of 6: action = acStartFlyingElytra
    else: return readErr[SPlayerCommand](messageRead("Invalid player command"))
  readOk(SPlayerCommand(entityId: entityId, action: action, jumpBoost: jumpBoost))
