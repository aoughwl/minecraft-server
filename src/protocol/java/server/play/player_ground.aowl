## Port of pumpkin-protocol/src/java/server/play/player_ground.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SSetPlayerGround* = object
    onGround*: bool

proc toId*(_: typedesc[SSetPlayerGround]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_MOVE_PLAYER_STATUS_ONLY.toId(v)

proc readPacket*(_: typedesc[SSetPlayerGround]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetPlayerGround] =
  let onGround = tryRead(SSetPlayerGround, getBool(r))
  readOk(SSetPlayerGround(onGround: onGround))
