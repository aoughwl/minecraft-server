## Port of pumpkin-protocol/src/java/server/play/player_input.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

const
  PlayerInputForward* = 1'i8
  PlayerInputBackward* = 2'i8
  PlayerInputLeft* = 4'i8
  PlayerInputRight* = 8'i8
  PlayerInputJump* = 16'i8
  PlayerInputSneak* = 32'i8
  PlayerInputSprint* = 64'i8

type
  SPlayerInput* = object
    input*: int8  ## Yep, exactly how it looks like

proc toId*(_: typedesc[SPlayerInput]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_PLAYER_INPUT.toId(v)

proc readPacket*(_: typedesc[SPlayerInput]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerInput] =
  if v >= jmvV1_21_2:
    let input = tryRead(SPlayerInput, getI8(r))
    return readOk(SPlayerInput(input: input))
  let sideways = tryRead(SPlayerInput, getF32Be(r))
  let forward = tryRead(SPlayerInput, getF32Be(r))
  let jumping = tryRead(SPlayerInput, getBool(r))
  let sneaking = tryRead(SPlayerInput, getBool(r))

  var input = 0'i8
  if forward > 0.0'f32:
    input = input or PlayerInputForward
  elif forward < 0.0'f32:
    input = input or PlayerInputBackward
  if sideways > 0.0'f32:
    input = input or PlayerInputLeft
  elif sideways < 0.0'f32:
    input = input or PlayerInputRight
  if jumping:
    input = input or PlayerInputJump
  if sneaking:
    input = input or PlayerInputSneak
  readOk(SPlayerInput(input: input))
