## Port of pumpkin-protocol/src/java/server/play/player_position.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

type
  SPlayerPosition* = object
    position*: Vector3[float64]
    collision*: uint8  ## bit 0: `FlagOnGround`, bit 1: `FlagInWall`

proc toId*(_: typedesc[SPlayerPosition]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_MOVE_PLAYER_POS.toId(v)

proc readPacket*(_: typedesc[SPlayerPosition]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerPosition] =
  let x = tryRead(SPlayerPosition, getF64Be(r))
  let y = tryRead(SPlayerPosition, getF64Be(r))
  let z = tryRead(SPlayerPosition, getF64Be(r))
  let collision = tryRead(SPlayerPosition, getU8(r))
  readOk(SPlayerPosition(position: vec3[float64](x, y, z), collision: collision))
