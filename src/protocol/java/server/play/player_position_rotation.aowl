## Port of pumpkin-protocol/src/java/server/play/player_position_rotation.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/vector3

const
  FlagOnGround* = 0x01'u8
  FlagInWall* = 0x02'u8

type
  SPlayerPositionRotation* = object
    position*: Vector3[float64]
    yaw*: float32
    pitch*: float32
    collision*: uint8  ## bit 0: `FlagOnGround`, bit 1: `FlagInWall`

proc toId*(_: typedesc[SPlayerPositionRotation]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_MOVE_PLAYER_POS_ROT.toId(v)

proc readPacket*(_: typedesc[SPlayerPositionRotation]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerPositionRotation] =
  let x = tryRead(SPlayerPositionRotation, getF64Be(r))
  let y = tryRead(SPlayerPositionRotation, getF64Be(r))
  let z = tryRead(SPlayerPositionRotation, getF64Be(r))
  let yaw = tryRead(SPlayerPositionRotation, getF32Be(r))
  let pitch = tryRead(SPlayerPositionRotation, getF32Be(r))
  let collision = tryRead(SPlayerPositionRotation, getU8(r))
  readOk(SPlayerPositionRotation(position: vec3[float64](x, y, z), yaw: yaw, pitch: pitch, collision: collision))
