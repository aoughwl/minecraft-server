## Port of pumpkin-protocol/src/java/server/play/player_rotation.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SPlayerRotation* = object
    yaw*: float32
    pitch*: float32
    ground*: bool

proc toId*(_: typedesc[SPlayerRotation]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_MOVE_PLAYER_ROT.toId(v)

proc readPacket*(_: typedesc[SPlayerRotation]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerRotation] =
  let yaw = tryRead(SPlayerRotation, getF32Be(r))
  let pitch = tryRead(SPlayerRotation, getF32Be(r))
  let ground = tryRead(SPlayerRotation, getBool(r))
  readOk(SPlayerRotation(yaw: yaw, pitch: pitch, ground: ground))
