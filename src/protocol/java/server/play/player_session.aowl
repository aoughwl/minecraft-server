## Port of pumpkin-protocol/src/java/server/play/player_session.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../uuid

type
  SPlayerSession* = object
    sessionId*: Uuid
    expiresAt*: int64
    publicKey*: seq[byte]
    keySignature*: seq[byte]

proc toId*(_: typedesc[SPlayerSession]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_CHAT_SESSION_UPDATE.toId(v)

proc readPacket*(_: typedesc[SPlayerSession]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SPlayerSession] =
  let sessionId = tryRead(SPlayerSession, getUuid(r))
  let expiresAt = tryRead(SPlayerSession, getI64Be(r))
  # Upstream allocates `vec![0u8; len]` first. `readSlice` fails on a negative or overlong
  # length instead of allocating what the client asked for.
  let publicKeyLength = int(tryRead(SPlayerSession, getVarInt(r)).value)
  let publicKey = tryRead(SPlayerSession, readSlice(r, publicKeyLength))
  let keySignatureLength = int(tryRead(SPlayerSession, getVarInt(r)).value)
  let keySignature = tryRead(SPlayerSession, readSlice(r, keySignatureLength))
  readOk(SPlayerSession(sessionId: sessionId, expiresAt: expiresAt, publicKey: publicKey, keySignature: keySignature))
