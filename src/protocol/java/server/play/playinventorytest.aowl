## Known-byte tests for the serverbound play packets about inventories and screens: clicks, slots, recipes,
## trading, naming, beacons and item picking.

import std/[options, syncio]
import ../../../datacomponent, ../../../itemstackserializer, ../../../netcodec, ../../../varint
import ../../../../util/[javaversion]
import ../../../../util/math/position
import ../../pkttestutil
import bundle_item_selected, click_container, close_container, container_button_click, pick_item, place_recipe,
  recipe_book_change_settings, recipe_book_seen_recipe, rename_item, select_trade, set_beacon, set_creative_slot,
  set_held_item

const V = jmvV1_21_11

proc hashBytes(h: OptionalItemStackHash): seq[byte] =
  ## ItemStackHash's fields are private, and its write is upstream's, so a hash is compared by its bytes.
  var w = newNetWriter()
  h.write(w)
  w.buf

block clickSlot:
  let p = decoded(SClickSlot, hx("01 05 0024 00 01 01 0024 01 01 02 01 03 0000002a 01 04 00"), V)
  assert p.syncId.value == 1
  assert p.revision.value == 5
  assert p.slot == 36'i16
  assert p.button == 0'i8
  assert p.mode == satQuickMove
  assert p.lengthOfArray.value == 1
  assert p.arrayOfChangedSlots.len == 1
  assert p.arrayOfChangedSlots[0][0] == 36'i16
  assert hashBytes(p.arrayOfChangedSlots[0][1]) == hx("01 01 02 01 03 0000002a 01 04")
  assert p.carriedItem.value.isNone
  assert hashBytes(p.carriedItem) == hx("00")
  assert SClickSlot.toId(V) == 17

block clickSlotCarriedAndNegative:
  let p = decoded(SClickSlot, hx("00 00 ffff ff 06 00 01 01 01 00 00"), V)
  assert p.slot == -1'i16
  assert p.button == -1'i8
  assert p.mode == satPickupAll
  assert p.lengthOfArray.value == 0
  assert p.arrayOfChangedSlots.len == 0
  assert p.carriedItem.value.isSome
  assert hashBytes(p.carriedItem) == hx("01 01 01 00 00")

block clickSlotModes:
  assert decoded(SClickSlot, hx("00 00 0000 00 00 00 00"), V).mode == satPickup
  assert decoded(SClickSlot, hx("00 00 0000 00 02 00 00"), V).mode == satSwap
  assert decoded(SClickSlot, hx("00 00 0000 00 03 00 00"), V).mode == satClone
  assert decoded(SClickSlot, hx("00 00 0000 00 04 00 00"), V).mode == satThrow
  assert decoded(SClickSlot, hx("00 00 0000 00 05 00 00"), V).mode == satQuickCraft
  rejects(SClickSlot, hx("00 00 0000 00 07 00 00"), V, "Invalid slot action type")

block clickSlotBounds:
  # 257 changed slots, then a negative count.
  rejects(SClickSlot, hx("00 00 0000 00 00 8102"), V, "Changed slots length out of bounds")
  rejects(SClickSlot, hx("00 00 0000 00 00 ffffffff0f"), V, "Changed slots length out of bounds")

block clickSlotRevisionGate:
  # Before 1.17.1 the revision is an i16.
  let p = decoded(SClickSlot, hx("01 0102 0024 00 00 00 00"), jmvV1_17)
  assert p.revision.value == 258

block setCreativeSlot:
  let p = decoded(SSetCreativeSlot, hx("0005 02 01 00 00"), V)
  assert p.slot == 5'i16
  assert p.clickedItem.stack.itemCount == 2'u8
  assert p.clickedItem.stack.itemId == 1'u16
  assert p.clickedItem.stack.patch.len == 0
  assert SSetCreativeSlot.toId(V) == 55

  let emptied = decoded(SSetCreativeSlot, hx("ffff 00"), V)
  assert emptied.slot == -1'i16
  assert emptied.clickedItem.stack.isEmpty()

  rejects(SSetCreativeSlot, hx("0005 8002"), V, "Invalid item count!")

block closeContainer:
  assert decoded(SCloseContainer, hx("03"), V).windowId.value == 3
  assert SCloseContainer.toId(V) == 18

block containerButtonClick:
  let p = decoded(SContainerButtonClick, hx("03 04"), V)
  assert p.windowId.value == 3
  assert p.buttonId.value == 4
  assert SContainerButtonClick.toId(V) == 16

block setHeldItem:
  assert decoded(SSetHeldItem, hx("0008"), V).slot == 8'i16
  assert SSetHeldItem.toId(V) == 52

block bundleItemSelected:
  let p = decoded(SBundleItemSelected, hx("09 ffffffff0f"), V)
  assert p.slotId.value == 9
  assert p.selectedItemIndex.value == -1
  assert SBundleItemSelected.toId(V) == 2

block pickItemFromBlock:
  let p = decoded(SPickItemFromBlock, hx("0000007fffffd040 01"), V)
  assert p.pos == newBlockPos(1'i32, 64'i32, -3'i32)
  assert p.includeData
  assert SPickItemFromBlock.toId(V) == 35

block pickItemFromEntity:
  let p = decoded(SPickItemFromEntity, hx("07 00"), V)
  assert p.id.value == 7
  assert not p.includeData
  assert SPickItemFromEntity.toId(V) == 36

block placeRecipe:
  let p = decoded(SPlaceRecipe, hx("ff 05 01"), V)
  assert p.containerId == -1'i8
  assert p.recipeDisplayId.value == 5
  assert p.useMaxItems
  assert SPlaceRecipe.toId(V) == 38

block recipeBookChangeSettings:
  let p = decoded(SRecipeBookChangeSettings, hx("02 01 00"), V)
  assert p.bookType.value == 2
  assert p.isOpen
  assert not p.isFiltering
  assert SRecipeBookChangeSettings.toId(V) == 45

block recipeBookSeenRecipe:
  assert decoded(SRecipeBookSeenRecipe, hx("05"), V).recipeDisplayId.value == 5
  assert SRecipeBookSeenRecipe.toId(V) == 46

block renameItem:
  assert decoded(SRenameItem, hx("02 6869"), V).itemName == "hi"
  assert SRenameItem.toId(V) == 47

block selectTrade:
  assert decoded(SSelectTrade, hx("04"), V).selectedSlot.value == 4
  assert SSelectTrade.toId(V) == 50

block setBeacon:
  let both = decoded(SSetBeacon, hx("01 05 01 0a"), V)
  assert both.primaryEffect.get.value == 5
  assert both.secondaryEffect.get.value == 10
  let one = decoded(SSetBeacon, hx("00 01 0a"), V)
  assert one.primaryEffect.isNone
  assert one.secondaryEffect.get.value == 10
  let neither = decoded(SSetBeacon, hx("00 00"), V)
  assert neither.primaryEffect.isNone
  assert neither.secondaryEffect.isNone
  assert SSetBeacon.toId(V) == 51

echo "all serverbound play inventory checks passed"
