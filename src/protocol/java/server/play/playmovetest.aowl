## Known-byte tests for the serverbound play packets about moving and player state: position, rotation,
## vehicles, input, abilities, commands, teleports, ticks, client settings and game mode.

import std/[options, syncio]
import ../../../varint, ../../../uuid
import ../../../../util/[gamemode, javaversion, vector3]
import ../../pkttestutil
import change_game_mode, client_command, client_information, client_tick_end, confirm_teleport, move_vehicle,
  paddle_boat, player_abilities, player_command, player_ground, player_input, player_loaded, player_position,
  player_position_rotation, player_rotation, teleport_to_entity

const V = jmvV1_21_11

block playerPosition:
  let p = decoded(SPlayerPosition, hx("3ff0000000000000 4050200000000000 bfe0000000000000 03"), V)
  assert p.position.x == 1.0
  assert p.position.y == 64.5
  assert p.position.z == -0.5
  assert p.collision == 3'u8
  assert (p.collision and FlagOnGround) != 0'u8
  assert (p.collision and FlagInWall) != 0'u8
  assert SPlayerPosition.toId(V) == 29

block playerPositionRotation:
  let p = decoded(SPlayerPositionRotation, hx("3ff0000000000000 4050200000000000 bfe0000000000000 42b40000 c2340000 01"), V)
  assert p.position.x == 1.0
  assert p.position.y == 64.5
  assert p.position.z == -0.5
  assert p.yaw == 90.0'f32
  assert p.pitch == -45.0'f32
  assert p.collision == FlagOnGround
  assert SPlayerPositionRotation.toId(V) == 30

block playerRotation:
  let p = decoded(SPlayerRotation, hx("42b40000 c2340000 01"), V)
  assert p.yaw == 90.0'f32
  assert p.pitch == -45.0'f32
  assert p.ground
  assert SPlayerRotation.toId(V) == 31

block playerGround:
  assert decoded(SSetPlayerGround, hx("01"), V).onGround
  assert not decoded(SSetPlayerGround, hx("00"), V).onGround
  assert SSetPlayerGround.toId(V) == 32

block moveVehicle:
  let p = decoded(SMoveVehicle, hx("3ff0000000000000 4000000000000000 bfe0000000000000 42b40000 c2340000"), V)
  assert p.x == 1.0
  assert p.y == 2.0
  assert p.z == -0.5
  assert p.yaw == 90.0'f32
  assert p.pitch == -45.0'f32
  assert SMoveVehicle.toId(V) == 33

block paddleBoat:
  let p = decoded(SPaddleBoat, hx("01 00"), V)
  assert p.leftPaddle
  assert not p.rightPaddle
  assert SPaddleBoat.toId(V) == 34

block playerInput:
  assert decoded(SPlayerInput, hx("23"), V).input == 35'i8
  # The gate: before 1.21.2 it is sideways, forward, jumping, sneaking.
  assert decoded(SPlayerInput, hx("bf800000 3f800000 01 00"), jmvV1_21).input ==
    (PlayerInputForward or PlayerInputRight or PlayerInputJump)
  assert decoded(SPlayerInput, hx("3f800000 bf800000 00 01"), jmvV1_21).input ==
    (PlayerInputBackward or PlayerInputLeft or PlayerInputSneak)
  assert decoded(SPlayerInput, hx("00000000 00000000 00 00"), jmvV1_21).input == 0'i8
  assert PlayerInputSprint == 64'i8
  assert SPlayerInput.toId(V) == 42

block playerAbilities:
  assert decoded(SPlayerAbilities, hx("02"), V).flags == 2'i8
  assert SPlayerAbilities.toId(V) == 39

block playerCommand:
  let p = decoded(SPlayerCommand, hx("07 01 2a"), V)
  assert p.entityId.value == 7
  assert p.action == acStartSprinting
  assert p.jumpBoost.value == 42
  assert SPlayerCommand.toId(V) == 41

  # 1.21.6 dropped the two sneak actions, so every id after them moved down by two.
  assert decoded(SPlayerCommand, hx("07 00 00"), V).action == acLeaveBed
  assert decoded(SPlayerCommand, hx("07 01 00"), V).action == acStartSprinting
  assert decoded(SPlayerCommand, hx("07 02 00"), V).action == acStopSprinting
  assert decoded(SPlayerCommand, hx("07 03 00"), V).action == acStartHorseJump
  assert decoded(SPlayerCommand, hx("07 04 00"), V).action == acStopHorseJump
  assert decoded(SPlayerCommand, hx("07 05 00"), V).action == acOpenVehicleInventory
  assert decoded(SPlayerCommand, hx("07 06 00"), V).action == acStartFlyingElytra
  rejects(SPlayerCommand, hx("07 07 00"), V, "Invalid player command")

  assert decoded(SPlayerCommand, hx("07 00 00"), jmvV1_21_5).action == acStartSneaking
  assert decoded(SPlayerCommand, hx("07 01 00"), jmvV1_21_5).action == acStopSneaking
  assert decoded(SPlayerCommand, hx("07 02 00"), jmvV1_21_5).action == acLeaveBed
  assert decoded(SPlayerCommand, hx("07 08 00"), jmvV1_21_5).action == acStartFlyingElytra
  rejects(SPlayerCommand, hx("07 09 00"), jmvV1_21_5, "Invalid player command")

block teleportToEntity:
  let p = decoded(STeleportToEntity, hx("00112233445566778899aabbccddeeff"), V)
  assert p.target.hi == 0x0011223344556677'u64
  assert p.target.lo == 0x8899aabbccddeeff'u64
  assert STeleportToEntity.toId(V) == 61

block confirmTeleport:
  assert decoded(SConfirmTeleport, hx("ac02"), V).teleportId.value == 300
  assert SConfirmTeleport.toId(V) == 0

block playerLoaded:
  discard decoded(SPlayerLoaded, hx(""), V)
  assert SPlayerLoaded.toId(V) == 43

block clientTickEnd:
  discard decoded(SClientTickEnd, hx(""), V)
  assert SClientTickEnd.toId(V) == 12

block clientCommand:
  assert decoded(SClientCommand, hx("01"), V).actionId.value == 1
  assert SClientCommand.toId(V) == 11

block clientInformationPlay:
  let p = decoded(SClientInformationPlay, hx("05 656e5f7573 0c 01 01 7f 00 01 00"), V)
  assert p.locale == "en_us"
  assert p.viewDistance == 12'i8
  assert p.chatMode.value == 1
  assert p.chatColors
  assert p.skinParts == 0x7f'u8
  assert p.mainHand.value == 0
  assert p.textFiltering
  assert not p.serverListing
  assert SClientInformationPlay.toId(V) == 13

  # Each gate in turn. Before 1.9 there is no hand, before 1.17 no filter, before 1.18 no listing.
  let old = decoded(SClientInformationPlay, hx("05 656e5f7573 0c 00 00 7f"), jmvV1_8)
  assert old.mainHand.value == 1
  assert not old.textFiltering
  assert old.serverListing
  let v116 = decoded(SClientInformationPlay, hx("05 656e5f7573 0c 00 00 7f 00"), jmvV1_16)
  assert v116.mainHand.value == 0
  assert not v116.textFiltering
  assert v116.serverListing
  let v117 = decoded(SClientInformationPlay, hx("05 656e5f7573 0c 00 00 7f 00 01"), jmvV1_17)
  assert v117.textFiltering
  assert v117.serverListing

block changeGameMode:
  assert decoded(SChangeGameMode, hx("00"), V).gameMode == Survival
  assert decoded(SChangeGameMode, hx("01"), V).gameMode == Creative
  assert decoded(SChangeGameMode, hx("02"), V).gameMode == Adventure
  assert decoded(SChangeGameMode, hx("03"), V).gameMode == Spectator
  rejects(SChangeGameMode, hx("04"), V, "Invalid game mode")
  # Upstream casts the byte to i8 first, so 0xff is -1, not 255.
  rejects(SChangeGameMode, hx("ff"), V, "Invalid game mode")
  assert SChangeGameMode.toId(V) == 4

echo "all serverbound play movement checks passed"
