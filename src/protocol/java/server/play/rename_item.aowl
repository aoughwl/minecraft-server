## Port of pumpkin-protocol/src/java/server/play/rename_item.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SRenameItem* = object
    itemName*: string

proc toId*(_: typedesc[SRenameItem]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_RENAME_ITEM.toId(v)

proc readPacket*(_: typedesc[SRenameItem]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SRenameItem] =
  let itemName = tryRead(SRenameItem, getStrBounded(r, 32767))
  readOk(SRenameItem(itemName: itemName))
