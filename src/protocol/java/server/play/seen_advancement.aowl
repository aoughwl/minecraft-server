## Port of pumpkin-protocol/src/java/server/play/seen_advancement.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/identifier

type
  SSeenAdvancementKind* = enum
    ssaOpenTab
    ssaCloseTab

  SSeenAdvancement* = object
    case kind*: SSeenAdvancementKind
    of ssaOpenTab:
      openTab*: Identifier
    of ssaCloseTab:
      discard

proc toId*(_: typedesc[SSeenAdvancement]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SEEN_ADVANCEMENTS.toId(v)

proc readPacket*(_: typedesc[SSeenAdvancement]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSeenAdvancement] =
  let action = tryRead(SSeenAdvancement, getVarInt(r))
  case action.value
  of 0:
    let idStr = tryRead(SSeenAdvancement, getStr(r))
    let id = parse(idStr)
    if not id.isOk:
      return readErr[SSeenAdvancement](messageRead($id.error))
    readOk(SSeenAdvancement(kind: ssaOpenTab, openTab: id.value))
  of 1:
    readOk(SSeenAdvancement(kind: ssaCloseTab))
  else:
    readErr[SSeenAdvancement](messageRead("Invalid SeenAdvancement action: " & $action.value))
