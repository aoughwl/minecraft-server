## Port of pumpkin-protocol/src/java/server/play/select_trade.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SSelectTrade* = object
    selectedSlot*: VarInt

proc toId*(_: typedesc[SSelectTrade]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SELECT_TRADE.toId(v)

proc readPacket*(_: typedesc[SSelectTrade]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSelectTrade] =
  let selectedSlot = tryRead(SSelectTrade, getVarInt(r))
  readOk(SSelectTrade(selectedSlot: selectedSlot))
