## Port of pumpkin-protocol/src/java/server/play/set_beacon.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options

type
  SSetBeacon* = object
    primaryEffect*: Option[VarInt]
    secondaryEffect*: Option[VarInt]

proc toId*(_: typedesc[SSetBeacon]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_BEACON.toId(v)

proc readPacket*(_: typedesc[SSetBeacon]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetBeacon] =
  var primaryEffect = none[VarInt]()
  if tryRead(SSetBeacon, getBool(r)):
    primaryEffect = some(tryRead(SSetBeacon, getVarInt(r)))
  var secondaryEffect = none[VarInt]()
  if tryRead(SSetBeacon, getBool(r)):
    secondaryEffect = some(tryRead(SSetBeacon, getVarInt(r)))
  readOk(SSetBeacon(primaryEffect: primaryEffect, secondaryEffect: secondaryEffect))
