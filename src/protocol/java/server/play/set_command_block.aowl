## Port of pumpkin-protocol/src/java/server/play/set_command_block.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  CommandBlockMode* = enum
    cbmChain
    cbmRepeating
    cbmImpulse  ## Redstone only

proc commandBlockModeFromVarInt*(value: VarInt): (bool, CommandBlockMode) =
  ## Port of `TryFrom<VarInt> for CommandBlockMode`.
  case value.value
  of 0: (true, cbmChain)
  of 1: (true, cbmRepeating)
  of 2: (true, cbmImpulse)
  else: (false, cbmChain)

type
  SSetCommandBlock* = object
    pos*: BlockPos
    command*: string
    mode*: VarInt
    flags*: int8  ## Operation mode flags. 0x01: track output, 0x02: is conditional, 0x04: automatic.

proc toId*(_: typedesc[SSetCommandBlock]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_COMMAND_BLOCK.toId(v)

proc readPacket*(_: typedesc[SSetCommandBlock]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetCommandBlock] =
  let pos = fromI64(tryRead(SSetCommandBlock, getI64Be(r)))
  let command = tryRead(SSetCommandBlock, getStrBounded(r, 32767))
  let mode = tryRead(SSetCommandBlock, getVarInt(r))
  let flags = tryRead(SSetCommandBlock, getI8(r))
  readOk(SSetCommandBlock(pos: pos, command: command, mode: mode, flags: flags))
