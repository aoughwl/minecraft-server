## Port of pumpkin-protocol/src/java/server/play/set_creative_slot.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../itemstackserializer

type
  SSetCreativeSlot* = object
    slot*: int16
    clickedItem*: ItemStackSerializer

proc toId*(_: typedesc[SSetCreativeSlot]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_CREATIVE_MODE_SLOT.toId(v)

proc readPacket*(_: typedesc[SSetCreativeSlot]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetCreativeSlot] =
  let slot = tryRead(SSetCreativeSlot, getI16Be(r))
  let clickedItem = tryRead(SSetCreativeSlot, readLengthPrefixedOptional(r))
  readOk(SSetCreativeSlot(slot: slot, clickedItem: clickedItem))
