## Port of pumpkin-protocol/src/java/server/play/set_held_item.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SSetHeldItem* = object
    slot*: int16

proc toId*(_: typedesc[SSetHeldItem]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_CARRIED_ITEM.toId(v)

proc readPacket*(_: typedesc[SSetHeldItem]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetHeldItem] =
  let slot = tryRead(SSetHeldItem, getI16Be(r))
  readOk(SSetHeldItem(slot: slot))
