## Port of pumpkin-protocol/src/java/server/play/set_jigsaw_block.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  SSetJigsawBlock* = object
    pos*: BlockPos
    name*: string
    target*: string
    pool*: string
    finalState*: string
    joint*: string
    selectionPriority*: VarInt
    placementPriority*: VarInt

proc toId*(_: typedesc[SSetJigsawBlock]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_JIGSAW_BLOCK.toId(v)

proc readPacket*(_: typedesc[SSetJigsawBlock]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetJigsawBlock] =
  let pos = fromI64(tryRead(SSetJigsawBlock, getI64Be(r)))
  let name = tryRead(SSetJigsawBlock, getStrBounded(r, 32767))
  let target = tryRead(SSetJigsawBlock, getStrBounded(r, 32767))
  let pool = tryRead(SSetJigsawBlock, getStrBounded(r, 32767))
  let finalState = tryRead(SSetJigsawBlock, getStrBounded(r, 32767))
  let joint = tryRead(SSetJigsawBlock, getStrBounded(r, 32767))
  let selectionPriority = tryRead(SSetJigsawBlock, getVarInt(r))
  let placementPriority = tryRead(SSetJigsawBlock, getVarInt(r))
  readOk(SSetJigsawBlock(pos: pos, name: name, target: target, pool: pool, finalState: finalState, joint: joint, selectionPriority: selectionPriority, placementPriority: placementPriority))
