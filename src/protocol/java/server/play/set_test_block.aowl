## Port of pumpkin-protocol/src/java/server/play/set_test_block.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

type
  TestBlockMode* = enum
    tbmStart
    tbmLog
    tbmFail
    tbmAccept

  SSetTestBlock* = object
    position*: BlockPos
    mode*: TestBlockMode
    message*: string

proc readTestBlockMode(r: var NetReader): ProtoReadResult[TestBlockMode] =
  let raw = tryRead(TestBlockMode, getVarInt(r))
  case raw.value
  of 0: readOk(tbmStart)
  of 1: readOk(tbmLog)
  of 2: readOk(tbmFail)
  of 3: readOk(tbmAccept)
  else: readErr[TestBlockMode](messageRead("Invalid TestBlockMode"))

proc toId*(_: typedesc[SSetTestBlock]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SET_TEST_BLOCK.toId(v)

proc readPacket*(_: typedesc[SSetTestBlock]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSetTestBlock] =
  let position = fromI64(tryRead(SSetTestBlock, getI64Be(r)))
  let mode = tryRead(SSetTestBlock, readTestBlockMode(r))
  let message = tryRead(SSetTestBlock, getStr(r))
  readOk(SSetTestBlock(position: position, mode: mode, message: message))
