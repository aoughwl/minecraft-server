## Port of pumpkin-protocol/src/java/server/play/swing_arm.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SSwingArm* = object
    hand*: VarInt

proc toId*(_: typedesc[SSwingArm]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SWING.toId(v)

proc readPacket*(_: typedesc[SSwingArm]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SSwingArm] =
  let hand = tryRead(SSwingArm, getVarInt(r))
  readOk(SSwingArm(hand: hand))
