## Port of pumpkin-protocol/src/java/server/play/teleport_to_entity.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../uuid

type
  STeleportToEntity* = object
    target*: Uuid

proc toId*(_: typedesc[STeleportToEntity]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_TELEPORT_TO_ENTITY.toId(v)

proc readPacket*(_: typedesc[STeleportToEntity]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[STeleportToEntity] =
  let target = tryRead(STeleportToEntity, getUuid(r))
  readOk(STeleportToEntity(target: target))
