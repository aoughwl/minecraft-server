## Port of pumpkin-protocol/src/java/server/play/test_instance_block_action.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import std/options
import ../../../../data/block_rotation
import ../../../../util/math/position

type
  TestInstanceBlockAction* = enum
    tibaInit
    tibaQuery
    tibaSet
    tibaReset
    tibaSave
    tibaExport
    tibaRun

  TestInstanceBlockStatus* = enum
    tibsCleared
    tibsRunning
    tibsSuccess
    tibsFailed

  VarIntVector3* = object
    x*: VarInt
    y*: VarInt
    z*: VarInt

  TestInstanceBlockData* = object
    test*: Option[string]
    size*: VarIntVector3
    rotation*: Rotation
    ignoreEntities*: bool
    status*: TestInstanceBlockStatus
    errorMessage*: Option[string]

  STestInstanceBlockAction* = object
    pos*: BlockPos
    action*: TestInstanceBlockAction
    data*: TestInstanceBlockData

proc readAction(r: var NetReader): ProtoReadResult[TestInstanceBlockAction] =
  let raw = tryRead(TestInstanceBlockAction, getVarInt(r))
  case raw.value
  of 0: readOk(tibaInit)
  of 1: readOk(tibaQuery)
  of 2: readOk(tibaSet)
  of 3: readOk(tibaReset)
  of 4: readOk(tibaSave)
  of 5: readOk(tibaExport)
  of 6: readOk(tibaRun)
  else: readErr[TestInstanceBlockAction](messageRead("Invalid TestInstanceBlockAction"))

proc readVector(r: var NetReader): ProtoReadResult[VarIntVector3] =
  let x = tryRead(VarIntVector3, getVarInt(r))
  let y = tryRead(VarIntVector3, getVarInt(r))
  let z = tryRead(VarIntVector3, getVarInt(r))
  readOk(VarIntVector3(x: x, y: y, z: z))

proc readData(r: var NetReader): ProtoReadResult[TestInstanceBlockData] =
  var test = none[string]()
  if tryRead(TestInstanceBlockData, getBool(r)):
    test = some(tryRead(TestInstanceBlockData, getStr(r)))
  let size = tryRead(TestInstanceBlockData, readVector(r))
  var rotation = Rotation.None
  case tryRead(TestInstanceBlockData, getVarInt(r)).value
  of 0: rotation = Rotation.None
  of 1: rotation = Rotation.Clockwise90
  of 2: rotation = Rotation.Rotate180
  of 3: rotation = Rotation.CounterClockwise90
  else: return readErr[TestInstanceBlockData](messageRead("Invalid Rotation"))
  let ignoreEntities = tryRead(TestInstanceBlockData, getBool(r))
  var status = tibsCleared
  case tryRead(TestInstanceBlockData, getVarInt(r)).value
  of 0: status = tibsCleared
  of 1: status = tibsRunning
  of 2: status = tibsSuccess
  of 3: status = tibsFailed
  else: return readErr[TestInstanceBlockData](messageRead("Invalid TestInstanceBlockStatus"))
  var errorMessage = none[string]()
  if tryRead(TestInstanceBlockData, getBool(r)):
    errorMessage = some(tryRead(TestInstanceBlockData, getStr(r)))
  readOk(TestInstanceBlockData(test: test, size: size, rotation: rotation, ignoreEntities: ignoreEntities,
    status: status, errorMessage: errorMessage))

proc toId*(_: typedesc[STestInstanceBlockAction]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_TEST_INSTANCE_BLOCK_ACTION.toId(v)

proc readPacket*(_: typedesc[STestInstanceBlockAction]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[STestInstanceBlockAction] =
  let pos = fromI64(tryRead(STestInstanceBlockAction, getI64Be(r)))
  let action = tryRead(STestInstanceBlockAction, readAction(r))
  let data = tryRead(STestInstanceBlockAction, readData(r))
  readOk(STestInstanceBlockAction(pos: pos, action: action, data: data))
