## Port of pumpkin-protocol/src/java/server/play/update_sign.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position

const MaxLineLength = 386

type
  SUpdateSign* = object
    location*: BlockPos
    isFrontText*: bool
    line1*: string
    line2*: string
    line3*: string
    line4*: string

proc toId*(_: typedesc[SUpdateSign]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_SIGN_UPDATE.toId(v)

proc readPacket*(_: typedesc[SUpdateSign]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SUpdateSign] =
  let location = fromI64(tryRead(SUpdateSign, getI64Be(r)))
  let isFrontText = tryRead(SUpdateSign, getBool(r))
  let line1 = tryRead(SUpdateSign, getStrBounded(r, MaxLineLength))
  let line2 = tryRead(SUpdateSign, getStrBounded(r, MaxLineLength))
  let line3 = tryRead(SUpdateSign, getStrBounded(r, MaxLineLength))
  let line4 = tryRead(SUpdateSign, getStrBounded(r, MaxLineLength))
  readOk(SUpdateSign(location: location, isFrontText: isFrontText, line1: line1, line2: line2, line3: line3, line4: line4))
