## Port of pumpkin-protocol/src/java/server/play/use_item.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion

type
  SUseItem* = object
    hand*: VarInt  ## 0 for main hand, 1 for off hand
    sequence*: VarInt
    yaw*: float32
    pitch*: float32

proc toId*(_: typedesc[SUseItem]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_USE_ITEM.toId(v)

proc readPacket*(_: typedesc[SUseItem]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SUseItem] =
  let hand = tryRead(SUseItem, getVarInt(r))
  let sequence = tryRead(SUseItem, getVarInt(r))
  var yaw = 0.0'f32
  var pitch = 0.0'f32
  if v >= jmvV1_21_2:
    yaw = tryRead(SUseItem, getF32Be(r))
    pitch = tryRead(SUseItem, getF32Be(r))
  readOk(SUseItem(hand: hand, sequence: sequence, yaw: yaw, pitch: pitch))
