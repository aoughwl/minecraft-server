## Port of pumpkin-protocol/src/java/server/play/use_item_on.rs

import ../../../protobase, ../../../netcodec, ../../../varint
import ../../../../generated/packet, ../../../../util/javaversion
import ../../../../util/math/position
import ../../../../util/vector3

type
  SUseItemOn* = object
    hand*: VarInt
    position*: BlockPos
    face*: VarInt
    cursorPos*: Vector3[float32]
    insideBlock*: bool
    isAgainstWorldBorder*: bool
    sequence*: VarInt

proc toId*(_: typedesc[SUseItemOn]; v: JavaMinecraftVersion): int32 =
  SB_PLAY_USE_ITEM_ON.toId(v)

proc readPacket*(_: typedesc[SUseItemOn]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SUseItemOn] =
  let hand = tryRead(SUseItemOn, getVarInt(r))
  let position = fromI64(tryRead(SUseItemOn, getI64Be(r)))
  let face = tryRead(SUseItemOn, getVarInt(r))
  let cx = tryRead(SUseItemOn, getF32Be(r))
  let cy = tryRead(SUseItemOn, getF32Be(r))
  let cz = tryRead(SUseItemOn, getF32Be(r))
  let insideBlock = tryRead(SUseItemOn, getBool(r))
  var isAgainstWorldBorder = false
  if v >= jmvV1_21_5:
    isAgainstWorldBorder = tryRead(SUseItemOn, getBool(r))
  let sequence = tryRead(SUseItemOn, getVarInt(r))
  readOk(SUseItemOn(hand: hand, position: position, face: face, cursorPos: vec3[float32](cx, cy, cz),
    insideBlock: insideBlock, isAgainstWorldBorder: isAgainstWorldBorder, sequence: sequence))
