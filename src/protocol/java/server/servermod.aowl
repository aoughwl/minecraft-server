## Port of pumpkin-protocol/src/java/server/mod.rs
## `mod` is an operator here, so a mod.rs is named after its directory.
##
## Serverbound Packets, Client -> Server. Upstream's are `pub mod`s, each its own namespace, and two of
## them have the same names: `SKeepAlive` and `SCustomClickAction` are in both config and play. Importing
## this module therefore needs those two qualified. A handler for one state imports just that state's
## module.

import config/configmod as serverconfig
import handshake/handshakemod as serverhandshake
import login/loginmod as serverlogin
import play/playmod as serverplay
import status/statusmod as serverstatus

export serverconfig, serverhandshake, serverlogin, serverplay, serverstatus
