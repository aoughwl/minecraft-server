## Known-byte tests for the serverbound packets before play: handshake, status and login.

import std/[options, syncio]
import ../../proto, ../../varint
import ../../../util/javaversion
import ../pkttestutil
import handshake/handshakemod
import login/[cookie_response, encryption_response, login_response, login_start, plugin_response]
import status/[ping_request, status_request]

const V = jmvV1_21_11

block handshake:
  let bytes = hx("8606 09 6c6f63616c686f7374 63dd 02")
  let p = decoded(SHandShake, bytes, V)
  assert p.protocolVersion.value == 774
  assert p.serverAddress == "localhost"
  assert p.serverPort == 25565'u16
  assert p.nextState == csLogin
  assert SHandShake.toId(V) == 0
  assert encoded(p, V) == bytes

block handshakeStates:
  assert decoded(SHandShake, hx("8606 00 63dd 01"), V).nextState == csStatus
  assert decoded(SHandShake, hx("8606 00 63dd 03"), V).nextState == csTransfer
  rejects(SHandShake, hx("8606 00 63dd 00"), V, "Invalid status")
  rejects(SHandShake, hx("8606 00 63dd 04"), V, "Invalid status")

block handshakeAddressBound:
  # 256 characters against the cap of 255, as a 0x80 0x02 length prefix.
  var bytes = hx("8606 8002")
  for i in 0 ..< 256:
    bytes.add(0x61'u8)
  rejects(SHandShake, bytes, V, "too large: string has too many UTF-16 characters (more than the maximum limit 255)")

block statusRequest:
  discard decoded(SStatusRequest, hx(""), V)
  assert encoded(SStatusRequest(), V).len == 0
  assert SStatusRequest.toId(V) == 0

block statusPingRequest:
  let p = decoded(SStatusPingRequest, hx("0102030405060708"), V)
  assert p.payload == 0x0102030405060708'i64
  assert encoded(p, V) == hx("0102030405060708")
  assert SStatusPingRequest.toId(V) == 1

block loginStart:
  let bytes = hx("05 4e6f746368 00112233445566778899aabbccddeeff")
  let p = decoded(SLoginStart, bytes, V)
  assert p.name == "Notch"
  assert p.uuid.hi == 0x0011223344556677'u64
  assert p.uuid.lo == 0x8899aabbccddeeff'u64
  assert SLoginStart.toId(V) == 0
  assert encoded(p, V) == bytes

block loginStartOffline:
  # Before 1.20.2 there is no uuid on the wire. Upstream's `new_v3(nil, "OfflinePlayer:Notch")`, from
  # Python: md5(bytes(16) + b"OfflinePlayer:Notch") with the version and variant bits set.
  let p = decoded(SLoginStart, hx("05 4e6f746368"), jmvV1_20)
  assert p.name == "Notch"
  assert p.uuid.hi == 0x0a6bfc7c05e53c8a'u64
  assert p.uuid.lo == 0x9584264834746b71'u64
  assert encoded(p, jmvV1_20) == hx("05 4e6f746368")

block loginStartBound:
  rejects(SLoginStart, hx("11 6161616161616161616161616161616161"), V,
    "too large: string has too many UTF-16 characters (more than the maximum limit 16)")

block encryptionResponse:
  let bytes = hx("02 aabb 01 cc")
  let p = decoded(SEncryptionResponse, bytes, V)
  assert p.sharedSecret == hx("aabb")
  assert p.verifyToken == hx("cc")
  assert SEncryptionResponse.toId(V) == 1
  assert encoded(p, V) == bytes

block encryptionResponseBounds:
  rejects(SEncryptionResponse, hx("8102"), V, "Encryption payload too large")
  rejects(SEncryptionResponse, hx("ffffffff0f"), V, "Encryption payload too large")
  rejects(SEncryptionResponse, hx("00 8102"), V, "Encryption payload too large")

block loginAcknowledged:
  discard decoded(SLoginAcknowledged, hx(""), V)
  assert SLoginAcknowledged.toId(V) == 3

block loginCookieResponse:
  let p = decoded(SLoginCookieResponse, hx("03 613a62 01 02 0708"), V)
  assert p.key == "a:b"
  assert p.hasPayload
  assert p.payload == hx("0708")
  assert encoded(p, V) == hx("03 613a62 01 02 0708")
  let none1 = decoded(SLoginCookieResponse, hx("03 613a62 00"), V)
  assert not none1.hasPayload
  assert none1.payload.len == 0
  assert SLoginCookieResponse.toId(V) == 4
  rejects(SLoginCookieResponse, hx("03 613a62 01 8128"), V, "too large: SLoginCookieResponse")
  rejects(SLoginCookieResponse, hx("03 613a62 01 ffffffff0f"), V, "too large: SLoginCookieResponse")

block loginPluginResponse:
  let p = decoded(SLoginPluginResponse, hx("07 01 0908"), V)
  assert p.messageId.value == 7
  assert p.hasData
  assert p.data == hx("0908")
  assert encoded(p, V) == hx("07 01 0908")
  let none1 = decoded(SLoginPluginResponse, hx("07 00"), V)
  assert not none1.hasData
  assert none1.data.len == 0
  assert SLoginPluginResponse.toId(V) == 2

block loginPluginResponseBound:
  # One byte over 1 MiB of remaining data.
  var bytes = hx("07 01")
  bytes.setLen(bytes.len + 1_048_577)
  rejects(SLoginPluginResponse, bytes, V, "too large: Read remaining too long")

echo "all serverbound prelude checks passed"
