    ## The server should respond with `CPingResponse`.
    payload*: int64

proc toId*(_: typedesc[SStatusPingRequest]; v: JavaMinecraftVersion): int32 =
  SB_STATUS_PING_REQUEST.toId(v)

proc readPacket*(_: typedesc[SStatusPingRequest]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SStatusPingRequest] =
  let payload = tryRead(SStatusPingRequest, getI64Be(r))
  readOk(SStatusPingRequest(payload: payload))

proc writePacket*(p: SStatusPingRequest; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.payload)
  writeOkVoid()
