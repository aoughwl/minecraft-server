## Zlib byte codec for packet_encoder.aowl and packet_decoder.aowl. Support module with no upstream file
## of its own: it is what the `flate2` and `async_compression` crates are to those two.
##
## src/nbt/zlibgz.aowl is the same binding fixed to the gzip wrapper and the default level, and the frame
## needs the zlib wrapper and a level. Its declarations are private, so this repeats them. Folding the two
## together, by giving zlibgz.aowl a wrapper and level parameter, would leave one binding.

when defined(windows):
  {.passL: "-l:libz.a".}
else:
  {.passL: "-lz".}
{.feature: "lenientnils".}

type
  ZStream {.importc: "z_stream", header: "<zlib.h>", bycopy.} = object
    next_in: ptr byte
    avail_in: cuint
    next_out: ptr byte
    avail_out: cuint
    msg: cstring

  ZlibResult* = object
    ok*: bool
    data*: seq[byte] ## On a failed inflate: whatever came out before the failure.
    msg*: string

const
  zNoFlush = 0.cint
  zFinish = 4.cint
  zOk = 0.cint
  zStreamEnd = 1.cint
  zBufError = -5.cint
  zDeflated = 8.cint
  zDefaultStrategy = 0.cint
  wbitsZlib = 15.cint

proc deflateInit2Raw(s: ptr ZStream, level, meth, wbits, memLevel, strategy: cint,
                     version: cstring, size: cint): cint {.importc: "deflateInit2_", header: "<zlib.h>".}
proc zDeflate(s: ptr ZStream, flush: cint): cint {.importc: "deflate", header: "<zlib.h>".}
proc zDeflateEnd(s: ptr ZStream): cint {.importc: "deflateEnd", header: "<zlib.h>".}
proc zDeflateBound(s: ptr ZStream, n: culong): culong {.importc: "deflateBound", header: "<zlib.h>".}
proc inflateInit2Raw(s: ptr ZStream, wbits: cint, version: cstring, size: cint): cint
  {.importc: "inflateInit2_", header: "<zlib.h>".}
proc zInflate(s: ptr ZStream, flush: cint): cint {.importc: "inflate", header: "<zlib.h>".}
proc zInflateEnd(s: ptr ZStream): cint {.importc: "inflateEnd", header: "<zlib.h>".}
proc zVersion(): cstring {.importc: "zlibVersion", header: "<zlib.h>".}

proc msgText(c: cstring): string =
  result = ""
  if c != nil:
    var i = 0
    while uint8(c[i]) != 0:
      result.add c[i]
      inc i

proc zlibCompressBytes*(input: openArray[byte]; level: uint32): ZlibResult =
  ## Upstream's `Compress::new(Compression::new(level), true)` run to `FlushCompress::Finish`.
  if level > 9'u32:
    return ZlibResult(ok: false, data: @[], msg: "invalid compression level " & $level)
  var s {.noinit.}: ZStream
  zeroMem(addr s, sizeof(ZStream))
  if deflateInit2Raw(addr s, cint(level), zDeflated, wbitsZlib, 8.cint, zDefaultStrategy,
                     zVersion(), cint(sizeof(ZStream))) != zOk:
    return ZlibResult(ok: false, data: @[], msg: "deflateInit failed")
  var output = newSeq[byte](int(zDeflateBound(addr s, culong(input.len))) + 64)
  s.next_in = if input.len > 0: unsafeAddr input[0] else: nil
  s.avail_in = cuint(input.len)
  s.next_out = addr output[0]
  s.avail_out = cuint(output.len)
  let rc = zDeflate(addr s, zFinish)
  let left = int(s.avail_out)
  discard zDeflateEnd(addr s)
  if rc != zStreamEnd:
    return ZlibResult(ok: false, data: @[], msg: "Unexpected compressor status: " & $int(rc))
  output.setLen(output.len - left)
  ZlibResult(ok: true, data: output, msg: "")

proc zlibDecompressBytes*(input: openArray[byte]; limit: int): ZlibResult =
  ## Inflates one zlib stream, stopping once `limit` bytes are out; a caller that wants to see an
  ## overlong stream asks for one byte more than it expects. Bytes after the stream's end are ignored.
  ## A truncated or corrupt stream is `ok: false` with the bytes it did yield.
  var s {.noinit.}: ZStream
  zeroMem(addr s, sizeof(ZStream))
  if inflateInit2Raw(addr s, wbitsZlib, zVersion(), cint(sizeof(ZStream))) != zOk:
    return ZlibResult(ok: false, data: @[], msg: "inflateInit failed")
  var output = newSeq[byte](min(max(input.len * 4, 4096), limit))
  s.next_in = if input.len > 0: unsafeAddr input[0] else: nil
  s.avail_in = cuint(input.len)
  s.next_out = addr output[0]
  s.avail_out = cuint(output.len)
  var used = 0
  while true:
    let rc = zInflate(addr s, zNoFlush)
    used = output.len - int(s.avail_out)
    if rc == zStreamEnd:
      break
    if rc != zOk and rc != zBufError:
      let m = msgText(s.msg)
      discard zInflateEnd(addr s)
      output.setLen(used)
      return ZlibResult(ok: false, data: output, msg: if m.len > 0: m else: "inflate failed: " & $int(rc))
    if s.avail_out != 0:
      if s.avail_in == 0:
        discard zInflateEnd(addr s)
        output.setLen(used)
        return ZlibResult(ok: false, data: output, msg: "unexpected end of file")
      continue
    if output.len >= limit:
      break
    output.setLen(min(output.len * 2, limit))
    s.next_out = addr output[used]
    s.avail_out = cuint(output.len - used)
  discard zInflateEnd(addr s)
  output.setLen(used)
  ZlibResult(ok: true, data: output, msg: "")
