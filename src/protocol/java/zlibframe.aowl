## Zlib byte codec for packet_encoder.aowl and packet_decoder.aowl. Support module with no upstream file
## of its own: it is what the `flate2` and `async_compression` crates are to those two.
##
## A wrapper over src/util/zlibcore.aowl, the one zlib binding: this fixes the zlib wrapper and takes a level.

import ../../util/zlibcore

type
  ZlibResult* = object
    ok*: bool
    data*: seq[byte] ## On a failed inflate: whatever came out before the failure.
    msg*: string

proc zlibCompressBytes*(input: openArray[byte]; level: uint32): ZlibResult =
  ## Upstream's `Compress::new(Compression::new(level), true)` run to `FlushCompress::Finish`.
  if level > 9'u32:
    return ZlibResult(ok: false, data: @[], msg: "invalid compression level " & $level)
  let r = zlibDeflate(input, cint(level), WbitsZlib)
  case r.failure
  of zfNone: ZlibResult(ok: true, data: r.data, msg: "")
  of zfInit: ZlibResult(ok: false, data: @[], msg: "deflateInit failed")
  else: ZlibResult(ok: false, data: @[], msg: "Unexpected compressor status: " & $r.rc)

proc zlibDecompressBytes*(input: openArray[byte]; limit: int): ZlibResult =
  ## Inflates one zlib stream, stopping once `limit` bytes are out; a caller that wants to see an
  ## overlong stream asks for one byte more than it expects. Bytes after the stream's end are ignored.
  ## A truncated or corrupt stream is `ok: false` with the bytes it did yield.
  let r = zlibInflate(input, WbitsZlib, limit, lmTruncate)
  case r.failure
  of zfNone: ZlibResult(ok: true, data: r.data, msg: "")
  of zfInit: ZlibResult(ok: false, data: @[], msg: "inflateInit failed")
  of zfTruncated: ZlibResult(ok: false, data: r.data, msg: "unexpected end of file")
  else: ZlibResult(ok: false, data: r.data, msg: if r.zmsg.len > 0: r.zmsg else: "inflate failed: " & $r.rc)
