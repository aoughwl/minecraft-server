## Port of pumpkin-protocol/src/codec/little_endian.rs
##
## Upstream's writers call `write_slice(to_le_bytes)`. The buffer cannot fail
## here, so `write` returns nothing (see netcodec.aowl's header).

import netcodec

type
  Le64* = object
    value*: int64
  Le32* = object
    value*: int32
  Le16* = object
    value*: int16
  LeU64* = object
    value*: uint64
  LeU32* = object
    value*: uint32
  LeU16* = object
    value*: uint16

proc writeLe(w: var NetWriter; v: uint64; bytes: int) =
  var shift = 0
  for i in 0 ..< bytes:
    writeU8(w, uint8((v shr uint64(shift)) and 0xFF'u64))
    shift += 8

proc write*(self: Le64; w: var NetWriter) = writeLe(w, cast[uint64](self.value), 8)
proc write*(self: Le32; w: var NetWriter) = writeLe(w, uint64(cast[uint32](self.value)), 4)
proc write*(self: Le16; w: var NetWriter) = writeLe(w, uint64(cast[uint16](self.value)), 2)
proc write*(self: LeU64; w: var NetWriter) = writeLe(w, self.value, 8)
proc write*(self: LeU32; w: var NetWriter) = writeLe(w, uint64(self.value), 4)
proc write*(self: LeU16; w: var NetWriter) = writeLe(w, uint64(self.value), 2)
