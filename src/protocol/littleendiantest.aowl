## Known-answer test for littleendian.aowl.
import std/assertions
import std/syncio
import netcodec, littleendian

var w = newNetWriter()
Le64(value: 1'i64).write(w)
Le32(value: -2'i32).write(w)
Le16(value: 0x0102'i16).write(w)
LeU64(value: 0x0102030405060708'u64).write(w)
LeU32(value: 0x01020304'u32).write(w)
LeU16(value: 0xFFFE'u16).write(w)
assert w.buf == @[1'u8, 0, 0, 0, 0, 0, 0, 0,
  0xFE, 0xFF, 0xFF, 0xFF,
  2, 1,
  8, 7, 6, 5, 4, 3, 2, 1,
  4, 3, 2, 1,
  0xFE, 0xFF]
echo "all little-endian checks passed"
