## Concrete Java-edition login/configuration-state packet types, in the convention
## documented at the top of proto.aowl.
## Port of pumpkin-protocol/src/java/client/login/set_compression.rs,
## pumpkin-protocol/src/java/client/login/login_disconnect.rs,
## pumpkin-protocol/src/java/client/login/cookie_request.rs,
## pumpkin-protocol/src/java/client/config/finish_config.rs,
## pumpkin-protocol/src/java/server/config/keep_alive.rs,
## pumpkin-protocol/src/java/server/config/acknowledge_finish_config.rs,
## pumpkin-protocol/src/java/server/login/cookie_response.rs and
## pumpkin-protocol/src/java/server/login/plugin_response.rs
##
## These have no version gates upstream. They predate the one-file-per-packet layout
## and keep a read and a write each for their round-trip test, where upstream has only
## the direction the server uses. `SConfigPong` has no file in the pinned tree: it is
## an earlier addition for an id the tables do have, not a port of an upstream packet.

import protobase, netcodec, varint
import ../generated/packet
import ../util/javaversion

# --- CSetCompression / login_compression -----------------------------------

type
  CSetCompression* = object
    threshold*: VarInt

proc toId*(_: typedesc[CSetCompression]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_LOGIN_COMPRESSION.toId(v)

proc writePacket*(p: CSetCompression; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.threshold)
  writeOkVoid()

proc readPacket*(_: typedesc[CSetCompression]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CSetCompression] =
  let threshold = tryRead(CSetCompression, getVarInt(r))
  readOk(CSetCompression(threshold: threshold))

# --- CLoginDisconnect --------------------------------------------------

type
  CLoginDisconnect* = object
    jsonReason*: string

proc toId*(_: typedesc[CLoginDisconnect]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_LOGIN_DISCONNECT.toId(v)

proc writePacket*(p: CLoginDisconnect; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeString(w, p.jsonReason)

proc readPacket*(_: typedesc[CLoginDisconnect]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CLoginDisconnect] =
  let reason = tryRead(CLoginDisconnect, getStr(r))
  readOk(CLoginDisconnect(jsonReason: reason))

# --- SKeepAlive (config-state serverbound keep-alive reply) -----------------

type
  SKeepAlive* = object
    keepAliveId*: int64

proc toId*(_: typedesc[SKeepAlive]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_KEEP_ALIVE.toId(v)

proc writePacket*(p: SKeepAlive; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI64Be(w, p.keepAliveId)
  writeOkVoid()

proc readPacket*(_: typedesc[SKeepAlive]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SKeepAlive] =
  let id = tryRead(SKeepAlive, getI64Be(r))
  readOk(SKeepAlive(keepAliveId: id))

# --- SConfigPong ---------------------------------------------------------

type
  SConfigPong* = object
    id*: int32

proc toId*(_: typedesc[SConfigPong]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_PONG.toId(v)

proc writePacket*(p: SConfigPong; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeI32Be(w, p.id)
  writeOkVoid()

proc readPacket*(_: typedesc[SConfigPong]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SConfigPong] =
  let id = tryRead(SConfigPong, getI32Be(r))
  readOk(SConfigPong(id: id))

# --- CFinishConfig / SAcknowledgeFinishConfig (empty-body packets) ---------

type
  CFinishConfig* = object
  SAcknowledgeFinishConfig* = object

proc toId*(_: typedesc[CFinishConfig]; v: JavaMinecraftVersion): int32 =
  CB_CONFIG_FINISH_CONFIGURATION.toId(v)

proc writePacket*(p: CFinishConfig; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeOkVoid()

proc readPacket*(_: typedesc[CFinishConfig]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[CFinishConfig] =
  readOk(CFinishConfig())

proc toId*(_: typedesc[SAcknowledgeFinishConfig]; v: JavaMinecraftVersion): int32 =
  SB_CONFIG_FINISH_CONFIGURATION.toId(v)

proc writePacket*(p: SAcknowledgeFinishConfig; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeOkVoid()

proc readPacket*(_: typedesc[SAcknowledgeFinishConfig]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SAcknowledgeFinishConfig] =
  readOk(SAcknowledgeFinishConfig())

# --- CLoginCookieRequest (clientbound only) --------------------------------

type
  CLoginCookieRequest* = object
    key*: string

proc toId*(_: typedesc[CLoginCookieRequest]; v: JavaMinecraftVersion): int32 =
  CB_LOGIN_COOKIE_REQUEST.toId(v)

proc writePacket*(p: CLoginCookieRequest; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeString(w, p.key)

# --- SLoginCookieResponse (serverbound only) -------------------------------

const MaxCookieLength = 5120

type
  SLoginCookieResponse* = object
    key*: string
    hasPayload*: bool
    payload*: seq[byte]  ## meaningful only when hasPayload

proc toId*(_: typedesc[SLoginCookieResponse]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_COOKIE_RESPONSE.toId(v)

proc writePacket*(p: SLoginCookieResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  tryWrite writeString(w, p.key)
  writeBool(w, p.hasPayload)
  if p.hasPayload:
    writeVarInt(w, newVarInt(int32(p.payload.len)))
    writeSlice(w, p.payload)
  writeOkVoid()

proc readPacket*(_: typedesc[SLoginCookieResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SLoginCookieResponse] =
  let key = tryRead(SLoginCookieResponse, getStr(r))
  if not tryRead(SLoginCookieResponse, getBool(r)):
    return readOk(SLoginCookieResponse(key: key, hasPayload: false, payload: @[]))
  let length = int(tryRead(SLoginCookieResponse, getVarInt(r)).value)
  if length < 0 or length > MaxCookieLength:
    return readErr[SLoginCookieResponse](tooLarge("SLoginCookieResponse"))
  let payload = tryRead(SLoginCookieResponse, readSlice(r, length))
  readOk(SLoginCookieResponse(key: key, hasPayload: true, payload: payload))

# --- SLoginPluginResponse ---------------------------------------------------
# `data` has no length prefix: it is the rest of the packet.

const MaxPluginPayloadSize = 1_048_576

type
  SLoginPluginResponse* = object
    messageId*: VarInt
    hasData*: bool
    data*: seq[byte]

proc toId*(_: typedesc[SLoginPluginResponse]; v: JavaMinecraftVersion): int32 =
  SB_LOGIN_CUSTOM_QUERY_ANSWER.toId(v)

proc writePacket*(p: SLoginPluginResponse; w: var NetWriter; v: JavaMinecraftVersion): ProtoWriteVoidResult =
  writeVarInt(w, p.messageId)
  writeBool(w, p.hasData)
  if p.hasData:
    writeSlice(w, p.data)
  writeOkVoid()

proc readPacket*(_: typedesc[SLoginPluginResponse]; r: var NetReader; v: JavaMinecraftVersion): ProtoReadResult[SLoginPluginResponse] =
  let messageId = tryRead(SLoginPluginResponse, getVarInt(r))
  if not tryRead(SLoginPluginResponse, getBool(r)):
    return readOk(SLoginPluginResponse(messageId: messageId, hasData: false, data: @[]))
  let data = tryRead(SLoginPluginResponse, readRemainingSlice(r, MaxPluginPayloadSize))
  readOk(SLoginPluginResponse(messageId: messageId, hasData: true, data: data))
