## Round-trip test for src/protocol/loginpackets.aowl - actually run via
## `aowlmony c -r`, not just compile-checked.

import std/assertions
import std/syncio
import ../util/javaversion
import protobase, netcodec, varint, loginpackets

proc bytesOf(w: NetWriter): seq[byte] = w.buf

block setCompression:
  let p = CSetCompression(threshold: newVarInt(256))
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(CSetCompression, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.threshold.value == 256
  echo "CSetCompression: OK"

block loginDisconnect:
  let p = CLoginDisconnect(jsonReason: "{\"text\":\"kicked\"}")
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(CLoginDisconnect, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.jsonReason == p.jsonReason
  echo "CLoginDisconnect: OK"

block keepAlive:
  let p = SKeepAlive(keepAliveId: 123456789012345'i64)
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SKeepAlive, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.keepAliveId == p.keepAliveId
  echo "SKeepAlive: OK"

block configPong:
  let p = SConfigPong(id: -42)
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SConfigPong, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.id == p.id
  echo "SConfigPong: OK"

block finishConfig:
  let p = CFinishConfig()
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  assert bytesOf(w).len == 0
  var r = newNetReader(bytesOf(w))
  let got = readPacket(CFinishConfig, r, jmvV1_21_11)
  assert got.isOk
  echo "CFinishConfig: OK"

block ackFinishConfig:
  let p = SAcknowledgeFinishConfig()
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  assert bytesOf(w).len == 0
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SAcknowledgeFinishConfig, r, jmvV1_21_11)
  assert got.isOk
  echo "SAcknowledgeFinishConfig: OK"

block cookieRequest:
  let p = CLoginCookieRequest(key: "minecraft:example")
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  assert bytesOf(w).len > 0
  echo "CLoginCookieRequest: OK (write-only packet)"

block cookieResponseWithPayload:
  let p = SLoginCookieResponse(key: "minecraft:example", hasPayload: true, payload: @[1'u8, 2, 3, 4])
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SLoginCookieResponse, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.key == p.key
  assert got.value.hasPayload
  assert got.value.payload == p.payload
  echo "SLoginCookieResponse (with payload): OK"

block cookieResponseNoPayload:
  let p = SLoginCookieResponse(key: "minecraft:none", hasPayload: false, payload: @[])
  var w = newNetWriter()
  let wr = writePacket(p, w, jmvV1_21_11)
  assert wr.isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SLoginCookieResponse, r, jmvV1_21_11)
  assert got.isOk
  assert not got.value.hasPayload
  echo "SLoginCookieResponse (no payload): OK"

block pluginResponseWithData:
  let p = SLoginPluginResponse(messageId: newVarInt(7), hasData: true, data: @[9'u8, 8, 7])
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SLoginPluginResponse, r, jmvV1_21_11)
  assert got.isOk
  assert got.value.messageId.value == 7
  assert got.value.hasData
  assert got.value.data == p.data
  echo "SLoginPluginResponse (with data): OK"

block pluginResponseNoData:
  let p = SLoginPluginResponse(messageId: newVarInt(8), hasData: false, data: @[])
  var w = newNetWriter()
  assert writePacket(p, w, jmvV1_21_11).isOk
  var r = newNetReader(bytesOf(w))
  let got = readPacket(SLoginPluginResponse, r, jmvV1_21_11)
  assert got.isOk
  assert not got.value.hasData
  echo "SLoginPluginResponse (no data): OK"

block exactBytes:
  var w = newNetWriter()
  assert writePacket(CSetCompression(threshold: newVarInt(256)), w, jmvV1_21_11).isOk
  assert w.buf == @[0x80'u8, 0x02]

  w = newNetWriter()
  assert writePacket(SLoginCookieResponse(key: "a:b", hasPayload: true, payload: @[7'u8]), w, jmvV1_21_11).isOk
  assert w.buf == @[3'u8, 0x61, 0x3A, 0x62, 1, 1, 7]

  w = newNetWriter()
  assert writePacket(SLoginPluginResponse(messageId: newVarInt(7), hasData: true, data: @[9'u8, 8]), w, jmvV1_21_11).isOk
  assert w.buf == @[7'u8, 1, 9, 8]

block ids774:
  # assets/packet/1_21_11_packets.json
  assert CSetCompression.toId(jmvV1_21_11) == 3'i32
  assert CLoginDisconnect.toId(jmvV1_21_11) == 0'i32
  assert CLoginCookieRequest.toId(jmvV1_21_11) == 5'i32
  assert SKeepAlive.toId(jmvV1_21_11) == 4'i32
  assert SConfigPong.toId(jmvV1_21_11) == 5'i32
  assert CFinishConfig.toId(jmvV1_21_11) == 3'i32
  assert SAcknowledgeFinishConfig.toId(jmvV1_21_11) == 3'i32

echo "all login/config packet round-trip checks passed"
