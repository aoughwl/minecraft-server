## Upstream's lp_vector_3d.rs tests, plus known answers for the packed form worked
## out by hand from the bit layout.
import std/assertions
import std/syncio
import protobase, netcodec, varint, lpvector3d
import ../util/vector3

proc v3(x, y, z: float64): LpVector3d =
  LpVector3d(value: Vector3[float64](x: x, y: y, z: z))

proc packed(x, y, z: float64): seq[byte] =
  var w = newNetWriter()
  v3(x, y, z).write(w)
  w.buf

# legacy_component_is_clamped_and_scaled
assert encodeLegacyVelocityComponent(0.5) == 4000'i16
assert encodeLegacyVelocityComponent(-0.5) == -4000'i16
assert encodeLegacyVelocityComponent(4.0) == 31200'i16
assert encodeLegacyVelocityComponent(-4.0) == -31200'i16

# write_legacy_writes_three_i16_be_components
block:
  var w = newNetWriter()
  v3(0.5, -0.5, 0.0).writeLegacy(w)
  assert w.buf == @[0x0F'u8, 0xA0, 0xF0, 0x60, 0x00, 0x00]

# Too small to send is the one zero byte.
assert packed(0.0, 0.0, 0.0) == @[0'u8]
assert packed(1e-6, -1e-6, 0.0) == @[0'u8]

assert packed(0.5, -0.5, 0.0) == @[0xF9'u8, 0xFF, 0x7F, 0xFE, 0x80, 0x02]
assert packed(1.0, 0.0, 0.0) == @[0xF1'u8, 0xFF, 0x7F, 0xFE, 0xFF, 0xFF]
# Scale 8: above 3, so the header has the extension flag and a VarInt tail of 8 >> 2.
assert packed(8.0, 0.0, -4.0) == @[0xF4'u8, 0xFF, 0x40, 0x00, 0xFF, 0xFF, 0x02]

proc near(a, b: float64): bool =
  abs(a - b) < 0.001

block roundTrip:
  var r = newNetReader(packed(0.5, -0.5, 0.0))
  let got = read(LpVector3d, r)
  assert got.isOk
  assert near(got.value.value.x, 0.5) and near(got.value.value.y, -0.5) and near(got.value.value.z, 0.0)
  assert r.pos == 6

block roundTripExtended:
  var r = newNetReader(packed(8.0, 0.0, -4.0))
  let got = read(LpVector3d, r)
  assert got.isOk
  assert near(got.value.value.x, 8.0) and near(got.value.value.y, 0.0) and near(got.value.value.z, -4.0)
  assert r.pos == 7

block zeroReadsTwoBytes:
  var r = newNetReader(@[0'u8, 0, 9])
  let got = read(LpVector3d, r)
  assert got.isOk and got.value.value.x == 0.0
  assert r.pos == 2

block nanIsZero:
  let nan = 0.0 / 0.0
  assert packed(nan, 0.0, 0.0) == @[0'u8]
  assert encodeLegacyVelocityComponent(nan) == 0'i16

block truncated:
  var r = newNetReader(@[0xF9'u8, 0xFF, 0x7F])
  assert not read(LpVector3d, r).isOk

echo "all lp vector checks passed"
