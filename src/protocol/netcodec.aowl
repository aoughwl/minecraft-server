## The concrete network read/write primitives packet types build on.
## Port of pumpkin-protocol/src/ser/mod.rs's `NetworkReadExt`/`NetworkWriteExt`/
## `NetworkReadSliceExt` traits and `read_remaining_bytes`.
##
## Upstream is a trait implemented generically for any `Read`/`Write`.
## aowlmony has no traits, so (matching src/nbt/serializer.aowl's/
## deserializer.aowl's precedent) this is one concrete `NetReader`/
## `NetWriter` pair operating on an owned `seq[byte]` with a cursor/buffer.
## Consequences, all deliberate:
## - Writing to a `seq` cannot fail, so primitive writes return nothing. Only the
##   writes upstream can fail for another reason (`writeString`, `writeNbt`)
##   return a `ProtoWriteVoidResult`.
## - `NetworkReadSliceExt`'s `*_borrowed`/`*_cow_*` variants exist only for Rust's
##   borrow checker. `readSlice`, `readRemainingSlice` and `getStr` are all of
##   them here; there are no separate borrowed forms.
## - i128/u128 have no aowlmony type, so they are (high, low) pairs.
## - `get_uuid`/`write_uuid` are in uuid.aowl and `write_bitset` in bitset.aowl,
##   beside their types.

import std/options
import protobase, varint
import ../util/math/position
import ../nbt/[nbtbase, serializer, tag]

type
  NetReader* = object
    data*: seq[byte]
    pos*: int

  NetWriter* = object
    buf*: seq[byte]

proc newNetReader*(data: sink seq[byte]): NetReader =
  NetReader(data: data, pos: 0)

proc newNetWriter*(): NetWriter =
  NetWriter(buf: @[])

proc remaining*(r: NetReader): int {.inline.} =
  r.data.len - r.pos

# --- reads -------------------------------------------------------------

proc readBytesToBuf*(r: var NetReader, buf: var seq[byte]): ProtoReadVoidResult =
  let n = buf.len
  if remaining(r) < n:
    return readErrVoid(incompleteRead("needed " & $n & " bytes, only " & $remaining(r) & " remaining"))
  for i in 0 ..< n:
    buf[i] = r.data[r.pos + i]
  r.pos += n
  readOkVoid()

proc getU8*(r: var NetReader): ProtoReadResult[uint8] =
  if remaining(r) < 1:
    return readErr[uint8](incompleteRead("EOF, Tried to read 1 bytes but only 0 bytes left"))
  result = readOk[uint8](r.data[r.pos])
  inc r.pos

proc getI8*(r: var NetReader): ProtoReadResult[int8] =
  let b = getU8(r)
  if not b.isOk: return readErr[int8](b.error)
  readOk[int8](cast[int8](b.value))

proc getSlice(r: var NetReader, n: int): ProtoReadResult[seq[byte]] =
  if n < 0 or remaining(r) < n:
    return readErr[seq[byte]](incompleteRead("EOF, Tried to read " & $n & " bytes but only " & $remaining(r) & " bytes left"))
  var s = newSeq[byte](n)
  for i in 0 ..< n: s[i] = r.data[r.pos + i]
  r.pos += n
  readOk[seq[byte]](s)

proc beU16(b: seq[byte]): uint16 {.inline.} = (uint16(b[0]) shl 8) or uint16(b[1])
proc beU32(b: seq[byte]): uint32 {.inline.} =
  (uint32(b[0]) shl 24) or (uint32(b[1]) shl 16) or (uint32(b[2]) shl 8) or uint32(b[3])
proc beU64(b: seq[byte]): uint64 {.inline.} =
  result = 0
  for x in b: result = (result shl 8) or uint64(x)

proc getI16Be*(r: var NetReader): ProtoReadResult[int16] =
  let s = getSlice(r, 2)
  if not s.isOk: return readErr[int16](s.error)
  readOk[int16](cast[int16](beU16(s.value)))

proc getU16Be*(r: var NetReader): ProtoReadResult[uint16] =
  let s = getSlice(r, 2)
  if not s.isOk: return readErr[uint16](s.error)
  readOk[uint16](beU16(s.value))

proc getI32Be*(r: var NetReader): ProtoReadResult[int32] =
  let s = getSlice(r, 4)
  if not s.isOk: return readErr[int32](s.error)
  readOk[int32](cast[int32](beU32(s.value)))

proc getU32Be*(r: var NetReader): ProtoReadResult[uint32] =
  let s = getSlice(r, 4)
  if not s.isOk: return readErr[uint32](s.error)
  readOk[uint32](beU32(s.value))

proc getI64Be*(r: var NetReader): ProtoReadResult[int64] =
  let s = getSlice(r, 8)
  if not s.isOk: return readErr[int64](s.error)
  readOk[int64](cast[int64](beU64(s.value)))

proc getU64Be*(r: var NetReader): ProtoReadResult[uint64] =
  let s = getSlice(r, 8)
  if not s.isOk: return readErr[uint64](s.error)
  readOk[uint64](beU64(s.value))

proc getF32Be*(r: var NetReader): ProtoReadResult[float32] =
  let s = getSlice(r, 4)
  if not s.isOk: return readErr[float32](s.error)
  readOk[float32](cast[float32](beU32(s.value)))

proc getF64Be*(r: var NetReader): ProtoReadResult[float64] =
  let s = getSlice(r, 8)
  if not s.isOk: return readErr[float64](s.error)
  readOk[float64](cast[float64](beU64(s.value)))

proc getI128Be*(r: var NetReader): ProtoReadResult[(int64, uint64)] =
  ## (high, low). Upstream returns `i128`.
  let s = getSlice(r, 16)
  if not s.isOk: return readErr[(int64, uint64)](s.error)
  var hi = 0'u64
  var lo = 0'u64
  for i in 0 ..< 8:
    hi = (hi shl 8) or uint64(s.value[i])
    lo = (lo shl 8) or uint64(s.value[i + 8])
  readOk[(int64, uint64)]((cast[int64](hi), lo))

proc getU128Be*(r: var NetReader): ProtoReadResult[(uint64, uint64)] =
  ## (high, low). Upstream returns `u128`.
  let s = getSlice(r, 16)
  if not s.isOk: return readErr[(uint64, uint64)](s.error)
  var hi = 0'u64
  var lo = 0'u64
  for i in 0 ..< 8:
    hi = (hi shl 8) or uint64(s.value[i])
    lo = (lo shl 8) or uint64(s.value[i + 8])
  readOk[(uint64, uint64)]((hi, lo))

# Upstream's default-method aliases: the protocol's numbers are big-endian.
proc getI16*(r: var NetReader): ProtoReadResult[int16] {.inline.} = getI16Be(r)
proc getU16*(r: var NetReader): ProtoReadResult[uint16] {.inline.} = getU16Be(r)
proc getI32*(r: var NetReader): ProtoReadResult[int32] {.inline.} = getI32Be(r)
proc getU32*(r: var NetReader): ProtoReadResult[uint32] {.inline.} = getU32Be(r)
proc getI64*(r: var NetReader): ProtoReadResult[int64] {.inline.} = getI64Be(r)
proc getU64*(r: var NetReader): ProtoReadResult[uint64] {.inline.} = getU64Be(r)
proc getF32*(r: var NetReader): ProtoReadResult[float32] {.inline.} = getF32Be(r)
proc getF64*(r: var NetReader): ProtoReadResult[float64] {.inline.} = getF64Be(r)

proc readSlice*(r: var NetReader, count: int): ProtoReadResult[seq[byte]] =
  ## Port of `read_slice_borrowed`.
  getSlice(r, count)

proc readRemainingSlice*(r: var NetReader, bound: int): ProtoReadResult[seq[byte]] =
  ## Port of `read_remaining_slice_borrowed`/`read_remaining_bytes`.
  if remaining(r) > bound:
    return readErr[seq[byte]](tooLarge("Read remaining too long"))
  getSlice(r, remaining(r))

proc getBool*(r: var NetReader): ProtoReadResult[bool] =
  let b = getU8(r)
  if not b.isOk: return readErr[bool](b.error)
  readOk[bool](b.value != 0)

proc getVarInt*(r: var NetReader): ProtoReadResult[VarInt] =
  decodeJava(r.data, r.pos)

proc getVarUInt*(r: var NetReader): ProtoReadResult[VarUInt] =
  decode(r.data, r.pos, VarUInt)

proc getVarLong*(r: var NetReader): ProtoReadResult[VarLong] =
  decodeJava(r.data, r.pos, VarLong)

proc getVarULong*(r: var NetReader): ProtoReadResult[VarULong] =
  decode(r.data, r.pos, VarULong)

proc utf16Len(s: string): int =
  ## Number of UTF-16 code units a valid UTF-8 `s` would encode as. Used only for
  ## the bound check in `getStrBounded` (matching upstream's
  ## `string.encode_utf16().nth(bound)`), not for producing UTF-16 data.
  var i = 0
  result = 0
  let n = s.len
  while i < n:
    let c0 = s[i].uint8
    if c0 < 0x80'u8:
      inc result
      inc i
    elif c0 < 0xE0'u8:
      inc result
      i += 2
    elif c0 < 0xF0'u8:
      inc result
      i += 3
    else:
      result += 2
      i += 4

proc isValidUtf8*(s: string): bool =
  ## What `std::str::from_utf8` accepts: no overlong forms, no surrogates,
  ## nothing above U+10FFFF, no truncated sequence.
  var i = 0
  let n = s.len
  while i < n:
    let c0 = s[i].uint8
    var need = 0
    var lo = 0x80'u8
    var hi = 0xBF'u8
    if c0 < 0x80'u8:
      need = 0
    elif c0 >= 0xC2'u8 and c0 <= 0xDF'u8:
      need = 1
    elif c0 >= 0xE0'u8 and c0 <= 0xEF'u8:
      need = 2
      if c0 == 0xE0'u8: lo = 0xA0'u8
      if c0 == 0xED'u8: hi = 0x9F'u8
    elif c0 >= 0xF0'u8 and c0 <= 0xF4'u8:
      need = 3
      if c0 == 0xF0'u8: lo = 0x90'u8
      if c0 == 0xF4'u8: hi = 0x8F'u8
    else:
      return false
    if i + need >= n:
      return false
    for k in 1 .. need:
      let c = s[i + k].uint8
      if c < lo or c > hi:
        return false
      lo = 0x80'u8
      hi = 0xBF'u8
    i += need + 1
  true

proc getStrBounded*(r: var NetReader, bound: int): ProtoReadResult[string] =
  ## `bound` is the maximum number of Java `char`s allowed.
  let lenR = getVarUInt(r)
  if not lenR.isOk: return readErr[string](lenR.error)
  let bytesLen = int(lenR.value.value)
  # 1 Java `char` takes a maximum of 3 bytes in UTF-8.
  let maxUtf8Bytes = bound * 3
  if bytesLen > maxUtf8Bytes:
    return readErr[string](tooLarge("string has too many bytes (" & $bytesLen & " > " & $maxUtf8Bytes & ")"))
  let s = getSlice(r, bytesLen)
  if not s.isOk: return readErr[string](s.error)
  var str = newString(bytesLen)
  for i, b in s.value: str[i] = char(b)
  if not isValidUtf8(str):
    return readErr[string](messageRead("invalid utf-8 sequence"))
  if utf16Len(str) > bound:
    return readErr[string](tooLarge("string has too many UTF-16 characters (more than the maximum limit " & $bound & ")"))
  readOk[string](str)

proc getStr*(r: var NetReader): ProtoReadResult[string] =
  ## Upstream's `get_str_bounded(i32::MAX as usize)`.
  getStrBounded(r, int(int32.high))

proc getUuidPair*(r: var NetReader): ProtoReadResult[(uint64, uint64)] =
  ## The (high, low) 64-bit halves of upstream's `get_uuid`. uuid.aowl wraps this
  ## as `getUuid`.
  let hi = getU64Be(r)
  if not hi.isOk: return readErr[(uint64, uint64)](hi.error)
  let lo = getU64Be(r)
  if not lo.isOk: return readErr[(uint64, uint64)](lo.error)
  readOk[(uint64, uint64)]((hi.value, lo.value))

proc getFixedBitset*(r: var NetReader, bits: int): ProtoReadResult[seq[byte]] =
  let byteCount = (bits + 7) div 8
  getSlice(r, byteCount)

proc getOption*[G: HasDefault](r: var NetReader,
    parse: proc(r: var NetReader): ProtoReadResult[G] {.closure.}): ProtoReadResult[Option[G]] =
  ## Port of `get_option`. A packet usually writes this inline instead:
  ## `if tryRead(T, getBool(r)): x = some(tryRead(T, getStr(r)))`.
  let present = getBool(r)
  if not present.isOk:
    return readErr[Option[G]](present.error)
  if not present.value:
    return readOk(none[G]())
  let v = parse(r)
  if not v.isOk:
    return readErr[Option[G]](v.error)
  readOk(some(v.value))

type
  ListResult*[G] = object
    isOk*: bool
    error*: ReadingError
    items*: seq[G]

proc getList*[G](r: var NetReader, parse: proc(r: var NetReader): ProtoReadResult[G] {.closure.}): ListResult[G] =
  const maxListSize = 65536
  let lenR = getVarInt(r)
  if not lenR.isOk:
    return ListResult[G](isOk: false, error: lenR.error)
  let len = int(lenR.value.value)
  # Upstream casts to usize, so a negative length is too large as well.
  if len < 0 or len > maxListSize:
    return ListResult[G](isOk: false, error: tooLarge("List length " & $len & " exceeds limit"))
  var list: seq[G] = @[]
  for i in 0 ..< len:
    let v = parse(r)
    if not v.isOk:
      return ListResult[G](isOk: false, error: v.error)
    list.add(v.value)
  ListResult[G](isOk: true, items: list)

# --- writes --------------------------------------------------------------

proc writeSlice*(w: var NetWriter, data: openArray[byte]) =
  for b in data: w.buf.add(b)

proc writeU8*(w: var NetWriter, v: uint8) = w.buf.add(v)
proc writeI8*(w: var NetWriter, v: int8) = w.buf.add(cast[uint8](v))

proc writeBE16(w: var NetWriter, v: uint16) =
  w.buf.add(uint8(v shr 8)); w.buf.add(uint8(v and 0xFF))
proc writeBE32(w: var NetWriter, v: uint32) =
  w.buf.add(uint8(v shr 24)); w.buf.add(uint8((v shr 16) and 0xFF))
  w.buf.add(uint8((v shr 8) and 0xFF)); w.buf.add(uint8(v and 0xFF))
proc writeBE64(w: var NetWriter, v: uint64) =
  var shift = 56
  while shift >= 0:
    w.buf.add(uint8((v shr uint64(shift)) and 0xFF'u64))
    shift -= 8

proc writeI16Be*(w: var NetWriter, v: int16) = writeBE16(w, cast[uint16](v))
proc writeU16Be*(w: var NetWriter, v: uint16) = writeBE16(w, v)
proc writeI32Be*(w: var NetWriter, v: int32) = writeBE32(w, cast[uint32](v))
proc writeU32Be*(w: var NetWriter, v: uint32) = writeBE32(w, v)
proc writeI64Be*(w: var NetWriter, v: int64) = writeBE64(w, cast[uint64](v))
proc writeU64Be*(w: var NetWriter, v: uint64) = writeBE64(w, v)
proc writeF32Be*(w: var NetWriter, v: float32) = writeBE32(w, cast[uint32](v))
proc writeF64Be*(w: var NetWriter, v: float64) = writeBE64(w, cast[uint64](v))

proc writeBool*(w: var NetWriter, v: bool) =
  writeU8(w, if v: 1'u8 else: 0'u8)

# Upstream's default-method aliases.
proc writeI16*(w: var NetWriter, v: int16) {.inline.} = writeI16Be(w, v)
proc writeU16*(w: var NetWriter, v: uint16) {.inline.} = writeU16Be(w, v)
proc writeI32*(w: var NetWriter, v: int32) {.inline.} = writeI32Be(w, v)
proc writeU32*(w: var NetWriter, v: uint32) {.inline.} = writeU32Be(w, v)
proc writeI64*(w: var NetWriter, v: int64) {.inline.} = writeI64Be(w, v)
proc writeU64*(w: var NetWriter, v: uint64) {.inline.} = writeU64Be(w, v)
proc writeF32*(w: var NetWriter, v: float32) {.inline.} = writeF32Be(w, v)
proc writeF64*(w: var NetWriter, v: float64) {.inline.} = writeF64Be(w, v)
proc putI32*(w: var NetWriter, v: int32) {.inline.} = writeI32Be(w, v)
proc putBool*(w: var NetWriter, v: bool) {.inline.} = writeBool(w, v)

proc writeVarInt*(w: var NetWriter, v: VarInt) =
  encodeJava(v, w.buf)

proc putVarInt*(w: var NetWriter, v: VarInt) {.inline.} = writeVarInt(w, v)

proc writeVarUInt*(w: var NetWriter, v: VarUInt) =
  encode(v, w.buf)

proc writeVarLong*(w: var NetWriter, v: VarLong) =
  encodeJava(v, w.buf)

proc writeVarULong*(w: var NetWriter, v: VarULong) =
  encode(v, w.buf)

proc writeStringBounded*(w: var NetWriter, s: string, bound: int): ProtoWriteVoidResult =
  # Upstream compares the byte length here, not UTF-16 units as the read side does.
  if s.len > bound:
    return writeErrVoid(messageWrite("string length " & $s.len & " exceeds bound " & $bound))
  if s.len > int(int32.high):
    return writeErrVoid(messageWrite($s.len & " isn't representable as a VarInt"))
  writeVarInt(w, newVarInt(int32(s.len)))
  for ch in s: writeU8(w, ch.uint8)
  writeOkVoid()

proc writeString*(w: var NetWriter, s: string): ProtoWriteVoidResult =
  writeStringBounded(w, s, int(int16.high))

proc writeBlockPos*(w: var NetWriter, pos: BlockPos) =
  writeI64Be(w, pos.asLong())

proc writeNbt*(w: var NetWriter, data: NbtTag): ProtoWriteVoidResult =
  ## The tag's type id then its payload, in Java (not Bedrock) encoding.
  var nbtWriter = newNbtWriter(nwmJava)
  let res = serialize(data, nbtWriter)
  if not res.isOk:
    return writeErrVoid(messageWrite(res.error.msg))
  writeSlice(w, nbtWriter.buf)
  writeOkVoid()

proc writeOption*[G](w: var NetWriter, data: Option[G],
    writer: proc(w: var NetWriter, item: G): ProtoWriteVoidResult {.closure.}): ProtoWriteVoidResult =
  ## Port of `write_option`. A packet usually writes this inline.
  if data.isSome:
    writeBool(w, true)
    writer(w, data.unsafeGet)
  else:
    writeBool(w, false)
    writeOkVoid()

proc writeList*[G](w: var NetWriter, items: openArray[G], put: proc(w: var NetWriter, item: G) {.closure.}) =
  writeVarInt(w, newVarInt(int32(items.len)))
  for i in 0 ..< items.len:
    put(w, items[i])

proc writeListRes*[G](w: var NetWriter, items: openArray[G],
    put: proc(w: var NetWriter, item: G): ProtoWriteVoidResult {.closure.}): ProtoWriteVoidResult =
  writeVarInt(w, newVarInt(int32(items.len)))
  for i in 0 ..< items.len:
    let r = put(w, items[i])
    if not r.isOk:
      return r
  writeOkVoid()

proc writeUuidPair*(w: var NetWriter, hi, lo: uint64) =
  writeU64Be(w, hi)
  writeU64Be(w, lo)

proc writeFixedBitset*(w: var NetWriter, bits: int, bitSet: seq[byte]) =
  ## Exactly `bits.div_ceil(8)` bytes: `bitSet` truncated or zero-padded to fit.
  let newLength = (bits + 7) div 8
  for i in 0 ..< newLength:
    writeU8(w, if i < bitSet.len: bitSet[i] else: 0'u8)
