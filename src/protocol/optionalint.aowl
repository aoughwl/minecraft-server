## Port of pumpkin-protocol/src/codec/optional_int.rs

import std/options
import netcodec, varint

type
  OptionalInt* = object
    value*: Option[int32]

proc write*(self: OptionalInt; w: var NetWriter) =
  ## None is 0, Some(id) is id + 1.
  let val = if self.value.isSome: self.value.unsafeGet + 1'i32 else: 0'i32
  writeVarInt(w, newVarInt(val))
