## Known-answer test for optionalint.aowl.
import std/assertions
import std/syncio
import std/options
import netcodec, optionalint

var w = newNetWriter()
OptionalInt(value: none[int32]()).write(w)
OptionalInt(value: some(0'i32)).write(w)
OptionalInt(value: some(127'i32)).write(w)
assert w.buf == @[0'u8, 1, 0x80, 0x01]
echo "all optional int checks passed"
