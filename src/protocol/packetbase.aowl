## Port of pumpkin-protocol/src/packet.rs
##
## Rust's `MultiVersionJavaPacket::to_id`, filled in by `#[java_packet(...)]`,
## is one line per Java packet here:
##
##     proc toId*(_: typedesc[CFoo]; v: JavaMinecraftVersion): int32 = CB_PLAY_FOO.toId(v)
##
## and Rust's `Packet::PACKET_ID` one line per Bedrock packet:
##
##     const CFooPacketId* = 11'i32
##
## There is no trait object to dispatch through, and aowlmony generics do not look
## up a proc on their type parameter at instantiation, so nothing here can be
## generic over "any packet". `BClientPacket`/`BServerPacket`'s blanket impls
## forward to `PacketWrite`/`PacketRead`, so a Bedrock packet simply has those
## overloads. This module holds what is left: the one shared step of encoding a
## Java packet. See proto.aowl's header for the full convention.

import netcodec, varint

proc writeJavaPacketId*(w: var NetWriter; id: int32) =
  ## The VarInt id that precedes a Java packet's body:
  ##
  ##     var w = newNetWriter()
  ##     writeJavaPacketId(w, CFoo.toId(v))
  ##     let res = writePacket(p, w, v)
  writeVarInt(w, newVarInt(id))
