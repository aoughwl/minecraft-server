## Port of pumpkin-protocol/src/query.rs
##
## The query protocol (GameSpy4) over UDP: a handshake that hands out a challenge token, then a basic or full status.
## Upstream's `CString` is a plain string here, with the check `CString::new` makes (no zero byte inside) done in
## `encode`, which answers false for one that has a zero byte, as upstream's `None`.

const
  QueryMagic* = 0xFEFD'u16
  PaddingStart = [0x73'u8, 0x70'u8, 0x6C'u8, 0x69'u8, 0x74'u8, 0x6E'u8, 0x75'u8, 0x6D'u8, 0x00'u8, 0x80'u8, 0x00'u8]
  PaddingEnd = [0x00'u8, 0x01'u8, 0x70'u8, 0x6C'u8, 0x61'u8, 0x79'u8, 0x65'u8, 0x72'u8, 0x5F'u8, 0x00'u8, 0x00'u8]

type
  QueryDecodeError* = enum
    qdOk
    qdUnexpectedEof
    qdBadMagic
    qdUnknownPacketType
    qdMalformedPayload

  QueryPacketType* = enum
    qptStatus = 0
    qptHandshake = 9

  RawQueryPacket* = object
    err*: QueryDecodeError
    unknownType*: uint8
    packetType*: QueryPacketType
    bytes*: seq[byte]
    pos*: int

  SQueryHandshake* = object
    sessionId*: int32

  SQueryStatusRequest* = object
    sessionId*: int32
    challengeToken*: int32
    isFullRequest*: bool

  CQueryHandshake* = object
    sessionId*: int32
    challengeToken*: int32

  CQueryBasicStatus* = object
    sessionId*: int32
    motd*: string
    map*: string
    numPlayers*: int
    maxPlayers*: int
    hostPort*: uint16
    hostIp*: string

  CQueryFullStatus* = object
    sessionId*: int32
    hostname*: string
    version*: string
    plugins*: string
    map*: string
    numPlayers*: int
    maxPlayers*: int
    hostPort*: uint16
    hostIp*: string
    players*: seq[string]

proc decodeRawQueryPacket*(bytes: seq[byte]): RawQueryPacket =
  ## `RawQueryPacket::decode`
  result = RawQueryPacket(err: qdOk, unknownType: 0'u8, packetType: qptStatus, bytes: bytes, pos: 0)
  if bytes.len < 2:
    result.err = qdUnexpectedEof
    return
  if ((uint16(bytes[0]) shl 8) or uint16(bytes[1])) != QueryMagic:
    result.err = qdBadMagic
    return
  if bytes.len < 3:
    result.err = qdUnexpectedEof
    return
  case bytes[2]
  of 9'u8:
    result.packetType = qptHandshake
  of 0'u8:
    result.packetType = qptStatus
  else:
    result.err = qdUnknownPacketType
    result.unknownType = bytes[2]
    return
  result.pos = 3

proc readI32(p: var RawQueryPacket; value: var int32): bool =
  if p.pos + 4 > p.bytes.len:
    return false
  value = int32((uint32(p.bytes[p.pos]) shl 24) or (uint32(p.bytes[p.pos + 1]) shl 16) or
    (uint32(p.bytes[p.pos + 2]) shl 8) or uint32(p.bytes[p.pos + 3]))
  p.pos += 4
  true

proc decodeQueryHandshake*(packet: var RawQueryPacket): (QueryDecodeError, SQueryHandshake) =
  ## `SHandshake::decode`
  var id = 0'i32
  if not readI32(packet, id):
    return (qdUnexpectedEof, SQueryHandshake(sessionId: 0'i32))
  (qdOk, SQueryHandshake(sessionId: id))

proc decodeQueryStatusRequest*(packet: var RawQueryPacket): (QueryDecodeError, SQueryStatusRequest) =
  ## `SStatusRequest::decode`: nothing after the token is a basic request, four bytes of padding a full one.
  let bad = SQueryStatusRequest(sessionId: 0'i32, challengeToken: 0'i32, isFullRequest: false)
  var session = 0'i32
  var token = 0'i32
  if not readI32(packet, session) or not readI32(packet, token):
    return (qdUnexpectedEof, bad)
  let remaining = packet.bytes.len - packet.pos
  var full = false
  if remaining == 0:
    full = false
  elif remaining == 4:
    packet.pos += 4
    full = true
  else:
    return (qdMalformedPayload, bad)
  (qdOk, SQueryStatusRequest(sessionId: session, challengeToken: token, isFullRequest: full))

proc putI32(buf: var seq[byte]; v: int32) =
  let u = uint32(v)
  buf.add(byte((u shr 24) and 255'u32))
  buf.add(byte((u shr 16) and 255'u32))
  buf.add(byte((u shr 8) and 255'u32))
  buf.add(byte(u and 255'u32))

proc putCString(buf: var seq[byte]; s: string): bool =
  ## False for a string with a zero byte in it: `CString::new` refuses it.
  for c in s:
    if c == '\0':
      return false
  for c in s:
    buf.add(byte(c))
  buf.add(0'u8)
  true

proc encode*(p: CQueryHandshake): (bool, seq[byte]) =
  var buf: seq[byte] = @[9'u8]
  putI32(buf, p.sessionId)
  discard putCString(buf, $p.challengeToken)
  (true, buf)

proc encode*(p: CQueryBasicStatus): (bool, seq[byte]) =
  var buf: seq[byte] = @[0'u8]
  putI32(buf, p.sessionId)
  var ok = putCString(buf, p.motd)
  ok = putCString(buf, "SMP") and ok
  ok = putCString(buf, p.map) and ok
  ok = putCString(buf, $p.numPlayers) and ok
  ok = putCString(buf, $p.maxPlayers) and ok
  # The port is written little-endian: a known Notchian quirk.
  buf.add(byte(p.hostPort and 255'u16))
  buf.add(byte(p.hostPort shr 8))
  ok = putCString(buf, p.hostIp) and ok
  (ok, buf)

proc encode*(p: CQueryFullStatus): (bool, seq[byte]) =
  var buf: seq[byte] = @[0'u8]
  putI32(buf, p.sessionId)
  for b in PaddingStart:
    buf.add(b)
  var ok = true
  template pair(key, value: string) =
    ok = putCString(buf, key) and ok
    ok = putCString(buf, value) and ok
  pair("hostname", p.hostname)
  pair("gametype", "SMP")
  pair("game_id", "MINECRAFT")
  pair("version", p.version)
  pair("plugins", p.plugins)
  pair("map", p.map)
  pair("numplayers", $p.numPlayers)
  pair("maxplayers", $p.maxPlayers)
  pair("hostport", $p.hostPort)
  pair("hostip", p.hostIp)
  for b in PaddingEnd:
    buf.add(b)
  for player in p.players:
    ok = putCString(buf, player) and ok
  buf.add(0'u8)
  (ok, buf)
