## Test for query.aowl: upstream's own vectors, byte for byte.

import std/[assertions, syncio]
import query

proc fromHex(h: string): seq[byte] =
  result = @[]
  var i = 0
  while i + 1 < h.len:
    var v = 0
    for j in 0 ..< 2:
      let c = h[i + j]
      v = v * 16 + (if c >= 'a': ord(c) - ord('a') + 10 elif c >= 'A': ord(c) - ord('A') + 10 else: ord(c) - ord('0'))
    result.add(byte(v))
    i += 2

proc run() =
  var raw = decodeRawQueryPacket(fromHex("FEFD0900000001"))
  assert raw.err == qdOk and raw.packetType == qptHandshake
  let (e1, hs) = decodeQueryHandshake(raw)
  assert e1 == qdOk and hs.sessionId == 1'i32

  let (ok1, b1) = encode(CQueryHandshake(sessionId: 1'i32, challengeToken: 9513307'i32))
  assert ok1 and b1 == fromHex("09000000013935313333303700")

  var raw2 = decodeRawQueryPacket(fromHex("FEFD00000000010091295B"))
  let (e2, req) = decodeQueryStatusRequest(raw2)
  assert e2 == qdOk and req.sessionId == 1'i32 and req.challengeToken == 9513307'i32 and not req.isFullRequest

  let (ok2, b2) = encode(CQueryBasicStatus(sessionId: 1'i32, motd: "A Minecraft Server", map: "world", numPlayers: 2,
    maxPlayers: 20, hostPort: 25565'u16, hostIp: "127.0.0.1"))
  assert ok2 and b2 == fromHex("000000000141204D696E6563726166742053657276657200534D5000776F726C64003200323000DD633132372E302E302E3100")

  var raw3 = decodeRawQueryPacket(fromHex("FEFD00000000010091295B00000000"))
  let (e3, full) = decodeQueryStatusRequest(raw3)
  assert e3 == qdOk and full.isFullRequest and full.challengeToken == 9513307'i32

  let (ok3, b3) = encode(CQueryFullStatus(sessionId: 1'i32, hostname: "A Minecraft Server", version: "Beta 1.9 Prerelease 4",
    plugins: "", map: "world", numPlayers: 2, maxPlayers: 20, hostPort: 25565'u16, hostIp: "127.0.0.1",
    players: @["barneygale", "Vivalahelvig"]))
  assert ok3 and b3 == fromHex("")

  assert decodeRawQueryPacket(fromHex("dead0900000001")).err == qdBadMagic
  let unknown = decodeRawQueryPacket(fromHex("fefdff"))
  assert unknown.err == qdUnknownPacketType and unknown.unknownType == 0xFF'u8
  assert decodeRawQueryPacket(fromHex("fefd")).err == qdUnexpectedEof
  var short = decodeRawQueryPacket(fromHex("fefd09000000"))
  assert decodeQueryHandshake(short)[0] == qdUnexpectedEof
  var odd = decodeRawQueryPacket(fromHex("fefd00000000010091295b0000"))
  assert decodeQueryStatusRequest(odd)[0] == qdMalformedPayload
  assert not encode(CQueryBasicStatus(sessionId: 1'i32, motd: "a\x00b", map: "w", numPlayers: 0, maxPlayers: 0, hostPort: 1'u16, hostIp: "x"))[0]
  echo "querytest ok"

run()
