## Port of pumpkin-protocol/src/codec/recipe.rs
## PARTIAL: pumpkin-protocol/src/codec/recipe.rs - `matchItem` takes the item's registry key and a tag predicate from the caller, because `Taggable::is_tagged_with` (pumpkin-data tag tables) is not ported.

import std/options
import ../generated/recipes

export recipes.RecipeCategory

type
  OwnedRecipeIngredientKind* = enum
    oriSimple
    oriTagged
    oriOneOf

  OwnedRecipeIngredient* = object
    case kind*: OwnedRecipeIngredientKind
    of oriSimple: id*: string
    of oriTagged: tag*: string
    of oriOneOf: ids*: seq[string]

  OwnedRecipeResult* = object
    itemId*: string
    count*: uint8
    # TODO: Add components/enchantments if needed for the display result

  RecipeKeyEntry* = object
    symbol*: char
    ingredient*: OwnedRecipeIngredient

  OwnedCraftingRecipeKind* = enum
    ocrShaped
    ocrShapeless

  OwnedCraftingRecipe* = object
    category*: RecipeCategory
    group*: Option[string]
    result*: OwnedRecipeResult
    case kind*: OwnedCraftingRecipeKind
    of ocrShaped:
      showNotification*: bool
      key*: seq[RecipeKeyEntry]
      pattern*: seq[string]
    of ocrShapeless:
      ingredients*: seq[OwnedRecipeIngredient]

  OwnedCookingRecipe* = object
    recipeId*: string
    category*: RecipeCategory
    group*: Option[string]
    ingredient*: OwnedRecipeIngredient
    cookingTime*: int32
    experience*: float32
    result*: OwnedRecipeResult

  OwnedCookingRecipeKind* = enum
    ockBlasting
    ockSmelting
    ockSmoking
    ockCampfireCooking

  OwnedCookingRecipeType* = object
    kind*: OwnedCookingRecipeKind
    recipe*: OwnedCookingRecipe

  DynamicRecipeKind* = enum
    drCrafting
    drCooking

  DynamicRecipe* = object
    case kind*: DynamicRecipeKind
    of drCrafting: crafting*: OwnedCraftingRecipe
    of drCooking: cooking*: OwnedCookingRecipeType

proc matchItem*(self: OwnedRecipeIngredient; registryKey: string;
    isTaggedWith: proc(tag: string): bool {.closure.}): bool =
  case self.kind
  of oriSimple:
    "minecraft:" & registryKey == self.id
  of oriTagged:
    isTaggedWith(self.tag)
  of oriOneOf:
    let name = "minecraft:" & registryKey
    for id in self.ids:
      if id == name:
        return true
    false
