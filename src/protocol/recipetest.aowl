## Test for recipe.aowl.
import std/assertions
import std/syncio
import recipe
import ../generated/item

proc isPlanks(tag: string): bool = tag == "minecraft:planks"

let taggedPlanks: proc(tag: string): bool {.closure.} = isPlanks

let simple = OwnedRecipeIngredient(kind: oriSimple, id: "minecraft:stone")
assert simple.matchItem("stone", taggedPlanks)
assert not simple.matchItem("dirt", taggedPlanks)

let tagged = OwnedRecipeIngredient(kind: oriTagged, tag: "minecraft:planks")
assert tagged.matchItem("oak_planks", taggedPlanks)
let otherTag = OwnedRecipeIngredient(kind: oriTagged, tag: "minecraft:logs")
assert not otherTag.matchItem("oak_log", taggedPlanks)

let oneOf = OwnedRecipeIngredient(kind: oriOneOf, ids: @["minecraft:a", "minecraft:b"])
assert oneOf.matchItem("b", taggedPlanks)
assert not oneOf.matchItem("c", taggedPlanks)

let stoneItem = Item(id: 1, name: "stone")
assert simple.matchItem(stoneItem)
assert not simple.matchItem(Item(id: 2, name: "granite"))
assert oneOf.matchItem(Item(id: 3, name: "a"))
assert not oneOf.matchItem(Item(id: 3, name: "z"))

echo "all recipe checks passed"
