## Port of pumpkin-protocol/src/serial/deserializer.rs: upstream's `PacketRead`
## impls, used by Bedrock packets. Numbers are little-endian.
##
## `PacketRead::read` is `packetRead(T, r)` and `read_be` is `packetReadBe(T, r)`.
## Upstream's `PacketReadSlice` impls repeat the same reads over a borrowed
## `&[u8]` for the borrow checker; `NetReader` is already a buffer, so `packetRead`
## is both. Generics take the element reader as an argument, as in serialwrite.aowl.

import std/options
import protobase, netcodec, varint, serialwrite
import ../util/math/position
import ../util/[vector2, vector3]

const MaxStringLength = 32767

proc readLe(r: var NetReader; bytes: int): ProtoReadResult[uint64] =
  let s = tryRead(uint64, readSlice(r, bytes))
  var v = 0'u64
  var shift = 0
  for b in s:
    v = v or (uint64(b) shl shift)
    shift += 8
  readOk(v)

proc packetRead*(_: typedesc[bool]; r: var NetReader): ProtoReadResult[bool] = getBool(r)
proc packetRead*(_: typedesc[int8]; r: var NetReader): ProtoReadResult[int8] = getI8(r)
proc packetRead*(_: typedesc[uint8]; r: var NetReader): ProtoReadResult[uint8] = getU8(r)

proc packetRead*(_: typedesc[int16]; r: var NetReader): ProtoReadResult[int16] =
  readOk(cast[int16](uint16(tryRead(int16, readLe(r, 2)))))

proc packetRead*(_: typedesc[uint16]; r: var NetReader): ProtoReadResult[uint16] =
  readOk(uint16(tryRead(uint16, readLe(r, 2))))

proc packetRead*(_: typedesc[int32]; r: var NetReader): ProtoReadResult[int32] =
  readOk(cast[int32](uint32(tryRead(int32, readLe(r, 4)))))

proc packetRead*(_: typedesc[uint32]; r: var NetReader): ProtoReadResult[uint32] =
  readOk(uint32(tryRead(uint32, readLe(r, 4))))

proc packetRead*(_: typedesc[int64]; r: var NetReader): ProtoReadResult[int64] =
  readOk(cast[int64](tryRead(int64, readLe(r, 8))))

proc packetRead*(_: typedesc[uint64]; r: var NetReader): ProtoReadResult[uint64] =
  readLe(r, 8)

proc packetRead*(_: typedesc[float32]; r: var NetReader): ProtoReadResult[float32] =
  readOk(cast[float32](uint32(tryRead(float32, readLe(r, 4)))))

proc packetRead*(_: typedesc[float64]; r: var NetReader): ProtoReadResult[float64] =
  readOk(cast[float64](tryRead(float64, readLe(r, 8))))

proc packetReadBe*(_: typedesc[int32]; r: var NetReader): ProtoReadResult[int32] = getI32Be(r)
proc packetReadBe*(_: typedesc[uint16]; r: var NetReader): ProtoReadResult[uint16] = getU16Be(r)
proc packetReadBe*(_: typedesc[uint32]; r: var NetReader): ProtoReadResult[uint32] = getU32Be(r)
proc packetReadBe*(_: typedesc[uint64]; r: var NetReader): ProtoReadResult[uint64] = getU64Be(r)

# The `PacketRead` impls in var_int.rs, var_uint.rs, var_long.rs and var_ulong.rs.
proc packetRead*(_: typedesc[VarInt]; r: var NetReader): ProtoReadResult[VarInt] =
  decodeBedrock(r.data, r.pos)

proc packetRead*(_: typedesc[VarUInt]; r: var NetReader): ProtoReadResult[VarUInt] =
  getVarUInt(r)

proc packetRead*(_: typedesc[VarLong]; r: var NetReader): ProtoReadResult[VarLong] =
  decodeBedrock(r.data, r.pos, VarLong)

proc packetRead*(_: typedesc[VarULong]; r: var NetReader): ProtoReadResult[VarULong] =
  getVarULong(r)

proc packetReadSeq*[T](r: var NetReader; count: int;
    parse: proc(r: var NetReader): ProtoReadResult[T] {.closure.}): ProtoReadResult[seq[T]] =
  ## `[T; N]`: exactly `count` items with no length prefix.
  var items: seq[T] = @[]
  for i in 0 ..< count:
    let item = parse(r)
    if not item.isOk:
      return readErr[seq[T]](item.error)
    items.add(item.value)
  readOk(items)

proc packetRead*(_: typedesc[string]; r: var NetReader): ProtoReadResult[string] =
  ## Also `read_str_slice` (serial/mod.rs), which has the same limit.
  let len = int(tryRead(string, packetRead(VarUInt, r)).value)
  if len > MaxStringLength:
    return readErr[string](messageRead("String length " & $len & " exceeds maximum of " & $MaxStringLength))
  let bytes = tryRead(string, readSlice(r, len))
  var str = newString(len)
  for i in 0 ..< len:
    str[i] = char(bytes[i])
  if not isValidUtf8(str):
    return readErr[string](messageRead("Invalid UTF-8 sequence"))
  readOk(str)

proc packetRead*(_: typedesc[seq[byte]]; r: var NetReader): ProtoReadResult[seq[byte]] =
  ## `Vec<u8>`: unlike `Vec<T>`'s write, this one has a VarUInt length prefix.
  let len = int(tryRead(seq[byte], packetRead(VarUInt, r)).value)
  readSlice(r, len)

proc packetRead*(_: typedesc[Vector3[float32]]; r: var NetReader): ProtoReadResult[Vector3[float32]] =
  let x = tryRead(Vector3[float32], packetRead(float32, r))
  let y = tryRead(Vector3[float32], packetRead(float32, r))
  let z = tryRead(Vector3[float32], packetRead(float32, r))
  readOk(Vector3[float32](x: x, y: y, z: z))

proc packetRead*(_: typedesc[Vector3[float64]]; r: var NetReader): ProtoReadResult[Vector3[float64]] =
  let x = tryRead(Vector3[float64], packetRead(float64, r))
  let y = tryRead(Vector3[float64], packetRead(float64, r))
  let z = tryRead(Vector3[float64], packetRead(float64, r))
  readOk(Vector3[float64](x: x, y: y, z: z))

proc packetRead*(_: typedesc[Vector3[int32]]; r: var NetReader): ProtoReadResult[Vector3[int32]] =
  let x = tryRead(Vector3[int32], packetRead(int32, r))
  let y = tryRead(Vector3[int32], packetRead(int32, r))
  let z = tryRead(Vector3[int32], packetRead(int32, r))
  readOk(Vector3[int32](x: x, y: y, z: z))

proc packetRead*(_: typedesc[Vector2[float32]]; r: var NetReader): ProtoReadResult[Vector2[float32]] =
  let x = tryRead(Vector2[float32], packetRead(float32, r))
  let y = tryRead(Vector2[float32], packetRead(float32, r))
  readOk(Vector2[float32](x: x, y: y))

proc packetRead*(_: typedesc[Vector2[int32]]; r: var NetReader): ProtoReadResult[Vector2[int32]] =
  let x = tryRead(Vector2[int32], packetRead(int32, r))
  let y = tryRead(Vector2[int32], packetRead(int32, r))
  readOk(Vector2[int32](x: x, y: y))

proc packetRead*(_: typedesc[BlockPos]; r: var NetReader): ProtoReadResult[BlockPos] =
  let x = tryRead(BlockPos, packetRead(VarInt, r))
  let y = tryRead(BlockPos, packetRead(VarInt, r))
  let z = tryRead(BlockPos, packetRead(VarInt, r))
  readOk(newBlockPos(x.value, y.value, z.value))

proc packetRead*(_: typedesc[SocketAddr]; r: var NetReader): ProtoReadResult[SocketAddr] =
  let version = tryRead(SocketAddr, getU8(r))
  case version
  of 4'u8:
    let ip = tryRead(SocketAddr, readSlice(r, 4))
    let port = tryRead(SocketAddr, packetReadBe(uint16, r))
    readOk(SocketAddr(isV6: false, ip: ip, port: port, flowInfo: 0'u32, scopeId: 0'u32))
  of 6'u8:
    # Addr family
    discard tryRead(SocketAddr, packetRead(uint16, r))
    let port = tryRead(SocketAddr, packetReadBe(uint16, r))
    let flowInfo = tryRead(SocketAddr, packetReadBe(uint32, r))
    let ip = tryRead(SocketAddr, readSlice(r, 16))
    let scopeId = tryRead(SocketAddr, packetReadBe(uint32, r))
    readOk(SocketAddr(isV6: true, ip: ip, port: port, flowInfo: flowInfo, scopeId: scopeId))
  else:
    readErr[SocketAddr](messageRead("Invalid socket address version"))

proc packetReadOption*[T: HasDefault](r: var NetReader;
    parse: proc(r: var NetReader): ProtoReadResult[T] {.closure.}): ProtoReadResult[Option[T]] =
  let present = getBool(r)
  if not present.isOk:
    return readErr[Option[T]](present.error)
  if not present.value:
    return readOk(none[T]())
  let v = parse(r)
  if not v.isOk:
    return readErr[Option[T]](v.error)
  readOk(some(v.value))
