## Port of pumpkin-protocol/src/serial/serializer.rs: upstream's `PacketWrite`
## impls, used by Bedrock packets. Numbers are little-endian, and `VarInt` here
## is the ZigZag shape.
##
## `PacketWrite::write` is `packetWrite(value, w)` and `write_be` is
## `packetWriteBe(value, w)`. The trait's "Not implemented" default for `write_be`
## is simply a missing overload, so a wrong call fails to compile. Writing to the
## buffer cannot fail, so neither returns a result.
##
## aowlmony generics do not look up a proc on their type parameter at
## instantiation, so upstream's `impl<T: PacketWrite> PacketWrite for Vec<T>` and
## friends take the element writer as an argument (`packetWriteSeq`,
## `packetWriteOption`), and `Vector3<T>` has one overload per element type.

import std/options
import netcodec, varint, littleendian, blockpos
import ../util/[gamemode, vector2, vector3]

type
  SocketAddr* = object
    ## Port of `std::net::SocketAddr`'s fields as this wire shape uses them.
    ## `ip` holds 4 octets when not `isV6`, else 16.
    isV6*: bool
    ip*: seq[byte]
    port*: uint16
    flowInfo*: uint32
    scopeId*: uint32

proc packetWrite*(self: bool; w: var NetWriter) = writeU8(w, if self: 1'u8 else: 0'u8)
proc packetWrite*(self: int8; w: var NetWriter) = writeI8(w, self)
proc packetWrite*(self: int16; w: var NetWriter) = write(Le16(value: self), w)
proc packetWrite*(self: int32; w: var NetWriter) = write(Le32(value: self), w)
proc packetWrite*(self: int64; w: var NetWriter) = write(Le64(value: self), w)
proc packetWrite*(self: uint8; w: var NetWriter) = writeU8(w, self)
proc packetWrite*(self: uint16; w: var NetWriter) = write(LeU16(value: self), w)
proc packetWrite*(self: uint32; w: var NetWriter) = write(LeU32(value: self), w)
proc packetWrite*(self: uint64; w: var NetWriter) = write(LeU64(value: self), w)
proc packetWrite*(self: float32; w: var NetWriter) = write(LeU32(value: cast[uint32](self)), w)
proc packetWrite*(self: float64; w: var NetWriter) = write(LeU64(value: cast[uint64](self)), w)

proc packetWriteBe*(self: int32; w: var NetWriter) = writeI32Be(w, self)
proc packetWriteBe*(self: int64; w: var NetWriter) = writeI64Be(w, self)
proc packetWriteBe*(self: uint16; w: var NetWriter) = writeU16Be(w, self)
proc packetWriteBe*(self: uint32; w: var NetWriter) = writeU32Be(w, self)
proc packetWriteBe*(self: uint64; w: var NetWriter) = writeU64Be(w, self)

# The `PacketWrite` impls in var_int.rs, var_uint.rs, var_long.rs and var_ulong.rs.
proc packetWrite*(self: VarInt; w: var NetWriter) = encodeBedrock(self, w.buf)
proc packetWrite*(self: VarUInt; w: var NetWriter) = encode(self, w.buf)
proc packetWrite*(self: VarLong; w: var NetWriter) = encodeBedrock(self, w.buf)
proc packetWrite*(self: VarULong; w: var NetWriter) = encode(self, w.buf)

proc packetWrite*(self: string; w: var NetWriter) =
  packetWrite(newVarUInt(uint32(self.len)), w)
  for ch in self:
    writeU8(w, uint8(ch))

proc packetWriteSeq*[T](items: openArray[T]; w: var NetWriter;
    put: proc(item: T; w: var NetWriter) {.closure.}) =
  ## `[T; N]` and `Vec<T>`: the items with no length prefix.
  for i in 0 ..< items.len:
    put(items[i], w)

proc packetWrite*(self: Vector3[float32]; w: var NetWriter) =
  packetWrite(self.x, w)
  packetWrite(self.y, w)
  packetWrite(self.z, w)

proc packetWrite*(self: Vector3[float64]; w: var NetWriter) =
  packetWrite(self.x, w)
  packetWrite(self.y, w)
  packetWrite(self.z, w)

proc packetWrite*(self: Vector3[int32]; w: var NetWriter) =
  packetWrite(self.x, w)
  packetWrite(self.y, w)
  packetWrite(self.z, w)

proc packetWrite*(self: BlockPos; w: var NetWriter) =
  packetWrite(newVarInt(self.x), w)
  packetWrite(newVarInt(self.y), w)
  packetWrite(newVarInt(self.z), w)

proc packetWriteOption*[T](self: Option[T]; w: var NetWriter;
    put: proc(item: T; w: var NetWriter) {.closure.}) =
  if self.isSome:
    packetWrite(true, w)
    put(self.unsafeGet, w)
  else:
    packetWrite(false, w)

proc packetWrite*(self: SocketAddr; w: var NetWriter) =
  if not self.isV6:
    # version, addr, port
    packetWrite(4'u8, w)
    writeSlice(w, self.ip)
    packetWriteBe(self.port, w)
  else:
    # version, addr_family, port, flow_info, addr, scope_id
    packetWrite(6'u8, w)
    packetWrite(10'u16, w)
    packetWriteBe(self.port, w)
    packetWriteBe(self.flowInfo, w)
    writeSlice(w, self.ip)
    packetWriteBe(self.scopeId, w)

proc packetWrite*(self: GameMode; w: var NetWriter) =
  let id = case self
    of Survival: 0'i32
    of Creative: 1'i32
    of Adventure: 2'i32
    # I have no idea why
    of Spectator: 6'i32
  packetWrite(newVarInt(id), w)
