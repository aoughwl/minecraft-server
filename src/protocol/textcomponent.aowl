## PARTIAL: pumpkin-util/src/text/mod.rs - minimal `TextComponent` for the protocol crate: plain text content only (`text`, `empty`, `get_text`, `encode`). No Translate/EntityNames/Keybind/Custom content, no Style, no extra children. Replace with src/util's when that file is ported.

import ../nbt/[nbtbase, serializer, tag]

type
  Style* = object
    ## PARTIAL: pumpkin-util/src/text/style.rs - no fields yet. Upstream's only
    ## protocol use is `NumberFormat::Styled`, whose write is itself a TODO.

  TextComponent* = object
    textValue*: string

proc text*(plain: string): TextComponent =
  TextComponent(textValue: plain)

proc empty*(): TextComponent =
  TextComponent(textValue: "")

proc getText*(self: TextComponent): string =
  self.textValue

proc encode*(self: TextComponent): seq[byte] =
  ## Unnamed network NBT of the serde form `{"text": ...}`: the compound's type id,
  ## then its content, with no root name.
  var compound = newCompound()
  compound.put("text", NbtTag(kind: ntkString, stringVal: self.textValue))
  var writer = newNbtWriter(nwmJava)
  # Writing to a seq only fails on a string too long for NBT's u16 prefix.
  let res = serialize(NbtTag(kind: ntkCompound, compoundVal: compound), writer)
  if not res.isOk:
    return @[]
  writer.buf
