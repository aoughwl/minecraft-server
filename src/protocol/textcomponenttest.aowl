## Known-answer test for textcomponent.aowl: unnamed network NBT.
import std/assertions
import std/syncio
import textcomponent

let t = text("hi")
assert t.getText() == "hi"
assert t.encode() == @[0x0A'u8, 0x08, 0, 4, 0x74, 0x65, 0x78, 0x74, 0, 2, 0x68, 0x69, 0]
assert empty().getText() == ""
echo "all text component checks passed"
