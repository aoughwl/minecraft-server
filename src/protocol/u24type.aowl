## Port of pumpkin-protocol/src/codec/u24_type.rs

import protobase, netcodec

type
  U24* = object
    value*: uint32

proc packetWrite*(self: U24; w: var NetWriter) =
  ## The low three bytes, little-endian.
  writeU8(w, uint8(self.value and 0xFF'u32))
  writeU8(w, uint8((self.value shr 8) and 0xFF'u32))
  writeU8(w, uint8((self.value shr 16) and 0xFF'u32))

proc packetRead*(_: typedesc[U24]; r: var NetReader): ProtoReadResult[U24] =
  let buf = tryRead(U24, readSlice(r, 3))
  readOk(U24(value: uint32(buf[0]) or (uint32(buf[1]) shl 8) or (uint32(buf[2]) shl 16)))
