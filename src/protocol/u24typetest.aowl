## Known-answer test for u24type.aowl.
import std/assertions
import std/syncio
import protobase, netcodec, u24type

var w = newNetWriter()
packetWrite(U24(value: 0x00ABCDEF'u32), w)
assert w.buf == @[0xEF'u8, 0xCD, 0xAB]
var r = newNetReader(w.buf)
let got = packetRead(U24, r)
assert got.isOk
assert got.value.value == 0x00ABCDEF'u32
var short = newNetReader(@[1'u8, 2])
assert not packetRead(U24, short).isOk
echo "all u24 checks passed"
