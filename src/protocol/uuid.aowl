## UUID wire encoding used by the Minecraft protocol.
## Port of pumpkin-protocol/src/codec/uuid.rs plus the `get_uuid`/`write_uuid`
## halves of ser/mod.rs's NetworkReadExt/NetworkWriteExt.
##
## PacketWrite (`packetWrite`) and PacketRead (`packetRead`) are the same 16
## big-endian bytes as the Java shape, because `Uuid::as_bytes` is big-endian.

import protobase, netcodec

export getUuidPair, writeUuidPair

type
  Uuid* = object
    ## Minimal stand-in for the `uuid` crate's type: its two 64-bit halves.
    hi*: uint64
    lo*: uint64

proc getUuid*(r: var NetReader): ProtoReadResult[Uuid] =
  let hi = tryRead(Uuid, getU64Be(r))
  let lo = tryRead(Uuid, getU64Be(r))
  readOk(Uuid(hi: hi, lo: lo))

proc writeUuid*(w: var NetWriter; data: Uuid) =
  writeUuidPair(w, data.hi, data.lo)

proc packetWrite*(self: Uuid; w: var NetWriter) =
  writeUuid(w, self)

proc packetRead*(_: typedesc[Uuid]; r: var NetReader): ProtoReadResult[Uuid] =
  getUuid(r)
