## Known-answer test for uuid.aowl: 16 big-endian bytes both ways.
import std/assertions
import std/syncio
import protobase, netcodec, uuid

let u = Uuid(hi: 0x0011223344556677'u64, lo: 0x8899AABBCCDDEEFF'u64)
let expected = @[0x00'u8, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
  0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF]
var w = newNetWriter()
writeUuid(w, u)
assert w.buf == expected
var w2 = newNetWriter()
packetWrite(u, w2)
assert w2.buf == expected
var r = newNetReader(w.buf)
let got = getUuid(r)
assert got.isOk
assert got.value.hi == u.hi and got.value.lo == u.lo
var short = newNetReader(@[1'u8])
assert not getUuid(short).isOk
echo "all uuid checks passed"
