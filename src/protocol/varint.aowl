## Variable-length integer codecs used by the Minecraft network protocol.
## Port of pumpkin-protocol/src/codec/var_int.rs, pumpkin-protocol/src/codec/var_uint.rs,
## pumpkin-protocol/src/codec/var_long.rs and pumpkin-protocol/src/codec/var_ulong.rs.
##
## Two distinct wire shapes coexist here, matching upstream exactly (and
## matching the same Java-vs-Bedrock split already established in
## src/nbt/serializer.aowl / deserializer.aowl):
## - `encodeJava`/`decodeJava` (upstream `encode`/`decode`, Java Edition): plain
##   LEB128 of the value's bit pattern, no ZigZag.
## - `encodeBedrock`/`decodeBedrock` (upstream's `PacketWrite`/`PacketRead` impl):
##   LEB128 of the ZigZag-encoded value.
## `VarUInt`/`VarULong` only have the plain-LEB128 shape.
##
## Reader/writer here are the same "operate on an owned seq[byte] with a
## position cursor" shape as src/nbt/deserializer.aowl's `NbtReader`, rather
## than reproducing Rust's generic `Read`/`Write`/`AsyncRead` split. The async
## variants are one implementation here: a decode that hits the end of the
## buffer on its first byte reports `reCleanEof` as `decode_async` does, and on
## a later byte `reIncomplete`.
##
## Deliberate differences from the pinned tree, each taken from the newer
## `../ref/pumpkin` checkout because the pinned code is wrong or has a TODO:
## - `decodeJava`/`decodeBedrock`/`decode` reject a fifth byte with payload bits
##   above bit 31 (the pinned `// TODO: Validate`).
## - `decodeBedrock` for VarInt undoes ZigZag properly. The pinned
##   `(val >> 1) ^ (val << 31)` decodes every negative value wrongly.
## And one found here: `writtenSizeVarULong` measures 64 bits. The pinned
## `31 - leading_zeros` underflows for any value below 2^32.

import protobase

const MaxVarIntSize* = 5
const MaxVarLongSize* = 10

type
  VarInt* = object
    value*: int32

  VarUInt* = object
    value*: uint32

  VarLong* = object
    value*: int64

  VarULong* = object
    value*: uint64

proc newVarInt*(value: int32): VarInt {.inline.} = VarInt(value: value)
proc newVarUInt*(value: uint32): VarUInt {.inline.} = VarUInt(value: value)
proc newVarLong*(value: int64): VarLong {.inline.} = VarLong(value: value)
proc newVarULong*(value: uint64): VarULong {.inline.} = VarULong(value: value)

proc leadingZeros32(n: uint32): int =
  if n == 0:
    return 32
  var m = n
  result = 0
  var mask = 0x80000000'u32
  while (m and mask) == 0:
    inc result
    mask = mask shr 1

proc eofAt(i: int; what: string): ReadingError =
  if i == 0: cleanEof(what) else: incompleteRead("EOF inside " & what)

proc writtenSizeVarInt*(v: VarInt): int =
  let n = cast[uint32](v.value)
  if n == 0: 1
  else: (31 - leadingZeros32(n)) div 7 + 1

proc writtenSizeVarUInt*(v: VarUInt): int =
  if v.value == 0: 1
  else: (31 - leadingZeros32(v.value)) div 7 + 1

proc writtenSizeVarULong*(v: VarULong): int =
  var n = v.value
  result = 1
  while n > 0x7F'u64:
    n = n shr 7
    inc result

# --- Java: plain LEB128 (VarInt.encode/decode) ------------------------------

proc encodeJava*(v: VarInt, buf: var seq[byte]) =
  var val = cast[uint32](v.value)
  while val > 0x7F'u32:
    buf.add(uint8(val) or 0x80'u8)
    val = val shr 7
  buf.add(uint8(val))

proc decodeJava*(data: seq[byte], pos: var int): ProtoReadResult[VarInt] =
  var val: int32 = 0
  var i = 0
  while i < MaxVarIntSize:
    if pos >= data.len:
      return readErr[VarInt](eofAt(i, "VarInt"))
    let b = data[pos]
    inc pos
    if i == MaxVarIntSize - 1 and (b and 0x70'u8) != 0:
      return readErr[VarInt](tooLarge("VarInt"))
    val = val or ((int32(b) and 0x7F'i32) shl (i * 7))
    if (b and 0x80'u8) == 0:
      return readOk[VarInt](VarInt(value: val))
    inc i
  readErr[VarInt](tooLarge("VarInt"))

# --- Bedrock: ZigZag LEB128 (VarInt's PacketWrite/PacketRead impl) ---------

proc encodeBedrock*(v: VarInt, buf: var seq[byte]) =
  var val = (cast[uint32](v.value) shl 1) xor cast[uint32](v.value shr 31)
  while val > 0x7F'u32:
    buf.add(uint8(val and 0x7F'u32) or 0x80'u8)
    val = val shr 7
  buf.add(uint8(val))

proc decodeBedrock*(data: seq[byte], pos: var int): ProtoReadResult[VarInt] =
  var val: uint32 = 0
  var i = 0
  while i < MaxVarIntSize:
    if pos >= data.len:
      return readErr[VarInt](eofAt(i, "VarInt"))
    let b = data[pos]
    inc pos
    if i == MaxVarIntSize - 1 and (b and 0x70'u8) != 0:
      return readErr[VarInt](tooLarge("VarInt"))
    val = val or ((uint32(b) and 0x7F'u32) shl (i * 7))
    if (b and 0x80'u8) == 0:
      let signed = cast[int32]((val shr 1)) xor (-cast[int32](val and 1'u32))
      return readOk[VarInt](VarInt(value: signed))
    inc i
  readErr[VarInt](tooLarge("VarInt"))

# --- VarUInt: plain LEB128 only ---------------------------------------------

proc encode*(v: VarUInt, buf: var seq[byte]) =
  var val = v.value
  while true:
    var b = uint8(val and 0x7F'u32)
    val = val shr 7
    if val != 0:
      b = b or 0x80'u8
    buf.add(b)
    if val == 0:
      break

proc decode*(data: seq[byte], pos: var int, _: typedesc[VarUInt]): ProtoReadResult[VarUInt] =
  var val: uint32 = 0
  var i = 0
  while i < MaxVarIntSize:
    if pos >= data.len:
      return readErr[VarUInt](eofAt(i, "VarUInt"))
    let b = data[pos]
    inc pos
    if i == MaxVarIntSize - 1 and (b and 0x70'u8) != 0:
      return readErr[VarUInt](tooLarge("VarUInt"))
    val = val or ((uint32(b) and 0x7F'u32) shl (i * 7))
    if (b and 0x80'u8) == 0:
      return readOk[VarUInt](VarUInt(value: val))
    inc i
  readErr[VarUInt](tooLarge("VarUInt"))

# --- VarLong: same two shapes as VarInt, 64-bit, up to 10 bytes ------------

proc encodeJava*(v: VarLong, buf: var seq[byte]) =
  var val = cast[uint64](v.value)
  while val > 0x7F'u64:
    buf.add(uint8(val) or 0x80'u8)
    val = val shr 7
  buf.add(uint8(val))

proc decodeJava*(data: seq[byte], pos: var int, _: typedesc[VarLong]): ProtoReadResult[VarLong] =
  var val: int64 = 0
  var i = 0
  while i < MaxVarLongSize:
    if pos >= data.len:
      return readErr[VarLong](eofAt(i, "VarLong"))
    let b = data[pos]
    inc pos
    val = val or ((int64(b) and 0x7F'i64) shl (i * 7))
    if (b and 0x80'u8) == 0:
      return readOk[VarLong](VarLong(value: val))
    inc i
  readErr[VarLong](tooLarge("VarLong"))

proc encodeBedrock*(v: VarLong, buf: var seq[byte]) =
  var val = cast[uint64]((v.value shl 1) xor (v.value shr 63))
  while val > 0x7F'u64:
    buf.add(uint8(val and 0x7F'u64) or 0x80'u8)
    val = val shr 7
  buf.add(uint8(val))

proc decodeBedrock*(data: seq[byte], pos: var int, _: typedesc[VarLong]): ProtoReadResult[VarLong] =
  var val: uint64 = 0
  var shift = 0
  while true:
    if pos >= data.len:
      return readErr[VarLong](eofAt(shift, "VarLong"))
    let b = data[pos]
    inc pos
    val = val or (uint64(b and 0x7F'u8) shl shift)
    if (b and 0x80'u8) == 0:
      break
    shift += 7
    if shift >= 64:
      return readErr[VarLong](messageRead("VarLong is too big (overflow)"))
  let decoded = cast[int64](val shr 1) xor (-cast[int64](val and 1'u64))
  readOk[VarLong](VarLong(value: decoded))

proc encode*(v: VarULong, buf: var seq[byte]) =
  var val = v.value
  while true:
    var b = uint8(val and 0x7F'u64)
    val = val shr 7
    if val != 0:
      b = b or 0x80'u8
    buf.add(b)
    if val == 0:
      break

proc decode*(data: seq[byte], pos: var int, _: typedesc[VarULong]): ProtoReadResult[VarULong] =
  var val: uint64 = 0
  var i = 0
  while i < MaxVarLongSize:
    if pos >= data.len:
      return readErr[VarULong](eofAt(i, "VarULong"))
    let b = data[pos]
    inc pos
    val = val or ((uint64(b) and 0x7F'u64) shl (i * 7))
    if (b and 0x80'u8) == 0:
      return readOk[VarULong](VarULong(value: val))
    inc i
  readErr[VarULong](tooLarge("VarULong"))
