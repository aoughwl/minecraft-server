proc playSoundFine*[V, P](w: BlockWorld; sound: Sound; category: SoundCategory; position: Vector3[float64]; volume: V; pitch: P) =
  let f = w.playSound0
  if f != nil: f(sound, category, position, float32(volume), float32(pitch))
proc playSound*(w: BlockWorld; sound: Sound; category: SoundCategory; position: Vector3[float64]) =
  w.playSoundFine(sound, category, position, 1.0'f32, 1.0'f32)
proc playSoundRaw*[V, P](w: BlockWorld; sound: uint16; category: SoundCategory; position: Vector3[float64]; volume: V; pitch: P) =
  let f = w.playSound0
  if f != nil: f(Sound(sound), category, position, float32(volume), float32(pitch))
proc playBlockSoundExpect*(w: BlockWorld; player: BlockActor; sound: Sound; category: SoundCategory; position: BlockPos) =
  ## `play_block_sound_expect`: everybody but the player, whose client has played it.
  let f = w.playSoundExcept0
  if f != nil: f(player.entityId, sound, category, position.toCenteredF64(), 1.0'f32, 1.0'f32)
proc gamemode*(p: BlockPlayer): GameMode =
  let f = p.gamemode0
  if f != nil: f() else: GameMode.Survival
proc playBlockSound*(w: BlockWorld; sound: Sound; category: SoundCategory; position: BlockPos) =
  w.playSoundFine(sound, category, position.toCenteredF64(), 1.0'f32, 1.0'f32)
proc addSyncedBlockEvent*(w: BlockWorld; position: BlockPos; kind, data: uint8) =
  let f = w.addSyncedBlockEvent0
  if f != nil: f(position, kind, data)
proc dropStack*(w: BlockWorld; position: BlockPos; stack: ItemStack) =
  let f = w.dropStack0
