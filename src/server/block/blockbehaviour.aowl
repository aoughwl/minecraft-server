  CanUpdateAtArgs* = object
    world*: BlockWorld
    block0*: Block
    stateId*: BlockStateId
    position*: BlockPos
    direction*: BlockDirection
    player*: BlockPlayer
    useItemOn*: SUseItemOn

  PlacedArgs* = object
    world*: BlockWorld
    block0*: Block
    stateId*: BlockStateId
    oldStateId*: BlockStateId
    position*: BlockPos
    notify*: bool

  PlayerPlacedArgs* = object
    world*: BlockWorld
    block0*: Block
    stateId*: BlockStateId
    position*: BlockPos
    direction*: BlockDirection
