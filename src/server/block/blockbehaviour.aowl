proc scheduleBlockTick*[D](w: BlockWorld; blockRef: Block; position: BlockPos; delay: D; priority: TickPriority = tpNormal) =
  let f = w.scheduleBlockTick0
  f(blockRef, position, uint8(delay), priority)
proc scheduleFluidTick*[D](w: BlockWorld; fluid: Fluid; position: BlockPos; delay: D; priority: TickPriority = tpNormal) =
  let f = w.scheduleFluidTick0
  f(fluid, position, uint8(delay), priority)
proc isBlockTickScheduled*(w: BlockWorld; position: BlockPos; blockRef: Block): bool =
  let f = w.isBlockTickScheduled0
  f(position, blockRef)
proc isFluidTickScheduled*(w: BlockWorld; position: BlockPos; fluid: Fluid): bool =
  let f = w.isFluidTickScheduled0
  f(position, fluid)
proc syncWorldEvent*(w: BlockWorld; event: WorldEvent; position: BlockPos; data: int32) =
