  GetStateForNeighborUpdateArgs* = object
    world*: BlockWorld
    block0*: Block
    stateId*: BlockStateId
    position*: BlockPos
    direction*: BlockDirection
    neighborPosition*: BlockPos
    neighborStateId*: BlockStateId

  OnScheduledTickArgs* = object
    world*: BlockWorld
    block0*: Block
    position*: BlockPos

  OnStateReplacedArgs* = object
    world*: BlockWorld
    block0*: Block
    oldStateId*: BlockStateId
    position*: BlockPos
    moved*: bool

  EmitsRedstonePowerArgs* = object
    block0*: Block
    state*: BlockState
    direction*: BlockDirection

  GetRedstonePowerArgs* = object
    world*: BlockWorld
    block0*: Block
    state*: BlockState
    position*: BlockPos
    direction*: BlockDirection

  GetComparatorOutputArgs* = object
    world*: BlockWorld
    block0*: Block
    state*: BlockState
    position*: BlockPos

  GetInsideCollisionShapeArgs* = object
    world*: BlockWorld
    block0*: Block
    state*: BlockState
    position*: BlockPos

  BlockBehaviour* = ref object
    ## `trait BlockBehaviour`.
    normalUseImpl*: proc(args: NormalUseArgs): BlockActionResult {.closure.}
    useWithItemImpl*: proc(args: UseWithItemArgs): BlockActionResult {.closure.}
    onEntityCollisionImpl*: proc(args: OnEntityCollisionArgs) {.closure.}
    onEntityStepImpl*: proc(args: OnEntityStepArgs) {.closure.}
    shouldDropItemsOnExplosionImpl*: proc(): bool {.closure.}
    explodeImpl*: proc(args: ExplodeArgs) {.closure.}
    onSyncedBlockEventImpl*: proc(args: OnSyncedBlockEventArgs): bool {.closure.}
    onPlaceImpl*: proc(args: OnPlaceArgs): BlockStateId {.closure.}
    randomTickImpl*: proc(args: RandomTickArgs) {.closure.}
    canPlaceAtImpl*: proc(args: CanPlaceAtArgs): bool {.closure.}
    canUpdateAtImpl*: proc(args: CanUpdateAtArgs): bool {.closure.}
    placedImpl*: proc(args: PlacedArgs) {.closure.}
    playerPlacedImpl*: proc(args: PlayerPlacedArgs) {.closure.}
    onLandedUponImpl*: proc(args: OnLandedUponArgs) {.closure.}
    updateEntityMovementAfterFallOnImpl*: proc(args: UpdateEntityMovementAfterFallOnArgs) {.closure.}
    brokenImpl*: proc(args: BrokenArgs) {.closure.}
    onNeighborUpdateImpl*: proc(args: OnNeighborUpdateArgs) {.closure.}
    prepareImpl*: proc(args: PrepareArgs) {.closure.}
    getStateForNeighborUpdateImpl*: proc(args: GetStateForNeighborUpdateArgs): BlockStateId {.closure.}
    onScheduledTickImpl*: proc(args: OnScheduledTickArgs) {.closure.}
    onStateReplacedImpl*: proc(args: OnStateReplacedArgs) {.closure.}
    emitsRedstonePowerImpl*: proc(args: EmitsRedstonePowerArgs): bool {.closure.}
    getWeakRedstonePowerImpl*: proc(args: GetRedstonePowerArgs): uint8 {.closure.}
    getStrongRedstonePowerImpl*: proc(args: GetRedstonePowerArgs): uint8 {.closure.}
    getComparatorOutputImpl*: proc(args: GetComparatorOutputArgs): Option[uint8] {.closure.}
    getInsideCollisionShapeImpl*: proc(args: GetInsideCollisionShapeArgs): BoundingBox {.closure.}
    mirrorImpl*: proc(blockRef: Block; stateId: BlockStateId; mirror: Mirror): BlockState {.closure.}
    rotateImpl*: proc(blockRef: Block; stateId: BlockStateId; rotation: Rotation): BlockState {.closure.}

  FluidBehaviour* = ref object
    ## `trait FluidBehaviour` in fluid/mod.rs.
    normalUseImpl*: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; player: BlockPlayer): BlockActionResult {.closure.}
    useWithItemImpl*: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; player: BlockPlayer; item: ItemStackRef): BlockActionResult {.closure.}
    placedImpl*: proc(world: BlockWorld; fluid: Fluid; stateId: BlockStateId; position: BlockPos; oldStateId: BlockStateId; notify: bool) {.closure.}
    onPlaceImpl*: proc(world: BlockWorld; fluid: Fluid; player: BlockPlayer; position: BlockPos; replacing: BlockIsReplacing; useItemOn: SUseItemOn): BlockStateId {.closure.}
    getStateForNeighbourUpdateImpl*: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; notify: bool): BlockStateId {.closure.}
    onNeighborUpdateImpl*: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; notify: bool) {.closure.}
    onEntityCollisionImpl*: proc(entity: BlockActor) {.closure.}
    onScheduledTickImpl*: proc(world: BlockWorld; fluid: Fluid; position: BlockPos) {.closure.}
    randomTickImpl*: proc(fluid: Fluid; world: BlockWorld; position: BlockPos) {.closure.}
    createLegacyBlockImpl*: proc(world: BlockWorld; position: BlockPos) {.closure.}

  BlockRegistry* = ref object
    ## `BlockRegistry`: keyed by block id and fluid id.
    blocks*: Table[uint16, BlockBehaviour]
    fluids*: Table[uint16, FluidBehaviour]
    unknown*: seq[string]  ## Names and tags registered that the pinned data does not have. A test asserts it is empty.

# --- BlockIsReplacing --------------------------------------------------------------------------------------------

proc `==`*(a, b: BlockIsReplacing): bool =
  ## `#[derive(PartialEq)]`
  if a.kind != b.kind:
    return false
  case a.kind
  of BlockIsReplacingKind.kItself: a.f0Itself == b.f0Itself
  of BlockIsReplacingKind.kWater: a.f0Water == b.f0Water
  else: true

proc waterSource*(self: BlockIsReplacing): bool =
  ## Whether the block was a water source block. Level 0 means the water is a source block.
  self.kind == BlockIsReplacingKind.kWater and self.f0Water == 0'u8

# --- The trait's default bodies --------------------------------------------------------------------------------

proc pos*(e: BlockActor): Vector3[float64] =
  let f = e.block0Pos
  f()
proc velocity*(e: BlockActor): Vector3[float64] =
  let f = e.getVelocity0
  f()
proc `velocity=`*(e: BlockActor; v: Vector3[float64]) =
  let f = e.setVelocity0
  f(v)
proc boundingBox*(e: BlockActor): BoundingBox =
  let f = e.getBox0
  f()
proc isSneaking*(e: BlockActor): bool =
  let f = e.sneaking0
  f()
proc getEntity*(e: BlockActor): BlockActor {.inline.} = e
proc getLivingEntity*(e: BlockActor): Option[BlockActor] =
  if e.isLiving: some(e) else: none[BlockActor]()
proc getPlayer*(e: BlockActor): Option[BlockPlayer] =
  if e.player0 != nil: some(BlockPlayer(e.player0)) else: none[BlockPlayer]()

proc stopVerticalMovementAfterFall*(entity: BlockActor) =
  let e = entity.getEntity()
  var velocity = e.velocity
  velocity.y = 0.0
  e.velocity = velocity

proc bounceEntityAfterFall*(entity: BlockActor; bounceMultiplier: float64) =
  let baseEntity = entity.getEntity()
  var velocity = baseEntity.velocity
  if baseEntity.isSneaking():
    velocity.y = 0.0
  elif velocity.y < 0.0:
    let entityFactor = if entity.getLivingEntity().isSome: 1.0 else: 0.8
    velocity.y = -velocity.y * bounceMultiplier * entityFactor
  baseEntity.velocity = velocity

proc handleFallDamage*(living: BlockActor; caller: BlockActor; fallDistance: float32; damageMultiplier: float32) =
  let f = living.handleFallDamage0
  if f != nil:
    f(fallDistance, damageMultiplier)

proc defNormalUse(args: NormalUseArgs): BlockActionResult = barPass
proc defUseWithItem(args: UseWithItemArgs): BlockActionResult = barPassToDefaultBlockAction
proc defOnEntityCollision(args: OnEntityCollisionArgs) = discard
proc defOnEntityStep(args: OnEntityStepArgs) = discard
proc defShouldDrop(): bool = true
proc defExplode(args: ExplodeArgs) = discard
proc defSynced(args: OnSyncedBlockEventArgs): bool = false
proc defOnPlace(args: OnPlaceArgs): BlockStateId = args.block0.defaultState.id
proc defRandomTick(args: RandomTickArgs) = discard
proc defCanPlaceAt(args: CanPlaceAtArgs): bool = true
proc defCanUpdateAt(args: CanUpdateAtArgs): bool = false
proc defPlaced(args: PlacedArgs) = discard
proc defPlayerPlaced(args: PlayerPlacedArgs) = discard
proc defOnLandedUpon(args: OnLandedUponArgs) =
  let living = args.entity.getLivingEntity()
  if living.isSome:
    handleFallDamage(living.unsafeGet, args.entity, args.fallDistance, 1.0'f32)
proc defUpdateAfterFall(args: UpdateEntityMovementAfterFallOnArgs) = stopVerticalMovementAfterFall(args.entity)
proc defBroken(args: BrokenArgs) = discard
proc defNeighbor(args: OnNeighborUpdateArgs) = discard
proc defPrepare(args: PrepareArgs) = discard
proc defStateForNeighbor(args: GetStateForNeighborUpdateArgs): BlockStateId = args.stateId
proc defScheduled(args: OnScheduledTickArgs) = discard
proc defReplaced(args: OnStateReplacedArgs) = discard
proc defEmits(args: EmitsRedstonePowerArgs): bool = false
proc defPower(args: GetRedstonePowerArgs): uint8 = 0'u8
proc defComparator(args: GetComparatorOutputArgs): Option[uint8] = none[uint8]()
proc defInside(args: GetInsideCollisionShapeArgs): BoundingBox = BoundingBox.fullBlock()
proc defMirror(blockRef: Block; stateId: BlockStateId; mirror: Mirror): BlockState = blockRef.mirror(stateId, mirror)
proc defRotate(blockRef: Block; stateId: BlockStateId; rotation: Rotation): BlockState = blockRef.rotate(stateId, rotation)

proc newBlockBehaviour*(): BlockBehaviour =
  ## Every method at the trait's default, `impl BlockBehaviour for X {}`.
  BlockBehaviour(normalUseImpl: defNormalUse, useWithItemImpl: defUseWithItem, onEntityCollisionImpl: defOnEntityCollision,
    onEntityStepImpl: defOnEntityStep, shouldDropItemsOnExplosionImpl: defShouldDrop, explodeImpl: defExplode,
    onSyncedBlockEventImpl: defSynced, onPlaceImpl: defOnPlace, randomTickImpl: defRandomTick, canPlaceAtImpl: defCanPlaceAt,
    canUpdateAtImpl: defCanUpdateAt, placedImpl: defPlaced, playerPlacedImpl: defPlayerPlaced, onLandedUponImpl: defOnLandedUpon,
    updateEntityMovementAfterFallOnImpl: defUpdateAfterFall, brokenImpl: defBroken, onNeighborUpdateImpl: defNeighbor,
    prepareImpl: defPrepare, getStateForNeighborUpdateImpl: defStateForNeighbor, onScheduledTickImpl: defScheduled,
    onStateReplacedImpl: defReplaced, emitsRedstonePowerImpl: defEmits, getWeakRedstonePowerImpl: defPower,
    getStrongRedstonePowerImpl: defPower, getComparatorOutputImpl: defComparator, getInsideCollisionShapeImpl: defInside,
    mirrorImpl: defMirror, rotateImpl: defRotate)

proc newFluidBehaviour*(): FluidBehaviour =
  ## Every method at the trait's default, `impl FluidBehaviour for X {}`.
  FluidBehaviour(
    normalUseImpl: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; player: BlockPlayer): BlockActionResult {.closure.} = barPass,
    useWithItemImpl: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; player: BlockPlayer; item: ItemStackRef): BlockActionResult {.closure.} = barPass,
    placedImpl: proc(world: BlockWorld; fluid: Fluid; stateId: BlockStateId; position: BlockPos; oldStateId: BlockStateId; notify: bool) {.closure.} = discard,
    onPlaceImpl: proc(world: BlockWorld; fluid: Fluid; player: BlockPlayer; position: BlockPos; replacing: BlockIsReplacing; useItemOn: SUseItemOn): BlockStateId {.closure.} =
      fluid.states[int(fluid.defaultStateIndex)].blockStateId,
    getStateForNeighbourUpdateImpl: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; notify: bool): BlockStateId {.closure.} = blockStateIdAir,
    onNeighborUpdateImpl: proc(world: BlockWorld; fluid: Fluid; position: BlockPos; notify: bool) {.closure.} = discard,
    onEntityCollisionImpl: proc(entity: BlockActor) {.closure.} = discard,
    onScheduledTickImpl: proc(world: BlockWorld; fluid: Fluid; position: BlockPos) {.closure.} = discard,
    randomTickImpl: proc(fluid: Fluid; world: BlockWorld; position: BlockPos) {.closure.} = discard,
    createLegacyBlockImpl: proc(world: BlockWorld; position: BlockPos) {.closure.} = discard)

proc newBlockRegistry*(): BlockRegistry =
  BlockRegistry(blocks: initTable[uint16, BlockBehaviour](), fluids: initTable[uint16, FluidBehaviour]())

proc register*(r: BlockRegistry; name: string; behaviour: BlockBehaviour) =
  ## `#[pumpkin_block("minecraft:x")]`
  let b = Block.fromName(name)
  if b != nil:
    r.blocks[asU16(b.id)] = behaviour
  else:
    r.unknown.add(name)

proc registerTag*(r: BlockRegistry; tagName: string; behaviour: BlockBehaviour) =
  ## `#[pumpkin_block_from_tag("minecraft:x")]`
  let (found, ids) = getTagIds(rkBlock, tagName)
  if found:
    for id in ids:
      r.blocks[id] = behaviour
  else:
    r.unknown.add(tagName)

proc registerIds*(r: BlockRegistry; ids: seq[BlockId]; behaviour: BlockBehaviour) =
  ## `manager.register` of a block with a hand-written `BlockMetadata`.
  for id in ids:
    r.blocks[asU16(id)] = behaviour

proc registerFluidIds*(r: BlockRegistry; ids: seq[uint16]; behaviour: FluidBehaviour) =
  for id in ids:
    r.fluids[id] = behaviour

proc behaviourOf*(r: BlockRegistry; id: BlockId): nil BlockBehaviour =
  r.blocks.getOrDefault(asU16(id), nil)

proc fluidBehaviourOf*(r: BlockRegistry; id: uint16): nil FluidBehaviour =
  r.fluids.getOrDefault(id, nil)

proc getPumpkinBlock*(r: BlockRegistry; id: BlockId): Option[BlockBehaviour] =
  ## `get_pumpkin_block`
  let b = r.behaviourOf(id)
  if b != nil: some(BlockBehaviour(b)) else: none[BlockBehaviour]()

proc getPumpkinFluid*(r: BlockRegistry; id: uint16): Option[FluidBehaviour] =
  ## `get_pumpkin_fluid`
  let b = r.fluidBehaviourOf(id)
  if b != nil: some(FluidBehaviour(b)) else: none[FluidBehaviour]()

# --- World: reads --------------------------------------------------------------------------------------------

proc getBlockStateId*(w: BlockWorld; position: BlockPos): BlockStateId =
  let f = w.getRaw
  f(position)
proc getBlockState*(w: BlockWorld; position: BlockPos): BlockState = BlockState.fromId(w.getBlockStateId(position))
proc getBlock*(w: BlockWorld; position: BlockPos): Block = Block.fromStateId(w.getBlockStateId(position))
proc getBlockAndState*(w: BlockWorld; position: BlockPos): (Block, BlockState) =
  let id = w.getBlockStateId(position)
  (Block.fromStateId(id), BlockState.fromId(id))
proc getBlockAndStateId*(w: BlockWorld; position: BlockPos): (Block, BlockStateId) =
  let id = w.getBlockStateId(position)
  (Block.fromStateId(id), id)
proc fluidOf(id: BlockStateId): Fluid =
  ## `Fluid::from_state_id(..).unwrap_or(&Fluid::EMPTY)`
  let f = Fluid.fromStateId(id)
  if f.isSome: f.unsafeGet else: Fluid.EMPTY
proc getFluid*(w: BlockWorld; position: BlockPos): Fluid = fluidOf(w.getBlockStateId(position))
proc getBlockAndFluid*(w: BlockWorld; position: BlockPos): (Block, Fluid) =
  let id = w.getBlockStateId(position)
  (Block.fromStateId(id), fluidOf(id))
proc isLoaded*(w: BlockWorld; position: BlockPos): bool =
  let f = w.isLoaded0
  f(position)
proc getBlockStateIfLoaded*(w: BlockWorld; position: BlockPos): Option[BlockState] =
  if w.isLoaded(position): some(w.getBlockState(position)) else: none[BlockState]()
proc getBottomY*(w: BlockWorld): int32 {.inline.} = w.minY
proc getTopY*(w: BlockWorld): int32 {.inline.} = w.topY

# --- The registry's dispatch -------------------------------------------------------------------------------

proc onNeighborUpdate*(r: BlockRegistry; world: BlockWorld; blockRef: Block; position: BlockPos; sourceBlock: Block; notify: bool) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.onNeighborUpdateImpl
    f(OnNeighborUpdateArgs(world: world, block0: blockRef, position: position, sourceBlock: sourceBlock, notify: notify))

proc getStateForNeighborUpdate*(r: BlockRegistry; world: BlockWorld; blockRef: Block; stateId: BlockStateId; position: BlockPos;
    direction: BlockDirection; neighborLocation: BlockPos; neighborStateId: BlockStateId): BlockStateId =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.getStateForNeighborUpdateImpl
    return f(GetStateForNeighborUpdateArgs(world: world, block0: blockRef, stateId: stateId, position: position,
      direction: direction, neighborPosition: neighborLocation, neighborStateId: neighborStateId))
  stateId

proc emitsRedstonePower*(r: BlockRegistry; blockRef: Block; state: BlockState; direction: BlockDirection): bool =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.emitsRedstonePowerImpl
    return f(EmitsRedstonePowerArgs(block0: blockRef, state: state, direction: direction))
  false

proc getWeakRedstonePower*(r: BlockRegistry; blockRef: Block; world: BlockWorld; position: BlockPos; state: BlockState; direction: BlockDirection): uint8 =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.getWeakRedstonePowerImpl
    return f(GetRedstonePowerArgs(world: world, block0: blockRef, state: state, position: position, direction: direction))
  0'u8

proc getStrongRedstonePower*(r: BlockRegistry; blockRef: Block; world: BlockWorld; position: BlockPos; state: BlockState; direction: BlockDirection): uint8 =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.getStrongRedstonePowerImpl
    return f(GetRedstonePowerArgs(world: world, block0: blockRef, state: state, position: position, direction: direction))
  0'u8

proc canPlaceAt*(r: BlockRegistry; server: nil BlockServer; world: nil BlockWorld; blockAccessor: BlockWorld; player: nil BlockPlayer;
    blockRef: Block; state: BlockState; position: BlockPos; direction: Option[BlockDirection]; useItemOn: Option[SUseItemOn]): bool =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.canPlaceAtImpl
    return f(CanPlaceAtArgs(server: server, world: world, blockAccessor: blockAccessor, block0: blockRef, state: state,
      position: position, direction: direction, player: player, useItemOn: useItemOn))
  true

proc onStateReplaced*(r: BlockRegistry; world: BlockWorld; blockRef: Block; position: BlockPos; oldStateId: BlockStateId; moved: bool) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.onStateReplacedImpl
    f(OnStateReplacedArgs(world: world, block0: blockRef, oldStateId: oldStateId, position: position, moved: moved))

proc prepare*(r: BlockRegistry; world: BlockWorld; position: BlockPos; blockRef: Block; stateId: BlockStateId; flags: BlockFlags) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    let f = b.prepareImpl
    f(PrepareArgs(world: world, block0: blockRef, stateId: stateId, position: position, flags: flags))

# --- Block entities ----------------------------------------------------------------------------------------

proc newBlockEntityVt*(): BlockEntityVt =
  BlockEntityVt(
    tickImpl: proc(self: BlockEntity; world: BlockWorld) {.closure.} = discard,
    takeLootTableImpl: proc(self: BlockEntity): Option[(string, int64)] {.closure.} = none[(string, int64)](),
    hasLootTableImpl: proc(self: BlockEntity): bool {.closure.} = false,
    chunkDataNbtImpl: proc(self: BlockEntity): Option[NbtCompound] {.closure.} = none[NbtCompound](),
    getInventoryImpl: proc(self: BlockEntity): Option[Inventory] {.closure.} = none[Inventory](),
    setBlockStateImpl: proc(self: BlockEntity; blockState: BlockStateId) {.closure.} = discard,
    isDirtyImpl: proc(self: BlockEntity): bool {.closure.} = false,
    clearDirtyImpl: proc(self: BlockEntity) {.closure.} = discard)

proc getPosition*(self: BlockEntity): BlockPos =
  let f = self.vt.getPositionImpl
  f(self)
proc resourceLocation*(self: BlockEntity): string =
  let f = self.vt.resourceLocationImpl
  f(self)
proc writeNbt*(self: BlockEntity; nbt: var NbtCompound) =
  let f = self.vt.writeNbtImpl
  f(self, nbt)
proc tick*(self: BlockEntity; world: BlockWorld) =
  let f = self.vt.tickImpl
  f(self, world)
proc getInventory*(self: BlockEntity): Option[Inventory] =
  let f = self.vt.getInventoryImpl
  f(self)
proc chunkDataNbt*(self: BlockEntity): Option[NbtCompound] =
  let f = self.vt.chunkDataNbtImpl
  f(self)
proc isDirty*(self: BlockEntity): bool =
  let f = self.vt.isDirtyImpl
  f(self)
proc clearDirty*(self: BlockEntity) =
  let f = self.vt.clearDirtyImpl
  f(self)

proc scatterInventory*(w: BlockWorld; position: BlockPos; inventory: Inventory) =
  ## `scatter_inventory`
  let f = w.dropStack0
  for i in 0 ..< inventory.size():
    let stack = inventory.getStack(i)
    if not stack.isEmpty():
      f(position, stack)

proc onBlockReplaced*(self: BlockEntity; world: BlockWorld; position: BlockPos) =
  let f = self.vt.onBlockReplacedImpl
  if f != nil:
    f(self, world, position)
  else:
    let inventory = self.getInventory()
    if inventory.isSome:
      world.scatterInventory(position, inventory.unsafeGet)

proc getBlockEntity*(w: BlockWorld; position: BlockPos): Option[BlockEntity] =
  ## `get_block_entity`
  let key = position.asLong()
  if w.blockEntities.hasKey(key):
    return some(w.blockEntities.getOrDefault(key, nil))
  let pending = w.pendingBlockEntity0
  if pending != nil and w.blockEntityFromNbt0 != nil:
    let nbt = pending(position)
    if nbt.isSome:
      let g = w.blockEntityFromNbt0
      let entity = g(nbt.unsafeGet)
      if entity.isSome:
        w.blockEntities[key] = entity.unsafeGet
      return entity
  none[BlockEntity]()

proc addBlockEntity*(w: BlockWorld; entity: BlockEntity) =
  ## `add_block_entity`
  w.blockEntities[entity.getPosition().asLong()] = entity
  let f = w.blockEntityChanged0
  if f != nil:
    f(entity)

proc removeBlockEntity*(w: BlockWorld; position: BlockPos) =
  ## `remove_block_entity`
  w.blockEntities.del(position.asLong())
  let f = w.blockEntityRemoved0
  if f != nil:
    f(position)

proc updateBlockEntity*(w: BlockWorld; entity: BlockEntity) =
  let f = w.updateBlockEntity0
  if f != nil:
    f(entity)

# --- World: neighbour updates and state changes -----------------------------------------------------------

proc updateNeighbors*(w: BlockWorld; blockPos: BlockPos; except0: Option[BlockDirection]) =
  ## `update_neighbors`
  let sourceBlock = w.getBlock(blockPos)
  let dirs1 = blockDirectionUpdateOrder()
  for direction in dirs1:
    if except0.isSome and except0.unsafeGet == direction:
      continue
    let neighborPos = blockPos.offset(direction.toOffset())
    let (neighborBlock, neighborFluid) = w.getBlockAndFluid(neighborPos)
    let b = w.blockRegistry.behaviourOf(neighborBlock.id)
    if b != nil:
      let f = b.onNeighborUpdateImpl
      f(OnNeighborUpdateArgs(world: w, block0: neighborBlock, position: neighborPos, sourceBlock: sourceBlock, notify: false))
    let fl = w.blockRegistry.fluidBehaviourOf(neighborFluid.id)
    if fl != nil:
      let f = fl.onNeighborUpdateImpl
      f(w, neighborFluid, neighborPos, false)

proc updateNeighbor*(w: BlockWorld; neighborBlockPos: BlockPos; sourceBlock: Block) =
  ## `update_neighbor`
  let neighborBlock = w.getBlock(neighborBlockPos)
  let b = w.blockRegistry.behaviourOf(neighborBlock.id)
  if b != nil:
    let f = b.onNeighborUpdateImpl
    f(OnNeighborUpdateArgs(world: w, block0: neighborBlock, position: neighborBlockPos, sourceBlock: sourceBlock, notify: false))

proc registryUpdateNeighbors(w: BlockWorld; position: BlockPos; blockRef: Block; flags: BlockFlags)

proc setBlockState*(w: BlockWorld; position: BlockPos; blockStateId: BlockStateId; flags: BlockFlags): BlockStateId {.discardable.} =
  ## `set_block_state`
  let setter = w.setRaw
  let replacedBlockStateId = setter(position, blockStateId)
  if replacedBlockStateId == blockStateId:
    return blockStateId
  let oldBlock = Block.fromStateId(replacedBlockStateId)
  let newBlock = Block.fromStateId(blockStateId)
  let blockMoved = flags.hasFlag(BfMoved)
  let isNewBlock = not sameBlock(oldBlock, newBlock)
  # WorldChunk.java line 305-314
  if isNewBlock and oldBlock.defaultState.blockEntityType != high(uint16):
    let entity = w.getBlockEntity(position)
    if entity.isSome:
      entity.unsafeGet.onBlockReplaced(w, position)
      w.removeBlockEntity(position)
  # WorldChunk.java line 317
  if isNewBlock and (flags.hasFlag(BfNotifyNeighbors) or blockMoved):
    w.blockRegistry.onStateReplaced(w, oldBlock, position, replacedBlockStateId, blockMoved)
  # WorldChunk.java line 318
  if not flags.hasFlag(BfSkipBlockAddedCallback) and isNewBlock:
    # `on_placed`
    let state = w.getBlockState(position)
    if state.blockEntityType != high(uint16) and w.getBlockEntity(position).isNone and w.createBlockEntity0 != nil:
      let create = w.createBlockEntity0
      let entity = create(state.blockEntityType, position)
      if entity.isSome:
        w.addBlockEntity(entity.unsafeGet)
    let b = w.blockRegistry.behaviourOf(newBlock.id)
    if b != nil:
      let f = b.placedImpl
      f(PlacedArgs(world: w, block0: newBlock, stateId: blockStateId, oldStateId: replacedBlockStateId, position: position, notify: blockMoved))
    let newFluid = w.getFluid(position)
    let fl = w.blockRegistry.fluidBehaviourOf(newFluid.id)
    if fl != nil:
      let f = fl.placedImpl
      f(w, newFluid, blockStateId, position, replacedBlockStateId, blockMoved)
  # Ig they do this cause it could be modified in chunkPos.setBlockState?
  if w.getBlockStateId(position) == blockStateId:
    if flags.hasFlag(BfNotifyNeighbors):
      w.updateNeighbors(position, none[BlockDirection]())
    if not flags.hasFlag(BfForceState):
      let newFlags = flags and not (BfNotifyNeighbors or BfNotifyListeners)
      w.blockRegistry.prepare(w, position, oldBlock, replacedBlockStateId, newFlags)
      w.registryUpdateNeighbors(position, newBlock, newFlags)
      w.blockRegistry.prepare(w, position, newBlock, blockStateId, newFlags)
  let light = w.updateLighting0
  if light != nil:
    light(position)
  replacedBlockStateId

proc breakBlock*(w: BlockWorld; position: BlockPos; cause: nil BlockPlayer; flags: BlockFlags): Option[BlockStateId] {.discardable.} =
  ## `break_block`. The block break event is not fired: no plugin hears of it from here yet.
  let (brokenBlock, brokenBlockState) = w.getBlockAndStateId(position)
  if isAir(brokenBlockState):
    return none[BlockStateId]()
  var newStateId = blockStateIdAir
  if brokenBlock.isWaterlogged(brokenBlockState):
    # FlowingFluidProperties of flowing water at level 8, not falling: a water source.
    var waterProps = FlowingWaterLikeFluidProperties.default(Fluid.FLOWING_WATER)
    waterProps.level = Level.L8
    waterProps.falling = Falling.False
    newStateId = waterProps.toStateId(Fluid.FLOWING_WATER)
  let brokenStateId = w.setBlockState(position, newStateId, flags)
  let closer = w.closeContainerScreensAt0
  if closer != nil:
    closer(position)
  if not sameBlock(Block.fromStateId(brokenStateId), blockFire()):
    let particles = w.broadcastBlockBreakParticles0
    if particles != nil:
      particles(position, brokenStateId, cause)
  if not flags.hasFlag(BfSkipDrops):
    let drop = w.dropLoot0
    if drop != nil:
      drop(position, brokenStateId, cause)
  some(newStateId)

proc replaceWithStateForNeighborUpdate*(w: BlockWorld; blockPos: BlockPos; direction: BlockDirection; flags: BlockFlags) =
  ## `replace_with_state_for_neighbor_update`
  let (blockRef, blockStateId) = w.getBlockAndStateId(blockPos)
  if flags.hasFlag(BfSkipRedstoneWireStateReplacement) and sameBlock(blockRef, blockRedstoneWire()):
    return
  let neighborPos = blockPos.offset(direction.toOffset())
  let neighborStateId = w.getBlockStateId(neighborPos)
  let newStateId = w.blockRegistry.getStateForNeighborUpdate(w, blockRef, blockStateId, blockPos, direction, neighborPos, neighborStateId)
  if newStateId != blockStateId:
    if isAir(newStateId):
      discard w.breakBlock(blockPos, nil, flags)
    else:
      discard w.setBlockState(blockPos, newStateId, flags)

proc registryUpdateNeighbors(w: BlockWorld; position: BlockPos; blockRef: Block; flags: BlockFlags) =
  ## `BlockRegistry::update_neighbors`
  let dirs2 = blockDirectionAbstractBlockUpdateOrder()
  for direction in dirs2:
    let pos = position.offset(direction.toOffset())
    w.replaceWithStateForNeighborUpdate(pos, direction.opposite(), flags)

proc updateFromNeighborShapes*(w: BlockWorld; stateId: BlockStateId; pos: BlockPos): BlockStateId =
  ## `update_from_neighbor_shapes`
  var currentStateId = stateId
  let blockRef = Block.fromStateId(stateId)
  let dirs3 = blockDirectionAll()
  for direction in dirs3:
    let neighborPos = pos.offset(direction.toOffset())
    let neighborStateId = w.getBlockStateId(neighborPos)
    currentStateId = w.blockRegistry.getStateForNeighborUpdate(w, blockRef, currentStateId, pos, direction, neighborPos, neighborStateId)
  currentStateId

