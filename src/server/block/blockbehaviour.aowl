    player*: BlockPlayer
    hit*: BlockHitResult
    itemStack*: ItemStackRef
    equipmentSlot*: int

  ItemStackRef* = ref object
    ## `Arc<Mutex<ItemStack>>`.
    stack*: ItemStack

  OnEntityCollisionArgs* = object
    server*: BlockServer
    world*: BlockWorld
    block0*: Block
    state*: BlockState
    position*: BlockPos
    entity*: BlockActor

  OnEntityStepArgs* = object
    world*: BlockWorld
    block0*: Block
    state*: BlockState
    position*: BlockPos
    entity*: BlockActor
    belowSupportingBlock*: bool

  ExplodeArgs* = object
