## Port of pumpkin/src/block/mod.rs: `BlockBehaviour`, its argument structs and helpers. Also here, because all of it
## refers to itself and aowlmony types cannot be recursive across modules: the dispatch half of
## pumpkin/src/block/registry.rs (`default_registry` is in registry.aowl), `FluidBehaviour`'s trait from fluid/mod.rs,
## the `BlockEntity` trait from entities/mod.rs, and the block half of pumpkin/src/world/mod.rs: `set_block_state`,
## `break_block`, `update_neighbors`, `update_neighbor`, `update_from_neighbor_shapes`,
## `replace_with_state_for_neighbor_update` and the block entity table.
##
## `BlockWorld` stands where upstream passes `&Arc<World>`. A World calls the registry and the registry calls blocks that
## call the World, and aowlmony has no import cycles, so blocks see this vtable of what a world provides, and
## worldadapter.aowl fills it from the real `World`. testworld.aowl fills it from a table, so that redstone runs in a test.
## `BlockActor` and `BlockPlayer` stand for `dyn EntityBase` and `Player` in the same way.
## PARTIAL: pumpkin/src/block/mod.rs - `drop_loot`, `calc_block_breaking` and `calculate_comparator_output` are not ported yet: loot and mining speed live on the world and player side, `dropLoot0` is the hook.
## PARTIAL: pumpkin/src/block/registry.rs - see registry.aowl for what is not done.
## PARTIAL: pumpkin/src/block/fluid/mod.rs - the trait only, untested: fluid/fluidmod is not written.
## PARTIAL: pumpkin/src/block/entities/mod.rs - the trait only: `block_entity_from_nbt` and `create_block_entity` are not written, so `createBlockEntity0` stays nil.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[options, tables]
import ../../data/block_ext
from ../../data/block_state import newBlockStateIdUnchecked, asU16, BlockStateId, isAir, BlockState, blockStateIdAir
import ../../generated/[block_enums, dimension, fluid, sound, sound_category, world_event, particle, tag]
import "../../data/item_stack/mod"
import ../../inventory/inventory
import ../../inventory/screenhandler
import ../../nbt/tag as nbttag
import ../../protocol/java/server/play/use_item_on
import ../../util/gamemode
import ../../util/math/position
import ../../util/math/boundingbox
import ../../util/vector3
import ../../util/text/text
import ../../world/world as worldtraits
import ../../world/tick
from ../../world/worldinfo import LevelData

export worldtraits.BlockFlags, worldtraits.hasFlag, worldtraits.BfNotifyNeighbors, worldtraits.BfNotifyListeners,
  worldtraits.BfNotifyAll, worldtraits.BfForceState, worldtraits.BfSkipDrops, worldtraits.BfMoved,
  worldtraits.BfSkipRedstoneWireStateReplacement, worldtraits.BfSkipBlockEntityReplacedCallback,
  worldtraits.BfSkipBlockAddedCallback
export use_item_on, TickPriority

type
  BlockActionResult* = enum
    ## `BlockActionResult` in registry.rs.
    barSuccess                   ## Action was successful. SUCCESS in vanilla
    barSuccessServer             ## Successful, and the server should swing the hand. SUCCESS_SERVER in vanilla
    barConsume                   ## Block other actions from being executed. CONSUME in vanilla
    barFail                      ## Allow other actions to be executed, but indicate it failed. FAIL in vanilla
    barPass                      ## Allow other actions to be executed. PASS in vanilla
    barPassToDefaultBlockAction  ## Use default action for the block: `normal_use`

  BlockIsReplacingKind* {.pure.} = enum
    kItself, kWater, kOther, kNone

  BlockIsReplacing* = object
    ## `BlockIsReplacing`.
    kind*: BlockIsReplacingKind
    f0Itself*: BlockStateId
    f0Water*: uint8

  BlockActor* = ref object of RootObj
    ## `dyn EntityBase`. What a block reads and does to an entity; worldadapter.aowl fills the closures.
    entityId*: int32
    entityUuid*: string
    entityTypeName*: string
    isLiving*: bool
    player0*: nil BlockPlayer
    block0Pos*: proc(): Vector3[float64] {.closure.}
    setPos0*: proc(p: Vector3[float64]) {.closure.}
    getVelocity0*: proc(): Vector3[float64] {.closure.}
    setVelocity0*: proc(v: Vector3[float64]) {.closure.}
    getBox0*: proc(): BoundingBox {.closure.}
    sneaking0*: proc(): bool {.closure.}
    yaw0*: proc(): float32 {.closure.}
    pitch0*: proc(): float32 {.closure.}
    onGround0*: proc(): bool {.closure.}
    damage0*: proc(amount: float32; damageType: string): bool {.closure.}
    setOnFireFor0*: proc(seconds: float32) {.closure.}
    extinguish0*: proc() {.closure.}
    slowMovement0*: proc(multiplier: Vector3[float64]) {.closure.}
    handleFallDamage0*: proc(fallDistance: float32; damageMultiplier: float32) {.closure.}
    addEffect0*: proc(effect: string; durationTicks: int32; amplifier: uint8) {.closure.}
    remove0*: proc() {.closure.}
    tryUsePortal0*: proc(portalDelay: uint32; targetDimension: string; position: BlockPos) {.closure.}
      ## `Entity::try_use_portal`; the target world is the dimension's, `server.get_world_from_dimension`.
    itemFrameFacing0*: proc(): BlockDirection {.closure.}
      ## Set on an item frame only: `ItemFrameEntity` is the entity agent's.
    itemFrameOutput0*: proc(): uint8 {.closure.}

  BlockPlayer* = ref object of BlockActor
    ## `Player`, as far as blocks use one.
    gamemode0*: proc(): GameMode {.closure.}
    inventory0*: proc(): Inventory {.closure.}
    openHandledScreen0*: proc(factory: BlockScreenFactory; position: Option[BlockPos]): bool {.closure.}
    sendSystemMessage0*: proc(message: TextComponent; overlay: bool) {.closure.}
    incrementStat0*: proc(stat: string; amount: int32) {.closure.}
    allowModifyWorld0*: proc(): bool {.closure.}
    addHunger0*: proc(food: int32; saturation: float32) {.closure.}
    hungerLevel0*: proc(): int32 {.closure.}
    isOp0*: proc(): bool {.closure.}
    stackInHand0*: proc(hand: int): ItemStack {.closure.}
    setStackInHand0*: proc(hand: int; stack: ItemStack) {.closure.}
    setRespawnPoint0*: proc(position: BlockPos; yaw: float32) {.closure.}
    sleep0*: proc(position: BlockPos) {.closure.}

  BlockScreenFactory* = ref object
    ## `ScreenHandlerFactory`.
    title*: TextComponent
    createScreenHandler*: proc(syncId: uint8; player: BlockPlayer): ScreenHandler {.closure.}

  BlockEntityVt* = ref object
    ## `BlockEntity`'s methods. One per entity type; `BlockEntity.vt` points at it.
    writeNbtImpl*: proc(self: BlockEntity; nbt: var NbtCompound) {.closure.}
    tickImpl*: proc(self: BlockEntity; world: BlockWorld) {.closure.}
    resourceLocationImpl*: proc(self: BlockEntity): string {.closure.}
    getPositionImpl*: proc(self: BlockEntity): BlockPos {.closure.}
    takeLootTableImpl*: proc(self: BlockEntity): Option[(string, int64)] {.closure.}
    hasLootTableImpl*: proc(self: BlockEntity): bool {.closure.}
    chunkDataNbtImpl*: proc(self: BlockEntity): Option[NbtCompound] {.closure.}
    getInventoryImpl*: proc(self: BlockEntity): Option[Inventory] {.closure.}
    setBlockStateImpl*: proc(self: BlockEntity; blockState: BlockStateId) {.closure.}
    onBlockReplacedImpl*: proc(self: BlockEntity; world: BlockWorld; position: BlockPos) {.closure.}
    isDirtyImpl*: proc(self: BlockEntity): bool {.closure.}
    clearDirtyImpl*: proc(self: BlockEntity) {.closure.}

  BlockEntity* = ref object of RootObj
    vt*: BlockEntityVt

  BlockServer* = ref object
    ## `Server`, as far as blocks read one. Nil-safe stand-in for `args.server`.
    tickCount*: int64

  BlockWorld* = ref object
    ## What a block calls on `World`. The raw half is filled by whoever owns the storage; the logic above it is below.
    getRaw*: proc(position: BlockPos): BlockStateId {.closure.}
    setRaw*: proc(position: BlockPos; id: BlockStateId): BlockStateId {.closure.}
      ## Writes the state, marks the chunk dirty and queues the client update; answers the replaced state.
    isLoaded0*: proc(position: BlockPos): bool {.closure.}
    updateLighting0*: proc(position: BlockPos) {.closure.}
    closeContainerScreensAt0*: proc(position: BlockPos) {.closure.}
    broadcastBlockBreakParticles0*: proc(position: BlockPos; stateId: BlockStateId; cause: nil BlockPlayer) {.closure.}
    dropLoot0*: proc(position: BlockPos; stateId: BlockStateId; cause: nil BlockPlayer) {.closure.}
    scheduleBlockTick0*: proc(blockRef: Block; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.}
    scheduleFluidTick0*: proc(fluid: Fluid; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.}
    isBlockTickScheduled0*: proc(position: BlockPos; blockRef: Block): bool {.closure.}
    isFluidTickScheduled0*: proc(position: BlockPos; fluid: Fluid): bool {.closure.}
    syncWorldEvent0*: proc(event: WorldEvent; position: BlockPos; data: int32) {.closure.}
    playSoundExcept0*: proc(exceptEntityId: int32; sound: Sound; category: SoundCategory; position: Vector3[float64]; volume, pitch: float32) {.closure.}
    playSound0*: proc(sound: Sound; category: SoundCategory; position: Vector3[float64]; volume, pitch: float32) {.closure.}
    addSyncedBlockEvent0*: proc(position: BlockPos; kind, data: uint8) {.closure.}
    spawnEntity0*: proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.}
    spawnParticle0*: proc(position, offset: Vector3[float64]; maxSpeed: float32; count: int32; particle: Particle) {.closure.}
    dropStack0*: proc(position: BlockPos; stack: ItemStack) {.closure.}
    entitiesAtBox0*: proc(box: BoundingBox): seq[BlockActor] {.closure.}
    playersAtBox0*: proc(box: BoundingBox): seq[BlockPlayer] {.closure.}
    closestPlayer0*: proc(position: Vector3[float64]; radius: float64): Option[BlockPlayer] {.closure.}
    playerByUuid0*: proc(uuid: string): Option[BlockPlayer] {.closure.}
    replaceSpawnFalling0*: proc(position: BlockPos; stateId: BlockStateId) {.closure.}
      ## `FallingEntity::replace_spawn`: entity/falling.aowl sits above the blocks.
    explode0*: proc(position: Vector3[float64]; power: float32) {.closure.}
    worldAge0*: proc(): int64 {.closure.}
    timeOfDay0*: proc(): int64 {.closure.}
    isRaining0*: proc(): bool {.closure.}
    isThundering0*: proc(): bool {.closure.}
    blockLight0*: proc(position: BlockPos): Option[uint8] {.closure.}
    skyLight0*: proc(position: BlockPos): uint8 {.closure.}
    biomeAt0*: proc(position: BlockPos): string {.closure.}
    blockEntityChanged0*: proc(entity: BlockEntity) {.closure.}
    updateBlockEntity0*: proc(entity: BlockEntity) {.closure.}
    pendingBlockEntity0*: proc(position: BlockPos): Option[NbtCompound] {.closure.}
    levelInfo0*: proc(): LevelData {.closure.}
    blockEntityRemoved0*: proc(position: BlockPos) {.closure.}
    minY*: int32
    topY*: int32
    dimensionName*: string
    dimension*: Dimension
    blockRegistry*: BlockRegistry
    blockEntities*: Table[int64, BlockEntity]
    blockEntityFromNbt0*: proc(nbt: NbtCompound): Option[BlockEntity] {.closure.}
    createBlockEntity0*: proc(entityType: uint16; position: BlockPos): Option[BlockEntity] {.closure.}
    portalPoiAdd0*: proc(position: BlockPos) {.closure.}
      ## `world.portal_poi.add_portal`. world/portal/nether.aowl; worldhooks fills the six portal hooks.
    portalPoiRemove0*: proc(position: BlockPos) {.closure.}
    portalPoiInSquare0*: proc(center: BlockPos; radius: int32): seq[BlockPos] {.closure.}
      ## `portal_poi.get_in_square(center, radius, Some(POI_TYPE_NETHER_PORTAL))`.
    borderContainsBlock0*: proc(x, z: int32): bool {.closure.}
    borderClampBlock0*: proc(x, z: int32): (int32, int32) {.closure.}
    motionBlockingHeight0*: proc(x, z: int32): int32 {.closure.}
      ## `get_heightmap_height_async(ChunkHeightmapType::MotionBlocking, x, z)`.

  NormalUseArgs* = object
    server*: BlockServer
    world*: BlockWorld
    block0*: Block
