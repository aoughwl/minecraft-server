  OnSyncedBlockEventArgs* = object
    world*: BlockWorld
    block0*: Block
    position*: BlockPos
    kind0*: uint8
    data*: uint8

  OnPlaceArgs* = object
    server*: BlockServer
    world*: BlockWorld
    block0*: Block
    position*: BlockPos
    direction*: BlockDirection
    player*: BlockPlayer
    replacing*: BlockIsReplacing
    useItemOn*: SUseItemOn

  RandomTickArgs* = object
