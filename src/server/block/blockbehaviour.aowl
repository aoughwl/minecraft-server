  f(args)
proc getInsideCollisionShape*(b: BlockBehaviour; args: GetInsideCollisionShapeArgs): BoundingBox =
  let f = b.getInsideCollisionShapeImpl
  f(args)
proc mirror*(b: BlockBehaviour; blockRef: Block; stateId: BlockStateId; mirror: Mirror): BlockState =
  let f = b.mirrorImpl
  f(blockRef, stateId, mirror)
proc rotate*(b: BlockBehaviour; blockRef: Block; stateId: BlockStateId; rotation: Rotation): BlockState =
  let f = b.rotateImpl
  f(blockRef, stateId, rotation)

# --- The rest of `BlockRegistry` ------------------------------------------------------------------------------

proc onSyncedBlockEvent*(r: BlockRegistry; blockRef: Block; world: BlockWorld; position: BlockPos; kind, data: uint8): bool =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.onSyncedBlockEvent(OnSyncedBlockEventArgs(world: world, block0: blockRef, position: position, kind0: kind, data: data))
  false

proc onEntityCollision*(r: BlockRegistry; blockRef: Block; world: BlockWorld; entity: BlockActor; position: BlockPos; state: BlockState; server: BlockServer) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    b.onEntityCollision(OnEntityCollisionArgs(server: server, world: world, block0: blockRef, state: state, position: position, entity: entity))

proc onEntityStep*(r: BlockRegistry; blockRef: Block; world: BlockWorld; entity: BlockActor; position: BlockPos; state: BlockState; belowSupportingBlock: bool) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    b.onEntityStep(OnEntityStepArgs(world: world, block0: blockRef, state: state, position: position, entity: entity, belowSupportingBlock: belowSupportingBlock))

proc onUse*(r: BlockRegistry; blockRef: Block; player: BlockPlayer; position: BlockPos; hit: BlockHitResult; server: BlockServer; world: BlockWorld): BlockActionResult =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.normalUse(NormalUseArgs(server: server, world: world, block0: blockRef, position: position, player: player, hit: hit))
  barPass

proc explode*(r: BlockRegistry; blockRef: Block; world: BlockWorld; position: BlockPos) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    b.explode(ExplodeArgs(world: world, block0: blockRef, position: position))

proc useWithItem*(r: BlockRegistry; blockRef: Block; player: BlockPlayer; position: BlockPos; hit: BlockHitResult; itemStack: ItemStackRef; equipmentSlot: int; server: BlockServer; world: BlockWorld): BlockActionResult =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.useWithItem(UseWithItemArgs(server: server, world: world, block0: blockRef, position: position, player: player, hit: hit, itemStack: itemStack, equipmentSlot: equipmentSlot))
  barPassToDefaultBlockAction

proc canUpdateAt*(r: BlockRegistry; world: BlockWorld; blockRef: Block; stateId: BlockStateId; position: BlockPos; direction: BlockDirection; useItemOn: SUseItemOn; player: BlockPlayer): bool =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.canUpdateAt(CanUpdateAtArgs(world: world, block0: blockRef, stateId: stateId, position: position, direction: direction, player: player, useItemOn: useItemOn))
  false

proc onPlace*(r: BlockRegistry; server: BlockServer; world: BlockWorld; player: BlockPlayer; blockRef: Block; position: BlockPos; direction: BlockDirection; replacing: BlockIsReplacing; useItemOn: SUseItemOn): BlockStateId =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.onPlace(OnPlaceArgs(server: server, world: world, block0: blockRef, position: position, direction: direction, player: player, replacing: replacing, useItemOn: useItemOn))
  blockRef.defaultState.id

proc playerPlaced*(r: BlockRegistry; world: BlockWorld; blockRef: Block; stateId: BlockStateId; position: BlockPos; direction: BlockDirection; player: BlockPlayer) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    b.playerPlaced(PlayerPlacedArgs(world: world, block0: blockRef, stateId: stateId, position: position, direction: direction, player: player))

proc broken*(r: BlockRegistry; blockRef: Block; player: BlockPlayer; position: BlockPos; server: BlockServer; world: BlockWorld; state: BlockState) =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    b.broken(BrokenArgs(block0: blockRef, player: player, position: position, server: server, world: world, state: state))

proc getInsideCollisionShape*(r: BlockRegistry; blockRef: Block; world: BlockWorld; state: BlockState; position: BlockPos): BoundingBox =
  let b = r.behaviourOf(blockRef.id)
  if b != nil:
    return b.getInsideCollisionShape(GetInsideCollisionShapeArgs(world: world, block0: blockRef, state: state, position: position))
  BoundingBox.fullBlock()

proc mirrorState*(r: BlockRegistry; blockRef: Block; stateId: BlockStateId; mirror: Mirror): BlockState =
  let b = r.behaviourOf(blockRef.id)
  if b != nil: b.mirror(blockRef, stateId, mirror) else: blockRef.mirror(stateId, mirror)

proc rotateState*(r: BlockRegistry; blockRef: Block; stateId: BlockStateId; rotation: Rotation): BlockState =
  let b = r.behaviourOf(blockRef.id)
  if b != nil: b.rotate(blockRef, stateId, rotation) else: blockRef.rotate(stateId, rotation)
