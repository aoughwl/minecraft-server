## The block-entity half of `handle_set_command_block`, `handle_set_jigsaw_block` and `handle_jigsaw_generate` in
## pumpkin/src/net/java/play.rs. The packet side (creative and permission checks, the kick) is in net/java/play.aowl, which
## cannot import the blocks: it calls these through the hooks in entity/entitymod.aowl. There is no
## `handle_set_structure_block` in the pinned tree.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/options
import blockprelude
import entities/[command_block, jigsaw_block]
import ../entity/entitymod
import ../entity/player as playermod
import ../serverbase
import ../world/worldmod

gSetCommandBlockHook = proc(player: Player; position: BlockPos; command: string; mode: int32; flags: int8): bool {.closure.} =
  let world = BlockWorld(player.world.blockWorld)
  let found = world.getBlockEntity(position)
  if found.isNone:
    return true
  if found.unsafeGet.resourceLocation() != command_block.ID:
    # "Client tried to change Command block but not Command block entity found"
    return true
  if mode < 0'i32 or mode > 2'i32:
    return false
  let blockRef = world.getBlock(position)
  let oldStateId = world.getBlockStateId(position)
  var props = CommandBlockLikeProperties.fromStateId(oldStateId, blockRef)
  let blockType = case mode
    of 0'i32: blockChainCommandBlock()
    of 1'i32: blockRepeatingCommandBlock()
    else: blockCommandBlock()
  let old = found.unsafeGet.asType(CommandBlockEntity)
  if old.isNone:
    return true
  let oldCommandBlock = old.unsafeGet
  props.conditional = (flags and 0x2'i8) != 0'i8
  let newStateId = props.toStateId(blockType)
  discard world.setBlockState(position, newStateId, BfSkipBlockAddedCallback)
  var cmd = command
  if cmd.len > 0 and cmd[0] == '/':
    cmd = cmd[1 ..< cmd.len]
  let commandBlock = CommandBlockEntity(vt: commandBlockEntityVt(), position: position, powered: oldCommandBlock.powered,
    conditionMet: oldCommandBlock.conditionMet, auto: (flags and 0x4'i8) != 0'i8, dirty: oldCommandBlock.dirty, command: cmd,
    lastOutput: oldCommandBlock.lastOutput, trackOutput: (flags and 0x1'i8) != 0'i8, successCount: 0'u32)
  world.addBlockEntity(commandBlock)
  player.sendSystemMessageRaw(text("Command set: " & command), false)
  # The 0x4 flag means always active
  if (flags and 0x4'i8) != 0'i8 and blockType != blockChainCommandBlock():
    world.scheduleBlockTick(blockType, position, 1, tpNormal)
  true

gSetJigsawBlockHook = proc(world: World; position: BlockPos; name, target, pool, finalState, joint: string;
    selectionPriority, placementPriority: int32) {.closure.} =
  let blockWorld = BlockWorld(world.blockWorld)
  let found = blockWorld.getBlockEntity(position)
  if found.isNone:
    return
  if found.unsafeGet.resourceLocation() != jigsaw_block.ID:
    # "Client tried to change Jigsaw block but not Jigsaw block entity found"
    return
  let jigsaw = found.unsafeGet.asType(JigsawBlockEntity)
  if jigsaw.isNone:
    return
  let entity = jigsaw.unsafeGet
  entity.name = name
  entity.target = target
  entity.pool = pool
  entity.finalState = finalState
  entity.joint = jointFromStr(joint)
  entity.selectionPriority = selectionPriority
  entity.placementPriority = placementPriority
  blockWorld.updateBlockEntity(found.unsafeGet)

gJigsawGenerateRequestHook = proc(world: World; position: BlockPos; levels: int32; keepJigsaws: bool) {.closure.} =
  let blockWorld = BlockWorld(world.blockWorld)
  let found = blockWorld.getBlockEntity(position)
  if found.isSome:
    let jigsaw = found.unsafeGet.asType(JigsawBlockEntity)
    if jigsaw.isSome:
      jigsaw.unsafeGet.generate(blockWorld, levels, keepJigsaws)
