## Port of pumpkin/src/block/blocks/abstract_wall_mounting.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  WallMountedBlock* = ref object
    getDirectionImpl*: proc(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection {.closure.}
    getPlacementFaceImpl*: proc(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): (AttachFace, HorizontalFacing) {.closure.}
    getPlacementDirectionImpl*: proc(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): BlockDirection {.closure.}
    canPlaceAtImpl*: proc(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool {.closure.}
    getStateForNeighborUpdateImpl*: proc(self: WallMountedBlock, args: GetStateForNeighborUpdateArgs): BlockStateId {.closure.}



proc getDirection*(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc getPlacementFace*(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): (AttachFace, HorizontalFacing)
proc defaultGetPlacementFace_WallMountedBlock(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): (AttachFace, HorizontalFacing)
proc getPlacementDirection*(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): BlockDirection
proc defaultGetPlacementDirection_WallMountedBlock(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): BlockDirection
proc canPlaceAt*(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool
proc defaultCanPlaceAt_WallMountedBlock(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool
proc getStateForNeighborUpdate*(self: WallMountedBlock, args: GetStateForNeighborUpdateArgs): BlockStateId
proc defaultGetStateForNeighborUpdate_WallMountedBlock(self: WallMountedBlock, args: GetStateForNeighborUpdateArgs): BlockStateId
proc newWallMountedBlock*(): WallMountedBlock

proc defaultGetPlacementFace_WallMountedBlock(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): (AttachFace, HorizontalFacing) =
  let t1 = block:
    case direction
    of BlockDirection.Up:
      AttachFace.Ceiling
    of BlockDirection.Down:
      AttachFace.Floor
    else:
      AttachFace.Wall
  let face = t1
  let t2 = block:
    if ((direction == BlockDirection.Up) or (direction == BlockDirection.Down)):
      player.getEntity().getHorizontalFacing()
    else:
      direction.opposite().toCardinalDirection()
  let facing = t2
  (face, facing)

proc defaultGetPlacementDirection_WallMountedBlock(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): BlockDirection =
  let (face, facing) = self.getPlacementFace(player, direction)
  case face
  of AttachFace.Floor:
    BlockDirection.Up
  of AttachFace.Ceiling:
    BlockDirection.Down
  of AttachFace.Wall:
    facing.toBlockDirection()

proc defaultCanPlaceAt_WallMountedBlock(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool =
  let blockPos = pos.offset(direction.toOffset())
  let blockState = world.getBlockState(blockPos)
  blockState.isSideSolid(direction.opposite())

proc defaultGetStateForNeighborUpdate_WallMountedBlock(self: WallMountedBlock, args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (self.getDirection(args.stateId, args.block0).opposite() == args.direction) and (not self.canPlaceAt(args.world, args.position, args.direction)):
    blockAir().defaultState.id
  else:
    args.stateId

proc getDirection*(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let f = self.getDirectionImpl
  f(self, stateId, blockRef)

proc getPlacementFace*(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): (AttachFace, HorizontalFacing) =
  let f = self.getPlacementFaceImpl
  f(self, player, direction)

proc getPlacementDirection*(self: WallMountedBlock, player: BlockPlayer, direction: BlockDirection): BlockDirection =
  let f = self.getPlacementDirectionImpl
  f(self, player, direction)

proc canPlaceAt*(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool =
  let f = self.canPlaceAtImpl
  f(self, world, pos, direction)

proc getStateForNeighborUpdate*(self: WallMountedBlock, args: GetStateForNeighborUpdateArgs): BlockStateId =
  let f = self.getStateForNeighborUpdateImpl
  f(self, args)

proc newWallMountedBlock*(): WallMountedBlock =
  result = WallMountedBlock()
  result.getPlacementFaceImpl = defaultGetPlacementFace_WallMountedBlock
  result.getPlacementDirectionImpl = defaultGetPlacementDirection_WallMountedBlock
  result.canPlaceAtImpl = defaultCanPlaceAt_WallMountedBlock
  result.getStateForNeighborUpdateImpl = defaultGetStateForNeighborUpdate_WallMountedBlock

