## Port of pumpkin/src/block/blocks/amethyst.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import abstract_wall_mounting


type
  AmethystBlock* = object

var gAmethystBlockAsWallMountedBlock: nil WallMountedBlock


proc amethystBlockIds*(): seq[BlockId]
proc amethystBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc amethystBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc amethystBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newAmethystBlock*(): BlockBehaviour
proc amethystBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc amethystBlockAsWallMountedBlock*(): WallMountedBlock

proc amethystBlockIds*(): seq[BlockId] =
  @[blockIdSmallAmethystBud, blockIdMediumAmethystBud, blockIdLargeAmethystBud, blockIdAmethystCluster]

proc amethystBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = AmethystClusterLikeProperties.fromStateId(args.block0.defaultState.id, args.block0)
  props.facing = args.direction.toFacing().opposite()
  props.waterlogged = args.replacing.waterSource()
  props.toStateId(args.block0)

proc amethystBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  # Use the provided direction, or fallback to the current state's direction if missing
  let t1 = args.direction
  let t2 =
    if t1.isSome: t1.unsafeGet
    else:
      getDirection(amethystBlockAsWallMountedBlock(), args.state.id, args.block0)
  let direction = t2
  canPlaceAt(amethystBlockAsWallMountedBlock(), args.blockAccessor, args.position, direction)

proc amethystBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(amethystBlockAsWallMountedBlock(), args)

proc newAmethystBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = amethystBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = amethystBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = amethystBlockGetStateForNeighborUpdate_BlockBehaviour

proc amethystBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let props = AmethystClusterLikeProperties.fromStateId(stateId, blockRef)
  props.facing.toBlockDirection()

proc amethystBlockAsWallMountedBlock*(): WallMountedBlock =
  if gAmethystBlockAsWallMountedBlock == nil:
    let v = newWallMountedBlock()
    v.getDirectionImpl = amethystBlockGetDirection_WallMountedBlock
    gAmethystBlockAsWallMountedBlock = v
  gAmethystBlockAsWallMountedBlock

proc registerBlocksAmethyst*(r: BlockRegistry) =
  r.registerIds(amethystBlockIds(), newAmethystBlock())

