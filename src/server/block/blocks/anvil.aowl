## Port of pumpkin/src/block/blocks/anvil.rs
## `FallingBlock::placed`, `on_scheduled_tick` and `get_state_for_neighbor_update` are the behaviour of falling.aowl, called
## through the behaviour that `newFallingBlock` builds.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/anvil_screen_handler
import ../../../inventory/inventory
import falling

let gAnvilFallingBlock: BlockBehaviour = newFallingBlock()

proc anvilScreenFactory(): BlockScreenFactory =
  ## `AnvilScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_REPAIR, BEDROCK_CONTAINER_REPAIR),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      let inventory = Inventory(newArrayInventory(3))
      ScreenHandler(newAnvilScreenHandler(syncId, playerInventory, inventory)))

proc anvilBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithAnvil), 1)
  args.player.openHandledScreen(anvilScreenFactory(), some(args.position))
  barSuccess

proc anvilBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let f = gAnvilFallingBlock.placedImpl
  f(args)

proc anvilBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let dir = args.player.getHorizontalFacing().rotateClockwise()
  var props = WallTorchLikeProperties.defaultFor(args.block0)
  props.facing = dir
  props.toStateId(args.block0)

proc anvilBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let f = gAnvilFallingBlock.onScheduledTickImpl
  f(args)

proc anvilBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let f = gAnvilFallingBlock.getStateForNeighborUpdateImpl
  f(args)

proc newAnvilBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = anvilBlockNormalUse_BlockBehaviour
  result.placedImpl = anvilBlockPlaced_BlockBehaviour
  result.onPlaceImpl = anvilBlockOnPlace_BlockBehaviour
  result.onScheduledTickImpl = anvilBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = anvilBlockGetStateForNeighborUpdate_BlockBehaviour

proc registerBlocksAnvil*(r: BlockRegistry) =
  r.registerTag("minecraft:anvil", newAnvilBlock())
