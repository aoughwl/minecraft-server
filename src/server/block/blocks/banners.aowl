## Port of pumpkin/src/block/blocks/banners.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/banner


type
  BannerBlock* = object



proc bannerBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc bannerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc bannerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bannerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc bannerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newBannerBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool

proc bannerBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newBannerBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc bannerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = WhiteBannerLikeProperties.defaultFor(args.block0)
  props.rotation = args.player.getEntity().getFlippedRotation16()
  props.toStateId(args.block0)

proc bannerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc bannerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc bannerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc newBannerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = bannerBlockPlaced_BlockBehaviour
  result.onPlaceImpl = bannerBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = bannerBlockCanPlaceAt_BlockBehaviour
  result.onScheduledTickImpl = bannerBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bannerBlockGetStateForNeighborUpdate_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool =
  let state = world.getBlockState(position.down())
  state.isSolid()

proc registerBlocksBanners*(r: BlockRegistry) =
  r.registerTag("minecraft:banners", newBannerBlock())

