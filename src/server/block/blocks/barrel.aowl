## Port of pumpkin/src/block/blocks/barrel.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/[genericcontainer, player_inventory]
import ../../../generated/translation
import ../entities/barrel

proc barrelBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = BarrelLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getFacing().opposite()
  props.toStateId(args.block0)

proc barrelScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `BarrelScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_BARREL, BEDROCK_CONTAINER_BARREL),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createGeneric9x3(syncId, playerInventory, inventory)))

proc barrelBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  args.player.incrementStat(scCustom, int32(csOpenBarrel), 1)
  args.player.openHandledScreen(barrelScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc barrelBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newBarrelBlockEntity(args.position))

proc barrelBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return none[uint8]()
  some(calculateComparatorOutput(inventory.unsafeGet))

proc newBarrelBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = barrelBlockOnPlace_BlockBehaviour
  result.normalUseImpl = barrelBlockNormalUse_BlockBehaviour
  result.placedImpl = barrelBlockPlaced_BlockBehaviour
  result.getComparatorOutputImpl = barrelBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksBarrel*(r: BlockRegistry) =
  r.register("minecraft:barrel", newBarrelBlock())
