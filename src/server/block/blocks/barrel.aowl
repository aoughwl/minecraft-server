proc createScreenHandler*(self: BarrelScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = createGeneric9x3(syncId, playerInventory, self[0])
  let concreteArc = handler
