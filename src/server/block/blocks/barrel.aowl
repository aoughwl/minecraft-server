proc getDisplayName*(self: BarrelScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_BARREL, CONTAINER_BARREL, [])

proc barrelBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = BarrelLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getEntity().getFacing().opposite()
  props.toStateId(args.block0)

proc barrelBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        args.player.incrementStat(scCustom, int32(csOpenBarrel), 1)
        args.player.openHandledScreen(BarrelScreenFactory(t2.unsafeGet), some(args.position))
  barSuccess

proc barrelBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let barrelBlockEntity = newBarrelBlockEntity(args.position)
  args.world.addBlockEntity(barrelBlockEntity)

