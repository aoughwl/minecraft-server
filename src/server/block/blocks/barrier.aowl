## Port of pumpkin/src/block/blocks/barrier.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  BarrierBlock* = object



proc barrierBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc barrierBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newBarrierBlock*(): BlockBehaviour

proc barrierBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = BarrierLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  props.toStateId(args.block0)

proc barrierBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let props = BarrierLikeProperties.fromStateId(args.stateId, args.block0)
  if props.waterlogged:
    args.world.scheduleFluidTick(Fluid.WATER, args.position, uint8(Fluid.WATER.flowSpeed), tpNormal)
  props.toStateId(args.block0)

proc newBarrierBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = barrierBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = barrierBlockGetStateForNeighborUpdate_BlockBehaviour

proc registerBlocksBarrier*(r: BlockRegistry) =
  r.register("minecraft:barrier", newBarrierBlock())

