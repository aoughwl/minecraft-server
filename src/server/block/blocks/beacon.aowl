{.feature: "lenientnils".}

import ../blockprelude


type
  BeaconScreenFactory* = R2A_MANUAL_tuple_struct
  BeaconBlock* = object



proc createScreenHandler*(self: BeaconScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: BeaconScreenFactory): TextComponent
proc beaconBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc newBeaconBlock*(): BlockBehaviour

proc createScreenHandler*(self: BeaconScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  # Assumes create_beacon_handler exists in your generic_container_screen_handler equivalent
  let concreteHandler = createBeaconHandler(syncId, playerInventory, self[0])
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: BeaconScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_BEACON, CONTAINER_BEACON, [])

proc beaconBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  # Extract the inventory from the entity
  let t1 = blockEntity.andThen(getInventory)
  if not (t1.isSome):
    return barFail
  let inventory = t1.unsafeGet
  args.player.incrementStat(scCustom, int32(csInteractWithBeacon), 1)
  # Open the screen using the factory
  args.player.openHandledScreen(BeaconScreenFactory(inventory), some(args.position))
  barSuccess

proc newBeaconBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = beaconBlockNormalUse_BlockBehaviour

proc registerBlocksBeacon*(r: BlockRegistry) =
  r.register("minecraft:beacon", newBeaconBlock())

