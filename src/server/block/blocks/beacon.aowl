## Port of pumpkin/src/block/blocks/beacon.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/beaconhandler

proc beaconScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `BeaconScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_BEACON, BEDROCK_CONTAINER_BEACON),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createBeaconHandler(syncId, playerInventory, inventory)))

proc beaconBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  # Extract the inventory from the entity
  if blockEntity.isNone:
    return barFail
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barFail
  args.player.incrementStat(scCustom, int32(csInteractWithBeacon), 1)
  # Open the screen using the factory
  args.player.openHandledScreen(beaconScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc newBeaconBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = beaconBlockNormalUse_BlockBehaviour

proc registerBlocksBeacon*(r: BlockRegistry) =
  r.register("minecraft:beacon", newBeaconBlock())
