## Port of pumpkin/src/block/blocks/bed.rs
## `world.entities` is `entitiesAtBox0`, asked for a box that holds every position `is_within_bounds` accepts and filtered
## on the entity's position; the entity type is told by its registry name. `Player::set_respawn_point`, `sleep`, the
## advancement and the statistic are `BlockPlayer` hooks (worldhooks.aowl). `Dimension::OVERWORLD` is the world's dimension name.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/translation
import ../entities/bed

let NO_SLEEP_NAMES: seq[string] = @["blaze", "bogged", "skeleton", "stray", "wither_skeleton", "breeze", "creaking", "creeper",
  "drowned", "endermite", "evoker", "giant", "guardian", "elder_guardian", "illusioner", "ocelot", "piglin", "piglin_brute",
  "pillager", "phantom", "ravager", "silverfish", "spider", "cave_spider", "vex", "vindicator", "warden", "witch", "wither",
  "zoglin", "zombie", "zombie_villager", "husk", "enderman", "zombified_piglin"]

type
  BedProperties = WhiteBedLikeProperties
  BedBlock* = object

proc say(player: BlockPlayer, key: string, bedrock: string, overlay: bool) =
  let sendRaw = player.sendSystemMessage0
  if sendRaw != nil:
    sendRaw(translateCross(key, bedrock), overlay)

proc canSleep*(world: BlockWorld): bool
proc entityPreventsSleep*(entity: BlockActor): bool
proc setOccupied*(occupied: bool, world: BlockWorld, blockRef: Block, blockPos: BlockPos, stateId: BlockStateId)

proc bedBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  if args.player != nil:
    let facing = getHorizontalFacing(BlockActor(args.player))
    return args.blockAccessor.getBlockState(args.position).replaceable() and
      args.blockAccessor.getBlockState(args.position.offset(facing.toOffset())).replaceable()
  false

proc bedBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs) =
  let t2 = args.entity.getLivingEntity()
  if t2.isSome:
    t2.unsafeGet.handleFallDamage(args.entity, args.fallDistance * 0.5'f32, 1.0'f32)

proc bedBlockUpdateEntityMovementAfterFallOn_BlockBehaviour(args: UpdateEntityMovementAfterFallOnArgs) =
  bounceEntityAfterFall(args.entity, 0.66)

proc bedBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var bedProps = BedProperties.defaultFor(args.block0)
  bedProps.facing = getHorizontalFacing(BlockActor(args.player))
  bedProps.part = BedPart.Foot
  bedProps.toStateId(args.block0)

proc bedBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let bedEntity = newBedBlockEntity(args.position)
  args.world.addBlockEntity(bedEntity)
  var bedHeadProps = BedProperties.defaultFor(args.block0)
  bedHeadProps.facing = BedProperties.fromStateId(args.stateId, args.block0).facing
  bedHeadProps.part = BedPart.Head
  let bedHeadPos = args.position.offset(bedHeadProps.facing.toOffset())
  discard args.world.setBlockState(bedHeadPos, bedHeadProps.toStateId(args.block0), (BfNotifyAll or BfSkipBlockAddedCallback))
  let bedHeadEntity = newBedBlockEntity(bedHeadPos)
  args.world.addBlockEntity(bedHeadEntity)

proc bedBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let bedProps = BedProperties.fromStateId(args.state.id, args.block0)
  let t3 = block:
    if (bedProps.part == BedPart.Head):
      args.position.offset(bedProps.facing.opposite().toOffset())
    else:
      args.position.offset(bedProps.facing.toOffset())
  let otherHalfPos = t3
  let neighborStateId = args.world.getBlockStateId(otherHalfPos)
  if Block.fromStateId(neighborStateId).id != args.block0.id:
    args.world.updateNeighbors(otherHalfPos, none[BlockDirection]())
    return
  let gamemodeOf = args.player.gamemode0
  let isCreative = gamemodeOf != nil and gamemodeOf() == GameMode.Creative
  let t4 = block:
    if (bedProps.part == BedPart.Foot) and (not isCreative):
      # Breaking foot in survival -> allow head to drop
      BfNotifyNeighbors
    else:
      # Breaking head OR creative mode -> skip drops
      (BfSkipDrops or BfNotifyNeighbors)
  let flags = t4
  discard args.world.breakBlock(otherHalfPos, args.player, flags)

proc bedBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if args.moved:
    return
  # If the block is being replaced with air (i.e., broken), the `broken` callback
  # will handle breaking the other half with the correct drop flags. Only handle it here
  # if the block is being replaced with something else (e.g., piston movement).
  let newStateId = args.world.getBlockStateId(args.position)
  let newBlock = Block.fromStateId(newStateId)
  if newBlock.id == blockAir().id:
    return
  let bedProps = BedProperties.fromStateId(args.oldStateId, args.block0)
  let t5 = block:
    if (bedProps.part == BedPart.Head):
      args.position.offset(bedProps.facing.opposite().toOffset())
    else:
      args.position.offset(bedProps.facing.toOffset())
  let otherHalfPos = t5
  let (otherBlock, otherState) = args.world.getBlockAndState(otherHalfPos)
  if otherBlock.id == args.block0.id:
    let otherProps = BedProperties.fromStateId(otherState.id, otherBlock)
    if (not (otherProps.part == bedProps.part)):
      discard args.world.breakBlock(otherHalfPos, nil, (BfSkipDrops or BfNotifyNeighbors))

proc bedBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  let bedProps = BedProperties.fromStateId(stateId, args.block0)
  let t6 = block:
    if (bedProps.part == BedPart.Head):
      (args.position, args.position.offset(bedProps.facing.opposite().toOffset()))
    else:
      (args.position.offset(bedProps.facing.toOffset()), args.position)
  let (bedHeadPos, bedFootPos) = t6
  # Explode if not in the overworld
  if args.world.dimensionName != "minecraft:overworld":
    discard args.world.breakBlock(bedHeadPos, nil, BfSkipDrops)
    discard args.world.breakBlock(bedFootPos, nil, BfSkipDrops)
    let explode = args.world.explode0
    if explode != nil:
      explode(bedHeadPos.toCenteredF64(), 5.0'f32)
    return barSuccessServer
  # Make sure the bed is not obstructed
  if args.world.getBlockState(bedHeadPos.up()).isSolid() or args.world.getBlockState(bedFootPos.up()).isSolid():
    say(args.player, JAVA_BLOCK_MINECRAFT_BED_OBSTRUCTED, JAVA_BLOCK_MINECRAFT_BED_OBSTRUCTED, true)
    return barSuccessServer
  # Make sure the bed is not occupied
  if bedProps.occupied:
    # TODO: Wake up villager
    say(args.player, JAVA_BLOCK_MINECRAFT_BED_OCCUPIED, BEDROCK_TILE_BED_OCCUPIED, true)
    return barSuccessServer
  # Make sure player is close enough
  let positionOf = args.player.block0Pos
  let playerPosition = positionOf()
  if (not playerPosition.isWithinBounds(bedHeadPos.toF64(), 3.0, 3.0, 3.0)) and
      (not playerPosition.isWithinBounds(bedFootPos.toF64(), 3.0, 3.0, 3.0)):
    say(args.player, JAVA_BLOCK_MINECRAFT_BED_TOO_FAR_AWAY, JAVA_BLOCK_MINECRAFT_BED_TOO_FAR_AWAY, true)
    return barSuccessServer
  # Set respawn point
  let yawf = args.player.yaw0
  let pitchf = args.player.pitch0
  let setRespawn = args.player.setRespawnPoint0
  if setRespawn != nil and setRespawn(bedHeadPos, yawf(), pitchf()):
    say(args.player, JAVA_BLOCK_MINECRAFT_SET_SPAWN, BEDROCK_TILE_BED_RESPAWNSET, false)
  # Make sure the time and weather allows sleep
  if not canSleep(args.world):
    say(args.player, JAVA_BLOCK_MINECRAFT_BED_NO_SLEEP, JAVA_BLOCK_MINECRAFT_BED_NO_SLEEP, true)
    return barSuccessServer
  # Make sure there are no monsters nearby
  let atBox = args.world.entitiesAtBox0
  if atBox != nil:
    let minX = float64(min(bedHeadPos.vec.x, bedFootPos.vec.x)) - 9.0
    let minZ = float64(min(bedHeadPos.vec.z, bedFootPos.vec.z)) - 9.0
    let maxX = float64(max(bedHeadPos.vec.x, bedFootPos.vec.x)) + 10.0
    let maxZ = float64(max(bedHeadPos.vec.z, bedFootPos.vec.z)) + 10.0
    let around = newBoundingBox(Vector3[float64](x: minX, y: float64(bedHeadPos.vec.y) - 6.0, z: minZ),
      Vector3[float64](x: maxX, y: float64(bedHeadPos.vec.y) + 7.0, z: maxZ))
    for entity in atBox(around):
      if not entityPreventsSleep(entity):
        continue
      let entityPos = entity.block0Pos
      let pos = entityPos()
      if pos.isWithinBounds(bedHeadPos.toF64(), 8.0, 5.0, 8.0) or pos.isWithinBounds(bedFootPos.toF64(), 8.0, 5.0, 8.0):
        say(args.player, JAVA_BLOCK_MINECRAFT_BED_NOT_SAFE, JAVA_BLOCK_MINECRAFT_BED_NOT_SAFE, true)
        return barSuccessServer
  let sleepf = args.player.sleep0
  if sleepf != nil:
    sleepf(bedHeadPos)
  let advance = args.player.triggerAdvancement0
  if advance != nil:
    advance("SleptInBed", "")
  args.player.incrementStat(scCustom, int32(csSleepInBed), 1)
  setOccupied(true, args.world, args.block0, args.position, stateId)
  barSuccessServer

proc newBedBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = bedBlockCanPlaceAt_BlockBehaviour
  result.onLandedUponImpl = bedBlockOnLandedUpon_BlockBehaviour
  result.updateEntityMovementAfterFallOnImpl = bedBlockUpdateEntityMovementAfterFallOn_BlockBehaviour
  result.onPlaceImpl = bedBlockOnPlace_BlockBehaviour
  result.placedImpl = bedBlockPlaced_BlockBehaviour
  result.brokenImpl = bedBlockBroken_BlockBehaviour
  result.onStateReplacedImpl = bedBlockOnStateReplaced_BlockBehaviour
  result.normalUseImpl = bedBlockNormalUse_BlockBehaviour

proc setOccupied*(occupied: bool, world: BlockWorld, blockRef: Block, blockPos: BlockPos, stateId: BlockStateId) =
  var bedProps = BedProperties.fromStateId(stateId, blockRef)
  bedProps.occupied = occupied
  discard world.setBlockState(blockPos, bedProps.toStateId(blockRef), BfNotifyListeners)
  let t7 = block:
    if (bedProps.part == BedPart.Head):
      blockPos.offset(bedProps.facing.opposite().toOffset())
    else:
      blockPos.offset(bedProps.facing.toOffset())
  let otherHalfPos = t7
  let t8 = block:
    if (bedProps.part == BedPart.Head):
      BedPart.Foot
    else:
      BedPart.Head
  bedProps.part = t8
  discard world.setBlockState(otherHalfPos, bedProps.toStateId(blockRef), BfNotifyListeners)

proc canSleep*(world: BlockWorld): bool =
  let timeOf = world.timeOfDay0
  let rain = world.isRaining0
  let thunder = world.isThundering0
  let timeOfDay = if timeOf != nil: timeOf() else: 0'i64
  if thunder != nil and thunder():
    true
  elif rain != nil and rain():
    timeOfDay > 12010'i64 and timeOfDay < 23991'i64
  else:
    timeOfDay > 12542'i64 and timeOfDay < 23459'i64

proc entityPreventsSleep*(entity: BlockActor): bool =
  NO_SLEEP_NAMES.contains(entity.entityTypeName)

proc registerBlocksBed*(r: BlockRegistry) =
  r.registerTag("minecraft:beds", newBedBlock())

