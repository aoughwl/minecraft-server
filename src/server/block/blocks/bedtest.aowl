## bed.rs and entities/bed.rs over a `TestWorld`: placement of both halves, the other half going when one does, and every
## answer of `normal_use` in the order upstream checks them: not the overworld, obstructed, occupied, too far, respawn point,
## time and weather, monsters nearby, then sleep. Known answers are worked out from the Rust.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude
import ../testworld
import ../entities/[entitiesmod, bed]
import bed

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksBed(result)
  check(result.unknown.len == 0, "every registered name resolves")

type Log = ref object
  messages: seq[(string, bool)]
  slept: seq[BlockPos]
  advancements: seq[string]
  stats: seq[string]
  respawns: seq[BlockPos]
  exploded: seq[Vector3[float64]]
  respawnSet: bool

proc newPlayer(log: Log; pos: Vector3[float64]; yaw: float32; creative = false): BlockPlayer =
  let p = BlockPlayer()
  p.entityUuid = "p1"
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p.pitch0 = proc(): float32 {.closure.} = 0.0'f32
  p.block0Pos = proc(): Vector3[float64] {.closure.} = pos
  p.gamemode0 = proc(): GameMode {.closure.} = (if creative: GameMode.Creative else: GameMode.Survival)
  p.sendSystemMessage0 = proc(message: TextComponent; overlay: bool) {.closure.} = log.messages.add((message.base.content.translate, overlay))
  p.setRespawnPoint0 = proc(position: BlockPos; yaw, pitch: float32): bool {.closure.} =
    log.respawns.add(position)
    log.respawnSet
  p.sleep0 = proc(position: BlockPos) {.closure.} = log.slept.add(position)
  p.triggerAdvancement0 = proc(trigger, argument: string) {.closure.} = log.advancements.add(trigger)
  p.incrementStat0 = proc(stat: string; amount: int32) {.closure.} = log.stats.add(stat)
  p

proc facingOf(id: BlockStateId): HorizontalFacing = WhiteBedLikeProperties.fromStateId(id, blockWhiteBed()).facing
proc partOf(id: BlockStateId): BedPart = WhiteBedLikeProperties.fromStateId(id, blockWhiteBed()).part
proc occupiedOf(id: BlockStateId): bool = WhiteBedLikeProperties.fromStateId(id, blockWhiteBed()).occupied

proc placeBed(t: TestWorld; pos: BlockPos; player: BlockPlayer): BlockStateId =
  ## `place_block`'s part for a bed: the state from `on_place`, written with the callbacks.
  let id = t.world.blockRegistry.onPlace(BlockServer(), t.world, player, blockWhiteBed(), pos, BlockDirection.Up,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())
  discard t.world.setBlockState(pos, id, BfNotifyAll)
  id

proc setup(night: bool; overworld = true): (TestWorld, Log, BlockPos, BlockPos) =
  let t = newTestWorld(newRegistry())
  let log = Log()
  t.world.timeOfDay0 = proc(): int64 {.closure.} = (if night: 13000'i64 else: 1000'i64)
  t.world.isRaining0 = proc(): bool {.closure.} = false
  t.world.isThundering0 = proc(): bool {.closure.} = false
  if not overworld:
    t.world.dimensionName = "minecraft:the_nether"
  t.world.explode0 = proc(position: Vector3[float64]; power: float32) {.closure.} = log.exploded.add(position)
  t.world.entitiesAtBox0 = proc(box: BoundingBox): seq[BlockActor] {.closure.} = @[]
  # A bed whose foot is at (0,64,0) and head to the south: a player looking south (yaw 0) places it facing south.
  let foot = blockPos(0'i32, 64'i32, 0'i32)
  let head = blockPos(0'i32, 64'i32, 1'i32)
  t.put(blockPos(0'i32, 63'i32, 0'i32), blockStone())
  t.put(blockPos(0'i32, 63'i32, 1'i32), blockStone())
  let player = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
  discard t.placeBed(foot, player)
  (t, log, foot, head)

proc use(t: TestWorld; pos: BlockPos; player: BlockPlayer): BlockActionResult =
  let hit = BlockHitResult(face: BlockDirection.Up, cursorPos: Vector3[float32](x: 0.5, y: 0.5, z: 0.5))
  let id = t.world.getBlockStateId(pos)
  t.world.blockRegistry.onUse(Block.fromStateId(id), player, pos, hit, BlockServer(), t.world)

block entityIsTrivial:
  let e = newBedBlockEntity(blockPos(1'i32, 2'i32, 3'i32))
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.isEmpty(), "a bed saves nothing")
  check(BlockEntity(e).resourceLocation() == "minecraft:bed", "resource location")
  check(BlockEntity(e).getPosition() == blockPos(1'i32, 2'i32, 3'i32), "position")
  var empty = newCompound()
  check(bedBlockEntityFromNbt_BlockEntity(empty, blockPos(4'i32, 5'i32, 6'i32)).position == blockPos(4'i32, 5'i32, 6'i32), "from nbt")

block placementMakesBothHalves:
  let (t, log, foot, head) = setup(true)
  let footId = t.world.getBlockStateId(foot)
  let headId = t.world.getBlockStateId(head)
  check(Block.fromStateId(footId).id == blockWhiteBed().id, "the foot is a bed")
  check(partOf(footId) == BedPart.Foot and facingOf(footId) == HorizontalFacing.South, "foot facing south")
  check(partOf(headId) == BedPart.Head and facingOf(headId) == HorizontalFacing.South, "the head is one block south")
  check(t.world.getBlockEntity(foot).isSome and t.world.getBlockEntity(head).isSome, "both halves have an entity")

block canPlaceNeedsRoomForTheHead:
  let (t, log, foot, head) = setup(true)
  let t2 = newTestWorld(newRegistry())
  let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
  let ok = t2.world.blockRegistry.canPlaceAt(nil, nil, t2.world, p, blockWhiteBed(), BlockState.fromId(blockWhiteBed().defaultState.id), foot, none[BlockDirection](), none[SUseItemOn]())
  check(ok, "free air for both halves")
  t2.put(head, blockStone())
  let blocked = t2.world.blockRegistry.canPlaceAt(nil, nil, t2.world, p, blockWhiteBed(), BlockState.fromId(blockWhiteBed().defaultState.id), foot, none[BlockDirection](), none[SUseItemOn]())
  check(not blocked, "stone where the head goes")
  let noPlayer = t2.world.blockRegistry.canPlaceAt(nil, nil, t2.world, nil, blockWhiteBed(), BlockState.fromId(blockWhiteBed().defaultState.id), foot, none[BlockDirection](), none[SUseItemOn]())
  check(not noPlayer, "no player, no placement")

block breakingOneHalfBreaksTheOther:
  let (t, log, foot, head) = setup(true)
  let survivor = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
  # Breaking the head (what `broken` runs after the block is gone).
  discard t.world.setBlockState(head, blockStateIdAir, BfNotifyAll)
  t.world.blockRegistry.broken(blockWhiteBed(), survivor, head, BlockServer(), t.world, BlockState.fromId(blockWhiteBed().defaultState.id))
  check(t.world.getBlockStateId(foot) == blockStateIdAir, "the foot goes with the head")

block everythingNormalUseChecks:
  # Not the overworld: both halves go and it explodes at the head.
  block:
    let (t, log, foot, head) = setup(true, overworld = false)
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    check(t.use(head, p) == barSuccessServer, "handled")
    check(t.world.getBlockStateId(head) == blockStateIdAir and t.world.getBlockStateId(foot) == blockStateIdAir, "both halves broken")
    check(log.exploded.len == 1 and log.exploded[0].x == 0.5 and log.exploded[0].y == 64.5 and log.exploded[0].z == 1.5, "explodes at the head's centre")
    check(log.slept.len == 0, "nobody sleeps")
  # Obstructed.
  block:
    let (t, log, foot, head) = setup(true)
    t.put(blockPos(0'i32, 65'i32, 1'i32), blockStone())
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    check(t.use(foot, p) == barSuccessServer, "handled")
    check(log.messages.len == 1 and log.messages[0][1], "an overlay message")
    check(log.slept.len == 0 and log.respawns.len == 0, "nothing else happens")
  # Occupied.
  block:
    let (t, log, foot, head) = setup(true)
    var props = WhiteBedLikeProperties.fromStateId(t.world.getBlockStateId(head), blockWhiteBed())
    props.occupied = true
    t.put(head, props.toStateId(blockWhiteBed()))
    props = WhiteBedLikeProperties.fromStateId(t.world.getBlockStateId(foot), blockWhiteBed())
    props.occupied = true
    t.put(foot, props.toStateId(blockWhiteBed()))
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    discard t.use(foot, p)
    check(log.messages.len == 1 and log.messages[0][1] and log.slept.len == 0, "occupied")
  # Too far away.
  block:
    let (t, log, foot, head) = setup(true)
    let p = newPlayer(log, Vector3[float64](x: 20.5, y: 64.0, z: 0.5), 0.0'f32)
    discard t.use(foot, p)
    check(log.messages.len == 1 and log.respawns.len == 0 and log.slept.len == 0, "too far to sleep or set a spawn")
  # Day: the respawn point is set and told about, then the player cannot sleep.
  block:
    let (t, log, foot, head) = setup(false)
    log.respawnSet = true
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    check(t.use(foot, p) == barSuccessServer, "handled")
    check(log.respawns.len == 1 and log.respawns[0] == head, "the respawn point is the head")
    check(log.messages.len == 2 and not log.messages[0][1] and log.messages[1][1], "set-spawn message, then the overlay no-sleep one")
    check(log.slept.len == 0, "not asleep by day")
  # Rain moves the window; thunder opens it all day.
  block:
    let (t, log, foot, head) = setup(false)
    t.world.isThundering0 = proc(): bool {.closure.} = true
    check(canSleep(t.world), "thunder allows sleep by day")
    t.world.isThundering0 = proc(): bool {.closure.} = false
    t.world.isRaining0 = proc(): bool {.closure.} = true
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 12011'i64
    check(canSleep(t.world), "rain at 12011")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 12010'i64
    check(not canSleep(t.world), "not at 12010")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 23990'i64
    check(canSleep(t.world), "rain at 23990")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 23991'i64
    check(not canSleep(t.world), "not at 23991")
    t.world.isRaining0 = proc(): bool {.closure.} = false
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 12543'i64
    check(canSleep(t.world), "clear at 12543")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 12542'i64
    check(not canSleep(t.world), "not at 12542")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 23458'i64
    check(canSleep(t.world), "clear at 23458")
    t.world.timeOfDay0 = proc(): int64 {.closure.} = 23459'i64
    check(not canSleep(t.world), "not at 23459")
  # A zombie nearby stops it; a cow does not; a zombie out of range does not.
  block:
    let (t, log, foot, head) = setup(true)
    let zombie = BlockActor(entityTypeName: "zombie")
    zombie.block0Pos = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 7.5, y: 64.0, z: 1.5)
    let cow = BlockActor(entityTypeName: "cow")
    cow.block0Pos = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 1.5, y: 64.0, z: 1.5)
    t.world.entitiesAtBox0 = proc(box: BoundingBox): seq[BlockActor] {.closure.} = @[cow, zombie]
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    discard t.use(foot, p)
    check(log.messages.len == 1 and log.messages[0][1] and log.slept.len == 0, "7 blocks away is within 8")
  block:
    let (t, log, foot, head) = setup(true)
    let far = BlockActor(entityTypeName: "zombie")
    far.block0Pos = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 9.6, y: 64.0, z: 1.5)
    let cow = BlockActor(entityTypeName: "cow")
    cow.block0Pos = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 1.5, y: 64.0, z: 1.5)
    t.world.entitiesAtBox0 = proc(box: BoundingBox): seq[BlockActor] {.closure.} = @[cow, far]
    let p = newPlayer(log, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    check(t.use(foot, p) == barSuccessServer, "handled")
    check(log.slept.len == 1 and log.slept[0] == head, "the player sleeps at the head")
    check(log.advancements.len == 1 and log.advancements[0] == "SleptInBed", "the advancement")
    check(log.stats.len == 1, "the statistic")
    check(occupiedOf(t.world.getBlockStateId(head)) and occupiedOf(t.world.getBlockStateId(foot)), "both halves are occupied")
    # A second player is told it is occupied.
    let log2 = Log()
    let p2 = newPlayer(log2, Vector3[float64](x: 0.5, y: 64.0, z: 0.5), 0.0'f32)
    discard t.use(head, p2)
    check(log2.slept.len == 0 and log2.messages.len == 1, "occupied for the next one")

echo "bed ok"
