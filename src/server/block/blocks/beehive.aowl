## Port of pumpkin/src/block/blocks/beehive.rs
{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


proc beehiveBlockIds*(): seq[BlockId] =
  @[blockIdBeehive, blockIdBeeNest]

proc beehiveBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let stateId = args.world.getBlockStateId(args.position)
  let props = BeeNestLikeProperties.fromStateId(stateId, args.block0)
  some(props.honeyLevel)

proc newBeehiveBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.getComparatorOutputImpl = beehiveBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksBeehive*(r: BlockRegistry) =
  r.registerIds(beehiveBlockIds(), newBeehiveBlock())

