## Port of pumpkin/src/block/blocks/blast_furnace.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property
import ../../../inventory/furnace_like_screen_handler
import ../../../generated/[translation, screen]
import ../entities/blasting_furnace

proc blastFurnaceBlockScreenFactory(inventory: Inventory; propertyDelegate: PropertyDelegate;
    experienceContainer: ExperienceContainer): BlockScreenFactory =
  ## `BlastFurnaceScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_BLAST_FURNACE, BEDROCK_TILE_BLAST_FURNACE_NAME),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(newFurnaceLikeScreenHandler(syncId, playerInventory, inventory, propertyDelegate, experienceContainer,
        wtBlastFurnace)))

proc blastFurnaceBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barConsume
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barConsume
  let propertyDelegate = blockEntity.unsafeGet.toPropertyDelegate()
  if propertyDelegate.isNone:
    return barConsume
  let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
  if experienceContainer.isNone:
    return barConsume
  args.player.incrementStat(scCustom, int32(csInteractWithBlastFurnace), 1)
  args.player.openHandledScreen(blastFurnaceBlockScreenFactory(inventory.unsafeGet, propertyDelegate.unsafeGet,
    experienceContainer.unsafeGet), some(args.position))
  barConsume

proc blastFurnaceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc blastFurnaceBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newBlastingFurnaceBlockEntity(args.position))

proc blastFurnaceBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
    if experienceContainer.isSome:
      let xp = experienceContainer.unsafeGet.extractExperience()
      if xp > 0:
        args.world.spawnExperienceOrb(args.position.toF64(), uint32(xp))
  args.world.removeBlockEntity(args.position)

proc blastFurnaceBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let inventory = blockEntity.unsafeGet.getInventory()
    if inventory.isSome:
      return some(calculateComparatorOutput(inventory.unsafeGet))
  none[uint8]()

proc newBlastFurnaceBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = blastFurnaceBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = blastFurnaceBlockOnPlace_BlockBehaviour
  result.placedImpl = blastFurnaceBlockPlaced_BlockBehaviour
  result.brokenImpl = blastFurnaceBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = blastFurnaceBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksBlastFurnace*(r: BlockRegistry) =
  r.register("minecraft:blast_furnace", newBlastFurnaceBlock())
