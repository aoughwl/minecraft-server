proc newBlastingFurnaceScreenFactory*(inventory: Inventory, propertyDelegate: PropertyDelegate, experienceContainer: ExperienceContainer): BlastingFurnaceScreenFactory =
  BlastingFurnaceScreenFactory(inventory: inventory, propertyDelegate: propertyDelegate, experienceContainer: experienceContainer)

proc createScreenHandler*(self: BlastingFurnaceScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let concreteHandler = newFurnaceLikeScreenHandler(syncId, playerInventory, self.inventory, self.propertyDelegate, self.experienceContainer, WindowType.BlastFurnace)
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: BlastingFurnaceScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_BLAST_FURNACE, TILE_BLAST_FURNACE_NAME, [])

proc blastFurnaceBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain5:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        let t3 = t1.unsafeGet.toPropertyDelegate()
        if t3.isSome:
          let propertyDelegate = t3.unsafeGet
          let t4 = t1.unsafeGet.toExperienceContainer()
          if t4.isSome:
            let experienceContainer = t4.unsafeGet
            args.player.incrementStat(scCustom, int32(csInteractWithBlastFurnace), 1)
            let blastingFurnaceScreenFactory = newBlastingFurnaceScreenFactory(t2.unsafeGet, t3.unsafeGet, t4.unsafeGet)
            args.player.openHandledScreen(blastingFurnaceScreenFactory, some(args.position))
  barConsume

proc blastFurnaceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc blastFurnaceBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blastingFurnaceBlockEntity = newBlastingFurnaceBlockEntity(args.position)
  args.world.addBlockEntity(blastingFurnaceBlockEntity)

proc blastFurnaceBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  block chain8:
    let t6 = args.world.getBlockEntity(args.position)
    if t6.isSome:
      let blockEntity = t6.unsafeGet
      let t7 = t6.unsafeGet.toExperienceContainer()
      if t7.isSome:
        let experienceContainer = t7.unsafeGet
        let xp = t7.unsafeGet.extractExperience()
        if (xp > 0):
          let pos = args.position.toF64()
          ExperienceOrbEntity.spawn(args.world, pos, uint32(xp))
  args.world.removeBlockEntity(args.position)

