proc createScreenHandler*(self: BrewingScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let inventory = self[0]
  let propertyDelegate = self[1]
  let pi = playerInventory
  let t1 = block:
    # Delegate to pumpkin-inventory brewing creator
    let t2 = createBrewing(syncId, pi, inventory, propertyDelegate)
    var t3 = none[SharedScreenHandler]()
    if t2.isSome:
      let handler = t2.unsafeGet
      t3 = some(SharedScreenHandler(handler))
    t3
  t1

proc getDisplayName*(self: BrewingScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_BREWING, CONTAINER_BREWING, [])

proc brewingStandBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain7:
    let t4 = args.world.getBlockEntity(args.position)
    if t4.isSome:
      let blockEntity = t4.unsafeGet
      let t5 = t4.unsafeGet.getInventory()
      if t5.isSome:
        let inventory = t5.unsafeGet
        let t6 = t4.unsafeGet.toPropertyDelegate()
        if t6.isSome:
          let pd = t6.unsafeGet
          args.player.incrementStat(scCustom, int32(csInteractWithBrewingstand), 1)
          args.player.openHandledScreen(BrewingScreenFactory(t5.unsafeGet, t6.unsafeGet), some(args.position))
  barSuccess

proc brewingStandBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let be = newBrewingStandBlockEntity(args.position)
  args.world.addBlockEntity(be)

proc brewingStandBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain10:
    let t8 = args.world.getBlockEntity(args.position)
    if t8.isSome:
      let blockEntity = t8.unsafeGet
      let t9 = t8.unsafeGet.getInventory()
      if t9.isSome:
        let inventory = t9.unsafeGet
        var bottles = 0'u8
        # Bottle slots are 0, 1, 2 in brewing stands
        for slot in 0 ..< 3:
          let stack = t9.unsafeGet.getStack(slot)
          if (not isEmpty(stack)):
            bottles += 1
        some(bottles)
        break chain10
    none[uint8]()

