## Port of pumpkin/src/block/blocks/brewing_stand.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property
import ../../../inventory/brewing_screen_handler
import ../../../generated/translation
import ../entities/brewing_stand

proc brewingScreenFactory(inventory: Inventory; propertyDelegate: PropertyDelegate): BlockScreenFactory =
  ## `BrewingScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_BREWING, BEDROCK_CONTAINER_BREWING),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createBrewing(syncId, playerInventory, inventory, propertyDelegate)))

proc brewingStandBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  let pd = blockEntity.unsafeGet.toPropertyDelegate()
  if pd.isNone:
    return barSuccess
  args.player.incrementStat(scCustom, int32(csInteractWithBrewingstand), 1)
  args.player.openHandledScreen(brewingScreenFactory(inventory.unsafeGet, pd.unsafeGet), some(args.position))
  barSuccess

proc brewingStandBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let be = newBrewingStandBlockEntity(args.position)
  args.world.addBlockEntity(be)

proc brewingStandBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return none[uint8]()
  var bottles = 0'u8
  # Bottle slots are 0, 1, 2 in brewing stands
  for slot in 0 ..< 3:
    if not inventory.unsafeGet.getStack(slot).isEmpty():
      bottles += 1'u8
  some(bottles)

proc newBrewingStandBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = brewingStandBlockNormalUse_BlockBehaviour
  result.placedImpl = brewingStandBlockPlaced_BlockBehaviour
  result.getComparatorOutputImpl = brewingStandBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksBrewingStand*(r: BlockRegistry) =
  r.register("minecraft:brewing_stand", newBrewingStandBlock())
