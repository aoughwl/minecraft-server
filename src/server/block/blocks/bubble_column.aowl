## Port of pumpkin/src/block/blocks/bubble_column.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const CREATE_DELAY_TICKS: uint8 = 20
const REMOVE_DELAY_TICKS: uint8 = 5
const UPWARD_ACCELERATION: float64 = 0.06
const UPWARD_MAX_SPEED: float64 = 0.7
const SURFACE_UPWARD_ACCELERATION: float64 = 0.1
const SURFACE_UPWARD_MAX_SPEED: float64 = 1.8
const DOWNWARD_ACCELERATION: float64 = (-0.03)
const DOWNWARD_MIN_SPEED: float64 = (-0.3)

type
  BubbleColumnBlock* = object
  BubbleColumnKind* {.pure.} = enum
    Upward
    Downward
  ReconcileActionKind* {.pure.} = enum
    kSetBubble
    kRestoreWater
    kStop
  ReconcileAction* = object
    kind*: ReconcileActionKind
    f0SetBubble*: BubbleColumnKind



proc bubbleColumnBlockIds*(): seq[BlockId]
proc sourceWaterState*(): BlockStateId
proc bubbleColumnState*(kind: BubbleColumnKind): BlockStateId
proc kindFromSupport*(blockRef: Block): Option[BubbleColumnKind]
proc kindFromState*(state: BlockStateId): BubbleColumnKind
proc kindFromBelow*(blockRef: Block, state: BlockStateId): Option[BubbleColumnKind]
proc isSourceWaterState*(state: BlockStateId): bool
proc isSourceWater*(world: BlockWorld, position: BlockPos): bool
proc reconcileAction*(currentBlock: Block, currentState: BlockStateId, belowBlock: Block, belowState: BlockStateId): ReconcileAction
proc scheduleReconcile*(world: BlockWorld, position: BlockPos, delay: uint8)
proc bubbleColumnVerticalVelocity*(currentY: float64, kind: BubbleColumnKind, atSurface: bool): float64
proc bubbleColumnVelocity*(current: Vector3[float64], kind: BubbleColumnKind, atSurface: bool): Vector3[float64]
proc bubbleColumnBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc bubbleColumnBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc bubbleColumnBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc bubbleColumnBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newBubbleColumnBlock*(): BlockBehaviour

proc bubbleColumnBlockIds*(): seq[BlockId] =
  @[blockIdBubbleColumn, blockIdWater]

proc sourceWaterState*(): BlockStateId =
  Fluid.WATER.states.find(R2A_MANUAL("closure |state| (state.isStill and state.isSource)")).get().blockStateId

proc bubbleColumnState*(kind: BubbleColumnKind): BlockStateId =
  BubbleColumnLikeProperties(drag: (kind == BubbleColumnKind.Downward)).toStateId(blockBubbleColumn())

proc kindFromSupport*(blockRef: Block): Option[BubbleColumnKind] =
  if blockRef.hasTag(Block_MINECRAFT_ENABLES_BUBBLE_COLUMN_PUSH_UP):
    some(BubbleColumnKind.Upward)
  elif blockRef.hasTag(Block_MINECRAFT_ENABLES_BUBBLE_COLUMN_DRAG_DOWN):
    some(BubbleColumnKind.Downward)
  else:
    none[BubbleColumnKind]()

proc kindFromState*(state: BlockStateId): BubbleColumnKind =
  let props = BubbleColumnLikeProperties.fromStateId(state, blockBubbleColumn())
  if props.drag:
    BubbleColumnKind.Downward
  else:
    BubbleColumnKind.Upward

proc kindFromBelow*(blockRef: Block, state: BlockStateId): Option[BubbleColumnKind] =
  if (blockRef == blockBubbleColumn()):
    some(kindFromState(state))
  else:
    kindFromSupport(blockRef)

proc isSourceWaterState*(state: BlockStateId): bool =
  let t3 = Fluid.fromStateId(state)
  if not (t3.isSome):
    return false
  let fluid = t3.unsafeGet
  var t6 = false
  for fluidState in fluid.states:
    let t4 = block:
      (((fluidState.blockStateId == state) and fluidState.isStill) and fluidState.isSource)
    if t4:
      t6 = true
      break
  ((fluid.hasTag(Fluid_MINECRAFT_BUBBLE_COLUMN_CAN_OCCUPY) and fluid.isSource(state)) and t6)

proc isSourceWater*(world: BlockWorld, position: BlockPos): bool =
  isSourceWaterState(world.getBlockStateId(position))

proc reconcileAction*(currentBlock: Block, currentState: BlockStateId, belowBlock: Block, belowState: BlockStateId): ReconcileAction =
  let currentIsBubble = (currentBlock == blockBubbleColumn())
  let currentIsSourceWater = isSourceWaterState(currentState)
  let t7 = kindFromBelow(belowBlock, belowState)
  if t7.isSome and ((currentIsBubble or currentIsSourceWater)):
    let kind = t7.unsafeGet
    return ReconcileAction(kind: ReconcileActionKind.kSetBubble, f0SetBubble: t7.unsafeGet)
  if currentIsBubble:
    ReconcileAction(kind: ReconcileActionKind.kRestoreWater)
  else:
    ReconcileAction(kind: ReconcileActionKind.kStop)

proc scheduleReconcile*(world: BlockWorld, position: BlockPos, delay: uint8) =
  world.scheduleBlockTick(blockBubbleColumn(), position, delay, tpNormal)

proc bubbleColumnVerticalVelocity*(currentY: float64, kind: BubbleColumnKind, atSurface: bool): float64 =
  let t8 = (kind, atSurface)
  if t8[0] == BubbleColumnKind.Upward:
    let true = t8[1]
    ((currentY + SURFACE_UPWARD_ACCELERATION)).min(SURFACE_UPWARD_MAX_SPEED)
  elif t8[0] == BubbleColumnKind.Upward:
    let false = t8[1]
    ((currentY + UPWARD_ACCELERATION)).min(UPWARD_MAX_SPEED)
  elif t8[0] == BubbleColumnKind.Downward:
    ((currentY + DOWNWARD_ACCELERATION)).max(DOWNWARD_MIN_SPEED)
  else:
    rustPanic("non-exhaustive")

proc bubbleColumnVelocity*(current: Vector3[float64], kind: BubbleColumnKind, atSurface: bool): Vector3[float64] =
  newVector3(current.x, bubbleColumnVerticalVelocity(current.y, kind, atSurface), current.z)

proc bubbleColumnBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  if (args.block0 != blockBubbleColumn()):
    return
  let kind = kindFromState(args.state.id)
  let atSurface = (args.world.getBlock(args.position.up()) == blockAir())
  let entity = args.entity.getEntity()
  entity.velocity = bubbleColumnVelocity(entity.velocity, kind, atSurface)
  let t9 = args.entity.getPlayer()
  if t9.isSome:
    let player = t9.unsafeGet
    t9.unsafeGet.breathManager.reset(t9.unsafeGet)

proc bubbleColumnBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (args.block0 == blockWater()) and isSourceWater(args.world, args.position):
    scheduleReconcile(args.world, args.position, CREATE_DELAY_TICKS)

proc bubbleColumnBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockStateId(args.position)
  if (args.block0 == blockBubbleColumn()):
    scheduleReconcile(args.world, args.position, REMOVE_DELAY_TICKS)
  else:
    if (args.block0 == blockWater()) and isSourceWaterState(state) and (((args.sourceBlock == blockBubbleColumn()) or kindFromSupport(args.sourceBlock).isSome())):
      scheduleReconcile(args.world, args.position, CREATE_DELAY_TICKS)

proc bubbleColumnBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockStateId(args.position)
  let blockRef = Block.fromStateId(state)
  if (blockRef != blockBubbleColumn()) and (blockRef != blockWater()):
    return
  let belowPos = args.position.down()
  let belowState = args.world.getBlockStateId(belowPos)
  let belowBlock = Block.fromStateId(belowState)
  let t10 = reconcileAction(blockRef, state, belowBlock, belowState)
  if t10.kind == ReconcileActionKind.kSetBubble:
    let kind = t10.f0SetBubble
    let newState = bubbleColumnState(t10.f0SetBubble)
    discard args.world.setBlockState(args.position, newState, BfNotifyAll)
    scheduleReconcile(args.world, args.position.up(), CREATE_DELAY_TICKS)
  elif t10.kind == ReconcileActionKind.kRestoreWater:
    discard args.world.setBlockState(args.position, sourceWaterState(), BfNotifyAll)
    scheduleReconcile(args.world, args.position.up(), REMOVE_DELAY_TICKS)
  elif t10.kind == ReconcileActionKind.kStop:
    discard
  else:
    rustPanic("non-exhaustive")

proc newBubbleColumnBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = bubbleColumnBlockOnEntityCollision_BlockBehaviour
  result.placedImpl = bubbleColumnBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = bubbleColumnBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = bubbleColumnBlockOnScheduledTick_BlockBehaviour

proc registerBlocksBubbleColumn*(r: BlockRegistry) =
  r.registerIds(bubbleColumnBlockIds(), newBubbleColumnBlock())

