## banners.rs, skull_block.rs, wither_skull.rs, spawner.rs, end_portal_frame.rs and their block entities (banner, skull, mob_spawner)
## over a `TestWorld`: placement from the player's look, the entity each block adds, what each entity saves and reads back, the
## wither's pattern, and the spawner's tick. Known answers are worked out from the Rust.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio, strutils]
import ../blockprelude
import ../testworld
import ../entities/[entitiesmod, banner, skull, mob_spawner]
import banners, skull_block, wither_skull, spawner, end_portal_frame
import redstone/redstone_block

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksBanners(result)
  registerBlocksSkullBlock(result)
  registerBlocksWitherSkull(result)
  registerBlocksSpawner(result)
  registerBlocksEndPortalFrame(result)
  registerBlocksRedstoneRedstoneBlock(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc player(yaw: float32; flipped: uint8): BlockPlayer =
  let p = BlockPlayer()
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p.sneaking0 = proc(): bool {.closure.} = false
  p.flippedRotation160 = proc(): uint8 {.closure.} = flipped
  p

proc place(t: TestWorld; blockRef: Block; pos: BlockPos; p: BlockPlayer): BlockStateId =
  t.world.blockRegistry.onPlace(BlockServer(), t.world, p, blockRef, pos, BlockDirection.Up,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())

proc at(x, y, z: int32): BlockPos = blockPos(x, y, z)

proc bannerBlocks() =
  let t = newTestWorld(newRegistry())
  let pos = at(0'i32, 64'i32, 0'i32)
  let id = t.place(blockWhiteBanner(), pos, player(0.0'f32, 9'u8))
  check(WhiteBannerLikeProperties.fromStateId(id, blockWhiteBanner()).rotation == 9'u8, "rotation is the flipped 16")
  discard t.world.setBlockState(pos, id, BfNotifyAll)
  check(t.world.getBlockEntity(pos).isSome, "placing adds the entity")
  # Support: a solid block below.
  check(not canPlaceAt(t.world, pos), "air below")
  t.put(at(0'i32, 63'i32, 0'i32), blockStone())
  check(canPlaceAt(t.world, pos), "stone below")
  # The entity.
  let e = newBannerBlockEntity(pos)
  e.customName = some("Flag")
  var pats: seq[NbtTag] = @[]
  var pattern = newCompound()
  pattern.putString("pattern", "minecraft:creeper")
  pattern.putString("color", "red")
  pats.add(NbtTag(kind: ntkCompound, compoundVal: pattern))
  e.patterns = some(pats)
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.getString("CustomName").get("") == "Flag", "name saved")
  check(nbt.getList("patterns").unsafeGet.len == 1, "patterns saved")
  var again = nbt
  let loaded = bannerBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.customName.isSome and loaded.customName.unsafeGet == "Flag", "name read back")
  check(loaded.patterns.isSome and loaded.patterns.unsafeGet.len == 1, "patterns read back")
  var empty = newCompound()
  let plain = newBannerBlockEntity(pos)
  BlockEntity(plain).writeNbt(empty)
  check(empty.isEmpty(), "a plain banner saves nothing")
  check(BlockEntity(plain).resourceLocation() == "minecraft:banner", "resource location")
  # Support loss schedules a tick, which breaks the banner.
  t.put(at(0'i32, 63'i32, 0'i32), blockStateIdAir)
  let kept = t.world.blockRegistry.getStateForNeighborUpdate(t.world, blockWhiteBanner(), id, pos, BlockDirection.Down,
    at(0'i32, 63'i32, 0'i32), blockStateIdAir)
  check(kept == id, "the state is kept")
  check(t.world.isBlockTickScheduled0 != nil and t.world.isBlockTickScheduled0(pos, blockWhiteBanner()), "and a tick is asked for")
  t.step()
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "which breaks it")
  # Wall banners in the tag: count them.
  var walls = 0
  for bid in tagBlockIds(Block_MINECRAFT_BANNERS):
    if Block.fromId(bid).name.contains("wall"):
      walls += 1
  check(walls > 0, "the tag holds wall banners")
  # A wall banner is placed with the standing banner's properties upstream: see what that does.
  var wallBlock = blockWhiteBanner()
  for bid in tagBlockIds(Block_MINECRAFT_BANNERS):
    if Block.fromId(bid).name == "white_wall_banner":
      wallBlock = Block.fromId(bid)
  let wallId = t.place(wallBlock, pos, player(0.0'f32, 9'u8))
  check(Block.fromStateId(wallId).id == wallBlock.id, "a wall banner keeps its block")

proc skullBlocks() =
  let t = newTestWorld(newRegistry())
  let pos = at(0'i32, 64'i32, 0'i32)
  # get_flipped_rotation_16 = 9 means get_rotation_16 = 1.
  let id = t.place(blockSkeletonSkull(), pos, player(0.0'f32, 9'u8))
  var props = SkeletonSkullLikeProperties.fromStateId(id, blockSkeletonSkull())
  check(props.rotation == 1'u8, "rotation is the plain 16")
  check(not props.powered, "unpowered")
  discard t.world.setBlockState(pos, id, BfNotifyAll)
  check(t.world.getBlockEntity(pos).isSome, "an entity")
  # Power from a redstone block beside it, by the neighbour update.
  t.put(at(1'i32, 64'i32, 0'i32), blockRedstoneBlock())
  t.world.blockRegistry.onNeighborUpdate(t.world, blockSkeletonSkull(), pos, blockRedstoneBlock(), false)
  props = SkeletonSkullLikeProperties.fromStateId(t.world.getBlockStateId(pos), blockSkeletonSkull())
  check(props.powered, "powered by the block beside it")
  # The entity.
  let e = newSkullBlockEntity(pos)
  e.noteBlockSound = some("minecraft:entity.pig.ambient")
  var profile = newCompound()
  profile.putString("name", "Steve")
  e.profile = some(profile)
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.getString("note_block_sound").get("") == "minecraft:entity.pig.ambient", "sound saved")
  check(nbt.getCompound("profile").isSome, "profile saved")
  var again = nbt
  let loaded = skullBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.noteBlockSound.isSome and loaded.profile.unsafeGet.getString("name").get("") == "Steve", "read back")
  check(BlockEntity(e).chunkDataNbt().unsafeGet.has("profile"), "chunk data has the profile")
  check(BlockEntity(e).resourceLocation() == "minecraft:skull", "resource location")

proc witherPattern() =
  let t = newTestWorld(newRegistry())
  var spawned: seq[(string, Vector3[float64])] = @[]
  var events = 0
  t.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    spawned.add((entityType, position))
    BlockActor(entityTypeName: entityType)
  # Soul sand: base (0,63,0), middle (0,64,0), arms (1,64,0) and (-1,64,0); skulls above all three middle ones. The pattern
  # runs along x, i.e. in the `West` direction of the second loop.
  t.put(at(0'i32, 63'i32, 0'i32), blockSoulSand())
  t.put(at(0'i32, 64'i32, 0'i32), blockSoulSand())
  t.put(at(1'i32, 64'i32, 0'i32), blockSoulSand())
  t.put(at(-1'i32, 64'i32, 0'i32), blockSoulSand())
  t.put(at(1'i32, 65'i32, 0'i32), blockWitherSkeletonSkull())
  t.put(at(-1'i32, 65'i32, 0'i32), blockWitherSkeletonSkull())
  # The last skull placed completes it.
  let id = t.place(blockWitherSkeletonSkull(), at(0'i32, 65'i32, 0'i32), player(0.0'f32, 8'u8))
  discard t.world.setBlockState(at(0'i32, 65'i32, 0'i32), id, BfNotifyAll)
  check(spawned.len == 1 and spawned[0][0] == "wither", "a wither is spawned")
  check(spawned[0][1].x == 0.5 and spawned[0][1].y == 64.5 and spawned[0][1].z == 0.5, "at the middle block's centre")
  for p in [at(0'i32, 63'i32, 0'i32), at(0'i32, 64'i32, 0'i32), at(1'i32, 64'i32, 0'i32), at(-1'i32, 64'i32, 0'i32),
      at(0'i32, 65'i32, 0'i32), at(1'i32, 65'i32, 0'i32), at(-1'i32, 65'i32, 0'i32)]:
    check(t.world.getBlockStateId(p) == blockStateIdAir, "the pattern is gone")
  # An incomplete one does nothing.
  let u = newTestWorld(newRegistry())
  var count = 0
  u.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    count += 1
    nil
  u.put(at(0'i32, 64'i32, 0'i32), blockSoulSand())
  u.put(at(0'i32, 63'i32, 0'i32), blockSoulSand())
  discard u.world.setBlockState(at(0'i32, 65'i32, 0'i32), u.place(blockWitherSkeletonSkull(), at(0'i32, 65'i32, 0'i32), player(0.0'f32, 8'u8)), BfNotifyAll)
  check(count == 0, "no wither without the arms")

proc spawnerBlocks() =
  let t = newTestWorld(newRegistry())
  let pos = at(0'i32, 64'i32, 0'i32)
  discard t.world.setBlockState(pos, blockSpawner().defaultState.id, BfNotifyAll)
  let entity = t.world.getBlockEntity(pos)
  check(entity.isSome, "a spawner entity is added")
  let s = asType(entity.unsafeGet, MobSpawnerBlockEntity).unsafeGet
  check(s.delay == 20'i32 and s.minDelay == 200'i32 and s.maxDelay == 800'i32 and s.spawnCount == 4'i32 and s.spawnRange == 4'i32,
    "the default timings")
  check(s.entityType.isNone, "no type yet")
  # No type: nothing happens.
  BlockEntity(s).tick(t.world)
  check(s.delay == 20'i32, "a spawner with no type does not count down")
  # With a type it counts down, then spawns.
  s.setEntityType("zombie")
  var spawned = 0
  t.world.isSpaceEmpty0 = proc(box: BoundingBox): bool {.closure.} = true
  t.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    spawned += 1
    check(position.x >= 0.5 and position.x < 0.5 + 8.0, "spawned within range in x")
    check(position.z >= 0.5 and position.z < 0.5 + 8.0, "spawned within range in z")
    check(position.y >= 63.0 and position.y <= 65.0, "spawned within one block of the spawner's height")
    BlockActor(entityTypeName: entityType)
  BlockEntity(s).tick(t.world)
  check(s.delay == 19'i32 and spawned == 0, "counting down")
  s.delay = -1'i32
  BlockEntity(s).tick(t.world)
  check(spawned == 4, "spawn_count entities")
  check(s.delay >= 200'i32 and s.delay < 800'i32, "the next delay is between min and max")
  var queued = 0
  for e in t.events:
    if e == "synced 1 0":
      queued += 1
  check(queued == 2, "a synced event is queued once before the spawns (delay -1) and once after")
  # Blocked space spawns nothing.
  spawned = 0
  s.delay = -1'i32
  t.world.isSpaceEmpty0 = proc(box: BoundingBox): bool {.closure.} = false
  BlockEntity(s).tick(t.world)
  check(spawned == 0, "no room, no spawn")
  # NBT.
  var nbt = newCompound()
  BlockEntity(s).writeNbt(nbt)
  check(nbt.getString("id").get("") == "minecraft:mob_spawner", "id")
  check(nbt.getInt("y").get(0'i32) == 64'i32, "position")
  let data = nbt.getCompound("SpawnData").unsafeGet
  check(data.getCompound("entity").unsafeGet.getString("id").get("") == "minecraft:zombie", "spawn data names the type")
  check(BlockEntity(s).chunkDataNbt().unsafeGet.has("SpawnData"), "chunk data too")
  var again = nbt
  put(again, "Delay", NbtTag(kind: ntkShort, shortVal: 33'i16))
  let loaded = mobSpawnerBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.entityType.isSome and loaded.entityType.unsafeGet == "zombie", "type read back")
  check(loaded.delay == 33'i32, "delay read back")
  check(loaded.spawnRange == 4'i32, "defaults for the rest")
  var bare = newCompound()
  let fresh = mobSpawnerBlockEntityFromNbt_BlockEntity(bare, pos)
  check(fresh.entityType.isNone and fresh.delay == 20'i32, "an empty compound gives the defaults")
  var bad = newCompound()
  bad.putCompound("SpawnData", data)
  var unknown = newCompound()
  var entity2 = newCompound()
  entity2.putString("id", "minecraft:not_a_mob")
  unknown.putCompound("entity", entity2)
  var wrap = newCompound()
  wrap.putCompound("SpawnData", unknown)
  check(mobSpawnerBlockEntityFromNbt_BlockEntity(wrap, pos).entityType.isNone, "an unknown type is ignored")

proc endPortalFrame() =
  let t = newTestWorld(newRegistry())
  # Looking south (yaw 0), the frame faces north.
  let id = t.place(blockEndPortalFrame(), at(0'i32, 64'i32, 0'i32), player(0.0'f32, 8'u8))
  check(EndPortalFrameLikeProperties.fromStateId(id, blockEndPortalFrame()).facing == HorizontalFacing.North, "faces back at the player")
  let id2 = t.place(blockEndPortalFrame(), at(0'i32, 64'i32, 0'i32), player(90.0'f32, 8'u8))
  check(EndPortalFrameLikeProperties.fromStateId(id2, blockEndPortalFrame()).facing == HorizontalFacing.East, "looking west it faces east")

bannerBlocks()
skullBlocks()
witherPattern()
spawnerBlocks()
endPortalFrame()
echo "c2 ok"
