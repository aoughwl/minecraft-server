proc consumeIfHungry*(world: BlockWorld, player: BlockPlayer, blockRef: Block, location: BlockPos, stateId: BlockStateId): BlockActionResult =
  case player.gamemode
  of GameMode.Survival, GameMode.Adventure:
    let hungerLevel = player.hungerManager.level
    if (hungerLevel >= 20):
      return barPass
    player.hungerManager.level = 20.min((hungerLevel + 2))
    player.hungerManager.saturation = (player.hungerManager.saturation + 0.4)
    player.sendHealth()
  of GameMode.Creative, GameMode.Spectator:
    discard
  var properties = CakeLikeProperties.fromStateId(stateId, blockRef)
  case properties.bites
  of 0 .. 5:
    player.incrementStat(scCustom, int32(csEatCakeSlice), 1)
    properties.bites += 1
    discard world.setBlockState(location, properties.toStateId(blockRef), BfNotifyAll)
    barConsume
  of 6:
    player.incrementStat(scCustom, int32(csEatCakeSlice), 1)
    discard world.setBlockState(location, blockAir().defaultState.id, BfNotifyAll)
    barConsume
  else:
    rustPanic("panic")

proc cakeBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    return blockAir().defaultState.id
  blockCake().defaultState.id

proc cakeBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc cakeBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  let properties = CakeLikeProperties.fromStateId(stateId, args.block0)
  let item = args.itemStack.item
  drop(args.itemStack)
  if contains((itemCandle().id .. itemBlackCandle().id), item.id):
    let id = item.id
    if (not (properties.bites == 0)):
      return consumeIfHungry(args.world, args.player, args.block0, args.position, stateId)
    if (not (args.player.gamemode == GameMode.Creative)):
      let heldItem = args.player.inventory.heldItem()
      heldItem.decrement(1)
    discard args.world.setBlockState(args.position, cakeFromCandle(item).defaultState.id, BfNotifyAll)
    let seed: float64 = rng().random()
    args.player.playSound(uint16(sdBlockCakeAddCandle), scBlocks, args.position.toF64(), 1.0, 1.0, seed)
    barConsume
  else:
    return consumeIfHungry(args.world, args.player, args.block0, args.position, stateId)

proc cakeBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  consumeIfHungry(args.world, args.player, args.block0, args.position, stateId)

proc cakeBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc cakeBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc cakeBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let stateId = args.world.getBlockStateId(args.position)
  let properties = CakeLikeProperties.fromStateId(stateId, args.block0)
  if (properties.bites <= 6):
    some((((7 - properties.bites)) * 2))
  else:
    some(0)

proc newCakeBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = cakeBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = cakeBlockCanPlaceAt_BlockBehaviour
  result.useWithItemImpl = cakeBlockUseWithItem_BlockBehaviour
  result.normalUseImpl = cakeBlockNormalUse_BlockBehaviour
  result.onScheduledTickImpl = cakeBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = cakeBlockGetStateForNeighborUpdate_BlockBehaviour
  result.getComparatorOutputImpl = cakeBlockGetComparatorOutput_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool =
  let state = world.getBlockState(position.down())
  state.isSolid()

proc registerBlocksCake*(r: BlockRegistry) =
  r.register("minecraft:cake", newCakeBlock())

