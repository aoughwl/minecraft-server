## Port of pumpkin/src/block/blocks/campfire.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/campfire

proc isSignalFireBaseBlock*(blockRef: Block): bool =
  (blockRef == blockHayBlock())

proc campfireBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newCampfireBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc campfireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  # TODO upstream: cooking food on campfire (CampfireBlockEntity)
  if not CampfireLikeProperties.fromStateId(args.state.id, args.block0).lit:
    return
  let living = args.entity.getLivingEntity()
  if living.isNone:
    return
  let boots = args.entity.getEntity().feetStack()
  let hasFrostWalkerEnchantment = boots.getEnchantmentLevel(ENCHANTMENT_FROST_WALKER) != 0
  let hasFireRes = living.unsafeGet.hasEffect("fire_resistance")
  if hasFrostWalkerEnchantment or hasFireRes:
    # campfire burning doesn't work if entity's boots has frost walker enchantment or entity has fire resistance. source: https://minecraft.wiki/w/Campfire#Damage
    return
  let damageAmount = if args.block0 == blockSoulCampfire(): 2.0'f32 else: 1.0'f32
  discard args.entity.damage(damageAmount, "campfire")

proc campfireBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let isReplacingWater = args.replacing.kind == BlockIsReplacingKind.kWater
  var props = CampfireLikeProperties.defaultFor(args.block0)
  props.waterlogged = isReplacingWater
  props.signalFire = isSignalFireBaseBlock(args.world.getBlock(args.position.down()))
  props.lit = not isReplacingWater
  props.facing = args.player.getHorizontalFacing()
  props.toStateId(args.block0)

proc campfireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  var props = CampfireLikeProperties.fromStateId(args.stateId, args.block0)
  if props.waterlogged:
    props.lit = false
    args.world.scheduleFluidTick(Fluid.WATER, args.position, uint8(Fluid.WATER.flowSpeed), tpNormal)
  if args.direction == BlockDirection.Down:
    props.signalFire = isSignalFireBaseBlock(args.world.getBlock(args.neighborPosition))
  props.toStateId(args.block0)

proc newCampfireBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = campfireBlockPlaced_BlockBehaviour
  result.onEntityCollisionImpl = campfireBlockOnEntityCollision_BlockBehaviour
  result.onPlaceImpl = campfireBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = campfireBlockGetStateForNeighborUpdate_BlockBehaviour

proc registerBlocksCampfire*(r: BlockRegistry) =
  r.registerTag("minecraft:campfires", newCampfireBlock())
