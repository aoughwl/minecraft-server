## Port of pumpkin/src/block/blocks/candle_cakes.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import cake


type
  CandleCakeBlock* = object


let CANDLE_MAP: array[17, (Item, Block)] = [(itemCandle(), blockCandleCake()), (itemWhiteCandle(), blockWhiteCandleCake()), (itemOrangeCandle(), blockOrangeCandleCake()), (itemMagentaCandle(), blockMagentaCandleCake()), (itemLightBlueCandle(), blockLightBlueCandleCake()), (itemYellowCandle(), blockYellowCandleCake()), (itemLimeCandle(), blockLimeCandleCake()), (itemPinkCandle(), blockPinkCandleCake()), (itemGrayCandle(), blockGrayCandleCake()), (itemLightGrayCandle(), blockLightGrayCandleCake()), (itemCyanCandle(), blockCyanCandleCake()), (itemPurpleCandle(), blockPurpleCandleCake()), (itemBlueCandle(), blockBlueCandleCake()), (itemBrownCandle(), blockBrownCandleCake()), (itemGreenCandle(), blockGreenCandleCake()), (itemRedCandle(), blockRedCandleCake()), (itemBlackCandle(), blockBlackCandleCake())]

proc cakeFromCandle*(item: Item): Block
proc candleFromCake*(blockRef: Block): Item
proc consumeAndDropCandle*(blockRef: Block, player: BlockPlayer, location: BlockPos, world: BlockWorld): BlockActionResult
proc candleCakeBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc candleCakeBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc candleCakeBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc candleCakeBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newCandleCakeBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool

proc cakeFromCandle*(item: Item): Block =
  CANDLE_MAP.binarySearchByKey(item.id, R2A_MANUAL("closure |(key, _)| key.id")).mapOrElse(R2A_MANUAL("closure |_| rustPanic('panic')"), R2A_MANUAL("closure |index| CANDLE_MAP[index][1]"))

proc candleFromCake*(blockRef: Block): Item =
  CANDLE_MAP.binarySearchByKey(blockRef.id, R2A_MANUAL("closure |(_, value)| value.id")).mapOrElse(R2A_MANUAL("closure |_| rustPanic('panic')"), R2A_MANUAL("closure |index| CANDLE_MAP[index][0]"))

proc consumeAndDropCandle*(blockRef: Block, player: BlockPlayer, location: BlockPos, world: BlockWorld): BlockActionResult =
  case player.gamemode
  of GameMode.Survival, GameMode.Adventure:
    if (player.hungerManager.level >= 20):
      return barPass
  of GameMode.Creative:
    discard
  of GameMode.Spectator:
    return barPass
  let candleItem = candleFromCake(blockRef)
  let itemStack = newItemStack(1, candleItem)
  world.dropStack(location, itemStack)
  discard world.setBlockState(location, blockCake().defaultState.id, BfNotifyAll)
  let (blockRef1, state) = world.getBlockAndStateId(location)
  consumeIfHungry(world, player, blockRef1, location, state)

proc candleCakeBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let itemId = args.itemStack.item.id
  if ((itemId == itemFireCharge().id) or (itemId == itemFlintAndSteel().id)):
    let id = itemId
    barPass
  else:
    barPassToDefaultBlockAction

proc candleCakeBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  consumeAndDropCandle(args.block0, args.player, args.position, args.world)

proc candleCakeBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc candleCakeBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc newCandleCakeBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.useWithItemImpl = candleCakeBlockUseWithItem_BlockBehaviour
  result.normalUseImpl = candleCakeBlockNormalUse_BlockBehaviour
  result.onScheduledTickImpl = candleCakeBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = candleCakeBlockGetStateForNeighborUpdate_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool =
  let state = world.getBlockState(position.down())
  state.isSolid()

proc registerBlocksCandleCakes*(r: BlockRegistry) =
  r.registerTag("minecraft:candle_cakes", newCandleCakeBlock())

