## Port of pumpkin/src/block/blocks/candles.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  CandleBlock* = object



proc candleBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc candleBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc candleBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc candleBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc candleBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool
proc candleBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc candleBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newCandleBlock*(): BlockBehaviour
proc canPlaceAt*(blockAccessor: BlockWorld, position: BlockPos): bool

proc candleBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let t1 = args.replacing
  if (args.player.getEntity().pose != EntityPose.Crouching) and t1.kind == BlockIsReplacingKind.kItself:
    let stateId = t1.f0Itself
    var properties = CandleLikeProperties.fromStateId(stateId, args.block0)
    if (properties.candles < 4):
      properties.candles += 1
    return properties.toStateId(args.block0)
  var properties1 = CandleLikeProperties.defaultFor(args.block0)
  properties1.waterlogged = args.replacing.waterSource()
  properties1.toStateId(args.block0)

proc candleBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  var properties = CandleLikeProperties.fromStateId(state.id, args.block0)
  let item = args.itemStack.item
  drop(args.itemStack)
  if (contains((itemCandle().id .. itemBlackCandle().id), item.id) and (item.id == args.block0.itemId)):
    let id = item.id
    let wasLit = properties.lit
    if (properties.candles < 4):
      properties.candles += 1
    properties.lit = wasLit
    discard args.world.setBlockState(args.position, properties.toStateId(args.block0), BfNotifyAll)
    barConsume
  else:
    if properties.lit:
      properties.lit = false
    else:
      return barPass
    discard args.world.setBlockState(args.position, properties.toStateId(args.block0), BfNotifyAll)
    barConsume

proc candleBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  var properties = CandleLikeProperties.fromStateId(stateId, args.block0)
  if properties.lit:
    properties.lit = false
  discard args.world.setBlockState(args.position, properties.toStateId(args.block0), BfNotifyAll)
  barConsume

proc candleBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc candleBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  let b = BlockAccessor.getBlock(args.world, args.position)
  (((args.player.getEntity().pose != EntityPose.Crouching) and (CandleLikeProperties.fromStateId(args.stateId, args.block0).candles != 4)) and (args.block0.id == b.id))

proc candleBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc candleBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc newCandleBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = candleBlockOnPlace_BlockBehaviour
  result.useWithItemImpl = candleBlockUseWithItem_BlockBehaviour
  result.normalUseImpl = candleBlockNormalUse_BlockBehaviour
  result.canPlaceAtImpl = candleBlockCanPlaceAt_BlockBehaviour
  result.canUpdateAtImpl = candleBlockCanUpdateAt_BlockBehaviour
  result.onScheduledTickImpl = candleBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = candleBlockGetStateForNeighborUpdate_BlockBehaviour

proc canPlaceAt*(blockAccessor: BlockWorld, position: BlockPos): bool =
  let (supportBlock, state) = blockAccessor.getBlockAndState(position.down())
  ((not supportBlock.isWaterlogged(state.id)) and state.isCenterSolid(BlockDirection.Up))

proc registerBlocksCandles*(r: BlockRegistry) =
  r.registerTag("minecraft:candles", newCandleBlock())

