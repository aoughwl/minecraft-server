## Port of pumpkin/src/block/blocks/carpet.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  CarpetBlock* = object
  MossCarpetBlock* = object
  PaleMossCarpetBlock* = object



proc carpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc carpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc carpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newCarpetBlock*(): BlockBehaviour
proc mossCarpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc mossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc mossCarpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newMossCarpetBlock*(): BlockBehaviour
proc paleMossCarpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc paleMossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc paleMossCarpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newPaleMossCarpetBlock*(): BlockBehaviour
proc canPlaceAt*(blockAccessor: BlockWorld, blockPos: BlockPos): bool

proc carpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc carpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc carpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newCarpetBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = carpetBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = carpetBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = carpetBlockOnScheduledTick_BlockBehaviour

proc mossCarpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc mossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc mossCarpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newMossCarpetBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = mossCarpetBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = mossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = mossCarpetBlockOnScheduledTick_BlockBehaviour

proc paleMossCarpetBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc paleMossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc paleMossCarpetBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newPaleMossCarpetBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = paleMossCarpetBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = paleMossCarpetBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = paleMossCarpetBlockOnScheduledTick_BlockBehaviour

proc canPlaceAt*(blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  (not isAir(blockAccessor.getBlockStateId(blockPos.down())))

proc registerBlocksCarpet*(r: BlockRegistry) =
  r.registerTag("minecraft:wool_carpets", newCarpetBlock())
  r.register("minecraft:moss_carpet", newMossCarpetBlock())
  r.register("minecraft:pale_moss_carpet", newPaleMossCarpetBlock())

