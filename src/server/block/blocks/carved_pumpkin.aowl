## Port of pumpkin/src/block/blocks/carved_pumpkin.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  CarvedPumpkinBlock* = object



proc carvedPumpkinBlockIds*(): seq[BlockId]
proc carvedPumpkinBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc carvedPumpkinBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newCarvedPumpkinBlock*(): BlockBehaviour

proc carvedPumpkinBlockIds*(): seq[BlockId] =
  @[blockIdJackOLantern, blockIdCarvedPumpkin]

proc carvedPumpkinBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = WallTorchLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc carvedPumpkinBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let downPos = args.position.down()
  let upper = args.world.getBlock(downPos)
  let lower = args.world.getBlock(downPos.down())
  if (upper == blockSnowBlock()) and (lower == blockSnowBlock()):
    for i in 0'i32 ..< 3'i32:
      let pos = args.position.downHeight(i)
      discard args.world.setBlockState(pos, blockAir().defaultState.id, BfNotifyListeners)
      args.world.syncWorldEvent(weParticlesDestroyBlock, pos, int32(blockSnowBlock().defaultState.id.asU16()))
    discard args.world.spawnEntity("snow_golem", downPos.down().toCenteredF64())
    return
  if (upper == blockIronBlock()) and (lower == blockIronBlock()):
    for dir in [BlockDirection.North, BlockDirection.West]:
      let opposite = dir.opposite()
      let arm1 = downPos.offset(dir.toOffset())
      let arm2 = downPos.offset(opposite.toOffset())
      if (args.world.getBlock(arm1) == blockIronBlock()) and (args.world.getBlock(arm2) == blockIronBlock()):
        let pattern = [args.position, downPos, downPos.down(), arm1, arm2]
        for p in pattern:
          discard args.world.setBlockState(p, blockAir().defaultState.id, BfNotifyListeners)
          args.world.syncWorldEvent(weParticlesDestroyBlock, p, int32(blockIronBlock().defaultState.id.asU16()))
        discard args.world.spawnEntity("iron_golem", downPos.down().toCenteredF64())
        return

proc newCarvedPumpkinBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = carvedPumpkinBlockOnPlace_BlockBehaviour
  result.placedImpl = carvedPumpkinBlockPlaced_BlockBehaviour

proc registerBlocksCarvedPumpkin*(r: BlockRegistry) =
  r.registerIds(carvedPumpkinBlockIds(), newCarvedPumpkinBlock())

