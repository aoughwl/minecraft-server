import ../blockprelude


type
  CauldronBlock* = object



proc cauldronBlockIds*(): seq[BlockId]
proc cauldronBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8]
proc newCauldronBlock*(): BlockBehaviour

proc cauldronBlockIds*(): seq[BlockId] =
  @[blockIdCauldron, blockIdWaterCauldron, blockIdLavaCauldron, blockIdPowderSnowCauldron]

proc cauldronBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  case args.block0.id
  of blockIdWaterCauldron, blockIdPowderSnowCauldron:
    let stateId = args.world.getBlockStateId(args.position)
    let props = WaterCauldronLikeProperties.fromStateId(stateId, args.block0)
    some(props.level)
  of blockIdLavaCauldron:
    some(3)
  else:
    some(0)

proc newCauldronBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.getComparatorOutputImpl = cauldronBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksCauldron*(r: BlockRegistry) =
  r.registerIds(cauldronBlockIds(), newCauldronBlock())

