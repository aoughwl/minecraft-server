## Port of pumpkin/src/block/blocks/chain.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  ChainBlock* = object



proc chainBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc newChainBlock*(): BlockBehaviour

proc chainBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = IronChainLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  let t1 = block:
    case args.direction
    of BlockDirection.East, BlockDirection.West:
      Axis.X
    of BlockDirection.Up, BlockDirection.Down:
      Axis.Y
    of BlockDirection.North, BlockDirection.South:
      Axis.Z
  props.axis = t1
  props.toStateId(args.block0)

proc newChainBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chainBlockOnPlace_BlockBehaviour

proc registerBlocksChain*(r: BlockRegistry) =
  r.register("minecraft:iron_chain", newChainBlock())

