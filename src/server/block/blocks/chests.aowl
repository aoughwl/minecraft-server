proc copperChestBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  let currentStateId = args.world.getBlockStateId(args.position)
  let chestProps = ChestLikeProperties.fromStateId(currentStateId, args.block0)
  # Only oxidize LEFT or SINGLE chests (not RIGHT) to prevent double oxidation
  if (chestProps.kind0 == ChestType.Right):
    return
  # Only oxidize if no players are viewing the chest
  block chain27:
    let t25 = args.world.getBlockEntity(args.position)
    if t25.isSome:
      let blockEntity = t25.unsafeGet
      let t26 = asType(t25.unsafeGet, ChestBlockEntity)
      if t26.isSome:
        let chestEntity = t26.unsafeGet
        if (t26.unsafeGet.getViewerCount() > 0):
          return
  # Try to oxidize the copper chest
  tryOxidizeCopperChest(args.world, args.position, args.block0, chestProps)

