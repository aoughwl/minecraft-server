proc computeChestProps*(world: BlockWorld, player: BlockPlayer, blockRef: Block, blockPos: BlockPos, face: BlockDirection): (ChestType, HorizontalFacing) =
  let playerFacing = player.getEntity().getHorizontalFacing()
  let chestFacing = playerFacing.opposite()
  if (player.getEntity().pose == EntityPose.Crouching):
    let t38 = face.toHorizontalFacing()
    if not (t38.isSome):
      return (ChestType.Single, chestFacing)
    let face = t38.unsafeGet
    let (clickedBlock, clickedBlockState) = world.getBlockAndStateId(blockPos.offset(face.toOffset()))
    if (clickedBlock == blockRef):
      let clickedProps = ChestLikeProperties.fromStateId(clickedBlockState, clickedBlock)
      if (not (clickedProps.kind0 == ChestType.Single)):
        return (ChestType.Single, chestFacing)
      if (clickedProps.facing.rotateClockwise() == face):
        return (ChestType.Left, clickedProps.facing)
      elif (clickedProps.facing.rotateCounterClockwise() == face):
        return (ChestType.Right, clickedProps.facing)
    return (ChestType.Single, chestFacing)
  if getChestPropertiesIfCanConnect(world, blockRef, blockPos, chestFacing, chestFacing.rotateClockwise(), ChestType.Single).isSome():
    (ChestType.Left, chestFacing)
  elif getChestPropertiesIfCanConnect(world, blockRef, blockPos, chestFacing, chestFacing.rotateCounterClockwise(), ChestType.Single).isSome():
    (ChestType.Right, chestFacing)
  else:
    (ChestType.Single, chestFacing)

proc getChestPropertiesIfCanConnect*(world: BlockWorld, blockRef: Block, blockPos: BlockPos, facing: HorizontalFacing, direction: HorizontalFacing, wantedType: ChestType): Option[ChestLikeProperties] =
  let (neighborBlock, neighborBlockState) = world.getBlockAndStateId(blockPos.offset(direction.toOffset()))
  if (not (neighborBlock == blockRef)):
    return none[ChestLikeProperties]()
  let neighborProps = ChestLikeProperties.fromStateId(neighborBlockState, neighborBlock)
  if (neighborProps.facing == facing) and (neighborProps.kind0 == wantedType):
    return some(neighborProps)
  none[ChestLikeProperties]()

proc isChestBlocked*(world: BlockWorld, blockPos: BlockPos): bool =
  # TODO: Block opening when a cat is sitting on top.
  hasBlockOnTop(world, blockPos)

proc hasBlockOnTop*(world: BlockWorld, blockPos: BlockPos): bool =
  let abovePos = blockPos.up()
  let aboveState = world.getBlockState(abovePos)
  aboveState.isSolidBlock()

proc opposite*(self: ChestType): ChestType =
  case self
  of ChestType.Single:
    ChestType.Single
  of ChestType.Left:
    ChestType.Right
  of ChestType.Right:
    ChestType.Left

proc registerBlocksChests*(r: BlockRegistry) =
  r.registerTag("c:chests/wooden", newChestBlock())
  r.registerTag("minecraft:copper_chests", newCopperChestBlock())
  r.register("minecraft:trapped_chest", newTrappedChestBlock())

