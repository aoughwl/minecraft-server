proc createScreenHandler*(self: ChestScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let t1 = block:
    if (self[0].size() > 27):
      createGeneric9x6(syncId, playerInventory, self[0])
    else:
      createGeneric9x3(syncId, playerInventory, self[0])
  let concreteHandler = t1
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: ChestScreenFactory): TextComponent =
  if (self[0].size() > 27):
    TextComponent.translateCross(CONTAINER_CHESTDOUBLE, CONTAINER_CHESTDOUBLE, [])
  else:
    TextComponent.translateCross(CONTAINER_CHEST, CONTAINER_CHEST, [])

proc onPlaceChestImpl*(args: OnPlaceArgs): BlockStateId =
  var chestProps = ChestLikeProperties.defaultFor(args.block0)
  chestProps.waterlogged = args.replacing.waterSource()
  let (kind0, facing) = computeChestProps(args.world, args.player, args.block0, args.position, args.direction)
  chestProps.facing = facing
  chestProps.kind0 = kind0
  chestProps.toStateId(args.block0)

proc placedChestImpl*(args: PlacedArgs, createEntity: R2A_MANUAL_fnType) =
  let chest = createEntity(args.position)
  args.world.addBlockEntity(chest)
  let chestProps = ChestLikeProperties.fromStateId(args.stateId, args.block0)
  let t2 = block:
    case chestProps.kind0
    of ChestType.Single:
      return
    of ChestType.Left:
      chestProps.facing.rotateClockwise()
    of ChestType.Right:
      chestProps.facing.rotateCounterClockwise()
  let connectedTowards = t2
  let t3 = getChestPropertiesIfCanConnect(args.world, args.block0, args.position, chestProps.facing, connectedTowards, ChestType.Single)
  if t3.isSome:
    var neighborProps = t3.unsafeGet
    neighborProps.kind0 = chestProps.kind0.opposite()
    discard args.world.setBlockState(args.position.offset(connectedTowards.toOffset()), neighborProps.toStateId(args.block0), BfNotifyListeners)

proc getChestComparatorOutput*(args: GetComparatorOutputArgs): Option[uint8] =
  let state = args.world.getBlockStateId(args.position)
  let firstChest = args.world.getBlockEntity(args.position)
  let t4 = firstChest.andThen(getInventory)
  if t4.isNone: return none[uint8]()
  let firstInventory = t4.unsafeGet
  let chestProps = ChestLikeProperties.fromStateId(state, args.block0)
  let t5 = block:
    case chestProps.kind0
    of ChestType.Single:
      none[uint8]()
    of ChestType.Left:
      some(chestProps.facing.rotateClockwise())
    of ChestType.Right:
      some(chestProps.facing.rotateCounterClockwise())
  let connectedTowards = t5
  block chain8:
    let t6 = connectedTowards
    if t6.isSome:
      let direction = t6.unsafeGet
      let t7 = args.world.getBlockEntity(args.position.offset(t6.unsafeGet.toOffset())).andThen(getInventory)
      if t7.isSome:
        let secondInventory = t7.unsafeGet
        let t9 = block:
          if (chestProps.kind0 == ChestType.Right):
            newDoubleInventory(firstInventory, t7.unsafeGet)
          else:
            newDoubleInventory(t7.unsafeGet, firstInventory)
        let doubleInventory = t9
        some(calculateComparatorOutput(doubleInventory))
        break chain8
    some(calculateComparatorOutput(firstInventory))

proc normalUseChestImpl*(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csOpenChest), 1)
  let state = args.world.getBlockStateId(args.position)
  let firstChest = args.world.getBlockEntity(args.position)
  # Spectators cannot open chests with a pending loot table.
  # The loot is only generated on first open by a non-spectator.
  let playerIsSpectator = (args.player.gamemode == GameMode.Spectator)
  let t10 = firstChest
  if playerIsSpectator and t10.isSome and t10.unsafeGet.hasLootTable():
    let entity = t10.unsafeGet
    return barSuccess
  # Unpack deferred loot table on first open (non-spectator only).
  block chain15:
    let t11 = firstChest
    if t11.isSome:
      let entity = t11.unsafeGet
      let t12 = t11.unsafeGet.takeLootTable()
      if t12.isSome:
        let lootKey = t12.unsafeGet[0]
        let seed = t12.unsafeGet[1]
        let t13 = getChestLootTable(t12.unsafeGet[0])
        if t13.isSome:
          let table = t13.unsafeGet
          let t14 = t11.unsafeGet.getInventory()
          if t14.isSome:
            let inv = t14.unsafeGet
            fillChestInventory(t14.unsafeGet, t13.unsafeGet, t12.unsafeGet[1])
            # Mark the block entity dirty so the generated items persist.
            t14.unsafeGet.markDirty()
  let t16 = firstChest.andThen(getInventory)
  if not (t16.isSome):
    return barFail
  let firstInventory = t16.unsafeGet
  let chestProps = ChestLikeProperties.fromStateId(state, args.block0)
  let t17 = block:
    case chestProps.kind0
    of ChestType.Single:
      R2A_NONE
    of ChestType.Left:
      some(chestProps.facing.rotateClockwise())
    of ChestType.Right:
      some(chestProps.facing.rotateCounterClockwise())
  let connectedTowards = t17
  if isChestBlocked(args.world, args.position):
    return barSuccess
  let t18 = connectedTowards
  if t18.isSome:
    let direction = t18.unsafeGet
    let neighborPos = args.position.offset(t18.unsafeGet.toOffset())
    if isChestBlocked(args.world, neighborPos):
      return barSuccess
  let t19 = block:
    block chain22:
      let t20 = connectedTowards
      if t20.isSome:
        let direction = t20.unsafeGet
        let t21 = args.world.getBlockEntity(args.position.offset(t20.unsafeGet.toOffset())).andThen(getInventory)
        if t21.isSome:
          let secondInventory = t21.unsafeGet
          # Vanilla: chestType == ChestType.RIGHT ? DoubleBlockProperties.Type.FIRST : DoubleBlockProperties.Type.SECOND;
          if (chestProps.kind0 == ChestType.Right):
            newDoubleInventory(firstInventory, t21.unsafeGet)
          else:
            newDoubleInventory(t21.unsafeGet, firstInventory)
          break chain22
      firstInventory
  let inventory = t19
  args.player.openHandledScreen(ChestScreenFactory(inventory), some(args.position))
  barSuccess

proc brokenChestImpl*(args: BrokenArgs) =
  let chestProps = ChestLikeProperties.fromStateId(args.state.id, args.block0)
  let t23 = block:
    case chestProps.kind0
    of ChestType.Single:
      return
    of ChestType.Left:
      chestProps.facing.rotateClockwise()
    of ChestType.Right:
      chestProps.facing.rotateCounterClockwise()
  let connectedTowards = t23
  let t24 = getChestPropertiesIfCanConnect(args.world, args.block0, args.position, chestProps.facing, connectedTowards, chestProps.kind0.opposite())
  if t24.isSome:
    var neighborProps = t24.unsafeGet
    neighborProps.kind0 = ChestType.Single
    discard args.world.setBlockState(args.position.offset(connectedTowards.toOffset()), neighborProps.toStateId(args.block0), BfNotifyListeners)

