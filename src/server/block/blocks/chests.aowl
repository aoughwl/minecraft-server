proc trappedChestBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  # Get viewer count from this chest
  let t34 = block:
    block chain37:
      let t35 = args.world.getBlockEntity(args.position)
      if t35.isSome:
        let blockEntity = t35.unsafeGet
        let t36 = asType(t35.unsafeGet, TrappedChestBlockEntity)
        if t36.isSome:
          let trappedChest = t36.unsafeGet
          t36.unsafeGet.getViewerCount()
          break chain37
      0'u8
  let viewerCount = t34
  uint8(viewerCount.min(15))

proc trappedChestBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  # Strong power emitted to the block beneath the trapped chest
