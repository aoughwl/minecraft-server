## Port of pumpkin/src/block/blocks/chests.rs
## `Pose::Crouching` is read as `sneaking`, the only pose a block can ask a `BlockActor`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../generated/chest_loot
import ../../../inventory/[double, genericcontainer]
import ../../world/loot as lootmod
import ../entities/chest
import ../entities/trapped_chest
import ../entities/chest as entities_chest
import ../entities/trapped_chest as entities_trapped_chest

const LID_ANIMATION_EVENT_TYPE: uint8 = 1

let COPPER_CHEST_OXIDATION: seq[(Block, Block, uint8)] = @[(blockCopperChest(), blockExposedCopperChest(), 0'u8),
  (blockExposedCopperChest(), blockWeatheredCopperChest(), 1'u8),
  (blockWeatheredCopperChest(), blockOxidizedCopperChest(), 2'u8)]

proc opposite*(self: ChestType): ChestType =
  case self
  of ChestType.Single:
    ChestType.Single
  of ChestType.Left:
    ChestType.Right
  of ChestType.Right:
    ChestType.Left

proc chestScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `ChestScreenFactory`
  let title = if inventory.size() > 27: translateCross(JAVA_CONTAINER_CHESTDOUBLE, BEDROCK_CONTAINER_CHESTDOUBLE)
              else: translateCross(JAVA_CONTAINER_CHEST, BEDROCK_CONTAINER_CHEST)
  newScreenFactory(title, proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
    if inventory.size() > 27:
      ScreenHandler(createGeneric9x6(syncId, playerInventory, inventory))
    else:
      ScreenHandler(createGeneric9x3(syncId, playerInventory, inventory)))

proc hasBlockOnTop*(world: BlockWorld, blockPos: BlockPos): bool =
  let abovePos = blockPos.up()
  let aboveState = world.getBlockState(abovePos)
  aboveState.isSolidBlock()

proc isChestBlocked*(world: BlockWorld, blockPos: BlockPos): bool =
  # TODO: Block opening when a cat is sitting on top.
  hasBlockOnTop(world, blockPos)

proc getChestPropertiesIfCanConnect*(world: BlockWorld, blockRef: Block, blockPos: BlockPos, facing: HorizontalFacing,
    direction: HorizontalFacing, wantedType: ChestType): Option[ChestLikeProperties] =
  let (neighborBlock, neighborBlockState) = world.getBlockAndStateId(blockPos.offset(direction.toOffset()))
  if neighborBlock != blockRef:
    return none[ChestLikeProperties]()
  let neighborProps = ChestLikeProperties.fromStateId(neighborBlockState, neighborBlock)
  if neighborProps.facing == facing and neighborProps.`type` == wantedType:
    return some(neighborProps)
  none[ChestLikeProperties]()

proc computeChestProps*(world: BlockWorld, player: BlockPlayer, blockRef: Block, blockPos: BlockPos,
    face: BlockDirection): (ChestType, HorizontalFacing) =
  let playerFacing = player.getHorizontalFacing()
  let chestFacing = playerFacing.opposite()
  let sneak = player.sneaking0
  if sneak != nil and sneak():
    let t38 = face.toHorizontalFacing()
    if not t38.isSome:
      return (ChestType.Single, chestFacing)
    let face2 = t38.unsafeGet
    let (clickedBlock, clickedBlockState) = world.getBlockAndStateId(blockPos.offset(face2.toOffset()))
    if clickedBlock == blockRef:
      let clickedProps = ChestLikeProperties.fromStateId(clickedBlockState, clickedBlock)
      if clickedProps.`type` != ChestType.Single:
        return (ChestType.Single, chestFacing)
      if clickedProps.facing.rotateClockwise() == face2:
        return (ChestType.Left, clickedProps.facing)
      elif clickedProps.facing.rotateCounterClockwise() == face2:
        return (ChestType.Right, clickedProps.facing)
    return (ChestType.Single, chestFacing)
  if getChestPropertiesIfCanConnect(world, blockRef, blockPos, chestFacing, chestFacing.rotateClockwise(),
      ChestType.Single).isSome:
    (ChestType.Left, chestFacing)
  elif getChestPropertiesIfCanConnect(world, blockRef, blockPos, chestFacing, chestFacing.rotateCounterClockwise(),
      ChestType.Single).isSome:
    (ChestType.Right, chestFacing)
  else:
    (ChestType.Single, chestFacing)

proc onPlaceChestImpl*(args: OnPlaceArgs): BlockStateId =
  var chestProps = ChestLikeProperties.defaultFor(args.block0)
  chestProps.waterlogged = args.replacing.waterSource()
  let (kind0, facing) = computeChestProps(args.world, args.player, args.block0, args.position, args.direction)
  chestProps.facing = facing
  chestProps.`type` = kind0
  chestProps.toStateId(args.block0)

proc connectedTowardsOf(chestProps: ChestLikeProperties): Option[HorizontalFacing] =
  case chestProps.`type`
  of ChestType.Single:
    none[HorizontalFacing]()
  of ChestType.Left:
    some(chestProps.facing.rotateClockwise())
  of ChestType.Right:
    some(chestProps.facing.rotateCounterClockwise())

proc inventoryAt(world: BlockWorld, position: BlockPos): Option[Inventory] =
  let e = world.getBlockEntity(position)
  if e.isNone:
    return none[Inventory]()
  e.unsafeGet.getInventory()

proc placedChestImpl*(args: PlacedArgs, chest: BlockEntity) =
  args.world.addBlockEntity(chest)
  let chestProps = ChestLikeProperties.fromStateId(args.stateId, args.block0)
  let towards = connectedTowardsOf(chestProps)
  if towards.isNone:
    return
  let connectedTowards = towards.unsafeGet
  let t3 = getChestPropertiesIfCanConnect(args.world, args.block0, args.position, chestProps.facing, connectedTowards,
    ChestType.Single)
  if t3.isSome:
    var neighborProps = t3.unsafeGet
    neighborProps.`type` = chestProps.`type`.opposite()
    discard args.world.setBlockState(args.position.offset(connectedTowards.toOffset()),
      neighborProps.toStateId(args.block0), BfNotifyListeners)

proc doubleOrSingle(world: BlockWorld, position: BlockPos, chestProps: ChestLikeProperties,
    firstInventory: Inventory): Inventory =
  ## The inventory the chest at `position` shows: with its neighbour when it is half of a double chest.
  let towards = connectedTowardsOf(chestProps)
  if towards.isSome:
    let second = inventoryAt(world, position.offset(towards.unsafeGet.toOffset()))
    if second.isSome:
      # Vanilla: chestType == ChestType.RIGHT ? DoubleBlockProperties.Type.FIRST : DoubleBlockProperties.Type.SECOND;
      if chestProps.`type` == ChestType.Right:
        return Inventory(newDoubleInventory(firstInventory, second.unsafeGet))
      else:
        return Inventory(newDoubleInventory(second.unsafeGet, firstInventory))
  firstInventory

proc getChestComparatorOutput*(args: GetComparatorOutputArgs): Option[uint8] =
  let state = args.world.getBlockStateId(args.position)
  let first = inventoryAt(args.world, args.position)
  if first.isNone:
    return none[uint8]()
  let chestProps = ChestLikeProperties.fromStateId(state, args.block0)
  some(calculateComparatorOutput(doubleOrSingle(args.world, args.position, chestProps, first.unsafeGet)))

proc normalUseChestImpl*(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csOpenChest), 1)
  let state = args.world.getBlockStateId(args.position)
  let firstChest = args.world.getBlockEntity(args.position)
  # Spectators cannot open chests with a pending loot table.
  # The loot is only generated on first open by a non-spectator.
  let gm = args.player.gamemode0
  let playerIsSpectator = gm != nil and gm() == GameMode.Spectator
  if firstChest.isSome:
    let entity = firstChest.unsafeGet
    let hasLoot = entity.vt.hasLootTableImpl
    if playerIsSpectator and hasLoot(entity):
      return barSuccess
    # Unpack deferred loot table on first open (non-spectator only).
    let takeLoot = entity.vt.takeLootTableImpl
    let taken = takeLoot(entity)
    if taken.isSome:
      let table = getChestLootTable(taken.unsafeGet[0])
      let inv = entity.getInventory()
      if table.isSome and inv.isSome:
        let placed = lootmod.fillChestInventory(table.unsafeGet, taken.unsafeGet[1], inv.unsafeGet.size())
        for entry in placed:
          inv.unsafeGet.setStack(entry[0], entry[1])
        # Mark the block entity dirty so the generated items persist.
        inv.unsafeGet.markDirty()
  let first = inventoryAt(args.world, args.position)
  if first.isNone:
    return barFail
  let chestProps = ChestLikeProperties.fromStateId(state, args.block0)
  let towards = connectedTowardsOf(chestProps)
  if isChestBlocked(args.world, args.position):
    return barSuccess
  if towards.isSome:
    let neighborPos = args.position.offset(towards.unsafeGet.toOffset())
    if isChestBlocked(args.world, neighborPos):
      return barSuccess
  let inventory = doubleOrSingle(args.world, args.position, chestProps, first.unsafeGet)
  args.player.openHandledScreen(chestScreenFactory(inventory), some(args.position))
  barSuccess

proc brokenChestImpl*(args: BrokenArgs) =
  let chestProps = ChestLikeProperties.fromStateId(args.state.id, args.block0)
  let towards = connectedTowardsOf(chestProps)
  if towards.isNone:
    return
  let connectedTowards = towards.unsafeGet
  let t24 = getChestPropertiesIfCanConnect(args.world, args.block0, args.position, chestProps.facing, connectedTowards,
    chestProps.`type`.opposite())
  if t24.isSome:
    var neighborProps = t24.unsafeGet
    neighborProps.`type` = ChestType.Single
    discard args.world.setBlockState(args.position.offset(connectedTowards.toOffset()),
      neighborProps.toStateId(args.block0), BfNotifyListeners)

proc chestBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  onPlaceChestImpl(args)

proc chestBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  (args.kind0 == LID_ANIMATION_EVENT_TYPE)

proc chestBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  placedChestImpl(args, BlockEntity(newChestBlockEntity(args.position)))

proc chestBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  normalUseChestImpl(args)

proc chestBlockBroken_BlockBehaviour(args: BrokenArgs) =
  brokenChestImpl(args)

proc chestBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  getChestComparatorOutput(args)

proc newChestBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chestBlockOnPlace_BlockBehaviour
  result.onSyncedBlockEventImpl = chestBlockOnSyncedBlockEvent_BlockBehaviour
  result.placedImpl = chestBlockPlaced_BlockBehaviour
  result.normalUseImpl = chestBlockNormalUse_BlockBehaviour
  result.brokenImpl = chestBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = chestBlockGetComparatorOutput_BlockBehaviour

# --- Copper chests: the same behaviour, and they oxidize over time ---------------------------------------------

proc getOxidationLevel*(blockRef: Block): Option[uint8] =
  # Check non-waxed variants
  if blockRef == blockCopperChest():
    return some(0'u8)
  if blockRef == blockExposedCopperChest():
    return some(1'u8)
  if blockRef == blockWeatheredCopperChest():
    return some(2'u8)
  if blockRef == blockOxidizedCopperChest():
    return some(3'u8)
  # Waxed variants don't oxidize
  none[uint8]()

proc countNeighborOxidationLevels*(world: BlockWorld, center: BlockPos, currentLevel: uint8): (int32, int32) =
  var sameLevelCount = 0'i32
  var higherLevelCount = 0'i32
  # Iterate in a 4-block Manhattan distance (9x9x9 cube checked with distance filter)
  for dx in -4'i32 .. 4'i32:
    for dy in -4'i32 .. 4'i32:
      for dz in -4'i32 .. 4'i32:
        let manhattanDist = abs(dx) + abs(dy) + abs(dz)
        if manhattanDist > 4 or manhattanDist == 0:
          continue
        let neighborPos = newBlockPos(center.vec.x + dx, center.vec.y + dy, center.vec.z + dz)
        let neighborBlock = world.getBlock(neighborPos)
        let t33 = getOxidationLevel(neighborBlock)
        if t33.isSome:
          let neighborLevel = t33.unsafeGet
          if neighborLevel < currentLevel:
            # Found a neighbor at lower oxidation level - block oxidation entirely
            return (0'i32, 0'i32)
          elif neighborLevel > currentLevel:
            higherLevelCount += 1
          else:
            sameLevelCount += 1
  (sameLevelCount, higherLevelCount)

proc tryOxidizeCopperChest*(world: BlockWorld, position: BlockPos, currentBlock: Block, chestProps: ChestLikeProperties) =
  # Base chance per random tick: ~5.69%
  const BASE_DEGRADATION_CHANCE: float32 = 0.05688889'f32
  # First roll: only ~5.69% chance to even attempt oxidation
  if randomOf(float32) >= BASE_DEGRADATION_CHANCE:
    return
  # Find the next oxidation level
  var found = false
  var nextBlock = currentBlock
  var currentLevel = 0'u8
  for entry in COPPER_CHEST_OXIDATION:
    if entry[0] == currentBlock:
      found = true
      nextBlock = entry[1]
      currentLevel = entry[2]
      break
  if not found:
    return
  # Scan neighbors in 4-block Manhattan distance to calculate oxidation chance
  let (sameLevelCount, higherLevelCount) = countNeighborOxidationLevels(world, position, currentLevel)
  # Calculate weighted probability: ((higher + 1) / (higher + same + 1))^2 * multiplier
  let ratio = float32(higherLevelCount + 1) / float32(higherLevelCount + sameLevelCount + 1)
  # Multiplier is 0.75 for UNAFFECTED (level 0), 1.0 for others
  let multiplier = if currentLevel == 0'u8: 0.75'f32 else: 1.0'f32
  let finalChance = ratio * ratio * multiplier
  if randomOf(float32) >= finalChance:
    return
  # Apply oxidation with same properties
  let newStateId = chestProps.toStateId(nextBlock)
  discard world.setBlockState(position, newStateId, BfNotifyListeners)

proc copperChestBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  let currentStateId = args.world.getBlockStateId(args.position)
  let chestProps = ChestLikeProperties.fromStateId(currentStateId, args.block0)
  # Only oxidize LEFT or SINGLE chests (not RIGHT) to prevent double oxidation
  if chestProps.`type` == ChestType.Right:
    return
  # Only oxidize if no players are viewing the chest
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let be = blockEntity.unsafeGet
    if be of ChestLikeBlockEntity and not ChestLikeBlockEntity(be).trapped and
        ChestLikeBlockEntity(be).getViewerCount() > 0'u16:
      return
  # Try to oxidize the copper chest
  tryOxidizeCopperChest(args.world, args.position, args.block0, chestProps)

proc newCopperChestBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chestBlockOnPlace_BlockBehaviour
  result.onSyncedBlockEventImpl = chestBlockOnSyncedBlockEvent_BlockBehaviour
  result.placedImpl = chestBlockPlaced_BlockBehaviour
  result.normalUseImpl = chestBlockNormalUse_BlockBehaviour
  result.brokenImpl = chestBlockBroken_BlockBehaviour
  result.randomTickImpl = copperChestBlockRandomTick_BlockBehaviour
  result.getComparatorOutputImpl = chestBlockGetComparatorOutput_BlockBehaviour

# --- Trapped chests --------------------------------------------------------------------------------------------

proc trappedChestBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  placedChestImpl(args, BlockEntity(newTrappedChestBlockEntity(args.position)))

proc trappedChestBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc trappedChestBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  # Get viewer count from this chest
  var viewerCount = 0'u16
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let be = blockEntity.unsafeGet
    if be of ChestLikeBlockEntity and ChestLikeBlockEntity(be).trapped:
      viewerCount = ChestLikeBlockEntity(be).getViewerCount()
  uint8(min(viewerCount, 15'u16))

proc trappedChestBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  # Strong power emitted to the block beneath the trapped chest
  # The block below queries with direction Up (from below looking up at the chest)
  if args.direction == BlockDirection.Up:
    trappedChestBlockGetWeakRedstonePower_BlockBehaviour(args)
  else:
    0'u8

proc newTrappedChestBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chestBlockOnPlace_BlockBehaviour
  result.onSyncedBlockEventImpl = chestBlockOnSyncedBlockEvent_BlockBehaviour
  result.placedImpl = trappedChestBlockPlaced_BlockBehaviour
  result.normalUseImpl = chestBlockNormalUse_BlockBehaviour
  result.brokenImpl = chestBlockBroken_BlockBehaviour
  result.emitsRedstonePowerImpl = trappedChestBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = trappedChestBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = trappedChestBlockGetStrongRedstonePower_BlockBehaviour
  result.getComparatorOutputImpl = chestBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksChests*(r: BlockRegistry) =
  r.registerTag("c:chests/wooden", newChestBlock())
  r.registerTag("minecraft:copper_chests", newCopperChestBlock())
  r.register("minecraft:trapped_chest", newTrappedChestBlock())
