## Port of pumpkin/src/block/blocks/chiseled_bookshelf.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../util/vector2
import ../../../generated/item_full
import ../entities/chiseled_bookshelf
import ../../../inventory/player_inventory

const OFFSET_SLOT_0*: float32 = 0.375
const OFFSET_SLOT_1*: float32 = 0.6875

type
  ChiseledBookshelfBlock* = object




proc chiseledBookshelfBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var properties = ChiseledBookshelfLikeProperties.defaultFor(args.block0)
  # Face in the opposite direction the player is facing
  properties.facing = args.player.getEntity().getHorizontalFacing().opposite()
  properties.toStateId(args.block0)

proc chiseledBookshelfBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  let properties = ChiseledBookshelfLikeProperties.fromStateId(state.id, args.block0)
  let t1 = getSlotForHit(args.hit, properties.facing)
  if t1.isSome:
    let slot = t1.unsafeGet
    if isSlotUsed(properties, t1.unsafeGet):
      block chain4:
        let t2 = args.world.getBlockEntity(args.position)
        if t2.isSome:
          let blockEntity = t2.unsafeGet
          let t3 = t2.unsafeGet.asType(ChiseledBookshelfBlockEntity)
          if t3.isSome:
            let blockEntity = t3.unsafeGet
            tryRemoveBook(args.world, args.player, args.position, t3.unsafeGet, properties, t1.unsafeGet)
            return barSuccess
    else:
      return barConsume
  barPass

proc chiseledBookshelfBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  let properties = ChiseledBookshelfLikeProperties.fromStateId(state.id, args.block0)
  if (not args.itemStack.stack.getItem().id.hasTag(Item_MINECRAFT_BOOKSHELF_BOOKS)):
    return barPassToDefaultBlockAction
  let t5 = getSlotForHit(args.hit, properties.facing)
  if t5.isSome:
    let slot = t5.unsafeGet
    if isSlotUsed(properties, t5.unsafeGet):
      return barPassToDefaultBlockAction
    else:
      block chain10:
        let t8 = args.world.getBlockEntity(args.position)
        if t8.isSome:
          let blockEntity = t8.unsafeGet
          let t9 = t8.unsafeGet.asType(ChiseledBookshelfBlockEntity)
          if t9.isSome:
            let blockEntity = t9.unsafeGet
            tryAddBook(args.world, args.player, args.position, t9.unsafeGet, properties, t5.unsafeGet, args.itemStack)
            return barSuccess
  barPass

proc chiseledBookshelfBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blockEntity = newChiseledBookshelfBlockEntity(args.position)
  args.world.addBlockEntity(blockEntity)

proc chiseledBookshelfBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain13:
    let t11 = args.world.getBlockEntity(args.position)
    if t11.isSome:
      let blockEntity = t11.unsafeGet
      let t12 = t11.unsafeGet.asType(ChiseledBookshelfBlockEntity)
      if t12.isSome:
        let blockEntity = t12.unsafeGet
        return some(uint8(t12.unsafeGet.lastInteractedSlot + 1'i8))
  none[uint8]()

proc newChiseledBookshelfBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chiseledBookshelfBlockOnPlace_BlockBehaviour
  result.normalUseImpl = chiseledBookshelfBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = chiseledBookshelfBlockUseWithItem_BlockBehaviour
  result.placedImpl = chiseledBookshelfBlockPlaced_BlockBehaviour
  result.getComparatorOutputImpl = chiseledBookshelfBlockGetComparatorOutput_BlockBehaviour

proc tryAddBook*(world: BlockWorld, player: BlockPlayer, position: BlockPos, entity: ChiseledBookshelfBlockEntity, properties: ChiseledBookshelfLikeProperties, slot: int8, item: ItemStackRef) =
  # TODO: Increment used stats for chiseled bookshelf on the player
  let t14 = block:
    if (item.stack.getItem() == ITEM_ENCHANTED_BOOK):
      sdBlockChiseledBookshelfPickupEnchanted
    else:
      sdBlockChiseledBookshelfPickup
  let sound = t14
  entity.setStack(int(slot), item.stack.splitUnlessCreative(player.gamemode(), 1'u8))
  entity.updateState(properties, world, slot)
  world.playSound(sound, scBlocks, position.toCenteredF64())

proc tryRemoveBook*(world: BlockWorld, player: BlockPlayer, position: BlockPos, entity: ChiseledBookshelfBlockEntity, properties: ChiseledBookshelfLikeProperties, slot: int8) =
  var stack = entity.removeStackSpecific(int(slot), 1)
  let t15 = block:
    if (stack.getItem() == ITEM_ENCHANTED_BOOK):
      sdBlockChiseledBookshelfPickupEnchanted
    else:
      sdBlockChiseledBookshelfPickup
  let sound = t15
  if (not PlayerInventory(player.inventory0()).insertStackAnywhere(stack)):
    # Drop the item on the ground if the player cannot hold it because of a full inventory
    player.dropItem(stack)
  entity.updateState(properties, world, slot)
  world.playSound(sound, scBlocks, position.toCenteredF64())

proc getSlotForHit*(hit: BlockHitResult, facing: HorizontalFacing): Option[int8] =
  let t17 = getHitPos(hit, facing)
  var t18 = none[int8]()
  if t17.isSome:
    let position = t17.unsafeGet
    let t16 = block:
      let i = if position.y < 0.5'f32: 1'i8 else: 0'i8
      let j = getColumn(position.x)
      j + i * 3'i8
    t18 = some(t16)
  t18

proc getHitPos*(hit: BlockHitResult, facing: HorizontalFacing): Option[Vector2[float32]] =
  # If the direction is not horizontal, we cannot hit a slot
  let t19 = hit.face.toHorizontalFacing()
  if t19.isNone: return none[Vector2[float32]]()
  let direction = t19.unsafeGet
  # If the facing direction does not match the block's facing, we cannot hit a slot
  if (not (facing == direction)):
    return none[Vector2[float32]]()
  case direction
  of HorizontalFacing.North:
    some(vec2((1.0'f32 - hit.cursorPos.x), hit.cursorPos.y))
  of HorizontalFacing.South:
    some(vec2(hit.cursorPos.x, hit.cursorPos.y))
  of HorizontalFacing.West:
    some(vec2(hit.cursorPos.z, hit.cursorPos.y))
  of HorizontalFacing.East:
    some(vec2((1.0'f32 - hit.cursorPos.z), hit.cursorPos.y))

proc getColumn*(x: float32): int8 =
  if (x < OFFSET_SLOT_0):
    0'i8
  elif (x < OFFSET_SLOT_1):
    1'i8
  else:
    2'i8

proc isSlotUsed*(properties: ChiseledBookshelfLikeProperties, slot: int8): bool =
  case slot
  of 0:
    properties.slot0Occupied
  of 1:
    properties.slot1Occupied
  of 2:
    properties.slot2Occupied
  of 3:
    properties.slot3Occupied
  of 4:
    properties.slot4Occupied
  of 5:
    properties.slot5Occupied
  else:
    false

proc registerBlocksChiseledBookshelf*(r: BlockRegistry) =
  r.register("minecraft:chiseled_bookshelf", newChiseledBookshelfBlock())

