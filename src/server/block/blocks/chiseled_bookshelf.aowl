proc tryAddBook*(world: BlockWorld, player: BlockPlayer, position: BlockPos, entity: ChiseledBookshelfBlockEntity, properties: ChiseledBookshelfLikeProperties, slot: int8, item: ItemStack) =
  # TODO: Increment used stats for chiseled bookshelf on the player
  let t14 = block:
    if (item.getItem() == itemEnchantedBook()):
      sdBlockChiseledBookshelfPickupEnchanted
    else:
      sdBlockChiseledBookshelfPickup
  let sound = t14
  entity.setStack(int(slot), item.splitUnlessCreative(player.gamemode, 1))
  entity.updateState(properties, world, slot)
  world.playSound(sound, scBlocks, position.toCenteredF64())

proc tryRemoveBook*(world: BlockWorld, player: BlockPlayer, position: BlockPos, entity: ChiseledBookshelfBlockEntity, properties: ChiseledBookshelfLikeProperties, slot: int8) =
  var stack = entity.removeStackSpecific(int(slot), 1)
  let t15 = block:
    if (stack.getItem() == itemEnchantedBook()):
      sdBlockChiseledBookshelfPickupEnchanted
    else:
      sdBlockChiseledBookshelfPickup
  let sound = t15
  if (not player.getInventory().insertStackAnywhere(stack)):
    # Drop the item on the ground if the player cannot hold it because of a full inventory
    player.dropItem(stack)
  entity.updateState(properties, world, slot)
  world.playSound(sound, scBlocks, position.toCenteredF64())

proc getSlotForHit*(hit: BlockHitResult, facing: HorizontalFacing): Option[int8] =
  let t17 = getHitPos(hit, facing)
  var t18 = none[int8]()
  if t17.isSome:
    let position = t17.unsafeGet
    let t16 = block:
      let i = int8((position.y < 0.5))
      let j = getColumn(position.x)
      (j + (i * 3))
    t18 = some(t16)
  t18

proc getHitPos*(hit: BlockHitResult, facing: HorizontalFacing): Option[Vector2[float32]] =
  # If the direction is not horizontal, we cannot hit a slot
  let t19 = hit.face.toHorizontalFacing()
  if t19.isNone: return none[Vector2[float32]]()
  let direction = t19.unsafeGet
  # If the facing direction does not match the block's facing, we cannot hit a slot
  if (not (facing == direction)):
    return none[Vector2[float32]]()
  case direction
  of HorizontalFacing.North:
    some(newVector2((1.0 - hit.cursorPos.x), hit.cursorPos.y))
  of HorizontalFacing.South:
    some(newVector2(hit.cursorPos.x, hit.cursorPos.y))
  of HorizontalFacing.West:
    some(newVector2(hit.cursorPos.z, hit.cursorPos.y))
  of HorizontalFacing.East:
    some(newVector2((1.0 - hit.cursorPos.z), hit.cursorPos.y))

proc getColumn*(x: float32): int8 =
  if (x < OFFSET_SLOT_0):
    0'i8
  elif (x < OFFSET_SLOT_1):
    1'i8
  else:
    2'i8

proc isSlotUsed*(properties: ChiseledBookshelfLikeProperties, slot: int8): bool =
  case slot
  of 0:
    properties.slot0Occupied
  of 1:
    properties.slot1Occupied
  of 2:
    properties.slot2Occupied
  of 3:
    properties.slot3Occupied
  of 4:
    properties.slot4Occupied
  of 5:
    properties.slot5Occupied
  else:
    false

