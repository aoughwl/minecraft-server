## Port of pumpkin/src/block/blocks/cobweb.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  CobwebBlock* = object



proc cobwebBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc newCobwebBlock*(): BlockBehaviour

proc cobwebBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let entity = args.entity.getEntity()
  let t1 = block:
    let t2 = entity.getLivingEntity()
    if t2.isSome and t2.unsafeGet.hasEffect(StatusEffect.WEAVING):
      let living = t2.unsafeGet
      newVector3(0.5, 0.25, 0.5)
    else:
      newVector3(0.25, 0.05, 0.25)
  let vec = t1
  entity.slowMovement(args.state, vec)

proc newCobwebBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = cobwebBlockOnEntityCollision_BlockBehaviour

proc registerBlocksCobweb*(r: BlockRegistry) =
  r.register("minecraft:cobweb", newCobwebBlock())

