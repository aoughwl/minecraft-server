## Port of pumpkin/src/block/blocks/command.rs
## `execute` hands the command to `BlockWorld.runCommandBlock` (hook `runCommandBlock0`, backed in src/server/commandbridge.aowl): the dispatcher is a server object a block module cannot reach. Upstream's `warn!` lines are not logged.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/command_block
import ../entities/command_block as commandblockentity
import redstone/redstonemod
import ../../../util/permission


type
  CommandBlock* = object



proc getRelativeFacing*(world: BlockWorld, pos: BlockPos, dir: Facing): Option[(BlockPos, CommandBlockLikeProperties)] =
  let targetPos = pos.offset(dir.toBlockDirection().toOffset())
  let blockRef = world.getBlock(targetPos)
  let allowedBlocks = [blockCommandBlock().name, blockChainCommandBlock().name, blockRepeatingCommandBlock().name]
  if (not contains(allowedBlocks, blockRef.name)):
    return none[(BlockPos, CommandBlockLikeProperties)]()
  let stateId = world.getBlockStateId(targetPos)
  let props = CommandBlockLikeProperties.fromStateId(stateId, blockRef)
  some((targetPos, props))

proc conditionsMet*(world: BlockWorld, pos: BlockPos, facing: Facing): bool =
  let (blockRef, stateId) = world.getBlockAndStateId(pos)
  let props = CommandBlockLikeProperties.fromStateId(stateId, blockRef)
  if (not props.conditional):
    return true
  let t1 = getRelativeFacing(world, pos, facing.opposite())
  if not (t1.isSome):
    return false
  let before = t1.unsafeGet
  let t2 = world.getBlockEntity(before[0])
  if not (t2.isSome):
    discard
    return false
  let beforeEntity = t2.unsafeGet
  let t3 = beforeEntity.asType(CommandBlockEntity)
  if not (t3.isSome):
    discard
    return false
  let commandEntity = t3.unsafeGet
  commandEntity.successCount > 0'u32

proc update*(world: BlockWorld, blockRef: Block, commandBlock: CommandBlockEntity, pos: BlockPos, powered: bool) =
  let isAuto = commandBlock.auto
  if (commandBlock.powered == powered) and (not isAuto):
    return
  commandBlock.powered = powered
  if ((blockRef.id == blockChainCommandBlock().id) or (isAuto or (not powered))):
    return
  let stateId = world.getBlockStateId(pos)
  let props = CommandBlockLikeProperties.fromStateId(stateId, blockRef)
  if (not props.conditional):
    world.scheduleBlockTick(blockRef, pos, 1, tpNormal)
    return
  let t4 = getRelativeFacing(world, pos, props.facing.opposite())
  if not (t4.isSome):
    return
  let behind = t4.unsafeGet
  let t5 = world.getBlockEntity(behind[0])
  if not (t5.isSome):
    discard
    return
  let behindEntity = t5.unsafeGet.asType(CommandBlockEntity).get()
  if behindEntity.successCount > 0'u32:
    world.scheduleBlockTick(blockRef, pos, 1, tpNormal)

proc execute*(world: BlockWorld, blockEntity: BlockEntity, command: string) =
  if not world.commandBlocksWork():
    return
  let t7 = blockEntity.asType(CommandBlockEntity)
  if not t7.isSome:
    return
  let commandEntity = t7.unsafeGet
  if command.len == 0:
    commandEntity.successCount = 0'u32
  else:
    world.runCommandBlock(commandEntity.position, command)

proc chainExecute*(world: BlockWorld, start: BlockPos, direction: Facing) =
  var i = high(uint16)
  var pos = start
  while (i > 0):
    if not world.commandBlocksWork():
      return
    let blockRef = world.getBlock(pos)
    if (not (blockRef.id == blockChainCommandBlock().id)):
      break
    let t9 = world.getBlockEntity(pos)
    if not (t9.isSome):
      discard
      break
    let blockEntity = t9.unsafeGet
    let t10 = blockEntity.asType(CommandBlockEntity)
    if not (t10.isSome):
      discard
      break
    let commandEntity = t10.unsafeGet
    let powered = commandEntity.powered
    let auto = commandEntity.auto
    let stateId = world.getBlockStateId(pos)
    let props = CommandBlockLikeProperties.fromStateId(stateId, blockRef)
    if (powered or auto):
      let conditionsMet = conditionsMet(world, pos, direction)
      if conditionsMet:
        let t11 = world.getBlockEntity(pos)
        if not (t11.isSome):
          discard
          break
        let entity = t11.unsafeGet
        execute(world, entity, commandEntity.command)
      elif props.conditional:
        commandEntity.successCount = 0'u32
    pos = pos.offset(direction.toBlockDirection().toOffset())
    i -= 1

proc commandBlockIds*(): seq[BlockId] =
  @[blockIdCommandBlock, blockIdChainCommandBlock, blockIdRepeatingCommandBlock]

proc commandBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = CommandBlockLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getEntity().getFacing().opposite()
  props.toStateId(args.block0)

proc commandBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  if (args.player.permissionLvl() < PermissionLvl.Two):
    return barPass
  let t12 = args.world.getBlockEntity(args.position)
  if not (t12.isSome):
    return barPass
  let blockEntity = t12.unsafeGet
  args.world.updateBlockEntity(blockEntity)
  barSuccessServer

proc commandBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if not args.world.commandBlocksWork():
    return
  let t14 = args.world.getBlockEntity(args.position)
  if t14.isSome:
    let blockEntity = t14.unsafeGet
    if (not (t14.unsafeGet.resourceLocation() == commandblockentity.ID)):
      return
    let t15 = t14.unsafeGet.asType(CommandBlockEntity)
    if not (t15.isSome):
      discard
      return
    let commandEntity = t15.unsafeGet
    update(args.world, args.block0, commandEntity, args.position, blockReceivesRedstonePower(args.world, args.position))

proc commandBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if not args.world.commandBlocksWork():
    return
  let t17 = args.world.getBlockEntity(args.position)
  if not (t17.isSome):
    return
  let blockEntity = t17.unsafeGet
  if (not (blockEntity.resourceLocation() == commandblockentity.ID)):
    return
  let t18 = blockEntity.asType(CommandBlockEntity)
  if not (t18.isSome):
    discard
    return
  let commandEntity = t18.unsafeGet
  let props = CommandBlockLikeProperties.fromStateId(args.world.getBlockStateId(args.position), args.block0)
  execute(args.world, blockEntity, commandEntity.command)
  chainExecute(args.world, args.position.offset(props.facing.toBlockDirection().toOffset()), props.facing)
  let blockRef = args.world.getBlock(args.position)
  let isAuto = commandEntity.auto
  let canRun = (commandEntity.powered or isAuto)
  if (blockRef == blockRepeatingCommandBlock()) and canRun:
    args.world.scheduleBlockTick(blockRef, args.position, 1, tpNormal)

proc commandBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t20 = args.player
  if t20.isSome and (t20.unsafeGet.gamemode == GameMode.Creative):
    let player = t20.unsafeGet
    return true
  false

proc commandBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let sendCommandFeedback = args.world.sendCommandFeedback()
  let entity = newCommandBlockEntity(args.position, sendCommandFeedback, (args.block0.id == blockChainCommandBlock().id))
  args.world.addBlockEntity(entity)

proc commandBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let entity = args.world.getBlockEntity(args.position)
  if entity.isNone:
    return none[uint8]()
  let commandBlockEntity = entity.unsafeGet.asType(CommandBlockEntity).get()
  some(uint8(commandBlockEntity.successCount and 0xFF'u32))

proc newCommandBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = commandBlockOnPlace_BlockBehaviour
  result.normalUseImpl = commandBlockNormalUse_BlockBehaviour
  result.onNeighborUpdateImpl = commandBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = commandBlockOnScheduledTick_BlockBehaviour
  result.canPlaceAtImpl = commandBlockCanPlaceAt_BlockBehaviour
  result.placedImpl = commandBlockPlaced_BlockBehaviour
  result.getComparatorOutputImpl = commandBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksCommand*(r: BlockRegistry) =
  r.registerIds(commandBlockIds(), newCommandBlock())

