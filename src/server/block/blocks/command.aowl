import ../blockprelude
import ../entities/command_block
import redstone/redstonemod


type
  CommandBlock* = object



proc getRelativeFacing*(world: BlockWorld, pos: BlockPos, dir: Facing): Option[(BlockPos, CommandBlockLikeProperties)]
proc conditionsMet*(world: BlockWorld, pos: BlockPos, facing: Facing): bool
proc update*(world: BlockWorld, blockRef: Block, commandBlock: CommandBlockEntity, pos: BlockPos, powered: bool)
proc execute*(server: BlockServer, world: BlockWorld, blockEntity: BlockEntity, command: string)
proc chainExecute*(server: BlockServer, world: BlockWorld, start: BlockPos, direction: Facing)
