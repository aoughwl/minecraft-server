## Port of pumpkin/src/block/blocks/composter.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/composter_increase_chance

proc updateLevelComposter*(world: BlockWorld, location: BlockPos, stateId: BlockStateId, blockRef: Block, level: uint8) =
  var props = ComposterLikeProperties.fromStateId(stateId, blockRef)
  props.level = level
  discard world.setBlockState(location, props.toStateId(blockRef), BfNotifyAll)
  if level == 7'u8:
    world.scheduleBlockTick(blockRef, location, 20'u8, tpNormal)

proc clearComposter*(world: BlockWorld, location: BlockPos, stateId: BlockStateId, blockRef: Block) =
  updateLevelComposter(world, location, stateId, blockRef, 0'u8)
  let c = location.toCenteredF64()
  let itemPosition = c.addRaw(randomRange(-0.35 .. 0.35), randomRange(-0.35 .. 0.35) + 0.51, randomRange(-0.35 .. 0.35))
  let boneMeal = Item.fromRegistryKey("bone_meal")
  if boneMeal != nil:
    world.spawnItem(itemPosition, newItemStack(1'u8, boneMeal))

proc composterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  let props = ComposterLikeProperties.fromStateId(stateId, args.block0)
  if props.level == 8'u8:
    clearComposter(args.world, args.position, stateId, args.block0)
  barPass

proc composterBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  let props = ComposterLikeProperties.fromStateId(stateId, args.block0)
  let level = props.level
  # Check if the composter is full
  if level == 8'u8:
    clearComposter(args.world, args.position, stateId, args.block0)
    return barConsume
  let itemId = uint16(args.itemStack.stack.item.id)
  # Check if the item is consumable by the composter
  let chance = getComposterIncreaseChanceFromItemId(itemId)
  if chance.isNone:
    return barPass
  # Consume one item from the stack (if in survival mode)
  if args.player.gamemode() != GameMode.Creative:   # `has_infinite_materials`
    args.itemStack.stack.decrement(1'u8)
  # Determine if the composter level should increase
  if level < 7'u8 and (level == 0'u8 or BlockRng().randomBool(float64(chance.unsafeGet))):
    updateLevelComposter(args.world, args.position, stateId, args.block0, level + 1'u8)
    args.world.syncWorldEvent(weComposterFill, args.position, 1'i32)
  # Consume the item
  barConsume

proc composterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let stateId = args.world.getBlockStateId(args.position)
  let props = ComposterLikeProperties.fromStateId(stateId, args.block0)
  let level = props.level
  if level == 7'u8:
    updateLevelComposter(args.world, args.position, stateId, args.block0, level + 1'u8)

proc composterBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let props = ComposterLikeProperties.fromStateId(args.state.id, args.block0)
  some(props.level)

proc newComposterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = composterBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = composterBlockUseWithItem_BlockBehaviour
  result.onScheduledTickImpl = composterBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = composterBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksComposter*(r: BlockRegistry) =
  r.register("minecraft:composter", newComposterBlock())
