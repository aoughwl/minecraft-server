import ../blockprelude
import ../entities/conduit


type
  ConduitBlock* = object



proc conduitBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc conduitBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newConduitBlock*(): BlockBehaviour

proc conduitBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = MangroveRootsLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  props.toStateId(args.block0)

proc conduitBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newConduitBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc newConduitBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = conduitBlockOnPlace_BlockBehaviour
  result.placedImpl = conduitBlockPlaced_BlockBehaviour

proc registerBlocksConduit*(r: BlockRegistry) =
  r.register("minecraft:conduit", newConduitBlock())

