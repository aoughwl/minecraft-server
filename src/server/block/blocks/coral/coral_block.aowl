## Port of pumpkin/src/block/blocks/coral/coral_block.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import coralmod


type
  CoralBlock* = object



proc coralBlockIds*(): seq[BlockId]
proc coralBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc coralBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newCoralBlock*(): BlockBehaviour
proc getDeadCoralBlockType*(id: BlockId): Option[Block]

proc coralBlockIds*(): seq[BlockId] =
  let alivePlants = Block_MINECRAFT_CORAL_BLOCKS.resolve().ids
  var plants = newSeq[BlockId]()
  for alivePlantId in alivePlants:
    let blockId = newBlockIdOrAir(alivePlantId)
    plants.add(blockId)
    plants.add(getDeadCoralBlockType(blockId).get().id)
  plants

proc coralBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (not scanForWater(args.world, args.position)) and (not isDeadCoral(args.block0)):
    tryScheduleDieTick(args.block0, args.world, args.position)

proc coralBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not scanForWater(args.world, args.position)) and (not isDeadCoral(args.block0)):
    let deadBlockStateId = getDeadCoralBlockType(args.block0.id).get().defaultState.id
    discard args.world.setBlockState(args.position, deadBlockStateId, 0'u32)

proc newCoralBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = coralBlockPlaced_BlockBehaviour
  result.onScheduledTickImpl = coralBlockOnScheduledTick_BlockBehaviour

proc getDeadCoralBlockType*(id: BlockId): Option[Block] =
  # `case` over distinct `BlockId` constants does not reach C as integer labels, so these are compared one by one
  if id == blockIdBrainCoralBlock:
    return some(blockDeadBrainCoralBlock())
  if id == blockIdBubbleCoralBlock:
    return some(blockDeadBubbleCoralBlock())
  if id == blockIdFireCoralBlock:
    return some(blockDeadFireCoralBlock())
  if id == blockIdHornCoralBlock:
    return some(blockDeadHornCoralBlock())
  if id == blockIdTubeCoralBlock:
    return some(blockDeadTubeCoralBlock())
  none[Block]()

proc registerBlocksCoralCoralBlock*(r: BlockRegistry) =
  r.registerIds(coralBlockIds(), newCoralBlock())

