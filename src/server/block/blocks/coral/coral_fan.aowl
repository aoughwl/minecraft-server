{.feature: "lenientnils".}

import ../../blockprelude
import coralmod


type
  CoralFanBlock* = object
  CoralWallFanLikeProperties* = LadderLikeProperties
  CoralFanLikeProperties* = MangroveRootsLikeProperties



proc coralFanBlockIds*(): seq[BlockId]
proc coralFanBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc coralFanBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc coralFanBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc coralFanBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc coralFanBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newCoralFanBlock*(): BlockBehaviour
proc getDefaultCoralFanStateId*(blockRef: Block, waterlogged: bool): BlockStateId
proc isWallFan*(blockRef: Block): bool
proc getDeadType*(id: BlockId): Option[Block]
proc getCorrespondingWallFanType*(id: BlockId): Option[Block]
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: HorizontalFacing): bool

proc coralFanBlockIds*(): seq[BlockId] =
  let aliveWallFans: seq[BlockId] = Block_MINECRAFT_WALL_CORALS[1].map(R2A_MANUAL("closure |v| BlockId.newOrAir(v)")).collect()
  let aliveCoralFans: seq[BlockId] = [blockIdBrainCoralFan, blockIdBubbleCoralFan, blockIdFireCoralFan, blockIdHornCoralFan, blockIdTubeCoralFan]
  let aliveFans = [aliveWallFans, aliveCoralFans].concat()
  var plants = @[]
  for aliveFanId in aliveFans:
    plants.add(aliveFanId)
    plants.add(getDeadType(aliveFanId).get().id)
  plants

proc coralFanBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if supportBlock.isCenterSolid(BlockDirection.Up):
      return getDefaultCoralFanStateId(args.block0, args.replacing.waterSource())
  var directions = args.player.getEntity().getEntityFacingOrder()
  if (args.replacing == BlockIsReplacing(kind: BlockIsReplacingKind.kNone)):
    let face = args.direction.toFacing()
    var i = 0
    while ((i < len(directions)) and (directions[i] != face)):
      i += 1
    if (i > 0):
      directions.copyWithin(0 ..< i, 1)
      directions[0] = face
  elif (directions[0] == Facing.Down):
    let supportBlock1 = args.world.getBlockState(args.position.down())
    if supportBlock1.isCenterSolid(BlockDirection.Up):
      return getDefaultCoralFanStateId(args.block0, args.replacing.waterSource())
  for dir in directions:
    if (dir != Facing.Up) and (dir != Facing.Down) and canPlaceAt(args.world, args.position, dir.toHorizontalFacing().get()):
      let t3 = getCorrespondingWallFanType(args.block0.id)
      if not (t3.isSome):
        return blockStateIdAir
      let wallBlock = t3.unsafeGet
      var coralWallFanProps = CoralWallFanLikeProperties.defaultFor(wallBlock)
      coralWallFanProps.waterlogged = args.replacing.waterSource()
      coralWallFanProps.facing = dir.opposite().toHorizontalFacing().get()
      return coralWallFanProps.toStateId(wallBlock)
  let supportBlock2 = args.world.getBlockState(args.position.down())
  if supportBlock2.isCenterSolid(BlockDirection.Up):
    return getDefaultCoralFanStateId(args.block0, args.replacing.waterSource())
  blockStateIdAir

proc coralFanBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (not scanForWater(args.world, args.position)):
    tryScheduleDieTick(args.block0, args.world, args.position)

proc coralFanBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not scanForWater(args.world, args.position)) and (not isDeadCoral(args.block0)):
    let currentState = args.world.getBlockState(args.position)
    # VANILLA FIX: Explicitly set waterlogged to false when dying
    let t4 = block:
      if isWallFan(args.block0):
        var props = CoralWallFanLikeProperties.fromStateId(currentState.id, args.block0)
        props.waterlogged = false
        props.toStateId(getDeadType(args.block0.id).get())
      else:
        var props1 = CoralFanLikeProperties.fromStateId(currentState.id, args.block0)
        props1.waterlogged = false
        props1.toStateId(getDeadType(args.block0.id).get())
    let deadBlockStateId = t4
    discard args.world.setBlockState(args.position, deadBlockStateId, 0'u32)

proc coralFanBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let supportBlock = args.blockAccessor.getBlockState(args.position.down())
  if supportBlock.isCenterSolid(BlockDirection.Up) and (not isWallFan(args.block0)):
    return true
  let t5 = blockDirectionHorizontal()
  for dir in t5:
    if canPlaceAt(args.blockAccessor, args.position, dir):
      return true
  false

proc coralFanBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if isWallFan(args.block0):
    let props = CoralWallFanLikeProperties.fromStateId(args.stateId, args.block0)
    if (props.facing.toBlockDirection().opposite() == args.direction) and (not canPlaceAt(args.world, args.position, props.facing.opposite())):
      return blockStateIdAir
  elif (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if (not supportBlock.isCenterSolid(BlockDirection.Up)):
      return blockStateIdAir
  args.stateId

proc newCoralFanBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = coralFanBlockOnPlace_BlockBehaviour
  result.placedImpl = coralFanBlockPlaced_BlockBehaviour
  result.onScheduledTickImpl = coralFanBlockOnScheduledTick_BlockBehaviour
  result.canPlaceAtImpl = coralFanBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = coralFanBlockGetStateForNeighborUpdate_BlockBehaviour

proc getDefaultCoralFanStateId*(blockRef: Block, waterlogged: bool): BlockStateId =
  var props = CoralFanLikeProperties.defaultFor(blockRef)
  props.waterlogged = waterlogged
  props.toStateId(blockRef)

proc isWallFan*(blockRef: Block): bool =
  (((((blockRef.hasTag(Block_MINECRAFT_WALL_CORALS) or (blockRef == blockDeadBrainCoralWallFan())) or (blockRef == blockDeadBubbleCoralWallFan())) or (blockRef == blockDeadFireCoralWallFan())) or (blockRef == blockDeadHornCoralWallFan())) or (blockRef == blockDeadTubeCoralWallFan()))

proc getDeadType*(id: BlockId): Option[Block] =
  case id
  of blockIdBrainCoralFan:
    some(blockDeadBrainCoralFan())
  of blockIdBrainCoralWallFan:
    some(blockDeadBrainCoralWallFan())
  of blockIdBubbleCoralFan:
    some(blockDeadBubbleCoralFan())
  of blockIdBubbleCoralWallFan:
    some(blockDeadBubbleCoralWallFan())
  of blockIdFireCoralFan:
    some(blockDeadFireCoralFan())
  of blockIdFireCoralWallFan:
    some(blockDeadFireCoralWallFan())
  of blockIdHornCoralFan:
    some(blockDeadHornCoralFan())
  of blockIdHornCoralWallFan:
    some(blockDeadHornCoralWallFan())
  of blockIdTubeCoralFan:
    some(blockDeadTubeCoralFan())
  of blockIdTubeCoralWallFan:
    some(blockDeadTubeCoralWallFan())
  else:
    none[Block]()

proc getCorrespondingWallFanType*(id: BlockId): Option[Block] =
  case id
  of blockIdTubeCoralFan:
    some(blockTubeCoralWallFan())
  of blockIdBrainCoralFan:
    some(blockBrainCoralWallFan())
  of blockIdBubbleCoralFan:
    some(blockBubbleCoralWallFan())
  of blockIdFireCoralFan:
    some(blockFireCoralWallFan())
  of blockIdHornCoralFan:
    some(blockHornCoralWallFan())
  of blockIdDeadTubeCoralFan:
    some(blockDeadTubeCoralWallFan())
  of blockIdDeadBrainCoralFan:
    some(blockDeadBrainCoralWallFan())
  of blockIdDeadBubbleCoralFan:
    some(blockDeadBubbleCoralWallFan())
  of blockIdDeadFireCoralFan:
    some(blockDeadFireCoralWallFan())
  of blockIdDeadHornCoralFan:
    some(blockDeadHornCoralWallFan())
  else:
    none[Block]()

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: HorizontalFacing): bool =
  world.getBlockState(blockPos.offset(facing.toOffset())).isSideSolid(facing.opposite().toBlockDirection())

proc registerBlocksCoralCoralFan*(r: BlockRegistry) =
  r.registerIds(coralFanBlockIds(), newCoralFanBlock())

