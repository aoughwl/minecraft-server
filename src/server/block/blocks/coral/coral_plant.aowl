## Port of pumpkin/src/block/blocks/coral/coral_plant.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import coralmod


type
  CoralPlantBlock* = object
  CoralPlantLikeProperties* = MangroveRootsLikeProperties



proc coralPlantBlockIds*(): seq[BlockId]
proc coralPlantBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc coralPlantBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc coralPlantBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc coralPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc coralPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newCoralPlantBlock*(): BlockBehaviour
proc getDeadType*(id: BlockId): Option[BlockId]

proc coralPlantBlockIds*(): seq[BlockId] =
  let alivePlants = Block_MINECRAFT_CORAL_PLANTS[1]
  var plants = @[]
  for alivePlantId in alivePlants:
    let blockId = BlockId.newOrAir(alivePlantId)
    plants.add(blockId)
    plants.add(getDeadType(blockId).unwrapOrDefault())
  plants

proc coralPlantBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = CoralPlantLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  props.toStateId(args.block0)

proc coralPlantBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (not scanForWater(args.world, args.position)) and (not isDeadCoral(args.block0)):
    tryScheduleDieTick(args.block0, args.world, args.position)

proc coralPlantBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not scanForWater(args.world, args.position)) and (not isDeadCoral(args.block0)):
    let currentState = args.world.getBlockState(args.position)
    let t1 = block:
      let props = CoralPlantLikeProperties.fromStateId(currentState.id, args.block0)
      props.toStateId(getDeadType(args.block0.id).unwrapOrDefault().toBlock())
    let deadBlockStateId = t1
    discard args.world.setBlockState(args.position, deadBlockStateId, 0'u32)

proc coralPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let supportBlock = args.blockAccessor.getBlockState(args.position.down())
  if supportBlock.isCenterSolid(BlockDirection.Up):
    return true
  false

proc coralPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if (not supportBlock.isCenterSolid(BlockDirection.Up)):
      return blockStateIdAir
  args.stateId

proc newCoralPlantBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = coralPlantBlockOnPlace_BlockBehaviour
  result.placedImpl = coralPlantBlockPlaced_BlockBehaviour
  result.onScheduledTickImpl = coralPlantBlockOnScheduledTick_BlockBehaviour
  result.canPlaceAtImpl = coralPlantBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = coralPlantBlockGetStateForNeighborUpdate_BlockBehaviour

proc getDeadType*(id: BlockId): Option[BlockId] =
  case id
  of blockIdBrainCoral:
    some(blockIdDeadBrainCoral)
  of blockIdBubbleCoral:
    some(blockIdDeadBubbleCoral)
  of blockIdFireCoral:
    some(blockIdDeadFireCoral)
  of blockIdHornCoral:
    some(blockIdDeadHornCoral)
  of blockIdTubeCoral:
    some(blockIdDeadTubeCoral)
  else:
    none[BlockId]()

proc registerBlocksCoralCoralPlant*(r: BlockRegistry) =
  r.registerIds(coralPlantBlockIds(), newCoralPlantBlock())

