import ../../blockprelude




proc scanForWater*(world: BlockWorld, pos: BlockPos): bool
proc isDeadCoral*(blockRef: Block): bool
proc tryScheduleDieTick*(blockRef: Block, world: BlockWorld, pos: BlockPos)

proc scanForWater*(world: BlockWorld, pos: BlockPos): bool =
  let t1 = blockDirectionAll()
  for direction in t1:
    let neighborPos = pos.offset(direction.toOffset())
    let blockRef = world.getFluid(neighborPos)
    if blockRef.hasTag(Fluid_MINECRAFT_WATER):
      return true
  false

proc isDeadCoral*(blockRef: Block): bool =
  ((((((((((((((((((((blockRef == blockDeadBrainCoral()) or (blockRef == blockDeadBubbleCoral())) or (blockRef == blockDeadFireCoral())) or (blockRef == blockDeadHornCoral())) or (blockRef == blockDeadTubeCoral())) or (blockRef == blockDeadBrainCoralBlock())) or (blockRef == blockDeadBubbleCoralBlock())) or (blockRef == blockDeadFireCoralBlock())) or (blockRef == blockDeadHornCoralBlock())) or (blockRef == blockDeadTubeCoralBlock())) or (blockRef == blockDeadBrainCoralFan())) or (blockRef == blockDeadBrainCoralWallFan())) or (blockRef == blockDeadBubbleCoralFan())) or (blockRef == blockDeadBubbleCoralWallFan())) or (blockRef == blockDeadFireCoralFan())) or (blockRef == blockDeadFireCoralWallFan())) or (blockRef == blockDeadHornCoralFan())) or (blockRef == blockDeadHornCoralWallFan())) or (blockRef == blockDeadTubeCoralFan())) or (blockRef == blockDeadTubeCoralWallFan()))

proc tryScheduleDieTick*(blockRef: Block, world: BlockWorld, pos: BlockPos) =
  let tickDelay = (60 + rng().randomRange(0 ..< 40))
  world.scheduleBlockTick(blockRef, pos, uint8(tickDelay), tpNormal)

