## Port of pumpkin/src/block/blocks/crafting_table.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  CraftingTableBlock* = object
  CraftingTableScreenFactory* = R2A_MANUAL_tuple_struct



proc craftingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc newCraftingTableBlock*(): BlockBehaviour
proc createScreenHandler*(self: CraftingTableScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: CraftingTableScreenFactory): TextComponent

proc craftingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithCraftingTable), 1)
  args.player.openHandledScreen(CraftingTableScreenFactory(args.server.recipeManager), some(args.position))
  barSuccess

proc newCraftingTableBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = craftingTableBlockNormalUse_BlockBehaviour

proc createScreenHandler*(self: CraftingTableScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = newCraftingTableScreenHandler(syncId, playerInventory, some(self[0]))
  let concreteArc = handler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: CraftingTableScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_CRAFTING, CONTAINER_CRAFTING, [])

proc registerBlocksCraftingTable*(r: BlockRegistry) =
  r.register("minecraft:crafting_table", newCraftingTableBlock())

