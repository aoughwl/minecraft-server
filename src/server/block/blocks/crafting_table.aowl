## Port of pumpkin/src/block/blocks/crafting_table.rs
## `args.server.recipe_manager` is `gBlockRecipeProvider` (containers.aowl), set by installBlockHooks: `BlockServer` holds no server.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/crafting_screen_handler

proc craftingTableScreenFactory(): BlockScreenFactory =
  ## `CraftingTableScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_CRAFTING, BEDROCK_CONTAINER_CRAFTING),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(newCraftingTableScreenHandler(syncId, playerInventory, gBlockRecipeProvider)))

proc craftingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithCraftingTable), 1)
  args.player.openHandledScreen(craftingTableScreenFactory(), some(args.position))
  barSuccess

proc newCraftingTableBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = craftingTableBlockNormalUse_BlockBehaviour

proc registerBlocksCraftingTable*(r: BlockRegistry) =
  r.register("minecraft:crafting_table", newCraftingTableBlock())
