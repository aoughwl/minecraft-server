## Port of pumpkin/src/block/blocks/dirt_path.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  DirtPathBlock* = object



proc dirtPathBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc dirtPathBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc dirtPathBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc dirtPathBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newDirtPathBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool

proc dirtPathBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  # TODO: push up entities
  discard args.world.setBlockState(args.position, blockDirt().defaultState.id, BfNotifyAll)

proc dirtPathBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    return blockDirt().defaultState.id
  args.block0.defaultState.id

proc dirtPathBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.direction == BlockDirection.Up) and (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc dirtPathBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc newDirtPathBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onScheduledTickImpl = dirtPathBlockOnScheduledTick_BlockBehaviour
  result.onPlaceImpl = dirtPathBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = dirtPathBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = dirtPathBlockCanPlaceAt_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let state = world.getBlockState(blockPos.up())
  (not state.isSolid())

proc registerBlocksDirtPath*(r: BlockRegistry) =
  r.register("minecraft:dirt_path", newDirtPathBlock())

