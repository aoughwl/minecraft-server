## Port of pumpkin/src/block/blocks/doors.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import redstone/redstonemod


type
  DoorProperties = OakDoorLikeProperties
  DoorBlock* = object



proc toggleDoor*(player: BlockPlayer, world: BlockWorld, blockPos: BlockPos)
proc canOpenDoor*(blockRef: Block): bool
proc getSound*(blockRef: Block, open: bool): Sound
proc getHinge*(world: BlockWorld, pos: BlockPos, useItem: SUseItemOn, facing: HorizontalFacing): DoorHinge
proc doorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc doorBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc doorBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc doorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc doorBlockBroken_BlockBehaviour(args: BrokenArgs)
proc doorBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc doorBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc doorBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newDoorBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool

proc toggleDoor*(player: BlockPlayer, world: BlockWorld, blockPos: BlockPos) =
  let (blockRef, blockState) = world.getBlockAndStateId(blockPos)
  var doorProps = DoorProperties.fromStateId(blockState, blockRef)
  doorProps.open = (not doorProps.open)
  let t1 = block:
    case doorProps.half
    of DoubleBlockHalf.Upper:
      BlockDirection.Down
    of DoubleBlockHalf.Lower:
      BlockDirection.Up
  let otherHalf = t1
  let otherPos = blockPos.offset(otherHalf.toOffset())
  let (otherBlock, otherStateId) = world.getBlockAndStateId(otherPos)
  var otherDoorProps = DoorProperties.fromStateId(otherStateId, otherBlock)
  otherDoorProps.open = doorProps.open
  world.playBlockSoundExpect(player, getSound(blockRef, doorProps.open), scBlocks, blockPos)
  discard world.setBlockState(blockPos, doorProps.toStateId(blockRef), BfNotifyListeners)
  discard world.setBlockState(otherPos, otherDoorProps.toStateId(otherBlock), BfNotifyListeners)

proc canOpenDoor*(blockRef: Block): bool =
  if (blockRef == blockIronDoor()):
    return false
  true

proc getSound*(blockRef: Block, open: bool): Sound =
  if open:
    if blockRef.hasTag(Block_MINECRAFT_WOODEN_DOORS):
      sdBlockWoodenDoorOpen
    elif (blockRef == blockIronDoor()):
      sdBlockIronDoorOpen
    else:
      sdBlockCopperDoorOpen
  elif blockRef.hasTag(Block_MINECRAFT_WOODEN_DOORS):
    sdBlockWoodenDoorClose
  elif (blockRef == blockIronDoor()):
    sdBlockIronDoorClose
  else:
    sdBlockCopperDoorClose

proc getHinge*(world: BlockWorld, pos: BlockPos, useItem: SUseItemOn, facing: HorizontalFacing): DoorHinge =
  let topPos = pos.up()
  let leftDir = facing.rotateCounterClockwise()
  let leftPos = pos.offset(leftDir.toOffset())
  let (leftBlock, leftState) = world.getBlockAndState(leftPos)
  let topFacing = topPos.offset(facing.toOffset())
  let topState = world.getBlockState(topFacing)
  let rightDir = facing.rotateClockwise()
  let rightPos = pos.offset(rightDir.toOffset())
  let (rightBlock, rightState) = world.getBlockAndState(rightPos)
  let topRight = topPos.offset(facing.toOffset())
  let topRightState = world.getBlockState(topRight)
  let hasLeftDoor = (world.getBlock(leftPos).hasTag(Block_MINECRAFT_DOORS) and (DoorProperties.fromStateId(leftState.id, leftBlock).half == DoubleBlockHalf.Lower))
  let hasRightDoor = (world.getBlock(rightPos).hasTag(Block_MINECRAFT_DOORS) and (DoorProperties.fromStateId(rightState.id, rightBlock).half == DoubleBlockHalf.Lower))
  let score = ((((-(int32(leftState.isFullCube()))) - (int32(topState.isFullCube()))) + int32(rightState.isFullCube())) + int32(topRightState.isFullCube()))
  if (((not hasLeftDoor) or hasRightDoor)) and (score <= 0):
    if (((not hasRightDoor) or hasLeftDoor)) and (score >= 0):
      let offset = facing.toOffset()
      let hit = useItem.cursorPos
      if (((offset.x >= 0) or (hit.z > 0.5))) and (((offset.x <= 0) or (hit.z < 0.5))) and (((offset.z >= 0) or (hit.x < 0.5))) and (((offset.z <= 0) or (hit.x > 0.5))):
        DoorHinge.Left
      else:
        DoorHinge.Right
    else:
      DoorHinge.Left
  else:
    DoorHinge.Right

proc doorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let powered = (blockReceivesRedstonePower(args.world, args.position) or blockReceivesRedstonePower(args.world, args.position.up()))
  let direction = args.player.getEntity().getHorizontalFacing()
  let hinge = getHinge(args.world, args.position, args.useItemOn, direction)
  var doorProps = DoorProperties.defaultFor(args.block0)
  doorProps.half = DoubleBlockHalf.Lower
  doorProps.facing = direction
  doorProps.hinge = hinge
  doorProps.powered = powered
  doorProps.open = powered
  doorProps.toStateId(args.block0)

proc doorBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc doorBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  var doorProps = DoorProperties.fromStateId(args.stateId, args.block0)
  doorProps.half = DoubleBlockHalf.Upper
  discard args.world.setBlockState(args.position.offset(BlockDirection.Up.toOffset()), doorProps.toStateId(args.block0), (BfNotifyAll or BfSkipBlockAddedCallback))

proc doorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  if (not canOpenDoor(args.block0)):
    return barPass
  toggleDoor(args.player, args.world, args.position)
  barSuccess

proc doorBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let doorProps = DoorProperties.fromStateId(args.state.id, args.block0)
  let t2 = block:
    case doorProps.half
    of DoubleBlockHalf.Upper:
      args.position.down()
    of DoubleBlockHalf.Lower:
      args.position.up()
  let otherHalfPos = t2
  let neighborStateId = args.world.getBlockStateId(otherHalfPos)
  if (not (neighborStateId.toBlockId() == args.block0.id)):
    args.world.updateNeighbors(otherHalfPos, none[BlockDirection]())
    return
  let isCreative = (args.player.gamemode == GameMode.Creative)
  let t3 = block:
    if (doorProps.half == DoubleBlockHalf.Upper) and (not isCreative):
      BfNotifyAll
    else:
      (BfSkipDrops or BfNotifyAll)
  let flags = t3
  discard args.world.breakBlock(otherHalfPos, args.player, flags)

proc doorBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let blockState = args.world.getBlockState(args.position)
  var doorProps = DoorProperties.fromStateId(blockState.id, args.block0)
  let t4 = block:
    case doorProps.half
    of DoubleBlockHalf.Upper:
      BlockDirection.Down
    of DoubleBlockHalf.Lower:
      BlockDirection.Up
  let otherHalf = t4
  let otherPos = args.position.offset(otherHalf.toOffset())
  let (otherBlock, otherStateId) = args.world.getBlockAndStateId(otherPos)
  if (not (otherBlock.id == args.block0.id)):
    return
  let powered = (blockReceivesRedstonePower(args.world, args.position) or blockReceivesRedstonePower(args.world, otherPos))
  if (args.block0.id == otherBlock.id) and (not (powered == doorProps.powered)):
    var otherDoorProps = DoorProperties.fromStateId(otherStateId, otherBlock)
    doorProps.powered = (not doorProps.powered)
    otherDoorProps.powered = doorProps.powered
    if (not (powered == doorProps.open)):
      doorProps.open = doorProps.powered
      otherDoorProps.open = otherDoorProps.powered
      args.world.playBlockSound(getSound(args.block0, powered), scBlocks, args.position)
    discard args.world.setBlockState(args.position, doorProps.toStateId(args.block0), BfNotifyAll)
    discard args.world.setBlockState(otherPos, otherDoorProps.toStateId(otherBlock), BfNotifyAll)

proc doorBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let lv = DoorProperties.fromStateId(args.stateId, args.block0).half
  if ((not (args.direction.toAxis() == BlockAxis.Y)) or (not (((lv == DoubleBlockHalf.Lower)) == ((args.direction == BlockDirection.Up))))):
    if (lv == DoubleBlockHalf.Lower) and (args.direction == BlockDirection.Down) and (not canPlaceAt(args.world, args.position)):
      return blockStateIdAir
  else:
    if (Block.fromStateId(args.neighborStateId).id == args.block0.id) and (not (DoorProperties.fromStateId(args.neighborStateId, args.block0).half == lv)):
      var newState = DoorProperties.fromStateId(args.neighborStateId, args.block0)
      newState.half = lv
      return newState.toStateId(args.block0)
    else:
      return blockStateIdAir
  args.stateId

proc doorBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if args.moved:
    return
  let newStateId = args.world.getBlockStateId(args.position)
  let newBlock = Block.fromStateId(newStateId)
  if (newBlock == blockAir()):
    return
  let doorProps = DoorProperties.fromStateId(args.oldStateId, args.block0)
  let t5 = block:
    case doorProps.half
    of DoubleBlockHalf.Upper:
      args.position.down()
    of DoubleBlockHalf.Lower:
      args.position.up()
  let otherHalfPos = t5
  discard args.world.breakBlock(otherHalfPos, nil, (BfSkipDrops or BfNotifyAll))

proc newDoorBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = doorBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = doorBlockCanPlaceAt_BlockBehaviour
  result.placedImpl = doorBlockPlaced_BlockBehaviour
  result.normalUseImpl = doorBlockNormalUse_BlockBehaviour
  result.brokenImpl = doorBlockBroken_BlockBehaviour
  result.onNeighborUpdateImpl = doorBlockOnNeighborUpdate_BlockBehaviour
  result.getStateForNeighborUpdateImpl = doorBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onStateReplacedImpl = doorBlockOnStateReplaced_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  (world.getBlockState(blockPos.up()).replaceable() and world.getBlockState(blockPos.down()).isSideSolid(BlockDirection.Up))

proc registerBlocksDoors*(r: BlockRegistry) =
  r.registerTag("minecraft:doors", newDoorBlock())

