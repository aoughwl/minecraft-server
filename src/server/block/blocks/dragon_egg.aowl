import ../blockprelude
import falling


type
  DragonEggBlock* = object



proc teleport*(self: DragonEggBlock, world: BlockWorld, pos: BlockPos)
proc dragonEggBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc dragonEggBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc dragonEggBlockBroken_BlockBehaviour(args: BrokenArgs)
proc dragonEggBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newDragonEggBlock*(): BlockBehaviour

proc teleport*(self: DragonEggBlock, world: BlockWorld, pos: BlockPos) =
  for _ in 0 ..< 1000:
    let x = (pos.vec.x + rng().randomRange((-16) ..< 16))
    let y = (pos.vec.y + rng().randomRange((-8) ..< 8))
    let z = (pos.vec.z + rng().randomRange((-16) ..< 16))
    let testPos = newBlockPos(x, y, z)
    let state = world.getBlockState(testPos)
    let belowState = world.getBlockState(testPos.down())
    if state.isAir() and (not belowState.isAir()):
      let currentState = world.getBlockState(pos)
      discard world.setBlockState(testPos, currentState.id, BfNotifyAll)
      discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyAll)
      return

proc dragonEggBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.scheduleBlockTick(args.block0, args.position, 5, tpNormal)

proc dragonEggBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let self = DragonEggBlock()
  self.teleport(args.world, args.position)
  barSuccess

proc dragonEggBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let self = DragonEggBlock()
  self.teleport(args.world, args.position)

proc dragonEggBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  onScheduledTick(FallingBlock, args)

proc newDragonEggBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = dragonEggBlockPlaced_BlockBehaviour
  result.normalUseImpl = dragonEggBlockNormalUse_BlockBehaviour
  result.brokenImpl = dragonEggBlockBroken_BlockBehaviour
  result.onScheduledTickImpl = dragonEggBlockOnScheduledTick_BlockBehaviour

proc registerBlocksDragonEgg*(r: BlockRegistry) =
  r.register("minecraft:dragon_egg", newDragonEggBlock())

