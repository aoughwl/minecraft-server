## Port of pumpkin/src/block/blocks/dripstone.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  DripstoneBlock* = object



proc dripstoneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc dripstoneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc dripstoneBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc dripstoneBlockBroken_BlockBehaviour(args: BrokenArgs)
proc dripstoneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newDripstoneBlock*(): BlockBehaviour
proc updateStalagmite*(world: BlockWorld, stalagmiteLen: uint8, tipPos: BlockPos)
proc updateStalactite*(world: BlockWorld, stalagmiteLen: uint8, tipPos: BlockPos)
proc getStalagmiteOrStalacticeLenAndDirFromTipPos*(world: BlockWorld, position: BlockPos, blockStateId: BlockStateId): (uint8, VerticalDirection)
proc canPlaceAtPos*(blockAccessor: BlockWorld, position: BlockPos, placingDirection: Option[BlockDirection], playerOption: Option[BlockPlayer]): bool
proc getSupportBlockVerticalDirection*(blockAccessor: BlockWorld, position: BlockPos, placingDirectionWrapper: Option[BlockDirection], playerOption: Option[BlockPlayer]): Option[VerticalDirection]
proc canSupportDripstone*(supportBlock: Block): bool
proc modifyDripstoneThicknessTo*(world: BlockWorld, pos: BlockPos, newThickness: SpeleothemThickness)
proc offsetPosByVerticalDir*(pos: BlockPos, verDir: VerticalDirection): BlockPos
proc blockDirectionToVerticalDirection*(dir: BlockDirection): Option[VerticalDirection]
proc flipDir*(dir: VerticalDirection): VerticalDirection

proc dripstoneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAtPos(args.blockAccessor, args.position, args.direction, args.player)

proc dripstoneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var dripstoneProps = PointedDripstoneLikeProperties.defaultFor(args.block0)
  dripstoneProps.waterlogged = args.replacing.waterSource()
  let t1 = getSupportBlockVerticalDirection(args.world, args.position, some(args.direction), some(args.player))
  if not (t1.isSome):
    # this shouldn't happen
    return blockAir().defaultState.id
  let supportBlockVerDir = t1.unsafeGet
  dripstoneProps.verticalDirection = flipDir(supportBlockVerDir)
  dripstoneProps.toStateId(blockPointedDripstone())

proc dripstoneBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let (len0, verticalDir) = getStalagmiteOrStalacticeLenAndDirFromTipPos(args.world, args.position, args.stateId)
  case verticalDir
  of VerticalDirection.Up:
    updateStalagmite(args.world, len0, args.position)
  of VerticalDirection.Down:
    updateStalactite(args.world, len0, args.position)

proc dripstoneBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let brokenDripstoneProps = PointedDripstoneLikeProperties.fromStateId(args.state.id, args.block0)
  let t2 = block:
    case brokenDripstoneProps.verticalDirection
    of VerticalDirection.Up:
      args.position.down()
    of VerticalDirection.Down:
      args.position.up()
  let newTipPos = t2
  let (len0, verticalDir) = getStalagmiteOrStalacticeLenAndDirFromTipPos(args.world, newTipPos, args.state.id)
  case verticalDir
  of VerticalDirection.Up:
    updateStalagmite(args.world, len0, newTipPos)
  of VerticalDirection.Down:
    updateStalactite(args.world, len0, newTipPos)

proc dripstoneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAtPos(args.world, args.position, R2A_NONE, R2A_NONE)):
    return blockAir().defaultState.id
  var dripstoneProps = PointedDripstoneLikeProperties.fromStateId(args.stateId, args.block0)
  if (dripstoneProps.thickness != SpeleothemThickness.TipMerge):
    return args.stateId
  case dripstoneProps.verticalDirection
  of VerticalDirection.Up:
    let blockAbove = args.world.getBlock(args.position.up())
    if (blockAbove != blockPointedDripstone()):
      dripstoneProps.thickness = SpeleothemThickness.Tip
      return dripstoneProps.toStateId(args.block0)
  of VerticalDirection.Down:
    let blockBelow = args.world.getBlock(args.position.down())
    if (blockBelow != blockPointedDripstone()):
      dripstoneProps.thickness = SpeleothemThickness.Tip
      return dripstoneProps.toStateId(args.block0)
  args.stateId

proc newDripstoneBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = dripstoneBlockCanPlaceAt_BlockBehaviour
  result.onPlaceImpl = dripstoneBlockOnPlace_BlockBehaviour
  result.placedImpl = dripstoneBlockPlaced_BlockBehaviour
  result.brokenImpl = dripstoneBlockBroken_BlockBehaviour
  result.getStateForNeighborUpdateImpl = dripstoneBlockGetStateForNeighborUpdate_BlockBehaviour

proc updateStalagmite*(world: BlockWorld, stalagmiteLen: uint8, tipPos: BlockPos) =
  let blockAbove = world.getBlock(tipPos.up())
  if (blockAbove == blockPointedDripstone()):
    modifyDripstoneThicknessTo(world, tipPos, SpeleothemThickness.TipMerge)
    modifyDripstoneThicknessTo(world, tipPos.up(), SpeleothemThickness.TipMerge)
  else:
    modifyDripstoneThicknessTo(world, tipPos, SpeleothemThickness.Tip)
  case stalagmiteLen
  of 2:
    modifyDripstoneThicknessTo(world, tipPos.downHeight(1), SpeleothemThickness.Frustum)
  of 3:
    modifyDripstoneThicknessTo(world, tipPos.downHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.downHeight(2), SpeleothemThickness.Base)
  of 4:
    modifyDripstoneThicknessTo(world, tipPos.downHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.downHeight(2), SpeleothemThickness.Middle)
    modifyDripstoneThicknessTo(world, tipPos.downHeight(3), SpeleothemThickness.Base)
  of 5:
    modifyDripstoneThicknessTo(world, tipPos.downHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.downHeight(2), SpeleothemThickness.Middle)
    modifyDripstoneThicknessTo(world, tipPos.downHeight(3), SpeleothemThickness.Middle)
  else:
    discard

proc updateStalactite*(world: BlockWorld, stalagmiteLen: uint8, tipPos: BlockPos) =
  let blockBelow = world.getBlock(tipPos.down())
  if (blockBelow == blockPointedDripstone()):
    modifyDripstoneThicknessTo(world, tipPos, SpeleothemThickness.TipMerge)
    modifyDripstoneThicknessTo(world, tipPos.down(), SpeleothemThickness.TipMerge)
  else:
    modifyDripstoneThicknessTo(world, tipPos, SpeleothemThickness.Tip)
  case stalagmiteLen
  of 2:
    modifyDripstoneThicknessTo(world, tipPos.upHeight(1), SpeleothemThickness.Frustum)
  of 3:
    modifyDripstoneThicknessTo(world, tipPos.upHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.upHeight(2), SpeleothemThickness.Base)
  of 4:
    modifyDripstoneThicknessTo(world, tipPos.upHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.upHeight(2), SpeleothemThickness.Middle)
    modifyDripstoneThicknessTo(world, tipPos.upHeight(3), SpeleothemThickness.Base)
  of 5:
    modifyDripstoneThicknessTo(world, tipPos.upHeight(1), SpeleothemThickness.Frustum)
    modifyDripstoneThicknessTo(world, tipPos.upHeight(2), SpeleothemThickness.Middle)
    modifyDripstoneThicknessTo(world, tipPos.upHeight(3), SpeleothemThickness.Middle)
  else:
    discard

proc getStalagmiteOrStalacticeLenAndDirFromTipPos*(world: BlockWorld, position: BlockPos, blockStateId: BlockStateId): (uint8, VerticalDirection) =
  let props = PointedDripstoneLikeProperties.fromStateId(blockStateId, blockPointedDripstone())
  var dripstoneLen = 1
  var nextDripstonePos = offsetPosByVerticalDir(position, props.verticalDirection)
  # We dont care if it's longer than 5 blocks because of how thickness system works.
  while (dripstoneLen < 5):
    if (world.getBlock(nextDripstonePos) != blockPointedDripstone()):
      break
    nextDripstonePos = offsetPosByVerticalDir(nextDripstonePos, props.verticalDirection)
    dripstoneLen += 1
  (dripstoneLen, props.verticalDirection)

proc canPlaceAtPos*(blockAccessor: BlockWorld, position: BlockPos, placingDirection: Option[BlockDirection], playerOption: Option[BlockPlayer]): bool =
  # Determine support block
  let t3 = getSupportBlockVerticalDirection(blockAccessor, position, placingDirection, playerOption)
  if not (t3.isSome):
    return false
  let supportBlockVerticalDirection = t3.unsafeGet
  let t4 = block:
    case supportBlockVerticalDirection
    of VerticalDirection.Up:
      position.up()
    of VerticalDirection.Down:
      position.down()
  let supportPos = t4
  let supportBlock = blockAccessor.getBlock(supportPos)
  if canSupportDripstone(supportBlock):
    return true
  false

proc getSupportBlockVerticalDirection*(blockAccessor: BlockWorld, position: BlockPos, placingDirectionWrapper: Option[BlockDirection], playerOption: Option[BlockPlayer]): Option[VerticalDirection] =
  let t5 = placingDirectionWrapper
  if not (t5.isSome):
    # then this is basically called by a neighbor update check
    let (blockRef, state) = blockAccessor.getBlockAndState(position)
    if (blockRef != blockPointedDripstone()):
      return none[VerticalDirection]()
    let props = PointedDripstoneLikeProperties.fromStateId(state.id, blockRef)
    return some(flipDir(props.verticalDirection))
  let placingDirection = t5.unsafeGet
  let t6 = blockDirectionToVerticalDirection(placingDirection)
  if t6.isSome:
    let verDir = t6.unsafeGet
    case verDir
    of VerticalDirection.Up:
      let blockAbove = blockAccessor.getBlock(position.up())
      let blockBelow = blockAccessor.getBlock(position.down())
      if canSupportDripstone(blockAbove):
        return some(VerticalDirection.Up)
      elif canSupportDripstone(blockBelow):
        return some(VerticalDirection.Down)
      none[VerticalDirection]()
    of VerticalDirection.Down:
      let blockAbove1 = blockAccessor.getBlock(position.up())
      let blockBelow2 = blockAccessor.getBlock(position.down())
      if canSupportDripstone(blockBelow2):
        return some(VerticalDirection.Down)
      elif canSupportDripstone(blockAbove1):
        return some(VerticalDirection.Up)
      none[VerticalDirection]()
  elif t6.isNone:
    playerOption.mapOr(some(VerticalDirection.Up), R2A_MANUAL("closure |player| t9"))
  else:
    rustPanic("non-exhaustive")

proc canSupportDripstone*(supportBlock: Block): bool =
  if (supportBlock == blockPointedDripstone()):
    return true
  if supportBlock.defaultState.isFullCube() and supportBlock.defaultState.isSolidBlock():
    return true
  false

proc modifyDripstoneThicknessTo*(world: BlockWorld, pos: BlockPos, newThickness: SpeleothemThickness) =
  let (blockRef, supportBlockStateId) = world.getBlockAndStateId(pos)
  if (blockRef != blockPointedDripstone()):
    # this shouldn't happen
    return
  var supportProps = PointedDripstoneLikeProperties.fromStateId(supportBlockStateId, blockRef)
  if (supportProps.thickness == newThickness):
    return
  supportProps.thickness = newThickness
  discard world.setBlockState(pos, supportProps.toStateId(blockPointedDripstone()), 0'u32)

proc offsetPosByVerticalDir*(pos: BlockPos, verDir: VerticalDirection): BlockPos =
  case verDir
  of VerticalDirection.Up:
    pos.down()
  of VerticalDirection.Down:
    pos.up()

proc blockDirectionToVerticalDirection*(dir: BlockDirection): Option[VerticalDirection] =
  case dir
  of BlockDirection.Up:
    some(VerticalDirection.Up)
  of BlockDirection.Down:
    some(VerticalDirection.Down)
  else:
    none[VerticalDirection]()

proc flipDir*(dir: VerticalDirection): VerticalDirection =
  if (dir == VerticalDirection.Up):
    return VerticalDirection.Down
  VerticalDirection.Up

proc registerBlocksDripstone*(r: BlockRegistry) =
  r.register("minecraft:pointed_dripstone", newDripstoneBlock())

