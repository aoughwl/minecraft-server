import ../blockprelude
import ../entities/enchanting_table


type
  EnchantingTableBlock* = object
  EnchantingTableScreenFactory* = ref object
    bookshelfCount*: int32
    seed*: int32



proc enchantingTableBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc enchantingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc newEnchantingTableBlock*(): BlockBehaviour
proc isBookshelf*(world: BlockWorld, pos: BlockPos): bool
proc createScreenHandler*(self: EnchantingTableScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: EnchantingTableScreenFactory): TextComponent

proc enchantingTableBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newEnchantingTableBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc enchantingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  var bookshelfCount = 0
  for offZ in (-1) .. 1:
    for offX in (-1) .. 1:
      if (((not (offZ == 0)) or (not (offX == 0)))) and (args.world.getBlockState(args.position.add(offX, 0, offZ)).id == blockStateIdAir) and (args.world.getBlockState(args.position.add(offX, 1, offZ)).id == blockStateIdAir):
        for offY in 0 .. 1:
          if isBookshelf(args.world, args.position.add((offX * 2), offY, (offZ * 2))):
            bookshelfCount += 1
          if (not (offX == 0)) and (not (offZ == 0)):
            if isBookshelf(args.world, args.position.add((offX * 2), offY, offZ)):
              bookshelfCount += 1
            if isBookshelf(args.world, args.position.add(offX, offY, (offZ * 2))):
              bookshelfCount += 1
  let bookshelfCount1 = bookshelfCount.min(15)
  args.player.openHandledScreen(EnchantingTableScreenFactory(bookshelfCount: bookshelfCount1, seed: args.player.enchantmentSeed()), some(args.position))
  barSuccess

proc newEnchantingTableBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = enchantingTableBlockPlaced_BlockBehaviour
  result.normalUseImpl = enchantingTableBlockNormalUse_BlockBehaviour

proc isBookshelf*(world: BlockWorld, pos: BlockPos): bool =
  let state = world.getBlockState(pos)
  let blockRef = Block.fromStateId(state.id)
  (blockRef == blockBookshelf())

proc createScreenHandler*(self: EnchantingTableScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let inventory: Inventory = newSimpleInventory(2)
  let handler = newEnchantingTableScreenHandler(syncId, playerInventory, inventory, self.seed, self.bookshelfCount)
  let screenHandlerArc = handler
  some(SharedScreenHandler(screenHandlerArc))

proc getDisplayName*(self: EnchantingTableScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_ENCHANT, CONTAINER_ENCHANT, [])

proc registerBlocksEnchantingTable*(r: BlockRegistry) =
  r.register("minecraft:enchanting_table", newEnchantingTableBlock())

