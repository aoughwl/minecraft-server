## Port of pumpkin/src/block/blocks/enchanting_table.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/enchanting_screen_handler
import ../entities/enchanting_table

proc isBookshelf(world: BlockWorld, pos: BlockPos): bool =
  world.getBlock(pos) == blockBookshelf()

proc enchantingTableScreenFactory(bookshelfCount: int32, seed: int32): BlockScreenFactory =
  ## `EnchantingTableScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_ENCHANT, BEDROCK_CONTAINER_ENCHANT),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      let inventory = Inventory(newArrayInventory(2))
      ScreenHandler(newEnchantingTableScreenHandler(syncId, playerInventory, inventory, seed, bookshelfCount)))

proc enchantingTableBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newEnchantingTableBlockEntity(args.position))

proc enchantingTableBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  var bookshelfCount = 0'i32
  for offZ in -1'i32 .. 1'i32:
    for offX in -1'i32 .. 1'i32:
      if (offZ != 0 or offX != 0) and
          args.world.getBlockState(args.position.add(offX, 0, offZ)).id == blockStateIdAir and
          args.world.getBlockState(args.position.add(offX, 1, offZ)).id == blockStateIdAir:
        # Air
        for offY in 0'i32 .. 1'i32:
          if isBookshelf(args.world, args.position.add(offX * 2, offY, offZ * 2)):
            bookshelfCount += 1
          if offX != 0 and offZ != 0:
            if isBookshelf(args.world, args.position.add(offX * 2, offY, offZ)):
              bookshelfCount += 1
            if isBookshelf(args.world, args.position.add(offX, offY, offZ * 2)):
              bookshelfCount += 1
  bookshelfCount = min(bookshelfCount, 15'i32)
  let seedOf = args.player.enchantmentSeed0
  let seed = if seedOf != nil: seedOf() else: 0'i32
  args.player.openHandledScreen(enchantingTableScreenFactory(bookshelfCount, seed), some(args.position))
  barSuccess

proc newEnchantingTableBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = enchantingTableBlockPlaced_BlockBehaviour
  result.normalUseImpl = enchantingTableBlockNormalUse_BlockBehaviour

proc registerBlocksEnchantingTable*(r: BlockRegistry) =
  r.register("minecraft:enchanting_table", newEnchantingTableBlock())
