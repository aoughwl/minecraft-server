import ../blockprelude
import ../entities/end_portal


type
  EndPortalBlock* = object



proc endPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc endPortalBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newEndPortalBlock*(): BlockBehaviour

proc endPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let t1 = block:
    if (args.world.dimension.minecraftName == Dimension.THE_END.minecraftName):
      args.server.getWorldFromDimension(Dimension.OVERWORLD)
    else:
      args.server.getWorldFromDimension(Dimension.THE_END)
  let targetWorld = t1
  if Arc.ptrEq(targetWorld, args.world):
    return
  discard
  args.entity.getEntity().tryUsePortal(0, targetWorld, args.position)

proc endPortalBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let nbt = createNbt(args.position)
  args.world.addBlockEntityNbt(args.position, nbt)
  args.world.addBlockEntity(newEndPortalBlockEntity(args.position))

proc newEndPortalBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = endPortalBlockOnEntityCollision_BlockBehaviour
  result.placedImpl = endPortalBlockPlaced_BlockBehaviour

proc registerBlocksEndPortal*(r: BlockRegistry) =
  r.register("minecraft:end_portal", newEndPortalBlock())

