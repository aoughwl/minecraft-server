## Port of pumpkin/src/block/blocks/end_portal.rs
## PARTIAL: pumpkin/src/block/blocks/end_portal.rs - `placed` (the block entity of the portal, entities/end_portal.aowl, whose translation has not compiled) is not here; the collision is.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

type
  EndPortalBlock* = object

proc endPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let target = if args.world.dimension.minecraftName == "minecraft:the_end": "minecraft:overworld" else: "minecraft:the_end"
  if args.entity.tryUsePortal0 != nil:
    args.entity.tryUsePortal0(0'u32, target, args.position)

proc newEndPortalBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = endPortalBlockOnEntityCollision_BlockBehaviour

proc registerBlocksEndPortal*(r: BlockRegistry) =
  r.register("minecraft:end_portal", newEndPortalBlock())
