## Port of pumpkin/src/block/blocks/end_portal_frame.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  EndPortalFrameProperties = EndPortalFrameLikeProperties
  EndPortalFrameBlock* = object



proc endPortalFrameBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var endPortalFrameProps = EndPortalFrameProperties.defaultFor(args.block0)
  endPortalFrameProps.facing = getHorizontalFacing(BlockActor(args.player)).opposite()
  endPortalFrameProps.toStateId(args.block0)

proc newEndPortalFrameBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = endPortalFrameBlockOnPlace_BlockBehaviour

proc registerBlocksEndPortalFrame*(r: BlockRegistry) =
  r.register("minecraft:end_portal_frame", newEndPortalFrameBlock())

