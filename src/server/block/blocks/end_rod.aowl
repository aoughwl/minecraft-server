import ../blockprelude


type
  EndRodBlock* = object



proc endRodBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc newEndRodBlock*(): BlockBehaviour

proc endRodBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = EndRodLikeProperties.defaultFor(args.block0)
  let blockstate = args.world.getBlockStateId(args.position.offset(args.direction.toOffset()))
  if Block.fromStateId(blockstate).eq(args.block0) and (EndRodLikeProperties.fromStateId(blockstate, args.block0).facing == args.direction.toFacing().opposite()):
    props.facing = args.direction.toFacing()
  else:
    props.facing = args.direction.toFacing().opposite()
  props.toStateId(args.block0)

proc newEndRodBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = endRodBlockOnPlace_BlockBehaviour

proc registerBlocksEndRod*(r: BlockRegistry) =
  r.register("minecraft:end_rod", newEndRodBlock())

