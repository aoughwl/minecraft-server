import ../blockprelude
import ../entities/ender_chest

const LID_ANIMATION_EVENT_TYPE*: uint8 = 1

type
  EnderChestScreenFactory* = R2A_MANUAL_tuple_struct
  EnderChestBlock* = object



proc createScreenHandler*(self: EnderChestScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: EnderChestScreenFactory): TextComponent
proc enderChestBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc enderChestBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool
proc enderChestBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc enderChestBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newEnderChestBlock*(): BlockBehaviour
proc isChestBlocked*(world: BlockWorld, blockPos: BlockPos): bool
proc hasBlockOnTop*(world: BlockWorld, blockPos: BlockPos): bool

proc createScreenHandler*(self: EnderChestScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = createGeneric9x3(syncId, playerInventory, self[0])
  let concreteArc = handler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: EnderChestScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_ENDERCHEST, CONTAINER_ENDERCHEST, [])

proc enderChestBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = LadderLikeProperties.defaultFor(args.block0)
  props.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc enderChestBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  # On the server, we don't need to do more because the client is responsible for that.
  (args.kind0 == LID_ANIMATION_EVENT_TYPE)

proc enderChestBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  if isChestBlocked(args.world, args.position):
    return barSuccess
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = asType(t1.unsafeGet, EnderChestBlockEntity)
      if t2.isSome:
        let blockEntity = t2.unsafeGet
        let inventory = args.player.enderChestInventory()
        inventory.setTracker(t2.unsafeGet.getTracker())
        args.player.incrementStat(scCustom, int32(csOpenEnderchest), 1)
        args.player.openHandledScreen(EnderChestScreenFactory(inventory), some(args.position))
  barSuccess

proc enderChestBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blockEntity = newEnderChestBlockEntity(args.position)
  args.world.addBlockEntity(blockEntity)

proc newEnderChestBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = enderChestBlockOnPlace_BlockBehaviour
  result.onSyncedBlockEventImpl = enderChestBlockOnSyncedBlockEvent_BlockBehaviour
  result.normalUseImpl = enderChestBlockNormalUse_BlockBehaviour
  result.placedImpl = enderChestBlockPlaced_BlockBehaviour

proc isChestBlocked*(world: BlockWorld, blockPos: BlockPos): bool =
  # TODO: Block opening when a cat is sitting on top.
  hasBlockOnTop(world, blockPos)

proc hasBlockOnTop*(world: BlockWorld, blockPos: BlockPos): bool =
  let abovePos = blockPos.up()
  let aboveState = world.getBlockState(abovePos)
  aboveState.isSolidBlock()

proc registerBlocksEnderChest*(r: BlockRegistry) =
  r.register("minecraft:ender_chest", newEnderChestBlock())

