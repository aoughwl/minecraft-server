## Port of pumpkin/src/block/blocks/falling.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  FallingBlock* = object



proc canFallThrough*(state: BlockState, blockRef: Block): bool
proc fallingBlockIds*(): seq[BlockId]
proc fallingBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc fallingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc fallingBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newFallingBlock*(): BlockBehaviour

proc canFallThrough*(state: BlockState, blockRef: Block): bool =
  (((state.isAir() or blockRef.hasTag(Block_MINECRAFT_FIRE)) or state.isLiquid()) or state.replaceable())

proc fallingBlockIds*(): seq[BlockId] =
  @[blockIdGravel, blockIdSand, blockIdRedSand]

proc fallingBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  # TODO: make delay configurable
  args.world.scheduleBlockTick(args.block0, args.position, 2, tpNormal)

proc fallingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  # TODO: make delay configurable
  args.world.scheduleBlockTick(args.block0, args.position, 2, tpNormal)
  args.stateId

proc fallingBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let (blockRef, state) = args.world.getBlockAndState(args.position.down())
  if ((not canFallThrough(state, blockRef)) or (args.position.vec.y < args.world.minY)):
    return
  let state1 = args.world.getBlockState(args.position)
  args.world.replaceSpawnFalling(args.position, state1.id)

proc newFallingBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = fallingBlockPlaced_BlockBehaviour
  result.getStateForNeighborUpdateImpl = fallingBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = fallingBlockOnScheduledTick_BlockBehaviour

proc registerBlocksFalling*(r: BlockRegistry) =
  r.registerIds(fallingBlockIds(), newFallingBlock())

