import ../blockprelude


type
  FarmlandProperties = FarmlandLikeProperties
  FarmlandBlock* = object



proc farmlandBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc farmlandBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc farmlandBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc farmlandBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc farmlandBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newFarmlandBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool
proc isWaterNearby*(world: BlockWorld, blockPos: BlockPos): bool

proc farmlandBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  # TODO: push up entities
  discard args.world.setBlockState(args.position, blockDirt().defaultState.id, BfNotifyAll)

proc farmlandBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    return blockDirt().defaultState.id
  args.block0.defaultState.id

proc farmlandBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.direction == BlockDirection.Up) and (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc farmlandBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc farmlandBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  # TODO: add rain check. Remember to check which one is most optimized.
  if isWaterNearby(args.world, args.position):
    var props = FarmlandProperties.defaultFor(args.block0)
    props.moisture = 7
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyNeighbors)
  else:
    let stateId = args.world.getBlockStateId(args.position)
    var props1 = FarmlandProperties.fromStateId(stateId, args.block0)
    if (props1.moisture == 0):
      if (not args.world.getBlock(args.position.up()).hasTag(Block_MINECRAFT_MAINTAINS_FARMLAND)):
        # TODO push entities up
        discard args.world.setBlockState(args.position, blockDirt().defaultState.id, BfNotifyNeighbors)
    else:
      props1.moisture -= 1
      discard args.world.setBlockState(args.position, props1.toStateId(args.block0), BfNotifyNeighbors)

proc newFarmlandBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onScheduledTickImpl = farmlandBlockOnScheduledTick_BlockBehaviour
  result.onPlaceImpl = farmlandBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = farmlandBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = farmlandBlockCanPlaceAt_BlockBehaviour
  result.randomTickImpl = farmlandBlockRandomTick_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let state = world.getBlockState(blockPos.up())
  (not state.isSolid())

proc isWaterNearby*(world: BlockWorld, blockPos: BlockPos): bool =
  for dx in (-4) .. 4:
    for dy in 0 .. 1:
      for dz in (-4) .. 4:
        let checkPos = blockPos.offset(Vector3(x: dx, y: dy, z: dz))
        # TODO this should use tag water. It does not seem to work rn.
        if (world.getBlock(checkPos) == blockWater()):
          return true
  false

proc registerBlocksFarmland*(r: BlockRegistry) =
  r.register("minecraft:farmland", newFarmlandBlock())

