## Port of pumpkin/src/block/blocks/fence_gates.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import redstone/redstonemod


type
  FenceGateProperties = OakFenceGateLikeProperties
  FenceGateBlock* = object



proc getSound*(blockRef: Block, open: bool): Sound
proc toggleFenceGate*(world: BlockWorld, blockPos: BlockPos, player: BlockPlayer): BlockStateId
proc fenceGateBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc fenceGateBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc fenceGateBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc fenceGateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newFenceGateBlock*(): BlockBehaviour
proc isInWall*(args: GetStateForNeighborUpdateArgs): FenceGateProperties

proc getSound*(blockRef: Block, open: bool): Sound =
  let t1 = (blockRef, open)
  if (t1[0] == blockBambooFenceGate()):
    let b = t1[0]
    let true = t1[1]
    sdBlockBambooWoodFenceGateOpen
  elif (t1[0] == blockBambooFenceGate()):
    let b = t1[0]
    let false = t1[1]
    sdBlockBambooWoodFenceGateClose
  elif (t1[0] == blockCherryFenceGate()):
    let b = t1[0]
    let true = t1[1]
    sdBlockCherryWoodFenceGateOpen
  elif (t1[0] == blockCherryFenceGate()):
    let b = t1[0]
    let false = t1[1]
    sdBlockCherryWoodFenceGateClose
  elif ((t1[0] == blockCrimsonFenceGate()) or (t1[0] == blockWarpedFenceGate())):
    let b = t1[0]
    let true = t1[1]
    sdBlockNetherWoodFenceGateOpen
  elif ((t1[0] == blockCrimsonFenceGate()) or (t1[0] == blockWarpedFenceGate())):
    let b = t1[0]
    let false = t1[1]
    sdBlockNetherWoodFenceGateClose
  else:
    let true = t1[1]
    sdBlockFenceGateOpen
  else:
    let false = t1[1]
    sdBlockFenceGateClose

proc toggleFenceGate*(world: BlockWorld, blockPos: BlockPos, player: BlockPlayer): BlockStateId =
  let (blockRef, state) = world.getBlockAndStateId(blockPos)
  var fenceGateProps = FenceGateProperties.fromStateId(state, blockRef)
  if fenceGateProps.open:
    fenceGateProps.open = false
  else:
    if (fenceGateProps.facing == player.livingEntity.entity.getHorizontalFacing().opposite()):
      fenceGateProps.facing = player.getEntity().getHorizontalFacing()
    fenceGateProps.open = true
  world.playBlockSoundExpect(player, getSound(blockRef, fenceGateProps.open), scBlocks, blockPos)
  discard world.setBlockState(blockPos, fenceGateProps.toStateId(blockRef), BfNotifyListeners)
  fenceGateProps.toStateId(blockRef)

proc fenceGateBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var fenceGateProps = FenceGateProperties.defaultFor(args.block0)
  fenceGateProps.facing = args.player.getEntity().getHorizontalFacing()
  let powered = blockReceivesRedstonePower(args.world, args.position)
  fenceGateProps.powered = powered
  fenceGateProps.open = powered
  fenceGateProps.toStateId(args.block0)

proc fenceGateBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let fenceProps = isInWall(args)
  fenceProps.toStateId(args.block0)

proc fenceGateBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  toggleFenceGate(args.world, args.position, args.player)
  barSuccess

proc fenceGateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let blockState = args.world.getBlockState(args.position)
  var fenceGateProps = FenceGateProperties.fromStateId(blockState.id, args.block0)
  let powered = blockReceivesRedstonePower(args.world, args.position)
  if (powered == fenceGateProps.powered):
    return
  fenceGateProps.powered = powered
  if (powered != fenceGateProps.open):
    fenceGateProps.open = powered
    args.world.playBlockSound(getSound(args.block0, powered), scBlocks, args.position)
  discard args.world.setBlockState(args.position, fenceGateProps.toStateId(args.block0), BfNotifyListeners)

proc newFenceGateBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = fenceGateBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = fenceGateBlockGetStateForNeighborUpdate_BlockBehaviour
  result.normalUseImpl = fenceGateBlockNormalUse_BlockBehaviour
  result.onNeighborUpdateImpl = fenceGateBlockOnNeighborUpdate_BlockBehaviour

proc isInWall*(args: GetStateForNeighborUpdateArgs): FenceGateProperties =
  var fenceProps = FenceGateProperties.fromStateId(args.stateId, args.block0)
  let sideOffsetLeft = args.position.offset(fenceProps.facing.rotateClockwise().toOffset())
  let sideOffsetRight = args.position.offset(fenceProps.facing.rotateCounterClockwise().toOffset())
  let neighborOnSide = ((args.neighborPosition == sideOffsetLeft) or (args.neighborPosition == sideOffsetRight))
  if neighborOnSide:
    let neighborRight = args.world.getBlock(sideOffsetRight)
    let neighborLeft = args.world.getBlock(sideOffsetLeft)
    fenceProps.inWall = (neighborLeft.hasTag(Block_MINECRAFT_WALLS) or neighborRight.hasTag(Block_MINECRAFT_WALLS))
  fenceProps

proc registerBlocksFenceGates*(r: BlockRegistry) =
  r.registerTag("minecraft:fence_gates", newFenceGateBlock())

