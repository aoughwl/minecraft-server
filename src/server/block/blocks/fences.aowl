import ../blockprelude


type
  FenceGateProperties = OakFenceGateLikeProperties
  FenceProperties = OakFenceLikeProperties
  FenceBlock* = object



proc fenceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc fenceBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newFenceBlock*(): BlockBehaviour
proc computeFenceState*(fenceProps: FenceProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId
proc connectsTo*(from0: Block, to0: Block, toState: BlockState, direction: BlockDirection): bool

proc fenceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var fenceProps = FenceProperties.defaultFor(args.block0)
  fenceProps.waterlogged = args.replacing.waterSource()
  computeFenceState(fenceProps, args.world, args.block0, args.position)

proc fenceBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let fenceProps = FenceProperties.fromStateId(args.stateId, args.block0)
  computeFenceState(fenceProps, args.world, args.block0, args.position)

proc newFenceBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = fenceBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = fenceBlockGetStateForNeighborUpdate_BlockBehaviour

proc computeFenceState*(fenceProps: FenceProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId =
  var fenceProps = fenceProps
  let t1 = blockDirectionHorizontal()
  for direction in t1:
    let otherBlockPos = blockPos.offset(direction.toOffset())
    let (otherBlock, otherBlockState) = world.getBlockAndState(otherBlockPos)
    let connected = connectsTo(blockRef, otherBlock, otherBlockState, direction.toBlockDirection())
    case direction
    of HorizontalFacing.North:
      fenceProps.north = connected
    of HorizontalFacing.South:
      fenceProps.south = connected
    of HorizontalFacing.West:
      fenceProps.west = connected
    of HorizontalFacing.East:
      fenceProps.east = connected
  fenceProps.toStateId(blockRef)

proc connectsTo*(from0: Block, to0: Block, toState: BlockState, direction: BlockDirection): bool =
  if (from0 == to0):
    return true
  if toState.isSideSolid(direction.opposite()):
    return true
  if to0.hasTag(Block_C_FENCE_GATES):
    let fenceGateProps = FenceGateProperties.fromStateId(toState.id, to0)
    if (BlockDirection.fromCardinalDirection(fenceGateProps.facing).toAxis() == direction.rotateClockwise().toAxis()):
      return true
  ((not (from0 == blockNetherBrickFence())) and to0.hasTag(Block_C_FENCES_WOODEN))

proc registerBlocksFences*(r: BlockRegistry) =
  r.registerTag("minecraft:fences", newFenceBlock())

