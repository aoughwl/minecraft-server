## Port of pumpkin/src/block/blocks/fire/fire.rs
## `FireBlock::is_flammable` and `FireBlock::are_blocks_around_flammable` are in firemod.aowl (see its header): they are
## what `FireBlockBase::can_place_at` needs from this file, and this file imports firemod.
## `FireBlock.can_place_at(CanPlaceAtArgs {..})` calls become `fireBlockCanPlaceAtWorld`, the same body over the world.
## `world.level_info` and `get_closest_player` go through the BlockWorld hooks.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../../../../generated/dimension
import ../../../world/portal/nether
import firemod
import ../tnt


type
  FireProperties = FireLikeProperties
  FireBlock* = object



proc getFireTickDelay*(): int32
proc getStateForPosition*(self: FireBlock, world: BlockWorld, blockRef: Block, pos: BlockPos): BlockStateId
proc getBurnChance*(self: FireBlock, world: BlockWorld, pos: BlockPos): int32
proc isNearRain*(world: BlockWorld, pos: BlockPos): bool
proc getBurnOdds*(blockRef: Block): int32
proc isIncreasedBurnoutBiome*(world: BlockWorld, pos: BlockPos): bool
proc trySpreadingFire*(self: FireBlock, world: BlockWorld, pos: BlockPos, chance: int32, age: uint8)
proc fireBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc fireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc fireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc fireBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc fireBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc fireBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newFireBlock*(): BlockBehaviour

proc getFireTickDelay*(): int32 =
  30'i32 + int32(rng().randomRange(0'i32 ..< 10'i32))

proc fireBlockCanPlaceAtWorld(world: BlockWorld, position: BlockPos): bool =
  ## `FireBlock.can_place_at` over a world
  let state = world.getBlockState(position.down())
  if state.isSideSolid(BlockDirection.Up):
    return true
  areBlocksAroundFlammable(world, position)

proc getStateForPosition*(self: FireBlock, world: BlockWorld, blockRef: Block, pos: BlockPos): BlockStateId =
  let downPos = pos.down()
  let downState = world.getBlockState(downPos)
  if isFlammable(downState) or downState.isSideSolid(BlockDirection.Up):
    return blockRef.defaultState.id
  var fireProps = FireProperties.fromStateId(blockRef.defaultState.id, blockRef)
  let allDirections = blockDirectionAll()
  for direction in allDirections:
    let neighborPos = pos.offset(direction.toOffset())
    let neighborState = world.getBlockState(neighborPos)
    if isFlammable(neighborState):
      case direction
      of BlockDirection.North:
        fireProps.north = true
      of BlockDirection.South:
        fireProps.south = true
      of BlockDirection.East:
        fireProps.east = true
      of BlockDirection.West:
        fireProps.west = true
      of BlockDirection.Up:
        fireProps.up = true
      of BlockDirection.Down:
        discard
  fireProps.toStateId(blockRef)

proc getBurnChance*(self: FireBlock, world: BlockWorld, pos: BlockPos): int32 =
  # Used for spreading fire
  let blockState = world.getBlockState(pos)
  if not blockState.isAir():
    return 0'i32
  var totalBurnChance = 0'i32
  let allDirs = blockDirectionAll()
  for dir in allDirs:
    let neighborBlock = world.getBlock(pos.offset(dir.toOffset()))
    if world.getFluid(pos.offset(dir.toOffset())).name != Fluid.EMPTY.name:
      continue  # Skip if there is a fluid
    if neighborBlock.hasFlammable:
      totalBurnChance = max(totalBurnChance, int32(neighborBlock.flammable.spreadChance))
  totalBurnChance

proc isNearRain*(world: BlockWorld, pos: BlockPos): bool =
  # TODO: Implement proper rain checking when weather is implemented
  # For now, return false to allow fire to work
  false

proc getBurnOdds*(blockRef: Block): int32 =
  # Get burn odds for a block, used in try_spreading_fire
  if blockRef.hasFlammable: int32(blockRef.flammable.burnChance) else: 0'i32

proc isIncreasedBurnoutBiome*(world: BlockWorld, pos: BlockPos): bool =
  # Fire burnout increases in the Nether
  if world.dimension == THE_NETHER:
    return true
  # Fire burnout increases in specific biomes
  # TODO: Use proper tag or bool for this when available
  let f = world.biomeAt0
  if f == nil:
    return false
  let biome = f(pos)
  biome == "minecraft:bamboo_jungle" or biome == "minecraft:mushroom_fields" or biome == "minecraft:mangrove_swamp" or
    biome == "minecraft:snowy_slopes" or biome == "minecraft:frozen_peaks" or biome == "minecraft:jagged_peaks" or
    biome == "minecraft:swamp" or biome == "minecraft:jungle"

proc trySpreadingFire*(self: FireBlock, world: BlockWorld, pos: BlockPos, chance: int32, age: uint8) =
  let blockRef = world.getBlock(pos)
  let odds = getBurnOdds(blockRef)
  if int32(rng().randomRange(0'i32 ..< chance)) < odds:
    let oldBlock = blockRef
    if int32(rng().randomRange(0'i32 ..< (int32(age) + 10'i32))) < 5'i32 and not isNearRain(world, pos):
      let newAge = uint8(min(int32(age) + int32(rng().randomRange(0'i32 ..< 5'i32)) div 4'i32, 15'i32))
      let stateId = self.getStateForPosition(world, blockFire(), pos)
      var fireProps = FireProperties.fromStateId(stateId, blockFire())
      fireProps.age = newAge
      let newStateId = fireProps.toStateId(blockFire())
      discard world.setBlockState(pos, newStateId, BfNotifyNeighbors)
    else:
      discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyNeighbors)
    if oldBlock == blockTnt():
      prime(world, pos)

proc fireBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if args.oldStateId == args.stateId:
    # Already a fire
    return
  let dimension = args.world.dimension
  # First lets check if we are in OverWorld or Nether, its not possible to place an Nether portal in other dimensions in Vanilla
  if dimension == OVERWORLD or dimension == THE_NETHER:
    let portal = getNewPortal(args.world, args.position, HorizontalAxis.X)
    if portal.isSome:
      portal.unsafeGet.create(args.world)
      return
  args.world.scheduleBlockTick(args.block0, args.position, uint8(getFireTickDelay()), tpNormal)

proc fireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  applyFireCollision(args, false)

proc fireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let self = FireBlock()
  if fireBlockCanPlaceAtWorld(args.world, args.position):
    let oldFireProps = FireProperties.fromStateId(args.stateId, blockFire())
    let fireStateId = self.getStateForPosition(args.world, blockFire(), args.position)
    var fireProps = FireProperties.fromStateId(fireStateId, blockFire())
    fireProps.age = oldFireProps.age
    return fireProps.toStateId(blockFire())
  blockAir().defaultState.id

proc fireBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let state = args.blockAccessor.getBlockState(args.position.down())
  if state.isSideSolid(BlockDirection.Up):
    return true
  areBlocksAroundFlammable(args.blockAccessor, args.position)

proc fireBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let self = FireBlock()
  let world = args.world
  let blockRef = args.block0
  let pos = args.position
  # Schedule next tick first
  world.scheduleBlockTick(blockRef, pos, uint8(getFireTickDelay()), tpNormal)
  # Check if fire can survive
  if not fireBlockCanPlaceAtWorld(world, pos):
    discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyNeighbors)
    return
  let blockState = world.getBlockState(pos)
  let blockBelow = world.getBlock(pos.down())
  # Check for infiniburn blocks (depending on dimension)
  var infiniburn = false
  if world.dimension.id == OVERWORLD.id:
    infiniburn = blockBelow.hasTag(Block_MINECRAFT_INFINIBURN_OVERWORLD)
  elif world.dimension.id == THE_NETHER.id:
    infiniburn = blockBelow.hasTag(Block_MINECRAFT_INFINIBURN_NETHER)
  elif world.dimension.id == THE_END.id:
    infiniburn = blockBelow.hasTag(Block_MINECRAFT_INFINIBURN_END)
  var fireProps = FireProperties.fromStateId(blockState.id, blockFire())
  let age = fireProps.age
  # Check if rain should extinguish the fire
  if (not infiniburn) and isNearRain(world, pos):
    let rainChance = 0.2'f32 + float32(age) * 0.03'f32
    if randomOf(float32) < rainChance:
      discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyNeighbors)
      return
  # Increment age
  let random = uint8(int32(rng().randomRange(0'i32 ..< 3'i32)) div 2'i32)
  let newAge = min(age + random, 15'u8)
  if newAge != age:
    fireProps.age = newAge
    let newStateId = fireProps.toStateId(blockFire())
    discard world.setBlockState(pos, newStateId, BfNotifyNeighbors)
  if not infiniburn:
    # Check if fire should extinguish due to lack of fuel
    if not areBlocksAroundFlammable(world, pos):
      let blockBelowState = world.getBlockState(pos.down())
      if (not blockBelowState.isSideSolid(BlockDirection.Up)) or newAge > 3'u8:
        discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyNeighbors)
        return
    # At max age, fire has a chance to extinguish if not on flammable block
    if newAge == 15'u8 and rng().randomRange(0'i32 ..< 4'i32) == 0'i32 and not isFlammable(world.getBlockState(pos.down())):
      discard world.setBlockState(pos, blockAir().defaultState.id, BfNotifyNeighbors)
      return
  # Burn adjacent blocks
  let extra = if isIncreasedBurnoutBiome(world, pos): -50'i32 else: 0'i32  # Increases chance of block being destroyed
  self.trySpreadingFire(world, pos.offset(BlockDirection.East.toOffset()), 300'i32 + extra, newAge)
  self.trySpreadingFire(world, pos.offset(BlockDirection.West.toOffset()), 300'i32 + extra, newAge)
  self.trySpreadingFire(world, pos.offset(BlockDirection.Down.toOffset()), 250'i32 + extra, newAge)
  self.trySpreadingFire(world, pos.offset(BlockDirection.Up.toOffset()), 250'i32 + extra, newAge)
  self.trySpreadingFire(world, pos.offset(BlockDirection.North.toOffset()), 300'i32 + extra, newAge)
  self.trySpreadingFire(world, pos.offset(BlockDirection.South.toOffset()), 300'i32 + extra, newAge)
  # Respect the `fire_spread_radius_around_player` gamerule.
  # -1 = disabled (allow unlimited spread), 0 = disabled (no spread), >0 = radius in blocks
  let spreadRadius = world.levelInfo().gameRules.fireSpreadRadiusAroundPlayer
  # Try to spread fire to nearby air blocks
  let difficulty = int32(ord(world.levelInfo().difficulty))
  for xx in -1'i32 .. 1'i32:
    for zz in -1'i32 .. 1'i32:
      for yy in -1'i32 .. 4'i32:
        if xx != 0 or yy != 0 or zz != 0:
          let offsetPos = pos.offset(vec3[int32](xx, yy, zz))
          let igniteOdds = self.getBurnChance(world, offsetPos)
          if igniteOdds > 0'i32:
            # Skip if spreding is disabled or if there are no players nearby
            if spreadRadius == 0:
              continue
            if spreadRadius != -1:
              let center = offsetPos.toCenteredF64()
              let closest = world.closestPlayer0
              if closest == nil or closest(center, float64(spreadRadius)).isNone():
                continue
            # Calculate spread rate based on height
            let rate = if yy > 1'i32: 100'i32 + (yy - 1'i32) * 100'i32 else: 100'i32
            # Calculate odds of spreading
            var odds = (igniteOdds + 40'i32 + difficulty * 7'i32) div (int32(newAge) + 30'i32)
            # Reduce spread odds in certain biomes
            if isIncreasedBurnoutBiome(world, offsetPos):
              odds = odds div 2'i32  # Fire spreads 50% slower
            if odds > 0'i32 and int32(rng().randomRange(0'i32 ..< rate)) <= odds and not isNearRain(world, offsetPos):
              let spreadAge = uint8(min(int32(newAge) + int32(rng().randomRange(0'i32 ..< 5'i32)) div 4'i32, 15'i32))
              let fireStateId = self.getStateForPosition(world, blockRef, offsetPos)
              var newFireProps = FireProperties.fromStateId(fireStateId, blockFire())
              newFireProps.age = spreadAge
              discard world.setBlockState(offsetPos, newFireProps.toStateId(blockFire()), BfNotifyNeighbors)

proc fireBlockBroken_BlockBehaviour(args: BrokenArgs) =
  broken(args.world, args.position)

proc newFireBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = fireBlockPlaced_BlockBehaviour
  result.onEntityCollisionImpl = fireBlockOnEntityCollision_BlockBehaviour
  result.getStateForNeighborUpdateImpl = fireBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = fireBlockCanPlaceAt_BlockBehaviour
  result.onScheduledTickImpl = fireBlockOnScheduledTick_BlockBehaviour
  result.brokenImpl = fireBlockBroken_BlockBehaviour

proc registerBlocksFireFire*(r: BlockRegistry) =
  r.register("minecraft:fire", newFireBlock())
