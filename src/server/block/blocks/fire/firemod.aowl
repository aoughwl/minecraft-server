## Port of pumpkin/src/block/blocks/fire/mod.rs
## `FireBlock::is_flammable` and `FireBlock::are_blocks_around_flammable` (fire/fire.rs) live here: upstream's
## `FireBlockBase::can_place_at` calls `FireBlock.can_place_at`, and fire.aowl imports this module, so the two leaf
## helpers `FireBlock.can_place_at` needs sit below both. `SoulFireBlock::is_soul_base` is inlined for the same reason.
## `Xoroshiro::from_seed(rand::random())` is a draw from the module generator: only the one value is used.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../../../../generated/dimension
import ../../../world/portal/nether


type
  FireBlockBase* = object



proc getFireType*(world: BlockWorld, pos: BlockPos): Block
proc canPlaceOn*(blockRef: Block): bool
proc isSoulFire*(world: BlockWorld, blockPos: BlockPos): bool
proc isFlammable*(blockState: BlockState): bool
proc areBlocksAroundFlammable*(blockAccessor: BlockWorld, pos: BlockPos): bool
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool
proc shouldLightPortalAt*(world: BlockWorld, blockPos: BlockPos, direction: BlockDirection): bool
proc applyFireCollision*(args: OnEntityCollisionArgs, extraDamageForLiving: bool)
proc broken*(world: BlockWorld, blockPos: BlockPos)

proc getFireType*(world: BlockWorld, pos: BlockPos): Block =
  let blockRef = world.getBlock(pos.down())
  if blockRef.hasTag(Block_MINECRAFT_SOUL_FIRE_BASE_BLOCKS):  # `SoulFireBlock::is_soul_base`, inlined: soul_fire imports this module
    return blockSoulFire()
  blockFire()

proc canPlaceOn*(blockRef: Block): bool =
  # Make sure the block below is not a fire block or fluid block
  (blockRef != blockSoulFire()) and (blockRef != blockFire()) and (blockRef != blockWater()) and (blockRef != blockLava())

proc isSoulFire*(world: BlockWorld, blockPos: BlockPos): bool =
  let blockRef = world.getBlock(blockPos.down())
  blockRef.hasTag(Block_MINECRAFT_SOUL_FIRE_BASE_BLOCKS)

proc isFlammable*(blockState: BlockState): bool =
  ## `FireBlock::is_flammable`
  let blockRef = Block.fromStateId(blockState.id)
  if blockRef.isWaterlogged(blockState.id):
    return false
  blockRef.hasFlammable and blockRef.flammable.burnChance > 0'u8

proc areBlocksAroundFlammable*(blockAccessor: BlockWorld, pos: BlockPos): bool =
  ## `FireBlock::are_blocks_around_flammable`
  let allDirections = blockDirectionAll()
  for direction in allDirections:
    let neighborPos = pos.offset(direction.toOffset())
    let blockState = blockAccessor.getBlockState(neighborPos)
    if isFlammable(blockState):
      return true
  false

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let blockState = world.getBlockState(blockPos)
  if not blockState.isAir():
    return false
  if isSoulFire(world, blockPos):
    # `SoulFireBlock.can_place_at`
    return world.getBlock(blockPos.down()).hasTag(Block_MINECRAFT_SOUL_FIRE_BASE_BLOCKS)
  # `FireBlock.can_place_at`
  let stateBelow = world.getBlockState(blockPos.down())
  (stateBelow.isSideSolid(BlockDirection.Up) or areBlocksAroundFlammable(world, blockPos)) or
    shouldLightPortalAt(world, blockPos, BlockDirection.Up)

proc shouldLightPortalAt*(world: BlockWorld, blockPos: BlockPos, direction: BlockDirection): bool =
  let dimension = world.dimension
  if (dimension != OVERWORLD) and (dimension != THE_NETHER):
    return false
  var found = false
  let allDirs = blockDirectionAll()
  for dir in allDirs:
    if world.getBlock(blockPos.offset(dir.toOffset())) == blockObsidian():
      found = true
      break
  if not found:
    return false
  var dir1 = HorizontalAxis.X
  if direction.isHorizontal():
    dir1 = direction.rotateCounterClockwise().toHorizontalAxis().get()
  else:
    dir1 = BlockDirection.randomHorizontal(proc(bound: int32): int32 {.closure.} = int32(rng().randomRange(0'i32 ..< bound))).toAxis()
  getNewPortal(world, blockPos, dir1).isSome()

proc applyFireCollision*(args: OnEntityCollisionArgs, extraDamageForLiving: bool) =
  ## Shared fire collision behavior used by `fire` and `soul_fire`.
  let baseEntity = args.entity.getEntity()
  if not baseEntity.fireImmune():
    let ticks = baseEntity.fireTicks()
    # Timer logic
    if ticks < 0:
      baseEntity.fireTicks = ticks + 1
    elif baseEntity.entityTypeName == "player":
      let rndTicks = rng().randomRange(1'i32 ..< 3'i32)
      baseEntity.fireTicks = ticks + rndTicks
    # Apply fire ticks
    if baseEntity.fireTicks() >= 0:
      args.entity.setOnFireFor(8.0'f32)
    # Regular fire vs soul fire damage
    if extraDamageForLiving:
      discard baseEntity.damage(2.0'f32, "in_fire")
    else:
      discard baseEntity.damage(1.0'f32, "in_fire")

proc broken*(world: BlockWorld, blockPos: BlockPos) =
  world.syncWorldEvent(weSoundExtinguishFire, blockPos, 0'i32)
