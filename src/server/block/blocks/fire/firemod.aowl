import ../../blockprelude
import fire


type
  FireBlockBase* = object



proc getFireType*(world: BlockWorld, pos: BlockPos): Block
proc canPlaceOn*(blockRef: Block): bool
proc isSoulFire*(world: BlockWorld, blockPos: BlockPos): bool
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool
proc shouldLightPortalAt*(world: BlockWorld, blockPos: BlockPos, direction: BlockDirection): bool
proc applyFireCollision*(args: OnEntityCollisionArgs, extraDamageForLiving: bool)
proc broken*(world: BlockWorld, blockPos: BlockPos)

proc getFireType*(world: BlockWorld, pos: BlockPos): Block =
  let blockRef = world.getBlock(pos.down())
  if isSoulBase(blockRef):
    return blockSoulFire()
  blockFire()

proc canPlaceOn*(blockRef: Block): bool =
  # Make sure the block below is not a fire block or fluid block
  ((((blockRef != blockSoulFire()) and (blockRef != blockFire())) and (blockRef != blockWater())) and (blockRef != blockLava()))

proc isSoulFire*(world: BlockWorld, blockPos: BlockPos): bool =
  let blockRef = world.getBlock(blockPos.down())
  blockRef.hasTag(Block_MINECRAFT_SOUL_FIRE_BASE_BLOCKS)

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let blockState = world.getBlockState(blockPos)
  if (not blockState.isAir()):
    return false
  if isSoulFire(world, blockPos):
    SoulFireBlock.canPlaceAt(CanPlaceAtArgs(world: some(world), blockAccessor: world, block0: blockSoulFire(), state: blockSoulFire().defaultState, position: blockPos, ))
  else:
    (FireBlock.canPlaceAt(CanPlaceAtArgs(world: some(world), blockAccessor: world, block0: blockFire(), state: blockFire().defaultState, position: blockPos, )) or shouldLightPortalAt(world, blockPos, BlockDirection.Up))

proc shouldLightPortalAt*(world: BlockWorld, blockPos: BlockPos, direction: BlockDirection): bool =
  let dimension = world.dimension
  if (dimension != Dimension.OVERWORLD) and (dimension != Dimension.THE_NETHER):
    return false
  var found = false
  let t1 = blockDirectionAll()
  for dir in t1:
    if (world.getBlock(blockPos.offset(dir.toOffset())) == blockObsidian()):
      found = true
      break
  if (not found):
    return false
  let t2 = block:
    if direction.isHorizontal():
      direction.rotateCounterClockwise().toHorizontalAxis().get()
    else:
      BlockDirection.randomHorizontal(RandomGenerator.Xoroshiro(Xoroshiro.fromSeed(rng().random()))).toAxis()
  let dir1 = t2
  NetherPortal.getNewPortal(world, blockPos, dir1).isSome()

proc applyFireCollision*(args: OnEntityCollisionArgs, extraDamageForLiving: bool) =
  let baseEntity = args.entity.getEntity()
  if (not baseEntity.entityType.fireImmune) and (not baseEntity.fireImmune):
    let ticks = baseEntity.fireTicks
    # Timer logic
    if (ticks < 0):
      baseEntity.fireTicks = (ticks + 1)
    elif (baseEntity.entityType == EntityType.PLAYER):
      let rndTicks = rng().randomRange(1 ..< 3)
      baseEntity.fireTicks = (ticks + rndTicks)
    # Apply fire ticks
    if (baseEntity.fireTicks >= 0):
      args.entity.setOnFireFor(8.0)
    # Regular fire vs soul fire damage
    if extraDamageForLiving:
      baseEntity.damage(args.entity, 2.0, DamageType.IN_FIRE)
    else:
      baseEntity.damage(args.entity, 1.0, DamageType.IN_FIRE)

proc broken*(world: BlockWorld, blockPos: BlockPos) =
  world.syncWorldEvent(weSoundExtinguishFire, blockPos, 0)

