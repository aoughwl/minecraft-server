import ../../blockprelude
import firemod


type
  SoulFireBlock* = object



proc isSoulBase*(blockRef: Block): bool
proc soulFireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc soulFireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc soulFireBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc soulFireBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newSoulFireBlock*(): BlockBehaviour

proc isSoulBase*(blockRef: Block): bool =
  blockRef.hasTag(Block_MINECRAFT_SOUL_FIRE_BASE_BLOCKS)

proc soulFireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  applyFireCollision(args, true)

proc soulFireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not isSoulBase(args.world.getBlock(args.position.down()))):
    return blockAir().defaultState.id
  args.stateId

proc soulFireBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  isSoulBase(args.blockAccessor.getBlock(args.position.down()))

proc soulFireBlockBroken_BlockBehaviour(args: BrokenArgs) =
  broken(args.world, args.position)

proc newSoulFireBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = soulFireBlockOnEntityCollision_BlockBehaviour
  result.getStateForNeighborUpdateImpl = soulFireBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = soulFireBlockCanPlaceAt_BlockBehaviour
  result.brokenImpl = soulFireBlockBroken_BlockBehaviour

proc registerBlocksFireSoulFire*(r: BlockRegistry) =
  r.register("minecraft:soul_fire", newSoulFireBlock())

