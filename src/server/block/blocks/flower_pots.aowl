## Port of pumpkin/src/block/blocks/flower_pots.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/dimension
import ../../../generated/flower_pot_transformations


type
  FlowerPotBlock* = object



proc flowerPotBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let item = args.itemStack.stack.item
  # Place the flower inside the pot
  let pottedBlockId = BlockId(getPottedItem(item.id))
  if args.block0 == blockFlowerPot():
    if (not (pottedBlockId == blockIdAir)):
      discard args.world.setBlockState(args.position, Block.fromId(pottedBlockId).defaultState.id, BfNotifyAll)
    return barSuccess
  elif (not (pottedBlockId == blockIdAir)):
    # if the player have an item that can be potted in his hand, nothing happens
    return barConsume
  # get the flower + empty the pot
  discard args.world.setBlockState(args.position, blockFlowerPot().defaultState.id, BfNotifyAll)
  barSuccess

proc flowerPotBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  if ((args.world.dimension.id == OVERWORLD.id or args.world.dimension.id == OVERWORLD_CAVES.id)) and args.block0 == blockPottedClosedEyeblossom() and ((args.world.getTimeOfDay() mod 24000'i64) > 14500'i64):
    discard args.world.setBlockState(args.position, blockPottedOpenEyeblossom().defaultState.id, BfNotifyAll)
  if args.block0 == blockPottedOpenEyeblossom() and ((args.world.getTimeOfDay() mod 24000'i64) <= 14500'i64):
    discard args.world.setBlockState(args.position, blockPottedClosedEyeblossom().defaultState.id, BfNotifyAll)

proc newFlowerPotBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.useWithItemImpl = flowerPotBlockUseWithItem_BlockBehaviour
  result.randomTickImpl = flowerPotBlockRandomTick_BlockBehaviour

proc registerBlocksFlowerPots*(r: BlockRegistry) =
  r.registerTag("minecraft:flower_pots", newFlowerPotBlock())

