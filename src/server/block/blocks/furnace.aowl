## Port of pumpkin/src/block/blocks/furnace.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property
import ../../../inventory/furnace_like_screen_handler
import ../../../generated/[translation, screen]
import ../entities/furnace

proc furnaceBlockScreenFactory(inventory: Inventory; propertyDelegate: PropertyDelegate;
    experienceContainer: ExperienceContainer): BlockScreenFactory =
  ## `FurnaceScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_FURNACE, BEDROCK_CONTAINER_FURNACE),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(newFurnaceLikeScreenHandler(syncId, playerInventory, inventory, propertyDelegate, experienceContainer,
        wtFurnace)))

proc furnaceBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barConsume
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barConsume
  let propertyDelegate = blockEntity.unsafeGet.toPropertyDelegate()
  if propertyDelegate.isNone:
    return barConsume
  let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
  if experienceContainer.isNone:
    return barConsume
  args.player.incrementStat(scCustom, int32(csInteractWithFurnace), 1)
  args.player.openHandledScreen(furnaceBlockScreenFactory(inventory.unsafeGet, propertyDelegate.unsafeGet,
    experienceContainer.unsafeGet), some(args.position))
  barConsume

proc furnaceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc furnaceBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newFurnaceBlockEntity(args.position))

proc furnaceBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
    if experienceContainer.isSome:
      let xp = experienceContainer.unsafeGet.extractExperience()
      if xp > 0:
        args.world.spawnExperienceOrb(args.position.toF64(), uint32(xp))
  args.world.removeBlockEntity(args.position)

proc furnaceBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let inventory = blockEntity.unsafeGet.getInventory()
    if inventory.isSome:
      return some(calculateComparatorOutput(inventory.unsafeGet))
  none[uint8]()

proc newFurnaceBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = furnaceBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = furnaceBlockOnPlace_BlockBehaviour
  result.placedImpl = furnaceBlockPlaced_BlockBehaviour
  result.brokenImpl = furnaceBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = furnaceBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksFurnace*(r: BlockRegistry) =
  r.register("minecraft:furnace", newFurnaceBlock())
