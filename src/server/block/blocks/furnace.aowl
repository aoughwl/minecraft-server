import ../blockprelude
import ../entities/furnace
import ../entities/furnace_like_block_entity


type
  FurnaceScreenFactory* = ref object
    inventory*: Inventory
    propertyDelegate*: PropertyDelegate
    experienceContainer*: ExperienceContainer
  FurnaceBlock* = object



proc newFurnaceScreenFactory*(inventory: Inventory, propertyDelegate: PropertyDelegate, experienceContainer: ExperienceContainer): FurnaceScreenFactory
proc createScreenHandler*(self: FurnaceScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: FurnaceScreenFactory): TextComponent
proc furnaceBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc furnaceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc furnaceBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc furnaceBlockBroken_BlockBehaviour(args: BrokenArgs)
proc furnaceBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8]
proc newFurnaceBlock*(): BlockBehaviour

proc newFurnaceScreenFactory*(inventory: Inventory, propertyDelegate: PropertyDelegate, experienceContainer: ExperienceContainer): FurnaceScreenFactory =
  FurnaceScreenFactory(inventory: inventory, propertyDelegate: propertyDelegate, experienceContainer: experienceContainer)

proc createScreenHandler*(self: FurnaceScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let concreteHandler = newFurnaceLikeScreenHandler(syncId, playerInventory, self.inventory, self.propertyDelegate, self.experienceContainer, WindowType.Furnace)
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: FurnaceScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_FURNACE, CONTAINER_FURNACE, [])

proc furnaceBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain5:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        let t3 = t1.unsafeGet.toPropertyDelegate()
        if t3.isSome:
          let propertyDelegate = t3.unsafeGet
          let t4 = t1.unsafeGet.toExperienceContainer()
          if t4.isSome:
            let experienceContainer = t4.unsafeGet
            args.player.incrementStat(scCustom, int32(csInteractWithFurnace), 1)
            let furnaceScreenFactory = newFurnaceScreenFactory(t2.unsafeGet, t3.unsafeGet, t4.unsafeGet)
            args.player.openHandledScreen(furnaceScreenFactory, some(args.position))
  barConsume

proc furnaceBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc furnaceBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let furnaceBlockEntity = newFurnaceBlockEntity(args.position)
  args.world.addBlockEntity(furnaceBlockEntity)

proc furnaceBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  block chain8:
    let t6 = args.world.getBlockEntity(args.position)
    if t6.isSome:
      let blockEntity = t6.unsafeGet
      let t7 = t6.unsafeGet.toExperienceContainer()
      if t7.isSome:
        let experienceContainer = t7.unsafeGet
        let xp = t7.unsafeGet.extractExperience()
        if (xp > 0):
          let pos = args.position.toF64()
          ExperienceOrbEntity.spawn(args.world, pos, uint32(xp))
  args.world.removeBlockEntity(args.position)

proc furnaceBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain11:
    let t9 = args.world.getBlockEntity(args.position)
    if t9.isSome:
      let blockEntity = t9.unsafeGet
      let t10 = t9.unsafeGet.getInventory()
      if t10.isSome:
        let inventory = t10.unsafeGet
        some(calculateComparatorOutput(t10.unsafeGet))
        break chain11
    none[uint8]()

proc newFurnaceBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = furnaceBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = furnaceBlockOnPlace_BlockBehaviour
  result.placedImpl = furnaceBlockPlaced_BlockBehaviour
  result.brokenImpl = furnaceBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = furnaceBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksFurnace*(r: BlockRegistry) =
  r.register("minecraft:furnace", newFurnaceBlock())

