## Port of pumpkin/src/block/blocks/glass_panes.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  GlassPaneProperties = OakFenceLikeProperties
  GlassPaneBlock* = object



proc glassPaneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc glassPaneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newGlassPaneBlock*(): BlockBehaviour
proc computePaneState*(paneProps: GlassPaneProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId

proc glassPaneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var paneProps = GlassPaneProperties.defaultFor(args.block0)
  paneProps.waterlogged = args.replacing.waterSource()
  computePaneState(paneProps, args.world, args.block0, args.position)

proc glassPaneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let paneProps = GlassPaneProperties.fromStateId(args.stateId, args.block0)
  computePaneState(paneProps, args.world, args.block0, args.position)

proc newGlassPaneBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = glassPaneBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = glassPaneBlockGetStateForNeighborUpdate_BlockBehaviour

proc computePaneState*(paneProps: GlassPaneProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId =
  var paneProps = paneProps
  let t1 = blockDirectionHorizontal()
  for direction in t1:
    let otherBlockPos = blockPos.offset(direction.toOffset())
    let (otherBlock, otherBlockState) = world.getBlockAndState(otherBlockPos)
    let connected = (((((otherBlock == blockRef) or otherBlockState.isSideSolid(direction.opposite().toBlockDirection())) or otherBlock.hasTag(Block_C_GLASS_PANES)) or (otherBlock == blockIronBars())) or otherBlock.hasTag(Block_MINECRAFT_WALLS))
    case direction
    of HorizontalFacing.North:
      paneProps.north = connected
    of HorizontalFacing.South:
      paneProps.south = connected
    of HorizontalFacing.West:
      paneProps.west = connected
    of HorizontalFacing.East:
      paneProps.east = connected
  paneProps.toStateId(blockRef)

proc registerBlocksGlassPanes*(r: BlockRegistry) =
  r.registerTag("c:glass_panes", newGlassPaneBlock())

