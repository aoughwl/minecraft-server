## Port of pumpkin/src/block/blocks/glazed_terracotta.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  GlazedTerracottaBlock* = object



proc glazedTerracottaBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc newGlazedTerracottaBlock*(): BlockBehaviour

proc glazedTerracottaBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var prop = WallTorchLikeProperties.defaultFor(args.block0)
  prop.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  prop.toStateId(args.block0)

proc newGlazedTerracottaBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = glazedTerracottaBlockOnPlace_BlockBehaviour

proc registerBlocksGlazedTerracotta*(r: BlockRegistry) =
  r.registerTag("minecraft:glazed_terracotta", newGlazedTerracottaBlock())

