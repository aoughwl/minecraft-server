## Port of pumpkin/src/block/blocks/grindstone.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import abstract_wall_mounting


type
  GrindstoneBlock* = object

var gGrindstoneBlockAsWallMountedBlock: nil WallMountedBlock


proc grindstoneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc grindstoneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc grindstoneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newGrindstoneBlock*(): BlockBehaviour
proc grindstoneBlockCanPlaceAt_WallMountedBlock(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool
proc grindstoneBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc grindstoneBlockAsWallMountedBlock*(): WallMountedBlock

proc grindstoneBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = GrindstoneLikeProperties.fromStateId(args.block0.defaultState.id, args.block0)
  (props.face, props.facing) = getPlacementFace(grindstoneBlockAsWallMountedBlock(), args.player, args.direction)
  props.toStateId(args.block0)

proc grindstoneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  # Use the provided direction, or fallback to the current state's direction if missing
  let t1 = args.direction
  let t2 =
    if t1.isSome: t1.unsafeGet
    else:
      getDirection(grindstoneBlockAsWallMountedBlock(), args.state.id, args.block0)
  let direction = t2
  canPlaceAt(grindstoneBlockAsWallMountedBlock(), args.blockAccessor, args.position, direction)

proc grindstoneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(grindstoneBlockAsWallMountedBlock(), args)

proc newGrindstoneBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = grindstoneBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = grindstoneBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = grindstoneBlockGetStateForNeighborUpdate_BlockBehaviour

proc grindstoneBlockCanPlaceAt_WallMountedBlock(self: WallMountedBlock, world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool =
  true

proc grindstoneBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let props = GrindstoneLikeProperties.fromStateId(stateId, blockRef)
  case props.face
  of AttachFace.Floor:
    BlockDirection.Up
  of AttachFace.Ceiling:
    BlockDirection.Down
  of AttachFace.Wall:
    props.facing.toBlockDirection()

proc grindstoneBlockAsWallMountedBlock*(): WallMountedBlock =
  if gGrindstoneBlockAsWallMountedBlock == nil:
    let v = newWallMountedBlock()
    v.canPlaceAtImpl = grindstoneBlockCanPlaceAt_WallMountedBlock
    v.getDirectionImpl = grindstoneBlockGetDirection_WallMountedBlock
    gGrindstoneBlockAsWallMountedBlock = v
  gGrindstoneBlockAsWallMountedBlock

proc registerBlocksGrindstone*(r: BlockRegistry) =
  r.register("minecraft:grindstone", newGrindstoneBlock())

