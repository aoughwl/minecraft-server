## Every growth, plant, fire, coral and weather block this batch ported, registered together: all their tag and id names must
## resolve, and each registered block id must answer with a behaviour.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude

from "amethyst" import registerBlocksAmethyst
from "bubble_column" import registerBlocksBubbleColumn
from "cake" import registerBlocksCake
from "candle_cakes" import registerBlocksCandleCakes
from "candles" import registerBlocksCandles
from "carved_pumpkin" import registerBlocksCarvedPumpkin
from "cobweb" import registerBlocksCobweb
from "coral/coral_block" import registerBlocksCoralCoralBlock
from "coral/coral_fan" import registerBlocksCoralCoralFan
from "coral/coral_plant" import registerBlocksCoralCoralPlant
from "dripstone" import registerBlocksDripstone
from "fire/fire" import registerBlocksFireFire
from "fire/soul_fire" import registerBlocksFireSoulFire
from "hay" import registerBlocksHay
from "magma" import registerBlocksMagma
from "plant/bamboo" import registerBlocksPlantBamboo
from "plant/bamboo_sapling" import registerBlocksPlantBambooSapling
from "plant/big_dripleaf" import registerBlocksPlantBigDripleaf
from "plant/big_dripleaf_stem" import registerBlocksPlantBigDripleafStem
from "plant/bush" import registerBlocksPlantBush
from "plant/cactus" import registerBlocksPlantCactus
from "plant/cactus_flower" import registerBlocksPlantCactusFlower
from "plant/chorus_flower" import registerBlocksPlantChorusFlower
from "plant/chorus_plant" import registerBlocksPlantChorusPlant
from "plant/crop/beetroot" import registerBlocksPlantCropBeetroot
from "plant/crop/carrot" import registerBlocksPlantCropCarrot
from "plant/crop/gourds/attached_stem" import registerBlocksPlantCropGourdsAttachedStem
from "plant/crop/gourds/stem" import registerBlocksPlantCropGourdsStem
from "plant/crop/nether_wart" import registerBlocksPlantCropNetherWart
from "plant/crop/potatoes" import registerBlocksPlantCropPotatoes
from "plant/crop/sweet_berry_bush" import registerBlocksPlantCropSweetBerryBush
from "plant/crop/torch_flower" import registerBlocksPlantCropTorchFlower
from "plant/crop/wheat" import registerBlocksPlantCropWheat
from "plant/dry_vegetation" import registerBlocksPlantDryVegetation
from "plant/flower" import registerBlocksPlantFlower
from "plant/flowerbed" import registerBlocksPlantFlowerbed
from "plant/fungus" import registerBlocksPlantFungus
from "plant/kelp" import registerBlocksPlantKelp
from "plant/leaf_litter" import registerBlocksPlantLeafLitter
from "plant/lily_pad" import registerBlocksPlantLilyPad
from "plant/mushroom_plant" import registerBlocksPlantMushroomPlant
from "plant/nether_sprouts" import registerBlocksPlantNetherSprouts
from "plant/roots" import registerBlocksPlantRoots
from "plant/sapling" import registerBlocksPlantSapling
from "plant/sea_pickles" import registerBlocksPlantSeaPickles
from "plant/seagrass" import registerBlocksPlantSeagrass
from "plant/short_plant" import registerBlocksPlantShortPlant
from "plant/small_dripleaf" import registerBlocksPlantSmallDripleaf
from "plant/spore_blossom" import registerBlocksPlantSporeBlossom
from "plant/sugar_cane" import registerBlocksPlantSugarCane
from "plant/tall_plant" import registerBlocksPlantTallPlant
from "plant/tall_seagrass" import registerBlocksPlantTallSeagrass
from "plant/twisting_vines" import registerBlocksPlantTwistingVines
from "plant/weeping_vines" import registerBlocksPlantWeepingVines
from "plant/wither_rose" import registerBlocksPlantWitherRose
from "powder_snow" import registerBlocksPowderSnow
from "pumpkin" import registerBlocksPumpkin
from "slime" import registerBlocksSlime
from "snow" import registerBlocksSnow
from "sponge" import registerBlocksSponge
from "tnt" import registerBlocksTnt
from "vine" import registerBlocksVine
from "../fluid/lava" import registerFluidLava

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

let r = newBlockRegistry()
registerBlocksAmethyst(r)
registerBlocksBubbleColumn(r)
registerBlocksCake(r)
registerBlocksCandleCakes(r)
registerBlocksCandles(r)
registerBlocksCarvedPumpkin(r)
registerBlocksCobweb(r)
registerBlocksCoralCoralBlock(r)
registerBlocksCoralCoralFan(r)
registerBlocksCoralCoralPlant(r)
registerBlocksDripstone(r)
registerBlocksFireFire(r)
registerBlocksFireSoulFire(r)
registerBlocksHay(r)
registerBlocksMagma(r)
registerBlocksPlantBamboo(r)
registerBlocksPlantBambooSapling(r)
registerBlocksPlantBigDripleaf(r)
registerBlocksPlantBigDripleafStem(r)
registerBlocksPlantBush(r)
registerBlocksPlantCactus(r)
registerBlocksPlantCactusFlower(r)
registerBlocksPlantChorusFlower(r)
registerBlocksPlantChorusPlant(r)
registerBlocksPlantCropBeetroot(r)
registerBlocksPlantCropCarrot(r)
registerBlocksPlantCropGourdsAttachedStem(r)
registerBlocksPlantCropGourdsStem(r)
registerBlocksPlantCropNetherWart(r)
registerBlocksPlantCropPotatoes(r)
registerBlocksPlantCropSweetBerryBush(r)
registerBlocksPlantCropTorchFlower(r)
registerBlocksPlantCropWheat(r)
registerBlocksPlantDryVegetation(r)
registerBlocksPlantFlower(r)
registerBlocksPlantFlowerbed(r)
registerBlocksPlantFungus(r)
registerBlocksPlantKelp(r)
registerBlocksPlantLeafLitter(r)
registerBlocksPlantLilyPad(r)
registerBlocksPlantMushroomPlant(r)
registerBlocksPlantNetherSprouts(r)
registerBlocksPlantRoots(r)
registerBlocksPlantSapling(r)
registerBlocksPlantSeaPickles(r)
registerBlocksPlantSeagrass(r)
registerBlocksPlantShortPlant(r)
registerBlocksPlantSmallDripleaf(r)
registerBlocksPlantSporeBlossom(r)
registerBlocksPlantSugarCane(r)
registerBlocksPlantTallPlant(r)
registerBlocksPlantTallSeagrass(r)
registerBlocksPlantTwistingVines(r)
registerBlocksPlantWeepingVines(r)
registerBlocksPlantWitherRose(r)
registerBlocksPowderSnow(r)
registerBlocksPumpkin(r)
registerBlocksSlime(r)
registerBlocksSnow(r)
registerBlocksSponge(r)
registerBlocksTnt(r)
registerBlocksVine(r)
registerFluidLava(r)
for name in r.unknown:
  echo "unknown: ", name
check(r.unknown.len == 0, "every registered name resolves")
for blockRef in [blockDandelion(), blockCactus(), blockSugarCane(), blockWheat(), blockSweetBerryBush(), blockBamboo(), blockTallGrass(),
    blockPinkPetals(), blockLeafLitter(), blockOakSapling(), blockKelp(), blockLilyPad(), blockFire(), blockSoulFire(), blockSnow(),
    blockPowderSnow(), blockSponge(), blockWetSponge(), blockTnt(), blockCake(), blockCandle(), blockCandleCake(), blockCobweb(),
    blockPumpkin(), blockCarvedPumpkin(), blockJackOLantern(), blockVine(), blockHayBlock(), blockMagmaBlock(), blockSlimeBlock(),
    blockBubbleColumn(), blockBrainCoral(), blockBrainCoralBlock(), blockBrainCoralFan(), blockPointedDripstone(), blockAmethystCluster()]:
  check(r.getPumpkinBlock(blockRef.id).isSome, blockRef.name & " has a behaviour")
check(r.getPumpkinFluid(Fluid.FLOWING_LAVA.id).isSome, "flowing lava has a fluid behaviour")
echo "growth registry ok"
