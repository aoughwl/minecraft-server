## Plants, crops, snow, sponge, fire, cobweb, tnt and cake through the real registry over testworld.aowl. Known answers are
## worked out from the Rust (pumpkin/src/block/blocks/...) and from vanilla; every random draw is either forced by the state
## (a cactus at age 15) or repeated until it cannot miss (wheat over 600 random ticks, miss odds below 1e-30).

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio, strutils]
import ../blockprelude
import ../testworld
import plant/[flower, cactus, sugar_cane, tall_plant, flowerbed, bamboo, segmented]
import plant/crop/[cropmod, wheat]
from ../../../world/worldinfo import defaultLevelData, LevelData
import magma, powder_snow, hay, ../fluid/lava
import snow, sponge, cobweb, tnt, cake, candle_cakes, fire/[firemod, fire]

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc stage(name: string) =
  echo name
  stdout.flushFile()

stage("init")

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksPlantFlower(result)
  registerBlocksPlantCactus(result)
  registerBlocksPlantSugarCane(result)
  registerBlocksPlantTallPlant(result)
  registerBlocksPlantFlowerbed(result)
  registerBlocksPlantBamboo(result)
  registerBlocksPlantCropWheat(result)
  registerBlocksSnow(result)
  registerBlocksSponge(result)
  registerBlocksCobweb(result)
  registerBlocksTnt(result)
  registerBlocksCake(result)
  registerBlocksCandleCakes(result)
  registerBlocksFireFire(result)
  registerBlocksMagma(result)
  registerBlocksPowderSnow(result)
  registerBlocksHay(result)
  registerFluidLava(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc canPlace(t: TestWorld; blockRef: Block; pos: BlockPos): bool =
  let b = t.world.blockRegistry.getPumpkinBlock(blockRef.id)
  check(b.isSome, blockRef.name & " is registered")
  b.unsafeGet.canPlaceAt(CanPlaceAtArgs(world: t.world, blockAccessor: t.world, block0: blockRef,
    state: blockRef.defaultState, position: pos))

proc randomTick(t: TestWorld; blockRef: Block; pos: BlockPos) =
  let b = t.world.blockRegistry.getPumpkinBlock(blockRef.id)
  b.unsafeGet.randomTick(RandomTickArgs(world: t.world, block0: blockRef, position: pos))

proc at(x, y, z: int32): BlockPos = blockPos(x, y, z)

proc flowersNeedVegetationSupport() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  check(not t.canPlace(blockDandelion(), pos), "a dandelion cannot stand on air")
  t.put(at(0, 63, 0), blockStone())
  check(not t.canPlace(blockDandelion(), pos), "nor on stone")
  t.put(at(0, 63, 0), blockGrassBlock())
  check(t.canPlace(blockDandelion(), pos), "but on grass it can")
  t.put(at(0, 63, 0), blockFarmland())
  check(t.canPlace(blockDandelion(), pos), "and on farmland (supports_vegetation)")
  # A flower whose ground is removed is replaced by air on the neighbour update.
  t.put(at(0, 63, 0), blockGrassBlock())
  discard t.world.setBlockState(pos, blockDandelion().defaultState.id, BfNotifyAll)
  discard t.world.setBlockState(at(0, 63, 0), blockStateIdAir, BfNotifyAll)
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "the flower goes with its ground")

proc cactusRules() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  t.put(at(0, 63, 0), blockSand())
  check(t.canPlace(blockCactus(), pos), "a cactus stands on sand")
  t.put(at(1, 64, 0), blockStone())
  check(not t.canPlace(blockCactus(), pos), "not beside a solid block")
  t.put(at(1, 64, 0), blockAir())
  t.put(at(0, 63, 0), blockDirt())
  check(not t.canPlace(blockCactus(), pos), "not on dirt")
  # Age 15 with room above: the next piece grows and the base starts over at age 0.
  let t2 = newTestWorld(newRegistry())
  t2.put(at(0, 63, 0), blockSand())
  var props = CactusLikeProperties.defaultFor(blockCactus())
  props.age = 15'u8
  t2.put(pos, props.toStateId(blockCactus()))
  t2.randomTick(blockCactus(), pos)
  check(sameBlock(t2.world.getBlock(at(0, 65, 0)), blockCactus()), "a ripe cactus grows a block")
  check(CactusLikeProperties.fromStateId(t2.world.getBlockStateId(pos), blockCactus()).age == 0'u8, "and the base restarts at age 0")
  # A young cactus only ages.
  let t3 = newTestWorld(newRegistry())
  t3.put(at(0, 63, 0), blockSand())
  var young = CactusLikeProperties.defaultFor(blockCactus())
  young.age = 3'u8
  t3.put(pos, young.toStateId(blockCactus()))
  t3.randomTick(blockCactus(), pos)
  check(CactusLikeProperties.fromStateId(t3.world.getBlockStateId(pos), blockCactus()).age == 4'u8, "age 3 becomes 4")
  # Three tall: no further growth.
  let t4 = newTestWorld(newRegistry())
  t4.put(at(0, 63, 0), blockSand())
  t4.put(at(0, 64, 0), blockCactus())
  t4.put(at(0, 65, 0), blockCactus())
  var top = CactusLikeProperties.defaultFor(blockCactus())
  top.age = 15'u8
  t4.put(at(0, 66, 0), top.toStateId(blockCactus()))
  t4.randomTick(blockCactus(), at(0, 66, 0))
  check(t4.world.getBlockStateId(at(0, 67, 0)) == blockStateIdAir, "a cactus three tall stops growing")

proc sugarCaneNeedsWater() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  t.put(at(0, 63, 0), blockSand())
  check(not t.canPlace(blockSugarCane(), pos), "sugar cane on dry sand does not stand")
  t.put(at(1, 63, 0), blockWater())
  check(t.canPlace(blockSugarCane(), pos), "with water beside the sand it does")
  let t2 = newTestWorld(newRegistry())
  t2.put(at(0, 63, 0), blockSugarCane())
  check(t2.canPlace(blockSugarCane(), pos), "and on another sugar cane")

proc farmlandMoisture(moist: bool): BlockStateId =
  var props = FarmlandLikeProperties.defaultFor(blockFarmland())
  props.moisture = if moist: 7'u8 else: 0'u8
  props.toStateId(blockFarmland())

proc cropMoistureAndGrowth() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  stage("m0")
  t.put(at(0, 63, 0), farmlandMoisture(false))
  check(getAvailableMoisture(t.world, pos, blockWheat()) == 2.0'f32, "one dry farmland is 1 + 1")
  t.put(at(0, 63, 0), farmlandMoisture(true))
  check(getAvailableMoisture(t.world, pos, blockWheat()) == 4.0'f32, "one watered farmland is 1 + 3")
  for dx in -1'i32 .. 1'i32:
    for dz in -1'i32 .. 1'i32:
      t.put(at(dx, 63, dz), farmlandMoisture(true))
  check(getAvailableMoisture(t.world, pos, blockWheat()) == 10.0'f32, "nine watered farmlands are 1 + 3 + 8 * 3/4")
  stage("m1")
  # Crops in a row on both axes halve it.
  t.put(at(1, 64, 0), blockWheat())
  check(getAvailableMoisture(t.world, pos, blockWheat()) == 10.0'f32, "a neighbour on one axis does not")
  t.put(at(0, 64, 1), blockWheat())
  check(getAvailableMoisture(t.world, pos, blockWheat()) == 5.0'f32, "neighbours on both axes halve it")
  stage("m2")
  # Wheat ages to 7 and no further.
  let g = newTestWorld(newRegistry())
  g.put(at(0, 63, 0), farmlandMoisture(true))
  g.put(pos, blockWheat())
  var last = 0'u8
  stage("m3")
  for i in 0 ..< 600:
    if i < 3: stage("tick")
    g.randomTick(blockWheat(), pos)
    let age = WheatLikeProperties.fromStateId(g.world.getBlockStateId(pos), blockWheat()).age
    check(age >= last and age <= 7'u8, "wheat age only goes up, to 7")
    last = age
  check(last == 7'u8, "600 random ticks ripen wheat")

proc tallPlantsHaveTwoHalves() =
  let t = newTestWorld(newRegistry())
  t.put(at(0, 63, 0), blockGrassBlock())
  let pos = at(0, 64, 0)
  check(t.canPlace(blockTallGrass(), pos), "tall grass stands on grass with air above")
  t.put(at(0, 65, 0), blockStone())
  check(not t.canPlace(blockTallGrass(), pos), "not with the space above taken")
  t.put(at(0, 65, 0), blockAir())
  var lower = TallSeagrassLikeProperties.defaultFor(blockTallGrass())
  lower.half = DoubleBlockHalf.Lower
  let lowerId = lower.toStateId(blockTallGrass())
  t.put(pos, lowerId)
  let b = t.world.blockRegistry.getPumpkinBlock(blockTallGrass().id)
  b.unsafeGet.placed(PlacedArgs(world: t.world, block0: blockTallGrass(), stateId: lowerId, position: pos))
  let upper = t.world.getBlockStateId(at(0, 65, 0))
  check(sameBlock(Block.fromStateId(upper), blockTallGrass()), "placing writes the upper half")
  check(TallSeagrassLikeProperties.fromStateId(upper, blockTallGrass()).half == DoubleBlockHalf.Upper, "which is the upper half")
  # Breaking the lower half takes the upper one.
  discard t.world.breakBlock(pos, nil, BfNotifyAll or BfSkipDrops)
  check(t.world.getBlockStateId(at(0, 65, 0)) == blockStateIdAir, "the upper half goes with the lower")

proc bambooCounting() =
  let t = newTestWorld(newRegistry())
  for y in 63'i32 .. 65'i32:
    t.put(at(0, y, 0), blockBamboo())
  check(countBambooBelow(t.world, at(0, 66, 0)) == 3, "three bamboo under the top")
  check(countBambooBelow(t.world, at(0, 64, 0)) == 1, "one under the middle")
  check(countBambooAbove(t.world, at(0, 63, 0)) == 2, "two above the bottom")

proc petalsStack() =
  let t = newTestWorld(newRegistry())
  t.put(at(0, 63, 0), blockGrassBlock())
  let pos = at(0, 64, 0)
  let player = BlockPlayer()
  player.yaw0 = proc(): float32 {.closure.} = 0.0'f32  # looking south
  var useItemOn = SUseItemOn()
  useItemOn.cursorPos = Vector3[float32](x: 0.5'f32, y: 0.5'f32, z: 0.5'f32)
  let first = t.world.blockRegistry.onPlace(BlockServer(), t.world, player, blockPinkPetals(), pos, BlockDirection.Up,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), useItemOn)
  let p1 = PinkPetalsLikeProperties.fromStateId(first, blockPinkPetals())
  check(p1.flowerAmount == 1'u8, "the first petal")
  # Segment 1 faces South; a south-looking player turns that by two clockwise steps: North.
  check(p1.facing == HorizontalFacing.North, "faces back at the player")
  var id = first
  for expected in [2'u8, 3'u8, 4'u8, 4'u8]:
    id = t.world.blockRegistry.onPlace(BlockServer(), t.world, player, blockPinkPetals(), pos, BlockDirection.Up,
      BlockIsReplacing(kind: BlockIsReplacingKind.kItself, f0Itself: id), useItemOn)
    check(PinkPetalsLikeProperties.fromStateId(id, blockPinkPetals()).flowerAmount == expected, "petal count " & $expected)
  # The facing of the first petal is kept while the stack grows.
  check(PinkPetalsLikeProperties.fromStateId(id, blockPinkPetals()).facing == HorizontalFacing.North, "the facing stays")

proc spongeSoaksUp() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  # A flat sheet of water, 21 x 21. Within taxicab distance 7 of the sponge that is 4 * (1 + ... + 7) = 112 cells.
  for x in -10'i32 .. 10'i32:
    for z in -10'i32 .. 10'i32:
      t.put(at(x, 64, z), blockWater())
  t.put(pos, blockSponge())
  check(absorbWater(t.world, pos), "the sponge finds water")
  var left = 0
  var gone = 0
  for x in -10'i32 .. 10'i32:
    for z in -10'i32 .. 10'i32:
      if (abs(x) + abs(z) <= 7'i32) and not (x == 0 and z == 0):
        if t.world.getBlockStateId(at(x, 64, z)) == blockStateIdAir: gone += 1
      elif not (x == 0 and z == 0):
        if sameBlock(t.world.getBlock(at(x, 64, z)), blockWater()): left += 1
  check(gone == 112, "all 112 cells within 7 are drained")
  check(left == 21 * 21 - 1 - 112, "everything farther is untouched")
  check(sameBlock(t.world.getBlock(pos), blockWetSponge()), "the sponge turns wet")
  check(t.events.len == 1 and t.events[0].startsWith("sound "), "with one absorb sound")
  # No water around: nothing happens.
  let dry = newTestWorld(newRegistry())
  dry.put(pos, blockSponge())
  check(not absorbWater(dry.world, pos), "a dry sponge stays")
  check(sameBlock(dry.world.getBlock(pos), blockSponge()), "a sponge")
  # More than 118 water cells are available (a thick block of water): exactly 118 are taken.
  let deep = newTestWorld(newRegistry())
  for x in -7'i32 .. 7'i32:
    for y in 57'i32 .. 71'i32:
      for z in -7'i32 .. 7'i32:
        deep.put(at(x, y, z), blockWater())
  deep.put(pos, blockSponge())
  check(absorbWater(deep.world, pos), "a submerged sponge")
  var taken = 0
  for x in -7'i32 .. 7'i32:
    for y in 57'i32 .. 71'i32:
      for z in -7'i32 .. 7'i32:
        if deep.world.getBlockStateId(at(x, y, z)) == blockStateIdAir: taken += 1
  check(taken == 118, "the limit is 118 blocks")

proc snowPlacement(t: TestWorld; pos: BlockPos): BlockStateId =
  ## Snow has no `can_place_at` of its own: `on_place` answers air where a layer cannot lie.
  t.world.blockRegistry.onPlace(BlockServer(), t.world, BlockPlayer(), blockSnow(), pos, BlockDirection.Up,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())

proc snowLayers() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  check(t.snowPlacement(pos) == blockStateIdAir, "no snow over air")
  t.put(at(0, 63, 0), blockStone())
  check(sameBlock(Block.fromStateId(t.snowPlacement(pos)), blockSnow()), "snow lies on stone")
  check(SnowLikeProperties.fromStateId(t.snowPlacement(pos), blockSnow()).layers == 1'u8, "as one layer")
  t.put(at(0, 63, 0), blockIce())
  check(t.snowPlacement(pos) == blockStateIdAir, "not on ice (cannot_support_snow_layer)")
  t.put(at(0, 63, 0), blockStone())
  var props = SnowLikeProperties.defaultFor(blockSnow())
  props.layers = 3'u8
  t.put(pos, props.toStateId(blockSnow()))
  let b = t.world.blockRegistry.getPumpkinBlock(blockSnow().id).unsafeGet
  let snowStack = ItemStackRef(stack: newItemStack(1'u8, ITEM_SNOW))
  let hit = BlockHitResult(face: BlockDirection.Up, cursorPos: Vector3[float32](x: 0.5'f32, y: 0.5'f32, z: 0.5'f32))
  let r = b.useWithItem(UseWithItemArgs(world: t.world, block0: blockSnow(), position: pos, player: BlockPlayer(), hit: hit, itemStack: snowStack))
  check(r == barSuccess, "a snowball-sized item adds a layer")
  check(SnowLikeProperties.fromStateId(t.world.getBlockStateId(pos), blockSnow()).layers == 4'u8, "layer 3 becomes 4")
  props.layers = 8'u8
  t.put(pos, props.toStateId(blockSnow()))
  discard b.useWithItem(UseWithItemArgs(world: t.world, block0: blockSnow(), position: pos, player: BlockPlayer(), hit: hit, itemStack: snowStack))
  check(sameBlock(t.world.getBlock(pos), blockSnowBlock()), "the eighth layer is a snow block")
  # Another item does nothing.
  props.layers = 2'u8
  t.put(pos, props.toStateId(blockSnow()))
  let other = ItemStackRef(stack: newItemStack(1'u8, ITEM_STICK))
  check(b.useWithItem(UseWithItemArgs(world: t.world, block0: blockSnow(), position: pos, player: BlockPlayer(), hit: hit, itemStack: other)) == barPass, "a stick passes")

proc cobwebSlowsMore() =
  let t = newTestWorld(newRegistry())
  var applied: seq[Vector3[float64]] = @[]
  var weaving = false
  let actor = BlockActor(isLiving: true)
  actor.slowMovement0 = proc(m: Vector3[float64]) {.closure.} = applied.add(m)
  actor.hasEffect0 = proc(effect: string): bool {.closure.} = weaving and effect == "weaving"
  let b = t.world.blockRegistry.getPumpkinBlock(blockCobweb().id).unsafeGet
  b.onEntityCollision(OnEntityCollisionArgs(world: t.world, block0: blockCobweb(), state: blockCobweb().defaultState, position: at(0, 64, 0), entity: actor))
  weaving = true
  b.onEntityCollision(OnEntityCollisionArgs(world: t.world, block0: blockCobweb(), state: blockCobweb().defaultState, position: at(0, 64, 0), entity: actor))
  check(applied.len == 2, "two collisions")
  check(applied[0].x == 0.25 and applied[0].y == 0.05 and applied[0].z == 0.25, "cobweb slows to (0.25, 0.05, 0.25)")
  check(applied[1].x == 0.5 and applied[1].y == 0.25 and applied[1].z == 0.5, "weaving eases it to (0.5, 0.25, 0.5)")

proc tntPrimes() =
  let t = newTestWorld(newRegistry())
  let pos = at(3, 64, 4)
  t.put(pos, blockTnt())
  var spawned: seq[string] = @[]
  var where: seq[Vector3[float64]] = @[]
  t.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    spawned.add(entityType)
    where.add(position)
    BlockActor()
  let b = t.world.blockRegistry.getPumpkinBlock(blockTnt().id).unsafeGet
  let steel = ItemStackRef(stack: newItemStack(1'u8, ITEM_FLINT_AND_STEEL))
  check(b.useWithItem(UseWithItemArgs(world: t.world, block0: blockTnt(), position: pos, player: BlockPlayer(), itemStack: steel)) == barConsume,
    "flint and steel lights tnt")
  check(spawned == @["tnt"], "one primed tnt")
  check(where[0].x == 3.5 and where[0].y == 64.0 and where[0].z == 4.5, "at the block (to_f64 centres x and z)")
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "the block is gone")
  check(t.events.len == 1 and t.events[0].startsWith("sound "), "with the fuse sound")
  # Anything else passes, and so does a fire charge by upstream's own condition.
  t.put(pos, blockTnt())
  let stick = ItemStackRef(stack: newItemStack(1'u8, ITEM_STICK))
  check(b.useWithItem(UseWithItemArgs(world: t.world, block0: blockTnt(), position: pos, player: BlockPlayer(), itemStack: stick)) == barPass,
    "a stick does not")
  check(spawned.len == 1, "and primes nothing")

type FedLog = ref object
  log: seq[(int32, float32)]

proc hungryPlayer(level: int32; fed: FedLog): BlockPlayer =
  let p = BlockPlayer()
  p.gamemode0 = proc(): GameMode {.closure.} = GameMode.Survival
  p.hungerLevel0 = proc(): int32 {.closure.} = level
  p.addHunger0 = proc(food: int32; saturation: float32) {.closure.} = fed.log.add((food, saturation))
  p.incrementStat0 = proc(stat: string; amount: int32) {.closure.} = discard
  p

proc cakeIsEaten() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  t.put(at(0, 63, 0), blockStone())
  t.put(pos, blockCake())
  let fed = FedLog(log: @[])
  let p = hungryPlayer(10'i32, fed)
  let b = t.world.blockRegistry.getPumpkinBlock(blockCake().id).unsafeGet
  for bite in 1'u8 .. 6'u8:
    check(b.normalUse(NormalUseArgs(world: t.world, block0: blockCake(), position: pos, player: p)) == barConsume, "a slice is eaten")
    check(CakeLikeProperties.fromStateId(t.world.getBlockStateId(pos), blockCake()).bites == bite, "bites " & $bite)
  check(fed.log.len == 6 and fed.log[0][0] == 2'i32 and fed.log[0][1] == 0.4'f32, "each slice feeds 2 points")
  check(b.normalUse(NormalUseArgs(world: t.world, block0: blockCake(), position: pos, player: p)) == barConsume, "the last slice")
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "leaves nothing")
  # A full stomach refuses.
  t.put(pos, blockCake())
  let fed2 = FedLog(log: @[])
  let full = hungryPlayer(20'i32, fed2)
  check(b.normalUse(NormalUseArgs(world: t.world, block0: blockCake(), position: pos, player: full)) == barPass, "not hungry")
  check(fed2.log.len == 0 and sameBlock(t.world.getBlock(pos), blockCake()), "so the cake is untouched")
  # The comparator reads (7 - bites) * 2.
  var props = CakeLikeProperties.defaultFor(blockCake())
  props.bites = 2'u8
  t.put(pos, props.toStateId(blockCake()))
  let out0 = b.getComparatorOutput(GetComparatorOutputArgs(world: t.world, block0: blockCake(), position: pos))
  check(out0.isSome and out0.unsafeGet == 10'u8, "two bites read 10")

proc candleCakeMap() =
  check(sameBlock(cakeFromCandle(ITEM_RED_CANDLE), blockRedCandleCake()), "a red candle makes a red candle cake")
  check(sameBlock(cakeFromCandle(ITEM_CANDLE), blockCandleCake()), "the plain one the plain cake")
  check(candleFromCake(blockBlackCandleCake()).id == ITEM_BLACK_CANDLE.id, "and back")

proc withLevel(t: TestWorld): TestWorld =
  t.world.levelInfo0 = proc(): LevelData {.closure.} = defaultLevelData(0'u64)
  t

proc fireNeedsSupportAndFuel() =
  let t = newTestWorld(newRegistry()).withLevel()
  let pos = at(0, 64, 0)
  # Over nothing: the first tick puts it out.
  discard t.world.setBlockState(pos, blockFire().defaultState.id, BfNotifyAll)
  check(t.world.isBlockTickScheduled(pos, blockFire()), "fire schedules a tick when it is placed")
  t.run(40)
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "fire over air dies at its first tick")
  # On stone with nothing to burn, a young fire stays and keeps ticking.
  let t2 = newTestWorld(newRegistry()).withLevel()
  t2.put(at(0, 63, 0), blockStone())
  discard t2.world.setBlockState(pos, blockFire().defaultState.id, BfNotifyAll)
  check(t2.world.isBlockTickScheduled(pos, blockFire()), "placing fire schedules its tick")
  t2.run(40)
  check(sameBlock(t2.world.getBlock(pos), blockFire()) or t2.world.getBlockStateId(pos) == blockStateIdAir, "fire on stone is fire or out")
  # Age above 3 with no fuel and a non-flammable base: out at the next tick.
  let t3 = newTestWorld(newRegistry()).withLevel()
  t3.put(at(0, 63, 0), blockStone())
  var old = FireLikeProperties.defaultFor(blockFire())
  old.age = 5'u8
  t3.put(pos, old.toStateId(blockFire()))
  t3.world.scheduleBlockTick(blockFire(), pos, 1'u8, tpNormal)
  t3.run(2)
  check(t3.world.getBlockStateId(pos) == blockStateIdAir, "an old fire with no fuel goes out")
  # canPlaceAt through the module: stone below is enough, air below with no flammable neighbour is not.
  check(firemod.canPlaceAt(t3.world, at(5, 64, 5)) == false, "no fire in mid air")
  t3.put(at(5, 63, 5), blockStone())
  check(firemod.canPlaceAt(t3.world, at(5, 64, 5)), "fire can be set on stone")
  t3.put(at(5, 63, 5), blockWater())
  check(not canPlaceOn(blockWater()) and canPlaceOn(blockStone()), "fire cannot be placed on water or lava")

proc magmaBurnsFeet() =
  let t = newTestWorld(newRegistry())
  var hurt: seq[string] = @[]
  var sneaking = false
  var immune = false
  var resistant = false
  let actor = BlockActor(isLiving: true)
  actor.sneaking0 = proc(): bool {.closure.} = sneaking
  actor.fireImmune0 = proc(): bool {.closure.} = immune
  actor.hasEffect0 = proc(effect: string): bool {.closure.} = resistant and effect == "fire_resistance"
  actor.damage0 = proc(amount: float32; damageType: string): bool {.closure.} =
    hurt.add(damageType & " " & $amount)
    true
  let b = t.world.blockRegistry.getPumpkinBlock(blockMagmaBlock().id).unsafeGet
  let args = OnEntityStepArgs(world: t.world, block0: blockMagmaBlock(), state: blockMagmaBlock().defaultState, position: at(0, 64, 0), entity: actor)
  b.onEntityStep(args)
  check(hurt == @["hot_floor 1.0"], "standing on magma deals 1 hot floor damage")
  sneaking = true
  b.onEntityStep(args)
  check(hurt.len == 1, "sneaking is safe")
  sneaking = false
  immune = true
  b.onEntityStep(args)
  check(hurt.len == 1, "fire immunity is safe")
  immune = false
  resistant = true
  b.onEntityStep(args)
  check(hurt.len == 1, "fire resistance is safe")

proc powderSnowCollision() =
  let falling = BlockActor(isLiving: true)
  falling.fallDistance0 = proc(): float32 {.closure.} = 3.0'f32
  let shape = collisionShapeForEntity(falling, at(0, 64, 0))
  check(shape.isSome and shape.unsafeGet.max.y == 0.9, "a falling entity sinks: the 0.9 high shape")
  let walker = BlockActor(isLiving: true, entityTypeName: "rabbit")
  walker.canWalkOnPowderSnow0 = proc(): bool {.closure.} = true
  walker.getBox0 = proc(): BoundingBox = BoundingBox.newArray([0.0, 65.0, 0.0], [1.0, 66.0, 1.0])
  walker.getVelocity0 = proc(): Vector3[float64] {.closure.} = vec3[float64](0.0, 0.0, 0.0)
  check(collisionShapeForEntity(walker, at(0, 64, 0)).isSome, "a rabbit above the block walks on it")
  walker.getVelocity0 = proc(): Vector3[float64] {.closure.} = vec3[float64](0.0, -0.1, 0.0)
  check(collisionShapeForEntity(walker, at(0, 64, 0)).isNone, "but not while going down")

proc lavaMeetsWater() =
  let t = newTestWorld(newRegistry())
  let pos = at(0, 64, 0)
  t.put(pos, blockLava())
  t.put(at(1, 64, 0), blockWater())
  check(not receiveNeighborFluids(t.world, Fluid.LAVA, pos), "lava touching water reports it is no longer lava")
  check(sameBlock(t.world.getBlock(pos), blockObsidian()), "a lava source turns to obsidian")
  check(t.events == @["event " & $ord(weLavaFizz)], "with the fizz")
  # Flowing lava (not the source state) becomes cobblestone.
  let t2 = newTestWorld(newRegistry())
  t2.put(pos, blockLava().states[1].id)
  t2.put(at(0, 64, 1), blockWater())
  check(not receiveNeighborFluids(t2.world, Fluid.FLOWING_LAVA, pos), "flowing lava touching water")
  check(sameBlock(t2.world.getBlock(pos), blockCobblestone()), "turns to cobblestone")
  # Water only below it still lets lava spread.
  let t3 = newTestWorld(newRegistry())
  t3.put(pos, blockLava())
  t3.put(at(0, 63, 0), blockWater())
  check(receiveNeighborFluids(t3.world, Fluid.LAVA, pos), "water below does not stop it (it flows in)")
  # Blue ice beside lava over soul soil makes basalt.
  let t4 = newTestWorld(newRegistry())
  t4.put(pos, blockLava())
  t4.put(at(0, 63, 0), blockSoulSoil())
  t4.put(at(1, 64, 0), blockBlueIce())
  check(not receiveNeighborFluids(t4.world, Fluid.LAVA, pos), "lava, soul soil and blue ice")
  check(sameBlock(t4.world.getBlock(pos), blockBasalt()), "make basalt")

