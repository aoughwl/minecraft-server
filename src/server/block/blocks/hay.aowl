## Port of pumpkin/src/block/blocks/hay.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  HayBlock* = object



proc hayBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs)
proc newHayBlock*(): BlockBehaviour

proc hayBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs) =
  let t1 = args.entity.getLivingEntity()
  if t1.isSome:
    let living = t1.unsafeGet
    t1.unsafeGet.handleFallDamage(args.entity, args.fallDistance, 0.2'f32)

proc newHayBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onLandedUponImpl = hayBlockOnLandedUpon_BlockBehaviour

proc registerBlocksHay*(r: BlockRegistry) =
  r.register("minecraft:hay_block", newHayBlock())

