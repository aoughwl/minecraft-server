import ../blockprelude
import redstone/redstonemod
import ../entities/hopper


type
  HopperBlockScreenFactory* = R2A_MANUAL_tuple_struct
  HopperBlock* = object



proc createScreenHandler*(self: HopperBlockScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: HopperBlockScreenFactory): TextComponent
proc hopperBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc hopperBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc hopperBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc hopperBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc hopperBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8]
proc newHopperBlock*(): BlockBehaviour
proc checkPoweredState*(world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block)

proc createScreenHandler*(self: HopperBlockScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let concreteHandler = createHopper(syncId, playerInventory, self[0])
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: HopperBlockScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_HOPPER, CONTAINER_HOPPER, [])

proc hopperBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        args.player.incrementStat(scCustom, int32(csInspectHopper), 1)
        args.player.openHandledScreen(HopperBlockScreenFactory(t2.unsafeGet), some(args.position))
  barSuccess

proc hopperBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = HopperLikeProperties.defaultFor(args.block0)
  let t4 = block:
    case args.direction
    of BlockDirection.North:
      FacingHopper.North
    of BlockDirection.East:
      FacingHopper.East
    of BlockDirection.South:
      FacingHopper.South
    of BlockDirection.West:
      FacingHopper.West
    of BlockDirection.Up, BlockDirection.Down:
      FacingHopper.Down
  props.facing = t4
  props.enabled = true
  props.toStateId(args.block0)

proc hopperBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let props = HopperLikeProperties.fromStateId(args.stateId, args.block0)
  let hopperBlockEntity = newHopperBlockEntity(args.position, props.facing)
  args.world.addBlockEntity(hopperBlockEntity)
  if (Block.fromStateId(args.oldStateId) != Block.fromStateId(args.stateId)):
    checkPoweredState(args.world, args.position, args.stateId, args.block0)

proc hopperBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  checkPoweredState(args.world, args.position, args.world.getBlockStateId(args.position), args.block0)

proc hopperBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain7:
    let t5 = args.world.getBlockEntity(args.position)
    if t5.isSome:
      let blockEntity = t5.unsafeGet
      let t6 = t5.unsafeGet.getInventory()
      if t6.isSome:
        let inventory = t6.unsafeGet
        some(calculateComparatorOutput(t6.unsafeGet))
        break chain7
    none[uint8]()

proc newHopperBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = hopperBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = hopperBlockOnPlace_BlockBehaviour
  result.placedImpl = hopperBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = hopperBlockOnNeighborUpdate_BlockBehaviour
  result.getComparatorOutputImpl = hopperBlockGetComparatorOutput_BlockBehaviour

proc checkPoweredState*(world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block) =
  let signal = (not blockReceivesRedstonePower(world, pos))
  var state = HopperLikeProperties.fromStateId(stateId, blockRef)
  if (signal != state.enabled):
    state.enabled = signal
    discard world.setBlockState(pos, state.toStateId(blockRef), BfNotifyListeners)

proc registerBlocksHopper*(r: BlockRegistry) =
  r.register("minecraft:hopper", newHopperBlock())

