## Port of pumpkin/src/block/blocks/infested.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  InfestedBlock* = object



proc infestedBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # TODO: ugly fix, use onStacksDropped
  if (args.player.gamemode() == GameMode.Creative):
    return
  discard args.world.spawnEntity("silverfish", args.position.vec.toF64())

proc newInfestedBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.brokenImpl = infestedBlockBroken_BlockBehaviour

proc registerBlocksInfested*(r: BlockRegistry) =
  r.registerTag("c:cobblestones/infested", newInfestedBlock())

