import ../blockprelude


type
  IronBarsProperties = OakFenceLikeProperties
  IronBarsBlock* = object



proc ironBarsBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc ironBarsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newIronBarsBlock*(): BlockBehaviour
proc computeBarsState*(barsProps: IronBarsProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId

proc ironBarsBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var barsProps = IronBarsProperties.defaultFor(args.block0)
  barsProps.waterlogged = args.replacing.waterSource()
  computeBarsState(barsProps, args.world, args.block0, args.position)

proc ironBarsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let barsProps = IronBarsProperties.fromStateId(args.stateId, args.block0)
  computeBarsState(barsProps, args.world, args.block0, args.position)

proc newIronBarsBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = ironBarsBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = ironBarsBlockGetStateForNeighborUpdate_BlockBehaviour

proc computeBarsState*(barsProps: IronBarsProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId =
  var barsProps = barsProps
  let t1 = blockDirectionHorizontal()
  for direction in t1:
    let otherBlockPos = blockPos.offset(direction.toOffset())
    let (otherBlock, otherBlockState) = world.getBlockAndState(otherBlockPos)
    let connected = ((((otherBlock == blockRef) or otherBlockState.isSideSolid(direction.opposite().toBlockDirection())) or otherBlock.hasTag(Block_C_GLASS_PANES)) or otherBlock.hasTag(Block_MINECRAFT_WALLS))
    case direction
    of HorizontalFacing.North:
      barsProps.north = connected
    of HorizontalFacing.South:
      barsProps.south = connected
    of HorizontalFacing.West:
      barsProps.west = connected
    of HorizontalFacing.East:
      barsProps.east = connected
  barsProps.toStateId(blockRef)

proc registerBlocksIronBars*(r: BlockRegistry) =
  r.register("minecraft:iron_bars", newIronBarsBlock())

