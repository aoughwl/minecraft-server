proc fromFrontTop*(front: BlockDirection, top: BlockDirection): Orientation =
  let t1 = (front, top)
  if t1[0] == BlockDirection.Down and t1[1] == BlockDirection.East:
    Orientation.DownEast
  elif t1[0] == BlockDirection.Down and t1[1] == BlockDirection.North:
    Orientation.DownNorth
  elif t1[0] == BlockDirection.Down and t1[1] == BlockDirection.South:
    Orientation.DownSouth
  elif t1[0] == BlockDirection.Down and t1[1] == BlockDirection.West:
    Orientation.DownWest
  elif t1[0] == BlockDirection.Up and t1[1] == BlockDirection.East:
    Orientation.UpEast
  elif t1[0] == BlockDirection.Up and t1[1] == BlockDirection.North:
    Orientation.UpNorth
  elif t1[0] == BlockDirection.Up and t1[1] == BlockDirection.South:
    Orientation.UpSouth
  elif t1[0] == BlockDirection.Up and t1[1] == BlockDirection.West:
    Orientation.UpWest
  elif t1[0] == BlockDirection.West and t1[1] == BlockDirection.Up:
    Orientation.WestUp
  elif t1[0] == BlockDirection.East and t1[1] == BlockDirection.Up:
    Orientation.EastUp
  elif t1[0] == BlockDirection.South and t1[1] == BlockDirection.Up:
    Orientation.SouthUp
  else:
    Orientation.NorthUp

proc toFrontTop*(orientation: Orientation): (BlockDirection, BlockDirection) =
  case orientation
  of Orientation.DownEast:
    (BlockDirection.Down, BlockDirection.East)
  of Orientation.DownNorth:
    (BlockDirection.Down, BlockDirection.North)
  of Orientation.DownSouth:
    (BlockDirection.Down, BlockDirection.South)
  of Orientation.DownWest:
    (BlockDirection.Down, BlockDirection.West)
  of Orientation.UpEast:
    (BlockDirection.Up, BlockDirection.East)
  of Orientation.UpNorth:
    (BlockDirection.Up, BlockDirection.North)
  of Orientation.UpSouth:
    (BlockDirection.Up, BlockDirection.South)
  of Orientation.UpWest:
    (BlockDirection.Up, BlockDirection.West)
  of Orientation.WestUp:
    (BlockDirection.West, BlockDirection.Up)
  of Orientation.EastUp:
    (BlockDirection.East, BlockDirection.Up)
  of Orientation.NorthUp:
    (BlockDirection.North, BlockDirection.Up)
  of Orientation.SouthUp:
    (BlockDirection.South, BlockDirection.Up)

proc jigsawBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = JigsawLikeProperties.defaultFor(args.block0)
  let facing = args.player.getEntity().getFacing()
  let front = facingToDir(facing).opposite()
  let t2 = block:
    if ((facing == Facing.Up) or (facing == Facing.Down)):
      horizontalFacingToDir(args.player.getEntity().getHorizontalFacing()).opposite()
    else:
      BlockDirection.Up
  let top = t2
  props.orientation = fromFrontTop(front, top)
  props.toStateId(args.block0)

proc jigsawBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  if (args.player.permissionLvl < PermissionLvl.Two):
    return barPass
  if (not (args.player.gamemode == GameMode.Creative)):
    return barPass
  let t3 = args.world.getBlockEntity(args.position)
  if not (t3.isSome):
    return barPass
  let blockEntity = t3.unsafeGet
  args.world.updateBlockEntity(blockEntity)
  barSuccessServer

proc jigsawBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newJigsawBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc jigsawBlockMirror_BlockBehaviour(blockRef: Block, stateId: BlockStateId, mirror: Mirror): BlockState =
  if (mirror == Mirror.None):
    return BlockState.fromId(stateId)
  var props = JigsawLikeProperties.fromStateId(stateId, blockRef)
  let (front, top) = toFrontTop(props.orientation)
  let newFront = mirrorDirection(front, mirror)
  let newTop = mirrorDirection(top, mirror)
  props.orientation = fromFrontTop(newFront, newTop)
  BlockState.fromId(props.toStateId(blockRef))

proc jigsawBlockRotate_BlockBehaviour(blockRef: Block, stateId: BlockStateId, rotation: Rotation): BlockState =
  if (rotation == Rotation.None):
    return BlockState.fromId(stateId)
  var props = JigsawLikeProperties.fromStateId(stateId, blockRef)
  let (front, top) = toFrontTop(props.orientation)
  let newFront = rotateDirection(front, rotation)
  let newTop = rotateDirection(top, rotation)
  props.orientation = fromFrontTop(newFront, newTop)
  BlockState.fromId(props.toStateId(blockRef))

proc newJigsawBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = jigsawBlockOnPlace_BlockBehaviour
  result.normalUseImpl = jigsawBlockNormalUse_BlockBehaviour
  result.placedImpl = jigsawBlockPlaced_BlockBehaviour
  result.mirrorImpl = jigsawBlockMirror_BlockBehaviour
  result.rotateImpl = jigsawBlockRotate_BlockBehaviour

proc facingToDir*(facing: Facing): BlockDirection =
  case facing
  of Facing.North:
    BlockDirection.North
  of Facing.East:
    BlockDirection.East
  of Facing.South:
    BlockDirection.South
  of Facing.West:
    BlockDirection.West
  of Facing.Up:
    BlockDirection.Up
  of Facing.Down:
    BlockDirection.Down

proc horizontalFacingToDir*(facing: HorizontalFacing): BlockDirection =
  case facing
  of HorizontalFacing.North:
    BlockDirection.North
  of HorizontalFacing.South:
    BlockDirection.South
  of HorizontalFacing.West:
    BlockDirection.West
  of HorizontalFacing.East:
    BlockDirection.East

proc rotateDirection*(dir: BlockDirection, rotation: Rotation): BlockDirection =
  if ((dir == BlockDirection.Up) or (dir == BlockDirection.Down)):
    return dir
  if rotation == Rotation.None:
    dir
  elif rotation == Rotation.Clockwise90:
    case dir
    of BlockDirection.North:
      BlockDirection.East
    of BlockDirection.East:
      BlockDirection.South
    of BlockDirection.South:
      BlockDirection.West
    of BlockDirection.West:
      BlockDirection.North
    else:
      dir
  elif rotation == Rotation.Rotate180:
    case dir
    of BlockDirection.North:
      BlockDirection.South
    of BlockDirection.South:
      BlockDirection.North
    of BlockDirection.East:
      BlockDirection.West
    of BlockDirection.West:
      BlockDirection.East
    else:
      dir
  elif rotation == Rotation.CounterClockwise90:
    case dir
    of BlockDirection.North:
      BlockDirection.West
    of BlockDirection.West:
      BlockDirection.South
    of BlockDirection.South:
      BlockDirection.East
    of BlockDirection.East:
      BlockDirection.North
    else:
      dir
  else:
    rustPanic("non-exhaustive")

proc mirrorDirection*(dir: BlockDirection, mirror: Mirror): BlockDirection =
  if mirror == Mirror.None:
    dir
  elif mirror == Mirror.LeftRight:
    case dir
    of BlockDirection.East:
      BlockDirection.West
    of BlockDirection.West:
      BlockDirection.East
    else:
      dir
  elif mirror == Mirror.FrontBack:
    case dir
    of BlockDirection.North:
      BlockDirection.South
    of BlockDirection.South:
      BlockDirection.North
    else:
      dir
  else:
    rustPanic("non-exhaustive")

proc registerBlocksJigsaw*(r: BlockRegistry) =
  r.register("minecraft:jigsaw", newJigsawBlock())

