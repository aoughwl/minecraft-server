## jigsaw.rs and entities/jigsaw_block.rs (without `generate`) and entities/decorated_pot.rs over a `TestWorld`: the orientation from
## the player's look, rotate and mirror, the operator-only edit, and what each entity saves and reads back.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude
import ../testworld
import ../entities/[entitiesmod, jigsaw_block, decorated_pot, structure_block, command_block]
import jigsaw

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksJigsaw(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc looking(yaw, pitch: float32; op = true; creative = true): BlockPlayer =
  let p = BlockPlayer()
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p.pitch0 = proc(): float32 {.closure.} = pitch
  p.sneaking0 = proc(): bool {.closure.} = false
  p.isOp0 = proc(): bool {.closure.} = op
  p.gamemode0 = proc(): GameMode {.closure.} = (if creative: GameMode.Creative else: GameMode.Survival)
  p

proc place(t: TestWorld; p: BlockPlayer): Orientation =
  let id = t.world.blockRegistry.onPlace(BlockServer(), t.world, p, blockJigsaw(), blockPos(0'i32, 64'i32, 0'i32), BlockDirection.Up,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())
  JigsawLikeProperties.fromStateId(id, blockJigsaw()).orientation

proc orientation() =
  let t = newTestWorld(newRegistry())
  # Yaw 180 looks north: the front is south, the top is up.
  check(t.place(looking(180.0'f32, 0.0'f32)) == Orientation.SouthUp, "looking north gives south_up")
  check(t.place(looking(0.0'f32, 0.0'f32)) == Orientation.NorthUp, "looking south gives north_up")
  check(t.place(looking(90.0'f32, 0.0'f32)) == Orientation.EastUp, "looking west gives east_up")
  check(t.place(looking(270.0'f32, 0.0'f32)) == Orientation.WestUp, "looking east gives west_up")
  # Looking straight down: the front is up and the top is the opposite of the horizontal facing.
  check(t.place(looking(0.0'f32, 90.0'f32)) == Orientation.UpNorth, "looking down from the north gives up_north")
  check(t.place(looking(0.0'f32, -90.0'f32)) == Orientation.DownNorth, "looking up gives down_north")
  check(fromFrontTop(BlockDirection.Down, BlockDirection.West) == Orientation.DownWest, "from_front_top")
  check(fromFrontTop(BlockDirection.North, BlockDirection.Down) == Orientation.NorthUp, "an impossible pair falls to north_up")
  for o in [Orientation.DownEast, Orientation.UpWest, Orientation.EastUp, Orientation.SouthUp]:
    let ft = toFrontTop(o)
    check(fromFrontTop(ft[0], ft[1]) == o, "to_front_top and from_front_top agree")

proc rotateAndMirror() =
  let t = newTestWorld(newRegistry())
  let reg = t.world.blockRegistry
  var props = JigsawLikeProperties.defaultFor(blockJigsaw())
  props.orientation = Orientation.SouthUp
  let south = props.toStateId(blockJigsaw())
  let r90 = reg.rotateState(blockJigsaw(), south, Rotation.Clockwise90)
  check(JigsawLikeProperties.fromStateId(r90.id, blockJigsaw()).orientation == Orientation.WestUp, "south_up clockwise is west_up")
  let r180 = reg.rotateState(blockJigsaw(), south, Rotation.Rotate180)
  check(JigsawLikeProperties.fromStateId(r180.id, blockJigsaw()).orientation == Orientation.NorthUp, "south_up turned round is north_up")
  let r270 = reg.rotateState(blockJigsaw(), south, Rotation.CounterClockwise90)
  check(JigsawLikeProperties.fromStateId(r270.id, blockJigsaw()).orientation == Orientation.EastUp, "south_up counter-clockwise is east_up")
  check(reg.rotateState(blockJigsaw(), south, Rotation.None).id == south, "no rotation")
  props.orientation = Orientation.UpNorth
  let up = props.toStateId(blockJigsaw())
  let upTurned = reg.rotateState(blockJigsaw(), up, Rotation.Clockwise90)
  check(JigsawLikeProperties.fromStateId(upTurned.id, blockJigsaw()).orientation == Orientation.UpEast, "up_north clockwise is up_east")
  props.orientation = Orientation.EastUp
  let east = props.toStateId(blockJigsaw())
  let mirrored = reg.mirrorState(blockJigsaw(), east, Mirror.LeftRight)
  check(JigsawLikeProperties.fromStateId(mirrored.id, blockJigsaw()).orientation == Orientation.WestUp, "east_up mirrored left-right")
  let front = reg.mirrorState(blockJigsaw(), east, Mirror.FrontBack)
  check(JigsawLikeProperties.fromStateId(front.id, blockJigsaw()).orientation == Orientation.EastUp, "east_up front-back is unchanged")
  props.orientation = Orientation.NorthUp
  let north = props.toStateId(blockJigsaw())
  let flipped = reg.mirrorState(blockJigsaw(), north, Mirror.FrontBack)
  check(JigsawLikeProperties.fromStateId(flipped.id, blockJigsaw()).orientation == Orientation.SouthUp, "north_up front-back")

proc editing() =
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  discard t.world.setBlockState(pos, blockJigsaw().defaultState.id, BfNotifyAll)
  check(t.world.getBlockEntity(pos).isSome, "placing adds the entity")
  let hit = BlockHitResult(face: BlockDirection.Up, cursorPos: Vector3[float32](x: 0.5, y: 0.5, z: 0.5))
  let reg = t.world.blockRegistry
  check(reg.onUse(blockJigsaw(), looking(0.0'f32, 0.0'f32, op = false), pos, hit, BlockServer(), t.world) == barPass, "not an operator")
  check(reg.onUse(blockJigsaw(), looking(0.0'f32, 0.0'f32, creative = false), pos, hit, BlockServer(), t.world) == barPass, "not in creative")
  var sent = 0
  t.world.updateBlockEntity0 = proc(entity: BlockEntity) {.closure.} = sent += 1
  check(reg.onUse(blockJigsaw(), looking(0.0'f32, 0.0'f32), pos, hit, BlockServer(), t.world) == barSuccessServer, "an operator in creative")
  check(sent == 1, "the block entity is sent so the client can edit it")

proc entities() =
  let pos = blockPos(3'i32, 70'i32, 4'i32)
  let e = newJigsawBlockEntity(pos)
  check(e.name == "minecraft:empty" and e.finalState == "minecraft:air" and e.joint == JigsawJointType.Rollable, "defaults")
  e.name = "minecraft:a"
  e.target = "minecraft:b"
  e.pool = "minecraft:village/plains/houses"
  e.finalState = "minecraft:stone"
  e.joint = JigsawJointType.Aligned
  e.selectionPriority = 3'i32
  e.placementPriority = 7'i32
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.getString("joint").get("") == "aligned" and nbt.getInt("placement_priority").get(0'i32) == 7'i32, "saved")
  var again = nbt
  let loaded = jigsawBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.name == "minecraft:a" and loaded.target == "minecraft:b" and loaded.pool == "minecraft:village/plains/houses", "names back")
  check(loaded.finalState == "minecraft:stone" and loaded.joint == JigsawJointType.Aligned, "state and joint back")
  check(loaded.selectionPriority == 3'i32 and loaded.placementPriority == 7'i32, "priorities back")
  check(BlockEntity(e).chunkDataNbt().unsafeGet.getString("pool").get("") == "minecraft:village/plains/houses", "chunk data")
  check(BlockEntity(e).resourceLocation() == "minecraft:jigsaw", "resource location")
  var bare = newCompound()
  check(jigsawBlockEntityFromNbt_BlockEntity(bare, pos).pool == "minecraft:empty", "an empty compound gives the defaults")

proc decoratedPot() =
  let pos = blockPos(1'i32, 65'i32, 1'i32)
  let pot = newDecoratedPotBlockEntity(pos)
  var empty = newCompound()
  BlockEntity(pot).writeNbt(empty)
  check(empty.isEmpty(), "an empty pot saves nothing")
  check(BlockEntity(pot).resourceLocation() == "minecraft:decorated_pot", "resource location")
  pot.sherds = some(@[NbtTag(kind: ntkString, stringVal: "minecraft:brick"), NbtTag(kind: ntkString, stringVal: "minecraft:brick")])
  let stone = Item.fromRegistryKey("stone")
  if stone == nil:
    echo "FAILED stone exists"
    quit(1)
  pot.item = some(newItemStack(5'u8, stone))
  var nbt = newCompound()
  BlockEntity(pot).writeNbt(nbt)
  check(nbt.getList("sherds").unsafeGet.len == 2, "sherds saved")
  check(nbt.getCompound("item").isSome, "item saved")
  var again = nbt
  let loaded = decoratedPotBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.sherds.isSome and loaded.sherds.unsafeGet.len == 2, "sherds back")
  check(loaded.item.isSome and loaded.item.unsafeGet.itemCount == 5'u8 and loaded.item.unsafeGet.item.registryKey == "stone", "item back")
  check(BlockEntity(pot).chunkDataNbt().unsafeGet.has("item"), "chunk data carries the item too")

proc structureAndCommandEntities() =
  let pos = blockPos(9'i32, 70'i32, 9'i32)
  let sb = newStructureBlockBlockEntity(pos)
  check(sb.rotation == "NONE" and sb.mode == "DATA" and sb.ignoreEntities and sb.showBoundingBox and not sb.showAir and sb.integrity == 1.0'f32,
    "structure block defaults")
  sb.name = "mine:house"
  sb.sizeX = 5'i32
  sb.sizeY = 6'i32
  sb.sizeZ = 7'i32
  sb.posX = -1'i32
  sb.mode = "SAVE"
  sb.seed = 123456789012'i64
  sb.integrity = 0.5'f32
  var nbt = newCompound()
  BlockEntity(sb).writeNbt(nbt)
  check(nbt.getInt("sizeZ").get(0'i32) == 7'i32 and nbt.getLong("seed").get(0'i64) == 123456789012'i64, "structure block saved")
  var again = nbt
  let loaded = structureBlockBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.name == "mine:house" and loaded.mode == "SAVE" and loaded.posX == -1'i32 and loaded.integrity == 0.5'f32, "structure block back")
  check(BlockEntity(sb).resourceLocation() == "minecraft:structure_block", "resource location")
  var bare = newCompound()
  check(structureBlockBlockEntityFromNbt_BlockEntity(bare, pos).showBoundingBox, "defaults when missing")
  let cb = newCommandBlockEntity(pos, true, false)
  check(not cb.auto and cb.trackOutput and cb.command == "" and cb.successCount == 0'u32, "command block defaults")
  check(newCommandBlockEntity(pos, true, true).auto, "a chain command block is automatic")
  cb.command = "say hi"
  cb.powered = true
  cb.successCount = 3'u32
  var cnbt = newCompound()
  BlockEntity(cb).writeNbt(cnbt)
  check(cnbt.getString("Command").get("") == "say hi" and cnbt.getInt("SuccessCount").get(0'i32) == 3'i32, "command block saved")
  check(not cnbt.getBool("UpdateLastExecution").get(true), "UpdateLastExecution is false")
  var cagain = cnbt
  let cl = commandBlockEntityFromNbt_BlockEntity(cagain, pos)
  check(cl.command == "say hi" and cl.powered and cl.successCount == 3'u32 and cl.trackOutput, "command block back")
  check(BlockEntity(cb).resourceLocation() == "minecraft:command_block", "resource location")
  var made = 0
  for i in 0 ..< BLOCK_ENTITY_TYPES.len:
    let k = BLOCK_ENTITY_TYPES[i]
    if k == "jigsaw" or k == "decorated_pot" or k == "structure_block" or k == "command_block":
      if createBlockEntity(uint16(i), pos).isSome:
        made += 1
  check(made == 4, "create_block_entity makes all four")

orientation()
rotateAndMirror()
editing()
entities()
decoratedPot()
structureAndCommandEntities()
echo "jigsaw ok"
