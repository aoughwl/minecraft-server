## Port of pumpkin/src/block/blocks/jukebox.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/strutils
import ../blockprelude
import ../../../generated/jukebox_song as jsong
import ../entities/jukebox

proc hasRecordState*(blockRef: Block, stateId: BlockStateId): bool =
  JukeboxLikeProperties.fromStateId(stateId, blockRef).hasRecord

proc setRecordState*(hasRecord: bool, blockRef: Block, position: BlockPos, world: BlockWorld) =
  let newState = JukeboxLikeProperties(hasRecord: hasRecord)
  discard world.setBlockState(position, newState.toStateId(blockRef), BfNotifyListeners)

proc dropRecord*(position: BlockPos, world: BlockWorld) =
  ## Drops the record from the jukebox - matches vanilla's `JukeboxBlockEntity.dropRecord()`.
  ## Spawns the item at (pos + 0.5, pos + 1.01, pos + 0.5) with horizontal random offset.
  let t1 = world.getBlockEntity(position)
  if t1.isSome:
    let jukebox = t1.unsafeGet.asType(JukeboxBlockEntity)
    if jukebox.isSome:
      let record = jukebox.unsafeGet.clearRecord()
      if not record.isEmpty():
        # Vanilla: Vec3d.add(pos, 0.5, 1.01, 0.5).addHorizontalRandom(random, 0.7F)
        # addHorizontalRandom adds random in range [-0.35, 0.35] to x and z
        let spawnPos = Vector3[float64](x: (float64(position.vec.x) + 0.5) + randomRange(-0.35 .. 0.35),
          y: float64(position.vec.y) + 1.01, z: (float64(position.vec.z) + 0.5) + randomRange(-0.35 .. 0.35))
        # Vanilla: setToDefaultPickupDelay() = 10 ticks
        world.spawnItem(spawnPos, record)

proc stopPlaying*(blockRef: Block, position: BlockPos, world: BlockWorld) =
  ## Stops the music and updates block state
  setRecordState(false, blockRef, position, world)
  world.syncWorldEvent(weSoundStopJukeboxSong, position, 0'i32)

proc startPlaying*(position: BlockPos, world: BlockWorld, songId: uint32) =
  world.syncWorldEvent(weSoundPlayJukeboxSong, position, int32(songId))

proc jukeboxBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blockEntity = newJukeboxBlockEntity(args.position)
  args.world.addBlockEntity(blockEntity)

proc jukeboxBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockState(args.position).id
  # Vanilla: if (state.get(HAS_RECORD) && world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv)
  if hasRecordState(args.block0, stateId):
    # Drop the record
    dropRecord(args.position, args.world)
    # Stop the music and update block state
    stopPlaying(args.block0, args.position, args.world)
    return barSuccess
  barPass

proc songNameOf(song: string): (bool, string) =
  ## `song.split(':').nth(1)`
  let parts = song.split(':')
  if parts.len > 1: (true, parts[1]) else: (false, "")

proc jukeboxBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let world = args.world
  let stateId = world.getBlockState(args.position).id
  # Vanilla: if (state.get(HAS_RECORD)) return PASS_TO_DEFAULT_BLOCK_ACTION
  if hasRecordState(args.block0, stateId):
    return barPassToDefaultBlockAction
  # Vanilla: JukeboxPlayableComponent lv = stack.get(DataComponentTypes.JUKEBOX_PLAYABLE)
  let jukeboxPlayable = args.itemStack.stack.getDataComponent(JukeboxPlayableImpl)
  # Vanilla: if (lv == null) return PASS_TO_DEFAULT_BLOCK_ACTION
  if not jukeboxPlayable[0]:
    return barPassToDefaultBlockAction
  let songName = songNameOf(jukeboxPlayable[1].song)
  if not songName[0]:
    return barPassToDefaultBlockAction
  let jukeboxSong = jsong.fromName(songName[1])
  if not jukeboxSong[0]:
    # upstream logs "Jukebox playable song not registered"
    return barPassToDefaultBlockAction
  # Vanilla: ItemStack lv3 = stack.splitUnlessCreative(1, player)
  let record = args.itemStack.stack.splitUnlessCreative(args.player.gamemode(), 1'u8)
  # Vanilla: lv4.setStack(lv3)
  let t9 = world.getBlockEntity(args.position)
  if t9.isSome:
    let jukebox = t9.unsafeGet.asType(JukeboxBlockEntity)
    if jukebox.isSome:
      jukebox.unsafeGet.setRecord(record)
      # Start tracking playback with song duration
      jukebox.unsafeGet.startPlaying(jukeboxSong[1].lengthInTicks())
  # Update block state to has_record = true
  setRecordState(true, args.block0, args.position, world)
  # Start playing the music (client-side audio)
  startPlaying(args.position, world, jukeboxSong[1].getId())
  args.player.incrementStat(scCustom, int32(csPlayRecord), 1)
  # TODO upstream: world.emitGameEvent(GameEvent.BLOCK_CHANGE, pos, ...)
  barSuccess

proc jukeboxBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Drop the record if there is one
  dropRecord(args.position, args.world)
  # Stop the music
  args.world.syncWorldEvent(weSoundStopJukeboxSong, args.position, 0'i32)

proc jukeboxBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  # Vanilla calls ItemScatterer.onStateReplaced which updates comparators
  # TODO upstream: world.updateComparators(pos, block) when implemented
  discard

proc jukeboxBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc jukeboxBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  # Vanilla: return world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv && lv.getManager().isPlaying() ? 15 : 0
  let t12 = args.world.getBlockEntity(args.position)
  if t12.isSome:
    let jukebox = t12.unsafeGet.asType(JukeboxBlockEntity)
    if jukebox.isSome and jukebox.unsafeGet.isPlaying():
      return 15'u8
  0'u8

proc jukeboxBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  # Vanilla: return world.getBlockEntity(pos) instanceof JukeboxBlockEntity lv ? lv.getComparatorOutput() : 0
  let t15 = args.world.getBlockEntity(args.position)
  if t15.isSome:
    let jukebox = t15.unsafeGet.asType(JukeboxBlockEntity)
    if jukebox.isSome:
      let record = jukebox.unsafeGet.getRecord()
      # Get the song from the record's jukebox_playable component
      let playable = record.getDataComponent(JukeboxPlayableImpl)
      if playable[0]:
        let songName = songNameOf(playable[1].song)
        if songName[0]:
          let song = jsong.fromName(songName[1])
          if song[0]:
            return some(song[1].comparatorOutput())
  some(0'u8)

proc newJukeboxBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = jukeboxBlockPlaced_BlockBehaviour
  result.normalUseImpl = jukeboxBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = jukeboxBlockUseWithItem_BlockBehaviour
  result.brokenImpl = jukeboxBlockBroken_BlockBehaviour
  result.onStateReplacedImpl = jukeboxBlockOnStateReplaced_BlockBehaviour
  result.emitsRedstonePowerImpl = jukeboxBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = jukeboxBlockGetWeakRedstonePower_BlockBehaviour
  result.getComparatorOutputImpl = jukeboxBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksJukebox*(r: BlockRegistry) =
  r.register("minecraft:jukebox", newJukeboxBlock())
