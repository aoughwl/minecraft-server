proc ladderBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let clickedPos = args.useItemOn.position
  let (clickedBlock, clickedBlockStateId) = args.world.getBlockAndStateId(clickedPos)
  if (clickedBlock == blockLadder()):
    # you can't click on a ladder and place a ladder
    let props = LadderLikeProperties.fromStateId(clickedBlockStateId, clickedBlock)
    let sub = args.position.vec.sub(clickedPos.vec)
    block chain3:
      let t1 = horizontalFacingFromOffset(sub)
      if t1.isSome:
        let dir = t1.unsafeGet
        let t2 = t1.unsafeGet.toHorizontalFacing()
        if t2.isSome:
          let horizontalFacing = t2.unsafeGet
          if (props.facing == t2.unsafeGet):
            return blockAir().defaultState.id
  var props1 = LadderLikeProperties.defaultFor(args.block0)
  let directions = args.player.getEntity().getEntityFacingOrder()
  for dir in directions:
    if ((dir == Facing.Up) or (dir == Facing.Down)):
      continue
    if (not canPlaceLadderAt(args.world, args.position, dir.toBlockDirection())):
      continue
    props1.facing = dir.opposite().toHorizontalFacing().get()
    return props1.toStateId(args.block0)
  blockAir().defaultState.id

proc ladderBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t4 = blockDirectionHorizontal()
  for dir in t4:
    let t5 = args.world
    if not (t5.isSome):
      # this won't happen
      return false
    let world = t5.unsafeGet
    if canPlaceLadderAt(world, args.position, dir.toBlockDirection()):
      return true
  false

proc ladderBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let props = LadderLikeProperties.fromStateId(args.stateId, args.block0)
  if (props.facing.toBlockDirection().opposite() == args.direction) and (not canPlaceLadderAt(args.world, args.position, props.facing.toBlockDirection().opposite())):
    return blockStateIdAir
  args.stateId

proc ladderBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let stateId = args.world.getBlockStateId(args.position)
  if (not (Block.fromStateId(stateId) == blockLadder())):
    return
  let props = LadderLikeProperties.fromStateId(stateId, args.block0)
  if (not canPlaceLadderAt(args.world, args.position, props.facing.toBlockDirection().opposite())):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)

proc newLadderBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = ladderBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = ladderBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = ladderBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = ladderBlockOnScheduledTick_BlockBehaviour

proc horizontalFacingFromOffset*(offset: Vector3[int32]): Option[BlockDirection] =
  let t6 = (offset.x, offset.y, offset.z)
  if t6[0] == 0 and t6[1] == 0 and t6[2] == -1:
    some(BlockDirection.North)
  elif t6[0] == 0 and t6[1] == 0 and t6[2] == 1:
    some(BlockDirection.South)
  elif t6[0] == -1 and t6[1] == 0 and t6[2] == 0:
    some(BlockDirection.West)
  elif t6[0] == 1 and t6[1] == 0 and t6[2] == 0:
    some(BlockDirection.East)
  else:
    none[BlockDirection]()

proc canPlaceLadderAt*(world: BlockWorld, blockPos: BlockPos, facing: BlockDirection): bool =
  world.getBlockState(blockPos.offset(facing.toOffset())).isSideSolid(facing.opposite())

proc registerBlocksLadder*(r: BlockRegistry) =
  r.register("minecraft:ladder", newLadderBlock())

