import ../blockprelude


type
  LanternBlock* = object



proc lanternBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc lanternBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc lanternBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc lanternBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newLanternBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool

proc lanternBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = LanternLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  let blockUpState = args.world.getBlockState(args.position.up())
  if blockUpState.isCenterSolid(BlockDirection.Down):
    props.hanging = true
  props.toStateId(args.block0)

proc lanternBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t1 = args.world
  var t2 = false
  if t1.isSome:
    let world = t1.unsafeGet
    t2 = canPlaceAt(world, args.position)
  t2

proc lanternBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc lanternBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newLanternBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = lanternBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = lanternBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = lanternBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = lanternBlockOnScheduledTick_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, position: BlockPos): bool =
  # idk why this don't update with .is_center_solid so this is a 'temporary patch'
  if world.getBlock(position.down()).hasTag(Block_C_FENCE_GATES):
    let fenceGateProps = OakFenceGateLikeProperties.fromStateId(world.getBlockStateId(position.down()), world.getBlock(position.down()))
    if fenceGateProps.open:
      return false
  let (blockDown, blockDownState) = world.getBlockAndState(position.down())
  let blockUpState = world.getBlockState(position.up())
  ((blockDownState.isCenterSolid(BlockDirection.Up) or blockUpState.isCenterSolid(BlockDirection.Down)) or blockDown.hasTag(Block_MINECRAFT_UNSTABLE_BOTTOM_CENTER))

proc registerBlocksLanterns*(r: BlockRegistry) =
  r.registerTag("minecraft:lanterns", newLanternBlock())

