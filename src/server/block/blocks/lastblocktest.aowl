## The last block drafts, now real, through the real registry over a `TestWorld`: cauldron comparator output, flower pots, infested
## blocks, the dragon egg, the conduit, the chiseled bookshelf and shelf entities, the command block (power, scheduled tick,
## repeating, chain, conditional), and the NBT round trip of the small block entities (sculk family, end gateway, conduit,
## brushable block, trial spawner, vault). Known answers are worked out from the Rust.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio, strutils]
import ../blockprelude
import ../containers
import ../registry
import ../testworld
import ../entities/entitiesmod
import ../entities/[command_block, chiseled_bookshelf, shelf, conduit, end_gateway, sculk_sensor, calibrated_sculk_sensor,
  sculk_catalyst, sculk_shrieker, brushable_block, trial_spawner, vault]
import chiseled_bookshelf as bookshelfblock
import ../../../generated/flower_pot_transformations
import ../../../generated/item_full

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc playerOf(mode: GameMode; yaw = 0.0'f32): BlockPlayer =
  let p = BlockPlayer()
  p.gamemode0 = proc(): GameMode {.closure.} = mode
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p.pitch0 = proc(): float32 {.closure.} = 0.0'f32
  p

proc loadedFrom(saved: NbtCompound; id: string; pos: BlockPos): BlockEntity =
  var nbt = saved
  put(nbt, "id", NbtTag(kind: ntkString, stringVal: id))
  put(nbt, "x", NbtTag(kind: ntkInt, intVal: pos.vec.x))
  put(nbt, "y", NbtTag(kind: ntkInt, intVal: pos.vec.y))
  put(nbt, "z", NbtTag(kind: ntkInt, intVal: pos.vec.z))
  blockEntityFromNbt(nbt).unsafeGet

proc created(kind: string; pos: BlockPos): BlockEntity =
  for i in 0 ..< BLOCK_ENTITY_TYPES.len:
    if BLOCK_ENTITY_TYPES[i] == kind:
      return createBlockEntity(uint16(i), pos).unsafeGet
  quit(1)

proc saved(e: BlockEntity): NbtCompound =
  var nbt = newCompound()
  e.writeNbt(nbt)
  nbt

proc putCommand(t: TestWorld; x: int32; blockRef: Block; conditional: bool; command: string) =
  var props = CommandBlockLikeProperties.defaultFor(blockRef)
  props.facing = Facing.East
  props.conditional = conditional
  let state = props.toStateId(blockRef)
  let pos = blockPos(x, 64'i32, 10'i32)
  t.put(pos, state)
  let reg0 = t.world.blockRegistry
  reg0.getPumpkinBlock(blockRef.id).unsafeGet.placed(PlacedArgs(world: t.world, block0: blockRef, stateId: state, position: pos,
    notify: true))
  t.world.getBlockEntity(pos).unsafeGet.asType(CommandBlockEntity).get().command = command

proc run() =
  let reg = defaultRegistry()
  check(reg.unknown.len == 0, "every registered name and tag resolves")
  for b in [blockCauldron(), blockWaterCauldron(), blockLavaCauldron(), blockPowderSnowCauldron(), blockCommandBlock(),
      blockChainCommandBlock(), blockRepeatingCommandBlock(), blockConduit(), blockDragonEgg(), blockFlowerPot(),
      blockPottedPoppy(), blockInfestedCobblestone(), blockAcaciaShelf(), blockChiseledBookshelf()]:
    check(reg.getPumpkinBlock(b.id).isSome, "registered: " & b.name)

  # --- Cauldron: water and powder snow report their level, lava 3, the empty cauldron 0.
  let t = newTestWorld(reg)
  let origin = blockPos(0'i32, 64'i32, 0'i32)
  var water = WaterCauldronLikeProperties(level: 2'u8)
  let waterState = water.toStateId(blockWaterCauldron())
  t.put(origin, waterState)
  let cauldron = reg.getPumpkinBlock(blockWaterCauldron().id).unsafeGet
  check(cauldron.getComparatorOutput(GetComparatorOutputArgs(world: t.world, block0: blockWaterCauldron(),
    position: origin)).get() == 2'u8, "a water cauldron at level 2 reads 2")
  var snow = WaterCauldronLikeProperties(level: 3'u8)
  t.put(origin, snow.toStateId(blockPowderSnowCauldron()))
  check(reg.getPumpkinBlock(blockPowderSnowCauldron().id).unsafeGet.getComparatorOutput(GetComparatorOutputArgs(
    world: t.world, block0: blockPowderSnowCauldron(), position: origin)).get() == 3'u8, "powder snow at level 3 reads 3")
  check(reg.getPumpkinBlock(blockLavaCauldron().id).unsafeGet.getComparatorOutput(GetComparatorOutputArgs(
    world: t.world, block0: blockLavaCauldron(), position: origin)).get() == 3'u8, "lava reads 3")
  check(reg.getPumpkinBlock(blockCauldron().id).unsafeGet.getComparatorOutput(GetComparatorOutputArgs(
    world: t.world, block0: blockCauldron(), position: origin)).get() == 0'u8, "an empty cauldron reads 0")

  # --- Flower pots: a poppy goes in, an empty hand takes it out, another flower on a full pot does nothing.
  let poppy = ITEM_POPPY
  check(BlockId(getPottedItem(poppy.id)) == blockPottedPoppy().id, "poppy pots to potted_poppy")
  t.put(origin, blockFlowerPot())
  let hit = BlockHitResult(face: BlockDirection.Up, cursorPos: Vector3[float32](x: 0.5'f32, y: 0.5'f32, z: 0.5'f32))
  let creative = playerOf(GameMode.Creative)
  let r1 = reg.useWithItem(blockFlowerPot(), creative, origin, hit, ItemStackRef(stack: newItemStack(1'u8, poppy)), 0,
    BlockServer(), t.world)
  check(r1 == barSuccess, "potting succeeds")
  check(sameBlock(t.world.getBlock(origin), blockPottedPoppy()), "the pot now holds the poppy")
  let r2 = reg.useWithItem(blockPottedPoppy(), creative, origin, hit, ItemStackRef(stack: newItemStack(1'u8, poppy)), 0,
    BlockServer(), t.world)
  check(r2 == barConsume, "a flower in hand on a full pot is consumed with no change")
  check(sameBlock(t.world.getBlock(origin), blockPottedPoppy()), "and the pot is unchanged")
  let r3 = reg.useWithItem(blockPottedPoppy(), creative, origin, hit, ItemStackRef(stack: emptyItemStack()), 0,
    BlockServer(), t.world)
  check(r3 == barSuccess, "an empty hand takes the flower")
  check(sameBlock(t.world.getBlock(origin), blockFlowerPot()), "back to an empty pot")
  # random_tick: the closed eyeblossom opens at night and closes by day, only in the overworld.
  var timeOfDay = 15000'i64
  t.world.timeOfDay0 = proc(): int64 {.closure.} = timeOfDay
  t.put(origin, blockPottedClosedEyeblossom())
  let pot = reg.getPumpkinBlock(blockPottedClosedEyeblossom().id).unsafeGet
  pot.randomTick(RandomTickArgs(world: t.world, block0: blockPottedClosedEyeblossom(), position: origin))
  check(sameBlock(t.world.getBlock(origin), blockPottedOpenEyeblossom()), "a closed eyeblossom opens at 15000")
  timeOfDay = 1000'i64
  pot.randomTick(RandomTickArgs(world: t.world, block0: blockPottedOpenEyeblossom(), position: origin))
  check(sameBlock(t.world.getBlock(origin), blockPottedClosedEyeblossom()), "an open one closes at 1000")

  # --- Infested blocks: breaking one spawns a silverfish, except in creative.
  var spawned: seq[string] = @[]
  t.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    spawned.add(entityType & " " & $position.x & " " & $position.y & " " & $position.z)
    nil
  t.put(origin, blockInfestedCobblestone())
  reg.broken(blockInfestedCobblestone(), creative, origin, BlockServer(), t.world, blockInfestedCobblestone().defaultState)
  check(spawned.len == 0, "creative breaking spawns nothing")
  reg.broken(blockInfestedCobblestone(), playerOf(GameMode.Survival), origin, BlockServer(), t.world, blockInfestedCobblestone().defaultState)
  check(spawned.len == 1 and spawned[0] == "silverfish 0.0 64.0 0.0", "survival breaking spawns a silverfish")

  # --- Dragon egg: placed schedules a tick in 5; using it teleports it to air over a solid block.
  let egg = newTestWorld(reg)
  for x in -17'i32 .. 17'i32:
    for z in -17'i32 .. 17'i32:
      egg.put(blockPos(x, 63'i32, z), blockStone())
  egg.put(origin, blockDragonEgg())
  let eggBehaviour = reg.getPumpkinBlock(blockDragonEgg().id).unsafeGet
  eggBehaviour.placed(PlacedArgs(world: egg.world, block0: blockDragonEgg(), stateId: blockDragonEgg().defaultState.id,
    position: origin, notify: true))
  check(egg.ticks.len == 1 and egg.ticks[0].due == 5'i64, "placing schedules a tick 5 later")
  check(eggBehaviour.normalUse(NormalUseArgs(world: egg.world, block0: blockDragonEgg(), position: origin,
    player: creative)) == barSuccess, "using the egg succeeds")
  check(egg.world.getBlock(origin).id == blockAir().id, "the egg left its place")
  var eggs = 0
  for x in -17'i32 .. 17'i32:
    for y in 40'i32 .. 80'i32:
      for z in -17'i32 .. 17'i32:
        if egg.world.getBlock(blockPos(x, y, z)).id == blockDragonEgg().id:
          eggs += 1
  check(eggs == 1, "exactly one egg exists after the jump")

  # --- Conduit: placed in water is waterlogged, and gets its entity.
  let cond = reg.getPumpkinBlock(blockConduit().id).unsafeGet
  let dry = cond.onPlace(OnPlaceArgs(world: t.world, block0: blockConduit(), position: origin, direction: BlockDirection.Up,
    player: creative, replacing: BlockIsReplacing(kind: BlockIsReplacingKind.kNone)))
  check(not MangroveRootsLikeProperties.fromStateId(dry, blockConduit()).waterlogged, "dry conduit")
  let wet = cond.onPlace(OnPlaceArgs(world: t.world, block0: blockConduit(), position: origin, direction: BlockDirection.Up,
    player: creative, replacing: BlockIsReplacing(kind: BlockIsReplacingKind.kWater, f0Water: 0'u8)))
  check(MangroveRootsLikeProperties.fromStateId(wet, blockConduit()).waterlogged, "conduit in a water source is waterlogged")
  cond.placed(PlacedArgs(world: t.world, block0: blockConduit(), stateId: wet, position: origin, notify: true))
  check(t.world.getBlockEntity(origin).isSome and t.world.getBlockEntity(origin).unsafeGet.resourceLocation() == "minecraft:conduit",
    "placing adds a conduit entity")

  # --- Chiseled bookshelf: slot geometry, a book goes in and comes out, the comparator reads the last slot touched.
  let shelfBlock = reg.getPumpkinBlock(blockChiseledBookshelf().id).unsafeGet
  let shelfPos = blockPos(3'i32, 64'i32, 3'i32)
  var sprops = ChiseledBookshelfLikeProperties.defaultFor(blockChiseledBookshelf())
  sprops.facing = HorizontalFacing.South
  t.put(shelfPos, sprops.toStateId(blockChiseledBookshelf()))
  shelfBlock.placed(PlacedArgs(world: t.world, block0: blockChiseledBookshelf(), stateId: sprops.toStateId(blockChiseledBookshelf()),
    position: shelfPos, notify: true))
  # Facing south: x is the cursor x, y the cursor y, with y < 0.5 the bottom row (slots 3..5).
  proc hitAt(x, y: float32): BlockHitResult =
    BlockHitResult(face: BlockDirection.South, cursorPos: Vector3[float32](x: x, y: y, z: 1.0'f32))
  let book = ITEM_BOOK
  let bookStack = ItemStackRef(stack: newItemStack(3'u8, book))
  let survival = playerOf(GameMode.Survival)
  let a1 = reg.useWithItem(blockChiseledBookshelf(), survival, shelfPos, hitAt(0.2'f32, 0.8'f32), bookStack, 0, BlockServer(), t.world)
  check(a1 == barSuccess, "a book goes into the top-left slot")
  check(bookStack.stack.itemCount == 2'u8, "one book left the stack")
  let sp1 = ChiseledBookshelfLikeProperties.fromStateId(t.world.getBlockStateId(shelfPos), blockChiseledBookshelf())
  check(sp1.slot0Occupied and not sp1.slot1Occupied, "slot 0 is occupied")
  check(shelfBlock.getComparatorOutput(GetComparatorOutputArgs(world: t.world, block0: blockChiseledBookshelf(),
    position: shelfPos)).get() == 1'u8, "the comparator reads last slot + 1")
  let a2 = reg.useWithItem(blockChiseledBookshelf(), survival, shelfPos, hitAt(0.5'f32, 0.2'f32), bookStack, 0, BlockServer(), t.world)
  check(a2 == barSuccess, "a book goes into the bottom-middle slot")
  let sp2 = ChiseledBookshelfLikeProperties.fromStateId(t.world.getBlockStateId(shelfPos), blockChiseledBookshelf())
  check(sp2.slot0Occupied and sp2.slot4Occupied, "slots 0 and 4")
  check(shelfBlock.getComparatorOutput(GetComparatorOutputArgs(world: t.world, block0: blockChiseledBookshelf(),
    position: shelfPos)).get() == 5'u8, "last slot 4 reads 5")
  let a3 = reg.useWithItem(blockChiseledBookshelf(), survival, shelfPos, hitAt(0.2'f32, 0.8'f32), bookStack, 0, BlockServer(), t.world)
  check(a3 == barPassToDefaultBlockAction, "a used slot passes")
  let e = t.world.getBlockEntity(shelfPos).unsafeGet.asType(ChiseledBookshelfBlockEntity).get()
  # The entity saves and loads with the slot it touched last.
  let reloaded = loadedFrom(saved(e), "minecraft:chiseled_bookshelf", shelfPos).asType(ChiseledBookshelfBlockEntity).get()
  check(reloaded.lastInteractedSlot == 4'i8, "last interacted slot survives NBT")
  check(not reloaded.inv.items[0].isEmpty() and not reloaded.inv.items[4].isEmpty() and reloaded.inv.items[1].isEmpty(),
    "the books survive NBT")
  # A hit on another face reaches no slot.
  check(bookshelfblock.getSlotForHit(BlockHitResult(face: BlockDirection.North, cursorPos: Vector3[float32](x: 0.5'f32, y: 0.5'f32, z: 0.0'f32)),
    HorizontalFacing.South).isNone, "the wrong face reaches nothing")
  check(bookshelfblock.getSlotForHit(hitAt(0.375'f32, 0.5'f32), HorizontalFacing.South).get() == 1'i8, "x = 0.375 is column 1, y = 0.5 the top row")
  check(bookshelfblock.getSlotForHit(hitAt(0.6875'f32, 0.0'f32), HorizontalFacing.South).get() == 5'i8, "x = 0.6875 is column 2, bottom row")

  # --- Shelf entity: nine slots, round trip.
  let sh = created("shelf", shelfPos).asType(ShelfBlockEntity).get()
  check(sh.inv.items.len == 9, "a shelf holds nine stacks")
  sh.inv.items[7] = newItemStack(5'u8, book)
  let sh2 = loadedFrom(saved(sh), "minecraft:shelf", shelfPos).asType(ShelfBlockEntity).get()
  check(sh2.inv.items[7].itemCount == 5'u8 and sh2.inv.items[0].isEmpty(), "shelf stacks survive NBT")

  # --- Command blocks.
  var ran: seq[string] = @[]
  var workRule = true
  t.world.commandBlocksWork0 = proc(): bool {.closure.} = workRule
  t.world.runCommandBlock0 = proc(position: BlockPos; command: string) {.closure.} =
    ran.add($position.vec.x & "," & $position.vec.z & ":" & command)
    # The dispatcher side counts a success for the block that ran.
    let entity = t.world.getBlockEntity(position).unsafeGet.asType(CommandBlockEntity).get()
    entity.successCount = 1'u32
  let cmd = reg.getPumpkinBlock(blockCommandBlock().id).unsafeGet
  let cpos = blockPos(10'i32, 64'i32, 10'i32)
  check(not cmd.canPlaceAt(CanPlaceAtArgs(world: t.world, blockAccessor: t.world, block0: blockCommandBlock(),
    position: cpos, player: survival)), "survival cannot place a command block")
  check(cmd.canPlaceAt(CanPlaceAtArgs(world: t.world, blockAccessor: t.world, block0: blockCommandBlock(),
    position: cpos, player: creative)), "creative can")
  # Placing: facing opposite the player's.
  let placedState = reg.onPlace(BlockServer(), t.world, playerOf(GameMode.Creative, 0.0'f32), blockCommandBlock(), cpos,
    BlockDirection.Up, BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())
  check(CommandBlockLikeProperties.fromStateId(placedState, blockCommandBlock()).facing == Facing.North,
    "a player looking south places it facing north")
  # A row going east: impulse block at x=10, chain blocks at x=11 and x=12 (the last conditional), all facing east.
  t.putCommand(10'i32, blockCommandBlock(), false, "say one")
  t.putCommand(11'i32, blockChainCommandBlock(), false, "say two")
  t.putCommand(12'i32, blockChainCommandBlock(), true, "say three")
  check(t.world.getBlockEntity(cpos).unsafeGet.asType(CommandBlockEntity).get().auto == false, "an impulse block is not automatic")
  check(t.world.getBlockEntity(blockPos(11'i32, 64'i32, 10'i32)).unsafeGet.asType(CommandBlockEntity).get().auto, "a chain block is")
  # Power it: a redstone block beside it, then the neighbour update.
  t.put(blockPos(10'i32, 64'i32, 11'i32), blockRedstoneBlock())
  reg.onNeighborUpdate(t.world, blockCommandBlock(), cpos, blockRedstoneBlock(), true)
  check(t.world.getBlockEntity(cpos).unsafeGet.asType(CommandBlockEntity).get().powered, "the block took the power")
  check(t.ticks.len >= 1, "a tick is scheduled")
  check(ran.len == 0, "nothing ran before the tick")
  t.run(2)
  check(ran == @["10,10:say one", "11,10:say two", "12,10:say three"], "the tick ran the block, then the chain, in order: " & $ran.len)
  # Unpowered chain: a cleared command block resets the success count of the next conditional.
  ran = @[]
  workRule = false
  t.world.getBlockEntity(cpos).unsafeGet.asType(CommandBlockEntity).get().powered = false
  reg.onNeighborUpdate(t.world, blockCommandBlock(), cpos, blockRedstoneBlock(), true)
  check(t.ticks.len == 0 and ran.len == 0, "with the game rule off nothing is scheduled or run")
  workRule = true
  # An empty command resets the success count and runs nothing.
  let first = t.world.getBlockEntity(cpos).unsafeGet.asType(CommandBlockEntity).get()
  first.command = ""
  first.successCount = 4'u32
  t.world.blockRegistry.getPumpkinBlock(blockCommandBlock().id).unsafeGet.onScheduledTick(OnScheduledTickArgs(world: t.world,
    block0: blockCommandBlock(), position: cpos))
  check(first.successCount == 0'u32, "an empty command clears the success count")
  check(ran.len == 2 and ran[0] == "11,10:say two", "and the chain behind it still runs")
  check(cmd.getComparatorOutput(GetComparatorOutputArgs(world: t.world, block0: blockCommandBlock(), position: cpos)).get() == 0'u8,
    "the comparator reads the success count")
  # Repeating block: runs and schedules itself again while powered.
  let rpos = blockPos(20'i32, 64'i32, 20'i32)
  var rprops = CommandBlockLikeProperties.defaultFor(blockRepeatingCommandBlock())
  rprops.facing = Facing.East
  t.put(rpos, rprops.toStateId(blockRepeatingCommandBlock()))
  let rep = reg.getPumpkinBlock(blockRepeatingCommandBlock().id).unsafeGet
  rep.placed(PlacedArgs(world: t.world, block0: blockRepeatingCommandBlock(), stateId: rprops.toStateId(blockRepeatingCommandBlock()),
    position: rpos, notify: true))
  let rent = t.world.getBlockEntity(rpos).unsafeGet.asType(CommandBlockEntity).get()
  rent.command = "say tick"
  rent.powered = true
  ran = @[]
  rep.onScheduledTick(OnScheduledTickArgs(world: t.world, block0: blockRepeatingCommandBlock(), position: rpos))
  check(ran == @["20,20:say tick"], "a repeating block runs")
  check(t.ticks.len == 1 and t.ticks[0].position == rpos, "and schedules itself again while powered")

  # --- Small block entities: created by name, saved, loaded back.
  let p0 = blockPos(1'i32, 2'i32, 3'i32)
  for name in ["end_portal", "creaking_heart", "end_gateway", "conduit", "sculk_sensor", "calibrated_sculk_sensor",
      "sculk_catalyst", "sculk_shrieker", "chiseled_bookshelf", "shelf", "brushable_block", "trial_spawner", "vault",
      "test_block", "test_instance_block", "copper_golem_statue", "potent_sulfur"]:
    let made = created(name, p0)
    check(made.resourceLocation() == "minecraft:" & name, "created " & name)
    check(made.getPosition() == p0, "position of " & name)
    let back = loadedFrom(saved(made), "minecraft:" & name, p0)
    check(back.resourceLocation() == "minecraft:" & name, "loaded " & name)
  let sensor = created("sculk_sensor", p0).asType(SculkSensorBlockEntity).get()
  sensor.lastVibrationFrequency = 9'i32
  check(loadedFrom(saved(sensor), "minecraft:sculk_sensor", p0).asType(SculkSensorBlockEntity).get().lastVibrationFrequency == 9'i32,
    "sculk sensor frequency")
  check(saved(sensor).getInt("last_vibration_frequency").get() == 9'i32, "stored under last_vibration_frequency")
  let calib = created("calibrated_sculk_sensor", p0).asType(CalibratedSculkSensorBlockEntity).get()
  calib.lastVibrationFrequency = 4'i32
  check(loadedFrom(saved(calib), "minecraft:calibrated_sculk_sensor", p0).asType(CalibratedSculkSensorBlockEntity).get()
    .lastVibrationFrequency == 4'i32, "calibrated sculk sensor frequency")
  let cat = created("sculk_catalyst", p0).asType(SculkCatalystBlockEntity).get()
  cat.decayDelay = 11'i32
  check(saved(cat).getInt("decay_delay").get() == 11'i32, "catalyst decay_delay")
  let shrk = created("sculk_shrieker", p0).asType(SculkShriekerBlockEntity).get()
  shrk.warningLevel = 3'i32
  check(loadedFrom(saved(shrk), "minecraft:sculk_shrieker", p0).asType(SculkShriekerBlockEntity).get().warningLevel == 3'i32,
    "shrieker warning level")
  let gate = created("end_gateway", p0).asType(EndGatewayBlockEntity).get()
  gate.age = 99'i64
  gate.exactTeleport = true
  gate.exitPortal = some(blockPos(7'i32, 8'i32, 9'i32))
  let gate2 = loadedFrom(saved(gate), "minecraft:end_gateway", p0).asType(EndGatewayBlockEntity).get()
  check(gate2.age == 99'i64 and gate2.exactTeleport and gate2.exitPortal.get() == blockPos(7'i32, 8'i32, 9'i32), "end gateway fields")
  check(created("end_gateway", p0).chunkDataNbt().get().getBool("ExactTeleport").get() == false, "chunk data of a new gateway")
  let con = created("conduit", p0).asType(ConduitBlockEntity).get()
  con.active = true
  check(loadedFrom(saved(con), "minecraft:conduit", p0).asType(ConduitBlockEntity).get().active, "conduit active")
  check(saved(created("conduit", p0)).getBool("Active").get() == false, "a new conduit is inactive and has no Target")
  let br = created("brushable_block", p0).asType(BrushableBlockBlockEntity).get()
  br.item = some(newItemStack(2'u8, book))
  br.hits = 3'i32
  br.direction = 4'u8
  let br2 = loadedFrom(saved(br), "minecraft:brushable_block", p0).asType(BrushableBlockBlockEntity).get()
  check(br2.item.isSome and br2.item.unsafeGet.itemCount == 2'u8 and br2.hits == 3'i32 and br2.direction == 4'u8, "brushable block fields")
  let ts = created("trial_spawner", p0).asType(TrialSpawnerBlockEntity).get()
  var cfg = newCompound()
  cfg.putInt("spawn_range", 14'i32)
  ts.normalConfig = some(cfg)
  let ts2 = loadedFrom(saved(ts), "minecraft:trial_spawner", p0).asType(TrialSpawnerBlockEntity).get()
  check(ts2.normalConfig.isSome and ts2.normalConfig.unsafeGet.getInt("spawn_range").get() == 14'i32 and ts2.ominousConfig.isNone,
    "trial spawner config")
  let vlt = created("vault", p0).asType(VaultBlockEntity).get()
  vlt.serverData = some(cfg)
  let vt2 = loadedFrom(saved(vlt), "minecraft:vault", p0).asType(VaultBlockEntity).get()
  check(vt2.serverData.isSome and vt2.config.isNone, "vault data")
  echo "lastblocktest ok"

run()
