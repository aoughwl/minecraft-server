## Port of pumpkin/src/block/blocks/lectern.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/lectern


type
  LecternBlock* = object



proc updateLecternState*(hasBook: bool, blockRef: Block, position: BlockPos, world: BlockWorld, props: LecternLikeProperties)
proc lecternBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc lecternBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc lecternBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc lecternBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc lecternBlockBroken_BlockBehaviour(args: BrokenArgs)
proc lecternBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8]
proc newLecternBlock*(): BlockBehaviour

proc updateLecternState*(hasBook: bool, blockRef: Block, position: BlockPos, world: BlockWorld, props: LecternLikeProperties) =
  props.hasBook = hasBook
  discard world.setBlockState(position, props.toStateId(blockRef), BfNotifyAll)

proc lecternBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blockEntity = newLecternBlockEntity(args.position)
  args.world.addBlockEntity(blockEntity)

proc lecternBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = LecternLikeProperties.defaultFor(args.block0)
  props.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc lecternBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithLectern), 1)
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = asType(t1.unsafeGet, LecternBlockEntity)
      if t2.isSome:
        let lecternEntity = t2.unsafeGet
        let book = t2.unsafeGet.removeStack(0)
        if (not isEmpty(book)):
          # Logic to give the book to the player
          # Need to find a proper way to give items to player. For now skip.
          var props = LecternLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
          updateLecternState(false, args.block0, args.position, args.world, props)
          return barSuccess
  barPass

proc lecternBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  # Check if it's a book
  block chain6:
    if contains(args.itemStack.item.registryKey, "book"):
      let t4 = args.world.getBlockEntity(args.position)
      if t4.isSome:
        let blockEntity = t4.unsafeGet
        let t5 = asType(t4.unsafeGet, LecternBlockEntity)
        if t5.isSome:
          let lecternEntity = t5.unsafeGet
          if isEmpty(t5.unsafeGet.book):
            let book = args.itemStack.splitUnlessCreative(args.player.gamemode, 1)
            t5.unsafeGet.setStack(0, book)
            var props = LecternLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
            updateLecternState(true, args.block0, args.position, args.world, props)
            return barSuccess
  barPass

proc lecternBlockBroken_BlockBehaviour(args: BrokenArgs) =
  block chain9:
    let t7 = args.world.getBlockEntity(args.position)
    if t7.isSome:
      let blockEntity = t7.unsafeGet
      let t8 = asType(t7.unsafeGet, LecternBlockEntity)
      if t8.isSome:
        let lecternEntity = t8.unsafeGet
        let book = t8.unsafeGet.removeStack(0)
        if (not isEmpty(book)):
          # Drop the book item
          let entity = newEntity(args.world, newVector3((float64(args.position.vec.x) + 0.5), (float64(args.position.vec.y) + 0.5), (float64(args.position.vec.z) + 0.5)), EntityType.ITEM)
          let itemEntity = newItemEntity(entity, book)
          args.world.spawnEntity(itemEntity)

proc lecternBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain12:
    let t10 = args.world.getBlockEntity(args.position)
    if t10.isSome:
      let blockEntity = t10.unsafeGet
      let t11 = asType(t10.unsafeGet, LecternBlockEntity)
      if t11.isSome:
        let lecternEntity = t11.unsafeGet
        if isEmpty(t11.unsafeGet.book):
          return some(0)
        let page = float32(t11.unsafeGet.page)
        var pages = 1.0
        let t13 = t11.unsafeGet.book.getDataComponent()
        if t13.isSome:
          let comp = t13.unsafeGet
          pages = float32(len(t13.unsafeGet.pages).max(1))
        else:
          let t15 = t11.unsafeGet.book.getDataComponent()
          if t15.isSome:
            let comp = t15.unsafeGet
            pages = float32(len(t15.unsafeGet.pages).max(1))
        let t16 = block:
          if (pages > 1.0):
            (1.0 + ((14.0 * page) / ((pages - 1.0))))
          else:
            15.0
        let output: float32 = t16
        some(uint8(floor(output)))
        break chain12
    some(0)

proc newLecternBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = lecternBlockPlaced_BlockBehaviour
  result.onPlaceImpl = lecternBlockOnPlace_BlockBehaviour
  result.normalUseImpl = lecternBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = lecternBlockUseWithItem_BlockBehaviour
  result.brokenImpl = lecternBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = lecternBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksLectern*(r: BlockRegistry) =
  r.register("minecraft:lectern", newLecternBlock())

