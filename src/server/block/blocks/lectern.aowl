## Port of pumpkin/src/block/blocks/lectern.rs
## Upstream gives the taken book to nobody (its own TODO) and opens no screen; this does the same.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/strutils
import ../blockprelude
import ../containers
import ../entities/lectern

proc updateLecternState*(hasBook: bool, blockRef: Block, position: BlockPos, world: BlockWorld, props0: LecternLikeProperties) =
  var props = props0
  props.hasBook = hasBook
  discard world.setBlockState(position, props.toStateId(blockRef), BfNotifyAll)

proc lecternBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let blockEntity = newLecternBlockEntity(args.position)
  args.world.addBlockEntity(blockEntity)

proc lecternBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = LecternLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc lecternBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithLectern), 1)
  let t1 = args.world.getBlockEntity(args.position)
  if t1.isSome:
    let lectern = t1.unsafeGet.asType(LecternBlockEntity)
    if lectern.isSome:
      let book = lectern.unsafeGet.asInventory().removeStack(0)
      if not book.isEmpty():
        # Logic to give the book to the player
        # Need to find a proper way to give items to player. For now skip.
        let props = LecternLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
        updateLecternState(false, args.block0, args.position, args.world, props)
        return barSuccess
  barPass

proc lecternBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  # Check if it's a book
  if args.itemStack.stack.item.registryKey.contains("book"):
    let t4 = args.world.getBlockEntity(args.position)
    if t4.isSome:
      let lectern = t4.unsafeGet.asType(LecternBlockEntity)
      if lectern.isSome:
        if lectern.unsafeGet.book.isEmpty():
          let book = args.itemStack.stack.splitUnlessCreative(args.player.gamemode(), 1'u8)
          lectern.unsafeGet.asInventory().setStack(0, book)
          let props = LecternLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
          updateLecternState(true, args.block0, args.position, args.world, props)
          return barSuccess
  barPass

proc lecternBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let t7 = args.world.getBlockEntity(args.position)
  if t7.isSome:
    let lectern = t7.unsafeGet.asType(LecternBlockEntity)
    if lectern.isSome:
      let book = lectern.unsafeGet.asInventory().removeStack(0)
      if not book.isEmpty():
        # Drop the book item
        args.world.spawnItem(Vector3[float64](x: float64(args.position.vec.x) + 0.5, y: float64(args.position.vec.y) + 0.5,
          z: float64(args.position.vec.z) + 0.5), book)

proc lecternBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let t10 = args.world.getBlockEntity(args.position)
  if t10.isSome:
    let lectern = t10.unsafeGet.asType(LecternBlockEntity)
    if lectern.isSome:
      let book = lectern.unsafeGet.book
      if book.isEmpty():
        return some(0'u8)
      let page = float32(lectern.unsafeGet.page)
      var pages = 1.0'f32
      let written = book.getDataComponent(WrittenBookContentImpl)
      if written[0]:
        pages = float32(max(written[1].pages.len, 1))
      else:
        let writable = book.getDataComponent(WritableBookContentImpl)
        if writable[0]:
          pages = float32(max(writable[1].pages.len, 1))
      let output: float32 = if pages > 1.0'f32: 1.0'f32 + 14.0'f32 * page / (pages - 1.0'f32) else: 15.0'f32
      return some(uint8(floor(output)))
  some(0'u8)

proc newLecternBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = lecternBlockPlaced_BlockBehaviour
  result.onPlaceImpl = lecternBlockOnPlace_BlockBehaviour
  result.normalUseImpl = lecternBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = lecternBlockUseWithItem_BlockBehaviour
  result.brokenImpl = lecternBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = lecternBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksLectern*(r: BlockRegistry) =
  r.register("minecraft:lectern", newLecternBlock())
