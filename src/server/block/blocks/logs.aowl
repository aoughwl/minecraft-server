## Port of pumpkin/src/block/blocks/logs.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  LogProperties = PaleOakWoodLikeProperties
  LogBlock* = object



proc logBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc newLogBlock*(): BlockBehaviour

proc logBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var logProps = LogProperties.defaultFor(args.block0)
  logProps.axis = args.direction.toAxis()
  logProps.toStateId(args.block0)

proc newLogBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = logBlockOnPlace_BlockBehaviour

proc registerBlocksLogs*(r: BlockRegistry) =
  r.registerTag("minecraft:logs", newLogBlock())

