## Port of pumpkin/src/block/blocks/magma.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  MagmaBlock* = object



proc magmaBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs)
proc newMagmaBlock*(): BlockBehaviour

proc magmaBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs) =
  # Only living entities take damage
  let t1 = args.entity.getLivingEntity()
  if not (t1.isSome):
    return
  let livingEntity = t1.unsafeGet
  let ent = args.entity.getEntity()
  # Don't damage if sneaking
  if ent.isSneaking():
    return
  # Fire immune entities don't take damage
  if (ent.entityType.fireImmune or ent.fireImmune):
    return
  let t2 = block:
    let boots = livingEntity.entityEquipment.get(EquipmentSlot.FEET)
    (boots.getEnchantmentLevel(Enchantment.FROST_WALKER) != 0)
  let hasFrostWalker = t2
  if hasFrostWalker:
    return
  if livingEntity.getEffect(StatusEffect.FIRE_RESISTANCE).isSome():
    return
  # Apply damage
  args.entity.damage(args.entity, 1.0, DamageType.HOT_FLOOR)

proc newMagmaBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityStepImpl = magmaBlockOnEntityStep_BlockBehaviour

proc registerBlocksMagma*(r: BlockRegistry) =
  r.register("minecraft:magma_block", newMagmaBlock())

