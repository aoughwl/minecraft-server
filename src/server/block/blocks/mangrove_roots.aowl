## Port of pumpkin/src/block/blocks/mangrove_roots.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  MangroveRootsBlock* = object



proc mangroveRootsBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc mangroveRootsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newMangroveRootsBlock*(): BlockBehaviour

proc mangroveRootsBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = MangroveRootsLikeProperties.defaultFor(args.block0)
  props.waterlogged = args.replacing.waterSource()
  props.toStateId(args.block0)

proc mangroveRootsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let props = MangroveRootsLikeProperties.fromStateId(args.stateId, args.block0)
  if props.waterlogged:
    args.world.scheduleFluidTick(Fluid.WATER, args.position, uint8(Fluid.WATER.flowSpeed), tpNormal)
  props.toStateId(args.block0)

proc newMangroveRootsBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = mangroveRootsBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = mangroveRootsBlockGetStateForNeighborUpdate_BlockBehaviour

proc registerBlocksMangroveRoots*(r: BlockRegistry) =
  r.register("minecraft:mangrove_roots", newMangroveRootsBlock())

