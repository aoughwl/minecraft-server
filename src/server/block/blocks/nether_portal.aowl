## Port of pumpkin/src/block/blocks/nether_portal.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  NetherPortalBlock* = object



proc getPortalTime*(world: BlockWorld, entity: BlockActor): uint32
proc netherPortalBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc netherPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc netherPortalBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newNetherPortalBlock*(): BlockBehaviour

proc getPortalTime*(world: BlockWorld, entity: BlockActor): uint32 =
  let entityType = entity.getEntity().entityType
  let levelInfo = world.levelInfo
  if (entityType.id == EntityType.PLAYER.id):
    let id = entityType.id
    (world.getPlayerById(entity.getEntity().entityId)).mapOr(80, R2A_MANUAL("closure |player| t1"))
  else:
    0'u32

proc netherPortalBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let directionAxis = args.direction.toAxis()
  let stateAxis = NetherPortalLikeProperties.fromStateId(args.stateId, blockNetherPortal()).axis
  # Convert HorizontalAxis to Axis for comparison
  let t2 = block:
    case stateAxis
    of HorizontalAxis.X:
      Axis.X
    of HorizontalAxis.Z:
      Axis.Z
  let stateAxisFull: Axis = t2
  # Vanilla logic: keep portal if direction is horizontal AND different from portal axis
  let isHorizontalAndDifferent = (args.direction.isHorizontal() and (directionAxis != stateAxisFull))
  let t3 = NetherPortal.getOnAxis(args.world, args.position, stateAxis)
  var t4 = false
  if t3.isSome:
    let e = t3.unsafeGet
    t4 = e.wasAlreadyValid()
  if (isHorizontalAndDifferent or ((args.neighborStateId == args.stateId) or t4)):
    return args.stateId
  blockAir().defaultState.id

proc netherPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let t5 = block:
    if (args.world.dimension.minecraftName == Dimension.THE_NETHER.minecraftName):
      args.server.getWorldFromDimension(Dimension.OVERWORLD)
    else:
      args.server.getWorldFromDimension(Dimension.THE_NETHER)
  let targetWorld = t5
  if Arc.ptrEq(targetWorld, args.world):
    return
  discard
  let portalDelay = getPortalTime(args.world, args.entity)
  args.entity.getEntity().tryUsePortal(portalDelay, targetWorld, args.position)

proc netherPortalBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  # Remove from POI storage when portal block is replaced
  args.world.portalPoi.remove(args.position)

proc newNetherPortalBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.getStateForNeighborUpdateImpl = netherPortalBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onEntityCollisionImpl = netherPortalBlockOnEntityCollision_BlockBehaviour
  result.onStateReplacedImpl = netherPortalBlockOnStateReplaced_BlockBehaviour

proc registerBlocksNetherPortal*(r: BlockRegistry) =
  r.register("minecraft:nether_portal", newNetherPortalBlock())

