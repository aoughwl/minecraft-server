## Port of pumpkin/src/block/blocks/nether_portal.rs
##
## Upstream's `get_portal_time` only feeds `try_use_portal`'s `_portal_delay`, which that ignores (the delay is
## `PortalType::get_portal_transition_time`), so the collision passes 0 and the function is not ported. The target world is
## named by its dimension; `BlockActor.tryUsePortal0` (worldhooks.aowl) finds it and does nothing for the same world.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../world/portal/nether

type
  NetherPortalBlock* = object

proc netherPortalBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let directionAxis = args.direction.toAxis()
  let stateAxis = NetherPortalLikeProperties.fromStateId(args.stateId, blockNetherPortal()).axis
  # Convert HorizontalAxis to Axis for comparison.
  let stateAxisFull: BlockAxis = if stateAxis == HorizontalAxis.X: BlockAxis.X else: BlockAxis.Z
  # Vanilla logic: keep the portal if the direction is horizontal and different from the portal's axis.
  let isHorizontalAndDifferent = args.direction.isHorizontal() and directionAxis != stateAxisFull
  if isHorizontalAndDifferent or args.neighborStateId == args.stateId:
    return args.stateId
  let portal = getOnAxis(args.world, args.position, stateAxis)
  if portal.isSome and portal.unsafeGet.wasAlreadyValid():
    return args.stateId
  blockAir().defaultState.id

proc netherPortalBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let target = if args.world.dimension.minecraftName == "minecraft:the_nether": "minecraft:overworld" else: "minecraft:the_nether"
  if args.entity.tryUsePortal0 != nil:
    args.entity.tryUsePortal0(0'u32, target, args.position)

proc netherPortalBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  # Remove from the POI storage when a portal block is replaced.
  if args.world.portalPoiRemove0 != nil:
    args.world.portalPoiRemove0(args.position)

proc newNetherPortalBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.getStateForNeighborUpdateImpl = netherPortalBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onEntityCollisionImpl = netherPortalBlockOnEntityCollision_BlockBehaviour
  result.onStateReplacedImpl = netherPortalBlockOnStateReplaced_BlockBehaviour

proc registerBlocksNetherPortal*(r: BlockRegistry) =
  r.register("minecraft:nether_portal", newNetherPortalBlock())
