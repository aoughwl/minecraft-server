## Port of pumpkin/src/block/blocks/note.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import redstone/redstonemod


type
  NoteBlock* = object



proc playNote*(props: NoteBlockLikeProperties, world: BlockWorld, pos: BlockPos)
proc getNotePitch*(note: uint16): float32
proc getStateWithInstrument*(world: BlockWorld, pos: BlockPos, state: BlockStateId, blockRef: Block): BlockStateId
proc noteBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc noteBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc noteBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc noteBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool
proc noteBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc noteBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newNoteBlock*(): BlockBehaviour
proc convertInstrumentToSound*(instrument: NoteblockInstrument): Sound
proc isBaseBlock*(instrument: NoteblockInstrument): bool

proc playNote*(props: NoteBlockLikeProperties, world: BlockWorld, pos: BlockPos) =
  if ((not isBaseBlock(props.instrument)) or world.getBlockState(pos.up()).isAir()):
    world.addSyncedBlockEvent(pos, 0, 0)

proc getNotePitch*(note: uint16): float32 =
  ((((float32(note) - 12.0)) / 12.0)).exp2()

proc getStateWithInstrument*(world: BlockWorld, pos: BlockPos, state: BlockStateId, blockRef: Block): BlockStateId =
  let upperInstrument = world.getBlockState(pos.up()).instrument
  var noteProps = NoteBlockLikeProperties.fromStateId(state, blockRef)
  if (not isBaseBlock(upperInstrument)):
    noteProps.instrument = upperInstrument
    return noteProps.toStateId(blockRef)
  let belowInstrument = world.getBlockState(pos.down()).instrument
  let t1 = block:
    if isBaseBlock(belowInstrument):
      belowInstrument
    else:
      NoteblockInstrument.Harp
  let belowInstrument1 = t1
  noteProps.instrument = belowInstrument1
  noteProps.toStateId(blockRef)

proc noteBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let blockState = args.world.getBlockState(args.position)
  var noteProps = NoteBlockLikeProperties.fromStateId(blockState.id, args.block0)
  let powered = blockReceivesRedstonePower(args.world, args.position)
  # check if powered state changed
  if (noteProps.powered != powered):
    if powered:
      playNote(noteProps, args.world, args.position)
    noteProps.powered = powered
    discard args.world.setBlockState(args.position, noteProps.toStateId(args.block0), BfNotifyAll)

proc noteBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockState = args.world.getBlockState(args.position)
  var noteProps = NoteBlockLikeProperties.fromStateId(blockState.id, args.block0)
  noteProps.note = (((noteProps.note + 1)) mod 25)
  discard args.world.setBlockState(args.position, noteProps.toStateId(args.block0), BfNotifyAll)
  playNote(noteProps, args.world, args.position)
  args.player.incrementStat(scCustom, int32(csTuneNoteblock), 1)
  barSuccess

proc noteBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  # TODO
  barPassToDefaultBlockAction

proc noteBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  let blockState = args.world.getBlockState(args.position)
  let noteProps = NoteBlockLikeProperties.fromStateId(blockState.id, args.block0)
  let instrument = noteProps.instrument
  let t2 = block:
    if isBaseBlock(instrument):
      # checks if can be pitched
      getNotePitch(uint16(noteProps.note))
    else:
      1.0
  let pitch = t2
  # check hasCustomSound
  args.world.playSoundRaw(uint16(convertInstrumentToSound(instrument)), scRecords, args.position.toF64(), 3.0, pitch)
  true

proc noteBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  getStateWithInstrument(args.world, args.position, blockNoteBlock().defaultState.id, args.block0)

proc noteBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.direction.toAxis() == Axis.Y):
    return getStateWithInstrument(args.world, args.position, args.stateId, args.block0)
  args.stateId

proc newNoteBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onNeighborUpdateImpl = noteBlockOnNeighborUpdate_BlockBehaviour
  result.normalUseImpl = noteBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = noteBlockUseWithItem_BlockBehaviour
  result.onSyncedBlockEventImpl = noteBlockOnSyncedBlockEvent_BlockBehaviour
  result.onPlaceImpl = noteBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = noteBlockGetStateForNeighborUpdate_BlockBehaviour

proc convertInstrumentToSound*(instrument: NoteblockInstrument): Sound =
  case instrument
  of NoteblockInstrument.Harp:
    sdBlockNoteBlockHarp
  of NoteblockInstrument.Basedrum:
    sdBlockNoteBlockBasedrum
  of NoteblockInstrument.Snare:
    sdBlockNoteBlockSnare
  of NoteblockInstrument.Hat:
    sdBlockNoteBlockHat
  of NoteblockInstrument.Bass:
    sdBlockNoteBlockBass
  of NoteblockInstrument.Flute:
    sdBlockNoteBlockFlute
  of NoteblockInstrument.Bell:
    sdBlockNoteBlockBell
  of NoteblockInstrument.Guitar:
    sdBlockNoteBlockGuitar
  of NoteblockInstrument.Chime:
    sdBlockNoteBlockChime
  of NoteblockInstrument.Xylophone:
    sdBlockNoteBlockXylophone
  of NoteblockInstrument.IronXylophone:
    sdBlockNoteBlockIronXylophone
  of NoteblockInstrument.CowBell:
    sdBlockNoteBlockCowBell
  of NoteblockInstrument.Didgeridoo:
    sdBlockNoteBlockDidgeridoo
  of NoteblockInstrument.Bit:
    sdBlockNoteBlockBit
  of NoteblockInstrument.Banjo:
    sdBlockNoteBlockBanjo
  of NoteblockInstrument.Pling:
    sdBlockNoteBlockPling
  of NoteblockInstrument.Zombie:
    sdBlockNoteBlockImitateZombie
  of NoteblockInstrument.Skeleton:
    sdBlockNoteBlockImitateSkeleton
  of NoteblockInstrument.Creeper:
    sdBlockNoteBlockImitateCreeper
  of NoteblockInstrument.Dragon:
    sdBlockNoteBlockImitateEnderDragon
  of NoteblockInstrument.WitherSkeleton:
    sdBlockNoteBlockImitateWitherSkeleton
  of NoteblockInstrument.Piglin:
    sdBlockNoteBlockImitatePiglin
  of NoteblockInstrument.CustomHead:
    sdUiButtonClick
  of NoteblockInstrument.Trumpet:
    sdBlockNoteBlockTrumpet
  of NoteblockInstrument.TrumpetExposed:
    sdBlockNoteBlockTrumpetExposed
  of NoteblockInstrument.TrumpetOxidized:
    sdBlockNoteBlockTrumpetOxidized
  of NoteblockInstrument.TrumpetWeathered:
    sdBlockNoteBlockTrumpetWeathered

proc isBaseBlock*(instrument: NoteblockInstrument): bool =
  ((instrument == NoteblockInstrument.Harp or instrument == NoteblockInstrument.Basedrum or instrument == NoteblockInstrument.Snare or instrument == NoteblockInstrument.Hat or instrument == NoteblockInstrument.Bass or instrument == NoteblockInstrument.Flute or instrument == NoteblockInstrument.Bell or instrument == NoteblockInstrument.Guitar or instrument == NoteblockInstrument.Chime or instrument == NoteblockInstrument.Xylophone or instrument == NoteblockInstrument.IronXylophone or instrument == NoteblockInstrument.CowBell or instrument == NoteblockInstrument.Didgeridoo or instrument == NoteblockInstrument.Bit or instrument == NoteblockInstrument.Banjo))

proc registerBlocksNote*(r: BlockRegistry) =
  r.register("minecraft:note_block", newNoteBlock())

