## Port of pumpkin/src/block/blocks/piston/piston.rs
## `PistonBlock::is_movable`, `PistonProps` and the handler are in pistonmod.aowl (exported from here); `PistonHeadProperties` is
## `PistonHeadLikeProperties`. `moved_blocks_map` is a `FxHashMap` upstream, walked in hash order; it is a list in insertion order
## here, so the order of the writes that clear the old positions is the order the blocks were found in.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../redstone/redstonemod
import ../../entities/piston
import pistonmod
export pistonmod

type
  PistonBlock* = object

proc pistonBlockIds*(): seq[BlockId] =
  @[blockPiston().id, blockStickyPiston().id]

proc shouldExtend*(world: BlockWorld, blockPos: BlockPos, pistonDir: BlockDirection): bool =
  let all = blockDirectionAll()
  for dir in all:
    let neighborPos = blockPos.offset(dir.toOffset())
    let (blockRef, state) = world.getBlockAndState(neighborPos)
    # Pistons can't be powered from the same direction as they are facing
    if dir == pistonDir or (not isEmittingRedstonePower(blockRef, state, world, neighborPos, dir)):
      continue
    return true
  let neighborPos1 = blockPos.offset(BlockDirection.Down.toOffset())
  let (blockRef2, state3) = world.getBlockAndState(neighborPos1)
  if isEmittingRedstonePower(blockRef2, state3, world, blockPos, BlockDirection.Down):
    return true
  let all2 = blockDirectionAll()
  for dir in all2:
    let neighborPos4 = blockPos.up().offset(dir.toOffset())
    let (blockRef5, state6) = world.getBlockAndState(neighborPos4)
    if dir == BlockDirection.Down or (not isEmittingRedstonePower(blockRef5, state6, world, neighborPos4, dir)):
      continue
    return true
  false

proc tryMove*(world: BlockWorld, blockRef: Block, blockPos: BlockPos) =
  let state = world.getBlockState(blockPos)
  let props = PistonProps.fromStateId(state.id, blockRef)
  let dir = props.facing.toBlockDirection()
  let shouldExtent = shouldExtend(world, blockPos, dir)
  if shouldExtent and (not props.extended):
    if newPistonHandler(world, blockPos, dir, true).calculatePush():
      world.addSyncedBlockEvent(blockPos, 0'u8, dir.toIndex())
  elif (not shouldExtent) and props.extended:
    let newPos = blockPos.offsetDir(dir.toOffset(), 2)
    let (newBlock, newState) = world.getBlockAndStateId(newPos)
    var kind0 = 1'u8
    if sameBlock(newBlock, blockMovingPiston()):
      let newProps = MovingPistonLikeProperties.fromStateId(newState, newBlock)
      if newProps.facing == props.facing:
        let entity = world.getBlockEntity(newPos)
        if entity.isSome:
          let piston = asType(entity.unsafeGet, PistonBlockEntity)
          if piston.isNone:
            rustPanic("Block entity at MOVING_PISTON should be PistonBlockEntity")
          if piston.unsafeGet.extending and piston.unsafeGet.currentProgress < 0.5'f32:
            # TODO: more stuff...
            # Piston reduced too quickly, if its a stick piston no blocks will be dragged
            kind0 = 2'u8
    world.addSyncedBlockEvent(blockPos, kind0, dir.toIndex())

type MovedEntry = object
  pos: BlockPos
  state: BlockState

proc removeMoved(entries: var seq[MovedEntry], pos: BlockPos) =
  var kept: seq[MovedEntry] = @[]
  for e in entries:
    if e.pos != pos:
      kept.add(e)
  entries = kept

proc movePiston*(world: BlockWorld, dir: BlockDirection, blockPos: BlockPos, extend: bool, sticky: bool): bool =
  let extendedPos = blockPos.offset(dir.toOffset())
  if (not extend) and sameBlock(world.getBlock(extendedPos), blockPistonHead()):
    discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfForceState)
  var handler = newPistonHandler(world, blockPos, dir, extend)
  if not handler.calculatePush():
    return false
  var movedBlocksMap: seq[MovedEntry] = @[]
  let movedBlocks: seq[BlockPos] = handler.movedBlocks
  var movedBlockStates: seq[BlockState] = @[]
  for movedPos in movedBlocks:
    let blockState = world.getBlockState(movedPos)
    movedBlockStates.add(blockState)
    movedBlocksMap.removeMoved(movedPos)
    movedBlocksMap.add(MovedEntry(pos: movedPos, state: blockState))
  let brokenBlocks: seq[BlockPos] = handler.brokenBlocks
  var affectedBlockStates: seq[BlockState] = @[]
  let moveDirection = if extend: dir else: dir.opposite()
  var bi = brokenBlocks.len - 1
  while bi >= 0:
    let brokenBlockPos = brokenBlocks[bi]
    let blockState1 = world.getBlockState(brokenBlockPos)
    discard world.breakBlock(brokenBlockPos, nil, BfNotifyListeners or BfForceState)
    affectedBlockStates.add(blockState1)
    bi -= 1
  for index in 0 ..< movedBlocks.len:
    let movedBlockPos = movedBlocks[movedBlocks.len - 1 - index]
    let blockState2 = world.getBlockState(movedBlockPos)
    let targetPos = movedBlockPos.offset(moveDirection.toOffset())
    movedBlocksMap.removeMoved(targetPos)
    var props = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
    props.facing = dir.toFacing()
    let state = props.toStateId(blockMovingPiston())
    discard world.setBlockState(targetPos, state, BfMoved)
    let stateIndex = movedBlocks.len - 1 - index
    if stateIndex >= 0 and stateIndex < movedBlockStates.len:
      world.addBlockEntity(newPistonBlockEntity(targetPos, movedBlockStates[stateIndex], dir.toFacing().toBlockDirection(),
        extend, false))
    affectedBlockStates.add(blockState2)
  if extend:
    let pistionType = if sticky: PistonType.Sticky else: PistonType.Normal
    var props3 = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
    props3.facing = dir.toFacing()
    props3.`type` = pistionType
    movedBlocksMap.removeMoved(extendedPos)
    discard world.setBlockState(extendedPos, props3.toStateId(blockMovingPiston()), BfMoved)
    var props4 = PistonHeadLikeProperties.defaultFor(blockPistonHead())
    props4.facing = dir.toFacing()
    props4.`type` = pistionType
    world.addBlockEntity(newPistonBlockEntity(extendedPos, BlockState.fromId(props4.toStateId(blockPistonHead())),
      dir.toFacing().toBlockDirection(), true, true))
  let airState = blockAir().defaultState.id
  for e in movedBlocksMap:
    discard world.setBlockState(e.pos, airState, BfNotifyListeners or BfForceState or BfMoved)
  for e in movedBlocksMap:
    world.blockRegistry.prepare(world, e.pos, Block.fromStateId(e.state.id), e.state.id, BfNotifyListeners)
    world.updateNeighbors(e.pos, none[BlockDirection]())
    world.blockRegistry.prepare(world, e.pos, blockAir(), airState, BfNotifyListeners)
  for i in 0 ..< brokenBlocks.len:
    let brokenBlockPos = brokenBlocks[brokenBlocks.len - 1 - i]
    if i < affectedBlockStates.len:
      let affected = affectedBlockStates[i]
      world.blockRegistry.onStateReplaced(world, Block.fromStateId(affected.id), brokenBlockPos, affected.id, false)
      world.blockRegistry.prepare(world, brokenBlockPos, Block.fromStateId(affected.id), affected.id, BfNotifyListeners)
      world.updateNeighbors(brokenBlockPos, none[BlockDirection]())
  var mi = movedBlocks.len - 1
  while mi >= 0:
    world.updateNeighbors(movedBlocks[mi], none[BlockDirection]())
    mi -= 1
  if extend:
    world.updateNeighbors(extendedPos, none[BlockDirection]())
  true

proc pistonBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = PistonProps.defaultFor(args.block0)
  props.extended = false
  props.facing = getFacing(BlockActor(args.player)).opposite()
  props.toStateId(args.block0)

proc pistonBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let props = PistonProps.fromStateId(args.state.id, args.block0)
  let pos = args.position.offset(props.facing.toBlockDirection().toOffset())
  let (blockToCheck, blockToCheckStateId) = args.world.getBlockAndStateId(pos)
  if sameBlock(blockToCheck, blockPistonHead()):
    let headProps = PistonHeadLikeProperties.fromStateId(blockToCheckStateId, blockToCheck)
    if headProps.facing.toBlockDirection() != props.facing.toBlockDirection():
      # Then this is a head of some other piston.
      return
    discard args.world.breakBlock(pos, nil, BfSkipDrops)
  elif sameBlock(blockToCheck, blockMovingPiston()):
    discard args.world.breakBlock(pos, nil, BfSkipDrops)

proc pistonBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if args.oldStateId == args.stateId:
    return
  tryMove(args.world, args.block0, args.position)

proc pistonBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  tryMove(args.world, args.block0, args.position)

proc pistonBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  let blockRef = args.block0
  let world = args.world
  let pos = args.position
  let kind0 = args.kind0
  let data = args.data
  let state = world.getBlockState(pos)
  var props = PistonProps.fromStateId(state.id, blockRef)
  let dir = props.facing.toBlockDirection()
  let sticky = sameBlock(blockRef, blockStickyPiston())
  let shouldExtendNow = shouldExtend(world, pos, dir)
  if shouldExtendNow and (kind0 == 1'u8 or kind0 == 2'u8):
    props.extended = true
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyListeners)
    return false
  # This may prevent it when something happens in the one tick before this function got called
  if (not shouldExtendNow) and kind0 == 0'u8:
    return false
  # Extend Piston
  if kind0 == 0'u8:
    if not movePiston(world, dir, pos, true, sticky):
      return false
    props.extended = true
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyAll or BfMoved)
    # Play piston extend sound
    let pitch = rng().randomRange(0.6'f32 .. 0.85'f32)
    world.playSoundFine(sdBlockPistonExtend, scBlocks, pos.toCenteredF64(), 0.5'f32, pitch)
    return true
  # Reduce Piston
  let extendedPos = pos.offset(dir.toOffset())
  let extendedEntity = world.getBlockEntity(extendedPos)
  if extendedEntity.isSome:
    let piston = asType(extendedEntity.unsafeGet, PistonBlockEntity)
    if piston.isSome:
      piston.unsafeGet.finish(world)
  var props1 = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
  props1.facing = dir.toFacing()
  props1.`type` = if sticky: PistonType.Sticky else: PistonType.Normal
  discard world.setBlockState(pos, props1.toStateId(blockMovingPiston()), BfForceState)
  var props2 = PistonProps.defaultFor(blockRef)
  props2.facing = BlockDirection.byIndex(int(data and 7'u8)).toFacing()
  world.addBlockEntity(newPistonBlockEntity(pos, BlockState.fromId(props2.toStateId(blockRef)), dir, false, true))
  world.updateNeighbors(pos, none[BlockDirection]())
  if sticky:
    let pullPos = pos.offsetDir(dir.toOffset(), 2)
    let (blockRef3, state4) = world.getBlockAndState(pullPos)
    var pistonPiece = false
    if sameBlock(blockRef3, blockMovingPiston()):
      let entity = world.getBlockEntity(pullPos)
      if entity.isSome:
        let piston = asType(entity.unsafeGet, PistonBlockEntity)
        if piston.isSome and piston.unsafeGet.facing == dir and piston.unsafeGet.extending:
          piston.unsafeGet.finish(world)
          pistonPiece = true
    if not pistonPiece:
      if kind0 == 1'u8 and (not state4.isAir()) and isMovable(blockRef3, state4, dir, false, dir) and
          (state4.pistonBehavior == pbNormal or sameBlock(blockRef3, blockPiston()) or
          sameBlock(blockRef3, blockStickyPiston())):
        discard movePiston(world, dir, pos, false, sticky)
      else:
        # remove
        discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfNotifyAll)
  else:
    # remove
    discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfNotifyAll)
  # Play piston contract sound
  let pitch5 = rng().randomRange(0.6'f32 .. 0.75'f32)
  world.playSoundFine(sdBlockPistonContract, scBlocks, pos.toCenteredF64(), 0.5'f32, pitch5)
  true

proc newPistonBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = pistonBlockOnPlace_BlockBehaviour
  result.brokenImpl = pistonBlockBroken_BlockBehaviour
  result.placedImpl = pistonBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = pistonBlockOnNeighborUpdate_BlockBehaviour
  result.onSyncedBlockEventImpl = pistonBlockOnSyncedBlockEvent_BlockBehaviour

proc registerBlocksPistonPiston*(r: BlockRegistry) =
  r.registerIds(pistonBlockIds(), newPistonBlock())
