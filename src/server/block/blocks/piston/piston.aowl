proc pistonBlockIds*(): seq[BlockId] =
  @[blockPiston().id, blockStickyPiston().id]

proc isMovable*(blockRef: Block, state: BlockState, dir: BlockDirection, canBreak: bool, pistonDir: BlockDirection): bool =
  # TODO: more checks
  if state.isAir():
    return true
  # Vanilla hardcoded them aswell
  if ((blockRef == blockObsidian()) or (((blockRef == blockCryingObsidian()) or (blockRef == blockRespawnAnchor())) or (blockRef == blockReinforcedDeepslate()))):
    return false
  if ((blockRef == blockPiston()) or (blockRef == blockStickyPiston())):
    let props = PistonProps.fromStateId(state.id, blockRef)
    # Extended pistons are immovable. Non-extended pistons are movable
    return (not props.extended)
  if (state.hardness == (-1.0)):
    return false
  case state.pistonBehavior
  of PistonBehavior.Destroy:
    return canBreak
  of PistonBehavior.Block:
    return false
  of PistonBehavior.PushOnly:
    return (dir == pistonDir)
  else:
    discard
  (not hasBlockBlockEntity(blockRef))

proc pistonBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = PistonProps.defaultFor(args.block0)
  props.extended = false
  props.facing = args.player.getEntity().getFacing().opposite()
  props.toStateId(args.block0)

proc pistonBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let props = PistonProps.fromStateId(args.state.id, args.block0)
  let pos = args.position.offset(props.facing.toBlockDirection().toOffset())
  let (blockToCheck, blockToCheckStateId) = args.world.getBlockAndStateId(pos)
  if (blockPistonHead() == blockToCheck):
    let headProps = PistonHeadProperties.fromStateId(blockToCheckStateId, blockToCheck)
    if ((headProps.facing.toBlockDirection() != props.facing.toBlockDirection())) and (blockPistonHead() == blockToCheck):
      # Then this is a head of some other piston.
      return
    discard args.world.breakBlock(pos, nil, BfSkipDrops)
  elif (blockMovingPiston() == blockToCheck):
    discard args.world.breakBlock(pos, nil, BfSkipDrops)

proc pistonBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (args.oldStateId == args.stateId):
    return
  tryMove(args.world, args.block0, args.position)

proc pistonBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  tryMove(args.world, args.block0, args.position)

proc pistonBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  let (blockRef, world, pos, kind0, data) = (args.block0, args.world, args.position, args.kind0, args.data)
  let state = world.getBlockState(pos)
  var props = PistonProps.fromStateId(state.id, blockRef)
  let dir = props.facing.toBlockDirection()
  # I don't think this is optimal ?
  let sticky = (blockRef == blockStickyPiston())
  let shouldExtend = shouldExtend(world, pos, dir)
  if shouldExtend and (((kind0 == 1) or (kind0 == 2))):
    props.extended = true
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyListeners)
    return false
  # This may prevents when something happens in the one tick before this function got called
  if (not shouldExtend) and (kind0 == 0):
    return false
  # Extend Piston
  if (kind0 == 0):
    if (not movePiston(world, dir, pos, true, sticky)):
      return false
    props.extended = true
    discard world.setBlockState(pos, props.toStateId(blockRef), (BfNotifyAll or BfMoved))
    # Play piston extend sound
    let pitch = rng().randomRange(0.6'f32 ..< 0.85)
    world.playSoundFine(sdBlockPistonExtend, scBlocks, pos.toCenteredF64(), 0.5, pitch)
    return true
  # Reduce Piston
  let extendedPos = pos.offset(dir.toOffset())
  block chain3:
    let t1 = world.getBlockEntity(extendedPos)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = asType(t1.unsafeGet, PistonBlockEntity)
      if t2.isSome:
        let piston = t2.unsafeGet
        t2.unsafeGet.finish(world)
  var props1 = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
  props1.facing = dir.toFacing()
  let t4 = block:
    if sticky:
      PistonType.Sticky
    else:
      PistonType.Normal
  props1.kind0 = t4
  discard world.setBlockState(pos, props1.toStateId(blockMovingPiston()), BfForceState)
  var props2 = PistonProps.defaultFor(blockRef)
  props2.facing = BlockDirection.byIndex(int(((data and 7)))).get().toFacing()
  world.addBlockEntity(PistonBlockEntity(position: pos, facing: dir, pushedBlockState: BlockState.fromId(props2.toStateId(blockRef)), currentProgress: 0.0, lastProgress: 0.0, extending: false, source: true))
  world.updateNeighbors(pos, none[BlockDirection]())
  if sticky:
    let pullPos = pos.offsetDir(dir.toOffset(), 2)
    let (blockRef3, state4) = world.getBlockAndState(pullPos)
    let t5 = block:
      block chain8:
        if (blockRef3 == blockMovingPiston()):
          let t6 = world.getBlockEntity(pullPos)
          if t6.isSome:
            let entity = t6.unsafeGet
            let t7 = asType(t6.unsafeGet, PistonBlockEntity)
            if t7.isSome:
              let piston = t7.unsafeGet
              if (t7.unsafeGet.facing == dir):
                if t7.unsafeGet.extending:
                  t7.unsafeGet.finish(world)
                  true
                  break chain8
        false
    let pistonPiece = t5
    if (not pistonPiece):
      if (kind0 == 1) and (not state4.isAir()) and isMovable(blockRef3, state4, dir, false, dir) and ((((state4.pistonBehavior == PistonBehavior.Normal) or (blockRef3 == blockPiston())) or (blockRef3 == blockStickyPiston()))):
        movePiston(world, dir, pos, false, sticky)
      else:
        # remove
        discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfNotifyAll)
  else:
    # remove
    discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfNotifyAll)
  # Play piston contract sound
  let pitch5 = rng().randomRange(0.6'f32 ..< 0.75)
  world.playSoundFine(sdBlockPistonContract, scBlocks, pos.toCenteredF64(), 0.5, pitch5)
  true

proc newPistonBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = pistonBlockOnPlace_BlockBehaviour
  result.brokenImpl = pistonBlockBroken_BlockBehaviour
  result.placedImpl = pistonBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = pistonBlockOnNeighborUpdate_BlockBehaviour
  result.onSyncedBlockEventImpl = pistonBlockOnSyncedBlockEvent_BlockBehaviour

proc shouldExtend*(world: BlockWorld, blockPos: BlockPos, pistonDir: BlockDirection): bool =
  let t9 = blockDirectionAll()
  for dir in t9:
    let neighborPos = blockPos.offset(dir.toOffset())
    let (blockRef, state) = world.getBlockAndState(neighborPos)
    # Pistons can't be powered from the same direction as they are facing
    if ((dir == pistonDir) or (not isEmittingRedstonePower(blockRef, state, world, neighborPos, dir))):
      continue
    return true
  let neighborPos1 = blockPos.offset(BlockDirection.Down.toOffset())
  let (blockRef2, state3) = world.getBlockAndState(neighborPos1)
  if isEmittingRedstonePower(blockRef2, state3, world, blockPos, BlockDirection.Down):
    return true
  let t10 = blockDirectionAll()
  for dir in t10:
    let neighborPos4 = blockPos.up().offset(dir.toOffset())
    let (blockRef5, state6) = world.getBlockAndState(neighborPos4)
    if ((dir == BlockDirection.Down) or (not isEmittingRedstonePower(blockRef5, state6, world, neighborPos4, dir))):
      continue
    return true
  false

proc tryMove*(world: BlockWorld, blockRef: Block, blockPos: BlockPos) =
  let state = world.getBlockState(blockPos)
  let props = PistonProps.fromStateId(state.id, blockRef)
  let dir = props.facing.toBlockDirection()
  let shouldExtent = shouldExtend(world, blockPos, dir)
  if shouldExtent and (not props.extended):
    if newPistonHandler(world, blockPos, dir, true).calculatePush():
      world.addSyncedBlockEvent(blockPos, 0, dir.toIndex())
  else:
    if (not shouldExtent) and props.extended:
      let newPos = blockPos.offsetDir(dir.toOffset(), 2)
      let (newBlock, newState) = world.getBlockAndStateId(newPos)
      var kind0 = 1
      if (newBlock == blockMovingPiston()):
        let newProps = MovingPistonLikeProperties.fromStateId(newState, newBlock)
        block chain12:
          if (newProps.facing == props.facing):
            let t11 = world.getBlockEntity(newPos)
            if t11.isSome:
              let entity = t11.unsafeGet
              let piston = asType(t11.unsafeGet, PistonBlockEntity).get()
              if piston.extending and (piston.currentProgress < 0.5):
                # Piston reduced too quickly, if its a stick piston no blocks will be dragged
                R2A_MANUAL_inner_item
      world.addSyncedBlockEvent(blockPos, kind0, dir.toIndex())

proc movePiston*(world: BlockWorld, dir: BlockDirection, blockPos: BlockPos, extend: bool, sticky: bool): bool =
  let extendedPos = blockPos.offset(dir.toOffset())
  if (not extend) and (world.getBlock(extendedPos) == blockPistonHead()):
    discard world.setBlockState(extendedPos, blockAir().defaultState.id, BfForceState)
  var handler = newPistonHandler(world, blockPos, dir, extend)
  if (not handler.calculatePush()):
    return false
  var movedBlocksMap: Table[BlockPos, BlockState] = initTable()
  let movedBlocks: seq[BlockPos] = handler.movedBlocks
  var movedBlockStates: seq[BlockState] = @[]
  for blockPos in movedBlocks:
    let blockState = world.getBlockState(blockPos)
    movedBlockStates.add(blockState)
    movedBlocksMap.insert(blockPos, blockState)
  let brokenBlocks: seq[BlockPos] = handler.brokenBlocks
  var affectedBlockStates: seq[BlockState] = @[]
  let t13 = block:
    if extend:
      dir
    else:
      dir.opposite()
  let moveDirection = t13
  let t14 = brokenBlocks.rev()
  for brokenBlockPos in t14:
    let blockState1 = world.getBlockState(brokenBlockPos)
    discard world.breakBlock(brokenBlockPos, nil, (BfNotifyListeners or BfForceState))
    affectedBlockStates.add(blockState1)
  let t15 = movedBlocks.rev().enumerate()
  for index, movedBlockPos in t15:
    let blockState2 = world.getBlockState(movedBlockPos)
    let targetPos = movedBlockPos.offset(moveDirection.toOffset())
    movedBlocksMap.remove(targetPos)
    var props = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
    props.facing = dir.toFacing()
    let state = props.toStateId(blockMovingPiston())
    discard world.setBlockState(targetPos, state, BfMoved)
    let t16 = movedBlockStates.get(((len(movedBlocks) - 1) - index))
    if t16.isSome:
      let movedState = t16.unsafeGet
      world.addBlockEntity(PistonBlockEntity(position: targetPos, facing: dir.toFacing().toBlockDirection(), pushedBlockState: t16.unsafeGet, currentProgress: 0.0, lastProgress: 0.0, extending: extend, source: false))
    affectedBlockStates.add(blockState2)
  if extend:
    let t17 = block:
      if sticky:
        PistonType.Sticky
      else:
        PistonType.Normal
    let pistionType = t17
    var props3 = MovingPistonLikeProperties.defaultFor(blockMovingPiston())
    props3.facing = dir.toFacing()
    props3.kind0 = pistionType
    movedBlocksMap.remove(extendedPos)
    discard world.setBlockState(extendedPos, props3.toStateId(blockMovingPiston()), BfMoved)
    var props4 = PistonHeadLikeProperties.defaultFor(blockPistonHead())
    props4.facing = dir.toFacing()
    props4.kind0 = pistionType
    world.addBlockEntity(PistonBlockEntity(position: extendedPos, facing: dir.toFacing().toBlockDirection(), pushedBlockState: BlockState.fromId(props4.toStateId(blockPistonHead())), currentProgress: 0.0, lastProgress: 0.0, extending: true, source: true))
  let airState = blockAir().defaultState.id
  let t18 = movedBlocksMap.keys()
  for pos in t18:
    discard world.setBlockState(pos, airState, ((BfNotifyListeners or BfForceState) or BfMoved))
    continue
  for pos, state in movedBlocksMap:
    world.blockRegistry.prepare(world, pos, Block.fromStateId(state.id), state.id, BfNotifyListeners)
    world.updateNeighbors(pos, none[BlockDirection]())
    world.blockRegistry.prepare(world, pos, blockAir(), airState, BfNotifyListeners)
  let t19 = brokenBlocks.rev().enumerate()
  for i, brokenBlockPos in t19:
    let t20 = affectedBlockStates.get(i)
    if t20.isSome:
      let blockState = t20.unsafeGet
      world.blockRegistry.onStateReplaced(world, Block.fromStateId(t20.unsafeGet.id), brokenBlockPos, t20.unsafeGet.id, false)
      world.blockRegistry.prepare(world, brokenBlockPos, Block.fromStateId(t20.unsafeGet.id), t20.unsafeGet.id, BfNotifyListeners)
      world.updateNeighbors(brokenBlockPos, none[BlockDirection]())
  let t21 = movedBlocks.rev()
  for movedBlockPos in t21:
    world.updateNeighbors(movedBlockPos, none[BlockDirection]())
  if extend:
    world.updateNeighbors(extendedPos, none[BlockDirection]())
  true

proc registerBlocksPistonPiston*(r: BlockRegistry) =
  r.registerIds(pistonBlockIds(), newPistonBlock())

