import ../../blockprelude
import piston


type
  MovingPistonProps* = MovingPistonLikeProperties
  PistonExtensionBlock* = object



proc pistonExtensionBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newPistonExtensionBlock*(): BlockBehaviour

proc pistonExtensionBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let props = MovingPistonProps.fromStateId(args.state.id, blockMovingPiston())
  let pos = args.position.offset(props.facing.opposite().toBlockDirection().toOffset())
  let (newBlock, newState) = args.world.getBlockAndStateId(pos)
  if ((blockPiston() == newBlock) or (blockStickyPiston() == newBlock)):
    let props1 = PistonProps.fromStateId(newState, newBlock)
    if props1.extended:
      # TODO: use player
      discard args.world.breakBlock(pos, nil, BfSkipDrops)

proc newPistonExtensionBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.brokenImpl = pistonExtensionBlockBroken_BlockBehaviour

proc registerBlocksPistonPistonExtension*(r: BlockRegistry) =
  r.register("minecraft:moving_piston", newPistonExtensionBlock())

