import ../../blockprelude
import piston


type
  PistonHeadProperties* = PistonHeadLikeProperties
  PistonHeadBlock* = object



proc pistonHeadBlockBroken_BlockBehaviour(args: BrokenArgs)
proc pistonHeadBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newPistonHeadBlock*(): BlockBehaviour

proc pistonHeadBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let props = PistonHeadProperties.fromStateId(args.state.id, blockPistonHead())
  let pos = args.position.offset(props.facing.opposite().toBlockDirection().toOffset())
  let (newBlock, newState) = args.world.getBlockAndStateId(pos)
  if ((blockPiston() == newBlock) or (blockStickyPiston() == newBlock)):
    let props1 = PistonProps.fromStateId(newState, newBlock)
    if props1.extended:
      # TODO: use player
      discard args.world.breakBlock(pos, nil, BfSkipDrops)

proc pistonHeadBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let headStateId = args.world.getBlockStateId(args.position)
  let headProps = PistonHeadProperties.fromStateId(headStateId, blockPistonHead())
  if (not (headProps.facing == Facing.Up)):
    return
  let pistonPos = args.position.offset(headProps.facing.opposite().toBlockDirection().toOffset())
  let pistonBlock = args.world.getBlock(pistonPos)
  if ((blockPiston() == pistonBlock) or (blockStickyPiston() == pistonBlock)):
    let upPos = args.position.offset(headProps.facing.toBlockDirection().toOffset())
    let upperBlock = args.world.getBlock(upPos)
    if (not (upperBlock == blockRedstoneBlock())):
      # Then somebody probably broke the redstone block, try to check if piston should still be extended.
      tryMove(args.world, pistonBlock, pistonPos)

proc newPistonHeadBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.brokenImpl = pistonHeadBlockBroken_BlockBehaviour
  result.onNeighborUpdateImpl = pistonHeadBlockOnNeighborUpdate_BlockBehaviour

proc registerBlocksPistonPistonHead*(r: BlockRegistry) =
  r.register("minecraft:piston_head", newPistonHeadBlock())

