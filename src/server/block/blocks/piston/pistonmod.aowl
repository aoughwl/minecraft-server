## Port of pumpkin/src/block/blocks/piston/mod.rs
## `PistonBlock::is_movable` (piston.rs), `PistonProps` and `has_block_block_entity` (entities/mod.rs) are here: this file needs the
## first and piston.rs needs this one, which two modules cannot do in aowlmony. piston.aowl exports them.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude

const MAX_MOVABLE_BLOCKS: int = 12

type
  PistonProps* = StickyPistonLikeProperties
  PistonHandler* = ref object
    world*: BlockWorld
    posFrom*: BlockPos
    retracted*: bool
    posTo*: BlockPos
    motionDirection*: BlockDirection
    movedBlocks*: seq[BlockPos]
    brokenBlocks*: seq[BlockPos]
    pistonDirection*: BlockDirection

proc hasBlockBlockEntity*(blockRef: Block): bool =
  ## `has_block_block_entity`: `BLOCK_ENTITY_TYPES.contains(&block.name)`, the entity type's name against the block's.
  BLOCK_ENTITY_TYPES.contains(blockRef.name)

proc isMovable*(blockRef: Block, state: BlockState, dir: BlockDirection, canBreak: bool, pistonDir: BlockDirection): bool =
  ## `PistonBlock::is_movable`
  # TODO: more checks
  if state.isAir():
    return true
  # Vanilla hardcoded them aswell
  if sameBlock(blockRef, blockObsidian()) or sameBlock(blockRef, blockCryingObsidian()) or
      sameBlock(blockRef, blockRespawnAnchor()) or sameBlock(blockRef, blockReinforcedDeepslate()):
    return false
  if sameBlock(blockRef, blockPiston()) or sameBlock(blockRef, blockStickyPiston()):
    let props = PistonProps.fromStateId(state.id, blockRef)
    # Extended pistons are immovable. Non-extended pistons are movable
    return not props.extended
  if state.hardness == -1.0'f32:
    return false
  case state.pistonBehavior
  of pbDestroy:
    return canBreak
  of pbBlock:
    return false
  of pbPushOnly:
    return dir == pistonDir
  else:
    discard
  not hasBlockBlockEntity(blockRef)

proc isBlockSticky*(blockRef: Block): bool =
  sameBlock(blockRef, blockSlimeBlock()) or sameBlock(blockRef, blockHoneyBlock())

proc isAdjacentBlockStuck*(state: Block, adjacentState: Block): bool =
  if sameBlock(state, blockHoneyBlock()) and sameBlock(adjacentState, blockSlimeBlock()):
    return false
  if sameBlock(state, blockSlimeBlock()) and sameBlock(adjacentState, blockHoneyBlock()):
    return false
  isBlockSticky(state) or isBlockSticky(adjacentState)

proc newPistonHandler*(world: BlockWorld, pos: BlockPos, dir: BlockDirection, retracted: bool): PistonHandler =
  var motionDirection = dir
  var posTo = pos.offset(dir.toOffset())
  if not retracted:
    motionDirection = dir.opposite()
    posTo = pos.offsetDir(dir.toOffset(), 2)
  PistonHandler(world: world, posFrom: pos, pistonDirection: dir, retracted: retracted, motionDirection: motionDirection,
    posTo: posTo, movedBlocks: @[], brokenBlocks: @[])

proc tryMove*(self: PistonHandler, pos: BlockPos, dir: BlockDirection): bool
proc tryMoveAdjacentBlock*(self: PistonHandler, blockRef: Block, pos: BlockPos): bool

proc calculatePush*(self: PistonHandler): bool =
  self.movedBlocks.setLen(0)
  self.brokenBlocks.setLen(0)
  let (blockRef, blockState) = self.world.getBlockAndState(self.posTo)
  if not isMovable(blockRef, blockState, self.motionDirection, false, self.pistonDirection):
    if self.retracted and blockState.pistonBehavior == pbDestroy:
      self.brokenBlocks.add(self.posTo)
      return true
    return false
  if not self.tryMove(self.posTo, self.motionDirection):
    return false
  for i in 0 ..< self.movedBlocks.len:
    let blockPos = self.movedBlocks[i]
    let blockRef1 = self.world.getBlock(blockPos)
    if isBlockSticky(blockRef1) and (not self.tryMoveAdjacentBlock(blockRef1, blockPos)):
      return false
  true

proc setMovedBlocks*(self: PistonHandler, from0: int, to0: int) =
  var list: seq[BlockPos] = @[]
  var list2: seq[BlockPos] = @[]
  var list3: seq[BlockPos] = @[]
  for i in 0 ..< to0:
    list.add(self.movedBlocks[i])
  for i in (self.movedBlocks.len - from0) ..< self.movedBlocks.len:
    list2.add(self.movedBlocks[i])
  for i in to0 ..< (self.movedBlocks.len - from0):
    list3.add(self.movedBlocks[i])
  self.movedBlocks.setLen(0)
  for p in list:
    self.movedBlocks.add(p)
  for p in list2:
    self.movedBlocks.add(p)
  for p in list3:
    self.movedBlocks.add(p)

proc tryMove*(self: PistonHandler, pos: BlockPos, dir: BlockDirection): bool =
  let (blockRef0, blockState) = self.world.getBlockAndState(pos)
  var blockRef = blockRef0
  if blockState.isAir():
    return true
  if not isMovable(blockRef, blockState, self.motionDirection, false, dir):
    return true
  if pos == self.posFrom:
    return true
  for moved in self.movedBlocks:
    if moved == pos:
      return true
  var i = 1
  if i + self.movedBlocks.len > MAX_MOVABLE_BLOCKS:
    return false
  while isBlockSticky(blockRef):
    let blockPos = pos.offsetDir(self.motionDirection.opposite().toOffset(), int32(i))
    let block2 = blockRef
    let (nextBlock, nextState) = self.world.getBlockAndState(blockPos)
    if nextState.isAir() or (not isAdjacentBlockStuck(block2, nextBlock)) or
        (not isMovable(nextBlock, nextState, self.motionDirection, false, self.motionDirection.opposite())) or
        blockPos == self.posFrom:
      break
    blockRef = nextBlock
    i += 1
    if i + self.movedBlocks.len > MAX_MOVABLE_BLOCKS:
      return false
  var j = 0
  var k = i - 1
  while k >= 0:
    self.movedBlocks.add(pos.offsetDir(self.motionDirection.opposite().toOffset(), int32(k)))
    j += 1
    k -= 1
  var k1 = 1'i32
  while true:
    let blockPos2 = pos.offsetDir(self.motionDirection.toOffset(), k1)
    var found = -1
    for index in 0 ..< self.movedBlocks.len:
      if self.movedBlocks[index] == blockPos2:
        found = index
        break
    if found >= 0:
      let l = found
      self.setMovedBlocks(j, l)
      for m in 0 .. (l + j):
        let blockPos3 = self.movedBlocks[m]
        let blockRef2 = self.world.getBlock(blockPos3)
        if isBlockSticky(blockRef2) and (not self.tryMoveAdjacentBlock(blockRef2, blockPos3)):
          return false
      return true
    let (blockRef3, blockState4) = self.world.getBlockAndState(blockPos2)
    if blockState4.isAir():
      return true
    if (not isMovable(blockRef3, blockState4, self.motionDirection, true, self.motionDirection)) or blockPos2 == self.posFrom:
      return false
    if blockState4.pistonBehavior == pbDestroy:
      self.brokenBlocks.add(blockPos2)
      return true
    if self.movedBlocks.len >= MAX_MOVABLE_BLOCKS:
      return false
    self.movedBlocks.add(blockPos2)
    j += 1
    k1 += 1'i32

proc tryMoveAdjacentBlock*(self: PistonHandler, blockRef: Block, pos: BlockPos): bool =
  let all = blockDirectionAll()
  for direction in all:
    if direction.toAxis() == self.motionDirection.toAxis():
      continue
    let blockPos = pos.offset(direction.toOffset())
    let blockState2 = self.world.getBlock(blockPos)
    if isAdjacentBlockStuck(blockState2, blockRef) and (not self.tryMove(blockPos, direction)):
      return false
  true
