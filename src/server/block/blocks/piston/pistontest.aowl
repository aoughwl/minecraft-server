## The piston blocks (piston.rs, mod.rs, piston_head.rs, piston_extension.rs) and the piston block entity over a `TestWorld`.
## The push limit, sticky neighbours and what is destroyed are worked out by hand from `PistonHandler`; a whole extension and
## retraction is stepped through the synced block event and three block entity ticks, as the world does.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../../blockprelude
import ../../testworld
import ../../entities/[entitiesmod, piston]
import ../redstone/redstone_block
import piston
import piston_head
import piston_extension

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksPistonPiston(result)
  registerBlocksPistonPistonHead(result)
  registerBlocksPistonPistonExtension(result)
  registerBlocksRedstoneRedstoneBlock(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc at(x, y, z: int32): BlockPos = blockPos(x, y, z)

proc pistonState(blockRef: Block; facing: Facing; extended: bool): BlockStateId =
  var props = PistonProps.defaultFor(blockRef)
  props.facing = facing
  props.extended = extended
  props.toStateId(blockRef)

proc nameAt(t: TestWorld; pos: BlockPos): string =
  Block.fromStateId(t.world.getBlockStateId(pos)).name

proc tickBlockEntities(t: TestWorld) =
  ## `tick_block_entities`: a copy, as a tick adds and removes entities.
  var entities: seq[BlockEntity] = @[]
  for _, e in t.world.blockEntities:
    entities.add(e)
  for e in entities:
    e.tick(t.world)

proc row(t: TestWorld; fromX, toX: int32; blockRef: Block) =
  for x in fromX .. toX:
    t.put(at(x, 64'i32, 0'i32), blockRef)

proc handlerFor(t: TestWorld; retracted: bool): PistonHandler =
  newPistonHandler(t.world, at(0'i32, 64'i32, 0'i32), BlockDirection.East, retracted)

proc setupPiston(sticky: bool): TestWorld =
  let t = newTestWorld(newRegistry())
  let b = if sticky: blockStickyPiston() else: blockPiston()
  discard t.world.setBlockState(at(0'i32, 64'i32, 0'i32), pistonState(b, Facing.East, false), BfNotifyAll)
  result = t

proc runEvents(t: TestWorld; pistonBlock: Block; pos: BlockPos; kind, data: uint8): bool =
  t.world.blockRegistry.onSyncedBlockEvent(pistonBlock, t.world, pos, kind, data)

proc pushLimit() =
  # Twelve stones in a row move, thirteen do not.
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 12'i32, blockStone())
    let h = t.handlerFor(true)
    check(h.calculatePush(), "12 blocks can be pushed")
    check(h.movedBlocks.len == 12, "and all 12 are moved")
    check(h.movedBlocks[0] == at(1'i32, 64'i32, 0'i32) and h.movedBlocks[11] == at(12'i32, 64'i32, 0'i32), "in order from the piston")
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 13'i32, blockStone())
    check(not t.handlerFor(true).calculatePush(), "13 blocks cannot")
  # Obsidian is never pushed.
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 1'i32, blockObsidian())
    check(not t.handlerFor(true).calculatePush(), "obsidian blocks the piston")
  # Behind a stone, obsidian stops the line.
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 1'i32, blockStone())
    t.row(2'i32, 2'i32, blockObsidian())
    check(not t.handlerFor(true).calculatePush(), "obsidian at the end stops the line")
  # A flower is destroyed, not moved.
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 1'i32, blockPoppy())
    let h = t.handlerFor(true)
    check(h.calculatePush(), "a poppy does not stop a piston")
    check(h.movedBlocks.len == 0 and h.brokenBlocks.len == 1, "it is broken")
  # Air in front: nothing moves, and it can push.
  block:
    let t = newTestWorld(newRegistry())
    let h = t.handlerFor(true)
    check(h.calculatePush() and h.movedBlocks.len == 0, "nothing to move")

proc stickyBlocks() =
  # A slime block with stone beside it drags the stone along; sticking stops at the other kind of sticky block.
  block:
    let t = newTestWorld(newRegistry())
    t.row(1'i32, 1'i32, blockSlimeBlock())
    t.row(2'i32, 2'i32, blockStone())
    t.put(at(1'i32, 64'i32, 1'i32), blockStone())
    let h = t.handlerFor(true)
    check(h.calculatePush(), "slime pushes")
    check(h.movedBlocks.len == 3, "slime, the stone behind it and the stone beside it")
    check(h.movedBlocks[0] == at(1'i32, 64'i32, 0'i32), "slime first")
    check(h.movedBlocks[1] == at(2'i32, 64'i32, 0'i32), "then the stone in line")
    check(h.movedBlocks[2] == at(1'i32, 64'i32, 1'i32), "then the side stone")
  # Honey does not hold slime.
  check(not isAdjacentBlockStuck(blockHoneyBlock(), blockSlimeBlock()), "honey does not stick to slime")
  check(not isAdjacentBlockStuck(blockSlimeBlock(), blockHoneyBlock()), "slime does not stick to honey")
  check(isAdjacentBlockStuck(blockSlimeBlock(), blockStone()), "slime sticks to stone")
  check(isAdjacentBlockStuck(blockStone(), blockHoneyBlock()), "stone sticks to honey")
  check(not isAdjacentBlockStuck(blockStone(), blockDirt()), "two plain blocks do not")
  # Retracting: a block pulled from two in front moves west, and a slime block pulls the stone behind it.
  block:
    let t = newTestWorld(newRegistry())
    t.row(2'i32, 2'i32, blockStone())
    let h = t.handlerFor(false)
    check(h.calculatePush(), "a sticky piston can pull")
    check(h.movedBlocks.len == 1 and h.movedBlocks[0] == at(2'i32, 64'i32, 0'i32), "the block two ahead")
    check(h.motionDirection == BlockDirection.West, "it moves back toward the piston")

proc movability() =
  let t = newTestWorld(newRegistry())
  let air = BlockState.fromId(blockAir().defaultState.id)
  check(isMovable(blockAir(), air, BlockDirection.East, false, BlockDirection.East), "air is movable")
  check(not isMovable(blockObsidian(), BlockState.fromId(blockObsidian().defaultState.id), BlockDirection.East, false, BlockDirection.East), "obsidian")
  check(not isMovable(blockBedrock(), BlockState.fromId(blockBedrock().defaultState.id), BlockDirection.East, false, BlockDirection.East), "bedrock has hardness -1")
  check(isMovable(blockStone(), BlockState.fromId(blockStone().defaultState.id), BlockDirection.East, false, BlockDirection.East), "stone")
  check(not isMovable(blockChest(), BlockState.fromId(blockChest().defaultState.id), BlockDirection.East, false, BlockDirection.East), "a chest has a block entity")
  check(not isMovable(blockPoppy(), BlockState.fromId(blockPoppy().defaultState.id), BlockDirection.East, false, BlockDirection.East), "a poppy is destroyed, not moved")
  check(isMovable(blockPoppy(), BlockState.fromId(blockPoppy().defaultState.id), BlockDirection.East, true, BlockDirection.East), "unless breaking is allowed")
  check(not isMovable(blockPiston(), BlockState.fromId(pistonState(blockPiston(), Facing.East, true)), BlockDirection.East, false, BlockDirection.East), "an extended piston")
  check(isMovable(blockPiston(), BlockState.fromId(pistonState(blockPiston(), Facing.East, false)), BlockDirection.East, false, BlockDirection.East), "a retracted one")

proc extendAndRetract(sticky: bool) =
  let t = setupPiston(sticky)
  let b = if sticky: blockStickyPiston() else: blockPiston()
  let pos = at(0'i32, 64'i32, 0'i32)
  let front = at(1'i32, 64'i32, 0'i32)
  let beyond = at(2'i32, 64'i32, 0'i32)
  t.put(front, blockStone())
  # Nothing powers it yet: a placed piston asks for no event.
  check(t.events.len == 0, "an unpowered piston stays")
  # A redstone block above powers it; its neighbour update starts the push.
  discard t.world.setBlockState(at(0'i32, 65'i32, 0'i32), blockRedstoneBlock().defaultState.id, BfNotifyAll)
  var asked = false
  for e in t.events:
    if e == "synced 0 5":
      asked = true
  check(asked, "the piston asked for the extension event (type 0, East = 5)")
  check(t.runEvents(b, pos, 0'u8, 5'u8), "the event extends")
  check(PistonProps.fromStateId(t.world.getBlockStateId(pos), b).extended, "the piston is extended")
  check(nameAt(t, front) == "moving_piston", "the head is being drawn out")
  check(nameAt(t, beyond) == "moving_piston", "the stone is moving")
  check(t.world.getBlockEntity(front).isSome and t.world.getBlockEntity(beyond).isSome, "each has an entity")
  t.tickBlockEntities()
  t.tickBlockEntities()
  t.tickBlockEntities()
  check(nameAt(t, front) == "piston_head", "the head has arrived")
  var head = PistonHeadLikeProperties.fromStateId(t.world.getBlockStateId(front), blockPistonHead())
  check(head.facing == Facing.East, "facing east")
  check(head.`type` == (if sticky: PistonType.Sticky else: PistonType.Normal), "of the piston's own type")
  check(nameAt(t, beyond) == "stone", "the stone has arrived")
  check(t.world.getBlockEntity(front).isNone and t.world.getBlockEntity(beyond).isNone, "the entities are gone")
  # Power goes: the piston asks to retract (type 1), because the block is not mid-move.
  t.events.setLen(0)
  discard t.world.setBlockState(at(0'i32, 65'i32, 0'i32), blockStateIdAir, BfNotifyAll)
  var retract = false
  for e in t.events:
    if e == "synced 1 5":
      retract = true
  check(retract, "the piston asked for the retraction event (type 1)")
  check(t.runEvents(b, pos, 1'u8, 5'u8), "the event retracts")
  t.tickBlockEntities()
  t.tickBlockEntities()
  t.tickBlockEntities()
  check(nameAt(t, pos) == (if sticky: "sticky_piston" else: "piston"), "the piston is back")
  check(not PistonProps.fromStateId(t.world.getBlockStateId(pos), b).extended, "and retracted")
  check(t.world.getBlockEntity(pos).isNone, "with no entity")
  if sticky:
    check(nameAt(t, front) == "stone", "a sticky piston brought the stone back")
    check(nameAt(t, beyond) == "air", "leaving nothing behind")
  else:
    check(nameAt(t, front) == "air", "the head is gone")
    check(nameAt(t, beyond) == "stone", "a plain piston leaves the stone")

proc destroyedBlocks() =
  let t = setupPiston(false)
  let pos = at(0'i32, 64'i32, 0'i32)
  let front = at(1'i32, 64'i32, 0'i32)
  t.put(front, blockPoppy())
  discard t.world.setBlockState(at(0'i32, 65'i32, 0'i32), blockRedstoneBlock().defaultState.id, BfNotifyAll)
  check(t.runEvents(blockPiston(), pos, 0'u8, 5'u8), "extends through a flower")
  check(nameAt(t, front) == "moving_piston", "the flower is gone and the head comes")
  t.tickBlockEntities()
  t.tickBlockEntities()
  t.tickBlockEntities()
  check(nameAt(t, front) == "piston_head", "head")

proc blockedPiston() =
  let t = setupPiston(false)
  t.put(at(1'i32, 64'i32, 0'i32), blockObsidian())
  discard t.world.setBlockState(at(0'i32, 65'i32, 0'i32), blockRedstoneBlock().defaultState.id, BfNotifyAll)
  check(t.events.len == 0, "no event is asked for when the push is blocked")
  # And if the event comes anyway the piston does not move.
  check(not t.runEvents(blockPiston(), at(0'i32, 64'i32, 0'i32), 0'u8, 5'u8), "the event fails")
  check(not PistonProps.fromStateId(t.world.getBlockStateId(at(0'i32, 64'i32, 0'i32)), blockPiston()).extended, "still retracted")

proc entityState() =
  let pos = at(4'i32, 70'i32, 5'i32)
  let state = BlockState.fromId(blockStone().defaultState.id)
  let e = newPistonBlockEntity(pos, state, BlockDirection.East, true, false)
  check(BlockEntity(e).resourceLocation() == "minecraft:piston", "resource location")
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.getByte("facing").get(-1'i8) == 5'i8, "facing is its direction index")
  check(nbt.getFloat("progress").get(-1.0'f32) == 0.0'f32, "progress")
  check(nbt.getBool("extending").get(false) and not nbt.getBool("source").get(true), "extending and source")
  var again = nbt
  let loaded = pistonBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.facing == BlockDirection.East and loaded.extending and not loaded.source, "read back")
  check(loaded.pushedBlockState.isAir(), "the pushed state is not saved, as upstream")
  check(loaded.movementDirection() == BlockDirection.East, "extending moves along the facing")
  let back = newPistonBlockEntity(pos, state, BlockDirection.East, false, true)
  check(back.movementDirection() == BlockDirection.West, "retracting moves against it")
  check(abs(e.amountExtended(0.5'f32) - (-0.5'f32)) < 0.0001'f32, "extending: progress - 1")
  check(abs(back.amountExtended(0.25'f32) - 0.75'f32) < 0.0001'f32, "retracting: 1 - progress")
  var chunk = BlockEntity(e).chunkDataNbt()
  check(chunk.isSome and chunk.unsafeGet.getByte("facing").get(-1'i8) == 5'i8, "chunk data")
  # The head's collision slab: 0.25 thick at the front face.
  let box = BoundingBox.fromBlock(at(0'i32, 0'i32, 0'i32))
  let slab = headShapeAabb(box, BlockDirection.East)
  check(slab.min.x == 0.75 and slab.max.x == 1.0, "east slab")
  let slabUp = headShapeAabb(box, BlockDirection.Up)
  check(slabUp.min.y == 0.75 and slabUp.max.y == 1.0, "up slab")
  let slabNorth = headShapeAabb(box, BlockDirection.North)
  check(slabNorth.max.z == 0.25, "north slab")
  check(intersectionSize(box, BlockDirection.East, box) == 1.0, "east: swept.max.x - entity.min.x")
  check(intersectionSize(box, BlockDirection.West, box) == 1.0, "west: entity.max.x - swept.min.x")

pushLimit()
stickyBlocks()
movability()
extendAndRetract(false)
extendAndRetract(true)
destroyedBlocks()
blockedPiston()
entityState()
echo "piston ok"
