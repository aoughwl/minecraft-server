## Placement through the real registry over testworld.aowl: the blocks that decide their state from where and how they are
## placed. Known answers are vanilla's. Restores the coverage of the old end_rod, logs and glazed terracotta tests, and adds
## doors, slabs, stairs, falling sand and a water source.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude
import ../testworld
import end_rod, logs, glazed_terracotta, doors, slabs, stairs, falling, ../fluid/water

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksEndRod(result)
  registerBlocksLogs(result)
  registerBlocksGlazedTerracotta(result)
  registerBlocksDoors(result)
  registerBlocksSlabs(result)
  registerBlocksStairs(result)
  registerBlocksFalling(result)
  registerFluidWater(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc playerFacing(yaw: float32): BlockPlayer =
  ## A player looking along `yaw`: 0 is south, 90 west, 180 north, 270 east.
  let p = BlockPlayer()
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p

proc place(t: TestWorld; blockRef: Block; pos: BlockPos; direction: BlockDirection; player: BlockPlayer;
    replacing = BlockIsReplacing(kind: BlockIsReplacingKind.kNone); cursorY = 0.5'f32): BlockStateId =
  var useItemOn = SUseItemOn()
  useItemOn.cursorPos = Vector3[float32](x: 0.5'f32, y: cursorY, z: 0.5'f32)
  t.world.blockRegistry.onPlace(BlockServer(), t.world, player, blockRef, pos, direction, replacing, useItemOn)

block endRodAlignsOrOpposes:
  # Nothing to align with: facing is opposite the placement direction.
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let id = t.place(blockEndRod(), pos, BlockDirection.Up, playerFacing(0.0'f32))
  check(EndRodLikeProperties.fromStateId(id, blockEndRod()).facing == Facing.Down, "end rod with no neighbour faces down")
  # A rod above already pointing back down at this one: align with it.
  var neighbour = EndRodLikeProperties.defaultFor(blockEndRod())
  neighbour.facing = Facing.Down
  t.put(blockPos(0'i32, 65'i32, 0'i32), neighbour.toStateId(blockEndRod()))
  let id2 = t.place(blockEndRod(), pos, BlockDirection.Up, playerFacing(0.0'f32))
  check(EndRodLikeProperties.fromStateId(id2, blockEndRod()).facing == Facing.Up, "end rod aligns with the one above")

block logAxisFollowsFace:
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let up = t.place(blockOakLog(), pos, BlockDirection.Up, playerFacing(0.0'f32))
  check(PaleOakWoodLikeProperties.fromStateId(up, blockOakLog()).axis == BlockAxis.Y, "a log placed on a top face stands")
  let east = t.place(blockOakLog(), pos, BlockDirection.East, playerFacing(0.0'f32))
  check(PaleOakWoodLikeProperties.fromStateId(east, blockOakLog()).axis == BlockAxis.X, "a log placed on a side face lies along x")
  let north = t.place(blockOakLog(), pos, BlockDirection.North, playerFacing(0.0'f32))
  check(PaleOakWoodLikeProperties.fromStateId(north, blockOakLog()).axis == BlockAxis.Z, "and along z")

block glazedTerracottaFacesTheOtherWay:
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  # A player looking south (yaw 0) places it facing north.
  let id = t.place(blockWhiteGlazedTerracotta(), pos, BlockDirection.Up, playerFacing(0.0'f32))
  check(WallTorchLikeProperties.fromStateId(id, blockWhiteGlazedTerracotta()).facing == HorizontalFacing.North, "faces back at the player")
  let id2 = t.place(blockWhiteGlazedTerracotta(), pos, BlockDirection.Up, playerFacing(90.0'f32))
  check(WallTorchLikeProperties.fromStateId(id2, blockWhiteGlazedTerracotta()).facing == HorizontalFacing.East, "west looker, east facing")

block slabTopOrBottom:
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let low = t.place(blockStoneSlab(), pos, BlockDirection.North, playerFacing(0.0'f32), cursorY = 0.25'f32)
  check(ResinBrickSlabLikeProperties.fromStateId(low, blockStoneSlab()).`type` == SlabType.Bottom, "low click, bottom slab")
  let high = t.place(blockStoneSlab(), pos, BlockDirection.North, playerFacing(0.0'f32), cursorY = 0.75'f32)
  check(ResinBrickSlabLikeProperties.fromStateId(high, blockStoneSlab()).`type` == SlabType.Top, "high click, top slab")
  let both = t.place(blockStoneSlab(), pos, BlockDirection.Up, playerFacing(0.0'f32),
    BlockIsReplacing(kind: BlockIsReplacingKind.kItself, f0Itself: low))
  check(ResinBrickSlabLikeProperties.fromStateId(both, blockStoneSlab()).`type` == SlabType.Double, "a slab on a slab is a double")

block doorHasTwoHalves:
  let t = newTestWorld(newRegistry())
  t.put(blockPos(0'i32, 63'i32, 0'i32), blockStone())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let id = t.place(blockOakDoor(), pos, BlockDirection.Up, playerFacing(0.0'f32))
  discard t.world.setBlockState(pos, id, BfNotifyAll)
  let lower = t.world.getBlockStateId(pos)
  let upper = t.world.getBlockStateId(blockPos(0'i32, 65'i32, 0'i32))
  check(sameBlock(Block.fromStateId(upper), blockOakDoor()), "the upper half is written beside the lower")
  check(OakDoorLikeProperties.fromStateId(lower, blockOakDoor()).half == DoubleBlockHalf.Lower, "lower half")
  check(OakDoorLikeProperties.fromStateId(upper, blockOakDoor()).half == DoubleBlockHalf.Upper, "upper half")
  # Open it: both halves open.
  let b = t.world.blockRegistry.getPumpkinBlock(blockOakDoor().id)
  check(b.isSome, "doors are registered")
  let r = b.unsafeGet.normalUse(NormalUseArgs(world: t.world, block0: blockOakDoor(), position: pos, player: playerFacing(0.0'f32)))
  check(r == barSuccess, "using a door succeeds")
  check(OakDoorLikeProperties.fromStateId(t.world.getBlockStateId(pos), blockOakDoor()).open, "the lower half opened")
  check(OakDoorLikeProperties.fromStateId(t.world.getBlockStateId(blockPos(0'i32, 65'i32, 0'i32)), blockOakDoor()).open, "so did the upper")
  # Break the lower half: the upper goes too.
  discard t.world.breakBlock(pos, nil, BfNotifyAll or BfSkipDrops)
  check(t.world.getBlockStateId(blockPos(0'i32, 65'i32, 0'i32)) == blockStateIdAir, "the upper half goes with the lower")

proc sandSchedulesAFall() =
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  discard t.world.setBlockState(pos, blockSand().defaultState.id, BfNotifyAll)
  check(t.world.isBlockTickScheduled(pos, blockSand()), "placing sand schedules its tick")
  var spawned = 0
  t.world.replaceSpawnFalling0 = proc(position: BlockPos; stateId: BlockStateId) {.closure.} =
    inc spawned
    discard t.world.setBlockState(position, blockStateIdAir, BfNotifyAll)
  t.run(3)
  check(spawned == 1, "the sand over air turns into a falling entity")
  check(t.world.getBlockStateId(pos) == blockStateIdAir, "and its block is gone")
  # Over stone it stays.
  let t2 = newTestWorld(newRegistry())
  t2.put(blockPos(0'i32, 63'i32, 0'i32), blockStone())
  discard t2.world.setBlockState(pos, blockSand().defaultState.id, BfNotifyAll)
  t2.run(3)
  check(Block.fromStateId(t2.world.getBlockStateId(pos)).name == "sand", "sand on stone stays")

sandSchedulesAFall()

echo "placement: all checks passed"