## Port of pumpkin/src/block/blocks/plant/bamboo.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  BambooBlock* = object

var gBambooBlockAsPlantBlockBase: nil PlantBlockBase


proc bambooBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc bambooBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc bambooBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bambooBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc bambooBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc bambooBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newBambooBlock*(): BlockBehaviour
proc updateLeavesAndGrow*(world: BlockWorld, position: BlockPos)
proc countBambooBelow*(world: BlockWorld, pos: BlockPos): int
proc countBambooAbove*(world: BlockWorld, pos: BlockPos): int
proc boneMeal*(world: BlockWorld, position: BlockPos)
proc bambooBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc bambooBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc bambooBlockAsPlantBlockBase*(): PlantBlockBase

proc bambooBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let (blockBelow, stateIdBelow) = args.world.getBlockAndStateId(args.position.down())
  if blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_BAMBOO):
    var props = BambooLikeProperties.fromStateId(blockBamboo().defaultState.id, blockBamboo())
    if (blockBelow == blockBambooSapling()):
      return blockBamboo().defaultState.id
    elif (blockBelow == blockBamboo()):
      let propsBelow = BambooLikeProperties.fromStateId(stateIdBelow, blockBelow)
      if (propsBelow.age > 0):
        props.age = 1
    else:
      let (blockAbove, stateIdAbove) = args.world.getBlockAndStateId(args.position.up())
      if (blockAbove == blockBamboo()):
        let propsAbove = BambooLikeProperties.fromStateId(stateIdAbove, blockAbove)
        props.age = propsAbove.age
      else:
        return blockBambooSapling().defaultState.id
    return props.toStateId(blockBamboo())
  blockAir().defaultState.id

proc bambooBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  if (args.itemStack.stack.getItem() == ITEM_BONE_MEAL):
    boneMeal(args.world, args.position)
    return barSuccess
  barPass

proc bambooBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(bambooBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc bambooBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(bambooBlockAsPlantBlockBase(), args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)
  elif (args.world.getBlock(args.position.down()) == blockBambooSapling()):
    discard args.world.setBlockState(args.position.down(), blockBamboo().defaultState.id, 0'u32)

proc bambooBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(bambooBlockAsPlantBlockBase(), args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  let neighborBlock = args.world.getBlock(args.neighborPosition)
  if (args.direction == BlockDirection.Up) and (neighborBlock == blockBamboo()):
    let neighborProps = BambooLikeProperties.fromStateId(args.neighborStateId, neighborBlock)
    var props = BambooLikeProperties.fromStateId(args.stateId, args.block0)
    if (neighborProps.age > props.age):
      props.age = (if props.age == 0'u8: 1'u8 else: 0'u8)
      return props.toStateId(args.block0)
  args.stateId

proc bambooBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  if (rng().randomRange(0 .. 3) == 0):
    updateLeavesAndGrow(args.world, args.position)

proc newBambooBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = bambooBlockOnPlace_BlockBehaviour
  result.useWithItemImpl = bambooBlockUseWithItem_BlockBehaviour
  result.canPlaceAtImpl = bambooBlockCanPlaceAt_BlockBehaviour
  result.onScheduledTickImpl = bambooBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bambooBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = bambooBlockRandomTick_BlockBehaviour

proc updateLeavesAndGrow*(world: BlockWorld, position: BlockPos) =
  let abovePos = position.up()
  let belowPos = position.down()
  let twoBelowPos = position.downHeight(2)
  let (blockRef, stateId) = world.getBlockAndStateId(position)
  let stateAbove = world.getBlockState(abovePos)
  if (not stateAbove.isAir()):
    return
  var props = BambooLikeProperties.fromStateId(stateId, blockRef)
  if (not (props.stage == 0)):
    return
  let bambooCount = countBambooBelow(world, position)
  if (bambooCount >= 16):
    return
  let (blockBelow, stateIdBelow) = world.getBlockAndStateId(belowPos)
  let (blockTwoBelow, stateIdTwoBelow) = world.getBlockAndStateId(twoBelowPos)
  var propsBelow = BambooLikeProperties.fromStateId(stateIdBelow, blockBelow)
  if (bambooCount >= 1):
    let belowIsBamboo = (blockBelow == blockBamboo())
    let belowHasLeaves = (not (propsBelow.leaves == BambooLeaves.None))
    let t2 = block:
      if ((not belowIsBamboo) or (not belowHasLeaves)):
        BambooLeaves.Small
      else:
        BambooLeaves.Large
    props.leaves = t2
    if (props.leaves == BambooLeaves.Large) and (blockTwoBelow == blockBamboo()):
      propsBelow.leaves = BambooLeaves.Small
      var propsTwoBelow = BambooLikeProperties.fromStateId(stateIdTwoBelow, blockTwoBelow)
      propsTwoBelow.leaves = BambooLeaves.None
      discard world.setBlockState(belowPos, propsBelow.toStateId(blockBelow), BfNotifyAll)
      discard world.setBlockState(twoBelowPos, propsTwoBelow.toStateId(blockTwoBelow), BfNotifyAll)
  props.age = (if not ((props.age != 1'u8) and (blockTwoBelow == blockBamboo())): 1'u8 else: 0'u8)
  props.stage = (if not (((bambooCount < 11) or (randomOf(float32) >= 0.25'f32)) and (bambooCount != 15)): 1'u8 else: 0'u8)
  discard world.setBlockState(abovePos, props.toStateId(blockRef), BfNotifyAll)

proc countBambooBelow*(world: BlockWorld, pos: BlockPos): int =
  var bambooCount = 0
  var foundBambooBelow = true
  var currentPosition = pos.down()
  while (foundBambooBelow and (bambooCount < 16)):
    foundBambooBelow = false
    if (world.getBlock(currentPosition) == blockBamboo()):
      currentPosition = currentPosition.down()
      bambooCount += 1
      foundBambooBelow = true
  bambooCount

proc countBambooAbove*(world: BlockWorld, pos: BlockPos): int =
  var bambooCount = 0
  var foundBambooBelow = true
  var currentPosition = pos.up()
  while (foundBambooBelow and (bambooCount < 16)):
    foundBambooBelow = false
    if (world.getBlock(currentPosition) == blockBamboo()):
      currentPosition = currentPosition.up()
      bambooCount += 1
      foundBambooBelow = true
  bambooCount

proc boneMeal*(world: BlockWorld, position: BlockPos) =
  let bambooBelow = countBambooBelow(world, position)
  let growthAmount = rng().randomRange(1 .. 2)
  let aboveStart = countBambooAbove(world, position)
  for k in 0 ..< growthAmount:
    let bambooAbove = aboveStart + k
    let currentTotalHeight = ((bambooAbove + bambooBelow) + 1)
    # `next_pos` is the topmost bamboo of the stalk, so the free space we grow into is the
    # block above it. Vanilla reads `STAGE` from the top stalk and grows from there too.
    let nextPos = position.upHeight(int32(bambooAbove))
    let nextState = world.getBlockState(nextPos)
    if ((currentTotalHeight >= 16) or (not world.getBlockState(nextPos.up()).isAir())):
      return
    let nextProps = BambooLikeProperties.fromStateId(nextState.id, blockBamboo())
    if (nextProps.stage == 1):
      return
    updateLeavesAndGrow(world, nextPos)

proc bambooBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef.hasTag(Block_MINECRAFT_SUPPORTS_BAMBOO)

proc bambooBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  canPlantOnTop(bambooBlockAsPlantBlockBase(), blockAccessor, blockPos.down())

proc bambooBlockAsPlantBlockBase*(): PlantBlockBase =
  if gBambooBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = bambooBlockCanPlantOnTop_PlantBlockBase
    v.canPlaceAtImpl = bambooBlockCanPlaceAt_PlantBlockBase
    gBambooBlockAsPlantBlockBase = v
  gBambooBlockAsPlantBlockBase

proc registerBlocksPlantBamboo*(r: BlockRegistry) =
  r.register("minecraft:bamboo", newBambooBlock())

