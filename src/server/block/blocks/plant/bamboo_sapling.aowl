## Port of pumpkin/src/block/blocks/plant/bamboo_sapling.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  BambooSaplingBlock* = object

var gBambooSaplingBlockAsPlantBlockBase: nil PlantBlockBase


proc bambooSaplingBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bambooSaplingBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc bambooSaplingBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc bambooSaplingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc bambooSaplingBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newBambooSaplingBlock*(): BlockBehaviour
proc bambooSaplingBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc bambooSaplingBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc bambooSaplingBlockAsPlantBlockBase*(): PlantBlockBase

proc bambooSaplingBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(bambooSaplingBlockAsPlantBlockBase(), args.blockAccessor, args.position.down())

proc bambooSaplingBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  if (args.itemStack.stack.getItem() == ITEM_BONE_MEAL):
    var propsNew = BambooLikeProperties.fromStateId(blockBamboo().defaultState.id, blockBamboo())
    propsNew.leaves = BambooLeaves.Small
    discard args.world.setBlockState(args.position.up(), propsNew.toStateId(blockBamboo()), BfNotifyAll)
    return barSuccess
  barPass

proc bambooSaplingBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if (args.block0 == blockBambooSapling()) and (args.world.getBlock(args.position.up()) == blockBamboo()):
    discard args.world.setBlockState(args.position, blockBamboo().defaultState.id, BfNotifyNeighbors)

proc bambooSaplingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(bambooSaplingBlockAsPlantBlockBase(), args.world, args.position)):
    return blockAir().defaultState.id
  if (args.direction == BlockDirection.Up) and (args.world.getBlock(args.neighborPosition) == blockBamboo()):
    return blockBamboo().defaultState.id
  args.stateId

proc bambooSaplingBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  let stateAbove = args.world.getBlockState(args.position.up())
  if ((not stateAbove.isAir()) or (rng().randomRange(0 ..< 3) > 0)):
    return
  var propsNew = BambooLikeProperties.fromStateId(blockBamboo().defaultState.id, blockBamboo())
  propsNew.leaves = BambooLeaves.Small
  discard args.world.setBlockState(args.position.up(), propsNew.toStateId(blockBamboo()), BfNotifyAll)

proc newBambooSaplingBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = bambooSaplingBlockCanPlaceAt_BlockBehaviour
  result.useWithItemImpl = bambooSaplingBlockUseWithItem_BlockBehaviour
  result.onNeighborUpdateImpl = bambooSaplingBlockOnNeighborUpdate_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bambooSaplingBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = bambooSaplingBlockRandomTick_BlockBehaviour

proc bambooSaplingBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  canPlantOnTop(bambooSaplingBlockAsPlantBlockBase(), blockAccessor, blockPos.down())

proc bambooSaplingBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef.hasTag(Block_MINECRAFT_SUPPORTS_BAMBOO)

proc bambooSaplingBlockAsPlantBlockBase*(): PlantBlockBase =
  if gBambooSaplingBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlaceAtImpl = bambooSaplingBlockCanPlaceAt_PlantBlockBase
    v.canPlantOnTopImpl = bambooSaplingBlockCanPlantOnTop_PlantBlockBase
    gBambooSaplingBlockAsPlantBlockBase = v
  gBambooSaplingBlockAsPlantBlockBase

proc registerBlocksPlantBambooSapling*(r: BlockRegistry) =
  r.register("minecraft:bamboo_sapling", newBambooSaplingBlock())

