## Port of pumpkin/src/block/blocks/plant/big_dripleaf.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../redstone/redstonemod
import plantmod
import big_dripleaf_stem  # upstream's stem imports `can_plant_dripleaf_on_top` from here; it lives in the stem module to break the cycle
export big_dripleaf_stem.canPlantDripleafOnTop


type
  BigDripleafBlock* = object

var gBigDripleafBlockAsPlantBlockBase: nil PlantBlockBase


proc bigDripleafBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs)
proc bigDripleafBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc bigDripleafBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bigDripleafBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc bigDripleafBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc bigDripleafBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc bigDripleafBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc bigDripleafBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newBigDripleafBlock*(): BlockBehaviour
proc setTiltAndScheduleTick*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos, tilt: Tilt, soundWrapper: Option[Sound])
proc playTiltSound*(world: BlockWorld, pos: BlockPos, tiltSound: Sound)
proc resetTilt*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos)
proc setTilt*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos, newTilt: Tilt)
proc canEntityTilt*(pos: BlockPos, entity: BlockActor): bool
proc getDripleafFacingDir*(stateId: BlockStateId): HorizontalFacing
proc isDripleafWaterlogged*(stateId: BlockStateId): bool
proc bigDripleafBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc bigDripleafBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc bigDripleafBlockAsPlantBlockBase*(): PlantBlockBase

proc bigDripleafBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs) =
  let props = BigDripleafLikeProperties.fromStateId(args.state.id, args.block0)
  if (props.tilt == Tilt.None) and canEntityTilt(args.position, args.entity) and (not blockReceivesRedstonePower(args.world, args.position)):
    setTiltAndScheduleTick(args.state.id, args.world, args.position, Tilt.Unstable, none[Sound]())

proc bigDripleafBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  if blockReceivesRedstonePower(args.world, args.position):
    resetTilt(state.id, args.world, args.position)
  else:
    let props = BigDripleafLikeProperties.fromStateId(state.id, blockBigDripleaf())
    if (props.tilt == Tilt.Unstable):
      setTiltAndScheduleTick(state.id, args.world, args.position, Tilt.Partial, some(sdBlockBigDripleafTiltDown))
    elif (props.tilt == Tilt.Partial):
      setTiltAndScheduleTick(state.id, args.world, args.position, Tilt.Full, some(sdBlockBigDripleafTiltDown))
    elif (props.tilt == Tilt.Full):
      resetTilt(state.id, args.world, args.position)

proc bigDripleafBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(bigDripleafBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc bigDripleafBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let (supportBlock, supportBlockStateId) = args.world.getBlockAndStateId(args.position.down())
  let t1 = block:
    if (supportBlock == blockBigDripleaf()):
      getDripleafFacingDir(supportBlockStateId)
    else:
      args.player.livingEntity.entity.getHorizontalFacing().opposite()
  let facing = t1
  var dripleafProps = BigDripleafLikeProperties.defaultFor(args.block0)
  dripleafProps.facing = facing
  dripleafProps.waterlogged = args.replacing.waterSource()
  dripleafProps.toStateId(args.block0)

proc bigDripleafBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(bigDripleafBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc bigDripleafBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if blockReceivesRedstonePower(args.world, args.position):
    let stateId = args.world.getBlockStateId(args.position)
    resetTilt(stateId, args.world, args.position)

proc bigDripleafBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let supportPos = args.position.down()
  let (supportBlock, supportStateId) = args.world.getBlockAndStateId(supportPos)
  if (supportBlock == blockBigDripleaf()):
    let oldDripleafProps = BigDripleafLikeProperties.fromStateId(supportStateId, blockBigDripleaf())
    var dripleafStemProps = BigDripleafStemLikeProperties.defaultFor(blockBigDripleafStem())
    dripleafStemProps.facing = oldDripleafProps.facing
    dripleafStemProps.waterlogged = oldDripleafProps.waterlogged
    discard args.world.setBlockState(supportPos, dripleafStemProps.toStateId(blockBigDripleafStem()), 0'u32)

proc bigDripleafBlockBroken_BlockBehaviour(args: BrokenArgs) =
  handleBigDripleafBreaking(args.world, args.position)

proc newBigDripleafBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityStepImpl = bigDripleafBlockOnEntityStep_BlockBehaviour
  result.onScheduledTickImpl = bigDripleafBlockOnScheduledTick_BlockBehaviour
  result.canPlaceAtImpl = bigDripleafBlockCanPlaceAt_BlockBehaviour
  result.onPlaceImpl = bigDripleafBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bigDripleafBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onNeighborUpdateImpl = bigDripleafBlockOnNeighborUpdate_BlockBehaviour
  result.placedImpl = bigDripleafBlockPlaced_BlockBehaviour
  result.brokenImpl = bigDripleafBlockBroken_BlockBehaviour

proc setTiltAndScheduleTick*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos, tilt: Tilt, soundWrapper: Option[Sound]) =
  setTilt(stateId, world, pos, tilt)
  let t2 = soundWrapper
  if t2.isSome:
    let tiltSound = t2.unsafeGet
    playTiltSound(world, pos, t2.unsafeGet)
  let t3 = block:
    if tilt == Tilt.None:
      (-1)
    elif (tilt == Tilt.Unstable or tilt == Tilt.Partial):
      10
    elif tilt == Tilt.Full:
      100
    else:
      rustPanic("non-exhaustive")
  let tickDelay = t3
  if (not (tickDelay == (-1))):
    world.scheduleBlockTick(blockBigDripleaf(), pos, uint8(tickDelay), tpNormal)

proc playTiltSound*(world: BlockWorld, pos: BlockPos, tiltSound: Sound) =
  let pitch = rng().randomRange(0.8'f32 .. 1.2'f32)
  let v = pos.vec
  let position = vec3[float64](float64(v.x), float64(v.y), float64(v.z))
  world.playSoundFine(tiltSound, scBlocks, position, 1'f32, pitch)

proc resetTilt*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos) =
  setTilt(stateId, world, pos, Tilt.None)
  let props = BigDripleafLikeProperties.fromStateId(stateId, blockBigDripleaf())
  if (not (props.tilt == Tilt.None)):
    playTiltSound(world, pos, sdBlockBigDripleafTiltUp)

proc setTilt*(stateId: BlockStateId, world: BlockWorld, pos: BlockPos, newTilt: Tilt) =
  var props = BigDripleafLikeProperties.fromStateId(stateId, blockBigDripleaf())
  props.tilt = newTilt
  discard world.setBlockState(pos, props.toStateId(blockBigDripleaf()), BfNotifyAll)

proc canEntityTilt*(pos: BlockPos, entity: BlockActor): bool =
  let onGround = entity.getEntity().onGround0
  (onGround != nil and onGround()) and (entity.getEntity().pos.y > (float64(pos.vec.y) + 0.6875'f64))

proc getDripleafFacingDir*(stateId: BlockStateId): HorizontalFacing =
  let dripleafProps = BigDripleafLikeProperties.fromStateId(stateId, blockBigDripleaf())
  dripleafProps.facing

proc isDripleafWaterlogged*(stateId: BlockStateId): bool =
  let dripleafProps = BigDripleafLikeProperties.fromStateId(stateId, blockBigDripleaf())
  dripleafProps.waterlogged

proc bigDripleafBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let supportBlock = blockAccessor.getBlock(pos)
  canPlantDripleafOnTop(supportBlock)

proc bigDripleafBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(bigDripleafBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    if isDripleafWaterlogged(blockState):
      return blockWater().defaultState.id
    return blockAir().defaultState.id
  blockState

proc bigDripleafBlockAsPlantBlockBase*(): PlantBlockBase =
  if gBigDripleafBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = bigDripleafBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = bigDripleafBlockGetStateForNeighborUpdate_PlantBlockBase
    gBigDripleafBlockAsPlantBlockBase = v
  gBigDripleafBlockAsPlantBlockBase

proc registerBlocksPlantBigDripleaf*(r: BlockRegistry) =
  r.register("minecraft:big_dripleaf", newBigDripleafBlock())

