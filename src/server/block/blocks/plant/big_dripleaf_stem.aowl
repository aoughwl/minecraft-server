## Port of pumpkin/src/block/blocks/plant/big_dripleaf_stem.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import big_dripleaf
import plantmod


type
  BigDripleafStemBlock* = object
  BigDripleafStemLikeProperties* = LadderLikeProperties

var gBigDripleafStemBlockAsPlantBlockBase: nil PlantBlockBase


proc bigDripleafStemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bigDripleafStemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc bigDripleafStemBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newBigDripleafStemBlock*(): BlockBehaviour
proc bigDripleafStemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc bigDripleafStemBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc bigDripleafStemBlockAsPlantBlockBase*(): PlantBlockBase
proc handleBigDripleafBreaking*(world: BlockWorld, position: BlockPos)

proc bigDripleafStemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(bigDripleafStemBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc bigDripleafStemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(bigDripleafStemBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc bigDripleafStemBlockBroken_BlockBehaviour(args: BrokenArgs) =
  handleBigDripleafBreaking(args.world, args.position)

proc newBigDripleafStemBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = bigDripleafStemBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bigDripleafStemBlockGetStateForNeighborUpdate_BlockBehaviour
  result.brokenImpl = bigDripleafStemBlockBroken_BlockBehaviour

proc bigDripleafStemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let supportBlock = blockAccessor.getBlock(pos)
  canPlantDripleafOnTop(supportBlock)

proc bigDripleafStemBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(bigDripleafStemBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    let blockRef = blockAccessor.getBlock(blockPos)
    let dripleafStemProps = BigDripleafStemLikeProperties.fromStateId(blockState, blockRef)
    if dripleafStemProps.waterlogged:
      return blockWater().defaultState.id
    return blockAir().defaultState.id
  blockState

proc bigDripleafStemBlockAsPlantBlockBase*(): PlantBlockBase =
  if gBigDripleafStemBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = bigDripleafStemBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = bigDripleafStemBlockGetStateForNeighborUpdate_PlantBlockBase
    gBigDripleafStemBlockAsPlantBlockBase = v
  gBigDripleafStemBlockAsPlantBlockBase

proc handleBigDripleafBreaking*(world: BlockWorld, position: BlockPos) =
  let supportPos = position.down()
  let (supportBlock, supportStateId) = world.getBlockAndStateId(supportPos)
  if (supportBlock == blockBigDripleafStem()):
    let dripleafStemProps = BigDripleafStemLikeProperties.fromStateId(supportStateId, supportBlock)
    var dripleafProps = BigDripleafLikeProperties.defaultFor(blockBigDripleaf())
    dripleafProps.facing = dripleafStemProps.facing
    dripleafProps.waterlogged = dripleafStemProps.waterlogged
    discard world.setBlockState(supportPos, dripleafProps.toStateId(blockBigDripleaf()), 0'u32)

proc registerBlocksPlantBigDripleafStem*(r: BlockRegistry) =
  r.register("minecraft:big_dripleaf_stem", newBigDripleafStemBlock())

