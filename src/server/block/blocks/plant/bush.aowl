## Port of pumpkin/src/block/blocks/plant/bush.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  BushBlock* = object

var gBushBlockAsPlantBlockBase: nil PlantBlockBase


proc bushBlockIds*(): seq[BlockId]
proc bushBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bushBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newBushBlock*(): BlockBehaviour
proc bushBlockAsPlantBlockBase*(): PlantBlockBase

proc bushBlockIds*(): seq[BlockId] =
  @[blockIdBush, blockIdFireflyBush]

proc bushBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(bushBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc bushBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(bushBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newBushBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = bushBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = bushBlockGetStateForNeighborUpdate_BlockBehaviour

proc bushBlockAsPlantBlockBase*(): PlantBlockBase =
  if gBushBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gBushBlockAsPlantBlockBase = v
  gBushBlockAsPlantBlockBase

proc registerBlocksPlantBush*(r: BlockRegistry) =
  r.registerIds(bushBlockIds(), newBushBlock())

