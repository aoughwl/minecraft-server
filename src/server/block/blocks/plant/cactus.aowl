## Port of pumpkin/src/block/blocks/plant/cactus.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude



type
  CactusBlock* = object



proc cactusBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc cactusBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc cactusBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc cactusBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc cactusBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newCactusBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool

proc cactusBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc cactusBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  let blockUp = args.position.up()
  if args.world.getBlockState(blockUp).isAir():
    let state = args.world.getBlockState(args.position)
    var props = CactusLikeProperties.fromStateId(state.id, args.block0)
    let age = props.age
    var i = 1'i32
    while (args.world.getBlock(args.position.downHeight(i)) == blockCactus()):
      i += 1'i32
      if (1 == 3) and (age == 15):
        return
    if (age == 8) and canPlaceAt(args.world, blockUp):
      let t1 = block:
        if (i >= 3'i32):
          0.25
        else:
          0.1
      let d = t1
      if (rng().randomRange(0.0 .. 1.0) <= d):
        discard args.world.setBlockState(blockUp, blockCactusFlower().defaultState.id, BfNotifyAll)
    else:
      if (age == 15) and (i < 3'i32):
        discard args.world.setBlockState(blockUp, blockCactus().defaultState.id, BfNotifyAll)
        var newProps = CactusLikeProperties.defaultFor(blockCactus())
        newProps.age = 0
        discard args.world.setBlockState(args.position, newProps.toStateId(blockCactus()), BfSkipBlockEntityReplacedCallback)
        args.world.updateNeighbor(args.position, blockCactus())
    if (age < 15):
      props.age = (age + 1)
      discard args.world.setBlockState(args.position, props.toStateId(blockCactus()), BfSkipBlockEntityReplacedCallback)

proc cactusBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  discard args.entity.damage(1.0'f32, "cactus")

proc cactusBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc cactusBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc newCactusBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onScheduledTickImpl = cactusBlockOnScheduledTick_BlockBehaviour
  result.randomTickImpl = cactusBlockRandomTick_BlockBehaviour
  result.onEntityCollisionImpl = cactusBlockOnEntityCollision_BlockBehaviour
  result.getStateForNeighborUpdateImpl = cactusBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = cactusBlockCanPlaceAt_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let t2 = blockDirectionHorizontal()
  for direction in t2:
    let (blockRef, state) = world.getBlockAndState(blockPos.offset(direction.toOffset()))
    if (state.isSolid() or (blockRef == blockLava())):
      return false
  let blockRef1 = world.getBlock(blockPos.down())
  ((((blockRef1 == blockCactus()) or blockRef1.hasTag(Block_MINECRAFT_SUPPORTS_CACTUS))) and (not world.getBlockState(blockPos.up()).isLiquid()))

proc registerBlocksPlantCactus*(r: BlockRegistry) =
  r.register("minecraft:cactus", newCactusBlock())

