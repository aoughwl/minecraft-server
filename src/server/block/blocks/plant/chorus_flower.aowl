import ../../blockprelude


type
  ChorusFlowerBlock* = object



proc chorusFlowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc chorusFlowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc chorusFlowerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newChorusFlowerBlock*(): BlockBehaviour
proc canSurvive*(blockAccessor: BlockWorld, pos: BlockPos): bool

proc chorusFlowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canSurvive(args.blockAccessor, args.position)

proc chorusFlowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not (args.direction == BlockDirection.Up)) and (not canSurvive(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc chorusFlowerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canSurvive(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newChorusFlowerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = chorusFlowerBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = chorusFlowerBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = chorusFlowerBlockOnScheduledTick_BlockBehaviour

proc canSurvive*(blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockBelow = blockAccessor.getBlock(pos.down())
  if ((blockBelow == blockChorusPlant()) or blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_CHORUS_FLOWER)):
    return true
  if (not blockBelow.isAir()):
    return false
  # Below is air: the flower is the tip of a horizontal branch.
  # Exactly one horizontal neighbor must be a chorus plant stem.
  var plantCount = 0'u32
  let t1 = blockDirectionHorizontal()
  for dir in t1:
    let neighbor = blockAccessor.getBlock(pos.offset(dir.toOffset()))
    if (neighbor == blockChorusPlant()):
      plantCount += 1
      if (plantCount > 1):
        return false
    elif (not neighbor.isAir()):
      return false
  (plantCount == 1)

proc registerBlocksPlantChorusFlower*(r: BlockRegistry) =
  r.register("minecraft:chorus_flower", newChorusFlowerBlock())

