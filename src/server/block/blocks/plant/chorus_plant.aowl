## Port of pumpkin/src/block/blocks/plant/chorus_plant.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  ChorusPlantBlock* = object



proc chorusPlantBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc chorusPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc chorusPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc chorusPlantBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newChorusPlantBlock*(): BlockBehaviour
proc getStateWithConnections*(blockAccessor: BlockWorld, blockRef: Block, pos: BlockPos): BlockStateId
proc canSurvive*(blockAccessor: BlockWorld, pos: BlockPos): bool

proc chorusPlantBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  # Compute all 6 face connections immediately so the placed block visually connects to its neighbors.
  getStateWithConnections(args.world, args.block0, args.position)

proc chorusPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canSurvive(args.blockAccessor, args.position)

proc chorusPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canSurvive(args.world, args.position)):
    # Schedule delayed destruction so the whole plant cascades down.
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
    return args.stateId
  # Update the single face connection for the direction that changed.
  let neighborBlock = args.world.getBlock(args.neighborPosition)
  let connect = (((neighborBlock == blockChorusPlant()) or (neighborBlock == blockChorusFlower())) or (((args.direction == BlockDirection.Down) and neighborBlock.hasTag(Block_MINECRAFT_SUPPORTS_CHORUS_PLANT))))
  var props = BrownMushroomBlockLikeProperties.fromStateId(args.stateId, args.block0)
  case args.direction
  of BlockDirection.Down:
    props.down = connect
  of BlockDirection.Up:
    props.up = connect
  of BlockDirection.North:
    props.north = connect
  of BlockDirection.South:
    props.south = connect
  of BlockDirection.East:
    props.east = connect
  of BlockDirection.West:
    props.west = connect
  props.toStateId(args.block0)

proc chorusPlantBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  # Destroy if unsupported; breaking propagates neighbor-update callbacks
  # to connected chorus blocks, which schedule their own ticks.
  if (not canSurvive(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc newChorusPlantBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = chorusPlantBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = chorusPlantBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = chorusPlantBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = chorusPlantBlockOnScheduledTick_BlockBehaviour

proc getStateWithConnections*(blockAccessor: BlockWorld, blockRef: Block, pos: BlockPos): BlockStateId =
  let plantId = blockChorusPlant().id
  let flowerId = blockChorusFlower().id
  let supports = Block_MINECRAFT_SUPPORTS_CHORUS_PLANT
  proc connects(b: Block): bool {.closure.} = (b.id == plantId) or (b.id == flowerId)
  let blockDown = blockAccessor.getBlock(pos.down())
  let blockUp = blockAccessor.getBlock(pos.up())
  let blockNorth = blockAccessor.getBlock(pos.offset(BlockDirection.North.toOffset()))
  let blockEast = blockAccessor.getBlock(pos.offset(BlockDirection.East.toOffset()))
  let blockSouth = blockAccessor.getBlock(pos.offset(BlockDirection.South.toOffset()))
  let blockWest = blockAccessor.getBlock(pos.offset(BlockDirection.West.toOffset()))
  let props = BrownMushroomBlockLikeProperties(down: (connects(blockDown) or blockDown.hasTag(supports)), up: connects(blockUp), north: connects(blockNorth), east: connects(blockEast), south: connects(blockSouth), west: connects(blockWest))
  props.toStateId(blockRef)

proc canSurvive*(blockAccessor: BlockWorld, pos: BlockPos): bool =
  let belowPos = pos.down()
  let abovePos = pos.up()
  let (blockBelow, stateBelow) = blockAccessor.getBlockAndState(belowPos)
  let stateAbove = blockAccessor.getBlockState(abovePos)
  # A horizontal branch is invalid when both the block immediately above and
  # below this one are non-air (enclosed inside something).
  let blockAboveOrBelow = ((not stateAbove.isAir()) and (not stateBelow.isAir()))
  let t1 = blockDirectionHorizontal()
  for dir in t1:
    let neighborPos = pos.offset(dir.toOffset())
    let neighborBlock = blockAccessor.getBlock(neighborPos)
    if (neighborBlock == blockChorusPlant()):
      if blockAboveOrBelow:
        return false
      let neighborBelow = blockAccessor.getBlock(neighborPos.down())
      if ((neighborBelow == blockChorusPlant()) or neighborBelow.hasTag(Block_MINECRAFT_SUPPORTS_CHORUS_PLANT)):
        return true
  ((blockBelow == blockChorusPlant()) or blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_CHORUS_PLANT))

proc registerBlocksPlantChorusPlant*(r: BlockRegistry) =
  r.register("minecraft:chorus_plant", newChorusPlantBlock())

