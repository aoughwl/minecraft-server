## Port of pumpkin/src/block/blocks/plant/crop/carrot.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import ../plantmod
import cropmod


type
  CarrotBlock* = object

var gCarrotBlockAsPlantBlockBase: nil PlantBlockBase
var gCarrotBlockAsCropBlockBase: nil CropBlockBase


proc carrotBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc carrotBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc carrotBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newCarrotBlock*(): BlockBehaviour
proc carrotBlockAsPlantBlockBase*(): PlantBlockBase
proc carrotBlockAsCropBlockBase*(): CropBlockBase

proc carrotBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlantOnTop(carrotBlockAsCropBlockBase(), args.blockAccessor, args.position.down())

proc carrotBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(carrotBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc carrotBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  randomTick(carrotBlockAsCropBlockBase(), args.world, args.position)

proc newCarrotBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = carrotBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = carrotBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = carrotBlockRandomTick_BlockBehaviour

proc carrotBlockAsPlantBlockBase*(): PlantBlockBase =
  if gCarrotBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gCarrotBlockAsPlantBlockBase = v
  gCarrotBlockAsPlantBlockBase

proc carrotBlockAsCropBlockBase*(): CropBlockBase =
  if gCarrotBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.plantBlockBase = carrotBlockAsPlantBlockBase()
    gCarrotBlockAsCropBlockBase = v
  gCarrotBlockAsCropBlockBase

proc registerBlocksPlantCropCarrot*(r: BlockRegistry) =
  r.register("minecraft:carrots", newCarrotBlock())

