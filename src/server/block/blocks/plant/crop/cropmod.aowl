## Port of pumpkin/src/block/blocks/plant/crop/mod.rs
## PARTIAL: pumpkin/src/block/blocks/plant/crop/mod.rs - plugin events are not fired: nothing listens to them from here yet

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import ../plantmod


type
  CropProperties = WheatLikeProperties
  FarmlandProperties = FarmlandLikeProperties
  CropBlockBase* = ref object
    canPlantOnTopImpl*: proc(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool {.closure.}
    maxAgeImpl*: proc(self: CropBlockBase): int32 {.closure.}
    getAgeImpl*: proc(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 {.closure.}
    stateWithAgeImpl*: proc(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId {.closure.}
    randomTickImpl*: proc(self: CropBlockBase, world: BlockWorld, pos: BlockPos) {.closure.}
    plantBlockBase*: PlantBlockBase



proc canPlantOnTop*(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc defaultCanPlantOnTop_CropBlockBase(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc maxAge*(self: CropBlockBase): int32
proc defaultMaxAge_CropBlockBase(self: CropBlockBase): int32
proc getAge*(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32
proc defaultGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32
proc stateWithAge*(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId
proc defaultStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId
proc randomTick*(self: CropBlockBase, world: BlockWorld, pos: BlockPos)
proc defaultRandomTick_CropBlockBase(self: CropBlockBase, world: BlockWorld, pos: BlockPos)
proc newCropBlockBase*(): CropBlockBase
proc getAvailableMoisture*(world: BlockWorld, pos: BlockPos, blockRef: Block): float32

proc defaultCanPlantOnTop_CropBlockBase(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef == blockFarmland()

proc defaultMaxAge_CropBlockBase(self: CropBlockBase): int32 =
  7'i32

proc defaultGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 =
  let props = CropProperties.fromStateId(state, blockRef)
  int32(props.age)

proc defaultStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  var props = CropProperties.fromStateId(state, blockRef)
  props.age = uint8(age)
  props.toStateId(blockRef)

proc defaultRandomTick_CropBlockBase(self: CropBlockBase, world: BlockWorld, pos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(pos)
  let age = self.getAge(state, blockRef)
  if age < self.maxAge():
    let f = getAvailableMoisture(world, pos, blockRef)
    if int64(rng().randomRange(0'i64 .. int64(floor(float64(25.0'f32 / f))))) == 0'i64:
      let newStateId = self.stateWithAge(blockRef, state, age + 1'i32)
      # TODO(upstream): fire a `BlockGrowEvent` through the plugin manager and take its `new_state_id`; cancelled events
      # stop the growth. Nothing listens to plugin events from here yet.
      discard world.setBlockState(pos, newStateId, BfNotifyNeighbors)
  # TODO add impl for light level

proc canPlantOnTop*(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let f = self.canPlantOnTopImpl
  f(self, blockAccessor, pos)

proc maxAge*(self: CropBlockBase): int32 =
  let f = self.maxAgeImpl
  f(self)

proc getAge*(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 =
  let f = self.getAgeImpl
  f(self, state, blockRef)

proc stateWithAge*(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  let f = self.stateWithAgeImpl
  f(self, blockRef, state, age)

proc randomTick*(self: CropBlockBase, world: BlockWorld, pos: BlockPos) =
  let f = self.randomTickImpl
  f(self, world, pos)

proc newCropBlockBase*(): CropBlockBase =
  result = CropBlockBase()
  result.canPlantOnTopImpl = defaultCanPlantOnTop_CropBlockBase
  result.maxAgeImpl = defaultMaxAge_CropBlockBase
  result.getAgeImpl = defaultGetAge_CropBlockBase
  result.stateWithAgeImpl = defaultStateWithAge_CropBlockBase
  result.randomTickImpl = defaultRandomTick_CropBlockBase

proc getAvailableMoisture*(world: BlockWorld, pos: BlockPos, blockRef: Block): float32 =
  var moisture = 1.0'f32
  let downPos = pos.down()
  for dx in -1'i32 .. 1'i32:
    for dz in -1'i32 .. 1'i32:
      var localMoisture = 0.0'f32
      let (blockHere, blockState) = world.getBlockAndStateId(downPos.offset(Vector3[int32](x: dx, y: 0'i32, z: dz)))
      if (blockHere == blockFarmland()):
        localMoisture = 1.0'f32
        let props = FarmlandProperties.fromStateId(blockState, blockHere)
        if (props.moisture != 0):
          localMoisture = 3.0'f32
      if (dx != 0) or (dz != 0):
        localMoisture = localMoisture / 4.0'f32
      moisture += localMoisture
  let north = pos.offset(BlockDirection.North.toOffset())
  let south = pos.offset(BlockDirection.South.toOffset())
  let west = pos.offset(BlockDirection.West.toOffset())
  let east = pos.offset(BlockDirection.East.toOffset())
  let horizontal = ((world.getBlock(west) == blockRef) or (world.getBlock(east) == blockRef))
  let vertical = ((world.getBlock(north) == blockRef) or (world.getBlock(south) == blockRef))
  if (horizontal and vertical) or (world.getBlock(west.offset(BlockDirection.North.toOffset())) == blockRef) or
      (world.getBlock(east.offset(BlockDirection.North.toOffset())) == blockRef) or
      (world.getBlock(east.offset(BlockDirection.South.toOffset())) == blockRef) or
      (world.getBlock(west.offset(BlockDirection.South.toOffset())) == blockRef):
    moisture = moisture / 2.0'f32
  moisture

