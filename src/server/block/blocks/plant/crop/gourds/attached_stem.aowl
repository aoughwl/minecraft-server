## Port of pumpkin/src/block/blocks/plant/crop/gourds/attached_stem.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../../blockprelude
import ../../plantmod


type
  AttachedStemProperties = WallTorchLikeProperties
  StemProperties = WheatLikeProperties
  AttachedStemBlock* = object

var gAttachedStemBlockAsPlantBlockBase: nil PlantBlockBase


proc attachedStemBlockIds*(): seq[BlockId]
proc getStem*(blockRef: Block): Block
proc getGourd*(blockRef: Block): Block
proc attachedStemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc attachedStemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newAttachedStemBlock*(): BlockBehaviour
proc attachedStemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc attachedStemBlockAsPlantBlockBase*(): PlantBlockBase

proc attachedStemBlockIds*(): seq[BlockId] =
  @[blockIdAttachedPumpkinStem, blockIdAttachedMelonStem]

proc getStem*(blockRef: Block): Block =
  if (blockRef.id == blockAttachedPumpkinStem().id):
    let id = blockRef.id
    blockPumpkinStem()
  elif (blockRef.id == blockAttachedMelonStem().id):
    let id = blockRef.id
    blockMelonStem()
  else:
    blockMelonStem()

proc getGourd*(blockRef: Block): Block =
  if (blockRef.id == blockAttachedPumpkinStem().id):
    let id = blockRef.id
    blockPumpkin()
  elif (blockRef.id == blockAttachedMelonStem().id):
    let id = blockRef.id
    blockMelon()
  else:
    blockMelon()

proc attachedStemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(attachedStemBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc attachedStemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let props = AttachedStemProperties.fromStateId(args.stateId, args.block0)
  if (args.direction.toHorizontalFacing() == (true, props.facing)) and (not (args.neighborStateId == getGourd(args.block0).defaultState.id)):
    var props1 = StemProperties.defaultFor(getStem(args.block0))
    props1.age = 7
    return props1.toStateId(getStem(args.block0))
  getStateForNeighborUpdate(attachedStemBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newAttachedStemBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = attachedStemBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = attachedStemBlockGetStateForNeighborUpdate_BlockBehaviour

proc attachedStemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  if (blockRef == blockAttachedPumpkinStem()):
    blockRef.hasTag(Block_MINECRAFT_SUPPORTS_PUMPKIN_STEM)
  else:
    blockRef.hasTag(Block_MINECRAFT_SUPPORTS_MELON_STEM)

proc attachedStemBlockAsPlantBlockBase*(): PlantBlockBase =
  if gAttachedStemBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = attachedStemBlockCanPlantOnTop_PlantBlockBase
    gAttachedStemBlockAsPlantBlockBase = v
  gAttachedStemBlockAsPlantBlockBase

proc registerBlocksPlantCropGourdsAttachedStem*(r: BlockRegistry) =
  r.registerIds(attachedStemBlockIds(), newAttachedStemBlock())

