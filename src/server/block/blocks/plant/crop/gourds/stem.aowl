## Port of pumpkin/src/block/blocks/plant/crop/gourds/stem.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../../blockprelude
import ../cropmod
import ../../plantmod


type
  StemProperties = WheatLikeProperties
  AttachedStemProperties = WallTorchLikeProperties
  StemBlock* = object

var gStemBlockAsPlantBlockBase: nil PlantBlockBase


proc stemBlockIds*(): seq[BlockId]
proc stateWithAge*(blockRef: Block, state: BlockStateId, age: int32): BlockStateId
proc getAttachedStem*(dir: HorizontalFacing, blockRef: Block): BlockStateId
proc getGourd*(blockRef: Block): Block
proc stemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc stemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc stemBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newStemBlock*(): BlockBehaviour
proc stemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc stemBlockAsPlantBlockBase*(): PlantBlockBase

proc stemBlockIds*(): seq[BlockId] =
  @[blockIdPumpkinStem, blockIdMelonStem]

proc stateWithAge*(blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  var props = StemProperties.fromStateId(state, blockRef)
  props.age = uint8(age)
  props.toStateId(blockRef)

proc getAttachedStem*(dir: HorizontalFacing, blockRef: Block): BlockStateId =
  let t1 = block:
    if (blockRef.id == blockPumpkinStem().id):
      let id = blockRef.id
      blockAttachedPumpkinStem()
    elif (blockRef.id == blockMelonStem().id):
      let id = blockRef.id
      blockAttachedMelonStem()
    else:
      blockAttachedMelonStem()
  let attachedBlock = t1
  var props = AttachedStemProperties.defaultFor(attachedBlock)
  props.facing = dir
  props.toStateId(attachedBlock)

proc getGourd*(blockRef: Block): Block =
  if (blockRef.id == blockPumpkinStem().id):
    let id = blockRef.id
    blockPumpkin()
  elif (blockRef.id == blockMelonStem().id):
    let id = blockRef.id
    blockMelon()
  else:
    blockMelon()

proc stemBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(stemBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc stemBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(stemBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc stemBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  # TODO add light level check
  let f: float32 = getAvailableMoisture(args.world, args.position, args.block0)
  if (rng().randomRange(0'i32 .. int32(floor(float64(25.0'f32 / f)))) == 0'i32):
    let (blockRef, state) = args.world.getBlockAndStateId(args.position)
    let props = StemProperties.fromStateId(state, blockRef)
    let age = int32(props.age)
    if (age < 7'i32):
      discard args.world.setBlockState(args.position, stateWithAge(blockRef, state, (age + 1'i32)), BfNotifyNeighbors)
    else:
      # `Xoroshiro::from_seed(random())` only feeds the one draw
      let dir = BlockDirection.randomHorizontal(proc(bound: int32): int32 {.closure.} = int32(rng().randomRange(0'i32 ..< bound)))
      let plantBlockPos = args.position.offset(dir.toBlockDirection().toOffset())
      let plantBlockState = args.world.getBlockState(plantBlockPos)
      let underBlock: Block = args.world.getBlock(plantBlockPos.down())
      if plantBlockState.isAir() and (((underBlock == blockFarmland()) or underBlock.hasTag(Block_MINECRAFT_DIRT))):
        let attachedStem = getAttachedStem(dir, blockRef)
        let gourd = getGourd(blockRef)
        discard args.world.setBlockState(plantBlockPos, gourd.defaultState.id, BfNotifyNeighbors)
        discard args.world.setBlockState(args.position, attachedStem, BfNotifyNeighbors)

proc newStemBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = stemBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = stemBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = stemBlockRandomTick_BlockBehaviour

proc stemBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  if (blockRef == blockPumpkinStem()):
    blockRef.hasTag(Block_MINECRAFT_SUPPORTS_PUMPKIN_STEM)
  else:
    blockRef.hasTag(Block_MINECRAFT_SUPPORTS_MELON_STEM)

proc stemBlockAsPlantBlockBase*(): PlantBlockBase =
  if gStemBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = stemBlockCanPlantOnTop_PlantBlockBase
    gStemBlockAsPlantBlockBase = v
  gStemBlockAsPlantBlockBase

proc registerBlocksPlantCropGourdsStem*(r: BlockRegistry) =
  r.registerIds(stemBlockIds(), newStemBlock())

