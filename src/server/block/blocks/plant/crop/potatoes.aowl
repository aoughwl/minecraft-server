## Port of pumpkin/src/block/blocks/plant/crop/potatoes.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import cropmod
import ../plantmod


type
  PotatoBlock* = object

var gPotatoBlockAsPlantBlockBase: nil PlantBlockBase
var gPotatoBlockAsCropBlockBase: nil CropBlockBase


proc potatoBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc potatoBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc potatoBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newPotatoBlock*(): BlockBehaviour
proc potatoBlockAsPlantBlockBase*(): PlantBlockBase
proc potatoBlockAsCropBlockBase*(): CropBlockBase

proc potatoBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlantOnTop(potatoBlockAsCropBlockBase(), args.blockAccessor, args.position.down())

proc potatoBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(potatoBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc potatoBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  randomTick(potatoBlockAsCropBlockBase(), args.world, args.position)

proc newPotatoBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = potatoBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = potatoBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = potatoBlockRandomTick_BlockBehaviour

proc potatoBlockAsPlantBlockBase*(): PlantBlockBase =
  if gPotatoBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gPotatoBlockAsPlantBlockBase = v
  gPotatoBlockAsPlantBlockBase

proc potatoBlockAsCropBlockBase*(): CropBlockBase =
  if gPotatoBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.plantBlockBase = potatoBlockAsPlantBlockBase()
    gPotatoBlockAsCropBlockBase = v
  gPotatoBlockAsCropBlockBase

proc registerBlocksPlantCropPotatoes*(r: BlockRegistry) =
  r.register("minecraft:potatoes", newPotatoBlock())

