import ../../../blockprelude
import cropmod
import ../plantmod


type
  SweetBerryBushBlock* = object

var gSweetBerryBushBlockAsPlantBlockBase: nil PlantBlockBase
var gSweetBerryBushBlockAsCropBlockBase: nil CropBlockBase


proc dropSweetBerries(world: BlockWorld, position: BlockPos, count: int32) =
  var dropped = 0'i32
  while dropped < count:
    world.dropStack(position, newItemStack(1'u8, ITEM_SWEET_BERRIES))
    dropped += 1'i32

proc sweetBerryBushBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  var props = NetherWartLikeProperties.fromStateId(stateId, args.block0)
  if props.age == 2'u8 or props.age == 3'u8:
    let index = props.age
    props.age = 1'u8
    # `random_range((index - 1)..=(index))`
    let lowest = int32(index) - 1'i32
    let count = uint8(lowest + int32(rng().randomRange(0'i32 .. 1'i32)))
    dropSweetBerries(args.world, args.position, int32(count))
    discard args.world.setBlockState(args.position, props.toStateId(blockSweetBerryBush()), BfNotifyAll)
    barSuccessServer
  else:
    barPass

proc sweetBerryBushBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc sweetBerryBushBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc sweetBerryBushBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc sweetBerryBushBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc sweetBerryBushBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newSweetBerryBushBlock*(): BlockBehaviour
proc sweetBerryBushBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc sweetBerryBushBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc sweetBerryBushBlockAsPlantBlockBase*(): PlantBlockBase
proc sweetBerryBushBlockCanPlantOnTop_CropBlockBase(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc sweetBerryBushBlockMaxAge_CropBlockBase(self: CropBlockBase): int32
proc sweetBerryBushBlockGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32
proc sweetBerryBushBlockStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId
proc sweetBerryBushBlockRandomTick_CropBlockBase(self: CropBlockBase, world: BlockWorld, pos: BlockPos)
proc sweetBerryBushBlockAsCropBlockBase*(): CropBlockBase

proc sweetBerryBushBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let stateId = args.world.getBlockStateId(args.position)
  let props = NetherWartLikeProperties.fromStateId(stateId, blockSweetBerryBush())
  if (not (props.age == 3)) and (args.itemStack.stack.getItem() == ITEM_BONE_MEAL):
    barPass
  else:
    barPassToDefaultBlockAction

proc sweetBerryBushBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(sweetBerryBushBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc sweetBerryBushBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(sweetBerryBushBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc sweetBerryBushBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let entity = args.entity.getEntity()
  let livingEntityOpt = args.entity.getLivingEntity()
  if livingEntityOpt.isNone() or entity.entityTypeName == "fox" or entity.entityTypeName == "bee":
    return
  let livingEntity = livingEntityOpt.get()
  entity.slowMovement(args.state, vec3[float64](0.8, 0.75, 0.8))
  let lastPos = entity.lastPos()
  let curPos = entity.pos
  var mov = vec3[float64](lastPos.x - curPos.x, lastPos.y - curPos.y, lastPos.z - curPos.z)
  if livingEntity.isPlayer():
    mov = livingEntity.getMovement()
  let stateId = args.world.getBlockStateId(args.position)
  let props = NetherWartLikeProperties.fromStateId(stateId, args.block0)
  if props.age == 0'u8:
    return
  # `horizontal_length_squared() <= 0.0 || (|x| < 0.003 && |z| < 0.003)`
  if mov.x * mov.x + mov.z * mov.z <= 0.0 or ((mov.x < 0.003 and mov.x > -0.003) and (mov.z < 0.003 and mov.z > -0.003)):
    return
  discard args.entity.damage(1.0'f32, "sweet_berry_bush")

proc sweetBerryBushBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  if (rng().randomRange(0 ..< 5) == 0):
    randomTick(sweetBerryBushBlockAsCropBlockBase(), args.world, args.position)

proc newSweetBerryBushBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = sweetBerryBushBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = sweetBerryBushBlockUseWithItem_BlockBehaviour
  result.canPlaceAtImpl = sweetBerryBushBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = sweetBerryBushBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onEntityCollisionImpl = sweetBerryBushBlockOnEntityCollision_BlockBehaviour
  result.randomTickImpl = sweetBerryBushBlockRandomTick_BlockBehaviour

proc sweetBerryBushBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(sweetBerryBushBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockAir().defaultState.id
  blockState

proc sweetBerryBushBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  canPlantOnTop(sweetBerryBushBlockAsPlantBlockBase(), blockAccessor, blockPos.down())

proc sweetBerryBushBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSweetBerryBushBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.getStateForNeighborUpdateImpl = sweetBerryBushBlockGetStateForNeighborUpdate_PlantBlockBase
    v.canPlaceAtImpl = sweetBerryBushBlockCanPlaceAt_PlantBlockBase
    gSweetBerryBushBlockAsPlantBlockBase = v
  gSweetBerryBushBlockAsPlantBlockBase

proc sweetBerryBushBlockCanPlantOnTop_CropBlockBase(self: CropBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  canPlantOnTop(sweetBerryBushBlockAsPlantBlockBase(), blockAccessor, pos)

proc sweetBerryBushBlockMaxAge_CropBlockBase(self: CropBlockBase): int32 =
  3

proc sweetBerryBushBlockGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 =
  let props = NetherWartLikeProperties.fromStateId(state, blockRef)
  int32(props.age)

proc sweetBerryBushBlockStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  var props = NetherWartLikeProperties.fromStateId(state, blockRef)
  props.age = uint8(age)
  props.toStateId(blockRef)

proc sweetBerryBushBlockRandomTick_CropBlockBase(self: CropBlockBase, world: BlockWorld, pos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(pos)
  let age = getAge(sweetBerryBushBlockAsCropBlockBase(), state, blockRef)
  if (age < maxAge(sweetBerryBushBlockAsCropBlockBase())):
    let stateAbove = world.getBlockState(pos.up())
    if (stateAbove.isFullCube() or stateAbove.isSolid()):
      return
    discard world.setBlockState(pos, stateWithAge(sweetBerryBushBlockAsCropBlockBase(), blockRef, state, (age + 1)), BfNotifyNeighbors)

proc sweetBerryBushBlockAsCropBlockBase*(): CropBlockBase =
  if gSweetBerryBushBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.canPlantOnTopImpl = sweetBerryBushBlockCanPlantOnTop_CropBlockBase
    v.maxAgeImpl = sweetBerryBushBlockMaxAge_CropBlockBase
    v.getAgeImpl = sweetBerryBushBlockGetAge_CropBlockBase
    v.stateWithAgeImpl = sweetBerryBushBlockStateWithAge_CropBlockBase
    v.randomTickImpl = sweetBerryBushBlockRandomTick_CropBlockBase
    v.plantBlockBase = sweetBerryBushBlockAsPlantBlockBase()
    gSweetBerryBushBlockAsCropBlockBase = v
  gSweetBerryBushBlockAsCropBlockBase

proc registerBlocksPlantCropSweetBerryBush*(r: BlockRegistry) =
  r.register("minecraft:sweet_berry_bush", newSweetBerryBushBlock())

