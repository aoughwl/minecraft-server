  3

proc sweetBerryBushBlockGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 =
  let props = NetherWartLikeProperties.fromStateId(state, blockRef)
  int32(props.age)

proc sweetBerryBushBlockStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  var props = NetherWartLikeProperties.fromStateId(state, blockRef)
  props.age = uint8(age)
  props.toStateId(blockRef)

proc sweetBerryBushBlockRandomTick_CropBlockBase(self: CropBlockBase, world: BlockWorld, pos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(pos)
  let age = getAge(sweetBerryBushBlockAsCropBlockBase(), state, blockRef)
  if (age < maxAge(sweetBerryBushBlockAsCropBlockBase())):
    let stateAbove = world.getBlockState(pos.up())
    if (stateAbove.isFullCube() or stateAbove.isSolid()):
      return
    discard world.setBlockState(pos, stateWithAge(sweetBerryBushBlockAsCropBlockBase(), blockRef, state, (age + 1)), BfNotifyNeighbors)

proc sweetBerryBushBlockAsCropBlockBase*(): CropBlockBase =
  if gSweetBerryBushBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.canPlantOnTopImpl = sweetBerryBushBlockCanPlantOnTop_CropBlockBase
    v.maxAgeImpl = sweetBerryBushBlockMaxAge_CropBlockBase
    v.getAgeImpl = sweetBerryBushBlockGetAge_CropBlockBase
    v.stateWithAgeImpl = sweetBerryBushBlockStateWithAge_CropBlockBase
    v.randomTickImpl = sweetBerryBushBlockRandomTick_CropBlockBase
    v.plantBlockBase = sweetBerryBushBlockAsPlantBlockBase()
    gSweetBerryBushBlockAsCropBlockBase = v
  gSweetBerryBushBlockAsCropBlockBase

