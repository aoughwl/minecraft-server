  result = newBlockBehaviour()
  result.normalUseImpl = sweetBerryBushBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = sweetBerryBushBlockUseWithItem_BlockBehaviour
  result.canPlaceAtImpl = sweetBerryBushBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = sweetBerryBushBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onEntityCollisionImpl = sweetBerryBushBlockOnEntityCollision_BlockBehaviour
  result.randomTickImpl = sweetBerryBushBlockRandomTick_BlockBehaviour

proc sweetBerryBushBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(sweetBerryBushBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockAir().defaultState.id
  blockState

proc sweetBerryBushBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  canPlantOnTop(sweetBerryBushBlockAsPlantBlockBase(), blockAccessor, blockPos.down())

proc sweetBerryBushBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSweetBerryBushBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.getStateForNeighborUpdateImpl = sweetBerryBushBlockGetStateForNeighborUpdate_PlantBlockBase
    v.canPlaceAtImpl = sweetBerryBushBlockCanPlaceAt_PlantBlockBase
    gSweetBerryBushBlockAsPlantBlockBase = v
