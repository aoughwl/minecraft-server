## Port of pumpkin/src/block/blocks/plant/crop/torch_flower.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import ../plantmod
import cropmod


type
  TorchFlowerProperties = TorchflowerCropLikeProperties
  TorchFlowerBlock* = object

var gTorchFlowerBlockAsPlantBlockBase: nil PlantBlockBase
var gTorchFlowerBlockAsCropBlockBase: nil CropBlockBase


proc torchFlowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc torchFlowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc torchFlowerBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newTorchFlowerBlock*(): BlockBehaviour
proc torchFlowerBlockAsPlantBlockBase*(): PlantBlockBase
proc torchFlowerBlockMaxAge_CropBlockBase(self: CropBlockBase): int32
proc torchFlowerBlockGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32
proc torchFlowerBlockStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId
proc torchFlowerBlockAsCropBlockBase*(): CropBlockBase

proc torchFlowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlantOnTop(torchFlowerBlockAsCropBlockBase(), args.blockAccessor, args.position.down())

proc torchFlowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(torchFlowerBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc torchFlowerBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  if (not (rng().randomRange(0 ..< 2) == 0)):
    randomTick(torchFlowerBlockAsCropBlockBase(), args.world, args.position)

proc newTorchFlowerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = torchFlowerBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = torchFlowerBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = torchFlowerBlockRandomTick_BlockBehaviour

proc torchFlowerBlockAsPlantBlockBase*(): PlantBlockBase =
  if gTorchFlowerBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gTorchFlowerBlockAsPlantBlockBase = v
  gTorchFlowerBlockAsPlantBlockBase

proc torchFlowerBlockMaxAge_CropBlockBase(self: CropBlockBase): int32 =
  2

proc torchFlowerBlockGetAge_CropBlockBase(self: CropBlockBase, state: BlockStateId, blockRef: Block): int32 =
  let props = TorchFlowerProperties.fromStateId(state, blockRef)
  int32(props.age)

proc torchFlowerBlockStateWithAge_CropBlockBase(self: CropBlockBase, blockRef: Block, state: BlockStateId, age: int32): BlockStateId =
  if (age == 1):
    var properties = TorchFlowerProperties.fromStateId(state, blockRef)
    properties.age = 1
    properties.toStateId(blockRef)
  else:
    blockTorchflower().defaultState.id

proc torchFlowerBlockAsCropBlockBase*(): CropBlockBase =
  if gTorchFlowerBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.maxAgeImpl = torchFlowerBlockMaxAge_CropBlockBase
    v.getAgeImpl = torchFlowerBlockGetAge_CropBlockBase
    v.stateWithAgeImpl = torchFlowerBlockStateWithAge_CropBlockBase
    v.plantBlockBase = torchFlowerBlockAsPlantBlockBase()
    gTorchFlowerBlockAsCropBlockBase = v
  gTorchFlowerBlockAsCropBlockBase

proc registerBlocksPlantCropTorchFlower*(r: BlockRegistry) =
  r.register("minecraft:torchflower_crop", newTorchFlowerBlock())

