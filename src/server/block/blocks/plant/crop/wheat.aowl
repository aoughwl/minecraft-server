## Port of pumpkin/src/block/blocks/plant/crop/wheat.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import ../plantmod
import cropmod


type
  WheatBlock* = object

var gWheatBlockAsPlantBlockBase: nil PlantBlockBase
var gWheatBlockAsCropBlockBase: nil CropBlockBase


proc wheatBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc wheatBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc wheatBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newWheatBlock*(): BlockBehaviour
proc wheatBlockAsPlantBlockBase*(): PlantBlockBase
proc wheatBlockAsCropBlockBase*(): CropBlockBase

proc wheatBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlantOnTop(wheatBlockAsCropBlockBase(), args.blockAccessor, args.position.down())

proc wheatBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(wheatBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc wheatBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  randomTick(wheatBlockAsCropBlockBase(), args.world, args.position)

proc newWheatBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = wheatBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = wheatBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = wheatBlockRandomTick_BlockBehaviour

proc wheatBlockAsPlantBlockBase*(): PlantBlockBase =
  if gWheatBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gWheatBlockAsPlantBlockBase = v
  gWheatBlockAsPlantBlockBase

proc wheatBlockAsCropBlockBase*(): CropBlockBase =
  if gWheatBlockAsCropBlockBase == nil:
    let v = newCropBlockBase()
    v.plantBlockBase = wheatBlockAsPlantBlockBase()
    gWheatBlockAsCropBlockBase = v
  gWheatBlockAsCropBlockBase

proc registerBlocksPlantCropWheat*(r: BlockRegistry) =
  r.register("minecraft:wheat", newWheatBlock())

