import ../../blockprelude
import plantmod


type
  DryVegetationBlock* = object

var gDryVegetationBlockAsPlantBlockBase: nil PlantBlockBase


proc dryVegetationBlockIds*(): seq[BlockId]
proc dryVegetationBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc dryVegetationBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newDryVegetationBlock*(): BlockBehaviour
proc dryVegetationBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc dryVegetationBlockAsPlantBlockBase*(): PlantBlockBase

proc dryVegetationBlockIds*(): seq[BlockId] =
  @[blockIdDeadBush, blockIdTallDryGrass, blockIdShortDryGrass]

proc dryVegetationBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(dryVegetationBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc dryVegetationBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(dryVegetationBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newDryVegetationBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = dryVegetationBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = dryVegetationBlockGetStateForNeighborUpdate_BlockBehaviour

proc dryVegetationBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  let blockBelow = blockAccessor.getBlock(blockPos)
  blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_DRY_VEGETATION)

proc dryVegetationBlockAsPlantBlockBase*(): PlantBlockBase =
  if gDryVegetationBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = dryVegetationBlockCanPlantOnTop_PlantBlockBase
    gDryVegetationBlockAsPlantBlockBase = v
  gDryVegetationBlockAsPlantBlockBase

proc registerBlocksPlantDryVegetation*(r: BlockRegistry) =
  r.registerIds(dryVegetationBlockIds(), newDryVegetationBlock())

