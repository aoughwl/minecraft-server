## Port of pumpkin/src/block/blocks/plant/flower.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  FlowerBlock* = object

var gFlowerBlockAsPlantBlockBase: nil PlantBlockBase


proc flowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc flowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc flowerBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newFlowerBlock*(): BlockBehaviour
proc flowerBlockAsPlantBlockBase*(): PlantBlockBase

proc flowerBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(flowerBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc flowerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(flowerBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc flowerBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  # TODO add trail particule
  if ((args.world.dimension.eq(Dimension.OVERWORLD) or args.world.dimension.eq(Dimension.OVERWORLD_CAVES))) and args.block0.eq(blockClosedEyeblossom()) and ((args.world.levelTime.timeOfDay mod 24000) > 14500):
    discard args.world.setBlockState(args.position, blockOpenEyeblossom().defaultState.id, BfNotifyAll)
  if args.block0.eq(blockOpenEyeblossom()) and ((args.world.levelTime.timeOfDay mod 24000) <= 14500):
    discard args.world.setBlockState(args.position, blockClosedEyeblossom().defaultState.id, BfNotifyAll)

proc newFlowerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = flowerBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = flowerBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = flowerBlockRandomTick_BlockBehaviour

proc flowerBlockAsPlantBlockBase*(): PlantBlockBase =
  if gFlowerBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gFlowerBlockAsPlantBlockBase = v
  gFlowerBlockAsPlantBlockBase

proc registerBlocksPlantFlower*(r: BlockRegistry) =
  r.registerTag("minecraft:small_flowers", newFlowerBlock())

