## Port of pumpkin/src/block/blocks/plant/flowerbed.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import segmented
import plantmod


type
  FlowerbedProperties = PinkPetalsLikeProperties
  FlowerbedBlock* = object

var gFlowerbedBlockAsPlantBlockBase: nil PlantBlockBase
var gFlowerbedBlockAsSegmented: nil Segmented


proc flowerbedBlockIds*(): seq[BlockId]
proc flowerbedBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc flowerbedBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool
proc flowerbedBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc flowerbedBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newFlowerbedBlock*(): BlockBehaviour
proc flowerbedBlockAsPlantBlockBase*(): PlantBlockBase
proc flowerbedBlockAsSegmented*(): Segmented

proc flowerbedBlockIds*(): seq[BlockId] =
  @[blockIdPinkPetals, blockIdWildflowers]

proc flowerbedBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let blockBelow = args.blockAccessor.getBlock(args.position.down())
  (blockBelow.hasTag(Block_MINECRAFT_DIRT) or (blockBelow == blockFarmland()))

proc flowerbedBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  canUpdateAt(flowerbedBlockAsSegmented(), args)

proc flowerbedBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  onPlace(flowerbedBlockAsSegmented(), args)

proc flowerbedBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(flowerbedBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newFlowerbedBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = flowerbedBlockCanPlaceAt_BlockBehaviour
  result.canUpdateAtImpl = flowerbedBlockCanUpdateAt_BlockBehaviour
  result.onPlaceImpl = flowerbedBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = flowerbedBlockGetStateForNeighborUpdate_BlockBehaviour

proc flowerbedBlockAsPlantBlockBase*(): PlantBlockBase =
  if gFlowerbedBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gFlowerbedBlockAsPlantBlockBase = v
  gFlowerbedBlockAsPlantBlockBase

proc flowerbedBlockAsSegmented*(): Segmented =
  if gFlowerbedBlockAsSegmented == nil:
    let v = newSegmented()
    v.blockBehaviour = flowerbedBlockAsBlockBehaviour()
    gFlowerbedBlockAsSegmented = v
  gFlowerbedBlockAsSegmented

proc registerBlocksPlantFlowerbed*(r: BlockRegistry) =
  r.registerIds(flowerbedBlockIds(), newFlowerbedBlock())

