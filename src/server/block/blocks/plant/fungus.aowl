## Port of pumpkin/src/block/blocks/plant/fungus.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  FungusBlock* = object

var gFungusBlockAsPlantBlockBase: nil PlantBlockBase


proc fungusBlockIds*(): seq[BlockId]
proc fungusBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc fungusBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newFungusBlock*(): BlockBehaviour
proc fungusBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc fungusBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc fungusBlockAsPlantBlockBase*(): PlantBlockBase

proc fungusBlockIds*(): seq[BlockId] =
  @[blockIdCrimsonFungus, blockIdWarpedFungus]

proc fungusBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(fungusBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc fungusBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(fungusBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newFungusBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = fungusBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = fungusBlockGetStateForNeighborUpdate_BlockBehaviour

proc fungusBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  if (blockRef == blockWarpedFungus()):
    return blockRef.hasTag(Block_MINECRAFT_SUPPORTS_WARPED_FUNGUS)
  blockRef.hasTag(Block_MINECRAFT_SUPPORTS_CRIMSON_FUNGUS)

proc fungusBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  canPlantOnTop(fungusBlockAsPlantBlockBase(), blockAccessor, blockPos.down())

proc fungusBlockAsPlantBlockBase*(): PlantBlockBase =
  if gFungusBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = fungusBlockCanPlantOnTop_PlantBlockBase
    v.canPlaceAtImpl = fungusBlockCanPlaceAt_PlantBlockBase
    gFungusBlockAsPlantBlockBase = v
  gFungusBlockAsPlantBlockBase

proc registerBlocksPlantFungus*(r: BlockRegistry) =
  r.registerIds(fungusBlockIds(), newFungusBlock())

