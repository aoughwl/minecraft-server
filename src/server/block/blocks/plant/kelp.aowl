## Port of pumpkin/src/block/blocks/plant/kelp.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  KelpBlock* = object

var gKelpBlockAsPlantBlockBase: nil PlantBlockBase


proc kelpBlockIds*(): seq[BlockId]
proc kelpBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc kelpBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc kelpBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc kelpBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newKelpBlock*(): BlockBehaviour
proc kelpBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc kelpBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc kelpBlockAsPlantBlockBase*(): PlantBlockBase

proc kelpBlockIds*(): seq[BlockId] =
  @[blockIdKelp, blockIdKelpPlant]

proc kelpBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(kelpBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc kelpBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(kelpBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc kelpBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let supportPos = args.position.down()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockKelp()):
    discard args.world.setBlockState(supportPos, blockKelpPlant().defaultState.id, 0'u32)

proc kelpBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let supportPos = args.position.down()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockKelpPlant()):
    discard args.world.setBlockState(supportPos, blockKelp().defaultState.id, 0'u32)
    discard args.world.setBlockState(args.position, blockWater().defaultState.id, 0'u32)

proc newKelpBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = kelpBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = kelpBlockGetStateForNeighborUpdate_BlockBehaviour
  result.placedImpl = kelpBlockPlaced_BlockBehaviour
  result.brokenImpl = kelpBlockBroken_BlockBehaviour

proc kelpBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  # Determine support block
  let supportPos = pos
  let (replacingBlock, replacingBlockState) = blockAccessor.getBlockAndState(pos.up())
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(supportPos)
  if (replacingBlock == blockWater()):
    let waterProps = WaterLikeProperties.fromStateId(replacingBlockState.id, replacingBlock)
    # Only allow placing kelp on either full water or downward flowing water
    if (waterProps.level != 0) and (waterProps.level != 8):
      return false
  else:
    # Replacing block can also be a kelp_plant or kelp in case this is an neighbour update check
    if (replacingBlock != blockKelpPlant()) and (replacingBlock != blockKelp()):
      return false
  # If placing the base kelp block, allow placement on water or on other kelp segments.
  if ((supportBlock == blockKelp()) or (supportBlock == blockKelpPlant())):
    return true
  if supportBlock.hasTag(Block_MINECRAFT_CANNOT_SUPPORT_KELP):
    return false
  if supportBlockState.isSideSolid(BlockDirection.Up) and supportBlock.isSolid():
    return true
  false

proc kelpBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(kelpBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockWater().defaultState.id
  blockState

proc kelpBlockAsPlantBlockBase*(): PlantBlockBase =
  if gKelpBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = kelpBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = kelpBlockGetStateForNeighborUpdate_PlantBlockBase
    gKelpBlockAsPlantBlockBase = v
  gKelpBlockAsPlantBlockBase

proc registerBlocksPlantKelp*(r: BlockRegistry) =
  r.registerIds(kelpBlockIds(), newKelpBlock())

