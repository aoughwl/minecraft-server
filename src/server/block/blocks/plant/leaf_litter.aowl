proc leafLitterBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let blockBelow = args.blockAccessor.getBlockState(args.position.down())
  blockBelow.isSideSolid(BlockDirection.Up)

proc leafLitterBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  canUpdateAt(leafLitterBlockAsSegmented(), args)

proc leafLitterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  onPlace(leafLitterBlockAsSegmented(), args)

proc leafLitterBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.direction == BlockDirection.Down):
    let blockBelowState = args.world.getBlockState(args.position.down())
    if (not blockBelowState.isSideSolid(BlockDirection.Up)):
      return blockAir().defaultState.id
  args.stateId

proc newLeafLitterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = leafLitterBlockCanPlaceAt_BlockBehaviour
  result.canUpdateAtImpl = leafLitterBlockCanUpdateAt_BlockBehaviour
  result.onPlaceImpl = leafLitterBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = leafLitterBlockGetStateForNeighborUpdate_BlockBehaviour

