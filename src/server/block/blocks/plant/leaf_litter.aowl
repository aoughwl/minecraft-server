  if gLeafLitterBlockAsSegmented == nil:
    let v = newSegmented()
    v.blockBehaviour = leafLitterBlockAsBlockBehaviour()
    gLeafLitterBlockAsSegmented = v
  gLeafLitterBlockAsSegmented

