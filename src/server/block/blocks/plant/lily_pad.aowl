## Port of pumpkin/src/block/blocks/plant/lily_pad.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/strutils
import ../../blockprelude
import plantmod


type
  LilyPadBlock* = object

var gLilyPadBlockAsPlantBlockBase: nil PlantBlockBase


proc lilyPadBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc lilyPadBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc lilyPadBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newLilyPadBlock*(): BlockBehaviour
proc lilyPadBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc lilyPadBlockAsPlantBlockBase*(): PlantBlockBase

proc lilyPadBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  # Proberbly not the best solution, but works
  if args.entity.getEntity().entityTypeName.endsWith("_boat"):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc lilyPadBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(lilyPadBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc lilyPadBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(lilyPadBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newLilyPadBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = lilyPadBlockOnEntityCollision_BlockBehaviour
  result.canPlaceAtImpl = lilyPadBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = lilyPadBlockGetStateForNeighborUpdate_BlockBehaviour

proc lilyPadBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  # TODO: get and use fluids not blocks
  let blockRef = blockAccessor.getBlock(pos)
  let aboveFluid = blockAccessor.getBlock(pos.up())
  (((blockRef.hasTag(Fluid_MINECRAFT_SUPPORTS_LILY_PAD) or blockRef.hasTag(Block_MINECRAFT_SUPPORTS_LILY_PAD))) and aboveFluid.isAir())

proc lilyPadBlockAsPlantBlockBase*(): PlantBlockBase =
  if gLilyPadBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = lilyPadBlockCanPlantOnTop_PlantBlockBase
    gLilyPadBlockAsPlantBlockBase = v
  gLilyPadBlockAsPlantBlockBase

proc registerBlocksPlantLilyPad*(r: BlockRegistry) =
  r.register("minecraft:lily_pad", newLilyPadBlock())

