{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  MushroomPlantBlock* = object

var gMushroomPlantBlockAsPlantBlockBase: nil PlantBlockBase


proc mushroomPlantBlockIds*(): seq[BlockId]
proc mushroomPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc mushroomPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newMushroomPlantBlock*(): BlockBehaviour
proc mushroomPlantBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc mushroomPlantBlockAsPlantBlockBase*(): PlantBlockBase

proc mushroomPlantBlockIds*(): seq[BlockId] =
  @[blockIdBrownMushroom, blockIdRedMushroom]

proc mushroomPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(mushroomPlantBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc mushroomPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(mushroomPlantBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newMushroomPlantBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = mushroomPlantBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = mushroomPlantBlockGetStateForNeighborUpdate_BlockBehaviour

proc mushroomPlantBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef.hasTag(Block_MINECRAFT_OVERRIDES_MUSHROOM_LIGHT_REQUIREMENT)

proc mushroomPlantBlockAsPlantBlockBase*(): PlantBlockBase =
  if gMushroomPlantBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = mushroomPlantBlockCanPlantOnTop_PlantBlockBase
    gMushroomPlantBlockAsPlantBlockBase = v
  gMushroomPlantBlockAsPlantBlockBase

proc registerBlocksPlantMushroomPlant*(r: BlockRegistry) =
  r.registerIds(mushroomPlantBlockIds(), newMushroomPlantBlock())

