type
  NetherSproutsBlock* = object

var gNetherSproutsBlockAsPlantBlockBase: nil PlantBlockBase


proc netherSproutsBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc netherSproutsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newNetherSproutsBlock*(): BlockBehaviour
proc netherSproutsBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc netherSproutsBlockAsPlantBlockBase*(): PlantBlockBase

proc netherSproutsBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(netherSproutsBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc netherSproutsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(netherSproutsBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newNetherSproutsBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = netherSproutsBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = netherSproutsBlockGetStateForNeighborUpdate_BlockBehaviour

proc netherSproutsBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef.hasTag(Block_MINECRAFT_SUPPORTS_NETHER_SPROUTS)

proc netherSproutsBlockAsPlantBlockBase*(): PlantBlockBase =
  if gNetherSproutsBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = netherSproutsBlockCanPlantOnTop_PlantBlockBase
    gNetherSproutsBlockAsPlantBlockBase = v
  gNetherSproutsBlockAsPlantBlockBase

proc registerBlocksPlantNetherSprouts*(r: BlockRegistry) =
  r.register("minecraft:nether_sprouts", newNetherSproutsBlock())

