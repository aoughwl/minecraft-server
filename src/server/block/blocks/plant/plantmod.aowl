## Port of pumpkin/src/block/blocks/plant/mod.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  PlantBlockBase* = ref object
    canPlantOnTopImpl*: proc(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool {.closure.}
    getStateForNeighborUpdateImpl*: proc(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId {.closure.}
    canPlaceAtImpl*: proc(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool {.closure.}



proc canPlantOnTop*(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc defaultCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc getStateForNeighborUpdate*(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc defaultGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc canPlaceAt*(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc defaultCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc newPlantBlockBase*(): PlantBlockBase

proc defaultCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockRef = blockAccessor.getBlock(pos)
  blockRef.hasTag(Block_MINECRAFT_SUPPORTS_VEGETATION)

proc defaultGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not self.canPlaceAt(blockAccessor, blockPos)):
    return blockAir().defaultState.id
  blockState

proc defaultCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  self.canPlantOnTop(blockAccessor, blockPos.down())

proc canPlantOnTop*(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let f = self.canPlantOnTopImpl
  f(self, blockAccessor, pos)

proc getStateForNeighborUpdate*(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  let f = self.getStateForNeighborUpdateImpl
  f(self, blockAccessor, blockPos, blockState)

proc canPlaceAt*(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  let f = self.canPlaceAtImpl
  f(self, blockAccessor, blockPos)

proc newPlantBlockBase*(): PlantBlockBase =
  result = PlantBlockBase()
  result.canPlantOnTopImpl = defaultCanPlantOnTop_PlantBlockBase
  result.getStateForNeighborUpdateImpl = defaultGetStateForNeighborUpdate_PlantBlockBase
  result.canPlaceAtImpl = defaultCanPlaceAt_PlantBlockBase

