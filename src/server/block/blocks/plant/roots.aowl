## Port of pumpkin/src/block/blocks/plant/roots.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  RootsBlock* = object

var gRootsBlockAsPlantBlockBase: nil PlantBlockBase


proc rootsBlockIds*(): seq[BlockId]
proc rootsBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc rootsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newRootsBlock*(): BlockBehaviour
proc rootsBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc rootsBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc rootsBlockAsPlantBlockBase*(): PlantBlockBase

proc rootsBlockIds*(): seq[BlockId] =
  @[blockIdWarpedRoots, blockIdCrimsonRoots]

proc rootsBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(rootsBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc rootsBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(rootsBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newRootsBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = rootsBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = rootsBlockGetStateForNeighborUpdate_BlockBehaviour

proc rootsBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let blockBelow = blockAccessor.getBlock(pos)
  if (blockBelow == blockWarpedRoots()):
    blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_WARPED_ROOTS)
  else:
    blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_CRIMSON_ROOTS)

proc rootsBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  rootsBlockCanPlantOnTop_BlockBehaviour(blockAccessor, blockPos.down())

proc rootsBlockAsPlantBlockBase*(): PlantBlockBase =
  if gRootsBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = rootsBlockCanPlantOnTop_PlantBlockBase
    v.canPlaceAtImpl = rootsBlockCanPlaceAt_PlantBlockBase
    gRootsBlockAsPlantBlockBase = v
  gRootsBlockAsPlantBlockBase

proc registerBlocksPlantRoots*(r: BlockRegistry) =
  r.registerIds(rootsBlockIds(), newRootsBlock())

