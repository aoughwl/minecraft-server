## Port of pumpkin/src/block/blocks/plant/sapling.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  SaplingProperties = OakSaplingLikeProperties
  SaplingBlock* = object

var gSaplingBlockAsPlantBlockBase: nil PlantBlockBase


proc generate*(self: SaplingBlock, world: BlockWorld, pos: BlockPos)
proc saplingBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc saplingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc saplingBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc newSaplingBlock*(): BlockBehaviour
proc saplingBlockAsPlantBlockBase*(): PlantBlockBase

proc generate*(self: SaplingBlock, world: BlockWorld, pos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(pos)
  var props = SaplingProperties.fromStateId(state, blockRef)
  if (props.stage == 0):
    props.stage = 1
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyAll)
  else:
    discard

proc saplingBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(saplingBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc saplingBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(saplingBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc saplingBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  let self = SaplingBlock()
  self.generate(args.world, args.position)

proc newSaplingBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = saplingBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = saplingBlockGetStateForNeighborUpdate_BlockBehaviour
  result.randomTickImpl = saplingBlockRandomTick_BlockBehaviour

proc saplingBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSaplingBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gSaplingBlockAsPlantBlockBase = v
  gSaplingBlockAsPlantBlockBase

proc registerBlocksPlantSapling*(r: BlockRegistry) =
  r.registerTag("minecraft:saplings", newSaplingBlock())

