## Port of pumpkin/src/block/blocks/plant/sea_pickles.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  SeaPickleProperties = SeaPickleLikeProperties
  SeaPickleBlock* = object

var gSeaPickleBlockAsPlantBlockBase: nil PlantBlockBase


proc seaPickleBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc seaPickleBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc seaPickleBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc seaPickleBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool
proc seaPickleBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newSeaPickleBlock*(): BlockBehaviour
proc seaPickleBlockAsPlantBlockBase*(): PlantBlockBase

proc seaPickleBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  if ((not (args.itemStack.stack.item == ITEM_BONE_MEAL)) or ((not args.world.getBlock(args.position.down()).hasTag(Block_MINECRAFT_CORAL_BLOCKS)) or (not SeaPickleProperties.fromStateId(args.world.getBlockStateId(args.position), args.block0).waterlogged))):
    return barPass
  # 1:1 vanilla algorithm
  # TODO use pumpkin random
  # let mut j = 1;
  var count = 0
  let baseX = (args.position.vec.x - 2)
  var removedZ = 0'i32
  for addedX in 0'i32 ..< 5'i32:
    for addedZ in 0'i32 ..< 1'i32:
      let tempY = ((2 + args.position.vec.y) - 1)
      for y in ((tempY - 2)) ..< tempY:
        # let mut lv2: BlockState;
        let lv = newBlockPos((baseX + addedX), y, ((args.position.vec.z - removedZ) + addedZ))
        if ((lv == args.position) or (((not (rng().randomRange(0 ..< 6) == 0)) or (not (args.world.getBlock(lv) == blockWater()))) or (not args.world.getBlock(lv.down()).hasTag(Block_MINECRAFT_CORAL_BLOCKS)))):
          continue
        var seaPickleProp = SeaPickleProperties.defaultFor(args.block0)
        seaPickleProp.pickles = uint8(rng().randomRange(1 .. 4))
        discard args.world.setBlockState(lv, seaPickleProp.toStateId(args.block0), BfNotifyAll)
    if (count < 2):
      # j += 2;
      removedZ += 1
    else:
      # j -= 2;
      removedZ -= 1
    count += 1
  var seaPickleProp1 = SeaPickleProperties.defaultFor(args.block0)
  seaPickleProp1.pickles = 4'u8
  discard args.world.setBlockState(args.position, seaPickleProp1.toStateId(args.block0), BfNotifyListeners)
  barConsume

proc seaPickleBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let t1 = args.replacing
  if (not args.player.getEntity().isSneaking()) and t1.kind == BlockIsReplacingKind.kItself:
    let stateId = t1.f0Itself
    var seaPickleProp = SeaPickleProperties.fromStateId(t1.f0Itself, args.block0)
    if (seaPickleProp.pickles < 4):
      seaPickleProp.pickles += 1'u8
    return seaPickleProp.toStateId(args.block0)
  var seaPickleProp1 = SeaPickleProperties.defaultFor(args.block0)
  seaPickleProp1.waterlogged = args.replacing.waterSource()
  seaPickleProp1.toStateId(args.block0)

proc seaPickleBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let supportBlock = args.blockAccessor.getBlockState(args.position.down())
  supportBlock.isCenterSolid(BlockDirection.Up)

proc seaPickleBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  ((not args.player.getEntity().isSneaking()) and (SeaPickleProperties.fromStateId(args.stateId, args.block0).pickles < 4))

proc seaPickleBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(seaPickleBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newSeaPickleBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.useWithItemImpl = seaPickleBlockUseWithItem_BlockBehaviour
  result.onPlaceImpl = seaPickleBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = seaPickleBlockCanPlaceAt_BlockBehaviour
  result.canUpdateAtImpl = seaPickleBlockCanUpdateAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = seaPickleBlockGetStateForNeighborUpdate_BlockBehaviour

proc seaPickleBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSeaPickleBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gSeaPickleBlockAsPlantBlockBase = v
  gSeaPickleBlockAsPlantBlockBase

proc registerBlocksPlantSeaPickles*(r: BlockRegistry) =
  r.register("minecraft:sea_pickle", newSeaPickleBlock())

