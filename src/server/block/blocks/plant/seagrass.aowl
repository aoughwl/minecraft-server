## Port of pumpkin/src/block/blocks/plant/seagrass.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  SeaGrassBlock* = object

var gSeaGrassBlockAsPlantBlockBase: nil PlantBlockBase


proc seaGrassBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc seaGrassBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newSeaGrassBlock*(): BlockBehaviour
proc seaGrassBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc seaGrassBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc seaGrassBlockAsPlantBlockBase*(): PlantBlockBase
proc supportsSeagrass*(supportBlock: Block, supportBlockState: BlockState): bool

proc seaGrassBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(seaGrassBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc seaGrassBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(seaGrassBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newSeaGrassBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = seaGrassBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = seaGrassBlockGetStateForNeighborUpdate_BlockBehaviour

proc seaGrassBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(pos)
  let replacingBlock = blockAccessor.getBlock(pos.up())
  if (replacingBlock != blockWater()) and (replacingBlock != blockSeagrass()):
    return false
  if supportsSeagrass(supportBlock, supportBlockState):
    return true
  false

proc seaGrassBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(seaGrassBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockWater().defaultState.id
  blockState

proc seaGrassBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSeaGrassBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = seaGrassBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = seaGrassBlockGetStateForNeighborUpdate_PlantBlockBase
    gSeaGrassBlockAsPlantBlockBase = v
  gSeaGrassBlockAsPlantBlockBase

proc supportsSeagrass*(supportBlock: Block, supportBlockState: BlockState): bool =
  (supportBlockState.isSideSolid(BlockDirection.Up) and (not supportBlock.hasTag(Block_MINECRAFT_CANNOT_SUPPORT_SEAGRASS)))

proc registerBlocksPlantSeagrass*(r: BlockRegistry) =
  r.register("minecraft:seagrass", newSeaGrassBlock())

