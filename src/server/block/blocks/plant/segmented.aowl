## Port of pumpkin/src/block/blocks/plant/segmented.rs
## Upstream's `Segmented` is a trait with an associated `Properties: BlockProperties + SegmentProperties` type, and
## `impl_segment_properties!` implements `SegmentProperties` (segment amount + facing) for the two property structs.
## aowlmony has neither, so `Segmented` is a ref object of closures over `SegmentState` (amount, facing) and the two
## closures `loadImpl` / `storeImpl` stand in for `Self::Properties::from_state_id` / `default` / `to_state_id`.
## `segmentedPinkPetals` and `segmentedLeafLitter` are the two `impl_segment_properties!` instantiations.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  SegmentState* = object
    ## The `SegmentProperties` view of a property struct.
    amount*: uint8
    facing*: HorizontalFacing

  Segmented* = ref object
    loadImpl*: proc(stateId: BlockStateId, blockRef: Block): SegmentState {.closure.}
      ## `Self::Properties::from_state_id`, read through `get_segment_amount` / `get_facing`
    defaultImpl*: proc(blockRef: Block): SegmentState {.closure.}
      ## `Self::Properties::default`
    storeImpl*: proc(state: SegmentState, blockRef: Block): BlockStateId {.closure.}
      ## `set_segment_amount` / `set_facing` on the properties of `args.block`, then `to_state_id`
    canAddSegmentImpl*: proc(self: Segmented, props: SegmentState): bool {.closure.}
    getNextSegmentAmountImpl*: proc(self: Segmented, current: uint8): uint8 {.closure.}
    getFacingForSegmentImpl*: proc(self: Segmented, playerFacing: HorizontalFacing, segmentAmount: uint8): HorizontalFacing {.closure.}
    canUpdateAtImpl*: proc(self: Segmented, ctx: CanUpdateAtArgs): bool {.closure.}
    onPlaceImpl*: proc(self: Segmented, args: OnPlaceArgs): BlockStateId {.closure.}


proc canAddSegment*(self: Segmented, props: SegmentState): bool
proc getNextSegmentAmount*(self: Segmented, current: uint8): uint8
proc getFacingForSegment*(self: Segmented, playerFacing: HorizontalFacing, segmentAmount: uint8): HorizontalFacing
proc canUpdateAt*(self: Segmented, ctx: CanUpdateAtArgs): bool
proc onPlace*(self: Segmented, args: OnPlaceArgs): BlockStateId
proc newSegmented*(loadImpl: proc(stateId: BlockStateId, blockRef: Block): SegmentState {.closure.},
    defaultImpl: proc(blockRef: Block): SegmentState {.closure.},
    storeImpl: proc(state: SegmentState, blockRef: Block): BlockStateId {.closure.}): Segmented

proc defaultCanAddSegment_Segmented(self: Segmented, props: SegmentState): bool =
  props.amount < 4'u8

proc defaultGetNextSegmentAmount_Segmented(self: Segmented, current: uint8): uint8 =
  min(current + 1'u8, 4'u8)

proc defaultGetFacingForSegment_Segmented(self: Segmented, playerFacing: HorizontalFacing, segmentAmount: uint8): HorizontalFacing =
  var baseFacing = HorizontalFacing.West
  case segmentAmount
  of 1'u8:
    baseFacing = HorizontalFacing.South
  of 2'u8:
    baseFacing = HorizontalFacing.East
  of 3'u8:
    baseFacing = HorizontalFacing.North
  else:
    baseFacing = HorizontalFacing.West
  case playerFacing
  of HorizontalFacing.North:
    baseFacing
  of HorizontalFacing.East:
    baseFacing.rotateClockwise()
  of HorizontalFacing.South:
    baseFacing.rotateClockwise().rotateClockwise()
  of HorizontalFacing.West:
    baseFacing.rotateCounterClockwise()

proc defaultCanUpdateAt_Segmented(self: Segmented, ctx: CanUpdateAtArgs): bool =
  let load = self.loadImpl
  let currentProps = load(ctx.stateId, ctx.block0)
  self.canAddSegment(currentProps)

proc defaultOnPlace_Segmented(self: Segmented, args: OnPlaceArgs): BlockStateId =
  let load = self.loadImpl
  let store = self.storeImpl
  if args.replacing.kind == BlockIsReplacingKind.kItself:
    let existingStateId = args.replacing.f0Itself
    var props = load(existingStateId, args.block0)
    if self.canAddSegment(props):
      let currentAmount = props.amount
      let nextAmount = self.getNextSegmentAmount(currentAmount)
      props.amount = nextAmount
      store(props, args.block0)
    else:
      existingStateId
  else:
    # Set first segment orientation based on player direction
    let playerFacing = args.player.getEntity().getHorizontalFacing()
    let dflt = self.defaultImpl
    var props1 = dflt(args.block0)
    props1.amount = 1'u8
    props1.facing = self.getFacingForSegment(playerFacing, 1'u8)
    store(props1, args.block0)

proc canAddSegment*(self: Segmented, props: SegmentState): bool =
  let f = self.canAddSegmentImpl
  f(self, props)

proc getNextSegmentAmount*(self: Segmented, current: uint8): uint8 =
  let f = self.getNextSegmentAmountImpl
  f(self, current)

proc getFacingForSegment*(self: Segmented, playerFacing: HorizontalFacing, segmentAmount: uint8): HorizontalFacing =
  let f = self.getFacingForSegmentImpl
  f(self, playerFacing, segmentAmount)

proc canUpdateAt*(self: Segmented, ctx: CanUpdateAtArgs): bool =
  let f = self.canUpdateAtImpl
  f(self, ctx)

proc onPlace*(self: Segmented, args: OnPlaceArgs): BlockStateId =
  let f = self.onPlaceImpl
  f(self, args)

proc newSegmented*(loadImpl: proc(stateId: BlockStateId, blockRef: Block): SegmentState {.closure.},
    defaultImpl: proc(blockRef: Block): SegmentState {.closure.},
    storeImpl: proc(state: SegmentState, blockRef: Block): BlockStateId {.closure.}): Segmented =
  result = Segmented()
  result.loadImpl = loadImpl
  result.defaultImpl = defaultImpl
  result.storeImpl = storeImpl
  result.canAddSegmentImpl = defaultCanAddSegment_Segmented
  result.getNextSegmentAmountImpl = defaultGetNextSegmentAmount_Segmented
  result.getFacingForSegmentImpl = defaultGetFacingForSegment_Segmented
  result.canUpdateAtImpl = defaultCanUpdateAt_Segmented
  result.onPlaceImpl = defaultOnPlace_Segmented

# `impl_segment_properties!(PinkPetalsLikeProperties, flower_amount)`
proc segmentedPinkPetals*(): Segmented =
  newSegmented(
    proc(stateId: BlockStateId, blockRef: Block): SegmentState {.closure.} =
      let p = PinkPetalsLikeProperties.fromStateId(stateId, blockRef)
      SegmentState(amount: p.flowerAmount, facing: p.facing),
    proc(blockRef: Block): SegmentState {.closure.} =
      let p = PinkPetalsLikeProperties.defaultFor(blockRef)
      SegmentState(amount: p.flowerAmount, facing: p.facing),
    proc(state: SegmentState, blockRef: Block): BlockStateId {.closure.} =
      var p = PinkPetalsLikeProperties.defaultFor(blockRef)
      p.flowerAmount = state.amount
      p.facing = state.facing
      p.toStateId(blockRef))

# `impl_segment_properties!(LeafLitterLikeProperties, segment_amount)`
proc segmentedLeafLitter*(): Segmented =
  newSegmented(
    proc(stateId: BlockStateId, blockRef: Block): SegmentState {.closure.} =
      let p = LeafLitterLikeProperties.fromStateId(stateId, blockRef)
      SegmentState(amount: p.segmentAmount, facing: p.facing),
    proc(blockRef: Block): SegmentState {.closure.} =
      let p = LeafLitterLikeProperties.defaultFor(blockRef)
      SegmentState(amount: p.segmentAmount, facing: p.facing),
    proc(state: SegmentState, blockRef: Block): BlockStateId {.closure.} =
      var p = LeafLitterLikeProperties.defaultFor(blockRef)
      p.segmentAmount = state.amount
      p.facing = state.facing
      p.toStateId(blockRef))
