## Port of pumpkin/src/block/blocks/plant/small_dripleaf.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  SmallDripleafBlock* = object

var gSmallDripleafBlockAsPlantBlockBase: nil PlantBlockBase


proc smallDripleafBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc smallDripleafBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc smallDripleafBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc smallDripleafBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newSmallDripleafBlock*(): BlockBehaviour
proc isSmallDripleafWaterlogged*(stateId: BlockStateId): bool
proc smallDripleafBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc smallDripleafBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc smallDripleafBlockAsPlantBlockBase*(): PlantBlockBase
proc supportsSmallDripleaf*(supportBlock: Block, underwater: bool): bool

proc smallDripleafBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(smallDripleafBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc smallDripleafBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  var smallDripleafProps = SmallDripleafLikeProperties.defaultFor(args.block0)
  smallDripleafProps.facing = facing
  smallDripleafProps.waterlogged = args.replacing.waterSource()
  smallDripleafProps.half = DoubleBlockHalf.Lower
  smallDripleafProps.toStateId(args.block0)

proc smallDripleafBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(smallDripleafBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc smallDripleafBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let lowerSmallDripleafProps = SmallDripleafLikeProperties.fromStateId(args.stateId, args.block0)
  if (lowerSmallDripleafProps.half != DoubleBlockHalf.Lower):
    return
  var upperSmallDripleafProps = SmallDripleafLikeProperties.defaultFor(blockSmallDripleaf())
  let upperBlock = args.world.getBlock(args.position.up())
  upperSmallDripleafProps.facing = lowerSmallDripleafProps.facing
  upperSmallDripleafProps.waterlogged = (upperBlock == blockWater())
  upperSmallDripleafProps.half = DoubleBlockHalf.Upper
  discard args.world.setBlockState(args.position.up(), upperSmallDripleafProps.toStateId(blockSmallDripleaf()), (BfNotifyAll or BfSkipBlockAddedCallback))

proc newSmallDripleafBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = smallDripleafBlockCanPlaceAt_BlockBehaviour
  result.onPlaceImpl = smallDripleafBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = smallDripleafBlockGetStateForNeighborUpdate_BlockBehaviour
  result.placedImpl = smallDripleafBlockPlaced_BlockBehaviour

proc isSmallDripleafWaterlogged*(stateId: BlockStateId): bool =
  let dripleafProps = SmallDripleafLikeProperties.fromStateId(stateId, blockSmallDripleaf())
  dripleafProps.waterlogged

proc smallDripleafBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let supportBlock = blockAccessor.getBlock(pos)
  if (supportBlock == blockSmallDripleaf()):
    return true
  let upperBlock = blockAccessor.getBlock(pos.upHeight(2))
  if (upperBlock != blockAir()) and (upperBlock != blockWater()) and (upperBlock != blockSmallDripleaf()):
    return false
  let (replacingBlock, replacingBlockState) = blockAccessor.getBlockAndState(pos.up())
  if (replacingBlock == blockSmallDripleaf()) and replacingBlockState.isWaterlogged():
    # in case of neighbor update check
    supportsSmallDripleaf(supportBlock, true)
  else:
    supportsSmallDripleaf(supportBlock, (replacingBlock == blockWater()))

proc smallDripleafBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(smallDripleafBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    if isSmallDripleafWaterlogged(blockState):
      return blockWater().defaultState.id
    return blockAir().defaultState.id
  let upperBlock = blockAccessor.getBlock(blockPos.up())
  let belowBlow = blockAccessor.getBlock(blockPos.down())
  if (upperBlock != blockSmallDripleaf()) and (belowBlow != blockSmallDripleaf()):
    if isSmallDripleafWaterlogged(blockState):
      return blockWater().defaultState.id
    return blockAir().defaultState.id
  blockState

proc smallDripleafBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSmallDripleafBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = smallDripleafBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = smallDripleafBlockGetStateForNeighborUpdate_PlantBlockBase
    gSmallDripleafBlockAsPlantBlockBase = v
  gSmallDripleafBlockAsPlantBlockBase

proc supportsSmallDripleaf*(supportBlock: Block, underwater: bool): bool =
  if supportBlock.hasTag(Block_MINECRAFT_SUPPORTS_SMALL_DRIPLEAF):
    return true
  (underwater and supportBlock.hasTag(Block_MINECRAFT_SUPPORTS_BIG_DRIPLEAF))

proc registerBlocksPlantSmallDripleaf*(r: BlockRegistry) =
  r.register("minecraft:small_dripleaf", newSmallDripleafBlock())

