## Port of pumpkin/src/block/blocks/plant/spore_blossom.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  SporeBlossomBlock* = object

var gSporeBlossomBlockAsPlantBlockBase: nil PlantBlockBase


proc sporeBlossomBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc sporeBlossomBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newSporeBlossomBlock*(): BlockBehaviour
proc sporeBlossomBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc sporeBlossomBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool
proc sporeBlossomBlockAsPlantBlockBase*(): PlantBlockBase
proc supportsSporeBlossom*(blockRef: Block): bool

proc sporeBlossomBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(sporeBlossomBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc sporeBlossomBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(sporeBlossomBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newSporeBlossomBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = sporeBlossomBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = sporeBlossomBlockGetStateForNeighborUpdate_BlockBehaviour

proc sporeBlossomBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  false

proc sporeBlossomBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  let ceilingBlock = blockAccessor.getBlock(blockPos.up())
  supportsSporeBlossom(ceilingBlock)

proc sporeBlossomBlockAsPlantBlockBase*(): PlantBlockBase =
  if gSporeBlossomBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = sporeBlossomBlockCanPlantOnTop_PlantBlockBase
    v.canPlaceAtImpl = sporeBlossomBlockCanPlaceAt_PlantBlockBase
    gSporeBlossomBlockAsPlantBlockBase = v
  gSporeBlossomBlockAsPlantBlockBase

proc supportsSporeBlossom*(blockRef: Block): bool =
  ((not blockRef.hasTag(Block_MINECRAFT_LEAVES)) and blockRef.isSolid())

proc registerBlocksPlantSporeBlossom*(r: BlockRegistry) =
  r.register("minecraft:spore_blossom", newSporeBlossomBlock())

