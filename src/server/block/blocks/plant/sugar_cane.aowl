## Port of pumpkin/src/block/blocks/plant/sugar_cane.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  SugarCaneBlock* = object



proc sugarCaneBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc sugarCaneBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc sugarCaneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc sugarCaneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newSugarCaneBlock*(): BlockBehaviour
proc canPlaceAt*(blockAccessor: BlockWorld, blockPos: BlockPos): bool

proc sugarCaneBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc sugarCaneBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  if args.world.getBlockState(args.position.up()).isAir() and (not (((args.world.getBlock(args.position.down()) == blockSugarCane()) and (args.world.getBlock(args.position.down().down()) == blockSugarCane())))):
    let stateId = args.world.getBlockState(args.position).id
    let age = CactusLikeProperties.fromStateId(stateId, args.block0).age
    if (age == 15):
      discard args.world.setBlockState(args.position.up(), stateId, 0'u32)
      let props = CactusLikeProperties(age: 0)
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), 0'u32)
    else:
      let props1 = CactusLikeProperties(age: (age + 1))
      discard args.world.setBlockState(args.position, props1.toStateId(args.block0), 0'u32)

proc sugarCaneBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc sugarCaneBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc newSugarCaneBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onScheduledTickImpl = sugarCaneBlockOnScheduledTick_BlockBehaviour
  result.randomTickImpl = sugarCaneBlockRandomTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = sugarCaneBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = sugarCaneBlockCanPlaceAt_BlockBehaviour

proc canPlaceAt*(blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  let blockBelow = blockAccessor.getBlock(blockPos.down())
  if (blockBelow == blockSugarCane()):
    return true
  if blockBelow.hasTag(Block_MINECRAFT_SUPPORTS_SUGAR_CANE):
    let t1 = HorizontalFacing.all()
    for direction in t1:
      let blockRef = blockAccessor.getBlock(blockPos.down().offset(direction.toOffset()))
      # TODO: use fluid
      if blockRef.hasTag(Fluid_MINECRAFT_SUPPORTS_SUGAR_CANE_ADJACENTLY) and blockRef.hasTag(Block_MINECRAFT_SUPPORTS_SUGAR_CANE_ADJACENTLY):
        return true
  false

proc registerBlocksPlantSugarCane*(r: BlockRegistry) =
  r.register("minecraft:sugar_cane", newSugarCaneBlock())

