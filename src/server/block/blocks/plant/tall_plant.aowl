## Port of pumpkin/src/block/blocks/plant/tall_plant.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  TallPlantBlock* = object

var gTallPlantBlockAsPlantBlockBase: nil PlantBlockBase


proc tallPlantBlockIds*(): seq[BlockId]
proc tallPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc tallPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc tallPlantBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc tallPlantBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newTallPlantBlock*(): BlockBehaviour
proc tallPlantBlockAsPlantBlockBase*(): PlantBlockBase

proc tallPlantBlockIds*(): seq[BlockId] =
  @[blockIdTallGrass, blockIdLargeFern, blockIdPitcherPlant, blockIdSunflower, blockIdLilac, blockIdPeony, blockIdRoseBush]

proc tallPlantBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let upPos = args.position.up()
  let upperState = args.blockAccessor.getBlockState(upPos)
  let t1 = args.world
  if not (t1.isSome):
    return (canPlaceAt(tallPlantBlockAsPlantBlockBase(), args.blockAccessor, args.position) and upperState.isAir())
  let world = t1.unsafeGet
  if (upPos.vec.y > world.getTopY()):
    return false
  (canPlaceAt(tallPlantBlockAsPlantBlockBase(), args.blockAccessor, args.position) and upperState.isAir())

proc tallPlantBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let tallPlantProps = TallSeagrassLikeProperties.fromStateId(args.stateId, args.block0)
  let t2 = block:
    case tallPlantProps.half
    of DoubleBlockHalf.Upper:
      (args.position.downHeight(2), args.position.down())
    of DoubleBlockHalf.Lower:
      (args.position.down(), args.position.up())
  let (supportBlockPos, otherBlockPos) = t2
  if (not canPlaceAt(tallPlantBlockAsPlantBlockBase(), args.world, supportBlockPos.up())):
    return blockAir().defaultState.id
  let (otherBlock, otherStateId) = args.world.getBlockAndStateId(otherBlockPos)
  if contains(ids(), otherBlock.id):
    let otherProps = TallSeagrassLikeProperties.fromStateId(otherStateId, otherBlock)
    let t3 = block:
      case tallPlantProps.half
      of DoubleBlockHalf.Upper:
        DoubleBlockHalf.Lower
      of DoubleBlockHalf.Lower:
        DoubleBlockHalf.Upper
    let oppositeHalf = t3
    if (otherProps.half == oppositeHalf):
      return args.stateId
  blockAir().defaultState.id

proc tallPlantBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  var tallPlantProps = TallSeagrassLikeProperties.fromStateId(args.stateId, args.block0)
  tallPlantProps.half = DoubleBlockHalf.Upper
  discard args.world.setBlockState(args.position.offset(BlockDirection.Up.toOffset()), tallPlantProps.toStateId(args.block0), (BfNotifyAll or BfSkipBlockAddedCallback))

proc tallPlantBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # When one half of a tall plant is broken, break the other half too
  let tallPlantProps = TallSeagrassLikeProperties.fromStateId(args.state.id, args.block0)
  let t4 = block:
    case tallPlantProps.half
    of DoubleBlockHalf.Upper:
      args.position.down()
    of DoubleBlockHalf.Lower:
      args.position.up()
  let otherBlockPos = t4
  let (otherBlock, otherStateId) = args.world.getBlockAndStateId(otherBlockPos)
  if contains(ids(), otherBlock.id):
    let otherProps = TallSeagrassLikeProperties.fromStateId(otherStateId, otherBlock)
    let t5 = block:
      case tallPlantProps.half
      of DoubleBlockHalf.Upper:
        DoubleBlockHalf.Lower
      of DoubleBlockHalf.Lower:
        DoubleBlockHalf.Upper
    let oppositeHalf = t5
    if (otherProps.half == oppositeHalf):
      # Break the other half, using SKIP_DROPS to prevent double drops
      discard args.world.breakBlock(otherBlockPos, nil, (BfSkipDrops or BfSkipBlockAddedCallback))

proc newTallPlantBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = tallPlantBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = tallPlantBlockGetStateForNeighborUpdate_BlockBehaviour
  result.placedImpl = tallPlantBlockPlaced_BlockBehaviour
  result.brokenImpl = tallPlantBlockBroken_BlockBehaviour

proc tallPlantBlockAsPlantBlockBase*(): PlantBlockBase =
  if gTallPlantBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    gTallPlantBlockAsPlantBlockBase = v
  gTallPlantBlockAsPlantBlockBase

proc registerBlocksPlantTallPlant*(r: BlockRegistry) =
  r.registerIds(tallPlantBlockIds(), newTallPlantBlock())

