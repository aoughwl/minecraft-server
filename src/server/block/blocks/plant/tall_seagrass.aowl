import ../../blockprelude
import seagrass
import plantmod


type
  TallSeaGrassBlock* = object

var gTallSeaGrassBlockAsPlantBlockBase: nil PlantBlockBase


proc tallSeaGrassBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc tallSeaGrassBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newTallSeaGrassBlock*(): BlockBehaviour
proc tallSeaGrassBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc tallSeaGrassBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc tallSeaGrassBlockAsPlantBlockBase*(): PlantBlockBase

proc tallSeaGrassBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(tallSeaGrassBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc tallSeaGrassBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(tallSeaGrassBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newTallSeaGrassBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = tallSeaGrassBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = tallSeaGrassBlockGetStateForNeighborUpdate_BlockBehaviour

proc tallSeaGrassBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(pos)
  let replacingBlock = blockAccessor.getBlock(pos.up())
  if (replacingBlock != blockWater()) and (replacingBlock != blockTallSeagrass()):
    return false
  if (replacingBlock == blockTallSeagrass()):
    # only for blockupdate
    let blockAbove = blockAccessor.getBlock(pos.upHeight(2))
    let isSupportSeagrassBlock = (supportBlock == blockTallSeagrass())
    let isAboveSeagrassBlock = (blockAbove == blockTallSeagrass())
    let t1 = (isSupportSeagrassBlock, isAboveSeagrassBlock)
    if R2A_MANUAL("or-binding"):
      return false
    else:
      discard
  if (supportBlock == blockTallSeagrass()):
    return true
  if supportsSeagrass(supportBlock, supportBlockState):
    return true
  false

proc tallSeaGrassBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(tallSeaGrassBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockWater().defaultState.id
  blockState

proc tallSeaGrassBlockAsPlantBlockBase*(): PlantBlockBase =
  if gTallSeaGrassBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = tallSeaGrassBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = tallSeaGrassBlockGetStateForNeighborUpdate_PlantBlockBase
    gTallSeaGrassBlockAsPlantBlockBase = v
  gTallSeaGrassBlockAsPlantBlockBase

proc registerBlocksPlantTallSeagrass*(r: BlockRegistry) =
  r.register("minecraft:tall_seagrass", newTallSeaGrassBlock())

