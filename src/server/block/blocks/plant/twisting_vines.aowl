## Port of pumpkin/src/block/blocks/plant/twisting_vines.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  TwistingVinesBlock* = object

var gTwistingVinesBlockAsPlantBlockBase: nil PlantBlockBase


proc twistingVinesBlockIds*(): seq[BlockId]
proc twistingVinesBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc twistingVinesBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc twistingVinesBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc twistingVinesBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newTwistingVinesBlock*(): BlockBehaviour
proc twistingVinesBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc twistingVinesBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc twistingVinesBlockAsPlantBlockBase*(): PlantBlockBase

proc twistingVinesBlockIds*(): seq[BlockId] =
  @[blockIdTwistingVines, blockIdTwistingVinesPlant]

proc twistingVinesBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(twistingVinesBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc twistingVinesBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(twistingVinesBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc twistingVinesBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let supportPos = args.position.down()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockTwistingVines()):
    discard args.world.setBlockState(supportPos, blockTwistingVinesPlant().defaultState.id, 0'u32)

proc twistingVinesBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let supportPos = args.position.down()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockTwistingVinesPlant()):
    discard args.world.setBlockState(supportPos, blockTwistingVines().defaultState.id, 0'u32)

proc newTwistingVinesBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = twistingVinesBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = twistingVinesBlockGetStateForNeighborUpdate_BlockBehaviour
  result.placedImpl = twistingVinesBlockPlaced_BlockBehaviour
  result.brokenImpl = twistingVinesBlockBroken_BlockBehaviour

proc twistingVinesBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  # Determine support block
  let supportPos = pos
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(supportPos)
  if ((supportBlock == blockTwistingVines()) or (supportBlock == blockTwistingVinesPlant())):
    return true
  if supportBlockState.isSideSolid(BlockDirection.Down) and supportBlock.isSolid():
    return true
  false

proc twistingVinesBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(twistingVinesBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockAir().defaultState.id
  blockState

proc twistingVinesBlockAsPlantBlockBase*(): PlantBlockBase =
  if gTwistingVinesBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = twistingVinesBlockCanPlantOnTop_PlantBlockBase
    v.getStateForNeighborUpdateImpl = twistingVinesBlockGetStateForNeighborUpdate_PlantBlockBase
    gTwistingVinesBlockAsPlantBlockBase = v
  gTwistingVinesBlockAsPlantBlockBase

proc registerBlocksPlantTwistingVines*(r: BlockRegistry) =
  r.registerIds(twistingVinesBlockIds(), newTwistingVinesBlock())

