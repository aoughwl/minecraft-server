## Port of pumpkin/src/block/blocks/plant/weeping_vines.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  WeepingVinesBlock* = object

var gWeepingVinesBlockAsPlantBlockBase: nil PlantBlockBase


proc weepingVinesBlockIds*(): seq[BlockId]
proc weepingVinesBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc weepingVinesBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc weepingVinesBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc weepingVinesBlockBroken_BlockBehaviour(args: BrokenArgs)
proc newWeepingVinesBlock*(): BlockBehaviour
proc weepingVinesBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc weepingVinesBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId
proc weepingVinesBlockAsPlantBlockBase*(): PlantBlockBase

proc weepingVinesBlockIds*(): seq[BlockId] =
  @[blockIdWeepingVines, blockIdWeepingVinesPlant]

proc weepingVinesBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(weepingVinesBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc weepingVinesBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(weepingVinesBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc weepingVinesBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let supportPos = args.position.up()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockWeepingVines()):
    discard args.world.setBlockState(supportPos, blockWeepingVinesPlant().defaultState.id, 0'u32)

proc weepingVinesBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let supportPos = args.position.up()
  let supportBlock = args.world.getBlock(supportPos)
  if (supportBlock == blockWeepingVinesPlant()):
    discard args.world.setBlockState(supportPos, blockWeepingVines().defaultState.id, 0'u32)

proc newWeepingVinesBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = weepingVinesBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = weepingVinesBlockGetStateForNeighborUpdate_BlockBehaviour
  result.placedImpl = weepingVinesBlockPlaced_BlockBehaviour
  result.brokenImpl = weepingVinesBlockBroken_BlockBehaviour

proc weepingVinesBlockCanPlaceAt_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  # Determine support block
  let supportPos = pos.up()
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(supportPos)
  if ((supportBlock == blockWeepingVines()) or (supportBlock == blockWeepingVinesPlant())):
    return true
  if supportBlockState.isSideSolid(BlockDirection.Down) and supportBlock.isSolid():
    return true
  false

proc weepingVinesBlockGetStateForNeighborUpdate_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, blockPos: BlockPos, blockState: BlockStateId): BlockStateId =
  if (not canPlaceAt(weepingVinesBlockAsPlantBlockBase(), blockAccessor, blockPos)):
    return blockAir().defaultState.id
  blockState

proc weepingVinesBlockAsPlantBlockBase*(): PlantBlockBase =
  if gWeepingVinesBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlaceAtImpl = weepingVinesBlockCanPlaceAt_PlantBlockBase
    v.getStateForNeighborUpdateImpl = weepingVinesBlockGetStateForNeighborUpdate_PlantBlockBase
    gWeepingVinesBlockAsPlantBlockBase = v
  gWeepingVinesBlockAsPlantBlockBase

proc registerBlocksPlantWeepingVines*(r: BlockRegistry) =
  r.registerIds(weepingVinesBlockIds(), newWeepingVinesBlock())

