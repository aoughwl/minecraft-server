## Port of pumpkin/src/block/blocks/plant/wither_rose.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import plantmod


type
  WitherRoseBlock* = object

var gWitherRoseBlockAsPlantBlockBase: nil PlantBlockBase


proc witherRoseBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc witherRoseBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc witherRoseBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newWitherRoseBlock*(): BlockBehaviour
proc witherRoseBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool
proc witherRoseBlockAsPlantBlockBase*(): PlantBlockBase

proc witherRoseBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let t1 = args.entity.getLivingEntity()
  if t1.isSome:
    let livingEntity = t1.unsafeGet
    if (args.world.levelInfo.difficulty == Difficulty.Peaceful):
      return
    let entityType = args.entity.getEntity().entityType
    if ((entityType == EntityType.ENDER_DRAGON) or ((entityType == EntityType.WITHER) or (entityType == EntityType.WITHER_SKELETON))):
      return
    let effect = Effect(effectType: StatusEffect.WITHER, duration: 40, amplifier: 0, ambient: false, showParticles: true, showIcon: true, blend: true)
    let t2 = args.entity.getPlayer()
    if t2.isSome:
      let player = t2.unsafeGet
      t2.unsafeGet.sendEffect(effect)
    t1.unsafeGet.addEffect(effect)

proc witherRoseBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(witherRoseBlockAsPlantBlockBase(), args.blockAccessor, args.position)

proc witherRoseBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(witherRoseBlockAsPlantBlockBase(), args.world, args.position, args.stateId)

proc newWitherRoseBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = witherRoseBlockOnEntityCollision_BlockBehaviour
  result.canPlaceAtImpl = witherRoseBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = witherRoseBlockGetStateForNeighborUpdate_BlockBehaviour

proc witherRoseBlockCanPlantOnTop_PlantBlockBase(self: PlantBlockBase, blockAccessor: BlockWorld, pos: BlockPos): bool =
  let supportBlock = blockAccessor.getBlock(pos)
  supportBlock.hasTag(Block_MINECRAFT_SUPPORTS_WITHER_ROSE)

proc witherRoseBlockAsPlantBlockBase*(): PlantBlockBase =
  if gWitherRoseBlockAsPlantBlockBase == nil:
    let v = newPlantBlockBase()
    v.canPlantOnTopImpl = witherRoseBlockCanPlantOnTop_PlantBlockBase
    gWitherRoseBlockAsPlantBlockBase = v
  gWitherRoseBlockAsPlantBlockBase

proc registerBlocksPlantWitherRose*(r: BlockRegistry) =
  r.register("minecraft:wither_rose", newWitherRoseBlock())

