## Port of pumpkin/src/block/blocks/powder_snow.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const WALK_ON_EPSILON: float64 = 1.0e-7

type
  PowderSnowBlock* = object


let FALLING_COLLISION_SHAPE: BoundingBox = BoundingBox.newArray([0.0, 0.0, 0.0], [1.0, 0.9, 1.0])

proc canEntityWalkOnPowderSnow*(entity: BlockActor): bool
proc isEntityAboveBlock*(entity: BlockActor, position: BlockPos): bool
proc isEntityDescending*(entity: BlockActor): bool
proc collisionShapeForEntity*(entity: BlockActor, position: BlockPos): Option[BoundingBox]
proc insideCollisionShapeForEntity*(entity: BlockActor, position: BlockPos): BoundingBox
proc powderSnowBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs)
proc powderSnowBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc newPowderSnowBlock*(): BlockBehaviour

proc canEntityWalkOnPowderSnow*(entity: BlockActor): bool =
  ## The tag test and the boots read are entity/entitymod.aowl's `canEntityWalkOnPowderSnow`, reached through the hook.
  entity.canWalkOnPowderSnow()

proc isEntityAboveBlock*(entity: BlockActor, position: BlockPos): bool =
  let bb = entity.boundingBox
  let blockTop = float64(position.vec.y) + 1.0
  bb.min.y >= blockTop - WALK_ON_EPSILON

proc isEntityDescending*(entity: BlockActor): bool =
  entity.velocity.y < 0.0

proc collisionShapeForEntity*(entity: BlockActor, position: BlockPos): Option[BoundingBox] =
  let fallDistance = entity.fallDistance()
  if fallDistance > 2.5'f32:
    return some(FALLING_COLLISION_SHAPE)
  let base = entity.getEntity()
  if base.entityTypeName == "falling_block":
    return some(BoundingBox.fullBlock())
  if canEntityWalkOnPowderSnow(entity) and isEntityAboveBlock(base, position) and not isEntityDescending(base):
    return some(BoundingBox.fullBlock())
  none[BoundingBox]()

proc insideCollisionShapeForEntity*(entity: BlockActor, position: BlockPos): BoundingBox =
  let shape = collisionShapeForEntity(entity, position)
  if shape.isSome: shape.unsafeGet else: BoundingBox.fullBlock()

proc powderSnowBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs) =
  let living = args.entity.getLivingEntity()
  if living.isSome and args.fallDistance >= 4.0'f32:
    let sound = if args.fallDistance < 7.0'f32: sdEntityGenericSmallFall else: sdEntityGenericBigFall
    # `Entity::play_sound`: at the entity, in the neutral category
    args.world.playSoundFine(sound, scNeutral, args.entity.getEntity().pos, 1.0'f32, 1.0'f32)

proc powderSnowBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let entity = args.entity.getEntity()
  entity.slowMovement(args.state, vec3[float64](0.9, 1.5, 0.9))
  if entity.fireTicks() > 0'i32:
    let canDestroy = args.entity.getPlayer().isSome() or args.world.levelInfo().gameRules.mobGriefing
    if canDestroy:
      discard args.world.breakBlock(args.position, nil, (BfNotifyAll or BfSkipDrops))
  entity.extinguish()

proc newPowderSnowBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onLandedUponImpl = powderSnowBlockOnLandedUpon_BlockBehaviour
  result.onEntityCollisionImpl = powderSnowBlockOnEntityCollision_BlockBehaviour

proc registerBlocksPowderSnow*(r: BlockRegistry) =
  r.register("minecraft:powder_snow", newPowderSnowBlock())

