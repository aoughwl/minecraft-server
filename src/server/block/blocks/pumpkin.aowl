## Port of pumpkin/src/block/blocks/pumpkin.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  PumpkinBlock* = object



proc pumpkinBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc newPumpkinBlock*(): BlockBehaviour

proc pumpkinBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  if (not (args.itemStack.stack.item == ITEM_SHEARS)):
    return barPass
  var props = WallTorchLikeProperties.defaultFor(blockCarvedPumpkin())
  props.facing = args.player.getHorizontalFacing().opposite()
  discard args.world.setBlockState(args.position, props.toStateId(blockCarvedPumpkin()), BfNotifyAll)
  # `ItemEntity::new(Entity::new(world, position, ITEM), ItemStack::new(4, PUMPKIN_SEEDS))` then `spawn_entity`
  args.world.dropStack(args.position, newItemStack(4'u8, ITEM_PUMPKIN_SEEDS))
  args.player.damageItemInSlot(args.itemStack, 1'i32)
  barConsume

proc newPumpkinBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.useWithItemImpl = pumpkinBlockUseWithItem_BlockBehaviour

proc registerBlocksPumpkin*(r: BlockRegistry) =
  r.register("minecraft:pumpkin", newPumpkinBlock())

