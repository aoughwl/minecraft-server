proc getUpdateDelayInternal*(self: RedstoneGateBlock, stateId: BlockStateId, blockRef: Block): uint8 =
  let f = self.getUpdateDelayInternalImpl
  f(self, stateId, blockRef)

proc newRedstoneGateBlock*(): RedstoneGateBlock =
  result = RedstoneGateBlock()
  result.canPlaceAtImpl = defaultCanPlaceAt_RedstoneGateBlock
  result.canPlaceAboveImpl = defaultCanPlaceAbove_RedstoneGateBlock
  result.getWeakRedstonePowerImpl = defaultGetWeakRedstonePower_RedstoneGateBlock
  result.getStrongRedstonePowerImpl = defaultGetStrongRedstonePower_RedstoneGateBlock
  result.onNeighborUpdateImpl = defaultOnNeighborUpdate_RedstoneGateBlock
  result.hasPowerImpl = defaultHasPower_RedstoneGateBlock
  result.getPowerImpl = defaultGetPower_RedstoneGateBlock
  result.getMaxInputLevelSidesImpl = defaultGetMaxInputLevelSides_RedstoneGateBlock
  result.updateTargetImpl = defaultUpdateTarget_RedstoneGateBlock
  result.onPlaceImpl = defaultOnPlace_RedstoneGateBlock
  result.playerPlacedImpl = defaultPlayerPlaced_RedstoneGateBlock
  result.onStateReplacedImpl = defaultOnStateReplaced_RedstoneGateBlock
  result.isTargetNotAlignedImpl = defaultIsTargetNotAligned_RedstoneGateBlock

proc getPower*(world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block): uint8 =
  let props = gatePropsOf(stateId, blockRef)
  let facing = props.getFacing()
  let sourcePos = pos.offset(facing.toOffset())
  let (sourceBlock, sourceState) = world.getBlockAndState(sourcePos)
  let sourceLevel = getRedstonePower(sourceBlock, sourceState, world, sourcePos, facing.toBlockDirection())
  if (sourceLevel >= 15):
    sourceLevel
  else:
    let t2 = block:
      if (sourceBlock == blockRedstoneWire()):
        let props1 = RedstoneWireLikeProperties.fromStateId(sourceState.id, sourceBlock)
        props1.power
      else:
        0'u8
    sourceLevel.max(t2)

proc getPowerOnSide*(world: BlockWorld, pos: BlockPos, side: HorizontalFacing, onlyGate: bool): uint8 =
  let sidePos = pos.offset(side.toBlockDirection().toOffset())
  let (sideBlock, sideState) = world.getBlockAndState(sidePos)
  if ((not onlyGate) or isDiode(sideBlock)):
    world.blockRegistry.getWeakRedstonePower(sideBlock, world, sidePos, sideState, side.toBlockDirection())
  else:
    0'u8

