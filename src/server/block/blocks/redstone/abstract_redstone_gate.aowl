proc defaultCanPlaceAt_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): bool =
  let underPos = pos.down()
  let underState = world.getBlockState(underPos)
  self.canPlaceAbove(world, underPos, underState)

proc defaultCanPlaceAbove_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState): bool =
  state.isSideSolid(BlockDirection.Up)

proc defaultGetWeakRedstonePower_RedstoneGateBlock(self: RedstoneGateBlock, args: GetRedstonePowerArgs): uint8 =
  let props = gatePropsOf(args.state.id, args.block0)
  if props.isPowered() and (props.getFacing().toBlockDirection() == args.direction):
    self.getOutputLevel(args.world, args.position)
  else:
    0'u8

proc defaultGetStrongRedstonePower_RedstoneGateBlock(self: RedstoneGateBlock, args: GetRedstonePowerArgs): uint8 =
  self.getWeakRedstonePower(args)

proc defaultOnNeighborUpdate_RedstoneGateBlock(self: RedstoneGateBlock, args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockState(args.position)
  if canPlaceAt(self, args.world, args.position):
    self.updatePowered(args.world, args.position, state, args.block0)
    return
  discard args.world.setBlockState(args.position, blockAir().defaultState.id, BfNotifyAll)
  let t1 = blockDirectionAll()
  for dir in t1:
    args.world.updateNeighbor(args.position.offset(dir.toOffset()), args.sourceBlock)

proc defaultHasPower_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): bool =
  (self.getPower(world, pos, state, blockRef) > 0)

proc defaultGetPower_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): uint8 =
  getPower(world, pos, state.id, blockRef)

proc defaultGetMaxInputLevelSides_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block, onlyGate: bool): uint8 =
  let props = gatePropsOf(stateId, blockRef)
  let facing = props.getFacing()
  let powerLeft = getPowerOnSide(world, pos, facing.rotateClockwise(), onlyGate)
  let powerRight = getPowerOnSide(world, pos, facing.rotateCounterClockwise(), onlyGate)
  max(powerLeft, powerRight)

proc defaultUpdateTarget_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block) =
  let props = gatePropsOf(stateId, blockRef)
  let facing = props.getFacing()
  let frontPos = pos.offset(facing.opposite().toOffset())
  world.updateNeighbor(frontPos, blockRef)
  world.updateNeighbors(frontPos, some(facing.toBlockDirection()))

proc defaultOnPlace_RedstoneGateBlock(self: RedstoneGateBlock, player: BlockPlayer, blockRef: Block): BlockStateId =
  var props = gatePropsDefault(blockRef)
  let dir = player.livingEntity.entity.getHorizontalFacing().opposite()
  props.setFacing(dir)
  props.toStateId(blockRef)

proc defaultPlayerPlaced_RedstoneGateBlock(self: RedstoneGateBlock, args: PlayerPlacedArgs) =
  if hasPower(self, args.world, args.position, BlockState.fromId(args.stateId), args.block0):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)

proc defaultOnStateReplaced_RedstoneGateBlock(self: RedstoneGateBlock, args: OnStateReplacedArgs) =
  if (args.moved or (Block.fromStateId(args.oldStateId) == args.block0)):
    return
  updateTarget(self, args.world, args.position, args.oldStateId, args.block0)

proc defaultIsTargetNotAligned_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): bool =
  let props = gatePropsOf(state.id, blockRef)
  let facing = props.getFacing().opposite()
  let (targetBlock, targetState) = world.getBlockAndState(pos.offset(facing.toOffset()))
  if (targetBlock == blockComparator()):
    let props1 = ComparatorLikeProperties.fromStateId(targetState.id, targetBlock)
    (not (props1.facing == facing))
  elif (targetBlock == blockRepeater()):
    let props2 = RepeaterLikeProperties.fromStateId(targetState.id, targetBlock)
    (not (props2.facing == facing))
  else:
    false

proc canPlaceAt*(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): bool =
  let f = self.canPlaceAtImpl
  f(self, world, pos)

proc canPlaceAbove*(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState): bool =
  let f = self.canPlaceAboveImpl
  f(self, world, pos, state)

