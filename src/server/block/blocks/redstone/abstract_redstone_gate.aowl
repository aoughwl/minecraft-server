import ../../blockprelude

type
  GateProps* = object
    ## `T: RedstoneGateBlockProperties`: the repeater's and the comparator's properties, by name.
    values: seq[(string, string)]

proc gatePropsOf*(stateId: BlockStateId; blockRef: Block): GateProps =
  ## `T::from_state_id`
  let (has, dyn) = blockRef.properties(stateId)
  if not has:
    rustPanic(blockRef.name & " has no properties")
  GateProps(values: dyn.toProps())

proc gatePropsDefault*(blockRef: Block): GateProps = gatePropsOf(blockRef.defaultState.id, blockRef)

proc isPowered*(self: GateProps): bool =
  for entry in self.values:
    if entry[0] == "powered":
      return entry[1] == "true"
  false

proc getFacing*(self: GateProps): HorizontalFacing =
  for entry in self.values:
    if entry[0] == "facing":
      return HorizontalFacing.fromValue(entry[1])
  rustPanic("no facing")

proc setFacing*(self: var GateProps; facing: HorizontalFacing) =
  for i in 0 ..< self.values.len:
    if self.values[i][0] == "facing":
      self.values[i] = ("facing", facing.toValue())

proc toStateId*(self: GateProps; blockRef: Block): BlockStateId =
  blockRef.fromProperties(self.values).toStateId(blockRef)
import redstonemod


type
  RedstoneGateBlock* = ref object
    canPlaceAtImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): bool {.closure.}
    canPlaceAboveImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState): bool {.closure.}
    getWeakRedstonePowerImpl*: proc(self: RedstoneGateBlock, args: GetRedstonePowerArgs): uint8 {.closure.}
    getStrongRedstonePowerImpl*: proc(self: RedstoneGateBlock, args: GetRedstonePowerArgs): uint8 {.closure.}
    getOutputLevelImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): uint8 {.closure.}
    onNeighborUpdateImpl*: proc(self: RedstoneGateBlock, args: OnNeighborUpdateArgs) {.closure.}
    updatePoweredImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block) {.closure.}
    hasPowerImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): bool {.closure.}
    getPowerImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): uint8 {.closure.}
    getMaxInputLevelSidesImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block, onlyGate: bool): uint8 {.closure.}
    updateTargetImpl*: proc(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block) {.closure.}
    onPlaceImpl*: proc(self: RedstoneGateBlock, player: BlockPlayer, blockRef: Block): BlockStateId {.closure.}
    playerPlacedImpl*: proc(self: RedstoneGateBlock, args: PlayerPlacedArgs) {.closure.}
    onStateReplacedImpl*: proc(self: RedstoneGateBlock, args: OnStateReplacedArgs) {.closure.}
