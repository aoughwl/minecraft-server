import ../../blockprelude
import ../abstract_wall_mounting
import redstonemod
import ../../entities/bell


type
  BellBlock* = object

var gBellBlockAsWallMountedBlock: nil WallMountedBlock


proc ringBell*(position: BlockPos, world: BlockWorld, hitDirection: Option[HorizontalFacing])
proc isPointOnBell*(hit: BlockHitResult, attachment: BellAttachment, blockFace: HorizontalFacing): bool
proc isSingleWall*(position: BlockPos, facing: HorizontalFacing, world: BlockWorld): bool
proc bellBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc bellBlockAsWallMountedBlock*(): WallMountedBlock
proc bellBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc bellBlockBroken_BlockBehaviour(args: BrokenArgs)
proc bellBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc bellBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc bellBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc bellBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newBellBlock*(): BlockBehaviour

proc ringBell*(position: BlockPos, world: BlockWorld, hitDirection: Option[HorizontalFacing]) =
  let (blockRef, stateId) = world.getBlockAndStateId(position)
  let props = BellLikeProperties.fromStateId(stateId, blockRef)
  let direction = hitDirection.get(props.facing)
  block chain3:
    let t1 = world.getBlockEntity(position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = asType(t1.unsafeGet, BellBlockEntity)
      if t2.isSome:
        let be = t2.unsafeGet
        t2.unsafeGet.activate(direction)
  world.playSoundFine(sdBlockBellUse, scBlocks, position.toCenteredF64(), 1.0, 2.0)

proc isPointOnBell*(hit: BlockHitResult, attachment: BellAttachment, blockFace: HorizontalFacing): bool =
  if ((hit.face == BlockDirection.Up) or (hit.face == BlockDirection.Down)):
    return false
  if (hit.cursorPos.y <= 0.8124'f32):
    case attachment
    of BellAttachment.Floor:
      (hit.face.toAxis() == blockFace.toBlockDirection().toAxis())
    of BellAttachment.SingleWall, BellAttachment.DoubleWall:
      (not (hit.face.toAxis() == blockFace.toBlockDirection().toAxis()))
    of BellAttachment.Ceiling:
      true
  else:
    false

proc isSingleWall*(position: BlockPos, facing: HorizontalFacing, world: BlockWorld): bool =
  (not world.getBlock(position.offset(facing.toOffset())).isSolid())

proc bellBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let props = BellLikeProperties.fromStateId(stateId, blockRef)
  case props.attachment
  of BellAttachment.Ceiling:
    BlockDirection.Down
  of BellAttachment.Floor:
    BlockDirection.Up
  of BellAttachment.SingleWall, BellAttachment.DoubleWall:
    props.facing.opposite().toBlockDirection()

proc bellBlockAsWallMountedBlock*(): WallMountedBlock =
  if gBellBlockAsWallMountedBlock == nil:
    let v = newWallMountedBlock()
    v.getDirectionImpl = bellBlockGetDirection_WallMountedBlock
    gBellBlockAsWallMountedBlock = v
  gBellBlockAsWallMountedBlock

proc bellBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t4 = args.direction
  let t5 = args.world
  if t4.isSome and t5.isSome:
    let direction = t4.unsafeGet
    let world = t5.unsafeGet
    if (t4.unsafeGet == BlockDirection.Up):
      let blockRef: Block = t5.unsafeGet.getBlock(args.position)
      if blockRef.hasTag(Block_MINECRAFT_UNSTABLE_BOTTOM_CENTER):
        false
      else:
        let blockPos = args.position.offset(t4.unsafeGet.toOffset())
        let blockState = t5.unsafeGet.getBlockState(blockPos)
        blockState.isCenterSolid(t4.unsafeGet)
    else:
      canPlaceAt(bellBlockAsWallMountedBlock(), t5.unsafeGet, args.position, t4.unsafeGet)
  else:
    false

proc bellBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let world: BlockWorld = args.world
  world.removeBlockEntity(args.position)

proc bellBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newBellBlockEntity(args.position))

proc bellBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  let props = BellLikeProperties.fromStateId(state.id, args.block0)
  if (not isPointOnBell(args.hit, props.attachment, props.facing)):
    return barPass
  ringBell(args.position, args.world, toOpt(args.hit.face.toHorizontalFacing()))
  args.player.incrementStat(scCustom, int32(csBellRing), 1)
  barSuccess

proc bellBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = BellLikeProperties.defaultFor(args.block0)
  let (blockFace, facing) = getPlacementFace(bellBlockAsWallMountedBlock(), args.player, args.direction)
  let t6 = block:
    case blockFace
    of AttachFace.Floor, AttachFace.Ceiling:
      facing
    of AttachFace.Wall:
      facing.opposite()
  props.facing = t6
  let t7 = block:
    case blockFace
    of AttachFace.Wall:
      if isSingleWall(args.position, props.facing.opposite(), args.world):
        BellAttachment.SingleWall
      else:
        BellAttachment.DoubleWall
    of AttachFace.Floor:
      BellAttachment.Floor
    of AttachFace.Ceiling:
      BellAttachment.Ceiling
  props.attachment = t7
  props.toStateId(args.block0)

proc bellBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let world: BlockWorld = args.world
  let isReceivingPower = blockReceivesRedstonePower(world, args.position)
  let state = args.world.getBlockState(args.position)
  var props = BellLikeProperties.fromStateId(state.id, args.block0)
  if (not (props.powered == isReceivingPower)):
    props.powered = isReceivingPower
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
    if isReceivingPower:
      ringBell(args.position, args.world, none[HorizontalFacing]())

proc newBellBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = bellBlockCanPlaceAt_BlockBehaviour
  result.brokenImpl = bellBlockBroken_BlockBehaviour
  result.placedImpl = bellBlockPlaced_BlockBehaviour
  result.normalUseImpl = bellBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = bellBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = bellBlockOnNeighborUpdate_BlockBehaviour

proc registerBlocksRedstoneBell*(r: BlockRegistry) =
  r.register("minecraft:bell", newBellBlock())

