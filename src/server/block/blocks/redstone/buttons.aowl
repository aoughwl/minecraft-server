## Port of pumpkin/src/block/blocks/redstone/buttons.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import lever
import ../abstract_wall_mounting


type
  ButtonLikeProperties = LeverLikeProperties
  ButtonBlock* = object

var gButtonBlockAsWallMountedBlock: nil WallMountedBlock


proc clickButton*(world: BlockWorld, blockPos: BlockPos)
proc buttonBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc buttonBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc buttonBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc buttonBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc buttonBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc buttonBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc buttonBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc buttonBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc buttonBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newButtonBlock*(): BlockBehaviour
proc buttonBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc buttonBlockAsWallMountedBlock*(): WallMountedBlock
proc updateNeighbors*(world: BlockWorld, blockPos: BlockPos, props: ButtonLikeProperties)

proc clickButton*(world: BlockWorld, blockPos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(blockPos)
  var buttonProps = ButtonLikeProperties.fromStateId(state, blockRef)
  if (not buttonProps.powered):
    buttonProps.powered = true
    discard world.setBlockState(blockPos, buttonProps.toStateId(blockRef), BfNotifyAll)
    let t1 = block:
      if (blockRef == blockStoneButton()):
        20
      else:
        30
    let delay = t1
    world.scheduleBlockTick(blockRef, blockPos, delay, tpNormal)
    updateNeighbors(world, blockPos, buttonProps)

proc buttonBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  clickButton(args.world, args.position)
  barSuccess

proc buttonBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  var props = ButtonLikeProperties.fromStateId(state.id, args.block0)
  props.powered = false
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
  updateNeighbors(args.world, args.position, props)

proc buttonBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc buttonBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let buttonProps = ButtonLikeProperties.fromStateId(args.state.id, args.block0)
  if buttonProps.powered:
    15'u8
  else:
    0'u8

proc buttonBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let buttonProps = ButtonLikeProperties.fromStateId(args.state.id, args.block0)
  if buttonProps.powered and (buttonProps.getDirection() == args.direction):
    15'u8
  else:
    0'u8

proc buttonBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if (not args.moved):
    let buttonProps = ButtonLikeProperties.fromStateId(args.oldStateId, args.block0)
    if buttonProps.powered:
      updateNeighbors(args.world, args.position, buttonProps)

proc buttonBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = ButtonLikeProperties.fromStateId(args.block0.defaultState.id, args.block0)
  (props.face, props.facing) = getPlacementFace(buttonBlockAsWallMountedBlock(), args.player, args.direction)
  props.toStateId(args.block0)

proc buttonBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  # Use the provided direction, or fallback to the current state's direction if missing
  let t2 = args.direction
  let t3 =
    if t2.isSome: t2.unsafeGet
    else:
      getDirection(buttonBlockAsWallMountedBlock(), args.state.id, args.block0)
  let direction = t3
  canPlaceAt(buttonBlockAsWallMountedBlock(), args.blockAccessor, args.position, direction)

proc buttonBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(buttonBlockAsWallMountedBlock(), args)

proc newButtonBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = buttonBlockNormalUse_BlockBehaviour
  result.onScheduledTickImpl = buttonBlockOnScheduledTick_BlockBehaviour
  result.emitsRedstonePowerImpl = buttonBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = buttonBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = buttonBlockGetStrongRedstonePower_BlockBehaviour
  result.onStateReplacedImpl = buttonBlockOnStateReplaced_BlockBehaviour
  result.onPlaceImpl = buttonBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = buttonBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = buttonBlockGetStateForNeighborUpdate_BlockBehaviour

proc buttonBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let props = ButtonLikeProperties.fromStateId(stateId, blockRef)
  case props.face
  of AttachFace.Floor:
    BlockDirection.Up
  of AttachFace.Ceiling:
    BlockDirection.Down
  of AttachFace.Wall:
    props.facing.toBlockDirection()

proc buttonBlockAsWallMountedBlock*(): WallMountedBlock =
  if gButtonBlockAsWallMountedBlock == nil:
    let v = newWallMountedBlock()
    v.getDirectionImpl = buttonBlockGetDirection_WallMountedBlock
    gButtonBlockAsWallMountedBlock = v
  gButtonBlockAsWallMountedBlock

proc updateNeighbors*(world: BlockWorld, blockPos: BlockPos, props: ButtonLikeProperties) =
  let direction = props.getDirection().opposite()
  world.updateNeighbors(blockPos, none[BlockDirection]())
  world.updateNeighbors(blockPos.offset(direction.toOffset()), none[BlockDirection]())

proc registerBlocksRedstoneButtons*(r: BlockRegistry) =
  r.registerTag("minecraft:buttons", newButtonBlock())

