proc comparatorBlockAsRedstoneGateBlock*(): RedstoneGateBlock =
  if gComparatorBlockAsRedstoneGateBlock == nil:
    let v = newRedstoneGateBlock()
    v.getOutputLevelImpl = comparatorBlockGetOutputLevel_RedstoneGateBlock
    v.updatePoweredImpl = comparatorBlockUpdatePowered_RedstoneGateBlock
    v.hasPowerImpl = comparatorBlockHasPower_RedstoneGateBlock
    v.getPowerImpl = comparatorBlockGetPower_RedstoneGateBlock
    v.getUpdateDelayInternalImpl = comparatorBlockGetUpdateDelayInternal_RedstoneGateBlock
    gComparatorBlockAsRedstoneGateBlock = v
  gComparatorBlockAsRedstoneGateBlock

proc onUse*(self: ComparatorBlock, props: ComparatorLikeProperties, world: BlockWorld, blockPos: BlockPos, blockRef: Block) =
  var props = props
  # Vanilla Parity TODO:
  # playSound(player, pos, SoundEvents.COMPARATOR_CLICK, SoundSource.BLOCKS, 0.3F, pitch);
  # Pitch is 0.55F if SUBTRACT, 0.5F if COMPARE.
  let t11 = block:
    case props.mode
    of ModeComparator.Compare:
      ModeComparator.Subtract
    of ModeComparator.Subtract:
      ModeComparator.Compare
  props.mode = t11
  let stateId = props.toStateId(blockRef)
  discard world.setBlockState(blockPos, stateId, 0'u32)
  self.update(world, blockPos, BlockState.fromId(stateId), blockRef)

proc calculateOutputSignal*(self: ComparatorBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): uint8 =
  let power = getPower(comparatorBlockAsRedstoneGateBlock(), world, pos, state, blockRef)
  if (power == 0):
    return 0
  let subPower = getMaxInputLevelSides(comparatorBlockAsRedstoneGateBlock(), world, pos, state.id, blockRef, false)
  if (subPower > power):
    return 0
  let props = ComparatorLikeProperties.fromStateId(state.id, blockRef)
  if (props.mode == ModeComparator.Subtract):
    (power - subPower)
  else:
    power

proc getAttachedItemframeLevel*(world: BlockWorld, facing: HorizontalFacing, pos: BlockPos): Option[uint8] =
  let direction = facing.toBlockDirection()
  var level = none[uint8]()
  let t12 = world.getEntitiesAtBox(BoundingBox.fromBlock(pos))
  for entity in t12:
    let frameFacing = entity.itemFrameFacing0
    if frameFacing == nil:
      continue
    if (not (frameFacing() == direction)):
      continue
    if level.isSome():
      # Vanilla only reads a frame when exactly one hangs on this block.
      return none[uint8]()
    level = some((let frameOutput = entity.itemFrameOutput0; frameOutput()))
  level

proc update*(self: ComparatorBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block) =
  let futureLevel = int32(self.calculateOutputSignal(world, pos, state, blockRef))
  var nowLevel = 0
  block chain16:
    let t14 = world.getBlockEntity(pos)
    if t14.isSome:
      let blockentity = t14.unsafeGet
      let t15 = asType(t14.unsafeGet, ComparatorBlockEntity)
      if t15.isSome:
        let comparator = t15.unsafeGet
        nowLevel = int32(t15.unsafeGet.outputSignal)
        t15.unsafeGet.outputSignal = uint8(futureLevel)
  var props = ComparatorLikeProperties.fromStateId(state.id, blockRef)
  if ((not (nowLevel == futureLevel)) or (props.mode == ModeComparator.Compare)):
    let futurePower = hasPower(comparatorBlockAsRedstoneGateBlock(), world, pos, state, blockRef)
    let nowPower = props.powered
    if nowPower and (not futurePower):
      props.powered = false
      discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyListeners)
    else:
      if (not nowPower) and futurePower:
        props.powered = true
        discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyListeners)
    updateTarget(comparatorBlockAsRedstoneGateBlock(), world, pos, props.toStateId(blockRef), blockRef)

proc registerBlocksRedstoneComparator*(r: BlockRegistry) =
  r.register("minecraft:comparator", newComparatorBlock())

