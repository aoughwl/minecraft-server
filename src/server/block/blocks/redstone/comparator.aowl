proc comparatorBlockGetOutputLevel_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): uint8 =
  block chain3:
    let t1 = world.getBlockEntity(pos)
    if t1.isSome:
      let blockentity = t1.unsafeGet
