        return t2.unsafeGet.outputSignal
  0'u8

proc comparatorBlockUpdatePowered_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block) =
  if world.isBlockTickScheduled(pos, blockRef):
    return
  let i = ComparatorBlock().calculateOutputSignal(world, pos, state, blockRef)
  let j = getOutputLevel(comparatorBlockAsRedstoneGateBlock(), world, pos)
  let props = ComparatorLikeProperties.fromStateId(state.id, blockRef)
  if ((not (i == j)) or (not (props.powered == hasPower(comparatorBlockAsRedstoneGateBlock(), world, pos, state, blockRef)))):
    let t4 = block:
      if isTargetNotAligned(comparatorBlockAsRedstoneGateBlock(), world, pos, state, blockRef):
        tpHigh
      else:
        tpNormal
    let priority = t4
    world.scheduleBlockTick(blockRef, pos, getUpdateDelayInternal(comparatorBlockAsRedstoneGateBlock(), state.id, blockRef), priority)

proc comparatorBlockHasPower_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): bool =
  let i = getPower(comparatorBlockAsRedstoneGateBlock(), world, pos, state, blockRef)
  if (i == 0):
    return false
  let j = getMaxInputLevelSides(comparatorBlockAsRedstoneGateBlock(), world, pos, state.id, blockRef, false)
  if (i > j):
    true
  else:
    let props = ComparatorLikeProperties.fromStateId(state.id, blockRef)
    ((i == j) and (props.mode == ModeComparator.Compare))

proc comparatorBlockGetPower_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block): uint8 =
  let redstoneLevel = getPower(world, pos, state.id, blockRef)
  let props = ComparatorLikeProperties.fromStateId(state.id, blockRef)
  let facing = props.facing
  let sourcePos = pos.offset(facing.toOffset())
  let (sourceBlock, sourceState) = world.getBlockAndState(sourcePos)
  block chain7:
    let t5 = world.blockRegistry.getPumpkinBlock(sourceBlock.id)
    if t5.isSome:
      let pumpkinBlock = t5.unsafeGet
      let t6 = t5.unsafeGet.getComparatorOutput(GetComparatorOutputArgs(world: world, block0: sourceBlock, state: sourceState, position: sourcePos))
      if t6.isSome:
        let level = t6.unsafeGet
        return t6.unsafeGet
  if (redstoneLevel < 15) and sourceState.isSolidBlock():
    let deeperSourcePos = sourcePos.offset(facing.toOffset())
    let (deeperBlock, deeperState) = world.getBlockAndState(deeperSourcePos)
    let itemframeLevel = getAttachedItemframeLevel(world, facing, deeperSourcePos)
    # This is the correct way to handle the async call within the Option
    let t8 = block:
      let t9 = world.blockRegistry.getPumpkinBlock(deeperBlock.id)
      if t9.isSome:
        let pumpkinBlock = t9.unsafeGet
        t9.unsafeGet.getComparatorOutput(GetComparatorOutputArgs(world: world, block0: deeperBlock, state: deeperState, position: deeperSourcePos))
      else:
        none[uint8]()
    let blockLevel = t8
    let t10 = itemframeLevel.max(blockLevel)
    if t10.isSome:
      let level = t10.unsafeGet
      return t10.unsafeGet
  redstoneLevel

proc comparatorBlockGetUpdateDelayInternal_RedstoneGateBlock(self: RedstoneGateBlock, stateId: BlockStateId, blockRef: Block): uint8 =
