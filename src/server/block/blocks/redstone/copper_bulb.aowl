## Port of pumpkin/src/block/blocks/redstone/copper_bulb.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import redstonemod


type
  CopperBulbBlock* = object



proc copperBulbBlockIds*(): seq[BlockId]
proc copperBulbBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc copperBulbBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newCopperBulbBlock*(): BlockBehaviour

proc copperBulbBlockIds*(): seq[BlockId] =
  @[blockIdCopperBulb, blockIdExposedCopperBulb, blockIdWeatheredCopperBulb, blockIdOxidizedCopperBulb, blockIdWaxedCopperBulb, blockIdWaxedExposedCopperBulb, blockIdWaxedWeatheredCopperBulb, blockIdWaxedOxidizedCopperBulb]

proc copperBulbBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = CopperBulbLikeProperties.defaultFor(args.block0)
  let isReceivingPower = blockReceivesRedstonePower(args.world, args.position)
  if isReceivingPower:
    props.lit = true
    args.world.playBlockSound(sdBlockCopperBulbTurnOn, scBlocks, args.position)
    props.powered = true
  props.toStateId(args.block0)

proc copperBulbBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockState(args.position)
  var props = CopperBulbLikeProperties.fromStateId(state.id, args.block0)
  let isReceivingPower = blockReceivesRedstonePower(args.world, args.position)
  if (props.powered != isReceivingPower):
    if (not props.powered):
      props.lit = (not props.lit)
      let t1 = block:
        if props.lit:
          sdBlockCopperBulbTurnOn
        else:
          sdBlockCopperBulbTurnOff
      args.world.playBlockSound(t1, scBlocks, args.position)
    props.powered = isReceivingPower
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)

proc newCopperBulbBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = copperBulbBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = copperBulbBlockOnNeighborUpdate_BlockBehaviour

proc registerBlocksRedstoneCopperBulb*(r: BlockRegistry) =
  r.registerIds(copperBulbBlockIds(), newCopperBulbBlock())

