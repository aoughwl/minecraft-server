## Port of pumpkin/src/block/blocks/redstone/crafter.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../../containers
import ../../../../generated/translation
import ../../../../inventory/genericcontainer
import redstonemod
import ../../entities/crafter

proc crafterScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `CrafterScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_CRAFTER, BEDROCK_CONTAINER_CRAFTER),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createCrafter3x3(syncId, playerInventory, inventory)))

proc crafterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  args.player.openHandledScreen(crafterScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc crafterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = CrafterLikeProperties.defaultFor(args.block0)
  let facing = args.direction
  let horizontal = args.player.getHorizontalFacing()
  props.orientation =
    case facing
    of BlockDirection.Down:
      case horizontal
      of HorizontalFacing.North: Orientation.DownNorth
      of HorizontalFacing.South: Orientation.DownSouth
      of HorizontalFacing.East: Orientation.DownEast
      of HorizontalFacing.West: Orientation.DownWest
    of BlockDirection.Up:
      case horizontal
      of HorizontalFacing.North: Orientation.UpNorth
      of HorizontalFacing.South: Orientation.UpSouth
      of HorizontalFacing.East: Orientation.UpEast
      of HorizontalFacing.West: Orientation.UpWest
    of BlockDirection.North: Orientation.NorthUp
    of BlockDirection.South: Orientation.SouthUp
    of BlockDirection.East: Orientation.EastUp
    of BlockDirection.West: Orientation.WestUp
  props.toStateId(args.block0)

proc crafterBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newCrafterBlockEntity(args.position))

proc crafterBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = blockReceivesRedstonePower(args.world, args.position)
  var props = CrafterLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and not props.triggered:
    props.triggered = true
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  elif not powered and props.triggered:
    props.triggered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc crafterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  var props = CrafterLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  # Set to crafting state
  props.crafting = true
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  # Recipes/crafting logic not fully implemented yet - play fail effects
  args.world.playSound(sdBlockCrafterFail, scBlocks, args.position.toF64())
  # Spawn fail smoke particles
  let data =
    case props.orientation
    of Orientation.DownEast, Orientation.DownNorth, Orientation.DownSouth, Orientation.DownWest: 0'i32
    of Orientation.UpEast, Orientation.UpNorth, Orientation.UpSouth, Orientation.UpWest: 1'i32
    of Orientation.NorthUp: 2'i32
    of Orientation.SouthUp: 3'i32
    of Orientation.WestUp: 4'i32
    of Orientation.EastUp: 5'i32
  args.world.syncWorldEvent(weParticlesShootSmoke, args.position, data)
  # Set crafting state back to false
  props.crafting = false
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc crafterBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  if not (blockEntity.unsafeGet of CrafterBlockEntity):
    return none[uint8]()
  let crafter = CrafterBlockEntity(blockEntity.unsafeGet)
  var occupied = 0'u8
  for i in 0 ..< 9:
    if not crafter.inv.items[i].isEmpty():
      occupied += 1'u8
  some(occupied)

proc newCrafterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = crafterBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = crafterBlockOnPlace_BlockBehaviour
  result.placedImpl = crafterBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = crafterBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = crafterBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = crafterBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksRedstoneCrafter*(r: BlockRegistry) =
  r.register("minecraft:crafter", newCrafterBlock())
