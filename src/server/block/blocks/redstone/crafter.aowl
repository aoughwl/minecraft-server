import ../../blockprelude
import redstonemod
import ../../entities/crafter


type
  CrafterScreenFactory* = R2A_MANUAL_tuple_struct
  CrafterBlock* = object



proc createScreenHandler*(self: CrafterScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: CrafterScreenFactory): TextComponent
proc crafterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc crafterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc crafterBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc crafterBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc crafterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc crafterBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8]
proc newCrafterBlock*(): BlockBehaviour

proc createScreenHandler*(self: CrafterScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = createCrafter3x3(syncId, playerInventory, self[0])
  let screenHandlerArc = handler
  some(SharedScreenHandler(screenHandlerArc))

proc getDisplayName*(self: CrafterScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_CRAFTER, CONTAINER_CRAFTER, [])

proc crafterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        args.player.openHandledScreen(CrafterScreenFactory(t2.unsafeGet), some(args.position))
  barSuccess

proc crafterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = CrafterLikeProperties.defaultFor(args.block0)
  let facing = args.direction
  let horizontal = args.player.livingEntity.entity.getHorizontalFacing()
  let t4 = block:
    case facing
    of BlockDirection.Down:
      case horizontal
      of HorizontalFacing.North:
        Orientation.DownNorth
      of HorizontalFacing.South:
        Orientation.DownSouth
      of HorizontalFacing.East:
        Orientation.DownEast
      of HorizontalFacing.West:
        Orientation.DownWest
    of BlockDirection.Up:
      case horizontal
      of HorizontalFacing.North:
        Orientation.UpNorth
      of HorizontalFacing.South:
        Orientation.UpSouth
      of HorizontalFacing.East:
        Orientation.UpEast
      of HorizontalFacing.West:
        Orientation.UpWest
    of BlockDirection.North:
      Orientation.NorthUp
    of BlockDirection.South:
      Orientation.SouthUp
    of BlockDirection.East:
      Orientation.EastUp
    of BlockDirection.West:
      Orientation.WestUp
  props.orientation = t4
  props.toStateId(args.block0)

proc crafterBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let crafterBlockEntity = newCrafterBlockEntity(args.position)
  args.world.addBlockEntity(crafterBlockEntity)

proc crafterBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = blockReceivesRedstonePower(args.world, args.position)
  var props = CrafterLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and (not props.triggered):
    props.triggered = true
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  else:
    if (not powered) and props.triggered:
      props.triggered = false
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc crafterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  var props = CrafterLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  # Set to crafting state
  props.crafting = true
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  # Recipes/crafting logic not fully implemented yet - play fail effects
  args.world.playSound(sdBlockCrafterFail, scBlocks, args.position.toF64())
  # Spawn fail smoke particles
  let t5 = block:
    case props.orientation
    of Orientation.DownEast, Orientation.DownNorth, Orientation.DownSouth, Orientation.DownWest:
      0
    of Orientation.UpEast, Orientation.UpNorth, Orientation.UpSouth, Orientation.UpWest:
      1
    of Orientation.NorthUp:
      2
    of Orientation.SouthUp:
      3
    of Orientation.WestUp:
      4
    of Orientation.EastUp:
      5
  args.world.syncWorldEvent(weParticlesShootSmoke, args.position, t5)
  # Set crafting state back to false
  props.crafting = false
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc crafterBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let t6 = args.world.getBlockEntity(args.position)
  if t6.isSome:
    let blockEntity = t6.unsafeGet
    let t7 = asType(t6.unsafeGet, CrafterBlockEntity)
    if t7.isNone: return none[uint8]()
    let crafter = t7.unsafeGet
    var occupied = 0'u8
    for i in 0 ..< 9:
      let stack = crafter.getStack(i)
      if (not isEmpty(stack)):
        occupied += 1
    some(occupied)
  else:
    none[uint8]()

proc newCrafterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = crafterBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = crafterBlockOnPlace_BlockBehaviour
  result.placedImpl = crafterBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = crafterBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = crafterBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = crafterBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksRedstoneCrafter*(r: BlockRegistry) =
  r.register("minecraft:crafter", newCrafterBlock())

