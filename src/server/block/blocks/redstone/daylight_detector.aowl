## Port of pumpkin/src/block/blocks/redstone/daylight_detector.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../../entities/daylight_detector


type
  DaylightDetectorProperties = DaylightDetectorLikeProperties
  DaylightDetectorBlock* = object



proc daylightDetectorBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc daylightDetectorBlockBroken_BlockBehaviour(args: BrokenArgs)
proc daylightDetectorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc daylightDetectorBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc daylightDetectorBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc newDaylightDetectorBlock*(): BlockBehaviour
proc updateInverted*(self: DaylightDetectorBlock, props: DaylightDetectorProperties, world: BlockWorld, blockPos: BlockPos, blockRef: Block)

proc daylightDetectorBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newDaylightDetectorBlockEntity(args.position))

proc daylightDetectorBlockBroken_BlockBehaviour(args: BrokenArgs) =
  args.world.removeBlockEntity(args.position)

proc daylightDetectorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let self = DaylightDetectorBlock()
  let playerAbilities = args.player.abilities
  if (not playerAbilities.allowModifyWorld):
    return barPass
  let state = args.world.getBlockState(args.position)
  let props = DaylightDetectorProperties.fromStateId(state.id, args.block0)
  self.updateInverted(props, args.world, args.position, args.block0)
  updatePower(args.world, args.position)
  barSuccess

proc daylightDetectorBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = DaylightDetectorProperties.fromStateId(args.state.id, args.block0)
  props.power

proc daylightDetectorBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc newDaylightDetectorBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = daylightDetectorBlockPlaced_BlockBehaviour
  result.brokenImpl = daylightDetectorBlockBroken_BlockBehaviour
  result.normalUseImpl = daylightDetectorBlockNormalUse_BlockBehaviour
  result.getWeakRedstonePowerImpl = daylightDetectorBlockGetWeakRedstonePower_BlockBehaviour
  result.emitsRedstonePowerImpl = daylightDetectorBlockEmitsRedstonePower_BlockBehaviour

proc updateInverted*(self: DaylightDetectorBlock, props: DaylightDetectorProperties, world: BlockWorld, blockPos: BlockPos, blockRef: Block) =
  var props1 = props
  props1.inverted = (not props1.inverted)
  let state = props1.toStateId(blockRef)
  discard world.setBlockState(blockPos, state, BfNotifyListeners)

proc registerBlocksRedstoneDaylightDetector*(r: BlockRegistry) =
  r.register("minecraft:daylight_detector", newDaylightDetectorBlock())

