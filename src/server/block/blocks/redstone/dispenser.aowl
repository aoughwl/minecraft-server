## Port of pumpkin/src/block/blocks/redstone/dispenser.rs
## PARTIAL: pumpkin/src/block/blocks/redstone/dispenser.rs - boats are dropped as items instead of placed on the water (`BoatItem` is above the blocks); a spawn egg is spawned without `apply_entity_variant` and a random yaw, an armor stand and a boat-less dispense without the facing rotation (there is no rotation hook on a `BlockActor`); an arrow is not marked `ArrowPickup::Allowed` and a primed TNT keeps the default power, both being fields no hook reaches. Items dropped, arrows, TNT, armor stands and spawn eggs are dispensed as upstream does.
## Items leave through the hooks of `BlockWorld`: `spawnItemWithVelocity` for `drop_item` (pickup delay 40), `spawnEntity0` with the entity type's name for the rest.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/strutils
import ../../blockprelude
import ../../containers
import ../../../../generated/translation
import ../../../../inventory/genericcontainer
import ../../../../generated/entity_type
import redstonemod
import dropper
import ../../entities/dispenser

proc dispenserScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `DispenserScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_DISPENSER, BEDROCK_CONTAINER_DISPENSER),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createGeneric3x3(syncId, playerInventory, inventory)))

type
  DispenseContext = object
    world: BlockWorld
    position: BlockPos
    facing: Facing

const
  ARROW_DISPENSE_POWER: float64 = 1.1
  ARROW_DISPENSE_UNCERTAINTY: float64 = 6.0
  SpawnEggSuffix = "_spawn_egg"

proc scaled(v: Vector3[float64]; f: float64): Vector3[float64] =
  Vector3[float64](x: v.x * f, y: v.y * f, z: v.z * f)

proc targetPosition(ctx: DispenseContext): BlockPos =
  let facing = toNormal(ctx.facing)
  ctx.position.offset(Vector3[int32](x: int32(facing.x), y: int32(facing.y), z: int32(facing.z)))

proc dispenseSound(ctx: DispenseContext) =
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0'i32)

proc shootSmoke(ctx: DispenseContext) =
  ctx.world.syncWorldEvent(weParticlesShootSmoke, ctx.position, toData3d(ctx.facing))

proc fireArrow(ctx: DispenseContext, item: var ItemStack) =
  # TODO upstream: Add tipped arrows
  let entityName = if item.getItem().registryKey == "spectral_arrow": "spectral_arrow" else: "arrow"
  discard item.split(1'u8)
  let facing = toNormal(ctx.facing)
  let position = ctx.position.toCenteredF64()
  let spawnPos = Vector3[float64](x: position.x + facing.x * 0.7, y: position.y + facing.y * 0.7, z: position.z + facing.z * 0.7)
  let spawn = ctx.world.spawnEntity0
  if spawn != nil:
    let arrow = spawn(entityName, spawnPos, none[NbtCompound]())
    if arrow != nil:
      # `ArrowEntity::set_velocity(x, y + 0.1, z, power, uncertainty)`: normalised, a triangular spread per axis, times the power
      let dir = Vector3[float64](x: facing.x, y: facing.y + 0.1, z: facing.z).normalize()
      let spread = 0.0172275 * ARROW_DISPENSE_UNCERTAINTY
      let velocity = Vector3[float64](x: (dir.x + triangle(0.0, spread)) * ARROW_DISPENSE_POWER,
        y: (dir.y + triangle(0.0, spread)) * ARROW_DISPENSE_POWER, z: (dir.z + triangle(0.0, spread)) * ARROW_DISPENSE_POWER)
      let setV = arrow.setVelocity0
      if setV != nil:
        setV(velocity)
  ctx.world.syncWorldEvent(weSoundDispenserProjectileLaunch, ctx.position, 0'i32)
  shootSmoke(ctx)

proc dispenseArmorStand(ctx: DispenseContext, item: var ItemStack): bool =
  let spawnPos = targetPosition(ctx).toF64()
  # upstream first checks that the box of an armor stand has room there (`has_room_for`)
  let dimension = EntityType.ARMOR_STAND.dimension
  let box = BoundingBox.newFromPos(spawnPos.x, spawnPos.y, spawnPos.z,
    newEntityDimensions(dimension[0], dimension[1], EntityType.ARMOR_STAND.eyeHeight))
  if ctx.world.getEntitiesAtBox(box).len > 0:
    return false
  discard item.split(1'u8)
  ctx.world.playSound(sdEntityArmorStandPlace, scBlocks, spawnPos)
  let spawn = ctx.world.spawnEntity0
  if spawn != nil:
    discard spawn("armor_stand", spawnPos, none[NbtCompound]())
  dispenseSound(ctx)
  true

proc dispenseTnt(ctx: DispenseContext, item: var ItemStack) =
  const TNT_FUSE: uint32 = 80
  discard item.split(1'u8)
  let spawnPos = targetPosition(ctx).toF64()
  let spawn = ctx.world.spawnEntity0
  if spawn != nil:
    let tnt = spawn("tnt", spawnPos, none[NbtCompound]())
    if tnt != nil:
      tnt.setFuse(TNT_FUSE)
  ctx.world.playSound(sdEntityTntPrimed, scBlocks, spawnPos)
  dispenseSound(ctx)

proc eggEntityName(item: ItemStack): (bool, string) =
  ## `entity_from_egg`, by the item's name
  let key = item.getItem().registryKey
  if key.len > SpawnEggSuffix.len and key.endsWith(SpawnEggSuffix):
    return (true, key[0 ..< key.len - SpawnEggSuffix.len])
  (false, "")

proc dispenseSpawnEgg(ctx: DispenseContext, item: var ItemStack, entityName: string) =
  discard item.split(1'u8)
  let spawnPos = targetPosition(ctx).toF64()
  let spawn = ctx.world.spawnEntity0
  if spawn != nil:
    discard spawn(entityName, spawnPos, none[NbtCompound]())
  dispenseSound(ctx)

proc dropItem(ctx: DispenseContext, item: var ItemStack) =
  let dropItem = item.split(1'u8)
  let facing = toNormal(ctx.facing)
  let centered = ctx.position.toCenteredF64()
  var position = Vector3[float64](x: centered.x + facing.x * 0.7, y: centered.y + facing.y * 0.7, z: centered.z + facing.z * 0.7)
  position.y -= (if ctx.facing == Facing.Up or ctx.facing == Facing.Down: 0.125 else: 0.15625)
  let rd = randomOf(float64) * 0.1 + 0.2
  let velocity = Vector3[float64](x: triangle(facing.x * rd, 0.0172275 * 6.0), y: triangle(0.2, 0.0172275 * 6.0),
    z: triangle(facing.z * rd, 0.0172275 * 6.0))
  ctx.world.spawnItemWithVelocity(position, dropItem, velocity, 40'u8)
  dispenseSound(ctx)
  shootSmoke(ctx)

proc dispenserBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  args.player.openHandledScreen(dispenserScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc dispenserBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = DispenserLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getFacing().opposite()
  props.toStateId(args.block0)

proc dispenserBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newDispenserBlockEntity(args.position))

proc dispenserBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = blockReceivesRedstonePower(args.world, args.position) or
    blockReceivesRedstonePower(args.world, args.position.up())
  var props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and not props.triggered:
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    props.triggered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  elif not powered and props.triggered:
    props.triggered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc dispenserBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return
  if not (blockEntity.unsafeGet of DispenserBlockEntity):
    return
  let dispenser = DispenserBlockEntity(blockEntity.unsafeGet)
  let slot = dispenser.getRandomSlot()
  if slot < 0:
    args.world.syncWorldEvent(weSoundDispenserFail, args.position, 0'i32)
    return
  var item = dispenser.inv.items[slot]
  let props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  let ctx = DispenseContext(world: args.world, position: args.position, facing: props.facing)
  # Still missing some specific dispenser behavior that you can find here:
  # https://minecraft.wiki/w/Dispenser#Usage
  let key = item.getItem().registryKey
  let egg = eggEntityName(item)
  if key == "arrow" or key == "tipped_arrow" or key == "spectral_arrow":
    # Arrows
    fireArrow(ctx, item)
  elif key == "armor_stand":
    # Armor stands
    if not dispenseArmorStand(ctx, item):
      dropItem(ctx, item)
  elif key == "tnt":
    # TNT
    dispenseTnt(ctx, item)
  elif egg[0]:
    # Spawn eggs
    dispenseSpawnEgg(ctx, item, egg[1])
  else:
    # Default / Drop (and the boats, see the PARTIAL line)
    dropItem(ctx, item)
  # the stack was taken from the slot in place upstream
  dispenser.inv.items[slot] = item
  dispenser.inv.dirty = true

proc dispenserBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return none[uint8]()
  some(calculateComparatorOutput(inventory.unsafeGet))

proc newDispenserBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = dispenserBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = dispenserBlockOnPlace_BlockBehaviour
  result.placedImpl = dispenserBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = dispenserBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = dispenserBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = dispenserBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksRedstoneDispenser*(r: BlockRegistry) =
  r.register("minecraft:dispenser", newDispenserBlock())
