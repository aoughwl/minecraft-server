proc createScreenHandler*(self: DispenserScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = createGeneric3x3(syncId, playerInventory, self[0])
  let screenHandlerArc = handler
  some(SharedScreenHandler(screenHandlerArc))

proc getDisplayName*(self: DispenserScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_DISPENSER, CONTAINER_DISPENSER, [])

proc newDispenseContext*(args: OnScheduledTickArgs, facing: Facing): DispenseContext =
  DispenseContext(world: args.world, position: args.position, facing: facing)

proc triangle*(rng: R, min: float64, max: float64): float64 =
  ((randomOf(float64) - randomOf(float64))).mulAdd(max, min)

proc toNormal*(facing: Facing): Vector3[float64] =
  case facing
  of Facing.North:
    newVector3(0.0, 0.0, (-1.0))
  of Facing.East:
    newVector3(1.0, 0.0, 0.0)
  of Facing.South:
    newVector3(0.0, 0.0, 1.0)
  of Facing.West:
    newVector3((-1.0), 0.0, 0.0)
  of Facing.Up:
    newVector3(0.0, 1.0, 0.0)
  of Facing.Down:
    newVector3(0.0, (-1.0), 0.0)

proc toData3d*(facing: Facing): int32 =
  case facing
  of Facing.North:
    2
  of Facing.East:
    5
  of Facing.South:
    3
  of Facing.West:
    4
  of Facing.Up:
    1
  of Facing.Down:
    0

proc dispenserBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        args.player.openHandledScreen(DispenserScreenFactory(t2.unsafeGet), some(args.position))
  barSuccess

proc dispenserBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = DispenserLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getEntity().getFacing().opposite()
  props.toStateId(args.block0)

proc dispenserBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let dispenserBlockEntity = newDispenserBlockEntity(args.position)
  args.world.addBlockEntity(dispenserBlockEntity)

proc dispenserBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = (blockReceivesRedstonePower(args.world, args.position) or blockReceivesRedstonePower(args.world, args.position.up()))
  var props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and (not props.triggered):
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    props.triggered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  else:
    if (not powered) and props.triggered:
      props.triggered = false
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc dispenserBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let t4 = args.world.getBlockEntity(args.position)
  if t4.isSome:
    let blockEntity = t4.unsafeGet
    let t5 = asType(t4.unsafeGet, DispenserBlockEntity)
    if not (t5.isSome):
      return
    let dispenser = t5.unsafeGet
    let t6 = dispenser.getRandomSlot()
    if t6.isSome:
      var item = t6.unsafeGet
      let props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
      let ctx = newDispenseContext(args, props.facing)
      # Still missing some specific dispenser behavior that you can find here:
      # https://minecraft.wiki/w/Dispenser#Usage
      let arrows = [itemArrow().id, itemTippedArrow().id, itemSpectralArrow().id]
      let boats = BoatItem.ids()
      if contains(arrows, item.item.id):
        # Arrows
        fireArrow(ctx, item)
      elif contains(boats, item.item.id):
        # Boats
        if (not dispenseBoat(ctx, item)):
          dropItem(ctx, item)
      elif (item.item.id == itemArmorStand().id):
        # Armor stands
        if (not dispenseArmorStand(ctx, item)):
          dropItem(ctx, item)
      elif (item.item.id == itemTnt().id):
        # TNT
        dispenseTnt(ctx, item)
      elif entityFromEgg(item.item.id).isSome():
        # Spawn eggs
        dispenseSpawnEgg(ctx, item)
      else:
        # Default / Drop
        dropItem(ctx, item)
    else:
      args.world.syncWorldEvent(weSoundDispenserFail, args.position, 0)

proc dispenserBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain9:
    let t7 = args.world.getBlockEntity(args.position)
    if t7.isSome:
      let blockEntity = t7.unsafeGet
      let t8 = t7.unsafeGet.getInventory()
      if t8.isSome:
        let inventory = t8.unsafeGet
        some(calculateComparatorOutput(t8.unsafeGet))
        break chain9
    none[uint8]()

proc newDispenserBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = dispenserBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = dispenserBlockOnPlace_BlockBehaviour
  result.placedImpl = dispenserBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = dispenserBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = dispenserBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = dispenserBlockGetComparatorOutput_BlockBehaviour

proc fireArrow*(ctx: DispenseContext, item: ItemStack) =
  # TODO: Add tipped arrows
  let t10 = block:
    if (item.item.id == itemSpectralArrow().id):
      EntityType.SPECTRAL_ARROW
    else:
      EntityType.ARROW
  let entityType = t10
  let _ = item.split(1)
  let facing = toNormal(ctx.facing)
  let position = ctx.position.toCenteredF64().add(((facing * 0.7)))
  let world = ctx.world
  let arrowEntity = newEntity(world, position, entityType)
  var arrow = newArrowEntity(arrowEntity, R2A_NONE)
  arrow.pickup = ArrowPickup.Allowed
  arrow.setVelocity(facing.x, (facing.y + 0.1), facing.z, ARROW_DISPENSE_POWER, ARROW_DISPENSE_UNCERTAINTY)
  let arrowArc: BlockActor = arrow
  world.spawnEntity(arrowArc)
  ctx.world.syncWorldEvent(weSoundDispenserProjectileLaunch, ctx.position, 0)
  ctx.world.syncWorldEvent(weParticlesShootSmoke, ctx.position, toData3d(ctx.facing))

proc targetPosition*(ctx: DispenseContext): BlockPos =
  let facing = toNormal(ctx.facing)
  ctx.position.offset(newVector3(int32(facing.x), int32(facing.y), int32(facing.z)))

proc hasRoomFor*(ctx: DispenseContext, spawnPos: Vector3[float64], size: EntityDimensions): bool =
  let boundingBox = BoundingBox.newFromPos(spawnPos.x, spawnPos.y, spawnPos.z, size)
  (ctx.world.isSpaceEmpty(boundingBox) and isEmpty(ctx.world.getEntitiesAtBox(boundingBox)))

proc dispenseBoat*(ctx: DispenseContext, item: ItemStack): bool =
  let target = targetPosition(ctx)
  let isWater = R2A_MANUAL("closure |id| ((id == Fluid.WATER.id) or (id == Fluid.FLOWING_WATER.id))")
  let t11 = block:
    if isWater(ctx.world.getFluid(target).id):
      target.toF64()
    else:
      if ctx.world.getBlockState(target).isAir() and isWater(ctx.world.getFluid(target.down()).id):
        target.down().toF64()
      else:
        return false
  let spawnPos = t11
  let entityType = BoatItem.itemToEntity(item.item)
  let dimensions = newEntityDimensions(entityType.dimension[0], entityType.dimension[1], entityType.eyeHeight)
  if (not hasRoomFor(ctx, spawnPos, dimensions)):
    return false
  let _ = item.split(1)
  let facing = toNormal(ctx.facing)
  let entity = newEntity(ctx.world, spawnPos, entityType)
  entity.setRotation((float32(facing.x.atan2(facing.z)) * 57.295776), 0.0)
  ctx.world.spawnEntity(newBoatEntity(entity))
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0)
  true

proc dispenseArmorStand*(ctx: DispenseContext, item: ItemStack): bool =
  let target = targetPosition(ctx)
  let spawnPos = target.toF64()
  let dimensions = newEntityDimensions(EntityType.ARMOR_STAND.dimension[0], EntityType.ARMOR_STAND.dimension[1], EntityType.ARMOR_STAND.eyeHeight)
  if (not hasRoomFor(ctx, spawnPos, dimensions)):
    return false
  let _ = item.split(1)
  let facing = toNormal(ctx.facing)
  let entity = newEntity(ctx.world, spawnPos, EntityType.ARMOR_STAND)
  entity.setRotation((float32(facing.x.atan2(facing.z)) * 57.295776), 0.0)
  ctx.world.playSound(sdEntityArmorStandPlace, scBlocks, spawnPos)
  ctx.world.spawnEntity(newArmorStandEntity(entity))
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0)
  true

proc dispenseTnt*(ctx: DispenseContext, item: ItemStack) =
  const TNT_POWER: float32 = 4.0
  const TNT_FUSE: uint32 = 80
  let _ = item.split(1)
  let spawnPos = targetPosition(ctx).toF64()
  let entity = newEntity(ctx.world, spawnPos, EntityType.TNT)
  let tnt = newTNTEntity(entity, TNT_POWER, TNT_FUSE)
  ctx.world.spawnEntity(tnt)
  ctx.world.playSound(sdEntityTntPrimed, scBlocks, spawnPos)
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0)

proc dispenseSpawnEgg*(ctx: DispenseContext, item: ItemStack) =
  let t12 = entityFromEgg(item.item.id)
  if not (t12.isSome):
    return
  let entityType = t12.unsafeGet
  let _ = item.split(1)
  let spawnPos = targetPosition(ctx).toF64()
  let mob = fromType(entityType, spawnPos, ctx.world, Uuid.newV4())
  let yaw = (wrapDegrees((randomOf(float32) * 360.0)) mod 360.0)
  mob.getEntity().setRotation(yaw, 0.0)
  applyEntityVariant(item, mob)
  ctx.world.spawnEntity(mob)
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0)

proc dropItem*(ctx: DispenseContext, item: ItemStack) =
  let dropItem = item.split(1)
  let facing = toNormal(ctx.facing)
  var position = ctx.position.toCenteredF64().add(((facing * 0.7)))
  let t13 = block:
    case ctx.facing
    of Facing.Up, Facing.Down:
      0.125
    else:
      0.15625
  position.y -= t13
  let entity = newEntity(ctx.world, position, EntityType.ITEM)
  let rd = randomOf(float64).mulAdd(0.1, 0.2)
  let velocity = newVector3(triangle(rng(), (facing.x * rd), (0.0172275 * 6.0)), triangle(rng(), 0.2, (0.0172275 * 6.0)), triangle(rng(), (facing.z * rd), (0.0172275 * 6.0)))
  let itemEntity = ItemEntity.newWithVelocity(entity, dropItem, velocity, 40)
  ctx.world.spawnEntity(itemEntity)
  ctx.world.syncWorldEvent(weSoundDispenserDispense, ctx.position, 0)
  ctx.world.syncWorldEvent(weParticlesShootSmoke, ctx.position, toData3d(ctx.facing))

proc registerBlocksRedstoneDispenser*(r: BlockRegistry) =
  r.register("minecraft:dispenser", newDispenserBlock())

