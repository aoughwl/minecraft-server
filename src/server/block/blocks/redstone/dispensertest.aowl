## dispenser.rs over a `TestWorld`: what each kind of stack does when the block fires. Known answers are worked out from the
## Rust: TNT is primed with power 4.0 and fuse 80 at the target block; an arrow is spawned `ArrowPickup::Allowed`; an armor
## stand and a boat face `atan2(facing.x, facing.z) * 57.295_776` degrees (90 for a dispenser facing east); a boat needs water
## at the target (or air over water) and drops as an item otherwise; a spawn egg gets a yaw in [0, 360) and its variant.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio, math]
import ../../blockprelude
import ../../testworld
import ../../../../generated/block_properties
import ../../entities/dispenser
import dispenser

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc at(x, y, z: int32): BlockPos = blockPos(x, y, z)

type Spawned = ref object
  name: string
  pos: Vector3[float64]
  yaw: float32
  fuse: uint32
  power: float32
  pickup: bool
  variants: int

var gSpawned: seq[Spawned] = @[]
var gDropped = 0

proc fire(t: TestWorld; item: Item): bool =
  ## A dispenser at (0, 64, 0) facing east holding one of `item`, fired once. True when the stack was used up.
  let pos = at(0'i32, 64'i32, 0'i32)
  var props = DispenserLikeProperties.defaultFor(blockDispenser())
  props.facing = Facing.East
  t.put(pos, props.toStateId(blockDispenser()))
  let entity = newDispenserBlockEntity(pos)
  t.world.addBlockEntity(entity)
  entity.inv.items[0] = newItemStack(1'u8, item)
  gSpawned = @[]
  gDropped = 0
  t.world.spawnItemWithVelocity0 = proc(position: Vector3[float64]; stack: ItemStack; velocity: Vector3[float64]; pickupDelay: uint8) {.closure.} =
    inc gDropped
  t.world.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    let s = Spawned(name: entityType, pos: position)
    gSpawned.add(s)
    let actor = BlockActor(entityTypeName: entityType)
    actor.setFuse0 = proc(ticks: uint32) {.closure.} = s.fuse = ticks
    actor.setPower0 = proc(power: float32) {.closure.} = s.power = power
    actor.setRotation0 = proc(yaw, pitch: float32) {.closure.} = s.yaw = yaw
    actor.setPickupAllowed0 = proc() {.closure.} = s.pickup = true
    actor.applyVariant0 = proc(item: ItemStack) {.closure.} = inc s.variants
    actor.setVelocity0 = proc(v: Vector3[float64]) {.closure.} = discard
    actor
  let b = t.world.blockRegistry.behaviourOf(blockDispenser().id)
  b.onScheduledTick(OnScheduledTickArgs(world: t.world, block0: blockDispenser(), position: pos))
  entity.inv.items[0].isEmpty()

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksRedstoneDispenser(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc main() =
  let t = newTestWorld(newRegistry())
  check(t.fire(ITEM_TNT), "tnt used")
  check(gSpawned.len == 1 and gSpawned[0].name == "tnt", "a tnt is spawned")
  check(gSpawned[0].power == 4.0'f32 and gSpawned[0].fuse == 80'u32, "power 4 and fuse 80")
  check(gSpawned[0].pos.x == 1.5 and gSpawned[0].pos.y == 64.0 and gSpawned[0].pos.z == 0.5, "at the target block (to_f64 centres x and z)")

  check(t.fire(ITEM_ARROW), "arrow used")
  check(gSpawned.len == 1 and gSpawned[0].name == "arrow" and gSpawned[0].pickup, "an arrow that can be picked up")

  check(t.fire(ITEM_ARMOR_STAND), "armor stand used")
  check(gSpawned.len == 1 and gSpawned[0].name == "armor_stand", "an armor stand")
  check(abs(gSpawned[0].yaw - 90.0'f32) < 0.001'f32, "facing east is 90 degrees")

  # A boat with no water drops
  check(t.fire(ITEM_OAK_BOAT), "boat used")
  check(gSpawned.len == 0 and gDropped == 1, "no water: dropped as an item")
  # Water at the target
  t.put(at(1'i32, 64'i32, 0'i32), blockWater().defaultState.id)
  check(t.fire(ITEM_OAK_BOAT), "boat used on water")
  check(gSpawned.len == 1 and gSpawned[0].name == "oak_boat" and gDropped == 0, "a boat is placed")
  check(gSpawned[0].pos.x == 1.5 and gSpawned[0].pos.y == 64.0, "on the water block")
  check(abs(gSpawned[0].yaw - 90.0'f32) < 0.001'f32, "boat faces east")
  # Air over water: one block down
  t.put(at(1'i32, 64'i32, 0'i32), blockStateIdAir)
  t.put(at(1'i32, 63'i32, 0'i32), blockWater().defaultState.id)
  check(t.fire(ITEM_OAK_BOAT), "boat used over water")
  check(gSpawned.len == 1 and gSpawned[0].pos.y == 63.0, "on the water below")

  # Spawn egg
  check(t.fire(ITEM_PIG_SPAWN_EGG), "egg used")
  check(gSpawned.len == 1 and gSpawned[0].name == "pig" and gSpawned[0].variants == 1, "a pig with its variant applied")
  check(gSpawned[0].yaw >= -180.0'f32 and gSpawned[0].yaw < 180.0'f32, "a wrapped random yaw")
  echo "dispensertest ok"

main()
