proc createScreenHandler*(self: DropperScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler = createGeneric3x3(syncId, playerInventory, self[0])
  let screenHandlerArc = handler
  some(SharedScreenHandler(screenHandlerArc))

proc getDisplayName*(self: DropperScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_DROPPER, CONTAINER_DROPPER, [])

proc triangle*(rng: R, min: float64, max: float64): float64 =
  ((randomOf(float64) - randomOf(float64))).mulAdd(max, min)

proc toNormal*(facing: Facing): Vector3[float64] =
  case facing
  of Facing.North:
    newVector3(0.0, 0.0, (-1.0))
  of Facing.East:
    newVector3(1.0, 0.0, 0.0)
  of Facing.South:
    newVector3(0.0, 0.0, 1.0)
  of Facing.West:
    newVector3((-1.0), 0.0, 0.0)
  of Facing.Up:
    newVector3(0.0, 1.0, 0.0)
  of Facing.Down:
    newVector3(0.0, (-1.0), 0.0)

proc toData3d*(facing: Facing): int32 =
  case facing
  of Facing.North:
    2
  of Facing.East:
    5
  of Facing.South:
    3
  of Facing.West:
    4
  of Facing.Up:
    1
  of Facing.Down:
    0

proc dropperBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain3:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        args.player.openHandledScreen(DropperScreenFactory(t2.unsafeGet), some(args.position))
  barSuccess

proc dropperBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = DispenserLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getEntity().getFacing().opposite()
  props.toStateId(args.block0)

proc dropperBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let dropperBlockEntity = newDropperBlockEntity(args.position)
  args.world.addBlockEntity(dropperBlockEntity)

proc dropperBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = (blockReceivesRedstonePower(args.world, args.position) or blockReceivesRedstonePower(args.world, args.position.up()))
  var props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and (not props.triggered):
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    props.triggered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  else:
    if (not powered) and props.triggered:
      props.triggered = false
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc dropperBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let t4 = args.world.getBlockEntity(args.position)
  if t4.isSome:
    let blockEntity = t4.unsafeGet
    let t5 = asType(t4.unsafeGet, DropperBlockEntity)
    if not (t5.isSome):
      return
    let dropper = t5.unsafeGet
    let t6 = dropper.getRandomSlot()
    if t6.isSome:
      var item = t6.unsafeGet
      let props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
      let targetPos = args.position.offset(props.facing.toBlockDirection().toOffset())
      block chain9:
        let t7 = args.world.getBlockEntity(targetPos)
        if t7.isSome:
          let entity = t7.unsafeGet
          let t8 = t7.unsafeGet.getInventory()
          if t8.isSome:
            let container = t8.unsafeGet
            let backup = item
            let oneItem = item.split(1)
            if addOneItem(dropper, t8.unsafeGet, oneItem):
              return
            item = backup
            return
      # No container found, dispense item into the world
      let dropItem = item.split(1)
      let facing = toNormal(props.facing)
      var position = args.position.toCenteredF64().add(((facing * 0.7)))
      let t10 = block:
        case props.facing
        of Facing.Up, Facing.Down:
          0.125
        else:
          0.15625
      position.y -= t10
      let entity1 = newEntity(args.world, position, EntityType.ITEM)
      let rd = randomOf(float64).mulAdd(0.1, 0.2)
      let velocity = newVector3(triangle(rng(), (facing.x * rd), (0.0172275 * 6.0)), triangle(rng(), 0.2, (0.0172275 * 6.0)), triangle(rng(), (facing.z * rd), (0.0172275 * 6.0)))
      let itemEntity = ItemEntity.newWithVelocity(entity1, dropItem, velocity, 40)
      args.world.spawnEntity(itemEntity)
      args.world.syncWorldEvent(weSoundDispenserDispense, args.position, 0)
      args.world.syncWorldEvent(weParticlesShootSmoke, args.position, toData3d(props.facing))
    else:
      args.world.syncWorldEvent(weSoundDispenserDispense, args.position, 0)

proc dropperBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  block chain13:
    let t11 = args.world.getBlockEntity(args.position)
    if t11.isSome:
      let blockEntity = t11.unsafeGet
      let t12 = t11.unsafeGet.getInventory()
      if t12.isSome:
        let inventory = t12.unsafeGet
        some(calculateComparatorOutput(t12.unsafeGet))
        break chain13
    none[uint8]()

proc newDropperBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = dropperBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = dropperBlockOnPlace_BlockBehaviour
  result.placedImpl = dropperBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = dropperBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = dropperBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = dropperBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksRedstoneDropper*(r: BlockRegistry) =
  r.register("minecraft:dropper", newDropperBlock())

