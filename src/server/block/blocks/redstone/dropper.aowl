## Port of pumpkin/src/block/blocks/redstone/dropper.rs
## The item that leaves a dropper is spawned through `spawnEntity0` with the item entity's saved data (`Item`, `PickupDelay`),
## and its velocity is set after: upstream's `ItemEntity::new_with_velocity` has no `BlockWorld` counterpart.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../../containers
import ../../../../generated/translation
import ../../../../inventory/genericcontainer
import redstonemod
import ../../entities/dropper
import ../../entities/hopper

proc dropperScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `DropperScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_DROPPER, BEDROCK_CONTAINER_DROPPER),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createGeneric3x3(syncId, playerInventory, inventory)))

proc triangle*(min: float64, max: float64): float64 =
  ## `triangle`: `(rng.random::<f64>() - rng.random::<f64>()).mul_add(max, min)`
  (randomOf(float64) - randomOf(float64)) * max + min

proc toNormal*(facing: Facing): Vector3[float64] =
  case facing
  of Facing.North: Vector3[float64](x: 0.0, y: 0.0, z: -1.0)
  of Facing.East: Vector3[float64](x: 1.0, y: 0.0, z: 0.0)
  of Facing.South: Vector3[float64](x: 0.0, y: 0.0, z: 1.0)
  of Facing.West: Vector3[float64](x: -1.0, y: 0.0, z: 0.0)
  of Facing.Up: Vector3[float64](x: 0.0, y: 1.0, z: 0.0)
  of Facing.Down: Vector3[float64](x: 0.0, y: -1.0, z: 0.0)

proc toData3d*(facing: Facing): int32 =
  case facing
  of Facing.North: 2'i32
  of Facing.East: 5'i32
  of Facing.South: 3'i32
  of Facing.West: 4'i32
  of Facing.Up: 1'i32
  of Facing.Down: 0'i32

proc dropperBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  args.player.openHandledScreen(dropperScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc dropperBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = DispenserLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getFacing().opposite()
  props.toStateId(args.block0)

proc dropperBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newDropperBlockEntity(args.position))

proc dropperBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let powered = blockReceivesRedstonePower(args.world, args.position) or
    blockReceivesRedstonePower(args.world, args.position.up())
  var props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  if powered and not props.triggered:
    args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    props.triggered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  elif not powered and props.triggered:
    props.triggered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc dropperBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return
  if not (blockEntity.unsafeGet of DropperBlockEntity):
    return
  let dropper = DropperBlockEntity(blockEntity.unsafeGet)
  let slot = dropper.getRandomSlot()
  if slot < 0:
    args.world.syncWorldEvent(weSoundDispenserDispense, args.position, 0)
    return
  var item = dropper.inv.items[slot]
  let props = DispenserLikeProperties.fromStateId(args.world.getBlockState(args.position).id, args.block0)
  let targetPos = args.position.offset(props.facing.toBlockDirection().toOffset())
  let target = args.world.getBlockEntity(targetPos)
  if target.isSome:
    let container = target.unsafeGet.getInventory()
    if container.isSome:
      let backup = item
      let oneItem = item.split(1)
      dropper.inv.items[slot] = item
      if addOneItem(dropper.invOf(), container.unsafeGet, oneItem):
        return
      dropper.inv.items[slot] = backup
      return
  # No container found, dispense item into the world
  let dropItem = item.split(1)
  dropper.inv.items[slot] = item
  dropper.inv.dirty = true
  let facing = toNormal(props.facing)
  var position = args.position.toCenteredF64()
  position.x += facing.x * 0.7
  position.y += facing.y * 0.7
  position.z += facing.z * 0.7
  position.y -= (if props.facing == Facing.Up or props.facing == Facing.Down: 0.125 else: 0.15625)
  let rd = randomOf(float64) * 0.1 + 0.2
  let velocity = Vector3[float64](x: triangle(facing.x * rd, 0.0172275 * 6.0), y: triangle(0.2, 0.0172275 * 6.0),
    z: triangle(facing.z * rd, 0.0172275 * 6.0))
  var itemNbt = newCompound()
  var stackNbt = newCompound()
  dropItem.writeItemStack(stackNbt)
  itemNbt.putCompound("Item", stackNbt)
  itemNbt.putShort("PickupDelay", 40'i16)
  let spawn = args.world.spawnEntity0
  if spawn != nil:
    let spawned = spawn("minecraft:item", position, some(itemNbt))
    if spawned != nil:
      let setV = spawned.setVelocity0
      if setV != nil:
        setV(velocity)
  args.world.syncWorldEvent(weSoundDispenserDispense, args.position, 0)
  args.world.syncWorldEvent(weParticlesShootSmoke, args.position, toData3d(props.facing))

proc dropperBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return none[uint8]()
  some(calculateComparatorOutput(inventory.unsafeGet))

proc newDropperBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = dropperBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = dropperBlockOnPlace_BlockBehaviour
  result.placedImpl = dropperBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = dropperBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = dropperBlockOnScheduledTick_BlockBehaviour
  result.getComparatorOutputImpl = dropperBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksRedstoneDropper*(r: BlockRegistry) =
  r.register("minecraft:dropper", newDropperBlock())
