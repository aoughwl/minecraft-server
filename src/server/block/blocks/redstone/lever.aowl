## Port of pumpkin/src/block/blocks/redstone/lever.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import ../abstract_wall_mounting


type
  LeverBlock* = object

var gLeverBlockAsWallMountedBlock: nil WallMountedBlock


proc toggleLever*(world: BlockWorld, blockPos: BlockPos)
proc leverBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc leverBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc leverBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc leverBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc leverBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc leverBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc leverBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc leverBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newLeverBlock*(): BlockBehaviour
proc leverBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection
proc leverBlockAsWallMountedBlock*(): WallMountedBlock
proc updateNeighbors*(world: BlockWorld, blockPos: BlockPos, leverProps: LeverLikeProperties)
proc getDirection*(self: LeverLikeProperties): BlockDirection

proc toggleLever*(world: BlockWorld, blockPos: BlockPos) =
  let (blockRef, state) = world.getBlockAndStateId(blockPos)
  var leverProps = LeverLikeProperties.fromStateId(state, blockRef)
  leverProps.powered = (not leverProps.powered)
  discard world.setBlockState(blockPos, leverProps.toStateId(blockRef), BfNotifyAll)
  updateNeighbors(world, blockPos, leverProps)

proc leverBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  toggleLever(args.world, args.position)
  barSuccess

proc leverBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc leverBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let leverProps = LeverLikeProperties.fromStateId(args.state.id, args.block0)
  if leverProps.powered:
    15'u8
  else:
    0'u8

proc leverBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let leverProps = LeverLikeProperties.fromStateId(args.state.id, args.block0)
  if leverProps.powered and (leverProps.getDirection() == args.direction):
    15'u8
  else:
    0'u8

proc leverBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if (not args.moved):
    let leverProps = LeverLikeProperties.fromStateId(args.oldStateId, args.block0)
    if leverProps.powered:
      updateNeighbors(args.world, args.position, leverProps)

proc leverBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = LeverLikeProperties.fromStateId(args.block0.defaultState.id, args.block0)
  (props.face, props.facing) = getPlacementFace(leverBlockAsWallMountedBlock(), args.player, args.direction)
  props.toStateId(args.block0)

proc leverBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  # Use the provided direction, or fallback to the current state's direction if missing
  let t1 = args.direction
  let t2 =
    if t1.isSome: t1.unsafeGet
    else:
      getDirection(leverBlockAsWallMountedBlock(), args.state.id, args.block0)
  let direction = t2
  canPlaceAt(leverBlockAsWallMountedBlock(), args.blockAccessor, args.position, direction)

proc leverBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  getStateForNeighborUpdate(leverBlockAsWallMountedBlock(), args)

proc newLeverBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = leverBlockNormalUse_BlockBehaviour
  result.emitsRedstonePowerImpl = leverBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = leverBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = leverBlockGetStrongRedstonePower_BlockBehaviour
  result.onStateReplacedImpl = leverBlockOnStateReplaced_BlockBehaviour
  result.onPlaceImpl = leverBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = leverBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = leverBlockGetStateForNeighborUpdate_BlockBehaviour

proc leverBlockGetDirection_WallMountedBlock(self: WallMountedBlock, stateId: BlockStateId, blockRef: Block): BlockDirection =
  let props = LeverLikeProperties.fromStateId(stateId, blockRef)
  case props.face
  of AttachFace.Floor:
    BlockDirection.Up
  of AttachFace.Ceiling:
    BlockDirection.Down
  of AttachFace.Wall:
    props.facing.toBlockDirection()

proc leverBlockAsWallMountedBlock*(): WallMountedBlock =
  if gLeverBlockAsWallMountedBlock == nil:
    let v = newWallMountedBlock()
    v.getDirectionImpl = leverBlockGetDirection_WallMountedBlock
    gLeverBlockAsWallMountedBlock = v
  gLeverBlockAsWallMountedBlock

proc updateNeighbors*(world: BlockWorld, blockPos: BlockPos, leverProps: LeverLikeProperties) =
  let direction = leverProps.getDirection().opposite()
  world.updateNeighbors(blockPos, none[BlockDirection]())
  world.updateNeighbors(blockPos.offset(direction.toOffset()), none[BlockDirection]())

proc getDirection*(self: LeverLikeProperties): BlockDirection =
  case self.face
  of AttachFace.Ceiling:
    BlockDirection.Down
  of AttachFace.Floor:
    BlockDirection.Up
  of AttachFace.Wall:
    self.facing.toBlockDirection()

proc registerBlocksRedstoneLever*(r: BlockRegistry) =
  r.register("minecraft:lever", newLeverBlock())

