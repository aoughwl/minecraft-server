## Port of pumpkin/src/block/blocks/redstone/lightning_rod.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  LightningRodBlock* = object



proc trigger*(world: BlockWorld, pos: BlockPos)
proc updateNeighbors*(world: BlockWorld, pos: BlockPos, props: LightningRodLikeProperties)
proc lightningRodBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc lightningRodBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc lightningRodBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc lightningRodBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc lightningRodBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newLightningRodBlock*(): BlockBehaviour

proc trigger*(world: BlockWorld, pos: BlockPos) =
  let (blockRef, stateId) = world.getBlockAndStateId(pos)
  var props = LightningRodLikeProperties.fromStateId(stateId, blockRef)
  if (not props.powered):
    props.powered = true
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyAll)
    updateNeighbors(world, pos, props)
    # In vanilla, it stays powered for 8 ticks (4 redstone ticks) before scheduled tick turns it off.
    world.scheduleBlockTick(blockRef, pos, 8, tpNormal)

proc updateNeighbors*(world: BlockWorld, pos: BlockPos, props: LightningRodLikeProperties) =
  world.updateNeighbors(pos, none[BlockDirection]())
  # The block it is attached to is in the opposite of the facing direction
  let attachedPos = pos.offset(props.facing.opposite().toBlockDirection().toOffset())
  world.updateNeighbors(attachedPos, none[BlockDirection]())

proc lightningRodBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let t1 = block:
    case args.direction
    of BlockDirection.North:
      Facing.North
    of BlockDirection.South:
      Facing.South
    of BlockDirection.East:
      Facing.East
    of BlockDirection.West:
      Facing.West
    of BlockDirection.Up:
      Facing.Up
    of BlockDirection.Down:
      Facing.Down
  let facing = t1
  var props = LightningRodLikeProperties.defaultFor(args.block0)
  props.facing = facing
  props.toStateId(args.block0)

proc lightningRodBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc lightningRodBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = LightningRodLikeProperties.fromStateId(args.state.id, args.block0)
  if props.powered:
    15'u8
  else:
    0'u8

proc lightningRodBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = LightningRodLikeProperties.fromStateId(args.state.id, args.block0)
  # It emits strong power only in its facing direction (the direction pointing outward)
  if props.powered and (props.facing.toBlockDirection() == args.direction):
    15'u8
  else:
    0'u8

proc lightningRodBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  var props = LightningRodLikeProperties.fromStateId(state.id, args.block0)
  if props.powered:
    props.powered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
    updateNeighbors(args.world, args.position, props)

proc newLightningRodBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = lightningRodBlockOnPlace_BlockBehaviour
  result.emitsRedstonePowerImpl = lightningRodBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = lightningRodBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = lightningRodBlockGetStrongRedstonePower_BlockBehaviour
  result.onScheduledTickImpl = lightningRodBlockOnScheduledTick_BlockBehaviour

proc registerBlocksRedstoneLightningRod*(r: BlockRegistry) =
  r.register("minecraft:lightning_rod", newLightningRodBlock())

