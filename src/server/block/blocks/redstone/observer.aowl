## Port of pumpkin/src/block/blocks/redstone/observer.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  ObserverBlock* = object



proc observerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc observerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc observerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc observerBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc observerBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc observerBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc observerBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newObserverBlock*(): BlockBehaviour
proc updateNeighbors*(world: BlockWorld, blockRef: Block, blockPos: BlockPos, props: ObserverLikeProperties)
proc scheduleTick*(world: BlockWorld, blockPos: BlockPos)

proc observerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = ObserverLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getEntity().getFacing()
  props.toStateId(args.block0)

proc observerBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  var props = ObserverLikeProperties.fromStateId(state.id, args.block0)
  if props.powered:
    props.powered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
  else:
    props.powered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
    args.world.scheduleBlockTick(args.block0, args.position, 2, tpNormal)
  updateNeighbors(args.world, args.block0, args.position, props)

proc observerBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let props = ObserverLikeProperties.fromStateId(args.stateId, args.block0)
  if (props.facing.toBlockDirection() == args.direction) and (not props.powered):
    scheduleTick(args.world, args.position)
  args.stateId

proc observerBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  let props = ObserverLikeProperties.fromStateId(args.state.id, args.block0)
  (props.facing.toBlockDirection() == args.direction)

proc observerBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = ObserverLikeProperties.fromStateId(args.state.id, args.block0)
  if (props.facing.toBlockDirection() == args.direction) and props.powered:
    15'u8
  else:
    0'u8

proc observerBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  observerBlockGetWeakRedstonePower_BlockBehaviour(args)

proc observerBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if (not args.moved):
    let props = ObserverLikeProperties.fromStateId(args.oldStateId, args.block0)
    if props.powered and args.world.isBlockTickScheduled(args.position, blockObserver()):
      updateNeighbors(args.world, args.block0, args.position, props)

proc newObserverBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = observerBlockOnPlace_BlockBehaviour
  result.onScheduledTickImpl = observerBlockOnScheduledTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = observerBlockGetStateForNeighborUpdate_BlockBehaviour
  result.emitsRedstonePowerImpl = observerBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = observerBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = observerBlockGetStrongRedstonePower_BlockBehaviour
  result.onStateReplacedImpl = observerBlockOnStateReplaced_BlockBehaviour

proc updateNeighbors*(world: BlockWorld, blockRef: Block, blockPos: BlockPos, props: ObserverLikeProperties) =
  let facing = props.facing
  let oppositeFacingPos = blockPos.offset(facing.toBlockDirection().opposite().toOffset())
  world.updateNeighbor(oppositeFacingPos, blockRef)
  world.updateNeighbors(oppositeFacingPos, some(facing.toBlockDirection()))

proc scheduleTick*(world: BlockWorld, blockPos: BlockPos) =
  world.scheduleBlockTick(blockObserver(), blockPos, 2, tpNormal)

proc registerBlocksRedstoneObserver*(r: BlockRegistry) =
  r.register("minecraft:observer", newObserverBlock())

