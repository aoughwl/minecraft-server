## Port of pumpkin/src/block/blocks/redstone/pressure_plate/plate.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import pressure_platemod


type
  PressurePlateBlock* = object
  PressurePlateProps = StonePressurePlateLikeProperties

var gPressurePlateBlockAsPressurePlate: nil PressurePlate


proc pressurePlateBlockIds*(): seq[BlockId]
proc pressurePlateBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc pressurePlateBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc pressurePlateBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc pressurePlateBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc pressurePlateBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc pressurePlateBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc pressurePlateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc pressurePlateBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newPressurePlateBlock*(): BlockBehaviour
proc pressurePlateBlockGetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8
proc pressurePlateBlockCalculateRedstoneOutput_PressurePlate(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8
proc pressurePlateBlockSetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId
proc pressurePlateBlockAsPressurePlate*(): PressurePlate

proc pressurePlateBlockIds*(): seq[BlockId] =
  result = tagBlockIds(Block_MINECRAFT_WOODEN_PRESSURE_PLATES)
  for id in tagBlockIds(Block_MINECRAFT_STONE_PRESSURE_PLATES):
    result.add(id)

proc pressurePlateBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  onEntityCollisionPp(pressurePlateBlockAsPressurePlate(), args)

proc pressurePlateBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  onScheduledTickPp(pressurePlateBlockAsPressurePlate(), args)

proc pressurePlateBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  onStateReplacedPp(pressurePlateBlockAsPressurePlate(), args)

proc pressurePlateBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  getRedstoneOutput(pressurePlateBlockAsPressurePlate(), args.block0, args.state.id)

proc pressurePlateBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  if (args.direction == BlockDirection.Up):
    return getRedstoneOutput(pressurePlateBlockAsPressurePlate(), args.block0, args.state.id)
  0'u8

proc pressurePlateBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc pressurePlateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if (not canPressurePlatePlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)

proc pressurePlateBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t3 = args.world
  var t4 = false
  if t3.isSome:
    let world = t3.unsafeGet
    t4 = canPressurePlatePlaceAt(world, args.position)
  t4

proc newPressurePlateBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = pressurePlateBlockOnEntityCollision_BlockBehaviour
  result.onScheduledTickImpl = pressurePlateBlockOnScheduledTick_BlockBehaviour
  result.onStateReplacedImpl = pressurePlateBlockOnStateReplaced_BlockBehaviour
  result.getWeakRedstonePowerImpl = pressurePlateBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = pressurePlateBlockGetStrongRedstonePower_BlockBehaviour
  result.emitsRedstonePowerImpl = pressurePlateBlockEmitsRedstonePower_BlockBehaviour
  result.onNeighborUpdateImpl = pressurePlateBlockOnNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = pressurePlateBlockCanPlaceAt_BlockBehaviour

proc pressurePlateBlockGetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8 =
  let props = PressurePlateProps.fromStateId(state, blockRef)
  if props.powered:
    15'u8
  else:
    0'u8

proc pressurePlateBlockCalculateRedstoneOutput_PressurePlate(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8 =
  let aabb = detectionBoxAt(pos)
  if ((not isEmpty(world.getEntitiesAtBox(aabb))) or (not isEmpty(world.getPlayersAtBox(aabb)))):
    return 15
  0'u8

proc pressurePlateBlockSetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId =
  var props = PressurePlateProps.fromStateId(state.id, blockRef)
  props.powered = (output > 0)
  props.toStateId(blockRef)

proc pressurePlateBlockAsPressurePlate*(): PressurePlate =
  if gPressurePlateBlockAsPressurePlate == nil:
    let v = newPressurePlate()
    v.getRedstoneOutputImpl = pressurePlateBlockGetRedstoneOutput_PressurePlate
    v.calculateRedstoneOutputImpl = pressurePlateBlockCalculateRedstoneOutput_PressurePlate
    v.setRedstoneOutputImpl = pressurePlateBlockSetRedstoneOutput_PressurePlate
    gPressurePlateBlockAsPressurePlate = v
  gPressurePlateBlockAsPressurePlate

proc registerBlocksRedstonePressurePlatePlate*(r: BlockRegistry) =
  r.registerIds(pressurePlateBlockIds(), newPressurePlateBlock())

