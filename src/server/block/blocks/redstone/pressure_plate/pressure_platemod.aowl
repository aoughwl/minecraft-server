## Port of pumpkin/src/block/blocks/redstone/pressure_plate/mod.rs
## `BlockRedstoneEvent` is offered to the plugins through `gPluginBlockRedstoneHook` (plugin/pluginhooksevents.aowl), as upstream's `update_plate_state` does.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../../blockprelude
import ../../../../../plugin/pluginhooksevents


type
  PressurePlate* = ref object
    onEntityCollisionPpImpl*: proc(self: PressurePlate, args: OnEntityCollisionArgs) {.closure.}
    onScheduledTickPpImpl*: proc(self: PressurePlate, args: OnScheduledTickArgs) {.closure.}
    onStateReplacedPpImpl*: proc(self: PressurePlate, args: OnStateReplacedArgs) {.closure.}
    updatePlateStateImpl*: proc(self: PressurePlate, world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState, output: uint8) {.closure.}
    getRedstoneOutputImpl*: proc(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8 {.closure.}
    setRedstoneOutputImpl*: proc(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId {.closure.}
    calculateRedstoneOutputImpl*: proc(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8 {.closure.}
    tickRateImpl*: proc(self: PressurePlate): uint8 {.closure.}


let PRESSURE_PLATE_DETECTION_BOX: BoundingBox = BoundingBox.newArray([(1.0 / 16.0), 0.0, (1.0 / 16.0)], [(15.0 / 16.0), (4.0 / 16.0), (15.0 / 16.0)])

proc detectionBoxAt*(pos: BlockPos): BoundingBox
proc onEntityCollisionPp*(self: PressurePlate, args: OnEntityCollisionArgs)
proc defaultOnEntityCollisionPp_PressurePlate(self: PressurePlate, args: OnEntityCollisionArgs)
proc onScheduledTickPp*(self: PressurePlate, args: OnScheduledTickArgs)
proc defaultOnScheduledTickPp_PressurePlate(self: PressurePlate, args: OnScheduledTickArgs)
proc onStateReplacedPp*(self: PressurePlate, args: OnStateReplacedArgs)
proc defaultOnStateReplacedPp_PressurePlate(self: PressurePlate, args: OnStateReplacedArgs)
proc updatePlateState*(self: PressurePlate, world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState, output: uint8)
proc defaultUpdatePlateState_PressurePlate(self: PressurePlate, world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState, output: uint8)
proc canPressurePlatePlaceAt*(world: BlockWorld, blockPos: BlockPos): bool
proc getRedstoneOutput*(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8
proc setRedstoneOutput*(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId
proc calculateRedstoneOutput*(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8
proc tickRate*(self: PressurePlate): uint8
proc defaultTickRate_PressurePlate(self: PressurePlate): uint8
proc newPressurePlate*(): PressurePlate

proc detectionBoxAt*(pos: BlockPos): BoundingBox =
  PRESSURE_PLATE_DETECTION_BOX.atPos(pos)

proc defaultOnEntityCollisionPp_PressurePlate(self: PressurePlate, args: OnEntityCollisionArgs) =
  let output = self.getRedstoneOutput(args.block0, args.state.id)
  if (output == 0):
    self.updatePlateState(args.world, args.position, args.block0, args.state, output)

proc defaultOnScheduledTickPp_PressurePlate(self: PressurePlate, args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  let output = self.getRedstoneOutput(args.block0, state.id)
  if (output > 0):
    self.updatePlateState(args.world, args.position, args.block0, state, output)

proc defaultOnStateReplacedPp_PressurePlate(self: PressurePlate, args: OnStateReplacedArgs) =
  if (not args.moved) and (self.getRedstoneOutput(args.block0, args.oldStateId) > 0):
    args.world.updateNeighbors(args.position, none[BlockDirection]())
    args.world.updateNeighbors(args.position.down(), none[BlockDirection]())

proc defaultUpdatePlateState_PressurePlate(self: PressurePlate, world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState, output: uint8) =
  let calcOutput = self.calculateRedstoneOutput(world, blockRef, pos)
  let hasOutput = (calcOutput > 0)
  if (not (calcOutput == output)):
    # `BlockRedstoneEvent` (plugin/api/events/block/block_redstone.aowl): a cancel leaves the plate as it is, the new current
    # is read back and clamped to 0..15.
    let (redstoneCancelled, newCurrent) = gPluginBlockRedstoneHook(world, state.id, pos, int32(output), int32(calcOutput))
    if redstoneCancelled:
      return
    let nextOutput = uint8(max(0'i32, min(15'i32, newCurrent)))
    let state2 = self.setRedstoneOutput(blockRef, state, nextOutput)
    discard world.setBlockState(pos, state2, BfNotifyListeners)
    world.updateNeighbors(pos, none[BlockDirection]())
    world.updateNeighbors(pos.down(), none[BlockDirection]())
  if hasOutput:
    world.scheduleBlockTick(blockRef, pos, self.tickRate(), tpNormal)

proc canPressurePlatePlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let floor = world.getBlockState(blockPos.down())
  floor.isSideSolid(BlockDirection.Up)

proc defaultTickRate_PressurePlate(self: PressurePlate): uint8 =
  20'u8

proc onEntityCollisionPp*(self: PressurePlate, args: OnEntityCollisionArgs) =
  let f = self.onEntityCollisionPpImpl
  f(self, args)

proc onScheduledTickPp*(self: PressurePlate, args: OnScheduledTickArgs) =
  let f = self.onScheduledTickPpImpl
  f(self, args)

proc onStateReplacedPp*(self: PressurePlate, args: OnStateReplacedArgs) =
  let f = self.onStateReplacedPpImpl
  f(self, args)

proc updatePlateState*(self: PressurePlate, world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState, output: uint8) =
  let f = self.updatePlateStateImpl
  f(self, world, pos, blockRef, state, output)

proc getRedstoneOutput*(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8 =
  let f = self.getRedstoneOutputImpl
  f(self, blockRef, state)

proc setRedstoneOutput*(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId =
  let f = self.setRedstoneOutputImpl
  f(self, blockRef, state, output)

proc calculateRedstoneOutput*(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8 =
  let f = self.calculateRedstoneOutputImpl
  f(self, world, blockRef, pos)

proc tickRate*(self: PressurePlate): uint8 =
  let f = self.tickRateImpl
  f(self)

proc newPressurePlate*(): PressurePlate =
  result = PressurePlate()
  result.onEntityCollisionPpImpl = defaultOnEntityCollisionPp_PressurePlate
  result.onScheduledTickPpImpl = defaultOnScheduledTickPp_PressurePlate
  result.onStateReplacedPpImpl = defaultOnStateReplacedPp_PressurePlate
  result.updatePlateStateImpl = defaultUpdatePlateState_PressurePlate
  result.tickRateImpl = defaultTickRate_PressurePlate

