## Port of pumpkin/src/block/blocks/redstone/pressure_plate/tests.rs

import std/assertions
import ../../../blockprelude
import pressure_platemod

proc box(a, b: array[3, float64]): BoundingBox = BoundingBox.newArray(a, b)

# detection_box_is_offset_to_block_position
block:
  let boundingBox = detectionBoxAt(blockPos(10'i32, 64'i32, -5'i32))
  doAssert boundingBox.min == Vector3[float64](x: 10.0625, y: 64.0, z: -4.9375)
  doAssert boundingBox.max == Vector3[float64](x: 10.9375, y: 64.25, z: -4.0625)

# entity_at_plate_center_intersects_detection_box
block:
  let detectionBox = detectionBoxAt(blockPos(0'i32, 0'i32, 0'i32))
  doAssert detectionBox.intersects(box([0.4, 0.0, 0.4], [0.6, 1.8, 0.6]))

# entity_outside_horizontal_bounds_does_not_intersect_detection_box
block:
  let detectionBox = detectionBoxAt(blockPos(0'i32, 0'i32, 0'i32))
  doAssert not detectionBox.intersects(box([0.95, 0.0, 0.4], [1.0, 0.2, 0.6]))

# entity_above_detection_height_does_not_intersect_detection_box
block:
  let detectionBox = detectionBoxAt(blockPos(0'i32, 0'i32, 0'i32))
  doAssert not detectionBox.intersects(box([0.4, 0.3, 0.4], [0.6, 0.6, 0.6]))

# entity_partially_overlapping_detection_box_intersects
block:
  let detectionBox = detectionBoxAt(blockPos(0'i32, 0'i32, 0'i32))
  doAssert detectionBox.intersects(box([0.9, 0.2, 0.4], [0.95, 0.3, 0.6]))

# entity_touching_detection_box_boundary_does_not_intersect
block:
  let detectionBox = detectionBoxAt(blockPos(0'i32, 0'i32, 0'i32))
  doAssert not detectionBox.intersects(box([0.9375, 0.0, 0.4], [1.0, 0.2, 0.6]))
