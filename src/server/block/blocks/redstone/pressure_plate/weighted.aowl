import ../../../blockprelude
import pressure_platemod


type
  WeightedPressurePlateBlock* = object
  PressurePlateProps = LightWeightedPressurePlateLikeProperties

var gWeightedPressurePlateBlockAsPressurePlate: nil PressurePlate


proc weightedPressurePlateBlockIds*(): seq[BlockId]
proc weightedPressurePlateBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc weightedPressurePlateBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc weightedPressurePlateBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc weightedPressurePlateBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc weightedPressurePlateBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc weightedPressurePlateBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc weightedPressurePlateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc weightedPressurePlateBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newWeightedPressurePlateBlock*(): BlockBehaviour
proc weightedPressurePlateBlockGetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8
proc weightedPressurePlateBlockCalculateRedstoneOutput_PressurePlate(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8
proc weightedPressurePlateBlockSetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId
proc weightedPressurePlateBlockTickRate_PressurePlate(self: PressurePlate): uint8
proc weightedPressurePlateBlockAsPressurePlate*(): PressurePlate

proc weightedPressurePlateBlockIds*(): seq[BlockId] =
  # light = Gold
  # heavy = Iron
  @[blockIdLightWeightedPressurePlate, blockIdHeavyWeightedPressurePlate]

proc weightedPressurePlateBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  onEntityCollisionPp(weightedPressurePlateBlockAsPressurePlate(), args)

proc weightedPressurePlateBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  onScheduledTickPp(weightedPressurePlateBlockAsPressurePlate(), args)

proc weightedPressurePlateBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  onStateReplacedPp(weightedPressurePlateBlockAsPressurePlate(), args)

proc weightedPressurePlateBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  getRedstoneOutput(weightedPressurePlateBlockAsPressurePlate(), args.block0, args.state.id)

proc weightedPressurePlateBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  if (args.direction == BlockDirection.Up):
    return getRedstoneOutput(weightedPressurePlateBlockAsPressurePlate(), args.block0, args.state.id)
  0'u8

proc weightedPressurePlateBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc weightedPressurePlateBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if (not canPressurePlatePlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)

proc weightedPressurePlateBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let t1 = args.world
  var t2 = false
  if t1.isSome:
    let world = t1.unsafeGet
    t2 = canPressurePlatePlaceAt(world, args.position)
  t2

proc newWeightedPressurePlateBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = weightedPressurePlateBlockOnEntityCollision_BlockBehaviour
  result.onScheduledTickImpl = weightedPressurePlateBlockOnScheduledTick_BlockBehaviour
  result.onStateReplacedImpl = weightedPressurePlateBlockOnStateReplaced_BlockBehaviour
  result.getWeakRedstonePowerImpl = weightedPressurePlateBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = weightedPressurePlateBlockGetStrongRedstonePower_BlockBehaviour
  result.emitsRedstonePowerImpl = weightedPressurePlateBlockEmitsRedstonePower_BlockBehaviour
  result.onNeighborUpdateImpl = weightedPressurePlateBlockOnNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = weightedPressurePlateBlockCanPlaceAt_BlockBehaviour

proc weightedPressurePlateBlockGetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockStateId): uint8 =
  let props = PressurePlateProps.fromStateId(state, blockRef)
  props.power

proc weightedPressurePlateBlockCalculateRedstoneOutput_PressurePlate(self: PressurePlate, world: BlockWorld, blockRef: Block, pos: BlockPos): uint8 =
  # light = Gold
  # heavy = Iron
  let t3 = block:
    if (blockRef == blockLightWeightedPressurePlate()):
      # Gold
      15'u8
    else:
      # Iron
      150'u8
  let weight = t3
  let aabb = detectionBoxAt(pos)
  let len0 = (len(world.getEntitiesAtBox(aabb)) + len(world.getPlayersAtBox(aabb)))
  let len01 = min(len0, int(weight))
  if (len01 > 0):
    let f = float32(((min(int(weight), len01) div int(weight))))
    return uint8(ceil(((f * 15.0))))
  0'u8

proc weightedPressurePlateBlockSetRedstoneOutput_PressurePlate(self: PressurePlate, blockRef: Block, state: BlockState, output: uint8): BlockStateId =
  var props = PressurePlateProps.fromStateId(state.id, blockRef)
  props.power = output
  props.toStateId(blockRef)

proc weightedPressurePlateBlockTickRate_PressurePlate(self: PressurePlate): uint8 =
  10'u8

proc weightedPressurePlateBlockAsPressurePlate*(): PressurePlate =
  if gWeightedPressurePlateBlockAsPressurePlate == nil:
    let v = newPressurePlate()
    v.getRedstoneOutputImpl = weightedPressurePlateBlockGetRedstoneOutput_PressurePlate
    v.calculateRedstoneOutputImpl = weightedPressurePlateBlockCalculateRedstoneOutput_PressurePlate
    v.setRedstoneOutputImpl = weightedPressurePlateBlockSetRedstoneOutput_PressurePlate
    v.tickRateImpl = weightedPressurePlateBlockTickRate_PressurePlate
    gWeightedPressurePlateBlockAsPressurePlate = v
  gWeightedPressurePlateBlockAsPressurePlate

proc registerBlocksRedstonePressurePlateWeighted*(r: BlockRegistry) =
  r.registerIds(weightedPressurePlateBlockIds(), newWeightedPressurePlateBlock())

