import ../../../blockprelude
import railsmod




proc railPlacementIsValid*(world: BlockWorld, blockRef: Block, pos: BlockPos): bool
proc canPlaceRailAt*(world: BlockWorld, pos: BlockPos): bool
proc computePlacedRailShape*(world: BlockWorld, blockPos: BlockPos, playerFacing: HorizontalFacing): RailShapeStraight
proc updateFlankingRailsShape*(world: BlockWorld, blockRef: Block, stateId: BlockStateId, blockPos: BlockPos)
proc computeFlankingRailNewShape*(world: BlockWorld, rail: Rail, flankingFrom: HorizontalFacing): RailShape

proc railPlacementIsValid*(world: BlockWorld, blockRef: Block, pos: BlockPos): bool =
  if (not canPlaceRailAt(world, pos)):
    return false
  let stateId = world.getBlockStateId(pos)
  let railProps = newRailProperties(stateId, blockRef)
  let t1 = block:
    case railProps.shape()
    of RailShape.AscendingNorth:
      some(HorizontalFacing.North)
    of RailShape.AscendingSouth:
      some(HorizontalFacing.South)
    of RailShape.AscendingEast:
      some(HorizontalFacing.East)
    of RailShape.AscendingWest:
      some(HorizontalFacing.West)
    else:
      none[HorizontalFacing]()
  let railLeaningDirection = t1
  let t2 = railLeaningDirection
  if t2.isSome and (not canPlaceRailAt(world, pos.offset(t2.unsafeGet.toOffset()).up())):
    let direction = t2.unsafeGet
    return false
  true

proc canPlaceRailAt*(world: BlockWorld, pos: BlockPos): bool =
  let state = world.getBlockState(pos.down())
  state.isSideSolid(BlockDirection.Up)

proc computePlacedRailShape*(world: BlockWorld, blockPos: BlockPos, playerFacing: HorizontalFacing): RailShapeStraight =
  # Use the same sophisticated logic as normal rails, but adapted for straight rails
  # Check each direction for rail connections, similar to normal rail placement
  # Check East first
  let t3 = findIfUnlocked(world, blockPos, HorizontalFacing.East)
  if t3.isSome:
    let eastRail = t3.unsafeGet
    # Check for opposite connection (West) to form a straight line
    let t4 = findIfUnlocked(world, blockPos, HorizontalFacing.West)
    if t4.isSome:
      let westRail = t4.unsafeGet
      # We have connections in both East and West
      if (t3.unsafeGet.elevation == RailElevation.Up):
        return RailShapeStraight.AscendingEast
      elif (t4.unsafeGet.elevation == RailElevation.Up):
        return RailShapeStraight.AscendingWest
      return RailShapeStraight.EastWest
    # Only East connection
    if (t3.unsafeGet.elevation == RailElevation.Up):
      return RailShapeStraight.AscendingEast
    return RailShapeStraight.EastWest
  # Check South
  let t5 = findIfUnlocked(world, blockPos, HorizontalFacing.South)
  if t5.isSome:
    let southRail = t5.unsafeGet
    # Check for opposite connection (North) to form a straight line
    let t6 = findIfUnlocked(world, blockPos, HorizontalFacing.North)
    if t6.isSome:
      let northRail = t6.unsafeGet
      # We have connections in both South and North
      if (t5.unsafeGet.elevation == RailElevation.Up):
        return RailShapeStraight.AscendingSouth
      elif (t6.unsafeGet.elevation == RailElevation.Up):
        return RailShapeStraight.AscendingNorth
      return RailShapeStraight.NorthSouth
    # Only South connection
    if (t5.unsafeGet.elevation == RailElevation.Up):
      return RailShapeStraight.AscendingSouth
    return RailShapeStraight.NorthSouth
  # Check West
  let t7 = findIfUnlocked(world, blockPos, HorizontalFacing.West)
  if t7.isSome:
    let westRail = t7.unsafeGet
    if (t7.unsafeGet.elevation == RailElevation.Up):
      return RailShapeStraight.AscendingWest
    return RailShapeStraight.EastWest
  # Check North
  let t8 = findIfUnlocked(world, blockPos, HorizontalFacing.North)
  if t8.isSome:
    let northRail = t8.unsafeGet
    if (t8.unsafeGet.elevation == RailElevation.Up):
      return RailShapeStraight.AscendingNorth
    return RailShapeStraight.NorthSouth
  # No connections found, use player facing direction
  playerFacing.toRailShapeFlat()

proc updateFlankingRailsShape*(world: BlockWorld, blockRef: Block, stateId: BlockStateId, blockPos: BlockPos) =
  let t9 = newRailProperties(stateId, blockRef).directions()
  for direction in t9:
    let t10 = findWithElevation(world, blockPos.offset(direction.toOffset()))
    if not (t10.isSome):
      # Skip non-rail blocks
      continue
    let flankingRail = t10.unsafeGet
    let newShape = computeFlankingRailNewShape(world, flankingRail, direction.opposite())
    if (newShape != flankingRail.properties.shape()):
      flankingRail.properties.setShape(newShape)
      discard world.setBlockState(flankingRail.position, flankingRail.properties.toStateId(flankingRail.block0), BfNotifyAll)

proc computeFlankingRailNewShape*(world: BlockWorld, rail: Rail, flankingFrom: HorizontalFacing): RailShape =
  var connectedTowards: seq[HorizontalFacing] = @[]
  var isAlreadyConnectedToElevatedRail = false
  let t11 = rail.properties.directions()
  for neighborDirection in t11:
    if (neighborDirection == flankingFrom):
      # Rails pointing to where the player placed are not connected
      continue
    let t12 = findWithElevation(world, rail.position.offset(neighborDirection.toOffset()))
    if not (t12.isSome):
      # Rails pointing to non-rail blocks are not connected
      continue
    let maybeConnectedRail = t12.unsafeGet
    var t14 = false
    for d in maybeConnectedRail.properties.directions():
      if (d == neighborDirection.opposite()):
        t14 = true
        break
    if t14:
      # Rails pointing to other rails that are pointing back are connected
      connectedTowards.add(neighborDirection)
      isAlreadyConnectedToElevatedRail = (maybeConnectedRail.elevation == RailElevation.Up)
  let t15 = block:
    case len(connectedTowards)
    of 2:
      # Do not update rails that are locked (aka fully connected)
      return rail.properties.shape()
    of 1:
      [connectedTowards[0], flankingFrom]
    of 0:
      [flankingFrom, flankingFrom.opposite()]
    else:
      discard
      return rail.properties.shape()
  let newNeighborDirections = t15
  # Handle rails that want to be straight
  var t17 = true
  for d in newNeighborDirections:
    if not (((d == flankingFrom) or (d == flankingFrom.opposite()))):
      t17 = false
      break
  if t17:
    if (rail.elevation == RailElevation.Down):
      if isAlreadyConnectedToElevatedRail:
        # Prioritize the South/West ascending
        let t18 = block:
          case flankingFrom
          of HorizontalFacing.South, HorizontalFacing.North:
            RailShape.AscendingSouth
          of HorizontalFacing.West, HorizontalFacing.East:
            RailShape.AscendingWest
        return t18
      return flankingFrom.toRailShapeAscendingTowards().asShape()
    elif isAlreadyConnectedToElevatedRail:
      return connectedTowards[0].toRailShapeAscendingTowards().asShape()
    # Reset the shape to flat even if the rail already had good directions
    return rail.getNewRailShape(newNeighborDirections[0], newNeighborDirections[1])
  # Handle straight rails that want to curve
  if (not rail.properties.canCurve()):
    let t19 = block:
      if ((newNeighborDirections[0] == HorizontalFacing.North) or (newNeighborDirections[0] == HorizontalFacing.South)):
        if (rail.elevation == RailElevation.Down):
          # The rail is down so it should be ascending
          flankingFrom.toRailShapeAscendingTowards().asShape()
        else:
          rail.getNewRailShape(newNeighborDirections[0], newNeighborDirections[1])
      else:
        rail.properties.shape()
    return t19
  rail.getNewRailShape(newNeighborDirections[0], newNeighborDirections[1])

