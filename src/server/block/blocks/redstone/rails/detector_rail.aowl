import ../../../blockprelude
import railsmod
import common


type
  DetectorRailBlock* = object



proc detectorRailBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc detectorRailBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc detectorRailBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc detectorRailBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newDetectorRailBlock*(): BlockBehaviour

proc detectorRailBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var railProps = RailProperties.defaultFor(args.block0)
  let playerFacing = args.player.getEntity().getHorizontalFacing()
  railProps.setWaterlogged(args.replacing.waterSource())
  railProps.setStraightShape(computePlacedRailShape(args.world, args.position, playerFacing))
  railProps.toStateId(args.block0)

proc detectorRailBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  updateFlankingRailsShape(args.world, args.block0, args.stateId, args.position)

proc detectorRailBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if (not railPlacementIsValid(args.world, args.block0, args.position)):
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)

proc detectorRailBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceRailAt(args.blockAccessor, args.position)

proc newDetectorRailBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = detectorRailBlockOnPlace_BlockBehaviour
  result.placedImpl = detectorRailBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = detectorRailBlockOnNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = detectorRailBlockCanPlaceAt_BlockBehaviour

proc registerBlocksRedstoneRailsDetectorRail*(r: BlockRegistry) =
  r.register("minecraft:detector_rail", newDetectorRailBlock())

