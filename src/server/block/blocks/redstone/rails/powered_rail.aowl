proc poweredRailBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var railProps = RailProperties.defaultFor(args.block0)
  let playerFacing = args.player.getEntity().getHorizontalFacing()
  railProps.setWaterlogged(args.replacing.waterSource())
  railProps.setStraightShape(computePlacedRailShape(args.world, args.position, playerFacing))
  railProps.toStateId(args.block0)

proc poweredRailBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let self = PoweredRailBlock()
  updateFlankingRailsShape(args.world, args.block0, args.stateId, args.position)
  self.updatePoweredState(args.world, args.block0, args.position)
  let finalStateId = args.world.getBlockStateId(args.position)
  let railProps = newRailProperties(finalStateId, args.block0)
  self.updateConnectedRails(args.world, args.position, railProps, true, 0)
  self.updateConnectedRails(args.world, args.position, railProps, false, 0)
  let t1 = railProps.directions()
  for direction in t1:
    let neighborPos = args.position.offset(direction.toOffset())
    let t2 = findRailAtPosition(args.world, neighborPos)
    if t2.isSome:
      let neighborRail = t2.unsafeGet
      self.updatePoweredStateInternal(args.world, t2.unsafeGet[0], neighborPos, false)
      self.updateConnectedRails(args.world, neighborPos, t2.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, neighborPos, t2.unsafeGet[1], false, 0)
    let upPos = neighborPos.up()
    let t3 = findRailAtPosition(args.world, upPos)
    if t3.isSome:
      let neighborRail = t3.unsafeGet
      self.updatePoweredStateInternal(args.world, t3.unsafeGet[0], upPos, false)
      self.updateConnectedRails(args.world, upPos, t3.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, upPos, t3.unsafeGet[1], false, 0)
    let downPos = neighborPos.down()
    let t4 = findRailAtPosition(args.world, downPos)
    if t4.isSome:
      let neighborRail = t4.unsafeGet
      self.updatePoweredStateInternal(args.world, t4.unsafeGet[0], downPos, false)
      self.updateConnectedRails(args.world, downPos, t4.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, downPos, t4.unsafeGet[1], false, 0)

proc poweredRailBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let self = PoweredRailBlock()
  if (not railPlacementIsValid(args.world, args.block0, args.position)):
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)
    return
  self.updatePoweredState(args.world, args.block0, args.position)
  let stateId = args.world.getBlockStateId(args.position)
  let railProps = newRailProperties(stateId, args.block0)
  self.updateConnectedRails(args.world, args.position, railProps, true, 0)
  self.updateConnectedRails(args.world, args.position, railProps, false, 0)

proc poweredRailBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  let self = PoweredRailBlock()
  let stateId = args.oldStateId
  let railProps = newRailProperties(stateId, args.block0)
  if railProps.shape().isAscending():
    args.world.updateNeighbor(args.position.up(), args.block0)
  args.world.updateNeighbor(args.position, args.block0)
  args.world.updateNeighbor(args.position.down(), args.block0)
  let directions = railProps.directions()
  for direction in directions:
    let neighborPos = args.position.offset(direction.toOffset())
    let t5 = findRailAtPosition(args.world, neighborPos)
    if t5.isSome:
      let neighborRail = t5.unsafeGet
      self.updatePoweredState(args.world, t5.unsafeGet[0], neighborPos)
      self.updateConnectedRails(args.world, neighborPos, t5.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, neighborPos, t5.unsafeGet[1], false, 0)
    let upPos = neighborPos.up()
    let t6 = findRailAtPosition(args.world, upPos)
    if t6.isSome:
      let neighborRail = t6.unsafeGet
      self.updatePoweredState(args.world, t6.unsafeGet[0], upPos)
      self.updateConnectedRails(args.world, upPos, t6.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, upPos, t6.unsafeGet[1], false, 0)
    let downPos = neighborPos.down()
    let t7 = findRailAtPosition(args.world, downPos)
    if t7.isSome:
      let neighborRail = t7.unsafeGet
      self.updatePoweredState(args.world, t7.unsafeGet[0], downPos)
      self.updateConnectedRails(args.world, downPos, t7.unsafeGet[1], true, 0)
      self.updateConnectedRails(args.world, downPos, t7.unsafeGet[1], false, 0)

proc poweredRailBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceRailAt(args.blockAccessor, args.position)

proc newPoweredRailBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = poweredRailBlockOnPlace_BlockBehaviour
  result.placedImpl = poweredRailBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = poweredRailBlockOnNeighborUpdate_BlockBehaviour
  result.onStateReplacedImpl = poweredRailBlockOnStateReplaced_BlockBehaviour
  result.canPlaceAtImpl = poweredRailBlockCanPlaceAt_BlockBehaviour

proc isPoweredByOtherRails*(self: PoweredRailBlock, world: BlockWorld, pos: BlockPos, state: RailProperties, direction: bool, distance: uint8): bool =
  if (distance >= 8):
    return false
  var x = pos.vec.x
  var y = pos.vec.y
  var z = pos.vec.z
  var checkDown = true
  var nextShape = state.shape()
  case nextShape
  of RailShape.NorthSouth:
    if direction:
      z += 1
    else:
      z -= 1
  of RailShape.EastWest:
    if direction:
      x -= 1
    else:
      x += 1
  of RailShape.AscendingEast:
    if direction:
      x -= 1
    else:
      x += 1
      y += 1
      checkDown = false
    nextShape = RailShape.EastWest
  of RailShape.AscendingWest:
    if direction:
      x -= 1
      y += 1
      checkDown = false
    else:
      x += 1
    nextShape = RailShape.EastWest
  of RailShape.AscendingNorth:
    if direction:
      z += 1
    else:
      z -= 1
      y += 1
      checkDown = false
    nextShape = RailShape.NorthSouth
  of RailShape.AscendingSouth:
    if direction:
      z += 1
      y += 1
      checkDown = false
    else:
      z -= 1
    nextShape = RailShape.NorthSouth
  else:
    return false
  let nextPos = newBlockPos(x, y, z)
  if self.isPoweredByOtherRailsAt(world, nextPos, direction, distance, nextShape):
    return true
  if checkDown:
    let downPos = newBlockPos(x, (y - 1), z)
    if self.isPoweredByOtherRailsAt(world, downPos, direction, distance, nextShape):
      return true
  false

proc isPoweredByOtherRailsAt*(self: PoweredRailBlock, world: BlockWorld, pos: BlockPos, direction: bool, distance: uint8, expectedShape: RailShape): bool =
  let blockRef = world.getBlock(pos)
  if (blockRef != blockPoweredRail()):
    return false
  let stateId = world.getBlockStateId(pos)
  let railProps = newRailProperties(stateId, blockRef)
  let railShape = railProps.shape()
  case expectedShape
  of RailShape.EastWest:
    if ((railShape == RailShape.NorthSouth or railShape == RailShape.AscendingNorth or railShape == RailShape.AscendingSouth)):
      return false
  of RailShape.NorthSouth:
    if ((railShape == RailShape.EastWest or railShape == RailShape.AscendingEast or railShape == RailShape.AscendingWest)):
      return false
  else:
    discard
  if (not railProps.isPowered()):
    return false
  if blockReceivesRedstonePower(world, pos):
    return true
  self.isPoweredByOtherRails(world, pos, railProps, direction, (distance + 1))

proc updatePoweredState*(self: PoweredRailBlock, world: BlockWorld, blockRef: Block, pos: BlockPos) =
  self.updatePoweredStateInternal(world, blockRef, pos, true)

proc updatePoweredStateInternal*(self: PoweredRailBlock, world: BlockWorld, blockRef: Block, pos: BlockPos, propagate: bool) =
  let stateId = world.getBlockStateId(pos)
  var railProps = newRailProperties(stateId, blockRef)
  let currentPowered = railProps.isPowered()
  let directPower = blockReceivesRedstonePower(world, pos)
  let railPower = (self.isPoweredByOtherRails(world, pos, railProps, true, 0) or self.isPoweredByOtherRails(world, pos, railProps, false, 0))
  let shouldBePowered = (directPower or railPower)
  if (currentPowered != shouldBePowered):
    railProps.setPowered(shouldBePowered)
    discard world.setBlockState(pos, railProps.toStateId(blockRef), BfNotifyAll)
    world.updateNeighbor(pos.down(), blockRef)
    if railProps.shape().isAscending():
      world.updateNeighbor(pos.up(), blockRef)
    if propagate:
      let updatedRailProps = newRailProperties(railProps.toStateId(blockRef), blockRef)
      self.updateConnectedRails(world, pos, updatedRailProps, true, 0)
      self.updateConnectedRails(world, pos, updatedRailProps, false, 0)

proc updateConnectedRails*(self: PoweredRailBlock, world: BlockWorld, pos: BlockPos, state: RailProperties, direction: bool, distance: uint8) =
  if (distance >= 8):
    return
  var x = pos.vec.x
  var y = pos.vec.y
  var z = pos.vec.z
  var checkDown = true
  var nextShape = state.shape()
  case nextShape
  of RailShape.NorthSouth:
    if direction:
      z += 1
    else:
      z -= 1
  of RailShape.EastWest:
    if direction:
      x -= 1
    else:
      x += 1
  of RailShape.AscendingEast:
    if direction:
      x -= 1
    else:
      x += 1
      y += 1
      checkDown = false
    nextShape = RailShape.EastWest
  of RailShape.AscendingWest:
    if direction:
      x -= 1
      y += 1
      checkDown = false
    else:
      x += 1
    nextShape = RailShape.EastWest
  of RailShape.AscendingNorth:
    if direction:
      z += 1
    else:
      z -= 1
      y += 1
      checkDown = false
    nextShape = RailShape.NorthSouth
  of RailShape.AscendingSouth:
    if direction:
      z += 1
      y += 1
      checkDown = false
    else:
      z -= 1
    nextShape = RailShape.NorthSouth
  else:
    return
  let nextPos = newBlockPos(x, y, z)
  self.updateRailAtPosition(world, nextPos, direction, distance, nextShape)
  if checkDown:
    let downPos = newBlockPos(x, (y - 1), z)
    self.updateRailAtPosition(world, downPos, direction, distance, nextShape)

proc updateRailAtPosition*(self: PoweredRailBlock, world: BlockWorld, pos: BlockPos, direction: bool, distance: uint8, expectedShape: RailShape) =
  let blockRef = world.getBlock(pos)
  if (blockRef != blockPoweredRail()):
    return
  let stateId = world.getBlockStateId(pos)
  let railProps = newRailProperties(stateId, blockRef)
  let railShape = railProps.shape()
  let t8 = block:
    case expectedShape
    of RailShape.EastWest:
      (not ((railShape == RailShape.NorthSouth or railShape == RailShape.AscendingNorth or railShape == RailShape.AscendingSouth)))
    of RailShape.NorthSouth:
      (not ((railShape == RailShape.EastWest or railShape == RailShape.AscendingEast or railShape == RailShape.AscendingWest)))
    else:
      true
  let shapesCompatible = t8
  if shapesCompatible:
    self.updatePoweredStateInternal(world, blockRef, pos, false)
    self.updateConnectedRails(world, pos, railProps, direction, (distance + 1))

proc findRailAtPosition*(world: BlockWorld, pos: BlockPos): Option[(Block, RailProperties)] =
  let blockRef = world.getBlock(pos)
  var t11 = none[(Block, RailProperties)]()
  if ((blockRef == blockPoweredRail())):
    let t9 = block:
      let stateId = world.getBlockStateId(pos)
      let railProps = newRailProperties(stateId, blockRef)
      (blockRef, railProps)
    t11 = some(t9)
  t11

proc registerBlocksRedstoneRailsPoweredRail*(r: BlockRegistry) =
  r.register("minecraft:powered_rail", newPoweredRailBlock())

