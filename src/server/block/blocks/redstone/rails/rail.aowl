import ../../../blockprelude
import common
import railsmod


type
  RailBlock* = object



proc railBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc railBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc railBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc railBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc newRailBlock*(): BlockBehaviour

proc railBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let world = args.world
  let blockPos = args.position
  var railProps = RailProperties.defaultFor(args.block0)
  railProps.setWaterlogged(args.replacing.waterSource())
  let t1 = block:
    let t2 = findIfUnlocked(world, blockPos, HorizontalFacing.East)
    if t2.isSome:
      let eastRail = t2.unsafeGet
      if findIfUnlocked(world, blockPos, HorizontalFacing.South).isSome():
        RailShape.SouthEast
      elif findIfUnlocked(world, blockPos, HorizontalFacing.North).isSome():
        RailShape.NorthEast
      else:
        let t3 = findIfUnlocked(world, blockPos, HorizontalFacing.West)
        if t3.isSome and (westRail.elevation == RailElevation.Up):
          let westRail = t3.unsafeGet
          RailShape.AscendingWest
        else:
          if (t2.unsafeGet.elevation == RailElevation.Up):
            RailShape.AscendingEast
          else:
            RailShape.EastWest
    else:
      let t5 = findIfUnlocked(world, blockPos, HorizontalFacing.South)
      if t5.isSome:
        let southRail = t5.unsafeGet
        if findIfUnlocked(world, blockPos, HorizontalFacing.West).isSome():
          RailShape.SouthWest
        elif (t5.unsafeGet.elevation == RailElevation.Up):
          RailShape.AscendingSouth
        else:
          let t6 = findIfUnlocked(world, blockPos, HorizontalFacing.North)
          if t6.isSome and (northRail.elevation == RailElevation.Up):
            let northRail = t6.unsafeGet
            RailShape.AscendingNorth
          else:
            RailShape.NorthSouth
      else:
        let t8 = findIfUnlocked(world, blockPos, HorizontalFacing.West)
        if t8.isSome:
          let westRail = t8.unsafeGet
          if findIfUnlocked(world, blockPos, HorizontalFacing.North).isSome():
            RailShape.NorthWest
          elif (t8.unsafeGet.elevation == RailElevation.Up):
            RailShape.AscendingWest
          else:
            RailShape.EastWest
        else:
          let t10 = findIfUnlocked(world, blockPos, HorizontalFacing.North)
          if t10.isSome:
            let northRail = t10.unsafeGet
            if (t10.unsafeGet.elevation == RailElevation.Up):
              RailShape.AscendingNorth
            else:
              RailShape.NorthSouth
          else:
            args.player.livingEntity.entity.getHorizontalFacing().toRailShapeFlat().asShape()
  let shape = t1
  railProps.setShape(shape)
  railProps.toStateId(args.block0)

proc railBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  updateFlankingRailsShape(args.world, args.block0, args.stateId, args.position)

proc railBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if (not railPlacementIsValid(args.world, args.block0, args.position)):
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)

proc railBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceRailAt(args.blockAccessor, args.position)

proc newRailBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = railBlockOnPlace_BlockBehaviour
  result.placedImpl = railBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = railBlockOnNeighborUpdate_BlockBehaviour
  result.canPlaceAtImpl = railBlockCanPlaceAt_BlockBehaviour

proc registerBlocksRedstoneRailsRail*(r: BlockRegistry) =
  r.register("minecraft:rail", newRailBlock())

