import ../../../blockprelude


type
  Rail* = ref object
    block0*: Block
    position*: BlockPos
    properties*: RailProperties
    elevation*: RailElevation
  RailPropertiesKind* {.pure.} = enum
    kRail
    kStraightRail
  RailProperties* = object
    kind*: RailPropertiesKind
    f0Rail*: RailLikeProperties
    f0StraightRail*: PoweredRailLikeProperties
  RailElevation* {.pure.} = enum
    Flat
    Up
    Down



proc findWithElevation*(world: BlockWorld, position: BlockPos): Option[Rail]
proc findIfUnlocked*(world: BlockWorld, placePos: BlockPos, direction: HorizontalFacing): Option[Rail]
proc isLocked*(self: Rail, world: BlockWorld): bool
proc getNewRailShape*(self: Rail, first: HorizontalFacing, second: HorizontalFacing): RailShape
proc defaultRailProperties*(blockRef: Block): RailProperties
proc newRailProperties*(stateId: BlockStateId, blockRef: Block): RailProperties
proc canCurve*(self: RailProperties): bool
proc shape*(self: RailProperties): RailShape
proc directions*(self: RailProperties): array[2, HorizontalFacing]
proc toStateId*(self: RailProperties, blockRef: Block): BlockStateId
proc setWaterlogged*(self: var RailProperties, waterlogged: bool)
proc setShape*(self: var RailProperties, shape: RailShape)
proc setStraightShape*(self: var RailProperties, shape: RailShapeStraight)
proc isPowered*(self: RailProperties): bool
proc setPowered*(self: var RailProperties, powered: bool)
proc asShape*(self: RailShapeStraight): RailShape
proc toRailShapeFlat*(self: HorizontalFacing): RailShapeStraight
proc toRailShapeAscendingTowards*(self: HorizontalFacing): RailShapeStraight

proc findWithElevation*(world: BlockWorld, position: BlockPos): Option[Rail] =
  let (blockRef, blockState) = world.getBlockAndStateId(position)
  if blockRef.hasTag(Block_MINECRAFT_RAILS):
    let properties = newRailProperties(blockState, blockRef)
    return some(Rail(block0: blockRef, position: position, properties: properties, elevation: RailElevation.Flat))
  let pos = position.up()
  let (blockRef1, blockState2) = world.getBlockAndStateId(pos)
  if blockRef1.hasTag(Block_MINECRAFT_RAILS):
    let properties3 = newRailProperties(blockState2, blockRef1)
    return some(Rail(block0: blockRef1, position: pos, properties: properties3, elevation: RailElevation.Up))
  let pos4 = position.down()
  let (blockRef5, blockState6) = world.getBlockAndStateId(pos4)
  if blockRef5.hasTag(Block_MINECRAFT_RAILS):
    let properties7 = newRailProperties(blockState6, blockRef5)
    return some(Rail(block0: blockRef5, position: pos4, properties: properties7, elevation: RailElevation.Down))
  none[Rail]()

proc findIfUnlocked*(world: BlockWorld, placePos: BlockPos, direction: HorizontalFacing): Option[Rail] =
  let railPosition = placePos.offset(direction.toOffset())
  let t1 = findWithElevation(world, railPosition)
  if t1.isNone: return none[Rail]()
  let rail = t1.unsafeGet
  if rail.isLocked(world):
    return none[Rail]()
  some(rail)

proc isLocked*(self: Rail, world: BlockWorld): bool =
  let t2 = self.properties.directions()
  for direction in t2:
    let t3 = findWithElevation(world, self.position.offset(direction.toOffset()))
    if not (t3.isSome):
      # Rails pointing to non-rail blocks are not locked
      return false
    let otherRail = t3.unsafeGet
    let direction1 = direction.opposite()
    var t5 = false
    for d in otherRail.properties.directions():
      if (d == direction1):
        t5 = true
        break
    if (not t5):
      # Rails pointing to other rails that are not pointing back are not locked
      return false
  true

proc getNewRailShape*(self: Rail, first: HorizontalFacing, second: HorizontalFacing): RailShape =
  let t6 = (first, second)
  if (t6[0] == HorizontalFacing.North and t6[1] == HorizontalFacing.South or t6[0] == HorizontalFacing.South and t6[1] == HorizontalFacing.North):
    RailShape.NorthSouth
  elif (t6[0] == HorizontalFacing.East and t6[1] == HorizontalFacing.West or t6[0] == HorizontalFacing.West and t6[1] == HorizontalFacing.East):
    RailShape.EastWest
  elif (t6[0] == HorizontalFacing.South and t6[1] == HorizontalFacing.East or t6[0] == HorizontalFacing.East and t6[1] == HorizontalFacing.South):
    if self.properties.canCurve():
      RailShape.SouthEast
    else:
      RailShape.EastWest
  elif (t6[0] == HorizontalFacing.South and t6[1] == HorizontalFacing.West or t6[0] == HorizontalFacing.West and t6[1] == HorizontalFacing.South):
    if self.properties.canCurve():
      RailShape.SouthWest
    else:
      RailShape.EastWest
  elif (t6[0] == HorizontalFacing.North and t6[1] == HorizontalFacing.West or t6[0] == HorizontalFacing.West and t6[1] == HorizontalFacing.North):
    if self.properties.canCurve():
      RailShape.NorthWest
    else:
      RailShape.EastWest
  elif (t6[0] == HorizontalFacing.North and t6[1] == HorizontalFacing.East or t6[0] == HorizontalFacing.East and t6[1] == HorizontalFacing.North):
    if self.properties.canCurve():
      RailShape.NorthEast
    else:
      RailShape.EastWest
  else:
    discard
    RailShape.NorthSouth

proc defaultRailProperties*(blockRef: Block): RailProperties =
  if (blockRef == blockRail()):
    RailProperties(kind: RailPropertiesKind.kRail, f0Rail: RailLikeProperties.defaultFor(blockRef))
  else:
    RailProperties(kind: RailPropertiesKind.kStraightRail, f0StraightRail: PoweredRailLikeProperties.defaultFor(blockRef))

proc newRailProperties*(stateId: BlockStateId, blockRef: Block): RailProperties =
  if (blockRef == blockRail()):
    RailProperties(kind: RailPropertiesKind.kRail, f0Rail: RailLikeProperties.fromStateId(stateId, blockRef))
  else:
    RailProperties(kind: RailPropertiesKind.kStraightRail, f0StraightRail: PoweredRailLikeProperties.fromStateId(stateId, blockRef))

proc canCurve*(self: RailProperties): bool =
  if self.kind == RailPropertiesKind.kRail:
    true
  elif self.kind == RailPropertiesKind.kStraightRail:
    false
  else:
    rustPanic("non-exhaustive")

proc shape*(self: RailProperties): RailShape =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    self.f0Rail.shape
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    case self.f0StraightRail.shape
    of RailShapeStraight.NorthSouth:
      RailShape.NorthSouth
    of RailShapeStraight.EastWest:
      RailShape.EastWest
    of RailShapeStraight.AscendingEast:
      RailShape.AscendingEast
    of RailShapeStraight.AscendingWest:
      RailShape.AscendingWest
    of RailShapeStraight.AscendingNorth:
      RailShape.AscendingNorth
    of RailShapeStraight.AscendingSouth:
      RailShape.AscendingSouth
  else:
    rustPanic("non-exhaustive")

proc directions*(self: RailProperties): array[2, HorizontalFacing] =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    case self.f0Rail.shape
    of RailShape.EastWest, RailShape.AscendingEast, RailShape.AscendingWest:
      [HorizontalFacing.West, HorizontalFacing.East]
    of RailShape.NorthSouth, RailShape.AscendingNorth, RailShape.AscendingSouth:
      [HorizontalFacing.North, HorizontalFacing.South]
    of RailShape.SouthEast:
      [HorizontalFacing.East, HorizontalFacing.South]
    of RailShape.SouthWest:
      [HorizontalFacing.West, HorizontalFacing.South]
    of RailShape.NorthWest:
      [HorizontalFacing.West, HorizontalFacing.North]
    of RailShape.NorthEast:
      [HorizontalFacing.East, HorizontalFacing.North]
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    case self.f0StraightRail.shape
    of RailShapeStraight.EastWest, RailShapeStraight.AscendingEast, RailShapeStraight.AscendingWest:
      [HorizontalFacing.West, HorizontalFacing.East]
    of RailShapeStraight.NorthSouth, RailShapeStraight.AscendingNorth, RailShapeStraight.AscendingSouth:
      [HorizontalFacing.North, HorizontalFacing.South]
  else:
    rustPanic("non-exhaustive")

proc toStateId*(self: RailProperties, blockRef: Block): BlockStateId =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    self.f0Rail.toStateId(blockRef)
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    self.f0StraightRail.toStateId(blockRef)
  else:
    rustPanic("non-exhaustive")

proc setWaterlogged*(self: var RailProperties, waterlogged: bool) =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    self.f0Rail.waterlogged = waterlogged
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    self.f0StraightRail.waterlogged = waterlogged
  else:
    rustPanic("non-exhaustive")

proc setShape*(self: var RailProperties, shape: RailShape) =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    self.f0Rail.shape = shape
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    let t7 = block:
      case shape
      of RailShape.NorthSouth:
        RailShapeStraight.NorthSouth
      of RailShape.EastWest:
        RailShapeStraight.EastWest
      of RailShape.AscendingEast:
        RailShapeStraight.AscendingEast
      of RailShape.AscendingWest:
        RailShapeStraight.AscendingWest
      of RailShape.AscendingNorth:
        RailShapeStraight.AscendingNorth
      of RailShape.AscendingSouth:
        RailShapeStraight.AscendingSouth
      else:
        discard
        return
    self.f0StraightRail.shape = t7
  else:
    rustPanic("non-exhaustive")

proc setStraightShape*(self: var RailProperties, shape: RailShapeStraight) =
  if self.kind == RailPropertiesKind.kRail:
    let props = self.f0Rail
    self.f0Rail.shape = shape.asShape()
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    self.f0StraightRail.shape = shape
  else:
    rustPanic("non-exhaustive")

proc isPowered*(self: RailProperties): bool =
  if self.kind == RailPropertiesKind.kRail:
    false
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    self.f0StraightRail.powered
  else:
    rustPanic("non-exhaustive")

proc setPowered*(self: var RailProperties, powered: bool) =
  if self.kind == RailPropertiesKind.kRail:
    discard
  elif self.kind == RailPropertiesKind.kStraightRail:
    let props = self.f0StraightRail
    self.f0StraightRail.powered = powered
  else:
    rustPanic("non-exhaustive")

proc asShape*(self: RailShapeStraight): RailShape =
  case self
  of RailShapeStraight.NorthSouth:
    RailShape.NorthSouth
  of RailShapeStraight.EastWest:
    RailShape.EastWest
  of RailShapeStraight.AscendingNorth:
    RailShape.AscendingNorth
  of RailShapeStraight.AscendingSouth:
    RailShape.AscendingSouth
  of RailShapeStraight.AscendingEast:
    RailShape.AscendingEast
  of RailShapeStraight.AscendingWest:
    RailShape.AscendingWest

proc toRailShapeFlat*(self: HorizontalFacing): RailShapeStraight =
  case self
  of HorizontalFacing.North, HorizontalFacing.South:
    RailShapeStraight.NorthSouth
  of HorizontalFacing.East, HorizontalFacing.West:
    RailShapeStraight.EastWest

proc toRailShapeAscendingTowards*(self: HorizontalFacing): RailShapeStraight =
  case self
  of HorizontalFacing.North:
    RailShapeStraight.AscendingNorth
  of HorizontalFacing.South:
    RailShapeStraight.AscendingSouth
  of HorizontalFacing.East:
    RailShapeStraight.AscendingEast
  of HorizontalFacing.West:
    RailShapeStraight.AscendingWest

