import ../../blockprelude


type
  RedstoneBlock* = object



proc redstoneBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc redstoneBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc newRedstoneBlock*(): BlockBehaviour

proc redstoneBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  15'u8

proc redstoneBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc newRedstoneBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.getWeakRedstonePowerImpl = redstoneBlockGetWeakRedstonePower_BlockBehaviour
  result.emitsRedstonePowerImpl = redstoneBlockEmitsRedstonePower_BlockBehaviour

proc registerBlocksRedstoneRedstoneBlock*(r: BlockRegistry) =
  r.register("minecraft:redstone_block", newRedstoneBlock())

