## Port of pumpkin/src/block/blocks/redstone/redstone_lamp.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import redstonemod


type
  RedstoneLampProperties = RedstoneOreLikeProperties
  RedstoneLamp* = object



proc redstoneLampOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc redstoneLampOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc redstoneLampOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newRedstoneLamp*(): BlockBehaviour

proc redstoneLampOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = RedstoneLampProperties.defaultFor(args.block0)
  props.lit = blockReceivesRedstonePower(args.world, args.position)
  props.toStateId(args.block0)

proc redstoneLampOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockState(args.position)
  var props = RedstoneLampProperties.fromStateId(state.id, args.block0)
  let isLit = props.lit
  let isReceivingPower = blockReceivesRedstonePower(args.world, args.position)
  if (not (isLit == isReceivingPower)):
    if isLit:
      args.world.scheduleBlockTick(args.block0, args.position, 4, tpNormal)
    else:
      props.lit = (not props.lit)
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc redstoneLampOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  var props = RedstoneLampProperties.fromStateId(state.id, args.block0)
  let isLit = props.lit
  let isReceivingPower = blockReceivesRedstonePower(args.world, args.position)
  if isLit and (not isReceivingPower):
    props.lit = (not props.lit)
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc newRedstoneLamp*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = redstoneLampOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = redstoneLampOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = redstoneLampOnScheduledTick_BlockBehaviour

proc registerBlocksRedstoneRedstoneLamp*(r: BlockRegistry) =
  r.register("minecraft:redstone_lamp", newRedstoneLamp())

