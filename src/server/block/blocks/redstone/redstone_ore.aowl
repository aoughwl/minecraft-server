## Port of pumpkin/src/block/blocks/redstone/redstone_ore.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  RedstoneOreBlock* = object



proc redstoneOreBlockIds*(): seq[BlockId]
proc lightUp*(world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState)
proc redstoneOreBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc redstoneOreBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc redstoneOreBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs)
proc redstoneOreBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newRedstoneOreBlock*(): BlockBehaviour

proc redstoneOreBlockIds*(): seq[BlockId] =
  @[blockIdRedstoneOre, blockIdDeepslateRedstoneOre]

proc lightUp*(world: BlockWorld, pos: BlockPos, blockRef: Block, state: BlockState) =
  var props = RedstoneOreLikeProperties.fromStateId(state.id, blockRef)
  if (not props.lit):
    props.lit = true
    discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyAll)
  # In vanilla Minecraft, it stays lit for 30 seconds (600 ticks) before scheduled tick turns it off.
  # We use 30 ticks to fit in the u8 parameter range.
  world.scheduleBlockTick(blockRef, pos, 30, tpNormal)

proc redstoneOreBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  lightUp(args.world, args.position, args.block0, state)
  barSuccess

proc redstoneOreBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  let state = args.world.getBlockState(args.position)
  lightUp(args.world, args.position, args.block0, state)

proc redstoneOreBlockOnEntityStep_BlockBehaviour(args: OnEntityStepArgs) =
  let state = args.world.getBlockState(args.position)
  lightUp(args.world, args.position, args.block0, state)

proc redstoneOreBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  var props = RedstoneOreLikeProperties.fromStateId(state.id, args.block0)
  if props.lit:
    props.lit = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)

proc newRedstoneOreBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = redstoneOreBlockNormalUse_BlockBehaviour
  result.onEntityCollisionImpl = redstoneOreBlockOnEntityCollision_BlockBehaviour
  result.onEntityStepImpl = redstoneOreBlockOnEntityStep_BlockBehaviour
  result.onScheduledTickImpl = redstoneOreBlockOnScheduledTick_BlockBehaviour

proc registerBlocksRedstoneRedstoneOre*(r: BlockRegistry) =
  r.registerIds(redstoneOreBlockIds(), newRedstoneOreBlock())

