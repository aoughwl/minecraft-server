import ../../blockprelude
import redstonemod


type
  RWallTorchProps = FurnaceLikeProperties
  RTorchProps = RedstoneOreLikeProperties
  RedstoneTorchBlock* = object



proc redstoneTorchBlockIds*(): seq[BlockId]
proc redstoneTorchBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc redstoneTorchBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc redstoneTorchBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc redstoneTorchBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc redstoneTorchBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc redstoneTorchBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc redstoneTorchBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc redstoneTorchBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc redstoneTorchBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc redstoneTorchBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newRedstoneTorchBlock*(): BlockBehaviour
proc shouldBeLit*(world: BlockWorld, pos: BlockPos, face: BlockDirection): bool
proc updateNeighbors*(world: BlockWorld, pos: BlockPos)
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: BlockDirection): bool

proc redstoneTorchBlockIds*(): seq[BlockId] =
  @[blockIdRedstoneTorch, blockIdRedstoneWallTorch]

proc redstoneTorchBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let world = args.world
  let blockRef = args.block0
  let location = args.position
  if (args.direction == BlockDirection.Down):
    let supportBlock = world.getBlockState(location.down())
    if supportBlock.isCenterSolid(BlockDirection.Up):
      return blockRef.defaultState.id
  var directions = args.player.getEntity().getEntityFacingOrder()
  if (args.replacing == BlockIsReplacing(kind: BlockIsReplacingKind.kNone)):
    let face = args.direction.toFacing()
    var i = 0
    while ((i < len(directions)) and (directions[i] != face)):
      i += 1
    if (i > 0):
      directions.copyWithin(0 ..< i, 1)
      directions[0] = face
  elif (directions[0] == Facing.Down):
    let supportBlock1 = world.getBlockState(location.down())
    if supportBlock1.isCenterSolid(BlockDirection.Up):
      return blockRef.defaultState.id
  for dir in directions:
    if (dir != Facing.Up) and (dir != Facing.Down) and canPlaceAt(world, location, dir.toBlockDirection()):
      var torchProps = RWallTorchProps.defaultFor(blockRedstoneWallTorch())
      torchProps.facing = dir.opposite().toHorizontalFacing().get()
      return torchProps.toStateId(blockRedstoneWallTorch())
  let supportBlock2 = world.getBlockState(location.down())
  if supportBlock2.isCenterSolid(BlockDirection.Up):
    blockRef.defaultState.id
  else:
    blockStateIdAir

proc redstoneTorchBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let supportBlock = args.blockAccessor.getBlockState(args.position.down())
  if supportBlock.isCenterSolid(BlockDirection.Up):
    return true
  let t1 = blockDirectionHorizontal()
  for dir in t1:
    if canPlaceAt(args.blockAccessor, args.position, dir.toBlockDirection()):
      return true
  false

proc redstoneTorchBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (args.block0 == blockRedstoneWallTorch()):
    let props = RWallTorchProps.fromStateId(args.stateId, args.block0)
    if (props.facing.toBlockDirection().opposite() == args.direction) and (not canPlaceAt(args.world, args.position, props.facing.toBlockDirection().opposite())):
      return blockStateIdAir
  elif (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if (not supportBlock.isCenterSolid(BlockDirection.Up)):
      return blockStateIdAir
  args.stateId

proc redstoneTorchBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockState(args.position)
  if args.world.isBlockTickScheduled(args.position, args.block0):
    return
  if (args.block0 == blockRedstoneWallTorch()):
    let props = RWallTorchProps.fromStateId(state.id, args.block0)
    if (props.lit != shouldBeLit(args.world, args.position, props.facing.toBlockDirection().opposite())):
      args.world.scheduleBlockTick(args.block0, args.position, 2, tpNormal)
  elif (args.block0 == blockRedstoneTorch()):
    let props1 = RTorchProps.fromStateId(state.id, args.block0)
    if (props1.lit != shouldBeLit(args.world, args.position, BlockDirection.Down)):
      args.world.scheduleBlockTick(args.block0, args.position, 2, tpNormal)

proc redstoneTorchBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc redstoneTorchBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  if (args.block0 == blockRedstoneWallTorch()):
    let props = RWallTorchProps.fromStateId(args.state.id, args.block0)
    if props.lit and (args.direction != props.facing.toBlockDirection()):
      return 15
  elif (args.block0 == blockRedstoneTorch()):
    let props1 = RTorchProps.fromStateId(args.state.id, args.block0)
    if props1.lit and (args.direction != BlockDirection.Up):
      return 15
  0'u8

proc redstoneTorchBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  if (args.direction == BlockDirection.Down):
    if (args.block0 == blockRedstoneWallTorch()):
      let props = RWallTorchProps.fromStateId(args.state.id, args.block0)
      if props.lit:
        return 15
    elif (args.block0 == blockRedstoneTorch()):
      let props1 = RTorchProps.fromStateId(args.state.id, args.block0)
      if props1.lit:
        return 15
  0'u8

proc redstoneTorchBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  if (args.block0 == blockRedstoneWallTorch()):
    var props = RWallTorchProps.fromStateId(state.id, args.block0)
    let shouldBeLitNow = shouldBeLit(args.world, args.position, props.facing.toBlockDirection().opposite())
    if (props.lit != shouldBeLitNow):
      props.lit = shouldBeLitNow
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
      updateNeighbors(args.world, args.position)
  elif (args.block0 == blockRedstoneTorch()):
    var props1 = RTorchProps.fromStateId(state.id, args.block0)
    let shouldBeLitNow2 = shouldBeLit(args.world, args.position, BlockDirection.Down)
    if (props1.lit != shouldBeLitNow2):
      props1.lit = shouldBeLitNow2
      discard args.world.setBlockState(args.position, props1.toStateId(args.block0), BfNotifyAll)
      updateNeighbors(args.world, args.position)

proc redstoneTorchBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  updateNeighbors(args.world, args.position)

proc redstoneTorchBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  updateNeighbors(args.world, args.position)

proc newRedstoneTorchBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = redstoneTorchBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = redstoneTorchBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = redstoneTorchBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onNeighborUpdateImpl = redstoneTorchBlockOnNeighborUpdate_BlockBehaviour
  result.emitsRedstonePowerImpl = redstoneTorchBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = redstoneTorchBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = redstoneTorchBlockGetStrongRedstonePower_BlockBehaviour
  result.onScheduledTickImpl = redstoneTorchBlockOnScheduledTick_BlockBehaviour
  result.placedImpl = redstoneTorchBlockPlaced_BlockBehaviour
  result.onStateReplacedImpl = redstoneTorchBlockOnStateReplaced_BlockBehaviour

proc shouldBeLit*(world: BlockWorld, pos: BlockPos, face: BlockDirection): bool =
  let otherPos = pos.offset(face.toOffset())
  let (blockRef, state) = world.getBlockAndState(otherPos)
  (getRedstonePower(blockRef, state, world, otherPos, face) == 0)

proc updateNeighbors*(world: BlockWorld, pos: BlockPos) =
  let t2 = blockDirectionAll()
  for dir in t2:
    let otherPos = pos.offset(dir.toOffset())
    world.updateNeighbors(otherPos, none[BlockDirection]())

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: BlockDirection): bool =
  world.getBlockState(blockPos.offset(facing.toOffset())).isSideSolid(facing.opposite())

proc registerBlocksRedstoneRedstoneTorch*(r: BlockRegistry) =
  r.registerIds(redstoneTorchBlockIds(), newRedstoneTorchBlock())

