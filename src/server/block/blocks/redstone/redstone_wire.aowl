proc redstoneWireBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(args.blockAccessor, args.position)

proc redstoneWireBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var wire = RedstoneWireProperties.defaultFor(args.block0)
  wire.power = calculatePower(args.world, args.position)
  wire = getRegulatedSides(wire, args.world, args.position)
  if isDot(wire):
    wire = makeCross(wire.power)
  wire.toStateId(args.block0)

proc redstoneWireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  var wire = RedstoneWireProperties.fromStateId(args.stateId, args.block0)
  let oldState = wire
  if args.direction == BlockDirection.Up:
    return args.stateId
  if args.direction == BlockDirection.Down:
    return getRegulatedSides(wire, args.world, args.position).toStateId(args.block0)
  var t1 = WireConnection.None
  block:
    case args.direction
    of BlockDirection.Up, BlockDirection.Down:
      discard
    of BlockDirection.North:
      let side = getSide(args.world, args.position, BlockDirection.North)
      wire.north = side.toNorth()
      t1 = side
    of BlockDirection.South:
      let side1 = getSide(args.world, args.position, BlockDirection.South)
      wire.south = side1.toSouth()
      t1 = side1
    of BlockDirection.East:
      let side2 = getSide(args.world, args.position, BlockDirection.East)
      wire.east = side2.toEast()
      t1 = side2
    of BlockDirection.West:
      let side3 = getSide(args.world, args.position, BlockDirection.West)
      wire.west = side3.toWest()
      t1 = side3
  let newSide: WireConnection = t1
  wire = getRegulatedSides(wire, args.world, args.position)
  wire.power = calculatePower(args.world, args.position)
  if isCross(oldState) and newSide.isNone():
    return wire.toStateId(args.block0)
  if (not isDot(oldState)) and isDot(wire):
    let power = wire.power
    wire = makeCross(power)
  wire.toStateId(args.block0)

proc redstoneWireBlockPrepare_BlockBehaviour(args: PrepareArgs) =
  let wireProps = RedstoneWireLikeProperties.fromStateId(args.stateId, blockRedstoneWire())
  let t2 = blockDirectionHorizontal()
  for direction in t2:
    let otherBlockPos = args.position.offset(direction.toOffset())
    let otherBlock = args.world.getBlock(otherBlockPos)
    if wireProps.isSideConnected(direction) and (not (otherBlock == blockRedstoneWire())):
      let upBlockPos = otherBlockPos.up()
      let upBlock = args.world.getBlock(upBlockPos)
      if (upBlock == blockRedstoneWire()):
        args.world.replaceWithStateForNeighborUpdate(upBlockPos, direction.opposite().toBlockDirection(), args.flags)
      let downBlockPos = otherBlockPos.down()
      let downBlock = args.world.getBlock(downBlockPos)
      if (downBlock == blockRedstoneWire()):
        args.world.replaceWithStateForNeighborUpdate(downBlockPos, direction.opposite().toBlockDirection(), args.flags)
  let t3 = blockDirectionAll()
  for sideDir in t3:
    let sideBlockPos = args.position.offset(sideDir.toOffset())
    let t4 = blockDirectionAll()
    for dir in t4:
      if (dir.opposite() == sideDir):
        continue
      let sideNeighborPos = sideBlockPos.offset(dir.toOffset())
      let sideNeighborBlock = args.world.getBlock(sideNeighborPos)
      if ((sideNeighborBlock == blockRedstoneWallTorch()) or ((sideNeighborBlock == blockPiston()) or (sideNeighborBlock == blockStickyPiston()))):
        args.world.updateNeighbor(sideNeighborPos, blockRedstoneWire())

proc redstoneWireBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  let wire = RedstoneWireProperties.fromStateId(state.id, args.block0)
  if onUse(wire, args.world, args.position):
    barSuccess
  else:
    barPass

proc redstoneWireBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if canPlaceAt(args.world, args.position):
    let state = args.world.getBlockState(args.position)
    var wire = RedstoneWireProperties.fromStateId(state.id, args.block0)
    let newPower = calculatePower(args.world, args.position)
    if (not (wire.power == newPower)):
      wire.power = newPower
      discard args.world.setBlockState(args.position, wire.toStateId(blockRedstoneWire()), 0'u32)
      updateSurroundingNeighbors(args.world, args.position)
  else:
    discard args.world.breakBlock(args.position, nil, BfNotifyAll)

proc redstoneWireBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let wire = RedstoneWireProperties.fromStateId(args.state.id, args.block0)
  if ((args.direction == BlockDirection.Up) or wire.isSideConnected(args.direction.opposite().toHorizontalFacing().get())):
    wire.power
  else:
    0'u8

proc redstoneWireBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let wire = RedstoneWireProperties.fromStateId(args.state.id, args.block0)
  if ((args.direction == BlockDirection.Up) or wire.isSideConnected(args.direction.opposite().toHorizontalFacing().get())):
    wire.power
  else:
    0'u8

proc redstoneWireBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  updateWireNeighbors(args.world, args.position)

proc redstoneWireBlockBroken_BlockBehaviour(args: BrokenArgs) =
  updateWireNeighbors(args.world, args.position)

proc newRedstoneWireBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.canPlaceAtImpl = redstoneWireBlockCanPlaceAt_BlockBehaviour
  result.onPlaceImpl = redstoneWireBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = redstoneWireBlockGetStateForNeighborUpdate_BlockBehaviour
  result.prepareImpl = redstoneWireBlockPrepare_BlockBehaviour
  result.normalUseImpl = redstoneWireBlockNormalUse_BlockBehaviour
  result.onNeighborUpdateImpl = redstoneWireBlockOnNeighborUpdate_BlockBehaviour
  result.getWeakRedstonePowerImpl = redstoneWireBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = redstoneWireBlockGetStrongRedstonePower_BlockBehaviour
  result.placedImpl = redstoneWireBlockPlaced_BlockBehaviour
  result.brokenImpl = redstoneWireBlockBroken_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos): bool =
  let floor = world.getBlockState(blockPos.down())
  floor.isSideSolid(BlockDirection.Up)

proc onUse*(wire: RedstoneWireProperties, world: BlockWorld, blockPos: BlockPos): bool =
  if (isCross(wire) or isDot(wire)):
    let t5 = block:
      if isCross(wire):
        RedstoneWireProperties.defaultFor(blockRedstoneWire())
      else:
        makeCross(wire.power)
    var newWire = t5
    newWire.power = wire.power
    newWire = getRegulatedSides(newWire, world, blockPos)
    if (not (wire.toIndex() == newWire.toIndex())):
      discard world.setBlockState(blockPos, newWire.toStateId(blockRedstoneWire()), 0'u32)
      updateWireNeighbors(world, blockPos)
      return true
  false

proc makeCross*(power: uint8): RedstoneWireProperties =
  RedstoneWireProperties(north: NorthRedstone.Side, south: SouthRedstone.Side, east: EastRedstone.Side, west: WestRedstone.Side, power: power)

proc canConnectTo*(world: BlockWorld, blockRef: Block, side: BlockDirection, state: BlockState): bool =
  if world.blockRegistry.emitsRedstonePower(blockRef, state, side):
    return true
  if (blockRef == blockRepeater()):
    let repeaterProps = RepeaterLikeProperties.fromStateId(state.id, blockRef)
    return ((repeaterProps.facing.toBlockDirection() == side) or (repeaterProps.facing.toBlockDirection() == side.opposite()))
  elif (blockRef == blockObserver()):
    let observerProps = ObserverLikeProperties.fromStateId(state.id, blockRef)
    return (observerProps.facing == side.toFacing())
  elif (blockRef == blockRedstoneWire()):
    return true
  false

proc canConnectDiagonalTo*(blockRef: Block): bool =
  (blockRef == blockRedstoneWire())

proc getSide*(world: BlockWorld, pos: BlockPos, side: BlockDirection): WireConnection =
  let neighborPos: BlockPos = pos.offset(side.toOffset())
  let (neighbor, state) = world.getBlockAndState(neighborPos)
  if canConnectTo(world, neighbor, side, state):
    return WireConnection.Side
  let upPos = pos.offset(BlockDirection.Up.toOffset())
  let upState = world.getBlockState(upPos)
  if (not upState.isSolidBlock()) and state.isSideSolid(side.opposite()) and canConnectDiagonalTo(world.getBlock(neighborPos.offset(BlockDirection.Up.toOffset()))):
    WireConnection.Up
  else:
    if (not state.isSolidBlock()) and canConnectDiagonalTo(world.getBlock(neighborPos.offset(BlockDirection.Down.toOffset()))):
      WireConnection.Side
    else:
      WireConnection.None

proc getAllSides*(wire: RedstoneWireProperties, world: BlockWorld, pos: BlockPos): RedstoneWireProperties =
  var wire = wire
  wire.north = getSide(world, pos, BlockDirection.North).toNorth()
  wire.south = getSide(world, pos, BlockDirection.South).toSouth()
  wire.east = getSide(world, pos, BlockDirection.East).toEast()
  wire.west = getSide(world, pos, BlockDirection.West).toWest()
  wire

proc isDot*(wire: RedstoneWireProperties): bool =
  ((((wire.north == NorthRedstone.None) and (wire.south == SouthRedstone.None)) and (wire.east == EastRedstone.None)) and (wire.west == WestRedstone.None))

proc isCross*(wire: RedstoneWireProperties): bool =
  ((((wire.north == NorthRedstone.Side) and (wire.south == SouthRedstone.Side)) and (wire.east == EastRedstone.Side)) and (wire.west == WestRedstone.Side))

proc getRegulatedSides*(wire: RedstoneWireProperties, world: BlockWorld, pos: BlockPos): RedstoneWireProperties =
  var state = getAllSides(wire, world, pos)
  if isDot(wire) and isDot(state):
    return state
  let northNone = (state.north == NorthRedstone.None)
  let southNone = (state.south == SouthRedstone.None)
  let eastNone = (state.east == EastRedstone.None)
  let westNone = (state.west == WestRedstone.None)
  let northSouthNone = (northNone and southNone)
  let eastWestNone = (eastNone and westNone)
  if northNone and eastWestNone:
    state.north = NorthRedstone.Side
  if southNone and eastWestNone:
    state.south = SouthRedstone.Side
  if eastNone and northSouthNone:
    state.east = EastRedstone.Side
  if westNone and northSouthNone:
    state.west = WestRedstone.Side
  state

proc isSideConnected*(self: RedstoneWireLikeProperties, direction: HorizontalFacing): bool =
  case direction
  of HorizontalFacing.North:
    self.north.toWireConnection().isConnected()
  of HorizontalFacing.South:
    self.south.toWireConnection().isConnected()
  of HorizontalFacing.East:
    self.east.toWireConnection().isConnected()
  of HorizontalFacing.West:
    self.west.toWireConnection().isConnected()

proc isConnected*(self: WireConnection): bool =
  (not (self == WireConnection.None))

proc isNone*(self: WireConnection): bool =
  (self == WireConnection.None)

proc toNorth*(self: WireConnection): NorthRedstone =
  if self == WireConnection.Up:
    NorthRedstone.Up
  elif self == WireConnection.Side:
    NorthRedstone.Side
  elif self == WireConnection.None:
    NorthRedstone.None
  else:
    rustPanic("non-exhaustive")

proc toSouth*(self: WireConnection): SouthRedstone =
  if self == WireConnection.Up:
    SouthRedstone.Up
  elif self == WireConnection.Side:
    SouthRedstone.Side
  elif self == WireConnection.None:
    SouthRedstone.None
  else:
    rustPanic("non-exhaustive")

