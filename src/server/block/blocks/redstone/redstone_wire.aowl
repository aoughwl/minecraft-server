proc maxWirePower*(wirePower: uint8, world: BlockWorld, pos: BlockPos): uint8 =
  let (blockRef, blockState) = world.getBlockAndState(pos)
  if (blockRef == blockRedstoneWire()):
    let wire = RedstoneWireProperties.fromStateId(blockState.id, blockRef)
    wirePower.max(wire.power)
  else:
    wirePower

proc calculatePower*(world: BlockWorld, pos: BlockPos): uint8 =
  var blockPower: uint8 = 0
  var wirePower: uint8 = 0
  let upPos = pos.offset(BlockDirection.Up.toOffset())
  let upState = world.getBlockState(upPos)
  let t6 = blockDirectionAll()
  for side in t6:
    let neighborPos = pos.offset(side.toOffset())
    wirePower = maxWirePower(wirePower, world, neighborPos)
    let (neighbor, neighborState) = world.getBlockAndState(neighborPos)
    blockPower = blockPower.max(getRedstonePowerNoDust(neighbor, neighborState, world, neighborPos, side))
    if side.isHorizontal():
      if (not upState.isSolidBlock()) and neighborState.isSolidBlock():
        wirePower = maxWirePower(wirePower, world, neighborPos.offset(BlockDirection.Up.toOffset()))
      if (not neighborState.isSolidBlock()):
        wirePower = maxWirePower(wirePower, world, neighborPos.offset(BlockDirection.Down.toOffset()))
  blockPower.max(saturatingSub(wirePower, 1))

proc registerBlocksRedstoneRedstoneWire*(r: BlockRegistry) =
  r.register("minecraft:redstone_wire", newRedstoneWireBlock())

