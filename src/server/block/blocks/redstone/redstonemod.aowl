import ../../blockprelude




proc updateWireNeighbors*(world: BlockWorld, pos: BlockPos)
proc isEmittingRedstonePower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): bool
proc getRedstonePower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8
proc getRedstonePowerNoDust*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8
proc getMaxStrongPower*(world: BlockWorld, pos: BlockPos, dustPower: bool): uint8
proc getMaxWeakPower*(world: BlockWorld, pos: BlockPos, dustPower: bool): uint8
proc getWeakPower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, side: BlockDirection, dustPower: bool): uint8
proc getStrongPower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, side: BlockDirection, dustPower: bool): uint8
proc blockReceivesRedstonePower*(world: BlockWorld, pos: BlockPos): bool
proc isDiode*(blockRef: Block): bool
proc diodeGetInputStrength*(world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8

proc updateWireNeighbors*(world: BlockWorld, pos: BlockPos) =
  let t1 = blockDirectionAll()
  for direction in t1:
    let neighborPos = pos.offset(direction.toOffset())
    let blockRef = world.getBlock(neighborPos)
    world.blockRegistry.onNeighborUpdate(world, blockRef, neighborPos, blockRef, true)
    let t2 = blockDirectionAll()
    for nDirection in t2:
      let nNeighborPos = neighborPos.offset(nDirection.toOffset())
      let blockRef1 = world.getBlock(nNeighborPos)
      world.blockRegistry.onNeighborUpdate(world, blockRef1, nNeighborPos, blockRef1, true)

proc isEmittingRedstonePower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): bool =
  (getRedstonePower(blockRef, state, world, pos, facing) > 0)

proc getRedstonePower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8 =
  if state.isSolidBlock():
    return max(getMaxStrongPower(world, pos, true), getWeakPower(blockRef, state, world, pos, facing, true))
  getWeakPower(blockRef, state, world, pos, facing, true)

proc getRedstonePowerNoDust*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8 =
  if state.isSolidBlock():
    return max(getMaxStrongPower(world, pos, false), getWeakPower(blockRef, state, world, pos, facing, false))
  getWeakPower(blockRef, state, world, pos, facing, false)

proc getMaxStrongPower*(world: BlockWorld, pos: BlockPos, dustPower: bool): uint8 =
  var maxPower = 0'u8
  let t3 = blockDirectionAll()
  for side in t3:
    let (blockRef, state) = world.getBlockAndState(pos.offset(side.toOffset()))
    maxPower = maxPower.max(getStrongPower(blockRef, state, world, pos.offset(side.toOffset()), side, dustPower))
  maxPower

proc getMaxWeakPower*(world: BlockWorld, pos: BlockPos, dustPower: bool): uint8 =
  var maxPower = 0'u8
  let t4 = blockDirectionAll()
  for side in t4:
    let (blockRef, state) = world.getBlockAndState(pos.offset(side.toOffset()))
    maxPower = maxPower.max(getWeakPower(blockRef, state, world, pos.offset(side.toOffset()), side, dustPower))
  maxPower

proc getWeakPower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, side: BlockDirection, dustPower: bool): uint8 =
  if (not dustPower) and (blockRef == blockRedstoneWire()):
    return 0
  world.blockRegistry.getWeakRedstonePower(blockRef, world, pos, state, side)

proc getStrongPower*(blockRef: Block, state: BlockState, world: BlockWorld, pos: BlockPos, side: BlockDirection, dustPower: bool): uint8 =
  if (not dustPower) and (blockRef == blockRedstoneWire()):
    return 0
  world.blockRegistry.getStrongRedstonePower(blockRef, world, pos, state, side)

proc blockReceivesRedstonePower*(world: BlockWorld, pos: BlockPos): bool =
  let t5 = blockDirectionAll()
  for facing in t5:
    let neighborPos = pos.offset(facing.toOffset())
    let (blockRef, state) = world.getBlockAndState(neighborPos)
    if isEmittingRedstonePower(blockRef, state, world, neighborPos, facing):
      return true
  false

proc isDiode*(blockRef: Block): bool =
  ((blockRef == blockRepeater()) or (blockRef == blockComparator()))

proc diodeGetInputStrength*(world: BlockWorld, pos: BlockPos, facing: BlockDirection): uint8 =
  let inputPos = pos.offset(facing.toOffset())
  let (inputBlock, inputState) = world.getBlockAndState(inputPos)
  let power: uint8 = getRedstonePower(inputBlock, inputState, world, inputPos, facing)
  if (power == 0) and inputState.isSolidBlock():
    return getMaxWeakPower(world, inputPos, true)
  power

