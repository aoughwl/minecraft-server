## Redstone end to end over testworld.aowl: a lever, dust, a lamp, a repeater and a torch, through the real registry dispatch
## and the real neighbour updates. Known answers are vanilla's: dust loses one per block, a repeater at delay 1 waits two
## game ticks, a lamp goes dark four ticks after its power is gone.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../../blockprelude
import ../../testworld
import lever, redstone_wire, redstone_lamp, repeater, redstone_torch

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksRedstoneLever(result)
  registerBlocksRedstoneRedstoneWire(result)
  registerBlocksRedstoneRedstoneLamp(result)
  registerBlocksRedstoneRepeater(result)
  registerBlocksRedstoneRedstoneTorch(result)
  check(result.unknown.len == 0, "every registered name resolves")

proc floor0(t: TestWorld; x0, x1: int32) =
  ## A stone floor at y 64 under the row at y 65.
  var x = x0
  while x <= x1:
    t.put(blockPos(x, 64'i32, 0'i32), blockStone())
    inc x

proc use(t: TestWorld; pos: BlockPos) =
  let (blockRef, _) = t.world.getBlockAndStateId(pos)
  let b = t.world.blockRegistry.getPumpkinBlock(blockRef.id)
  assert b.isSome
  discard b.unsafeGet.normalUse(NormalUseArgs(world: t.world, block0: blockRef, position: pos))

proc lit(t: TestWorld; pos: BlockPos): bool =
  let (blockRef, id) = t.world.getBlockAndStateId(pos)
  assert sameBlock(blockRef, blockRedstoneLamp())
  RedstoneOreLikeProperties.fromStateId(id, blockRef).lit

proc wirePower(t: TestWorld; pos: BlockPos): uint8 =
  let (blockRef, id) = t.world.getBlockAndStateId(pos)
  assert sameBlock(blockRef, blockRedstoneWire())
  RedstoneWireLikeProperties.fromStateId(id, blockRef).power

proc leverOnFloor(): BlockStateId =
  var props = LeverLikeProperties.defaultFor(blockLever())
  props.face = AttachFace.Floor
  props.facing = HorizontalFacing.North
  props.powered = false
  props.toStateId(blockLever())

block leverLightsLampBesideIt:
  let t = newTestWorld(newRegistry())
  floor0(t, 0'i32, 1'i32)
  let leverPos = blockPos(0'i32, 65'i32, 0'i32)
  let lampPos = blockPos(1'i32, 65'i32, 0'i32)
  t.put(leverPos, leverOnFloor())
  t.put(lampPos, blockRedstoneLamp())
  check(not t.lit(lampPos), "line 58: not t.lit(lampPos)")
  t.use(leverPos)
  check(t.lit(lampPos), "line 60: a lamp lights at once")
  t.use(leverPos)
  check(t.lit(lampPos), "line 62: and does not go out at once")
  t.run(3)
  check(t.lit(lampPos), "line 64: still lit after 3 ticks")
  t.run(1)
  check(not t.lit(lampPos), "line 66: dark after 4")

block dustLosesOnePerBlock:
  let t = newTestWorld(newRegistry())
  floor0(t, 0'i32, 5'i32)
  let leverPos = blockPos(0'i32, 65'i32, 0'i32)
  t.put(leverPos, leverOnFloor())
  var x = 1'i32
  while x <= 3'i32:
    # As `on_place` leaves a line of dust running east-west: a bare dot would not power what is beside it.
    var wire = RedstoneWireLikeProperties.defaultFor(blockRedstoneWire())
    wire.east = WireConnection.Side.toEast()
    wire.west = WireConnection.Side.toWest()
    wire.north = WireConnection.None.toNorth()
    wire.south = WireConnection.None.toSouth()
    t.put(blockPos(x, 65'i32, 0'i32), wire.toStateId(blockRedstoneWire()))
    inc x
  let lampPos = blockPos(4'i32, 65'i32, 0'i32)
  t.put(lampPos, blockRedstoneLamp())
  t.use(leverPos)
  check(t.wirePower(blockPos(1'i32, 65'i32, 0'i32)) == 15'u8, "line 80: t.wirePower(blockPos(1'i32, 65'i32, 0'i32)) == 15'u8")
  check(t.wirePower(blockPos(2'i32, 65'i32, 0'i32)) == 14'u8, "line 81: t.wirePower(blockPos(2'i32, 65'i32, 0'i32)) == 14'u8")
  check(t.wirePower(blockPos(3'i32, 65'i32, 0'i32)) == 13'u8, "line 82: t.wirePower(blockPos(3'i32, 65'i32, 0'i32)) == 13'u8")
  # The lamp at the end of the line lights, as in vanilla: see the DEVIATION note in redstone_wire.aowl.
  check(t.lit(lampPos), "a lamp at the end of a dust line lights")
  t.use(leverPos)
  check(t.wirePower(blockPos(1'i32, 65'i32, 0'i32)) == 0'u8, "line 85: t.wirePower(blockPos(1'i32, 65'i32, 0'i32)) == 0'u8")
  check(t.wirePower(blockPos(3'i32, 65'i32, 0'i32)) == 0'u8, "line 86: t.wirePower(blockPos(3'i32, 65'i32, 0'i32)) == 0'u8")
  t.run(4)
  check(not t.lit(lampPos), "and goes dark once the line is dead")

block repeaterDelays:
  let t = newTestWorld(newRegistry())
  floor0(t, 0'i32, 2'i32)
  let leverPos = blockPos(0'i32, 65'i32, 0'i32)
  let repPos = blockPos(1'i32, 65'i32, 0'i32)
  let lampPos = blockPos(2'i32, 65'i32, 0'i32)
  t.put(leverPos, leverOnFloor())
  # A repeater's `facing` is the side its input is on: from the lever at -x, out to the lamp at +x.
  var rep = RepeaterLikeProperties.defaultFor(blockRepeater())
  rep.facing = HorizontalFacing.West
  rep.delay = 1'u8
  rep.powered = false
  rep.locked = false
  t.put(repPos, rep.toStateId(blockRepeater()))
  t.put(lampPos, blockRedstoneLamp())
  t.use(leverPos)
  check(not t.lit(lampPos), "line 104: nothing passes a repeater in the same tick")
  t.run(1)
  check(not t.lit(lampPos), "line 106: delay 1 is two game ticks")
  t.run(1)
  check(t.lit(lampPos), "line 108: lit after two")

echo "redstone: all checks passed"
