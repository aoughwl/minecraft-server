import ../../blockprelude
import abstract_redstone_gate


type
  RepeaterProperties = RepeaterLikeProperties
  RepeaterBlock* = object

var gRepeaterBlockAsRedstoneGateBlock: nil RedstoneGateBlock


proc repeaterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc repeaterBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc repeaterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc repeaterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc repeaterBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc repeaterBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc repeaterBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc repeaterBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc repeaterBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc repeaterBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc repeaterBlockPlayerPlaced_BlockBehaviour(args: PlayerPlacedArgs)
proc repeaterBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newRepeaterBlock*(): BlockBehaviour
proc isPowered*(self: RepeaterProperties): bool
proc getFacing*(self: RepeaterProperties): HorizontalFacing
proc setFacing*(self: var RepeaterProperties, facing: HorizontalFacing)
proc repeaterBlockGetOutputLevel_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): uint8
proc repeaterBlockUpdatePowered_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block)
proc repeaterBlockGetUpdateDelayInternal_RedstoneGateBlock(self: RedstoneGateBlock, stateId: BlockStateId, blockRef: Block): uint8
proc repeaterBlockAsRedstoneGateBlock*(): RedstoneGateBlock
proc onUse*(self: RepeaterBlock, props: RepeaterProperties, world: BlockWorld, blockPos: BlockPos, blockRef: Block)
proc isLocked*(self: RepeaterBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block): bool

proc repeaterBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let self = RepeaterBlock()
  let stateId = onPlace(repeaterBlockAsRedstoneGateBlock(), args.player, args.block0)
  var props = RepeaterProperties.fromStateId(stateId, args.block0)
  props.locked = self.isLocked(args.world, args.position, stateId, args.block0)
  props.toStateId(args.block0)

proc repeaterBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  onNeighborUpdate(repeaterBlockAsRedstoneGateBlock(), args)

proc repeaterBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let self = RepeaterBlock()
  let state = args.world.getBlockState(args.position)
  if self.isLocked(args.world, args.position, state.id, args.block0):
    return
  var props = RepeaterProperties.fromStateId(state.id, args.block0)
  let nowPowered = props.powered
  let shouldBePowered = hasPower(repeaterBlockAsRedstoneGateBlock(), args.world, args.position, state, args.block0)
  if nowPowered and (not shouldBePowered):
    props.powered = false
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
    updateTarget(repeaterBlockAsRedstoneGateBlock(), args.world, args.position, props.toStateId(args.block0), args.block0)
  elif (not nowPowered):
    props.powered = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)
    if (not shouldBePowered):
      args.world.scheduleBlockTick(args.block0, args.position, getUpdateDelayInternal(repeaterBlockAsRedstoneGateBlock(), props.toStateId(args.block0), args.block0), tpVeryHigh)
    updateTarget(repeaterBlockAsRedstoneGateBlock(), args.world, args.position, props.toStateId(args.block0), args.block0)

proc repeaterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let self = RepeaterBlock()
  let state = args.world.getBlockState(args.position)
  let props = RepeaterProperties.fromStateId(state.id, args.block0)
  self.onUse(props, args.world, args.position, args.block0)
  barSuccess

proc repeaterBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  getWeakRedstonePower(repeaterBlockAsRedstoneGateBlock(), args)

proc repeaterBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  getStrongRedstonePower(repeaterBlockAsRedstoneGateBlock(), args)

proc repeaterBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  let repeaterProps = RepeaterProperties.fromStateId(args.state.id, args.block0)
  ((repeaterProps.facing.toBlockDirection() == args.direction) or (repeaterProps.facing.toBlockDirection() == args.direction.opposite()))

proc repeaterBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceAt(repeaterBlockAsRedstoneGateBlock(), args.blockAccessor, args.position)

proc repeaterBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  updateTarget(repeaterBlockAsRedstoneGateBlock(), args.world, args.position, args.stateId, args.block0)

proc repeaterBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let self = RepeaterBlock()
  if (args.direction == BlockDirection.Down) and (not canPlaceAbove(repeaterBlockAsRedstoneGateBlock(), args.world, args.neighborPosition, BlockState.fromId(args.neighborStateId))):
    return blockAir().defaultState.id
  var props = RepeaterProperties.fromStateId(args.stateId, args.block0)
  if (not (args.direction.toAxis() == props.facing.toBlockDirection().toAxis())):
    props.locked = self.isLocked(args.world, args.position, args.stateId, args.block0)
    return props.toStateId(args.block0)
  args.stateId

proc repeaterBlockPlayerPlaced_BlockBehaviour(args: PlayerPlacedArgs) =
  playerPlaced(repeaterBlockAsRedstoneGateBlock(), args)

proc repeaterBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  onStateReplaced(repeaterBlockAsRedstoneGateBlock(), args)

proc newRepeaterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = repeaterBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = repeaterBlockOnNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = repeaterBlockOnScheduledTick_BlockBehaviour
  result.normalUseImpl = repeaterBlockNormalUse_BlockBehaviour
  result.getWeakRedstonePowerImpl = repeaterBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = repeaterBlockGetStrongRedstonePower_BlockBehaviour
  result.emitsRedstonePowerImpl = repeaterBlockEmitsRedstonePower_BlockBehaviour
  result.canPlaceAtImpl = repeaterBlockCanPlaceAt_BlockBehaviour
  result.placedImpl = repeaterBlockPlaced_BlockBehaviour
  result.getStateForNeighborUpdateImpl = repeaterBlockGetStateForNeighborUpdate_BlockBehaviour
  result.playerPlacedImpl = repeaterBlockPlayerPlaced_BlockBehaviour
  result.onStateReplacedImpl = repeaterBlockOnStateReplaced_BlockBehaviour

proc isPowered*(self: RepeaterProperties): bool =
  self.powered

proc getFacing*(self: RepeaterProperties): HorizontalFacing =
  self.facing

proc setFacing*(self: var RepeaterProperties, facing: HorizontalFacing) =
  self.facing = facing

proc repeaterBlockGetOutputLevel_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos): uint8 =
  15'u8

proc repeaterBlockUpdatePowered_RedstoneGateBlock(self: RedstoneGateBlock, world: BlockWorld, pos: BlockPos, state: BlockState, blockRef: Block) =
  # Note: is_locked is assumed to remain an async fn or return a future
  if RepeaterBlock().isLocked(world, pos, state.id, blockRef):
    return
  let props = RepeaterProperties.fromStateId(state.id, blockRef)
  let powered = props.powered
  # Note: The signature for has_power must be called without self, as it's a trait method.
  let hasPower = hasPower(repeaterBlockAsRedstoneGateBlock(), world, pos, state, blockRef)
  if (not (powered == hasPower)) and (not world.isBlockTickScheduled(pos, blockRef)):
    let t1 = block:
      if isTargetNotAligned(repeaterBlockAsRedstoneGateBlock(), world, pos, state, blockRef):
        tpExtremelyHigh
      elif powered:
        tpVeryHigh
      else:
        tpHigh
    let priority = t1
    world.scheduleBlockTick(blockRef, pos, getUpdateDelayInternal(repeaterBlockAsRedstoneGateBlock(), state.id, blockRef), priority)

proc repeaterBlockGetUpdateDelayInternal_RedstoneGateBlock(self: RedstoneGateBlock, stateId: BlockStateId, blockRef: Block): uint8 =
  let props = RepeaterProperties.fromStateId(stateId, blockRef)
  (props.delay * 2)

proc repeaterBlockAsRedstoneGateBlock*(): RedstoneGateBlock =
  if gRepeaterBlockAsRedstoneGateBlock == nil:
    let v = newRedstoneGateBlock()
    v.getOutputLevelImpl = repeaterBlockGetOutputLevel_RedstoneGateBlock
    v.updatePoweredImpl = repeaterBlockUpdatePowered_RedstoneGateBlock
    v.getUpdateDelayInternalImpl = repeaterBlockGetUpdateDelayInternal_RedstoneGateBlock
    gRepeaterBlockAsRedstoneGateBlock = v
  gRepeaterBlockAsRedstoneGateBlock

proc onUse*(self: RepeaterBlock, props: RepeaterProperties, world: BlockWorld, blockPos: BlockPos, blockRef: Block) =
  var props1 = props
  let t2 = block:
    if (props1.delay == 4):
      1'u8
    else:
      (props1.delay + 1)
  props1.delay = t2
  let state = props1.toStateId(blockRef)
  discard world.setBlockState(blockPos, state, 0'u32)

proc isLocked*(self: RepeaterBlock, world: BlockWorld, pos: BlockPos, stateId: BlockStateId, blockRef: Block): bool =
  (getMaxInputLevelSides(repeaterBlockAsRedstoneGateBlock(), world, pos, stateId, blockRef, true) > 0)

proc registerBlocksRedstoneRepeater*(r: BlockRegistry) =
  r.register("minecraft:repeater", newRepeaterBlock())

