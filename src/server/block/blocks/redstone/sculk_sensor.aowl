## Port of pumpkin/src/block/blocks/redstone/sculk_sensor.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude


type
  SculkSensorBlock* = object



proc sculkSensorBlockIds*(): seq[BlockId]
proc trigger*(world: BlockWorld, pos: BlockPos, blockRef: Block, power: uint8)
proc sculkSensorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc sculkSensorBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool
proc sculkSensorBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8
proc sculkSensorBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc newSculkSensorBlock*(): BlockBehaviour

proc sculkSensorBlockIds*(): seq[BlockId] =
  @[blockIdSculkSensor, blockIdCalibratedSculkSensor]

proc trigger*(world: BlockWorld, pos: BlockPos, blockRef: Block, power: uint8) =
  if (blockRef.id == blockIdSculkSensor):
    let state = world.getBlockState(pos)
    var props = SculkSensorLikeProperties.fromStateId(state.id, blockRef)
    if (props.sculkSensorPhase == SculkSensorPhase.Inactive):
      props.sculkSensorPhase = SculkSensorPhase.Active
      props.power = power
      discard world.setBlockState(pos, props.toStateId(blockRef), BfNotifyAll)
      world.updateNeighbors(pos, none[BlockDirection]())
      world.scheduleBlockTick(blockRef, pos, 30, tpNormal)
  elif (blockRef.id == blockIdCalibratedSculkSensor):
    let state1 = world.getBlockState(pos)
    var props2 = CalibratedSculkSensorLikeProperties.fromStateId(state1.id, blockRef)
    if (props2.sculkSensorPhase == SculkSensorPhase.Inactive):
      props2.sculkSensorPhase = SculkSensorPhase.Active
      props2.power = power
      discard world.setBlockState(pos, props2.toStateId(blockRef), BfNotifyAll)
      world.updateNeighbors(pos, none[BlockDirection]())
      world.scheduleBlockTick(blockRef, pos, 30, tpNormal)

proc sculkSensorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (args.block0.id == blockIdCalibratedSculkSensor):
    var props = CalibratedSculkSensorLikeProperties.defaultFor(args.block0)
    props.facing = args.player.livingEntity.entity.getHorizontalFacing()
    props.toStateId(args.block0)
  else:
    let props1 = SculkSensorLikeProperties.defaultFor(args.block0)
    props1.toStateId(args.block0)

proc sculkSensorBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc sculkSensorBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  if (args.block0.id == blockIdSculkSensor):
    let props = SculkSensorLikeProperties.fromStateId(args.state.id, args.block0)
    if (props.sculkSensorPhase == SculkSensorPhase.Active):
      props.power
    else:
      0'u8
  elif (args.block0.id == blockIdCalibratedSculkSensor):
    let props1 = CalibratedSculkSensorLikeProperties.fromStateId(args.state.id, args.block0)
    if (props1.sculkSensorPhase == SculkSensorPhase.Active):
      props1.power
    else:
      0'u8
  else:
    0'u8

proc sculkSensorBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let state = args.world.getBlockState(args.position)
  if (args.block0.id == blockIdSculkSensor):
    var props = SculkSensorLikeProperties.fromStateId(state.id, args.block0)
    case props.sculkSensorPhase
    of SculkSensorPhase.Active:
      props.sculkSensorPhase = SculkSensorPhase.Cooldown
      props.power = 0
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
      args.world.scheduleBlockTick(args.block0, args.position, 10, tpNormal)
      args.world.updateNeighbors(args.position, none[BlockDirection]())
    of SculkSensorPhase.Cooldown:
      props.sculkSensorPhase = SculkSensorPhase.Inactive
      props.power = 0
      discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
      args.world.updateNeighbors(args.position, none[BlockDirection]())
    of SculkSensorPhase.Inactive:
      discard
  elif (args.block0.id == blockIdCalibratedSculkSensor):
    var props1 = CalibratedSculkSensorLikeProperties.fromStateId(state.id, args.block0)
    case props1.sculkSensorPhase
    of SculkSensorPhase.Active:
      props1.sculkSensorPhase = SculkSensorPhase.Cooldown
      props1.power = 0
      discard args.world.setBlockState(args.position, props1.toStateId(args.block0), BfNotifyAll)
      args.world.scheduleBlockTick(args.block0, args.position, 10, tpNormal)
      args.world.updateNeighbors(args.position, none[BlockDirection]())
    of SculkSensorPhase.Cooldown:
      props1.sculkSensorPhase = SculkSensorPhase.Inactive
      props1.power = 0
      discard args.world.setBlockState(args.position, props1.toStateId(args.block0), BfNotifyAll)
      args.world.updateNeighbors(args.position, none[BlockDirection]())
    of SculkSensorPhase.Inactive:
      discard

proc newSculkSensorBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = sculkSensorBlockOnPlace_BlockBehaviour
  result.emitsRedstonePowerImpl = sculkSensorBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = sculkSensorBlockGetWeakRedstonePower_BlockBehaviour
  result.onScheduledTickImpl = sculkSensorBlockOnScheduledTick_BlockBehaviour

proc registerBlocksRedstoneSculkSensor*(r: BlockRegistry) =
  r.registerIds(sculkSensorBlockIds(), newSculkSensorBlock())

