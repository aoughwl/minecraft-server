## Port of pumpkin/src/block/blocks/redstone/tripwire.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../../blockprelude
import tripwire_hook


type
  TripwireProperties = TripwireLikeProperties
  TripwireHookProperties = TripwireHookLikeProperties
  TripwireBlock* = object



proc tripwireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs)
proc tripwireBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc tripwireBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc tripwireBlockBroken_BlockBehaviour(args: BrokenArgs)
proc tripwireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc tripwireBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc tripwireBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs)
proc newTripwireBlock*(): BlockBehaviour
proc update*(world: BlockWorld, pos: BlockPos, stateId: BlockStateId)
proc shouldConnectTo*(stateId: BlockStateId, facing: BlockDirection): bool

proc tripwireBlockOnEntityCollision_BlockBehaviour(args: OnEntityCollisionArgs) =
  var props = TripwireProperties.fromStateId(args.state.id, args.block0)
  if props.powered:
    return
  props.powered = true
  let stateId = props.toStateId(args.block0)
  discard args.world.setBlockState(args.position, stateId, BfNotifyAll)
  update(args.world, args.position, stateId)
  args.world.scheduleBlockTick(args.block0, args.position, 10, tpNormal)

proc tripwireBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var t3 = newSeq[bool]()
  for dir in [BlockDirection.North, BlockDirection.East, BlockDirection.South, BlockDirection.West]:
    let t1 = block:
      let currentPos = args.position.offset(dir.toOffset())
      let stateId = args.world.getBlockStateId(currentPos)
      shouldConnectTo(stateId, dir)
    t3.add(t1)
  let t4 = t3
  let connectNorth = t4[0]
  let connectEast = t4[1]
  let connectSouth = t4[2]
  let connectWest = t4[3]
  var props = TripwireProperties.fromStateId(args.block0.defaultState.id, args.block0)
  props.north = connectNorth
  props.south = connectSouth
  props.west = connectWest
  props.east = connectEast
  props.toStateId(args.block0)

proc tripwireBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if (Block.fromStateId(args.oldStateId) == Block.fromStateId(args.stateId)):
    return
  update(args.world, args.position, args.stateId)

proc tripwireBlockBroken_BlockBehaviour(args: BrokenArgs) =
  let t5 = block:
    let stackInHand = args.player.stackInHand0
    let mainHandItemStack = stackInHand(0)
    mainHandItemStack.getItem().registryKey == "shears"
  let hasShears = t5
  if hasShears:
    var props = TripwireProperties.fromStateId(args.state.id, args.block0)
    props.disarmed = true
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), 0'u32)

proc tripwireBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let t8 = args.direction.toHorizontalFacing()
  var t9 = args.stateId
  if t8.isSome:
    let facing = t8.unsafeGet
    let t7 = block:
      var props = TripwireProperties.fromStateId(args.stateId, args.block0)
      let connect = shouldConnectTo(args.neighborStateId, args.direction)
      case facing
      of HorizontalFacing.North:
        props.north = connect
      of HorizontalFacing.South:
        props.south = connect
      of HorizontalFacing.West:
        props.west = connect
      of HorizontalFacing.East:
        props.east = connect
      props.toStateId(args.block0)
    t9 = t7
  t9

proc tripwireBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let stateId = args.world.getBlockStateId(args.position)
  var props = TripwireProperties.fromStateId(stateId, args.block0)
  if (not props.powered):
    return
  let aabb = BoundingBox.fromBlock(args.position)
  # TODO entity.canAvoidTraps()
  if isEmpty(args.world.getEntitiesAtBox(aabb)) and isEmpty(args.world.getPlayersAtBox(aabb)):
    props.powered = false
    let stateId1 = props.toStateId(args.block0)
    discard args.world.setBlockState(args.position, stateId1, BfNotifyAll)
    update(args.world, args.position, stateId1)
  else:
    args.world.scheduleBlockTick(args.block0, args.position, 10, tpNormal)

proc tripwireBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if (args.moved or (Block.fromStateId(args.oldStateId) == args.block0)):
    return
  let stateId = args.world.getBlockStateId(args.position)
  update(args.world, args.position, stateId)

proc newTripwireBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onEntityCollisionImpl = tripwireBlockOnEntityCollision_BlockBehaviour
  result.onPlaceImpl = tripwireBlockOnPlace_BlockBehaviour
  result.placedImpl = tripwireBlockPlaced_BlockBehaviour
  result.brokenImpl = tripwireBlockBroken_BlockBehaviour
  result.getStateForNeighborUpdateImpl = tripwireBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = tripwireBlockOnScheduledTick_BlockBehaviour
  result.onStateReplacedImpl = tripwireBlockOnStateReplaced_BlockBehaviour

proc update*(world: BlockWorld, pos: BlockPos, stateId: BlockStateId) =
  for dir in [BlockDirection.South, BlockDirection.West]:
    for i in 1 ..< 42:
      let currentPos = pos.offsetDir(dir.toOffset(), int32(i))
      let (currentBlock, currentState) = world.getBlockAndStateId(currentPos)
      if (currentBlock == blockTripwireHook()):
        let currentProps = TripwireHookProperties.fromStateId(currentState, blockTripwireHook())
        if (currentProps.facing == dir.opposite().toHorizontalFacing().get()):
          update(world, currentPos, currentState, false, true, int32(i), some(stateId))
        break
      if (not (currentBlock == blockTripwire())):
        break

proc shouldConnectTo*(stateId: BlockStateId, facing: BlockDirection): bool =
  let blockRef = Block.fromStateId(stateId)
  if (blockRef == blockTripwireHook()):
    let props = TripwireHookProperties.fromStateId(stateId, blockRef)
    (some(props.facing) == toOpt(facing.opposite().toHorizontalFacing()))
  else:
    (blockRef == blockTripwire())

proc registerBlocksRedstoneTripwire*(r: BlockRegistry) =
  r.register("minecraft:tripwire", newTripwireBlock())

