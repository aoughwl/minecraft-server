proc tripwireHookBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = TripwireHookProperties.defaultFor(args.block0)
  props.powered = false
  props.attached = false
  if canPlaceAt(args.world, args.position, args.direction):
    props.facing = args.direction.opposite().toCardinalDirection()
    return props.toStateId(args.block0)
  args.block0.defaultState.id

proc tripwireHookBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let props = TripwireHookProperties.fromStateId(args.state.id, args.block0)
  canPlaceAt(args.blockAccessor, args.position, props.facing.toBlockDirection())

proc tripwireHookBlockPlayerPlaced_BlockBehaviour(args: PlayerPlacedArgs) =
  update(args.world, args.position, args.stateId, false, false, (-1), none[BlockStateId]())

proc tripwireHookBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let t2 = args.direction.toHorizontalFacing()
  var t3 = false
  if t2.isSome:
    let facing = t2.unsafeGet
    let t1 = block:
      let props = TripwireHookProperties.fromStateId(args.stateId, args.block0)
      (facing.opposite() == props.facing)
    t3 = t1
  if t3 and (not canPlaceAt(args.world, args.position, args.direction)):
    blockAir().defaultState.id
  else:
    args.stateId

proc tripwireHookBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  let stateId = args.world.getBlockStateId(args.position)
  update(args.world, args.position, stateId, false, true, (-1), none[BlockStateId]())

proc tripwireHookBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  if (args.moved or (Block.fromStateId(args.oldStateId) == args.block0)):
    return
  let props = TripwireHookProperties.fromStateId(args.oldStateId, args.block0)
  if (props.powered or props.attached):
    update(args.world, args.position, args.oldStateId, true, false, (-1), none[BlockStateId]())
  if props.powered:
    args.world.updateNeighbor(args.position, args.block0)
    args.world.updateNeighbor(args.position.offset(props.facing.opposite().toOffset()), args.block0)

proc tripwireHookBlockEmitsRedstonePower_BlockBehaviour(args: EmitsRedstonePowerArgs): bool =
  true

proc tripwireHookBlockGetWeakRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = TripwireHookProperties.fromStateId(args.state.id, args.block0)
  if props.powered:
    15'u8
  else:
    0'u8

proc tripwireHookBlockGetStrongRedstonePower_BlockBehaviour(args: GetRedstonePowerArgs): uint8 =
  let props = TripwireHookProperties.fromStateId(args.state.id, args.block0)
  var t6 = false
  if props.powered:
    let t4 = args.direction.toHorizontalFacing()
    var t5 = false
    if t4.isSome:
      let facing = t4.unsafeGet
      t5 = (props.facing == facing)
    t6 = t5
  if t6:
    15'u8
  else:
    0'u8

proc newTripwireHookBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = tripwireHookBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = tripwireHookBlockCanPlaceAt_BlockBehaviour
  result.playerPlacedImpl = tripwireHookBlockPlayerPlaced_BlockBehaviour
  result.getStateForNeighborUpdateImpl = tripwireHookBlockGetStateForNeighborUpdate_BlockBehaviour
  result.onScheduledTickImpl = tripwireHookBlockOnScheduledTick_BlockBehaviour
  result.onStateReplacedImpl = tripwireHookBlockOnStateReplaced_BlockBehaviour
  result.emitsRedstonePowerImpl = tripwireHookBlockEmitsRedstonePower_BlockBehaviour
  result.getWeakRedstonePowerImpl = tripwireHookBlockGetWeakRedstonePower_BlockBehaviour
  result.getStrongRedstonePowerImpl = tripwireHookBlockGetStrongRedstonePower_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, face: BlockDirection): bool =
  if (not face.isHorizontal()):
    return false
  let placeBlockPos = blockPos.offset(face.toOffset())
  let placeBlockState = world.getBlockState(placeBlockPos)
  placeBlockState.isSideSolid(face)

proc update*(world: BlockWorld, startHookPos: BlockPos, startHookStateId: BlockStateId, skipStateUpdate: bool, notifyNeighbors: bool, rawWireIndex: int32, rawWireState: Option[BlockStateId]) =
  let startHookProps = TripwireHookProperties.fromStateId(startHookStateId, blockTripwireHook())
  var canAttach = (not skipStateUpdate)
  var wireAttached = false
  var j = 0
  var wiresProps: seq[Option[TripwireProperties]] = newSeq[Option[TripwireProperties]](42)
  for k in 1 ..< 42:
    let currentPos = startHookPos.offsetDir(startHookProps.facing.toOffset(), int32(k))
    let currentBlock = world.getBlock(currentPos)
    if (currentBlock == blockTripwireHook()):
      let t7 = block:
        let stateId = world.getBlockStateId(currentPos)
        TripwireHookProperties.fromStateId(stateId, blockTripwireHook())
      let currentHookProps = t7
      if (currentHookProps.facing == startHookProps.facing.opposite()):
        j = k
      break
    if ((currentBlock == blockTripwire()) or (k == rawWireIndex)):
      let t8 = block:
        let roStateId = world.getBlockStateId(currentPos)
        let t9 = block:
          if (k == rawWireIndex):
            rawWireState.get(roStateId)
          else:
            roStateId
        let stateId1 = t9
        TripwireProperties.fromStateId(stateId1, blockTripwire())
      let currentWireProps = t8
      wireAttached = wireAttached or (((not currentWireProps.disarmed)) and currentWireProps.powered)
      wiresProps[int(k)] = some(currentWireProps)
      if (k == rawWireIndex):
        world.scheduleBlockTick(blockTripwireHook(), startHookPos, 10, tpNormal)
        canAttach = canAttach and (not currentWireProps.disarmed)
    else:
      wiresProps[int(k)] = none[TripwireProperties]()
      canAttach = false
  let futureAttached = (canAttach and ((j > 1)))
  let futurePowered = (wireAttached and futureAttached)
  var futureHookState = TripwireHookProperties.defaultFor(blockTripwireHook())
  futureHookState.attached = futureAttached
  futureHookState.powered = futurePowered
  if (j > 0):
    let endHookPos = startHookPos.offsetDir(startHookProps.facing.toOffset(), int32(j))
    let futureHookFacing = startHookProps.facing.opposite()
    var futureEndHookState = futureHookState
    futureEndHookState.facing = futureHookFacing
    discard world.setBlockState(endHookPos, futureEndHookState.toStateId(blockTripwireHook()), BfNotifyAll)
    updateNeighborsOnAxis(blockTripwireHook(), world, endHookPos, BlockDirection.fromCardinalDirection(futureHookFacing))
    playSound(world, endHookPos, futureAttached, futurePowered, startHookProps.attached, startHookProps.powered)
  playSound(world, startHookPos, futureAttached, futurePowered, startHookProps.attached, startHookProps.powered)
  if (not skipStateUpdate):
    var futureStartHookState = futureHookState
    futureStartHookState.facing = startHookProps.facing
    discard world.setBlockState(startHookPos, futureStartHookState.toStateId(blockTripwireHook()), BfNotifyAll)
    if notifyNeighbors:
      updateNeighborsOnAxis(blockTripwireHook(), world, startHookPos, BlockDirection.fromCardinalDirection(startHookProps.facing))
  if (not (startHookProps.attached == futureAttached)):
    for l in 1 ..< j:
      let currentWriePos = startHookPos.offsetDir(startHookProps.facing.toOffset(), int32(l))
      let t10 = wiresProps[int(l)]
      if t10.isSome:
        var lv8 = t10.unsafeGet
        lv8.attached = futureAttached
        discard world.setBlockState(currentWriePos, lv8.toStateId(blockTripwire()), BfNotifyAll)

proc playSound*(world: BlockWorld, blockPos: BlockPos, attached: bool, on: bool, detached: bool, off: bool) =
  let cat = scBlocks
  let pos = blockPos.toF64()
  if on and (not off):
    world.playSoundRaw(uint16(sdBlockTripwireClickOn), cat, pos, 0.4, 0.6)
  else:
    if (not on) and off:
      world.playSoundRaw(uint16(sdBlockTripwireClickOff), cat, pos, 0.4, 0.5)
    else:
      if attached and (not detached):
        world.playSoundRaw(uint16(sdBlockTripwireAttach), cat, pos, 0.4, 0.7)
      else:
        if (not attached) and detached:
          let pitch = (1.2 / randomOf(float32).mulAdd(0.2, 0.9))
          world.playSoundRaw(uint16(sdBlockTripwireDetach), cat, pos, 0.4, pitch)

proc updateNeighborsOnAxis*(blockRef: Block, world: BlockWorld, blockPos: BlockPos, direction: BlockDirection) =
  world.updateNeighbor(blockPos, blockRef)
  world.updateNeighbors(blockPos.offset(direction.opposite().toOffset()), some(direction))

proc registerBlocksRedstoneTripwireHook*(r: BlockRegistry) =
  r.register("minecraft:tripwire_hook", newTripwireHookBlock())

