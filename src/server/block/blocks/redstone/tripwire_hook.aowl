import ../../blockprelude


type
  TripwireProperties = TripwireLikeProperties
  TripwireHookProperties = TripwireHookLikeProperties
  TripwireHookBlock* = object



proc tripwireHookBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc tripwireHookBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc tripwireHookBlockPlayerPlaced_BlockBehaviour(args: PlayerPlacedArgs)
proc tripwireHookBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc tripwireHookBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
