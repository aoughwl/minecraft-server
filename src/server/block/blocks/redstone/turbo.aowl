import ../../blockprelude
import redstonemod

const NORTH*: int = 0
const EAST*: int = 1
const SOUTH*: int = 2
const WEST*: int = 3
const REORDERING*: array[4, array[24, int]] = [[2, 3, 16, 19, 0, 4, 1, 5, 7, 8, 17, 20, 12, 13, 18, 21, 6, 9, 22, 14, 11, 10, 23, 15], [2, 3, 16, 19, 4, 1, 5, 0, 17, 20, 12, 13, 18, 21, 7, 8, 22, 14, 11, 15, 23, 9, 6, 10], [2, 3, 16, 19, 1, 5, 0, 4, 12, 13, 18, 21, 7, 8, 17, 20, 11, 15, 23, 10, 6, 14, 22, 9], [2, 3, 16, 19, 5, 0, 4, 1, 18, 21, 7, 8, 17, 20, 12, 13, 23, 10, 6, 9, 22, 15, 11, 14]]
const RS_NEIGHBORS*: array[4, int] = [4, 5, 6, 7]
const RS_NEIGHBORS_UP*: array[4, int] = [9, 11, 13, 15]
const RS_NEIGHBORS_DN*: array[4, int] = [8, 10, 12, 14]

type
  RedstoneWireProps = RedstoneWireLikeProperties
  NodeId* = object
    index*: int
  UpdateNode* = ref object
    pos*: BlockPos
    state*: BlockState
    neighbors*: Option[seq[NodeId]]
    visited*: bool
    xbias*: int32
    zbias*: int32
    layer*: uint32
  RedstoneWireTurbo* = ref object
    nodes*: seq[UpdateNode]
    nodeCache*: Table[int64, NodeId]
    updateQueue*: seq[seq[NodeId]]
    currentWalkLayer*: uint32



proc unwrapWire*(state: BlockState): RedstoneWireProps
proc newUpdateNode*(world: BlockWorld, pos: BlockPos): UpdateNode
proc newRedstoneWireTurbo*(): RedstoneWireTurbo
proc getNode*(self: RedstoneWireTurbo, nodeId: NodeId): UpdateNode
proc computeAllNeighbors*(pos: BlockPos): array[24, BlockPos]
proc computeHeading*(rx: int32, rz: int32): int
proc identifyNeighbors*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId)
proc orientNeighbors*(self: RedstoneWireTurbo, src: seq[NodeId], dstId: NodeId, heading: int)
proc updateSurroundingNeighbors*(world: BlockWorld, pos: BlockPos)
proc propagateChanges*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId, layer: uint32)
proc breadthFirstWalk*(self: RedstoneWireTurbo, world: BlockWorld)
proc shiftQueue*(self: RedstoneWireTurbo)
proc updateNode*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId, layer: uint32)
proc calculateCurrentChanges*(self: RedstoneWireTurbo, world: BlockWorld, upd: NodeId): RedstoneWireProps
proc getMaxCurrentStrength*(self: RedstoneWireTurbo, upd: NodeId, strength: uint8): uint8

proc unwrapWire*(state: BlockState): RedstoneWireProps =
  RedstoneWireProps.fromStateId(state.id, blockRedstoneWire())

proc newUpdateNode*(world: BlockWorld, pos: BlockPos): UpdateNode =
  UpdateNode(pos: pos, state: world.getBlockState(pos), visited: false, xbias: 0, zbias: 0, layer: 0)

proc newRedstoneWireTurbo*(): RedstoneWireTurbo =
  RedstoneWireTurbo(nodes: @[], nodeCache: initTable[int64, NodeId](), updateQueue: @[newSeq[NodeId](), newSeq[NodeId](), newSeq[NodeId]()], currentWalkLayer: 0)

proc getNode*(self: RedstoneWireTurbo, nodeId: NodeId): UpdateNode =
  self.nodes[nodeId.index]

proc computeAllNeighbors*(pos: BlockPos): array[24, BlockPos] =
  let t1 = pos.vec
  let x = t1.x
  let y = t1.y
  let z = t1.z
  [newBlockPos((x - 1), y, z), newBlockPos((x + 1), y, z), newBlockPos(x, (y - 1), z), newBlockPos(x, (y + 1), z), newBlockPos(x, y, (z - 1)), newBlockPos(x, y, (z + 1)), newBlockPos((x - 2), y, z), newBlockPos((x - 1), (y - 1), z), newBlockPos((x - 1), (y + 1), z), newBlockPos((x - 1), y, (z - 1)), newBlockPos((x - 1), y, (z + 1)), newBlockPos((x + 2), y, z), newBlockPos((x + 1), (y - 1), z), newBlockPos((x + 1), (y + 1), z), newBlockPos((x + 1), y, (z - 1)), newBlockPos((x + 1), y, (z + 1)), newBlockPos(x, (y - 2), z), newBlockPos(x, (y - 1), (z - 1)), newBlockPos(x, (y - 1), (z + 1)), newBlockPos(x, (y + 2), z), newBlockPos(x, (y + 1), (z - 1)), newBlockPos(x, (y + 1), (z + 1)), newBlockPos(x, y, (z - 2)), newBlockPos(x, y, (z + 2))]

proc computeHeading*(rx: int32, rz: int32): int =
  let code = (((rx + 1)) + (3 * ((rz + 1))))
  case code
  of 0, 1:
    NORTH
  of 2, 5:
    EAST
  of 3, 4:
    WEST
  of 6 .. 8:
    SOUTH
  else:
    discard
    NORTH

proc identifyNeighbors*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId) =
  let pos = self.nodes[upd1.index].pos
  let neighbors = computeAllNeighbors(pos)
  var neighborsVisited: seq[bool] = @[]
  var neighborNodes: seq[NodeId] = @[]
  for neighborPos in neighbors:
    let t2 = block:
      if self.nodeCache.hasKey(neighborPos.asLong()):
        self.nodeCache.getOrDefault(neighborPos.asLong())
      else:
        let nodeId = NodeId(index: len(self.nodes))
        self.nodeCache[neighborPos.asLong()] = nodeId
        self.nodes.add(newUpdateNode(world, neighborPos))
        nodeId
    let neighbor = t2
    let node = self.nodes[neighbor.index]
    # if let Block::RedstoneWire { .. } = node.state {
    # if RedstoneWireTurbo::UPDATE_REDSTONE[i] {
    neighborNodes.add(neighbor)
    neighborsVisited.add(node.visited)
  let fromWest = ((neighborsVisited[0] or neighborsVisited[7]) or neighborsVisited[8])
  let fromEast = ((neighborsVisited[1] or neighborsVisited[12]) or neighborsVisited[13])
  let fromNorth = ((neighborsVisited[4] or neighborsVisited[17]) or neighborsVisited[20])
  let fromSouth = ((neighborsVisited[5] or neighborsVisited[18]) or neighborsVisited[21])
  var cx = 0'i32
  var cz = 0'i32
  if fromWest:
    cx += 1
  if fromEast:
    cx -= 1
  if fromNorth:
    cz += 1
  if fromSouth:
    cz -= 1
  let t3 = self.nodes[upd1.index]
  let xbias = t3.xbias
  let zbias = t3.zbias
  let xbias1 = xbias
  let zbias2 = zbias
  var heading: int
  if (cx == 0) and (cz == 0):
    heading = computeHeading(xbias1, zbias2)
    for nodeId in neighborNodes:
      # if let Some(node_id) = node_id {
      let nn = self.nodes[nodeId.index]
      nn.xbias = xbias1
      nn.zbias = zbias2
  else:
    if (not (cx == 0)) and (not (cz == 0)):
      if (not (xbias1 == 0)):
        cz = 0
      if (not (zbias2 == 0)):
        cx = 0
    heading = computeHeading(cx, cz)
    for nodeId in neighborNodes:
      # if let Some(node_id) = node_id {
      let nn3 = self.nodes[nodeId.index]
      nn3.xbias = cx
      nn3.zbias = cz
  self.orientNeighbors(neighborNodes, upd1, heading)

proc orientNeighbors*(self: RedstoneWireTurbo, src: seq[NodeId], dstId: NodeId, heading: int) =
  let dst = self.nodes[dstId.index]
  var neighbors: seq[NodeId] = @[]
  let re = REORDERING[heading]
  for i in re:
    neighbors.add(src[i])
  dst.neighbors = some(neighbors)

proc updateSurroundingNeighbors*(world: BlockWorld, pos: BlockPos) =
  var turbo = newRedstoneWireTurbo()
  var rootNode = newUpdateNode(world, pos)
  rootNode.visited = true
  let nodeId = NodeId(index: 0)
  turbo.nodeCache[pos.asLong()] = nodeId
  turbo.nodes.add(rootNode)
  turbo.propagateChanges(world, nodeId, 0)
  turbo.breadthFirstWalk(world)

proc propagateChanges*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId, layer: uint32) =
  if self.nodes[upd1.index].neighbors.isNone():
    self.identifyNeighbors(world, upd1)
  let neighbors = self.nodes[upd1.index].neighbors.get()
  let layer1 = (layer + 1)
  for neighborId in neighbors:
    let neighbor = self.nodes[neighborId.index]
    if (layer1 > neighbor.layer):
      neighbor.layer = layer1
      self.updateQueue[1].add(neighborId)
  let layer2 = (layer + 2)
  for q in 0 ..< 4:
    let neighborId = neighbors[q]
    let neighbor1 = self.nodes[neighborId.index]
    if (layer2 > neighbor1.layer):
      neighbor1.layer = layer2
      self.updateQueue[2].add(neighborId)

proc breadthFirstWalk*(self: RedstoneWireTurbo, world: BlockWorld) =
  self.shiftQueue()
  self.currentWalkLayer = 1
  while ((not isEmpty(self.updateQueue[0])) or (not isEmpty(self.updateQueue[1]))):
    var currentQueue = self.updateQueue.remove(0)
    self.updateQueue.add(@[])
    for nodeId in currentQueue:
      let blockRef = Block.fromStateId(self.nodes[nodeId.index].state.id)
      if (blockRef == blockRedstoneWire()):
        self.updateNode(world, nodeId, self.currentWalkLayer)
      else:
        # This only works because updating any other block than a wire will
        # never change the state of the block. If that changes in the future,
        # the cached state will need to be updated
        world.updateNeighbor(self.nodes[nodeId.index].pos, blockRef)
    currentQueue.clear()
    let lastIdx = (len(self.updateQueue) - 1)
    self.updateQueue[lastIdx] = currentQueue
    self.currentWalkLayer += 1
  self.currentWalkLayer = 0

proc shiftQueue*(self: RedstoneWireTurbo) =
  var t = self.updateQueue.remove(0)
  t.clear()
  self.updateQueue.add(t)

proc updateNode*(self: RedstoneWireTurbo, world: BlockWorld, upd1: NodeId, layer: uint32) =
  let t4 = block:
    let node = self.nodes[upd1.index]
    node.visited = true
    unwrapWire(node.state)
  let oldWire = t4
  let newWire = self.calculateCurrentChanges(world, upd1)
  if (not (oldWire.power == newWire.power)):
    let node1 = self.nodes[upd1.index]
    var wire = unwrapWire(node1.state)
    wire.power = newWire.power
    node1.state = BlockState.fromId(wire.toStateId(blockRedstoneWire()))
    self.propagateChanges(world, upd1, layer)

proc calculateCurrentChanges*(self: RedstoneWireTurbo, world: BlockWorld, upd: NodeId): RedstoneWireProps =
  var wire = unwrapWire(self.nodes[upd.index].state)
  let i = wire.power
  var blockPower = 0'u8
  if self.nodes[upd.index].neighbors.isNone():
    self.identifyNeighbors(world, upd)
  let pos = self.nodes[upd.index].pos
  var wirePower = 0'u8
  let t5 = blockDirectionAll()
  for side in t5:
    let neighborPos = pos.offset(side.toOffset())
    let neighbor = self.nodes[self.nodeCache.getOrDefault(neighborPos.asLong()).index].state
    wirePower = wirePower.max(getRedstonePowerNoDust(Block.fromStateId(neighbor.id), neighbor, world, neighborPos, side))
  if (wirePower < 15):
    let neighbors = self.nodes[upd.index].neighbors.get()
    let centerUp = self.nodes[neighbors[1].index].state
    for m in 0 ..< 4:
      let n = RS_NEIGHBORS[m]
      let neighborId = neighbors[n]
      let neighbor1 = self.getNode(neighborId).state
      blockPower = self.getMaxCurrentStrength(neighborId, blockPower)
      if (not neighbor1.isSolidBlock()):
        let neighborDown = neighbors[RS_NEIGHBORS_DN[m]]
        blockPower = self.getMaxCurrentStrength(neighborDown, blockPower)
      else:
        if (not centerUp.isSolidBlock()) and neighbor1.isSolidBlock():
          let neighborUp = neighbors[RS_NEIGHBORS_UP[m]]
          blockPower = self.getMaxCurrentStrength(neighborUp, blockPower)
  var j = saturatingSub(blockPower, 1)
  if (wirePower > j):
    j = wirePower
  if (not (i == j)):
    wire.power = j
    discard world.setBlockState(pos, wire.toStateId(blockRedstoneWire()), 0'u32)
  wire

proc getMaxCurrentStrength*(self: RedstoneWireTurbo, upd: NodeId, strength: uint8): uint8 =
  let node = self.nodes[upd.index]
  let blockRef = Block.fromStateId(node.state.id)
  if (blockRef == blockRedstoneWire()):
    unwrapWire(node.state).power.max(strength)
  else:
    strength

