## Port of pumpkin/src/block/blocks/shelf.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/shelf


type
  ShelfBlock* = object



proc shelfBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var properties = AcaciaShelfLikeProperties.defaultFor(args.block0)
  # Face in the opposite direction the player is facing
  properties.facing = args.player.getEntity().getHorizontalFacing().opposite()
  properties.toStateId(args.block0)

proc shelfBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newShelfBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc newShelfBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = shelfBlockOnPlace_BlockBehaviour
  result.placedImpl = shelfBlockPlaced_BlockBehaviour

proc registerBlocksShelf*(r: BlockRegistry) =
  r.registerTag("minecraft:wooden_shelves", newShelfBlock())

