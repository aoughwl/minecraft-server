## Port of pumpkin/src/block/blocks/shulker_box.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/genericcontainer
import ../entities/shulker_box

const OPEN_ANIMATION_EVENT_TYPE: uint8 = 1

proc shulkerBoxScreenFactory(inventory: Inventory): BlockScreenFactory =
  ## `ShulkerBoxScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_SHULKERBOX, BEDROCK_CONTAINER_SHULKERBOX),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(createGeneric9x3(syncId, playerInventory, inventory)))

proc shulkerBoxBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = EndRodLikeProperties.defaultFor(args.block0)
  props.facing = args.direction.toFacing().opposite()
  props.toStateId(args.block0)

proc shulkerBoxBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool =
  # On the server, we don't need the Animation steps for now, because the client is responsible for that.
  # TODO: Do not open the shulker box when it is currently closing
  (args.kind0 == OPEN_ANIMATION_EVENT_TYPE)

proc shulkerBoxBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newShulkerBoxBlockEntity(args.position))

proc shulkerBoxBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barSuccess
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barSuccess
  args.player.incrementStat(scCustom, int32(csOpenShulkerBox), 1)
  args.player.openHandledScreen(shulkerBoxScreenFactory(inventory.unsafeGet), some(args.position))
  barSuccess

proc shulkerBoxBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return none[uint8]()
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return none[uint8]()
  some(calculateComparatorOutput(inventory.unsafeGet))

proc newShulkerBoxBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = shulkerBoxBlockOnPlace_BlockBehaviour
  result.onSyncedBlockEventImpl = shulkerBoxBlockOnSyncedBlockEvent_BlockBehaviour
  result.placedImpl = shulkerBoxBlockPlaced_BlockBehaviour
  result.normalUseImpl = shulkerBoxBlockNormalUse_BlockBehaviour
  result.getComparatorOutputImpl = shulkerBoxBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksShulkerBox*(r: BlockRegistry) =
  r.registerTag("minecraft:shulker_boxes", newShulkerBoxBlock())
