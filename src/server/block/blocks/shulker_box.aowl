import ../blockprelude
import ../entities/shulker_box

const OPEN_ANIMATION_EVENT_TYPE*: uint8 = 1

type
  ShulkerBoxScreenFactory* = R2A_MANUAL_tuple_struct
  ShulkerBoxBlock* = object



proc createScreenHandler*(self: ShulkerBoxScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: ShulkerBoxScreenFactory): TextComponent
proc shulkerBoxBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc shulkerBoxBlockOnSyncedBlockEvent_BlockBehaviour(args: OnSyncedBlockEventArgs): bool
proc shulkerBoxBlockPlaced_BlockBehaviour(args: PlacedArgs)
