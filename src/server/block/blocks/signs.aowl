proc getSignVariant*(base: Block, isHanging: bool): BlockId =
  let baseName = base.name
  let woodType = baseName.stripSuffix("_hanging_sign").orElse(R2A_MANUAL("closure |_| baseName.stripSuffix('_sign')")).get("oak")
  let t58 = block:
    if isHanging:
      # This is the variant that provides the "horizontal wooden post"
      rustFormat("{wood_type}_wall_hanging_sign")
    else:
      rustFormat("{wood_type}_wall_sign")
  let targetName = t58
  let t59 = Block.fromName(targetName)
  var t60 = base.id
  if t59.isSome:
    let b = t59.unsafeGet
    t60 = b.id
  t60

proc isFacingFrontText*(world: BlockWorld, location: BlockPos, blockRef: Block, player: BlockPlayer): bool =
  let stateId = world.getBlockStateId(location)
  # Read properties dynamically: some sign types use a `rotation` property (0..15),
  # others (wall signs) use a `facing` property (north/south/west/east),
  # hanging signs may have `rotation` + `attached`.
  var rotation: float32 = 0.0
  let t61 = blockRef.properties(stateId)
  if t61.isSome:
    let props = t61.unsafeGet
    let propMap = t61.unsafeGet.toProps()
    let t64 = propMap.find(R2A_MANUAL("closure |(k, _)| (k == 'rotation')"))
    if t64.isSome:
      let val = t64.unsafeGet[1]
      let r = t64.unsafeGet[1].parse().get(0)
      rotation = getYawFromRotation16(r)
    else:
      let t70 = propMap.find(R2A_MANUAL("closure |(k, _)| (k == 'facing')"))
      if t70.isSome:
        let val = t70.unsafeGet[1]
        let t71 = block:
          case t70.unsafeGet[1][R2A_MANUAL("open range")]
          of "north":
            180.0
          of "west":
            90.0
          of "east":
            (-90.0)
          else:
            0.0
        rotation = t71
  let boundingBox = newVector3(0.5, 0.5, 0.5)
  let d = (player.eyePosition().x - ((float64(location.vec.x) + boundingBox.x)))
  let d1 = (player.eyePosition().z - ((float64(location.vec.z) + boundingBox.z)))
  let f = ((float32(d1.atan2(d).toDegrees())) - 90.0)
  let diff = (floorMod((((f - rotation) + 180.0)), 360.0) - 180.0)
  (abs(diff) <= 90.0)

proc getYawFromRotation16*(rotation: uint8): float32 =
  (float32(rotation) * 22.5)

proc tryClaimSign*(currentlyEditing: Option[Uuid], uuid: Uuid, world: BlockWorld, position: BlockPos): bool =
  block chain74:
    let t72 = currentlyEditing
    if t72.isSome:
      let editingPlayerId = t72.unsafeGet
      if (not (t72.unsafeGet == uuid)):
        let t73 = world.getPlayerByUuid(t72.unsafeGet)
        if t73.isSome:
          let editingPlayer = t73.unsafeGet
          if t73.unsafeGet.canInteractWithBlockAt(position, 4.0'f64):
            return false
  currentlyEditing = some(uuid)
  true

