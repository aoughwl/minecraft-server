proc signBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let isHanging = contains(args.block0.name, "hanging")
  let clickedFace = args.useItemOn.andThen(R2A_MANUAL("closure |u| BlockDirection.tryFrom(u.face[0]).ok()")).get(BlockDirection.Up)
  # Detection for floor-to-wall attachment (broken rn)
