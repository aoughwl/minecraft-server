proc isValidSupport*(world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool =
  let (blockRef, state) = world.getBlockAndState(pos)
  let isPermissive = (blockRef.hasTag(Block_MINECRAFT_LEAVES) or blockRef.hasTag(Block_MINECRAFT_SIGNS))
  case direction
  of BlockDirection.Up:
    (state.isSideSolid(BlockDirection.Down) or isPermissive)
  of BlockDirection.Down:
    (state.isCenterSolid(BlockDirection.Up) or isPermissive)
  else:
    (state.isSideSolid(direction.opposite()) or isPermissive)

proc detectSupport*(world: BlockWorld, position: BlockPos): SupportInfo =
  let (blockAbove, stateAbove) = world.getBlockAndState(position.up())
  let aboveIsValid = ((stateAbove.isSideSolid(BlockDirection.Down) or blockAbove.hasTag(Block_MINECRAFT_SIGNS)) or blockAbove.hasTag(Block_MINECRAFT_LEAVES))
  var sideDirection = R2A_NONE
  let t1 = blockDirectionHorizontal()
  for direction in t1:
    let pos = position.offset(direction.toOffset())
    if isValidSupport(world, pos, direction.opposite().toBlockDirection()):
      sideDirection = some(direction)
      break
  SupportInfo(aboveIsValid: aboveIsValid, sideDirection: sideDirection.map(R2A_MANUAL("closure |d| d.toBlockDirection()")))

proc calculateWallHangingFacing*(wallDir: BlockDirection, playerYaw: float32): string =
  case wallDir
  of BlockDirection.North, BlockDirection.South:
    # Wall runs North-South, sign faces East or West
    if ((((playerYaw + 360.0)) mod 360.0) < 180.0):
      "east"
    else:
      "west"
  of BlockDirection.East, BlockDirection.West:
    # Wall runs East-West, sign faces North or South
    if contains(((-270.0) .. 270.0), playerYaw):
      "south"
    else:
      "north"
  else:
    wallDir.opposite().toCardinalDirection().toValue()

proc calculateWallHangingRotation*(wallDir: BlockDirection, playerRot: uint8, isSneaking: bool): uint8 =
  if isSneaking:
    return playerRot
  case wallDir
  of BlockDirection.North, BlockDirection.South:
    # Snap to North-South axis (0 or 8)
    if contains((4 ..< 12), playerRot):
      8'u8
    else:
      0'u8
  of BlockDirection.East, BlockDirection.West:
    # Snap to East-West axis (4 or 12)
    if contains((2 ..< 10), playerRot):
      4'u8
    else:
      12'u8
  else:
    playerRot

proc determinePlacement*(args: OnPlaceArgs, support: SupportInfo): Option[SignPlacement] =
  let isHanging = contains(args.block0.name, "hanging")
  let isSneaking = args.player.getEntity().isSneaking()
  # Select block variant
  let t4 = block:
    if isHanging:
      let t5 = selectHangingVariant(args, support)
      if t5.isNone: return none[SignPlacement]()
      t5.unsafeGet
    else:
      selectStandingVariant(args, support)
  let blockId = t4
  let actualBlock = Block.fromId(blockId)
  let isWallHanging = (isHanging and contains(actualBlock.name, "wall_hanging"))
  # Calculate orientation
  let t6 = block:
    if isWallHanging:
      calculateWallHangingOrientation(args, support, isSneaking)
    elif isHanging:
      calculateCeilingOrientation(args, isSneaking)
    elif contains(actualBlock.name, "wall"):
      calculateWallOrientation(args)
    else:
      calculateStandingOrientation(args)
  let (facing, rotation, attached) = t6
  some(SignPlacement(blockId: blockId, facing: facing, rotation: rotation, attached: attached))

proc selectHangingVariant*(args: OnPlaceArgs, support: SupportInfo): Option[BlockId] =
  if (args.direction == BlockDirection.Down) and support.aboveIsValid:
    some(args.block0.id)
  else:
    if ((args.direction.isHorizontal() or (args.direction == BlockDirection.Up))) and support.sideDirection.isSome():
      some(getSignVariant(args.block0, true))
    elif support.aboveIsValid:
      some(args.block0.id)
    else:
      none[BlockId]()

proc selectStandingVariant*(args: OnPlaceArgs, support: SupportInfo): BlockId =
  if args.direction.isHorizontal() and support.sideDirection.isSome():
    getSignVariant(args.block0, false)
  else:
    args.block0.id

proc calculateWallHangingOrientation*(args: OnPlaceArgs, support: SupportInfo, isSneaking: bool): (Option[string], Option[uint8], bool) =
  let t7 = block:
    if args.direction.isHorizontal():
      args.direction
    else:
      support.sideDirection.get(args.direction)
  let wallDir = t7
  let playerYaw = args.player.getEntity().yaw
  let facing = calculateWallHangingFacing(wallDir, playerYaw)
  let playerRot = args.player.getEntity().getFlippedRotation16()
  let rotation = calculateWallHangingRotation(wallDir, playerRot, isSneaking)
  let isAngled = (not ((rotation mod 4) == 0))
  let attached = (isAngled or isSneaking)
  (some($(facing)), some(rotation), attached)

proc calculateCeilingOrientation*(args: OnPlaceArgs, isSneaking: bool): (Option[string], Option[uint8], bool) =
  let t8 = block:
    if isSneaking:
      args.player.getEntity().getFlippedRotation16()
    else:
      # Snap to nearest cardinal
      let index = args.player.getEntity().getFlippedRotation16()
      ((((((index + 2)) / 4) * 4)) mod 16)
  let rotation = t8
  let isAngled = (not ((rotation mod 4) == 0))
  let attached = (isAngled or isSneaking)
  (R2A_NONE, some(rotation), attached)

proc calculateWallOrientation*(args: OnPlaceArgs): (Option[string], Option[uint8], bool) =
  let facing = args.direction.opposite().toCardinalDirection().toValue()
  (some($(facing)), R2A_NONE, false)

proc calculateStandingOrientation*(args: OnPlaceArgs): (Option[string], Option[uint8], bool) =
  let rotation = args.player.getEntity().getFlippedRotation16()
  (R2A_NONE, some(rotation), false)

