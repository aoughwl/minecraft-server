proc signBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let isHanging = contains(args.block0.name, "hanging")
  let isWallSign = contains(args.block0.name, "wall")
  # Determine the expected support direction
  let t31 = block:
    if isWallSign:
      # Look up the 'facing' property to find the support behind the wall sign
      getWallSupportDirection(args.block0, args.stateId)
    elif isHanging:
      # Ceiling-hanging signs always look Up
      some(BlockDirection.Up)
    else:
      # Standing signs always look Down
      some(BlockDirection.Down)
  let supportDir = t31
  let t32 = block:
    let t33 = supportDir
    if t33.isSome:
      let dir = t33.unsafeGet
      # Only check if the neighbor that changed is our support neighbor
      if (args.direction == t33.unsafeGet):
        let supportPos = args.position.offset(t33.unsafeGet.toOffset())
        let (supportBlock, supportState) = args.world.getBlockAndState(supportPos)
        # Permissive support check
        let isLeaf = supportBlock.hasTag(Block_MINECRAFT_LEAVES)
        let isSign = supportBlock.hasTag(Block_MINECRAFT_SIGNS)
        let t34 = block:
          case t33.unsafeGet
          of BlockDirection.Up:
            ((supportState.isSideSolid(BlockDirection.Down) or isLeaf) or isSign)
          of BlockDirection.Down:
            ((supportState.isCenterSolid(BlockDirection.Up) or isLeaf) or isSign)
          else:
            ((supportState.isSideSolid(t33.unsafeGet.opposite()) or isLeaf) or isSign)
        let isValid = t34
        if (not isValid):
          return blockStateIdAir
    args.stateId
  t32

proc signBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let t35 = args.world.getBlockEntity(args.position)
  if not (t35.isSome):
    return barPass
  let blockEntity = t35.unsafeGet
  let t36 = asType(blockEntity, SignBlockEntity)
  if not (t36.isSome):
    return barPass
  let signEntity = t36.unsafeGet
  if signEntity.isWaxed:
    args.world.playBlockSound(sdBlockSignWaxedInteractFail, scBlocks, args.position)
    return barSuccessServer
  if (not tryClaimSign(signEntity.currentlyEditingPlayer, args.player.gameprofile.id, args.world, args.position)):
    return barPass
  let isFacingFrontText = isFacingFrontText(args.world, args.position, args.block0, args.player)
  if args.player.client.kind == ClientPlatformKind.kJava:
    let java = args.player.client.f0Java
    args.player.client.f0Java.sendSignPacket(args.position, isFacingFrontText)
  elif args.player.client.kind == ClientPlatformKind.kBedrock:
    let bedrock = args.player.client.f0Bedrock
    discard
  else:
    rustPanic("non-exhaustive")
  barSuccessServer

