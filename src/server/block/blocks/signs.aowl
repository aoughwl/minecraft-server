    let t29 = blockDirectionHorizontal()
    for d in t29:
      let wallPos = args.position.offset(d.toOffset())
      let (blockRef, state) = args.blockAccessor.getBlockAndState(wallPos)
      if (state.isSideSolid(d.opposite().toBlockDirection()) or (blockRef.hasTag(Block_MINECRAFT_LEAVES) or blockRef.hasTag(Block_MINECRAFT_SIGNS))):
        return true
  # Standard support validation with permissive tags
  let t30 = block:
    case clickedFace
    of BlockDirection.Up:
      args.position.down()
    of BlockDirection.Down:
      args.position.up()
    else:
      args.position.offset(clickedFace.opposite().toOffset())
  let supportPos = t30
  let (blockRef1, state2) = args.blockAccessor.getBlockAndState(supportPos)
  let isPermissive = (blockRef1.hasTag(Block_MINECRAFT_LEAVES) or blockRef1.hasTag(Block_MINECRAFT_SIGNS))
  case clickedFace
  of BlockDirection.Up:
    ((not isHanging) and ((state2.isCenterSolid(BlockDirection.Up) or isPermissive)))
  of BlockDirection.Down:
    (isHanging and ((state2.isSideSolid(BlockDirection.Down) or isPermissive)))
  else:
    (state2.isSideSolid(clickedFace.opposite()) or isPermissive)

proc signBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
