proc signBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let support = detectSupport(args.world, args.position)
  let t26 = determinePlacement(args, support)
  if not (t26.isSome):
    return blockStateIdAir
  let placement = t26.unsafeGet
  let actualBlock = Block.fromId(placement.blockId)
  applyPlacementProperties(actualBlock, placement)

