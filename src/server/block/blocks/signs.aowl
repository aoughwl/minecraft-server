## Port of pumpkin/src/block/blocks/signs.rs
## `apply_to_sign` of the dye, ink sac, glow ink sac and honeycomb items is src/server/item/sign_items.aowl, called here with the
## closures that change the sign. Which item is in the hand is told by its registry key (`BlockServer` holds no item registry):
## `honeycomb`, `ink_sac`, `glow_ink_sac`, and a key that ends in `_dye`. `EntityBase::yaw` and the like come from the
## `BlockPlayer` hooks. A sign's text is edited by `handle_sign_update` (net/java/play.aowl) through `signUpdateText` below.
## As upstream, only `SignBlockEntity` is looked for in `normal_use`, `use_with_item` and the text update: a hanging sign's
## entity is a type of its own and is not edited.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/strutils
import ../blockprelude
import ../entities/hanging_sign
import ../entities/sign
import ../../item/sign_items

type
  SupportInfo* = ref object
    aboveIsValid*: bool
    sideDirection*: Option[BlockDirection]
  SignPlacement* = ref object
    blockId*: BlockId
    facing*: Option[string]
    rotation*: Option[uint8]
    attached*: bool

proc blockDirectionHorizontalList(): array[4, BlockDirection] =
  [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]

proc isLeavesOrSigns(blockRef: Block): bool =
  blockRef.hasTag(Block_MINECRAFT_LEAVES) or blockRef.hasTag(Block_MINECRAFT_SIGNS)

proc isValidSupport*(world: BlockWorld, pos: BlockPos, direction: BlockDirection): bool =
  ## Checks if a block can provide support for a sign.
  let (blockRef, state) = world.getBlockAndState(pos)
  let isPermissive = isLeavesOrSigns(blockRef)
  case direction
  of BlockDirection.Up:
    state.isSideSolid(BlockDirection.Down) or isPermissive
  of BlockDirection.Down:
    state.isCenterSolid(BlockDirection.Up) or isPermissive
  else:
    state.isSideSolid(direction.opposite()) or isPermissive

proc detectSupport*(world: BlockWorld, position: BlockPos): SupportInfo =
  ## Detects available support points around a position.
  let (blockAbove, stateAbove) = world.getBlockAndState(position.up())
  let aboveIsValid = stateAbove.isSideSolid(BlockDirection.Down) or isLeavesOrSigns(blockAbove)
  var sideDirection = none[BlockDirection]()
  let horizontals = blockDirectionHorizontalList()
  for direction in horizontals:
    let pos = position.offset(direction.toOffset())
    if isValidSupport(world, pos, direction.opposite()):
      sideDirection = some(direction)
      break
  SupportInfo(aboveIsValid: aboveIsValid, sideDirection: sideDirection)

proc calculateWallHangingFacing*(wallDir: BlockDirection, playerYaw: float32): string =
  ## Determines the appropriate facing direction for a wall-hanging sign.
  case wallDir
  of BlockDirection.North, BlockDirection.South:
    # Wall runs North-South, sign faces East or West
    if floorMod(playerYaw + 360.0'f32, 360.0'f32) < 180.0'f32: "east" else: "west"
  of BlockDirection.East, BlockDirection.West:
    # Wall runs East-West, sign faces North or South
    if playerYaw >= -270.0'f32 and playerYaw <= 270.0'f32: "south" else: "north"
  else:
    wallDir.opposite().toCardinalDirection().toValue()

proc calculateWallHangingRotation*(wallDir: BlockDirection, playerRot: uint8, isSneaking: bool): uint8 =
  ## Calculates rotation for wall-hanging signs.
  if isSneaking:
    return playerRot
  case wallDir
  of BlockDirection.North, BlockDirection.South:
    # Snap to North-South axis (0 or 8)
    if playerRot >= 4'u8 and playerRot < 12'u8: 8'u8 else: 0'u8
  of BlockDirection.East, BlockDirection.West:
    # Snap to East-West axis (4 or 12)
    if playerRot >= 2'u8 and playerRot < 10'u8: 4'u8 else: 12'u8
  else:
    playerRot

proc getSignVariant*(base: Block, isHanging: bool): BlockId =
  ## Converts a regular sign to its wall variant; the base block's id if there is none.
  let baseName = base.name
  var woodType = "oak"
  if baseName.endsWith("_hanging_sign"):
    woodType = baseName[0 ..< baseName.len - len("_hanging_sign")]
  elif baseName.endsWith("_sign"):
    woodType = baseName[0 ..< baseName.len - len("_sign")]
  let targetName = if isHanging: woodType & "_wall_hanging_sign" else: woodType & "_wall_sign"
  let found = Block.fromName(targetName)
  if found != nil: found.id else: base.id

proc selectHangingVariant*(args: OnPlaceArgs, support: SupportInfo): Option[BlockId] =
  ## Selects the appropriate hanging sign variant.
  if args.direction == BlockDirection.Down and support.aboveIsValid:
    some(args.block0.id) # Ceiling hanging
  elif (args.direction.isHorizontal() or args.direction == BlockDirection.Up) and support.sideDirection.isSome:
    some(getSignVariant(args.block0, true)) # Wall-hanging with post
  elif support.aboveIsValid:
    some(args.block0.id)
  else:
    none[BlockId]() # No valid placement

proc selectStandingVariant*(args: OnPlaceArgs, support: SupportInfo): BlockId =
  ## Selects the appropriate standing sign variant.
  if args.direction.isHorizontal() and support.sideDirection.isSome:
    getSignVariant(args.block0, false) # Wall sign
  else:
    args.block0.id # Standing sign

proc calculateWallHangingOrientation*(args: OnPlaceArgs, support: SupportInfo, isSneaking: bool): (Option[string], Option[uint8], bool) =
  ## Calculates orientation for wall-hanging signs.
  var wallDir = args.direction
  if not args.direction.isHorizontal():
    wallDir = support.sideDirection.get(args.direction)
  let yawf = args.player.yaw0
  let playerYaw = yawf()
  let facing = calculateWallHangingFacing(wallDir, playerYaw)
  let rotf = args.player.flippedRotation160
  let playerRot = rotf()
  let rotation = calculateWallHangingRotation(wallDir, playerRot, isSneaking)
  let isAngled = rotation mod 4'u8 != 0'u8
  let attached = isAngled or isSneaking
  (some(facing), some(rotation), attached)

proc calculateCeilingOrientation*(args: OnPlaceArgs, isSneaking: bool): (Option[string], Option[uint8], bool) =
  ## Calculates orientation for ceiling-hanging signs.
  let rotf = args.player.flippedRotation160
  let index = rotf()
  var rotation = index
  if not isSneaking:
    # Snap to nearest cardinal
    rotation = ((index + 2'u8) div 4'u8 * 4'u8) mod 16'u8
  let isAngled = rotation mod 4'u8 != 0'u8
  let attached = isAngled or isSneaking
  (none[string](), some(rotation), attached)

proc calculateWallOrientation*(args: OnPlaceArgs): (Option[string], Option[uint8], bool) =
  ## Calculates orientation for wall signs.
  let facing = args.direction.opposite().toCardinalDirection().toValue()
  (some(facing), none[uint8](), false)

proc calculateStandingOrientation*(args: OnPlaceArgs): (Option[string], Option[uint8], bool) =
  ## Calculates orientation for standing signs.
  let rotf = args.player.flippedRotation160
  (none[string](), some(rotf()), false)

proc determinePlacement*(args: OnPlaceArgs, support: SupportInfo): Option[SignPlacement] =
  ## Determines the block variant and placement properties for a sign.
  let isHanging = args.block0.name.contains("hanging")
  let isSneaking = args.player.isSneaking()
  var blockId = args.block0.id
  if isHanging:
    let variant = selectHangingVariant(args, support)
    if variant.isNone:
      return none[SignPlacement]()
    blockId = variant.unsafeGet
  else:
    blockId = selectStandingVariant(args, support)
  let actualBlock = Block.fromId(blockId)
  let isWallHanging = isHanging and actualBlock.name.contains("wall_hanging")
  var orientation: (Option[string], Option[uint8], bool)
  if isWallHanging:
    orientation = calculateWallHangingOrientation(args, support, isSneaking)
  elif isHanging:
    orientation = calculateCeilingOrientation(args, isSneaking)
  elif actualBlock.name.contains("wall"):
    orientation = calculateWallOrientation(args)
  else:
    orientation = calculateStandingOrientation(args)
  some(SignPlacement(blockId: blockId, facing: orientation[0], rotation: orientation[1], attached: orientation[2]))

proc applyPlacementProperties*(blockRef: Block, placement: SignPlacement): BlockStateId =
  ## Applies placement properties to a block.
  let found = blockRef.properties(blockRef.defaultState.id)
  var props: seq[(string, string)] = @[]
  if found[0]:
    props = found[1].toProps()
  if placement.facing.isSome:
    for i in 0 ..< props.len:
      if props[i][0] == "facing":
        props[i][1] = placement.facing.unsafeGet
        break
  if placement.rotation.isSome:
    for i in 0 ..< props.len:
      if props[i][0] == "rotation":
        let rotation = placement.rotation.unsafeGet
        props[i][1] = if rotation >= 1'u8 and rotation <= 15'u8: $rotation else: "0"
        break
  for i in 0 ..< props.len:
    if props[i][0] == "attached":
      props[i][1] = if placement.attached: "true" else: "false"
      break
  blockRef.fromProperties(props).toStateId(blockRef)

proc getWallSupportDirection*(blockRef: Block, stateId: BlockStateId): Option[BlockDirection] =
  ## The direction of the block supporting the wall sign.
  let found = blockRef.properties(stateId)
  if not found[0]:
    return none[BlockDirection]()
  for kv in found[1].toProps():
    if kv[0] == "facing":
      return case kv[1]
        of "north": some(BlockDirection.South)
        of "south": some(BlockDirection.North)
        of "east": some(BlockDirection.West)
        else: some(BlockDirection.East) # "west" and default case
  none[BlockDirection]()

proc getYawFromRotation16*(rotation: uint8): float32 =
  float32(rotation) * 22.5'f32

proc isFacingFrontText*(world: BlockWorld, location: BlockPos, blockRef: Block, player: BlockPlayer): bool =
  let stateId = world.getBlockStateId(location)
  # Read properties dynamically: some sign types use a `rotation` property (0..15), others (wall signs) use a `facing`
  # property (north/south/west/east), hanging signs may have `rotation` + `attached`.
  var rotation = 0.0'f32
  let found = blockRef.properties(stateId)
  if found[0]:
    let propMap = found[1].toProps()
    var haveRotation = false
    var haveFacing = false
    var rotationValue = ""
    var facingValue = ""
    for kv in propMap:
      if kv[0] == "rotation" and not haveRotation:
        haveRotation = true
        rotationValue = kv[1]
      elif kv[0] == "facing" and not haveFacing:
        haveFacing = true
        facingValue = kv[1]
    if haveRotation:
      # `val.parse().unwrap_or(0)`
      var r = 0
      var digits = rotationValue.len > 0
      for ch in rotationValue:
        if ch < '0' or ch > '9':
          digits = false
        else:
          r = r * 10 + (int(ch) - int('0'))
      if not digits:
        r = 0
      rotation = getYawFromRotation16(uint8(r))
    elif haveFacing:
      rotation = case facingValue
        of "north": 180.0'f32
        of "west": 90.0'f32
        of "east": -90.0'f32
        else: 0.0'f32
  let eyef = player.eyePosition0
  let eye = eyef()
  let d = eye.x - (float64(location.vec.x) + 0.5'f64)
  let d1 = eye.z - (float64(location.vec.z) + 0.5'f64)
  let f = float32(radToDeg(arctan2(d1, d))) - 90.0'f32
  let diff = floorMod(f - rotation + 180.0'f32, 360.0'f32) - 180.0'f32
  abs(diff) <= 90.0'f32

proc tryClaimSign*(currentlyEditing: var Option[string], uuid: string, world: BlockWorld, position: BlockPos): bool =
  let f = world.playerByUuid0
  if currentlyEditing.isSome and currentlyEditing.unsafeGet != uuid and f != nil:
    let editing = f(currentlyEditing.unsafeGet)
    if editing.isSome:
      let can = editing.unsafeGet.canInteractWithBlockAt0
      if can != nil and can(position, 4.0'f64):
        return false
  currentlyEditing = some(uuid)
  true

proc signBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let support = detectSupport(args.world, args.position)
  let placement = determinePlacement(args, support)
  if placement.isNone:
    return blockStateIdAir # Invalid placement
  let actualBlock = Block.fromId(placement.unsafeGet.blockId)
  applyPlacementProperties(actualBlock, placement.unsafeGet)

proc signBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if args.block0.name.contains("hanging"):
    args.world.addBlockEntity(emptyHangingSignBlockEntity(args.position))
  else:
    args.world.addBlockEntity(emptySignBlockEntity(args.position))

proc signBlockPlayerPlaced_BlockBehaviour(args: PlayerPlacedArgs) =
  let f = args.player.sendSignPacket0
  if f != nil:
    f(args.position, true)

proc signBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let isHanging = args.block0.name.contains("hanging")
  var clickedFace = BlockDirection.Up
  if args.useItemOn.isSome:
    let face = tryFromI32(args.useItemOn.unsafeGet.face.value)
    if face[0]:
      clickedFace = face[1]
  # Detection for floor-to-wall attachment (broken rn)
  if isHanging and clickedFace == BlockDirection.Up:
    let horizontals = blockDirectionHorizontalList()
    for d in horizontals:
      let wallPos = args.position.offset(d.toOffset())
      let (blockRef, state) = args.blockAccessor.getBlockAndState(wallPos)
      if state.isSideSolid(d.opposite()) or isLeavesOrSigns(blockRef):
        return true
  # Standard support validation with permissive tags
  let supportPos = case clickedFace
    of BlockDirection.Up: args.position.down()
    of BlockDirection.Down: args.position.up()
    else: args.position.offset(clickedFace.opposite().toOffset())
  let (blockRef, state) = args.blockAccessor.getBlockAndState(supportPos)
  let isPermissive = isLeavesOrSigns(blockRef)
  case clickedFace
  of BlockDirection.Up:
    (not isHanging) and (state.isCenterSolid(BlockDirection.Up) or isPermissive)
  of BlockDirection.Down:
    isHanging and (state.isSideSolid(BlockDirection.Down) or isPermissive)
  else:
    state.isSideSolid(clickedFace.opposite()) or isPermissive

proc signBlockOnStateReplaced_BlockBehaviour(args: OnStateReplacedArgs) =
  args.world.removeBlockEntity(args.position)

proc signBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let isHanging = args.block0.name.contains("hanging")
  let isWallSign = args.block0.name.contains("wall")
  # Determine the expected support direction
  var supportDir = none[BlockDirection]()
  if isWallSign:
    # Look up the 'facing' property to find the support behind the wall sign
    supportDir = getWallSupportDirection(args.block0, args.stateId)
  elif isHanging:
    # Ceiling-hanging signs always look Up
    supportDir = some(BlockDirection.Up)
  else:
    # Standing signs always look Down
    supportDir = some(BlockDirection.Down)
  if supportDir.isSome:
    let dir = supportDir.unsafeGet
    # Only check if the neighbor that changed is our support neighbor
    if args.direction == dir:
      let supportPos = args.position.offset(dir.toOffset())
      let (supportBlock, supportState) = args.world.getBlockAndState(supportPos)
      # Permissive support check
      let isLeaf = supportBlock.hasTag(Block_MINECRAFT_LEAVES)
      let isSign = supportBlock.hasTag(Block_MINECRAFT_SIGNS)
      let isValid = case dir
        of BlockDirection.Up: supportState.isSideSolid(BlockDirection.Down) or isLeaf or isSign
        of BlockDirection.Down: supportState.isCenterSolid(BlockDirection.Up) or isLeaf or isSign
        else: supportState.isSideSolid(dir.opposite()) or isLeaf or isSign
      if not isValid:
        return blockStateIdAir # Return AIR to break the block
  args.stateId

proc signBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  ## Handles normal use (right-click) on the sign block.
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barPass
  let signEntity = asType(blockEntity.unsafeGet, SignBlockEntity)
  if signEntity.isNone:
    return barPass
  let sign = signEntity.unsafeGet
  if sign.isWaxed:
    args.world.playBlockSound(sdBlockSignWaxedInteractFail, scBlocks, args.position)
    return barSuccessServer
  if not tryClaimSign(sign.currentlyEditingPlayer, args.player.entityUuid, args.world, args.position):
    return barPass
  let isFacingFront = isFacingFrontText(args.world, args.position, args.block0, args.player)
  let f = args.player.sendSignPacket0
  if f != nil:
    f(args.position, isFacingFront)
  barSuccessServer

proc signBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  ## Handles use with an item on the sign block.
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barPass
  let signEntity = asType(blockEntity.unsafeGet, SignBlockEntity)
  if signEntity.isNone:
    return barPass
  let sign = signEntity.unsafeGet
  if sign.isWaxed:
    return barPassToDefaultBlockAction
  if not tryClaimSign(sign.currentlyEditingPlayer, args.player.entityUuid, args.world, args.position):
    # Vanilla does it like this although normal_use returns on the same condition.
    return barPassToDefaultBlockAction
  let text = if isFacingFrontText(args.world, args.position, args.block0, args.player): sign.frontText else: sign.backText
  let key = args.itemStack.stack.item.registryKey
  var result0 = barPassToDefaultBlockAction
  var isGlowInk = false
  if key == "honeycomb":
    result0 = applyHoneyCombToSign(args, blockEntity.unsafeGet, proc() {.closure.} = sign.isWaxed = true)
  elif key == "glow_ink_sac":
    isGlowInk = true
    result0 = applyGlowingInkSacToSign(args, blockEntity.unsafeGet, proc(value: bool): bool {.closure.} =
      let old = text.hasGlowingText
      text.hasGlowingText = value
      old)
  elif key == "ink_sac":
    result0 = applyInkSacToSign(args, blockEntity.unsafeGet, proc(value: bool): bool {.closure.} =
      let old = text.hasGlowingText
      text.hasGlowingText = value
      old)
  elif key.endsWith("_dye"):
    let colorName = key[0 ..< key.len - len("_dye")]
    result0 = applyDyeToSign(args, blockEntity.unsafeGet, proc() {.closure.} = text.setColor(dyeColorFromName(colorName)))
  if result0 == barSuccess:
    if isGlowInk:
      let t = args.player.triggerAdvancement0
      if t != nil:
        t("GlowedSign", "")
    let gm = args.player.gamemode0
    if not (gm != nil and gm() == GameMode.Creative):
      args.itemStack.stack.decrement(1'u8)
    sign.currentlyEditingPlayer = none[string]()
  result0

proc signUpdateText*(world: BlockWorld, position: BlockPos, isFrontText: bool, lines: array[4, string]): bool =
  ## `handle_sign_update` past the packet: false when there is no sign there or it is waxed.
  let blockEntity = world.getBlockEntity(position)
  if blockEntity.isNone:
    return false
  let asSign = asType(blockEntity.unsafeGet, SignBlockEntity)
  if asSign.isNone:
    return false
  let sign = asSign.unsafeGet
  if sign.isWaxed:
    return false
  let text = if isFrontText: sign.frontText else: sign.backText
  text.messages = lines
  sign.currentlyEditingPlayer = none[string]()
  world.updateBlockEntity(blockEntity.unsafeGet)
  true

proc newSignBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = signBlockOnPlace_BlockBehaviour
  result.placedImpl = signBlockPlaced_BlockBehaviour
  result.playerPlacedImpl = signBlockPlayerPlaced_BlockBehaviour
  result.canPlaceAtImpl = signBlockCanPlaceAt_BlockBehaviour
  result.onStateReplacedImpl = signBlockOnStateReplaced_BlockBehaviour
  result.getStateForNeighborUpdateImpl = signBlockGetStateForNeighborUpdate_BlockBehaviour
  result.normalUseImpl = signBlockNormalUse_BlockBehaviour
  result.useWithItemImpl = signBlockUseWithItem_BlockBehaviour

proc registerBlocksSigns*(r: BlockRegistry) =
  r.registerTag("minecraft:all_signs", newSignBlock())
