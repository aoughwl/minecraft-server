## signs.rs and entities/sign.rs, hanging_sign.rs over a `TestWorld`: the placement the sign's neighbours and the player's look
## give, the entity added by `placed`, what is written to and read back from NBT, the colour table, and the use of dye, ink and
## honeycomb on the text. Known answers are worked out from the Rust.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude
import ../testworld
import ../entities/[entitiesmod, sign, hanging_sign]
import signs
import ../../../protocol/varint

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerBlocksSigns(result)
  check(result.unknown.len == 0, "every registered name resolves")

type Seen = ref object
  packets: seq[(BlockPos, bool)]
  advancements: seq[string]

proc newPlayer(uuid: string; yaw: float32; flipped: uint8; seen: Seen; creative = false): BlockPlayer =
  let p = BlockPlayer()
  p.entityUuid = uuid
  p.yaw0 = proc(): float32 {.closure.} = yaw
  p.sneaking0 = proc(): bool {.closure.} = false
  p.flippedRotation160 = proc(): uint8 {.closure.} = flipped
  p.eyePosition0 = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 0.5, y: 65.62, z: 5.5)
  p.canInteractWithBlockAt0 = proc(position: BlockPos; additionalRange: float64): bool {.closure.} = true
  p.sendSignPacket0 = proc(position: BlockPos; isFrontText: bool) {.closure.} = seen.packets.add((position, isFrontText))
  p.triggerAdvancement0 = proc(trigger, argument: string) {.closure.} = seen.advancements.add(trigger)
  p.gamemode0 = proc(): GameMode {.closure.} = (if creative: GameMode.Creative else: GameMode.Survival)
  p

proc propOf(blockRef: Block; id: BlockStateId; key: string): string =
  let found = blockRef.properties(id)
  if found[0]:
    for kv in found[1].toProps():
      if kv[0] == key:
        return kv[1]
  "<none>"

proc place(t: TestWorld; blockRef: Block; pos: BlockPos; direction: BlockDirection; player: BlockPlayer): BlockStateId =
  t.world.blockRegistry.onPlace(BlockServer(), t.world, player, blockRef, pos, direction,
    BlockIsReplacing(kind: BlockIsReplacingKind.kNone), SUseItemOn())

proc stackOf(key: string): ItemStackRef =
  let item = Item.fromRegistryKey(key)
  if item == nil:
    echo "FAILED item ", key
    quit(1)
  ItemStackRef(stack: newItemStack(3'u8, item))

proc signAt(t: TestWorld; pos: BlockPos): SignBlockEntity =
  let e = t.world.getBlockEntity(pos)
  check(e.isSome, "a block entity at the sign")
  let s = asType(e.unsafeGet, SignBlockEntity)
  check(s.isSome, "it is a sign entity")
  s.unsafeGet

block dyeColorTable:
  check(dyeColorName(DyeColor.LightBlue) == "light_blue", "light_blue")
  check(dyeColorFromName("light_gray") == DyeColor.LightGray, "from light_gray")
  check(dyeColorFromName("nonsense") == DyeColor.Black, "an unknown name is black")
  check(dyeColorFromI8(14'i8) == DyeColor.Red, "from 14")
  check(dyeColorFromI8(99'i8) == DyeColor.Black, "an unknown number is black")
  check(dyeColorTag(DyeColor.Green).byteVal == 13'i8, "the tag is the byte")

block signEntityNbtRoundTrip:
  let pos = blockPos(3'i32, 64'i32, 4'i32)
  let e = newSignBlockEntity(pos, true, ["a", "{\"text\":\"b\"}", "", "d"])
  e.frontText.setColor(DyeColor.Red)
  e.frontText.hasGlowingText = true
  e.isWaxed = true
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  check(nbt.getBool("is_waxed").get(false), "waxed is written")
  check(nbt.has("front_text") and nbt.has("back_text"), "both texts are written")
  let front = nbt.getCompound("front_text").unsafeGet
  check(front.getString("color").get("") == "red", "the colour is its name")
  check(front.getBool("has_glowing_text").get(false), "glowing is written")
  check(front.getList("messages").unsafeGet.len == 4, "four messages")
  let back = nbt.getCompound("back_text").unsafeGet
  check(back.getString("color").get("") == "black", "the default colour is black")
  var again = nbt
  let loaded = signBlockEntityFromNbt_BlockEntity(again, pos)
  check(loaded.frontText.messages[1] == "{\"text\":\"b\"}", "line two comes back")
  check(loaded.frontText.messages[2] == "", "an empty line comes back empty")
  check(loaded.frontText.getColor() == DyeColor.Red, "colour comes back")
  check(loaded.frontText.hasGlowingText, "glow comes back")
  check(loaded.isWaxed, "wax comes back")
  check(loaded.backText.messages[0] == "", "the back stays empty")
  let chunk = BlockEntity(e).chunkDataNbt()
  check(chunk.isSome and chunk.unsafeGet.has("front_text") and chunk.unsafeGet.getBool("is_waxed").get(false), "chunk data")
  check(BlockEntity(e).resourceLocation() == "minecraft:sign", "resource location")
  # A back-text sign.
  let b = newSignBlockEntity(pos, false, ["x", "", "", ""])
  check(b.backText.messages[0] == "x" and b.frontText.messages[0] == "", "is_front false fills the back")
  # Short or missing messages read as empty lines.
  var odd = newCompound()
  var tc = newCompound()
  tc.putList("messages", @[NbtTag(kind: ntkString, stringVal: "only")])
  odd.put("front_text", NbtTag(kind: ntkCompound, compoundVal: tc))
  let sparse = signBlockEntityFromNbt_BlockEntity(odd, pos)
  check(sparse.frontText.messages[0] == "only" and sparse.frontText.messages[3] == "", "a short list is padded")
  check(sparse.frontText.getColor() == DyeColor.Black, "no colour is black")

block hangingSignNbtRoundTrip:
  let pos = blockPos(0'i32, 70'i32, 0'i32)
  let e = newHangingSignBlockEntity(pos, true, ["h", "", "", ""])
  e.isWaxed = true
  var nbt = newCompound()
  BlockEntity(e).writeNbt(nbt)
  let loaded = hangingSignBlockEntityFromNbt_BlockEntity(nbt, pos)
  check(loaded.frontText.messages[0] == "h" and loaded.isWaxed, "a hanging sign reads back")
  check(BlockEntity(e).resourceLocation() == "minecraft:hanging_sign", "resource location")

block entityTables:
  var nbt = newCompound()
  BlockEntity(newSignBlockEntity(blockPos(1'i32, 2'i32, 3'i32), true, ["z", "", "", ""])).writeNbt(nbt)
  put(nbt, "id", NbtTag(kind: ntkString, stringVal: "minecraft:sign"))
  put(nbt, "x", NbtTag(kind: ntkInt, intVal: 1'i32))
  put(nbt, "y", NbtTag(kind: ntkInt, intVal: 2'i32))
  put(nbt, "z", NbtTag(kind: ntkInt, intVal: 3'i32))
  let loaded = blockEntityFromNbt(nbt)
  check(loaded.isSome and BlockEntity(loaded.unsafeGet).resourceLocation() == "minecraft:sign", "block_entity_from_nbt finds a sign")
  var made = false
  for i in 0 ..< BLOCK_ENTITY_TYPES.len:
    if BLOCK_ENTITY_TYPES[i] == "hanging_sign":
      made = createBlockEntity(uint16(i), blockPos(0'i32, 0'i32, 0'i32)).isSome
  check(made, "create_block_entity makes a hanging sign")

block placementOfStandingAndWallSigns:
  let t = newTestWorld(newRegistry())
  let seen = Seen()
  let below = blockPos(0'i32, 63'i32, 0'i32)
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  t.put(below, blockStone())
  let player = newPlayer("p1", 0.0'f32, 11'u8, seen)
  # On top of a block: a standing sign with the player's flipped rotation 16.
  let standing = t.place(blockOakSign(), pos, BlockDirection.Up, player)
  check(propOf(blockOakSign(), standing, "rotation") == "11", "standing rotation is the flipped one")
  check(Block.fromStateId(standing).id == blockOakSign().id, "still a standing sign")
  # On the north face of a block to the south: a wall sign facing south.
  let t2 = newTestWorld(newRegistry())
  t2.put(blockPos(0'i32, 64'i32, 1'i32), blockStone())
  let wall = t2.place(blockOakSign(), pos, BlockDirection.North, player)
  check(Block.fromStateId(wall).id == blockOakWallSign().id, "a side face makes a wall sign")
  check(propOf(blockOakWallSign(), wall, "facing") == "south", "it faces away from the wall")
  # The wood type survives the swap.
  check(getSignVariant(blockSpruceSign(), false) == blockSpruceWallSign().id, "spruce keeps its wood")
  check(getSignVariant(blockOakHangingSign(), true) == blockOakWallHangingSign().id, "hanging goes to wall hanging")
  # Wall hanging facing and rotation.
  check(calculateWallHangingFacing(BlockDirection.North, 10.0'f32) == "east", "ns wall, yaw 10")
  check(calculateWallHangingFacing(BlockDirection.South, 200.0'f32) == "west", "ns wall, yaw 200")
  check(calculateWallHangingFacing(BlockDirection.East, 0.0'f32) == "south", "ew wall, yaw 0")
  check(calculateWallHangingFacing(BlockDirection.West, 300.0'f32) == "north", "ew wall, yaw 300")
  check(calculateWallHangingRotation(BlockDirection.North, 5'u8, false) == 8'u8, "ns snaps to 8")
  check(calculateWallHangingRotation(BlockDirection.North, 3'u8, false) == 0'u8, "ns snaps to 0")
  check(calculateWallHangingRotation(BlockDirection.East, 5'u8, false) == 4'u8, "ew snaps to 4")
  check(calculateWallHangingRotation(BlockDirection.East, 12'u8, false) == 12'u8, "ew snaps to 12")
  check(calculateWallHangingRotation(BlockDirection.East, 7'u8, true) == 7'u8, "sneaking keeps it")
  # A hanging sign with nothing above and nothing at the sides cannot be placed.
  let t3 = newTestWorld(newRegistry())
  let none0 = t3.place(blockOakHangingSign(), pos, BlockDirection.Down, player)
  check(none0 == blockStateIdAir, "no support, no placement")
  t3.put(blockPos(0'i32, 65'i32, 0'i32), blockStone())
  let hung = t3.place(blockOakHangingSign(), pos, BlockDirection.Down, player)
  check(Block.fromStateId(hung).id == blockOakHangingSign().id, "hung from above")
  check(propOf(blockOakHangingSign(), hung, "rotation") == "12", "snapped to the nearest cardinal: (11+2)/4*4 = 12")

block placedAddsTheEntityAndRemovalDropsIt:
  let t = newTestWorld(newRegistry())
  let seen = Seen()
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let player = newPlayer("p1", 0.0'f32, 0'u8, seen)
  let reg = t.world.blockRegistry
  discard t.world.setBlockState(pos, blockOakSign().defaultState.id, BfNotifyAll)
  discard signAt(t, pos)
  reg.playerPlaced(t.world, blockOakSign(), blockOakSign().defaultState.id, pos, BlockDirection.Up, player)
  check(seen.packets.len == 1 and seen.packets[0][1], "the editor opens on the front for the placer")
  discard t.world.setBlockState(pos, blockStateIdAir, BfNotifyAll)
  check(t.world.getBlockEntity(pos).isNone, "the entity goes with the block")

proc usingTheSign() =
  let t = newTestWorld(newRegistry())
  let seen = Seen()
  let seen2 = Seen()
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let reg = t.world.blockRegistry
  # A wall sign facing south, the player to the south (looking at its front).
  var props = blockOakWallSign().properties(blockOakWallSign().defaultState.id)[1].toProps()
  for i in 0 ..< props.len:
    if props[i][0] == "facing":
      props[i][1] = "south"
  let state = blockOakWallSign().fromProperties(props).toStateId(blockOakWallSign())
  discard t.world.setBlockState(pos, state, BfNotifyAll)
  let player = newPlayer("p1", 0.0'f32, 0'u8, seen)
  let other = newPlayer("p2", 0.0'f32, 0'u8, seen2)
  let hit = BlockHitResult(face: BlockDirection.Up, cursorPos: Vector3[float32](x: 0.5, y: 0.5, z: 0.5))
  let r1 = reg.onUse(blockOakWallSign(), player, pos, hit, BlockServer(), t.world)
  check(r1 == barSuccessServer, "right-click opens the editor")
  check(seen.packets.len == 1 and seen.packets[0][1], "eyes at z = 5.5 are on the south side: the front")
  # Another player is turned away while the first can still reach it.
  t.world.playerByUuid0 = proc(uuid: string): Option[BlockPlayer] {.closure.} =
    if uuid == "p1": some(player) else: none[BlockPlayer]()
  let r2 = reg.onUse(blockOakWallSign(), other, pos, hit, BlockServer(), t.world)
  check(r2 == barPass and seen2.packets.len == 0, "a second editor is refused")
  # The text arrives from the client.
  check(signUpdateText(t.world, pos, true, ["one", "two", "three", "four"]), "the update is taken")
  check(signAt(t, pos).frontText.messages[2] == "three", "the text is set")
  check(signAt(t, pos).currentlyEditingPlayer.isNone, "and the claim is released")
  let r3 = reg.onUse(blockOakWallSign(), other, pos, hit, BlockServer(), t.world)
  check(r3 == barSuccessServer, "now the other player can edit")
  # Dye, ink and honeycomb.
  let red = stackOf("red_dye")
  let r4 = reg.useWithItem(blockOakWallSign(), other, pos, hit, red, 0, BlockServer(), t.world)
  check(r4 == barSuccess and signAt(t, pos).frontText.getColor() == DyeColor.Red, "red dye colours the front")
  check(red.stack.itemCount == 2'u8, "and uses one dye")
  let glow = stackOf("glow_ink_sac")
  check(reg.useWithItem(blockOakWallSign(), other, pos, hit, glow, 0, BlockServer(), t.world) == barSuccess, "glow ink")
  check(signAt(t, pos).frontText.hasGlowingText and seen2.advancements.len == 1 and seen2.advancements[0] == "GlowedSign", "it glows and the advancement fires")
  check(reg.useWithItem(blockOakWallSign(), other, pos, hit, glow, 0, BlockServer(), t.world) == barPassToDefaultBlockAction,
    "glowing twice does nothing")
  let ink = stackOf("ink_sac")
  check(reg.useWithItem(blockOakWallSign(), other, pos, hit, ink, 0, BlockServer(), t.world) == barSuccess, "ink")
  check(not signAt(t, pos).frontText.hasGlowingText, "ink turns the glow off")
  let creativeStack = stackOf("honeycomb")
  let builder = newPlayer("p3", 0.0'f32, 0'u8, Seen(), creative = true)
  check(reg.useWithItem(blockOakWallSign(), builder, pos, hit, creativeStack, 0, BlockServer(), t.world) == barSuccess, "honeycomb")
  check(signAt(t, pos).isWaxed, "the sign is waxed")
  check(creativeStack.stack.itemCount == 3'u8, "creative keeps the honeycomb")
  # A waxed sign takes no more text and answers with the fail sound.
  check(not signUpdateText(t.world, pos, true, ["x", "x", "x", "x"]), "waxed refuses text")
  check(signAt(t, pos).frontText.messages[0] == "one", "text unchanged")
  check(reg.onUse(blockOakWallSign(), player, pos, hit, BlockServer(), t.world) == barSuccessServer, "waxed use is handled")
  check(reg.useWithItem(blockOakWallSign(), player, pos, hit, red, 0, BlockServer(), t.world) == barPassToDefaultBlockAction,
    "waxed refuses dye")
  # From the north side the back is faced.
  let seen3 = Seen()
  let back = newPlayer("p4", 0.0'f32, 0'u8, seen3)
  back.eyePosition0 = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 0.5, y: 65.62, z: -4.5)
  check(isFacingFrontText(t.world, pos, blockOakWallSign(), back) == false, "the north side faces the back")

block canPlaceAtFromTheTop:
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  t.put(blockPos(0'i32, 63'i32, 0'i32), blockStone())
  var useItemOn = SUseItemOn()
  useItemOn.face = newVarInt(1'i32)
  let player = newPlayer("p1", 0.0'f32, 0'u8, Seen())
  let okTop = t.world.blockRegistry.canPlaceAt(BlockServer(), t.world, t.world, player, blockOakSign(), BlockState.fromId(blockOakSign().defaultState.id),
    pos, some(BlockDirection.Down), some(useItemOn))
  check(okTop, "a sign can be placed on the top of stone (clicked face up)")
  useItemOn.face = newVarInt(2'i32)
  t.put(blockPos(0'i32, 64'i32, 1'i32), blockStone())
  let okSide = t.world.blockRegistry.canPlaceAt(BlockServer(), t.world, t.world, player, blockOakSign(), BlockState.fromId(blockOakSign().defaultState.id),
    pos, some(BlockDirection.South), some(useItemOn))
  check(okSide, "and on the side of stone (clicked face north)")
  useItemOn.face = newVarInt(1'i32)
  let t2 = newTestWorld(newRegistry())
  let bad = t2.world.blockRegistry.canPlaceAt(BlockServer(), t2.world, t2.world, player, blockOakSign(), BlockState.fromId(blockOakSign().defaultState.id),
    pos, some(BlockDirection.Down), some(useItemOn))
  check(not bad, "not on air")

block supportIsChecked:
  let t = newTestWorld(newRegistry())
  let pos = blockPos(0'i32, 64'i32, 0'i32)
  let reg = t.world.blockRegistry
  t.put(blockPos(0'i32, 63'i32, 0'i32), blockStone())
  t.put(pos, blockOakSign())
  # The block below is the support of a standing sign: when it goes the sign is broken (state becomes air).
  let still = reg.getStateForNeighborUpdate(t.world, blockOakSign(), blockOakSign().defaultState.id, pos, BlockDirection.Down,
    blockPos(0'i32, 63'i32, 0'i32), blockStone().defaultState.id)
  check(still == blockOakSign().defaultState.id, "supported, it stays")
  t.put(blockPos(0'i32, 63'i32, 0'i32), blockStateIdAir)
  let gone = reg.getStateForNeighborUpdate(t.world, blockOakSign(), blockOakSign().defaultState.id, pos, BlockDirection.Down,
    blockPos(0'i32, 63'i32, 0'i32), blockStateIdAir)
  check(gone == blockStateIdAir, "unsupported, it breaks")
  # Another neighbour changing does not matter.
  let side = reg.getStateForNeighborUpdate(t.world, blockOakSign(), blockOakSign().defaultState.id, pos, BlockDirection.East,
    blockPos(1'i32, 64'i32, 0'i32), blockStateIdAir)
  check(side == blockOakSign().defaultState.id, "a side neighbour is not the support")

usingTheSign()
echo "signs ok"
