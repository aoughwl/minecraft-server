import ../blockprelude
import redstone/redstonemod
import ../entities/skull


type
  SkullBlock* = object



proc skullBlockIds*(): seq[BlockId]
proc skullBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc skullBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc skullBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newSkullBlock*(): BlockBehaviour

proc skullBlockIds*(): seq[BlockId] =
  @[blockIdSkeletonSkull, blockIdPlayerHead, blockIdZombieHead, blockIdCreeperHead, blockIdPiglinHead, blockIdDragonHead]

proc skullBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newSkullBlockEntity(args.position)
  args.world.addBlockEntity(entity)

proc skullBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = SkeletonSkullLikeProperties.defaultFor(args.block0)
  props.rotation = args.player.getEntity().getRotation16()
  props.powered = blockReceivesRedstonePower(args.world, args.position)
  props.toStateId(args.block0)

proc skullBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let state = args.world.getBlockState(args.position)
  var props = SkeletonSkullLikeProperties.fromStateId(state.id, args.block0)
  let isReceivingPower = blockReceivesRedstonePower(args.world, args.position)
  if (not (props.powered == isReceivingPower)):
    props.powered = isReceivingPower
    discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyListeners)

proc newSkullBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = skullBlockPlaced_BlockBehaviour
  result.onPlaceImpl = skullBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = skullBlockOnNeighborUpdate_BlockBehaviour

proc registerBlocksSkullBlock*(r: BlockRegistry) =
  r.registerIds(skullBlockIds(), newSkullBlock())

