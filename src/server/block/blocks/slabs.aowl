## Port of pumpkin/src/block/blocks/slabs.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  SlabProperties = ResinBrickSlabLikeProperties
  SlabBlock* = object



proc slabBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc slabBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool
proc newSlabBlock*(): BlockBehaviour

proc slabBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let t1 = args.replacing
  if t1.kind == BlockIsReplacingKind.kItself:
    let stateId = t1.f0Itself
    var slabProps = SlabProperties.fromStateId(t1.f0Itself, args.block0)
    slabProps.`type` = SlabType.Double
    slabProps.waterlogged = false
    return slabProps.toStateId(args.block0)
  var slabProps1 = SlabProperties.defaultFor(args.block0)
  slabProps1.waterlogged = args.replacing.waterSource()
  let t2 = block:
    case args.direction
    of BlockDirection.Up:
      SlabType.Top
    of BlockDirection.Down:
      SlabType.Bottom
    else:
      if args.useItemOn.cursorPos.y >= 0.0 and args.useItemOn.cursorPos.y < 0.5:
        SlabType.Bottom
      else:
        SlabType.Top
  slabProps1.`type` = t2
  slabProps1.toStateId(args.block0)

proc slabBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  let slabProps = SlabProperties.fromStateId(args.stateId, args.block0)
  let t3 = block:
    case args.direction
    of BlockDirection.Up:
      SlabType.Bottom
    of BlockDirection.Down:
      SlabType.Top
    else:
      if args.useItemOn.cursorPos.y >= 0.0 and args.useItemOn.cursorPos.y < 0.5:
        SlabType.Top
      else:
        SlabType.Bottom
  (slabProps.`type` == t3)

proc newSlabBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = slabBlockOnPlace_BlockBehaviour
  result.canUpdateAtImpl = slabBlockCanUpdateAt_BlockBehaviour

proc registerBlocksSlabs*(r: BlockRegistry) =
  r.registerTag("minecraft:slabs", newSlabBlock())

