proc slimeBlockOnLandedUpon_BlockBehaviour(args: OnLandedUponArgs) =
  let t1 = args.entity.getLivingEntity()
  if t1.isSome:
    let living = t1.unsafeGet
    t1.unsafeGet.handleFallDamage(args.entity, args.fallDistance, 0.0)

proc slimeBlockUpdateEntityMovementAfterFallOn_BlockBehaviour(args: UpdateEntityMovementAfterFallOnArgs) =
  bounceEntityAfterFall(args.entity, 1.0)

proc newSlimeBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onLandedUponImpl = slimeBlockOnLandedUpon_BlockBehaviour
  result.updateEntityMovementAfterFallOnImpl = slimeBlockUpdateEntityMovementAfterFallOn_BlockBehaviour

proc registerBlocksSlime*(r: BlockRegistry) =
  r.register("minecraft:slime_block", newSlimeBlock())

