## Port of pumpkin/src/block/blocks/smoker.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property
import ../../../inventory/furnace_like_screen_handler
import ../../../generated/[translation, screen]
import ../entities/smoker

proc smokerBlockScreenFactory(inventory: Inventory; propertyDelegate: PropertyDelegate;
    experienceContainer: ExperienceContainer): BlockScreenFactory =
  ## `SmokerScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_SMOKER, BEDROCK_TILE_SMOKER_NAME),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(newFurnaceLikeScreenHandler(syncId, playerInventory, inventory, propertyDelegate, experienceContainer,
        wtSmoker)))

proc smokerBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isNone:
    return barConsume
  let inventory = blockEntity.unsafeGet.getInventory()
  if inventory.isNone:
    return barConsume
  let propertyDelegate = blockEntity.unsafeGet.toPropertyDelegate()
  if propertyDelegate.isNone:
    return barConsume
  let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
  if experienceContainer.isNone:
    return barConsume
  args.player.incrementStat(scCustom, int32(csInteractWithSmoker), 1)
  args.player.openHandledScreen(smokerBlockScreenFactory(inventory.unsafeGet, propertyDelegate.unsafeGet,
    experienceContainer.unsafeGet), some(args.position))
  barConsume

proc smokerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc smokerBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  args.world.addBlockEntity(newSmokerBlockEntity(args.position))

proc smokerBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let experienceContainer = blockEntity.unsafeGet.toExperienceContainer()
    if experienceContainer.isSome:
      let xp = experienceContainer.unsafeGet.extractExperience()
      if xp > 0:
        args.world.spawnExperienceOrb(args.position.toF64(), uint32(xp))
  args.world.removeBlockEntity(args.position)

proc smokerBlockGetComparatorOutput_BlockBehaviour(args: GetComparatorOutputArgs): Option[uint8] =
  let blockEntity = args.world.getBlockEntity(args.position)
  if blockEntity.isSome:
    let inventory = blockEntity.unsafeGet.getInventory()
    if inventory.isSome:
      return some(calculateComparatorOutput(inventory.unsafeGet))
  none[uint8]()

proc newSmokerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = smokerBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = smokerBlockOnPlace_BlockBehaviour
  result.placedImpl = smokerBlockPlaced_BlockBehaviour
  result.brokenImpl = smokerBlockBroken_BlockBehaviour
  result.getComparatorOutputImpl = smokerBlockGetComparatorOutput_BlockBehaviour

proc registerBlocksSmoker*(r: BlockRegistry) =
  r.register("minecraft:smoker", newSmokerBlock())
