proc createScreenHandler*(self: SmokerScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let concreteHandler = newFurnaceLikeScreenHandler(syncId, playerInventory, self.inventory, self.propertyDelegate, self.experienceContainer, WindowType.Smoker)
  let concreteArc = concreteHandler
  some(SharedScreenHandler(concreteArc))

proc getDisplayName*(self: SmokerScreenFactory): TextComponent =
