proc smokerBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  block chain5:
    let t1 = args.world.getBlockEntity(args.position)
    if t1.isSome:
      let blockEntity = t1.unsafeGet
      let t2 = t1.unsafeGet.getInventory()
      if t2.isSome:
        let inventory = t2.unsafeGet
        let t3 = t1.unsafeGet.toPropertyDelegate()
        if t3.isSome:
          let propertyDelegate = t3.unsafeGet
          let t4 = t1.unsafeGet.toExperienceContainer()
          if t4.isSome:
            let experienceContainer = t4.unsafeGet
            args.player.incrementStat(scCustom, int32(csInteractWithSmoker), 1)
            let smokerScreenFactory = newSmokerScreenFactory(t2.unsafeGet, t3.unsafeGet, t4.unsafeGet)
            args.player.openHandledScreen(smokerScreenFactory, some(args.position))
  barConsume

proc smokerBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var props = FurnaceLikeProperties.defaultFor(args.block0)
  props.facing = args.player.livingEntity.entity.getHorizontalFacing().opposite()
  props.toStateId(args.block0)

proc smokerBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let smokerBlockEntity = newSmokerBlockEntity(args.position)
  args.world.addBlockEntity(smokerBlockEntity)

proc smokerBlockBroken_BlockBehaviour(args: BrokenArgs) =
  # Extract and drop accumulated XP as orbs before removing the block entity
  block chain8:
    let t6 = args.world.getBlockEntity(args.position)
    if t6.isSome:
      let blockEntity = t6.unsafeGet
      let t7 = t6.unsafeGet.toExperienceContainer()
      if t7.isSome:
        let experienceContainer = t7.unsafeGet
        let xp = t7.unsafeGet.extractExperience()
        if (xp > 0):
          let pos = args.position.toF64()
          ExperienceOrbEntity.spawn(args.world, pos, uint32(xp))
  args.world.removeBlockEntity(args.position)

