## Port of pumpkin/src/block/blocks/snow.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  LayeredSnowBlock* = object



proc layeredSnowBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc layeredSnowBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc layeredSnowBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs)
proc layeredSnowBlockRandomTick_BlockBehaviour(args: RandomTickArgs)
proc layeredSnowBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newLayeredSnowBlock*(): BlockBehaviour
proc canPlaceAt*(blockAccessor: BlockWorld, position: BlockPos): bool

proc layeredSnowBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    return blockAir().defaultState.id
  var props = SnowLikeProperties.defaultFor(args.block0)
  props.layers = 1
  props.toStateId(blockSnow())

proc layeredSnowBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let t1 = block:
    args.itemStack.stack.item
  let item = t1
  if (item == ITEM_SNOW):
    let t2 = block:
      if args.hit.face.isHorizontal():
        args.position.offset(args.hit.face.toOffset())
      else:
        args.position
    let pos = t2
    if (not canPlaceAt(args.world, pos)):
      return barPass
    let (blockRef, stateId) = args.world.getBlockAndStateId(pos)
    if (not (blockRef == blockSnow())):
      return barPass
    var props = SnowLikeProperties.fromStateId(stateId, blockSnow())
    if (props.layers >= 8):
      discard args.world.setBlockState(pos, blockSnowBlock().defaultState.id, BfNotifyAll)
      return barSuccess
    props.layers += 1
    let stateId1 = props.toStateId(blockSnow())
    discard args.world.setBlockState(pos, stateId1, BfNotifyAll)
    return barSuccess
  barPass

proc layeredSnowBlockOnScheduledTick_BlockBehaviour(args: OnScheduledTickArgs) =
  if (not canPlaceAt(args.world, args.position)):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc layeredSnowBlockRandomTick_BlockBehaviour(args: RandomTickArgs) =
  # Snow layers melt when lit by block light above level 11,
  # e.g. from a nearby torch.
  if (args.world.getBlockLightLevel(args.position).get(0) > 11):
    discard args.world.breakBlock(args.position, nil, 0'u32)

proc layeredSnowBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if (not canPlaceAt(args.world, args.position)):
    args.world.scheduleBlockTick(args.block0, args.position, 1, tpNormal)
  args.stateId

proc newLayeredSnowBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = layeredSnowBlockOnPlace_BlockBehaviour
  result.useWithItemImpl = layeredSnowBlockUseWithItem_BlockBehaviour
  result.onScheduledTickImpl = layeredSnowBlockOnScheduledTick_BlockBehaviour
  result.randomTickImpl = layeredSnowBlockRandomTick_BlockBehaviour
  result.getStateForNeighborUpdateImpl = layeredSnowBlockGetStateForNeighborUpdate_BlockBehaviour

proc canPlaceAt*(blockAccessor: BlockWorld, position: BlockPos): bool =
  let belowPos = position.down()
  let (belowBlock, state) = blockAccessor.getBlockAndState(belowPos)
  if belowBlock.hasTag(Block_MINECRAFT_CANNOT_SUPPORT_SNOW_LAYER):
    return false
  if belowBlock.hasTag(Block_MINECRAFT_SUPPORT_OVERRIDE_SNOW_LAYER):
    return true
  # Block.isFaceFullSquare(collisionShape, Direction.UP): the collision shape must fully cover
  # the top face, e.g. leaves are not "side solid" but do support snow layers.
  var fullTop = false
  for shape in state.getBlockCollisionShapes():
    if shape.maxY >= 1.0 and shape.minX <= 0.0 and shape.maxX >= 1.0 and shape.minZ <= 0.0 and shape.maxZ >= 1.0:
      fullTop = true
      break
  fullTop or (belowBlock == blockSnow() and SnowLikeProperties.fromStateId(state.id, belowBlock).layers == 8'u8)

proc registerBlocksSnow*(r: BlockRegistry) =
  r.register("minecraft:snow", newLayeredSnowBlock())

