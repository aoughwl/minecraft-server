## Port of pumpkin/src/block/blocks/spawner.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../entities/mob_spawner

type
  SpawnerBlock* = object

proc spawnerBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let spawnerBlockEntity = newMobSpawnerBlockEntity(args.position, none[string]())
  args.world.addBlockEntity(spawnerBlockEntity)

proc newSpawnerBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = spawnerBlockPlaced_BlockBehaviour

proc registerBlocksSpawner*(r: BlockRegistry) =
  r.register("minecraft:spawner", newSpawnerBlock())
