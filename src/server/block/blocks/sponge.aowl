import ../blockprelude
import ../../../generated/dimension


type
  SpongeBlock* = object
  WetSpongeBlock* = object



proc absorbWater*(world: BlockWorld, position: BlockPos): bool
proc spongeBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc spongeBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newSpongeBlock*(): BlockBehaviour
proc wetSpongeBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc newWetSpongeBlock*(): BlockBehaviour

proc absorbWater*(world: BlockWorld, position: BlockPos): bool =
  # Upstream's `VecDeque` is a seq walked by a head index; its `HashSet<BlockPos>` is a table keyed by the offset from the
  # sponge, which is at most 7 in each axis (taxicab distance), so the key is exact.
  var waterBlocks: seq[BlockPos] = @[]
  var visited = initTable[int32, bool]()
  var queue: seq[BlockPos] = @[]
  var head = 0
  proc visitKey(p: BlockPos): int32 {.closure.} =
    ((p.vec.x - position.vec.x + 8'i32) * 17'i32 + (p.vec.y - position.vec.y + 8'i32)) * 17'i32 + (p.vec.z - position.vec.z + 8'i32)
  # Start from the sponge position
  queue.add(position)
  visited[visitKey(position)] = true
  while head < queue.len:
    let currentPos = queue[head]
    head += 1
    for direction in [[1'i32, 0'i32, 0'i32], [-1'i32, 0'i32, 0'i32], [0'i32, 1'i32, 0'i32], [0'i32, -1'i32, 0'i32],
        [0'i32, 0'i32, 1'i32], [0'i32, 0'i32, -1'i32]]:
      let nextPos = newBlockPos(currentPos.vec.x + direction[0], currentPos.vec.y + direction[1], currentPos.vec.z + direction[2])
      let taxicabDist = abs(nextPos.vec.x - position.vec.x) + abs(nextPos.vec.y - position.vec.y) + abs(nextPos.vec.z - position.vec.z)
      # Wiki standard: distance 7, max 118 blocks
      if taxicabDist > 7'i32 or waterBlocks.len >= 118:
        continue
      if visited.hasKey(visitKey(nextPos)):
        continue
      visited[visitKey(nextPos)] = true
      let (blockRef, state) = world.getBlockAndState(nextPos)
      # Only add to queue if it's water.
      # This prevents "jumping" through air or solid blocks.
      if blockRef.id == blockWater().id:
        waterBlocks.add(nextPos)
        queue.add(nextPos)
  if waterBlocks.len == 0:
    return false
  for waterPos in waterBlocks:
    discard world.setBlockState(waterPos, blockStateIdAir, BfNotifyAll)
  discard world.setBlockState(position, blockWetSponge().defaultState.id, BfNotifyAll)
  world.playBlockSound(sdBlockSpongeAbsorb, scBlocks, position)
  true

proc spongeBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  # Attempt to absorb water on placement
  discard absorbWater(args.world, args.position)

proc spongeBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  # If a neighboring block changed and it's water, attempt to absorb.
  if (args.sourceBlock.id == blockWater().id):
    discard absorbWater(args.world, args.position)

proc newSpongeBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = spongeBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = spongeBlockOnNeighborUpdate_BlockBehaviour

proc wetSpongeBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  # Check if placed in Nether, if so, dry out
  if (args.world.dimension == THE_NETHER):
    discard args.world.setBlockState(args.position, blockSponge().defaultState.id, BfNotifyAll)
    # Play dry sound and spawn smoke particles
    args.world.playBlockSound(sdBlockWetSpongeDries, scBlocks, args.position)
    args.world.spawnParticle(vec3[float64](float64(args.position.vec.x) + 0.5, float64(args.position.vec.y) + 1.0, float64(args.position.vec.z) + 0.5), vec3[float64](0.25, 0.0, 0.25), 0.01'f32, 16'i32, ptCloud)

proc newWetSpongeBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.placedImpl = wetSpongeBlockPlaced_BlockBehaviour

proc registerBlocksSponge*(r: BlockRegistry) =
  r.register("minecraft:sponge", newSpongeBlock())
  r.register("minecraft:wet_sponge", newWetSpongeBlock())

