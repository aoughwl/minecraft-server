## Port of pumpkin/src/block/blocks/stairs.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  StairsProperties = OakStairsLikeProperties
  StairBlock* = object



proc stairBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc stairBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newStairBlock*(): BlockBehaviour
proc computeStairShape*(world: BlockWorld, blockPos: BlockPos, facing: HorizontalFacing, half: Half): StairsShape
proc getStairPropertiesIfExists*(world: BlockWorld, blockPos: BlockPos): Option[StairsProperties]

proc stairBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var stairProps = StairsProperties.defaultFor(args.block0)
  stairProps.waterlogged = args.replacing.waterSource()
  stairProps.facing = args.player.getEntity().getHorizontalFacing()
  let t1 = block:
    case args.direction
    of BlockDirection.Up:
      Half.Top
    of BlockDirection.Down:
      Half.Bottom
    else:
      if args.useItemOn.cursorPos.y >= 0.0 and args.useItemOn.cursorPos.y < 0.5:
        Half.Bottom
      elif args.useItemOn.cursorPos.y >= 0.5 and args.useItemOn.cursorPos.y < 1.0:
        Half.Top
      else:
        Half.Bottom
  stairProps.half = t1
  stairProps.shape = computeStairShape(args.world, args.position, stairProps.facing, stairProps.half)
  stairProps.toStateId(args.block0)

proc stairBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let stateId = args.world.getBlockStateId(args.position)
  var stairProps = StairsProperties.fromStateId(stateId, args.block0)
  let newShape = computeStairShape(args.world, args.position, stairProps.facing, stairProps.half)
  if (not (stairProps.shape == newShape)):
    stairProps.shape = newShape
    discard args.world.setBlockState(args.position, stairProps.toStateId(args.block0), BfNotifyAll)

proc newStairBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = stairBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = stairBlockOnNeighborUpdate_BlockBehaviour

proc computeStairShape*(world: BlockWorld, blockPos: BlockPos, facing: HorizontalFacing, half: Half): StairsShape =
  let t3 = getStairPropertiesIfExists(world, blockPos.offset(facing.rotateClockwise().toOffset()))
  var t4 = false
  if t3.isSome:
    let otherStairProps = t3.unsafeGet
    let t2 = block:
      ((otherStairProps.half == half) and (otherStairProps.facing == facing))
    t4 = t2
  let rightLocked = t4
  let t6 = getStairPropertiesIfExists(world, blockPos.offset(facing.rotateCounterClockwise().toOffset()))
  var t7 = false
  if t6.isSome:
    let otherStairProps = t6.unsafeGet
    let t5 = block:
      ((otherStairProps.half == half) and (otherStairProps.facing == facing))
    t7 = t5
  let leftLocked = t7
  if leftLocked and rightLocked:
    return StairsShape.Straight
  let t8 = getStairPropertiesIfExists(world, blockPos.offset(facing.toOffset()))
  if t8.isSome and (t8.unsafeGet.half == half):
    let otherStairProps = t8.unsafeGet
    if (not leftLocked) and (t8.unsafeGet.facing == facing.rotateClockwise()):
      return StairsShape.OuterRight
    else:
      if (not rightLocked) and (t8.unsafeGet.facing == facing.rotateCounterClockwise()):
        return StairsShape.OuterLeft
  let t9 = getStairPropertiesIfExists(world, blockPos.offset(facing.opposite().toOffset()))
  if t9.isSome and (t9.unsafeGet.half == half):
    let otherStairProps = t9.unsafeGet
    if (not rightLocked) and (t9.unsafeGet.facing == facing.rotateClockwise()):
      return StairsShape.InnerRight
    else:
      if (not leftLocked) and (t9.unsafeGet.facing == facing.rotateCounterClockwise()):
        return StairsShape.InnerLeft
  StairsShape.Straight

proc getStairPropertiesIfExists*(world: BlockWorld, blockPos: BlockPos): Option[StairsProperties] =
  let (blockRef, blockState) = world.getBlockAndStateId(blockPos)
  var t11 = none[StairsProperties]()
  if blockRef.hasTag(Block_MINECRAFT_STAIRS):
    t11 = some(StairsProperties.fromStateId(blockState, blockRef))
  t11

proc registerBlocksStairs*(r: BlockRegistry) =
  r.registerTag("minecraft:stairs", newStairBlock())

