import ../blockprelude


type
  StonecutterBlock* = object
  StonecutterScreenFactory* = object



proc stonecutterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc newStonecutterBlock*(): BlockBehaviour
proc createScreenHandler*(self: StonecutterScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler]
proc getDisplayName*(self: StonecutterScreenFactory): TextComponent

proc stonecutterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithStonecutter), 1)
  args.player.openHandledScreen(StonecutterScreenFactory, some(args.position))
  barSuccess

proc newStonecutterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = stonecutterBlockNormalUse_BlockBehaviour

proc createScreenHandler*(self: StonecutterScreenFactory, syncId: uint8, playerInventory: PlayerInventory, player: InventoryPlayer): Option[SharedScreenHandler] =
  let handler: SharedScreenHandler = newStonecutterScreenHandler(syncId, playerInventory)
  some(handler)

proc getDisplayName*(self: StonecutterScreenFactory): TextComponent =
  TextComponent.translateCross(CONTAINER_STONECUTTER, CONTAINER_STONECUTTER, [])

proc registerBlocksStonecutter*(r: BlockRegistry) =
  r.register("minecraft:stonecutter", newStonecutterBlock())

