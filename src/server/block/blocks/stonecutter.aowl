## Port of pumpkin/src/block/blocks/stonecutter.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/translation
import ../../../inventory/stonecutter_screen_handler

proc stonecutterScreenFactory(): BlockScreenFactory =
  ## `StonecutterScreenFactory`
  newScreenFactory(translateCross(JAVA_CONTAINER_STONECUTTER, BEDROCK_CONTAINER_STONECUTTER),
    proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.} =
      ScreenHandler(newStonecutterScreenHandler(syncId, playerInventory)))

proc stonecutterBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  args.player.incrementStat(scCustom, int32(csInteractWithStonecutter), 1)
  args.player.openHandledScreen(stonecutterScreenFactory(), some(args.position))
  barSuccess

proc newStonecutterBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = stonecutterBlockNormalUse_BlockBehaviour

proc registerBlocksStonecutter*(r: BlockRegistry) =
  r.register("minecraft:stonecutter", newStonecutterBlock())
