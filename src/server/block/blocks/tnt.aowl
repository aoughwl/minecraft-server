import ../blockprelude
import redstone/redstonemod

const DEFAULT_FUSE: uint32 = 80
const DEFAULT_POWER: float32 = 4.0

type
  TNTBlock* = object



proc prime*(world: BlockWorld, location: BlockPos)
proc tNTBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult
proc tNTBlockPlaced_BlockBehaviour(args: PlacedArgs)
proc tNTBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc tNTBlockExplode_BlockBehaviour(args: ExplodeArgs)
proc tNTBlockShouldDropItemsOnExplosion_BlockBehaviour(): bool
proc newTNTBlock*(): BlockBehaviour

proc prime*(world: BlockWorld, location: BlockPos) =
  let entity = newEntity(world, location.toF64(), EntityType.TNT)
  let pos = entity.pos
  let tnt = newTNTEntity(entity, DEFAULT_POWER, DEFAULT_FUSE)
  world.spawnEntity(tnt)
  world.playSound(sdEntityTntPrimed, scBlocks, pos)
  discard world.setBlockState(location, blockStateIdAir, BfNotifyAll)

proc tNTBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let item = args.itemStack.item
  if ((not (item == itemFlintAndSteel())) or (item == itemFireCharge())):
    return barPass
  let world = args.player.world()
  prime(world, args.position)
  barConsume

proc tNTBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  if blockReceivesRedstonePower(args.world, args.position):
    prime(args.world, args.position)

proc tNTBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  if blockReceivesRedstonePower(args.world, args.position):
    prime(args.world, args.position)

proc tNTBlockExplode_BlockBehaviour(args: ExplodeArgs) =
  let entity = newEntity(args.world, args.position.toF64(), EntityType.TNT)
  let angle = (randomOf(float64) * TAU)
  entity.setVelocity(newVector3(((-angle.sin()) * 0.02), 0.2, ((-angle.cos()) * 0.02)))
  let fuse = (rng().randomRange(0 ..< (DEFAULT_FUSE / 4)) + (DEFAULT_FUSE / 8))
  let tnt = newTNTEntity(entity, DEFAULT_POWER, fuse)
  args.world.spawnEntity(tnt)

proc tNTBlockShouldDropItemsOnExplosion_BlockBehaviour(): bool =
  false

proc newTNTBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.useWithItemImpl = tNTBlockUseWithItem_BlockBehaviour
  result.placedImpl = tNTBlockPlaced_BlockBehaviour
  result.onNeighborUpdateImpl = tNTBlockOnNeighborUpdate_BlockBehaviour
  result.explodeImpl = tNTBlockExplode_BlockBehaviour
  result.shouldDropItemsOnExplosionImpl = tNTBlockShouldDropItemsOnExplosion_BlockBehaviour

proc registerBlocksTnt*(r: BlockRegistry) =
  r.register("minecraft:tnt", newTNTBlock())

