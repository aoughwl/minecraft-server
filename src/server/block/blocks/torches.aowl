import ../blockprelude


type
  WallTorchProps = WallTorchLikeProperties
  TorchBlock* = object



proc torchBlockIds*(): seq[BlockId]
proc torchBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc torchBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool
proc torchBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newTorchBlock*(): BlockBehaviour
proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: BlockDirection): bool

proc torchBlockIds*(): seq[BlockId] =
  @[blockIdTorch, blockIdSoulTorch, blockIdWallTorch, blockIdSoulWallTorch, blockIdCopperTorch, blockIdCopperWallTorch]

proc torchBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  if (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if supportBlock.isCenterSolid(BlockDirection.Up):
      return args.block0.defaultState.id
  var directions = args.player.getEntity().getEntityFacingOrder()
  if (args.replacing == BlockIsReplacing(kind: BlockIsReplacingKind.kNone)):
    let face = args.direction.toFacing()
    var i = 0
    while ((i < len(directions)) and (not (directions[i] == face))):
      i += 1
    if (i > 0):
      directions.copyWithin(0 ..< i, 1)
      directions[0] = face
  elif (directions[0] == Facing.Down):
    let supportBlock1 = args.world.getBlockState(args.position.down())
    if supportBlock1.isCenterSolid(BlockDirection.Up):
      return args.block0.defaultState.id
  for dir in directions:
    if (not (dir == Facing.Up)) and (not (dir == Facing.Down)) and canPlaceAt(args.world, args.position, dir.toBlockDirection()):
      let t1 = block:
        if (args.block0 == blockTorch()):
          blockWallTorch()
        elif (args.block0 == blockSoulTorch()):
          blockSoulWallTorch()
        else:
          blockCopperWallTorch()
      let wallBlock = t1
      var torchProps = WallTorchProps.defaultFor(wallBlock)
      torchProps.facing = dir.opposite().toHorizontalFacing().get()
      return torchProps.toStateId(wallBlock)
  let supportBlock2 = args.world.getBlockState(args.position.down())
  if supportBlock2.isCenterSolid(BlockDirection.Up):
    args.block0.defaultState.id
  else:
    blockStateIdAir

proc torchBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  let supportBlock = args.blockAccessor.getBlockState(args.position.down())
  if supportBlock.isCenterSolid(BlockDirection.Up):
    return true
  let t2 = blockDirectionHorizontal()
  for dir in t2:
    if canPlaceAt(args.blockAccessor, args.position, dir.toBlockDirection()):
      return true
  false

proc torchBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  if ((args.block0 == blockWallTorch()) or ((args.block0 == blockSoulWallTorch()) or (args.block0 == blockCopperWallTorch()))):
    let props = WallTorchProps.fromStateId(args.stateId, args.block0)
    if (props.facing.toBlockDirection().opposite() == args.direction) and (not canPlaceAt(args.world, args.position, props.facing.toBlockDirection().opposite())):
      return blockStateIdAir
  elif (args.direction == BlockDirection.Down):
    let supportBlock = args.world.getBlockState(args.position.down())
    if (not supportBlock.isCenterSolid(BlockDirection.Up)):
      return blockStateIdAir
  args.stateId

proc newTorchBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = torchBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = torchBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = torchBlockGetStateForNeighborUpdate_BlockBehaviour

proc canPlaceAt*(world: BlockWorld, blockPos: BlockPos, facing: BlockDirection): bool =
  world.getBlockState(blockPos.offset(facing.toOffset())).isSideSolid(facing.opposite())

proc registerBlocksTorches*(r: BlockRegistry) =
  r.registerIds(torchBlockIds(), newTorchBlock())

