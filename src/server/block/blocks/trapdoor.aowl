## Port of pumpkin/src/block/blocks/trapdoor.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import redstone/redstonemod


type
  TrapDoorProperties = OakTrapdoorLikeProperties
  TrapDoorBlock* = object



proc toggleTrapdoor*(player: BlockPlayer, world: BlockWorld, blockPos: BlockPos)
proc canOpenTrapdoor*(blockRef: Block): bool
proc getSound*(blockRef: Block, open: bool): Sound
proc trapDoorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult
proc trapDoorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc trapDoorBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs)
proc newTrapDoorBlock*(): BlockBehaviour

proc toggleTrapdoor*(player: BlockPlayer, world: BlockWorld, blockPos: BlockPos) =
  let (blockRef, blockState) = world.getBlockAndStateId(blockPos)
  var trapdoorProps = TrapDoorProperties.fromStateId(blockState, blockRef)
  trapdoorProps.open = (not trapdoorProps.open)
  world.playBlockSoundExpect(player, getSound(blockRef, trapdoorProps.open), scBlocks, blockPos)
  discard world.setBlockState(blockPos, trapdoorProps.toStateId(blockRef), BfNotifyListeners)

proc canOpenTrapdoor*(blockRef: Block): bool =
  if (blockRef == blockIronTrapdoor()):
    return false
  true

proc getSound*(blockRef: Block, open: bool): Sound =
  if open:
    if blockRef.hasTag(Block_MINECRAFT_WOODEN_TRAPDOORS):
      sdBlockWoodenTrapdoorOpen
    elif (blockRef == blockIronTrapdoor()):
      sdBlockIronTrapdoorOpen
    else:
      sdBlockCopperTrapdoorOpen
  elif blockRef.hasTag(Block_MINECRAFT_WOODEN_TRAPDOORS):
    sdBlockWoodenTrapdoorClose
  elif (blockRef == blockIronTrapdoor()):
    sdBlockIronTrapdoorClose
  else:
    sdBlockCopperTrapdoorClose

proc trapDoorBlockNormalUse_BlockBehaviour(args: NormalUseArgs): BlockActionResult =
  if (not canOpenTrapdoor(args.block0)):
    return barPass
  toggleTrapdoor(args.player, args.world, args.position)
  barSuccess

proc trapDoorBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var trapdoorProps = TrapDoorProperties.defaultFor(args.block0)
  trapdoorProps.waterlogged = args.replacing.waterSource()
  let powered = blockReceivesRedstonePower(args.world, args.position)
  let playerFacing = args.player.getEntity().getHorizontalFacing()
  # Correct facing logic using Option unwrap
  let facing = args.direction.toHorizontalFacing().get(playerFacing)
  trapdoorProps.facing = facing
  let t1 = block:
    case args.direction
    of BlockDirection.Up:
      Half.Top
    of BlockDirection.Down:
      Half.Bottom
    else:
      if args.useItemOn.cursorPos.y >= 0.0 and args.useItemOn.cursorPos.y < 0.5:
        Half.Bottom
      else:
        Half.Top
  trapdoorProps.half = t1
  trapdoorProps.powered = powered
  trapdoorProps.open = powered
  trapdoorProps.toStateId(args.block0)

proc trapDoorBlockOnNeighborUpdate_BlockBehaviour(args: OnNeighborUpdateArgs) =
  let blockState = args.world.getBlockState(args.position)
  var trapdoorProps = TrapDoorProperties.fromStateId(blockState.id, args.block0)
  let powered = blockReceivesRedstonePower(args.world, args.position)
  if (powered != trapdoorProps.powered):
    trapdoorProps.powered = (not trapdoorProps.powered)
    if (powered != trapdoorProps.open):
      trapdoorProps.open = trapdoorProps.powered
      args.world.playBlockSound(getSound(args.block0, powered), scBlocks, args.position)
  discard args.world.setBlockState(args.position, trapdoorProps.toStateId(args.block0), BfNotifyListeners)

proc newTrapDoorBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.normalUseImpl = trapDoorBlockNormalUse_BlockBehaviour
  result.onPlaceImpl = trapDoorBlockOnPlace_BlockBehaviour
  result.onNeighborUpdateImpl = trapDoorBlockOnNeighborUpdate_BlockBehaviour

proc registerBlocksTrapdoor*(r: BlockRegistry) =
  r.registerTag("minecraft:trapdoors", newTrapDoorBlock())

