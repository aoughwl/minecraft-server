proc vineBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  let t1 = args.replacing
  if t1.kind == BlockIsReplacingKind.kItself:
    let stateId = t1.f0Itself
    let t2 = getAccurateDirection(args.world, args.position, some(args.player), args.direction, true)
    if not (t2[0].isSome):
      return blockAir().defaultState.id
    let direction = t2[0].unsafeGet
    var props = VineLikeProperties.fromStateId(t1.f0Itself, args.block0)
    vineDirectionMapper(direction, props)
    return props.toStateId(args.block0)
  let t3 = getAccurateDirection(args.world, args.position, some(args.player), args.direction, false)
  if not (t3[0].isSome):
    return blockAir().defaultState.id
  let direction = t3[0].unsafeGet
  var props1 = VineLikeProperties.defaultFor(args.block0)
  vineDirectionMapper(direction, props1)
  props1.toStateId(args.block0)

proc vineBlockCanPlaceAt_BlockBehaviour(args: CanPlaceAtArgs): bool =
  canPlaceVineAt(args.blockAccessor, args.position, args.direction, args.player, false)

proc vineBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let oldProps = VineLikeProperties.fromStateId(args.stateId, args.block0)
  let oldDirections = getVineBlockDirections(oldProps)
  var newDirections = oldDirections
  for oldDir in oldDirections:
    let supportBlock = args.world.getBlock(args.position.offset(oldDir.toOffset()))
    if (not supportsVine(supportBlock)) and (not isTopBlockFullVine(args.world, args.position)):
      newDirections.remove(oldDir)
  if isEmpty(newDirections):
    return blockAir().defaultState.id
  var newProps = VineLikeProperties.defaultFor(args.block0)
  for newDir in newDirections:
    vineDirectionMapper(newDir, newProps)
  newProps.toStateId(args.block0)

proc vineBlockCanUpdateAt_BlockBehaviour(args: CanUpdateAtArgs): bool =
  getAccurateDirection(args.world, args.position, some(args.player), args.direction, true)[0].isSome()

proc vineBlockUseWithItem_BlockBehaviour(args: UseWithItemArgs): BlockActionResult =
  let state = args.world.getBlockState(args.position)
  var props = VineLikeProperties.fromStateId(state.id, args.block0)
  let item = args.itemStack.item
  drop(args.itemStack)
  if (not (item.id == itemVine().id)):
    return barPass
  let t4 = getAccurateDirection(args.world, args.position, some(args.player), BlockDirection.Down, true)
  if not (t4[0].isSome):
    return barFail
  let accurateDir = t4[0].unsafeGet
  vineDirectionMapper(accurateDir, props)
  discard args.world.setBlockState(args.position, props.toStateId(args.block0), BfNotifyAll)
  barConsume

proc newVineBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = vineBlockOnPlace_BlockBehaviour
  result.canPlaceAtImpl = vineBlockCanPlaceAt_BlockBehaviour
  result.getStateForNeighborUpdateImpl = vineBlockGetStateForNeighborUpdate_BlockBehaviour
  result.canUpdateAtImpl = vineBlockCanUpdateAt_BlockBehaviour
  result.useWithItemImpl = vineBlockUseWithItem_BlockBehaviour

proc getNearestLookingDirections*(player: BlockPlayer, replaceClicked: bool, clickedFace: BlockDirection): array[6, BlockDirection] =
  let t5 = block:
    let fs = player.getEntity().getEntityFacingOrder()
    [fs[0].toBlockDirection(), fs[1].toBlockDirection(), fs[2].toBlockDirection(), fs[3].toBlockDirection(), fs[4].toBlockDirection(), fs[5].toBlockDirection()]
  var directions: array[6, BlockDirection] = t5
  if (not replaceClicked):
    let target = clickedFace.opposite()
    var index = 0
    while ((index < len(directions)) and (not (directions[index] == target))):
      index += 1
    if (index > 0):
      directions.copyWithin(0 ..< index, 1)
      directions[0] = target
  directions

proc canPlaceVineAt*(blockAccessor: BlockWorld, blockPos: BlockPos, clickDirectionWrapper: Option[BlockDirection], playerWrapper: Option[BlockPlayer], replacing: bool): bool =
  let t6 = clickDirectionWrapper
  if not (t6.isSome):
    return false
  let clickDirection = t6.unsafeGet
  let (direction, _) = getAccurateDirection(blockAccessor, blockPos, playerWrapper, clickDirection, replacing)
  let t7 = direction
  if not (t7.isSome):
    return false
  let direction = t7.unsafeGet
  let supportPos = blockPos.offset(direction.toOffset())
  let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(supportPos)
  if (not supportsVine(supportBlock)) and (not isTopBlockFullVine(blockAccessor, blockPos)):
    return false
  true

proc supportsVine*(supportBlock: Block): bool =
  if supportBlock.defaultState.isFullCube():
    return true
  false

proc getAccurateDirection*(blockAccessor: BlockWorld, blockPos: BlockPos, playerWrapper: Option[BlockPlayer], clickDirection: BlockDirection, replacing: bool): (Option[BlockDirection], bool) =
  let clickedBlock = blockAccessor.getBlock(blockPos.offset(clickDirection.toOffset()))
  if (not replacing) and (clickedBlock == blockVine()) and (not (clickDirection == BlockDirection.Up)):
    return (R2A_NONE, false)
  if (not (clickDirection == BlockDirection.Down)) and supportsVine(clickedBlock):
    return (some(clickDirection), false)
  let (replacingBlock, replacingBlockState) = blockAccessor.getBlockAndState(blockPos)
  let t8 = block:
    if (replacingBlock == blockVine()):
      let props = VineLikeProperties.fromStateId(replacingBlockState.id, replacingBlock)
      getVineBlockDirections(props)
    else:
      newHashSet()
  let alreadyActiveDirections = t8
  let t9 = playerWrapper
  if t9.isSome:
    let player = t9.unsafeGet
    var up = false
    let t10 = getNearestLookingDirections(t9.unsafeGet, replacing, clickDirection)
    for dir in t10:
      if (not (dir == BlockDirection.Down)) and (not contains(alreadyActiveDirections, dir)):
        let supportPos = blockPos.offset(dir.toOffset())
        let (supportBlock, supportBlockState) = blockAccessor.getBlockAndState(supportPos)
        if (not supportsVine(supportBlock)):
          # handler for hanging vine
          if isTopBlockFullVine(blockAccessor, blockPos):
            if (dir == BlockDirection.Up):
              continue
            return (some(dir), true)
          continue
        if (dir == BlockDirection.Up) and (not replacing):
          up = true
          continue
        return (some(dir), false)
    if up:
      return (some(BlockDirection.Up), false)
  (R2A_NONE, false)

proc isTopBlockFullVine*(blockAccessor: BlockWorld, blockPos: BlockPos): bool =
  let (topBlock, topBlockState) = blockAccessor.getBlockAndState(blockPos.up())
  if (not (topBlock == blockVine())):
    return false
  let props = VineLikeProperties.fromStateId(topBlockState.id, topBlock)
  ((((props.up and props.west) and props.east) and props.north) and props.south)

proc getVineBlockDirections*(props: VineLikeProperties): HashSet[BlockDirection] =
  var set = newHashSet()
  if props.north:
    set.insert(BlockDirection.North)
  if props.south:
    set.insert(BlockDirection.South)
  if props.east:
    set.insert(BlockDirection.East)
  if props.west:
    set.insert(BlockDirection.West)
  if props.up:
    set.insert(BlockDirection.Up)
  set

proc vineDirectionMapper*(direction: BlockDirection, props: VineLikeProperties) =
  case direction
  of BlockDirection.Down:
    discard
  of BlockDirection.Up:
    props.up = true
  of BlockDirection.North:
    props.north = true
  of BlockDirection.South:
    props.south = true
  of BlockDirection.West:
    props.west = true
  of BlockDirection.East:
    props.east = true

proc registerBlocksVine*(r: BlockRegistry) =
  r.register("minecraft:vine", newVineBlock())

