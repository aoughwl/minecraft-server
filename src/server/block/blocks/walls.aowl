## Port of pumpkin/src/block/blocks/walls.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude


type
  FenceGateProperties = OakFenceGateLikeProperties
  FenceLikeProperties = OakFenceLikeProperties
  WallProperties = ResinBrickWallLikeProperties
  WallBlock* = object
  WallShape* {.pure.} = enum
    None
    Low
    Tall



proc wallBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId
proc wallBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId
proc newWallBlock*(): BlockBehaviour
proc computeWallState*(wallProps: WallProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId
proc isConnected*(blockRef: Block, direction: HorizontalFacing, otherBlock: Block, otherBlockState: BlockState): bool
proc northWallOf*(value: WallShape): NorthWall
proc southWallOf*(value: WallShape): SouthWall
proc eastWallOf*(value: WallShape): EastWall
proc westWallOf*(value: WallShape): WestWall

proc wallBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  var wallProps = WallProperties.defaultFor(args.block0)
  wallProps.waterlogged = args.replacing.waterSource()
  computeWallState(wallProps, args.world, args.block0, args.position)

proc wallBlockGetStateForNeighborUpdate_BlockBehaviour(args: GetStateForNeighborUpdateArgs): BlockStateId =
  let wallProps = WallProperties.fromStateId(args.stateId, args.block0)
  computeWallState(wallProps, args.world, args.block0, args.position)

proc newWallBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = wallBlockOnPlace_BlockBehaviour
  result.getStateForNeighborUpdateImpl = wallBlockGetStateForNeighborUpdate_BlockBehaviour

proc computeWallState*(wallProps: WallProperties, world: BlockWorld, blockRef: Block, blockPos: BlockPos): BlockStateId =
  var wallProps = wallProps
  let (blockAbove, blockAboveState) = world.getBlockAndState(blockPos.up())
  let t1 = HorizontalFacing.all()
  for direction in t1:
    let otherBlockPos = blockPos.offset(direction.toOffset())
    let (otherBlock, otherBlockState) = world.getBlockAndState(otherBlockPos)
    let connected = isConnected(blockRef, direction, otherBlock, otherBlockState)
    let t2 = block:
      if connected:
        let t3 = block:
          if blockAboveState.isFullCube():
            true
          elif blockAbove.hasTag(Block_MINECRAFT_WALLS):
            let otherProps = WallProperties.fromStateId(blockAboveState.id, blockAbove)
            case direction
            of HorizontalFacing.North:
              (not (otherProps.north == NorthWall.None))
            of HorizontalFacing.South:
              (not (otherProps.south == SouthWall.None))
            of HorizontalFacing.East:
              (not (otherProps.east == EastWall.None))
            of HorizontalFacing.West:
              (not (otherProps.west == WestWall.None))
          elif (blockAbove.hasTag(Block_C_GLASS_PANES) or (blockAbove.hasTag(Block_MINECRAFT_FENCES) or (blockAbove == blockIronBars()))):
            let otherProps1 = FenceLikeProperties.fromStateId(blockAboveState.id, blockAbove)
            case direction
            of HorizontalFacing.North:
              otherProps1.north
            of HorizontalFacing.South:
              otherProps1.south
            of HorizontalFacing.East:
              otherProps1.east
            of HorizontalFacing.West:
              otherProps1.west
          elif blockAbove.hasTag(Block_MINECRAFT_FENCE_GATES):
            let otherProps2 = FenceGateProperties.fromStateId(blockAboveState.id, blockAbove)
            # gate is perp to connected direction
            let perpendicularGate = ((direction == otherProps2.facing.rotateClockwise()) or (direction == otherProps2.facing.rotateCounterClockwise()))
            (perpendicularGate and (not otherProps2.open))
          else:
            false
        let raised = t3
        if raised:
          WallShape.Tall
        else:
          WallShape.Low
      else:
        WallShape.None
    let shape = t2
    case direction
    of HorizontalFacing.North:
      wallProps.north = northWallOf(shape)
    of HorizontalFacing.South:
      wallProps.south = southWallOf(shape)
    of HorizontalFacing.East:
      wallProps.east = eastWallOf(shape)
    of HorizontalFacing.West:
      wallProps.west = westWallOf(shape)
  let connectedNorthSouth = ((((not (wallProps.north == NorthWall.None)) and (not (wallProps.south == SouthWall.None))) and (wallProps.east == EastWall.None)) and (wallProps.west == WestWall.None))
  let connectedEastWest = ((((wallProps.north == NorthWall.None) and (wallProps.south == SouthWall.None)) and (not (wallProps.east == EastWall.None))) and (not (wallProps.west == WestWall.None)))
  let cross = ((((not (wallProps.north == NorthWall.None)) and (not (wallProps.south == SouthWall.None))) and (not (wallProps.east == EastWall.None))) and (not (wallProps.west == WestWall.None)))
  let t4 = block:
    if (not (((cross or connectedNorthSouth) or connectedEastWest))):
      true
    elif blockAbove.hasTag(Block_MINECRAFT_WALLS):
      let otherProps3 = WallProperties.fromStateId(blockAboveState.id, blockAbove)
      otherProps3.up
    elif blockAbove.hasTag(Block_MINECRAFT_FENCE_GATES):
      let otherProps4 = FenceGateProperties.fromStateId(blockAboveState.id, blockAbove)
      if otherProps4.open:
        false
      else:
        case otherProps4.facing
        of HorizontalFacing.East, HorizontalFacing.West:
          connectedEastWest
        of HorizontalFacing.South, HorizontalFacing.North:
          connectedNorthSouth
    else:
      false
  wallProps.up = t4
  wallProps.toStateId(blockRef)

proc isConnected*(blockRef: Block, direction: HorizontalFacing, otherBlock: Block, otherBlockState: BlockState): bool =
  var connected = ((((((otherBlock == blockRef) or ((otherBlockState.isSolid() and otherBlockState.isFullCube()))) or otherBlockState.isSideSolid(BlockDirection.fromCardinalDirection(direction.opposite()))) or otherBlock.hasTag(Block_MINECRAFT_WALLS)) or (otherBlock == blockIronBars())) or otherBlock.hasTag(Block_C_GLASS_PANES))
  # fence gates do not pass is_side_solid check
  if (not connected) and otherBlock.hasTag(Block_MINECRAFT_FENCE_GATES):
    let fenceProps = FenceGateProperties.fromStateId(otherBlockState.id, otherBlock)
    if ((fenceProps.facing == direction.rotateClockwise()) or (fenceProps.facing == direction.rotateCounterClockwise())):
      connected = true
  connected

proc northWallOf*(value: WallShape): NorthWall =
  if value == WallShape.None:
    NorthWall.None
  elif value == WallShape.Low:
    NorthWall.Low
  elif value == WallShape.Tall:
    NorthWall.Tall
  else:
    rustPanic("non-exhaustive")

proc southWallOf*(value: WallShape): SouthWall =
  if value == WallShape.None:
    SouthWall.None
  elif value == WallShape.Low:
    SouthWall.Low
  elif value == WallShape.Tall:
    SouthWall.Tall
  else:
    rustPanic("non-exhaustive")

proc eastWallOf*(value: WallShape): EastWall =
  if value == WallShape.None:
    EastWall.None
  elif value == WallShape.Low:
    EastWall.Low
  elif value == WallShape.Tall:
    EastWall.Tall
  else:
    rustPanic("non-exhaustive")

proc westWallOf*(value: WallShape): WestWall =
  if value == WallShape.None:
    WestWall.None
  elif value == WallShape.Low:
    WestWall.Low
  elif value == WallShape.Tall:
    WestWall.Tall
  else:
    rustPanic("non-exhaustive")

proc registerBlocksWalls*(r: BlockRegistry) =
  r.registerTag("minecraft:walls", newWallBlock())

