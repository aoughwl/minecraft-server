## Port of pumpkin/src/block/blocks/wither_skull.rs
## `WitherEntity::new(Entity::new(..))` and `spawn_entity` are `spawnEntity` of the wither's type, which makes the entity the
## world's own way (worldhooks.aowl).

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/syncio
import ../blockprelude
import ../entities/skull
import skull_block

type
  WitherSkeletonSkullBlock* = object

proc isSoulBlock(blockRef: Block): bool =
  sameBlock(blockRef, blockSoulSand()) or sameBlock(blockRef, blockSoulSoil())

proc isSkull(blockRef: Block): bool =
  sameBlock(blockRef, blockWitherSkeletonSkull())

proc witherSkeletonSkullBlockOnPlace_BlockBehaviour(args: OnPlaceArgs): BlockStateId =
  skullBlockOnPlace_BlockBehaviour(args)

proc witherSkeletonSkullBlockPlaced_BlockBehaviour(args: PlacedArgs) =
  let entity = newSkullBlockEntity(args.position)
  args.world.addBlockEntity(entity)
  let world = args.world
  let pos = args.position
  for dir in [BlockDirection.North, BlockDirection.West]:
    let opposite = dir.opposite()
    for offset in 0 ..< 3:
      var centerSkullPos = pos
      case offset
      of 0:
        centerSkullPos = pos
      of 1:
        centerSkullPos = pos.offset(opposite.toOffset())
      of 2:
        centerSkullPos = pos.offset(dir.toOffset())
      else:
        echo "Invalid offset in wither skull check: ", offset
        centerSkullPos = pos
      let topMiddle = centerSkullPos.down()
      let base = topMiddle.down()
      let arm1 = topMiddle.offset(dir.toOffset())
      let arm2 = topMiddle.offset(opposite.toOffset())
      let skull1Pos = arm1.up()
      let skull2Pos = arm2.up()
      if isSoulBlock(world.getBlock(topMiddle)) and isSoulBlock(world.getBlock(base)) and isSoulBlock(world.getBlock(arm1)) and
          isSoulBlock(world.getBlock(arm2)) and isSkull(world.getBlock(centerSkullPos)) and isSkull(world.getBlock(skull1Pos)) and
          isSkull(world.getBlock(skull2Pos)):
        let pattern = [centerSkullPos, skull1Pos, skull2Pos, topMiddle, arm1, arm2, base]
        for p in pattern:
          discard world.setBlockState(p, blockAir().defaultState.id, BfNotifyAll)
          world.syncWorldEvent(weParticlesDestroyBlock, p, int32(asU16(blockSoulSand().defaultState.id)))
        discard world.spawnEntity("wither", topMiddle.toCenteredF64())
        return

proc newWitherSkeletonSkullBlock*(): BlockBehaviour =
  result = newBlockBehaviour()
  result.onPlaceImpl = witherSkeletonSkullBlockOnPlace_BlockBehaviour
  result.placedImpl = witherSkeletonSkullBlockPlaced_BlockBehaviour

proc registerBlocksWitherSkull*(r: BlockRegistry) =
  r.register("wither_skeleton_skull", newWitherSkeletonSkullBlock())
