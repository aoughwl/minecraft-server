## Round-trip test for blockstateid.aowl, against src/generated/blockprops.aowl: oak_log and iron_chain, whose ids are
## 26.2's, as assets/blocks.json has them.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/assertions
import std/syncio
import blockstateid
import blockprelude
import blocks/chain

# oak_log: firstStateId 136, defaultStateId 137, single "axis" property
# (values x/y/z). Default axis is "y" (offset 1 = defaultStateId - firstStateId).
block:
  let r = resolveStateId("oak_log", @[("axis", "x")])
  assert r.ok
  assert r.stateId == 136, "axis=x should be firstStateId + 0"

  let r2 = resolveStateId("oak_log", @[("axis", "y")])
  assert r2.ok
  assert r2.stateId == 137, "axis=y should be the default state"

  let r3 = resolveStateId("oak_log", @[("axis", "z")])
  assert r3.ok
  assert r3.stateId == 138, "axis=z should be firstStateId + 2"

  # Omitting the property falls back to the real default (axis=y).
  let r4 = resolveStateId("oak_log", @[])
  assert r4.ok
  assert r4.stateId == 137, "no axis specified should resolve to the default state"

  let (defOk, defId) = defaultStateId("oak_log")
  assert defOk and defId == 137

# Reverse direction: decode a state id back into property values.
block:
  let p = statePropValues("oak_log", 136)
  assert p.ok
  assert p.values.len == 1
  assert p.values[0] == ("axis", "x")

  let p2 = statePropValues("oak_log", 138)
  assert p2.ok
  assert p2.values[0] == ("axis", "z")

# Unknown block / out-of-range state id both fail cleanly.
block:
  let bad = resolveStateId("this_block_does_not_exist", @[])
  assert not bad.ok

  let badState = statePropValues("oak_log", -5)
  assert not badState.ok

# blocks/chain.aowl: iron_chain has two properties (axis, waterlogged), a genuine multi-property permutation.
block:
  let b = newChainBlock()
  let dry = BlockIsReplacing(kind: BlockIsReplacingKind.kOther)
  let wet = BlockIsReplacing(kind: BlockIsReplacingKind.kWater, f0Water: 0'u8)
  let chainBlock = blockIronChain()
  let stateId = asU16(b.onPlace(OnPlaceArgs(block0: chainBlock, direction: BlockDirection.Up, replacing: dry)))
  let decoded = statePropValues("iron_chain", int(stateId))
  assert decoded.ok
  var axisVal = ""
  var waterVal = ""
  for i in 0 ..< decoded.values.len:
    let pair = decoded.values[i]
    if pair[0] == "axis": axisVal = pair[1]
    if pair[0] == "waterlogged": waterVal = pair[1]
  assert axisVal == "y", "Up should resolve to axis=y"
  assert waterVal == "false"

  let stateId2 = asU16(b.onPlace(OnPlaceArgs(block0: chainBlock, direction: BlockDirection.East, replacing: wet)))
  let decoded2 = statePropValues("iron_chain", int(stateId2))
  assert decoded2.ok
  var axisVal2 = ""
  var waterVal2 = ""
  for i in 0 ..< decoded2.values.len:
    let pair = decoded2.values[i]
    if pair[0] == "axis": axisVal2 = pair[1]
    if pair[0] == "waterlogged": waterVal2 = pair[1]
  assert axisVal2 == "x", "East should resolve to axis=x"
  assert waterVal2 == "true"
  assert stateId2 != stateId, "different placement inputs must give different state ids"

echo "blockstateid: all checks passed"
