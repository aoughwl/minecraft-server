## The brewing stand, dispenser, crafter, beacon, lectern, campfire, beehive, composter, jukebox and the hopper's suction
## (entities/ and blocks/ of the same names) over a `TestWorld`: a brew worked out from `BrewingStandBlockEntity::tick` (400
## ticks, one fuel for 20 brews, the awkward potion from a water bottle and nether wart), what each entity saves and reads
## back through NBT, a dispenser dropping an item with the velocity and delay of `drop_item`, the composter's levels, a
## beacon's pyramid, and a hopper taking a furnace's output with its experience.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import containers
import ../../inventory/window_property
import "../../data/data_component_impl/mod"
import ../../generated/recipes
import ../../generated/[potion_brewing, jukebox_song, dimension]
import blocks/[hopper, furnace, composter, campfire, beacon, lectern, jukebox, beehive, brewing_stand]
import blocks/redstone/[dispenser, crafter]
import testworld
import entities/[entitiesmod, furnace_like_block_entity, furnace, brewing_stand, dispenser, crafter, beacon, lectern, campfire, beehive,
  hopper]

proc stack(key: string; count: uint8): ItemStack =
  let item = Item.fromRegistryKey(key)
  if item == nil:
    quit(1)
  newItemStack(count, item)

proc waterBottle(): ItemStack =
  let item = Item.fromRegistryKey("potion")
  if item == nil:
    quit(1)
  let pc = PotionContentsImpl(potionId: some(int32(Potion.WATER.id)))
  newItemStackWithComponent(1'u8, item, @[PatchEntry(id: dcPotionContents, present: true, data: pc.toDyn())])

proc potionIdOf(s: ItemStack): int32 =
  let pc = s.getDataComponent(PotionContentsImpl)
  if pc[0] and pc[1].potionId.isSome: pc[1].potionId.unsafeGet else: -1'i32

proc asInv(c: ContainerInventory): Inventory =
  if c == nil:
    quit(1)
  Inventory(c)

proc roundTrip(e: BlockEntity; id: string; pos: BlockPos): BlockEntity =
  ## What a chunk save writes and `block_entity_from_nbt` reads
  var nbt = newCompound()
  e.writeNbt(nbt)
  put(nbt, "id", NbtTag(kind: ntkString, stringVal: id))
  put(nbt, "x", NbtTag(kind: ntkInt, intVal: pos.vec.x))
  put(nbt, "y", NbtTag(kind: ntkInt, intVal: pos.vec.y))
  put(nbt, "z", NbtTag(kind: ntkInt, intVal: pos.vec.z))
  blockEntityFromNbt(nbt).unsafeGet

proc brewingOf(e: BlockEntity): BrewingStandBlockEntity =
  BrewingStandBlockEntity(e)

proc run() =
  let reg = newBlockRegistry()
  registerBlocksFurnace(reg)
  registerBlocksComposter(reg)
  registerBlocksCampfire(reg)
  registerBlocksBeacon(reg)
  registerBlocksLectern(reg)
  registerBlocksJukebox(reg)
  registerBlocksBeehive(reg)
  registerBlocksBrewingStand(reg)
  registerBlocksRedstoneDispenser(reg)
  registerBlocksRedstoneCrafter(reg)
  assert reg.unknown.len == 0
  assert reg.getPumpkinBlock(blockComposter().id).isSome
  assert reg.getPumpkinBlock(blockSoulCampfire().id).isSome   # by the tag minecraft:campfires
  assert reg.getPumpkinBlock(blockBeehive().id).isSome
  assert reg.getPumpkinBlock(blockBeeNest().id).isSome
  let pos = newBlockPos(10, 64, 10)

  # --- the brewing stand: water + nether wart = awkward, in 400 ticks, one fuel for twenty brews
  let t = newTestWorld(reg)
  t.put(pos, blockBrewingStand())
  let bs = newBrewingStandBlockEntity(pos)
  let be = BlockEntity(bs)
  assert be.resourceLocation() == "minecraft:brewing_stand"
  t.world.addBlockEntity(be)
  let binv = asInv(bs.inv)
  binv.setStack(0, waterBottle())
  binv.setStack(1, waterBottle())
  binv.setStack(3, stack("nether_wart", 2'u8))
  binv.setStack(4, stack("blaze_powder", 1'u8))
  assert binv.isValidSlotFor(0, waterBottle())
  assert not binv.isValidSlotFor(0, stack("stone", 1'u8))
  assert binv.isValidSlotFor(4, stack("blaze_powder", 1'u8))
  assert not binv.isValidSlotFor(3, stack("blaze_powder", 1'u8))
  be.tick(t.world)    # fuel is taken, brewing starts
  assert bs.inv.fuel == 19'i32 and bs.inv.brewTime == 400'i32
  assert binv.getStack(4).isEmpty()
  let (bb, bstate) = t.world.getBlockAndState(pos)
  let bprops = BrewingStandLikeProperties.fromStateId(bstate.id, bb)
  assert bprops.hasBottle0 and bprops.hasBottle1 and not bprops.hasBottle2
  let pd = be.toPropertyDelegate().unsafeGet
  assert pd.getProperty(0) == 400 and pd.getProperty(1) == 19 and pd.getPropertiesSize() == 2
  for i in 0 ..< 400:
    be.tick(t.world)
  assert potionIdOf(binv.getStack(0)) == int32(Potion.AWKWARD.id)
  assert potionIdOf(binv.getStack(1)) == int32(Potion.AWKWARD.id)
  assert binv.getStack(2).isEmpty()
  assert binv.getStack(3).itemCount == 1'u8
  assert t.events.len > 0 and t.events[t.events.len - 1] == "sound " & $ord(sdBlockBrewingStandBrew)
  # gunpowder turns a potion into a splash potion, keeping its contents
  binv.setStack(3, stack("gunpowder", 1'u8))
  for i in 0 ..< 402:
    be.tick(t.world)
  assert binv.getStack(0).getItem().registryKey == "splash_potion"
  assert potionIdOf(binv.getStack(0)) == int32(Potion.AWKWARD.id)
  assert binv.getStack(3).isEmpty()
  # save and load: the brew state, the fuel and the items survive
  binv.setStack(3, stack("redstone", 1'u8))
  be.tick(t.world)
  assert bs.inv.brewTime == 0'i32   # not brewable: an awkward splash potion is no redstone's
  let loaded = brewingOf(roundTrip(be, "minecraft:brewing_stand", pos))
  assert loaded.inv.fuel == bs.inv.fuel
  assert loaded.inv.items[0].getItem().registryKey == "splash_potion"
  assert potionIdOf(loaded.inv.items[0]) == int32(Potion.AWKWARD.id)

  # --- the dispenser: a random non-empty slot, an item dropped with a velocity and a pickup delay of 40
  let t2 = newTestWorld(reg)
  var drops: seq[string] = @[]
  var dropDelay = 0'u8
  var dropVelocity = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  t2.world.spawnItemWithVelocity0 = proc(position: Vector3[float64]; stack: ItemStack; velocity: Vector3[float64]; pickupDelay: uint8) {.closure.} =
    drops.add(stack.getItem().registryKey & " " & $stack.itemCount)
    dropDelay = pickupDelay
    dropVelocity = velocity
  var props = DispenserLikeProperties.defaultFor(blockDispenser())
  props.facing = Facing.Up
  t2.put(pos, props.toStateId(blockDispenser()))
  let dp = newDispenserBlockEntity(pos)
  t2.world.addBlockEntity(BlockEntity(dp))
  assert BlockEntity(dp).resourceLocation() == "minecraft:dispenser"
  assert dp.getRandomSlot() == -1
  asInv(dp.inv).setStack(4, stack("cobblestone", 5'u8))
  assert dp.getRandomSlot() == 4
  let behaviour = reg.behaviourOf(blockDispenser().id)
  behaviour.onScheduledTick(OnScheduledTickArgs(world: t2.world, block0: blockDispenser(), position: pos))
  assert drops == @["cobblestone 1"]
  assert dropDelay == 40'u8
  assert dp.inv.items[4].itemCount == 4'u8
  assert dropVelocity.y > 0.0   # facing up
  assert t2.events.len == 2     # the dispense sound and the smoke
  # nothing to dispense: the fail sound
  let dp2 = newDispenserBlockEntity(pos)
  t2.world.addBlockEntity(BlockEntity(dp2))
  behaviour.onScheduledTick(OnScheduledTickArgs(world: t2.world, block0: blockDispenser(), position: pos))
  assert t2.events[t2.events.len - 1] == "event " & $ord(weSoundDispenserFail)
  assert drops.len == 1
  # a dispenser and a crafter round-trip their items
  asInv(dp.inv).setStack(0, stack("stone", 3'u8))
  var dpTag = newCompound()
  BlockEntity(dp).writeNbt(dpTag)
  assert dispenserBlockEntityFromNbt_BlockEntity(dpTag, pos).inv.items[0].itemCount == 3'u8
  let cr = newCrafterBlockEntity(pos)
  cr.craftingTicksRemaining = 7'i32
  cr.triggered = true
  asInv(cr.inv).setStack(8, stack("stone", 2'u8))
  let cr2 = CrafterBlockEntity(roundTrip(BlockEntity(cr), "minecraft:crafter", pos))
  assert cr2.craftingTicksRemaining == 7'i32 and cr2.triggered and cr2.inv.items[8].itemCount == 2'u8

  # --- the beacon: a 4-layer pyramid is level 4; saved and read back with its effects
  let t3 = newTestWorld(reg)
  let beaconPos = newBlockPos(0, 100, 0)
  for step in 1'i32 .. 4'i32:
    for x in -step .. step:
      for z in -step .. step:
        t3.put(newBlockPos(x, 100 - step, z), blockIronBlock())
  t3.world.dimension = OVERWORLD
  let bc = newBeaconBlockEntity(beaconPos)
  assert bc.updateBase(t3.world) == 4'i32
  t3.put(newBlockPos(3, 97, 0), blockStone())    # a hole in layer 3 stops it there
  t3.put(newBlockPos(2, 97, 0), blockStone())
  assert bc.updateBase(t3.world) == 2'i32
  bc.primaryEffect = 1'i32
  bc.secondaryEffect = 10'i32
  bc.levels = 2'i32
  let bc2 = BeaconBlockEntity(roundTrip(BlockEntity(bc), "minecraft:beacon", beaconPos))
  assert bc2.primaryEffect == 1'i32 and bc2.secondaryEffect == 10'i32 and bc2.levels == 2'i32
  assert bc2.getData(DATA_PRIMARY) == 1'i32
  asInv(bc.inv).setStack(0, stack("iron_ingot", 1'u8))
  assert bc.payment().itemCount == 1'u8 and bc.inv.dirty
  assert BlockEntity(bc).getInventory().isSome

  # --- the lectern: a book in, the page and the book back from NBT
  let lec = newLecternBlockEntity(pos)
  assert lec.book().isEmpty()
  asInv(lec.inv).setStack(0, stack("writable_book", 1'u8))
  lec.page = 3
  let lec2 = LecternBlockEntity(roundTrip(BlockEntity(lec), "minecraft:lectern", pos))
  assert lec2.page == 3 and lec2.book().getItem().registryKey == "writable_book"
  assert BlockEntity(lec).isDirty()

  # --- the campfire and the beehive
  let cf = newCampfireBlockEntity(pos)
  cf.items[2] = stack("beef", 1'u8)
  cf.cookingTimes[2] = 55'i32
  cf.cookingTotalTimes[2] = 600'i32
  let cf2 = CampfireBlockEntity(roundTrip(BlockEntity(cf), "minecraft:campfire", pos))
  assert cf2.items[2].getItem().registryKey == "beef" and cf2.items[0].isEmpty()
  assert cf2.cookingTimes[2] == 55'i32 and cf2.cookingTotalTimes[2] == 600'i32
  let hive = newBeehiveBlockEntity(pos)
  assert not hive.hasBees and not hive.hasFlowerPos
  hive.hasFlowerPos = true
  hive.flowerPos = newBlockPos(4, 5, 6)
  let hive2 = BeehiveBlockEntity(roundTrip(BlockEntity(hive), "minecraft:beehive", pos))
  assert hive2.hasFlowerPos and hive2.flowerPos == newBlockPos(4, 5, 6) and not hive2.hasBees

  # --- the composter: the first compostable item always raises the level; a full one is emptied into bone meal
  let t4 = newTestWorld(reg)
  var spawned: seq[string] = @[]
  t4.world.spawnItem0 = proc(position: Vector3[float64]; stack: ItemStack) {.closure.} =
    spawned.add(stack.getItem().registryKey)
  t4.put(pos, blockComposter())
  let player = BlockPlayer(gamemode0: proc(): GameMode {.closure.} = GameMode.Survival)
  let hand = ItemStackRef(stack: stack("wheat_seeds", 3'u8))
  let res = reg.useWithItem(blockComposter(), player, pos, BlockHitResult(), hand, 0, BlockServer(), t4.world)
  assert res == barConsume
  assert hand.stack.itemCount == 2'u8
  let level1 = ComposterLikeProperties.fromStateId(t4.world.getBlockStateId(pos), blockComposter()).level
  assert level1 == 1'u8
  var full = ComposterLikeProperties.defaultFor(blockComposter())
  full.level = 8'u8
  t4.put(pos, full.toStateId(blockComposter()))
  let res2 = reg.useWithItem(blockComposter(), player, pos, BlockHitResult(), hand, 0, BlockServer(), t4.world)
  assert res2 == barConsume
  assert spawned == @["bone_meal"]
  assert ComposterLikeProperties.fromStateId(t4.world.getBlockStateId(pos), blockComposter()).level == 0'u8
  var seven = ComposterLikeProperties.defaultFor(blockComposter())
  seven.level = 7'u8
  t4.put(pos, seven.toStateId(blockComposter()))
  assert reg.behaviourOf(blockComposter().id).getComparatorOutput(GetComparatorOutputArgs(world: t4.world, block0: blockComposter(),
    state: t4.world.getBlockState(pos), position: pos)).unsafeGet == 7'u8

  # --- a hopper below a furnace takes its output, and the experience of the smelts becomes an orb
  let t5 = newTestWorld(reg)
  registerBlocksHopper(reg)
  var orbs: seq[uint32] = @[]
  t5.world.spawnExperienceOrb0 = proc(position: Vector3[float64]; amount: uint32) {.closure.} = orbs.add(amount)
  let hopperPos = newBlockPos(20, 64, 20)
  t5.put(hopperPos, blockHopper())
  t5.put(hopperPos.up(), blockFurnace())
  let fur = newFurnaceBlockEntity(hopperPos.up())
  t5.world.addBlockEntity(BlockEntity(fur))
  asInv(fur.inv).setStack(2, stack("iron_ingot", 3'u8))
  fur.inv.recipesUsed[cookingRecipeFor(stack("raw_iron", 1'u8), crkSmelting).unsafeGet.id] = 3'u32   # three smelts at 0.7 each
  let hop = newHopperBlockEntity(hopperPos, FacingHopper.Down)
  t5.world.addBlockEntity(BlockEntity(hop))
  BlockEntity(hop).tick(t5.world)
  assert fur.inv.items[2].itemCount == 2'u8
  assert asInv(hop.inv).getStack(0).itemCount == 1'u8
  assert orbs == @[2'u32]

  # --- a hopper entity told it faces Down, over a block state that faces East: the state is what it ejects towards
  let t6 = newTestWorld(reg)
  let hp = newBlockPos(30, 64, 30)
  var east = HopperLikeProperties.defaultFor(blockHopper())
  east.facing = FacingHopper.East
  t6.put(hp, east.toStateId(blockHopper()))
  t6.put(hp.offset(toOffset(FacingHopper.East)), blockHopper())
  let src6 = newHopperBlockEntity(hp, FacingHopper.Down)
  let dst6 = newHopperBlockEntity(hp.offset(toOffset(FacingHopper.East)), FacingHopper.Down)
  t6.world.addBlockEntity(BlockEntity(src6))
  t6.world.addBlockEntity(BlockEntity(dst6))
  asInv(src6.inv).setStack(0, stack("iron_ingot", 2'u8))
  BlockEntity(src6).tick(t6.world)
  assert src6.facing == FacingHopper.East
  assert src6.inv.items[0].itemCount == 1'u8
  assert dst6.inv.items[0].itemCount == 1'u8
  echo "c1blockstest ok"

run()
