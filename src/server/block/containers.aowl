## Not a port of one upstream file: what the container block entities (chest, barrel, shulker box, hopper, dispenser,
## dropper) share. Upstream has each entity implement `Inventory` itself; a `ref object of BlockEntity` cannot also be an
## `Inventory` here, so the entity holds a `ContainerInventory` and answers it from `get_inventory`.
## Also `calculate_comparator_output` of pumpkin/src/block/mod.rs and the block side of `Player::open_handled_screen`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import blockprelude
import ../../inventory/[inventory, viewer, player_inventory, screenhandler, recipe_provider]
export viewer, player_inventory, screenhandler, recipe_provider

type
  ContainerInventory* = ref object of ArrayInventory
    ## `items`, `dirty` and `viewers` of a chest-like entity.
    dirty*: bool
    viewers*: nil ViewerCountTracker
    isHopper*: bool       # a hopper's stacks: `cooldownTime` is its `TransferCooldown` (a type of its own trips the compiler, see the report)
    cooldownTime*: int32

var gBlockRecipeProvider*: nil RecipeProvider
  ## `args.server.recipe_manager` for the blocks that open a crafting screen: BlockServer holds no server, so installBlockHooks sets this.

proc containerSetStack(self: Inventory; slot: int; stack: ItemStack) =
  let c = ContainerInventory(self)
  c.items[slot] = stack
  c.dirty = true

proc containerRemoveStack(self: Inventory; slot: int): ItemStack =
  let c = ContainerInventory(self)
  result = c.items[slot]
  c.items[slot] = emptyItemStack()
  c.dirty = true

proc containerRemoveStackSpecific(self: Inventory; slot: int; amount: uint8): ItemStack =
  ## `split_stack`
  let c = ContainerInventory(self)
  if slot < c.items.len and not c.items[slot].isEmpty() and amount > 0'u8:
    result = c.items[slot].split(amount)
  else:
    result = emptyItemStack()
  c.dirty = true

proc containerClear(self: Inventory) =
  let c = ContainerInventory(self)
  for i in 0 ..< c.items.len:
    c.items[i] = emptyItemStack()
  c.dirty = true

proc containerMarkDirty(self: Inventory) =
  ContainerInventory(self).dirty = true

proc containerOnOpen(self: Inventory) =
  let v = ContainerInventory(self).viewers
  if v != nil:
    v.openContainer()

proc containerOnClose(self: Inventory) =
  let v = ContainerInventory(self).viewers
  if v != nil:
    v.closeContainer()

proc containerOps(): InventoryOps =
  result = arrayInventoryOps()
  result.setStack = containerSetStack
  result.removeStack = containerRemoveStack
  result.removeStackSpecific = containerRemoveStackSpecific
  result.clear = containerClear
  result.markDirty = containerMarkDirty
  result.onOpen = containerOnOpen
  result.onClose = containerOnClose

let gContainerOps = containerOps()

proc containerInventoryOps*(): InventoryOps =
  ## A copy of the table `newContainerInventory` uses, for an inventory that extends `ContainerInventory` and overrides some of it.
  containerOps()

proc newContainerInventory*(size: int): ContainerInventory =
  ContainerInventory(ops: gContainerOps, items: emptyStacks(size), dirty: false, viewers: newViewerCountTracker(),
    isHopper: false, cooldownTime: 0)

## `ViewerCountTrackerExt::update_viewer_count`, generic over the entity as upstream is.
proc updateViewerCount*[T](self: ViewerCountTracker; entity: T; world: BlockWorld; position: BlockPos) =
  ## `update_viewer_count`: `old.swap(current)`, then the open or close callback on a change to or from zero.
  let current = self.current
  let old = self.old
  self.old = current
  if old != current:
    if current == 0'u16 and old > 0'u16:
      entity.onContainerClose(world, position)
    elif old == 0'u16 and current > 0'u16:
      entity.onContainerOpen(world, position)
    entity.onViewerCountUpdate(world, position, old, current)

proc initContainer*(c: ContainerInventory; size: int) =
  ## For a type that extends `ContainerInventory`: the fields `newContainerInventory` sets.
  c.ops = gContainerOps
  c.items = emptyStacks(size)
  c.dirty = false
  c.viewers = newViewerCountTracker()
  c.isHopper = false
  c.cooldownTime = 0

proc calculateComparatorOutput*(inventory: Inventory): uint8 =
  ## `calculate_comparator_output`
  let size = inventory.size()
  if size == 0:
    return 0'u8
  var fillSum = 0.0'f32
  var nonEmptyCount = 0
  for i in 0 ..< size:
    let stack = inventory.getStack(i)
    if not stack.isEmpty():
      let maxStack = float32(stack.getMaxStackSize())
      let count = float32(stack.itemCount)
      fillSum += count / maxStack
      nonEmptyCount += 1
  if nonEmptyCount == 0:
    return 0'u8
  let percentage = fillSum / float32(size)
  let output = 1.0'f32 + percentage * 14.0'f32
  uint8(floor(output))

proc makeScreenHandler(make: proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.}; syncId: uint8; player: BlockPlayer): ScreenHandler =
  ## Body of `newScreenFactory`'s handler, outside the closure: hexer asserts on a closure that calls its captured `make` and
  ## the player's `inventory0` itself (COMPILER-BUGS.md).
  let inv = player.inventory0
  let rawInv = inv()
  make(syncId, PlayerInventory(rawInv))

proc newScreenFactory*(title: TextComponent;
    make: proc(syncId: uint8; playerInventory: PlayerInventory): ScreenHandler {.closure.}): BlockScreenFactory =
  ## A `ScreenHandlerFactory`: the handler is made from the opening player's inventory.
  BlockScreenFactory(title: title, createScreenHandler: proc(syncId: uint8; player: BlockPlayer): ScreenHandler {.closure.} =
    makeScreenHandler(make, syncId, player))

proc openHandledScreen*(player: BlockPlayer; factory: BlockScreenFactory; position: Option[BlockPos]): bool {.discardable.} =
  ## `open_handled_screen`, behind the `openHandledScreen0` hook that servermod fills.
  let f = player.openHandledScreen0
  if f == nil:
    return false
  f(factory, position)
