## The container block entities (containers.aowl, entities/chest*.aowl, barrel, shulker box, hopper, dropper, jukebox) over a
## `TestWorld`: comparator output as worked out from `calculate_comparator_output`, what is saved and read back through NBT, the
## viewer count turning into a sound and a lid event, a pending loot table, and the hopper's transfer.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import containers
import registry
import testworld
import entities/[entitiesmod, chest, trapped_chest, barrel, shulker_box, hopper, dropper, jukebox]

proc stoneStack(count: uint8): ItemStack =
  let stone = Item.fromRegistryKey("stone")
  if stone == nil:
    quit(1)
  newItemStack(count, stone)

proc made(kind: string; pos: BlockPos): BlockEntity =
  ## `create_block_entity` for the entity type of that name.
  for i in 0 ..< BLOCK_ENTITY_TYPES.len:
    if BLOCK_ENTITY_TYPES[i] == kind:
      return createBlockEntity(uint16(i), pos).unsafeGet
  quit(1)

proc loadedFrom(saved: NbtCompound; id: string; pos: BlockPos): BlockEntity =
  ## `block_entity_from_nbt` of what `write_nbt` wrote, with the id and the position a chunk adds.
  var nbt = saved
  put(nbt, "id", NbtTag(kind: ntkString, stringVal: id))
  put(nbt, "x", NbtTag(kind: ntkInt, intVal: pos.vec.x))
  put(nbt, "y", NbtTag(kind: ntkInt, intVal: pos.vec.y))
  put(nbt, "z", NbtTag(kind: ntkInt, intVal: pos.vec.z))
  blockEntityFromNbt(nbt).unsafeGet

proc chestInv(e: BlockEntity): ContainerInventory =
  ChestLikeBlockEntity(e).inv

proc chestLoot(e: BlockEntity): string =
  let p = ChestLikeBlockEntity(e).pending
  if p == nil: "" else: p.key

proc setLoot(e: BlockEntity; key: string; seed: int64) =
  ChestLikeBlockEntity(e).setPendingLoot(key, seed)

proc emits(e: BlockEntity): bool =
  ChestLikeBlockEntity(e).trapped

proc viewerCount(e: BlockEntity): uint16 =
  ChestLikeBlockEntity(e).getViewerCount()

proc asInv(c: ContainerInventory): Inventory =
  ## The compiler's not-nil proof wants the nil check before the conversion to the base type.
  if c == nil:
    quit(1)
  Inventory(c)

proc run() =
  let reg = defaultRegistry()
  assert reg.unknown.len == 0
  assert reg.getPumpkinBlock(blockChest().id).isSome
  assert reg.getPumpkinBlock(blockTrappedChest().id).isSome
  assert reg.getPumpkinBlock(blockBarrel().id).isSome
  assert reg.getPumpkinBlock(blockEnderChest().id).isSome
  assert reg.getPumpkinBlock(blockShulkerBox().id).isSome
  assert reg.getPumpkinBlock(blockCraftingTable().id).isSome
  assert reg.getPumpkinBlock(blockHopper().id).isSome
  assert reg.getPumpkinBlock(blockDropper().id).isSome
  assert reg.getPumpkinBlock(blockNoteBlock().id).isSome

  # calculate_comparator_output: floor(1 + (sum of count / max) / size * 14), and 0 for nothing at all.
  let empty = newContainerInventory(27)
  assert calculateComparatorOutput(asInv(empty)) == 0'u8
  let one = newContainerInventory(27)
  one.items[0] = stoneStack(1'u8)
  assert calculateComparatorOutput(asInv(one)) == 1'u8   # 1 + (1/64)/27*14 = 1.008
  let half = newContainerInventory(27)
  for i in 0 ..< 27:
    if i < 14:
      half.items[i] = stoneStack(64'u8)
  assert calculateComparatorOutput(asInv(half)) == 8'u8  # 1 + 14/27*14 = 8.259
  let full = newContainerInventory(27)
  for i in 0 ..< 27:
    full.items[i] = stoneStack(64'u8)
  assert calculateComparatorOutput(asInv(full)) == 15'u8
  let hopperSized = newContainerInventory(5)
  hopperSized.items[0] = stoneStack(32'u8)
  assert calculateComparatorOutput(asInv(hopperSized)) == 2'u8  # 1 + 0.5/5*14 = 2.4

  # The Inventory view of a container: set, remove, dirty.
  let plain = newContainerInventory(27)
  let base = asInv(plain)
  assert not plain.dirty
  base.setStack(3, stoneStack(10'u8))
  assert plain.dirty
  plain.dirty = false
  let taken = base.removeStackSpecific(3, 4'u8)
  assert taken.itemCount == 4'u8
  assert base.getStack(3).itemCount == 6'u8
  assert plain.dirty
  assert not base.isEmpty()
  base.clear()
  assert base.isEmpty()

  # A chest, held as a `BlockEntity` as the world holds it: its items are what a save writes and a load reads back.
  let pos = newBlockPos(10, 64, 10)
  let ch = made("chest", pos)
  assert ch.resourceLocation() == "minecraft:chest"
  asInv(chestInv(ch)).setStack(5, stoneStack(33'u8))
  var nbt = newCompound()
  ch.writeNbt(nbt)
  assert nbt.getList("Items").isSome
  let back = loadedFrom(nbt, "minecraft:chest", pos)
  assert chestInv(back).items[5].itemCount == 33'u8
  assert chestInv(back).items[0].isEmpty()
  assert back.getInventory().unsafeGet.getStack(5).itemCount == 33'u8

  # A pending loot table is saved in place of the items, and taking it clears it.
  let loot = made("chest", pos)
  setLoot(loot, "minecraft:chests/simple_dungeon", 77'i64)
  var lootNbt = newCompound()
  loot.writeNbt(lootNbt)
  assert lootNbt.getString("LootTable").unsafeGet == "minecraft:chests/simple_dungeon"
  assert lootNbt.getLong("LootTableSeed").unsafeGet == 77'i64
  assert lootNbt.getList("Items").isNone
  let lootBack = loadedFrom(lootNbt, "minecraft:chest", pos)
  assert chestLoot(lootBack) == "minecraft:chests/simple_dungeon"
  let has = lootBack.vt.hasLootTableImpl
  assert has(lootBack)
  let take = lootBack.vt.takeLootTableImpl
  let taken2 = take(lootBack)
  assert taken2.isSome and taken2.unsafeGet[1] == 77'i64
  assert not has(lootBack)

  # Viewers: opening the inventory is a sound and a lid event at the next tick; closing it likewise with 0.
  let t = newTestWorld(reg)
  t.put(pos, blockChest())
  let single = made("chest", pos)
  t.world.addBlockEntity(single)
  asInv(chestInv(single)).onOpen()
  single.tick(t.world)
  assert t.events.len == 2
  assert t.events[0] == "sound " & $ord(sdBlockChestOpen)
  assert t.events[1] == "synced 1 1"
  asInv(chestInv(single)).onClose()
  single.tick(t.world)
  assert t.events.len == 4
  assert t.events[2] == "sound " & $ord(sdBlockChestClose)
  assert t.events[3] == "synced 1 0"
  single.tick(t.world)
  assert t.events.len == 4  # nothing changed, nothing sent
  assert viewerCount(single) == 0'u16

  # A trapped chest asks its neighbours to update when the count changes.
  let trapped = made("trapped_chest", pos)
  assert trapped.resourceLocation() == "minecraft:trapped_chest"
  assert emits(trapped)
  assert not emits(single)

  # A barrel and a shulker box round-trip their items too.
  let bar = newBarrelBlockEntity(pos)
  asInv(bar.inv).setStack(26, stoneStack(7'u8))
  var barNbt = newCompound()
  BlockEntity(bar).writeNbt(barNbt)
  var barTag = barNbt
  assert barrelBlockEntityFromNbt_BlockEntity(barTag, pos).inv.items[26].itemCount == 7'u8
  let shulk = newShulkerBoxBlockEntity(pos)
  asInv(shulk.inv).setStack(0, stoneStack(64'u8))
  var shNbt = newCompound()
  BlockEntity(shulk).writeNbt(shNbt)
  var shTag = shNbt
  assert shulkerBoxBlockEntityFromNbt_BlockEntity(shTag, pos).inv.items[0].itemCount == 64'u8

  # A dropper's random slot is one that is not empty, and -1 when there is none.
  let drop = newDropperBlockEntity(pos)
  assert drop.getRandomSlot() == -1
  drop.inv.items[4] = stoneStack(2'u8)
  assert drop.getRandomSlot() == 4
  drop.inv.items[7] = stoneStack(2'u8)
  var seen4 = false
  var seen7 = false
  for i in 0 ..< 200:
    let s = drop.getRandomSlot()
    assert s == 4 or s == 7
    if s == 4: seen4 = true
    if s == 7: seen7 = true
  assert seen4 and seen7

  # A hopper moves one item at a time: from itself to the container it faces.
  let hop = newHopperBlockEntity(pos, FacingHopper.Down)
  let target = newContainerInventory(5)
  asInv(hop.inv).setStack(0, stoneStack(3'u8))
  assert addOneItem(asInv(hop.inv), asInv(target), stoneStack(1'u8))
  assert target.items[0].itemCount == 1'u8
  assert addOneItem(asInv(hop.inv), asInv(target), stoneStack(1'u8))
  assert target.items[0].itemCount == 2'u8
  assert target.dirty
  # Into an empty hopper: the receiving hopper's cooldown is set to 8 from a non-hopper source.
  let hop2 = newHopperBlockEntity(pos, FacingHopper.Down)
  assert addOneItem(asInv(target), asInv(hop2.inv), stoneStack(1'u8))
  assert hop2.inv.cooldownTime == 8'i32
  var hopNbt = newCompound()
  BlockEntity(hop2).writeNbt(hopNbt)
  assert hopNbt.getInt("TransferCooldown").unsafeGet == 8'i32
  var hopTag = hopNbt
  let hopBack = hopperBlockEntityFromNbt_BlockEntity(hopTag, pos)
  assert hopBack.inv.cooldownTime == 8'i32
  assert hopBack.inv.items[0].itemCount == 1'u8

  # A jukebox: the record in, the song started, playing until its length is ticked out.
  let juke = newJukeboxBlockEntity(pos)
  assert not juke.isPlaying()
  juke.setRecord(stoneStack(1'u8))
  juke.startPlaying(3'u64)
  assert juke.isPlaying()
  BlockEntity(juke).tick(t.world)
  BlockEntity(juke).tick(t.world)
  assert juke.isPlaying()
  BlockEntity(juke).tick(t.world)
  assert not juke.isPlaying()
  var jukeNbt = newCompound()
  BlockEntity(juke).writeNbt(jukeNbt)
  assert jukeNbt.getCompound("RecordItem").isSome

run()
echo "containers: all checks passed"
