## Port of pumpkin/src/block/entities/banner.rs
## The `Mutex<Option<..>>` fields are plain options here: one thread writes a world, and `try_lock` always succeeds.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:banner"

type
  BannerBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    customName*: Option[string]
    patterns*: Option[seq[NbtTag]]

var gBannerBlockEntityVt: nil BlockEntityVt

proc bannerBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc bannerBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BannerBlockEntity(self0).position

proc bannerBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BannerBlockEntity(self0)
  if self.customName.isSome:
    nbt.putString("CustomName", self.customName.unsafeGet)
  if self.patterns.isSome:
    nbt.putList("patterns", self.patterns.unsafeGet)

proc bannerBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = BannerBlockEntity(self0)
  var nbt = newCompound()
  if self.customName.isSome:
    nbt.putString("CustomName", self.customName.unsafeGet)
  if self.patterns.isSome:
    nbt.putList("patterns", self.patterns.unsafeGet)
  some(nbt)

proc bannerBlockEntityVt*(): BlockEntityVt =
  if gBannerBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = bannerBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = bannerBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = bannerBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = bannerBlockEntityChunkDataNbt_BlockEntity
    gBannerBlockEntityVt = v
  gBannerBlockEntityVt

proc newBannerBlockEntity*(position: BlockPos): BannerBlockEntity =
  BannerBlockEntity(vt: bannerBlockEntityVt(), position: position, customName: none[string](), patterns: none[seq[NbtTag]]())

proc bannerBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): BannerBlockEntity =
  BannerBlockEntity(vt: bannerBlockEntityVt(), position: position, customName: nbt.getString("CustomName"),
    patterns: nbt.getList("patterns"))
