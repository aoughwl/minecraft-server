proc onOpen*(self: BarrelBlockEntity) =
  self.viewers.openContainer()

proc onClose*(self: BarrelBlockEntity) =
  self.viewers.closeContainer()

proc markDirty*(self: BarrelBlockEntity) =
  self.dirty = true

proc clear*(self: BarrelBlockEntity) =
