proc setOpen*(self: BarrelBlockEntity, world: BlockWorld, open: bool) =
  let state = world.getBlockState(self.position)
  var properties = BarrelLikeProperties.fromStateId(state.id, blockBarrel())
  properties.open = open
  discard world.setBlockState(self.position, properties.toStateId(blockBarrel()), BfNotifyAll)

proc playSound*(self: BarrelBlockEntity, world: BlockWorld, sound: Sound) =
  var rng = Xoroshiro.fromSeed(getSeed())
  let state = world.getBlockState(self.position)
  let properties = BarrelLikeProperties.fromStateId(state.id, blockBarrel())
  let direction = properties.facing.toBlockDirection().toOffset()
  let position = newVector3(((float64(self.position.vec.x) + 0.5) + (float64(direction.x) / 2.0)), ((float64(self.position.vec.y) + 0.5) + (float64(direction.y) / 2.0)), ((float64(self.position.vec.z) + 0.5) + (float64(direction.z) / 2.0)))
  world.playSoundFine(sound, scBlocks, position, 0.5, ((rng.nextF32() * 0.1) + 0.9))

