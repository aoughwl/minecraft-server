## Port of pumpkin/src/block/entities/barrel.rs
## The 27 stacks live in a `ContainerInventory` (containers.aowl): upstream's entity is its own `Inventory`, which a
## `ref object of BlockEntity` cannot also be.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 27
const ID*: string = "minecraft:barrel"

type
  BarrelBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory
    ## `items`, `dirty` and `viewers` are `inv.items`, `inv.dirty` and `inv.viewers`.

var gBarrelBlockEntityVt: nil BlockEntityVt

proc setOpen*(self: BarrelBlockEntity, world: BlockWorld, open: bool)
proc playSound*(self: BarrelBlockEntity, world: BlockWorld, sound: Sound)

proc onContainerOpen*(self: BarrelBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockBarrelOpen)
  self.setOpen(world, true)

proc onContainerClose*(self: BarrelBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockBarrelClose)
  self.setOpen(world, false)

proc onViewerCountUpdate*(self: BarrelBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new0: uint16) =
  discard

proc barrelBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc barrelBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BarrelBlockEntity(self0).position

proc barrelBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BarrelBlockEntity(self0)
  let c = self.inv
  if c != nil:
    let i = containerAsInventory(c)
    i.writeInventoryNbt(nbt, true)

proc barrelBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BarrelBlockEntity(self0)
  let v = self.inv.viewers
  if v != nil:
    v.updateViewerCount(self, world, self.position)

proc barrelBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  let c = BarrelBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc barrelBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  BarrelBlockEntity(self0).inv.dirty

proc barrelBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  BarrelBlockEntity(self0).inv.dirty = false

proc barrelBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = BarrelBlockEntity(self0)
  var nbt = newCompound()
  syncWriteItemsToNbt(self.inv.items, nbt)
  some(nbt)

proc barrelBlockEntityVt*(): BlockEntityVt =
  if gBarrelBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = barrelBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = barrelBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = barrelBlockEntityWriteNbt_BlockEntity
    v.tickImpl = barrelBlockEntityTick_BlockEntity
    v.getInventoryImpl = barrelBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = barrelBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = barrelBlockEntityClearDirty_BlockEntity
    v.chunkDataNbtImpl = barrelBlockEntityChunkDataNbt_BlockEntity
    gBarrelBlockEntityVt = v
  gBarrelBlockEntityVt

proc newBarrelBlockEntity*(position: BlockPos): BarrelBlockEntity =
  BarrelBlockEntity(vt: barrelBlockEntityVt(), position: position, inv: newContainerInventory(INVENTORY_SIZE))

proc barrelBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): BarrelBlockEntity =
  let barrel = newBarrelBlockEntity(position)
  syncReadItemsFromNbt(nbt, barrel.inv.items)
  barrel

proc setOpen*(self: BarrelBlockEntity, world: BlockWorld, open: bool) =
  let state = world.getBlockState(self.position)
  var properties = BarrelLikeProperties.fromStateId(state.id, blockBarrel())
  properties.open = open
  discard world.setBlockState(self.position, properties.toStateId(blockBarrel()), BfNotifyAll)

proc playSound*(self: BarrelBlockEntity, world: BlockWorld, sound: Sound) =
  let state = world.getBlockState(self.position)
  let properties = BarrelLikeProperties.fromStateId(state.id, blockBarrel())
  let direction = properties.facing.toBlockDirection().toOffset()
  let position = Vector3[float64](x: (float64(self.position.vec.x) + 0.5) + (float64(direction.x) / 2.0),
    y: (float64(self.position.vec.y) + 0.5) + (float64(direction.y) / 2.0),
    z: (float64(self.position.vec.z) + 0.5) + (float64(direction.z) / 2.0))
  world.playSoundFine(sound, scBlocks, position, 0.5, (randomOf(float32) * 0.1'f32) + 0.9'f32)
