proc onContainerOpen*(self: BarrelBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockBarrelOpen)
  self.setOpen(world, true)

proc onContainerClose*(self: BarrelBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockBarrelClose)
  self.setOpen(world, false)

