## Port of pumpkin/src/block/entities/beacon.rs
## The payment slot is a one-stack `ContainerInventory` (containers.aowl), the entity's `Inventory`; `dirty` is `inv.dirty`.
## The effects reach a player through `addEffectFull` (blockbehaviour.aowl), so they are ambient as upstream makes them.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../generated/effect

const ID*: string = "minecraft:beacon"
const DATA_LEVELS*: int = 0
const DATA_PRIMARY*: int = 1
const DATA_SECONDARY*: int = 2
const NUM_DATA_VALUES*: int = 3

type
  BeaconBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    primaryEffect*: int32
    secondaryEffect*: int32
    levels*: int32
    inv*: ContainerInventory  # `payment` is `inv.items[0]`, `dirty` is `inv.dirty`
    hasCustomName*: bool
    customName*: string
    hasLockKey*: bool
    lockKey*: string
    lastCheckY*: int32

var gBeaconBlockEntityVt: nil BlockEntityVt

proc markDirty*(self: BeaconBlockEntity) =
  self.inv.dirty = true

proc payment*(self: BeaconBlockEntity): ItemStack =
  self.inv.items[0]

proc getData*(self: BeaconBlockEntity, id: int): int32 =
  ## Replicates the Java `ContainerData` used to sync values to the `BeaconMenu`
  case id
  of DATA_LEVELS: self.levels
  of DATA_PRIMARY: self.primaryEffect
  of DATA_SECONDARY: self.secondaryEffect
  else: 0'i32

proc setData*(self: BeaconBlockEntity, id: int, value: int32) =
  case id
  of DATA_LEVELS: self.levels = value
  of DATA_PRIMARY: self.primaryEffect = value
  of DATA_SECONDARY: self.secondaryEffect = value
  else: discard
  self.markDirty()

proc updateBase*(self: BeaconBlockEntity, world: BlockWorld): int32 =
  ## Replicates Java's `updateBase` logic
  var levels = 0'i32
  let x = self.position.vec.x
  let y = self.position.vec.y
  let z = self.position.vec.z
  for step in 1'i32 .. 4'i32:
    let ly = y - step
    if ly < world.dimension.minY:
      break
    var isOk = true
    for lx in (x - step) .. (x + step):
      for lz in (z - step) .. (z + step):
        let pos = newBlockPos(lx, ly, lz)
        let blockRef = world.getBlock(pos)
        if not blockRef.hasTag(Block_MINECRAFT_BEACON_BASE_BLOCKS):
          isOk = false
          break
      if not isOk:
        break
    if not isOk:
      break
    levels = step
  levels

proc effectName(effect: StatusEffect): string =
  ## `minecraft:speed` as the `speed` the entity hooks take
  const prefix = "minecraft:"
  if effect.minecraftName.len > prefix.len and effect.minecraftName[0 ..< prefix.len] == prefix:
    effect.minecraftName[prefix.len ..< effect.minecraftName.len]
  else:
    effect.minecraftName

proc applyEffects*(self: BeaconBlockEntity, world: BlockWorld, levels: int32) =
  ## Replicates Java's `applyEffects` bounding box mapping and duration mapping
  if levels <= 0:
    return
  let primaryId = self.primaryEffect
  let secondaryId = self.secondaryEffect
  if primaryId <= 0:
    return
  let primaryEffect = StatusEffect.fromId(uint16(primaryId))
  let secondaryEffect = if secondaryId > 0: StatusEffect.fromId(uint16(secondaryId)) else: none[StatusEffect]()
  # Vanilla: expandTowards(0.0, level.getHeight(), 0.0) -> Reaches across the entire Y axis
  let range = float64(levels * 10 + 10)
  let pos = self.position.vec.toF64()
  # Use the dimension height for vanilla parity (usually 384.0 in modern versions)
  let worldHeight = float64(world.dimension.height)
  let boundingBox = newBoundingBox(pos, pos.addRaw(1.0, 1.0, 1.0)).expand(range, range, range).expandTowards(0.0, worldHeight, 0.0)
  let players = world.getPlayersAtBox(boundingBox)
  let durationTicks = (9'i32 + levels * 2'i32) * 20'i32
  let baseAmp = if levels >= 4 and primaryId == secondaryId: 1'u8 else: 0'u8
  for i in 0 ..< players.len:
    if primaryEffect.isSome:
      addEffectFull(players[i], effectName(primaryEffect.unsafeGet), durationTicks, baseAmp, true, true, true, false)
    if levels >= 4 and primaryId != secondaryId and secondaryEffect.isSome:
      addEffectFull(players[i], effectName(secondaryEffect.unsafeGet), durationTicks, 0'u8, true, true, true, false)

proc beaconBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc beaconBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BeaconBlockEntity(self0).position

proc putBeaconData(self: BeaconBlockEntity; nbt: var NbtCompound) =
  nbt.putInt("primary_effect", self.primaryEffect)
  nbt.putInt("secondary_effect", self.secondaryEffect)
  nbt.putInt("Levels", self.levels)
  if self.hasCustomName:
    nbt.put("CustomName", self.customName)
  if self.hasLockKey:
    nbt.put("Lock", self.lockKey)

proc beaconBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  putBeaconData(BeaconBlockEntity(self0), nbt)

proc beaconBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BeaconBlockEntity(self0)
  # Check properties every 80 ticks matching Java
  if world.getTimeOfDay() mod 80'i64 == 0'i64:
    let levels = self.updateBase(world)
    self.levels = levels
    # TODO upstream: Beam Section validation (scanning upward to heightmap to check for sky visibility)
    # is typically checked here before applying effects in Vanilla.
    if levels > 0:
      self.applyEffects(world, levels)

proc beaconBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  putBeaconData(BeaconBlockEntity(self0), nbt)
  some(nbt)

proc beaconBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  let c = BeaconBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc beaconBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  BeaconBlockEntity(self0).inv.dirty

proc beaconBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  BeaconBlockEntity(self0).inv.dirty = false

proc beaconBlockEntityVt*(): BlockEntityVt =
  if gBeaconBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = beaconBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = beaconBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = beaconBlockEntityWriteNbt_BlockEntity
    v.tickImpl = beaconBlockEntityTick_BlockEntity
    v.chunkDataNbtImpl = beaconBlockEntityChunkDataNbt_BlockEntity
    v.getInventoryImpl = beaconBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = beaconBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = beaconBlockEntityClearDirty_BlockEntity
    gBeaconBlockEntityVt = v
  gBeaconBlockEntityVt

proc newBeaconBlockEntity*(position: BlockPos): BeaconBlockEntity =
  BeaconBlockEntity(vt: beaconBlockEntityVt(), position: position, primaryEffect: -1'i32, secondaryEffect: -1'i32,
    levels: 0'i32, inv: newContainerInventory(1), hasCustomName: false, customName: "", hasLockKey: false, lockKey: "",
    lastCheckY: position.vec.y - 1)

proc beaconBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): BeaconBlockEntity =
  # Aligning to strict vanilla NBT tags
  let primary = nbt.getInt("primary_effect")
  let secondary = nbt.getInt("secondary_effect")
  let levels = nbt.getInt("Levels")  # Vanilla uses capital L
  let customName = nbt.getString("CustomName")
  let lockKey = nbt.getString("Lock")
  let e = newBeaconBlockEntity(position)
  e.primaryEffect = if primary.isSome: primary.unsafeGet else: -1'i32
  e.secondaryEffect = if secondary.isSome: secondary.unsafeGet else: -1'i32
  e.levels = if levels.isSome: levels.unsafeGet else: 0'i32
  e.hasCustomName = customName.isSome
  if customName.isSome:
    e.customName = customName.unsafeGet
  e.hasLockKey = lockKey.isSome
  if lockKey.isSome:
    e.lockKey = lockKey.unsafeGet
  e
