proc beaconBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BeaconBlockEntity =
  # Aligning to strict vanilla NBT tags
  let primary = nbt.getInt("primary_effect").get((-1))
  let secondary = nbt.getInt("secondary_effect").get((-1))
  let levels = nbt.getInt("Levels").get(0)
  # Vanilla uses capital L
  let customName = nbt.getString("CustomName").map(toString)
  let lockKey = nbt.getString("Lock").map(toString)
  BeaconBlockEntity(position: position, primaryEffect: primary, secondaryEffect: secondary, levels: levels, dirty: false, payment: emptyItemStack(), customName: customName, lockKey: lockKey, lastCheckY: (position.vec.y - 1))

proc beaconBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BeaconBlockEntity(self0)
  nbt.putInt("primary_effect", self.primaryEffect)
  nbt.putInt("secondary_effect", self.secondaryEffect)
  nbt.putInt("Levels", self.levels)
  let t4 = self.customName
  if t4.isSome:
    let name = t4.unsafeGet
    nbt.putString("CustomName", t4.unsafeGet)
  let t5 = self.lockKey
  if t5.isSome:
    let lock = t5.unsafeGet
    nbt.putString("Lock", t5.unsafeGet)

proc beaconBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BeaconBlockEntity(self0)
  # Check properties every 80 ticks matching Java
  if ((world.getTimeOfDay() mod 80) == 0):
    let levels = self.updateBase(world)
    self.levels = levels
    # TODO: Beam Section validation (scanning upward to heightmap to check for sky visibility)
    # is typically checked here before applying effects in Vanilla.
    if (levels > 0):
      self.applyEffects(world, levels)

