## Port of pumpkin/src/block/entities/bed.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:bed"

type
  BedBlockEntity* = ref object of BlockEntity
    position*: BlockPos

var gBedBlockEntityVt: nil BlockEntityVt


proc bedBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc bedBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BedBlockEntity(self0).position

proc bedBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  discard

proc bedBlockEntityVt*(): BlockEntityVt =
  if gBedBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = bedBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = bedBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = bedBlockEntityWriteNbt_BlockEntity
    gBedBlockEntityVt = v
  gBedBlockEntityVt

proc newBedBlockEntity*(position: BlockPos): BedBlockEntity =
  BedBlockEntity(vt: bedBlockEntityVt(), position: position)

proc bedBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): BedBlockEntity =
  BedBlockEntity(vt: bedBlockEntityVt(), position: position)
