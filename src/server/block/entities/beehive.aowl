## Port of pumpkin/src/block/entities/beehive.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:beehive"

type
  BeehiveBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    bees*: Option[seq[NbtTag]]
    flowerPos*: Option[BlockPos]

var gBeehiveBlockEntityVt: nil BlockEntityVt


proc beehiveBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc beehiveBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc beehiveBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BeehiveBlockEntity
proc beehiveBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc beehiveBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc beehiveBlockEntityVt*(): BlockEntityVt
proc newBeehiveBlockEntity*(position: BlockPos): BeehiveBlockEntity

proc beehiveBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = BeehiveBlockEntity(self0)
  ID

proc beehiveBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = BeehiveBlockEntity(self0)
  self.position

proc beehiveBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BeehiveBlockEntity =
  let bees = nbt.getList("Bees").map(R2A_MANUAL_qpath)
  let flowerPos = nbt.getCompound("FlowerPos").map(R2A_MANUAL("closure |c| t1"))
  BeehiveBlockEntity(position: position, bees: bees, flowerPos: flowerPos)

proc beehiveBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BeehiveBlockEntity(self0)
  let t4 = self.bees
  if t4.isSome:
    let b = t4.unsafeGet
    nbt.putList("Bees", t4.unsafeGet)
  let t5 = self.flowerPos
  if t5.isSome:
    let fp = t5.unsafeGet
    var fpNbt = newCompound()
    fpNbt.putInt("X", t5.unsafeGet[0].x)
    fpNbt.putInt("Y", t5.unsafeGet[0].y)
    fpNbt.putInt("Z", t5.unsafeGet[0].z)
    nbt.putCompound("FlowerPos", fpNbt)

proc beehiveBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = BeehiveBlockEntity(self0)
  var nbt = newCompound()
  let t6 = self.bees.tryLock()
  let t7 = t6.value
  if t6.isOk and t7.isSome:
    let bees = t6.value
    let b = t7.unsafeGet
    nbt.putList("Bees", t7.unsafeGet)
  let t8 = self.flowerPos.tryLock()
  let t9 = flowerPos
  if t8.isOk and t9.isSome:
    let flowerPos = t8.value
    let fp = t9.unsafeGet
    var fpNbt = newCompound()
    fpNbt.putInt("X", t9.unsafeGet[0].x)
    fpNbt.putInt("Y", t9.unsafeGet[0].y)
    fpNbt.putInt("Z", t9.unsafeGet[0].z)
    nbt.putCompound("FlowerPos", fpNbt)
  some(nbt)

proc beehiveBlockEntityVt*(): BlockEntityVt =
  if gBeehiveBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = beehiveBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = beehiveBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = beehiveBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = beehiveBlockEntityChunkDataNbt_BlockEntity
    gBeehiveBlockEntityVt = v
  gBeehiveBlockEntityVt

proc newBeehiveBlockEntity*(position: BlockPos): BeehiveBlockEntity =
  BeehiveBlockEntity(position: position, bees: Mutex.constNew(R2A_NONE), flowerPos: Mutex.constNew(R2A_NONE))

