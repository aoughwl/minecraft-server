## Port of pumpkin/src/block/entities/beehive.rs
## `bees` and `flower_pos` are `Option`s upstream: here a flag and a value each, since an `Option` of a seq does not compile
## in a field (see the report). There is no dirty flag upstream, so a hive's bees are saved with its chunk's other data.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:beehive"

type
  BeehiveBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    hasBees*: bool
    bees*: seq[NbtTag]
    hasFlowerPos*: bool
    flowerPos*: BlockPos

var gBeehiveBlockEntityVt: nil BlockEntityVt

proc beehiveBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc beehiveBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BeehiveBlockEntity(self0).position

proc putBeehiveData(self: BeehiveBlockEntity; nbt: var NbtCompound) =
  ## What `write_nbt` and `chunk_data_nbt` both put: the bees and the flower position, when there are any.
  if self.hasBees:
    nbt.putList("Bees", self.bees)
  if self.hasFlowerPos:
    var fpNbt = newCompound()
    fpNbt.putInt("X", self.flowerPos.vec.x)
    fpNbt.putInt("Y", self.flowerPos.vec.y)
    fpNbt.putInt("Z", self.flowerPos.vec.z)
    nbt.put("FlowerPos", nbtTag(fpNbt))

proc beehiveBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  putBeehiveData(BeehiveBlockEntity(self0), nbt)

proc beehiveBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  putBeehiveData(BeehiveBlockEntity(self0), nbt)
  some(nbt)

proc beehiveBlockEntityVt*(): BlockEntityVt =
  if gBeehiveBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = beehiveBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = beehiveBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = beehiveBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = beehiveBlockEntityChunkDataNbt_BlockEntity
    gBeehiveBlockEntityVt = v
  gBeehiveBlockEntityVt

proc newBeehiveBlockEntity*(position: BlockPos): BeehiveBlockEntity =
  BeehiveBlockEntity(vt: beehiveBlockEntityVt(), position: position, hasBees: false, bees: @[], hasFlowerPos: false,
    flowerPos: position)

proc beeListOf(nbt: NbtCompound): (bool, seq[NbtTag]) =
  ## `nbt.get_list("Bees")`
  let l = nbt.getList("Bees")
  if l.isSome: (true, l.unsafeGet) else: (false, @[])

proc beehiveBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): BeehiveBlockEntity =
  let bees = beeListOf(nbt)
  let e = newBeehiveBlockEntity(position)
  e.hasBees = bees[0]
  e.bees = bees[1]
  let fp = nbt.getCompound("FlowerPos")
  if fp.isSome:
    let c = fp.unsafeGet
    let x = c.getInt("X")
    let y = c.getInt("Y")
    let z = c.getInt("Z")
    e.hasFlowerPos = true
    e.flowerPos = newBlockPos(if x.isSome: x.unsafeGet else: 0'i32, if y.isSome: y.unsafeGet else: 0'i32,
      if z.isSome: z.unsafeGet else: 0'i32)
  e
