## Port of pumpkin/src/block/entities/bell.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:bell"

type
  BellBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    lastSideHit*: Option[HorizontalFacing]
    ringTicks*: int32
    ringing*: bool
    resonating*: bool
    resonateTime*: int32

var gBellBlockEntityVt: nil BlockEntityVt


proc newBellBlockEntity*(position: BlockPos): BellBlockEntity
proc activate*(self: BellBlockEntity, direction: HorizontalFacing)
proc raidersHearBell*(self: BellBlockEntity): bool
proc bellBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc bellBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BellBlockEntity
proc bellBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld)
proc bellBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc bellBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc bellBlockEntityVt*(): BlockEntityVt

proc newBellBlockEntity*(position: BlockPos): BellBlockEntity =
  BellBlockEntity(position: position, ringTicks: 0, resonateTime: 0, resonating: false, ringing: false)

proc activate*(self: BellBlockEntity, direction: HorizontalFacing) =
  self.lastSideHit = some(direction)
  if self.ringing:
    self.ringTicks = 0
  else:
    self.ringing = true

proc raidersHearBell*(self: BellBlockEntity): bool =
  # TODO
  false

proc bellBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BellBlockEntity(self0)
  discard

proc bellBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BellBlockEntity =
  newBellBlockEntity(position)

proc bellBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BellBlockEntity(self0)
  if self.ringing:
    self.ringTicks += 1
  if (self.ringTicks >= 50):
    self.ringing = false
    self.ringTicks = 0
  if (self.ringTicks >= 5) and (self.resonateTime == 0) and self.raidersHearBell():
    self.resonating = true
    world.playSoundFine(sdBlockBellResonate, scBlocks, self.position.toF64(), 1.0, 1.0)
  if self.resonating:
    if (self.resonateTime < 40):
      self.resonateTime += 1
    else:
      self.resonating = false

proc bellBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = BellBlockEntity(self0)
  ID

proc bellBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = BellBlockEntity(self0)
  self.position

proc bellBlockEntityVt*(): BlockEntityVt =
  if gBellBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.writeNbtImpl = bellBlockEntityWriteNbt_BlockEntity
    v.tickImpl = bellBlockEntityTick_BlockEntity
    v.resourceLocationImpl = bellBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = bellBlockEntityGetPosition_BlockEntity
    gBellBlockEntityVt = v
  gBellBlockEntityVt

