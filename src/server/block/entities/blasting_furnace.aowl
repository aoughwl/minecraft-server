## Port of pumpkin/src/block/entities/blasting_furnace.rs
## `BlastingFurnaceBlockEntity` over the shared `FurnaceLikeBlockEntity` (furnace_like_block_entity.aowl).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/recipes
import furnace_like_block_entity

const INVENTORY_SIZE*: int = 3
const ID*: string = "minecraft:blast_furnace"

type
  BlastingFurnaceBlockEntity* = FurnaceLikeBlockEntity
    ## One type for the three: a second level of `ref object` under `BlockEntity` trips the compiler's code generator (see
    ## chest.aowl). `id` tells them apart.

var gBlastingFurnaceBlockEntityVt: nil BlockEntityVt

proc blastingFurnaceBlockEntityVt*(): BlockEntityVt =
  if gBlastingFurnaceBlockEntityVt == nil:
    gBlastingFurnaceBlockEntityVt = newFurnaceLikeBlockEntityVt()
  gBlastingFurnaceBlockEntityVt

proc newBlastingFurnaceBlockEntity*(position: BlockPos): BlastingFurnaceBlockEntity =
  result = FurnaceLikeBlockEntity()
  initFurnaceLike(result, blastingFurnaceBlockEntityVt(), position, ID, crkBlasting, INVENTORY_SIZE)

proc blastingFurnaceBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): BlastingFurnaceBlockEntity =
  let e = newBlastingFurnaceBlockEntity(position)
  readFurnaceLikeNbt(e, nbt)
  e
