## Port of pumpkin/src/block/entities/blasting_furnace.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import furnace_like_block_entity

const INVENTORY_SIZE*: int = 3
const ID*: string = "minecraft:blast_furnace"

type
  BlastingFurnaceBlockEntity* = ref object
    position*: BlockPos
    dirty*: bool
    cookingTimeSpent*: uint16
    cookingTotalTime*: uint16
    litTimeRemaining*: uint16
    litTotalTime*: uint16
    items*: array[INVENTORY_SIZE, ItemStack]
    recipesUsed*: StdMutex[Table[string, uint32]]



proc newBlastingFurnaceBlockEntity*(position: BlockPos): BlastingFurnaceBlockEntity

proc newBlastingFurnaceBlockEntity*(position: BlockPos): BlastingFurnaceBlockEntity =
  BlastingFurnaceBlockEntity(position: position, dirty: false, items: fromFn(R2A_MANUAL("closure |_| emptyItemStack()")), cookingTotalTime: 0, cookingTimeSpent: 0, litTotalTime: 0, litTimeRemaining: 0, recipesUsed: newStdMutex(initTable()))

implCookingBlockEntityBase(BlastingFurnaceBlockEntity)
implBlockEntityForCooking(BlastingFurnaceBlockEntity , CookingRecipeKind :: Blasting)
implInventoryForCooking(BlastingFurnaceBlockEntity)
implClearableForCooking(BlastingFurnaceBlockEntity)
implPropertyDelegateForCooking(BlastingFurnaceBlockEntity)
implExperienceContainerForCooking(BlastingFurnaceBlockEntity)
