## Port of pumpkin/src/block/entities/brewing_stand.rs
## The five stacks are a `BrewingInventory`, a `ContainerInventory` (containers.aowl) that also holds `brew_time`, `fuel`,
## `last_potion_count` and `ingredient_item`, with upstream's `remove_stack`, `remove_stack_specific` and
## `is_valid_slot_for`; the entity answers its `PropertyDelegate` from a `BrewingDelegate` over it.
## Upstream leaves the crafting remainder (a glass bottle from honey) as a TODO, and so does this.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property
import "../../../data/data_component_impl/mod"
import ../../../generated/potion_brewing

const INVENTORY_SIZE*: int = 5  # 3 potion slots + 1 ingredient + 1 fuel
const ID*: string = "minecraft:brewing_stand"

type
  BrewingInventory* = ref object of ContainerInventory
    brewTime*: int32
    fuel*: int32
    hasLastPotionCount*: bool
    lastPotionCount*: seq[bool]    # `[bool; 3]`
    ingredientItem*: nil Item      # `Option<&'static Item>`

  BrewingDelegate* = ref object of PropertyDelegate
    inv*: BrewingInventory

  BrewingStandBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: BrewingInventory
    delegate*: BrewingDelegate

var gBrewingStandBlockEntityVt: nil BlockEntityVt

proc asInv(c: BrewingInventory): Inventory =
  ## The compiler's not-nil proof wants the nil check before the conversion to the base type.
  if c == nil:
    rustPanic("brewing stand without its inventory")
  Inventory(c)

proc brewingIsValidSlotFor(self: Inventory; slot: int; stack: ItemStack): bool =
  if stack.isEmpty():
    return true
  case slot
  of 0 .. 2:
    # Slots 0-2 - potion bottles
    stack.getDataComponent(PotionContentsImpl)[0]
  of 3:
    # Slot 3 - ingredient (must be tagged as brewable)
    # Check if item is a valid brewing ingredient
    if hasTag(toTaggable(stack.getItem()), Item_MINECRAFT_BREWING_FUEL):
      return false   # Fuel should not go in ingredient slot
    # Allow any item that's not fuel (ingredient validation happens during brewing)
    true
  of 4:
    # Slot 4 - fuel
    hasTag(toTaggable(stack.getItem()), Item_MINECRAFT_BREWING_FUEL)
  else:
    false

proc brewingRemoveStack(self: Inventory; slot: int): ItemStack =
  let c = BrewingInventory(self)
  result = c.items[slot]
  c.items[slot] = emptyItemStack()

proc brewingRemoveStackSpecific(self: Inventory; slot: int; amount: uint8): ItemStack =
  let c = BrewingInventory(self)
  if c.items[slot].itemCount <= amount:
    result = c.items[slot]
    c.items[slot] = emptyItemStack()
  else:
    result = c.items[slot]
    result.itemCount = amount
    c.items[slot].itemCount -= amount

proc brewingOnOpen(self: Inventory) =
  discard

proc brewingOnClose(self: Inventory) =
  discard

proc brewingInventoryOps(): InventoryOps =
  result = containerInventoryOps()
  result.removeStack = brewingRemoveStack
  result.removeStackSpecific = brewingRemoveStackSpecific
  result.isValidSlotFor = brewingIsValidSlotFor
  result.onOpen = brewingOnOpen
  result.onClose = brewingOnClose

let gBrewingOps = brewingInventoryOps()

proc newBrewingInventory*(): BrewingInventory =
  result = BrewingInventory(brewTime: 0'i32, fuel: 0'i32, hasLastPotionCount: false, lastPotionCount: @[false, false, false],
    ingredientItem: nil)
  initContainer(result, INVENTORY_SIZE)
  result.ops = gBrewingOps

proc markDirty*(self: BrewingStandBlockEntity) =
  self.inv.dirty = true

proc ingredientMatches(self: BrewingStandBlockEntity, ingredient: ItemStack): bool =
  ## Check if the current ingredient matches the stored ingredient
  let stored = self.inv.ingredientItem
  if stored == nil:
    return false
  not ingredient.isEmpty() and ingredient.getItem().id == stored.id

proc ingredientListHas(ingredients: seq[string]; key: string): bool =
  ingredients.contains(key)

proc isBrewable(self: BrewingStandBlockEntity, ingredient: ItemStack): bool =
  ## Check if any potion slot has a valid recipe with the ingredient
  if ingredient.isEmpty():
    return false
  let ingredientKey = ingredient.getItem().registryKey
  # Check potion recipes (water bottle -> potions, potion upgrades, etc.)
  for slotIdx in 0 ..< 3:
    let slot = self.inv.items[slotIdx]
    if slot.isEmpty():
      continue
    # Check item recipes first (potion -> splash potion, splash -> lingering)
    for recipe in ITEM_RECIPES:
      if slot.getItem().registryKey == recipe.fromItem and ingredientListHas(recipe.ingredient, ingredientKey):
        return true
    # Check potion recipes (modify potion type)
    let pc = slot.getDataComponent(PotionContentsImpl)
    if pc[0] and pc[1].potionId.isSome:
      let potionId = pc[1].potionId.unsafeGet
      for recipe in POTION_RECIPES:
        if int32(recipe.fromPotion.id) == potionId and ingredientListHas(recipe.ingredient, ingredientKey):
          return true
  false

proc doBrew(self: BrewingStandBlockEntity, world: BlockWorld, ingredient: ItemStack) =
  ## Perform brewing on all valid potion slots
  let ingredientKey = ingredient.getItem().registryKey
  let inv = self.inv
  # Apply recipes to each slot
  for slotIdx in 0 ..< 3:
    let slot = inv.items[slotIdx]
    if slot.isEmpty():
      continue
    var haveNew = false
    var newStack = emptyItemStack()
    # Try item recipes first (potion -> splash/lingering)
    for recipe in ITEM_RECIPES:
      if slot.getItem().registryKey == recipe.fromItem and ingredientListHas(recipe.ingredient, ingredientKey):
        let newItem = Item.fromRegistryKey(recipe.toItem)
        if newItem == nil:
          break
        let potionComp = slot.getDataComponent(PotionContentsImpl)
        if potionComp[0]:
          newStack = newItemStackWithComponent(slot.itemCount, newItem,
            @[PatchEntry(id: dcPotionContents, present: true, data: potionComp[1].toDyn())])
        else:
          newStack = newItemStack(slot.itemCount, newItem)
        haveNew = true
        break
    # Try potion recipes (modify potion type) if item recipe didn't apply
    if not haveNew:
      let pc = slot.getDataComponent(PotionContentsImpl)
      if pc[0] and pc[1].potionId.isSome:
        let potionId = pc[1].potionId.unsafeGet
        for recipe in POTION_RECIPES:
          if int32(recipe.fromPotion.id) == potionId and ingredientListHas(recipe.ingredient, ingredientKey):
            let newPc = PotionContentsImpl(potionId: some(int32(recipe.toPotion.id)), customColor: pc[1].customColor,
              customEffects: pc[1].customEffects, customName: pc[1].customName)
            newStack = newItemStackWithComponent(slot.itemCount, slot.getItem(),
              @[PatchEntry(id: dcPotionContents, present: true, data: newPc.toDyn())])
            haveNew = true
            break
    # Update the slot using set_stack if a recipe was applied
    if haveNew:
      asInv(inv).setStack(slotIdx, newStack)
  # Consume ingredient
  inv.items[3].decrement(1'u8)
  let updatedIngredient = inv.items[3]
  # Update the slot with the decremented stack
  asInv(inv).setStack(3, updatedIngredient)
  # Play sound at the center of the block
  let pos = Vector3[float64](x: float64(self.position.vec.x) + 0.5, y: float64(self.position.vec.y) + 0.5,
    z: float64(self.position.vec.z) + 0.5)
  world.playSound(sdBlockBrewingStandBrew, scBlocks, pos)
  # Mark dirty to trigger update
  self.markDirty()
  # Handle crafting remainder (like glass bottles from honey bottles)
  # TODO upstream: Implement remainder handling when item lookup by ID is available

proc isPotionPresent(slot: ItemStack): bool =
  ## Considered "present" when it has an item and a PotionContents component or is a glass bottle
  if slot.isEmpty():
    return false
  if slot.getDataComponent(PotionContentsImpl)[0]:
    return true
  let bottle = Item.fromRegistryKey("glass_bottle")
  bottle != nil and slot.getItem().id == bottle.id

proc brewingStandBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc brewingStandBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BrewingStandBlockEntity(self0).position

proc brewingStandBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BrewingStandBlockEntity(self0)
  # Persist brew state
  nbt.putInt("BrewTime", self.inv.brewTime)
  nbt.putInt("Fuel", self.inv.fuel)
  # Save inventory contents to NBT
  asInv(self.inv).writeInventoryNbt(nbt, true)

proc brewingStandBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = BrewingStandBlockEntity(self0)
  var nbt = newCompound()
  nbt.putInt("BrewTime", self.inv.brewTime)
  nbt.putInt("Fuel", self.inv.fuel)
  syncWriteItemsToNbt(self.inv.items, nbt)
  some(nbt)

proc brewingStandBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  let c = BrewingStandBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(asInv(c))

proc brewingStandBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  BrewingStandBlockEntity(self0).inv.dirty

proc brewingStandBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  BrewingStandBlockEntity(self0).inv.dirty = false

proc delegateAsProperty(d: nil BrewingDelegate): Option[PropertyDelegate] =
  ## Upcast through a parameter (see containers.aowl `containerAsInventory`).
  if d == nil:
    return none[PropertyDelegate]()
  some(PropertyDelegate(d))

proc brewingStandBlockEntityToPropertyDelegate_BlockEntity(self0: BlockEntity): Option[PropertyDelegate] =
  delegateAsProperty(BrewingStandBlockEntity(self0).delegate)

proc brewingStandBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BrewingStandBlockEntity(self0)
  let inv = self.inv
  # Refill fuel counter from fuel item if needed
  var fuelRefilled = false
  if inv.fuel <= 0'i32:
    if not inv.items[4].isEmpty() and hasTag(toTaggable(inv.items[4].getItem()), Item_MINECRAFT_BREWING_FUEL):
      inv.fuel = 20'i32
      inv.items[4].decrement(1'u8)
      fuelRefilled = true

  # Get current ingredient and check brewing state
  let ingredient = inv.items[3]
  let brewable = self.isBrewable(ingredient)
  let isBrewing = inv.brewTime > 0'i32

  # Handle brewing state machine
  if isBrewing:
    # Decrement brew time
    inv.brewTime -= 1'i32
    let newBrewTime = inv.brewTime
    let isDoneBrewing = newBrewTime == 0'i32
    if isDoneBrewing and brewable:
      # Brewing complete
      self.doBrew(world, ingredient)
    elif not brewable or not self.ingredientMatches(ingredient):
      # Cancel brewing
      inv.brewTime = 0'i32
      self.markDirty()
    else:
      # Continue brewing
      self.markDirty()
  elif brewable and inv.fuel > 0'i32:
    # Start new brewing cycle
    inv.fuel -= 1'i32
    inv.brewTime = 400'i32
    inv.ingredientItem = ingredient.getItem()
    self.markDirty()
  elif fuelRefilled:
    # Mark dirty if fuel was refilled to update fuel indicator
    self.markDirty()

  # Ensure clients are notified when potion slot contents (and their data) change.
  # Compute current presence bits for the three bottle slots
  let current = @[isPotionPresent(inv.items[0]), isPotionPresent(inv.items[1]), isPotionPresent(inv.items[2])]

  # If potion presence changed, update last_potion_count and update block state so clients
  var needsUpdate = false
  if not inv.hasLastPotionCount or inv.lastPotionCount != current:
    inv.hasLastPotionCount = true
    inv.lastPotionCount = current
    needsUpdate = true

  if needsUpdate:
    # Update the block state properties for the brewing stand to reflect bottle presence
    let (blockRef, state) = world.getBlockAndState(self.position)
    var props = BrewingStandLikeProperties.fromStateId(state.id, blockRef)
    props.hasBottle0 = current[0]
    props.hasBottle1 = current[1]
    props.hasBottle2 = current[2]
    discard world.setBlockState(self.position, props.toStateId(blockRef), BfNotifyAll)
    # Also mark dirty so inventory/container updates are sent to open screens
    self.markDirty()

proc brewingDelegateGet(self: PropertyDelegate; index: int32): int32 =
  let c = BrewingDelegate(self).inv
  case index
  of 0: c.brewTime
  of 1: c.fuel
  else: 0'i32

proc brewingDelegateSet(self: PropertyDelegate; index: int32; value: int32) =
  discard

proc brewingDelegateSize(self: PropertyDelegate): int32 = 2'i32

proc brewingStandBlockEntityVt*(): BlockEntityVt =
  if gBrewingStandBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = brewingStandBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = brewingStandBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = brewingStandBlockEntityWriteNbt_BlockEntity
    v.tickImpl = brewingStandBlockEntityTick_BlockEntity
    v.getInventoryImpl = brewingStandBlockEntityGetInventory_BlockEntity
    v.chunkDataNbtImpl = brewingStandBlockEntityChunkDataNbt_BlockEntity
    v.isDirtyImpl = brewingStandBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = brewingStandBlockEntityClearDirty_BlockEntity
    v.toPropertyDelegateImpl = brewingStandBlockEntityToPropertyDelegate_BlockEntity
    gBrewingStandBlockEntityVt = v
  gBrewingStandBlockEntityVt

proc newBrewingStandBlockEntity*(position: BlockPos): BrewingStandBlockEntity =
  let inv = newBrewingInventory()
  BrewingStandBlockEntity(vt: brewingStandBlockEntityVt(), position: position, inv: inv,
    delegate: BrewingDelegate(getPropertyImpl: brewingDelegateGet, setPropertyImpl: brewingDelegateSet,
      getPropertiesSizeImpl: brewingDelegateSize, inv: inv))

proc brewingStandBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): BrewingStandBlockEntity =
  let entity = newBrewingStandBlockEntity(position)
  # Load brew time / fuel if present in NBT
  let bt = nbt.getInt("BrewTime")
  if bt.isSome:
    entity.inv.brewTime = bt.unsafeGet
  let f = nbt.getInt("Fuel")
  if f.isSome:
    entity.inv.fuel = f.unsafeGet
  # Load inventory items from NBT
  syncReadItemsFromNbt(nbt, entity.inv.items)
  # If there's an ingredient in slot 3, remember its base item for matching
  if not entity.inv.items[3].isEmpty():
    entity.inv.ingredientItem = entity.inv.items[3].getItem()
  # Recompute last_potion_count so visuals are correct after load
  entity.inv.hasLastPotionCount = true
  entity.inv.lastPotionCount = @[isPotionPresent(entity.inv.items[0]), isPotionPresent(entity.inv.items[1]),
    isPotionPresent(entity.inv.items[2])]
  entity
