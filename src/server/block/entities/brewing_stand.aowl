proc brewingStandBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): BrewingStandBlockEntity =
  let entity = newBrewingStandBlockEntity(position)
  # Load brew time / fuel if present in NBT
  let t22 = nbt.getInt("BrewTime")
  if t22.isSome:
    let bt = t22.unsafeGet
    entity.brewTime = t22.unsafeGet
  let t23 = nbt.getInt("Fuel")
  if t23.isSome:
    let f = t23.unsafeGet
    entity.fuel = t23.unsafeGet
  # Load inventory items from NBT
  entity.readData(nbt, entity.items)
  # If there's an ingredient in slot 3, remember its base item for matching
  let t24 = entity.items[3].tryLock()
  if t24.isOk and (not isEmpty(t24.value)):
    let guard = t24.value
    entity.ingredientItem.get() = some(t24.value.getItem())
  # Recompute last_potion_count so visuals are correct after load
  var current: array[3, bool] = R2A_MANUAL("array repeat")
  let t25 = entity.items.take(3).enumerate()
  for i, slotArc in t25:
    let t26 = slotArc.tryLock()
    if t26.isOk:
      let slot = t26.value
      current[i] = ((not isEmpty(t26.value)) and ((t26.value.getDataComponent().isSome() or (t26.value.getItem().id == itemGlassBottle().id))))
  entity.lastPotionCount.get() = some(current)
  entity

proc brewingStandBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = BrewingStandBlockEntity(self0)
  # Persist brew state
  nbt.putInt("BrewTime", self.brewTime)
  nbt.putInt("Fuel", self.fuel)
  # Save inventory contents to NBT
  self.writeInventoryNbt(nbt, true)

