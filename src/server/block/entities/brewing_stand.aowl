proc brewingStandBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = BrewingStandBlockEntity(self0)
  # Refill fuel counter from fuel item if needed
  let t27 = block:
    if (self.fuel <= 0):
      let fuelStackArc = self.items[4]
      if (not isEmpty(fuelStackArc)) and fuelStackArc.getItem().hasTag(Item_MINECRAFT_BREWING_FUEL):
        self.fuel = 20
        fuelStackArc.decrement(1)
        true
      else:
        false
    else:
      false
  let fuelRefilled = t27
  # Get current ingredient and check brewing state
  let ingredient = self.items[3]
  let brewable = self.isBrewable(ingredient)
  let isBrewing = (self.brewTime > 0)
  # Handle brewing state machine
  if isBrewing:
    # Decrement brew time
    let newBrewTime = (self.brewTime -= 1 - 1)
    let isDoneBrewing = (newBrewTime == 0)
    if isDoneBrewing and brewable:
      # Brewing complete
      self.doBrew(world, ingredient)
    elif ((not brewable) or (not self.ingredientMatches(ingredient))):
      # Cancel brewing
      self.brewTime = 0
      self.markDirty()
    else:
      # Continue brewing
      self.markDirty()
  else:
    if brewable and (self.fuel > 0):
      # Start new brewing cycle
      self.fuel -= 1
      self.brewTime = 400
      self.ingredientItem.get() = some(ingredient.getItem())
      self.markDirty()
    elif fuelRefilled:
      # Mark dirty if fuel was refilled to update fuel indicator
      self.markDirty()
  # Ensure clients are notified when potion slot contents (and their data) change.
  # Compute current presence bits for the three bottle slots
  var current: array[3, bool] = R2A_MANUAL("array repeat")
  let t28 = self.items.take(3).enumerate()
  for i, slotArc in t28:
    # Consider a potion slot "present" when it has an item and a PotionContents component or is a glass bottle
    current[i] = ((not isEmpty(slotArc)) and ((slotArc.getDataComponent().isSome() or (slotArc.getItem().id == itemGlassBottle().id))))
  # If potion presence changed, update last_potion_count and update block state so clients
  var needsUpdate = false
  block:
    var lastGuard = self.lastPotionCount.get()
    if (lastGuard != some(current)):
      lastGuard = some(current)
      needsUpdate = true
  if needsUpdate:
    # Update the block state properties for the brewing stand to reflect bottle presence
    let world1 = world
    let (blockRef, state) = world1.getBlockAndState(self.position)
    # Use generated block properties helper to produce a new state id with the bits set
    var props = BrewingStandLikeProperties.fromStateId(state.id, blockRef)
    # Generated field names use raw identifiers for clarity
    props.hasBottle0 = current[0]
    props.hasBottle1 = current[1]
    props.hasBottle2 = current[2]
    discard world1.setBlockState(self.position, props.toStateId(blockRef), BfNotifyAll)
    # Also mark dirty so inventory/container updates are sent to open screens
    self.markDirty()

