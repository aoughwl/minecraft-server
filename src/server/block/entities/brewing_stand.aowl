proc markDirty*(self: BrewingStandBlockEntity) =
  self.dirty = true

proc isValidSlotFor*(self: BrewingStandBlockEntity, slot: int, stack: ItemStack): bool =
  if isEmpty(stack):
    return true
  case slot
  of 0 .. 2:
    stack.getDataComponent().isSome()
  of 3:
    # Check if item is a valid brewing ingredient
    if stack.getItem().hasTag(Item_MINECRAFT_BREWING_FUEL):
      return false
    # Allow any item that's not fuel (ingredient validation happens during brewing)
    true
  of 4:
    stack.getItem().hasTag(Item_MINECRAFT_BREWING_FUEL)
  else:
    false

proc clear*(self: BrewingStandBlockEntity) =
  for slot in self.items:
    slot.clear()
  self.markDirty()

