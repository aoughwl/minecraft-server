proc isBrewable*(self: BrewingStandBlockEntity, ingredient: ItemStack): bool =
  if isEmpty(ingredient):
    return false
  let ingredientId = ingredient.getItem().id
  # Check potion recipes (water bottle -> potions, potion upgrades, etc.)
  for slotIdx in 0 ..< 3:
    if isEmpty(self.items[slotIdx]):
      continue
    # Check item recipes first (potion -> splash potion, splash -> lingering)
    for recipe in ITEM_RECIPES:
      var t5 = false
      if (self.items[slotIdx].getItem().id == recipe.from0().id):
        var t4 = false
        for i in recipe.ingredient():
          if (i.id == ingredientId):
            t4 = true
            break
        t5 = t4
      if t5:
        return true
    # Check potion recipes (modify potion type)
    let t6 = self.items[slotIdx].getDataComponent()
    let t7 = t6.unsafeGet.potionId
    if t6.isSome and t7.isSome:
      let pc = t6.unsafeGet
      let potionId = t7.unsafeGet
      for recipe in POTION_RECIPES:
        var t10 = false
        if (int32(recipe.from0().id) == t7.unsafeGet):
          var t9 = false
          for i in recipe.ingredient():
            if (i.id == ingredientId):
              t9 = true
              break
          t10 = t9
        if t10:
          return true
  false

proc doBrew*(self: BrewingStandBlockEntity, world: BlockWorld, ingredient: ItemStack) =
  let ingredientId = ingredient.getItem().id
  # Apply recipes to each slot
  for slotIdx in 0 ..< 3:
    if isEmpty(self.items[slotIdx]):
      continue
    var newStackOpt: Option[ItemStack] = R2A_NONE
    # Try item recipes first (potion -> splash/lingering)
    for recipe in ITEM_RECIPES:
      var t13 = false
      if (self.items[slotIdx].getItem().id == recipe.from0().id):
        var t12 = false
        for i in recipe.ingredient():
          if (i.id == ingredientId):
            t12 = true
            break
        t13 = t12
      if t13:
        let newItem = recipe.to0()
        let potionComp = self.items[slotIdx].getDataComponent()
        let newStack = potionComp.mapOrElse(R2A_MANUAL("closure |_| newItemStack(self.items[slotIdx].itemCount, newItem)"), R2A_MANUAL("closure |pc| t14"))
        newStackOpt = some(newStack)
        break
    # Try potion recipes (modify potion type) if item recipe didn't apply
    block chain17:
      if newStackOpt.isNone():
        let t15 = self.items[slotIdx].getDataComponent()
        if t15.isSome:
          let pc = t15.unsafeGet
          let t16 = t15.unsafeGet.potionId
          if t16.isSome:
            let potionId = t16.unsafeGet
            for recipe in POTION_RECIPES:
              var t20 = false
              if (int32(recipe.from0().id) == t16.unsafeGet):
                var t19 = false
                for i in recipe.ingredient():
                  if (i.id == ingredientId):
                    t19 = true
                    break
                t20 = t19
              if t20:
                let newPc = PotionContentsImpl(potionId: some(int32(recipe.to0().id)), customColor: t15.unsafeGet.customColor, customEffects: t15.unsafeGet.customEffects, customName: t15.unsafeGet.customName)
                let newStack1 = ItemStack.newWithComponent(self.items[slotIdx].itemCount, self.items[slotIdx].getItem(), @[(DataComponent.PotionContents, some(newPc.toDyn()))])
                newStackOpt = some(newStack1)
                break
    # Drop the lock before calling set_stack
    drop(self.items[slotIdx])
    # Update the slot using set_stack if a recipe was applied
    let t21 = newStackOpt
    if t21.isSome:
      let newStack = t21.unsafeGet
      self.setStack(slotIdx, t21.unsafeGet)
  # Consume ingredient
  self.items[3].decrement(1)
  let updatedIngredient = self.items[3]
  drop(self.items[3])
  # Update the slot with the decremented stack
  self.setStack(3, updatedIngredient)
  # Play sound at the center of the block
  let pos = newVector3((float64(self.position.vec.x) + 0.5), (float64(self.position.vec.y) + 0.5), (float64(self.position.vec.z) + 0.5))
  world.playSound(sdBlockBrewingStandBrew, scBlocks, pos)
  # Mark dirty to trigger update
  self.markDirty()

proc size*(self: BrewingStandBlockEntity): int =
  INVENTORY_SIZE

proc isEmpty*(self: BrewingStandBlockEntity): bool =
  for slot in self.items:
    if (not isEmpty(slot)):
      return false
  true

proc getStack*(self: BrewingStandBlockEntity, slot: int): ItemStack =
  self.items[slot]

proc removeStack*(self: BrewingStandBlockEntity, slot: int): ItemStack =
  var removed = emptyItemStack()
  swap(removed, self.items[slot])
  removed

proc removeStackSpecific*(self: BrewingStandBlockEntity, slot: int, amount: uint8): ItemStack =
  var taken = emptyItemStack()
  if (self.items[slot].itemCount <= amount):
    swap(taken, self.items[slot])
  else:
    taken = self.items[slot]
    taken.itemCount = amount
    self.items[slot].itemCount -= amount
  taken

proc setStack*(self: BrewingStandBlockEntity, slot: int, stack: ItemStack) =
  self.items[slot] = stack
  self.markDirty()

proc onOpen*(self: BrewingStandBlockEntity) =
