## Port of pumpkin/src/block/entities/brushable_block.rs
## The `Mutex` fields are plain fields here (one thread writes a world).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:brushable_block"

type
  BrushableBlockBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    item*: Option[ItemStack]
    hits*: int32
    direction*: uint8

var gBrushableBlockBlockEntityVt: nil BlockEntityVt

proc brushableBlockBlockEntityVt*(): BlockEntityVt

proc newBrushableBlockBlockEntity*(position: BlockPos): BrushableBlockBlockEntity =
  BrushableBlockBlockEntity(vt: brushableBlockBlockEntityVt(), position: position, item: none[ItemStack](), hits: 0'i32,
    direction: 0'u8)

proc brushableBlockBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc brushableBlockBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  BrushableBlockBlockEntity(self0).position

proc brushableBlockBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): BrushableBlockBlockEntity =
  var item = none[ItemStack]()
  let ic = nbt.getCompound("item")
  if ic.isSome:
    item = readItemStack(ic.unsafeGet)
  let hits = nbt.getInt("hits").get(0'i32)
  let direction = uint8(nbt.getByte("direction").get(0'i8))
  BrushableBlockBlockEntity(vt: brushableBlockBlockEntityVt(), position: position, item: item, hits: hits,
    direction: direction)

proc putBrushableFields(self: BrushableBlockBlockEntity; nbt: var NbtCompound) =
  if self.item.isSome:
    var itNbt = newCompound()
    self.item.unsafeGet.writeItemStack(itNbt)
    nbt.putCompound("item", itNbt)
  nbt.putInt("hits", self.hits)
  nbt.putByte("direction", int8(self.direction))

proc brushableBlockBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  putBrushableFields(BrushableBlockBlockEntity(self0), nbt)

proc brushableBlockBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  putBrushableFields(BrushableBlockBlockEntity(self0), nbt)
  some(nbt)

proc brushableBlockBlockEntityVt*(): BlockEntityVt =
  if gBrushableBlockBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = brushableBlockBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = brushableBlockBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = brushableBlockBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = brushableBlockBlockEntityChunkDataNbt_BlockEntity
    gBrushableBlockBlockEntityVt = v
  gBrushableBlockBlockEntityVt
