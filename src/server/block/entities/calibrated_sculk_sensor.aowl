import ../blockprelude

const ID*: string = "minecraft:calibrated_sculk_sensor"

type
  CalibratedSculkSensorBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    lastVibrationFrequency*: int32

var gCalibratedSculkSensorBlockEntityVt: nil BlockEntityVt


proc calibratedSculkSensorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc calibratedSculkSensorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc calibratedSculkSensorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): CalibratedSculkSensorBlockEntity
proc calibratedSculkSensorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc calibratedSculkSensorBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc calibratedSculkSensorBlockEntityVt*(): BlockEntityVt
proc newCalibratedSculkSensorBlockEntity*(position: BlockPos): CalibratedSculkSensorBlockEntity

proc calibratedSculkSensorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = CalibratedSculkSensorBlockEntity(self0)
  ID

proc calibratedSculkSensorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = CalibratedSculkSensorBlockEntity(self0)
  self.position

proc calibratedSculkSensorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): CalibratedSculkSensorBlockEntity =
  let lastVibrationFrequency = nbt.getInt("last_vibration_frequency").get(0)
  CalibratedSculkSensorBlockEntity(position: position, lastVibrationFrequency: lastVibrationFrequency)

proc calibratedSculkSensorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = CalibratedSculkSensorBlockEntity(self0)
  nbt.putInt("last_vibration_frequency", self.lastVibrationFrequency)

proc calibratedSculkSensorBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = CalibratedSculkSensorBlockEntity(self0)
  var nbt = newCompound()
  let t1 = self.lastVibrationFrequency.tryLock().ok()
  if t1.isNone: return none[NbtCompound]()
  nbt.putInt("last_vibration_frequency", t1.unsafeGet)
  some(nbt)

proc calibratedSculkSensorBlockEntityVt*(): BlockEntityVt =
  if gCalibratedSculkSensorBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = calibratedSculkSensorBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = calibratedSculkSensorBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = calibratedSculkSensorBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = calibratedSculkSensorBlockEntityChunkDataNbt_BlockEntity
    gCalibratedSculkSensorBlockEntityVt = v
  gCalibratedSculkSensorBlockEntityVt

proc newCalibratedSculkSensorBlockEntity*(position: BlockPos): CalibratedSculkSensorBlockEntity =
  CalibratedSculkSensorBlockEntity(position: position, lastVibrationFrequency: 0)

