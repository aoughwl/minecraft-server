## Port of pumpkin/src/block/entities/campfire.rs
## Upstream's entity has no tick, no dirty flag and no inventory yet (the cooking is a TODO there too).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:campfire"

type
  CampfireBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    items*: seq[ItemStack]  # four stacks: an `array[4, ItemStack]` trips the borrow checker (see the report)
    cookingTimes*: array[4, int32]
    cookingTotalTimes*: array[4, int32]

var gCampfireBlockEntityVt: nil BlockEntityVt

proc campfireBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc campfireBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  CampfireBlockEntity(self0).position

proc campfireBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = CampfireBlockEntity(self0)
  var list: seq[NbtTag] = @[]
  for i in 0 ..< 4:
    if not self.items[i].isEmpty():
      var itemNbt = newCompound()
      itemNbt.putByte("Slot", int8(i))
      self.items[i].writeItemStack(itemNbt)
      list.add(nbtTag(itemNbt))
  nbt.putList("Items", list)
  var times: seq[int32] = @[]
  for m in self.cookingTimes:
    times.add(m)
  nbt.put("CookingTimes", NbtTag(kind: ntkIntArray, intArrayVal: times))
  var totalTimes: seq[int32] = @[]
  for m in self.cookingTotalTimes:
    totalTimes.add(m)
  nbt.put("CookingTotalTimes", NbtTag(kind: ntkIntArray, intArrayVal: totalTimes))

proc campfireBlockEntityVt*(): BlockEntityVt =
  if gCampfireBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = campfireBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = campfireBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = campfireBlockEntityWriteNbt_BlockEntity
    gCampfireBlockEntityVt = v
  gCampfireBlockEntityVt

proc newCampfireBlockEntity*(position: BlockPos): CampfireBlockEntity =
  CampfireBlockEntity(vt: campfireBlockEntityVt(), position: position,
    items: emptyStacks(4),
    cookingTimes: [0'i32, 0'i32, 0'i32, 0'i32], cookingTotalTimes: [0'i32, 0'i32, 0'i32, 0'i32])

proc readCampfireItems(nbt: NbtCompound): seq[ItemStack] =
  result = emptyStacks(4)
  let t1 = nbt.getList("Items")
  if t1.isSome:
    let list = t1.unsafeGet
    for i in 0 ..< list.len:
      if list[i].kind == ntkCompound:
        let compound = list[i].compoundVal
        let slotByte = compound.getByte("Slot")
        let slot = if slotByte.isSome: int(slotByte.unsafeGet) else: 0
        if slot >= 0 and slot < 4:
          let t3 = readItemStack(compound)
          if t3.isSome:
            result[slot] = t3.unsafeGet

proc readCampfireTimes(nbt: NbtCompound, name: string): array[4, int32] =
  ## `get_int_array(name)` into the first four entries (a var argument of a field of `e` aliases `e` for the compiler)
  result = [0'i32, 0'i32, 0'i32, 0'i32]
  for k in 0 ..< nbt.names.len:
    if nbt.names[k] == name and nbt.values[k].kind == ntkIntArray:
      let arr = nbt.values[k].intArrayVal
      for i in 0 ..< min(arr.len, 4):
        result[i] = arr[i]

proc campfireBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): CampfireBlockEntity =
  CampfireBlockEntity(vt: campfireBlockEntityVt(), position: position, items: readCampfireItems(nbt),
    cookingTimes: readCampfireTimes(nbt, "CookingTimes"), cookingTotalTimes: readCampfireTimes(nbt, "CookingTotalTimes"))
