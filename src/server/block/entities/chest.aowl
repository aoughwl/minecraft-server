## Port of pumpkin/src/block/entities/chest.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import chest_like_block_entity
export chest_like_block_entity

const ID*: string = "minecraft:chest"
const EMITS_REDSTONE*: bool = false

type
  ChestBlockEntity* = ChestLikeBlockEntity
    ## One type for both chests: a second level of `ref object` under `BlockEntity` trips the compiler's code generator
    ## (see the report). `id` tells the chest from the trapped chest.

proc newChestBlockEntity*(position: BlockPos): ChestBlockEntity =
  let chest = ChestLikeBlockEntity()
  initChestLike(chest, position, false)
  chest

proc chestBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): ChestBlockEntity =
  let chest = newChestBlockEntity(position)
  readChestLike(chest, nbt)
  chest
