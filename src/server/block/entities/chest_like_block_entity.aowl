## Port of pumpkin/src/block/entities/chest_like_block_entity.rs
## Upstream's macros (`impl_block_entity_for_chest`, `impl_inventory_for_chest`, `impl_clearable_for_chest`,
## `impl_viewer_count_listener_for_chest`, `impl_chest_helper_methods`) become one base type here, `ChestLikeBlockEntity`,
## that `ChestBlockEntity` and `TrappedChestBlockEntity` extend with their `ID` and `EMITS_REDSTONE`. The stacks are a
## `ContainerInventory` (containers.aowl), which is the entity's `Inventory`. An absent loot table is the empty string.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 27
const LID_ANIMATION_EVENT_TYPE*: uint8 = 1

type
  PendingLoot* = ref object
    ## `loot_table` and `loot_table_seed`: the key of a table whose items are not generated yet, and its seed.
    key*: string
    seed*: int64

  ChestLikeBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory
    trapped*: bool        # told apart from the chest by `ID`; `EMITS_REDSTONE` is the same flag
    pending*: nil PendingLoot  # `Option<(String, i64)>`: nil when none, cleared when the items are generated on first open

var gChestLikeVt: nil BlockEntityVt

proc playSound*(self: ChestLikeBlockEntity, world: BlockWorld, sound: Sound) =
  let (blockRef, state) = world.getBlockAndStateId(self.position)
  let properties = ChestLikeProperties.fromStateId(state, blockRef)
  var position: Vector3[float64]
  case properties.`type`
  of ChestType.Left:
    return
  of ChestType.Single:
    position = Vector3[float64](x: float64(self.position.vec.x) + 0.5, y: float64(self.position.vec.y) + 0.5,
      z: float64(self.position.vec.z) + 0.5)
  of ChestType.Right:
    let direction = properties.facing.toBlockDirection().toOffset()
    position = Vector3[float64](x: float64(self.position.vec.x) + 0.5 + float64(direction.x) * 0.5,
      y: float64(self.position.vec.y) + 0.5, z: float64(self.position.vec.z) + 0.5 + float64(direction.z) * 0.5)
  world.playSoundFine(sound, scBlocks, position, 0.5, (randomOf(float32) * 0.1'f32) + 0.9'f32)

proc onContainerOpen*(self: ChestLikeBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockChestOpen)

proc onContainerClose*(self: ChestLikeBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockChestClose)

proc onViewerCountUpdate*(self: ChestLikeBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new0: uint16) =
  # Trigger block animation
  world.addSyncedBlockEvent(position, LID_ANIMATION_EVENT_TYPE, uint8(new0 and 255'u16))
  # Update neighbors for redstone signal when viewer count changes
  if self.trapped and old != new0:
    # Update direct neighbors
    world.updateNeighbors(position, none[BlockDirection]())
    # Also update neighbors of the block below (strongly powered block)
    world.updateNeighbors(position.down(), none[BlockDirection]())

proc getViewerCount*(self: ChestLikeBlockEntity): uint16 =
  ## `get_viewer_count`
  let v = self.inv.viewers
  if v == nil:
    return 0'u16
  v.getViewerCount()

proc chestLikeResourceLocation(self0: BlockEntity): string =
  if ChestLikeBlockEntity(self0).trapped: "minecraft:trapped_chest" else: "minecraft:chest"

proc chestLikeGetPosition(self0: BlockEntity): BlockPos =
  ChestLikeBlockEntity(self0).position

proc lootKey(e: BlockEntity): string =
  let p = ChestLikeBlockEntity(e).pending
  if p == nil: "" else: p.key

proc lootSeed(e: BlockEntity): int64 =
  let p = ChestLikeBlockEntity(e).pending
  if p == nil: 0'i64 else: p.seed

proc chestLikeWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let key = lootKey(self0)
  if key.len > 0:
    # Persist deferred loot: write the key and seed; skip items.
    nbt.putString("LootTable", key)
    let seed = lootSeed(self0)
    if seed != 0:
      nbt.putLong("LootTableSeed", seed)
  else:
    # Loot has already been generated, so persist the actual items.
    let c = ChestLikeBlockEntity(self0).inv
    if c != nil:
      let i = containerAsInventory(c)
      i.writeInventoryNbt(nbt, true)

proc chestLikeTick(self0: BlockEntity, world: BlockWorld) =
  let c = ChestLikeBlockEntity(self0).inv
  if c != nil:
    let v = c.viewers
    if v != nil:
      v.updateViewerCount(ChestLikeBlockEntity(self0), world, ChestLikeBlockEntity(self0).position)

proc chestLikeGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = ChestLikeBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc chestLikeIsDirty(self0: BlockEntity): bool =
  ChestLikeBlockEntity(self0).inv.dirty

proc chestLikeClearDirty(self0: BlockEntity) =
  ChestLikeBlockEntity(self0).inv.dirty = false

proc chestLikeChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  let key = lootKey(self0)
  if key.len > 0:
    nbt.putString("LootTable", key)
    let seed = lootSeed(self0)
    if seed != 0:
      nbt.putLong("LootTableSeed", seed)
  else:
    syncWriteItemsToNbt(ChestLikeBlockEntity(self0).inv.items, nbt)
  some(nbt)

proc chestLikeTakeLootTable(self0: BlockEntity): Option[(string, int64)] =
  let key = lootKey(self0)
  if key.len == 0:
    return none[(string, int64)]()
  let seed = lootSeed(self0)
  ChestLikeBlockEntity(self0).pending = nil
  some((key, seed))

proc chestLikeHasLootTable(self0: BlockEntity): bool =
  lootKey(self0).len > 0

proc chestLikeVt*(): BlockEntityVt =
  if gChestLikeVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = chestLikeResourceLocation
    v.getPositionImpl = chestLikeGetPosition
    v.writeNbtImpl = chestLikeWriteNbt
    v.tickImpl = chestLikeTick
    v.getInventoryImpl = chestLikeGetInventory
    v.isDirtyImpl = chestLikeIsDirty
    v.clearDirtyImpl = chestLikeClearDirty
    v.chunkDataNbtImpl = chestLikeChunkDataNbt
    v.takeLootTableImpl = chestLikeTakeLootTable
    v.hasLootTableImpl = chestLikeHasLootTable
    gChestLikeVt = v
  gChestLikeVt

proc initChestLike*(self: ChestLikeBlockEntity; position: BlockPos; trapped: bool) =
  ## `new`
  self.vt = chestLikeVt()
  self.position = position
  self.inv = newContainerInventory(INVENTORY_SIZE)
  self.trapped = trapped
  self.pending = nil

proc setPendingLoot*(self: ChestLikeBlockEntity; key: string; seed: int64) =
  self.pending = PendingLoot(key: key, seed: seed)

proc readChestLike*(self: ChestLikeBlockEntity; nbt: NbtCompound) =
  ## `from_nbt` after `new`: the deferred loot-table fields first, and the saved items only when no loot table is pending.
  let key = nbt.getString("LootTable")
  let seed = nbt.getLong("LootTableSeed").get(0'i64)
  if key.isSome:
    self.pending = PendingLoot(key: key.unsafeGet, seed: seed)
  if key.isNone:
    syncReadItemsFromNbt(nbt, self.inv.items)
