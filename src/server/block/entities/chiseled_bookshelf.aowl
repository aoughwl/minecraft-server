## Port of pumpkin/src/block/entities/chiseled_bookshelf.rs
## The six stacks live in a `ContainerInventory` (containers.aowl): upstream's entity is its own `Inventory`, which a
## `ref object of BlockEntity` cannot also be. `inv.items` and `inv.dirty` are upstream's `items` and `dirty`. Upstream's
## `warn!` for an invalid slot in `update_state` is not logged here.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const LAST_INTERACTED_SLOT: string = "last_interacted_slot"
const INVENTORY_SIZE*: int = 6
const ID*: string = "minecraft:chiseled_bookshelf"

type
  ChiseledBookshelfBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory
    lastInteractedSlot*: int8

var gChiseledBookshelfBlockEntityVt: nil BlockEntityVt

proc chiseledBookshelfBlockEntityVt*(): BlockEntityVt

proc asInventory(self: ChiseledBookshelfBlockEntity): Inventory =
  ## The `ContainerInventory` as its base (`Inventory(self.inv)` alone trips the nil analysis).
  let c = self.inv
  if c != nil:
    return Inventory(c)
  Inventory(newArrayInventory(0))

proc newChiseledBookshelfBlockEntity*(position: BlockPos): ChiseledBookshelfBlockEntity =
  let inv = newContainerInventory(INVENTORY_SIZE)
  inv.viewers = nil
  ChiseledBookshelfBlockEntity(vt: chiseledBookshelfBlockEntityVt(), position: position, inv: inv,
    lastInteractedSlot: -1'i8)

proc chiseledBookshelfBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc chiseledBookshelfBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  ChiseledBookshelfBlockEntity(self0).position

proc chiseledBookshelfBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): ChiseledBookshelfBlockEntity =
  let chiseledBookshelf = newChiseledBookshelfBlockEntity(position)
  chiseledBookshelf.lastInteractedSlot = int8(nbt.getInt(LAST_INTERACTED_SLOT).get(-1'i32))
  syncReadItemsFromNbt(nbt, chiseledBookshelf.inv.items)
  chiseledBookshelf

proc chiseledBookshelfBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = ChiseledBookshelfBlockEntity(self0)
  # Write inventory data to NBT
  self.asInventory().writeInventoryNbt(nbt, true)
  # Save last interacted slot
  nbt.putInt(LAST_INTERACTED_SLOT, int32(self.lastInteractedSlot))

proc chiseledBookshelfBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  some(ChiseledBookshelfBlockEntity(self0).asInventory())

proc chiseledBookshelfBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  ChiseledBookshelfBlockEntity(self0).inv.dirty

proc chiseledBookshelfBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  ChiseledBookshelfBlockEntity(self0).inv.dirty = false

proc chiseledBookshelfBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = ChiseledBookshelfBlockEntity(self0)
  var nbt = newCompound()
  syncWriteItemsToNbt(self.inv.items, nbt)
  nbt.putInt("last_interacted_slot", int32(self.lastInteractedSlot))
  some(nbt)

proc chiseledBookshelfBlockEntityVt*(): BlockEntityVt =
  if gChiseledBookshelfBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = chiseledBookshelfBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = chiseledBookshelfBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = chiseledBookshelfBlockEntityWriteNbt_BlockEntity
    v.getInventoryImpl = chiseledBookshelfBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = chiseledBookshelfBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = chiseledBookshelfBlockEntityClearDirty_BlockEntity
    v.chunkDataNbtImpl = chiseledBookshelfBlockEntityChunkDataNbt_BlockEntity
    gChiseledBookshelfBlockEntityVt = v
  gChiseledBookshelfBlockEntityVt

proc updateState*(self: ChiseledBookshelfBlockEntity, properties: ChiseledBookshelfLikeProperties, world: BlockWorld, slot: int8) =
  var properties = properties
  if slot >= 0'i8 and slot < int8(self.inv.items.len):
    self.lastInteractedSlot = slot
    properties.slot0Occupied = not self.inv.items[0].isEmpty()
    properties.slot1Occupied = not self.inv.items[1].isEmpty()
    properties.slot2Occupied = not self.inv.items[2].isEmpty()
    properties.slot3Occupied = not self.inv.items[3].isEmpty()
    properties.slot4Occupied = not self.inv.items[4].isEmpty()
    properties.slot5Occupied = not self.inv.items[5].isEmpty()
    discard world.setBlockState(self.position, properties.toStateId(blockChiseledBookshelf()), BfNotifyAll)

proc getStack*(self: ChiseledBookshelfBlockEntity, slot: int): ItemStack =
  self.inv.items[slot]

proc removeStack*(self: ChiseledBookshelfBlockEntity, slot: int): ItemStack =
  self.asInventory().removeStack(slot)

proc removeStackSpecific*(self: ChiseledBookshelfBlockEntity, slot: int, amount: uint8): ItemStack =
  self.asInventory().removeStackSpecific(slot, amount)

proc setStack*(self: ChiseledBookshelfBlockEntity, slot: int, stack: ItemStack) =
  self.asInventory().setStack(slot, stack)
