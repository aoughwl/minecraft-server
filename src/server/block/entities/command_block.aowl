  nbt.putString("Command", $(self.command))
  nbt.putBool("conditionMet", self.conditionMet)
  nbt.putString("LastOutput", $(self.lastOutput))
  nbt.putBool("powered", self.powered)
  nbt.putBool("TrackOutput", self.trackOutput)
  nbt.putBool("UpdateLastExecution", false)
  nbt.putInt("SuccessCount", self.successCount.castSigned())

