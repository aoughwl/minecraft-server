## Port of pumpkin/src/block/entities/command_block.rs
## The `Mutex` and atomic fields are plain fields here (one thread writes a world). Only the entity is ported: the block that
## runs it (blocks/command.rs) needs the command dispatcher from a block module, and is still a draft.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:command_block"

type
  CommandBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    powered*: bool
    conditionMet*: bool
    auto*: bool
    dirty*: bool
    command*: string
    lastOutput*: string
    trackOutput*: bool
    successCount*: uint32

var gCommandBlockEntityVt: nil BlockEntityVt

proc commandBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc commandBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  CommandBlockEntity(self0).position

proc commandBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = CommandBlockEntity(self0)
  nbt.putBool("auto", self.auto)
  nbt.putString("Command", self.command)
  nbt.putBool("conditionMet", self.conditionMet)
  nbt.putString("LastOutput", self.lastOutput)
  nbt.putBool("powered", self.powered)
  nbt.putBool("TrackOutput", self.trackOutput)
  nbt.putBool("UpdateLastExecution", false)
  nbt.putInt("SuccessCount", cast[int32](self.successCount))

proc commandBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  commandBlockEntityWriteNbt_BlockEntity(self0, nbt)
  some(nbt)

proc commandBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  CommandBlockEntity(self0).dirty

proc commandBlockEntityVt*(): BlockEntityVt =
  if gCommandBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = commandBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = commandBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = commandBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = commandBlockEntityChunkDataNbt_BlockEntity
    v.isDirtyImpl = commandBlockEntityIsDirty_BlockEntity
    gCommandBlockEntityVt = v
  gCommandBlockEntityVt

proc newCommandBlockEntity*(position: BlockPos, trackOutput: bool, isChain: bool): CommandBlockEntity =
  CommandBlockEntity(vt: commandBlockEntityVt(), position: position, powered: false, conditionMet: false, auto: isChain,
    dirty: false, command: "", lastOutput: "", trackOutput: trackOutput, successCount: 0'u32)

proc commandBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): CommandBlockEntity =
  CommandBlockEntity(vt: commandBlockEntityVt(), position: position, conditionMet: nbt.getBool("conditionMet").get(false),
    auto: nbt.getBool("auto").get(false), powered: nbt.getBool("powered").get(false), command: nbt.getString("Command").get(""),
    lastOutput: nbt.getString("LastOutput").get(""), trackOutput: nbt.getBool("TrackOutput").get(false),
    successCount: cast[uint32](nbt.getInt("SuccessCount").get(0'i32)), dirty: false)
