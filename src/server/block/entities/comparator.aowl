import ../blockprelude

const ID*: string = "minecraft:comparator"
const OUTPUT_SIGNAL: string = "OutputSignal"

type
  ComparatorBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    outputSignal*: uint8

var gComparatorBlockEntityVt: nil BlockEntityVt


proc newComparatorBlockEntity*(position: BlockPos): ComparatorBlockEntity
proc comparatorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc comparatorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc comparatorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): ComparatorBlockEntity
proc comparatorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc comparatorBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc comparatorBlockEntityVt*(): BlockEntityVt

proc newComparatorBlockEntity*(position: BlockPos): ComparatorBlockEntity =
  ComparatorBlockEntity(position: position, outputSignal: 0)

proc comparatorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = ComparatorBlockEntity(self0)
  ID

proc comparatorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = ComparatorBlockEntity(self0)
  self.position

proc comparatorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): ComparatorBlockEntity =
  let outputSignal = uint8(nbt.getInt(OUTPUT_SIGNAL).get(0))
  ComparatorBlockEntity(position: position, outputSignal: outputSignal)

proc comparatorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = ComparatorBlockEntity(self0)
  nbt.putInt(OUTPUT_SIGNAL, int32(self.outputSignal))

proc comparatorBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = ComparatorBlockEntity(self0)
  var nbt = newCompound()
  nbt.putInt(OUTPUT_SIGNAL, int32(self.outputSignal))
  some(nbt)

proc comparatorBlockEntityVt*(): BlockEntityVt =
  if gComparatorBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = comparatorBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = comparatorBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = comparatorBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = comparatorBlockEntityChunkDataNbt_BlockEntity
    gComparatorBlockEntityVt = v
  gComparatorBlockEntityVt

