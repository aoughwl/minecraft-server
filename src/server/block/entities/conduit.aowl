## Port of pumpkin/src/block/entities/conduit.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:conduit"

type
  ConduitBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    active*: bool
    target*: Option[NbtTag]

var gConduitBlockEntityVt: nil BlockEntityVt


proc conduitBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc conduitBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc conduitBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): ConduitBlockEntity
proc conduitBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc conduitBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc conduitBlockEntityVt*(): BlockEntityVt
proc newConduitBlockEntity*(position: BlockPos): ConduitBlockEntity

proc conduitBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = ConduitBlockEntity(self0)
  ID

proc conduitBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = ConduitBlockEntity(self0)
  self.position

proc conduitBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): ConduitBlockEntity =
  let active = nbt.getBool("Active").get(false)
  let target = nbt.get("Target")
  ConduitBlockEntity(position: position, active: active, target: target)

proc conduitBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = ConduitBlockEntity(self0)
  nbt.putBool("Active", self.active)
  let t1 = self.target
  if t1.isSome:
    let tgt = t1.unsafeGet
    nbt.put("Target", t1.unsafeGet)

proc conduitBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = ConduitBlockEntity(self0)
  var nbt = newCompound()
  let t2 = self.active.tryLock().ok()
  if t2.isNone: return none[NbtCompound]()
  nbt.putBool("Active", t2.unsafeGet)
  let t3 = self.target.tryLock()
  let t4 = t3.value
  if t3.isOk and t4.isSome:
    let target = t3.value
    let tgt = t4.unsafeGet
    nbt.put("Target", t4.unsafeGet)
  some(nbt)

proc conduitBlockEntityVt*(): BlockEntityVt =
  if gConduitBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = conduitBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = conduitBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = conduitBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = conduitBlockEntityChunkDataNbt_BlockEntity
    gConduitBlockEntityVt = v
  gConduitBlockEntityVt

proc newConduitBlockEntity*(position: BlockPos): ConduitBlockEntity =
  ConduitBlockEntity(position: position, active: false, )

