import ../blockprelude

const INVENTORY_SIZE*: int = 9
const ID*: string = "minecraft:crafter"

type
  CrafterBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    items*: array[INVENTORY_SIZE, ItemStack]
    craftingTicksRemaining*: int32
    triggered*: bool
    dirty*: bool

var gCrafterBlockEntityVt: nil BlockEntityVt


proc crafterBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc crafterBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): CrafterBlockEntity
proc crafterBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc crafterBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc crafterBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory]
proc crafterBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool
proc crafterBlockEntityClearDirty_BlockEntity(self0: BlockEntity)
proc crafterBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc crafterBlockEntityVt*(): BlockEntityVt
proc newCrafterBlockEntity*(position: BlockPos): CrafterBlockEntity
proc size*(self: CrafterBlockEntity): int
proc isEmpty*(self: CrafterBlockEntity): bool
proc getStack*(self: CrafterBlockEntity, slot: int): ItemStack
proc removeStack*(self: CrafterBlockEntity, slot: int): ItemStack
proc removeStackSpecific*(self: CrafterBlockEntity, slot: int, amount: uint8): ItemStack
proc setStack*(self: CrafterBlockEntity, slot: int, stack: ItemStack)
proc markDirty*(self: CrafterBlockEntity)
proc clear*(self: CrafterBlockEntity)

proc crafterBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = CrafterBlockEntity(self0)
  self.writeInventoryNbt(nbt, true)
  nbt.putInt("crafting_ticks_remaining", self.craftingTicksRemaining)
  nbt.putBool("triggered", self.triggered)

proc crafterBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): CrafterBlockEntity =
  let crafter = CrafterBlockEntity(position: position, items: fromFn(R2A_MANUAL("closure |_| emptyItemStack()")), craftingTicksRemaining: nbt.getInt("crafting_ticks_remaining").get(0), triggered: nbt.getBool("triggered").get(false), dirty: false)
  crafter.readData(nbt, crafter.items)
  crafter

proc crafterBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = CrafterBlockEntity(self0)
  ID

proc crafterBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = CrafterBlockEntity(self0)
  self.position

proc crafterBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  let self = CrafterBlockEntity(self0)
  some(self)

proc crafterBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  let self = CrafterBlockEntity(self0)
  self.dirty

proc crafterBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  let self = CrafterBlockEntity(self0)
  self.dirty = false

proc crafterBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = CrafterBlockEntity(self0)
  var nbt = newCompound()
  syncWriteItemsToNbt(self.items, nbt)
  nbt.putInt("crafting_ticks_remaining", self.craftingTicksRemaining)
  nbt.putBool("triggered", self.triggered)
  some(nbt)

proc crafterBlockEntityVt*(): BlockEntityVt =
  if gCrafterBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.writeNbtImpl = crafterBlockEntityWriteNbt_BlockEntity
    v.resourceLocationImpl = crafterBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = crafterBlockEntityGetPosition_BlockEntity
    v.getInventoryImpl = crafterBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = crafterBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = crafterBlockEntityClearDirty_BlockEntity
    v.chunkDataNbtImpl = crafterBlockEntityChunkDataNbt_BlockEntity
    gCrafterBlockEntityVt = v
  gCrafterBlockEntityVt

proc newCrafterBlockEntity*(position: BlockPos): CrafterBlockEntity =
  CrafterBlockEntity(position: position, items: fromFn(R2A_MANUAL("closure |_| emptyItemStack()")), craftingTicksRemaining: 0, triggered: false, dirty: false)

proc size*(self: CrafterBlockEntity): int =
  len(self.items)

proc isEmpty*(self: CrafterBlockEntity): bool =
  for slot in self.items:
    if (not isEmpty(slot)):
      return false
  true

proc getStack*(self: CrafterBlockEntity, slot: int): ItemStack =
  self.items[slot]

proc removeStack*(self: CrafterBlockEntity, slot: int): ItemStack =
  var removed = emptyItemStack()
  swap(removed, self.items[slot])
  self.markDirty()
  removed

proc removeStackSpecific*(self: CrafterBlockEntity, slot: int, amount: uint8): ItemStack =
  let res = splitStack(self.items, slot, amount)
  self.markDirty()
  res

proc setStack*(self: CrafterBlockEntity, slot: int, stack: ItemStack) =
  self.items[slot] = stack
  self.markDirty()

proc markDirty*(self: CrafterBlockEntity) =
  self.dirty = true

proc clear*(self: CrafterBlockEntity) =
  for slot in self.items:
    slot = emptyItemStack()
  self.markDirty()

