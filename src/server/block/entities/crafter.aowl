## Port of pumpkin/src/block/entities/crafter.rs
## The nine stacks live in a `ContainerInventory` (containers.aowl), the entity's `Inventory`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 9
const ID*: string = "minecraft:crafter"

type
  CrafterBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory
    craftingTicksRemaining*: int32
    triggered*: bool

var gCrafterBlockEntityVt: nil BlockEntityVt

proc crafterResourceLocation(self0: BlockEntity): string =
  ID

proc crafterGetPosition(self0: BlockEntity): BlockPos =
  CrafterBlockEntity(self0).position

proc crafterWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let self = CrafterBlockEntity(self0)
  let c = self.inv
  if c != nil:
    let i = Inventory(c)
    i.writeInventoryNbt(nbt, true)
  nbt.putInt("crafting_ticks_remaining", self.craftingTicksRemaining)
  nbt.putBool("triggered", self.triggered)

proc crafterGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = CrafterBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc crafterIsDirty(self0: BlockEntity): bool =
  CrafterBlockEntity(self0).inv.dirty

proc crafterClearDirty(self0: BlockEntity) =
  CrafterBlockEntity(self0).inv.dirty = false

proc crafterChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  let self = CrafterBlockEntity(self0)
  var nbt = newCompound()
  syncWriteItemsToNbt(self.inv.items, nbt)
  nbt.putInt("crafting_ticks_remaining", self.craftingTicksRemaining)
  nbt.putBool("triggered", self.triggered)
  some(nbt)

proc crafterBlockEntityVt*(): BlockEntityVt =
  if gCrafterBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = crafterResourceLocation
    v.getPositionImpl = crafterGetPosition
    v.writeNbtImpl = crafterWriteNbt
    v.getInventoryImpl = crafterGetInventory
    v.isDirtyImpl = crafterIsDirty
    v.clearDirtyImpl = crafterClearDirty
    v.chunkDataNbtImpl = crafterChunkDataNbt
    gCrafterBlockEntityVt = v
  gCrafterBlockEntityVt

proc newCrafterBlockEntity*(position: BlockPos): CrafterBlockEntity =
  CrafterBlockEntity(vt: crafterBlockEntityVt(), position: position, inv: newContainerInventory(INVENTORY_SIZE),
    craftingTicksRemaining: 0'i32, triggered: false)

proc crafterBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): CrafterBlockEntity =
  let crafter = newCrafterBlockEntity(position)
  let ticks = nbt.getInt("crafting_ticks_remaining")
  crafter.craftingTicksRemaining = if ticks.isSome: ticks.unsafeGet else: 0'i32
  let triggered = nbt.getBool("triggered")
  crafter.triggered = if triggered.isSome: triggered.unsafeGet else: false
  syncReadItemsFromNbt(nbt, crafter.inv.items)
  crafter
