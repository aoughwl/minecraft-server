import ../blockprelude

const ID*: string = "minecraft:daylight_detector"

type
  DaylightDetectorProperties = DaylightDetectorLikeProperties
  DaylightDetectorBlockEntity* = ref object of BlockEntity
    position*: BlockPos

var gDaylightDetectorBlockEntityVt: nil BlockEntityVt


proc daylightDetectorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc daylightDetectorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc daylightDetectorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): DaylightDetectorBlockEntity
proc daylightDetectorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc daylightDetectorBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld)
proc daylightDetectorBlockEntityVt*(): BlockEntityVt
