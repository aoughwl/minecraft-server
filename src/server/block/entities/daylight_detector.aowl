proc updatePower*(world: BlockWorld, blockPos: BlockPos)

proc daylightDetectorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = DaylightDetectorBlockEntity(self0)
  ID

proc daylightDetectorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = DaylightDetectorBlockEntity(self0)
  self.position

proc daylightDetectorBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): DaylightDetectorBlockEntity =
  DaylightDetectorBlockEntity(position: position)

proc daylightDetectorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = DaylightDetectorBlockEntity(self0)
  discard

proc daylightDetectorBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = DaylightDetectorBlockEntity(self0)
  if ((world.getWorldAge() mod 20) == 0) and world.dimension.hasSkylight:
    updatePower(world, self.position)

proc daylightDetectorBlockEntityVt*(): BlockEntityVt =
  if gDaylightDetectorBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = daylightDetectorBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = daylightDetectorBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = daylightDetectorBlockEntityWriteNbt_BlockEntity
    v.tickImpl = daylightDetectorBlockEntityTick_BlockEntity
    gDaylightDetectorBlockEntityVt = v
  gDaylightDetectorBlockEntityVt

proc newDaylightDetectorBlockEntity*(position: BlockPos): DaylightDetectorBlockEntity =
  DaylightDetectorBlockEntity(position: position)

proc updatePower*(world: BlockWorld, blockPos: BlockPos) =
  let (blockRef, state) = world.getBlockAndState(blockPos)
  var props = DaylightDetectorProperties.fromStateId(state.id, blockRef)
  let inverted = props.inverted
  # TODO: finish power signal calculation
  # see: https://minecraft.wiki/w/Light#Internal_sky_light
  let timeOfDay = world.getTimeOfDay()
  # Sun Angle
  let sunAngleFraction = (((float32(timeOfDay) / 24000.0'f32)) - 0.25'f32)
  var sunAngleRadians = (sunAngleFraction * (float32(PI) * 2.0'f32))
  # Ambient darkness (considering only night, not weather)
  let cosAngle = sunAngleRadians.cos()
  let t1 = block:
    if (cosAngle < 0.0'f32):
      # night time = ~11 darkness
      uint8(((abs(cosAngle) * 11.0'f32)))
    else:
      0'u8
  let ambientDarkness = t1
  let skyLightLevel = world.getSkyLightLevel(blockPos)
  var power = (skyLightLevel - ambientDarkness)
  if inverted:
    power = (15'u8 - power)
  elif (power > 0'u8):
    let t2 = block:
      if (sunAngleRadians < float32(PI)):
        0.0'f32
      else:
        (float32(PI) * 2.0'f32)
    let transitionOffset = t2
    sunAngleRadians += (((transitionOffset - sunAngleRadians)) * 0.2'f32)
    power = uint8(round(((float32(power) * sunAngleRadians.cos()))))
  let power1 = clamp(power, 0'u8, 15'u8)
  if (not (power1 == props.power)):
    props.power = power1
    let state2 = props.toStateId(blockRef)
    discard world.setBlockState(blockPos, state2, BfNotifyAll)

