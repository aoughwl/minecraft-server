## Port of pumpkin/src/block/entities/decorated_pot.rs
## The `Mutex<Option<..>>` fields are plain options here: one thread writes a world, and `try_lock` always succeeds.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:decorated_pot"

type
  DecoratedPotBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    sherds*: Option[seq[NbtTag]]
    item*: Option[ItemStack]

var gDecoratedPotBlockEntityVt: nil BlockEntityVt

proc decoratedPotBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc decoratedPotBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  DecoratedPotBlockEntity(self0).position

proc putPotData(self: DecoratedPotBlockEntity, nbt: var NbtCompound) =
  if self.sherds.isSome:
    nbt.putList("sherds", self.sherds.unsafeGet)
  if self.item.isSome:
    var itNbt = newCompound()
    self.item.unsafeGet.writeItemStack(itNbt)
    nbt.putCompound("item", itNbt)

proc decoratedPotBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  DecoratedPotBlockEntity(self0).putPotData(nbt)

proc decoratedPotBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  DecoratedPotBlockEntity(self0).putPotData(nbt)
  some(nbt)

proc decoratedPotBlockEntityVt*(): BlockEntityVt =
  if gDecoratedPotBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = decoratedPotBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = decoratedPotBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = decoratedPotBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = decoratedPotBlockEntityChunkDataNbt_BlockEntity
    gDecoratedPotBlockEntityVt = v
  gDecoratedPotBlockEntityVt

proc newDecoratedPotBlockEntity*(position: BlockPos): DecoratedPotBlockEntity =
  DecoratedPotBlockEntity(vt: decoratedPotBlockEntityVt(), position: position, sherds: none[seq[NbtTag]](), item: none[ItemStack]())

proc decoratedPotBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): DecoratedPotBlockEntity =
  let sherds = nbt.getList("sherds")
  var item = none[ItemStack]()
  let itemNbt = nbt.getCompound("item")
  if itemNbt.isSome:
    item = readItemStack(itemNbt.unsafeGet)
  DecoratedPotBlockEntity(vt: decoratedPotBlockEntityVt(), position: position, sherds: sherds, item: item)
