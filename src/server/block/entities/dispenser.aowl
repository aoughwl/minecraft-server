## Port of pumpkin/src/block/entities/dispenser.rs
## The nine stacks live in a `ContainerInventory` (containers.aowl), the entity's `Inventory`. `get_random_slot` answers the
## slot index (-1 for none) where upstream answers the locked stack.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 9
const ID*: string = "minecraft:dispenser"

type
  DispenserBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory

var gDispenserBlockEntityVt: nil BlockEntityVt

proc dispenserResourceLocation(self0: BlockEntity): string =
  ID

proc dispenserGetPosition(self0: BlockEntity): BlockPos =
  DispenserBlockEntity(self0).position

proc dispenserWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let c = DispenserBlockEntity(self0).inv
  if c != nil:
    let i = containerAsInventory(c)
    i.writeInventoryNbt(nbt, true)

proc dispenserGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = DispenserBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc dispenserIsDirty(self0: BlockEntity): bool =
  DispenserBlockEntity(self0).inv.dirty

proc dispenserClearDirty(self0: BlockEntity) =
  DispenserBlockEntity(self0).inv.dirty = false

proc dispenserChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  syncWriteItemsToNbt(DispenserBlockEntity(self0).inv.items, nbt)
  some(nbt)

proc dispenserBlockEntityVt*(): BlockEntityVt =
  if gDispenserBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = dispenserResourceLocation
    v.getPositionImpl = dispenserGetPosition
    v.writeNbtImpl = dispenserWriteNbt
    v.getInventoryImpl = dispenserGetInventory
    v.isDirtyImpl = dispenserIsDirty
    v.clearDirtyImpl = dispenserClearDirty
    v.chunkDataNbtImpl = dispenserChunkDataNbt
    gDispenserBlockEntityVt = v
  gDispenserBlockEntityVt

proc newDispenserBlockEntity*(position: BlockPos): DispenserBlockEntity =
  DispenserBlockEntity(vt: dispenserBlockEntityVt(), position: position, inv: newContainerInventory(INVENTORY_SIZE))

proc dispenserBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): DispenserBlockEntity =
  let dispenser = newDispenserBlockEntity(position)
  syncReadItemsFromNbt(nbt, dispenser.inv.items)
  dispenser

proc invOf*(self: DispenserBlockEntity): Inventory =
  ## The entity's stacks as the base type: bound, nil-checked, then converted, as the compiler's not-nil proof wants.
  let c = self.inv
  if c == nil:
    return Inventory(newContainerInventory(INVENTORY_SIZE))
  Inventory(c)

proc getRandomSlot*(self: DispenserBlockEntity): int =
  ## `get_random_slot`: a uniformly random non-empty slot, or -1.
  # this.unpackLootTable(null);
  var ret = -1
  var j = 1'i32
  for i in 0 ..< self.inv.items.len:
    if not self.inv.items[i].isEmpty():
      if rng().randomRange(0'i32 .. j - 1'i32) == 0'i32:
        ret = i
      j += 1
  ret
