## Port of pumpkin/src/block/entities/dropper.rs
## The nine stacks live in a `ContainerInventory` (containers.aowl), the entity's `Inventory`. `get_random_slot` answers the
## slot index (-1 for none) where upstream answers the locked stack.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 9
const ID*: string = "minecraft:dropper"

type
  DropperBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory

var gDropperBlockEntityVt: nil BlockEntityVt

proc dropperResourceLocation(self0: BlockEntity): string =
  ID

proc dropperGetPosition(self0: BlockEntity): BlockPos =
  DropperBlockEntity(self0).position

proc dropperWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let c = DropperBlockEntity(self0).inv
  if c != nil:
    let i = containerAsInventory(c)
    i.writeInventoryNbt(nbt, true)

proc dropperGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = DropperBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc dropperIsDirty(self0: BlockEntity): bool =
  DropperBlockEntity(self0).inv.dirty

proc dropperClearDirty(self0: BlockEntity) =
  DropperBlockEntity(self0).inv.dirty = false

proc dropperChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  syncWriteItemsToNbt(DropperBlockEntity(self0).inv.items, nbt)
  some(nbt)

proc dropperBlockEntityVt*(): BlockEntityVt =
  if gDropperBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = dropperResourceLocation
    v.getPositionImpl = dropperGetPosition
    v.writeNbtImpl = dropperWriteNbt
    v.getInventoryImpl = dropperGetInventory
    v.isDirtyImpl = dropperIsDirty
    v.clearDirtyImpl = dropperClearDirty
    v.chunkDataNbtImpl = dropperChunkDataNbt
    gDropperBlockEntityVt = v
  gDropperBlockEntityVt

proc newDropperBlockEntity*(position: BlockPos): DropperBlockEntity =
  DropperBlockEntity(vt: dropperBlockEntityVt(), position: position, inv: newContainerInventory(INVENTORY_SIZE))

proc dropperBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): DropperBlockEntity =
  let dropper = newDropperBlockEntity(position)
  syncReadItemsFromNbt(nbt, dropper.inv.items)
  dropper

proc invOf*(self: DropperBlockEntity): Inventory =
  ## The entity's stacks as the base type: bound, nil-checked, then converted, as the compiler's not-nil proof wants.
  let c = self.inv
  if c == nil:
    return Inventory(newContainerInventory(INVENTORY_SIZE))
  containerAsInventory(c)

proc getRandomSlot*(self: DropperBlockEntity): int =
  ## `get_random_slot`: a uniformly random non-empty slot, or -1.
  # this.unpackLootTable(null);
  var ret = -1
  var j = 1'i32
  for i in 0 ..< self.inv.items.len:
    if not self.inv.items[i].isEmpty():
      if rng().randomRange(0'i32 .. j - 1'i32) == 0'i32:
        ret = i
      j += 1
  ret
