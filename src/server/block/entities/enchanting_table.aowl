## Port of pumpkin/src/block/entities/enchanting_table.rs
## `custom_name` is a `Mutex<Option<String>>`: "" is `None` here, and a custom name is never empty.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:enchanting_table"

type
  EnchantingTableBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    customName*: string

var gEnchantingTableBlockEntityVt: nil BlockEntityVt

proc enchantingTableResourceLocation(self0: BlockEntity): string =
  ID

proc enchantingTableGetPosition(self0: BlockEntity): BlockPos =
  EnchantingTableBlockEntity(self0).position

proc enchantingTableWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let self = EnchantingTableBlockEntity(self0)
  if self.customName.len > 0:
    nbt.putString("CustomName", self.customName)

proc enchantingTableChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  let self = EnchantingTableBlockEntity(self0)
  var nbt = newCompound()
  if self.customName.len > 0:
    nbt.putString("CustomName", self.customName)
  some(nbt)

proc enchantingTableBlockEntityVt*(): BlockEntityVt =
  if gEnchantingTableBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = enchantingTableResourceLocation
    v.getPositionImpl = enchantingTableGetPosition
    v.writeNbtImpl = enchantingTableWriteNbt
    v.chunkDataNbtImpl = enchantingTableChunkDataNbt
    gEnchantingTableBlockEntityVt = v
  gEnchantingTableBlockEntityVt

proc newEnchantingTableBlockEntity*(position: BlockPos): EnchantingTableBlockEntity =
  EnchantingTableBlockEntity(vt: enchantingTableBlockEntityVt(), position: position, customName: "")

proc enchantingTableBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): EnchantingTableBlockEntity =
  result = newEnchantingTableBlockEntity(position)
  let name = nbt.getString("CustomName")
  if name.isSome:
    result.customName = name.unsafeGet
