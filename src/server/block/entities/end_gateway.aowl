proc endGatewayBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): EndGatewayBlockEntity =
  let age = nbt.getLong("Age").get(0)
  let exactTeleport = nbt.getBool("ExactTeleport").get(false)
  let exitPortal = nbt.getCompound("ExitPortal").map(R2A_MANUAL("closure |c| t1"))
  EndGatewayBlockEntity(position: position, age: age, exactTeleport: exactTeleport, exitPortal: exitPortal)

proc endGatewayBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = EndGatewayBlockEntity(self0)
  nbt.putLong("Age", self.age)
  nbt.putBool("ExactTeleport", self.exactTeleport)
  let t4 = self.exitPortal
  if t4.isSome:
    let exit = t4.unsafeGet
    var exitNbt = newCompound()
    exitNbt.putInt("X", t4.unsafeGet[0].x)
    exitNbt.putInt("Y", t4.unsafeGet[0].y)
    exitNbt.putInt("Z", t4.unsafeGet[0].z)
    nbt.putCompound("ExitPortal", exitNbt)

proc endGatewayBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = EndGatewayBlockEntity(self0)
  var nbt = newCompound()
  let t5 = self.age.tryLock().ok()
  if t5.isNone: return none[NbtCompound]()
  nbt.putLong("Age", t5.unsafeGet)
  let t6 = self.exactTeleport.tryLock().ok()
  if t6.isNone: return none[NbtCompound]()
  nbt.putBool("ExactTeleport", t6.unsafeGet)
  let t7 = self.exitPortal.tryLock()
  let t8 = t7.value
  if t7.isOk and t8.isSome:
    let exit = t7.value
    let exit = t8.unsafeGet
    var exitNbt = newCompound()
    exitNbt.putInt("X", t8.unsafeGet[0].x)
    exitNbt.putInt("Y", t8.unsafeGet[0].y)
    exitNbt.putInt("Z", t8.unsafeGet[0].z)
    nbt.putCompound("ExitPortal", exitNbt)
  some(nbt)

