## Port of pumpkin/src/block/entities/end_gateway.rs
## The `Mutex` fields are plain fields here (one thread writes a world).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:end_gateway"

type
  EndGatewayBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    age*: int64
    exactTeleport*: bool
    exitPortal*: Option[BlockPos]

var gEndGatewayBlockEntityVt: nil BlockEntityVt

proc endGatewayBlockEntityVt*(): BlockEntityVt

proc newEndGatewayBlockEntity*(position: BlockPos): EndGatewayBlockEntity =
  EndGatewayBlockEntity(vt: endGatewayBlockEntityVt(), position: position, age: 0'i64, exactTeleport: false,
    exitPortal: none[BlockPos]())

proc endGatewayBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc endGatewayBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  EndGatewayBlockEntity(self0).position

proc endGatewayBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): EndGatewayBlockEntity =
  let age = nbt.getLong("Age").get(0'i64)
  let exactTeleport = nbt.getBool("ExactTeleport").get(false)
  var exitPortal = none[BlockPos]()
  let c = nbt.getCompound("ExitPortal")
  if c.isSome:
    let cc = c.unsafeGet
    exitPortal = some(newBlockPos(cc.getInt("X").get(0'i32), cc.getInt("Y").get(0'i32), cc.getInt("Z").get(0'i32)))
  EndGatewayBlockEntity(vt: endGatewayBlockEntityVt(), position: position, age: age, exactTeleport: exactTeleport,
    exitPortal: exitPortal)

proc putEndGatewayFields(self: EndGatewayBlockEntity; nbt: var NbtCompound) =
  nbt.putLong("Age", self.age)
  nbt.putBool("ExactTeleport", self.exactTeleport)
  if self.exitPortal.isSome:
    let exit = self.exitPortal.unsafeGet
    var exitNbt = newCompound()
    exitNbt.putInt("X", exit.vec.x)
    exitNbt.putInt("Y", exit.vec.y)
    exitNbt.putInt("Z", exit.vec.z)
    nbt.putCompound("ExitPortal", exitNbt)

proc endGatewayBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  putEndGatewayFields(EndGatewayBlockEntity(self0), nbt)

proc endGatewayBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  putEndGatewayFields(EndGatewayBlockEntity(self0), nbt)
  some(nbt)

proc endGatewayBlockEntityVt*(): BlockEntityVt =
  if gEndGatewayBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = endGatewayBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = endGatewayBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = endGatewayBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = endGatewayBlockEntityChunkDataNbt_BlockEntity
    gEndGatewayBlockEntityVt = v
  gEndGatewayBlockEntityVt
