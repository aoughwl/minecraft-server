## Port of pumpkin/src/block/entities/end_portal.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:end_portal"

type
  EndPortalBlockEntity* = ref object of BlockEntity
    position*: BlockPos

var gEndPortalBlockEntityVt: nil BlockEntityVt


proc newEndPortalBlockEntity*(position: BlockPos): EndPortalBlockEntity
proc createNbt*(position: BlockPos): NbtCompound
proc endPortalBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc endPortalBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc endPortalBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): EndPortalBlockEntity
proc endPortalBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc endPortalBlockEntityVt*(): BlockEntityVt

proc newEndPortalBlockEntity*(position: BlockPos): EndPortalBlockEntity =
  EndPortalBlockEntity(position: position)

proc createNbt*(position: BlockPos): NbtCompound =
  var nbt = newCompound()
  nbt.putString("id", $(ID))
  nbt.putInt("x", position.vec.x)
  nbt.putInt("y", position.vec.y)
  nbt.putInt("z", position.vec.z)
  nbt

proc endPortalBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = EndPortalBlockEntity(self0)
  ID

proc endPortalBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = EndPortalBlockEntity(self0)
  self.position

proc endPortalBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): EndPortalBlockEntity =
  EndPortalBlockEntity(position: position)

proc endPortalBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = EndPortalBlockEntity(self0)
  discard

proc endPortalBlockEntityVt*(): BlockEntityVt =
  if gEndPortalBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = endPortalBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = endPortalBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = endPortalBlockEntityWriteNbt_BlockEntity
    gEndPortalBlockEntityVt = v
  gEndPortalBlockEntityVt

