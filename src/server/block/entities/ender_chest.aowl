## Port of pumpkin/src/block/entities/ender_chest.rs
## The entity holds no items: the player's own `EnderChestInventory` is shown, with this entity's tracker (see the block).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const LID_ANIMATION_EVENT_TYPE*: uint8 = 1
const ID*: string = "minecraft:ender_chest"

type
  EnderChestBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    viewers*: ViewerCountTracker

var gEnderChestBlockEntityVt: nil BlockEntityVt

proc playSound(self: EnderChestBlockEntity, world: BlockWorld, sound: Sound) =
  world.playSoundFine(sound, scBlocks, self.position.toCenteredF64(), 0.5, (randomOf(float32) * 0.1'f32) + 0.9'f32)

proc onContainerOpen*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockEnderChestOpen)

proc onContainerClose*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockEnderChestClose)

proc onViewerCountUpdate*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new0: uint16) =
  world.addSyncedBlockEvent(position, LID_ANIMATION_EVENT_TYPE, uint8(new0 and 255'u16))

proc getTracker*(self: EnderChestBlockEntity): ViewerCountTracker =
  ## `get_tracker`
  self.viewers

proc enderChestResourceLocation(self0: BlockEntity): string =
  ID

proc enderChestGetPosition(self0: BlockEntity): BlockPos =
  EnderChestBlockEntity(self0).position

proc enderChestWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  discard

proc enderChestChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  some(newCompound())

proc enderChestTick(self0: BlockEntity, world: BlockWorld) =
  let self = EnderChestBlockEntity(self0)
  self.viewers.updateViewerCount(self, world, self.position)

proc enderChestBlockEntityVt*(): BlockEntityVt =
  if gEnderChestBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = enderChestResourceLocation
    v.getPositionImpl = enderChestGetPosition
    v.writeNbtImpl = enderChestWriteNbt
    v.chunkDataNbtImpl = enderChestChunkDataNbt
    v.tickImpl = enderChestTick
    gEnderChestBlockEntityVt = v
  gEnderChestBlockEntityVt

proc newEnderChestBlockEntity*(position: BlockPos): EnderChestBlockEntity =
  EnderChestBlockEntity(vt: enderChestBlockEntityVt(), position: position, viewers: newViewerCountTracker())

proc enderChestBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): EnderChestBlockEntity =
  newEnderChestBlockEntity(position)
