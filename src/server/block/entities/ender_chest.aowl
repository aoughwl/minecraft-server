import ../blockprelude
import ../viewer

const LID_ANIMATION_EVENT_TYPE*: uint8 = 1
const ID*: string = "minecraft:ender_chest"

type
  EnderChestBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    viewers*: ViewerCountTracker

var gEnderChestBlockEntityVt: nil BlockEntityVt


proc enderChestBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc enderChestBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc enderChestBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): EnderChestBlockEntity
proc enderChestBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc enderChestBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc enderChestBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld)
proc enderChestBlockEntityVt*(): BlockEntityVt
proc onContainerOpen*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos)
proc onContainerClose*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos)
proc onViewerCountUpdate*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new: uint16)
proc newEnderChestBlockEntity*(position: BlockPos): EnderChestBlockEntity
proc getTracker*(self: EnderChestBlockEntity): ViewerCountTracker
proc playSound*(self: EnderChestBlockEntity, world: BlockWorld, sound: Sound)

proc enderChestBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = EnderChestBlockEntity(self0)
  ID

proc enderChestBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = EnderChestBlockEntity(self0)
  self.position

proc enderChestBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): EnderChestBlockEntity =
  EnderChestBlockEntity(position: position, viewers: newViewerCountTracker())

proc enderChestBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = EnderChestBlockEntity(self0)
  discard

proc enderChestBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = EnderChestBlockEntity(self0)
  some(newCompound())

proc enderChestBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = EnderChestBlockEntity(self0)
  self.viewers.updateViewerCount(self, world, self.position)

proc enderChestBlockEntityVt*(): BlockEntityVt =
  if gEnderChestBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = enderChestBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = enderChestBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = enderChestBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = enderChestBlockEntityChunkDataNbt_BlockEntity
    v.tickImpl = enderChestBlockEntityTick_BlockEntity
    gEnderChestBlockEntityVt = v
  gEnderChestBlockEntityVt

proc onContainerOpen*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockEnderChestOpen)

proc onContainerClose*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos) =
  self.playSound(world, sdBlockEnderChestClose)

proc onViewerCountUpdate*(self: EnderChestBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new: uint16) =
  world.addSyncedBlockEvent(position, LID_ANIMATION_EVENT_TYPE, uint8(new))

proc newEnderChestBlockEntity*(position: BlockPos): EnderChestBlockEntity =
  EnderChestBlockEntity(position: position, viewers: newViewerCountTracker())

proc getTracker*(self: EnderChestBlockEntity): ViewerCountTracker =
  self.viewers

proc playSound*(self: EnderChestBlockEntity, world: BlockWorld, sound: Sound) =
  var rng = Xoroshiro.fromSeed(getSeed())
  world.playSoundFine(sound, scBlocks, self.position.toCenteredF64(), 0.5, ((rng.nextF32() * 0.1) + 0.9))

