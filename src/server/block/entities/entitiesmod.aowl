## Port of pumpkin/src/block/entities/mod.rs: `block_entity_from_nbt` and `create_block_entity`, for every entity type in the
## folder. The `BlockEntity` trait is `BlockEntity`/`BlockEntityVt` in blockbehaviour.aowl; `write_internal` is in worldadapter.aowl
## (`saveBlockEntity`), `get_id` is the `BLOCK_ENTITY_TYPES` search in worldhooks.aowl's `updateBlockEntity0`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import bell, comparator, daylight_detector
import sign, hanging_sign, bed, piston, mob_spawner, banner, skull
import jigsaw_block, decorated_pot, structure_block, command_block
import barrel, chest, trapped_chest, shulker_box, ender_chest, hopper, dropper, jukebox, enchanting_table
import furnace, smoker, blasting_furnace
import brewing_stand, campfire, beacon, lectern, beehive, dispenser, crafter
import end_portal, creaking_heart, end_gateway, conduit, sculk_sensor, calibrated_sculk_sensor, sculk_catalyst, sculk_shrieker
import chiseled_bookshelf, shelf, brushable_block, trial_spawner, vault, test_block, test_instance_block
import copper_golem_statue, potent_sulfur

proc asBase(e: ChestLikeBlockEntity): BlockEntity =
  ## Both chests as the base type before they meet `Option`: the compiler's code generator cannot make `Option[ChestLikeBlockEntity]`.
  let base: BlockEntity = e
  base

proc createBlockEntity*(entityType: uint16; position: BlockPos): Option[BlockEntity] =
  ## `create_block_entity`
  if int(entityType) >= BLOCK_ENTITY_TYPES.len:
    return none[BlockEntity]()
  case BLOCK_ENTITY_TYPES[int(entityType)]
  of "hopper": some(BlockEntity(newHopperBlockEntity(position, FacingHopper.Down)))
  of "dropper": some(BlockEntity(newDropperBlockEntity(position)))
  of "jukebox": some(BlockEntity(newJukeboxBlockEntity(position)))
  of "enchanting_table": some(BlockEntity(newEnchantingTableBlockEntity(position)))
  of "shulker_box": some(BlockEntity(newShulkerBoxBlockEntity(position)))
  of "ender_chest": some(BlockEntity(newEnderChestBlockEntity(position)))
  of "chest": some(asBase(newChestBlockEntity(position)))
  of "trapped_chest": some(asBase(newTrappedChestBlockEntity(position)))
  of "barrel": some(BlockEntity(newBarrelBlockEntity(position)))
  of "brewing_stand": some(BlockEntity(newBrewingStandBlockEntity(position)))
  of "campfire": some(BlockEntity(newCampfireBlockEntity(position)))
  of "beacon": some(BlockEntity(newBeaconBlockEntity(position)))
  of "lectern": some(BlockEntity(newLecternBlockEntity(position)))
  of "beehive": some(BlockEntity(newBeehiveBlockEntity(position)))
  of "dispenser": some(BlockEntity(newDispenserBlockEntity(position)))
  of "crafter": some(BlockEntity(newCrafterBlockEntity(position)))
  of "furnace": some(BlockEntity(newFurnaceBlockEntity(position)))
  of "smoker": some(BlockEntity(newSmokerBlockEntity(position)))
  of "blast_furnace": some(BlockEntity(newBlastingFurnaceBlockEntity(position)))
  of "sign": some(BlockEntity(emptySignBlockEntity(position)))
  of "hanging_sign": some(BlockEntity(emptyHangingSignBlockEntity(position)))
  of "bed": some(BlockEntity(newBedBlockEntity(position)))
  of "mob_spawner": some(BlockEntity(newMobSpawnerBlockEntity(position, none[string]())))
  of "banner": some(BlockEntity(newBannerBlockEntity(position)))
  of "skull": some(BlockEntity(newSkullBlockEntity(position)))
  of "jigsaw": some(BlockEntity(newJigsawBlockEntity(position)))
  of "decorated_pot": some(BlockEntity(newDecoratedPotBlockEntity(position)))
  of "structure_block": some(BlockEntity(newStructureBlockBlockEntity(position)))
  of "command_block": some(BlockEntity(newCommandBlockEntity(position, true, false)))
  of "bell": some(BlockEntity(newBellBlockEntity(position)))
  of "comparator": some(BlockEntity(newComparatorBlockEntity(position)))
  of "daylight_detector": some(BlockEntity(newDaylightDetectorBlockEntity(position)))
  of "end_portal": some(BlockEntity(newEndPortalBlockEntity(position)))
  of "creaking_heart": some(BlockEntity(newCreakingHeartBlockEntity(position)))
  of "end_gateway": some(BlockEntity(newEndGatewayBlockEntity(position)))
  of "conduit": some(BlockEntity(newConduitBlockEntity(position)))
  of "sculk_sensor": some(BlockEntity(newSculkSensorBlockEntity(position)))
  of "calibrated_sculk_sensor": some(BlockEntity(newCalibratedSculkSensorBlockEntity(position)))
  of "sculk_catalyst": some(BlockEntity(newSculkCatalystBlockEntity(position)))
  of "sculk_shrieker": some(BlockEntity(newSculkShriekerBlockEntity(position)))
  of "chiseled_bookshelf": some(BlockEntity(newChiseledBookshelfBlockEntity(position)))
  of "shelf": some(BlockEntity(newShelfBlockEntity(position)))
  of "brushable_block": some(BlockEntity(newBrushableBlockBlockEntity(position)))
  of "trial_spawner": some(BlockEntity(newTrialSpawnerBlockEntity(position)))
  of "vault": some(BlockEntity(newVaultBlockEntity(position)))
  of "test_block": some(BlockEntity(newTestBlockBlockEntity(position)))
  of "test_instance_block": some(BlockEntity(newTestInstanceBlockBlockEntity(position)))
  of "copper_golem_statue": some(BlockEntity(newCopperGolemStatueBlockEntity(position)))
  of "potent_sulfur": some(BlockEntity(newPotentSulfurBlockEntity(position)))
  else: none[BlockEntity]()

proc blockEntityFromNbt*(nbt: NbtCompound): Option[BlockEntity] =
  ## `block_entity_from_nbt`
  let id = nbt.getString("id")
  let x = nbt.getInt("x")
  let y = nbt.getInt("y")
  let z = nbt.getInt("z")
  if id.isNone or x.isNone or y.isNone or z.isNone:
    return none[BlockEntity]()
  let position = newBlockPos(x.unsafeGet, y.unsafeGet, z.unsafeGet)
  var tag = nbt
  case id.unsafeGet
  of "minecraft:hopper": some(BlockEntity(hopperBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:dropper": some(BlockEntity(dropperBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:jukebox": some(BlockEntity(jukeboxBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:enchanting_table": some(BlockEntity(enchantingTableBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:shulker_box": some(BlockEntity(shulkerBoxBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:ender_chest": some(BlockEntity(enderChestBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:chest": some(asBase(chestBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:trapped_chest": some(asBase(trappedChestBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:barrel": some(BlockEntity(barrelBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:brewing_stand": some(BlockEntity(brewingStandBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:campfire": some(BlockEntity(campfireBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:beacon": some(BlockEntity(beaconBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:lectern": some(BlockEntity(lecternBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:beehive": some(BlockEntity(beehiveBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:dispenser": some(BlockEntity(dispenserBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:crafter": some(BlockEntity(crafterBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:furnace": some(BlockEntity(furnaceBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:smoker": some(BlockEntity(smokerBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:blast_furnace": some(BlockEntity(blastingFurnaceBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:sign": some(BlockEntity(signBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:hanging_sign": some(BlockEntity(hangingSignBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:bed": some(BlockEntity(bedBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:piston": some(BlockEntity(pistonBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:mob_spawner": some(BlockEntity(mobSpawnerBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:banner": some(BlockEntity(bannerBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:skull": some(BlockEntity(skullBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:jigsaw": some(BlockEntity(jigsawBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:decorated_pot": some(BlockEntity(decoratedPotBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:structure_block": some(BlockEntity(structureBlockBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:command_block": some(BlockEntity(commandBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:bell": some(BlockEntity(bellBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:comparator": some(BlockEntity(comparatorBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:daylight_detector": some(BlockEntity(daylightDetectorBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:end_portal": some(BlockEntity(endPortalBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:creaking_heart": some(BlockEntity(creakingHeartBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:end_gateway": some(BlockEntity(endGatewayBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:conduit": some(BlockEntity(conduitBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:sculk_sensor": some(BlockEntity(sculkSensorBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:calibrated_sculk_sensor": some(BlockEntity(calibratedSculkSensorBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:sculk_catalyst": some(BlockEntity(sculkCatalystBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:sculk_shrieker": some(BlockEntity(sculkShriekerBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:chiseled_bookshelf": some(BlockEntity(chiseledBookshelfBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:shelf": some(BlockEntity(shelfBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:brushable_block": some(BlockEntity(brushableBlockBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:trial_spawner": some(BlockEntity(trialSpawnerBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:vault": some(BlockEntity(vaultBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:test_block": some(BlockEntity(testBlockBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:test_instance_block": some(BlockEntity(testInstanceBlockBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:copper_golem_statue": some(BlockEntity(copperGolemStatueBlockEntityFromNbt_BlockEntity(tag, position)))
  of "minecraft:potent_sulfur": some(BlockEntity(potentSulfurBlockEntityFromNbt_BlockEntity(tag, position)))
  else: none[BlockEntity]()
