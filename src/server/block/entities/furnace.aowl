## Port of pumpkin/src/block/entities/furnace.rs
## `FurnaceBlockEntity` over the shared `FurnaceLikeBlockEntity` (furnace_like_block_entity.aowl).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/recipes
import furnace_like_block_entity

const INVENTORY_SIZE*: int = 3
const ID*: string = "minecraft:furnace"

type
  FurnaceBlockEntity* = FurnaceLikeBlockEntity
    ## One type for the three: a second level of `ref object` under `BlockEntity` trips the compiler's code generator (see
    ## chest.aowl). `id` tells them apart.

var gFurnaceBlockEntityVt: nil BlockEntityVt

proc furnaceBlockEntityVt*(): BlockEntityVt =
  if gFurnaceBlockEntityVt == nil:
    gFurnaceBlockEntityVt = newFurnaceLikeBlockEntityVt()
  gFurnaceBlockEntityVt

proc newFurnaceBlockEntity*(position: BlockPos): FurnaceBlockEntity =
  result = FurnaceLikeBlockEntity()
  initFurnaceLike(result, furnaceBlockEntityVt(), position, ID, crkSmelting, INVENTORY_SIZE)

proc furnaceBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): FurnaceBlockEntity =
  let e = newFurnaceBlockEntity(position)
  readFurnaceLikeNbt(e, nbt)
  e
