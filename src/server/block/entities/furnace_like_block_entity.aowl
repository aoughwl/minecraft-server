## Port of pumpkin/src/block/entities/furnace_like_block_entity.rs
## Upstream's macros (`impl_cooking_block_entity_base!` and the rest) stamp the same impls onto three structs and the
## `CookingBlockEntityBase` trait reads their atomics. Here the three share one `FurnaceLikeBlockEntity` (furnace.aowl,
## smoker.aowl and blasting_furnace.aowl extend it with their `ID` and `CookingRecipeKind`) whose stacks and counters live
## in a `CookingInventory`: a `ref object of BlockEntity` cannot also be an `Inventory`, a `PropertyDelegate` and an
## `ExperienceContainer`, so the entity answers those from the `inv`, a `CookingDelegate` and a `CookingExperience`.
## The `recipes_used` map is a `Table` (no mutex: one thread).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import std/strutils
import ../containers
import ../../../inventory/window_property
import ../../../generated/[recipes, fuels, recipe_remainder]

type
  CookingInventory* = ref object of ContainerInventory
    ## `items`, `dirty`, the four counters and `recipes_used` of a furnace-like entity
    cookingTimeSpent*: uint16
    cookingTotalTime*: uint16
    litTimeRemaining*: uint16
    litTotalTime*: uint16
    recipeKind*: CookingRecipeKind
    recipesUsed*: Table[string, uint32]

  CookingDelegate* = ref object of PropertyDelegate
    ## `impl_property_delegate_for_cooking!`
    inv*: CookingInventory

  CookingExperience* = ref object of ExperienceContainer
    ## `impl_experience_container_for_cooking!`
    inv*: CookingInventory

  FurnaceLikeBlockEntity* = ref object of BlockEntity
    ## `CookingBlockEntityBase`
    position*: BlockPos
    inv*: CookingInventory
    id*: string
    delegate*: CookingDelegate
    experience*: CookingExperience

proc asInv(c: CookingInventory): Inventory =
  ## The compiler's not-nil proof wants the nil check before the conversion to the base type.
  if c == nil:
    rustPanic("cooking inventory missing")
  Inventory(c)

var gRecipeTaggable: Taggable
  ## The item `cookingRecipeFor` is asking about: `get_cooking_recipe_with_ingredient`'s tag test reads it (no closure over it).

proc recipeItemIsTaggedWith(tag: string): bool =
  let r = gRecipeTaggable.isTaggedWith(tag)
  r[0] and r[1]

proc cookingRecipeFor*(stack: ItemStack; kind: CookingRecipeKind): Option[CookingRecipe] =
  ## `get_cooking_recipe_with_ingredient(stack.item, kind)`; an empty stack holds air, which no recipe takes.
  if stack.isEmpty():
    return none[CookingRecipe]()
  let item = stack.item
  gRecipeTaggable = item.toTaggable()
  getCookingRecipeWithIngredient(item.registryKey, kind, recipeItemIsTaggedWith)

proc getCookingTimeSpent*(self: FurnaceLikeBlockEntity): uint16 = self.inv.cookingTimeSpent
proc getCookingTotalTime*(self: FurnaceLikeBlockEntity): uint16 = self.inv.cookingTotalTime
proc getLitTimeRemaining*(self: FurnaceLikeBlockEntity): uint16 = self.inv.litTimeRemaining
proc getLitTotalTime*(self: FurnaceLikeBlockEntity): uint16 = self.inv.litTotalTime
proc setCookingTimeSpent*(self: FurnaceLikeBlockEntity, spentTime: uint16) =
  self.inv.cookingTimeSpent = spentTime
proc setCookingTotalTime*(self: FurnaceLikeBlockEntity, totalTime: uint16) =
  self.inv.cookingTotalTime = totalTime
proc setLitTimeRemaining*(self: FurnaceLikeBlockEntity, remainingTime: uint16) =
  self.inv.litTimeRemaining = remainingTime
proc setLitTotalTime*(self: FurnaceLikeBlockEntity, totalTime: uint16) =
  self.inv.litTotalTime = totalTime

proc isBurning*(self: FurnaceLikeBlockEntity): bool =
  self.getLitTimeRemaining() > 0'u16

proc addRecipeUsed*(self: FurnaceLikeBlockEntity, recipe: CookingRecipe) =
  ## Track recipe usage by recipe id for the experience on extraction.
  let c = self.inv
  c.recipesUsed[recipe.id] = c.recipesUsed.getOrDefault(recipe.id, 0'u32) + 1'u32

proc extractRecipesExperience(c: CookingInventory): int32 =
  ## Total experience of the tracked recipes; the map is cleared (vanilla behaviour).
  var totalXp = 0.0'f32
  for recipeId, count in c.recipesUsed:
    let xp = getRecipeExperience(recipeId)
    if xp.isSome:
      totalXp += xp.unsafeGet * float32(count)
  c.recipesUsed.clear()
  int32(floor(totalXp))

proc extractExperienceFromRecipes*(self: FurnaceLikeBlockEntity): int32 =
  extractRecipesExperience(self.inv)

proc getInputItem*(self: FurnaceLikeBlockEntity): ItemStack = self.inv.items[0]
proc getFuelItem*(self: FurnaceLikeBlockEntity): ItemStack = self.inv.items[1]
proc getOutputItem*(self: FurnaceLikeBlockEntity): ItemStack = self.inv.items[2]

proc recipeOutputItem(recipe: CookingRecipe): nil Item =
  ## `Item::from_registry_key(recipe.result.id.strip_prefix("minecraft:").expect(..))`
  const prefix = "minecraft:"
  if not recipe.result.id.startsWith(prefix):
    rustPanic("Recipe ID should have minecraft: prefix")
  Item.fromRegistryKey(recipe.result.id[prefix.len ..< recipe.result.id.len])

proc canAcceptRecipeOutput*(self: FurnaceLikeBlockEntity, recipe: Option[CookingRecipe], maxCount: uint8): bool =
  if recipe.isNone:
    return false
  let isTopItemsEmpty = self.inv.items[0].isEmpty()
  if self.inv.items[2].isEmpty():
    return not isTopItemsEmpty
  let output = recipeOutputItem(recipe.unsafeGet)
  if output != nil:
    if not isTopItemsEmpty and output.id == self.inv.items[2].item.id and
        self.inv.items[2].itemCount < maxCount and self.inv.items[2].itemCount < self.inv.items[2].getMaxStackSize():
      return true
  false

proc cookingSetStack(self: Inventory; slot: int; stack: ItemStack) =
  ## `impl_inventory_for_cooking!`'s `set_stack`
  let c = CookingInventory(self)
  let current = c.items[slot]
  let isSameItem = not stack.isEmpty() and areItemsAndComponentsEqual(current, stack)
  c.items[slot] = stack
  if slot == 0 and not isSameItem:
    let recipe = cookingRecipeFor(stack, c.recipeKind)
    if recipe.isSome:
      c.cookingTotalTime = uint16(recipe.unsafeGet.cookingTime)
    else:
      c.cookingTotalTime = 0'u16
    c.cookingTimeSpent = 0'u16
  # Always consider the inventory changed when setting a stack
  c.dirty = true

proc cookingStoreStack(self: Inventory; slot: int; stack: ItemStack) =
  ## `*get_stack(slot).lock().await = stack`: no side effects
  let c = CookingInventory(self)
  c.items[slot] = stack

proc cookingInventoryOps(): InventoryOps =
  result = containerInventoryOps()
  result.setStack = cookingSetStack
  result.storeStack = cookingStoreStack

let gCookingOps = cookingInventoryOps()

proc newCookingInventory*(size: int; kind: CookingRecipeKind): CookingInventory =
  result = CookingInventory(recipeKind: kind, recipesUsed: initTable[string, uint32]())
  initContainer(result, size)
  result.ops = gCookingOps

proc craftRecipe*(self: FurnaceLikeBlockEntity, recipe: Option[CookingRecipe]): bool =
  let inv = self.inv
  let canAcceptOutput = self.canAcceptRecipeOutput(recipe, asInv(inv).getMaxCountPerStack())
  if recipe.isSome:
    let r = recipe.unsafeGet
    if canAcceptOutput:
      let outputItem = recipeOutputItem(r)
      if outputItem == nil:
        return false
      let outputItemStack = newItemStack(r.result.count, outputItem)
      if inv.items[2].areEqual(emptyItemStack()):
        asInv(inv).setStack(2, outputItemStack)
      elif inv.items[2].areItemsAndComponentsEqual(outputItemStack):
        inv.items[2].increment(1'u8)
      # Track recipe usage for XP calculation (vanilla RecipesUsed format)
      self.addRecipeUsed(r)
    let wetSponge = Item.fromRegistryKey("wet_sponge")
    let bucket = Item.fromRegistryKey("bucket")
    let waterBucket = Item.fromRegistryKey("water_bucket")
    if wetSponge != nil and bucket != nil and waterBucket != nil:
      if inv.items[0].item.id == wetSponge.id and not inv.items[1].isEmpty() and inv.items[1].item.id == bucket.id:
        asInv(inv).setStack(1, newItemStack(1'u8, waterBucket))
    inv.items[0].decrement(1'u8)
    return true
  false

proc cookingDelegateGet(self: PropertyDelegate; index: int32): int32 =
  let c = CookingDelegate(self).inv
  case index
  of 0: int32(c.litTimeRemaining)
  of 1: int32(c.litTotalTime)
  of 2: int32(c.cookingTimeSpent)
  of 3: int32(c.cookingTotalTime)
  else: 0'i32

proc cookingDelegateSet(self: PropertyDelegate; index: int32; value0: int32) =
  let c = CookingDelegate(self).inv
  let value = uint16(value0 and 0xFFFF)
  case index
  of 0: c.litTimeRemaining = value
  of 1: c.litTotalTime = value
  of 2: c.cookingTimeSpent = value
  of 3: c.cookingTotalTime = value
  else: discard

proc cookingDelegateSize(self: PropertyDelegate): int32 = 4'i32

proc cookingExperienceExtract(self: ExperienceContainer): int32 =
  extractRecipesExperience(CookingExperience(self).inv)

proc cookingRecipesToNbt(c: CookingInventory): NbtCompound =
  result = newCompound()
  for recipeId, count in c.recipesUsed:
    putInt(result, recipeId, int32(count))

proc putCookingCounters(c: CookingInventory; nbt: var NbtCompound) =
  nbt.putShort("cooking_total_time", cast[int16](c.cookingTotalTime))
  nbt.putShort("cooking_time_spent", cast[int16](c.cookingTimeSpent))
  nbt.putShort("lit_total_time", cast[int16](c.litTotalTime))
  nbt.putShort("lit_time_remaining", cast[int16](c.litTimeRemaining))

proc furnaceLikeResourceLocation(self0: BlockEntity): string =
  FurnaceLikeBlockEntity(self0).id

proc furnaceLikeGetPosition(self0: BlockEntity): BlockPos =
  FurnaceLikeBlockEntity(self0).position

proc furnaceLikeTick(self0: BlockEntity, world: BlockWorld) =
  ## `impl_block_entity_for_cooking!`'s `tick`
  let self = FurnaceLikeBlockEntity(self0)
  let inv = self.inv
  let recipeKind = inv.recipeKind
  let isBurning = self.isBurning()
  var isDirty = false
  if self.isBurning():
    inv.litTimeRemaining -= 1'u16

  let isTopItemsEmpty = inv.items[0].isEmpty()
  let furnaceRecipe = cookingRecipeFor(inv.items[0], recipeKind)
  let canAcceptOutput = self.canAcceptRecipeOutput(furnaceRecipe, asInv(inv).getMaxCountPerStack())

  let bottomItemsIsEmpty = inv.items[1].isEmpty()
  if self.isBurning() or (not bottomItemsIsEmpty and not isTopItemsEmpty):
    if not self.isBurning() and canAcceptOutput:
      let baseFuelTicks = getItemBurnTicks(uint16(inv.items[1].item.id)).get(0'u16)
      let adjustedFuelTicks = if recipeKind == crkBlasting or recipeKind == crkSmoking: baseFuelTicks div 2'u16
        else: baseFuelTicks
      self.setLitTimeRemaining(adjustedFuelTicks)
      self.setLitTotalTime(adjustedFuelTicks)
      if self.isBurning():
        isDirty = true
        if not inv.items[1].isEmpty():
          let fuelId = uint16(inv.items[1].item.id)
          inv.items[1].decrement(1'u8)
          let remainderId = getRecipeRemainderId(fuelId)
          if remainderId.isSome and inv.items[1].isEmpty():
            let remainderItem = Item.fromId(remainderId.unsafeGet)
            if remainderItem != nil:
              asInv(inv).setStack(1, newItemStack(1'u8, remainderItem))

    if self.isBurning() and canAcceptOutput:
      inv.cookingTimeSpent += 1'u16
      if self.getCookingTimeSpent() == self.getCookingTotalTime():
        self.setCookingTimeSpent(0'u16)
        if furnaceRecipe.isSome:
          let cookingRecipe = furnaceRecipe.unsafeGet
          self.setCookingTotalTime(uint16(cookingRecipe.cookingTime))
          discard self.craftRecipe(furnaceRecipe)
          isDirty = true
    else:
      self.setCookingTimeSpent(0'u16)
  elif not self.isBurning() and self.getCookingTimeSpent() > 0'u16:
    inv.cookingTimeSpent = min(saturatingSub(inv.cookingTimeSpent, 2'u16), inv.cookingTotalTime)

  if isBurning != self.isBurning():
    isDirty = true
    let (furnaceBlock, furnaceBlockState) = world.getBlockAndState(self.position)
    var props = FurnaceLikeProperties.fromStateId(furnaceBlockState.id, furnaceBlock)
    props.lit = self.isBurning()
    discard world.setBlockState(self.position, props.toStateId(furnaceBlock), BfNotifyAll)

  if isDirty:
    inv.dirty = true

proc furnaceLikeWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let self = FurnaceLikeBlockEntity(self0)
  let c = self.inv
  putCookingCounters(c, nbt)
  # Save RecipesUsed in vanilla format (map of recipe id -> craft count)
  if c.recipesUsed.len > 0:
    nbt.put("RecipesUsed", nbtTag(cookingRecipesToNbt(c)))
  asInv(c).writeInventoryNbt(nbt, true)

proc furnaceLikeGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = FurnaceLikeBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(asInv(c))

proc furnaceLikeIsDirty(self0: BlockEntity): bool =
  FurnaceLikeBlockEntity(self0).inv.dirty

proc furnaceLikeClearDirty(self0: BlockEntity) =
  FurnaceLikeBlockEntity(self0).inv.dirty = false

proc furnaceLikeChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  let c = FurnaceLikeBlockEntity(self0).inv
  var nbt = newCompound()
  putCookingCounters(c, nbt)
  if c.recipesUsed.len > 0:
    nbt.put("RecipesUsed", nbtTag(cookingRecipesToNbt(c)))
  syncWriteItemsToNbt(c.items, nbt)
  some(nbt)

proc delegateAsProperty(d: nil CookingDelegate): Option[PropertyDelegate] =
  ## Upcast through a parameter (see containers.aowl `containerAsInventory`).
  if d == nil:
    return none[PropertyDelegate]()
  some(PropertyDelegate(d))

proc experienceAsContainer(x: nil CookingExperience): Option[ExperienceContainer] =
  if x == nil:
    return none[ExperienceContainer]()
  some(ExperienceContainer(x))

proc furnaceLikeToPropertyDelegate(self0: BlockEntity): Option[PropertyDelegate] =
  delegateAsProperty(FurnaceLikeBlockEntity(self0).delegate)

proc furnaceLikeToExperienceContainer(self0: BlockEntity): Option[ExperienceContainer] =
  experienceAsContainer(FurnaceLikeBlockEntity(self0).experience)

proc newFurnaceLikeBlockEntityVt*(): BlockEntityVt =
  ## `impl_block_entity_for_cooking!`
  let v = newBlockEntityVt()
  v.resourceLocationImpl = furnaceLikeResourceLocation
  v.getPositionImpl = furnaceLikeGetPosition
  v.writeNbtImpl = furnaceLikeWriteNbt
  v.tickImpl = furnaceLikeTick
  v.getInventoryImpl = furnaceLikeGetInventory
  v.isDirtyImpl = furnaceLikeIsDirty
  v.clearDirtyImpl = furnaceLikeClearDirty
  v.chunkDataNbtImpl = furnaceLikeChunkDataNbt
  v.toPropertyDelegateImpl = furnaceLikeToPropertyDelegate
  v.toExperienceContainerImpl = furnaceLikeToExperienceContainer
  v

proc initFurnaceLike*(self: FurnaceLikeBlockEntity; vt: BlockEntityVt; position: BlockPos; id: string; kind: CookingRecipeKind;
    inventorySize: int) =
  ## `FurnaceBlockEntity::new` and its two siblings
  self.vt = vt
  self.position = position
  self.id = id
  self.inv = newCookingInventory(inventorySize, kind)
  self.delegate = CookingDelegate(getPropertyImpl: cookingDelegateGet, setPropertyImpl: cookingDelegateSet,
    getPropertiesSizeImpl: cookingDelegateSize, inv: self.inv)
  self.experience = CookingExperience(extractExperienceImpl: cookingExperienceExtract, inv: self.inv)

proc readFurnaceLikeNbt*(self: FurnaceLikeBlockEntity; nbt: NbtCompound) =
  ## `from_nbt`: the counters, `RecipesUsed` and the items
  let c = self.inv
  let total = nbt.getShort("cooking_total_time")
  c.cookingTotalTime = if total.isSome: cast[uint16](total.unsafeGet) else: 0'u16
  let spent = nbt.getShort("cooking_time_spent")
  c.cookingTimeSpent = if spent.isSome: cast[uint16](spent.unsafeGet) else: 0'u16
  let litTotal = nbt.getShort("lit_total_time")
  c.litTotalTime = if litTotal.isSome: cast[uint16](litTotal.unsafeGet) else: 0'u16
  let litRemaining = nbt.getShort("lit_time_remaining")
  c.litTimeRemaining = if litRemaining.isSome: cast[uint16](litRemaining.unsafeGet) else: 0'u16
  let recipesCompound = nbt.getCompound("RecipesUsed")
  if recipesCompound.isSome:
    let rc = recipesCompound.unsafeGet
    for i in 0 ..< rc.names.len:
      if rc.values[i].kind == ntkInt:
        c.recipesUsed[rc.names[i]] = uint32(rc.values[i].intVal)
  syncReadItemsFromNbt(nbt, c.items)
