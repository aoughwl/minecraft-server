## Port of pumpkin/src/block/entities/hanging_sign.rs
## The same shape as sign.aowl, with the `Text` type of that file. `empty` is `emptyHangingSignBlockEntity` (both files are imported together).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import sign

const ID*: string = "minecraft:hanging_sign"

type
  HangingSignBlockEntity* = ref object of BlockEntity
    frontText*: Text
    backText*: Text
    isWaxed*: bool
    position*: BlockPos
    currentlyEditingPlayer*: Option[string]

var gHangingSignBlockEntityVt: nil BlockEntityVt

proc hangingSignBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc hangingSignBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  HangingSignBlockEntity(self0).position

proc hangingSignBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = HangingSignBlockEntity(self0)
  nbt.put("front_text", textToTag(self.frontText.clone()))
  nbt.put("back_text", textToTag(self.backText.clone()))
  nbt.putBool("is_waxed", self.isWaxed)

proc hangingSignBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = HangingSignBlockEntity(self0)
  var nbt = newCompound()
  nbt.put("front_text", textToTag(self.frontText.clone()))
  nbt.put("back_text", textToTag(self.backText.clone()))
  nbt.putBool("is_waxed", self.isWaxed)
  some(nbt)

proc hangingSignBlockEntityVt*(): BlockEntityVt =
  if gHangingSignBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = hangingSignBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = hangingSignBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = hangingSignBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = hangingSignBlockEntityChunkDataNbt_BlockEntity
    gHangingSignBlockEntityVt = v
  gHangingSignBlockEntityVt

proc newHangingSignBlockEntity*(position: BlockPos, isFront: bool, messages: array[4, string]): HangingSignBlockEntity =
  let front = if isFront: newText(messages) else: defaultText()
  let back = if isFront: defaultText() else: newText(messages)
  HangingSignBlockEntity(vt: hangingSignBlockEntityVt(), position: position, isWaxed: false, frontText: front,
    backText: back, currentlyEditingPlayer: none[string]())

proc emptyHangingSignBlockEntity*(position: BlockPos): HangingSignBlockEntity =
  HangingSignBlockEntity(vt: hangingSignBlockEntityVt(), position: position, isWaxed: false, frontText: defaultText(),
    backText: defaultText(), currentlyEditingPlayer: none[string]())

proc hangingSignBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): HangingSignBlockEntity =
  let front = nbt.get("front_text")
  let back = nbt.get("back_text")
  let frontText = if front[0]: textFromTag(front[1]) else: defaultText()
  let backText = if back[0]: textFromTag(back[1]) else: defaultText()
  let isWaxed = nbt.getBool("is_waxed").get(false)
  HangingSignBlockEntity(vt: hangingSignBlockEntityVt(), position: position, frontText: frontText, backText: backText,
    isWaxed: isWaxed, currentlyEditingPlayer: none[string]())
