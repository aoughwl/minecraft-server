proc toOffset*(facing: FacingHopper): Vector3[int32] =
  case facing
  of FacingHopper.Down:
    (0, (-1), 0)
  of FacingHopper.North:
    (0, 0, (-1))
  of FacingHopper.South:
    (0, 0, 1)
  of FacingHopper.West:
    ((-1), 0, 0)
  of FacingHopper.East:
    (1, 0, 0)

proc hopperBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = HopperBlockEntity(self0)
