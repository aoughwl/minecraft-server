proc hopperBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = HopperBlockEntity(self0)
  self.tickedGameTime = world.getWorldAge()
  if (self.cooldownTime -= 1 <= 0):
    self.cooldownTime = 0
    let state = HopperLikeProperties.fromStateId(world.getBlockState(self.position).id, blockHopper())
    self.tryMoveItems(state, world)

