proc tryMoveItems*(self: HopperBlockEntity, state: HopperLikeProperties, world: BlockWorld) =
  if (self.cooldownTime <= 0) and state.enabled:
    let t1 = block:
      if isEmpty(self):
        false
      else:
        self.ejectItems(world)
    var success = t1
    if (not self.inventoryFull()):
      success = success or self.suckInItems(world)
    if success:
      self.cooldownTime = 8
      self.markDirty()

proc inventoryFull*(self: HopperBlockEntity): bool =
  for i in self.items:
    if (isEmpty(i) or (not (i.itemCount == i.getMaxStackSize()))):
      return false
  true

