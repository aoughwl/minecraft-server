## Port of pumpkin/src/block/entities/hopper.rs
## DEVIATION: a hopper's `facing` is read from the block state on each tick (upstream keeps what `placed` was told, and its own TODO notes that is wrong after a chunk load); `set_block_state` and the constructor still set it. Tested in block/c1blockstest.aowl.
## The five stacks live in a `ContainerInventory` marked `isHopper` (containers.aowl), with the cooldown, the entity's `Inventory`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers
import ../../../inventory/window_property

const INVENTORY_SIZE*: int = 5
const ID*: string = "minecraft:hopper"

type
  HopperBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory  # `isHopper`, its `cooldownTime` the `AtomicI32`
    facing*: FacingHopper
    tickedGameTime*: int64

var gHopperBlockEntityVt: nil BlockEntityVt

proc toOffset*(facing: FacingHopper): Vector3[int32] =
  ## `to_offset`
  case facing
  of FacingHopper.Down: Vector3[int32](x: 0, y: -1, z: 0)
  of FacingHopper.North: Vector3[int32](x: 0, y: 0, z: -1)
  of FacingHopper.South: Vector3[int32](x: 0, y: 0, z: 1)
  of FacingHopper.West: Vector3[int32](x: -1, y: 0, z: 0)
  of FacingHopper.East: Vector3[int32](x: 1, y: 0, z: 0)

proc newHopperInventory(cooldownTime: int32): ContainerInventory =
  result = newContainerInventory(INVENTORY_SIZE)
  result.isHopper = true
  result.cooldownTime = cooldownTime

proc invOf(self: HopperBlockEntity): Inventory =
  ## The entity's stacks as the base type: bound, nil-checked, then converted, as the compiler's not-nil proof wants.
  let c = self.inv
  if c == nil:
    return Inventory(newContainerInventory(INVENTORY_SIZE))
  Inventory(c)

proc addOneItem*(fromInv: Inventory, toInv: Inventory, item: ItemStack): bool =
  ## `add_one_item`: puts one item into the first slot of `toInv` that takes it, and shortens the cooldown of a hopper that was empty.
  var success = false
  let toEmpty = toInv.isEmpty()
  for j in 0 ..< toInv.size():
    if toInv.isValidSlotFor(j, item):
      var dst = toInv.getStack(j)
      if dst.isEmpty():
        dst = item
        success = true
      elif dst.itemCount < dst.getMaxStackSize() and dst.item == item.item:
        # TODO check Components equal
        dst.itemCount += 1
        success = true
      if success:
        toInv.storeStack(j, dst)
        if toEmpty and toInv of ContainerInventory and ContainerInventory(toInv).isHopper and
            ContainerInventory(toInv).cooldownTime <= 8:
          let hopper = ContainerInventory(toInv)
          if fromInv of ContainerInventory and ContainerInventory(fromInv).isHopper:
            if ContainerInventory(fromInv).cooldownTime >= hopper.cooldownTime:
              hopper.cooldownTime = 7
            else:
              hopper.cooldownTime = 8
          else:
            hopper.cooldownTime = 8
        toInv.markDirty()
        return true
  false

proc inventoryFull(self: HopperBlockEntity): bool =
  for i in 0 ..< self.inv.items.len:
    let item = self.inv.items[i]
    if item.isEmpty() or item.itemCount != item.getMaxStackSize():
      return false
  true

proc suckInItems(self: HopperBlockEntity, world: BlockWorld): bool =
  # TODO upstream: getEntityContainer
  let posUp = self.position.up()
  let entity = world.getBlockEntity(posUp)
  if entity.isSome:
    let container = entity.unsafeGet.getInventory()
    if container.isSome:
      let source = container.unsafeGet
      let me = self.invOf()
      # TODO upstream: check WorldlyContainer
      for i in 0 ..< source.size():
        var item = source.getStack(i)
        if not item.isEmpty() and source.canTransferTo(me, i, item):
          #TODO upstream: WorldlyContainer
          let backup = item
          let oneItem = item.split(1)
          source.storeStack(i, item)
          if addOneItem(source, me, oneItem):
            # If extracting from furnace output slot (index 2), drop XP as orbs
            const FURNACE_OUTPUT_SLOT = 2
            if i == FURNACE_OUTPUT_SLOT:
              let experienceContainer = entity.unsafeGet.toExperienceContainer()
              if experienceContainer.isSome:
                let xp = experienceContainer.unsafeGet.extractExperience()
                if xp > 0:
                  world.spawnExperienceOrb(self.position.toF64(), uint32(xp))
            return true
          source.storeStack(i, backup)
      return false
  let (blockRef, state) = world.getBlockAndState(posUp)
  if not (state.isSolid() and blockRef.hasTag(Block_MINECRAFT_DOES_NOT_BLOCK_HOPPERS)):
    let posUpF = posUp.toF64()
    let searchBox = newBoundingBox(posUpF, posUpF.addRaw(1.0, 1.0, 1.0))
    let entities = world.getEntitiesAtBox(searchBox)
    let me = self.invOf()
    for i in 0 ..< entities.len:
      let found = getItemEntityStack(entities[i])
      if found[0]:
        var stack = found[1]
        if not stack.isEmpty():
          let backup = stack
          let oneItem = stack.split(1)
          if addOneItem(me, me, oneItem):
            if stack.isEmpty():
              removeEntity(entities[i])
            else:
              setItemEntityStack(entities[i], stack)
            return true
          setItemEntityStack(entities[i], backup)
  false

proc ejectItems(self: HopperBlockEntity, world: BlockWorld): bool =
  # TODO getEntityContainer
  let entity = world.getBlockEntity(self.position.offset(toOffset(self.facing)))
  if entity.isNone:
    return false
  let container = entity.unsafeGet.getInventory()
  if container.isNone:
    return false
  let target = container.unsafeGet
  # TODO check WorldlyContainer
  var isFull = true
  for i in 0 ..< target.size():
    let item = target.getStack(i)
    if item.itemCount < item.getMaxStackSize():
      isFull = false
      break
  if isFull:
    return false
  let me = self.invOf()
  for i in 0 ..< self.inv.items.len:
    var item = self.inv.items[i]
    if not item.isEmpty():
      #TODO WorldlyContainer
      let backup = item
      let oneItem = item.split(1)
      self.inv.items[i] = item
      if addOneItem(me, target, oneItem):
        return true
      self.inv.items[i] = backup
  false

proc tryMoveItems(self: HopperBlockEntity, state: HopperLikeProperties, world: BlockWorld) =
  if self.inv.cooldownTime <= 0 and state.enabled:
    var success = false
    if not self.invOf().isEmpty():
      success = self.ejectItems(world)
    if not self.inventoryFull():
      success = self.suckInItems(world) or success
    if success:
      self.inv.cooldownTime = 8
      self.inv.dirty = true

proc hopperResourceLocation(self0: BlockEntity): string =
  ID

proc hopperGetPosition(self0: BlockEntity): BlockPos =
  HopperBlockEntity(self0).position

proc hopperWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let self = HopperBlockEntity(self0)
  nbt.put("TransferCooldown", NbtTag(kind: ntkInt, intVal: self.inv.cooldownTime))
  let i = self.invOf()
  i.writeInventoryNbt(nbt, true)

proc hopperTick(self0: BlockEntity, world: BlockWorld) =
  let self = HopperBlockEntity(self0)
  let age = world.worldAge0
  self.tickedGameTime = if age != nil: age() else: 0'i64
  let before = self.inv.cooldownTime
  self.inv.cooldownTime = before - 1
  if before <= 0:
    self.inv.cooldownTime = 0
    let state = HopperLikeProperties.fromStateId(world.getBlockState(self.position).id, blockHopper())
    self.facing = state.facing
    self.tryMoveItems(state, world)

proc hopperGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = HopperBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc hopperSetBlockState(self0: BlockEntity, blockState: BlockStateId) =
  # TODO !!!IMPORTANT!!! set block state when loading the chunk
  HopperBlockEntity(self0).facing = HopperLikeProperties.fromStateId(blockState, blockHopper()).facing

proc hopperIsDirty(self0: BlockEntity): bool =
  HopperBlockEntity(self0).inv.dirty

proc hopperClearDirty(self0: BlockEntity) =
  HopperBlockEntity(self0).inv.dirty = false

proc hopperChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  let self = HopperBlockEntity(self0)
  var nbt = newCompound()
  nbt.put("TransferCooldown", NbtTag(kind: ntkInt, intVal: self.inv.cooldownTime))
  syncWriteItemsToNbt(self.inv.items, nbt)
  some(nbt)

proc hopperBlockEntityVt*(): BlockEntityVt =
  if gHopperBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = hopperResourceLocation
    v.getPositionImpl = hopperGetPosition
    v.writeNbtImpl = hopperWriteNbt
    v.tickImpl = hopperTick
    v.getInventoryImpl = hopperGetInventory
    v.setBlockStateImpl = hopperSetBlockState
    v.isDirtyImpl = hopperIsDirty
    v.clearDirtyImpl = hopperClearDirty
    v.chunkDataNbtImpl = hopperChunkDataNbt
    gHopperBlockEntityVt = v
  gHopperBlockEntityVt

proc newHopperBlockEntity*(position: BlockPos, facing: FacingHopper): HopperBlockEntity =
  HopperBlockEntity(vt: hopperBlockEntityVt(), position: position, inv: newHopperInventory(-1'i32), facing: facing,
    tickedGameTime: 0)

proc hopperBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): HopperBlockEntity =
  let cooldown = nbt.getInt("TransferCooldown")
  result = HopperBlockEntity(vt: hopperBlockEntityVt(), position: position,
    inv: newHopperInventory(if cooldown.isSome: cooldown.unsafeGet else: -1'i32), facing: FacingHopper.Down,
    tickedGameTime: 0)
  syncReadItemsFromNbt(nbt, result.inv.items)
