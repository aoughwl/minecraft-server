## Port of pumpkin/src/block/entities/jigsaw_block.rs
## `generate` and `place_structure` run `JigsawPlacement::add_pieces`, which a block module must not import: they are `generateJigsaw` in ../jigsawplace.aowl, which fills `gJigsawGenerateHook`.
## The `Mutex` and atomic fields are plain fields here (one thread writes a world). `JigsawJointType` is declared here, as the
## generator's own (world/generation/structure/structures/jigsaw.aowl) has the block's name for another type and a block module
## should not import the generator; the two are the same two names.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:jigsaw"

type
  JigsawJointType* {.pure.} = enum
    Rollable, Aligned
  JigsawBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    name*: string
    target*: string
    pool*: string
    finalState*: string
    joint*: JigsawJointType
    selectionPriority*: int32
    placementPriority*: int32
    dirty*: bool

var gJigsawBlockEntityVt: nil BlockEntityVt

var gJigsawGenerateHook*: proc(world: BlockWorld; entity: JigsawBlockEntity; levels: int32; keepJigsaws: bool) {.closure.} =
  proc(world: BlockWorld; entity: JigsawBlockEntity; levels: int32; keepJigsaws: bool) {.closure.} = discard

proc jointFromStr*(s: string): JigsawJointType =
  ## `JigsawJointType::from_str`
  if s == "aligned": JigsawJointType.Aligned else: JigsawJointType.Rollable

proc generate*(self: JigsawBlockEntity, world: BlockWorld, levels: int32, keepJigsaws: bool) =
  ## `generate`: see the comment on the first line of this file.
  gJigsawGenerateHook(world, self, levels, keepJigsaws)

proc toFrontTop*(orientation: Orientation): (BlockDirection, BlockDirection) =
  case orientation
  of Orientation.DownEast: (BlockDirection.Down, BlockDirection.East)
  of Orientation.DownNorth: (BlockDirection.Down, BlockDirection.North)
  of Orientation.DownSouth: (BlockDirection.Down, BlockDirection.South)
  of Orientation.DownWest: (BlockDirection.Down, BlockDirection.West)
  of Orientation.UpEast: (BlockDirection.Up, BlockDirection.East)
  of Orientation.UpNorth: (BlockDirection.Up, BlockDirection.North)
  of Orientation.UpSouth: (BlockDirection.Up, BlockDirection.South)
  of Orientation.UpWest: (BlockDirection.Up, BlockDirection.West)
  of Orientation.WestUp: (BlockDirection.West, BlockDirection.Up)
  of Orientation.EastUp: (BlockDirection.East, BlockDirection.Up)
  of Orientation.NorthUp: (BlockDirection.North, BlockDirection.Up)
  of Orientation.SouthUp: (BlockDirection.South, BlockDirection.Up)

proc jigsawBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc jigsawBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  JigsawBlockEntity(self0).position

proc jigsawBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = JigsawBlockEntity(self0)
  nbt.putString("name", self.name)
  nbt.putString("target", self.target)
  nbt.putString("pool", self.pool)
  nbt.putString("final_state", self.finalState)
  nbt.putString("joint", if self.joint == JigsawJointType.Aligned: "aligned" else: "rollable")
  nbt.putInt("selection_priority", self.selectionPriority)
  nbt.putInt("placement_priority", self.placementPriority)

proc jigsawBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  jigsawBlockEntityWriteNbt_BlockEntity(self0, nbt)
  some(nbt)

proc jigsawBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  JigsawBlockEntity(self0).dirty

proc jigsawBlockEntityVt*(): BlockEntityVt =
  if gJigsawBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = jigsawBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = jigsawBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = jigsawBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = jigsawBlockEntityChunkDataNbt_BlockEntity
    v.isDirtyImpl = jigsawBlockEntityIsDirty_BlockEntity
    gJigsawBlockEntityVt = v
  gJigsawBlockEntityVt

proc newJigsawBlockEntity*(position: BlockPos): JigsawBlockEntity =
  JigsawBlockEntity(vt: jigsawBlockEntityVt(), position: position, name: "minecraft:empty", target: "minecraft:empty",
    pool: "minecraft:empty", finalState: "minecraft:air", joint: JigsawJointType.Rollable, selectionPriority: 0,
    placementPriority: 0, dirty: false)

proc jigsawBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): JigsawBlockEntity =
  JigsawBlockEntity(vt: jigsawBlockEntityVt(), position: position, name: nbt.getString("name").get("minecraft:empty"),
    target: nbt.getString("target").get("minecraft:empty"), pool: nbt.getString("pool").get("minecraft:empty"),
    finalState: nbt.getString("final_state").get("minecraft:air"), joint: jointFromStr(nbt.getString("joint").get("rollable")),
    selectionPriority: nbt.getInt("selection_priority").get(0'i32), placementPriority: nbt.getInt("placement_priority").get(0'i32),
    dirty: false)
