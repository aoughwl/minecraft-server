  JigsawBlockEntity(position: position, name: $("minecraft:empty"), target: $("minecraft:empty"), pool: $("minecraft:empty"), finalState: $("minecraft:air"), joint: JigsawJointType.Rollable, selectionPriority: 0, placementPriority: 0, dirty: false)

proc generate*(self: JigsawBlockEntity, world: BlockWorld, levels: int32, keepJigsaws: bool) =
  let pool = self.pool
  let target = self.target
  let blockState = world.getBlockState(self.position)
  let props = JigsawLikeProperties.fromStateId(blockState.id, blockJigsaw())
  let (front, top) = toFrontTop(props.orientation)
  let position = self.position.offset(front.toVector())
  let t1 = block:
    var context = StructureGeneratorContext(seed: world.levelInfo.worldGenSettings.seed, chunkX: self.position.chunkPosition().x, chunkZ: self.position.chunkPosition().y, random: RandomGenerator.Xoroshiro(Xoroshiro.fromSeed(rng().nextU64())), seaLevel: 63, minY: (-64), )
    JigsawPlacement.addPieces(context, pool, some(target), levels, position, false, false, newMaxDistance(80), DimensionPadding.ZERO, LiquidSettings.ApplyWaterlog, PoolAliasLookup)
  let structure = t1
  let t2 = structure
  if t2.isSome:
    let structure = t2.unsafeGet
    self.placeStructure(world, t2.unsafeGet, keepJigsaws)

proc placeStructure*(self: JigsawBlockEntity, world: BlockWorld, structure: StructurePosition, keepJigsaws: bool) =
  var pieces = take(structure.collector.get().pieces)
  for piece in pieces:
    let t3 = asType(piece, PoolElementStructurePiece)
    if t3.isSome:
      let poolPiece = t3.unsafeGet
      let origin = t3.unsafeGet.pos
      let rotation = t3.unsafeGet.rotation
      var templates = @[]
      t3.unsafeGet.element.forEachTemplate(R2A_MANUAL("closure |R2A_MANUAL_closure_params| templates.add(template0)"))
      for template0 in templates:
        for blockRef in template0.blocks:
          let paletteEntry = template0.palette[int(blockRef.state)]
          if (paletteEntry.name == "minecraft:structure_void"):
            continue
          if (not keepJigsaws) and (paletteEntry.name == "minecraft:jigsaw"):
            let finalStateStr = blockRef.nbt.andThen(R2A_MANUAL("closure |n| n.getString('final_state')")).get("minecraft:air")
            let entry = PaletteEntry.fromString(finalStateStr)
            let finalState = BlockStateResolver.resolve(entry, rotation, Mirror.defaultFor()).get(blockAir().defaultState)
            let localPos = rotation.transformPos(blockRef.pos, template0.size)
            let worldPos = origin.add(localPos.x, localPos.y, localPos.z)
            discard world.setBlockState(worldPos, finalState.id, BfNotifyAll)
            continue
          let t8 = BlockStateResolver.resolve(paletteEntry, rotation, Mirror.defaultFor())
          if not (t8.isSome):
            continue
          let state = t8.unsafeGet
          let localPos1 = rotation.transformPos(blockRef.pos, template0.size)
          let worldPos2 = origin.add(localPos1.x, localPos1.y, localPos1.z)
          discard world.setBlockState(worldPos2, state.id, BfNotifyAll)
          # Handle block entities
          let t9 = blockRef.nbt
          if t9.isSome:
            let nbt = t9.unsafeGet
            var blockEntityNbt = t9.unsafeGet
            blockEntityNbt.putInt("x", worldPos2[0].x)
            blockEntityNbt.putInt("y", worldPos2[0].y)
            blockEntityNbt.putInt("z", worldPos2[0].z)
            let t10 = blockEntityFromNbt(blockEntityNbt)
            if t10.isSome:
              let blockEntity = t10.unsafeGet
              world.addBlockEntity(t10.unsafeGet)

proc toFrontTop*(orientation: Orientation): (BlockDirection, BlockDirection) =
  case orientation
  of Orientation.DownEast:
    (BlockDirection.Down, BlockDirection.East)
  of Orientation.DownNorth:
    (BlockDirection.Down, BlockDirection.North)
  of Orientation.DownSouth:
    (BlockDirection.Down, BlockDirection.South)
  of Orientation.DownWest:
    (BlockDirection.Down, BlockDirection.West)
  of Orientation.UpEast:
    (BlockDirection.Up, BlockDirection.East)
  of Orientation.UpNorth:
    (BlockDirection.Up, BlockDirection.North)
  of Orientation.UpSouth:
    (BlockDirection.Up, BlockDirection.South)
  of Orientation.UpWest:
    (BlockDirection.Up, BlockDirection.West)
  of Orientation.WestUp:
    (BlockDirection.West, BlockDirection.Up)
  of Orientation.EastUp:
    (BlockDirection.East, BlockDirection.Up)
  of Orientation.NorthUp:
    (BlockDirection.North, BlockDirection.Up)
  of Orientation.SouthUp:
    (BlockDirection.South, BlockDirection.Up)

