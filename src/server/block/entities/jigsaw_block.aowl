proc jigsawBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): JigsawBlockEntity =
  let name = $(nbt.getString("name").get("minecraft:empty"))
  let target = $(nbt.getString("target").get("minecraft:empty"))
  let pool = $(nbt.getString("pool").get("minecraft:empty"))
  let finalState = $(nbt.getString("final_state").get("minecraft:air"))
  let joint = JigsawJointType.fromStr(nbt.getString("joint").get("rollable"))
  let selectionPriority = nbt.getInt("selection_priority").get(0)
  let placementPriority = nbt.getInt("placement_priority").get(0)
  JigsawBlockEntity(position: position, name: name, target: target, pool: pool, finalState: finalState, joint: joint, selectionPriority: selectionPriority, placementPriority: placementPriority, dirty: false)

proc jigsawBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = JigsawBlockEntity(self0)
  nbt.putString("name", $(self.name))
  nbt.putString("target", $(self.target))
  nbt.putString("pool", $(self.pool))
  nbt.putString("final_state", $(self.finalState))
  let t11 = block:
    case self.joint
    of JigsawJointType.Rollable:
      $("rollable")
    of JigsawJointType.Aligned:
      $("aligned")
  nbt.putString("joint", t11)
  nbt.putInt("selection_priority", self.selectionPriority)
  nbt.putInt("placement_priority", self.placementPriority)

