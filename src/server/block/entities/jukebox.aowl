## Port of pumpkin/src/block/entities/jukebox.rs
## The record is slot 0 of a one-slot `ContainerInventory` (containers.aowl), the entity's `Inventory`. Taking the record out through
## the inventory (`remove_stack` and its kin stop the song upstream) is noticed by `tick`, which stops a song whose record is gone.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const RECORD_ITEM_NBT_KEY: string = "RecordItem"
const TICKS_SINCE_SONG_STARTED_NBT_KEY: string = "ticks_since_song_started"
const ID*: string = "minecraft:jukebox"

type
  JukeboxBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory
    ticksSinceSongStarted*: uint64
    songLengthTicks*: uint64

var gJukeboxBlockEntityVt: nil BlockEntityVt

proc stopPlaying*(self: JukeboxBlockEntity) =
  self.ticksSinceSongStarted = 0
  self.songLengthTicks = 0
  self.inv.dirty = true

proc getRecord*(self: JukeboxBlockEntity): ItemStack =
  self.inv.items[0]

proc setRecord*(self: JukeboxBlockEntity, stack: ItemStack) =
  self.inv.items[0] = stack
  self.inv.dirty = true

proc clearRecord*(self: JukeboxBlockEntity): ItemStack =
  self.stopPlaying()
  let taken = self.inv.items[0]
  self.inv.items[0] = emptyItemStack()
  self.inv.dirty = true
  taken

proc startPlaying*(self: JukeboxBlockEntity, lengthInTicks: uint64) =
  self.ticksSinceSongStarted = 0
  self.songLengthTicks = lengthInTicks
  self.inv.dirty = true

proc isPlaying*(self: JukeboxBlockEntity): bool =
  let songLength = self.songLengthTicks
  if songLength == 0:
    return false
  let ticks = self.ticksSinceSongStarted
  ticks < songLength

proc jukeboxResourceLocation(self0: BlockEntity): string =
  ID

proc jukeboxGetPosition(self0: BlockEntity): BlockPos =
  JukeboxBlockEntity(self0).position

proc jukeboxWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let self = JukeboxBlockEntity(self0)
  if not self.inv.items[0].isEmpty():
    var recordNbt = newCompound()
    self.inv.items[0].writeItemStack(recordNbt)
    nbt.putCompound(RECORD_ITEM_NBT_KEY, recordNbt)
  let ticks = self.ticksSinceSongStarted
  if ticks > 0'u64:
    nbt.putLong(TICKS_SINCE_SONG_STARTED_NBT_KEY, int64(ticks))

proc jukeboxTick(self0: BlockEntity, world: BlockWorld) =
  let self = JukeboxBlockEntity(self0)
  if self.inv.items[0].isEmpty() and self.songLengthTicks > 0'u64:
    self.stopPlaying()
  # Increment ticks if we're playing
  let songLength = self.songLengthTicks
  if songLength > 0'u64:
    self.ticksSinceSongStarted += 1'u64
    let ticks = self.ticksSinceSongStarted
    # Check if song has finished
    if ticks >= songLength:
      self.stopPlaying()

proc jukeboxIsDirty(self0: BlockEntity): bool =
  JukeboxBlockEntity(self0).inv.dirty

proc jukeboxClearDirty(self0: BlockEntity) =
  JukeboxBlockEntity(self0).inv.dirty = false

proc jukeboxChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  let self = JukeboxBlockEntity(self0)
  var nbt = newCompound()
  if not self.inv.items[0].isEmpty():
    var recordNbt = newCompound()
    self.inv.items[0].writeItemStack(recordNbt)
    nbt.putCompound(RECORD_ITEM_NBT_KEY, recordNbt)
  nbt.putLong(TICKS_SINCE_SONG_STARTED_NBT_KEY, int64(self.ticksSinceSongStarted))
  some(nbt)

proc jukeboxGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = JukeboxBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc jukeboxBlockEntityVt*(): BlockEntityVt =
  if gJukeboxBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = jukeboxResourceLocation
    v.getPositionImpl = jukeboxGetPosition
    v.writeNbtImpl = jukeboxWriteNbt
    v.tickImpl = jukeboxTick
    v.isDirtyImpl = jukeboxIsDirty
    v.clearDirtyImpl = jukeboxClearDirty
    v.chunkDataNbtImpl = jukeboxChunkDataNbt
    v.getInventoryImpl = jukeboxGetInventory
    gJukeboxBlockEntityVt = v
  gJukeboxBlockEntityVt

proc newJukeboxBlockEntity*(position: BlockPos): JukeboxBlockEntity =
  JukeboxBlockEntity(vt: jukeboxBlockEntityVt(), position: position, inv: newContainerInventory(1),
    ticksSinceSongStarted: 0, songLengthTicks: 0)

proc jukeboxBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): JukeboxBlockEntity =
  result = newJukeboxBlockEntity(position)
  let record = nbt.getCompound(RECORD_ITEM_NBT_KEY)
  if record.isSome:
    let stack = readItemStack(record.unsafeGet)
    if stack.isSome:
      result.inv.items[0] = stack.unsafeGet
  result.ticksSinceSongStarted = uint64(nbt.getLong(TICKS_SINCE_SONG_STARTED_NBT_KEY).get(0'i64))
