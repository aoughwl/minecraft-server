## Port of pumpkin/src/block/entities/lectern.rs
## The book slot is a one-stack `ContainerInventory` (containers.aowl), which is the entity's `Inventory`; `page` is the
## `AtomicUsize`. Upstream's `remove_stack_specific` does not check the slot, and nor does the container's.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const ID*: string = "minecraft:lectern"

type
  LecternBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory  # `book` is `inv.items[0]`, `dirty` is `inv.dirty`
    page*: int

var gLecternBlockEntityVt: nil BlockEntityVt

proc asInventory*(self: LecternBlockEntity): Inventory =
  ## The slot as the base type: the compiler's not-nil proof wants the nil check before the conversion.
  let c = self.inv
  if c == nil:
    rustPanic("lectern without its inventory")
  containerAsInventory(c)

proc book*(self: LecternBlockEntity): ItemStack =
  self.inv.items[0]

proc lecternBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc lecternBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  LecternBlockEntity(self0).position

proc lecternBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = LecternBlockEntity(self0)
  let book = self.inv.items[0]
  if not book.isEmpty():
    var bookNbt = newCompound()
    book.writeItemStack(bookNbt)
    nbt.put("Book", nbtTag(bookNbt))
  nbt.putInt("Page", int32(self.page))

proc lecternBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  let c = LecternBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc lecternBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  LecternBlockEntity(self0).inv.dirty

proc lecternBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  LecternBlockEntity(self0).inv.dirty = false

proc lecternBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = LecternBlockEntity(self0)
  var nbt = newCompound()
  let book = self.inv.items[0]
  if not book.isEmpty():
    var bookNbt = newCompound()
    book.writeItemStack(bookNbt)
    nbt.put("Book", nbtTag(bookNbt))
  nbt.putInt("Page", int32(self.page))
  some(nbt)

proc lecternBlockEntityVt*(): BlockEntityVt =
  if gLecternBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = lecternBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = lecternBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = lecternBlockEntityWriteNbt_BlockEntity
    v.getInventoryImpl = lecternBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = lecternBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = lecternBlockEntityClearDirty_BlockEntity
    v.chunkDataNbtImpl = lecternBlockEntityChunkDataNbt_BlockEntity
    gLecternBlockEntityVt = v
  gLecternBlockEntityVt

proc newLecternBlockEntity*(position: BlockPos): LecternBlockEntity =
  LecternBlockEntity(vt: lecternBlockEntityVt(), position: position, inv: newContainerInventory(1), page: 0)

proc readLecternBook(nbt: NbtCompound): ItemStack =
  let t = nbt.getCompound("Book")
  if t.isSome:
    let stack = readItemStack(t.unsafeGet)
    if stack.isSome:
      return stack.unsafeGet
  emptyItemStack()

proc lecternBlockEntityFromNbt_BlockEntity*(nbt: NbtCompound, position: BlockPos): LecternBlockEntity =
  let book = readLecternBook(nbt)
  let pageTag = nbt.getInt("Page")
  let page = if pageTag.isSome: max(int(pageTag.unsafeGet), 0) else: 0
  let e = newLecternBlockEntity(position)
  e.inv.items[0] = book
  e.page = page
  e
