## Port of pumpkin/src/block/entities/mob_spawner.rs
## `entity_type: AtomicCell<Option<&EntityType>>` is the type's registry name (`EntityType.resourceName`, "zombie") and the type is
## looked up by it where its size is needed. `from_type` and `spawn_entity` are `spawnEntity` of the world (worldhooks.aowl) and
## `is_space_empty` is the `isSpaceEmpty0` hook. The block entity's own `write_nbt` (an inherent method upstream, which writes `id`,
## `x`, `y`, `z` as well) is `writeSpawnerNbt`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/entity_type

const ID*: string = "minecraft:mob_spawner"
const DEFAULT_DELAY*: int32 = 20
const DEFAULT_MAX_SPAWN_DELAY*: int32 = 800
const DEFAULT_MIN_SPAWN_DELAY*: int32 = 200
const DEFAULT_SPAWN_COUNT*: int32 = 4
const DEFAULT_SPAWN_RANGE*: int32 = 4

type
  MobSpawnerBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    delay*: int32
    maxDelay*: int32
    minDelay*: int32
    spawnCount*: int32
    spawnRange*: int32
    entityType*: Option[string]

var gMobSpawnerBlockEntityVt: nil BlockEntityVt

proc spawnDataNbt(entityType: string): NbtCompound =
  var spawnEntry = newCompound()
  var entityNbt = newCompound()
  entityNbt.putString("id", "minecraft:" & entityType)
  spawnEntry.putCompound("entity", entityNbt)
  var wrapper = newCompound()
  wrapper.putCompound("SpawnData", spawnEntry)
  wrapper

proc writeSpawnerNbt*(self: MobSpawnerBlockEntity, nbt: var NbtCompound) =
  # TODO: this is ugly af
  nbt.putString("id", ID)
  let position = self.position
  nbt.putInt("x", position.vec.x)
  nbt.putInt("y", position.vec.y)
  nbt.putInt("z", position.vec.z)
  if self.entityType.isSome:
    var data = spawnDataNbt(self.entityType.unsafeGet)
    let spawnData = data.getCompound("SpawnData")
    nbt.putCompound("SpawnData", spawnData.unsafeGet)

proc updateSpawns*(self: MobSpawnerBlockEntity, world: BlockWorld) =
  let minDelay = self.minDelay
  let maxDelay = self.maxDelay
  if maxDelay <= minDelay:
    self.delay = minDelay
  else:
    self.delay = minDelay + rng().randomRange(0'i32 ..< (maxDelay - minDelay))
  world.addSyncedBlockEvent(self.position, 1'u8, 0'u8)

proc setEntityType*(self: MobSpawnerBlockEntity, entityType: string) =
  self.entityType = some(entityType)

proc mobSpawnerBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc mobSpawnerBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  MobSpawnerBlockEntity(self0).position

proc mobSpawnerBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = MobSpawnerBlockEntity(self0)
  if self.entityType.isNone:
    return
  let entityName = self.entityType.unsafeGet
  if self.delay == -1'i32:
    self.updateSpawns(world)
  else:
    self.delay -= 1'i32
    return
  let spawnRange = self.spawnRange
  var updateSpawnsNow = false
  let kind = EntityType.fromName(entityName)
  for _ in 0 ..< int(self.spawnCount):
    let pos = self.position.vec
    let spawnPos = Vector3[float64](
      x: float64(pos.x) + (randomOf(float64) + randomOf(float64)) * float64(spawnRange) + 0.5,
      y: float64(pos.y + rng().randomRange(0'i32 ..< 3'i32) - 1'i32),
      z: float64(pos.z) + (randomOf(float64) + randomOf(float64)) * float64(spawnRange) + 0.5)
    # TODO: we should use getSpawnBox, but this is only modified for slimes and magma slimes
    let spaceEmpty = world.isSpaceEmpty0
    if kind.isSome and spaceEmpty != nil:
      let size = kind.unsafeGet
      let box = BoundingBox.newFromPos(spawnPos.x, spawnPos.y, spawnPos.z,
        EntityDimensions(width: size.dimension[0], height: size.dimension[1], eyeHeight: size.eyeHeight))
      if not spaceEmpty(box):
        continue
    let spawned = world.spawnEntity(entityName, spawnPos)
    if spawned == nil:
      continue
    world.syncWorldEvent(weParticlesMobblockSpawn, self.position, 0'i32)
    updateSpawnsNow = true
  if updateSpawnsNow:
    self.updateSpawns(world)

proc mobSpawnerBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  MobSpawnerBlockEntity(self0).writeSpawnerNbt(nbt)

proc mobSpawnerBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = MobSpawnerBlockEntity(self0)
  var finalNbt = newCompound()
  if self.entityType.isSome:
    var data = spawnDataNbt(self.entityType.unsafeGet)
    finalNbt.putCompound("SpawnData", data.getCompound("SpawnData").unsafeGet)
  some(finalNbt)

proc mobSpawnerBlockEntityVt*(): BlockEntityVt =
  if gMobSpawnerBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = mobSpawnerBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = mobSpawnerBlockEntityGetPosition_BlockEntity
    v.tickImpl = mobSpawnerBlockEntityTick_BlockEntity
    v.writeNbtImpl = mobSpawnerBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = mobSpawnerBlockEntityChunkDataNbt_BlockEntity
    gMobSpawnerBlockEntityVt = v
  gMobSpawnerBlockEntityVt

proc newMobSpawnerBlockEntity*(position: BlockPos, entityType: Option[string]): MobSpawnerBlockEntity =
  MobSpawnerBlockEntity(vt: mobSpawnerBlockEntityVt(), position: position, delay: DEFAULT_DELAY, maxDelay: DEFAULT_MAX_SPAWN_DELAY,
    minDelay: DEFAULT_MIN_SPAWN_DELAY, spawnCount: DEFAULT_SPAWN_COUNT, spawnRange: DEFAULT_SPAWN_RANGE, entityType: entityType)

proc mobSpawnerBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): MobSpawnerBlockEntity =
  let delay = int32(nbt.getShort("Delay").get(int16(DEFAULT_DELAY)))
  let minDelay = nbt.getInt("MinSpawnDelay").get(DEFAULT_MIN_SPAWN_DELAY)
  let maxDelay = nbt.getInt("MaxSpawnDelay").get(DEFAULT_MAX_SPAWN_DELAY)
  let spawnCount = nbt.getInt("SpawnCount").get(DEFAULT_SPAWN_COUNT)
  let spawnRange = nbt.getInt("SpawnRange").get(DEFAULT_SPAWN_RANGE)
  var entityType = none[string]()
  let data = nbt.getCompound("SpawnData")
  if data.isSome:
    let entity = data.unsafeGet.getCompound("entity")
    if entity.isSome:
      let id = entity.unsafeGet.getString("id")
      if id.isSome:
        var name = id.unsafeGet
        if name.len > 10 and name[0 ..< 10] == "minecraft:":
          name = name[10 ..< name.len]
        if EntityType.fromName(name).isSome:
          entityType = some(name)
  MobSpawnerBlockEntity(vt: mobSpawnerBlockEntityVt(), position: position, delay: delay, maxDelay: maxDelay, minDelay: minDelay,
    spawnCount: spawnCount, spawnRange: spawnRange, entityType: entityType)
