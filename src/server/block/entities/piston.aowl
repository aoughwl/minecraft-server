## Port of pumpkin/src/block/entities/piston.rs
## `pushed_block_state` is not saved, as upstream (it reads back as air). An entity is a `BlockActor` here: its box, position,
## `no_clip` and `send_pos` come from the hooks worldhooks.aowl fills.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:piston"
const FACING: string = "facing"
const LAST_PROGRESS: string = "progress"
const EXTENDING: string = "extending"
const SOURCE: string = "source"

type
  PistonBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    pushedBlockState*: BlockState
    facing*: BlockDirection
    currentProgress*: float32
    lastProgress*: float32
    extending*: bool
    source*: bool

var gPistonBlockEntityVt: nil BlockEntityVt


proc movementDirection*(self: PistonBlockEntity): BlockDirection =
  if self.extending:
    self.facing
  else:
    self.facing.opposite()

proc amountExtended*(self: PistonBlockEntity, progress: float32): float32 =
  if self.extending:
    (progress - 1.0)
  else:
    (1.0 - progress)

proc dirVec*(dir: BlockDirection, scale: float64): Vector3[float64] =
  let off = dir.toOffset()
  vec3((float64(off.x) * scale), (float64(off.y) * scale), (float64(off.z) * scale))

proc intersectionSize*(swept: BoundingBox, motionDir: BlockDirection, entity: BoundingBox): float64 =
  case motionDir
  of BlockDirection.East:
    (swept.max.x - entity.min.x)
  of BlockDirection.West:
    (entity.max.x - swept.min.x)
  of BlockDirection.Up:
    (swept.max.y - entity.min.y)
  of BlockDirection.Down:
    (entity.max.y - swept.min.y)
  of BlockDirection.South:
    (swept.max.z - entity.min.z)
  of BlockDirection.North:
    (entity.max.z - swept.min.z)

proc moveEntity*(entity: BlockActor, dir: BlockDirection, distance: float64) =
  let posOf = entity.block0Pos
  let at = posOf()
  let by = dirVec(dir, distance)
  let newPos = Vector3[float64](x: at.x + by.x, y: at.y + by.y, z: at.z + by.z)
  let setPos = entity.setPos0
  setPos(newPos)
  let sendPos = entity.sendPos0
  if sendPos != nil:
    sendPos()

proc aabbIntersection*(a: BoundingBox, b: BoundingBox): BoundingBox =
  newBoundingBox(vec3(max(a.min.x, b.min.x), max(a.min.y, b.min.y), max(a.min.z, b.min.z)), vec3(min(a.max.x, b.max.x), min(a.max.y, b.max.y), min(a.max.z, b.max.z)))

proc headShapeAabb*(blockAabb: BoundingBox, facing: BlockDirection): BoundingBox =
  const HEAD_THICKNESS: float64 = 0.25
  var min = blockAabb.min
  var max = blockAabb.max
  case facing
  of BlockDirection.East:
    min.x = (max.x - HEAD_THICKNESS)
  of BlockDirection.West:
    max.x = (min.x + HEAD_THICKNESS)
  of BlockDirection.Up:
    min.y = (max.y - HEAD_THICKNESS)
  of BlockDirection.Down:
    max.y = (min.y + HEAD_THICKNESS)
  of BlockDirection.South:
    min.z = (max.z - HEAD_THICKNESS)
  of BlockDirection.North:
    max.z = (min.z + HEAD_THICKNESS)
  newBoundingBox(min, max)

proc pushOutOfPistonBody*(entity: BlockActor, pistonPos: BlockPos, motionDir: BlockDirection, amount: float64) =
  let bodyAabb = BoundingBox.fromBlock(pistonPos)
  let boxOf = entity.getBox0
  let entityAabb = boxOf()
  if (not bodyAabb.intersects(entityAabb)):
    return
  let back = motionDir.opposite()
  let e = (intersectionSize(bodyAabb, back, entityAabb) + 0.01)
  let f = (intersectionSize(bodyAabb, back, aabbIntersection(bodyAabb, entityAabb)) + 0.01)
  if abs(e - f) < 0.01:
    let distance = min(e, amount) + 0.01
    moveEntity(entity, back, distance)

proc pushEntities*(self: PistonBlockEntity, world: BlockWorld, newProgress: float32) =
  let last = self.lastProgress
  let delta = float64((newProgress - last))
  if (delta <= 0.0):
    return
  let motionDir = self.movementDirection()
  let amount = float64(self.amountExtended(last))
  # Block AABB at the current visual position (start of this tick).
  # For source=true (the piston head BE), vanilla uses the piston-head
  # collision shape — a 4-pixel-thick slab at the front face — rather than
  # the full cube. Without this, the head "sweeps" too much volume and
  # drags entities (e.g. end crystals) back with it during retraction.
  let rawBlockAabb = BoundingBox.fromBlock(self.position)
  let shape = if self.source: headShapeAabb(rawBlockAabb, self.facing) else: rawBlockAabb
  let blockAabb = shape.shift(dirVec(self.facing, amount))
  # Stretch by motion to get the swept volume (one tick of animation).
  let motion = dirVec(motionDir, delta)
  let swept = blockAabb.stretch(motion)
  let atBox = world.entitiesAtBox0
  if atBox == nil:
    return
  for e in atBox(swept):
    let noClip = e.noClip0
    if noClip != nil and noClip():
      continue
    # Player movement is client-authoritative; vanilla still nudges them
    # via Entity.move(PISTON), but we skip them here to avoid teleport jank.
    if e.player0 != nil:
      continue
    let boxOf = e.getBox0
    let entityAabb = boxOf()
    let intersection = intersectionSize(swept, motionDir, entityAabb)
    if (intersection <= 0.0):
      continue
    let pushAmount = min(intersection, delta) + 0.01
    moveEntity(e, motionDir, pushAmount)
    # For a retracting head, vanilla also shoves the entity OUT of the
    # piston body cube. Without this, entities get pulled into the
    # piston and "stick" to it (looks like a sticky-piston drag).
    # For a retract-head BE, `self.position` already IS the piston
    # block position (it replaces the piston during animation).
    if (not self.extending) and self.source:
      pushOutOfPistonBody(e, self.position, motionDir, delta)

proc finish*(self: PistonBlockEntity, world: BlockWorld) =
  if self.lastProgress < 1.0'f32:
    let pos = self.position
    world.removeBlockEntity(pos)
    if sameBlock(world.getBlock(pos), blockMovingPiston()):
      let state = if self.source: blockAir().defaultState.id else: world.updateFromNeighborShapes(self.pushedBlockState.id, pos)
      discard world.setBlockState(pos, state, BfNotifyAll)
      world.updateNeighbor(pos, Block.fromStateId(state))

proc pistonBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc pistonBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  PistonBlockEntity(self0).position

proc pistonBlockEntityTick_BlockEntity(self0: BlockEntity, world: BlockWorld) =
  let self = PistonBlockEntity(self0)
  let currentProgress = self.currentProgress
  self.lastProgress = currentProgress
  if currentProgress >= 1.0'f32:
    let pos = self.position
    world.removeBlockEntity(pos)
    if sameBlock(world.getBlock(pos), blockMovingPiston()):
      if self.pushedBlockState.isAir():
        discard world.setBlockState(pos, self.pushedBlockState.id, (BfForceState or BfMoved))
      else:
        let updatedState = world.updateFromNeighborShapes(self.pushedBlockState.id, pos)
        discard world.setBlockState(pos, updatedState, (BfNotifyAll or BfMoved))
        world.updateNeighbor(pos, Block.fromStateId(updatedState))
    return
  let newProgress = min(currentProgress + 0.5'f32, 1.0'f32)
  self.pushEntities(world, newProgress)
  self.currentProgress = newProgress

proc pistonBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = PistonBlockEntity(self0)
  # TODO: pushed_block_state
  nbt.putByte(FACING, int8(self.facing.toIndex()))
  nbt.putFloat(LAST_PROGRESS, self.lastProgress)
  nbt.putBool(EXTENDING, self.extending)
  nbt.putBool(SOURCE, self.source)

proc pistonBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = PistonBlockEntity(self0)
  var nbt = newCompound()
  # TODO: pushed_block_state
  nbt.putByte(FACING, int8(self.facing.toIndex()))
  nbt.putFloat(LAST_PROGRESS, self.lastProgress)
  nbt.putBool(EXTENDING, self.extending)
  nbt.putBool(SOURCE, self.source)
  # TODO: duplicated code because of async :c
  some(nbt)

proc pistonBlockEntityVt*(): BlockEntityVt =
  if gPistonBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = pistonBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = pistonBlockEntityGetPosition_BlockEntity
    v.tickImpl = pistonBlockEntityTick_BlockEntity
    v.writeNbtImpl = pistonBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = pistonBlockEntityChunkDataNbt_BlockEntity
    gPistonBlockEntityVt = v
  gPistonBlockEntityVt

proc pistonBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): PistonBlockEntity =
  # TODO
  let pushedBlockState = blockAir().defaultState
  let facing = nbt.getByte(FACING).get(0'i8)
  let lastProgress = nbt.getFloat(LAST_PROGRESS).get(0.0'f32)
  let extending = nbt.getBool(EXTENDING).get(false)
  let source = nbt.getBool(SOURCE).get(false)
  let direction = BlockDirection.fromIndex(uint8(facing))
  PistonBlockEntity(vt: pistonBlockEntityVt(), pushedBlockState: pushedBlockState, position: position,
    facing: direction.get(BlockDirection.Down), currentProgress: lastProgress, lastProgress: lastProgress, extending: extending,
    source: source)

proc newPistonBlockEntity*(position: BlockPos, pushedBlockState: BlockState, facing: BlockDirection, extending: bool,
    source: bool): PistonBlockEntity =
  ## The struct literal upstream writes at each use: both progresses start at 0.
  PistonBlockEntity(vt: pistonBlockEntityVt(), position: position, facing: facing, pushedBlockState: pushedBlockState,
    currentProgress: 0.0'f32, lastProgress: 0.0'f32, extending: extending, source: source)
