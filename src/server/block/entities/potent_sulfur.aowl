{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:potent_sulfur"

type
  PotentSulfurBlockEntity* = ref object of BlockEntity
    position*: BlockPos

var gPotentSulfurBlockEntityVt: nil BlockEntityVt

proc potentSulfurBlockEntityVt*(): BlockEntityVt

proc newPotentSulfurBlockEntity*(position: BlockPos): PotentSulfurBlockEntity =
  PotentSulfurBlockEntity(vt: potentSulfurBlockEntityVt(), position: position)

proc potentSulfurBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc potentSulfurBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  PotentSulfurBlockEntity(self0).position

proc potentSulfurBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): PotentSulfurBlockEntity =
  PotentSulfurBlockEntity(vt: potentSulfurBlockEntityVt(), position: position)

proc potentSulfurBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  discard

proc potentSulfurBlockEntityVt*(): BlockEntityVt =
  if gPotentSulfurBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = potentSulfurBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = potentSulfurBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = potentSulfurBlockEntityWriteNbt_BlockEntity
    gPotentSulfurBlockEntityVt = v
  gPotentSulfurBlockEntityVt
