## Port of pumpkin/src/block/entities/sculk_catalyst.rs
## The `Mutex` fields are plain fields here (one thread writes a world).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:sculk_catalyst"

type
  SculkCatalystBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    decayDelay*: int32

var gSculkCatalystBlockEntityVt: nil BlockEntityVt

proc sculkCatalystBlockEntityVt*(): BlockEntityVt

proc newSculkCatalystBlockEntity*(position: BlockPos): SculkCatalystBlockEntity =
  SculkCatalystBlockEntity(vt: sculkCatalystBlockEntityVt(), position: position, decayDelay: 0)

proc sculkCatalystBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc sculkCatalystBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  SculkCatalystBlockEntity(self0).position

proc sculkCatalystBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SculkCatalystBlockEntity =
  let decayDelay = nbt.getInt("decay_delay").get(0'i32)
  SculkCatalystBlockEntity(vt: sculkCatalystBlockEntityVt(), position: position, decayDelay: decayDelay)

proc sculkCatalystBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = SculkCatalystBlockEntity(self0)
  nbt.putInt("decay_delay", self.decayDelay)

proc sculkCatalystBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = SculkCatalystBlockEntity(self0)
  var nbt = newCompound()
  nbt.putInt("decay_delay", self.decayDelay)
  some(nbt)

proc sculkCatalystBlockEntityVt*(): BlockEntityVt =
  if gSculkCatalystBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = sculkCatalystBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = sculkCatalystBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = sculkCatalystBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = sculkCatalystBlockEntityChunkDataNbt_BlockEntity
    gSculkCatalystBlockEntityVt = v
  gSculkCatalystBlockEntityVt
