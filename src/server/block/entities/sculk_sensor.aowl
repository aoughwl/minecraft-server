## Port of pumpkin/src/block/entities/sculk_sensor.rs
## The `Mutex` fields are plain fields here (one thread writes a world).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:sculk_sensor"

type
  SculkSensorBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    lastVibrationFrequency*: int32

var gSculkSensorBlockEntityVt: nil BlockEntityVt

proc sculkSensorBlockEntityVt*(): BlockEntityVt

proc newSculkSensorBlockEntity*(position: BlockPos): SculkSensorBlockEntity =
  SculkSensorBlockEntity(vt: sculkSensorBlockEntityVt(), position: position, lastVibrationFrequency: 0)

proc sculkSensorBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc sculkSensorBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  SculkSensorBlockEntity(self0).position

proc sculkSensorBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SculkSensorBlockEntity =
  let lastVibrationFrequency = nbt.getInt("last_vibration_frequency").get(0'i32)
  SculkSensorBlockEntity(vt: sculkSensorBlockEntityVt(), position: position, lastVibrationFrequency: lastVibrationFrequency)

proc sculkSensorBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = SculkSensorBlockEntity(self0)
  nbt.putInt("last_vibration_frequency", self.lastVibrationFrequency)

proc sculkSensorBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = SculkSensorBlockEntity(self0)
  var nbt = newCompound()
  nbt.putInt("last_vibration_frequency", self.lastVibrationFrequency)
  some(nbt)

proc sculkSensorBlockEntityVt*(): BlockEntityVt =
  if gSculkSensorBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = sculkSensorBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = sculkSensorBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = sculkSensorBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = sculkSensorBlockEntityChunkDataNbt_BlockEntity
    gSculkSensorBlockEntityVt = v
  gSculkSensorBlockEntityVt
