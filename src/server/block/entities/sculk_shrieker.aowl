import ../blockprelude

const ID*: string = "minecraft:sculk_shrieker"

type
  SculkShriekerBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    warningLevel*: int32

var gSculkShriekerBlockEntityVt: nil BlockEntityVt

proc sculkShriekerBlockEntityVt*(): BlockEntityVt

proc newSculkShriekerBlockEntity*(position: BlockPos): SculkShriekerBlockEntity =
  SculkShriekerBlockEntity(vt: sculkShriekerBlockEntityVt(), position: position, warningLevel: 0)

proc sculkShriekerBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc sculkShriekerBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  SculkShriekerBlockEntity(self0).position

proc sculkShriekerBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SculkShriekerBlockEntity =
  let warningLevel = nbt.getInt("warning_level").get(0'i32)
  SculkShriekerBlockEntity(vt: sculkShriekerBlockEntityVt(), position: position, warningLevel: warningLevel)

proc sculkShriekerBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = SculkShriekerBlockEntity(self0)
  nbt.putInt("warning_level", self.warningLevel)

proc sculkShriekerBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = SculkShriekerBlockEntity(self0)
  var nbt = newCompound()
  nbt.putInt("warning_level", self.warningLevel)
  some(nbt)

proc sculkShriekerBlockEntityVt*(): BlockEntityVt =
  if gSculkShriekerBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = sculkShriekerBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = sculkShriekerBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = sculkShriekerBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = sculkShriekerBlockEntityChunkDataNbt_BlockEntity
    gSculkShriekerBlockEntityVt = v
  gSculkShriekerBlockEntityVt
