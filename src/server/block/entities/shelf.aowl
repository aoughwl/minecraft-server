## Port of pumpkin/src/block/entities/shelf.rs
## The six stacks live in a `ContainerInventory` (containers.aowl): upstream's entity is its own `Inventory`, which a
## `ref object of BlockEntity` cannot also be. `inv.items` and `inv.dirty` are upstream's `items` and `dirty`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 9
const ID*: string = "minecraft:shelf"

type
  ShelfBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory

var gShelfBlockEntityVt: nil BlockEntityVt

proc shelfBlockEntityVt*(): BlockEntityVt

proc asInventory(self: ShelfBlockEntity): Inventory =
  ## The `ContainerInventory` as its base (`Inventory(self.inv)` alone trips the nil analysis).
  let c = self.inv
  if c != nil:
    return Inventory(c)
  Inventory(newArrayInventory(0))

proc newShelfBlockEntity*(position: BlockPos): ShelfBlockEntity =
  let inv = newContainerInventory(INVENTORY_SIZE)
  inv.viewers = nil
  ShelfBlockEntity(vt: shelfBlockEntityVt(), position: position, inv: inv)

proc shelfBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc shelfBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  ShelfBlockEntity(self0).position

proc shelfBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): ShelfBlockEntity =
  let shelf = newShelfBlockEntity(position)
  syncReadItemsFromNbt(nbt, shelf.inv.items)
  shelf

proc shelfBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = ShelfBlockEntity(self0)
  # Write inventory data to NBT
  self.asInventory().writeInventoryNbt(nbt, true)

proc shelfBlockEntityGetInventory_BlockEntity(self0: BlockEntity): Option[Inventory] =
  some(ShelfBlockEntity(self0).asInventory())

proc shelfBlockEntityIsDirty_BlockEntity(self0: BlockEntity): bool =
  ShelfBlockEntity(self0).inv.dirty

proc shelfBlockEntityClearDirty_BlockEntity(self0: BlockEntity) =
  ShelfBlockEntity(self0).inv.dirty = false

proc shelfBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = ShelfBlockEntity(self0)
  var nbt = newCompound()
  syncWriteItemsToNbt(self.inv.items, nbt)
  some(nbt)

proc shelfBlockEntityVt*(): BlockEntityVt =
  if gShelfBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = shelfBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = shelfBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = shelfBlockEntityWriteNbt_BlockEntity
    v.getInventoryImpl = shelfBlockEntityGetInventory_BlockEntity
    v.isDirtyImpl = shelfBlockEntityIsDirty_BlockEntity
    v.clearDirtyImpl = shelfBlockEntityClearDirty_BlockEntity
    v.chunkDataNbtImpl = shelfBlockEntityChunkDataNbt_BlockEntity
    gShelfBlockEntityVt = v
  gShelfBlockEntityVt

proc getStack*(self: ShelfBlockEntity, slot: int): ItemStack =
  self.inv.items[slot]

proc removeStack*(self: ShelfBlockEntity, slot: int): ItemStack =
  self.asInventory().removeStack(slot)

proc removeStackSpecific*(self: ShelfBlockEntity, slot: int, amount: uint8): ItemStack =
  self.asInventory().removeStackSpecific(slot, amount)

proc setStack*(self: ShelfBlockEntity, slot: int, stack: ItemStack) =
  self.asInventory().setStack(slot, stack)
