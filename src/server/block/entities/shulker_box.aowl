## Port of pumpkin/src/block/entities/shulker_box.rs
## The 27 stacks live in a `ContainerInventory` (containers.aowl), the entity's `Inventory`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../containers

const INVENTORY_SIZE*: int = 27
const OPEN_ANIMATION_EVENT_TYPE*: uint8 = 1
const ID*: string = "minecraft:shulker_box"  # TODO support multi IDs

type
  ShulkerBoxBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    inv*: ContainerInventory

var gShulkerBoxBlockEntityVt: nil BlockEntityVt

proc playSound(world: BlockWorld, position: BlockPos, sound: Sound) =
  world.playSoundFine(sound, scBlocks, position.toCenteredF64(), 0.5, (randomOf(float32) * 0.1'f32) + 0.9'f32)

proc onContainerOpen*(self: ShulkerBoxBlockEntity, world: BlockWorld, position: BlockPos) =
  playSound(world, position, sdBlockShulkerBoxOpen)
  # TODO: this.world.emitGameEvent(player, GameEvent.CONTAINER_OPEN, this.pos);

proc onContainerClose*(self: ShulkerBoxBlockEntity, world: BlockWorld, position: BlockPos) =
  playSound(world, position, sdBlockShulkerBoxClose)
  # TODO: this.world.emitGameEvent(player, GameEvent.CONTAINER_CLOSE, this.pos);

proc onViewerCountUpdate*(self: ShulkerBoxBlockEntity, world: BlockWorld, position: BlockPos, old: uint16, new0: uint16) =
  world.addSyncedBlockEvent(position, OPEN_ANIMATION_EVENT_TYPE, uint8(new0 and 255'u16))

proc shulkerResourceLocation(self0: BlockEntity): string =
  ID

proc shulkerGetPosition(self0: BlockEntity): BlockPos =
  ShulkerBoxBlockEntity(self0).position

proc shulkerWriteNbt(self0: BlockEntity, nbt: var NbtCompound) =
  let c = ShulkerBoxBlockEntity(self0).inv
  if c != nil:
    let i = containerAsInventory(c)
    i.writeInventoryNbt(nbt, true)

proc shulkerTick(self0: BlockEntity, world: BlockWorld) =
  let self = ShulkerBoxBlockEntity(self0)
  let c = self.inv
  if c != nil:
    let v = c.viewers
    if v != nil:
      v.updateViewerCount(self, world, self.position)

proc shulkerOnBlockReplaced(self0: BlockEntity, world: BlockWorld, position: BlockPos) =
  # Do nothing
  discard

proc shulkerGetInventory(self0: BlockEntity): Option[Inventory] =
  let c = ShulkerBoxBlockEntity(self0).inv
  if c == nil:
    return none[Inventory]()
  some(Inventory(c))

proc shulkerIsDirty(self0: BlockEntity): bool =
  ShulkerBoxBlockEntity(self0).inv.dirty

proc shulkerClearDirty(self0: BlockEntity) =
  ShulkerBoxBlockEntity(self0).inv.dirty = false

proc shulkerChunkDataNbt(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  syncWriteItemsToNbt(ShulkerBoxBlockEntity(self0).inv.items, nbt)
  some(nbt)

proc shulkerBoxBlockEntityVt*(): BlockEntityVt =
  if gShulkerBoxBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = shulkerResourceLocation
    v.getPositionImpl = shulkerGetPosition
    v.writeNbtImpl = shulkerWriteNbt
    v.tickImpl = shulkerTick
    v.onBlockReplacedImpl = shulkerOnBlockReplaced
    v.getInventoryImpl = shulkerGetInventory
    v.isDirtyImpl = shulkerIsDirty
    v.clearDirtyImpl = shulkerClearDirty
    v.chunkDataNbtImpl = shulkerChunkDataNbt
    gShulkerBoxBlockEntityVt = v
  gShulkerBoxBlockEntityVt

proc newShulkerBoxBlockEntity*(position: BlockPos): ShulkerBoxBlockEntity =
  ShulkerBoxBlockEntity(vt: shulkerBoxBlockEntityVt(), position: position, inv: newContainerInventory(INVENTORY_SIZE))

proc shulkerBoxBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): ShulkerBoxBlockEntity =
  let shulkerBox = newShulkerBoxBlockEntity(position)
  syncReadItemsFromNbt(nbt, shulkerBox.inv.items)
  shulkerBox
