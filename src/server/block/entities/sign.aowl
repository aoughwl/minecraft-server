## Port of pumpkin/src/block/entities/sign.rs
## `Text.messages` is an `Arc<Mutex<[Box<str>; 4]>>` upstream and `AtomicBool`/`AtomicI8` are plain fields here (one thread
## writes a world). `DyeColor::from(..)` and `String::from(DyeColor)` are `dyeColorFromName`, `dyeColorFromI8` and `dyeColorName`.
## `Text.clone` shares the messages upstream; a copy of the array is taken here, and nothing relies on the sharing.
## `currently_editing_player` holds the player's uuid as the text `BlockActor.entityUuid` has.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:sign"

type
  DyeColor* {.pure.} = enum
    White = 0
    Orange = 1
    Magenta = 2
    LightBlue = 3
    Yellow = 4
    Lime = 5
    Pink = 6
    Gray = 7
    LightGray = 8
    Cyan = 9
    Purple = 10
    Blue = 11
    Brown = 12
    Green = 13
    Red = 14
    Black = 15
  Text* = ref object
    hasGlowingText*: bool
    color*: int8
    messages*: array[4, string]
  SignBlockEntity* = ref object of BlockEntity
    frontText*: Text
    backText*: Text
    isWaxed*: bool
    position*: BlockPos
    currentlyEditingPlayer*: Option[string]

var gSignBlockEntityVt: nil BlockEntityVt

proc dyeColorName*(value: DyeColor): string =
  case value
  of DyeColor.White: "white"
  of DyeColor.Orange: "orange"
  of DyeColor.Magenta: "magenta"
  of DyeColor.LightBlue: "light_blue"
  of DyeColor.Yellow: "yellow"
  of DyeColor.Lime: "lime"
  of DyeColor.Pink: "pink"
  of DyeColor.Gray: "gray"
  of DyeColor.LightGray: "light_gray"
  of DyeColor.Cyan: "cyan"
  of DyeColor.Purple: "purple"
  of DyeColor.Blue: "blue"
  of DyeColor.Brown: "brown"
  of DyeColor.Green: "green"
  of DyeColor.Red: "red"
  of DyeColor.Black: "black"

proc dyeColorFromName*(s: string): DyeColor =
  case s
  of "white": DyeColor.White
  of "orange": DyeColor.Orange
  of "magenta": DyeColor.Magenta
  of "light_blue": DyeColor.LightBlue
  of "yellow": DyeColor.Yellow
  of "lime": DyeColor.Lime
  of "pink": DyeColor.Pink
  of "gray": DyeColor.Gray
  of "light_gray": DyeColor.LightGray
  of "cyan": DyeColor.Cyan
  of "purple": DyeColor.Purple
  of "blue": DyeColor.Blue
  of "brown": DyeColor.Brown
  of "green": DyeColor.Green
  of "red": DyeColor.Red
  of "black": DyeColor.Black
  else: DyeColor.Black

proc dyeColorFromI8*(s: int8): DyeColor =
  if s >= 0'i8 and s <= 15'i8:
    DyeColor(int(s))
  else:
    DyeColor.Black

proc dyeColorTag*(value: DyeColor): NbtTag =
  ## `From<DyeColor> for NbtTag`
  NbtTag(kind: ntkByte, byteVal: int8(ord(value)))

proc clone*(self: Text): Text =
  Text(hasGlowingText: self.hasGlowingText, color: self.color, messages: self.messages)

proc defaultText*(): Text =
  Text(hasGlowingText: false, color: int8(ord(DyeColor.Black)), messages: ["", "", "", ""])

proc newText*(messages: array[4, string]): Text =
  Text(hasGlowingText: false, color: int8(ord(DyeColor.Black)), messages: messages)

proc getColor*(self: Text): DyeColor =
  dyeColorFromI8(self.color)

proc setColor*(self: Text, color: DyeColor) =
  self.color = int8(ord(color))

proc textToTag*(value: Text): NbtTag =
  ## `From<Text> for NbtTag`
  var nbt = newCompound()
  nbt.putBool("has_glowing_text", value.hasGlowingText)
  nbt.putString("color", dyeColorName(value.getColor()))
  var list: seq[NbtTag] = @[]
  for m in value.messages:
    list.add(NbtTag(kind: ntkString, stringVal: m))
  nbt.putList("messages", list)
  NbtTag(kind: ntkCompound, compoundVal: nbt)

proc textFromTag*(tag: NbtTag): Text =
  ## `From<NbtTag> for Text`. Upstream unwraps the compound and the list; a malformed tag gives the default text here.
  let compound = tag.extractCompound()
  if compound.isNone:
    return defaultText()
  let nbt = compound.unsafeGet
  let hasGlowingText = nbt.getBool("has_glowing_text").get(false)
  let color = nbt.getString("color").get("black")
  var messages: seq[string] = @[]
  let list = nbt.getList("messages")
  if list.isSome:
    for t in list.unsafeGet:
      let s = t.extractString()
      if s.isSome:
        messages.add(s.unsafeGet)
  var padded = ["", "", "", ""]
  for i in 0 ..< 4:
    if i < messages.len:
      padded[i] = messages[i]
  Text(hasGlowingText: hasGlowingText, color: int8(ord(dyeColorFromName(color))), messages: padded)

proc signBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc signBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  SignBlockEntity(self0).position

proc signBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = SignBlockEntity(self0)
  nbt.put("front_text", textToTag(self.frontText.clone()))
  nbt.put("back_text", textToTag(self.backText.clone()))
  nbt.putBool("is_waxed", self.isWaxed)

proc signBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = SignBlockEntity(self0)
  var nbt = newCompound()
  nbt.put("front_text", textToTag(self.frontText.clone()))
  nbt.put("back_text", textToTag(self.backText.clone()))
  nbt.putBool("is_waxed", self.isWaxed)
  some(nbt)

proc signBlockEntityVt*(): BlockEntityVt =
  if gSignBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = signBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = signBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = signBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = signBlockEntityChunkDataNbt_BlockEntity
    gSignBlockEntityVt = v
  gSignBlockEntityVt

proc newSignBlockEntity*(position: BlockPos, isFront: bool, messages: array[4, string]): SignBlockEntity =
  let front = if isFront: newText(messages) else: defaultText()
  let back = if isFront: defaultText() else: newText(messages)
  SignBlockEntity(vt: signBlockEntityVt(), position: position, isWaxed: false, frontText: front, backText: back,
    currentlyEditingPlayer: none[string]())

proc emptySignBlockEntity*(position: BlockPos): SignBlockEntity =
  SignBlockEntity(vt: signBlockEntityVt(), position: position, isWaxed: false, frontText: defaultText(),
    backText: defaultText(), currentlyEditingPlayer: none[string]())

proc signBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SignBlockEntity =
  let front = nbt.get("front_text")
  let back = nbt.get("back_text")
  let frontText = if front[0]: textFromTag(front[1]) else: defaultText()
  let backText = if back[0]: textFromTag(back[1]) else: defaultText()
  let isWaxed = nbt.getBool("is_waxed").get(false)
  SignBlockEntity(vt: signBlockEntityVt(), position: position, frontText: frontText, backText: backText, isWaxed: isWaxed,
    currentlyEditingPlayer: none[string]())
