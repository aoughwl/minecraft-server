## Port of pumpkin/src/block/entities/skull.rs
## The `Mutex<Option<..>>` fields are plain options here: one thread writes a world, and `try_lock` always succeeds.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:skull"

type
  SkullBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    noteBlockSound*: Option[string]
    profile*: Option[NbtCompound]

var gSkullBlockEntityVt: nil BlockEntityVt

proc skullBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc skullBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  SkullBlockEntity(self0).position

proc skullBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = SkullBlockEntity(self0)
  if self.noteBlockSound.isSome:
    nbt.putString("note_block_sound", self.noteBlockSound.unsafeGet)
  if self.profile.isSome:
    nbt.putCompound("profile", self.profile.unsafeGet)

proc skullBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = SkullBlockEntity(self0)
  var nbt = newCompound()
  if self.noteBlockSound.isSome:
    nbt.putString("note_block_sound", self.noteBlockSound.unsafeGet)
  if self.profile.isSome:
    nbt.putCompound("profile", self.profile.unsafeGet)
  some(nbt)

proc skullBlockEntityVt*(): BlockEntityVt =
  if gSkullBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = skullBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = skullBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = skullBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = skullBlockEntityChunkDataNbt_BlockEntity
    gSkullBlockEntityVt = v
  gSkullBlockEntityVt

proc newSkullBlockEntity*(position: BlockPos): SkullBlockEntity =
  SkullBlockEntity(vt: skullBlockEntityVt(), position: position, noteBlockSound: none[string](), profile: none[NbtCompound]())

proc skullBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SkullBlockEntity =
  SkullBlockEntity(vt: skullBlockEntityVt(), position: position, noteBlockSound: nbt.getString("note_block_sound"),
    profile: nbt.getCompound("profile"))
