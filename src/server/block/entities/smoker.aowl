## Port of pumpkin/src/block/entities/smoker.rs
## `SmokerBlockEntity` over the shared `FurnaceLikeBlockEntity` (furnace_like_block_entity.aowl).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import ../../../generated/recipes
import furnace_like_block_entity

const INVENTORY_SIZE*: int = 3
const ID*: string = "minecraft:smoker"

type
  SmokerBlockEntity* = FurnaceLikeBlockEntity
    ## One type for the three: a second level of `ref object` under `BlockEntity` trips the compiler's code generator (see
    ## chest.aowl). `id` tells them apart.

var gSmokerBlockEntityVt: nil BlockEntityVt

proc smokerBlockEntityVt*(): BlockEntityVt =
  if gSmokerBlockEntityVt == nil:
    gSmokerBlockEntityVt = newFurnaceLikeBlockEntityVt()
  gSmokerBlockEntityVt

proc newSmokerBlockEntity*(position: BlockPos): SmokerBlockEntity =
  result = FurnaceLikeBlockEntity()
  initFurnaceLike(result, smokerBlockEntityVt(), position, ID, crkSmoking, INVENTORY_SIZE)

proc smokerBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): SmokerBlockEntity =
  let e = newSmokerBlockEntity(position)
  readFurnaceLikeNbt(e, nbt)
  e
