## Port of pumpkin/src/block/entities/structure_block.rs
## The `Mutex` fields are plain fields here (one thread writes a world). The entity only holds the settings the client sends:
## nothing in this tree saves or loads a structure with it, as upstream.

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:structure_block"

type
  StructureBlockBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    name*: string
    author*: string
    metadata*: string
    posX*: int32
    posY*: int32
    posZ*: int32
    sizeX*: int32
    sizeY*: int32
    sizeZ*: int32
    rotation*: string
    mirror*: string
    mode*: string
    ignoreEntities*: bool
    showAir*: bool
    showBoundingBox*: bool
    integrity*: float32
    seed*: int64

var gStructureBlockBlockEntityVt: nil BlockEntityVt

proc structureBlockBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc structureBlockBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  StructureBlockBlockEntity(self0).position

proc putStructureData(self: StructureBlockBlockEntity, nbt: var NbtCompound) =
  nbt.putString("name", self.name)
  nbt.putString("author", self.author)
  nbt.putString("metadata", self.metadata)
  nbt.putInt("posX", self.posX)
  nbt.putInt("posY", self.posY)
  nbt.putInt("posZ", self.posZ)
  nbt.putInt("sizeX", self.sizeX)
  nbt.putInt("sizeY", self.sizeY)
  nbt.putInt("sizeZ", self.sizeZ)
  nbt.putString("rotation", self.rotation)
  nbt.putString("mirror", self.mirror)
  nbt.putString("mode", self.mode)
  nbt.putBool("ignoreEntities", self.ignoreEntities)
  nbt.putBool("showAir", self.showAir)
  nbt.putBool("showBoundingBox", self.showBoundingBox)
  nbt.putFloat("integrity", self.integrity)
  nbt.putLong("seed", self.seed)

proc structureBlockBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  StructureBlockBlockEntity(self0).putStructureData(nbt)

proc structureBlockBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  var nbt = newCompound()
  StructureBlockBlockEntity(self0).putStructureData(nbt)
  some(nbt)

proc structureBlockBlockEntityVt*(): BlockEntityVt =
  if gStructureBlockBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = structureBlockBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = structureBlockBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = structureBlockBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = structureBlockBlockEntityChunkDataNbt_BlockEntity
    gStructureBlockBlockEntityVt = v
  gStructureBlockBlockEntityVt

proc newStructureBlockBlockEntity*(position: BlockPos): StructureBlockBlockEntity =
  StructureBlockBlockEntity(vt: structureBlockBlockEntityVt(), position: position, name: "", author: "", metadata: "",
    posX: 0, posY: 0, posZ: 0, sizeX: 0, sizeY: 0, sizeZ: 0, rotation: "NONE", mirror: "NONE", mode: "DATA",
    ignoreEntities: true, showAir: false, showBoundingBox: true, integrity: 1.0'f32, seed: 0'i64)

proc structureBlockBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): StructureBlockBlockEntity =
  StructureBlockBlockEntity(vt: structureBlockBlockEntityVt(), position: position,
    name: nbt.getString("name").get(""), author: nbt.getString("author").get(""), metadata: nbt.getString("metadata").get(""),
    posX: nbt.getInt("posX").get(0'i32), posY: nbt.getInt("posY").get(0'i32), posZ: nbt.getInt("posZ").get(0'i32),
    sizeX: nbt.getInt("sizeX").get(0'i32), sizeY: nbt.getInt("sizeY").get(0'i32), sizeZ: nbt.getInt("sizeZ").get(0'i32),
    rotation: nbt.getString("rotation").get("NONE"), mirror: nbt.getString("mirror").get("NONE"),
    mode: nbt.getString("mode").get("DATA"), ignoreEntities: nbt.getBool("ignoreEntities").get(true),
    showAir: nbt.getBool("showAir").get(false), showBoundingBox: nbt.getBool("showBoundingBox").get(true),
    integrity: nbt.getFloat("integrity").get(1.0'f32), seed: nbt.getLong("seed").get(0'i64))
