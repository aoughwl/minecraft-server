import ../blockprelude

const ID*: string = "minecraft:test_block"

type
  TestBlockBlockEntity* = ref object of BlockEntity
    position*: BlockPos

var gTestBlockBlockEntityVt: nil BlockEntityVt

proc testBlockBlockEntityVt*(): BlockEntityVt

proc newTestBlockBlockEntity*(position: BlockPos): TestBlockBlockEntity =
  TestBlockBlockEntity(vt: testBlockBlockEntityVt(), position: position)

proc testBlockBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc testBlockBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  TestBlockBlockEntity(self0).position

proc testBlockBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): TestBlockBlockEntity =
  TestBlockBlockEntity(vt: testBlockBlockEntityVt(), position: position)

proc testBlockBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  discard

proc testBlockBlockEntityVt*(): BlockEntityVt =
  if gTestBlockBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = testBlockBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = testBlockBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = testBlockBlockEntityWriteNbt_BlockEntity
    gTestBlockBlockEntityVt = v
  gTestBlockBlockEntityVt
