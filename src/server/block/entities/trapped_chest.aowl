## Port of pumpkin/src/block/entities/trapped_chest.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import chest_like_block_entity
export chest_like_block_entity

const ID*: string = "minecraft:trapped_chest"
const EMITS_REDSTONE*: bool = true

type
  TrappedChestBlockEntity* = ChestLikeBlockEntity
    ## See chest.aowl: the same type, told apart by `id`.

proc newTrappedChestBlockEntity*(position: BlockPos): TrappedChestBlockEntity =
  let chest = ChestLikeBlockEntity()
  initChestLike(chest, position, true)
  chest

proc trappedChestBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): TrappedChestBlockEntity =
  let chest = newTrappedChestBlockEntity(position)
  readChestLike(chest, nbt)
  chest
