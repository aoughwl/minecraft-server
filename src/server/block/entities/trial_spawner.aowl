  let self = TrialSpawnerBlockEntity(self0)
  var nbt = newCompound()
  let t4 = self.normalConfig.tryLock()
  let t5 = t4.value
  if t4.isOk and t5.isSome:
    let cfg = t4.value
    let cfg = t5.unsafeGet
