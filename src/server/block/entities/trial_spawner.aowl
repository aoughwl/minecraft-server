## The `Mutex` fields are plain fields here (one thread writes a world).

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:trial_spawner"

type
  TrialSpawnerBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    normalConfig*: Option[NbtCompound]
    ominousConfig*: Option[NbtCompound]
    spawnerData*: Option[NbtCompound]

var gTrialSpawnerBlockEntityVt: nil BlockEntityVt

proc trialSpawnerBlockEntityVt*(): BlockEntityVt

proc newTrialSpawnerBlockEntity*(position: BlockPos): TrialSpawnerBlockEntity =
  TrialSpawnerBlockEntity(vt: trialSpawnerBlockEntityVt(), position: position, normalConfig: none[NbtCompound](), ominousConfig: none[NbtCompound](), spawnerData: none[NbtCompound]())

proc trialSpawnerBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  ID

proc trialSpawnerBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  TrialSpawnerBlockEntity(self0).position

proc trialSpawnerBlockEntityFromNbt_BlockEntity*(nbt: var NbtCompound, position: BlockPos): TrialSpawnerBlockEntity =
  let normalConfig = nbt.getCompound("normal_config")
  let ominousConfig = nbt.getCompound("ominous_config")
  let spawnerData = nbt.getCompound("spawner_data")
  TrialSpawnerBlockEntity(vt: trialSpawnerBlockEntityVt(), position: position, normalConfig: normalConfig, ominousConfig: ominousConfig, spawnerData: spawnerData)

proc trialSpawnerBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = TrialSpawnerBlockEntity(self0)
  if self.normalConfig.isSome:
    nbt.putCompound("normal_config", self.normalConfig.unsafeGet)
  if self.ominousConfig.isSome:
    nbt.putCompound("ominous_config", self.ominousConfig.unsafeGet)
  if self.spawnerData.isSome:
    nbt.putCompound("spawner_data", self.spawnerData.unsafeGet)

proc trialSpawnerBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = TrialSpawnerBlockEntity(self0)
  var nbt = newCompound()
  if self.normalConfig.isSome:
    nbt.putCompound("normal_config", self.normalConfig.unsafeGet)
  if self.ominousConfig.isSome:
    nbt.putCompound("ominous_config", self.ominousConfig.unsafeGet)
  if self.spawnerData.isSome:
    nbt.putCompound("spawner_data", self.spawnerData.unsafeGet)
  some(nbt)

proc trialSpawnerBlockEntityVt*(): BlockEntityVt =
  if gTrialSpawnerBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = trialSpawnerBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = trialSpawnerBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = trialSpawnerBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = trialSpawnerBlockEntityChunkDataNbt_BlockEntity
    gTrialSpawnerBlockEntityVt = v
  gTrialSpawnerBlockEntityVt
