  if t6.isOk and t7.isSome:
    let cfg = t6.value
    let cfg = t7.unsafeGet
    nbt.putCompound("ominous_config", t7.unsafeGet)
  let t8 = self.spawnerData.tryLock()
  let t9 = t8.value
  if t8.isOk and t9.isSome:
    let data = t8.value
    let data = t9.unsafeGet
    nbt.putCompound("spawner_data", t9.unsafeGet)
  some(nbt)

