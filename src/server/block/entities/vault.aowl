## Port of pumpkin/src/block/entities/vault.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude

const ID*: string = "minecraft:vault"

type
  VaultBlockEntity* = ref object of BlockEntity
    position*: BlockPos
    config*: Option[NbtCompound]
    serverData*: Option[NbtCompound]

var gVaultBlockEntityVt: nil BlockEntityVt


proc vaultBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string
proc vaultBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos
proc vaultBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): VaultBlockEntity
proc vaultBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound)
proc vaultBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound]
proc vaultBlockEntityVt*(): BlockEntityVt
proc newVaultBlockEntity*(position: BlockPos): VaultBlockEntity

proc vaultBlockEntityResourceLocation_BlockEntity(self0: BlockEntity): string =
  let self = VaultBlockEntity(self0)
  ID

proc vaultBlockEntityGetPosition_BlockEntity(self0: BlockEntity): BlockPos =
  let self = VaultBlockEntity(self0)
  self.position

proc vaultBlockEntityFromNbt_BlockEntity(nbt: var NbtCompound, position: BlockPos): VaultBlockEntity =
  VaultBlockEntity(position: position, config: nbt.getCompound("config"), serverData: nbt.getCompound("server_data"))

proc vaultBlockEntityWriteNbt_BlockEntity(self0: BlockEntity, nbt: var NbtCompound) =
  let self = VaultBlockEntity(self0)
  let t1 = self.config
  if t1.isSome:
    let cfg = t1.unsafeGet
    nbt.putCompound("config", t1.unsafeGet)
  let t2 = self.serverData
  if t2.isSome:
    let data = t2.unsafeGet
    nbt.putCompound("server_data", t2.unsafeGet)

proc vaultBlockEntityChunkDataNbt_BlockEntity(self0: BlockEntity): Option[NbtCompound] =
  let self = VaultBlockEntity(self0)
  var nbt = newCompound()
  let t3 = self.config.tryLock()
  let t4 = t3.value
  if t3.isOk and t4.isSome:
    let cfg = t3.value
    let cfg = t4.unsafeGet
    nbt.putCompound("config", t4.unsafeGet)
  let t5 = self.serverData.tryLock()
  let t6 = t5.value
  if t5.isOk and t6.isSome:
    let data = t5.value
    let data = t6.unsafeGet
    nbt.putCompound("server_data", t6.unsafeGet)
  some(nbt)

proc vaultBlockEntityVt*(): BlockEntityVt =
  if gVaultBlockEntityVt == nil:
    let v = newBlockEntityVt()
    v.resourceLocationImpl = vaultBlockEntityResourceLocation_BlockEntity
    v.getPositionImpl = vaultBlockEntityGetPosition_BlockEntity
    v.writeNbtImpl = vaultBlockEntityWriteNbt_BlockEntity
    v.chunkDataNbtImpl = vaultBlockEntityChunkDataNbt_BlockEntity
    gVaultBlockEntityVt = v
  gVaultBlockEntityVt

proc newVaultBlockEntity*(position: BlockPos): VaultBlockEntity =
  VaultBlockEntity(position: position, config: Mutex.constNew(R2A_NONE), serverData: Mutex.constNew(R2A_NONE))

