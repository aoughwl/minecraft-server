type
  FlowingFluidProperties* = FlowingWaterLikeFluidProperties
  FluidFuture* = T
  FlowingFluid* = ref object
    getLevelDecreasePerBlockImpl*: proc(self: FlowingFluid, world: BlockWorld): int32 {.closure.}
    getFlowSpeedImpl*: proc(self: FlowingFluid, world: BlockWorld): uint8 {.closure.}
    getSourceImpl*: proc(self: FlowingFluid, fluid: Fluid, falling: bool): FlowingFluidProperties {.closure.}
    getFlowingImpl*: proc(self: FlowingFluid, fluid: Fluid, level: Level, falling: bool): FlowingFluidProperties {.closure.}
    getMaxFlowDistanceImpl*: proc(self: FlowingFluid, world: BlockWorld): int32 {.closure.}
    canConvertToSourceImpl*: proc(self: FlowingFluid, world: BlockWorld): bool {.closure.}
    hasFluidAtImpl*: proc(self: FlowingFluid, fluid: Fluid, stateId: BlockStateId): bool {.closure.}
    getEffectivePropsImpl*: proc(self: FlowingFluid, fluid: Fluid, stateId: BlockStateId): Option[FlowingFluidProperties] {.closure.}
    onScheduledTickInternalImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos) {.closure.}
    tryFlowImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos, props: FlowingFluidProperties) {.closure.}
    countSourceNeighborsImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): int32 {.closure.}
    getNewLiquidImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): Option[FlowingFluidProperties] {.closure.}
    applySpreadImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos, stateId: BlockStateId, newProps: FlowingFluidProperties) {.closure.}
    checkInfiniteSourceFormationImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos): bool {.closure.}
    spreadToImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos, stateId: BlockStateId) {.closure.}
    flowToSidesImpl*: proc(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos, props: FlowingFluidProperties) {.closure.}



