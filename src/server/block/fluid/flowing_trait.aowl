proc newFlowingFluid*(): FlowingFluid =
  result = FlowingFluid()
  result.getSourceImpl = defaultGetSource_FlowingFluid
  result.getFlowingImpl = defaultGetFlowing_FlowingFluid
  result.hasFluidAtImpl = defaultHasFluidAt_FlowingFluid
  result.getEffectivePropsImpl = defaultGetEffectiveProps_FlowingFluid
  result.onScheduledTickInternalImpl = defaultOnScheduledTickInternal_FlowingFluid
  result.tryFlowImpl = defaultTryFlow_FlowingFluid
  result.countSourceNeighborsImpl = defaultCountSourceNeighbors_FlowingFluid
  result.getNewLiquidImpl = defaultGetNewLiquid_FlowingFluid
  result.applySpreadImpl = defaultApplySpread_FlowingFluid
  result.checkInfiniteSourceFormationImpl = defaultCheckInfiniteSourceFormation_FlowingFluid
  result.spreadToImpl = defaultSpreadTo_FlowingFluid
  result.flowToSidesImpl = defaultFlowToSides_FlowingFluid

