proc defaultGetSource_FlowingFluid(self: FlowingFluid, fluid: Fluid, falling: bool): FlowingFluidProperties =
  var sourceProps = FlowingFluidProperties.defaultFor(fluid)
  sourceProps.level = Level.L8
  let t1 = block:
    if falling:
      Falling.True
    else:
      Falling.False
  sourceProps.falling = t1
  sourceProps

proc defaultGetFlowing_FlowingFluid(self: FlowingFluid, fluid: Fluid, level: Level, falling: bool): FlowingFluidProperties =
  var flowingProps = FlowingFluidProperties.defaultFor(fluid)
  flowingProps.level = level
  let t2 = block:
    if falling:
      Falling.True
    else:
      Falling.False
  flowingProps.falling = t2
  flowingProps

proc defaultHasFluidAt_FlowingFluid(self: FlowingFluid, fluid: Fluid, stateId: BlockStateId): bool =
  self.getEffectiveProps(fluid, stateId).isSome()

proc defaultGetEffectiveProps_FlowingFluid(self: FlowingFluid, fluid: Fluid, stateId: BlockStateId): Option[FlowingFluidProperties] =
  var t4 = false
  for s in fluid.states:
    if (s.blockStateId == stateId):
      t4 = true
      break
  if t4:
    return some(FlowingFluidProperties.fromStateId(stateId, fluid))
  if ((fluid.id == Fluid.FLOWING_WATER.id) or (fluid.id == Fluid.WATER.id)):
    let blockRef = Block.fromStateId(stateId)
    if blockRef.isWaterlogged(stateId):
      return some(self.getSource(fluid, false))
  none[FlowingFluidProperties]()

proc defaultOnScheduledTickInternal_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos) =
  let t5 = block:
    # let block = world.get_block(block_pos);
    let currentBlockStateId = world.getBlockStateId(blockPos)
    let blockRef = Block.fromStateId(currentBlockStateId)
    if (not self.hasFluidAt(fluid, currentBlockStateId)):
      return
    let waterlogged = blockRef.isWaterlogged(currentBlockStateId)
    let currentFluidState = self.getEffectiveProps(fluid, currentBlockStateId).get()
    let isSource = ((currentFluidState.level == Level.L8) and (currentFluidState.falling != Falling.True))
    var stateForSpreading: FlowingFluidProperties
    # Update state if non-source
    if (not isSource) and (not waterlogged):
      let newFluidState = self.getNewLiquid(world, fluid, blockPos)
      let t6 = newFluidState
      if t6.isSome:
        let newState = t6.unsafeGet
        let newStateId = t6.unsafeGet.toStateId(fluid)
        if (newStateId != currentBlockStateId):
          discard world.setBlockState(blockPos, newStateId, BfNotifyAll)
          # Schedule next tick for this position
          let tickDelay = self.getFlowSpeed(world)
          world.scheduleFluidTick(fluid, blockPos, tickDelay, tpNormal)
        # Use the new state for spreading
        stateForSpreading = t6.unsafeGet
      else:
        if (not waterlogged):
          discard world.setBlockState(blockPos, blockAir().defaultState.id, BfNotifyAll)
        return
    else:
      # Sources use their current state
      stateForSpreading = currentFluidState
    # Then, spread using the appropriate state
    self.tryFlow(world, fluid, blockPos, stateForSpreading)
  t5

proc defaultTryFlow_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos, props: FlowingFluidProperties) =
  let t7 = block:
    let belowPos = blockPos.down()
    let belowState = world.getBlockState(belowPos)
    let belowBlock = Block.fromStateId(belowState.id)
    let isHole = canBeReplaced(belowState, belowBlock, fluid)
    # Try to flow down first
    if isHole:
      let fallingProps = self.getFlowing(fluid, Level.L8, true)
      self.spreadTo(world, fluid, belowPos, fallingProps.toStateId(fluid))
      # Check if we should also spread to sides
      if (props.level == Level.L8) and (props.falling == Falling.False):
        let sourceCount = self.countSourceNeighbors(world, fluid, blockPos)
        if (sourceCount >= 3):
          self.flowToSides(world, fluid, blockPos, props)
      return
    # Check if fluid should flow to the side(s)
    self.flowToSides(world, fluid, blockPos, props)
  t7

proc defaultCountSourceNeighbors_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): int32 =
  let t8 = block:
    var count = 0
    for direction in [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]:
      let neighborPos = blockPos.offset(direction.toOffset())
      let neighborId = world.getBlockStateId(neighborPos)
      let t9 = self.getEffectiveProps(fluid, neighborId)
      var t10 = false
      if t9.isSome:
        let p = t9.unsafeGet
        t10 = ((p.level == Level.L8) and (p.falling == Falling.False))
      if t10:
        count += 1
    count
  t8

proc defaultGetNewLiquid_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): Option[FlowingFluidProperties] =
  let t11 = block:
    let currentStateId = world.getBlockStateId(blockPos)
    let currentProps = FlowingFluidProperties.fromStateId(currentStateId, fluid)
    # Sources never change
    if (currentProps.level == Level.L8) and (currentProps.falling != Falling.True):
      return some(currentProps)
    # First: check horizontal neighbors for infinite source formation
    var highestNeighbor = 0
    var neighborSourceCount = 0
    for direction in [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]:
      let neighborPos = blockPos.offset(direction.toOffset())
      let neighborStateId = world.getBlockStateId(neighborPos)
      let t12 = self.getEffectiveProps(fluid, neighborStateId)
      if not (t12.isSome):
        continue
      let neighborProps = t12.unsafeGet
      # Count horizontal non-falling sources for infinite source formation
      if (neighborProps.level == Level.L8) and (neighborProps.falling == Falling.False):
        neighborSourceCount += 1
      # Falling water from the side counts as level 8
      let t13 = block:
        if (neighborProps.falling == Falling.True):
          8
        else:
          (int32(neighborProps.level.toIndex()) + 1)
      let neighborLevel = t13
      highestNeighbor = highestNeighbor.max(neighborLevel)
    # Attempt infinite source formation first
    if self.canConvertToSource(world) and (neighborSourceCount >= 2):
      let belowPos = blockPos.down()
      let belowState = world.getBlockState(belowPos)
      let belowStateId = belowState.id
      # Check if block below is a stable source of the same fluid
      let t14 = self.getEffectiveProps(fluid, belowStateId)
      var t15 = false
      if t14.isSome:
        let p = t14.unsafeGet
        t15 = ((p.level == Level.L8) and (p.falling == Falling.False))
      let belowIsSameSource = t15
      # If the block below is solid (solid block) or a source of same fluid, form a source here.
      if (belowIsSameSource or belowState.isSolidBlock()):
        return some(self.getSource(fluid, false))
    # Then: if there's water above, this block is ALWAYS level 8, falling=true
    let abovePos = blockPos.up()
    let aboveStateId = world.getBlockStateId(abovePos)
    if self.hasFluidAt(fluid, aboveStateId):
      return some(self.getFlowing(fluid, Level.L8, true))
    # Standard flowing calculation
    let dropOff = self.getLevelDecreasePerBlock(world)
    let newLevel = (highestNeighbor - dropOff)
    if (newLevel <= 0):
      none[FlowingFluidProperties]()
    else:
      some(self.getFlowing(fluid, Level.fromIndex((uint16(newLevel) - 1)), false))
  t11

proc defaultApplySpread_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos, stateId: BlockStateId, newProps: FlowingFluidProperties) =
  let t16 = block:
    let currentStateId = world.getBlockStateId(pos)
    let t17 = self.getEffectiveProps(fluid, currentStateId)
    if t17.isSome:
      let currentProps = t17.unsafeGet
      let currentLevel = (int32(t17.unsafeGet.level.toIndex()) + 1)
      let newLevel = (int32(newProps.level.toIndex()) + 1)
      let currentIsSource = ((t17.unsafeGet.level == Level.L8) and (t17.unsafeGet.falling == Falling.False))
      let newIsSource = ((newProps.level == Level.L8) and (newProps.falling == Falling.False))
      # Never overwrite a source with anything
      if currentIsSource:
        return
      # Check for infinite source formation before quiescence checks
      if (not currentIsSource) and self.canConvertToSource(world):
        let shouldConvert = self.checkInfiniteSourceFormation(world, fluid, pos)
        if shouldConvert:
          let sourceProps = self.getSource(fluid, false)
          let sourceStateId = sourceProps.toStateId(fluid)
          discard world.setBlockState(pos, sourceStateId, BfNotifyAll)
          # Sources don't need ticks
          return
      # If new is a source, always accept it
      if newIsSource:
        discard
      elif (t17.unsafeGet.falling == newProps.falling):
        # Same falling state - check level
        if (newLevel <= currentLevel):
          return
    else:
      # Replace non-fluid blocks
      let blockRef = world.getBlock(pos)
      if (blockRef.id != blockAir().id):
        discard world.breakBlock(pos, nil, BfNotifyAll)
    discard world.setBlockState(pos, stateId, BfNotifyAll)
    # Check for infinite source formation after placing new fluid
    if self.canConvertToSource(world):
      let shouldConvert1 = self.checkInfiniteSourceFormation(world, fluid, pos)
      if shouldConvert1:
        let sourceProps2 = self.getSource(fluid, false)
        let sourceStateId3 = sourceProps2.toStateId(fluid)
        discard world.setBlockState(pos, sourceStateId3, BfNotifyAll)
        # Sources don't need ticks
        return
    # Only schedule tick if not a source
    let isSource = ((newProps.level == Level.L8) and (newProps.falling == Falling.False))
    if (not isSource):
      let tickDelay = self.getFlowSpeed(world)
      world.scheduleFluidTick(fluid, pos, tickDelay, tpNormal)
  t16

proc defaultCheckInfiniteSourceFormation_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos): bool =
  let t18 = block:
    # Count adjacent horizontal source blocks
    var sourceCount = 0
    for direction in [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]:
      let neighborPos = pos.offset(direction.toOffset())
      let neighborStateId = world.getBlockStateId(neighborPos)
      let t19 = self.getEffectiveProps(fluid, neighborStateId)
      var t20 = false
      if t19.isSome:
        let p = t19.unsafeGet
        t20 = ((p.level == Level.L8) and (p.falling == Falling.False))
      if t20:
        sourceCount += 1
    # Need at least 2 source neighbors
    if (sourceCount < 2):
      return false
    # Check the block below
    let belowPos = pos.down()
    let belowState = world.getBlockState(belowPos)
    let belowStateId = belowState.id
    # Check if block below is a stable source of the same fluid
    let t21 = self.getEffectiveProps(fluid, belowStateId)
    var t22 = false
    if t21.isSome:
      let p = t21.unsafeGet
      t22 = ((p.level == Level.L8) and (p.falling == Falling.False))
    let belowIsSameSource = t22
    # Convert to source if below is solid or a source of same fluid
    (belowIsSameSource or belowState.isSolidBlock())
  t18

proc defaultSpreadTo_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos, stateId: BlockStateId) =
  let t23 = block:
    let newProps = FlowingFluidProperties.fromStateId(stateId, fluid)
    self.applySpread(world, fluid, pos, stateId, newProps)
  t23

proc defaultFlowToSides_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, blockPos: BlockPos, props: FlowingFluidProperties) =
  let t24 = block:
    let dropOff = self.getLevelDecreasePerBlock(world)
    let currentLevel = (int32(props.level.toIndex()) + 1)
    let t25 = block:
      if (props.falling == Falling.True):
        7
      else:
        (currentLevel - dropOff)
    let effectiveLevel = t25
    if (effectiveLevel <= 0):
      return
    let (spreadDirs, count) = getSpread(self, world, fluid, blockPos)
    let t26 = spreadDirs.take(count)
    for direction, stateId in t26:
      let sidePos = blockPos.offset(direction.toOffset())
      self.spreadTo(world, fluid, sidePos, stateId)
  t24

