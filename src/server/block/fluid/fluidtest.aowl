## Water and lava flow, through the real registry over testworld.aowl, with the fluid tick queue run by hand. Known answers
## are worked out from the Rust (pumpkin/src/block/fluid/*.rs) and vanilla: water spreads seven blocks over a flat floor, one
## level less per block; a source over a hole falls; two sources with a solid floor beside a gap make a third; lava
## beside a water source turns to obsidian; flowing lava met by water turns to cobblestone.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../blockprelude
import ../testworld
import water, lava
from ../../../world/worldinfo import defaultLevelData, LevelData

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED ", what
    quit(1)

proc newRegistry(): BlockRegistry =
  result = newBlockRegistry()
  registerFluidWater(result)
  registerFluidLava(result)

proc at(x, y, z: int32): BlockPos = blockPos(x, y, z)

proc newWorld(): TestWorld =
  result = newTestWorld(newRegistry())
  result.world.levelInfo0 = proc(): LevelData {.closure.} = defaultLevelData(0'u64)
  # a stone floor at y = 63, 41 x 41
  for x in -20'i32 .. 20'i32:
    for z in -20'i32 .. 20'i32:
      result.put(at(x, 63, z), blockStone())

proc nameAt(t: TestWorld; x, y, z: int32): string =
  t.world.getBlock(at(x, y, z)).name

proc place(t: TestWorld; pos: BlockPos; blockRef: Block) =
  ## `world.set_block_state(pos, block.default_state, NOTIFY_ALL)`: what `/setblock` and a bucket do.
  discard t.world.setBlockState(pos, blockRef.defaultState.id, BfNotifyAll)

proc flatFlow() =
  let t = newWorld()
  t.place(at(0, 64, 0), blockWater())
  t.run(80)
  var seen: seq[BlockStateId] = @[]
  for i in 0'i32 .. 7'i32:
    check(t.nameAt(i, 64, 0) == "water", "water " & $i & " blocks from the source")
    seen.add(t.world.getBlockStateId(at(i, 64, 0)))
  check(t.nameAt(8, 64, 0) == "air", "no water 8 blocks from the source")
  for i in 0 ..< seen.len:
    for j in i + 1 ..< seen.len:
      check(seen[i] != seen[j], "levels " & $i & " and " & $j & " differ")
  check(seen[0] == blockWater().defaultState.id, "the source is still the default state")
  # the diamond: (3, 64, 4) is 7 away, (4, 64, 4) is 8 away
  check(t.nameAt(3, 64, 4) == "water", "the diamond reaches 7 away")
  check(t.nameAt(4, 64, 4) == "air", "and no further")
  echo "flat flow passed"

proc fallingWater() =
  let t = newWorld()
  for y in 64'i32 .. 66'i32:
    t.put(at(0, y, 0), blockStone())
  t.place(at(0, 67, 0), blockWater())
  t.run(80)
  for y in 64'i32 .. 67'i32:
    check(t.nameAt(1, y, 0) == "water", "the falling column at y=" & $y)
  check(t.nameAt(2, 64, 0) == "water", "spreads on the floor under the fall")
  echo "falling water passed"

proc infiniteSource() =
  let t = newWorld()
  t.place(at(0, 64, 0), blockWater())
  t.place(at(2, 64, 0), blockWater())
  t.run(40)
  check(t.world.getBlockStateId(at(1, 64, 0)) == blockWater().defaultState.id, "the gap between two sources is a source")
  echo "infinite source passed"

proc lavaMeetsWater() =
  let t = newWorld()
  t.place(at(0, 64, 0), blockLava())
  t.run(5)
  t.place(at(1, 64, 0), blockWater())
  t.run(80)
  check(t.nameAt(0, 64, 0) == "obsidian", "a lava source beside water is obsidian, got " & t.nameAt(0, 64, 0))
  echo "lava source and water passed"

proc lavaFlows() =
  let t = newWorld()
  t.place(at(0, 64, 0), blockLava())
  t.run(200)
  for i in 0'i32 .. 3'i32:
    check(t.nameAt(i, 64, 0) == "lava", "lava " & $i & " blocks from the source")
  check(t.nameAt(4, 64, 0) == "air", "lava does not flow past 3 blocks")
  t.place(at(5, 64, 0), blockWater())
  t.run(200)
  var cobble = false
  for i in 1'i32 .. 5'i32:
    if t.nameAt(i, 64, 0) == "cobblestone":
      cobble = true
  check(cobble, "water meeting flowing lava makes cobblestone")
  echo "lava flow passed"

flatFlow()
fallingWater()
infiniteSource()
lavaMeetsWater()
lavaFlows()
echo "fluid checks passed"
