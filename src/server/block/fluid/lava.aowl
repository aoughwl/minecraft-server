proc canSpreadFireAround*(world: BlockWorld, pos: BlockPos): bool =
  let spreadRadius = world.levelInfo.gameRules.fireSpreadRadiusAroundPlayer
  if (spreadRadius == 0):
    return false
  if (spreadRadius == (-1)):
    return true
  world.getClosestPlayer(pos.toCenteredF64(), float64(spreadRadius)).isSome()

proc isFlammableState*(blockState: BlockState): bool =
  let blockRef = Block.fromStateId(blockState.id)
  if blockRef.isWaterlogged(blockState.id):
    return false
  let t1 = blockRef.flammable
  var t2 = false
  if t1.isSome:
    let flammable = t1.unsafeGet
    t2 = (flammable.burnChance > 0)
  t2

proc isFlammable*(world: BlockWorld, pos: BlockPos): bool =
  world.getBlockStateIfLoaded(pos).isSomeAnd(isFlammableState)

proc hasFlammableNeighbours*(world: BlockWorld, pos: BlockPos): bool =
  var t4 = false
  for dir in blockDirectionAll():
    if isFlammable(world, pos.offset(dir.toOffset())):
      t4 = true
      break
  t4

proc canResolveFireStateWithoutLoading*(world: BlockWorld, pos: BlockPos): bool =
  if ((not world.isLoaded(pos)) or (not world.isLoaded(pos.down()))):
    return false
  var t6 = true
  for dir in blockDirectionAll():
    if not (world.isLoaded(pos.offset(dir.toOffset()))):
      t6 = false
      break
  t6

proc igniteFireIfPossible*(world: BlockWorld, pos: BlockPos) =
  if (not canResolveFireStateWithoutLoading(world, pos)):
    return
  let fireStateId = FireBlock.getStateForPosition(world, blockFire(), pos)
  discard world.setBlockState(pos, fireStateId, BfNotifyAll)

proc receiveNeighborFluids*(world: BlockWorld, fluid: Fluid, blockPos: BlockPos): bool =
  # Logic to determine if we should replace the fluid with any of (cobble, obsidian, stone, etc.)
  let belowIsSoulSoil = (world.getBlock(blockPos.offset(BlockDirection.Down.toOffset())) == blockSoulSoil())
  let isStill = (world.getBlockStateId(blockPos) == blockLava().defaultState.id)
  let t7 = blockDirectionAll()
  for dir in t7:
    let neighborPos = blockPos.offset(dir.toOffset())
    if (world.getBlock(neighborPos) == blockWater()):
      if (dir == BlockDirection.Down):
        return true
      let t8 = block:
        if isStill:
          blockObsidian()
        else:
          blockCobblestone()
      let blockRef = t8
      discard world.setBlockState(blockPos, blockRef.defaultState.id, BfNotifyNeighbors)
      world.syncWorldEvent(weLavaFizz, blockPos, 0)
      return false
    if belowIsSoulSoil and (world.getBlock(neighborPos) == blockBlueIce()):
      discard world.setBlockState(blockPos, blockBasalt().defaultState.id, BfNotifyNeighbors)
      world.syncWorldEvent(weLavaFizz, blockPos, 0)
      return false
  true

proc flowingLavaPlaced_FluidBehaviour(world: BlockWorld, fluid: Fluid, stateId: BlockStateId, blockPos: BlockPos, oldStateId: BlockStateId, notify: bool) =
  if (not (oldStateId == stateId)) and receiveNeighborFluids(world, fluid, blockPos):
    let flowSpeed = getFlowSpeed(flowingLavaAsFlowingFluid(), world)
    world.scheduleFluidTick(fluid, blockPos, flowSpeed, tpNormal)

proc flowingLavaOnScheduledTick_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos) =
  onScheduledTickInternal(flowingLavaAsFlowingFluid(), world, fluid, blockPos)

proc flowingLavaOnNeighborUpdate_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos, notify: bool) =
  if receiveNeighborFluids(world, fluid, blockPos):
    let flowSpeed = getFlowSpeed(flowingLavaAsFlowingFluid(), world)
    world.scheduleFluidTick(fluid, blockPos, flowSpeed, tpNormal)

proc flowingLavaOnEntityCollision_FluidBehaviour(entity: BlockActor) =
  let baseEntity = entity.getEntity()
  if (not baseEntity.entityType.fireImmune) and (not baseEntity.fireImmune):
    entity.setOnFireFor(15.0)
    # Also apply lava damage
    baseEntity.damage(entity, 4.0, DamageType.LAVA)

proc flowingLavaRandomTick_FluidBehaviour(fluid: Fluid, world: BlockWorld, blockPos: BlockPos) =
  if (not canSpreadFireAround(world, blockPos)):
    return
  let passes = randomRange(0 ..< 3)
  if (passes > 0):
    var testPos = blockPos
    for _ in 0 ..< passes:
      testPos = testPos.offset(newVector3(randomRange((-1) .. 1), 1, randomRange((-1) .. 1)))
      if (not world.isLoaded(testPos)):
        return
      let t9 = world.getBlockStateIfLoaded(testPos)
      if not (t9.isSome):
        return
      let blockState = t9.unsafeGet
      if blockState.isAir():
        if hasFlammableNeighbours(world, testPos):
          igniteFireIfPossible(world, testPos)
          return
      elif blocksMovement(blockState, blockState.id.toBlockId()):
        return
  else:
    for _ in 0 ..< 3:
      let testPos1 = blockPos.offset(newVector3(randomRange((-1) .. 1), 0, randomRange((-1) .. 1)))
      if (not world.isLoaded(testPos1)):
        return
      let abovePos = testPos1.up()
      if (not world.isLoaded(abovePos)):
        return
      if world.getBlockStateIfLoaded(abovePos).isSomeAnd(isAir) and isFlammable(world, testPos1):
        igniteFireIfPossible(world, abovePos)

proc newFlowingLava*(): FluidBehaviour =
  result = newFluidBehaviour()
  result.placedImpl = flowingLavaPlaced_FluidBehaviour
  result.onScheduledTickImpl = flowingLavaOnScheduledTick_FluidBehaviour
  result.onNeighborUpdateImpl = flowingLavaOnNeighborUpdate_FluidBehaviour
  result.onEntityCollisionImpl = flowingLavaOnEntityCollision_FluidBehaviour
  result.randomTickImpl = flowingLavaRandomTick_FluidBehaviour

proc flowingLavaGetLevelDecreasePerBlock_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32 =
  # Ultrawarm logic
  if (world.dimension == Dimension.THE_NETHER):
    1
  else:
    2

proc flowingLavaGetFlowSpeed_FlowingFluid(self: FlowingFluid, world: BlockWorld): uint8 =
  # Ultrawarm logic - lava flows faster in the Nether
  if (world.dimension == Dimension.THE_NETHER):
    LAVA_FLOW_SPEED_NETHER
  else:
    LAVA_FLOW_SPEED_SLOW

proc flowingLavaGetMaxFlowDistance_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32 =
  # Ultrawarm logic
  if (world.dimension == Dimension.THE_NETHER):
    5
  else:
    3

proc flowingLavaCanConvertToSource_FlowingFluid(self: FlowingFluid, world: BlockWorld): bool =
  world.levelInfo.gameRules.lavaSourceConversion

proc flowingLavaSpreadTo_FlowingFluid(self: FlowingFluid, world: BlockWorld, fluid: Fluid, pos: BlockPos, stateId: BlockStateId) =
  let newProps = FlowingFluidProperties.fromStateId(stateId, fluid)
  let currentStateId = world.getBlockStateId(pos)
  let blockRef = Block.fromStateId(currentStateId)
  if (newProps.level == Level.L8) and (newProps.falling == Falling.True):
    # Stone creation when lava meets water
    if (blockRef == blockWater()):
      discard world.setBlockState(pos, blockStone().defaultState.id, BfNotifyAll)
      world.syncWorldEvent(weLavaFizz, pos, 0)
      return
  # Don't flow into waterlogged blocks
  if blockRef.isWaterlogged(currentStateId):
    return
  # Delegate quiescence, replacement and scheduling to the shared helper
  applySpread(flowingLavaAsFlowingFluid(), world, fluid, pos, stateId, newProps)

proc flowingLavaAsFlowingFluid*(): FlowingFluid =
  if gFlowingLavaAsFlowingFluid == nil:
    let v = newFlowingFluid()
    v.getLevelDecreasePerBlockImpl = flowingLavaGetLevelDecreasePerBlock_FlowingFluid
    v.getFlowSpeedImpl = flowingLavaGetFlowSpeed_FlowingFluid
    v.getMaxFlowDistanceImpl = flowingLavaGetMaxFlowDistance_FlowingFluid
    v.canConvertToSourceImpl = flowingLavaCanConvertToSource_FlowingFluid
    v.spreadToImpl = flowingLavaSpreadTo_FlowingFluid
    gFlowingLavaAsFlowingFluid = v
  gFlowingLavaAsFlowingFluid

proc registerFluidLava*(r: BlockRegistry) =
  r.registerIds(flowingLavaIds(), newFlowingLava())

