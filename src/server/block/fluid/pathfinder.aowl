## Port of pumpkin/src/block/fluid/pathfinder.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import flowing_trait
import physics


type
  PathNode* = object
    pos*: BlockPos
    distance*: int32
    excludeDir*: BlockDirection



proc isHole*(world: BlockWorld, fluid: Fluid, pos: BlockPos): bool
proc getSpread*(fluidImpl: T, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): (array[4, (BlockDirection, BlockStateId)], int)
proc getInFlowDownDistanceIterative*(fluidImpl: T, world: BlockWorld, fluid: Fluid, startPos: BlockPos, initialExcludeDir: BlockDirection): int32

proc isHole*(world: BlockWorld, fluid: Fluid, pos: BlockPos): bool =
  let belowPos = pos.down()
  let belowState = world.getBlockState(belowPos)
  let belowBlock = Block.fromStateId(belowState.id)
  canBeReplaced(belowState, belowBlock, fluid)

proc getSpread*(fluidImpl: T, world: BlockWorld, fluid: Fluid, blockPos: BlockPos): (array[4, (BlockDirection, BlockStateId)], int) =
  var minDist = 1000
  var result0 = R2A_MANUAL("array repeat")
  var resultCount = 0
  for direction in [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]:
    let sidePos = blockPos.offset(direction.toOffset())
    let sideState = world.getBlockState(sidePos)
    let sideStateId = sideState.id
    let sideBlock = Block.fromStateId(sideState.id)
    let sideFluidProps = fluidImpl.getEffectiveProps(fluid, sideStateId)
    # Check if we can pass through (not a solid source block or waterlogged)
    let t1 = sideFluidProps
    var t2 = false
    if t1.isSome:
      let p = t1.unsafeGet
      t2 = ((p.level == Level.L8) and (p.falling != Falling.True))
    if ((not canBeReplaced(sideState, sideBlock, fluid)) or t2):
      continue
    # Skip if no valid fluid state for this position
    let t3 = fluidImpl.getNewLiquid(world, fluid, sidePos)
    if not (t3.isSome):
      continue
    let newFluidProps = t3.unsafeGet
    let newStateId = newFluidProps.toStateId(fluid)
    # Holes get distance 0
    let t4 = block:
      if isHole(world, fluid, sidePos):
        0
      else:
        getInFlowDownDistanceIterative(fluidImpl, world, fluid, sidePos, direction.opposite())
    let slopeDist = t4
    # Clear results if we find a shorter path
    if (slopeDist < minDist):
      resultCount = 0
    # Add all directions with equal minimum distance
    if (slopeDist <= minDist):
      # Check if the fluid at this position can be replaced
      let t6 = sideFluidProps
      var t7 = true
      if t6.isSome:
        let sp = t6.unsafeGet
        let t5 = block:
          # Can replace if new level is higher or if target is falling
          let targetLevel = (int32(sp.level.toIndex()) + 1)
          let newLevel = (int32(newFluidProps.level.toIndex()) + 1)
          ((newLevel > targetLevel) or (sp.falling == Falling.True))
        t7 = t5
      let canReplace = t7
      if canReplace and (resultCount < 4):
        result0[resultCount] = (direction, newStateId)
        resultCount += 1
      minDist = slopeDist
  (result0, resultCount)

proc getInFlowDownDistanceIterative*(fluidImpl: T, world: BlockWorld, fluid: Fluid, startPos: BlockPos, initialExcludeDir: BlockDirection): int32 =
  const MAX_QUEUE_SIZE: int = 64
  var queue: array[MAX_QUEUE_SIZE, PathNode] = R2A_MANUAL("array repeat")
  var queueStart = 0
  var queueEnd = 0
  queue[queueEnd] = PathNode(pos: startPos, distance: 1, excludeDir: initialExcludeDir)
  queueEnd = 1
  var visitedBitset = R2A_MANUAL("array repeat")
  let slopeFindDistance = fluidImpl.getMaxFlowDistance(world)
  let getBitIndex = R2A_MANUAL("closure |pos| t10")
  while (queueStart < queueEnd):
    let node = queue[queueStart]
    queueStart += 1
    if (node.distance > slopeFindDistance):
      continue
    let t11 = getBitIndex(node.pos)
    if t11.isSome:
      let bitIdx = t11.unsafeGet
      let wordIdx = (t11.unsafeGet / 64)
      let bitPos = (t11.unsafeGet mod 64)
      if (((visitedBitset[wordIdx] and ((1'u64 shl bitPos)))) != 0):
        continue
      visitedBitset[wordIdx] = visitedBitset[wordIdx] or (1'u64 shl bitPos)
    # Check for hole (downward flow opportunity)
    let belowPos = node.pos.down()
    let belowState = world.getBlockState(belowPos)
    let belowBlock = Block.fromStateId(belowState.id)
    if canBeReplaced(belowState, belowBlock, fluid):
      return node.distance
    for direction in [BlockDirection.North, BlockDirection.South, BlockDirection.West, BlockDirection.East]:
      if (direction == node.excludeDir):
        continue
      let nextPos = node.pos.offset(direction.toOffset())
      let nextState = world.getBlockState(nextPos)
      let nextBlock = Block.fromStateId(nextState.id)
      if (not canBeReplaced(nextState, nextBlock, fluid)):
        continue
      # Source blocks (including waterlogged) block horizontal pathfinding
      let nextStateId = world.getBlockStateId(nextPos)
      let t12 = fluidImpl.getEffectiveProps(fluid, nextStateId)
      var t13 = false
      if t12.isSome:
        let p = t12.unsafeGet
        t13 = ((p.level == Level.L8) and (p.falling == Falling.False))
      if t13:
        continue
      if (queueEnd < MAX_QUEUE_SIZE):
        queue[queueEnd] = PathNode(pos: nextPos, distance: (node.distance + 1), excludeDir: direction.opposite())
        queueEnd += 1
  1000

