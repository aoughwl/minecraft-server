import ../blockprelude




proc canBeReplaced*(blockState: BlockState, blockRef: Block, fluid: Fluid): bool

proc canBeReplaced*(blockState: BlockState, blockRef: Block, fluid: Fluid): bool =
  # Waterlogged blocks should not be replaced by water
  if blockRef.isWaterlogged(blockState.id):
    return false
  # Fluid Logic
  let t1 = Fluid.fromStateId(blockState.id)
  if t1.isSome:
    let otherFluid = t1.unsafeGet
    if (not fluid.matchesType(t1.unsafeGet)):
      return true
    # Replace current fluid if it is a falling source
    if t1.unsafeGet.isSource(blockState.id) and t1.unsafeGet.isFalling(blockState.id):
      return true
  let id = blockRef.id
  # Blocks that fluid should never replace
  if (blockRef.hasTag(Block_MINECRAFT_DOORS) or (((((((((((((((((((((blockRef.hasTag(Block_MINECRAFT_BEDS) or blockRef.hasTag(Block_MINECRAFT_LEAVES)) or blockRef.hasTag(Block_MINECRAFT_PRESSURE_PLATES)) or blockRef.hasTag(Block_C_CLUSTERS)) or blockRef.hasTag(Block_MINECRAFT_WALL_CORALS)) or blockRef.hasTag(Block_MINECRAFT_SHULKER_BOXES)) or blockRef.hasTag(Block_MINECRAFT_PORTALS)) or (id == blockBell().id)) or (id == blockBigDripleaf().id)) or (id == blockBigDripleafStem().id)) or (id == blockSmallDripleaf().id)) or (id == blockCake().id)) or (id == blockConduit().id)) or (id == blockCampfire().id)) or (id == blockDragonEgg().id)) or (id == blockKelp().id)) or (id == blockKelpPlant().id)) or (id == blockSeagrass().id)) or (id == blockTallSeagrass().id)) or (id == blockLadder().id)) or (id == blockPointedDripstone().id)) or (id == blockScaffolding().id))):
    return false
  # Only replace air, explicitly replaceable blocks, or carpets
  (((blockState.replaceable() or (id == blockAir().id)) or blockRef.hasTag(Block_MINECRAFT_WOOL_CARPETS)) or (blockState.pistonBehavior == PistonBehavior.Destroy))

