## Port of pumpkin/src/block/fluid/water.rs

{.feature: "untyped".}
{.feature: "lenientnils".}

import ../blockprelude
import flowtype
import flowing_trait

const WATER_FLOW_SPEED: uint8 = 5

type
  FlowingWater* = object

var gFlowingWaterAsFlowingFluid: FlowingFluid = nil


proc flowingWaterIds*(): seq[uint16]
proc flowingWaterPlaced_FluidBehaviour(world: BlockWorld, fluid: Fluid, stateId: BlockStateId, blockPos: BlockPos, oldStateId: BlockStateId, notify: bool)
proc flowingWaterOnScheduledTick_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos)
proc flowingWaterOnNeighborUpdate_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos, notify: bool)
proc flowingWaterOnEntityCollision_FluidBehaviour(entity: BlockActor)
proc newFlowingWater*(): FluidBehaviour
proc flowingWaterGetLevelDecreasePerBlock_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32
proc flowingWaterGetFlowSpeed_FlowingFluid(self: FlowingFluid, world: BlockWorld): uint8
proc flowingWaterGetMaxFlowDistance_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32
proc flowingWaterCanConvertToSource_FlowingFluid(self: FlowingFluid, world: BlockWorld): bool
proc flowingWaterAsFlowingFluid*(): FlowingFluid

proc flowingWaterIds*(): seq[uint16] =
  @[Fluid.FLOWING_WATER.id]

proc flowingWaterPlaced_FluidBehaviour(world: BlockWorld, fluid: Fluid, stateId: BlockStateId, blockPos: BlockPos, oldStateId: BlockStateId, notify: bool) =
  if (not (oldStateId == stateId)):
    world.scheduleFluidTick(fluid, blockPos, WATER_FLOW_SPEED, tpNormal)

proc flowingWaterOnScheduledTick_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos) =
  onScheduledTickInternal(flowingWaterAsFlowingFluid(), world, fluid, blockPos)

proc flowingWaterOnNeighborUpdate_FluidBehaviour(world: BlockWorld, fluid: Fluid, blockPos: BlockPos, notify: bool) =
  # Avoid rescheduling a fluid tick if one is already queued.
  if (not world.isFluidTickScheduled(blockPos, fluid)):
    world.scheduleFluidTick(fluid, blockPos, WATER_FLOW_SPEED, tpNormal)

proc flowingWaterOnEntityCollision_FluidBehaviour(entity: BlockActor) =
  entity.getEntity().extinguish()

proc newFlowingWater*(): FluidBehaviour =
  result = newFluidBehaviour()
  result.placedImpl = flowingWaterPlaced_FluidBehaviour
  result.onScheduledTickImpl = flowingWaterOnScheduledTick_FluidBehaviour
  result.onNeighborUpdateImpl = flowingWaterOnNeighborUpdate_FluidBehaviour
  result.onEntityCollisionImpl = flowingWaterOnEntityCollision_FluidBehaviour

proc flowingWaterGetLevelDecreasePerBlock_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32 =
  1

proc flowingWaterGetFlowSpeed_FlowingFluid(self: FlowingFluid, world: BlockWorld): uint8 =
  WATER_FLOW_SPEED

proc flowingWaterGetMaxFlowDistance_FlowingFluid(self: FlowingFluid, world: BlockWorld): int32 =
  4

proc flowingWaterCanConvertToSource_FlowingFluid(self: FlowingFluid, world: BlockWorld): bool =
  world.levelInfo.gameRules.waterSourceConversion

proc flowingWaterAsFlowingFluid*(): FlowingFluid =
  if gFlowingWaterAsFlowingFluid == nil:
    let v = newFlowingFluid()
    v.getLevelDecreasePerBlockImpl = flowingWaterGetLevelDecreasePerBlock_FlowingFluid
    v.getFlowSpeedImpl = flowingWaterGetFlowSpeed_FlowingFluid
    v.getMaxFlowDistanceImpl = flowingWaterGetMaxFlowDistance_FlowingFluid
    v.canConvertToSourceImpl = flowingWaterCanConvertToSource_FlowingFluid
    gFlowingWaterAsFlowingFluid = v
  gFlowingWaterAsFlowingFluid

proc registerFluidWater*(r: BlockRegistry) =
  r.registerFluidIds(flowingWaterIds(), newFlowingWater())

