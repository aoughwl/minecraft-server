## The furnace, smoker and blast furnace entities (entities/furnace_like_block_entity.aowl) over a `TestWorld`: a smelt as
## worked out from `impl_block_entity_for_cooking!` (200 ticks a raw iron, one coal is 1600 ticks of fire, half of that and
## half the cooking time in a smoker or blast furnace), the lit state written into the world, the experience of
## `RecipesUsed` and what a save writes and a load reads back.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import containers
import ../../inventory/window_property
import ../../generated/recipes
import blocks/[furnace, smoker, blast_furnace]
import testworld
import entities/[entitiesmod, furnace_like_block_entity, furnace, smoker, blasting_furnace]

proc stack(key: string; count: uint8): ItemStack =
  let item = Item.fromRegistryKey(key)
  if item == nil:
    quit(1)
  newItemStack(count, item)

proc asInv(c: ContainerInventory): Inventory =
  if c == nil:
    quit(1)
  Inventory(c)

proc litTotalOf(e: BlockEntity): uint16 =
  FurnaceLikeBlockEntity(e).inv.litTotalTime

proc lit(t: TestWorld; pos: BlockPos): bool =
  let (b, s) = t.world.getBlockAndState(pos)
  FurnaceLikeProperties.fromStateId(s.id, b).lit

proc run() =
  let reg = newBlockRegistry()
  registerBlocksFurnace(reg)
  registerBlocksSmoker(reg)
  registerBlocksBlastFurnace(reg)
  assert reg.unknown.len == 0
  assert reg.getPumpkinBlock(blockFurnace().id).isSome
  assert reg.getPumpkinBlock(blockSmoker().id).isSome
  assert reg.getPumpkinBlock(blockBlastFurnace().id).isSome
  let pos = newBlockPos(10, 64, 10)
  let t = newTestWorld(reg)
  t.put(pos, blockFurnace())
  let f = newFurnaceBlockEntity(pos)
  let fe = BlockEntity(f)
  assert fe.resourceLocation() == "minecraft:furnace"
  t.world.addBlockEntity(fe)
  let inv = asInv(f.inv)

  # The recipes: raw iron is smelted to an ingot in 200 ticks.
  let recipe = cookingRecipeFor(stack("raw_iron", 1'u8), crkSmelting)
  assert recipe.isSome and recipe.unsafeGet.cookingTime == 200
  assert cookingRecipeFor(stack("raw_iron", 1'u8), crkSmoking).isNone
  assert cookingRecipeFor(stack("stick", 1'u8), crkSmelting).isNone

  # Setting the input sets the total time; nothing happens without fuel.
  inv.setStack(0, stack("raw_iron", 3'u8))
  assert f.getCookingTotalTime() == 200'u16
  fe.tick(t.world)
  assert not f.isBurning()
  assert not lit(t, pos)
  inv.setStack(1, stack("coal", 1'u8))
  fe.tick(t.world)
  assert f.isBurning()
  assert f.getLitTotalTime() == 1600'u16
  assert f.getLitTimeRemaining() == 1600'u16
  assert f.getCookingTimeSpent() == 1'u16
  assert inv.getStack(1).isEmpty()
  assert lit(t, pos)
  # property delegate: fire icon, max fuel, progress, max progress
  let d = fe.toPropertyDelegate().unsafeGet
  assert d.getProperty(0) == 1600
  assert d.getProperty(1) == 1600
  assert d.getProperty(2) == 1
  assert d.getProperty(3) == 200
  assert d.getPropertiesSize() == 4

  for i in 0 ..< 199:
    fe.tick(t.world)
  assert inv.getStack(2).itemCount == 1'u8
  assert inv.getStack(2).item.registryKey == "iron_ingot"
  assert inv.getStack(0).itemCount == 2'u8
  assert f.getCookingTimeSpent() == 0'u16
  for i in 0 ..< 400:
    fe.tick(t.world)
  assert inv.getStack(2).itemCount == 3'u8
  assert inv.getStack(0).isEmpty()

  # Experience: 3 ingots at 0.7 each is 2.1, floored; taking it empties the map.
  let xp = fe.toExperienceContainer().unsafeGet
  var saved = newCompound()
  fe.writeNbt(saved)
  assert saved.getCompound("RecipesUsed").isSome
  assert saved.getShort("lit_total_time").unsafeGet == 1600'i16
  let back = furnaceBlockEntityFromNbt_BlockEntity(saved, pos)
  assert back.inv.items[2].itemCount == 3'u8
  assert back.inv.litTimeRemaining == f.inv.litTimeRemaining
  assert back.inv.cookingTotalTime == 200'u16
  assert BlockEntity(back).toExperienceContainer().unsafeGet.extractExperience() == 2'i32
  assert xp.extractExperience() == 2'i32
  assert xp.extractExperience() == 0'i32
  assert f.inv.recipesUsed.len == 0

  # The fire burns out and the lit state goes with it.
  assert lit(t, pos)
  for i in 0 ..< 1100:
    fe.tick(t.world)
  assert not f.isBurning()
  assert not lit(t, pos)

  # A full output slot stops the smelt: the progress is reset.
  let g = newFurnaceBlockEntity(pos)
  let ginv = asInv(g.inv)
  ginv.setStack(0, stack("raw_iron", 1'u8))
  ginv.setStack(1, stack("coal", 1'u8))
  ginv.setStack(2, stack("iron_ingot", 64'u8))
  BlockEntity(g).tick(t.world)
  assert not g.isBurning()

  # A smoker halves the fuel and a blast furnace halves the fuel and the time, and each takes its own recipes.
  let sm = newSmokerBlockEntity(pos)
  assert BlockEntity(sm).resourceLocation() == "minecraft:smoker"
  asInv(sm.inv).setStack(0, stack("beef", 1'u8))
  asInv(sm.inv).setStack(1, stack("coal", 1'u8))
  assert sm.getCookingTotalTime() == 100'u16
  BlockEntity(sm).tick(t.world)
  assert sm.getLitTotalTime() == 800'u16
  let bf = newBlastingFurnaceBlockEntity(pos)
  assert BlockEntity(bf).resourceLocation() == "minecraft:blast_furnace"
  asInv(bf.inv).setStack(0, stack("raw_iron", 1'u8))
  asInv(bf.inv).setStack(1, stack("coal", 1'u8))
  assert bf.getCookingTotalTime() == 100'u16
  BlockEntity(bf).tick(t.world)
  assert bf.getLitTotalTime() == 800'u16
  # A smoker does not smelt iron.
  let sm2 = newSmokerBlockEntity(pos)
  asInv(sm2.inv).setStack(0, stack("raw_iron", 1'u8))
  assert sm2.getCookingTotalTime() == 0'u16

  # The entities are in the tables: a chunk load finds them.
  var snbt = newCompound()
  BlockEntity(sm).writeNbt(snbt)
  put(snbt, "id", NbtTag(kind: ntkString, stringVal: "minecraft:smoker"))
  put(snbt, "x", NbtTag(kind: ntkInt, intVal: pos.vec.x))
  put(snbt, "y", NbtTag(kind: ntkInt, intVal: pos.vec.y))
  put(snbt, "z", NbtTag(kind: ntkInt, intVal: pos.vec.z))
  let loaded = blockEntityFromNbt(snbt)
  assert loaded.isSome
  assert litTotalOf(loaded.unsafeGet) == 800'u16
  echo "furnacetest ok"

run()
