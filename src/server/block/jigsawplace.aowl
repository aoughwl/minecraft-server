## `JigsawBlockEntity::generate` and `place_structure` of pumpkin/src/block/entities/jigsaw_block.rs: the half that runs
## `JigsawPlacement::add_pieces` and writes the pieces' templates into the world. A block module must not import the
## structure generator, so entities/jigsaw_block.aowl stops at `gJigsawGenerateHook` and this module, imported by
## worldhooks.aowl, fills it.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/options
import blockprelude
import entities/jigsaw_block
from ../../data/block_state import newBlockStateIdUnchecked
import ../../util/xoroshiro128
import ../../util/random/random
import ../../world/generation/structure/structures/[structuresmod, jigsaw, jigsaw_placement]
import "../../world/generation/structure/template/block_state_resolver"
import "../../world/generation/structure/template/structure_template"

proc placeStructure(self: JigsawBlockEntity; world: BlockWorld; structure: StructurePosition; keepJigsaws: bool) =
  ## `place_structure`
  let pieces = structure.collector.pieces
  for piece in pieces:
    if not (piece of PoolElementStructurePiece):
      continue
    let poolPiece = PoolElementStructurePiece(piece)
    let origin = poolPiece.pos
    let rotation = poolPiece.rotation
    let visits = forEachTemplate(poolPiece.element)
    for visit in visits:
      let template0 = visit.structureTemplate
      for block0 in template0.blocks:
        let paletteEntry = template0.palette[int(block0.state)]
        if paletteEntry.name == "minecraft:structure_void":
          continue
        if not keepJigsaws and paletteEntry.name == "minecraft:jigsaw":
          var finalStateStr = "minecraft:air"
          if block0.hasNbt:
            let fs = block0.nbt.getString("final_state")
            if fs.isSome:
              finalStateStr = fs.unsafeGet
          let entry = paletteEntryFromString(finalStateStr)
          let (resolved, resolvedId) = resolve(entry, rotation, Mirror.None)
          let finalState = if resolved: newBlockStateIdUnchecked(uint16(resolvedId)) else: blockAir().defaultState.id
          let localPos = rotation.transformPos(block0.pos, template0.size)
          let worldPos = origin.add(localPos.x, localPos.y, localPos.z)
          discard world.setBlockState(worldPos, finalState, BfNotifyAll)
          continue
        let (found, stateId) = resolve(paletteEntry, rotation, Mirror.None)
        if not found:
          continue
        let localPos = rotation.transformPos(block0.pos, template0.size)
        let worldPos = origin.add(localPos.x, localPos.y, localPos.z)
        discard world.setBlockState(worldPos, newBlockStateIdUnchecked(uint16(stateId)), BfNotifyAll)
        # Handle block entities
        if block0.hasNbt:
          var blockEntityNbt = block0.nbt
          blockEntityNbt.putInt("x", worldPos.vec.x)
          blockEntityNbt.putInt("y", worldPos.vec.y)
          blockEntityNbt.putInt("z", worldPos.vec.z)
          let make = world.blockEntityFromNbt0
          if make != nil:
            let blockEntity = make(blockEntityNbt)
            if blockEntity.isSome:
              world.addBlockEntity(blockEntity.unsafeGet)

proc generateJigsaw(world: BlockWorld; self: JigsawBlockEntity; levels: int32; keepJigsaws: bool) =
  ## `generate`
  let pool = self.pool
  let target = self.target
  let blockState = world.getBlockState(self.position)
  let props = JigsawLikeProperties.fromStateId(blockState.id, blockJigsaw())
  let (front, top) = toFrontTop(props.orientation)
  let position = self.position.offset(front.toOffset())
  let chunk = self.position.chunkPosition()
  var context = StructureGeneratorContext(seed: world.worldSeed(), chunkX: chunk.x, chunkZ: chunk.y,
    random: toRandomGenerator(fromSeed(getSeed())), seaLevel: 63'i32, minY: -64'i32, height: 384'i32, heightSampler: nil,
    hasStructureKey: false)
  var aliasRandom = context.random
  let structure = addPieces(context, pool, true, target, levels, position, false, false, newMaxDistance(80'i32),
    DimensionPadding(top: 0, bottom: 0), LiquidSettings.ApplyWaterlog, poolAliasLookupFromBindings(@[], aliasRandom))
  if structure != nil:
    placeStructure(self, world, structure, keepJigsaws)

gJigsawGenerateHook = generateJigsaw
