## Port of pumpkin/src/block/registry.rs: `default_registry`.
## PARTIAL: pumpkin/src/block/registry.rs - registers only the behaviours that compile and have been checked: redstone without the crafter, dispenser and dropper, and the blocks the tests use. Every other `manager.register` line waits on its file, which says PARTIAL at its top. The dispatch half is in blockbehaviour.aowl; `place_block` is block_place.aowl, which does not call this yet.

import blockbehaviour
import blocks/[barrier, chain, mangrove_roots]
import blocks/redstone/[bell, buttons, comparator, copper_bulb, daylight_detector, lever, lightning_rod, observer,
  redstone_block, redstone_lamp, redstone_ore, redstone_torch, redstone_wire, repeater, sculk_sensor, target_block,
  tripwire, tripwire_hook]
import blocks/redstone/pressure_plate/[plate, weighted]
import blocks/redstone/rails/[activator_rail, detector_rail, powered_rail, rail]

proc defaultRegistry*(): BlockRegistry =
  ## `default_registry`
  result = newBlockRegistry()
  registerBlocksBarrier(result)
  registerBlocksChain(result)
  registerBlocksMangroveRoots(result)
  registerBlocksRedstoneBell(result)
  registerBlocksRedstoneButtons(result)
  registerBlocksRedstoneComparator(result)
  registerBlocksRedstoneCopperBulb(result)
  registerBlocksRedstoneDaylightDetector(result)
  registerBlocksRedstoneLever(result)
  registerBlocksRedstoneLightningRod(result)
  registerBlocksRedstoneObserver(result)
  registerBlocksRedstoneRedstoneBlock(result)
  registerBlocksRedstoneRedstoneLamp(result)
  registerBlocksRedstoneRedstoneOre(result)
  registerBlocksRedstoneRedstoneTorch(result)
  registerBlocksRedstoneRedstoneWire(result)
  registerBlocksRedstoneRepeater(result)
  registerBlocksRedstoneSculkSensor(result)
  registerBlocksRedstoneTargetBlock(result)
  registerBlocksRedstoneTripwire(result)
  registerBlocksRedstoneTripwireHook(result)
  registerBlocksRedstonePressurePlatePlate(result)
  registerBlocksRedstonePressurePlateWeighted(result)
  registerBlocksRedstoneRailsActivatorRail(result)
  registerBlocksRedstoneRailsDetectorRail(result)
  registerBlocksRedstoneRailsPoweredRail(result)
  registerBlocksRedstoneRailsRail(result)
