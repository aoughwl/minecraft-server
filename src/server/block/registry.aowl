## Port of pumpkin/src/block/registry.rs: `default_registry`.
## PARTIAL: pumpkin/src/block/registry.rs - registers what compiles and has been read against upstream: the redstone blocks but the crafter, dispenser and dropper; doors, trapdoors, fences, fence gates, slabs, stairs, walls, panes, bars, torches, lanterns, carpets, ladders, farmland, grass, paths, falling blocks and water. Every other `manager.register` line waits on its file, which says PARTIAL at its top (`grep -rl 'machine translation' src/server/block`). The dispatch half is in blockbehaviour.aowl; `place_block` is block_place.aowl and calls this; worldmod.aowl builds the world's `BlockWorld` from it (worldadapter.aowl).

import blockbehaviour
import blocks/[barrier, chain, mangrove_roots]
import blocks/[nether_portal, end_portal]
import blocks/redstone/[bell, buttons, comparator, copper_bulb, daylight_detector, lever, lightning_rod, observer,
  redstone_block, redstone_lamp, redstone_ore, redstone_torch, redstone_wire, repeater, sculk_sensor, target_block,
  tripwire, tripwire_hook]
import blocks/redstone/pressure_plate/[plate, weighted]
import blocks/redstone/rails/[activator_rail, detector_rail, powered_rail, rail]
import "blocks/doors"
import "blocks/trapdoor"
import "blocks/fences"
import "blocks/fence_gates"
import "blocks/slabs"
import "blocks/stairs"
import "blocks/walls"
import "fluid/water"
import "blocks/torches"
import "blocks/glass_panes"
import "blocks/iron_bars"
import "blocks/ladder"
import "blocks/lanterns"
import "blocks/carpet"
import "blocks/farmland"
import "blocks/falling"
import "blocks/grass_block"
import "blocks/dirt_path"
import "blocks/end_rod"
import "blocks/logs"
import "blocks/glazed_terracotta"

proc defaultRegistry*(): BlockRegistry =
  ## `default_registry`
  result = newBlockRegistry()
  registerBlocksBarrier(result)
  registerBlocksChain(result)
  registerBlocksMangroveRoots(result)
  registerBlocksNetherPortal(result)
  registerBlocksEndPortal(result)
  registerBlocksRedstoneBell(result)
  registerBlocksRedstoneButtons(result)
  registerBlocksRedstoneComparator(result)
  registerBlocksRedstoneCopperBulb(result)
  registerBlocksRedstoneDaylightDetector(result)
  registerBlocksRedstoneLever(result)
  registerBlocksRedstoneLightningRod(result)
  registerBlocksRedstoneObserver(result)
  registerBlocksRedstoneRedstoneBlock(result)
  registerBlocksRedstoneRedstoneLamp(result)
  registerBlocksRedstoneRedstoneOre(result)
  registerBlocksRedstoneRedstoneTorch(result)
  registerBlocksRedstoneRedstoneWire(result)
  registerBlocksRedstoneRepeater(result)
  registerBlocksRedstoneSculkSensor(result)
  registerBlocksRedstoneTargetBlock(result)
  registerBlocksRedstoneTripwire(result)
  registerBlocksRedstoneTripwireHook(result)
  registerBlocksRedstonePressurePlatePlate(result)
  registerBlocksRedstonePressurePlateWeighted(result)
  registerBlocksRedstoneRailsActivatorRail(result)
  registerBlocksRedstoneRailsDetectorRail(result)
  registerBlocksRedstoneRailsPoweredRail(result)
  registerBlocksRedstoneRailsRail(result)
  registerBlocksDoors(result)
  registerBlocksTrapdoor(result)
  registerBlocksFences(result)
  registerBlocksFenceGates(result)
  registerBlocksSlabs(result)
  registerBlocksStairs(result)
  registerBlocksWalls(result)
  registerBlocksTorches(result)
  registerBlocksGlassPanes(result)
  registerBlocksIronBars(result)
  registerBlocksLadder(result)
  registerBlocksLanterns(result)
  registerBlocksCarpet(result)
  registerBlocksFarmland(result)
  registerFluidWater(result)
  registerBlocksFalling(result)
  registerBlocksGrassBlock(result)
  registerBlocksDirtPath(result)
  registerBlocksEndRod(result)
  registerBlocksLogs(result)
  registerBlocksGlazedTerracotta(result)
