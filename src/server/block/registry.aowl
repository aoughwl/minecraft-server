## Port of pumpkin/src/block/registry.rs: `default_registry` registers every block file in blocks/. The dispatch half is in blockbehaviour.aowl; `place_block` is block_place.aowl and calls this; worldmod.aowl builds the world's `BlockWorld` from it (worldadapter.aowl).

import blockbehaviour
import blocks/[barrier, chain, mangrove_roots]
import blocks/[nether_portal, end_portal]
import blocks/redstone/[bell, buttons, comparator, copper_bulb, daylight_detector, lever, lightning_rod, observer,
  redstone_block, redstone_lamp, redstone_ore, redstone_torch, redstone_wire, repeater, sculk_sensor, target_block,
  tripwire, tripwire_hook]
import blocks/redstone/pressure_plate/[plate, weighted]
import blocks/redstone/rails/[activator_rail, detector_rail, powered_rail, rail]
import "blocks/doors"
import "blocks/trapdoor"
import "blocks/fences"
import "blocks/fence_gates"
import "blocks/slabs"
import "blocks/stairs"
import "blocks/walls"
import "fluid/water"
import "blocks/torches"
import "blocks/glass_panes"
