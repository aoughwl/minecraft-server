## `default_registry` as far as it goes: every name it registers resolves against the pinned data, and redstone's blocks
## reach their behaviour through it.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import registry

let r = defaultRegistry()
assert r.unknown.len == 0
assert r.getPumpkinBlock(blockRedstoneWire().id).isSome
assert r.getPumpkinBlock(blockRepeater().id).isSome
assert r.getPumpkinBlock(blockLever().id).isSome
assert r.getPumpkinBlock(blockStone().id).isNone
# `#[pumpkin_block_from_tag("minecraft:...")]` covers every member of a tag.
assert r.getPumpkinBlock(blockOakPressurePlate().id).isSome
echo "registry: all checks passed"
