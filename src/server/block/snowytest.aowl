## Runtime test for spreadingsnowy.aowl.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import testworld
import spreadingsnowy

let pos = blockPos(0'i32, 64'i32, 0'i32)
let above = blockPos(0'i32, 65'i32, 0'i32)

block onPlaceNoSnowAbove:
  let t = newTestWorld(newBlockRegistry())
  let sid = snowyOnPlace(blockPodzol(), t.world, pos)
  assert not GrassBlockLikeProperties.fromStateId(sid, blockPodzol()).snowy

block onPlaceSnowAbove:
  let t = newTestWorld(newBlockRegistry())
  t.put(above, blockSnow())
  let sid = snowyOnPlace(blockMycelium(), t.world, pos)
  assert GrassBlockLikeProperties.fromStateId(sid, blockMycelium()).snowy

block neighborUpdateFlipsToSnowy:
  var base = GrassBlockLikeProperties.defaultFor(blockPodzol())
  base.snowy = false
  let baseId = base.toStateId(blockPodzol())
  let newSid = snowyGetStateForNeighborUpdate(blockPodzol(), baseId, BlockDirection.Up, blockSnow().defaultState.id)
  assert GrassBlockLikeProperties.fromStateId(newSid, blockPodzol()).snowy

block neighborUpdateIgnoresNonUpDirection:
  var base = GrassBlockLikeProperties.defaultFor(blockPodzol())
  base.snowy = false
  let baseId = base.toStateId(blockPodzol())
  let unchanged = snowyGetStateForNeighborUpdate(blockPodzol(), baseId, BlockDirection.North, blockSnow().defaultState.id)
  assert unchanged == baseId

echo "spreadingsnowy: all checks passed"
