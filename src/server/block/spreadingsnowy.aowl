## The `snowy` property of podzol and mycelium: what pumpkin/src/block/blocks/grass_block.rs does for grass.
##
## This file predates the block port and named an upstream `spreading_snowy_block.rs`, which is not in the pinned tree:
## there, only grass has this behaviour and podzol and mycelium have none. So it is not registered by
## registry.aowl, which follows the pinned tree. It is kept, with its test, on the current `BlockWorld`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import blockprelude

proc isSnowyBlockState(state: BlockStateId): bool =
  Block.fromStateId(state).hasTag(Block_MINECRAFT_SNOW)

proc snowyOnPlace*(blockRef: Block; world: BlockWorld; pos: BlockPos): BlockStateId =
  ## The placed block's `snowy` property, from whether the block directly above is snow.
  var props = GrassBlockLikeProperties.defaultFor(blockRef)
  props.snowy = isSnowyBlockState(world.getBlockStateId(pos.up()))
  props.toStateId(blockRef)

proc snowyGetStateForNeighborUpdate*(blockRef: Block; stateId: BlockStateId; direction: BlockDirection; neighborState: BlockStateId): BlockStateId =
  ## Only the neighbour directly above matters; every other direction keeps the state.
  if not (direction == BlockDirection.Up):
    return stateId
  var props = GrassBlockLikeProperties.fromStateId(stateId, blockRef)
  let shouldBeSnowy = isSnowyBlockState(neighborState)
  if props.snowy == shouldBeSnowy:
    return stateId
  props.snowy = shouldBeSnowy
  props.toStateId(blockRef)
