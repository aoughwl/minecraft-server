## A `BlockWorld` over a table, for tests: what a test sets is what a block reads, and the tick queue is run by hand.
## Not a port; `worldadapter.aowl` is the same vtable over the real `World`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[options, tables, algorithm]
import ../../data/block_ext
from ../../data/block_state import BlockStateId, asU16
import ../../generated/[fluid, sound, sound_category, world_event]
import ../../util/math/position
import ../../util/vector3
import ../../world/tick
import blockbehaviour

type
  ScheduledBlockTick* = object
    position*: BlockPos
    blockRef*: Block
    due*: int64
    priority*: TickPriority
    order*: int

  TestWorld* = ref object
    world*: BlockWorld
    states*: Table[int64, BlockStateId]
    age*: int64
    ticks*: seq[ScheduledBlockTick]
    nextOrder*: int
    events*: seq[string]  ## In order: every sound, world event and synced event, as text.
    writes*: seq[(BlockPos, BlockStateId)]  ## Every state written, in order.

proc newTestWorld*(registry: BlockRegistry): TestWorld =
  let t = TestWorld(states: initTable[int64, BlockStateId](), age: 0'i64, ticks: @[], events: @[], writes: @[])
  let w = BlockWorld(blockRegistry: registry, minY: -64'i32, topY: 319'i32, dimensionName: "minecraft:overworld",
    blockEntities: initTable[int64, BlockEntity]())
  w.getRaw = proc(position: BlockPos): BlockStateId {.closure.} =
    t.states.getOrDefault(position.asLong(), blockStateIdAir)
  w.setRaw = proc(position: BlockPos; id: BlockStateId): BlockStateId {.closure.} =
    result = t.states.getOrDefault(position.asLong(), blockStateIdAir)
    t.states[position.asLong()] = id
    if result != id:
      t.writes.add((position, id))
  w.isLoaded0 = proc(position: BlockPos): bool {.closure.} = true
  w.scheduleBlockTick0 = proc(blockRef: Block; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.} =
    for tk in t.ticks:
      if tk.position == position and sameBlock(tk.blockRef, blockRef):
        return
    t.ticks.add(ScheduledBlockTick(position: position, blockRef: blockRef, due: t.age + int64(delay), priority: priority, order: t.nextOrder))
    inc t.nextOrder
  w.scheduleFluidTick0 = proc(fluid: Fluid; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.} = discard
  w.isBlockTickScheduled0 = proc(position: BlockPos; blockRef: Block): bool {.closure.} =
    for tk in t.ticks:
      if tk.position == position and sameBlock(tk.blockRef, blockRef):
        return true
    false
  w.isFluidTickScheduled0 = proc(position: BlockPos; fluid: Fluid): bool {.closure.} = false
  w.syncWorldEvent0 = proc(event: WorldEvent; position: BlockPos; data: int32) {.closure.} =
    t.events.add("event " & $ord(event))
  w.playSound0 = proc(sound: Sound; category: SoundCategory; position: Vector3[float64]; volume, pitch: float32) {.closure.} =
    t.events.add("sound " & $ord(sound))
  w.addSyncedBlockEvent0 = proc(position: BlockPos; kind, data: uint8) {.closure.} =
    t.events.add("synced " & $kind & " " & $data)
  w.worldAge0 = proc(): int64 {.closure.} = t.age
  t.world = w
  t

proc put*(t: TestWorld; position: BlockPos; state: BlockStateId) =
  ## Writes a state with no callback, as a test's setup.
  t.states[position.asLong()] = state

proc put*(t: TestWorld; position: BlockPos; blockRef: Block) =
  t.put(position, blockRef.defaultState.id)

proc byPriority(a, b: ScheduledBlockTick): int =
  result = cmp(ord(a.priority), ord(b.priority))
  if result == 0:
    result = cmp(a.order, b.order)

proc step*(t: TestWorld) =
  ## One game tick: what is due runs in priority order, then submission order.
  t.age += 1'i64
  var due: seq[ScheduledBlockTick] = @[]
  var later: seq[ScheduledBlockTick] = @[]
  for tk in t.ticks:
    if tk.due <= t.age:
      due.add(tk)
    else:
      later.add(tk)
  t.ticks = later
  due.sort(byPriority)
  for tk in due:
    let b = t.world.blockRegistry.getPumpkinBlock(tk.blockRef.id)
    if b != nil and sameBlock(t.world.getBlock(tk.position), tk.blockRef):
      let f = b.onScheduledTickImpl
      f(OnScheduledTickArgs(world: t.world, block0: tk.blockRef, position: tk.position))

proc run*(t: TestWorld; ticks: int) =
  for i in 0 ..< ticks:
    t.step()
