## A block written into a chunk that is not in the level (a /fill, an explosion or a neighbour update over the edge of the loaded area):
## nothing is stored, so nothing may be announced either. The write used to be logged, run through the neighbour updates and queued for the
## clients (a block that never existed, gone again when the client next got the real chunk).
## Also what the loaded chunk next to it still does: stores the block and queues the update.

import std/[assertions, cmdline, syncio, tables]
import ../../data/block_ext
import ../../generated/dimension
import ../../util/vector3
import ../../util/math/position
import ../serverbase
import ../scheduler
import ../../generated/block_properties
from ../../data/block_state import asU16
import ../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../../world/world as worldtraits
import ../data/datamod
import ../recipe
import ../tick_rate_manager
import ../world/worldmod
import worldhooks

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/unloadedwrite_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)

# Chunk (0, 0) is loaded; chunk (1, 0), the one on the other side of the border x = 16, is not.
addLoadedChunk(theLevel, newChunkData(0'i32, 0'i32, newChunkSections(24, -64'i32)))

proc pos(x, y, z: int32): BlockPos = BlockPos(vec: Vector3[int32](x: x, y: y, z: z))

let planks = uint32(asU16(blockOakPlanks().defaultState.id))
let air = 0'u32  # minecraft:air

# 15 | 16 along x at the same y and z: the loaded side keeps its block and tells the clients, the other side does neither.
let before = testWorld.getBlockStateId(pos(16'i32, 70'i32, 4'i32))
assert testWorld.getBlockStateId(pos(15'i32, 70'i32, 4'i32)) == air
discard testWorld.setBlockState(pos(15'i32, 70'i32, 4'i32), planks, BfNotifyAll)
assert testWorld.getBlockStateId(pos(15'i32, 70'i32, 4'i32)) == planks, "the loaded side stores the block"
assert testWorld.unsentBlockChanges.len == 1, "the loaded side queues one client update"
testWorld.unsentBlockChanges = initTable[int64, BlockChange]()
discard testWorld.setBlockState(pos(16'i32, 70'i32, 4'i32), planks, BfNotifyAll)
assert testWorld.getBlockStateId(pos(16'i32, 70'i32, 4'i32)) == before, "the unloaded side stores nothing"
assert testWorld.getBlockStateId(pos(16'i32, 70'i32, 4'i32)) != planks
assert testWorld.unsentBlockChanges.len == 0, "and queues no client update for a block that does not exist"
echo "unloaded write ok"
