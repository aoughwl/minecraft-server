import blockprelude


type
  ViewerFuture* = T



proc updateViewerCount*(self: ViewerCountTracker, entity: T, world: BlockWorld, position: BlockPos)

proc updateViewerCount*(self: ViewerCountTracker, entity: T, world: BlockWorld, position: BlockPos) =
  let current = self.current
  let old = self.old.swap(current, 0)
  if (not (old == current)):
    let t1 = (old, current)
    if t1[1] == 0 and (t1[0] > 0):
      let n = t1[0]
      entity.onContainerClose(world, position)
    elif t1[0] == 0 and (t1[1] > 0):
      let n = t1[1]
      entity.onContainerOpen(world, position)
    else:
      discard
    entity.onViewerCountUpdate(world, position, old, current)

