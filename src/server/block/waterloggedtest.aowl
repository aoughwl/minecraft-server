## Round-trip test for blocks/barrier.aowl and blocks/mangrove_roots.aowl: single-property (waterlogged-only) blocks,
## through the registry as the world reaches them.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import blockprelude
import blockstateid
import blocks/barrier
import blocks/mangrove_roots

let registry = newBlockRegistry()
registerBlocksBarrier(registry)
registerBlocksMangroveRoots(registry)

proc placed(blockRef: Block; replacing: BlockIsReplacing): BlockStateId =
  let b = registry.getPumpkinBlock(blockRef.id)
  assert b.isSome
  b.unsafeGet.onPlace(OnPlaceArgs(block0: blockRef, direction: BlockDirection.Up, replacing: replacing))

let dry = BlockIsReplacing(kind: BlockIsReplacingKind.kOther)
let wet = BlockIsReplacing(kind: BlockIsReplacingKind.kWater, f0Water: 0'u8)
let flowing = BlockIsReplacing(kind: BlockIsReplacingKind.kWater, f0Water: 3'u8)

for name0 in ["barrier", "mangrove_roots"]:
  let blockRef = Block.fromName(name0)
  assert blockRef != nil
  let sDry = placed(blockRef, dry)
  let dDry = statePropValues(name0, int(asU16(sDry)))
  assert dDry.ok and dDry.values[0] == ("waterlogged", "false")
  let sWet = placed(blockRef, wet)
  let dWet = statePropValues(name0, int(asU16(sWet)))
  assert dWet.ok and dWet.values[0] == ("waterlogged", "true")
  assert not (sDry == sWet), "waterlogged and dry must be distinct states"
  assert placed(blockRef, flowing) == sDry, "only a source waterlogs"

echo "waterlogged block checks passed"
