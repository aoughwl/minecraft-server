## The `BlockWorld` of a real `World`: what blocks call, on top of src/server/world/worldmod.aowl.
##
## Where worldmod has the call this goes to it. The rest stay nil in the vtable, which blockbehaviour.aowl treats as "does
## nothing" (sounds, world events, entities, tick scheduling through the block's name), until the world side has them;
## see the hooks listed at the end of this file. Nothing here changes how worldmod itself behaves: it must call
## `setBlockState` below in place of its own for blocks to hear of a change.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[options, tables]
import ../../data/block_ext
from ../../data/block_state import BlockStateId, asU16, newBlockStateIdUnchecked
import ../../generated/fluid
import ../../util/math/position
import ../../world/tick
import ../../world/level
import ../serverbase
import ../world/worldmod
import blockbehaviour

proc newBlockWorldOf*(world: World; registry: BlockRegistry): BlockWorld =
  ## The world's raw half. Upstream's `set_block_state` in its first lines: the write and the queued client update.
  let theLevel = world.level
  let w = BlockWorld(blockRegistry: registry, minY: world.getBottomY(), topY: world.getTopY(),
    dimensionName: world.dimension.minecraftName, blockEntities: initTable[int64, BlockEntity]())
  w.getRaw = proc(position: BlockPos): BlockStateId {.closure.} =
    newBlockStateIdUnchecked(uint16(world.getBlockStateId(position)))
  w.setRaw = proc(position: BlockPos; id: BlockStateId): BlockStateId {.closure.} =
    let wanted = uint32(asU16(id))
    let replaced = uint32(setBlockState(theLevel, position, wanted))
    if replaced != wanted:
      world.registerBlockChange(position, wanted)
    newBlockStateIdUnchecked(uint16(replaced))
  w.isLoaded0 = proc(position: BlockPos): bool {.closure.} = world.isLoaded(position)
  w.updateLighting0 = proc(position: BlockPos) {.closure.} = updateLightingAt(theLevel, position)
  w.closeContainerScreensAt0 = proc(position: BlockPos) {.closure.} = world.closeContainerScreensAt(position)
  w.scheduleBlockTick0 = proc(blockRef: Block; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.} =
    scheduleBlockTick(theLevel, blockRef.name, position, delay, priority)
  w.scheduleFluidTick0 = proc(fluid: Fluid; position: BlockPos; delay: uint8; priority: TickPriority) {.closure.} =
    scheduleFluidTick(theLevel, fluid.name, position, delay, priority)
  w.isBlockTickScheduled0 = proc(position: BlockPos; blockRef: Block): bool {.closure.} =
    isBlockTickScheduled(theLevel, position, blockRef.name)
  w.isFluidTickScheduled0 = proc(position: BlockPos; fluid: Fluid): bool {.closure.} =
    isFluidTickScheduled(theLevel, position, fluid.name)
  w.addSyncedBlockEvent0 = proc(position: BlockPos; kind, data: uint8) {.closure.} =
    world.addSyncedBlockEvent(position, kind, data)
  w.worldAge0 = proc(): int64 {.closure.} = world.levelTime.worldAge
  w.timeOfDay0 = proc(): int64 {.closure.} = world.levelTime.timeOfDay
  w.isRaining0 = proc(): bool {.closure.} = world.weather.raining
  w.isThundering0 = proc(): bool {.closure.} = world.weather.thundering
  w
