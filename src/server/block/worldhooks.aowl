proc nbtItemStack(tag: NbtTag): ItemStack =
  ## `{id: "minecraft:iron_helmet", count: 1}` (the 1.21.5 form) or the older `Count`; an empty stack for what is not an item.
  result = emptyItemStack()
  if tag.kind != ntkCompound:
    return
  let id = tag.compoundVal.getString("id")
  if id.isNone:
    return
  let key = if id.unsafeGet.startsWith("minecraft:"): id.unsafeGet.substr(10) else: id.unsafeGet
  let it = Item.fromRegistryKey(key)
  if it == nil:
    return
  var count = 1'i32
  let c = tag.compoundVal.getInt("count")
  if c.isSome:
    count = c.unsafeGet
  else:
    let old = tag.compoundVal.getByte("Count")
    if old.isSome:
      count = int32(old.unsafeGet)
  if count > 0'i32:
    result = newItemStack(uint8(min(count, 99'i32)), it)

proc numberOf(tag: NbtTag; value: var float64): bool =
  case tag.kind
  of ntkByte:
    value = float64(tag.byteVal)
  of ntkShort:
    value = float64(tag.shortVal)
  of ntkInt:
    value = float64(tag.intVal)
  of ntkLong:
    value = float64(tag.longVal)
  of ntkFloat:
    value = float64(tag.floatVal)
  of ntkDouble:
    value = tag.doubleVal
  else:
    return false
  true

proc coerceNumberLike(merged: NbtCompound; name: string; tag: NbtTag): NbtTag =
  ## SNBT `Color:5` is an int; a `read_nbt` that asks for a byte (or a float, a short) would not see it. Vanilla reads any
  ## number as the type asked for, so a number is given the kind of the value the entity wrote under that name.
  result = tag
  let (found, old) = merged.get(name)
  var v = 0.0'f64
  if not found or not numberOf(tag, v) or old.kind == tag.kind:
    return
  case old.kind
  of ntkByte:
    result = NbtTag(kind: ntkByte, byteVal: int8(int64(v)))
  of ntkShort:
    result = NbtTag(kind: ntkShort, shortVal: int16(int64(v)))
  of ntkInt:
    result = NbtTag(kind: ntkInt, intVal: int32(int64(v)))
  of ntkLong:
    result = NbtTag(kind: ntkLong, longVal: int64(v))
  of ntkFloat:
    result = NbtTag(kind: ntkFloat, floatVal: float32(v))
  of ntkDouble:
    result = NbtTag(kind: ntkDouble, doubleVal: v)
  else:
    discard

proc applySummonNbt(entity: EntityBase; nbt: NbtCompound) =
  ## `/summon`'s NBT over a fresh entity. The entity's own `read_nbt` gets the saved data with the new tags merged in (an entity
  ## whose impl saves nothing reads nothing); the generic tags that no `read_nbt` here takes are then applied as the setters do.
  var merged = newCompound()
  entity.writeNbt(merged)
  if merged.names.len > 0:
    for i in 0 ..< nbt.names.len:
      merged.insert(nbt.names[i], coerceNumberLike(merged, nbt.names[i], nbt.values[i]))
    entity.readNbt(merged)
  let base = entity.entity
  let name = nbt.getString("CustomName")
  if name.isSome:
    let parsed = TextComponent.fromJsonString(name.unsafeGet)
    if parsed.ok:
      base.customName = some(parsed.value)
  let visible = nbt.getBool("CustomNameVisible")
  if visible.isSome:
    base.customNameVisible = visible.unsafeGet
  let silent = nbt.getBool("Silent")
  if silent.isSome:
    base.silent = silent.unsafeGet
  let noGravity = nbt.getBool("NoGravity")
  if noGravity.isSome:
    base.noGravity = noGravity.unsafeGet
  if entity of Mob:
    let mob = Mob(entity)
    let noAi = nbt.getBool("NoAI")
    if noAi.isSome:
      mob.mobEntity.setNoAi(noAi.unsafeGet)
    let age = nbt.getInt("Age")
    if age.isSome:
      mob.setAge(age.unsafeGet)
    let health = nbt.getFloat("Health")
    if health.isSome:
      mob.mobEntity.livingEntity.setHealth(health.unsafeGet)
    let pickup = nbt.getBool("CanPickUpLoot")
    if pickup.isSome:
      mob.mobEntity.setCanPickUpLoot(pickup.unsafeGet)
    let left = nbt.getBool("LeftHanded")
    if left.isSome:
      mob.mobEntity.setLeftHanded(left.unsafeGet)
  elif entity.living != nil and entity.player == nil:
    let health = nbt.getFloat("Health")
    if health.isSome:
      mustLiving(entity).setHealth(health.unsafeGet)
  if entity.living != nil and entity.player == nil:
    let living = mustLiving(entity)
    # 1.21.5+: `equipment: {head: {id, count}, mainhand: ...}`.
    let eq = nbt.getCompound("equipment")
    if eq.isSome:
      for (key, slot) in [("mainhand", esMainHand), ("offhand", esOffHand), ("feet", esFeet), ("legs", esLegs),
          ("chest", esChest), ("head", esHead), ("body", esBody), ("saddle", esSaddle)]:
        for i in 0 ..< eq.unsafeGet.names.len:
          if eq.unsafeGet.names[i] == key:
            discard living.entityEquipment.put(slot, nbtItemStack(eq.unsafeGet.values[i]))
    # Older: `ArmorItems: [feet, legs, chest, head]`, `HandItems: [mainhand, offhand]`.
    let armor = nbt.getList("ArmorItems")
    if armor.isSome:
      for (i, slot) in [(0, esFeet), (1, esLegs), (2, esChest), (3, esHead)]:
        if i < armor.unsafeGet.len:
          discard living.entityEquipment.put(slot, nbtItemStack(armor.unsafeGet[i]))
    let hands = nbt.getList("HandItems")
    if hands.isSome:
      for (i, slot) in [(0, esMainHand), (1, esOffHand)]:
        if i < hands.unsafeGet.len:
          discard living.entityEquipment.put(slot, nbtItemStack(hands.unsafeGet[i]))

proc blockActorOf*(base: EntityBase): BlockActor
proc blockPlayerOf*(player: Player): BlockPlayer

proc fillActor(a: BlockActor; base: EntityBase) =
  let entity = base.entity
  a.entityId = entity.entityId
  a.entityUuid = $entity.entityUuid
  a.entityTypeName = entity.entityType.resourceName
  a.isLiving = base.living != nil
  a.block0Pos = proc(): Vector3[float64] {.closure.} = entity.pos
  a.setPos0 = proc(p: Vector3[float64]) {.closure.} = entity.setPos(p)
  a.noClip0 = proc(): bool {.closure.} = entity.noClip
  a.sendPos0 = proc() {.closure.} = entity.sendPos()
  a.getVelocity0 = proc(): Vector3[float64] {.closure.} = entity.velocity
  a.setVelocity0 = proc(v: Vector3[float64]) {.closure.} = entity.setVelocity(v)
  a.getBox0 = proc(): BoundingBox {.closure.} = entity.boundingBox
  a.sneaking0 = proc(): bool {.closure.} = entity.sneaking
  a.yaw0 = proc(): float32 {.closure.} = entity.yaw
  a.pitch0 = proc(): float32 {.closure.} = entity.pitch
  a.onGround0 = proc(): bool {.closure.} = entity.onGround
  a.setOnFireFor0 = proc(seconds: float32) {.closure.} = base.setOnFireFor(seconds)
  a.extinguish0 = proc() {.closure.} = entity.extinguish()
  a.slowMovement0 = proc(multiplier: Vector3[float64]) {.closure.} =
    entity.movementMultiplier = multiplier
  a.handleFallDamage0 = proc(fallDistance: float32; damageMultiplier: float32) {.closure.} =
    let living = base.living
    if living != nil:
      handleFallDamage(LivingEntity(living), base, fallDistance, damageMultiplier)
  a.damage0 = proc(amount: float32; damageType: string): bool {.closure.} =
    let (found, dt) = damageTypeFromName(if damageType.startsWith("minecraft:"): damageType.substr(10) else: damageType)
    if not found:
      return false
    base.damage(base, amount, dt)
  a.addEffect0 = proc(effect: string; durationTicks: int32; amplifier: uint8) {.closure.} =
    let living = base.living
    let kind = StatusEffect.fromName(effect)
    if living != nil and kind.isSome:
      LivingEntity(living).addEffect(Effect(effectType: kind.unsafeGet, duration: durationTicks, amplifier: amplifier,
        ambient: false, showParticles: true, showIcon: true, blend: false))
  a.addEffectFull0 = proc(effect: string; durationTicks: int32; amplifier: uint8; ambient, showParticles, showIcon, blend: bool) {.closure.} =
    let living = base.living
    let kind = StatusEffect.fromName(effect)
    if living != nil and kind.isSome:
      LivingEntity(living).addEffect(Effect(effectType: kind.unsafeGet, duration: durationTicks, amplifier: amplifier,
        ambient: ambient, showParticles: showParticles, showIcon: showIcon, blend: blend))
  a.hasEffect0 = proc(effect: string): bool {.closure.} =
    let living = base.living
    let kind = StatusEffect.fromName(effect)
    living != nil and kind.isSome and LivingEntity(living).hasEffect(kind.unsafeGet)
  a.fireImmune0 = proc(): bool {.closure.} = entity.entityType.fireImmune or entity.fireImmune
  a.getFireTicks0 = proc(): int32 {.closure.} = entity.fireTicks
  a.setFireTicks0 = proc(ticks: int32) {.closure.} = entity.fireTicks = ticks
  a.lastPos0 = proc(): Vector3[float64] {.closure.} = entity.lastPos
  a.getMovement0 = proc(): Vector3[float64] {.closure.} =
    let living = base.living
    if living != nil: LivingEntity(living).getMovement() else: Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  a.fallDistance0 = proc(): float32 {.closure.} =
    let living = base.living
    if living != nil: living.fallDistance else: 0.0'f32
  a.canWalkOnPowderSnow0 = proc(): bool {.closure.} = canEntityWalkOnPowderSnow(base)
  a.feetStack0 = proc(): ItemStack {.closure.} =
    let living = base.living
    if living != nil: living.entityEquipment.get(esFeet) else: emptyItemStack()
  a.setFuse0 = proc(ticks: uint32) {.closure.} =
    if base of TNTEntity:
      TNTEntity(base).fuse = ticks
  a.setPower0 = proc(power: float32) {.closure.} =
    if base of TNTEntity:
      TNTEntity(base).power = power
  a.setRotation0 = proc(yaw, pitch: float32) {.closure.} = entity.setRotation(yaw, pitch)
  a.setPickupAllowed0 = proc() {.closure.} =
    if base of ArrowEntity:
      ArrowEntity(base).pickup = apAllowed
  a.applyVariant0 = proc(item: ItemStack) {.closure.} = applyEntityVariant(item, base)
  a.remove0 = proc() {.closure.} = entity.remove()
  a.getItemStack0 = proc(): (bool, ItemStack) {.closure.} =
    if base of ItemEntity: (true, ItemEntity(base).itemStack) else: (false, emptyItemStack())
  a.setItemStack0 = proc(stack: ItemStack) {.closure.} =
    if base of ItemEntity:
      ItemEntity(base).itemStack = stack
  a.tryUsePortal0 = proc(portalDelay: uint32; targetDimension: string; position: BlockPos) {.closure.} =
    for w in entity.world.server.worlds:
      if w.dimension.minecraftName == targetDimension and w != entity.world:
        tryUsePortal(entity, portalDelay, w, position)
        return

proc blockActorOf*(base: EntityBase): BlockActor =
  ## `dyn EntityBase`, as far as blocks use one.
  let player = base.player
  if player != nil:
    return blockPlayerOf(Player(player))
  result = BlockActor()
  fillActor(result, base)

proc blockPlayerOf*(player: Player): BlockPlayer =
  let base = playerBase(player)
  result = BlockPlayer()
  fillActor(result, base)
  result.player0 = result
  result.gamemode0 = proc(): GameMode {.closure.} = player.gamemode
  result.resetBreath0 = proc() {.closure.} = breathmod.reset(breathmod.breathOf(player), player)
  result.inventory0 = proc(): Inventory {.closure.} = Inventory(player.inventory)
  result.permissionLvl0 = proc(): PermissionLvl {.closure.} = player.permissionLvl
  result.dropItem0 = proc(item: ItemStack) {.closure.} = itembehaviour.dropItem(player, item)
  result.enchantmentSeed0 = proc(): int32 {.closure.} = player.enchantmentSeed
  result.enderChestInventory0 = proc(): Inventory {.closure.} = Inventory(player.enderChestInventory)
  result.sendSystemMessage0 = proc(message: TextComponent; overlay: bool) {.closure.} =
    player.sendSystemMessageRaw(message, overlay)
  result.allowModifyWorld0 = proc(): bool {.closure.} = player.abilities.allowModifyWorld
  let me = result
  result.openHandledScreen0 = proc(factory: BlockScreenFactory; position: Option[BlockPos]): bool {.closure.} =
    ## `Player::open_handled_screen`: the window is opened with the factory's handler, which is made for `result`.
    if player.currentScreenHandler != ScreenHandler(player.playerScreenHandler):
      player.closeHandledScreen()
    player.incrementScreenHandlerSyncId()
    let make = factory.createScreenHandler
    let handler = make(player.screenHandlerSyncId, me)
    if handler == nil:
      return false
    let windowType = handler.windowType()
    if windowType.isNone:
      return false
    player.client.writePacketFor(COpenScreen(syncId: newVarInt(int32(handler.syncId())),
      windowType: newVarInt(int32(ord(windowType.unsafeGet))), windowTitle: factory.title))
    player.onScreenHandlerOpened(handler)
    player.currentScreenHandler = handler
    player.openContainerPos = position
    true
  result.stackInHand0 = proc(hand: int): ItemStack {.closure.} =
    if hand == 0: player.inventory.heldItem() else: player.inventory.offHandItem()
  result.setStackInHand0 = proc(hand: int; stack: ItemStack) {.closure.} =
    if hand == 0: player.inventory.setHeldItem(stack) else: player.inventory.setOffHandItem(stack)
  result.incrementStat0 = proc(stat: string; amount: int32) {.closure.} =
    ## blockprelude's `incrementStat` passes `$category & ":" & $stat`: the category's name and the statistic's id.
    let at = stat.find(':')
    if at > 0:
      for categoryId in 0 .. 8:
        let category = StatisticCategory(categoryId)
        if $category == stat.substr(0, at - 1):
          let digits = stat.substr(at + 1)
          if digits.len > 0 and digits.allCharsInSet({'0' .. '9'}):
            var id = 0'i32
            for digit in digits:
              id = id * 10'i32 + int32(ord(digit) - ord('0'))
            player.incrementStat(category, id, amount)
  result.addHunger0 = proc(food: int32; saturation: float32) {.closure.} =
    ## `HungerManager::add_hunger` and `add_saturation`, then the client is told.
    player.hungerManager.addHunger(uint8(clamp(food, 0'i32, 255'i32)))
    player.hungerManager.addSaturation(saturation)
    player.sendHealth()
  result.hungerLevel0 = proc(): int32 {.closure.} = int32(player.hungerManager.level)
  result.isOp0 = proc(): bool {.closure.} = player.permissionLvl >= PermissionLvl.Two
  result.setRespawnPoint0 = proc(position: BlockPos; yaw, pitch: float32): bool {.closure.} =
    player.setRespawnPoint(player.world.dimension, position, yaw, pitch, false)
  result.sleep0 = proc(position: BlockPos) {.closure.} = sleepPlayer(player, position)
  result.eyePosition0 = proc(): Vector3[float64] {.closure.} = player.eyePosition()
  result.flippedRotation160 = proc(): uint8 {.closure.} = playerBase(player).entity.getFlippedRotation16()
  result.canInteractWithBlockAt0 = proc(position: BlockPos; additionalRange: float64): bool {.closure.} =
    player.canInteractWithBlockAt(position, additionalRange)
  result.sendSignPacket0 = proc(position: BlockPos; isFrontText: bool) {.closure.} =
    player.client.writePacketFor(COpenSignEditor(location: position, isFrontText: isFrontText))
  result.triggerAdvancement0 = proc(trigger, argument: string) {.closure.} =
    if gPlayerHooks.triggerAdvancement != nil:
      gPlayerHooks.triggerAdvancement(player, trigger, argument)

proc sleepPlayer(player: Player; bedHeadPos: BlockPos) =
  ## `Player::sleep`. The 1.21.11 client reads the bed from `SLEEPING_POSITION`, which is what upstream's `SLEEPING_POS_ID`
  ## names from 26.1. `sleeping_since` starts at 0 here; `Player::tick` counts it and `World::tick_environment` skips the night.
  var bedEnterEv = newPlayerEv(pekBedEnter)
  bedEnterEv.pos = bedHeadPos
  if gPluginPlayerEventHook(player, bedEnterEv)[0]:
    return  # `PlayerBedEnterEvent` cancelled (the caller has already marked the bed; upstream returns before that)
  let base = playerBase(player)
  let entity = base.entity
  entity.setPose(epSleeping)
  player.sleepingSince = 0'i32
  entity.setPos(Vector3[float64](x: float64(bedHeadPos.vec.x) + 0.5'f64, y: float64(bedHeadPos.vec.y) + 0.6875'f64,
    z: float64(bedHeadPos.vec.z) + 0.5'f64))
  entity.sendMetaData(TrackedData_SLEEPING_POSITION, OPTIONAL_BLOCK_POS, some(bedHeadPos))
  entity.sendMetaData(TrackedData_SLEEPING_POS_ID, OPTIONAL_BLOCK_POS, some(bedHeadPos))
  entity.setVelocity(Vector3[float64](x: 0.0, y: 0.0, z: 0.0))
  playermod.setPos(player, entity.pos)
  syncToPlayer(base)

proc wakeUpPlayer(player: Player) =
  ## `Player::wake_up`. As the 1.21.11 client reads the bed from `SLEEPING_POSITION` it is cleared as well. The bed the
  ## player sleeps in is the respawn point `BedBlock::use` set, and its `occupied` property is reset (`BedBlock::set_occupied`).
  ## Upstream returns early, still sleeping, when there is no respawn point; this wakes the player anyway.
  let base = playerBase(player)
  let entity = base.entity
  if entity.pose != epSleeping:
    return
  let world = player.world
  var bedLeaveEv = newPlayerEv(pekBedLeave)
  if player.respawnPoint.isSome: bedLeaveEv.pos = player.respawnPoint.unsafeGet.position
  discard gPluginPlayerEventHook(player, bedLeaveEv)
  if player.respawnPoint.isSome:
    let bedPos = player.respawnPoint.unsafeGet.position
    let bedStateId = world.getBlockStateId(bedPos)
    let bedBlock = dataBlockOf(bedStateId)
    if bedBlock.name.endsWith("_bed"):
      setOccupied(false, BlockWorld(world.blockWorld), bedBlock, bedPos, newBlockStateIdUnchecked(uint16(bedStateId)))
  entity.setPose(epStanding)
  entity.setPos(player.pos)
  entity.sendMetaData(TrackedData_SLEEPING_POSITION, OPTIONAL_BLOCK_POS, none[BlockPos]())
  entity.sendMetaData(TrackedData_SLEEPING_POS_ID, OPTIONAL_BLOCK_POS, none[BlockPos]())
  player.setStat(scCustom, int32(ord(csTimeSinceRest)), 0'i32)
  let animation = newCEntityAnimation(newVarInt(player.entityId), anLeaveBed)
  for viewer in world.players:
    if isWithinViewDistance(player.chunkPos, viewer.chunkPos, int32(getViewDistance(viewer, world.server))):
      viewer.client.writePacketFor(animation)
  player.sleepingSince = -1'i32

proc playerKilled(player: Player; deathMessage: TextComponent) =
  ## `Player::handle_killed`: the inventory falls where the player died (as upstream, only the main slots), the breath is
  ## refilled and the client gets the death screen. The advancement trigger is the advancement manager's.
  player.setClientLoaded(false)
  let blockPos = flooredV(player.pos)
  let world = player.world
  if not world.levelInfo.gameRules.keepInventory:
    for slot in 0 ..< player.inventory.mainInventory.len:
      let stack = player.inventory.mainInventory[slot]
      player.inventory.mainInventory[slot] = emptyItemStack()
      if not stack.isEmpty():
        dropStack(world, blockPos, stack)
  # Reset air supply & drowning ticks on death
  breathmod.breathOf(player).reset(player)
  player.client.writePacketFor(CCombatDeath(playerId: newVarInt(player.entityId), message: deathMessage))

proc playerLivingTick(world: World; player: Player; server: Server) =
  ## The rest of `Player::tick` after the chunk work, which is playermod's `tick`: `LivingEntity::tick` (the entity tick
  ## with fire and the void, the block collisions, the effects, the hurt cooldown), then the breath and the hunger.
  ## `tickPlayerPortals` has run first. The movement half of `LivingEntity::tick_movement` is not run: a player's position
  ## is the client's.
  if player.dead or player.health <= 0.0'f32:
    return
  playerextras.tickCameraTarget(player, server)
  let xpDelay = gPlayerHooks.experiencePickUpDelay(player)   # `experience_pick_up_delay` counts down at the top of the tick
  if xpDelay > 0'u32:
    gPlayerHooks.setExperiencePickUpDelay(player, xpDelay - 1'u32)
  let base = playerBase(player)
  let living = mustLiving(base)
  entityTick(base.entity, base, server)
  if base.entity.tickBlockCollisions(base, server):
    discard base.damageWithContext(base, 1.0'f32, IN_WALL, none[Vector3[float64]](), nil, nil)
  tickEffects(living)
  # `LivingEntity::tick`'s "current active item": the use time runs down and the item is consumed at the end (food, a
  # potion), which is also what `is_blocking` reads for a shield.
  if living.itemInUse.isSome:
    let inUse = living.itemInUse.unsafeGet
    let wasUseTime = living.itemUseTime
    living.itemUseTime = wasUseTime - 1'i32
    if wasUseTime <= 0'i32:
      living.consumeItem(base, inUse)
  if living.hurtCooldown > 0'i32:
    living.hurtCooldown -= 1'i32
  syncToPlayer(base)
  playerextras.updatePlayerPose(player)   # vanilla updates the pose after `super.tick()`
  breathmod.breathOf(player).tick(player)
  hungermod.tickHungerManager(player)
  playerextras.tickExperience(player)
  tickMaps(player)

proc installBlockHooks*(world: World) =
  ## Fills the hooks of `world.blockWorld` that entities back, and the world's own hooks into them.
  let w = BlockWorld(world.blockWorld)
  registerMobs()   # `from_type`'s arms for mobs, passives, bosses, vehicles and decorations: without it /summon and the spawner make bare LivingEntitys
  gBlockRecipeProvider = RecipeProvider(world.server.recipeManager)
  world.blockPlayerOf = proc(player: Player): BlockPlayer {.closure.} = blockPlayerOf(player)
  world.tickEntitiesHook = proc(server: Server) {.closure.} = tickEntities(world, server)
  world.playerJoinedHook = proc(player: Player) {.closure.} =
    sendEntitiesTo(world, player)
    playerextras.sendActiveEffects(player)   # `World::add_player`: `send_active_effects`
  world.shutdownHook = proc() {.closure.} = saveAllEntities(world)
  world.spawnEntityNbtHook = proc(entityType: string; pos: Vector3[float64]; nbt: NbtCompound): TextComponent {.closure.} =
    ## `/summon <type> <pos> <nbt>`: `from_type`, the data read over it, then `spawn_entity`.
    let kind = EntityType.fromName(entityType)
    if kind.isNone:
      return text("")
    let (made, uuid) = newV4()
    let entity = gFromType(kind.unsafeGet, pos, world, uuid)
    if entity == nil:
      return text(entityType)
    applySummonNbt(entity, nbt)
    world.spawnEntity(entity)
    entity.getDisplayName()
  world.spawnEntityHook = proc(entityType: string; pos: Vector3[float64]): TextComponent {.closure.} =
    ## `/summon`: `from_type`, then `spawn_entity`. The entity's display name is what the feedback says.
    let kind = EntityType.fromName(entityType)
    if kind.isNone:
      return text("")
    let (made, uuid) = newV4()
    let entity = gFromType(kind.unsafeGet, pos, world, uuid)
    if entity == nil:
      return text(entityType)
    world.spawnEntity(entity)
    entity.getDisplayName()
  w.playSound0 = proc(sound: Sound; category: SoundCategory; position: Vector3[float64]; volume, pitch: float32) {.closure.} =
    world.playSoundRaw(uint16(ord(sound)), category, position, volume, pitch)
  w.playSoundExcept0 = proc(exceptEntityId: int32; sound: Sound; category: SoundCategory; position: Vector3[float64];
      volume, pitch: float32) {.closure.} =
    ## `play_sound_expect`
    let audibleChunks = int32(ceil(float64(max(volume, 1.0'f32))))
    let chunkPos = position.flooredV().chunkPosition()
    for player in world.players:
      if player.entityId != exceptEntityId and isWithinViewDistance(chunkPos, player.chunkPos, audibleChunks):
        let remapped = remapSoundIdForVersion(uint16(ord(sound)), player.client.version)
        player.client.writePacketFor(newCSoundEffect(proto.IdOr[proto.SoundEvent](kind: iokId, id: remapped), category,
          position, volume, pitch, randomF64()))
  w.spawnParticle0 = proc(position, offset: Vector3[float64]; maxSpeed: float32; count: int32; particle: Particle) {.closure.} =
    world.spawnParticle(position, offset, maxSpeed, count, particle)
  w.spawnEntity0 = proc(entityType: string; position: Vector3[float64]; nbt: Option[NbtCompound]): BlockActor {.closure.} =
    ## `World::spawn_entity` of `from_type`'s entity, with its saved data read over it when there is some.
    let kind = EntityType.fromName(entityType)
    if kind.isNone:
      return nil
    let (made, uuid) = newV4()
    let entity = gFromType(kind.unsafeGet, position, world, uuid)
    if entity == nil:
      return nil
    if nbt.isSome:
      entity.readNbt(nbt.unsafeGet)
    world.spawnEntity(entity)
    blockActorOf(entity)
  w.biomeAt0 = proc(position: BlockPos): string {.closure.} =
    ## `get_biome`: the registry name of the rough biome at the position.
    let found = Biome.fromId(uint8(getRoughBiome(world.level, position)))
    if found == nil: "minecraft:plains" else: found.registryId
  w.dropStack0 = proc(position: BlockPos; stack: ItemStack) {.closure.} = dropStack(world, position, stack)
  w.spawnItem0 = proc(position: Vector3[float64]; stack: ItemStack) {.closure.} =
    let item: EntityBase = newItemEntity(newEntity(world, position, EntityType.ITEM), stack)
    spawnEntity(world, item)
  w.spawnItemWithVelocity0 = proc(position: Vector3[float64]; stack: ItemStack; velocity: Vector3[float64]; pickupDelay: uint8) {.closure.} =
    let item: EntityBase = newItemEntityWithVelocity(newEntity(world, position, EntityType.ITEM), stack, velocity, pickupDelay)
    spawnEntity(world, item)
  w.spawnExperienceOrb0 = proc(position: Vector3[float64]; amount: uint32) {.closure.} =
    gSpawnExperienceOrb(world, position, amount)
  w.dropLoot0 = proc(position: BlockPos; stateId: BlockStateId; cause: nil BlockPlayer) {.closure.} =
    blockDropLoot(world, position, stateId, cause)
  w.replaceSpawnFalling0 = proc(position: BlockPos; stateId: BlockStateId) {.closure.} =
    replaceSpawn(world, position, stateId)
  w.worldSeed0 = proc(): int64 {.closure.} = world.levelInfo.worldGenSettings.seed
  w.commandBlocksWork0 = proc(): bool {.closure.} = world.levelInfo.gameRules.commandBlocksWork
  w.sendCommandFeedback0 = proc(): bool {.closure.} = world.levelInfo.gameRules.sendCommandFeedback
  w.runCommandBlock0 = proc(position: BlockPos; command: string) {.closure.} =
    let run = world.server.runCommandBlock
    if run != nil:
      run(world, position, command)
  w.createBlockEntity0 = createBlockEntity
  w.blockEntityFromNbt0 = blockEntityFromNbt
  w.blockEntityChanged0 = proc(entity: BlockEntity) {.closure.} = saveBlockEntity(world, entity)
  w.updateBlockEntity0 = proc(entity: BlockEntity) {.closure.} =
    ## `World::update_block_entity`: the entity's chunk data to the players who see the chunk, and the save.
    let position = entity.getPosition()
    let nbt = entity.chunkDataNbt()
    if nbt.isSome:
      var bytes: seq[byte] = @[]
      discard toBytesUnnamed(nbt.unsafeGet, bytes)
      let short = entity.resourceLocation().substr(entity.resourceLocation().find(':') + 1)
      var typeId = 0'i32
      for i in 0 ..< BLOCK_ENTITY_TYPES.len:
        if BLOCK_ENTITY_TYPES[i] == short:
          typeId = int32(i)
          break
      let packet = CBlockEntityData(location: position, typ: newVarInt(typeId), nbtData: bytes)
      let chunk = position.chunkPosition()
      for p in world.players:
        if isWithinViewDistance(chunk, p.chunkPos, int32(getViewDistance(p, world.server))):
          p.client.writePacketFor(packet)
    saveBlockEntity(world, entity)
  w.explode0 = proc(position: Vector3[float64]; power: float32) {.closure.} = explode(world, position, power)
  w.isSpaceEmpty0 = proc(box: BoundingBox): bool {.closure.} = isSpaceEmpty(world, box)
  w.entitiesAtBox0 = proc(box: BoundingBox): seq[BlockActor] {.closure.} =
    result = @[]
    for e in world.getAllAtBox(box):
      result.add(blockActorOf(e))
  w.playersAtBox0 = proc(box: BoundingBox): seq[BlockPlayer] {.closure.} =
    result = @[]
    for p in world.getPlayersAtBox(box):
      result.add(blockPlayerOf(p))
  w.closestPlayer0 = proc(position: Vector3[float64]; radius: float64): Option[BlockPlayer] {.closure.} =
    let p = world.getClosestPlayer(position, radius)
    if p != nil: some(blockPlayerOf(cast[Player](p))) else: none[BlockPlayer]()
  w.playerByUuid0 = proc(uuid: string): Option[BlockPlayer] {.closure.} =
    for p in world.players:
      if $p.gameprofile.id == uuid:
        return some(blockPlayerOf(p))
    none[BlockPlayer]()

# --- The hooks entitymod and the block adapter take from here --------------------------------------------------------------

proc registryOf(world: World): BlockRegistry = BlockWorld(world.blockWorld).blockRegistry

gBlockHooks.onEntityCollision = proc(blockRef: Block; world: World; entity: EntityBase; position: BlockPos;
    state: BlockState; server: Server) {.closure.} =
  ## `world.block_registry.on_entity_collision(block, world, entity, pos, state, server)`
  let blockWorld = BlockWorld(world.blockWorld)
  blockWorld.blockRegistry.onEntityCollision(blockRef, blockWorld, blockActorOf(entity), position, state,
    BlockServer(tickCount: server.tickCounter))
gBlockHooks.onEntityStep = proc(blockRef: Block; world: World; entity: EntityBase; position: BlockPos; state: BlockState;
    belowSupportingBlock: bool) {.closure.} =
  ## `world.block_registry.on_entity_step`
  let blockWorld = BlockWorld(world.blockWorld)
  blockWorld.blockRegistry.onEntityStep(blockRef, blockWorld, blockActorOf(entity), position, state, belowSupportingBlock)

gBlockHooks.onLandedUpon = proc(blockRef: Block; world: World; fallDistance: float32; entity: EntityBase): bool {.closure.} =
  ## `world.block_registry.get_pumpkin_block(..).on_landed_upon`: false when the block has no behaviour.
  let blockWorld = BlockWorld(world.blockWorld)
  blockWorld.blockRegistry.onLandedUpon(blockRef, blockWorld, fallDistance, blockActorOf(entity))
gBlockHooks.updateEntityMovementAfterFallOn = proc(blockRef: Block; entity: EntityBase) {.closure.} =
  ## `world.block_registry.update_entity_movement_after_fall_on`
  let blockWorld = BlockWorld(entity.entity.world.blockWorld)
  blockWorld.blockRegistry.updateEntityMovementAfterFallOn(blockRef, blockActorOf(entity))
gBlockHooks.onEntityCollisionFluid = proc(fluid: Fluid; entity: EntityBase) {.closure.} =
  ## `world.block_registry.on_entity_collision_fluid`
  let blockWorld = BlockWorld(entity.entity.world.blockWorld)
  blockWorld.blockRegistry.onEntityCollisionFluid(fluid, blockActorOf(entity))

gItemHooks.setSpawnerEntityType = proc(world: World; position: BlockPos; entityType: EntityType): bool {.closure.} =
  ## `SpawnEggItem::use_on_block` on a spawner: the entity type goes into the `MobSpawnerBlockEntity`, which is sent again.
  let blockWorld = BlockWorld(world.blockWorld)
  let entity = blockWorld.getBlockEntity(position)
  if entity.isNone:
    return false
  if not (entity.unsafeGet of MobSpawnerBlockEntity):
    return false
  MobSpawnerBlockEntity(entity.unsafeGet).setEntityType(entityType.resourceName)
  blockWorld.updateBlockEntity(entity.unsafeGet)
  true

gSignUpdateHook = proc(world: World; position: BlockPos; isFrontText: bool; lines: array[4, string]): bool {.closure.} =
  ## `handle_sign_update`: the entity at the position, if it is a sign that is not waxed, takes the lines.
  signUpdateText(BlockWorld(world.blockWorld), position, isFrontText, lines)

gPlayerHooks.getSupportingBlockPos = proc(player: Player): Option[BlockPos] {.closure.} =
  ## `Player::get_supporting_block_pos`: the non-air block under the feet closest to the position (ties: smaller y, z, x).
  let entity = playerBase(player).entity
  let entityPos = entity.pos
  let aabb = entity.boundingBox
  let world = entity.world
  let footprint = BoundingBox(min: Vector3[float64](x: aabb.min.x, y: aabb.min.y - 1.0e-6'f64, z: aabb.min.z),
    max: Vector3[float64](x: aabb.max.x, y: aabb.min.y, z: aabb.max.z))
  var closest = none[BlockPos]()
  var minDistSq = 1.7976931348623157e308'f64
  for pos in iterate(footprint.minBlockPos(), footprint.maxBlockPos()):
    let (_, state) = world.getBlockAndState(pos)
    if state.isAir:
      continue
    let dx = float64(pos.vec.x) + 0.5'f64 - entityPos.x
    let dy = float64(pos.vec.y) + 0.5'f64 - entityPos.y
    let dz = float64(pos.vec.z) + 0.5'f64 - entityPos.z
    let distSq = dx * dx + dy * dy + dz * dz
    if distSq < minDistSq:
      minDistSq = distSq
      closest = some(pos)
    elif abs(distSq - minDistSq) < 2.220446049250313e-16'f64:
      if closest.isSome:
        let best = closest.unsafeGet
        if pos.vec.y < best.vec.y or (pos.vec.y == best.vec.y and pos.vec.z < best.vec.z) or
            (pos.vec.y == best.vec.y and pos.vec.z == best.vec.z and pos.vec.x < best.vec.x):
          closest = some(pos)
  if closest.isSome:
    return closest
  let fallback = BlockPos(vec: Vector3[int32](x: int32(floor(entityPos.x)), y: int32(floor(entityPos.y - 0.2'f64)),
    z: int32(floor(entityPos.z))))
  let (_, fallbackState) = world.getBlockAndState(fallback)
  if fallbackState.isAir: none[BlockPos]() else: some(fallback)
gPlayerHooks.incrementStat = proc(player: Player; category: StatisticCategory; id, amount: int32) {.closure.} =
  player.incrementStat(category, id, amount)
gPlayerHooks.setStat = proc(player: Player; category: StatisticCategory; id, value: int32) {.closure.} =
  player.setStat(category, id, value)
gPlayerHooks.handleKilled = proc(player: Player; deathMessage: TextComponent) {.closure.} =
  playerKilled(player, deathMessage)

proc loadEntityChunks(player: Player; chunks: seq[Vector2[int32]]; center: Vector2[int32]) =
  ## `World::spawn_world_entity_chunks`: the entities saved in the chunks a player has just come to watch become live. The
  ## spawn packets go out only to a client that has loaded (after a join or a respawn `sendEntitiesTo` sends them).
  let world = player.world
  let level = world.level
  var sorted: seq[Vector2[int32]] = @[]
  for chunk in chunks:
    sorted.add(chunk)
    var at = sorted.len - 1
    while at > 0:
      let a = sorted[at - 1]
      let b = sorted[at]
      let da = (a.x - center.x) * (a.x - center.x) + (a.y - center.y) * (a.y - center.y)
      let db = (b.x - center.x) * (b.x - center.x) + (b.y - center.y) * (b.y - center.y)
      if da <= db:
        break
      sorted[at - 1] = b
      sorted[at] = a
      dec at
  var pairs: seq[(int32, int32)] = @[]
  for chunk in sorted:
    pairs.add((chunk.x, chunk.y))
  for received in receiveEntityChunks(level, pairs):
    let chunk = received[0]
    let firstLoad = received[1]
    if not level.isChunkWatched(chunk.x, chunk.z):
      # No longer watched: leave the serialized data for the unload path.
      continue
    if firstLoad:
      # First watcher: take the serialized entities and make them live. The live list is the single source of truth,
      # so the chunk's data is cleared: it would be appended again on the next unload.
      let nbts = chunk.data
      chunk.data = @[]
      for nbt in nbts:
        let id = nbt.getString("id")
        if id.isNone:
          continue
        let name = if id.unsafeGet.startsWith("minecraft:"): id.unsafeGet.substr(10) else: id.unsafeGet
        let kind = EntityType.fromName(name)
        if kind.isNone:
          echo "Entity has no valid Entity Type ", id.unsafeGet
          continue
        # Keep the persisted UUID so the entity keeps its identity across reloads.
        var uuid: Uuid
        let saved = nbt.getUuid("UUID")
        if saved.isSome:
          uuid = Uuid(hi: saved.unsafeGet[0], lo: saved.unsafeGet[1])
        else:
          let (_, fresh) = newV4()
          uuid = fresh
        # Pos is zero since it is read from the nbt.
        let entity = gFromType(kind.unsafeGet, Vector3[float64](x: 0.0, y: 0.0, z: 0.0), world, uuid)
        if entity == nil:
          continue
        entity.readNbt(nbt)
        entity.initDataTracker()
        # Clear velocity so the client does not replay the drop animation.
        entity.entity.velocity = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
        world.addEntitySilent(entity)
        if player.clientLoaded:
          player.client.writePacketFor(entity.entity.createSpawnPacket())
          sendEntityDataTo(world, player, entity)
    elif player.clientLoaded:
      # Already live (another watcher loaded them): just tell this player.
      for entity in entitiesOf(world).entities:
        if entity.entity.chunkPos.x == chunk.x and entity.entity.chunkPos.y == chunk.z:
          player.client.writePacketFor(entity.entity.createSpawnPacket())
          sendEntityDataTo(world, player, entity)

proc removeEntitiesInChunks(world: World; chunks: seq[(int32, int32)]) =
  ## `World::remove_entities_in_chunks`: nobody watches these chunks any more, so their entities are saved into the
  ## entity chunks and leave the live list.
  let store = entitiesOf(world)
  var kept: seq[EntityBase] = @[]
  var leaving: seq[EntityBase] = @[]
  for entity in store.entities:
    var inside = false
    for chunk in chunks:
      if entity.entity.chunkPos.x == chunk[0] and entity.entity.chunkPos.y == chunk[1]:
        inside = true
    if inside:
      leaving.add(entity)
    else:
      kept.add(entity)
  store.entities = kept
  for entity in leaving:
    world.saveEntity(entity)

proc effectNamed(effect: string): Option[StatusEffect] =
  StatusEffect.fromName(if effect.startsWith("minecraft:"): effect.substr(10) else: effect)

playermod.gPlayerEffects = PlayerEffectHooks(
  amplifier: proc(player: Player; effect: string): int32 {.closure.} =
    let kind = effectNamed(effect)
    if kind.isNone:
      return -1'i32
    let found = mustLiving(playerBase(player)).getEffect(kind.unsafeGet)
    if found.isSome: int32(found.unsafeGet.amplifier) else: -1'i32,
  add: proc(player: Player; effect: string; duration: int32; amplifier: uint8; showParticles: bool) {.closure.} =
    let kind = effectNamed(effect)
    if kind.isSome:
      mustLiving(playerBase(player)).addEffect(Effect(effectType: kind.unsafeGet, duration: duration, amplifier: amplifier,
        ambient: false, showParticles: showParticles, showIcon: true, blend: false)),
  remove: proc(player: Player; effect: string) {.closure.} =
    let kind = effectNamed(effect)
    if kind.isSome:
      discard mustLiving(playerBase(player)).removeEffect(kind.unsafeGet),
  removeAll: proc(player: Player): bool {.closure.} =
    let living = mustLiving(playerBase(player))
    let any = living.activeEffects.len > 0
    living.resetEffectsAndAttributes()
    any)

chunker.gLoadEntityChunksHook = proc(player: Player; chunks: seq[Vector2[int32]]; center: Vector2[int32]) {.closure.} =
  loadEntityChunks(player, chunks, center)
chunker.gRemoveEntitiesInChunksHook = proc(world: World; chunks: seq[(int32, int32)]) {.closure.} =
  removeEntitiesInChunks(world, chunks)

# The light reads of `World` that mobs ask for (`is_dark_enough_to_spawn`, the sun burn, bats): `get_sky_light_level`,
# `get_block_light_level` and `get_max_local_raw_brightness` over the level's light engine.
aibase.gGetSkyLightLevel = proc(world: World; pos: BlockPos): uint8 {.closure.} =
  getSkyLightLevel(world.level.lightAccess, pos)
aibase.gGetBlockLightLevel = proc(world: World; pos: BlockPos): Option[uint8] {.closure.} =
  let (found, light) = getBlockLightLevel(world.level.lightAccess, pos)
  if found: some(light) else: none[uint8]()
mobvts.gGetMaxLocalRawBrightness = proc(world: World; pos: BlockPos): uint8 {.closure.} =
  let (found, blockLight) = getBlockLightLevel(world.level.lightAccess, pos)
  max(getSkyLightLevel(world.level.lightAccess, pos), (if found: blockLight else: 0'u8))

villagermod.gOpenHandledScreen = proc(player: Player; factory: ScreenHandlerFactory; pos: Option[BlockPos]): Option[uint8] {.closure.} =
  playermod.openHandledScreen(player, factory, pos)
villagermod.gBedSetOccupied = proc(occupied: bool; world: World; blockRef: Block; pos: BlockPos; stateId: BlockStateId) {.closure.} =
  setOccupied(occupied, BlockWorld(world.blockWorld), blockRef, pos, stateId)
playermod.gWakeUpHook = proc(player: Player) {.closure.} = wakeUpPlayer(player)
gPlayerHooks.addExperiencePoints = proc(player: Player; amount: int32) {.closure.} = playerxp.addExperiencePoints(player, amount)
gPlayerHooks.applyMendingFromXp = proc(player: Player; amount: int32): int32 {.closure.} = playerxp.applyMendingFromXp(player, amount)
playermod.gPlayerLivingWriteHook = proc(player: Player; nbt: var NbtCompound) {.closure.} =
  ## What `Entity::write_nbt` and `LivingEntity::write_nbt` add to a player's data that `Player::write_nbt` does not repeat.
  let base = playerBase(player)
  let entity = base.entity
  nbt.putShort("Fire", cast[int16](entity.fireTicks))
  nbt.putInt("PortalCooldown", int32(entity.portalCooldown))
  nbt.putInt("TicksFrozen", entity.frozenTicks)
  nbt.putShort("Air", int16(breathmod.breathOf(player).airSupply))
  let living = mustLiving(base)
  if living.activeEffects.len > 0:
    var effectsList: seq[NbtTag] = @[]
    for effect in living.activeEffects:
      var effectNbt = newCompound()
      effectToNbt(effect, effectNbt)
      effectsList.add(nbtTag(effectNbt))
    nbt.put("active_effects", NbtTag(kind: ntkList, listVal: effectsList))
playermod.gPlayerLivingReadHook = proc(player: Player; nbt: NbtCompound) {.closure.} =
  ## Their `read_nbt` halves: the fire, the portal cooldown, the frozen ticks, the air and the effects.
  let base = playerBase(player)
  let entity = base.entity
  let fire = nbt.getShort("Fire")
  entity.fireTicks = if fire.isSome: int32(fire.unsafeGet) else: 0'i32
  let portal = nbt.getInt("PortalCooldown")
  entity.portalCooldown = if portal.isSome: cast[uint32](portal.unsafeGet) else: 0'u32
  let frozen = nbt.getInt("TicksFrozen")
  entity.frozenTicks = if frozen.isSome: frozen.unsafeGet else: 0'i32
  let air = nbt.getShort("Air")
  if air.isSome:
    breathmod.breathOf(player).airSupply = clamp(int32(air.unsafeGet), 0'i32, breathmod.MaxAir)
  let living = mustLiving(base)
  let nbtEffects = nbt.getList("active_effects")
  if nbtEffects.isSome:
    for tag in nbtEffects.unsafeGet:
      if tag.kind == ntkCompound:
        let parsed = effectFromNbt(tag.compoundVal)
        if parsed.isSome:
          var effect = parsed.unsafeGet
          effect.blend = true
          var at = -1
          for i in 0 ..< living.activeEffects.len:
            if living.activeEffects[i].effectType.id == effect.effectType.id:
              at = i
          if at >= 0:
            living.activeEffects[at] = effect
          else:
            living.activeEffects.add(effect)
playermod.gPlayerKillHook = proc(player: Player) {.closure.} =
  let base = playerBase(player)
  base.kill(base)
playermod.gPlayerDamageHook = proc(player: Player; amount: float32; damageType: string): bool {.closure.} =
  let (found, kind) = damageTypeFromName(if damageType.startsWith("minecraft:"): damageType.substr(10) else: damageType)
  let base = playerBase(player)
  base.damageWithContext(base, amount, (if found: kind else: GENERIC), none[Vector3[float64]](), nil, nil)

playermod.gFallHook = proc(player: Player; heightDifference: float64; ground, dontDamage: bool) {.closure.} =
  ## `LivingEntity::fall` with its damage: `handle_fall_damage` goes through the player's `damage_with_context`.
  let base = playerBase(player)
  mustLiving(base).fall(base, heightDifference, ground, dontDamage)
  syncToPlayer(base)

playermod.gDropItemHook = proc(player: Player; item: ItemStack) {.closure.} = itembehaviour.dropItem(player, item)
worldmod.gCalculateRespawnHook = proc(world: World; player: Player): Option[CalculatedRespawnPoint] {.closure.} =
  calculateRespawnPoint(world, player)
worldmod.gPlayerRespawnedHook = proc(world: World; player: Player) {.closure.} =
  ## `LivingEntity::reset_state` on the entity half, and the breath.
  let base = playerBase(player)
  mustLiving(base).resetState()
  syncToPlayer(base)
  breathmod.breathOf(player).reset(player)

let portalsThenLiving = gPlayerEntityTickHook
gPlayerEntityTickHook = proc(world: World; player: Player; server: Server) {.closure.} =
  portalsThenLiving(world, player, server)
  playerLivingTick(world, player, server)
