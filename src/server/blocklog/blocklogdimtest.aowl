## Phase 4: block log records raised inside dimension jobs are queued and recorded in the join phase; the log written with 3 worlds ticked on
## 4 workers equals the log of the sequential loop (records, causes, actor names and their interned indices).
import std/[syncio, times]
import blocklogcore
import ../sim/[dimtick, jobpool]

var folderN = 0
let dims = ["minecraft:overworld", "minecraft:the_nether", "minecraft:the_end"]

proc fresh(): string =
  inc folderN
  "C:/m/blogdim_" & $int64(toUnix(getTime())) & "_" & $folderN

proc worldTick(i: int) =
  let ctx = blockLogPush(CauseBreak, KindPlayer, "P" & $i)
  for k in 0 ..< 40:
    blockLogRecordChange(dims[i], i * 100 + k, 64, k, 1, 2 + k mod 3)
  blockLogPop(ctx)
  blockLogRecordChange(dims[i], 7, 7, 7, 5, 5)   # no change: nothing logged

proc signature(): seq[string] =
  blockLogFlush()
  result = @[]
  for d in 0 ..< 3:
    let recs = blockLogQuery(LogQuery(dim: findDim(dims[d]), x: 0, y: 0, z: 0, radius: -1, sinceT: 0, actor: -1))
    var line = dims[d] & ":" & $recs.len
    for r in recs:
      line = line & "|" & $r.x & "," & $r.y & "," & $r.z & "," & $r.oldS & "," & $r.newS & "," & $r.cause & "," & $r.kind & "," & userName(int(r.actor))
    result.add line

proc main() =
  var fails = 0
  blockLogInit(fresh())
  for t in 1 .. 3:
    runSequential(3, worldTick)
  let seqSig = signature()
  blockLogInit(fresh())
  let pool = newJobPool(5)
  let owner = allocOwner(pool)
  for t in 1 .. 3:
    let failed = runDimTicks(pool, owner, 3, worldTick)
    if failed != 0: inc fails
  let dimSig = signature()
  shutdown(pool)
  for d in 0 ..< 3:
    if seqSig[d] != dimSig[d]:
      inc fails
      echo "FAIL dimension ", d, " differs"
  if seqSig[0].len < 100: inc fails
  echo "sequential: ", seqSig[1].len, " chars for the nether; dimension jobs: ", dimSig[1].len, " chars"
  echo "actor of world 2 in the log: ", (if findUser("P2") >= 0: "interned" else: "MISSING")
  if findUser("P0") != 0 or findUser("P1") != 1 or findUser("P2") != 2:
    inc fails
    echo "FAIL actor indices not interned in world order"
  if fails == 0:
    echo "blocklogdimtest passed"
  else:
    echo "blocklogdimtest FAILED ", fails
    quit(1)

main()
