## The `/body` command (op level 4): assemble, list, info, settle, remove, impulse, collapse, status. A thin wrapper: the work and the
## reply lines are `bodyExec` in bodymanager.aowl, so tests drive the same code without a command source.
##
##   /body assemble <x1 y1 z1 x2 y2 z2>    every connected set of movable blocks inside the box becomes a body (~ is relative)
##   /body list | status                    live bodies | counters
##   /body info <id>                        mass, centre, velocity, sleep, journal file
##   /body settle <id>                      put the blocks back at the nearest grid pose (needs a free spot, else refused)
##   /body remove <id>                      the same, but with no free spot the blocks drop as items; the body is gone
##   /body impulse <id> <vx vy vz>          debug: add velocity (blocks per tick) and wake the body
##   /body collapse <x1 y1 z1 x2 y2 z2>     structural check of the box: failed blocks break, loose parts become bodies
##   /body triggers off|structures|full|status   the automatic collapse triggers of this world (default off), see trigger.aowl

import ../../util/closureset
import std/[options, strutils, math]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector3, permission]
import ../../util/text/[textbase, text, color]
import ../serverbase
import bodymanager, trigger

const
  Names = ["body", "bodies"]
  Description = "Moving block bodies: assemble, settle, inspect, structural collapse."
  ArgRest = "args"
  Permission0* = "body:command.body"

proc registerPermission*(registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))

proc worldOf(sender: CommandSender; server: nil CommandServer): nil CommandWorld =
  if sender.kind == cskPlayer and sender.player.entity != nil and closureSet(sender.player.entity.getWorld):
    return sender.player.entity.getWorld()
  if server != nil and closureSet(server.getOverworld):
    return server.getOverworld()
  nil

proc bodyCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var line = ""
  discard findMsg(args, ArgRest, line)
  let parts = line.splitWhitespace()
  let cw = worldOf(sender, server)
  if cw == nil:
    sendMessage(sender, colorNamed(text("No world"), ncRed))
    return cmdSuccess(0'i32)
  let found = worldByDim(cw.dimensionName)
  if found.isNone:
    sendMessage(sender, colorNamed(text("The body manager has not seen this world yet (no tick ran)."), ncRed))
    return cmdSuccess(0'i32)
  var ox = 0'i32
  var oy = 0'i32
  var oz = 0'i32
  if sender.kind == cskPlayer and sender.player.entity != nil and closureSet(sender.player.entity.getPos):
    let p = sender.player.entity.getPos()
    ox = int32(floor(p.x))
    oy = int32(floor(p.y))
    oz = int32(floor(p.z))
  elif closureSet(cw.getSpawnPoint):
    let sp = cw.getSpawnPoint()
    ox = sp.x
    oy = sp.y
    oz = sp.z
  let lines = (if parts.len > 0 and parts[0] == "triggers": triggerExec(found.get, parts[1 .. ^1]) else: bodyExec(found.get, ox, oy, oz, parts, bodyLastTick()))
  for l in lines:
    sendMessage(sender, text(l))
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(execute(newCommandTree(Names, Description), bodyCommand), execute(argument(ArgRest, newMsgArgConsumer()), bodyCommand))
