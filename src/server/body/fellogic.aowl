## The PURE part of tree felling (fell.aowl is the world side): which cells of a tree lost their trunk, which leaves go with them, where
## the pivot is and how the piece starts to topple. Imports only std, so felltest.aowl runs it with no server.
##
## INPUT. A dense box of cell classes (index x + nx*(z + nz*y), y slowest, like the solver and triggerlogic):
##   FcEmpty    air, fluids, plants: carries nothing, supports nothing
##   FcLog      a block of the `minecraft:logs` tag (trunks, branches, stems, wood)
##   FcLeaf     a block of the `minecraft:leaves` tag
##   FcSupport  any other structural block with a collision shape (dirt, stone, planks, a wall): GROUND for a log that touches it
## and the cut cell (box local) whose block was just removed.
##
## RULES (conservative: when in doubt the tree stands).
##   1. Seeds: the log cells among the 26 neighbours of the cut.
##   2. Each seed's log component is flood filled through logs, 26-connected (diagonal branches of acacia/jungle/dark oak belong to their trunk).
##   3. A component is GROUNDED when one of its logs has a 6-neighbour of class FcSupport, or the component reaches the box boundary (what lies
##      beyond is unknown, so it counts as support), or it has more than `maxCells` logs. Leaves never support: a canopy touching another tree
##      or the ground does not hold a trunk up. A grounded component stays.
##   4. A free component takes its leaves: a multi-source breadth-first search through leaf cells (6-connected, at most `leafReach` steps)
##      started at the same time from the component's logs and from EVERY OTHER log of the box; a leaf goes with the component when the
##      component reaches it strictly first (vanilla leaf distance semantics: a leaf belongs to its nearest trunk, ties stay).
##   5. More than `maxCells` cells (logs + leaves) in total: skipped (too large), the world is left as it is.
##   6. Pivot: the centre of the bottom face of the lowest log layer of the component (the cut face), box local.
##
## TOPPLE (toppleStart). The piece starts as a rigid rotation about a horizontal axis through the pivot, falling toward `dir` (unit, horizontal):
## angular velocity w = w0 * (up x dir), centre of mass velocity v = w x (com - pivot) (blocks per tick, rad per tick, the body's units).
## Gravity then does the rest in the integrator: the base lands on the stump or the ground and the offset centre of mass keeps it turning.
## This is the FREE fall, used only when the hinged fall of fellmotion.aowl does not apply (no support within 3 blocks below the trunk).

import std/[math]

const
  FcEmpty* = 0'u8
  FcLog* = 1'u8
  FcLeaf* = 2'u8
  FcSupport* = 3'u8

type
  FellPiece* = object
    logs*: seq[int]            ## dense indices
    leaves*: seq[int]
    pivot*: (float64, float64, float64)   ## box local
    minY*, maxY*: int

  FellAnalysis* = object
    pieces*: seq[FellPiece]    ## free components to fell
    grounded*: int             ## seed components that are still supported
    tooLarge*: int             ## free components skipped for size
    seeds*: int

proc fidx(nx, nz, x, y, z: int): int = x + nx * (z + nz * y)

proc onBoundary(nx, ny, nz, x, y, z: int): bool =
  x == 0 or y == 0 or z == 0 or x == nx - 1 or y == ny - 1 or z == nz - 1

proc analyzeFell*(cls: seq[uint8]; nx, ny, nz: int; cx, cy, cz: int; maxCells: int; leafReach: int): FellAnalysis =
  result = FellAnalysis(pieces: @[], grounded: 0, tooLarge: 0, seeds: 0)
  if nx <= 0 or ny <= 0 or nz <= 0 or cls.len < nx * ny * nz:
    return
  let total = nx * ny * nz
  var comp = newSeq[int32](total)     # 0 unvisited, k > 0 component k
  var nextComp = 1'i32
  var freeComps: seq[int32] = @[]
  var freeCells: seq[seq[int]] = @[]
  for dy in -1 .. 1:
    for dz in -1 .. 1:
      for dx in -1 .. 1:
        if dx == 0 and dy == 0 and dz == 0:
          continue
        let x = cx + dx
        let y = cy + dy
        let z = cz + dz
        if x < 0 or y < 0 or z < 0 or x >= nx or y >= ny or z >= nz:
          continue
        let s = fidx(nx, nz, x, y, z)
        if cls[s] != FcLog or comp[s] != 0'i32:
          continue
        inc result.seeds
        # flood fill this component (26-connected through logs)
        let k = nextComp
        inc nextComp
        var members: seq[int] = @[]
        var stack: seq[int] = @[s]
        comp[s] = k
        var grounded = false
        var overflow = false
        while stack.len > 0:
          let c = stack.pop()
          members.add(c)
          if members.len > maxCells:
            overflow = true
          let y0 = c div (nx * nz)
          let r = c - y0 * nx * nz
          let z0 = r div nx
          let x0 = r - z0 * nx
          if onBoundary(nx, ny, nz, x0, y0, z0):
            grounded = true
          # support: a 6-neighbour that is ground
          if x0 > 0 and cls[c - 1] == FcSupport: grounded = true
          if x0 < nx - 1 and cls[c + 1] == FcSupport: grounded = true
          if z0 > 0 and cls[c - nx] == FcSupport: grounded = true
          if z0 < nz - 1 and cls[c + nx] == FcSupport: grounded = true
          if y0 > 0 and cls[c - nx * nz] == FcSupport: grounded = true
          if y0 < ny - 1 and cls[c + nx * nz] == FcSupport: grounded = true
          for ey in max(0, y0 - 1) .. min(ny - 1, y0 + 1):
            for ez in max(0, z0 - 1) .. min(nz - 1, z0 + 1):
              for ex in max(0, x0 - 1) .. min(nx - 1, x0 + 1):
                let n = fidx(nx, nz, ex, ey, ez)
                if cls[n] == FcLog and comp[n] == 0'i32:
                  comp[n] = k
                  stack.add(n)
        if overflow:
          inc result.tooLarge
          continue
        if grounded:
          inc result.grounded
          continue
        freeComps.add(k)
        freeCells.add(members)
  if freeComps.len == 0:
    return
  # leaves: one multi-source BFS per free component, against every other log of the box
  for fi in 0 ..< freeComps.len:
    let k = freeComps[fi]
    var owner = newSeq[uint8](total)    # 0 unreached, 1 this component, 2 another trunk
    var frontier: seq[int] = @[]
    for c in 0 ..< total:
      if cls[c] == FcLog:
        owner[c] = (if comp[c] == k: 1'u8 else: 2'u8)
        frontier.add(c)
    var leaves: seq[int] = @[]
    var depth = 0
    while frontier.len > 0 and depth < leafReach:
      inc depth
      # two passes so that "another trunk" wins ties: claims by owner 2 first, then owner 1
      var next: seq[int] = @[]
      for pass in [2'u8, 1'u8]:
        for c in frontier:
          if owner[c] != pass:
            continue
          let y0 = c div (nx * nz)
          let r = c - y0 * nx * nz
          let z0 = r div nx
          let x0 = r - z0 * nx
          var ns: array[6, int] = [-1, -1, -1, -1, -1, -1]
          if x0 > 0: ns[0] = c - 1
          if x0 < nx - 1: ns[1] = c + 1
          if z0 > 0: ns[2] = c - nx
          if z0 < nz - 1: ns[3] = c + nx
          if y0 > 0: ns[4] = c - nx * nz
          if y0 < ny - 1: ns[5] = c + nx * nz
          for n in ns:
            if n >= 0 and cls[n] == FcLeaf and owner[n] == 0'u8:
              owner[n] = pass
              next.add(n)
              if pass == 1'u8:
                leaves.add(n)
      frontier = next
    let logs = freeCells[fi]
    if logs.len + leaves.len > maxCells:
      inc result.tooLarge
      continue
    var minY = high(int)
    var maxY = -1
    for c in logs:
      let y0 = c div (nx * nz)
      if y0 < minY: minY = y0
      if y0 > maxY: maxY = y0
    for c in leaves:
      let y0 = c div (nx * nz)
      if y0 > maxY: maxY = y0
    var sx = 0.0
    var sz = 0.0
    var n = 0
    for c in logs:
      let y0 = c div (nx * nz)
      if y0 == minY:
        let r = c - y0 * nx * nz
        let z0 = r div nx
        let x0 = r - z0 * nx
        sx += float64(x0) + 0.5
        sz += float64(z0) + 0.5
        inc n
    result.pieces.add(FellPiece(logs: logs, leaves: leaves, pivot: (sx / float64(n), float64(minY), sz / float64(n)), minY: minY, maxY: maxY))

proc fallDir*(fromX, fromZ, toX, toZ: float64; fallbackX, fallbackZ: float64): (float64, float64) =
  ## The horizontal unit direction from (fromX, fromZ) toward (toX, toZ): a tree falls AWAY from the one who cut it (from = the player,
  ## to = the cut). When the two are within 0.05 blocks horizontally the fallback (e.g. the wind) is used, and when that is near zero +x.
  var dx = toX - fromX
  var dz = toZ - fromZ
  var l = sqrt(dx * dx + dz * dz)
  if l < 0.05:
    dx = fallbackX
    dz = fallbackZ
    l = sqrt(dx * dx + dz * dz)
    if l < 1e-6:
      return (1.0, 0.0)
  (dx / l, dz / l)

proc cardinalDir*(dx, dz: float64): (float64, float64) =
  ## The cardinal direction (+-x or +-z) nearest to (dx, dz); +x for a zero vector, x wins a tie. A felled tree falls along a grid axis
  ## so that, turned by 90 degrees about a hinge on a grid line, its cells land on grid cells (fellmotion.aowl).
  if abs(dx) < 1e-9 and abs(dz) < 1e-9:
    return (1.0, 0.0)
  if abs(dx) >= abs(dz):
    return ((if dx >= 0.0: 1.0 else: -1.0), 0.0)
  (0.0, (if dz >= 0.0: 1.0 else: -1.0))

proc toppleStart*(pivot, com: (float64, float64, float64); dir: (float64, float64); w0: float64):
    ((float64, float64, float64), (float64, float64, float64)) =
  ## (angular velocity, centre of mass velocity) of a rigid rotation about the horizontal axis through `pivot` that tips the piece toward
  ## `dir`. Axis = up x dir = (dir.z, 0, -dir.x); v = w x (com - pivot).
  let wx = dir[1] * w0
  let wy = 0.0
  let wz = -dir[0] * w0
  let rx = com[0] - pivot[0]
  let ry = com[1] - pivot[1]
  let rz = com[2] - pivot[2]
  let vx = wy * rz - wz * ry
  let vy = wz * rx - wx * rz
  let vz = wx * ry - wy * rx
  ((wx, wy, wz), (vx, vy, vz))
