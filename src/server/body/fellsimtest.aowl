## Integrator scenes for tree felling. HINGE (fellmotion.aowl): the oak with its crown drops into the cut and turns about a hinge on a grid
## line; the leaves that hit the ground break while it falls (ground side only), the logs end within 0.05 block / 2 degrees of their
## grid pose (no snap: the conversion moves less than one tick of the fall), the remaining leaves decay lowest first over 2 to 4 s;
## a rock in the way releases the hinge to the free integrator and the residual correction glides at most 0.08 blocks per tick.
## FREE FALL (the fallback): a REAL oak (oak_log trunk of 5, oak_leaves crown) cut at its base falls one block onto a flat floor,
## started as fellogic.toppleStart says (toward +x, 0.05 rad/tick about the cut face), and must topple: come to rest within 20 s, lying
## (trunk axis within 35 degrees of +x), its centre of mass moved 2+ blocks toward +x and not sunk into the floor. Then the same tree with
## its leaves shed (logs only, as bodymanager.settleFelled does) rests and snaps to a grid rotation that turns `y` into `x`.
## Build: aowlmony c -p:src src/server/body/fellsimtest.aowl ; exit 0 and "ALL PASS" when everything holds.

{.feature: "untyped".}

import std/[syncio, math]
import "../../generated/block_properties"
import ../../physics/[body, bodymass, materials, integrator]
import fellogic, fellmotion

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "PASS ", what
  else:
    echo "FAIL ", what
    inc failures

proc sid(name: string): int =
  let b = Block.fromName(name)
  if b == nil:
    echo "FAIL unknown block ", name
    inc failures
    return 0
  int(asU16(b.defaultState.id))

proc floorSolid(x, y, z: int): bool = y < 0

proc oakCells(log, leaf: int; withLeaves: bool): seq[Cell] =
  result = @[]
  for y in 1 .. 5:
    result.add Cell(x: 0, y: int32(y), z: 0, state: int32(log))
  if withLeaves:
    for y in 4 .. 5:
      for dz in -2 .. 2:
        for dx in -2 .. 2:
          if dx != 0 or dz != 0:
            result.add Cell(x: int32(dx), y: int32(y), z: int32(dz), state: int32(leaf))
    for dz in -1 .. 1:
      for dx in -1 .. 1:
        result.add Cell(x: int32(dx), y: 6, z: int32(dz), state: int32(leaf))

proc minWorldY(b: Body): float64 =
  result = 1e300
  for c in cellList(b):
    for k in 0 ..< 8:
      let p = b.pos + rotate(b.orient, Vec3(x: float64(c.x) + float64(k and 1), y: float64(c.y) + float64((k shr 1) and 1),
        z: float64(c.z) + float64((k shr 2) and 1)))
      if p.y < result: result = p.y

proc fall(cells: seq[Cell]; label: string): Body =
  let b = bodyFromCells(7'u64, 1'u64, cells)
  recomputeMass(b, defaultProps)
  let com0 = comWorld(b)
  let (w, v) = toppleStart((0.5, 1.0, 0.5), (com0.x, com0.y, com0.z), (1.0, 0.0), 0.05)
  b.angVel = Vec3(x: w[0], y: w[1], z: w[2])
  b.vel = Vec3(x: v[0], y: v[1], z: v[2])
  let sim = newSim(b)
  let env = SimEnv(solidAt: floorSolid)
  var t = 0
  var lowest = 1e300
  while t < 400 and not b.sleeping:
    discard stepBody(sim, env, t)
    let my = minWorldY(b)
    if my < lowest: lowest = my
    inc t
  let up = rotate(b.orient, Vec3(x: 0.0, y: 1.0, z: 0.0))
  let ang = arccos(max(-1.0, min(1.0, up.x))) * 180.0 / PI
  let com1 = comWorld(b)
  echo "  ", label, ": rest after ", t, " ticks, trunk axis ", ang, " deg from +x, com x ", com0.x, " -> ", com1.x, ", y ", com0.y, " -> ",
    com1.y, ", lowest point ", lowest
  check(b.sleeping, label & ": comes to rest within 20 s")
  check(ang < 35.0, label & ": lies down toward +x (trunk axis " & $ang & " deg from +x)")
  check(com1.x - com0.x > 2.0, label & ": the crown moved toward +x")
  check(lowest > -0.15, label & ": never sinks into the floor (lowest " & $lowest & ")")
  b

proc rockSolid(x, y, z: int): bool = y < 0 or (x == 3 and y == 0 and z == 0)

proc lowestHard(b: Body): float64 =
  result = 1e300
  for c in cellList(b):
    if not isSoftState(c.state):
      for k in 0 ..< 8:
        let p = b.pos + rotate(b.orient, Vec3(x: float64(c.x) + float64(k and 1), y: float64(c.y) + float64((k shr 1) and 1),
          z: float64(c.z) + float64((k shr 2) and 1)))
        if p.y < result: result = p.y

proc hingeScene(log, leaf: int) =
  ## The hinge on flat ground: the oak (crown included) drops into the cut, turns by 90 degrees about the hinge on the grid line x = 1,
  ## the leaves that hit the ground break as they hit, the logs end exactly on grid cells; then the remaining leaves decay over time.
  var b = bodyFromCells(9'u64, 1'u64, oakCells(log, leaf, true))
  recomputeMass(b, defaultProps)
  let leaves0 = softCount(b)
  let dir = cardinalDir(0.9, 0.3)
  check(dir[0] == 1.0 and dir[1] == 0.0, "hinge: the fall direction is the nearest cardinal (+x)")
  var h = hingeStart(b, dir, 0.05, 0.08, floorSolid)
  check(h.phase == hpDrop and h.drop == 1.0, "hinge: starts by dropping one block into the cut (phase " & $h.phase & ", drop " & $h.drop & ")")
  check(abs(h.pivot.x - 1.0) < 1e-9 and abs(h.pivot.y) < 1e-9, "hinge: the axis lies on the grid line x = 1, y = 0")
  var t = 0
  var maxTick = 0.0
  var brokenFall: seq[Cell] = @[]
  var brokenAwaySide = 0
  var brokenAbove = 0
  var lowest = 1e300
  var ev = heNone
  var firstBreak = -1
  var landTick = -1
  while t < 200:
    let p0 = b.pos
    let q0 = b.orient
    ev = hingeTick(h, b, floorSolid)
    let shift = poseShift(b, p0, q0)
    if shift > maxTick: maxTick = shift
    let lh = lowestHard(b)
    if lh < lowest: lowest = lh
    let hit = contactSoftCells(b, floorSolid)
    for c in hit:
      let w = b.pos + rotate(b.orient, Vec3(x: float64(c.x) + 0.5, y: float64(c.y) + 0.5, z: float64(c.z) + 0.5))
      if c.x < 0: inc brokenAwaySide
      if w.y > 1.0: inc brokenAbove
      brokenFall.add(c)
    if hit.len > 0:
      if firstBreak < 0: firstBreak = t
      b = withoutCells(b, hit)
    inc t
    if ev == heLanded or ev == heReleased:
      break
  landTick = t
  let left = softCount(b)
  echo "  hinge: ", ev, " after ", t, " ticks, ", brokenFall.len, " of ", leaves0, " leaves broke on contact (first at tick ", firstBreak,
    "), ", left, " left, largest per-tick move ", maxTick, ", lowest log point ", lowest
  check(ev == heLanded, "hinge: lands (not released) on flat ground")
  check(t < 100, "hinge: the fall takes less than 5 s (" & $t & " ticks)")
  check(brokenFall.len > 0 and left > 0, "hinge: some leaves broke on contact, some are left")
  check(firstBreak >= 0 and firstBreak < landTick - 1, "hinge: leaves break while it falls, not only at the end (first at tick " &
    $firstBreak & ", landed at " & $landTick & ")")
  check(brokenAwaySide == 0, "hinge: no leaf on the side away from the ground broke (" & $brokenAwaySide & ")")
  check(brokenAbove == 0, "hinge: every leaf that broke was at ground level or below (" & $brokenAbove & " above)")
  var leftAbove = true
  for c in cellList(b):
    if isSoftState(c.state):
      let w = b.pos + rotate(b.orient, Vec3(x: float64(c.x) + 0.5, y: float64(c.y) + 0.5, z: float64(c.z) + 0.5))
      if w.y < 1.0: leftAbove = false
  check(leftAbove, "hinge: the leaves left are all above the trunk (away from the ground)")
  check(lowest > -0.01, "hinge: the logs never sink into the floor (lowest " & $lowest & ")")
  # the pose the blocks go to
  let sim = newSim(b)
  let plan = settlePlan(sim, floorSolid, 7.0, 4, false)
  check(plan.ok, "hinge: a settle spot exists (" & plan.reason & ")")
  if plan.ok:
    let err = poseShift(b, plan.pos, matToQuat(plan.rot))
    echo "  hinge: pose error at rest ", err, " blocks, ", plan.angleErr * 180.0 / PI, " deg, settle offset ", plan.dx, " ", plan.dy, " ", plan.dz
    check(err < 0.05 and plan.angleErr < 2.0 * PI / 180.0, "hinge: rests within 0.05 block / 2 deg of its grid pose")
    check(err <= maxTick, "hinge: the conversion to blocks moves less than one tick of the fall did")
    var ok = true
    for pc in plan.cells:
      if not isSoftState(int32(pc.state)) and (pc.y != 0 or pc.z != 0 or pc.x < 1 or pc.x > 5):
        ok = false
    check(ok, "hinge: the logs go to x 1..5, y 0, z 0 (lying on the floor beyond the cut)")
  # gradual decay of the remaining leaves
  let n0 = softCount(b)
  let every = decayEvery(n0)
  var step = 0
  var firstY = -1e300
  var lastY = 1e300
  var batches = 0
  var tick = 0
  var maxBatch = 0
  var lastTick = 0
  var ordered = true
  var prevMax = -1e300
  while softCount(b) > 0 and tick < 400:
    if tick mod every == 0:
      let batch = decayBatch(b, decayCount(n0, step))
      inc step
      var bmin = 1e300
      var bmax = -1e300
      for c in batch:
        let w = b.pos + rotate(b.orient, Vec3(x: float64(c.x) + 0.5, y: float64(c.y) + 0.5, z: float64(c.z) + 0.5))
        if w.y < bmin: bmin = w.y
        if w.y > bmax: bmax = w.y
      if bmin < prevMax - 0.6: ordered = false
      prevMax = max(prevMax, bmax)
      if batches == 0: firstY = bmin
      lastY = bmax
      if batch.len > maxBatch: maxBatch = batch.len
      b = withoutCells(b, batch)
      inc batches
      lastTick = tick
    inc tick
  echo "  decay: ", n0, " leaves in ", batches, " batches of up to ", maxBatch, " over ", lastTick, " ticks, lowest first y ", firstY, " last ", lastY
  check(softCount(b) == 0, "decay: every leaf goes")
  check(batches >= 10 and lastTick >= 40 and lastTick <= 80, "decay: spread over 2 to 4 s, not one tick (" & $batches & " batches, " & $lastTick & " ticks)")
  check(ordered and firstY <= lastY, "decay: nearest to the ground first")
  check(cellCount(b) == 5, "decay: the 5 logs stay")

proc releaseScene(log, leaf: int) =
  ## A rock in the way: the hinge lets go, the free integrator finishes the fall, and the remaining correction to the grid is spread
  ## over several ticks (glideStep), never more than 0.08 blocks per tick.
  var b = bodyFromCells(11'u64, 1'u64, oakCells(log, leaf, false))
  recomputeMass(b, defaultProps)
  var h = hingeStart(b, (1.0, 0.0), 0.05, 0.08, rockSolid)
  var ev = heNone
  var t = 0
  while t < 200 and h.phase != hpReleased and h.phase != hpLanded:
    ev = hingeTick(h, b, rockSolid)
    inc t
  check(h.phase == hpReleased, "release: the rock ends the hinge (" & $h.phase & " after " & $t & " ticks)")
  let sim = newSim(b)
  let env = SimEnv(solidAt: rockSolid)
  var k = 0
  var tuned = false
  while k < 400 and not b.sleeping:
    discard stepBody(sim, env, k)
    if not tuned and hardTouches(b, rockSolid):
      tuned = true
      landedParams(sim.params)
    inc k
  check(b.sleeping, "release: the free integrator brings it to rest (" & $k & " ticks)")
  var glides = 0
  var worst = 0.0
  var plan = settlePlan(sim, rockSolid, 7.0, 4, false)
  check(plan.ok, "release: a settle spot exists (" & plan.reason & ")")
  let err0 = (if plan.ok: poseShift(b, plan.pos, matToQuat(plan.rot)) else: 0.0)
  while plan.ok and glides < 60:
    let p0 = b.pos
    let q0 = b.orient
    let done = glideStep(b, plan.pos, matToQuat(plan.rot), 0.08)
    let s = poseShift(b, p0, q0)
    if s > worst: worst = s
    inc glides
    if done: break
    plan = settlePlan(sim, rockSolid, 7.0, 4, false)
  let r = settle(sim, rockSolid, 7.0, 4, false)
  echo "  release: residual ", err0, " blocks glided in ", glides, " ticks, largest glide step ", worst
  check(worst <= 0.0801, "release: no glide step moves a cell more than 0.08 blocks (" & $worst & ")")
  check(r.ok, "release: settles after the glide (" & r.reason & ")")

proc main() =
  let log = sid("oak_log")
  let leaf = sid("oak_leaves")
  check(log > 0 and leaf > 0, "block states")
  check(isSoftState(int32(leaf)) and not isSoftState(int32(log)), "leaves are soft, logs are not")
  hingeScene(log, leaf)
  releaseScene(log, leaf)
  discard fall(oakCells(log, leaf, true), "oak with crown")
  let bare = fall(oakCells(log, leaf, false), "bare trunk")
  let sim = newSim(bare)
  let r = settle(sim, floorSolid, 7.0, 4, false)
  check(r.ok, "bare trunk settles to the grid (" & r.reason & ")")
  if r.ok:
    check(abs(r.rot[1]) > 0.9 or abs(r.rot[4]) < 0.1, "the settle rotation turns the trunk axis off vertical")
    var ylo = 1000000
    var yhi = -1000000
    for c in r.cells:
      if int(c.y) < ylo: ylo = int(c.y)
      if int(c.y) > yhi: yhi = int(c.y)
    check(ylo == 0 and yhi == 0, "the logs lie in one layer on the floor (y " & $ylo & ".." & $yhi & ")")
  if failures == 0:
    echo "ALL PASS"
  else:
    echo $failures, " FAILED"
    quit(1)

main()
