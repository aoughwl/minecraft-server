## Pure tests of the tree felling logic (fellogic.aowl): a cut oak falls with its own leaves, a stump stays, a 2x2 trunk with one log cut
## stands, a log touching a wall stands, the neighbour tree keeps its leaves (ties stay), the size cap, the box boundary rule, a stone
## pillar (no logs) never fells, the fall direction and the topple kinematics.
## Build: aowlmony c -p:src src/server/body/felltest.aowl ; exit 0 and "ALL PASS" when everything holds.

import std/[syncio, math]
import fellogic

var failures = 0

proc check(name: string; cond: bool) =
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

const NX = 21
const NY = 24
const NZ = 21

proc grid(): seq[uint8] = newSeq[uint8](NX * NY * NZ)
proc at(x, y, z: int): int = x + NX * (z + NZ * y)

proc ground(g: var seq[uint8]; y: int) =
  for z in 0 ..< NZ:
    for x in 0 ..< NX:
      g[at(x, y, z)] = FcSupport

proc oak(g: var seq[uint8]; x, z, y0, h: int) =
  ## A trunk of h logs from y0 and a 5x5 leaf blob (2 layers) + 3x3 top around its top.
  for y in y0 ..< y0 + h:
    g[at(x, y, z)] = FcLog
  let top = y0 + h - 1
  for y in top - 1 .. top:
    for dz in -2 .. 2:
      for dx in -2 .. 2:
        if g[at(x + dx, y, z + dz)] == FcEmpty:
          g[at(x + dx, y, z + dz)] = FcLeaf
  for dz in -1 .. 1:
    for dx in -1 .. 1:
      g[at(x + dx, top + 1, z + dz)] = FcLeaf

proc main() =
  # 1. a lone oak, bottom log cut: everything above falls with all its leaves
  block:
    var g = grid()
    ground(g, 2)
    oak(g, 10, 10, 3, 6)
    g[at(10, 3, 10)] = FcEmpty     # the cut
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 512, 6)
    check("lone oak: one free piece", a.pieces.len == 1 and a.grounded == 0)
    if a.pieces.len == 1:
      let p = a.pieces[0]
      check("lone oak: 5 logs", p.logs.len == 5)
      check("lone oak: all 57 leaves (2 layers of 24 around the trunk, 9 on top)", p.leaves.len == 25 * 2 - 2 + 9)
      check("lone oak: pivot at the cut face", abs(p.pivot[0] - 10.5) < 1e-9 and abs(p.pivot[1] - 4.0) < 1e-9 and abs(p.pivot[2] - 10.5) < 1e-9)
  # 2. middle log cut: the stump (grounded) stays, the top falls
  block:
    var g = grid()
    ground(g, 2)
    oak(g, 10, 10, 3, 6)
    g[at(10, 5, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 5, 10, 512, 6)
    check("mid cut: stump grounded, top free", a.grounded == 1 and a.pieces.len == 1)
    if a.pieces.len == 1:
      check("mid cut: 3 logs fall", a.pieces[0].logs.len == 3 and a.pieces[0].minY == 6)
  # 3. a 2x2 trunk with one bottom log cut stands
  block:
    var g = grid()
    ground(g, 2)
    for y in 3 .. 10:
      for d in [(10, 10), (11, 10), (10, 11), (11, 11)]:
        g[at(d[0], y, d[1])] = FcLog
    g[at(10, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 512, 6)
    check("2x2 trunk: still grounded", a.pieces.len == 0 and a.grounded >= 1)
  # 4. a log wall resting on a stone foundation: breaking one log of it changes nothing
  block:
    var g = grid()
    ground(g, 2)
    for x in 5 .. 15:
      g[at(x, 3, 10)] = FcSupport          # cobblestone foundation
      for y in 4 .. 7:
        g[at(x, y, 10)] = FcLog
    g[at(10, 4, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 4, 10, 512, 6)
    check("log wall on a foundation: stands", a.pieces.len == 0)
  # 5. a trunk leaning on a wall (support on the side) stands
  block:
    var g = grid()
    ground(g, 2)
    oak(g, 10, 10, 3, 6)
    g[at(11, 6, 10)] = FcSupport           # wall touching the trunk at the side (replaces a leaf position: below the canopy)
    g[at(10, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 512, 6)
    check("trunk touching a wall: stands", a.pieces.len == 0 and a.grounded == 1)
  # 6. two oaks whose canopies touch: the cut one takes only its own leaves; the neighbour keeps the tie cells
  block:
    var g = grid()
    ground(g, 2)
    oak(g, 7, 10, 3, 6)
    oak(g, 11, 10, 3, 6)      # 4 apart: canopies overlap at x = 9
    g[at(7, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 7, 3, 10, 512, 6)
    check("touching canopies: one piece (the neighbour is grounded through its own trunk)", a.pieces.len == 1)
    if a.pieces.len == 1:
      var takesNeighbour = false
      var takesTie = false
      for c in a.pieces[0].leaves:
        let x = c mod NX
        if x >= 10: takesNeighbour = true
        if x == 9: takesTie = true
      check("touching canopies: no leaf nearer the other trunk goes", not takesNeighbour)
      check("touching canopies: equidistant leaves stay", not takesTie)
  # 7. size cap: the same oak with a cap of 20 cells is skipped
  block:
    var g = grid()
    ground(g, 2)
    oak(g, 10, 10, 3, 6)
    g[at(10, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 20, 6)
    check("size cap: skipped as too large", a.pieces.len == 0 and a.tooLarge == 1)
  # 8. a trunk that leaves the box is treated as supported (unknown beyond)
  block:
    var g = grid()
    ground(g, 2)
    for y in 3 ..< NY:
      g[at(10, y, 10)] = FcLog
    g[at(10, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 512, 6)
    check("trunk reaching the box top: stands", a.pieces.len == 0 and a.grounded == 1)
  # 9. a stone pillar with a block removed: no logs, nothing fells
  block:
    var g = grid()
    ground(g, 2)
    for y in 3 .. 12:
      for dz in -1 .. 1:
        for dx in -1 .. 1:
          g[at(10 + dx, y, 10 + dz)] = FcSupport
    g[at(11, 7, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 11, 7, 10, 512, 6)
    check("stone pillar: no seeds, nothing", a.pieces.len == 0 and a.seeds == 0)
  # 10. a diagonal branch belongs to its trunk (26-connected)
  block:
    var g = grid()
    ground(g, 2)
    for y in 3 .. 8:
      g[at(10, y, 10)] = FcLog
    g[at(11, 9, 11)] = FcLog
    g[at(12, 10, 12)] = FcLog
    g[at(10, 3, 10)] = FcEmpty
    let a = analyzeFell(g, NX, NY, NZ, 10, 3, 10, 512, 6)
    check("diagonal branch: one piece of 7 logs", a.pieces.len == 1 and a.pieces[0].logs.len == 7)
  # fall direction
  let d1 = fallDir(0.0, 0.0, 3.0, 4.0, 0.0, 0.0)
  check("fall away from the player", abs(d1[0] - 0.6) < 1e-9 and abs(d1[1] - 0.8) < 1e-9)
  let d2 = fallDir(5.0, 5.0, 5.01, 5.0, 0.0, -2.0)
  check("player on the cut: the wind direction", abs(d2[0]) < 1e-9 and abs(d2[1] + 1.0) < 1e-9)
  let d3 = fallDir(5.0, 5.0, 5.0, 5.0, 0.0, 0.0)
  check("no player, no wind: +x", d3[0] == 1.0 and d3[1] == 0.0)
  # topple: falling toward +x about the pivot, the top moves +x, the base does not move
  let (w, v) = toppleStart((10.5, 4.0, 10.5), (10.5, 8.0, 10.5), (1.0, 0.0), 0.05)
  check("topple axis is -z for a +x fall", abs(w[0]) < 1e-12 and abs(w[1]) < 1e-12 and abs(w[2] + 0.05) < 1e-12)
  check("topple: com moves +x at w*h", abs(v[0] - 0.2) < 1e-12 and abs(v[1]) < 1e-12 and abs(v[2]) < 1e-12)
  # the velocity of the pivot point under (v, w) about the com is zero: v + w x (pivot - com)
  let rx = 0.0
  let ry = 4.0 - 8.0
  let rz = 0.0
  let px = v[0] + (w[1] * rz - w[2] * ry)
  let py = v[1] + (w[2] * rx - w[0] * rz)
  let pz = v[2] + (w[0] * ry - w[1] * rx)
  check("topple: the pivot stands still", abs(px) < 1e-12 and abs(py) < 1e-12 and abs(pz) < 1e-12)
  if failures == 0:
    echo "ALL PASS"
  else:
    echo $failures, " FAILED"
    quit(1)

main()
