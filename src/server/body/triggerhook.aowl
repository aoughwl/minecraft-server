## The seam between the block layer / explosion code and the automatic collapse triggers (trigger.aowl). This file imports NOTHING, so
## blockbehaviour.aowl, bulkedit.aowl and explosion.aowl can import it without a cycle. The trigger module installs the procs.
##
## With the setting OFF (the default) `gTrigOn` is false and every caller pays exactly one bool test.

const
  TrigOff* = 0
  TrigStructures* = 1
  TrigFull* = 2

var gTrigOn*: bool = false        ## true when ANY world has triggers on (set by trigger.aowl)
var gTrigFull*: bool = false      ## true when ANY world runs `full` (explosions through the blast model)

proc noChange(dim: string; x, y, z: int32; oldState, newState: uint32; bulk: bool) {.nimcall.} = discard
proc noExplode(dim: string; cx, cy, cz: float64; power: float64; cells: var seq[int32]; noLoot: var seq[bool]): bool {.nimcall.} = false

var gTrigChange*: proc(dim: string; x, y, z: int32; oldState, newState: uint32; bulk: bool) {.nimcall.} = noChange
  ## a block cell changed (called from setBlockState and from bulk edits (`bulk`) only while `gTrigOn`)

var gTrigExplode*: proc(dim: string; cx, cy, cz: float64; power: float64; cells: var seq[int32]; noLoot: var seq[bool]): bool {.nimcall.} = noExplode
  ## explosion in a `full` world: fills `cells` with x,y,z triples the explosion removes; `noLoot[i]` = the cell becomes a debris body
  ## (no item drop). false = not handled, the caller keeps the vanilla result.
