## The PURE part of the automatic collapse triggers: debounce, clustering of dirty cells, per tick budget, per world rate limit,
## connected component reach and the tall column scan. It imports only std, so triggertest.aowl runs it with no server.
##
## DIRTY CELLS become CLUSTERS (a box plus times): a cell within `mergeDist` of a cluster's box of the same dimension extends it. A
## cluster is RIPE when it has been quiet for `debounce` ticks (`heavyDebounce` when a heavy block was placed), or it is `maxWait` ticks
## old (a long build never starves). Ripe clusters start a check only while the world's token bucket has a token (burst `rateBurst`,
## one token back every `rateEvery` ticks) and fewer than `maxActive` checks are in flight; at most `startsPerTick` start per tick. A
## flood of dirty cells (a TNT, a /fill) is clamped to `maxClusters` clusters (the overflow widens the nearest) so memory stays bounded.
## The expansion scan draws from `scanBudget` cells per tick, the solver from the body manager's own per tick slice.

import std/[math]

const
  ModeOff* = 0
  ModeStructures* = 1
  ModeFull* = 2

type
  TrigConfig* = object
    debounce*: int
    heavyDebounce*: int
    maxWait*: int
    mergeDist*: int
    maxClusters*: int
    rateBurst*: int
    rateEvery*: int
    startsPerTick*: int
    maxActive*: int
    scanBudget*: int       ## cells the expansion scan may read per tick
    reach*: int            ## connected component reach limit, blocks
    maxBoxCells*: int      ## a check box never exceeds this many cells
    minStructure*: int     ## a component of fewer structural cells is trivial: no check

  Cluster* = object
    dim*: string
    minX*, minY*, minZ*, maxX*, maxY*, maxZ*: int32
    firstTick*, lastTick*: int64
    heavy*: bool
    cells*: int
    merged*: bool          ## overflow widened it

  Bucket = object
    dim: string
    tokens: float64
    last: int64

  TrigState* = object
    cfg*: TrigConfig
    clusters*: seq[Cluster]
    buckets: seq[Bucket]
    scanLeft*: int
    startsLeft*: int
    added*, started*, deferredRate*, deferredBusy*: int

proc defaultTrigConfig*(): TrigConfig =
  TrigConfig(debounce: 8, heavyDebounce: 2, maxWait: 80, mergeDist: 5, maxClusters: 32, rateBurst: 3, rateEvery: 40, startsPerTick: 1,
    maxActive: 2, scanBudget: 400000, reach: 48, maxBoxCells: 200000, minStructure: 8)

proc newTrigState*(cfg: TrigConfig): TrigState =
  TrigState(cfg: cfg, clusters: @[], buckets: @[], scanLeft: cfg.scanBudget, startsLeft: cfg.startsPerTick)

proc parseMode*(s: string): int =
  ## off | structures | full (any case); -1 when it is none of them.
  var t = ""
  for ch in s:
    if ch >= 'A' and ch <= 'Z':
      t.add(char(ord(ch) + 32))
    elif ch != ' ' and ch != '\t' and ch != '\r' and ch != '\n':
      t.add(ch)
  if t == "off" or t == "0" or t == "false":
    return ModeOff
  if t == "structures" or t == "structure" or t == "1":
    return ModeStructures
  if t == "full" or t == "2":
    return ModeFull
  -1

proc modeName*(m: int): string =
  if m == ModeStructures:
    "structures"
  elif m == ModeFull:
    "full"
  else:
    "off"

# ----------------------------------------------------------------------------------------------------------------------
# clusters

proc near(c: Cluster; x, y, z: int32; d: int32): bool =
  x >= c.minX - d and x <= c.maxX + d and y >= c.minY - d and y <= c.maxY + d and z >= c.minZ - d and z <= c.maxZ + d

proc grow(c: var Cluster; x, y, z: int32) =
  if x < c.minX: c.minX = x
  if y < c.minY: c.minY = y
  if z < c.minZ: c.minZ = z
  if x > c.maxX: c.maxX = x
  if y > c.maxY: c.maxY = y
  if z > c.maxZ: c.maxZ = z

proc distOf(c: Cluster; x, y, z: int32): int =
  var d = 0
  if x < c.minX:
    d += int(c.minX - x)
  elif x > c.maxX:
    d += int(x - c.maxX)
  if y < c.minY:
    d += int(c.minY - y)
  elif y > c.maxY:
    d += int(y - c.maxY)
  if z < c.minZ:
    d += int(c.minZ - z)
  elif z > c.maxZ:
    d += int(z - c.maxZ)
  d

proc trigAdd*(st: var TrigState; dim: string; x, y, z: int32; heavy: bool; tick: int64) =
  ## One dirty cell.
  inc st.added
  let d = int32(st.cfg.mergeDist)
  for i in 0 ..< st.clusters.len:
    if st.clusters[i].dim == dim and near(st.clusters[i], x, y, z, d):
      grow(st.clusters[i], x, y, z)
      st.clusters[i].lastTick = tick
      inc st.clusters[i].cells
      if heavy:
        st.clusters[i].heavy = true
      return
  if st.clusters.len >= st.cfg.maxClusters:
    # overflow: widen the nearest cluster of this dimension (cluster 0 when there is none)
    var best = -1
    var bestD = high(int)
    for i in 0 ..< st.clusters.len:
      if st.clusters[i].dim == dim:
        let dd = distOf(st.clusters[i], x, y, z)
        if dd < bestD:
          bestD = dd
          best = i
    if best < 0:
      best = 0
    grow(st.clusters[best], x, y, z)
    st.clusters[best].lastTick = tick
    st.clusters[best].merged = true
    inc st.clusters[best].cells
    if heavy:
      st.clusters[best].heavy = true
    return
  st.clusters.add(Cluster(dim: dim, minX: x, minY: y, minZ: z, maxX: x, maxY: y, maxZ: z, firstTick: tick, lastTick: tick,
    heavy: heavy, cells: 1, merged: false))

proc isRipe*(st: TrigState; c: Cluster; tick: int64): bool =
  let quiet = if c.heavy: st.cfg.heavyDebounce else: st.cfg.debounce
  tick - c.lastTick >= int64(quiet) or tick - c.firstTick >= int64(st.cfg.maxWait)

# ----------------------------------------------------------------------------------------------------------------------
# rate limit (token bucket per dimension) and per tick budget

proc bucketOf(st: var TrigState; dim: string; tick: int64): int =
  for i in 0 ..< st.buckets.len:
    if st.buckets[i].dim == dim:
      return i
  st.buckets.add(Bucket(dim: dim, tokens: float64(st.cfg.rateBurst), last: tick))
  st.buckets.len - 1

proc refill(st: var TrigState; b: int; tick: int64) =
  let dt = tick - st.buckets[b].last
  if dt > 0:
    st.buckets[b].tokens = min(float64(st.cfg.rateBurst), st.buckets[b].tokens + float64(dt) / float64(max(1, st.cfg.rateEvery)))
    st.buckets[b].last = tick

proc trigTokens*(st: var TrigState; dim: string; tick: int64): float64 =
  let b = bucketOf(st, dim, tick)
  refill(st, b, tick)
  st.buckets[b].tokens

proc trigBeginTick*(st: var TrigState) =
  st.scanLeft = st.cfg.scanBudget
  st.startsLeft = st.cfg.startsPerTick

proc trigScanSpend*(st: var TrigState; cells: int): bool =
  ## Draw `cells` from this tick's scan budget; false (nothing drawn) when it would overdraw. The first draw of a tick always passes so
  ## a box bigger than the budget can still run once per tick.
  if cells <= st.scanLeft or st.scanLeft == st.cfg.scanBudget:
    st.scanLeft -= cells
    if st.scanLeft < 0:
      st.scanLeft = 0
    return true
  false

proc trigTake*(st: var TrigState; dim: string; tick: int64): bool =
  ## One token of the dimension's bucket (for checks that do not come from the queue, e.g. the wind scan).
  let b = bucketOf(st, dim, tick)
  refill(st, b, tick)
  if st.buckets[b].tokens < 1.0:
    inc st.deferredRate
    return false
  st.buckets[b].tokens -= 1.0
  true

proc trigRefund*(st: var TrigState; dim: string; tick: int64) =
  ## A popped cluster turned out not to need a check (trivial structure): its token and start come back.
  let b = bucketOf(st, dim, tick)
  st.buckets[b].tokens = min(float64(st.cfg.rateBurst), st.buckets[b].tokens + 1.0)
  inc st.startsLeft
  if st.started > 0:
    dec st.started

proc trigPush*(st: var TrigState; c: Cluster) =
  ## Put a popped cluster back (the scan budget ran out): it stays ripe.
  st.clusters.add(c)

proc trigPop*(st: var TrigState; tick: int64; active: int): seq[Cluster] =
  ## The ripe clusters allowed to start now (rate limit, in-flight limit, starts per tick); they leave the queue. Heavy first, then oldest.
  result = @[]
  if st.clusters.len == 0:
    return
  var order: seq[int] = @[]
  for i in 0 ..< st.clusters.len:
    if isRipe(st, st.clusters[i], tick):
      order.add(i)
  for a in 1 ..< order.len:
    let v = order[a]
    var b = a - 1
    while b >= 0 and ((st.clusters[v].heavy and not st.clusters[order[b]].heavy) or
        (st.clusters[v].heavy == st.clusters[order[b]].heavy and st.clusters[v].firstTick < st.clusters[order[b]].firstTick)):
      let ob = order[b]
      order[b + 1] = ob
      dec b
    order[b + 1] = v
  var taken: seq[int] = @[]
  var inflight = active
  for i in order:
    if st.startsLeft <= 0:
      break
    if inflight >= st.cfg.maxActive:
      inc st.deferredBusy
      break
    let b = bucketOf(st, st.clusters[i].dim, tick)
    refill(st, b, tick)
    if st.buckets[b].tokens < 1.0:
      inc st.deferredRate
      continue
    st.buckets[b].tokens -= 1.0
    dec st.startsLeft
    inc inflight
    inc st.started
    result.add(st.clusters[i])
    taken.add(i)
  # remove the taken ones, highest index first
  for a in 1 ..< taken.len:
    let v = taken[a]
    var b = a - 1
    while b >= 0 and taken[b] > v:
      let tb = taken[b]
      taken[b + 1] = tb
      dec b
    taken[b + 1] = v
  var k = taken.len - 1
  while k >= 0:
    st.clusters.delete(taken[k])
    dec k

# ----------------------------------------------------------------------------------------------------------------------
# connected component reach

proc cellIdx(nx, nz, x, y, z: int): int = x + nx * (z + nz * y)

proc componentBox*(solid: seq[bool]; nx, ny, nz: int; seeds: seq[int]; maxCells: int; box: var array[6, int]; count: var int): bool =
  ## Flood fill (6 neighbours) through `solid` cells of the dense box (index x + nx*(z + nz*y)) from the solid seed cells. `box` gets
  ## minX minY minZ maxX maxY maxZ of everything reached, `count` the number of cells. false when no seed is solid. Stops at `maxCells`
  ## (the box then covers what was reached so far).
  count = 0
  if nx <= 0 or ny <= 0 or nz <= 0 or solid.len < nx * ny * nz:
    return false
  var seen = newSeq[bool](nx * ny * nz)
  var stack: seq[int] = @[]
  for s in seeds:
    if s >= 0 and s < solid.len and solid[s] and not seen[s]:
      seen[s] = true
      stack.add(s)
  if stack.len == 0:
    return false
  box = [high(int), high(int), high(int), -1, -1, -1]
  let layer = nx * nz
  while stack.len > 0:
    let c = stack.pop()
    inc count
    let x = c mod nx
    let z = (c div nx) mod nz
    let y = c div layer
    if x < box[0]: box[0] = x
    if y < box[1]: box[1] = y
    if z < box[2]: box[2] = z
    if x > box[3]: box[3] = x
    if y > box[4]: box[4] = y
    if z > box[5]: box[5] = z
    if count >= maxCells:
      break
    if x > 0 and solid[c - 1] and not seen[c - 1]:
      seen[c - 1] = true
      stack.add(c - 1)
    if x < nx - 1 and solid[c + 1] and not seen[c + 1]:
      seen[c + 1] = true
      stack.add(c + 1)
    if z > 0 and solid[c - nx] and not seen[c - nx]:
      seen[c - nx] = true
      stack.add(c - nx)
    if z < nz - 1 and solid[c + nx] and not seen[c + nx]:
      seen[c + nx] = true
      stack.add(c + nx)
    if y > 0 and solid[c - layer] and not seen[c - layer]:
      seen[c - layer] = true
      stack.add(c - layer)
    if y < ny - 1 and solid[c + layer] and not seen[c + layer]:
      seen[c + layer] = true
      stack.add(c + layer)
  true

proc tallColumns*(solid: seq[bool]; nx, ny, nz: int; minRun: int; thin: int): int =
  ## Number of columns (x, z) holding a vertical run of at least `minRun` solid cells with at most `thin` solid side neighbours along the
  ## whole run (a pole, a tower, a chimney: what the wind can snap). A run reaching the top of the box does not count (it leaves it).
  result = 0
  if nx <= 2 or ny <= 0 or nz <= 2 or solid.len < nx * ny * nz:
    return 0
  for z in 1 ..< nz - 1:
    for x in 1 ..< nx - 1:
      var run = 0
      for y in 0 ..< ny:
        if solid[cellIdx(nx, nz, x, y, z)]:
          inc run
          if run >= minRun and y < ny - 1 and not solid[cellIdx(nx, nz, x, y + 1, z)]:
            var side = 0
            for yy in y - run + 1 .. y:
              if solid[cellIdx(nx, nz, x - 1, yy, z)]: inc side
              if solid[cellIdx(nx, nz, x + 1, yy, z)]: inc side
              if solid[cellIdx(nx, nz, x, yy, z - 1)]: inc side
              if solid[cellIdx(nx, nz, x, yy, z + 1)]: inc side
            if side <= thin:
              inc result
        else:
          run = 0

proc heavyLoad*(massKg: float64; span: int): bool =
  ## A placed block is a heavy load for a structure of this span (longest side of its box): the longer the span the lighter the block
  ## that counts. 12000 / clamp(span, 4, 16) kg: span 4 -> 3000 (iron, gold, ore blocks), span 12 -> 1000 (stone), span 16 -> 750.
  let s = max(4, min(16, span))
  massKg >= 12000.0 / float64(s)

proc clampBox*(box: var array[6, int]; center: array[3, int]; maxCells: int) =
  ## Trims `box` (minX minY minZ maxX maxY maxZ) around `center`, longest axis first, until it has at most `maxCells` cells.
  while (box[3] - box[0] + 1) * (box[4] - box[1] + 1) * (box[5] - box[2] + 1) > maxCells:
    var ax = 0
    var best = -1
    for a in 0 .. 2:
      let len = box[a + 3] - box[a] + 1
      if len > best:
        best = len
        ax = a
    if best <= 3:
      break
    if center[ax] - box[ax] > box[ax + 3] - center[ax]:
      inc box[ax]
    else:
      dec box[ax + 3]
