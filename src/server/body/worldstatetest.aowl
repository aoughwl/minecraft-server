## Per world state (multithreading phase 2, steps 4 to 6): two dimensions of one server keep independent collapse trigger queues
## (trigger.aowl `trigStateOf`), bodies (bodymanager.aowl `bodiesOf`) and fire regions (firewire.aowl), while body ids stay global.
## Exit 0 and "ALL PASS" when everything holds.

import std/[syncio, cmdline, tables, options, math, strutils]
import ../../config/lib as configlib
import ../../world/[chunkdata, level, lightingruntime, palette, playerdata, worldfs, worldinfo]
import ../../world/blockstates as states
import ../../nbt/tag as nbttag
import ../../util/math/position
import ../../util/math/boundingbox
import ../../util/vector3
import ../../data/block_ext
from ../../data/block_state import newBlockStateIdUnchecked, asU16
import "../../data/item_stack/mod"
import ../../generated/item_full
import ../data/datamod
import ../recipe
import ../scheduler
import ../serverbase
import ../tick_rate_manager
import ../net/winsock
import "../block/worldadapter"
import ../world/[bulkedit, worldmod]
import ../entity/[collision_providers, entitymod, entitytype, itementity]
import ../entity/mob/zombie/zombie
import ../../physics/[body, integrator]
import bodymanager, bodyworld, trigger, triggerhook, triggerlogic

var failures = 0

proc check(name: string; cond: bool) =
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

proc scratch(sub: string): string =
  result = parentDirW(paramStr(0)) & "/wstate_scratch_" & sub
  discard createDirAllW(result)

let adv = defaultAdvancedConfiguration()
let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD, THE_NETHER],
  tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
  recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let lvA = fromRootFolder(adv.world, scratch("a"), 1'i64, OVERWORLD)
let lvB = fromRootFolder(adv.world, scratch("b"), 1'i64, THE_NETHER)
let wA = loadWorld(lvA, defaultLevelData(1'u64), OVERWORLD, 63'i32, 0'i32, server)
let wB = loadWorld(lvB, defaultLevelData(1'u64), THE_NETHER, 63'i32, 0'i32, server)
server.worlds.add(wA)
server.worlds.add(wB)

let (_, stone) = defaultStateByName("stone")

# ---- step 4: trigger queues -------------------------------------------------------------------------------------------
block triggers:
  check("trigStateOf: one state per world, distinct", trigStateOf(wA).st.clusters.len == 0 and trigStateOf(wB).st.clusters.len == 0)
  trigAdd(trigStateOf(wA).st, "minecraft:overworld", 10, 64, 10, false, 100'i64)
  check("a dirty cell of the overworld is queued in the overworld only", trigStateOf(wA).st.clusters.len == 1 and trigStateOf(wB).st.clusters.len == 0)
  check("the state is stable between calls", trigStateOf(wA).st.added == 1)
  # through the real change hook: the first tick installs it
  inc server.tickCounter
  tickBodies(server)       # tracks the server (worldByDim)
  tickTriggers(server)
  check("tickTriggers installs the change hook", gTrigOn)
  gTrigChange("minecraft:the_nether", 5'i32, 70'i32, 5'i32, 0'u32, stone, false)
  check("onChange: a nether change goes to the nether queue", trigStateOf(wB).st.clusters.len == 1 and trigStateOf(wB).st.clusters[0].dim == "minecraft:the_nether")
  check("onChange: ... and not to the overworld queue", trigStateOf(wA).st.clusters.len == 1 and trigStateOf(wA).st.clusters[0].dim == "minecraft:overworld")
  trigBeginTick(trigStateOf(wA).st)
  check("budgets are per world: spending the overworld's scan budget leaves the nether's", trigScanSpend(trigStateOf(wA).st, 400000) and
    trigStateOf(wB).st.scanLeft == defaultTrigConfig().scanBudget)
  let lines = triggerStatusLines(server)
  var q = ""
  for l in lines:
    if l.startsWith("queue:"): q = l
  check("status sums the queues of both worlds", q.contains("2 clusters"))

echo(if failures == 0: "ALL PASS" else: "FAILURES: " & $failures)
quit(if failures == 0: 0 else: 1)
