## `/advancement grant` and `revoke` through a real dispatcher, over a real `PlayerAdvancement`.
import std/[options, os, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../data/advancement_data
import ../../generated/advancement as advgen
import ../../util/[permission, uuid, vector2, vector3]
import ../../util/text/[textbase, text]
import ../../world/worldfs
import ../entity/player/advancement as playeradv
import cmdtestutil
import advancement as advcmd

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  let (okId, id) = newV4()
  check(okId, "uuid")
  let dir = getTempDir() & "/advcommandtest_" & $id
  discard createDirAllW(dir)
  let manager = playeradv.newAdvancementManager(dir, false)
  let guard = playeradv.newPlayerAdvancement(manager, id)
  var packets = 0
  var experience = 0'i32
  let hooks = playeradv.AdvancementPlayer()
  hooks.sendUpdateAdvancements = proc(packet: playeradv.CUpdateAdvancements) {.closure.} = inc packets
  hooks.sendSelectAdvancementsTab = proc(packet: playeradv.CSelectAdvancementsTab) {.closure.} = discard
  hooks.addExperiencePoints = proc(amount: int32) {.closure.} = experience += amount
  hooks.showAdvancementMessages = proc(): bool {.closure.} = false
  hooks.getDisplayName = proc(): TextComponent {.closure.} = text("Steve")
  hooks.broadcastSystemMessage = proc(message: TextComponent; overlay: bool) {.closure.} = discard
  guard.setPlayer(hooks)

  let steve = CommandPlayer(entity: CommandEntity(entityTypeId: "minecraft:player"), gameProfile: CmdGameProfile(name: "Steve"))
  steve.entity.player = steve
  steve.entity.getDisplayName = proc(): TextComponent {.closure.} = text("Steve")
  advcmd.installAdvancementHooks(steve, guard)
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  let server = newServerWithWorld(world)
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  advcmd.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)

  let target = advgen.Advancement.fromName("story/mine_stone")
  check(target.isSome, "the advancement exists")
  let adv = target.unsafeGet
  let line = "minecraft:story/mine_stone"
  check(not guard.progress.containsKey(adv) or not guard.progress.getMutOrStartProgress(adv).isDone(), "starts undone")
  var r = run("advancement grant Steve only " & line)
  check(r.isOk and r.value == 1'i32, "grant only")
  check(guard.progress.getMutOrStartProgress(adv).isDone(), "it is done")
  check(not run("advancement grant Steve only " & line).isOk, "granting what is done fails (one to one)")
  r = run("advancement revoke Steve only " & line)
  check(r.isOk and r.value == 1'i32 and not guard.progress.getMutOrStartProgress(adv).isDone(), "revoke only")
  check(not run("advancement revoke Steve only " & line).isOk, "revoking what is not done fails")
  # One criterion.
  let criterion = adv.criteria[0]
  r = run("advancement grant Steve only " & line & " " & criterion)
  check(r.isOk and r.value == 1'i32, "grant one criterion")
  check(not run("advancement grant Steve only " & line & " " & criterion).isOk, "the criterion twice fails")
  check(not run("advancement grant Steve only " & line & " nonsense").isOk, "a criterion that does not exist")
  r = run("advancement revoke Steve only " & line & " " & criterion)
  check(r.isOk and r.value == 1'i32, "revoke one criterion")
  # The tree walks: from counts the advancement and its descendants, until its ancestors.
  let fromCount = advcmd.getAdvancements(adv, advcmd.From).len
  let untilCount = advcmd.getAdvancements(adv, advcmd.Until).len
  let throughCount = advcmd.getAdvancements(adv, advcmd.Through).len
  check(fromCount >= 2 and untilCount == 2 and throughCount == fromCount + untilCount - 1, "tree walk sizes")
  check(advcmd.getAdvancements(adv, advcmd.Until)[0].id.path == "story/root", "ancestors come first")
  r = run("advancement grant Steve until " & line)
  check(r.isOk and r.value == int32(untilCount), "grant until")
  r = run("advancement revoke Steve through " & line)
  check(r.isOk and r.value == int32(untilCount), "revoke through counts only those that were done")
  # Everything.
  let total = advgen.Advancement.getAdvancementsList().len
  r = run("advancement grant Steve everything")
  check(r.isOk and r.value == int32(total), "grant everything")
  check(packets > 0, "the player was told")
  r = run("advancement revoke Steve everything")
  check(r.isOk and r.value == int32(total), "revoke everything")
  check(not run("advancement grant Steve only minecraft:nothing/here").isOk, "an unknown advancement")

main()
echo "advancement command tests: all checks passed"
