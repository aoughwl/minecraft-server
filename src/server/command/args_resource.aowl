## The `FindArg` lookups of the legacy consumers that need the block and item tables, kept apart from args.aowl so a
## command that does not use them does not compile them.
## Port of pumpkin/src/command/args/block.rs
## Port of pumpkin/src/command/args/resource/item.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args, string_reader, snbt]
import ../../nbt/tag
import ../../generated/[blockdata, item, tag as tags]
import ../../generated/translation
import ../../util/text/[textbase, text]
import cmdcommon
import blockstatearg

type
  BlockPredicateKind* = enum
    bpNone
    bpTag
    bpBlock

  BlockPredicate* = object
    kind*: BlockPredicateKind
    tagIds*: seq[uint16]
    blockId*: int

  ItemPredicateKind* = enum
    ipItem
    ipTag
    ipAny

  ItemPredicate* = object
    kind*: ItemPredicateKind
    itemKey*: string
    tagIds*: seq[uint16]

proc bareName(s: string): string =
  if s.startsWith("minecraft:"): s[10 ..< s.len] else: s

proc namespaced(s: string): string =
  if s.startsWith("minecraft:"): s else: "minecraft:" & s

proc invalidBlock(name: string): CommandResult =
  cmdFailed(tc(JAVA_ARGUMENT_BLOCK_ID_INVALID, [text(namespaced(name))]))

proc findBlock*(args: ConsumedArgs; name: string; res: var Block): CommandResult =
  ## `BlockArgumentConsumer::find_arg`.
  var raw = ""
  if not findString(args, name, akBlock, raw):
    return missing(name)
  let (ok, b) = blockByName(bareName(raw))
  if not ok:
    return invalidBlock(raw)
  res = b
  cmdSuccess(0'i32)

proc findBlockState*(args: ConsumedArgs; name: string; res: var Block; stateId: var uint16): CommandResult =
  ## `find_arg` for a block with its properties, `nether_portal[axis=x]`: `res` is the block and `stateId` its default state
  ## with the properties applied. A trailing `{nbt}` is not read.
  var raw = ""
  if not findString(args, name, akBlock, raw):
    return missing(name)
  let split = splitBlockState(raw)
  let (ok, b) = blockByName(bareName(split.name))
  if not ok:
    return invalidBlock(split.name)
  let blockName = namespaced(split.name)
  if not split.ok:
    case split.problem
    of "unclosed":
      return cmdFailed(tc(JAVA_ARGUMENT_BLOCK_PROPERTY_UNCLOSED))
    of "novalue":
      return cmdFailed(tc(JAVA_ARGUMENT_BLOCK_PROPERTY_NOVALUE, [text(split.key), text(blockName)]))
    else:
      return cmdFailed(tc(JAVA_ARGUMENT_BLOCK_PROPERTY_DUPLICATE, [text(split.key), text(blockName)]))
  let (code, key, id) = stateIdWithProperties(bareName(split.name), split.props)
  case code
  of 0:
    res = b
    stateId = id
    cmdSuccess(0'i32)
  of 2:
    cmdFailed(tc(JAVA_ARGUMENT_BLOCK_PROPERTY_UNKNOWN, [text(blockName), text(key)]))
  of 3:
    var value = ""
    for prop in split.props:
      if prop[0] == key:
        value = prop[1]
    cmdFailed(tc(JAVA_ARGUMENT_BLOCK_PROPERTY_INVALID, [text(blockName), text(value), text(key)]))
  else:
    invalidBlock(split.name)

proc findBlockPredicate*(args: ConsumedArgs; name: string; res: var BlockPredicate): CommandResult =
  ## `BlockPredicateArgumentConsumer::find_arg`; `bpNone` for upstream's `Ok(None)`.
  var raw = ""
  if not findString(args, name, akBlockPredicate, raw):
    res = BlockPredicate(kind: bpNone)
    return cmdSuccess(0'i32)
  if raw.startsWith("#"):
    let tag0 = raw[1 ..< raw.len]
    let (ok, ids) = getTagIds(rkBlock, tag0)
    if not ok:
      return cmdFailed(tc(JAVA_ARGUMENTS_BLOCK_TAG_UNKNOWN, [text(tag0)]))
    res = BlockPredicate(kind: bpTag, tagIds: ids)
    return cmdSuccess(0'i32)
  let (ok, b) = blockByName(bareName(raw))
  if not ok:
    return invalidBlock(raw)
  res = BlockPredicate(kind: bpBlock, blockId: b.id)
  cmdSuccess(0'i32)

proc testBlockPredicate*(p: BlockPredicate; blockId: int): bool =
  case p.kind
  of bpNone: true
  of bpTag: uint16(blockId) in p.tagIds
  of bpBlock: p.blockId == blockId

proc splitComponents(inner: string): seq[string] =
  var res: seq[string] = @[]
  var start = 0
  var curly = 0
  var bracket = 0
  var i = 0
  while i < inner.len:
    case inner[i]
    of '{': inc curly
    of '}': dec curly
    of '[': inc bracket
    of ']': dec bracket
    of ',':
      if curly == 0 and bracket == 0:
        res.add(inner[start ..< i])
        start = i + 1
    else: discard
    inc i
  res.add(inner[start ..< inner.len])
  res

proc findItem*(args: ConsumedArgs; name: string; rawName: var string; stack: var CmdItemStack; found: var Item): CommandResult =
  ## `ItemArgumentConsumer::find_arg`. A component that does not parse is skipped, as upstream's `if let Ok` does.
  if not findString(args, name, akItem, rawName):
    return missing(name)
  let bracket = rawName.find('[')
  let itemId = if bracket >= 0: rawName[0 ..< bracket] else: rawName
  let (ok, item) = itemByName(bareName(itemId))
  if not ok:
    return cmdFailed(tc("argument.item.id.invalid", [text(namespaced(itemId))]))
  found = item
  stack = CmdItemStack(itemKey: item.name, count: 1'i32, patchNames: @[], patchValues: @[])
  if bracket >= 0 and rawName.endsWith("]"):
    let inner = rawName[bracket + 1 ..< rawName.len - 1]
    for comp0 in splitComponents(inner):
      let comp = strip(comp0)
      if comp.len == 0:
        continue
      let eq = comp.find('=')
      if eq < 0:
        continue
      var reader = newStringReader(strip(comp[eq + 1 ..< comp.len]))
      let t = parseForCommands(reader)
      if t.isOk:
        stack.patchNames.add(strip(comp[0 ..< eq]))
        stack.patchValues.add(t.value)
  cmdSuccess(0'i32)

proc findItemPredicate*(args: ConsumedArgs; name: string; res: var ItemPredicate): CommandResult =
  var raw = ""
  if not findString(args, name, akItem, raw):
    return missing(name)
  if raw == "*":
    res = ItemPredicate(kind: ipAny)
    return cmdSuccess(0'i32)
  let bracket = raw.find('[')
  let clean = if bracket >= 0: raw[0 ..< bracket] else: raw
  if clean.startsWith("#"):
    let tag0 = clean[1 ..< clean.len]
    let (ok, ids) = getTagIds(rkItem, tag0)
    if not ok:
      return cmdFailed(tc("arguments.item.tag.unknown", [text(tag0)]))
    res = ItemPredicate(kind: ipTag, tagIds: ids)
    return cmdSuccess(0'i32)
  let (ok, item) = itemByName(bareName(clean))
  if not ok:
    return cmdFailed(tc("argument.item.id.invalid", [text(namespaced(clean))]))
  res = ItemPredicate(kind: ipItem, itemKey: item.name)
  cmdSuccess(0'i32)

proc testItemStack*(p: ItemPredicate; stack: CmdItemStack): bool =
  ## `ItemPredicate::test_item_stack`.
  case p.kind
  of ipAny:
    true
  of ipItem:
    stack.itemKey == p.itemKey
  of ipTag:
    let (ok, item) = itemByName(stack.itemKey)
    ok and uint16(item.id) in p.tagIds
