## The `/attribute` command.
## Port of pumpkin/src/command/commands/attribute.rs

import ../../util/closureset
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argument_types, entity_selector, cmddispatch]
import ../../command/argtype
import ../../protocol/java/client/play/commands
import ../../codecs/json_value
import ../../generated/attributes
import ../../generated/translation
import ../../util/[permission, uuid]
import ../../util/text/[textbase, text]
import cmdcommon

const
  Description = "Queries or modifies attributes of an entity."
  Permission0 = "minecraft:command.attribute"
  ArgTarget = "target"
  ArgAttribute = "attribute"
  ArgScale = "scale"
  ArgValue = "value"
  ArgUuid = "uuid"
  ArgName = "name"

type
  ModifierOp = enum
    ## `ModifierOperation`.
    mopAdd = 0
    mopMultiplyBase = 1
    mopMultiplyTotal = 2

proc failedEntityError(): CommandErrorType =
  errorType1(JAVA_COMMANDS_ATTRIBUTE_FAILED_ENTITY, JAVA_COMMANDS_ATTRIBUTE_FAILED_ENTITY)

proc noAttributeError(): CommandErrorType =
  errorType2(JAVA_COMMANDS_ATTRIBUTE_FAILED_NO_ATTRIBUTE, JAVA_COMMANDS_ATTRIBUTE_FAILED_NO_ATTRIBUTE)

proc modifierAlreadyPresentError(): CommandErrorType =
  errorType3(JAVA_COMMANDS_ATTRIBUTE_FAILED_MODIFIER_ALREADY_PRESENT, JAVA_COMMANDS_ATTRIBUTE_FAILED_MODIFIER_ALREADY_PRESENT)

proc noModifierError(): CommandErrorType =
  errorType3(JAVA_COMMANDS_ATTRIBUTE_FAILED_NO_MODIFIER, JAVA_COMMANDS_ATTRIBUTE_FAILED_NO_MODIFIER)

proc attributeTranslationKey(attribute: Attribute): string =
  ## `attribute.name.{path}` with the `minecraft:` prefix stripped.
  let prefix = "minecraft:"
  var path = attribute.name
  if path.len >= prefix.len and path[0 ..< prefix.len] == prefix:
    path = path[prefix.len ..< path.len]
  "attribute.name." & path

proc attributeName(attribute: Attribute): TextComponent = translate(attributeTranslationKey(attribute))

proc satI32(v: float64): int32 =
  ## `as i32` on a float: saturates, NaN is 0.
  if v != v: 0'i32
  elif v >= 2147483647.0: int32.high
  elif v <= -2147483648.0: int32.low
  else: int32(v)

proc getUuidArg(context: CommandContext; name: string): CmdResult[Uuid] =
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[Uuid](missingArgument(name))
  if not (v of UuidValue):
    return cmdFail[Uuid](wrongArgumentType(name))
  cmdOk[Uuid](UuidValue(v).value)

proc livingTarget(context: CommandContext): CmdResult[CommandEntity] =
  ## `get_entity` and `get_living_entity().ok_or_else(FAILED_ENTITY_ERROR)`.
  let t = getEntity(context, ArgTarget)
  if not t.isOk:
    return t
  if not t.value.isLiving:
    return cmdFail[CommandEntity](createWithoutContext(failedEntityError(), t.value.getName()))
  t

proc requireAttribute(target: CommandEntity; attribute: Attribute): CmdResult[int32] =
  ## `living.attributes.contains_key(&attribute.id)`.
  if not closureSet(target.hasAttribute) or not target.hasAttribute(attribute.id):
    return cmdFail[int32](createWithoutContext(noAttributeError(), target.getName(), attributeName(attribute)))
  cmdOk[int32](0'i32)

proc getExecutor(isBase, hasScale: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let living = livingTarget(context)
    if not living.isOk:
      return cmdFail[int32](living.error)
    let target = living.value
    let attribute = getAttribute(context, ArgAttribute)
    if not attribute.isOk:
      return cmdFail[int32](attribute.error)
    var scale = 1.0'f64
    if hasScale:
      let s = getDouble(context, ArgScale)
      if not s.isOk:
        return cmdFail[int32](s.error)
      scale = s.value
    let has = requireAttribute(target, attribute.value)
    if not has.isOk:
      return has
    if isBase:
      let baseValue = target.getAttributeBase(attribute.value.id)
      sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_BASE_VALUE_GET_SUCCESS,
        [attributeName(attribute.value), target.getName(), text(displayF64(baseValue))]), false)
      cmdOk[int32](satI32(baseValue * scale))
    else:
      let value = target.getAttributeValue(attribute.value.id)
      sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_VALUE_GET_SUCCESS,
        [attributeName(attribute.value), target.getName(), text(displayF64(value))]), false)
      cmdOk[int32](satI32(value * scale))

proc baseSetExecutor(context: CommandContext): CmdResult[int32] =
  let living = livingTarget(context)
  if not living.isOk:
    return cmdFail[int32](living.error)
  let target = living.value
  let attribute = getAttribute(context, ArgAttribute)
  if not attribute.isOk:
    return cmdFail[int32](attribute.error)
  let value = getDouble(context, ArgValue)
  if not value.isOk:
    return cmdFail[int32](value.error)
  let has = requireAttribute(target, attribute.value)
  if not has.isOk:
    return has
  target.setAttributeBase(attribute.value.id, value.value)
  if closureSet(target.sendAttributeUpdate):
    target.sendAttributeUpdate(attribute.value.id)
  sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_BASE_VALUE_SET_SUCCESS,
    [attributeName(attribute.value), target.getName(), text(displayF64(value.value))]), true)
  cmdOk[int32](satI32(value.value))

proc baseResetExecutor(context: CommandContext): CmdResult[int32] =
  let living = livingTarget(context)
  if not living.isOk:
    return cmdFail[int32](living.error)
  let target = living.value
  let attribute = getAttribute(context, ArgAttribute)
  if not attribute.isOk:
    return cmdFail[int32](attribute.error)
  let has = requireAttribute(target, attribute.value)
  if not has.isOk:
    return has
  let defaultValue = attribute.value.defaultValue
  target.setAttributeBase(attribute.value.id, defaultValue)
  if closureSet(target.sendAttributeUpdate):
    target.sendAttributeUpdate(attribute.value.id)
  sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_BASE_VALUE_RESET_SUCCESS,
    [attributeName(attribute.value), target.getName(), text(displayF64(defaultValue))]), true)
  cmdOk[int32](satI32(defaultValue))

proc modifierAddExecutor(operation: ModifierOp): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let living = livingTarget(context)
    if not living.isOk:
      return cmdFail[int32](living.error)
    let target = living.value
    let attribute = getAttribute(context, ArgAttribute)
    if not attribute.isOk:
      return cmdFail[int32](attribute.error)
    let uuid = getUuidArg(context, ArgUuid)
    if not uuid.isOk:
      return cmdFail[int32](uuid.error)
    let name = getString(context, ArgName)
    if not name.isOk:
      return cmdFail[int32](name.error)
    let value = getDouble(context, ArgValue)
    if not value.isOk:
      return cmdFail[int32](value.error)
    let modifierId = $uuid.value
    let has = requireAttribute(target, attribute.value)
    if not has.isOk:
      return has
    if not closureSet(target.addAttributeModifier) or
        not target.addAttributeModifier(attribute.value.id, modifierId, value.value, int32(ord(operation))):
      return cmdFail[int32](createWithoutContext(modifierAlreadyPresentError(), text(modifierId),
        attributeName(attribute.value), target.getName()))
    if closureSet(target.sendAttributeUpdate):
      target.sendAttributeUpdate(attribute.value.id)
    sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_MODIFIER_ADD_SUCCESS,
      [text(modifierId), attributeName(attribute.value), target.getName()]), true)
    cmdOk[int32](1'i32)

proc modifierRemoveExecutor(context: CommandContext): CmdResult[int32] =
  let living = livingTarget(context)
  if not living.isOk:
    return cmdFail[int32](living.error)
  let target = living.value
  let attribute = getAttribute(context, ArgAttribute)
  if not attribute.isOk:
    return cmdFail[int32](attribute.error)
  let uuid = getUuidArg(context, ArgUuid)
  if not uuid.isOk:
    return cmdFail[int32](uuid.error)
  let modifierId = $uuid.value
  let has = requireAttribute(target, attribute.value)
  if not has.isOk:
    return has
  if not closureSet(target.removeAttributeModifier) or not target.removeAttributeModifier(attribute.value.id, modifierId):
    return cmdFail[int32](createWithoutContext(noModifierError(), attributeName(attribute.value),
      target.getName(), text(modifierId)))
  if closureSet(target.sendAttributeUpdate):
    target.sendAttributeUpdate(attribute.value.id)
  sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_MODIFIER_REMOVE_SUCCESS,
    [text(modifierId), attributeName(attribute.value), target.getName()]), true)
  cmdOk[int32](1'i32)

proc modifierGetExecutor(context: CommandContext): CmdResult[int32] =
  let living = livingTarget(context)
  if not living.isOk:
    return cmdFail[int32](living.error)
  let target = living.value
  let attribute = getAttribute(context, ArgAttribute)
  if not attribute.isOk:
    return cmdFail[int32](attribute.error)
  let uuid = getUuidArg(context, ArgUuid)
  if not uuid.isOk:
    return cmdFail[int32](uuid.error)
  let modifierId = $uuid.value
  let has = requireAttribute(target, attribute.value)
  if not has.isOk:
    return has
  var amount = 0.0'f64
  if not closureSet(target.getAttributeModifier) or not target.getAttributeModifier(attribute.value.id, modifierId, amount):
    return cmdFail[int32](createWithoutContext(noModifierError(), attributeName(attribute.value),
      target.getName(), text(modifierId)))
  sendFeedback(context.source, tc(JAVA_COMMANDS_ATTRIBUTE_MODIFIER_VALUE_GET_SUCCESS,
    [text(modifierId), attributeName(attribute.value), target.getName(), text(displayF64(amount))]), false)
  cmdOk[int32](satI32(amount))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let valueArg = proc(): ArgumentBuilder = argument(ArgValue, newDoubleArgumentType())
  let scaleArg = proc(): ArgumentBuilder = argument(ArgScale, newDoubleArgumentType())
  let uuidArg = proc(): ArgumentBuilder = argument(ArgUuid, newUuidArgumentType())
  let getNode = then(executes(literal("get"), getExecutor(false, false)),
    executes(scaleArg(), getExecutor(false, true)))
  let baseGet = then(executes(literal("get"), getExecutor(true, false)),
    executes(scaleArg(), getExecutor(true, true)))
  let base = then(then(then(literal("base"), baseGet),
    then(literal("set"), executes(valueArg(), baseSetExecutor))),
    executes(literal("reset"), baseResetExecutor))
  let operations = then(then(then(valueArg(),
    executes(literal("add"), modifierAddExecutor(mopAdd))),
    executes(literal("multiply"), modifierAddExecutor(mopMultiplyTotal))),
    executes(literal("multiply_base"), modifierAddExecutor(mopMultiplyBase)))
  let modifierAdd = then(literal("add"), then(uuidArg(),
    then(argument(ArgName, newStringArgumentType(spSingleWord)), operations)))
  let modifierRemove = then(literal("remove"), executes(uuidArg(), modifierRemoveExecutor))
  let modifierValue = then(literal("value"), then(literal("get"), executes(uuidArg(), modifierGetExecutor)))
  let modifier = then(then(then(literal("modifier"), modifierAdd), modifierRemove), modifierValue)
  let attributeNode = then(then(then(argument(ArgAttribute, newAttributeArgumentType()), getNode), base), modifier)
  discard register(dispatcher, then(requires(command("attribute", Description), Permission0),
    then(argument(ArgTarget, newEntityArgumentType(eakEntity)), attributeNode)))
