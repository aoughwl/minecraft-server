## `/attribute` through a real dispatcher, over an entity of hooks that keep one attribute table.
import std/[options, syncio, tables]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../generated/attributes
import ../../util/[permission, uuid, vector2, vector3]
import ../../util/text/[textbase, text]
import attribute, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

type
  Mod = object
    id: string
    amount: float64
    op: int32
  Attr = ref object
    base: float64
    mods: seq[Mod]

proc valueOf(a: Attr): float64 =
  var v = a.base
  var addSum = 0.0
  var mulBase = 0.0
  var mulTotal = 1.0
  for m in a.mods:
    if m.op == 0'i32: addSum += m.amount
    elif m.op == 1'i32: mulBase += m.amount
    else: mulTotal *= 1.0 + m.amount
  v += addSum
  v *= 1.0 + mulBase
  v * mulTotal

proc main() =
  var table = initTable[uint8, Attr]()
  table[MAX_HEALTH.id] = Attr(base: 20.0, mods: @[])
  var updates = 0
  let entity = CommandEntity(entityTypeId: "minecraft:pig", entityTypeName: "pig", isLiving: true)
  entity.getName = proc(): TextComponent {.closure.} = text("Pig")
  entity.getDisplayName = proc(): TextComponent {.closure.} = text("Pig")
  entity.hasAttribute = proc(id: uint8): bool {.closure.} = table.hasKey(id)
  entity.getAttributeBase = proc(id: uint8): float64 {.closure.} = table.getOrDefault(id).base
  entity.getAttributeValue = proc(id: uint8): float64 {.closure.} = valueOf(table.getOrDefault(id))
  entity.setAttributeBase = proc(id: uint8; v: float64) {.closure.} = table.getOrDefault(id).base = v
  entity.sendAttributeUpdate = proc(id: uint8) {.closure.} = inc updates
  entity.getAttributeModifier = proc(id: uint8; mid: string; amount: var float64): bool {.closure.} =
    for m in table.getOrDefault(id).mods:
      if m.id == mid:
        amount = m.amount
        return true
    false
  entity.addAttributeModifier = proc(id: uint8; mid: string; amount: float64; op: int32): bool {.closure.} =
    for m in table.getOrDefault(id).mods:
      if m.id == mid:
        return false
    table.getOrDefault(id).mods.add(Mod(id: mid, amount: amount, op: op))
    true
  entity.removeAttributeModifier = proc(id: uint8; mid: string): bool {.closure.} =
    for i in 0 ..< table.getOrDefault(id).mods.len:
      if table.getOrDefault(id).mods[i].id == mid:
        table.getOrDefault(id).mods.delete(i)
        return true
    false
  let stone = CommandEntity(entityTypeId: "minecraft:item", entityTypeName: "item", isLiving: false)
  stone.getName = proc(): TextComponent {.closure.} = text("Item")
  stone.getDisplayName = proc(): TextComponent {.closure.} = text("Item")
  entity.uuid = Uuid(hi: 1'u64, lo: 1'u64)
  stone.uuid = Uuid(hi: 2'u64, lo: 2'u64)
  let entities = @[entity, stone]
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  for e in entities:
    e.getPos = proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
    e.getRotation = proc(): Vector2[float32] {.closure.} = Vector2[float32](x: 0.0'f32, y: 0.0'f32)
    e.getWorld = proc(): nil CommandWorld {.closure.} = world
    e.isAlive = proc(): bool {.closure.} = true
  world.getEntities = proc(): seq[CommandEntity] {.closure.} = entities
  let server = newServerWithWorld(world)
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  attribute.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)
  let id = "3d569d3a-93ef-44a0-9f1c-f69db9d37a56"
  let sel = "@e[type=pig,limit=1]"

  var r = run("attribute " & sel & " minecraft:max_health get")
  if not r.isOk:
    echo getText(r.error.message)
  check(r.isOk and r.value == 20'i32, "get the value")
  r = run("attribute " & sel & " minecraft:max_health get 2")
  check(r.isOk and r.value == 40'i32, "get scaled")
  r = run("attribute " & sel & " minecraft:max_health base get")
  check(r.isOk and r.value == 20'i32, "base get")
  r = run("attribute " & sel & " minecraft:max_health base set 30")
  check(r.isOk and r.value == 30'i32 and table.getOrDefault(MAX_HEALTH.id).base == 30.0 and updates == 1, "base set sends an update")
  r = run("attribute " & sel & " minecraft:max_health base reset")
  check(r.isOk and r.value == 20'i32 and table.getOrDefault(MAX_HEALTH.id).base == MAX_HEALTH.defaultValue and updates == 2, "base reset to default")
  r = run("attribute " & sel & " minecraft:max_health modifier add " & id & " boost 5 add")
  check(r.isOk and r.value == 1'i32 and table.getOrDefault(MAX_HEALTH.id).mods.len == 1 and updates == 3, "modifier add")
  r = run("attribute " & sel & " minecraft:max_health get")
  check(r.isOk and r.value == 25'i32, "the modifier counts in the value")
  check(not run("attribute " & sel & " minecraft:max_health modifier add " & id & " boost 5 add").isOk, "the same id again fails")
  r = run("attribute " & sel & " minecraft:max_health modifier value get " & id)
  check(r.isOk and r.value == 5'i32, "modifier value get")
  r = run("attribute " & sel & " minecraft:max_health modifier remove " & id)
  check(r.isOk and table.getOrDefault(MAX_HEALTH.id).mods.len == 0 and updates == 4, "modifier remove")
  check(not run("attribute " & sel & " minecraft:max_health modifier remove " & id).isOk, "removing it twice fails")
  r = run("attribute " & sel & " minecraft:max_health modifier add " & id & " twice 1 multiply")
  check(r.isOk and table.getOrDefault(MAX_HEALTH.id).mods[0].op == 2'i32, "multiply is multiply_total")
  discard run("attribute " & sel & " minecraft:max_health modifier remove " & id)
  r = run("attribute " & sel & " minecraft:max_health modifier add " & id & " base 1 multiply_base")
  check(r.isOk and table.getOrDefault(MAX_HEALTH.id).mods[0].op == 1'i32, "multiply_base is multiply_base")
  check(not run("attribute " & sel & " minecraft:armor get").isOk, "an attribute the entity lacks")
  check(not run("attribute @e[type=item,limit=1] minecraft:max_health get").isOk, "a non-living target")
  check(not run("attribute " & sel & " minecraft:nonsense get").isOk, "an unknown attribute")

main()
echo "attribute command tests: all checks passed"
