## The `/ban` command.
## Port of pumpkin/src/command/commands/ban.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["ban"]
  Description = "bans a player"
  ArgTarget = "player"
  ArgReason = "reason"

proc banProfile(sender: CommandSender; server: CommandServer; profile: CmdGameProfile; reason0: Option[string]): bool =
  let reason = if reason0.isSome: reason0.unsafeGet else: "Banned by an operator."
  if closureSet(server.getBannedPlayers):
    let list = server.getBannedPlayers()
    for entry in list:
      if entry.id == profile.id:
        if entry.name != profile.name and closureSet(server.renameBannedPlayer):
          server.renameBannedPlayer(profile.id, profile.name)
        return false
  if closureSet(server.addBannedPlayer):
    server.addBannedPlayer(CmdListEntry(id: profile.id, name: profile.name, source: displayText(sender), reason: reason))
  sendMessage(sender, tc2(JAVA_COMMANDS_BAN_SUCCESS, BEDROCK_COMMANDS_BAN_SUCCESS, [text(profile.name), text(reason)]))
  if closureSet(server.getPlayerByUuid):
    let player = server.getPlayerByUuid(profile.id)
    if player != nil and closureSet(player.kick):
      player.kick(tc2(JAVA_MULTIPLAYER_DISCONNECT_BANNED, BEDROCK_DISCONNECTIONSCREEN_TITLE_BANNEDBYHOST))
  true

proc banPlayers(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs; reason: Option[string]): CommandResult =
  var targets: seq[CmdGameProfile] = @[]
  if not findGameProfiles(args, ArgTarget, targets):
    return missing(ArgTarget)
  if server == nil:
    return cmdInvalidRequirement()
  var count = 0'i32
  for target in targets:
    if banProfile(sender, server, target, reason):
      inc count
  if count == 0'i32:
    return cmdFailed(tc2(JAVA_COMMANDS_BAN_FAILED, BEDROCK_COMMANDS_BAN_FAILED))
  cmdSuccess(count)

proc noReasonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  banPlayers(sender, server, args, none[string]())

proc reasonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var reason = ""
  if not findMsg(args, ArgReason, reason):
    return missing(ArgReason)
  banPlayers(sender, server, args, some(reason))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(execute(argument(ArgTarget, newGameProfilesArgumentConsumer(gpsOnlinePlayers, true)), noReasonExecutor),
    execute(argument(ArgReason, newMsgArgConsumer()), reasonExecutor)))
