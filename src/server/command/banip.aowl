## The `/ban-ip` command.
## Port of pumpkin/src/command/commands/banip.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["ban-ip"]
  Description = "bans a player-ip"
  ArgTarget = "ip"
  ArgReason = "reason"

proc parseIpOrPlayer(target: string; server: CommandServer; ip: var string): bool =
  ## `parse_ip`.
  if server.parseIp != nil and server.parseIp(target, ip):
    return true
  if server.getPlayerByName == nil:
    return false
  let player = server.getPlayerByName(target)
  if player == nil or player.getIp == nil:
    return false
  ip = player.getIp()
  true

proc banIp(sender: CommandSender; server: nil CommandServer; target: string; reason0: Option[string]): CommandResult =
  let reason = if reason0.isSome: reason0.unsafeGet else: "Banned by an operator."
  if server == nil:
    return cmdInvalidRequirement()
  var ip = ""
  if not parseIpOrPlayer(target, server, ip):
    return cmdFailed(tc2(JAVA_COMMANDS_BANIP_INVALID, BEDROCK_COMMANDS_BANIP_INVALID))
  if server.getBannedIps != nil:
    let list = server.getBannedIps()
    for entry in list:
      if entry.ip == ip:
        return cmdFailed(tc(JAVA_COMMANDS_BANIP_FAILED))
  if server.addBannedIp != nil:
    server.addBannedIp(CmdListEntry(ip: ip, source: displayText(sender), reason: reason))
  var affected: seq[CommandPlayer] = @[]
  if server.getPlayersByIp != nil:
    affected = server.getPlayersByIp(ip)
  var names = ""
  var i = 0
  while i < affected.len:
    if i > 0:
      names.add(" ")
    names.add(affected[i].gameProfile.name)
    inc i
  sendMessage(sender, tc2(JAVA_COMMANDS_BANIP_SUCCESS, BEDROCK_COMMANDS_BANIP_SUCCESS, [text(ip), text(reason)]))
  sendMessage(sender, tc(JAVA_COMMANDS_BANIP_INFO, [text($affected.len), text(names)]))
  for player in affected:
    if player.kick != nil:
      player.kick(tc(JAVA_MULTIPLAYER_DISCONNECT_IP_BANNED))
  cmdSuccess(int32(affected.len))

proc noReasonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target = ""
  if not findString(args, ArgTarget, akSimple, target):
    return missing(ArgTarget)
  banIp(sender, server, target, none[string]())

proc reasonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target = ""
  if not findString(args, ArgTarget, akSimple, target):
    return missing(ArgTarget)
  var reason = ""
  if not findMsg(args, ArgReason, reason):
    return missing(ArgReason)
  banIp(sender, server, target, some(reason))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(execute(argument(ArgTarget, newSimpleArgConsumer()), noReasonExecutor),
    execute(argument(ArgReason, newMsgArgConsumer()), reasonExecutor)))
