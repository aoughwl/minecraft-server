## The `/banlist` command.
## Port of pumpkin/src/command/commands/banlist.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector, coordinates]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Description = "Prints the banlist of players, IPs, or both at once."
  Permission0 = "minecraft:command.banlist"

proc banListExecutor(players, ips: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    var entries: seq[CmdListEntry] = @[]
    let server = context.source.server
    if server != nil:
      if players and server.getBannedPlayers != nil:
        let list = server.getBannedPlayers()
        for entry in list:
          entries.add(entry)
      if ips and server.getBannedIps != nil:
        let list = server.getBannedIps()
        for entry in list:
          var e = entry
          e.name = entry.ip
          entries.add(e)
    let source = context.source
    if entries.len == 0:
      sendFeedback(source, tc(JAVA_COMMANDS_BANLIST_NONE), false)
    else:
      let bedrockKey = if ips and not players: BEDROCK_COMMANDS_BANLIST_IPS else: BEDROCK_COMMANDS_BANLIST_PLAYERS
      sendFeedback(source, tc2(JAVA_COMMANDS_BANLIST_LIST, bedrockKey, [text($entries.len)]), false)
      for entry in entries:
        sendFeedback(source, tc(JAVA_COMMANDS_BANLIST_ENTRY, [text(entry.name), text(entry.source), text(entry.reason)]), false)
    cmdOk[int32](int32(entries.len))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Three)))
  var b = requires(command("banlist", Description), Permission0)
  b = then(b, executes(literal("ips"), banListExecutor(false, true)))
  b = then(b, executes(literal("players"), banListExecutor(true, false)))
  discard register(dispatcher, executes(b, banListExecutor(true, true)))
