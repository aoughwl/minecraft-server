## `/weather`, `/time`, `/kick`, `/msg` and `/random` through a real dispatch, on hooks that record the calls.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, fallbackdispatch, entity_selector]
import ../../util/permission
import ../../util/text/[textbase, text]
import weather, time, kick, msg, random as randomcmd, cmdtestutil

proc weatherBlock() =
  let d = newFallbackDispatcher()
  register(d, weather.initCommandTree(), "minecraft:command.weather")
  var clearT = -1'i32
  var rainT = -1'i32
  var raining = false
  var thunder = false
  let world = CommandWorld(setWeatherParameters: proc(c, r: int32; ra, th: bool) {.closure.} =
    clearT = c
    rainT = r
    raining = ra
    thunder = th)
  let server = newServerWithWorld(world)
  assert dispatch(d, senderConsole(), server, "weather rain 2s").isOk
  assert clearT == 0'i32 and rainT == 40'i32 and raining and not thunder
  assert dispatch(d, senderConsole(), server, "weather thunder 1d").isOk
  assert rainT == 24000'i32 and thunder
  assert dispatch(d, senderConsole(), server, "weather clear 5").isOk
  assert clearT == 5'i32 and not raining
  assert dispatch(d, senderConsole(), server, "weather clear").isOk
  assert clearT >= 12000'i32 and clearT <= 180000'i32
  assert not dispatch(d, senderConsole(), server, "weather clear -1").isOk
  assert not dispatch(d, senderConsole(), server, "weather clear 1x").isOk

proc timeBlock() =
  let d = newFallbackDispatcher()
  register(d, time.initCommandTree(), "minecraft:command.time")
  var now = 0'i64
  let world = CommandWorld(
    addTime: proc(t: int64) {.closure.} = now += t,
    setTime: proc(t: int64) {.closure.} = now = t,
    queryDaytime: proc(): int64 {.closure.} = now,
    queryGametime: proc(): int64 {.closure.} = now + 1'i64,
    queryDay: proc(): int64 {.closure.} = 7'i64)
  let server = newServerWithWorld(world)
  assert dispatch(d, senderConsole(), server, "time set noon").isOk
  assert now == 6000'i64
  assert dispatch(d, senderConsole(), server, "time set midnight").isOk
  assert now == 18000'i64
  assert dispatch(d, senderConsole(), server, "time add 1s").isOk
  assert now == 18020'i64
  assert dispatch(d, senderConsole(), server, "time set 100").isOk
  assert now == 100'i64
  assert dispatch(d, senderConsole(), server, "time query day").isOk
  assert not dispatch(d, senderConsole(), server, "time query").isOk

proc kickAndMsgBlock() =
  var kicked = 0
  var incoming = ""
  var outgoing = ""
  let entity = CommandEntity(entityTypeName: "player",
    getDisplayName: proc(): TextComponent {.closure.} = text("alice"),
    getName: proc(): TextComponent {.closure.} = text("alice"))
  let alice = CommandPlayer(entity: entity, gameProfile: CmdGameProfile(name: "alice"),
    hasPermission: proc(n: string): bool {.closure.} = true,
    kick: proc(r: TextComponent) {.closure.} = inc(kicked),
    sendMsgOutgoing: proc(m, s, t: TextComponent) {.closure.} = outgoing = getText(m),
    sendMsgIncoming: proc(m, s, t: TextComponent) {.closure.} = incoming = getText(m))
  let everyone = @[alice]
  let server = newServer()
  server.selectPlayers = proc(s: TargetSelector; sender: CommandSender): seq[CommandPlayer] {.closure.} = everyone
  let d = newFallbackDispatcher()
  register(d, kick.initCommandTree(), "minecraft:command.kick")
  register(d, msg.initCommandTree(), "minecraft:command.msg")
  assert dispatch(d, senderConsole(), server, "kick alice").isOk
  assert dispatch(d, senderConsole(), server, "kick alice go away now").isOk
  assert kicked == 2
  assert dispatch(d, senderPlayer(alice), server, "tell alice hello you").isOk
  assert outgoing == "hello you" and incoming == "hello you"
  assert not dispatch(d, senderConsole(), server, "msg alice hi").isOk

proc randomBlock() =
  let d = newCommandDispatcher()
  randomcmd.register(d, newPermissionRegistry())
  let source = consoleSource(newServer(), nil)
  let r = executeInput(d, "random value 3..5", source)
  assert r.isOk and r.value >= 3'i32 and r.value <= 5'i32
  let same = executeInput(d, "random value 3", source)
  assert not same.isOk
  let wide = executeInput(d, "random value ..", source)
  assert not wide.isOk
  # An open top is `i32::MAX`, which from 0 is past MAX_RANGE_SPAN.
  assert not executeInput(d, "random value 0..", source).isOk
  assert executeInput(d, "random roll 1..6", source).isOk

weatherBlock()
timeBlock()
kickAndMsgBlock()
randomBlock()
echo "weather/time/kick/msg/random command tests: all checks passed"
