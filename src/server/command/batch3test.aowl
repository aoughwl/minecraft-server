## `/ban`, `/pardon`, `/whitelist`, `/give`, `/setblock`, `/fill`, `/gamerule` and `/tag` through a real dispatch.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, fallbackdispatch]
import ../../util/[permission, uuid, vector3, vector2]
import ../../util/text/[textbase, text]
import ban, pardon, give, setblock, fill, gamerule, tag, cmdtestutil

proc banBlock() =
  var banned: seq[CmdListEntry] = @[]
  let server = newServer()
  server.onlineMode = proc(): bool {.closure.} = false
  server.offlineUuid = proc(n: string; res: var Uuid): bool {.closure.} =
    res = Uuid(hi: 1'u64, lo: 2'u64)
    true
  server.getBannedPlayers = proc(): seq[CmdListEntry] {.closure.} = banned
  server.addBannedPlayer = proc(e: CmdListEntry) {.closure.} = banned.add(e)
  server.removeBannedPlayer = proc(id: Uuid): bool {.closure.} =
    let had = banned.len > 0
    banned = @[]
    had
  let d = newFallbackDispatcher()
  register(d, ban.initCommandTree(), "minecraft:command.ban")
  register(d, pardon.initCommandTree(), "minecraft:command.pardon")
  assert dispatch(d, senderConsole(), server, "ban someone being rude").isOk
  assert banned.len == 1 and banned[0].reason == "being rude" and banned[0].source == "Server"
  # Banned already, so nothing is added and the command fails.
  assert not dispatch(d, senderConsole(), server, "ban someone").isOk
  assert dispatch(d, senderConsole(), server, "pardon someone").isOk
  assert banned.len == 0
  assert not dispatch(d, senderConsole(), server, "pardon someone").isOk

proc blocksBlock() =
  var placed = 0
  var lastState = 0'u16
  let world = CommandWorld(
    setBlockState: proc(x, y, z: int32; s: uint16; f: uint32) {.closure.} =
      inc placed
      lastState = s)
  let server = newServerWithWorld(world)
  let d = newFallbackDispatcher()
  register(d, setblock.initCommandTree(), "minecraft:command.setblock")
  register(d, fill.initCommandTree(), "minecraft:command.fill")
  assert dispatch(d, senderConsole(), server, "setblock 1 2 3 minecraft:stone").isOk
  assert placed == 1 and lastState != 0'u16
  assert not dispatch(d, senderConsole(), server, "setblock 1 2 3 not_a_block").isOk
  placed = 0
  let r = dispatch(d, senderConsole(), server, "fill 0 0 0 1 1 1 stone")
  assert r.isOk
  assert placed == 8
  placed = 0
  # Outline of a 3 cube skips the middle block.
  assert dispatch(d, senderConsole(), server, "fill 0 0 0 2 2 2 stone outline").isOk
  assert placed == 26

proc gameruleBlock() =
  var stored = CmdGameRuleValue(isInt: true, intValue: 5'i64)
  let server = newServer()
  server.getGameRule = proc(rule: string): CmdGameRuleValue {.closure.} = stored
  server.setGameRule = proc(rule: string; v: CmdGameRuleValue) {.closure.} = stored = v
  let d = newFallbackDispatcher()
  register(d, gamerule.initCommandTree(), "minecraft:command.gamerule")
  var tree = newCommandTree(["x"], "")
  assert getTree(d, "gamerule", tree).isOk
  assert tree.children.len > 10

proc tagBlock() =
  var tags: seq[string] = @[]
  let entity = CommandEntity(entityTypeName: "pig",
    getDisplayName: proc(): TextComponent {.closure.} = text("pig"),
    getName: proc(): TextComponent {.closure.} = text("pig"),
    getPos: proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    isAlive: proc(): bool {.closure.} = true,
    getScoreboardTags: proc(): seq[string] {.closure.} = tags,
    addScoreboardTag: proc(t: string): bool {.closure.} =
      if t in tags:
        return false
      tags.add(t)
      true)
  let entities = @[entity]
  let world = CommandWorld(getEntities: proc(): seq[CommandEntity] {.closure.} = entities)
  let source = consoleSource(newServerWithWorld(world), world)
  let d = newCommandDispatcher()
  tag.register(d, newPermissionRegistry())
  assert executeInput(d, "tag @e add red", source).value == 1'i32
  assert tags == @["red"]
  assert not executeInput(d, "tag @e add red", source).isOk
  assert executeInput(d, "tag @e list", source).value == 1'i32

banBlock()
echo "ban ok"
blocksBlock()
echo "blocks ok"
gameruleBlock()
echo "rule ok"
tagBlock()
echo "batch3 command tests: all checks passed"
