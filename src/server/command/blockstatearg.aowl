## The `[axis=x,lit=true]` half of a block argument (`nether_portal[axis=x]`), which upstream's `BlockArgumentConsumer` does
## not take: vanilla's `BlockStateParser`. Kept in a module of its own because data/block_ext's `Block` is not the command
## tables' `Block` (generated/blockdata).

import std/strutils
import ../../data/block_ext
from ../../data/block_state import asU16

type
  BlockStateSplit* = object
    ## `name[key=value,...]{nbt}` taken apart. `ok` is false for an unclosed or valueless property list.
    ok*: bool
    name*: string
    props*: seq[(string, string)]
    problem*: string  ## "unclosed" or "novalue" or "duplicate"
    key*: string

proc splitBlockState*(raw: string): BlockStateSplit =
  result = BlockStateSplit(ok: true, name: raw, props: @[], problem: "", key: "")
  var text = raw
  let brace = text.find('{')
  if brace >= 0:
    text = text.substr(0, brace - 1)
  let open = text.find('[')
  if open < 0:
    result.name = text
    return
  result.name = text.substr(0, open - 1)
  if not text.endsWith("]"):
    result.ok = false
    result.problem = "unclosed"
    return
  let inner = text.substr(open + 1, text.len - 2).strip()
  if inner.len == 0:
    return
  for part in inner.split(','):
    let eq = part.find('=')
    if eq < 0:
      result.ok = false
      result.problem = "novalue"
      result.key = part.strip()
      return
    let key = part.substr(0, eq - 1).strip()
    let value = part.substr(eq + 1).strip()
    for known in result.props:
      if known[0] == key:
        result.ok = false
        result.problem = "duplicate"
        result.key = key
        return
    result.props.add((key, value))

proc stateIdWithProperties*(registryName: string; props: seq[(string, string)]): (int, string, uint16) =
  ## The state `registryName` has with `props` applied to its default. The first part is 0 for success, 1 for an unknown
  ## block, 2 for a property the block has not (the string names it), 3 for a value it cannot take (the string names the
  ## property). The block's states are scanned for what each property can be, so nothing panics on a bad value.
  let b = Block.fromName(registryName)
  if b == nil:
    return (1, registryName, 0'u16)
  if props.len == 0:
    return (0, "", asU16(b.defaultState.id))
  let (has, _) = b.properties(b.defaultState.id)
  if not has:
    return (2, props[0][0], 0'u16)
  var names: seq[string] = @[]
  var values: seq[seq[string]] = @[]
  for state in b.states:
    let (_, dyn) = b.properties(state.id)
    for pair in dyn.toProps():
      var at = -1
      for i in 0 ..< names.len:
        if names[i] == pair[0]:
          at = i
      if at < 0:
        names.add(pair[0])
        values.add(@[pair[1]])
      elif pair[1] notin values[at]:
        values[at].add(pair[1])
  for prop in props:
    var at = -1
    for i in 0 ..< names.len:
      if names[i] == prop[0]:
        at = i
    if at < 0:
      return (2, prop[0], 0'u16)
    if prop[1] notin values[at]:
      return (3, prop[0], 0'u16)
  (0, "", asU16(fromProperties(b, props).toStateId(b)))
