## Known answers for the `[axis=x]` half of a block argument (vanilla's `BlockStateParser`; upstream's consumer has none).
import std/[assertions, syncio]
import blockstatearg

proc splitting() =
  let plain = splitBlockState("stone")
  assert plain.ok and plain.name == "stone" and plain.props.len == 0
  let portal = splitBlockState("nether_portal[axis=x]")
  assert portal.ok and portal.name == "nether_portal" and portal.props.len == 1
  assert portal.props[0][0] == "axis" and portal.props[0][1] == "x"
  let two = splitBlockState("oak_stairs[facing=east, half=top]{x:1}")
  assert two.ok and two.name == "oak_stairs" and two.props.len == 2
  assert two.props[1][0] == "half" and two.props[1][1] == "top"
  let empty = splitBlockState("stone[]")
  assert empty.ok and empty.props.len == 0
  let unclosed = splitBlockState("stone[axis=x")
  assert not unclosed.ok and unclosed.problem == "unclosed"
  let novalue = splitBlockState("nether_portal[axis]")
  assert not novalue.ok and novalue.problem == "novalue" and novalue.key == "axis"
  let duplicate = splitBlockState("nether_portal[axis=x,axis=z]")
  assert not duplicate.ok and duplicate.problem == "duplicate" and duplicate.key == "axis"

proc states() =
  # No properties: the default state, and a property on a block that has none is unknown.
  let (code0, _, stone) = stateIdWithProperties("stone", @[])
  assert code0 == 0 and stone == 1'u16
  let (codeP, keyP, _) = stateIdWithProperties("stone", @[("axis", "x")])
  assert codeP == 2 and keyP == "axis"
  let (codeB, _, _) = stateIdWithProperties("no_such_block", @[])
  assert codeB == 1
  # A portal's two axes are two states, neither of which is the default's twin by accident.
  let (cx, _, ax) = stateIdWithProperties("nether_portal", @[("axis", "x")])
  let (cz, _, az) = stateIdWithProperties("nether_portal", @[("axis", "z")])
  assert cx == 0 and cz == 0 and ax != az
  let (cBad, kBad, _) = stateIdWithProperties("nether_portal", @[("axis", "y")])
  assert cBad == 3 and kBad == "axis"
  let (cKey, kKey, _) = stateIdWithProperties("nether_portal", @[("colour", "x")])
  assert cKey == 2 and kKey == "colour"
  # Stairs: facing changes the state, and a property left out stays at the default.
  let (ce, _, east) = stateIdWithProperties("oak_stairs", @[("facing", "east")])
  let (cw, _, west) = stateIdWithProperties("oak_stairs", @[("facing", "west")])
  let (cd, _, plainStairs) = stateIdWithProperties("oak_stairs", @[])
  assert ce == 0 and cw == 0 and cd == 0
  assert east != west and east != plainStairs or west != plainStairs
  let (ct, _, eastTop) = stateIdWithProperties("oak_stairs", @[("facing", "east"), ("half", "top")])
  assert ct == 0 and eastTop != east

splitting()
states()
echo "block state argument tests: all checks passed"
