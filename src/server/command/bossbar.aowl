## The `/bossbar` command.
## Port of pumpkin/src/command/commands/bossbar.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/uuid
import ../../util/text/[textbase, text]
import ../../generated/translation
import cmdcommon

const
  Names = ["bossbar"]
  Description = "Display bossbar"
  ArgName = "name"
  ArgVisible = "visible"
  ArgId = "id"                 # `ResourceLocationArgumentConsumer`'s default name.
  ArgColor = "color"
  ArgStyle = "style"
  ArgTarget = "target"
  ArgMax = "max"
  ArgValue = "value"

type
  CommandValueGet = enum
    cvgMax
    cvgPlayers
    cvgValue
    cvgVisible

  CommandValueSet = enum
    cvsColor
    cvsMax
    cvsName
    cvsPlayers
    cvsPlayersNone
    cvsStyle
    cvsValue
    cvsVisible

proc bossbarPrefix(title: TextComponent; namespace: string): TextComponent =
  hoverEvent(addChild(addChild(text("["), title), text("]")), showText(text(namespace)))

proc handleBossbarError(status: CmdBossbarStatus): CommandResult =
  if status.kind == 1'i32:
    return cmdFailed(translateCross(JAVA_COMMANDS_BOSSBAR_UNKNOWN, BEDROCK_COMMANDS_BOSSBAR_NOTFOUND, [text(status.location)]))
  let key =
    if status.detail.len == 0: "commands.bossbar.set." & status.what & ".unchanged"
    else: "commands.bossbar.set." & status.what & ".unchanged." & status.detail
  cmdFailed(translateCross(key, key))

proc colorIndex(name: string): int32 =
  case name
  of "pink": 0'i32
  of "blue": 1'i32
  of "red": 2'i32
  of "green": 3'i32
  of "yellow": 4'i32
  of "purple": 5'i32
  else: 6'i32

proc styleIndex(name: string): int32 =
  case name
  of "notched_6": 1'i32
  of "notched_10": 2'i32
  of "notched_12": 3'i32
  of "notched_20": 4'i32
  else: 0'i32

proc maxValueConsumer(): ArgumentConsumer = newBoundedI32(ArgMax, some(1'i32))
proc valueConsumer(): ArgumentConsumer = newBoundedI32(ArgValue, some(0'i32))

proc addExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil or server.bossbarGet == nil or server.bossbarCreate == nil or server.bossbarAll == nil:
    return cmdInvalidRequirement()
  var namespace = ""
  if not findString(args, ArgId, akResourceLocation, namespace):
    return missing(ArgId)
  if ':' notin namespace:
    namespace = "minecraft:" & namespace
  var title = empty()
  if not findText(args, ArgName, title):
    return missing(ArgName)
  var existing = CmdBossbar()
  if server.bossbarGet(namespace, existing):
    return cmdFailed(translateCross(JAVA_COMMANDS_BOSSBAR_CREATE_FAILED, BEDROCK_COMMANDS_BOSSBAR_ADD_FAILURE_EXISTS,
      [text(namespace)]))
  server.bossbarCreate(namespace, title)
  let newSize = server.bossbarAll().len
  sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_CREATE_SUCCESS, BEDROCK_COMMANDS_BOSSBAR_ADD_SUCCESS,
    [bossbarPrefix(title, namespace)]))
  cmdSuccess(int32(newSize))

proc getExecutor(which: CommandValueGet): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    if server == nil or server.bossbarGet == nil:
      return cmdInvalidRequirement()
    var namespace = ""
    if not findString(args, ArgId, akResourceLocation, namespace):
      return missing(ArgId)
    var bar = CmdBossbar()
    if not server.bossbarGet(namespace, bar):
      return handleBossbarError(CmdBossbarStatus(kind: 1'i32, location: namespace))
    let prefix = bossbarPrefix(bar.title, namespace)
    case which
    of cvgMax:
      sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_GET_MAX, BEDROCK_COMMANDS_BOSSBAR_GET_MAX, [prefix, text($bar.max)]))
      cmdSuccess(bar.max)
    of cvgPlayers:
      cmdSuccess(int32(bar.players.len))
    of cvgValue:
      sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_GET_VALUE, BEDROCK_COMMANDS_BOSSBAR_GET_VALUE, [prefix, text($bar.value)]))
      cmdSuccess(bar.value)
    of cvgVisible:
      let (javaKey, bedrockKey) =
        if bar.visible: (JAVA_COMMANDS_BOSSBAR_SET_VISIBLE_SUCCESS_VISIBLE, BEDROCK_COMMANDS_BOSSBAR_GET_VISIBLE_TRUE)
        else: (JAVA_COMMANDS_BOSSBAR_SET_VISIBLE_SUCCESS_HIDDEN, BEDROCK_COMMANDS_BOSSBAR_GET_VISIBLE_FALSE)
      sendMessage(sender, translateCross(javaKey, bedrockKey, [prefix]))
      cmdSuccess(if bar.visible: 1'i32 else: 0'i32)

proc listExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil or server.bossbarAll == nil:
    return cmdInvalidRequirement()
  let bars = server.bossbarAll()
  if bars.len == 0:
    sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_LIST_BARS_NONE, BEDROCK_COMMANDS_BOSSBAR_LIST_NONE))
    return cmdSuccess(0'i32)
  var list = empty()
  for i in 0 ..< bars.len:
    if i == 0:
      list = addChild(list, bossbarPrefix(bars[i].title, bars[i].namespace))
    else:
      list = addChild(list, addChild(text(", "), bossbarPrefix(bars[i].title, bars[i].namespace)))
  sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_LIST_BARS_SOME, BEDROCK_COMMANDS_BOSSBAR_LIST, [text($bars.len), list]))
  cmdSuccess(int32(bars.len))

proc removeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil or server.bossbarGet == nil or server.bossbarRemove == nil:
    return cmdInvalidRequirement()
  var namespace = ""
  if not findString(args, ArgId, akResourceLocation, namespace):
    return missing(ArgId)
  var bar = CmdBossbar()
  if not server.bossbarGet(namespace, bar):
    return handleBossbarError(CmdBossbarStatus(kind: 1'i32, location: namespace))
  sendMessage(sender, translateCross(JAVA_COMMANDS_BOSSBAR_REMOVE_SUCCESS, BEDROCK_COMMANDS_BOSSBAR_REMOVE,
    [bossbarPrefix(bar.title, namespace)]))
  let status = server.bossbarRemove(namespace)
  if status.kind != 0'i32:
    return handleBossbarError(status)
  cmdSuccess(int32(server.bossbarAll().len))

proc setExecutor(which: CommandValueSet): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    if server == nil or server.bossbarGet == nil:
      return cmdInvalidRequirement()
    var namespace = ""
    if not findString(args, ArgId, akResourceLocation, namespace):
      return missing(ArgId)
    var bar = CmdBossbar()
    if not server.bossbarGet(namespace, bar):
      return handleBossbarError(CmdBossbarStatus(kind: 1'i32, location: namespace))
    let prefix = bossbarPrefix(bar.title, namespace)
    var status = CmdBossbarStatus()
    case which
    of cvsColor:
      var color = ""
      if not findString(args, ArgColor, akBossbarColor, color):
        return missing(ArgColor)
      if server.bossbarSetColor != nil:
        status = server.bossbarSetColor(namespace, colorIndex(color))
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.color.success", [prefix]))
      cmdSuccess(0'i32)
    of cvsMax:
      var maxValue = 0'i32
      let r = requireI32(args, ArgMax, maxValue)
      if not r.isOk:
        return cmdFailed(translateCross("parsing.int.invalid", "parsing.int.invalid", [text($int32.high)]))
      if server.bossbarSetHealth != nil:
        status = server.bossbarSetHealth(namespace, maxValue, bar.value)
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.max.success", [prefix, text($maxValue)]))
      cmdSuccess(maxValue)
    of cvsName:
      var title = empty()
      if not findText(args, ArgName, title):
        return missing(ArgName)
      if server.bossbarSetName != nil:
        status = server.bossbarSetName(namespace, title)
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.name.success", [bossbarPrefix(title, namespace)]))
      cmdSuccess(0'i32)
    of cvsPlayersNone:
      if server.bossbarSetPlayers != nil:
        status = server.bossbarSetPlayers(namespace, @[])
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.players.success.none", [prefix]))
      cmdSuccess(0'i32)
    of cvsPlayers:
      var targets: seq[CommandPlayer] = @[]
      if not findPlayers(args, ArgTarget, targets):
        return missing(ArgTarget)
      var ids: seq[Uuid] = @[]
      var names: seq[string] = @[]
      for p in targets:
        ids.add(p.gameProfile.id)
        names.add(p.gameProfile.name)
      if server.bossbarSetPlayers != nil:
        status = server.bossbarSetPlayers(namespace, ids)
      if status.kind != 0'i32:
        return handleBossbarError(status)
      var joined = ""
      for i in 0 ..< names.len:
        if i > 0:
          joined.add(", ")
        joined.add(names[i])
      sendMessage(sender, tc("commands.bossbar.set.players.success.some", [prefix, text($targets.len), text(joined)]))
      cmdSuccess(int32(targets.len))
    of cvsStyle:
      var style = ""
      if not findString(args, ArgStyle, akBossbarStyle, style):
        return missing(ArgStyle)
      if server.bossbarSetDivision != nil:
        status = server.bossbarSetDivision(namespace, styleIndex(style))
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.style.success", [prefix]))
      cmdSuccess(0'i32)
    of cvsValue:
      var value = 0'i32
      let r = requireI32(args, ArgValue, value)
      if not r.isOk:
        return cmdFailed(translateCross("parsing.int.invalid", "parsing.int.invalid", [text($int32.high)]))
      if server.bossbarSetHealth != nil:
        status = server.bossbarSetHealth(namespace, bar.max, value)
      if status.kind != 0'i32:
        return handleBossbarError(status)
      sendMessage(sender, tc("commands.bossbar.set.value.success", [prefix, text($value)]))
      cmdSuccess(value)
    of cvsVisible:
      var visible = false
      if not findBool(args, ArgVisible, visible):
        return missing(ArgVisible)
      if server.bossbarSetVisible != nil:
        status = server.bossbarSetVisible(namespace, visible)
      if status.kind != 0'i32:
        return handleBossbarError(status)
      let state = if visible: "commands.bossbar.set.visible.success.visible" else: "commands.bossbar.set.visible.success.hidden"
      sendMessage(sender, tc(state, [prefix]))
      cmdSuccess(if visible: 1'i32 else: 0'i32)

proc idArg(): NonLeafNodeBuilder = argument(ArgId, newResourceLocationArgumentConsumer())

proc initCommandTree*(): CommandTree =
  let addB = then(literal("add"), then(idArg(), execute(argument(ArgName, newTextComponentArgConsumer()), addExecutor)))
  var getB = idArg()
  getB = then(getB, execute(literal("max"), getExecutor(cvgMax)))
  getB = then(getB, execute(literal("players"), getExecutor(cvgPlayers)))
  getB = then(getB, execute(literal("value"), getExecutor(cvgValue)))
  getB = then(getB, execute(literal("visible"), getExecutor(cvgVisible)))
  var setB = idArg()
  setB = then(setB, then(literal("color"), execute(argument(ArgColor, newBossbarColorArgumentConsumer()), setExecutor(cvsColor))))
  setB = then(setB, then(literal("max"), execute(argument(ArgMax, maxValueConsumer()), setExecutor(cvsMax))))
  setB = then(setB, then(literal("name"), execute(argument(ArgName, newTextComponentArgConsumer()), setExecutor(cvsName))))
  setB = then(setB, execute(then(literal("players"), execute(argument(ArgTarget, newPlayersArgumentConsumer()), setExecutor(cvsPlayers))),
    setExecutor(cvsPlayersNone)))
  setB = then(setB, then(literal("style"), execute(argument(ArgStyle, newBossbarStyleArgumentConsumer()), setExecutor(cvsStyle))))
  setB = then(setB, then(literal("value"), execute(argument(ArgValue, valueConsumer()), setExecutor(cvsValue))))
  setB = then(setB, then(literal("visible"), execute(argument(ArgVisible, newBoolArgConsumer()), setExecutor(cvsVisible))))
  var t = newCommandTree(Names, Description)
  t = then(t, addB)
  t = then(t, then(literal("get"), getB))
  t = then(t, execute(literal("list"), listExecutor))
  t = then(t, then(literal("remove"), execute(idArg(), removeExecutor)))
  then(t, then(literal("set"), setB))
