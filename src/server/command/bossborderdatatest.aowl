## `/bossbar`, `/worldborder` and `/data get entity` through the fallback dispatcher, over recording hooks.
import std/[options, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../nbt/tag
import ../../util/[uuid, vector2, vector3]
import ../../util/text/[textbase, text]
import bossbar, worldborder, data, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc bossbarBlock() =
  var bars: seq[CmdBossbar] = @[]
  var lastPlayers: seq[Uuid] = @[]
  let server = newServer()
  proc find(location: string): int {.closure.} =
    for i in 0 ..< bars.len:
      if bars[i].namespace == location:
        return i
    -1
  server.bossbarAll = proc(): seq[CmdBossbar] {.closure.} = bars
  server.bossbarGet = proc(location: string; res: var CmdBossbar): bool {.closure.} =
    let i = find(location)
    if i < 0:
      return false
    res = bars[i]
    true
  server.bossbarCreate = proc(ns: string; title: TextComponent) {.closure.} =
    bars.add(CmdBossbar(namespace: ns, title: title, max: 100'i32, value: 0'i32, visible: true))
  server.bossbarRemove = proc(location: string): CmdBossbarStatus {.closure.} =
    let i = find(location)
    if i < 0:
      return CmdBossbarStatus(kind: 1'i32, location: location)
    bars.delete(i)
    CmdBossbarStatus()
  server.bossbarSetHealth = proc(location: string; max, value: int32): CmdBossbarStatus {.closure.} =
    let i = find(location)
    if bars[i].max == max and bars[i].value == value:
      return CmdBossbarStatus(kind: 2'i32, what: "value")
    bars[i].max = max
    bars[i].value = value
    CmdBossbarStatus()
  server.bossbarSetVisible = proc(location: string; visible: bool): CmdBossbarStatus {.closure.} =
    let i = find(location)
    if bars[i].visible == visible:
      return CmdBossbarStatus(kind: 2'i32, what: "visibility", detail: (if visible: "visible" else: "hidden"))
    bars[i].visible = visible
    CmdBossbarStatus()
  server.bossbarSetColor = proc(location: string; color: int32): CmdBossbarStatus {.closure.} =
    bars[find(location)].color = color
    CmdBossbarStatus()
  server.bossbarSetDivision = proc(location: string; division: int32): CmdBossbarStatus {.closure.} =
    bars[find(location)].division = division
    CmdBossbarStatus()
  server.bossbarSetName = proc(location: string; title: TextComponent): CmdBossbarStatus {.closure.} =
    bars[find(location)].title = title
    CmdBossbarStatus()
  server.bossbarSetPlayers = proc(location: string; players: seq[Uuid]): CmdBossbarStatus {.closure.} =
    bars[find(location)].players = players
    lastPlayers = players
    CmdBossbarStatus()
  let steve = CommandPlayer(entity: CommandEntity(entityTypeId: "minecraft:player"),
    gameProfile: CmdGameProfile(name: "Steve", id: Uuid(hi: 1'u64, lo: 2'u64)))
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.selectPlayers = proc(selector: TargetSelector; sender: CommandSender): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  let d = newFallbackDispatcher()
  register(d, bossbar.initCommandTree(), "minecraft:command.bossbar")
  proc run(line: string): CommandResult {.closure.} = dispatch(d, senderConsole(), server, line)

  check(run("bossbar list").isOk and run("bossbar list").isOk, "line 71")
  check(run("bossbar add foo \"Dragon\"").isOk, "line 72")
  check(bars.len == 1 and bars[0].namespace == "minecraft:foo" and getText(bars[0].title) == "Dragon", "line 73")
  check(not run("bossbar add foo \"Again\"").isOk, "line 74")
  let r2 = run("bossbar add test:two \"Two\"")
  check(r2.isOk and bars.len == 2, "second bar")
  check(run("bossbar get minecraft:foo max").isOk, "line 76")
  check(run("bossbar set minecraft:foo max 40").isOk and bars[0].max == 40'i32, "line 77")
  check(not run("bossbar set minecraft:foo max 0").isOk, "line 78")
  check(run("bossbar set minecraft:foo value 10").isOk and bars[0].value == 10'i32, "line 79")
  check(not run("bossbar set minecraft:foo value 10").isOk, "line 80")
  check(run("bossbar get minecraft:foo value").isOk, "line 81")
  check(run("bossbar set minecraft:foo color red").isOk and bars[0].color == 2'i32, "line 82")
  check(run("bossbar set minecraft:foo style notched_12").isOk and bars[0].division == 3'i32, "line 83")
  check(run("bossbar set minecraft:foo visible false").isOk and not bars[0].visible, "line 84")
  check(not run("bossbar set minecraft:foo visible false").isOk, "line 85")
  check(run("bossbar get minecraft:foo visible").isOk, "line 86")
  check(run("bossbar set minecraft:foo players Steve").isOk and lastPlayers == @[Uuid(hi: 1'u64, lo: 2'u64)], "line 87")
  check(run("bossbar get minecraft:foo players").isOk, "line 88")
  check(run("bossbar set minecraft:foo players").isOk and lastPlayers.len == 0, "line 89")
  check(run("bossbar set minecraft:foo name \"Wither\"").isOk and getText(bars[0].title) == "Wither", "line 90")
  check(not run("bossbar get nothere max").isOk, "line 91")
  check(run("bossbar remove minecraft:foo").isOk and bars.len == 1, "line 92")
  check(not run("bossbar remove minecraft:foo").isOk, "line 93")

proc borderBlock() =
  var border = CmdBorder(centerX: 0.0, centerZ: 0.0, newDiameter: 100.0, warningBlocks: 5'i32, warningTime: 15'i32)
  var lastDiameter = (0.0, false, 0'i64)
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getBorder = proc(): CmdBorder {.closure.} = border
  world.setBorderCenter = proc(x, z: float64) {.closure.} =
    border.centerX = x
    border.centerZ = z
  world.setBorderDiameter = proc(diameter: float64; hasSpeed: bool; speed: int64) {.closure.} =
    lastDiameter = (diameter, hasSpeed, speed)
    border.newDiameter = diameter
  world.setBorderWarningDelay = proc(v: int32) {.closure.} = border.warningTime = v
  world.setBorderWarningDistance = proc(v: int32) {.closure.} = border.warningBlocks = v
  world.setBorderDamageAmount = proc(v: float32) {.closure.} = border.damagePerBlock = v
  world.setBorderDamageBuffer = proc(v: float32) {.closure.} = border.buffer = v
  let server = newServerWithWorld(world)
  let d = newFallbackDispatcher()
  register(d, worldborder.initCommandTree(), "minecraft:command.worldborder")
  proc run(line: string): CommandResult {.closure.} = dispatch(d, senderConsole(), server, line)

  check(run("worldborder get").isOk, "line 115")
  check(run("worldborder set 200").isOk and lastDiameter == (200.0, false, 0'i64), "line 116")
  check(not run("worldborder set 200").isOk, "line 117")
  check(run("worldborder set 50 30").isOk and lastDiameter == (50.0, true, 30000'i64), "line 118")
  check(run("worldborder add 10").isOk and border.newDiameter == 60.0, "line 119")
  check(not run("worldborder add 0").isOk, "line 120")
  check(run("worldborder add 5 4").isOk and lastDiameter == (65.0, true, 4000'i64), "line 121")
  check(run("worldborder center 12 -7").isOk and border.centerX == 12.5 and border.centerZ == -6.5, "line 122")
  check(run("worldborder damage amount 0.5").isOk and border.damagePerBlock == 0.5'f32, "line 123")
  check(not run("worldborder damage amount 0.5").isOk, "line 124")
  check(run("worldborder damage buffer 3").isOk and border.buffer == 3.0'f32, "line 125")
  check(run("worldborder warning distance 9").isOk and border.warningBlocks == 9'i32, "line 126")
  check(not run("worldborder warning distance 9").isOk, "line 127")
  check(run("worldborder warning time 20").isOk and border.warningTime == 20'i32, "line 128")
  check(not run("worldborder set -1").isOk, "line 129")

proc dataBlock() =
  var nbt = newCompound()
  nbt.putInt("Health", 20'i32)
  nbt.putString("Name", "Steve \"S\"")
  var pos: seq[NbtTag] = @[]
  pos.add(nbtTag(1.5'f64))
  pos.add(nbtTag(2.0'f64))
  nbt.putList("Pos", pos)
  let steve = CommandPlayer(gameProfile: CmdGameProfile(name: "Steve"))
  steve.entity = CommandEntity(entityTypeId: "minecraft:player", player: steve,
    getDisplayName: proc(): TextComponent {.closure.} = text("Steve"),
    writeNbt: proc(): NbtCompound {.closure.} = nbt)
  let server = newServer()
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  server.selectEntities = proc(selector: TargetSelector; sender: CommandSender): seq[CommandEntity] {.closure.} = @[steve.entity]
  let d = newFallbackDispatcher()
  register(d, data.initCommandTree(), "minecraft:command.data")
  let r = dispatch(d, senderConsole(), server, "data get entity Steve")
  check(r.isOk, "data get entity")
  # The colourful display: `getI32Result` and the SNBT text rules, known answers.
  var shown = empty()
  check(snbtColorfulDisplay(NbtTag(kind: ntkInt, intVal: 7'i32), 0, shown).len == 0 and getText(shown) == "7", "line 157")
  check(snbtColorfulDisplay(nbtTag(2.0'f64), 0, shown).len == 0 and getText(shown) == "2d", "line 158")
  var arr: seq[NbtTag] = @[]
  check(snbtColorfulDisplay(NbtTag(kind: ntkList, listVal: arr), 0, shown).len == 0 and getText(shown) == "[]", "line 160")
  check(snbtColorfulDisplay(NbtTag(kind: ntkEnd), 0, shown) == "Unexpected end tag", "line 161")
  var n = 0'i32
  check(getI32Result(nbtTag(-1.5'f32), n) and n == -2'i32, "line 163")  # floor, not truncation
  check(getI32Result(NbtTag(kind: ntkLong, longVal: 1'i64 shl 40), n) and n == int32.high, "line 164")
  check(getI32Result(nbtTag("abcd"), n) and n == 4'i32, "line 165")
  check(not getI32Result(NbtTag(kind: ntkEnd), n), "line 166")

bossbarBlock()
borderBlock()
dataBlock()
echo "bossbar, worldborder and data command tests: all checks passed"
