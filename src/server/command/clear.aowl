## The `/clear` command.
## Port of pumpkin/src/command/commands/clear.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import args_resource

const
  Names = ["clear"]
  Description = "Clear your inventory or that of target(s)"
  ArgTargets = "targets"
  ArgItem = "item"
  ArgMaxCount = "max_count"
  MaxNoUpperLimit = -1'i32
  MaxNoClearButSimulate = 0'i32

proc clearPlayer(target: CommandPlayer; item: ItemPredicate; max0: int32): int32 =
  ## `clear_player`, `iter_test_and_clear` and `test_and_clear`. A full stop in the main inventory also skips the
  ## equipment, as `is_done` does; the hook gives both lists in that order.
  var count = 0'i32
  var maxLeft = max0
  if target.getInventorySlots == nil:
    return 0'i32
  let slots = target.getInventorySlots()
  for slot in slots:
    let stack = slot.getStack()
    if stack.itemKey.len == 0 or not testItemStack(item, stack):
      continue
    let itemCount = stack.count
    if maxLeft == MaxNoClearButSimulate:
      count += itemCount
    elif maxLeft == MaxNoUpperLimit:
      count += itemCount
      slot.setStack(CmdItemStack())
    else:
      let taken = min(maxLeft, itemCount)
      count += taken
      if taken == itemCount:
        slot.setStack(CmdItemStack())
        maxLeft -= taken
        if maxLeft == 0'i32:
          break
      else:
        var left = stack
        left.count = itemCount - taken
        slot.setStack(left)
        maxLeft -= taken
        break
  count

proc commandResult(sender: CommandSender; itemCount, maxCount: int32; targets: seq[CommandPlayer]): CommandResult =
  let single = targets.len == 1
  if itemCount == 0'i32:
    if single:
      return cmdFailed(tc2(JAVA_CLEAR_FAILED_SINGLE, BEDROCK_COMMANDS_CLEAR_FAILURE, [shown(targets[0])]))
    return cmdFailed(tc2(JAVA_CLEAR_FAILED_MULTIPLE, BEDROCK_COMMANDS_CLEAR_FAILURE, [text($targets.len)]))
  let msg =
    if maxCount != 0'i32:
      if single: tc(JAVA_COMMANDS_CLEAR_SUCCESS_SINGLE, [text($itemCount), shown(targets[0])])
      else: tc(JAVA_COMMANDS_CLEAR_SUCCESS_MULTIPLE, [text($itemCount), text($targets.len)])
    else:
      if single: tc(JAVA_COMMANDS_CLEAR_TEST_SINGLE, [text($itemCount), shown(targets[0])])
      else: tc(JAVA_COMMANDS_CLEAR_TEST_MULTIPLE, [text($itemCount), text($targets.len)])
  sendMessage(sender, msg)
  cmdSuccess(itemCount)

proc selfExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  let target = sender.player
  commandResult(sender, clearPlayer(target, ItemPredicate(kind: ipAny), MaxNoUpperLimit), MaxNoUpperLimit, @[target])

proc allExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var total = 0'i32
  for target in targets:
    total += clearPlayer(target, ItemPredicate(kind: ipAny), MaxNoUpperLimit)
  commandResult(sender, total, MaxNoUpperLimit, targets)

proc itemExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var item = ItemPredicate(kind: ipAny)
  let f = findItemPredicate(args, ArgItem, item)
  if not f.isOk:
    return f
  var total = 0'i32
  for target in targets:
    total += clearPlayer(target, item, MaxNoUpperLimit)
  commandResult(sender, total, MaxNoUpperLimit, targets)

proc itemCountExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var item = ItemPredicate(kind: ipAny)
  let f = findItemPredicate(args, ArgItem, item)
  if not f.isOk:
    return f
  var a = Arg()
  if not findNum(args, ArgMaxCount, a):
    return missing(ArgMaxCount)
  if not a.numInBounds:
    return cmdFailed(tc(JAVA_PARSING_INT_INVALID, [text($int32.high)]))
  var total = 0'i32
  for target in targets:
    total += clearPlayer(target, item, a.num.i32)
  commandResult(sender, total, a.num.i32, targets)

proc initCommandTree*(): CommandTree =
  let countN = execute(argument(ArgMaxCount, newBoundedI32(ArgMaxCount, some(0'i32))), itemCountExecutor)
  let itemN = then(execute(argument(ArgItem, newItemPredicateArgumentConsumer()), itemExecutor), countN)
  then(then(newCommandTree(Names, Description), then(execute(argument(ArgTargets, newPlayersArgumentConsumer()), allExecutor), itemN)),
    execute(require(isPlayerSender), selfExecutor))
