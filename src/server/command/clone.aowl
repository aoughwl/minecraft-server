## The `/clone` command.
## Port of pumpkin/src/command/commands/clone.rs
## PARTIAL: pumpkin/src/command/commands/clone.rs - block entities are not copied: the world has no `get_block_entity`/`add_block_entity` hook yet (`block_entity_from_nbt` is not written), so a cloned chest arrives empty.

import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argument_types, coordinates, cmddispatch]
import ../../util/[vector3, permission]
import ../../util/math/position
import ../../util/text/[textbase, text]
import ../../generated/translation

type
  MaskMode = enum
    mmReplace
    mmMasked
    mmFiltered

  CloneMode = enum
    cmNormal
    cmForce
    cmMove

const
  Description = "Clones blocks from one region to another."
  Permission0 = "minecraft:command.clone"
  ArgBegin = "begin"
  ArgEnd = "end"
  ArgDest = "destination"
  ArgFilter = "filter"
  AirState = 0'u16

proc overlapError(): CommandErrorType = errorType0(JAVA_COMMANDS_CLONE_OVERLAP, BEDROCK_COMMANDS_CLONE_NOOVERLAP)
proc toobigError(): CommandErrorType = errorType2(JAVA_COMMANDS_CLONE_TOOBIG, BEDROCK_COMMANDS_CLONE_TOOMANYBLOCKS)
proc failedError(): CommandErrorType = errorType0(JAVA_COMMANDS_CLONE_FAILED, BEDROCK_COMMANDS_CLONE_FAILED)
proc notLoadedError(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_UNLOADED, JAVA_ARGUMENT_POS_UNLOADED)
proc outOfWorldError(): CommandErrorType = errorType0(JAVA_ARGUMENT_POS_OUTOFWORLD, JAVA_ARGUMENT_POS_OUTOFWORLD)

proc cloneExecutor(mask: MaskMode; cloneMode: CloneMode; hasFilter: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let beginR = getBlockPos(context, ArgBegin)
    if not beginR.isOk:
      return cmdFail[int32](beginR.error)
    let endR = getBlockPos(context, ArgEnd)
    if not endR.isOk:
      return cmdFail[int32](endR.error)
    let destR = getBlockPos(context, ArgDest)
    if not destR.isOk:
      return cmdFail[int32](destR.error)
    var filterId = -1
    if hasFilter:
      let fb = getBlockArg(context, ArgFilter)
      if not fb.isOk:
        return cmdFail[int32](fb.error)
      filterId = fb.value.id
    let bg = beginR.value.vec
    let en = endR.value.vec
    let dest = destR.value.vec
    let minX = min(bg.x, en.x)
    let maxX = max(bg.x, en.x)
    let minY = min(bg.y, en.y)
    let maxY = max(bg.y, en.y)
    let minZ = min(bg.z, en.z)
    let maxZ = max(bg.z, en.z)
    let sizeX = maxX - minX + 1
    let sizeY = maxY - minY + 1
    let sizeZ = maxZ - minZ + 1
    let volume = int64(sizeX) * int64(sizeY) * int64(sizeZ)
    if volume > 32768'i64:
      return cmdFail[int32](createWithoutContext(toobigError(), text("32768"), text($volume)))
    let destMinX = dest.x
    let destMinY = dest.y
    let destMinZ = dest.z
    let destMaxX = destMinX + sizeX - 1
    let destMaxY = destMinY + sizeY - 1
    let destMaxZ = destMinZ + sizeZ - 1
    let overlap = not (destMaxX < minX or destMinX > maxX or destMaxY < minY or destMinY > maxY or
                       destMaxZ < minZ or destMinZ > maxZ)
    if overlap and cloneMode != cmForce:
      return cmdFail[int32](createWithoutContext(overlapError()))
    let world = context.source.world
    if world == nil or world.getBlockStateId == nil or world.setBlockState == nil:
      return cmdFail[int32](createWithoutContext(notLoadedError()))
    if world.isInBuildLimit != nil and
       (not world.isInBuildLimit(minX, minY, minZ) or not world.isInBuildLimit(maxX, maxY, maxZ) or
        not world.isInBuildLimit(destMinX, destMinY, destMinZ) or not world.isInBuildLimit(destMaxX, destMaxY, destMaxZ)):
      return cmdFail[int32](createWithoutContext(outOfWorldError()))
    if world.isChunkLoaded != nil:
      for cx in (minX shr 4) .. (maxX shr 4):
        for cz in (minZ shr 4) .. (maxZ shr 4):
          if not world.isChunkLoaded(cx, cz):
            return cmdFail[int32](createWithoutContext(notLoadedError()))
      for cx in (destMinX shr 4) .. (destMaxX shr 4):
        for cz in (destMinZ shr 4) .. (destMaxZ shr 4):
          if not world.isChunkLoaded(cx, cz):
            return cmdFail[int32](createWithoutContext(notLoadedError()))
    # Every selected block is read before any is written, so an overlapping `force` clone copies the old region.
    var srcs: seq[Vector3[int32]] = @[]
    var states: seq[uint16] = @[]
    for x in 0'i32 ..< sizeX:
      for y in 0'i32 ..< sizeY:
        for z in 0'i32 ..< sizeZ:
          let sx = minX + x
          let sy = minY + y
          let sz = minZ + z
          let stateId = world.getBlockStateId(sx, sy, sz)
          var shouldClone = true
          case mask
          of mmReplace:
            shouldClone = true
          of mmMasked:
            shouldClone = world.isAirState == nil or not world.isAirState(stateId)
          of mmFiltered:
            shouldClone = world.getBlockId != nil and world.getBlockId(sx, sy, sz) == filterId
          if shouldClone:
            srcs.add(Vector3[int32](x: sx, y: sy, z: sz))
            states.add(stateId)
    let notifyAll = cbfForceState or cbfNotifyNeighbors
    var count = 0'i32
    for i in 0 ..< srcs.len:
      let rx = srcs[i].x - minX
      let ry = srcs[i].y - minY
      let rz = srcs[i].z - minZ
      world.setBlockState(destMinX + rx, destMinY + ry, destMinZ + rz, states[i], notifyAll)
      inc count
    if count == 0'i32:
      return cmdFail[int32](createWithoutContext(failedError()))
    if cloneMode == cmMove:
      for i in 0 ..< srcs.len:
        let s = srcs[i]
        let inDest = s.x >= destMinX and s.x <= destMaxX and s.y >= destMinY and s.y <= destMaxY and
                     s.z >= destMinZ and s.z <= destMaxZ
        if not inDest:
          world.setBlockState(s.x, s.y, s.z, AirState, notifyAll)
    sendFeedback(context.source, translateCross(JAVA_COMMANDS_CLONE_SUCCESS, BEDROCK_COMMANDS_CLONE_SUCCESS, [text($count)]), true)
    cmdOk[int32](count)

proc withModes(b0: ArgumentBuilder; mask: MaskMode; hasFilter: bool): ArgumentBuilder =
  var b = then(b0, executes(literal("force"), cloneExecutor(mask, cmForce, hasFilter)))
  b = then(b, executes(literal("move"), cloneExecutor(mask, cmMove, hasFilter)))
  then(b, executes(literal("normal"), cloneExecutor(mask, cmNormal, hasFilter)))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let replaceN = withModes(executes(literal("replace"), cloneExecutor(mmReplace, cmNormal, false)), mmReplace, false)
  let maskedN = withModes(executes(literal("masked"), cloneExecutor(mmMasked, cmNormal, false)), mmMasked, false)
  let filterArg = withModes(executes(argument(ArgFilter, newBlockArgumentType()), cloneExecutor(mmFiltered, cmNormal, true)),
    mmFiltered, true)
  var destN = executes(argument(ArgDest, newBlockPosArgumentType()), cloneExecutor(mmReplace, cmNormal, false))
  destN = then(destN, replaceN)
  destN = then(destN, maskedN)
  destN = then(destN, then(literal("filtered"), filterArg))
  discard register(dispatcher, then(requires(command("clone", Description), Permission0),
    then(argument(ArgBegin, newBlockPosArgumentType()), then(argument(ArgEnd, newBlockPosArgumentType()), destN))))
