## `/clone` through the dispatcher over recording hooks: blocks move, and a block entity at the source arrives at the destination with the destination position.
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../nbt/tag
import ../../util/permission
import clone, cmdtestutil

var failures = 0

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    inc failures

proc main() =
  var placed: seq[(int32, int32, int32, uint16)] = @[]
  var added: seq[NbtCompound] = @[]
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getBlockStateId = proc(x, y, z: int32): uint16 {.closure.} =
    if x == 0'i32 and y == 0'i32 and z == 0'i32: 7'u16 else: 0'u16
  world.setBlockState = proc(x, y, z: int32; stateId: uint16; flags: uint32) {.closure.} =
    placed.add((x, y, z, stateId))
  world.getBlockEntityNbt = proc(x, y, z: int32; res: var NbtCompound): bool {.closure.} =
    if x == 0'i32 and y == 0'i32 and z == 0'i32:
      var c = newCompound()
      c.insert("id", NbtTag(kind: ntkString, stringVal: "minecraft:chest"))
      c.insert("x", NbtTag(kind: ntkInt, intVal: 0))
      c.insert("y", NbtTag(kind: ntkInt, intVal: 0))
      c.insert("z", NbtTag(kind: ntkInt, intVal: 0))
      res = c
      return true
    false
  world.addBlockEntityNbt = proc(nbt: NbtCompound): bool {.closure.} =
    added.add(nbt)
    true
  let server = newServerWithWorld(world)
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  clone.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)
  let r = run("clone 0 0 0 0 0 0 10 20 30")
  check(r.isOk, "clone runs")
  check(placed.len == 1 and placed[0][0] == 10'i32 and placed[0][1] == 20'i32 and placed[0][2] == 30'i32 and placed[0][3] == 7'u16,
    "state placed at the destination")
  check(added.len == 1, "one block entity added")
  if added.len == 1:
    let c = added[0]
    check(c.get("x")[0] and c.get("x")[1].intVal == 10, "entity x moved")
    check(c.get("y")[0] and c.get("y")[1].intVal == 20, "entity y moved")
    check(c.get("z")[0] and c.get("z")[1].intVal == 30, "entity z moved")
    check(c.get("id")[0] and c.get("id")[1].stringVal == "minecraft:chest", "entity id kept")
  if failures > 0: quit 1
  echo "clonetest ok"

main()
