## What the command files share.
import std/options
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/text/[textbase, text]

proc tc*(key: string): TextComponent = translateCross(key, key)
proc tc*(key: string; args: openArray[TextComponent]): TextComponent = translateCross(key, key, args)
proc tc2*(java, bedrock: string; args: openArray[TextComponent]): TextComponent = translateCross(java, bedrock, args)
proc tc2*(java, bedrock: string): TextComponent = translateCross(java, bedrock)

proc shown*(p: CommandPlayer): TextComponent = p.entity.getDisplayName()
proc shown*(e: CommandEntity): TextComponent = e.getDisplayName()

proc missing*(name: string): CommandResult = cmdInvalidConsumption(some(name))

proc firstWorld*(server: nil CommandServer): nil CommandWorld =
  ## `server.worlds.load().first()`.
  if server == nil or server.getWorlds == nil:
    return nil
  let worlds = server.getWorlds()
  if worlds.len == 0:
    return nil
  worlds[0]

proc isPlayerSender*(sender: CommandSender): bool = isPlayer(sender)

proc lowI32*(v: int64): int32 =
  ## `as i32`: truncates.
  cast[int32](uint32(cast[uint64](v) and 0xFFFFFFFF'u64))

proc clampI32*(v: int64): int32 =
  ## `clamp(i32::MIN, i32::MAX) as i32`.
  if v < int64(int32.low): int32.low
  elif v > int64(int32.high): int32.high
  else: int32(v)
