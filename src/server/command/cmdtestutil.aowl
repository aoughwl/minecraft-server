## What the command tests share: a console source on a server of hooks that record what a command did.
import ../../command/[cmdsource, cmdtree, cmddispatch]
import ../../util/[vector2, vector3, permission, uuid, gamemode]
import ../../util/text/[textbase, text]

proc newServer*(): CommandServer =
  CommandServer(opPermissionLevel: Four, permissionRegistry: newPermissionRegistry())

proc newServerWithWorld*(world: CommandWorld): CommandServer =
  result = newServer()
  let worlds = @[world]
  result.getWorlds = proc(): seq[CommandWorld] {.closure.} = worlds
  result.getOverworld = proc(): nil CommandWorld {.closure.} = world

proc consoleSource*(server: CommandServer; world: nil CommandWorld): CommandSource =
  newCommandSource(senderConsole(), world, nil, Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    Vector2[float32](x: 0.0'f32, y: 0.0'f32), "Server", text("Server"), server)

