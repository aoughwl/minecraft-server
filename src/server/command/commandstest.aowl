## The default dispatcher: permissions gate as upstream registers them, and the tree serializes.
## Port of the `dynamic_command` test in pumpkin/src/command/dispatcher.rs.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, fallbackdispatch, client_suggestions]
import ../../protocol/java/client/play/commands
import ../../util/permission
import default_dispatcher, cmdtestutil

proc noop(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult = cmdSuccess(1'i32)

proc dynamicCommand() =
  let d = defaultDispatcher(newPermissionRegistry())
  register(d.fallbackDispatcher, newCommandTree(["test"], "test_desc"), "minecraft:test")

proc gating() =
  let registry = newPermissionRegistry()
  let d = defaultDispatcher(registry)
  let server = newServer()
  server.permissionRegistry = registry
  # A dummy source: `seed` requires Op(Two), and a command block level is Two, so the requirement passes on the
  # registry path but the executor then runs with no world and seed 0.
  let source = withOutput(consoleSource(server, nil), senderDummy())
  assert executeInput(d, "seed", source).isOk
  # `stop` is Op(Four), above a dummy's Two, so the node is not usable and the input is unknown.
  let r = executeInput(d, "stop", source)
  assert not r.isOk
  assert r.error.isType(dispatcherUnknownCommand())
  assert hasPermission(source, "minecraft:command.selector")

proc treeSerializes() =
  let d = defaultDispatcher(newPermissionRegistry())
  let p = buildCCommands(senderConsole(), nil, d)
  assert p.nodes.len > 10
  let root = p.nodes[int(p.rootNodeIndex.value)]
  assert root.nodeType.kind == pnkRoot
  assert root.children.len >= 15

dynamicCommand()
gating()
treeSerializes()
echo "default dispatcher: all checks passed"
