## The `/damage` command.
## Port of pumpkin/src/command/commands/damage.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["damage"]
  Description = "Deals damage to entities"
  ArgTarget = "target"
  ArgAmount = "amount"
  ArgDamageType = "damageType"
  ArgLocation = "location"
  ArgEntity = "entity"
  ArgCause = "cause"

proc amountConsumer(): ArgumentConsumer = newBoundedF32(ArgAmount, some(0.0'f32))

proc sendDamageResult(sender: CommandSender; success: bool; amount: float32; targetName: TextComponent): CommandResult =
  if not success:
    return cmdFailed(tc(JAVA_COMMANDS_DAMAGE_INVULNERABLE))
  sendMessage(sender, tc2(JAVA_COMMANDS_DAMAGE_SUCCESS, BEDROCK_COMMANDS_DAMAGE_SUCCESS, [text($amount), targetName]))
  cmdSuccess(1'i32) # not arbitrary, this is what vanilla does

proc commonArgs(args: ConsumedArgs; target: var seq[CommandEntity]; amount: var float32; damageType: var string): CommandResult =
  if not findEntity(args, ArgTarget, target):
    return missing(ArgTarget)
  var a = Arg()
  if not findNum(args, ArgAmount, a) or not a.numInBounds:
    return cmdFailed(text("Invalid damage amount"))
  amount = a.num.f32
  damageType = "generic"
  discard findString(args, ArgDamageType, akDamageType, damageType)
  cmdSuccess(0'i32)

proc locationExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target: seq[CommandEntity] = @[]
  var amount = 0.0'f32
  var damageType = ""
  let c = commonArgs(args, target, amount, damageType)
  if not c.isOk:
    return c
  var location = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, location):
    return missing(ArgLocation)
  let e = target[0]
  let success = e.damageWithContext != nil and e.damageWithContext(amount, damageType, some(location), nil, nil)
  sendDamageResult(sender, success, amount, shown(e))

proc entityExecutor(withCause: bool): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var target: seq[CommandEntity] = @[]
    var amount = 0.0'f32
    var damageType = ""
    let c = commonArgs(args, target, amount, damageType)
    if not c.isOk:
      return c
    var source: nil CommandEntity = nil
    var found: seq[CommandEntity] = @[]
    if findEntity(args, ArgEntity, found):
      source = found[0]
    var cause: nil CommandEntity = nil
    if withCause and findEntity(args, ArgCause, found):
      cause = found[0]
    let e = target[0]
    let success = e.damageWithContext != nil and e.damageWithContext(amount, damageType, none[Vector3[float64]](), source, cause)
    sendDamageResult(sender, success, amount, shown(e))

proc initCommandTree*(): CommandTree =
  let by = then(literal("by"), then(execute(argument(ArgEntity, newEntityArgumentConsumer()), entityExecutor(false)),
    then(literal("from"), execute(argument(ArgCause, newEntityArgumentConsumer()), entityExecutor(true)))))
  let at0 = then(literal("at"), execute(argument(ArgLocation, newPosition3DArgumentConsumer()), locationExecutor))
  let dt = then(then(execute(argument(ArgDamageType, newDamageTypeArgumentConsumer()), entityExecutor(false)), at0), by)
  then(newCommandTree(Names, Description), then(argument(ArgTarget, newEntityArgumentConsumer()),
    then(execute(argument(ArgAmount, amountConsumer()), entityExecutor(false)), dt)))
