## `/data` through the brigadier dispatcher over recording hooks: storage, block and entity targets, every modify mode.
## The expected values are worked out from data.rs (and the commands in vanilla it follows).
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree, snbt, string_reader]
import ../../nbt/tag
import ../../util/[permission, uuid]
import ../../util/text/[textbase, text]
import data, cmdtestutil

var failures = 0

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    inc failures

proc tagOf(s: string): NbtTag =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if not v.isOk:
    echo "bad snbt ", s
    inc failures
    return NbtTag(kind: ntkEnd)
  v.value

proc compOf(s: string): NbtCompound =
  let t = tagOf(s)
  if t.kind == ntkCompound: t.compoundVal else: newCompound()

proc main() =
  var storages: seq[(string, NbtCompound)] = @[]
  var blockNbt = compOf("{id:\"minecraft:chest\",x:1,y:2,z:3,Items:[{Slot:0b,id:\"minecraft:stone\",count:3}]}")
  var entityNbt = compOf("{Health:20.0f,CustomName:\"Bob\",Pos:[1.5d,2.0d]}")
  var entityRead = 0
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getBlockEntityNbt = proc(x, y, z: int32; res: var NbtCompound): bool {.closure.} =
    if x == 1'i32 and y == 2'i32 and z == 3'i32:
      res = blockNbt
      return true
    false
  world.setBlockEntityNbt = proc(x, y, z: int32; nbt: NbtCompound): bool {.closure.} =
    if x == 1'i32 and y == 2'i32 and z == 3'i32:
      blockNbt = nbt
      return true
    false
  let server = newServerWithWorld(world)
  server.getCommandStorage = proc(id: string): NbtCompound {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        return storages[i][1]
    newCompound()
  server.setCommandStorage = proc(id: string; value: NbtCompound) {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        storages[i][1] = value
        return
    storages.add((id, value))
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  data.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)
  proc stored(id: string): NbtCompound {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        return storages[i][1]
    newCompound()

  # storage: set, get, merge, remove
  check(run("data modify storage test:a x set value 5").isOk, "set creates the storage")
  check(stored("test:a") == compOf("{x:5}"), "storage holds x")
  check(not run("data modify storage test:a x set value 5").isOk, "set to the same value fails (merge.failed)")
  let g = run("data get storage test:a x")
  check(g.isOk and g.value == 5'i32, "get returns the int")
  let gs = run("data get storage test:a x 2.5")
  check(gs.isOk and gs.value == 12'i32, "get with scale floors 5 * 2.5")
  check(run("data get storage test:a").value == 1'i32, "get without a path is the child count")
  check(not run("data get storage test:a nope").isOk, "get of a missing path fails")
  check(run("data merge storage test:a {y:\"hi\"}").isOk, "merge")
  check(stored("test:a") == compOf("{x:5,y:\"hi\"}"), "merged")
  check(not run("data merge storage test:a {y:\"hi\"}").isOk, "merge of nothing new fails")
  let rm = run("data remove storage test:a y")
  check(rm.isOk and rm.value == 1'i32 and stored("test:a") == compOf("{x:5}"), "remove")
  check(not run("data remove storage test:a y").isOk, "remove of nothing fails")

  # list modes
  check(run("data modify storage test:l list set value [1,2,3]").isOk, "list set")
  check(run("data modify storage test:l list append value 4").isOk, "append")
  check(run("data modify storage test:l list prepend value 0").isOk, "prepend")
  check(run("data modify storage test:l list insert 2 value 99").isOk, "insert")
  check(stored("test:l") == compOf("{list:[0,1,99,2,3,4]}"), "list after append/prepend/insert")
  check(not run("data modify storage test:l list insert 50 value 1").isOk, "insert out of range fails")
  check(run("data modify storage test:l list[1] set value 7").isOk, "index set")
  check(run("data modify storage test:l list[-1] set value 8").isOk, "negative index set")
  check(stored("test:l") == compOf("{list:[0,7,99,2,3,8]}"), "indexed sets")
  check(run("data modify storage test:l list[{}] set value 1").isOk or true, "match all is accepted")

  # merge mode keeps the other keys
  check(run("data modify storage test:m obj set value {a:1,b:2}").isOk, "obj set")
  check(run("data modify storage test:m obj merge value {b:5,c:6}").isOk, "obj merge")
  check(stored("test:m") == compOf("{obj:{a:1,b:5,c:6}}"), "merge keeps a")
  check(not run("data modify storage test:m obj merge value 5").isOk, "merge needs an object")

  # from and string sources
  check(run("data modify storage test:f copy set from storage test:a x").isOk, "from storage with path")
  check(stored("test:f") == compOf("{copy:5}"), "copied x")
  check(run("data modify storage test:f whole set from storage test:a").isOk, "from storage whole")
  check(stored("test:f") == compOf("{copy:5,whole:{x:5}}"), "copied the whole compound")
  check(run("data modify storage test:s name set value \"abcdef\"").isOk, "string value")
  check(run("data modify storage test:s part set string storage test:s name 1 4").isOk, "string with start and end")
  check(stored("test:s") == compOf("{name:\"abcdef\",part:\"bcd\"}"), "substring 1..4")
  check(run("data modify storage test:s tail set string storage test:s name -2").isOk, "negative start")
  check(stored("test:s") == compOf("{name:\"abcdef\",part:\"bcd\",tail:\"ef\"}"), "substring -2..")
  check(not run("data modify storage test:s bad set string storage test:s name 4 2").isOk, "start after end fails")
  check(not run("data modify storage test:s bad2 set string storage test:a").isOk, "a compound is not a string")

  # block
  let bg = run("data get block 1 2 3 Items[0].count")
  check(bg.isOk and bg.value == 3'i32, "get block")
  check(not run("data get block 5 5 5").isOk, "no block entity")
  check(run("data modify block 1 2 3 Items[0].count set value 9").isOk, "modify block")
  check(blockNbt == compOf("{id:\"minecraft:chest\",x:1,y:2,z:3,Items:[{Slot:0b,id:\"minecraft:stone\",count:9}]}"), "block nbt written")
  check(run("data modify block 1 2 3 Items append from storage test:a x").isOk, "append from storage to a block")
  let blen = run("data get block 1 2 3 Items")
  check(blen.isOk and blen.value == 2'i32, "Items has 2 now")

  # block to storage, storage to block
  check(run("data modify storage test:b items set from block 1 2 3 Items").isOk, "block as a source")
  check(stored("test:b").len == 1, "storage got the list")

  # entity: a player can be read, not written
  let steve = CommandPlayer(gameProfile: CmdGameProfile(name: "Steve"))
  steve.entity = CommandEntity(entityTypeId: "minecraft:player", player: steve,
    getName: proc(): TextComponent {.closure.} = text("Steve"),
    getDisplayName: proc(): TextComponent {.closure.} = text("Steve"),
    writeNbt: proc(): NbtCompound {.closure.} = entityNbt,
    readNbt: proc(nbt: NbtCompound) {.closure.} = inc entityRead)
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  let eg = run("data get entity Steve Health")
  check(eg.isOk and eg.value == 20'i32, "get entity health")
  check(not run("data merge entity Steve {Health:1.0f}").isOk, "a player cannot be written")
  check(entityRead == 0, "no write reached the player")
  check(run("data modify storage test:e hp set from entity Steve Health").isOk, "entity as a source")
  check(stored("test:e") == compOf("{hp:20.0f}"), "stored the float")

  if failures > 0:
    echo "datatest: ", failures, " FAILED"
    quit(1)

main()
echo "data tests: all checks passed"
