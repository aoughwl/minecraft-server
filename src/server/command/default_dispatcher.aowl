## The default command set.
## Port of pumpkin/src/command/commands/mod.rs
## PARTIAL: pumpkin/src/command/commands/mod.rs - every command upstream registers is registered and every permission has upstream's text and level, except `plugin` (the singular plugin-management command; its permission `pumpkin:command.plugin` is registered, the command is the plugin host's).

import ../../util/permission
import ../../command/[cmddispatch, fallbackdispatch]
import stop, seed, saveoff, saveon, saveall, list, kill, setidletimeout, difficulty
import ban, banip, banlist, pardon, pardonip, whitelist, op, deop, tellraw, transfer, teammsg, title, stopsound, playsound, particle, summon, setblock, give, gamerule, spawnpoint, setworldspawn, damage, enchant, experience, effect, clear, tag, fill
import bossbar, data, worldborder, scoreboard, team, tick, trigger, forceload, recipe
import place, clone, fillbiome, spreadplayers, ride, loot, item, rotate, spectate
import dialog, help, pumpkin, attribute, advancement
import execute, teleport, tps, plugins, me, say, gamemode, defaultgamemode, weather, time, kick, msg, random

proc addPermission(registry: PermissionRegistry; node, description: string; defaultValue: PermissionDefault) =
  registerPermissionOrPanic(registry, newPermission(node, description, defaultValue))

proc registerLevel0Permissions(registry: PermissionRegistry) =
  addPermission(registry, "pumpkin:command.pumpkin", "Shows information about the Pumpkin server", permissionAllow())
  addPermission(registry, "minecraft:command.me", "Broadcasts a narrative message about the player", permissionAllow())

proc registerLevel0PermissionsMsg(registry: PermissionRegistry) =
  addPermission(registry, "minecraft:command.msg", "Sends a private message to another player", permissionAllow())

proc registerLevel2Permissions(registry: PermissionRegistry) =
  addPermission(registry, "minecraft:command.worldborder", "Manages the world border", permissionOp(Two))
  addPermission(registry, "minecraft:command.playsound", "Plays a sound to players", permissionOp(Two))
  addPermission(registry, "minecraft:command.experience", "Adds, removes or queries player experience", permissionOp(Two))
  addPermission(registry, "minecraft:command.stopsound", "Stops sounds from playing", permissionOp(Two))
  addPermission(registry, "minecraft:command.defaultgamemode", "Sets the default game mode for new players", permissionOp(Two))
  addPermission(registry, "minecraft:command.spawnpoint", "Sets the spawn point for a player", permissionOp(Two))
  addPermission(registry, "minecraft:command.effect", "Adds or removes status effects", permissionOp(Two))
  addPermission(registry, "minecraft:command.teleport", "Teleports entities to other locations", permissionOp(Two))
  addPermission(registry, "minecraft:command.time", "Changes or queries the world's game time", permissionOp(Two))
  addPermission(registry, "minecraft:command.give", "Gives an item to a player", permissionOp(Two))
  addPermission(registry, "minecraft:command.item", "Replace items in inventories", permissionOp(Two))
  addPermission(registry, "minecraft:command.clear", "Clears items from player inventory", permissionOp(Two))
  addPermission(registry, "minecraft:command.setblock", "Changes a block to another block", permissionOp(Two))
  addPermission(registry, "minecraft:command.fill", "Fills a region with a specific block", permissionOp(Two))
  addPermission(registry, "minecraft:command.tellraw", "Displays a JSON message to players", permissionOp(Two))
  addPermission(registry, "minecraft:command.title", "Controls screen titles displayed to players", permissionOp(Two))
  addPermission(registry, "minecraft:command.summon", "Summons an entity", permissionOp(Two))
  addPermission(registry, "minecraft:command.weather", "Sets the weather in the server", permissionOp(Two))
  addPermission(registry, "minecraft:command.particle", "Creates particles in the world", permissionOp(Two))
  addPermission(registry, "minecraft:command.rotate", "Changes the rotation of an entity", permissionOp(Two))
  addPermission(registry, "minecraft:command.damage", "Damages entities", permissionOp(Two))
  addPermission(registry, "minecraft:command.bossbar", "Creates and manages boss bars", permissionOp(Two))
  addPermission(registry, "minecraft:command.say", "Broadcasts a message to multiple players", permissionOp(Two))
  addPermission(registry, "minecraft:command.gamemode", "Sets a player's game mode", permissionOp(Two))
  addPermission(registry, "minecraft:command.gamerule", "Sets a player's game mode", permissionOp(Two))
  addPermission(registry, "minecraft:command.enchant", "Adds an enchantment to a player's selected item, subject to the same restrictions as an anvil. Also works on any mob or entity holding a weapon/tool/armor in its main hand.", permissionOp(Two))
  addPermission(registry, "pumpkin:command.tps", "Displays the server TPS and MSPT", permissionOp(Two))

proc registerLevel3Permissions(registry: PermissionRegistry) =
  addPermission(registry, "minecraft:command.setworldspawn", "Sets the world spawn point", permissionOp(Three))
  addPermission(registry, "minecraft:command.whitelist", "Manages server whitelist", permissionOp(Three))
  addPermission(registry, "minecraft:command.deop", "Revokes operator status from a player", permissionOp(Three))
  addPermission(registry, "minecraft:command.kick", "Removes players from the server", permissionOp(Three))
  addPermission(registry, "pumpkin:command.plugin", "Manages server plugins", permissionOp(Three))
  addPermission(registry, "pumpkin:command.plugins", "Lists all plugins loaded on the server", permissionOp(Three))
  addPermission(registry, "minecraft:command.ban", "Adds players to banlist", permissionOp(Three))
  addPermission(registry, "minecraft:command.banip", "Adds IP addresses to banlist", permissionOp(Three))
  addPermission(registry, "minecraft:command.pardon", "Removes entries from the player banlist", permissionOp(Three))
  addPermission(registry, "minecraft:command.pardonip", "Removes entries from the IP banlist", permissionOp(Three))
  addPermission(registry, "minecraft:command.transfer", "Transfers the player to another server", permissionOp(Three))

proc registerPermissions(registry: PermissionRegistry) =
  registerLevel0Permissions(registry)
  registerLevel0PermissionsMsg(registry)
  registerLevel2Permissions(registry)
  registerLevel3Permissions(registry)
  addPermission(registry, "minecraft:command.spectate", "Allows a player to spectate another entity", permissionOp(Two))
  addPermission(registry, "minecraft:command.selector", "Allows a player to use selector variables", permissionAllow())

proc defaultDispatcher*(registry: PermissionRegistry): CommandDispatcher =
  ## `default_dispatcher`. Upstream builds the fallback dispatcher first and wraps it in a new node dispatcher.
  registerPermissions(registry)
  result = newCommandDispatcher()
  execute.register(result, registry)
  let fallback = result.fallbackDispatcher
  # Zero
  register(fallback, pumpkin.initCommandTree(), "pumpkin:command.pumpkin")
  register(fallback, me.initCommandTree(), "minecraft:command.me")
  register(fallback, msg.initCommandTree(), "minecraft:command.msg")
  # Two
  register(fallback, teleport.initCommandTree(), "minecraft:command.teleport")
  register(fallback, time.initCommandTree(), "minecraft:command.time")
  register(fallback, tps.initCommandTree(), "pumpkin:command.tps")
  register(fallback, weather.initCommandTree(), "minecraft:command.weather")
  register(fallback, say.initCommandTree(), "minecraft:command.say")
  register(fallback, gamemode.initCommandTree(), "minecraft:command.gamemode")
  register(fallback, defaultgamemode.initCommandTree(), "minecraft:command.defaultgamemode")
  register(fallback, effect.initCommandTree(), "minecraft:command.effect")
  register(fallback, give.initCommandTree(), "minecraft:command.give")
  register(fallback, enchant.initCommandTree(), "minecraft:command.enchant")
  register(fallback, clear.initCommandTree(), "minecraft:command.clear")
  register(fallback, setblock.initCommandTree(), "minecraft:command.setblock")
  register(fallback, fill.initCommandTree(), "minecraft:command.fill")
  register(fallback, playsound.initCommandTree(), "minecraft:command.playsound")
  register(fallback, tellraw.initCommandTree(), "minecraft:command.tellraw")
  register(fallback, title.initCommandTree(), "minecraft:command.title")
  register(fallback, summon.initCommandTree(), "minecraft:command.summon")
  register(fallback, experience.initCommandTree(), "minecraft:command.experience")
  register(fallback, particle.initCommandTree(), "minecraft:command.particle")
  register(fallback, damage.initCommandTree(), "minecraft:command.damage")
  register(fallback, gamerule.initCommandTree(), "minecraft:command.gamerule")
  register(fallback, stopsound.initCommandTree(), "minecraft:command.stopsound")
  register(fallback, setworldspawn.initCommandTree(), "minecraft:command.setworldspawn")
  register(fallback, spawnpoint.initCommandTree(), "minecraft:command.spawnpoint")
  register(fallback, item.initCommandTree(), "minecraft:command.item")
  register(fallback, rotate.initCommandTree(), "minecraft:command.rotate")
  register(fallback, spectate.initCommandTree(), "minecraft:command.spectate")
  # Three
  register(fallback, deop.initCommandTree(), "minecraft:command.deop")
  register(fallback, ban.initCommandTree(), "minecraft:command.ban")
  register(fallback, banip.initCommandTree(), "minecraft:command.banip")
  register(fallback, pardon.initCommandTree(), "minecraft:command.pardon")
  register(fallback, pardonip.initCommandTree(), "minecraft:command.pardonip")
  register(fallback, whitelist.initCommandTree(), "minecraft:command.whitelist")
  register(fallback, transfer.initCommandTree(), "minecraft:command.transfer")
  register(fallback, kick.initCommandTree(), "minecraft:command.kick")
  register(fallback, plugins.initCommandTree(), "pumpkin:command.plugins")
  register(fallback, worldborder.initCommandTree(), "minecraft:command.worldborder")
  register(fallback, bossbar.initCommandTree(), "minecraft:command.bossbar")
  data.register(result, registry)
  banlist.register(result, registry)
  tick.register(result, registry)
  scoreboard.register(result, registry)
  team.register(result, registry)
  trigger.register(result, registry)
  forceload.register(result, registry)
  recipe.register(result, registry)
  op.register(result, registry)
  teammsg.register(result, registry)
  tag.register(result, registry)
  difficulty.register(result, registry)
  kill.register(result, registry)
  random.register(result, registry)
  list.register(result, registry)
  seed.register(result, registry)
  saveall.register(result, registry)
  saveoff.register(result, registry)
  saveon.register(result, registry)
  setidletimeout.register(result, registry)
  stop.register(result, registry)
  clone.register(result, registry)
  place.register(result, registry)
  fillbiome.register(result, registry)
  spreadplayers.register(result, registry)
  ride.register(result, registry)
  loot.register(result, registry)
  dialog.register(result, registry)
  help.register(result, registry)
  attribute.register(result, registry)
  advancement.register(result, registry)
