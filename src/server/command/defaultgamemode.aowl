## The `/defaultgamemode` command.
## Port of pumpkin/src/command/commands/defaultgamemode.rs

import ../../util/closureset
import std/options
import ../../util/gamemode
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["defaultgamemode"]
  Description = "Change the default gamemode"
  ArgGamemode* = "gamemode"

proc debugName(g: GameMode): string =
  case g
  of Survival: "survival"
  of Creative: "creative"
  of Adventure: "adventure"
  of Spectator: "spectator"

proc defaultGamemodeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var gamemode = Survival
  if not findGameMode(args, ArgGamemode, gamemode):
    return cmdInvalidConsumption(some(ArgGamemode))
  var successfulChanges = 0'i32
  if server != nil and server.forceGamemode != nil and closureSet(server.getAllPlayers):
    let force = server.forceGamemode()
    if force:
      let players = server.getAllPlayers()
      for player in players:
        if closureSet(player.setGameMode) and player.setGameMode(gamemode):
          inc successfulChanges
  let key = "gameMode." & debugName(gamemode)
  sendMessage(sender, translateCross(JAVA_COMMANDS_DEFAULTGAMEMODE_SUCCESS, BEDROCK_COMMANDS_DEFAULTGAMEMODE_SUCCESS, [translateCross(key, key)]))
  if server != nil and closureSet(server.setDefaultGamemode):
    server.setDefaultGamemode(gamemode)
  cmdSuccess(successfulChanges)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgGamemode, newGamemodeArgumentConsumer()), defaultGamemodeExecutor))
