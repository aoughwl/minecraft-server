## `/defaultgamemode`: force on changes players, force off does not, bad input fails.
import std/[assertions, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/gamemode
import defaultgamemode, cmdtestutil

proc block0() =
  let d = newFallbackDispatcher()
  register(d, defaultgamemode.initCommandTree(), "minecraft:command.defaultgamemode")
  var force = true
  var defaultMode = Survival
  var changed = 0
  let player = CommandPlayer(entity: CommandEntity(entityTypeName: "player"), gameProfile: CmdGameProfile(name: "a"),
    setGameMode: proc(m: GameMode): bool {.closure.} =
      inc changed
      true)
  let players = @[player]
  let server = newServer()
  server.forceGamemode = proc(): bool {.closure.} = force
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.setDefaultGamemode = proc(m: GameMode) {.closure.} = defaultMode = m
  assert dispatch(d, senderConsole(), server, "defaultgamemode creative").isOk
  assert changed == 1 and defaultMode == Creative
  force = false
  assert dispatch(d, senderConsole(), server, "defaultgamemode adventure").isOk
  assert changed == 1 and defaultMode == Adventure
  assert not dispatch(d, senderConsole(), server, "defaultgamemode nope").isOk

block0()
echo "defaultgamemode command tests: all checks passed"
