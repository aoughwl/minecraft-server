## The `/deop` command.
## Port of pumpkin/src/command/commands/deop.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["deop"]
  Description = "Revokes operator status from a player."
  ArgTargets = "targets"

proc deopExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CmdGameProfile] = @[]
  if not findGameProfiles(args, ArgTargets, targets):
    return missing(ArgTargets)
  if server == nil:
    return cmdInvalidRequirement()
  var succeeded = 0'i32
  for profile in targets:
    if closureSet(server.removeOp) and server.removeOp(profile.id):
      inc succeeded
      if closureSet(server.getPlayerByUuid):
        let player = server.getPlayerByUuid(profile.id)
        if player != nil and closureSet(player.setPermissionLvl):
          player.setPermissionLvl(Zero)
      sendMessage(sender, tc2(JAVA_COMMANDS_DEOP_SUCCESS, BEDROCK_COMMANDS_DEOP_SUCCESS, [text(profile.name)]))
  if succeeded > 0'i32 and closureSet(server.saveOps):
    server.saveOps()
  if succeeded == 0'i32:
    return cmdFailed(tc2(JAVA_COMMANDS_DEOP_FAILED, BEDROCK_COMMANDS_DEOP_FAILED))
  cmdSuccess(succeeded)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgTargets, newGameProfilesArgumentConsumer(gpsOpNames, false)), deopExecutor))
