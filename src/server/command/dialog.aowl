## The `/dialog` command.
## Port of pumpkin/src/command/commands/dialog.rs

import ../../util/closureset
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argument_types, entity_selector, cmddispatch]
import ../../util/permission
import ../../util/text/[textbase, text]

const
  Description = "Manages player dialog screens."
  Permission0 = "minecraft:command.dialog"
  ArgTargets = "targets"
  ArgDialog = "dialog"

proc registryError(): CommandErrorType =
  literalErrorType("Registry-defined dialogs are not yet supported. Please specify the dialog inline using SNBT.")

proc getDialog(context: CommandContext; name: string): CmdResult[DialogArg] =
  ## `DialogArgumentType::get`.
  var found = false
  let v = argumentOf(context, name, found)
  if not found:
    return cmdFail[DialogArg](missingArgument(name))
  if not (v of DialogValue):
    return cmdFail[DialogArg](wrongArgumentType(name))
  cmdOk[DialogArg](DialogValue(v).value)

proc clearExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getPlayers(context, ArgTargets)
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let list = targets.value
  for target in list:
    if closureSet(target.clearDialog):
      target.clearDialog()
  let msg =
    if list.len == 1: text("Cleared dialog for " & list[0].gameProfile.name)
    else: text("Cleared dialogs for " & $list.len & " players")
  sendFeedback(context.source, msg, true)
  cmdOk[int32](int32(list.len))

proc showExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getPlayers(context, ArgTargets)
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let dialog = getDialog(context, ArgDialog)
  if not dialog.isOk:
    return cmdFail[int32](dialog.error)
  if not dialog.value.isNbt:
    return cmdFail[int32](createWithoutContext(registryError()))
  let list = targets.value
  for target in list:
    if closureSet(target.showDialog):
      target.showDialog(dialog.value.nbt)
  let msg =
    if list.len == 1: text("Showed dialog to " & list[0].gameProfile.name)
    else: text("Showed dialog to " & $list.len & " players")
  sendFeedback(context.source, msg, true)
  cmdOk[int32](int32(list.len))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let clear = then(literal("clear"), executes(argument(ArgTargets, newEntityArgumentType(eakPlayers)), clearExecutor))
  let show = then(literal("show"), then(argument(ArgTargets, newEntityArgumentType(eakPlayers)),
    executes(argument(ArgDialog, newDialogArgumentType()), showExecutor)))
  discard register(dispatcher, then(then(requires(command("dialog", Description), Permission0), clear), show))
