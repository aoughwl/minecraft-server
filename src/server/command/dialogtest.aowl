## `/dialog show` and `/dialog clear` run through a real dispatcher.
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../nbt/tag
import ../../util/[permission, vector2, vector3]
import ../../util/text/[textbase, text]
import dialog, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  var shown = 0
  var cleared = 0
  var lastType = ""
  let steve = CommandPlayer(entity: CommandEntity(entityTypeId: "minecraft:player"), gameProfile: CmdGameProfile(name: "Steve"))
  steve.entity.player = steve
  steve.entity.getDisplayName = proc(): TextComponent {.closure.} = text("Steve")
  steve.showDialog = proc(d: NbtTag) {.closure.} =
    inc shown
    if d.kind == ntkCompound:
      lastType = "compound"
  steve.clearDialog = proc() {.closure.} = inc cleared
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  let server = newServerWithWorld(world)
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  server.selectPlayers = proc(selector: TargetSelector; sender: CommandSender): seq[CommandPlayer] {.closure.} = players
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  dialog.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)

  let a = run("dialog show Steve {type:\"minecraft:notice\",title:\"Hello\"}")
  check(a.isOk and a.value == 1'i32, "show inline")
  check(shown == 1 and lastType == "compound", "show reached the player with a compound")
  check(not run("dialog show Steve minecraft:server_links").isOk, "registry dialogs are refused")
  check(shown == 1, "refused show sends nothing")
  let c = run("dialog clear Steve")
  check(c.isOk and c.value == 1'i32 and cleared == 1, "clear")
  check(not run("dialog show Steve").isOk, "show needs a dialog")

main()
echo "dialog command tests: all checks passed"
