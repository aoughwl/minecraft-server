## The `/difficulty` command.
## Port of pumpkin/src/command/commands/difficulty.rs

import ../../util/difficulty
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Query or change the difficulty of the world."
  Permission0 = "minecraft:command.difficulty"

proc failureErrorType(): CommandErrorType = errorType1("commands.difficulty.failure", "commands.difficulty.failure")

proc currentDifficulty(server: nil CommandServer): Difficulty =
  if server != nil and server.getDifficulty != nil:
    server.getDifficulty()
  else:
    Normal

proc queryExecutor(context: CommandContext): CmdResult[int32] =
  let d = currentDifficulty(context.source.server)
  let key = translationKey(d)
  sendFeedback(context.source, translateCross("commands.difficulty.query", "commands.difficulty.query", [translateCross(key, key)]), false)
  cmdOk[int32](int32(ord(d)))

proc setExecutor(difficulty: Difficulty): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let server = context.source.server
    if currentDifficulty(server) == difficulty:
      return cmdFail[int32](createWithoutContext(failureErrorType(), text(name(difficulty))))
    if server != nil and server.setDifficulty != nil:
      server.setDifficulty(difficulty)
    let key = translationKey(difficulty)
    sendFeedback(context.source, translateCross(JAVA_COMMANDS_DIFFICULTY_SUCCESS, BEDROCK_COMMANDS_DIFFICULTY_SUCCESS, [translateCross(key, key)]), true)
    cmdOk[int32](0'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  var b = requires(command("difficulty", Description), Permission0)
  b = then(b, executes(literal("peaceful"), setExecutor(Peaceful)))
  b = then(b, executes(literal("easy"), setExecutor(Easy)))
  b = then(b, executes(literal("normal"), setExecutor(Normal)))
  b = then(b, executes(literal("hard"), setExecutor(Hard)))
  discard register(dispatcher, executes(b, queryExecutor))
