## `/difficulty`: query, set, and the already-set failure.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch]
import ../../util/[permission, difficulty as diff]
import difficulty, cmdtestutil

proc block0() =
  let d = newCommandDispatcher()
  difficulty.register(d, newPermissionRegistry())
  var current = Easy
  let server = newServer()
  server.getDifficulty = proc(): Difficulty {.closure.} = current
  server.setDifficulty = proc(v: Difficulty) {.closure.} = current = v
  let source = consoleSource(server, nil)
  assert executeInput(d, "difficulty", source).value == int32(ord(Easy))
  let r = executeInput(d, "difficulty hard", source)
  assert r.isOk and r.value == 0'i32
  assert current == Hard
  assert not executeInput(d, "difficulty hard", source).isOk

block0()
echo "difficulty command tests: all checks passed"
