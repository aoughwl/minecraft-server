## The `/effect` command.
## Port of pumpkin/src/command/commands/effect.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/effect as effectgen

type
  TimeMode = enum
    timeBase
    timeSpecified
    timeInfinite

  AmplifierMode = enum
    ampBase
    ampSpecified

const
  Names = ["effect"]
  Description = "Adds or removes the status effects of players and other entities."
  ArgClear = "clear"
  ArgGive = "give"
  ArgEffect = "effect"
  ArgTarget = "target"
  ArgSecond = "seconds"
  ArgInfinite = "infinite"
  ArgAmplifier = "amplifier"
  ArgHideParticle = "hideParticles"

proc translationOf(name: string): TextComponent =
  let e = fromName(StatusEffect, name)
  if e.isSome: tc(e.unsafeGet.translationKey) else: text(name)

proc giveExecutor(time: TimeMode; amplifierMode: AmplifierMode; hideDefault: bool): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var targets: seq[CommandPlayer] = @[]
    if not findPlayers(args, ArgTarget, targets):
      return missing(ArgTarget)
    var effect = ""
    if not findString(args, ArgEffect, akEffect, effect):
      return missing(ArgEffect)
    var second = -1'i32
    case time
    of timeBase:
      second = 30'i32 * 20'i32
    of timeSpecified:
      var v = 0'i32
      let r = requireI32(args, ArgSecond, v)
      if not r.isOk:
        return r
      second = v * 20'i32
    of timeInfinite:
      second = -1'i32
    var amplifier = 0'u8
    if amplifierMode == ampSpecified:
      var v = 0'i32
      let r = requireI32(args, ArgAmplifier, v)
      if not r.isOk:
        return r
      amplifier = uint8(v)
    var hideParticles = hideDefault
    if not hideParticles:
      var h = false
      if not findBool(args, ArgHideParticle, h):
        return missing(ArgHideParticle)
      hideParticles = h
    var successes = 0'i32
    for target in targets:
      let current = if target.getEffectAmplifier != nil: target.getEffectAmplifier(effect) else: -1'i32
      if current < 0'i32 or current < int32(amplifier):
        if target.addEffect != nil:
          target.addEffect(effect, second, amplifier, not hideParticles)
        inc successes
    let translationName = translationOf(effect)
    if successes == 0'i32:
      return cmdFailed(tc("commands.effect.give.failed"))
    if targets.len == 1:
      sendMessage(sender, tc("commands.effect.give.success.single", [translationName, shown(targets[0])]))
    else:
      sendMessage(sender, tc("commands.effect.give.success.multiple", [translationName, text($targets.len)]))
    cmdSuccess(successes)

proc clearExecutor(everything: bool): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var targets: seq[CommandPlayer] = @[]
    if not findPlayers(args, ArgTarget, targets):
      return missing(ArgTarget)
    var succeeded = 0'i32
    if everything:
      for target in targets:
        if target.removeAllEffects != nil and target.removeAllEffects():
          inc succeeded
      if succeeded == 0'i32:
        return cmdFailed(tc("commands.effect.clear.everything.failed"))
      if targets.len == 1:
        sendMessage(sender, tc("commands.effect.clear.everything.success.single", [shown(targets[0])]))
      else:
        sendMessage(sender, tc("commands.effect.clear.everything.success.multiple", [text($targets.len)]))
      return cmdSuccess(succeeded)
    var effect = ""
    if not findString(args, ArgEffect, akEffect, effect):
      return missing(ArgEffect)
    for target in targets:
      if target.getEffectAmplifier != nil and target.getEffectAmplifier(effect) >= 0'i32:
        if target.removeEffect != nil:
          target.removeEffect(effect)
        inc succeeded
    if succeeded == 0'i32:
      return cmdFailed(tc("commands.effect.clear.specific.failed"))
    if targets.len == 1:
      sendMessage(sender, tc("commands.effect.clear.specific.success.single", [translationOf(effect), shown(targets[0])]))
    else:
      sendMessage(sender, tc("commands.effect.clear.specific.success.multiple", [translationOf(effect), text($targets.len)]))
    cmdSuccess(succeeded)

proc secondsConsumer(): ArgumentConsumer = newBoundedI32("seconds", some(0'i32), some(1000000'i32))
proc amplifierConsumer(): ArgumentConsumer = newBoundedI32("amplifier", some(1'i32), some(255'i32))

proc initCommandTree*(): CommandTree =
  let clearN = then(literal(ArgClear), then(execute(argument(ArgTarget, newPlayersArgumentConsumer()), clearExecutor(true)),
    execute(argument(ArgEffect, newEffectTypeArgumentConsumer()), clearExecutor(false))))
  let secondsN = then(execute(argument(ArgSecond, secondsConsumer()), giveExecutor(timeSpecified, ampBase, true)),
    then(execute(argument(ArgAmplifier, amplifierConsumer()), giveExecutor(timeSpecified, ampSpecified, true)),
      execute(argument(ArgHideParticle, newBoolArgConsumer()), giveExecutor(timeSpecified, ampSpecified, false))))
  let infiniteN = then(execute(literal(ArgInfinite), giveExecutor(timeInfinite, ampBase, true)),
    then(execute(argument(ArgAmplifier, amplifierConsumer()), giveExecutor(timeInfinite, ampSpecified, true)),
      execute(argument(ArgHideParticle, newBoolArgConsumer()), giveExecutor(timeInfinite, ampSpecified, false))))
  let effectN = then(then(execute(argument(ArgEffect, newEffectTypeArgumentConsumer()), giveExecutor(timeBase, ampBase, true)), secondsN), infiniteN)
  let giveN = then(literal(ArgGive), then(argument(ArgTarget, newPlayersArgumentConsumer()), effectN))
  then(then(newCommandTree(Names, Description), clearN), giveN)
