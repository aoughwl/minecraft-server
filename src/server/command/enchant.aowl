## The `/enchant` command.
## Port of pumpkin/src/command/commands/enchant.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/enchantment

const
  Names = ["enchant"]
  Description = "Adds an enchantment to a player's selected item, subject to the same restrictions as an anvil. Also works on any mob or entity holding a weapon/tool/armor in its main hand."
  ArgLevel = "level"

proc levelConsumer(): ArgumentConsumer = newBoundedI32(ArgLevel, some(0'i32), some(int32.high))

proc enchantExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, newEntitiesArgumentConsumer().defaultName, targets):
    return missing("targets")
  var name = ""
  if not findString(args, "enchantment", akEnchantment, name):
    return missing("enchantment")
  let lookup = fromName(Enchantment, name)
  if lookup.isNone:
    return missing("enchantment")
  let enchantment = lookup.unsafeGet
  var level = 1'i32
  var a = Arg()
  if findNum(args, ArgLevel, a):
    if not a.numInBounds:
      if a.numOverflowLow:
        return cmdFailed(tc("argument.integer.low", [text($a.numBound), text($a.num)]))
      return cmdFailed(tc("argument.integer.big", [text($a.numBound), text($a.num)]))
    level = a.num.i32
  if level > enchantment.maxLevel:
    return cmdFailed(tc2(JAVA_COMMANDS_ENCHANT_FAILED_LEVEL, BEDROCK_COMMANDS_ENCHANT_INVALIDLEVEL, [text($level), text($enchantment.maxLevel)]))
  let onlyOne = targets.len == 1
  var success = 0'i32
  for target in targets:
    let player = target.player
    if player == nil:
      continue
    let held = if closureSet(player.getHeldStack): player.getHeldStack() else: CmdItemStack()
    if held.itemKey.len == 0:
      if onlyOne:
        return cmdFailed(tc2(JAVA_COMMANDS_ENCHANT_FAILED_ITEMLESS, BEDROCK_COMMANDS_ENCHANT_NOITEM, [shown(targets[0])]))
      continue
    let itemName = tc("item.minecraft." & held.itemKey)
    if not closureSet(player.heldItemCanHold) or not player.heldItemCanHold(name):
      if onlyOne:
        return cmdFailed(tc2(JAVA_COMMANDS_ENCHANT_FAILED_INCOMPATIBLE, BEDROCK_COMMANDS_ENCHANT_CANTENCHANT, [itemName]))
      continue
    if not closureSet(player.heldItemAccepts) or player.heldItemAccepts(name):
      if closureSet(player.enchantHeld):
        player.enchantHeld(name, level)
      inc success
    elif onlyOne:
      return cmdFailed(tc2(JAVA_COMMANDS_ENCHANT_FAILED_INCOMPATIBLE, BEDROCK_COMMANDS_ENCHANT_CANTENCHANT, [itemName]))
  if success == 0'i32:
    return cmdFailed(tc2(JAVA_COMMANDS_ENCHANT_FAILED, BEDROCK_COMMANDS_ENCHANT_CANTENCHANT, [text("")]))
  let full = getFullname(enchantment, level, false)
  if onlyOne:
    sendMessage(sender, tc2(JAVA_COMMANDS_ENCHANT_SUCCESS_SINGLE, BEDROCK_COMMANDS_ENCHANT_SUCCESS, [full, shown(targets[0])]))
  else:
    sendMessage(sender, tc2(JAVA_COMMANDS_ENCHANT_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_ENCHANT_SUCCESS, [full, text($targets.len)]))
  cmdSuccess(success)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(argumentDefaultName(newEntitiesArgumentConsumer()),
    execute(then(argumentDefaultName(newEnchantmentArgumentConsumer()), execute(argumentDefaultName(levelConsumer()), enchantExecutor)), enchantExecutor)))
