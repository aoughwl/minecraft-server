## The `/execute` command.
## Port of pumpkin/src/command/commands/execute.rs

import std/[math, options, strutils]
import ../../command/[argument_builder, argument_types, argtype, cmddispatch, cmderrors, cmdsource, cmdtree, coordinates,
  entity_selector]
import ../../generated/blockdata
import ../../protocol/java/client/play/commands
import ../../util/[identifier, permission, vector2, vector3]
import ../../util/math/position
import ../../util/text/[textbase, text]

const
  Description = "Execute a command with a modified context."
  Permission0 = "minecraft:command.execute"

proc invalidDimensionError(): CommandErrorType =
  errorType1("argument.dimension.invalid", "argument.dimension.invalid")

proc dimensionRegistry(): Identifier = vanillaStatic("dimension")

proc one(source: CommandSource): CmdResult[seq[CommandSource]] = cmdOk[seq[CommandSource]](@[source])
proc none0(): CmdResult[seq[CommandSource]] = cmdOk[seq[CommandSource]](@[])

proc entityRotation(e: CommandEntity): Vector2[float32] =
  ## `Vector2::new(entity.yaw.load(), entity.pitch.load())`, as upstream's `/execute` builds it: yaw first.
  let r = e.getRotation()
  Vector2[float32](x: r.y, y: r.x)

proc entityWorldOr(e: CommandEntity; fallback: nil CommandWorld): nil CommandWorld =
  if e.getWorld != nil:
    return e.getWorld()
  fallback

proc asModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  for target in targets.value:
    let source = clone(context.source)
    source.entity = target
    source.name = getText(target.getName())
    source.displayName = target.getDisplayName()
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc atModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  for target in targets.value:
    let source = clone(context.source)
    source.position = target.getPos()
    source.rotation = entityRotation(target)
    source.world = entityWorldOr(target, source.world)
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc inModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let dimensionName = $key.value
  let server = context.source.server
  if server != nil and server.getWorlds != nil:
    let worlds = server.getWorlds()
    for w in worlds:
      if w.dimensionName == dimensionName:
        let source = clone(context.source)
        source.world = w
        return one(source)
  cmdFail[seq[CommandSource]](createWithoutContext(invalidDimensionError(), text(dimensionName)))

proc positionedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let pos = getVector3(context, "pos")
  if not pos.isOk:
    return cmdFail[seq[CommandSource]](pos.error)
  let source = clone(context.source)
  source.position = pos.value
  one(source)

proc positionedAsModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  for target in targets.value:
    let source = clone(context.source)
    source.position = target.getPos()
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc rotatedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let coords = getCoordinates(context, "rotation")
  if not coords.isOk:
    return cmdFail[seq[CommandSource]](coords.error)
  let source = clone(context.source)
  source.rotation = rotation(coords.value, context.source)
  one(source)

proc rotatedAsModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  for target in targets.value:
    let source = clone(context.source)
    source.rotation = entityRotation(target)
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc ifEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  if targets.value.len == 0: none0() else: one(context.source)

proc unlessEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  if targets.value.len == 0: one(context.source) else: none0()

proc alignModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let axes = getString(context, "axes")
  if not axes.isOk:
    return cmdFail[seq[CommandSource]](axes.error)
  let source = clone(context.source)
  var p = source.position
  if axes.value.contains('x'):
    p.x = floor(p.x)
  if axes.value.contains('y'):
    p.y = floor(p.y)
  if axes.value.contains('z'):
    p.z = floor(p.z)
  source.position = p
  one(source)

proc anchoredModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let anchor = getEntityAnchor(context, "anchor")
  if not anchor.isOk:
    return cmdFail[seq[CommandSource]](anchor.error)
  let source = clone(context.source)
  source.entityAnchor = anchor.value
  one(source)

proc rotationFacing(source: CommandSource; target: Vector3[float64]): Vector2[float32] =
  let dx = target.x - source.position.x
  let dy = target.y - source.position.y
  let dz = target.z - source.position.z
  let xzDist = sqrt(dx * dx + dz * dz)
  let yaw = float32(radToDeg(arctan2(dz, dx))) - 90.0'f32
  let pitch = -float32(radToDeg(arctan2(dy, xzDist)))
  Vector2[float32](x: yaw, y: pitch)

proc facingModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let pos = getVector3(context, "pos")
  if not pos.isOk:
    return cmdFail[seq[CommandSource]](pos.error)
  let source = clone(context.source)
  source.rotation = rotationFacing(source, pos.value)
  one(source)

proc facingEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  let anchor = getEntityAnchor(context, "anchor")
  if not anchor.isOk:
    return cmdFail[seq[CommandSource]](anchor.error)
  var sources: seq[CommandSource] = @[]
  for target in targets.value:
    let source = clone(context.source)
    source.rotation = rotationFacing(source, positionAtEntity(anchor.value, target))
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc blockMatches(context: CommandContext; res: var bool; hasWorld: var bool): CmdResult[int32] =
  let pos = getBlockPos(context, "pos")
  if not pos.isOk:
    return cmdFail[int32](pos.error)
  let expected = getBlockArg(context, "block")
  if not expected.isOk:
    return cmdFail[int32](expected.error)
  let world = context.source.world
  hasWorld = world != nil
  res = false
  if world != nil and world.getBlockId != nil:
    res = world.getBlockId(pos.value.vec.x, pos.value.vec.y, pos.value.vec.z) == expected.value.id
  cmdOk[int32](0'i32)

proc ifBlockModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var same = false
  var hasWorld = false
  let r = blockMatches(context, same, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if same: one(context.source) else: none0()

proc unlessBlockModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var same = false
  var hasWorld = false
  let r = blockMatches(context, same, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if not hasWorld or not same: one(context.source) else: none0()

proc loadedAt(context: CommandContext; res: var bool; hasWorld: var bool): CmdResult[int32] =
  let pos = getBlockPos(context, "pos")
  if not pos.isOk:
    return cmdFail[int32](pos.error)
  let world = context.source.world
  hasWorld = world != nil
  res = false
  if world != nil and world.isChunkLoaded != nil:
    res = world.isChunkLoaded(pos.value.vec.x shr 4, pos.value.vec.z shr 4)
  cmdOk[int32](0'i32)

proc ifLoadedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var loaded = false
  var hasWorld = false
  let r = loadedAt(context, loaded, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if loaded: one(context.source) else: none0()

proc unlessLoadedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var loaded = false
  var hasWorld = false
  let r = loadedAt(context, loaded, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if not hasWorld or not loaded: one(context.source) else: none0()

proc ifDimensionModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let world = context.source.world
  if world != nil and world.dimensionName == $key.value: one(context.source) else: none0()

proc unlessDimensionModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let world = context.source.world
  if world == nil or world.dimensionName != $key.value: one(context.source) else: none0()

proc setRedirectsToExecute(tree: Tree; parent: NodeId; executeId: NodeId) =
  ## `set_redirects_to_execute`: every `Redirection::Root` under the node goes back to it.
  let children = getChildren(tree, parent)
  for child in children:
    if tree.nodes[child - 1].hasRedirect and tree.nodes[child - 1].redirect.kind == rdRoot:
      tree.nodes[child - 1].redirect = redirectLocal(executeId)
    setRedirectsToExecute(tree, child, executeId)

proc entitiesArg(): ArgumentBuilder = argument("targets", newEntityArgumentType(eakEntities))

proc forkTo(b: ArgumentBuilder; f: RedirectModifierExecutor): ArgumentBuilder =
  fork(b, redirectRoot(), customModifier(f))

proc redirectTo(b: ArgumentBuilder; f: RedirectModifierExecutor): ArgumentBuilder =
  redirectWithModifier(b, redirectRoot(), customModifier(f))

proc dimensionArg(): ArgumentBuilder = argument("dimension", newResourceKeyArgument(dimensionRegistry()))

proc condition(name: string; entityF, blockF, loadedF, dimensionF: RedirectModifierExecutor): ArgumentBuilder =
  var b = literal(name)
  b = then(b, then(literal("entity"), redirectTo(entitiesArg(), entityF)))
  b = then(b, then(literal("block"), then(argument("pos", newBlockPosArgumentType()),
    redirectTo(argument("block", newBlockArgumentType()), blockF))))
  b = then(b, then(literal("loaded"), redirectTo(argument("pos", newBlockPosArgumentType()), loadedF)))
  then(b, then(literal("dimension"), redirectTo(dimensionArg(), dimensionF)))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let runExecutor: CommandExecutor = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let commandStr = getString(context, "command")
    if not commandStr.isOk:
      return cmdFail[int32](commandStr.error)
    executeInput(dispatcher, commandStr.value, context.source)
  var b = requires(command("execute", Description), Permission0)
  b = then(b, then(literal("run"), executes(argument("command", newStringArgumentType(spGreedyPhrase)), runExecutor)))
  b = then(b, then(literal("as"), forkTo(entitiesArg(), asModifier)))
  b = then(b, then(literal("at"), forkTo(entitiesArg(), atModifier)))
  b = then(b, then(literal("in"), redirectTo(dimensionArg(), inModifier)))
  b = then(b, then(then(literal("positioned"), then(literal("as"), forkTo(entitiesArg(), positionedAsModifier))),
    redirectTo(argument("pos", newVec3ArgumentType()), positionedModifier)))
  b = then(b, then(then(literal("rotated"), then(literal("as"), forkTo(entitiesArg(), rotatedAsModifier))),
    redirectTo(argument("rotation", newRotationArgumentType()), rotatedModifier)))
  b = then(b, then(literal("align"), redirectTo(argument("axes", newStringArgumentType(spSingleWord)), alignModifier)))
  b = then(b, then(literal("anchored"), redirectTo(argument("anchor", newEntityAnchorArgumentType()), anchoredModifier)))
  b = then(b, then(then(literal("facing"), then(literal("entity"), then(entitiesArg(),
      forkTo(argument("anchor", newEntityAnchorArgumentType()), facingEntityModifier)))),
    redirectTo(argument("pos", newVec3ArgumentType()), facingModifier)))
  b = then(b, condition("if", ifEntityModifier, ifBlockModifier, ifLoadedModifier, ifDimensionModifier))
  b = then(b, condition("unless", unlessEntityModifier, unlessBlockModifier, unlessLoadedModifier, unlessDimensionModifier))
  let executeNode = register(dispatcher, b)
  setRedirectsToExecute(dispatcher.tree, executeNode, executeNode)
