## The `/execute` command.
## Port of pumpkin/src/command/commands/execute.rs
## `if|unless biome` (not in upstream) takes a biome or a `#tag` (`BiomeOrTagValue`). DEVIATION from upstream: `run` hands commands the new dispatcher lacks to the fallback dispatcher with this source's world, position and entity in force.

import ../../util/closureset
import std/[math, options, strutils]
import ../../command/[argument_builder, argument_types, argtype, cmddispatch, cmderrors, cmdsource, cmdtree, coordinates,
  entity_selector]
from ../../command/fallbackdispatch import dispatch, intoMessages, CommandResult, CommandError, ceSyntaxError
import ../../util/math/bounds
import ../../generated/[biome, blockdata, tag, translation]
import ../../command/string_reader
import ../../nbt/tag
import ../../command/nbt_path
from data import TargetKind, tkEntity, tkBlock, tkStorage, DataAccessor, accessTarget, getData, setData
import ../../protocol/java/client/play/commands
import ../../util/[identifier, permission, vector2, vector3]
import ../../util/math/position
import ../../util/text/[textbase, text]

const
  Description = "Execute a command with a modified context."
  Permission0 = "minecraft:command.execute"

proc unknownBossbarError(): CommandErrorType =
  errorType1(JAVA_COMMANDS_BOSSBAR_UNKNOWN, JAVA_COMMANDS_BOSSBAR_UNKNOWN)

proc invalidDimensionError(): CommandErrorType =
  errorType1("argument.dimension.invalid", "argument.dimension.invalid")

proc dimensionRegistry(): Identifier = vanillaStatic("dimension")

proc one(source: CommandSource): CmdResult[seq[CommandSource]] = cmdOk[seq[CommandSource]](@[source])
proc none0(): CmdResult[seq[CommandSource]] = cmdOk[seq[CommandSource]](@[])

proc entityRotation(e: CommandEntity): Vector2[float32] =
  ## `Vector2::new(entity.yaw.load(), entity.pitch.load())`, as upstream's `/execute` builds it: yaw first.
  let r = e.getRotation()
  Vector2[float32](x: r.y, y: r.x)

proc entityWorldOr(e: CommandEntity; fallback: nil CommandWorld): nil CommandWorld =
  if closureSet(e.getWorld):
    return e.getWorld()
  fallback

proc asModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  let seq1Src = targets.value
  for idx1 in 0 ..< seq1Src.len:
    let target = seq1Src[idx1]
    let source = clone(context.source)
    source.entity = target
    source.name = getText(target.getName())
    source.displayName = target.getDisplayName()
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc atModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  let seq2Src = targets.value
  for idx2 in 0 ..< seq2Src.len:
    let target = seq2Src[idx2]
    let source = clone(context.source)
    source.position = target.getPos()
    source.rotation = entityRotation(target)
    source.world = entityWorldOr(target, source.world)
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc inModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let dimensionName = $key.value
  let server = context.source.server
  if server != nil and closureSet(server.getWorlds):
    let worlds = server.getWorlds()
    let seq3Src = worlds
    for idx3 in 0 ..< seq3Src.len:
      let w = seq3Src[idx3]
      if w.dimensionName == dimensionName:
        let source = clone(context.source)
        source.world = w
        return one(source)
  cmdFail[seq[CommandSource]](createWithoutContext(invalidDimensionError(), text(dimensionName)))

proc positionedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let pos = getVector3(context, "pos")
  if not pos.isOk:
    return cmdFail[seq[CommandSource]](pos.error)
  let source = clone(context.source)
  source.position = pos.value
  one(source)

proc positionedAsModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  let seq4Src = targets.value
  for idx4 in 0 ..< seq4Src.len:
    let target = seq4Src[idx4]
    let source = clone(context.source)
    source.position = target.getPos()
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc rotatedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let coords = getCoordinates(context, "rotation")
  if not coords.isOk:
    return cmdFail[seq[CommandSource]](coords.error)
  let source = clone(context.source)
  source.rotation = rotation(coords.value, context.source)
  one(source)

proc rotatedAsModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  var sources: seq[CommandSource] = @[]
  let seq5Src = targets.value
  for idx5 in 0 ..< seq5Src.len:
    let target = seq5Src[idx5]
    let source = clone(context.source)
    source.rotation = entityRotation(target)
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc ifEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  if targets.value.len == 0: none0() else: one(context.source)

proc unlessEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  if targets.value.len == 0: one(context.source) else: none0()

proc alignModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let axes = getString(context, "axes")
  if not axes.isOk:
    return cmdFail[seq[CommandSource]](axes.error)
  let source = clone(context.source)
  var p = source.position
  if axes.value.contains('x'):
    p.x = floor(p.x)
  if axes.value.contains('y'):
    p.y = floor(p.y)
  if axes.value.contains('z'):
    p.z = floor(p.z)
  source.position = p
  one(source)

proc anchoredModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let anchor = getEntityAnchor(context, "anchor")
  if not anchor.isOk:
    return cmdFail[seq[CommandSource]](anchor.error)
  let source = clone(context.source)
  source.entityAnchor = anchor.value
  one(source)

proc rotationFacing(source: CommandSource; target: Vector3[float64]): Vector2[float32] =
  let dx = target.x - source.position.x
  let dy = target.y - source.position.y
  let dz = target.z - source.position.z
  let xzDist = sqrt(dx * dx + dz * dz)
  let yaw = float32(radToDeg(arctan2(dz, dx))) - 90.0'f32
  let pitch = -float32(radToDeg(arctan2(dy, xzDist)))
  Vector2[float32](x: yaw, y: pitch)

proc facingModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let pos = getVector3(context, "pos")
  if not pos.isOk:
    return cmdFail[seq[CommandSource]](pos.error)
  let source = clone(context.source)
  source.rotation = rotationFacing(source, pos.value)
  one(source)

proc facingEntityModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  let anchor = getEntityAnchor(context, "anchor")
  if not anchor.isOk:
    return cmdFail[seq[CommandSource]](anchor.error)
  var sources: seq[CommandSource] = @[]
  let seq6Src = targets.value
  for idx6 in 0 ..< seq6Src.len:
    let target = seq6Src[idx6]
    let source = clone(context.source)
    source.rotation = rotationFacing(source, positionAtEntity(anchor.value, target))
    sources.add(source)
  cmdOk[seq[CommandSource]](sources)

proc blockMatches(context: CommandContext; res: var bool; hasWorld: var bool): CmdResult[int32] =
  let pos = getBlockPos(context, "pos")
  if not pos.isOk:
    return cmdFail[int32](pos.error)
  let expected = getBlockArg(context, "block")
  if not expected.isOk:
    return cmdFail[int32](expected.error)
  let world = context.source.world
  hasWorld = world != nil
  res = false
  if world != nil and closureSet(world.getBlockId):
    res = world.getBlockId(pos.value.vec.x, pos.value.vec.y, pos.value.vec.z) == expected.value.id
  cmdOk[int32](0'i32)

proc ifBlockModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var same = false
  var hasWorld = false
  let r = blockMatches(context, same, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if same: one(context.source) else: none0()

proc unlessBlockModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var same = false
  var hasWorld = false
  let r = blockMatches(context, same, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if not hasWorld or not same: one(context.source) else: none0()

proc loadedAt(context: CommandContext; res: var bool; hasWorld: var bool): CmdResult[int32] =
  let pos = getBlockPos(context, "pos")
  if not pos.isOk:
    return cmdFail[int32](pos.error)
  let world = context.source.world
  hasWorld = world != nil
  res = false
  if world != nil and closureSet(world.isChunkLoaded):
    res = world.isChunkLoaded(pos.value.vec.x shr 4, pos.value.vec.z shr 4)
  cmdOk[int32](0'i32)

proc ifLoadedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var loaded = false
  var hasWorld = false
  let r = loadedAt(context, loaded, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if loaded: one(context.source) else: none0()

proc unlessLoadedModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var loaded = false
  var hasWorld = false
  let r = loadedAt(context, loaded, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if not hasWorld or not loaded: one(context.source) else: none0()

proc ifDimensionModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let world = context.source.world
  if world != nil and world.dimensionName == $key.value: one(context.source) else: none0()

proc unlessDimensionModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  let key = getRegistryKey(context, "dimension", dimensionRegistry(), invalidDimensionError())
  if not key.isOk:
    return cmdFail[seq[CommandSource]](key.error)
  let world = context.source.world
  if world == nil or world.dimensionName != $key.value: one(context.source) else: none0()

type
  BiomeOrTagValue = ref object of ArgValue
    ## `resource_or_tag` for the biome registry: `#minecraft:is_forest` is a tag, `minecraft:plains` one biome.
    isTag: bool
    identifier: Identifier

proc parseBiomeOrTag(reader: var StringReader): CmdResult[ArgValue] =
  var isTag = false
  if reader.canReadChar() and reader.peekIs('#'):
    reader.skip()
    isTag = true
  let id = identifierFromReader(reader)
  if not id.isOk:
    return cmdFail[ArgValue](id.error)
  let v = BiomeOrTagValue(isTag: isTag, identifier: id.value)
  let a: ArgValue = v
  cmdOk[ArgValue](a)

proc newBiomeOrTagArgument(): AnyArgumentType =
  result = AnyArgumentType(clientParser: JavaClientArgumentType(kind: atResourceOrTag, identifier: biomeRegistry()),
    overrideSuggestion: none[SuggestionProviders](), examples: @[])
  result.parseProc = proc(reader: var StringReader): CmdResult[ArgValue] {.closure.} = parseBiomeOrTag(reader)

proc biomeIndexOf(biomeId: int32): int =
  for i in 0 ..< ALL.len:
    if int32(ALL[i].id) == biomeId:
      return i
  -1

proc biomeKnown(path: string): bool =
  for i in 0 ..< ALL.len:
    if ALL[i].registryId == path:
      return true
  false

proc biomeMatches(v: BiomeOrTagValue; biomeId: int32): CmdResult[bool] =
  ## A tag holds the biomes its file lists; an unknown tag or biome is the same error `/fillbiome` gives for a bad biome.
  let at = biomeIndexOf(biomeId)
  if v.isTag:
    if at < 0:
      return cmdOk[bool](false)
    let tagged = ALL[at].toTaggable().isTaggedWith($v.identifier)
    if not tagged[0]:
      return cmdFail[bool](createWithoutContext(invalidBiomeError(), text("#" & $v.identifier)))
    return cmdOk[bool](tagged[1])
  if not biomeKnown(v.identifier.path):
    return cmdFail[bool](createWithoutContext(invalidBiomeError(), text($v.identifier)))
  cmdOk[bool](at >= 0 and ALL[at].registryId == v.identifier.path)

proc biomeAtMatches(context: CommandContext; matches: var bool; hasWorld: var bool): CmdResult[int32] =
  let pos = getBlockPos(context, "pos")
  if not pos.isOk:
    return cmdFail[int32](pos.error)
  var seen = false
  let raw = argumentOf(context, "biome", seen)
  if not seen:
    return cmdFail[int32](missingArgument("biome"))
  if not (raw of BiomeOrTagValue):
    return cmdFail[int32](wrongArgumentType("biome"))
  let expected = BiomeOrTagValue(raw)
  let world = context.source.world
  hasWorld = world != nil
  if world != nil and closureSet(world.getBiomeAt):
    let m = biomeMatches(expected, world.getBiomeAt(pos.value.vec.x, pos.value.vec.y, pos.value.vec.z))
    if not m.isOk:
      return cmdFail[int32](m.error)
    matches = m.value
  cmdOk[int32](0'i32)

proc ifBiomeModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var matches = false
  var hasWorld = false
  let r = biomeAtMatches(context, matches, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if matches: one(context.source) else: none0()

proc unlessBiomeModifier(context: CommandContext): CmdResult[seq[CommandSource]] =
  var matches = false
  var hasWorld = false
  let r = biomeAtMatches(context, matches, hasWorld)
  if not r.isOk:
    return cmdFail[seq[CommandSource]](r.error)
  if not hasWorld or not matches: one(context.source) else: none0()

proc holderName(e: CommandEntity): string =
  ## Scoreboard key: a player's name, anything else's UUID.
  if e.entityTypeName == "player": getText(e.getName()) else: $e.uuid

proc scoreOf(world: nil CommandWorld; holder, objective: string; value: var int32): bool =
  var entry = CmdScore()
  if world == nil:
    return false
  if not closureSet(world.getScoreEntry):
    return false
  if world.getScoreEntry(holder, objective, entry):
    value = entry.value
    return true
  false

proc scoreCompare(op: string; a, b: int32): bool =
  case op
  of "<": a < b
  of "<=": a <= b
  of "=": a == b
  of ">=": a >= b
  of ">": a > b
  else: false

proc scoreCondition(context: CommandContext; matchesMode: bool; negate: bool; fixedOp: string): CmdResult[seq[CommandSource]] =
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  let objective = getString(context, "targetObjective")
  if not objective.isOk:
    return cmdFail[seq[CommandSource]](objective.error)
  let world = context.source.world
  var ok = true
  if targets.value.len == 0:
    ok = false
  var a = 0'i32
  if ok:
    ok = scoreOf(world, holderName(targets.value[0]), objective.value, a)
  if ok and matchesMode:
    var found = false
    let v = argumentOf(context, "range", found)
    if not found or not (v of IntBoundsValue):
      ok = false
    else:
      ok = matches(IntBoundsValue(v).value, a)
  elif ok:
    let op = cmdOk[string](fixedOp)
    let sources = getOptionalEntities(context, "source")
    let sobj = getString(context, "sourceObjective")
    if not op.isOk or not sources.isOk or not sobj.isOk or sources.value.len == 0:
      ok = false
    else:
      var b = 0'i32
      if scoreOf(world, holderName(sources.value[0]), sobj.value, b):
        ok = scoreCompare(op.value, a, b)
      else:
        ok = false
  if ok != negate: one(context.source) else: none0()

proc ifScoreMatches(context: CommandContext): CmdResult[seq[CommandSource]] = scoreCondition(context, true, false, "")
proc unlessScoreMatches(context: CommandContext): CmdResult[seq[CommandSource]] = scoreCondition(context, true, true, "")

proc scoreCompareFor(op: string; negate: bool): RedirectModifierExecutor =
  result = proc(context: CommandContext): CmdResult[seq[CommandSource]] {.closure.} =
    scoreCondition(context, false, negate, op)

proc blocksCondition(context: CommandContext; negate, maskedOnly: bool): CmdResult[seq[CommandSource]] =
  ## `if blocks <start> <end> <destination> (all|masked)`: both boxes must hold the same states.
  let a = getBlockPos(context, "start")
  let b = getBlockPos(context, "end")
  let d = getBlockPos(context, "destination")
  if not a.isOk: return cmdFail[seq[CommandSource]](a.error)
  if not b.isOk: return cmdFail[seq[CommandSource]](b.error)
  if not d.isOk: return cmdFail[seq[CommandSource]](d.error)
  let world = context.source.world
  if world == nil:
    return (if negate: one(context.source) else: none0())
  if not closureSet(world.getBlockStateId):
    return (if negate: one(context.source) else: none0())
  var same = true
  block compare:
    let lox = min(a.value.vec.x, b.value.vec.x)
    let loy = min(a.value.vec.y, b.value.vec.y)
    let loz = min(a.value.vec.z, b.value.vec.z)
    let hix = max(a.value.vec.x, b.value.vec.x)
    let hiy = max(a.value.vec.y, b.value.vec.y)
    let hiz = max(a.value.vec.z, b.value.vec.z)
    let count = int64(hix - lox + 1'i32) * int64(hiy - loy + 1'i32) * int64(hiz - loz + 1'i32)
    if count > 32768'i64:
      return cmdFail[seq[CommandSource]](createWithoutContext(literalErrorType("That area is too large (max 32768)")))
    for x in lox .. hix:
      for y in loy .. hiy:
        for z in loz .. hiz:
          let sid = world.getBlockStateId(x, y, z)
          let did = world.getBlockStateId(d.value.vec.x + (x - lox), d.value.vec.y + (y - loy), d.value.vec.z + (z - loz))
          if maskedOnly and closureSet(world.isAirState) and world.isAirState(sid):
            continue
          if sid != did:
            same = false
  if same != negate: one(context.source) else: none0()

proc ifBlocksModifier(context: CommandContext): CmdResult[seq[CommandSource]] = blocksCondition(context, false, false)
proc unlessBlocksModifier(context: CommandContext): CmdResult[seq[CommandSource]] = blocksCondition(context, true, false)
proc ifBlocksMasked(context: CommandContext): CmdResult[seq[CommandSource]] = blocksCondition(context, false, true)
proc unlessBlocksMasked(context: CommandContext): CmdResult[seq[CommandSource]] = blocksCondition(context, true, true)

proc storeScore(context: CommandContext; storeResult: bool): CmdResult[seq[CommandSource]] =
  ## `store result|success score <targets> <objective>`: the finished command's value goes into the scores.
  let targets = getOptionalEntities(context, "targets")
  if not targets.isOk:
    return cmdFail[seq[CommandSource]](targets.error)
  let objective = getString(context, "objective")
  if not objective.isOk:
    return cmdFail[seq[CommandSource]](objective.error)
  let world = context.source.world
  var holders: seq[string] = @[]
  let seq7Src = targets.value
  for idx7 in 0 ..< seq7Src.len:
    let t = seq7Src[idx7]
    holders.add(holderName(t))
  let obj = objective.value
  let cb: ReturnValueCallback = proc(value: ReturnValue) {.closure.} =
    if world != nil and closureSet(world.setScoreEntry):
      let v = if storeResult: resultValue(value) else: (if successValue(value): 1'i32 else: 0'i32)
      let seq8Src = holders
      for idx8 in 0 ..< seq8Src.len:
        let h = seq8Src[idx8]
        world.setScoreEntry(h, obj, v, false)
  one(mergeCommandResultTaker(context.source, ResultValueTaker(callbacks: @[cb])))

proc storeResultScore(context: CommandContext): CmdResult[seq[CommandSource]] = storeScore(context, true)
proc storeSuccessScore(context: CommandContext): CmdResult[seq[CommandSource]] = storeScore(context, false)

proc runFallback(dispatcher: CommandDispatcher; source: CommandSource; line: string): CmdResult[int32] =
  ## DEVIATION from upstream: commands that still live in the fallback dispatcher run here with this source in force.
  let previous = gSourceOverride
  gSourceOverride = source
  let res = dispatch(dispatcher.fallbackDispatcher, source.output, source.server, line)
  gSourceOverride = previous
  if res.isOk:
    return cmdOk[int32](res.value)
  if res.error.kind == ceSyntaxError and not res.error.syntax.isType(dispatcherUnknownCommand()):
    return cmdFail[int32](res.error.syntax)
  var msg = ""
  let seq9Src = intoMessages(res.error, line)
  for idx9 in 0 ..< seq9Src.len:
    let t = seq9Src[idx9]
    msg.add(getText(t))
  let shown = if res.error.kind == ceSyntaxError: "Unknown or incomplete command" else: msg
  cmdFail[int32](createWithoutContext(literalErrorType(shown)))

proc setRedirectsToExecute(tree: Tree; parent: NodeId; executeId: NodeId) =
  ## `set_redirects_to_execute`: every `Redirection::Root` under the node goes back to it.
  let children = getChildren(tree, parent)
  let seq10Src = children
  for idx10 in 0 ..< seq10Src.len:
    let child = seq10Src[idx10]
    if tree.nodes[child - 1].hasRedirect and tree.nodes[child - 1].redirect.kind == rdRoot:
      tree.nodes[child - 1].redirect = redirectLocal(executeId)
    setRedirectsToExecute(tree, child, executeId)

proc entitiesArg(): ArgumentBuilder = argument("targets", newEntityArgumentType(eakEntities))

proc forkTo(b: ArgumentBuilder; f: RedirectModifierExecutor): ArgumentBuilder =
  fork(b, redirectRoot(), customModifier(f))

proc redirectTo(b: ArgumentBuilder; f: RedirectModifierExecutor): ArgumentBuilder =
  redirectWithModifier(b, redirectRoot(), customModifier(f))


# ---- `if|unless data` and `store ... bossbar|entity|block|storage` -------------------------------------------------

proc dataMatches(context: CommandContext; kind: TargetKind; matches: var bool): CmdVoidResult =
  ## `check_matching_data`: whether the path finds anything in the target's data.
  let acc = accessTarget(context, kind, "target")
  if not acc.isOk:
    return cmdFailVoid(acc.error)
  let path = getNbtPath(context, "path")
  if not path.isOk:
    return cmdFailVoid(path.error)
  let data = getData(acc.value)
  if not data.isOk:
    return cmdFailVoid(data.error)
  matches = countMatching(path.value, NbtTag(kind: ntkCompound, compoundVal: data.value)) > 0
  cmdOkVoid()

proc dataCondition(kind: TargetKind; negate: bool): RedirectModifierExecutor =
  result = proc(context: CommandContext): CmdResult[seq[CommandSource]] {.closure.} =
    var matched = false
    let r = dataMatches(context, kind, matched)
    if not r.isOk:
      return cmdFail[seq[CommandSource]](r.error)
    if matched != negate: one(context.source) else: none0()

proc saturateI32(d: float64): int32 =
  ## Java's `(int) d`.
  if d != d: return 0'i32
  if d >= 2147483647.0: return int32.high
  if d <= -2147483648.0: return int32.low
  int32(d)

proc saturateI64(d: float64): int64 =
  ## Java's `(long) d`.
  if d != d: return 0'i64
  if d >= 9223372036854775807.0: return int64.high
  if d <= -9223372036854775808.0: return int64.low
  int64(d)

proc storeTag(typeName: string; value: int32; scale: float64): NbtTag =
  ## The `NumericType` of `store ... <type> <scale>`: `(T)(int)(value * scale)`; float and double keep the fraction.
  let d = float64(value) * scale
  case typeName
  of "byte": NbtTag(kind: ntkByte, byteVal: cast[int8](saturateI32(d) and 0xFF'i32))
  of "short": NbtTag(kind: ntkShort, shortVal: cast[int16](saturateI32(d) and 0xFFFF'i32))
  of "long": NbtTag(kind: ntkLong, longVal: saturateI64(d))
  of "float": NbtTag(kind: ntkFloat, floatVal: float32(d))
  of "double": NbtTag(kind: ntkDouble, doubleVal: d)
  else: NbtTag(kind: ntkInt, intVal: saturateI32(d))

proc writeStore(acc: DataAccessor; path: NbtPath; tag: NbtTag) =
  ## One target of a data store: `path.set` into its data, then back. A player's data is left alone, as vanilla does.
  if acc.kind == tkEntity and acc.entity.player != nil:
    return
  let data = getData(acc)
  if not data.isOk:
    return
  var root = NbtTag(kind: ntkCompound, compoundVal: data.value)
  let r = path.set(root, tag)
  if not r.isOk or root.kind != ntkCompound:
    return
  discard setData(acc, root.compoundVal)

proc makeStoreDataCallback(targets: seq[DataAccessor]; p: NbtPath; s: float64; storeResult: bool;
    typeName: string): ReturnValueCallback =
  ## A closure made inside another closure trips hexer, so the executors make their callbacks here.
  result = proc(value: ReturnValue) {.closure.} =
    let v = if storeResult: resultValue(value) else: (if successValue(value): 1'i32 else: 0'i32)
    for i in 0 ..< targets.len:
      writeStore(targets[i], p, storeTag(typeName, v, s))

proc makeStoreBossbarCallback(server: nil CommandServer; location: string; storeResult, isMax: bool): ReturnValueCallback =
  result = proc(value: ReturnValue) {.closure.} =
    let v = if storeResult: resultValue(value) else: (if successValue(value): 1'i32 else: 0'i32)
    var current = CmdBossbar()
    if server == nil:
      return
    let getNow = server.bossbarGet
    if getNow == nil or not getNow(location, current):
      return
    let setNow = server.bossbarSetHealth
    if setNow == nil:
      return
    if isMax:
      if v >= 1'i32:
        discard setNow(location, v, current.value)
    else:
      discard setNow(location, current.max, v)

proc storeData(kind: TargetKind; storeResult: bool; typeName: string): RedirectModifierExecutor =
  result = proc(context: CommandContext): CmdResult[seq[CommandSource]] {.closure.} =
    let path = getNbtPath(context, "path")
    if not path.isOk:
      return cmdFail[seq[CommandSource]](path.error)
    let scale = getDouble(context, "scale")
    if not scale.isOk:
      return cmdFail[seq[CommandSource]](scale.error)
    var targets: seq[DataAccessor] = @[]
    if kind == tkEntity:
      let es = getOptionalEntities(context, "targets")
      if not es.isOk:
        return cmdFail[seq[CommandSource]](es.error)
      let entityList = es.value
      for ei in 0 ..< entityList.len:
        targets.add(DataAccessor(kind: tkEntity, entity: entityList[ei]))
    else:
      let acc = accessTarget(context, kind, "target")
      if not acc.isOk:
        return cmdFail[seq[CommandSource]](acc.error)
      targets.add(acc.value)
    let p = path.value
    let s = scale.value
    let cb = makeStoreDataCallback(targets, p, s, storeResult, typeName)
    one(mergeCommandResultTaker(context.source, ResultValueTaker(callbacks: @[cb])))

proc storeBossbar(storeResult, isMax: bool): RedirectModifierExecutor =
  result = proc(context: CommandContext): CmdResult[seq[CommandSource]] {.closure.} =
    let id = getIdentifier(context, "id")
    if not id.isOk:
      return cmdFail[seq[CommandSource]](id.error)
    let server = context.source.server
    let location = $id.value
    var bar = CmdBossbar()
    if server == nil:
      return cmdFail[seq[CommandSource]](createWithoutContext(unknownBossbarError(), text(location)))
    let getBar = server.bossbarGet
    let setHealth = server.bossbarSetHealth
    if getBar == nil or setHealth == nil or not getBar(location, bar):
      return cmdFail[seq[CommandSource]](createWithoutContext(unknownBossbarError(), text(location)))
    let cb = makeStoreBossbarCallback(server, location, storeResult, isMax)
    one(mergeCommandResultTaker(context.source, ResultValueTaker(callbacks: @[cb])))

const NumericTypes = ["int", "float", "short", "long", "double", "byte"]

proc storeNodes(storeResult: bool): ArgumentBuilder =
  ## One `store result|success`: score, bossbar, entity, block and storage targets.
  var node = literal(if storeResult: "result" else: "success")
  node = then(node, then(literal("score"), then(entitiesArg(),
    redirectTo(argument("objective", newObjectiveArgumentType()), (if storeResult: storeResultScore else: storeSuccessScore)))))
  var barNode = argument("id", newIdentifierArgumentType())
  barNode = then(barNode, redirectTo(literal("value"), storeBossbar(storeResult, false)))
  barNode = then(barNode, redirectTo(literal("max"), storeBossbar(storeResult, true)))
  node = then(node, then(literal("bossbar"), barNode))
  let seq11Src = [tkEntity, tkBlock, tkStorage]
  for idx11 in 0 ..< seq11Src.len:
    let kind = seq11Src[idx11]
    var typeNodes = argument("path", newNbtPathArgumentType())
    let seq12Src = NumericTypes
    for idx12 in 0 ..< seq12Src.len:
      let tn = seq12Src[idx12]
      typeNodes = then(typeNodes, then(literal(tn), redirectTo(argument("scale", newDoubleArgumentType()), storeData(kind, storeResult, tn))))
    case kind
    of tkEntity: node = then(node, then(literal("entity"), then(entitiesArg(), typeNodes)))
    of tkBlock: node = then(node, then(literal("block"), then(argument("target", newBlockPosArgumentType()), typeNodes)))
    of tkStorage: node = then(node, then(literal("storage"), then(argument("target", newIdentifierArgumentType()), typeNodes)))
  node

proc dataConditionNode(negate: bool): ArgumentBuilder =
  ## `data entity|block|storage <target> <path>` under `if` or `unless`.
  var node = literal("data")
  node = then(node, then(literal("entity"), then(argument("target", newEntityArgumentType(eakEntity)),
    redirectTo(argument("path", newNbtPathArgumentType()), dataCondition(tkEntity, negate)))))
  node = then(node, then(literal("block"), then(argument("target", newBlockPosArgumentType()),
    redirectTo(argument("path", newNbtPathArgumentType()), dataCondition(tkBlock, negate)))))
  node = then(node, then(literal("storage"), then(argument("target", newIdentifierArgumentType()),
    redirectTo(argument("path", newNbtPathArgumentType()), dataCondition(tkStorage, negate)))))
  node


proc dimensionArg(): ArgumentBuilder = argument("dimension", newResourceKeyArgument(dimensionRegistry()))

proc condition(name: string; entityF, blockF, loadedF, dimensionF, biomeF, scoreMatchesF, blocksF, blocksMaskedF: RedirectModifierExecutor; negateScore: bool): ArgumentBuilder =
  var b = literal(name)
  b = then(b, then(literal("entity"), redirectTo(entitiesArg(), entityF)))
  b = then(b, then(literal("block"), then(argument("pos", newBlockPosArgumentType()),
    redirectTo(argument("block", newBlockArgumentType()), blockF))))
  b = then(b, then(literal("loaded"), redirectTo(argument("pos", newBlockPosArgumentType()), loadedF)))
  b = then(b, then(literal("dimension"), redirectTo(dimensionArg(), dimensionF)))
  b = then(b, then(literal("biome"), then(argument("pos", newBlockPosArgumentType()),
    redirectTo(argument("biome", newBiomeOrTagArgument()), biomeF))))
  var objNode = argument("targetObjective", newObjectiveArgumentType())
  objNode = then(objNode, then(literal("matches"), redirectTo(argument("range", newIntRangeArgumentType()), scoreMatchesF)))
  let seq13Src = ["<", "<=", "=", ">=", ">"]
  for idx13 in 0 ..< seq13Src.len:
    let op = seq13Src[idx13]
    objNode = then(objNode, then(literal(op), then(argument("source", newEntityArgumentType(eakEntities)),
      redirectTo(argument("sourceObjective", newObjectiveArgumentType()), scoreCompareFor(op, negateScore)))))
  b = then(b, then(literal("score"), then(entitiesArg(), objNode)))
  var dest = argument("destination", newBlockPosArgumentType())
  dest = then(dest, redirectTo(literal("all"), blocksF))
  dest = then(dest, redirectTo(literal("masked"), blocksMaskedF))
  then(b, then(literal("blocks"), then(argument("start", newBlockPosArgumentType()),
    then(argument("end", newBlockPosArgumentType()), dest))))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let runExecutor: CommandExecutor = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let commandStr = getString(context, "command")
    if not commandStr.isOk:
      return cmdFail[int32](commandStr.error)
    # The nested run does not report to the result takers: this node's own result does, once.
    let inner = withCommandResultTaker(context.source, ResultValueTaker(callbacks: @[]))
    let r = executeInput(dispatcher, commandStr.value, inner)
    if r.isOk or not r.error.isType(dispatcherUnknownCommand()):
      return r
    runFallback(dispatcher, inner, commandStr.value)
  var b = requires(command("execute", Description), Permission0)
  b = then(b, then(literal("run"), executes(argument("command", newStringArgumentType(spGreedyPhrase)), runExecutor)))
  b = then(b, then(literal("as"), forkTo(entitiesArg(), asModifier)))
  b = then(b, then(literal("at"), forkTo(entitiesArg(), atModifier)))
  b = then(b, then(literal("in"), redirectTo(dimensionArg(), inModifier)))
  b = then(b, then(then(literal("positioned"), then(literal("as"), forkTo(entitiesArg(), positionedAsModifier))),
    redirectTo(argument("pos", newVec3ArgumentType()), positionedModifier)))
  b = then(b, then(then(literal("rotated"), then(literal("as"), forkTo(entitiesArg(), rotatedAsModifier))),
    redirectTo(argument("rotation", newRotationArgumentType()), rotatedModifier)))
  b = then(b, then(literal("align"), redirectTo(argument("axes", newStringArgumentType(spSingleWord)), alignModifier)))
  b = then(b, then(literal("anchored"), redirectTo(argument("anchor", newEntityAnchorArgumentType()), anchoredModifier)))
  b = then(b, then(then(literal("facing"), then(literal("entity"), then(entitiesArg(),
      forkTo(argument("anchor", newEntityAnchorArgumentType()), facingEntityModifier)))),
    redirectTo(argument("pos", newVec3ArgumentType()), facingModifier)))
  b = then(b, then(condition("if", ifEntityModifier, ifBlockModifier, ifLoadedModifier, ifDimensionModifier, ifBiomeModifier,
    ifScoreMatches, ifBlocksModifier, ifBlocksMasked, false), dataConditionNode(false)))
  b = then(b, then(condition("unless", unlessEntityModifier, unlessBlockModifier, unlessLoadedModifier, unlessDimensionModifier, unlessBiomeModifier,
    unlessScoreMatches, unlessBlocksModifier, unlessBlocksMasked, true), dataConditionNode(true)))
  var storeNode = literal("store")
  storeNode = then(storeNode, storeNodes(true))
  storeNode = then(storeNode, storeNodes(false))
  b = then(b, storeNode)
  let executeNode = register(dispatcher, b)
  setRedirectsToExecute(dispatcher.tree, executeNode, executeNode)
