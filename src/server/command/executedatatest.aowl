## `execute if|unless data` and `execute store ... storage|block|entity|bossbar`, with `/data` as the command that runs.
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree, snbt, string_reader]
import ../../nbt/tag
import ../../util/[permission, uuid]
import ../../util/text/[textbase, text]
import data, execute, cmdtestutil

var failures = 0

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    inc failures

proc compOf(s: string): NbtCompound =
  var r = newStringReader(s)
  let v = parseForCommands(r)
  if v.isOk and v.value.kind == ntkCompound: v.value.compoundVal else: newCompound()

proc main() =
  var storages: seq[(string, NbtCompound)] = @[]
  var blockNbt = compOf("{id:\"minecraft:barrel\",x:1,y:2,z:3,n:0}")
  var barValue = 0'i32
  var barMax = 100'i32
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getBlockEntityNbt = proc(x, y, z: int32; res: var NbtCompound): bool {.closure.} =
    if x == 1'i32 and y == 2'i32 and z == 3'i32:
      res = blockNbt
      return true
    false
  world.setBlockEntityNbt = proc(x, y, z: int32; nbt: NbtCompound): bool {.closure.} =
    if x == 1'i32 and y == 2'i32 and z == 3'i32:
      blockNbt = nbt
      return true
    false
  var pigNbt = compOf("{Health:1.0f,CustomName:\"Pig\"}")
  let pigId = parseUuid("11111111-2222-3333-4444-555555555555")[1]
  let pig = CommandEntity(uuid: pigId, entityTypeId: "minecraft:pig",
    getName: proc(): TextComponent {.closure.} = text("Pig"),
    getDisplayName: proc(): TextComponent {.closure.} = text("Pig"),
    writeNbt: proc(): NbtCompound {.closure.} = pigNbt,
    readNbt: proc(nbt: NbtCompound) {.closure.} = pigNbt = nbt)
  world.getEntityByUuid = proc(id: Uuid): nil CommandEntity {.closure.} =
    if id == pigId:
      return pig
    nil
  let server = newServerWithWorld(world)
  server.getCommandStorage = proc(id: string): NbtCompound {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        return storages[i][1]
    newCompound()
  server.setCommandStorage = proc(id: string; value: NbtCompound) {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        storages[i][1] = value
        return
    storages.add((id, value))
  server.bossbarGet = proc(location: string; res: var CmdBossbar): bool {.closure.} =
    if location != "minecraft:bar":
      return false
    res = CmdBossbar(namespace: location, max: barMax, value: barValue)
    true
  server.bossbarSetHealth = proc(location: string; max, value: int32): CmdBossbarStatus {.closure.} =
    barMax = max
    barValue = value
    CmdBossbarStatus(kind: 0'i32)
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  let registry = newPermissionRegistry()
  execute.register(d, registry)
  data.register(d, registry)
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)
  proc stored(id: string): NbtCompound {.closure.} =
    for i in 0 ..< storages.len:
      if storages[i][0] == id:
        return storages[i][1]
    newCompound()

  check(run("data modify storage test:a x set value 7").isOk, "setup")
  # note: execute must be registered before another command: a redirect cannot target the newest node (cmdtree.resolve).
  # store result storage: the value of `data get` is 7
  check(run("execute store result storage test:s got int 1 run data get storage test:a x").isOk, "store result storage")
  check(stored("test:s") == compOf("{got:7}"), "stored 7 as an int")
  check(run("execute store result storage test:s scaled double 0.5 run data get storage test:a x").isOk, "store with a scale")
  check(stored("test:s") == compOf("{got:7,scaled:3.5d}"), "7 * 0.5 as a double")
  check(run("execute store result storage test:s small byte 100 run data get storage test:a x").isOk, "byte store")
  check(stored("test:s") == compOf("{got:7,scaled:3.5d,small:-68b}"), "700 as a byte is -68")
  check(run("execute store success storage test:s ok int 1 run data get storage test:a x").isOk, "store success")
  check(stored("test:s").getInt("ok") == some(1'i32), "success is 1")
  check(run("execute store result storage test:s deep.list[].k long 2 run data get storage test:a x").isOk, "store into a created path")
  check(stored("test:s") == compOf("{got:7,scaled:3.5d,small:-68b,ok:1,deep:{list:[{k:14L}]}}"), "path created, long scaled")
  # store into a block entity
  check(run("execute store result block 1 2 3 n int 1 run data get storage test:a x").isOk, "store result block")
  check(blockNbt.getInt("n") == some(7'i32), "block data holds 7")
  # an entity that is not a player
  check(run("execute store result entity 11111111-2222-3333-4444-555555555555 Health float 1 run data get storage test:a x").isOk, "store result entity")
  check(pigNbt == compOf("{Health:7.0f,CustomName:\"Pig\"}"), "the pig's Health is the float 7")
  check(run("data get entity 11111111-2222-3333-4444-555555555555 Health").isOk, "data get entity by uuid")
  # bossbar
  check(run("execute store result bossbar minecraft:bar value run data get storage test:a x").isOk, "store bossbar value")
  check(barValue == 7'i32 and barMax == 100'i32, "bossbar value 7")
  check(run("execute store result bossbar minecraft:bar max run data get storage test:a x").isOk, "store bossbar max")
  check(barMax == 7'i32, "bossbar max 7")
  check(not run("execute store result bossbar minecraft:nope value run data get storage test:a x").isOk, "unknown bossbar")
  # if / unless data
  check(run("execute if data storage test:a x run data get storage test:a x").value == 7'i32, "if data present runs")
  check(run("execute if data storage test:a nothing run data get storage test:a x").value == 0'i32, "if data absent does not run")
  check(run("execute unless data storage test:a nothing run data get storage test:a x").value == 7'i32, "unless data absent runs")
  check(run("execute if data block 1 2 3 n run data get storage test:a x").value == 7'i32, "if data block")
  check(not run("execute if data block 9 9 9 n run data get storage test:a x").isOk, "if data on a block without an entity fails")
  check(run("execute if data storage test:s deep.list[{k:14L}] run data get storage test:a x").value == 7'i32, "if data with a filter")

  if failures > 0:
    echo "executedatatest: ", failures, " FAILED"
    quit(1)

main()
echo "execute data tests: all checks passed"
