## `/execute` run through a real dispatcher, each subcommand reaching a command that records its source.
import std/[options, syncio]
import ../../command/[argument_builder, cmddispatch, cmderrors, cmdsource, cmdtree]
from ../../command/fallbackdispatch import nil
import ../../generated/blockdata
import ../../util/[permission, vector2, vector3, uuid]
import ../../util/text/[textbase, text]
import execute, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc makeEntity(name: string; at: Vector3[float64]; id: uint64; world: nil CommandWorld): CommandEntity =
  CommandEntity(uuid: Uuid(hi: id, lo: id), entityTypeName: "pig",
    getName: proc(): TextComponent {.closure.} = text(name),
    getDisplayName: proc(): TextComponent {.closure.} = text(name),
    getPos: proc(): Vector3[float64] {.closure.} = at,
    getRotation: proc(): Vector2[float32] {.closure.} = Vector2[float32](x: 10.0'f32, y: 20.0'f32),
    getWorld: proc(): nil CommandWorld {.closure.} = world,
    isAlive: proc(): bool {.closure.} = true)

proc main() =
  var seen: seq[CommandSource] = @[]
  var entities: seq[CommandEntity] = @[]
  let stoneId = blockByName("stone")[1].id
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getEntities = proc(): seq[CommandEntity] {.closure.} = entities
  world.getBlockId = proc(x, y, z: int32): int {.closure.} = (if x == 1'i32: stoneId else: 0)
  world.isChunkLoaded = proc(x, z: int32): bool {.closure.} = x == 0'i32
  world.getBiomeAt = proc(x, y, z: int32): int32 {.closure.} = (if x < 0'i32: 1'i32 else: 0'i32)  # badlands is 0, bamboo_jungle is 1
  let server = newServerWithWorld(world)
  entities.add(makeEntity("a", Vector3[float64](x: 5.0, y: 6.0, z: 7.0), 1'u64, world))
  entities.add(makeEntity("b", Vector3[float64](x: 8.0, y: 9.0, z: 10.0), 2'u64, world))
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  execute.register(d, newPermissionRegistry())
  let mark: CommandExecutor = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    seen.add(context.source)
    cmdOk[int32](1'i32)
  discard register(d, executes(command("mark", ""), mark))

  proc run(line: string): int {.closure.} =
    seen = @[]
    let r = executeInput(d, line, source)
    check(r.isOk, line)
    seen.len

  check(run("execute run mark") == 1, "run")
  check(run("execute run execute run mark") == 1, "run in run")
  check(run("execute as @e run mark") == 2, "as @e")
  check(getText(seen[1].displayName) == "b", "as: name")
  let target = seen[1].entity
  check(target != nil, "as: entity")
  check(run("execute at @e run mark") == 2, "at @e")
  check(seen[0].position.x == 5.0 and seen[1].position.z == 10.0, "at: position")
  check(seen[0].rotation.x == 20.0'f32 and seen[0].rotation.y == 10.0'f32, "at: yaw then pitch")
  check(run("execute positioned 1 2 3 run mark") == 1, "positioned")
  check(seen[0].position.x == 1.5 and seen[0].position.y == 2.0 and seen[0].position.z == 3.5, "positioned: where")
  check(run("execute positioned as @e run mark") == 2, "positioned as")
  check(seen[0].position.y == 6.0, "positioned as: where")
  check(run("execute positioned 1.5 2.5 3.5 align xz run mark") == 1, "align")
  check(seen[0].position.x == 1.0 and seen[0].position.y == 2.5 and seen[0].position.z == 3.0, "align: axes")
  check(run("execute rotated 30 40 run mark") == 1, "rotated")
  check(seen[0].rotation.x == 40.0'f32 and seen[0].rotation.y == 30.0'f32, "rotated: value")
  check(run("execute rotated as @e run mark") == 2, "rotated as")
  check(run("execute anchored eyes run mark") == 1, "anchored")
  check(seen[0].entityAnchor == eaEyes, "anchored: anchor")
  check(run("execute positioned 0 0 0 facing 0 0 10 run mark") == 1, "facing")
  check(run("execute if entity @e run mark") == 1, "if entity")
  check(run("execute unless entity @e run mark") == 0, "unless entity")
  check(run("execute if block 1 2 3 stone run mark") == 1, "if block")
  check(run("execute if block 2 2 3 stone run mark") == 0, "if block, other block")
  check(run("execute unless block 2 2 3 stone run mark") == 1, "unless block")
  check(run("execute if loaded 3 0 3 run mark") == 1, "if loaded")
  check(run("execute unless loaded 3 0 3 run mark") == 0, "unless loaded")
  check(run("execute if loaded 300 0 3 run mark") == 0, "if loaded, far")
  check(run("execute if dimension minecraft:overworld run mark") == 1, "if dimension")
  check(run("execute unless dimension minecraft:overworld run mark") == 0, "unless dimension")
  check(run("execute if biome 5 64 5 minecraft:badlands run mark") == 1, "if biome: badlands (id 0) at x >= 0")
  check(run("execute if biome -5 64 5 minecraft:badlands run mark") == 0, "if biome: bamboo_jungle (id 1) at x < 0")
  check(run("execute unless biome -5 64 5 minecraft:badlands run mark") == 1, "unless biome")
  check(run("execute in minecraft:overworld run mark") == 1, "in")
  check(not executeInput(d, "execute in minecraft:nowhere run mark", source).isOk, "in: bad dimension")
  check(run("execute as @e at @s positioned ~ ~1 ~ run mark") == 2, "chained")
  # A command the new dispatcher lacks runs in the fallback dispatcher, with the source's world and position in force.
  var fbWorld: nil CommandWorld = nil
  var fbX = 0.0
  var fbCalls = 0
  let probeExec: fallbackdispatch.FallbackExecutor = proc(sender: CommandSender; server: nil CommandServer;
      args: fallbackdispatch.ConsumedArgs): fallbackdispatch.CommandResult {.closure.} =
    inc fbCalls
    var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
    discard cmdsource.position(sender, pos)
    fbX = pos.x
    fbWorld = cmdsource.world(sender)
    fallbackdispatch.cmdSuccess(7'i32)
  let probeTree = fallbackdispatch.then(fallbackdispatch.newCommandTree(["fbprobe"], "probe"),
    fallbackdispatch.execute(fallbackdispatch.literal("go"), probeExec))
  fallbackdispatch.register(d.fallbackDispatcher, probeTree, "minecraft:command.fbprobe")
  check(executeInput(d, "execute positioned 1 2 3 run fbprobe go", source).isOk, "fallback command ran")
  check(fbCalls == 1 and fbX == 1.5, "fallback sees the positioned source")
  check(fbWorld == world, "fallback sees the source's world")
  check(not executeInput(d, "execute run nosuchcommand", source).isOk, "unknown stays an error")
  # Scores: `if score`, and `store result score` taking a command's value.
  var scores: seq[(string, string, int32)] = @[]
  world.getScoreEntry = proc(entity, objective: string; res: var CmdScore): bool {.closure.} =
    for sc in scores:
      if sc[0] == entity and sc[1] == objective:
        res = CmdScore(value: sc[2], locked: false)
        return true
    false
  world.setScoreEntry = proc(entity, objective: string; value: int32; locked: bool) {.closure.} =
    var k = 0
    while k < scores.len:
      if scores[k][0] == entity and scores[k][1] == objective:
        scores[k] = (entity, objective, value)
        return
      inc k
    scores.add((entity, objective, value))
  let aKey = $entities[0].uuid
  scores.add((aKey, "pts", 5'i32))
  scores.add((aKey, "other", 9'i32))
  check(run("execute if score @e[limit=1] pts matches 3..6 run mark") == 1, "if score matches")
  check(run("execute if score @e[limit=1] pts matches 7.. run mark") == 0, "if score matches, outside")
  check(run("execute unless score @e[limit=1] pts matches 7.. run mark") == 1, "unless score matches")
  check(run("execute if score @e[limit=1] pts < @e[limit=1] other run mark") == 1, "if score <")
  check(run("execute if score @e[limit=1] pts >= @e[limit=1] other run mark") == 0, "if score >=")
  check(run("execute store result score @e[limit=1] pts run mark") == 1, "store result runs")
  var stored = 0'i32
  for sc in scores:
    if sc[0] == aKey and sc[1] == "pts":
      stored = sc[2]
  check(stored == 1'i32, "store result keeps the command's value")
  check(run("execute store success score @e[limit=1] other run execute if entity @e[type=pig] run mark") == 1, "store success runs")
  var okVal = 0'i32
  for sc in scores:
    if sc[0] == aKey and sc[1] == "other":
      okVal = sc[2]
  check(okVal == 1'i32, "store success records 1")
  check(executeInput(d, "execute store result score @e[limit=1] pts run fbprobe go", source).isOk, "store a fallback command's value")
  var fbStored = 0'i32
  for sc in scores:
    if sc[0] == aKey and sc[1] == "pts":
      fbStored = sc[2]
  check(fbStored == 7'i32, "the fallback executor's value reaches the store")
  # Blocks: both areas compare equal when every state matches.
  world.getBlockStateId = proc(x, y, z: int32): uint16 {.closure.} = (if x == 1'i32 or x == 11'i32: 5'u16 else: 0'u16)
  world.isAirState = proc(id: uint16): bool {.closure.} = id == 0'u16
  check(run("execute if blocks 0 0 0 2 0 0 10 0 0 all run mark") == 1, "if blocks all")
  check(run("execute if blocks 0 0 0 2 0 0 20 0 0 all run mark") == 0, "if blocks all, different")
  check(run("execute unless blocks 0 0 0 2 0 0 20 0 0 all run mark") == 1, "unless blocks")
  check(run("execute if blocks 0 0 0 2 0 0 20 0 0 masked run mark") == 0, "if blocks masked")
  echo "execute: all checks passed"

main()
