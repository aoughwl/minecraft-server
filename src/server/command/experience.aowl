## The `/experience` command.
## Port of pumpkin/src/command/commands/experience.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../util/math/experience as xpmath

type
  Mode = enum
    modeAdd
    modeSet
    modeQuery

  ExpType = enum
    expPoints
    expLevels

const
  Names = ["experience", "xp"]
  Description = "Add, set or query player experience."
  ArgTargets = "targets"
  ArgAmount = "amount"

proc xpAmount(): ArgumentConsumer = newBoundedI32(ArgAmount, some(0'i32), some(int32.high))

proc handleModify(mode: Mode; expType: ExpType; target: CommandPlayer; amount: int32): bool =
  case expType
  of expLevels:
    if mode == modeAdd:
      if target.addExperienceLevels != nil:
        target.addExperienceLevels(amount)
    elif target.setExperienceLevel != nil:
      target.setExperienceLevel(amount)
  of expPoints:
    if mode == modeAdd:
      if target.addExperiencePoints != nil:
        target.addExperiencePoints(amount)
    else:
      let currentLvl = if target.getExperienceLevel != nil: target.getExperienceLevel() else: 0'i32
      if amount > pointsInLevel(currentLvl):
        return false
      if target.setExperiencePoints != nil:
        target.setExperiencePoints(amount)
  true

proc experienceExecutor(mode: Mode; expType: ExpType): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var targets: seq[CommandPlayer] = @[]
    if not findPlayers(args, ArgTargets, targets):
      return missing(ArgTargets)
    if mode == modeQuery:
      if targets.len == 0:
        return cmdFailed(tc("argument.player.unknown"))
      if targets.len > 1:
        return cmdFailed(tc("argument.player.toomany"))
      let target = targets[0]
      var value = 0'i32
      var key = "commands.experience.query.points"
      if expType == expLevels:
        key = "commands.experience.query.levels"
        if target.getExperienceLevel != nil:
          value = target.getExperienceLevel()
      elif target.getExperiencePoints != nil:
        value = target.getExperiencePoints()
      sendMessage(sender, tc(key, [shown(target), text($value)]))
      return cmdSuccess(value)
    var amount = 0'i32
    let r = requireI32(args, ArgAmount, amount)
    if not r.isOk:
      return r
    var successes = 0'i32
    for target in targets:
      if handleModify(mode, expType, target, amount):
        inc successes
    if successes == 0'i32:
      return cmdFailed(tc("commands.experience.set.points.invalid"))
    let typeStr = if expType == expPoints: "points" else: "levels"
    let modeStr = if mode == modeAdd: "add" else: "set"
    let bedrockKey =
      if expType == expPoints: BEDROCK_COMMANDS_XP_SUCCESS
      elif amount >= 0'i32: BEDROCK_COMMANDS_XP_SUCCESS_LEVELS
      else: BEDROCK_COMMANDS_XP_SUCCESS_NEGATIVE_LEVELS
    let shownAmount = text($abs(amount))
    if targets.len > 1:
      sendMessage(sender, tc2("commands.experience." & modeStr & "." & typeStr & ".success.multiple", bedrockKey, [shownAmount, text($targets.len)]))
    else:
      sendMessage(sender, tc2("commands.experience." & modeStr & "." & typeStr & ".success.single", bedrockKey, [shownAmount, shown(targets[0])]))
    cmdSuccess(successes)

proc changeBranch(name: string; mode: Mode): NonLeafNodeBuilder =
  let amount = execute(then(then(argument(ArgAmount, xpAmount()),
    execute(literal("levels"), experienceExecutor(mode, expLevels))),
    execute(literal("points"), experienceExecutor(mode, expPoints))), experienceExecutor(mode, expPoints))
  then(literal(name), then(argument(ArgTargets, newPlayersArgumentConsumer()), amount))

proc initCommandTree*(): CommandTree =
  var t = newCommandTree(Names, Description)
  t = then(t, changeBranch("add", modeAdd))
  t = then(t, changeBranch("set", modeSet))
  then(t, then(literal("query"), then(then(argument(ArgTargets, newPlayersArgumentConsumer()),
    execute(literal("levels"), experienceExecutor(modeQuery, expLevels))),
    execute(literal("points"), experienceExecutor(modeQuery, expPoints)))))
