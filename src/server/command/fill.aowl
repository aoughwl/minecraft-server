## The `/fill` command.
## Port of pumpkin/src/command/commands/fill.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/blockdata
import args_resource

type Mode = enum
  modeDestroy
  modeHollow
  modeKeep
  modeOutline
  modeReplace
  modeStrict

const
  Names = ["fill"]
  Description = "Fills all or parts of a region with a specific block."
  ArgBlock = "block"
  ArgFrom = "from"
  ArgTo = "to"
  ArgFilter = "filter"
  AirState = 0'u16

proc notInFilter(filter: BlockPredicate; world: CommandWorld; x, y, z: int32): bool =
  if filter.kind == bpNone or not closureSet(world.getBlockId):
    return false
  not testBlockPredicate(filter, world.getBlockId(x, y, z))

proc fillExecutor(mode: Mode): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var blockV = Block()
    var stateId = 0'u16
    let b = findBlockState(args, ArgBlock, blockV, stateId)
    if not b.isOk:
      return b
    var fromP = BlockPos()
    var toP = BlockPos()
    if not findBlockPos(args, ArgFrom, fromP):
      return missing(ArgFrom)
    if not findBlockPos(args, ArgTo, toP):
      return missing(ArgTo)
    var filter = BlockPredicate(kind: bpNone)
    let fp = findBlockPredicate(args, ArgFilter, filter)
    if not fp.isOk:
      return fp
    if server == nil:
      return cmdInvalidRequirement()
    let world = worldOrFirst(sender, server)
    if world == nil:
      return cmdInvalidRequirement()
    if not closureSet(world.setBlockState):
      return cmdInvalidRequirement()
    let f = fromP.vec
    let t = toP.vec
    if closureSet(world.isInBuildLimit) and (not world.isInBuildLimit(f.x, f.y, f.z) or not world.isInBuildLimit(t.x, t.y, t.z)):
      return cmdFailed(tc(JAVA_ARGUMENT_POS_OUTOFBOUNDS))
    let startX = min(f.x, t.x)
    let startY = min(f.y, t.y)
    let startZ = min(f.z, t.z)
    let endX = max(f.x, t.x)
    let endY = max(f.y, t.y)
    let endZ = max(f.z, t.z)
    var maxMods = 32768'i64
    if closureSet(server.getGameRule):
      maxMods = server.getGameRule("max_block_modifications").intValue
    let total = int64(endX - startX + 1) * int64(endY - startY + 1) * int64(endZ - startZ + 1)
    if total > maxMods:
      return cmdFailed(tc(JAVA_COMMANDS_FILL_TOOBIG, [text($maxMods), text($total)]))
    var placed = 0'i32
    var toUpdate: seq[Vector3[int32]] = @[]
    var x = startX
    while x <= endX:
      var y = startY
      while y <= endY:
        var z = startZ
        while z <= endZ:
          let edge = x == startX or x == endX or y == startY or y == endY or z == startZ or z == endZ
          var didPlace = true
          var withUpdate = true
          case mode
          of modeDestroy:
            if notInFilter(filter, world, x, y, z):
              didPlace = false
            else:
              if closureSet(world.breakBlock):
                world.breakBlock(x, y, z, (cbfSkipDrops or cbfForceState))
              world.setBlockState(x, y, z, stateId, cbfForceState)
          of modeHollow:
            if notInFilter(filter, world, x, y, z):
              didPlace = false
            else:
              world.setBlockState(x, y, z, (if edge: stateId else: AirState), cbfForceState)
          of modeKeep:
            let old = if closureSet(world.getBlockStateId): world.getBlockStateId(x, y, z) else: AirState
            if (not closureSet(world.isAirState) or world.isAirState(old)) and not notInFilter(filter, world, x, y, z):
              world.setBlockState(x, y, z, stateId, cbfForceState)
            else:
              didPlace = false
          of modeOutline:
            if not edge or notInFilter(filter, world, x, y, z):
              didPlace = false
            else:
              world.setBlockState(x, y, z, stateId, cbfForceState)
          of modeReplace:
            if notInFilter(filter, world, x, y, z):
              didPlace = false
            else:
              world.setBlockState(x, y, z, stateId, cbfForceState)
          of modeStrict:
            if notInFilter(filter, world, x, y, z):
              didPlace = false
            else:
              world.setBlockState(x, y, z, stateId, cbfSkipBlockAddedCallback)
              withUpdate = false
          if didPlace:
            inc placed
            if withUpdate:
              toUpdate.add(Vector3[int32](x: x, y: y, z: z))
          inc z
        inc y
      inc x
    if closureSet(world.updateNeighbors):
      for p in toUpdate:
        world.updateNeighbors(p.x, p.y, p.z)
    if placed == 0'i32:
      return cmdFailed(tc2(JAVA_COMMANDS_FILL_FAILED, BEDROCK_COMMANDS_FILL_FAILED))
    sendMessage(sender, tc2(JAVA_COMMANDS_FILL_SUCCESS, BEDROCK_COMMANDS_FILL_SUCCESS, [text($placed)]))
    cmdSuccess(placed)

proc modes(b0: NonLeafNodeBuilder): NonLeafNodeBuilder =
  var b = then(b0, execute(literal("destroy"), fillExecutor(modeDestroy)))
  b = then(b, execute(literal("hollow"), fillExecutor(modeHollow)))
  b = then(b, execute(literal("keep"), fillExecutor(modeKeep)))
  then(b, execute(literal("outline"), fillExecutor(modeOutline)))

proc initCommandTree*(): CommandTree =
  let filterN = execute(then(modes(argument(ArgFilter, newBlockPredicateArgumentConsumer())), execute(literal("strict"), fillExecutor(modeStrict))), fillExecutor(modeReplace))
  var blockN = modes(argument(ArgBlock, newBlockArgumentConsumer()))
  blockN = then(blockN, execute(then(literal("replace"), filterN), fillExecutor(modeReplace)))
  blockN = execute(then(blockN, execute(literal("strict"), fillExecutor(modeStrict))), fillExecutor(modeReplace))
  then(newCommandTree(Names, Description), then(argument(ArgFrom, newBlockPosArgumentConsumer()), then(argument(ArgTo, newBlockPosArgumentConsumer()), blockN)))
