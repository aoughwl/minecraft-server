## The `/fillbiome` command.
## Port of pumpkin/src/command/commands/fillbiome.rs
## The chunk loop and the chunk broadcast are behind `CommandWorld.fillBiomeChunk`; the grouping of cells by chunk,
## the limits and the messages are here.

import std/[options, tables]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, coordinates, cmddispatch]
import ../../util/[vector2, vector3, permission]
import ../../util/text/[textbase, text]
import ../../generated/translation

const
  Description = "Changes biomes of an area."
  Permission0 = "minecraft:command.fillbiome"
  MaxBiomeBlocks = 32768'i64

proc toobigError(): CommandErrorType = errorType2(JAVA_COMMANDS_FILLBIOME_TOOBIG, JAVA_COMMANDS_FILLBIOME_TOOBIG)

proc chunkKey(cx, cz: int32): int64 = (int64(cx) shl 32) xor int64(uint32(cz))

proc fillBiomeExecutor(hasReplace: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let fromR = getBlockPos(context, "from")
    if not fromR.isOk:
      return cmdFail[int32](fromR.error)
    let toR = getBlockPos(context, "to")
    if not toR.isOk:
      return cmdFail[int32](toR.error)
    let world = context.source.world
    if world == nil:
      return cmdFail[int32](createWithoutContext(outOfBoundsErrorType()))
    let f = fromR.value.vec
    let t = toR.value.vec
    if world.isInBuildLimit != nil and (not world.isInBuildLimit(f.x, f.y, f.z) or not world.isInBuildLimit(t.x, t.y, t.z)):
      return cmdFail[int32](createWithoutContext(outOfBoundsErrorType()))
    let minX = min(f.x, t.x)
    let maxX = max(f.x, t.x)
    let minY = min(f.y, t.y)
    let maxY = max(f.y, t.y)
    let minZ = min(f.z, t.z)
    let maxZ = max(f.z, t.z)
    let biomeMinX = minX shr 2
    let biomeMaxX = maxX shr 2
    let biomeMinY = minY shr 2
    let biomeMaxY = maxY shr 2
    let biomeMinZ = minZ shr 2
    let biomeMaxZ = maxZ shr 2
    let volume = int64(biomeMaxX - biomeMinX + 1) * int64(biomeMaxY - biomeMinY + 1) * int64(biomeMaxZ - biomeMinZ + 1)
    if volume > MaxBiomeBlocks:
      return cmdFail[int32](createWithoutContext(toobigError(), text($MaxBiomeBlocks), text($volume)))
    let target = getBiome(context, "biome")
    if not target.isOk:
      return cmdFail[int32](target.error)
    var replaceId = 0'i32
    if hasReplace:
      let rep = getBiome(context, "replace_biome")
      if not rep.isOk:
        return cmdFail[int32](rep.error)
      replaceId = int32(rep.value.id)
    var minWorldY = 0'i32
    if world.getMinY != nil:
      minWorldY = world.getMinY()
    # Cells by chunk, in the order upstream's y, z, x loops push them.
    var chunkOrder: seq[Vector2[int32]] = @[]
    var chunkCells: seq[seq[Vector3[int32]]] = @[]
    var chunkIndex = initTable[int64, int]()
    for y in biomeMinY .. biomeMaxY:
      for z in biomeMinZ .. biomeMaxZ:
        for x in biomeMinX .. biomeMaxX:
          let cx = x shr 2
          let cz = z shr 2
          let key = chunkKey(cx, cz)
          var at = chunkIndex.getOrDefault(key, -1)
          if at < 0:
            at = chunkCells.len
            chunkIndex[key] = at
            chunkCells.add(@[])
            chunkOrder.add(Vector2[int32](x: cx, y: cz))
          chunkCells[at].add(Vector3[int32](x: x and 3'i32, y: y - (minWorldY shr 2), z: z and 3'i32))
    var changed = 0'i32
    if world.fillBiomeChunk != nil:
      for at in 0 ..< chunkOrder.len:
        changed += world.fillBiomeChunk(chunkOrder[at].x, chunkOrder[at].y, chunkCells[at], int32(target.value.id), hasReplace, replaceId)
    sendFeedback(context.source, translateCross(JAVA_COMMANDS_FILLBIOME_SUCCESS_COUNT, JAVA_COMMANDS_FILLBIOME_SUCCESS_COUNT,
      [text($changed)]), true)
    cmdOk[int32](changed)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let biomeN = then(executes(argument("biome", newResourceKeyArgument(biomeRegistry())), fillBiomeExecutor(false)),
    executes(argument("replace_biome", newResourceKeyArgument(biomeRegistry())), fillBiomeExecutor(true)))
  discard register(dispatcher, then(requires(command("fillbiome", Description), Permission0),
    then(argument("from", newBlockPosArgumentType()), then(argument("to", newBlockPosArgumentType()), biomeN))))
