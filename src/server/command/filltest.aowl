## `/fill` over the edge of the loaded area: a write into a chunk that is not in the level stores nothing, so the command must refuse the
## whole box (as /clone and vanilla's loaded-position check do) instead of counting blocks as placed that never were.
## 15 | 16 along x, 15 | 16 along z, and the loaded box that still works.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, fallbackdispatch]
import ../../util/[permission, uuid, vector3, vector2]
import ../../util/text/[textbase, text]
import fill, cmdtestutil

var placed = 0
let world = CommandWorld(dimensionName: "minecraft:overworld")
world.setBlockState = proc(x, y, z: int32; s: uint16; f: uint32) {.closure.} =
  inc placed
world.isChunkLoaded = proc(cx, cz: int32): bool {.closure.} =
  cx >= -1'i32 and cx <= 0'i32 and cz >= -1'i32 and cz <= 0'i32
let server = newServerWithWorld(world)
let d = newFallbackDispatcher()
register(d, fill.initCommandTree(), "minecraft:command.fill")

# inside chunk (0, 0) and across the border into chunk (-1, 0), both loaded
assert dispatch(d, senderConsole(), server, "fill -2 0 0 3 0 0 stone").isOk
assert placed == 6, "a box over two loaded chunks is placed in full"
# chunk (1, 0) is not loaded: x = 16 .. 17 are over the border, so nothing is written, not even the 14 cells of the loaded chunk
placed = 0
assert not dispatch(d, senderConsole(), server, "fill 2 0 0 17 0 0 stone").isOk
assert placed == 0, "a box that reaches an unloaded chunk writes nothing"
placed = 0
assert not dispatch(d, senderConsole(), server, "fill 0 0 0 0 0 16 stone").isOk
assert placed == 0, "the same along z"
placed = 0
assert dispatch(d, senderConsole(), server, "fill 0 0 0 15 0 15 stone").isOk
assert placed == 256, "the last cells of a loaded chunk still fill"
echo "filltest ok"
