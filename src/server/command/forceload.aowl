## The `/forceload` command.
## Port of pumpkin/src/command/commands/forceload.rs

import ../../util/closureset
import std/[math, options]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch, coordinates]
import ../../util/[permission, vector2, vector3]
import ../../util/math/[position, mathmod]
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Constantly load chunks in the world."
  Permission0 = "minecraft:command.forceload"
  MaxChunks = 256'i32

type ForceloadKind = enum
  fkAdd
  fkRemove

proc failedAdd(): CommandErrorType = errorType0(JAVA_COMMANDS_FORCELOAD_ADDED_FAILURE, "No world in source")
proc failedRemove(): CommandErrorType = errorType0(JAVA_COMMANDS_FORCELOAD_REMOVED_FAILURE, "No world in source")
proc failedQuery(): CommandErrorType = errorType0(JAVA_COMMANDS_FORCELOAD_QUERY_FAILURE, "No world in source")
proc tooMany(): CommandErrorType = errorType2(JAVA_COMMANDS_FORCELOAD_TOOBIG, "Too many chunks")

proc hasArgument(context: CommandContext; name: string): bool =
  var found = false
  discard argumentOf(context, name, found)
  found

proc green(m: TextComponent): TextComponent = colorNamed(m, ncGreen)

proc changeExecutor(kind: ForceloadKind): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let fromPos = getBlockPos(context, "from")
    if not fromPos.isOk:
      return cmdFail[int32](fromPos.error)
    var toPos = fromPos.value
    if hasArgument(context, "to"):
      let t = getBlockPos(context, "to")
      if not t.isOk:
        return cmdFail[int32](t.error)
      toPos = t.value
    let world = context.source.world
    if world == nil:
      return cmdFail[int32](createWithoutContext(if kind == fkAdd: failedAdd() else: failedRemove()))
    let chunkXStart = floorDiv(fromPos.value.vec.x, 16'i32)
    let chunkZStart = floorDiv(fromPos.value.vec.z, 16'i32)
    let chunkXEnd = floorDiv(toPos.vec.x, 16'i32)
    let chunkZEnd = floorDiv(toPos.vec.z, 16'i32)
    let minX = min(chunkXStart, chunkXEnd)
    let maxX = max(chunkXStart, chunkXEnd)
    let minZ = min(chunkZStart, chunkZEnd)
    let maxZ = max(chunkZStart, chunkZEnd)
    let totalChunks = (maxX - minX + 1'i32) * (maxZ - minZ + 1'i32)
    if totalChunks > MaxChunks:
      return cmdFail[int32](createWithoutContext(tooMany(), text("256"), text($totalChunks)))
    if closureSet(world.setForcedChunk):
      for x in minX .. maxX:
        for z in minZ .. maxZ:
          world.setForcedChunk(x, z, kind == fkAdd)
    let single = if kind == fkAdd: JAVA_COMMANDS_FORCELOAD_ADDED_SINGLE else: JAVA_COMMANDS_FORCELOAD_REMOVED_SINGLE
    let multiple = if kind == fkAdd: JAVA_COMMANDS_FORCELOAD_ADDED_MULTIPLE else: JAVA_COMMANDS_FORCELOAD_REMOVED_MULTIPLE
    let msg =
      if totalChunks == 1'i32:
        tc(single, [text($minX), text($minZ)])
      else:
        tc(multiple, [text($totalChunks), text($minX), text($minZ), text($maxX), text($maxZ)])
    sendFeedback(context.source, green(msg), false)
    cmdOk[int32](totalChunks)

proc removeAllExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdFail[int32](createWithoutContext(failedRemove()))
  let removed = if closureSet(world.clearForcedChunks): world.clearForcedChunks() else: 0'i32
  sendFeedback(context.source, green(tc(JAVA_COMMANDS_FORCELOAD_REMOVED_ALL)), false)
  cmdOk[int32](removed)

proc queryExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdFail[int32](createWithoutContext(failedQuery()))
  var chunkX = 0'i32
  var chunkZ = 0'i32
  if hasArgument(context, "pos"):
    let pos = getBlockPos(context, "pos")
    if not pos.isOk:
      return cmdFail[int32](pos.error)
    chunkX = floorDiv(pos.value.vec.x, 16'i32)
    chunkZ = floorDiv(pos.value.vec.z, 16'i32)
  else:
    chunkX = floorDiv(int32(floor(context.source.position.x)), 16'i32)
    chunkZ = floorDiv(int32(floor(context.source.position.z)), 16'i32)
  var all: seq[Vector2[int32]] = @[]
  if closureSet(world.getForcedChunks):
    all = world.getForcedChunks()
  var isForced = false
  for c in all:
    if c.x == chunkX and c.y == chunkZ:
      isForced = true
  if isForced:
    sendFeedback(context.source, green(tc(JAVA_COMMANDS_FORCELOAD_QUERY_SUCCESS, [text($chunkX), text($chunkZ)])), false)
  else:
    sendFeedback(context.source, colorNamed(tc(JAVA_COMMANDS_FORCELOAD_QUERY_FAILURE, [text($chunkX), text($chunkZ)]), ncRed), false)
  if all.len == 0:
    sendFeedback(context.source, colorNamed(tc(JAVA_COMMANDS_FORCELOAD_ADDED_NONE), ncGray), false)
  else:
    var listStr = ""
    for i in 0 ..< all.len:
      if i > 0:
        listStr.add(", ")
      listStr.add("[" & $all[i].x & ", " & $all[i].y & "]")
    let key = if all.len == 1: JAVA_COMMANDS_FORCELOAD_LIST_SINGLE else: JAVA_COMMANDS_FORCELOAD_LIST_MULTIPLE
    sendFeedback(context.source, colorNamed(tc(key, [text(listStr)]), ncGray), false)
  cmdOk[int32](if isForced: 1'i32 else: 0'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let addB = then(literal("add"), then(executes(argument("from", newColumnPosArgumentType()), changeExecutor(fkAdd)),
    executes(argument("to", newColumnPosArgumentType()), changeExecutor(fkAdd))))
  let removeB = then(then(literal("remove"), executes(literal("all"), removeAllExecutor)),
    then(executes(argument("from", newColumnPosArgumentType()), changeExecutor(fkRemove)),
      executes(argument("to", newColumnPosArgumentType()), changeExecutor(fkRemove))))
  let queryB = then(executes(literal("query"), queryExecutor), executes(argument("pos", newColumnPosArgumentType()), queryExecutor))
  discard register(dispatcher, then(then(then(requires(command("forceload", Description), Permission0), addB), removeB), queryB))
