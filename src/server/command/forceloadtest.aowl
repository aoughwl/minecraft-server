## `/forceload` through the brigadier dispatcher, over a world hook that keeps the pinned chunks.
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../util/[permission, vector2, vector3]
import forceload, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  var pinned: seq[Vector2[int32]] = @[]
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  world.getForcedChunks = proc(): seq[Vector2[int32]] {.closure.} = pinned
  world.setForcedChunk = proc(cx, cz: int32; isOn: bool) {.closure.} =
    var kept: seq[Vector2[int32]] = @[]
    for c in pinned:
      if c.x != cx or c.y != cz:
        kept.add(c)
    if isOn:
      kept.add(Vector2[int32](x: cx, y: cz))
    pinned = kept
  world.clearForcedChunks = proc(): int32 {.closure.} =
    let n = int32(pinned.len)
    pinned = @[]
    n
  let server = newServerWithWorld(world)
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  forceload.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)

  check(run("forceload query").value == 0'i32, "nothing pinned at the origin")
  let one = run("forceload add 8 8")
  check(one.isOk and one.value == 1'i32 and pinned.len == 1 and pinned[0].x == 0'i32 and pinned[0].y == 0'i32, "add one chunk")
  let many = run("forceload add 0 0 40 40")
  check(many.isOk and many.value == 9'i32, "a 3x3 range is 9 chunks")
  check(pinned.len == 9, "the one already pinned is not doubled")
  check(run("forceload query").value == 1'i32, "the origin chunk is pinned")
  check(run("forceload query 100 100").value == 0'i32, "a far chunk is not")
  check(run("forceload add -1 -1").isOk, "negative columns floor")
  var seen = false
  for c in pinned:
    if c.x == -1'i32 and c.y == -1'i32:
      seen = true
  check(seen, "-1 -1 is chunk -1 -1, not 0 0")
  check(not run("forceload add 0 0 4000 4000").isOk, "more than 256 chunks fails")
  let gone = run("forceload remove 0 0 40 40")
  check(gone.isOk and gone.value == 9'i32 and pinned.len == 1, "remove a range")
  let all = run("forceload remove all")
  check(all.isOk and all.value == 1'i32 and pinned.len == 0, "remove all")

main()
echo "forceload tests: all checks passed"
