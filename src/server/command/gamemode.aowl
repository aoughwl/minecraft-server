## The `/gamemode` command.
## Port of pumpkin/src/command/commands/gamemode.rs

import ../../util/closureset
import std/[options, strutils]
import ../../util/gamemode
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["gamemode"]
  Description = "Change a player's gamemode."
  ArgGamemode = "gamemode"
  ArgTarget = "target"

proc debugName(g: GameMode): string =
  ## `format!("{gamemode:?}").to_lowercase()`.
  case g
  of Survival: "survival"
  of Creative: "creative"
  of Adventure: "adventure"
  of Spectator: "spectator"

proc targetExecutor(isSelf: bool): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var gamemode = Survival
    if not findGameMode(args, ArgGamemode, gamemode):
      return cmdInvalidConsumption(some(ArgGamemode))
    var targets: seq[CommandPlayer] = @[]
    if isSelf:
      if sender.kind != cskPlayer:
        return cmdInvalidRequirement()
      targets.add(sender.player)
    elif not findPlayers(args, ArgTarget, targets):
      return cmdInvalidConsumption(some(ArgTarget))
    var succeeded = 0'i32
    for target in targets:
      if closureSet(target.setGameMode) and target.setGameMode(gamemode):
        inc succeeded
        let key = "gameMode." & debugName(gamemode)
        let comp = translateCross(key, key)
        let isSender = sender.kind == cskPlayer and sender.player.entity.uuid == target.entity.uuid
        if isSender:
          if closureSet(target.sendSystemMessage):
            target.sendSystemMessage(translateCross(JAVA_COMMANDS_GAMEMODE_SUCCESS_SELF, BEDROCK_COMMANDS_GAMEMODE_SUCCESS_SELF, [comp]))
        else:
          var feedback = false
          if server != nil and server.sendCommandFeedback != nil:
            feedback = server.sendCommandFeedback()
          if feedback and closureSet(target.sendSystemMessage):
            target.sendSystemMessage(translateCross(JAVA_GAMEMODE_CHANGED, BEDROCK_GAMEMODE_CHANGED, [comp]))
          sendMessage(sender, translateCross(JAVA_COMMANDS_GAMEMODE_SUCCESS_OTHER, BEDROCK_COMMANDS_GAMEMODE_SUCCESS_OTHER,
            [target.entity.getDisplayName(), comp]))
    cmdSuccess(succeeded)

proc isPlayerPredicate(sender: CommandSender): bool = isPlayer(sender)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(then(argument(ArgGamemode, newGamemodeArgumentConsumer()),
    execute(require(isPlayerPredicate), targetExecutor(true))),
    execute(argument(ArgTarget, newPlayersArgumentConsumer()), targetExecutor(false))))
