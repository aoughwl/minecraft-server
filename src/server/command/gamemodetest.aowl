## `/gamemode`: self form, named target, numeric ids, and a console with no target.
import std/[assertions, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/[gamemode as gm, vector2, vector3, uuid]
import ../../util/text/[textbase, text]
import gamemode, cmdtestutil

proc newPlayer(name: string; mode: ptr GameMode): CommandPlayer =
  let entity = CommandEntity(entityTypeName: "player",
    getDisplayName: proc(): TextComponent {.closure.} = text(name),
    getName: proc(): TextComponent {.closure.} = text(name))
  CommandPlayer(entity: entity, gameProfile: CmdGameProfile(name: name),
    setGameMode: proc(m: GameMode): bool {.closure.} =
      if mode[] == m:
        return false
      mode[] = m
      true,
    sendSystemMessage: proc(m: TextComponent) {.closure.} = discard)

proc block0() =
  let d = newFallbackDispatcher()
  register(d, gamemode.initCommandTree(), "minecraft:command.gamemode")
  var mode = Survival
  let player = newPlayer("alice", addr mode)
  player.hasPermission = proc(node: string): bool {.closure.} = true
  let server = newServer()
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "alice":
      return player
    nil
  let selves = @[player]
  server.selectPlayers = proc(s: TargetSelector; sender: CommandSender): seq[CommandPlayer] {.closure.} =
    if s.selectorType == estNamedPlayer and s.name == "alice":
      return selves
    @[]
  let r = dispatch(d, senderPlayer(player), server, "gamemode creative")
  assert r.isOk
  assert mode == Creative
  assert dispatch(d, senderConsole(), server, "gamemode 2 alice").isOk
  assert mode == Adventure
  # The console has no self form, so the only fitting path needs a target.
  assert not dispatch(d, senderConsole(), server, "gamemode survival").isOk
  assert mode == Adventure

block0()
echo "gamemode command tests: all checks passed"
