## The `/gamerule` command.
## Port of pumpkin/src/command/commands/gamerule.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/game_rules

const
  Names = ["gamerule"]
  Description = "Sets or queries a game rule value."
  ArgName = "value"

proc ruleValue(server: nil CommandServer; rule: GameRule): CmdGameRuleValue =
  if server != nil and server.getGameRule != nil:
    return server.getGameRule(gameRuleName(rule))
  case gameRuleKind(rule)
  of grkInt: CmdGameRuleValue(isInt: true, intValue: defaultInt(rule))
  of grkBool: CmdGameRuleValue(isInt: false, boolValue: defaultBool(rule))

proc queryExecutor(rule: GameRule): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let v = ruleValue(server, rule)
    let i32Value = if v.isInt: clampI32(v.intValue) elif v.boolValue: 1'i32 else: 0'i32
    let shownValue = if v.isInt: $v.intValue else: $v.boolValue
    sendMessage(sender, tc("commands.gamerule.query", [text(gameRuleName(rule)), text(shownValue)]))
    cmdSuccess(i32Value)

proc setExecutor(rule: GameRule): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let current = ruleValue(server, rule)
    var next = current
    var output = ""
    var res = 0'i32
    if current.isInt:
      var arg = 0'i64
      let r = requireI64(args, ArgName, arg)
      if not r.isOk:
        return r
      next.intValue = arg
      output = $arg
      res = clampI32(arg)
    else:
      var arg = false
      if not findBool(args, ArgName, arg):
        return missing(ArgName)
      next.boolValue = arg
      output = $arg
      res = if arg: 1'i32 else: 0'i32
    if server != nil and server.setGameRule != nil:
      server.setGameRule(gameRuleName(rule), next)
    sendMessage(sender, tc("commands.gamerule.set", [text(gameRuleName(rule)), text(output)]))
    cmdSuccess(res)

proc initCommandTree*(): CommandTree =
  var t = newCommandTree(Names, Description)
  let rules = allGameRules()
  for rule in rules:
    let arg =
      case gameRuleKind(rule)
      of grkInt: argument(ArgName, newBoundedI64(ArgName))
      of grkBool: argument(ArgName, newBoolArgConsumer())
    t = then(t, then(execute(literal(gameRuleName(rule)), queryExecutor(rule)), execute(arg, setExecutor(rule))))
  t
