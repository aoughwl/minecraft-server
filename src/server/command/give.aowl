## The `/give` command.
## Port of pumpkin/src/command/commands/give.rs
## `item.translated_name()` is `item.minecraft.<key>`, or the block's key for an item that is a block's, as
## src/data/data_component_impl/item_decode.aowl has it; the owner of the world code can pass a richer name in a later
## change, this keeps the message's shape.

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/[item, blockdata]
import args_resource

const
  Names = ["give"]
  Description = "Give items to player(s)."
  ArgItem = "item"
  ArgCount = "count"

proc itemCountConsumer(): ArgumentConsumer = newBoundedI32(ArgCount, some(1'i32), some(int32.high))

proc translatedName(i: Item): TextComponent =
  let (isBlock, b) = blockByName(i.name)
  if isBlock and b.itemId == i.id:
    tc(b.translationKey)
  else:
    tc("item.minecraft." & i.name)

proc itemLabel(i: Item; itemName: string; count: int32): TextComponent =
  hoverEvent(addChild(addChild(text("["), translatedName(i)), text("]")), showItem(itemName, some(min(count, 99'i32))))

proc giveExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, newPlayersArgumentConsumer().defaultName, targets):
    return missing("target")
  var itemName = ""
  var parsed = CmdItemStack()
  var item0 = Item()
  let f = findItem(args, ArgItem, itemName, parsed, item0)
  if not f.isOk:
    return f
  var itemCount = 1'i32
  var a = Arg()
  if findNum(args, ArgCount, a):
    if not a.numInBounds:
      if a.numOverflowLow:
        return cmdFailed(text("Can't give less than " & $a.numBound & " of " & itemName))
      return cmdFailed(text("Can't give more than " & $a.numBound & " of " & itemName))
    itemCount = a.num.i32
  let maxStack = int32(item0.maxStackSize)
  for target in targets:
    var remaining = itemCount
    while remaining > 0'i32:
      let take = min(remaining, maxStack)
      var stack = parsed
      stack.count = take
      if closureSet(target.insertOrDropStack):
        target.insertOrDropStack(stack)
      remaining -= take
  let msg =
    if targets.len == 1:
      tc2(JAVA_COMMANDS_GIVE_SUCCESS_SINGLE, BEDROCK_COMMANDS_GIVE_SUCCESS, [text($itemCount), itemLabel(item0, itemName, itemCount), shown(targets[0])])
    else:
      tc2(JAVA_COMMANDS_GIVE_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_GIVE_SUCCESS, [text($itemCount), itemLabel(item0, itemName, itemCount), text($targets.len)])
  sendMessage(sender, msg)
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(argumentDefaultName(newPlayersArgumentConsumer()),
    then(execute(argument(ArgItem, newItemArgumentConsumer()), giveExecutor),
      execute(argumentDefaultName(itemCountConsumer()), giveExecutor))))
