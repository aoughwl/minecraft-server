## The `/help` command (aliases `/h` and `/?`).
## Port of pumpkin/src/command/commands/help.rs
##
## Upstream reads `server.command_dispatcher` while it runs; here `register` closes over the dispatcher it is
## registered on, which is the same object (a reloaded dispatcher registers `help` again).

import std/[options]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, string_reader, cmddispatch]
import ../../protocol/java/client/play/commands
import ../../util/permission
import ../../util/text/[textbase, text, color, click]
import ../../generated/translation

const
  Description = "Print a help message."
  Permission0 = "minecraft:command.help"
  Arg = "commandOrPage"
  CommandsPerPage = 7

type
  HelpArgument* = object
    ## `HelpArgument`: `CommandOrPlugin(String)` or `Page(usize)`.
    isPage*: bool
    page*: int
    input*: string

  HelpArgValue = ref object of ArgValue
    value: HelpArgument

proc noCommandsError(): CommandErrorType = literalErrorType("No commands are available to show help for")
proc failedError(): CommandErrorType = errorType0(JAVA_COMMANDS_HELP_FAILED, JAVA_COMMANDS_HELP_FAILED)
proc pluginNotFoundError(): CommandErrorType = literalErrorType("Plugin not found or has no commands")

proc isDigits(s: string): bool =
  if s.len == 0:
    return false
  for c in s:
    if c < '0' or c > '9':
      return false
  true

proc parseHelpArgument*(reader: var StringReader): CmdResult[HelpArgument] =
  ## `HelpArgumentType::parse`.
  let readerStart = cursor(reader)
  let integer = readInt(reader)
  if integer.isOk:
    if integer.value < 1:
      setCursor(reader, readerStart)
      return cmdFail[HelpArgument](create(integerTooLow(), reader, text("1"), text($integer.value)))
    return cmdOk[HelpArgument](HelpArgument(isPage: true, page: int(integer.value)))
  # Greedily parse the remaining text; this can never fail.
  var input = remainingPart(reader)
  setCursor(reader, totalLength(reader))
  var integerText = input
  if integerText.len > 0 and integerText[0] == '-':
    integerText = integerText[1 ..< integerText.len]
  if isDigits(integerText):
    # The number was too large/small to be parsed into an i32: act like it was parsed as an integer.
    setCursor(reader, readerStart)
    return cmdFail[HelpArgument](integer.error)
  if input.len > 0 and input[0] == '/':
    input = input[1 ..< input.len]
  cmdOk[HelpArgument](HelpArgument(isPage: false, input: input))

proc newHelpArgumentType(): AnyArgumentType =
  AnyArgumentType(clientParser: JavaClientArgumentType(kind: atString, behavior: spGreedyPhrase),
    overrideSuggestion: none[SuggestionProviders](), examples: @[],
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let v = parseHelpArgument(r)
      if not v.isOk:
        return cmdFail[ArgValue](v.error)
      let a: ArgValue = HelpArgValue(value: v.value)
      cmdOk[ArgValue](a))

proc repeatStr(s: string; n: int): string =
  result = ""
  var i = 0
  while i < n:
    result.add(s)
    inc i

proc saturatingSub(a, b: int): int = (if a > b: a - b else: 0)

proc pageArrow(page: int; arrow: string): TextComponent =
  ## `create_help_command_with_given_page_number`.
  clickEvent(colorNamed(text(arrow), ncAqua), runCommand("/help " & $page))

proc entryLine(entry: CommandUsage): TextComponent =
  ## One `(command, (description, usage))` row of a page or a plugin list.
  let declaration = "/" & entry.name
  var line = colorNamed(text(declaration), ncGold)
  line = addChild(line, colorNamed(text(" - "), ncYellow))
  line = addChild(line, colorNamed(text(entry.description & "\n"), ncWhite))
  line = addChild(line, colorNamed(text("    Usage: "), ncYellow))
  line = addChild(line, colorNamed(text(entry.usage), ncWhite))
  line = addChild(line, colorNamed(text("\n"), ncWhite))
  clickEvent(line, suggestCommand(declaration))

proc dashesLine(dashes: int; trailing: string): TextComponent =
  colorNamed(text(" " & repeatStr("-", dashes) & trailing), ncYellow)

proc pageExecutor(dispatcher: CommandDispatcher; context: CommandContext; pageNumber: int): CmdResult[int32] =
  let commands = getAllPermittedCommandsUsage(dispatcher, context.source)
  let available = commands.len
  if available == 0:
    return cmdFail[int32](createWithoutContext(noCommandsError()))
  let totalPages = (available + CommandsPerPage - 1) div CommandsPerPage
  let page = min(pageNumber, totalPages)
  let start = (page - 1) * CommandsPerPage
  let finish = min(start + CommandsPerPage, available)
  let arrowLeft = if page > 1: pageArrow(page - 1, "<<<") else: colorNamed(text("<<<"), ncGray)
  let arrowRight = if page < totalPages: pageArrow(page + 1, ">>>") else: colorNamed(text(">>>"), ncGray)
  let headerText = " Help - Page " & $page & "/" & $totalPages & " "
  let dashes = saturatingSub(52, headerText.len + 3) div 2
  var message = empty()
  message = addChild(message, colorNamed(text(repeatStr("-", dashes) & " "), ncYellow))
  message = addChild(message, arrowLeft)
  message = addChild(message, text(headerText))
  message = addChild(message, arrowRight)
  message = addChild(message, dashesLine(dashes, "\n"))
  var i = start
  while i < finish:
    message = addChild(message, entryLine(commands[i]))
    inc i
  let footerText = " Page " & $page & "/" & $totalPages & " "
  message = addChild(message, colorNamed(text(repeatStr("-", dashes) & " "), ncYellow))
  message = addChild(message, arrowLeft)
  message = addChild(message, text(footerText))
  message = addChild(message, arrowRight)
  message = addChild(message, dashesLine(dashes, ""))
  sendMessage(context.source, message)
  cmdOk[int32](int32(available))

proc commandExecutor(dispatcher: CommandDispatcher; context: CommandContext; command: string): CmdResult[int32] =
  var usage = CommandUsage()
  if not getPermittedCommandUsage(dispatcher, context.source, command, usage):
    return cmdFail[int32](createWithoutContext(failedError()))
  let withSlash = "/" & command
  let headerText = " Help - /" & command & " "
  let dashes = saturatingSub(52, headerText.len) div 2
  var message = empty()
  message = addChild(message, colorNamed(text(repeatStr("-", dashes) & " "), ncYellow))
  message = addChild(message, text(headerText))
  message = addChild(message, dashesLine(dashes, "\n"))
  var commandLine = colorNamed(text("Command: "), ncAqua)
  commandLine = addChild(commandLine, bold(colorNamed(text(withSlash), ncGold)))
  commandLine = addChild(commandLine, colorNamed(text("\n"), ncWhite))
  commandLine = clickEvent(commandLine, suggestCommand(withSlash))
  message = addChild(message, commandLine)
  var descriptionLine = colorNamed(text("Description: "), ncAqua)
  descriptionLine = addChild(descriptionLine, colorNamed(text(usage.description & "\n"), ncWhite))
  message = addChild(message, descriptionLine)
  var usageLine = colorNamed(text("Usage: "), ncAqua)
  usageLine = addChild(usageLine, colorNamed(text(usage.usage & "\n"), ncWhite))
  usageLine = clickEvent(usageLine, suggestCommand(withSlash))
  message = addChild(message, usageLine)
  message = addChild(message, colorNamed(text(repeatStr("-", 52)), ncYellow))
  sendMessage(context.source, message)
  cmdOk[int32](1'i32)

proc pluginExecutor(dispatcher: CommandDispatcher; context: CommandContext; pluginName: string): CmdResult[int32] =
  let commands = getAllPermittedCommandsUsageByPlugin(dispatcher, context.source, pluginName)
  if commands.len == 0:
    return cmdFail[int32](createWithoutContext(pluginNotFoundError()))
  let headerText = " Help - Plugin: " & pluginName & " "
  let dashes = saturatingSub(52, headerText.len + 3) div 2
  var message = empty()
  message = addChild(message, colorNamed(text(repeatStr("-", dashes) & " "), ncYellow))
  message = addChild(message, text(headerText))
  message = addChild(message, dashesLine(dashes, "\n"))
  for entry in commands:
    message = addChild(message, entryLine(entry))
  message = addChild(message, colorNamed(text(repeatStr("-", 52)), ncYellow))
  sendMessage(context.source, message)
  cmdOk[int32](int32(commands.len))

proc commandOrPlugin(dispatcher: CommandDispatcher; context: CommandContext; input: string): CmdResult[int32] =
  # Prioritize commands.
  var usage = CommandUsage()
  if getPermittedCommandUsage(dispatcher, context.source, input, usage):
    return commandExecutor(dispatcher, context, input)
  if getAllPermittedCommandsUsageByPlugin(dispatcher, context.source, input).len != 0:
    return pluginExecutor(dispatcher, context, input)
  cmdFail[int32](createWithoutContext(failedError()))

proc helpExecutor(dispatcher: CommandDispatcher): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    var found = false
    let v = argumentOf(context, Arg, found)
    # `unwrap_or(&HelpArgument::Page(1))`.
    if not found or not (v of HelpArgValue):
      return pageExecutor(dispatcher, context, 1)
    let arg = HelpArgValue(v).value
    if arg.isPage:
      pageExecutor(dispatcher, context, arg.page)
    else:
      commandOrPlugin(dispatcher, context, arg.input)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionAllow()))
  let executor = helpExecutor(dispatcher)
  let root = executes(then(requires(command("help", Description), Permission0),
    executes(argument(Arg, newHelpArgumentType()), executor)), executor)
  discard registerWithAliases(dispatcher, root, ["h", "?"])
