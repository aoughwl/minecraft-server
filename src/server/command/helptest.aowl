## `/help` run through a real dispatcher: pages, one command, a plugin and the failures.
import std/[options, strutils, syncio]
import ../../command/[argument_builder, cmddispatch, cmderrors, cmdsource, cmdtree, fallbackdispatch]
import ../../util/[permission, vector2, vector3]
import ../../util/text/[textbase, text]
import help, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  let registry = newPermissionRegistry()
  let server = newServer()
  let d = newCommandDispatcher()
  help.register(d, registry)
  let noop: CommandExecutor = proc(context: CommandContext): CmdResult[int32] {.closure.} = cmdOk[int32](1'i32)
  var n = 0
  while n < 9:
    discard register(d, executes(command("cmd" & $n, "Command number " & $n), noop))
    inc n
  var plugTree = newCommandTree(["plugcmd"], "From a plugin")
  plugTree.source = some("myplugin")
  register(d.fallbackDispatcher, plugTree, "pumpkin:command.plugcmd")
  var buffer = RconBuffer(lines: @[])
  let source = newCommandSource(senderRcon(buffer), nil, nil, Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    Vector2[float32](x: 0.0'f32, y: 0.0'f32), "Rcon", text("Rcon"), server)
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)

  # 9 commands + help (+ its aliases h and ?) + plugcmd: 13 entries, 7 per page.
  let page1 = run("help")
  check(page1.isOk and page1.value == 13'i32, "help counts every command the source may use")
  check(buffer.lines.len == 1 and buffer.lines[0].contains("Help - Page 1/2"), "page 1 of 2")
  check(buffer.lines[0].contains("/cmd0 - Command number 0"), "an entry with its description")
  check(not buffer.lines[0].contains("/cmd7"), "page 1 stops at seven entries")
  let page2 = run("help 2")
  check(page2.isOk and buffer.lines[1].contains("Help - Page 2/2"), "page 2")
  check(buffer.lines[1].contains("/plugcmd"), "the last entry is on page 2")
  # A page past the end is clamped, as `page_number.min(total_pages)`.
  check(run("help 99").isOk and buffer.lines[2].contains("Page 2/2"), "page clamped")
  check(not run("help 0").isOk, "page 0 is below the minimum")
  check(run("h").isOk and run("?").isOk, "aliases")
  # One command, with or without the slash.
  let one = run("help cmd3")
  check(one.isOk and one.value == 1'i32, "one command")
  check(buffer.lines[^1].contains("Command: /cmd3") and buffer.lines[^1].contains("Description: Command number 3"), "its details")
  check(run("help /cmd4").isOk, "leading slash")
  check(not run("help nothing").isOk, "unknown command fails")
  # A plugin lists its commands.
  let plug = run("help myplugin")
  check(plug.isOk and plug.value == 1'i32, "plugin")
  check(buffer.lines[^1].contains("Help - Plugin: myplugin") and buffer.lines[^1].contains("/plugcmd"), "plugin header")

main()
echo "help command tests: all checks passed"
