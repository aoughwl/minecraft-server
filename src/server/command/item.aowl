## The `/item` command.
## Port of pumpkin/src/command/commands/item.rs
## Upstream's tree has `replace` only: there is no `modify` in the pinned tree, so none is ported.
## The block-entity target reads `getBlockContainer`, which commandbridge.aowl backs with the block entity's inventory (run over the wire: `/item replace block` into a barrel, tools/mcbot.py --containers).

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/[item, blockdata]
import args_resource

const
  Names = ["item"]
  Description = "Modifies items in block or entity inventories."
  ArgPos = "pos"
  ArgSlot = "slot"
  ArgItem = "item"
  ArgTargets = "targets"
  ArgCount = "count"

proc countConsumer(): ArgumentConsumer = newBoundedI32(ArgCount, some(1'i32), some(99'i32))

proc translatedName(i: Item): TextComponent =
  let (isBlock, b) = blockByName(i.name)
  if isBlock and b.itemId == i.id:
    tc(b.translationKey)
  else:
    tc("item.minecraft." & i.name)

proc itemLabel(i: Item; itemName: string; count: int32): TextComponent =
  hoverEvent(addChild(addChild(text("["), translatedName(i)), text("]")), showItem(itemName, some(count)))

proc countOf(args: ConsumedArgs): int32 =
  ## `Ok(Ok(c)) => c`, anything else is 1.
  var a = Arg()
  if findNum(args, ArgCount, a) and a.numInBounds:
    return a.num.i32
  1'i32

proc blockReplaceExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil:
    return cmdInvalidRequirement()
  let world = worldOrFirst(sender, server)
  if world == nil:
    return cmdInvalidRequirement()
  var posV = BlockPos()
  let loaded = findLoadedBlockPos(args, ArgPos, world, posV)
  if not loaded.isOk:
    return loaded
  var slotArg = Arg()
  if not findArg(args, ArgSlot, slotArg) or slotArg.kind != akSlot:
    return missing(ArgSlot)
  var itemName = ""
  var parsed = CmdItemStack()
  var item0 = Item()
  let f = findItem(args, ArgItem, itemName, parsed, item0)
  if not f.isOk:
    return f
  let count = countOf(args)
  let p = posV.vec
  let notContainer = tc2(JAVA_COMMANDS_ITEM_TARGET_NOT_A_CONTAINER, JAVA_COMMANDS_ITEM_TARGET_NOT_A_CONTAINER,
    [text($p.x), text($p.y), text($p.z)])
  if world.getBlockContainer == nil:
    return cmdFailed(notContainer)
  let slots = world.getBlockContainer(p.x, p.y, p.z)
  if slots.len == 0:
    return cmdFailed(notContainer)
  if slotArg.slot >= slots.len:
    return cmdFailed(tc2(JAVA_COMMANDS_ITEM_TARGET_NO_SUCH_SLOT, JAVA_COMMANDS_ITEM_TARGET_NO_SUCH_SLOT, [text(slotArg.str)]))
  var stack = parsed
  stack.count = count
  slots[slotArg.slot].setStack(stack)
  sendMessage(sender, tc2(JAVA_COMMANDS_ITEM_BLOCK_SET_SUCCESS, JAVA_COMMANDS_ITEM_BLOCK_SET_SUCCESS,
    [text($p.x), text($p.y), text($p.z), itemLabel(item0, itemName, count)]))
  cmdSuccess(1'i32)

proc equipmentNameOf(slot: int): string =
  ## The living-entity branch's `mojang_slot` map; empty for none.
  case slot
  of 98: "mainhand"
  of 99: "offhand"
  of 100: "feet"
  of 101: "legs"
  of 102: "chest"
  of 103: "head"
  of 105: "body"
  of 106: "saddle"
  else: ""

proc playerEquipmentName(slot, selected: int): string =
  ## The `eq_slot` choice after the player's slot was mapped.
  if slot == 36: "feet"
  elif slot == 37: "legs"
  elif slot == 38: "chest"
  elif slot == 39: "head"
  elif slot == 40: "offhand"
  elif slot == selected: "mainhand"
  else: ""

proc entityReplaceExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, newEntitiesArgumentConsumer().defaultName, targets):
    return missing("targets")
  var slotArg = Arg()
  if not findArg(args, ArgSlot, slotArg) or slotArg.kind != akSlot:
    return missing(ArgSlot)
  let mojangSlot = slotArg.slot
  var itemName = ""
  var parsed = CmdItemStack()
  var item0 = Item()
  let f = findItem(args, ArgItem, itemName, parsed, item0)
  if not f.isOk:
    return f
  let count = countOf(args)
  var stack = parsed
  stack.count = count
  var modified = 0'i32
  for target in targets:
    let player = target.player
    if player != nil:
      if mojangSlot >= 200 and mojangSlot <= 226:
        let enderSlot = mojangSlot - 200
        if player.getEnderChestSlots != nil:
          let ender = player.getEnderChestSlots()
          if enderSlot < ender.len:
            ender[enderSlot].setStack(stack)
            inc modified
      else:
        var selected = 0
        if player.getSelectedSlot != nil:
          selected = int(player.getSelectedSlot())
        var mapped = -1
        if mojangSlot == 98: mapped = selected
        elif mojangSlot == 99: mapped = 40
        elif mojangSlot == 100: mapped = 36
        elif mojangSlot == 101: mapped = 37
        elif mojangSlot == 102: mapped = 38
        elif mojangSlot == 103: mapped = 39
        elif mojangSlot <= 35: mapped = mojangSlot
        let slots = if player.getInventorySlots != nil: player.getInventorySlots() else: @[]
        if mapped >= 0 and mapped < slots.len:
          slots[mapped].setStack(stack)
          let eq = playerEquipmentName(mapped, selected)
          if eq.len > 0 and player.sendEquipmentChange != nil:
            player.sendEquipmentChange(eq, stack)
          inc modified
    elif target.setEquipment != nil:
      let eq = equipmentNameOf(mojangSlot)
      if eq.len > 0 and target.setEquipment(eq, stack):
        inc modified
  if modified == 0'i32:
    return cmdFailed(tc2(JAVA_COMMANDS_ITEM_TARGET_NO_SUCH_SLOT, JAVA_COMMANDS_ITEM_TARGET_NO_SUCH_SLOT, [text(slotArg.str)]))
  let label = itemLabel(item0, itemName, count)
  let msg =
    if targets.len == 1:
      tc2(JAVA_COMMANDS_ITEM_ENTITY_SET_SUCCESS_SINGLE, JAVA_COMMANDS_ITEM_ENTITY_SET_SUCCESS_SINGLE, [shown(targets[0]), label])
    else:
      tc2(JAVA_COMMANDS_ITEM_ENTITY_SET_SUCCESS_MULTIPLE, JAVA_COMMANDS_ITEM_ENTITY_SET_SUCCESS_MULTIPLE, [text($modified), label])
  sendMessage(sender, msg)
  cmdSuccess(modified)

proc itemNode(exec: FallbackExecutor): NonLeafNodeBuilder =
  let withCount = proc(): NonLeafNodeBuilder {.closure.} =
    then(execute(argument(ArgItem, newItemArgumentConsumer()), exec), execute(argumentDefaultName(countConsumer()), exec))
  then(then(argument(ArgSlot, newSlotArgumentConsumer()), withCount()), then(literal("with"), withCount()))

proc initCommandTree*(): CommandTree =
  # `ARG_SLOT` takes the item directly, or after `with`.
  let blockN = then(literal("block"), then(argument(ArgPos, newBlockPosArgumentConsumer()), itemNode(blockReplaceExecutor)))
  let entityN = then(literal("entity"), then(argument(ArgTargets, newEntitiesArgumentConsumer()), itemNode(entityReplaceExecutor)))
  then(newCommandTree(Names, Description), then(then(literal("replace"), blockN), entityN))
