## The `/kick` command.
## Port of pumpkin/src/command/commands/kick.rs

import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["kick"]
  Description = "Kicks the target player from the server."
  ArgTargets = "targets"
  ArgReason = "reason"

proc kickExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return cmdInvalidConsumption(some(ArgTargets))
  var customReason = ""
  let hasReason = findMsg(args, ArgReason, customReason)
  let reason = if hasReason: text(customReason)
    else: translateCross(JAVA_MULTIPLAYER_DISCONNECT_KICKED, JAVA_MULTIPLAYER_DISCONNECT_KICKED)
  for target in targets:
    if target.kick != nil:
      target.kick(reason)
    let bedrockKey = if hasReason: BEDROCK_COMMANDS_KICK_SUCCESS_REASON else: BEDROCK_COMMANDS_KICK_SUCCESS
    sendMessage(sender, colorNamed(translateCross(JAVA_COMMANDS_KICK_SUCCESS, bedrockKey,
      [target.entity.getDisplayName(), reason]), ncBlue))
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(execute(argument(ArgTargets, newPlayersArgumentConsumer()), kickExecutor),
    execute(argument(ArgReason, newMsgArgConsumer()), kickExecutor)))
