## The `/kill` command.
## Port of pumpkin/src/command/commands/kill.rs

import ../../util/closureset
import ../../command/entity_selector
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Kills all target entities."
  Permission0 = "minecraft:command.kill"
  ArgTargets = "targets"

proc killEntity(target: CommandEntity) =
  if closureSet(target.kill):
    target.kill()

proc targetsExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getEntities(context, ArgTargets)
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let list = targets.value
  for target in list:
    killEntity(target)
  let msg =
    if list.len == 1:
      translateCross(JAVA_COMMANDS_KILL_SUCCESS_SINGLE, BEDROCK_COMMANDS_KILL_SUCCESSFUL, [list[0].getDisplayName()])
    else:
      translateCross(JAVA_COMMANDS_KILL_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_KILL_SUCCESSFUL, [text($list.len)])
  sendFeedback(context.source, msg, true)
  cmdOk[int32](int32(list.len))

proc selfExecutor(context: CommandContext): CmdResult[int32] =
  let target = entityOrErr(context.source)
  if not target.isOk:
    return cmdFail[int32](target.error)
  killEntity(target.value)
  sendFeedback(context.source, translateCross(JAVA_COMMANDS_KILL_SUCCESS_SINGLE, BEDROCK_COMMANDS_KILL_SUCCESSFUL,
    [target.value.getDisplayName()]), true)
  cmdOk[int32](1'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))
  discard register(dispatcher, executes(then(requires(command("kill", Description), Permission0),
    executes(argument(ArgTargets, newEntityArgumentType(eakEntities)), targetsExecutor)), selfExecutor))
