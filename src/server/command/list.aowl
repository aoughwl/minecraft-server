## The `/list` command.
## Port of pumpkin/src/command/commands/list.rs

import ../../util/closureset
import ../../util/uuid
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Print the list of online players."
  Permission0 = "minecraft:command.list"

proc displayNames(players: seq[CommandPlayer]): TextComponent =
  var names: seq[TextComponent] = @[]
  for p in players:
    names.add(p.entity.getDisplayName())
  joinWithComma(names)

proc namesAndIds(players: seq[CommandPlayer]): TextComponent =
  var entries: seq[TextComponent] = @[]
  for p in players:
    entries.add(translateCross(JAVA_COMMANDS_LIST_NAMEANDID, JAVA_COMMANDS_LIST_NAMEANDID,
      [p.entity.getName(), text($p.gameProfile.id)]))
  joinWithComma(entries)

proc listExecute(context: CommandContext; uuids: bool): CmdResult[int32] =
  let server = context.source.server
  var players: seq[CommandPlayer] = @[]
  var maxPlayers = 0'i32
  if server != nil:
    if closureSet(server.getAllPlayers):
      players = server.getAllPlayers()
    # A Bedrock sender sees the Bedrock limit; everyone else, the console included, the Java one.
    let output = context.source.output
    if output.kind == cskPlayer and output.player.isBedrock:
      if closureSet(server.bedrockMaxPlayers):
        maxPlayers = server.bedrockMaxPlayers()
    elif closureSet(server.javaMaxPlayers):
      maxPlayers = server.javaMaxPlayers()
  let list = if uuids: namesAndIds(players) else: displayNames(players)
  sendFeedback(context.source, translateCross(JAVA_COMMANDS_LIST_PLAYERS, JAVA_COMMANDS_LIST_PLAYERS,
    [text($players.len), text($maxPlayers), list]), false)
  cmdOk[int32](int32(players.len))

proc namesExecutor(context: CommandContext): CmdResult[int32] = listExecute(context, false)
proc uuidsExecutor(context: CommandContext): CmdResult[int32] = listExecute(context, true)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionAllow()))
  discard register(dispatcher, executes(then(requires(command("list", Description), Permission0),
    executes(literal("uuids"), uuidsExecutor)), namesExecutor))
