## The `/loot` command.
## Port of pumpkin/src/command/commands/loot.rs
## The loot itself comes from src/server/world/loot.aowl through `CommandServer.generateChestLoot`,
## `CommandWorld.generateBlockLoot` and `CommandEntity.getLootDrops`, which the bridge backs; `insert` fills the slots
## `CommandWorld.getBlockContainer` returns (backed by commandbridge.aowl with the block entity's inventory); `spawn` needs
## `CommandWorld.dropStack`, which commandbridge.aowl does not fill yet (the block world's `dropStack0` hook, worldhooks.aowl, is what to call).
## PARTIAL: pumpkin/src/command/commands/loot.rs - `spawn` drops through `CommandWorld.dropStack`, which the live bridge (src/server/commandbridge.aowl) does not set; `insert`, `give`, `replace` and every loot source are backed.

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch, entity_selector, coordinates]
import ../../util/[permission, vector3]
import ../../util/math/position
import ../../util/text/[textbase, text]
import ../../protocol/java/client/play/commands
import ../../generated/translation
import std/random as stdrandom

type
  Target = enum
    tGive
    tSpawn
    tInsert

  Source = enum
    sLoot
    sKill
    sMine
    sMineTool

const
  Description = "Drops the given loot table into the specified inventory or into the world."
  Permission0 = "minecraft:command.loot"

proc invalidLootTable(): CommandErrorType =
  errorType1(BEDROCK_COMMANDS_LOOT_FAILURE_INVALIDLOOTTABLE, "Loot table '%s' not found")

proc entityNoLootTable(): CommandErrorType =
  errorType1(BEDROCK_COMMANDS_LOOT_FAILURE_ENTITYNOLOOTTABLE, "Entity %s has no loot table")

proc noContainer(): CommandErrorType =
  errorType1(BEDROCK_COMMANDS_LOOT_FAILURE_NOCONTAINER, "Target position %s is not a container")

proc maxStackOf(stack: CmdItemStack): int32 = 64'i32 ## Upstream's `insert_into_inventory` assumes 64.

proc insertIntoInventory(slots: seq[CmdItemSlot]; stack0: CmdItemStack): CmdItemStack =
  ## `insert_into_inventory`: top up matching stacks first, then take the first empty slot. Returns what is left.
  var stack = stack0
  for i in 0 ..< slots.len:
    if stack.count <= 0'i32:
      break
    let slotStack = slots[i].getStack()
    if slotStack.itemKey.len > 0 and slotStack.count > 0'i32 and slotStack.itemKey == stack.itemKey:
      let space = 64'i32 - slotStack.count
      if space > 0'i32:
        let toAdd = min(stack.count, space)
        var updated = slotStack
        updated.count = slotStack.count + toAdd
        slots[i].setStack(updated)
        stack.count -= toAdd
  for i in 0 ..< slots.len:
    if stack.count <= 0'i32:
      break
    let slotStack = slots[i].getStack()
    if slotStack.itemKey.len == 0 or slotStack.count <= 0'i32:
      slots[i].setStack(stack)
      stack.count = 0'i32
      break
  stack

proc runLoot(target: Target; source: Source; context: CommandContext): CmdResult[int32] =
  var stacks: seq[CmdItemStack] = @[]
  let world = context.source.world
  case source
  of sLoot:
    # Upstream reads a `SingleWord` string, which cannot hold the `/` of `chests/simple_dungeon`; an identifier can.
    let tableId = getIdentifier(context, "loot_table")
    if not tableId.isOk:
      return cmdFail[int32](tableId.error)
    let formattedKey = $tableId.value
    let tableText = formattedKey
    var found = false
    let server = context.source.server
    if server != nil and closureSet(server.generateChestLoot):
      stacks = server.generateChestLoot(formattedKey, rand(int64.high), found)
    if not found:
      return cmdFail[int32](createWithoutContext(invalidLootTable(), text(tableText)))
  of sKill:
    let entities = getEntities(context, "target_entity")
    if not entities.isOk:
      return cmdFail[int32](entities.error)
    var hasLoot = false
    let entityList = entities.value
    for ei in 0 ..< entityList.len:
      let entity = entityList[ei]
      if closureSet(entity.getLootDrops):
        var found = false
        let drops = entity.getLootDrops(found)
        if found:
          hasLoot = true
          for di in 0 ..< drops.len:
            let d = drops[di]
            stacks.add(d)
    if not hasLoot:
      return cmdFail[int32](createWithoutContext(entityNoLootTable(), text("selected entity")))
  of sMine, sMineTool:
    var pos = getBlockPos(context, "mine_pos")
    if not pos.isOk:
      pos = getBlockPos(context, "pos")
      if not pos.isOk:
        return cmdFail[int32](pos.error)
    if world != nil and closureSet(world.generateBlockLoot):
      var tool = ""
      if source == sMineTool:
        let t = getIdentifier(context, "tool")
        if not t.isOk:
          return cmdFail[int32](t.error)
        let toolText = $t.value
        tool = if toolText.startsWith("minecraft:"): toolText[10 ..< toolText.len] else: toolText
      var found = false
      let p = pos.value.vec
      stacks = world.generateBlockLoot(p.x, p.y, p.z, source == sMineTool, tool, found)
  var totalItems = 0'i32
  for si in 0 ..< stacks.len:
    totalItems += stacks[si].count
  case target
  of tGive:
    let targets = getPlayers(context, "targets")
    if not targets.isOk:
      return cmdFail[int32](targets.error)
    let targetList = targets.value
    for pi in 0 ..< targetList.len:
      let player = targetList[pi]
      for si in 0 ..< stacks.len:
        let st = stacks[si]
        if closureSet(player.insertOrDropStack):
          player.insertOrDropStack(st)
  of tSpawn:
    let pos = getBlockPos(context, "pos")
    if not pos.isOk:
      return cmdFail[int32](pos.error)
    let p = pos.value.vec
    if world != nil and closureSet(world.dropStack):
      for si in 0 ..< stacks.len:
        let st = stacks[si]
        world.dropStack(p.x, p.y, p.z, st)
  of tInsert:
    let pos = getBlockPos(context, "pos")
    if not pos.isOk:
      return cmdFail[int32](pos.error)
    let p = pos.value.vec
    var slots: seq[CmdItemSlot] = @[]
    if world != nil and closureSet(world.getBlockContainer):
      slots = world.getBlockContainer(p.x, p.y, p.z)
    if slots.len == 0:
      return cmdFail[int32](createWithoutContext(noContainer(), text($p.x & ", " & $p.y & ", " & $p.z)))
    for si in 0 ..< stacks.len:
      let st = stacks[si]
      let remaining = insertIntoInventory(slots, st)
      if remaining.count > 0'i32 and closureSet(world.dropStack):
        world.dropStack(p.x, p.y, p.z, remaining)
  sendFeedback(context.source, translateCross(BEDROCK_COMMANDS_LOOT_SUCCESS, BEDROCK_COMMANDS_LOOT_SUCCESS,
    [text($totalItems)]), true)
  cmdOk[int32](totalItems)

proc lootExecutor(target: Target; source: Source): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    runLoot(target, source, context)

proc sources(target: Target; minePos: string): seq[ArgumentBuilder] =
  ## The three sources of one target, as upstream's tree lists them.
  result = @[]
  result.add(then(literal("loot"), executes(argument("loot_table", newIdentifierArgumentType()), lootExecutor(target, sLoot))))
  result.add(then(literal("kill"), executes(argument("target_entity", newEntityArgumentType(eakEntities)), lootExecutor(target, sKill))))
  result.add(then(literal("mine"), then(executes(argument(minePos, newBlockPosArgumentType()), lootExecutor(target, sMine)),
    executes(argument("tool", newIdentifierArgumentType()), lootExecutor(target, sMineTool)))))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  var give = argument("targets", newEntityArgumentType(eakPlayers))
  for n in sources(tGive, "pos"):
    give = then(give, n)
  var spawn = argument("pos", newBlockPosArgumentType())
  for n in sources(tSpawn, "mine_pos"):
    spawn = then(spawn, n)
  var insert = argument("pos", newBlockPosArgumentType())
  for n in sources(tInsert, "mine_pos"):
    insert = then(insert, n)
  var root = requires(command("loot", Description), Permission0)
  root = then(root, then(literal("give"), give))
  root = then(root, then(literal("spawn"), spawn))
  root = then(root, then(literal("insert"), insert))
  discard register(dispatcher, root)
