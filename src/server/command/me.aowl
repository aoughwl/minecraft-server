## The `/me` command.
## Port of pumpkin/src/command/commands/me.rs

import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["me"]
  Description = "Broadcasts a narrative message about yourself."
  ArgMessage = "action"

proc meExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var msg = ""
  if not findMsg(args, ArgMessage, msg):
    return cmdInvalidConsumption(some(ArgMessage))
  if server != nil and server.broadcastEmote != nil:
    server.broadcastEmote(text(msg), text(displayText(sender)))
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgMessage, newMsgArgConsumer()), meExecutor))
