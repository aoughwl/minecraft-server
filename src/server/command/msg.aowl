## The `/msg` command.
## Port of pumpkin/src/command/commands/msg.rs

import ../../util/closureset
import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["msg", "tell", "w"]
  Description = "Sends a private message to one or more players."
  ArgMessage = "message"

proc msgExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var msg = ""
  if not findMsg(args, ArgMessage, msg):
    return cmdInvalidConsumption(some(ArgMessage))
  var targets: seq[CommandPlayer] = @[]
  let consumer = newPlayersArgumentConsumer()
  if not findPlayers(args, consumer.defaultName, targets):
    return cmdInvalidConsumption(some(consumer.defaultName))
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  let player = sender.player
  for target in targets:
    if closureSet(player.sendMsgOutgoing):
      player.sendMsgOutgoing(text(msg), player.entity.getDisplayName(), target.entity.getDisplayName())
  for target in targets:
    if closureSet(target.sendMsgIncoming):
      target.sendMsgIncoming(text(msg), player.entity.getDisplayName(), target.entity.getDisplayName())
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(argumentDefaultName(newPlayersArgumentConsumer()),
    execute(argument(ArgMessage, newMsgArgConsumer()), msgExecutor)))
