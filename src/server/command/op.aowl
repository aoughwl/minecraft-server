## The `/op` command.
## Port of pumpkin/src/command/commands/op.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector, coordinates]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../command/[game_profile, suggestion]

const
  Description = "Grants operator status to a player."
  Permission0 = "minecraft:command.op"
  ArgTargets = "targets"

proc alreadyOpErrorType*(): CommandErrorType = errorType0(JAVA_COMMANDS_OP_FAILED, BEDROCK_COMMANDS_OP_FAILED)

proc opExecutor(context: CommandContext): CmdResult[int32] =
  let server = context.source.server
  if server == nil:
    return cmdFail[int32](missingArgument("server"))
  var profiles: seq[CmdGameProfile] = @[]
  let lookup = getGameProfiles(context, ArgTargets, profiles)
  if not lookup.isOk:
    return cmdFail[int32](lookup.error)
  var successes = 0'i32
  let newLevel = server.opPermissionLevel
  for profile in profiles:
    var ops: seq[CmdListEntry] = @[]
    if closureSet(server.getOps):
      ops = server.getOps()
    var unchanged = false
    for op in ops:
      if op.id == profile.id and op.level == newLevel:
        unchanged = true
    if unchanged:
      continue
    if closureSet(server.putOp):
      server.putOp(CmdListEntry(id: profile.id, name: profile.name, level: newLevel))
    if closureSet(server.getPlayerByUuid):
      let player = server.getPlayerByUuid(profile.id)
      if player != nil and closureSet(player.setPermissionLvl):
        player.setPermissionLvl(newLevel)
    sendFeedback(context.source, tc2(JAVA_COMMANDS_OP_SUCCESS, BEDROCK_COMMANDS_OP_SUCCESS, [text(profile.name)]), true)
    inc successes
  if successes > 0'i32 and closureSet(server.saveOps):
    server.saveOps()
  if successes == 0'i32:
    return cmdFail[int32](createWithoutContext(alreadyOpErrorType()))
  cmdOk[int32](successes)

proc opSuggestions(context: CommandContext; builder0: SuggestionsBuilder): Suggestions =
  var builder = builder0
  let server = context.source.server
  if server != nil and closureSet(server.getAllPlayers):
    var ops: seq[CmdListEntry] = @[]
    if closureSet(server.getOps):
      ops = server.getOps()
    let players = server.getAllPlayers()
    for player in players:
      var isOp = false
      for op in ops:
        if op.id == player.gameProfile.id:
          isOp = true
      if not isOp:
        builder = suggest(builder, player.gameProfile.name)
  build(builder)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Three)))
  discard register(dispatcher, then(requires(command("op", Description), Permission0),
    executes(suggests(argument(ArgTargets, newGameProfileArgumentType()), opSuggestions), opExecutor)))
