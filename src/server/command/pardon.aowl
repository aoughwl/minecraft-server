## The `/pardon` command.
## Port of pumpkin/src/command/commands/pardon.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["pardon"]
  Description = "unbans a player"
  ArgTarget = "targets"

proc pardonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CmdGameProfile] = @[]
  if not findGameProfiles(args, ArgTarget, targets):
    return missing(ArgTarget)
  if server == nil:
    return cmdInvalidRequirement()
  var successes = 0'i32
  for target in targets:
    if closureSet(server.removeBannedPlayer) and server.removeBannedPlayer(target.id):
      sendMessage(sender, tc2(JAVA_COMMANDS_PARDON_SUCCESS, BEDROCK_COMMANDS_UNBAN_SUCCESS, [text(target.name)]))
      inc successes
  if successes > 0'i32:
    if closureSet(server.saveBannedPlayers):
      server.saveBannedPlayers()
    return cmdSuccess(successes)
  let errTarget = if targets.len > 0: targets[0].name else: ""
  cmdFailed(tc2(JAVA_COMMANDS_PARDON_FAILED, BEDROCK_COMMANDS_UNBAN_FAILED, [text(errTarget)]))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgTarget, newGameProfilesArgumentConsumer(gpsBannedNames, false)), pardonExecutor))
