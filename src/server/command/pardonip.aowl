## The `/pardon-ip` command.
## Port of pumpkin/src/command/commands/pardonip.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["pardon-ip"]
  Description = "unbans a ip"
  ArgTarget = "ip"

proc pardonIpExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target = ""
  if not findString(args, ArgTarget, akSimple, target):
    return missing(ArgTarget)
  if server == nil:
    return cmdInvalidRequirement()
  var ip = ""
  if server.parseIp == nil or not server.parseIp(target, ip):
    return cmdFailed(tc2(JAVA_COMMANDS_PARDONIP_INVALID, BEDROCK_COMMANDS_UNBANIP_INVALID))
  if server.removeBannedIp != nil and server.removeBannedIp(ip):
    sendMessage(sender, tc2(JAVA_COMMANDS_PARDONIP_SUCCESS, BEDROCK_COMMANDS_UNBANIP_SUCCESS, [text(ip)]))
    return cmdSuccess(1'i32)
  cmdFailed(tc(JAVA_COMMANDS_PARDONIP_FAILED))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgTarget, newSimpleArgConsumer()), pardonIpExecutor))
