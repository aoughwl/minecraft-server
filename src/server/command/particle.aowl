## The `/particle` command.
## Port of pumpkin/src/command/commands/particle.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["particle"]
  Description = "Spawns a Particle at position."
  ArgName = "name"
  ArgPos = "pos"
  ArgDelta = "delta"
  ArgSpeed = "speed"
  ArgCount = "count"

proc spawnPos(world: CommandWorld; pos: Option[Vector3[float64]]): Vector3[float64] =
  ## The spawn point plus (0.5, 1, 0.5) where upstream reads `level_info` for a sender with no position.
  if pos.isSome:
    return pos.unsafeGet
  let p = if world.getSpawnPoint != nil: world.getSpawnPoint() else: Vector3[int32](x: 0'i32, y: 0'i32, z: 0'i32)
  Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 1.0, z: float64(p.z) + 0.5)

proc particleExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var particle = ""
  if not findString(args, ArgName, akParticle, particle):
    return missing(ArgName)
  var posV = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  let posO = if findPos3D(args, ArgPos, posV): some(posV) else: none[Vector3[float64]]()
  var deltaV = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  discard findPos3D(args, ArgDelta, deltaV)
  let delta = Vector3[float32](x: float32(deltaV.x), y: float32(deltaV.y), z: float32(deltaV.z))
  var speed = 0.0'f32
  var a = Arg()
  if findNum(args, ArgSpeed, a):
    if not a.numInBounds:
      return notInBoundsError(a)
    speed = a.num.f32
  var count = 0'i32
  if findNum(args, ArgCount, a):
    if not a.numInBounds:
      return notInBoundsError(a)
    count = a.num.i32
  var world: nil CommandWorld = nil
  var pos = posV
  case sender.kind
  of cskConsole, cskRcon, cskDummy:
    let w = firstWorld(server)
    if w == nil:
      return cmdInvalidRequirement()
    pos = spawnPos(w, posO)
    world = w
  of cskPlayer:
    pos = if posO.isSome: posV else: sender.player.entity.getPos()
    world = sender.player.entity.getWorld()
  of cskCommandBlock:
    # Upstream ignores any given position for a command block.
    let p = sender.commandBlock.getPosition()
    pos = Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 0.5, z: float64(p.z) + 0.5)
    world = sender.commandBlockWorld
  if world != nil and world.spawnParticle != nil:
    world.spawnParticle(pos, delta, speed, count, particle)
  sendMessage(sender, tc2(JAVA_COMMANDS_PARTICLE_SUCCESS, BEDROCK_COMMANDS_PARTICLE_SUCCESS, [text(particle), text($count)]))
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  let countN = execute(argument(ArgCount, newBoundedI32(ArgCount, some(0'i32))), particleExecutor)
  let speedN = then(execute(argument(ArgSpeed, newBoundedF32(ArgSpeed, some(0.0'f32))), particleExecutor), countN)
  let deltaN = then(execute(argument(ArgDelta, newPosition3DArgumentConsumer()), particleExecutor), speedN)
  let posN = then(execute(argument(ArgPos, newPosition3DArgumentConsumer()), particleExecutor), deltaN)
  then(newCommandTree(Names, Description), then(execute(argument(ArgName, newParticleArgumentConsumer()), particleExecutor), posN))
