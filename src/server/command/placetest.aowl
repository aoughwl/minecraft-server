## `/place template`, `structure`, `jigsaw` and `feature` through a real dispatcher over an in-memory block world.
import std/[options, strutils, syncio, tables]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../generated/blockdata
import ../../nbt/tag
import ../../util/[permission, vector2, vector3]
import "../../world/generation/structure/template/cache"
import place, cmdtestutil

proc check(ok: bool; what: string) =
  echo "check ", what, ": ", ok
  stdout.flushFile()
  if not ok:
    echo "FAILED: ", what
    quit(1)

type Blocks = ref object
  t: Table[string, uint16]
  writes: int
  minX, minY, minZ, maxX, maxY, maxZ: int32

proc key(x, y, z: int32): string = $x & "," & $y & "," & $z

proc put(b: Blocks; x, y, z: int32; s: uint16) =
  b.t[key(x, y, z)] = s
  if s != 0'u16:
    inc b.writes
    b.minX = min(b.minX, x)
    b.minY = min(b.minY, y)
    b.minZ = min(b.minZ, z)
    b.maxX = max(b.maxX, x)
    b.maxY = max(b.maxY, y)
    b.maxZ = max(b.maxZ, z)

proc newBlocks(): Blocks =
  Blocks(t: initTable[string, uint16](), minX: int32.high, minY: int32.high, minZ: int32.high,
    maxX: int32.low, maxY: int32.low, maxZ: int32.low)

proc newWorld(b: Blocks): CommandWorld =
  result = CommandWorld(dimensionName: "minecraft:overworld")
  result.getBlockStateId = proc(x, y, z: int32): uint16 {.closure.} = b.t.getOrDefault(key(x, y, z), 0'u16)
  result.setBlockState = proc(x, y, z: int32; s: uint16; f: uint32) {.closure.} = b.put(x, y, z, s)
  result.getGenParams = proc(): CmdGenParams {.closure.} =
    CmdGenParams(seed: 1234'i64, defaultBlock: 1'u32, biomeMixerSeed: 99'i64, logicalHeight: 384'i32, minY: -64'i32, seaLevel: 63'i32)

proc run(d: CommandDispatcher; source: CommandSource; line: string): CmdResult[int32] =
  executeInput(d, line, source)

proc main() =
  let names = allTemplateNames()
  check(names.len > 100, "templates are available")
  let blocks = newBlocks()
  let world = newWorld(blocks)
  let server = newServerWithWorld(world)
  let d = newCommandDispatcher()
  place.register(d, newPermissionRegistry())
  let source = consoleSource(server, world)
  # A template: its blocks land inside its size, from the origin.
  let t = getTemplate("igloo/top")
  check(t != nil, "igloo/top loads")
  var r = run(d, source, "place template minecraft:igloo/top 100 70 100")
  check(r.isOk and r.value == 1'i32, "place template")
  check(blocks.writes > 20, "template wrote blocks")
  check(blocks.minX == 100'i32 and blocks.minZ == 100'i32 and blocks.minY >= 70'i32, "template starts at the origin")
  check(blocks.maxX < 100'i32 + t.size.x and blocks.maxY < 70'i32 + t.size.y and blocks.maxZ < 100'i32 + t.size.z, "template stays in its size")
  check(not run(d, source, "place template minecraft:no/such 0 0 0").isOk, "unknown template")
  # The block entities of a template reach the world (`WorldBlockPlacer::finalize`): the igloo's bottom has some.
  let bEnt = newBlocks()
  let wEnt = newWorld(bEnt)
  var added: seq[string] = @[]
  wEnt.addBlockEntityNbt = proc(nbt: NbtCompound): bool {.closure.} =
    let id = nbt.getString("id")
    added.add(if id.isSome: id.unsafeGet else: "?")
    check(nbt.getInt("x").isSome and nbt.getInt("y").isSome and nbt.getInt("z").isSome, "a block entity has its position")
    true
  let sEnt = consoleSource(newServerWithWorld(wEnt), wEnt)
  check(run(d, sEnt, "place template minecraft:igloo/bottom 100 70 100").isOk, "place igloo bottom")
  check(added.len > 0, "template block entities were added")
  for id in added:
    check(id.startsWith("minecraft:"), "a block entity has a namespaced id")
  # A non-jigsaw structure goes through the synthetic chunk.
  let b2 = newBlocks()
  let w2 = newWorld(b2)
  let s2 = consoleSource(newServerWithWorld(w2), w2)
  r = run(d, s2, "place structure minecraft:igloo 200 64 200")
  check(r.isOk, "place structure igloo")
  check(b2.writes > 20, "igloo wrote blocks")
  check(b2.maxX >= 200'i32 - 40'i32 and b2.minX <= 200'i32 + 40'i32, "igloo near the target")
  check(not run(d, s2, "place structure minecraft:nothing 0 0 0").isOk, "unknown structure")
  # A jigsaw structure.
  let b3 = newBlocks()
  let w3 = newWorld(b3)
  let s3 = consoleSource(newServerWithWorld(w3), w3)
  r = run(d, s3, "place structure minecraft:village_plains 300 64 300")
  check(r.isOk, "place structure village")
  check(b3.writes > 200, "village wrote blocks")
  # Jigsaw pool, and a feature.
  let b4 = newBlocks()
  let w4 = newWorld(b4)
  let s4 = consoleSource(newServerWithWorld(w4), w4)
  r = run(d, s4, "place jigsaw minecraft:village/plains/town_centers minecraft:bottom 3 400 64 400")
  check(r.isOk, "place jigsaw")
  check(b4.writes > 20, "jigsaw wrote blocks")
  let b5 = newBlocks()
  let w5 = newWorld(b5)
  let s5 = consoleSource(newServerWithWorld(w5), w5)
  r = run(d, s5, "place feature minecraft:oak_checked 500 64 500")
  check(r.isOk, "place feature")
  check(b5.writes >= 5, "feature wrote blocks")
  check(not run(d, s5, "place feature minecraft:nope 0 0 0").isOk, "unknown feature")

main()
echo "place: all checks passed"
