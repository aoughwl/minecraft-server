## The `/playsound` command.
## Port of pumpkin/src/command/commands/playsound.rs

import std/random
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/sound as soundgen

const
  Names = ["playsound"]
  Description = "Plays a sound at a position."
  ArgSound = "sound"
  ArgSource = "source"
  ArgTargets = "targets"
  ArgPos = "pos"
  ArgVolume = "volume"
  ArgPitch = "pitch"
  ArgMinVolume = "minVolume"

proc volumeConsumer(): ArgumentConsumer = newBoundedF32(ArgVolume, some(0.0'f32))
proc pitchConsumer(): ArgumentConsumer = newBoundedF32(ArgPitch, some(0.0'f32), some(2.0'f32))
proc minVolumeConsumer(): ArgumentConsumer = newBoundedF32(ArgMinVolume, some(0.0'f32), some(1.0'f32))

proc goodF32(args: ConsumedArgs; name: string; res: var float32): bool =
  ## `Ok(Ok(v))`.
  var a = Arg()
  if findNum(args, name, a) and a.numInBounds and a.num.kind == nkF32:
    res = a.num.f32
    return true
  false

proc playSoundExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var raw = ""
  if not findString(args, ArgSound, akBlock, raw):
    return missing(ArgSound)
  let bare = if raw.startsWith("minecraft:"): raw[10 ..< raw.len] else: raw
  let (ok, sound) = soundgen.fromName(bare)
  if not ok:
    return cmdFailed(text("Sound " & raw & " does not exist."))
  var source = "master"
  discard findString(args, ArgSource, akSoundCategory, source)
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets) and sender.kind == cskPlayer:
    targets = @[sender.player]
  var position0 = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  let hasPosition = findPos3D(args, ArgPos, position0)
  var volume = 1.0'f32
  discard goodF32(args, ArgVolume, volume)
  var pitch = 1.0'f32
  if goodF32(args, ArgPitch, pitch):
    # Values below 0.5 are clamped.
    pitch = max(pitch, 0.5'f32)
  var minVolume = 0.0'f32
  discard goodF32(args, ArgMinVolume, minVolume)
  let seed = rand(1.0)
  var heard = 0'i32
  for target in targets:
    let playerPos = target.entity.getPos()
    let pos = if hasPosition: position0 else: playerPos
    let distance = squaredDistanceToVec(playerPos, pos)
    let maxDistance = float64(16.0'f32 * volume) # 16 blocks is base distance at volume 1.0
    if distance <= maxDistance or minVolume > 0.0'f32:
      if target.playSound != nil:
        target.playSound(toName(sound), source, pos, volume, pitch, seed)
      inc heard
  if heard == 0'i32:
    return cmdFailed(tc(JAVA_COMMANDS_PLAYSOUND_FAILED))
  if heard == 1'i32:
    sendMessage(sender, tc2(JAVA_COMMANDS_PLAYSOUND_SUCCESS_SINGLE, BEDROCK_COMMANDS_PLAYSOUND_SUCCESS, [text(toName(sound)), shown(targets[0])]))
  else:
    sendMessage(sender, tc2(JAVA_COMMANDS_PLAYSOUND_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_PLAYSOUND_SUCCESS, [text(toName(sound)), text($heard)]))
  cmdSuccess(heard)

proc initCommandTree*(): CommandTree =
  let minV = execute(argument(ArgMinVolume, minVolumeConsumer()), playSoundExecutor)
  let pitchN = execute(then(argument(ArgPitch, pitchConsumer()), minV), playSoundExecutor)
  let volumeN = execute(then(argument(ArgVolume, volumeConsumer()), pitchN), playSoundExecutor)
  let posN = execute(then(argument(ArgPos, newPosition3DArgumentConsumer()), volumeN), playSoundExecutor)
  let targetsN = execute(then(argument(ArgTargets, newPlayersArgumentConsumer()), posN), playSoundExecutor)
  let sourceN = execute(then(argument(ArgSource, newSoundCategoryArgumentConsumer()), targetsN), playSoundExecutor)
  then(newCommandTree(Names, Description), execute(then(argument(ArgSound, newSoundArgumentConsumer()), sourceN), playSoundExecutor))
