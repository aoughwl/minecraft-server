## The `/plugin` command: `list`, `load <plugin_name>`, `unload <plugin_name>`, `hotreload enable|disable`, and
## `reload <plugin_name>` (unload and load the same file again).
## Port of pumpkin/src/command/commands/plugin.rs. The whole tree sits behind `require(has_permission_lvl(Three))`.
## Upstream's executors call `server.plugin_manager`; `CommandServer` (src/command/cmdsource.aowl) has only
## `activePlugins` for the plugin manager, so the manager is reached through `PluginCommandOps`, a `ref object` of
## closures that pluginmgr.aowl fills. Messages are upstream's: "Plugin <name> loaded successfully" (green),
## "Plugin <name> is already loaded", "Failed to load plugin <name>: <error>", "Plugin <name> is not loaded",
## "Plugin <name> unloaded successfully", "Failed to unload plugin <name>: <error>", the hot reload notices.
## `load` takes a path, as upstream (`try_load_plugin(Path::new(plugin_name))`); `is_plugin_active(plugin_name)` is asked
## with the same text, as upstream does. `reload` is not in the pinned tree: it unloads the plugin called `<plugin_name>`
## and loads its file again.
## PARTIAL: pumpkin/src/command/commands/plugin.rs - `hotreload` switches the manager's file poll (pluginmgr.aowl
## `tickPlugins`), not a file-system watcher.

import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color

const
  Names = ["plugin"]
  Description = "Manage plugins."
  PluginName = "plugin_name"

type
  PluginCommandOps* = ref object
    isActive*: proc (name: string): bool {.closure.}
    load*: proc (path: string): string {.closure.}        ## "" or the error text
    unload*: proc (name: string): string {.closure.}
    reload*: proc (name: string): string {.closure.}
    setHotReload*: proc (enabled: bool): string {.closure.}   ## "" or the error text

proc joinAuthors(authors: seq[string]): string =
  result = ""
  var i = 0
  while i < authors.len:
    if i > 0: result.add(", ")
    result.add(authors[i])
    inc i

proc listExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var plugins: seq[PluginMetadata] = @[]
  if server != nil and server.activePlugins != nil:
    plugins = server.activePlugins()
  let messageText =
    if plugins.len == 0: "There are no loaded plugins."
    elif plugins.len == 1: "There is 1 plugin loaded:\n"
    else: "There are " & $plugins.len & " plugins loaded:\n"
  var message = text(messageText)
  var i = 0
  while i < plugins.len:
    let metadata = plugins[i]
    let fmt = if i == plugins.len - 1: metadata.name else: metadata.name & ", "
    let hoverText = "Version: " & metadata.version & "\nAuthors: " & joinAuthors(metadata.authors) &
      "\nDescription: " & metadata.description
    message = addChild(message, hoverEvent(colorNamed(text(fmt), ncGreen), showText(text(hoverText))))
    inc i
  sendMessage(sender, message)
  cmdSuccess(int32(plugins.len))

proc nameArg(args: ConsumedArgs; name: var string): bool =
  var a = Arg()
  if not findArg(args, PluginName, a) or a.kind != akSimple: return false
  name = a.str
  true

proc opsIsActive(ops: PluginCommandOps; name: string): bool =
  ## A closure field of a captured value called inside a closure asserts in hexer; the call is made here.
  let res = ops.isActive(name)
  res

proc opsLoad(ops: PluginCommandOps; path: string): string =
  let res = ops.load(path)
  res

proc opsUnload(ops: PluginCommandOps; name: string): string =
  let res = ops.unload(name)
  res

proc opsReload(ops: PluginCommandOps; name: string): string =
  let res = ops.reload(name)
  res

proc opsSetHotReload(ops: PluginCommandOps; enabled: bool): string =
  let res = ops.setHotReload(enabled)
  res

proc loadExecutor(ops: PluginCommandOps): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var name = ""
    if not nameArg(args, name): return cmdInvalidConsumption(some(PluginName))
    if opsIsActive(ops, name): return cmdFailed(text("Plugin " & name & " is already loaded"))
    let err = opsLoad(ops, name)
    if err.len > 0: return cmdFailed(text("Failed to load plugin " & name & ": " & err))
    sendMessage(sender, colorNamed(text("Plugin " & name & " loaded successfully"), ncGreen))
    cmdSuccess(1'i32)

proc unloadExecutor(ops: PluginCommandOps): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var name = ""
    if not nameArg(args, name): return cmdInvalidConsumption(some(PluginName))
    if not opsIsActive(ops, name): return cmdFailed(text("Plugin " & name & " is not loaded"))
    let err = opsUnload(ops, name)
    if err.len > 0: return cmdFailed(text("Failed to unload plugin " & name & ": " & err))
    sendMessage(sender, colorNamed(text("Plugin " & name & " unloaded successfully"), ncGreen))
    cmdSuccess(1'i32)

proc reloadExecutor(ops: PluginCommandOps): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var name = ""
    if not nameArg(args, name): return cmdInvalidConsumption(some(PluginName))
    if not opsIsActive(ops, name): return cmdFailed(text("Plugin " & name & " is not loaded"))
    let err = opsReload(ops, name)
    if err.len > 0: return cmdFailed(text("Failed to reload plugin " & name & ": " & err))
    sendMessage(sender, colorNamed(text("Plugin " & name & " reloaded successfully"), ncGreen))
    cmdSuccess(1'i32)

proc hotReloadExecutor(ops: PluginCommandOps; enabled: bool): FallbackExecutor =
  result = proc (sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let err = opsSetHotReload(ops, enabled)
    if err.len > 0:
      return cmdFailed(text("Failed to start plugin watcher: " & err))
    if enabled:
      sendMessage(sender, colorNamed(text("Hot reloading has been enabled."), ncGreen))
      sendMessage(sender, colorNamed(text("WARNING: Hot reloading can impact performance and should only be enabled during plugin development."), ncRed))
    else:
      sendMessage(sender, colorNamed(text("Hot reloading has been disabled."), ncGreen))
    cmdSuccess(1'i32)

proc levelThree(sender: CommandSender): bool = hasPermissionLvl(sender, Three)

proc initCommandTree*(ops: PluginCommandOps): CommandTree =
  let loadNode = then(literal("load"), execute(argument(PluginName, newSimpleArgConsumer()), loadExecutor(ops)))
  let unloadNode = then(literal("unload"), execute(argument(PluginName, newSimpleArgConsumer()), unloadExecutor(ops)))
  let reloadNode = then(literal("reload"), execute(argument(PluginName, newSimpleArgConsumer()), reloadExecutor(ops)))
  let hotNode = then(then(literal("hotreload"), execute(literal("enable"), hotReloadExecutor(ops, true))),
                     execute(literal("disable"), hotReloadExecutor(ops, false)))
  let listNode = execute(literal("list"), listExecutor)
  let gate = then(then(then(then(then(require(levelThree), loadNode), unloadNode), hotNode), listNode), reloadNode)
  then(newCommandTree(Names, Description), gate)
