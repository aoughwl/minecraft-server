## `/plugins` with none and with two loaded.
import std/[assertions, strutils, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/text/text
import plugins, cmdtestutil

proc block0() =
  let d = newFallbackDispatcher()
  register(d, plugins.initCommandTree(), "pumpkin:command.plugins")
  var list: seq[PluginMetadata] = @[]
  let server = newServer()
  server.activePlugins = proc(): seq[PluginMetadata] {.closure.} = list
  var buffer = RconBuffer(lines: @[])
  assert dispatch(d, senderRcon(buffer), server, "plugins").isOk
  assert buffer.lines[0].contains("There are no loaded plugins.")
  list = @[PluginMetadata(name: "alpha", version: "1", authors: @["a"], description: "d"),
           PluginMetadata(name: "beta", version: "2", authors: @["b"], description: "e")]
  # The alias reaches the same tree.
  let r = dispatch(d, senderRcon(buffer), server, "pl")
  assert r.isOk
  assert buffer.lines[1].contains("There are 2 plugins loaded:")
  assert buffer.lines[1].contains("alpha") and buffer.lines[1].contains("beta")

block0()
echo "plugins command tests: all checks passed"
