## `/plugin` (plugin.aowl): list, load, unload, reload, hot reload, the failure messages, and the level-three gate.
import std/[assertions, strutils, syncio]
import ../../command/[cmdsource, fallbackdispatch, cmderrors]
import ../../util/text/text
import plugin, cmdtestutil

var failures = 0

proc ck(ok: bool; msg: string) =
  if not ok:
    echo "FAILED ", msg
    inc failures

var loaded: seq[string] = @[]
var calls: seq[string] = @[]
var failLoad = false

proc ops(): PluginCommandOps =
  PluginCommandOps(
    isActive: proc (name: string): bool {.closure.} = name in loaded,
    load: proc (path: string): string {.closure.} =
      calls.add "load " & path
      if failLoad: return "boom"
      loaded.add path
      "",
    unload: proc (name: string): string {.closure.} =
      calls.add "unload " & name
      var kept: seq[string] = @[]
      for n in loaded:
        if n != name: kept.add n
      loaded = kept
      "",
    reload: proc (name: string): string {.closure.} =
      calls.add "reload " & name
      "",
    setHotReload: proc (enabled: bool): string {.closure.} =
      calls.add (if enabled: "hot on" else: "hot off")
      "")

proc block0() =
  let d = newFallbackDispatcher()
  register(d, plugin.initCommandTree(ops()), "pumpkin:command.plugins")
  let server = newServer()
  server.activePlugins = proc(): seq[PluginMetadata] {.closure.} =
    @[PluginMetadata(name: "alpha", version: "1", authors: @["a", "b"], description: "d")]
  var buffer = RconBuffer(lines: @[])
  let sender = senderRcon(buffer)
  # list
  var r = dispatch(d, sender, server, "plugin list")
  ck(r.isOk, "line 43")
  ck(buffer.lines[0].contains("There is 1 plugin loaded:") and buffer.lines[0].contains("alpha"), "line 44")
  # load, then again
  r = dispatch(d, sender, server, "plugin load plugins/x.wasm")
  ck(r.isOk, "line 47")
  ck(buffer.lines[1].contains("Plugin plugins/x.wasm loaded successfully"), "line 48")
  r = dispatch(d, sender, server, "plugin load plugins/x.wasm")
  ck(not r.isOk, "line 50")
  ck(r.error.kind == ceCommandFailed and getText(r.error.failed) == "Plugin plugins/x.wasm is already loaded", "line 51")
  # a failing load
  failLoad = true
  r = dispatch(d, sender, server, "plugin load plugins/y.wasm")
  ck(not r.isOk and getText(r.error.failed) == "Failed to load plugin plugins/y.wasm: boom", "line 55")
  failLoad = false
  # unload, not loaded
  r = dispatch(d, sender, server, "plugin unload plugins/x.wasm")
  ck(r.isOk and buffer.lines[2].contains("Plugin plugins/x.wasm unloaded successfully"), "line 59")
  r = dispatch(d, sender, server, "plugin unload plugins/x.wasm")
  ck(not r.isOk and getText(r.error.failed) == "Plugin plugins/x.wasm is not loaded", "line 61")
  # reload
  loaded.add "z"
  r = dispatch(d, sender, server, "plugin reload z")
  ck(r.isOk and buffer.lines[3].contains("Plugin z reloaded successfully"), "line 65")
  r = dispatch(d, sender, server, "plugin reload nope")
  ck(not r.isOk and getText(r.error.failed) == "Plugin nope is not loaded", "line 67")
  # hot reload
  r = dispatch(d, sender, server, "plugin hotreload enable")
  ck(r.isOk and buffer.lines[4].contains("Hot reloading has been enabled.") and buffer.lines[5].contains("WARNING"), "line 70")
  r = dispatch(d, sender, server, "plugin hotreload disable")
  ck(r.isOk and buffer.lines[6].contains("Hot reloading has been disabled."), "line 72")
  ck(calls == @["load plugins/x.wasm", "load plugins/y.wasm", "unload plugins/x.wasm", "reload z", "hot on", "hot off"], "line 73")
  # the level-three gate: a command block is level two
  let denied = dispatch(d, senderDummy(), server, "plugin list")
  ck(not denied.isOk, "line 76")
  # the alias-free name and a usage error
  r = dispatch(d, sender, server, "plugin load")
  ck(not r.isOk, "line 79")

block0()
if failures > 0: quit 1
echo "plugin command tests: all checks passed"
