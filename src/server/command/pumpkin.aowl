## The `/pumpkin` (`/version`) command.
## Port of pumpkin/src/command/commands/pumpkin.rs
##
## PARTIAL: pumpkin/src/command/commands/pumpkin.rs - `fetch_all_contributors` pages through api.github.com; here it is the
## `fetchContributors` hook, which nothing fills (no network), so the count is 0 until a worker provides the list.

import std/strutils
import ../../command/[cmdsource, fallbackdispatch, args]
import ../../generated/packet
import ../../util/javaversion
import ../../util/text/[textbase, text, color, click]
import ../../util/translation

const
  Names = ["pumpkin", "version"]
  Description = "Display information about Pumpkin."
  CargoPkgVersion* = "0.1.0-dev+26.2"  ## `env!("CARGO_PKG_VERSION")`: the workspace version.
  GitHash* = "unknown"                 ## `env!("GIT_HASH")`: stamped at build by upstream's build.rs.
  GitHashFull* = "unknown"             ## `env!("GIT_HASH_FULL")`.

proc noNewlines(s: string): string = s.replace("\n", "")

proc copyable(message: TextComponent; namespacedKey: string; locale: Locale; args: seq[TextComponentBase]): TextComponent =
  ## `.click_event(CopyToClipboard { get_translation_text(..).replace('\n', "") })`.
  clickEvent(message, copyToClipboard(noNewlines(getTranslationText(namespacedKey, locale, args))))

proc pumpkinExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var contributors: seq[string] = @[]
  if server != nil and server.fetchContributors != nil:
    contributors = server.fetchContributors()
  var contributorNames = ""
  for i, login in contributors:
    if i > 0:
      contributorNames.add(", ")
    contributorNames.add(login)
  let locale = getLocale(sender)
  const profile = when defined(release) or defined(danger): "release" else: "debug"
  let versionString = CargoPkgVersion & " (Commit: " & GitHash & "/" & profile & ") - " & $contributors.len & " Contributors"
  let mcVersion = $CURRENT_MC_VERSION
  let protocol = $CURRENT_MC_VERSION.protocolVersion()
  var versionText = custom("pumpkin", "commands.pumpkin.version", locale, [text(versionString)])
  versionText = hoverEvent(versionText, showText(addChild(text("Commit: " & GitHashFull & "\n\nContributors:\n"),
    newLine(gradientNamed(text(contributorNames), [ncDarkGreen, ncGreen])))))
  versionText = copyable(versionText, "pumpkin:commands.pumpkin.version", locale, @[text(versionString).base])
  versionText = colorNamed(versionText, ncGreen)
  var description = custom("pumpkin", "commands.pumpkin.description", locale)
  description = copyable(description, "pumpkin:commands.pumpkin.description", locale, @[])
  description = hoverEvent(description, showText(custom("pumpkin", "commands.pumpkin.description.hover", locale)))
  description = colorNamed(description, ncWhite)
  var minecraftVersion = custom("pumpkin", "commands.pumpkin.minecraft_version", locale, [text(mcVersion), text(protocol)])
  minecraftVersion = copyable(minecraftVersion, "pumpkin:commands.pumpkin.minecraft_version", locale,
    @[text(mcVersion).base, text(protocol).base])
  minecraftVersion = hoverEvent(minecraftVersion, showText(custom("pumpkin", "commands.pumpkin.minecraft_version.hover", locale)))
  minecraftVersion = colorNamed(minecraftVersion, ncGold)
  var github = custom("pumpkin", "commands.pumpkin.github", locale)
  github = clickEvent(github, openUrl("https://github.com/Pumpkin-MC/Pumpkin"))
  github = hoverEvent(github, showText(custom("pumpkin", "commands.pumpkin.github.hover", locale)))
  github = underlined(bold(colorNamed(github, ncBlue)))
  var donate = text("[Donate]")
  donate = clickEvent(donate, openUrl("https://pumpkinmc.org/donate/"))
  donate = hoverEvent(donate, showText(text("Click to open Donate")))
  donate = underlined(bold(rainbow(donate)))
  var website = custom("pumpkin", "commands.pumpkin.website", locale)
  website = clickEvent(website, openUrl("https://pumpkinmc.org/"))
  website = hoverEvent(website, showText(custom("pumpkin", "commands.pumpkin.website.hover", locale)))
  website = underlined(bold(colorNamed(website, ncBlue)))
  var message = addChild(versionText, description)
  message = addChild(message, minecraftVersion)
  message = addChild(message, github)
  message = addChild(message, text("  "))
  message = addChild(message, donate)
  message = addChild(message, text("  "))
  message = addChild(message, website)
  sendMessage(sender, message)
  # The number of contributors is the result, as upstream's comment says.
  cmdSuccess(int32(contributors.len))

proc initCommandTree*(): CommandTree =
  execute(newCommandTree(Names, Description), pumpkinExecutor)
