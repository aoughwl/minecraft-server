## `/pumpkin` and its alias `/version`, with a stand-in for the contributors list.
import std/[assertions, strutils, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/text/text
import pumpkin, cmdtestutil

proc block0() =
  let d = newFallbackDispatcher()
  register(d, pumpkin.initCommandTree(), "pumpkin:command.pumpkin")
  var buffer = RconBuffer(lines: @[])
  let server = newServer()
  # Without a hook there are no contributors, as when the request fails.
  let none = dispatch(d, senderRcon(buffer), server, "pumpkin")
  assert none.isOk
  assert none.value == 0'i32
  assert buffer.lines.len == 1
  assert buffer.lines[0].contains("0.1.0-dev+26.2")
  assert buffer.lines[0].contains("0 Contributors")
  assert buffer.lines[0].contains("Protocol")
  assert buffer.lines[0].contains("[Github Repository]")
  assert buffer.lines[0].contains("[Website]")
  server.fetchContributors = proc(): seq[string] {.closure.} = @["a", "b", "c"]
  let r = dispatch(d, senderRcon(buffer), server, "version")
  assert r.isOk

  assert buffer.lines[1].contains("3 Contributors")

block0()
echo "pumpkin command tests: all checks passed"
