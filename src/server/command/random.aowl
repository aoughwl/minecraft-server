## The `/random` command.
## Port of pumpkin/src/command/commands/random.rs

import ../../util/closureset
import std/[options, random as stdrandom]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch, entity_selector]
import ../../util/permission
import ../../util/math/bounds
import ../../util/text/textbase, ../../util/text/text
import ../../generated/translation

const
  Description = "Draws a random value."
  Permission0 = "minecraft:command.random"
  ArgRange = "range"
  MaxRangeSpan = int64(int32.high) - 1'i64

proc rangeTooLargeErrorType(): CommandErrorType = errorType0(JAVA_COMMANDS_RANDOM_ERROR_RANGE_TOO_LARGE, JAVA_COMMANDS_RANDOM_ERROR_RANGE_TOO_LARGE)
proc rangeTooSmallErrorType(): CommandErrorType = errorType0(JAVA_COMMANDS_RANDOM_ERROR_RANGE_TOO_SMALL, JAVA_COMMANDS_RANDOM_ERROR_RANGE_TOO_SMALL)

proc randomExecutor(roll: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    var found = false
    let v = argumentOf(context, ArgRange, found)
    if not found:
      return cmdFail[int32](missingArgument(ArgRange))
    if not (v of IntBoundsValue):
      return cmdFail[int32](wrongArgumentType(ArgRange))
    let typed = IntBoundsValue(v)
    let bounds = typed.value
    let lo = min(bounds)
    let hi = max(bounds)
    let minV = if lo.isSome: lo.unsafeGet else: int32.low
    let maxV = if hi.isSome: hi.unsafeGet else: int32.high
    let span = int64(maxV) - int64(minV)
    if span == 0'i64:
      return cmdFail[int32](createWithoutContext(rangeTooSmallErrorType()))
    if span >= MaxRangeSpan:
      return cmdFail[int32](createWithoutContext(rangeTooLargeErrorType()))
    let res = int32(int64(minV) + int64(rand(int(span))))
    if roll:
      let msg = translateCross(JAVA_COMMANDS_RANDOM_ROLL, JAVA_COMMANDS_RANDOM_ROLL,
        [context.source.displayName, text($res), text($minV), text($maxV)])
      let server = context.source.server
      if server != nil and closureSet(server.getAllPlayers):
        let players = server.getAllPlayers()
        for player in players:
          if closureSet(player.sendSystemMessage):
            player.sendSystemMessage(msg)
      if playerOrNone(context.source) == nil:
        sendMessage(context.source, msg)
    else:
      sendFeedback(context.source, translateCross(JAVA_COMMANDS_RANDOM_SAMPLE_SUCCESS, JAVA_COMMANDS_RANDOM_SAMPLE_SUCCESS, [text($res)]), false)
    cmdOk[int32](res)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionAllow()))
  var b = requires(command("random", Description), Permission0)
  b = then(b, then(literal("value"), executes(argument(ArgRange, newIntRangeArgumentType()), randomExecutor(false))))
  b = then(b, then(literal("roll"), executes(argument(ArgRange, newIntRangeArgumentType()), randomExecutor(true))))
  discard register(dispatcher, b)
