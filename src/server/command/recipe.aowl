## The `/recipe` command.
## Port of pumpkin/src/command/commands/recipe.rs
##
## Upstream filters the recipe manager's dynamic recipes by `get_recipe_id` and sends `CRecipeBookAdd`. The hooks
## do the id lookup (`CommandServer.getRecipeIds`) and the packet (`CommandPlayer.sendRecipeBook`), so the command
## works on ids: a recipe is matched when its id is the argument, or the argument with `minecraft:` removed.

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector, suggestion]
import ../../util/permission
import ../../util/text/[textbase, text]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Gives or takes player recipes."
  Permission0 = "minecraft:command.recipe"

proc notFound(recipe: string): CommandSyntaxError =
  createWithoutContext(errorType1(JAVA_RECIPE_NOTFOUND, "Unknown recipe: %s"), text(recipe))

proc matches(id, wanted: string): bool =
  id == wanted or (if id.startsWith("minecraft:"): id[10 ..< id.len] else: id) == wanted

proc recipeSuggestions(context: CommandContext; builder: SuggestionsBuilder): Suggestions =
  var b = suggest(builder, "*")
  let server = context.source.server
  if server != nil and closureSet(server.getRecipeIds):
    let ids = server.getRecipeIds()
    for id in ids:
      b = suggest(b, id)
  build(b)

proc recipeExecutor(give: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let targets = getPlayers(context, "targets")
    if not targets.isOk:
      return cmdFail[int32](targets.error)
    let recipe = getString(context, "recipe")
    if not recipe.isOk:
      return cmdFail[int32](recipe.error)
    let server = context.source.server
    if server == nil:
      return cmdFail[int32](notFound(recipe.value))
    var all: seq[string] = @[]
    if closureSet(server.getRecipeIds):
      all = server.getRecipeIds()
    let isAll = recipe.value == "*"
    var chosen: seq[string] = @[]       # what the packet carries: matches for give, what remains for take
    var matched = 0
    for id in all:
      let hit = matches(id, recipe.value)
      if hit:
        inc matched
      if give == hit:
        chosen.add(id)
    if give and isAll:
      chosen = all
      matched = all.len
    if not give and isAll:
      chosen = @[]
      matched = all.len
    if not isAll and matched == 0:
      return cmdFail[int32](notFound(recipe.value))
    for p in targets.value:
      if closureSet(p.sendRecipeBook):
        p.sendRecipeBook(not give, chosen)
    let count = text($matched)
    let list = targets.value
    let msg =
      if list.len == 1:
        tc(if give: JAVA_COMMANDS_RECIPE_GIVE_SUCCESS_SINGLE else: JAVA_COMMANDS_RECIPE_TAKE_SUCCESS_SINGLE, [count, shown(list[0])])
      else:
        tc(if give: JAVA_COMMANDS_RECIPE_GIVE_SUCCESS_MULTIPLE else: JAVA_COMMANDS_RECIPE_TAKE_SUCCESS_MULTIPLE,
          [count, text($list.len)])
    sendFeedback(context.source, msg, true)
    cmdOk[int32](int32(list.len * matched))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  proc branch(name: string; give: bool): ArgumentBuilder =
    then(literal(name), then(argument("targets", newEntityArgumentType(eakPlayers)),
      executes(suggests(argument("recipe", newStringArgumentType(spSingleWord)), recipeSuggestions), recipeExecutor(give))))
  discard register(dispatcher, then(then(requires(command("recipe", Description), Permission0), branch("give", true)),
    branch("take", false)))
