## `/recipe give` and `/recipe take`: what each sends to the player's recipe book.
## `*` and `minecraft:` ids cannot be typed: upstream reads the recipe as a single unquoted word, which stops at `*` and `:`.
import std/[options, syncio]
import ../../command/[cmddispatch, cmderrors, cmdsource, cmdtree]
import ../../util/[permission, vector2, vector3]
import ../../util/text/[textbase, text]
import recipe, cmdtestutil

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  var sentReplace = false
  var sentIds: seq[string] = @[]
  var sends = 0
  let steve = CommandPlayer(entity: CommandEntity(entityTypeId: "minecraft:player"), gameProfile: CmdGameProfile(name: "Steve"))
  steve.entity.player = steve
  steve.entity.getDisplayName = proc(): TextComponent {.closure.} = text("Steve")
  steve.sendRecipeBook = proc(replace: bool; ids: seq[string]) {.closure.} =
    sentReplace = replace
    sentIds = ids
    inc sends
  let world = CommandWorld(dimensionName: "minecraft:overworld")
  let server = newServerWithWorld(world)
  let players = @[steve]
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.getPlayerByName = proc(name: string): nil CommandPlayer {.closure.} =
    if name == "Steve":
      return steve
    nil
  server.getRecipeIds = proc(): seq[string] {.closure.} =
    @["minecraft:stick", "minecraft:oak_planks", "minecraft:stick", "minecraft:torch"]
  let source = consoleSource(server, world)
  let d = newCommandDispatcher()
  recipe.register(d, newPermissionRegistry())
  proc run(line: string): CmdResult[int32] {.closure.} = executeInput(d, line, source)

  let one = run("recipe give Steve stick")
  if not one.isOk:
    echo getText(one.error.message), " | ", one.error.errorType.javaTranslationKey
  check(one.isOk and one.value == 2'i32, "two recipes make a stick: 1 player x 2")
  check(not sentReplace and sentIds == @["minecraft:stick", "minecraft:stick"], "give adds the matches")
  check(not run("recipe give Steve nothing").isOk, "an unknown recipe fails")
  let take = run("recipe take Steve stick")
  check(take.isOk and take.value == 2'i32, "take counts what it took")
  check(sentReplace and sentIds == @["minecraft:oak_planks", "minecraft:torch"], "take replaces the book with what remains")
  check(not run("recipe take Steve nothing").isOk, "taking an unknown recipe fails")
  check(sends == 2, "one packet per successful command")

main()
echo "recipe command tests: all checks passed"
