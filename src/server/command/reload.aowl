## The `/reload` command. The pinned upstream tree has no reload.rs; this predates the pin in this port and is kept
## because a test of it was asked for. `reloadDatapacks` is the hook it calls.

import ../../util/closureset
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/text/textbase, ../../util/text/text

const
  Description = "Reloads the server's datapacks."

proc reloadExecutor(context: CommandContext): CmdResult[int32] =
  sendFeedback(context.source, text("Reloading datapacks..."), true)
  let server = context.source.server
  if server != nil and closureSet(server.reloadDatapacks):
    server.reloadDatapacks()
  cmdOk[int32](0'i32)

proc register*(dispatcher: CommandDispatcher) =
  discard register(dispatcher, executes(command("reload", Description), reloadExecutor))
