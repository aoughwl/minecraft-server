## The `/return` command. The pinned upstream tree has no return.rs; this predates the pin in this port and is kept
## because a test of it was asked for. `return` is a keyword here, hence the file name.

import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch]

const
  Description = "Control execution flow inside functions and change their return value."
  ArgValue0 = "value"

proc valueExecutor(context: CommandContext): CmdResult[int32] =
  getInt(context, ArgValue0)

proc failExecutor(context: CommandContext): CmdResult[int32] =
  cmdOk[int32](0'i32)

proc register*(dispatcher: CommandDispatcher) =
  var b = command("return", Description)
  b = then(b, executes(argument(ArgValue0, newIntegerArgumentType()), valueExecutor))
  b = then(b, executes(literal("fail"), failExecutor))
  b = then(b, redirect(literal("run"), redirectRoot()))
  discard register(dispatcher, b)
