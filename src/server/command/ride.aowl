## The `/ride` command.
## Port of pumpkin/src/command/commands/ride.rs
## PARTIAL: pumpkin/src/command/commands/ride.rs - `getVehicle`/`addPassenger`/`removePassenger` have no backing in the live server: only players exist in a world and a player cannot be ridden, so `mount` always reports "cannot ride players" and `dismount` "not riding" until entities live in the world.

import std/options
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector]
import ../../util/permission
import ../../util/text/[textbase, text]
import ../../generated/translation

const
  Description = "Mounts or dismounts target entities."
  Permission0 = "minecraft:command.ride"

proc cantRidePlayers(): CommandErrorType = errorType0(JAVA_COMMANDS_RIDE_MOUNT_FAILURE_CANT_RIDE_PLAYERS, "Cannot ride players")
proc wrongDimension(): CommandErrorType = errorType0(JAVA_COMMANDS_RIDE_MOUNT_FAILURE_WRONG_DIMENSION, "Cannot ride across dimensions")
proc loopError(): CommandErrorType = errorType0(JAVA_COMMANDS_RIDE_MOUNT_FAILURE_LOOP, "Cannot ride recursively")
proc alreadyRiding(): CommandErrorType = errorType2(JAVA_COMMANDS_RIDE_ALREADY_RIDING, "Already riding")
proc notRiding(): CommandErrorType = errorType1(JAVA_COMMANDS_RIDE_NOT_RIDING, "Not riding anything")
proc genericError(): CommandErrorType = errorType2(JAVA_COMMANDS_RIDE_MOUNT_FAILURE_GENERIC, "Failed to mount")

proc vehicleOf(e: CommandEntity): nil CommandEntity =
  if e.getVehicle != nil: e.getVehicle() else: nil

proc isRidingRecursive(entity, possibleVehicle: CommandEntity): bool =
  var current = vehicleOf(possibleVehicle)
  while current != nil:
    if current.entityId == entity.entityId:
      return true
    current = vehicleOf(current)
  false

proc dimensionOf(e: CommandEntity): string =
  let w = e.getWorld()
  if w == nil: "" else: w.dimensionName

proc mountExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getEntities(context, "target")
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let vehicleR = getEntity(context, "vehicle")
  if not vehicleR.isOk:
    return cmdFail[int32](vehicleR.error)
  let vehicle = vehicleR.value
  if vehicle.player != nil:
    return cmdFail[int32](createWithoutContext(cantRidePlayers()))
  let vehicleDim = dimensionOf(vehicle)
  var successCount = 0'i32
  var lastError = none[CommandSyntaxError]()
  for target in targets.value:
    if dimensionOf(target) != vehicleDim:
      lastError = some(createWithoutContext(wrongDimension()))
      continue
    if target.entityId == vehicle.entityId:
      lastError = some(createWithoutContext(loopError()))
      continue
    if isRidingRecursive(target, vehicle):
      lastError = some(createWithoutContext(loopError()))
      continue
    let current = vehicleOf(target)
    if current != nil:
      if current.entityId == vehicle.entityId:
        lastError = some(createWithoutContext(alreadyRiding(), target.getDisplayName(), vehicle.getDisplayName()))
        continue
      # Dismount first.
      if current.removePassenger != nil:
        current.removePassenger(target.entityId)
    if vehicle.addPassenger != nil:
      vehicle.addPassenger(target)
    inc successCount
    sendFeedback(context.source, translateCross(JAVA_COMMANDS_RIDE_MOUNT_SUCCESS, JAVA_COMMANDS_RIDE_MOUNT_SUCCESS,
      [target.getDisplayName(), vehicle.getDisplayName()]), true)
  if successCount == 0'i32:
    if lastError.isSome:
      return cmdFail[int32](lastError.unsafeGet)
    return cmdFail[int32](createWithoutContext(genericError(), targets.value[0].getDisplayName(), vehicle.getDisplayName()))
  cmdOk[int32](successCount)

proc dismountExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getEntities(context, "target")
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  var successCount = 0'i32
  var lastError = none[CommandSyntaxError]()
  for target in targets.value:
    let vehicle = vehicleOf(target)
    if vehicle != nil:
      if vehicle.removePassenger != nil:
        vehicle.removePassenger(target.entityId)
      inc successCount
      sendFeedback(context.source, translateCross(JAVA_COMMANDS_RIDE_DISMOUNT_SUCCESS, JAVA_COMMANDS_RIDE_DISMOUNT_SUCCESS,
        [target.getDisplayName()]), true)
    else:
      lastError = some(createWithoutContext(notRiding(), target.getDisplayName()))
  if successCount == 0'i32:
    if lastError.isSome:
      return cmdFail[int32](lastError.unsafeGet)
    return cmdFail[int32](createWithoutContext(notRiding(), targets.value[0].getDisplayName()))
  cmdOk[int32](successCount)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let target = then(then(argument("target", newEntityArgumentType(eakEntities)),
      then(literal("mount"), executes(argument("vehicle", newEntityArgumentType(eakEntity)), mountExecutor))),
    executes(literal("dismount"), dismountExecutor))
  discard register(dispatcher, then(requires(command("ride", Description), Permission0), target))
