## The `/rotate` command.
## Port of pumpkin/src/command/commands/rotate.rs

import std/[math, options]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../generated/translation
import ../../util/[vector2, vector3]
import ../../util/text/[textbase, text]
import cmdcommon

const
  Names = ["rotate"]
  Description = "Changes the rotation of an entity."
  ArgTarget = "target"
  ArgRotation = "rotation"
  ArgFacingLocation = "facingLocation"
  ArgFacingEntity = "facingEntity"
  ArgFacingAnchor = "facingAnchor"

proc yawPitchFacingPosition*(lookingFrom, lookingTowards: Vector3[float64]): (float32, float32) =
  ## Yaw and pitch to look from one position towards another.
  let dx = lookingTowards.x - lookingFrom.x
  let dy = lookingTowards.y - lookingFrom.y
  let dz = lookingTowards.z - lookingFrom.z
  let length = sqrt(dx * dx + dy * dy + dz * dz)
  let nx = dx / length
  let ny = dy / length
  let nz = dz / length
  let yawRadians = -arctan2(nx, nz)
  let pitchRadians = arcsin(-ny)
  (float32(radToDeg(yawRadians)), float32(radToDeg(pitchRadians)))

proc anchorPosition(entity: CommandEntity; anchor: EntityAnchor): Vector3[float64] =
  ## `get_anchor_position`.
  let pos = entity.getPos()
  case anchor
  of eaEyes: Vector3[float64](x: pos.x, y: pos.y + entity.getEyeHeight(), z: pos.z)
  of eaFeet: pos

proc eyesOf(entity: CommandEntity): Vector3[float64] =
  let pos = entity.getPos()
  Vector3[float64](x: pos.x, y: pos.y + entity.getEyeHeight(), z: pos.z)

proc rotateEntity(target: CommandEntity; yaw: float32; isYawRelative: bool; pitch: float32; isPitchRelative: bool) =
  ## `rotate_entity`: a teleport to the same position with the new rotation.
  let rot = target.getRotation()  # (pitch, yaw)
  let finalYaw = if isYawRelative: rot.y + yaw else: yaw
  let finalPitch =
    if isPitchRelative: clamp(rot.x + pitch, -90.0'f32, 90.0'f32)
    else: clamp(pitch, -90.0'f32, 90.0'f32)
  let world = target.getWorld()
  if target.teleport != nil and world != nil:
    target.teleport(target.getPos(), some(finalYaw), some(finalPitch), world)

proc sendSuccess(sender: CommandSender; target: CommandEntity) =
  sendMessage(sender, tc2(JAVA_COMMANDS_ROTATE_SUCCESS, JAVA_COMMANDS_ROTATE_SUCCESS, [target.getDisplayName()]))

proc oneEntity(args: ConsumedArgs; name: string; res: var CommandEntity): bool =
  var list: seq[CommandEntity] = @[]
  if not findEntity(args, name, list) or list.len == 0:
    return false
  res = list[0]
  true

proc toRotationExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target = CommandEntity()
  if not oneEntity(args, ArgTarget, target):
    return missing(ArgTarget)
  var rotation = Arg()
  if not findRotation(args, ArgRotation, rotation):
    return missing(ArgRotation)
  rotateEntity(target, rotation.yaw, rotation.yawRelative, rotation.pitch, rotation.pitchRelative)
  sendSuccess(sender, target)
  cmdSuccess(1'i32)

proc facingLocationExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var target = CommandEntity()
  if not oneEntity(args, ArgTarget, target):
    return missing(ArgTarget)
  var facing = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgFacingLocation, facing):
    return missing(ArgFacingLocation)
  let (yaw, pitch) = yawPitchFacingPosition(eyesOf(target), facing)
  rotateEntity(target, yaw, false, pitch, false)
  sendSuccess(sender, target)
  cmdSuccess(1'i32)

proc facingEntityWith(sender: CommandSender; args: ConsumedArgs; withAnchor: bool): CommandResult =
  var target = CommandEntity()
  if not oneEntity(args, ArgTarget, target):
    return missing(ArgTarget)
  var facingEntity = CommandEntity()
  if not oneEntity(args, ArgFacingEntity, facingEntity):
    return missing(ArgFacingEntity)
  var anchor = eaFeet
  if withAnchor:
    var a = Arg()
    if not findArg(args, ArgFacingAnchor, a) or a.kind != akEntityAnchor:
      return missing(ArgFacingAnchor)
    anchor = a.anchor
  let (yaw, pitch) = yawPitchFacingPosition(eyesOf(target), anchorPosition(facingEntity, anchor))
  rotateEntity(target, yaw, false, pitch, false)
  sendSuccess(sender, target)
  cmdSuccess(1'i32)

proc facingEntityExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  facingEntityWith(sender, args, true)

proc facingEntityNoAnchorExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  facingEntityWith(sender, args, false)

proc initCommandTree*(): CommandTree =
  let facing = then(then(literal("facing"),
      then(literal("entity"), then(execute(argument(ArgFacingEntity, newEntityArgumentConsumer()), facingEntityNoAnchorExecutor),
        execute(argument(ArgFacingAnchor, newEntityAnchorArgumentConsumer()), facingEntityExecutor)))),
    execute(argument(ArgFacingLocation, newPosition3DArgumentConsumer()), facingLocationExecutor))
  then(newCommandTree(Names, Description), then(then(argument(ArgTarget, newEntityArgumentConsumer()),
    execute(argument(ArgRotation, newRotationArgumentConsumer()), toRotationExecutor)), facing))
