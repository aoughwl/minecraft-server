## The `/save-all` command.
## Port of pumpkin/src/command/commands/saveall.rs

import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Saves the server to disk."
  Permission0 = "minecraft:command.save-all"

proc saveFailedErrorType(): CommandErrorType = errorType0(JAVA_COMMANDS_SAVE_FAILED, BEDROCK_COMMANDS_SAVE_FAILED)

proc saveAllExecutor(context: CommandContext): CmdResult[int32] =
  sendFeedback(context.source, translateCross(JAVA_COMMANDS_SAVE_SAVING, BEDROCK_COMMANDS_SAVE_START), false)
  let server = context.source.server
  if server != nil:
    if server.savePlayerData != nil and not server.savePlayerData():
      return cmdFail[int32](createWithoutContext(saveFailedErrorType()))
    if server.saveAdvancements != nil and not server.saveAdvancements():
      return cmdFail[int32](createWithoutContext(saveFailedErrorType()))
    if server.getWorlds != nil:
      let worlds = server.getWorlds()
      for world in worlds:
        if world.requestSave != nil:
          world.requestSave()
  sendFeedback(context.source, translateCross(JAVA_COMMANDS_SAVE_SUCCESS, BEDROCK_COMMANDS_SAVE_SUCCESS), true)
  cmdOk[int32](1'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))
  discard register(dispatcher, executes(requires(command("save-all", Description), Permission0), saveAllExecutor))
