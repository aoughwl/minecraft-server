## `/save-all`, `/list` and `/kill` through a real dispatch.
import std/[assertions, options, strutils, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, entity_selector]
import ../../util/[permission, uuid, vector2, vector3]
import ../../util/math/boundingbox
import ../../util/text/[textbase, text]
import saveall, list, kill, cmdtestutil

proc saveAllBlock() =
  let d = newCommandDispatcher()
  saveall.register(d, newPermissionRegistry())
  var requested = false
  var saved = false
  let world = CommandWorld(requestSave: proc() {.closure.} = requested = true)
  let server = newServerWithWorld(world)
  server.savePlayerData = proc(): bool {.closure.} =
    saved = true
    true
  let r = executeInput(d, "save-all", consoleSource(server, world))
  assert r.isOk and saved and requested
  server.savePlayerData = proc(): bool {.closure.} = false
  assert not executeInput(d, "save-all", consoleSource(server, world)).isOk

proc listBlock() =
  let d = newCommandDispatcher()
  list.register(d, newPermissionRegistry())
  let entity = CommandEntity(entityTypeName: "player",
    getDisplayName: proc(): TextComponent {.closure.} = text("alice"),
    getName: proc(): TextComponent {.closure.} = text("alice"))
  let p = CommandPlayer(entity: entity, gameProfile: CmdGameProfile(name: "alice"))
  let players = @[p]
  let server = newServer()
  server.getAllPlayers = proc(): seq[CommandPlayer] {.closure.} = players
  server.javaMaxPlayers = proc(): int32 {.closure.} = 20'i32
  var buffer = RconBuffer(lines: @[])
  let source = withOutput(consoleSource(server, nil), senderRcon(buffer))
  assert executeInput(d, "list", source).value == 1'i32
  assert buffer.lines[0].contains("alice")
  assert executeInput(d, "list uuids", source).value == 1'i32

proc killBlock() =
  let d = newCommandDispatcher()
  kill.register(d, newPermissionRegistry())
  var killed = 0
  let entity = CommandEntity(entityTypeName: "pig",
    getDisplayName: proc(): TextComponent {.closure.} = text("pig"),
    getName: proc(): TextComponent {.closure.} = text("pig"),
    getPos: proc(): Vector3[float64] {.closure.} = Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    isAlive: proc(): bool {.closure.} = true,
    kill: proc() {.closure.} = inc killed)
  let entities = @[entity]
  let world = CommandWorld(getEntities: proc(): seq[CommandEntity] {.closure.} = entities)
  let server = newServerWithWorld(world)
  let source = consoleSource(server, world)
  # No entity on the source: REQUIRES_ENTITY.
  let noSelf = executeInput(d, "kill", source)
  assert not noSelf.isOk and noSelf.error.isType(requiresEntity())
  assert executeInput(d, "kill @e", source).value == 1'i32
  assert killed == 1
  # Bound to a name first: the nested call form fails type inference ("Type mismatch at
  # [position]") although the types are right.
  let withSelf = withEntity(source, entity)
  let killedSelf = executeInput(d, "kill", withSelf)
  assert killedSelf.value == 1'i32
  assert killed == 2

saveAllBlock()
listBlock()
killBlock()
echo "save-all/list/kill command tests: all checks passed"
