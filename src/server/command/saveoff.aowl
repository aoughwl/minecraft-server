## The `/save-off` command.
## Port of pumpkin/src/command/commands/saveoff.rs

import ../../util/closureset
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Disables automatic server saves."
  Permission0 = "minecraft:command.save-off"

proc alreadyErrorType(): CommandErrorType = errorType0(JAVA_COMMANDS_SAVE_ALREADYOFF, BEDROCK_COMMANDS_SAVE_OFF_ALREADYOFF)

proc saveOffExecutor(context: CommandContext): CmdResult[int32] =
  var anyChanged = false
  let server = context.source.server
  if server != nil and closureSet(server.getWorlds):
    let worlds = server.getWorlds()
    for world in worlds:
      # `save_enabled.swap(false, Relaxed)`: the hook answers whether the value changed.
      if closureSet(world.setSaveEnabled) and world.setSaveEnabled(false):
        anyChanged = true
  if not anyChanged:
    return cmdFail[int32](createWithoutContext(alreadyErrorType()))
  sendFeedback(context.source, translateCross(JAVA_COMMANDS_SAVE_DISABLED, BEDROCK_COMMANDS_SAVE_DISABLED), true)
  cmdOk[int32](1'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))
  discard register(dispatcher, executes(requires(command("save-off", Description), Permission0), saveOffExecutor))
