## `/save-off`, `/save-on` and `/seed` through a real dispatch.
##
## This test used to fail with "expected /save-off to succeed": its closures captured a `var` in a module-level
## `block`, and this compiler gives such a closure its own zeroed copy of the variable (see COMPILER-BUGS, reported to
## the coordinator). The command was never wrong. Everything now runs inside procs, where capture works.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch]
import ../../util/permission
import saveoff, saveon, seed, cmdtestutil

proc saveOffBlock() =
  let d = newCommandDispatcher()
  saveoff.register(d, newPermissionRegistry())
  var enabled = true
  let world = CommandWorld(
    setSaveEnabled: proc(e: bool): bool {.closure.} =
      if enabled != e:
        enabled = e
        return true
      return false)
  let source = consoleSource(newServerWithWorld(world), world)
  let r = executeInput(d, "save-off", source)
  assert r.isOk, "expected /save-off to succeed"
  assert not enabled, "expected saving to be disabled"
  let r2 = executeInput(d, "save-off", source)
  assert not r2.isOk, "expected a repeat /save-off to report already-off"

proc saveOnBlock() =
  let d = newCommandDispatcher()
  saveon.register(d, newPermissionRegistry())
  var enabled = false
  let world = CommandWorld(
    setSaveEnabled: proc(e: bool): bool {.closure.} =
      if enabled != e:
        enabled = e
        return true
      return false)
  let source = consoleSource(newServerWithWorld(world), world)
  let r = executeInput(d, "save-on", source)
  assert r.isOk, "expected /save-on to succeed"
  assert enabled, "expected saving to be enabled"
  assert not executeInput(d, "save-on", source).isOk

proc seedBlock() =
  let d = newCommandDispatcher()
  seed.register(d, newPermissionRegistry())
  let world = CommandWorld(getSeed: proc(): int64 {.closure.} = 123456789'i64)
  let source = consoleSource(newServerWithWorld(world), world)
  let r = executeInput(d, "seed", source)
  assert r.isOk, "expected /seed to succeed"
  assert r.value == 123456789'i32, "expected the seed to be echoed back as i32"

saveOffBlock()
saveOnBlock()
seedBlock()
echo "save-off/save-on/seed command tests: all checks passed"
