## The `/say` command.
## Port of pumpkin/src/command/commands/say.rs

import ../../util/closureset
import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["say"]
  Description = "Broadcast a message to all Players."
  ArgMessage = "message"

proc sayExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var msg = ""
  if not findMsg(args, ArgMessage, msg):
    return cmdInvalidConsumption(some(ArgMessage))
  if server != nil and closureSet(server.broadcastSay):
    server.broadcastSay(text(msg), text(displayText(sender)))
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), execute(argument(ArgMessage, newMsgArgConsumer()), sayExecutor))
