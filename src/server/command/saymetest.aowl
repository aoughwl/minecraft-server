## `/say` and `/me`: the whole remaining input goes out once, with the sender's name.
import std/[assertions, syncio]
import ../../command/[cmdsource, fallbackdispatch]
import ../../util/text/[textbase, text]
import say, me, cmdtestutil

proc block0() =
  let d = newFallbackDispatcher()
  register(d, say.initCommandTree(), "minecraft:command.say")
  register(d, me.initCommandTree(), "minecraft:command.me")
  var said = ""
  var saidBy = ""
  var emoted = ""
  let server = newServer()
  server.broadcastSay = proc(m, s: TextComponent) {.closure.} =
    said = getText(m)
    saidBy = getText(s)
  server.broadcastEmote = proc(m, s: TextComponent) {.closure.} = emoted = getText(m)
  assert dispatch(d, senderConsole(), server, "say hello there world").isOk
  assert said == "hello there world"
  assert saidBy == "Server"
  assert dispatch(d, senderConsole(), server, "me waves").isOk
  assert emoted == "waves"
  # No message means no path fits.
  assert not dispatch(d, senderConsole(), server, "say").isOk

block0()
echo "say/me command tests: all checks passed"
