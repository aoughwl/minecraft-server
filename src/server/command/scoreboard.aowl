## The `/scoreboard` command.
## Port of pumpkin/src/command/commands/scoreboard.rs
##
## Upstream's command has `objectives add` and `players enable` only.

import std/options
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch, entity_selector]
import ../../util/permission
import ../../util/text/[textbase, text]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Manages scoreboard objectives and players."
  Permission0 = "minecraft:command.scoreboard"
  ArgObjective = "objective"
  ArgCriterion = "criterion"
  ArgDisplayName = "display_name"
  ArgTargets = "targets"

proc duplicateObjectiveError(): CommandErrorType =
  errorType0(JAVA_COMMANDS_SCOREBOARD_OBJECTIVES_ADD_DUPLICATE, JAVA_COMMANDS_SCOREBOARD_OBJECTIVES_ADD_DUPLICATE)

proc invalidEnableError(): CommandErrorType =
  errorType0(JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_INVALID, JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_INVALID)

proc failedEnableError(): CommandErrorType =
  errorType0(JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_FAILED, JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_FAILED)

proc objectivesAddExecutor(hasDisplayName: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let objectiveName = getString(context, ArgObjective)
    if not objectiveName.isOk:
      return cmdFail[int32](objectiveName.error)
    let criterion = getString(context, ArgCriterion)
    if not criterion.isOk:
      return cmdFail[int32](criterion.error)
    var displayName = text(objectiveName.value)
    if hasDisplayName:
      let dn = getString(context, ArgDisplayName)
      if not dn.isOk:
        return cmdFail[int32](dn.error)
      displayName = text(dn.value)
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var existing = CmdObjective()
    if world.getObjective != nil and world.getObjective(objectiveName.value, existing):
      return cmdFail[int32](createWithoutContext(duplicateObjectiveError()))
    if world.addObjective != nil:
      world.addObjective(objectiveName.value, displayName, criterion.value)
    sendFeedback(context.source, tc(JAVA_COMMANDS_SCOREBOARD_OBJECTIVES_ADD_SUCCESS, [displayName]), true)
    cmdOk[int32](1'i32)

proc playersEnableExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getPlayers(context, ArgTargets)
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let objectiveName = getString(context, ArgObjective)
  if not objectiveName.isOk:
    return cmdFail[int32](objectiveName.error)
  let world = context.source.world
  if world == nil:
    return cmdOk[int32](0'i32)
  var objective = CmdObjective()
  if world.getObjective == nil or not world.getObjective(objectiveName.value, objective):
    return cmdFail[int32](createWithoutContext(invalidEnableError()))
  if objective.criterion != "trigger":
    return cmdFail[int32](createWithoutContext(invalidEnableError()))
  var enabledCount = 0'i32
  for player in targets.value:
    let playerName = player.gameProfile.name
    var current = CmdScore()
    let has = world.getScoreEntry != nil and world.getScoreEntry(playerName, objectiveName.value, current)
    let alreadyEnabled = has and not current.locked
    if not alreadyEnabled:
      let value = if has: current.value else: 0'i32
      if world.setScoreEntry != nil:
        world.setScoreEntry(playerName, objectiveName.value, value, false)
      inc enabledCount
  if enabledCount == 0'i32:
    return cmdFail[int32](createWithoutContext(failedEnableError()))
  let msg =
    if targets.value.len == 1:
      tc(JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_SINGLE, [objective.displayName, text(targets.value[0].gameProfile.name)])
    else:
      tc(JAVA_COMMANDS_SCOREBOARD_PLAYERS_ENABLE_SUCCESS_MULTIPLE, [objective.displayName, text($targets.value.len)])
  sendFeedback(context.source, msg, true)
  cmdOk[int32](enabledCount)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  var criterion = executes(argument(ArgCriterion, newStringArgumentType(spSingleWord)), objectivesAddExecutor(false))
  criterion = then(criterion, executes(argument(ArgDisplayName, newStringArgumentType(spGreedyPhrase)), objectivesAddExecutor(true)))
  let objectives = then(literal("objectives"), then(literal("add"), then(argument(ArgObjective, newStringArgumentType(spSingleWord)), criterion)))
  let players = then(literal("players"), then(literal("enable"), then(argument(ArgTargets, newEntityArgumentType(eakPlayers)),
    executes(argument(ArgObjective, newObjectiveArgumentType()), playersEnableExecutor))))
  discard register(dispatcher, then(then(requires(command("scoreboard", Description), Permission0), objectives), players))
