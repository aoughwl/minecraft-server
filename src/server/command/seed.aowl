## The `/seed` command.
## Port of pumpkin/src/command/commands/seed.rs

import ../../util/text/click
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Displays the world seed."
  Permission0 = "minecraft:command.seed"

proc createCopyOnClickText(content: string): TextComponent =
  translateCross(JAVA_COMMANDS_SEED_SUCCESS, BEDROCK_COMMANDS_SEED_SUCCESS, [wrapInSquareBrackets(
    colorNamed(clickEvent(hoverEvent(text(content),
      showText(translateCross(JAVA_CHAT_COPY_CLICK, JAVA_CHAT_COPY_CLICK))), copyToClipboard(content)), ncGreen))])

proc seedExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  var seed = 0'i64
  if world != nil and world.getSeed != nil:
    seed = world.getSeed()
  sendFeedback(context.source, createCopyOnClickText($seed), false)
  # `seed as i32` truncates.
  cmdOk[int32](cast[int32](uint32(cast[uint64](seed) and 0xFFFFFFFF'u64)))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  discard register(dispatcher, executes(requires(command("seed", Description), Permission0), seedExecutor))
