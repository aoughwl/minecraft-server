## The `/setblock` command.
## Port of pumpkin/src/command/commands/setblock.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/blockdata
import args_resource

type Mode = enum
  modeDestroy
  modeKeep
  modeReplace
  modeStrict

const
  Names = ["setblock"]
  Description = "Place a block."
  ArgBlock = "block"
  ArgBlockPos = "pos"

proc setBlockExecutor(mode: Mode): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var blockV = Block()
    var stateId = 0'u16
    let b = findBlockState(args, ArgBlock, blockV, stateId)
    if not b.isOk:
      return b
    if server == nil:
      return cmdInvalidRequirement()
    let world = worldOrFirst(sender, server)
    if world == nil:
      return cmdInvalidRequirement()
    var posV = BlockPos()
    let loaded = findLoadedBlockPos(args, ArgBlockPos, world, posV)
    if not loaded.isOk:
      return loaded
    let p = posV.vec
    var success = true
    let normal = (cbfForceState or cbfNotifyNeighbors)
    case mode
    of modeDestroy:
      if closureSet(world.breakBlock):
        world.breakBlock(p.x, p.y, p.z, (cbfSkipDrops or cbfForceState))
      if closureSet(world.setBlockState):
        world.setBlockState(p.x, p.y, p.z, stateId, normal)
    of modeReplace:
      if closureSet(world.setBlockState):
        world.setBlockState(p.x, p.y, p.z, stateId, normal)
    of modeKeep:
      let old = if closureSet(world.getBlockStateId): world.getBlockStateId(p.x, p.y, p.z) else: 0'u16
      if not closureSet(world.isAirState) or world.isAirState(old):
        if closureSet(world.setBlockState):
          world.setBlockState(p.x, p.y, p.z, stateId, normal)
      else:
        success = false
    of modeStrict:
      if closureSet(world.setBlockState):
        world.setBlockState(p.x, p.y, p.z, stateId, cbfSkipBlockAddedCallback)
    if success:
      sendMessage(sender, tc2(JAVA_COMMANDS_SETBLOCK_SUCCESS, BEDROCK_COMMANDS_SETBLOCK_SUCCESS, [text($p.x), text($p.y), text($p.z)]))
      return cmdSuccess(1'i32)
    cmdFailed(tc2(JAVA_COMMANDS_SETBLOCK_FAILED, BEDROCK_COMMANDS_SETBLOCK_FAILED))

proc initCommandTree*(): CommandTree =
  var b = argument(ArgBlock, newBlockArgumentConsumer())
  b = then(b, execute(literal("replace"), setBlockExecutor(modeReplace)))
  b = then(b, execute(literal("destroy"), setBlockExecutor(modeDestroy)))
  b = then(b, execute(literal("keep"), setBlockExecutor(modeKeep)))
  b = then(b, execute(literal("strict"), setBlockExecutor(modeStrict)))
  b = execute(b, setBlockExecutor(modeReplace))
  then(newCommandTree(Names, Description), then(argument(ArgBlockPos, newBlockPosArgumentConsumer()), b))
