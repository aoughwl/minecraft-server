## The `/setidletimeout` command.
## Port of pumpkin/src/command/commands/setidletimeout.rs

import ../../util/closureset
import ../../command/argtype
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Sets the time before idle players are kicked from the server."
  Permission0 = "minecraft:command.setidletimeout"
  ArgMinutes = "minutes"

proc setIdleTimeoutExecutor(context: CommandContext): CmdResult[int32] =
  let minutes = getInt(context, ArgMinutes)
  if not minutes.isOk:
    return minutes
  let server = context.source.server
  if server != nil and closureSet(server.setPlayerIdleTimeout):
    server.setPlayerIdleTimeout(minutes.value)
  if minutes.value == 0'i32:
    sendFeedback(context.source, translateCross("commands.setidletimeout.success.disabled", "commands.setidletimeout.success.disabled"), true)
  else:
    sendFeedback(context.source, translateCross("commands.setidletimeout.success", "commands.setidletimeout.success", [text($minutes.value)]), true)
  minutes

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Three)))
  discard register(dispatcher, then(requires(command("setidletimeout", Description), Permission0),
    executes(argument(ArgMinutes, newIntegerArgumentType(0'i32)), setIdleTimeoutExecutor)))
