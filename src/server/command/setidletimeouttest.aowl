## `/setidletimeout` through a real dispatch, including the parser's minimum.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch]
import ../../util/permission
import setidletimeout, cmdtestutil

proc timeoutBlock() =
  let d = newCommandDispatcher()
  setidletimeout.register(d, newPermissionRegistry())
  var minutes = -1'i32
  let server = newServer()
  server.setPlayerIdleTimeout = proc(m: int32) {.closure.} = minutes = m
  let source = consoleSource(server, nil)
  let r = executeInput(d, "setidletimeout 15", source)
  assert r.isOk and r.value == 15'i32
  assert minutes == 15'i32
  assert executeInput(d, "setidletimeout 0", source).value == 0'i32
  assert minutes == 0'i32
  assert not executeInput(d, "setidletimeout -1", source).isOk
  assert minutes == 0'i32

timeoutBlock()
echo "setidletimeout command tests: all checks passed"
