## The `/setworldspawn` command.
## Port of pumpkin/src/command/commands/setworldspawn.rs

import std/math
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["setworldspawn"]
  Description = "Sets the world spawn point."
  ArgBlockPos = "position"
  ArgAngle = "angle"

proc setWorldSpawn(sender: CommandSender; server: nil CommandServer; p: BlockPos; yaw, pitch: float32): CommandResult =
  if server == nil:
    return cmdFailed(text("Failed to get world."))
  let world = worldOrFirst(sender, server)
  if world == nil:
    return cmdFailed(text("Failed to get world."))
  if world.dimensionName != "minecraft:overworld" and world.dimensionName != "minecraft:overworld_caves":
    return cmdFailed(tc(JAVA_COMMANDS_SETWORLDSPAWN_FAILURE_NOT_OVERWORLD))
  let previous = if server.getSpawn != nil: server.getSpawn() else: CmdSpawn()
  var next = CmdSpawn(x: p.vec.x, y: p.vec.y, z: p.vec.z, yaw: yaw, pitch: pitch)
  if server.fireSpawnChange != nil:
    next = server.fireSpawnChange(world, previous, next)
  if server.setSpawn != nil:
    server.setSpawn(next)
  sendMessage(sender, tc(JAVA_COMMANDS_SETWORLDSPAWN_SUCCESS_NEW, [text($next.x), text($next.y), text($next.z), text($next.yaw), text($next.pitch), text(world.dimensionName)]))
  cmdSuccess(1'i32)

proc noArgsExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    if isConsole(sender):
      return cmdFailed(text("You must specify a Position!"))
    return cmdFailed(text("Failed to get Sender as Player!"))
  let v = sender.player.entity.getPos()
  setWorldSpawn(sender, server, BlockPos(vec: Vector3[int32](x: int32(floor(v.x)), y: int32(floor(v.y)), z: int32(floor(v.z)))), 0.0'f32, 0.0'f32)

proc defaultExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var p = BlockPos()
  if not findBlockPos(args, ArgBlockPos, p):
    return missing(ArgBlockPos)
  setWorldSpawn(sender, server, p, 0.0'f32, 0.0'f32)

proc angleExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var p = BlockPos()
  if not findBlockPos(args, ArgBlockPos, p):
    return missing(ArgBlockPos)
  var a = Arg()
  if not findRotation(args, ArgAngle, a):
    return missing(ArgAngle)
  setWorldSpawn(sender, server, p, a.yaw, a.pitch)

proc initCommandTree*(): CommandTree =
  then(execute(newCommandTree(Names, Description), noArgsExecutor),
    then(execute(argument(ArgBlockPos, newBlockPosArgumentConsumer()), defaultExecutor),
      execute(argument(ArgAngle, newRotationArgumentConsumer()), angleExecutor)))
