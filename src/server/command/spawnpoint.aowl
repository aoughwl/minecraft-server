## The `/spawnpoint` command.
## Port of pumpkin/src/command/commands/spawnpoint.rs

import ../../util/closureset
import std/math
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["spawnpoint"]
  Description = "Sets the spawn point for a player."
  # Upstream registers the node as "targets" but its executors look up the consumer's default name, "target", which
  # that path never finds, so its `/spawnpoint <targets>` always fails. This looks up what is registered.
  ArgTargets = "targets"
  ArgPos = "pos"
  ArgAngle = "angle"

proc setSpawnpoint(sender: CommandSender; target: CommandPlayer; p: BlockPos; yaw: float32) =
  let world = target.entity.getWorld()
  let dimension = if world != nil: world.dimensionName else: ""
  if closureSet(target.setRespawnPoint):
    target.setRespawnPoint(dimension, p.vec.x, p.vec.y, p.vec.z, yaw, 0.0'f32, true)
  sendMessage(sender, tc2(JAVA_COMMANDS_SPAWNPOINT_SUCCESS_SINGLE, BEDROCK_COMMANDS_SPAWNPOINT_SUCCESS_SINGLE,
    [text(target.gameProfile.name), text($p.vec.x), text($p.vec.y), text($p.vec.z)]))

proc floorPos(v: Vector3[float64]): BlockPos =
  BlockPos(vec: Vector3[int32](x: int32(floor(v.x)), y: int32(floor(v.y)), z: int32(floor(v.z))))

proc selfExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  let e = sender.player.entity
  setSpawnpoint(sender, sender.player, floorPos(e.getPos()), e.getRotation().y)
  cmdSuccess(1'i32)

proc targetsExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  for target in targets:
    setSpawnpoint(sender, target, floorPos(target.entity.getPos()), target.entity.getRotation().y)
  cmdSuccess(int32(targets.len))

proc targetsPosExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var p = BlockPos()
  if not findBlockPos(args, ArgPos, p):
    return missing(ArgPos)
  for target in targets:
    setSpawnpoint(sender, target, p, target.entity.getRotation().y)
  cmdSuccess(int32(targets.len))

proc targetsPosAngleExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var p = BlockPos()
  if not findBlockPos(args, ArgPos, p):
    return missing(ArgPos)
  var a = Arg()
  if not findRotation(args, ArgAngle, a):
    return missing(ArgAngle)
  for target in targets:
    setSpawnpoint(sender, target, p, a.yaw)
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  # Upstream's lookup uses the consumer's default name, `target`; the node here is `targets`. See the note below.
  let angleN = execute(argument(ArgAngle, newRotationArgumentConsumer()), targetsPosAngleExecutor)
  let posN = then(execute(argument(ArgPos, newBlockPosArgumentConsumer()), targetsPosExecutor), angleN)
  let targetsN = then(execute(argument(ArgTargets, newPlayersArgumentConsumer()), targetsExecutor), posN)
  then(execute(newCommandTree(Names, Description), selfExecutor), targetsN)
