## The `/spectate` command.
## Port of pumpkin/src/command/commands/spectate.rs

import std/options
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../generated/translation
import ../../util/gamemode
import ../../util/[vector2, vector3]
import ../../util/text/[textbase, text]
import cmdcommon

const
  Names = ["spectate"]
  Description = "Allows a player in spectator mode to spectate a given target entity."
  ArgTarget = "target"
  ArgPlayer = "player"

proc notSpectator(who: CommandPlayer): CommandResult =
  cmdFailed(tc2(JAVA_COMMANDS_SPECTATE_NOT_SPECTATOR, JAVA_COMMANDS_SPECTATE_NOT_SPECTATOR, [shown(who)]))

proc isSpectator(p: CommandPlayer): bool =
  p.getGameMode != nil and p.getGameMode() == Spectator

proc sameWorld(a, b: CommandEntity): bool =
  a.getWorld() == b.getWorld()

proc startSpectating(player: CommandPlayer; target: CommandEntity) =
  ## `camera_target_id.store`, CSetCamera, then a teleport onto the target.
  if player.setCameraTarget != nil:
    player.setCameraTarget(target.entityId)
  let rot = target.getRotation()  # (pitch, yaw)
  let world = player.entity.getWorld()
  if player.entity.teleport != nil and world != nil:
    player.entity.teleport(target.getPos(), some(rot.y), some(rot.x), world)

proc oneEntity(args: ConsumedArgs; res: var CommandEntity): bool =
  var list: seq[CommandEntity] = @[]
  if not findEntity(args, ArgTarget, list) or list.len == 0:
    return false
  res = list[0]
  true

proc stopExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  let player = sender.player
  if not isSpectator(player):
    return notSpectator(player)
  if player.setCameraTarget != nil:
    player.setCameraTarget(player.entity.entityId)
  sendMessage(sender, tc2(JAVA_COMMANDS_SPECTATE_SUCCESS_STOPPED, JAVA_COMMANDS_SPECTATE_SUCCESS_STOPPED))
  cmdSuccess(1'i32)

proc targetSelfExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  let player = sender.player
  if not isSpectator(player):
    return notSpectator(player)
  var target = CommandEntity()
  if not oneEntity(args, target):
    return missing(ArgTarget)
  if target.entityId == player.entity.entityId:
    return cmdFailed(tc2(JAVA_COMMANDS_SPECTATE_SELF, JAVA_COMMANDS_SPECTATE_SELF))
  if not sameWorld(target, player.entity):
    return cmdFailed(tc2(JAVA_COMMANDS_SPECTATE_CANNOT_SPECTATE, JAVA_COMMANDS_SPECTATE_CANNOT_SPECTATE, [shown(target)]))
  startSpectating(player, target)
  sendMessage(sender, tc2(JAVA_COMMANDS_SPECTATE_SUCCESS_STARTED, JAVA_COMMANDS_SPECTATE_SUCCESS_STARTED, [shown(target)]))
  cmdSuccess(1'i32)

proc targetOtherExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var players: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgPlayer, players):
    return missing(ArgPlayer)
  var target = CommandEntity()
  if not oneEntity(args, target):
    return missing(ArgTarget)
  # First validate all players.
  for p in players:
    if not isSpectator(p):
      return notSpectator(p)
    if target.entityId == p.entity.entityId:
      return cmdFailed(tc2(JAVA_COMMANDS_SPECTATE_SELF, JAVA_COMMANDS_SPECTATE_SELF))
    if not sameWorld(target, p.entity):
      return cmdFailed(tc2(JAVA_COMMANDS_SPECTATE_CANNOT_SPECTATE, JAVA_COMMANDS_SPECTATE_CANNOT_SPECTATE, [shown(target)]))
  var succeeded = 0'i32
  for p in players:
    startSpectating(p, target)
    inc succeeded
  sendMessage(sender, tc2(JAVA_COMMANDS_SPECTATE_SUCCESS_STARTED, JAVA_COMMANDS_SPECTATE_SUCCESS_STARTED, [shown(target)]))
  cmdSuccess(succeeded)

proc initCommandTree*(): CommandTree =
  then(then(newCommandTree(Names, Description),
    then(then(argument(ArgTarget, newEntityArgumentConsumer()), execute(require(isPlayerSender), targetSelfExecutor)),
      execute(argument(ArgPlayer, newPlayersArgumentConsumer()), targetOtherExecutor))),
    execute(require(isPlayerSender), stopExecutor))
