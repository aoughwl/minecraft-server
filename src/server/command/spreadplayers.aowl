## The `/spreadplayers` command.
## Port of pumpkin/src/command/commands/spreadplayers.rs

import ../../util/closureset
import std/[options, math, strutils, random as stdrandom]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, coordinates, cmddispatch,
  entity_selector]
import ../../util/[vector2, vector3, permission]
import ../../util/text/[textbase, text]
import ../../generated/translation

const
  Description = "Teleports entities to random surface locations within an area."
  Permission0 = "minecraft:command.spreadplayers"
  ArgCenter = "center"
  ArgSpreadDistance = "spreadDistance"
  ArgMaxRange = "maxRange"
  ArgRespectTeams = "respectTeams"
  ArgTargets = "targets"
  MaxIterations = 10000 ## The maximum number of relaxation/retry iterations, matching Vanilla.

type
  Pile = object
    x: float64
    z: float64

  SpreadArea = object
    minX, minZ, maxX, maxZ: float64

proc failedEntitiesError(): CommandErrorType =
  errorType4(JAVA_COMMANDS_SPREADPLAYERS_FAILED_ENTITIES, BEDROCK_COMMANDS_SPREADPLAYERS_FAILURE_PLAYERS)

proc failedTeamsError(): CommandErrorType =
  errorType4(JAVA_COMMANDS_SPREADPLAYERS_FAILED_TEAMS, BEDROCK_COMMANDS_SPREADPLAYERS_FAILURE_TEAMS)

proc distance(a, b: Pile): float64 =
  let dx = a.x - b.x
  let dz = a.z - b.z
  hypot(dx, dz)

proc randomize(p: var Pile; minX, minZ, maxX, maxZ: float64) =
  p.x = minX + rand(1.0) * (maxX - minX)
  p.z = minZ + rand(1.0) * (maxZ - minZ)

proc clampInto(p: var Pile; minX, minZ, maxX, maxZ: float64): bool =
  ## Clamps this pile into the spread area. Returns whether it moved.
  result = false
  if p.x < minX:
    p.x = minX
    result = true
  elif p.x > maxX:
    p.x = maxX
    result = true
  if p.z < minZ:
    p.z = minZ
    result = true
  elif p.z > maxZ:
    p.z = maxZ
    result = true

proc surfaceY(p: Pile; world: CommandWorld; y: var int32): bool =
  ## The y an entity should stand at for this pile; false if the location is unsafe (on top of a liquid).
  let blockX = int32(floor(p.x))
  let blockZ = int32(floor(p.z))
  let top = if closureSet(world.getSurfaceHeight): world.getSurfaceHeight(blockX, blockZ) else: 0'i32
  if closureSet(world.isLiquidAt) and world.isLiquidAt(blockX, top, blockZ):
    return false
  y = top + 1'i32
  true

proc spreadPiles(piles: var seq[Pile]; spreadDistance, minX, minZ, maxX, maxZ: float64): bool =
  ## Spreads `piles` apart until every pair is at least `spreadDistance` apart and all piles are inside the area.
  ## Returns whether the piles converged within `MaxIterations`.
  for iteration in 0 ..< MaxIterations:
    var moved = false
    for i in 0 ..< piles.len:
      var push = Pile(x: 0.0, z: 0.0)
      var collisions = 0
      for j in 0 ..< piles.len:
        if i == j:
          continue
        let d = distance(piles[i], piles[j])
        if d < spreadDistance:
          inc collisions
          push.x += piles[j].x - piles[i].x
          push.z += piles[j].z - piles[i].z
      if collisions > 0:
        push.x = push.x / float64(collisions)
        push.z = push.z / float64(collisions)
        let length = hypot(push.x, push.z)
        if length > 0.0:
          piles[i].x -= push.x / length
          piles[i].z -= push.z / length
        else:
          randomize(piles[i], minX, minZ, maxX, maxZ)
        moved = true
      if clampInto(piles[i], minX, minZ, maxX, maxZ):
        moved = true
    if not moved:
      return true
  false

proc findSpreadPositions(world: CommandWorld; pileCount: int; spreadDistance: float64; area: SpreadArea;
                         piles: var seq[Pile]; surfaceYs: var seq[int32]): bool =
  ## Randomizes, relaxes, and grounds `pileCount` piles inside `area`; false if no safe arrangement was found.
  piles = newSeq[Pile](pileCount)
  for i in 0 ..< pileCount:
    randomize(piles[i], area.minX, area.minZ, area.maxX, area.maxZ)
  surfaceYs = newSeq[int32](pileCount)
  # A handful of surface retries is plenty; each retry re-runs the full relaxation.
  for attempt in 0 ..< 16:
    if not spreadPiles(piles, spreadDistance, area.minX, area.minZ, area.maxX, area.maxZ):
      return false
    var allSafe = true
    for i in 0 ..< pileCount:
      var y = 0'i32
      if surfaceY(piles[i], world, y):
        surfaceYs[i] = y
      else:
        randomize(piles[i], area.minX, area.minZ, area.maxX, area.maxZ)
        allSafe = false
    if allSafe:
      return true
  false

proc averageMinDistance(piles: seq[Pile]): float64 =
  ## The average distance from each pile to its closest neighbour.
  if piles.len < 2:
    return 0.0
  var total = 0.0
  for i in 0 ..< piles.len:
    var closest = Inf
    for j in 0 ..< piles.len:
      if i != j:
        closest = min(closest, distance(piles[i], piles[j]))
    total += closest
  total / float64(piles.len)

proc fmt2(v: float64): string = formatFloat(v, ffDecimal, 2)

proc spreadPlayersExecutor(context: CommandContext): CmdResult[int32] =
  let centerR = getCoordinates(context, ArgCenter)
  if not centerR.isOk:
    return cmdFail[int32](centerR.error)
  let spreadR = getFloat(context, ArgSpreadDistance)
  if not spreadR.isOk:
    return cmdFail[int32](spreadR.error)
  let rangeR = getFloat(context, ArgMaxRange)
  if not rangeR.isOk:
    return cmdFail[int32](rangeR.error)
  let teamsR = getBool(context, ArgRespectTeams)
  if not teamsR.isOk:
    return cmdFail[int32](teamsR.error)
  let targetsR = getEntities(context, ArgTargets)
  if not targetsR.isOk:
    return cmdFail[int32](targetsR.error)
  let center = resolve(centerR.value, context.source)
  let spreadDistance = float64(spreadR.value)
  let maxRange = float64(rangeR.value)
  let respectTeams = teamsR.value
  let targets = targetsR.value
  # Vanilla center-corrects the vec2 argument to the middle of the block.
  let centerX = floor(center.x) + 0.5
  let centerZ = floor(center.z) + 0.5
  let area = SpreadArea(minX: centerX - maxRange, minZ: centerZ - maxRange, maxX: centerX + maxRange, maxZ: centerZ + maxRange)
  # Teams are not implemented upstream yet, so every target is teamless. With respectTeams that matches Vanilla's
  # behaviour of gathering all teamless entities onto a single position.
  let pileCount = if respectTeams: 1 else: targets.len
  let world = context.source.world
  if world == nil or pileCount == 0:
    return cmdFail[int32](createWithoutContext(failedEntitiesError(), @[text("0"), text(fmt2(centerX)), text(fmt2(centerZ)), text(fmt2(maxRange))]))
  var piles: seq[Pile] = @[]
  var surfaceYs: seq[int32] = @[]
  if not findSpreadPositions(world, pileCount, spreadDistance, area, piles, surfaceYs):
    let suggested = maxRange / sqrt(float64(pileCount))
    let errorType = if respectTeams: failedTeamsError() else: failedEntitiesError()
    return cmdFail[int32](createWithoutContext(errorType, @[text($pileCount), text(fmt2(centerX)), text(fmt2(centerZ)), text(fmt2(suggested))]))
  for index in 0 ..< targets.len:
    let at = index mod pileCount
    if targets[index].teleport != nil:
      targets[index].teleport(Vector3[float64](x: floor(piles[at].x) + 0.5, y: float64(surfaceYs[at]), z: floor(piles[at].z) + 0.5),
        none[float32](), none[float32](), world)
  let averageDistance = averageMinDistance(piles)
  let successKey = if respectTeams: JAVA_COMMANDS_SPREADPLAYERS_SUCCESS_TEAMS else: JAVA_COMMANDS_SPREADPLAYERS_SUCCESS_ENTITIES
  sendFeedback(context.source, translateCross(successKey, successKey,
    [text($pileCount), text(fmt2(centerX)), text(fmt2(centerZ)), text(fmt2(averageDistance))]), true)
  cmdOk[int32](int32(pileCount))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let targetsN = executes(argument(ArgTargets, newEntityArgumentType(eakEntities)), spreadPlayersExecutor)
  let teamsN = then(argument(ArgRespectTeams, newBoolArgumentType()), targetsN)
  let rangeN = then(argument(ArgMaxRange, newFloatArgumentType(1.0'f32)), teamsN)
  let spreadN = then(argument(ArgSpreadDistance, newFloatArgumentType(0.0'f32)), rangeN)
  discard register(dispatcher, then(requires(command("spreadplayers", Description), Permission0),
    then(argument(ArgCenter, newColumnPosArgumentType()), spreadN)))
