## The `/stop` command.
## Port of pumpkin/src/command/commands/stop.rs

import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, cmddispatch]
import ../../util/permission
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Description = "Stop the server."
  Permission0 = "minecraft:command.stop"

proc stopExecutor(context: CommandContext): CmdResult[int32] =
  sendFeedback(context.source, colorNamed(translateCross(JAVA_COMMANDS_STOP_STOPPING, BEDROCK_COMMANDS_STOP_START), ncRed), true)
  let server = context.source.server
  if server != nil and server.stopServer != nil:
    server.stopServer()
  cmdOk[int32](1'i32)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))
  discard register(dispatcher, executes(requires(command("stop", Description), Permission0), stopExecutor))
