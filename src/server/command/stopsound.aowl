## The `/stopsound` command.
## Port of pumpkin/src/command/commands/stopsound.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../generated/sound as soundgen

const
  Names = ["stopsound"]
  Description = "Stops a currently playing sound."
  ArgTargets = "targets"
  ArgSource = "source"
  ArgSound = "sound"

proc soundArg(args: ConsumedArgs; name: string; sound: var string; failed: var CommandResult): bool =
  ## `SoundArgumentConsumer::find_arg`: true when there is a valid sound, `failed` set when it does not exist.
  failed = cmdSuccess(0'i32)
  var raw = ""
  if not findString(args, name, akBlock, raw):
    failed = missing(name)
    return false
  let bare = if raw.startsWith("minecraft:"): raw[10 ..< raw.len] else: raw
  let (ok, s) = soundgen.fromName(bare)
  if not ok:
    failed = cmdFailed(text("Sound " & raw & " does not exist."))
    return false
  sound = toName(s)
  true

proc stopSoundExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var category = ""
  let hasCategory = findString(args, ArgSource, akSoundCategory, category)
  var soundName = ""
  var failed = cmdSuccess(0'i32)
  let hasSound = soundArg(args, ArgSound, soundName, failed)
  let soundOpt = if hasSound: some("minecraft:" & soundName) else: none[string]()
  let categoryOpt = if hasCategory: some(category) else: none[string]()
  for target in targets:
    if target.stopSound != nil:
      target.stopSound(soundOpt, categoryOpt)
  let msg =
    if hasCategory and hasSound: tc(JAVA_COMMANDS_STOPSOUND_SUCCESS_SOURCE_SOUND, [text(soundName), text(category)])
    elif hasCategory: tc(JAVA_COMMANDS_STOPSOUND_SUCCESS_SOURCE_ANY, [text(category)])
    elif hasSound: tc(JAVA_COMMANDS_STOPSOUND_SUCCESS_SOURCELESS_SOUND, [text(soundName)])
    else: tc(JAVA_COMMANDS_STOPSOUND_SUCCESS_SOURCELESS_ANY)
  sendMessage(sender, msg)
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(execute(argument(ArgTargets, newPlayersArgumentConsumer()), stopSoundExecutor),
    then(execute(argument(ArgSource, newSoundCategoryArgumentConsumer()), stopSoundExecutor),
      execute(argument(ArgSound, newSoundArgumentConsumer()), stopSoundExecutor))))
