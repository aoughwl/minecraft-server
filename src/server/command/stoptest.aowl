## `/stop` through a real dispatch: the feedback goes out and the hook fires.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch]
import ../../util/permission
import stop, cmdtestutil

proc stopBlock() =
  let d = newCommandDispatcher()
  stop.register(d, newPermissionRegistry())
  var stopped = false
  let server = newServer()
  server.stopServer = proc() {.closure.} = stopped = true
  let r = executeInput(d, "stop", consoleSource(server, nil))
  assert r.isOk and r.value == 1'i32
  assert stopped, "expected stopServer to have been called"

stopBlock()
echo "stop command tests: all checks passed"
