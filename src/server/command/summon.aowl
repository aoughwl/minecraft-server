## The `/summon` command.
## Port of pumpkin/src/command/commands/summon.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon
import ../../command/[snbt, string_reader]
import ../../nbt/tag

import ../../generated/entity_type

const
  Names = ["summon"]
  Description = "Spawns a Entity at position."
  ArgEntity = "entity"
  ArgPos = "pos"
  ArgNbt = "nbt"

proc summonExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var raw = ""
  if not findString(args, ArgEntity, akBlock, raw):
    return missing(ArgEntity)
  let bare = if raw.startsWith("minecraft:"): raw[10 ..< raw.len] else: raw
  if fromName(EntityType, bare).isNone:
    return cmdFailed(text("Can't find Entity"))
  var posV = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  let hasPos = findPos3D(args, ArgPos, posV)
  var world: nil CommandWorld = nil
  var pos = posV
  case sender.kind
  of cskConsole, cskRcon, cskDummy:
    let w = firstWorld(server)
    if w == nil:
      return cmdInvalidRequirement()
    if not hasPos and w.getSpawnPoint != nil:
      let p = w.getSpawnPoint()
      pos = Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 1.0, z: float64(p.z) + 0.5)
    world = w
  of cskPlayer:
    if not hasPos:
      pos = sender.player.entity.getPos()
    world = sender.player.entity.getWorld()
  of cskCommandBlock:
    if not hasPos:
      let p = sender.commandBlock.getPosition()
      pos = Vector3[float64](x: float64(p.x) + 0.5, y: float64(p.y) + 0.5, z: float64(p.z) + 0.5)
    world = sender.commandBlockWorld
  var name = text("")
  var snbt = ""
  if findMsg(args, ArgNbt, snbt):
    # The compound is SNBT, as `/data merge` reads it; the words came back from the argument split joined by one space.
    var reader = newStringReader(snbt)
    let parsed = parseForCommands(reader)
    if not parsed.isOk or parsed.value.kind != ntkCompound:
      return cmdFailed(text("Incorrect argument for command: expected an NBT compound"))
    if world != nil and world.spawnEntityNbt != nil:
      name = world.spawnEntityNbt(bare, pos, parsed.value.compoundVal)
  elif world != nil and world.spawnEntity != nil:
    name = world.spawnEntity(bare, pos)
  sendMessage(sender, tc2(JAVA_COMMANDS_SUMMON_SUCCESS, BEDROCK_COMMANDS_SUMMON_SUCCESS, [name]))
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(execute(argument(ArgEntity, newSummonableEntitiesArgumentConsumer()), summonExecutor),
    then(execute(argument(ArgPos, newPosition3DArgumentConsumer()), summonExecutor),
      execute(argument(ArgNbt, newMsgArgConsumer()), summonExecutor))))
