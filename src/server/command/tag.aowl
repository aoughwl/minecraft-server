## The `/tag` command.
## Port of pumpkin/src/command/commands/tag.rs

import ../../util/closureset
import std/algorithm
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector, coordinates]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

import ../../protocol/java/client/play/commands

const
  Description = "Manages the scoreboard tags of entities."
  Permission0 = "minecraft:command.tag"
  ArgTargets = "targets"
  ArgName = "name"

proc changeExecutor(add: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let targets = getEntities(context, ArgTargets)
    if not targets.isOk:
      return cmdFail[int32](targets.error)
    let tag = getString(context, ArgName)
    if not tag.isOk:
      return cmdFail[int32](tag.error)
    var changed = 0'i32
    for target in targets.value:
      let f = if add: target.addScoreboardTag else: target.removeScoreboardTag
      if f != nil and f(tag.value):
        inc changed
    if changed == 0'i32:
      if add:
        return cmdFail[int32](createWithoutContext(errorType0(JAVA_COMMANDS_TAG_ADD_FAILED, BEDROCK_COMMANDS_TAG_ADD_FAILED)))
      return cmdFail[int32](createWithoutContext(errorType0(JAVA_COMMANDS_TAG_REMOVE_FAILED, BEDROCK_COMMANDS_TAG_REMOVE_FAILED)))
    let list = targets.value
    let msg =
      if list.len == 1:
        if add: tc2(JAVA_COMMANDS_TAG_ADD_SUCCESS_SINGLE, BEDROCK_COMMANDS_TAG_ADD_SUCCESS_SINGLE, [text(tag.value), shown(list[0])])
        else: tc2(JAVA_COMMANDS_TAG_REMOVE_SUCCESS_SINGLE, BEDROCK_COMMANDS_TAG_REMOVE_SUCCESS_SINGLE, [text(tag.value), shown(list[0])])
      else:
        if add: tc2(JAVA_COMMANDS_TAG_ADD_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_TAG_ADD_SUCCESS_MULTIPLE, [text(tag.value), text($list.len)])
        else: tc2(JAVA_COMMANDS_TAG_REMOVE_SUCCESS_MULTIPLE, BEDROCK_COMMANDS_TAG_REMOVE_SUCCESS_MULTIPLE, [text(tag.value), text($list.len)])
    sendFeedback(context.source, msg, true)
    cmdOk[int32](changed)

proc listExecutor(context: CommandContext): CmdResult[int32] =
  let targets = getEntities(context, ArgTargets)
  if not targets.isOk:
    return cmdFail[int32](targets.error)
  let list = targets.value
  var all: seq[string] = @[]
  for target in list:
    if closureSet(target.getScoreboardTags):
      let tags = target.getScoreboardTags()
      for t in tags:
        if t notin all:
          all.add(t)
  sort(all, proc(a, b: string): int = cmp(a, b)) # A BTreeSet upstream.
  var joined = ""
  var i = 0
  while i < all.len:
    if i > 0:
      joined.add(", ")
    joined.add(all[i])
    inc i
  let msg =
    if list.len == 1:
      if all.len == 0: tc2(JAVA_COMMANDS_TAG_LIST_SINGLE_EMPTY, BEDROCK_COMMANDS_TAG_LIST_SINGLE_EMPTY, [shown(list[0])])
      else: tc2(JAVA_COMMANDS_TAG_LIST_SINGLE_SUCCESS, BEDROCK_COMMANDS_TAG_LIST_SINGLE_SUCCESS, [shown(list[0]), text($all.len), text(joined)])
    else:
      if all.len == 0: tc2(JAVA_COMMANDS_TAG_LIST_MULTIPLE_EMPTY, BEDROCK_COMMANDS_TAG_LIST_MULTIPLE_EMPTY, [text($list.len)])
      else: tc2(JAVA_COMMANDS_TAG_LIST_MULTIPLE_SUCCESS, BEDROCK_COMMANDS_TAG_LIST_MULTIPLE_SUCCESS, [text($list.len), text($all.len), text(joined)])
  sendFeedback(context.source, msg, false)
  cmdOk[int32](int32(all.len))

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  var t = argument(ArgTargets, newEntityArgumentType(eakEntities))
  t = then(t, then(literal("add"), executes(argument(ArgName, newStringArgumentType(spSingleWord)), changeExecutor(true))))
  t = then(t, executes(literal("list"), listExecutor))
  t = then(t, then(literal("remove"), executes(argument(ArgName, newStringArgumentType(spSingleWord)), changeExecutor(false))))
  discard register(dispatcher, then(requires(command("tag", Description), Permission0), t))
