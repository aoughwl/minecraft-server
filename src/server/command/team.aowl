## The `/team` command.
## Port of pumpkin/src/command/commands/team.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch, entity_selector]
import ../../util/[permission, uuid]
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Manages teams."
  Permission0 = "minecraft:command.team"
  ArgTeamName = "name"
  ArgDisplayName = "displayName"
  ArgTeam = "team"
  ArgMembers = "members"
  ArgValue = "value"

  # `NameTagVisibility` and `CollisionRule` as the ordinals `CmdTeamInfo` holds (world/scoreboard.aowl's enums).
  VisibilityNames = ["always", "never", "hideForOtherTeams", "hideForOwnTeam"]
  CollisionNames = ["always", "never", "pushOtherTeams", "pushOwnTeam"]

proc err0(key: string): CommandErrorType = errorType0(key, key)

proc teamNotFound(name: string): CommandSyntaxError =
  createWithoutContext(errorType1(JAVA_TEAM_NOTFOUND, JAVA_TEAM_NOTFOUND), text(name))

proc entityScoreboardName(entity: CommandEntity): string =
  ## `get_entity_scoreboard_name`.
  let p = entity.player
  if p != nil: p.gameProfile.name else: $entity.uuid

proc lookupTeam(context: CommandContext; world: CommandWorld; team: var CmdTeamInfo): CmdVoidResult =
  ## `TeamArgumentType::get`, then `scoreboard.get_teams().get(name)`.
  let name = getString(context, ArgTeam)
  if not name.isOk:
    return cmdFailVoid(name.error)
  if not closureSet(world.getTeam) or not world.getTeam(name.value, team):
    return cmdFailVoid(teamNotFound(name.value))
  cmdOkVoid()

proc colorWord(c: NamedColor): string =
  ## `format!("{c:?}").to_lowercase()`: the variant name without its separators.
  let s = $c
  toLowerAscii(s[2 ..< s.len])

proc teamAddExecutor(hasDisplayName: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let teamName = getString(context, ArgTeamName)
    if not teamName.isOk:
      return cmdFail[int32](teamName.error)
    var displayName = text(teamName.value)
    if hasDisplayName:
      let dn = getString(context, ArgDisplayName)
      if not dn.isOk:
        return cmdFail[int32](dn.error)
      displayName = text(dn.value)
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var existing = CmdTeamInfo()
    if closureSet(world.getTeam) and world.getTeam(teamName.value, existing):
      return cmdFail[int32](createWithoutContext(err0(JAVA_COMMANDS_TEAM_ADD_DUPLICATE)))
    if closureSet(world.addTeam):
      world.addTeam(CmdTeamInfo(name: teamName.value, displayName: displayName, color: ncWhite, players: @[],
        options: 0'i8, nametagVisibility: 0'i32, collisionRule: 0'i32, playerPrefix: empty(), playerSuffix: empty()))
    sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_ADD_SUCCESS, [displayName]), true)
    cmdOk[int32](1'i32)

proc teamRemoveExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdOk[int32](0'i32)
  var team = CmdTeamInfo()
  let found = lookupTeam(context, world, team)
  if not found.isOk:
    return cmdFail[int32](found.error)
  if closureSet(world.removeTeam):
    world.removeTeam(team.name)
  sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_REMOVE_SUCCESS, [team.displayName]), true)
  cmdOk[int32](1'i32)

proc teamEmptyExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdOk[int32](0'i32)
  var team = CmdTeamInfo()
  let found = lookupTeam(context, world, team)
  if not found.isOk:
    return cmdFail[int32](found.error)
  if team.players.len == 0:
    return cmdFail[int32](createWithoutContext(errorType1(JAVA_COMMANDS_TEAM_EMPTY_UNCHANGED, JAVA_COMMANDS_TEAM_EMPTY_UNCHANGED),
      team.displayName))
  for player in team.players:
    if closureSet(world.removePlayerFromTeam):
      world.removePlayerFromTeam(team.name, player)
  sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_EMPTY_SUCCESS, [text($team.players.len), team.displayName]), true)
  cmdOk[int32](int32(team.players.len))

proc memberNames(context: CommandContext; hasMembers: bool): CmdResult[seq[string]] =
  var names: seq[string] = @[]
  if hasMembers:
    let targets = getOptionalEntities(context, ArgMembers)
    if not targets.isOk:
      return cmdFail[seq[string]](targets.error)
    if targets.value.len == 0:
      return cmdFail[seq[string]](createWithoutContext(noEntitiesErrorType()))
    for e in targets.value:
      names.add(entityScoreboardName(e))
  else:
    names.add(context.source.name)
  cmdOk[seq[string]](names)

proc teamJoinExecutor(hasMembers: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    let names = memberNames(context, hasMembers)
    if not names.isOk:
      return cmdFail[int32](names.error)
    for name in names.value:
      if closureSet(world.addPlayerToTeam):
        world.addPlayerToTeam(team.name, name)
    let count = names.value.len
    let msg =
      if count == 1:
        tc(JAVA_COMMANDS_TEAM_JOIN_SUCCESS_SINGLE, [text(names.value[0]), team.displayName])
      else:
        tc(JAVA_COMMANDS_TEAM_JOIN_SUCCESS_MULTIPLE, [text($count), team.displayName])
    sendFeedback(context.source, msg, true)
    cmdOk[int32](int32(count))

proc teamLeaveExecutor(hasMembers: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let names = memberNames(context, hasMembers)
    if not names.isOk:
      return cmdFail[int32](names.error)
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var removed = 0'i32
    for name in names.value:
      var team = CmdTeamInfo()
      if closureSet(world.getTeamOf) and world.getTeamOf(name, team):
        if closureSet(world.removePlayerFromTeam):
          world.removePlayerFromTeam(team.name, name)
        inc removed
    let msg =
      if names.value.len == 1:
        tc(JAVA_COMMANDS_TEAM_LEAVE_SUCCESS_SINGLE, [text(names.value[0])])
      else:
        tc(JAVA_COMMANDS_TEAM_LEAVE_SUCCESS_MULTIPLE, [text($removed)])
    sendFeedback(context.source, msg, true)
    cmdOk[int32](removed)

proc teamListExecutor(hasTeam: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    if hasTeam:
      var team = CmdTeamInfo()
      let found = lookupTeam(context, world, team)
      if not found.isOk:
        return cmdFail[int32](found.error)
      if team.players.len == 0:
        sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_LIST_MEMBERS_EMPTY, [team.displayName]), false)
      else:
        var list = empty()
        for i in 0 ..< team.players.len:
          if i > 0:
            list = addChild(list, text(", "))
          list = addChild(list, text(team.players[i]))
        sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_LIST_MEMBERS_SUCCESS,
          [team.displayName, text($team.players.len), list]), false)
      return cmdOk[int32](int32(team.players.len))
    var names: seq[string] = @[]
    if closureSet(world.getTeamNames):
      names = world.getTeamNames()
    if names.len == 0:
      sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_LIST_TEAMS_EMPTY), false)
    else:
      var list = empty()
      for i in 0 ..< names.len:
        if i > 0:
          list = addChild(list, text(", "))
        var team = CmdTeamInfo()
        if closureSet(world.getTeam) and world.getTeam(names[i], team):
          list = addChild(list, team.displayName)
      sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_LIST_TEAMS_SUCCESS, [text($names.len), list]), false)
    cmdOk[int32](int32(names.len))

proc update(world: CommandWorld; team: CmdTeamInfo) =
  if closureSet(world.updateTeam):
    world.updateTeam(team)

proc modifyColorExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdOk[int32](0'i32)
  var team = CmdTeamInfo()
  let found = lookupTeam(context, world, team)
  if not found.isOk:
    return cmdFail[int32](found.error)
  var present = false
  let c = argumentOf(context, ArgValue, present)
  if not present or c == nil or not (c of ColorValue):
    return cmdFail[int32](wrongArgumentType(ArgValue))
  let newColor = ColorValue(c).value
  if team.color == newColor:
    return cmdFail[int32](createWithoutContext(err0(JAVA_COMMANDS_TEAM_OPTION_COLOR_UNCHANGED)))
  team.color = newColor
  update(world, team)
  sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_OPTION_COLOR_SUCCESS, [team.displayName, text(colorWord(newColor))]), true)
  cmdOk[int32](1'i32)

proc modifyDisplayNameExecutor(context: CommandContext): CmdResult[int32] =
  let world = context.source.world
  if world == nil:
    return cmdOk[int32](0'i32)
  var team = CmdTeamInfo()
  let found = lookupTeam(context, world, team)
  if not found.isOk:
    return cmdFail[int32](found.error)
  let value = getString(context, ArgValue)
  if not value.isOk:
    return cmdFail[int32](value.error)
  let newName = text(value.value)
  if team.displayName == newName:
    return cmdFail[int32](createWithoutContext(err0(JAVA_COMMANDS_TEAM_OPTION_NAME_UNCHANGED)))
  team.displayName = newName
  update(world, team)
  sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_OPTION_NAME_SUCCESS, [team.displayName, newName]), true)
  cmdOk[int32](1'i32)

proc modifyAffixExecutor(prefix: bool): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    let value = getString(context, ArgValue)
    if not value.isOk:
      return cmdFail[int32](value.error)
    let affix = text(value.value)
    if prefix:
      team.playerPrefix = affix
    else:
      team.playerSuffix = affix
    update(world, team)
    sendFeedback(context.source, tc(if prefix: JAVA_COMMANDS_TEAM_OPTION_PREFIX_SUCCESS else: JAVA_COMMANDS_TEAM_OPTION_SUFFIX_SUCCESS,
      [team.displayName, affix]), true)
    cmdOk[int32](1'i32)

proc modifyFlagExecutor(bit: int8; alreadyEnabled, alreadyDisabled, enabled, disabled: string): CommandExecutor =
  ## `friendlyFire` (0x01) and `seeFriendlyInvisibles` (0x02).
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    let value = getBool(context, ArgValue)
    if not value.isOk:
      return cmdFail[int32](value.error)
    let isEnabled = (team.options and bit) != 0'i8
    if value.value == isEnabled:
      return cmdFail[int32](createWithoutContext(err0(if value.value: alreadyEnabled else: alreadyDisabled)))
    if value.value:
      team.options = team.options or bit
    else:
      team.options = team.options and not bit
    update(world, team)
    let key = if value.value: enabled else: disabled
    sendFeedback(context.source, tc(key, [team.displayName]), true)
    cmdOk[int32](1'i32)

proc modifyNametagVisibilityExecutor(value: int32): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    if team.nametagVisibility == value:
      return cmdFail[int32](createWithoutContext(err0(JAVA_COMMANDS_TEAM_OPTION_NAMETAGVISIBILITY_UNCHANGED)))
    team.nametagVisibility = value
    update(world, team)
    sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_OPTION_NAMETAGVISIBILITY_SUCCESS,
      [team.displayName, text(VisibilityNames[int(value)])]), true)
    cmdOk[int32](1'i32)

proc modifyDeathMessageVisibilityExecutor(value: string): CommandExecutor =
  ## Upstream only reports it: the team keeps no such field.
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_OPTION_DEATHMESSAGEVISIBILITY_SUCCESS,
      [team.displayName, text(value)]), true)
    cmdOk[int32](1'i32)

proc modifyCollisionRuleExecutor(value: int32): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var team = CmdTeamInfo()
    let found = lookupTeam(context, world, team)
    if not found.isOk:
      return cmdFail[int32](found.error)
    if team.collisionRule == value:
      return cmdFail[int32](createWithoutContext(err0(JAVA_COMMANDS_TEAM_OPTION_COLLISIONRULE_UNCHANGED)))
    team.collisionRule = value
    update(world, team)
    sendFeedback(context.source, tc(JAVA_COMMANDS_TEAM_OPTION_COLLISIONRULE_SUCCESS,
      [team.displayName, text(CollisionNames[int(value)])]), true)
    cmdOk[int32](1'i32)

proc teamArg(): ArgumentBuilder = argument(ArgTeam, newTeamArgumentType())

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))
  let addBranch = then(literal("add"), then(executes(argument(ArgTeamName, newStringArgumentType(spSingleWord)), teamAddExecutor(false)),
    executes(argument(ArgDisplayName, newStringArgumentType(spGreedyPhrase)), teamAddExecutor(true))))
  let removeBranch = then(literal("remove"), executes(teamArg(), teamRemoveExecutor))
  let emptyBranch = then(literal("empty"), executes(teamArg(), teamEmptyExecutor))
  let joinBranch = then(literal("join"), then(executes(teamArg(), teamJoinExecutor(false)),
    executes(argument(ArgMembers, newEntityArgumentType(eakEntities)), teamJoinExecutor(true))))
  let leaveBranch = then(executes(literal("leave"), teamLeaveExecutor(false)),
    executes(argument(ArgMembers, newEntityArgumentType(eakEntities)), teamLeaveExecutor(true)))
  let listBranch = then(executes(literal("list"), teamListExecutor(false)), executes(teamArg(), teamListExecutor(true)))
  var modify = teamArg()
  modify = then(modify, then(literal("color"), executes(argument(ArgValue, newTeamColorArgumentType()), modifyColorExecutor)))
  modify = then(modify, then(literal("displayName"), executes(argument(ArgValue, newStringArgumentType(spGreedyPhrase)), modifyDisplayNameExecutor)))
  modify = then(modify, then(literal("prefix"), executes(argument(ArgValue, newStringArgumentType(spGreedyPhrase)), modifyAffixExecutor(true))))
  modify = then(modify, then(literal("suffix"), executes(argument(ArgValue, newStringArgumentType(spGreedyPhrase)), modifyAffixExecutor(false))))
  modify = then(modify, then(literal("friendlyFire"), executes(argument(ArgValue, newBoolArgumentType()),
    modifyFlagExecutor(0x01'i8, JAVA_COMMANDS_TEAM_OPTION_FRIENDLYFIRE_ALREADYENABLED, JAVA_COMMANDS_TEAM_OPTION_FRIENDLYFIRE_ALREADYDISABLED,
      JAVA_COMMANDS_TEAM_OPTION_FRIENDLYFIRE_ENABLED, JAVA_COMMANDS_TEAM_OPTION_FRIENDLYFIRE_DISABLED))))
  modify = then(modify, then(literal("seeFriendlyInvisibles"), executes(argument(ArgValue, newBoolArgumentType()),
    modifyFlagExecutor(0x02'i8, JAVA_COMMANDS_TEAM_OPTION_SEEFRIENDLYINVISIBLES_ALREADYENABLED,
      JAVA_COMMANDS_TEAM_OPTION_SEEFRIENDLYINVISIBLES_ALREADYDISABLED, JAVA_COMMANDS_TEAM_OPTION_SEEFRIENDLYINVISIBLES_ENABLED,
      JAVA_COMMANDS_TEAM_OPTION_SEEFRIENDLYINVISIBLES_DISABLED))))
  var nametag = literal("nametagVisibility")
  var death = literal("deathMessageVisibility")
  var collision = literal("collisionRule")
  for i in 0 ..< 4:
    nametag = then(nametag, executes(literal(VisibilityNames[i]), modifyNametagVisibilityExecutor(int32(i))))
    death = then(death, executes(literal(VisibilityNames[i]), modifyDeathMessageVisibilityExecutor(VisibilityNames[i])))
    collision = then(collision, executes(literal(CollisionNames[i]), modifyCollisionRuleExecutor(int32(i))))
  modify = then(modify, nametag)
  modify = then(modify, death)
  modify = then(modify, collision)
  var root = requires(command("team", Description), Permission0)
  root = then(root, addBranch)
  root = then(root, removeBranch)
  root = then(root, emptyBranch)
  root = then(root, joinBranch)
  root = then(root, leaveBranch)
  root = then(root, listBranch)
  root = then(root, then(literal("modify"), modify))
  discard register(dispatcher, root)
