## The `/teammsg` command.
## Port of pumpkin/src/command/commands/teammsg.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, cmddispatch, entity_selector, coordinates]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Sends a message to your team."
  Permission0 = "minecraft:command.teammsg"
  ArgMessage = "message"

proc noTeamError(): CommandErrorType = errorType0(JAVA_COMMANDS_TEAMMSG_FAILED_NOTEAM, JAVA_COMMANDS_TEAMMSG_FAILED_NOTEAM)

proc teamMsgExecutor(context: CommandContext): CmdResult[int32] =
  let player = playerOrErr(context.source)
  if not player.isOk:
    return cmdFail[int32](player.error)
  let senderName = player.value.gameProfile.name
  let world = context.source.world
  if world == nil or not closureSet(world.getTeamOf):
    return cmdFail[int32](createWithoutContext(noTeamError()))
  var team = CmdTeamInfo()
  if not world.getTeamOf(senderName, team):
    return cmdFail[int32](createWithoutContext(noTeamError()))
  let teamDisplayName = colorNamed(team.displayName, team.color)
  let senderDisplayName = context.source.displayName
  let message = getString(context, ArgMessage)
  if not message.isOk:
    return cmdFail[int32](message.error)
  let messageComponent = text(message.value)
  var sentCount = 0'i32
  var onlinePlayers: seq[CommandPlayer] = @[]
  if closureSet(world.getPlayers):
    onlinePlayers = world.getPlayers()
  for p in onlinePlayers:
    if p.gameProfile.name in team.players:
      let key = if p.gameProfile.name == senderName: JAVA_CHAT_TYPE_TEAM_SENT else: JAVA_CHAT_TYPE_TEAM_TEXT
      if closureSet(p.sendSystemMessage):
        p.sendSystemMessage(tc(key, [teamDisplayName, senderDisplayName, messageComponent]))
      inc sentCount
  cmdOk[int32](sentCount)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionAllow()))
  discard register(dispatcher, then(requires(command("teammsg", Description), Permission0),
    executes(argument(ArgMessage, newStringArgumentType(spGreedyPhrase)), teamMsgExecutor)))
  discard register(dispatcher, then(requires(command("tm", Description), Permission0),
    executes(argument(ArgMessage, newStringArgumentType(spGreedyPhrase)), teamMsgExecutor)))
