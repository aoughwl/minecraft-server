## The `/teleport` command.
## Port of pumpkin/src/command/commands/teleport.rs

import std/[math, options]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../generated/translation
import ../../util/[vector2, vector3]
import ../../util/text/[textbase, text]
import cmdcommon

const
  Names = ["teleport", "tp"]
  Description = "Teleports entities, including players."
  ArgLocation = "location"
  ArgDestination = "destination"
  ArgTargets = "targets"
  ArgRotation = "rotation"
  ArgFacingEntity = "facingEntity"
  ArgFacingLocation = "facingLocation"

proc yawPitchFacingPosition(lookingFrom, lookingTowards: Vector3[float64]): (float32, float32) =
  let dx = lookingTowards.x - lookingFrom.x
  let dy = lookingTowards.y - lookingFrom.y
  let dz = lookingTowards.z - lookingFrom.z
  let length = sqrt(dx * dx + dy * dy + dz * dz)
  let nx = dx / length
  let ny = dy / length
  let nz = dz / length
  let yawRadians = -arctan2(nx, nz)
  let pitchRadians = arcsin(-ny)
  (float32(radToDeg(yawRadians)), float32(radToDeg(pitchRadians)))

proc isValidWorldPos(pos: Vector3[float64]): bool =
  ## `World::is_valid(BlockPos(pos.floor_to_i32()))`.
  let p = floorToI32(pos)
  p.x >= -30_000_000'i32 and p.x < 30_000_000'i32 and p.z >= -30_000_000'i32 and p.z < 30_000_000'i32 and
    p.y >= -20_000_000'i32 and p.y < 20_000_000'i32

proc invalidPosition(): CommandResult =
  cmdFailed(tc(JAVA_COMMANDS_TELEPORT_INVALIDPOSITION))

proc resolveSenderWorld(sender: CommandSender; server: nil CommandServer): nil CommandWorld =
  if server == nil:
    return nil
  worldOrFirst(sender, server)

proc teleportTo(target: CommandEntity; pos: Vector3[float64]; yaw, pitch: float32; world: nil CommandWorld) =
  if target.teleport != nil and world != nil:
    target.teleport(pos, some(yaw), some(pitch), world)

proc rotationOf(e: CommandEntity): Vector2[float32] =
  ## (pitch, yaw).
  if e.getRotation != nil: e.getRotation() else: Vector2[float32](x: 0.0'f32, y: 0.0'f32)

proc oneEntity(args: ConsumedArgs; name: string; res: var CommandEntity): CommandResult =
  var list: seq[CommandEntity] = @[]
  if not findEntity(args, name, list) or list.len == 0:
    return missing(name)
  res = list[0]
  cmdSuccess(0'i32)

proc entitiesToEntityExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, ArgTargets, targets):
    return missing(ArgTargets)
  var destination = CommandEntity()
  let d = oneEntity(args, ArgDestination, destination)
  if not d.isOk:
    return d
  let pos = destination.getPos()
  let rot = rotationOf(destination)
  if not isValidWorldPos(pos):
    return invalidPosition()
  let world = destination.getWorld()
  for target in targets:
    teleportTo(target, pos, rot.y, rot.x, world)
  cmdSuccess(int32(targets.len))

proc entitiesToPosFacingPosExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, ArgTargets, targets):
    return missing(ArgTargets)
  var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, pos):
    return missing(ArgLocation)
  if not isValidWorldPos(pos):
    return invalidPosition()
  var facing = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgFacingLocation, facing):
    return missing(ArgFacingLocation)
  let (yaw, pitch) = yawPitchFacingPosition(pos, facing)
  let world = resolveSenderWorld(sender, server)
  for target in targets:
    teleportTo(target, pos, yaw, pitch, world)
  cmdSuccess(int32(targets.len))

proc entitiesToPosFacingEntityExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, ArgTargets, targets):
    return missing(ArgTargets)
  var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, pos):
    return missing(ArgLocation)
  if not isValidWorldPos(pos):
    return invalidPosition()
  var facing = CommandEntity()
  let f = oneEntity(args, ArgFacingEntity, facing)
  if not f.isOk:
    return f
  let (yaw, pitch) = yawPitchFacingPosition(pos, facing.getPos())
  let world = resolveSenderWorld(sender, server)
  for target in targets:
    teleportTo(target, pos, yaw, pitch, world)
  cmdSuccess(int32(targets.len))

proc entitiesToPosWithRotationExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, ArgTargets, targets):
    return missing(ArgTargets)
  var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, pos):
    return missing(ArgLocation)
  if not isValidWorldPos(pos):
    return invalidPosition()
  var rotation = Arg()
  if not findRotation(args, ArgRotation, rotation):
    return missing(ArgRotation)
  let world = resolveSenderWorld(sender, server)
  # Upstream reads the two values and ignores whether they are relative.
  for target in targets:
    teleportTo(target, pos, rotation.yaw, rotation.pitch, world)
  cmdSuccess(int32(targets.len))

proc entitiesToPosExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandEntity] = @[]
  if not findEntities(args, ArgTargets, targets):
    return missing(ArgTargets)
  var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, pos):
    return missing(ArgLocation)
  if not isValidWorldPos(pos):
    return invalidPosition()
  let world = resolveSenderWorld(sender, server)
  for target in targets:
    let rot = rotationOf(target)
    teleportTo(target, pos, rot.y, rot.x, world)
  cmdSuccess(int32(targets.len))

proc selfToEntityExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var destination = CommandEntity()
  let d = oneEntity(args, ArgDestination, destination)
  if not d.isOk:
    return d
  let pos = destination.getPos()
  let rot = rotationOf(destination)
  if not isValidWorldPos(pos):
    return invalidPosition()
  if sender.kind != cskPlayer:
    return cmdFailed(tc(JAVA_PERMISSIONS_REQUIRES_PLAYER))
  teleportTo(sender.player.entity, pos, rot.y, rot.x, destination.getWorld())
  cmdSuccess(1'i32)

proc selfToPosExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if sender.kind != cskPlayer:
    return cmdFailed(tc(JAVA_PERMISSIONS_REQUIRES_PLAYER))
  var pos = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
  if not findPos3D(args, ArgLocation, pos):
    return missing(ArgLocation)
  if not isValidWorldPos(pos):
    return invalidPosition()
  let rot = rotationOf(sender.player.entity)
  teleportTo(sender.player.entity, pos, rot.y, rot.x, sender.player.entity.getWorld())
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  let facing = then(then(literal("facing"),
      then(literal("entity"), execute(argument(ArgFacingEntity, newEntityArgumentConsumer()), entitiesToPosFacingEntityExecutor))),
    execute(argument(ArgFacingLocation, newPosition3DArgumentConsumer()), entitiesToPosFacingPosExecutor))
  let toLocation = then(then(execute(argument(ArgLocation, newPosition3DArgumentConsumer()), entitiesToPosExecutor),
      execute(argument(ArgRotation, newRotationArgumentConsumer()), entitiesToPosWithRotationExecutor)),
    facing)
  let targets = then(then(argument(ArgTargets, newEntitiesArgumentConsumer()), toLocation),
    execute(argument(ArgDestination, newEntityArgumentConsumer()), entitiesToEntityExecutor))
  then(then(then(newCommandTree(Names, Description),
      execute(argument(ArgLocation, newPosition3DArgumentConsumer()), selfToPosExecutor)),
      execute(argument(ArgDestination, newEntityArgumentConsumer()), selfToEntityExecutor)),
    targets)
