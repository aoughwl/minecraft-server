## The `/tellraw` command.
## Port of pumpkin/src/command/commands/tellraw.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["tellraw"]
  Description = "Send raw message to players."
  ArgTargets = "targets"
  ArgMessage = "message"

proc tellRawExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var t = text("")
  if not findText(args, ArgMessage, t):
    return missing(ArgMessage)
  for target in targets:
    if target.sendSystemMessage != nil:
      target.sendSystemMessage(t)
  cmdSuccess(int32(targets.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(argument(ArgTargets, newPlayersArgumentConsumer()),
    execute(argument(ArgMessage, newTextComponentArgConsumer()), tellRawExecutor)))
