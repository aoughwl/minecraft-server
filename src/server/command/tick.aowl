## The `/tick` command.
## Port of pumpkin/src/command/commands/tick.rs

import std/[algorithm, math, options, strutils]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch, suggestion]
import ../../util/permission
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import ../../protocol/java/client/play/commands
import cmdcommon

const
  Description = "Controls or queries the game's ticking state."
  Permission0 = "minecraft:command.tick"

type
  SubCommand = enum
    scQuery
    scRate
    scFreeze
    scUnfreeze
    scStepDefault
    scStepTimed
    scStepStop
    scSprintTimed
    scSprintStop

proc nanosToMillisString(nanos: int64): string =
  ## `format!("{:.2}", nanos as f64 / 1_000_000.0)`.
  formatFloat(float64(nanos) / 1_000_000.0, ffDecimal, 2)

proc oneDecimal(v: float64): string = formatFloat(v, ffDecimal, 1)

proc feedback(source: CommandSource; key: string; broadcast: bool) =
  sendFeedback(source, tc(key), broadcast)

proc handleQuery(source: CommandSource; server: CommandServer): CmdResult[int32] =
  let tickRate = if server.getTickRate != nil: server.getTickRate() else: 20.0'f32
  let avgNanos = if server.getAverageTickTimeNanos != nil: server.getAverageTickTimeNanos() else: 0'i64
  let avgMspt = nanosToMillisString(avgNanos)
  let perTick = if server.getNanosecondsPerTick != nil: server.getNanosecondsPerTick() else: 50_000_000'i64
  if server.isTickSprinting != nil and server.isTickSprinting():
    feedback(source, JAVA_COMMANDS_TICK_STATUS_SPRINTING, false)
    sendFeedback(source, tc(JAVA_COMMANDS_TICK_QUERY_RATE_SPRINTING, [text(oneDecimal(float64(tickRate))), text(avgMspt)]), false)
  else:
    if server.isTickFrozen != nil and server.isTickFrozen():
      feedback(source, JAVA_COMMANDS_TICK_STATUS_FROZEN, false)
    elif avgNanos > perTick:
      feedback(source, JAVA_COMMANDS_TICK_STATUS_LAGGING, false)
    else:
      feedback(source, JAVA_COMMANDS_TICK_STATUS_RUNNING, false)
    sendFeedback(source, tc(JAVA_COMMANDS_TICK_QUERY_RATE_RUNNING,
      [text(oneDecimal(float64(tickRate))), text(avgMspt), text(nanosToMillisString(perTick))]), false)
  # `send_percentiles`
  var times: seq[int64] = @[]
  if server.getTickTimesNanos != nil:
    times = server.getTickTimesNanos()
  let sampleSize = times.len
  if sampleSize > 0:
    sort(times, proc(a, b: int64): int = cmp(a, b))
    let p50 = times[sampleSize div 2]
    let p95 = times[int(floor(float32(sampleSize) * 0.95'f32))]
    let p99 = times[int(floor(float32(sampleSize) * 0.99'f32))]
    sendFeedback(source, tc(JAVA_COMMANDS_TICK_QUERY_PERCENTILES,
      [text(nanosToMillisString(p50)), text(nanosToMillisString(p95)), text(nanosToMillisString(p99)), text($sampleSize)]), true)
  cmdOk[int32](int32(tickRate))

proc handleStep(source: CommandSource; server: CommandServer; ticks: int32) =
  if server.stepGameIfPaused != nil and server.stepGameIfPaused(ticks):
    sendFeedback(source, tc(JAVA_COMMANDS_TICK_STEP_SUCCESS, [text($ticks)]), true)
  else:
    sendFeedback(source, colorNamed(tc(JAVA_COMMANDS_TICK_STEP_FAIL), ncRed), true)

proc handleSprint(source: CommandSource; server: CommandServer; ticks: int32) =
  if server.requestGameToSprint != nil and server.requestGameToSprint(int64(ticks)):
    sendFeedback(source, tc(JAVA_COMMANDS_TICK_SPRINT_STOP_SUCCESS), true)
  sendFeedback(source, tc(JAVA_COMMANDS_TICK_STATUS_SPRINTING), true)

proc tickExecutor(sub: SubCommand): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let source = context.source
    let server = source.server
    if server == nil:
      return cmdOk[int32](0'i32)
    case sub
    of scQuery:
      return handleQuery(source, server)
    of scRate:
      let rate = getFloat(context, "rate")
      if not rate.isOk:
        return cmdFail[int32](rate.error)
      if server.setTickRate != nil:
        server.setTickRate(rate.value)
      sendFeedback(source, tc(JAVA_COMMANDS_TICK_RATE_SUCCESS, [text(oneDecimal(float64(rate.value)))]), true)
      return cmdOk[int32](int32(rate.value))
    of scFreeze, scUnfreeze:
      let freeze = sub == scFreeze
      if server.setTickFrozen != nil:
        server.setTickFrozen(freeze)
      let key = if freeze: "commands.tick.status.frozen" else: "commands.tick.status.running"
      sendFeedback(source, translate(key, []), true)
      return cmdOk[int32](if freeze: 1'i32 else: 0'i32)
    of scStepDefault:
      handleStep(source, server, 1'i32)
      return cmdOk[int32](1'i32)
    of scStepTimed:
      let ticks = getInt(context, "time")
      if not ticks.isOk:
        return cmdFail[int32](ticks.error)
      handleStep(source, server, ticks.value)
      return cmdOk[int32](1'i32)
    of scStepStop:
      if server.stopTickStepping != nil and server.stopTickStepping():
        sendFeedback(source, tc(JAVA_COMMANDS_TICK_SPRINT_STOP_SUCCESS), true)
        return cmdOk[int32](1'i32)
      sendError(source, tc(JAVA_COMMANDS_TICK_SPRINT_STOP_FAIL))
      return cmdOk[int32](0'i32)
    of scSprintTimed:
      let ticks = getInt(context, "time")
      if not ticks.isOk:
        return cmdFail[int32](ticks.error)
      handleSprint(source, server, ticks.value)
      return cmdOk[int32](1'i32)
    of scSprintStop:
      if server.stopTickSprinting != nil and server.stopTickSprinting():
        sendFeedback(source, tc(JAVA_COMMANDS_TICK_SPRINT_STOP_SUCCESS), true)
        return cmdOk[int32](1'i32)
      sendError(source, colorNamed(tc(JAVA_COMMANDS_TICK_SPRINT_STOP_FAIL), ncRed))
      return cmdOk[int32](0'i32)

proc tickSuggestions(names: seq[string]): SuggestionProvider =
  result = proc(context: CommandContext; builder: SuggestionsBuilder): Suggestions {.closure.} =
    var b = builder
    for n in names:
      b = suggest(b, n)
    build(b)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Three)))
  var root = requires(command("tick", Description), Permission0)
  root = then(root, executes(literal("query"), tickExecutor(scQuery)))
  root = then(root, then(literal("rate"), executes(suggests(argument("rate", newFloatArgumentType(1.0'f32, 10000.0'f32)),
    tickSuggestions(@["20"])), tickExecutor(scRate))))
  root = then(root, executes(literal("freeze"), tickExecutor(scFreeze)))
  root = then(root, executes(literal("unfreeze"), tickExecutor(scUnfreeze)))
  var step = executes(literal("step"), tickExecutor(scStepDefault))
  step = then(step, executes(literal("stop"), tickExecutor(scStepStop)))
  step = then(step, executes(suggests(argument("time", newTimeArgumentType(1'i32)), tickSuggestions(@["1t", "1s"])),
    tickExecutor(scStepTimed)))
  root = then(root, step)
  var sprint = literal("sprint")
  sprint = then(sprint, executes(literal("stop"), tickExecutor(scSprintStop)))
  sprint = then(sprint, executes(suggests(argument("time", newTimeArgumentType(1'i32)),
    tickSuggestions(@["60s", "1d", "3d"])), tickExecutor(scSprintTimed)))
  root = then(root, sprint)
  discard register(dispatcher, root)
