## The `/time` command.
## Port of pumpkin/src/command/commands/time.rs

import ../../util/closureset
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

type
  QueryMode = enum
    qmDayTime
    qmGameTime
    qmDay

const
  Names = ["time"]
  Description = "Query the world time."
  ArgTime = "time"
  PresetNone = -1'i32

proc firstWorld(server: nil CommandServer): nil CommandWorld =
  if server == nil or not closureSet(server.getWorlds):
    return nil
  let worlds = server.getWorlds()
  if worlds.len == 0:
    return nil
  worlds[0]

proc queryExecutor(mode: QueryMode): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    let world = firstWorld(server)
    if world == nil:
      return cmdInvalidRequirement()
    var current = 0'i64
    var bedrockKey = BEDROCK_COMMANDS_TIME_QUERY_DAYTIME
    case mode
    of qmDayTime:
      if closureSet(world.queryDaytime):
        current = world.queryDaytime()
    of qmGameTime:
      bedrockKey = BEDROCK_COMMANDS_TIME_QUERY_GAMETIME
      if closureSet(world.queryGametime):
        current = world.queryGametime()
    of qmDay:
      bedrockKey = BEDROCK_COMMANDS_TIME_QUERY_DAY
      if closureSet(world.queryDay):
        current = world.queryDay()
    sendMessage(sender, translateCross(JAVA_COMMANDS_TIME_QUERY, bedrockKey, [text($current)]))
    cmdSuccess(cast[int32](uint32(cast[uint64](current) and 0xFFFFFFFF'u64)))

proc changeExecutor(isAdd: bool; preset: int32): FallbackExecutor =
  ## `preset` is `Mode::Set(Some(_))`'s ticks, or `PresetNone`.
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var timeCount = preset
    if preset == PresetNone and not findTime(args, ArgTime, timeCount):
      return cmdFailed(text("Invalid time specified."))
    let world = firstWorld(server)
    if world == nil:
      return cmdInvalidRequirement()
    if isAdd:
      if closureSet(world.addTime):
        world.addTime(int64(timeCount))
      var current = 0'i64
      if closureSet(world.queryDaytime):
        current = world.queryDaytime()
      sendMessage(sender, translateCross(JAVA_COMMANDS_TIME_SET, BEDROCK_COMMANDS_TIME_SET, [text($current)]))
      cmdSuccess(cast[int32](uint32(cast[uint64](current) and 0xFFFFFFFF'u64)))
    else:
      if closureSet(world.setTime):
        world.setTime(int64(timeCount))
      sendMessage(sender, translateCross(JAVA_COMMANDS_TIME_SET, BEDROCK_COMMANDS_TIME_SET, [text($timeCount)]))
      cmdSuccess(timeCount)

proc initCommandTree*(): CommandTree =
  var query = literal("query")
  query = then(query, execute(literal("daytime"), queryExecutor(qmDayTime)))
  query = then(query, execute(literal("gametime"), queryExecutor(qmGameTime)))
  query = then(query, execute(literal("day"), queryExecutor(qmDay)))
  var setN = literal("set")
  setN = then(setN, execute(literal("day"), changeExecutor(false, 1000'i32)))
  setN = then(setN, execute(literal("noon"), changeExecutor(false, 6000'i32)))
  setN = then(setN, execute(literal("night"), changeExecutor(false, 13000'i32)))
  setN = then(setN, execute(literal("midnight"), changeExecutor(false, 18000'i32)))
  setN = then(setN, execute(argument(ArgTime, newTimeArgumentConsumer()), changeExecutor(false, PresetNone)))
  let add = then(literal("add"), execute(argument(ArgTime, newTimeArgumentConsumer()), changeExecutor(true, PresetNone)))
  then(then(then(newCommandTree(Names, Description), add), query), setN)
