## The `/title` command.
## Port of pumpkin/src/command/commands/title.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["title"]
  Description = "Displays a title."
  ArgTargets = "targets"
  ArgTitle = "title"
  ArgFadeIn = "fadeIn"
  ArgStay = "stay"
  ArgFadeOut = "fadeOut"

proc clearOrResetExecutor(reset: bool): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var targets: seq[CommandPlayer] = @[]
    if not findPlayers(args, ArgTargets, targets):
      return missing(ArgTargets)
    for target in targets:
      if target.clearTitle != nil:
        target.clearTitle(reset)
    if targets.len == 1:
      sendMessage(sender, tc(if reset: "commands.title.reset.single" else: "commands.title.cleared.single", [shown(targets[0])]))
    else:
      sendMessage(sender, tc(if reset: "commands.title.reset.multiple" else: "commands.title.cleared.multiple", [text($targets.len)]))
    cmdSuccess(int32(targets.len))

proc modeName(mode: CmdTitleMode): string =
  ## `format!("{mode:?}").to_lowercase()`.
  case mode
  of ctmTitle: "title"
  of ctmSubTitle: "subtitle"
  of ctmActionBar: "actionbar"

proc titleExecutor(mode: CmdTitleMode): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var targets: seq[CommandPlayer] = @[]
    if not findPlayers(args, ArgTargets, targets):
      return missing(ArgTargets)
    var t = text("")
    if not findText(args, ArgTitle, t):
      return missing(ArgTitle)
    for target in targets:
      if target.showTitle != nil:
        target.showTitle(t, mode)
    if targets.len == 1:
      sendMessage(sender, tc("commands.title.show." & modeName(mode) & ".single", [shown(targets[0])]))
    else:
      sendMessage(sender, tc("commands.title.show." & modeName(mode) & ".multiple", [text($targets.len)]))
    cmdSuccess(int32(targets.len))

proc timesTitleExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgTargets, targets):
    return missing(ArgTargets)
  var fadeIn = 0'i32
  var stay = 0'i32
  var fadeOut = 0'i32
  if not findTime(args, ArgFadeIn, fadeIn):
    return missing(ArgFadeIn)
  if not findTime(args, ArgStay, stay):
    return missing(ArgStay)
  if not findTime(args, ArgFadeOut, fadeOut):
    return missing(ArgFadeOut)
  for target in targets:
    if target.sendTitleAnimation != nil:
      target.sendTitleAnimation(fadeIn, stay, fadeOut)
  if targets.len == 1:
    sendMessage(sender, tc("commands.title.times.single", [shown(targets[0])]))
  else:
    sendMessage(sender, tc("commands.title.times.multiple", [text($targets.len)]))
  cmdSuccess(int32(targets.len))

proc titleBranch(name: string; mode: CmdTitleMode): NonLeafNodeBuilder =
  then(literal(name), execute(argument(ArgTitle, newTextComponentArgConsumer()), titleExecutor(mode)))

proc initCommandTree*(): CommandTree =
  var a = argument(ArgTargets, newPlayersArgumentConsumer())
  a = then(a, execute(literal("clear"), clearOrResetExecutor(false)))
  a = then(a, execute(literal("reset"), clearOrResetExecutor(true)))
  a = then(a, titleBranch("title", ctmTitle))
  a = then(a, titleBranch("subtitle", ctmSubTitle))
  a = then(a, titleBranch("actionbar", ctmActionBar))
  a = then(a, then(literal("times"), then(argument(ArgFadeIn, newTimeArgumentConsumer()), then(argument(ArgStay, newTimeArgumentConsumer()),
    execute(argument(ArgFadeOut, newTimeArgumentConsumer()), timesTitleExecutor)))))
  then(newCommandTree(Names, Description), a)
