## The `/tps` command.
## Port of pumpkin/src/command/commands/tps.rs

import std/[math, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

const
  Names = ["tps"]
  Description = "Displays the server TPS and MSPT."

proc fixed(v: float64; digits: int): string =
  ## `format!("{v:.N}")`.
  formatFloat(v, ffDecimal, digits)

proc tpsExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil:
    return cmdInvalidRequirement()
  let maxTps = if server.configuredTps != nil: server.configuredTps() else: 20.0
  let tps = min(if server.getTps != nil: server.getTps() else: 0.0, maxTps)
  let mspt = if server.getMspt != nil: server.getMspt() else: 0.0
  let tpsColor =
    if tps >= maxTps * 0.9: ncGreen
    elif tps >= maxTps * 0.75: ncYellow
    else: ncRed
  var message = text("TPS: ")
  message = addChild(message, colorNamed(text(fixed(tps, 1)), tpsColor))
  message = addChild(message, text(" MSPT: "))
  message = addChild(message, colorNamed(text(fixed(mspt, 2) & "ms"), tpsColor))
  sendMessage(sender, message)
  cmdSuccess(int32(tps))

proc initCommandTree*(): CommandTree =
  execute(newCommandTree(Names, Description), tpsExecutor)
