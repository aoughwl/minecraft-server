## `/tps`, `/reload` and `/return` through a real dispatch.
##
## This test used to fail with "expected reloadProc to have been called" for the same reason as saveseedtest.aowl: a
## closure capturing a `var` of a module-level `block` writes to its own copy. A compiler bug, not a command bug.
import std/[assertions, syncio]
import ../../command/[cmderrors, cmdsource, cmdtree, cmddispatch, fallbackdispatch]
import tps, reload, returncmd, cmdtestutil

proc tpsBlock() =
  let d = newCommandDispatcher()
  register(d.fallbackDispatcher, tps.initCommandTree(), "pumpkin:command.tps")
  let server = newServer()
  server.getTps = proc(): float64 {.closure.} = 19.98
  server.getMspt = proc(): float64 {.closure.} = 12.3
  server.configuredTps = proc(): float64 {.closure.} = 20.0
  var buffer = RconBuffer(lines: @[])
  let res = dispatch(d.fallbackDispatcher, senderRcon(buffer), server, "tps")
  assert res.isOk, "expected /tps to succeed"
  assert buffer.lines.len == 1

proc reloadBlock() =
  let d = newCommandDispatcher()
  reload.register(d)
  var reloaded = false
  let server = newServer()
  server.reloadDatapacks = proc() {.closure.} = reloaded = true
  let r = executeInput(d, "reload", consoleSource(server, nil))
  assert r.isOk, "expected /reload to succeed"
  assert reloaded, "expected reloadProc to have been called"

proc returnValueBlock() =
  let d = newCommandDispatcher()
  returncmd.register(d)
  let r = executeInput(d, "return 42", dummySource())
  assert r.isOk, "expected return 42 to succeed"
  assert r.value == 42'i32, "expected the return value to be echoed back"

proc returnFailBlock() =
  let d = newCommandDispatcher()
  returncmd.register(d)
  let r = executeInput(d, "return fail", dummySource())
  assert r.isOk, "expected return fail to succeed"
  assert r.value == 0'i32

tpsBlock()
reloadBlock()
returnValueBlock()
returnFailBlock()
echo "tps/reload/return command tests: all checks passed"
