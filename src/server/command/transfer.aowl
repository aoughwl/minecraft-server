## The `/transfer` command.
## Port of pumpkin/src/command/commands/transfer.rs

import ../../util/closureset
import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["transfer"]
  Description = "Triggers a transfer of a player to another server."
  ArgHostname = "hostname"
  ArgPlayers = "players"

proc portConsumer(): ArgumentConsumer = newBoundedI32("port", some(1'i32), some(65535'i32))

proc portOf(args: ConsumedArgs; port: var int32): CommandResult =
  var a = Arg()
  if not findNum(args, "port", a):
    port = 25565'i32
    return cmdSuccess(0'i32)
  if not a.numInBounds:
    return missing("Port must be between 1 and 65535.")
  port = a.num.i32
  cmdSuccess(0'i32)

proc targetSelfExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var hostname = ""
  if not findString(args, ArgHostname, akSimple, hostname):
    return missing(ArgHostname)
  var port = 0'i32
  let p = portOf(args, port)
  if not p.isOk:
    return p
  if sender.kind != cskPlayer:
    return cmdInvalidRequirement()
  if closureSet(sender.player.transfer):
    sender.player.transfer(hostname, port)
  cmdSuccess(1'i32)

proc targetPlayerExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var hostname = ""
  if not findString(args, ArgHostname, akSimple, hostname):
    return missing(ArgHostname)
  var port = 0'i32
  let p = portOf(args, port)
  if not p.isOk:
    return p
  var players: seq[CommandPlayer] = @[]
  if not findPlayers(args, ArgPlayers, players):
    return missing(ArgPlayers)
  if players.len == 0:
    return cmdFailed(tc("commands.transfer.error.no_players"))
  for player in players:
    if closureSet(player.transfer):
      player.transfer(hostname, port)
  if players.len == 1:
    sendMessage(sender, tc("commands.transfer.success.single", [shown(players[0]), text(hostname), text($port)]))
  else:
    sendMessage(sender, tc("commands.transfer.success.multiple", [text($players.len), text(hostname), text($port)]))
  cmdSuccess(int32(players.len))

proc initCommandTree*(): CommandTree =
  then(newCommandTree(Names, Description), then(then(argument(ArgHostname, newSimpleArgConsumer()),
    execute(require(isPlayerSender), targetSelfExecutor)),
    then(then(argumentDefaultName(portConsumer()), execute(require(isPlayerSender), targetSelfExecutor)),
      execute(argument(ArgPlayers, newPlayersArgumentConsumer()), targetPlayerExecutor))))
