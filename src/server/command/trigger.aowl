## The `/trigger` command.
## Port of pumpkin/src/command/commands/trigger.rs

import std/options
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, argument_types, cmddispatch]
import ../../util/permission
import ../../util/text/[textbase, text]
import ../../generated/translation
import cmdcommon

const
  Description = "Modifies a trigger scoreboard objective."
  Permission0 = "minecraft:command.trigger"
  ArgObjective = "objective"
  ArgValue = "value"

type TriggerMode = enum
  tmSimple
  tmAdd
  tmSet

proc invalidTriggerError(): CommandErrorType =
  errorType0(JAVA_COMMANDS_TRIGGER_FAILED_INVALID, JAVA_COMMANDS_TRIGGER_FAILED_INVALID)

proc unprimedTriggerError(): CommandErrorType =
  errorType0(JAVA_COMMANDS_TRIGGER_FAILED_UNPRIMED, JAVA_COMMANDS_TRIGGER_FAILED_UNPRIMED)

proc triggerExecutor(mode: TriggerMode): CommandExecutor =
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    let player = playerOrErr(context.source)
    if not player.isOk:
      return cmdFail[int32](player.error)
    let playerName = player.value.gameProfile.name
    let objectiveName = getString(context, ArgObjective)
    if not objectiveName.isOk:
      return cmdFail[int32](objectiveName.error)
    var value = 0'i32
    if mode != tmSimple:
      let v = getInt(context, ArgValue)
      if not v.isOk:
        return cmdFail[int32](v.error)
      value = v.value
    let world = context.source.world
    if world == nil:
      return cmdOk[int32](0'i32)
    var objective = CmdObjective()
    if world.getObjective == nil or not world.getObjective(objectiveName.value, objective):
      return cmdFail[int32](createWithoutContext(invalidTriggerError()))
    if objective.criterion != "trigger":
      return cmdFail[int32](createWithoutContext(invalidTriggerError()))
    var current = CmdScore()
    let has = world.getScoreEntry != nil and world.getScoreEntry(playerName, objectiveName.value, current)
    # `is_none_or(|s| s.locked)`
    if not has or current.locked:
      return cmdFail[int32](createWithoutContext(unprimedTriggerError()))
    let newValue =
      case mode
      of tmSimple: current.value + 1'i32
      of tmAdd: current.value + value
      of tmSet: value
    if world.setScoreEntry != nil:
      world.setScoreEntry(playerName, objectiveName.value, newValue, true)
    let msg =
      case mode
      of tmSimple: tc(JAVA_COMMANDS_TRIGGER_SIMPLE_SUCCESS, [objective.displayName])
      of tmAdd: tc(JAVA_COMMANDS_TRIGGER_ADD_SUCCESS, [objective.displayName, text($value)])
      of tmSet: tc(JAVA_COMMANDS_TRIGGER_SET_SUCCESS, [objective.displayName, text($value)])
    sendFeedback(context.source, msg, false)
    cmdOk[int32](newValue)

proc register*(dispatcher: CommandDispatcher; registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionAllow()))
  var objective = executes(argument(ArgObjective, newObjectiveArgumentType()), triggerExecutor(tmSimple))
  objective = then(objective, then(literal("add"), executes(argument(ArgValue, newIntegerArgumentType()), triggerExecutor(tmAdd))))
  objective = then(objective, then(literal("set"), executes(argument(ArgValue, newIntegerArgumentType()), triggerExecutor(tmSet))))
  discard register(dispatcher, then(requires(command("trigger", Description), Permission0), objective))
