## The `/weather` command.
## Port of pumpkin/src/command/commands/weather.rs

import ../../util/closureset
import std/[options, random]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text, ../../util/text/color
import ../../generated/translation

type WeatherMode = enum
  wmClear
  wmRain
  wmThunder

const
  Names = ["weather"]
  Description = "Changes the weather."
  ArgDuration = "duration"

proc weatherExecutor(mode: WeatherMode): FallbackExecutor =
  result = proc(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult {.closure.} =
    var duration = 0'i32
    let hasDuration = findTime(args, ArgDuration, duration)
    if server == nil or not closureSet(server.getWorlds):
      return cmdInvalidRequirement()
    let worlds = server.getWorlds()
    if worlds.len == 0:
      return cmdInvalidRequirement()
    let world = worlds[0]
    case mode
    of wmClear:
      let processed = if hasDuration: duration else: int32(rand(12000 .. 180000))
      if closureSet(world.setWeatherParameters):
        world.setWeatherParameters(processed, 0'i32, false, false)
      sendMessage(sender, translateCross(JAVA_COMMANDS_WEATHER_SET_CLEAR, BEDROCK_COMMANDS_WEATHER_CLEAR))
    of wmRain:
      let processed = if hasDuration: duration else: int32(rand(12000 .. 24000))
      if closureSet(world.setWeatherParameters):
        world.setWeatherParameters(0'i32, processed, true, false)
      sendMessage(sender, translateCross(JAVA_COMMANDS_WEATHER_SET_RAIN, BEDROCK_COMMANDS_WEATHER_RAIN))
    of wmThunder:
      let processed = if hasDuration: duration else: int32(rand(3600 .. 15600))
      if closureSet(world.setWeatherParameters):
        world.setWeatherParameters(0'i32, processed, true, true)
      sendMessage(sender, translateCross(JAVA_COMMANDS_WEATHER_SET_THUNDER, BEDROCK_COMMANDS_WEATHER_THUNDER))
    cmdSuccess(if hasDuration: duration else: -1'i32)

proc branch(name: string; mode: WeatherMode): NonLeafNodeBuilder =
  execute(then(literal(name), execute(argument(ArgDuration, newTimeArgumentConsumer()), weatherExecutor(mode))), weatherExecutor(mode))

proc initCommandTree*(): CommandTree =
  then(then(then(newCommandTree(Names, Description), branch("clear", wmClear)), branch("rain", wmRain)), branch("thunder", wmThunder))
