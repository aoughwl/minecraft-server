## The `/whitelist` command.
## Port of pumpkin/src/command/commands/whitelist.rs

import std/[options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3, uuid, permission]
import ../../util/math/position
import ../../util/text/[textbase, text, color]
import ../../generated/translation
import cmdcommon

const
  Names = ["whitelist"]
  Description = "Manage server whitelists."
  ArgTargets = "targets"

proc kickNonWhitelistedPlayers(server: CommandServer) =
  let enforce = server.enforceWhitelist != nil and server.enforceWhitelist()
  let enabled = server.whiteListEnabled != nil and server.whiteListEnabled()
  if enforce and enabled and server.getAllPlayers != nil and server.isWhitelisted != nil:
    let players = server.getAllPlayers()
    for player in players:
      if not server.isWhitelisted(player.gameProfile) and player.kick != nil:
        player.kick(tc(JAVA_MULTIPLAYER_DISCONNECT_NOT_WHITELISTED))

proc onExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil or server.swapWhiteList == nil:
    return cmdInvalidRequirement()
  if server.swapWhiteList(true):
    return cmdFailed(tc(JAVA_COMMANDS_WHITELIST_ALREADYON))
  kickNonWhitelistedPlayers(server)
  sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_ENABLED))
  cmdSuccess(1'i32)

proc offExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil or server.swapWhiteList == nil:
    return cmdInvalidRequirement()
  if server.swapWhiteList(false):
    sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_DISABLED))
    return cmdSuccess(1'i32)
  cmdFailed(tc(JAVA_COMMANDS_WHITELIST_ALREADYOFF))

proc listExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var whitelist: seq[CmdListEntry] = @[]
  if server != nil and server.getWhitelist != nil:
    whitelist = server.getWhitelist()
  if whitelist.len == 0:
    sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_NONE))
    return cmdSuccess(0'i32)
  var names = ""
  var i = 0
  while i < whitelist.len:
    if i > 0:
      names.add(", ")
    names.add(whitelist[i].name)
    inc i
  sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_LIST, [text($whitelist.len), text(names)]))
  # Upstream returns the joined string's length.
  cmdSuccess(int32(names.len))

proc reloadExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  if server == nil:
    return cmdInvalidRequirement()
  if server.reloadWhitelist != nil:
    server.reloadWhitelist()
  kickNonWhitelistedPlayers(server)
  sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_RELOADED))
  cmdSuccess(1'i32)

proc addExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CmdGameProfile] = @[]
  if not findGameProfiles(args, ArgTargets, targets):
    return missing(ArgTargets)
  if server == nil:
    return cmdInvalidRequirement()
  var successes = 0'i32
  for profile in targets:
    var existing = false
    if server.getWhitelist != nil:
      let list = server.getWhitelist()
      for entry in list:
        if entry.id == profile.id:
          existing = true
          if entry.name != profile.name and server.renameWhitelist != nil:
            server.renameWhitelist(profile.id, profile.name)
    if existing:
      continue
    if server.addWhitelist != nil:
      server.addWhitelist(CmdListEntry(id: profile.id, name: profile.name))
    sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_ADD_SUCCESS, [text(profile.name)]))
    inc successes
  if server.saveWhitelist != nil:
    server.saveWhitelist()
  if successes == 0'i32:
    return cmdFailed(tc(JAVA_COMMANDS_WHITELIST_ADD_FAILED))
  cmdSuccess(successes)

proc removeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var targets: seq[CmdGameProfile] = @[]
  if not findGameProfiles(args, ArgTargets, targets):
    return missing(ArgTargets)
  if server == nil:
    return cmdInvalidRequirement()
  var successes = 0'i32
  for player in targets:
    if server.removeWhitelist != nil and server.removeWhitelist(player.id):
      sendMessage(sender, tc(JAVA_COMMANDS_WHITELIST_REMOVE_SUCCESS, [text(player.name)]))
      inc successes
  if server.saveWhitelist != nil:
    server.saveWhitelist()
  kickNonWhitelistedPlayers(server)
  if successes == 0'i32:
    return cmdFailed(tc(JAVA_COMMANDS_WHITELIST_REMOVE_FAILED))
  cmdSuccess(successes)

proc initCommandTree*(): CommandTree =
  var t = newCommandTree(Names, Description)
  t = then(t, execute(literal("on"), onExecutor))
  t = then(t, execute(literal("off"), offExecutor))
  t = then(t, execute(literal("list"), listExecutor))
  t = then(t, execute(literal("reload"), reloadExecutor))
  t = then(t, then(literal("add"), execute(argument(ArgTargets, newGameProfilesArgumentConsumer(gpsNonWhitelistedOnlinePlayers, false)), addExecutor)))
  then(t, then(literal("remove"), execute(argument(ArgTargets, newGameProfilesArgumentConsumer(gpsWhitelistedNames, false)), removeExecutor)))
