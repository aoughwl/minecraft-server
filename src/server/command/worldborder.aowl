## The `/worldborder` command.
## Port of pumpkin/src/command/commands/worldborder.rs

import std/[math, options, strutils]
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector2, vector3]
import ../../util/text/[textbase, text]
import cmdcommon

const
  Names = ["worldborder"]
  Description = "Worldborder command."
  NothingChangedException = "commands.worldborder.set.failed.nochange"
  ArgDistance = "distance"
  ArgTime = "time"
  ArgDamagePerBlock = "damage_per_block"
  ArgBuffer = "buffer"
  ArgPos = "pos"                ## `Position2DArgumentConsumer`'s default name.

proc distanceConsumer(): ArgumentConsumer = newBoundedF64(ArgDistance, some(0.0))
proc timeConsumer(): ArgumentConsumer = newBoundedI32(ArgTime, some(0'i32))
proc damagePerBlockConsumer(): ArgumentConsumer = newBoundedF32(ArgDamagePerBlock, some(0.0'f32))
proc damageBufferConsumer(): ArgumentConsumer = newBoundedF32(ArgBuffer, some(0.0'f32))
proc warningDistanceConsumer(): ArgumentConsumer = newBoundedI32(ArgDistance, some(0'i32))

proc fixed(v: float64; digits: int): string =
  ## `format!("{v:.N}")`.
  formatFloat(v, ffDecimal, digits)

proc outOfBounds(): CommandResult =
  ## `"{} is out of bounds."` with the distance consumer's name, as every executor writes it.
  cmdFailed(text(ArgDistance & " is out of bounds."))

proc nothingChanged(): CommandResult = cmdFailed(translateCross(NothingChangedException, NothingChangedException))

proc borderWorld(server: nil CommandServer): nil CommandWorld =
  ## `server.worlds.first()`.
  firstWorld(server)

proc getExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  let diameter = int32(round(world.getBorder().newDiameter))
  sendMessage(sender, tc("commands.worldborder.get", [text($diameter)]))
  cmdSuccess(diameter)

proc setExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var distance = 0.0
  if not requireF64(args, ArgDistance, distance).isOk:
    return outOfBounds()
  let border = world.getBorder()
  if abs(distance - border.newDiameter) < 2.220446049250313e-16:
    return nothingChanged()
  sendMessage(sender, tc("commands.worldborder.set.immediate", [text(fixed(distance, 1))]))
  if world.setBorderDiameter != nil:
    world.setBorderDiameter(distance, false, 0'i64)
  cmdSuccess(clampI32(int64(distance - border.newDiameter)))

proc sendGrowShrink(sender: CommandSender; distance: float64; time: int32; shrink: bool) =
  let key = if shrink: "commands.worldborder.set.shrink" else: "commands.worldborder.set.grow"
  sendMessage(sender, tc(key, [text(fixed(distance, 1)), text($time)]))

proc setTimeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var distance = 0.0
  if not requireF64(args, ArgDistance, distance).isOk:
    return outOfBounds()
  var time = 0'i32
  if not requireI32(args, ArgTime, time).isOk:
    return outOfBounds()
  let border = world.getBorder()
  if distance == border.newDiameter:
    return nothingChanged()
  sendGrowShrink(sender, distance, time, distance < border.newDiameter)
  if world.setBorderDiameter != nil:
    world.setBorderDiameter(distance, true, int64(time) * 1000'i64)
  cmdSuccess(clampI32(int64(distance - border.newDiameter)))

proc addExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var distanceAdd = 0.0
  if not requireF64(args, ArgDistance, distanceAdd).isOk:
    return outOfBounds()
  if distanceAdd == 0.0:
    return nothingChanged()
  let distance = world.getBorder().newDiameter + distanceAdd
  sendMessage(sender, tc("commands.worldborder.set.immediate", [text(fixed(distance, 1))]))
  if world.setBorderDiameter != nil:
    world.setBorderDiameter(distance, false, 0'i64)
  cmdSuccess(clampI32(int64(distanceAdd)))

proc addTimeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var distanceAdd = 0.0
  if not requireF64(args, ArgDistance, distanceAdd).isOk:
    return outOfBounds()
  var time = 0'i32
  if not requireI32(args, ArgTime, time).isOk:
    return outOfBounds()
  let current = world.getBorder().newDiameter
  let distance = distanceAdd + current
  if distance == current:
    return outOfBounds()
  sendGrowShrink(sender, distance, time, distance < current)
  if world.setBorderDiameter != nil:
    world.setBorderDiameter(distance, true, int64(time) * 1000'i64)
  cmdSuccess(clampI32(int64(distanceAdd)))

proc centerExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil:
    return cmdInvalidRequirement()
  var pos = Vector2[float64](x: 0.0, y: 0.0)
  if not findPos2D(args, ArgPos, pos):
    return missing(ArgPos)
  sendMessage(sender, tc("commands.worldborder.center.success", [text(fixed(pos.x, 2)), text(fixed(pos.y, 2))]))
  if world.setBorderCenter != nil:
    world.setBorderCenter(pos.x, pos.y)
  cmdSuccess(0'i32)

proc damageAmountExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var damage = 0.0'f32
  if not requireF32(args, ArgDamagePerBlock, damage).isOk:
    return outOfBounds()
  if abs(damage - world.getBorder().damagePerBlock) < 1.1920929e-7'f32:
    return cmdFailed(tc("commands.worldborder.damage.amount.failed"))
  sendMessage(sender, tc("commands.worldborder.damage.amount.success", [text(fixed(float64(damage), 2))]))
  if world.setBorderDamageAmount != nil:
    world.setBorderDamageAmount(damage)
  cmdSuccess(int32(damage))

proc damageBufferExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var buffer = 0.0'f32
  if not requireF32(args, ArgBuffer, buffer).isOk:
    return outOfBounds()
  if abs(buffer - world.getBorder().buffer) < 1.1920929e-7'f32:
    # Upstream reuses the damage amount's key here.
    return cmdFailed(tc("commands.worldborder.damage.amount.failed"))
  sendMessage(sender, tc("commands.worldborder.damage.buffer.success", [text(fixed(float64(buffer), 2))]))
  if world.setBorderDamageBuffer != nil:
    world.setBorderDamageBuffer(buffer)
  cmdSuccess(int32(buffer))

proc warningDistanceExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var distance = 0'i32
  if not requireI32(args, ArgDistance, distance).isOk:
    return outOfBounds()
  if distance == world.getBorder().warningBlocks:
    return cmdFailed(tc("commands.worldborder.warning.distance.failed"))
  sendMessage(sender, tc("commands.worldborder.warning.distance.success", [text($distance)]))
  if world.setBorderWarningDistance != nil:
    world.setBorderWarningDistance(distance)
  cmdSuccess(distance)

proc warningTimeExecutor(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  let world = borderWorld(server)
  if world == nil or world.getBorder == nil:
    return cmdInvalidRequirement()
  var time = 0'i32
  if not requireI32(args, ArgTime, time).isOk:
    return outOfBounds()
  if time == world.getBorder().warningTime:
    return cmdFailed(tc("commands.worldborder.warning.time.failed"))
  sendMessage(sender, tc("commands.worldborder.warning.time.success", [text($time)]))
  if world.setBorderWarningDelay != nil:
    world.setBorderWarningDelay(time)
  cmdSuccess(time)

proc initCommandTree*(): CommandTree =
  var t = newCommandTree(Names, Description)
  t = then(t, then(literal("add"), then(execute(argument(ArgDistance, distanceConsumer()), addExecutor),
    execute(argument(ArgTime, timeConsumer()), addTimeExecutor))))
  t = then(t, then(literal("center"), execute(argument(ArgPos, newPosition2DArgumentConsumer()), centerExecutor)))
  t = then(t, then(then(literal("damage"), then(literal("amount"),
    execute(argument(ArgDamagePerBlock, damagePerBlockConsumer()), damageAmountExecutor))),
    then(literal("buffer"), execute(argument(ArgBuffer, damageBufferConsumer()), damageBufferExecutor))))
  t = then(t, execute(literal("get"), getExecutor))
  t = then(t, then(literal("set"), then(execute(argument(ArgDistance, distanceConsumer()), setExecutor),
    execute(argument(ArgTime, timeConsumer()), setTimeExecutor))))
  then(t, then(then(literal("warning"), then(literal("distance"),
    execute(argument(ArgDistance, warningDistanceConsumer()), warningDistanceExecutor))),
    then(literal("time"), execute(argument(ArgTime, timeConsumer()), warningTimeExecutor))))
