## Round trip and layout of command_storage.aowl, in a scratch folder under the temp directory.
import std/[syncio, options]
import ../nbt/[tag, nbt_compress]
import ../world/worldfs
import command_storage

var failures = 0

proc chk(cond: bool; what: string) =
  if not cond:
    echo "FAIL ", what
    inc failures

proc run() =
  let folder = "command_storage_test_data"
  var s = newCommandStorage(folder)
  var a = newCompound()
  a.putInt("x", 5'i32)
  a.putString("s", "hello")
  s.setStorage("demo:thing", a)
  var b = newCompound()
  b.putLong("l", 9'i64)
  s.setStorage("plain", b)
  s.setStorage("demo:other/path", b)
  chk(s.dirty.len == 2, "two namespaces dirty")
  chk(s.getStorage("demo:thing") == a, "get back")
  chk(s.getStorage("minecraft:plain") == b, "default namespace is minecraft")
  chk(s.getStorage("demo:none").isEmpty, "missing is empty")
  chk(saveCommandStorage(s), "save")
  chk(s.dirty.len == 0, "clean after save")
  chk(fileExistsW(folder & "/command_storage_demo.dat"), "demo file")
  chk(fileExistsW(folder & "/command_storage_minecraft.dat"), "minecraft file")
  # the vanilla layout
  let (st, bytes) = readFileBytes(folder & "/command_storage_demo.dat")
  chk(st == rsOk, "read raw")
  let parsed = readGzipCompoundTag(bytes)
  chk(parsed.isOk, "gzip nbt")
  if parsed.isOk:
    let root = parsed.value
    chk(root.getInt("DataVersion").isSome, "DataVersion present")
    let (hd, d) = root.get("data")
    chk(hd and d.kind == ntkCompound, "data compound")
    let (hc, c) = d.compoundVal.get("contents")
    chk(hc and c.kind == ntkCompound and c.compoundVal.has("thing") and c.compoundVal.has("other/path"), "contents keyed by path")
  let loaded = loadCommandStorage(folder)
  chk(loaded.getStorage("demo:thing") == a, "reload demo:thing")
  chk(loaded.getStorage("demo:other/path") == b, "reload nested path")
  chk(loaded.getStorage("plain") == b, "reload minecraft")
  chk(loaded.dirty.len == 0, "load leaves it clean")
  discard removeFileW(folder & "/command_storage_demo.dat")
  discard removeFileW(folder & "/command_storage_minecraft.dat")

run()
if failures > 0:
  echo "command_storagetest: ", failures, " FAILED"
  quit(1)
echo "command_storagetest ok"
