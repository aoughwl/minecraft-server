## The non-player entities of a world as `CommandEntity`s, which is what `@e` and `/kill`, `/tp`, `/damage` reach for. Upstream's
## `World::entities` holds `Arc<dyn EntityBase>` that commands use directly; this port's commands go through the `CommandEntity`
## record of src/command/cmdsource.aowl, which commandbridge.aowl builds for players and this builds for the rest.
##
## Only what a mob can answer is filled: the position, name, type, life, kill, remove, teleport within the world, tags, damage and
## the bounding box. The attribute commands (`/attribute`) and NBT are left nil; `/item` sets equipment through `setEquipment`, as a command checks.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[options, strutils]
import ../command/cmdsource
import ../generated/[damage_type, item_full]
import "../data/item_stack/mod"
import ../inventory/entity_equipment
import ../util/[uuid, vector2, vector3]
import ../util/math/boundingbox
import ../util/text/text
import serverbase
import entity/entitymod

type CommandWorldFor* = proc(world: World): CommandWorld {.closure.}

proc commandEntityOfBase*(base: EntityBase; worldFor: CommandWorldFor): CommandEntity =
  let entity = base.entity
  result = CommandEntity(uuid: entity.entityUuid, entityId: entity.entityId,
    entityTypeId: "minecraft:" & entity.entityType.resourceName, entityTypeName: entity.entityType.resourceName,
    isLiving: base.living != nil)
  result.getName = proc(): TextComponent {.closure.} = base.getName()
  result.getDisplayName = proc(): TextComponent {.closure.} = base.getDisplayName()
  result.getPos = proc(): Vector3[float64] {.closure.} = entity.pos
  result.getRotation = proc(): Vector2[float32] {.closure.} = Vector2[float32](x: entity.pitch, y: entity.yaw)
  result.getEyeHeight = proc(): float64 {.closure.} = float64(entity.entityType.eyeHeight)
  result.getWorld = proc(): nil CommandWorld {.closure.} = worldFor(entity.world)
  result.isAlive = proc(): bool {.closure.} =
    not entity.isRemoved() and (base.living == nil or mustLiving(base).health > 0.0'f32)
  result.remove = proc() {.closure.} = entity.remove()
  result.kill = proc() {.closure.} = base.kill(base)
  result.teleport = proc(pos: Vector3[float64]; yaw, pitch: Option[float32]; world: CommandWorld) {.closure.} =
    base.teleport(pos, yaw, pitch, entity.world)
  result.getScoreboardTags = proc(): seq[string] {.closure.} = entity.scoreboardTags
  result.addScoreboardTag = proc(tag: string): bool {.closure.} =
    if tag in entity.scoreboardTags:
      return false
    entity.scoreboardTags.add(tag)
    true
  result.removeScoreboardTag = proc(tag: string): bool {.closure.} =
    let at = find(entity.scoreboardTags, tag)
    if at < 0:
      return false
    entity.scoreboardTags.delete(at)
    true
  result.getBoundingBox = proc(): BoundingBox {.closure.} = entity.boundingBox
  result.getCustomName = proc(): Option[TextComponent] {.closure.} = entity.customName
  result.setEquipment = proc(slot: string; stack: CmdItemStack): bool {.closure.} =
    ## `/item replace entity <mob> armor.head ...`: the slot of the living entity's equipment, then the packet to its watchers.
    if base.living == nil:
      return false
    let which =
      case slot
      of "mainhand": esMainHand
      of "offhand": esOffHand
      of "feet": esFeet
      of "legs": esLegs
      of "chest": esChest
      of "head": esHead
      of "body": esBody
      of "saddle": esSaddle
      else: return false
    var s = emptyItemStack()
    if stack.itemKey.len > 0:
      let key = if stack.itemKey.startsWith("minecraft:"): stack.itemKey[10 ..< stack.itemKey.len] else: stack.itemKey
      let it = Item.fromRegistryKey(key)
      if it == nil:
        return false
      s = newItemStack(uint8(stack.count), it)
    let living = mustLiving(base)
    discard living.entityEquipment.put(which, s)
    living.sendEquipmentChanges([(which, s)])
    true
  result.damageWithContext = proc(amount: float32; damageType: string; location: Option[Vector3[float64]];
                                  source, cause: nil CommandEntity): bool {.closure.} =
    let (found, kind) = damageTypeFromName(if damageType.startsWith("minecraft:"): damageType.substr(10) else: damageType)
    # `/damage ... by <source> from <cause>`: the command's entities are found again by id in the target's world.
    var sourceBase: nil EntityBase = nil
    var causeBase: nil EntityBase = nil
    if source != nil:
      sourceBase = getEntityById(entity.world, source.entityId)
    if cause != nil:
      causeBase = getEntityById(entity.world, cause.entityId)
    base.damageWithContext(base, amount, (if found: kind else: GENERIC), location, sourceBase, causeBase)

proc commandMobs*(world: World; worldFor: CommandWorldFor): seq[CommandEntity] =
  ## Every entity of the world that is not a player.
  result = @[]
  for base in allEntities(world):
    if base.player == nil:
      result.add(commandEntityOfBase(base, worldFor))
