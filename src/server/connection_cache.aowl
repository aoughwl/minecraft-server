## Port of pumpkin/src/server/connection_cache.rs
##
## Upstream caches one `CachedStatus` and updates it as players come and go. Here `buildStatusResponse` is called per
## request from the live player list, so the cache is a favicon loaded once (`loadFavicon`, held on the Server) and the
## sample is taken from the players that are in the world now. `enforce_secure_chat` is `true` as upstream's (it only
## stops the client's "chat can't be verified" popup; the login packet carries the real `allow_chat_reports`).

import std/[options, base64, syncio, strutils]
import ../config/lib
import ../generated/default_icon
import ../protocol/proto
import ../protocol/java/client/status/status_response
import ../protocol/java/client/config/plugin_message
import ../protocol/netcodec
import ../protocol/protobase
import ../util/javaversion

const BrandName = "aowlmony"

proc getBranding*(): CPluginMessage =
  ## `CachedBranding`: the `minecraft:brand` channel, holding a protocol string.
  var w = newNetWriter()
  discard writeString(w, BrandName)
  CPluginMessage(channel: "minecraft:brand", data: w.buf)

const MaxSamplePlayers* = 12

proc iconFromBytes(png: string): string =
  "data:image/png;base64," & encode(png)

proc defaultIcon*(): string =
  "data:image/png;base64," & DefaultIconPngBase64

proc loadFavicon*(config: BasicConfiguration): Option[string] =
  ## `build_response`'s favicon: the configured PNG when it is a 64x64 one, else the default icon; none when disabled.
  if not config.useFavicon:
    echo "Favicon usage is disabled."
    return none[string]()
  if config.faviconPath.isNone:
    return some(defaultIcon())
  let path = config.faviconPath.unsafeGet
  if path.len < 4 or path[path.len - 4 ..< path.len].toLowerAscii() != ".png":
    echo "Favicon is not a PNG-image, using default."
    return some(defaultIcon())
  var buf = ""
  try:
    buf = readFile(path)
  except ErrorCode:
    echo "Failed to load favicon from '", path, "': not found; using default."
    return some(defaultIcon())
  if buf.len >= 24:
    let width = (uint32(ord(buf[16])) shl 24) or (uint32(ord(buf[17])) shl 16) or (uint32(ord(buf[18])) shl 8) or uint32(ord(buf[19]))
    let height = (uint32(ord(buf[20])) shl 24) or (uint32(ord(buf[21])) shl 16) or (uint32(ord(buf[22])) shl 8) or uint32(ord(buf[23]))
    if width != 64'u32 or height != 64'u32:
      echo "Failed to load favicon from '", path, "': other error: Invalid favicon dimensions (must be 64x64); using default."
      return some(defaultIcon())
  if buf.len == 0:
    return some(defaultIcon())
  some(iconFromBytes(buf))

proc buildStatusResponse*(motd: string; maxPlayers, online: uint32; favicon: Option[string] = none[string]();
    sample: seq[Sample] = @[]): StatusResponse =
  ## `build_response`: `LOWEST-CURRENT` as the version name and the lowest supported protocol, as upstream.
  StatusResponse(
    version: some(Version(name: $LowestSupportedMcVersion & "-" & $CurrentMcVersion,
      protocol: uint32(LowestSupportedMcVersion.protocolVersion()))),
    players: some(Players(max: maxPlayers, online: online, sample: sample)),
    description: motd, favicon: favicon,
    # This should stay true even when reports are disabled. It prevents the popup when joining the server.
    enforceSecureChat: true)

proc getStatusPacket*(base: StatusResponse; clientProtocol: int32): CStatusResponse =
  ## `get_status_packet`: a supported client is told its own protocol, so it does not show "outdated".
  var response = base
  let supportedMin = LowestSupportedMcVersion.protocolVersion()
  let supportedMax = CurrentMcVersion.protocolVersion()
  if clientProtocol >= supportedMin and clientProtocol <= supportedMax and response.version.isSome:
    var v = response.version.unsafeGet
    v.protocol = uint32(clientProtocol)
    response.version = some(v)
  CStatusResponse(jsonResponse: toJson(response))
