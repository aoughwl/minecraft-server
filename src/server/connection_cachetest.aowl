## `connection_cache`: the favicon loading branches and the status JSON, against what upstream's `build_response` and
## `get_status_packet` give.
import std/[assertions, options, syncio, base64, strutils]
import ../config/lib
import ../protocol/proto
import ../protocol/java/client/status/status_response
import ../util/javaversion
import connection_cache

proc be32(v: int): string =
  result = ""
  result.add(chr((v shr 24) and 255))
  result.add(chr((v shr 16) and 255))
  result.add(chr((v shr 8) and 255))
  result.add(chr(v and 255))

proc pngHeader(w, h: int): string =
  ## 8 signature bytes, IHDR length + type, then the width and height (big endian): the 24 bytes upstream reads.
  "\x89PNG\r\n\x1a\n\x00\x00\x00\x0dIHDR" & be32(w) & be32(h) & "\x08\x06\x00\x00\x00"

proc put(path, data: string) =
  try:
    writeFile(path, data)
  except ErrorCode:
    assert false, "cannot write " & path

proc run() =
  var cfg = defaultBasicConfiguration()
  # default: the bundled icon
  let d = loadFavicon(cfg)
  assert d.isSome and d.unsafeGet == defaultIcon()
  assert d.unsafeGet.startsWith("data:image/png;base64,")
  let raw = decode(d.unsafeGet["data:image/png;base64,".len .. ^1])
  assert raw.len == 7601
  assert raw[0 ..< 8] == "\x89PNG\r\n\x1a\n"
  # disabled: no favicon at all
  cfg.useFavicon = false
  assert loadFavicon(cfg).isNone
  cfg.useFavicon = true
  # not a png extension: default
  cfg.faviconPath = some("icon.jpg")
  assert loadFavicon(cfg).unsafeGet == defaultIcon()
  # missing png: default
  cfg.faviconPath = some("no_such_favicon_file.png")
  assert loadFavicon(cfg).unsafeGet == defaultIcon()
  # 64x64: used verbatim
  let good = pngHeader(64, 64) & "rest"
  put("cachetest_good.png", good)
  cfg.faviconPath = some("cachetest_good.png")
  assert loadFavicon(cfg).unsafeGet == "data:image/png;base64," & encode(good)
  # upper-case extension is a png as well (eq_ignore_ascii_case)
  put("cachetest_good2.PnG", good)
  cfg.faviconPath = some("cachetest_good2.PnG")
  assert loadFavicon(cfg).unsafeGet == "data:image/png;base64," & encode(good)
  # wrong size: default
  put("cachetest_big.png", pngHeader(128, 64) & "rest")
  cfg.faviconPath = some("cachetest_big.png")
  assert loadFavicon(cfg).unsafeGet == defaultIcon()
  put("cachetest_tall.png", pngHeader(64, 65) & "rest")
  cfg.faviconPath = some("cachetest_tall.png")
  assert loadFavicon(cfg).unsafeGet == defaultIcon()

  # the status JSON: version range, the lowest protocol, secure chat true, a player sample
  let st = buildStatusResponse("A \"motd\"", 20'u32, 2'u32, none[string](),
    @[Sample(name: "A", id: "00000000-0000-0000-0000-000000000001")])
  let want = "{\"version\":{\"name\":\"1.20.5-26.2\",\"protocol\":766},\"players\":{\"max\":20,\"online\":2,\"sample\":" &
    "[{\"name\":\"A\",\"id\":\"00000000-0000-0000-0000-000000000001\"}]},\"description\":\"A \\\"motd\\\"\"," &
    "\"favicon\":null,\"enforceSecureChat\":true}"
  assert toJson(st) == want, toJson(st)
  # a client inside the range is told its own protocol, one outside gets the lowest
  assert getStatusPacket(st, 774'i32).jsonResponse.contains("\"protocol\":774")
  assert getStatusPacket(st, 765'i32).jsonResponse.contains("\"protocol\":766")
  assert getStatusPacket(st, 9999'i32).jsonResponse.contains("\"protocol\":766")
  echo "connection_cache ok"

run()
