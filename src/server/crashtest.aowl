## Test for crash.aowl: the report's exact text for a fixed time and system, the file name, and a report saved to disk.

import std/[assertions, syncio, os, envvars]
from std/paths import path, Path
import std/dirs
import logging
import crash

proc scratchDir(name: string): string =
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  result = base & "/" & name
  discard tryCreateFinalDir(path(result))
  assert dirExists(result), result

proc run() =
  let t = DateTime(year: 2026, month: 11, day: 9, hour: 4, minute: 5, second: 7)
  var report = CrashReport(time: t, message: "index out of bounds", location: "src/x.aowl:10:5", threadName: "main",
    threadId: "ThreadId(1)", backtrace: @["0x401000", "0x402000"])
  let system = SystemDetails(available: true, osVersion: "Windows 11", usedMemoryMib: 100'u64, totalMemoryMib: 200'u64,
    freeMemoryMib: 100'u64, usedSwapMib: 1'u64, totalSwapMib: 4'u64, freeSwapMib: 3'u64, cores: 8)
  let expected = "====== Pumpkin Crash Report ======\n\nTime: 2026-11-09 04:05:07.0 +00:00:00\nMessage: index out of bounds\n" &
    "Panic Location: src/x.aowl:10:5\n\n--- Panicking Thread ---\nID: ThreadId(1)\nName: main\nBacktrace:\n  0: 0x401000\n" &
    "  1: 0x402000\n\n--- Server Details ---\nPumpkin Version: " & ServerVersion & "\nMinecraft Version: 1.21.11\n" &
    "Server compiled with aowlmony\n\n--- System Details ---\nOperating System: Windows 11\n" &
    "Physical Memory: 100 MiB/200 MiB used, 100 MiB free\nSwap Memory: 1 MiB/4 MiB used, 3 MiB free\n\nTotal cores: 8\n\n"
  assert generateFileContent(report, system) == expected
  report.message = ""
  report.location = ""
  let bare = generateFileContent(report, SystemDetails(available: false))
  assert bare.len > 0 and bare[0 ..< 34] == "====== Pumpkin Crash Report ======"
  assert crashFileName(t) == "crash-2026-11-09_04.05.07.txt"
  assert timeText(t) == "2026-11-09 04:05:07.0 +00:00:00"

  # The live system query answers something sensible.
  let live = querySystem()
  assert live.available and live.cores >= 1 and live.totalMemoryMib > 0'u64
  let trace = captureBacktrace(0)
  assert trace.len > 0 and trace[0][0 ..< 2] == "0x"

  # Saved, once; a second report at the same second is refused, as `File::create_new` does.
  let dir = scratchDir("crashtest") & "/crash-reports"
  discard tryCreateFinalDir(path(dir))
  try:
    let target = dir & "/" & crashFileName(t)
    if fileExists(target):
      removeFile(path(target))
  except ErrorCode:
    discard
  let (ok, where0) = save(CrashReport(time: t, message: "m", location: "", threadName: "main", threadId: "ThreadId(1)",
    backtrace: @[]), dir)
  assert ok and where0 == dir & "/crash-2026-11-09_04.05.07.txt", where0
  var text = ""
  try:
    text = readFile(where0)
  except ErrorCode:
    assert false
  assert text[0 ..< 6] == "======" and text.len > 100
  let (again, why) = save(CrashReport(time: t, message: "m", location: "", threadName: "main", threadId: "ThreadId(1)",
    backtrace: @[]), dir)
  assert not again and why.len > 0
  echo "crashtest ok"

run()
