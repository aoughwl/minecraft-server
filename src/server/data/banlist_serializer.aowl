## Port of pumpkin/src/data/banlist_serializer.rs
##
## Dates are seconds since the Unix epoch; `format::date` is `formatBanDate` and `parseBanDate`, on the shape
## "2006-01-02 15:04:05+00:00". `expires` of -1 is `None`, "forever" on disk. Entries hold a `Uuid` and strings only, so
## a `GameProfile` is passed apart.

import std/times
import ../../codecs/json_value
import ../../util/uuid

const NoExpiry* = -1'i64

type
  BannedPlayerEntry* = object
    uuid*: Uuid
    name*: string
    created*: int64
    source*: string
    expires*: int64
    reason*: string

  BannedIpEntry* = object
    ip*: string
    created*: int64
    source*: string
    expires*: int64
    reason*: string

proc nowUtcSeconds*(): int64 =
  int64(toUnix(getTime()))

proc pad(n: int64; width: int): string =
  result = $n
  while result.len < width:
    result = "0" & result

proc civilFromDays(days: int64): (int64, int64, int64) =
  ## Days since 1970-01-01 to (year, month, day), proleptic Gregorian.
  let z = days + 719468'i64
  let era = (if z >= 0'i64: z else: z - 146096'i64) div 146097'i64
  let doe = z - era * 146097'i64
  let yoe = (doe - doe div 1460'i64 + doe div 36524'i64 - doe div 146096'i64) div 365'i64
  let doy = doe - (365'i64 * yoe + yoe div 4'i64 - yoe div 100'i64)
  let mp = (5'i64 * doy + 2'i64) div 153'i64
  let d = doy - (153'i64 * mp + 2'i64) div 5'i64 + 1'i64
  let m = if mp < 10'i64: mp + 3'i64 else: mp - 9'i64
  let y = yoe + era * 400'i64 + (if m <= 2'i64: 1'i64 else: 0'i64)
  (y, m, d)

proc daysFromCivil(y0, m, d: int64): int64 =
  let y = if m <= 2'i64: y0 - 1'i64 else: y0
  let era = (if y >= 0'i64: y else: y - 399'i64) div 400'i64
  let yoe = y - era * 400'i64
  let doy = (153'i64 * (m + (if m > 2'i64: -3'i64 else: 9'i64)) + 2'i64) div 5'i64 + d - 1'i64
  let doe = yoe * 365'i64 + yoe div 4'i64 - yoe div 100'i64 + doy
  era * 146097'i64 + doe - 719468'i64

proc formatBanDate*(seconds: int64): string =
  ## `DATE_FORMAT`: `[year]-[month]-[day] [hour]:[minute]:[second][offset_hour sign:mandatory]:[offset_minute]`, in UTC.
  let days = (if seconds >= 0'i64: seconds else: seconds - 86399'i64) div 86400'i64
  let rest = seconds - days * 86400'i64
  let (y, m, d) = civilFromDays(days)
  pad(y, 4) & "-" & pad(m, 2) & "-" & pad(d, 2) & " " & pad(rest div 3600'i64, 2) & ":" &
    pad((rest mod 3600'i64) div 60'i64, 2) & ":" & pad(rest mod 60'i64, 2) & "+00:00"

proc digits(s: string; at, count: int; ok: var bool): int64 =
  result = 0'i64
  if at + count > s.len:
    ok = false
    return
  for i in at ..< at + count:
    if s[i] < '0' or s[i] > '9':
      ok = false
      return
    result = result * 10'i64 + int64(ord(s[i]) - ord('0'))

proc parseBanDate*(s: string): (bool, int64) =
  ## Reads `formatBanDate`'s shape, with or without a space before the offset, as vanilla's files have one.
  var ok = true
  let y = digits(s, 0, 4, ok)
  let mo = digits(s, 5, 2, ok)
  let d = digits(s, 8, 2, ok)
  let h = digits(s, 11, 2, ok)
  let mi = digits(s, 14, 2, ok)
  let se = digits(s, 17, 2, ok)
  if not ok or s.len < 19:
    return (false, 0'i64)
  var at = 19
  if at < s.len and s[at] == ' ':
    inc at
  var offset = 0'i64
  if at < s.len and (s[at] == '+' or s[at] == '-'):
    let sign = if s[at] == '-': -1'i64 else: 1'i64
    var offsetOk = true
    let oh = digits(s, at + 1, 2, offsetOk)
    let omin = if at + 3 < s.len and s[at + 3] == ':': digits(s, at + 4, 2, offsetOk) else: digits(s, at + 3, 2, offsetOk)
    if not offsetOk:
      return (false, 0'i64)
    offset = sign * (oh * 3600'i64 + omin * 60'i64)
  (true, daysFromCivil(y, mo, d) * 86400'i64 + h * 3600'i64 + mi * 60'i64 + se - offset)

proc expiresToString(expires: int64): string =
  if expires == NoExpiry: "forever" else: formatBanDate(expires)

proc parseExpires(s: string): (bool, int64) =
  if s == "forever":
    return (true, NoExpiry)
  parseBanDate(s)

proc stringField(v: JsonValue; key: string): (bool, string) =
  let (found, field) = v.get(key)
  if found and field.kind == jvString: (true, field.strVal) else: (false, "")

proc toJson*(e: BannedPlayerEntry): JsonValue =
  result = jsonObject()
  result.put("uuid", jsonString($e.uuid))
  result.put("name", jsonString(e.name))
  result.put("created", jsonString(formatBanDate(e.created)))
  result.put("source", jsonString(e.source))
  result.put("expires", jsonString(expiresToString(e.expires)))
  result.put("reason", jsonString(e.reason))

proc toJson*(e: BannedIpEntry): JsonValue =
  result = jsonObject()
  result.put("ip", jsonString(e.ip))
  result.put("created", jsonString(formatBanDate(e.created)))
  result.put("source", jsonString(e.source))
  result.put("expires", jsonString(expiresToString(e.expires)))
  result.put("reason", jsonString(e.reason))

proc bannedPlayerFromJson*(v: JsonValue): (bool, BannedPlayerEntry) =
  let (hasId, idText) = stringField(v, "uuid")
  let (hasName, name) = stringField(v, "name")
  let (hasCreated, createdText) = stringField(v, "created")
  let (hasSource, source) = stringField(v, "source")
  let (hasExpires, expiresText) = stringField(v, "expires")
  let (hasReason, reason) = stringField(v, "reason")
  if not (hasId and hasName and hasCreated and hasSource and hasExpires and hasReason):
    return (false, BannedPlayerEntry())
  let (idOk, id) = parseUuid(idText)
  let (createdOk, created) = parseBanDate(createdText)
  let (expiresOk, expires) = parseExpires(expiresText)
  if not (idOk and createdOk and expiresOk):
    return (false, BannedPlayerEntry())
  (true, BannedPlayerEntry(uuid: id, name: name, created: created, source: source, expires: expires, reason: reason))

proc bannedIpFromJson*(v: JsonValue): (bool, BannedIpEntry) =
  let (hasIp, ip) = stringField(v, "ip")
  let (hasCreated, createdText) = stringField(v, "created")
  let (hasSource, source) = stringField(v, "source")
  let (hasExpires, expiresText) = stringField(v, "expires")
  let (hasReason, reason) = stringField(v, "reason")
  if not (hasIp and hasCreated and hasSource and hasExpires and hasReason):
    return (false, BannedIpEntry())
  let (createdOk, created) = parseBanDate(createdText)
  let (expiresOk, expires) = parseExpires(expiresText)
  if not (createdOk and expiresOk):
    return (false, BannedIpEntry())
  (true, BannedIpEntry(ip: ip, created: created, source: source, expires: expires, reason: reason))
