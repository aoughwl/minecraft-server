## The date form of a ban list, and an entry through JSON.
import std/[assertions, syncio]
import ../../codecs/json_value
import ../../util/uuid
import banlist_serializer

assert formatBanDate(0'i64) == "1970-01-01 00:00:00+00:00"
assert formatBanDate(1700000000'i64) == "2023-11-14 22:13:20+00:00"
assert parseBanDate("2023-11-14 22:13:20+00:00") == (true, 1700000000'i64)
assert parseBanDate("2023-11-14 22:13:20 +0000") == (true, 1700000000'i64), "the vanilla shape"
assert parseBanDate("2023-11-15 00:13:20+02:00") == (true, 1700000000'i64)
assert not parseBanDate("forever")[0]

let (_, id) = parseUuid("069a79f4-44e9-4726-a5be-fca90e38aaf5")
let entry = BannedPlayerEntry(uuid: id, name: "Notch", created: 1700000000'i64, source: "Server", expires: NoExpiry, reason: "test")
let (ok, back) = bannedPlayerFromJson(toJson(entry))
assert ok
assert back.uuid == id and back.name == "Notch" and back.expires == NoExpiry and back.created == 1700000000'i64

let ipEntry = BannedIpEntry(ip: "127.0.0.1", created: 0'i64, source: "x", expires: 86400'i64, reason: "y")
let (ipOk, ipBack) = bannedIpFromJson(toJson(ipEntry))
assert ipOk and ipBack.ip == "127.0.0.1" and ipBack.expires == 86400'i64
assert not bannedIpFromJson(jsonObject())[0]
echo "banlist ok"
