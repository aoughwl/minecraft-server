## Port of pumpkin/src/data/banned_ip.rs

import std/options
import ../../codecs/json_value
import ../../config/data_json
import banlist_serializer

export banlist_serializer

const BannedIpsFile* = "banned-ips.json"

type
  BannedIpList* = object
    dataDir*: string
    bannedIps*: seq[BannedIpEntry]

proc save*(self: BannedIpList) =
  var items: seq[JsonValue] = @[]
  for e in self.bannedIps:
    items.add(toJson(e))
  discard writeDataFile(self.dataDir, BannedIpsFile, toJsonString(jsonArray(items)))

proc loadBannedIpList*(dataDir: string): BannedIpList =
  result = BannedIpList(dataDir: dataDir, bannedIps: @[])
  let file = readOrCreateDataFile(dataDir, BannedIpsFile, "[]")
  if file.ok:
    let parsed = parseJsonValue(file.text)
    if parsed.ok and parsed.value.kind == jvArray:
      for item in parsed.value.items:
        let (ok, entry) = bannedIpFromJson(item)
        if ok:
          result.bannedIps.add(entry)

proc removeInvalidEntries(self: var BannedIpList) =
  let now = nowUtcSeconds()
  var kept: seq[BannedIpEntry] = @[]
  for e in self.bannedIps:
    if e.expires == NoExpiry or e.expires >= now:
      kept.add(e)
  let changed = kept.len != self.bannedIps.len
  self.bannedIps = kept
  if changed:
    self.save()

proc getEntry*(self: var BannedIpList; ip: string): Option[BannedIpEntry] =
  self.removeInvalidEntries()
  for e in self.bannedIps:
    if e.ip == ip:
      return some(e)
  none[BannedIpEntry]()
