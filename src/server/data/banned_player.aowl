## Port of pumpkin/src/data/banned_player.rs

import std/options
import ../../codecs/json_value
import ../../config/data_json
import ../../util/uuid
import banlist_serializer

export banlist_serializer

const BannedPlayersFile* = "banned-players.json"

type
  BannedPlayerList* = object
    dataDir*: string
    bannedPlayers*: seq[BannedPlayerEntry]

proc save*(self: BannedPlayerList) =
  ## `SaveJSONConfiguration::save`
  var items: seq[JsonValue] = @[]
  for e in self.bannedPlayers:
    items.add(toJson(e))
  discard writeDataFile(self.dataDir, BannedPlayersFile, toJsonString(jsonArray(items)))

proc loadBannedPlayerList*(dataDir: string): BannedPlayerList =
  ## `LoadJSONConfiguration::load`. Upstream panics on a file it cannot parse; this starts empty.
  result = BannedPlayerList(dataDir: dataDir, bannedPlayers: @[])
  let file = readOrCreateDataFile(dataDir, BannedPlayersFile, "[]")
  if file.ok:
    let parsed = parseJsonValue(file.text)
    if parsed.ok and parsed.value.kind == jvArray:
      for item in parsed.value.items:
        let (ok, entry) = bannedPlayerFromJson(item)
        if ok:
          result.bannedPlayers.add(entry)

proc removeInvalidEntries(self: var BannedPlayerList) =
  let now = nowUtcSeconds()
  var kept: seq[BannedPlayerEntry] = @[]
  for e in self.bannedPlayers:
    if e.expires == NoExpiry or e.expires >= now:
      kept.add(e)
  let changed = kept.len != self.bannedPlayers.len
  self.bannedPlayers = kept
  if changed:
    self.save()

proc getEntry*(self: var BannedPlayerList; id: Uuid): Option[BannedPlayerEntry] =
  ## `get_entry`, on the profile's id.
  self.removeInvalidEntries()
  for e in self.bannedPlayers:
    if e.uuid == id:
      return some(e)
  none[BannedPlayerEntry]()
