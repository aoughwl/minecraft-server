## Port of pumpkin/src/data/mod.rs
##
## `VanillaData`, as `ServerData`: the files in `data/`. `ops.json` and `whitelist.json` are src/config's, which also
## ports pumpkin/src/data/op.rs and whitelist.rs. `player_server.rs` is player_server.aowl, above the server's types.

import ../../config/[data_json, op, whitelist]
import banned_ip, banned_player, usercache

export op, whitelist, banned_ip, banned_player, usercache

const DataFolder* = "data"  ## `DATA_FOLDER`

type
  ServerData* = object
    bannedIpList*: BannedIpList
    bannedPlayerList*: BannedPlayerList
    operatorConfig*: OperatorConfig
    userCache*: UserCache
    whitelistConfig*: WhitelistConfig

proc loadServerData*(dataDir: string): ServerData =
  ## `VanillaData::load`. A file that cannot be parsed reads as empty, where upstream panics at startup.
  discard ensureFolder(dataDir, "could not create the data folder")
  let ops = loadOperatorConfig(dataDir)
  let list = loadWhitelistConfig(dataDir)
  ServerData(bannedIpList: loadBannedIpList(dataDir), bannedPlayerList: loadBannedPlayerList(dataDir),
    operatorConfig: if ops.ok: ops.value else: OperatorConfig(ops: @[]), userCache: loadUserCache(dataDir),
    whitelistConfig: if list.ok: list.value else: WhitelistConfig(whitelist: @[]))
