## `ServerData`: the files appear, a ban takes effect and expires, the user cache remembers.
import std/[assertions, options, syncio, cmdline]
import ../../util/uuid
import ../../world/worldfs
import datamod

let dir = parentDirW(paramStr(0)) & "/datamod_scratch"
discard removeFileW(dir & "/banned-players.json")
discard removeFileW(dir & "/banned-ips.json")
discard removeFileW(dir & "/usercache.json")
discard createDirAllW(dir)
var data = loadServerData(dir)
assert data.operatorConfig.ops.len == 0
assert fileExistsW(dir & "/banned-players.json")

let (_, id) = parseUuid("069a79f4-44e9-4726-a5be-fca90e38aaf5")
assert data.bannedPlayerList.getEntry(id).isNone
data.bannedPlayerList.bannedPlayers.add(BannedPlayerEntry(uuid: id, name: "Notch", created: 0'i64, source: "t",
  expires: NoExpiry, reason: "r"))
data.bannedPlayerList.bannedPlayers.add(BannedPlayerEntry(uuid: NilUuid, name: "Old", created: 0'i64, source: "t",
  expires: 1'i64, reason: "r"))
assert data.bannedPlayerList.getEntry(id).isSome
assert data.bannedPlayerList.getEntry(NilUuid).isNone, "an expired ban is gone"
data.bannedPlayerList.save()
var again = loadBannedPlayerList(dir)
assert again.getEntry(id).isSome, "and it was saved"

data.userCache.upsert(id, "Notch")
assert data.userCache.getByName("NOTCH").isSome
assert data.userCache.getByUuid(id).unsafeGet.name == "Notch"
var cache2 = loadUserCache(dir)
assert cache2.getByName("notch").isSome, "read back from disk"
echo "datamod ok"
