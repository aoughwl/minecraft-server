## Port of pumpkin/src/data/player_server.rs
##
## `ServerPlayerData`'s methods, on the server that holds its storage: `Server` is what they need, and `PlayerDataStorage`
## is ../../world/playerdata.aowl. The save interval is `Server`'s config and `lastSave` a module-level value, since the
## server has one storage.

import std/[options, syncio]
import ../../inventory/[player_inventory, player_screen_handler, screenhandler]
import ../../nbt/tag
import ../../world/playerdata
import ../entity/player as playermod
import ../net/winsock
import ../serverbase

var lastSaveMs = 0'i64

proc extractDataAndSavePlayer*(server: Server; player: Player) =
  ## `extract_data_and_save_player`
  if not isSaveEnabled(server.playerDataStorage):
    return
  var nbt = newCompound()
  player.writeNbt(nbt)
  let (ok, err) = savePlayerData(server.playerDataStorage, $player.gameprofile.id, nbt)
  if not ok:
    echo "Failed to save player data for ", $player.gameprofile.id, ": ", err.msg

proc handlePlayerLeave*(server: Server; player: Player) =
  ## `handle_player_leave`
  ScreenHandler(player.playerScreenHandler).onClosed(player.asInventoryPlayer())
  player.onHandledScreenClosed()
  extractDataAndSavePlayer(server, player)

proc saveAllPlayers*(server: Server) =
  ## `save_all_players`
  for world in server.worlds:
    for player in world.players:
      extractDataAndSavePlayer(server, player)

proc loadData*(server: Server; id: Uuid): Option[NbtCompound] =
  ## `load_data`: none for a new player, and for one whose data cannot be read, who continues with the defaults.
  let loaded = loadPlayerData(server.playerDataStorage, $id)
  if not loaded.ok:
    echo "Error loading player data for ", $id, ": ", loaded.error.msg
    return none[NbtCompound]()
  if not loaded.found:
    return none[NbtCompound]()
  some(loaded.nbt)

proc tickPlayerData*(server: Server) =
  ## `tick`: periodic saves.
  let now = nowMs()
  if lastSaveMs == 0'i64:
    lastSaveMs = now
  let interval = int64(server.advancedConfig.playerData.savePlayerCronInterval) * 1000'i64
  if now - lastSaveMs >= interval and isSaveEnabled(server.playerDataStorage):
    lastSaveMs = now
    saveAllPlayers(server)
