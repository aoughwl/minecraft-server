## Player data round trip (Fabric gap "player-data round trip"): inventory, ender chest, position, game mode, health,
## xp, saved to playerdata/<uuid>.dat by the server's storage and read back into a brand-new Player, for an offline UUID
## (vanilla's MD5 "OfflinePlayer:<name>") and for a made-up online UUID. A save that dropped a field fails an assert.
import std/[assertions, options, syncio, cmdline]
import "../../data/item_stack/mod"
import ../../inventory/[inventory, player_inventory]
import ../../nbt/tag
import ../../util/uuid
import ../../util/gamemode
import ../../world/[chunkdata, playerdata, worldfs, worldinfo]
import ../entity/player
import ../recipe
import ../scheduler
import ../serverbase
import ../tick_rate_manager
import ../net/netbase
import ../net/winsock
import ../net/java/javamod
import ./datamod
import ./player_server
import ../world/worldmod

proc scratch(): string =
  result = parentDirW(paramStr(0)) & "/pdrt_scratch"
  discard createDirAllW(result)

proc newTestServer(): Server =
  let adv = defaultAdvancedConfiguration()
  result = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: newPlayerDataStorage(scratch() & "/playerdata", true), levelFolder: scratch(),
    playerIdleTimeout: 0'i32, mojangPublicKeys: @[], stopRequested: false, stopAtMs: 0'i64)
  let theLevel = fromRootFolder(adv.world, scratch(), 1'i64, OVERWORLD)
  result.worlds.add(loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, result))

proc newTestPlayer(server: Server; profile: GameProfile; id: int32): Player =
  let client = newJavaClient(InvalidSocket, uint64(id))
  client.connectionState = csPlay
  client.version = jmvV1_21_11
  result = newPlayer(client, profile, defaultPlayerConfig(), server.worlds[0], server, Survival, id)
  worldmod.addPlayer(server.worlds[0], result)

proc roundTrip(server: Server; profile: GameProfile; label: string) =
  let stone = Item.fromRegistryKey("stone")
  let diamond = Item.fromRegistryKey("diamond")
  let ender = Item.fromRegistryKey("obsidian")
  assert stone != nil
  assert diamond != nil
  assert ender != nil
  let a = newTestPlayer(server, profile, 11'i32)
  Inventory(a.inventory).setStack(0, newItemStack(7'u8, stone))
  Inventory(a.inventory).setStack(17, newItemStack(3'u8, diamond))
  Inventory(a.enderChestInventory).setStack(5, newItemStack(12'u8, ender))
  a.setPos(Vector3[float64](x: 123.25, y: 77.5, z: -456.75))
  a.setRotation(33.0'f32, 12.0'f32)
  a.gamemode = Creative
  a.health = 14.0'f32
  a.hungerManager.level = 9'u8
  a.experienceLevel = 4'i32
  extractDataAndSavePlayer(server, a)
  let path = getPlayerDataPath(server.playerDataStorage, $profile.id)
  let (st, bytes) = readFileBytes(path)
  assert st == rsOk and bytes.len > 20, label & ": the file " & path & " was written"
  # a brand new Player, as a rejoin builds one
  let b = newTestPlayer(server, profile, 12'i32)
  assert Inventory(b.inventory).getStack(0).isEmpty(), label & ": a new player starts empty"
  let loaded = loadData(server, profile.id)
  assert loaded.isSome, label & ": loadData finds " & $profile.id
  b.readNbt(loaded.unsafeGet)
  assert Inventory(b.inventory).getStack(0).itemCount == 7'u8, label & ": hotbar stack count"
  assert Inventory(b.inventory).getStack(0).item.id == stone.id, label & ": hotbar item"
  assert Inventory(b.inventory).getStack(17).itemCount == 3'u8 and Inventory(b.inventory).getStack(17).item.id == diamond.id,
    label & ": main inventory slot 17"
  assert Inventory(b.enderChestInventory).getStack(5).itemCount == 12'u8, label & ": ender chest count"
  assert Inventory(b.enderChestInventory).getStack(5).item.id == ender.id, label & ": ender chest item"
  assert b.pos.x == 123.25 and b.pos.y == 77.5 and b.pos.z == -456.75, label & ": position"
  assert b.yaw == 33.0'f32 and b.pitch == 12.0'f32, label & ": rotation"
  assert b.gamemode == Creative, label & ": game mode"
  assert b.health == 14.0'f32, label & ": health"
  assert b.hungerManager.level == 9'u8, label & ": food"
  assert b.experienceLevel == 4'i32, label & ": xp level"
  # another player's file is separate
  let other = GameProfile(id: offlineUuid("SomeoneElse"), name: "SomeoneElse", properties: @[], profileActions: @[])
  assert loadData(server, other.id).isNone, label & ": a different uuid has no data"
  worldmod.removePlayer(server.worlds[0], a, false)
  worldmod.removePlayer(server.worlds[0], b, false)
  echo label, ": round trip ok (", bytes.len, " bytes)"

let server = newTestServer()
# vanilla's offline id for Notch (known answer), so a vanilla save keeps its players
assert $offlineUuid("Notch") == "b50ad385-829d-3141-a216-7e7d7539ba7f", "offline uuid is vanilla's MD5 one: " & $offlineUuid("Notch")
roundTrip(server, GameProfile(id: offlineUuid("Tester"), name: "Tester", properties: @[], profileActions: @[]), "offline")
roundTrip(server, GameProfile(id: Uuid(hi: 0x0123456789abcdef'u64, lo: 0x8edcba9876543210'u64), name: "Online", properties: @[],
  profileActions: @[]), "online")
echo "playerroundtriptest ok"
