## Port of pumpkin/src/data/usercache.rs
##
## The two maps are one seq, since there are few entries. Expiry dates are seconds since the epoch, written with
## `formatBanDate`'s shape and read back by the same code; upstream writes RFC 3339.

import std/[algorithm, options]
import ../../codecs/json_value
import ../../config/data_json
import ../../util/uuid
import banlist_serializer

const
  UserCachePath = "usercache.json"
  UserCacheMruLimit = 1000
  OneMonthSeconds = 2592000'i64

type
  UserCacheEntry* = object
    uuid*: Uuid
    name*: string
    expirationDate: int64
    lastAccess: uint64

  UserCache* = object
    dataDir: string
    profiles: seq[UserCacheEntry]
    operationCount: uint64

proc nextOperation(self: var UserCache): uint64 =
  self.operationCount += 1'u64
  self.operationCount

proc asciiLower(s: string): string =
  result = s
  for i in 0 ..< result.len:
    if result[i] >= 'A' and result[i] <= 'Z':
      result[i] = char(ord(result[i]) + 32)

proc safeAdd(self: var UserCache; entry0: UserCacheEntry) =
  var entry = entry0
  entry.lastAccess = self.nextOperation()
  var i = 0
  while i < self.profiles.len:
    if self.profiles[i].uuid == entry.uuid or asciiLower(self.profiles[i].name) == asciiLower(entry.name):
      self.profiles.delete(i)
    else:
      inc i
  self.profiles.add(entry)

proc byLastAccess(a, b: UserCacheEntry): int =
  ## `Reverse(entry.last_access)`
  cmp(b.lastAccess, a.lastAccess)

proc save*(self: UserCache) =
  var sorted = self.profiles
  sort(sorted, byLastAccess)
  var items: seq[JsonValue] = @[]
  for i in 0 ..< min(sorted.len, UserCacheMruLimit):
    var o = jsonObject()
    o.put("uuid", jsonString($sorted[i].uuid))
    o.put("name", jsonString(sorted[i].name))
    o.put("expiresOn", jsonString(formatBanDate(sorted[i].expirationDate)))
    items.add(o)
  discard writeDataFile(self.dataDir, UserCachePath, toJsonString(jsonArray(items)))

proc loadUserCache*(dataDir: string): UserCache =
  result = UserCache(dataDir: dataDir, profiles: @[], operationCount: 0'u64)
  let file = readOrCreateDataFile(dataDir, UserCachePath, "[]")
  if not file.ok:
    return
  let parsed = parseJsonValue(file.text)
  if not parsed.ok or parsed.value.kind != jvArray:
    return
  var i = parsed.value.items.len - 1
  while i >= 0:
    let element = parsed.value.items[i]
    dec i
    if element.kind != jvObject:
      continue
    let (hasName, name) = element.get("name")
    let (hasId, idText) = element.get("uuid")
    let (hasDate, dateText) = element.get("expiresOn")
    if not (hasName and hasId and hasDate) or name.kind != jvString or idText.kind != jvString or dateText.kind != jvString:
      continue
    let (idOk, id) = parseUuid(idText.strVal)
    let (dateOk, date) = parseBanDate(dateText.strVal)
    if idOk and dateOk:
      result.safeAdd(UserCacheEntry(uuid: id, name: name.strVal, expirationDate: date, lastAccess: 0'u64))

proc upsert*(self: var UserCache; id: Uuid; name: string) =
  ## `upsert` and `add_internal`.
  self.safeAdd(UserCacheEntry(uuid: id, name: name, expirationDate: nowUtcSeconds() + OneMonthSeconds, lastAccess: 0'u64))
  self.save()

proc getByName*(self: var UserCache; name: string): Option[UserCacheEntry] =
  let lowered = asciiLower(name)
  for i in 0 ..< self.profiles.len:
    if asciiLower(self.profiles[i].name) == lowered:
      if nowUtcSeconds() >= self.profiles[i].expirationDate:
        self.profiles.delete(i)
        self.save()
        return none[UserCacheEntry]()
      self.profiles[i].lastAccess = self.nextOperation()
      return some(self.profiles[i])
  none[UserCacheEntry]()

proc getByUuid*(self: var UserCache; id: Uuid): Option[UserCacheEntry] =
  for i in 0 ..< self.profiles.len:
    if self.profiles[i].uuid == id:
      self.profiles[i].lastAccess = self.nextOperation()
      return some(self.profiles[i])
  none[UserCacheEntry]()
