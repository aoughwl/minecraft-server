## Data packs (Fabric gap): a pack on disk changes a built-in tag, adds a tag, adds crafting and smelting recipes and
## defines functions; reset restores the built-ins exactly. Each assert fails if the loader skipped the feature.
import std/[assertions, syncio, cmdline, options]
import "../../world/worldfs"
import "../../generated/tag"
import "../../generated/recipes"
import "../../generated/block_properties"
import "../../data/block_state"
import "../../data/blocks"
import "../../data/item_stack/mod"
import "../../util/javaversion"
import datapack

let root = parentDirW(paramStr(0)) & "/datapack_scratch/datapacks"

proc put(rel, text: string) =
  let full = root & "/" & rel
  discard createDirAllW(parentDirW(full))
  try:
    writeFile(full, text)
  except ErrorCode:
    assert false, "cannot write " & full

proc has(names: seq[string]; s: string): bool =
  for n in names:
    if n == s: return true
  false

# --- the pack ---------------------------------------------------------------------------------------------------------
put "alpha/pack.mcmeta", "{\"pack\":{\"pack_format\":94,\"description\":\"test pack\"}}"
put "alpha/data/mypack/function/hello.mcfunction", "# a comment\nsay hello from a data pack\n\n/tp @s 1 2 3\nsay a \\\n  b\n$macro $(x)\n"
put "alpha/data/mypack/function/sub/deep.mcfunction", "say deep"
put "alpha/data/minecraft/tags/function/load.json", "{\"values\":[\"mypack:hello\"]}"
put "alpha/data/minecraft/tags/function/tick.json", "{\"values\":[\"#mypack:ticks\"]}"
put "alpha/data/mypack/tags/function/ticks.json", "{\"values\":[\"mypack:sub/deep\"]}"
put "alpha/data/minecraft/tags/block/mineable/pickaxe.json", "{\"values\":[\"minecraft:dirt\"]}"
put "alpha/data/mypack/tags/block/fancy.json", "{\"values\":[\"minecraft:stone\",\"#minecraft:logs\",\"minecraft:nope_block\"]}"
put "alpha/data/mypack/tags/item/gems.json", "{\"values\":[\"minecraft:diamond\",\"minecraft:emerald\"]}"
put "alpha/data/mypack/recipe/diamond_from_stone.json",
  "{\"type\":\"minecraft:crafting_shaped\",\"category\":\"misc\",\"pattern\":[\"SS\",\"SS\"],\"key\":{\"S\":\"minecraft:stone\"},\"result\":{\"id\":\"minecraft:diamond_block\",\"count\":1}}"
put "alpha/data/mypack/recipe/gems_shapeless.json",
  "{\"type\":\"minecraft:crafting_shapeless\",\"ingredients\":[\"minecraft:dirt\",{\"tag\":\"minecraft:logs\"}],\"result\":{\"id\":\"minecraft:emerald\",\"count\":3}}"
put "alpha/data/mypack/recipe/smelt_dirt.json",
  "{\"type\":\"minecraft:smelting\",\"ingredient\":\"minecraft:dirt\",\"result\":{\"id\":\"minecraft:diamond\"},\"experience\":1.5,\"cookingtime\":123}"
put "alpha/data/mypack/recipe/bad.json", "{\"type\":\"minecraft:crafting_shaped\",\"pattern\":[\"X\"],\"key\":{},\"result\":\"minecraft:stone\"}"
put "alpha/data/mypack/recipe/weird.json", "{\"type\":\"minecraft:smithing_transform\"}"
put "broken/pack.mcmeta", "not json"
put "beta/pack.mcmeta", "{\"pack\":{\"pack_format\":94,\"description\":\"second\"}}"
put "beta/data/mypack/function/hello.mcfunction", "say beta wins"
put "off/pack.mcmeta", "{\"pack\":{\"pack_format\":94,\"description\":\"disabled\"}}"
put "off/data/mypack/function/only_off.mcfunction", "say off"

# --- parseFunction -----------------------------------------------------------------------------------------------------
let parsed = parseFunction("# c\nsay a\n\n/tp 1 2 3\nsay x \\\n  y\n$macro\n")
assert parsed.len == 3 and parsed[0] == "say a" and parsed[1] == "tp 1 2 3" and parsed[2] == "say x y"

# --- baseline ----------------------------------------------------------------------------------------------------------
let dirt = Block.fromRegistryKey("dirt")
assert dirt != nil
let stoneB = Block.fromRegistryKey("stone")
assert stoneB != nil
let pick = find(getLatestMap(rkBlock), "minecraft:mineable/pickaxe")
assert pick != nil
let pickBefore = pick.values.len
assert not hasTag(asU16(dirt.id), pick), "dirt is not mineable with a pickaxe in the built-in data"
let craftBefore = RECIPES_CRAFTING.len
let shapedBefore = shapedRecipes.len
let cookBefore = cookingRecipes.len
assert find(getLatestMap(rkBlock), "mypack:fancy") == nil

# --- load --------------------------------------------------------------------------------------------------------------
let rep = loadDatapacks(root, @["file/off"])
for l in rep.lines:
  echo l
assert rep.found == 4, "alpha beta broken off: " & $rep.found
assert rep.loaded == 2, "alpha and beta load; broken is skipped; off is disabled: " & $rep.loaded
assert functionCount() == 2, "hello (beta wins), sub/deep, and no only_off: " & $functionCount()
var fn = McFunction(id: "", lines: @[], pack: "")
assert findFunction("mypack:hello", fn)
assert fn.pack == "beta" and fn.lines == @["say beta wins"], "the later pack (name order) wins a function id"
assert findFunction("mypack:sub/deep", fn) and fn.lines == @["say deep"]
assert not findFunction("mypack:only_off", fn), "level.dat-disabled pack is not loaded"
assert functionTagMembers("minecraft:load") == @["mypack:hello"]
assert functionTagMembers("minecraft:tick") == @["mypack:sub/deep"], "nested function tag expanded"

# tags: existing tag extended, new tag created with ids, nested tag expanded, unknown value warned and dropped
let pickAfter = find(getLatestMap(rkBlock), "minecraft:mineable/pickaxe")
assert pickAfter != nil
assert pickAfter.values.len == pickBefore + 1
assert hasTag(asU16(dirt.id), pickAfter), "dirt is now mineable with a pickaxe"
let fancy = find(getLatestMap(rkBlock), "mypack:fancy")
assert fancy != nil, "a new tag is found through find()"
assert hasTag(asU16(stoneB.id), fancy) and fancy.values.has("stone")
let oak = Block.fromRegistryKey("oak_log")
assert oak != nil
assert hasTag(asU16(oak.id), fancy), "#minecraft:logs expanded into the new tag"
assert not fancy.values.has("nope_block")
# clients are sent their own version's map: the added tag must be there too, and the packet writer has to see it
let clientMap = getRegistryKeyTags(jmvV1_21_11, rkBlock)
assert clientMap.present and clientMap.extraNames.has("mypack:fancy"), "the 1.21.11 map carries the data pack tag"
var clientPick: Tag = nil
clientPick = find(clientMap, "minecraft:mineable/pickaxe")
assert clientPick != nil
assert hasTag(asU16(dirt.id), clientPick), "the 1.21.11 client's pickaxe tag has dirt too"
let gems = find(getLatestMap(rkItem), "mypack:gems")
let diamondItem = Item.fromRegistryKey("diamond")
assert gems != nil
assert diamondItem != nil
assert hasTag(uint16(diamondItem.id), gems)

# recipes
assert RECIPES_CRAFTING.len == craftBefore + 2, "shaped + shapeless added, bad and unsupported ones refused: " & $(RECIPES_CRAFTING.len - craftBefore)
assert shapedRecipes.len == shapedBefore + 1
assert cookingRecipes.len == cookBefore + 1
var sawShaped = false
for r in RECIPES_CRAFTING:
  if r.kind == crkCraftingShaped and r.shaped.id == "mypack:diamond_from_stone":
    sawShaped = true
    assert r.shaped.pattern == @["SS", "SS"] and r.shaped.keyChars == @['S']
    assert r.shaped.keyIngredients[0].kind == rikSimple and r.shaped.keyIngredients[0].name == "minecraft:stone"
    assert r.shaped.result.id == "minecraft:diamond_block" and r.shaped.result.count == 1'u8
assert sawShaped
var sawLess = false
for r in RECIPES_CRAFTING:
  if r.kind == crkCraftingShapeless and r.shapeless.id == "mypack:gems_shapeless":
    sawLess = true
    assert r.shapeless.ingredients.len == 2 and r.shapeless.ingredients[1].kind == rikTagged and
      r.shapeless.ingredients[1].name == "#minecraft:logs" and r.shapeless.result.count == 3'u8
assert sawLess
let smelt = cookingRecipes[cookingRecipes.len - 1]
assert smelt.id == "mypack:smelt_dirt" and smelt.cookingTime == 123'i32 and smelt.experience == 1.5'f32 and smelt.kind == crkSmelting
var warned = 0
for i in 0 ..< datapackCount():
  warned += datapackAt(i).warnings.len
assert warned >= 3, "bad recipe, unsupported recipe and unknown tag value are reported: " & $warned

# --- reload is idempotent, reset restores -------------------------------------------------------------------------------
let rep2 = loadDatapacks(root, @["file/off"])
assert rep2.loaded == 2 and RECIPES_CRAFTING.len == craftBefore + 2, "a second load does not stack"
let pickTwice = find(getLatestMap(rkBlock), "minecraft:mineable/pickaxe")
assert pickTwice != nil
assert pickTwice.values.len == pickBefore + 1
resetDatapacks()
assert RECIPES_CRAFTING.len == craftBefore and shapedRecipes.len == shapedBefore and cookingRecipes.len == cookBefore
assert find(getLatestMap(rkBlock), "mypack:fancy") == nil, "added tag gone"
assert getRegistryKeyTags(jmvV1_21_11, rkBlock).extraNames.len == 0, "and gone from the client's map"
let pickReset = find(getLatestMap(rkBlock), "minecraft:mineable/pickaxe")
assert pickReset != nil
assert pickReset.values.len == pickBefore, "extended tag restored"
assert not hasTag(asU16(dirt.id), pickReset), "dirt back to not mineable"
assert functionCount() == 0
echo "datapacktest ok"
