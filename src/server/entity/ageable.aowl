## Port of pumpkin/src/entity/ageable.rs
##
## `trait AgeableMob: Mob` is procs on a `Mob` and its `AgeableData`: an implementor keeps the data and passes it. The one
## method a mob overrides, `get_baby_start_age`, and `can_be_a_baby` are fields on `AgeableData`.

import ../../generated/[meta_data_type, tracked_data]
import ../../nbt/tag as nbttag
import ../world/chunker
import trackedalias
import ai/aibase

const
  BabyStartAge* = -24000'i32
  ForcedAgeParticleTicks* = 40'i32

type
  AgeableData* = ref object
    forcedAge*: int32
    forcedAgeTimer*: int32
    ageLocked*: bool
    ageLockParticleTimer*: int32
    babyStartAge*: int32
    canBeABaby*: bool

proc newAgeableData*(): AgeableData =
  AgeableData(forcedAge: 0'i32, forcedAgeTimer: 0'i32, ageLocked: false, ageLockParticleTimer: 0'i32,
    babyStartAge: BabyStartAge, canBeABaby: true)

proc isBaby*(mob: Mob): bool = mob.mobEntity.livingEntity.entity.age < 0'i32

proc getAge*(mob: Mob): int32 = mob.mobEntity.livingEntity.entity.age

proc setAge*(mob: Mob; newAge: int32) =
  ## `set_age`
  let entity = mob.mobEntity.livingEntity.entity
  let oldAge = entity.age
  entity.age = newAge
  if (oldAge < 0'i32 and newAge >= 0'i32) or (oldAge >= 0'i32 and newAge < 0'i32):
    entity.sendMetaData(TD_BABY, BOOLEAN, newAge < 0'i32)

proc setBaby*(mob: Mob; data: AgeableData; baby: bool) =
  mob.setAge(if baby: data.babyStartAge else: 0'i32)

proc isAgeLocked*(data: AgeableData): bool = data.ageLocked

proc setAgeLocked*(data: AgeableData; locked: bool) = data.ageLocked = locked

proc canAgeUp*(mob: Mob; data: AgeableData): bool =
  mob.isBaby() and not data.ageLocked

proc ageUp*(mob: Mob; data: AgeableData; seconds: int32; forced: bool) =
  ## `age_up`
  var age = mob.getAge()
  let oldAge = age
  age += seconds * 20'i32
  if age > 0'i32:
    age = 0'i32
  let delta = age - oldAge
  mob.setAge(age)
  if forced:
    data.forcedAge += delta
    if data.forcedAgeTimer == 0'i32:
      data.forcedAgeTimer = 40'i32
  if mob.getAge() == 0'i32:
    mob.setAge(data.forcedAge)

proc getSpeedUpSecondsWhenFeeding*(ticksUntilAdult: int32): int32 =
  ## `get_speed_up_seconds_when_feeding`: `as i32` truncates.
  int32(float32(ticksUntilAdult) / 20.0'f32 * 0.1'f32)

proc writeAgeableNbt*(mob: Mob; data: AgeableData; nbt: var NbtCompound) =
  ## `write_ageable_nbt`
  if data.canBeABaby:
    nbt.putInt("Age", mob.getAge())
    nbt.putInt("ForcedAge", data.forcedAge)
    nbt.putBool("AgeLocked", data.ageLocked)

proc readAgeableNbt*(mob: Mob; data: AgeableData; nbt: NbtCompound) =
  ## `read_ageable_nbt`
  if data.canBeABaby:
    let age = nbt.getInt("Age")
    mob.setAge(if age.isSome: age.unsafeGet else: 0'i32)
    let forced = nbt.getInt("ForcedAge")
    data.forcedAge = if forced.isSome: forced.unsafeGet else: 0'i32
    let locked = nbt.getBool("AgeLocked")
    data.ageLocked = locked.isSome and locked.unsafeGet

proc ageableAiStep*(mob: Mob; data: AgeableData) =
  ## `ageable_ai_step`
  if mob.canAgeUp(data):
    mob.setAge(mob.getAge() + 1'i32)
  elif mob.getAge() > 0'i32:
    mob.setAge(mob.getAge() - 1'i32)
