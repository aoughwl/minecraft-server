## entity/ai: `to_goal_ticks`, the goal selector's arbitration, the controls' arithmetic, target predicates and goals on a real
## mob. Known answers worked from the Rust; the world is a void one, so nothing here needs a chunk.

import std/[assertions, math, options, syncio]
import ../../../generated/attributes
import ../mob/testworld
import aibase
import goal/[look_around, swim]
import pathfinder/pathfindermod

type
  ProbeGoal = ref object of Goal
    allowed: bool
    keepRunning: bool
    used: Controls
    starts, stops, ticks: int

proc makeProbeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ProbeGoal(self)
    s.allowed
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ProbeGoal(self)
    s.keepRunning
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ProbeGoal(self)
    s.starts += 1
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ProbeGoal(self)
    s.stops += 1
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ProbeGoal(self)
    s.ticks += 1
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = ProbeGoal(self)
    s.used

let probeVt = makeProbeVt()

proc newProbe(used: Controls): ProbeGoal =
  ProbeGoal(vt: probeVt, allowed: true, keepRunning: true, used: used)

proc near32(a, b: float32): bool = abs(a - b) < 1.0e-4'f32

let server = newTestServer()
let testWorld = newTestWorld(server, "aitest")

proc newZombieMob(): Mob =
  newPlainMob(newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.ZOMBIE))

block to_goal_ticks:
  # `-(-server_ticks).div_euclid(2)`: rounds up.
  assert toGoalTicks(120'i32) == 60'i32
  assert toGoalTicks(5'i32) == 3'i32
  assert toGoalTicks(1'i32) == 1'i32
  assert toGoalTicks(0'i32) == 0'i32
  assert toGoalTicks(-1'i32) == 0'i32
  assert toGoalTicks(-5'i32) == -2'i32

block goal_runs_and_stops:
  let mob = newZombieMob()
  let selector = newGoalSelector()
  let probe = newProbe(ControlsMove)
  selector.addGoal(1'u8, probe)
  selector.tick(mob)
  assert probe.starts == 1 and probe.ticks == 1 and probe.stops == 0
  selector.tick(mob)
  assert probe.starts == 1 and probe.ticks == 2
  probe.keepRunning = false
  probe.allowed = false
  selector.tick(mob)
  assert probe.stops == 1 and probe.ticks == 2

block lower_priority_number_takes_over:
  let mob = newZombieMob()
  let selector = newGoalSelector()
  let low = newProbe(ControlsMove)
  let high = newProbe(ControlsMove)
  high.allowed = false
  selector.addGoal(2'u8, low)
  selector.addGoal(1'u8, high)
  selector.tick(mob)
  assert low.starts == 1 and high.starts == 0
  high.allowed = true
  selector.tick(mob)
  assert low.stops == 1 and high.starts == 1
  # And the one holding the control keeps it against an equal or worse priority.
  let same = newProbe(ControlsMove)
  selector.addGoal(1'u8, same)
  selector.tick(mob)
  assert same.starts == 0 and high.stops == 0

block different_controls_run_together:
  let mob = newZombieMob()
  let selector = newGoalSelector()
  let move = newProbe(ControlsMove)
  let look = newProbe(ControlsLook)
  selector.addGoal(1'u8, move)
  selector.addGoal(1'u8, look)
  selector.tick(mob)
  assert move.starts == 1 and look.starts == 1

block disabled_control:
  let mob = newZombieMob()
  let selector = newGoalSelector()
  let move = newProbe(ControlsMove)
  selector.addGoal(1'u8, move)
  selector.tick(mob)
  assert move.starts == 1
  selector.disableControl(ControlsMove)
  selector.tick(mob)
  assert move.stops == 1
  selector.tick(mob)
  assert move.starts == 1
  selector.enableControl(ControlsMove)
  selector.tick(mob)
  assert move.starts == 2

block remove_goal:
  let mob = newZombieMob()
  let selector = newGoalSelector()
  let move = newProbe(ControlsMove)
  selector.addGoal(1'u8, move)
  selector.tick(mob)
  selector.removeGoal(mob, probeVt)
  assert move.stops == 1 and selector.goals.len == 0
  selector.tick(mob)
  assert move.ticks == 1

block change_angle:
  # `subtract_angles` wraps, so this goes through 180 and not the long way round.
  assert changeAngle(0.0'f32, 10.0'f32, 90.0'f32) == 10.0'f32
  assert changeAngle(0.0'f32, 120.0'f32, 90.0'f32) == 90.0'f32
  assert changeAngle(0.0'f32, -120.0'f32, 90.0'f32) == -90.0'f32
  assert changeAngle(170.0'f32, -170.0'f32, 90.0'f32) == 190.0'f32

block look_control:
  let mob = newZombieMob()
  let control = mob.mobEntity.lookControl
  mob.entity.headYaw = 0.0'f32
  # (10, _, 0) from the origin: atan2(0, 10) is 0 degrees, less 90: -90. The default limit on a head turn is 10 a tick.
  control.lookAtWithRange(10.0'f64, mob.entity.getEyeY(), 0.0'f64, 10.0'f32, 40.0'f32)
  assert control.lookAtTimer == 2'i32
  control.tick(mob)
  assert control.lookAtTimer == 1'i32
  assert near32(mob.entity.headYaw, -10.0'f32)
  assert near32(mob.entity.pitch, 0.0'f32)

block move_control:
  let mob = newZombieMob()
  let living = mob.mobEntity.livingEntity
  let control = newMoveControl()
  control.setWantedPosition(0.0'f64, 64.0'f64, 10.0'f64, 1.0'f64)
  assert control.hasWanted()
  control.tickImpl(control, mob)
  assert not control.hasWanted()
  # Straight ahead on +z: atan2(10, 0) is 90 degrees, less 90: yaw 0. Movement is speed modifier times MOVEMENT_SPEED.
  assert near32(mob.entity.yaw, 0.0'f32)
  assert abs(living.movementInput.z - living.getAttributeValue(MOVEMENT_SPEED)) < 1e-12'f64
  # Close enough, nothing moves. 2.5000003e-7 is on the squared distance.
  control.setWantedPosition(0.0'f64, 64.0'f64, 0.0001'f64, 1.0'f64)
  control.tickImpl(control, mob)
  assert living.movementInput.z == 0.0'f64
  control.strafe(0.5'f32, -0.5'f32)
  control.tickImpl(control, mob)
  assert living.movementInput.x == -0.5'f64 and living.movementInput.z == 0.5'f64
  assert control.getSpeedModifier() == 0.25'f64

block target_predicate:
  let a = newZombieMob()
  let b = newZombieMob()
  let aLiving = a.mobEntity.livingEntity
  let bLiving = b.mobEntity.livingEntity
  let predicate = createAttackable().setBaseMaxDistance(16.0'f64)
  assert not predicate.test(testWorld, aLiving, aLiving) # not yourself
  assert predicate.test(testWorld, aLiving, bLiving)
  b.entity.setPos(pos3(17.0, 64.0, 0.0))
  assert not predicate.test(testWorld, aLiving, bLiving)
  # A base distance under 2 still reaches MIN_DISTANCE.
  b.entity.setPos(pos3(1.9, 64.0, 0.0))
  assert createAttackable().setBaseMaxDistance(0.5'f64).test(testWorld, aLiving, bLiving)

block navigator_nothing_to_stand_on:
  # With no blocks the destination cannot be reached: every candidate node is open air with nothing under it.
  let navigator = newNavigator()
  let mob = newZombieMob()
  assert navigator.isIdle()
  let found = navigator.computePath(mob.mobEntity.livingEntity, pos3(5.0, 64.0, 0.0))
  if found != nil:
    assert not found.canReach()

block goals_on_a_mob:
  let mob = newZombieMob()
  let selector = mob.mobEntity.goalsSelector
  selector.addGoal(0'u8, newSwimGoal())
  selector.addGoal(8'u8, newRandomLookAroundGoal())
  # Not in water, so swim will not start; the two must sit side by side without any of it crashing through the vtables.
  for i in 0 .. 200:
    selector.tick(mob)
  assert selector.goals.len == 2

echo "ai ok"
