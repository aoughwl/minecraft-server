## Port of pumpkin/src/entity/ai/goal/blaze_attack.rs
##
## Upstream's `Weak<BlazeEntity>` gives this goal `set_charged` and the mob it is on, which it already gets as `mob`.

import std/math
import ../../../../protocol/java/client/play/worldevent
import ../../../world/chunker
import ../../projectile/thrown
import ../aibase

type
  BlazeShootFireballGoal* = ref object of Goal
    setCharged: proc(charged: bool) {.closure.}
    attackStep: int32
    attackTime: int32
    lastSeen: int32

const FollowDistance = 48.0'f64 ## `get_follow_distance`. TODO upstream: use FOLLOW_RANGE

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    # TODO upstream: check is_alive
    mob.mobEntity.target != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    # TODO upstream: check is_alive
    mob.mobEntity.target != nil
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BlazeShootFireballGoal(self)
    s.attackStep = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BlazeShootFireballGoal(self)
    s.setCharged(false)
    s.lastSeen = 0'i32
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BlazeShootFireballGoal(self)
    s.attackTime -= 1'i32
    let target = mob.mobEntity.target
    if target == nil:
      return
    # TODO upstream: hasLineOfSight check
    let hasLineOfSight = true
    s.lastSeen = 0'i32
    let blazeEntity = mob.mobEntity.livingEntity.entity
    let blazePos = blazeEntity.pos
    let targetPos = target.entity.pos
    let dx = targetPos.x - blazePos.x
    let dy = targetPos.y - blazePos.y
    let dz = targetPos.z - blazePos.z
    let distanceSq = dx * dx + dy * dy + dz * dz
    if distanceSq < 4.0'f64:
      if s.attackTime <= 0'i32:
        s.attackTime = 20'i32
        # TODO upstream: doHurtTarget
      # TODO upstream: set wanted position to target
    elif distanceSq < FollowDistance * FollowDistance and hasLineOfSight:
      let targetYOffset = targetPos.y + 0.5'f64 # roughly target.getY(0.5)
      let blazeYOffset = blazePos.y + 0.5'f64 # roughly blaze.getY(0.5)
      let yd = targetYOffset - blazeYOffset
      if s.attackTime <= 0'i32:
        s.attackStep += 1'i32
        if s.attackStep == 1'i32:
          s.attackTime = 60'i32
          s.setCharged(true)
        elif s.attackStep <= 4'i32:
          s.attackTime = 6'i32
        else:
          s.attackTime = 100'i32
          s.attackStep = 0'i32
          s.setCharged(false)
        if s.attackStep > 1'i32:
          let distance = sqrt(distanceSq)
          let sqd = sqrt(distance) * 0.5'f64
          # play shoot sound
          blazeEntity.world.broadcastToChunk(blazeEntity.chunkPos, CWorldEvent(event: 1018'i32, location: blazeEntity.blockPos,
            data: 0'i32, disableRelativeVolume: false))
          # Vanilla loops 1 time. Calculate spread.
          let dirX = (dx - 2.297'f64 * sqd) + randomF64() * (2.297'f64 * sqd * 2.0'f64)
          let dirZ = (dz - 2.297'f64 * sqd) + randomF64() * (2.297'f64 * sqd * 2.0'f64)
          let direction = Vector3[float64](x: dirX, y: yd, z: dirZ).normalize()
          # Spawn SmallFireball
          let world = blazeEntity.world
          var pos = blazePos
          pos.y += blazeEntity.getEyeHeight() - 0.1'f64
          let baseEntity = fromUuid(randomUuid(), world, pos, EntityType.SMALL_FIREBALL)
          let fireball = newSmallFireballShot(baseEntity, blazeEntity)
          baseEntity.velocity = direction
          spawnEntity(world, projectileBase(fireball))
      # Look at target
      mob.mobEntity.lookControl.lookAtEntity(mob, target)
    # else: `last_seen < 5`: TODO upstream: set wanted position to target
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let blazeShootFireballGoalVt* = makeVt()

proc newBlazeShootFireballGoal*(setCharged: proc(charged: bool) {.closure.}): BlazeShootFireballGoal =
  BlazeShootFireballGoal(vt: blazeShootFireballGoalVt, setCharged: setCharged, attackStep: 0'i32, attackTime: 0'i32, lastSeen: 0'i32)
