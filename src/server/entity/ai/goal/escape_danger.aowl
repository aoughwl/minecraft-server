## Port of pumpkin/src/entity/ai/goal/escape_danger.rs

import std/options
import ../aibase

const
  Range = 5'i32
  RecentDamageTicks = 100'i32
  TargetAttempts = 10

type
  EscapeDangerGoal* = ref object of Goal
    speed: float64
    target: Option[Vector3[float64]]

proc isInDanger(mob: Mob): bool =
  let living = mob.mobEntity.livingEntity
  if living.entity.fireTicks > 0'i32:
    return true
  let lastAttacked = living.lastAttackedTime
  if lastAttacked == 0'i32:
    return false
  living.entity.age - lastAttacked < RecentDamageTicks

proc findEscapeTarget(mob: Mob): Option[Vector3[float64]] =
  let pos = mob.mobEntity.livingEntity.entity.pos
  for i in 0 ..< TargetAttempts:
    let dx = randomRangeInclusive(-Range, Range)
    let dz = randomRangeInclusive(-Range, Range)
    if dx == 0'i32 and dz == 0'i32:
      continue
    return some(Vector3[float64](x: pos.x + float64(dx), y: pos.y, z: pos.z + float64(dz)))
  none[Vector3[float64]]()

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = EscapeDangerGoal(self)
    if not isInDanger(mob):
      return false
    s.target = findEscapeTarget(mob)
    s.target.isSome
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    not mob.mobEntity.navigator.isIdle()
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = EscapeDangerGoal(self)
    if s.target.isSome:
      let pos = mob.mobEntity.livingEntity.entity.pos
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(pos, s.target.unsafeGet, s.speed))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = EscapeDangerGoal(self)
    s.target = none[Vector3[float64]]()
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove

let escapeDangerGoalVt* = makeVt()

proc newEscapeDangerGoal*(speed: float64): EscapeDangerGoal =
  EscapeDangerGoal(vt: escapeDangerGoalVt, speed: speed, target: none[Vector3[float64]]())
