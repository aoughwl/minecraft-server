## Port of pumpkin/src/entity/ai/goal/follow_owner.rs
## Port of pumpkin/src/entity/ai/goal/follow_parent.rs
## Port of pumpkin/src/entity/ai/goal/owner_hurt_by_target.rs
## Port of pumpkin/src/entity/ai/goal/owner_hurt_target.rs
## Port of pumpkin/src/entity/ai/goal/tempt.rs
## Port of pumpkin/src/entity/ai/goal/beg.rs

import std/[math, options]
import ../../trackedalias
import ../../../../data/block_ext
from ../../../../data/block_state import isSolid, isAir, BlockState
import ../../../../generated/[item, meta_data_type, tracked_data]
from ../../../../generated/attributes import Attribute
import "../../../../data/item_stack/mod"
import ../../../../inventory/player_inventory
import ../../../../util/math/rustnum
import ../../../world/chunker
import ../aibase

const
  TeleportDistanceSq = 144.0'f64
  SearchRadius = 8.0'f64
  MinDistanceSq = 9.0'f64
  MaxDistanceSq = 256.0'f64
  SearchYRange = 4.0'f64
  OwnerFollowRange = 16.0'f64
  TemptRange = 10.0'f64
  StopDistance = 2.5'f64

type
  FollowOwnerGoal* = ref object of Goal
    speed: float64
    minDistanceSq, maxDistanceSq: float64
    updateCountdown: int32
    owner: nil Player

  FollowParentGoal* = ref object of Goal
    speed: float64
    parent: nil EntityBase
    delay: int32

  OwnerHurtByTargetGoal* = ref object of Goal
    target: nil EntityBase
    lastAttackedTime: int32

  OwnerHurtTargetGoal* = ref object of Goal
    target: nil EntityBase
    lastAttackTime: int32

  TemptGoal* = ref object of Goal
    speed: float64
    temptItems: seq[uint16]
    targetPlayer: nil Player
    cooldown: int32

  BegGoal* = ref object of Goal
    begDistanceSq: float64
    attractiveItems: seq[uint16]
    timer: int32
    target: nil Player

# --- FollowOwnerGoal --------------------------------------------------------------------------------------------------------------

proc findOwner(mob: Mob): nil Player =
  ## `find_owner`
  let ownerUuid = mob.getOwnerUuid()
  if ownerUuid.isNone:
    return nil
  let player = getPlayerByUuid(mob.mobEntity.livingEntity.entity.world, ownerUuid.unsafeGet)
  if player == nil or player.gamemode == Spectator:
    return nil
  player

proc tryTeleportToOwner(mob: Mob; owner: Player) =
  ## `try_teleport_to_owner`
  let ownerPos = owner.pos
  let mobEntity = mob.mobEntity.livingEntity.entity
  let world = mobEntity.world
  var offsets: seq[(int32, int32, int32)] = @[]
  for i in 0 ..< 10:
    let dx = randomRangeInclusive(-3'i32, 3'i32)
    let dy = randomRangeInclusive(-1'i32, 1'i32)
    let dz = randomRangeInclusive(-3'i32, 3'i32)
    offsets.add((dx, dy, dz))
  for o in offsets:
    if abs(o[0]) < 2'i32 and abs(o[2]) < 2'i32:
      continue
    let targetX = asI32(floor(ownerPos.x)) + o[0]
    let targetY = asI32(floor(ownerPos.y)) + o[1]
    let targetZ = asI32(floor(ownerPos.z)) + o[2]
    let below = BlockState.fromId(world.stateIdAt(BlockPos(vec: Vector3[int32](x: targetX, y: targetY - 1'i32, z: targetZ))))
    if not below.isSolid:
      continue
    let at = BlockState.fromId(world.stateIdAt(BlockPos(vec: Vector3[int32](x: targetX, y: targetY, z: targetZ))))
    let above = BlockState.fromId(world.stateIdAt(BlockPos(vec: Vector3[int32](x: targetX, y: targetY + 1'i32, z: targetZ))))
    if not at.isAir or not above.isAir:
      continue
    mobEntity.teleportEntity(Vector3[float64](x: float64(targetX) + 0.5'f64, y: float64(targetY), z: float64(targetZ) + 0.5'f64),
      none[float32](), none[float32](), world)
    mob.mobEntity.navigator.stop()
    return

proc makeFollowOwnerVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = FollowOwnerGoal(self)
    if mob.isSitting():
      return false
    let owner = findOwner(mob)
    if owner == nil:
      return false
    if mob.entity.pos.squaredDistanceToVec(owner.pos) < s.minDistanceSq:
      return false
    s.owner = owner
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = FollowOwnerGoal(self)
    if mob.isSitting():
      return false
    let owner = s.owner
    if owner == nil:
      return false
    # `owner.living_entity.entity.is_alive()`: `removal_reason` is never set on a player, so a removed one is what stands in.
    if owner.gamemode == Spectator or owner.removed:
      return false
    if mob.entity.pos.squaredDistanceToVec(owner.pos) <= s.maxDistanceSq:
      return false
    not mob.mobEntity.navigator.isIdle()
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowOwnerGoal(self)
    s.updateCountdown = 0'i32
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowOwnerGoal(self)
    let owner = s.owner
    if owner == nil:
      return
    let shouldTeleport = mob.entity.pos.squaredDistanceToVec(owner.pos) >= TeleportDistanceSq
    if not shouldTeleport:
      let ownerEyePos = playerBase(owner).entity.getEyePos()
      mob.mobEntity.lookControl.lookAtWithRange(ownerEyePos.x, ownerEyePos.y, ownerEyePos.z, 10.0'f32, mob.getMaxLookPitchChange())
    s.updateCountdown -= 1'i32
    if s.updateCountdown <= 0'i32:
      s.updateCountdown = toGoalTicks(10'i32)
      if shouldTeleport:
        tryTeleportToOwner(mob, owner)
      else:
        mob.mobEntity.navigator.setProgress(newNavigatorGoal(mob.entity.pos, owner.pos, s.speed))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowOwnerGoal(self)
    s.owner = nil
    mob.mobEntity.navigator.stop()
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let followOwnerGoalVt* = makeFollowOwnerVt()

proc newFollowOwnerGoal*(speed: float64; minDistance, maxDistance: float32): FollowOwnerGoal =
  FollowOwnerGoal(vt: followOwnerGoalVt, speed: speed, minDistanceSq: float64(minDistance * minDistance),
    maxDistanceSq: float64(maxDistance * maxDistance), updateCountdown: 0'i32, owner: nil)

# --- FollowParentGoal -------------------------------------------------------------------------------------------------------------

proc findParent(mob: Mob): nil EntityBase =
  ## `find_parent`
  let entity = mob.mobEntity.livingEntity.entity
  let pos = entity.pos
  result = nil
  var bestSq = 0.0'f64
  for candidate in entity.world.getNearbyEntities(pos, SearchRadius):
    let cEntity = candidate.entity
    if cEntity.entityType.id != entity.entityType.id:
      continue
    if cEntity.age < 0'i32:
      continue
    let cPos = cEntity.pos
    if abs(pos.y - cPos.y) > SearchYRange:
      continue
    let distSq = pos.squaredDistanceToVec(cPos)
    if distSq < MinDistanceSq:
      continue
    if result == nil or distSq < bestSq:
      result = candidate
      bestSq = distSq

proc makeFollowParentVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = FollowParentGoal(self)
    if mob.entity.age >= 0'i32:
      return false
    s.parent = findParent(mob)
    s.parent != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = FollowParentGoal(self)
    if mob.entity.age >= 0'i32:
      return false
    let parent = s.parent
    if parent == nil:
      return false
    if not parent.entity.isAlive():
      return false
    let distSq = mob.entity.pos.squaredDistanceToVec(parent.entity.pos)
    distSq >= MinDistanceSq and distSq <= MaxDistanceSq
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowParentGoal(self)
    s.delay = 0'i32
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowParentGoal(self)
    s.delay -= 1'i32
    if s.delay > 0'i32:
      return
    s.delay = toGoalTicks(10'i32)
    let parent = s.parent
    if parent != nil:
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(mob.entity.pos, parent.entity.pos, s.speed))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = FollowParentGoal(self)
    s.parent = nil

let followParentGoalVt* = makeFollowParentVt()

proc newFollowParentGoal*(speed: float64): FollowParentGoal =
  FollowParentGoal(vt: followParentGoalVt, speed: speed, parent: nil, delay: 0'i32)

# --- OwnerHurtByTargetGoal, OwnerHurtTargetGoal ----------------------------------------------------------------------------------------

proc ownerLiving(mob: Mob): nil LivingEntity =
  ## The owner, `owner.living_entity`: its adapter holds what `damage_with_context` records for a player.
  let ownerUuid = mob.getOwnerUuid()
  if ownerUuid.isNone:
    return nil
  let owner = getPlayerByUuid(mob.mobEntity.livingEntity.entity.world, ownerUuid.unsafeGet)
  if owner == nil:
    return nil
  playerBase(owner).living

proc targetStillInRange(mob: Mob): bool =
  let t = mob.mobEntity.target
  if t == nil:
    return false
  if not t.entity.isAlive():
    return false
  mob.entity.pos.squaredDistanceToVec(t.entity.pos) <= OwnerFollowRange * OwnerFollowRange

proc makeOwnerHurtByVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = OwnerHurtByTargetGoal(self)
    if mob.isSitting():
      return false
    let owner = ownerLiving(mob)
    if owner == nil:
      return false
    if owner.lastAttackedTime == s.lastAttackedTime:
      return false
    let attackerId = owner.lastAttackerId
    if attackerId == 0'i32:
      return false
    let attacker = getEntityById(mob.entity.world, attackerId)
    if attacker == nil:
      return false
    if not attacker.entity.isAlive():
      return false
    if not mob.canAttackWithOwner(cast[EntityBase](attacker), cast[EntityBase](owner.entity.base)):
      return false
    s.target = attacker
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} = targetStillInRange(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = OwnerHurtByTargetGoal(self)
    mob.mobEntity.target = s.target
    let owner = ownerLiving(mob)
    if owner != nil:
      s.lastAttackedTime = owner.lastAttackedTime
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = OwnerHurtByTargetGoal(self)
    s.target = nil
    mob.mobEntity.target = nil
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsTarget

let ownerHurtByTargetGoalVt* = makeOwnerHurtByVt()

proc newOwnerHurtByTargetGoal*(): OwnerHurtByTargetGoal =
  OwnerHurtByTargetGoal(vt: ownerHurtByTargetGoalVt, target: nil, lastAttackedTime: 0'i32)

proc makeOwnerHurtVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = OwnerHurtTargetGoal(self)
    if mob.isSitting():
      return false
    let owner = ownerLiving(mob)
    if owner == nil:
      return false
    if owner.lastAttackTime == s.lastAttackTime:
      return false
    let attackingId = owner.lastAttackingId
    if attackingId == 0'i32:
      return false
    let target = getEntityById(mob.entity.world, attackingId)
    if target == nil:
      return false
    if not target.entity.isAlive():
      return false
    if not mob.canAttackWithOwner(cast[EntityBase](target), cast[EntityBase](owner.entity.base)):
      return false
    s.target = target
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} = targetStillInRange(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = OwnerHurtTargetGoal(self)
    mob.mobEntity.target = s.target
    let owner = ownerLiving(mob)
    if owner != nil:
      s.lastAttackTime = owner.lastAttackTime
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = OwnerHurtTargetGoal(self)
    s.target = nil
    mob.mobEntity.target = nil
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsTarget

let ownerHurtTargetGoalVt* = makeOwnerHurtVt()

proc newOwnerHurtTargetGoal*(): OwnerHurtTargetGoal =
  OwnerHurtTargetGoal(vt: ownerHurtTargetGoalVt, target: nil, lastAttackTime: 0'i32)

# --- TemptGoal ---------------------------------------------------------------------------------------------------------------------

proc holdsOneOf(player: Player; items: seq[uint16]): bool =
  ## `is_holding_tempt_item`, `is_player_holding_attractive`
  let main = player.inventory.heldItem()
  if main.itemCount > 0'u8:
    for id in items:
      if id == main.item.id:
        return true
  let off = player.inventory.offHandItem()
  if off.itemCount > 0'u8:
    for id in items:
      if id == off.item.id:
        return true
  false

proc makeTemptVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = TemptGoal(self)
    if s.cooldown > 0'i32:
      s.cooldown -= 1'i32
      return false
    s.targetPlayer = nil
    for player in mob.entity.world.getNearbyPlayers(mob.entity.pos, TemptRange):
      if holdsOneOf(player, s.temptItems):
        s.targetPlayer = player
        break
    s.targetPlayer != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = TemptGoal(self)
    let player = s.targetPlayer
    if player == nil:
      return false
    if mob.entity.pos.squaredDistanceToVec(player.pos) > TemptRange * TemptRange:
      return false
    holdsOneOf(player, s.temptItems)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = TemptGoal(self)
    let player = s.targetPlayer
    if player != nil:
      let mobEntity = mob.mobEntity
      let playerPos = player.pos
      mobEntity.lookControl.lookAt(mob, playerPos.x, playerBase(player).entity.getEyeY(), playerPos.z)
      let mobPos = mobEntity.livingEntity.entity.pos
      if mobPos.squaredDistanceToVec(playerPos) > StopDistance * StopDistance:
        mobEntity.navigator.setProgress(newNavigatorGoal(mobPos, playerPos, s.speed))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = TemptGoal(self)
    s.targetPlayer = nil
    s.cooldown = 100'i32
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let temptGoalVt* = makeTemptVt()

proc newTemptGoal*(speed: float64; temptItems: seq[uint16]): TemptGoal =
  ## `temptItems` holds item ids.
  TemptGoal(vt: temptGoalVt, speed: speed, temptItems: temptItems, targetPlayer: nil, cooldown: 0'i32)

# --- BegGoal -----------------------------------------------------------------------------------------------------------------------

proc setBegging(mob: Mob; begging: bool) =
  mob.mobEntity.livingEntity.entity.sendMetaData(TD_BEGGING, BOOLEAN, begging)

proc makeBegVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = BegGoal(self)
    let entity = mob.mobEntity.livingEntity.entity
    let player = entity.world.getClosestPlayer(entity.pos, sqrt(s.begDistanceSq))
    if player == nil:
      return false
    if not holdsOneOf(player, s.attractiveItems):
      return false
    s.target = player
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = BegGoal(self)
    let player = s.target
    if player == nil:
      return false
    if player.removed:
      return false
    if mob.entity.pos.squaredDistanceToVec(player.pos) > s.begDistanceSq:
      return false
    s.timer > 0'i32 and holdsOneOf(player, s.attractiveItems)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BegGoal(self)
    setBegging(mob, true)
    s.timer = self.getTickCount(40'i32 + randomRange(0'i32, 40'i32))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BegGoal(self)
    setBegging(mob, false)
    s.target = nil
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BegGoal(self)
    let player = s.target
    if player != nil:
      let playerPos = playerBase(player).entity.getEyePos()
      mob.mobEntity.lookControl.lookAtWithRange(playerPos.x, playerPos.y, playerPos.z, 10.0'f32, mob.getMaxLookPitchChange())
    s.timer -= 1'i32
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsLook

let begGoalVt* = makeBegVt()

proc newBegGoal*(begDistance: float32; attractiveItems: seq[uint16]): BegGoal =
  BegGoal(vt: begGoalVt, begDistanceSq: float64(begDistance * begDistance), attractiveItems: attractiveItems, timer: 0'i32,
    target: nil)
