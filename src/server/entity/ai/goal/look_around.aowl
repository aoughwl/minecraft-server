## Port of pumpkin/src/entity/ai/goal/look_around.rs

import std/math
import ../aibase

type
  RandomLookAroundGoal* = ref object of Goal
    deltaX, deltaZ: float64
    lookTime: int32

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} = randomF32() < 0.02'f32
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = RandomLookAroundGoal(self)
    s.lookTime >= 0'i32
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = RandomLookAroundGoal(self)
    let d = TAU * randomF64()
    s.deltaX = cos(d)
    s.deltaZ = sin(d)
    s.lookTime = 20'i32 + randomRange(0'i32, 20'i32)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = RandomLookAroundGoal(self)
    let mobEntity = mob.mobEntity
    s.lookTime -= 1'i32
    let pos = mobEntity.livingEntity.entity.pos
    mobEntity.lookControl.lookAt(mob, pos.x + s.deltaX, mobEntity.livingEntity.entity.getEyeY(), pos.z + s.deltaZ)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let randomLookAroundGoalVt* = makeVt()

proc newRandomLookAroundGoal*(): RandomLookAroundGoal =
  RandomLookAroundGoal(vt: randomLookAroundGoalVt, deltaX: 0.0'f64, deltaZ: 0.0'f64, lookTime: 0'i32)
