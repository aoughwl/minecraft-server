## Port of pumpkin/src/entity/ai/goal/look_at_entity.rs
##
## Upstream's `Weak<dyn Mob>` goes into the target predicate, and nothing ever consults that predicate
## (`TargetPredicate::test` does not call it, and this goal never calls `test`). It is kept for shape.

import ../aibase
import ../../predicate as entitypredicate

type
  LookAtEntityGoal* = ref object of Goal
    target: nil EntityBase
    range: float32
    lookTime: int32
    chance: float32
    lookForward: bool
    targetType: EntityType
    targetPredicate: TargetPredicate

proc createTargetPredicate(mob: nil Mob; targetType: EntityType; range: float32): TargetPredicate =
  result = createNonAttackable()
  result.baseMaxDistance = float64(range) # TODO upstream
  if targetType.id == EntityType.PLAYER.id:
    result.setPredicate(proc(livingEntity: LivingEntity; world: World): bool {.closure.} =
      if mob != nil:
        testRides(mob.entity, livingEntity.entity)
      else:
        # MobEntity is destroyed
        false)

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = LookAtEntityGoal(self)
    if randomF32() >= s.chance:
      return false
    let mobEntity = mob.mobEntity
    if mobEntity.target != nil:
      s.target = mobEntity.target
    let world = mobEntity.livingEntity.entity.world
    let mobPos = mobEntity.livingEntity.entity.pos
    if s.targetType.id == EntityType.PLAYER.id:
      s.target = playerBaseOrNil(world.getClosestPlayer(mobPos, float64(s.range)))
    else:
      s.target = world.getClosestEntity(mobPos, float64(s.range), [s.targetType])
    s.target != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = LookAtEntityGoal(self)
    let target = s.target
    if target != nil:
      if not target.entity.isAlive():
        return false
      let mobPos = mob.mobEntity.livingEntity.entity.pos
      if float32(mobPos.squaredDistanceToVec(target.entity.pos)) > s.range * s.range:
        return false
      return s.lookTime > 0'i32
    false
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = LookAtEntityGoal(self)
    s.lookTime = self.getTickCount(40'i32 + randomRange(0'i32, 40'i32))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = LookAtEntityGoal(self)
    s.target = nil
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = LookAtEntityGoal(self)
    let mobEntity = mob.mobEntity
    let target = s.target
    if target != nil:
      let targetEntity = target.entity
      if targetEntity.isAlive():
        let targetPos = targetEntity.pos
        let lookY = if s.lookForward: mobEntity.livingEntity.entity.getEyeY() else: targetEntity.getEyeY()
        mobEntity.lookControl.lookAt(mob, targetPos.x, lookY, targetPos.z)
        s.lookTime -= 1'i32
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsLook

let lookAtEntityGoalVt* = makeVt()

proc newLookAtEntityGoal*(mob: nil Mob; targetType: EntityType; range, chance: float32; lookForward: bool): LookAtEntityGoal =
  ## `LookAtEntityGoal::new`
  LookAtEntityGoal(vt: lookAtEntityGoalVt, target: nil, range: range, lookTime: 0'i32, chance: chance,
    lookForward: lookForward, targetType: targetType, targetPredicate: createTargetPredicate(mob, targetType, range))

proc lookAtEntityGoalWithDefault*(mob: nil Mob; targetType: EntityType; range: float32): LookAtEntityGoal =
  ## `LookAtEntityGoal::with_default`
  newLookAtEntityGoal(mob, targetType, range, 0.02'f32, false)
