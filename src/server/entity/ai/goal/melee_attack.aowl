## Port of pumpkin/src/entity/ai/goal/melee_attack.rs
## Port of pumpkin/src/entity/ai/goal/zombie_attack.rs

import std/options
import ../aibase

const
  MaxAttackTime = 20'i64

type
  MeleeAttackGoal* = ref object of Goal
    speed: float64
    pauseWhenMobIdle: bool
    updateCountdownTicks: int32
    cooldown*: int32
    lastUpdateTime: int64
    lastTargetPosition: Option[Vector3[float64]]

  ZombieAttackGoal* = ref object of Goal
    meleeAttackGoal: MeleeAttackGoal
    ticks: int32

proc getMaxCooldown*(self: Goal): int32 =
  ## `get_max_cooldown`
  self.getTickCount(20'i32)

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = MeleeAttackGoal(self)
    let time = mob.entity.world.levelTime.worldAge
    if time - s.lastUpdateTime < MaxAttackTime:
      return false
    s.lastUpdateTime = time
    let target = mob.mobEntity.target
    if target == nil:
      return false
    if not target.entity.isAlive():
      return false
    # TODO upstream: if a path to the target does not exist then call mob.is_in_attack_range(target)
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = MeleeAttackGoal(self)
    let target = mob.mobEntity.target
    if target == nil:
      return false
    if not target.entity.isAlive():
      return false
    if not s.pauseWhenMobIdle:
      return not mob.mobEntity.navigator.isIdle()
    let player = target.player
    let isValidTarget = not (player != nil and (player.gamemode == Spectator or player.gamemode == Creative))
    mob.mobEntity.isInPositionTargetRangePos(target.entity.blockPos) and isValidTarget
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = MeleeAttackGoal(self)
    # TODO upstream: add missing fields like mob attacking to true and correct Navigation methods
    let target = mob.mobEntity.target
    if target != nil:
      let targetPos = target.entity.pos
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(mob.entity.pos, targetPos, s.speed))
      s.lastTargetPosition = some(targetPos)
    s.updateCountdownTicks = 0'i32
    s.cooldown = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = MeleeAttackGoal(self)
    # Upstream's test on the target's `Entity` is `ExceptCreativeOrSpectator`, which is always false there
    # (see predicate.aowl), so any target at all is cleared here.
    if mob.mobEntity.target != nil:
      mob.setMobTarget(nil)
    # Vanilla: this.mob.getNavigation().stop()
    mob.mobEntity.navigator.stop()
    s.lastTargetPosition = none[Vector3[float64]]()
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = MeleeAttackGoal(self)
    let target = mob.mobEntity.target
    if target == nil:
      return
    mob.mobEntity.lookControl.lookAtEntityWithRange(target, 30.0'f32, 30.0'f32)
    s.updateCountdownTicks = max(s.updateCountdownTicks - 1'i32, 0'i32)
    let currentTargetPos = target.entity.pos
    var shouldUpdateNav = false
    if s.updateCountdownTicks <= 0'i32:
      shouldUpdateNav = s.lastTargetPosition.isNone or
        currentTargetPos.squaredDistanceToVec(s.lastTargetPosition.unsafeGet) >= 1.0'f64 or
        randomRange(0'i32, 20'i32) == 0'i32
    if shouldUpdateNav:
      let mobPos = mob.entity.pos
      let distSq = mobPos.squaredDistanceToVec(currentTargetPos)
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(mobPos, currentTargetPos, s.speed))
      s.lastTargetPosition = some(currentTargetPos)
      s.updateCountdownTicks = 4'i32 + randomRange(0'i32, 7'i32)
      if distSq > 1024.0'f64:
        s.updateCountdownTicks += 10'i32
      elif distSq > 256.0'f64:
        s.updateCountdownTicks += 5'i32
    s.cooldown = max(s.cooldown - 1'i32, 0'i32)
    # TODO upstream: Add visibility check (canSee) - requires world raycast
    if s.cooldown <= 0'i32 and mob.mobEntity.isInAttackRange(target):
      s.cooldown = self.getMaxCooldown()
      mob.mobEntity.livingEntity.swingHand()
      mob.mobEntity.tryAttack(mob, target)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let meleeAttackGoalVt* = makeVt()

proc newMeleeAttackGoal*(speed: float64; pauseWhenMobIdle: bool): MeleeAttackGoal =
  ## `MeleeAttackGoal::new`
  MeleeAttackGoal(vt: meleeAttackGoalVt, speed: max(speed, 0.23'f64), pauseWhenMobIdle: pauseWhenMobIdle,
    updateCountdownTicks: 0'i32, cooldown: 0'i32, lastUpdateTime: 0'i64, lastTargetPosition: none[Vector3[float64]]())

proc makeZombieVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.canStart(mob)
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.shouldContinue(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.start(mob)
    s.ticks = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.stop(mob)
    mob.mobEntity.setAttacking(false)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.tick(mob)
    s.ticks += 1'i32
    let melee = s.meleeAttackGoal
    mob.mobEntity.setAttacking(s.ticks >= 5'i32 and melee.cooldown < melee.getMaxCooldown() div 2'i32)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.shouldRunEveryTick()
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = ZombieAttackGoal(self)
    s.meleeAttackGoal.controls()

let zombieAttackGoalVt* = makeZombieVt()

proc newZombieAttackGoal*(speed: float64; pauseWhenMobIdle: bool): ZombieAttackGoal =
  ZombieAttackGoal(vt: zombieAttackGoalVt, meleeAttackGoal: newMeleeAttackGoal(speed, pauseWhenMobIdle), ticks: 0'i32)
