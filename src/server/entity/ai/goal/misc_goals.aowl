import std/[math, options]
from ../../../../data/block_state import isSolid, BlockState, asU16, isAir
import ../../../../data/block_ext
import ../../../../generated/[sound, sound_category, statistic, tag]
import ../../../../util/math/rustnum
import ../../../../world/world as worldtraits
import ../aibase

const
  FastDistanceSq = 49.0'f64
  HorizontalRange = 16.0'f64
  VerticalRange = 7'i32
  MaxTimer = 40'i32

type
  AmbientStandGoal* = ref object of Goal
    cooldown: int32

  AvoidEntityGoal* = ref object of Goal
    fleeType: EntityType
    fleeDistance: float64
    slowSpeed, fastSpeed: float64
    target: nil EntityBase
    fleePos: Option[Vector3[float64]]

  BreedGoal* = ref object of Goal
    speed: float64
    mate: nil EntityBase
    timer: int32

  EatGrassGoal* = ref object of Goal
    timer: int32

  CreeperIgniteGoal* = ref object of Goal
    ## Upstream holds the `Arc<CreeperEntity>`. entity/mob/creeper gives the two calls this reads.
    fuseSpeed: proc(): int32 {.closure.}
    setFuseSpeed: proc(speed: int32) {.closure.}

# --- AmbientStandGoal --------------------------------------------------------------------------------------------------------------

proc makeAmbientVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = AmbientStandGoal(self)
    s.cooldown += 1'i32
    if s.cooldown > 0'i32 and randomRange(0'i32, 1000'i32) < s.cooldown:
      # `reset_cooldown`. TODO upstream: this.cooldown = -entity.getMinAmbientStandDelay()
      s.cooldown = 0'i32
    false
  result.controls = proc(self: Goal): Controls {.closure.} = emptyControls()

let ambientStandGoalVt* = makeAmbientVt()

proc newAmbientStandGoal*(): AmbientStandGoal =
  ## Upstream has no constructor and derives nothing; `goal_control` is `Controls::empty`.
  AmbientStandGoal(vt: ambientStandGoalVt, cooldown: 0'i32)

# --- AvoidEntityGoal ----------------------------------------------------------------------------------------------------------------

proc findThreat(self: AvoidEntityGoal; mob: Mob): nil EntityBase =
  ## `find_threat`
  let entity = mob.mobEntity.livingEntity.entity
  if self.fleeType.id == EntityType.PLAYER.id:
    playerBaseOrNil(entity.world.getClosestPlayer(entity.pos, self.fleeDistance))
  else:
    entity.world.getClosestEntity(entity.pos, self.fleeDistance, [self.fleeType])

proc findFleePosition*(mob: Mob; threatPos: Vector3[float64]): Option[Vector3[float64]] =
  ## `find_flee_position`: a random walkable position within a cone pointing away from the threat. Mirrors vanilla's
  ## `NoPenaltyTargeting.findFrom()`.
  let entity = mob.mobEntity.livingEntity.entity
  let mobPos = entity.pos
  let world = entity.world
  var dirX = mobPos.x - threatPos.x
  var dirZ = mobPos.z - threatPos.z
  if dirX == 0.0'f64 and dirZ == 0.0'f64:
    dirX = randomRangeF64(-1.0'f64, 1.0'f64)
    dirZ = randomRangeF64(-1.0'f64, 1.0'f64)
  let baseAngle = arctan2(dirZ, dirX) - PI / 2.0'f64
  var candidates: seq[(float64, int32, float64)] = @[]
  for i in 0 ..< 10:
    let angle = baseAngle + (2.0'f64 * randomF64() - 1.0'f64) * (PI / 2.0'f64)
    let t = sqrt(randomF64())
    let dist = t * HorizontalRange * sqrt(2.0'f64)
    let dx = -dist * sin(angle)
    let dz = dist * cos(angle)
    let dy = randomRangeInclusive(-VerticalRange, VerticalRange)
    candidates.add((dx, dy, dz))
  let threatToMobSq = threatPos.squaredDistanceToVec(mobPos)
  for c in candidates:
    if abs(c[0]) > HorizontalRange or abs(c[2]) > HorizontalRange:
      continue
    let candidate = BlockPos(vec: Vector3[int32](x: asI32(mobPos.x + c[0]), y: asI32(mobPos.y + float64(c[1])),
      z: asI32(mobPos.z + c[2])))
    let blockAt = BlockState.fromId(world.stateIdAt(candidate))
    let blockBelow = BlockState.fromId(world.stateIdAt(candidate.down()))
    if blockAt.isSolid or not blockBelow.isSolid:
      continue
    let fleeVec = Vector3[float64](x: float64(candidate.vec.x) + 0.5'f64, y: float64(candidate.vec.y),
      z: float64(candidate.vec.z) + 0.5'f64)
    if threatPos.squaredDistanceToVec(fleeVec) < threatToMobSq:
      continue
    return some(fleeVec)
  none[Vector3[float64]]()

proc makeAvoidVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = AvoidEntityGoal(self)
    let threat = s.findThreat(mob)
    if threat == nil:
      return false
    let fleePos = findFleePosition(mob, threat.entity.pos)
    if fleePos.isNone:
      return false
    s.target = threat
    s.fleePos = fleePos
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} = not mob.mobEntity.navigator.isIdle()
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = AvoidEntityGoal(self)
    if s.fleePos.isSome:
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(mob.entity.pos, s.fleePos.unsafeGet, s.slowSpeed))
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = AvoidEntityGoal(self)
    let target = s.target
    if target != nil:
      let distSq = mob.entity.pos.squaredDistanceToVec(target.entity.pos)
      mob.mobEntity.navigator.setSpeed(if distSq < FastDistanceSq: s.fastSpeed else: s.slowSpeed)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = AvoidEntityGoal(self)
    s.target = nil
    s.fleePos = none[Vector3[float64]]()
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove

let avoidEntityGoalVt* = makeAvoidVt()

proc newAvoidEntityGoal*(fleeType: EntityType; fleeDistance, slowSpeed, fastSpeed: float64): AvoidEntityGoal =
  AvoidEntityGoal(vt: avoidEntityGoalVt, fleeType: fleeType, fleeDistance: fleeDistance, slowSpeed: slowSpeed,
    fastSpeed: fastSpeed, target: nil, fleePos: none[Vector3[float64]]())

# --- BreedGoal ----------------------------------------------------------------------------------------------------------------------

proc findMate(mob: Mob): nil EntityBase =
  ## `find_mate`
  let mobEntity = mob.mobEntity
  if not mobEntity.isInLove():
    return nil
  let entity = mob.entity
  let pos = entity.pos
  result = nil
  var best = 0.0'f64
  for candidate in entity.world.getNearbyEntities(pos, 8.0'f64):
    let cEntity = candidate.entity
    if cEntity.entityUuid == entity.entityUuid:
      continue
    if cEntity.entityType.id != entity.entityType.id:
      continue
    if not entitymod.isInLove(candidate) or not entitymod.isBreedingReady(candidate) or entitymod.isPanicking(candidate):
      continue
    let dist = pos.squaredDistanceToVec(cEntity.pos)
    if result == nil or dist < best:
      result = candidate
      best = dist

proc breed(mob: Mob; mate: EntityBase) =
  ## `breed`
  let mobEntity = mob.mobEntity
  let entity = mob.entity
  let world = entity.world
  if mobEntity.breeder.isSome:
    let player = getPlayerByUuid(world, mobEntity.breeder.unsafeGet)
    if player != nil:
      gPlayerHooks.incrementStat(player, scCustom, int32(ord(csAnimalsBred)), 1'i32)
      gPlayerHooks.triggerAdvancement(player, "BredAnimal", "minecraft:" & entity.entityType.resourceName)
  mobEntity.resetLoveTicks()
  mobEntity.breedingCooldown = 6000'i32
  entitymod.resetLove(mate)
  entitymod.setBreedingCooldown(mate, 6000'i32)
  let baby = callFromType(entity.entityType, entity.pos, world, randomUuid())
  if baby != nil:
    let spawned = cast[EntityBase](baby)
    spawned.entity.setAge(-24000'i32)
    spawnEntity(world, spawned)

proc makeBreedVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = BreedGoal(self)
    let mobEntity = mob.mobEntity
    if not mobEntity.isBreedingReady() or not mobEntity.isInLove():
      return false
    s.mate = findMate(mob)
    s.mate != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = BreedGoal(self)
    let mate = s.mate
    if mate == nil:
      return false
    if not mate.entity.isAlive() or entitymod.isPanicking(mate):
      return false
    entitymod.isInLove(mate) and s.timer < 60'i32
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BreedGoal(self)
    s.timer = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BreedGoal(self)
    s.mate = nil
    s.timer = 0'i32
    mob.mobEntity.navigator.stop()
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = BreedGoal(self)
    let mate = s.mate
    if mate == nil:
      return
    let mobEntity = mob.mobEntity
    let matePos = mate.entity.pos
    mobEntity.lookControl.lookAtEntity(mob, mate)
    let myPos = mob.entity.pos
    let distSq = myPos.squaredDistanceToVec(matePos)
    mobEntity.navigator.setProgress(newNavigatorGoal(myPos, matePos, s.speed))
    s.timer += 1'i32
    if s.timer >= 60'i32 and distSq < 9.0'f64:
      breed(mob, mate)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook

let breedGoalVt* = makeBreedVt()

proc newBreedGoal*(speed: float64): BreedGoal =
  BreedGoal(vt: breedGoalVt, speed: speed, mate: nil, timer: 0'i32)

# --- EatGrassGoal -------------------------------------------------------------------------------------------------------------------

proc stateIdU32(b: Block): uint32 = uint32(asU16(b.defaultState.id))

proc makeEatGrassVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    if randomRange(0'i32, 1000'i32) != 0'i32:
      return false
    let entity = mob.mobEntity.livingEntity.entity
    let blockPos = entity.blockPos
    let world = entity.world
    if hasTag(asU16(world.getBlock(blockPos).id), Block_MINECRAFT_EDIBLE_FOR_SHEEP):
      return true
    world.getBlock(blockPos.down()).id == blockIdGrassBlock
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = EatGrassGoal(self)
    s.timer > 0'i32
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = EatGrassGoal(self)
    s.timer = MaxTimer
    mob.mobEntity.navigator.stop()
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = EatGrassGoal(self)
    s.timer -= 1'i32
    if s.timer == 4'i32:
      let entity = mob.mobEntity.livingEntity.entity
      let blockPos = entity.blockPos
      let world = entity.world
      if hasTag(asU16(world.getBlock(blockPos).id), Block_MINECRAFT_EDIBLE_FOR_SHEEP):
        discard world.setBlockState(blockPos, stateIdU32(blockAir()), BfNotifyAll)
        mob.onEatingGrass()
      else:
        let belowPos = blockPos.down()
        if world.getBlock(belowPos).id == blockIdGrassBlock:
          discard world.setBlockState(belowPos, stateIdU32(blockDirt()), BfNotifyAll)
          mob.onEatingGrass()
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = EatGrassGoal(self)
    s.timer = 0'i32
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsLook or ControlsJump

let eatGrassGoalVt* = makeEatGrassVt()

proc newEatGrassGoal*(): EatGrassGoal =
  EatGrassGoal(vt: eatGrassGoalVt, timer: 0'i32)

proc getTimer*(self: EatGrassGoal): int32 = self.timer

# --- CreeperIgniteGoal --------------------------------------------------------------------------------------------------------------

proc makeCreeperVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = CreeperIgniteGoal(self)
    if s.fuseSpeed() > 0'i32:
      return true
    let target = mob.mobEntity.target
    if target != nil:
      return mob.entity.pos.squaredDistanceToVec(target.entity.pos) < 9.0'f64
    false
  result.start = proc(self: Goal; mob: Mob) {.closure.} = mob.mobEntity.navigator.stop()
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = CreeperIgniteGoal(self)
    s.setFuseSpeed(-1'i32)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = CreeperIgniteGoal(self)
    let target = mob.mobEntity.target
    if target == nil:
      s.setFuseSpeed(-1'i32)
      return
    let distSq = mob.entity.pos.squaredDistanceToVec(target.entity.pos)
    # TODO upstream: line of sight check (needs world raycast)
    s.setFuseSpeed(if distSq > 49.0'f64: -1'i32 else: 1'i32)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove

let creeperIgniteGoalVt* = makeCreeperVt()

proc newCreeperIgniteGoal*(fuseSpeed: proc(): int32 {.closure.}; setFuseSpeed: proc(speed: int32) {.closure.}): CreeperIgniteGoal =
  CreeperIgniteGoal(vt: creeperIgniteGoalVt, fuseSpeed: fuseSpeed, setFuseSpeed: setFuseSpeed)
