## Port of pumpkin/src/entity/ai/goal/move_to_target_pos.rs
## Port of pumpkin/src/entity/ai/goal/step_and_destroy_block.rs
## Port of pumpkin/src/entity/ai/goal/destroy_egg.rs
##
## Upstream's `MoveToTargetPos` and `Stepping` traits with a `ParentHandle` back to the implementor are `ref object`s of
## closures here; there is no ownership cycle to route around.

import std/options
import ../../../../data/block_ext
from ../../../../data/block_state import isAir, BlockState, asU16
import ../../../../generated/[sound, sound_category]
import ../../../../util/math/rustnum
import ../aibase

const
  MinWaitingTime = 1200'i32
  MaxTryingTime = 1200'i32
  MinInterval = 200'i32
  MaxCooldown = 20'i32

type
  MoveToTargetPos* = ref object
    ## `trait MoveToTargetPos`
    isTargetPos*: proc(world: World; blockPos: BlockPos): bool {.closure.}
    getDesiredDistanceToTarget*: proc(): float64 {.closure.}

  Stepping* = ref object
    ## `trait Stepping`
    tickStepping*: proc(world: World; blockPos: BlockPos) {.closure.}
    onDestroyBlock*: proc(world: World; blockPos: BlockPos) {.closure.}

  MoveToTargetPosGoal* = ref object of Goal
    moveToTargetPos*: nil MoveToTargetPos
    speed*: float64
    cooldown*: int32
    tryingTime*: int32
    safeWaitingTime*: int32
    targetPos*: BlockPos
    reached*: bool
    range*: int32
    maxYDifference*: int32
    lowestY*: int32

  StepAndDestroyBlockGoal* = ref object of Goal
    stepping*: nil Stepping
    moveToTargetPosGoal*: MoveToTargetPosGoal
    targetBlock: Block
    counter: int32

  DestroyEggGoal* = ref object of Goal
    stepAndDestroyBlockGoal*: StepAndDestroyBlockGoal

proc newMoveToTargetPos*(isTargetPos: proc(world: World; blockPos: BlockPos): bool {.closure.}): MoveToTargetPos =
  ## The trait's default `get_desired_distance_to_target`.
  MoveToTargetPos(isTargetPos: isTargetPos, getDesiredDistanceToTarget: proc(): float64 {.closure.} = 1.0'f64)

proc getInterval*(mob: Mob): int32 =
  ## `get_interval`
  toGoalTicks(MinInterval + randomRange(0'i32, MinInterval))

proc findTargetPos*(self: MoveToTargetPosGoal; mob: Mob): bool =
  ## `find_target_pos`
  let blockPos = mob.entity.blockPos
  var k = self.lowestY
  while k <= self.maxYDifference:
    for l in 0'i32 ..< self.range:
      var m = 0'i32
      while m <= l:
        var n = if m < l and m > -l: l else: 0'i32
        while n <= l:
          let candidate = BlockPos(vec: Vector3[int32](x: blockPos.vec.x + m, y: blockPos.vec.y + k - 1'i32,
            z: blockPos.vec.z + n))
          let world = mob.entity.world
          let hook = self.moveToTargetPos
          let canTarget = if hook != nil: hook.isTargetPos(world, candidate) else: false
          if mob.mobEntity.isInPositionTargetRangePos(candidate) and canTarget:
            self.targetPos = candidate
            return true
          n = if n > 0'i32: -n else: 1'i32 - n
        m = if m > 0'i32: -m else: 1'i32 - m
    k = if k > 0'i32: -k else: 1'i32 - k
  false

proc makeMoveVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = MoveToTargetPosGoal(self)
    if s.cooldown > 0'i32:
      s.cooldown -= 1'i32
      return false
    s.cooldown = getInterval(mob)
    s.findTargetPos(mob)
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = MoveToTargetPosGoal(self)
    let hook = s.moveToTargetPos
    let canTarget = if hook != nil: hook.isTargetPos(mob.entity.world, s.targetPos) else: false
    s.tryingTime >= -s.safeWaitingTime and s.tryingTime <= MaxTryingTime and canTarget
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = MoveToTargetPosGoal(self)
    # `start_moving_to_target`: TODO upstream, implement when navigation is implemented
    s.tryingTime = 0'i32
    let random = randomRange(0'i32, MinWaitingTime)
    s.safeWaitingTime = randomRange(random, MinWaitingTime) + MinWaitingTime
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = MoveToTargetPosGoal(self)
    let blockPos = s.targetPos.up().toF64()
    let hook = s.moveToTargetPos
    if hook == nil:
      return
    let desiredDistance = hook.getDesiredDistanceToTarget()
    if blockPos.squaredDistanceToVec(mob.entity.pos) < desiredDistance * desiredDistance:
      s.reached = true
      s.tryingTime -= 1'i32
    else:
      s.reached = false
      s.tryingTime += 1'i32
      # `should_reset_path`
      if s.tryingTime mod 40'i32 == 0'i32:
        mob.mobEntity.navigator.setProgress(newNavigatorGoal(mob.entity.pos,
          Vector3[float64](x: blockPos.x + 0.5'f64, y: blockPos.y, z: blockPos.z + 0.5'f64), s.speed))
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove or ControlsJump

let moveToTargetPosGoalVt* = makeMoveVt()

proc newMoveToTargetPosGoal*(moveToTargetPos: nil MoveToTargetPos; speed: float64; range, maxYDifference: int32): MoveToTargetPosGoal =
  ## `MoveToTargetPosGoal::new`
  MoveToTargetPosGoal(vt: moveToTargetPosGoalVt, moveToTargetPos: moveToTargetPos, speed: speed, cooldown: 0'i32,
    tryingTime: 0'i32, safeWaitingTime: 0'i32, targetPos: BlockPos(vec: Vector3[int32](x: 0'i32, y: 0'i32, z: 0'i32)),
    reached: false, range: range, maxYDifference: maxYDifference, lowestY: 0'i32)

proc moveToTargetPosGoalWithDefault*(moveToTargetPos: nil MoveToTargetPos; speed: float64; range: int32): MoveToTargetPosGoal =
  ## `MoveToTargetPosGoal::with_default`
  newMoveToTargetPosGoal(moveToTargetPos, speed, range, 1'i32)

# --- StepAndDestroyBlockGoal ------------------------------------------------------------------------------------------------------------

proc tweakToProperPos(self: StepAndDestroyBlockGoal; pos: BlockPos; world: World): Option[BlockPos] =
  ## `tweak_to_proper_pos`
  if world.getBlock(pos).id == self.targetBlock.id:
    return some(pos)
  for candidate in [pos.down(), pos.west(), pos.east(), pos.north(), pos.south(), pos.down().down()]:
    if world.getBlock(candidate).id == self.targetBlock.id:
      return some(candidate)
  none[BlockPos]()

proc isTargetPosDefault*(self: StepAndDestroyBlockGoal; world: World; blockPos: BlockPos): bool =
  ## `impl MoveToTargetPos for StepAndDestroyBlockGoal`: `is_target_pos`
  world.getBlock(blockPos).id == self.targetBlock.id and
    BlockState.fromId(world.stateIdAt(blockPos.up())).isAir and
    BlockState.fromId(world.stateIdAt(blockPos.upHeight(2'i32))).isAir

proc makeStepVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    let inner = s.moveToTargetPosGoal
    if not mob.entity.world.levelInfo.gameRules.mobGriefing:
      false
    elif inner.cooldown > 0'i32:
      inner.cooldown -= 1'i32
      false
    elif inner.findTargetPos(mob):
      inner.cooldown = toGoalTicks(MaxCooldown)
      true
    else:
      inner.cooldown = getInterval(mob)
      false
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    s.moveToTargetPosGoal.shouldContinue(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    s.moveToTargetPosGoal.start(mob)
    s.counter = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    # Assuming fall_distance is AtomicF32/f32
    mob.mobEntity.livingEntity.fallDistance = 1.0'f32
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    s.moveToTargetPosGoal.tick(mob)
    let mobEntity = mob.mobEntity
    let world = mob.entity.world
    let tweakPos = s.tweakToProperPos(mob.entity.blockPos, world)
    if not s.moveToTargetPosGoal.reached or tweakPos.isNone:
      return
    let counter = s.counter
    let entity = mobEntity.livingEntity.entity
    if counter > 0'i32:
      entity.setVelocity(Vector3[float64](x: entity.velocity.x, y: 0.3'f64, z: entity.velocity.z))
      # TODO upstream: spawn particles
    if counter mod 2'i32 == 0'i32:
      entity.setVelocity(Vector3[float64](x: entity.velocity.x, y: -0.3'f64, z: entity.velocity.z))
      if counter mod 6'i32 == 0'i32:
        let stepping = s.stepping
        if stepping != nil:
          stepping.tickStepping(world, s.moveToTargetPosGoal.targetPos)
        # `self.tick_stepping`, the goal's own, is a no-op.
    if counter > 60'i32:
      # TODO upstream: world.removeBlock HOW?
      # TODO upstream: spawn particles
      # `self.on_destroy_block`: the goal's own, a no-op, not `stepping`'s. As upstream.
      discard
    s.counter += 1'i32
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    s.moveToTargetPosGoal.shouldRunEveryTick()
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = StepAndDestroyBlockGoal(self)
    s.moveToTargetPosGoal.controls()

let stepAndDestroyBlockGoalVt* = makeStepVt()

proc newStepAndDestroyBlockGoal*(stepping: nil Stepping; moveToTargetPos: nil MoveToTargetPos; targetBlock: Block; speed: float64;
    maxYDifference: int32): StepAndDestroyBlockGoal =
  ## `StepAndDestroyBlockGoal::new`
  StepAndDestroyBlockGoal(vt: stepAndDestroyBlockGoalVt, stepping: stepping,
    moveToTargetPosGoal: newMoveToTargetPosGoal(moveToTargetPos, speed, 24'i32, maxYDifference), targetBlock: targetBlock,
    counter: 0'i32)

proc stepAndDestroyBlockGoalWithDefault*(targetBlock: Block; speed: float64; maxYDifference: int32): StepAndDestroyBlockGoal =
  ## `StepAndDestroyBlockGoal::with_default`: `None` for both, and then `is_target_pos` answers false.
  newStepAndDestroyBlockGoal(nil, nil, targetBlock, speed, maxYDifference)

# --- DestroyEggGoal ---------------------------------------------------------------------------------------------------------------------

proc playEggSound(world: World; soundRef: Sound; category: SoundCategory; blockPos: BlockPos) =
  let random = randomF32()
  world.playSoundRaw(uint16(ord(soundRef)), category, blockPos.vec.toF64(), 0.7'f32, mulAdd(random, 0.2'f32, 0.9'f32))

proc makeEggVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.canStart(mob)
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.shouldContinue(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.start(mob)
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.stop(mob)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.tick(mob)
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.shouldRunEveryTick()
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = DestroyEggGoal(self)
    s.stepAndDestroyBlockGoal.controls()

let destroyEggGoalVt* = makeEggVt()

proc newDestroyEggGoal*(speed: float64; maxYDifference: int32): DestroyEggGoal =
  ## `DestroyEggGoal::new`
  let inner = newStepAndDestroyBlockGoal(nil, nil, blockTurtleEgg(), speed, maxYDifference)
  inner.stepping = Stepping(
    tickStepping: proc(world: World; blockPos: BlockPos) {.closure.} =
      playEggSound(world, sdEntityZombieDestroyEgg, scHostile, blockPos),
    onDestroyBlock: proc(world: World; blockPos: BlockPos) {.closure.} =
      playEggSound(world, sdEntityTurtleEggBreak, scBlocks, blockPos))
  inner.moveToTargetPosGoal.moveToTargetPos = MoveToTargetPos(
    isTargetPos: proc(world: World; blockPos: BlockPos): bool {.closure.} = inner.isTargetPosDefault(world, blockPos),
    getDesiredDistanceToTarget: proc(): float64 {.closure.} = 1.14'f64)
  DestroyEggGoal(vt: destroyEggGoalVt, stepAndDestroyBlockGoal: inner)
