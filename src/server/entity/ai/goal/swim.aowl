## Port of pumpkin/src/entity/ai/goal/swim.rs

import ../aibase

type
  SwimGoal* = ref object of Goal

proc isInFluid(mob: Mob): bool =
  let living = mob.mobEntity.livingEntity
  let entity = living.entity
  let inWater = entity.touchingWater and entity.waterHeight > living.getSwimHeight()
  inWater or entity.touchingLava

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} = isInFluid(mob)
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} = isInFluid(mob)
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    if randomF32() < 0.8'f32:
      mob.mobEntity.livingEntity.jumping = true
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsJump

let swimGoalVt* = makeVt()

proc newSwimGoal*(): SwimGoal =
  SwimGoal(vt: swimGoalVt)
