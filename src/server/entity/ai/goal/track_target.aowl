## Port of pumpkin/src/entity/ai/goal/track_target.rs
## Port of pumpkin/src/entity/ai/goal/active_target.rs
## Port of pumpkin/src/entity/ai/goal/revenge.rs

import ../aibase
from ../../../../generated/attributes import FOLLOW_RANGE

const
  Unset = 0'i32
  CanTrack = 1'i32
  CannotTrack = 2'i32
  DefaultReciprocalChance = 10'i32

type
  TrackTargetGoal* = ref object of Goal
    checkVisibility: bool
    checkCanNavigate: bool
    canNavigateFlag: int32
    checkCanNavigateCooldown: int32
    timeWithoutVisibility: int32
    maxTimeWithoutVisibility*: int32
    targetPredicate: TargetPredicate

  ActiveTargetGoal* = ref object of Goal
    trackTargetGoal: TrackTargetGoal
    target: nil EntityBase
    reciprocalChance: int32
    targetType: EntityType
    targetPredicate: TargetPredicate

  RevengeGoal* = ref object of Goal
    trackTargetGoal: TrackTargetGoal
    target: nil EntityBase
    lastAttackedTime: int32
    targetPredicate: TargetPredicate

proc canNavigateToEntity(self: TrackTargetGoal; mob: Mob; target: LivingEntity): bool =
  ## `can_navigate_to_entity`
  self.checkCanNavigateCooldown = toGoalTicks(10'i32 + randomRange(0'i32, 5'i32))
  # TODO upstream: after implementing path
  false

proc canTrack*(self: TrackTargetGoal; mob: Mob; target: nil LivingEntity; targetPredicate: TargetPredicate): bool =
  ## `can_track`: Vanilla's `canAttack` check inside `TargetGoal`.
  if target == nil:
    return false
  let mobEntity = mob.mobEntity
  let world = mobEntity.livingEntity.entity.world
  if not targetPredicate.test(world, mobEntity.livingEntity, target):
    return false
  # TODO upstream: isInPositionTargetRange (isWithinHome in Java) check
  if self.checkCanNavigate:
    self.checkCanNavigateCooldown -= 1'i32
    if self.checkCanNavigateCooldown <= 0'i32:
      self.canNavigateFlag = Unset
    if self.canNavigateFlag == Unset:
      let canReach = self.canNavigateToEntity(mob, target)
      self.canNavigateFlag = if canReach: CanTrack else: CannotTrack
    if self.canNavigateFlag == CannotTrack:
      return false
  true

proc makeTrackVt(): GoalVt =
  result = newGoalVt()
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = TrackTargetGoal(self)
    let mobEntity = mob.mobEntity
    let targetBase = mobEntity.target
    if targetBase == nil:
      return false
    let target = targetBase.living
    if target == nil:
      return false
    if not target.entity.isAlive():
      return false
    if not s.canTrack(mob, target, s.targetPredicate):
      return false
    # TODO upstream: Team checks (return false if on the same team)
    let distSq = mobEntity.livingEntity.entity.pos.squaredDistanceToVec(target.entity.pos)
    # Get follow range attribute value and check if target is within range
    let followRange = mobEntity.livingEntity.getAttributeValue(FOLLOW_RANGE)
    if distSq > followRange * followRange:
      return false
    if s.checkVisibility:
      # TODO upstream: mob.getSensing().hasLineOfSight(target)
      s.timeWithoutVisibility = 0'i32
    mob.setMobTarget(targetBase)
    true
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = TrackTargetGoal(self)
    s.canNavigateFlag = Unset
    s.checkCanNavigateCooldown = 0'i32
    s.timeWithoutVisibility = 0'i32
  result.stop = proc(self: Goal; mob: Mob) {.closure.} = mob.setMobTarget(nil)
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsTarget

let trackTargetGoalVt* = makeTrackVt()

proc newTrackTargetGoal*(checkVisibility, checkCanNavigate: bool): TrackTargetGoal =
  ## `TrackTargetGoal::new`
  TrackTargetGoal(vt: trackTargetGoalVt, checkVisibility: checkVisibility, checkCanNavigate: checkCanNavigate,
    canNavigateFlag: Unset, checkCanNavigateCooldown: 0'i32, timeWithoutVisibility: 0'i32,
    maxTimeWithoutVisibility: 60'i32, targetPredicate: createAttackable())

proc trackTargetGoalWithDefault*(checkVisibility: bool): TrackTargetGoal =
  newTrackTargetGoal(checkVisibility, false)

proc setUnseenMemoryTicks*(self: TrackTargetGoal; ticks: int32): TrackTargetGoal =
  self.maxTimeWithoutVisibility = ticks
  self

# --- ActiveTargetGoal ------------------------------------------------------------------------------------------------------------

proc setTarget*(self: ActiveTargetGoal; target: nil EntityBase) =
  self.target = target

proc findClosestTarget(self: ActiveTargetGoal; mob: MobEntity) =
  ## `find_closest_target`
  let followRange = mob.livingEntity.getAttributeValue(FOLLOW_RANGE)
  # Vanilla updates the target conditions with the current follow distance on every search
  self.targetPredicate.baseMaxDistance = followRange
  let world = mob.livingEntity.entity.world
  # Vanilla searches using getEyeY(), so we offset the position by the eye height
  var searchPos = mob.livingEntity.entity.pos
  searchPos.y += float64(mob.livingEntity.entity.entityDimension.eyeHeight)
  var potentialEntity: nil EntityBase = nil
  if self.targetType.id == EntityType.PLAYER.id:
    let player = world.getClosestPlayer(searchPos, followRange)
    if player != nil:
      potentialEntity = playerBase(player)
  else:
    potentialEntity = world.getClosestEntity(searchPos, followRange, [self.targetType])
  if potentialEntity != nil:
    let living = potentialEntity.living
    if living != nil and self.targetPredicate.test(world, mob.livingEntity, living):
      self.target = potentialEntity
      return
  self.target = nil

proc makeActiveVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ActiveTargetGoal(self)
    if s.reciprocalChance > 0'i32 and randomRange(0'i32, s.reciprocalChance) != 0'i32:
      return false
    s.findClosestTarget(mob.mobEntity)
    s.target != nil
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = ActiveTargetGoal(self)
    s.trackTargetGoal.shouldContinue(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ActiveTargetGoal(self)
    mob.setMobTarget(s.target)
    s.trackTargetGoal.start(mob)
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = ActiveTargetGoal(self)
    s.trackTargetGoal.stop(mob)
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = ActiveTargetGoal(self)
    s.trackTargetGoal.controls()

let activeTargetGoalVt* = makeActiveVt()

proc newActiveTargetGoal*(mob: MobEntity; targetType: EntityType; reciprocalChance: int32; checkVisibility,
    checkCanNavigate: bool; predicate: nil PredicateBox): ActiveTargetGoal =
  ## `ActiveTargetGoal::new`
  var targetPredicate = createAttackable()
  targetPredicate.baseMaxDistance = mob.livingEntity.getAttributeValue(FOLLOW_RANGE)
  if predicate != nil:
    targetPredicate.predicate = predicate
  ActiveTargetGoal(vt: activeTargetGoalVt, trackTargetGoal: newTrackTargetGoal(checkVisibility, checkCanNavigate), target: nil,
    reciprocalChance: toGoalTicks(reciprocalChance), targetType: targetType, targetPredicate: targetPredicate)

proc activeTargetGoalWithDefault*(mob: MobEntity; targetType: EntityType; checkVisibility: bool): ActiveTargetGoal =
  ## `ActiveTargetGoal::with_default`
  newActiveTargetGoal(mob, targetType, DefaultReciprocalChance, checkVisibility, false, nil)

# --- RevengeGoal ------------------------------------------------------------------------------------------------------------------

proc makeRevengeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = RevengeGoal(self)
    let mobEntity = mob.mobEntity
    let living = mobEntity.livingEntity
    let attackedTime = living.lastAttackedTime
    if attackedTime == s.lastAttackedTime:
      return false
    let attackerId = living.lastAttackerId
    if attackerId == 0'i32:
      return false
    let world = living.entity.world
    let attacker = world.getEntityById(attackerId)
    if attacker == nil:
      return false
    let attackerLiving = attacker.living
    if attackerLiving == nil:
      return false
    if not s.targetPredicate.test(world, mobEntity.livingEntity, attackerLiving):
      return false
    s.target = attacker
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = RevengeGoal(self)
    s.trackTargetGoal.shouldContinue(mob)
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = RevengeGoal(self)
    mob.setMobTarget(s.target)
    s.lastAttackedTime = mob.mobEntity.livingEntity.lastAttackedTime
    s.trackTargetGoal.maxTimeWithoutVisibility = 300'i32
    s.trackTargetGoal.start(mob)
    # TODO upstream: group revenge - call nearby mobs of same type to help
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = RevengeGoal(self)
    s.target = nil
    s.trackTargetGoal.stop(mob)
  result.controls = proc(self: Goal): Controls {.closure.} =
    let s = RevengeGoal(self)
    s.trackTargetGoal.controls()

let revengeGoalVt* = makeRevengeVt()

proc newRevengeGoal*(checkVisibility: bool): RevengeGoal =
  RevengeGoal(vt: revengeGoalVt, trackTargetGoal: trackTargetGoalWithDefault(checkVisibility), target: nil,
    lastAttackedTime: 0'i32, targetPredicate: createAttackable().ignoreVisibility().ignoreDistanceScalingFactor())
