## Port of pumpkin/src/entity/ai/goal/wander_around.rs

import std/options
import ../aibase

type
  WanderAroundGoal* = ref object of Goal
    speed: float64
    target: Option[Vector3[float64]]
    chance: int32

proc findWanderTarget(mob: Mob): Vector3[float64] =
  let pos = mob.mobEntity.livingEntity.entity.pos
  let horizontalRange = 10.0'f64
  let verticalRange = 7.0'f64
  let dx = randomRangeF64(-horizontalRange, horizontalRange)
  let dy = randomRangeF64(-verticalRange, verticalRange)
  let dz = randomRangeF64(-horizontalRange, horizontalRange)
  Vector3[float64](x: pos.x + dx, y: pos.y + dy, z: pos.z + dz)

proc makeVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} =
    let s = WanderAroundGoal(self)
    if randomRange(0'i32, s.chance) != 0'i32:
      return false
    s.target = some(findWanderTarget(mob))
    true
  result.shouldContinue = proc(self: Goal; mob: Mob): bool {.closure.} =
    not mob.mobEntity.navigator.isIdle()
  result.start = proc(self: Goal; mob: Mob) {.closure.} =
    let s = WanderAroundGoal(self)
    if s.target.isSome:
      let pos = mob.mobEntity.livingEntity.entity.pos
      mob.mobEntity.navigator.setProgress(newNavigatorGoal(pos, s.target.unsafeGet, s.speed))
  result.stop = proc(self: Goal; mob: Mob) {.closure.} =
    let s = WanderAroundGoal(self)
    s.target = none[Vector3[float64]]()
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsMove

let wanderAroundGoalVt* = makeVt()

proc newWanderAroundGoal*(speed: float64): WanderAroundGoal =
  WanderAroundGoal(vt: wanderAroundGoalVt, speed: speed, target: none[Vector3[float64]](), chance: toGoalTicks(120'i32))
