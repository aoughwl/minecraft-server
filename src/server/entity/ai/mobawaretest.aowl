## mobaware.aowl and the body-aware pathfinding hook: a path detours around a body that fills air cells, a body deck is a
## floor, rain shelter search finds the nearest covered standable cell (block roof or body roof), and the goal walks a mob
## there. Stone floor at y=63 over 9 chunks; bodies are fake collision providers (the same seam the real body manager uses).

import std/[assertions, options, syncio]
import ../../../data/block_ext
from ../../../data/block_state import asU16
import ../../../world/[chunkdata, level]
import ../mob/testworld
import ../collision_providers
import aibase
import mobaware
import pathfinder/pathfindermod

let server = newTestServer()
let world0 = newTestWorld(server, "mobaware")
let lvl = world0.level

proc stateOf(b: Block): uint32 = uint32(asU16(b.defaultState.id))
for cx in -1'i32 .. 1'i32:
  for cz in -1'i32 .. 1'i32:
    addLoadedChunk(lvl, newChunkData(cx, cz, newChunkSections(24, -64'i32)))
    for x in 0'i32 .. 15'i32:
      for z in 0'i32 .. 15'i32:
        discard level.setBlockState(lvl, BlockPos(vec: Vector3[int32](x: cx * 16'i32 + x, y: 63'i32, z: cz * 16'i32 + z)),
          stateOf(blockStone()))

var fakeBoxes: seq[BoundingBox] = @[]
proc fakeQuery(handle: int; region: BoundingBox; moverId: int32; outBoxes: var seq[ProvidedBox]) {.nimcall.} =
  for b in fakeBoxes:
    if b.intersects(region):
      outBoxes.add(ProvidedBox(box: b, surfaceVel: pos3(0.0, 0.0, 0.0)))

proc box(x0, y0, z0, x1, y1, z1: float64): BoundingBox = newBoundingBox(pos3(x0, y0, z0), pos3(x1, y1, z1))
proc cell(x, y, z: int32): BlockPos = BlockPos(vec: Vector3[int32](x: x, y: y, z: z))

proc newMob(x, z: float64): Mob =
  newPlainMob(newEntity(world0, pos3(x, 64.0, z), EntityType.ZOMBIE))

proc pathTo(mob: Mob; x, z: float64): nil Path =
  let nav = newNavigator()
  nav.computePath(mob.mobEntity.livingEntity, pos3(x, 64.0, z))

proc pathHitsBox(p: nil Path; b: BoundingBox): bool =
  if p == nil:
    return false
  var i = 0
  while true:
    let n = p.getNode(i)
    if n.isNone:
      return false
    let v = n.unsafeGet.pos.vec
    if box(float64(v.x), float64(v.y), float64(v.z), float64(v.x) + 1.0, float64(v.y) + 1.0, float64(v.z) + 1.0).intersects(b):
      return true
    inc i

proc pathLen(p: nil Path): int =
  if p == nil:
    return -1
  var i = 0
  while p.getNode(i).isSome:
    inc i
  i

echo "block 1"
# --- 1. no provider: the straight path goes through where the wall will be --------------------------------------------
let wall = box(4.0, 64.0, -3.0, 5.0, 67.0, 4.0)   # 1 thick in x, 7 wide in z, 3 high, sitting on the floor
var straightLen = 0
block no_provider:
  assert gCollisionProviders.len == 0
  let m = newMob(0.5, 0.5)
  let p = pathTo(m, 9.5, 0.5)
  assert p != nil
  assert p.canReach()
  assert pathHitsBox(p, wall), "without the body the shortest path crosses x=4"
  straightLen = pathLen(p)

echo "block 2"
# --- 2. body registered: the path goes around it and is longer ------------------------------------------------------
fakeBoxes = @[wall]
let provId = registerCollisionProvider(0, fakeQuery)
block detour:
  let m = newMob(0.5, 0.5)
  let p = pathTo(m, 9.5, 0.5)
  assert p != nil
  assert p.canReach(), "a way around exists"
  assert not pathHitsBox(p, wall), "no path node inside the body"
  assert pathLen(p) > straightLen, "the detour is longer than the straight line"
  echo "straight ", straightLen, " detour ", pathLen(p)

echo "block 3"
# --- 3. a low body (1 high) is a step the mob may jump instead of a wall ---------------------------------------------
block step_body:
  fakeBoxes = @[box(4.0, 64.0, -3.0, 5.0, 65.0, 4.0)]
  let m = newMob(0.5, 0.5)
  let p = pathTo(m, 9.5, 0.5)
  assert p != nil
  assert p.canReach()
  assert not pathHitsBox(p, fakeBoxes[0]), "never inside the body, whether it jumps on top or goes around"
  fakeBoxes = @[wall]

echo "block 4"
# --- 4. unregistering restores the straight path --------------------------------------------------------------------
block unregister:
  assert unregisterCollisionProvider(provId)
  let m = newMob(0.5, 0.5)
  let p = pathTo(m, 9.5, 0.5)
  assert pathLen(p) == straightLen

echo "block 5"
# --- 5. shelter: block roof ------------------------------------------------------------------------------------------
fakeBoxes = @[]
block shelter_blocks:
  # Open sky everywhere: no shelter.
  assert not isCoveredFromRain(world0, 0'i32, 64'i32, 0'i32)
  assert not findShelter(world0, cell(0'i32, 64'i32, 0'i32)).found
  # A 3x3 plank roof at y=67 over x 6..8, z 0..2 (no walls): the cell under the middle is standable and covered.
  for x in 6'i32 .. 8'i32:
    for z in 0'i32 .. 2'i32:
      discard level.setBlockState(lvl, cell(x, 67'i32, z), stateOf(blockOakPlanks()))
  assert isCoveredFromRain(world0, 7'i32, 64'i32, 1'i32)
  let r = findShelter(world0, cell(0'i32, 64'i32, 1'i32))
  assert r.found
  assert r.pos.vec.x == 6'i32 and r.pos.vec.z == 1'i32 and r.pos.vec.y == 64'i32, "nearest covered cell is the roof's near edge"
  assert r.dist2 == 36'i32
  # Out of range (radius 4): not found.
  assert not findShelter(world0, cell(0'i32, 64'i32, 1'i32), 4'i32).found
  # Deterministic.
  let r2 = findShelter(world0, cell(0'i32, 64'i32, 1'i32))
  assert r2.pos == r.pos

echo "block 6"
# --- 6. shelter: a body roof is as good as blocks (collision provider) ------------------------------------------------
block shelter_body:
  fakeBoxes = @[box(-8.0, 66.0, -8.0, -5.0, 67.0, -5.0)]   # floating deck over x -8..-6, z -8..-6
  let provId2 = registerCollisionProvider(0, fakeQuery)
  assert isCoveredFromRain(world0, -7'i32, 64'i32, -7'i32)
  assert not isCoveredFromRain(world0, 0'i32, 64'i32, 0'i32)
  let r = findShelter(world0, cell(-12'i32, 64'i32, -7'i32))
  assert r.found and r.pos.vec.x == -8'i32, "the body deck is found as shelter"
  # The same cell as a body-filled cell is not standable.
  fakeBoxes = @[box(-8.0, 64.0, -8.0, -5.0, 67.0, -5.0)]
  assert not isStandable(world0, -7'i32, 64'i32, -7'i32)
  assert unregisterCollisionProvider(provId2)

echo "block 7"
# --- 7. the goal: dry weather does nothing; rain sends the mob under the roof -----------------------------------------
block goal_walks:
  fakeBoxes = @[]
  let mob = newMob(0.5, 1.5)
  let goal = newSeekShelterGoal(1.0)
  assert not goal.canStart(mob), "clear weather: no shelter seeking"
  world0.setRaining(true)
  assert world0.weather.raining
  assert goal.canStart(mob), "rain, exposed, roof 6 blocks away"
  assert goal.shelterTarget().unsafeGet.vec.x == 6'i32
  goal.start(mob)
  assert not mob.mobEntity.navigator.isIdle()
  goal.stop(mob)
  # Already under the roof: no need.
  let dry = newMob(7.5, 1.5)
  let goal2 = newSeekShelterGoal(1.0)
  assert not goal2.canStart(dry)
  world0.setRaining(false)

echo "mobaware ok"
