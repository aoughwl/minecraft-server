## Port of pumpkin/src/entity/ai/pathfinder/binary_heap.rs
##
## Binary heap that uses the node's f score as its value. Index 0 is unused, as upstream's `None` there.

import std/[options, tables]
import node

type
  BinaryHeap* = object
    heap: seq[Option[Node]]
    positionMap: Table[int64, int]
    size: int

proc newBinaryHeap*(): BinaryHeap =
  BinaryHeap(heap: @[none[Node]()], positionMap: initTable[int64, int](), size: 0)

proc withCapacity*(capacity: int): BinaryHeap =
  newBinaryHeap()

proc isEmpty*(self: BinaryHeap): bool {.inline.} = self.size == 0
proc len*(self: BinaryHeap): int {.inline.} = self.size

proc clear*(self: var BinaryHeap) =
  self.heap = @[none[Node]()]
  self.positionMap = initTable[int64, int]()
  self.size = 0

proc swapNodes(self: var BinaryHeap; i, j: int) =
  ## `swap_nodes`
  var a = self.heap[i]
  var b = self.heap[j]
  if a.isSome:
    var n = a.unsafeGet
    n.heapIdx = int32(j)
    self.positionMap[keyOf(n.asVector3())] = j
    a = some(n)
  if b.isSome:
    var n = b.unsafeGet
    n.heapIdx = int32(i)
    self.positionMap[keyOf(n.asVector3())] = i
    b = some(n)
  self.heap[i] = b
  self.heap[j] = a

proc bubbleUp(self: var BinaryHeap; index0: int) =
  var index = index0
  while index > 1:
    let parentIndex = index div 2
    let node = self.heap[index]
    let parent = self.heap[parentIndex]
    let shouldSwap = node.isSome and parent.isSome and node.unsafeGet.f < parent.unsafeGet.f
    if not shouldSwap:
      break
    self.swapNodes(index, parentIndex)
    index = parentIndex

proc bubbleDown(self: var BinaryHeap; index0: int) =
  var index = index0
  while true:
    let leftChild = index * 2
    let rightChild = index * 2 + 1
    var smallest = index
    if leftChild <= self.size:
      let node = self.heap[smallest]
      let left = self.heap[leftChild]
      if node.isSome and left.isSome and left.unsafeGet.f < node.unsafeGet.f:
        smallest = leftChild
    if rightChild <= self.size:
      let node = self.heap[smallest]
      let right = self.heap[rightChild]
      if node.isSome and right.isSome and right.unsafeGet.f < node.unsafeGet.f:
        smallest = rightChild
    if smallest == index:
      break
    self.swapNodes(index, smallest)
    index = smallest

proc insert*(self: var BinaryHeap; node0: Node) =
  self.size += 1
  if self.heap.len <= self.size:
    let oldLen = self.heap.len
    self.heap.setLen(self.size * 2)
    for i in oldLen ..< self.heap.len:
      self.heap[i] = none[Node]()
  var node = node0
  node.heapIdx = int32(self.size)
  self.positionMap[keyOf(node.asVector3())] = self.size
  self.heap[self.size] = some(node)
  self.bubbleUp(self.size)

proc pop*(self: var BinaryHeap): Option[Node] =
  if self.isEmpty():
    return none[Node]()
  let top = self.heap[1]
  if top.isNone:
    return none[Node]()
  self.heap[1] = none[Node]()
  let minNode = top.unsafeGet
  self.positionMap.del(keyOf(minNode.asVector3()))
  if self.size == 1:
    self.size = 0
    return some(minNode)
  let lastOpt = self.heap[self.size]
  self.heap[self.size] = none[Node]()
  if lastOpt.isSome:
    var lastNode = lastOpt.unsafeGet
    lastNode.heapIdx = 1'i32
    self.positionMap[keyOf(lastNode.asVector3())] = 1
    self.heap[1] = some(lastNode)
  self.size -= 1
  self.bubbleDown(1)
  some(minNode)

proc peek*(self: BinaryHeap): Option[Node] =
  if self.isEmpty(): none[Node]() else: self.heap[1]

proc changeCost*(self: var BinaryHeap; coords: Vector3[int32]; newFScore: float32) =
  ## `change_cost`
  if self.positionMap.hasKey(keyOf(coords)):
    let index = self.positionMap.getOrDefault(keyOf(coords))
    if self.heap[index].isSome:
      var node = self.heap[index].unsafeGet
      let oldF = node.f
      node.f = newFScore
      self.heap[index] = some(node)
      if newFScore < oldF:
        self.bubbleUp(index)
      elif newFScore > oldF:
        self.bubbleDown(index)

proc contains*(self: BinaryHeap; coords: Vector3[int32]): bool =
  self.positionMap.hasKey(keyOf(coords))

proc getNode*(self: BinaryHeap; coords: Vector3[int32]): Option[Node] =
  ## `get_node`
  if self.positionMap.hasKey(keyOf(coords)):
    self.heap[self.positionMap.getOrDefault(keyOf(coords))]
  else:
    none[Node]()

proc updateNode*(self: var BinaryHeap; coords: Vector3[int32]; updated: Node) =
  ## `update_node`: when we find a better path to an already-open node.
  if self.positionMap.hasKey(keyOf(coords)):
    let index = self.positionMap.getOrDefault(keyOf(coords))
    if self.heap[index].isSome:
      let old = self.heap[index].unsafeGet
      var node = updated
      node.heapIdx = old.heapIdx
      self.heap[index] = some(node)
      if node.f < old.f:
        self.bubbleUp(index)
      elif node.f > old.f:
        self.bubbleDown(index)

proc getHeap*(self: BinaryHeap): seq[Node] =
  ## `get_heap`
  result = @[]
  for i in 1 .. self.size:
    if self.heap[i].isSome:
      result.add(self.heap[i].unsafeGet)

proc drain*(self: var BinaryHeap): seq[Node] =
  ## `drain`
  result = self.getHeap()
  self.clear()
