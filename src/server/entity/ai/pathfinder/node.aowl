## Port of pumpkin/src/entity/ai/pathfinder/node.rs
##
## `Coordinate` is implemented upstream by `Node`, `Target`, `BlockPos` and `Vector3<i32>`, and every method reads the
## other side's `as_vector3`. Here the methods take a `Vector3[int32]`, and each receiver is reduced to one with `asVector3`.

import std/[options, math, hashes]
import ../../../../util/math/position
import ../../../../util/vector3

export position, vector3, options

type
  PathType* = enum
    ptBlocked = 0, ptOpen = 1, ptWalkable = 2, ptWalkableDoor = 3, ptTrapdoor = 4, ptPowderSnow = 5, ptDangerPowderSnow = 6,
    ptFence = 7, ptLava = 8, ptWater = 9, ptWaterBorder = 10, ptRail = 11, ptUnpassableRail = 12, ptDangerFire = 13,
    ptDamageFire = 14, ptDangerOther = 15, ptDamageOther = 16, ptDoorOpen = 17, ptDoorWoodClosed = 18,
    ptDoorIronClosed = 19, ptBreach = 20, ptLeaves = 21, ptStickyHoney = 22, ptCocoa = 23, ptDamageCautious = 24,
    ptDangerTrapdoor = 25

  Node* = object
    pos*: BlockPos
    heapIdx*: int32
    g*: float32          ## Cost from start to this node
    h*: float32          ## Heuristic cost from this node to target
    f*: float32          ## g + h
    cameFrom*: Option[Vector3[int32]]  ## Position of the predecessor node for path reconstruction.
    closed*: bool
    walkedDist*: float32
    costMalus*: float32
    pathType*: PathType

  Target* = object
    node*: Node
    bestHeuristic*: float32
    bestNode*: Option[Node]
    reached*: bool

const
  PathTypeCount* = 26
  F32Max* = 3.4028234663852886e38'f32  ## `f32::MAX`

proc newNode*(pos: BlockPos): Node =
  ## `Node::new`
  Node(pos: pos, heapIdx: -1'i32, g: 0.0'f32, h: 0.0'f32, f: 0.0'f32, cameFrom: none[Vector3[int32]](), closed: false,
    walkedDist: 0.0'f32, costMalus: 0.0'f32, pathType: ptBlocked)

proc cloneAndMove*(self: Node; pos: BlockPos): Node =
  result = self
  result.pos = pos

proc asVector3*(self: Node): Vector3[int32] {.inline.} = self.pos.vec
proc asVector3*(self: Target): Vector3[int32] {.inline.} = self.node.pos.vec
proc asVector3*(self: BlockPos): Vector3[int32] {.inline.} = self.vec
proc asVector3*(self: Vector3[int32]): Vector3[int32] {.inline.} = self

proc keyOf*(v: Vector3[int32]): int64 {.inline.} =
  ## A table key for a block position: `BlockPos::as_long`'s packing, which is one to one within a world.
  ((int64(v.x) and 0x3FFFFFF'i64) shl 38) or ((int64(v.z) and 0x3FFFFFF'i64) shl 12) or (int64(v.y) and 0xFFF'i64)

proc asBlockPos*(self: Vector3[int32]): BlockPos {.inline.} = BlockPos(vec: self)

proc squared(a, b: Vector3[int32]): int32 {.inline.} =
  ## `squared_distance_to_vec`, in i32 as upstream's.
  let dx = a.x - b.x
  let dy = a.y - b.y
  let dz = a.z - b.z
  dx * dx + dy * dy + dz * dz

proc squaredXz(a, b: Vector3[int32]): int32 {.inline.} =
  let dx = a.x - b.x
  let dz = a.z - b.z
  dx * dx + dz * dz

proc distance*(a, b: Vector3[int32]): float32 = sqrt(float32(squared(a, b)))
proc distanceXz*(a, b: Vector3[int32]): float32 = sqrt(float32(squaredXz(a, b)))
proc distanceSqr*(a, b: Vector3[int32]): float32 = float32(squared(a, b))
proc distanceManhattan*(a, b: Vector3[int32]): float32 =
  float32(abs(a.x - b.x) + abs(a.y - b.y) + abs(a.z - b.z))

proc distance*(a: Node; b: Node): float32 = distance(a.pos.vec, b.pos.vec)
proc distance*(a: Node; b: Target): float32 = distance(a.pos.vec, b.node.pos.vec)
proc distanceManhattan*(a: Node; b: Node): float32 = distanceManhattan(a.pos.vec, b.pos.vec)
proc distanceManhattan*(a: Node; b: Target): float32 = distanceManhattan(a.pos.vec, b.node.pos.vec)
proc distanceManhattan*(a: Node; b: Vector3[int32]): float32 = distanceManhattan(a.pos.vec, b)

proc `==`*(a, b: Node): bool =
  ## `#[derive(PartialEq)]`
  a.pos.vec == b.pos.vec and a.heapIdx == b.heapIdx and a.g == b.g and a.h == b.h and a.f == b.f and
    a.closed == b.closed and a.walkedDist == b.walkedDist and a.costMalus == b.costMalus and a.pathType == b.pathType and
    a.cameFrom.isSome == b.cameFrom.isSome and (a.cameFrom.isNone or a.cameFrom.unsafeGet == b.cameFrom.unsafeGet)

proc newTarget*(node: Node): Target =
  ## `Target::new`
  Target(node: node, bestHeuristic: F32Max, bestNode: none[Node](), reached: false)

proc updateBest*(self: var Target; heuristic: float32; node: Node) =
  ## `update_best`
  if heuristic < self.bestHeuristic:
    self.bestHeuristic = heuristic
    self.bestNode = some(node)

proc getMalus*(self: PathType): float32 =
  ## `get_malus`
  case self
  of ptBlocked, ptPowderSnow, ptFence, ptLava, ptUnpassableRail, ptDamageOther, ptDoorWoodClosed, ptDoorIronClosed, ptLeaves:
    -1.0'f32
  of ptOpen, ptWalkable, ptWalkableDoor, ptTrapdoor, ptDangerPowderSnow, ptRail, ptDoorOpen, ptCocoa, ptDamageCautious,
      ptDangerTrapdoor:
    0.0'f32
  of ptBreach:
    4.0'f32
  of ptWater, ptWaterBorder, ptDangerFire, ptDangerOther, ptStickyHoney:
    8.0'f32
  of ptDamageFire:
    16.0'f32

proc isPassable*(self: PathType): bool = self.getMalus() >= 0.0'f32
proc isBlocked*(self: PathType): bool = self.getMalus() < 0.0'f32
proc isWater*(self: PathType): bool = self == ptWater or self == ptWaterBorder

proc isDangerous*(self: PathType): bool =
  self == ptLava or self == ptDangerFire or self == ptDamageFire or self == ptDangerOther or self == ptDamageOther or
    self == ptDangerPowderSnow or self == ptDangerTrapdoor

proc isDoor*(self: PathType): bool =
  self == ptWalkableDoor or self == ptDoorOpen or self == ptDoorWoodClosed or self == ptDoorIronClosed

proc hasPartialCollision*(self: PathType): bool =
  self == ptFence or self == ptWalkableDoor or self == ptDoorOpen or self == ptDoorWoodClosed or self == ptDoorIronClosed
