## Port of pumpkin/src/entity/ai/pathfinder/node_evaluator.rs
##
## Upstream has one implementor of `NodeEvaluator`, `WalkNodeEvaluator`; the trait's methods are its procs.

import std/[math, options, tables]
import ../../../../util/math/rustnum
import node, pathfinding_context

type
  MobData* = object
    position*: Vector3[float64]
    width*: float32
    height*: float32
    maxStepHeight*: float32
    maxFallDistance*: float32
    canSwim*: bool
    canWalkOnWater*: bool
    avoidsFire*: bool
    avoidsWater*: bool
    onGround*: bool
    pathTypeMalus*: seq[Option[float32]]  ## `[Option<f32>; PATH_TYPE_COUNT]`, by `ord(PathType)`.

  BaseNodeEvaluator* = object
    context*: nil PathfindingContext
    hasMobData*: bool
    mobData*: MobData     ## Meaningful when `hasMobData`.
    nodes*: Table[int64, Node]
    entityWidth*: int32
    entityHeight*: int32
    entityDepth*: int32
    canPassDoors*: bool
    canOpenDoors*: bool
    canFloat*: bool
    canWalkOverFences*: bool

proc noMalus(): seq[Option[float32]] =
  result = newSeq[Option[float32]](PathTypeCount)
  for i in 0 ..< PathTypeCount:
    result[i] = none[float32]()

proc setPathfindingMalus*(self: var MobData; pathType: PathType; malus: float32) =
  self.pathTypeMalus[ord(pathType)] = some(malus)

proc getPathfindingMalus*(self: MobData; pathType: PathType): float32 =
  let m = self.pathTypeMalus[ord(pathType)]
  if m.isSome: m.unsafeGet else: pathType.getMalus()

proc newMobData*(position: Vector3[float64]; width, height, maxStepHeight: float32): MobData =
  ## `MobData::new`
  MobData(position: position, width: width, height: height, maxStepHeight: maxStepHeight, maxFallDistance: 3.0'f32,
    canSwim: false, canWalkOnWater: false, avoidsFire: true, avoidsWater: false, onGround: true, pathTypeMalus: noMalus())

proc newZombieMobData*(position: Vector3[float64]; onGround: bool): MobData =
  ## `MobData::new_zombie`
  result = newMobData(position, 0.6'f32, 1.95'f32, 1.0'f32)
  result.onGround = onGround
  result.setPathfindingMalus(ptDangerFire, 16.0'f32)
  result.setPathfindingMalus(ptDamageFire, -1.0'f32)
  result.setPathfindingMalus(ptWater, 8.0'f32)
  result.setPathfindingMalus(ptLava, -1.0'f32)
  result.setPathfindingMalus(ptDangerOther, 8.0'f32)

proc blockPosition*(self: MobData): (int32, int32, int32) =
  (asI32(floor(self.position.x)), asI32(floor(self.position.y)), asI32(floor(self.position.z)))

proc getBbWidth*(self: MobData): int32 = asI32(floor(self.width + 1.0'f32))
proc getBbHeight*(self: MobData): int32 = asI32(floor(self.height + 1.0'f32))

proc newBaseNodeEvaluator*(): BaseNodeEvaluator =
  BaseNodeEvaluator(context: nil, hasMobData: false, nodes: initTable[int64, Node](), entityWidth: 1'i32,
    entityHeight: 2'i32, entityDepth: 1'i32, canPassDoors: true, canOpenDoors: false, canFloat: false,
    canWalkOverFences: false)

proc getNode*(self: var BaseNodeEvaluator; pos: BlockPos): Node =
  ## `get_node`: a copy of the stored node, as upstream's `Node` is `Copy`.
  if self.nodes.hasKey(keyOf(pos.vec)):
    return self.nodes.getOrDefault(keyOf(pos.vec))
  result = newNode(pos)
  self.nodes[keyOf(pos.vec)] = result

proc reset*(self: var BaseNodeEvaluator) =
  self.nodes = initTable[int64, Node]()
  self.context = nil
  self.hasMobData = false

proc isPositionInBounds*(self: BaseNodeEvaluator; x, y, z: int32): bool =
  ## `is_position_in_bounds`
  if not self.hasMobData:
    return true
  let mobPos = self.mobData.blockPosition()
  let dx = abs(x - mobPos[0])
  let dy = abs(y - mobPos[1])
  let dz = abs(z - mobPos[2])
  dx <= self.entityWidth div 2'i32 and dy <= self.entityHeight and dz <= self.entityDepth div 2'i32
