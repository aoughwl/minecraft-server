## Port of pumpkin/src/entity/ai/pathfinder/path.rs

import std/[options, math]
import node

type
  Path* = ref object
    nodes: seq[Node]
    nextNodeIndex*: int
    target: Vector3[int32]
    distToTarget: float32
    reached: bool

proc newPath*(nodes: seq[Node]; target: Vector3[int32]; reached: bool): Path =
  ## `Path::new`
  let distToTarget = if nodes.len == 0: F32Max else: nodes[nodes.len - 1].distanceManhattan(target)
  Path(nodes: nodes, nextNodeIndex: 0, target: target, distToTarget: distToTarget, reached: reached)

proc emptyPath*(target: Vector3[int32]): Path =
  newPath(@[], target, false)

proc advance*(self: Path) =
  self.nextNodeIndex = min(self.nextNodeIndex + 1, self.nodes.len)

proc notStarted*(self: Path): bool = self.nextNodeIndex == 0
proc isDone*(self: Path): bool = self.nextNodeIndex >= self.nodes.len

proc getEndNode*(self: Path): Option[Node] =
  if self.nodes.len == 0: none[Node]() else: some(self.nodes[self.nodes.len - 1])

proc getNode*(self: Path; index: int): Option[Node] =
  if index >= 0 and index < self.nodes.len: some(self.nodes[index]) else: none[Node]()

proc truncateNodes*(self: Path; index: int) =
  if index < self.nodes.len:
    self.nodes.setLen(index)
    if self.nextNodeIndex > self.nodes.len:
      self.nextNodeIndex = self.nodes.len

proc replaceNode*(self: Path; index: int; newNode: Node) =
  if index < self.nodes.len:
    self.nodes[index] = newNode

proc getNodeCount*(self: Path): int = self.nodes.len
proc getNextNodeIndex*(self: Path): int = self.nextNodeIndex

proc setNextNodeIndex*(self: Path; index: int) =
  self.nextNodeIndex = min(index, self.nodes.len)

proc getEntityPosAtNode*(self: Path; index: int; entityWidth: float32): Option[(float32, float32, float32)] =
  ## `get_entity_pos_at_node`: `as i32 as f32` truncates.
  if index < 0 or index >= self.nodes.len:
    return none[(float32, float32, float32)]()
  let node = self.nodes[index]
  let offset = float32(int32(entityWidth + 1.0'f32)) * 0.5'f32
  some((float32(node.pos.vec.x) + offset, float32(node.pos.vec.y), float32(node.pos.vec.z) + offset))

proc getNodePos*(self: Path; index: int): Option[Vector3[int32]] =
  if index >= 0 and index < self.nodes.len: some(self.nodes[index].asVector3()) else: none[Vector3[int32]]()

proc getNextEntityPos*(self: Path; entityWidth: float32): Option[(float32, float32, float32)] =
  self.getEntityPosAtNode(self.nextNodeIndex, entityWidth)

proc getNextNodePos*(self: Path): Option[Vector3[int32]] =
  self.getNodePos(self.nextNodeIndex)

proc getNextNode*(self: Path): Option[Node] =
  self.getNode(self.nextNodeIndex)

proc getPreviousNode*(self: Path): Option[Node] =
  if self.nextNodeIndex > 0: self.getNode(self.nextNodeIndex - 1) else: none[Node]()

proc sameAs*(self, other: Path): bool =
  if self.nodes.len != other.nodes.len:
    return false
  for i in 0 ..< self.nodes.len:
    if not (self.nodes[i] == other.nodes[i]):
      return false
  true

proc canReach*(self: Path): bool = self.reached
proc getTarget*(self: Path): Vector3[int32] = self.target
proc getDistToTarget*(self: Path): float32 = self.distToTarget

proc copy*(self: Path): Path =
  Path(nodes: self.nodes, nextNodeIndex: self.nextNodeIndex, target: self.target, distToTarget: self.distToTarget,
    reached: self.reached)

proc getNodes*(self: Path): seq[Node] = self.nodes

proc getRemainingNodes*(self: Path): seq[Node] =
  result = @[]
  for i in self.nextNodeIndex ..< self.nodes.len:
    result.add(self.nodes[i])

proc calculateLength*(self: Path): float32 =
  ## `calculate_length`
  if self.nodes.len < 2:
    return 0.0'f32
  var totalLength = 0.0'f32
  for i in 1 ..< self.nodes.len:
    totalLength += self.nodes[i - 1].distance(self.nodes[i])
  totalLength

proc getRemainingDistance*(self: Path): float32 =
  ## `get_remaining_distance`
  if self.nextNodeIndex >= self.nodes.len:
    return 0.0'f32
  var remaining = 0.0'f32
  for i in (self.nextNodeIndex + 1) ..< self.nodes.len:
    remaining += self.nodes[i - 1].distance(self.nodes[i])
  remaining

proc isValid*(self: Path): bool = self.nodes.len > 0

proc equals*(self, other: Path): bool =
  ## `impl PartialEq for Path`. Not `==`: `path == nil` has to stay the reference comparison.
  self.nextNodeIndex == other.nextNodeIndex and self.reached == other.reached and self.target == other.target and
    self.sameAs(other)
