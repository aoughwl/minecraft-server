## Port of pumpkin/src/entity/ai/pathfinder/path_type_cache.rs

import std/[options, tables]
import node

const
  CacheSize = 4096
  CacheMask = CacheSize - 1

type
  PathTypeCache* = object
    positions: seq[int64]
    pathTypes: seq[Option[PathType]]
    overflowCache: Table[int64, PathType]

proc newPathTypeCache*(): PathTypeCache =
  result = PathTypeCache(positions: newSeq[int64](CacheSize), pathTypes: newSeq[Option[PathType]](CacheSize),
    overflowCache: initTable[int64, PathType]())
  for i in 0 ..< CacheSize:
    result.pathTypes[i] = none[PathType]()

proc positionToKey*(pos: Vector3[int32]): int64 =
  ## `position_to_key`
  ((int64(pos.x) and 0x03FF_FFFF'i64) shl 38) or ((int64(pos.z) and 0x03FF_FFFF'i64) shl 12) or (int64(pos.y) and 0xFFF'i64)

proc hashLong*(x0: int64): int64 =
  ## `hash_long`: `>>` on i64 is arithmetic, and the multiply wraps.
  var x = x0
  x = x xor ashr(x, 32)
  x = cast[int64](cast[uint64](x) * 0xd6e8_feb8_6659_fd93'u64)
  x = x xor ashr(x, 32)
  x = cast[int64](cast[uint64](x) * 0xd6e8_feb8_6659_fd93'u64)
  x = x xor ashr(x, 32)
  x

proc keyToIndex*(key: int64): int =
  ## `key_to_index`
  int(cast[uint64](hashLong(key)) and uint64(CacheMask))

proc getFromArray(self: PathTypeCache; index: int; key: int64): Option[PathType] =
  if self.positions[index] == key: self.pathTypes[index] else: none[PathType]()

proc get*(self: PathTypeCache; pos: Vector3[int32]): Option[PathType] =
  let key = positionToKey(pos)
  let index = keyToIndex(key)
  let cached = self.getFromArray(index, key)
  if cached.isSome:
    return cached
  if self.overflowCache.hasKey(keyOf(pos)):
    return some(self.overflowCache.getOrDefault(keyOf(pos)))
  none[PathType]()

proc insertInternal(self: var PathTypeCache; pos: Vector3[int32]; key: int64; index: int; pathType: PathType) =
  if self.pathTypes[index].isNone or self.positions[index] != key:
    self.positions[index] = key
    self.pathTypes[index] = some(pathType)
  else:
    self.overflowCache[keyOf(pos)] = pathType

proc insert*(self: var PathTypeCache; pos: Vector3[int32]; pathType: PathType) =
  let key = positionToKey(pos)
  self.insertInternal(pos, key, keyToIndex(key), pathType)

proc invalidate*(self: var PathTypeCache; pos: Vector3[int32]) =
  let key = positionToKey(pos)
  let index = keyToIndex(key)
  if self.positions[index] == key:
    self.pathTypes[index] = none[PathType]()
  self.overflowCache.del(keyOf(pos))

proc clear*(self: var PathTypeCache) =
  for i in 0 ..< CacheSize:
    self.pathTypes[i] = none[PathType]()
  self.overflowCache = initTable[int64, PathType]()
