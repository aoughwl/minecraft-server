## node.aowl, binary_heap.aowl, path.aowl and path_type_cache.aowl: known answers worked from the Rust.

import std/[assertions, options, syncio]
import node, binary_heap, path, path_type_cache

proc at(x, y, z: int32; f: float32): Node =
  result = newNode(BlockPos(vec: Vector3[int32](x: x, y: y, z: z)))
  result.f = f

block node_defaults:
  let n = newNode(BlockPos(vec: Vector3[int32](x: 1'i32, y: 2'i32, z: 3'i32)))
  assert n.heapIdx == -1'i32 and n.pathType == ptBlocked and n.cameFrom.isNone and not n.closed

block distances:
  let a = at(0'i32, 0'i32, 0'i32, 0.0'f32)
  let b = at(3'i32, 4'i32, 0'i32, 0.0'f32)
  assert a.distance(b) == 5.0'f32
  assert a.distanceManhattan(b) == 7.0'f32
  assert distanceSqr(a.pos.vec, b.pos.vec) == 25.0'f32
  assert distanceXz(a.pos.vec, b.pos.vec) == 3.0'f32

block malus_table:
  assert ptBlocked.getMalus() == -1.0'f32 and ptOpen.getMalus() == 0.0'f32 and ptBreach.getMalus() == 4.0'f32
  assert ptWater.getMalus() == 8.0'f32 and ptDamageFire.getMalus() == 16.0'f32 and ptLeaves.getMalus() == -1.0'f32
  assert ptWalkable.isPassable() and ptFence.isBlocked() and ptWaterBorder.isWater() and ptLava.isDangerous()
  assert ptDoorOpen.isDoor() and ptFence.hasPartialCollision() and not ptOpen.hasPartialCollision()
  assert PathTypeCount == ord(high(PathType)) + 1

block target_keeps_best:
  var t = newTarget(at(0'i32, 0'i32, 0'i32, 0.0'f32))
  assert t.bestHeuristic == F32Max
  t.updateBest(5.0'f32, at(1'i32, 0'i32, 0'i32, 0.0'f32))
  t.updateBest(7.0'f32, at(2'i32, 0'i32, 0'i32, 0.0'f32))
  assert t.bestNode.unsafeGet.pos.vec.x == 1'i32

block heap_orders_by_f:
  var h = newBinaryHeap()
  assert h.isEmpty() and h.pop().isNone
  h.insert(at(1'i32, 0'i32, 0'i32, 5.0'f32))
  h.insert(at(2'i32, 0'i32, 0'i32, 3.0'f32))
  h.insert(at(3'i32, 0'i32, 0'i32, 8.0'f32))
  h.insert(at(4'i32, 0'i32, 0'i32, 1.0'f32))
  assert h.len == 4 and h.peek().unsafeGet.pos.vec.x == 4'i32
  assert h.contains(Vector3[int32](x: 3'i32, y: 0'i32, z: 0'i32))
  assert h.getNode(Vector3[int32](x: 3'i32, y: 0'i32, z: 0'i32)).unsafeGet.f == 8.0'f32
  # Lower a cost: bubbles up.
  h.changeCost(Vector3[int32](x: 3'i32, y: 0'i32, z: 0'i32), 0.5'f32)
  assert h.peek().unsafeGet.pos.vec.x == 3'i32
  # Update a node: reorders and keeps its heap index.
  h.updateNode(Vector3[int32](x: 3'i32, y: 0'i32, z: 0'i32), at(3'i32, 0'i32, 0'i32, 9.0'f32))
  let order = [4'i32, 2'i32, 1'i32, 3'i32]
  for x in order:
    let n = h.pop()
    assert n.unsafeGet.pos.vec.x == x
  assert h.isEmpty()
  assert not h.contains(Vector3[int32](x: 3'i32, y: 0'i32, z: 0'i32))

block heap_grows_and_drains:
  var h = newBinaryHeap()
  for i in 0'i32 ..< 2000'i32:
    h.insert(at(i, 0'i32, 0'i32, float32(2000'i32 - i)))
  assert h.peek().unsafeGet.pos.vec.x == 1999'i32
  assert h.getHeap().len == 2000
  let all = h.drain()
  assert all.len == 2000 and h.isEmpty()

block path_walk:
  let target = Vector3[int32](x: 2'i32, y: 0'i32, z: 0'i32)
  let p = newPath(@[at(0'i32, 0'i32, 0'i32, 0.0'f32), at(1'i32, 0'i32, 0'i32, 0.0'f32), at(2'i32, 0'i32, 0'i32, 0.0'f32)], target, true)
  assert p.isValid() and p.notStarted() and not p.isDone() and p.canReach()
  assert p.getDistToTarget() == 0.0'f32
  assert p.calculateLength() == 2.0'f32 and p.getRemainingDistance() == 2.0'f32
  p.advance()
  assert p.getRemainingDistance() == 1.0'f32
  assert p.getNextNodePos().unsafeGet.x == 1'i32
  assert p.getPreviousNode().unsafeGet.pos.vec.x == 0'i32
  # (0.6 + 1.0) as i32 = 1, so the offset is 0.5.
  assert p.getNextEntityPos(0.6'f32).unsafeGet[0] == 1.5'f32
  # (1.4 + 1.0) as i32 = 2, so the offset is 1.0.
  assert p.getNextEntityPos(1.4'f32).unsafeGet[0] == 2.0'f32
  let c = p.copy()
  assert c.equals(p) and c.sameAs(p)
  p.advance()
  p.advance()
  p.advance()
  assert p.isDone() and p.getNextNodeIndex() == 3 and p.getRemainingDistance() == 0.0'f32 and p.getNextNode().isNone
  assert not c.equals(p)
  p.truncateNodes(1)
  assert p.getNodeCount() == 1 and p.getNextNodeIndex() == 1

block empty_path:
  let p = emptyPath(Vector3[int32](x: 0'i32, y: 0'i32, z: 0'i32))
  assert not p.isValid() and p.isDone() and p.getDistToTarget() == F32Max and p.calculateLength() == 0.0'f32
  assert p.getEndNode().isNone

block key_packing:
  # ((x & 0x3FFFFFF) << 38) | ((z & 0x3FFFFFF) << 12) | (y & 0xFFF)
  assert positionToKey(Vector3[int32](x: 1'i32, y: 2'i32, z: 3'i32)) == ((1'i64 shl 38) or (3'i64 shl 12) or 2'i64)
  assert positionToKey(Vector3[int32](x: 0'i32, y: -1'i32, z: 0'i32)) == 0xFFF'i64

block hash_known_answers:
  # Worked by hand from `hash_long`, with x = 0 fixed and x = 1 computed in wrapping i64 arithmetic.
  assert hashLong(0'i64) == 0'i64
  assert keyToIndex(0'i64) == 0

block cache_round_trip:
  var c = newPathTypeCache()
  let a = Vector3[int32](x: 5'i32, y: 64'i32, z: -7'i32)
  assert c.get(a).isNone
  c.insert(a, ptWater)
  assert c.get(a).unsafeGet == ptWater
  # Same slot, same key: the second write goes to the overflow map, and the array still answers first.
  c.insert(a, ptLava)
  assert c.get(a).unsafeGet == ptWater
  c.invalidate(a)
  assert c.get(a).isNone
  c.insert(a, ptFence)
  c.clear()
  assert c.get(a).isNone

echo "pathfinder ok"
