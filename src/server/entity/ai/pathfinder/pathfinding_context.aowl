## Port of pumpkin/src/entity/ai/pathfinder/pathfinding_context.rs

import std/[options, tables]
import ../../../../data/block_ext
from ../../../../data/block_state import newBlockStateIdUnchecked, isFullCube, BlockState
import ../../../../generated/fluid
import ../../../../generated/tag
import ../../../serverbase
import ../../../world/worldmod
import node, path_type_cache

type
  PathfindingContext* = ref object
    pathTypeCache: PathTypeCache
    mobPosition: Vector3[int32]
    world: World
    collisionCache: Table[int64, bool]

proc newPathfindingContext*(mobPosition: Vector3[int32]; world: World): PathfindingContext =
  PathfindingContext(pathTypeCache: newPathTypeCache(), mobPosition: mobPosition, world: world,
    collisionCache: initTable[int64, bool]())

proc withCache*(mobPosition: Vector3[int32]; world: World; cache: PathTypeCache): PathfindingContext =
  PathfindingContext(pathTypeCache: cache, mobPosition: mobPosition, world: world,
    collisionCache: initTable[int64, bool]())

proc mobPosition*(self: PathfindingContext): Vector3[int32] = self.mobPosition

proc computePathTypeFromState*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `compute_path_type_from_state`: classifies a block position into a `PathType` for pathfinding.
  # Single chunk lookup, then derive block & state from static arrays
  let stateId = newBlockStateIdUnchecked(uint16(self.world.getBlockStateId(pos.asBlockPos())))
  let blockRef = Block.fromStateId(stateId)
  let state = BlockState.fromId(stateId)
  let id = blockRef.id
  let rawId = asU16(id)
  if id == blockIdAir or id == blockIdVoidAir or id == blockIdCaveAir:
    return ptOpen
  if hasTag(rawId, Block_MINECRAFT_TRAPDOORS) or id == blockIdLilyPad or id == blockIdBigDripleaf:
    return ptTrapdoor
  if id == blockIdPowderSnow:
    return ptPowderSnow
  if id == blockIdCactus or id == blockIdSweetBerryBush:
    return ptDamageOther
  if id == blockIdHoneyBlock:
    return ptStickyHoney
  if id == blockIdCocoa:
    return ptCocoa
  if id == blockIdWitherRose or id == blockIdPointedDripstone:
    return ptDamageCautious
  let fluid = Fluid.fromStateId(stateId)
  if fluid.isSome and hasTag(fluid.unsafeGet.id, Fluid_MINECRAFT_LAVA):
    return ptLava
  if id == blockIdFire or id == blockIdSoulFire or id == blockIdMagmaBlock or id == blockIdCampfire or
      id == blockIdSoulCampfire or id == blockIdLavaCauldron:
    return ptDamageFire
  if hasTag(rawId, Block_MINECRAFT_DOORS):
    if state.collisionShapes.len == 0:
      return ptDoorOpen
    return if id == blockIdIronDoor: ptDoorIronClosed else: ptDoorWoodClosed
  if hasTag(rawId, Block_MINECRAFT_RAILS):
    return ptRail
  if hasTag(rawId, Block_MINECRAFT_LEAVES):
    return ptLeaves
  if hasTag(rawId, Block_MINECRAFT_FENCES) or hasTag(rawId, Block_MINECRAFT_WALLS):
    return ptFence
  if hasTag(rawId, Block_MINECRAFT_FENCE_GATES) and state.collisionShapes.len > 0:
    return ptFence
  if state.isFullCube:
    return ptBlocked
  if fluid.isSome and hasTag(fluid.unsafeGet.id, Fluid_MINECRAFT_WATER):
    return ptWater
  ptOpen

proc getPathTypeFromState*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `get_path_type_from_state`
  let cached = self.pathTypeCache.get(pos)
  if cached.isSome:
    return cached.unsafeGet
  result = self.computePathTypeFromState(pos)
  self.pathTypeCache.insert(pos, result)

proc getNodeTypeFromNeighbors*(self: PathfindingContext; pos: Vector3[int32]; fallback: PathType): PathType =
  ## `get_node_type_from_neighbors`: scans a 3x3x3 neighborhood for danger blocks.
  for dy in -1'i32 .. 1'i32:
    for dx in -1'i32 .. 1'i32:
      for dz in -1'i32 .. 1'i32:
        if dx == 0'i32 and dz == 0'i32:
          continue
        let neighborType = self.getPathTypeFromState(Vector3[int32](x: pos.x + dx, y: pos.y + dy, z: pos.z + dz))
        if neighborType == ptDamageOther:
          return ptDangerOther
        if neighborType == ptDamageFire or neighborType == ptLava:
          return ptDangerFire
        if neighborType == ptWater:
          return ptWaterBorder
        if neighborType == ptDamageCautious:
          return ptDamageCautious
  fallback

proc getLandNodeType*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `get_land_node_type`: the raw block type with below-check and neighbor danger scanning for OPEN nodes.
  let rawType = self.getPathTypeFromState(pos)
  if rawType == ptOpen:
    let belowType = self.getPathTypeFromState(Vector3[int32](x: pos.x, y: pos.y - 1'i32, z: pos.z))
    return case belowType
      of ptOpen, ptWater, ptLava, ptWalkable: ptOpen
      of ptDamageFire: ptDamageFire
      of ptDamageOther: ptDamageOther
      of ptStickyHoney: ptStickyHoney
      of ptPowderSnow: ptDangerPowderSnow
      of ptDamageCautious: ptDamageCautious
      of ptTrapdoor: ptDangerTrapdoor
      else: self.getNodeTypeFromNeighbors(pos, ptWalkable)
  rawType

proc hasCollisions*(self: PathfindingContext; pos: Vector3[int32]): bool =
  ## `has_collisions`
  if self.collisionCache.hasKey(keyOf(pos)):
    return self.collisionCache.getOrDefault(keyOf(pos))
  let stateId = newBlockStateIdUnchecked(uint16(self.world.getBlockStateId(pos.asBlockPos())))
  result = BlockState.fromId(stateId).isFullCube
  self.collisionCache[keyOf(pos)] = result

proc clearCaches*(self: PathfindingContext) =
  self.pathTypeCache.clear()
  self.collisionCache = initTable[int64, bool]()
