## Port of pumpkin/src/entity/ai/pathfinder/pathfinding_context.rs

import std/[options, tables]
import ../../../../data/block_ext
from ../../../../data/block_state import newBlockStateIdUnchecked, isFullCube, BlockState
import ../../../../generated/fluid
import ../../../../generated/tag
import ../../../serverbase
import ../../collision_providers
import ../../../../util/math/boundingbox
import ../../../world/worldmod
import ../../../../world/[chunkdata, level, palette]
import node, path_type_cache

type
  BlockSnapshot* = ref object
    ## A copied box of block-state ids (plus, when collision providers are registered, a per-cell "a provided body fills
    ## this cell" flag), so a path can be computed with no World access. Built on the main thread by `snapshotBlocks`.
    minX*, minY*, minZ*: int32
    sizeX*, sizeY*, sizeZ*: int32
    states*: seq[uint32]
    provided*: seq[bool]      ## empty when no collision provider was registered at capture time
    outsideReads*: int        ## reads outside the box (answered as air); a correct capture keeps this at 0

  PathfindingContext* = ref object
    pathTypeCache: PathTypeCache
    mobPosition: Vector3[int32]
    world: nil World
    snap: nil BlockSnapshot
    collisionCache: Table[int64, bool]

proc newPathfindingContext*(mobPosition: Vector3[int32]; world: World): PathfindingContext =
  PathfindingContext(pathTypeCache: newPathTypeCache(), mobPosition: mobPosition, world: world, snap: nil,
    collisionCache: initTable[int64, bool]())

proc withCache*(mobPosition: Vector3[int32]; world: World; cache: PathTypeCache): PathfindingContext =
  PathfindingContext(pathTypeCache: cache, mobPosition: mobPosition, world: world, snap: nil,
    collisionCache: initTable[int64, bool]())

proc mobPosition*(self: PathfindingContext): Vector3[int32] = self.mobPosition

proc cellHasProvidedBody*(pos: Vector3[int32]): bool =
  ## Whether any registered collision provider has a box inside the unit cell at `pos`.
  let lo = Vector3[float64](x: float64(pos.x), y: float64(pos.y), z: float64(pos.z))
  let hi = Vector3[float64](x: lo.x + 1.0'f64, y: lo.y + 1.0'f64, z: lo.z + 1.0'f64)
  providedSpaceBlocked(newBoundingBox(lo, hi), 0'i32)

proc snapshotBlocks*(world: World; minX, minY, minZ, sizeX, sizeY, sizeZ: int32): BlockSnapshot =
  ## Copies the box [min, min + size) from the live world. Main thread only (reads World and the collision providers).
  ## Reads per 16x16x16 section, not per cell: a column whose chunk is not loaded, or a Y outside the chunk, reads as
  ## `getBlockStateId` answers there (the void-air id, found once); a single-valued section (all air, all stone) is a fill;
  ## only a mixed section is read cell by cell. The result is identical to a per-cell `getBlockStateId` copy.
  let n = int(sizeX) * int(sizeY) * int(sizeZ)
  result = BlockSnapshot(minX: minX, minY: minY, minZ: minZ, sizeX: sizeX, sizeY: sizeY, sizeZ: sizeZ,
    states: newSeq[uint32](n), provided: @[], outsideReads: 0)
  let withProvided = gCollisionProviders.len > 0
  if withProvided:
    result.provided = newSeq[bool](n)
  let lvl = world.level
  let sy = int(sizeY)
  let sz = int(sizeZ)
  var voidId = 0'u32
  var voidKnown = false
  let maxX = minX + sizeX
  let maxZ = minZ + sizeZ
  var cx = minX shr 4
  while (cx shl 4) < maxX:
    var cz = minZ shr 4
    while (cz shl 4) < maxZ:
      let x0 = max(minX, cx shl 4)
      let x1 = min(maxX, (cx shl 4) + 16'i32)
      let z0 = max(minZ, cz shl 4)
      let z1 = min(maxZ, (cz shl 4) + 16'i32)
      let chunk = lvl.loadedChunks.getOrDefault(chunkKey(cx, cz), nil)
      # Y ranges: [y0, y1) inside one section (or outside the chunk).
      var y = minY
      let yEnd = minY + sizeY
      while y < yEnd:
        var inChunk = false
        var secIdx = 0
        var ySecEnd = yEnd
        if chunk != nil:
          let rel = y - chunk.section.minY
          if rel >= 0'i32 and int(rel) div 16 < chunk.section.blockSections.len:
            inChunk = true
            secIdx = int(rel) div 16
            ySecEnd = min(yEnd, chunk.section.minY + int32(secIdx + 1) * 16'i32)
          elif rel < 0'i32:
            ySecEnd = min(yEnd, chunk.section.minY)       # below the chunk: void
          # above the last section: void up to yEnd
        if inChunk:
          let cont = chunk.section.blockSections[secIdx]
          if cont.isSingleValued:
            let v = get(cont, 0, 0, 0)
            for x in x0 ..< x1:
              for zz in z0 ..< z1:
                let base = (int(x - minX) * sy) * sz + int(zz - minZ)
                for yy in y ..< ySecEnd:
                  result.states[base + int(yy - minY) * sz] = v
          else:
            let secMinY = chunk.section.minY + int32(secIdx) * 16'i32
            for x in x0 ..< x1:
              for zz in z0 ..< z1:
                let base = (int(x - minX) * sy) * sz + int(zz - minZ)
                for yy in y ..< ySecEnd:
                  result.states[base + int(yy - minY) * sz] = get(cont, int(x and 15'i32), int(yy - secMinY), int(zz and 15'i32))
        else:
          if not voidKnown:
            voidId = world.getBlockStateId(Vector3[int32](x: x0, y: y, z: z0).asBlockPos())
            voidKnown = true
          for x in x0 ..< x1:
            for zz in z0 ..< z1:
              let base = (int(x - minX) * sy) * sz + int(zz - minZ)
              for yy in y ..< ySecEnd:
                result.states[base + int(yy - minY) * sz] = voidId
        y = ySecEnd
      cz += 1'i32
    cx += 1'i32
  if withProvided:
    for x in 0'i32 ..< sizeX:
      for yy in 0'i32 ..< sizeY:
        for zz in 0'i32 ..< sizeZ:
          let i = (int(x) * sy + int(yy)) * sz + int(zz)
          result.provided[i] = cellHasProvidedBody(Vector3[int32](x: minX + x, y: minY + yy, z: minZ + zz))

proc snapshotAround*(world: World; center: Vector3[int32]; radius: int32): BlockSnapshot =
  ## The box the evaluator needs around a mob: radius = follow range + 1 horizontally; vertically `radius` up (+2 for the
  ## head and step-up probes) and max(radius, 66) down (`getStart` walks down 64 blocks, `getOpenNode` falls up to the safe
  ## fall distance + 2, `getNonWaterNodeBelow` looks 16 down).
  let down = max(radius, 66'i32)
  let up = radius + 2'i32
  snapshotBlocks(world, center.x - radius, center.y - down, center.z - radius, 2'i32 * radius + 1'i32, down + up + 1'i32,
    2'i32 * radius + 1'i32)

proc newSnapshotContext*(mobPosition: Vector3[int32]; snap: BlockSnapshot): PathfindingContext =
  ## A context that reads only `snap` (no World, no collision providers).
  PathfindingContext(pathTypeCache: newPathTypeCache(), mobPosition: mobPosition, world: nil, snap: snap,
    collisionCache: initTable[int64, bool]())

proc snapIndex(s: BlockSnapshot; pos: Vector3[int32]): int =
  let x = pos.x - s.minX
  let y = pos.y - s.minY
  let z = pos.z - s.minZ
  if x < 0'i32 or y < 0'i32 or z < 0'i32 or x >= s.sizeX or y >= s.sizeY or z >= s.sizeZ:
    return -1
  (int(x) * int(s.sizeY) + int(y)) * int(s.sizeZ) + int(z)

proc stateIdAt(self: PathfindingContext; pos: Vector3[int32]): uint32 =
  let s = self.snap
  if s != nil:
    let i = snapIndex(s, pos)
    if i < 0:
      s.outsideReads += 1
      return 0'u32
    return s.states[i]
  let w = self.world
  if w == nil:
    return 0'u32
  w.getBlockStateId(pos.asBlockPos())

proc providedAt(self: PathfindingContext; pos: Vector3[int32]): bool =
  let s = self.snap
  if s != nil:
    if s.provided.len == 0:
      return false
    let i = snapIndex(s, pos)
    return i >= 0 and s.provided[i]
  gCollisionProviders.len > 0 and cellHasProvidedBody(pos)

proc outsideReads*(self: PathfindingContext): int =
  let s = self.snap
  if s != nil: s.outsideReads else: 0

proc computePathTypeFromState*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `compute_path_type_from_state`: classifies a block position into a `PathType` for pathfinding.
  # Single chunk lookup, then derive block & state from static arrays
  let stateId = newBlockStateIdUnchecked(uint16(self.stateIdAt(pos)))
  let blockRef = Block.fromStateId(stateId)
  let state = BlockState.fromId(stateId)
  let id = blockRef.id
  let rawId = asU16(id)
  if id == blockIdAir or id == blockIdVoidAir or id == blockIdCaveAir:
    # A block body (collision provider) filling an air cell is as solid to a path as a stone block: the mob walks around
    # it, onto it (the cell below it then counts as a floor) or jumps up a step. Nothing runs with no provider registered.
    if self.providedAt(pos):
      return ptBlocked
    return ptOpen
  if hasTag(rawId, Block_MINECRAFT_TRAPDOORS) or id == blockIdLilyPad or id == blockIdBigDripleaf:
    return ptTrapdoor
  if id == blockIdPowderSnow:
    return ptPowderSnow
  if id == blockIdCactus or id == blockIdSweetBerryBush:
    return ptDamageOther
  if id == blockIdHoneyBlock:
    return ptStickyHoney
  if id == blockIdCocoa:
    return ptCocoa
  if id == blockIdWitherRose or id == blockIdPointedDripstone:
    return ptDamageCautious
  let fluid = Fluid.fromStateId(stateId)
  if fluid.isSome and hasTag(fluid.unsafeGet.id, Fluid_MINECRAFT_LAVA):
    return ptLava
  if id == blockIdFire or id == blockIdSoulFire or id == blockIdMagmaBlock or id == blockIdCampfire or
      id == blockIdSoulCampfire or id == blockIdLavaCauldron:
    return ptDamageFire
  if hasTag(rawId, Block_MINECRAFT_DOORS):
    if state.collisionShapes.len == 0:
      return ptDoorOpen
    return if id == blockIdIronDoor: ptDoorIronClosed else: ptDoorWoodClosed
  if hasTag(rawId, Block_MINECRAFT_RAILS):
    return ptRail
  if hasTag(rawId, Block_MINECRAFT_LEAVES):
    return ptLeaves
  if hasTag(rawId, Block_MINECRAFT_FENCES) or hasTag(rawId, Block_MINECRAFT_WALLS):
    return ptFence
  if hasTag(rawId, Block_MINECRAFT_FENCE_GATES) and state.collisionShapes.len > 0:
    return ptFence
  if state.isFullCube:
    return ptBlocked
  if fluid.isSome and hasTag(fluid.unsafeGet.id, Fluid_MINECRAFT_WATER):
    return ptWater
  ptOpen

proc getPathTypeFromState*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `get_path_type_from_state`
  let cached = self.pathTypeCache.get(pos)
  if cached.isSome:
    return cached.unsafeGet
  result = self.computePathTypeFromState(pos)
  self.pathTypeCache.insert(pos, result)

proc getNodeTypeFromNeighbors*(self: PathfindingContext; pos: Vector3[int32]; fallback: PathType): PathType =
  ## `get_node_type_from_neighbors`: scans a 3x3x3 neighborhood for danger blocks.
  for dy in -1'i32 .. 1'i32:
    for dx in -1'i32 .. 1'i32:
      for dz in -1'i32 .. 1'i32:
        if dx == 0'i32 and dz == 0'i32:
          continue
        let neighborType = self.getPathTypeFromState(Vector3[int32](x: pos.x + dx, y: pos.y + dy, z: pos.z + dz))
        if neighborType == ptDamageOther:
          return ptDangerOther
        if neighborType == ptDamageFire or neighborType == ptLava:
          return ptDangerFire
        if neighborType == ptWater:
          return ptWaterBorder
        if neighborType == ptDamageCautious:
          return ptDamageCautious
  fallback

proc getLandNodeType*(self: PathfindingContext; pos: Vector3[int32]): PathType =
  ## `get_land_node_type`: the raw block type with below-check and neighbor danger scanning for OPEN nodes.
  let rawType = self.getPathTypeFromState(pos)
  if rawType == ptOpen:
    let belowType = self.getPathTypeFromState(Vector3[int32](x: pos.x, y: pos.y - 1'i32, z: pos.z))
    return case belowType
      of ptOpen, ptWater, ptLava, ptWalkable: ptOpen
      of ptDamageFire: ptDamageFire
      of ptDamageOther: ptDamageOther
      of ptStickyHoney: ptStickyHoney
      of ptPowderSnow: ptDangerPowderSnow
      of ptDamageCautious: ptDamageCautious
      of ptTrapdoor: ptDangerTrapdoor
      else: self.getNodeTypeFromNeighbors(pos, ptWalkable)
  rawType

proc hasCollisions*(self: PathfindingContext; pos: Vector3[int32]): bool =
  ## `has_collisions`
  if self.collisionCache.hasKey(keyOf(pos)):
    return self.collisionCache.getOrDefault(keyOf(pos))
  let stateId = newBlockStateIdUnchecked(uint16(self.stateIdAt(pos)))
  result =BlockState.fromId(stateId).isFullCube
  self.collisionCache[keyOf(pos)] = result

proc clearCaches*(self: PathfindingContext) =
  self.pathTypeCache.clear()
  self.collisionCache = initTable[int64, bool]()
