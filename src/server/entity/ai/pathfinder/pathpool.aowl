## Gate and pool for the pathfinding job (docs/MULTITHREADING_PHASES.md phase 1, item e).
##
## Off by default. On when MC_PATH_WORKERS=1 and the resolved thread plan (`threadcfg.planThreads`, same inputs as
## `netEncodeEnabled`) has workers. With the gate off nothing here is ever touched by the Navigator.
## `enablePathJobs(workers)` is for tests: 0 workers means the job runs inline at submit, still applied next tick.

{.feature: "lenientnils".}

import std/envvars
import std/cpuinfo
import ../../../sim/[threadcfg, jobpool]

var gPathPool: JobPool = nil
var gPathDecided = false
var gPathOn = false

proc enablePathJobs*(workers: int): bool =
  if gPathPool == nil:
    gPathPool = newJobPool(workers + 1)
  gPathDecided = true
  gPathOn = true
  true

proc envPlanWorkers*(): int =
  ## Workers the resolved thread plan allows for optional pool jobs (same inputs as `netEncodeEnabled`), at most 4; 0 = none.
  var envThreads = -1
  var envChunk = -1
  let t = getEnv("MC_THREADS")
  if t.len > 0:
    envThreads = 0
    for c in t:
      if c >= '0' and c <= '9':
        envThreads = envThreads * 10 + (ord(c) - ord('0'))
  let w = getEnv("MC_CHUNK_WORKERS")
  if w.len > 0:
    envChunk = 0
    for c in w:
      if c >= '0' and c <= '9':
        envChunk = envChunk * 10 + (ord(c) - ord('0'))
  let plan = planThreads(0, 0, countProcessors(), envThreads, envChunk)
  if plan.workers > 4: 4 else: plan.workers

proc sharedJobPool*(workers: int): JobPool =
  ## The one worker pool of the optional pool jobs (path search, erosion): created on first use, then shared. jobpool allows one pool
  ## with workers per process, so every user asks here instead of calling `newJobPool`. Does not switch path jobs on.
  if gPathPool == nil:
    gPathPool = newJobPool(workers + 1)
  gPathPool

proc pathJobsEnabled*(): bool =
  if not gPathDecided:
    gPathDecided = true
    if getEnv("MC_PATH_WORKERS") == "1":
      let n = envPlanWorkers()
      if n > 0:
        discard enablePathJobs(n)
  gPathOn

proc pathPool*(): JobPool = gPathPool

proc usePathPool*(p: JobPool) =
  ## Tests: swap the pool (the old one is shut down by the caller).
  gPathPool = p
  gPathDecided = true
  gPathOn = p != nil
