## The snapshot-backed PathfindingContext (MULTITHREADING_PHASES.md 1e): computePathWith over a copied block box must give
## exactly the Path computePathWith gives over the live World, on generated terrains, for many start/goal pairs.

import std/[assertions, cmdline, math, options, syncio]
import ../../../../data/block_ext
from ../../../../data/block_state import asU16
import ../../../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../../../data/datamod
import ../../../recipe
import ../../../scheduler
import ../../../tick_rate_manager
import ../../../entity/entitymod
import ../../../../generated/block_properties
import pathfindermod

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/pathsnap_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)

proc stateOf(b: Block): uint32 = uint32(asU16(b.defaultState.id))
proc bp(x, y, z: int32): BlockPos = BlockPos(vec: Vector3[int32](x: x, y: y, z: z))
proc put(x, y, z: int32; b: Block) =
  discard level.setBlockState(theLevel, bp(x, y, z), stateOf(b))

for cx in -1'i32 .. 2'i32:
  for cz in -1'i32 .. 2'i32:
    addLoadedChunk(theLevel, newChunkData(cx, cz, newChunkSections(24, -64'i32)))

var seed = 12345'u64
proc rnd(n: int): int =
  seed = seed * 6364136223846793005'u64 + 1442695040888963407'u64
  int((seed shr 33) mod uint64(n))

const
  Lo = 0'i32
  Hi = 36'i32
  Cx = 18'i32
  Cz = 18'i32
  FloorY = 63'i32

proc rx(): int32 = Lo + int32(rnd(int(Hi - Lo)))

proc clearTerrain() =
  for x in Lo - 2'i32 .. Hi + 2'i32:
    for z in Lo - 2'i32 .. Hi + 2'i32:
      for y in 40'i32 .. 80'i32:
        put(x, y, z, blockAir())
      put(x, FloorY, z, blockStone())

proc buildTerrain(kind: int) =
  clearTerrain()
  case kind
  of 0: discard                                                  # flat
  of 1:                                                          # random walls
    for i in 0 ..< 40:
      let h = 1 + rnd(3)
      let x = rx()
      let z = rx()
      for y in 0 ..< h:
        put(x, FloorY + 1'i32 + int32(y), z, blockStone())
  of 2:                                                          # long wall with a gap, plus pillars
    for z in Lo .. Hi:
      for y in 1'i32 .. 3'i32:
        put(Cx + 3'i32, FloorY + y, z, blockStone())
    for y in 1'i32 .. 3'i32:
      put(Cx + 3'i32, FloorY + y, Cz + 6'i32, blockAir())
    for i in 0 ..< 10:
      put(rx(), FloorY + 1'i32, rx(), blockStone())
  of 3:                                                          # holes (fall / no floor)
    for i in 0 ..< 60:
      let x = rx()
      let z = rx()
      put(x, FloorY, z, blockAir())
      if rnd(2) == 0:
        put(x, FloorY - 1'i32, z, blockAir())
  of 4:                                                          # water pools
    for i in 0 ..< 8:
      let x0 = rx() div 2'i32
      let z0 = rx() div 2'i32
      let w = 2 + rnd(4)
      for dx in 0 ..< w:
        for dz in 0 ..< w:
          put(x0 + int32(dx), FloorY, z0 + int32(dz), blockWater())
  of 5:                                                          # doors, fences, cactus, trapdoors, a wall with a door
    for i in 0 ..< 30:
      let x = rx()
      let z = rx()
      case rnd(5)
      of 0: put(x, FloorY + 1'i32, z, blockOakDoor())
      of 1: put(x, FloorY + 1'i32, z, blockOakFence())
      of 2: put(x, FloorY + 1'i32, z, blockCactus())
      of 3: put(x, FloorY + 1'i32, z, blockIronDoor())
      else: put(x, FloorY + 1'i32, z, blockOakTrapdoor())
    for z in Lo .. Hi:
      put(Cx + 2'i32, FloorY + 1'i32, z, blockStone())
      put(Cx + 2'i32, FloorY + 2'i32, z, blockStone())
    put(Cx + 2'i32, FloorY + 1'i32, Cz, blockOakDoor())
  of 6:                                                          # ladders against a tower, lava
    for y in 1'i32 .. 6'i32:
      put(Cx + 4'i32, FloorY + y, Cz, blockStone())
      put(Cx + 3'i32, FloorY + y, Cz, blockLadder())
    for i in 0 ..< 6:
      put(rx(), FloorY, rx(), blockLava())
  else:                                                          # stepped hills
    for x in Lo .. Hi:
      for z in Lo .. Hi:
        let h = (abs(x - Cx) + abs(z - Cz)) div 6
        for y in 1 ..< (4 - min(h, 3)) + 1:
          put(x, FloorY + int32(y), z, blockStone())

var checked = 0
var withPath = 0
var failures = 0
var outside = 0

proc sameVec(a, b: Vector3[int32]): bool = a.x == b.x and a.y == b.y and a.z == b.z

proc sameNode(a, b: Node): bool =
  if a.cameFrom.isSome != b.cameFrom.isSome:
    return false
  if a.cameFrom.isSome and not sameVec(a.cameFrom.unsafeGet, b.cameFrom.unsafeGet):
    return false
  sameVec(a.pos.vec, b.pos.vec) and a.pathType == b.pathType and a.costMalus == b.costMalus and a.g == b.g and a.h == b.h and
    a.f == b.f and a.walkedDist == b.walkedDist and a.closed == b.closed

proc samePath(a, b: nil Path): bool =
  if a == nil or b == nil:
    return a == nil and b == nil
  if a.getNodeCount() != b.getNodeCount() or a.canReach() != b.canReach():
    return false
  for i in 0 ..< a.getNodeCount():
    if not sameNode(a.getNode(i).unsafeGet, b.getNode(i).unsafeGet):
      return false
  true

const FollowRange = 16.0'f32

for kind in 0 ..< 8:
  buildTerrain(kind)
  let centerVec = Vector3[int32](x: Cx, y: FloorY + 1'i32, z: Cz)
  # One snapshot per terrain around the centre; starts stay within 5 blocks of it, so the radius adds that spread.
  let snap = snapshotAround(testWorld, centerVec, int32(FollowRange) + 1'i32 + 6'i32)
  for trial in 0 ..< 40:
    let sx = float64(Cx - 5'i32 + int32(rnd(11))) + 0.5'f64
    let sz = float64(Cz - 5'i32 + int32(rnd(11))) + 0.5'f64
    let startPos = Vector3[float64](x: sx, y: float64(FloorY + 1'i32), z: sz)
    let dest = Vector3[float64](x: float64(Cx - 12'i32 + int32(rnd(25))) + 0.5'f64, y: float64(FloorY + 1'i32 + int32(rnd(3))),
      z: float64(Cz - 12'i32 + int32(rnd(25))) + 0.5'f64)
    let onGround = rnd(5) != 0
    let startVec = startPos.toI32()
    let mobPos = Vector3[int32](x: startVec.x, y: startVec.y, z: startVec.z)
    let liveNav = newNavigator()
    let snapNav = newNavigator()
    let live = liveNav.computePathWith(newPathfindingContext(mobPos, testWorld), startPos, onGround, FollowRange, dest)
    let ctx = newSnapshotContext(mobPos, snap)
    let viaSnap = snapNav.computePathWith(ctx, startPos, onGround, FollowRange, dest)
    checked += 1
    if live != nil:
      withPath += 1
    outside += ctx.outsideReads()
    if not samePath(live, viaSnap):
      failures += 1
      echo "MISMATCH terrain ", kind, " trial ", trial, " start ", sx, ",", sz, " dest ", dest.x, ",", dest.y, ",", dest.z

echo "pathsnapshot checked ", checked, " with-path ", withPath, " mismatches ", failures, " outside-box reads ", outside
assert failures == 0
assert outside == 0
assert withPath > checked div 3
echo "pathsnapshot ok"
