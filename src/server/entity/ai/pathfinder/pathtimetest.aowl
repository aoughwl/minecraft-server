## The snapshot-backed PathfindingContext (MULTITHREADING_PHASES.md 1e): computePathWith over a copied block box must give
## exactly the Path computePathWith gives over the live World, on generated terrains, for many start/goal pairs.

import std/[assertions, cmdline, math, options, syncio]
import ../../../../data/block_ext
from ../../../../data/block_state import asU16
import ../../../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../../../data/datamod
import ../../../recipe
import ../../../scheduler
import ../../../tick_rate_manager
import ../../../entity/entitymod
import ../../../../generated/block_properties
import ../../../net/winsock
import pathfindermod

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/pathtime_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)

proc stateOf(b: Block): uint32 = uint32(asU16(b.defaultState.id))
proc bp(x, y, z: int32): BlockPos = BlockPos(vec: Vector3[int32](x: x, y: y, z: z))
proc put(x, y, z: int32; b: Block) =
  discard level.setBlockState(theLevel, bp(x, y, z), stateOf(b))

## Timing of the path job's costs on a flat floor: snapshotAround for several radii vs one inline computePathWith.

for cx in -3'i32 .. 4'i32:
  for cz in -3'i32 .. 4'i32:
    addLoadedChunk(theLevel, newChunkData(cx, cz, newChunkSections(24, -64'i32)))
for x in -40'i32 .. 79'i32:
  for z in -40'i32 .. 79'i32:
    discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: x, y: 63'i32, z: z)), stateOf(blockStone()))

let center = Vector3[int32](x: 18, y: 64, z: 18)
for r in [17'i32, 33'i32]:
  let n = 10
  let t0 = nowMs()
  var cells = 0
  for i in 0 ..< n:
    let s = snapshotAround(testWorld, center, r)
    cells = s.states.len
  let t1 = nowMs()
  echo "snapshotAround radius ", r, " cells ", cells, " : ", float64(t1 - t0) / float64(n), " ms each"

let nav = newNavigator()
let startPos = Vector3[float64](x: 18.5, y: 64.0, z: 18.5)
let t2 = nowMs()
let reps: int = 200
var got = 0
for i in 0 ..< reps:
  let dest = Vector3[float64](x: 18.5 + float64(i mod 20) - 10.0, y: 64.0, z: 18.5 + float64((i div 20) mod 20) - 10.0)
  let p = nav.computePathWith(newPathfindingContext(Vector3[int32](x: 18, y: 64, z: 18), testWorld), startPos, true, 32.0'f32, dest)
  if p != nil: got += 1
let t3 = nowMs()
echo "computePathWith live ", float64(t3 - t2) / float64(int64(reps)), " ms each (", got, " paths)"

# The section-wise snapshot must equal a per-cell world read, also over unloaded columns and above/below the chunk.
for i in 0 ..< 300:
  discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: int32(-40 + (i * 37) mod 120), y: int32(64 + (i * 11) mod 9), z: int32(-40 + (i * 53) mod 120))), stateOf(blockStone()))
var mismatches = 0
for (cx, cz, cy) in [(18'i32, 18'i32, 64'i32), (-60'i32, 70'i32, 64'i32), (0'i32, 0'i32, 300'i32), (30'i32, 30'i32, -120'i32), (-48'i32, -48'i32, 70'i32)]:
  let r = 33'i32
  let s = snapshotAround(testWorld, Vector3[int32](x: cx, y: cy, z: cz), r)
  var i = 0
  for x in 0'i32 ..< s.sizeX:
    for y in 0'i32 ..< s.sizeY:
      for z in 0'i32 ..< s.sizeZ:
        let want = testWorld.getBlockStateId(BlockPos(vec: Vector3[int32](x: s.minX + x, y: s.minY + y, z: s.minZ + z)))
        if s.states[i] != want:
          mismatches += 1
        i += 1
echo "snapshot vs per-cell mismatches ", mismatches
assert mismatches == 0

# Worst case for the fast path: every section in the box is mixed (random blocks through y -64..100).
for i in 0 ..< 60000:
  discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: int32(-40 + (i * 37) mod 120), y: int32(-64 + (i * 11) mod 160), z: int32(-40 + (i * 53) mod 120))), stateOf(blockStone()))
let t4 = nowMs()
for i in 0 ..< 10:
  discard snapshotAround(testWorld, center, 33'i32)
echo "snapshotAround radius 33, all sections mixed: ", float64(t4 - t4) + float64(nowMs() - t4) / 10.0, " ms each"
