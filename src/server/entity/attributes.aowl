## Port of pumpkin/src/entity/attributes.rs
## PARTIAL: pumpkin/src/entity/attributes.rs - `send_attribute_updates_for_living` needs a `LivingEntity` and is `sendAttributeUpdatesForLiving` in entitymod.aowl, Java half only, as is all of this port's entity traffic.
##
## Upstream's `Modifier` is `AttrModifier` here: pumpkin-data's `data_component_impl` already has a `Modifier`, and
## anything using an item's attribute modifiers imports both.

import std/[math, tables]
import ../../generated/attributes
import ../../generated/entity_type

type
  ModifierOperation* = enum
    moAdd = 0            ## add value
    moMultiplyBase = 1   ## multiply base (base * (1 + x))
    moMultiplyTotal = 2  ## multiply total (applied last)

  AttrModifier* = object
    id*: string
    amount*: float64
    operation*: ModifierOperation

  AttributeInstance* = ref object
    ## Per-entity attribute instance used at runtime.
    baseValue*: float64
    modifiers*: seq[AttrModifier]
    cachedValue*: float64
    dirty*: bool

  AttributeRegistry* = object
    ## Per-entity-type base attribute overrides.
    map: Table[uint16, Table[uint8, float64]]

  AttributeBuilder* = object
    entries*: seq[(Attribute, float64)]

proc newAttributeInstance*(baseValue: float64): AttributeInstance =
  AttributeInstance(baseValue: baseValue, modifiers: @[], cachedValue: baseValue, dirty: false)

proc value*(self: AttributeInstance): float64 =
  if not self.dirty:
    return self.cachedValue
  var value = self.baseValue
  var addSum = 0.0'f64
  var mulBase = 0.0'f64
  var mulTotal = 1.0'f64
  for m in self.modifiers:
    case m.operation
    of moAdd: addSum += m.amount
    of moMultiplyBase: mulBase += m.amount
    of moMultiplyTotal: mulTotal *= 1.0'f64 + m.amount
  value += addSum
  value *= 1.0'f64 + mulBase
  value *= mulTotal
  if isNaN(value) or value == Inf or value == -Inf:
    value = self.baseValue
  self.cachedValue = value
  self.dirty = false
  value

proc addOrReplaceModifier*(self: AttributeInstance; modifier: AttrModifier) =
  for i in 0 ..< self.modifiers.len:
    if self.modifiers[i].id == modifier.id:
      self.modifiers.delete(i)
      break
  self.modifiers.add(modifier)
  self.dirty = true

proc removeModifier*(self: AttributeInstance; id: string) =
  ## `swap_remove`, as upstream.
  for i in 0 ..< self.modifiers.len:
    if self.modifiers[i].id == id:
      let last = self.modifiers[self.modifiers.len - 1]
      self.modifiers[i] = last
      self.modifiers.setLen(self.modifiers.len - 1)
      break
  self.dirty = true

proc clone*(self: AttributeInstance): AttributeInstance =
  AttributeInstance(baseValue: self.baseValue, modifiers: self.modifiers, cachedValue: self.cachedValue, dirty: self.dirty)

proc newAttributeRegistry*(): AttributeRegistry =
  AttributeRegistry(map: initTable[uint16, Table[uint8, float64]]())

proc getBaseValue*(self: AttributeRegistry; entityTypeId: uint16; attribute: Attribute): float64 =
  ## If no override exists, returns `attribute.defaultValue`.
  if self.map.hasKey(entityTypeId):
    let inner = self.map.getOrDefault(entityTypeId)
    if inner.hasKey(attribute.id):
      return inner.getOrDefault(attribute.id)
  attribute.defaultValue

proc getOverridesForEntity*(self: AttributeRegistry; entityTypeId: uint16): (bool, seq[(uint8, float64)]) =
  ## False when the type has no overrides at all.
  if not self.map.hasKey(entityTypeId):
    return (false, @[])
  var found: seq[(uint8, float64)] = @[]
  let inner = self.map.getOrDefault(entityTypeId)
  for k, v in inner:
    found.add((k, v))
  (true, found)

proc newAttributeBuilder*(): AttributeBuilder =
  AttributeBuilder(entries: @[])

proc add*(self: AttributeBuilder; attribute: Attribute; base: float64): AttributeBuilder =
  result = self
  result.entries.add((attribute, base))

proc build*(self: AttributeBuilder): seq[(Attribute, float64)] =
  self.entries

proc registerBuilder*(self: var AttributeRegistry; entityType: EntityType; builder: AttributeBuilder) =
  var inner = self.map.getOrDefault(entityType.id)
  for entry in builder.build():
    inner[entry[0].id] = entry[1]
  self.map[entityType.id] = inner
