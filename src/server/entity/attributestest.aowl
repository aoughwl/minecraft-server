## attributes.aowl: known answers worked from attributes.rs's `value` order: add, multiply base, multiply total.

import std/[assertions, syncio]
import ../../generated/attributes
import ../../generated/entity_type
import attributes as attrs

block no_modifiers_uses_base:
  let a = newAttributeInstance(0.25'f64)
  assert a.value() == 0.25'f64

block order_of_operations:
  let a = newAttributeInstance(10.0'f64)
  a.addOrReplaceModifier(AttrModifier(id: "a", amount: 2.0'f64, operation: moAdd))
  a.addOrReplaceModifier(AttrModifier(id: "b", amount: 0.5'f64, operation: moMultiplyBase))
  a.addOrReplaceModifier(AttrModifier(id: "c", amount: 1.0'f64, operation: moMultiplyTotal))
  a.addOrReplaceModifier(AttrModifier(id: "d", amount: 0.5'f64, operation: moMultiplyTotal))
  # (10 + 2) * (1 + 0.5) * (1 + 1) * (1 + 0.5)
  assert a.value() == 54.0'f64
  # Replacing moves the modifier to the back and changes the amount.
  a.addOrReplaceModifier(AttrModifier(id: "a", amount: 0.0'f64, operation: moAdd))
  assert a.modifiers[a.modifiers.len - 1].id == "a"
  assert a.value() == 45.0'f64

block remove_swaps:
  let a = newAttributeInstance(1.0'f64)
  a.addOrReplaceModifier(AttrModifier(id: "a", amount: 1.0'f64, operation: moAdd))
  a.addOrReplaceModifier(AttrModifier(id: "b", amount: 2.0'f64, operation: moAdd))
  a.addOrReplaceModifier(AttrModifier(id: "c", amount: 3.0'f64, operation: moAdd))
  a.removeModifier("a")
  assert a.modifiers.len == 2 and a.modifiers[0].id == "c" and a.modifiers[1].id == "b"
  assert a.value() == 6.0'f64

block not_finite_falls_back_to_base:
  let a = newAttributeInstance(3.0'f64)
  a.addOrReplaceModifier(AttrModifier(id: "x", amount: Inf, operation: moAdd))
  assert a.value() == 3.0'f64

block registry:
  var r = newAttributeRegistry()
  assert r.getBaseValue(EntityType.ZOMBIE.id, MAX_HEALTH) == 20.0'f64
  r.registerBuilder(EntityType.ZOMBIE, newAttributeBuilder().add(MAX_HEALTH, 30.0'f64))
  assert r.getBaseValue(EntityType.ZOMBIE.id, MAX_HEALTH) == 30.0'f64
  assert r.getBaseValue(EntityType.ZOMBIE.id, ARMOR) == 0.0'f64
  let (has, found) = r.getOverridesForEntity(EntityType.ZOMBIE.id)
  assert has and found.len == 1 and found[0][0] == MAX_HEALTH.id and found[0][1] == 30.0'f64
  assert not r.getOverridesForEntity(EntityType.CREEPER.id)[0]

echo "attributes ok"
