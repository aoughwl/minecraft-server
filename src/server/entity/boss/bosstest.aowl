## Known answers read from pumpkin/src/entity/boss: goals and attributes against the Rust and assets/entities.json, the dragon's
## path search, flight history and phases. Upstream has no #[test] here.

import std/[assertions, math, options]
from ../../../generated/attributes import MAX_HEALTH, FOLLOW_RANGE
import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity]
import ../mob/testworld
import ender_dragon, wither
import ender_dragon/phase/[circling, hovering]

let server = newTestServer()
let world0 = newTestWorld(server, "bosstest")

var orbs: seq[uint32] = @[]

proc targetIs(d: EnderDragonEntity; v: Vector3[float64]): bool =
  d.targetLocation.isSome and d.targetLocation.unsafeGet == v

block wither_goals:
  let w = newWitherEntity(newEntity(world0, pos3(0.5, 80.0, 0.5), EntityType.WITHER))
  spawnEntity(world0, asBase(w))
  let goals = w.mobEntity.goalsSelector.goals
  assert goals.len == 2
  assert goals[0].priority == 8'u8 and goals[0].goal of LookAtEntityGoal
  assert goals[1].priority == 8'u8 and goals[1].goal of RandomLookAroundGoal
  assert w.mobEntity.targetSelector.goals.len == 0
  assert w.mobEntity.livingEntity.getAttributeValue(MAX_HEALTH) == 300.0
  assert w.mobEntity.livingEntity.getAttributeValue(FOLLOW_RANGE) == 40.0
  let base = asBase(w)
  for i in 0 ..< 40:
    base.tick(base, server)

block flight_history:
  var h = newDragonFlightHistory()
  assert h.get(0'i32).y == 0.0, "nothing recorded yet"
  h.record(1.0, 10.0'f32)
  h.record(2.0, 20.0'f32)
  assert h.get(0'i32).y == 2.0
  assert h.get(1'i32).y == 1.0
  assert h.get(1'i32).yRot == 10.0'f32
  # Wraps at 64.
  for i in 0 ..< 64:
    h.record(float64(i), 0.0'f32)
  assert h.get(0'i32).y == 63.0
  assert h.get(63'i32).y == 0.0

block phases:
  assert not edpCircling.isSitting()
  assert not edpStrafing.isSitting()
  assert not edpCharging.isSitting()
  assert not edpFlyToPortal.isSitting()
  assert edpLandingApproach.isSitting()
  assert edpLanding.isSitting()
  assert edpSitAttacking.isSitting()
  assert edpSitBreathing.isSitting()
  assert edpTakingOff.isSitting()
  assert not edpHovering.isSitting()
  assert not edpDying.isSitting()
  assert edpDying.networkId() == 10'i32
  # `PhaseManager` holds each by its own number, and the trait's speeds with charging's override.
  let manager = newPhaseManager()
  for phaseType in edpCircling .. edpDying:
    assert manager.getPhase(phaseType).getType == phaseType
    assert manager.getPhase(phaseType).getTurnSpeed == 0.1'f32
  assert manager.getPhase(edpCharging).getFlySpeed == 3.0'f32
  assert manager.getPhase(edpCircling).getFlySpeed == 0.6'f32

proc ringNodes(): seq[Option[DragonNode]] =
  ## The outer twelve of the fight's nodes, at a fixed height, the rest absent.
  result = newSeq[Option[DragonNode]](NodeCount)
  for i in 0 ..< 12:
    let angle = float64(i) * 2.0 * PI / 12.0
    result[i] = some(newDragonNode(60.0 * cos(angle), 80.0, 60.0 * sin(angle)))

block find_path:
  let nodes = ringNodes()
  # Same node, no final: nothing to do.
  assert findPath(nodes, 3, 3, none[DragonNode]()).len == 0
  # Node 0's adjacency is 6146 = bits 1, 11, 12. Neighbours are one hop, and `from` is not in the answer.
  assert findPath(nodes, 0, 1, none[DragonNode]()) == @[1]
  assert findPath(nodes, 0, 11, none[DragonNode]()) == @[11]
  # Around the ring by the short way.
  assert findPath(nodes, 0, 3, none[DragonNode]()) == @[1, 2, 3]
  assert findPath(nodes, 0, 9, none[DragonNode]()) == @[11, 10, 9]

block dragon_motion:
  let d = newEnderDragonEntity(newEntity(world0, pos3(0.5, 100.0, 0.5), EntityType.ENDER_DRAGON))
  spawnEntity(world0, asBase(d))
  assert d.entity.noClip
  assert d.parts.len == 8
  for i in 0 ..< d.parts.len:
    assert d.parts[i].entity.entityId == d.entity.entityId + int32(i) + 1'i32
    assert d.parts[i].dragonUuid == d.entity.entityUuid
  assert d.phase == edpCircling
  assert d.growlTime == 200'i32
  assert d.holdingPatternClockwise
  assert d.fightOrigin == newBlockPos(0'i32, 128'i32, 0'i32)
  assert d.getMobGravity() == 0.0

  # `yaw_toward`: atan2(-dz, dx) in degrees, less 90.
  assert abs(yawToward(pos3(0.0, 0.0, 0.0), pos3(1.0, 0.0, 0.0)) - (-90.0'f32)) < 1e-4'f32
  # `get_relative_movement`: nothing under 1e-7; unit-clamped, scaled and turned by yaw.
  assert getRelativeMovement(pos3(0.0, 0.0, 0.0), 1.0'f32, 0.0'f32) == pos3(0.0, 0.0, 0.0)
  let moved = getRelativeMovement(pos3(0.0, 0.0, 2.0), 0.5'f32, 90.0'f32)
  assert abs(moved.x - (-0.5)) < 1e-6
  assert abs(moved.z) < 1e-6

  # Nodes: twelve at 60, eight at 40, four at 20, y at least 73 (height unset answers the world's min).
  d.setFightOrigin(newBlockPos(0'i32, 64'i32, 0'i32))
  assert not d.nodesInitialized
  d.ensureNodesInitialized()
  assert d.nodesInitialized
  assert d.nodes[0].unsafeGet.x == 60.0 and d.nodes[0].unsafeGet.y == 73.0 and d.nodes[0].unsafeGet.z == 0.0
  assert d.nodes[12].unsafeGet.x == 40.0
  assert d.nodes[20].unsafeGet.x == 20.0
  assert d.findClosestNodeTo(pos3(60.0, 73.0, 0.0)) == 0
  assert d.findClosestNodeTo(pos3(20.0, 73.0, 0.0)) == 20

  # `set_phase`: the old phase's `end`, the new one's `begin`. Dying clears the target.
  d.targetLocation = some(pos3(1.0, 2.0, 3.0))
  d.setPhase(edpDying)
  assert d.phase == edpDying
  assert d.targetLocation.isNone

  # `hurt` only counts while sitting.
  d.phase = edpHovering
  d.hurt(10.0'f32)
  assert d.sittingDamageReceived == 0.0'f32
  d.phase = edpSitAttacking
  d.hurt(10.0'f32)
  assert d.sittingDamageReceived == 10.0'f32

block phase_ticks:
  let d = newEnderDragonEntity(newEntity(world0, pos3(0.5, 100.0, 0.5), EntityType.ENDER_DRAGON))
  spawnEntity(world0, asBase(d))
  d.fightOrigin = newBlockPos(0'i32, 64'i32, 0'i32)
  let pos = d.entity.pos

  # Each of these heads somewhere until within reach.
  d.setPhase(edpTakingOff)
  d.phaseManager.getPhase(edpTakingOff).tick(d)
  assert targetIs(d, pos3(0.0, 105.0, 0.0))
  d.entity.setPos(pos3(0.0, 105.0, 0.0))
  d.phaseManager.getPhase(edpTakingOff).tick(d)
  assert d.phase == edpCircling

  d.entity.setPos(pos)
  d.setPhase(edpFlyToPortal)
  d.phaseManager.getPhase(edpFlyToPortal).tick(d)
  assert targetIs(d, pos3(0.0, 74.0, 0.0))
  d.entity.setPos(pos3(0.0, 74.0, 0.0))
  d.phaseManager.getPhase(edpFlyToPortal).tick(d)
  assert d.phase == edpLandingApproach

  d.phaseManager.getPhase(edpLandingApproach).tick(d)
  assert targetIs(d, pos3(0.0, 64.0, 0.0))
  d.entity.setPos(pos3(0.0, 64.0, 0.0))
  d.phaseManager.getPhase(edpLandingApproach).tick(d)
  assert d.phase == edpLanding

  # Landing begins clearing the target, then sits at once with both timers at 0.
  assert d.targetLocation.isNone
  d.ticksSitting = 5'i32
  d.sitAttackTimer = 5'i32
  d.phaseManager.getPhase(edpLanding).tick(d)
  assert d.phase == edpSitAttacking
  assert d.ticksSitting == 0'i32 and d.sitAttackTimer == 0'i32

  # Sitting: 150 damage sends it off.
  d.sittingDamageReceived = 151.0'f32
  d.phaseManager.getPhase(edpSitAttacking).tick(d)
  assert d.phase == edpTakingOff
  assert d.sittingDamageReceived == 0.0'f32

  # Charging with no player falls back under the origin, and hovers on arrival.
  d.entity.setPos(pos)
  d.targetPlayer = none[Uuid]()
  d.setPhase(edpCharging)
  d.phaseManager.getPhase(edpCharging).tick(d)
  assert targetIs(d, pos3(0.0, 85.0, 0.0))
  d.entity.setPos(pos3(0.0, 85.0, 0.0))
  d.phaseManager.getPhase(edpCharging).tick(d)
  assert d.phase == edpHovering

  # Strafing with no player goes back to circling.
  d.targetPlayer = none[Uuid]()
  d.setPhase(edpStrafing)
  assert d.fireballCharge == 0'i32
  d.phaseManager.getPhase(edpStrafing).tick(d)
  assert d.phase == edpCircling

  # Circling with no target picks the next node over.
  d.targetLocation = none[Vector3[float64]]()
  d.path.setLen(0)
  d.ensureNodesInitialized()
  d.phaseManager.getPhase(edpCircling).tick(d)
  assert d.targetLocation.isSome or d.phase != edpCircling

block dying:
  let d = newEnderDragonEntity(newEntity(world0, pos3(0.5, 100.0, 0.5), EntityType.ENDER_DRAGON))
  spawnEntity(world0, asBase(d))
  d.setPhase(edpDying)
  gSpawnExperienceOrb = proc(world: World; position: Vector3[float64]; amount: uint32) {.closure.} =
    orbs.add(amount)
  for i in 0 ..< 199:
    d.phaseManager.getPhase(edpDying).tick(d)
  assert not isGone(d.entity)
  assert d.entity.velocity == pos3(0.0, 0.1, 0.0)
  # No fight: 500 xp; a share of 40 every 5th tick over 150 (155..195 is 9).
  assert orbs.len == 9
  assert orbs[0] == 40'u32
  d.phaseManager.getPhase(edpDying).tick(d)
  assert orbs[orbs.len - 1] == 100'u32
  assert isGone(d.entity)

block part_damage:
  # A part forwards to the dragon with its uuid, or answers false with none in the world.
  let d = newEnderDragonEntity(newEntity(world0, pos3(0.5, 100.0, 0.5), EntityType.ENDER_DRAGON))
  let part = d.parts[0]
  let partBase = asBase(part)
  assert partBase.canHit()
  assert not partBase.damage(asBase(d), 1.0'f32, GENERIC)
  spawnEntity(world0, asBase(d))
  # The trait's `damage` calls `caller.damage_with_context`, so the caller is what takes it.
  let before = d.mobEntity.livingEntity.health
  assert partBase.damage(asBase(d), 1.0'f32, GENERIC)
  assert d.mobEntity.livingEntity.health < before

block ai_step:
  # A tick of the whole thing in an empty world does not need a player or a block.
  let d = newEnderDragonEntity(newEntity(world0, pos3(0.5, 100.0, 0.5), EntityType.ENDER_DRAGON))
  spawnEntity(world0, asBase(d))
  let base = asBase(d)
  for i in 0 ..< 40:
    base.tick(base, server)
  assert d.flapTime > 0.0'f32
