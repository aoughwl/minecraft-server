## Port of pumpkin/src/entity/boss/ender_dragon.rs
##
## The constructor and `impl Mob`. The types and the rest of the dragon are in ender_dragon/dragonbase.aowl: see its header.

import std/options
import ../ai/aibase
import ender_dragon/dragonbase
import ender_dragon/phase/phasemod
import ../mob/mobvts

export dragonbase, phasemod

proc makeEnderDragonMobVt(): MobVt =
  result = newMobVt()
  result.mobTick = proc(self: Mob; caller: EntityBase) {.closure.} =
    let dragon = EnderDragonEntity(self)
    dragon.aiStep()
  result.onDamage = proc(self: Mob; damageType: DamageType; source: nil EntityBase) {.closure.} =
    let dragon = EnderDragonEntity(self)
    if self.mobEntity.livingEntity.health <= 0.0'f32:
      dragon.setPhase(edpDying)
  result.getMobGravity = proc(self: Mob): float64 {.closure.} = 0.0

let enderDragonMobVt = makeEnderDragonMobVt()

proc newEnderDragonEntity*(entity: Entity): EnderDragonEntity =
  entity.noClip = true
  let baseId = entity.entityId
  let dragonUuid = entity.entityUuid
  let world = entity.world

  discard reserveIds(world.server, 8'i32)

  var parts: seq[EnderDragonPart] = @[]
  for i in 1'i32 .. 8'i32:
    let partEntity = fromUuidWithId(baseId + i, randomUuid(), world, entity.pos, EntityType.ENDER_DRAGON)
    # TODO upstream: world.add_entity_silent(part.clone() as Arc<dyn EntityBase>);
    parts.add(newEnderDragonPart(partEntity, dragonUuid))

  result = EnderDragonEntity(parts: parts, flightHistory: newDragonFlightHistory(), flapTime: 0.0'f32, oFlapTime: 0.0'f32,
    inWall: false, dragonDeathTime: 0'i32, sittingDamageReceived: 0.0'f32, nodesInitialized: false,
    fightOrigin: newBlockPos(0'i32, 128'i32, 0'i32), phaseManager: newPhaseManager(), phase: edpCircling,
    growlTime: 200'i32, yawRotAccel: 0.0'f32, holdingPatternClockwise: true, targetLocation: none[Vector3[float64]](),
    fireballCharge: 0'i32, nodes: newSeq[Option[DragonNode]](NodeCount), path: @[], targetNode: 0,
    strafeTarget: none[Vector3[float64]](), targetPlayer: none[Uuid](), ticksSitting: 0'i32, sitAttackTimer: 0'i32,
    breathingTimer: 0'i32)
  result.initMob(newMobEntity(entity), enderDragonMobVt, noNbtMobEntityVt())
