## Port of pumpkin/src/entity/boss/ender_dragon/flight_history.rs

type
  Sample* = object
    y*: float64
    yRot*: float32

  DragonFlightHistory* = object
    samples: seq[Sample]  ## `[Sample; 64]`
    head: int32

proc newDragonFlightHistory*(): DragonFlightHistory =
  result = DragonFlightHistory(samples: newSeq[Sample](64), head: -1'i32)

proc record*(self: var DragonFlightHistory; y: float64; yRot: float32) =
  self.head = self.head + 1'i32
  if self.head >= 64'i32:
    self.head = 0'i32
  self.samples[int(self.head)] = Sample(y: y, yRot: yRot)

proc get*(self: DragonFlightHistory; offset: int32): Sample =
  if self.head < 0'i32:
    return Sample(y: 0.0, yRot: 0.0'f32)
  var index = (self.head - offset) and 63'i32
  if index < 0'i32:
    index = index + 64'i32
  self.samples[int(index)]
