## Port of pumpkin/src/entity/boss/ender_dragon/phase/charging.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newChargingPhase*(): Phase =
  result = newPhase(edpCharging)
  result.getFlySpeed = 3.0'f32
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let entity = dragon.mobEntity.livingEntity.entity
    let world = entity.world
    let pos = entity.pos

    let origin = dragon.fightOrigin
    var targetPos = Vector3[float64](x: float64(origin.x), y: float64(NodeY) - 20.0, z: float64(origin.z))
    if dragon.targetPlayer.isSome:
      for player in world.players:
        if player.gameprofile.id == dragon.targetPlayer.unsafeGet:
          targetPos = playerBase(player).entity.pos
          break

    if pos.distanceSquared(targetPos) < 25.0:
      dragon.setPhase(edpHovering)
      return

    dragon.targetLocation = some(targetPos)
