## Port of pumpkin/src/entity/boss/ender_dragon/phase/circling.rs

import std/options
import ../../../ai/aibase
import ../dragonbase
import ../../../../../world/chunkdata

proc newCirclingPhase*(): Phase =
  result = newPhase(edpCircling)
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let entity = dragon.mobEntity.livingEntity.entity
    let pos = entity.pos

    let d0 = if dragon.targetLocation.isSome: pos.distanceSquared(dragon.targetLocation.unsafeGet) else: 0.0

    if dragon.targetLocation.isNone or d0 < 100.0 or d0 > 22500.0 or entity.horizontalCollision:
      if dragon.path.len == 0:
        let i = dragon.findClosestNode()
        var j = int32(i)

        if randomRange(0'i32, 8'i32) == 0'i32:
          dragon.holdingPatternClockwise = not dragon.holdingPatternClockwise
          j = int32(i) + 6'i32
        if dragon.holdingPatternClockwise:
          j = j + 1'i32
        else:
          j = j - 1'i32

        let fight = dragonFightOf(entity.world)
        let crystalsAlive = fight != nil and fight.aliveCrystals() > 0'i32

        # `rem_euclid`
        let j2 =
          if crystalsAlive: int(((j mod 12'i32) + 12'i32) mod 12'i32)
          else: int((((j - 12'i32) mod 8'i32) + 8'i32) mod 8'i32) + 12

        dragon.path = findPath(dragon.nodes, i, j2, none[DragonNode]())

      dragon.nextPathTarget()

    if randomRange(0'i32, 64'i32) == 0'i32:
      if randomBool():
        dragon.setPhase(edpFlyToPortal)
      else:
        let player = dragon.findNearestPlayer()
        if player != nil:
          dragon.targetPlayer = some(player.gameprofile.id)
          dragon.setPhase(edpStrafing)
