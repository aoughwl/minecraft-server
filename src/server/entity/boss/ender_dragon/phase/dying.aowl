## Port of pumpkin/src/entity/boss/ender_dragon/phase/dying.rs

import std/options
import ../../../ai/aibase
import ../dragonbase
import ../../../../../generated/[particle, sound, sound_category]

proc newDyingPhase*(): Phase =
  result = newPhase(edpDying)
  result.begin = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.targetLocation = none[Vector3[float64]]()
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.dragonDeathTime = dragon.dragonDeathTime + 1'i32
    let t = dragon.dragonDeathTime

    let entity = dragon.mobEntity.livingEntity.entity
    let world = entity.world

    if t == 1'i32:
      world.playSound(sdEntityEnderDragonDeath, scHostile, entity.pos)

    if t >= 180'i32 and t <= 200'i32:
      let xo = (randomF32() - 0.5'f32) * 8.0'f32
      let yo = (randomF32() - 0.5'f32) * 4.0'f32
      let zo = (randomF32() - 0.5'f32) * 8.0'f32
      let pos = entity.pos
      world.spawnParticle(Vector3[float64](x: pos.x + float64(xo), y: pos.y + 2.0 + float64(yo), z: pos.z + float64(zo)),
        Vector3[float64](x: 0.0, y: 0.0, z: 0.0), 0.0'f32, 1'i32, ptExplosionEmitter)

    let fight = dragonFightOf(world)
    let xpCount = if fight != nil and not fight.hasPreviouslyKilledDragon(): 12000'i32 else: 500'i32

    if t > 150'i32 and t mod 5'i32 == 0'i32:
      gSpawnExperienceOrb(world, entity.pos, uint32(float32(xpCount) * 0.08'f32))

    entity.velocity = Vector3[float64](x: 0.0, y: 0.1, z: 0.0)

    if t >= DeathTimerMax:
      gSpawnExperienceOrb(world, entity.pos, uint32(float32(xpCount) * 0.2'f32))

      if fight != nil:
        fight.setDragonKilled(world, entity.entityUuid)
      for part in dragon.parts:
        part.entity.remove()
      entity.remove()
