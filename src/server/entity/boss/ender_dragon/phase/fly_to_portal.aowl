## Port of pumpkin/src/entity/boss/ender_dragon/phase/fly_to_portal.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newFlyToPortalPhase*(): Phase =
  result = newPhase(edpFlyToPortal)
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let origin = dragon.fightOrigin
    let target = Vector3[float64](x: float64(origin.x), y: float64(origin.y) + 10.0, z: float64(origin.z))
    let pos = dragon.mobEntity.livingEntity.entity.pos

    if pos.distanceSquared(target) < 4.0:
      dragon.setPhase(edpLandingApproach)
      return

    dragon.targetLocation = some(target)
