## Port of pumpkin/src/entity/boss/ender_dragon/phase/hovering.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newHoveringPhase*(): Phase =
  result = newPhase(edpHovering)
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let origin = dragon.fightOrigin
    let target = Vector3[float64](x: float64(origin.x), y: float64(NodeY) + 10.0, z: float64(origin.z))

    if randomF64() < 0.01:
      dragon.setPhase(edpTakingOff)
      return

    dragon.targetLocation = some(target)
