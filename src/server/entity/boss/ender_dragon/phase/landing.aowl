## Port of pumpkin/src/entity/boss/ender_dragon/phase/landing.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newLandingPhase*(): Phase =
  result = newPhase(edpLanding)
  result.begin = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.targetLocation = none[Vector3[float64]]()
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.setPhase(edpSitAttacking)
    dragon.ticksSitting = 0'i32
    dragon.sitAttackTimer = 0'i32
