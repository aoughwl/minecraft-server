## Port of pumpkin/src/entity/boss/ender_dragon/phase/landing_approach.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newLandingApproachPhase*(): Phase =
  result = newPhase(edpLandingApproach)
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let origin = dragon.fightOrigin
    let target = Vector3[float64](x: float64(origin.x), y: float64(origin.y), z: float64(origin.z))
    let pos = dragon.mobEntity.livingEntity.entity.pos

    if pos.distanceSquared(target) < 1.0:
      dragon.setPhase(edpLanding)
      return

    dragon.targetLocation = some(target)
