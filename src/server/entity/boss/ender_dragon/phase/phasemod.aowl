## Port of pumpkin/src/entity/boss/ender_dragon/phase/mod.rs
##
## `Phase`, `EnderDragonPhase` and `PhaseManager` are in ../dragonbase.aowl: see its header.

import ../dragonbase
import circling, strafing, charging, fly_to_portal, landing_approach, landing, sit_attacking, sit_breathing, taking_off, hovering, dying

proc newPhaseManager*(): PhaseManager =
  ## The order is `EnderDragonPhase`'s, which `get_phase` indexes by.
  PhaseManager(phases: @[
    newCirclingPhase(),
    newStrafingPhase(),
    newChargingPhase(),
    newFlyToPortalPhase(),
    newLandingApproachPhase(),
    newLandingPhase(),
    newSitAttackingPhase(),
    newSitBreathingPhase(),
    newTakingOffPhase(),
    newHoveringPhase(),
    newDyingPhase()])
