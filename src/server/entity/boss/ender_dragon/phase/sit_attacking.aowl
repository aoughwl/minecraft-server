## Port of pumpkin/src/entity/boss/ender_dragon/phase/sit_attacking.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newSitAttackingPhase*(): Phase =
  result = newPhase(edpSitAttacking)
  result.begin = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.targetLocation = none[Vector3[float64]]()
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.sitAttackTimer = dragon.sitAttackTimer + 1'i32

    if dragon.sitAttackTimer > 40'i32:
      dragon.sitAttackTimer = 0'i32
      let shouldBreathe = randomBool()
      let shouldTakeOff = dragon.ticksSitting > 200'i32

      if shouldBreathe:
        dragon.setPhase(edpSitBreathing)
        dragon.breathingTimer = 0'i32
      elif shouldTakeOff:
        dragon.setPhase(edpTakingOff)

    if dragon.sittingDamageReceived > 150.0'f32:
      dragon.sittingDamageReceived = 0.0'f32
      dragon.setPhase(edpTakingOff)
