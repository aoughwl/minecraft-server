## Port of pumpkin/src/entity/boss/ender_dragon/phase/sit_breathing.rs

import std/options
import ../../../ai/aibase
import ../dragonbase
import std/math

proc newSitBreathingPhase*(): Phase =
  result = newPhase(edpSitBreathing)
  result.begin = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.targetLocation = none[Vector3[float64]]()
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.breathingTimer = dragon.breathingTimer + 1'i32

    if dragon.breathingTimer > 100'i32:
      dragon.breathingTimer = 0'i32
      dragon.setPhase(edpSitAttacking)
      return

    if dragon.breathingTimer == 1'i32:
      let entity = dragon.mobEntity.livingEntity.entity
      let pos = entity.pos
      let yaw = float64(toRadiansF32(entity.yaw))

      # Spawn the lingering cloud at the dragon's head position
      let offset = Vector3[float64](x: -sin(yaw) * 2.0, y: 0.5, z: cos(yaw) * 2.0)
      let cloudPos = pos.add(offset)

      spawnDragonBreathCloud(entity.world, cloudPos)
