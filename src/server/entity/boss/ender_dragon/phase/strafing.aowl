## Port of pumpkin/src/entity/boss/ender_dragon/phase/strafing.rs

import std/options
import ../../../ai/aibase
import ../dragonbase
import std/math

proc newStrafingPhase*(): Phase =
  result = newPhase(edpStrafing)
  result.begin = proc(dragon: EnderDragonEntity) {.closure.} =
    dragon.fireballCharge = 0'i32
    dragon.targetLocation = none[Vector3[float64]]()
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let entity = dragon.mobEntity.livingEntity.entity
    let world = entity.world
    let pos = entity.pos

    var player: nil Player = nil
    if dragon.targetPlayer.isSome:
      for candidate in world.players:
        if candidate.gameprofile.id == dragon.targetPlayer.unsafeGet:
          player = candidate
          break

    if player == nil:
      dragon.setPhase(edpCircling)
      return

    let playerPos = playerBase(player).entity.pos

    if dragon.path.len == 0:
      let d2 = playerPos.x - pos.x
      let d3 = playerPos.z - pos.z
      let d4 = hypot(d2, d3)
      let d5 = clamp(0.4 + d4 / 80.0 - 1.0, 0.0, 10.0)
      dragon.targetLocation = some(Vector3[float64](x: playerPos.x, y: playerPos.y + d5, z: playerPos.z))

    let d11 = if dragon.targetLocation.isSome: pos.distanceSquared(dragon.targetLocation.unsafeGet) else: 0.0
    if d11 < 100.0 or d11 > 22500.0 or entity.horizontalCollision:
      if dragon.path.len == 0:
        let i = dragon.findClosestNode()
        let j = dragon.findClosestNodeTo(playerPos)
        dragon.path = findPath(dragon.nodes, i, j, none[DragonNode]())

      dragon.nextPathTarget()

    if playerPos.distanceSquared(pos) < 4096.0:
      let aimDiff = playerPos - pos
      let aim = if aimDiff.lengthSquared() > 1e-6: aimDiff.normalize() else: Vector3[float64](x: 0.0, y: 0.0, z: 0.0)

      let yaw = entity.yaw
      let dir = Vector3[float64](x: float64(sinF32(yaw * (3.1415927'f32 / 180.0'f32))), y: 0.0,
        z: float64(-cosF32(yaw * (3.1415927'f32 / 180.0'f32))))

      let dirNorm = if dir.lengthSquared() > 1e-6: dir.normalize() else: Vector3[float64](x: 0.0, y: 0.0, z: 0.0)

      let dotValue = float32(dirNorm.dot(aim))
      let angleDegs = toDegreesF32(arccos(dotValue)) + 0.5'f32

      dragon.fireballCharge = dragon.fireballCharge + 1'i32

      if dragon.fireballCharge >= 5'i32 and angleDegs < 10.0'f32:
        dragon.fireballCharge = 0'i32

        spawnDragonBreathCloud(world, playerPos)

        dragon.path.setLen(0)
        dragon.setPhase(edpCircling)
    else:
      if dragon.fireballCharge > 0'i32:
        dragon.fireballCharge = dragon.fireballCharge - 1'i32
