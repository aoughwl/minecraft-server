## Port of pumpkin/src/entity/boss/ender_dragon/phase/taking_off.rs

import std/options
import ../../../ai/aibase
import ../dragonbase

proc newTakingOffPhase*(): Phase =
  result = newPhase(edpTakingOff)
  result.tick = proc(dragon: EnderDragonEntity) {.closure.} =
    let origin = dragon.fightOrigin
    let target = Vector3[float64](x: float64(origin.x), y: float64(NodeY), z: float64(origin.z))
    let pos = dragon.mobEntity.livingEntity.entity.pos

    if pos.distanceSquared(target) < 16.0:
      dragon.setPhase(edpCircling)
      return

    dragon.targetLocation = some(target)
