## Port of pumpkin/src/entity/breath.rs
##
## serverbase.aowl's `Player` has no field for it, so whoever ticks the player holds a `BreathManager` per player. See
## `breathOf`.

import std/[math, tables]
from ../../generated/damage_type import DROWN
from ../../data/block_state import isSolid, BlockState
import ../../data/block_ext
import ../../generated/[effect, fluid, meta_data_type, tag, tracked_data]
import ../../util/math/rustnum
import ../world/chunker
import entitymod

const
  MaxAir* = 300'i32
  AirRecoveryRate* = 4'i32
  AirDepletionRate* = 1'i32
  DrowningInterval* = 20'i32
  DrowningDamage* = 2.0'f32

type
  BreathManager* = ref object
    airSupply*: int32
    drowningTick*: int32

proc newBreathManager*(): BreathManager =
  BreathManager(airSupply: MaxAir, drowningTick: 0'i32)

var gBreaths = initTable[int32, BreathManager]()

proc breathOf*(player: Player): BreathManager =
  ## The `breath_manager` field upstream's `Player` has: by entity id.
  if not gBreaths.hasKey(player.entityId):
    gBreaths[player.entityId] = newBreathManager()
  gBreaths.getOrDefault(player.entityId)

proc sendAirSupply*(self: BreathManager; player: Player) =
  ## `send_air_supply`
  let air = clamp(self.airSupply, 0'i32, MaxAir)
  playerBase(player).entity.sendMetaData(TrackedData_AIR_SUPPLY_ID, INT, newVarInt(air))

proc isEyeInWater*(player: Player): bool =
  ## `is_eye_in_water`
  let e = playerBase(player).entity
  let pos = e.pos
  let eyeY = e.getEyeY()
  let bp = BlockPos(vec: Vector3[int32](x: asI32(floor(pos.x)), y: asI32(floor(eyeY)), z: asI32(floor(pos.z))))
  let world = player.world
  let (fluid, state) = world.getFluidAndFluidState(bp)
  var inWaterFluid = hasTag(fluid.id, Fluid_MINECRAFT_WATER)
  let above = BlockPos(vec: Vector3[int32](x: bp.vec.x, y: bp.vec.y + 1'i32, z: bp.vec.z))
  if not inWaterFluid:
    let stateHere = BlockState.fromId(world.stateIdAt(bp))
    if not stateHere.isSolid:
      if hasTag(world.getFluid(above).id, Fluid_MINECRAFT_WATER):
        inWaterFluid = true
  if not inWaterFluid:
    return false
  var surfaceY: float64
  if hasTag(world.getFluid(above).id, Fluid_MINECRAFT_WATER):
    surfaceY = float64(float32(bp.vec.y) + 1.0'f32)
  else:
    var height: float32
    if state.isStill:
      height = 1.0'f32
    else:
      let lvl = int32(state.level)
      height = if lvl >= 8'i32: 1.0'f32 else: float32(clamp(8'i32 - lvl, 1'i32, 8'i32)) / 8.0'f32
    surfaceY = float64(float32(bp.vec.y) + height)
  surfaceY > eyeY

proc tick*(self: BreathManager; player: Player) =
  ## `tick`
  if player.gamemode == Creative or player.gamemode == Spectator:
    if self.airSupply != MaxAir:
      self.airSupply = MaxAir
      self.sendAirSupply(player)
    self.drowningTick = 0'i32
    return
  if not player.world.levelInfo.gameRules.drowningDamage:
    return
  let base = playerBase(player)
  if mustLiving(base).hasEffect(StatusEffect.WATER_BREATHING):
    let previous = self.airSupply
    self.airSupply = MaxAir
    if previous != MaxAir:
      self.sendAirSupply(player)
    self.drowningTick = 0'i32
    return
  if isEyeInWater(player):
    let prev = self.airSupply
    self.airSupply = prev - AirDepletionRate
    let newAir = max(prev - AirDepletionRate, 0'i32)
    if newAir != prev:
      self.airSupply = newAir
      self.sendAirSupply(player)
    if newAir <= 0'i32:
      self.drowningTick += 1'i32
      if self.drowningTick >= DrowningInterval:
        self.drowningTick = 0'i32
        discard base.damage(base, DrowningDamage, DROWN)
  else:
    let prev = self.airSupply
    let newAir = min(prev + AirRecoveryRate, MaxAir)
    if newAir != prev:
      self.airSupply = newAir
      self.sendAirSupply(player)
    self.drowningTick = 0'i32

proc reset*(self: BreathManager; player: Player) =
  ## `reset`
  self.airSupply = MaxAir
  self.sendAirSupply(player)
  self.drowningTick = 0'i32
