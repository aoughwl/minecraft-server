## The collision-provider registry (collision_providers.aowl) and its wiring points in entitymod and the projectile sweeps:
## a fake provider stops a dropped item, a zombie and an arrow; an empty registry changes nothing; ordering and several
## providers. Void world: every block is air, so any stop here comes from a provider.

import std/[assertions, options]
import "../../data/item_stack/mod"
import ../../data/block_ext
import ../../generated/item_full
import entitytype
import itementity
import mob/testworld
import mob/zombie/zombie
import projectile/arrow
import projectile/thrown
import collision_providers
import entitymod

let server = newTestServer()
let world0 = newTestWorld(server, "collprov")

# Fake providers keep their state in these globals; `handle` indexes them.
var fakeBoxes: array[4, seq[BoundingBox]]
var fakeVel: array[4, Vector3[float64]]
var queried: seq[int] = @[]   # call order, to check ordering

proc fakeQuery(handle: int; region: BoundingBox; moverId: int32; outBoxes: var seq[ProvidedBox]) {.nimcall.} =
  queried.add(handle)
  for b in fakeBoxes[handle]:
    if b.intersects(region):
      outBoxes.add(ProvidedBox(box: b, surfaceVel: fakeVel[handle]))

proc fakeVelocity(handle: int; box: BoundingBox; vel: var Vector3[float64]): bool {.nimcall.} =
  for b in fakeBoxes[handle]:
    if b.intersects(box.expand(0.0'f64, 0.1'f64, 0.0'f64)):
      vel = fakeVel[handle]
      return true
  false

proc at(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)
proc box(x0, y0, z0, x1, y1, z1: float64): BoundingBox = newBoundingBox(at(x0, y0, z0), at(x1, y1, z1))

# Precise ray hook: the stored box is only a conservative AABB, the real shape is its lower half.
proc fakeRay(handle: int; origin, delta: Vector3[float64]; tHit: var float64): bool {.nimcall.} =
  for b in fakeBoxes[handle]:
    let half = box(b.min.x, b.min.y, b.min.z, b.max.x, (b.min.y + b.max.y) * 0.5'f64, b.max.z)
    if rayBoxIntersect(origin, delta, half, tHit):
      return true
  false

proc dropItem(y: float64): ItemEntity =
  let e = newEntity(world0, at(0.5, y, 0.5), EntityType.ITEM)
  newItemEntityWithVelocity(e, newItemStack(1'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 0'u8)

proc settle(item: ItemEntity; ticks: int) =
  let base: EntityBase = item
  for i in 0 ..< ticks:
    base.tick(base, server)

proc flyArrow(y: float64): ArrowEntity =
  ## An arrow at (0, y, 0.5) flying +x at 1 block a tick for 12 ticks.
  let shooter = newEntity(world0, at(0.0, 63.0, 0.0), EntityType.ZOMBIE)
  let entity = newEntity(world0, at(0.0, y, 0.5), EntityType.ARROW)
  result = newArrowShot(entity, shooter, apAllowed)
  entity.pos = at(0.0, y, 0.5)
  entity.velocity = at(1.0, 0.0, 0.0)
  let caller: EntityBase = result
  for i in 0 ..< 12:
    caller.tick(caller, server)

# --- empty registry changes nothing ---------------------------------------------------------------------------------
block empty_registry:
  assert gCollisionProviders.len == 0
  let item = dropItem(70.0)
  settle(item, 80)
  assert item.entity.pos.y < 40.0, "no block, no provider: the item keeps falling"
  assert not item.entity.onGround
  assert isSpaceEmpty(world0, box(0.0, 60.0, 0.0, 1.0, 61.0, 1.0))
  let probe: EntityBase = newZombieEntity(newEntity(world0, at(0.0, 80.0, 0.0), EntityType.ZOMBIE))
  let (c, p) = world0.getBlockCollisions(box(-3.0, 50.0, -3.0, 3.0, 80.0, 3.0), probe)
  assert c.len == 0 and p.len == 0
  let shot = flyArrow(65.0)
  assert not shot.inGround and shot.entity.pos.x > 9.0

# --- one provider: a platform whose top is y = 61 --------------------------------------------------------------------
fakeBoxes[0] = @[box(-8.0, 60.0, -8.0, 8.0, 61.0, 8.0)]
let id0 = registerCollisionProvider(0, fakeQuery, nil, fakeVelocity)
assert id0 > 0 and gCollisionProviders.len == 1

block item_stops:
  let item = dropItem(70.0)
  settle(item, 80)
  assert abs(item.entity.pos.y - 61.0) < 1e-6, "the item rests on the platform top"
  assert item.entity.onGround
  assert item.entity.supportingBlockPos.isSome
  assert isProvidedPos(item.entity.supportingBlockPos.unsafeGet)
  assert providerIdOfPos(item.entity.supportingBlockPos.unsafeGet) == id0

block space_empty:
  assert not isSpaceEmpty(world0, box(0.0, 60.5, 0.0, 1.0, 61.5, 1.0))
  assert isSpaceEmpty(world0, box(0.0, 61.0, 0.0, 1.0, 62.0, 1.0)), "touching is not intersecting"
  assert isSpaceEmpty(world0, box(20.0, 60.5, 20.0, 21.0, 61.5, 21.0))

block velocity_at:
  fakeVel[0] = at(0.25, 0.0, 0.0)
  var v = at(0.0, 0.0, 0.0)
  assert providerVelocityAt(box(0.0, 61.0, 0.0, 0.6, 62.8, 0.6), v)
  assert v.x == 0.25
  assert not providerVelocityAt(box(20.0, 61.0, 20.0, 20.6, 62.8, 20.6), v)

block zombie_blocked:
  fakeBoxes[1] = @[box(2.0, 61.0, -8.0, 3.0, 64.0, 8.0)]   # a wall beside the platform
  let id1 = registerCollisionProvider(1, fakeQuery)
  let z = newZombieEntity(newEntity(world0, at(0.0, 61.0, 0.0), EntityType.ZOMBIE))
  let base: EntityBase = z
  let ent = z.entity
  for i in 0 ..< 20:
    ent.moveEntity(base, at(0.1, 0.0, 0.0))
  assert abs(ent.boundingBox.max.x - 2.0) < 1e-6, "stopped at the wall"
  assert ent.horizontalCollision
  assert unregisterCollisionProvider(id1)
  for i in 0 ..< 20:
    ent.moveEntity(base, at(0.1, 0.0, 0.0))
  assert ent.boundingBox.max.x > 3.0, "unregistered: free to walk through where the wall was"
  assert not unregisterCollisionProvider(id1)

block arrow_stops:
  fakeBoxes[2] = @[box(6.0, 55.0, -4.0, 7.0, 70.0, 4.0)]   # wall at x = 6 .. 7
  let id2 = registerCollisionProvider(2, fakeQuery)
  let shot = flyArrow(65.0)
  assert shot.inGround, "the arrow stuck in the provider wall"
  assert shot.entity.pos.x < 6.5 and shot.entity.pos.x > 4.9
  assert shot.lastBlockPos.isSome and isProvidedPos(shot.lastBlockPos.unsafeGet)
  assert unregisterCollisionProvider(id2)
  let shot2 = flyArrow(65.0)
  assert not shot2.inGround and shot2.entity.pos.x > 9.0

block arrow_ray_hook_precise:
  # Conservative AABB wall x 6..7, y 60..70 whose real shape is the lower half (y 60..65): the ray hook is precise, so an
  # arrow at y = 68 passes and one at y = 62 sticks.
  fakeBoxes[3] = @[box(6.0, 60.0, -4.0, 7.0, 70.0, 4.0)]
  let id3 = registerCollisionProvider(3, fakeQuery, fakeRay)
  assert flyArrow(62.5).inGround
  assert not flyArrow(68.0).inGround
  var t = 0.0'f64
  var pid = 0'i32
  assert providerRayHit(at(0.0, 62.5, 0.5), at(10.0, 0.0, 0.0), 1.0, t, pid)
  assert pid == id3 and t > 0.55 and t < 0.65
  assert not providerRayHit(at(0.0, 68.0, 0.5), at(10.0, 0.0, 0.0), 1.0, t, pid)
  assert not providerRayHit(at(0.0, 62.5, 0.5), at(10.0, 0.0, 0.0), 0.5, t, pid), "nearer hit required"
  assert unregisterCollisionProvider(id3)

block unregister_restores_motion:
  assert unregisterCollisionProvider(id0)
  assert gCollisionProviders.len == 0
  let item = dropItem(70.0)
  settle(item, 80)
  assert item.entity.pos.y < 40.0
  assert isSpaceEmpty(world0, box(0.0, 60.5, 0.0, 1.0, 61.5, 1.0))

block ordering_and_multiple:
  clearCollisionProviders()
  fakeBoxes[0] = @[box(-8.0, 60.0, -8.0, 8.0, 61.0, 8.0)]
  fakeBoxes[1] = @[box(-8.0, 60.5, -8.0, 8.0, 61.5, 8.0)]   # overlaps the first, higher top
  fakeBoxes[2] = @[]
  let a = registerCollisionProvider(0, fakeQuery, nil, nil, 5'i32)
  let b = registerCollisionProvider(1, fakeQuery, nil, nil, 1'i32)
  let c = registerCollisionProvider(2, fakeQuery, nil, nil, 5'i32)
  assert gCollisionProviders[0].id == b and gCollisionProviders[1].id == a and gCollisionProviders[2].id == c,
    "ascending order, ties by registration"
  queried.setLen(0)
  var cols: seq[BoundingBox] = @[]
  var poss: seq[(int, BlockPos)] = @[]
  appendProvidedCollisions(box(0.0, 60.0, 0.0, 1.0, 62.0, 1.0), 0'i32, cols, poss)
  assert queried == @[1, 0, 2]
  assert cols.len == 2 and poss.len == 2, "provider 2 has no box: no entry for it"
  assert poss[0][0] == 1 and poss[1][0] == 2
  assert providerIdOfPos(poss[0][1]) == b and providerIdOfPos(poss[1][1]) == a
  let item = dropItem(70.0)
  settle(item, 80)
  assert abs(item.entity.pos.y - 61.5) < 1e-6, "standing on both: the higher top wins"
  assert providerIdOfPos(item.entity.supportingBlockPos.unsafeGet) == b
  assert unregisterCollisionProvider(b)
  item.entity.velocity = at(0.0, 0.1, 0.0)
  settle(item, 60)
  assert abs(item.entity.pos.y - 61.0) < 1e-6, "removing the higher provider lowers the floor"
  clearCollisionProviders()
  assert gCollisionProviders.len == 0

