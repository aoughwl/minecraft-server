## Port of pumpkin/src/entity/combat.rs

import std/math
from ../../generated/attributes import KNOCKBACK_RESISTANCE
import ../../generated/[item, particle, sound, sound_category]
import ../../data/item_stack/categories
import "../../data/item_stack/mod"
import ../../inventory/player_inventory
import entitymod

type
  AttackType* = enum
    atKnockback, atCritical, atSweeping, atStrong, atWeak, atMaceSmash

proc newAttackType*(player: Player; attackCooldownProgress: float32): AttackType =
  ## `AttackType::new`
  let sprinting = player.sprinting
  let onGround = player.onGround
  let fallDistance = player.fallDistance
  let heldItem = player.inventory.heldItem()
  let isMace = heldItem.item.id == ITEM_MACE.id
  if isMace and not onGround and fallDistance > 1.5'f32:
    return atMaceSmash
  let sword = heldItem.isSword()
  let isStrong = attackCooldownProgress > 0.9'f32
  if sprinting and isStrong:
    return atKnockback
  if isStrong and not onGround and fallDistance > 0.0'f32:
    return atCritical
  if sword and isStrong:
    return atSweeping
  if isStrong: atStrong else: atWeak

proc knockbackAfterResistance*(strength, resistance: float64): float64 =
  ## `knockback_after_resistance`: `strength *= 1.0 - resistance`, vanilla `LivingEntity.knockback`. A resistance of 1.0
  ## (iron golem, warden, ...) cancels the knockback entirely.
  strength * (1.0'f64 - resistance)

proc handleKnockback*(attacker: Entity; victim: EntityBase; strength0: float64) =
  ## `handle_knockback`
  let living = victim.living
  let resistance = if living != nil: living.getAttributeValue(KNOCKBACK_RESISTANCE) else: 0.0'f64
  let strength = knockbackAfterResistance(strength0 * 0.5'f64, resistance)
  if strength > 0.0'f64:
    let yaw = attacker.yaw
    victim.entity.knockback(strength, float64(sinF32(toRadiansF32(yaw))), float64(-cosF32(toRadiansF32(yaw))))
  attacker.velocity = attacker.velocity.multiply(0.6'f64, 1.0'f64, 0.6'f64)

proc spawnSweepParticle*(attackerEntity: Entity; world: World; pos: Vector3[float64]) =
  ## `spawn_sweep_particle`
  let yaw = attackerEntity.yaw
  let d = -float64(sinF32(toRadiansF32(yaw)))
  let e = float64(cosF32(toRadiansF32(yaw)))
  let scale = 0.5'f64
  let bodyY = mulAdd(float64(attackerEntity.height()), scale, pos.y)
  world.spawnParticle(Vector3[float64](x: pos.x + d, y: bodyY, z: pos.z + e), Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    0.0'f32, 0'i32, ptSweepAttack)

proc playerAttackSound*(pos: Vector3[float64]; world: World; attackType: AttackType) =
  ## `player_attack_sound`
  let soundRef = case attackType
    of atKnockback: sdEntityPlayerAttackKnockback
    of atCritical: sdEntityPlayerAttackCrit
    of atSweeping: sdEntityPlayerAttackSweep
    of atStrong: sdEntityPlayerAttackStrong
    of atWeak: sdEntityPlayerAttackWeak
    of atMaceSmash: sdItemMaceSmashAir
  world.playSound(soundRef, scPlayers, pos)
