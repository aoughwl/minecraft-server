## Port of pumpkin/src/entity/decoration/armor_stand.rs
##
## Upstream calls `entity.kill(caller)` on `&Entity`: `Entity`'s own `EntityBase`, whose `get_living_entity` is `None`,
## so it is the trait default's `remove` branch. That is `entity.remove()` here.

import std/options
import "../../../data/item_stack/mod"
import ../../../data/data_component_impl/impl_base
import ../../../generated/[damage_type, item_full, particle, sound, sound_category, entity_status as entitystatusdata]
import ../../../nbt/tag as nbttag
import ../../../util/math/euler_angle
import ../../world/time
import ../../../generated/[meta_data_type, tracked_data]
import ../../../protocol/netcodec
import ../../../protocol/protobase
import ../../../protocol/varint
import ../../../protocol/java/client/play/entity_metadata
import ../entitymod

type
  ArmorStandFlags* = enum
    asfSmall = 1          ## Small armor stand Flag
    asfShowArms = 4       ## Show arms Flag
    asfHideBasePlate = 8  ## Hide base plate fLag
    asfMarker = 16        ## Marker Flag

  PackedRotation* = object
    head*: EulerAngle
    body*: EulerAngle
    leftArm*: EulerAngle
    rightArm*: EulerAngle
    leftLeg*: EulerAngle
    rightLeg*: EulerAngle

  ArmorStandEntity* = ref object of EntityBase
    livingEntity*: LivingEntity
    armorStandFlags*: uint8
    lastHitTime*: int64
    disabledSlots*: int32
    rotation*: PackedRotation

proc defaultPackedRotation*(): PackedRotation =
  PackedRotation(
    head: newEulerAngle(0.0'f32, 0.0'f32, 0.0'f32),
    body: newEulerAngle(0.0'f32, 0.0'f32, 0.0'f32),
    leftArm: newEulerAngle(-10.0'f32, 0.0'f32, -10.0'f32),
    rightArm: newEulerAngle(-15.0'f32, 0.0'f32, 10.0'f32),
    leftLeg: newEulerAngle(-1.0'f32, 0.0'f32, -1.0'f32),
    rightLeg: newEulerAngle(1.0'f32, 0.0'f32, 1.0'f32))

proc toNbtTag*(val: PackedRotation): NbtTag =
  ## `impl From<PackedRotation> for NbtTag`.
  var compound = newCompound()
  compound.put("Head", toNbtTag(val.head))
  compound.put("Body", toNbtTag(val.body))
  compound.put("LeftArm", toNbtTag(val.leftArm))
  compound.put("RightArm", toNbtTag(val.rightArm))
  compound.put("LeftLeg", toNbtTag(val.leftLeg))
  compound.put("RightLeg", toNbtTag(val.rightLeg))
  NbtTag(kind: ntkCompound, compoundVal: compound)

proc getRotation(compound: NbtCompound; key: string; default0: EulerAngle): EulerAngle =
  let (found, tagValue) = compound.get(key)
  if found: fromNbtTag(tagValue) else: default0

proc packedRotationFromNbt*(tagValue: NbtTag): PackedRotation =
  ## `impl From<NbtTag> for PackedRotation`.
  let default0 = defaultPackedRotation()
  if tagValue.kind == ntkCompound:
    let compound = tagValue.compoundVal
    PackedRotation(
      head: getRotation(compound, "Head", default0.head),
      body: getRotation(compound, "Body", default0.body),
      leftArm: getRotation(compound, "LeftArm", default0.leftArm),
      rightArm: getRotation(compound, "RightArm", default0.rightArm),
      leftLeg: getRotation(compound, "LeftLeg", default0.leftLeg),
      rightLeg: getRotation(compound, "RightLeg", default0.rightLeg))
  else:
    default0

proc sendArmorStandFlags(self: ArmorStandEntity) =
  ## The client-flags byte (index 15 up to 1.21.11): small, arms, no base plate, marker.
  self.entity.sendMetaData(TrackedData_ARMOR_STAND_FLAGS, BYTE, self.armorStandFlags)

proc sendArmorStandPose(self: ArmorStandEntity) =
  ## The six pose rotations (index 16 to 21), each three floats; to whoever `sendMetaData` would write to.
  let entity = self.entity
  let world = entity.world
  let ids = [TrackedData_TRACKER_HEAD_ROTATION, TrackedData_TRACKER_BODY_ROTATION, TrackedData_TRACKER_LEFT_ARM_ROTATION,
    TrackedData_TRACKER_RIGHT_ARM_ROTATION, TrackedData_TRACKER_LEFT_LEG_ROTATION, TrackedData_TRACKER_RIGHT_LEG_ROTATION]
  let angles = [self.rotation.head, self.rotation.body, self.rotation.leftArm, self.rotation.rightArm, self.rotation.leftLeg,
    self.rotation.rightLeg]
  for player in world.players:
    if metaWanted(entity, player):
      var buf = newNetWriter()
      for i in 0 ..< 6:
        var value = newNetWriter()
        writeF32(value, angles[i].pitch)
        writeF32(value, angles[i].yaw)
        writeF32(value, angles[i].roll)
        discard metadataOf(ids[i], ROTATION, value.buf, writeOkVoid()).write(buf, player.client.version)
      writeU8(buf, 255'u8)
      player.client.writePacketFor(CSetEntityMetadata(entityId: newVarInt(entity.entityId), metadata: buf.buf))

proc setBitField(self: ArmorStandEntity; bitField: ArmorStandFlags; value: bool) =
  let current = self.armorStandFlags
  self.armorStandFlags = if value: current or uint8(ord(bitField)) else: current and not uint8(ord(bitField))
  if self.armorStandFlags != current:
    self.sendArmorStandFlags()

proc setSmall*(self: ArmorStandEntity; small: bool) =
  self.setBitField(asfSmall, small)

proc isSmall*(self: ArmorStandEntity): bool =
  (self.armorStandFlags and uint8(ord(asfSmall))) != 0'u8

proc setShowArms*(self: ArmorStandEntity; showArms: bool) =
  self.setBitField(asfShowArms, showArms)

proc shouldShowArms*(self: ArmorStandEntity): bool =
  (self.armorStandFlags and uint8(ord(asfShowArms))) != 0'u8

proc setHideBasePlate*(self: ArmorStandEntity; hideBasePlate: bool) =
  self.setBitField(asfHideBasePlate, hideBasePlate)

proc shouldShowBasePlate*(self: ArmorStandEntity): bool =
  (self.armorStandFlags and uint8(ord(asfHideBasePlate))) == 0'u8

proc setMarker*(self: ArmorStandEntity; marker: bool) =
  self.setBitField(asfMarker, marker)

proc isMarker*(self: ArmorStandEntity): bool =
  (self.armorStandFlags and uint8(ord(asfMarker))) != 0'u8

proc isSlotDisabled*(self: ArmorStandEntity; slot: EquipmentSlot): bool =
  let slotBit = 1'i32 shl getOffsetEntitySlotId(slot, 0'i32)
  (self.disabledSlots and slotBit) != 0'i32 or (slot.slotType() == etHand and not self.shouldShowArms())

proc canUseSlot*(self: ArmorStandEntity; slot: EquipmentSlot): bool =
  slot != esBody and slot != esSaddle and not self.isSlotDisabled(slot)

proc setSlotDisabled*(self: ArmorStandEntity; slot: EquipmentSlot; disabled: bool) =
  let slotBit = 1'i32 shl getOffsetEntitySlotId(slot, 0'i32)
  let current = self.disabledSlots
  self.disabledSlots = if disabled: current or slotBit else: current and not slotBit

proc isInvisible*(self: ArmorStandEntity): bool =
  self.entity.invisible

proc packRotation*(self: ArmorStandEntity): PackedRotation =
  self.rotation

proc unpackRotation*(self: ArmorStandEntity; packed: PackedRotation) =
  self.rotation = packed

proc onBreak(entity: Entity) =
  entity.world.playSound(sdEntityArmorStandBreak, scNeutral, entity.pos)
  # TODO upstream: Implement equipment slots and make them drop all of their stored items.

proc breakAndDropItems(self: ArmorStandEntity) =
  let entity = self.entity
  # TODO upstream: the stack should carry the custom name.
  let armorStandItem = newItemStack(1'u8, ITEM_ARMOR_STAND)
  gDropStack(entity.world, entity.blockPos, armorStandItem)
  onBreak(entity)

proc spawnBreakParticles(entity: Entity) =
  ## Spawns break particles at the armor stand's position.
  ## TODO upstream: use oak plank block particles like vanilla (requires block state data in particle system)
  let pos = entity.pos
  let width = entity.width()
  let height = entity.height()
  # Spawn particles similar to vanilla: 10 particles with offset based on entity size
  entity.world.spawnParticle(
    Vector3[float64](x: pos.x, y: pos.y + float64(height) * 0.6666, z: pos.z),
    Vector3[float64](x: float64(width / 4.0'f32), y: float64(height / 4.0'f32), z: float64(width / 4.0'f32)),
    0.05'f32, 10'i32, ptPoof)

proc blockCenterless(entity: Entity): Vector3[float64] =
  ## `entity.block_pos.load().to_f64()`
  Vector3[float64](x: float64(entity.blockPos.x), y: float64(entity.blockPos.y), z: float64(entity.blockPos.z))

proc armorStandDamage(self: EntityBase; caller: EntityBase; damageType: DamageType; source, cause: nil EntityBase): bool =
  let stand = ArmorStandEntity(self)
  let entity = self.entity
  if entity.isRemoved():
    return false

  let world = entity.world

  let mobGriefingGamerule = world.levelInfo.gameRules.mobGriefing

  if not mobGriefingGamerule and source != nil:
    if source.getPlayer() == nil:
      return false

  let bypassesInvulnerability = damageType.id == damage_type.OUT_OF_WORLD.id or damageType.id == damage_type.GENERIC_KILL.id

  if bypassesInvulnerability:
    entity.remove()
    return false

  if entity.isInvulnerableTo(damageType) or stand.isInvisible() or stand.isMarker():
    return false

  let isExplosion = damageType.id == damage_type.FIREWORKS.id or damageType.id == damage_type.EXPLOSION.id or damageType.id == damage_type.PLAYER_EXPLOSION.id or
    damageType.id == damage_type.BAD_RESPAWN_POINT.id

  if isExplosion:
    onBreak(entity)
    entity.remove()
    return false

  # TODO upstream: IGNITES_ARMOR_STANDS (in_fire, campfire) - set on fire
  # TODO upstream: BURNS_ARMOR_STANDS (on_fire) - reduce health

  let canBreak = damageType.id == damage_type.PLAYER_EXPLOSION.id or damageType.id == damage_type.PLAYER_ATTACK.id or damageType.id == damage_type.SPEAR.id or
    damageType.id == damage_type.MACE_SMASH.id

  let alwaysKills = damageType.id == damage_type.ARROW.id or damageType.id == damage_type.TRIDENT.id or damageType.id == damage_type.FIREBALL.id or
    damageType.id == damage_type.WITHER_SKULL.id or damageType.id == damage_type.WIND_CHARGE.id

  if not canBreak and not alwaysKills:
    return false

  let attacker: nil EntityBase = if cause != nil: cause else: source
  if attacker != nil:
    let player = attacker.getPlayer()
    if player != nil:
      if not player.abilities.allowModifyWorld:
        return false
      elif player.gamemode == Creative:
        spawnBreakParticles(entity)
        entity.remove()
        return true

  let time0 = world.levelTime.queryGametime()

  if time0 - stand.lastHitTime > 5'i64 and not alwaysKills:
    world.sendEntityStatus(entity, esArmorstandWobble)
    world.playSound(sdEntityArmorStandHit, scNeutral, blockCenterless(entity))
    stand.lastHitTime = time0
  else:
    spawnBreakParticles(entity)
    world.playSound(sdEntityArmorStandBreak, scNeutral, blockCenterless(entity))
    stand.breakAndDropItems()
    entity.remove()

  true

proc makeArmorStandVt(): EntityVt =
  result = copyVt(livingVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let stand = ArmorStandEntity(self)
    stand.livingEntity.writeLivingNbt(nbt)
    let disabledSlots = stand.disabledSlots
    nbt.putBool("Invisible", stand.isInvisible())
    nbt.putBool("Small", stand.isSmall())
    nbt.putBool("ShowArms", stand.shouldShowArms())
    nbt.putInt("DisabledSlots", disabledSlots)
    nbt.putBool("NoBasePlate", not stand.shouldShowBasePlate())
    if stand.isMarker():
      nbt.putBool("Marker", true)
    nbt.put("Pose", toNbtTag(stand.packRotation()))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let stand = ArmorStandEntity(self)
    stand.livingEntity.readLivingNbt(nbt)
    var flags = 0'u8

    let invisible = nbt.getBool("Invisible")
    if invisible.isSome and invisible.unsafeGet:
      self.entity.setInvisible(true)

    let small = nbt.getBool("Small")
    if small.isSome and small.unsafeGet:
      flags = flags or uint8(ord(asfSmall))

    let showArms = nbt.getBool("ShowArms")
    if showArms.isSome and showArms.unsafeGet:
      flags = flags or uint8(ord(asfShowArms))

    let disabledSlots = nbt.getInt("DisabledSlots")
    if disabledSlots.isSome:
      stand.disabledSlots = disabledSlots.unsafeGet

    # Upstream sets HideBasePlate when `NoBasePlate` is false or absent, the reverse of what it writes. Kept.
    let noBasePlate = nbt.getBool("NoBasePlate")
    if noBasePlate.isSome:
      if not noBasePlate.unsafeGet:
        flags = flags or uint8(ord(asfHideBasePlate))
    else:
      flags = flags or uint8(ord(asfHideBasePlate))

    let marker = nbt.getBool("Marker")
    if marker.isSome and marker.unsafeGet:
      flags = flags or uint8(ord(asfMarker))

    stand.armorStandFlags = flags

    let (hasPose, poseTag) = nbt.get("Pose")
    if hasPose:
      stand.unpackRotation(packedRotationFromNbt(poseTag))
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let stand = ArmorStandEntity(self)
    if stand.armorStandFlags != 0'u8:
      stand.sendArmorStandFlags()
    stand.sendArmorStandPose()
  result.kill = proc(self, caller: EntityBase) {.closure.} =
    self.entity.remove()
    # TODO upstream: emit GameEvent::ENTITY_DIE
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    armorStandDamage(self, caller, damageType, source, cause)
  result.getGravity = proc(self: EntityBase): float64 {.closure.} = 0.08

let armorStandVt = makeArmorStandVt()

proc newArmorStandEntity*(entity: Entity): ArmorStandEntity =
  let livingEntity = newLivingEntity(entity)
  result = ArmorStandEntity(livingEntity: livingEntity, armorStandFlags: 0'u8, lastHitTime: 0'i64, disabledSlots: 0'i32,
    rotation: defaultPackedRotation())
  result.initLivingBase(livingEntity, armorStandVt)
