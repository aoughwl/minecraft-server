## Known answers read from pumpkin/src/entity/decoration/*.rs. Upstream has no #[test] for these.

import std/[assertions, options]
import "../../../data/item_stack/mod"
import ../../../data/block_direction
import ../../../data/data_component_impl/impl_base
import ../../../generated/damage_type
import ../../../nbt/tag as nbttag
import ../../../util/math/euler_angle
import ../entitymod
import ../mob/testworld
import armor_stand, end_crystal, item_frame, leash_knot, painting

let server = newTestServer()
let world0 = newTestWorld(server, "decorationtest")
let noPosition = none[Vector3[float64]]()

proc entityOf(entityType: EntityType): Entity =
  newEntity(world0, pos3(0.5, 80.0, 0.5), entityType)

block painting_nbt:
  let p = newPaintingEntity(entityOf(EntityType.PAINTING))
  spawnEntity(world0, asBase(p))
  let base = asBase(p)
  # An absent "facing" defaults to 3.
  base.readNbt(entityNbt(p.entity))
  assert p.entity.data == 3'i32
  p.entity.data = 2'i32
  var nbt = newCompound()
  base.writeNbt(nbt)
  assert nbt.getByte("facing") == some(2'i8)
  assert base.getLivingEntity() == nil
  assert base.damageWithContext(base, 1.0'f32, GENERIC, noPosition, nil, nil)
  assert isGone(p.entity)

block end_crystal_damage:
  let c = newEndCrystalEntity(entityOf(EntityType.END_CRYSTAL))
  spawnEntity(world0, asBase(c))
  let base = asBase(c)
  # An explosion only removes it; the explosive path is covered by src/server/world0/explosiontest.aowl.
  assert base.damageWithContext(base, 1.0'f32, EXPLOSION, noPosition, nil, nil)
  assert isGone(c.entity)

block item_frame_state:
  let f = newItemFrameEntity(entityOf(EntityType.ITEM_FRAME))
  spawnEntity(world0, asBase(f))
  let base = asBase(f)
  # The spawn packet's data agrees with facing, South = 3.
  assert f.facing == 3'u8
  assert f.entity.data == 3'i32
  assert f.getFacing() == BlockDirection.South
  assert f.itemDropChance == 1.0'f32
  assert f.getAnalogOutput() == 0'u8, "empty"
  f.itemStack = newItemStack(1'u8, ITEM_STICK)
  f.rotation = 7'u8
  assert f.getAnalogOutput() == 8'u8
  f.rotation = 0'u8
  assert f.getAnalogOutput() == 1'u8

  # Values read back are reduced: rotation % 8, facing % 6, and facing goes to `data`.
  var nbt = entityNbt(f.entity)
  nbt.putByte("ItemRotation", 9'i8)
  nbt.putByte("Facing", 8'i8)
  nbt.putBool("Invisible", true)
  nbt.putFloat("ItemDropChance", 0.25'f32)
  base.readNbt(nbt)
  assert f.rotation == 1'u8
  assert f.facing == 2'u8
  assert f.entity.data == 2'i32
  assert f.getFacing() == BlockDirection.North
  assert f.invisible
  assert not f.fixed
  assert f.itemDropChance == 0.25'f32

  var written = newCompound()
  base.writeNbt(written)
  assert written.getByte("ItemRotation") == some(1'i8)
  assert written.getByte("Facing") == some(2'i8)
  assert written.getBool("Invisible") == some(true)
  assert written.getBool("Fixed") == some(false)
  assert written.getCompound("Item").isSome
  assert written.getFloat("ItemDropChance") == some(0.25'f32)

  # An empty frame writes no item and no chance, and reading absent keys falls back.
  let e = newItemFrameEntity(entityOf(EntityType.ITEM_FRAME))
  spawnEntity(world0, asBase(e))
  var emptyNbt = newCompound()
  EntityBase(e).writeNbt(emptyNbt)
  assert emptyNbt.getCompound("Item").isNone
  assert emptyNbt.getFloat("ItemDropChance").isNone
  EntityBase(e).readNbt(entityNbt(e.entity))
  assert e.facing == 0'u8, "unlike `new`, an absent Facing reads as 0"

  assert base.damageWithContext(base, 1.0'f32, GENERIC, noPosition, nil, nil)
  assert isGone(f.entity)

block armor_stand_flags:
  let s = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(s))
  assert not s.isSmall()
  assert not s.shouldShowArms()
  assert s.shouldShowBasePlate()
  assert not s.isMarker()
  s.setSmall(true)
  s.setShowArms(true)
  s.setHideBasePlate(true)
  s.setMarker(true)
  assert s.armorStandFlags == 29'u8
  assert not s.shouldShowBasePlate()
  s.setSmall(false)
  assert s.armorStandFlags == 28'u8

block armor_stand_slots:
  let s = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(s))
  # A hand needs arms shown; body and saddle are never usable.
  assert not s.canUseSlot(esMainHand)
  assert s.canUseSlot(esHead)
  assert not s.canUseSlot(esBody)
  assert not s.canUseSlot(esSaddle)
  s.setShowArms(true)
  assert s.canUseSlot(esMainHand)
  s.setSlotDisabled(esHead, true)
  assert s.isSlotDisabled(esHead)
  assert s.disabledSlots == (1'i32 shl getOffsetEntitySlotId(esHead, 0'i32))
  s.setSlotDisabled(esHead, false)
  assert s.disabledSlots == 0'i32

block armor_stand_rotation:
  let d = defaultPackedRotation()
  assert d.leftArm == newEulerAngle(-10.0'f32, 0.0'f32, -10.0'f32)
  assert d.rightArm == newEulerAngle(-15.0'f32, 0.0'f32, 10.0'f32)
  assert d.leftLeg == newEulerAngle(-1.0'f32, 0.0'f32, -1.0'f32)
  assert d.rightLeg == newEulerAngle(1.0'f32, 0.0'f32, 1.0'f32)

  var rotated = d
  rotated.head = newEulerAngle(5.0'f32, 6.0'f32, 7.0'f32)
  let back = packedRotationFromNbt(toNbtTag(rotated))
  assert back.head == rotated.head
  assert back.rightLeg == rotated.rightLeg

  # A missing key falls back to the default, and a non-compound gives the whole default.
  var partial = newCompound()
  partial.put("Head", toNbtTag(newEulerAngle(1.0'f32, 2.0'f32, 3.0'f32)))
  let fromPartial = packedRotationFromNbt(NbtTag(kind: ntkCompound, compoundVal: partial))
  assert fromPartial.head == newEulerAngle(1.0'f32, 2.0'f32, 3.0'f32)
  assert fromPartial.leftArm == d.leftArm
  assert packedRotationFromNbt(NbtTag(kind: ntkInt, intVal: 1'i32)).leftArm == d.leftArm

block armor_stand_nbt:
  let s = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(s))
  let base = asBase(s)
  s.setSmall(true)
  s.setMarker(true)
  s.disabledSlots = 5'i32
  var nbt = newCompound()
  base.writeNbt(nbt)
  assert nbt.getBool("Small") == some(true)
  assert nbt.getBool("ShowArms") == some(false)
  assert nbt.getInt("DisabledSlots") == some(5'i32)
  assert nbt.getBool("NoBasePlate") == some(false)
  assert nbt.getBool("Marker") == some(true)
  assert nbt.getCompound("Pose").isSome

  let t = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(t))
  EntityBase(t).readNbt(nbt)
  assert t.isSmall()
  assert t.isMarker()
  assert t.disabledSlots == 5'i32
  # Upstream's read: `NoBasePlate` false sets HideBasePlate, so a written default comes back hidden.
  assert not t.shouldShowBasePlate()

block armor_stand_damage:
  # The bypass types kill and answer false.
  let a = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(a))
  assert not EntityBase(a).damageWithContext(a, 1.0'f32, OUT_OF_WORLD, noPosition, nil, nil)
  assert isGone(a.entity)

  # Explosions kill and answer false.
  let b = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(b))
  assert not EntityBase(b).damageWithContext(b, 1.0'f32, EXPLOSION, noPosition, nil, nil)
  assert isGone(b.entity)

  # A marker takes nothing.
  let c = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(c))
  c.setMarker(true)
  assert not EntityBase(c).damageWithContext(c, 1.0'f32, damage_type.ARROW, noPosition, nil, nil)
  assert not isGone(c.entity)

  # Neither can_break nor always_kills: nothing happens.
  let d = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(d))
  assert not EntityBase(d).damageWithContext(d, 1.0'f32, FALL, noPosition, nil, nil)
  assert not isGone(d.entity)

  # always_kills breaks at once and drops the stand.
  let before = dropped.len
  let e = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(e))
  assert EntityBase(e).damageWithContext(e, 1.0'f32, damage_type.ARROW, noPosition, nil, nil)
  assert isGone(e.entity)
  assert dropped.len == before + 1
  assert dropped[before].item.id == ITEM_ARMOR_STAND.id

  # A first player attack wobbles; a second within 5 ticks breaks. A world0 at time 0 starts inside the window.
  world0.levelTime.worldAge = 100'i64
  let f = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(f))
  assert EntityBase(f).damageWithContext(f, 1.0'f32, PLAYER_ATTACK, noPosition, nil, nil)
  assert not isGone(f.entity)
  assert f.lastHitTime == 100'i64
  world0.levelTime.worldAge = 103'i64
  assert EntityBase(f).damageWithContext(f, 1.0'f32, PLAYER_ATTACK, noPosition, nil, nil)
  assert isGone(f.entity)

  # kill removes outright.
  let g = newArmorStandEntity(entityOf(EntityType.ARMOR_STAND))
  spawnEntity(world0, asBase(g))
  EntityBase(g).kill(g)
  assert isGone(g.entity)

  # Gravity as upstream declares it.
  assert EntityBase(g).getGravity() == 0.08

block leash_knot_lifecycle:
  let pos = newBlockPos(3'i32, 70'i32, 4'i32)
  let knot = createKnot(world0, pos)
  assert knot.blockPos() == pos
  assert knot.entity.pos == pos3(3.5, 70.375, 4.5)
  # Upstream's downcast never matches, so the knot just spawned is not found and another is made.
  assert getKnot(world0, pos) == nil
  let second = getOrCreate(world0, pos)
  assert second.entity.entityId != knot.entity.entityId

  # Not on a fence (void air here): the first tick unleashes what it holds, drops the lead, and removes the knot.
  let heldBase = entityBaseOf(newEntity(world0, pos3(3.5, 70.0, 4.5), EntityType.ZOMBIE))
  spawnEntity(world0, heldBase)
  let holder = asBase(knot)
  heldBase.entity.leashTo(holder)
  let before = dropped.len
  holder.tick(holder, server)
  assert heldBase.entity.leashedTo == nil
  assert dropped.len == before + 1
  assert dropped[before].item.id == ITEM_LEAD.id
  assert isGone(knot.entity)
