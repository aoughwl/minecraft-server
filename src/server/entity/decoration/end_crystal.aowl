## Port of pumpkin/src/entity/decoration/end_crystal.rs

import std/options
import ../../../generated/[tag, tracked_data, meta_data_type]
import ../../world/explosion
import ../entitymod

type
  EndCrystalEntity* = ref object of EntityBase

proc setShowBottom*(self: EndCrystalEntity; showBottom: bool) =
  self.entity.sendMetaData(TrackedData_SHOW_BOTTOM, BOOLEAN, showBottom)

proc makeEndCrystalVt(): EntityVt =
  result = copyVt(entityVt())
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    self.entity.remove()
    if not hasTag(uint16(damageType.id), DamageType_MINECRAFT_IS_EXPLOSION):
      self.entity.world.explode(self.entity.pos, 6.0'f32)
    # TODO upstream
    true

let endCrystalVt = makeEndCrystalVt()

proc newEndCrystalEntity*(entity: Entity): EndCrystalEntity =
  result = EndCrystalEntity()
  result.initEntityBase(entity, endCrystalVt)
