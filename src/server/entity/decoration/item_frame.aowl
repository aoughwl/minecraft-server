## Port of pumpkin/src/entity/decoration/item_frame.rs

import std/options
import "../../../data/item_stack/mod"
import ../../../data/block_direction
import ../../../nbt/tag as nbttag
import ../entitymod

const DefaultFacing* = BlockDirection.South  ## `DEFAULT_FACING`: used when a frame is created without NBT, matching vanilla.

type
  ItemFrameEntity* = ref object of EntityBase
    ## An item frame or glow item frame.
    ##
    ## Holds the displayed item and its rotation so that comparators can read the frame's analog output and so frames
    ## from vanilla worlds keep their data across save cycles.
    itemStack*: ItemStack
    rotation*: uint8          ## Rotation of the displayed item, always in `0..8`.
    facing*: uint8            ## The vanilla 3D direction index: 0 down, 1 up, 2 north, 3 south, 4 west, 5 east.
    itemDropChance*: float32
    invisible*: bool
    fixed*: bool

proc getFacing*(self: ItemFrameEntity): BlockDirection =
  let (found, direction) = fromIndex(BlockDirection, self.facing)
  if found: direction else: DefaultFacing

proc getAnalogOutput*(self: ItemFrameEntity): uint8 =
  ## The comparator signal this frame produces.
  ## Vanilla: `getItem().isEmpty() ? 0 : getRotation() % 8 + 1`.
  if self.itemStack.isEmpty():
    0'u8
  else:
    self.rotation mod 8'u8 + 1'u8

proc makeItemFrameVt(): EntityVt =
  result = copyVt(entityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let frame = ItemFrameEntity(self)
    self.entity.writeEntityNbt(nbt)
    if not frame.itemStack.isEmpty():
      var itemCompound = newCompound()
      frame.itemStack.writeItemStack(itemCompound)
      nbt.putCompound("Item", itemCompound)
      nbt.putFloat("ItemDropChance", frame.itemDropChance)
    nbt.putByte("ItemRotation", cast[int8](frame.rotation))
    nbt.putByte("Facing", cast[int8](frame.facing))
    nbt.putBool("Invisible", frame.invisible)
    nbt.putBool("Fixed", frame.fixed)
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let frame = ItemFrameEntity(self)
    self.entity.readEntityNbt(nbt)
    let itemCompound = nbt.getCompound("Item")
    if itemCompound.isSome:
      let stack = readItemStack(itemCompound.unsafeGet)
      if stack.isSome:
        frame.itemStack = stack.unsafeGet
    let rotation = nbt.getByte("ItemRotation")
    frame.rotation = (if rotation.isSome: cast[uint8](rotation.unsafeGet) else: 0'u8) mod 8'u8
    let facing = nbt.getByte("Facing")
    let facingValue = (if facing.isSome: cast[uint8](facing.unsafeGet) else: 0'u8) mod 6'u8
    frame.facing = facingValue
    # The spawn packet's data field carries the frame's direction.
    self.entity.data = int32(facingValue)
    let chance = nbt.getFloat("ItemDropChance")
    frame.itemDropChance = if chance.isSome: chance.unsafeGet else: 1.0'f32
    let invisible = nbt.getBool("Invisible")
    frame.invisible = invisible.isSome and invisible.unsafeGet
    let fixed = nbt.getBool("Fixed")
    frame.fixed = fixed.isSome and fixed.unsafeGet
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    # TODO upstream: vanilla pops the displayed item first and only removes the
    # frame itself when hit while empty; both should drop their items.
    self.entity.remove()
    true

let itemFrameVt = makeItemFrameVt()

proc newItemFrameEntity*(entity: Entity): ItemFrameEntity =
  let facing = toIndex(DefaultFacing)
  # The spawn packet reads the direction from the entity data field, so
  # it has to agree with `facing` or the frame spawns facing elsewhere.
  entity.data = int32(facing)
  result = ItemFrameEntity(itemStack: emptyItemStack(), rotation: 0'u8, facing: facing, itemDropChance: 1.0'f32,
    invisible: false, fixed: false)
  result.initEntityBase(entity, itemFrameVt)
