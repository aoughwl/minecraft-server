## Port of pumpkin/src/entity/decoration/leash_knot.rs
##
## Upstream's `get_knot` downcasts `cast_any()` to `Arc<Self>`, a type the entity never has (the `dyn Any` is `Self`), so it
## never finds a knot: `get_or_create` always makes a new one and `interact` never moves a player's leashed mobs onto this
## knot. That is kept: `DowncastToArcSucceeds` is the one place to change once upstream does.

import std/options
import "../../../data/item_stack/mod"
import ../../../generated/[item_full, sound, sound_category, tag]
import ../entitymod
import ../mob/mobvts

const
  OffsetY* = 0.375'f64  ## `OFFSET_Y`
  DowncastToArcSucceeds = false

type
  LeashKnotEntity* = ref object of EntityBase
    pos*: BlockPos

proc newLeashKnotEntity*(entity: Entity; pos: BlockPos): LeashKnotEntity

proc blockPos*(self: LeashKnotEntity): BlockPos =
  self.pos

proc searchBox(center: Vector3[float64]; width, height, eyeHeight: float32): BoundingBox =
  newFromPos(BoundingBox, center.x, center.y, center.z,
    EntityDimensions(width: width, height: height, eyeHeight: eyeHeight))

proc getKnot*(world: World; pos: BlockPos): nil LeashKnotEntity =
  let center = Vector3[float64](x: float64(pos.x) + 0.5, y: float64(pos.y) + OffsetY, z: float64(pos.z) + 0.5)
  let box = searchBox(center, 2.0'f32, 2.0'f32, 1.0'f32)
  let found = getEntitiesAtBox(world, box)
  for i in 0 ..< found.len:
    let entityBase: EntityBase = found[i]
    if DowncastToArcSucceeds and entityBase.entity.entityType.id == EntityType.LEASH_KNOT.id and
        entityBase of LeashKnotEntity:
      let knot = LeashKnotEntity(entityBase)
      if knot.pos == pos:
        return knot
  nil

proc createKnot*(world: World; pos: BlockPos): LeashKnotEntity =
  let rawPos = Vector3[float64](x: float64(pos.x) + 0.5, y: float64(pos.y) + OffsetY, z: float64(pos.z) + 0.5)
  let entity = newEntity(world, rawPos, EntityType.LEASH_KNOT)
  let knot = newLeashKnotEntity(entity, pos)
  let base = asBase(knot)
  spawnEntity(world, base)
  world.playSound(sdItemLeadTied, scNeutral, rawPos)
  knot

proc getOrCreate*(world: World; pos: BlockPos): LeashKnotEntity =
  let existing = getKnot(world, pos)
  if existing != nil:
    return existing
  createKnot(world, pos)

proc playPlacementSound*(self: LeashKnotEntity; world: World) =
  world.playSound(sdItemLeadTied, scNeutral, self.entity.pos)

proc isLeashedTo(entity: Entity; id: int32): bool =
  let holder = entity.leashedTo
  holder != nil and holder.entity.entityId == id

proc makeLeashKnotVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let knot = LeashKnotEntity(self)
    let world = self.entity.world
    let block0 = world.getBlock(knot.pos)
    if not hasTag(uint16(block0.id), Block_MINECRAFT_FENCES):
      let knotId = self.entity.entityId
      let pos = self.entity.pos
      let box = searchBox(pos, 32.0'f32, 32.0'f32, 16.0'f32)
      for entityBase in getEntitiesAtBox(world, box):
        let ent = entityBase.entity
        if isLeashedTo(ent, knotId):
          ent.unleash()
          let leadItem = newItemStack(1'u8, ITEM_LEAD)
          callDropStack(world, ent.blockPos, leadItem)
      world.playSound(sdItemLeadUntied, scNeutral, pos)
      self.entity.remove()
  result.interact = proc(self: EntityBase; player: Player; itemStack: var ItemStack): bool {.closure.} =
    let knot = LeashKnotEntity(self)
    let world = player.world
    let knotId = self.entity.entityId
    let playerId = player.entityId

    let pos = self.entity.pos
    let box = searchBox(pos, 32.0'f32, 32.0'f32, 16.0'f32)
    let entities = getEntitiesAtBox(world, box)

    var attachedMob = false
    var playerLeashedMobs: seq[Entity] = @[]

    for entityBase in entities:
      let ent = entityBase.entity
      if isLeashedTo(ent, playerId):
        playerLeashedMobs.add(ent)

    let selfKnot = getKnot(world, knot.pos)
    if selfKnot != nil:
      let holder = asBase(selfKnot)
      for mob in playerLeashedMobs:
        mob.leashTo(holder)
        attachedMob = true

    var anyDropped = false
    if not attachedMob:
      for entityBase in entities:
        let ent = entityBase.entity
        if isLeashedTo(ent, knotId):
          ent.leashTo(playerBase(player))
          anyDropped = true

    if attachedMob or anyDropped:
      knot.playPlacementSound(world)
      true
    else:
      false

let leashKnotVt = makeLeashKnotVt()

proc newLeashKnotEntity*(entity: Entity; pos: BlockPos): LeashKnotEntity =
  result = LeashKnotEntity(pos: pos)
  result.initEntityBase(entity, leashKnotVt)
