## Port of pumpkin/src/entity/decoration/painting.rs

import std/options
import ../../../nbt/tag as nbttag
import ../entitymod

type
  PaintingEntity* = ref object of EntityBase

proc makePaintingVt(): EntityVt =
  result = copyVt(entityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    self.entity.writeEntityNbt(nbt)
    nbt.putByte("facing", int8(self.entity.data))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    self.entity.readEntityNbt(nbt)
    let facing = nbt.getByte("facing")
    self.entity.data = if facing.isSome: int32(facing.unsafeGet) else: 3'i32
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    # TODO upstream
    self.entity.remove()
    true

let paintingVt = makePaintingVt()

proc newPaintingEntity*(entity: Entity): PaintingEntity =
  result = PaintingEntity()
  result.initEntityBase(entity, paintingVt)
