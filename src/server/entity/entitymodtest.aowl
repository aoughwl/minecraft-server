## entitymod.aowl, combat.aowl, attributes and the top-level entities: upstream's #[test] vectors from entity/mod.rs,
## living.rs and combat.rs, and known answers worked from the Rust for movement, damage and knockback.

import std/[assertions, cmdline, math, options, syncio]
import "../../data/item_stack/mod"
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../generated/[effect, sound]
from ../../generated/attributes import MAX_HEALTH, ARMOR
import ../../generated/entity_status as status
import ../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../data/datamod
import ../recipe
import ../scheduler
import ../tick_rate_manager
import combat
import experienceorb, falling, itementity, tnt, entitytype, hunger
import predicate as entitypredicate
import projectile_deflection
import entitymod

proc near(a, b: float64): bool = abs(a - b) < 1e-12
proc nearF(a, b: float32): bool = abs(a - b) < 1e-5'f32

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/entitymod_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)

proc stateOf(b: Block): uint32 = uint32(asU16(b.defaultState.id))

# A floor of stone at y=63 over a few chunks. Chunk (5, 5) stays unloaded: void air.
for cx in -1'i32 .. 1'i32:
  for cz in -1'i32 .. 1'i32:
    addLoadedChunk(theLevel, newChunkData(cx, cz, newChunkSections(24, -64'i32)))
    for x in 0'i32 .. 15'i32:
      for z in 0'i32 .. 15'i32:
        discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: cx * 16'i32 + x, y: 63'i32, z: cz * 16'i32 + z)),
          stateOf(blockStone()))

proc at(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)

proc living(t: EntityType; p: Vector3[float64]): EntityBase =
  livingBaseOf(newLivingEntity(newEntity(testWorld, p, t)))

# --- #[test] in entity/mod.rs ----------------------------------------------------------------------------------------------------------

block equipment_break_status_maps_all_slots:
  # Status bytes from vanilla EntityEvent: mainhand=47, offhand=48, head=49, chest=50, legs=51, feet=52, body=65, saddle=68.
  assert ord(equipmentBreakStatus(esMainHand)) == 47
  assert ord(equipmentBreakStatus(esOffHand)) == 48
  assert ord(equipmentBreakStatus(esHead)) == 49
  assert ord(equipmentBreakStatus(esChest)) == 50
  assert ord(equipmentBreakStatus(esLegs)) == 51
  assert ord(equipmentBreakStatus(esFeet)) == 52
  assert ord(equipmentBreakStatus(esBody)) == 65
  assert ord(equipmentBreakStatus(esSaddle)) == 68

# --- #[test] in living.rs -------------------------------------------------------------------------------------------------------------

block bypasses_armor_durability_returns_true_for_tag_members:
  for dt in [ON_FIRE, IN_WALL, CRAMMING, DROWN, FLY_INTO_WALL, GENERIC, damage_type.WITHER, DRAGON_BREATH, STARVE, FALL,
      damage_type.ENDER_PEARL, FREEZE, STALAGMITE, MAGIC, INDIRECT_MAGIC, OUT_OF_WORLD, GENERIC_KILL, SONIC_BOOM, OUTSIDE_BORDER]:
    assert bypassesArmorDurability(dt)

block bypasses_armor_durability_returns_false_for_physical_sources:
  for dt in [MOB_ATTACK, PLAYER_ATTACK, damage_type.ARROW, CACTUS, SWEET_BERRY_BUSH, damage_type.LAVA, EXPLOSION,
      PLAYER_EXPLOSION, damage_type.LIGHTNING_BOLT, damage_type.FIREBALL, THORNS, damage_type.TRIDENT]:
    assert not bypassesArmorDurability(dt)

block hurt_sound_for_entity:
  assert hurtSoundForEntity(EntityType.ZOMBIE) == sdEntityZombieHurt
  assert hurtSoundForEntity(EntityType.DROWNED) == sdEntityDrownedHurt
  assert hurtSoundForEntity(EntityType.HUSK) == sdEntityHuskHurt
  assert hurtSoundForEntity(EntityType.ZOMBIE_VILLAGER) == sdEntityZombieVillagerHurt
  assert hurtSoundForEntity(EntityType.ENDERMAN) == sdEntityEndermanHurt
  assert hurtSoundForEntity(EntityType.SKELETON) == sdEntitySkeletonHurt
  assert hurtSoundForEntity(EntityType.BOGGED) == sdEntityBoggedHurt
  assert hurtSoundForEntity(EntityType.PARCHED) == sdEntityParchedHurt
  assert hurtSoundForEntity(EntityType.WITHER_SKELETON) == sdEntityWitherSkeletonHurt
  assert hurtSoundForEntity(EntityType.STRAY) == sdEntityStrayHurt
  assert hurtSoundForEntity(EntityType.CREEPER) == sdEntityGenericHurt

# --- #[test] in combat.rs -------------------------------------------------------------------------------------------------------------

block knockback_resistance:
  assert knockbackAfterResistance(0.4'f64, 0.0'f64) == 0.4'f64
  assert knockbackAfterResistance(0.4'f64, 1.0'f64) == 0.0'f64
  assert abs(knockbackAfterResistance(0.4'f64, 0.75'f64) - 0.1'f64) < 1e-9'f64
  assert knockbackAfterResistance(0.4'f64, 1.2'f64) < 0.0'f64

# --- Known answers ----------------------------------------------------------------------------------------------------------------------

block removal_reason:
  assert rrKilled.shouldDestroy() and rrDiscarded.shouldDestroy() and not rrChangedDimension.shouldDestroy()
  assert rrUnloadedToChunk.shouldSave() and not rrKilled.shouldSave()

block dimensions_by_pose:
  assert getEntityDimensions(epSleeping).width == 0.2'f32
  assert getEntityDimensions(epSwimming).height == 0.6'f32
  assert getEntityDimensions(epCrouching).eyeHeight == 1.27'f32
  assert getEntityDimensions(epDying).eyeHeight == 1.62'f32
  assert getEntityDimensions(epStanding).height == 1.8'f32

block angles:
  assert angleToU8(0.0'f32) == 0'u8
  assert angleToU8(90.0'f32) == 64'u8
  assert angleToU8(-90.0'f32) == 192'u8
  assert angleToU8(450.0'f32) == 64'u8
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  # look_at: a target along +x is yaw -90, pitch 0.
  e.lookAt(at(10.5, 64.0, 0.5))
  assert nearF(e.yaw, -90.0'f32) and nearF(e.pitch, 0.0'f32)
  e.setPitch(120.0'f32)
  assert e.pitch == 90.0'f32
  e.yaw = 0.0'f32
  assert e.getHorizontalFacing() == HorizontalFacing.South
  e.yaw = 90.0'f32
  assert e.getHorizontalFacing() == HorizontalFacing.West
  e.yaw = -180.0'f32
  assert e.getHorizontalFacing() == HorizontalFacing.North
  e.yaw = 270.0'f32
  assert e.getHorizontalFacing() == HorizontalFacing.East
  e.yaw = 45.0'f32
  assert e.getRotation16() == 2'u8 and e.getFlippedRotation16() == 10'u8
  e.pitch = 0.0'f32
  e.yaw = 0.0'f32
  assert e.getFacing() == Facing.South
  e.pitch = 90.0'f32
  assert e.getFacing() == Facing.Down

block set_pos_moves_the_box_and_cell:
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  e.setPos(at(17.5, 65.25, -0.5))
  assert e.blockPos.vec.x == 17'i32 and e.blockPos.vec.y == 65'i32 and e.blockPos.vec.z == -1'i32
  assert e.chunkPos.x == 1'i32 and e.chunkPos.y == -1'i32
  assert near(e.boundingBox.min.y, 65.25'f64) and near(e.boundingBox.max.y, 65.25'f64 + float64(e.entityDimension.height))

block knockback_formula:
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  # On the ground: x = 0/2 - 0.4, y = min(0/2 + 0.4, 0.4), z = 0/2 - 0.
  e.onGround = true
  e.applyKnockback(0.4'f64, 1.0'f64, 0.0'f64)
  assert near(e.velocity.x, -0.4'f64) and near(e.velocity.y, 0.4'f64) and e.velocity.z == 0.0'f64 and e.velocityDirty
  # In the air: y is kept, x halves first.
  e.onGround = false
  e.velocity = at(0.2, -0.5, 0.0)
  e.applyKnockback(0.4'f64, 0.0'f64, 2.0'f64)
  assert near(e.velocity.x, 0.1'f64) and e.velocity.y == -0.5'f64 and near(e.velocity.z, -0.4'f64)
  # Zero strength does nothing.
  let v = e.velocity
  e.applyKnockback(0.0'f64, 1.0'f64, 1.0'f64)
  assert e.velocity == v

block handle_knockback:
  let attacker = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.ZOMBIE)
  attacker.velocity = at(1.0, 2.0, 3.0)
  attacker.yaw = 0.0'f32
  let victim = living(EntityType.ZOMBIE, at(1.5, 64.0, 0.5))
  victim.entity.onGround = true
  handleKnockback(attacker, victim, 1.0'f64)
  # strength 0.5, x = sin 0 = 0, z = -cos 0 = -1: var8 = (0, 0, -0.5). Zombie has no knockback resistance... its base is 0.
  assert near(victim.entity.velocity.z, 0.5'f64) and near(victim.entity.velocity.y, 0.4'f64)
  assert near(attacker.velocity.x, 0.6'f64) and attacker.velocity.y == 2.0'f64 and near(attacker.velocity.z, 1.8'f64)

block zero_velocity:
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  e.velocity = at(0.002, 0.002, 0.004)
  e.checkZeroVelo()
  assert e.velocity.x == 0.0'f64 and e.velocity.y == 0.0'f64 and e.velocity.z == 0.004'f64

block movement_input:
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  e.yaw = 0.0'f32
  # yaw 0: x = x cos - z sin = 0, z = z cos + x sin = 0.1 * 1.
  let v = e.movementInputToVelocity(at(0.0, 0.0, 1.0), 0.1'f64)
  assert v.x == 0.0'f64 and v.z == 0.1'f64
  # Under the threshold: nothing.
  assert e.movementInputToVelocity(at(0.0, 0.0, 1.0e-4), 0.1'f64) == at(0.0, 0.0, 0.0)
  # Longer than 1 is normalized first.
  assert near(e.movementInputToVelocity(at(0.0, 0.0, 2.0), 0.1'f64).z, 0.1'f64)

block gravity_in_the_air:
  # In void air, at y=100 in an unloaded chunk: velocity goes 0, -0.0784, -0.155232, as vanilla's.
  let z = living(EntityType.ZOMBIE, at(80.5, 100.0, 80.5))
  entitymod.tick(z, z, server)
  assert near(z.entity.velocity.y, -0.0784'f64)
  assert z.entity.pos.y == 100.0'f64
  entitymod.tick(z, z, server)
  assert near(z.entity.velocity.y, -0.155232'f64)
  assert near(z.entity.pos.y, 100.0'f64 - 0.0784'f64)
  assert z.living != nil and nearF(mustLiving(z).fallDistance, 0.0784'f32)

block landing_on_stone:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.5, 0.5))
  var ticks = 0
  while not z.entity.onGround and ticks < 40:
    entitymod.tick(z, z, server)
    inc ticks
  assert z.entity.onGround
  assert z.entity.pos.y == 64.0'f64, "feet on top of the floor"
  assert z.entity.supportingBlockPos.isSome and z.entity.supportingBlockPos.unsafeGet.vec.y == 63'i32
  # Nothing to take damage from in half a block.
  assert mustLiving(z).health == 20.0'f32

block walking_on_stone:
  # applyMovementInput on the ground: speed = 0.23 * 0.21600002 / 0.6^3, friction = 0.6 * 0.91, slipperiness is an f32.
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  z.entity.onGround = true
  z.entity.supportingBlockPos = some(BlockPos(vec: Vector3[int32](x: 0'i32, y: 63'i32, z: 0'i32)))
  z.entity.yaw = 0.0'f32
  let living0 = mustLiving(z)
  living0.movementInput = at(0.0, 0.0, 1.0)
  entitymod.tick(z, z, server)
  let slip = float64(0.6'f32)
  let inputZ = 0.98'f64 # tick_movement decays the input first: input.z *= 0.98
  let speed = living0.getAttributeValue(MOVEMENT_SPEED) * 0.216_000_02'f64 / (slip * slip * slip)
  let expected = inputZ * speed
  assert near(z.entity.pos.z, 0.5'f64 + expected), "moved by one tick of input"
  assert near(z.entity.velocity.z, expected * (slip * 0.91'f64)), "friction"

block fall_damage:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  # handle_fall_damage: floor(10 + 1e-6 - 3) = 7.
  le.handleFallDamage(z, 10.0'f32, 1.0'f32)
  assert le.health == 13.0'f32
  # Within the safe distance: floor(2.5 + 1e-6 - 3) is negative, no damage.
  le.hurtCooldown = 0'i32
  le.handleFallDamage(z, 2.5'f32, 1.0'f32)
  assert le.health == 13.0'f32

block armor_formula:
  # value = 2 + 8/4 = 4; clamped = min(max(20 - 10/4, 20/5), 20) = 17.5; 10 * (1 - 17.5/25) = 3.
  assert nearF(damageAfterArmor(10.0'f32, 20.0'f32, 8.0'f32), 3.0'f32)
  # Clamp at armor / 5: 10 armor, 100 damage: max(10 - 50, 2) = 2; 100 * (1 - 2/25) = 92.
  assert nearF(damageAfterArmor(100.0'f32, 10.0'f32, 0.0'f32), 92.0'f32)

block damage_and_cooldown:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  z.entity.onGround = true
  assert z.damage(z, 5.0'f32, MOB_ATTACK)
  assert le.health == 15.0'f32 and le.hurtCooldown == 20'i32 and le.lastDamageTaken == 5.0'f32
  # Inside the cooldown a smaller hit is refused and a larger one only does the difference.
  assert not z.damage(z, 3.0'f32, MOB_ATTACK)
  assert z.damage(z, 8.0'f32, MOB_ATTACK)
  assert le.health == 12.0'f32
  # A negative amount, and invulnerable types.
  assert not z.damage(z, -1.0'f32, MOB_ATTACK)
  z.entity.setDamageImmunity(FALL, true)
  assert z.entity.isInvulnerableTo(FALL) and not z.entity.isInvulnerableTo(GENERIC_KILL)
  z.entity.setInvulnerable(true)
  assert z.entity.isInvulnerableTo(MAGIC) and not z.entity.isInvulnerableTo(OUT_OF_WORLD)
  z.entity.setInvulnerable(false)
  z.entity.setDamageImmunity(FALL, false)
  assert not z.entity.isInvulnerableTo(FALL)

block damage_with_source_gives_knockback:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let attacker = living(EntityType.ZOMBIE, at(2.5, 64.0, 0.5))
  z.entity.onGround = true
  assert z.damageWithContext(z, 1.0'f32, MOB_ATTACK, none[Vector3[float64]](), attacker, attacker)
  # dx = 2, dz = 0; knockback 0.4 away from the source.
  assert near(z.entity.velocity.x, -0.4'f64) and near(z.entity.velocity.y, 0.4'f64)
  assert mustLiving(z).lastAttackerId == attacker.entity.entityId

block absorption_first:
  let z = living(EntityType.PLAYER, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  le.setAttributeBase(MAX_ABSORPTION, 20.0'f64)
  le.setAbsorption(4.0'f32)
  assert z.damage(z, 3.0'f32, GENERIC_KILL)
  assert le.absorption == 1.0'f32 and le.health == 20.0'f32
  le.hurtCooldown = 0'i32
  assert z.damage(z, 3.0'f32, GENERIC_KILL)
  assert le.absorption == 0.0'f32 and le.health == 18.0'f32

block death:
  gLootHook = proc(entityType: EntityType; params: LootContextParams): seq[ItemStack] {.closure.} = @[]
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  testWorld.addEntitySilent(z)
  entitymod.kill(z, z)
  assert le.health == 0.0'f32 and le.dead and z.entity.pose == epDying
  # A dead entity takes no more damage.
  assert not z.damage(z, 1.0'f32, GENERIC_KILL)
  # 21 ticks of death animation: `death_time` reaches 20, and it is gone.
  for i in 0 ..< 22:
    entitymod.tick(z, z, server)
  assert z.entity.removed
  assert testWorld.getEntityById(z.entity.entityId) == nil

block effects:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  let e = Effect(effectType: StatusEffect.REGENERATION, duration: 50'i32, amplifier: 0'u8, ambient: false,
    showParticles: true, showIcon: true, blend: false)
  # Regeneration 0 ticks at 50 >> 0; poison at 25 >> 1 for amplifier 1; wither at 40 >> 2 for amplifier 2.
  assert shouldApplyEffectTick(e, 100'i32) and not shouldApplyEffectTick(e, 99'i32) and not shouldApplyEffectTick(e, 0'i32)
  var poison = e
  poison.effectType = StatusEffect.POISON
  poison.amplifier = 1'u8
  assert shouldApplyEffectTick(poison, 24'i32) and not shouldApplyEffectTick(poison, 25'i32)
  var wither = e
  wither.effectType = StatusEffect.WITHER
  wither.amplifier = 2'u8
  assert shouldApplyEffectTick(wither, 20'i32) and not shouldApplyEffectTick(wither, 21'i32)
  var saturation = e
  saturation.effectType = StatusEffect.SATURATION
  assert shouldApplyEffectTick(saturation, 7'i32)
  var speed = e
  speed.effectType = StatusEffect.SPEED
  assert not shouldApplyEffectTick(speed, 40'i32)
  # Speed I adds 0.2 of the base: modifier `add_multiplied_total`? the data says; the attribute follows.
  let before = le.getAttributeValue(MOVEMENT_SPEED)
  le.addEffect(speed)
  assert le.hasEffect(StatusEffect.SPEED) and le.getAttributeValue(MOVEMENT_SPEED) > before
  assert le.removeEffect(StatusEffect.SPEED)
  assert le.getAttributeValue(MOVEMENT_SPEED) == before and not le.removeEffect(StatusEffect.SPEED)
  # Instant health: 4 << amplifier.
  le.health = 10.0'f32
  var instant = e
  instant.effectType = StatusEffect.INSTANT_HEALTH
  instant.amplifier = 1'u8
  le.addEffect(instant)
  assert le.health == 18.0'f32 and not le.hasEffect(StatusEffect.INSTANT_HEALTH)
  # Regeneration through tick_effects: at the 50 duration heals 1.
  le.health = 10.0'f32
  le.addEffect(e)
  entitymod.tick(z, z, server)
  assert le.health == 11.0'f32
  assert le.getEffect(StatusEffect.REGENERATION).unsafeGet.duration == 49'i32

block effect_nbt:
  let e = Effect(effectType: StatusEffect.POISON, duration: 77'i32, amplifier: 2'u8, ambient: true, showParticles: false,
    showIcon: true, blend: true)
  var nbt = newCompound()
  effectToNbt(e, nbt)
  assert nbt.getString("id").unsafeGet == "minecraft:poison" and nbt.getInt("amplifier").unsafeGet == 2'i32
  assert nbt.getByte("show_particles").unsafeGet == 0'i8
  let back = effectFromNbt(nbt).unsafeGet
  assert back.effectType.id == StatusEffect.POISON.id and back.duration == 77'i32 and back.ambient and
    not back.showParticles and back.showIcon and not back.blend
  # `show_icon` is required.
  assert effectFromNbt(newCompound()).isNone

block entity_nbt:
  let z = living(EntityType.ZOMBIE, at(1.25, 70.5, -3.0))
  z.entity.velocity = at(0.5, 0.25, -0.125)
  z.entity.setRotation(45.0'f32, 10.0'f32)
  z.entity.fireTicks = 7'i32
  z.entity.onGround = true
  assert z.entity.addScoreboardTag("a") and not z.entity.addScoreboardTag("a")
  let le = mustLiving(z)
  le.health = 11.5'f32
  le.fallDistance = 2.0'f32
  var nbt = newCompound()
  z.writeNbt(nbt)
  assert nbt.getString("id").unsafeGet == "minecraft:zombie"
  assert nbt.getShort("Fire").unsafeGet == 7'i16
  let w = living(EntityType.ZOMBIE, at(0.0, 0.0, 0.0))
  w.readNbt(nbt)
  assert w.entity.pos == at(1.25, 70.5, -3.0) and w.entity.velocity == at(0.5, 0.25, -0.125)
  assert w.entity.yaw == 45.0'f32 and w.entity.pitch == 10.0'f32 and w.entity.fireTicks == 7'i32 and w.entity.onGround
  assert w.entity.scoreboardTags.len == 1 and w.entity.scoreboardTags[0] == "a"
  let wl = mustLiving(w)
  assert wl.health == 11.5'f32 and wl.fallDistance == 2.0'f32

block attributes_on_living:
  let z = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let le = mustLiving(z)
  assert le.getAttributeValue(MAX_HEALTH) == 20.0'f64 and le.getAttributeBase(MAX_HEALTH) == 20.0'f64
  le.setMaxHealth(30.0'f32)
  assert le.getMaxHealth() == 30.0'f32
  le.health = 30.0'f32
  le.setMaxHealth(10.0'f32)
  assert le.health == 10.0'f32

block push_formula:
  let a = living(EntityType.ZOMBIE, at(0.5, 64.0, 0.5))
  let b = living(EntityType.ZOMBIE, at(4.5, 64.0, 0.5))
  entitymod.push(a, b)
  # dx=4, d=sqrt(4)=2, dx=2, then * 1/2 = 1, * 0.05.
  assert near(a.entity.velocity.x, -0.05'f64) and near(b.entity.velocity.x, 0.05'f64)

block predicates:
  let e = newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG)
  assert EntityPredicate(kind: epValidEntity).test(e)
  assert not EntityPredicate(kind: epValidLivingEntity).test(e)
  assert EntityPredicate(kind: epExceptSpectator).test(e)
  assert not EntityPredicate(kind: epCanHit).test(e)
  assert EntityPredicate(kind: epNotMounted).test(e)

block deflection:
  let p = entityBaseOf(newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.SNOWBALL))
  p.entity.velocity = at(1.0, 0.0, 0.0)
  pdSimple.deflect(p, nil)
  assert near(p.entity.velocity.x, -0.5'f64) and p.entity.yaw >= 170.0'f32 and p.entity.yaw <= 190.0'f32
  let q = entityBaseOf(newEntity(testWorld, at(0.5, 64.0, 0.5), EntityType.PIG))
  q.entity.velocity = at(3.0, 0.0, 0.0)
  pdTransferVelocityDirection.deflect(p, q)
  assert near(p.entity.velocity.x, 1.0'f64)

block orb_sizes:
  # `round_to_orb_size`'s steps.
  assert roundToOrbSize(1'u32) == 1'u32 and roundToOrbSize(2'u32) == 1'u32 and roundToOrbSize(3'u32) == 3'u32
  assert roundToOrbSize(10'u32) == 7'u32 and roundToOrbSize(5000'u32) == 2477'u32
  let before = allEntities(testWorld).len
  experienceorb.spawn(testWorld, at(0.5, 66.0, 0.5), 11'u32)
  # 11 -> 7 + 3 + 1
  assert allEntities(testWorld).len == before + 3

block falling_block_lands:
  let e = newEntity(testWorld, at(2.5, 66.0, 2.5), EntityType.FALLING_BLOCK)
  let f = newFallingEntity(e, blockSand().defaultState.id)
  let base: EntityBase = f
  for i in 0 ..< 60:
    if not e.onGround:
      entitymod.tick(base, base, server)
  assert e.onGround
  assert testWorld.getBlock(BlockPos(vec: Vector3[int32](x: 2'i32, y: 64'i32, z: 2'i32))).id == blockSand().id

block tnt_fuse:
  let e = newEntity(testWorld, at(5.5, 64.0, 5.5), EntityType.TNT)
  let t = newTNTEntity(e, 0.0'f32, 2'u32)
  let base: EntityBase = t
  testWorld.addEntitySilent(base)
  assert base.isImmuneToExplosion() and base.getGravity() == 0.04'f64
  entitymod.tick(base, base, server)
  assert t.fuse == 1'u32
  entitymod.tick(base, base, server)
  assert testWorld.getEntityById(e.entityId) == nil, "it blew up and went"

block item_entity:
  let e = newEntity(testWorld, at(7.5, 64.0, 7.5), EntityType.ITEM)
  let item = newItemEntityWithVelocity(e, newItemStack(3'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 2'u8)
  let base: EntityBase = item
  assert base of itementity.ItemEntity
  assert item.pickupDelay == 2'u8 and item.health == 5.0'f32
  entitymod.tick(base, base, server)
  assert item.pickupDelay == 1'u8 and item.itemAge == 1'u32
  # Damage in 5 health.
  assert base.damage(base, 2.0'f32, MAGIC) == false, "the trait's default `damage` goes to the caller's `damage_with_context`"
  assert base.damageWithContext(base, 6.0'f32, MAGIC, none[Vector3[float64]](), nil, nil)
  assert item.health < 0.0'f32
  # Merging two of the same.
  let e1 = newEntity(testWorld, at(9.5, 64.0, 9.5), EntityType.ITEM)
  let e2 = newEntity(testWorld, at(9.5, 64.0, 9.5), EntityType.ITEM)
  let a = newItemEntityWithVelocity(e1, newItemStack(3'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 0'u8)
  let b = newItemEntityWithVelocity(e2, newItemStack(5'u8, ITEM_DIRT), at(0.0, 0.0, 0.0), 0'u8)
  let baseA: EntityBase = a
  let baseB: EntityBase = b
  testWorld.addEntitySilent(baseA)
  testWorld.addEntitySilent(baseB)
  a.itemAge = 39'u32
  e1.lastPos = e1.pos
  e1.onGround = true
  entitymod.tick(baseA, baseA, server)
  # The smaller goes into the larger.
  assert b.itemStack.itemCount == 8'u8 and a.itemStack.itemCount == 0'u8
  assert testWorld.getEntityById(e1.entityId) == nil

block from_type_fallbacks:
  let z = fromType(EntityType.ZOMBIE, at(0.5, 64.0, 0.5), testWorld, randomUuid())
  assert z.entity.entityType.id == EntityType.ZOMBIE.id
  let m = fromType(EntityType.MARKER, at(0.5, 64.0, 0.5), testWorld, randomUuid())
  assert m.living == nil
  let t = fromType(EntityType.TNT, at(0.5, 64.0, 0.5), testWorld, randomUuid())
  assert t of tnt.TNTEntity

block hunger_formulas:
  var h = newHungerManager()
  assert h.level == 20'u8 and h.saturation == 5.0'f32
  h.addExhaustion(100.0'f32)
  assert h.getExhaustion() == 40.0'f32
  h.setLevel(30'u8)
  assert h.level == 20'u8
  h.setSaturation(30.0'f32)
  assert h.saturation == 20.0'f32
  var nbt = newCompound()
  h.writeNbt(nbt)
  var r = newHungerManager()
  r.readNbt(nbt)
  assert r.saturation == 20.0'f32 and r.exhaustion == 40.0'f32
  h.restart()
  assert h.saturation == 5.0'f32 and h.exhaustion == 0.0'f32

echo "entitymod ok"
