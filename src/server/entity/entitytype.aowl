## Port of pumpkin/src/entity/type.rs
## PARTIAL: pumpkin/src/entity/type.rs - `from_type`'s match is a table each entity module registers into with `registerEntityFactory`, since most of its arms are in modules that do not exist yet or import this tree; the ones ported in this folder and entity/projectile register here. `check_spawn_rules` has bat's and slime's rule behind hooks entity/mob fills.
##
## Importing this fills `gFromType`. A type with no factory takes upstream's fallback arm: a bare `LivingEntity` when the
## type has attributes, and a bare `Entity` when it has none.

import std/tables
import ../../data/block_ext
import experienceorb, falling, itementity, tnt, area_effect_cloud
import entitymod
import ai/aibase

type
  EntityFactory* = proc(entity: Entity): EntityBase {.closure.}

var gFactories = initTable[uint16, EntityFactory]()

var gCheckBatSpawnRules*: proc(world: World; pos: BlockPos): bool {.closure.} =
  proc(world: World; pos: BlockPos): bool {.closure.} = true
  ## `bat::BatEntity::check_bat_spawn_rules`. entity/mob/bat sets it.

# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callCheckBatSpawnRules*(world: World; pos: BlockPos): bool =
  gCheckBatSpawnRules(world, pos)

var gCheckSlimeSpawnRules*: proc(world: World; pos: BlockPos): bool {.closure.} =
  proc(world: World; pos: BlockPos): bool {.closure.} = true
  ## `SlimeEntity::check_slime_spawn_rules`. entity/mob/slime sets it.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callCheckSlimeSpawnRules*(world: World; pos: BlockPos): bool =
  gCheckSlimeSpawnRules(world, pos)

proc registerEntityFactory*(entityType: EntityType; factory: EntityFactory) =
  ## One arm of `from_type`'s match.
  gFactories[entityType.id] = factory

proc fromType*(entityType: EntityType; position: Vector3[float64]; world: World; uuid: Uuid): EntityBase =
  ## `from_type`
  let entity = fromUuid(uuid, world, position, entityType)
  if gFactories.hasKey(entityType.id):
    return gFactories.getOrDefault(entityType.id)(entity)
  # Fallback Entity
  if entityType.attributes.len == 0:
    entityBaseOf(entity)
  else:
    livingBaseOf(newLivingEntity(entity))

proc checkSpawnRules*(entityType: EntityType; world: World; pos: BlockPos; isThundering: bool): bool =
  ## `check_spawn_rules`
  let id = entityType.id
  if id == EntityType.BOGGED.id or id == EntityType.CAVE_SPIDER.id or id == EntityType.CREEPER.id or
      id == EntityType.ENDERMAN.id or id == EntityType.GIANT.id or id == EntityType.RAVAGER.id or
      id == EntityType.SKELETON.id or id == EntityType.SPIDER.id or id == EntityType.WITCH.id or
      id == EntityType.WITHER.id or id == EntityType.WITHER_SKELETON.id or id == EntityType.ZOMBIE.id or
      id == EntityType.ZOMBIE_HORSE.id or id == EntityType.ZOMBIE_VILLAGER.id or id == EntityType.CREAKING.id or
      id == EntityType.EVOKER.id or id == EntityType.ILLUSIONER.id or id == EntityType.VEX.id or
      id == EntityType.VINDICATOR.id or id == EntityType.WARDEN.id:
    return checkMonsterSpawnRules(world, pos, isThundering)
  if id == EntityType.BAT.id:
    return gCheckBatSpawnRules(world, pos)
  if id == EntityType.SLIME.id:
    return gCheckSlimeSpawnRules(world, pos)
  # TODO upstream
  true

proc registerFolderFactories() =
  registerEntityFactory(EntityType.AREA_EFFECT_CLOUD, proc(entity: Entity): EntityBase {.closure.} =
    let cloud: EntityBase = newAreaEffectCloudEntity(entity)
    cloud)
  registerEntityFactory(EntityType.FALLING_BLOCK, proc(entity: Entity): EntityBase {.closure.} =
    let falling: EntityBase = newFallingEntity(entity, blockSand().defaultState.id)
    falling)
  registerEntityFactory(EntityType.EXPERIENCE_ORB, proc(entity: Entity): EntityBase {.closure.} =
    let orb: EntityBase = newExperienceOrbEntity(entity, 1'u32)
    orb)
  registerEntityFactory(EntityType.TNT, proc(entity: Entity): EntityBase {.closure.} =
    let tnt: EntityBase = newTNTEntity(entity, 4.0'f32, 80'u32)
    tnt)
  registerEntityFactory(EntityType.ITEM, proc(entity: Entity): EntityBase {.closure.} =
    let item: EntityBase = newItemEntityForRestore(entity)
    item)

registerFolderFactories()

gFromType = proc(entityType: EntityType; position: Vector3[float64]; world: World; uuid: Uuid): nil EntityBase {.closure.} =
  fromType(entityType, position, world, uuid)
