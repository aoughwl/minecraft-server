## Port of pumpkin/src/entity/experience_orb.rs

import std/math
import entitymod

type
  ExperienceOrbEntity* = ref object of EntityBase
    amount*: uint32
    orbAge*: uint32

proc roundToOrbSize*(value: uint32): uint32 =
  ## `round_to_orb_size`
  if value >= 2477'u32: 2477'u32
  elif value >= 1237'u32: 1237'u32
  elif value >= 617'u32: 617'u32
  elif value >= 307'u32: 307'u32
  elif value >= 149'u32: 149'u32
  elif value >= 73'u32: 73'u32
  elif value >= 37'u32: 37'u32
  elif value >= 17'u32: 17'u32
  elif value >= 7'u32: 7'u32
  elif value >= 3'u32: 3'u32
  else: 1'u32

proc makeVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let s = ExperienceOrbEntity(self)
    let entity = s.entity
    entityTick(entity, caller, server)
    let boundingBox = entity.boundingBox
    var velo = entity.velocity
    let noClip = not entity.world.isSpaceEmpty(boundingBox.expand(-1.0e-7'f64, -1.0e-7'f64, -1.0e-7'f64))
    # TODO upstream: isSubmergedIn
    if not noClip:
      velo.y -= self.getGravity()
    entity.velocity = velo
    entity.moveEntity(caller, velo)
    discard entity.tickBlockCollisions(caller, server)
    let age = s.orbAge
    s.orbAge = age + 1'u32
    if age >= 6000'u32:
      entity.remove()
  result.onPlayerCollision = proc(self: EntityBase; player: Player) {.closure.} =
    let s = ExperienceOrbEntity(self)
    if player.health > 0.0'f32:
      if gPlayerHooks.experiencePickUpDelay(player) == 0'u32:
        gPlayerHooks.setExperiencePickUpDelay(player, 2'u32)
        mustLiving(playerBase(player)).pickup(s.entity, 1'u32)
        let remaining = gPlayerHooks.applyMendingFromXp(player, int32(s.amount))
        if remaining > 0'i32:
          gPlayerHooks.addExperiencePoints(player, remaining)
        # TODO upstream: pickingCount for merging
        s.entity.remove()
  result.getGravity = proc(self: EntityBase): float64 {.closure.} = 0.03'f64
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} = discard
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} = discard

let experienceOrbVt* = makeVt()

proc newExperienceOrbEntity*(entity: Entity; amount: uint32): ExperienceOrbEntity =
  ## `ExperienceOrbEntity::new`
  entity.yaw = randomF32() * 360.0'f32
  result = ExperienceOrbEntity(vt: experienceOrbVt, entity: entity, amount: amount, orbAge: 0'u32)
  entity.base = result

proc spawn*(world: World; position: Vector3[float64]; amount0: uint32) =
  ## `ExperienceOrbEntity::spawn`
  var amount = amount0
  while amount > 0'u32:
    let i = roundToOrbSize(amount)
    amount -= i
    let orb: EntityBase = newExperienceOrbEntity(newEntity(world, position, EntityType.EXPERIENCE_ORB), i)
    spawnEntity(world, orb)

gSpawnExperienceOrb = proc(world: World; position: Vector3[float64]; amount: uint32) {.closure.} =
  spawn(world, position, amount)
