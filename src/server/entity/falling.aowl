## Port of pumpkin/src/entity/falling.rs

import ../../data/block_ext
from ../../data/block_state import asU16, BlockStateId
import ../../generated/[meta_data_type, tracked_data]
import ../../world/world as worldtraits
import ../world/chunker
import entitymod

type
  FallingEntity* = ref object of EntityBase
    blockStateId*: BlockStateId

proc makeVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let s = FallingEntity(self)
    let entity = s.entity
    entityTick(entity, caller, server)
    var velo = entity.velocity
    velo.y -= self.getGravity()
    entity.velocity = velo
    entity.moveEntity(caller, velo)
    discard entity.tickBlockCollisions(caller, server)
    if entity.onGround:
      entity.velocity = velo.multiply(0.7'f64, -0.5'f64, 0.7'f64)
      discard entity.world.setBlockState(entity.blockPos, uint32(asU16(s.blockStateId)), BfNotifyAll)
      entity.remove()
    entity.velocity = velo.multiply(0.98'f64, 0.98'f64, 0.98'f64)
    let dirty = entity.velocityDirty
    entity.velocityDirty = false
    if dirty:
      entity.sendPosRot()
      entity.sendVelocity()
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    self.entity.sendMetaData(TrackedData_START_POS, BLOCK_POS, self.entity.blockPos)
  result.damage = proc(self, caller: EntityBase; amount: float32; damageType: DamageType): bool {.closure.} = false
  result.getGravity = proc(self: EntityBase): float64 {.closure.} = 0.04'f64
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} = discard
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} = discard

let fallingVt* = makeVt()

proc newFallingEntity*(entity: Entity; blockStateId: BlockStateId): FallingEntity =
  ## `FallingEntity::new`
  result = FallingEntity(vt: fallingVt, entity: entity, blockStateId: blockStateId)
  entity.base = result

proc replaceSpawn*(world: World; position: BlockPos; blockState: BlockStateId) =
  ## `replace_spawn`: replaces the current block and spawns a falling one. TODO upstream: use fluid state
  discard world.setBlockState(position, uint32(asU16(blockAir().defaultState.id)), BfNotifyAll)
  let center = position.vec.toF64().addRaw(0.5'f64, 0.0'f64, 0.5'f64)
  let entity = newEntity(world, center, EntityType.FALLING_BLOCK)
  entity.data = int32(asU16(blockState))
  let base: EntityBase = newFallingEntity(entity, blockState)
  spawnEntity(world, base)
