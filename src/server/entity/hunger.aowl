## Port of pumpkin/src/entity/hunger.rs
##
## `HungerManager`'s fields are in src/server/serverbase.aowl, since `Player` holds one. This is the whole of its logic,
## with starvation damage. entity/player.aowl has a copy of `tick` from before damage existed: its `tickHunger` should
## become a call to `tickHungerManager` here, through `gTickHunger` or from whatever ticks the player.

from ../../generated/damage_type import STARVE
import ../../generated/game_rules
import ../../nbt/tag as nbttag
import ../../util/difficulty
import ../entity/player as playermod
import entitymod

const
  MaxFood = 20'u8
  ExhaustionCost = 4.0'f32
  MaxExhaustion = 40.0'f32

proc newHungerManager*(): HungerManager =
  ## `HungerManager::default`
  HungerManager(level: MaxFood, saturation: 5.0'f32, exhaustion: 0.0'f32, tickTimer: 0'u32)

proc saturatingAdd(a, b: uint8): uint8 =
  ## `(current + hunger).min(MAX_FOOD)`: `u8` addition never reaches 256 from these callers, but it is kept from wrapping.
  let sum = uint32(a) + uint32(b)
  if sum > uint32(MaxFood): MaxFood else: uint8(sum)

proc tickHungerManager*(player: Player) =
  ## `tick`
  var level = player.hungerManager.level
  var saturation = player.hungerManager.saturation
  var exhaustion = player.hungerManager.exhaustion
  var timer = player.hungerManager.tickTimer
  let levelInfo = player.world.levelInfo
  let difficulty = levelInfo.difficulty
  let naturalRegen = levelInfo.gameRules.naturalHealthRegeneration
  let health = player.health
  let canHeal = player.canFoodHeal()
  var needsSync = false
  var healAmount = 0.0'f32
  var damageAmount = 0.0'f32
  if exhaustion > ExhaustionCost:
    exhaustion -= ExhaustionCost
    if saturation > 0.0'f32:
      saturation = max(saturation - 1.0'f32, 0.0'f32)
    elif difficulty != Peaceful:
      level = if level > 0'u8: level - 1'u8 else: 0'u8
    needsSync = true
  if naturalRegen and saturation > 0.0'f32 and canHeal and level >= 20'u8:
    timer += 1'u32
    if timer >= 10'u32:
      let cost = min(saturation, 6.0'f32)
      saturation -= cost
      exhaustion += cost
      healAmount = cost / 6.0'f32
      timer = 0'u32
      needsSync = true
  elif naturalRegen and level >= 18'u8 and canHeal:
    timer += 1'u32
    if timer >= 80'u32:
      healAmount = 1.0'f32
      exhaustion += 6.0'f32
      timer = 0'u32
      needsSync = true
  elif level == 0'u8:
    timer += 1'u32
    if timer >= 80'u32:
      timer = 0'u32
      let shouldStarve = case difficulty
        of Peaceful: false
        of Easy: health > 10.0'f32
        of Normal: health > 1.0'f32
        of Hard: true
      if shouldStarve:
        damageAmount = 1.0'f32
      player.hungerManager.tickTimer = 0'u32
  else:
    timer = 0'u32
  if needsSync or timer != player.hungerManager.tickTimer:
    player.hungerManager.level = level
    player.hungerManager.saturation = saturation
    player.hungerManager.exhaustion = exhaustion
    player.hungerManager.tickTimer = timer
  if needsSync:
    player.sendHealth()
  if healAmount > 0.0'f32:
    player.heal(healAmount)
  if damageAmount > 0.0'f32:
    let base = playerBase(player)
    discard base.damage(base, damageAmount, STARVE)

proc eat*(player: Player; food: uint8; saturationModifier: float32) =
  ## `eat`
  let addedSaturation = float32(food) * saturationModifier * 2.0'f32
  let newLevel = saturatingAdd(player.hungerManager.level, food)
  let newSat = min(player.hungerManager.saturation + addedSaturation, float32(newLevel))
  player.hungerManager.level = newLevel
  player.hungerManager.saturation = newSat
  player.sendHealth()

proc addExhaustion*(self: var HungerManager; exhaustion: float32) =
  self.exhaustion = min(self.exhaustion + exhaustion, MaxExhaustion)

proc addHunger*(self: var HungerManager; hunger: uint8) =
  self.level = saturatingAdd(self.level, hunger)

proc addSaturation*(self: var HungerManager; saturation: float32) =
  self.saturation = min(self.saturation + saturation, float32(self.level))

proc setLevel*(self: var HungerManager; level: uint8) =
  self.level = min(level, MaxFood)

proc setSaturation*(self: var HungerManager; saturation: float32) =
  self.saturation = min(saturation, float32(self.level))

proc getExhaustion*(self: HungerManager): float32 = self.exhaustion

proc setExhaustion*(self: var HungerManager; exhaustion: float32) =
  self.exhaustion = min(exhaustion, MaxExhaustion)

proc restart*(self: var HungerManager) =
  self.level = MaxFood
  self.saturation = 5.0'f32
  self.exhaustion = 0.0'f32
  self.tickTimer = 0'u32

proc writeNbt*(self: HungerManager; nbt: var NbtCompound) =
  ## `impl NBTStorage for HungerManager`
  nbt.putInt("foodLevel", int32(self.level))
  nbt.putFloat("foodSaturationLevel", self.saturation)
  nbt.putFloat("foodExhaustionLevel", self.exhaustion)
  nbt.putInt("foodTickTimer", int32(self.tickTimer))

proc readNbt*(self: var HungerManager; nbt: NbtCompound) =
  let level = nbt.getInt("foodLevel")
  self.level = if level.isSome: cast[uint8](level.unsafeGet and 0xFF'i32) else: 20'u8
  let saturation = nbt.getFloat("foodSaturationLevel")
  self.saturation = if saturation.isSome: saturation.unsafeGet else: 5.0'f32
  let exhaustion = nbt.getFloat("foodExhaustionLevel")
  self.exhaustion = if exhaustion.isSome: exhaustion.unsafeGet else: 0.0'f32
  let timer = nbt.getInt("foodTickTimer")
  self.tickTimer = if timer.isSome: cast[uint32](timer.unsafeGet) else: 0'u32

gEatHook = proc(player: Player; nutrition: uint8; saturation: float32) {.closure.} =
  eat(player, nutrition, saturation)
