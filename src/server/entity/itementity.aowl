## Port of pumpkin/src/entity/item.rs
## Named itementity, since src/server/item is the item behaviours. The Bedrock spawn packet is left out, as everywhere.
##
## Importing this also fills `gDropStack` and `gScatterStack`: `World::drop_stack`, and `scatter_stack`.

import std/[math, options]
import "../../data/item_stack/mod"
import ../../generated/[meta_data_type, statistic, tracked_data]
import ../../generated/damage_type as damagetypes
import ../../inventory/[player_inventory, screenhandler, stackbridge]
import ../../nbt/tag as nbttag
import ../../protocol/java/client/play/entity_metadata
import ../../util/math/rustnum
import ../../util/xoroshiro128
from ../../util/random/random import getSeed
import ../world/chunker
import entitymod
import ../../plugin/pluginhooks

type
  ItemEntity* = ref object of EntityBase
    itemAge*: uint32
    itemStack*: ItemStack
    pickupDelay*: uint8
    health*: float32
    neverDespawn*: bool
    neverPickup*: bool

proc canMerge(self: ItemEntity): bool =
  ## `can_merge`
  if self.neverPickup or self.entity.removed:
    return false
  self.itemStack.itemCount < self.itemStack.getMaxStackSize()

proc tryMergeWith(self, other: ItemEntity) =
  ## `try_merge_with`
  if not self.itemStack.areEqual(other.itemStack) or
      uint32(self.itemStack.itemCount) + uint32(other.itemStack.itemCount) > uint32(self.itemStack.getMaxStackSize()):
    return
  let target = if other.itemStack.itemCount < self.itemStack.itemCount: self else: other
  let source = if other.itemStack.itemCount < self.itemStack.itemCount: other else: self
  # Vanilla code adds a .min(64). Not needed with Vanilla item data
  let maxSize = target.itemStack.getMaxStackSize()
  let j = min(source.itemStack.itemCount, maxSize - target.itemStack.itemCount)
  target.itemStack.increment(j)
  source.itemStack.decrement(j)
  let empty1 = target.itemStack.itemCount == 0'u8
  let empty2 = source.itemStack.itemCount == 0'u8
  let neverDespawn = source.neverDespawn
  target.neverDespawn = neverDespawn
  if not neverDespawn:
    target.itemAge = min(target.itemAge, source.itemAge)
  let neverPickup = source.neverPickup
  target.neverPickup = neverPickup
  if not neverPickup:
    target.pickupDelay = max(target.pickupDelay, source.pickupDelay)
  if empty1:
    target.entity.remove()
  else:
    target.initDataTracker()
  if empty2:
    source.entity.remove()
  else:
    source.initDataTracker()

proc tryMerge(self: ItemEntity) =
  ## `try_merge`
  let boundingBox = self.entity.boundingBox.expand(0.5'f64, 0.0'f64, 0.5'f64)
  # A snapshot of the list: a merge removes an entity, and walking the live list while that happens read past its end.
  let candidates = entitiesOf(self.entity.world).entities
  for candidate in candidates:
    if candidate of ItemEntity:
      let item = ItemEntity(candidate)
      if item.entity.entityId != self.entity.entityId and not item.neverDespawn and
          item.entity.boundingBox.intersects(boundingBox):
        if item.canMerge():
          self.tryMergeWith(item)
          if self.entity.removed:
            break

proc applyFluidDragOrGravity(self: ItemEntity; velo0: Vector3[float64]): Vector3[float64] =
  ## `apply_fluid_drag_or_gravity`
  var velo = velo0
  let entity = self.entity
  if entity.touchingWater and entity.waterHeight > 0.1'f64:
    velo.x *= 0.99'f64
    velo.z *= 0.99'f64
    if velo.y < 0.06'f64:
      velo.y += 5.0e-4'f64
  elif entity.touchingLava and entity.lavaHeight > 0.1'f64:
    velo.x *= 0.95'f64
    velo.z *= 0.95'f64
    if velo.y < 0.06'f64:
      velo.y += 5.0e-4'f64
  else:
    velo.y -= self.getGravity()
  velo

proc updateNoClipAndPushOut(self: ItemEntity) =
  ## `update_no_clip_and_push_out`
  let entity = self.entity
  let pos = entity.pos
  let boundingBox = entity.boundingBox
  let noClip = not entity.world.isSpaceEmpty(boundingBox.expand(-1.0e-7'f64, -1.0e-7'f64, -1.0e-7'f64))
  entity.noClip = noClip
  if noClip:
    entity.pushOutOfBlocks(Vector3[float64](x: pos.x, y: (boundingBox.min.y + boundingBox.max.y) / 2.0'f64, z: pos.z))

proc shouldTickMove(self: ItemEntity; moveVelo: Vector3[float64]): Option[bool] =
  ## `should_tick_move`
  let entity = self.entity
  var tickMove = not entity.onGround or moveVelo.horizontalLengthSquared() > 1.0e-5'f64
  if not tickMove:
    if self.itemAge > 2147483647'u32:
      entity.remove()
      return none[bool]()
    tickMove = (int32(self.itemAge) + entity.entityId) mod 4'i32 == 0'i32
  some(tickMove)

proc moveAndApplyFriction(self: ItemEntity; caller: EntityBase; server: Server; moveVelo: Vector3[float64]) =
  ## `move_and_apply_friction`
  let entity = self.entity
  entity.moveEntity(caller, moveVelo)
  discard entity.tickBlockCollisions(caller, server)
  var friction = 0.98'f64
  let onGround = entity.onGround
  var velo = entity.velocity
  if onGround:
    let blockAffectingVelo = entity.getBlockWithYOffset(0.999_999'f64)[1]
    friction *= float64(blockAffectingVelo.slipperiness) * 0.98'f64
  velo = velo.multiply(friction, 0.98'f64, friction)
  if onGround and velo.y < 0.0'f64:
    velo.y = 0.0'f64
  entity.velocity = velo

proc processAgeAndMerge(self: ItemEntity): bool =
  ## `process_age_and_merge`
  if self.neverDespawn:
    return true
  let entity = self.entity
  self.itemAge += 1'u32
  let age = self.itemAge
  if age >= 6000'u32:
    entity.remove()
    return false
  let n = if entity.lastPos.sub(entity.pos).lengthSquared() == 0.0'f64: 40'u32 else: 2'u32
  if age mod n == 0'u32 and self.canMerge():
    self.tryMerge()
  true

proc syncMotionIfDirty(self: ItemEntity; caller: EntityBase; originalVelo: Vector3[float64]) =
  ## `sync_motion_if_dirty`
  let entity = self.entity
  entity.updateFluidState(caller)
  let wasDirty = entity.velocityDirty
  entity.velocityDirty = false
  let velocityDirty = wasDirty or entity.touchingWater or entity.touchingLava or
    entity.velocity.sub(originalVelo).lengthSquared() > 0.1'f64
  if velocityDirty:
    entity.sendPosRot()
    entity.sendVelocity()

proc makeVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let s = ItemEntity(self)
    let entity = s.entity
    s.pickupDelay = if s.pickupDelay > 0'u8: s.pickupDelay - 1'u8 else: 0'u8
    let originalVelo = entity.velocity
    entity.velocity = s.applyFluidDragOrGravity(originalVelo)
    s.updateNoClipAndPushOut()
    let moveVelo = entity.velocity # In case push_out_of_blocks modifies it
    let tickMove = s.shouldTickMove(moveVelo)
    if tickMove.isNone:
      return
    if tickMove.unsafeGet:
      s.moveAndApplyFriction(caller, server, moveVelo)
    if s.processAgeAndMerge():
      s.syncMotionIfDirty(caller, originalVelo)
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let s = ItemEntity(self)
    s.entity.sendMetaData(TrackedData_ITEM, ITEM_STACK, toSerializer(s.itemStack))
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    let s = ItemEntity(self)
    # Check if entity is fire_immune
    let isFireDamage = damageType.id == damagetypes.IN_FIRE.id or damageType.id == damagetypes.ON_FIRE.id or
      damageType.id == damagetypes.LAVA.id
    if isFireDamage and s.entity.fireImmune:
      return false
    s.health -= amount
    if s.health <= 0.0'f32:
      s.entity.remove()
    true
  result.onPlayerCollision = proc(self: EntityBase; player: Player) {.closure.} =
    let s = ItemEntity(self)
    if s.pickupDelay > 0'u8 or player.health <= 0.0'f32 or player.gamemode == Spectator:
      return
    var pickupEv = newPlayerEv(pekItemPickup)
    pickupEv.text = s.itemStack.item.registryKey
    pickupEv.n = int64(s.itemStack.itemCount)
    pickupEv.n2 = int64(s.entity.entityId)
    if gPluginPlayerEventHook(player, pickupEv)[0]:
      return
    let itemId = s.itemStack.item.id
    let countBefore = s.itemStack.itemCount
    let inserted = player.inventory.insertStackAnywhere(s.itemStack)
    let creative = player.gamemode == Creative
    if inserted or creative:
      let countAfter = s.itemStack.itemCount
      let isEmpty = s.itemStack.isEmpty()
      let amountPickedUp = if creative: countBefore else: countBefore - countAfter
      if amountPickedUp > 0'u8:
        gPlayerHooks.incrementStat(player, scPickedUp, int32(itemId), int32(amountPickedUp))
      mustLiving(playerBase(player)).pickup(s.entity, uint32(amountPickedUp))
      sendContentUpdates(player.currentScreenHandler)
      if isEmpty:
        s.entity.remove()
      else:
        self.initDataTracker()
  result.getGravity = proc(self: EntityBase): float64 {.closure.} = 0.04'f64
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let s = ItemEntity(self)
    writeEntityNbt(s.entity, nbt)
    var itemCompound = newCompound()
    s.itemStack.writeItemStack(itemCompound)
    nbt.putCompound("Item", itemCompound)
    nbt.putShort("Age", cast[int16](uint16(s.itemAge and 0xFFFF'u32)))
    nbt.putShort("PickupDelay", int16(s.pickupDelay))
    nbt.putShort("Health", asI16(float64(s.health)))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let s = ItemEntity(self)
    readEntityNbt(s.entity, nbt)
    # Restore the item stack from the "Item" compound
    let itemCompound = nbt.getCompound("Item")
    if itemCompound.isSome:
      let stack = readItemStack(itemCompound.unsafeGet)
      if stack.isSome:
        s.itemStack = stack.unsafeGet
    # Vanilla stores Age as a short
    let age = nbt.getShort("Age")
    s.itemAge = if age.isSome: cast[uint32](int32(age.unsafeGet)) else: 0'u32
    # Vanilla stores PickupDelay as a short
    let delay = nbt.getShort("PickupDelay")
    if delay.isSome:
      s.pickupDelay = cast[uint8](int8(delay.unsafeGet and 0xFF'i16))
    # Vanilla stores Health as a short
    let health = nbt.getShort("Health")
    if health.isSome:
      s.health = float32(health.unsafeGet)

let itemEntityVt* = makeVt()

proc setFireImmunity(entity: Entity; itemStack: ItemStack) =
  ## Set fire immunity for certain items
  let (has, res) = itemStack.getDataComponent(DamageResistantImpl)
  if has and res.resType == drtFire:
    entity.fireImmune = true

proc build(entity: Entity; itemStack: ItemStack; pickupDelay: uint8): ItemEntity =
  result = ItemEntity(vt: itemEntityVt, entity: entity, itemAge: 0'u32, itemStack: itemStack, pickupDelay: pickupDelay,
    health: 5.0'f32, neverDespawn: false, neverPickup: false)
  entity.base = result

proc newItemEntity*(entity: Entity; itemStack: ItemStack): ItemEntity =
  ## `ItemEntity::new`
  entity.velocity = Vector3[float64](x: mulAdd(randomF64(), 0.2'f64, -0.1'f64), y: 0.2'f64,
    z: mulAdd(randomF64(), 0.2'f64, -0.1'f64))
  entity.yaw = randomF32() * 360.0'f32
  setFireImmunity(entity, itemStack)
  build(entity, itemStack, 10'u8) # Vanilla pickup delay is 10 ticks

proc newItemEntityWithVelocity*(entity: Entity; itemStack: ItemStack; velocity: Vector3[float64]; pickupDelay: uint8): ItemEntity =
  ## `ItemEntity::new_with_velocity`
  entity.velocity = velocity
  entity.yaw = randomF32() * 360.0'f32
  setFireImmunity(entity, itemStack)
  build(entity, itemStack, pickupDelay)

proc newItemEntityForRestore*(entity: Entity): ItemEntity =
  ## `ItemEntity::new_for_restore`: position and velocity come from `read_nbt`.
  build(entity, newItemStack(1'u8, ITEM_AIR), 10'u8)

proc dropStack*(world: World; pos: BlockPos; stack: ItemStack) =
  ## `World::drop_stack`
  let height = EntityType.ITEM.dimension[1] / 2.0'f32
  let spawnPos = Vector3[float64](
    x: float64(pos.vec.x) + 0.5'f64 + randomRangeF64(-0.25'f64, 0.25'f64),
    y: float64(pos.vec.y) + 0.5'f64 + randomRangeF64(-0.25'f64, 0.25'f64) - float64(height),
    z: float64(pos.vec.z) + 0.5'f64 + randomRangeF64(-0.25'f64, 0.25'f64))
  let item: EntityBase = newItemEntity(newEntity(world, spawnPos, EntityType.ITEM), stack)
  spawnEntity(world, item)

proc scatterStack*(world: World; x0, y0, z0: float64; stack0: ItemStack) =
  ## `World::scatter_stack`: ItemScatterer.java.
  const
    TriangularDeviation = 0.114_850_001_711_398_36'f64
    XzMode = 0.0'f64
    YMode = 0.2'f64
  var stack = stack0
  let width = float64(EntityType.ITEM.dimension[0])
  let halfWidth = width / 2.0'f64
  let spawnArea = 1.0'f64 - width
  var rng = xoroshiro128.fromSeed(getSeed())
  # TODO upstream: Use world random here: world.random.nextDouble()
  let x = mulAdd(rng.nextF64(), spawnArea, floor(x0)) + halfWidth
  let y = mulAdd(rng.nextF64(), spawnArea, floor(y0))
  let z = mulAdd(rng.nextF64(), spawnArea, floor(z0)) + halfWidth
  while not stack.isEmpty():
    let item = stack.split(uint8(rng.nextBoundedI32(21'i32) + 10'i32))
    let vx = rng.nextTriangular(XzMode, TriangularDeviation)
    let vy = rng.nextTriangular(YMode, TriangularDeviation)
    let vz = rng.nextTriangular(XzMode, TriangularDeviation)
    let velocity = Vector3[float64](x: vx, y: vy, z: vz)
    let entity = newEntity(world, Vector3[float64](x: x, y: y, z: z), EntityType.ITEM)
    let spawned: EntityBase = newItemEntityWithVelocity(entity, item, velocity, 10'u8)
    spawnEntity(world, spawned)

gDropStack = proc(world: World; position: BlockPos; stack: ItemStack) {.closure.} =
  dropStack(world, position, stack)

gScatterStack = proc(world: World; x, y, z: float64; stack: ItemStack) {.closure.} =
  scatterStack(world, x, y, z, stack)
