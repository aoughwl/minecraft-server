## Port of pumpkin/src/entity/mob/bat.rs

import std/[math, options]
import ../../../data/block_state
import ../../../generated/tag
import ../../../nbt/tag as nbttag
import ../../../util/math/mathmod
import ../../../world/chunkdata
import ../ai/aibase
import mobvts

const
  RoostingFlag = 1'u8
  ClosePlayerDistance = 4.0'f64
  MinAmbientSoundDelay = 80'i32  ## Vanilla: `getMinAmbientSoundDelay()` returns 80 for most mobs

type
  BatEntity* = ref object of Mob
    hangingPosition*: Option[BlockPos]
    roosting*: bool
    ambientSoundChance*: int32

proc setRoostingMetadata(roosting: bool) =
  # TODO upstream: send ID_FLAGS
  discard

proc checkBatSpawnRules*(world: World; pos: BlockPos): bool =
  if pos.y >= getHeightmapHeight(world, chmWorldSurface, pos.x, pos.z):
    return false
  # Upstream: `rand::random_bool(1.0)`, so this is always taken and no bat passes.
  if randomF64() < 1.0:
    return false
  if int32(getMaxLocalRawBrightness(world, pos)) > randomRange(0'i32, 4'i32):
    return false
  if hasTag(uint16(world.getBlock(pos).id), Block_MINECRAFT_BATS_SPAWNABLE_ON):
    return false
  # TODO upstream: check_mob_spawn_rules(entity_type, world, spawn_reason, pos).await
  true

proc isRoosting*(self: BatEntity): bool =
  self.roosting

proc setRoosting*(self: BatEntity; roosting: bool) =
  self.roosting = roosting
  setRoostingMetadata(roosting)

proc signum(v: float64): float64 =
  ## `f64::signum`: 1.0 for +0.0 and anything positive.
  if v < 0.0 or (v == 0.0 and 1.0 / v < 0.0): -1.0 else: 1.0

proc batMobTick(self: BatEntity) =
  let entity = self.mobEntity.livingEntity.entity
  let blockPos = entity.blockPos
  let abovePos = newBlockPos(blockPos.x, blockPos.y + 1'i32, blockPos.z)
  let world = entity.world

  # Ambient idle sound (vanilla: MobEntity.mobTick -> playAmbientSound)
  let chance = self.ambientSoundChance
  self.ambientSoundChance = chance - 1'i32
  if chance <= 0'i32:
    self.ambientSoundChance = MinAmbientSoundDelay
    entity.playSound(sdEntityBatAmbient)

  if self.isRoosting():
    let aboveState = getBlockStateAt(world, abovePos)
    if aboveState.isSolidBlock():
      if randomRange(0'i32, 200'i32) == 0'i32:
        entity.headYaw = float32(randomRange(0'i32, 360'i32))

      if getClosestPlayer(world, entity.pos, ClosePlayerDistance) != nil:
        self.setRoosting(false)
    else:
      self.setRoosting(false)
  else:
    if self.hangingPosition.isSome:
      let hp = self.hangingPosition.unsafeGet
      let hpState = getBlockStateAt(world, hp)
      if not hpState.isAir() or hp.y <= world.dimension.minY:
        self.hangingPosition = none[BlockPos]()

    var closeToHanging = false
    let pickedAtRandom = randomRange(0'i32, 30'i32) == 0'i32
    if self.hangingPosition.isSome:
      let hp = self.hangingPosition.unsafeGet
      let pos = entity.pos
      let dx = float64(hp.x) + 0.5 - pos.x
      let dy = float64(hp.y) + 0.1 - pos.y
      let dz = float64(hp.z) + 0.5 - pos.z
      closeToHanging = dx * dx + dy * dy + dz * dz < 4.0
    let shouldPickNew = self.hangingPosition.isNone or pickedAtRandom or closeToHanging

    var newTarget = none[BlockPos]()
    if shouldPickNew:
      let pos = entity.pos
      let x = int32(pos.x) + randomRange(0'i32, 7'i32) - randomRange(0'i32, 7'i32)
      let y = int32(pos.y + float64(randomRange(0'i32, 6'i32)) - 2.0)
      let z = int32(pos.z) + randomRange(0'i32, 7'i32) - randomRange(0'i32, 7'i32)
      newTarget = some(newBlockPos(x, y, z))
    let tryRoost = randomRange(0'i32, 100'i32) == 0'i32

    if shouldPickNew:
      # Pre-validate: only accept targets in air (avoids water, lava, hazards)
      if newTarget.isSome:
        let target = newTarget.unsafeGet
        let targetState = getBlockStateAt(world, target)
        if targetState.isAir() and target.y > world.dimension.minY:
          self.hangingPosition = some(target)
        else:
          self.hangingPosition = none[BlockPos]()
      else:
        self.hangingPosition = none[BlockPos]()

    if self.hangingPosition.isSome:
      let target = self.hangingPosition.unsafeGet
      let pos = entity.pos
      let d = float64(target.x) + 0.5 - pos.x
      let e = float64(target.y) + 0.1 - pos.y
      let f = float64(target.z) + 0.5 - pos.z

      let velo = entity.velocity
      let newVelo = Vector3[float64](
        x: velo.x + (signum(d) * 0.5 - velo.x) * 0.1,
        y: velo.y + (signum(e) * 0.7 - velo.y) * 0.1,
        z: velo.z + (signum(f) * 0.5 - velo.z) * 0.1)
      entity.velocity = newVelo

      let yaw = toDegreesF32(float32(arctan2(newVelo.z, newVelo.x))) - 90.0'f32
      let yawDiff = wrapDegrees(yaw - entity.yaw)
      entity.yaw = entity.yaw + yawDiff

    if tryRoost:
      let aboveState = getBlockStateAt(world, abovePos)
      if aboveState.isSolidBlock():
        self.setRoosting(true)

proc makeBatMobVt(): MobVt =
  result = newMobVt()
  result.mobTick = proc(self: Mob; caller: EntityBase) {.closure.} =
    let bat = BatEntity(self)
    batMobTick(bat)
  result.postTick = proc(self: Mob) {.closure.} =
    let bat = BatEntity(self)
    if bat.isRoosting():
      let entity = self.mobEntity.livingEntity.entity
      entity.velocity = Vector3[float64](x: 0.0, y: 0.0, z: 0.0)
      let pos = entity.pos
      let snappedY = floor(pos.y) + 1.0 - float64(entity.height())
      entity.setPos(Vector3[float64](x: pos.x, y: snappedY, z: pos.z))
  result.getMobGravity = proc(self: Mob): float64 {.closure.} = 0.0
  result.getMobYVelocityDrag = proc(self: Mob): Option[float64] {.closure.} = some(0.6)
  result.onDamage = proc(self: Mob; damageType: DamageType; source: nil EntityBase) {.closure.} =
    let bat = BatEntity(self)
    if bat.isRoosting():
      bat.setRoosting(false)

proc makeBatVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let bat = BatEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    let flags = if bat.isRoosting(): RoostingFlag else: 0'u8
    nbt.putByte("BatFlags", int8(flags))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let bat = BatEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    let flags0 = nbt.getByte("BatFlags")
    let flags = if flags0.isSome: cast[uint8](flags0.unsafeGet) else: 0'u8
    bat.setRoosting((flags and RoostingFlag) != 0'u8)

let batMobVt = makeBatMobVt()
let batVt = makeBatVt()

proc newBatEntity*(entity: Entity): BatEntity =
  result = BatEntity(hangingPosition: none[BlockPos](), roosting: true, ambientSoundChance: MinAmbientSoundDelay)
  result.initMob(newMobEntity(entity), batMobVt, batVt)
  setRoostingMetadata(true)
