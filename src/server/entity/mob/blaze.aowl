## Port of pumpkin/src/entity/mob/blaze.rs

import ../ai/aibase
import ../ai/goal/[blaze_attack, look_around, look_at_entity, swim, track_target, wander_around]
import mobvts

type
  BlazeEntity* = ref object of Mob

proc setCharged*(self: BlazeEntity; charged: bool) =
  # TODO upstream: send the flags byte
  discard

proc newBlazeEntity*(entity: Entity): BlazeEntity =
  result = BlazeEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector

  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(4'u8, newBlazeShootFireballGoal(result))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(8'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(8'u8, newRandomLookAroundGoal())

  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
