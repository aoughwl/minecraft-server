## The blaze apart from mobfamilytest.aowl, since ai/goal/blaze_attack.aowl fails in gcc for now: see the report. Generated like that test.

import std/[assertions, math]
from ../../../generated/attributes import MAX_HEALTH, MOVEMENT_SPEED, ATTACK_DAMAGE, ARMOR, FOLLOW_RANGE, KNOCKBACK_RESISTANCE, STEP_HEIGHT, GRAVITY
import ../ai/aibase
import ../ai/goal/[blaze_attack, look_around, look_at_entity, swim, track_target, wander_around]
import testworld
import blaze


let server = newTestServer()
let world0 = newTestWorld(server, "blazetest")

proc near32(a, b: float32): bool =
  abs(a - b) < 1.0e-5'f32

block m0: # blaze
  let m = newBlazeEntity(newEntity(world0, pos3(0.5, 80.0, 0.5), EntityType.BLAZE))
  let mob = asMob(m)
  let goals = m.mobEntity.goalsSelector.goals
  let targets = m.mobEntity.targetSelector.goals
  assert goals.len == 5
  assert targets.len == 1
  assert goals[0].priority == 0'u8 and goals[0].goal of SwimGoal
  assert goals[1].priority == 4'u8 and goals[1].goal of BlazeShootFireballGoal
  assert goals[2].priority == 5'u8 and goals[2].goal of WanderAroundGoal
  assert goals[3].priority == 8'u8 and goals[3].goal of LookAtEntityGoal
  assert goals[4].priority == 8'u8 and goals[4].goal of RandomLookAroundGoal
  assert targets[0].priority == 2'u8 and targets[0].goal of ActiveTargetGoal
  let living = m.mobEntity.livingEntity
  assert near32(living.health, 20.0'f32)
  assert near(living.getAttributeValue(MAX_HEALTH), 20.0)
  assert near(living.getAttributeValue(MOVEMENT_SPEED), 0.23000000417232513)
  assert near(living.getAttributeValue(ATTACK_DAMAGE), 6.0)
  assert near(living.getAttributeValue(ARMOR), 0.0)
  assert near(living.getAttributeValue(FOLLOW_RANGE), 48.0)
  assert near(living.getAttributeValue(KNOCKBACK_RESISTANCE), 0.0)
  assert near(living.getAttributeValue(STEP_HEIGHT), 0.6)
  assert near(living.getAttributeValue(GRAVITY), 0.08)
  let base = asBase(m)
  for tick in 0 ..< 40:
    if m.entity.isAlive():
      base.tick(base, server)
  assert m.mobEntity == mob.getMobEntity()
