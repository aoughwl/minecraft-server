## Port of pumpkin/src/entity/mob/cave_spider.rs

import ../ai/aibase
import mobvts, spider

type
  CaveSpiderEntity* = ref object of Mob
    spider*: SpiderEntity

proc newCaveSpiderEntity*(entity: Entity): CaveSpiderEntity =
  let spider0 = newSpiderEntity(entity)
  result = CaveSpiderEntity(spider: spider0)
  # `get_mob_entity` answers the inner spider's MobEntity.
  # TODO upstream: Poison effect on attack
  result.initMob(spider0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
