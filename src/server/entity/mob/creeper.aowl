## Port of pumpkin/src/entity/mob/creeper.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../generated/[item_full, meta_data_type, tracked_data]
import ../../../nbt/tag as nbttag
import ../../../protocol/varint
import ../../world/explosion
import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, melee_attack, misc_goals, swim, track_target, wander_around]
import mobvts

const
  DefaultFuseTime = 30'i32
  DefaultExplosionRadius = 3'i32

type
  CreeperEntity* = ref object of Mob
    fuseSpeed*: int32
    currentFuseTime*: int32
    lastFuseTime*: int32
    fuseTime*: int32
    explosionRadius*: int32
    ignited*: bool
    charged*: bool

proc setFuseSpeed*(self: CreeperEntity; speed: int32) =
  self.fuseSpeed = speed
  self.mobEntity.livingEntity.entity.sendMetaData(TD_CREEPER_SWELL, TD_INT, newVarInt(speed))

proc explode(self: CreeperEntity) =
  let entity = self.mobEntity.livingEntity.entity
  let radius = float32(self.explosionRadius)
  let multiplier = if self.charged: 2.0'f32 else: 1.0'f32
  self.mobEntity.livingEntity.dead = true
  explosion.explode(entity.world, entity.pos, radius * multiplier)
  # TODO upstream: spawn area effect cloud with potion effects
  entity.remove()

proc creeperMobTick(self: CreeperEntity) =
  let entity = self.mobEntity.livingEntity.entity
  if not entity.isAlive():
    return

  self.lastFuseTime = self.currentFuseTime

  if self.ignited:
    self.setFuseSpeed(1'i32)

  let fuseSpeed = self.fuseSpeed
  let current = self.currentFuseTime

  if fuseSpeed > 0'i32 and current == 0'i32:
    playSoundFine(entity.world, sdEntityCreeperPrimed, scHostile, entity.pos, 1.0'f32, 0.5'f32)

  let fuseTime = self.fuseTime
  let newFuse = max(current + fuseSpeed, 0'i32)
  self.currentFuseTime = newFuse

  if newFuse >= fuseTime:
    self.currentFuseTime = fuseTime
    self.explode()

proc makeCreeperMobVt(): MobVt =
  result = newMobVt()
  result.mobTick = proc(self: Mob; caller: EntityBase) {.closure.} =
    let creeper = CreeperEntity(self)
    creeperMobTick(creeper)
  result.mobInteract = proc(self: Mob; player: Player; itemStack: var ItemStack): bool {.closure.} =
    let creeper = CreeperEntity(self)
    if itemStack.item.id != ITEM_FLINT_AND_STEEL.id:
      return self.mobEntity.mobInteractDefault(player, itemStack)

    let entity = self.mobEntity.livingEntity.entity

    playSoundFine(entity.world, sdItemFlintandsteelUse, scHostile, entity.pos, 1.0'f32, randomF32() * 0.4'f32 + 0.8'f32)

    creeper.ignited = true
    entity.sendMetaData(TD_CREEPER_IGNITED, BOOLEAN, true)

    if player.gamemode != Creative:
      # TODO upstream: Handle DamageResult::Broken to broadcast item break and update player slot.
      discard itemStack.damageItem(1'i32)

    true

proc makeCreeperVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let creeper = CreeperEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    nbt.putBool("powered", creeper.charged)
    nbt.putShort("Fuse", int16(creeper.fuseTime))
    nbt.putByte("ExplosionRadius", int8(creeper.explosionRadius))
    nbt.putBool("ignited", creeper.ignited)
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let creeper = CreeperEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    let powered = nbt.getBool("powered")
    if powered.isSome:
      creeper.charged = powered.unsafeGet
    let fuse = nbt.getShort("Fuse")
    if fuse.isSome:
      creeper.fuseTime = int32(fuse.unsafeGet)
    let radius = nbt.getByte("ExplosionRadius")
    if radius.isSome:
      creeper.explosionRadius = int32(radius.unsafeGet)
    let ignited = nbt.getBool("ignited")
    if ignited.isSome:
      creeper.ignited = ignited.unsafeGet

let creeperMobVt = makeCreeperMobVt()
let creeperVt = makeCreeperVt()

proc newCreeperEntity*(entity: Entity): CreeperEntity =
  result = CreeperEntity(fuseSpeed: -1'i32, currentFuseTime: 0'i32, lastFuseTime: 0'i32, fuseTime: DefaultFuseTime,
    explosionRadius: DefaultExplosionRadius, ignited: false, charged: false)
  result.initMob(newMobEntity(entity), creeperMobVt, creeperVt)
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  let creeper = result

  # `CreeperIgniteGoal` holds an `Arc<CreeperEntity>` upstream; misc_goals cannot import this module, so it takes these two.
  proc fuseSpeedOf(): int32 {.closure.} = creeper.fuseSpeed
  proc setFuseSpeedOf(speed: int32) {.closure.} = creeper.setFuseSpeed(speed)

  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newCreeperIgniteGoal(fuseSpeedOf, setFuseSpeedOf))
  goalSelector.addGoal(4'u8, newMeleeAttackGoal(1.0, false))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(0.8))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(6'u8, newRandomLookAroundGoal())

  targetSelector.addGoal(1'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
  targetSelector.addGoal(2'u8, newRevengeGoal(true))
