    Enchantment.SMITE,
    Enchantment.BANE_OF_ARTHROPODS,
    Enchantment.KNOCKBACK,
    Enchantment.FIRE_ASPECT,
    Enchantment.LOOTING,
    Enchantment.SWEEPING_EDGE,
    Enchantment.UNBREAKING,
    Enchantment.MENDING]

