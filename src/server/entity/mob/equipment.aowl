## Port of pumpkin/src/entity/mob/equipment.rs
##
## Mob spawn equipment system.
##
## This module handles the automatic equipping of mobs when they spawn, matching vanilla Minecraft's
## `populateDefaultEquipmentSlots` and `populateDefaultEquipmentEnchantments` behaviour. It features:
##
## - A data-driven `EQUIPMENT_REGISTRY` mapping mob types to their weapon/armor configurations (upstream's comment says
##   13; it holds 12).
## - Exact vanilla `RegionalDifficulty` computation (game time, chunk inhabited time, moon phase).
## - Weighted enchantment selection with exclusive-set conflict resolution and cost-based level determination.
## - Per-slot drop chances with looting bonus on death.
##
## Mobs not listed in the registry spawn with no equipment, matching vanilla (not all mob types have equipment
## definitions).
##
## Upstream's `exclusive_set.0` is the tag's member keys; here the tag's ids are compared, which is the same set.

import std/[math, options, strutils, tables]
import "../../../data/item_stack/mod"
import ../../../data/data_component_impl/impl_base
from ../../../generated/enchantment as enchdata import Enchantment, calculate, SHARPNESS, SMITE, BANE_OF_ARTHROPODS,
  KNOCKBACK, FIRE_ASPECT, LOOTING, SWEEPING_EDGE, UNBREAKING, MENDING, IMPALING, CHANNELING, RIPTIDE, LOYALTY, POWER,
  PUNCH, FLAME, INFINITY, QUICK_CHARGE, MULTISHOT, PIERCING, LUCK_OF_THE_SEA, LURE, PROTECTION, FIRE_PROTECTION,
  BLAST_PROTECTION, PROJECTILE_PROTECTION, RESPIRATION, AQUA_AFFINITY, THORNS, SWIFT_SNEAK, FEATHER_FALLING,
  DEPTH_STRIDER, FROST_WALKER, SOUL_SPEED
from ../../../generated/enchantment as enchdata import `==`
import ../../../generated/item_refs as itemrefs
import ../../../generated/tag as tagdata
import ../../../inventory/entity_equipment
import ../../../util/difficulty
import ../ai/aibase

const
  WearingArmorChance* = 0.15'f32
    ## Base chance (before `specialMultiplier` scaling) that a mob will wear armor. `Mob.MAX_WEARING_ARMOR_CHANCE`.
  ArmorUpgradeMaterialChance* = 0.1087'f32
    ## Chance per attempt to promote the armor tier to the next material. `Mob.WEARING_ARMOR_UPGRADE_MATERIAL_CHANCE`.
  ArmorUpgradeMaterialAttempts* = 3.0'f32
    ## Maximum number of upgrade attempts for armor tier selection. `Mob.WEARING_ARMOR_UPGRADE_MATERIAL_ATTEMPTS`.
  DefaultEquipmentDropChance* = 0.085'f32
    ## Default per-slot drop chance for equipment on mob death. `Mob.DEFAULT_EQUIPMENT_DROP_CHANCE`.
  WeaponEnchantChance* = 0.25'f32
    ## Base chance (before `specialMultiplier`) for weapon enchantments at spawn. `Mob.MAX_ENCHANTED_WEAPON_CHANCE`.
  ArmorEnchantChance* = 0.5'f32
    ## Base chance (before `specialMultiplier`) for armor enchantments at spawn. `Mob.MAX_ENCHANTED_ARMOR_CHANCE`.
  MobSpawnEnchantMinCost* = 5'i32
    ## Minimum enchantment cost for mob spawn equipment. From vanilla `mob_spawn_equipment.json`.
  MobSpawnEnchantCostSpan* = 17'i32
    ## Cost span added to the minimum, scaled by `specialMultiplier`. From vanilla `mob_spawn_equipment.json`.
  ArmorPopulationOrder* = [esHead, esChest, esLegs, esFeet]

type
  WeaponEntry* = object
    ## A weighted entry in a weapon selection table.
    ## Matches vanilla's weighted random selection in mob `populateDefaultEquipmentSlots`.
    item*: Item     ## The item to potentially give.
    weight*: float32  ## Relative weight in the selection pool.

  WeaponConfigKind* = enum
    wcAlways          ## Always give this exact item (e.g. skeleton -> bow).
    wcAlwaysWeighted  ## Always give one of the weighted items (e.g. piglin weapons).
    wcChance          ## Give a weighted weapon with a difficulty-dependent chance.
    wcNone            ## No weapon.

  WeaponConfig* = object
    ## How a mob's main-hand weapon is selected on spawn.
    kind*: WeaponConfigKind
    item*: nil Item           ## `Always`
    items*: seq[WeaponEntry]  ## `AlwaysWeighted`, `Chance`: weighted item pool to select from.
    onHard*: float32          ## `Chance`: chance when the base difficulty is Hard.
    otherwise*: float32       ## `Chance`: chance on all other difficulties.

  ArmorSlotEntry* = object
    ## A per-slot armor entry with an independent spawn chance.
    slot*: EquipmentSlot  ## Which equipment slot this armor occupies.
    item*: Item           ## The armor item.
    chance*: float32      ## Independent chance this slot receives armor.

  ArmorConfigKind* = enum
    acVanilla        ## The vanilla algorithm: see `selectVanillaArmor`.
    acCustomPerSlot  ## Custom per-slot entries with independent chances (e.g. piglin golden armor).
    acNone           ## No armor.

  ArmorConfig* = object
    ## How a mob's armor is selected on spawn.
    kind*: ArmorConfigKind
    entries*: seq[ArmorSlotEntry]

  MobEquipmentDef* = object
    ## Equipment definition for a single mob type. All equipment is randomized at spawn using `RegionalDifficulty` to
    ## compute per-world/per-chunk scaling factors.
    entityType*: string   ## The entity resource name (e.g. `"zombie"`, `"skeleton"`).
    weapon*: WeaponConfig ## Main-hand weapon configuration.
    armor*: ArmorConfig   ## Armor configuration.
    enchanted*: bool      ## Whether spawn-time enchantments can be applied.
    canPickUpLoot*: bool  ## Whether this mob can randomly pick up loot from the ground.

  RegionalDifficulty* = object
    ## Computed difficulty values for a specific world chunk.
    ##
    ## Mirrors Vanilla's `DifficultyInstance`. Used to scale equipment spawn rates, enchantment costs, and loot-pickup
    ## flags.
    baseDifficulty*: Difficulty    ## The world's base difficulty level (`Easy`, `Normal`, `Hard`).
    effectiveDifficulty*: float32
      ## Effective difficulty computed from game time, inhabited time, and moon phase. Clamped to the range `[2.0, 4.0]`
      ## (or `0.0` for Peaceful).
    specialMultiplier*: float32
      ## Linear multiplier in `[0.0, 1.0]` derived from `effective_difficulty`. When `0.0` (fresh chunk + early game), no
      ## equipment, enchantments, or loot-pickup flags are applied.

  EquipmentPiece* = object
    slot*: EquipmentSlot
    stack*: ItemStack
    dropChance*: float32

proc armorTiers(): seq[array[4, Item]] =
  @[[ITEM_LEATHER_HELMET, ITEM_LEATHER_CHESTPLATE, ITEM_LEATHER_LEGGINGS, ITEM_LEATHER_BOOTS],
    [ITEM_COPPER_HELMET, ITEM_COPPER_CHESTPLATE, ITEM_COPPER_LEGGINGS, ITEM_COPPER_BOOTS],
    [ITEM_GOLDEN_HELMET, ITEM_GOLDEN_CHESTPLATE, ITEM_GOLDEN_LEGGINGS, ITEM_GOLDEN_BOOTS],
    [ITEM_CHAINMAIL_HELMET, ITEM_CHAINMAIL_CHESTPLATE, ITEM_CHAINMAIL_LEGGINGS, ITEM_CHAINMAIL_BOOTS],
    [ITEM_IRON_HELMET, ITEM_IRON_CHESTPLATE, ITEM_IRON_LEGGINGS, ITEM_IRON_BOOTS],
    [ITEM_DIAMOND_HELMET, ITEM_DIAMOND_CHESTPLATE, ITEM_DIAMOND_LEGGINGS, ITEM_DIAMOND_BOOTS]]

