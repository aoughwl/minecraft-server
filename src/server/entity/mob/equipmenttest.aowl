## Known answers read from pumpkin/src/entity/mob/equipment.rs. Upstream has no #[test] here. The registry's rows are
## checked against the Rust by name, because they decide what a mob spawns holding.

import std/[assertions, math, options, tables]
import "../../../data/item_stack/mod"
import ../../../data/data_component_impl/impl_base
from ../../../generated/enchantment as enchdata import Enchantment, SHARPNESS, SMITE, UNBREAKING, POWER, IMPALING, THORNS,
  RESPIRATION, SWIFT_SNEAK, FROST_WALKER, LURE, MULTISHOT
import ../../../util/difficulty
import ../entitymod
import ../../../inventory/entity_equipment
import equipment, testworld

proc closeTo(a, b: float32): bool =
  abs(a - b) < 1.0e-5'f32

# `moon_brightness`: 1 at phase 0, then |phase - 4| / 4 off of 1.
assert moonBrightness(0'i64) == 1.0'f32
assert moonBrightness(24000'i64) == 0.25'f32
assert moonBrightness(4'i64 * 24000'i64) == 1.0'f32
assert moonBrightness(2'i64 * 24000'i64) == 0.5'f32
assert moonBrightness(8'i64 * 24000'i64) == 1.0'f32

# `calculate`. Peaceful is all zero.
let peaceful = calculateRegionalDifficulty(Peaceful, 10000000'i64, 10000000'u64, 1.0'f32)
assert peaceful.effectiveDifficulty == 0.0'f32 and peaceful.specialMultiplier == 0.0'f32

# A fresh Normal world0: 2 * 0.75 = 1.5, under 2, so no special multiplier.
let fresh = calculateRegionalDifficulty(Normal, 0'i64, 0'u64, 1.0'f32)
assert closeTo(fresh.effectiveDifficulty, 1.5'f32)
assert fresh.specialMultiplier == 0.0'f32
assert not fresh.shouldHappen(1.0'f32)

# Maxed out on Hard: 3 * (1.0 + 1.0 + 0.25) = 6.75, multiplier capped at 1.
let maxed = calculateRegionalDifficulty(Hard, 72000'i64 + 1440000'i64, 3600000'u64, 1.0'f32)
assert closeTo(maxed.effectiveDifficulty, 6.75'f32)
assert maxed.specialMultiplier == 1.0'f32

# Easy halves the local scale: 1 * (1.0 + (0.75 + 0.25) * 0.5) = 1.5.
let easy = calculateRegionalDifficulty(Easy, 72000'i64 + 1440000'i64, 3600000'u64, 1.0'f32)
assert closeTo(easy.effectiveDifficulty, 1.5'f32)

# In between: Normal with half the inhabited time and no moon: 2 * (0.75 + 0.75 * 0.5) = 2.25 -> 0.125.
let mid = calculateRegionalDifficulty(Normal, 0'i64, 1800000'u64, 0.0'f32)
assert closeTo(mid.effectiveDifficulty, 2.25'f32)
assert closeTo(mid.specialMultiplier, 0.125'f32)

# The moon adds no more than the global scale, which is 0 at time 0.
assert closeTo(calculateRegionalDifficulty(Normal, 0'i64, 0'u64, 1.0'f32).effectiveDifficulty, 1.5'f32)

# Constants.
assert WearingArmorChance == 0.15'f32
assert ArmorUpgradeMaterialChance == 0.1087'f32
assert ArmorUpgradeMaterialAttempts == 3.0'f32
assert equipment.DefaultEquipmentDropChance == 0.085'f32
assert WeaponEnchantChance == 0.25'f32
assert ArmorEnchantChance == 0.5'f32
assert MobSpawnEnchantMinCost == 5'i32
assert MobSpawnEnchantCostSpan == 17'i32
assert ArmorPopulationOrder == [esHead, esChest, esLegs, esFeet]

# `spawn_enchant_cost`: the range ends move with the multiplier.
for i in 0 ..< 50:
  assert spawnEnchantCost(0.0'f32) == 5'i32
  let c = spawnEnchantCost(1.0'f32)
  assert c >= 5'i32 and c <= 22'i32

proc alwaysId(d: MobEquipmentDef): int =
  ## The item of a `WeaponConfig::Always`, or -1.
  let item = d.weapon.item
  if item == nil: -1 else: int(item.id)

# The registry, row by row as upstream inserts them.
assert EquipmentRegistry.len == 12

proc row(name: string): MobEquipmentDef =
  assert EquipmentRegistry.hasKey(name)
  result = EquipmentRegistry.getOrDefault(name)
  assert result.entityType == name

for name in ["zombie", "husk", "zombie_villager"]:
  let d = row(name)
  assert d.weapon.kind == wcChance
  assert d.weapon.onHard == 0.05'f32 and d.weapon.otherwise == 0.01'f32
  assert d.weapon.items.len == 3
  assert d.weapon.items[0].item.id == ITEM_IRON_SWORD.id and d.weapon.items[0].weight == 1.0'f32
  assert d.weapon.items[1].item.id == ITEM_IRON_SPEAR.id and d.weapon.items[1].weight == 1.0'f32
  assert d.weapon.items[2].item.id == ITEM_IRON_SHOVEL.id and d.weapon.items[2].weight == 4.0'f32
  assert d.armor.kind == acVanilla
  assert d.enchanted and d.canPickUpLoot

let drowned = row("drowned")
assert drowned.weapon.kind == wcChance and drowned.weapon.onHard == 0.10'f32 and drowned.weapon.otherwise == 0.10'f32
assert drowned.weapon.items[0].item.id == ITEM_TRIDENT.id and drowned.weapon.items[0].weight == 10.0'f32
assert drowned.weapon.items[1].item.id == ITEM_FISHING_ROD.id and drowned.weapon.items[1].weight == 6.0'f32
assert drowned.armor.kind == acNone and drowned.enchanted and drowned.canPickUpLoot

let zombified = row("zombified_piglin")
assert zombified.weapon.kind == wcAlwaysWeighted
assert zombified.weapon.items[0].item.id == ITEM_GOLDEN_SWORD.id and zombified.weapon.items[0].weight == 19.0'f32
assert zombified.weapon.items[1].item.id == ITEM_GOLDEN_SPEAR.id and zombified.weapon.items[1].weight == 1.0'f32
assert zombified.armor.kind == acNone and zombified.enchanted and not zombified.canPickUpLoot

for name in ["skeleton", "stray", "bogged"]:
  let d = row(name)
  assert d.weapon.kind == wcAlways and alwaysId(d) == int(ITEM_BOW.id)
  assert d.armor.kind == acVanilla and d.enchanted and d.canPickUpLoot

let wither = row("wither_skeleton")
assert wither.weapon.kind == wcAlways and alwaysId(wither) == int(ITEM_STONE_SWORD.id)
assert wither.armor.kind == acNone and not wither.enchanted and not wither.canPickUpLoot

let piglin = row("piglin")
assert piglin.weapon.kind == wcAlwaysWeighted
assert piglin.weapon.items[0].item.id == ITEM_CROSSBOW.id and piglin.weapon.items[0].weight == 5.0'f32
assert piglin.weapon.items[1].item.id == ITEM_GOLDEN_SWORD.id and piglin.weapon.items[1].weight == 4.5'f32
assert piglin.weapon.items[2].item.id == ITEM_GOLDEN_SPEAR.id and piglin.weapon.items[2].weight == 0.5'f32
assert piglin.armor.kind == acCustomPerSlot and piglin.armor.entries.len == 4
assert piglin.armor.entries[0].slot == esHead and piglin.armor.entries[0].item.id == ITEM_GOLDEN_HELMET.id
assert piglin.armor.entries[3].slot == esFeet and piglin.armor.entries[3].item.id == ITEM_GOLDEN_BOOTS.id
assert piglin.armor.entries[2].chance == 0.1'f32
assert piglin.enchanted and not piglin.canPickUpLoot

let pillager = row("pillager")
assert alwaysId(pillager) == int(ITEM_CROSSBOW.id)
assert pillager.armor.kind == acNone and not pillager.enchanted and not pillager.canPickUpLoot

let vindicator = row("vindicator")
assert alwaysId(vindicator) == int(ITEM_IRON_AXE.id)
assert vindicator.armor.kind == acNone and vindicator.enchanted and not vindicator.canPickUpLoot

assert not EquipmentRegistry.hasKey("creeper")

# `enchant_pool_for`, including upstream's order: "crossbow" contains "bow".
assert enchantPoolFor(ITEM_IRON_SWORD, esMainHand).len == 9
assert enchantPoolFor(ITEM_IRON_SWORD, esMainHand)[0].registryKey == Enchantment.SHARPNESS.registryKey
assert enchantPoolFor(ITEM_TRIDENT, esMainHand).len == 6
assert enchantPoolFor(ITEM_TRIDENT, esMainHand)[0].registryKey == Enchantment.IMPALING.registryKey
assert enchantPoolFor(ITEM_BOW, esMainHand).len == 6
assert enchantPoolFor(ITEM_BOW, esMainHand)[0].registryKey == Enchantment.POWER.registryKey
assert enchantPoolFor(ITEM_CROSSBOW, esMainHand)[0].registryKey == Enchantment.POWER.registryKey
assert enchantPoolFor(ITEM_FISHING_ROD, esMainHand).len == 4
assert enchantPoolFor(ITEM_LEATHER_HELMET, esHead).len == 9
assert enchantPoolFor(ITEM_LEATHER_CHESTPLATE, esChest).len == 7
assert enchantPoolFor(ITEM_LEATHER_LEGGINGS, esLegs).len == 8
assert enchantPoolFor(ITEM_LEATHER_BOOTS, esFeet).len == 11
assert enchantPoolFor(ITEM_LEATHER_BOOTS, esOffHand).len == 0

# Exclusive sets: sharpness and smite are in the damage set.
assert conflictsWith(Enchantment.SMITE, @[Enchantment.SHARPNESS])
assert not conflictsWith(Enchantment.SMITE, @[Enchantment.UNBREAKING])
assert not conflictsWith(Enchantment.UNBREAKING, @[Enchantment.SHARPNESS]), "unbreaking has no set"

# `enchantment_level_from_cost`: sharpness costs 1 + 11 per level above the first.
assert enchantmentLevelFromCost(Enchantment.SHARPNESS, 0'i32) == 1'i32, "nothing affordable still answers 1"
assert enchantmentLevelFromCost(Enchantment.SHARPNESS, 12'i32) == 2'i32
assert enchantmentLevelFromCost(Enchantment.SHARPNESS, 100'i32) == Enchantment.SHARPNESS.maxLevel

# A sword enchanted at full multiplier takes at least one, and no two from the damage set.
for i in 0 ..< 50:
  var stack = newItemStack(1'u8, ITEM_IRON_SWORD)
  applyVanillaEnchantments(stack, esMainHand, 1.0'f32)
  assert stack.hasEnchantments()

# `weighted_select_item` only ever gives what is in the table, and covers it.
var seen = [false, false, false]
for i in 0 ..< 500:
  let item = weightedSelectItem(row("zombie").weapon.items)
  if item.id == ITEM_IRON_SWORD.id: seen[0] = true
  elif item.id == ITEM_IRON_SPEAR.id: seen[1] = true
  elif item.id == ITEM_IRON_SHOVEL.id: seen[2] = true
  else: assert false
assert seen[0] and seen[1] and seen[2]

# `select_vanilla_armor`: always a head, order held, one tier, every piece at the default drop chance.
for i in 0 ..< 100:
  let pieces = selectVanillaArmor(maxed)
  assert pieces.len >= 1 and pieces.len <= 4
  for at in 0 ..< pieces.len:
    assert pieces[at].slot == ArmorPopulationOrder[at]
    assert pieces[at].dropChance == equipment.DefaultEquipmentDropChance
    assert pieces[at].stack.itemCount == 1'u8

# `equip_mob_from_def`: an always-weapon with no enchant chance is exact.
let noEnchant = equipMobFromDef(row("pillager"), fresh)
assert noEnchant.len == 1
assert noEnchant[0].slot == esMainHand
assert noEnchant[0].stack.item.id == ITEM_CROSSBOW.id
assert noEnchant[0].dropChance == equipment.DefaultEquipmentDropChance

# Fresh Normal: multiplier 0, so no vanilla armor and no enchants, however many tries.
for i in 0 ..< 50:
  let skeleton = equipMobFromDef(row("skeleton"), fresh)
  assert skeleton.len == 1
  assert not skeleton[0].stack.hasEnchantments()

# `equip_mob_on_spawn` through a world0: the stack lands in the slot with its drop chance. No registry entry: nothing.
let server = newTestServer()
let world0 = newTestWorld(server, "equipmenttest")
let pillagerLiving = newLivingEntity(newEntity(world0, pos3(0.0, 80.0, 0.0), EntityType.PILLAGER))
equipMobOnSpawn(livingBaseOf(pillagerLiving), world0)
assert pillagerLiving.entityEquipment.get(esMainHand).item.id == ITEM_CROSSBOW.id
assert pillagerLiving.equipmentDropChances.getOrDefault(ord(esMainHand), 0.0'f32) == equipment.DefaultEquipmentDropChance
let creeperLiving = newLivingEntity(newEntity(world0, pos3(0.0, 80.0, 0.0), EntityType.CREEPER))
equipMobOnSpawn(livingBaseOf(creeperLiving), world0)
assert creeperLiving.entityEquipment.get(esMainHand).isEmpty()
# A bare `dyn EntityBase` with no `LivingEntity` returns early.
equipMobOnSpawn(entityBaseOf(newEntity(world0, pos3(0.0, 80.0, 0.0), EntityType.PILLAGER)), world0)
