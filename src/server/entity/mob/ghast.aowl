## Port of pumpkin/src/entity/mob/ghast.rs

import std/math
import ../ai/aibase
import mobvts

type
  GhastEntity* = ref object of Mob
    isCharging0*: bool
    explosionPower*: uint8

  GhastLookGoal* = ref object of Goal

proc makeGhastLookVt(): GoalVt =
  result = newGoalVt()
  result.canStart = proc(self: Goal; mob: Mob): bool {.closure.} = true
  result.shouldRunEveryTick = proc(self: Goal): bool {.closure.} = true
  result.tick = proc(self: Goal; mob: Mob) {.closure.} =
    let mobEntity = mob.mobEntity
    let target = mobEntity.target
    if target != nil:
      let mobPos = mobEntity.livingEntity.entity.pos
      let targetPos = target.entity.pos
      if mobPos.squaredDistanceToVec(targetPos) < 4096.0:
        mobEntity.lookControl.lookAt(mob, targetPos.x, targetPos.y, targetPos.z)
    else:
      # If no target, face the movement direction
      let velocity = mobEntity.livingEntity.entity.velocity
      if velocity.x != 0.0 or velocity.z != 0.0:
        let yaw = float32(-arctan2(velocity.x, velocity.z) * (180.0 / PI))
        mobEntity.livingEntity.entity.yaw = yaw
  result.controls = proc(self: Goal): Controls {.closure.} = ControlsLook

let ghastLookVt* = makeGhastLookVt()

proc newGhastLookGoal*(): GhastLookGoal =
  GhastLookGoal(vt: ghastLookVt)

proc makeGhastMobVt(): MobVt =
  result = newMobVt()
  # Ghasts fly, no gravity applied in standard travel
  result.getMobGravity = proc(self: Mob): float64 {.closure.} = 0.0

let ghastMobVt = makeGhastMobVt()

proc setCharging*(self: GhastEntity; charging: bool) =
  # You would also sync this to the client via EntityMetadata here
  self.isCharging0 = charging

proc isCharging*(self: GhastEntity): bool =
  self.isCharging0

proc newGhastEntity*(entity: Entity): GhastEntity =
  result = GhastEntity(isCharging0: false, explosionPower: 1'u8)
  result.initMob(newMobEntity(entity), ghastMobVt, noNbtMobEntityVt())
  result.mobEntity.goalsSelector.addGoal(7'u8, newGhastLookGoal())
