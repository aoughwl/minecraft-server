## Port of pumpkin/src/entity/mob/giant.rs

import ../ai/aibase
import ../ai/goal/[look_around, melee_attack, swim, track_target, wander_around]
import ../mob/mobvts

type
  GiantEntity* = ref object of Mob

proc newGiantEntity*(entity: Entity): GiantEntity =
  result = GiantEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newMeleeAttackGoal(1.0, true))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
