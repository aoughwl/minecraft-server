## Port of pumpkin/src/entity/mob/illusioner.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, track_target, wander_around]
import ../mob/mobvts

type
  IllusionerEntity* = ref object of Mob

proc newIllusionerEntity*(entity: Entity): IllusionerEntity =
  result = IllusionerEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.VILLAGER, true))
  targetSelector.addGoal(3'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.IRON_GOLEM, true))
