## Port of pumpkin/src/entity/mob/magma_cube.rs
##
## Upstream's overrides forward to the inner slime's `Mob` impl. Its goals hold the inner slime, and `slimeMobVt` reads the
## slime by a `SlimeEntity(self)` cast, so these go to the inner one by name.

import ../ai/aibase
import mobvts, slime

type
  MagmaCubeEntity* = ref object of Mob
    slime*: SlimeEntity

proc makeMagmaCubeMobVt(): MobVt =
  result = newMobVt()
  result.mobTick = proc(self: Mob; caller: EntityBase) {.closure.} =
    let cube = MagmaCubeEntity(self)
    cube.slime.mobTick(caller)
  result.postTick = proc(self: Mob) {.closure.} =
    let cube = MagmaCubeEntity(self)
    cube.slime.postTick()
  result.mobPlayerCollision = proc(self: Mob; player: Player) {.closure.} =
    let cube = MagmaCubeEntity(self)
    cube.slime.mobPlayerCollision(player)

let magmaCubeMobVt = makeMagmaCubeMobVt()

proc newMagmaCubeEntity*(entity: Entity): MagmaCubeEntity =
  let slime0 = newSlimeEntity(entity)
  result = MagmaCubeEntity(slime: slime0)
  # `get_mob_entity` answers the slime's MobEntity. The slime's move control reads that same entity.
  result.initMob(slime0.mobEntity, magmaCubeMobVt, noNbtMobEntityVt())
