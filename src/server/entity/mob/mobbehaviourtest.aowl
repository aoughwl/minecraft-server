## Upstream's #[test] from pumpkin/src/entity/mob/slime.rs, and known answers read from the other hand-written mobs:
## creeper, enderman, shulker, bat, ghast, slime. mobfamilytest.aowl covers every mob's goals and attributes.

import std/[assertions, math, options]
from ../../../generated/attributes import MAX_HEALTH, MOVEMENT_SPEED, ATTACK_DAMAGE
import ../../../data/block_direction
import ../../../generated/damage_type
import ../../../nbt/tag as nbttag
import ../../../util/math/boundingbox
import ../ai/aibase
import testworld
import bat, creeper, enderman, ghast, shulker, slime

let server = newTestServer()
let world0 = newTestWorld(server, "mobbehaviourtest")

proc entityOf(entityType: EntityType): Entity =
  newEntity(world0, pos3(0.5, 80.0, 0.5), entityType)

proc close64(a, b: float64): bool =
  abs(a - b) < 1.0e-6

# uses_small_hurt_sound_only_for_smallest_slimes
assert hurtSoundForSize(1'i32) == sdEntitySlimeHurtSmall
assert hurtSoundForSize(0'i32) == sdEntitySlimeHurt
assert hurtSoundForSize(2'i32) == sdEntitySlimeHurt

block slime_size:
  let s = newSlimeEntity(entityOf(EntityType.SLIME))
  spawnEntity(world0, asBase(s))
  # `randomize_size`: a power of two, up to 4.
  assert s.getSize() == 1'i32 or s.getSize() == 2'i32 or s.getSize() == 4'i32
  s.setSize(2'i32, true)
  assert s.getSize() == 2'i32
  assert not s.isTiny()
  let living = s.mobEntity.livingEntity
  assert close64(living.getAttributeValue(MAX_HEALTH), 4.0)
  assert close64(living.getAttributeValue(ATTACK_DAMAGE), 2.0)
  assert close64(living.getAttributeValue(MOVEMENT_SPEED), float64(0.2'f32 + 0.1'f32 * 2.0'f32))
  assert living.health == 4.0'f32
  # The dimensions scale with the type's: slime is 0.52 x 0.52, eye 0.325.
  assert abs(s.entity.entityDimension.width - EntityType.SLIME.dimension[0] * 2.0'f32) < 1e-6'f32
  assert abs(s.entity.entityDimension.height - EntityType.SLIME.dimension[1] * 2.0'f32) < 1e-6'f32
  assert abs(s.entity.entityDimension.eyeHeight - EntityType.SLIME.eyeHeight * 2.0'f32) < 1e-6'f32
  # Clamped, and an update without health leaves health alone.
  s.setSize(500'i32, false)
  assert s.getSize() == 127'i32
  assert living.health == 4.0'f32
  s.setSize(0'i32, false)
  assert s.getSize() == 1'i32
  assert s.isTiny()

  var nbt = newCompound()
  s.setSize(4'i32, false)
  EntityBase(s).writeNbt(nbt)
  assert nbt.getInt("Size") == some(3'i32), "written as size - 1"
  let t = newSlimeEntity(entityOf(EntityType.SLIME))
  spawnEntity(world0, asBase(t))
  EntityBase(t).readNbt(nbt)
  assert t.getSize() == 4'i32

  # `rot_lerp`: the short way round, at most the step.
  assert rotLerp(0.0'f32, 10.0'f32, 90.0'f32) == 10.0'f32
  assert rotLerp(0.0'f32, 180.0'f32, 90.0'f32) == 90.0'f32
  assert rotLerp(0.0'f32, 350.0'f32, 90.0'f32) == -10.0'f32

block slime_moves:
  let s = newSlimeEntity(entityOf(EntityType.SLIME))
  spawnEntity(world0, asBase(s))
  let e = s.entity
  # No wish to move: the mob tick zeroes `speed_modifier` and stops any jump.
  e.onGround = true
  s.speedModifier = 1.0
  s.jumpDelay = 0'i32
  s.mobEntity.moveControl.tickImpl(s.mobEntity.moveControl, s)
  # jump_delay was 0: a jump starts, delay in 10..30.
  assert s.mobEntity.livingEntity.jumping
  assert s.jumpDelay >= 10'i32 and s.jumpDelay < 30'i32
  assert s.mobEntity.livingEntity.movementInput.z == 1.0
  # Not yet: the delay counts down, no jump.
  let delay = s.jumpDelay
  s.mobEntity.moveControl.tickImpl(s.mobEntity.moveControl, s)
  assert not s.mobEntity.livingEntity.jumping
  assert s.jumpDelay == delay - 1'i32

block slime_split:
  let s = newSlimeEntity(entityOf(EntityType.SLIME))
  spawnEntity(world0, asBase(s))
  s.setSize(4'i32, true)
  s.mobEntity.livingEntity.dead = true
  let before = allEntities(world0).len
  s.postTick()
  let spawned = allEntities(world0).len - before
  assert spawned >= 2 and spawned <= 4, "2 + random 0..3"
  # Once only.
  s.postTick()
  assert allEntities(world0).len - before == spawned

block creeper_fuse:
  let c = newCreeperEntity(entityOf(EntityType.CREEPER))
  spawnEntity(world0, asBase(c))
  assert c.fuseSpeed == -1'i32
  assert c.fuseTime == 30'i32
  assert c.explosionRadius == 3'i32
  # Lit: climbs by the speed, and only `ignited` forces the speed to 1.
  c.setFuseSpeed(1'i32)
  c.mobTick(c)
  assert c.currentFuseTime == 1'i32
  assert c.lastFuseTime == 0'i32
  c.setFuseSpeed(-1'i32)
  c.mobTick(c)
  c.mobTick(c)
  assert c.currentFuseTime == 0'i32, "floored at 0"
  c.ignited = true
  c.mobTick(c)
  assert c.fuseSpeed == 1'i32
  assert c.currentFuseTime == 1'i32

  var nbt = newCompound()
  c.charged = true
  EntityBase(c).writeNbt(nbt)
  assert nbt.getBool("powered") == some(true)
  assert nbt.getShort("Fuse") == some(30'i16)
  assert nbt.getByte("ExplosionRadius") == some(3'i8)
  assert nbt.getBool("ignited") == some(true)
  let d = newCreeperEntity(entityOf(EntityType.CREEPER))
  spawnEntity(world0, asBase(d))
  EntityBase(d).readNbt(nbt)
  assert d.charged and d.ignited

  # Reaching the fuse: dead and gone. The explosion over an empty world breaks nothing.
  let e = newCreeperEntity(entityOf(EntityType.CREEPER))
  spawnEntity(world0, asBase(e))
  e.fuseTime = 1'i32
  e.setFuseSpeed(1'i32)
  e.mobTick(e)
  assert e.mobEntity.livingEntity.dead
  assert isGone(e.entity)

block enderman_state:
  let m = newEndermanEntity(entityOf(EntityType.ENDERMAN))
  spawnEntity(world0, asBase(m))
  assert not m.isAngry()
  assert m.getCarriedBlock().isNone
  # `set_target`: angry and 0.15 faster with a target, and back without one.
  let baseSpeed = m.mobEntity.livingEntity.getAttributeValue(MOVEMENT_SPEED)
  let other = entityBaseOf(entityOf(EntityType.ZOMBIE))
  m.setTarget(other)
  assert m.isAngry()
  assert m.mobEntity.target != nil
  assert close64(m.mobEntity.livingEntity.getAttributeValue(MOVEMENT_SPEED), baseSpeed + 0.15)
  m.setTarget(other)
  assert close64(m.mobEntity.livingEntity.getAttributeValue(MOVEMENT_SPEED), baseSpeed + 0.15), "applied once"
  m.setTarget(nil)
  assert not m.isAngry()
  assert not m.provoked
  assert close64(m.mobEntity.livingEntity.getAttributeValue(MOVEMENT_SPEED), baseSpeed)

  # `set_mob_target` goes through it.
  m.setMobTarget(other)
  assert m.isAngry()
  m.setMobTarget(nil)

  # Carried block round trip, and an id off the table's end is `None`.
  m.setCarriedBlock(some(5'u16))
  var nbt = newCompound()
  EntityBase(m).writeNbt(nbt)
  assert nbt.getInt("carriedBlockState") == some(5'i32)
  let n = newEndermanEntity(entityOf(EntityType.ENDERMAN))
  spawnEntity(world0, asBase(n))
  EntityBase(n).readNbt(nbt)
  assert n.getCarriedBlock() == some(5'u16)
  var bad = entityNbt(n.entity)
  bad.putInt("carriedBlockState", 65000'i32)
  EntityBase(n).readNbt(bad)
  assert n.getCarriedBlock().isNone

  # `is_projectile_damage`.
  assert isProjectileDamage(damage_type.ARROW)
  assert not isProjectileDamage(damage_type.FALL)
  # Teleporting over nothing solid finds no ground and fails, so a projectile hit lands.
  assert not m.teleportRandomly()
  assert m.preDamage(damage_type.ARROW, nil)

block shulker_state:
  let s = newShulkerEntity(entityOf(EntityType.SHULKER))
  spawnEntity(world0, asBase(s))
  assert s.getAttachFace() == BlockDirection.Down
  assert s.color == 16'u8
  assert s.getMobGravity() == 0.0
  assert s.isClosed()
  # `axis_of`
  assert BlockDirection.East.axisOf() == axisX and BlockDirection.West.axisOf() == axisX
  assert BlockDirection.Up.axisOf() == axisY and BlockDirection.Down.axisOf() == axisY
  assert BlockDirection.North.axisOf() == axisZ and BlockDirection.South.axisOf() == axisZ
  # Peek interpolation: 0.05 a tick toward raw * 0.01.
  s.setRawPeek(100'u8)
  assert not s.isClosed()
  assert s.updatePeekAmount()
  assert abs(s.currentPeekAmount - 0.05'f32) < 1e-6'f32
  assert s.prevPeekAmount == 0.0'f32
  s.setRawPeek(0'u8)
  assert s.updatePeekAmount()
  assert abs(s.currentPeekAmount) < 1e-6'f32
  assert not s.updatePeekAmount(), "already there"

  # Closed: arrows do nothing, and 20 armor on the rest. amount 10: f1 = clamp(20 - 5, 4, 20) = 15; 10 * (1 - 15/25) = 4.
  assert not s.preDamage(damage_type.ARROW, nil)
  assert s.preDamage(damage_type.FALL, nil)
  assert abs(s.modifyIncomingDamage(10.0'f32, damage_type.MOB_ATTACK) - 4.0'f32) < 1e-5'f32
  s.setRawPeek(30'u8)
  assert s.preDamage(damage_type.ARROW, nil)
  assert s.modifyIncomingDamage(10.0'f32, damage_type.MOB_ATTACK) == 10.0'f32

  var nbt = newCompound()
  EntityBase(s).writeNbt(nbt)
  assert nbt.getByte("PeekAmount") == some(30'i8)
  assert nbt.getByte("AttachFace") == some(0'i8)
  assert nbt.getByte("Color") == some(16'i8)

block bat_state:
  let b = newBatEntity(entityOf(EntityType.BAT))
  spawnEntity(world0, asBase(b))
  assert b.isRoosting()
  assert b.getMobGravity() == 0.0
  assert b.getMobYVelocityDrag() == some(0.6)
  # Damage wakes it.
  b.onDamage(damage_type.FALL, nil)
  assert not b.isRoosting()
  # `BatFlags` round trip.
  var nbt = newCompound()
  EntityBase(b).writeNbt(nbt)
  assert nbt.getByte("BatFlags") == some(0'i8)
  b.setRoosting(true)
  var nbt2 = newCompound()
  EntityBase(b).writeNbt(nbt2)
  assert nbt2.getByte("BatFlags") == some(1'i8)
  # Over void air, `is_solid_block` is false above: a roosting bat lets go on its tick.
  b.mobTick(b)
  assert not b.isRoosting()
  # A flying bat with no hanging spot picks one if it is air above the world's bottom.
  for i in 0 ..< 5:
    b.mobTick(b)
  # Roosting snaps it to the block's ceiling: floor(y) + 1 - height.
  b.setRoosting(true)
  b.entity.setPos(pos3(0.5, 80.5, 0.5))
  b.postTick()
  assert close64(b.entity.pos.y, 81.0 - float64(b.entity.height()))
  # Upstream's `random_bool(1.0)`: the spawn rule is never true.
  assert not checkBatSpawnRules(world0, newBlockPos(0'i32, -100'i32, 0'i32))

block ghast_state:
  let g = newGhastEntity(entityOf(EntityType.GHAST))
  spawnEntity(world0, asBase(g))
  assert not g.isCharging()
  g.setCharging(true)
  assert g.isCharging()
  assert g.explosionPower == 1'u8
  assert g.getMobGravity() == 0.0
  # Its goal faces its movement with no target: yaw = -atan2(x, z) in degrees.
  g.entity.velocity = pos3(1.0, 0.0, 0.0)
  let goal = g.mobEntity.goalsSelector.goals[0].goal
  goal.tick(g)
  assert abs(g.entity.yaw - (-90.0'f32)) < 1e-4'f32
