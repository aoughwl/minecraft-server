block m12: # enderman
  let m = newEndermanEntity(newEntity(world0, pos3(0.5, 80.0, 0.5), EntityType.ENDERMAN))
  let mob = asMob(m)
  let goals = m.mobEntity.goalsSelector.goals
  let targets = m.mobEntity.targetSelector.goals
  assert goals.len == 8
  assert targets.len == 3
  assert goals[0].priority == 0'u8 and goals[0].goal of SwimGoal
  assert goals[1].priority == 1'u8 and goals[1].goal of ChasePlayerGoal
  assert goals[2].priority == 2'u8 and goals[2].goal of MeleeAttackGoal
  assert goals[3].priority == 7'u8 and goals[3].goal of WanderAroundGoal
  assert goals[4].priority == 8'u8 and goals[4].goal of LookAtEntityGoal
  assert goals[5].priority == 8'u8 and goals[5].goal of RandomLookAroundGoal
  assert goals[6].priority == 10'u8 and goals[6].goal of PlaceBlockGoal
  assert goals[7].priority == 11'u8 and goals[7].goal of PickUpBlockGoal
  assert targets[0].priority == 1'u8 and targets[0].goal of TeleportTowardsPlayerGoal
  assert targets[1].priority == 2'u8 and targets[1].goal of RevengeGoal
  assert targets[2].priority == 3'u8 and targets[2].goal of ActiveTargetGoal
  let living = m.mobEntity.livingEntity
  assert near32(living.health, 40.0'f32)
  assert near(living.getAttributeValue(MAX_HEALTH), 40.0)
  assert near(living.getAttributeValue(MOVEMENT_SPEED), 0.30000001192092896)
  assert near(living.getAttributeValue(ATTACK_DAMAGE), 7.0)
  assert near(living.getAttributeValue(ARMOR), 0.0)
  assert near(living.getAttributeValue(FOLLOW_RANGE), 64.0)
  assert near(living.getAttributeValue(KNOCKBACK_RESISTANCE), 0.0)
  assert near(living.getAttributeValue(STEP_HEIGHT), 1.0)
  assert near(living.getAttributeValue(GRAVITY), 0.08)
  let base = asBase(m)
  for tick in 0 ..< 40:
    if m.entity.isAlive():
      base.tick(base, server)
  assert m.mobEntity == mob.getMobEntity()

