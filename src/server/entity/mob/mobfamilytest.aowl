## Every mob under entity/mob, as type.rs builds it: goal lists and priorities as the Rust declares them, attributes as
## assets/entities.json gives them, and 40 ticks of its selectors in an empty world. Generated once from those two sources.

import std/[assertions, math]
from ../../../generated/attributes import MAX_HEALTH, MOVEMENT_SPEED, ATTACK_DAMAGE, ARMOR, FOLLOW_RANGE, KNOCKBACK_RESISTANCE, STEP_HEIGHT, GRAVITY
import ../ai/aibase
import ../ai/goal/[enderman_goals, escape_danger, follow, look_around, look_at_entity, melee_attack, misc_goals, move_to_target, swim, track_target, wander_around]
import testworld
import bat, blaze, breeze, cave_spider, creaking, creeper, elder_guardian, enderman, endermite, evoker, ghast, giant, guardian, hoglin,
  illusioner, magma_cube, phantom, piglin, piglin_brute, pillager, ravager, shulker, silverfish, slime, spider, vex, vindicator,
  warden, witch, zoglin, zombified_piglin
import skeleton/[skeleton, bogged, parched, stray]
import skeleton/wither as skeletonwither
import zombie/[zombie, drowned, husk, zombie_villager]


let server = newTestServer()
let world0 = newTestWorld(server, "mobfamilytest")

proc near32(a, b: float32): bool =
  abs(a - b) < 1.0e-5'f32

block m0: # zombie
  let m = newZombieEntity(newEntity(world0, pos3(0.5, 80.0, 0.5), EntityType.ZOMBIE))
  let mob = asMob(m)
  let goals = m.mobEntity.goalsSelector.goals
  let targets = m.mobEntity.targetSelector.goals
  assert goals.len == 6
  assert targets.len == 5
  assert goals[0].priority == 0'u8 and goals[0].goal of SwimGoal
  assert goals[1].priority == 2'u8 and goals[1].goal of ZombieAttackGoal
  assert goals[2].priority == 4'u8 and goals[2].goal of DestroyEggGoal
  assert goals[3].priority == 7'u8 and goals[3].goal of WanderAroundGoal
  assert goals[4].priority == 8'u8 and goals[4].goal of LookAtEntityGoal
  assert goals[5].priority == 8'u8 and goals[5].goal of RandomLookAroundGoal
  assert targets[0].priority == 1'u8 and targets[0].goal of RevengeGoal
  assert targets[1].priority == 2'u8 and targets[1].goal of ActiveTargetGoal
  assert targets[2].priority == 3'u8 and targets[2].goal of ActiveTargetGoal
  assert targets[3].priority == 3'u8 and targets[3].goal of ActiveTargetGoal
  assert targets[4].priority == 5'u8 and targets[4].goal of ActiveTargetGoal
  let living = m.mobEntity.livingEntity
  assert near32(living.health, 20.0'f32)
  assert near(living.getAttributeValue(MAX_HEALTH), 20.0)
  assert near(living.getAttributeValue(MOVEMENT_SPEED), 0.23000000417232513)
  assert near(living.getAttributeValue(ATTACK_DAMAGE), 3.0)
  assert near(living.getAttributeValue(ARMOR), 2.0)
  assert near(living.getAttributeValue(FOLLOW_RANGE), 35.0)
  assert near(living.getAttributeValue(KNOCKBACK_RESISTANCE), 0.0)
  assert near(living.getAttributeValue(STEP_HEIGHT), 0.6)
  assert near(living.getAttributeValue(GRAVITY), 0.08)
  let base = asBase(m)
  for tick in 0 ..< 40:
    if m.entity.isAlive():
      base.tick(base, server)
  assert m.mobEntity == mob.getMobEntity()

