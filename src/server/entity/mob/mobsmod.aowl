## Port of pumpkin/src/entity/mob/mod.rs
## PARTIAL: pumpkin/src/entity/mob/mod.rs - the `pub mod` list, as what imports them all. `MobEntity` and `trait Mob` are ai/aibase.aowl; `BlazeEntity` is not registered yet because ai/goal/blaze_attack.aowl does not get through gcc (line 89, `let spawned: EntityBase = fireball`), so a blaze from `from_type` is a bare `LivingEntity` until `import blaze` and its arm are added.
##
## `registerMobs` is `from_type`'s arms for mobs, passives, bosses, vehicles and decorations, in type.rs's order. It also fills
## `gCheckBatSpawnRules` and `gCheckSlimeSpawnRules`. mob/equipment.aowl fills `gEquipMobOnSpawn` on import.

import ../entitytype
import ../ai/aibase
import ../boss/ender_dragon
import ../boss/wither as bosswither
import ../decoration/[armor_stand, end_crystal, item_frame, painting]
import ../passive/passivemod
import ../vehicle/[boat, minecart]
import bat, breeze, cave_spider, creaking, creeper, elder_guardian, enderman, endermite, equipment, evoker, ghast, giant,
  guardian, hoglin, illusioner, magma_cube, phantom, piglin, piglin_brute, pillager, ravager, shulker, silverfish, slime,
  spider, vex, vindicator, warden, witch, zoglin, zombified_piglin
import skeleton/[skeleton, bogged, parched, stray]
import skeleton/wither as skeletonwither
import zombie/[zombie, drowned, husk, zombie_villager]

proc registerMobs*() =
  registerEntityFactory(EntityType.ZOMBIE, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newZombieEntity(entity)
    e)
