## `from_type` gives each entity type the constructor type.rs names for it. Generated once from type.rs.

import std/assertions
import ../ai/aibase
import ../entitytype
import ../boss/ender_dragon
import ../boss/wither as bosswither
import ../decoration/[armor_stand, end_crystal, item_frame, painting]
import ../passive/passivemod
import ../vehicle/[boat, minecart]
import bat, breeze, cave_spider, creaking, creeper, elder_guardian, enderman, endermite, evoker, ghast, giant, guardian, hoglin,
  illusioner, magma_cube, mobsmod, phantom, piglin, piglin_brute, pillager, ravager, shulker, silverfish, slime, spider, vex,
  vindicator, warden, witch, zoglin, zombified_piglin
import skeleton/[skeleton, bogged, parched, stray]
import skeleton/wither as skeletonwither
import testworld
import zombie/[zombie, drowned, husk, zombie_villager]

let server = newTestServer()
let world0 = newTestWorld(server, "mobsmodtest")
registerMobs()

proc spawned(entityType: EntityType): EntityBase =
  fromType(entityType, pos3(0.5, 80.0, 0.5), world0, randomUuid())

assert spawned(EntityType.ZOMBIE) of ZombieEntity
assert spawned(EntityType.DROWNED) of DrownedEntity
