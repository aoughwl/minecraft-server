## What `impl NBTStorage for X {}` means for a mob, shared by the mobs that write it, and the `World` calls entity/mob and
## entity/passive make that src/server/world does not have yet.
##
## Upstream's empty impl takes the trait's defaults, which write and read nothing, and `World::save_entity` calls
## `entity.write_nbt` on that impl, so such a mob saves as an empty compound: no position, no health. That is kept as
## upstream has it. A mob whose impl calls `living_entity.write_nbt` uses `mobEntityVt()`, which does.

import std/options
from ../../../data/block_state import BlockState
import ../../../generated/[sound, sound_category, sound_id_remap]
import ../../../protocol/java/client/play/sound_effect
import ../../../protocol/proto
import ../../../util/math/mathmod
import ../../../world/chunkdata
import ../../../world/level
import ../ai/aibase

export sound, sound_category

proc makeNoNbtMobEntityVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} = discard
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} = discard

let gNoNbtMobEntityVt = makeNoNbtMobEntityVt()

proc noNbtMobEntityVt*(): EntityVt =
  ## The blanket `impl EntityBase for T` for a mob whose `NBTStorage` impl is empty.
  gNoNbtMobEntityVt

proc asBase*(self: EntityBase): EntityBase {.inline.} =
  ## A derived ref as `dyn EntityBase`. `let b: EntityBase = derived` moves out of a derived local whose remaining uses are
  ## field writes, and the moved-from cast does not compile.
  self

proc playSoundFine*(world: World; soundRef: Sound; category: SoundCategory; position: Vector3[float64];
    volume, pitch: float32) =
  ## `World::play_sound_fine`, which is `play_sound` with these two in place of its 1.0s.
  let seed = float64(int64(randomF64() * 9.007199254740992e15'f64))
  for player in world.players:
    let soundId = remapSoundIdForVersion(uint16(ord(soundRef)), player.client.version)
    player.client.writePacketFor(newCSoundEffect(IdOr[SoundEvent](kind: iokId, id: soundId), category, position, volume,
      pitch, seed))

proc getBlockStateAt*(world: World; position: BlockPos): BlockState =
  ## `World::get_block_state`.
  let (_, state) = world.getBlockAndState(position)
  state

var gGetHeightmapHeight*: proc(world: World; heightmapType: ChunkHeightmapType; x, z: int32): int32 {.closure.} =
  proc(world: World; heightmapType: ChunkHeightmapType; x, z: int32): int32 {.closure.} =
    ## `World::get_heightmap_height`: the loaded chunk's heightmap (`read_chunk_sync`), the world's min y when it is not there.
    let chunk = readChunkSync(world.level, x shr 4, z shr 4)
    if chunk == nil:
      return world.dimension.minY
    getHeightmap(chunk.heightmap, heightmapType, x, z, world.dimension.minY)

# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callGetHeightmapHeight*(world: World; heightmapType: ChunkHeightmapType; x, z: int32): int32 =
  gGetHeightmapHeight(world, heightmapType, x, z)

var gGetMaxLocalRawBrightness*: proc(world: World; pos: BlockPos): uint8 {.closure.} =
  proc(world: World; pos: BlockPos): uint8 {.closure.} = 0'u8
  ## `World::get_max_local_raw_brightness`, which is not ported. Bats read it; unset it answers 0.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callGetMaxLocalRawBrightness*(world: World; pos: BlockPos): uint8 =
  gGetMaxLocalRawBrightness(world, pos)

proc getHeightmapHeight*(world: World; heightmapType: ChunkHeightmapType; x, z: int32): int32 =
  gGetHeightmapHeight(world, heightmapType, x, z)

proc getMaxLocalRawBrightness*(world: World; pos: BlockPos): uint8 =
  gGetMaxLocalRawBrightness(world, pos)

proc asMob*(self: Mob): Mob {.inline.} =
  ## `asBase`, for `dyn Mob`.
  self
