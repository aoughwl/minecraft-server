## Known answers for what the core-partials batch B added: `World::get_heightmap_height` (mobvts.aowl), the map hooks and
## `Player::tick_maps`'s icon (world/mapglue.aowl).

import std/[assertions, options, syncio]
import ../../../generated/dimension
import ../../../world/[chunkdata, level]
import ../../world/map
import ../../world/mapglue
import ../../item/itembehaviour
import ../../../generated/[effect, potion]
import ../playerextras
import ../../commandmobs
import ../../../command/cmdsource
import ../../../util/uuid
import mobsmod
import ../entitytype
import testworld

let server = newTestServer()
let world0 = newTestWorld(server, "partsbtest")

proc run() =
  # --- get_heightmap_height: the chunk is not loaded, so the world's min y; loaded, its heightmap.
  assert getHeightmapHeight(world0, chmWorldSurface, 5'i32, 5'i32) == world0.dimension.minY
  let loaded = newChunkData(0'i32, 0'i32, newChunkSections(24, -64'i32))
  addLoadedChunk(world0.level, loaded)
  setHeightmap(loaded.heightmap, chmWorldSurface, 5'i32, 6'i32, 100'i32, -64'i32)
  setHeightmap(loaded.heightmap, chmMotionBlocking, 5'i32, 6'i32, 90'i32, -64'i32)
  assert getHeightmapHeight(world0, chmWorldSurface, 5'i32, 6'i32) == 100'i32
  assert getHeightmapHeight(world0, chmMotionBlocking, 5'i32, 6'i32) == 90'i32
  assert getHeightmapHeight(world0, chmWorldSurface, 37'i32, 6'i32) == world0.dimension.minY   # chunk 2 is not loaded
  assert getHeightmapHeight(world0, chmWorldSurface, -1'i32, 6'i32) == world0.dimension.minY   # chunk -1 is not loaded

  # --- the map ids count up from 0, and the hook creates the map in the manager.
  assert nextMapId() == 0'i32
  assert nextMapId() == 1'i32
  let id = gItemHooks.nextMapId(server)
  assert id == 2'i32
  gItemHooks.createMap(server, id, world0, 64'i32, -32'i32, 2'u8)
  let made = gMapManager.getMap(id)
  assert made.isSome
  assert made.unsafeGet.scale == 2'i8 and made.unsafeGet.centerX == 64'i32 and made.unsafeGet.centerZ == -32'i32
  assert made.unsafeGet.dirty and not made.unsafeGet.locked
  assert gMapManager.getMap(99'i32).isNone

  # --- the pointer: dx / scale * 2 clamped to a byte; the direction is yaw in sixteenths, turned half a circle.
  let flat = newMapData(OVERWORLD, 0'i32, 0'i32, 0'i8)
  let a = mapIconFor(flat, pos3(10.0, 3.0, 3.0), 90.0'f32)
  assert a.x == 20'i8 and a.z == 6'i8 and a.direction == 12'i8 and a.iconType.value == 0'i32 and a.displayName.isNone
  let b = mapIconFor(flat, pos3(-10.0, 3.0, -3.0), -90.0'f32)
  assert b.x == -20'i8 and b.z == -6'i8 and b.direction == 4'i8
  let far = mapIconFor(flat, pos3(1000.0, 0.0, -1000.0), 0.0'f32)
  assert far.x == 127'i8 and far.z == -128'i8 and far.direction == 8'i8
  let scaled = newMapData(OVERWORLD, 100'i32, 100'i32, 2'i8)   # scale 1 << 2 = 4
  let c = mapIconFor(scaled, pos3(140.0, 0.0, 60.0), 180.0'f32)
  assert c.x == 20'i8 and c.z == -20'i8 and c.direction == 0'i8
  # --- CUpdateMobEffect's flag byte: ambient 1, particles 2, icon 4, blend 8.
  var effect = Effect(effectType: StatusEffect.HASTE, duration: 100'i32, amplifier: 1'u8, ambient: false, showParticles: false,
    showIcon: false, blend: false)
  assert effectFlags(effect) == 0'i8
  effect.ambient = true
  effect.showIcon = true
  assert effectFlags(effect) == 5'i8
  effect.showParticles = true
  effect.blend = true
  assert effectFlags(effect) == 15'i8
  # --- A cow is a `CommandEntity` of its world, which `@e` and `/kill` go through.
  registerMobs()
  let cowId = randomUuid()
  let cow = fromType(EntityType.COW, pos3(4.5, 80.0, 4.5), world0, cowId)
  world0.spawnEntity(cow)
  let listed = commandMobs(world0, proc(w: World): CommandWorld {.closure.} = CommandWorld(dimensionName: "minecraft:overworld"))
  var found = CommandEntity()
  for e in listed:
    if e.uuid == cowId:
      found = e
  assert found.uuid == cowId
  assert found.entityTypeName == "cow" and found.entityTypeId == "minecraft:cow" and found.isLiving
  assert near(found.getPos().x, 4.5) and near(found.getPos().y, 80.0)
  assert found.isAlive()
  assert found.addScoreboardTag("marked") and not found.addScoreboardTag("marked")
  assert found.getScoreboardTags() == @["marked"]
  # `/data get entity` reads the cow's NBT, `/data merge entity` writes it back through the entity.
  assert found.writeNbt != nil and found.readNbt != nil
  assert found.writeNbt().len > 0
  found.readNbt(found.writeNbt())
  found.kill()
  assert not found.isAlive()
  echo "partsb test: ok"

run()
