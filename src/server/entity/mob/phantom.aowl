## Port of pumpkin/src/entity/mob/phantom.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity]
import mobvts

type
  PhantomEntity* = ref object of Mob

proc makePhantomMobVt(): MobVt =
  result = newMobVt()
  result.getMobGravity = proc(self: Mob): float64 {.closure.} = 0.0

let phantomMobVt = makePhantomMobVt()

proc newPhantomEntity*(entity: Entity): PhantomEntity =
  result = PhantomEntity()
  result.initMob(newMobEntity(entity), phantomMobVt, noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  # TODO upstream: PhantomCircleAroundAnchorGoal, PhantomSweepAttackGoal
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(6'u8, newRandomLookAroundGoal())
