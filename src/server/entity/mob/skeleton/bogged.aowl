## Port of pumpkin/src/entity/mob/skeleton/bogged.rs

import ../../ai/aibase
import ../../mob/mobvts
import skeletonmod

type
  BoggedSkeletonEntity* = ref object of Mob
    entity0*: SkeletonEntityBase

proc newBoggedSkeletonEntity*(entity: Entity): BoggedSkeletonEntity =
  let base0 = newSkeletonEntityBase(entity)
  result = BoggedSkeletonEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
