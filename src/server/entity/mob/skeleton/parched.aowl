## Port of pumpkin/src/entity/mob/skeleton/parched.rs

import ../../ai/aibase
import ../../mob/mobvts
import skeletonmod

type
  ParchedSkeletonEntity* = ref object of Mob
    entity0*: SkeletonEntityBase

proc newParchedSkeletonEntity*(entity: Entity): ParchedSkeletonEntity =
  let base0 = newSkeletonEntityBase(entity)
  result = ParchedSkeletonEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
