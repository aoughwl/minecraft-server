## Port of pumpkin/src/entity/mob/skeleton/skeleton.rs

import ../../ai/aibase
import ../../mob/mobvts
import skeletonmod

type
  SkeletonEntity* = ref object of Mob
    entity0*: SkeletonEntityBase

proc newSkeletonEntity*(entity: Entity): SkeletonEntity =
  let base0 = newSkeletonEntityBase(entity)
  result = SkeletonEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
