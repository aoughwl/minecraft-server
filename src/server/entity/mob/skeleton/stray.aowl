## Port of pumpkin/src/entity/mob/skeleton/stray.rs

import ../../ai/aibase
import ../../mob/mobvts
import skeletonmod

type
  StraySkeletonEntity* = ref object of Mob
    entity0*: SkeletonEntityBase

proc newStraySkeletonEntity*(entity: Entity): StraySkeletonEntity =
  let base0 = newSkeletonEntityBase(entity)
  result = StraySkeletonEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
