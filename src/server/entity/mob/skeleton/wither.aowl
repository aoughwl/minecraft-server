## Port of pumpkin/src/entity/mob/skeleton/wither.rs

import ../../ai/aibase
import ../../mob/mobvts
import skeletonmod

type
  WitherSkeletonEntity* = ref object of Mob
    entity0*: SkeletonEntityBase

proc newWitherSkeletonEntity*(entity: Entity): WitherSkeletonEntity =
  let base0 = newSkeletonEntityBase(entity)
  result = WitherSkeletonEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
