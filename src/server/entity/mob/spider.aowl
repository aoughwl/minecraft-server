## Port of pumpkin/src/entity/mob/spider.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, melee_attack, swim, track_target, wander_around]
import ../mob/mobvts

type
  SpiderEntity* = ref object of Mob

proc newSpiderEntity*(entity: Entity): SpiderEntity =
  result = SpiderEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(3'u8, newMeleeAttackGoal(1.0, false))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(0.8))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(6'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, newRevengeGoal(true))
  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
  targetSelector.addGoal(3'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.IRON_GOLEM, true))
