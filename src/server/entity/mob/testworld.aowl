## A world with no chunks loaded and one server, for the entity tests under mob, passive, boss, vehicle and decoration. No
## chunk is ever generated or read: every block is void air. `dropped` collects what `World::drop_stack` is handed.

import std/cmdline
import "../../../data/item_stack/mod"
import ../../../world/[playerdata, worldfs, worldinfo]
import ../../data/datamod
import ../../recipe
import ../../scheduler
import ../../tick_rate_manager
import ../../../nbt/tag as nbttag
import ../entitymod
import mobvts

export mobvts

var dropped*: seq[ItemStack] = @[]

proc newTestServer*(): Server =
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
    dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
    keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc newTestWorld*(server: Server; name: string): World =
  let dir = parentDirW(paramStr(0)) & "/" & name & "_scratch"
  discard createDirAllW(dir)
  let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
  result = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
  server.worlds.add(result)
  gDropStack = proc(world: World; position: BlockPos; stack: ItemStack) {.closure.} =
    dropped.add(stack)

proc entityNbt*(entity: Entity): NbtCompound =
  ## The compound `Entity::read_nbt` needs: upstream unwraps "Pos" and "Motion", and so a bare compound panics there too.
  result = newCompound()
  entity.writeEntityNbt(result)

proc pos3*(x, y, z: float64): Vector3[float64] =
  Vector3[float64](x: x, y: y, z: z)

proc near*(a, b: float64): bool =
  abs(a - b) < 1e-9

proc isGone*(entity: Entity): bool =
  ## `Entity::remove` takes it out of the world's list and sets nothing on it, so `is_alive` stays true. Spawn it first.
  getEntityById(entity.world, entity.entityId) == nil
