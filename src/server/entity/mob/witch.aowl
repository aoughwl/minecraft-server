## Port of pumpkin/src/entity/mob/witch.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, track_target, wander_around]
import ../mob/mobvts

type
  WitchEntity* = ref object of Mob

proc newWitchEntity*(entity: Entity): WitchEntity =
  result = WitchEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(3'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(3'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, newRevengeGoal(true))
  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
