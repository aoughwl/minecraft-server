## Port of pumpkin/src/entity/mob/zombie/drowned.rs

import ../../ai/aibase
import ../../mob/mobvts
import zombiemod

type
  DrownedEntity* = ref object of Mob
    entity0*: ZombieEntityBase

proc newDrownedEntity*(entity: Entity): DrownedEntity =
  let base0 = newZombieEntityBase(entity)
  result = DrownedEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  # Upstream: "Fix duplicated since already in ZombieEntity::new()", with its own ActiveTargetGoal commented out.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
