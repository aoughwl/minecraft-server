## Port of pumpkin/src/entity/mob/zombie/zombie.rs

import ../../ai/aibase
import ../../mob/mobvts
import zombiemod

type
  ZombieEntity* = ref object of Mob
    entity0*: ZombieEntityBase

proc newZombieEntity*(entity: Entity): ZombieEntity =
  let base0 = newZombieEntityBase(entity)
  result = ZombieEntity(entity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
