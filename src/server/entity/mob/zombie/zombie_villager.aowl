## Port of pumpkin/src/entity/mob/zombie/zombie_villager.rs

import ../../ai/aibase
import ../../mob/mobvts
import zombiemod

type
  ZombieVillagerEntity* = ref object of Mob
    mobEntity0*: ZombieEntityBase

proc newZombieVillagerEntity*(entity: Entity): ZombieVillagerEntity =
  let base0 = newZombieEntityBase(entity)
  result = ZombieVillagerEntity(mobEntity0: base0)
  # `get_mob_entity` answers the inner mob's MobEntity; this is the `dyn Mob` the world holds.
  result.initMob(base0.mobEntity, defaultMobVt(), noNbtMobEntityVt())
