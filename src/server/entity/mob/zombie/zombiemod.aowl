## Port of pumpkin/src/entity/mob/zombie/mod.rs

import ../../ai/aibase
import ../../ai/goal/[look_around, look_at_entity, melee_attack, move_to_target, swim, track_target, wander_around]

type
  ZombieEntityBase* = ref object of Mob

proc newZombieEntityBase*(entity: Entity): ZombieEntityBase =
  # The NBTStorage impl calls `living_entity.write_nbt`, so `mobEntityVt()`.
  result = ZombieEntityBase()
  result.initMob(newMobEntity(entity), defaultMobVt(), mobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector

  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newZombieAttackGoal(1.0, false))
  goalSelector.addGoal(4'u8, newDestroyEggGoal(1.0, 3'i32))
  goalSelector.addGoal(7'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(8'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(8'u8, newRandomLookAroundGoal())

  targetSelector.addGoal(1'u8, newRevengeGoal(true))
  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, true))
  targetSelector.addGoal(3'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.VILLAGER, true))
  targetSelector.addGoal(3'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.IRON_GOLEM, true))
  targetSelector.addGoal(5'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.TURTLE, true))
