## Port of pumpkin/src/entity/mob/zombified_piglin.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, melee_attack, swim, wander_around]
import ../mob/mobvts

type
  ZombifiedPiglinEntity* = ref object of Mob

proc newZombifiedPiglinEntity*(entity: Entity): ZombifiedPiglinEntity =
  result = ZombifiedPiglinEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newMeleeAttackGoal(1.0, true))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
