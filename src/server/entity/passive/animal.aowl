## Port of pumpkin/src/entity/passive/animal.rs
##
## `trait Animal: Mob`, as `AnimalVt`: the one required method, and what a mob implementing it calls. `is_food` is a closure
## field; a type's items are captured when its vtable is made.

import std/options
import "../../../data/item_stack/mod"
import ../../../generated/[particle, sound, sound_category, entity_status as entitystatusdata]
import ../../../nbt/tag as nbttag
import ../ai/aibase

type
  IsFood* = proc(itemStack: ItemStack): bool {.closure.}

proc isFoodOf*(items: seq[uint16]): IsFood =
  ## `TEMPT_ITEMS.iter().any(|i| i.id == item_stack.item.id)`, the body every animal gives `is_food`.
  result = proc(itemStack: ItemStack): bool {.closure.} =
    for id in items:
      if id == itemStack.item.id:
        return true
    false

proc playEatingSound*(self: Mob; sound0: Sound) =
  let entity = self.mobEntity.livingEntity.entity
  entity.world.playSound(sound0, scNeutral, entity.pos)

proc writeAnimalNbt*(self: Mob; nbt: var NbtCompound) =
  let mobEntity = self.mobEntity
  nbt.putInt("InLove", mobEntity.loveTicks)
  if mobEntity.breeder.isSome:
    let breeder = mobEntity.breeder.unsafeGet
    nbt.putUuid("LoveCause", breeder.hi, breeder.lo)

proc readAnimalNbt*(self: Mob; nbt: NbtCompound) =
  let mobEntity = self.mobEntity
  let inLove0 = nbt.getInt("InLove")
  let inLove = if inLove0.isSome: inLove0.unsafeGet else: 0'i32
  let loveCause = nbt.getUuid("LoveCause")
  var breeder = none[Uuid]()
  if loveCause.isSome:
    breeder = some(Uuid(hi: loveCause.unsafeGet[0], lo: loveCause.unsafeGet[1]))
  mobEntity.setLoveTicks(inLove, breeder)

proc animalInteract*(self: Mob; isFood: IsFood; player: Player; itemStack: var ItemStack; ambientSound: Sound): bool =
  let mobEntity = self.mobEntity
  if isFood(itemStack):
    let entity = mobEntity.livingEntity.entity
    let age = entity.age

    if age >= 0'i32 and mobEntity.isBreedingReady() and not mobEntity.isInLove():
      itemStack.decrementUnlessCreative(player.gamemode, 1'u8)

      mobEntity.setLoveTicks(600'i32, some(player.gameprofile.id))
      let world = entity.world
      let pos = entity.pos

      world.sendEntityStatus(entity, esInLoveHearts)

      world.spawnParticle(pos + Vector3[float64](x: 0.0, y: float64(entity.height()), z: 0.0),
        Vector3[float64](x: 0.5, y: 0.5, z: 0.5), 1.0'f32, 7'i32, ptHeart)
      world.playSound(ambientSound, scNeutral, entity.pos)
      return true

    if age < 0'i32:
      itemStack.decrementUnlessCreative(player.gamemode, 1'u8)
      let speedup = max(-age div 10'i32, 1'i32)
      entity.age = entity.age + speedup

      let world = entity.world
      let pos = entity.pos

      world.spawnParticle(pos + Vector3[float64](x: 0.0, y: float64(entity.height()), z: 0.0),
        Vector3[float64](x: 0.5, y: 0.5, z: 0.5), 1.0'f32, 7'i32, ptHappyVillager)
      self.playEatingSound(ambientSound)
      return true

  mobEntity.mobInteractDefault(player, itemStack)
