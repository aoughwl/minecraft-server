## Port of pumpkin/src/entity/passive/cat.rs

import std/options
import "../../../data/item_stack/mod"
import ../../../nbt/tag as nbttag
import ../../../generated/[meta_data_type, tracked_data]
import ../../../protocol/varint
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts

proc temptItems(): seq[uint16] =
  ## `TEMPT_ITEMS`
  @[ITEM_COD.id, ITEM_SALMON.id]

type
  CatEntity* = ref object of Mob
    variant*: uint8

proc variantName(variant: uint8): string =
  case variant
  of 0'u8: "minecraft:all_black"
  of 1'u8: "minecraft:black"
  of 2'u8: "minecraft:british_shorthair"
  of 3'u8: "minecraft:calico"
  of 4'u8: "minecraft:jellie"
  of 5'u8: "minecraft:persian"
  of 6'u8: "minecraft:ragdoll"
  of 7'u8: "minecraft:red"
  of 8'u8: "minecraft:siamese"
  of 10'u8: "minecraft:white"
  else: "minecraft:tabby"

proc variantFromName(name: string): uint8 =
  ## With the prefix or without it, and anything unknown is the default.
  case name
  of "all_black", "minecraft:all_black": 0'u8
  of "black", "minecraft:black": 1'u8
  of "british_shorthair", "minecraft:british_shorthair": 2'u8
  of "calico", "minecraft:calico": 3'u8
  of "jellie", "minecraft:jellie": 4'u8
  of "persian", "minecraft:persian": 5'u8
  of "ragdoll", "minecraft:ragdoll": 6'u8
  of "red", "minecraft:red": 7'u8
  of "siamese", "minecraft:siamese": 8'u8
  of "white", "minecraft:white": 10'u8
  else: 9'u8

proc makeCatEntityMobVt(): MobVt =
  result = newMobVt()
  result.mobSetVariantName = proc(self: Mob; name: string) {.closure.} =
    let mob = CatEntity(self)
    mob.variant = variantFromName(name)
  result.mobInitDataTracker = proc(self: Mob) {.closure.} =
    let mob = CatEntity(self)
    let entity = self.mobEntity.livingEntity.entity
    if entity.age < 0'i32:
      entity.sendMetaData(TrackedData_BABY_ID, BOOLEAN, true)
    entity.sendMetaData(TrackedData_CAT_VARIANT, CAT_VARIANT, newVarInt(int32(mob.variant)))

proc makeCatEntityVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let mob = CatEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    nbt.putString("variant", variantName(mob.variant))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let mob = CatEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    let variantStr = nbt.getString("variant")
    if variantStr.isSome:
      mob.variant = variantFromName(variantStr.unsafeGet)

let catEntityMobVt = makeCatEntityMobVt()
let catEntityVt = makeCatEntityVt()

proc newCatEntity*(entity: Entity): CatEntity =
  result = CatEntity(variant: 9'u8)
  result.initMob(newMobEntity(entity), catEntityMobVt, catEntityVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newEscapeDangerGoal(1.5))
  goalSelector.addGoal(4'u8, newTemptGoal(0.6, temptItems()))
  goalSelector.addGoal(5'u8, newBreedGoal(0.8))
  goalSelector.addGoal(9'u8, newFollowParentGoal(0.8))
  goalSelector.addGoal(11'u8, newWanderAroundGoal(0.8))
  goalSelector.addGoal(12'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 10.0'f32))
  goalSelector.addGoal(12'u8, newRandomLookAroundGoal())
