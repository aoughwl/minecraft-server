## Port of pumpkin/src/entity/passive/chicken.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../generated/[meta_data_type, tracked_data]
import ../../../nbt/tag as nbttag
import ../../../protocol/varint
import ../ageable
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts
import animal

proc temptItems(): seq[uint16] =
  ## `TEMPT_ITEMS`, by item id.
  @[ITEM_WHEAT_SEEDS.id, ITEM_MELON_SEEDS.id, ITEM_PUMPKIN_SEEDS.id, ITEM_BEETROOT_SEEDS.id, ITEM_TORCHFLOWER_SEEDS.id,
    ITEM_PITCHER_POD.id]

type
  ChickenEntity* = ref object of Mob
    ## Represents a Chicken, a passive mob that lays eggs and is immune to fall damage.
    variant*: uint8
    eggLayTime*: int32
    ageableData*: AgeableData

let chickenIsFood = isFoodOf(temptItems())

proc variantName(variant: uint8): string =
  case variant
  of 0'u8: "minecraft:cold"
  of 2'u8: "minecraft:warm"
  else: "minecraft:temperate"

proc variantFromName(name: string): uint8 =
  ## With the prefix or without it, and anything unknown is temperate.
  case name
  of "cold", "minecraft:cold": 0'u8
  of "warm", "minecraft:warm": 2'u8
  else: 1'u8

proc makeChickenMobVt(): MobVt =
  result = newMobVt()
  result.mobSetVariantName = proc(self: Mob; name: string) {.closure.} =
    let chicken = ChickenEntity(self)
    chicken.variant = variantFromName(name)
  result.mobInitDataTracker = proc(self: Mob) {.closure.} =
    let chicken = ChickenEntity(self)
    let entity = self.mobEntity.livingEntity.entity
    if entity.age < 0'i32:
      entity.sendMetaData(TD_BABY, BOOLEAN, true)
    entity.sendMetaData(TD_CHICKEN_VARIANT, CHICKEN_VARIANT, newVarInt(int32(chicken.variant)))
  result.mobTick = proc(self: Mob; caller: EntityBase) {.closure.} =
    let chicken = ChickenEntity(self)
    if self.mobEntity.livingEntity.dead:
      return
    let before = chicken.eggLayTime
    chicken.eggLayTime = before - 1'i32
    if before <= 1'i32:
      let nextTime = randomRange(6000'i32, 12000'i32)
      let entity = self.mobEntity.livingEntity.entity
      gDropStack(entity.world, entity.blockPos, newItemStack(1'u8, ITEM_EGG))
      chicken.eggLayTime = nextTime
  result.mobInteract = proc(self: Mob; player: Player; itemStack: var ItemStack): bool {.closure.} =
    animalInteract(self, chickenIsFood, player, itemStack, sdEntityChickenAmbient)

proc makeChickenVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let chicken = ChickenEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    chicken.writeAgeableNbt(chicken.ageableData, nbt)
    chicken.writeAnimalNbt(nbt)
    nbt.putInt("EggLayTime", chicken.eggLayTime)
    nbt.putString("variant", variantName(chicken.variant))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let chicken = ChickenEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    chicken.readAgeableNbt(chicken.ageableData, nbt)
    chicken.readAnimalNbt(nbt)
    let eggLayTime = nbt.getInt("EggLayTime")
    chicken.eggLayTime = if eggLayTime.isSome: eggLayTime.unsafeGet else: 6000'i32
    let variantStr = nbt.getString("variant")
    if variantStr.isSome:
      chicken.variant = variantFromName(variantStr.unsafeGet)

let chickenMobVt = makeChickenMobVt()
let chickenVt = makeChickenVt()

proc newChickenEntity*(entity: Entity): ChickenEntity =
  result = ChickenEntity(variant: 1'u8, eggLayTime: randomRange(6000'i32, 12000'i32), ageableData: newAgeableData())
  result.initMob(newMobEntity(entity), chickenMobVt, chickenVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newEscapeDangerGoal(1.4))
  goalSelector.addGoal(2'u8, newBreedGoal(1.0))
  goalSelector.addGoal(3'u8, newTemptGoal(1.0, temptItems()))
  goalSelector.addGoal(4'u8, newFollowParentGoal(1.1))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
