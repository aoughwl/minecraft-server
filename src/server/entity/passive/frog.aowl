## Port of pumpkin/src/entity/passive/frog.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../nbt/tag as nbttag
import ../../../generated/[meta_data_type, tracked_data]
import ../../../protocol/varint
import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, wander_around]
import ../mob/mobvts

type
  FrogEntity* = ref object of Mob
    variant*: uint8

proc variantName(variant: uint8): string =
  case variant
  of 0'u8: "minecraft:cold"
  of 2'u8: "minecraft:warm"
  else: "minecraft:temperate"

proc variantFromName(name: string): uint8 =
  ## With the prefix or without it, and anything unknown is the default.
  case name
  of "cold", "minecraft:cold": 0'u8
  of "warm", "minecraft:warm": 2'u8
  else: 1'u8

proc makeFrogEntityMobVt(): MobVt =
  result = newMobVt()
  result.mobSetVariantName = proc(self: Mob; name: string) {.closure.} =
    let mob = FrogEntity(self)
    mob.variant = variantFromName(name)
  result.mobInitDataTracker = proc(self: Mob) {.closure.} =
    let mob = FrogEntity(self)
    let entity = self.mobEntity.livingEntity.entity
    if entity.age < 0'i32:
      entity.sendMetaData(TD_BABY, BOOLEAN, true)
    entity.sendMetaData(TD_FROG_VARIANT, FROG_VARIANT, newVarInt(int32(mob.variant)))

proc makeFrogEntityVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let mob = FrogEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    nbt.putString("variant", variantName(mob.variant))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let mob = FrogEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    let variantStr = nbt.getString("variant")
    if variantStr.isSome:
      mob.variant = variantFromName(variantStr.unsafeGet)

let frogEntityMobVt = makeFrogEntityMobVt()
let frogEntityVt = makeFrogEntityVt()

proc newFrogEntity*(entity: Entity): FrogEntity =
  result = FrogEntity(variant: 1'u8)
  result.initMob(newMobEntity(entity), frogEntityMobVt, frogEntityVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(2'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(3'u8, newRandomLookAroundGoal())
