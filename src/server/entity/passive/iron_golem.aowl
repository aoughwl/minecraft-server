## Port of pumpkin/src/entity/passive/iron_golem.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, melee_attack, track_target, wander_around]

type
  IronGolemEntity* = ref object of Mob
    ## Represents an Iron Golem, a powerful neutral mob that protects villagers and players.

proc newIronGolemEntity*(entity: Entity): IronGolemEntity =
  # The NBTStorage impl calls `living_entity.write_nbt`, so `mobEntityVt()`.
  result = IronGolemEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), mobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(1'u8, newMeleeAttackGoal(1.0, true))
  goalSelector.addGoal(6'u8, newWanderAroundGoal(0.6))
  goalSelector.addGoal(7'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(8'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, newRevengeGoal(true))
  targetSelector.addGoal(2'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.PLAYER, false))
  targetSelector.addGoal(3'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.ZOMBIE, true))
