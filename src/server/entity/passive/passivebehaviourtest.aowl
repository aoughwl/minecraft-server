## Known answers read from the hand-written animals: animal.rs, cow, pig, sheep, chicken, cat, frog, wolf and the villager.
## passivefamilytest.aowl covers every mob's goals and attributes.

import std/[assertions, options]
import ../../../data/block_ext
import "../../../data/item_stack/mod"
import ../../../nbt/tag as nbttag
import ../../../protocol/varint
import ../../../util/gamemode
import ../../../world/[playerdata, worldinfo]
import ../../entity/player as playermod
import ../../net/winsock
import ../ageable
import ../ai/aibase
import ../mob/testworld
import animal, cat, chicken, cow, frog, pig, sheep, wolf
import villager/villagermod

let server = newTestServer()
let world0 = newTestWorld(server, "passivebehaviourtest")

proc entityOf(entityType: EntityType): Entity =
  newEntity(world0, pos3(0.5, 80.0, 0.5), entityType)

let client = newJavaClient(InvalidSocket, 1'u64)
client.connectionState = csPlay
let profile = GameProfile(id: offlineUuid("Tester"), name: "Tester", properties: @[], profileActions: @[])
let player = newPlayer(client, profile, defaultPlayerConfig(), world0, server, Survival, 1'i32)

block animal_interact:
  let c = newCowEntity(entityOf(EntityType.COW))
  # Not food: falls through to `MobEntity::mob_interact`, which does nothing with a stick.
  var stick = newItemStack(5'u8, ITEM_STICK)
  assert not c.mobInteract(player, stick)
  assert stick.itemCount == 5'u8
  assert c.mobEntity.loveTicks == 0'i32

  # Food on an adult ready to breed: one eaten, 600 ticks of love, and this player is the breeder.
  var wheat = newItemStack(5'u8, ITEM_WHEAT)
  assert c.mobInteract(player, wheat)
  assert wheat.itemCount == 4'u8
  assert c.mobEntity.loveTicks == 600'i32
  assert c.mobEntity.isInLove()
  assert c.mobEntity.breeder == some(player.gameprofile.id)

  # Already in love: not eaten, and it falls through.
  assert not c.mobInteract(player, wheat)
  assert wheat.itemCount == 4'u8

  # Baby: speeds up by a tenth of what is left, at least one.
  let baby = newCowEntity(entityOf(EntityType.COW))
  baby.entity.age = -100'i32
  assert baby.mobInteract(player, wheat)
  assert wheat.itemCount == 3'u8
  assert baby.entity.age == -90'i32
  baby.entity.age = -5'i32
  assert baby.mobInteract(player, wheat)
  assert baby.entity.age == -4'i32

  # A creative player's food is not used.
  player.gamemode = Creative
  let other = newCowEntity(entityOf(EntityType.COW))
  assert other.mobInteract(player, wheat)
  assert wheat.itemCount == 2'u8 or wheat.itemCount == 3'u8
  player.gamemode = Survival

block animal_nbt:
  let c = newCowEntity(entityOf(EntityType.COW))
  c.mobEntity.setLoveTicks(77'i32, some(player.gameprofile.id))
  var nbt = newCompound()
  EntityBase(c).writeNbt(nbt)
  assert nbt.getInt("InLove") == some(77'i32)
  assert nbt.getUuid("LoveCause").isSome
  assert nbt.getInt("Age") == some(0'i32)
  assert nbt.getBool("AgeLocked") == some(false)
  let d = newCowEntity(entityOf(EntityType.COW))
  EntityBase(d).readNbt(nbt)
  assert d.mobEntity.loveTicks == 77'i32
  assert d.mobEntity.breeder == some(player.gameprofile.id)

block pig_food:
  let p = newPigEntity(entityOf(EntityType.PIG))
  for item in [ITEM_CARROT, ITEM_POTATO, ITEM_BEETROOT, ITEM_CARROT_ON_A_STICK]:
    let q = newPigEntity(entityOf(EntityType.PIG))
    var food = newItemStack(1'u8, item)
    assert q.mobInteract(player, food)
    assert q.mobEntity.isInLove()
  var wheat = newItemStack(1'u8, ITEM_WHEAT)
  assert not p.mobInteract(player, wheat)

block sheep_wool:
  let s = newSheepEntity(entityOf(EntityType.SHEEP))
  assert s.getColor() == 0'u8
  assert not s.isSheared()
  s.setColor(5'u8)
  s.setSheared(true)
  assert s.getColor() == 5'u8
  assert s.isSheared()
  assert s.colorAndSheared == 0x15'u8
  # Only the low bits of a colour count.
  s.setColor(0xFF'u8)
  assert s.colorAndSheared == 0x1F'u8
  s.setColor(5'u8)

  var nbt = newCompound()
  EntityBase(s).writeNbt(nbt)
  assert nbt.getBool("Sheared") == some(true)
  assert nbt.getByte("Color") == some(5'i8)
  assert nbt.getFloat("Health").isNone, "upstream writes the entity's NBT, not the living entity's"
  let t = newSheepEntity(entityOf(EntityType.SHEEP))
  EntityBase(t).readNbt(nbt)
  assert t.colorAndSheared == 0x15'u8

  # Eating grass regrows the wool.
  s.onEatingGrass()
  assert not s.isSheared()

block chicken_eggs:
  let c = newChickenEntity(entityOf(EntityType.CHICKEN))
  assert c.variant == 1'u8
  assert c.eggLayTime >= 6000'i32 and c.eggLayTime < 12000'i32
  # Lays when the count was 1 or less, and a new count follows.
  let before = dropped.len
  c.eggLayTime = 2'i32
  c.mobTick(c)
  assert c.eggLayTime == 1'i32
  assert dropped.len == before
  c.mobTick(c)
  assert dropped.len == before + 1
  assert dropped[before].item.id == ITEM_EGG.id
  assert c.eggLayTime >= 6000'i32

  # Variant by name, prefixed or not; anything else is temperate.
  c.mobSetVariantName("cold")
  assert c.variant == 0'u8
  c.mobSetVariantName("minecraft:warm")
  assert c.variant == 2'u8
  c.mobSetVariantName("nonsense")
  assert c.variant == 1'u8

  var nbt = newCompound()
  c.variant = 2'u8
  c.eggLayTime = 123'i32
  EntityBase(c).writeNbt(nbt)
  assert nbt.getString("variant") == some("minecraft:warm")
  assert nbt.getInt("EggLayTime") == some(123'i32)
  let d = newChickenEntity(entityOf(EntityType.CHICKEN))
  EntityBase(d).readNbt(nbt)
  assert d.variant == 2'u8
  assert d.eggLayTime == 123'i32
  var empty0 = entityNbt(d.entity)
  EntityBase(d).readNbt(empty0)
  assert d.eggLayTime == 6000'i32, "absent reads as 6000"

block variants:
  let c = newCatEntity(entityOf(EntityType.CAT))
  assert c.variant == 9'u8, "tabby"
  c.mobSetVariantName("minecraft:white")
  assert c.variant == 10'u8
  c.mobSetVariantName("all_black")
  assert c.variant == 0'u8
  var catNbt = newCompound()
  EntityBase(c).writeNbt(catNbt)
  assert catNbt.getString("variant") == some("minecraft:all_black")
  c.mobSetVariantName("what")
  assert c.variant == 9'u8

  let f = newFrogEntity(entityOf(EntityType.FROG))
  assert f.variant == 1'u8, "temperate"
  f.mobSetVariantName("minecraft:cold")
  assert f.variant == 0'u8
  f.mobSetVariantName("warm")
  assert f.variant == 2'u8

  let w = newWolfEntity(entityOf(EntityType.WOLF))
  assert w.variant == 3'u8, "pale"
  w.mobSetVariantName("minecraft:woods")
  assert w.variant == 8'u8
  var wolfNbt = newCompound()
  EntityBase(w).writeNbt(wolfNbt)
  assert wolfNbt.getString("variant") == some("minecraft:woods")
  let x = newWolfEntity(entityOf(EntityType.WOLF))
  EntityBase(x).readNbt(wolfNbt)
  assert x.variant == 8'u8

block villager_food:
  assert getFoodPoints(ITEM_BREAD) == 4'i32
  assert getFoodPoints(ITEM_POTATO) == 1'i32
  assert getFoodPoints(ITEM_CARROT) == 1'i32
  assert getFoodPoints(ITEM_BEETROOT) == 1'i32
  assert getFoodPoints(ITEM_STICK) == 0'i32
  assert BreedingFoodThreshold == 12'i32

  let v = newVillagerEntity(entityOf(EntityType.VILLAGER))
  assert v.inventory.len == 8
  v.inventory[0] = newItemStack(2'u8, ITEM_BREAD)
  v.inventory[1] = newItemStack(5'u8, ITEM_POTATO)
  v.inventory[2] = newItemStack(9'u8, ITEM_STICK)
  assert v.countFoodPointsInInventory() == 13'i32

  # Stops at 12: three... bread is 4 each, so both bread (8) and four potatoes (12).
  v.eatUntilFull()
  assert v.foodLevel == 12'i32
  assert v.inventory[0].isEmpty()
  assert v.inventory[1].itemCount == 1'u8
  assert v.inventory[2].itemCount == 9'u8

block villager_profession:
  # `block_to_profession` and `profession_matches_block`, including the four cauldrons.
  for (name, profession) in [("composter", VillagerProfession.Farmer), ("lectern", VillagerProfession.Librarian),
      ("blast_furnace", VillagerProfession.Armorer), ("smoker", VillagerProfession.Butcher),
      ("cartography_table", VillagerProfession.Cartographer), ("brewing_stand", VillagerProfession.Cleric),
      ("barrel", VillagerProfession.Fisherman), ("fletching_table", VillagerProfession.Fletcher),
      ("cauldron", VillagerProfession.Leatherworker), ("water_cauldron", VillagerProfession.Leatherworker),
      ("lava_cauldron", VillagerProfession.Leatherworker), ("powder_snow_cauldron", VillagerProfession.Leatherworker),
      ("stonecutter", VillagerProfession.Mason), ("loom", VillagerProfession.Shepherd),
      ("smithing_table", VillagerProfession.Toolsmith), ("grindstone", VillagerProfession.Weaponsmith)]:
    let block0 = fromName(Block, name)
    assert block0 != nil
    assert blockToProfession(block0).isSome and blockToProfession(block0).unsafeGet == profession
    assert professionMatchesBlock(profession, block0)
  let stone = fromName(Block, "stone")
  assert stone != nil
  assert blockToProfession(stone).isNone
  assert not professionMatchesBlock(VillagerProfession.None, stone)

block villager_trades:
  let v = newVillagerEntity(entityOf(EntityType.VILLAGER))
  let start = newVillagerData(VillagerType.Plains, VillagerProfession.None, 1'i32)
  assert v.villagerData.professionEnum() == VillagerProfession.None
  assert v.villagerData.level.value == 1'i32

  # Taking a profession fills offers from its level's table, as many as the set's `amount`.
  v.setVillagerData(newVillagerData(VillagerType.Plains, VillagerProfession.Farmer, 1'i32))
  let tradeSet = VillagerProfession.Farmer.tradeSet(1'i32)
  assert tradeSet.isSome
  assert v.offers.len == min(int(tradeSet.unsafeGet.amount), tradeSet.unsafeGet.trades.len)
  v.addTrades(VillagerProfession.None, 1'i32)
  assert v.offers.len == min(int(tradeSet.unsafeGet.amount), tradeSet.unsafeGet.trades.len), "no set, no change"

  # The same profession does not regenerate.
  let countBefore = v.offers.len
  v.offers.setLen(1)
  v.setVillagerData(newVillagerData(VillagerType.Desert, VillagerProfession.Farmer, 1'i32))
  assert v.offers.len == 1
  assert v.villagerData.typeEnum() == VillagerType.Desert
  discard countBefore
  discard start

  # With nothing to sell, an interaction just shakes its head.
  let w = newVillagerEntity(entityOf(EntityType.VILLAGER))
  var stack = newItemStack(1'u8, ITEM_STICK)
  assert w.mobInteract(player, stack)
  # A baby the same.
  let y = newVillagerEntity(entityOf(EntityType.VILLAGER))
  y.entity.age = -1'i32
  assert y.mobInteract(player, stack)

block villager_nbt:
  let v = newVillagerEntity(entityOf(EntityType.VILLAGER))
  v.setVillagerData(newVillagerData(VillagerType.Snow, VillagerProfession.Farmer, 3'i32))
  v.foodLevel = 7'i32
  v.xp = 9'i32
  v.lastRestockTime = 11'i64
  v.restocksToday = 2'i32
  v.jobSite = some(newBlockPos(1'i32, 2'i32, 3'i32))
  v.homePos = some(newBlockPos(4'i32, 5'i32, 6'i32))
  v.inventory[3] = newItemStack(2'u8, ITEM_BREAD)
  v.gossips.add(GossipEntry(target: player.gameprofile.id, gossipType: gtTrading, value: 40'i32))

  var nbt = newCompound()
  EntityBase(v).writeNbt(nbt)
  let data0 = nbt.getCompound("VillagerData")
  assert data0.isSome
  assert data0.unsafeGet.getInt("Profession") == some(int32(ord(VillagerProfession.Farmer)))
  assert data0.unsafeGet.getInt("Level") == some(3'i32)
  assert nbt.getInt("FoodLevel") == some(7'i32)
  assert nbt.getInt("JobSiteY") == some(2'i32)
  assert nbt.getInt("HomeZ") == some(6'i32)
  assert nbt.getCompound("Offers").isSome
  assert nbt.getList("Inventory").isSome
  assert nbt.getList("Inventory").unsafeGet.len == 1, "only the non-empty"
  assert nbt.getList("Gossips").unsafeGet.len == 1

  let w = newVillagerEntity(entityOf(EntityType.VILLAGER))
  EntityBase(w).readNbt(nbt)
  assert w.villagerData.level.value == 3'i32
  assert w.villagerData.professionEnum() == VillagerProfession.Farmer
  assert w.foodLevel == 7'i32 and w.xp == 9'i32
  assert w.lastRestockTime == 11'i64
  assert w.jobSite.isSome and w.jobSite.unsafeGet == newBlockPos(1'i32, 2'i32, 3'i32)
  assert w.homePos.isSome and w.homePos.unsafeGet == newBlockPos(4'i32, 5'i32, 6'i32)
  assert w.getJobSite().unsafeGet == w.jobSite.unsafeGet
  assert w.getHome().unsafeGet == w.homePos.unsafeGet
  assert w.offers.len == v.offers.len
  assert w.offers[0].maxUses == v.offers[0].maxUses
  assert w.inventory.len == 1, "the list replaces the eight empties"
  assert w.gossips.len == 1
  assert w.gossips[0].gossipType == gtTrading
  assert w.gossips[0].value == 40'i32
  assert w.gossips[0].target == player.gameprofile.id

  # Old saves' `BedX` and a partial job site.
  var old = entityNbt(w.entity)
  old.putInt("BedX", 7'i32)
  old.putInt("BedY", 8'i32)
  old.putInt("BedZ", 9'i32)
  old.putInt("JobSiteX", 1'i32)
  EntityBase(w).readNbt(old)
  assert w.homePos.isSome and w.homePos.unsafeGet == newBlockPos(7'i32, 8'i32, 9'i32)
  assert w.jobSite.isNone

block villager_tick:
  # Only every 20th age; with no bed or work site around it stays as it was.
  let v = newVillagerEntity(entityOf(EntityType.VILLAGER))
  v.entity.age = 20'i32
  v.mobTick(v)
  assert v.homePos.isNone
  assert v.jobSite.isNone
  assert v.villagerData.professionEnum() == VillagerProfession.None
