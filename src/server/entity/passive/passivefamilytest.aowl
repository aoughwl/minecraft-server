## Every mob under entity/passive, as type.rs builds it: goal lists and priorities as the Rust declares them, attributes
## as assets/entities.json gives them, and 40 ticks of its selectors in an empty world. Generated once from those two sources.

import std/[assertions, math]
from ../../../generated/attributes import MAX_HEALTH, MOVEMENT_SPEED, ATTACK_DAMAGE, ARMOR, FOLLOW_RANGE, KNOCKBACK_RESISTANCE, STEP_HEIGHT, GRAVITY
import ../ai/aibase
import ../ai/goal/[enderman_goals, escape_danger, follow, look_around, look_at_entity, melee_attack, misc_goals, move_to_target, swim, track_target, wander_around]
import ../mob/testworld
import allay, armadillo, axolotl, bee, camel, cat, chicken, cod, cow, dolphin, donkey, fox, frog, glow_squid, goat, horse, iron_golem, llama, mooshroom, mule, ocelot, panda, parrot, pig, polar_bear, pufferfish, rabbit, salmon, sheep, skeleton_horse, sniffer, snow_golem, squid, strider, tadpole, trader_llama, tropical_fish, turtle, wandering_trader, wolf, zombie_horse
import villager/villagermod


let server = newTestServer()
let world0 = newTestWorld(server, "passivefamilytest")

proc near32(a, b: float32): bool =
  abs(a - b) < 1.0e-5'f32

block m0: # cat
  let m = newCatEntity(newEntity(world0, pos3(0.5, 80.0, 0.5), EntityType.CAT))
  let mob = asMob(m)
  let goals = m.mobEntity.goalsSelector.goals
  let targets = m.mobEntity.targetSelector.goals
  assert goals.len == 8
  assert targets.len == 0
  assert goals[0].priority == 1'u8 and goals[0].goal of SwimGoal
  assert goals[1].priority == 1'u8 and goals[1].goal of EscapeDangerGoal
  assert goals[2].priority == 4'u8 and goals[2].goal of TemptGoal
  assert goals[3].priority == 5'u8 and goals[3].goal of BreedGoal
  assert goals[4].priority == 9'u8 and goals[4].goal of FollowParentGoal
  assert goals[5].priority == 11'u8 and goals[5].goal of WanderAroundGoal
  assert goals[6].priority == 12'u8 and goals[6].goal of LookAtEntityGoal
  assert goals[7].priority == 12'u8 and goals[7].goal of RandomLookAroundGoal
  let living = m.mobEntity.livingEntity
  assert near32(living.health, 10.0'f32)
  assert near(living.getAttributeValue(MAX_HEALTH), 10.0)
  assert near(living.getAttributeValue(MOVEMENT_SPEED), 0.30000001192092896)
  assert near(living.getAttributeValue(ATTACK_DAMAGE), 3.0)
  assert near(living.getAttributeValue(ARMOR), 0.0)
  assert near(living.getAttributeValue(FOLLOW_RANGE), 16.0)
  assert near(living.getAttributeValue(KNOCKBACK_RESISTANCE), 0.0)
  assert near(living.getAttributeValue(STEP_HEIGHT), 0.6)
  assert near(living.getAttributeValue(GRAVITY), 0.08)
  let base = asBase(m)
  for tick in 0 ..< 40:
    if m.entity.isAlive():
      base.tick(base, server)
  assert m.mobEntity == mob.getMobEntity()

