## Port of pumpkin/src/entity/passive/pig.rs

import std/options
import "../../../data/item_stack/mod"
import ../../../nbt/tag as nbttag
import ../ageable
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts
import animal

proc pigFood(): seq[uint16] =
  ## `PIG_FOOD`
  @[ITEM_CARROT.id, ITEM_POTATO.id, ITEM_BEETROOT.id, ITEM_CARROT_ON_A_STICK.id]

type
  PigEntity* = ref object of Mob
    ageableData*: AgeableData

let pigEntityIsFood = isFoodOf(pigFood())

proc makePigEntityMobVt(): MobVt =
  result = newMobVt()
  result.mobInteract = proc(self: Mob; player: Player; itemStack: var ItemStack): bool {.closure.} =
    animalInteract(self, pigEntityIsFood, player, itemStack, sdEntityPigAmbient)

proc makePigEntityVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let mob = PigEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    mob.writeAgeableNbt(mob.ageableData, nbt)
    mob.writeAnimalNbt(nbt)
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let mob = PigEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    mob.readAgeableNbt(mob.ageableData, nbt)
    mob.readAnimalNbt(nbt)

let pigEntityMobVt = makePigEntityMobVt()
let pigEntityVt = makePigEntityVt()

proc newPigEntity*(entity: Entity): PigEntity =
  result = PigEntity(ageableData: newAgeableData())
  result.initMob(newMobEntity(entity), pigEntityMobVt, pigEntityVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newEscapeDangerGoal(1.25))
  goalSelector.addGoal(2'u8, newBreedGoal(1.0))
  goalSelector.addGoal(3'u8, newTemptGoal(1.2, pigFood()))
  goalSelector.addGoal(4'u8, newFollowParentGoal(1.1))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
