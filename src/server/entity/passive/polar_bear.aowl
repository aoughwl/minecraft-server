## Port of pumpkin/src/entity/passive/polar_bear.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, track_target, wander_around]
import ../mob/mobvts

type
  PolarBearEntity* = ref object of Mob
    ## Represents a Polar Bear, a neutral mob found in cold biomes.

proc newPolarBearEntity*(entity: Entity): PolarBearEntity =
  result = PolarBearEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(2'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(3'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.FOX, true))
