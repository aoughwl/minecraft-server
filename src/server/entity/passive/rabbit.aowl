## Port of pumpkin/src/entity/passive/rabbit.rs

import "../../../data/item_stack/mod"
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts

proc temptItems(): seq[uint16] =
  ## `TEMPT_ITEMS`
  @[ITEM_CARROT.id, ITEM_GOLDEN_CARROT.id, ITEM_DANDELION.id]

type
  RabbitEntity* = ref object of Mob

proc newRabbitEntity*(entity: Entity): RabbitEntity =
  result = RabbitEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newEscapeDangerGoal(2.2))
  goalSelector.addGoal(2'u8, newBreedGoal(0.8))
  goalSelector.addGoal(3'u8, newTemptGoal(1.0, temptItems()))
  goalSelector.addGoal(4'u8, newFollowParentGoal(0.8))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(0.6))
  goalSelector.addGoal(11'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 10.0'f32))
  goalSelector.addGoal(11'u8, newRandomLookAroundGoal())
