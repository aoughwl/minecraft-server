## Port of pumpkin/src/entity/passive/sheep.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../generated/[meta_data_type, tracked_data]
import ../../../nbt/tag as nbttag
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts
import animal

proc temptItems(): seq[uint16] =
  ## `TEMPT_ITEMS`, by item id.
  @[ITEM_WHEAT.id]

type
  SheepEntity* = ref object of Mob
    colorAndSheared*: uint8

let sheepIsFood = isFoodOf(temptItems())

proc getPackedByte(self: SheepEntity): uint8 =
  self.colorAndSheared

proc getColor*(self: SheepEntity): uint8 =
  self.getPackedByte() and 0x0F'u8

proc isSheared*(self: SheepEntity): bool =
  (self.getPackedByte() and 0x10'u8) != 0'u8

proc setPackedAndSync(self: SheepEntity; value: uint8) =
  self.colorAndSheared = value
  self.mobEntity.livingEntity.entity.sendMetaData(TD_SHEEP_WOOL, BYTE, cast[int8](value))

proc setColor*(self: SheepEntity; color: uint8) =
  self.setPackedAndSync((self.getPackedByte() and 0xF0'u8) or (color and 0x0F'u8))

proc setSheared*(self: SheepEntity; sheared: bool) =
  let value = if sheared: self.getPackedByte() or 0x10'u8 else: self.getPackedByte() and not 0x10'u8
  self.setPackedAndSync(value)

proc makeSheepMobVt(): MobVt =
  result = newMobVt()
  result.mobInitDataTracker = proc(self: Mob) {.closure.} =
    let sheep = SheepEntity(self)
    let entity = self.mobEntity.livingEntity.entity
    if entity.age < 0'i32:
      entity.sendMetaData(TD_BABY, BOOLEAN, true)
    # The client's default is a white, shorn-not wool byte: only a different one is sent.
    if sheep.colorAndSheared != 0'u8:
      entity.sendMetaData(TD_SHEEP_WOOL, BYTE, cast[int8](sheep.colorAndSheared))
  result.onEatingGrass = proc(self: Mob) {.closure.} =
    let sheep = SheepEntity(self)
    sheep.setSheared(false)
  result.mobInteract = proc(self: Mob; player: Player; itemStack: var ItemStack): bool {.closure.} =
    animalInteract(self, sheepIsFood, player, itemStack, sdEntitySheepAmbient)

proc makeSheepVt(): EntityVt =
  result = copyVt(mobEntityVt())
  # Upstream's impl calls `living_entity.entity`, not `living_entity`: no health or effects are saved.
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let sheep = SheepEntity(self)
    self.entity.writeEntityNbt(nbt)
    nbt.putBool("Sheared", sheep.isSheared())
    nbt.putByte("Color", int8(sheep.getColor()))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let sheep = SheepEntity(self)
    self.entity.readEntityNbt(nbt)
    let sheared0 = nbt.getBool("Sheared")
    let sheared = sheared0.isSome and sheared0.unsafeGet
    let color0 = nbt.getByte("Color")
    let color = if color0.isSome: cast[uint8](color0.unsafeGet) else: 0'u8
    sheep.colorAndSheared = (color and 0x0F'u8) or (if sheared: 0x10'u8 else: 0'u8)

let sheepMobVt = makeSheepMobVt()
let sheepVt = makeSheepVt()

proc newSheepEntity*(entity: Entity): SheepEntity =
  result = SheepEntity(colorAndSheared: 0'u8)
  result.initMob(newMobEntity(entity), sheepMobVt, sheepVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newEscapeDangerGoal(1.25))
  goalSelector.addGoal(2'u8, newBreedGoal(1.0))
  goalSelector.addGoal(3'u8, newTemptGoal(1.1, temptItems()))
  goalSelector.addGoal(4'u8, newFollowParentGoal(1.1))
  goalSelector.addGoal(5'u8, newEatGrassGoal())
  goalSelector.addGoal(6'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(7'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(8'u8, newRandomLookAroundGoal())
