## Port of pumpkin/src/entity/passive/snow_golem.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, track_target, wander_around]
import ../mob/mobvts

type
  SnowGolemEntity* = ref object of Mob

proc newSnowGolemEntity*(entity: Entity): SnowGolemEntity =
  result = SnowGolemEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  let targetSelector = result.mobEntity.targetSelector
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(6'u8, newRandomLookAroundGoal())
  targetSelector.addGoal(1'u8, activeTargetGoalWithDefault(result.mobEntity, EntityType.ZOMBIE, true))
