## Port of pumpkin/src/entity/passive/tropical_fish.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, wander_around]
import ../mob/mobvts

type
  TropicalFishEntity* = ref object of Mob

proc newTropicalFishEntity*(entity: Entity): TropicalFishEntity =
  result = TropicalFishEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(2'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(3'u8, newRandomLookAroundGoal())
