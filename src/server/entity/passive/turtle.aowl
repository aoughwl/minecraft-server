## Port of pumpkin/src/entity/passive/turtle.rs

import "../../../data/item_stack/mod"
import ../ai/aibase
import ../ai/goal/[follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts

proc temptItems(): seq[uint16] =
  ## `TEMPT_ITEMS`
  @[ITEM_SEAGRASS.id]

type
  TurtleEntity* = ref object of Mob

proc newTurtleEntity*(entity: Entity): TurtleEntity =
  result = TurtleEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(2'u8, newBreedGoal(1.0))
  goalSelector.addGoal(3'u8, newTemptGoal(1.1, temptItems()))
  goalSelector.addGoal(5'u8, newWanderAroundGoal(1.0))
  goalSelector.addGoal(6'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 6.0'f32))
  goalSelector.addGoal(7'u8, newRandomLookAroundGoal())
