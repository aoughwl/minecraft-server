## Port of pumpkin/src/entity/passive/villager/data.rs

import std/options
import "../../../../data/item_stack/mod"
import ../../../../generated/villager
import ../../../../protocol/netcodec
import ../../../../protocol/protobase
import ../../../../protocol/varint

export villager

const BreedingFoodThreshold* = 12'i32  ## `BREEDING_FOOD_THRESHOLD`

type
  GossipType* = enum
    gtMajorNegative = 0
    gtMinorNegative = 1
    gtMajorPositive = 2
    gtMinorPositive = 3
    gtTrading = 4

  VillagerData* = object
    typeId*: VarInt
    profession*: VarInt
    level*: VarInt

proc getFoodPoints*(item: Item): int32 =
  if item.id == ITEM_BREAD.id: 4'i32
  elif item.id == ITEM_POTATO.id: 1'i32
  elif item.id == ITEM_CARROT.id: 1'i32
  elif item.id == ITEM_BEETROOT.id: 1'i32
  else: 0'i32

proc writeMetadata*(self: VillagerData; w: var NetWriter): ProtoWriteVoidResult =
  ## `impl MetadataSerializer for VillagerData`
  writeVarInt(w, self.typeId)
  writeVarInt(w, self.profession)
  writeVarInt(w, self.level)
  writeOkVoid()

proc newVillagerData*(typeId: VillagerType; profession: VillagerProfession; level: int32): VillagerData =
  VillagerData(typeId: newVarInt(int32(ord(typeId))), profession: newVarInt(int32(ord(profession))), level: newVarInt(level))

proc typeEnum*(self: VillagerData): VillagerType =
  let found = fromI32(VillagerType, self.typeId.value)
  if found.isSome: found.unsafeGet else: VillagerType.Plains

proc professionEnum*(self: VillagerData): VillagerProfession =
  let found = fromI32(VillagerProfession, self.profession.value)
  if found.isSome: found.unsafeGet else: VillagerProfession.None
