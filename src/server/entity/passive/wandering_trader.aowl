## Port of pumpkin/src/entity/passive/wandering_trader.rs

import ../ai/aibase
import ../ai/goal/[look_around, look_at_entity, swim, wander_around]
import ../mob/mobvts

type
  WanderingTraderEntity* = ref object of Mob

proc newWanderingTraderEntity*(entity: Entity): WanderingTraderEntity =
  result = WanderingTraderEntity()
  result.initMob(newMobEntity(entity), defaultMobVt(), noNbtMobEntityVt())
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(0'u8, newSwimGoal())
  goalSelector.addGoal(1'u8, newWanderAroundGoal(0.6))
  goalSelector.addGoal(2'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(3'u8, newRandomLookAroundGoal())
