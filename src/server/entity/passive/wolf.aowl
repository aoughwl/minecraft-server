## Port of pumpkin/src/entity/passive/wolf.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../nbt/tag as nbttag
import ../../../generated/[meta_data_type, tracked_data]
import ../../../protocol/varint
import ../ai/aibase
import ../ai/goal/[escape_danger, follow, look_around, look_at_entity, misc_goals, swim, wander_around]
import ../mob/mobvts

type
  WolfEntity* = ref object of Mob
    variant*: uint8

proc variantName(variant: uint8): string =
  case variant
  of 0'u8: "minecraft:ashen"
  of 1'u8: "minecraft:black"
  of 2'u8: "minecraft:chestnut"
  of 4'u8: "minecraft:rusty"
  of 5'u8: "minecraft:snowy"
  of 6'u8: "minecraft:spotted"
  of 7'u8: "minecraft:striped"
  of 8'u8: "minecraft:woods"
  else: "minecraft:pale"

proc variantFromName(name: string): uint8 =
  ## With the prefix or without it, and anything unknown is the default.
  case name
  of "ashen", "minecraft:ashen": 0'u8
  of "black", "minecraft:black": 1'u8
  of "chestnut", "minecraft:chestnut": 2'u8
  of "rusty", "minecraft:rusty": 4'u8
  of "snowy", "minecraft:snowy": 5'u8
  of "spotted", "minecraft:spotted": 6'u8
  of "striped", "minecraft:striped": 7'u8
  of "woods", "minecraft:woods": 8'u8
  else: 3'u8

proc makeWolfEntityMobVt(): MobVt =
  result = newMobVt()
  result.mobSetVariantName = proc(self: Mob; name: string) {.closure.} =
    let mob = WolfEntity(self)
    mob.variant = variantFromName(name)
  result.mobInitDataTracker = proc(self: Mob) {.closure.} =
    let mob = WolfEntity(self)
    let entity = self.mobEntity.livingEntity.entity
    if entity.age < 0'i32:
      entity.sendMetaData(TD_BABY, BOOLEAN, true)
    entity.sendMetaData(TD_WOLF_VARIANT, WOLF_VARIANT, newVarInt(int32(mob.variant)))

proc makeWolfEntityVt(): EntityVt =
  result = copyVt(mobEntityVt())
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} =
    let mob = WolfEntity(self)
    Mob(self).mobEntity.livingEntity.writeLivingNbt(nbt)
    nbt.putString("variant", variantName(mob.variant))
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} =
    let mob = WolfEntity(self)
    Mob(self).mobEntity.livingEntity.readLivingNbt(nbt)
    let variantStr = nbt.getString("variant")
    if variantStr.isSome:
      mob.variant = variantFromName(variantStr.unsafeGet)

let wolfEntityMobVt = makeWolfEntityMobVt()
let wolfEntityVt = makeWolfEntityVt()

proc newWolfEntity*(entity: Entity): WolfEntity =
  result = WolfEntity(variant: 3'u8)
  result.initMob(newMobEntity(entity), wolfEntityMobVt, wolfEntityVt)
  let goalSelector = result.mobEntity.goalsSelector
  goalSelector.addGoal(1'u8, newSwimGoal())
  goalSelector.addGoal(4'u8, newEscapeDangerGoal(1.5))
  goalSelector.addGoal(5'u8, newBreedGoal(1.0))
  goalSelector.addGoal(8'u8, newFollowParentGoal(1.1))
  goalSelector.addGoal(9'u8, newBegGoal(8.0'f32, @[ITEM_BONE.id]))
  goalSelector.addGoal(10'u8, lookAtEntityGoalWithDefault(result, EntityType.PLAYER, 8.0'f32))
  goalSelector.addGoal(10'u8, newRandomLookAroundGoal())
  goalSelector.addGoal(12'u8, newWanderAroundGoal(1.0))
