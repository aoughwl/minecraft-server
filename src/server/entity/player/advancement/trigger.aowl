## Port of pumpkin/src/entity/player/advancement/trigger.rs
##
## Upstream's `impl Player { trigger_advancement }`, on `TriggerPlayer`: what it reads of a player, so that serverbase's
## `Player` can hold this without an import cycle. An item is its registry key; triggerNamesResolve checks them all.
##
## HOOK (src/server/entity/player.aowl and serverbase.aowl, another agent's): `Player` needs an `advancements:
## TriggerPlayer` built at join with `has_item_in_inventory`, `main_inventory_has_enchanted` and `rough_biome_id`,
## with `check_inventory_advancements` and the other callers calling `triggerAdvancement`.

import ../advancement

type
  AdvancementTriggerKind* = enum
    atInventoryChanged
    atPlayerKilledEntity
    atEnterBlock
    atPlacedBlock
    atConsumeItem
    atSleptInBed
    atEnterDimension
    atPlayerKilled
    atDeflectedDamage
    atLaunchedEyeOfEnder
    atGlowedSign
    atBredAnimal
    atDealtOverkillDamage
    atSniperDuel
    atTwoBirdsOneArrow
    atArbalistic
    atBullseye
    atCuredZombieVillager

  AdvancementTrigger* = object
    ## `arg` is the variant's one field: `entity_type_resource`, `block_id`, `item_id`, `dimension` or `parent_type`.
    kind*: AdvancementTriggerKind
    arg*: string

  TriggerPlayer* = ref object
    advancements*: PlayerAdvancement
    hasItemInInventory*: proc (itemKey: string): bool {.closure.}
    mainInventoryHasEnchanted*: proc (): bool {.closure.}
    roughBiome*: proc (): string {.closure.}  ## `biome.registry_id` at the player's block.

proc hasAdvancement*(self: TriggerPlayer; advancement: Advancement): bool =
  ## `Player::has_advancement`. `.get(advancement)` does not start progress, so it looks before asking.
  self.advancements.progress.containsKey(advancement) and
    self.advancements.progress.getMutOrStartProgress(advancement).isDone()

proc triggerAdvancementCriterion*(self: TriggerPlayer; advancement: Advancement; criterion: string) =
  ## `Player::trigger_advancement_criterion`.
  discard self.advancements.award(advancement, criterion)

const
  StoneItems* = ["cobblestone", "stone", "andesite", "diorite", "granite", "deepslate", "cobbled_deepslate", "blackstone"]
  IronArmor* = [("iron_helmet", "iron_helmet"), ("iron_chestplate", "iron_chestplate"),
    ("iron_leggings", "iron_leggings"), ("iron_boots", "iron_boots")]
  DiamondArmor* = [("diamond_helmet", "diamond_helmet"), ("diamond_chestplate", "diamond_chestplate"),
    ("diamond_leggings", "diamond_leggings"), ("diamond_boots", "diamond_boots")]
  Fishes* = [("cod", "cod"), ("salmon", "salmon"), ("pufferfish", "pufferfish"), ("tropical_fish", "tropical_fish")]
  FishBuckets* = [("cod_bucket", "cod_bucket"), ("salmon_bucket", "salmon_bucket"),
    ("pufferfish_bucket", "pufferfish_bucket"), ("tropical_fish_bucket", "tropical_fish_bucket")]
  Potions* = ["potion", "splash_potion", "lingering_potion"]
  CityItems* = ["shulker_shell", "chorus_fruit"]
  NetherBiomes* = ["minecraft:basalt_deltas", "minecraft:crimson_forest", "minecraft:nether_wastes",
    "minecraft:soul_sand_valley", "minecraft:warped_forest"]
  OverworldBiomes* = ["minecraft:badlands", "minecraft:bamboo_jungle", "minecraft:beach", "minecraft:birch_forest",
    "minecraft:cherry_grove", "minecraft:cold_ocean", "minecraft:dark_forest", "minecraft:deep_cold_ocean",
    "minecraft:deep_dark", "minecraft:deep_frozen_ocean", "minecraft:deep_lukewarm_ocean", "minecraft:deep_ocean",
    "minecraft:desert", "minecraft:dripstone_caves", "minecraft:eroded_badlands", "minecraft:flower_forest",
    "minecraft:forest", "minecraft:frozen_ocean", "minecraft:frozen_peaks", "minecraft:frozen_river", "minecraft:grove",
    "minecraft:ice_spikes", "minecraft:jagged_peaks", "minecraft:jungle", "minecraft:lukewarm_ocean",
    "minecraft:lush_caves", "minecraft:mangrove_swamp", "minecraft:meadow", "minecraft:mushroom_fields", "minecraft:ocean",
    "minecraft:old_growth_birch_forest", "minecraft:old_growth_pine_taiga", "minecraft:old_growth_spruce_taiga",
    "minecraft:pale_garden", "minecraft:plains", "minecraft:river", "minecraft:savanna", "minecraft:savanna_plateau",
    "minecraft:snowy_beach", "minecraft:snowy_plains", "minecraft:snowy_slopes", "minecraft:snowy_taiga",
    "minecraft:sparse_jungle", "minecraft:stony_peaks", "minecraft:stony_shore", "minecraft:sulfur_caves",
    "minecraft:sunflower_plains", "minecraft:swamp", "minecraft:taiga", "minecraft:warm_ocean",
    "minecraft:windswept_forest", "minecraft:windswept_gravelly_hills", "minecraft:windswept_hills",
    "minecraft:windswept_savanna", "minecraft:wooded_badlands"]
  SeedBlocks* = [("minecraft:wheat", "wheat"), ("minecraft:pumpkin_stem", "pumpkin_stem"),
    ("minecraft:melon_stem", "melon_stem"), ("minecraft:beetroots", "beetroots"),
    ("minecraft:nether_wart", "nether_wart"), ("minecraft:torchflower", "torchflower"),
    ("minecraft:pitcher_pod", "pitcher_pod")]

proc awardIfItem(self: TriggerPlayer; advancement: Advancement; item, criterion: string) =
  ## The commonest arm: not yet done, and the one item in the inventory.
  if not self.hasAdvancement(advancement):
    if self.hasItemInInventory(item):
      self.triggerAdvancementCriterion(advancement, criterion)

proc awardEachItem(self: TriggerPlayer; advancement: Advancement; pairs0: openArray[(string, string)]) =
  ## A criterion per item, with no `break`: every held item counts.
  if not self.hasAdvancement(advancement):
    for pair in pairs0:
      if self.hasItemInInventory(pair[0]):
        self.triggerAdvancementCriterion(advancement, pair[1])

proc awardFirstItem(self: TriggerPlayer; advancement: Advancement; items: openArray[string]; criterion: string) =
  ## One criterion and any of the items, stopping at the first.
  if not self.hasAdvancement(advancement):
    for item in items:
      if self.hasItemInInventory(item):
        self.triggerAdvancementCriterion(advancement, criterion)
        break

proc awardOnce(self: TriggerPlayer; advancement: Advancement; criterion: string) =
  if not self.hasAdvancement(advancement):
    self.triggerAdvancementCriterion(advancement, criterion)

proc containsName(names: openArray[string]; name: string): bool =
  for candidate in names:
    if candidate == name:
      return true
  false

proc inventoryChanged(self: TriggerPlayer) =
  self.awardIfItem(Advancement.STORY_ROOT, "crafting_table", "crafting_table")
  self.awardFirstItem(Advancement.STORY_MINE_STONE, StoneItems, "get_stone")
  self.awardIfItem(Advancement.STORY_UPGRADE_TOOLS, "stone_pickaxe", "stone_pickaxe")
  self.awardIfItem(Advancement.STORY_SMELT_IRON, "iron_ingot", "iron")
  self.awardIfItem(Advancement.STORY_IRON_TOOLS, "iron_pickaxe", "iron_pickaxe")
  self.awardIfItem(Advancement.STORY_MINE_DIAMOND, "diamond", "diamond")
  self.awardIfItem(Advancement.STORY_LAVA_BUCKET, "lava_bucket", "lava_bucket")
  self.awardEachItem(Advancement.STORY_OBTAIN_ARMOR, IronArmor)
  self.awardEachItem(Advancement.STORY_SHINY_GEAR, DiamondArmor)
  self.awardIfItem(Advancement.STORY_FORM_OBSIDIAN, "obsidian", "obsidian")
  self.awardIfItem(Advancement.NETHER_GET_WITHER_SKULL, "wither_skeleton_skull", "wither_skull")
  self.awardIfItem(Advancement.NETHER_OBTAIN_ANCIENT_DEBRIS, "ancient_debris", "ancient_debris")
  self.awardIfItem(Advancement.NETHER_OBTAIN_BLAZE_ROD, "blaze_rod", "blaze_rod")
  self.awardIfItem(Advancement.NETHER_OBTAIN_CRYING_OBSIDIAN, "crying_obsidian", "crying_obsidian")

  if not self.hasAdvancement(Advancement.NETHER_NETHERITE_ARMOR):
    if self.hasItemInInventory("netherite_helmet") and self.hasItemInInventory("netherite_chestplate") and
        self.hasItemInInventory("netherite_leggings") and self.hasItemInInventory("netherite_boots"):
      self.triggerAdvancementCriterion(Advancement.NETHER_NETHERITE_ARMOR, "netherite_armor")

  self.awardEachItem(Advancement.HUSBANDRY_FISHY_BUSINESS, Fishes)
  self.awardEachItem(Advancement.HUSBANDRY_TACTICAL_FISHING, FishBuckets)
  self.awardIfItem(Advancement.HUSBANDRY_AXOLOTL_IN_A_BUCKET, "axolotl_bucket", "axolotl_bucket")
  self.awardIfItem(Advancement.HUSBANDRY_TADPOLE_IN_A_BUCKET, "tadpole_bucket", "tadpole_bucket")
  self.awardIfItem(Advancement.HUSBANDRY_OBTAIN_NETHERITE_HOE, "netherite_hoe", "netherite_hoe")

  if not self.hasAdvancement(Advancement.STORY_ENCHANT_ITEM):
    if self.mainInventoryHasEnchanted():
      self.triggerAdvancementCriterion(Advancement.STORY_ENCHANT_ITEM, "enchanted_item")

  self.awardFirstItem(Advancement.NETHER_BREW_POTION, Potions, "potion")
  self.awardIfItem(Advancement.NETHER_CREATE_BEACON, "beacon", "beacon")
  self.awardIfItem(Advancement.NETHER_CREATE_FULL_BEACON, "beacon", "beacon")
  self.awardIfItem(Advancement.END_ELYTRA, "elytra", "elytra")
  self.awardIfItem(Advancement.END_DRAGON_EGG, "dragon_egg", "dragon_egg")
  self.awardIfItem(Advancement.END_DRAGON_BREATH, "dragon_breath", "dragon_breath")
  self.awardFirstItem(Advancement.END_FIND_END_CITY, CityItems, "in_city")

  if not self.hasAdvancement(Advancement.NETHER_EXPLORE_NETHER):
    let biomeResource = "minecraft:" & self.roughBiome()
    if containsName(NetherBiomes, biomeResource):
      self.triggerAdvancementCriterion(Advancement.NETHER_EXPLORE_NETHER, biomeResource)

  if not self.hasAdvancement(Advancement.ADVENTURE_ADVENTURING_TIME):
    let biomeResource = "minecraft:" & self.roughBiome()
    if containsName(OverworldBiomes, biomeResource):
      self.triggerAdvancementCriterion(Advancement.ADVENTURE_ADVENTURING_TIME, biomeResource)

proc stripMinecraft(id: string): string =
  const Prefix = "minecraft:"
  if id.len >= Prefix.len and id[0 ..< Prefix.len] == Prefix:
    id[Prefix.len .. ^1]
  else:
    id

proc triggerAdvancement*(self: TriggerPlayer; trigger: AdvancementTrigger) =
  case trigger.kind
  of atInventoryChanged:
    self.inventoryChanged()
  of atPlayerKilledEntity:
    self.triggerAdvancementCriterion(Advancement.ADVENTURE_KILL_A_MOB, trigger.arg)
    self.triggerAdvancementCriterion(Advancement.ADVENTURE_KILL_ALL_MOBS, trigger.arg)
    self.awardOnce(Advancement.ADVENTURE_ROOT, "killed_something")
  of atSleptInBed:
    self.awardOnce(Advancement.ADVENTURE_SLEEP_IN_BED, "slept_in_bed")
  of atPlacedBlock:
    if not self.hasAdvancement(Advancement.HUSBANDRY_PLANT_SEED):
      for pair in SeedBlocks:
        if trigger.arg == pair[0]:
          self.triggerAdvancementCriterion(Advancement.HUSBANDRY_PLANT_SEED, pair[1])
          break
  of atEnterDimension:
    if trigger.arg == "the_nether":
      self.awardOnce(Advancement.STORY_ENTER_THE_NETHER, "entered_nether")
      self.awardOnce(Advancement.NETHER_ROOT, "entered_nether")
    elif trigger.arg == "the_end":
      self.awardOnce(Advancement.STORY_ENTER_THE_END, "entered_end")
      self.awardOnce(Advancement.END_ROOT, "entered_end")
  of atConsumeItem:
    self.awardOnce(Advancement.HUSBANDRY_ROOT, "consumed_item")
    let foodName = stripMinecraft(trigger.arg)
    if containsName(Advancement.HUSBANDRY_BALANCED_DIET.criteria, foodName):
      self.triggerAdvancementCriterion(Advancement.HUSBANDRY_BALANCED_DIET, foodName)
  of atPlayerKilled:
    self.awardOnce(Advancement.ADVENTURE_ROOT, "killed_by_something")
  of atDeflectedDamage:
    self.awardOnce(Advancement.STORY_DEFLECT_ARROW, "deflected_projectile")
  of atLaunchedEyeOfEnder:
    self.awardOnce(Advancement.STORY_FOLLOW_ENDER_EYE, "in_stronghold")
  of atGlowedSign:
    self.awardOnce(Advancement.HUSBANDRY_MAKE_A_SIGN_GLOW, "make_a_sign_glow")
  of atBredAnimal:
    self.triggerAdvancementCriterion(Advancement.HUSBANDRY_BREED_AN_ANIMAL, "bred")
    self.triggerAdvancementCriterion(Advancement.HUSBANDRY_BRED_ALL_ANIMALS, trigger.arg)
  of atEnterBlock:
    discard
  of atDealtOverkillDamage:
    self.awardOnce(Advancement.ADVENTURE_OVEROVERKILL, "overoverkill")
  of atSniperDuel:
    self.awardOnce(Advancement.ADVENTURE_SNIPER_DUEL, "killed_skeleton")
  of atTwoBirdsOneArrow:
    self.awardOnce(Advancement.ADVENTURE_TWO_BIRDS_ONE_ARROW, "two_birds")
  of atArbalistic:
    self.awardOnce(Advancement.ADVENTURE_ARBALISTIC, "arbalistic")
  of atBullseye:
    self.awardOnce(Advancement.ADVENTURE_BULLSEYE, "bullseye")
  of atCuredZombieVillager:
    self.awardOnce(Advancement.STORY_CURE_ZOMBIE_VILLAGER, "cured_zombie")
