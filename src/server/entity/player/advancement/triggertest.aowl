## Known answers for trigger.aowl, read from pumpkin/src/entity/player/advancement/trigger.rs. Upstream has no #[test].

import std/[assertions, options, os]
import trigger
import ../advancement
import ../../../../util/text/text
import ../../../../util/uuid
import ../../../../world/worldfs

proc makePlayer(items: seq[string]; biome: string): TriggerPlayer =
  let (ok, id) = newV4()
  assert ok
  let dir = getTempDir() & "/triggertest_" & $id
  discard createDirAllW(dir)
  let pa = newPlayerAdvancement(newAdvancementManager(dir, false), id)
  proc sendUpdate(packet: CUpdateAdvancements) {.closure.} = discard
  proc sendTab(packet: CSelectAdvancementsTab) {.closure.} = discard
  proc addXp(amount: int32) {.closure.} = discard
  proc showMessages(): bool {.closure.} = false
  proc displayName(): TextComponent {.closure.} = text("Steve")
  proc broadcast(message: TextComponent; overlay: bool) {.closure.} = discard
  pa.setPlayer(AdvancementPlayer(sendUpdateAdvancements: sendUpdate, sendSelectAdvancementsTab: sendTab,
    addExperiencePoints: addXp, showAdvancementMessages: showMessages, getDisplayName: displayName,
    broadcastSystemMessage: broadcast))
  proc hasItem(key: string): bool {.closure.} =
    key in items
  proc enchanted(): bool {.closure.} = false
  proc roughBiome(): string {.closure.} = biome
  TriggerPlayer(advancements: pa, hasItemInInventory: hasItem, mainInventoryHasEnchanted: enchanted, roughBiome: roughBiome)

proc done(p: TriggerPlayer; a: Advancement): bool = p.hasAdvancement(a)

# Nothing held: nothing granted, and `has_advancement` itself starts no progress.
let empty = makePlayer(@[], "the_void")
assert not empty.hasAdvancement(Advancement.STORY_ROOT)
assert empty.advancements.progress.isEmpty()
empty.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
assert not empty.done(Advancement.STORY_ROOT)
assert not empty.done(Advancement.NETHER_EXPLORE_NETHER)

# Single-item arms, including the two whose criterion is not the item's name.
let p1 = makePlayer(@["crafting_table", "iron_ingot", "wither_skeleton_skull", "blackstone"], "the_void")
p1.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
assert p1.done(Advancement.STORY_ROOT)
assert p1.done(Advancement.STORY_SMELT_IRON)
assert p1.done(Advancement.NETHER_GET_WITHER_SKULL)
assert p1.done(Advancement.STORY_MINE_STONE)
assert not p1.done(Advancement.STORY_MINE_DIAMOND)

# STORY_OBTAIN_ARMOR's requirement is one group: any piece completes it.
let p2 = makePlayer(@["iron_boots"], "the_void")
p2.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
assert p2.done(Advancement.STORY_OBTAIN_ARMOR)

# Netherite armor wants all four.
let p3 = makePlayer(@["netherite_helmet", "netherite_chestplate", "netherite_leggings"], "the_void")
p3.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
assert not p3.done(Advancement.NETHER_NETHERITE_ARMOR)
let p4 = makePlayer(@["netherite_helmet", "netherite_chestplate", "netherite_leggings", "netherite_boots"], "the_void")
p4.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
assert p4.done(Advancement.NETHER_NETHERITE_ARMOR)

# A biome criterion is the namespaced name; adventuring time needs them all, so one is progress only.
let p5 = makePlayer(@[], "plains")
p5.triggerAdvancement(AdvancementTrigger(kind: atInventoryChanged))
let adventuring = p5.advancements.progress.getMutOrStartProgress(Advancement.ADVENTURE_ADVENTURING_TIME)
assert adventuring.hasProgress()
assert not adventuring.isDone()
assert adventuring.getCompletedCriteria() == @["minecraft:plains"]

# Killing.
let p6 = makePlayer(@[], "plains")
p6.triggerAdvancement(AdvancementTrigger(kind: atPlayerKilledEntity, arg: "minecraft:zombie"))
assert p6.done(Advancement.ADVENTURE_ROOT)
assert p6.done(Advancement.ADVENTURE_KILL_A_MOB)
assert p6.advancements.progress.getMutOrStartProgress(Advancement.ADVENTURE_KILL_ALL_MOBS).getCompletedCriteria() == @["minecraft:zombie"]

# Dimensions.
let p7 = makePlayer(@[], "plains")
p7.triggerAdvancement(AdvancementTrigger(kind: atEnterDimension, arg: "the_nether"))
assert p7.done(Advancement.STORY_ENTER_THE_NETHER)
assert p7.done(Advancement.NETHER_ROOT)
assert not p7.done(Advancement.END_ROOT)
p7.triggerAdvancement(AdvancementTrigger(kind: atEnterDimension, arg: "the_end"))
assert p7.done(Advancement.STORY_ENTER_THE_END)
assert p7.done(Advancement.END_ROOT)

# Eating: the prefix comes off, and a name not in the balanced diet's criteria is not awarded.
let p8 = makePlayer(@[], "plains")
p8.triggerAdvancement(AdvancementTrigger(kind: atConsumeItem, arg: "minecraft:apple"))
assert p8.done(Advancement.HUSBANDRY_ROOT)
assert p8.advancements.progress.getMutOrStartProgress(Advancement.HUSBANDRY_BALANCED_DIET).getCompletedCriteria() == @["apple"]
p8.triggerAdvancement(AdvancementTrigger(kind: atConsumeItem, arg: "minecraft:stick"))
assert p8.advancements.progress.getMutOrStartProgress(Advancement.HUSBANDRY_BALANCED_DIET).getCompletedCriteria() == @["apple"]

# Planting, and the no-op arm.
let p9 = makePlayer(@[], "plains")
p9.triggerAdvancement(AdvancementTrigger(kind: atPlacedBlock, arg: "minecraft:stone"))
assert not p9.done(Advancement.HUSBANDRY_PLANT_SEED)
p9.triggerAdvancement(AdvancementTrigger(kind: atPlacedBlock, arg: "minecraft:wheat"))
assert p9.done(Advancement.HUSBANDRY_PLANT_SEED)
p9.triggerAdvancement(AdvancementTrigger(kind: atEnterBlock, arg: "minecraft:stone"))

# The simple one-criterion arms: each criterion name must exist on its advancement or `award` silently does nothing.
let p10 = makePlayer(@[], "plains")
p10.triggerAdvancement(AdvancementTrigger(kind: atSleptInBed))
assert p10.done(Advancement.ADVENTURE_SLEEP_IN_BED)
p10.triggerAdvancement(AdvancementTrigger(kind: atDeflectedDamage))
assert p10.done(Advancement.STORY_DEFLECT_ARROW)
p10.triggerAdvancement(AdvancementTrigger(kind: atLaunchedEyeOfEnder))
assert p10.done(Advancement.STORY_FOLLOW_ENDER_EYE)
p10.triggerAdvancement(AdvancementTrigger(kind: atGlowedSign))
assert p10.done(Advancement.HUSBANDRY_MAKE_A_SIGN_GLOW)
p10.triggerAdvancement(AdvancementTrigger(kind: atDealtOverkillDamage))
assert p10.done(Advancement.ADVENTURE_OVEROVERKILL)
p10.triggerAdvancement(AdvancementTrigger(kind: atSniperDuel))
assert p10.done(Advancement.ADVENTURE_SNIPER_DUEL)
p10.triggerAdvancement(AdvancementTrigger(kind: atTwoBirdsOneArrow))
assert p10.done(Advancement.ADVENTURE_TWO_BIRDS_ONE_ARROW)
p10.triggerAdvancement(AdvancementTrigger(kind: atArbalistic))
assert p10.done(Advancement.ADVENTURE_ARBALISTIC)
p10.triggerAdvancement(AdvancementTrigger(kind: atBullseye))
assert p10.done(Advancement.ADVENTURE_BULLSEYE)
p10.triggerAdvancement(AdvancementTrigger(kind: atCuredZombieVillager))
assert p10.done(Advancement.STORY_CURE_ZOMBIE_VILLAGER)
p10.triggerAdvancement(AdvancementTrigger(kind: atPlayerKilled))
assert p10.done(Advancement.ADVENTURE_ROOT)

let p11 = makePlayer(@[], "plains")
p11.triggerAdvancement(AdvancementTrigger(kind: atBredAnimal, arg: "minecraft:cow"))
assert p11.done(Advancement.HUSBANDRY_BREED_AN_ANIMAL)
assert p11.advancements.progress.getMutOrStartProgress(Advancement.HUSBANDRY_BRED_ALL_ANIMALS).getCompletedCriteria() == @["minecraft:cow"]
