## Port of pumpkin/src/entity/player/advancement/visibility_evaluator.rs
##
## Upstream hands `&mut PlayerAdvancement` to each callback through this module. Imports may not cycle, and a callback
## that needs the player's advancements captures them instead, so the callbacks take the node alone.

import std/options
import ../../../../data/advancement_data

const VisibilityDepth = 3  ## `VISIBILITY_DEPTH`

type
  VisibilityRule* = enum
    vrShow
    vrHide
    vrNoChange

  IsDoneTest* = proc (node: AdvancementNode): bool {.closure.}
  VisibilityOutput* = proc (node: AdvancementNode; visible: bool) {.closure.}

proc evaluateVisibilityRule(advancement: Advancement; isDone: bool): VisibilityRule =
  if advancement.display.isNone:
    return vrHide
  if isDone:
    vrShow
  elif advancement.display.unsafeGet.hidden:
    vrHide
  else:
    vrNoChange

proc evaluateVisibilityForUnfinishedNode(ascendants: seq[VisibilityRule]): bool =
  let start = max(ascendants.len - VisibilityDepth, 0)
  var i = ascendants.len - 1
  while i >= start:
    if ascendants[i] == vrShow:
      return true
    if ascendants[i] == vrHide:
      return false
    dec i
  false

proc evaluateVisibilityWithRules*(node: AdvancementNode; ascendants: var seq[VisibilityRule]; isDoneTest: IsDoneTest;
    output: VisibilityOutput): bool =
  let isSelfDone = isDoneTest(node)
  let descendantVisibility = evaluateVisibilityRule(node.value, isSelfDone)
  var isSelfOrDescendantDone = isSelfDone
  ascendants.add(descendantVisibility)

  for child in node.children:
    # `|=` on a bool does not short-circuit: every child is evaluated.
    let childDone = evaluateVisibilityWithRules(ADVANCEMENT_TREE.nodesVector[child], ascendants, isDoneTest, output)
    isSelfOrDescendantDone = isSelfOrDescendantDone or childDone

  let visibility = isSelfOrDescendantDone or evaluateVisibilityForUnfinishedNode(ascendants)
  discard ascendants.pop()
  output(node, visibility)
  isSelfOrDescendantDone

proc evaluateVisibility*(node: AdvancementNode; isDone: IsDoneTest; output: VisibilityOutput): bool =
  let root = node.root()
  var visibilityStack: seq[VisibilityRule] = @[]
  evaluateVisibilityWithRules(root, visibilityStack, isDone, output)
