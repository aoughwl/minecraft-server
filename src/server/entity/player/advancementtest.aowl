## Upstream's #[test]s from pumpkin/src/entity/player/advancement.rs and pumpkin/src/data/advancement_data.rs, plus known
## answers for `award`, `flush_dirty` and the file layout serde writes.

import std/[assertions, options, os, strutils, tables]
import advancement
import ../../../codecs/json_value
import ../../../util/uuid
import ../../../util/text/text
import ../../../world/worldfs

var serial = 0

proc newId(): Uuid =
  let (ok, id) = newV4()
  assert ok
  id

proc tempDir(): string =
  inc serial
  result = getTempDir() & "/advancementtest_" & $newId() & "_" & $serial
  discard createDirAllW(result)

proc writeText(path, text: string) =
  var bytes = newSeq[byte](text.len)
  for i in 0 ..< text.len:
    bytes[i] = byte(ord(text[i]))
  assert writeFileBytes(path, bytes)

proc readText(path: string): string =
  let (status, bytes) = readFileBytes(path)
  assert status == rsOk
  result = newString(bytes.len)
  for i in 0 ..< bytes.len:
    result[i] = char(bytes[i])

proc emptyCriterion(): CriterionProgress =
  CriterionProgress(time: none[SystemTime]())

proc advancementProgressTest() =
  var progress = AdvancementProgress(requirements: AdvancementRequirement(requirements: @[@["testCriteria"], @["testCriteria2"]]))
  progress.addCriterion("testCriteria", emptyCriterion())
  progress.addCriterion("testCriteria2", emptyCriterion())
  assert not progress.isDone()
  assert not progress.hasProgress()
  discard progress.grantProgress("testCriteria")
  assert not progress.isDone()
  assert progress.hasProgress()
  discard progress.grantProgress("testCriteria2")
  assert progress.isDone()
  assert progress.hasProgress()

proc newPlayerAdvancementTest() =
  let manager = newAdvancementManager(tempDir(), true)
  let pa = newPlayerAdvancement(manager, newId())
  assert pa.isSaveEnabled()
  assert pa.isFirstPacket
  assert pa.rootsToUpdate.len == 0
  assert pa.progress.isEmpty()

proc getOrStartProgressTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  let adv = Advancement.STORY_ROOT
  assert not pa.progress.getMutOrStartProgress(adv).isDone()

proc revokeAdvancementTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  let adv = Advancement.STORY_ROOT
  discard pa.progress.getMutOrStartProgress(adv).grantProgress("crafting_table")
  assert pa.progress.getMutOrStartProgress(adv).isDone()
  discard pa.revoke(adv, "crafting_table")
  assert not pa.progress.getMutOrStartProgress(adv).isDone()

proc saveAdvancementProgressTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  let adv = Advancement.STORY_ROOT
  discard pa.progress.getMutOrStartProgress(adv).grantProgress("crafting_table")
  assert pa.save().ok
  assert fileExistsW(pa.path)
  let content = readText(pa.path)
  assert content.len > 0
  let parsed = parseJsonValue(content)
  assert parsed.ok
  # The layout vanilla writes: the id, its granted criteria with a date, `done`, and the DataVersion.
  let (found, entry) = parsed.value.get("minecraft:story/root")
  assert found
  let (hasCriteria, criteria) = entry.get("criteria")
  assert hasCriteria
  let (hasCriterion, time) = criteria.get("crafting_table")
  assert hasCriterion and time.kind == jvString
  assert time.strVal.len == 25 and time.strVal.endsWith(" +0000")
  let (hasDone, done) = entry.get("done")
  assert hasDone and done.kind == jvBool and done.boolVal
  let (hasVersion, version) = parsed.value.get("DataVersion")
  assert hasVersion and version.intVal == 4671
  assert content.contains("  \"minecraft:story/root\": {\n    \"criteria\": {\n      \"crafting_table\": \"")

proc vanillaFileTest() =
  # Dates, against known answers: 2026-09-11 08:32:50 -0400 is 12:32:50 UTC.
  let (ok, secs) = parseAdvancementTime("2026-09-11 08:32:50 -0400")
  assert ok
  assert formatAdvancementTime(secs) == "2026-09-11 12:32:50 +0000"
  assert formatAdvancementTime(0'i64) == "1970-01-01 00:00:00 +0000"
  assert formatAdvancementTime(951782400'i64) == "2000-02-29 00:00:00 +0000"
  assert parseAdvancementTime("2000-02-29 00:00:00 +0000") == (true, 951782400'i64)
  assert not parseAdvancementTime("not a date")[0]
  # A file as a vanilla 1.21.11 server wrote it (copied from a real world), read and written back.
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  writeText(pa.path, "{\n  \"minecraft:story/root\": {\n    \"criteria\": {\n      \"crafting_table\": \"2026-09-11 08:32:50 -0400\"\n    },\n    \"done\": true\n  },\n  \"minecraft:recipes/decorations/crafting_table\": {\n    \"criteria\": {\n      \"unlock_right_away\": \"2026-09-11 08:32:50 -0400\"\n    },\n    \"done\": true\n  },\n  \"DataVersion\": 4671\n}")
  assert pa.load().ok
  assert pa.progress.getMutOrStartProgress(Advancement.STORY_ROOT).isDone()
  let written = pa.toJson()
  let (hasRoot, root) = written.get("minecraft:story/root")
  assert hasRoot
  let (_, crit) = root.get("criteria")
  let (_, when0) = crit.get("crafting_table")
  assert when0.strVal == "2026-09-11 12:32:50 +0000"
  let (_, done) = root.get("done")
  assert done.boolVal

proc saveDisabledTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), false), newId())
  discard pa.progress.getMutOrStartProgress(Advancement.STORY_ROOT).grantProgress("crafting_table")
  assert pa.save().ok
  assert not fileExistsW(pa.path)

proc loadNonexistentFileTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  assert pa.load().ok
  assert pa.progress.isEmpty()

proc loadAdvancementProgressTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  let adv = Advancement.STORY_ROOT
  var progress = AdvancementProgress(requirements: AdvancementRequirement(requirements: @[]))
  progress.update(fromConst(AdvancementRequirement, adv.requirements))
  discard progress.grantProgress("crafting_table")
  var data = jsonObject()
  data.put($adv, progress.toJson())
  writeText(pa.path, toJsonString(data))
  assert pa.load().ok
  assert pa.progress.getMutOrStartProgress(adv).isDone()

proc saveLoadRoundtripTest() =
  let manager = newAdvancementManager(tempDir(), true)
  let id = newId()
  let pa = newPlayerAdvancement(manager, id)
  let adv = Advancement.STORY_ROOT
  discard pa.progress.getMutOrStartProgress(adv).grantProgress("crafting_table")
  assert pa.save().ok
  let loaded = newPlayerAdvancement(manager, id)
  assert loaded.load().ok
  assert loaded.progress.getMutOrStartProgress(adv).isDone()
  assert loaded.progress.len == pa.progress.len

proc loadInvalidAdvancementIdTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  var progress = AdvancementProgress(requirements: AdvancementRequirement(requirements: @[@["testCriteria"]]))
  progress.addCriterion("testCriteria", emptyCriterion())
  var data = jsonObject()
  data.put("invalid_advancement_id_12345", progress.toJson())
  writeText(pa.path, toJsonString(data))
  assert pa.load().ok
  assert pa.progress.isEmpty()

proc saveMultipleAdvancementsTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  discard pa.progress.getMutOrStartProgress(Advancement.STORY_ROOT).grantProgress("crafting_table")
  discard pa.progress.getMutOrStartProgress(Advancement.NETHER_ROOT).grantProgress("entered_nether")
  assert pa.save().ok
  let parsed = parseJsonValue(readText(pa.path))
  assert parsed.ok
  assert parsed.value.keys.len == 3  # two advancements and the DataVersion

proc ignoreLoadingTest() =
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), false), newId())
  writeText(pa.path, "{\"minecraft:story/root\":{\"complete\":true}}")
  assert pa.load().ok
  assert pa.progress.isEmpty()

proc advancementManagerNewTest() =
  let dir = tempDir()
  let manager = newAdvancementManager(dir, true)
  assert manager.advancementPath == joinPathW(dir, "advancements")
  assert manager.advancementPath.endsWith("advancements")
  assert manager.getAdvancements().len == 1688

proc awardFlushTest() =
  ## Not upstream's: `award` grants the reward and announces once, and `flush_dirty` sends what became visible.
  let pa = newPlayerAdvancement(newAdvancementManager(tempDir(), true), newId())
  var xp = 0'i32
  var messages = 0
  var updates: seq[CUpdateAdvancements] = @[]
  var tabs: seq[CSelectAdvancementsTab] = @[]
  proc sendUpdate(packet: CUpdateAdvancements) {.closure.} =
    updates.add(packet)
  proc sendTab(packet: CSelectAdvancementsTab) {.closure.} =
    tabs.add(packet)
  proc addXp(amount: int32) {.closure.} =
    xp += amount
  proc showMessages(): bool {.closure.} = true
  proc displayName(): TextComponent {.closure.} = text("Steve")
  proc broadcast(message: TextComponent; overlay: bool) {.closure.} =
    inc messages
  pa.setPlayer(AdvancementPlayer(sendUpdateAdvancements: sendUpdate, sendSelectAdvancementsTab: sendTab,
    addExperiencePoints: addXp, showAdvancementMessages: showMessages, getDisplayName: displayName,
    broadcastSystemMessage: broadcast))

  # story/root's display has announce_to_chat false, mine_stone's true.
  let root = Advancement.STORY_ROOT
  assert not root.display.unsafeGet.announceToChat
  assert pa.award(root, "crafting_table")
  assert not pa.award(root, "crafting_table"), "granting twice changes nothing"
  assert not pa.award(root, "no_such_criterion")
  assert messages == 0
  assert pa.rootsToUpdate.len == 1
  pa.flushDirty(true)
  assert not pa.isFirstPacket
  assert pa.rootsToUpdate.len == 0
  assert updates.len == 1
  assert updates[0].reset
  assert updates[0].showAdvancements
  assert root in updates[0].added
  # is_done starts progress on every node it visits, so each newly visible node reports progress too.
  assert updates[0].progress.len == updates[0].added.len
  var granted = 0
  for entry in updates[0].progress:
    for criterion in entry.progress:
      if criterion.achieveDate.isSome:
        inc granted
        assert entry.id == root.id
        assert criterion.criterionId == "crafting_table"
  assert granted == 1

  # story/mine_stone is the next one down: visible now, and shown with no parent to hide it.
  let stone = Advancement.STORY_MINE_STONE
  assert stone in updates[0].added
  assert stone.display.unsafeGet.announceToChat
  assert pa.award(stone, "get_stone")
  assert messages == 1
  pa.flushDirty(false)
  assert updates.len == 2
  assert not updates[1].reset

  # Nothing dirty: no packet.
  pa.flushDirty(false)
  assert updates.len == 2

  # set_selected_tab sends only on change and only takes a root with a display.
  pa.setSelectedTab(some(root))
  assert tabs.len == 1
  assert tabs[0].tabId == some(root.id)
  pa.setSelectedTab(some(root))
  assert tabs.len == 1
  pa.setSelectedTab(some(stone))
  assert tabs.len == 2
  assert tabs[1].tabId.isNone

advancementProgressTest()
newPlayerAdvancementTest()
getOrStartProgressTest()
revokeAdvancementTest()
saveAdvancementProgressTest()
vanillaFileTest()
saveDisabledTest()
loadNonexistentFileTest()
loadAdvancementProgressTest()
saveLoadRoundtripTest()
loadInvalidAdvancementIdTest()
saveMultipleAdvancementsTest()
ignoreLoadingTest()
advancementManagerNewTest()
awardFlushTest()
