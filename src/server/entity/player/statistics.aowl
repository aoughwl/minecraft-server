## Port of pumpkin/src/entity/player/statistics.rs
##
## `CustomStatistic` and `StatisticCategory` are src/generated/statistic.aowl, whose enums carry upstream's ids.

import std/[options, strutils, tables]
import ../../../generated/statistic
import ../../../nbt/tag

export statistic

type
  Statistics* = object
    stats*: Table[(int32, int32), int32]  ## (Category ID, Statistic ID) -> Value

proc saturatingAdd(a, b: int32): int32 =
  let sum = int64(a) + int64(b)
  if sum > int64(high(int32)): high(int32)
  elif sum < int64(low(int32)): low(int32)
  else: int32(sum)

proc increment*(self: var Statistics; category: StatisticCategory; stat, amount: int32) =
  let key = (int32(ord(category)), stat)
  self.stats[key] = saturatingAdd(self.stats.getOrDefault(key, 0'i32), amount)

proc incrementCustom*(self: var Statistics; stat: CustomStatistic; amount: int32) =
  self.increment(scCustom, int32(ord(stat)), amount)

proc set*(self: var Statistics; category: StatisticCategory; stat, value: int32) =
  self.stats[(int32(ord(category)), stat)] = value

proc get*(self: Statistics; category: StatisticCategory; stat: int32): int32 =
  self.stats.getOrDefault((int32(ord(category)), stat), 0'i32)

proc writeNbt*(self: Statistics; nbt: var NbtCompound) =
  var statsCompound = newCompound()
  for key, value in self.stats:
    statsCompound.putInt($key[0] & ":" & $key[1], value)
  nbt.putCompound("Statistics", statsCompound)

proc parseI32(text: string): (bool, int32) =
  ## `str::parse::<i32>`: an optional sign and decimal digits, nothing else, in range.
  var i = 0
  var negative = false
  if i < text.len and (text[i] == '-' or text[i] == '+'):
    negative = text[i] == '-'
    inc i
  if i >= text.len:
    return (false, 0'i32)
  var value = 0'i64
  while i < text.len:
    if text[i] notin {'0' .. '9'}:
      return (false, 0'i32)
    value = value * 10 + int64(ord(text[i]) - ord('0'))
    if value > 2147483648'i64:
      return (false, 0'i32)
    inc i
  if negative:
    value = -value
  if value > int64(high(int32)):
    return (false, 0'i32)
  (true, int32(value))

proc readNbt*(self: var Statistics; nbt: NbtCompound) =
  let found = nbt.getCompound("Statistics")
  if found.isNone:
    return
  let statsCompound = found.unsafeGet
  for i in 0 ..< statsCompound.names.len:
    let tagValue = statsCompound.values[i]
    let parts = statsCompound.names[i].split(':')
    if tagValue.kind == ntkInt and parts.len == 2:
      let (catOk, category) = parseI32(parts[0])
      let (statOk, stat) = parseI32(parts[1])
      if catOk and statOk:
        self.stats[(category, stat)] = tagValue.intVal
