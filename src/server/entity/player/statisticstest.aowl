## Known answers for statistics.aowl, read from pumpkin/src/entity/player/statistics.rs. Upstream has no #[test] here.

import std/[assertions, options]
import statistics
import ../../../nbt/tag

var s: Statistics
assert s.get(scKilled, 5'i32) == 0'i32
s.increment(scKilled, 5'i32, 3'i32)
s.increment(scKilled, 5'i32, 4'i32)
assert s.get(scKilled, 5'i32) == 7'i32

# `saturating_add`, not a wrap.
s.set(scMined, 1'i32, high(int32))
s.increment(scMined, 1'i32, 10'i32)
assert s.get(scMined, 1'i32) == high(int32)

# `increment_custom` goes under category 8 with the stat's own id.
s.incrementCustom(csDamageDealt, 2'i32)
assert s.get(scCustom, 25'i32) == 2'i32

var nbt = newCompound()
s.writeNbt(nbt)
let written = nbt.getCompound("Statistics")
assert written.isSome
assert written.unsafeGet.getInt("6:5") == some(7'i32)
assert written.unsafeGet.getInt("8:25") == some(2'i32)

var back: Statistics
back.readNbt(nbt)
assert back.get(scKilled, 5'i32) == 7'i32
assert back.get(scCustom, 25'i32) == 2'i32

# Keys that do not parse and tags that are not ints are skipped.
var inner = newCompound()
inner.putInt("nope", 1'i32)
inner.putInt("1:2:3", 1'i32)
inner.putInt("x:2", 1'i32)
inner.putString("3:4", "text")
inner.putInt("3:5", 9'i32)
var outer = newCompound()
outer.putCompound("Statistics", inner)
var partial: Statistics
partial.readNbt(outer)
assert partial.stats.len == 1
assert partial.get(scBroken, 5'i32) == 9'i32

# No "Statistics" compound leaves it untouched.
partial.readNbt(newCompound())
assert partial.stats.len == 1
