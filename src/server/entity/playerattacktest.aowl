## Known answers for entity/playerattack.aowl's cooldown, the statistics a player keeps and a bed's respawn offsets.
import std/[assertions, syncio, tables]
import ../../generated/statistic
import ../serverbase
import ../world/worldmod
import player as playermod
import player/statistics
import playerattack
import respawn
import ../../generated/block_enums

proc cooldown() =
  # `get_attack_cooldown_progress(tps, 0.5, 4.0)`: (ticks + 0.5) / (tps / speed), clamped to 0..1.
  let p = Player()
  p.lastAttackedTicks = 0'u32
  assert abs(p.getAttackCooldownProgress(20.0'f64, 0.5'f64, 4.0'f64) - 0.1'f64) < 1.0e-12
  p.lastAttackedTicks = 2'u32
  assert abs(p.getAttackCooldownProgress(20.0'f64, 0.5'f64, 4.0'f64) - 0.5'f64) < 1.0e-12
  p.lastAttackedTicks = 20'u32
  assert p.getAttackCooldownProgress(20.0'f64, 0.5'f64, 4.0'f64) == 1.0'f64
  # A slower weapon (speed 1.6): the progress per tick is 12.5 ticks.
  p.lastAttackedTicks = 6'u32
  assert abs(p.getAttackCooldownProgress(20.0'f64, 0.5'f64, 1.6'f64) - 0.52'f64) < 1.0e-12

proc stats() =
  let p = Player()
  p.entityId = 4242'i32
  p.incrementStat(scCustom, int32(ord(csJump)), 1'i32)
  p.incrementCustomStat(csJump, 2'i32)
  p.setStat(scDropped, 9'i32, 5'i32)
  let table = gPlayerStats.getOrDefault(4242'i32)
  assert table.get(scCustom, int32(ord(csJump))) == 3'i32
  assert table.get(scDropped, 9'i32) == 5'i32
  assert table.get(scMined, 1'i32) == 0'i32

proc offsets() =
  # A bed facing north: forward is -z, the clockwise rotation (-fz, fx) is +x.
  let north = bedSpawnOffsets(HorizontalFacing.North)
  assert north.len == 10
  assert north[0] == (1'i32, 0'i32) and north[1] == (-1'i32, 0'i32)
  assert north[2] == (1'i32, 1'i32) and north[4] == (0'i32, 1'i32) and north[5] == (0'i32, 2'i32)
  assert north[8] == (0'i32, -1'i32) and north[9] == (1'i32, 2'i32)
  let east = bedSpawnOffsets(HorizontalFacing.East)
  assert east[0] == (0'i32, 1'i32) and east[8] == (1'i32, 0'i32)

cooldown()
stats()
offsets()
echo "player attack tests: all checks passed"
