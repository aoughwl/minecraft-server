## Known answers for entity/playerextras.aowl's `update_player_pose`, `can_fit_pose` and `get_movement_statistic`, worked from
## pumpkin/src/entity/player.rs (the Rust has no #[test] for them).

import std/[assertions, cmdline, options, syncio]
import "../../data/item_stack/mod"
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../generated/[entity_pose, statistic, entity_type]
import ../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../../util/gamemode
import ../data/datamod
import ../recipe
import ../scheduler
import ../tick_rate_manager
import ../../util/text/text
import ../../util/text/textbase
import ../net/netbase
import entitymod
import playerextras
import playerxp
import player as playermod

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/playerextras_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)

proc stateOf(b: Block): uint32 = uint32(asU16(b.defaultState.id))

# A stone floor at y=63 over a few chunks.
for cx in -1'i32 .. 1'i32:
  for cz in -1'i32 .. 1'i32:
    addLoadedChunk(theLevel, newChunkData(cx, cz, newChunkSections(24, -64'i32)))
    for x in 0'i32 .. 15'i32:
      for z in 0'i32 .. 15'i32:
        discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: cx * 16'i32 + x, y: 63'i32, z: cz * 16'i32 + z)),
          stateOf(blockStone()))

proc at(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)

var nextId = 900'i32

proc newTestPlayer(p: Vector3[float64]): Player =
  nextId += 1'i32
  result = Player(world: testWorld, entityId: nextId, gamemode: Survival, pos: p, lastPos: p, sleepingSince: -1'i32,
    clientLoadedTimeout: 5'u32)
  result.chunkPos = Vector2[int32](x: 0'i32, y: 0'i32)

proc setRoof(y: int32; air: bool) =
  for x in -1'i32 .. 1'i32:
    for z in -1'i32 .. 1'i32:
      discard level.setBlockState(theLevel, BlockPos(vec: Vector3[int32](x: x, y: y, z: z)),
        (if air: uint32(asU16(blockAir().defaultState.id)) else: stateOf(blockStone())))

proc pose() =
  # Open sky: standing, sneaking -> crouching (flying sneakers stand), sleeping -> sleeping, a spectator keeps the desire.
  let p = newTestPlayer(at(0.5, 64.0, 0.5))
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epStanding
  p.sneaking = true
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epCrouching
  p.abilities.flying = true
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epStanding
  p.abilities.flying = false
  p.sleepingSince = 5'i32
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epSleeping
  p.sleepingSince = -1'i32
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epCrouching
  p.sneaking = false
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epStanding

proc roof() =
  # A roof two blocks over the feet (y=66): 1.8 fits in 2.0. A roof at y=65 leaves 1.0: standing and crouching (1.5) do
  # not fit, so a player that wants either is swum (0.6 high); `can_fit_pose` says which.
  let p = newTestPlayer(at(0.5, 64.0, 0.5))
  setRoof(66'i32, false)
  assert p.canFitPose(epStanding)
  assert p.canFitPose(epCrouching)
  setRoof(66'i32, true)
  setRoof(65'i32, false)
  assert not p.canFitPose(epStanding)
  assert not p.canFitPose(epCrouching)
  assert p.canFitPose(epSwimming)
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epSwimming
  p.sneaking = true
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epSwimming
  setRoof(65'i32, true)
  p.updatePlayerPose()
  assert playerBase(p).entity.pose == epCrouching

proc movement() =
  let p = newTestPlayer(at(0.5, 64.0, 0.5))
  p.onGround = true
  assert p.getMovementStatistic() == csWalkOneCm
  p.sprinting = true
  assert p.getMovementStatistic() == csSprintOneCm
  p.sneaking = true
  assert p.getMovementStatistic() == csCrouchOneCm
  p.sneaking = false
  p.sprinting = false
  p.onGround = false
  p.velocity = at(0.0, -0.5, 0.0)
  assert p.getMovementStatistic() == csFallOneCm
  p.velocity = at(0.0, -0.005, 0.0)
  assert p.getMovementStatistic() == csWalkOneCm
  p.fallFlying = true
  assert p.getMovementStatistic() == csAviateOneCm
  p.abilities.flying = true
  assert p.getMovementStatistic() == csFlyOneCm

proc experience() =
  # Vanilla's 2L+7 points a level up to 15: 7 for level 0, 9 for level 1, so 17 in all is level 2 and 1 point.
  let p = newTestPlayer(at(0.5, 64.0, 0.5))
  p.addExperiencePoints(7'i32)
  assert p.experienceLevel == 1'i32 and p.experiencePoints == 0'i32
  p.addExperiencePoints(10'i32)
  assert p.experienceLevel == 2'i32 and p.experiencePoints == 1'i32
  assert abs(p.experienceProgress - 1.0'f32 / 11.0'f32) < 1.0e-6'f32
  assert not p.setExperiencePoints(12'i32)       # level 2 holds 11
  assert p.setExperiencePoints(5'i32)
  assert abs(p.experienceProgress - 5.0'f32 / 11.0'f32) < 1.0e-6'f32
  p.addExperienceLevels(1'i32)                   # keep progress: 5 * 13 / 11 = 5.9
  assert p.experienceLevel == 3'i32 and p.experiencePoints == 5'i32
  p.addExperiencePoints(-100000'i32)             # never below nothing
  assert p.experienceLevel == 0'i32 and p.experiencePoints == 0'i32
  assert p.applyMendingFromXp(0'i32) == 0'i32 and p.applyMendingFromXp(-3'i32) == -3'i32

proc miningSpeed() =
  # get_mining_speed's arithmetic: haste 2 (amplifier 1) is x1.4, fatigue 0 x0.3, airborne /5.
  assert abs(playermod.miningSpeedFor(2.0'f32, none[uint32](), none[uint8](), true) - 2.0'f32) < 1.0e-6'f32
  assert abs(playermod.miningSpeedFor(2.0'f32, some(1'u32), none[uint8](), true) - 2.8'f32) < 1.0e-5'f32
  assert abs(playermod.miningSpeedFor(2.0'f32, none[uint32](), some(0'u8), true) - 0.6'f32) < 1.0e-6'f32
  assert abs(playermod.miningSpeedFor(1.0'f32, none[uint32](), some(2'u8), true) - 0.0027'f32) < 1.0e-7'f32
  assert abs(playermod.miningSpeedFor(1.0'f32, none[uint32](), some(9'u8), true) - 8.1e-4'f32) < 1.0e-7'f32
  assert abs(playermod.miningSpeedFor(5.0'f32, none[uint32](), none[uint8](), false) - 1.0'f32) < 1.0e-6'f32

proc smallCalls() =
  # tick_client_load_timeout: counts down from 5 and saturates, and a loaded client keeps its timeout.
  let p = newTestPlayer(at(0.5, 64.0, 0.5))
  for i in 0 ..< 7:
    p.tickClientLoadTimeout()
  assert p.clientLoadedTimeout == 0'u32 and p.hasClientLoaded()
  let q = newTestPlayer(at(0.5, 64.0, 0.5))
  q.setClientLoaded(true)
  q.tickClientLoadTimeout()
  assert q.clientLoadedTimeout == 5'u32
  # set_display_name / get_display_name: the override is what the entity reads; None goes back to the profile name.
  assert p.getDisplayNameOverride().isNone and p.getTabListName().isNone
  p.setDisplayName(some(text("Boss")))
  assert p.getDisplayNameOverride().isSome
  p.setDisplayName(none[TextComponent]())
  assert p.getDisplayNameOverride().isNone
  # get_item_use_ticks: 0 with nothing in use, else the maximum use time less what is left (an apple is 32).
  assert p.getItemUseTicks() == 0'i32
  let living = mustLiving(playerBase(p))
  living.setActiveHand(hRight, newItemStack(1'u8, ITEM_APPLE), 32'i32)
  assert p.getItemUseTicks() == 0'i32
  living.itemUseTime = 20'i32
  assert p.getItemUseTicks() == 12'i32
  p.stopUsingItem()
  assert p.getItemUseTicks() == 0'i32 and living.itemInUse.isNone

pose()
miningSpeed()
roof()
movement()
experience()
smallCalls()
echo "playerextras tests: all checks passed"
