# --- Experience ----------------------------------------------------------------------------------------

proc setExperience*(self: Player; level: int32; progress: float32; points: int32) =
  ## `set_experience`: the three values, then the client is told (upstream's `tick_experience` after resetting `last_sent_xp`
  ## and its own packet are one packet here).
  self.experienceLevel = level
  self.experienceProgress = clamp(progress, 0.0'f32, 1.0'f32)
  self.experiencePoints = points
  gLastSentXp[self.entityId] = level
  if self.hasClientLoaded():
    self.sendExperience()

proc setExperienceLevel*(self: Player; newLevel: int32; keepProgress: bool) =
  ## `set_experience_level`
  let progress = self.experienceProgress
  var points = self.experiencePoints
  if keepProgress:
    let currentMax = pointsInLevel(self.experienceLevel)
    let newMax = pointsInLevel(newLevel)
    let scale = float32(newMax) / float32(currentMax)
    points = int32(float32(points) * scale)
  self.setExperience(newLevel, progress, points)

proc addExperienceLevels*(self: Player; addedLevels: int32) =
  ## `add_experience_levels`
  self.setExperienceLevel(self.experienceLevel + addedLevels, true)

proc setExperiencePoints*(self: Player; newPoints: int32): bool =
  ## `set_experience_points`: false when the points do not fit the level.
  if newPoints == self.experiencePoints:
    return true
  let maxPoints = pointsInLevel(self.experienceLevel)
  if newPoints < 0'i32 or newPoints > maxPoints:
    return false
  self.setExperience(self.experienceLevel, float32(newPoints) / float32(maxPoints), newPoints)
  true

proc addExperiencePoints*(self: Player; addedPoints: int32) =
  ## `add_experience_points` (the `PlayerExpChangeEvent` is a plugin event, which is not ported).
  let totalExp = int64(pointsToLevel(self.experienceLevel)) + int64(self.experiencePoints)
  let newTotal = clamp(totalExp + int64(addedPoints), 0'i64, int64(high(int32)))
  let (newLevel, newPoints) = totalToLevelAndPoints(int32(newTotal))
  self.setExperience(newLevel, progressInLevel(newPoints, newLevel), newPoints)

proc applyMendingFromXp*(self: Player; xp0: int32): int32 =
  ## `apply_mending_from_xp`: one random mending item among the held ones and the armour takes the experience (two
  ## durability for each point); what it did not use is returned.
  var xp = xp0
  if xp <= 0'i32:
    return xp
  var candidates: seq[(int, EquipmentSlot)] = @[]
  let inv = Inventory(self.inventory)
  let selected = int(self.inventory.getSelectedSlot())
  var slots: seq[(int, EquipmentSlot)] = @[(selected, esMainHand), (OffHandSlot, esOffHand)]
  for entry in self.inventory.equipmentSlots:
    if entry.slot in {esHead, esChest, esLegs, esFeet}:
      slots.add((entry.index, entry.slot))
  for entry in slots:
    let stack = inv.getStack(entry[0])
    if stack.getEnchantmentLevel(EnchantmentRef(id: Enchantment.MENDING.id, name: "")) > 0'i32 and stack.getDamage() > 0'i32:
      candidates.add(entry)
  if candidates.len == 0:
    return xp
  let pick = min(int(randomF32() * float32(candidates.len)), candidates.len - 1)
  let (slotIndex, equipmentSlot) = candidates[pick]
  var stack = inv.getStack(slotIndex)
  let repaired = stack.repairItem(xp * 2'i32)
  if repaired <= 0'i32:
    return xp
  inv.setStack(slotIndex, stack)
  xp = xp - (repaired + 1'i32) div 2'i32
  self.client.writePacketFor(CSetPlayerInventory(slot: newVarInt(int32(slotIndex)), item: toSerializer(stack)))
  self.sendEquipmentChanges([(equipmentSlot, stack)])
  xp
