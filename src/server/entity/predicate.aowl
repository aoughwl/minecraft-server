## Port of pumpkin/src/entity/predicate/mod.rs
##
## Every test takes an `&Entity`, and upstream's `Entity` answers the `EntityBase` questions with the trait's defaults:
## `get_living_entity` and `get_player` are `None`, `is_spectator`, `is_collidable` and `can_hit` are false. So
## `ValidLivingEntity`, `ExceptCreativeOrSpectator`, `CanCollide` and `CanHit` are always false, and `ExceptSpectator`
## is always true. That is what upstream does, and it is kept: `MeleeAttackGoal::stop` depends on it.

import entitymod

type
  EntityPredicateKind* = enum
    epValidEntity, epValidLivingEntity, epNotMounted, epValidInventories, epExceptCreativeOrSpectator, epExceptSpectator,
    epCanCollide, epCanHit, epRides

  EntityPredicate* = object
    case kind*: EntityPredicateKind
    of epRides:
      rides*: Entity
    else:
      discard

proc testRides*(target, entity: Entity): bool =
  ## `EntityPredicate::Rides(target)`: false if `entity` rides `target`. Upstream's `ptr::eq` compares a vehicle's
  ## `dyn EntityBase` with the target's; the entities are compared here.
  var vehicle = entity.vehicle
  while vehicle != nil:
    if vehicle.entity == target:
      return false
    vehicle = vehicle.entity.vehicle
  true

proc test*(self: EntityPredicate; entity: Entity): bool =
  ## `test`
  case self.kind
  of epValidEntity: entity.isAlive()
  of epValidLivingEntity: false
  of epNotMounted: entity.isAlive() and not entity.hasPassengers() and not entity.hasVehicle()
  of epValidInventories: false # TODO upstream: implement
  of epExceptCreativeOrSpectator: false
  of epExceptSpectator: true
  of epCanCollide: false
  of epCanHit: false
  of epRides: testRides(self.rides, entity)
