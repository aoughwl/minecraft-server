## Port of pumpkin/src/entity/type.rs
## PARTIAL: pumpkin/src/entity/type.rs - only the projectile arms of `from_type`, which modules below this one cannot register themselves in entity/entitytype.aowl without a cycle; the rest of `from_type` is there.
##
## Importing this registers every projectile with `registerEntityFactory`, and fills mob/shulker.aowl's `gSpawnShulkerBullet`.

import ../entitytype
import ../mob/shulker
import arrow
import bobber_bullet
import thrown
import thrown_items

export arrow, bobber_bullet, thrown, thrown_items

proc registerProjectiles*() =
  ## `from_type`'s arms for a projectile. Each is the type's constructor with no owner, as a load from disk or `/summon`
  ## builds it.
  registerEntityFactory(EntityType.ENDER_PEARL, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newEnderPearlEntity(entity)
    e)
  registerEntityFactory(EntityType.SNOWBALL, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newSnowballEntity(entity)
    e)
  registerEntityFactory(EntityType.EGG, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newEggEntity(entity)
    e)
  registerEntityFactory(EntityType.FIREBALL, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newFireballEntity(entity)
    e)
  registerEntityFactory(EntityType.SMALL_FIREBALL, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newSmallFireballEntity(entity)
    e)
  registerEntityFactory(EntityType.WIND_CHARGE, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newWindChargeNormal(entity)
    e)
  registerEntityFactory(EntityType.BREEZE_WIND_CHARGE, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newWindChargeBreeze(entity)
    e)
  registerEntityFactory(EntityType.FIREWORK_ROCKET, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newFireworkRocketEntity(entity)
    e)
  registerEntityFactory(EntityType.SPLASH_POTION, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newSplashPotionEntity(entity)
    e)
  registerEntityFactory(EntityType.LINGERING_POTION, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newLingeringPotionEntity(entity)
    e)
  registerEntityFactory(EntityType.EYE_OF_ENDER, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newEyeOfEnder(entity)
    e)
  registerEntityFactory(EntityType.ARROW, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newArrowEntity(entity, none[int32]())
    e)
  registerEntityFactory(EntityType.SPECTRAL_ARROW, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newArrowEntity(entity, none[int32]())
    e)
  registerEntityFactory(EntityType.TRIDENT, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = newTridentEntity(entity, none[int32]())
    e)
  registerEntityFactory(EntityType.SHULKER_BULLET, proc(entity: Entity): EntityBase {.closure.} =
    let e: EntityBase = orphanShulkerBullet(entity)
    e)
  gSpawnShulkerBullet = proc(shulkerEntity: Entity; targetId: int32; targetPos: Vector3[float64]; axis: shulker.Axis) {.closure.} =
    let bullet: EntityBase = newShulkerBulletEntity(shulkerEntity, targetId, targetPos, uint8(ord(axis)))
    spawnEntity(shulkerEntity.world, bullet)

registerProjectiles()
