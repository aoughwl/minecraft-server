## entity/projectile: known answers worked from the Rust, for `process_tick`'s physics of each kind, the shot constructors,
## `set_velocity_from` with no divergence, the ray and face helpers, and the shulker bullet's axis steering. A void world.

import std/[assertions, math, options, syncio]
import ../../../data/block_ext
import ../entitytype
import ../mob/testworld
import projectilesmod

const Eps = 1.0e-9'f64

proc near(a, b: Vector3[float64]): bool =
  abs(a.x - b.x) < Eps and abs(a.y - b.y) < Eps and abs(a.z - b.z) < Eps

let server = newTestServer()
let testWorld = newTestWorld(server, "projectilestest")

proc shooterAt(x, y, z: float64): Entity = newEntity(testWorld, pos3(x, y, z), EntityType.ZOMBIE)

block is_projectile:
  assert isProjectile(EntityType.ARROW) and isProjectile(EntityType.SNOWBALL) and isProjectile(EntityType.FISHING_BOBBER)
  assert not isProjectile(EntityType.ZOMBIE) and not isProjectile(EntityType.ITEM)

block ray_intersection:
  let bb = newBoundingBox(pos3(0.0, 0.0, 2.0), pos3(1.0, 1.0, 3.0))
  let hit = calculateRayIntersection(pos3(0.5, 0.5, 0.0), pos3(0.0, 0.0, 4.0), bb)
  assert hit.isSome and hit.unsafeGet == 0.5'f64
  assert calculateRayIntersection(pos3(0.5, 0.5, 0.0), pos3(0.0, 0.0, 1.0), bb).isNone
  assert calculateRayIntersection(pos3(5.0, 0.5, 0.0), pos3(0.0, 0.0, 4.0), bb).isNone

block hit_face:
  let at = BlockPos(vec: Vector3[int32](x: 0'i32, y: 0'i32, z: 0'i32))
  assert getHitFace(pos3(0.0, 0.5, 0.5), at) == BlockDirection.West
  assert getHitFace(pos3(1.0, 0.5, 0.5), at) == BlockDirection.East
  assert getHitFace(pos3(0.5, 0.0, 0.5), at) == BlockDirection.Down
  assert getHitFace(pos3(0.5, 1.0, 0.5), at) == BlockDirection.Up
  assert getHitFace(pos3(0.5, 0.5, 0.0), at) == BlockDirection.North
  assert getHitFace(pos3(0.5, 0.5, 0.5), at) == BlockDirection.South

block thrown_shot_position:
  # Eye height less 0.1.
  let shooter = shooterAt(1.0, 64.0, 2.0)
  let ball = newSnowballShot(newEntity(testWorld, shooter.pos, EntityType.SNOWBALL), shooter)
  assert ball.ownerId == some(shooter.entityId)
  assert ball.entity.pos.y == 64.0'f64 + shooter.getEyeHeight() - 0.1'f64

block set_velocity_from_no_divergence:
  # Facing yaw 0, pitch 0 is +z. With no divergence the triangular noise is 0 and the result is the unit vector times speed.
  let shooter = shooterAt(0.0, 64.0, 0.0)
  let ball = newSnowballShot(newEntity(testWorld, shooter.pos, EntityType.SNOWBALL), shooter)
  ball.setVelocityFrom(shooter, 0.0'f32, 0.0'f32, 0.0'f32, 1.5'f32, 0.0'f32)
  assert near(ball.entity.velocity, pos3(0.0, 0.0, 1.5))

block snowball_tick:
  # velocity.y -= 0.03, then times 0.99; then position += velocity.
  let shooter = shooterAt(0.0, 64.0, 0.0)
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.SNOWBALL)
  let ball = newSnowballEntity(entity)
  entity.velocity = pos3(0.0, 0.0, 1.0)
  let caller: EntityBase = ball
  caller.tick(caller, server)
  assert near(entity.velocity, pos3(0.0, -0.03 * 0.99, 0.99))
  assert near(entity.pos, pos3(0.0, 64.0 - 0.03 * 0.99, 0.99))
  discard shooter

block arrow_constants_and_tick:
  # velocity.y -= 0.05, then times 0.99 in the air.
  let shooter = shooterAt(0.0, 64.0, 0.0)
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.ARROW)
  let shot = newArrowShot(entity, shooter, apAllowed)
  assert shot.baseDamage == 2.0'f64
  assert shot.ownerId == some(shooter.entityId)
  assert entity.pos.y == 64.0'f64 + float64(shooter.entityDimension.eyeHeight) - 0.1'f64
  shot.setVelocityFromRotation(0.0'f32, 0.0'f32, 0.0'f32, 3.0'f32, 0.0'f32)
  assert near(entity.velocity, pos3(0.0, 0.0, 3.0))
  let start = entity.pos
  let caller: EntityBase = shot
  caller.tick(caller, server)
  assert near(entity.velocity, pos3(0.0, -0.05 * 0.99, 3.0 * 0.99))
  assert near(entity.pos, start.add(pos3(0.0, -0.05 * 0.99, 3.0 * 0.99)))
  assert not shot.inGround

block arrow_despawns_after_1200_ground_ticks:
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.ARROW)
  let shot = newArrowEntity(entity, none[int32]())
  let base: EntityBase = shot
  spawnEntity(testWorld, base)
  shot.inGround = true
  shot.shakeTime = 7'u8
  for i in 0 ..< 1200:
    base.tick(base, server)
  # `life` was 0 .. 1199, none of them at DESPAWN_TIME.
  assert not isGone(entity)
  assert shot.life == 1200'u32 and shot.shakeTime == 0'u8
  base.tick(base, server)
  assert isGone(entity)

block arrow_pickup_bytes:
  assert arrowPickupFromByte(0'u8) == apDisallowed
  assert arrowPickupFromByte(1'u8) == apAllowed
  assert arrowPickupFromByte(2'u8) == apCreativeOnly
  assert arrowPickupFromByte(9'u8) == apDisallowed
  assert toByte(apCreativeOnly) == 2'u8

block trident_tick:
  # velocity.y -= 0.05, then times 0.99 in the air.
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.TRIDENT)
  let shot = newTridentEntity(entity, none[int32]())
  entity.velocity = pos3(1.0, 0.0, 0.0)
  let caller: EntityBase = shot
  caller.tick(caller, server)
  assert near(entity.velocity, pos3(0.99, -0.05 * 0.99, 0.0))

block shulker_bullet_axes:
  assert dirAxis(5'u8) == 0'u8 and dirAxis(4'u8) == 0'u8 # east, west
  assert dirAxis(0'u8) == 1'u8 and dirAxis(1'u8) == 1'u8 # down, up
  assert dirAxis(2'u8) == 2'u8 and dirAxis(3'u8) == 2'u8 # north, south
  assert dirAxis(255'u8) == 255'u8

block shulker_bullet_orphan_falls:
  # No target: velocity.y -= 0.04 each tick, no drag.
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.SHULKER_BULLET)
  let bullet = orphanShulkerBullet(entity)
  assert bullet.targetId == -1'i32
  let base: EntityBase = bullet
  base.tick(base, server)
  assert near(entity.velocity, pos3(0.0, -0.04, 0.0))
  assert near(entity.pos, pos3(0.0, 64.0 - 0.04, 0.0))
  assert bullet.bulletAge == 1'i32

block shulker_bullet_targets_axis:
  # The target is 10 east; a step along x is the only choice with the y and z axes equal, and steering is SPEED toward the
  # point one block along it.
  let owner = shooterAt(0.0, 64.0, 0.0)
  let target = pos3(10.0, 64.0, 0.0)
  let bullet = newShulkerBulletEntity(owner, 99'i32, target, 1'u8)
  assert bullet.ownerId == owner.entityId and bullet.targetId == 99'i32
  assert bullet.flightSteps >= 10'i32 and bullet.flightSteps <= 50'i32
  assert bullet.flightSteps mod 10'i32 == 0'i32
  assert dirAxis(bullet.currentDir) != 1'u8
  let delta = sqrt(bullet.targetDeltaX * bullet.targetDeltaX + bullet.targetDeltaY * bullet.targetDeltaY +
    bullet.targetDeltaZ * bullet.targetDeltaZ)
  assert abs(delta - 0.15'f64) < Eps

block shulker_bullet_burst_on_damage:
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.SHULKER_BULLET)
  let bullet = orphanShulkerBullet(entity)
  let base: EntityBase = bullet
  spawnEntity(testWorld, base)
  assert base.damage(base, 1.0'f32, damage_type.ARROW)
  assert bullet.hasHit and isGone(entity)
  # Double hits are guarded.
  assert not base.damage(base, 1.0'f32, damage_type.ARROW)

block bobber_tick:
  # Not in water: velocity.y -= 0.03, then times 0.92.
  let entity = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.FISHING_BOBBER)
  let base = projectileBase(FishingBobberEntity(vt: fishingBobberVt, entity: entity))
  entity.base = base
  entity.velocity = pos3(1.0, 0.0, 0.0)
  base.tick(base, server)
  assert near(entity.velocity, pos3(0.92, -0.03 * 0.92, 0.0))
  let bobber = FishingBobberEntity(base)
  assert not bobber.inGround

block factories_registered:
  let arrowFromType = fromType(EntityType.ARROW, pos3(0.0, 64.0, 0.0), testWorld, randomUuid())
  assert arrowFromType of ArrowEntity
  let pearl = fromType(EntityType.ENDER_PEARL, pos3(0.0, 64.0, 0.0), testWorld, randomUuid())
  assert pearl of EnderPearlEntity
  let bullet = fromType(EntityType.SHULKER_BULLET, pos3(0.0, 64.0, 0.0), testWorld, randomUuid())
  assert bullet of ShulkerBulletEntity

echo "projectiles ok"
