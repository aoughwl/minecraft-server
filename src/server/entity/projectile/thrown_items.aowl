proc setItemStack*(self: SplashPotionEntity; itemStack: ItemStack) = self.itemStack = itemStack

# --- LingeringPotionEntity --------------------------------------------------------------------------------------------------------

proc makeLingeringVt(): EntityVt =
  result = copyVt(thrownVt())
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let s = LingeringPotionEntity(self)
    initItemTracker(self, s.itemStack)
  result.onHit = proc(self: EntityBase; hit: ProjectileHit) {.closure.} =
    let s = LingeringPotionEntity(self)
    let world = s.entity.world
    let hitPos = hit.hitPos
    # Only extinguish fire for plain water potions
    let stack = s.itemStack
    extinguishFireIfWaterPotion(world, hitPos, stack)
    # Play impact particles
    world.sendEntityStatus(s.entity, esDeath)
    # Read stored item stack and compute potion effects
    let effects = readPotionEffects(stack)
    # If no effects, just splash (like water bottles)
    if effects.len == 0:
      return
    # Play splash/break particles & sound
    broadcastSplash(world, hitPos, stack, effects)
    # Spawn and configure an `AreaEffectCloud` entity
    let cloudEntity = fromUuid(randomUuid(), world, hitPos, EntityType.AREA_EFFECT_CLOUD)
    let cloud: EntityBase = createAreaEffectCloud(cloudEntity, stack, effects, 600'i32, 3.0'f32, 20'i32, 20'i32, -0.5'f32, -100'i32)
    spawnEntity(world, cloud)

let lingeringPotionVt* = makeLingeringVt()

proc newLingeringPotionEntity*(entity: Entity): LingeringPotionEntity =
  ## `LingeringPotionEntity::new`
  entity.setVelocity(Vector3[float64](x: 0.0, y: 0.1, z: 0.0))
  result = LingeringPotionEntity(vt: lingeringPotionVt, entity: entity, itemStack: newItemStack(1'u8, ITEM_LINGERING_POTION))
  initThrownFields(result, entity, PotionGravity, none[int32]())

