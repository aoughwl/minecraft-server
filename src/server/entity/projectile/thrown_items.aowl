  initThrownFields(result, entity, PotionGravity, owner)

proc setItemStack*(self: LingeringPotionEntity; itemStack: ItemStack) = self.itemStack = itemStack

# --- EyeOfEnder ---------------------------------------------------------------------------------------------------------------------

proc computeNewVelocity*(oldVelo, position, target: Vector3[float64]): Vector3[float64] =
  ## `compute_new_velocity`: mirrors the vanilla `updateDeltaMovement` logic.
  let horizontalDelta = Vector3[float64](x: target.x - position.x, y: 0.0, z: target.z - position.z)
  let horizontalLen = hypot(horizontalDelta.x, horizontalDelta.z)
  let oldHSpeed = hypot(oldVelo.x, oldVelo.z)
  # `lerp(0.0025, old_h_speed, horizontal_len)`
  var wantedSpeed = oldHSpeed + 0.0025'f64 * (horizontalLen - oldHSpeed)
  var moveY = oldVelo.y
  if horizontalLen < 1.0'f64:
    wantedSpeed *= 0.8'f64
    moveY *= 0.8'f64
  let wantedYDir = if position.y - oldVelo.y < target.y: 1.0'f64 else: -1.0'f64
  let scale = wantedSpeed / horizontalLen
  Vector3[float64](x: horizontalDelta.x * scale, y: moveY + (wantedYDir - moveY) * 0.015'f64, z: horizontalDelta.z * scale)

proc signalTo*(self: EyeOfEnder; target: Vector3[float64]) =
  ## `signal_to`: aim the eye at `target`, clamping to `TooFarDistance` if necessary, and randomly decide whether it should
  ## drop its item on expiry.
  let pos = self.entity.pos
  let delta = target.sub(pos)
  let horizontalDist = hypot(delta.x, delta.z)
  let clampedTarget = if horizontalDist > TooFarDistance:
      Vector3[float64](x: pos.x + delta.x / horizontalDist * TooFarDistance, y: pos.y + TooFarSignalHeight,
        z: pos.z + delta.z / horizontalDist * TooFarDistance)
    else:
      target
  self.target = some(clampedTarget)
  self.life = 0'u32
  # 4-in-5 chance to survive (drop item); 1-in-5 plays the break effect.
  self.surviveAfterDeath = (uint32(randomRange(0'i32, high(int32))) mod SurviveChance) != 0'u32

proc makeEyeVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let s = EyeOfEnder(self)
    let entity = s.entity
    entityTick(entity, caller, server)
    # Advance position by current velocity.
    let velocity = entity.velocity
    let newPos = entity.pos.add(velocity)
    # Server-side: steer toward target if one is set.
    if s.target.isSome:
      entity.velocity = computeNewVelocity(velocity, newPos, s.target.unsafeGet)
    entity.setPos(newPos)
    entity.sendPosRot()
    # Tick lifetime and handle expiry.
    s.life += 1'u32
    if s.life > MaxLife:
      entity.playSound(sdEntityEnderEyeDeath)
      entity.remove()
      if s.surviveAfterDeath:
        # Drop the item at the current position.
        let dropped = newEntity(entity.world, newPos, EntityType.ITEM)
        let item: EntityBase = newItemEntity(dropped, s.itemStack)
        spawnEntity(entity.world, item)
      else:
        let blockPos = newPos.toBlockPos()
        entity.world.broadcastToChunk(blockPos.chunkPosition(), CWorldEvent(event: int32(ord(weParticlesEyeOfEnderDeath)),
          location: blockPos, data: 0'i32, disableRelativeVolume: false))
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let s = EyeOfEnder(self)
    s.entity.sendMetaData(TrackedData_ITEM, ITEM_STACK, toSerializer(s.itemStack))
  # Eye of Ender is not attackable.
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} = false
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} = discard
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} = discard

let eyeOfEnderVt* = makeEyeVt()

proc newEyeOfEnder*(entity: Entity): EyeOfEnder =
  ## `EyeOfEnder::new`
  result = EyeOfEnder(vt: eyeOfEnderVt, entity: entity, itemStack: newItemStack(1'u8, ITEM_ENDER_EYE),
    target: none[Vector3[float64]](), life: 0'u32, surviveAfterDeath: false)
  entity.base = projectileBase(result)
