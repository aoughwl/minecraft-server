## Port of pumpkin/src/entity/projectile_deflection.rs

import entitymod

type
  ProjectileDeflectionType* = enum
    pdNone, pdSimple, pdRedirected, pdTransferVelocityDirection

proc deflect*(self: ProjectileDeflectionType; projectile: EntityBase; hitEntity: nil EntityBase) =
  ## `deflect`
  case self
  of pdNone:
    discard
  of pdSimple:
    let vel = mulAdd(randomF32(), 20.0'f32, 170.0'f32)
    let entity = projectile.entity
    entity.velocity = entity.velocity.multiply(-0.5'f64, -0.5'f64, -0.5'f64)
    entity.setRotation(entity.yaw + vel, entity.pitch)
    # TODO upstream: Add entity.lastYaw += vel
    entity.velocityDirty = true
  of pdRedirected:
    if hitEntity != nil:
      let entity = projectile.entity
      entity.velocity = hitEntity.entity.rotation().toF64()
      entity.velocityDirty = true
  of pdTransferVelocityDirection:
    if hitEntity != nil:
      let entity = projectile.entity
      entity.velocity = hitEntity.entity.velocity.normalize()
      entity.velocityDirty = true
