## `World::raycast` from pumpkin/src/world/mod.rs, with `ray_outline_check` and `intersects_aabb_with_direction`.
## It sits here, on top of entitymod.aowl, since what asks for it is entity code; worldmod.aowl has no raycast yet.

import std/[math, options]
from ../../data/block_state import BlockState
import ../../data/block_ext
import entitymod

proc intersectsAabbWithDirection*(fromPos, to, lo, hi: Vector3[float64]): Option[BlockDirection] =
  ## `intersects_aabb_with_direction`
  let dir = to.sub(fromPos)
  var tmin = 0.0'f64
  var tmax = 1.0'f64
  var hitAxis = -1
  var hitIsMin = false
  for axis in 0 .. 2:
    let dirA = if axis == 0: dir.x elif axis == 1: dir.y else: dir.z
    let fromA = if axis == 0: fromPos.x elif axis == 1: fromPos.y else: fromPos.z
    let minA = if axis == 0: lo.x elif axis == 1: lo.y else: lo.z
    let maxA = if axis == 0: hi.x elif axis == 1: hi.y else: hi.z
    if abs(dirA) < 1e-8'f64:
      if fromA < minA or fromA > maxA:
        return none[BlockDirection]()
    else:
      let invD = 1.0'f64 / dirA
      let tNear = (minA - fromA) * invD
      let tFar = (maxA - fromA) * invD
      # Determine entry and exit points based on ray direction
      let tEntry = if invD >= 0.0'f64: tNear else: tFar
      let tExit = if invD >= 0.0'f64: tFar else: tNear
      if tEntry > tmin:
        tmin = tEntry
        hitAxis = axis
        hitIsMin = invD >= 0.0'f64
      tmax = min(tmax, tExit)
      if tmax < tmin:
        return none[BlockDirection]()
  case hitAxis
  of 0: some(if hitIsMin: BlockDirection.West else: BlockDirection.East)
  of 1: some(if hitIsMin: BlockDirection.Down else: BlockDirection.Up)
  of 2: some(if hitIsMin: BlockDirection.North else: BlockDirection.South)
  else: none[BlockDirection]()

proc rayOutlineCheck(world: World; blockPos: BlockPos; fromPos, to: Vector3[float64]): (bool, Option[BlockDirection]) =
  ## `ray_outline_check`
  let state = BlockState.fromId(world.stateIdAt(blockPos))
  if state.outlineShapes.len == 0:
    return (true, none[BlockDirection]())
  for shape in state.getBlockOutlineShapes():
    let box = shape.atPos(blockPos)
    let direction = intersectsAabbWithDirection(fromPos, to, box.min, box.max)
    if direction.isSome:
      return (true, direction)
  (false, none[BlockDirection]())

proc raycast*(world: World; startPos, endPos: Vector3[float64];
    hitCheck: proc(blockPos: BlockPos; w: World): bool {.closure.}): Option[(BlockPos, BlockDirection)] =
  ## `raycast`
  if startPos == endPos:
    return none[(BlockPos, BlockDirection)]()
  let adjust = -1.0e-7'f64
  let to = lerp(endPos, startPos, adjust)
  let fromPos = lerp(startPos, endPos, adjust)
  var blockPos = floored(fromPos.x, fromPos.y, fromPos.z)
  let (firstCollision, firstDirection) = rayOutlineCheck(world, blockPos, fromPos, to)
  if firstDirection.isSome and firstCollision:
    return some((blockPos, firstDirection.unsafeGet))
  let difference = to.sub(fromPos)
  let step = difference.sign()
  let fmax = 1.7976931348623157e308'f64
  let delta = Vector3[float64](
    x: if step.x == 0'i32: fmax else: float64(step.x) / difference.x,
    y: if step.y == 0'i32: fmax else: float64(step.y) / difference.y,
    z: if step.z == 0'i32: fmax else: float64(step.z) / difference.z)
  var next = Vector3[float64](
    x: delta.x * (if step.x > 0'i32: 1.0'f64 - (fromPos.x - floor(fromPos.x)) else: fromPos.x - floor(fromPos.x)),
    y: delta.y * (if step.y > 0'i32: 1.0'f64 - (fromPos.y - floor(fromPos.y)) else: fromPos.y - floor(fromPos.y)),
    z: delta.z * (if step.z > 0'i32: 1.0'f64 - (fromPos.z - floor(fromPos.z)) else: fromPos.z - floor(fromPos.z)))
  while next.x <= 1.0'f64 or next.y <= 1.0'f64 or next.z <= 1.0'f64:
    var blockDirection: BlockDirection
    if next.x < next.y and next.x < next.z:
      blockPos.vec.x += step.x
      next.x += delta.x
      blockDirection = if step.x > 0'i32: BlockDirection.West else: BlockDirection.East
    elif next.y < next.z:
      blockPos.vec.y += step.y
      next.y += delta.y
      blockDirection = if step.y > 0'i32: BlockDirection.Down else: BlockDirection.Up
    else:
      blockPos.vec.z += step.z
      next.z += delta.z
      blockDirection = if step.z > 0'i32: BlockDirection.North else: BlockDirection.South
    if hitCheck(blockPos, world):
      let (collision, direction) = rayOutlineCheck(world, blockPos, fromPos, to)
      if collision:
        if direction.isSome:
          return some((blockPos, direction.unsafeGet))
        return some((blockPos, blockDirection))
  none[(BlockPos, BlockDirection)]()
