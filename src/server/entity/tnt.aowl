## Port of pumpkin/src/entity/tnt.rs
##
## This replaces a port of a later upstream's tnt.rs. The pinned one has no `primed`, no `random_short_fuse` and no NBT.

import std/math
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../generated/[meta_data_type, tracked_data]
import ../../protocol/java/client/play/entity_metadata
import ../../protocol/netcodec
import ../world/chunker
import ../world/explosion
import entitymod

type
  TNTEntity* = ref object of EntityBase
    power*: float32
    fuse*: uint32

proc makeVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let s = TNTEntity(self)
    let entity = s.entity
    var velo = entity.velocity
    velo.y -= self.getGravity()
    entity.moveEntity(caller, velo)
    discard entity.tickBlockCollisions(caller, server)
    if entity.onGround:
      entity.velocity = velo.multiply(0.7'f64, -0.5'f64, 0.7'f64)
    else:
      entity.velocity = velo.multiply(0.98'f64, 0.98'f64, 0.98'f64)
    let dirty = entity.velocityDirty
    entity.velocityDirty = false
    if dirty:
      entity.sendPosRot()
      entity.sendVelocity()
    # FIX upstream: Prevent fuse underflow (vanilla parity)
    let fuse = s.fuse
    if fuse <= 1'u32:
      # TNT explodes now
      entity.remove()
      explode(entity.world, entity.pos, s.power)
    else:
      # Safe decrement
      s.fuse = fuse - 1'u32
      entity.updateFluidState(caller)
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let s = TNTEntity(self)
    let entity = s.entity
    let pos = randomF64() * TAU
    entity.setVelocity(Vector3[float64](x: -sin(pos) * 0.02'f64, y: 0.2'f64, z: -cos(pos) * 0.02'f64))
    entity.sendMetaData2(TrackedData_FUSE_ID, INTEGER, newVarInt(int32(s.fuse)), TrackedData_BLOCK_STATE_ID, BLOCK_STATE,
      newVarInt(int32(asU16(blockTnt().defaultState.id))))
  result.getGravity = proc(self: EntityBase): float64 {.closure.} = 0.04'f64
  result.isImmuneToExplosion = proc(self: EntityBase): bool {.closure.} = true
  result.writeNbt = proc(self: EntityBase; nbt: var NbtCompound) {.closure.} = discard
  result.readNbt = proc(self: EntityBase; nbt: NbtCompound) {.closure.} = discard

let tntVt* = makeVt()

proc newTNTEntity*(entity: Entity; power: float32; fuse: uint32): TNTEntity =
  ## `TNTEntity::new`
  result = TNTEntity(vt: tntVt, entity: entity, power: power, fuse: fuse)
  entity.base = result
