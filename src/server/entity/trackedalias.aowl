## Entity data ids and types that are one thing under two names in the generated tables.
##
## The tables in src/generated are keyed by the names of the version they were extracted from: a field that 26.x calls
## `DATA_BABY_ID` is `BABY` up to 1.21.11, and each name is 255 (or -1 for a type) in the other's versions. A packet built
## with one name alone is silently dropped for the other protocol (`Metadata.write` skips an id of 255 and a type of -1).
## Each alias here joins both names per version, so one constant is right for every version. A value that 1.21.11 has at a
## different index than the flat name table says is listed in `override774`.

import ../../generated/[meta_data_type, tracked_data]

proc either*(a, b: TrackedId): TrackedId =
  ## Field by field `a`, or `b` where `a` has no id for that version.
  proc pick(x, y: uint8): uint8 =
    if x != 255'u8: x else: y
  TrackedId(v1_21: pick(a.v1_21, b.v1_21), v1_21_2: pick(a.v1_21_2, b.v1_21_2), v1_21_4: pick(a.v1_21_4, b.v1_21_4),
    v1_21_5: pick(a.v1_21_5, b.v1_21_5), v1_21_6: pick(a.v1_21_6, b.v1_21_6), v1_21_7: pick(a.v1_21_7, b.v1_21_7),
    v1_21_9: pick(a.v1_21_9, b.v1_21_9), v1_21_11: pick(a.v1_21_11, b.v1_21_11), v26_1: pick(a.v26_1, b.v26_1),
    v26_2: pick(a.v26_2, b.v26_2))

proc eitherType*(a, b: MetaDataType): MetaDataType =
  ## Field by field `a`, or `b` where `a` has no type id (-1) for that version.
  proc pick(x, y: int32): int32 =
    if x >= 0'i32: x else: y
  MetaDataType(v1_21: pick(a.v1_21, b.v1_21), v1_21_2: pick(a.v1_21_2, b.v1_21_2), v1_21_4: pick(a.v1_21_4, b.v1_21_4),
    v1_21_5: pick(a.v1_21_5, b.v1_21_5), v1_21_6: pick(a.v1_21_6, b.v1_21_6), v1_21_7: pick(a.v1_21_7, b.v1_21_7),
    v1_21_9: pick(a.v1_21_9, b.v1_21_9), v1_21_11: pick(a.v1_21_11, b.v1_21_11), v26_1: pick(a.v26_1, b.v26_1),
    v26_2: pick(a.v26_2, b.v26_2))

proc override774(a: TrackedId; id: uint8): TrackedId =
  ## `a` with the 1.21.11 (protocol 774) index replaced; every other version keeps its own.
  result = a
  result.v1_21_11 = id

let
  TD_INT* = eitherType(INTEGER, INT)          ## VarInt: `INTEGER` to 1.21.11, `INT` from 26.1.
  TD_AIR* = either(TrackedData_AIR, TrackedData_AIR_SUPPLY_ID)
  TD_BABY* = either(TrackedData_BABY, TrackedData_BABY_ID)
  TD_HEALTH* = either(TrackedData_HEALTH, TrackedData_HEALTH_ID)
  TD_MOB_FLAGS* = either(TrackedData_MOB_FLAGS, TrackedData_MOB_FLAGS_ID)
  TD_FROZEN_TICKS* = either(TrackedData_FROZEN_TICKS, TrackedData_TICKS_FROZEN)
  TD_SLEEPING_POS* = either(TrackedData_SLEEPING_POSITION, TrackedData_SLEEPING_POS_ID)
  TD_SHEEP_WOOL* = either(TrackedData_COLOR, TrackedData_WOOL_ID)  ## sheep: byte at 18
  TD_TNT_FUSE* = either(TrackedData_FUSE, TrackedData_FUSE_ID)
  TD_TNT_BLOCK_STATE* = either(TrackedData_BLOCK_STATE, TrackedData_BLOCK_STATE_ID)
  TD_CREEPER_SWELL* = either(TrackedData_FUSE_SPEED, TrackedData_SWELL_DIR)
  TD_CREEPER_IGNITED* = either(TrackedData_IGNITED, TrackedData_IS_IGNITED)
  TD_HURT* = either(TrackedData_DAMAGE_WOBBLE_TICKS, TrackedData_ID_HURT)
  TD_HURT_DIR* = either(TrackedData_DAMAGE_WOBBLE_SIDE, TrackedData_ID_HURTDIR)
  TD_DAMAGE* = either(TrackedData_DAMAGE_WOBBLE_STRENGTH, TrackedData_ID_DAMAGE)
  TD_PADDLE_LEFT* = either(TrackedData_LEFT_PADDLE_MOVING, TrackedData_ID_PADDLE_LEFT)
  TD_PADDLE_RIGHT* = either(TrackedData_RIGHT_PADDLE_MOVING, TrackedData_ID_PADDLE_RIGHT)
  TD_BEGGING* = either(TrackedData_BEGGING, TrackedData_INTERESTED_ID)
  TD_SCREAMING* = either(TrackedData_SCREAMING, TrackedData_CREEPY)
  TD_PROVOKED* = either(TrackedData_PROVOKED, TrackedData_STARED_AT)
  TD_CARRIED_BLOCK* = either(TrackedData_CARRIED_BLOCK, TrackedData_CARRY_STATE)
  TD_PEEK* = either(TrackedData_PEEK_AMOUNT, TrackedData_PEEK_ID)
  TD_ATTACH_FACE* = either(TrackedData_ATTACHED_FACE, TrackedData_ATTACH_FACE_ID)
  TD_FALLING_START_POS* = either(TrackedData_BLOCK_POS, TrackedData_START_POS)
  TD_HOOKED_ENTITY* = either(TrackedData_HOOK_ENTITY_ID, TrackedData_HOOKED_ENTITY)
  TD_ATTACHED_TO_TARGET* = either(TrackedData_SHOOTER_ENTITY_ID, TrackedData_ATTACHED_TO_TARGET)
  # 1.21.11 indexes the flat name table gets wrong (name collisions: VARIANT/VILLAGER_DATA are one name for several
  # entities). Vanilla 1.21.11: Animal baby 16, so chicken and frog variant 17; Villager data 18 (the 20 is the zombie
  # villager's); Wolf variant 22 (collar 20, anger 21, variant 22, sound variant 23).
  TD_CHICKEN_VARIANT* = override774(TrackedData_VARIANT, 17'u8)
  TD_FROG_VARIANT* = override774(TrackedData_VARIANT, 17'u8)
  TD_VILLAGER_DATA* = override774(TrackedData_VILLAGER_DATA, 18'u8)
  TD_WOLF_VARIANT* = override774(TrackedData_WOLF_VARIANT_ID, 22'u8)
