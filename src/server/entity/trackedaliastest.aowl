{.feature: "untyped".}
## Test for trackedalias.aowl: the entity data a 1.21.11 (774) client has at the indexes and types vanilla 1.21.11 gives them.
## Known answers: vanilla Entity 0-7 (flags, air, name, name visible, silent, no gravity, pose, frozen ticks), LivingEntity 8-14
## (flags, health, particles, ambient, arrows, stingers, sleeping pos), Mob 15, AgeableMob 16, Sheep 18, ArmorStand 15-21.
import std/syncio
import ../../protocol/varint, ../../protocol/protobase, ../../protocol/netcodec
import ../../protocol/java/client/play/entity_metadata
import ../../generated/[meta_data_type, tracked_data]
import ../../util/javaversion
import trackedalias

const V = jmvV1_21_11

var failed = false

proc eqi(got, want: int; what: string) =
  if got != want:
    echo "FAIL ", what, ": got ", got, ", want ", want
    failed = true

proc id774(t: TrackedId): int = int(t.get(V))
proc id262(t: TrackedId): int = int(t.get(jmvV26_2))

proc encoded(m: Metadata; v: JavaMinecraftVersion): seq[byte] =
  var w = newNetWriter()
  if not m.write(w, v).isOk:
    echo "FAIL metadata write"
    quit(1)
  w.buf

proc hexOfBytes(b: seq[byte]): string =
  const digits = "0123456789abcdef"
  result = ""
  for x in b:
    result.add digits[int(x shr 4)]
    result.add digits[int(x and 15)]

proc eqHex(got: seq[byte]; want, what: string) =
  if hexOfBytes(got) != want:
    echo "FAIL ", what, ": got ", hexOfBytes(got), ", want ", want
    failed = true

# Indexes at 774 (the 255 the 26.x names have there is what dropped these packets).
eqi(id774(TD_BABY), 16, "baby")
eqi(id774(TD_AIR), 1, "air")
eqi(id774(TD_HEALTH), 9, "health")
eqi(id774(TD_MOB_FLAGS), 15, "mob flags")
eqi(id774(TD_FROZEN_TICKS), 7, "frozen ticks")
eqi(id774(TD_SLEEPING_POS), 14, "sleeping position")
eqi(id774(TD_SHEEP_WOOL), 18, "sheep wool")
eqi(id774(TD_TNT_FUSE), 8, "tnt fuse")
eqi(id774(TD_TNT_BLOCK_STATE), 9, "tnt block state")
eqi(id774(TD_CREEPER_SWELL), 16, "creeper swell")
eqi(id774(TD_CREEPER_IGNITED), 18, "creeper ignited")
eqi(id774(TD_HURT), 8, "vehicle hurt")
eqi(id774(TD_HURT_DIR), 9, "vehicle hurt direction")
eqi(id774(TD_DAMAGE), 10, "vehicle damage")
eqi(id774(TD_PADDLE_LEFT), 11, "boat left paddle")
eqi(id774(TD_PADDLE_RIGHT), 12, "boat right paddle")
eqi(id774(TD_BEGGING), 19, "wolf begging")
eqi(id774(TD_SCREAMING), 17, "enderman screaming")
eqi(id774(TD_PROVOKED), 18, "enderman provoked")
eqi(id774(TD_CARRIED_BLOCK), 16, "enderman carried block")
eqi(id774(TD_PEEK), 17, "shulker peek")
eqi(id774(TD_ATTACH_FACE), 16, "shulker attach face")
eqi(id774(TD_FALLING_START_POS), 8, "falling block start pos")
eqi(id774(TD_HOOKED_ENTITY), 8, "fishing hook")
eqi(id774(TD_ATTACHED_TO_TARGET), 9, "firework attached")
eqi(id774(TD_CHICKEN_VARIANT), 17, "chicken variant")
eqi(id774(TD_FROG_VARIANT), 17, "frog variant")
eqi(id774(TD_VILLAGER_DATA), 18, "villager data")
eqi(id774(TD_WOLF_VARIANT), 22, "wolf variant")
eqi(id774(TrackedData_PLAYER_MODE_CUSTOMIZATION_ID), 16, "player skin parts")
eqi(id774(TrackedData_MAIN_ARM_ID), 15, "player main arm")
eqi(id774(TrackedData_ARMOR_STAND_FLAGS), 15, "armor stand flags")
eqi(id774(TrackedData_TRACKER_RIGHT_LEG_ROTATION), 21, "armor stand right leg")

# 26.x keeps what it had.
eqi(id262(TD_BABY), 16, "26.2 baby")
eqi(id262(TD_AIR), 1, "26.2 air")
eqi(id262(TD_HEALTH), 9, "26.2 health")
eqi(id262(TD_SHEEP_WOOL), 18, "26.2 sheep wool")
eqi(id262(TD_WOLF_VARIANT), 23, "26.2 wolf variant")

# The varint serializer: INTEGER up to 1.21.11, INT from 26.1.
eqi(int(TD_INT.id(V)), 1, "varint type at 774")
eqi(int(TD_INT.id(jmvV26_2)), 1, "varint type at 26.2")

# Exact bytes: index, serializer id, value.
eqHex(encoded(newMetadata(TD_BABY, BOOLEAN, true), V), "100801", "baby true")
eqHex(encoded(newMetadata(TD_HEALTH, FLOAT, 5.0'f32), V), "0903" & "40a00000", "health 5.0")
eqHex(encoded(newMetadata(TD_AIR, TD_INT, newVarInt(300'i32)), V), "0101ac02", "air 300")
eqHex(encoded(newMetadata(TD_SHEEP_WOOL, BYTE, 5'u8), V), "120005", "sheep colour 5")
eqHex(encoded(newMetadata(TD_MOB_FLAGS, BYTE, 1'u8), V), "0f0001", "no AI")
eqHex(encoded(newMetadata(TrackedData_MAIN_ARM_ID, ARM, 1'u8), V), "0f2601", "main arm right, the 774 ARM serializer 38")

if failed:
  quit(1)
echo "trackedalias OK"
