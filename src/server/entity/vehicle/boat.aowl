## Port of pumpkin/src/entity/vehicle/boat.rs

import std/options
import "../../../data/item_stack/mod"
import ../../../generated/[tracked_data, meta_data_type]
import ../entitymod
import vehicle

type
  BoatEntity* = ref object of EntityBase
    vehicle*: VehicleEntity
    ticksUnderwater*: float32
    leftPaddleMoving*: bool
    rightPaddleMoving*: bool

proc setPaddles*(self: BoatEntity; left, right: bool) =
  self.leftPaddleMoving = left
  self.rightPaddleMoving = right
  self.vehicle.entity.sendMetaData(TrackedData_ID_PADDLE_LEFT, BOOLEAN, left)
  self.vehicle.entity.sendMetaData(TrackedData_ID_PADDLE_RIGHT, BOOLEAN, right)

proc sendWobbleMetadata(self: BoatEntity) =
  self.vehicle.sendWobbleMetadata()

proc makeBoatVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let boat = BoatEntity(self)
    boat.vehicle.tick()
    let underwater = boat.ticksUnderwater
    if boat.vehicle.entity.touchingWater:
      boat.ticksUnderwater = min(underwater + 1.0'f32, 60.0'f32)
    elif underwater > 0.0'f32:
      boat.ticksUnderwater = max(underwater - 1.0'f32, 0.0'f32)
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let boat = BoatEntity(self)
    boat.sendWobbleMetadata()
  result.canHit = proc(self: EntityBase): bool {.closure.} =
    self.entity.isAlive()
  result.isCollidable = proc(self: EntityBase; entity: nil EntityBase): bool {.closure.} = true
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    let boat = BoatEntity(self)
    boat.vehicle.damageWithContext(amount, source)
  result.interact = proc(self: EntityBase; player: Player; itemStack: var ItemStack): bool {.closure.} =
    let boat = BoatEntity(self)
    let playerEntity = playerBase(player).entity
    if playerEntity.isSneaking():
      return false
    if boat.ticksUnderwater >= 60.0'f32:
      return false
    if boat.vehicle.entity.passengers.len >= 2:
      return false
    if playerEntity.hasVehicle():
      return false
    let world = boat.vehicle.entity.world
    let vehicle0 = getEntityById(world, boat.vehicle.entity.entityId)
    if vehicle0 == nil:
      return false
    let passenger = getPlayerById(world, player.entityId)
    if passenger == nil:
      return false
    boat.vehicle.entity.addPassenger(vehicle0, playerBase(passenger))
    true
  result.setPaddleState = proc(self: EntityBase; left, right: bool) {.closure.} =
    let boat = BoatEntity(self)
    boat.setPaddles(left, right)
  result.isPushable = proc(self: EntityBase): bool {.closure.} = true

let boatVt = makeBoatVt()

proc newBoatEntity*(entity: Entity): BoatEntity =
  result = BoatEntity(vehicle: newVehicleEntity(entity), ticksUnderwater: 0.0'f32, leftPaddleMoving: false,
    rightPaddleMoving: false)
  result.initEntityBase(entity, boatVt)
