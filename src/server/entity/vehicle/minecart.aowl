## Port of pumpkin/src/entity/vehicle/minecart.rs

import std/[math, options]
import "../../../data/item_stack/mod"
import ../../../data/block_ext
import ../../../generated/[particle, sound, sound_category]
from ../../../data/block_state import newBlockStateIdUnchecked
import ../../../protocol/java/server/play/player_input
import ../../world/explosion
import ../entitymod
import vehicle

type
  MinecartEntity* = ref object of EntityBase
    vehicle*: VehicleEntity
    active*: bool
    tntFuse*: int32

proc v3(x, y, z: float64): Vector3[float64] {.inline.} =
  Vector3[float64](x: x, y: y, z: z)

proc getExits*(shape: RailShape): (Vector3[float64], Vector3[float64]) =
  case shape
  of RailShape.NorthSouth: (v3(0.0, 0.0, -1.0), v3(0.0, 0.0, 1.0))
  of RailShape.EastWest: (v3(-1.0, 0.0, 0.0), v3(1.0, 0.0, 0.0))
  of RailShape.AscendingEast: (v3(-1.0, 0.0, 0.0), v3(1.0, 1.0, 0.0))
  of RailShape.AscendingWest: (v3(1.0, 0.0, 0.0), v3(-1.0, 1.0, 0.0))
  of RailShape.AscendingNorth: (v3(0.0, 0.0, 1.0), v3(0.0, 1.0, -1.0))
  of RailShape.AscendingSouth: (v3(0.0, 0.0, -1.0), v3(0.0, 1.0, 1.0))
  of RailShape.SouthEast: (v3(0.0, 0.0, 1.0), v3(1.0, 0.0, 0.0))
  of RailShape.SouthWest: (v3(0.0, 0.0, 1.0), v3(-1.0, 0.0, 0.0))
  of RailShape.NorthWest: (v3(0.0, 0.0, -1.0), v3(-1.0, 0.0, 0.0))
  of RailShape.NorthEast: (v3(0.0, 0.0, -1.0), v3(1.0, 0.0, 0.0))

proc straightToRailShape(shape: RailShapeStraight): RailShape =
  case shape
  of RailShapeStraight.NorthSouth: RailShape.NorthSouth
  of RailShapeStraight.EastWest: RailShape.EastWest
  of RailShapeStraight.AscendingEast: RailShape.AscendingEast
  of RailShapeStraight.AscendingWest: RailShape.AscendingWest
  of RailShapeStraight.AscendingNorth: RailShape.AscendingNorth
  of RailShapeStraight.AscendingSouth: RailShape.AscendingSouth

proc isRail(block0: Block): bool =
  block0.name == "rail" or block0.name == "powered_rail" or block0.name == "detector_rail" or
    block0.name == "activator_rail"

proc minecartTick(self: MinecartEntity; caller: EntityBase) =
  self.vehicle.tick()

  let entity = self.vehicle.entity
  let world = entity.world
  let pos = entity.pos
  var blockPos = newBlockPos(int32(floor(pos.x)), int32(floor(pos.y)), int32(floor(pos.z)))

  var block0 = world.getBlock(blockPos)
  var stateId = world.getBlockStateId(blockPos)

  var isPoweredRail = block0.name == "powered_rail"
  var isActivatorRail = block0.name == "activator_rail"
  var isOnRails = isPoweredRail or isActivatorRail or block0.name == "rail" or block0.name == "detector_rail"

  # If not on rails at current Y level, check the block directly below
  if not isOnRails:
    let belowBlockPos = newBlockPos(blockPos.x, blockPos.y - 1'i32, blockPos.z)
    let belowBlock = world.getBlock(belowBlockPos)
    if isRail(belowBlock):
      blockPos = belowBlockPos
      block0 = belowBlock
      stateId = world.getBlockStateId(blockPos)
      isPoweredRail = block0.name == "powered_rail"
      isActivatorRail = block0.name == "activator_rail"
      isOnRails = true

  if isPoweredRail or isActivatorRail:
    let props = fromStateId(PoweredRailLikeProperties, newBlockStateIdUnchecked(uint16(stateId)), block0)
    let powered = props.powered

    self.active = powered

    if powered:
      if isPoweredRail:
        var velocity = entity.velocity
        let speed = velocity.length()
        if speed > 0.01:
          let newSpeed = min(speed + 0.06, 0.4)
          velocity = velocity.normalize().multiply(newSpeed, newSpeed, newSpeed)
          entity.velocity = velocity
        else:
          let yaw = entity.yaw
          let pushDir = v3(-float64(sinF32(toRadiansF32(yaw))), 0.0, float64(cosF32(toRadiansF32(yaw))))
          entity.velocity = pushDir.multiply(0.1, 0.1, 0.1)
        entity.sendVelocity()
      elif isActivatorRail:
        let passengers = entity.passengers
        for passenger in passengers:
          let passengerId = passenger.entity.entityId
          entity.removePassenger(passengerId)

        if entity.entityType.id == EntityType.TNT_MINECART.id:
          let fuse = self.tntFuse
          if fuse == -1'i32:
            self.tntFuse = 80'i32
            world.playSound(sdEntityTntPrimed, scBlocks, pos)
        elif self.vehicle.getHurtTime() == 0'i32:
          self.vehicle.setHurtDir(-self.vehicle.getHurtDir())
          self.vehicle.setHurtTime(10'i32)
          self.vehicle.setDamage(50.0'f32)
          # TODO upstream: Send entity status
    elif isPoweredRail:
      var velocity = entity.velocity
      velocity = velocity.multiply(0.5, 0.5, 0.5)
      if velocity.length() < 0.01:
        velocity = v3(0.0, 0.0, 0.0)
      entity.velocity = velocity
      entity.sendVelocity()

  if entity.entityType.id == EntityType.TNT_MINECART.id:
    let fuse = self.tntFuse
    if fuse > 0'i32:
      let newFuse = fuse - 1'i32
      self.tntFuse = newFuse

      if newFuse mod 2'i32 == 0'i32:
        world.spawnParticle(pos, v3(0.0, 0.0, 0.0), 0.0'f32, 1'i32, ptSmoke)

      if newFuse == 0'i32:
        entity.remove()
        world.explode(pos, 4.0'f32)

  var velocity = entity.velocity

  var hasDriver = false
  var driverInput = 0'i8
  var driverYaw = 0.0'f32

  if entity.passengers.len > 0:
    let passenger = entity.passengers[0]
    let player = passenger.getPlayer()
    if player != nil:
      driverInput = player.lastInput
      driverYaw = playerBase(player).entity.yaw
      hasDriver = true

  if hasDriver and isOnRails:
    let forward = (driverInput and PlayerInputForward) != 0'i8
    let backward = (driverInput and PlayerInputBackward) != 0'i8

    var forceDir = v3(0.0, 0.0, 0.0)
    if forward:
      let yawRad = degToRad(float64(driverYaw))
      forceDir.x = -sin(yawRad)
      forceDir.z = cos(yawRad)
    elif backward:
      let yawRad = degToRad(float64(driverYaw))
      forceDir.x = sin(yawRad)
      forceDir.z = -cos(yawRad)

    if forward or backward:
      velocity.x += forceDir.x * 0.02
      velocity.z += forceDir.z * 0.02

      let speed = hypot(velocity.x, velocity.z)
      if speed > 0.15:
        let oldSpeed = hypot(entity.velocity.x, entity.velocity.z)
        let maxSpeed = clamp(oldSpeed, 0.15, 0.4)
        if speed > maxSpeed:
          velocity.x = (velocity.x / speed) * maxSpeed
          velocity.z = (velocity.z / speed) * maxSpeed
      entity.velocity = velocity
      entity.sendVelocity()

  velocity = entity.velocity

  if isOnRails:
    var shape: RailShape
    if block0.name == "rail":
      let props = fromStateId(RailLikeProperties, newBlockStateIdUnchecked(uint16(stateId)), block0)
      shape = props.shape
    else:
      let props = fromStateId(PoweredRailLikeProperties, newBlockStateIdUnchecked(uint16(stateId)), block0)
      shape = straightToRailShape(props.shape)

    let pos1 = entity.pos
    let blockCenterBottom = v3(float64(blockPos.x) + 0.5, float64(blockPos.y), float64(blockPos.z) + 0.5)

    let (exit0a, exit1a) = getExits(shape)
    let exit0 = exit0a.multiply(0.5, 0.5, 0.5)
    let exit1 = exit1a.multiply(0.5, 0.5, 0.5)

    let inCorner = exit0.x != exit1.x and exit0.z != exit1.z
    var targetPosition = pos1

    if inCorner:
      let from0to1 = exit1 - exit0
      let from0topos = pos1 - blockCenterBottom - exit0
      let dotNum = from0to1.dot(from0topos)
      let dotDen = from0to1.dot(from0to1)
      if dotDen != 0.0:
        let travelVectorFrom0 = from0to1.multiply(dotNum / dotDen, dotNum / dotDen, dotNum / dotDen)
        targetPosition = blockCenterBottom.add(exit0).add(travelVectorFrom0)
    else:
      let zSnap = abs(exit0.x - exit1.x) > 1e-5
      let xSnap = abs(exit0.z - exit1.z) > 1e-5
      if xSnap:
        targetPosition.x = blockCenterBottom.x
      if zSnap:
        targetPosition.z = blockCenterBottom.z

    targetPosition.y = pos1.y
    entity.pos = targetPosition

    let horizontalInDirection = v3(exit1.x, 0.0, exit1.z)
    var horizontalOutDirection = v3(exit0.x, 0.0, exit0.z)

    if velocity.dot(horizontalOutDirection) < velocity.dot(horizontalInDirection):
      horizontalOutDirection = horizontalInDirection

    let outPosition = blockCenterBottom.add(horizontalOutDirection).add(
      horizontalOutDirection.normalize().multiply(1e-5, 1e-5, 1e-5))

    var towardsOut = outPosition - targetPosition
    towardsOut.y = 0.0
    let towardsLength = towardsOut.length()
    if towardsLength > 1e-5:
      towardsOut = towardsOut.normalize()
      let speed = velocity.length()
      velocity = towardsOut.multiply(speed, speed, speed)

    entity.velocity = velocity

  if velocity.length() > 0.001:
    moveEntity(EntityBase(self), caller, velocity)
    let newPos = entity.pos

    for passenger in entity.passengers:
      passenger.entity.setPos(newPos)

    entity.sendPosRot()

    var friction = 0.98 # Default off-rail air drag

    if isOnRails:
      let hasPassengers0 = entity.passengers.len > 0
      friction = if hasPassengers0: 0.99 else: 0.96
    else:
      let belowBlockPos = newBlockPos(blockPos.x, blockPos.y - 1'i32, blockPos.z)
      let belowBlock = world.getBlock(belowBlockPos)

      let isOnGround = entity.onGround or (belowBlock.name != "air" and belowBlock.name != "water" and
        belowBlock.name != "lava")
      let isInWater = entity.touchingWater or belowBlock.name == "water"

      if isOnGround:
        friction = 0.5
      elif isInWater:
        friction = 0.95

    var nextVel = velocity.multiply(friction, friction, friction)
    if nextVel.length() < 0.005:
      nextVel = v3(0.0, 0.0, 0.0)
    entity.velocity = nextVel

proc isMinecartType(entityType: EntityType): bool =
  entityType.id == EntityType.MINECART.id or entityType.id == EntityType.CHEST_MINECART.id or
    entityType.id == EntityType.COMMAND_BLOCK_MINECART.id or entityType.id == EntityType.FURNACE_MINECART.id or
    entityType.id == EntityType.HOPPER_MINECART.id or entityType.id == EntityType.SPAWNER_MINECART.id or
    entityType.id == EntityType.TNT_MINECART.id

proc minecartPush(self, other: EntityBase) =
  let selfEntity = self.entity
  let otherEntity = other.entity

  if selfEntity.noClip or otherEntity.noClip:
    return

  for passenger in selfEntity.passengers:
    if passenger.entity.entityId == otherEntity.entityId:
      return
  for passenger in otherEntity.passengers:
    if passenger.entity.entityId == selfEntity.entityId:
      return

  var xa = otherEntity.pos.x - selfEntity.pos.x
  var za = otherEntity.pos.z - selfEntity.pos.z
  var dd = xa * xa + za * za
  if dd >= 1.0e-4:
    dd = sqrt(dd)
    xa = xa / dd
    za = za / dd
    var pow0 = 1.0 / dd
    if pow0 > 1.0:
      pow0 = 1.0
    xa = xa * pow0
    za = za * pow0
    xa = xa * 0.1
    za = za * 0.1
    xa = xa * 0.5
    za = za * 0.5

    if isMinecartType(otherEntity.entityType):
      let xo = selfEntity.velocity.x
      let zo = selfEntity.velocity.z

      let dir = v3(xo, 0.0, zo).normalize()
      let facing = v3(float64(cosF32(toRadiansF32(selfEntity.yaw))), 0.0,
        float64(sinF32(toRadiansF32(selfEntity.yaw)))).normalize()

      let dotValue = abs(dir.dot(facing))
      if dotValue >= 0.8:
        let vel = selfEntity.velocity
        let ovel = otherEntity.velocity

        let isSelfFurnace = selfEntity.entityType.id == EntityType.FURNACE_MINECART.id
        let isOtherFurnace = otherEntity.entityType.id == EntityType.FURNACE_MINECART.id

        if isOtherFurnace and not isSelfFurnace:
          selfEntity.velocity = vel.multiply(0.2, 1.0, 0.2)
          var newSelfVel = selfEntity.velocity
          newSelfVel.x += ovel.x - xa
          newSelfVel.z += ovel.z - za
          selfEntity.velocity = newSelfVel
          selfEntity.sendVelocity()

          otherEntity.velocity = ovel.multiply(0.95, 1.0, 0.95)
          otherEntity.sendVelocity()
        elif not isOtherFurnace and isSelfFurnace:
          otherEntity.velocity = ovel.multiply(0.2, 1.0, 0.2)
          var newOtherVel = otherEntity.velocity
          newOtherVel.x += vel.x + xa
          newOtherVel.z += vel.z + za
          otherEntity.velocity = newOtherVel
          otherEntity.sendVelocity()

          selfEntity.velocity = vel.multiply(0.95, 1.0, 0.95)
          selfEntity.sendVelocity()
        else:
          let xdd = (ovel.x + vel.x) / 2.0
          let zdd = (ovel.z + vel.z) / 2.0

          selfEntity.velocity = vel.multiply(0.2, 1.0, 0.2)
          var newSelfVel = selfEntity.velocity
          newSelfVel.x += xdd - xa
          newSelfVel.z += zdd - za
          selfEntity.velocity = newSelfVel
          selfEntity.sendVelocity()

          otherEntity.velocity = ovel.multiply(0.2, 1.0, 0.2)
          var newOtherVel = otherEntity.velocity
          newOtherVel.x += xdd + xa
          newOtherVel.z += zdd + za
          otherEntity.velocity = newOtherVel
          otherEntity.sendVelocity()
    else:
      if not selfEntity.hasPassengers() and self.isPushable():
        var vel = selfEntity.velocity
        vel.x -= xa
        vel.z -= za
        selfEntity.velocity = vel
        selfEntity.sendVelocity()

      if not otherEntity.hasPassengers() and other.isPushable():
        var vel = otherEntity.velocity
        vel.x += xa / 4.0
        vel.z += za / 4.0
        otherEntity.velocity = vel
        otherEntity.sendVelocity()

proc makeMinecartVt(): EntityVt =
  result = copyVt(entityVt())
  result.tick = proc(self, caller: EntityBase; server: Server) {.closure.} =
    let m = MinecartEntity(self)
    minecartTick(m, caller)
  result.isPushable = proc(self: EntityBase): bool {.closure.} = true
  result.push = proc(self, entity: EntityBase) {.closure.} =
    minecartPush(self, entity)
  result.isCollidable = proc(self: EntityBase; entity: nil EntityBase): bool {.closure.} = true
  result.initDataTracker = proc(self: EntityBase) {.closure.} =
    let m = MinecartEntity(self)
    m.vehicle.sendWobbleMetadata()
  result.canHit = proc(self: EntityBase): bool {.closure.} =
    self.entity.isAlive()
  result.damageWithContext = proc(self, caller: EntityBase; amount: float32; damageType: DamageType;
      position: Option[Vector3[float64]]; source, cause: nil EntityBase): bool {.closure.} =
    let m = MinecartEntity(self)
    m.vehicle.damageWithContext(amount, source)
  result.interact = proc(self: EntityBase; player: Player; itemStack: var ItemStack): bool {.closure.} =
    let entity = self.entity
    let playerEntity = playerBase(player).entity
    if playerEntity.isSneaking():
      return false
    if entity.passengers.len > 0:
      return false
    if playerEntity.hasVehicle():
      return false
    let world = entity.world
    let vehicle0 = getEntityById(world, entity.entityId)
    if vehicle0 == nil:
      return false
    let passenger = getPlayerById(world, player.entityId)
    if passenger == nil:
      return false
    entity.addPassenger(vehicle0, playerBase(passenger))
    true
  result.onPlayerCollision = proc(self: EntityBase; player: Player) {.closure.} =
    let entity = self.entity
    for passenger in entity.passengers:
      if passenger.entity.entityId == player.entityId:
        return

    if player.gamemode == Spectator:
      return

    let playerPos = playerBase(player).entity.pos
    let minecartPos = entity.pos

    var diffX = minecartPos.x - playerPos.x
    var diffZ = minecartPos.z - playerPos.z

    let distSq = diffX * diffX + diffZ * diffZ
    if distSq > 0.0001:
      let dist = sqrt(distSq)
      diffX = diffX / dist
      diffZ = diffZ / dist

      let pushForce = 0.1
      var vel = entity.velocity
      vel.x += diffX * pushForce
      vel.z += diffZ * pushForce

      let horizontalSpeed = hypot(vel.x, vel.z)
      if horizontalSpeed > 0.4:
        vel.x = (vel.x / horizontalSpeed) * 0.4
        vel.z = (vel.z / horizontalSpeed) * 0.4

      entity.velocity = vel
      entity.sendVelocity()
  result.moveEntity = proc(self, caller: EntityBase; motion: Vector3[float64]) {.closure.} =
    let entity = self.entity
    let toPosition = entity.pos.add(motion)
    entity.moveEntity(caller, motion)
    let shouldContinue = self.pushEntities(caller)
    if shouldContinue:
      let currentPos = entity.pos
      let backMotion = toPosition.sub(currentPos)
      entity.moveEntity(caller, backMotion)

let minecartVt = makeMinecartVt()

proc newMinecartEntity*(entity: Entity): MinecartEntity =
  result = MinecartEntity(vehicle: newVehicleEntity(entity), active: false, tntFuse: -1'i32)
  result.initEntityBase(entity, minecartVt)
