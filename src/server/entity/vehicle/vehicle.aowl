## Port of pumpkin/src/entity/vehicle/vehicle.rs

import std/options
import ../trackedalias
import "../../../data/item_stack/mod"
import ../../../generated/[tracked_data, meta_data_type]
import ../entitymod

type
  VehicleEntity* = ref object
    entity*: Entity
    hurtTime*: int32
    hurtDir*: int32
    damage*: float32

proc newVehicleEntity*(entity: Entity): VehicleEntity =
  VehicleEntity(entity: entity, hurtTime: 0'i32, hurtDir: 1'i32, damage: 0.0'f32)

proc tick*(self: VehicleEntity) =
  if self.hurtTime > 0'i32:
    self.hurtTime = self.hurtTime - 1'i32
  if self.damage > 0.0'f32:
    self.damage = self.damage - 1.0'f32

proc setDamage*(self: VehicleEntity; damage: float32) =
  self.damage = damage

proc getDamage*(self: VehicleEntity): float32 =
  self.damage

proc setHurtTime*(self: VehicleEntity; hurtTime: int32) =
  self.hurtTime = hurtTime

proc getHurtTime*(self: VehicleEntity): int32 =
  self.hurtTime

proc setHurtDir*(self: VehicleEntity; hurtDir: int32) =
  self.hurtDir = hurtDir

proc getHurtDir*(self: VehicleEntity): int32 =
  self.hurtDir

proc sendWobbleMetadata*(self: VehicleEntity) =
  self.entity.sendMetaData(TD_HURT, TD_INT, newVarInt(self.getHurtTime()))
  self.entity.sendMetaData(TD_HURT_DIR, TD_INT, newVarInt(self.getHurtDir()))
  self.entity.sendMetaData(TD_DAMAGE, FLOAT, self.getDamage())

proc killAndDropSelf*(self: VehicleEntity) =
  let world = self.entity.world
  let entityDrops = world.levelInfo.gameRules.entityDrops
  if entityDrops and self.entity.entityType.lootTable != nil:
    let pos = self.entity.blockPos
    let isRaining = world.weather.raining
    let isThundering = world.weather.thundering
    var params = LootContextParams()
    params.isRaining = some(isRaining)
    params.isThundering = some(isThundering)
    params.worldTime = uint64(world.levelInfo.dayTime)
    for stack in callLootHook(self.entity.entityType, params):
      callDropStack(world, pos, stack)
  self.entity.remove()

proc damageWithContext*(self: VehicleEntity; amount: float32; source: nil EntityBase): bool =
  if not self.entity.isAlive():
    return true

  let currentSide = self.getHurtDir()
  self.setHurtDir(-currentSide)
  self.setHurtTime(10'i32)
  self.entity.velocityDirty = true

  let currentStrength = self.getDamage()
  let newStrength = currentStrength + amount * 10.0'f32
  self.setDamage(newStrength)

  self.sendWobbleMetadata()

  var isCreative = false
  if source != nil:
    let player = source.getPlayer()
    if player != nil:
      isCreative = player.gamemode == Creative

  if isCreative or newStrength > 40.0'f32:
    if isCreative:
      self.entity.remove()
    else:
      self.killAndDropSelf()

  true
