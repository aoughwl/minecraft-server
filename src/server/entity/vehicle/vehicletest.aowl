## Known answers read from pumpkin/src/entity/vehicle/{vehicle,boat,minecart}.rs. Upstream has no #[test] for these.

import std/[assertions, options]
import "../../../data/item_stack/mod"
import ../../../generated/damage_type
import ../entitymod
import ../mob/testworld
import ../../../data/block_ext
import vehicle, boat, minecart

let server = newTestServer()
let world0 = newTestWorld(server, "vehicletest")

proc entityOf(entityType: EntityType; at: Vector3[float64]): Entity =
  newEntity(world0, at, entityType)

block vehicle_state:
  let v = newVehicleEntity(entityOf(EntityType.OAK_BOAT, pos3(0.0, 80.0, 0.0)))
  assert v.getHurtTime() == 0'i32
  assert v.getHurtDir() == 1'i32
  assert v.getDamage() == 0.0'f32
  v.setHurtTime(2'i32)
  v.setDamage(1.5'f32)
  v.tick()
  assert v.getHurtTime() == 1'i32
  assert v.getDamage() == 0.5'f32
  v.tick()
  assert v.getHurtTime() == 0'i32
  assert v.getDamage() == -0.5'f32, "a damage of 0.5 still takes the full 1.0"
  v.tick()
  assert v.getHurtTime() == 0'i32
  assert v.getDamage() == -0.5'f32

block vehicle_damage:
  let v = newVehicleEntity(entityOf(EntityType.OAK_BOAT, pos3(0.0, 80.0, 0.0)))
  # Each hit flips the side, sets 10 hurt ticks and adds amount * 10.
  assert v.damageWithContext(2.0'f32, nil)
  assert v.getHurtDir() == -1'i32
  assert v.getHurtTime() == 10'i32
  assert v.getDamage() == 20.0'f32
  assert v.entity.isAlive()
  assert v.entity.velocityDirty
  assert v.damageWithContext(2.0'f32, nil)
  assert v.getHurtDir() == 1'i32
  assert v.getDamage() == 40.0'f32
  assert v.entity.isAlive(), "40 is not over 40"
  assert v.damageWithContext(0.1'f32, nil)
  assert not v.entity.isAlive()
  # Already dead: true and nothing changes.
  let damageBefore = v.getDamage()
  assert v.damageWithContext(5.0'f32, nil)
  assert v.getDamage() == damageBefore

block boat:
  let b = newBoatEntity(entityOf(EntityType.OAK_BOAT, pos3(0.0, 80.0, 0.0)))
  let base = asBase(b)
  assert base.isPushable()
  assert base.canHit()
  assert base.isCollidable(nil)
  assert base.getLivingEntity() == nil
  base.setPaddleState(true, false)
  assert b.leftPaddleMoving
  assert not b.rightPaddleMoving

  # Underwater: +1 per tick up to 60, -1 back to 0.
  b.vehicle.entity.touchingWater = true
  for i in 0 ..< 70:
    base.tick(base, server)
  assert b.ticksUnderwater == 60.0'f32
  b.vehicle.entity.touchingWater = false
  base.tick(base, server)
  assert b.ticksUnderwater == 59.0'f32

  assert base.damageWithContext(base, 5.0'f32, GENERIC, none[Vector3[float64]](), nil, nil)
  assert not b.vehicle.entity.isAlive(), "5 * 10 > 40"
  assert not base.canHit()

proc checkExits(shape: RailShape; a, b: Vector3[float64]) =
  let (exit0, exit1) = getExits(shape)
  assert exit0 == a
  assert exit1 == b

block rail_exits:
  # `get_exits`, whole table.
  checkExits(RailShape.NorthSouth, pos3(0.0, 0.0, -1.0), pos3(0.0, 0.0, 1.0))
  checkExits(RailShape.EastWest, pos3(-1.0, 0.0, 0.0), pos3(1.0, 0.0, 0.0))
  checkExits(RailShape.AscendingEast, pos3(-1.0, 0.0, 0.0), pos3(1.0, 1.0, 0.0))
  checkExits(RailShape.AscendingWest, pos3(1.0, 0.0, 0.0), pos3(-1.0, 1.0, 0.0))
  checkExits(RailShape.AscendingNorth, pos3(0.0, 0.0, 1.0), pos3(0.0, 1.0, -1.0))
  checkExits(RailShape.AscendingSouth, pos3(0.0, 0.0, -1.0), pos3(0.0, 1.0, 1.0))
  checkExits(RailShape.SouthEast, pos3(0.0, 0.0, 1.0), pos3(1.0, 0.0, 0.0))
  checkExits(RailShape.SouthWest, pos3(0.0, 0.0, 1.0), pos3(-1.0, 0.0, 0.0))
  checkExits(RailShape.NorthWest, pos3(0.0, 0.0, -1.0), pos3(-1.0, 0.0, 0.0))
  checkExits(RailShape.NorthEast, pos3(0.0, 0.0, -1.0), pos3(1.0, 0.0, 0.0))

block minecart_off_rail:
  let m = newMinecartEntity(entityOf(EntityType.MINECART, pos3(0.5, 80.0, 0.5)))
  let base = asBase(m)
  assert m.tntFuse == -1'i32
  assert base.isPushable()
  # Void air below is not air, water or lava by id, so upstream's friction is the on-ground 0.5.
  m.vehicle.entity.velocity = pos3(0.0, 0.0, 0.2)
  base.tick(base, server)
  assert near(m.vehicle.entity.velocity.z, 0.1)
  assert near(m.vehicle.entity.velocity.x, 0.0)

block minecart_push_entity:
  # A non-minecart pushes the cart a full xa, itself a quarter.
  let m = newMinecartEntity(entityOf(EntityType.MINECART, pos3(0.0, 80.0, 0.0)))
  let other = newBoatEntity(entityOf(EntityType.OAK_BOAT, pos3(0.5, 80.0, 0.0)))
  let base = asBase(m)
  let otherBase = asBase(other)
  base.push(otherBase)
  # dd = 0.25, sqrt 0.5; xa = 1.0 * 1.0 (pow capped at 1) * 0.1 * 0.5.
  assert near(m.vehicle.entity.velocity.x, -0.05)
  assert near(other.vehicle.entity.velocity.x, 0.0125)

block minecart_tnt_fuse:
  let m = newMinecartEntity(entityOf(EntityType.TNT_MINECART, pos3(0.5, 80.0, 0.5)))
  let base = asBase(m)
  m.tntFuse = 2'i32
  base.tick(base, server)
  assert m.tntFuse == 1'i32
  assert m.vehicle.entity.isAlive()
  base.tick(base, server)
  assert m.tntFuse == 0'i32
  assert not m.vehicle.entity.isAlive()
