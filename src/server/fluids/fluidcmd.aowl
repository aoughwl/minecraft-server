## The `/fluids` command: switch the finite-fluid model (fluidhost.aowl) on or off and look at it. Op level 3 (it changes how every
## water and lava block of the server behaves). OFF by default.
##
##   /fluids status            on/off, the budget, and per world: tracked cells, mass per kind, counters
##   /fluids on                the model takes over water and lava (vanilla fluid ticks stop); blocks are adopted around players
##   /fluids off               vanilla fluids again (the blocks already written stay as they are)
##   /fluids budget <cells>    cells processed per step (default 600)
##   /fluids every <ticks>     ticks between two steps (default 2)

import std/strutils
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/permission
import ../../util/text/[textbase, text, color]
import fluidhost

const
  Names = ["fluids", "finitefluids"]
  Description = "Finite, conserved-volume water and lava (optional)."
  ArgRest = "args"
  Permission0* = "fluids:command.fluids"

proc registerPermission*(registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Three)))

proc say(sender: CommandSender; line: string) =
  sendMessage(sender, text(line))

proc sayOk(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncGreen))

proc sayBad(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncRed))

proc isNumber(s: string): bool =
  if s.len == 0 or s.len > 6:
    return false
  for c in s:
    if c < '0' or c > '9':
      return false
  true

proc toNumber(s: string): int =
  result = 0
  for c in s:
    result = result * 10 + (ord(c) - ord('0'))

proc fluidsCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var line = ""
  discard findMsg(args, ArgRest, line)
  let parts = line.splitWhitespace()
  if parts.len == 0:
    say(sender, "/fluids status | on | off | budget <cells> | every <ticks>")
    return cmdSuccess(0'i32)
  case parts[0]
  of "on":
    setFluidsEnabled(true)
    sayOk(sender, "Finite fluids ON: water and lava are conserved volumes now (vanilla fluid ticks are suppressed).")
  of "off":
    setFluidsEnabled(false)
    sayOk(sender, "Finite fluids off: vanilla water and lava rules again.")
  of "status":
    let lines = fluidsStatus()
    for i in 0 ..< lines.len:
      say(sender, lines[i])
  of "budget":
    if parts.len < 2 or not isNumber(parts[1]):
      sayBad(sender, "Usage: /fluids budget <cells per step>")
    else:
      setFluidBudget(toNumber(parts[1]))
      sayOk(sender, "Budget set.")
  of "every":
    if parts.len < 2 or not isNumber(parts[1]):
      sayBad(sender, "Usage: /fluids every <ticks>")
    else:
      setFluidStepEvery(toNumber(parts[1]))
      sayOk(sender, "Step interval set.")
  else:
    sayBad(sender, "Unknown /fluids subcommand " & parts[0] & ".")
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(execute(newCommandTree(Names, Description), fluidsCommand), execute(argument(ArgRest, newMsgArgConsumer()), fluidsCommand))
