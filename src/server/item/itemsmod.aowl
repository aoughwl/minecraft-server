## Port of pumpkin/src/item/items/mod.rs

import itembehaviour
import placing_items
import thrown_items
import tool_items

export itembehaviour, placing_items, thrown_items, tool_items

proc defaultRegistry*(): ItemRegistry =
  ## `default_registry`
  let manager = newItemRegistry()
  manager.register(newArrowItem())
  manager.register(newBowItem())
  manager.register(newCrossbowItem())
  manager.register(newSnowBallItem())
  manager.register(newHoeItem())
  manager.register(newEggItem())
  manager.register(newFlintAndSteelItem())
  manager.register(newSwordItem())
  manager.register(newMaceItem())
  manager.register(newTridentItem())
  manager.register(newFishingRodItem())
  # TODO upstream: Register CrossbowItem with per-shot durability cost.
  # TODO upstream: Register BrushItem with per-stroke durability cost.
  # TODO upstream: Register CarrotOnAStickItem and WarpedFungusOnAStickItem with boost durability costs.
  manager.register(newEmptyBucketItem())
  manager.register(newFilledBucketItem())
  manager.register(newShovelItem())
  manager.register(newSpawnEggItem())
  manager.register(newAxeItem())
  manager.register(newEndCrystalItem())
  manager.register(newMinecartItem())
  manager.register(newHoneyCombItem())
  manager.register(newNameTagItem())
  manager.register(newEnderEyeItem())
  manager.register(newEnderPearlItem())
  manager.register(newFireChargeItem())
  manager.register(newDyeItem())
  manager.register(newMapItem())
  manager.register(newFireworkRocketItem())
  manager.register(newInkSacItem())
  manager.register(newGlowingInkSacItem())
  manager.register(newArmorStandItem())
  manager.register(newWindChargeItem())
  manager.register(newBoatItem())
  manager.register(newPotionItem())
  manager.register(newSplashPotionItem())
  manager.register(newLingeringPotionItem())
  manager.register(newBundleItem())
  manager.register(newLeadItem())
  manager

var gItemRegistry* = defaultRegistry()
  ## `Server::item_registry`. Server has no field for it; the one registry is here.
