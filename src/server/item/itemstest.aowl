## item/: known answers worked from the Rust. The registry's contents and cooldown gate, the pure tables (axe, honeycomb, boats,
## minecarts, spawn eggs), `get_power_for_time`, the armor stand's snap, the waterlogged helpers, `can_be_lit`, and each item
## driven with a real `Player` in a void world, which sends nothing as its client has no socket.

import std/[assertions, math, options, syncio]
import "../../data/item_stack/mod"
import ../../data/block_ext
import ../../inventory/[inventory, player_inventory]
import ../entity/entitytype
import ../entity/mob/testworld
import ../entity/player
import ../entity/projectile/projectilesmod
import ../net/winsock
import itemsmod
import placing_items

let server = newTestServer()
let testWorld = newTestWorld(server, "itemstest")
let registry = defaultRegistry()

var nextId = 1000'i32

proc newTestPlayer(gamemode: GameMode): Player =
  nextId += 1'i32
  let client = newJavaClient(InvalidSocket, uint64(nextId))
  client.connectionState = csPlay
  client.version = jmvV1_21_11
  let profile = GameProfile(id: randomUuid(), name: "t" & $nextId, properties: @[], profileActions: @[])
  newPlayer(client, profile, defaultPlayerConfig(), testWorld, server, gamemode, nextId)

proc spawnedCount(): int = entitiesOf(testWorld).entities.len

proc spawnedAt(index: int): EntityBase = entitiesOf(testWorld).entities[index]

proc sameBlock(a: Option[BlockId]; b: BlockId): bool =
  a.isSome and a.unsafeGet == b

block default_registry:
  assert registry.getPumpkinItem(ITEM_SNOWBALL.id) of SnowBallItem
  assert registry.getPumpkinItem(ITEM_DIAMOND_SWORD.id) of SwordItem
  assert registry.getPumpkinItem(ITEM_IRON_AXE.id) of AxeItem
  assert registry.getPumpkinItem(ITEM_STONE_HOE.id) of HoeItem
  assert registry.getPumpkinItem(ITEM_WOODEN_SHOVEL.id) of ShovelItem
  assert registry.getPumpkinItem(ITEM_PIG_SPAWN_EGG.id) of SpawnEggItem
  assert registry.getPumpkinItem(ITEM_RED_DYE.id) of DyeItem
  assert registry.getPumpkinItem(ITEM_RED_BUNDLE.id) of BundleItem
  assert registry.getPumpkinItem(ITEM_STONE.id) == nil

block use_durations:
  assert registry.getUseDuration(ITEM_BOW.id) == some(72000'i32)
  assert registry.getUseDuration(ITEM_CROSSBOW.id) == some(72000'i32)
  assert registry.getUseDuration(ITEM_TRIDENT.id) == some(72000'i32)
  assert registry.getUseDuration(ITEM_SNOWBALL.id).isNone
  assert registry.getUseDuration(ITEM_STONE.id).isNone

block bow_power:
  assert getPowerForTime(0'i32) == 0.0'f32
  # 10/20 = 0.5: (0.25 + 1.0) / 3
  assert getPowerForTime(10'i32) == (0.5'f32 * 0.5'f32 + 0.5'f32 * 2.0'f32) / 3.0'f32
  assert getPowerForTime(20'i32) == 1.0'f32
  assert getPowerForTime(200'i32) == 1.0'f32

block armor_stand_snap:
  assert armorStandRotation(0.0'f32) == -180.0'f32
  assert armorStandRotation(90.0'f32) == -90.0'f32
  assert armorStandRotation(100.0'f32) == -90.0'f32
  assert armorStandRotation(113.0'f32) == -45.0'f32

block armor_stand_placement_offset:
  let at = BlockPos(vec: Vector3[int32](x: 1'i32, y: 2'i32, z: 3'i32))
  assert calculatePlacementPosition(at, BlockDirection.Up).vec.y == 3'i32
  assert calculatePlacementPosition(at, BlockDirection.Down).vec.y == 1'i32
  assert calculatePlacementPosition(at, BlockDirection.North).vec.z == 2'i32
  assert calculatePlacementPosition(at, BlockDirection.South).vec.z == 4'i32
  assert calculatePlacementPosition(at, BlockDirection.West).vec.x == 0'i32
  assert calculatePlacementPosition(at, BlockDirection.East).vec.x == 2'i32

block axe_tables:
  # Stripping comes first, then oxidation, then wax.
  assert sameBlock(tryUseAxe(blockNamed("oak_log").id), blockNamed("stripped_oak_log").id)
  assert sameBlock(tryUseAxe(blockNamed("warped_hyphae").id), blockNamed("stripped_warped_hyphae").id)
  assert sameBlock(tryUseAxe(blockNamed("bamboo_block").id), blockNamed("stripped_bamboo_block").id)
  assert sameBlock(tryUseAxe(blockNamed("oxidized_copper").id), blockNamed("weathered_copper").id)
  assert sameBlock(tryUseAxe(blockNamed("exposed_copper_trapdoor").id), blockNamed("copper_trapdoor").id)
  assert sameBlock(tryUseAxe(blockNamed("waxed_copper_block").id), blockNamed("copper_block").id)
  assert tryUseAxe(blockNamed("stone").id).isNone
  assert tryUseAxe(blockNamed("copper_block").id).isNone

block honeycomb_table:
  assert sameBlock(getWaxedEquivalent(blockNamed("copper_block").id), blockNamed("waxed_copper_block").id)
  assert sameBlock(getWaxedEquivalent(blockNamed("oxidized_cut_copper_slab").id), blockNamed("waxed_oxidized_cut_copper_slab").id)
  assert getWaxedEquivalent(blockNamed("waxed_copper_block").id).isNone
  # What the honeycomb adds the axe takes off again.
  assert sameBlock(getUnwaxedEquivalent(blockNamed("waxed_exposed_copper_door").id), blockNamed("exposed_copper_door").id)

block item_to_entity:
  assert itemToEntityBoat(ITEM_CHERRY_CHEST_BOAT).id == EntityType.CHERRY_CHEST_BOAT.id
  assert itemToEntityBoat(ITEM_BAMBOO_RAFT).id == EntityType.BAMBOO_RAFT.id
  assert itemToEntityBoat(ITEM_STONE).id == EntityType.OAK_BOAT.id
  assert itemToEntityMinecart(ITEM_HOPPER_MINECART).id == EntityType.HOPPER_MINECART.id
  assert itemToEntityMinecart(ITEM_STONE).id == EntityType.MINECART.id

block spawn_eggs:
  let pig = entityFromEgg(ITEM_PIG_SPAWN_EGG.id)
  assert pig.isSome and pig.unsafeGet.id == EntityType.PIG.id
  let zombified = entityFromEgg(ITEM_ZOMBIFIED_PIGLIN_SPAWN_EGG.id)
  assert zombified.isSome and zombified.unsafeGet.id == EntityType.ZOMBIFIED_PIGLIN.id
  assert entityFromEgg(ITEM_STONE.id).isNone
  assert ITEM_COW_SPAWN_EGG.id in spawnEggIds()
  assert ITEM_STONE.id notin spawnEggIds()

block waterlogged:
  let fence = blockNamed("oak_fence")
  let dry = fence.defaultState.id
  assert waterloggedCheck(fence, dry) == some(false)
  assert not placing_items.isWaterlogged(fence, dry)
  let wet = setWaterlogged(fence, dry, true)
  assert wet != dry and placing_items.isWaterlogged(fence, wet)
  assert setWaterlogged(fence, wet, false) == dry
  assert waterloggedCheck(blockNamed("stone"), blockNamed("stone").defaultState.id).isNone

block can_be_lit:
  let candle = blockNamed("candle")
  # A candle is unlit by default.
  let lit = canBeLit(candle, candle.defaultState.id)
  assert lit.isSome and lit.unsafeGet != candle.defaultState.id
  assert canBeLit(candle, lit.unsafeGet).isNone
  # Furnaces carry `lit` and do not qualify.
  let furnace = blockNamed("furnace")
  assert canBeLit(furnace, furnace.defaultState.id).isNone
  assert canBeLit(blockNamed("stone"), blockNamed("stone").defaultState.id).isNone

block can_mine:
  let creative = newTestPlayer(Creative)
  let survival = newTestPlayer(Survival)
  assert not registry.canMine(ITEM_DIAMOND_SWORD, creative)
  assert registry.canMine(ITEM_DIAMOND_SWORD, survival)
  assert not registry.canMine(ITEM_MACE, creative)
  assert not registry.canMine(ITEM_TRIDENT, creative)
  assert not registry.canMine(ITEM_RED_DYE, creative)
  assert registry.canMine(ITEM_STONE, creative)

block cooldowns:
  let player = newTestPlayer(Survival)
  assert not player.isOnCooldown("g")
  assert player.getCooldown("g") == 0.0'f32
  player.startCooldown("g", 10'i32)
  assert player.isOnCooldown("g")
  assert player.getCooldown("g") == 1.0'f32
  player.tickCounter += 5'i32
  assert player.getCooldown("g") == 0.5'f32
  player.tickCounter += 5'i32
  assert not player.isOnCooldown("g")
  assert player.getCooldown("g") == 0.0'f32

block on_use_respects_cooldown:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(4'u8, ITEM_SNOWBALL))
  player.startCooldown(ITEM_SNOWBALL.registryKey, 10'i32)
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before
  assert player.inventory.heldItem().itemCount == 4'u8

block arrows:
  let player = newTestPlayer(Survival)
  assert player.findArrow().isNone
  player.inventory.setStack(5, newItemStack(2'u8, ITEM_ARROW))
  assert player.findArrow() == some(5)
  # The off hand is looked at first.
  player.inventory.setStack(OffHandSlot, newItemStack(1'u8, ITEM_ARROW))
  assert player.findArrow() == some(OffHandSlot)
  assert player.consumeArrow(OffHandSlot)
  assert player.inventory.getStack(OffHandSlot).isEmpty()
  assert player.consumeArrow(5)
  assert player.inventory.getStack(5).itemCount == 1'u8
  assert not player.consumeArrow(20)
  # Creative consumes nothing, and answers true.
  let creative = newTestPlayer(Creative)
  creative.inventory.setStack(5, newItemStack(2'u8, ITEM_ARROW))
  assert creative.consumeArrow(5)
  assert creative.inventory.getStack(5).itemCount == 2'u8

block damage_held_item:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_DIAMOND_SWORD))
  assert player.damageHeldItem(1'i32)
  assert player.inventory.heldItem().getDamage() == 1'i32
  # A stack with no durability is untouched.
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_STONE))
  assert not player.damageHeldItem(1'i32)
  let creative = newTestPlayer(Creative)
  creative.inventory.setHeldItem(newItemStack(1'u8, ITEM_DIAMOND_SWORD))
  assert not creative.damageHeldItem(1'i32)
  assert creative.inventory.heldItem().getDamage() == 0'i32

block drop_item:
  let player = newTestPlayer(Survival)
  let before = spawnedCount()
  player.dropItem(newItemStack(3'u8, ITEM_STONE))
  assert spawnedCount() == before + 1

block throwables:
  let player = newTestPlayer(Survival)
  for (item, entityType) in [(ITEM_SNOWBALL, EntityType.SNOWBALL), (ITEM_EGG, EntityType.EGG),
      (ITEM_ENDER_PEARL, EntityType.ENDER_PEARL)]:
    player.inventory.setHeldItem(newItemStack(2'u8, item))
    let before = spawnedCount()
    registry.onUse(player.inventory.heldItem(), player)
    assert spawnedCount() == before + 1
    assert spawnedAt(before).entity.entityType.id == entityType.id
    assert player.inventory.heldItem().itemCount == 1'u8

block throwable_in_off_hand:
  let player = newTestPlayer(Survival)
  player.inventory.setOffHandItem(newItemStack(2'u8, ITEM_SNOWBALL))
  registry.onUse(player.inventory.offHandItem(), player)
  assert player.inventory.offHandItem().itemCount == 1'u8

block creative_keeps_throwables:
  let player = newTestPlayer(Creative)
  player.inventory.setHeldItem(newItemStack(2'u8, ITEM_SNOWBALL))
  registry.onUse(player.inventory.heldItem(), player)
  assert player.inventory.heldItem().itemCount == 2'u8

block wind_charge_is_not_consumed:
  # Upstream's `normal_use` has no "Consume item" part.
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(2'u8, ITEM_WIND_CHARGE))
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  assert player.inventory.heldItem().itemCount == 2'u8

block potions:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_SPLASH_POTION))
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  assert player.inventory.heldItem().isEmpty()
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_POTION))
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1 # Drinking does not go through here.
  assert player.inventory.heldItem().itemCount == 1'u8

block bow:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_BOW))
  let living = livingOf(player)
  # No arrows: nothing starts.
  registry.onUse(player.inventory.heldItem(), player)
  assert living.itemUseTime == 0'i32
  player.inventory.setStack(9, newItemStack(2'u8, ITEM_ARROW))
  registry.onUse(player.inventory.heldItem(), player)
  assert living.itemUseTime == 72000'i32
  # Drawn for 20 ticks: full power, so it is critical.
  living.itemUseTime = 72000'i32 - 20'i32
  let before = spawnedCount()
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  let shot = spawnedAt(before)
  assert shot of ArrowEntity
  let fired = ArrowEntity(shot)
  assert fired.isCritical and fired.pickup == apAllowed
  assert fired.baseDamage == 2.0'f64
  assert player.inventory.getStack(9).itemCount == 1'u8
  assert player.inventory.heldItem().getDamage() == 1'i32
  # Under 3 ticks: nothing.
  living.itemUseTime = 72000'i32 - 2'i32
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1

block bow_power_enchantment:
  # base_damage *= 1 + 0.25 * (level + 1)
  let player = newTestPlayer(Creative)
  var bowStack = newItemStack(1'u8, ITEM_BOW)
  bowStack.addEnchantment(ENCHANTMENT_POWER, 3'u16)
  player.inventory.setHeldItem(bowStack)
  let before = spawnedCount()
  fireArrow(player, 1.0'f32)
  let shot = ArrowEntity(spawnedAt(before))
  assert shot.baseDamage == 2.0'f64 * (1.0'f64 + 0.25'f64 * 4.0'f64)
  assert shot.pickup == apCreativeOnly
  # Under 0.1: not enough charge.
  fireArrow(player, 0.09'f32)
  assert spawnedCount() == before + 1

block crossbow_fresh_quirk:
  # Upstream's data gives a crossbow an empty `charged_projectiles` by default, and `normal_use` asks only whether the
  # component is there, so a fresh crossbow takes the firing arm: nothing flies, the use costs one point of durability.
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_CROSSBOW))
  player.inventory.setStack(9, newItemStack(1'u8, ITEM_ARROW))
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert livingOf(player).itemUseTime == 0'i32
  assert spawnedCount() == before
  assert player.inventory.heldItem().getDamage() == 1'i32

proc loadCrossbow(player: Player) =
  ## What `on_stopped_using` does after a full draw, with the hand set up by hand.
  livingOf(player).setActiveHand(hRight, player.inventory.heldItem(), 72000'i32)
  livingOf(player).itemUseTime = 72000'i32 - 25'i32
  registry.onStoppedUsing(player.inventory.heldItem(), player)

block crossbow:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_CROSSBOW))
  player.inventory.setStack(9, newItemStack(1'u8, ITEM_ARROW))
  let living = livingOf(player)
  # Under the 25 ticks of charge: nothing is loaded.
  living.setActiveHand(hRight, player.inventory.heldItem(), 72000'i32)
  living.itemUseTime = 72000'i32 - 24'i32
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert player.inventory.getStack(9).itemCount == 1'u8
  assert living.itemUseTime == 0'i32
  # Charged: loaded, arrow gone.
  loadCrossbow(player)
  assert player.inventory.getStack(9).isEmpty()
  let (has, charged) = player.inventory.heldItem().getDataComponent(ChargedProjectilesImpl)
  assert has and charged.projectiles.len == 1
  # Firing: one arrow, the crossbow is damaged.
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  assert player.inventory.heldItem().getDamage() == 1'i32

block crossbow_multishot:
  let player = newTestPlayer(Creative)
  var stack = newItemStack(1'u8, ITEM_CROSSBOW)
  stack.addEnchantment(ENCHANTMENT_MULTISHOT, 1'u16)
  player.inventory.setHeldItem(stack)
  # Creative loads a made-up arrow with none in the inventory.
  loadCrossbow(player)
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 3

block crossbow_quick_charge:
  # 25 less 5 a level.
  let player = newTestPlayer(Survival)
  var stack = newItemStack(1'u8, ITEM_CROSSBOW)
  stack.addEnchantment(ENCHANTMENT_QUICK_CHARGE, 3'u16)
  player.inventory.setHeldItem(stack)
  player.inventory.setStack(9, newItemStack(1'u8, ITEM_ARROW))
  livingOf(player).setActiveHand(hRight, player.inventory.heldItem(), 72000'i32)
  livingOf(player).itemUseTime = 72000'i32 - 10'i32
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert player.inventory.getStack(9).isEmpty()

block trident_throw:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_TRIDENT))
  let living = livingOf(player)
  registry.onUse(player.inventory.heldItem(), player)
  assert living.itemUseTime == 72000'i32
  # Under 10 ticks: not thrown.
  living.itemUseTime = 72000'i32 - 9'i32
  let before = spawnedCount()
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert spawnedCount() == before
  assert not player.inventory.heldItem().isEmpty()
  living.itemUseTime = 72000'i32 - 10'i32
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  assert spawnedAt(before) of TridentEntity
  assert player.inventory.heldItem().isEmpty()

block riptide_without_water_throws:
  # Not touching water and no rain: a normal throw, Riptide or not.
  let player = newTestPlayer(Creative)
  var stack = newItemStack(1'u8, ITEM_TRIDENT)
  stack.addEnchantment(ENCHANTMENT_RIPTIDE, 2'u16)
  player.inventory.setHeldItem(stack)
  let living = livingOf(player)
  registry.onUse(player.inventory.heldItem(), player)
  living.itemUseTime = 72000'i32 - 10'i32
  let before = spawnedCount()
  registry.onStoppedUsing(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  # Creative keeps it.
  assert not player.inventory.heldItem().isEmpty()

block fishing_rod:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_FISHING_ROD))
  assert player.fishingBobber == -1'i32
  registry.onUse(player.inventory.heldItem(), player)
  let id = player.fishingBobber
  assert id != -1'i32
  let bobber = getEntityById(testWorld, id)
  assert bobber != nil and bobber of FishingBobberEntity
  # Reeling in removes it, and the rod can cast again.
  registry.onUse(player.inventory.heldItem(), player)
  assert player.fishingBobber == -1'i32
  assert getEntityById(testWorld, id) == nil

block firework_needs_fall_flying:
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_FIREWORK_ROCKET))
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before
  player.fallFlying = true # the adapter is synced from the Player on every playerBase call
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1

var created = 0

block map_item:
  gItemHooks.nextMapId = proc(s: Server): int32 {.closure.} = 7'i32
  gItemHooks.createMap = proc(s: Server; mapId: int32; w: World; x, z: int32; scale: uint8) {.closure.} =
    created += 1
    assert mapId == 7'i32 and scale == 0'u8
  let player = newTestPlayer(Survival)
  player.inventory.setHeldItem(newItemStack(1'u8, ITEM_MAP))
  registry.onUse(player.inventory.heldItem(), player)
  assert created == 1
  let held = player.inventory.heldItem()
  assert held.item.id == ITEM_FILLED_MAP.id
  let (has, mapId) = held.getDataComponent(MapIdImpl)
  assert has and mapId.id == 7'i32
  # With more than one, the rest stay in the hand and the filled map goes to the inventory.
  player.inventory.setHeldItem(newItemStack(3'u8, ITEM_MAP))
  registry.onUse(player.inventory.heldItem(), player)
  assert player.inventory.heldItem().itemCount == 2'u8 and player.inventory.heldItem().item.id == ITEM_MAP.id

block bundle:
  let player = newTestPlayer(Survival)
  var bundleStack = newItemStack(1'u8, ITEM_BUNDLE)
  bundleStack.patch.add(PatchEntry(id: dcBundleContents, present: true,
    data: toDyn(BundleContentsImpl(items: @[newItemStack(1'u8, ITEM_STONE), newItemStack(1'u8, ITEM_DIRT)]))))
  player.inventory.setHeldItem(bundleStack)
  let before = spawnedCount()
  registry.onUse(player.inventory.heldItem(), player)
  assert spawnedCount() == before + 1
  let (has, contents) = player.inventory.heldItem().getDataComponent(BundleContentsImpl)
  assert has and contents.items.len == 1
  # `try_extract` takes the last.
  assert contents.items[0].item.id == ITEM_STONE.id

block name_tag:
  let player = newTestPlayer(Survival)
  var tag = newItemStack(2'u8, ITEM_NAME_TAG)
  tag.setCustomName("Bob")
  let target = newEntity(testWorld, pos3(0.0, 64.0, 0.0), EntityType.PIG)
  let targetBase = fromType(EntityType.PIG, pos3(0.0, 64.0, 0.0), testWorld, randomUuid())
  discard target
  registry.useOnEntity(tag, player, targetBase)
  assert tag.itemCount == 1'u8

echo "items ok"
