##
## The spawner arm of spawn_egg.rs, the portal arm of ender_eye.rs, the stronghold search and map.rs's `map_manager` go
## through `gItemHooks`; see itembehaviour.aowl. `entity_from_egg` and `spawn_egg_ids` are upstream's generated data; here they
## are derived from the item registry, since an item named `x_spawn_egg` spawns the entity type named `x`.

import std/[math, options]
import "../../data/item_stack/mod"
import ../../data/block_ext
import ../../generated/[block_properties, block_enums, dimension, fluid, sound, sound_category, tag, world_event]
import ../../inventory/[inventory, player_inventory]
