import ../entity/entitytype
import ../entity/player
import ../entity/projectile/[thrown, thrown_items]
import ../entity/raycast
import ../entity/vehicle/[boat, minecart]
import itembehaviour

type
  ArmorStandItem* = ref object of ItemBehaviour
  BoatItem* = ref object of ItemBehaviour
  MinecartItem* = ref object of ItemBehaviour
  EndCrystalItem* = ref object of ItemBehaviour
  EnderEyeItem* = ref object of ItemBehaviour
  LeadItem* = ref object of ItemBehaviour
