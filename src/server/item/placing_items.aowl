  FilledBucketItem* = ref object of ItemBehaviour

# --- armor_stand.rs --------------------------------------------------------------------------------------------------------------

proc calculatePlacementPosition*(location: BlockPos; face: BlockDirection): BlockPos =
  ## `calculate_placement_position`
  location.offset(face.toOffset())

proc armorStandRotation*(playerYaw: float32): float32 =
  ## The placed stand's yaw: snapped to 45 degree steps.
  float32(floor(float64((wrapDegrees(playerYaw - 180.0'f32) + 22.5'f32) / 45.0'f32))) * 45.0'f32

proc makeArmorStandVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    let position = calculatePlacementPosition(location, face).toF64()
    let dimensions = EntityType.ARMOR_STAND.dimension
    let width = float64(dimensions[0])
    let height = float64(dimensions[1])
    let boundingBox = newBoundingBox(
      Vector3[float64](x: position.x - width / 2.0'f64, y: position.y, z: position.z - width / 2.0'f64),
      Vector3[float64](x: position.x + width / 2.0'f64, y: position.y + height, z: position.z + width / 2.0'f64))
    if world.isSpaceEmpty(boundingBox) and world.getEntitiesAtBox(boundingBox).len == 0:
      let rotation = armorStandRotation(player.yaw)
      let entity = newEntity(world, position, EntityType.ARMOR_STAND)
      entity.setRotation(rotation, 0.0'f32)
      world.playSound(sdEntityArmorStandPlace, scBlocks, entity.pos)
      let armorStand: EntityBase = newArmorStandEntity(entity)
      spawnEntity(world, armorStand)
      item.decrementUnlessCreative(player.gamemode, 1'u8)

let armorStandItemVt = makeArmorStandVt()

proc newArmorStandItem*(): ArmorStandItem = ArmorStandItem(vt: armorStandItemVt, ids: @[ITEM_ARMOR_STAND.id])

# --- boat.rs --------------------------------------------------------------------------------------------------------------------

proc itemToEntityBoat*(item: Item): EntityType =
  ## `item_to_entity`: maps boat item to corresponding entity type
  let id = item.id
  if id == ITEM_OAK_BOAT.id: EntityType.OAK_BOAT
  elif id == ITEM_OAK_CHEST_BOAT.id: EntityType.OAK_CHEST_BOAT
  elif id == ITEM_SPRUCE_BOAT.id: EntityType.SPRUCE_BOAT
  elif id == ITEM_SPRUCE_CHEST_BOAT.id: EntityType.SPRUCE_CHEST_BOAT
  elif id == ITEM_BIRCH_BOAT.id: EntityType.BIRCH_BOAT
  elif id == ITEM_BIRCH_CHEST_BOAT.id: EntityType.BIRCH_CHEST_BOAT
  elif id == ITEM_JUNGLE_BOAT.id: EntityType.JUNGLE_BOAT
  elif id == ITEM_JUNGLE_CHEST_BOAT.id: EntityType.JUNGLE_CHEST_BOAT
  elif id == ITEM_ACACIA_BOAT.id: EntityType.ACACIA_BOAT
  elif id == ITEM_ACACIA_CHEST_BOAT.id: EntityType.ACACIA_CHEST_BOAT
  elif id == ITEM_DARK_OAK_BOAT.id: EntityType.DARK_OAK_BOAT
  elif id == ITEM_DARK_OAK_CHEST_BOAT.id: EntityType.DARK_OAK_CHEST_BOAT
  elif id == ITEM_MANGROVE_BOAT.id: EntityType.MANGROVE_BOAT
  elif id == ITEM_MANGROVE_CHEST_BOAT.id: EntityType.MANGROVE_CHEST_BOAT
  elif id == ITEM_CHERRY_BOAT.id: EntityType.CHERRY_BOAT
  elif id == ITEM_CHERRY_CHEST_BOAT.id: EntityType.CHERRY_CHEST_BOAT
  elif id == ITEM_PALE_OAK_BOAT.id: EntityType.PALE_OAK_BOAT
  elif id == ITEM_PALE_OAK_CHEST_BOAT.id: EntityType.PALE_OAK_CHEST_BOAT
  elif id == ITEM_BAMBOO_RAFT.id: EntityType.BAMBOO_RAFT
  elif id == ITEM_BAMBOO_CHEST_RAFT.id: EntityType.BAMBOO_CHEST_RAFT
  else: EntityType.OAK_BOAT

proc makeBoatVt(): ItemVt =
  ## Vanilla: `BoatItem.use()` - raycasts to find placement position
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let (startPos, endPos) = getStartAndEndPos(player)
    # Vanilla: raycast with FluidHandling.ANY - stops on water/lava surface or solid blocks; air doesn't stop the raycast
    let rayHit = world.raycast(startPos, endPos, proc(pos: BlockPos; w: World): bool {.closure.} =
      w.stateIdAt(pos) != blockNamed("air").defaultState.id)
    if rayHit.isNone:
      return
    let hitPos = rayHit.unsafeGet[0]
    # Calculate hit position - center of the block top or water surface
    # TODO upstream: Vanilla uses exact raycast intersection point (hitResult.getPos()),
    # Pumpkin's raycast only returns block positions.
    let hitVec = Vector3[float64](x: float64(hitPos.vec.x) + 0.5'f64, y: float64(hitPos.vec.y) + 1.0'f64,
      z: float64(hitPos.vec.z) + 0.5'f64)
    # Vanilla: Check for entities in the path that would block placement
    # Get player's rotation vector stretched by 5.0 and expanded by 1.0
    let rotationVec = rotationVector(float64(player.pitch), float64(player.yaw)).multiply(5.0'f64, 5.0'f64, 5.0'f64)
    let playerEntity = entityOf(player).boundingBox
    let searchBox = playerEntity.stretch(rotationVec).expandAll(1.0'f64)
    let entities = world.getEntitiesAtBox(searchBox)
    let playerEyePos = player.eyePosition()
    for entity in entities:
      # Vanilla: EntityPredicates.CAN_HIT = !isSpectator() && canHit()
      if entity.isSpectator() or not entity.canHit():
        continue
      # Vanilla: expand by getTargetingMargin() (0.0 for most entities)
      # Check if entity's bounding box contains the player's eye position
      if entity.entity.boundingBox.intersects(newBoundingBox(playerEyePos, playerEyePos)):
        # Entity is blocking the line of sight at eye position
        return
    # Create the boat entity
    let entityType = itemToEntityBoat(item)
    let dimensions = newEntityDimensions(entityType.dimension[0], entityType.dimension[1], entityType.eyeHeight)
    let boatBox = BoundingBox.newFromPos(hitVec.x, hitVec.y, hitVec.z, dimensions)
    # Vanilla: if (!world.isSpaceEmpty(lv7, lv7.getBoundingBox())) return FAIL
    if not world.isSpaceEmpty(boatBox):
      return
    # Check no entities occupy the space
    if world.getEntitiesAtBox(boatBox).len != 0:
      return
    # Create and spawn the boat
    let entity = newEntity(world, hitVec, entityType)
    # Set yaw to player's yaw
    entity.setRotation(player.yaw, 0.0'f32)
    let boatEntity: EntityBase = newBoatEntity(entity)
    spawnEntity(world, boatEntity)
    # Decrement item unless in creative mode
    var stack = player.inventory.heldItem()
    stack.decrementUnlessCreative(player.gamemode, 1'u8)
    player.inventory.setHeldItem(stack)
    # TODO upstream: world.emitGameEvent(user, GameEvent.ENTITY_PLACE, hitResult.getPos())
    # TODO upstream: user.incrementStat(Stats.USED.getOrCreateStat(this))

let boatItemVt = makeBoatVt()

proc newBoatItem*(): BoatItem =
  BoatItem(vt: boatItemVt, ids: @[ITEM_OAK_BOAT.id, ITEM_OAK_CHEST_BOAT.id, ITEM_SPRUCE_BOAT.id, ITEM_SPRUCE_CHEST_BOAT.id,
    ITEM_BIRCH_BOAT.id, ITEM_BIRCH_CHEST_BOAT.id, ITEM_JUNGLE_BOAT.id, ITEM_JUNGLE_CHEST_BOAT.id, ITEM_ACACIA_BOAT.id,
    ITEM_ACACIA_CHEST_BOAT.id, ITEM_DARK_OAK_BOAT.id, ITEM_DARK_OAK_CHEST_BOAT.id, ITEM_MANGROVE_BOAT.id,
    ITEM_MANGROVE_CHEST_BOAT.id, ITEM_CHERRY_BOAT.id, ITEM_CHERRY_CHEST_BOAT.id, ITEM_PALE_OAK_BOAT.id,
    ITEM_PALE_OAK_CHEST_BOAT.id, ITEM_BAMBOO_RAFT.id, ITEM_BAMBOO_CHEST_RAFT.id])

# --- minecart.rs ----------------------------------------------------------------------------------------------------------------

proc itemToEntityMinecart*(item: Item): EntityType =
  ## `item_to_entity`
  let id = item.id
  if id == ITEM_MINECART.id: EntityType.MINECART
  elif id == ITEM_TNT_MINECART.id: EntityType.TNT_MINECART
  elif id == ITEM_CHEST_MINECART.id: EntityType.CHEST_MINECART
  elif id == ITEM_HOPPER_MINECART.id: EntityType.HOPPER_MINECART
  elif id == ITEM_FURNACE_MINECART.id: EntityType.FURNACE_MINECART
  elif id == ITEM_COMMAND_BLOCK_MINECART.id: EntityType.COMMAND_BLOCK_MINECART
  else: EntityType.MINECART

proc makeMinecartVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    if not hasBlockTag(blockRef, Block_MINECRAFT_RAILS):
      return
    let stateId = world.stateIdAt(location)
    let isAscending =
      if PoweredRailLikeProperties.handlesBlockId(blockRef.id):
        PoweredRailLikeProperties.fromStateId(stateId, blockRef).shape.isAscending()
      else:
        RailLikeProperties.fromStateId(stateId, blockRef).shape.isAscending()
    let height = if isAscending: 0.5'f64 else: 0.0'f64
    let entityType = itemToEntityMinecart(item.item)
    let pos = location.toF64()
    let entity = newEntity(world, Vector3[float64](x: pos.x, y: pos.y + 0.0625'f64 + height, z: pos.z), entityType)
    let minecartEntity: EntityBase = newMinecartEntity(entity)
    spawnEntity(world, minecartEntity)

let minecartItemVt = makeMinecartVt()

proc newMinecartItem*(): MinecartItem =
  MinecartItem(vt: minecartItemVt, ids: @[ITEM_MINECART.id, ITEM_TNT_MINECART.id, ITEM_CHEST_MINECART.id, ITEM_HOPPER_MINECART.id,
    ITEM_FURNACE_MINECART.id, ITEM_COMMAND_BLOCK_MINECART.id])

# --- end_crystal.rs -------------------------------------------------------------------------------------------------------------

proc makeEndCrystalVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    let onBlock = world.getBlock(location)
    if onBlock.id != blockNamed("obsidian").id and onBlock.id != blockNamed("bedrock").id:
      return
    let above = location.up()
    let locationVec = above.toF64()
    # Upstream's box has no width on z: `location_vec.z` at both ends.
    if not BlockState.fromId(world.stateIdAt(above)).isAir or world.getEntitiesAtBox(newBoundingBox(
        Vector3[float64](x: locationVec.x, y: locationVec.y, z: locationVec.z),
        Vector3[float64](x: locationVec.x + 1.0'f64, y: locationVec.y + 2.0'f64, z: locationVec.z))).len != 0:
      return
    let entity = newEntity(world, above.toF64(), EntityType.END_CRYSTAL)
    let endCrystal = newEndCrystalEntity(entity)
    spawnEntity(world, projectileBase(endCrystal))
    endCrystal.setShowBottom(false)
    item.decrementUnlessCreative(player.gamemode, 1'u8)

let endCrystalItemVt = makeEndCrystalVt()

proc newEndCrystalItem*(): EndCrystalItem = EndCrystalItem(vt: endCrystalItemVt, ids: @[ITEM_END_CRYSTAL.id])

# --- ender_eye.rs ---------------------------------------------------------------------------------------------------------------

proc makeEnderEyeVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    if blockRef.id != blockNamed("end_portal_frame").id:
      return
    let world = player.world
    let stateId = world.stateIdAt(location)
    # Skip if the frame already holds an eye.
    let (hasProps, dynProps) = blockRef.properties(stateId)
    if not hasProps:
      return
    var props = dynProps.toProps()
    for prop in props:
      if prop[0] == "eye" and prop[1] == "true":
        return
    # Build new state with eye=true.
    for i in 0 ..< props.len:
      if props[i][0] == "eye":
        props[i] = ("eye", "true")
    let newStateId = blockRef.fromProperties(props).toStateId(blockRef)
    setBlock(world, location, newStateId, BfNotifyListeners)
    # Consume one item.
    item.decrement(1'u8)
    syncWorldEvent(world, weEndPortalFrameFill, location, 0'i32)
    # Try to complete the portal.
    gItemHooks.getNewEndPortal(world, location)
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let (startPos, endPos) = getStartAndEndPos(player)
    let hit = world.raycast(startPos, endPos, proc(pos: BlockPos; w: World): bool {.closure.} =
      w.stateIdAt(pos) != blockNamed("air").defaultState.id)
    if hit.isSome and world.getBlock(hit.unsafeGet[0]).id == blockNamed("end_portal_frame").id:
      return
    let shooter = entityOf(player)
    let origin = shooter.blockPos
    let targetBlockPos = gItemHooks.findStronghold(world, origin)
    if targetBlockPos.isNone:
      return
    let target = targetBlockPos.unsafeGet
    let spawnPos = Vector3[float64](x: shooter.pos.x,
      y: shooter.pos.y + float64(EntityType.EYE_OF_ENDER.dimension[1]) * 0.5'f64, z: shooter.pos.z)
    let entity = newEntity(world, spawnPos, EntityType.EYE_OF_ENDER)
    let eye = newEyeOfEnder(entity)
    eye.signalTo(Vector3[float64](x: float64(target.vec.x), y: float64(target.vec.y), z: float64(target.vec.z)))
    spawnEntity(world, projectileBase(eye))
    let pitch = 0.33'f32 + randomF32() * (0.5'f32 - 0.33'f32)
    world.playSoundRaw(uint16(ord(sdEntityEnderEyeLaunch)), scNeutral, spawnPos, 1.0'f32, pitch)
    gPlayerHooks.triggerAdvancement(player, "LaunchedEyeOfEnder", "")
    var held = player.inventory.heldItem()
    held.decrement(1'u8)
    player.inventory.setHeldItem(held)

let enderEyeItemVt = makeEnderEyeVt()

proc newEnderEyeItem*(): EnderEyeItem = EnderEyeItem(vt: enderEyeItemVt, ids: @[ITEM_ENDER_EYE.id])

# --- lead.rs --------------------------------------------------------------------------------------------------------------------

proc makeLeadVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    if not hasBlockTag(blockRef, Block_MINECRAFT_FENCES):
      return
    let world = player.world
    let center = location.toCenteredF64()
    let searchBox = BoundingBox.newFromPos(center.x, center.y, center.z, newEntityDimensions(32.0'f32, 32.0'f32, 16.0'f32))
    let playerId = player.entityId
    var anyLeashed = false
    var knot: nil LeashKnotEntity = nil
    for entityBase in world.getEntitiesAtBox(searchBox):
      let ent = entityBase.entity
      let holder = ent.leashedTo
      if holder != nil and holder.entity.entityId == playerId:
        if knot == nil:
          knot = getOrCreate(world, location)
        let k = knot
        if k != nil:
          let holderBase: EntityBase = k
          ent.leashTo(holderBase)
          anyLeashed = true
    if anyLeashed:
      if player.gamemode != Creative:
        item.decrement(1'u8)
      world.playSound(sdItemLeadTied, scNeutral, center)

let leadItemVt = makeLeadVt()

proc newLeadItem*(): LeadItem = LeadItem(vt: leadItemVt, ids: @[ITEM_LEAD.id])

# --- name_tag.rs ----------------------------------------------------------------------------------------------------------------

proc makeNameTagVt(): ItemVt =
  result = newItemVt()
  result.useOnEntity = proc(self: ItemBehaviour; item: var ItemStack; player: Player; entity: EntityBase) {.closure.} =
    let target = entity.entity
    if target.entityType.saveable:
      let (has, name) = item.getDataComponent(CustomNameImpl)
      if has:
        # TODO upstream
        target.setCustomName(name.name)
        item.decrementUnlessCreative(player.gamemode, 1'u8)

let nameTagItemVt = makeNameTagVt()

proc newNameTagItem*(): NameTagItem = NameTagItem(vt: nameTagItemVt, ids: @[ITEM_NAME_TAG.id])

# --- spawn_egg.rs ---------------------------------------------------------------------------------------------------------------

const SpawnEggSuffix = "_spawn_egg"

proc entityFromEgg*(itemId: uint16): Option[EntityType] =
  ## `entity_from_egg`
  let found = Item.fromId(itemId)
  if found == nil:
    return none[EntityType]()
  let key = found.registryKey
  if key.len > SpawnEggSuffix.len and key[key.len - SpawnEggSuffix.len .. key.len - 1] == SpawnEggSuffix:
    return EntityType.fromName(key[0 .. key.len - SpawnEggSuffix.len - 1])
  none[EntityType]()

proc spawnEggIds*(): seq[uint16] =
  ## `spawn_egg_ids`
  result = @[]
  for item in gItems:
    if entityFromEgg(item.id).isSome:
      result.add(item.id)

proc applyEntityVariant*(item: ItemStack; mob: EntityBase) =
  ## `apply_entity_variant`
  let (hasChicken, chicken) = item.getDataComponent(ChickenVariantImpl)
  if hasChicken:
    mob.setVariantName(chicken.value)
    return
  let (hasFrog, frog) = item.getDataComponent(FrogVariantImpl)
  if hasFrog:
    mob.setVariantName(frog.value)
    return
  let (hasWolf, wolf) = item.getDataComponent(WolfVariantImpl)
  if hasWolf:
    mob.setVariantName(wolf.value)
    return
  let (hasCat, cat) = item.getDataComponent(CatVariantImpl)
  if hasCat:
    mob.setVariantName(cat.value)
    return
  let (hasVillager, villager) = item.getDataComponent(VillagerVariantImpl)
  if hasVillager:
    mob.setVariantName(villager.value)
    return
  let (hasFox, fox) = item.getDataComponent(FoxVariantImpl)
  if hasFox:
    mob.setVariantName(fox.value)
    return
  let (hasMooshroom, mooshroom) = item.getDataComponent(MooshroomVariantImpl)
  if hasMooshroom:
    mob.setVariantName(mooshroom.value)
    return
  let (hasRabbit, rabbit) = item.getDataComponent(RabbitVariantImpl)
  if hasRabbit:
    mob.setVariantName(rabbit.value)
    return
  let (hasPig, pig) = item.getDataComponent(PigVariantImpl)
  if hasPig:
    mob.setVariantName(pig.value)
    return
  let (hasCow, cow) = item.getDataComponent(CowVariantImpl)
  if hasCow:
    mob.setVariantName(cow.value)
    return
  let (hasHorse, horse) = item.getDataComponent(HorseVariantImpl)
  if hasHorse:
    mob.setVariantName(horse.value)
    return
  let (hasLlama, llama) = item.getDataComponent(LlamaVariantImpl)
  if hasLlama:
    mob.setVariantName(llama.value)
    return
  let (hasAxolotl, axolotl) = item.getDataComponent(AxolotlVariantImpl)
  if hasAxolotl:
    mob.setVariantName(axolotl.value)
    return
  let (hasSheep, sheep) = item.getDataComponent(SheepColorImpl)
  if hasSheep:
    mob.setVariantName(sheep.value)
    return
  let (hasShulker, shulker) = item.getDataComponent(ShulkerColorImpl)
  if hasShulker:
    mob.setVariantName(shulker.value)

proc makeSpawnEggVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let entityType = entityFromEgg(item.item.id)
    if entityType.isSome:
      let world = player.world
      if gItemHooks.setSpawnerEntityType(world, location, entityType.unsafeGet):
        item.decrementUnlessCreative(player.gamemode, 1'u8)
        return
      let offsetPos = location.offset(face.toOffset())
      let pos = Vector3[float64](x: float64(offsetPos.vec.x) + 0.5'f64, y: float64(offsetPos.vec.y),
        z: float64(offsetPos.vec.z) + 0.5'f64)
      # Create rotation like Vanilla
      let yaw = fmodF32(wrapDegrees(randomF32() * 360.0'f32), 360.0'f32)
      let mob = fromType(entityType.unsafeGet, pos, world, randomUuid())
      # Set the rotation
      mob.entity.setRotation(yaw, 0.0'f32)
      applyEntityVariant(item, mob)
      # Broadcast the new mob to all players
      spawnEntity(world, mob)
      item.decrementUnlessCreative(player.gamemode, 1'u8)

let spawnEggItemVt = makeSpawnEggVt()

proc newSpawnEggItem*(): SpawnEggItem = SpawnEggItem(vt: spawnEggItemVt, ids: spawnEggIds())

# --- map.rs ---------------------------------------------------------------------------------------------------------------------

proc makeMapVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let server = player.world.server
    let inventory = player.inventory
    var usedMain = true
    var handStack = inventory.heldItem()
    var found = not handStack.isEmpty() and handStack.item.id == ITEM_MAP.id
    if not found:
      usedMain = false
      handStack = inventory.offHandItem()
      found = not handStack.isEmpty() and handStack.item.id == ITEM_MAP.id
    if found:
      let mapId = gItemHooks.nextMapId(server)
      gItemHooks.createMap(server, mapId, player.world, asI32(player.pos.x), asI32(player.pos.z), 0'u8) # Default scale
      var filledMap = newItemStack(1'u8, ITEM_FILLED_MAP)
      filledMap.patch.add(PatchEntry(id: dcMapId, present: true, data: toDyn(MapIdImpl(id: mapId))))
      let gamemode = player.gamemode
      if handStack.itemCount == 1'u8 and gamemode != Creative:
        handStack = filledMap
        if usedMain: inventory.setHeldItem(handStack) else: inventory.setOffHandItem(handStack)
      else:
        handStack.decrementUnlessCreative(gamemode, 1'u8)
        if usedMain: inventory.setHeldItem(handStack) else: inventory.setOffHandItem(handStack)
        inventory.offerOrDropStack(filledMap, player.inventoryPlayer)

let mapItemVt = makeMapVt()

proc newMapItem*(): MapItem = MapItem(vt: mapItemVt, ids: @[ITEM_MAP.id])

# --- bundle.rs ------------------------------------------------------------------------------------------------------------------

let bundleIds = itemTagIds("minecraft:bundles")

proc tryExtractFromBundle(player: Player; stack: var ItemStack; slot: int) =
  ## The arm both hands share: `try_extract` from the bundle, the sound, the drop and the slot sync. A bundle with no
  ## contents component, or an empty one, does nothing.
  let (has, ignored) = stack.getDataComponent(BundleContentsImpl)
  discard ignored
  if has:
    let index = stack.getDataComponentMut(BundleContentsImpl)
    if stack.patch[index].data.bundleContents.items.len > 0:
      let extracted = stack.patch[index].data.bundleContents.items.pop()
      player.world.playSound(sdItemBundleRemoveOne, scPlayers, player.pos)
      player.inventory.setStack(slot, stack)
      player.dropItem(extracted)
      player.syncHandSlot(slot, stack)

proc makeBundleVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    var heldItem = player.inventory.heldItem()
    if not heldItem.isEmpty() and heldItem.item.id in bundleIds:
      tryExtractFromBundle(player, heldItem, int(player.inventory.getSelectedSlot()))
    else:
      var offHandItem = player.inventory.offHandItem()
      if not offHandItem.isEmpty() and offHandItem.item.id in bundleIds:
        tryExtractFromBundle(player, offHandItem, OffHandSlot)

let bundleItemVt = makeBundleVt()

proc newBundleItem*(): BundleItem = BundleItem(vt: bundleItemVt, ids: bundleIds)

# --- bucket.rs ------------------------------------------------------------------------------------------------------------------

proc waterloggedCheck*(blockRef: Block; state: BlockStateId): Option[bool] =
  ## `waterlogged_check`
  let (hasProps, dynProps) = blockRef.properties(state)
  if hasProps:
    for prop in dynProps.toProps():
      if prop[0] == "waterlogged":
        return some(prop[1] == "true")
  none[bool]()

proc isWaterlogged*(blockRef: Block; state: BlockStateId): bool =
  ## `is_waterlogged`
  let value = waterloggedCheck(blockRef, state)
  value.isSome and value.unsafeGet

proc setWaterlogged*(blockRef: Block; state: BlockStateId; waterlogged: bool): BlockStateId =
  ## `set_waterlogged`
  let (ignored, dynProps) = blockRef.properties(state)
  discard ignored
  var props = dynProps.toProps()
  for i in 0 ..< props.len:
    if props[i][0] == "waterlogged":
      props[i] = ("waterlogged", if waterlogged: "true" else: "false")
  blockRef.fromProperties(props).toStateId(blockRef)

proc scheduleWaterTick(world: World; pos: BlockPos) =
  ## `world.schedule_fluid_tick(&Fluid::WATER, pos, 5, TickPriority::Normal)`
  scheduleFluidTick(world.level, Fluid.WATER.name, pos, 5'u8, tpNormal)

proc giveWaterloggedOff(world: World; pos: BlockPos; blockRef: Block; state: BlockStateId): Item =
  setBlock(world, pos, setWaterlogged(blockRef, state, false), BfNotifyNeighbors)
  scheduleWaterTick(world, pos)
  ITEM_WATER_BUCKET

proc giveBucketItem(player: Player; item: Item) =
  ## `give_player_bucket_item`
  if player.gamemode == Creative:
    for i in 0 ..< MainSize:
      if player.inventory.getStack(i).item.id == item.id:
        return
    var itemStack = newItemStack(1'u8, item)
    discard player.inventory.insertStackAnywhere(itemStack)
  else:
    let itemStack = newItemStack(1'u8, item)
    var heldStack = player.inventory.heldItem()
    if heldStack.itemCount == 1'u8:
      player.inventory.setHeldItem(itemStack)
    else:
      heldStack.decrement(1'u8)
      player.inventory.setHeldItem(heldStack)
      player.inventory.offerOrDropStack(itemStack, player.inventoryPlayer)

proc tryPickupBucketItem(world: World; blockPos: BlockPos; direction: BlockDirection): nil Item =
  ## `try_pickup_bucket_item`
  let blockRef = world.getBlock(blockPos)
  let state = world.stateIdAt(blockPos)
  if blockRef.id == blockNamed("powder_snow").id:
    discard world.breakBlock(blockPos, nil, BfNotifyAll or BfSkipDrops)
    return ITEM_POWDER_SNOW_BUCKET
  if isWaterlogged(blockRef, state):
    return giveWaterloggedOff(world, blockPos, blockRef, state)
  let lava = blockNamed("lava").defaultState.id
  let water = blockNamed("water").defaultState.id
  if state == lava or state == water:
    discard world.breakBlock(blockPos, nil, BfNotifyNeighbors)
    setBlock(world, blockPos, blockNamed("air").defaultState.id, BfNotifyNeighbors)
    return if state == lava: ITEM_LAVA_BUCKET else: ITEM_WATER_BUCKET
  let targetPos = blockPos.offset(direction.toOffset())
  let targetBlock = world.getBlock(targetPos)
  let targetState = world.stateIdAt(targetPos)
  if waterloggedCheck(targetBlock, targetState).isSome:
    return giveWaterloggedOff(world, targetPos, targetBlock, targetState)
  nil

proc shouldEvaporateInNether*(item: Item; world: World): bool =
  ## `should_evaporate_in_nether`
  item.id != ITEM_LAVA_BUCKET.id and item.id != ITEM_POWDER_SNOW_BUCKET.id and world.dimension == THE_NETHER

proc tryPlacePowderSnow(world: World; pos: BlockPos; direction: BlockDirection): bool =
  ## `try_place_powder_snow`
  let state = BlockState.fromId(world.stateIdAt(pos))
  let targetPos = if state.replaceable: pos else: pos.offset(direction.toOffset())
  let targetState = BlockState.fromId(world.stateIdAt(targetPos))
  if not targetState.isAir and not targetState.isLiquid and not targetState.replaceable:
    return false
  setBlock(world, targetPos, blockNamed("powder_snow").defaultState.id, BfNotifyNeighbors)
  true

proc tryPlaceFilledBucket(world: World; item: Item; pos: BlockPos; direction: BlockDirection): bool =
  ## `try_place_filled_bucket`
  let blockRef = world.getBlock(pos)
  let state = world.stateIdAt(pos)
  if item.id == ITEM_POWDER_SNOW_BUCKET.id:
    return tryPlacePowderSnow(world, pos, direction)
  if isWaterlogged(blockRef, state) and item.id == ITEM_WATER_BUCKET.id:
    setBlock(world, pos, setWaterlogged(blockRef, state, true), BfNotifyNeighbors)
    scheduleWaterTick(world, pos)
    return true
  let targetPos = pos.offset(direction.toOffset())
  let targetBlock = world.getBlock(targetPos)
  let targetId = world.stateIdAt(targetPos)
  if waterloggedCheck(targetBlock, targetId).isSome:
    if item.id == ITEM_LAVA_BUCKET.id:
      return false
    setBlock(world, targetPos, setWaterlogged(targetBlock, targetId, true), BfNotifyNeighbors)
    scheduleWaterTick(world, targetPos)
    return true
  if targetId == blockNamed("air").defaultState.id or BlockState.fromId(targetId).isLiquid:
    let placed = if item.id == ITEM_LAVA_BUCKET.id: blockNamed("lava") else: blockNamed("water")
    setBlock(world, targetPos, placed.defaultState.id, BfNotifyNeighbors)
    return true
  false

proc makeEmptyBucketVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let (startPos, endPos) = getStartAndEndPos(player)
    let hit = world.raycast(startPos, endPos, proc(pos: BlockPos; w: World): bool {.closure.} =
      let stateId = w.stateIdAt(pos)
      let found = Block.fromStateId(stateId)
      if stateId == blockNamed("air").defaultState.id:
        return false
      let water = blockNamed("water")
      let lava = blockNamed("lava")
      (found.id != water.id and found.id != lava.id) or
        ((found.id == water.id and stateId == water.defaultState.id) or
          (found.id == lava.id and stateId == lava.defaultState.id)))
    if hit.isNone:
      return
    let picked = tryPickupBucketItem(world, hit.unsafeGet[0], hit.unsafeGet[1])
    if picked != nil:
      giveBucketItem(player, picked)

let emptyBucketItemVt = makeEmptyBucketVt()

proc newEmptyBucketItem*(): EmptyBucketItem = EmptyBucketItem(vt: emptyBucketItemVt, ids: @[ITEM_BUCKET.id])

proc makeFilledBucketVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let (startPos, endPos) = getStartAndEndPos(player)
    let hit = world.raycast(startPos, endPos, proc(pos: BlockPos; w: World): bool {.closure.} =
      let stateId = w.stateIdAt(pos)
      if Fluid.fromStateId(stateId).isSome:
        return false
      stateId != blockNamed("air").defaultState.id)
    if hit.isNone:
      return
    if shouldEvaporateInNether(item, world):
      # `play_bucket_evaporation`
      world.playSoundRaw(uint16(ord(sdBlockFireExtinguish)), scBlocks, player.pos, 0.5'f32,
        float32(float64(randomF32() - randomF32()) * float64(0.8'f32) + float64(2.6'f32)))
      return
    if not tryPlaceFilledBucket(world, item, hit.unsafeGet[0], hit.unsafeGet[1]):
      return
    # TODO upstream: Spawn entity if applicable
    if player.gamemode != Creative:
      player.inventory.setStack(int(player.inventory.getSelectedSlot()), newItemStack(1'u8, ITEM_BUCKET))

let filledBucketItemVt = makeFilledBucketVt()

proc newFilledBucketItem*(): FilledBucketItem =
  FilledBucketItem(vt: filledBucketItemVt, ids: @[ITEM_WATER_BUCKET.id, ITEM_LAVA_BUCKET.id, ITEM_POWDER_SNOW_BUCKET.id,
    ITEM_AXOLOTL_BUCKET.id, ITEM_COD_BUCKET.id, ITEM_SALMON_BUCKET.id, ITEM_TROPICAL_FISH_BUCKET.id,
    ITEM_PUFFERFISH_BUCKET.id, ITEM_TADPOLE_BUCKET.id])
