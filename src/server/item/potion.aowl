## Port of pumpkin/src/item/potion.rs
##
## Importing this fills `gDrinkPotionHook`: living.rs's tick calls `read_potion_effects` then `apply_effects_to`.

import std/options
import "../../data/item_stack/mod"
import ../../generated/potion
import ../entity/entitymod

type
  EffectEntry* = object
    ## Upstream's `(&'static StatusEffect, i32, u8, bool, bool, bool)`.
    effectType*: StatusEffect
    duration*: int32
    amplifier*: uint8
    ambient*: bool
    showParticles*: bool
    showIcon*: bool

  PotionApplicationSource* = enum
    ## Source context for applying potion effects (affects scaling rules).
    pasNormal           ## Normal application (drinking / splash)
    pasAreaEffectCloud  ## `AreaEffectCloud` application (shorter durations and weaker instant potency)

proc readPotionEffects*(stack: ItemStack): seq[EffectEntry] =
  ## `read_potion_effects`: effects from an `ItemStack`'s `PotionContents` data component.
  result = @[]
  let (has, pc) = stack.getDataComponent(PotionContentsImpl)
  if has:
    if pc.potionId.isSome:
      let potionId = pc.potionId.unsafeGet
      # Upstream tries every generated potion in turn; ids are unique.
      for p in gPotions:
        if int32(p.id) == potionId:
          for e in p.effects:
            result.add(EffectEntry(effectType: e.effectType, duration: e.duration, amplifier: e.amplifier,
              ambient: e.ambient, showParticles: e.showParticles, showIcon: e.showIcon))
    # Custom effects appended
    for ce in pc.customEffects:
      let se = StatusEffect.fromMinecraftName(ce.effectId)
      if se.isSome:
        result.add(EffectEntry(effectType: se.unsafeGet, duration: ce.duration, amplifier: cast[uint8](ce.amplifier and 0xFF'i32),
          ambient: ce.ambient, showParticles: ce.showParticles, showIcon: ce.showIcon))

proc applyEffectsTo*(target: LivingEntity; effects: seq[EffectEntry]; scale: float32; source: PotionApplicationSource) =
  ## `apply_effects_to`: instant or duration effects on a target living entity.
  for e in effects:
    # Instant effects should apply immediately
    let isInstant = e.effectType.id == StatusEffect.INSTANT_HEALTH.id or e.effectType.id == StatusEffect.INSTANT_DAMAGE.id
    if isInstant:
      # Instant potency scaling
      let instantScale = if source == pasAreaEffectCloud: scale * 0.5'f32 else: scale
      # Apply instant effects logic directly as they don't tick
      if e.effectType.id == StatusEffect.INSTANT_HEALTH.id:
        let amount = float32(4'i32 * (int32(e.amplifier) + 1'i32)) * instantScale
        target.heal(amount)
      # `INSTANT_DAMAGE` here calls `target.damage(target.get_entity(), ...)`. That is the trait's default `damage`, which
      # asks the `Entity` as caller; `Entity::get_living_entity` is `None`, so it answers false and does nothing. What
      # hurts is `add_effect` just below. Kept as upstream has it.
      # For instant effects, still add a short visual effect entry as before
      target.addEffect(Effect(effectType: e.effectType, duration: 1'i32, amplifier: e.amplifier, ambient: e.ambient,
        showParticles: e.showParticles, showIcon: e.showIcon, blend: false))
    else:
      # Duration scaling
      let durationScale = if source == pasAreaEffectCloud: scale * 0.25'f32 else: scale
      let dur = asI32(max(float32(e.duration) * durationScale, 1.0'f32))
      target.addEffect(Effect(effectType: e.effectType, duration: dur, amplifier: e.amplifier, ambient: e.ambient,
        showParticles: e.showParticles, showIcon: e.showIcon, blend: false))

gDrinkPotionHook = proc(living: LivingEntity; item: ItemStack) {.closure.} =
  applyEffectsTo(living, readPotionEffects(item), 1.0'f32, pasNormal)
