## Port of pumpkin/src/item/items/dye.rs
## Port of pumpkin/src/item/items/ink_sac.rs
## Port of pumpkin/src/item/items/glowing_ink_sac.rs
## Port of pumpkin/src/item/items/honeycomb.rs
##
## The `apply_to_sign` methods, which are what src/server/block/blocks/signs.aowl calls. The rest of each file is in
## tool_items.aowl. This is its own module since these name `BlockWorld`, and the other half of those files, on `World` and
## `Player`, should not depend on src/server/block.
##
## `UseWithItemArgs` is upstream's; what these read of it is `args.world` and `args.position`. What they do to the sign comes
## as a closure, since src/server/block/entities/sign.aowl sits above this: `text.set_color(DyeColor::from(color_name))`,
## `text.has_glowing_text.swap(v)` and `sign_entity.is_waxed.store(true)`.

import "../block/blockbehaviour"
import ../../generated/[sound, sound_category, world_event]

proc applyDyeToSign*(args: UseWithItemArgs; blockEntity: BlockEntity; setColor: proc() {.closure.}): BlockActionResult =
  ## `DyeItem::apply_to_sign`
  setColor()
  args.world.updateBlockEntity(blockEntity)
  args.world.playBlockSound(sdItemDyeUse, scBlocks, args.position)
  barSuccess

proc applyInkSacToSign*(args: UseWithItemArgs; blockEntity: BlockEntity; swapGlowing: proc(value: bool): bool {.closure.}): BlockActionResult =
  ## `InkSacItem::apply_to_sign`
  let changed = swapGlowing(false)
  if not changed:
    return barPassToDefaultBlockAction
  args.world.updateBlockEntity(blockEntity)
  args.world.playBlockSound(sdItemInkSacUse, scBlocks, args.position)
  barSuccess

proc applyGlowingInkSacToSign*(args: UseWithItemArgs; blockEntity: BlockEntity; swapGlowing: proc(value: bool): bool {.closure.}): BlockActionResult =
  ## `GlowingInkSacItem::apply_to_sign`
  let changed = not swapGlowing(true)
  if not changed:
    return barPassToDefaultBlockAction
  args.world.updateBlockEntity(blockEntity)
  args.world.playBlockSound(sdItemGlowInkSacUse, scBlocks, args.position)
  barSuccess

proc applyHoneyCombToSign*(args: UseWithItemArgs; blockEntity: BlockEntity; setWaxed: proc() {.closure.}): BlockActionResult =
  ## `HoneyCombItem::apply_to_sign`
  setWaxed()
  args.world.updateBlockEntity(blockEntity)
  args.world.syncWorldEvent(weParticlesAndSoundWaxOn, args.position, 0'i32)
  barSuccess
