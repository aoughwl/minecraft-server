import std/[math, options]
import "../../data/item_stack/mod"
import ../../data/block_ext
import ../../generated/[enchantment, sound, sound_category]
import ../../inventory/[inventory, player_inventory]
import ../../nbt/tag as nbttag
import ../../protocol/java/client/play/sound_effect
import ../../protocol/proto
import ../entity/player
import ../entity/projectile/[arrow, bobber_bullet, thrown, thrown_items]
import ../net/netbase
import ../world/chunker
import itembehaviour

type
  ArrowItem* = ref object of ItemBehaviour
  BowItem* = ref object of ItemBehaviour
  CrossbowItem* = ref object of ItemBehaviour
  EggItem* = ref object of ItemBehaviour
  EnderPearlItem* = ref object of ItemBehaviour
  SnowBallItem* = ref object of ItemBehaviour
  WindChargeItem* = ref object of ItemBehaviour
  PotionItem* = ref object of ItemBehaviour
  SplashPotionItem* = ref object of ItemBehaviour
  LingeringPotionItem* = ref object of ItemBehaviour
  FireworkRocketItem* = ref object of ItemBehaviour
  FishingRodItem* = ref object of ItemBehaviour
  TridentItem* = ref object of ItemBehaviour

const
  ThrowPower = 1.5'f32   ## `POWER` of egg.rs, snowball.rs and wind_charge.rs, and ender_pearl.rs's.
  PotionPower = 0.5'f32  ## `POWER` of potions.rs
  ThrowSoundVolume = 0.5'f32 ## `THROW_SOUND_VOLUME` of ender_pearl.rs
  BowUseDuration* = 72000'i32 ## `BowItem::USE_DURATION`: the maximum number of ticks a bow can be drawn for
  MaxDrawDuration = 20.0'f32
  ArrowSpeedMultiplier = 3.0'f32

# --- arrow.rs -------------------------------------------------------------------------------------------------------------------

let arrowItemVt = newItemVt()

proc newArrowItem*(): ArrowItem = ArrowItem(vt: arrowItemVt, ids: @[ITEM_ARROW.id])

# --- egg.rs ---------------------------------------------------------------------------------------------------------------------

let eggIds = @[ITEM_EGG.id, ITEM_BLUE_EGG.id, ITEM_BROWN_EGG.id]

proc makeEggVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let position = player.pos
    let world = player.world
    world.playSound(sdEntityEggThrow, scPlayers, position)
    # Capture the held item stack and pass it to the thrown egg entity
    let itemStack = player.inventory.heldItem()
    let shooter = entityOf(player)
    let entity = newEntity(world, position, EntityType.EGG)
    let egg = newEggShot(entity, shooter)
    # Propagate the item stack so clients show correct variant
    egg.setItemStack(itemStack)
    egg.setVelocityFrom(shooter, player.pitch, player.yaw, 0.0'f32, ThrowPower, 1.0'f32)
    spawnEntity(world, projectileBase(egg))
    # Consume item
    consumeFromHand(player, eggIds)

let eggItemVt = makeEggVt()

proc newEggItem*(): EggItem = EggItem(vt: eggItemVt, ids: eggIds)

# --- ender_pearl.rs -------------------------------------------------------------------------------------------------------------

proc makeEnderPearlVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let position = player.pos
    let world = player.world
    world.playSoundRaw(uint16(ord(sdEntityEnderPearlThrow)), scNeutral, position, ThrowSoundVolume,
      0.4'f32 / (randomF32() * 0.4'f32 + 0.8'f32))
    let shooter = entityOf(player)
    let entity = newEntity(world, position, EntityType.ENDER_PEARL)
    let pearl = newEnderPearlShot(entity, shooter)
    pearl.setVelocityFrom(shooter, player.pitch, player.yaw, 0.0'f32, ThrowPower, 1.0'f32)
    spawnEntity(world, projectileBase(pearl))
    # Consume item
    consumeFromHand(player, [ITEM_ENDER_PEARL.id])

let enderPearlItemVt = makeEnderPearlVt()

proc newEnderPearlItem*(): EnderPearlItem = EnderPearlItem(vt: enderPearlItemVt, ids: @[ITEM_ENDER_PEARL.id])

