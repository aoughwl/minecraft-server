# --- wind_charge.rs -------------------------------------------------------------------------------------------------------------

proc makeWindChargeVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let position = player.pos
    world.playSound(sdEntityWindChargeThrow, scNeutral, position)
    let shooter = entityOf(player)
    let entity = newEntity(world, position, EntityType.WIND_CHARGE)
    let windCharge = newWindChargeShot(entity, shooter)
    windCharge.setVelocityFrom(shooter, player.pitch, player.yaw, 0.0'f32, ThrowPower, 1.0'f32)
