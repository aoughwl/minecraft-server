# --- potions.rs -----------------------------------------------------------------------------------------------------------------

let potionItemVt = newItemVt() # Drinking is handled by the consumable flow in the server (active hand + consumption tick).

proc newPotionItem*(): PotionItem = PotionItem(vt: potionItemVt, ids: @[ITEM_POTION.id])

proc heldPotion(player: Player; id: uint16): (ItemStack, bool) =
  ## Copy the held item stack data into the projectile: which stack, and whether it is the main hand's.
  let main = player.inventory.heldItem()
  if not main.isEmpty() and main.item.id == id:
    return (main, true)
  let off = player.inventory.offHandItem()
  if not off.isEmpty() and off.item.id == id:
    return (off, false)
  (emptyItemStack(), true)

proc decrementUsed(player: Player; usedMain: bool) =
  ## Decrement the used stack (clear)
  if usedMain:
    var stack = player.inventory.heldItem()
    stack.decrementUnlessCreative(player.gamemode, 1'u8)
    player.inventory.setHeldItem(stack)
  else:
    var stack = player.inventory.offHandItem()
    stack.decrementUnlessCreative(player.gamemode, 1'u8)
    player.inventory.setOffHandItem(stack)

proc makeSplashPotionVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let position = player.pos
    let world = player.world
    world.playSound(sdEntityWitchThrow, scNeutral, position)
    let shooter = entityOf(player)
    let entity = newEntity(world, position, EntityType.SPLASH_POTION)
    let splash = newSplashPotionShot(entity, shooter)
    let (stack, usedMain) = heldPotion(player, ITEM_SPLASH_POTION.id)
    splash.setItemStack(stack)
    splash.setVelocityFrom(shooter, player.pitch, player.yaw, 0.0'f32, PotionPower, 1.0'f32)
    spawnEntity(world, projectileBase(splash))
    decrementUsed(player, usedMain)

let splashPotionItemVt = makeSplashPotionVt()

proc newSplashPotionItem*(): SplashPotionItem = SplashPotionItem(vt: splashPotionItemVt, ids: @[ITEM_SPLASH_POTION.id])

proc makeLingeringPotionVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let position = player.pos
    let world = player.world
    world.playSound(sdEntityWitchThrow, scNeutral, position)
    let shooter = entityOf(player)
    let entity = newEntity(world, position, EntityType.LINGERING_POTION)
    let ling = newLingeringPotionShot(entity, shooter)
    let (stack, usedMain) = heldPotion(player, ITEM_LINGERING_POTION.id)
    ling.setItemStack(stack)
    ling.setVelocityFrom(shooter, player.pitch, player.yaw, 0.0'f32, PotionPower, 1.0'f32)
    spawnEntity(world, projectileBase(ling))
    decrementUsed(player, usedMain)

let lingeringPotionItemVt = makeLingeringPotionVt()

proc newLingeringPotionItem*(): LingeringPotionItem =
  LingeringPotionItem(vt: lingeringPotionItemVt, ids: @[ITEM_LINGERING_POTION.id])

# --- firework_rocket.rs ---------------------------------------------------------------------------------------------------------

proc makeFireworkRocketVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    let entity = newEntity(world, Vector3[float64](
      x: float64(location.vec.x) + float64(cursorPos.x),
      y: float64(location.vec.y) + float64(cursorPos.y),
      z: float64(location.vec.z) + float64(cursorPos.z)), EntityType.FIREWORK_ROCKET)
    let rocket: EntityBase = newFireworkRocketEntity(entity)
    spawnEntity(world, rocket)
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let shooter = entityOf(player)
    if shooter.isFallFlying():
      let world = player.world
      let entity = newEntity(world, shooter.pos, EntityType.FIREWORK_ROCKET)
      let rocket: EntityBase = newFireworkRocketShot(entity, shooter)
      spawnEntity(world, rocket)

let fireworkRocketItemVt = makeFireworkRocketVt()

proc newFireworkRocketItem*(): FireworkRocketItem = FireworkRocketItem(vt: fireworkRocketItemVt, ids: @[ITEM_FIREWORK_ROCKET.id])

# --- fishing_rod.rs -------------------------------------------------------------------------------------------------------------

proc makeFishingRodVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let world = player.world
    let bobberId = player.fishingBobber
    if bobberId == -1'i32:
      # Cast
      world.playSound(sdEntityFishingBobberThrow, scNeutral, player.pos)
      let bobberEntity = newEntity(world, player.pos, EntityType.FISHING_BOBBER)
      let bobber = newFishingBobberEntity(bobberEntity, player)
      let lookVec = playerBase(player).getLookingVector()
      bobber.entity.velocity = lookVec.multiply(1.5'f64, 1.5'f64, 1.5'f64)
      player.fishingBobber = bobber.entity.entityId
      spawnEntity(world, projectileBase(bobber))
    else:
      # Reel in
      let bobberBase = world.getEntityById(bobberId)
      if bobberBase != nil:
        if bobberBase of FishingBobberEntity:
          let reeled = FishingBobberEntity(bobberBase)
          discard reeled.reelIn(player)
          # TODO upstream: give items
        bobberBase.entity.remove()
      player.fishingBobber = -1'i32
      world.playSound(sdEntityFishingBobberRetrieve, scNeutral, player.pos)

let fishingRodItemVt = makeFishingRodVt()

proc newFishingRodItem*(): FishingRodItem = FishingRodItem(vt: fishingRodItemVt, ids: @[ITEM_FISHING_ROD.id])

# --- bow.rs ---------------------------------------------------------------------------------------------------------------------

proc getPowerForTime*(timeHeld: int32): float32 =
  ## `get_power_for_time`: the power/charge of the bow based on time held
  var power = float32(timeHeld) / MaxDrawDuration
  power = (power * power + power * 2.0'f32) / 3.0'f32
  if power > 1.0'f32:
    power = 1.0'f32
  power

proc arrowPickupFor(player: Player): ArrowPickup =
  ## Determine pickup mode based on gamemode
  if player.gamemode == Creative: apCreativeOnly else: apAllowed

proc fireArrow*(player: Player; power: float32) =
  ## `fire_arrow`
  if power < 0.1'f32:
    return # Not enough charge
  let world = player.world
  let position = player.pos
  # Create arrow entity
  let arrowEntity = newEntity(world, position, EntityType.ARROW)
  let shot = newArrowShot(arrowEntity, entityOf(player), arrowPickupFor(player))
  # Read enchantments of the held item (bow)
  let stack = player.inventory.heldItem()
  let (has, enchantments) = stack.getDataComponent(EnchantmentsImpl)
  if has:
    for entry in enchantments.enchantment:
      if entry.enchantment.id == Enchantment.POWER.id:
        shot.baseDamage *= 1.0'f64 + 0.25'f64 * (float64(entry.level) + 1.0'f64)
      elif entry.enchantment.id == Enchantment.PUNCH.id:
        shot.punchLevel = uint8(entry.level)
      elif entry.enchantment.id == Enchantment.FLAME.id:
        shot.isFlame = true
  # Set velocity based on player's look direction and power
  let speed = power * ArrowSpeedMultiplier
  shot.setVelocityFromRotation(player.pitch, player.yaw, 0.0'f32, speed, 1.0'f32)
  # Set critical if fully charged
  if power >= 1.0'f32:
    shot.setCritical(true)
  # Spawn the arrow entity in the world
  spawnEntity(world, projectileBase(shot))
  # Play bow shoot sound
  let soundPitch = 1.0'f32 / (randomF32() * 0.4'f32 + 1.2'f32) + power * 0.5'f32
  broadcastSoundToChunk(entityOf(player), sdEntityArrowShoot, position, 1.0'f32, soundPitch)

proc releaseBow*(player: Player) =
  ## `release_bow`: called when the player releases the bow
  # Get the used ticks
  let useTicks = BowUseDuration - livingOf(player).itemUseTime
  # Check minimum draw time
  if useTicks < 3'i32:
    return
  # Check arrows again
  let arrowSlot = player.findArrow()
  let gamemode = player.gamemode
  if arrowSlot.isNone and gamemode != Creative:
    return
  # Calculate power and fire
  let power = getPowerForTime(useTicks)
  # Check for Infinity enchantment
  let hasInfinity = enchantmentLevelOf(player.inventory.heldItem(), Enchantment.INFINITY).isSome
  fireArrow(player, power)
  # Consume arrow (if not creative and no Infinity)
  if arrowSlot.isSome and gamemode != Creative and not hasInfinity:
    discard player.consumeArrow(arrowSlot.unsafeGet)
  # Damage bow
  discard player.damageHeldItem(1'i32)

proc makeBowVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    # Check if player has arrows (or is in creative mode)
    let hasArrows = player.findArrow().isSome
    if not hasArrows and player.gamemode != Creative:
      return
    # Get the held item stack
    let stack = player.inventory.heldItem()
    # Start the bow drawing animation
    livingOf(player).setActiveHand(hRight, stack, BowUseDuration)
  result.onStoppedUsing = proc(self: ItemBehaviour; stack: ItemStack; player: Player) {.closure.} =
    releaseBow(player)
  result.getUseDuration = proc(self: ItemBehaviour): int32 {.closure.} = BowUseDuration

let bowItemVt = makeBowVt()

proc newBowItem*(): BowItem = BowItem(vt: bowItemVt, ids: @[ITEM_BOW.id])

# --- crossbow.rs ----------------------------------------------------------------------------------------------------------------

proc fireProjectiles(player: Player) =
  ## `fire_projectiles`
  var stack = player.inventory.heldItem()
  let (hasCharged, charged) = stack.getDataComponent(ChargedProjectilesImpl)
  if hasCharged:
    let hasMultishot = enchantmentLevelOf(stack, Enchantment.MULTISHOT).isSome
    let world = player.world
    world.playSound(sdItemCrossbowShoot, scPlayers, player.pos)
    let yaw = player.yaw
    let pitch = player.pitch
    for projectile in charged.projectiles:
      let yaws = if hasMultishot: @[yaw - 10.0'f32, yaw, yaw + 10.0'f32] else: @[yaw]
      for tYaw in yaws:
        let arrowEntity = newEntity(world, player.pos, EntityType.ARROW)
        let shot = newArrowShot(arrowEntity, entityOf(player), arrowPickupFor(player))
        shot.setVelocityFromRotation(pitch, tYaw, 0.0'f32, 3.15'f32, 1.0'f32)
        spawnEntity(world, projectileBase(shot))
    var kept: seq[PatchEntry] = @[]
    for entry in stack.patch:
      if entry.id != dcChargedProjectiles:
        kept.add(entry)
    stack.patch = kept
    player.inventory.setHeldItem(stack)
    discard player.damageHeldItem(1'i32)

proc makeCrossbowVt(): ItemVt =
  result = newItemVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let stack = player.inventory.heldItem()
    let (hasCharged, ignored) = stack.getDataComponent(ChargedProjectilesImpl)
    discard ignored
    if hasCharged:
      fireProjectiles(player)
      return
    let hasArrows = player.findArrow().isSome
    if not hasArrows and player.gamemode != Creative:
      return
    livingOf(player).setActiveHand(hRight, stack, 72000'i32)
  result.onStoppedUsing = proc(self: ItemBehaviour; stack: ItemStack; player: Player) {.closure.} =
    let useTicks = 72000'i32 - livingOf(player).itemUseTime
    var chargeTime = 25'i32
    var held = player.inventory.heldItem()
    let (has, enchantments) = held.getDataComponent(EnchantmentsImpl)
    if has:
      for entry in enchantments.enchantment:
        if entry.enchantment.id == Enchantment.QUICK_CHARGE.id:
          chargeTime -= 5'i32 * int32(entry.level)
    chargeTime = max(chargeTime, 0'i32)
    if useTicks >= chargeTime:
      let arrowSlot = player.findArrow()
      var arrowNbt = NbtCompound()
      var hasArrowNbt = false
      var slot = 0
      if arrowSlot.isSome:
        slot = arrowSlot.unsafeGet
        player.inventory.getStack(slot).writeItemStack(arrowNbt)
        hasArrowNbt = true
      elif player.gamemode == Creative:
        newItemStack(1'u8, ITEM_ARROW).writeItemStack(arrowNbt)
        hasArrowNbt = true
      if hasArrowNbt:
        held.patch.add(PatchEntry(id: dcChargedProjectiles, present: true,
          data: toDyn(ChargedProjectilesImpl(projectiles: @[arrowNbt]))))
        player.inventory.setHeldItem(held)
        if player.gamemode != Creative:
          discard player.consumeArrow(slot)
        player.world.playSound(sdItemCrossbowLoadingEnd, scPlayers, player.pos)
    livingOf(player).clearActiveHand()
  result.getUseDuration = proc(self: ItemBehaviour): int32 {.closure.} = 72000'i32

let crossbowItemVt = makeCrossbowVt()

proc newCrossbowItem*(): CrossbowItem = CrossbowItem(vt: crossbowItemVt, ids: @[ITEM_CROSSBOW.id])

# --- trident.rs -----------------------------------------------------------------------------------------------------------------

proc makeTridentItemVt(): ItemVt =
  result = canMineUnlessCreativeVt()
  result.normalUse = proc(self: ItemBehaviour; item: Item; player: Player) {.closure.} =
    let stack = player.inventory.heldItem()
    livingOf(player).setActiveHand(hRight, stack, 72000'i32)
  result.onStoppedUsing = proc(self: ItemBehaviour; stack: ItemStack; player: Player) {.closure.} =
    let useTicks = 72000'i32 - livingOf(player).itemUseTime
    if useTicks < 10'i32:
      return
    let world = player.world
    let stackGuard = player.inventory.heldItem()
    # Check Riptide level
    var riptideLevel = 0'u32
    let (has, enchantments) = stackGuard.getDataComponent(EnchantmentsImpl)
    if has:
      for entry in enchantments.enchantment:
        if entry.enchantment.id == Enchantment.RIPTIDE.id:
          riptideLevel = uint32(entry.level)
    if riptideLevel > 0'u32:
      let shooter = entityOf(player)
      if shooter.touchingWater or world.weather.raining:
        let lookVec = rotationVector(float64(player.pitch), float64(player.yaw))
        let speed = mulAdd(float64(riptideLevel), 0.75'f64, 1.5'f64)
        let launchVelocity = lookVec.multiply(speed, speed, speed)
        shooter.setVelocity(launchVelocity)
        shooter.sendVelocity()
        let riptide = case riptideLevel
          of 1'u32: sdItemTridentRiptide1
          of 2'u32: sdItemTridentRiptide2
          else: sdItemTridentRiptide3
        world.playSound(riptide, scPlayers, player.pos)
        livingOf(player).clearActiveHand()
        if player.gamemode != Creative:
          discard player.damageHeldItem(1'i32)
        return
    # Normal throw
    let entity = newEntity(world, player.pos, EntityType.TRIDENT)
    let tridentEntity = newTridentShot(entity, entityOf(player), stackGuard, arrowPickupFor(player))
    tridentEntity.setVelocityFromRotation(player.pitch, player.yaw, 0.0'f32, 2.5'f32, 1.0'f32)
    spawnEntity(world, projectileBase(tridentEntity))
    world.playSound(sdItemTridentThrow, scPlayers, player.pos)
    if player.gamemode != Creative:
      let selectedSlot = int(player.inventory.getSelectedSlot())
      if player.inventory.getStack(selectedSlot).item.id == ITEM_TRIDENT.id:
        player.inventory.setStack(selectedSlot, emptyItemStack())
        player.syncHandSlot(selectedSlot, emptyItemStack())
      elif player.inventory.getStack(OffHandSlot).item.id == ITEM_TRIDENT.id:
        player.inventory.setStack(OffHandSlot, emptyItemStack())
        player.syncHandSlot(OffHandSlot, emptyItemStack())
    livingOf(player).clearActiveHand()
  result.getUseDuration = proc(self: ItemBehaviour): int32 {.closure.} = 72000'i32

let tridentItemVt = makeTridentItemVt()

proc newTridentItem*(): TridentItem = TridentItem(vt: tridentItemVt, ids: @[ITEM_TRIDENT.id])
