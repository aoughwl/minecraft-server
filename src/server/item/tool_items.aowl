proc equivalentIn(table: seq[(string, string)]; id: BlockId): Option[BlockId] =
  for entry in table:
    if blockNamed(entry[0]).id == id:
      return some(blockNamed(entry[1]).id)
  none[BlockId]()

proc getStrippedEquivalent*(id: BlockId): Option[BlockId] = equivalentIn(StrippedEquivalents, id)
proc getDeoxidizedEquivalent*(id: BlockId): Option[BlockId] = equivalentIn(DeoxidizedEquivalents, id)
proc getUnwaxedEquivalent*(id: BlockId): Option[BlockId] = equivalentIn(UnwaxedEquivalents, id)
proc getWaxedEquivalent*(id: BlockId): Option[BlockId] = equivalentIn(WaxedEquivalents, id)

proc tryUseAxe*(id: BlockId): Option[BlockId] =
  ## `try_use_axe`
  # Trying to get the strip equivalent
  let stripped = getStrippedEquivalent(id)
  if stripped.isSome:
    return stripped
  # Else decrease the level of oxidation
  let deoxidized = getDeoxidizedEquivalent(id)
  if deoxidized.isSome:
    return deoxidized
  # Else unwax the block
  getUnwaxedEquivalent(id)

proc doorStateOn(world: World; location: BlockPos; blockRef, newBlock: Block): BlockStateId =
  ## The door arm of axe.rs and honeycomb.rs.
  # get block state of the old door, and its properties
  let doorProps = OakDoorLikeProperties.fromStateId(world.stateIdAt(location), blockRef)
  # create new properties for the new door, with the old ones set on them
  var newDoorProperties = OakDoorLikeProperties.defaultFor(newBlock)
  newDoorProperties.facing = doorProps.facing
  newDoorProperties.open = doorProps.open
  newDoorProperties.half = doorProps.half
  newDoorProperties.hinge = doorProps.hinge
  newDoorProperties.powered = doorProps.powered
  newDoorProperties.toStateId(newBlock)

# --- axe.rs ---------------------------------------------------------------------------------------------------------------------

proc makeAxeVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    # I tried to follow mojang order of doing things.
    let world = player.world
    let replacementBlock = tryUseAxe(blockRef.id)
    # First we try to strip the block. by getting his equivalent and applying it the axis.
    var changed = false
    if replacementBlock.isSome:
      let newBlock = Block.fromId(replacementBlock.unsafeGet)
      # Bamboo blocks are pillars too, but they are not part of the logs tag.
      var newStateId = newBlock.defaultState.id
      if hasBlockTag(blockRef, Block_MINECRAFT_LOGS) or blockRef.id == blockNamed("bamboo_block").id:
        let logProps = PaleOakWoodLikeProperties.fromStateId(world.stateIdAt(location), blockRef)
        # create new properties for the new log, and set old axis to the new log.
        var newLogProperties = PaleOakWoodLikeProperties.defaultFor(newBlock)
        newLogProperties.axis = logProps.axis
        newStateId = newLogProperties.toStateId(newBlock)
      # Let's check if It's a door
      elif hasBlockTag(blockRef, Block_MINECRAFT_DOORS):
        newStateId = doorStateOn(world, location, blockRef, newBlock)
      # TODO upstream: Implements trapdoors when It's implemented
      setBlock(world, location, newStateId, BfNotifyAll)
      changed = true
    if changed and player.gamemode != Creative:
      # TODO upstream: Handle DamageResult::Broken to broadcast item break and update player slot.
      discard item.damageItem(1'i32)

let axeItemVt = makeAxeVt()

proc newAxeItem*(): AxeItem = AxeItem(vt: axeItemVt, ids: itemTagIds("minecraft:axes"))

# --- hoe.rs ---------------------------------------------------------------------------------------------------------------------

proc makeHoeVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    # Yes, Minecraft does hardcode these
    let grass = blockRef.id == blockNamed("grass_block").id
    let dirtPath = blockRef.id == blockNamed("dirt_path").id
    let dirt = blockRef.id == blockNamed("dirt").id
    let coarseDirt = blockRef.id == blockNamed("coarse_dirt").id
    let rootedDirt = blockRef.id == blockNamed("rooted_dirt").id
    if grass or dirtPath or dirt or coarseDirt or rootedDirt:
      var futureBlock = blockRef
      let world = player.world
      var changed = false
      # Only rooted can be right-clicked on the bottom of the block
      if face == BlockDirection.Down:
        if rootedDirt:
          futureBlock = blockNamed("dirt")
          changed = true
      else:
        # grass, dirt && dirt path become farmland
        if (grass or dirtPath or dirt) and BlockState.fromId(world.stateIdAt(location.up())).isAir:
          futureBlock = blockNamed("farmland")
          changed = true
        # Coarse dirt and rooted dirt become dirt
        elif coarseDirt or rootedDirt:
          futureBlock = blockNamed("dirt")
          changed = true
      # Vanilla returns PASS without touching the block when nothing is tilled,
      # otherwise the rewrite would reset properties such as `snowy` on grass blocks.
      if changed:
        setBlock(world, location, futureBlock.defaultState.id, BfNotifyAll)
      # Also rooted_dirt drop a hanging_root
      if rootedDirt:
        var dropAt = location.up().toF64()
        case face
        of BlockDirection.Up: discard
        of BlockDirection.Down: dropAt = location.down().toF64()
        of BlockDirection.North: dropAt = dropAt.addRaw(0.0'f64, -0.4'f64, -1.0'f64)
        of BlockDirection.South: dropAt = dropAt.addRaw(0.0'f64, -0.4'f64, 1.0'f64)
        of BlockDirection.West: dropAt = dropAt.addRaw(-1.0'f64, -0.4'f64, 0.0'f64)
        of BlockDirection.East: dropAt = dropAt.addRaw(1.0'f64, -0.4'f64, 0.0'f64)
        let entity = newEntity(world, dropAt, EntityType.ITEM)
        # TODO upstream: Merge stacks together
        let itemEntity: EntityBase = newItemEntity(entity, newItemStack(1'u8, ITEM_HANGING_ROOTS))
        spawnEntity(world, itemEntity)
      if changed and player.gamemode != Creative:
        # TODO upstream: Handle DamageResult::Broken to broadcast item break and update player slot.
        discard item.damageItem(1'i32)

let hoeItemVt = makeHoeVt()

proc newHoeItem*(): HoeItem = HoeItem(vt: hoeItemVt, ids: itemTagIds("minecraft:hoes"))

# --- shovel.rs ------------------------------------------------------------------------------------------------------------------

proc makeShovelVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    var changed = false
    # Yes, Minecraft does hardcode these
    let id = blockRef.id
    if (id == blockNamed("grass_block").id or id == blockNamed("dirt").id or id == blockNamed("coarse_dirt").id or
        id == blockNamed("rooted_dirt").id or id == blockNamed("podzol").id or id == blockNamed("mycelium").id) and
        face != BlockDirection.Down and BlockState.fromId(world.stateIdAt(location.up())).isAir:
      setBlock(world, location, blockNamed("dirt_path").defaultState.id, BfNotifyAll)
      changed = true
    if id == blockNamed("campfire").id or id == blockNamed("soul_campfire").id:
      var campfireProps = CampfireLikeProperties.fromStateId(world.stateIdAt(location), blockRef)
      if campfireProps.lit:
        syncWorldEvent(world, weSoundExtinguishFire, location, 0'i32)
        campfireProps.lit = false
        setBlock(world, location, campfireProps.toStateId(blockRef), BfNotifyAll)
        let seed = randomF64()
        # `player.play_sound`
        let sound = proto.IdOr[proto.SoundEvent](kind: iokId, id: uint16(ord(sdBlockFireExtinguish)))
        player.client.writePacketFor(newCSoundEffect(sound, scAmbient, location.toF64(), 0.5'f32, 2.0'f32, seed))
        changed = true
    if changed and player.gamemode != Creative:
      # TODO upstream: Handle DamageResult::Broken to broadcast item break and update player slot.
      discard item.damageItem(1'i32)

let shovelItemVt = makeShovelVt()

proc newShovelItem*(): ShovelItem = ShovelItem(vt: shovelItemVt, ids: itemTagIds("minecraft:shovels"))

# --- honeycomb.rs ---------------------------------------------------------------------------------------------------------------

proc makeHoneyCombVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let world = player.world
    # First we try to strip the block. by getting his equivalent and applying it the axis.
    let replacement = getWaxedEquivalent(blockRef.id)
    # If there is a strip equivalent.
    if replacement.isSome:
      let newBlock = Block.fromId(replacement.unsafeGet)
      var newStateId = newBlock.defaultState.id
      if hasBlockTag(blockRef, Block_MINECRAFT_DOORS):
        newStateId = doorStateOn(world, location, blockRef, newBlock)
      # TODO upstream: Implements trapdoors
      setBlock(world, location, newStateId, BfNotifyAll)

let honeyCombItemVt = makeHoneyCombVt()

proc newHoneyCombItem*(): HoneyCombItem = HoneyCombItem(vt: honeyCombItemVt, ids: @[ITEM_HONEYCOMB.id])

# --- swords.rs, mace.rs, dye.rs, ink_sac.rs, glowing_ink_sac.rs ------------------------------------------------------------------

let canMineVt = canMineUnlessCreativeVt()
let inkVt = newItemVt()

proc newSwordItem*(): SwordItem = SwordItem(vt: canMineVt, ids: itemTagIds("minecraft:swords"))
proc newMaceItem*(): MaceItem = MaceItem(vt: canMineVt, ids: @[ITEM_MACE.id])
proc newDyeItem*(): DyeItem = DyeItem(vt: canMineVt, ids: itemTagIds("c:dyes"))
proc newInkSacItem*(): InkSacItem = InkSacItem(vt: inkVt, ids: @[ITEM_INK_SAC.id])
proc newGlowingInkSacItem*(): GlowingInkSacItem = GlowingInkSacItem(vt: inkVt, ids: @[ITEM_GLOW_INK_SAC.id])

# --- ignite/ignition.rs ---------------------------------------------------------------------------------------------------------

proc canBeLit*(blockRef: Block; stateId: BlockStateId): Option[BlockStateId] =
  ## `can_be_lit`
  # Vanilla only lights the clicked block itself for campfires, candles and candle cakes.
  # See `CampfireBlock::canLight`, `CandleBlock::canLight` and `CandleCakeBlock::canLight`.
  # Everything else that merely carries a `lit` property (furnaces, redstone lamps, copper
  # bulbs, ...) must fall through to placing a fire block instead.
  if not hasBlockTag(blockRef, Block_MINECRAFT_CAMPFIRES) and not hasBlockTag(blockRef, Block_MINECRAFT_CANDLES) and
      not hasBlockTag(blockRef, Block_MINECRAFT_CANDLE_CAKES):
    return none[BlockStateId]()
  let (hasProps, dynProps) = blockRef.properties(stateId)
  if not hasProps:
    return none[BlockStateId]()
  var props = dynProps.toProps()
  var found = false
  for i in 0 ..< props.len:
    if props[i][0] == "lit":
      props[i] = ("lit", "true")
      found = true
      break
  if not found:
    return none[BlockStateId]()
  let newStateId = blockRef.fromProperties(props).toStateId(blockRef)
  if newStateId != stateId: some(newStateId) else: none[BlockStateId]()

proc igniteBlock(playSoundOnIgnite: bool; player: Player; location: BlockPos; face: BlockDirection; blockRef: Block): bool =
  ## `Ignition::ignite_block`. Both callers' `ignite_logic` set the state; the fire charge's also plays its sound.
  let world = player.world
  let pos = location.offset(face.toOffset())
  if world.getFluid(location).name != Fluid.EMPTY.name:
    return false
  let lit = canBeLit(blockRef, world.stateIdAt(location))
  var target = location
  var newStateId = world.stateIdAt(location)
  if lit.isSome:
    newStateId = lit.unsafeGet
  elif gItemHooks.canPlaceFireAt(world, pos):
    target = pos
    newStateId = gItemHooks.fireStateAt(world, pos)
  else:
    return false
  setBlock(world, target, newStateId, BfNotifyAll)
  if playSoundOnIgnite:
    playBlockSound(world, sdItemFirechargeUse, scBlocks, target)
  true

# --- ignite/fire_charge.rs ------------------------------------------------------------------------------------------------------

proc makeFireChargeVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    discard igniteBlock(true, player, location, face, blockRef)

let fireChargeItemVt = makeFireChargeVt()

proc newFireChargeItem*(): FireChargeItem = FireChargeItem(vt: fireChargeItemVt, ids: @[ITEM_FIRE_CHARGE.id])

# --- ignite/flint_and_steel.rs --------------------------------------------------------------------------------------------------

proc makeFlintAndSteelVt(): ItemVt =
  result = newItemVt()
  result.useOnBlock = proc(self: ItemBehaviour; item: var ItemStack; player: Player; location: BlockPos; face: BlockDirection;
      cursorPos: Vector3[float32]; blockRef: Block; server: Server) {.closure.} =
    let ignited = igniteBlock(false, player, location, face, blockRef)
    if ignited and player.gamemode != Creative:
      # TODO upstream: Handle DamageResult::Broken to broadcast item break and update player slot.
      discard item.damageItem(1'i32)

let flintAndSteelItemVt = makeFlintAndSteelVt()

proc newFlintAndSteelItem*(): FlintAndSteelItem = FlintAndSteelItem(vt: flintAndSteelItemVt, ids: @[ITEM_FLINT_AND_STEEL.id])
