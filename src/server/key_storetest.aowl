## `KeyStore`: SHA-1 and the server hash against known answers, the DER shape, and a decrypt with a fixed key.
import std/[assertions, options, syncio]
import bignum
import key_store

proc bytesOf(s: string): seq[byte] =
  result = newSeq[byte](s.len)
  for i in 0 ..< s.len:
    result[i] = byte(ord(s[i]))

proc hexOf(a: openArray[byte]): string =
  const Hex = "0123456789abcdef"
  result = ""
  for b in a:
    result.add(Hex[int(b shr 4)])
    result.add(Hex[int(b and 0x0F'u8)])

# FIPS 180 vectors.
assert hexOf(sha1(bytesOf("abc"))) == "a9993e364706816aba3e25717850c26c9cd0d89d"
assert hexOf(sha1(bytesOf(""))) == "da39a3ee5e6b4b0d3255bfef95601890afd80709"
assert hexOf(sha1(bytesOf("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))) ==
  "84983e441c3bd26ebaae4aa1f95129e5e54670f1"

# The three well-known digests from wiki.vg's protocol encryption page.
assert authDigest(sha1(bytesOf("Notch"))) == "4ed1f46bbe04bc756bcb17c0c7ce3e4632f06a48"
assert authDigest(sha1(bytesOf("jeb_"))) == "-7c9d5b0044c130109a5d7b5fb5c317c02b4e28c1"
assert authDigest(sha1(bytesOf("simon"))) == "88e16a1019277b15d58faf0541e11910eb756f6"

# Two 512-bit primes, the top bits set, known prime.
const
  PHex = "fb1d4e0e5a9d0e7f1b8a2ed6f60b7dc4c6f5cd0ba3f9a65fa3e6a0cbb1fb1d5e5b0e1d5e2fcb1a0f7e0ba5f6f4d8c7d3e9a1b6f3c8d4a2e1f7b9c5d3a1e7f18f"

proc fromHex(s: string): BigInt =
  var bytes: seq[byte] = @[]
  var i = 0
  while i + 1 < s.len:
    var v = 0
    for j in 0 .. 1:
      let c = s[i + j]
      v = v * 16 + (if c >= 'a': ord(c) - ord('a') + 10 else: ord(c) - ord('0'))
    bytes.add(byte(v))
    i += 2
  bnFromBytesBE(bytes)

proc nextPrimeFrom(start: BigInt): BigInt =
  ## Deterministic: the first probable prime at or above an odd start, by the fast test only.
  result = start
  let two = bnFromU32(2'u32)
  let a = bnFromU32(2'u32)
  while true:
    let minusOne = bnSub(result, bnFromU32(1'u32))
    if bnCmp(fastModPow(a, minusOne, result), bnFromU32(1'u32)) == 0:
      return result
    result = bnAdd(result, two)

let p = nextPrimeFrom(fromHex(PHex))
let q = nextPrimeFrom(bnAdd(p, bnFromU32(0x10000'u32)))
let store = keyFromPrimes(p, q)

# The SPKI starts with a SEQUENCE around the rsaEncryption AlgorithmIdentifier.
assert store.publicKeyDer[0] == 0x30'u8
assert hexOf(store.publicKeyDer[3 .. 17]) == "300d06092a864886f70d0101010500" or
  hexOf(store.publicKeyDer[2 .. 16]) == "300d06092a864886f70d0101010500"

# PKCS#1 v1.5 by hand with the public key, then decrypt.
proc encryptWith(s: KeyStore; message: openArray[byte]): seq[byte] =
  let k = (bnBitLen(s.n) + 7) div 8
  var em = newSeq[byte](k)
  em[1] = 2'u8
  for i in 2 ..< k - message.len - 1:
    em[i] = byte(0x11 + (i mod 200))
  em[k - message.len - 1] = 0'u8
  for i in 0 ..< message.len:
    em[k - message.len + i] = message[i]
  bnToBytesBE(fastModPow(bnFromBytesBE(em), bnFromU32(65537'u32), s.n), k)

let secret = bytesOf("sixteen byte key")
let opened = store.decrypt(encryptWith(store, secret))
assert opened.isSome
assert opened.unsafeGet == secret

# Bad input: wrong length, and a block that is not v1.5.
assert store.decrypt(secret).isNone
var noise = encryptWith(store, secret)
noise[10] = noise[10] xor 0xFF'u8
assert store.decrypt(noise).isNone

echo "key_store ok"
