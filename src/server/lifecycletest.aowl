## Test for the server lifecycle pieces: can_not_join's three halves, the IP helpers, the player list setters' bytes and
## the statistics in a player's NBT. tools/mcbot.py is the end-to-end check (ban, whitelist, kick, player list, restart).
import std/[assertions, options, syncio, strutils]
import ../generated/statistic
import ../generated/translation as tr
import ../nbt/tag
import ../util/text/text
import ../util/uuid
import ../world/playerdata
import key_store
import recipe
import scheduler
import tick_rate_manager
import data/datamod
import serverbase
import servermod
import entity/player/statistics
import net/netbase

proc newServer(): Server =
  var advanced = defaultAdvancedConfiguration()
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: advanced, worlds: @[], dimensions: @[],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc profile(name: string; hi: uint64): GameProfile =
  GameProfile(id: Uuid(hi: hi, lo: 7'u64), name: name, properties: @[], profileActions: @[])

proc testScrub() =
  assert scrubAddress("192.168.0.12") == "xxx.xxx.x.xx"
  assert scrubAddress("::1") == "::x"
  assert scrubAddress("") == ""

proc testParseIp() =
  var ip = ""
  assert parseIpv4("127.0.0.1", ip) and ip == "127.0.0.1"
  assert parseIpv4("10.20.30.255", ip) and ip == "10.20.30.255"
  assert not parseIpv4("256.0.0.1", ip)
  assert not parseIpv4("01.2.3.4", ip)
  assert not parseIpv4("1.2.3", ip)
  assert not parseIpv4("1.2.3.4.5", ip)
  assert not parseIpv4("a.b.c.d", ip)
  assert not parseIpv4("", ip)
  assert not parseIpv4("1..3.4", ip)

proc testCanNotJoin() =
  let server = newServer()
  server.data = ServerData()
  let steve = profile("Steve", 1'u64)
  let alex = profile("Alex", 2'u64)
  # nothing set: everybody may join
  assert server.canNotJoin(steve, "10.0.0.1").isNone
  # a player ban, forever
  server.data.bannedPlayerList.bannedPlayers.add(BannedPlayerEntry(uuid: steve.id, name: "Steve", created: nowUtcSeconds(),
    source: "Console", expires: NoExpiry, reason: "griefing"))
  let banned = server.canNotJoin(steve, "10.0.0.1")
  assert banned.isSome
  assert banned.unsafeGet.getText().len >= 0
  assert server.canNotJoin(alex, "10.0.0.1").isNone
  # a ban that has run out is dropped, and the player may join
  server.data.bannedPlayerList.bannedPlayers[0].expires = nowUtcSeconds() - 10'i64
  assert server.canNotJoin(steve, "10.0.0.1").isNone
  # whitelist: off lets everyone in, on keeps out the unlisted, lets in an op and a listed name
  server.basicConfig.whiteList = true
  assert server.canNotJoin(alex, "10.0.0.1").isSome
  server.data.whitelistConfig.whitelist.add(newWhitelistEntry(alex.id, "Alex"))
  assert server.canNotJoin(alex, "10.0.0.1").isNone
  assert server.canNotJoin(steve, "10.0.0.1").isSome
  server.data.operatorConfig.ops.add(newOp(steve.id, "Steve", Four, false))
  assert server.canNotJoin(steve, "10.0.0.1").isNone
  server.basicConfig.whiteList = false
  # an IP ban catches whatever name comes from that address
  server.data.bannedIpList.bannedIps.add(BannedIpEntry(ip: "10.0.0.9", created: nowUtcSeconds(), source: "Console",
    expires: NoExpiry, reason: "spam"))
  assert server.canNotJoin(alex, "10.0.0.9").isSome
  assert server.canNotJoin(alex, "10.0.0.8").isNone

proc testStats() =
  var stats = Statistics()
  stats.incrementCustom(csPlayTime, 5'i32)
  stats.increment(scMined, 12'i32, 3'i32)
  stats.set(scCustom, int32(ord(csLeaveGame)), 2'i32)
  var nbt = newCompound()
  stats.writeNbt(nbt)
  var back = Statistics()
  back.readNbt(nbt)
  assert back.get(scCustom, int32(ord(csPlayTime))) == 5'i32
  assert back.get(scMined, 12'i32) == 3'i32
  assert back.get(scCustom, int32(ord(csLeaveGame))) == 2'i32
  assert back.stats.len == 3

testScrub()
testParseIp()
testCanNotJoin()
testStats()
echo "lifecycletest ok"
