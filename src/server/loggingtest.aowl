## Test for logging.aowl: the exact console and file lines, the level filter, the gzip names, and a real log file that is
## rolled into a gzip that reads back.

import std/[assertions, syncio, os, envvars]
from std/paths import path, Path
import std/dirs
import ../config/logging as logconfig
import ../nbt/zlibgz
import logging

proc scratchDir(name: string): string =
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  result = base & "/" & name
  discard tryCreateFinalDir(path(result))
  assert dirExists(result), result

proc slurp(p: string): string =
  result = ""
  try:
    result = readFile(p)
  except ErrorCode:
    assert false, "cannot read " & p

proc run() =
  let t = DateTime(year: 2026, month: 11, day: 9, hour: 14, minute: 5, second: 7)
  assert formatConsoleLine(t, true, false, true, llInfo, "pumpkin", "Server is now running") ==
    "2026-11-09 14:05:07  INFO main ThreadId(01) pumpkin: Server is now running"
  assert formatConsoleLine(t, true, false, false, llError, "pumpkin::net", "boom") ==
    "2026-11-09 14:05:07 ERROR pumpkin::net: boom"
  assert formatConsoleLine(t, false, false, false, llWarn, "x", "m") == " WARN x: m"
  assert formatConsoleLine(t, true, true, false, llDebug, "x", "m") ==
    "\x1b[2m2026-11-09 14:05:07\x1b[0m \x1b[34mDEBUG\x1b[0m \x1b[2mx\x1b[0m\x1b[2m:\x1b[0m m"

  assert stripAnsi("\x1b[31mred\x1b[0m and \x1b[1;32mgreen\x1b[0m") == "red and green"
  assert stripAnsi("plain") == "plain"
  assert formatFileLine(llWarn, "\x1b[33mcareful\x1b[0m") == "[WARN] careful"

  assert parseFilter("INFO") == (true, lfInfo)
  assert parseFilter("trace") == (true, lfTrace)
  assert parseFilter("off") == (true, lfOff)
  assert parseFilter("4") == (true, lfDebug)
  assert not parseFilter("loud")[0]
  assert shown(lfInfo, llError) and shown(lfInfo, llWarn) and shown(lfInfo, llInfo)
  assert not shown(lfInfo, llDebug) and not shown(lfInfo, llTrace)
  assert shown(lfTrace, llTrace) and not shown(lfOff, llError)

  assert dateStamp(yesterday(DateTime(year: 2026, month: 3, day: 1, hour: 0, minute: 0, second: 0))) == "2026-02-28"
  assert dateStamp(yesterday(DateTime(year: 2028, month: 3, day: 1, hour: 0, minute: 0, second: 0))) == "2028-02-29"
  assert dateStamp(yesterday(DateTime(year: 2026, month: 1, day: 1, hour: 0, minute: 0, second: 0))) == "2025-12-31"
  assert dateStamp(yesterday(DateTime(year: 2026, month: 5, day: 1, hour: 0, minute: 0, second: 0))) == "2026-04-30"
  assert dateStamp(yesterday(t)) == "2026-11-08"

  logDir = "logs"
  var seen: seq[string] = @[]
  let taken = proc(path: string): bool {.closure.} =
    path == "logs/2026-11-08-1.log.gz" or path == "logs/2026-11-08-2.log.gz"
  assert newGzFilename(yesterday(t), taken) == "logs/2026-11-08-3.log.gz"

  # A real file: the logger writes `[LEVEL] text` lines, a second start rolls the first into a gzip.
  let dir = scratchDir("logtest") & "/logs"
  discard tryCreateFinalDir(path(dir))
  try:
    for old in ["latest.log", "x"]:
      if fileExists(dir & "/" & old):
        removeFile(path(dir & "/" & old))
  except ErrorCode:
    discard
  logDir = dir
  var config = defaultLoggingConfig()
  config.color = false
  initLogger(config)
  info("first line")
  warn("\x1b[31msecond\x1b[0m line")
  debug("hidden at the default level")
  closeLogger()
  assert slurp(dir & "/latest.log") == "[INFO] first line\n[WARN] second line\n"
  initLogger(config)
  info("after the restart")
  closeLogger()
  assert slurp(dir & "/latest.log") == "[INFO] after the restart\n"
  # The first file is now a gzip named for yesterday, and it reads back to the same text.
  var found = ""
  let y = yesterday(utcNow())
  for id in 1 .. 50:
    let candidate = dir & "/" & dateStamp(y) & "-" & $id & ".log.gz"
    if fileExists(candidate):
      found = candidate
  assert found.len > 0, "no rolled gzip in " & dir
  let packed = slurp(found)
  var bytes = newSeq[byte](packed.len)
  for i in 0 ..< packed.len:
    bytes[i] = byte(packed[i])
  let back = gzipDecompressBytes(bytes, 1 shl 20)
  assert back.ok
  var text = ""
  for b in back.data:
    text.add(char(b))
  assert text == "[INFO] first line\n[WARN] second line\n"
  echo "loggingtest ok"

run()
