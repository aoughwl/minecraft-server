## Test for authentication.aowl: the profile JSON, the session request over a stand-in transport, texture validation,
## and an RSA PKCS#1 v1.5 SHA-1 signature made by OpenSSL, checked through the DER key and through `fetchMojangPublicKeys`.

import std/[assertions, options, syncio]
import ../../auth/winhttp
import ../../config/networking/auth except ProfileAction
import ../../util/uuid
import authentication
import netbase

const
  KeyB64 = "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCy8xTGpQN53/ZXwqcR7CGO7DJosqGtFYa6t+Oohl8Y4lFMKICVKz301ge+m830e054wk4EeSTqq1kjfkG7/lAsmh18SO1YDqN91mq24xbxkSNfW1OCrtovJJAWHcPln3mM2hiZksTfl5RL+Nf7eb+hXyAUw/RPUsDw0UsGSkENTQIDAQAB"
  SigB64 = "E9k57clWUV45MBevQ1I/E/k2oaQuD4HivmqJSceERqzrJdmIG6fhgTb1Xi3I5WpPMPyuvGVydnpEJOHoMJ1DApY3C2WxzhYTVKjBs6U3mV7XaBBzZgz67SX/Ck7By3vxgwTaPAo+T2EeEzEzNq5eU6XbtPECkN5UxSZxRx7YhDY="
  TexGood = "eyJ0aW1lc3RhbXAiOjAsInByb2ZpbGVJZCI6IjA2OWE3OWY0NDRlOTQ3MjZhNWJlZmNhOTBlMzhhYWY1IiwicHJvZmlsZU5hbWUiOiJOb3RjaCIsInRleHR1cmVzIjp7IlNLSU4iOnsidXJsIjoiaHR0cDovL3RleHR1cmVzLm1pbmVjcmFmdC5uZXQvdGV4dHVyZS9hYmMifX19"
  TexBadDomain = "eyJ0aW1lc3RhbXAiOjAsInByb2ZpbGVJZCI6IjA2OWE3OWY0NDRlOTQ3MjZhNWJlZmNhOTBlMzhhYWY1IiwicHJvZmlsZU5hbWUiOiJOb3RjaCIsInRleHR1cmVzIjp7IlNLSU4iOnsidXJsIjoiaHR0cDovL2V2aWwuZXhhbXBsZS5jb20veCJ9fX0="
  TexBadScheme = "eyJ0aW1lc3RhbXAiOjAsInByb2ZpbGVJZCI6IjA2OWE3OWY0NDRlOTQ3MjZhNWJlZmNhOTBlMzhhYWY1IiwicHJvZmlsZU5hbWUiOiJOb3RjaCIsInRleHR1cmVzIjp7IlNLSU4iOnsidXJsIjoiZnRwOi8vdGV4dHVyZXMubWluZWNyYWZ0Lm5ldC94In19fQ=="
  TexNoProfileId = "eyJ0aW1lc3RhbXAiOjAsInByb2ZpbGVOYW1lIjoiTm90Y2giLCJ0ZXh0dXJlcyI6e319"
  TexSigRequired = "eyJ0aW1lc3RhbXAiOjAsInByb2ZpbGVJZCI6IjA2OWE3OWY0NDRlOTQ3MjZhNWJlZmNhOTBlMzhhYWY1IiwicHJvZmlsZU5hbWUiOiJOb3RjaCIsInNpZ25hdHVyZVJlcXVpcmVkIjp0cnVlLCJ0ZXh0dXJlcyI6e319"

proc bytesOf(s: string): seq[byte] =
  result = @[]
  for c in s:
    result.add(byte(c))

proc contains(s, sub: string): bool =
  if s.len < sub.len:
    return false
  for i in 0 .. s.len - sub.len:
    if s[i ..< i + sub.len] == sub:
      return true
  false

proc run() =
  # base64, as the `base64` crate's STANDARD engine.
  assert base64Decode("TWFu") == (true, bytesOf("Man"))
  assert base64Decode("TWE=") == (true, bytesOf("Ma"))
  assert base64Decode("TQ==") == (true, bytesOf("M"))
  assert base64Decode("") == (true, newSeq[byte]())
  assert not base64Decode("TWE")[0]
  assert not base64Decode("T*Fu")[0]
  assert not base64Decode("TW=u")[0]

  assert urlEncode("Steve_1") == "Steve_1"
  assert urlEncode("a b&c") == "a%20b%26c"

  # The profile.
  let body = "{\"id\":\"069a79f444e94726a5befca90e38aaf5\",\"name\":\"Notch\",\"properties\":[{\"name\":\"textures\",\"value\":\"" &
    TexGood & "\",\"signature\":\"c2ln\"}]}"
  let (ok, profile) = gameProfileFromJson(body)
  assert ok
  assert profile.name == "Notch"
  assert $profile.id == "069a79f4-44e9-4726-a5be-fca90e38aaf5"
  assert profile.properties.len == 1 and profile.properties[0].name == "textures" and profile.properties[0].signature == "c2ln"
  assert profile.profileActions.len == 0
  assert not gameProfileFromJson("{\"id\":\"zz\",\"name\":\"a\"}")[0]
  assert not gameProfileFromJson("{\"name\":\"a\"}")[0]
  assert not gameProfileFromJson("[]")[0]
  let (ok2, withActions) = gameProfileFromJson("{\"id\":\"069a79f444e94726a5befca90e38aaf5\",\"name\":\"N\",\"properties\":[],\"profileActions\":[\"USING_BANNED_SKIN\"]}")
  assert ok2 and withActions.profileActions == @[paUsingBannedSkin]

  # The request.
  var config = defaultAuthenticationConfig()
  let good = newFakeTransport(200, body)
  let r = authenticate(good, "Notch", "-1a2b", "10.0.0.1", config)
  assert r.ok and r.profile.name == "Notch"
  assert good.urls == @["https://sessionserver.mojang.com/session/minecraft/hasJoined?username=Notch&serverId=-1a2b"]
  config.url = some("http://127.0.0.1:9/h?u={username}&s={server_hash}")
  let custom = newFakeTransport(200, body)
  assert authenticate(custom, "Notch", "ff", "1.2.3.4", config).ok
  assert custom.urls == @["http://127.0.0.1:9/h?u=Notch&s=ff"]
  config.preventProxyConnections = true
  config.preventProxyConnectionAuthUrl = some("http://p/h?u={username}&s={server_hash}&ip={ip}")
  let proxy = newFakeTransport(200, body)
  assert authenticate(proxy, "Notch", "ff", "1.2.3.4", config).ok
  assert proxy.urls == @["http://p/h?u=Notch&s=ff&ip=1.2.3.4"]
  config = defaultAuthenticationConfig()
  assert authenticate(newFakeTransport(204, ""), "N", "x", "i", config).error.kind == aeUnverifiedUsername
  assert authenticate(newDownTransport(), "N", "x", "i", config).error.kind == aeFailedResponse
  let unknown = authenticate(newFakeTransport(503, ""), "N", "x", "i", config)
  assert unknown.error.kind == aeUnknownStatusCode and unknown.error.message == "Unknown Status Code 503"
  assert authenticate(newFakeTransport(200, "{not json"), "N", "x", "i", config).error.kind == aeFailedParse

  # Textures.
  let tc = defaultTextureConfig()
  assert validateTextures(PropertyValue(name: "textures", value: TexGood, signature: ""), tc)[0]
  let bd = validateTextures(PropertyValue(name: "textures", value: TexBadDomain, signature: ""), tc)
  assert not bd[0] and bd[1].kind == teDisallowedUrlDomain and bd[1].message == "evil.example.com"
  let bs = validateTextures(PropertyValue(name: "textures", value: TexBadScheme, signature: ""), tc)
  assert not bs[0] and bs[1].kind == teDisallowedUrlScheme
  assert validateTextures(PropertyValue(name: "textures", value: TexNoProfileId, signature: ""), tc)[1].kind == teJsonError
  assert validateTextures(PropertyValue(name: "textures", value: TexSigRequired, signature: ""), tc)[0]
  assert validateTextures(PropertyValue(name: "textures", value: "%%%%", signature: ""), tc)[1].kind == teDecodeError
  assert isTextureUrlValid("https://textures.minecraft.net/texture/a", tc)[0]
  assert not isTextureUrlValid("nonsense", tc)[0]

  # `checkProfile`: the actions, then the textures.
  assert checkProfile(profile, config).ok
  var banned = profile
  banned.profileActions = @[paUsingBannedSkin]
  assert checkProfile(banned, config).error.kind == aeBanned
  config.playerProfile.allowBannedPlayers = true
  assert checkProfile(banned, config).error.kind == aeDisallowedAction  # FORCED_NAME_CHANGE is allowed but absent
  banned.profileActions = @[paForcedNameChange, paUsingBannedSkin]
  assert checkProfile(banned, config).error.kind == aeBanned
  var badTex = profile
  badTex.properties = @[PropertyValue(name: "textures", value: TexBadDomain, signature: "")]
  let bt = checkProfile(badTex, config)
  assert bt.error.kind == aeTextureError and contains(bt.error.message, "evil.example.com")

  # RSA: a key and a signature OpenSSL made over "aowlmony chat key".
  let (keyOk, der) = base64Decode(KeyB64)
  let (sigOk, sig) = base64Decode(SigB64)
  assert keyOk and sigOk and der.len == 162 and sig.len == 128
  let (spkiOk, n, e) = parseSpki(der)
  assert spkiOk and n.len == 128 and n[0] == 0xB2'u8 and e == @[1'u8, 0'u8, 1'u8]
  let message = bytesOf("aowlmony chat key")
  assert rsaVerifySha1(der, message, sig)
  assert not rsaVerifySha1(der, bytesOf("aowlmony chat kez"), sig)
  var flipped = sig
  flipped[5] = flipped[5] xor 1'u8
  assert not rsaVerifySha1(der, message, flipped)
  assert not rsaVerifySha1(der, message, sig[0 ..< 127])
  assert not rsaVerifySha1(sig, message, sig)

  # `fetchMojangPublicKeys`, on a canned answer.
  let keysBody = "{\"profilePropertyKeys\":[{\"publicKey\":\"" & KeyB64 & "\"}],\"playerCertificateKeys\":[{\"publicKey\":\"" &
    KeyB64 & "\"}],\"authenticationKeys\":[]}"
  let keyTransport = newFakeTransport(200, keysBody)
  let keys = fetchMojangPublicKeys(keyTransport, defaultAuthenticationConfig())
  assert keys.ok and keys.keys.len == 1 and keys.keys[0] == der
  assert keyTransport.urls == @["https://api.minecraftservices.com/publickeys"]
  assert not fetchMojangPublicKeys(newFakeTransport(200, "{}"), defaultAuthenticationConfig()).ok
  assert fetchMojangPublicKeys(newFakeTransport(500, ""), defaultAuthenticationConfig()).error.kind == aeUnknownStatusCode
  assert fetchMojangPublicKeys(newDownTransport(), defaultAuthenticationConfig()).error.kind == aeFailedResponse

  # `lookupProfileByName`.
  let named = lookupProfileByName(newFakeTransport(200, "{\"id\":\"069a79f444e94726a5befca90e38aaf5\",\"name\":\"Notch\"}"), "notch")
  assert named.ok and named.found and named.name == "Notch"
  assert lookupProfileByName(newFakeTransport(404, ""), "x").found == false
  assert lookupProfileByName(newFakeTransport(404, ""), "x").ok
  assert not lookupProfileByName(newDownTransport(), "x").ok
  echo "authenticationtest ok"

run()
