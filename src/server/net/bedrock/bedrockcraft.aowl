## Port of the `BEDROCK_CRAFTING_DATA` initialiser in `World::spawn_bedrock_player` (pumpkin/src/world/mod.rs): the crafting
## recipes (shaped and shapeless) as Bedrock recipes, sent once to a joining client in `CCraftingData`.
##
## An ingredient is named by one item: a tag by its first item, a list by its first entry (the Bedrock descriptor has no
## tag form here, as upstream); an ingredient whose item has no Bedrock twin is the empty descriptor.
import std/[options]
import ../../../protocol/varint
import ../../../protocol/bedrock/network_item
import ../../../protocol/bedrock/client/crafting_data
import ../../../generated/[recipes, item_full, tag]

var gBedrockRecipes: seq[BedrockRecipe] = @[]
var gBedrockRecipesBuilt = false

proc stripMinecraft(key: string): string =
  if key.len > 10 and key[0 ..< 10] == "minecraft:": key[10 ..< key.len] else: key

proc emptyIngredient(): ItemDescriptorCount =
  ItemDescriptorCount(networkId: 0'i16, metadataValue: 0'i16, count: 0'i32)

proc mapIngredient*(ing: RecipeIngredient): ItemDescriptorCount =
  ## `map_ingredient`.
  var key = ""
  case ing.kind
  of rikSimple:
    key = ing.name
  of rikTagged:
    let tagName = if ing.name.len > 0 and ing.name[0] == '#': ing.name[1 ..< ing.name.len] else: ing.name
    let (found, ids) = getTagIds(rkItem, tagName)
    if found and ids.len > 0:
      let first = Item.fromId(ids[0])
      if first != nil:
        key = first.registryKey
  of rikOneOf:
    if ing.options.len > 0:
      key = ing.options[0]
  if key.len > 0:
    let item = Item.fromRegistryKey(stripMinecraft(key))
    if item != nil:
      let mapping = JavaToBedrockItemMapping.fromJavaItemId(item.id)
      if mapping != nil:
        return ItemDescriptorCount(networkId: mapping.bedrockItem.id, metadataValue: int16(mapping.bedrockData), count: 1'i32)
  emptyIngredient()

proc outputDescriptor(recipeResult: RecipeResult): (bool, NetworkItemDescriptor) =
  let item = Item.fromRegistryKey(stripMinecraft(recipeResult.id))
  if item == nil:
    return (false, defaultNetworkItemDescriptor())
  let mapping = JavaToBedrockItemMapping.fromJavaItemId(item.id)
  if mapping == nil:
    return (false, defaultNetworkItemDescriptor())
  var d = defaultNetworkItemDescriptor()
  d.id = newVarInt(int32(mapping.bedrockItem.id))
  d.stackSize = uint16(recipeResult.count)
  d.auxValue = newVarUInt(mapping.bedrockData)
  d.blockRuntimeId = newVarInt(int32(mapping.bedrockBlockState))
  (true, d)

proc bedrockCraftingRecipes*(): seq[BedrockRecipe] =
  ## The recipes, built on first use.
  if gBedrockRecipesBuilt:
    return gBedrockRecipes
  var mapped: seq[BedrockRecipe] = @[]
  var networkId = 1'u32
  for recipe in RECIPES_CRAFTING:
    case recipe.kind
    of crkCraftingShaped:
      let r = recipe.shaped
      let height = r.pattern.len
      var width = 0
      for row in r.pattern:
        width = max(width, row.len)
      var input: seq[ItemDescriptorCount] = @[]
      for row in 0 ..< height:
        let patternRow = r.pattern[row]
        for c in 0 ..< width:
          let ch = if c < patternRow.len: patternRow[c] else: ' '
          if ch == ' ':
            input.add(emptyIngredient())
          else:
            var found = false
            for k in 0 ..< r.keyChars.len:
              if r.keyChars[k] == ch:
                input.add(mapIngredient(r.keyIngredients[k]))
                found = true
                break
            if not found:
              input.add(emptyIngredient())
      let (ok, output) = outputDescriptor(r.result)
      if ok:
        mapped.add(BedrockRecipe(kind: brShaped, shaped: BedrockShapedRecipe(recipeId: "pumpkin:recipe_" & $networkId,
          width: newVarInt(int32(width)), height: newVarInt(int32(height)), input: input, output: @[output],
          uuid: [0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8],
          blockName: "crafting_table", priority: newVarInt(1'i32), assumeSymmetry: true,
          unlockRequirement: RecipeUnlockRequirement(context: 1'u8), recipeNetworkId: newVarUInt(networkId))))
        networkId += 1'u32
    of crkCraftingShapeless:
      let r = recipe.shapeless
      var input: seq[ItemDescriptorCount] = @[]
      for ing in r.ingredients:
        input.add(mapIngredient(ing))
      let (ok, output) = outputDescriptor(r.result)
      if ok:
        mapped.add(BedrockRecipe(kind: brShapeless, shapeless: BedrockShapelessRecipe(recipeId: "pumpkin:recipe_" & $networkId,
          input: input, output: @[output],
          uuid: [0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8],
          blockName: "crafting_table", priority: newVarInt(1'i32),
          unlockRequirement: RecipeUnlockRequirement(context: 1'u8), recipeNetworkId: newVarUInt(networkId))))
        networkId += 1'u32
    else:
      discard
  gBedrockRecipes = mapped
  gBedrockRecipesBuilt = true
  gBedrockRecipes
