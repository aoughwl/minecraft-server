## Test for bedrockcrypto.aowl: a signature and an ECDH secret made on worker threads are the ones the direct calls give
## (RFC 6979 signatures are deterministic, so they can be compared byte for byte).
import std/syncio
import ../../../util/jwtmod
import bignum, ecdsa
import bedrockcrypto

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "  ok  ", what
  else:
    echo "FAIL  ", what
    failures += 1

proc scalar(seed: uint8): seq[byte] =
  result = newSeq[byte](48)
  for i in 0 ..< 48:
    result[i] = uint8((int(seed) * 7 + i * 13) mod 251) + 1'u8
  result[0] = 0x11'u8   # below the group order

proc wait(job: nil CryptoJob): seq[byte] =
  if job == nil:
    return @[]
  while not pollCryptoJob(job):
    discard
  takeCryptoJob(job)

proc main() =
  let serverKey = signingKeyFromBytes(scalar(1'u8))
  let clientKey = signingKeyFromBytes(scalar(2'u8))
  check(serverKey.isOk and clientKey.isOk, "the two test keys are valid scalars")
  let message = @[byte(ord('a')), byte(ord('b')), byte(ord('c'))]
  var signInput = scalarBytes(serverKey.value)
  for b in message:
    signInput.add(b)
  let clientPoint = verifyingKey(clientKey.value)
  var ecdhInput = scalarBytes(serverKey.value)
  for b in pointBytes(clientPoint):
    ecdhInput.add(b)
  # both jobs run at once, while this thread does the same two directly
  let signJob = startCryptoJob(0, signInput)
  let ecdhJob = startCryptoJob(1, ecdhInput)
  check(signJob != nil and ecdhJob != nil, "the worker threads start")
  let direct = signEs384(serverKey.value, message)
  let directSecret = computeSharedSecret(serverKey.value, clientPoint)
  let signed = wait(signJob)
  let secret = wait(ecdhJob)
  check(signed.len == 96, "the signature is r || s, 96 bytes")
  check(signed == direct, "the worker's signature is the direct one")
  check(secret.len == 48, "the ECDH x is 48 bytes")
  var same = secret.len == 48
  for i in 0 ..< 48:
    if same and secret[i] != directSecret[i]:
      same = false
  check(same, "the worker's ECDH secret is the direct one")
  # a scalar of zero is not a key: the job answers empty rather than crashing
  var zero = newSeq[byte](48)
  for b in message:
    zero.add(b)
  check(wait(startCryptoJob(0, zero)).len == 0, "an invalid scalar gives an empty answer")
  if failures > 0:
    quit(1)
  echo "bedrockcryptotest: all ok"

main()
