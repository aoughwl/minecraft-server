## A Bedrock-only driver for tools/bedrockbot.py: no world, no Java side, just the listener, the login and the resource
## pack exchange of bedrockserver.aowl on a UDP port, with hooks that print what happened. No upstream file.
##
##     bedrockdemo --port:<udp port> [--no-encryption] [--max-seconds:<n>] [--max-players:<n>]
##
## Offline mode (the claims in the login token are taken as they are), so a bot needs no Mojang key. It runs until
## `--max-seconds` (default 60) or until the console interrupt.

import std/[os, syncio, strutils]
import ../winsock
import ../../logging
import ../netbase
import ../../../config/networking/bedrock
import ../../../config/resource_pack as rpconfig
import ../../../protocol/proto
import bedrockserver

proc number(s: string): int =
  ## A non-negative decimal, -1 when it is not one.
  if s.len == 0 or s.len > 9:
    return -1
  var n = 0
  for c in s:
    if c < '0' or c > '9':
      return -1
    n = n * 10 + (ord(c) - ord('0'))
  n

proc main() =
  var port = 0
  var encryption = true
  var maxSeconds = 60
  var maxPlayers = 20
  for i in 1 .. paramCount():
    let arg = paramStr(i)
    if arg.startsWith("--port:"):
      port = number(arg[7 ..< arg.len])
    elif arg == "--no-encryption":
      encryption = false
    elif arg.startsWith("--max-seconds:"):
      maxSeconds = number(arg[14 ..< arg.len])
    elif arg.startsWith("--max-players:"):
      maxPlayers = number(arg[14 ..< arg.len])
  if port <= 0 or port > 65535:
    echo "usage: bedrockdemo --port:<udp port> [--no-encryption] [--max-seconds:<n>] [--max-players:<n>]"
    quit(2)
  var bcfg = defaultBedrockConfig()
  bcfg.onlineMode = false
  bcfg.encryption = encryption
  bcfg.maxPlayers = uint32(maxPlayers)
  bcfg.address.port = uint16(port)
  bcfg.motd = "Pumpkin Bedrock demo"
  var ready = 0
  let hooks = BedrockHooks()
  hooks.onReadyToPlay = proc(client: BedrockClient; profile: GameProfile; cfg: PlayerConfig) {.closure.} =
    ready += 1
    client.hasPlayer = true
    echo "READY name=", profile.name, " uuid=", $profile.id, " locale=", cfg.locale
    stdout.flushFile()
  hooks.onPlayPacket = proc(client: BedrockClient; packet: RawPacket) {.closure.} =
    echo "PLAYPACKET id=", packet.id, " bytes=", packet.payload.len
    stdout.flushFile()
  hooks.onResourcePacksCompleted = proc(client: BedrockClient): bool {.closure.} =
    echo "PACKS COMPLETED"
    stdout.flushFile()
    true
  hooks.onClientClosed = proc(client: BedrockClient) {.closure.} =
    ready -= 1
    echo "CLOSED"
    stdout.flushFile()
  hooks.playerCount = proc(): int {.closure.} = ready
  hooks.gameMode = proc(): string {.closure.} = "Survival"
  hooks.levelName = proc(): string {.closure.} = "demo"
  let ctx = newBedrockContext(bcfg, rpconfig.defaultBedrockResourcePackConfig(), hooks)
  let server = startBedrock(ctx)
  if server == nil:
    echo "FATAL: could not bind"
    quit(1)
  echo "LISTENING ", server.boundPort
  stdout.flushFile()
  let endAt = nowMs() + int64(maxSeconds) * 1000'i64
  while nowMs() < endAt:
    pumpBedrock(server, nowMs())
    sleepMs(1)
  stopBedrock(server)
  echo "STOPPED"

main()
