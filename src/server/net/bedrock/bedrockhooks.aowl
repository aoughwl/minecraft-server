## The call sites of `PluginManager::fire` in pumpkin/src/net/bedrock/mod.rs for a Bedrock player: `PacketReceivedEvent`
## (`progress_player_packets`), `ChunkSend` (`send_chunks`) and `PacketSentEvent` (`fire_packet_sent_no_obj`).
##
## Each is a closure the plugin host sets when it has the event; the default lets everything through. They answer true to
## cancel. (The WebAssembly interface has no such events in this tree yet, so nothing sets them: pluginmgr.aowl is where
## the others of its kind are set.)
import ../../../world/chunkdata
import ../../serverbase

var gBedrockPacketReceivedHook*: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
  proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
  ## A packet the Bedrock client sent, before it is handled: true drops it.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callBedrockPacketReceivedHook*(player: Player; packetId: int32; payload: seq[byte]): bool =
  gBedrockPacketReceivedHook(player, packetId, payload)

var gBedrockChunkSendHook*: proc(player: Player; chunk: ChunkData): bool {.closure.} =
  proc(player: Player; chunk: ChunkData): bool {.closure.} = false
  ## A chunk about to be written to a Bedrock client: true leaves it out.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callBedrockChunkSendHook*(player: Player; chunk: ChunkData): bool =
  gBedrockChunkSendHook(player, chunk)

var gBedrockPacketSentHook*: proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} =
  proc(player: Player; packetId: int32; payload: seq[byte]): bool {.closure.} = false
  ## A packet about to be written to a Bedrock client: true drops it.


# Workaround (COMPILER-BUGS.md): hexer asserts on a call of an imported global closure variable, so importers call this.
proc callBedrockPacketSentHook*(player: Player; packetId: int32; payload: seq[byte]): bool =
  gBedrockPacketSentHook(player, packetId, payload)
