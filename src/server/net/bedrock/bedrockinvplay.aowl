## The part of play.rs's inventory handling that needs a `Player`: `handle_block_pick_request`, `handle_interaction` and
## `handle_container_close`, and the thin calls of bedrockinv.aowl on a player's own screen handler and inventory.
{.feature: "untyped".}

import std/[options]
import ../../../protocol/[protobase, proto, netcodec, serial, varint]
import ../../../protocol/bedrock/[bedrockmod, network_item]
import ../../../protocol/bedrock/client/[container_open, player_hotbar]
import ../../../protocol/bedrock/server/[inventory_transaction, item_stack_request, container_close, interaction,
  block_pick_request]
import ../../../protocol/java/server/play/attack as jattack
import ../../../generated/[item_full]
import "../../../data/item_stack/mod"
import ../../../inventory/[screenhandler, slot, inventory, player_inventory, entity_equipment]
import ../../../util/gamemode
import ../../../util/math/position
import ../../serverbase
import ../../entity/player as playermod
import ../../world/[worldmod, chunker]
import ../java/[javamod, play]
import bedrockclient, bedrockinv

proc mainHandChange(player: Player): proc(stack: ItemStack) {.closure.} =
  proc(stack: ItemStack) {.closure.} = player.sendEquipmentChanges([(esMainHand, stack)])

proc sendInventory*(client: BedrockClient; player: Player) =
  client.sendInventory(player.inventory)

proc sendContainerSlots*(client: BedrockClient; player: Player) =
  client.sendContainerSlots(player.currentScreenHandler)

proc sendOpenContainer*(client: BedrockClient; player: Player) =
  ## `open_handled_screen`'s Bedrock half, once the Java half has set the window and its position.
  let pos = if player.openContainerPos.isSome: player.openContainerPos.unsafeGet else: newBlockPos(0'i32, 0'i32, 0'i32)
  client.sendOpenContainer(player.currentScreenHandler, player.inventory, pos)

proc handleInventoryActions*(client: BedrockClient; player: Player; packet: SInventoryTransaction): seq[SlotUpdate] =
  handleInventoryActions(client, player.asInventoryPlayer(), ScreenHandler(player.playerScreenHandler), mainHandChange(player), packet)

proc handleItemStackRequest*(client: BedrockClient; player: Player; packet: SItemStackRequest) =
  handleItemStackRequest(client, player.asInventoryPlayer(), player.currentScreenHandler, mainHandChange(player), packet)

# --- handle_block_pick_request ------------------------------------------------------------------------------------------

proc handleBlockPickRequest*(client: BedrockClient; player: Player; packet: SBlockPickRequest) =
  ## `handle_block_pick_request`.
  if not player.canInteractWithBlockAt(packet.blockPos, 1.0):
    return
  let blockRef = player.world.getBlock(packet.blockPos)
  if blockRef.itemId == 0'u16:
    return
  let item = Item.fromId(blockRef.itemId)
  if item == nil:
    return
  let stack = newItemStack(1'u8, item)
  let target = int(packet.hotbarSlot)
  if target >= 9:
    return
  let slotWithStack = player.inventory.getSlotWithStack(stack)
  if slotWithStack != -1'i16:
    if int(slotWithStack) != target:
      let targetStack = player.inventory.mainInventory[target]
      let sourceStack = player.inventory.mainInventory[int(slotWithStack)]
      player.inventory.mainInventory[target] = sourceStack
      player.inventory.mainInventory[int(slotWithStack)] = targetStack
  elif player.gamemode == Creative:
    player.inventory.mainInventory[target] = stack
  else:
    return
  player.inventory.setSelectedSlot(uint8(target))
  client.sendGamePacket(CPlayerHotbarPacketId, CPlayerHotbar(selectedSlot: newVarUInt(uint32(target)), containerId: 0'u8,
    shouldSelectBlock: true))
  ScreenHandler(player.playerScreenHandler).sendContentUpdates()
  player.sendEquipmentChanges([(esMainHand, player.inventory.heldItem())])
  client.sendInventory(player.inventory)

# --- interaction and closing --------------------------------------------------------------------------------------------

proc handleInteraction*(client: BedrockClient; ghost: JavaClient; player: Player; server: Server; packet: SInteraction) =
  ## `handle_interaction`.
  case packet.action
  of iaOpenInventory:
    if client.inventoryOpened:
      return
    client.inventoryOpened = true
    client.sendGamePacket(CContainerOpenPacketId, CContainerOpen(containerId: 0'u8, containerType: 0xff'u8,
      position: newBlockPos(0'i32, 0'i32, 0'i32), targetEntityId: newVarLong(-1'i64)))
  of iaAttack:
    ghost.handleAttack(player, jattack.SAttack(entityId: newVarInt(int32(packet.targetRuntimeId.value))), server)
  else:
    discard # InteractUpdate (the mouse-over of an entity) and the rest are `_ => {}` upstream.

proc handleContainerClose*(client: BedrockClient; player: Player; packet: SContainerClose) =
  ## `handle_container_close`.
  if packet.containerId == 0'u8 or packet.containerId == 0xff'u8:
    client.inventoryOpened = false
  player.onHandledScreenClosed()
  client.sendGamePacket(SContainerClosePacketId, SContainerClose(containerId: packet.containerId,
    containerType: packet.containerType, serverInitiated: false))
  client.sendCursor(player.currentScreenHandler)
  client.sendInventory(player.inventory)
