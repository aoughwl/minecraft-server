## Test for bedrockinv.aowl: the container slot mapping (`map_bedrock_container_slot`) and the item stack requests, on the
## inventory test kit's player and a real `PlayerScreenHandler`. Known answers are worked out from play.rs.
import std/options
import ../../../inventory/invtestkit
import ../../../inventory/[entity_equipment, genericcontainer, inventory, player_inventory, player_screen_handler, screenhandler, slot]
import ../../../generated/[screen, item_full, bedrock_creative]
import ../../../protocol/varint
import ../../../protocol/bedrock/network_item
import ../../../protocol/bedrock/client/item_stack_response
import ../../../protocol/bedrock/server/item_stack_request
import ../../../protocol/bedrock/server/inventory_transaction
import bedrockinv

proc handlerOf(p: TestPlayer): PlayerScreenHandler =
  newPlayerScreenHandler(p.inventory, none[WindowType](), 0'u8, nil)

proc named(n: ContainerName; slotId: int): ItemStackRequestSlotInfo =
  ItemStackRequestSlotInfo(containerName: FullContainerName(containerName: n, dynamicId: none[uint32]()),
    slotId: uint8(slotId), stackId: newVarInt(0'i32))

proc request(id: int32; actions: seq[ItemStackRequestAction]): SItemStackRequest =
  SItemStackRequest(requests: @[ItemStackRequest(requestId: newVarInt(id), actions: actions, filterStrings: @[], filterCause: 0'i32)])

proc move(kind: ItemStackRequestActionKind; count: int; source, destination: ItemStackRequestSlotInfo): ItemStackRequestAction =
  ItemStackRequestAction(kind: kind, count: uint8(count), source: source, destination: destination)

proc noMainHand(stack: ItemStack) {.closure.} = discard

proc run(p: TestPlayer; h: ScreenHandler; packet: SItemStackRequest): seq[ItemStackResponse] =
  let (responses, _) = processItemStackRequests(p, h, noMainHand, packet)
  responses

proc run(p: TestPlayer; h: PlayerScreenHandler; packet: SItemStackRequest): seq[ItemStackResponse] =
  run(p, ScreenHandler(h), packet)

block slotMapping:
  let p = newTestPlayer()
  let h = ScreenHandler(handlerOf(p))
  check(mapContainerSlot(h, cnHotBar, 3'u8) == 39, "hotbar 3 is screen slot 39")
  check(mapContainerSlot(h, cnInventory, 12'u8) == 12, "inventory 12 stays 12")
  check(mapContainerSlot(h, cnInventory, 4'u8) == 40, "inventory 4 is the hotbar slot 40")
  check(mapContainerSlot(h, cnCombinedHotBarAndInventory, 35'u8) == 35, "combined 35")
  check(mapContainerSlot(h, cnInventory, 36'u8) == -1, "inventory 36 is nothing")
  check(mapContainerSlot(h, cnArmor, 2'u8) == 7, "armor 2 is legs, screen slot 7")
  check(mapContainerSlot(h, cnArmor, 4'u8) == -1, "armor 4 is nothing")
  check(mapContainerSlot(h, cnOffhand, 0'u8) == 45, "offhand is 45")
  check(mapContainerSlot(h, cnCursor, 0'u8) == -1, "the cursor has no slot")
  check(mapContainerSlot(h, cnCraftingInput, 0'u8) == 1 and mapContainerSlot(h, cnCraftingInput, 31'u8) == 4, "2x2 grid, both ranges")
  check(mapContainerSlot(h, cnCraftingInput, 5'u8) == -1, "the 2x2 grid has no slot 5")
  check(mapContainerSlot(h, cnCreatedOutput, 50'u8) == 0, "created output is the result slot")
  check(mapContainerSlot(h, cnFurnaceFuel, 0'u8) == -1, "a furnace slot on the player's screen is nothing")

block creativePick:
  let p = newTestPlayer(true)
  let h = handlerOf(p)
  let entries = creativeEntries()
  check(entries.len > 100, "the creative entries are loaded")
  let mapping = JavaToBedrockItemMapping.fromBedrock(entries[0].itemId, entries[0].itemAuxValue)
  if mapping == nil:
    echo "FAILED: the first creative entry has a Java item"
    quit(1)
  let maxStack = int(newItemStack(1'u8, mapping.javaItem).getMaxStackSize())
  let responses = run(p, h, request(-3'i32, @[
    ItemStackRequestAction(kind: isaCraftCreative, repetitions: 1'u8, creativeItemId: newVarUInt(1'u32)),
    move(isaTake, maxStack, named(cnCreatedOutput, 50), named(cnHotBar, 8))]))
  check(responses.len == 1 and responses[0].result == 0'u8 and responses[0].requestId.value == -3'i32, "the pick succeeds")
  let stack = h.getSlot(44).getStack()
  check(not stack.isEmpty() and stack.item.id == mapping.javaItem.id, "the picked item is in screen slot 44 (hotbar 8)")
  check(int(stack.itemCount) == maxStack, "a creative pick is one full stack")
  check(responses[0].containerInfos.len >= 1, "the response names the slots changed")

block takeAndPlace:
  let p = newTestPlayer()
  let h = handlerOf(p)
  h.getSlot(9).setStack(stackOf(ITEM_STONE, 10))
  # take 4 of 10 from inventory slot 9 into the cursor, then place 3 of them in hotbar 1
  var r = run(p, h, request(1'i32, @[move(isaTake, 4, named(cnInventory, 9), named(cnCursor, 0))]))
  check(r[0].result == 0'u8, "take into the cursor")
  checkStack(h.getSlot(9).getStack(), ITEM_STONE, 6, "6 stay")
  checkStack(h.behaviour.cursorStack, ITEM_STONE, 4, "4 on the cursor")
  r = run(p, h, request(2'i32, @[move(isaPlace, 3, named(cnCursor, 0), named(cnHotBar, 1))]))
  check(r[0].result == 0'u8, "place from the cursor")
  checkStack(h.getSlot(37).getStack(), ITEM_STONE, 3, "3 in hotbar 1")
  checkStack(h.behaviour.cursorStack, ITEM_STONE, 1, "1 left on the cursor")
  # a different item in the destination refuses the move
  h.getSlot(38).setStack(stackOf(ITEM_APPLE, 2))
  r = run(p, h, request(3'i32, @[move(isaPlace, 1, named(cnCursor, 0), named(cnHotBar, 2))]))
  check(r[0].result == 1'u8, "stone onto apples is refused")
  checkStack(h.getSlot(38).getStack(), ITEM_APPLE, 2, "the apples are untouched")
  # taking from an empty slot fails
  r = run(p, h, request(4'i32, @[move(isaTake, 1, named(cnInventory, 20), named(cnHotBar, 0))]))
  check(r[0].result == 1'u8, "an empty source fails")

block swapDropDestroy:
  let p = newTestPlayer()
  let h = handlerOf(p)
  h.getSlot(36).setStack(stackOf(ITEM_STONE, 5))
  h.getSlot(37).setStack(stackOf(ITEM_APPLE, 7))
  var r = run(p, h, request(5'i32, @[ItemStackRequestAction(kind: isaSwap, slot1: named(cnHotBar, 0), slot2: named(cnHotBar, 1))]))
  check(r[0].result == 0'u8, "swap")
  checkStack(h.getSlot(36).getStack(), ITEM_APPLE, 7, "apples moved to hotbar 0")
  checkStack(h.getSlot(37).getStack(), ITEM_STONE, 5, "stone moved to hotbar 1")
  r = run(p, h, request(6'i32, @[ItemStackRequestAction(kind: isaDrop, count: 3'u8, source: named(cnHotBar, 0), randomly: false)]))
  check(r[0].result == 0'u8, "drop")
  checkStack(h.getSlot(36).getStack(), ITEM_APPLE, 4, "4 apples stay")
  check(p.drops.len == 1 and p.drops[0].stack.item.id == ITEM_APPLE.id and int(p.drops[0].stack.itemCount) == 3, "3 apples were dropped")
  r = run(p, h, request(7'i32, @[ItemStackRequestAction(kind: isaDestroy, count: 5'u8, source: named(cnHotBar, 1))]))
  check(r[0].result == 0'u8, "destroy")
  checkStack(h.getSlot(37).getStack(), ITEM_STONE, 0, "the stone is gone")
  check(r[0].containerInfos.len == 1 and r[0].containerInfos[0].slots[0].count == 0'u8, "the response says the slot is empty")

block armorSlot:
  let p = newTestPlayer()
  let h = handlerOf(p)
  h.getSlot(36).setStack(stackOf(ITEM_DIAMOND, 1))
  let r = run(p, h, request(8'i32, @[move(isaPlace, 1, named(cnHotBar, 0), named(cnArmor, 0))]))
  check(r[0].result == 0'u8, "into the armor slot")
  checkStack(h.getSlot(5).getStack(), ITEM_DIAMOND, 1, "screen slot 5 holds it")
  check(p.equipment.len == 1 and p.equipment[0].slot == esHead, "the head equipment change was queued")

block chestWindow:
  # A chest leaves `container_slots` 0 upstream, so the container's own slots are what comes before the player's 36.
  let p = newTestPlayer()
  let chestInv = newArrayInventory(27)
  let chest = createGeneric9x3(3'u8, p.inventory, chestInv)
  let h = ScreenHandler(chest)
  check(containerCount(h.getBehaviour()) == 27, "a 9x3 chest has 27 container slots")
  check(mapContainerSlot(h, cnLevelEntity, 5'u8) == 5, "chest slot 5")
  check(mapContainerSlot(h, cnLevelEntity, 27'u8) == -1, "chest slot 27 is the player's")
  check(mapContainerSlot(h, cnInventory, 9'u8) == 27, "inventory 9 follows the chest")
  check(mapContainerSlot(h, cnHotBar, 0'u8) == 27 + 27, "hotbar 0 is the last nine")
  check(mapContainerSlot(h, cnArmor, 0'u8) == -1, "no armor on a chest screen")
  let (name, slotId) = bedrockSlotOfContainer(h, 7)
  check(name == cnLevelEntity and slotId == 7'u8, "chest slot 7 goes down as LevelEntity 7")
  # moving an item from the hotbar into the chest and back
  h.getBehaviour().slots[27 + 27].setStack(stackOf(ITEM_APPLE, 5))
  var r = run(p, h, request(9'i32, @[move(isaPlace, 3, named(cnHotBar, 0), named(cnLevelEntity, 0))]))
  check(r[0].result == 0'u8, "into the chest")
  checkStack(h.getBehaviour().slots[0].getStack(), ITEM_APPLE, 3, "3 apples in the chest")
  checkStack(chestInv.getStack(0), ITEM_APPLE, 3, "the chest's own inventory has them")
  checkStack(h.getBehaviour().slots[54].getStack(), ITEM_APPLE, 2, "2 left in the hotbar")
  r = run(p, h, request(10'i32, @[move(isaTake, 3, named(cnLevelEntity, 0), named(cnInventory, 10))]))
  check(r[0].result == 0'u8, "out of the chest")
  checkStack(h.getBehaviour().slots[28].getStack(), ITEM_APPLE, 3, "3 apples in inventory slot 10")

echo "bedrockinv ok"
