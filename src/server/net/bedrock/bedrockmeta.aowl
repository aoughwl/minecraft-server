## Port of `Entity::bedrock_metadata` (pumpkin/src/entity/mod.rs): the metadata a Bedrock client is given for an entity
## that is not a player (`CAddActor`, `CAddItemActor`) and for the player (`CAddPlayer`, here the same set).
##
## The flags are the ones upstream sets when its `bedrock_flags` is still zero: gravity, climb, collision and breathing.
## The name is the custom name when there is one, with the show-name flags when it is visible.
import ../../../protocol/varint
import ../../../protocol/bedrock/client/[set_actor_data, update_abilities, update_attributes, common]

proc bedrockBaseFlags*(): int64 =
  ## `(1 << HAS_GRAVITY) | (1 << CLIMB) | (1 << HAS_COLLISION) | (1 << BREATHING)`.
  cast[int64]((1'u64 shl EDF_HAS_GRAVITY) or (1'u64 shl EDF_CLIMB) or (1'u64 shl EDF_HAS_COLLISION) or (1'u64 shl EDF_BREATHING))

proc bedrockMetadata*(width, height: float32; customName: string; nameVisible: bool; flagsExtra: int64 = 0'i64): EntityMetadata =
  ## `bedrock_metadata`: WIDTH, HEIGHT, SCALE, FLAGS, FLAGS_TWO and the NAME with its flags.
  var metadata = newEntityMetadata()
  metadata.set(EDK_WIDTH, mvFloatOf(width))
  metadata.set(EDK_HEIGHT, mvFloatOf(height))
  metadata.set(EDK_SCALE, mvFloatOf(1.0'f32))
  metadata.set(EDK_FLAGS, mvLongOf(bedrockBaseFlags() or flagsExtra))
  metadata.set(EDK_FLAGS_TWO, mvLongOf(0'i64))
  if customName.len > 0:
    metadata.set(EDK_NAME, mvStringOf(customName))
    if nameVisible:
      metadata.setFlag(EDK_FLAGS, uint8(EDF_SHOW_NAME), true)
      metadata.setFlag(EDK_FLAGS, uint8(EDF_ALWAYS_SHOW_NAME), true)
  metadata

# --- Player::send_abilities_update for a Bedrock client -------------------------------------------------------------------

proc abilityValue*(allowFlying, flying, invulnerable, creative, isOp, isSpectator: bool): uint32 =
  ## The bitmask of `send_abilities_update`'s Bedrock arm.
  var value = 0'u32
  proc setBit(value: var uint32; a: Ability; enabled: bool) =
    if enabled:
      value = value or (1'u32 shl uint32(ord(a)))
  value.setBit(abMayFly, allowFlying)
  value.setBit(abFlying, flying)
  value.setBit(abInvulnerable, invulnerable or creative)
  value.setBit(abOperatorCommands, isOp)
  value.setBit(abTeleport, isOp)
  let canInteract = not isSpectator
  value.setBit(abBuild, canInteract)
  value.setBit(abMine, canInteract)
  value.setBit(abDoorsAndSwitches, canInteract)
  value.setBit(abOpenContainers, canInteract)
  value.setBit(abAttackPlayers, canInteract)
  value.setBit(abAttackMobs, canInteract)
  value.setBit(abInstabuild, creative)
  value.setBit(abNoClip, isSpectator)
  value

proc bedrockAbilities*(entityId: int64; allowFlying, flying, invulnerable, creative, isOp, isSpectator: bool): CUpdateAbilities =
  ## `CUpdateAbilities` of `send_abilities_update`: the base layer, and for a spectator the flying layer.
  let base = AbilityLayer(serializedLayer: 0'u16, abilitiesSet: (1'u32 shl uint32(ord(abAbilityCount))) - 1'u32,
    abilityValue: abilityValue(allowFlying, flying, invulnerable, creative, isOp, isSpectator), flySpeed: 0.05'f32,
    verticalFlySpeed: 1.0'f32, walkSpeed: 0.1'f32)
  var layers: seq[AbilityLayer] = @[base]
  if isSpectator:
    layers.add(AbilityLayer(serializedLayer: 1'u16, abilitiesSet: 1'u32 shl uint32(ord(abFlying)),
      abilityValue: 1'u32 shl uint32(ord(abFlying)), flySpeed: 0.05'f32, verticalFlySpeed: 1.0'f32, walkSpeed: 0.1'f32))
  CUpdateAbilities(targetPlayerRawId: entityId, playerPermission: (if isOp: 2'u8 else: 1'u8),
    commandPermission: (if isOp: 1'u8 else: 0'u8), layers: layers)

# --- the CUpdateAttributes of spawn_bedrock_player -----------------------------------------------------------------------

proc attributeOf(name: string; minValue, maxValue, value: float32): Attribute =
  Attribute(minValue: minValue, maxValue: maxValue, currentValue: value, defaultMinValue: minValue, defaultMaxValue: maxValue,
    defaultValue: value, name: name, modifiersListSize: newVarUInt(0'u32))

proc spawnAttributes*(runtimeId: uint64): CUpdateAttributes =
  ## The six attributes upstream sends at spawn.
  let floatMax = 3.402_823_5e38'f32
  CUpdateAttributes(runtimeId: newVarULong(runtimeId), attributes: @[
    attributeOf("minecraft:movement", 0.0'f32, floatMax, 0.1'f32),
    attributeOf("minecraft:underwater_movement", 0.0'f32, floatMax, 0.02'f32),
    attributeOf("minecraft:gravity", 0.0'f32, 1.0'f32, 0.08'f32),
    attributeOf("minecraft:air", 0.0'f32, 400.0'f32, 400.0'f32),
    attributeOf("minecraft:health", 0.0'f32, 20.0'f32, 20.0'f32),
    attributeOf("minecraft:player.hunger", 0.0'f32, 20.0'f32, 20.0'f32)], playerTick: newVarULong(0'u64))

# --- the Java entity flags byte (metadata index 0) as Bedrock flags -------------------------------------------------------

proc bedrockFlagsOfJava*(javaFlags: uint8; extra: int64 = 0'i64): int64 =
  ## 0x01 on fire, 0x02 crouching, 0x08 sprinting, 0x10 swimming, 0x20 invisible, 0x80 gliding, over the base flags.
  var flags = bedrockBaseFlags() or extra
  proc put(flags: var int64; bit: uint32; on: bool) =
    if on:
      flags = flags or cast[int64](1'u64 shl bit)
  flags.put(EDF_ON_FIRE, (javaFlags and 0x01'u8) != 0'u8)
  flags.put(EDF_SNEAKING, (javaFlags and 0x02'u8) != 0'u8)
  flags.put(EDF_SPRINTING, (javaFlags and 0x08'u8) != 0'u8)
  flags.put(EDF_SWIMMING, (javaFlags and 0x10'u8) != 0'u8)
  flags.put(EDF_INVISIBLE, (javaFlags and 0x20'u8) != 0'u8)
  flags.put(EDF_GLIDING, (javaFlags and 0x80'u8) != 0'u8)
  flags
