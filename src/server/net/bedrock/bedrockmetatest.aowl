## Test for bedrockmeta.aowl: the flag word and the entries of an entity's Bedrock metadata.
import std/syncio
import ../../../protocol/bedrock/client/set_actor_data
import ../../../protocol/bedrock/client/[update_abilities, update_attributes]
import bedrockmeta

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "  ok  ", what
  else:
    echo "FAIL  ", what
    failures += 1

proc valueOf(m: EntityMetadata; key: uint32): MetadataValue =
  for i in 0 ..< m.entries.len:
    if m.entries[i].key == key:
      return m.entries[i].value
  MetadataValue(kind: mvByte)

proc main() =
  # 2^49 + 2^48 + 2^35 + 2^19
  check(bedrockBaseFlags() == 562949953421312'i64 + 281474976710656'i64 + 34359738368'i64 + 524288'i64, "base flag word")
  let plain = bedrockMetadata(0.6'f32, 1.95'f32, "", false)
  check(valueOf(plain, EDK_WIDTH).floatValue == 0.6'f32, "width")
  check(valueOf(plain, EDK_HEIGHT).floatValue == 1.95'f32, "height")
  check(valueOf(plain, EDK_SCALE).floatValue == 1.0'f32, "scale")
  check(valueOf(plain, EDK_FLAGS).longValue == bedrockBaseFlags(), "flags")
  check(valueOf(plain, EDK_FLAGS_TWO).longValue == 0'i64, "flags two")
  let hidden = bedrockMetadata(1.0'f32, 1.0'f32, "Bob", false)
  check(valueOf(hidden, EDK_NAME).stringValue == "Bob", "name")
  check(valueOf(hidden, EDK_FLAGS).longValue == bedrockBaseFlags(), "hidden name sets no flag")
  let shown = bedrockMetadata(1.0'f32, 1.0'f32, "Bob", true)
  let want = bedrockBaseFlags() or (1'i64 shl EDF_SHOW_NAME) or (1'i64 shl EDF_ALWAYS_SHOW_NAME)
  check(valueOf(shown, EDK_FLAGS).longValue == want, "visible name sets show and always-show")
  # creative flying op: MayFly 10, Flying 9, Invulnerable 8, OpCommands 6, Teleport 7, Build..AttackMobs 0-5, Instabuild 11
  let creativeOp = abilityValue(true, true, false, true, true, false)
  check(creativeOp == 0xFFF'u32, "creative op, flying: bits 0 to 11")
  check(abilityValue(false, false, false, false, false, false) == 0x3F'u32, "survival member: build to attack mobs only")
  check(abilityValue(true, true, true, false, false, true) == ((1'u32 shl 10) or (1'u32 shl 9) or (1'u32 shl 8) or (1'u32 shl 17)),
    "spectator: no interaction, no clip")
  let packet = bedrockAbilities(7'i64, true, false, false, false, false, true)
  check(packet.layers.len == 2 and packet.layers[1].serializedLayer == 1'u16, "spectator has the flying layer")
  check(packet.layers[0].abilitiesSet == 0xFFFFF'u32, "base layer provides 20 bits")
  check(packet.playerPermission == 1'u8 and packet.commandPermission == 0'u8, "member permissions")
  let attrs = spawnAttributes(3'u64)
  check(attrs.attributes.len == 6 and attrs.attributes[4].name == "minecraft:health" and attrs.attributes[4].currentValue == 20.0'f32,
    "six attributes with health 20")
  check(bedrockFlagsOfJava(0'u8) == bedrockBaseFlags(), "no java flags: the base")
  check(bedrockFlagsOfJava(0x0A'u8) == (bedrockBaseFlags() or (1'i64 shl EDF_SNEAKING) or (1'i64 shl EDF_SPRINTING)),
    "crouching and sprinting")
  check(bedrockFlagsOfJava(0xA1'u8) == (bedrockBaseFlags() or (1'i64 shl EDF_ON_FIRE) or (1'i64 shl EDF_INVISIBLE) or (1'i64 shl EDF_GLIDING)),
    "fire, invisible, gliding")
  if failures != 0:
    echo failures, " failure(s)"
    quit(1)
  echo "bedrockmeta ok"

main()
