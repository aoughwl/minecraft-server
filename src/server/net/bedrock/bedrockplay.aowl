## Port of pumpkin/src/net/bedrock/play.rs and pumpkin/src/net/bedrock/mod.rs (`send_chunks`, `enqueue_spawn_packet`,
## `handle_play_packet`), and of `World::spawn_bedrock_player` / `Server::add_player` for a Bedrock client
## (pumpkin/src/world/mod.rs, pumpkin/src/server/mod.rs).
## PARTIAL: pumpkin/src/net/bedrock/play.rs - done here: request chunk radius, set local player initialized, player auth input (movement, rotation, sprint/sneak/fly toggles, block actions), animate, text, command request, modal form response and its event, container close, interaction (bedrockinv.aowl), mob equipment, use-item-on-block, use-item (air), use-item-on-entity (interact and attack), release-item, request ability, emote, block pick, legacy slot moves and drops and the item stack requests (bedrockinv.aowl). The held item of a click is `descriptorToStack` of the client's item (creative ids index the creative entries) and replaces the server's held stack only when that is empty or another item, as upstream; `handle_mob_equipment` fires `PlayerItemHeldEvent` and answers a cancel with `CPlayerHotbar`; `handle_animate` and `handle_emote` broadcast editioned (a Java arm swing or animation for Java players, the Bedrock packet for Bedrock ones). `handle_player_action` has only the digging, drop and abort arms, which is all upstream has too. No more is missing from this file; none of it has been read by a real Bedrock client.
## PARTIAL: pumpkin/src/net/bedrock/mod.rs - `enqueue_spawn_packet` (spawning a non-player entity for a Bedrock client) sends `CAddActor` with the Java registry name as the Bedrock identifier, the size, flags and name as metadata (bedrockmeta.aowl) and `CAddItemActor` for a dropped item; later metadata (flags byte, pose, baby, custom name, sheep colour) comes from the Java entity-data packet (bedrockxlate.aowl `parseMetadata`, which stops at the first entry of a type it cannot size, so a mob whose entries sit behind e.g. a particle list is partly updated); other Java-to-Bedrock follow-ups translated by bedrockxlate.aowl: effects, weather, title and action bar, boss bars, equipment of other entities, arm swing and hurt/death events, tab list adds and removes, and the death screen and respawn (`SRespawn`, client/play_extra.aowl); the scoreboard objectives and scores go out editioned from world/scoreboard.aowl (`CSetDisplayObjective`, `CRemoveObjective`, `CSetScore`); NOT translated: sounds (`CSoundEffect`, `CEntitySoundEffect`) and particles (`CParticle`): upstream has no Java sound id or particle to Bedrock table either and this tree has no data to build one from, so a Bedrock client hears and sees none of them; the other metadata types, a Java player's own held item for a Bedrock viewer at spawn (only a later equipment packet), and the Java player-list entries that carry chat initialisation or a display name; none of the new Bedrock packets has been read by a real Bedrock client; `PacketReceivedEvent` is offered to the plugins through pluginhooksevents.aowl's `callPluginPacketReceivedHook` (after bedrockhooks.aowl's closure), `fire_packet_sent_no_obj` through `gPacketSentHook` of the stand-in, and `ChunkSend` through bedrockhooks.aowl's closure only, which nothing sets because src/plugin has no host conversion for that event.
## PARTIAL: pumpkin/src/world/mod.rs `spawn_bedrock_player` - the crafting data (bedrockcraft.aowl), the attributes, the abilities, the commands (from the Java packets the join writes), the skins (bedrockskin.aowl) are sent; a Bedrock player's own skin is not shown to Java clients (they take a Mojang texture URL).
##
## HOW THE BEDROCK PLAYER LIVES IN THE WORLD. Upstream's `Player` holds a `ClientPlatform` that is Java or Bedrock. Here
## `Player.client` is a `JavaClient`, and everything that is Java (the tab list, spawning for the others, chat, the
## movement broadcasts, `world.players`, the tick, the chunk manager) takes it. A Bedrock player is therefore a `Player` with
## a stand-in `JavaClient` that has no socket and a `tap`: it is added with `Server.addPlayer` and spawned with
## `spawnJavaPlayer` exactly as a Java player is, so Java players see it, and the Java packets written to the stand-in are
## read back here and translated into the Bedrock packets that say the same (`translateJava`): chat, block updates, entity
## spawn, move and remove, time, the disconnect. What the Java handlers do for a Java client (`handlePositionRotation`,
## `handlePlayerAction`, `handleUseItemOn`, `handleSetHeldItem`, `handleChatCommand`) a Bedrock packet calls through the stand-in
## after being turned into the Java packet record. The chunks come from the Java chunk manager's `chunkSent` (the chunks the
## player is watching are loaded by tickets as for a Java player) and are written in Bedrock's layout by `CLevelChunk`.
## Cost of this: the stand-in's Java chunk packets are still encoded and dropped.
##
## The login runs on the RakNet session (bedrocklogin.aowl); `bedrockHooks` is what that layer calls.

{.feature: "untyped".}

import std/[options, tables, syncio, math, envvars]
import ../../../protocol/[protobase, proto, netcodec, serial, varint, lpvector3d, uuid]
import ../../../protocol/bedrock/[bedrockmod, packet_decoder, network_item]
import ../../../protocol/bedrock/client/[start_game, item_registry, creative_content, chunk_radius_update,
  network_chunk_publisher_update, play_status, set_time, set_spawn_position, add_player, remove_actor, move_player,
  update_block, set_actor_data, update_abilities, level_chunk, inventory_content, add_actor, player_list,
  modal_form_request, gamerules_changed, set_difficulty, common, add_item_actor, set_player_gamemode, move_actor_absolute, available_commands as bac, crafting_data, update_attributes as bupdate_attributes]
import ../../../protocol/bedrock/client/disconnect_player as cdisc
import ../../../protocol/bedrock/client/set_health as bset_health
import ../../../protocol/bedrock/server/[player_auth_input, text, command_request, request_chunk_radius,
  set_local_player_as_initialized, modal_form_response, player_action, inventory_transaction, mob_equipment,
  container_close, animate, request_ability, client_cache_status, item_stack_request, block_pick_request, interaction, emote]
import ../../../protocol/java/client/play/[system_chat_message, block_update, multi_block_update, spawn_entity,
  remove_entities, update_entity_pos, update_entity_pos_rot, entity_position_sync, player_position, disconnect,
  game_event as jgame_event, entity_metadata as jentity_metadata, commands as jcommands, player_abilities as jplayer_abilities, open_screen, close_container, set_container_content, set_container_slot, set_cursor_slot, set_player_inventory,
  set_time as jset_time, teleport_entity, head_rot, chunk_batch_end, set_health as jset_health]
import ../../../protocol/java/server/play/[player_position_rotation, player_action as jplayer_action, use_item_on,
  set_held_item, chat_command, use_item, interact as jinteract, attack as jattack, client_command]
import ../../../protocol/java/server/play/[confirm_teleport, chunk_batch]
import ../../../generated/[entity_type, block_properties, item_full]
import ../../../data/block_state
import "../../../data/item_stack/mod"
import ../../../inventory/[player_inventory, screenhandler, slot]
import ../../../generated/bedrock_creative
import ../winsock
import ../../../util/math/position
import ../../../util/vector3
import ../../../util/vector2
import ../../../util/uuid
import ../../../util/gamemode
import ../../../util/permission
import ../../../util/text/text
import ../../../util/javaversion
import ../../../world/chunkdata
import ../../../command/cmddispatch
import ../../../command/cmdsource
import ../../../command/client_suggestions
import ../../../plugin/api/events/player/bedrock_form_response
import ../../../plugin/pluginhooks
import ../../../plugin/pluginhooksevents
import ../../../plugin/api/events/player/item_held
import ../../../protocol/java/client/play/entity_animation as janim
import ../../../inventory/entity_equipment
import ../../../protocol/bedrock/client/player_hotbar
import ../../../auth/winhttp
import ../../../util/jwtmod
import ../../logging
import ../../serverbase
import ../../servermod
import ../../entity/player as playermod
import ../../entity/[entitymod, itementity]
import ../../world/[worldmod, chunker]
import ../java/[javamod, play]
import ../netbase
import ../queryserver
import bedrockclient, bedrocklogin, bedrocktext, bedrockinv, bedrockinvplay, bedrockmeta, bedrockcraft, bedrockskin, bedrockhooks
import bedrockxlate
import ../../../protocol/bedrock/client/play_extra
from ../../../protocol/java/client/play/entity_animation import CEntityAnimation, toId
from ../../../protocol/java/client/play/hurt_animation import CHurtAnimation, toId
from ../../../protocol/java/client/play/entity_status import CEntityStatus, toId
from ../../../protocol/java/client/play/set_equipment import CSetEquipment, toId
from ../../../protocol/java/client/play/update_mob_effect import CUpdateMobEffect, toId
from ../../../protocol/java/client/play/remove_mob_effect import CRemoveMobEffect, toId
from ../../../protocol/java/client/play/player_remove import CRemovePlayerInfo, toId
from ../../../protocol/java/client/play/player_info_update import CPlayerInfoUpdate, toId
from ../../../protocol/java/client/play/set_title import CTitleText, toId
from ../../../protocol/java/client/play/subtitle import CSubtitle, toId
from ../../../protocol/java/client/play/actionbar import CActionBar, toId
from ../../../protocol/java/client/play/set_title_animation import CTitleAnimation, toId
from ../../../protocol/java/client/play/clear_title import CClearTitle, toId
from ../../../protocol/java/client/play/boss_event import CBossEvent, toId
from ../../../protocol/java/client/play/combat_death import CCombatDeath, toId
from ../../../protocol/java/client/play/respawn import CRespawn, toId

const
  PlayTarget = "pumpkin::net::bedrock::play"
  EyeHeight = 1.62'f64
  MaxChunksPerPass = 4

type
  KnownEntity = object
    ## What a Bedrock client has been told about a Java entity, so that the relative moves can be made absolute.
    uuid: Uuid
    pos: Vector3[float64]
    yaw, pitch, headYaw: float32
    isPlayer: bool
    typeName: string  ## The registry name ("sheep"), for the entity-specific metadata.
    width, height: float32
    jflags: uint8     ## The last Java entity flags byte, pose, baby flag, name and sheep wool this client was told about.
    pose: int32
    baby: bool
    name: string
    nameVisible: bool
    wool: int         ## The sheep colour, -1 for anything that is not a sheep.
    armor: seq[NetworkItemStackDescriptor]  ## head, chest, legs, feet, body as last worn (empty until equipment arrives).
    pending: bool   ## A dropped item whose entity was not yet in the world when its spawn was written: sent on a later pass.
    tries: int

  BedrockSession* = ref object
    client*: BedrockClient
    ghost*: JavaClient
    server*: Server
    player*: Player
    world*: World
    sent: Table[int64, bool]
    known: Table[int32, KnownEntity]
    started: bool        ## StartGame and the rest of the world were sent.
    spawned: bool        ## `PlayStatus::PlayerSpawn` was sent.
    radius: int32
    center: Vector2[int32]
    publisherSent: bool
    gone: bool
    skin: Skin           ## What this player's client sent as its skin (the stock skin when it sent none).
    invDirty: bool       ## A Java container packet was written: the Bedrock inventory is sent again on the next pass.
    pendingOpen: int     ## The sync id of a window the server opened (-1 for none), sent once its position is known.
    openType: uint8      ## The Bedrock container type of the window that is open, for a server-initiated close.
    bossBars: BossBars   ## The numbers a Bedrock client was given for the Java boss bars (bedrockxlate.aowl).
    effects: Table[int64, bool] ## (entity, effect) pairs already shown, to choose add or modify.
    respawnPending: bool ## A Java respawn was written: the Bedrock respawn is finished once the teleport arrives.

var gSessions: seq[BedrockSession] = @[]
var gServer: nil Server = nil

type
  JavaIds = object
    systemChat, blockUpdate, multiBlock, spawnEntity, removeEntities, posUpdate, posRotUpdate, posSync, playerPosition,
      disconnect, setTime, teleport, headRot, batchEnd, health, openScreen, closeContainer, containerContent, containerSlot,
      cursor, playerInventory, commands, abilities, entityMetadata, gameEvent: int32
    animate, hurt, entityStatus, equipment, mobEffect, removeEffect, playerRemove, playerInfo, titleText, subtitle, actionBar,
      titleAnim, clearTitle, bossEvent, combatDeath, respawn: int32

var gIds: JavaIds
var gIdsReady = false

proc javaIds(): JavaIds =
  if not gIdsReady:
    let v = CurrentMcVersion
    gIds = JavaIds(systemChat: CSystemChatMessage.toId(v), blockUpdate: CBlockUpdate.toId(v),
      multiBlock: CMultiBlockUpdate.toId(v), spawnEntity: CSpawnEntity.toId(v), removeEntities: CRemoveEntities.toId(v),
      posUpdate: CUpdateEntityPos.toId(v), posRotUpdate: CUpdateEntityPosRot.toId(v), posSync: CEntityPositionSync.toId(v),
      playerPosition: CPlayerPosition.toId(v), disconnect: CPlayDisconnect.toId(v), setTime: CUpdateTime.toId(v),
      teleport: CTeleportEntity.toId(v), headRot: CHeadRot.toId(v), batchEnd: CChunkBatchEnd.toId(v), health: jset_health.CSetHealth.toId(v),
      openScreen: COpenScreen.toId(v), closeContainer: CCloseContainer.toId(v), containerContent: CSetContainerContent.toId(v),
      containerSlot: CSetContainerSlot.toId(v), cursor: CSetCursorItem.toId(v), playerInventory: CSetPlayerInventory.toId(v),
      commands: jcommands.CCommands.toId(v), abilities: jplayer_abilities.CPlayerAbilities.toId(v),
      entityMetadata: jentity_metadata.CSetEntityMetadata.toId(v), gameEvent: jgame_event.CGameEvent.toId(v),
      animate: CEntityAnimation.toId(v), hurt: CHurtAnimation.toId(v), entityStatus: CEntityStatus.toId(v),
      equipment: CSetEquipment.toId(v), mobEffect: CUpdateMobEffect.toId(v), removeEffect: CRemoveMobEffect.toId(v),
      playerRemove: CRemovePlayerInfo.toId(v), playerInfo: CPlayerInfoUpdate.toId(v), titleText: CTitleText.toId(v),
      subtitle: CSubtitle.toId(v), actionBar: CActionBar.toId(v), titleAnim: CTitleAnimation.toId(v),
      clearTitle: CClearTitle.toId(v), bossEvent: CBossEvent.toId(v), combatDeath: CCombatDeath.toId(v), respawn: CRespawn.toId(v))
    gIdsReady = true
  gIds

proc findSession(client: BedrockClient): nil BedrockSession =
  for s in gSessions:
    if s.client == client:
      return s
  nil

proc sessionOfPlayer*(player: Player): nil BedrockSession =
  ## The Bedrock session of a player, nil for a Java player.
  for s in gSessions:
    if s.player == player:
      return s
  nil

# --- Java to Bedrock ---------------------------------------------------------------------------------------------------

proc wireUuid(u: Uuid): Uuid = u

proc blockPosOf(v: int64): BlockPos = fromI64(v)

proc sendText(s: BedrockSession; text: string) =
  s.client.sendGamePacket(STextPacketId, SText.systemMessage(text))

proc sendOuts(s: BedrockSession; outs: seq[Out]) =
  ## The Bedrock packets a translation in bedrockxlate.aowl produced.
  for o in outs:
    s.client.sendGameBody(o.id, o.body)

proc skinOfPlayer(p: Player): Skin =
  ## The skin a Bedrock client is shown for a player: the one a Bedrock player's own client sent, a Java player's profile skin.
  let other = sessionOfPlayer(p)
  if other != nil:
    return other.skin
  javaSkinOf($p.gameprofile.id, p.gameprofile.properties)

proc spawnPlayerFor(s: BedrockSession; id: int32; uuid: Uuid; pos: Vector3[float64]; yaw, pitch: float32; name: string;
    skin: Skin) =
  ## `bedrock_player_list` then `bedrock_add_player` for one player, as `spawn_bedrock_player` sends them to a Bedrock client.
  let entry = PlayerListEntry(uuid: uuid, entityUniqueId: newVarLong(int64(id)), username: name, xuid: "",
    platformChatId: "", buildPlatform: 0'i32, skin: skin, isTeacher: false, isHost: false, isSubClient: false,
    playerColor: [0'u8, 0'u8, 0'u8, 0'u8])
  var listBody = newNetWriter()
  if packetWrite(CPlayerList(action: CPlayerListActionAdd, entries: @[entry]), listBody).isOk:
    s.client.sendGameBody(CPlayerListPacketId, listBody.buf)
  var metadata = newEntityMetadata()
  let add = newCAddPlayer(uuid, name, newVarULong(uint64(id)), "",
    Vector3[float32](x: float32(pos.x), y: float32(pos.y + EyeHeight), z: float32(pos.z)),
    Vector3[float32](x: 0.0'f32, y: 0.0'f32, z: 0.0'f32), pitch, yaw, yaw, defaultNetworkItemDescriptor(), newVarInt(0'i32),
    metadata, EntityProperties(ints: @[], floats: @[]),
    AbilityData(entityUniqueId: int64(id), playerPermissions: 0'u8, commandPermissions: 0'u8, layers: @[AbilityLayer(
      serializedLayer: 0'u16, abilitiesSet: 0'u32, abilityValue: 0'u32, flySpeed: 0.05'f32, verticalFlySpeed: 0.05'f32,
      walkSpeed: 0.1'f32)]), @[], "", 0'i32)
  var body = newNetWriter()
  if packetWrite(add, body).isOk:
    s.client.sendGameBody(CAddPlayerPacketId, body.buf)

proc angleByte(degrees: float32): uint8 =
  ## Bedrock's actor rotations are one byte: a 256th of a turn.
  uint8(int(floor(degrees / 360.0'f32 * 256.0'f32)) and 255)

proc moveTo(s: BedrockSession; id: int32; k: KnownEntity) =
  if k.isPlayer:
    s.client.sendGamePacket(CMovePlayerPacketId, newCMovePlayer(newVarULong(uint64(id)),
      Vector3[float32](x: float32(k.pos.x), y: float32(k.pos.y + EyeHeight), z: float32(k.pos.z)), k.pitch, k.yaw,
      k.headYaw, CMovePlayerModeNormal, true, newVarULong(0'u64), 0'i32, 0'i32, newVarULong(0'u64)))
  elif not k.pending:
    # A mob or an object: `CMoveActorAbsolute` (the relative Java moves were made absolute in `known`).
    s.client.sendGamePacket(CMoveActorAbsolutePacketId, newCMoveActorAbsolute(newVarULong(uint64(id)),
      CMoveActorAbsoluteFlagOnGround, Vector3[float32](x: float32(k.pos.x), y: float32(k.pos.y), z: float32(k.pos.z)),
      angleByte(k.pitch), angleByte(k.yaw), angleByte(k.headYaw)))

proc angleDegrees(b: uint8): float32 = float32(b) * 360.0'f32 / 256.0'f32

proc isKnownTarget(s: BedrockSession; eid: int32): bool =
  eid == s.player.entityId or s.known.hasKey(eid)

proc translateJava(s: BedrockSession; data: seq[byte]) =
  ## One Java packet the stand-in was given (id then body), as the Bedrock packet that says the same. Anything not named
  ## here is dropped: it is what a Java client alone needs (login, chunks, inventory windows, the tab list, keep alive).
  if s.gone or not s.started:
    # Nothing is said to a client that has not been given StartGame; the join sends it all again as the world.
    return
  var r = newNetReader(data)
  let idr = getVarInt(r)
  if not idr.isOk:
    return
  let id = idr.value.value
  let ids = javaIds()
  if id == ids.systemChat:
    var consumed = 0
    let text = plainTextOfNbt(data, data.len - r.remaining(), consumed)
    if text.len > 0:
      s.sendText(text)
  elif id == ids.blockUpdate:
    let pos = getI64Be(r)
    let state = getVarInt(r)
    if pos.isOk and state.isOk:
      let rid = uint32(toBeNetworkId(BlockStateId(uint16(state.value.value))))
      s.client.sendGamePacket(CUpdateBlockPacketId, newCUpdateBlock(blockPosOf(pos.value), rid))
  elif id == ids.multiBlock:
    let section = getI64Be(r)
    let count = getVarInt(r)
    if section.isOk and count.isOk:
      let sx = section.value shr 42
      let sy = (section.value shl 44) shr 44
      let sz = (section.value shl 22) shr 42
      for i in 0 ..< int(count.value.value):
        let entry = getVarLong(r)
        if not entry.isOk: break
        let packed = cast[uint64](entry.value.value)
        let local = int(packed and 0xFFF'u64)
        let state = uint16(packed shr 12)
        let x = int32(sx) * 16'i32 + int32((local shr 8) and 15)
        let z = int32(sz) * 16'i32 + int32((local shr 4) and 15)
        let y = int32(sy) * 16'i32 + int32(local and 15)
        let rid = uint32(toBeNetworkId(BlockStateId(state)))
        s.client.sendGamePacket(CUpdateBlockPacketId, newCUpdateBlock(newBlockPos(x, y, z), rid))
  elif id == ids.spawnEntity:
    let eid = getVarInt(r)
    let uuid = getUuid(r)
    let typ = getVarInt(r)
    let x = getF64Be(r)
    let y = getF64Be(r)
    let z = getF64Be(r)
    if not (eid.isOk and uuid.isOk and typ.isOk and x.isOk and y.isOk and z.isOk):
      return
    let velocity = LpVector3d.read(r)
    let pitch = getU8(r)
    let yaw = getU8(r)
    let headYaw = getU8(r)
    if not (velocity.isOk and pitch.isOk and yaw.isOk and headYaw.isOk):
      return
    let (_, playerType) = entityTypeByName("player")
    let pos = Vector3[float64](x: x.value, y: y.value, z: z.value)
    let entityId = eid.value.value
    if uint16(typ.value.value) == playerType.id:
      info("Bedrock: spawning player entity " & $entityId & " for Bedrock client " & s.player.gameprofile.name, PlayTarget)
    if uint16(typ.value.value) == playerType.id:
      var skin = steve()
      let name = block:
        var found = ""
        for p in s.world.players:
          if p.entityId == entityId:
            found = p.gameprofile.name
            skin = skinOfPlayer(p)
        found
      if name.len > 0:
        s.known[entityId] = KnownEntity(uuid: uuid.value, pos: pos, yaw: angleDegrees(yaw.value), pitch: angleDegrees(pitch.value),
          headYaw: angleDegrees(headYaw.value), isPlayer: true, typeName: "player", width: playerType.dimensionW,
          height: playerType.dimensionH, wool: -1)
        s.spawnPlayerFor(entityId, uuid.value, pos, angleDegrees(yaw.value), angleDegrees(pitch.value), name, skin)
    else:
      # `enqueue_spawn_packet`: a mob or an object, named by its registry key.
      let (known, entityType) = block:
        let found = EntityType.fromRaw(uint16(typ.value.value))
        if found.isSome: (true, found.unsafeGet) else: (false, playerType)
      if known:
        s.known[entityId] = KnownEntity(uuid: uuid.value, pos: pos, yaw: angleDegrees(yaw.value), pitch: angleDegrees(pitch.value),
          headYaw: angleDegrees(headYaw.value), isPlayer: false, typeName: entityType.resourceName, width: entityType.dimensionW,
          height: entityType.dimensionH, wool: (if entityType.resourceName == "sheep": 0 else: -1))
        # `Entity::bedrock_metadata`: the size from the type, the flags, the custom name of the live entity.
        let live = s.world.getEntityById(entityId)
        var customName = ""
        var nameVisible = false
        if live != nil:
          let entity = live.getEntity()
          if entity.customName.isSome:
            customName = entity.customName.unsafeGet.getText()
          nameVisible = entity.customNameVisible
        let metadata = bedrockMetadata(entityType.dimensionW, entityType.dimensionH, customName, nameVisible)
        var sentItem = false
        if live == nil and entityType.resourceName == "item":
          # The entity is added to the world after its spawn is written: the item actor goes out on a later pass.
          var k = s.known.getOrDefault(entityId)
          k.pending = true
          s.known[entityId] = k
          sentItem = true
        if live != nil:
          if entityType.resourceName == "item":
            # `ItemEntity::send_bedrock_spawn_packet`: a dropped item is `CAddItemActor`.
            let item = ItemEntity(live)
            let addItem = CAddItemActor(entityUniqueId: newVarLong(int64(entityId)), entityRuntimeId: newVarULong(uint64(entityId)),
              item: itemStackWrapperFromItemStack(item.itemStack), position: Vector3[float32](x: float32(pos.x), y: float32(pos.y),
              z: float32(pos.z)), velocity: Vector3[float32](x: 0.0'f32, y: 0.0'f32, z: 0.0'f32), metadata: metadata, fromFishing: false)
            var itemBody = newNetWriter()
            if packetWrite(addItem, itemBody).isOk:
              s.client.sendGameBody(CAddItemActorPacketId, itemBody.buf)
            sentItem = true
        if not sentItem:
          let add = CAddActor(entityUniqueId: newVarLong(int64(entityId)), entityRuntimeId: newVarULong(uint64(entityId)),
            entityType: "minecraft:" & entityType.resourceName, position: Vector3[float32](x: float32(pos.x), y: float32(pos.y),
            z: float32(pos.z)), velocity: Vector3[float32](x: 0.0'f32, y: 0.0'f32, z: 0.0'f32), pitch: angleDegrees(pitch.value),
            yaw: angleDegrees(yaw.value), headYaw: angleDegrees(headYaw.value), bodyYaw: angleDegrees(yaw.value), attributes: @[],
            metadata: metadata, syncedProperties: PropertySyncData(intProperties: @[], floatProperties: @[]), links: @[])
          var body = newNetWriter()
          if packetWrite(add, body).isOk:
            s.client.sendGameBody(CAddActorPacketId, body.buf)
  elif id == ids.removeEntities:
    let count = getVarInt(r)
    if count.isOk:
      for i in 0 ..< int(count.value.value):
        let eid = getVarInt(r)
        if not eid.isOk: break
        let entityId = eid.value.value
        if s.known.hasKey(entityId):
          s.known.del(entityId)
          s.client.sendGamePacket(CRemoveActorPacketId, newCRemoveActor(newVarLong(int64(entityId))))
  elif id == ids.posUpdate or id == ids.posRotUpdate:
    let eid = getVarInt(r)
    let dx = getI16Be(r)
    let dy = getI16Be(r)
    let dz = getI16Be(r)
    if not (eid.isOk and dx.isOk and dy.isOk and dz.isOk) or not s.known.hasKey(eid.value.value):
      return
    var k = s.known.getOrDefault(eid.value.value)
    k.pos = Vector3[float64](x: k.pos.x + float64(dx.value) / 4096.0, y: k.pos.y + float64(dy.value) / 4096.0,
      z: k.pos.z + float64(dz.value) / 4096.0)
    if id == ids.posRotUpdate:
      let yaw = getU8(r)
      let pitch = getU8(r)
      if yaw.isOk and pitch.isOk:
        k.yaw = angleDegrees(yaw.value)
        k.pitch = angleDegrees(pitch.value)
    s.known[eid.value.value] = k
    s.moveTo(eid.value.value, k)
  elif id == ids.posSync:
    let eid = getVarInt(r)
    let x = getF64Be(r)
    let y = getF64Be(r)
    let z = getF64Be(r)
    discard getF64Be(r)
    discard getF64Be(r)
    discard getF64Be(r)
    let yaw = getF32Be(r)
    let pitch = getF32Be(r)
    if not (eid.isOk and x.isOk and y.isOk and z.isOk and yaw.isOk and pitch.isOk) or not s.known.hasKey(eid.value.value):
      return
    var k = s.known.getOrDefault(eid.value.value)
    k.pos = Vector3[float64](x: x.value, y: y.value, z: z.value)
    k.yaw = yaw.value
    k.pitch = pitch.value
    s.known[eid.value.value] = k
    s.moveTo(eid.value.value, k)
  elif id == ids.entityMetadata:
    # The entries bedrockxlate.parseMetadata understands (flags, pose, baby, custom name, sheep wool), merged into what this
    # client was last told about the entity and sent whole.
    let md = parseMetadata(r)
    if md.entityId != s.player.entityId and s.known.hasKey(md.entityId):
      var k = s.known.getOrDefault(md.entityId)
      if md.hasFlags: k.jflags = md.flags
      if md.hasPose: k.pose = md.pose
      if md.hasBaby: k.baby = md.baby
      if md.hasName: k.name = md.name
      if md.hasNameVisible: k.nameVisible = md.nameVisible
      if md.hasWool and k.wool >= 0: k.wool = int(md.wool and 15'u8)
      if md.hasFlags or md.hasPose or md.hasBaby or md.hasName or md.hasNameVisible or md.hasWool:
        s.known[md.entityId] = k
        var body = newNetWriter()
        if packetWrite(CSetActorData(actorRuntimeId: newVarULong(uint64(md.entityId)),
            metadata: bedrockMetadataFor(k.width, k.height, k.jflags, k.pose, k.baby, k.name, k.nameVisible, k.wool),
            syncedProperties: PropertySyncData(intProperties: @[], floatProperties: @[]), tick: newVarULong(0'u64)), body).isOk:
          s.client.sendGameBody(CSetActorDataPacketId, body.buf)
  elif id == ids.gameEvent:
    # `GameEvent::ChangeGameMode`: the Bedrock twin is `CSetPlayerGamemode`.
    let event = getU8(r)
    let value = getF32Be(r)
    if event.isOk and value.isOk and event.value == uint8(ord(geChangeGameMode)):
      let mode = int(value.value)
      if mode >= 0 and mode <= 3:
        s.client.sendGamePacket(CSetPlayerGamemodePacketId, CSetPlayerGamemode(gamemode: GameMode(mode)))
    elif event.isOk and value.isOk:
      # Rain and thunder: Bedrock's level events.
      s.sendOuts(weatherEvents(event.value, value.value))
  elif id == ids.abilities:
    # `send_abilities_update`'s Bedrock arm, from the player's own abilities.
    let player = s.player
    let a = player.abilities
    s.client.sendGamePacket(CUpdateAbilitiesPacketId, bedrockAbilities(int64(player.entityId), a.allowFlying, a.flying,
      a.invulnerable, a.creative, player.permissionLvl == Four, player.gamemode == Spectator))
  elif id == ids.commands:
    # `send_bedrock_commands_packet`: the Java `CCommands` the join (or a plugin load) wrote, as `CAvailableCommands`.
    let dispatcher = s.server.commandDispatcher
    if dispatcher != nil:
      s.client.sendGamePacket(CAvailableCommandsPacketId, buildBedrockCommands(
        senderPlayer(s.server.commandPlayerOf(s.player)), s.server.commandServer, dispatcher))
  elif id == ids.openScreen:
    # The window's position is set after the packet is written: the Bedrock open is sent on the next pass.
    let syncId = getVarInt(r)
    if syncId.isOk:
      s.pendingOpen = int(syncId.value.value)
  elif id == ids.closeContainer:
    let syncId = getVarInt(r)
    if syncId.isOk:
      if s.pendingOpen == int(syncId.value.value):
        s.pendingOpen = -1
      else:
        s.client.sendGamePacket(SContainerClosePacketId, SContainerClose(containerId: uint8(syncId.value.value),
          containerType: s.openType, serverInitiated: true))
      s.invDirty = true
  elif id == ids.containerContent or id == ids.containerSlot or id == ids.cursor or id == ids.playerInventory:
    s.invDirty = true
  elif id == ids.batchEnd:
    # The client answers a chunk batch so that the server sends the next: the stand-in does it for it.
    s.ghost.handleChunkBatch(s.player, SChunkBatch(chunksPerTick: 25.0'f32))
  elif id == ids.health:
    let health = getF32Be(r)
    if health.isOk:
      s.client.sendGamePacket(CSetHealthPacketId, bset_health.CSetHealth(health: newVarInt(int32(health.value))))
  elif id == ids.headRot:
    let eid = getVarInt(r)
    let yaw = getU8(r)
    if eid.isOk and yaw.isOk and s.known.hasKey(eid.value.value):
      var k = s.known.getOrDefault(eid.value.value)
      k.headYaw = angleDegrees(yaw.value)
      s.known[eid.value.value] = k
      s.moveTo(eid.value.value, k)
  elif id == ids.playerPosition:
    # The server moved this player: say so to the client, and answer the teleport for it.
    let tid = getVarInt(r)
    let x = getF64Be(r)
    let y = getF64Be(r)
    let z = getF64Be(r)
    discard getF64Be(r)
    discard getF64Be(r)
    discard getF64Be(r)
    let yaw = getF32Be(r)
    let pitch = getF32Be(r)
    if tid.isOk and x.isOk and y.isOk and z.isOk and yaw.isOk and pitch.isOk:
      s.client.sendGamePacket(CMovePlayerPacketId, newCMovePlayer(newVarULong(uint64(s.player.entityId)),
        Vector3[float32](x: float32(x.value), y: float32(y.value + EyeHeight), z: float32(z.value)), pitch.value, yaw.value,
        yaw.value, CMovePlayerModeTeleport, true, newVarULong(0'u64), 0'i32, 0'i32, newVarULong(0'u64)))
      s.ghost.handleConfirmTeleport(s.player, SConfirmTeleport(teleportId: tid.value))
      if s.respawnPending:
        s.respawnPending = false
        s.sendOuts(@[healthAttribute(uint64(s.player.entityId), s.player.maxHealth)])
        s.client.sendGamePacket(RespawnPacketId, SRespawn(position: Vector3[float32](x: float32(x.value),
          y: float32(y.value + EyeHeight), z: float32(z.value)), state: rsReadyToSpawn,
          playerRuntimeId: newVarULong(uint64(s.player.entityId))))
        s.invDirty = true
  elif id == ids.animate:
    # Swing, wake up, crits of another entity (or the player's own, which Bedrock also takes).
    var peek = newNetReader(data)
    discard getVarInt(peek)
    let eid = getVarInt(peek)
    if eid.isOk and eid.value.value != s.player.entityId and s.known.hasKey(eid.value.value):
      s.sendOuts(xlateAnimation(r))
  elif id == ids.hurt:
    s.sendOuts(xlateHurt(r))
  elif id == ids.entityStatus:
    s.sendOuts(xlateEntityStatus(r))
  elif id == ids.mobEffect or id == ids.removeEffect:
    var peek = newNetReader(data)
    discard getVarInt(peek)
    let eid = getVarInt(peek)
    let effect = getVarInt(peek)
    if eid.isOk and effect.isOk and s.isKnownTarget(eid.value.value):
      let key = int64(eid.value.value) * 1000'i64 + int64(effect.value.value)
      if id == ids.removeEffect:
        s.effects.del(key)
        s.sendOuts(xlateRemoveEffect(r))
      else:
        let event = if s.effects.hasKey(key): MobEffectModify else: MobEffectAdd
        let outs = xlateMobEffect(r, event)
        if outs.len > 0:
          s.effects[key] = true
        s.sendOuts(outs)
  elif id == ids.equipment:
    let (eid, entries) = parseEquipment(r)
    if eid != s.player.entityId and s.known.hasKey(eid):
      var k = s.known.getOrDefault(eid)
      let outs = equipmentOuts(eid, entries, k.armor)
      s.known[eid] = k
      s.sendOuts(outs)
  elif id == ids.titleText:
    s.sendOuts(xlateTitle(2'i32, r))
  elif id == ids.subtitle:
    s.sendOuts(xlateTitle(3'i32, r))
  elif id == ids.actionBar:
    s.sendOuts(xlateTitle(4'i32, r))
  elif id == ids.titleAnim:
    s.sendOuts(xlateTitle(5'i32, r))
  elif id == ids.clearTitle:
    s.sendOuts(xlateTitle(0'i32, r))
  elif id == ids.bossEvent:
    s.sendOuts(xlateBossEvent(r, s.bossBars))
  elif id == ids.playerRemove:
    var entries: seq[PlayerListEntry] = @[]
    let removed = xlateRemovedPlayers(r)
    for i in 0 ..< removed.len:
      entries.add(PlayerListEntry(uuid: removed[i]))
    if entries.len > 0:
      var body = newNetWriter()
      if packetWrite(CPlayerList(action: CPlayerListActionRemove, entries: entries), body).isOk:
        s.client.sendGameBody(CPlayerListPacketId, body.buf)
  elif id == ids.playerInfo:
    # The tab list of a player who is not in view yet: the entry (the spawn of the entity adds it again, harmlessly).
    var entries: seq[PlayerListEntry] = @[]
    let added = xlateAddedPlayers(r)
    for i in 0 ..< added.len:
      let u = added[i][0]
      let name = added[i][1]
      for p in s.world.players:
        if $p.gameprofile.id == $u and p != s.player:
          entries.add(PlayerListEntry(uuid: u, entityUniqueId: newVarLong(int64(p.entityId)), username: name, xuid: "",
            platformChatId: "", buildPlatform: 0'i32, skin: skinOfPlayer(p), isTeacher: false, isHost: false, isSubClient: false,
            playerColor: [0'u8, 0'u8, 0'u8, 0'u8]))
    if entries.len > 0:
      var body = newNetWriter()
      if packetWrite(CPlayerList(action: CPlayerListActionAdd, entries: entries), body).isOk:
        s.client.sendGameBody(CPlayerListPacketId, body.buf)
  elif id == ids.combatDeath:
    # The death screen: health at nothing as an attribute (the `CSetHealth` goes with the Java health packet), the death animation.
    let own = uint64(s.player.entityId)
    s.sendOuts(@[healthAttribute(own, 0.0'f32), actorEvent(s.player.entityId, ActorEventDeath)])
  elif id == ids.respawn:
    # The Java respawn: Bedrock's twin is a respawn packet, searching for a spawn now and ready once the teleport follows.
    s.respawnPending = true
    s.effects = initTable[int64, bool]()
    s.client.sendGamePacket(RespawnPacketId, SRespawn(position: Vector3[float32](x: float32(s.player.pos.x),
      y: float32(s.player.pos.y + EyeHeight), z: float32(s.player.pos.z)), state: rsSearchingForSpawn,
      playerRuntimeId: newVarULong(uint64(s.player.entityId))))
  elif id == ids.disconnect:
    var consumed = 0
    let text = plainTextOfNbt(data, data.len - r.remaining(), consumed)
    s.gone = true
    s.client.kick(drKicked, text)
  elif id == ids.setTime:
    let gameTime = getI64Be(r)
    discard gameTime
    # The day time is in the clock update: a VarInt count, then (id, total ticks, partial tick, rate).
    let n = getVarInt(r)
    if n.isOk and n.value.value > 0:
      discard getVarInt(r)
      let total = getVarLong(r)
      if total.isOk:
        s.client.sendGamePacket(CSetTimePacketId, newCSetTime(int32(total.value.value mod 24000'i64)))

# --- the join ----------------------------------------------------------------------------------------------------------

proc newStandIn(): JavaClient =
  ## The `JavaClient` of a Bedrock player: no socket, nothing to flush. Its `tap` is set by `attach`.
  let c = newJavaClient(InvalidSocket, 0'u64)
  c.connectionState = csPlay
  c.gone = true
  c

proc attach(s: BedrockSession) =
  let session = s
  s.ghost.tap = proc(packet: seq[byte]) {.closure.} = translateJava(session, packet)
  s.ghost.bedrockSend = proc(packetId: int32; body: seq[byte]) {.closure.} =
    if session.started and not session.gone:
      session.client.sendGameBody(packetId, body)

proc bedrockGamemode(m: GameMode): int32 =
  case m
  of Survival: 0'i32
  of Creative: 1'i32
  of Adventure: 2'i32
  of Spectator: 6'i32

proc onReadyToPlay(ctx: BedrockContext; server: Server; client: BedrockClient; profile: GameProfile; config: PlayerConfig) =
  ## `PacketHandlerResult::ReadyToPlay` in the listener task: `server.add_player`, the player is set on the client.
  let ghost = newStandIn()
  ghost.gameprofile = some(profile)
  ghost.config = some(config)
  let (player, world) = server.addPlayer(ghost, profile, config)
  let s = BedrockSession(client: client, ghost: ghost, server: server, player: player, world: world, sent: initTable[int64, bool](),
    known: initTable[int32, KnownEntity](), radius: 0'i32, pendingOpen: -1, bossBars: newBossBars(),
    effects: initTable[int64, bool]())
  if client.clientData.isSome:
    s.skin = skinFromClientData(client.clientData.unsafeGet)
  else:
    s.skin = steve()
  s.attach()
  gSessions.add(s)
  client.hasPlayer = true
  info("Bedrock player " & profile.name & " joined (entity " & $player.entityId & ")", PlayTarget)

proc levelSettings(s: BedrockSession): LevelSettings =
  let world = s.world
  let info = world.levelInfo
  let bedrock = s.server.advancedConfig.networking.bedrock
  LevelSettings(seed: world.level.seed, spawnBiomeType: 0'i16, customBiomeName: "", dimension: newVarInt(0'i32),
    generatorType: newVarInt(1'i32), worldGamemode: s.server.basicConfig.defaultGamemode, hardcore: s.server.basicConfig.hardcore,
    difficulty: newVarInt(int32(ord(info.difficulty))), spawnPosition: newBlockPos(info.spawnX, info.spawnY, info.spawnZ),
    hasAchievementsDisabled: false, editorWorldType: newVarInt(0'i32), isCreatedInEditor: false, isExportedFromEditor: false,
    dayCycleStopTime: newVarInt(-1'i32), educationEditionOffer: newVarInt(0'i32), hasEducationFeaturesEnabled: false,
    educationProductId: "", rainLevel: world.weather.rainLevel, lightningLevel: world.weather.thunderLevel,
    hasConfirmedPlatformLockedContent: false, wasMultiplayerIntended: true, wasLanBroadcastingIntended: true,
    xboxLiveBroadcastSetting: gpsPublic, platformBroadcastSetting: gpsPublic, commandsEnabled: info.allowCommands,
    isTexturePacksRequired: false, ruleData: GameRules(listSize: newVarUInt(0'u32)), experiments: Experiments(namesSize: 0'u32, experimentsEverToggled: false),
    bonusChest: false, hasStartWithMapEnabled: false,
    permissionLevel: newVarInt(2'i32), # TODO upstream: Bedrock permission levels are different
    serverSimulationDistance: int32(bedrock.simulationDistance), hasLockedBehaviorPack: false, hasLockedResourcePack: false,
    isFromLockedWorldTemplate: false, isUsingMsaGamertagsOnly: false, isFromWorldTemplate: false,
    isWorldTemplateOptionLocked: false, isOnlySpawningV1Villagers: false, isDisablingPersonas: false,
    isDisablingCustomSkins: false, emoteChatMuted: false, gameVersion: CurrentBedrockMcVersion, limitedWorldWidth: 0'i32,
    limitedWorldHeight: 0'i32, newNether: true, eduSharedUriButtonName: "", eduSharedUriLinkUri: "",
    overrideForceExperimentalGameplayHasValue: false, chatRestrictionLevel: 0'i8, disablePlayerInteractions: false,
    serverEditorConnectionPolicy: newVarInt(0'i32), allowAnonymousBlockDropsInEditorWorlds: false)

proc sendWorld(s: BedrockSession) =
  ## `spawn_bedrock_player` up to the inventory: StartGame, the item registry, the creative content.
  let player = s.player
  let world = s.world
  let runtimeId = uint64(player.entityId)
  let info = world.levelInfo
  let at = if player.hasPlayedBefore: player.pos
    else: Vector3[float64](x: float64(info.spawnX) + 0.5, y: float64(info.spawnY), z: float64(info.spawnZ) + 0.5)
  s.client.sendGamePacket(CStartGamePacketId, CStartGame(entityId: newVarLong(int64(runtimeId)),
    runtimeEntityId: newVarULong(runtimeId), playerGamemode: player.gamemode,
    position: Vector3[float32](x: float32(at.x), y: float32(at.y + EyeHeight), z: float32(at.z)), pitch: player.pitch, yaw: player.yaw,
    levelSettings: s.levelSettings(), levelId: "", levelName: "Pumpkin world", premiumWorldTemplateId: "", isTrial: false,
    rewindHistorySize: newVarInt(0'i32), serverAuthoritativeBlockBreaking: true, currentLevelTime: uint64(world.levelTime.worldAge),
    enchantmentSeed: newVarInt(0'i32), blockPropertiesSize: newVarUInt(0'u32), multiplayerCorrelationId: "",
    enableItemstackNetManager: true, serverVersion: "Pumpkin Rust Server", compoundId: 10'i8, compoundLen: newVarUInt(0'u32),
    compoundEnd: 0'i8, blockRegistryChecksum: 0'u64, worldTemplateId: NilUuid, enableClientsideGeneration: false,
    blocknetworkIdsAreHashed: false, serverAuthSounds: true, isLoggingChat: false,
    serverJoinInformation: none[ServerJoinInformation](),
    telemetry: ServerTelemetryData(serverId: "", scenarioId: "", worldId: "", ownerId: "")))
  var items: seq[ItemDefinition] = @[]
  for b in ALL_BEDROCK_ITEMS:
    items.add(ItemDefinition(name: b.registryKey, id: b.id, componentBased: b.componentBased,
      itemVersion: newVarInt(case b.version
        of bivLegacy: 0'i32
        of bivDataDriven: 1'i32
        of bivNone: 2'i32), componentData: b.definitionComponents))
  s.client.sendGamePacket(CItemRegistryPacketId, CItemRegistry(items: items))
  var groups: seq[Group] = @[]
  let creativeGroupList = creativeGroups()
  for g in creativeGroupList:
    let category = case g.category
      of 1: ccConstruction
      of 2: ccNature
      of 3: ccEquipment
      of 4: ccItems
      of 5: ccCommandOnly
      else: ccUndefined
    var icon = defaultNetworkItemDescriptor()
    if g.iconItemId != 0'i16:
      icon = NetworkItemDescriptor(id: newVarInt(int32(g.iconItemId)), stackSize: 1'u16, auxValue: newVarUInt(g.iconItemAuxValue),
        blockRuntimeId: newVarInt(0'i32), nbtData: icon.nbtData, placeOnBlocks: @[], destroyBlocks: @[], shieldBlockingTick: 0'i64)
    groups.add(Group(creativeCategory: category, name: g.name, iconItem: icon))
  var entries: seq[Entry] = @[]
  var n = 0'u32
  let creativeEntryList = creativeEntries()
  for e in creativeEntryList:
    n += 1'u32
    var item = defaultNetworkItemDescriptor()
    item = NetworkItemDescriptor(id: newVarInt(int32(e.itemId)), stackSize: 1'u16, auxValue: newVarUInt(e.itemAuxValue),
      blockRuntimeId: newVarInt(0'i32), nbtData: item.nbtData, placeOnBlocks: @[], destroyBlocks: @[], shieldBlockingTick: 0'i64)
    entries.add(Entry(id: newVarUInt(n), item: item, groupIndex: newVarUInt(e.groupIndex)))
  s.client.sendGamePacket(CCreativeContentPacketId, CCreativeContent(groups: groups, entries: entries))
  s.client.sendGamePacket(CSetTimePacketId, newCSetTime(int32(world.levelTime.timeOfDay mod 24000'i64)))
  var slots: seq[NetworkItemStackDescriptor] = @[]
  for stack in player.inventory.mainInventory:
    slots.add(networkItemStackDescriptorFromItemStack(stack))
  s.client.sendGamePacket(CInventoryContentPacketId, CInventoryContent(containerId: newVarUInt(0'u32), slots: slots,
    fullContainerName: FullContainerName(containerName: cnInventory, dynamicId: none[uint32]()),
    storageItem: defaultNetworkItemStackDescriptor()))
  # `BEDROCK_CRAFTING_DATA`: the recipes, before the inventory as upstream sends them.
  s.client.sendGamePacket(CCraftingDataPacketId, CCraftingData(recipes: bedrockCraftingRecipes(), cleanRecipes: false))
  s.client.sendInventory(player)
  var actorBody = newNetWriter()
  let (_, playerType) = entityTypeByName("player")
  if packetWrite(CSetActorData(actorRuntimeId: newVarULong(runtimeId),
      metadata: bedrockMetadata(playerType.dimensionW, playerType.dimensionH, "", false),
      syncedProperties: PropertySyncData(intProperties: @[], floatProperties: @[]), tick: newVarULong(0'u64)), actorBody).isOk:
    s.client.sendGameBody(CSetActorDataPacketId, actorBody.buf)
  s.started = true

proc onResourcePacksCompleted(ctx: BedrockContext; client: BedrockClient): bool =
  ## `STATUS_COMPLETED`: `world.spawn_bedrock_player`.
  let s = findSession(client)
  if s == nil:
    return false
  s.sendWorld()
  # The rest is the Java join, whose packets the stand-in turns back into Bedrock ones.
  s.world.spawnJavaPlayer(s.server.basicConfig, s.player, s.server)
  # The last of `spawn_bedrock_player`: the attributes, after the commands the join wrote.
  s.client.sendGamePacket(bupdate_attributes.CUpdateAttributesPacketId, spawnAttributes(uint64(s.player.entityId)))
  true

# --- chunks ------------------------------------------------------------------------------------------------------------

proc chunkKeyOf(x, z: int32): int64 = (int64(x) shl 32) xor int64(uint32(z))

proc pumpChunks(s: BedrockSession) =
  ## `send_chunks` for the chunks the Java chunk manager has sent the stand-in, and `NetworkChunkPublisherUpdate` when the
  ## player's chunk changes.
  if not s.started or s.player.pendingSpawn.active:
    return
  let player = s.player
  let cx = int32(floor(player.pos.x)) shr 4
  let cz = int32(floor(player.pos.z)) shr 4
  if not s.publisherSent or s.center.x != cx or s.center.y != cz:
    s.center = Vector2[int32](x: cx, y: cz)
    s.publisherSent = true
    let radius = if s.radius > 0: uint32(s.radius) * 16'u32 else: 128'u32
    s.client.sendGamePacket(CNetworkChunkPublisherUpdatePacketId, newCNetworkChunkPublisherUpdate(
      newBlockPos(int32(floor(player.pos.x)), int32(floor(player.pos.y)), int32(floor(player.pos.z))), radius))
  var sentNow = 0
  var live = initTable[int64, bool]()
  for key, chunk in player.chunkManager.chunkSent:
    live[key] = true
    if not s.sent.hasKey(key) and sentNow < MaxChunksPerPass and chunk != nil:
      s.sent[key] = true
      sentNow += 1
      if not callBedrockChunkSendHook(player, chunk):
        s.client.sendGamePacket(CLevelChunkPacketId, CLevelChunk(dimension: 0'i32, cacheEnabled: false, chunk: chunk))
  var gone: seq[int64] = @[]
  for key, _ in s.sent:
    if not live.hasKey(key):
      gone.add(key)
  for key in gone:
    s.sent.del(key)
  if not s.spawned and s.sent.len > 0 and (player.chunkManager.chunkQueue.len == 0 or s.sent.len >= 9):
    s.spawned = true
    s.client.sendGamePacket(CPlayStatusPacketId, cpsPlayerSpawn)

proc pumpPendingItems(s: BedrockSession) =
  ## The dropped items whose entity was not in the world yet when their spawn packet was written.
  var ids: seq[int32] = @[]
  for id, k in s.known:
    if k.pending:
      ids.add(id)
  for id in ids:
    var k = s.known.getOrDefault(id)
    let live = s.world.getEntityById(id)
    if live != nil:
      let item = ItemEntity(live)
      let metadata = bedrockMetadata(0.25'f32, 0.25'f32, "", false)
      let addItem = CAddItemActor(entityUniqueId: newVarLong(int64(id)), entityRuntimeId: newVarULong(uint64(id)),
        item: itemStackWrapperFromItemStack(item.itemStack), position: Vector3[float32](x: float32(k.pos.x), y: float32(k.pos.y),
        z: float32(k.pos.z)), velocity: Vector3[float32](x: 0.0'f32, y: 0.0'f32, z: 0.0'f32), metadata: metadata, fromFishing: false)
      var body = newNetWriter()
      if packetWrite(addItem, body).isOk:
        s.client.sendGameBody(CAddItemActorPacketId, body.buf)
      k.pending = false
      s.known[id] = k
    else:
      k.tries += 1
      if k.tries > 40:
        s.known.del(id)
      else:
        s.known[id] = k

proc pumpInventory(s: BedrockSession) =
  ## What the Java container packets said, as Bedrock: a window the server opened, and the inventory again.
  if not s.started or not s.spawned:
    return
  s.pumpPendingItems()
  if s.pendingOpen >= 0:
    let syncId = uint8(s.pendingOpen)
    s.pendingOpen = -1
    let b = s.player.currentScreenHandler.getBehaviour()
    if b.windowType.isSome and b.syncId == syncId:
      s.openType = bedrockContainerType(b.windowType.unsafeGet)
      s.client.sendOpenContainer(s.player)
      s.invDirty = false
  if s.invDirty:
    s.invDirty = false
    s.client.sendInventory(s.player)
    s.client.sendContainerSlots(s.player)

# --- Bedrock to Java ---------------------------------------------------------------------------------------------------

proc handleRequestChunkRadius(s: BedrockSession; packet: SRequestChunkRadius) =
  ## `handle_request_chunk_radius`.
  if packet.chunkRadius.value < 1:
    s.client.kick(drKicked, "Cannot have zero or negative view distance!")
    return
  let maxDistance = int32(s.server.advancedConfig.networking.bedrock.viewDistance)
  let viewDistance = max(min(packet.chunkRadius.value, maxDistance), 2'i32)
  s.client.sendGamePacket(CChunkRadiusUpdatePacketId, CChunkRadiusUpdate(chunkRadius: newVarInt(viewDistance)))
  s.radius = viewDistance
  s.player.config.viewDistance = uint8(viewDistance)
  s.player.chunkManager.viewDistance = uint8(viewDistance)
  s.publisherSent = false
  updatePosition(s.player, s.server)

proc handleInitialized(s: BedrockSession; packet: SSetLocalPlayerAsInitialized) =
  ## `handle_set_local_player_as_initialized`.
  debug("Player " & s.player.gameprofile.name & " initialized (Runtime ID: " & $packet.runtimeEntityId.value & ")", PlayTarget)
  handlePlayerLoaded(s.player)
  if getEnv("PUMPKIN_BEDROCK_TEST_FORM").len > 0:
    # A test hook for tools/runbedrockfull.py: a plugin sends forms through `sendBedrockForm`, nothing else here does.
    s.client.nextFormId += 1'u32
    s.client.sendGamePacket(CModalFormRequestPacketId, CModalFormRequest(formId: newVarInt(int32(s.client.nextFormId)),
      formData: "{\"type\":\"modal\",\"title\":\"T\",\"content\":\"C\",\"button1\":\"yes\",\"button2\":\"no\"}"))

proc javaStatusOf(a: PlayerActionType): (bool, int32) =
  ## The Java `Status` for a Bedrock action: 0 started digging, 1 cancelled, 2 finished, 4 drop item.
  case a
  of patStartBreak, patCreativePlayerDestroyBlock, patContinueDestroyBlock: (true, 0'i32)
  of patAbortBreak: (true, 1'i32)
  of patStopBreak, patPredictDestroyBlock: (true, 2'i32)
  of patDropItem: (true, 4'i32)
  else: (false, 0'i32)

proc handleBlockAction(s: BedrockSession; pos: BlockPos; actionType: PlayerActionType; face: int32) =
  ## `handle_player_action`, whose digging arms are Java's `handle_player_action` with the status renumbered.
  let (known, status) = javaStatusOf(actionType)
  if known and s.player.hasClientLoaded():
    s.ghost.handlePlayerAction(s.player, jplayer_action.SPlayerAction(status: newVarInt(status), position: pos, face: uint8(face), sequence: newVarInt(0'i32)),
      s.server)

proc handleRespawnRequest(s: BedrockSession) =
  ## `PlayerAction::Respawn` of a dead player (`handle_player_action`): the Java "perform respawn" client command, whose
  ## `respawn_player` writes the Java respawn the stand-in turns into Bedrock's respawn packets.
  if s.player.dead or s.player.health <= 0.0'f32:
    s.ghost.handleClientStatus(s.player, SClientCommand(actionId: newVarInt(0'i32)))

proc handleAuthInput(s: BedrockSession; packet: SPlayerAuthInput) =
  ## `handle_player_auth_input`: the position and rotation as a `SPlayerPositionRotation`, the sprint and sneak toggles, the
  ## block actions.
  let player = s.player
  if not player.hasClientLoaded():
    return
  let newPos = Vector3[float64](x: float64(packet.position.x), y: float64(packet.position.y) - EyeHeight, z: float64(packet.position.z))
  let moved = newPos.x != player.pos.x or newPos.y != player.pos.y or newPos.z != player.pos.z
  let turned = packet.pitch != player.pitch or packet.yaw != player.yaw
  if moved or turned:
    let onGround = abs(packet.delta.y) < 0.0001'f32
    s.ghost.handlePositionRotation(player, s.server, SPlayerPositionRotation(position: newPos, yaw: packet.yaw, pitch: packet.pitch,
      collision: if onGround: FlagOnGround else: 0'u8))
  let bits = packet.inputData
  if bits.get(ord(idStartSprinting)):
    player.sprinting = true
  elif bits.get(ord(idStopSprinting)):
    player.sprinting = false
  if bits.get(ord(idStartSneaking)):
    player.sneaking = true
  elif bits.get(ord(idStopSneaking)):
    player.sneaking = false
  if packet.blockActions.isSome:
    for action in packet.blockActions.unsafeGet:
      if action.action.value >= 0'i32 and action.action.value <= 36'i32:
        s.handleBlockAction(action.blockPos, PlayerActionType(action.action.value), action.face.value)

proc handleText(s: BedrockSession; packet: SText) =
  ## `handle_chat_message`: the not-reported branch, a system message to everyone.
  let player = s.player
  player.updateLastActionTime()
  let name = player.gameprofile.name
  info("<chat> " & name & ": " & packet.message, PlayTarget)
  let config = s.server.advancedConfig
  let decorated = chatDecorated(config.chat.format, name, packet.message)
  s.world.broadcastPacketAll(CSystemChatMessage(content: decorated, overlay: false))

proc handleCommandRequest(s: BedrockSession; packet: SCommandRequest) =
  ## `handle_chat_command`.
  var command = packet.command
  if command.len > 0 and command[0] == '/':
    command = command[1 ..< command.len]
  s.ghost.handleChatCommand(s.player, s.server, SChatCommand(command: command))

proc handleUseItemTransaction(s: BedrockSession; data: UseItemTransactionData) =
  ## `TransactionData::UseItem` for a click on a block (action type 0): the held item comes from the client's, then Java's `handle_use_item_on`.
  let player = s.player
  if player.gamemode == Spectator or data.actionType.value > 1'u32:
    return
  let clientStack = descriptorToStack(data.itemInHand, player.gamemode == Creative)
  if not clientStack.isEmpty():
    let held = player.inventory.heldItem()
    if held.isEmpty() or held.item.id != clientStack.item.id:
      player.inventory.setHeldItem(clientStack)
  if data.actionType.value == 1'u32:
    # Click air / use item: `handle_use_item`.
    s.ghost.handleUseItem(player, SUseItem(hand: newVarInt(0'i32), sequence: newVarInt(0'i32), yaw: player.yaw, pitch: player.pitch),
      s.server)
    return
  let face = case data.blockFace
    of 0: 0'i32
    of 2: 2'i32
    of 3: 3'i32
    of 4: 4'i32
    of 5: 5'i32
    else: 1'i32
  discard s.ghost.handleUseItemOn(player, SUseItemOn(hand: newVarInt(0'i32), position: data.blockPosition, face: newVarInt(face),
    cursorPos: data.clickPosition, insideBlock: false, isAgainstWorldBorder: false, sequence: newVarInt(0'i32)), s.server)

proc handleInventoryTransaction(s: BedrockSession; packet: SInventoryTransaction) =
  ## `handle_inventory_action`.
  let player = s.player
  let updates = handleInventoryActions(s.client, player, packet)
  case packet.transactionData.kind
  of tdUseItem:
    s.handleUseItemTransaction(packet.transactionData.useItem)
  of tdUseItemOnEntity:
    let data = packet.transactionData.useItemOnEntity
    let target = int32(data.targetEntityRuntimeId.value)
    case data.actionType.value
    of 0'u32, 2'u32:
      s.ghost.handleInteract(player, jinteract.SInteract(entityId: newVarInt(target), interactType: newVarInt(0'i32),
        targetPosition: none[Vector3[float64]](), hand: some(newVarInt(0'i32)), sneaking: player.sneaking), s.server)
    of 1'u32:
      s.ghost.handleAttack(player, jattack.SAttack(entityId: newVarInt(target)), s.server)
    else:
      warn("invalid UseItemOnEntity action type " & $data.actionType.value, PlayTarget)
  of tdReleaseItem:
    # `item_registry.on_stopped_using` and `clear_active_hand`: Java's "finish using item" is the same.
    s.ghost.handlePlayerAction(player, jplayer_action.SPlayerAction(status: newVarInt(5'i32),
      position: newBlockPos(0'i32, 0'i32, 0'i32), face: 0'u8, sequence: newVarInt(0'i32)), s.server)
  else:
    discard
  sendLegacyResponse(s.client, packet, updates)

proc handleAnimate(s: BedrockSession; packet: SAnimate) =
  ## `handle_animate`: the animation goes to every player of the world as a Java animation or as the Bedrock packet itself.
  let player = s.player
  player.updateLastActionTime()
  if not player.hasClientLoaded():
    return
  var animation = janim.anSwingMainArm
  case packet.action
  of aaSwingArm: animation = janim.anSwingMainArm
  of aaWakeUp: animation = janim.anLeaveBed
  of aaCriticalHit: animation = janim.anCriticalEffect
  of aaMagicCriticalHit: animation = janim.anMagicCriticaleffect
  of aaStopSleep: return  # upstream: TODO
  player.world.broadcastEditioned(janim.newCEntityAnimation(newVarInt(player.entityId), animation), CAnimatePacketId,
    SAnimate(action: packet.action, runtimeEntityId: newVarULong(uint64(player.entityId)), data: 0.0'f32,
      swingSource: none[AnimateSwingSource]()))

proc handleEmote(s: BedrockSession; packet: SEmote) =
  ## `handle_emote`: the others are told, with the server-side flag; Java players see an arm swing.
  if not s.player.hasClientLoaded():
    return
  var broadcast = packet
  broadcast.flags = broadcast.flags or EMOTE_FLAG_SERVER_SIDE
  s.player.world.broadcastPacketExceptEditioned([s.player.gameprofile.id],
    janim.newCEntityAnimation(newVarInt(s.player.entityId), janim.anSwingMainArm), SEmotePacketId, broadcast)

proc handleRequestAbility(s: BedrockSession; packet: SRequestAbility) =
  ## `handle_request_ability`: flying (ability 9) only.
  let player = s.player
  player.updateLastActionTime()
  if packet.ability.value == 9'i32:
    if packet.value.kind == avBool:
      if player.abilities.allowFlying:
        player.abilities.flying = packet.value.boolValue
      else:
        player.abilities.flying = false
      player.sendAbilitiesUpdate()
  else:
    debug("Received RequestAbility packet for unhandled ability " & $packet.ability.value, PlayTarget)

proc handleMobEquipment(s: BedrockSession; packet: SMobEquipment) =
  ## `handle_mob_equipment`: the selected hotbar slot.
  let player = s.player
  player.updateLastActionTime()
  let slot = packet.hotbarSlot
  if slot >= 9'u8:
    return
  let previousSlot = player.inventory.getSelectedSlot()
  var heldEv = newPlayerItemHeldEvent(player, uint8(previousSlot), slot)
  firePlayerItemHeld(heldEv)
  if heldEv.cancelled:
    s.client.sendGamePacket(CPlayerHotbarPacketId, CPlayerHotbar(selectedSlot: newVarUInt(uint32(previousSlot)), containerId: 0'u8,
      shouldSelectBlock: true))
    return
  player.inventory.setSelectedSlot(slot)
  player.sendEquipmentChanges([(esMainHand, player.inventory.heldItem())])

proc handleFormResponse(s: BedrockSession; packet: SModalFormResponse) =
  ## `handle_modal_form_response`.
  info("Bedrock form " & $packet.formId.value & " answered by " & s.player.gameprofile.name & ": " &
    (if packet.formData.isSome: packet.formData.unsafeGet else: "(closed)"), PlayTarget)
  fireBedrockFormResponse(newBedrockFormResponseEvent(s.player, uint32(packet.formId.value), packet.formData))

proc handleInteract(s: BedrockSession; r: var NetReader) = discard

proc onPlayPacket(client: BedrockClient; packet: RawPacket) =
  ## `handle_play_packet`.
  let s = findSession(client)
  if s == nil or s.gone:
    return
  if callBedrockPacketReceivedHook(s.player, packet.id, packet.payload) or
      callPluginPacketReceivedHook(s.player, packet.id, packet.payload):
    return
  var r = newNetReader(packet.payload)
  case packet.id
  of SClientCacheStatusPacketId:
    discard
  of SPlayerAuthInputPacketId:
    let p = packetRead(SPlayerAuthInput, r)
    if p.isOk: s.handleAuthInput(p.value)
    else: error("Failed to handle Bedrock play packet: " & p.error.msg, PlayTarget)
  of SRequestChunkRadiusPacketId:
    let p = packetRead(SRequestChunkRadius, r)
    if p.isOk: s.handleRequestChunkRadius(p.value)
  of SSetLocalPlayerAsInitializedPacketId:
    let p = packetRead(SSetLocalPlayerAsInitialized, r)
    if p.isOk: s.handleInitialized(p.value)
  of STextPacketId:
    let p = packetRead(SText, r)
    if p.isOk: s.handleText(p.value)
  of SCommandRequestPacketId:
    let p = packetRead(SCommandRequest, r)
    if p.isOk: s.handleCommandRequest(p.value)
  of SModalFormResponsePacketId:
    let p = packetRead(SModalFormResponse, r)
    if p.isOk: s.handleFormResponse(p.value)
  of SInventoryTransactionPacketId:
    let p = packetRead(SInventoryTransaction, r)
    if p.isOk: s.handleInventoryTransaction(p.value)
    else: error("Failed to handle Bedrock play packet: " & p.error.msg, PlayTarget)
  of SItemStackRequestPacketId:
    let p = packetRead(SItemStackRequest, r)
    if p.isOk: handleItemStackRequest(s.client, s.player, p.value)
    else: error("Failed to handle Bedrock play packet: " & p.error.msg, PlayTarget)
  of SBlockPickRequestPacketId:
    let p = packetRead(SBlockPickRequest, r)
    if p.isOk: handleBlockPickRequest(s.client, s.player, p.value)
  of SInteractionPacketId:
    let p = packetRead(SInteraction, r)
    if p.isOk: handleInteraction(s.client, s.ghost, s.player, s.server, p.value)
  of SContainerClosePacketId:
    let p = packetRead(SContainerClose, r)
    if p.isOk: handleContainerClose(s.client, s.player, p.value)
  of SEmotePacketId:
    let p = packetRead(SEmote, r)
    if p.isOk: s.handleEmote(p.value)
  of SRequestAbilityPacketId:
    let p = packetRead(SRequestAbility, r)
    if p.isOk: s.handleRequestAbility(p.value)
  of SMobEquipmentPacketId:
    let p = packetRead(SMobEquipment, r)
    if p.isOk: s.handleMobEquipment(p.value)
  of SPlayerActionPacketId:
    let p = packetRead(player_action.SPlayerAction, r)
    if p.isOk:
      if p.value.action == patRespawn:
        s.handleRespawnRequest()
      else:
        s.handleBlockAction(p.value.blockPos, p.value.action, p.value.face.value)
  of RespawnPacketId:
    # The client confirming the respawn (state 2): upstream answers a dead player with ready-to-spawn; a player already alive
    # needs nothing more.
    let p = packetRead(SRespawn, r)
    if p.isOk and p.value.state == rsClientReadyToSpawn:
      if s.player.dead or s.player.health <= 0.0'f32:
        s.client.sendGamePacket(RespawnPacketId, SRespawn(position: p.value.position, state: rsReadyToSpawn,
          playerRuntimeId: newVarULong(uint64(s.player.entityId))))
      else:
        s.invDirty = true
  of SAnimatePacketId:
    let p = packetRead(SAnimate, r)
    if p.isOk: s.handleAnimate(p.value)
  else:
    debug("Bedrock: unhandled game packet " & $packet.id, PlayTarget)

proc onClientClosed(ctx: BedrockContext; client: BedrockClient) =
  let s = findSession(client)
  if s == nil:
    return
  s.gone = true
  var kept: seq[BedrockSession] = @[]
  for other in gSessions:
    if other != s:
      kept.add(other)
  gSessions = kept
  s.server.removePlayer(s.player)
  info("Bedrock player " & s.player.gameprofile.name & " left", PlayTarget)

proc sendBedrockForm*(player: Player; formData: string): uint32 =
  ## `send_form` for a Bedrock player (`Player::send_form` upstream, which takes the next `next_form_id` of the client): the id
  ## the response event will carry, 0 for a player who is not on Bedrock.
  let s = sessionOfPlayer(player)
  if s == nil or s.gone:
    return 0'u32
  s.client.nextFormId += 1'u32
  let id = s.client.nextFormId
  s.client.sendGamePacket(CModalFormRequestPacketId, CModalFormRequest(formId: newVarInt(int32(id)), formData: formData))
  id

# The plugin host's `player.as-bedrock` and `bedrock-player.open-form` (src/plugin/wit/witplayer3.aowl) reach this module through the
# hooks of pluginhooks.aowl: the host sits above the server and cannot import it.
gPluginBedrockSessionHook = proc(player: Player): bool {.closure.} = sessionOfPlayer(player) != nil
gPluginBedrockFormHook = proc(player: Player; formData: string): uint32 {.closure.} = sendBedrockForm(player, formData)

proc fetchBedrockOidc*(ctx: BedrockContext) =
  ## `Server::new`'s fetch of the Xbox OIDC discovery document and its JWKS for `bedrock_oidc_keys`, which the online-mode login
  ## verifies the client's token against. One blocking pass at startup, as upstream awaits it; a failure is logged and the keys
  ## stay unset, so a full login is refused with "OIDC keys not initialized" until the server is restarted. (A Bedrock server
  ## that stays up for days would want a refresh: upstream does not do one either.)
  if not ctx.config.onlineMode or not ctx.config.authentication.enabled:
    return
  let httpGet = proc(url: string; connectMs, readMs: uint32): (bool, string) {.closure.} =
    let res = winHttpGet(url, int(connectMs), int(readMs))
    (res.ok and res.status >= 200 and res.status < 300, res.body)
  let fetched = fetchOidcJwks(httpGet, ctx.config.authentication.url, ctx.config.authentication.connectTimeout,
    ctx.config.authentication.readTimeout)
  if fetched.isOk:
    let (issuer, jwks) = fetched.value
    ctx.oidcIssuer = issuer
    ctx.oidcJwks = some(jwks)
    info("Bedrock: fetched the Xbox OIDC keys", PlayTarget)
  else:
    error("Bedrock: could not fetch the Xbox OIDC keys: " & fetched.error.detail, PlayTarget)

# --- the loop ----------------------------------------------------------------------------------------------------------

proc pumpBedrockPlay*() =
  ## One pass for every Bedrock player: chunks out, and the stand-in's idle kick or kick in.
  for s in gSessions:
    if s.gone:
      continue
    if s.ghost.isClosed() and not s.client.isClosed():
      s.gone = true
      s.client.kick(drKicked, "Disconnected")
      continue
    s.pumpChunks()
    s.pumpInventory()

proc bedrockHooks*(server: Server): BedrockHooks =
  ## What the Bedrock listener asks of the server (`BedrockHooks`), with the player and world side.
  gServer = server
  gBedrockSendFilter = proc(client: BedrockClient; packetId: int32; body: seq[byte]): bool {.closure.} =
    let s = findSession(client)
    if s == nil:
      return false
    s.started and (callBedrockPacketSentHook(s.player, packetId, body) or callPacketSentHook(s.ghost, packetId, body))
  let hooks = BedrockHooks()
  let ctxRef = BedrockContext()
  hooks.playerCount = proc(): int {.closure.} = server.getPlayerCount()
  hooks.levelName = proc(): string {.closure.} = worldNameOf(server.levelFolder)
  hooks.onReadyToPlay = proc(client: BedrockClient; profile: GameProfile; config: PlayerConfig) {.closure.} =
    onReadyToPlay(ctxRef, server, client, profile, config)
  hooks.onResourcePacksCompleted = proc(client: BedrockClient): bool {.closure.} = onResourcePacksCompleted(ctxRef, client)
  hooks.onPlayPacket = proc(client: BedrockClient; packet: RawPacket) {.closure.} = onPlayPacket(client, packet)
  hooks.onClientClosed = proc(client: BedrockClient) {.closure.} = onClientClosed(ctxRef, client)
  hooks
