## Test for the plugin hooks bedrockplay.aowl sets (`gPluginBedrockVersionHook`, `gPluginBedrockDataHook`,
## `gPluginBedrockSendHook`): the version case of the client, its login `ClientData`, and a packet body sent to the client.
## No session gives the defaults (unknown, none, false), as `sessionOfPlayer` is nil for a Java player.
import std/[options, syncio]
import ../../../protocol/serial
import ../../../protocol/bedrock/server/login as slogin
import ../../../util/javaversion
import bedrockclient
import bedrockplay

proc expect(ok: bool; what: string) =
  if not ok:
    echo "FAILED: " & what
    quit(1)

var sentBytes = 0
let sendRaw = proc(data: seq[byte]) {.closure.} = sentBytes += data.len
let client = newBedrockClient(serial.SocketAddr(), 0'u32, 0'u16, sendRaw, 0'i64)
let session = BedrockSession(client: client)

client.version = bmvV1_21
expect(bedrockVersionCase(session) == 0, "1.21 is case 0")
client.version = bmvV1_26_30
expect(bedrockVersionCase(session) == 1, "1.26.30 is case 1")
client.version = bmvUnknown
expect(bedrockVersionCase(session) == 2, "unknown is case 2")
expect(bedrockVersionCase(nil) == 2, "no session is case 2")

expect(bedrockDataOf(session).isNone, "no client data before the login sent it")
expect(bedrockDataOf(nil).isNone, "no session has no client data")
var cd = slogin.ClientData()
cd.languageCode = "en_US"
client.clientData = some(cd)
let got = bedrockDataOf(session)
expect(got.isSome and got.unsafeGet.languageCode == "en_US", "the client data the login stored")

sentBytes = 0
expect(sendBedrockBody(session, 9'i32, @[1'u8, 2'u8, 3'u8]), "a live session accepts a packet")
expect(sentBytes > 0, "the packet went out through the client's raw send")
expect(not sendBedrockBody(nil, 9'i32, @[1'u8]), "no session sends nothing")

echo "bedrockplay hooks ok"
