    drNetherNetFailedToCreateAnswer = 92
    drNetherNetFailedToSetLocalDescription = 93
    drNetherNetFailedToSetRemoteDescription = 94
    drNetherNetNegotiationTimeoutWaitingForResponse = 95
    drNetherNetNegotiationTimeoutWaitingForAccept = 96
