## Port of the `DisconnectReason` enum of pumpkin/src/net/mod.rs (Bedrock's disconnect reasons, `repr` the integer that goes
## in `CDisconnectPlayer.reason`). The rest of that file is netbase.aowl. Variants are prefixed `dr` and keep
## upstream's order and values (0 ..= 121).

type
  DisconnectReason* = enum
    drUnknown = 0
    drCantConnectNoInternet = 1
    drNoPermissions = 2
    drUnrecoverableError = 3
    drThirdPartyBlocked = 4
    drThirdPartyNoInternet = 5
    drThirdPartyBadIP = 6
    drThirdPartyNoServerOrServerLocked = 7
    drVersionMismatch = 8
    drSkinIssue = 9
    drInviteSessionNotFound = 10
    drEduLevelSettingsMissing = 11
    drLocalServerNotFound = 12
    drLegacyDisconnect = 13
    drUserLeaveGameAttempted = 14
    drPlatformLockedSkinsError = 15
    drRealmsWorldUnassigned = 16
    drRealmsServerCantConnect = 17
    drRealmsServerHidden = 18
    drRealmsServerDisabledBeta = 19
    drRealmsServerDisabled = 20
    drCrossPlatformDisabled = 21
    drCantConnect = 22
    drSessionNotFound = 23
    drClientSettingsIncompatibleWithServer = 24
    drServerFull = 25
    drInvalidPlatformSkin = 26
    drEditionVersionMismatch = 27
    drEditionMismatch = 28
    drLevelNewerThanExeVersion = 29
    drNoFailOccurred = 30
    drBannedSkin = 31
    drTimeout = 32
    drServerNotFound = 33
