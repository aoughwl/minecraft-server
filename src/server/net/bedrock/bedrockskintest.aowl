## Test for bedrockskin.aowl: the PNG decoder against a 3x5 RGB image whose rows use all five filters (made with Python's zlib),
## the textures property, and the 64x32 padding of a skin.
import std/[syncio, options]
import ../../../protocol/bedrock/client/player_list
import ../netbase
import bedrockskin

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "  ok  ", what
  else:
    echo "FAIL  ", what
    failures += 1

const Png: array[109, byte] = [0x89'u8,0x50'u8,0x4e'u8,0x47'u8,0x0d'u8,0x0a'u8,0x1a'u8,0x0a'u8,0x00'u8,0x00'u8,0x00'u8,0x0d'u8,0x49'u8,0x48'u8,0x44'u8,0x52'u8,0x00'u8,0x00'u8,0x00'u8,0x03'u8,0x00'u8,0x00'u8,0x00'u8,0x05'u8,0x08'u8,0x02'u8,0x00'u8,0x00'u8,0x00'u8,0x0f'u8,0x13'u8,0xc1'u8,0xf5'u8,0x00'u8,0x00'u8,0x00'u8,0x34'u8,0x49'u8,0x44'u8,0x41'u8,0x54'u8,0x78'u8,0x9c'u8,0x63'u8,0x60'u8,0x60'u8,0x60'u8,0xd0'u8,0x60'u8,0x64'u8,0x08'u8,0x60'u8,0x62'u8,0x60'u8,0x64'u8,0x36'u8,0x02'u8,0xb2'u8,0xd8'u8,0x81'u8,0x88'u8,0x09'u8,0xc8'u8,0x62'u8,0x36'u8,0x62'u8,0x67'u8,0x36'u8,0xe2'u8,0x63'u8,0x66'u8,0x4b'u8,0x61'u8,0x10'u8,0x93'u8,0xe2'u8,0x13'u8,0x93'u8,0x12'u8,0x62'u8,0x01'u8,0x89'u8,0x31'u8,0xb2'u8,0x33'u8,0x33'u8,0xf2'u8,0x01'u8,0x00'u8,0x4c'u8,0x63'u8,0x03'u8,0x0b'u8,0x4a'u8,0x9d'u8,0xdb'u8,0xb7'u8,0x00'u8,0x00'u8,0x00'u8,0x00'u8,0x49'u8,0x45'u8,0x4e'u8,0x44'u8,0xae'u8,0x42'u8,0x60'u8,0x82'u8]

proc main() =
  let image = decodePng(Png)
  check(image.ok and image.width == 3 and image.height == 5, "decodes a 3x5 image")
  # row 4 pixel 2 is (92, 202, 56): the Paeth row
  let at = (4 * 3 + 2) * 4
  check(image.rgba[at] == 92'u8 and image.rgba[at + 1] == 202'u8 and image.rgba[at + 2] == 56'u8 and image.rgba[at + 3] == 255'u8,
    "paeth row pixel")
  # row 3 pixel 1 is (49, 151, 21): the average row
  let at3 = (3 * 3 + 1) * 4
  check(image.rgba[at3] == 49'u8 and image.rgba[at3 + 1] == 151'u8 and image.rgba[at3 + 2] == 21'u8, "average row pixel")
  # row 2 pixel 2 is (86, 102, 28): the up row
  let at2 = (2 * 3 + 2) * 4
  check(image.rgba[at2] == 86'u8 and image.rgba[at2 + 1] == 102'u8 and image.rgba[at2 + 2] == 28'u8, "up row pixel")
  # row 1 pixel 2 is (83, 52, 14): the sub row
  let at1 = (1 * 3 + 2) * 4
  check(image.rgba[at1] == 83'u8 and image.rgba[at1 + 1] == 52'u8 and image.rgba[at1 + 2] == 14'u8, "sub row pixel")
  var broken: seq[byte] = @[]
  for b in Png:
    broken.add(b)
  broken[1] = 0'u8
  check(not decodePng(broken).ok, "a bad signature is refused")
  let props = @[PropertyValue(name: "textures", value: "eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5leGFtcGxlL2FiYyJ9fX0=", signature: "")]
  check(textureUrlOf(props) == "http://textures.example/abc", "texture url")
  check(textureUrlOf(@[PropertyValue(name: "other", value: "x", signature: "")]) == "", "no textures property")
  let padded = skinFromImage(64, 32, newSeq[byte](64 * 32 * 4))
  check(padded.isSome and padded.unsafeGet.skinData.len == 64 * 64 * 4 and padded.unsafeGet.imageHeight == 64'u32, "64x32 is padded to 64x64")
  check(skinFromImage(32, 32, newSeq[byte](32 * 32 * 4)).isNone, "other sizes are refused")
  if failures != 0:
    echo failures, " failure(s)"
    quit(1)
  echo "bedrockskin ok"

main()
