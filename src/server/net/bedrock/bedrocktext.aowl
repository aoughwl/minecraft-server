## The plain text of a Java text component, read straight off its network-NBT bytes. No upstream file: the Bedrock play
## side (bedrockplay.aowl) sees the Java packets of a Bedrock player's stand-in as bytes, and a chat line or a kick reason
## has to reach the Bedrock client as a string. Only the `text` strings are kept, in document order (the root's, then its
## `extra` list's, and so on); colours, click events and translation arguments are dropped, a `translate` key is kept as is.

proc u16At(b: seq[byte]; at: int): int = (int(b[at]) shl 8) or int(b[at + 1])

proc skimNbtPayload(b: seq[byte]; at: var int; tag: uint8; name: string; outText: var string; depth: int) =
  ## Walks one NBT payload (network form), appending the strings named `text` in document order; a `translate` key is
  ## appended too when no text came before it. Stops quietly at the end of the buffer.
  if at >= b.len or depth > 24:
    at = b.len
    return
  case tag
  of 1'u8: at += 1
  of 2'u8: at += 2
  of 3'u8, 5'u8: at += 4
  of 4'u8, 6'u8: at += 8
  of 7'u8:
    if at + 4 > b.len: at = b.len; return
    let n = (int(b[at]) shl 24) or (int(b[at + 1]) shl 16) or (int(b[at + 2]) shl 8) or int(b[at + 3])
    at += 4 + n
  of 8'u8:
    if at + 2 > b.len: at = b.len; return
    let n = u16At(b, at)
    at += 2
    if at + n > b.len: at = b.len; return
    if name == "text" or name == "translate":
      for i in 0 ..< n:
        outText.add(char(b[at + i]))
    at += n
  of 9'u8:
    if at + 5 > b.len: at = b.len; return
    let elem = b[at]
    let n = (int(b[at + 1]) shl 24) or (int(b[at + 2]) shl 16) or (int(b[at + 3]) shl 8) or int(b[at + 4])
    at += 5
    for i in 0 ..< n:
      if at >= b.len: break
      skimNbtPayload(b, at, elem, name, outText, depth + 1)
  of 10'u8:
    while at < b.len:
      let t = b[at]
      at += 1
      if t == 0'u8: break
      if at + 2 > b.len: at = b.len; return
      let n = u16At(b, at)
      at += 2
      var key = ""
      for i in 0 ..< n:
        if at + i < b.len: key.add(char(b[at + i]))
      at += n
      skimNbtPayload(b, at, t, key, outText, depth + 1)
  of 11'u8:
    if at + 4 > b.len: at = b.len; return
    let n = (int(b[at]) shl 24) or (int(b[at + 1]) shl 16) or (int(b[at + 2]) shl 8) or int(b[at + 3])
    at += 4 + 4 * n
  of 12'u8:
    if at + 4 > b.len: at = b.len; return
    let n = (int(b[at]) shl 24) or (int(b[at + 1]) shl 16) or (int(b[at + 2]) shl 8) or int(b[at + 3])
    at += 4 + 8 * n
  else:
    at = b.len

proc plainTextOfNbt*(b: seq[byte]; startAt: int; consumed: var int): string =
  ## The text of a network-NBT text component starting at `startAt`: the `text` strings in order. A bare string root is
  ## the whole text. `consumed` is how many bytes the component took.
  result = ""
  var at = startAt
  if at >= b.len:
    consumed = 0
    return
  let tag = b[at]
  at += 1
  skimNbtPayload(b, at, tag, "text", result, 0)
  consumed = at - startAt

