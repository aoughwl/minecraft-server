## Test for bedrocktext.aowl: the text of hand-built network NBT, the shape `writeText` produces.
import std/syncio
import bedrocktext

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "  ok  ", what
  else:
    echo "FAIL  ", what
    failures += 1

proc append(dst: var seq[byte]; src: seq[byte]) =
  for b in src:
    dst.add(b)

proc str(s: string): seq[byte] =
  result = @[]
  for c in s:
    result.add(byte(ord(c)))

proc tagString(name, value: string): seq[byte] =
  ## type 8, the name, the value: u16 lengths, big-endian.
  result = @[8'u8, 0'u8, uint8(name.len)]
  result.append(str(name))
  result.add(0'u8)
  result.add(uint8(value.len))
  result.append(str(value))

proc main() =
  # {text:"Hello", extra:[{text:" world"}]}
  var nbt: seq[byte] = @[10'u8]
  nbt.append(tagString("text", "Hello"))
  nbt.append(@[9'u8, 0'u8, 5'u8])
  nbt.append(str("extra"))
  nbt.append(@[10'u8, 0'u8, 0'u8, 0'u8, 1'u8])
  nbt.append(tagString("text", " world"))
  nbt.add(0'u8)   # end of the element
  nbt.add(0'u8)   # end of the root
  var consumed = 0
  let text = plainTextOfNbt(nbt, 0, consumed)
  check(text == "Hello world", "the root text then the extra's: " & text)
  check(consumed == nbt.len, "the whole component is consumed: " & $consumed & " of " & $nbt.len)

  # a bare string root: tag 8 with no name, as a plain-text component is sent
  var bare: seq[byte] = @[8'u8, 0'u8, 3'u8]
  bare.append(str("hey"))
  var consumed2 = 0
  check(plainTextOfNbt(bare, 0, consumed2) == "hey", "a string root is the whole text")
  check(consumed2 == 6, "a string root's length")

  # {translate:"multiplayer.player.joined"} keeps the key; an int tag before it is skipped
  var tr: seq[byte] = @[10'u8, 3'u8, 0'u8, 1'u8, uint8(ord('x')), 0'u8, 0'u8, 0'u8, 7'u8]
  tr.append(tagString("translate", "multiplayer.player.joined"))
  tr.add(0'u8)
  var consumed3 = 0
  check(plainTextOfNbt(tr, 0, consumed3) == "multiplayer.player.joined", "a translate key is kept")

  # a cut-off buffer ends quietly
  var cut = nbt
  cut.setLen(12)
  var consumed4 = 0
  discard plainTextOfNbt(cut, 0, consumed4)
  check(consumed4 <= 12, "a truncated component stops at the end")
  if failures > 0:
    quit(1)
  echo "bedrocktexttest: all ok"

main()
