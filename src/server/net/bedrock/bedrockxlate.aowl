## Java play packet -> Bedrock packet translations that need no session: bedrockplay.aowl's `translateJava` hands the body of
## a Java packet (after its id) to these and sends what they return. Each is tested against the real Java packet writers
## (bedrockxlatetest.aowl), so the Java side of every translation is run against what this server really writes. The Bedrock
## side is the hand-laid layouts of client/play_extra.aowl and the pinned client packets; no real Bedrock client has read any
## of them (see play_extra.aowl for what is proven and what is guessed).
##
## No upstream file: upstream's Bedrock players are a separate `ClientPlatform` that is sent Bedrock packets directly. Here a
## Bedrock player is a stand-in Java client whose Java packets are translated (see bedrockplay.aowl's header).

import std/[options, tables]
import ../../../protocol/[protobase, netcodec, serial, varint, uuid]
import ../../../protocol/bedrock/[network_item]
import ../../../protocol/bedrock/client/[set_actor_data, set_title, boss_event, level_event, play_extra]
import ../../../protocol/bedrock/client/update_attributes as bupd
import ../../../protocol/bedrock/server/animate
import ../../../protocol/itemstackserializer
import ../../../inventory/stackbridge
import "../../../data/item_stack/mod"
import ../../../generated/[effect, tracked_data]
import ../../../util/javaversion
import ../../../util/vector3
import ../../../util/uuid
import bedrockmeta, bedrocktext

const
  CAnimatePacketId* = 44'i32

type
  Out* = object
    ## One Bedrock game packet: its id and its body.
    id*: int32
    body*: seq[byte]

  BossBars* = object
    ## The numeric id a Bedrock client is given for each Java boss bar (a UUID), and the next one to hand out.
    ids*: Table[string, int64]
    next*: int64

  JavaMetadata* = object
    ## What a Java `CSetEntityMetadata` said, for the entries this translation understands. `has*` says the entry was present.
    entityId*: int32
    hasFlags*: bool
    flags*: uint8
    hasName*: bool
    name*: string
    hasNameVisible*: bool
    nameVisible*: bool
    hasPose*: bool
    pose*: int32
    hasBaby*: bool
    baby*: bool
    hasWool*: bool
    wool*: uint8
    complete*: bool ## the terminator was reached; false when an entry of an unknown type stopped the parse

  EquipmentEntry* = object
    slot*: int8
    stack*: ItemStack

template make(pid: int32; packet: untyped): Out =
  ## A template, not a generic proc: aowlmony generics do not look up `packetWrite` on their type parameter.
  block:
    var w = newNetWriter()
    packetWrite(packet, w)
    Out(id: pid, body: w.buf)

# --- effects ---------------------------------------------------------------------------------------------------------------

proc bedrockEffectId*(javaName: string): int32 =
  ## Bedrock's mob effect ids by the Java effect name; 0 for one Bedrock has no twin of (glowing, luck, bad luck, dolphin's grace).
  case javaName
  of "minecraft:speed": 1'i32
  of "minecraft:slowness": 2'i32
  of "minecraft:haste": 3'i32
  of "minecraft:mining_fatigue": 4'i32
  of "minecraft:strength": 5'i32
  of "minecraft:instant_health": 6'i32
  of "minecraft:instant_damage": 7'i32
  of "minecraft:jump_boost": 8'i32
  of "minecraft:nausea": 9'i32
  of "minecraft:regeneration": 10'i32
  of "minecraft:resistance": 11'i32
  of "minecraft:fire_resistance": 12'i32
  of "minecraft:water_breathing": 13'i32
  of "minecraft:invisibility": 14'i32
  of "minecraft:blindness": 15'i32
  of "minecraft:night_vision": 16'i32
  of "minecraft:hunger": 17'i32
  of "minecraft:weakness": 18'i32
  of "minecraft:poison": 19'i32
  of "minecraft:wither": 20'i32
  of "minecraft:health_boost": 21'i32
  of "minecraft:absorption": 22'i32
  of "minecraft:saturation": 23'i32
  of "minecraft:levitation": 24'i32
  of "minecraft:conduit_power": 26'i32
  of "minecraft:slow_falling": 27'i32
  of "minecraft:bad_omen": 28'i32
  of "minecraft:hero_of_the_village": 29'i32
  of "minecraft:darkness": 30'i32
  else: 0'i32

proc javaEffectName(id: int32): string =
  let e = StatusEffect.fromId(uint16(id))
  if e.isSome: e.unsafeGet.minecraftName else: ""

proc xlateMobEffect*(r: var NetReader; event: uint8): seq[Out] =
  ## `CUpdateMobEffect`: entity, effect, amplifier, duration, flags (0x01 ambient, 0x02 particles, 0x04 icon).
  result = @[]
  let eid = getVarInt(r)
  let effect = getVarInt(r)
  let amp = getVarInt(r)
  let duration = getVarInt(r)
  let flags = getI8(r)
  if not (eid.isOk and effect.isOk and amp.isOk and duration.isOk and flags.isOk):
    return
  let bid = bedrockEffectId(javaEffectName(effect.value.value))
  if bid == 0'i32:
    return
  result.add(make(CMobEffectPacketId, CMobEffect(targetRuntimeId: newVarULong(uint64(eid.value.value)), eventId: event,
    effectId: newVarInt(bid), effectAmplifier: newVarInt(amp.value.value), showParticles: (uint8(flags.value) and 2'u8) != 0'u8,
    effectDurationTicks: newVarInt(duration.value.value), tick: newVarULong(0'u64))))

proc xlateRemoveEffect*(r: var NetReader): seq[Out] =
  ## `CRemoveMobEffect`: entity, effect.
  result = @[]
  let eid = getVarInt(r)
  let effect = getVarInt(r)
  if not (eid.isOk and effect.isOk):
    return
  let bid = bedrockEffectId(javaEffectName(effect.value.value))
  if bid == 0'i32:
    return
  result.add(make(CMobEffectPacketId, CMobEffect(targetRuntimeId: newVarULong(uint64(eid.value.value)), eventId: MobEffectRemove,
    effectId: newVarInt(bid), effectAmplifier: newVarInt(0'i32), showParticles: false, effectDurationTicks: newVarInt(0'i32),
    tick: newVarULong(0'u64))))

# --- animation, hurt, death ------------------------------------------------------------------------------------------------

proc xlateAnimation*(r: var NetReader): seq[Out] =
  ## `CEntityAnimation`: entity, animation (0 swing main arm, 2 leave bed, 3 swing off hand, 4 crit, 5 magic crit).
  result = @[]
  let eid = getVarInt(r)
  let anim = getU8(r)
  if not (eid.isOk and anim.isOk):
    return
  var action = aaSwingArm
  case anim.value
  of 0'u8, 3'u8: action = aaSwingArm
  of 2'u8: action = aaWakeUp
  of 4'u8: action = aaCriticalHit
  of 5'u8: action = aaMagicCriticalHit
  else: return
  result.add(make(CAnimatePacketId, SAnimate(action: action, runtimeEntityId: newVarULong(uint64(eid.value.value)), data: 0.0'f32,
    swingSource: none[AnimateSwingSource]())))

proc actorEvent*(runtimeId: int32; event: uint8): Out =
  make(CActorEventPacketId, CActorEvent(targetRuntimeId: newVarULong(uint64(runtimeId)), eventId: event, data: newVarInt(0'i32)))

proc xlateHurt*(r: var NetReader): seq[Out] =
  ## `CHurtAnimation`: entity, yaw. Bedrock's twin is the HURT actor event.
  result = @[]
  let eid = getVarInt(r)
  if eid.isOk:
    result.add(actorEvent(eid.value.value, ActorEventHurt))

proc xlateEntityStatus*(r: var NetReader): seq[Out] =
  ## `CEntityStatus`: an i32 entity id and a status byte; 2 is hurt and 3 is death, which have Bedrock twins.
  result = @[]
  let eid = getI32Be(r)
  let status = getI8(r)
  if not (eid.isOk and status.isOk):
    return
  if status.value == 2'i8:
    result.add(actorEvent(eid.value, ActorEventHurt))
  elif status.value == 3'i8:
    result.add(actorEvent(eid.value, ActorEventDeath))

# --- weather ---------------------------------------------------------------------------------------------------------------

const
  LevelEventStartRain* = 3001'i32
  LevelEventStartThunder* = 3002'i32
  LevelEventStopRain* = 3003'i32
  LevelEventStopThunder* = 3004'i32

proc levelEvent(event, data: int32): Out =
  make(CLevelEventPacketId, CLevelEvent(eventId: newVarInt(event), position: Vector3[float32](x: 0.0'f32, y: 0.0'f32, z: 0.0'f32),
    data: newVarInt(data)))

proc weatherEvents*(event: uint8; value: float32): seq[Out] =
  ## `GameEvent` 1 begin raining, 2 end raining, 7 rain level, 8 thunder level, as the Bedrock level events (data 65535 is full strength).
  result = @[]
  case event
  of 1'u8: result.add(levelEvent(LevelEventStartRain, 65535'i32))
  of 2'u8: result.add(levelEvent(LevelEventStopRain, 0'i32))
  of 7'u8:
    if value > 0.0'f32: result.add(levelEvent(LevelEventStartRain, int32(value * 65535.0'f32)))
    else: result.add(levelEvent(LevelEventStopRain, 0'i32))
  of 8'u8:
    if value > 0.0'f32: result.add(levelEvent(LevelEventStartThunder, int32(value * 65535.0'f32)))
    else: result.add(levelEvent(LevelEventStopThunder, 0'i32))
  else: discard

# --- titles ----------------------------------------------------------------------------------------------------------------

const
  TitleClear = 0'i32
  TitleReset = 1'i32
  TitleSetTitle = 2'i32
  TitleSetSubtitle = 3'i32
  TitleSetActionBar = 4'i32
  TitleSetDurations = 5'i32

proc titleText(r: var NetReader): string =
  var consumed = 0
  result = plainTextOfNbt(r.data, r.pos, consumed)
  r.pos += consumed

proc xlateTitle*(kind: int32; r: var NetReader): seq[Out] =
  ## Java `CTitleText` (2), `CSubtitle` (3), `CActionBar` (4), `CTitleAnimation` (5, three i32 of ticks) and `CClearTitle` (0 or 1, a bool).
  result = @[]
  case kind
  of TitleSetTitle, TitleSetSubtitle, TitleSetActionBar:
    result.add(make(CSetTitlePacketId, newCSetTitle(kind, titleText(r), 0'i32, 0'i32, 0'i32)))
  of TitleSetDurations:
    let a = getI32Be(r)
    let b = getI32Be(r)
    let c = getI32Be(r)
    if a.isOk and b.isOk and c.isOk:
      result.add(make(CSetTitlePacketId, newCSetTitle(kind, "", a.value, b.value, c.value)))
  of TitleClear, TitleReset:
    let reset = getBool(r)
    if reset.isOk:
      result.add(make(CSetTitlePacketId, newCSetTitle(if reset.value: TitleReset else: TitleClear, "", 0'i32, 0'i32, 0'i32)))
  else: discard

# --- boss bars -------------------------------------------------------------------------------------------------------------

proc newBossBars*(): BossBars =
  BossBars(ids: initTable[string, int64](), next: 1'i64)

proc xlateBossEvent*(r: var NetReader; bars: var BossBars): seq[Out] =
  ## `CBossEvent`: uuid, action (0 add, 1 remove, 2 health, 3 title, 4 style, 5 flags). A Bedrock client names a bar by a number,
  ## so each UUID is given one, counting down from -1 so it cannot meet an entity id.
  result = @[]
  let u = getUuid(r)
  let action = getVarInt(r)
  if not (u.isOk and action.isOk):
    return
  let key = $u.value
  var id = 0'i64
  if bars.ids.hasKey(key):
    id = bars.ids.getOrDefault(key)
  else:
    id = -bars.next
    bars.next += 1'i64
    bars.ids[key] = id
  var act: BossEventAction
  case action.value.value
  of 0'i32:
    let title = titleText(r)
    let health = getF32Be(r)
    let color = getVarInt(r)
    let division = getVarInt(r)
    if not (health.isOk and color.isOk and division.isOk):
      return
    act = BossEventAction(kind: beaAdd, title: title, healthPercent: health.value, color: color.value, overlay: division.value)
  of 1'i32:
    act = BossEventAction(kind: beaRemove)
    bars.ids.del(key)
  of 2'i32:
    let health = getF32Be(r)
    if not health.isOk: return
    act = BossEventAction(kind: beaUpdateHealth, healthPercent: health.value)
  of 3'i32:
    act = BossEventAction(kind: beaUpdateTitle, title: titleText(r))
  of 4'i32:
    let color = getVarInt(r)
    let division = getVarInt(r)
    if not (color.isOk and division.isOk): return
    act = BossEventAction(kind: beaUpdateProperties, color: color.value, overlay: division.value)
  else:
    return
  result.add(make(CBossEventPacketId, CBossEvent(bossEntityId: newVarLong(id), action: act)))

# --- equipment -------------------------------------------------------------------------------------------------------------

proc parseEquipment*(r: var NetReader): (int32, seq[EquipmentEntry]) =
  ## `CSetEquipment`: the entity, then (slot byte, stack) pairs, the high bit of a slot byte saying another follows.
  var entries: seq[EquipmentEntry] = @[]
  let eid = getVarInt(r)
  if not eid.isOk:
    return (0'i32, entries)
  while true:
    let slot = getI8(r)
    if not slot.isOk: break
    let stack = ItemStackSerializer.read(r)
    if not stack.isOk: break
    entries.add(EquipmentEntry(slot: slot.value and 0x7F'i8, stack: fromSerializer(stack.value)))
    if slot.value >= 0'i8: break
  (eid.value.value, entries)

proc equipmentOuts*(eid: int32; entries: seq[EquipmentEntry]; armor: var seq[NetworkItemStackDescriptor]): seq[Out] =
  ## Java slots 0 main hand, 1 off hand, 2 feet, 3 legs, 4 chest, 5 head, 6 body. The hands are `MobEquipment` (the off hand in
  ## container 119, slot 1); the armor is one `MobArmorEquipment` of all five, so `armor` (head, chest, legs, feet, body) is
  ## the entity's last worn set, kept by the caller.
  result = @[]
  if armor.len < 5:
    armor = @[defaultNetworkItemStackDescriptor(), defaultNetworkItemStackDescriptor(), defaultNetworkItemStackDescriptor(),
      defaultNetworkItemStackDescriptor(), defaultNetworkItemStackDescriptor()]
  var armorChanged = false
  for e in entries:
    let d = networkItemStackDescriptorFromItemStack(e.stack)
    case e.slot
    of 0'i8:
      result.add(make(CMobEquipmentPacketId, CMobEquipment(targetRuntimeId: newVarULong(uint64(eid)), item: d, slot: 0'u8,
        selectedSlot: 0'u8, containerId: 0'u8)))
    of 1'i8:
      result.add(make(CMobEquipmentPacketId, CMobEquipment(targetRuntimeId: newVarULong(uint64(eid)), item: d, slot: 1'u8,
        selectedSlot: 0'u8, containerId: 119'u8)))
    of 2'i8:
      armor[3] = d
      armorChanged = true
    of 3'i8:
      armor[2] = d
      armorChanged = true
    of 4'i8:
      armor[1] = d
      armorChanged = true
    of 5'i8:
      armor[0] = d
      armorChanged = true
    of 6'i8:
      armor[4] = d
      armorChanged = true
    else: discard
  if armorChanged:
    result.add(make(CMobArmorEquipmentPacketId, CMobArmorEquipment(targetRuntimeId: newVarULong(uint64(eid)), head: armor[0],
      chest: armor[1], legs: armor[2], feet: armor[3], body: armor[4])))

# --- entity metadata -------------------------------------------------------------------------------------------------------

proc parseMetadata*(r: var NetReader): JavaMetadata =
  ## `CSetEntityMetadata`: the entity, then (index byte, type VarInt, value) entries up to 0xFF. Understood: the flags byte, the
  ## custom name and whether it shows, the pose, the baby flag and a sheep's wool. The 26.2 type ids (generated/meta_data_type)
  ## are skipped by size for 0 byte, 1 int, 2 long, 3 float, 4 string, 5 component, 6 optional component, 7 item, 8 bool,
  ## 9 rotations, 10 block pos, 11 optional block pos, 12 direction, 13 optional uuid, 14 and 15 block states and 20 pose; the
  ## first other type stops the parse (`complete` false), as its size is not known.
  result = JavaMetadata()
  let eid = getVarInt(r)
  if not eid.isOk:
    return
  result.entityId = eid.value.value
  let v = CurrentMcVersion
  let iFlags = TrackedData_SHARED_FLAGS_ID.get(v)
  let iName = TrackedData_CUSTOM_NAME.get(v)
  let iVisible = TrackedData_CUSTOM_NAME_VISIBLE.get(v)
  let iPose = TrackedData_POSE.get(v)
  let iBaby = TrackedData_BABY_ID.get(v)
  let iWool = TrackedData_WOOL_ID.get(v)
  while true:
    let index = getU8(r)
    if not index.isOk:
      return
    if index.value == 0xFF'u8:
      result.complete = true
      return
    let typ = getVarInt(r)
    if not typ.isOk:
      return
    let i = index.value
    case typ.value.value
    of 0'i32:
      let b = getU8(r)
      if not b.isOk: return
      if i == iFlags:
        result.hasFlags = true
        result.flags = b.value
      elif i == iWool:
        result.hasWool = true
        result.wool = b.value
    of 1'i32, 12'i32, 14'i32, 15'i32, 20'i32:
      let n = getVarInt(r)
      if not n.isOk: return
      if typ.value.value == 20'i32 and i == iPose:
        result.hasPose = true
        result.pose = n.value.value
    of 2'i32:
      if not getI64Be(r).isOk: return
    of 3'i32:
      if not getF32Be(r).isOk: return
    of 4'i32:
      if not getStr(r).isOk: return
    of 5'i32:
      discard titleText(r)
    of 6'i32:
      let present = getBool(r)
      if not present.isOk: return
      if present.value:
        let name = titleText(r)
        if i == iName:
          result.hasName = true
          result.name = name
      elif i == iName:
        result.hasName = true
        result.name = ""
    of 7'i32:
      if not ItemStackSerializer.read(r).isOk: return
    of 8'i32:
      let b = getBool(r)
      if not b.isOk: return
      if i == iVisible:
        result.hasNameVisible = true
        result.nameVisible = b.value
      elif i == iBaby:
        result.hasBaby = true
        result.baby = b.value
    of 9'i32:
      if not (getF32Be(r).isOk and getF32Be(r).isOk and getF32Be(r).isOk): return
    of 10'i32:
      if not getI64Be(r).isOk: return
    of 11'i32:
      let present = getBool(r)
      if not present.isOk: return
      if present.value and not getI64Be(r).isOk: return
    of 13'i32:
      let present = getBool(r)
      if not present.isOk: return
      if present.value and not getUuid(r).isOk: return
    else:
      return

proc poseFlags*(pose: int32): int64 =
  ## The Bedrock flag bits for a Java pose: 1 fall flying, 2 sleeping, 3 swimming, 5 crouching.
  proc bit(b: uint32): int64 = cast[int64](1'u64 shl b)
  case pose
  of 1'i32: bit(EDF_GLIDING)
  of 2'i32: bit(EDF_SLEEPING)
  of 3'i32: bit(EDF_SWIMMING)
  of 5'i32: bit(EDF_SNEAKING)
  else: 0'i64

proc bedrockMetadataFor*(width, height: float32; flags: uint8; pose: int32; baby: bool; name: string; nameVisible: bool;
    wool: int): EntityMetadata =
  ## The whole Bedrock metadata of a Java entity from what is known of it: size, the flags (Java flags byte, pose, baby), the
  ## custom name, and the sheep colour (the Java wool byte's low four bits; -1 for a mob that is not a sheep).
  var extra = poseFlags(pose)
  if baby:
    extra = extra or cast[int64](1'u64 shl EDF_BABY)
  var m = bedrockMetadata(width, height, name, nameVisible, bedrockFlagsOfJava(flags, extra))
  if wool >= 0:
    m.set(EDK_COLOR_INDEX, mvByteOf(int8(wool and 15)))
  m

# --- the tab list ----------------------------------------------------------------------------------------------------------

proc xlateRemovedPlayers*(r: var NetReader): seq[Uuid] =
  ## `CRemovePlayerInfo`: a VarInt count of UUIDs.
  result = @[]
  let n = getVarInt(r)
  if not n.isOk:
    return
  for i in 0 ..< int(n.value.value):
    let u = getUuid(r)
    if not u.isOk: break
    result.add(u.value)

proc xlateAddedPlayers*(r: var NetReader): seq[(Uuid, string)] =
  ## `CPlayerInfoUpdate` whose action set holds ADD_PLAYER and only actions of known size (game mode, listed, latency, list
  ## priority, hat); a packet with chat initialisation or a display name is not read (an empty result).
  result = @[]
  let actions = getU8(r)
  let n = getVarInt(r)
  if not (actions.isOk and n.isOk) or (actions.value and 1'u8) == 0'u8 or (actions.value and (0x02'u8 or 0x20'u8)) != 0'u8:
    return
  for i in 0 ..< int(n.value.value):
    let u = getUuid(r)
    let name = getStr(r)
    let props = getVarInt(r)
    if not (u.isOk and name.isOk and props.isOk): break
    var ok = true
    for j in 0 ..< int(props.value.value):
      if not (getStr(r).isOk and getStr(r).isOk): ok = false; break
      let signed = getBool(r)
      if not signed.isOk: ok = false; break
      if signed.value and not getStr(r).isOk: ok = false; break
    if not ok: break
    result.add((u.value, name.value))
    if (actions.value and 0x04'u8) != 0'u8 and not getVarInt(r).isOk: break
    if (actions.value and 0x08'u8) != 0'u8 and not getBool(r).isOk: break
    if (actions.value and 0x10'u8) != 0'u8 and not getVarInt(r).isOk: break
    if (actions.value and 0x40'u8) != 0'u8 and not getVarInt(r).isOk: break
    if (actions.value and 0x80'u8) != 0'u8 and not getBool(r).isOk: break

proc healthAttribute*(runtimeId: uint64; health: float32): Out =
  ## The `minecraft:health` attribute alone: at nothing, with the `CSetHealth`, the client shows its death screen.
  let attr = bupd.Attribute(minValue: 0.0'f32, maxValue: 20.0'f32, currentValue: health, defaultMinValue: 0.0'f32,
    defaultMaxValue: 20.0'f32, defaultValue: 20.0'f32, name: "minecraft:health", modifiersListSize: newVarUInt(0'u32))
  make(bupd.CUpdateAttributesPacketId, bupd.CUpdateAttributes(runtimeId: newVarULong(runtimeId), attributes: @[attr], playerTick: newVarULong(0'u64)))
