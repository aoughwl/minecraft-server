## Test for bedrockxlate.aowl. The Java side is built with this server's own Java packet writers (so what is decoded is what the
## server really writes for a Java client); the Bedrock side is asserted against hand-laid bytes. Nothing here involves a real
## Bedrock client.
import std/[options, tables, strutils, syncio]
import ../../../protocol/java/client/play/playwire
import ../../../protocol/[protobase, netcodec, varint, uuid]
import ../../../protocol/bedrock/network_item
import ../../../protocol/bedrock/client/[set_actor_data, play_extra]
import ../../../protocol/java/client/play/[update_mob_effect, remove_mob_effect, entity_animation, hurt_animation, entity_status,
  set_equipment, entity_metadata, player_remove, set_title as jset_title, actionbar, set_title_animation, clear_title,
  boss_event as jboss_event, bossevent_action]
import ../../../protocol/itemstackserializer
import ../../../inventory/stackbridge
import "../../../data/item_stack/mod"
import ../../../generated/item_full
import ../../../util/javaversion
import ../../../util/uuid
import ../../../util/text/text
import ../../../generated/[meta_data_type, tracked_data]
import bedrockxlate

var failures = 0

proc check(cond: bool; what: string) =
  if cond:
    echo "  ok  ", what
  else:
    echo "FAIL  ", what
    failures += 1

proc hexOf(b: seq[byte]): string =
  const digits = "0123456789abcdef"
  result = ""
  for x in b:
    result.add(digits[int(x shr 4)])
    result.add(digits[int(x and 15)])

const V = CurrentMcVersion

proc main() =
  # --- effects: speed (Java id 0) amplifier 1, 600 ticks, particles + icon (flags 6)
  var w = newNetWriter()
  discard CUpdateMobEffect(entityId: newVarInt(7'i32), effectId: newVarInt(0'i32), amplifier: newVarInt(1'i32),
    duration: newVarInt(600'i32), flags: 6'i8).writePacket(w, V)
  var r = newNetReader(w.buf)
  var outs = xlateMobEffect(r, MobEffectAdd)
  check(outs.len == 1 and outs[0].id == 28'i32, "mob effect: one packet 28")
  # runtime 7, add, speed=1 (02), amplifier 1 (02), particles, duration 600 (zigzag 1200 = b009), tick 0
  check(hexOf(outs[0].body) == "07010202" & "01" & "b009" & "00", "mob effect bytes " & hexOf(outs[0].body))
  w = newNetWriter()
  discard CRemoveMobEffect(entityId: newVarInt(7'i32), effectId: newVarInt(0'i32)).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateRemoveEffect(r)
  check(outs.len == 1 and hexOf(outs[0].body) == "07" & "03" & "02" & "00" & "00" & "00" & "00", "remove effect bytes " & hexOf(outs[0].body))
  check(bedrockEffectId("minecraft:glowing") == 0'i32 and bedrockEffectId("minecraft:darkness") == 30'i32, "effect table")

  # --- animation: swing main arm of entity 9; crit; hurt; death
  w = newNetWriter()
  discard CEntityAnimation(entityId: newVarInt(9'i32), animation: 0'u8).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateAnimation(r)
  check(outs.len == 1 and outs[0].id == 44'i32 and hexOf(outs[0].body) == "01" & "09" & "00000000" & "00", "swing arm bytes " & hexOf(outs[0].body))
  w = newNetWriter()
  discard CHurtAnimation(entityId: newVarInt(9'i32), yaw: 0.0'f32).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateHurt(r)
  check(outs.len == 1 and outs[0].id == 27'i32 and hexOf(outs[0].body) == "090200", "hurt = actor event 2: " & hexOf(outs[0].body))
  w = newNetWriter()
  discard CEntityStatus(entityId: 9'i32, entityStatus: 3'i8).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateEntityStatus(r)
  check(outs.len == 1 and hexOf(outs[0].body) == "090300", "death status = actor event 3")
  w = newNetWriter()
  discard CEntityStatus(entityId: 9'i32, entityStatus: 9'i8).writePacket(w, V)
  r = newNetReader(w.buf)
  check(xlateEntityStatus(r).len == 0, "other statuses are dropped")

  # --- weather
  check(weatherEvents(1'u8, 0.0'f32).len == 1 and weatherEvents(1'u8, 0.0'f32)[0].id == 25'i32, "begin raining = level event")
  # start rain 3001 = zigzag 6002 = f2 2e; position 0,0,0; data 65535 zigzag 131070 = fe ff 07
  check(hexOf(weatherEvents(1'u8, 0.0'f32)[0].body) == "f22e" & "000000000000000000000000" & "feff07", "start rain bytes " & hexOf(weatherEvents(1'u8, 0.0'f32)[0].body))
  check(weatherEvents(8'u8, 0.0'f32).len == 1 and weatherEvents(8'u8, 1.0'f32).len == 1 and weatherEvents(3'u8, 1.0'f32).len == 0, "thunder level")

  # --- titles
  w = newNetWriter()
  discard CTitleText(title: text("Hello")).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateTitle(2'i32, r)
  check(outs.len == 1 and outs[0].id == 88'i32, "title packet 88")
  check(hexOf(outs[0].body).startsWith("04" & "0548656c6c6f"), "title is set-title(2 -> zigzag 04) with the text: " & hexOf(outs[0].body))
  w = newNetWriter()
  discard CActionBar(actionBar: text("Bar")).writePacket(w, V)
  r = newNetReader(w.buf)
  check(xlateTitle(4'i32, r)[0].body.len > 0, "action bar")
  w = newNetWriter()
  discard CTitleAnimation(fadeInTicks: 5'i32, stayTicks: 40'i32, fadeOutTicks: 7'i32).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateTitle(5'i32, r)
  check(hexOf(outs[0].body).startsWith("0a" & "00") and outs.len == 1, "title durations")

  # --- boss bar: add, then health, then remove with the same number
  var bars = newBossBars()
  let uid = Uuid(hi: 1'u64, lo: 2'u64)
  w = newNetWriter()
  discard CBossEvent(uuid: uid, action: BosseventAction(kind: baAdd, title: text("Dragon"), health: 0.5'f32, color: newVarInt(1'i32),
    division: newVarInt(0'i32), flags: 0'u8)).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateBossEvent(r, bars)
  check(outs.len == 1 and outs[0].id == 74'i32 and outs[0].body[0] == 0x01'u8, "boss add: first bar is id -1 (zigzag 1)")
  w = newNetWriter()
  discard CBossEvent(uuid: uid, action: BosseventAction(kind: baUpdateHealth, updatedHealth: 0.25'f32)).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateBossEvent(r, bars)
  check(outs.len == 1 and outs[0].body[0] == 0x01'u8, "boss health: same bar")
  w = newNetWriter()
  discard CBossEvent(uuid: uid, action: BosseventAction(kind: baRemove)).writePacket(w, V)
  r = newNetReader(w.buf)
  outs = xlateBossEvent(r, bars)
  check(outs.len == 1 and bars.ids.len == 0, "boss remove forgets the bar")

  # --- equipment: iron-ish sword in the main hand and a helmet-slot item, then the armor cache is reused
  let bitem = bedrockItemByKey("minecraft:iron_sword")
  if bitem == nil:
    echo "FAIL  no bedrock iron sword"
    quit(1)
  let sword = JavaToBedrockItemMapping.fromBedrock(bitem.id, 0'u32)
  if sword == nil:
    echo "FAIL  no java item for the test"
    quit(1)
  let stack = newItemStack(1'u8, sword.javaItem)
  w = newNetWriter()
  discard CSetEquipment(entityId: newVarInt(12'i32), equipment: @[(0'i8, toSerializer(stack)),
    (5'i8, toSerializer(stack))]).writePacket(w, V)
  r = newNetReader(w.buf)
  let (eid, entries) = parseEquipment(r)
  check(eid == 12'i32 and entries.len == 2 and entries[0].slot == 0'i8 and entries[1].slot == 5'i8, "parsed equipment")
  var armor: seq[NetworkItemStackDescriptor] = @[]
  outs = equipmentOuts(eid, entries, armor)
  check(outs.len == 2 and outs[0].id == 31'i32 and outs[1].id == 32'i32, "main hand = MobEquipment, helmet = MobArmorEquipment")
  check(outs[0].body[0] == 12'u8 and outs[0].body.len > 8, "mob equipment names entity 12")
  check(armor.len == 5 and armor[0].id != 0'i16 and armor[1].id == 0'i16, "armor cache holds the helmet only")
  # an off-hand item goes in container 119
  outs = equipmentOuts(12'i32, @[EquipmentEntry(slot: 1'i8, stack: stack)], armor)
  check(outs.len == 1 and outs[0].body[outs[0].body.len - 1] == 119'u8, "off hand: container 119")

  # --- metadata: flags (sneaking), name, name visible, pose, baby
  let fl = TrackedData_SHARED_FLAGS_ID
  let nm = TrackedData_CUSTOM_NAME
  w = newNetWriter()
  writeVarInt(w, newVarInt(4'i32))
  writeU8(w, fl.get(V))
  writeVarInt(w, newVarInt(0'i32))
  writeU8(w, 2'u8)
  writeU8(w, nm.get(V))
  writeVarInt(w, newVarInt(6'i32))
  writeBool(w, true)
  discard writeText(w, text("Bob"))
  writeU8(w, TrackedData_CUSTOM_NAME_VISIBLE.get(V))
  writeVarInt(w, newVarInt(8'i32))
  writeBool(w, true)
  writeU8(w, TrackedData_POSE.get(V))
  writeVarInt(w, newVarInt(20'i32))
  writeVarInt(w, newVarInt(5'i32))
  writeU8(w, TrackedData_BABY_ID.get(V))
  writeVarInt(w, newVarInt(8'i32))
  writeBool(w, true)
  writeU8(w, 0xFF'u8)
  r = newNetReader(w.buf)
  let md = parseMetadata(r)
  check(md.complete and md.entityId == 4'i32 and md.hasFlags and md.flags == 2'u8, "metadata flags")
  check(md.hasName and md.name == "Bob" and md.hasNameVisible and md.nameVisible, "metadata name")
  check(md.hasPose and md.pose == 5'i32 and md.hasBaby and md.baby, "metadata pose and baby")
  # an entry of a type that is not understood stops the parse without a crash
  w = newNetWriter()
  writeVarInt(w, newVarInt(4'i32))
  writeU8(w, 3'u8)
  writeVarInt(w, newVarInt(33'i32))
  r = newNetReader(w.buf)
  check(not parseMetadata(r).complete, "unknown type stops the parse")
  let bm = bedrockMetadataFor(0.6'f32, 1.8'f32, md.flags, md.pose, md.baby, md.name, md.nameVisible, 4)
  var gotName = false
  var gotColor = false
  var gotBaby = false
  for e in bm.entries:
    if e.key == EDK_NAME: gotName = e.value.stringValue == "Bob"
    if e.key == EDK_COLOR_INDEX: gotColor = e.value.byteValue == 4'i8
    if e.key == EDK_FLAGS: gotBaby = (cast[uint64](e.value.longValue) and (1'u64 shl EDF_BABY)) != 0'u64
  check(gotName and gotColor and gotBaby, "bedrock metadata: name, sheep colour, baby flag")
  check((poseFlags(5'i32) and cast[int64](1'u64 shl EDF_SNEAKING)) != 0'i64 and poseFlags(0'i32) == 0'i64, "pose flags")

  # --- the tab list
  w = newNetWriter()
  discard CRemovePlayerInfo(players: @[uid, Uuid(hi: 3'u64, lo: 4'u64)]).writePacket(w, V)
  r = newNetReader(w.buf)
  let gone = xlateRemovedPlayers(r)
  check(gone.len == 2 and gone[0] == uid, "removed players")
  # an add of one player "Ann" with no properties and game mode + listed + latency
  w = newNetWriter()
  writeU8(w, 0x01'u8 or 0x04'u8 or 0x08'u8 or 0x10'u8)
  writeVarInt(w, newVarInt(1'i32))
  writeUuid(w, uid)
  discard writeString(w, "Ann")
  writeVarInt(w, newVarInt(0'i32))
  writeVarInt(w, newVarInt(0'i32))
  writeBool(w, true)
  writeVarInt(w, newVarInt(0'i32))
  r = newNetReader(w.buf)
  let added = xlateAddedPlayers(r)
  check(added.len == 1 and added[0][0] == uid and added[0][1] == "Ann" and r.remaining() == 0, "added players")

  let h = healthAttribute(5'u64, 0.0'f32)
  check(h.id == 29'i32 and h.body[0] == 5'u8, "health attribute packet")
  if failures > 0:
    quit(1)
  echo "bedrockxlatetest ok"

main()
