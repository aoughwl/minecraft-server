## invite.aowl, natpmp.aowl and upnp.aowl on known answers (expected codes computed with an independent implementation; NAT-PMP bytes
## written out by hand from RFC 6886). No sockets.

import std/[assertions, strutils, syncio]
import invite
import natpmp
import upnp

proc hex(b: seq[byte]): string =
  result = ""
  for x in b: result.add hexLower(int(x), 2)

proc has(h, n: string): bool = h.find(n) >= 0

proc bytesOf(s: string): seq[byte] =
  result = @[]
  for c in s: result.add byte(c)

# --- CRC and base32 known answers ----------------------------------------------------------------------------------
assert crc16(bytesOf("123456789")) == 0x29B1
assert base32Encode(bytesOf("foobar")) == "CSQPYRK1E8"
assert base32Encode(bytesOf("f")) == "CR"
var okb = false
assert hex(base32Decode("CSQPYRK1E8", okb)) == "666f6f626172" and okb
assert hex(base32Decode("csqp-yrk1 e8", okb)) == "666f6f626172" and okb, "case, dashes and spaces ignored"
assert hex(base32Decode("CSQPYRKIE8", okb)) == "666f6f626172" and okb, "I reads as 1"
discard base32Decode("CSQPYRK!E8", okb)
assert not okb

# --- invites ---------------------------------------------------------------------------------------------------------
let direct = Invite(kind: KindDirect4, host: @[192'u8, 168'u8, 1'u8, 20'u8], port: 25565, token: @[0xDE'u8, 0xAD'u8, 0xBE'u8, 0xEF'u8])
let code = encodeInvite(direct)
assert code == "230AG-08MCF-EXXBD-YXZAF-8", code
let back = decodeInvite(code)
assert back.ok and back.invite.kind == KindDirect4 and back.invite.port == 25565 and back.invite.host == direct.host and back.invite.token == direct.token
assert formatInviteAddress(back.invite) == "192.168.1.20:25565"
assert decodeInvite(code.toLowerAscii()).ok, "lower case accepted"
assert decodeInvite(code.replace("-", "")).ok, "dashes optional"

let relay = Invite(kind: KindRelay, host: @[1'u8, 2'u8, 3'u8, 4'u8, 5'u8, 6'u8, 7'u8, 8'u8], port: 0, token: @[0'u8, 0'u8, 0'u8, 1'u8])
assert encodeInvite(relay) == "280G4-0R40M-30E20-00000-22AE", encodeInvite(relay)
let rb = decodeInvite("280G4-0R40M-30E20-00000-22AE")
assert rb.ok and rb.invite.kind == KindRelay and formatInviteAddress(rb.invite) == "relay:0102030405060708"

var v6a: seq[byte] = @[]
for i in 0 ..< 16: v6a.add byte(i)
let v6 = Invite(kind: KindDirect6, host: v6a, port: 1, token: @[1'u8, 2'u8, 3'u8, 4'u8])
let v6back = decodeInvite(encodeInvite(v6))
assert v6back.ok and v6back.invite.host == v6a and v6back.invite.port == 1
assert formatInviteAddress(v6back.invite) == "[0001:0203:0405:0607:0809:0a0b:0c0d:0e0f]:1"

# Every single-character substitution and every adjacent transposition of the code is rejected (CRC-16 detects them all
# for a message this short).
let plain = code.replace("-", "")
var rejected = 0
var tried = 0
for i in 0 ..< plain.len:
  for c in "0123456789ABCDEFGHJKMNPQRSTVWXYZ":
    if c == plain[i]: continue
    var m = plain
    m[i] = c
    inc tried
    if not decodeInvite(m).ok: inc rejected
assert rejected == tried, "single-character typos all rejected"
assert not decodeInvite("").ok
assert not decodeInvite("ZZZZZ").ok
assert not decodeInvite(plain & "0").ok, "extra character"
assert encodeInvite(Invite(kind: KindDirect4, host: @[1'u8], port: 1, token: @[0'u8, 0'u8, 0'u8, 0'u8])) == ""
assert encodeInvite(Invite(kind: KindDirect4, host: @[1'u8, 1'u8, 1'u8, 1'u8], port: 0, token: @[0'u8, 0'u8, 0'u8, 0'u8])) == ""
var addr4: seq[byte] = @[]
assert parseIPv4("203.0.113.9", addr4) and hex(addr4) == "cb007109"
assert not parseIPv4("256.0.0.1", addr4) and not parseIPv4("1.2.3", addr4) and not parseIPv4("a.b.c.d", addr4)

# --- NAT-PMP ---------------------------------------------------------------------------------------------------------
assert hex(encodeExternalAddressRequest()) == "0000"
assert hex(encodeMapRequest(true, 25565, 25565, 7200'i64)) == "00020000" & "63dd" & "63dd" & "00001c20"
assert hex(encodeMapRequest(false, 1, 2, 3'i64)) == "00010000" & "0001" & "0002" & "00000003"
assert hex(encodeDeleteRequest(true, 25565)) == "00020000" & "63dd" & "0000" & "00000000"
let ext = decodeReply(@[0'u8, 128'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 100'u8, 0xCB'u8, 0'u8, 0x71'u8, 9'u8])
assert ext.ok and ext.op == OpExternalAddress and ext.resultCode == 0 and ext.epoch == 100 and hex(ext.externalAddr) == "cb007109"
let mp = decodeReply(@[0'u8, 130'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 100'u8, 0x63'u8, 0xDD'u8, 0x63'u8, 0xDE'u8, 0'u8, 0'u8, 0x1C'u8, 0x20'u8])
assert mp.ok and mp.op == OpMapTcp and mp.internalPort == 25565 and mp.mappedPort == 25566 and mp.lifetime == 7200
let refused = decodeReply(@[0'u8, 130'u8, 0'u8, 2'u8, 0'u8, 0'u8, 0'u8, 1'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8])
assert refused.ok and refused.resultCode == ResultNotAuthorized and resultText(2).startsWith("not authorized")
assert not decodeReply(@[0'u8, 130'u8, 0'u8, 0'u8]).ok, "short"
assert not decodeReply(@[1'u8, 130'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8]).ok, "wrong version"
assert not decodeReply(@[0'u8, 2'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8]).ok, "a request is not a reply"
assert retryDelayMs(0) == 250 and retryDelayMs(1) == 500 and retryDelayMs(8) == 64000 and retryDelayMs(9) == -1

# --- UPnP ------------------------------------------------------------------------------------------------------------
let search = ssdpSearchRequest()
assert search.startsWith("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\n") and search.endsWith("\r\n\r\n")
assert has(search, "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1") and has(search, "MAN: \"ssdp:discover\"")
let ssdp = "HTTP/1.1 200 OK\r\nCACHE-CONTROL: max-age=120\r\nLocation: http://192.168.1.1:5000/rootDesc.xml\r\nST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n\r\n"
assert parseSsdpLocation(ssdp) == "http://192.168.1.1:5000/rootDesc.xml"
assert parseSsdpLocation("NOTIFY * HTTP/1.1\r\nLOCATION: x\r\n\r\n") == ""
let desc = "<root><device><serviceList><service><serviceType>urn:schemas-upnp-org:service:Layer3Forwarding:1</serviceType><controlURL>/ctl/L3F</controlURL></service></serviceList>" &
  "<deviceList><device><serviceList><service><serviceType>urn:schemas-upnp-org:service:WANIPConnection:1</serviceType><controlURL>/ctl/IPConn</controlURL></service></serviceList></device></deviceList></device></root>"
assert findControlUrl(desc, WanIpService) == "/ctl/IPConn"
assert findControlUrl(desc, WanPppService) == ""
assert joinUrl("http://192.168.1.1:5000/rootDesc.xml", "/ctl/IPConn") == "http://192.168.1.1:5000/ctl/IPConn"
assert joinUrl("http://192.168.1.1:5000/rootDesc.xml", "ctl/IPConn") == "http://192.168.1.1:5000/ctl/IPConn"
assert joinUrl("http://h/x", "http://other/y") == "http://other/y"
let add = addPortMappingBody(WanIpService, 25565, true, 25565, "192.168.1.20", "aowlmony", 3600)
assert has(add, "<u:AddPortMapping xmlns:u=\"urn:schemas-upnp-org:service:WANIPConnection:1\">")
assert has(add, "<NewExternalPort>25565</NewExternalPort><NewProtocol>TCP</NewProtocol><NewInternalPort>25565</NewInternalPort><NewInternalClient>192.168.1.20</NewInternalClient>")
assert has(add, "<NewLeaseDuration>3600</NewLeaseDuration></u:AddPortMapping>")
assert soapActionHeader(WanIpService, "AddPortMapping") == "\"urn:schemas-upnp-org:service:WANIPConnection:1#AddPortMapping\""
assert has(deletePortMappingBody(WanIpService, 1, false), "<NewProtocol>UDP</NewProtocol>")
assert parseExternalIp("<s:Envelope><s:Body><u:GetExternalIPAddressResponse><NewExternalIPAddress>203.0.113.9</NewExternalIPAddress></u:GetExternalIPAddressResponse></s:Body></s:Envelope>") == "203.0.113.9"
assert parseUpnpErrorCode("<UPnPError><errorCode>718</errorCode><errorDescription>ConflictInMappingEntry</errorDescription></UPnPError>") == 718
assert parseUpnpErrorCode("<ok/>") == 0

echo "hosting ok"
