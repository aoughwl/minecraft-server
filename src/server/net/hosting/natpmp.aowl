## NAT-PMP (RFC 6886) packet codecs, UDP port 5351 on the default gateway. Pure bytes, no sockets (phase 3 #20; the I/O
## loop is described in docs/DESIGN_20_HOSTING.md). Big-endian. Version is always 0.

const
  NatPmpPort* = 5351
  OpExternalAddress* = 0
  OpMapUdp* = 1
  OpMapTcp* = 2
  ResultSuccess* = 0
  ResultUnsupportedVersion* = 1
  ResultNotAuthorized* = 2
  ResultNetworkFailure* = 3
  ResultOutOfResources* = 4
  ResultUnsupportedOpcode* = 5

type
  NatPmpReply* = object
    ok*: bool              ## parsed structurally (length, version, opcode >= 128)
    op*: int               ## request opcode (response opcode - 128)
    resultCode*: int
    epoch*: int64
    externalAddr*: seq[byte]   ## external-address replies
    internalPort*: int         ## mapping replies
    mappedPort*: int
    lifetime*: int64

proc put16(w: var seq[byte]; v: int) =
  w.add byte((v shr 8) and 255)
  w.add byte(v and 255)

proc put32(w: var seq[byte]; v: int64) =
  w.add byte((v shr 24) and 255)
  w.add byte((v shr 16) and 255)
  w.add byte((v shr 8) and 255)
  w.add byte(v and 255)

proc get16(b: seq[byte]; at: int): int = (int(b[at]) shl 8) or int(b[at + 1])
proc get32(b: seq[byte]; at: int): int64 =
  (int64(b[at]) shl 24) or (int64(b[at + 1]) shl 16) or (int64(b[at + 2]) shl 8) or int64(b[at + 3])

proc encodeExternalAddressRequest*(): seq[byte] = @[0'u8, 0'u8]

proc encodeMapRequest*(tcp: bool; internalPort, suggestedExternal: int; lifetimeSeconds: int64): seq[byte] =
  ## Lifetime 0 with external port 0 deletes the mapping. RFC suggests 7200 s and renewing at half the lifetime.
  var r: seq[byte] = @[]
  r.add 0'u8
  r.add byte(if tcp: OpMapTcp else: OpMapUdp)
  put16(r, 0)
  put16(r, internalPort)
  put16(r, suggestedExternal)
  put32(r, lifetimeSeconds)
  r

proc encodeDeleteRequest*(tcp: bool; internalPort: int): seq[byte] =
  encodeMapRequest(tcp, internalPort, 0, 0'i64)

proc decodeReply*(b: seq[byte]): NatPmpReply =
  var r = NatPmpReply(ok: false, externalAddr: @[])
  if b.len < 8 or b[0] != 0'u8 or int(b[1]) < 128:
    return r
  r.op = int(b[1]) - 128
  r.resultCode = get16(b, 2)
  r.epoch = get32(b, 4)
  if r.op == OpExternalAddress:
    if b.len != 12: return NatPmpReply(ok: false, externalAddr: @[])
    for i in 8 ..< 12: r.externalAddr.add b[i]
  elif r.op == OpMapUdp or r.op == OpMapTcp:
    if b.len != 16: return NatPmpReply(ok: false, externalAddr: @[])
    r.internalPort = get16(b, 8)
    r.mappedPort = get16(b, 10)
    r.lifetime = get32(b, 12)
  else:
    return NatPmpReply(ok: false, externalAddr: @[])
  r.ok = true
  r

proc retryDelayMs*(attempt: int): int =
  ## RFC 6886 3.1: 250 ms, doubling, for 9 attempts (attempt 0..8); -1 after that (give up).
  if attempt < 0 or attempt > 8: return -1
  250 shl attempt

proc resultText*(code: int): string =
  case code
  of 0: "success"
  of 1: "unsupported version"
  of 2: "not authorized/refused (port mapping disabled on the router)"
  of 3: "network failure (router has no external address)"
  of 4: "out of resources"
  of 5: "unsupported opcode"
  else: "unknown result " & $code
