## UPnP IGD message builders and parsers (SSDP discovery, device description, SOAP AddPortMapping/DeletePortMapping).
## Pure strings: no sockets, no HTTP client (phase 3 #20). docs/DESIGN_20_HOSTING.md has the wire loop. Parsing is
## deliberately tolerant string scanning, not a general XML parser.

import std/strutils

const
  SsdpAddress* = "239.255.255.250"
  SsdpPort* = 1900
  WanIpService* = "urn:schemas-upnp-org:service:WANIPConnection:1"
  WanPppService* = "urn:schemas-upnp-org:service:WANPPPConnection:1"
  IgdSearchTarget* = "urn:schemas-upnp-org:device:InternetGatewayDevice:1"

proc ssdpSearchRequest*(searchTarget: string = IgdSearchTarget; mx: int = 2): string =
  "M-SEARCH * HTTP/1.1\r\nHOST: " & SsdpAddress & ":" & $SsdpPort & "\r\nMAN: \"ssdp:discover\"\r\nMX: " & $mx &
    "\r\nST: " & searchTarget & "\r\n\r\n"

proc headerValue*(response, name: string): string =
  ## Case-insensitive header lookup in an HTTP/SSDP response; "" when absent.
  let want = name.toLowerAscii() & ":"
  for line in response.split('\n'):
    let l = line.strip()
    if l.toLowerAscii().startsWith(want):
      return l.substr(want.len).strip()
  ""

proc parseSsdpLocation*(response: string): string =
  ## The device description URL of a 200 OK search response, "" if it is not one.
  if not response.startsWith("HTTP/1.1 200") and not response.startsWith("HTTP/1.0 200"):
    return ""
  headerValue(response, "location")

proc tagText*(xml, tag: string; from0: int = 0): string =
  ## Text of the first <tag>..</tag> at or after `from0`; "" when absent.
  let open = "<" & tag & ">"
  let a = xml.find(open, from0)
  if a < 0: return ""
  let b = xml.find("</" & tag & ">", a + open.len)
  if b < 0: return ""
  xml.substr(a + open.len, b - 1).strip()

proc findControlUrl*(description: string; serviceType: string): string =
  ## The <controlURL> of the <service> whose <serviceType> is `serviceType` ("" if none). Relative to the description's
  ## own origin: the caller joins it (see `joinUrl`).
  var at = 0
  while true:
    let s = description.find("<service>", at)
    if s < 0: return ""
    let e = description.find("</service>", s)
    if e < 0: return ""
    let part = description.substr(s, e)
    if tagText(part, "serviceType") == serviceType:
      return tagText(part, "controlURL")
    at = e + 1

proc joinUrl*(descriptionUrl, controlUrl: string): string =
  ## Resolve a controlURL against the description URL (absolute, root-relative or path-relative).
  if controlUrl.startsWith("http://") or controlUrl.startsWith("https://"):
    return controlUrl
  let schemeEnd = descriptionUrl.find("://")
  if schemeEnd < 0: return controlUrl
  let pathStart = descriptionUrl.find('/', schemeEnd + 3)
  let origin = if pathStart < 0: descriptionUrl else: descriptionUrl.substr(0, pathStart - 1)
  if controlUrl.startsWith("/"):
    return origin & controlUrl
  origin & "/" & controlUrl

proc soapEnvelope(serviceType, action, args: string): string =
  "<?xml version=\"1.0\"?>\r\n<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" " &
    "s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:" & action & " xmlns:u=\"" & serviceType &
    "\">" & args & "</u:" & action & "></s:Body></s:Envelope>"

proc soapActionHeader*(serviceType, action: string): string =
  "\"" & serviceType & "#" & action & "\""

proc protoName(tcp: bool): string = (if tcp: "TCP" else: "UDP")

proc addPortMappingBody*(serviceType: string; externalPort: int; tcp: bool; internalPort: int; internalClient, description: string;
    leaseSeconds: int): string =
  soapEnvelope(serviceType, "AddPortMapping",
    "<NewRemoteHost></NewRemoteHost><NewExternalPort>" & $externalPort & "</NewExternalPort><NewProtocol>" &
    protoName(tcp) & "</NewProtocol><NewInternalPort>" & $internalPort & "</NewInternalPort><NewInternalClient>" &
    internalClient & "</NewInternalClient><NewEnabled>1</NewEnabled><NewPortMappingDescription>" & description &
    "</NewPortMappingDescription><NewLeaseDuration>" & $leaseSeconds & "</NewLeaseDuration>")

proc deletePortMappingBody*(serviceType: string; externalPort: int; tcp: bool): string =
  soapEnvelope(serviceType, "DeletePortMapping",
    "<NewRemoteHost></NewRemoteHost><NewExternalPort>" & $externalPort & "</NewExternalPort><NewProtocol>" &
    protoName(tcp) & "</NewProtocol>")

proc getExternalIpBody*(serviceType: string): string =
  soapEnvelope(serviceType, "GetExternalIPAddress", "")

proc parseExternalIp*(soapResponse: string): string =
  tagText(soapResponse, "NewExternalIPAddress")

proc parseUpnpErrorCode*(soapResponse: string): int =
  ## 0 when the response carries no <errorCode>; else the UPnP error (718 ConflictInMappingEntry, 725 OnlyPermanentLeasesSupported ...).
  let t = tagText(soapResponse, "errorCode")
  if t.len == 0: return 0
  var v = 0
  for c in t:
    if c < '0' or c > '9': return 0
    v = v * 10 + (int(c) - int('0'))
  v
