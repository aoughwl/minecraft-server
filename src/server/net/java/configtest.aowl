## Test of pumpkin/src/net/java/config.rs `handle_resource_pack_response` log lines.

import std/[assertions, syncio]
import ../../logging
import ../../../protocol/varint
import ../../../protocol/java/server/config/resource_pack_response
import config

proc res(code: int32): ResourcePackResponseResult =
  SConfigResourcePack(result: newVarInt(code)).responseResult()

let ok = resourcePackResponseMessage(7'u64, res(0))
assert ok.level == llTrace
assert ok.text == "Client 7 successfully downloaded the resource pack"
let fail = resourcePackResponseMessage(7'u64, res(2))
assert fail.level == llWarn
assert fail.text == "Client 7 failed to downloaded the resource pack. Is it available on the internet?"
assert resourcePackResponseMessage(1'u64, res(3)).text == "Client 1 accepted the resource pack"
assert resourcePackResponseMessage(1'u64, res(5)).level == llWarn
let bad = resourcePackResponseMessage(2'u64, res(42))
assert bad.level == llWarn
assert bad.text == "Client 2 responded with a bad result: 42!"
echo "configtest ok"
