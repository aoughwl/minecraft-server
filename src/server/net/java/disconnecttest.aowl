## Test for how a JavaClient notices that its peer has left (net/java/javamod.aowl), over a real loopback socket pair. A
## player is removed from the world only once its client is `isClosed` (pumpkinlib's `finished`), so both ways a dead
## peer shows up must close the client: `pumpSocket` seeing the orderly close, and `flushOutgoing` seeing a failed send.
## The second one used to set only `gone`, which stops `pumpSocket` from ever running again: the player then stayed
## online until the keep-alive timeout. tools/mcbot.py and the lifecycle scenario check the same thing end to end.
import std/[assertions, options, syncio]
import ../winsock
import javamod

type
  TestAddr = object
    sinFamily: int16
    sinPort: uint16
    sinAddr: uint32
    sinZero: array[8, byte]

proc tSocket(domain, typ, protocol: cint): SocketHandle {.stdcall, importc: "socket", dynlib: "ws2_32.dll".}
proc tConnect(s: SocketHandle; name: ptr TestAddr; namelen: cint): cint {.stdcall, importc: "connect", dynlib: "ws2_32.dll".}
proc tHtons(v: uint16): uint16 {.stdcall, importc: "htons", dynlib: "ws2_32.dll".}

proc connectLoopback(port: uint16): SocketHandle =
  result = tSocket(cint(2), cint(1), cint(6))
  var a = TestAddr(sinFamily: 2'i16, sinPort: tHtons(port), sinAddr: ipv4(127, 0, 0, 1))
  assert tConnect(result, addr a, cint(sizeof(TestAddr))) == cint(0), "connect to the loopback listener"

proc pair(): (SocketHandle, SocketHandle, SocketHandle) =
  ## (listener, client side, server side)
  var port = 46000'u16
  var listener = InvalidSocket
  while port < 46100'u16:
    listener = listenOnNonBlockingAt(ipv4(127, 0, 0, 1), port)
    if int(listener) != int(InvalidSocket):
      break
    port += 1'u16
  assert int(listener) != int(InvalidSocket), "a free loopback port"
  let client = connectLoopback(port)
  var server = InvalidSocket
  var tries = 0
  while int(server) == int(InvalidSocket) and tries < 500:
    server = tryAccept(listener)
    if int(server) == int(InvalidSocket):
      sleepMs(2)
    tries += 1
  assert int(server) != int(InvalidSocket), "the connection was accepted"
  (listener, client, server)

proc orderlyClose() =
  ## A FIN from the peer is seen by `pumpSocket`.
  assert initWinsock()
  let (listener, peer, serverSide) = pair()
  let c = newJavaClient(serverSide, 1'u64)
  c.pumpSocket()
  assert not c.isClosed, "an idle but connected client stays open"
  closeClient(peer)
  var tries = 0
  while not c.isClosed and tries < 500:
    c.pumpSocket()
    sleepMs(2)
    tries += 1
  assert c.isClosed, "pumpSocket must notice the orderly close"
  assert c.gone
  closeClient(serverSide)
  closeClient(listener)

proc failedSend() =
  ## No one reads the socket any more (the packet loop of a player whose bytes are all queued), so only a write finds out.
  assert initWinsock()
  let (listener, peer, serverSide) = pair()
  let c = newJavaClient(serverSide, 2'u64)
  closeClient(peer)
  var tries = 0
  while not c.gone and tries < 1000:
    c.outgoing = newSeq[byte](1024)
    c.outgoingStart = 0
    c.flushOutgoing()
    sleepMs(2)
    tries += 1
  assert c.gone, "a send to a closed peer must fail in the end"
  assert c.isClosed, "a client whose socket is gone must be closed, or the leave path never runs"
  closeClient(serverSide)
  closeClient(listener)

orderlyClose()
failedSend()
echo "disconnect: ok"
