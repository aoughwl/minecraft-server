const KeepAliveIntervalMs = 15000'i64

proc handleHandshakePacket(self: JavaClient; packet: RawPacket): ProtoReadVoidResult =
  var payload = newNetReader(packet.payload)
  if packet.id == 0'i32:
    let hs = SHandShake.readPacket(payload, self.version)
    if not hs.isOk:
      return readErrVoid(hs.error)
    self.handleHandshake(hs.value)
    return readOkVoid()
  readErrVoid(messageRead("Failed to handle packet id " & $packet.id & " in Handshake State"))

proc handleStatusPacket(self: JavaClient; server: Server; packet: RawPacket): ProtoReadVoidResult =
  var payload = newNetReader(packet.payload)
  let version = self.version
  if packet.id == SStatusRequest.toId(version):
    self.handleStatusRequest(server)
    return readOkVoid()
  if packet.id == SStatusPingRequest.toId(version):
    let ping = SStatusPingRequest.readPacket(payload, version)
    if not ping.isOk:
      return readErrVoid(ping.error)
    self.handlePingRequest(ping.value)
    return readOkVoid()
  readErrVoid(messageRead("Failed to handle java client packet id " & $packet.id & " in Status State"))

proc handleLoginPacket(self: JavaClient; server: Server; packet: RawPacket): ProtoReadVoidResult =
  var payload = newNetReader(packet.payload)
  let version = self.version
  if packet.id == SLoginStart.toId(version):
    let start = SLoginStart.readPacket(payload, version)
    if not start.isOk:
      return readErrVoid(start.error)
    self.handleLoginStart(server, start.value)
  elif packet.id == SLoginAcknowledged.toId(version):
    self.handleLoginAcknowledged(server)
  elif packet.id == SEncryptionResponse.toId(version):
    let response = SEncryptionResponse.readPacket(payload, version)
    if not response.isOk:
      return readErrVoid(response.error)
    self.handleEncryptionResponse(server, response.value)
  elif packet.id == SLoginPluginResponse.toId(version):
    let response = SLoginPluginResponse.readPacket(payload, version)
    if not response.isOk:
      return readErrVoid(response.error)
    self.handleLoginPluginResponse(server, response.value)
  elif packet.id == SLoginCookieResponse.toId(version):
    let cookie = SLoginCookieResponse.readPacket(payload, version)
    if not cookie.isOk:
      return readErrVoid(cookie.error)
    self.handleLoginCookieResponse(cookie.value)
  else:
    echo "Failed to handle java client packet id ", packet.id, " in Login State"
  readOkVoid()

proc handleConfigPacket(self: JavaClient; server: Server; packet: RawPacket; result0: var PacketHandlerResult): ProtoReadVoidResult =
  var payload = newNetReader(packet.payload)
  let version = self.version
  if packet.id == SClientInformationConfig.toId(version):
    let info = SClientInformationConfig.readPacket(payload, version)
    if not info.isOk:
      return readErrVoid(info.error)
    self.handleClientInformationConfig(info.value)
  elif packet.id == plugin_message.SPluginMessage.toId(version):
    let message = plugin_message.SPluginMessage.readPacket(payload, version)
    if not message.isOk:
      return readErrVoid(message.error)
    self.handlePluginMessage(message.value)
  elif packet.id == custom_click_action.SCustomClickAction.toId(version):
    echo "CustomClickAction in config state not yet supported"
  elif packet.id == SAcknowledgeFinishConfig.toId(version):
    result0 = self.handleConfigAcknowledged(server)
  elif packet.id == SKnownPacks.toId(version):
    let packs = SKnownPacks.readPacket(payload, version)
    if not packs.isOk:
      return readErrVoid(packs.error)
    self.handleKnownPacks(packs.value, server)
  elif packet.id == cfgkeepalive.SKeepAlive.toId(version):
    let alive = cfgkeepalive.SKeepAlive.readPacket(payload, version)
    if not alive.isOk:
      return readErrVoid(alive.error)
    self.handleConfigKeepAlive(alive.value)
  elif packet.id == SConfigCookieResponse.toId(version):
    let cookie = SConfigCookieResponse.readPacket(payload, version)
    if not cookie.isOk:
      return readErrVoid(cookie.error)
    self.handleConfigCookieResponse(cookie.value)
  elif packet.id == SConfigResourcePack.toId(version):
    let pack = SConfigResourcePack.readPacket(payload, version)
    if not pack.isOk:
      return readErrVoid(pack.error)
    self.handleResourcePackResponse(pack.value)
  else:
    echo "Failed to handle java client packet id ", packet.id, " in Config State"
  readOkVoid()

proc handlePacket*(self: JavaClient; server: Server; packet: RawPacket; result0: var PacketHandlerResult): ProtoReadVoidResult =
  ## `handle_packet`: `result0` stops being `phrContinue`, upstream's `None`, when the login sequence has ended.
  case self.connectionState
  of csHandShake: self.handleHandshakePacket(packet)
  of csStatus: self.handleStatusPacket(server, packet)
  # TODO: Check config if transfer is enabled
  of csLogin, csTransfer: self.handleLoginPacket(server, packet)
  of csConfig: self.handleConfigPacket(server, packet, result0)
  of csPlay: readOkVoid()

template route(packetType, payload, version: untyped; body: untyped) =
  ## One arm of `handle_play_packet`'s match: reads the packet as `p` and runs `body`.
  block:
    let read0 = packetType.readPacket(payload, version)
    if not read0.isOk:
      return readErrVoid(read0.error)
    let p {.inject.} = read0.value
    body

proc handlePlayPacket*(self: JavaClient; player: Player; server: Server; packet: RawPacket): ProtoReadVoidResult =
  ## `handle_play_packet`. Unlike upstream's "Failed to handle" warning for an unknown id this stays quiet: a real client
  ## sends what the port has no table for, a dozen a second.
  # `PacketReceivedEvent` (plugin/api/events/server/packet.aowl): a cancelled packet is not handled.
  if gPluginPacketReceivedHook(player, packet.id, packet.payload):
    return readOkVoid()
  var payload = newNetReader(packet.payload)
  let version = self.version
  let id = packet.id
  if id == SConfirmTeleport.toId(version):
    route(SConfirmTeleport, payload, version): self.handleConfirmTeleport(player, p)
  elif id == SChangeGameMode.toId(version):
    route(SChangeGameMode, payload, version): self.handleChangeGameMode(player, p)
  elif id == SChatCommand.toId(version):
    route(SChatCommand, payload, version): self.handleChatCommand(player, server, p)
  elif id == SChatMessage.toId(version):
    route(SChatMessage, payload, version): self.handleChatMessage(server, player, p)
  elif id == SClientInformationPlay.toId(version):
    route(SClientInformationPlay, payload, version): self.handleClientInformation(player, server, p)
  elif id == SClientCommand.toId(version):
    route(SClientCommand, payload, version): self.handleClientStatus(player, p)
  elif id == SPlayerInput.toId(version):
    route(SPlayerInput, payload, version): self.handlePlayerInput(player, p)
  elif id == SMoveVehicle.toId(version):
    route(SMoveVehicle, payload, version): self.handleMoveVehicle(player, server, p)
  elif id == SPaddleBoat.toId(version):
    route(SPaddleBoat, payload, version): self.handlePaddleBoat(player, p)
  elif id == SInteract.toId(version):
    route(SInteract, payload, version): self.handleInteract(player, p, server)
  elif id == SBundleItemSelected.toId(version):
    route(SBundleItemSelected, payload, version): self.handleBundleItemSelected(player, p)
  elif id == SAttack.toId(version):
    route(SAttack, payload, version): self.handleAttack(player, p, server)
  elif id == STeleportToEntity.toId(version):
    route(STeleportToEntity, payload, version): self.handleTeleportToEntity(player, p, server)
  elif id == playkeepalive.SKeepAlive.toId(version):
    route(playkeepalive.SKeepAlive, payload, version): self.handleKeepAlive(player, p)
  elif id == SClientTickEnd.toId(version):
    discard # TODO upstream
  elif id == STestInstanceBlockAction.toId(version):
    route(STestInstanceBlockAction, payload, version): self.handleTestInstanceBlockAction(player, p)
  elif id == SSetTestBlock.toId(version):
    route(SSetTestBlock, payload, version): self.handleSetTestBlock(player, p)
  elif id == SDebugSubscriptionRequest.toId(version):
    route(SDebugSubscriptionRequest, payload, version): self.handleDebugSubscriptionRequest(player, p.sampleType.value)
  elif id == SDebugSampleSubscription.toId(version):
    route(SDebugSampleSubscription, payload, version): self.handleDebugSampleSubscription(player, p.sampleType.value)
  elif id == SPlayerPosition.toId(version):
    route(SPlayerPosition, payload, version): self.handlePosition(player, server, p)
  elif id == SPlayerPositionRotation.toId(version):
    route(SPlayerPositionRotation, payload, version): self.handlePositionRotation(player, server, p)
  elif id == SPlayerRotation.toId(version):
    route(SPlayerRotation, payload, version): self.handleRotation(player, p)
  elif id == SSetPlayerGround.toId(version):
    route(SSetPlayerGround, payload, version): self.handlePlayerGround(player, p)
  elif id == SPickItemFromBlock.toId(version):
    route(SPickItemFromBlock, payload, version): self.handlePickItemFromBlock(player, p)
  elif id == SPickItemFromEntity.toId(version):
    route(SPickItemFromEntity, payload, version): self.handlePickItemFromEntity(player, p)
  elif id == SPlayerAbilities.toId(version):
    route(SPlayerAbilities, payload, version): self.handlePlayerAbilities(player, p)
  elif id == SPlayerAction.toId(version):
    route(SPlayerAction, payload, version): self.handlePlayerAction(player, p, server)
  elif id == SSetCommandBlock.toId(version):
    route(SSetCommandBlock, payload, version): self.handleSetCommandBlock(player, p)
  elif id == SSetJigsawBlock.toId(version):
    route(SSetJigsawBlock, payload, version): self.handleSetJigsawBlock(player, p)
  elif id == SJigsawGenerate.toId(version):
    route(SJigsawGenerate, payload, version): self.handleJigsawGenerate(player, p)
  elif id == SPlayerCommand.toId(version):
    route(SPlayerCommand, payload, version): self.handlePlayerCommand(player, p)
  elif id == SPlayerLoaded.toId(version):
    handlePlayerLoaded(player)
  elif id == SPlayPingRequest.toId(version):
    route(SPlayPingRequest, payload, version): self.handlePlayPingRequest(p)
  elif id == SClickSlot.toId(version):
    route(SClickSlot, payload, version): onSlotClick(player, p)
  elif id == SContainerButtonClick.toId(version):
    route(SContainerButtonClick, payload, version): onContainerButtonClick(player, p)
  elif id == SSetHeldItem.toId(version):
    route(SSetHeldItem, payload, version): self.handleSetHeldItem(player, p)
  elif id == SSetCreativeSlot.toId(version):
    route(SSetCreativeSlot, payload, version):
      if not self.handleSetCreativeSlot(player, p):
        self.kick(text("Permission error"))
  elif id == SSwingArm.toId(version):
    route(SSwingArm, payload, version): self.handleSwingArm(player, p)
  elif id == SUpdateSign.toId(version):
    route(SUpdateSign, payload, version): self.handleSignUpdate(player, p)
  elif id == SUseItemOn.toId(version):
    route(SUseItemOn, payload, version):
      let (ok, err) = self.handleUseItemOn(player, p, server)
      if not ok:
        # `BlockPlacingError`: only a bad face or hand is a kick.
        case err
        of bpInvalidBlockFace: self.kick(text("Invalid block face"))
        of bpInvalidHand: self.kick(text("Invalid hand"))
        else: discard
  elif id == SUseItem.toId(version):
    route(SUseItem, payload, version): self.handleUseItem(player, p, server)
  elif id == SCommandSuggestion.toId(version):
    route(SCommandSuggestion, payload, version): self.handleCommandSuggestion(player, server, p)
  elif id == playcookie.SCookieResponse.toId(version):
    route(playcookie.SCookieResponse, payload, version): self.handleCookieResponse(p)
  elif id == SCloseContainer.toId(version):
    self.handleCloseContainer(player)
  elif id == SChunkBatch.toId(version):
    route(SChunkBatch, payload, version): self.handleChunkBatch(player, p)
  elif id == SPlayerSession.toId(version):
    route(SPlayerSession, payload, version): self.handleChatSessionUpdate(player, server, p)
  elif id == SCustomPayload.toId(version):
    route(SCustomPayload, payload, version): self.handleCustomPayload(player, p)
  elif id == SRecipeBookChangeSettings.toId(version):
    route(SRecipeBookChangeSettings, payload, version): self.handleRecipeBookChangeSettings(player, p)
  elif id == SRecipeBookSeenRecipe.toId(version):
    route(SRecipeBookSeenRecipe, payload, version): self.handleRecipeBookSeenRecipe(player, p)
  elif id == SPlaceRecipe.toId(version):
    route(SPlaceRecipe, payload, version): self.handlePlaceRecipe(player, p)
  elif id == SRenameItem.toId(version):
    route(SRenameItem, payload, version): onRenameItem(player, p)
  elif id == SSelectTrade.toId(version):
    route(SSelectTrade, payload, version): self.handleSelectTrade(player, p)
  elif id == SSeenAdvancement.toId(version):
    route(SSeenAdvancement, payload, version): self.handleSeenAdvancement(player, p)
  readOkVoid()

proc progressKeepAlive*(self: JavaClient) =
  ## The keep-alive timer branch of `progress_player_packets`.
  let now = nowMs()
  if now < self.nextKeepAliveAt:
    return
  self.nextKeepAliveAt = now + KeepAliveIntervalMs
  # If the client never responded to the LAST keep-alive, they timed out.
  if self.waitForKeepAlive:
    self.kick(translate(tr.JAVA_DISCONNECT_TIMEOUT))
    return
  # Generate a unique ID (upstream: current timestamp in ms)
  let keepAliveId = now
  self.keepAliveId = keepAliveId
  self.waitForKeepAlive = true
  self.lastKeepAliveTime = now
  self.writePacketFor(CKeepAlive(keepAliveId: keepAliveId))
  let seq0 = self.packetSequence
  self.packetSequence = -1'i32
  if seq0 != -1'i32:
    self.writePacketFor(CAcknowledgeBlockChange(sequenceId: newVarInt(seq0)))

proc progressLoginFor*(self: JavaClient; server: Server) =
  ## login.aowl's `progressLogin`: the session server's answer, when its worker thread has it.
  self.progressLogin(server)
