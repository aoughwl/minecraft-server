import ../../../protocol/java/server/handshake/handshakemod
import ../../../generated/translation as tr
import ../../../util/text/text
import javamod

proc handleHandshake*(self: JavaClient; handshake: SHandShake) =
  let version = cast[uint32](handshake.protocolVersion.value)
  self.serverAddress = handshake.serverAddress
  self.version = fromProtocol(version)

  self.connectionState = handshake.nextState
  if self.connectionState != csStatus:
    let protocol = version
    if protocol < uint32(LowestSupportedMcVersion.protocolVersion()):
      self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_OUTDATED_CLIENT, tr.JAVA_MULTIPLAYER_DISCONNECT_OUTDATED_CLIENT,
        [text($CurrentMcVersion)]))
    elif protocol > uint32(CurrentMcVersion.protocolVersion()):
      self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_OUTDATED_SERVER, tr.JAVA_MULTIPLAYER_DISCONNECT_OUTDATED_SERVER,
        [text($CurrentMcVersion)]))
