## The join guard (Fabric gap): a login is refused with a clear reason while the world loads (Server.joinHold) or the server stops,
## and passes when released; clients on the wrong protocol version are refused at the handshake. No socket.
## Runs the connection path's pure parts with no socket: a client whose outgoing bytes are read back from its encoder.
## Covers handshake.aowl, status.aowl, login.aowl, config.aowl, connection_cache.aowl, netbase.aowl's additions and
## entity/player.aowl's ChunkManager. tools/mcbot.py is the end-to-end check.
import std/[assertions, options, syncio]
import ../../../protocol/java/server/handshake/handshakemod
import ../../../protocol/java/server/login/login_start
import ../../../protocol/java/packet_decoder
import ../../../generated/packet
import ../../../world/playerdata
import ../../key_store
import ../../recipe
import ../../scheduler
import ../../tick_rate_manager
import ../../data/datamod
import ../../../world/chunkdata
import ../../../world/chunk_system/chunk_system
import ../../serverbase
import ../../entity/player
import ../../world/chunker
import ../winsock
import javamod, handshake, status, login, config

proc newServer(onlineMode: bool): Server =
  var advanced = defaultAdvancedConfiguration()
  advanced.networking.java.onlineMode = onlineMode
  advanced.networking.java.encryption = onlineMode
  advanced.networking.java.compression.enabled = false
  Server(basicConfig: defaultBasicConfiguration(), advancedConfig: advanced, worlds: @[], dimensions: @[],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
    stopRequested: false, stopAtMs: 0'i64)

proc nextPacket(client: JavaClient; decoder: var TCPNetworkDecoder): RawPacket =
  ## What the client would read next: the encoder's bytes through a fresh decoder.
  decoder.feed(client.networkWriter.flush())
  assert decoder.packetReady()
  let res = decoder.getRawPacket()
  assert res.isOk
  res.value

proc hs(next: ConnectionState; protocol: int32): SHandShake =
  SHandShake(protocolVersion: newVarInt(protocol), serverAddress: "localhost", serverPort: 25565'u16, nextState: next)


proc hasText(hay, needle: string): bool =
  var i = 0
  while i + needle.len <= hay.len:
    if hay[i ..< i + needle.len] == needle:
      return true
    i += 1
  false

# While the world loads (joinHold) or the server stops, a login is refused with a clear reason and never gets a profile;
# released, it passes. (The kick closes the client, so the reason is checked through joinRefusal.)
let server = newServer(false)
assert joinRefusal(server) == "", "an open server refuses nobody"
server.joinHold = "The server is still loading the world. Please try again in a moment."
assert hasText(joinRefusal(server), "still loading the world")
let c = newJavaClient(InvalidSocket, 20'u64)
c.handleHandshake(hs(csLogin, 774'i32))
c.handleLoginStart(server, SLoginStart(name: "Early", uuid: NilUuid))
assert c.isClosed, "a held server kicks at login"
assert c.gameprofile.isNone
server.joinHold = ""
server.stopRequested = true
assert hasText(joinRefusal(server), "shutting down")
let c2 = newJavaClient(InvalidSocket, 21'u64)
c2.handleHandshake(hs(csLogin, 774'i32))
c2.handleLoginStart(server, SLoginStart(name: "Late", uuid: NilUuid))
assert c2.isClosed and c2.gameprofile.isNone
server.stopRequested = false
let c3 = newJavaClient(InvalidSocket, 22'u64)
c3.handleHandshake(hs(csLogin, 774'i32))
c3.handleLoginStart(server, SLoginStart(name: "Fine", uuid: NilUuid))
var d3 = newTCPNetworkDecoder()
assert not c3.isClosed, "released: login goes on"
assert c3.gameprofile.isSome and c3.gameprofile.unsafeGet.id == offlineUuid("Fine")
assert nextPacket(c3, d3).id == CB_LOGIN_LOGIN_FINISHED.toId(jmvV1_21_11)
# the version mismatch has its own clear refusal
let old = newJavaClient(InvalidSocket, 23'u64)
old.handleHandshake(hs(csLogin, 765'i32))
assert old.isClosed, "an outdated client is refused at the handshake"
let newer = newJavaClient(InvalidSocket, 24'u64)
newer.handleHandshake(hs(csLogin, 777'i32))
assert newer.isClosed, "a newer client is refused at the handshake"
echo "joinguardtest ok"
