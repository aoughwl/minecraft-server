## Port of pumpkin/src/net/java/login.rs
## PARTIAL: pumpkin/src/net/java/login.rs - offline mode only. With `online_mode` or `encryption` set, `handle_login_start` refuses the client: `handle_encryption_response`, `authenticate` and the key store are not ported. No proxy logins, resource-pack branch is ported but its answer is in config.aowl.

import std/options
import ../../../protocol/java/client/config/[add_resource_pack, server_links, known_packs, plugin_message]
import ../../../protocol/java/client/login/[login_success, set_compression]
import ../../../protocol/java/server/login/[login_start, cookie_response]
import ../../../protocol/uuid
import ../../../generated/translation as tr
import ../../../util/text/text
import ../../../config/networking/compression
import ../../connection_cache
import ../../serverbase
import ../../servermod
import javamod

proc enableCompression(self: JavaClient; server: Server) =
  if self.version < jmvV1_8:
    return
  let compression = server.advancedConfig.networking.java.compression.info
  # We want to wait until we have sent the compression packet to the client
  self.writePacketFor(CSetCompression(threshold: newVarInt(int32(compression.threshold))))
  self.setCompression(compression)

proc finishLogin(self: JavaClient; profile: GameProfile) =
  var props: seq[Property] = @[]
  for p in profile.properties:
    props.add(Property(name: p.name, value: p.value,
      signature: if p.signature.len > 0: some(p.signature) else: none[string]()))
  let (_, sessionId) = newV4()
  self.writePacketFor(CLoginSuccess(uuid: profile.id, username: profile.name, properties: props,
    strictErrorHandling: false, sessionId: sessionId))
  if self.version < jmvV1_20_2:
    self.connectionState = csPlay

proc handleLoginStart*(self: JavaClient; server: Server; loginStart: SLoginStart) =
  # Don't allow new logons when the server is full.
  # If `max_players` is set to zero, then there is no max player count enforced.
  let maxPlayers = server.advancedConfig.networking.java.maxPlayers
  if maxPlayers > 0'u32 and server.getPlayerCount() >= int(maxPlayers):
    self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_SERVER_FULL, tr.JAVA_MULTIPLAYER_DISCONNECT_SERVER_FULL))
    return

  if not isValidPlayerName(loginStart.name):
    self.kick(text("Invalid characters in username"))
    return

  let java = server.advancedConfig.networking.java
  if java.onlineMode or java.encryption:
    self.kick(text("This server does not do online mode or encryption yet"))
    return

  let id = offlineUuid(loginStart.name)
  let profile = GameProfile(id: id, name: loginStart.name, properties: @[], profileActions: @[])

  if java.compression.enabled:
    self.enableCompression(server)

  # Don't allow a duplicate UUID or username. Upstream only checks this in `handle_encryption_response`,
  # which an offline login never reaches; two clients with one name would share every player lookup here.
  if server.getPlayerByUuid(profile.id).isSome or server.getPlayerByName(profile.name).isSome:
    self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN, tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN))
    return

  self.finishLogin(profile)
  self.gameprofile = some(profile)

proc handleLoginCookieResponse*(self: JavaClient; packet: SLoginCookieResponse) =
  discard

proc sendKnownPacks*(self: JavaClient) =
  ## Send the known data packs to the client.
  let versionStr = $self.version
  self.writePacketFor(CKnownPacks(knownPacks: @[KnownPack(namespace: "minecraft", id: "core", version: versionStr)]))

proc handleLoginAcknowledged*(self: JavaClient; server: Server) =
  self.connectionState = csConfig
  self.writePacketFor(getBranding())

  let linksConfig = server.advancedConfig.serverLinks
  if linksConfig.enabled and self.version >= jmvV1_21:
    var links: seq[Link] = @[]
    template addLink(url: string; linkType: LinkType) =
      if url.len > 0:
        links.add(newLink(Label(kind: lkBuiltIn, builtIn: linkType), url))
    addLink(linksConfig.bugReport, ltBugReport)
    addLink(linksConfig.support, ltSupport)
    addLink(linksConfig.status, ltStatus)
    addLink(linksConfig.feedback, ltFeedback)
    addLink(linksConfig.community, ltCommunity)
    addLink(linksConfig.website, ltWebsite)
    addLink(linksConfig.forums, ltForums)
    addLink(linksConfig.news, ltNews)
    addLink(linksConfig.announcements, ltAnnouncements)
    for key, value in linksConfig.custom:
      links.add(newLink(Label(kind: lkTextComponent, textComponent: text(key)), value))
    self.writePacketFor(CConfigServerLinks(links: links))

  let resourceConfig = server.advancedConfig.resourcePack.java
  if resourceConfig.enabled:
    let uuid = newV3(NamespaceDns, resourceConfig.url)
    self.writePacketFor(CConfigAddResourcePack(uuid: uuid, url: resourceConfig.url,
      hash: resourceConfig.sha1, forced: resourceConfig.force,
      promptMessage: if resourceConfig.promptMessage.len == 0: none[TextComponent]()
                     else: some(text(resourceConfig.promptMessage))))
  else:
    # Upstream also answers itself for clients before 1.20.5, which handshake.aowl has already refused.
    self.sendKnownPacks()
