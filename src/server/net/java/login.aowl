## Port of pumpkin/src/net/java/login.rs
## PARTIAL: pumpkin/src/net/java/login.rs - online mode asks Mojang's session server (src/auth/asyncget.aowl on a worker thread, `progressLogin` polls it; ../authentication.aowl) so a slow answer holds up only that connection, as upstream. A client that hangs up mid-request leaves its worker to finish, then frees it. Upstream does not compare the verify token the client echoes, and neither does this. Unlike upstream, a failed session check ends the login there instead of carrying on after the kick.

import std/[options, syncio]
import ../../../protocol/java/client/config/[add_resource_pack, server_links, known_packs, plugin_message]
import ../../../protocol/java/client/login/[encryption_request, login_success, set_compression]
import ../../../protocol/java/server/login/[encryption_response, login_start, cookie_response, plugin_response]
import ../../../protocol/uuid
import ../../../generated/translation as tr
import ../../../util/text/text
import ../../../config/networking/compression
import ../../connection_cache
import ../../../auth/[winhttp, asyncget]
import ../../key_store
import ../authentication
import ../proxy
import ../../serverbase
import ../../servermod
import javamod

proc enableCompression(self: JavaClient; server: Server) =
  if self.version < jmvV1_8:
    return
  let compression = server.advancedConfig.networking.java.compression.info
  # We want to wait until we have sent the compression packet to the client
  self.writePacketFor(CSetCompression(threshold: newVarInt(int32(compression.threshold))))
  self.setCompression(compression)

proc finishLogin(self: JavaClient; profile: GameProfile) =
  var props: seq[Property] = @[]
  for p in profile.properties:
    props.add(Property(name: p.name, value: p.value,
      signature: if p.signature.len > 0: some(p.signature) else: none[string]()))
  let (_, sessionId) = newV4()
  self.writePacketFor(CLoginSuccess(uuid: profile.id, username: profile.name, properties: props,
    strictErrorHandling: false, sessionId: sessionId))
  if self.version < jmvV1_20_2:
    self.connectionState = csPlay

proc handleLoginStart*(self: JavaClient; server: Server; loginStart: SLoginStart) =
  # Don't allow new logons when the server is full.
  # If `max_players` is set to zero, then there is no max player count enforced.
  let maxPlayers = server.advancedConfig.networking.java.maxPlayers
  if maxPlayers > 0'u32 and server.getPlayerCount() >= int(maxPlayers):
    self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_SERVER_FULL, tr.JAVA_MULTIPLAYER_DISCONNECT_SERVER_FULL))
    return

  if not isValidPlayerName(loginStart.name):
    self.kick(text("Invalid characters in username"))
    return

  # Behind a proxy the player's identity is the proxy's to give: Velocity is asked over a login plugin message, which
  # `handleLoginPluginResponse` reads; BungeeCord's is already in the handshake's server address.
  let proxy = server.advancedConfig.networking.proxy
  if proxy.enabled:
    if proxy.velocity.enabled:
      let (_, messageId) = newV4()
      self.writePacketFor(velocityRequest(int32(messageId.lo and 0x7FFFFFFF'u64)))
    elif proxy.bungeecord.enabled:
      let forwarded = bungeecordLogin(self.peerIp, self.serverAddress, loginStart.name)
      if forwarded.ok:
        self.finishLogin(forwarded.profile)
        self.gameprofile = some(forwarded.profile)
      else:
        self.kick(text(forwarded.error.message))
    return

  let java = server.advancedConfig.networking.java
  let id = if java.onlineMode: loginStart.uuid else: offlineUuid(loginStart.name)
  let profile = GameProfile(id: id, name: loginStart.name, properties: @[], profileActions: @[])

  if java.compression.enabled:
    self.enableCompression(server)

  if java.encryption:
    let store = server.keyStore
    if store == nil:
      self.kick(text("The key store is not ready"))
      return
    let (_, randomId) = newV4()
    let verifyToken: array[4, byte] = [byte(randomId.lo and 0xFF'u64), byte((randomId.lo shr 8) and 0xFF'u64),
      byte((randomId.lo shr 16) and 0xFF'u64), byte((randomId.lo shr 24) and 0xFF'u64)]
    # Wait until we have sent the encryption packet to the client
    self.writePacketFor(store.encryptionRequest("", verifyToken, java.onlineMode))
    self.gameprofile = some(profile)
    return

  # Do not allow a duplicate UUID or username. Upstream only checks this in `handle_encryption_response`,
  # which an offline login never reaches; two clients with one name would share every player lookup here.
  if server.getPlayerByUuid(profile.id).isSome or server.getPlayerByName(profile.name).isSome:
    self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN, tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN))
    return

  self.finishLogin(profile)
  self.gameprofile = some(profile)

proc completeLogin(self: JavaClient; server: Server; profile: GameProfile) =
  ## The end of `handle_encryption_response`: no duplicate UUID or name, then the login succeeds.
  if server.getPlayerByUuid(profile.id).isSome or server.getPlayerByName(profile.name).isSome:
    self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN, tr.JAVA_MULTIPLAYER_DISCONNECT_DUPLICATE_LOGIN))
    return
  self.finishLogin(profile)

proc completeAuth(self: JavaClient; server: Server; found: AuthResult) =
  ## What follows the session server's answer: the profile's actions and textures, then `completeLogin`.
  let authConfig = server.advancedConfig.networking.java.authentication
  var checked = found
  if found.ok:
    checked = checkProfile(found.profile, authConfig)
  if not checked.ok:
    case checked.error.kind
    of aeFailedResponse:
      self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_AUTHSERVERS_DOWN, tr.JAVA_MULTIPLAYER_DISCONNECT_AUTHSERVERS_DOWN))
    of aeUnverifiedUsername:
      self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_UNVERIFIED_USERNAME, tr.JAVA_MULTIPLAYER_DISCONNECT_UNVERIFIED_USERNAME))
    else:
      self.kick(text(checked.error.message))
    return
  self.gameprofile = some(checked.profile)
  self.completeLogin(server, checked.profile)

proc handleEncryptionResponse*(self: JavaClient; server: Server; encryptionResponse: SEncryptionResponse) =
  ## `handle_encryption_response`
  let store = server.keyStore
  if store == nil:
    self.kick(text("Failed to decrypt shared secret"))
    return
  let sharedSecret = store.decrypt(encryptionResponse.sharedSecret)
  if sharedSecret.isNone:
    self.kick(text("Failed to decrypt shared secret"))
    return
  let secret = sharedSecret.unsafeGet

  if not self.setEncryption(secret):
    self.kick(text("Invalid encryption key"))
    return

  if self.gameprofile.isNone:
    self.kick(text("No `GameProfile`"))
    return
  let profile0 = self.gameprofile.unsafeGet

  if server.advancedConfig.networking.java.onlineMode:
    # `authenticate`: the session server's say-so, then the profile's actions and textures. Upstream carries on after a
    # failed check, having kicked; that is not done here.
    let authConfig = server.advancedConfig.networking.java.authentication
    let hash = store.getDigest(secret)
    let configured = server.authTransport
    if configured == nil or configured.real:
      # The answer is fetched on a worker thread, so a slow session server holds up this connection only, as in
      # upstream; `progressLogin` finishes the login when the thread is done.
      let job = startAsyncGet(authenticateUrl(profile0.name, hash, self.peerIp, authConfig),
        int(authConfig.connectTimeout), int(authConfig.readTimeout))
      if job == nil:
        self.kick(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_AUTHSERVERS_DOWN, tr.JAVA_MULTIPLAYER_DISCONNECT_AUTHSERVERS_DOWN))
        return
      self.pendingAuth = job
      return
    let found = authenticate(configured, profile0.name, hash, self.peerIp, authConfig)
    self.completeAuth(server, found)
    return

  self.completeLogin(server, profile0)

proc progressLogin*(self: JavaClient; server: Server) =
  ## Called every pass of the loop: takes the session server's answer once the worker thread has it.
  let job = self.pendingAuth
  if job == nil:
    return
  if self.isClosed:
    # Nobody will read the answer; wait for the thread to end, then free its memory.
    if job.pollAsyncGet():
      discard job.takeAsyncGet()
      self.pendingAuth = nil
    return
  if not job.pollAsyncGet():
    return
  self.pendingAuth = nil
  self.completeAuth(server, authenticateResponse(job.takeAsyncGet()))

proc handleLoginPluginResponse*(self: JavaClient; server: Server; response: SLoginPluginResponse) =
  ## `handle_plugin_response`: the proxy's answer to `velocityRequest`.
  let velocity = server.advancedConfig.networking.proxy.velocity
  if velocity.enabled:
    let forwarded = receiveVelocityPluginResponse(0'u16, velocity, response.hasData, response.data)
    if forwarded.ok:
      self.finishLogin(forwarded.profile)
      self.gameprofile = some(forwarded.profile)
      self.peerIp = forwarded.address
    else:
      self.kick(text(forwarded.error.message))

proc handleLoginCookieResponse*(self: JavaClient; packet: SLoginCookieResponse) =
  discard

proc sendKnownPacks*(self: JavaClient) =
  ## Send the known data packs to the client.
  let versionStr = $self.version
  self.writePacketFor(CKnownPacks(knownPacks: @[KnownPack(namespace: "minecraft", id: "core", version: versionStr)]))

proc handleLoginAcknowledged*(self: JavaClient; server: Server) =
  self.connectionState = csConfig
  self.writePacketFor(getBranding())

  let linksConfig = server.advancedConfig.serverLinks
  if linksConfig.enabled and self.version >= jmvV1_21:
    var links: seq[Link] = @[]
    template addLink(url: string; linkType: LinkType) =
      if url.len > 0:
        links.add(newLink(Label(kind: lkBuiltIn, builtIn: linkType), url))
    addLink(linksConfig.bugReport, ltBugReport)
    addLink(linksConfig.support, ltSupport)
    addLink(linksConfig.status, ltStatus)
    addLink(linksConfig.feedback, ltFeedback)
    addLink(linksConfig.community, ltCommunity)
    addLink(linksConfig.website, ltWebsite)
    addLink(linksConfig.forums, ltForums)
    addLink(linksConfig.news, ltNews)
    addLink(linksConfig.announcements, ltAnnouncements)
    for key, value in linksConfig.custom:
      links.add(newLink(Label(kind: lkTextComponent, textComponent: text(key)), value))
    self.writePacketFor(CConfigServerLinks(links: links))

  let resourceConfig = server.advancedConfig.resourcePack.java
  if resourceConfig.enabled:
    let uuid = newV3(NamespaceDns, resourceConfig.url)
    self.writePacketFor(CConfigAddResourcePack(uuid: uuid, url: resourceConfig.url,
      hash: resourceConfig.sha1, forced: resourceConfig.force,
      promptMessage: if resourceConfig.promptMessage.len == 0: none[TextComponent]()
                     else: some(text(resourceConfig.promptMessage))))
  else:
    # Upstream also answers itself for clients before 1.20.5, which handshake.aowl has already refused.
    self.sendKnownPacks()
