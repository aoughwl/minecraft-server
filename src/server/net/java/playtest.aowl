## The serverbound handlers with no socket: a client whose outgoing bytes are read back. tools/mcbot.py is the end-to-end check.
import std/[assertions, options, syncio, cmdline]
import "../../../data/item_stack/mod"
import ../../../generated/packet
import ../../../inventory/[inventory, player_inventory, player_screen_handler, screenhandler, slot, stackbridge]
import ../../../nbt/tag
import ../../../protocol/java/packet_decoder
import ../../../protocol/java/server/play/[chat_message, player_action, player_position, set_held_item, use_item_on,
  swing_arm, ping_request, player_rotation, player_input, keep_alive, player_abilities, confirm_teleport,
  click_container, set_creative_slot, player_session, place_recipe]
import ../authentication
import ../../data/banlist_serializer
import ../../../util/uuid
import ../../../protocol/itemstackserializer
import ../../../protocol/[proto, varint]

import ../../../util/math/position
import ../../../world/[chunkdata, playerdata, worldfs, worldinfo]
import ../../../world/blockstates as states
import ../../data/datamod
import ../../entity/player
import ../../recipe
import ../../scheduler
import ../../serverbase
import ../../tick_rate_manager
import ../../world/worldmod
import ../winsock
import ../../../generated/recipes as generatedrecipes
import javamod, play

proc scratch(): string =
  result = parentDirW(paramStr(0)) & "/play_scratch"
  discard createDirAllW(result)

proc newTestServer(): Server =
  let adv = defaultAdvancedConfiguration()
  let basic = defaultBasicConfiguration()
  result = Server(basicConfig: basic, advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD],
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
    playerDataStorage: newPlayerDataStorage(scratch() & "/playerdata", true), levelFolder: scratch(),
    playerIdleTimeout: 0'i32, mojangPublicKeys: @[], stopRequested: false, stopAtMs: 0'i64)
  let theLevel = fromRootFolder(adv.world, scratch(), 1'i64, OVERWORLD)
  result.worlds.add(loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, result))
  let c = newChunkData(0'i32, 0'i32, newChunkSections(24, -64'i32))
  c.lightEngine.skyLight = newSeq[LightContainer](26)
  c.lightEngine.blockLight = newSeq[LightContainer](26)
  for i in 0 ..< 26:
    c.lightEngine.skyLight[i] = newLightEmpty(15'u8)
    c.lightEngine.blockLight[i] = newLightEmpty(0'u8)
  addLoadedChunk(theLevel, c)

proc newTestPlayer(server: Server): Player =
  let client = newJavaClient(InvalidSocket, 1'u64)
  client.connectionState = csPlay
  client.version = jmvV1_21_11
  let profile = GameProfile(id: offlineUuid("Tester"), name: "Tester", properties: @[], profileActions: @[])
  result = newPlayer(client, profile, defaultPlayerConfig(), server.worlds[0], server, Survival, 1'i32)
  worldmod.addPlayer(server.worlds[0], result)
  result.setClientLoaded(true)

proc packetIds(client: JavaClient): seq[int32] =
  ## What has gone out since the last call.
  var decoder = newTCPNetworkDecoder()
  decoder.feed(client.networkWriter.flush())
  result = @[]
  while decoder.packetReady():
    let res = decoder.getRawPacket()
    assert res.isOk
    result.add(res.value.id)

let server = newTestServer()
let p = newTestPlayer(server)
let theWorld = server.worlds[0]
let client = p.client
let v = jmvV1_21_11
let (_, stone) = defaultStateByName("stone")
let target = newBlockPos(2'i32, 64'i32, 2'i32)
discard setBlockState(theWorld.level, target, stone)
p.setPos(Vector3[float64](x: 2.5, y: 65.0, z: 3.5))

block movement_kicks_on_nan:
  let nanClient = newTestPlayer(server)
  var nan = 0.0
  nan = nan / nan
  nanClient.client.handlePosition(nanClient, server, SPlayerPosition(position: Vector3[float64](x: nan, y: 0.0, z: 0.0), collision: 0'u8))
  assert nanClient.client.isClosed

block teleport_blocks_movement:
  p.requestTeleport(p.pos, 0.0'f32, 0.0'f32)
  discard packetIds(client)
  client.handlePosition(p, server, SPlayerPosition(position: Vector3[float64](x: 100.0, y: 65.0, z: 100.0), collision: 1'u8))
  assert p.pos.x == 2.5, "stale movement during a teleport is ignored"
  let (id, _) = p.awaitingTeleport.unsafeGet
  p.awaitingTeleport = none[(int32, Vector3[float64])]()
  discard id

block movement_moves_and_clamps:
  client.handlePosition(p, server, SPlayerPosition(position: Vector3[float64](x: 2.6, y: 65.0, z: 3.5), collision: 1'u8))
  assert p.pos.x == 2.6 and p.onGround
  discard packetIds(client)
  p.setPos(Vector3[float64](x: 2.5, y: 65.0, z: 3.5))

block out_of_reach_digging_does_nothing:
  let far = newBlockPos(2'i32, 64'i32, 15'i32)
  discard setBlockState(theWorld.level, far, stone)
  client.handlePlayerAction(p, SPlayerAction(status: newVarInt(int32(ord(stStartedDigging))), position: far, face: 1'u8,
    sequence: newVarInt(3'i32)), server)
  assert getBlockState(theWorld.level, far) == stone
  assert client.packetSequence == 3'i32, "still acknowledged"

block survival_digging_takes_time_then_finishes:
  client.handlePlayerAction(p, SPlayerAction(status: newVarInt(int32(ord(stStartedDigging))), position: target, face: 1'u8,
    sequence: newVarInt(4'i32)), server)
  assert getBlockState(theWorld.level, target) == stone, "bare hands do not break stone at once"
  assert p.mining
  client.handlePlayerAction(p, SPlayerAction(status: newVarInt(int32(ord(stFinishedDigging))), position: target, face: 1'u8,
    sequence: newVarInt(5'i32)), server)
  assert isAir(getBlockState(theWorld.level, target))
  assert not p.mining
  let ids = packetIds(client)
  assert CB_PLAY_BLOCK_UPDATE.toId(v) in ids, "the digger hears the result"
  p.tick()
  let ack = packetIds(client)
  assert CB_PLAY_BLOCK_CHANGED_ACK.toId(v) in ack, "acknowledged within the tick"

block placing_uses_the_stack:
  let stoneItem = Item.fromRegistryKey("stone")
  assert stoneItem != nil
  p.inventory.setHeldItem(newItemStack(2'u8, stoneItem))
  client.packetSequence = -1'i32
  let (ok, _) = client.handleUseItemOn(p, SUseItemOn(hand: newVarInt(0'i32), position: newBlockPos(2'i32, 64'i32, 3'i32),
    face: newVarInt(2'i32), cursorPos: Vector3[float32](x: 0.5'f32, y: 0.5'f32, z: 0.0'f32), insideBlock: false,
    isAgainstWorldBorder: false, sequence: newVarInt(6'i32)), server)
  assert ok
  # Clicking air at the column in front replaces it: the clicked block is air, which is replaceable.
  assert getBlockState(theWorld.level, newBlockPos(2'i32, 64'i32, 3'i32)) == stone
  assert p.inventory.heldItem().itemCount == 1'u8, "survival spends one"
  let ids = packetIds(client)
  assert CB_PLAY_SET_PLAYER_INVENTORY.toId(v) in ids
  assert CB_PLAY_BLOCK_UPDATE.toId(v) in ids

block placing_inside_the_player_is_refused:
  let (ok, _) = client.handleUseItemOn(p, SUseItemOn(hand: newVarInt(0'i32), position: newBlockPos(2'i32, 65'i32, 3'i32),
    face: newVarInt(1'i32), cursorPos: Vector3[float32](x: 0.5'f32, y: 1.0'f32, z: 0.5'f32), insideBlock: false,
    isAgainstWorldBorder: false, sequence: newVarInt(7'i32)), server)
  assert ok
  assert p.inventory.heldItem().itemCount == 1'u8, "the player stands there"

block held_slot:
  client.handleSetHeldItem(p, SSetHeldItem(slot: 3'i16))
  assert p.inventory.getSelectedSlot() == 3'u8
  let bad = newTestPlayer(server)
  bad.client.handleSetHeldItem(bad, SSetHeldItem(slot: 9'i16))
  assert bad.client.isClosed

block chat_checks:
  let bad = newTestPlayer(server)
  bad.client.handleChatMessage(server, bad, SChatMessage(message: "a\x07b", timestamp: 0'i64, salt: 0'i64,
    signature: none[seq[byte]](), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert bad.client.isClosed, "a control character is a kick"
  var long = ""
  for i in 0 ..< 257:
    long.add('a')
  let bad2 = newTestPlayer(server)
  bad2.client.handleChatMessage(server, bad2, SChatMessage(message: long, timestamp: 0'i64, salt: 0'i64,
    signature: none[seq[byte]](), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert bad2.client.isClosed, "too long is a kick"
  discard packetIds(client)
  client.handleChatMessage(server, p, SChatMessage(message: "hello", timestamp: 0'i64, salt: 0'i64,
    signature: none[seq[byte]](), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert not client.isClosed
  assert CB_PLAY_SYSTEM_CHAT.toId(v) in packetIds(client)

block ping:
  client.handlePlayPingRequest(SPlayPingRequest(payload: 7'i64))
  assert CB_PLAY_PONG_RESPONSE.toId(v) in packetIds(client)

block nbt_round_trip:
  p.experienceLevel = 3'i32
  var nbt = newCompound()
  p.setRotation(10.0'f32, 20.0'f32)
  p.writeNbt(nbt)
  let other = newTestPlayer(server)
  other.readNbt(nbt)
  assert other.pos.x == p.pos.x and other.pos.y == p.pos.y and other.pos.z == p.pos.z
  assert other.yaw == 10.0'f32 and other.pitch == 20.0'f32
  assert other.hasPlayedBefore == p.hasPlayedBefore
  assert other.experienceLevel == 3'i32
  assert other.inventory.getSelectedSlot() == 3'u8
  assert Inventory(other.inventory).getStack(0).itemCount == 1'u8, "the stack came back"

proc nowUnixMsTest(): int64 =
  (nowUtcSeconds() + 1'i64) * 1000'i64

proc packetList(client: JavaClient): seq[RawPacket] =
  var decoder = newTCPNetworkDecoder()
  decoder.feed(client.networkWriter.flush())
  result = @[]
  while decoder.packetReady():
    let res = decoder.getRawPacket()
    assert res.isOk
    result.add(res.value)

block keep_alive_handling:
  let ka = newTestPlayer(server)
  ka.client.waitForKeepAlive = true
  ka.client.keepAliveId = 77'i64
  ka.client.handleKeepAlive(ka, SKeepAlive(keepAliveId: 77'i64))
  assert not ka.client.waitForKeepAlive and not ka.client.isClosed, "the right id clears the wait"
  ka.client.waitForKeepAlive = true
  ka.client.handleKeepAlive(ka, SKeepAlive(keepAliveId: 78'i64))
  assert ka.client.isClosed, "the wrong id is a timeout kick"
  let ka2 = newTestPlayer(server)
  ka2.client.handleKeepAlive(ka2, SKeepAlive(keepAliveId: 0'i64))
  assert ka2.client.isClosed, "an answer to nothing is a kick"

block abilities_handling:
  let ab = newTestPlayer(server)
  ab.client.handlePlayerAbilities(ab, SPlayerAbilities(flags: 2'i8))
  assert not ab.abilities.flying, "no flying without allow_flying"
  ab.abilities.allowFlying = true
  ab.fallDistance = 5.0'f32
  ab.client.handlePlayerAbilities(ab, SPlayerAbilities(flags: 2'i8))
  assert ab.abilities.flying and ab.fallDistance == 0.0'f32
  ab.client.handlePlayerAbilities(ab, SPlayerAbilities(flags: 0'i8))
  assert not ab.abilities.flying

block confirm_teleport_handling:
  let ct = newTestPlayer(server)
  ct.client.handleConfirmTeleport(ct, SConfirmTeleport(teleportId: newVarInt(1'i32)))
  assert ct.client.isClosed, "a confirmation of nothing is a kick"
  let ct2 = newTestPlayer(server)
  ct2.awaitingTeleport = some((5'i32, Vector3[float64](x: 9.0, y: 70.0, z: 9.0)))
  ct2.client.handleConfirmTeleport(ct2, SConfirmTeleport(teleportId: newVarInt(4'i32)))
  assert ct2.client.isClosed, "the wrong id is a kick"
  let ct3 = newTestPlayer(server)
  ct3.awaitingTeleport = some((5'i32, Vector3[float64](x: 9.0, y: 70.0, z: 9.0)))
  ct3.client.handleConfirmTeleport(ct3, SConfirmTeleport(teleportId: newVarInt(5'i32)))
  assert not ct3.client.isClosed and ct3.awaitingTeleport.isNone and ct3.pos.x == 9.0

proc noHash(): OptionalItemStackHash =
  OptionalItemStackHash(value: none[ItemStackHash]())

proc clickPacket(h: ScreenHandler; slot: int16; button: int8; mode: SlotActionType): SClickSlot =
  SClickSlot(syncId: newVarInt(int32(h.syncId())), revision: newVarInt(int32(h.getBehaviour().revision)), slot: slot,
    button: button, mode: mode, lengthOfArray: newVarInt(0'i32), arrayOfChangedSlots: @[], carriedItem: noHash())

block click_shift_and_drag:
  let cp = newTestPlayer(server)
  let stoneItem = Item.fromRegistryKey("stone")
  assert stoneItem != nil
  let h = cp.currentScreenHandler
  # Shift-click on the hotbar (window slot 36) moves the stack into the main inventory, starting at 9.
  Inventory(cp.inventory).setStack(0, newItemStack(64'u8, stoneItem))
  cp.onSlotClick(clickPacket(h, 36'i16, 0'i8, satQuickMove))
  assert Inventory(cp.inventory).getStack(0).isEmpty(), "the hotbar slot emptied"
  assert Inventory(cp.inventory).getStack(9).itemCount == 64'u8, "and the stack arrived in slot 9"
  # Pick up, then a left drag over two slots splits the cursor stack evenly.
  Inventory(cp.inventory).setStack(9, newItemStack(0'u8, stoneItem))
  h.getBehaviour().cursorStack = newItemStack(10'u8, stoneItem)
  cp.onSlotClick(clickPacket(h, -999'i16, 0'i8, satQuickCraft))
  cp.onSlotClick(clickPacket(h, 10'i16, 1'i8, satQuickCraft))
  cp.onSlotClick(clickPacket(h, 11'i16, 1'i8, satQuickCraft))
  cp.onSlotClick(clickPacket(h, -999'i16, 2'i8, satQuickCraft))
  assert Inventory(cp.inventory).getStack(10).itemCount == 5'u8 and Inventory(cp.inventory).getStack(11).itemCount == 5'u8,
    "a left drag splits 10 into 5 and 5"
  assert h.getBehaviour().cursorStack.isEmpty()
  # A wrong sync id is ignored.
  var wrong = clickPacket(h, 10'i16, 0'i8, satPickup)
  wrong.syncId = newVarInt(9'i32)
  cp.onSlotClick(wrong)
  assert h.getBehaviour().cursorStack.isEmpty()
  # A left click picks the stack up.
  cp.onSlotClick(clickPacket(h, 10'i16, 0'i8, satPickup))
  assert h.getBehaviour().cursorStack.itemCount == 5'u8 and Inventory(cp.inventory).getStack(10).isEmpty()

block creative_slot:
  let cr = newTestPlayer(server)
  let stoneItem = Item.fromRegistryKey("stone")
  assert stoneItem != nil
  assert not cr.client.handleSetCreativeSlot(cr, SSetCreativeSlot(slot: 36'i16, clickedItem: toSerializer(newItemStack(5'u8, stoneItem))))
  assert Inventory(cr.inventory).getStack(0).isEmpty(), "survival may not"
  discard cr.setGamemode(Creative)
  assert cr.client.handleSetCreativeSlot(cr, SSetCreativeSlot(slot: 36'i16, clickedItem: toSerializer(newItemStack(5'u8, stoneItem))))
  assert Inventory(cr.inventory).getStack(0).itemCount == 5'u8
  discard cr.client.handleSetCreativeSlot(cr, SSetCreativeSlot(slot: 37'i16, clickedItem: toSerializer(newItemStack(200'u8, stoneItem))))
  assert Inventory(cr.inventory).getStack(1).isEmpty(), "an illegal count is refused"

const
  MojangKeyB64 = "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDGIJT2HLuJ5v7qqVswOgNwpBaFWO829BGWF7G+7t2UA47OhJBH6DkIjRehtwpX/MbxF2wJc5Ny+WrdFzWnjx1tcgK0O6hHTKk3Enm/eVh03rDk+bTCxAFm9cW3kUKzJRhz8A6OzKbttTPJv3jRPqoXz91wiZgRMGl7wGpRxnN7JQIDAQAB"
  SessionSigB64 = "ZV0fJZkz2KMUE02wbH7MCIEjPHi1/pzKbN3tUJp2tMKVWADXN6MMXfigS2gcMRthruZfSGQ70YA55XQNCXU8ePTbyiLj1ghi8ZQBPTAU8YTs6aQZnrnUNNNJITsDE6oeAkwkw3Lg2xVDBM+s2fokZcrdmO4C6hPx8cSQzGOtm1M="
  SessionExpiry = 4102444800000'i64

block chat_session_signature:
  # A key pair and a signature made with OpenSSL over uuid(16) + expiry(i64 BE) + public key (1..39), for the uuid of "Tester".
  let (keyOk, mojangKey) = base64Decode(MojangKeyB64)
  let (sigOk, sig) = base64Decode(SessionSigB64)
  assert keyOk and sigOk
  var pub: seq[byte] = @[]
  for i in 1 .. 39:
    pub.add(byte(i))
  let cs = newTestPlayer(server)
  server.mojangPublicKeys = @[mojangKey]
  let session = SPlayerSession(sessionId: offlineUuid("Other"), expiresAt: SessionExpiry, publicKey: pub, keySignature: sig)
  assert cs.client.validateChatSession(cs, server, session)[0], "a signature made over the player's uuid, expiry and key"
  var tampered = session
  tampered.expiresAt = SessionExpiry + 1'i64
  assert not cs.client.validateChatSession(cs, server, tampered)[0], "another expiry"
  var expired = session
  expired.expiresAt = 1000'i64
  assert not cs.client.validateChatSession(cs, server, expired)[0], "an expired key"
  server.mojangPublicKeys = @[]
  assert not cs.client.validateChatSession(cs, server, session)[0], "no Mojang key to check against"
  # With reports on, the update installs the session and a bad one is a kick.
  server.basicConfig.allowChatReports = true
  server.mojangPublicKeys = @[mojangKey]
  cs.client.handleChatSessionUpdate(cs, server, session)
  assert not cs.client.isClosed and cs.chatSession.expiresAt == SessionExpiry
  let cs2 = newTestPlayer(server)
  cs2.client.handleChatSessionUpdate(cs2, server, tampered)
  assert cs2.client.isClosed
  # Secure chat: unsigned is a kick, a 256 byte signature with a current timestamp goes out.
  let unsigned = newTestPlayer(server)
  unsigned.client.handleChatMessage(server, unsigned, SChatMessage(message: "hi", timestamp: 0'i64, salt: 1'i64,
    signature: none[seq[byte]](), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert unsigned.client.isClosed
  discard packetIds(cs.client)
  var fake: seq[byte] = @[]
  for i in 0 ..< 256:
    fake.add(byte(i))
  cs.client.handleChatMessage(server, cs, SChatMessage(message: "signed hi", timestamp: nowUnixMsTest(), salt: 1'i64,
    signature: some(fake), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert not cs.client.isClosed
  assert CB_PLAY_PLAYER_CHAT.toId(v) in packetIds(cs.client), "the signed message is broadcast as player chat"
  var stale = SChatMessage(message: "old", timestamp: nowUnixMsTest() - 1000000'i64, salt: 1'i64,
    signature: some(fake), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8)
  cs.client.handleChatMessage(server, cs, stale)
  assert cs.client.isClosed, "a message older than two minutes is out of order"
  server.basicConfig.allowChatReports = false
  server.mojangPublicKeys = @[]

block place_recipe:
  # The recipe book click: acacia_pressure_plate is "##" of acacia planks, so slots 0 and 1 of the 2x2 grid fill.
  let pr = newTestPlayer(server)
  let planks = Item.fromRegistryKey("acacia_planks")
  assert planks != nil
  Inventory(pr.inventory).setStack(9, newItemStack(5'u8, planks))
  var displayId = -1
  var counter = 0
  for r in generatedrecipes.RECIPES_CRAFTING:
    if r.kind == generatedrecipes.crkCraftingDecoratedPot:
      continue
    if r.kind == generatedrecipes.crkCraftingShaped and r.shaped.id == "minecraft:acacia_pressure_plate":
      displayId = counter
      break
    inc counter
  assert displayId >= 0
  let grid = pr.currentScreenHandler.getBehaviour().slots[1].getInventory()
  pr.client.handlePlaceRecipe(pr, SPlaceRecipe(containerId: 0'i8, recipeDisplayId: newVarInt(int32(displayId)), useMaxItems: false))
  assert grid.getStack(0).itemCount == 1'u8 and grid.getStack(1).itemCount == 1'u8 and grid.getStack(2).isEmpty()
  assert Inventory(pr.inventory).getStack(9).itemCount == 3'u8, "two planks left the inventory"
  # Again: the same recipe stacks one more of each.
  pr.client.handlePlaceRecipe(pr, SPlaceRecipe(containerId: 0'i8, recipeDisplayId: newVarInt(int32(displayId)), useMaxItems: false))
  assert grid.getStack(0).itemCount == 2'u8 and grid.getStack(1).itemCount == 2'u8
  # Shift (use max): as many as the inventory allows, 5 of each is 10 planks and there are 5 in all.
  pr.client.handlePlaceRecipe(pr, SPlaceRecipe(containerId: 0'i8, recipeDisplayId: newVarInt(int32(displayId)), useMaxItems: true))
  assert grid.getStack(0).itemCount == 2'u8 and grid.getStack(1).itemCount == 2'u8, "5 planks make 2 of each"

block chat_reaches_other_players:
  let a = newTestPlayer(server)
  let b = newTestPlayer(server)
  discard packetIds(a.client)
  discard packetIds(b.client)
  a.client.handleChatMessage(server, a, SChatMessage(message: "to everyone", timestamp: 0'i64, salt: 0'i64,
    signature: none[seq[byte]](), messageCount: newVarInt(0'i32), acknowledged: @[], checksum: 0'u8))
  assert CB_PLAY_SYSTEM_CHAT.toId(v) in packetIds(a.client), "the sender hears it"
  assert CB_PLAY_SYSTEM_CHAT.toId(v) in packetIds(b.client), "another player in the world hears it"

echo "play handlers ok"
