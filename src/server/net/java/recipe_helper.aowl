## Port of pumpkin/src/net/java/recipe_helper.rs
##
## `Arc<Mutex<ItemStack>>` slots are the plain stacks of `PlayerInventory.mainInventory`. `GenericIngredient` is a case
## object over the generated recipes' ingredient and the protocol's `OwnedRecipeIngredient`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import "../../../data/item_stack/mod"
import ../../../generated/recipes as generated
import ../../../inventory/player_inventory
import ../../../inventory/recipe_provider
import ../../../protocol/recipe

type
  GenericIngredientKind* = enum
    giVanilla
    giDynamic

  GenericIngredient* = object
    case kind*: GenericIngredientKind
    of giVanilla:
      vanilla*: generated.RecipeIngredient
    of giDynamic:
      dynamic*: OwnedRecipeIngredient

proc vanillaIngredient*(v: generated.RecipeIngredient): GenericIngredient =
  GenericIngredient(kind: giVanilla, vanilla: v)

proc dynamicIngredient*(d: OwnedRecipeIngredient): GenericIngredient =
  GenericIngredient(kind: giDynamic, dynamic: d)

proc matchItem*(self: GenericIngredient; item: Item): bool =
  case self.kind
  of giVanilla: self.vanilla.matchItem(item)
  of giDynamic: self.dynamic.matchItem(item)

proc takeNIngredient*(inventory: PlayerInventory; ingredient: GenericIngredient; count: uint8): ItemStack =
  var taken = 0'u8
  var found = false
  var res = emptyItemStack()
  for i in 0 ..< inventory.mainInventory.len:
    if not inventory.mainInventory[i].isEmpty() and ingredient.matchItem(inventory.mainInventory[i].item):
      let toTake = min(count - taken, inventory.mainInventory[i].itemCount)
      let subStack = inventory.mainInventory[i].split(toTake)
      taken += subStack.itemCount
      if not found:
        res = subStack
        found = true
      else:
        res.itemCount += subStack.itemCount
      if taken >= count:
        break
  res

type AvailableItem = object
  item: Item
  count: uint32

proc computeBiggestCraftable*(ingredients: seq[GenericIngredient]; inventory: PlayerInventory): uint8 =
  var available: seq[AvailableItem] = @[]
  for i in 0 ..< inventory.mainInventory.len:
    if not inventory.mainInventory[i].isEmpty():
      var merged = false
      for j in 0 ..< available.len:
        if available[j].item.id == inventory.mainInventory[i].item.id:
          available[j].count += uint32(inventory.mainInventory[i].itemCount)
          merged = true
          break
      if not merged:
        available.add(AvailableItem(item: inventory.mainInventory[i].item, count: uint32(inventory.mainInventory[i].itemCount)))
  var amount = 64'u32
  while amount >= 1'u32:
    var budget = available
    var ok = true
    for ing in ingredients:
      var idx = -1
      for k in 0 ..< budget.len:
        if budget[k].count >= amount and ing.matchItem(budget[k].item):
          idx = k
          break
      if idx < 0:
        ok = false
        break
      budget[idx].count -= amount
    if ok:
      return uint8(amount)
    amount -= 1'u32
  0'u8
