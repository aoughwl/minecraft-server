## Known answers for recipe_helper.rs: what a recipe takes from the main inventory and how many times it can be made.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import "../../../data/item_stack/mod"
import ../../../generated/recipes as generated
import ../../../inventory/player_inventory
import ../../../protocol/recipe
import recipe_helper

proc simple(key: string): GenericIngredient =
  dynamicIngredient(OwnedRecipeIngredient(kind: oriSimple, id: key))

proc inv(stacks: seq[ItemStack]): PlayerInventory =
  let p = PlayerInventory(mainInventory: newSeq[ItemStack](36))
  for i in 0 ..< 36:
    p.mainInventory[i] = emptyItemStack()
  for i in 0 ..< stacks.len:
    p.mainInventory[i] = stacks[i]
  p

proc run() =
  # Stacks of 30 and 20 oak planks and 7 sticks. The stacks of one item are merged (50 planks) and the amount is searched
  # from 64 down, each ingredient taking `amount` from the budget of its item.
  let planks = ITEM_OAK_PLANKS
  let stick = ITEM_STICK
  let p = inv(@[newItemStack(30'u8, planks), newItemStack(20'u8, planks), newItemStack(7'u8, stick)])
  assert computeBiggestCraftable(@[simple("minecraft:oak_planks")], p) == 50'u8
  # A stick and a plank: the sticks cap it at 7.
  assert computeBiggestCraftable(@[simple("minecraft:oak_planks"), simple("minecraft:stick")], p) == 7'u8
  # Two plank ingredients are two slots of the budget: 30 from one stack and 20 from the merged entry: merged is 50,
  # the first takes `amount` out of the 50, the second needs another `amount`: 25 is the most.
  assert computeBiggestCraftable(@[simple("minecraft:oak_planks"), simple("minecraft:oak_planks")], p) == 25'u8
  assert computeBiggestCraftable(@[simple("minecraft:diamond")], p) == 0'u8
  # take_n takes from the first matching stacks, in order.
  let got = takeNIngredient(p, simple("minecraft:oak_planks"), 40'u8)
  assert got.itemCount == 40'u8 and got.item.registryKey == "oak_planks"
  assert p.mainInventory[0].itemCount == 0'u8
  assert p.mainInventory[1].itemCount == 10'u8
  assert takeNIngredient(p, simple("minecraft:diamond"), 3'u8).isEmpty()
  echo "recipe_helper test: ok"

run()
