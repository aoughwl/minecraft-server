## Port of pumpkin/src/net/java/status.rs

import ../../../protocol/java/client/status/[ping_response, status_response]
import ../../../protocol/java/server/status/ping_request
import ../../connection_cache
import ../../serverbase
import ../../servermod
import javamod
import ../../../plugin/pluginhooksevents
import std/options

proc handleStatusRequest*(self: JavaClient; server: Server) =
  var status = getStatus(server)
  # ServerListPingEvent: the plugins may change the MOTD and the maximum player count that this one asker sees
  var online = 0
  var maximum = 0
  if status.players.isSome:
    online = int(status.players.unsafeGet.online)
    maximum = int(status.players.unsafeGet.max)
  let pinged = callPluginServerListPingHook(self.peerIp, status.description, online, maximum)
  status.description = pinged[0]
  if status.players.isSome and pinged[1] >= 0:
    var shown = status.players.unsafeGet
    shown.max = uint32(pinged[1])
    status.players = some(shown)
  self.writePacketFor(getStatusPacket(status, self.version.protocolVersion()))

proc handlePingRequest*(self: JavaClient; pingRequest: SStatusPingRequest) =
  self.writePacketFor(CPingResponse(payload: pingRequest.payload))
  self.close()
