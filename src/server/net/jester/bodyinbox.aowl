## Serverbound `jester:bodies` messages (RESYNC_REQ, ACK) as they arrive from the connection, waiting for the next body sync tick.
## No imports, so the network layer (net/java/play.aowl) can push into it without depending on the body code.

const MaxInbox = 512

var gBodiesInbox: seq[(string, seq[byte])] = @[]

proc bodiesInboxPush*(player: string; data: seq[byte]) =
  if data.len > 0 and gBodiesInbox.len < MaxInbox:
    gBodiesInbox.add (player, data)

proc bodiesInboxDrain*(): seq[(string, seq[byte])] =
  result = gBodiesInbox
  gBodiesInbox = @[]
