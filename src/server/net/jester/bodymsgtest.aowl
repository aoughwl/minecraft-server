## Tests for bodymsg.aowl and fxmsg.aowl against the examples in overnight/PROTOCOL.md (sections 3, 5).

import std/[assertions, syncio, math]
import bodymsg
import fxmsg
import ../../../plugin/payloads

proc hexOf(b: seq[byte]): string = payloadToHex(b)

# 3.8: identity is E0 08 02 00
assert packQuat(0.0, 0.0, 0.0, 1.0) == 0xE0080200'u32
# a rotation survives within 0.1 degrees (a 90 degree turn about y: y = sin 45, w = cos 45)
let qy = packQuat(0.0, 0.70710678, 0.0, 0.70710678)
let (ux, uy, uz, uw) = unpackQuat(qy)
assert abs(ux) < 0.002 and abs(uz) < 0.002 and abs(uy - 0.70710678) < 0.002 and abs(uw - 0.70710678) < 0.002
# the sign is normalised so the dropped component is positive: -q packs the same as q
assert packQuat(0.0, 0.0, 0.0, -1.0) == 0xE0080200'u32

# 3.9: the worked STATE frame, 26 bytes
var st = StateMsg(seqNo: 42, base: 41, tick: 1001'i64)
st.entries.add StateEntry(bodyId: 1, flags: StatePos or StateRot or StateVel, pos: (10, -40, 0), rot: 0xE0080200'u32, vel: (0, -512, 0))
st.entries.add StateEntry(bodyId: 3, flags: StateAsleep)
let stateBytes = encodeBodyState(st)
assert hexOf(stateBytes) == "032a29e907" & "02" & "0107000affd80000e0080200" & "0000fe0000" & "00" & "0220"
var ok = false
let back = decodeBodyState(stateBytes, ok)
assert ok and back.seqNo == 42 and back.base == 41 and back.tick == 1001'i64 and back.entries.len == 2
assert back.entries[0].bodyId == 1 and back.entries[0].pos == (10, -40, 0) and back.entries[0].vel == (0, -512, 0)
assert back.entries[1].bodyId == 3 and back.entries[1].flags == StateAsleep

# STATE: absolute position (f64), wide delta (i32), angular velocity
var st2 = StateMsg(seqNo: 1, base: 0, tick: 5'i64)
st2.entries.add StateEntry(bodyId: 2, flags: StatePos or StateAbsolute, absPos: (1.5, 64.0, -3.25))
st2.entries.add StateEntry(bodyId: 9, flags: StatePos or StateWide or StateAngVel, pos: (70000, -70000, 1), angVel: (1, -1, 4096))
let b2 = encodeBodyState(st2)
let d2 = decodeBodyState(b2, ok)
assert ok and d2.entries[0].absPos == (1.5, 64.0, -3.25) and d2.entries[1].bodyId == 9
assert d2.entries[1].pos == (70000, -70000, 1) and d2.entries[1].angVel == (1, -1, 4096)
# bit4 and bit6 together: absolute wins
var st3 = StateMsg(seqNo: 1, base: 0, tick: 5'i64)
st3.entries.add StateEntry(bodyId: 1, flags: StatePos or StateAbsolute or StateWide, absPos: (0.0, 0.0, 0.0))
assert encodeBodyState(st3).len == 7 + 24

# RESET, RESYNC_REQ, ACK, DESTROY
let rs = decodeBodyReset(encodeBodyReset(ResetMsg(seqNo: 7, tick: 99'i64, reason: 1)), ok)
assert ok and rs.seqNo == 7 and rs.tick == 99'i64 and rs.reason == 1
var lastSeq = 0
var reason = 0
assert decodeBodyResyncReq(encodeBodyResyncReq(300, 2), lastSeq, reason) and lastSeq == 300 and reason == 2
var ackSeq = 0
assert decodeBodyAck(encodeBodyAck(40), ackSeq) and ackSeq == 40
assert hexOf(encodeBodyAck(40)) == "0628"
var ids: seq[int] = @[]
assert hexOf(encodeBodyDestroy(1, @[3, 300])) == "020102" & "03" & "ac02"
assert decodeBodyDestroy(encodeBodyDestroy(1, @[3, 300]), reason, ids) and reason == 1 and ids == @[3, 300]

# CREATE: the spec counts 59 fixed bytes; one air-only palette entry (1 byte) and one cell byte make 61
var one = BodyCreateMsg(bodyId: 1, seqAtCreate: 1, size: (1, 1, 1), com: (0.5'f32, 0.5'f32, 0.5'f32), mass: 10.0'f32,
                        pos: (1.0, 2.0, 3.0), quat: 0xE0080200'u32, vel: (0, 0, 0), palette: @[0], cells: @[0])
let parts1 = encodeBodyCreate(one, 16000)
assert parts1.len == 1 and parts1[0].len == 61
var asm1 = CreateAssembler()
assert feedBodyCreate(asm1, parts1[0]) and asm1.done and asm1.head.bodyId == 1 and asm1.head.size == (1, 1, 1)
assert asm1.head.pos == (1.0, 2.0, 3.0) and asm1.head.quat == 0xE0080200'u32 and asm1.head.cells == @[0]

# CREATE with a 16-entry palette in a 10x10x10 volume (4 bits per cell = 500 bytes), split into frames of 200 bytes
var big = BodyCreateMsg(bodyId: 300, seqAtCreate: 9, size: (10, 10, 10), com: (5.0'f32, 5.0'f32, 5.0'f32), mass: 1000.0'f32,
                        pos: (100.0, 70.0, -20.0), quat: 0xE0080200'u32, vel: (1, -2, 3))
for i in 0 ..< 16: big.palette.add i * 7
for i in 0 ..< 1000: big.cells.add (i * 5 + i div 3) mod 16
assert bitsForPalette(16) == 4 and bitsForPalette(17) == 5 and bitsForPalette(1) == 1 and bitsForPalette(2) == 1
let parts = encodeBodyCreate(big, 200)
assert parts.len >= 3
for p in parts: assert p.len <= 200
var asm2 = CreateAssembler()
for p in parts: assert feedBodyCreate(asm2, p)
assert asm2.done and asm2.head.bodyId == 300 and asm2.head.palette.len == 16 and asm2.head.cells == big.cells
assert asm2.head.vel == (1, -2, 3)
# an unsplit CREATE of the same body is one message with the same content
let whole = encodeBodyCreate(big, 16000)
assert whole.len == 1
var asm3 = CreateAssembler()
assert feedBodyCreate(asm3, whole[0]) and asm3.head.cells == big.cells
# continuation without a first part is refused
var asm4 = CreateAssembler()
assert not feedBodyCreate(asm4, parts[1])

# packed cells: LSB first
assert hexOf(packCells(@[1, 0, 1, 1, 0, 0, 0, 1, 1], 1)) == "8d01"

# FX: the block position packs like vanilla (x 26 bits, z 26 bits, y 12 bits)
assert packBlockPos(1, 2, 3) == ((1'u64 shl 38'u64) or (3'u64 shl 12'u64) or 2'u64)
assert unpackBlockPos(packBlockPos(-5, -64, 100)) == (-5, -64, 100)
var fx = FxEvent(kind: FxBreak, pos: (10, 64, -10), state: 1, material: 3, impulse: 1500.0'f32, seed: 777)
let fb = encodeFx(fx)
assert fb.len == 19 and fb[0] == 1 and fb[1] == 0 and fb[2] == 0
var fok = false
let fd = decodeFx(fb, fok)
assert fok and fd.pos == (10, 64, -10) and fd.state == 1 and fd.impulse == 1500.0'f32 and fd.seed == 777 and not fd.hasBody
fx.hasBody = true
fx.bodyId = 300
fx.hasNormal = true
fx.normal = (0, 127, -127)
let fb2 = encodeFx(fx)
let fd2 = decodeFx(fb2, fok)
assert fok and fd2.hasBody and fd2.bodyId == 300 and fd2.hasNormal and fd2.normal == (0, 127, -127)
assert fb2.len == 19 + 2 + 3
var junkOk = true
discard decodeFx(@[9'u8, 0'u8], junkOk)
assert not junkOk
echo "bodymsgtest: ok"
