## Byte helpers the Jester message encoders and decoders share (big-endian, varints). No imports.

type
  Cursor* = object
    data*: seq[byte]
    at*: int
    bad*: bool

proc newCursor*(data: seq[byte]): Cursor = Cursor(data: data, at: 0, bad: false)
proc left*(c: Cursor): int = c.data.len - c.at

proc takeU8*(c: var Cursor): int =
  if c.at >= c.data.len:
    c.bad = true
    return 0
  result = int(c.data[c.at])
  inc c.at

proc takeBig*(c: var Cursor; bytes: int): uint64 =
  result = 0'u64
  for i in 0 ..< bytes:
    result = (result shl 8'u64) or uint64(takeU8(c))

proc takeI16*(c: var Cursor): int =
  let v = int(takeBig(c, 2))
  if v >= 32768: v - 65536 else: v

proc takeI32*(c: var Cursor): int =
  let v = int64(takeBig(c, 4))
  if v >= 2147483648'i64: int(v - 4294967296'i64) else: int(v)

proc takeVarint*(c: var Cursor): int64 =
  var shift = 0'u64
  var acc = 0'u64
  while true:
    let b = takeU8(c)
    if c.bad: return 0'i64
    acc = acc or (uint64(b and 127) shl shift)
    if (b and 128) == 0: break
    shift += 7'u64
    if shift > 63'u64:
      c.bad = true
      return 0'i64
  int64(acc)

proc takeF32*(c: var Cursor): float32 = cast[float32](uint32(takeBig(c, 4)))
proc takeF64*(c: var Cursor): float64 = cast[float64](takeBig(c, 8))

proc takeBytes*(c: var Cursor; n: int): seq[byte] =
  result = @[]
  if n < 0 or c.at + n > c.data.len:
    c.bad = true
    return
  for i in 0 ..< n: result.add c.data[c.at + i]
  c.at += n

proc putU8*(w: var seq[byte]; v: int) = w.add byte(v and 255)

proc putBig*(w: var seq[byte]; v: uint64; bytes: int) =
  var i = bytes - 1
  while i >= 0:
    w.add byte((v shr uint64(8 * i)) and 255'u64)
    dec i

proc putI16*(w: var seq[byte]; v: int) = putBig(w, uint64(v and 0xFFFF), 2)
proc putI32*(w: var seq[byte]; v: int) = putBig(w, uint64(v) and 0xFFFFFFFF'u64, 4)

proc putVarint*(w: var seq[byte]; v: int64) =
  var x = uint64(v)
  while true:
    if x >= 128'u64:
      w.add byte((x and 127'u64) or 128'u64)
      x = x shr 7'u64
    else:
      w.add byte(x)
      break

proc putF32*(w: var seq[byte]; v: float32) = putBig(w, uint64(cast[uint32](v)), 4)
proc putF64*(w: var seq[byte]; v: float64) = putBig(w, cast[uint64](v), 8)
