## `jester:fx` (overnight/PROTOCOL.md section 5): one EFFECT message per effect. Pure encoder and decoder, no world imports.

import codec

const
  FxChannel* = "jester:fx"
  FxEffect* = 1
  FxBreak* = 0
  FxImpact* = 1
  FxSnap* = 2
  FxCrumble* = 3
  FxLand* = 4

type
  FxEvent* = object
    kind*: int
    pos*: (int, int, int)          ## the block (for a crumble, the centre block)
    state*: int                    ## block state id the particles are built from
    material*: int                 ## physics material id, 0 unknown
    impulse*: float32              ## N*s
    seed*: int                     ## 0..65535
    hasBody*: bool
    bodyId*: int
    hasNormal*: bool
    normal*: (int, int, int)       ## each -127..127 (the wire value, /127 gives the unit normal)

proc packBlockPos*(x, y, z: int): uint64 =
  ## The vanilla packed long: ((x & 0x3FFFFFF) << 38) | ((z & 0x3FFFFFF) << 12) | (y & 0xFFF)
  ((uint64(x) and 0x3FFFFFF'u64) shl 38'u64) or ((uint64(z) and 0x3FFFFFF'u64) shl 12'u64) or (uint64(y) and 0xFFF'u64)

proc unpackBlockPos*(v: uint64): (int, int, int) =
  var x = int(v shr 38'u64)
  var y = int(v and 0xFFF'u64)
  var z = int((v shr 12'u64) and 0x3FFFFFF'u64)
  if x >= 33554432: x -= 67108864
  if z >= 33554432: z -= 67108864
  if y >= 2048: y -= 4096
  (x, y, z)

proc encodeFx*(e: FxEvent): seq[byte] =
  result = @[]
  putU8(result, FxEffect)
  putU8(result, e.kind)
  putU8(result, (if e.hasBody: 1 else: 0) or (if e.hasNormal: 2 else: 0))
  putBig(result, packBlockPos(e.pos[0], e.pos[1], e.pos[2]), 8)
  putVarint(result, int64(e.state))
  putU8(result, e.material)
  putF32(result, e.impulse)
  putBig(result, uint64(e.seed), 2)
  if e.hasBody: putVarint(result, int64(e.bodyId))
  if e.hasNormal:
    putU8(result, e.normal[0])
    putU8(result, e.normal[1])
    putU8(result, e.normal[2])

proc signed8(v: int): int = (if v >= 128: v - 256 else: v)

proc decodeFx*(data: seq[byte]; ok: var bool): FxEvent =
  ## `ok` is false for a message that is not a well-formed EFFECT (the caller ignores it, as the spec says for unknown types).
  var c = newCursor(data)
  result = FxEvent()
  ok = false
  if takeU8(c) != FxEffect: return
  result.kind = takeU8(c)
  let flags = takeU8(c)
  result.pos = unpackBlockPos(takeBig(c, 8))
  result.state = int(takeVarint(c))
  result.material = takeU8(c)
  result.impulse = takeF32(c)
  result.seed = int(takeBig(c, 2))
  if (flags and 1) != 0:
    result.hasBody = true
    result.bodyId = int(takeVarint(c))
  if (flags and 2) != 0:
    result.hasNormal = true
    result.normal = (signed8(takeU8(c)), signed8(takeU8(c)), signed8(takeU8(c)))
  ok = not c.bad
