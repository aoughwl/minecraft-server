## `jester:modsync` (overnight/PROTOCOL.md section 7): MANIFEST (server to client, split at the frame limit) and STATUS (client to server) as
## pure encoders and decoders. No world, player or network imports.

import codec

const
  ModsyncChannel* = "jester:modsync"
  ModsyncManifest* = 1
  ModsyncStatus* = 2
  PolicyAdvisory* = 0
  PolicyEnforce* = 1
  PolicyMore* = 128             ## bit7 of the policy byte: more MANIFEST messages follow
  RoleRequired* = 0
  RoleOptional* = 1
  RoleServerOnly* = 2
  StateOk* = 0
  StateMissing* = 1
  StateHashMismatch* = 2
  StateVersionMismatch* = 3
  StateDisabled* = 4
  ManifestMaxEntries* = 256

type
  ModEntry* = object
    id*: string
    version*: string
    role*: int
    hash*: seq[byte]        ## SHA-256, 32 bytes
    size*: int
    url*: string

  ModStatus* = object
    id*: string
    state*: int
    haveVersion*: string

  ManifestPart* = object
    policy*: int
    more*: bool
    entries*: seq[ModEntry]
    kickMessage*: string

proc putString(w: var seq[byte]; s: string) =
  putVarint(w, int64(s.len))
  for ch in s: w.add byte(ord(ch))

proc takeString(c: var Cursor): string =
  let n = int(takeVarint(c))
  result = ""
  if c.bad or n < 0 or c.at + n > c.data.len:
    c.bad = true
    return
  for i in 0 ..< n: result.add char(c.data[c.at + i])
  c.at += n

proc entryBytes(e: ModEntry): seq[byte] =
  result = @[]
  putString(result, e.id)
  putString(result, e.version)
  putU8(result, e.role)
  for i in 0 ..< 32:
    result.add (if i < e.hash.len: e.hash[i] else: 0'u8)
  putVarint(result, int64(e.size))
  putString(result, e.url)

proc encodeManifest*(policy: int; entries: seq[ModEntry]; kickMessage: string; maxFrame: int): seq[seq[byte]] =
  ## The manifest as one message or, when it does not fit `maxFrame` bytes, several: bit7 of the policy byte is set on all but the last.
  ## An empty list still gives one message. At most 256 entries are sent.
  result = @[]
  let all = (if entries.len > ManifestMaxEntries: entries[0 ..< ManifestMaxEntries] else: entries)
  var i = 0
  while true:
    var body: seq[byte] = @[]
    var count = 0
    var tail: seq[byte] = @[]
    putString(tail, kickMessage)
    var j = i
    while j < all.len:
      let eb = entryBytes(all[j])
      # type, policy, count varint (up to 2 bytes), the entries so far, this one, the kick message
      if count > 0 and 4 + body.len + eb.len + tail.len > maxFrame: break
      for b in eb: body.add b
      inc count
      inc j
    var msg: seq[byte] = @[]
    putU8(msg, ModsyncManifest)
    putU8(msg, policy or (if j < all.len: PolicyMore else: 0))
    putVarint(msg, int64(count))
    for b in body: msg.add b
    for b in tail: msg.add b
    result.add msg
    i = j
    if i >= all.len: break

proc decodeManifest*(data: seq[byte]; ok: var bool): ManifestPart =
  var c = newCursor(data)
  result = ManifestPart()
  ok = false
  if takeU8(c) != ModsyncManifest: return
  let p = takeU8(c)
  result.policy = p and 127
  result.more = (p and PolicyMore) != 0
  let n = int(takeVarint(c))
  if n < 0 or n > ManifestMaxEntries: return
  for k in 0 ..< n:
    var e = ModEntry()
    e.id = takeString(c)
    e.version = takeString(c)
    e.role = takeU8(c)
    e.hash = takeBytes(c, 32)
    e.size = int(takeVarint(c))
    e.url = takeString(c)
    if c.bad: return
    result.entries.add e
  result.kickMessage = takeString(c)
  ok = not c.bad

proc encodeModStatus*(statuses: seq[ModStatus]): seq[byte] =
  result = @[]
  putU8(result, ModsyncStatus)
  putVarint(result, int64(statuses.len))
  for s in statuses:
    putString(result, s.id)
    putU8(result, s.state)
    putString(result, s.haveVersion)

proc decodeModStatus*(data: seq[byte]; ok: var bool): seq[ModStatus] =
  var c = newCursor(data)
  result = @[]
  ok = false
  if takeU8(c) != ModsyncStatus: return
  let n = int(takeVarint(c))
  if n < 0 or n > ManifestMaxEntries: return
  for k in 0 ..< n:
    var s = ModStatus()
    s.id = takeString(c)
    s.state = takeU8(c)
    s.haveVersion = takeString(c)
    if c.bad: return
    result.add s
  ok = not c.bad
