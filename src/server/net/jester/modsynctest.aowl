## Tests for modsyncmsg.aowl and modsyncstate.aowl.

import std/[assertions, syncio]
import modsyncmsg
import modsyncstate
import ../../../plugin/payloads

proc hexOf(b: seq[byte]): string = payloadToHex(b)

var h = newSeq[byte](32)
h[0] = 0xAB'u8
h[31] = 0x01'u8
let a = ModEntry(id: "ns:a", version: "1.0", role: RoleRequired, hash: h, size: 300, url: "")
let b = ModEntry(id: "ns:b", version: "2", role: RoleOptional, hash: newSeq[byte](32), size: 0, url: "http://x")

# a manifest: type 01, policy 01, count 01, string "ns:a", string "1.0", role 00, 32 hash bytes, size varint 300 = ac 02, empty url, empty kick message
let one = encodeManifest(PolicyEnforce, @[a], "", 16000)
assert one.len == 1
assert hexOf(one[0]) == "01" & "01" & "01" & "046e733a61" & "03312e30" & "00" & "ab" & "00000000000000000000000000000000000000000000000000000000000001" & "ac02" & "00" & "00"
var ok = false
let part = decodeManifest(one[0], ok)
assert ok and part.policy == PolicyEnforce and not part.more and part.entries.len == 1 and part.entries[0].id == "ns:a"
assert part.entries[0].size == 300 and part.entries[0].hash[0] == 0xAB'u8 and part.entries[0].hash[31] == 1'u8

# split: a tiny frame limit puts one entry per message, bit7 of the policy on all but the last, and the kick message in every message
let many = encodeManifest(PolicyAdvisory, @[a, b, a], "go away", 80)
assert many.len == 3
assert many[0][1] == 128'u8 and many[1][1] == 128'u8 and many[2][1] == 0'u8
var total = 0
for m in many:
  let p = decodeManifest(m, ok)
  assert ok and p.kickMessage == "go away"
  total += p.entries.len
assert total == 3
assert decodeManifest(many[0], ok).more

# STATUS
let st = @[ModStatus(id: "ns:a", state: StateOk, haveVersion: "1.0"), ModStatus(id: "ns:b", state: StateMissing, haveVersion: "")]
let sb = encodeModStatus(st)
assert hexOf(sb) == "02" & "02" & "046e733a61" & "00" & "03312e30" & "046e733a62" & "01" & "00"
let sd = decodeModStatus(sb, ok)
assert ok and sd.len == 2 and sd[1].state == StateMissing and sd[0].haveVersion == "1.0"
assert not (decodeModStatus(@[9'u8], ok).len > 0 or ok)

# the manifest file
let good = "{ \"policy\": \"enforce\", \"kick_message\": \"install the mods\", \"mods\": [ { \"id\": \"ns:a\", \"version\": \"1.0\", \"role\": \"required\", \"sha256\": \"" &
  "ab00000000000000000000000000000000000000000000000000000000000001\", \"size\": 300 }, { \"id\": \"ns:b\", \"role\": \"optional\" } ] }"
assert parseModsync(good) == ""
assert modsyncActive() and modsyncMods().len == 2 and modsyncPolicy() == PolicyEnforce
assert modsyncMods()[0].hash[0] == 0xAB'u8 and modsyncMods()[0].size == 300 and modsyncMods()[1].role == RoleOptional
assert parseModsync("{ \"mods\": [ { \"id\": \"x\", \"role\": \"sometimes\" } ] }").len > 0 and not modsyncActive()
assert parseModsync("{ \"mods\": [ { \"id\": \"x\", \"sha256\": \"abc\" } ] }").len > 0
assert parseModsync("not json").len > 0
assert parseModsync("{ \"policy\": \"strict\", \"mods\": [] }").len > 0
assert parseModsync("{ \"mods\": [] }") == "" and not modsyncActive()

# verdicts: enforce turns away a client whose required mod is missing or mismatched; an unreported required mod counts as missing
assert parseModsync(good) == ""
var why = ""
assert not modsyncVerdict(@[ModStatus(id: "ns:a", state: StateOk, haveVersion: "1.0")], why)
assert modsyncVerdict(@[ModStatus(id: "ns:a", state: StateHashMismatch, haveVersion: "1.0")], why) and why == "install the mods"
assert modsyncVerdict(@[], why)
assert modsyncVerdict(@[ModStatus(id: "ns:b", state: StateMissing, haveVersion: "")], why)
assert modsyncTimeoutVerdict(why)
# advisory never turns anyone away
assert parseModsync("{ \"mods\": [ { \"id\": \"ns:a\", \"role\": \"required\" } ] }") == ""
assert not modsyncVerdict(@[], why)
assert not modsyncTimeoutVerdict(why)
# optional mods do not matter under enforce
assert parseModsync("{ \"policy\": \"enforce\", \"mods\": [ { \"id\": \"ns:b\", \"role\": \"optional\" } ] }") == ""
assert not modsyncVerdict(@[], why) and not modsyncTimeoutVerdict(why)

# holding: begin, hold finish, release says finish was waiting; a timeout after 15 s
modsyncBegin(7'u64, "Bot", 1000'i64)
assert modsyncIsPending(7'u64) and not modsyncTimedOut(7'u64, 15999'i64) and modsyncTimedOut(7'u64, 16000'i64)
modsyncHoldFinish(7'u64)
assert modsyncRelease(7'u64) and not modsyncIsPending(7'u64) and not modsyncRelease(7'u64)
modsyncBegin(8'u64, "Bot2", 0'i64)
assert not modsyncRelease(8'u64)

# what a player reported
modsyncRecord("Bot", st)
assert modStateOf("Bot", "ns:a") == 0 and modStateOf("Bot", "ns:b") == 1 and modStateOf("Bot", "ns:zz") == -1 and modStateOf("Other", "ns:a") == -1
assert modVersionOf("Bot", "ns:a") == "1.0"
modsyncForget("Bot")
assert modStateOf("Bot", "ns:a") == -1
echo "modsynctest: ok"
