## The `jester:wind` messages (overnight/PROTOCOL.md section 4) as bytes: pure encoders, no world, player or network imports, so the
## tests can run anywhere and the sender (windsync.aowl) only has to call them. Big-endian; floats are IEEE-754 single precision.

const
  WindChannel* = "jester:wind"
  WindMsgInit* = 1'u8
  WindMsgUpdate* = 2'u8
  WindMsgTimeSync* = 3'u8
  WindMsgGust* = 4'u8
  WindMsgGustCancel* = 5'u8
  WindAlgo* = 1'u8
  GustFront* = 0
  GustRadial* = 1
  GustVortex* = 2

type
  WindParams* = object
    ## The INIT fields, in the order of the wire (a UPDATE mask bit i is field i).
    baseSpeed*: float32        ## bit 0, blocks/second at the reference altitude
    baseYaw*: float32          ## bit 1, radians
    turbulence*: float32       ## bit 2
    spatialScale*: float32     ## bit 3, blocks
    temporalScale*: float32    ## bit 4, ticks
    altitudeGain*: float32     ## bit 5
    weatherGain*: float32      ## bit 6
    flags*: uint8              ## bit 7: bit0 shelter, bit1 cave draft
    draft*: float32            ## bit 8, only on the wire when flags bit1 is set (INIT) or the mask bit is set (UPDATE)

proc defaultWindParams*(): WindParams =
  WindParams(baseSpeed: 3.2'f32, baseYaw: 0.0'f32, turbulence: 0.5'f32, spatialScale: 48.0'f32, temporalScale: 200.0'f32,
             altitudeGain: 0.15'f32, weatherGain: 0.6'f32, flags: 0'u8, draft: 0.0'f32)

proc putU8(w: var seq[byte]; v: int) = w.add byte(v and 255)

proc putBig(w: var seq[byte]; v: uint64; bytes: int) =
  var i = bytes - 1
  while i >= 0:
    w.add byte((v shr uint64(8 * i)) and 255'u64)
    dec i

proc putVarint(w: var seq[byte]; v: int64) =
  var x = uint64(v)
  while true:
    if x >= 128'u64:
      w.add byte((x and 127'u64) or 128'u64)
      x = x shr 7'u64
    else:
      w.add byte(x)
      break

proc putF32(w: var seq[byte]; v: float32) = putBig(w, uint64(cast[uint32](v)), 4)
proc putF64(w: var seq[byte]; v: float64) = putBig(w, cast[uint64](v), 8)

proc windFinite(v: float32): bool =
  ## Not NaN and not infinite (the client discards a message with such a value).
  v == v and v < 3.0e38'f32 and v > -3.0e38'f32

proc windParamsFinite*(p: WindParams): bool =
  windFinite(p.baseSpeed) and windFinite(p.baseYaw) and windFinite(p.turbulence) and windFinite(p.spatialScale) and
    windFinite(p.temporalScale) and windFinite(p.altitudeGain) and windFinite(p.weatherGain) and windFinite(p.draft)

proc encodeWindInit*(seed: int64; serverTick: int64; p: WindParams): seq[byte] =
  ## INIT (4.1): sent right after the welcome, on join and on a dimension change.
  result = @[]
  putU8(result, int(WindMsgInit))
  putU8(result, int(WindAlgo))
  putBig(result, uint64(seed), 8)
  putVarint(result, serverTick)
  putF32(result, p.baseSpeed)
  putF32(result, p.baseYaw)
  putF32(result, p.turbulence)
  putF32(result, p.spatialScale)
  putF32(result, p.temporalScale)
  putF32(result, p.altitudeGain)
  putF32(result, p.weatherGain)
  putU8(result, int(p.flags))
  if (p.flags and 2'u8) != 0'u8:
    putF32(result, p.draft)

proc encodeWindUpdate*(serverTick: int64; mask: int; p: WindParams): seq[byte] =
  ## UPDATE (4.2): only the fields whose mask bit is set, in order.
  result = @[]
  putU8(result, int(WindMsgUpdate))
  putVarint(result, serverTick)
  putU8(result, (mask shr 8) and 255)
  putU8(result, mask and 255)
  if (mask and 1) != 0: putF32(result, p.baseSpeed)
  if (mask and 2) != 0: putF32(result, p.baseYaw)
  if (mask and 4) != 0: putF32(result, p.turbulence)
  if (mask and 8) != 0: putF32(result, p.spatialScale)
  if (mask and 16) != 0: putF32(result, p.temporalScale)
  if (mask and 32) != 0: putF32(result, p.altitudeGain)
  if (mask and 64) != 0: putF32(result, p.weatherGain)
  if (mask and 128) != 0: putU8(result, int(p.flags))
  if (mask and 256) != 0: putF32(result, p.draft)

proc windChangedMask*(a, b: WindParams): int =
  ## The UPDATE mask of what differs between two parameter sets.
  result = 0
  if a.baseSpeed != b.baseSpeed: result = result or 1
  if a.baseYaw != b.baseYaw: result = result or 2
  if a.turbulence != b.turbulence: result = result or 4
  if a.spatialScale != b.spatialScale: result = result or 8
  if a.temporalScale != b.temporalScale: result = result or 16
  if a.altitudeGain != b.altitudeGain: result = result or 32
  if a.weatherGain != b.weatherGain: result = result or 64
  if a.flags != b.flags: result = result or 128
  if a.draft != b.draft: result = result or 256

proc encodeWindTimeSync*(serverTick: int64): seq[byte] =
  ## TIME_SYNC (4.3)
  result = @[]
  putU8(result, int(WindMsgTimeSync))
  putVarint(result, serverTick)

proc encodeWindGust*(gustId: int; kind: int; startTick: int64; duration: int; ox, oy, oz: float64; dx, dy, dz: int; radius16: int;
                     strength256: int; speed256: int; noiseSeed: uint32): seq[byte] =
  ## GUST (4.4): `dx, dy, dz` are the direction as -127..127 (already /127), `radius16` in 1/16 block, `strength256` in 1/256 b/s,
  ## `speed256` in 1/256 blocks/tick.
  result = @[]
  putU8(result, int(WindMsgGust))
  putVarint(result, int64(gustId))
  putU8(result, kind)
  putVarint(result, startTick)
  putBig(result, uint64(duration), 2)
  putF64(result, ox)
  putF64(result, oy)
  putF64(result, oz)
  putU8(result, dx)
  putU8(result, dy)
  putU8(result, dz)
  putBig(result, uint64(radius16), 2)
  putBig(result, uint64(strength256), 2)
  putBig(result, uint64(speed256), 2)
  putBig(result, uint64(noiseSeed), 4)

proc encodeWindGustCancel*(gustId: int): seq[byte] =
  result = @[]
  putU8(result, int(WindMsgGustCancel))
  putVarint(result, int64(gustId))
