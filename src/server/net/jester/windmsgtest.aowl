## Tests for windmsg.aowl against hand-computed bytes (PROTOCOL.md section 4).

import std/[assertions, syncio]
import windmsg
import ../../../plugin/payloads

proc hexOf(b: seq[byte]): string = payloadToHex(b)

# INIT: seed 1337, tick 1000, the defaults: 3.2 = 404ccccd, 0.5 = 3f000000, 48 = 42400000, 200 = 43480000, 0.15 = 3e19999a, 0.6 = 3f19999a
assert hexOf(encodeWindInit(1337'i64, 1000'i64, defaultWindParams())) ==
  "0101" & "0000000000000539" & "e807" & "404ccccd" & "00000000" & "3f000000" & "42400000" & "43480000" & "3e19999a" & "3f19999a" & "00"

# INIT with the cave draft flag carries the draft float (1.5 = 3fc00000) after the flags
var drafty = defaultWindParams()
drafty.flags = 3'u8
drafty.draft = 1.5'f32
let dh = hexOf(encodeWindInit(-1'i64, 0'i64, drafty))
assert dh.len == (1 + 1 + 8 + 1 + 28 + 1 + 4) * 2
assert dh.substr(dh.len - 10) == "033fc00000"
assert dh.substr(4, 19) == "ffffffffffffffff"

# TIME_SYNC at 1200 ticks: varint b0 09
assert hexOf(encodeWindTimeSync(1200'i64)) == "03b009"

# UPDATE with base_speed (bit 0) and weather_gain (bit 6)
assert hexOf(encodeWindUpdate(1000'i64, 1 or 64, defaultWindParams())) == "02" & "e807" & "0041" & "404ccccd" & "3f19999a"
# UPDATE for the flags and draft fields (bits 7 and 8)
assert hexOf(encodeWindUpdate(0'i64, 128 or 256, drafty)) == "02" & "00" & "0180" & "03" & "3fc00000"

# changed mask
var other = defaultWindParams()
other.baseSpeed = 5.0'f32
other.weatherGain = 1.0'f32
assert windChangedMask(defaultWindParams(), other) == (1 or 64)
assert windChangedMask(defaultWindParams(), defaultWindParams()) == 0

# GUST cancel and GUST
assert hexOf(encodeWindGustCancel(5)) == "0505"
let gust = hexOf(encodeWindGust(300, GustRadial, 2000'i64, 100, 1.0, 2.0, 3.0, 127, 0, 129, 160, 0x0A00, 0x0100, 0xDEADBEEF'u32))
# 04, id 300 = ac 02, kind 01, start 2000 = d0 0f, duration 0064, three f64 (1.0 = 3ff0000000000000, 2.0 = 4000..., 3.0 = 4008...),
# direction 7f 00 81, radius 00a0, strength 0a00, speed 0100, seed deadbeef
assert gust == "04" & "ac02" & "01" & "d00f" & "0064" & "3ff0000000000000" & "4000000000000000" & "4008000000000000" & "7f0081" &
  "00a0" & "0a00" & "0100" & "deadbeef"

# a non-finite parameter is refused by windParamsFinite
var bad = defaultWindParams()
bad.turbulence = 0.0'f32 / 0.0'f32
assert not windParamsFinite(bad)
assert windParamsFinite(defaultWindParams())
echo "windmsgtest: ok"
