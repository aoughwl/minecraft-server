## The server end of `jester:wind` (overnight/PROTOCOL.md section 4): feeds the world's seed and weather into the server's wind field
## (src/physics/windfield.aowl) and sends INIT / UPDATE / TIME_SYNC to every player whose Jester handshake granted `wind`.
## tickWindSync runs once a tick from the plugin manager.

from ../../sim/dimtick import assertTickThread
import std/[options]
import windmsg
import ../../serverbase
import ../../entity/playerextras
import ../../../plugin/payloads
import ../../../physics/windfield

const
  TimeSyncTicks = 1200      ## TIME_SYNC every minute
  UpdateTicks = 20          ## UPDATE at most once a second
  PrunePeriod = 200

type
  WindPeer = object
    name: string
    dimension: string
    lastSync: int64

var
  gWindPeers: seq[WindPeer] = @[]
  gWindParams: WindParams = defaultWindParams()      ## what the server wants the clients to use
  gWindSent: WindParams = defaultWindParams()        ## what the clients were last told
  gWindLastUpdate: int64 = 0'i64

proc setJesterWindParams*(p: WindParams) =
  ## Changes the parameters the clients use; they get an UPDATE (at most once a second) with what differs.
  gWindParams = p

proc jesterWindParams*(): WindParams = gWindParams

proc windPeerIndex(name: string): int =
  result = -1
  for i in 0 ..< gWindPeers.len:
    if gWindPeers[i].name == name: result = i

proc tickWindSync*(server: Server; tick: int64) =
  assertTickThread("windsync.tickWindSync")
  if server.worlds.len == 0: return
  # the server's own field: the overworld's seed and weather
  let first = server.worlds[0]
  setWindSeed(int(int64(first.level.seed)))
  setWindWeather(float(first.weather.rainLevel), float(first.weather.thunderLevel))
  var mask = 0
  if tick - gWindLastUpdate >= int64(UpdateTicks):
    mask = windChangedMask(gWindSent, gWindParams)
    if mask != 0:
      gWindLastUpdate = tick
      gWindSent = gWindParams
  var seen: seq[string] = @[]
  for world in server.worlds:
    let age = world.levelTime.worldAge
    for p in world.players:
      let name = p.gameprofile.name
      if not playerHasCapability(name, "wind"): continue
      seen.add name
      let dim = world.dimension.minecraftName
      let at = windPeerIndex(name)
      if at < 0 or gWindPeers[at].dimension != dim:
        if windParamsFinite(gWindParams):
          p.sendCustomPayload(WindChannel, encodeWindInit(int64(world.level.seed), age, gWindParams))
        if at < 0:
          gWindPeers.add WindPeer(name: name, dimension: dim, lastSync: age)
        else:
          gWindPeers[at].dimension = dim
          gWindPeers[at].lastSync = age
      else:
        if mask != 0:
          p.sendCustomPayload(WindChannel, encodeWindUpdate(age, mask, gWindSent))
        if age - gWindPeers[at].lastSync >= int64(TimeSyncTicks):
          p.sendCustomPayload(WindChannel, encodeWindTimeSync(age))
          gWindPeers[at].lastSync = age
  if tick mod int64(PrunePeriod) == 0'i64:
    var kept: seq[WindPeer] = @[]
    for peer in gWindPeers:
      for s in seen:
        if s == peer.name:
          kept.add peer
          break
    gWindPeers = kept
