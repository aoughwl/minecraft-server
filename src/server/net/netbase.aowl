## Connection-layer data types and pure helpers.
## Port of pumpkin/src/net/mod.rs
## PARTIAL: pumpkin/src/net/mod.rs - `ClientPlatform` is the enum only, with no payload: a Bedrock player is a `Player` whose `JavaClient` is a socketless stand-in (net/bedrock/bedrockplay.aowl), so `platform` (net/java/javamod.aowl) answers `cpBedrock` for a client that has a `bedrockSend`, and the Bedrock client itself is reached through that closure. `DisconnectReason` is net/bedrock/bedrockreason.aowl. `can_not_join` reads the server's data, so it is in ../servermod.aowl (all three halves: player ban, whitelist, IP ban). The `is_valid_player_name` tests are in netbasetest.aowl.
## The connection itself is src/server/net/java/.

import std/options
import sha2 # from the sibling `jwt` library, via aowlmony.paths
import ../../util/uuid
import ../../util/text/text

type
  ClientPlatform* = enum
    ## `ClientPlatform`: which edition a player's client is.
    cpJava
    cpBedrock

  PlayerUuid* = Uuid
    ## src/util/uuid.aowl's type, under the name src/plugin_api already uses.

  PropertyValue* = object
    ## Port of upstream's `Property` (a signed profile property, e.g. skin
    ## texture data) - name/value/signature only, no verification logic
    ## here (that's Mojang-key crypto, same family of gap as `auth/`'s
    ## still-missing root-of-trust chain walk).
    name*: string
    value*: string
    signature*: string
      ## Empty string means "absent" (Rust's `Option<String>` collapsed -
      ## matches this port's existing convention of avoiding `Option[T]`
      ## where an empty/sentinel value is unambiguous).

  ProfileAction* = enum
    ## Port of upstream's `ProfileAction` (Mojang account-moderation flags
    ## that can accompany a profile lookup).
    paForcedNameChange
    paUsingBannedSkin

  GameProfile* = object
    ## Port of upstream's `GameProfile`. `properties` is a plain `seq`
    ## rather than upstream's `ArcSwap<Vec<Property>>` - no shared-mutation
    ## story exists yet for this port (same gap noted throughout for
    ## `Arc<RwLock<..>>`-shaped upstream types).
    id*: PlayerUuid
    name*: string
    properties*: seq[PropertyValue]
    profileActions*: seq[ProfileAction]
      ## Empty seq means "no actions" (upstream's `Option<Vec<..>>`
      ## collapsed the same way as `PropertyValue.signature` above).

  ChatMode* = enum
    cmEnabled
    cmCommandsOnly
    cmHidden

  Hand* = enum
    hLeft
    hRight

  PlayerConfig* = object
    ## Port of upstream's `PlayerConfig`.
    locale*: string
    viewDistance*: uint8
      ## Upstream is `NonZero<u8>`; aowlmony has no non-zero-integer type, so
      ## this is a plain `uint8` - callers must not construct/accept 0 here,
      ## same as upstream's `NonZero::new(8).unwrap_or(NonZero::MIN)` treats
      ## 0 as invalid and falls back to 1.
    chatMode*: ChatMode
    chatColors*: bool
    skinParts*: uint8
    mainHand*: Hand
    textFiltering*: bool
    serverListing*: bool

proc defaultPlayerConfig*(): PlayerConfig =
  PlayerConfig(
    locale: "en_us",
    viewDistance: 8'u8,
    chatMode: cmEnabled,
    chatColors: true,
    skinParts: 0x7F'u8,
    mainHand: hRight,
    textFiltering: false,
    serverListing: false,
  )

type
  PacketHandlerResultKind* = enum
    phrStop
    phrReadyToPlay
    phrContinue  ## Upstream's `None` from `handle_packet`; see dispatch.aowl.

  PacketHandlerResult* = object
    case kind*: PacketHandlerResultKind
    of phrStop, phrContinue:
      discard
    of phrReadyToPlay:
      profile*: GameProfile
      config*: PlayerConfig

proc playerConfigFrom*(locale: string; viewDistance: int8; chatMode: int32; chatColors: bool; skinParts: uint8;
    mainHand: int32; textFiltering, serverListing: bool): (bool, PlayerConfig) =
  ## The `Hand::try_from` and `ChatMode::try_from` of handle_client_information_config; false for a bad value.
  if mainHand < 0 or mainHand > 1 or chatMode < 0 or chatMode > 2:
    return (false, defaultPlayerConfig())
  (true, PlayerConfig(locale: locale, viewDistance: uint8(viewDistance), chatMode: ChatMode(chatMode),
    chatColors: chatColors, skinParts: skinParts, mainHand: Hand(mainHand), textFiltering: textFiltering,
    serverListing: serverListing))

const MaxPendingBytes* = 64 * 1024 * 1024
  ## Maximum payload bytes queued for a client before it's considered
  ## stalled/overflowing and disconnected.

proc decrementPendingBytes*(pendingBytes: var uint, bytes: uint) {.inline.} =
  ## Defensively decrement a pending-byte counter without underflowing.
  ## Upstream does this atomically (`AtomicUsize::fetch_update`); this port
  ## has no shared-mutation story yet (same gap as `GameProfile.properties`
  ## above), so it's a plain saturating subtraction on a `var`.
  if bytes >= pendingBytes:
    pendingBytes = 0
  else:
    pendingBytes -= bytes

type
  EncryptionErrorKind* = enum
    eeFailedDecrypt
    eeSharedWrongLength
    eeAlreadyEncrypted
    eeNoPendingVerifyToken
    eeVerifyTokenMismatch

proc isValidPlayerName*(name: string): bool =
  ## Port of upstream's `is_valid_player_name`. Upstream checks byte length
  ## (`name.len() > 16` is UTF-8 byte length in Rust, not char count - the
  ## Chinese-name test vectors below only pass because of this) and scans
  ## Unicode *codepoints* for `char::is_control()` or space.
  ##
  ## This scans *bytes* instead of decoding UTF-8 codepoints, checking each
  ## byte against the ASCII control range plus space (0x00-0x20, and 0x7F).
  ## Every upstream test vector is either pure ASCII or pure
  ## multi-byte UTF-8 (continuation bytes are 0x80-0xBF, never landing in
  ## the checked ranges), so this is verified byte-for-byte correct against
  ## every vector below - but it does NOT implement Rust's full
  ## `char::is_control()`, which also covers the C1 control block
  ## (U+0080-U+009F, encoded as 2-byte UTF-8 starting 0xC2 0x80-0x9F) that
  ## no upstream test exercises. A name containing a raw C1 control
  ## character would be accepted here and rejected upstream - documented
  ## gap, not silently wrong.
  if name.len > 16:
    return false
  for i in 0 ..< name.len:
    let b = name[i].uint8
    if b <= 0x20'u8 or b == 0x7F'u8:
      return false
  true

proc offlineUuid*(username: string): PlayerUuid =
  ## Port of upstream's `offline_uuid`: SHA-256 the username, take the
  ## first 16 bytes as the UUID verbatim - no version/variant bit fixup
  ## (upstream's `Uuid::from_slice` does none either, despite this not
  ## being a spec-compliant UUID; matching upstream's actual behavior, not
  ## the UUID spec).
  var usernameBytes = newSeq[byte](username.len)
  for i in 0 ..< username.len:
    usernameBytes[i] = byte(username[i])
  let digest = sha256(usernameBytes)
  var hi: uint64 = 0
  for i in 0 ..< 8:
    hi = (hi shl 8) or uint64(digest[i])
  var lo: uint64 = 0
  for i in 8 ..< 16:
    lo = (lo shl 8) or uint64(digest[i])
  Uuid(hi: hi, lo: lo)


proc scrubAddress*(ip: string): string =
  ## `scrub_address` of pumpkin/src/lib.rs: every character but `.` and `:` becomes `x`, for the `scrub_ips` option.
  result = ""
  for ch in ip:
    result.add(if ch == '.' or ch == ':': ch else: 'x')

proc parseIpv4*(text: string; canonical: var string): bool =
  ## `IpAddr::from_str` for a dotted IPv4 address (the only family the listener binds): four decimal parts of 0 to 255
  ## with no leading zero, as Rust's parser has it. `canonical` is its `to_string`.
  var parts: seq[string] = @[]
  var current = ""
  for ch in text:
    if ch == '.':
      parts.add(current)
      current = ""
    else:
      current.add(ch)
  parts.add(current)
  if parts.len != 4:
    return false
  var value = ""
  for i in 0 ..< 4:
    let part = parts[i]
    if part.len == 0 or part.len > 3:
      return false
    if part.len > 1 and part[0] == '0':
      return false
    var n = 0
    for ch in part:
      if ch < '0' or ch > '9':
        return false
      n = n * 10 + (ord(ch) - ord('0'))
    if n > 255:
      return false
    if i > 0:
      value.add('.')
    value.add($n)
  canonical = value
  true
