## A stand-in server for tools/mcbot.py's --rcon and --query: only the RCON and query services, with canned answers, on the
## ports it is given, for a few seconds. Not part of the server; it is what lets those two scenarios run without the world.
##
##     netsvcd <rcon port> <query port> <password> <seconds>

import std/[os, syncio]
import ../../config/networking/[rcon, query]
import rcon
import queryserver
import winsock

proc parseNum(s: string): int =
  result = 0
  for c in s:
    result = result * 10 + (ord(c) - ord('0'))

proc run(): int =
  if paramCount() < 4:
    echo "usage: netsvcd <rcon port> <query port> <password> <seconds>"
    return 2
  if not initWinsock():
    return 1
  var rc = defaultRCONConfig()
  rc.enabled = true
  rc.password = paramStr(3)
  rc.address = unspecified(uint16(parseNum(paramStr(1))))
  var qc = defaultQueryConfig()
  qc.address = unspecified(uint16(parseNum(paramStr(2))))
  let rs = startRcon(rc)
  let qs = startQuery(qc)
  if rs == nil or qs == nil:
    return 1
  let exec = proc(line: string): seq[string] {.closure.} =
    if line == "list":
      @["There are 2 of a max of 20 players online: Alice, Bob"]
    elif line == "silent":
      newSeq[string]()
    else:
      @["ran: " & line, "second line"]
  let provide = proc(): QueryInfo {.closure.} =
    QueryInfo(motd: "A Test Server", maxPlayers: 20, numPlayers: 2, worldName: "world", players: @["Alice", "Bob"])
  echo "netsvcd ready"
  stdout.flushFile()
  let until = nowMs() + int64(parseNum(paramStr(4))) * 1000'i64
  while nowMs() < until:
    pumpRcon(rs, exec)
    pumpQuery(qs, provide)
    sleepMs(2)
  stopRcon(rs)
  stopQuery(qs)
  0

quit(run())
