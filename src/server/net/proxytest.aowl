## Test for proxy.aowl: BungeeCord's address field, and Velocity's signed forwarding data (an HMAC made by Python's hmac).

import std/[assertions, options, syncio]
import ../../config/networking/proxy
import ../../util/uuid
import netbase
import proxy

const VelocityData = "6038bb71037b67dcef0891b9f123e9531aa145aea58d32aba54d6e48c699fb39040831302e312e322e33069a79f444e94726a5befca90e38aaf505416c696365020874657874757265730176010373696705706c61696e02707600"

proc fromHex(h: string): seq[byte] =
  result = @[]
  var i = 0
  while i + 1 < h.len:
    var v = 0
    for j in 0 ..< 2:
      let c = h[i + j]
      v = v * 16 + (if c >= 'a': ord(c) - ord('a') + 10 else: ord(c) - ord('0'))
    result.add(byte(v))
    i += 2

proc run() =
  # BungeeCord: host, ip, uuid, properties.
  let full = "play.example.com\x00203.0.113.9\x00069a79f444e94726a5befca90e38aaf5\x00[{\"name\":\"textures\",\"value\":\"v\",\"signature\":\"s\"},{\"name\":\"x\",\"value\":\"y\"}]"
  let a = bungeecordLogin("127.0.0.1", full, "Alice")
  assert a.ok and a.ip == "203.0.113.9" and a.profile.name == "Alice"
  assert $a.profile.id == "069a79f4-44e9-4726-a5be-fca90e38aaf5"
  assert a.profile.properties.len == 2 and a.profile.properties[0].signature == "s" and a.profile.properties[1].signature == ""
  # Nothing forwarded: the socket's address and the offline uuid.
  let bare = bungeecordLogin("127.0.0.1", "play.example.com", "Alice")
  assert bare.ok and bare.ip == "127.0.0.1" and bare.profile.id == offlineUuid("Alice") and bare.profile.properties.len == 0
  let empties = bungeecordLogin("127.0.0.1", "h\x00\x00\x00", "Alice")
  assert empties.ok and empties.ip == "127.0.0.1" and empties.profile.id == offlineUuid("Alice")
  assert bungeecordLogin("1.1.1.1", "h\x00not-an-ip", "A").error.message == "Failed to parse address"
  assert bungeecordLogin("1.1.1.1", "h\x00" & "1.2.3.4\x00xyz", "A").error.message == "Failed to parse UUID"
  assert bungeecordLogin("1.1.1.1", "h\x00" & "1.2.3.4\x00069a79f444e94726a5befca90e38aaf5\x00{", "A").error.message ==
    "Failed to parse properties"
  assert bungeecordLogin("1.1.1.1", "h\x00" & "2001:db8::1", "A").ip == "2001:db8::1"
  assert not bungeecordLogin("1.1.1.1", "h\x00" & "1.2.3", "A").ok
  assert not bungeecordLogin("1.1.1.1", "h\x00" & "01.2.3.4", "A").ok
  assert not bungeecordLogin("1.1.1.1", "h\x00" & "256.2.3.4", "A").ok

  # Velocity: the question, then the signed answer.
  let req = velocityRequest(77'i32)
  assert req.channel == "velocity:player_info" and req.data == @[4'u8] and req.messageId.value == 77'i32
  var config = defaultVelocityConfig()
  config.enabled = true
  config.secret = "sekret"
  let data = fromHex(VelocityData)
  let ok = receiveVelocityPluginResponse(25565'u16, config, true, data)
  assert ok.ok, ok.error.message
  assert ok.address == "10.1.2.3" and ok.profile.name == "Alice"
  assert $ok.profile.id == "069a79f4-44e9-4726-a5be-fca90e38aaf5"
  assert ok.profile.properties.len == 2
  assert ok.profile.properties[0].name == "textures" and ok.profile.properties[0].value == "v" and ok.profile.properties[0].signature == "sig"
  assert ok.profile.properties[1].name == "plain" and ok.profile.properties[1].signature == ""
  # The wrong secret, a flipped byte, a short answer and no answer are all refused.
  config.secret = "other"
  assert receiveVelocityPluginResponse(25565'u16, config, true, data).error.message == "Unable to verify player details"
  config.secret = "sekret"
  var bad = data
  bad[40] = bad[40] xor 1'u8
  assert receiveVelocityPluginResponse(25565'u16, config, true, bad).error.message == "Unable to verify player details"
  assert receiveVelocityPluginResponse(25565'u16, config, true, data[0 ..< 20]).error.message == "Unable to verify player details"
  assert receiveVelocityPluginResponse(25565'u16, config, false, @[]).error.message == "No response data received"
  assert checkIntegrity(data[0 ..< 32], data[32 ..< data.len], "sekret")
  assert not checkIntegrity(data[0 ..< 31], data[32 ..< data.len], "sekret")
  echo "proxytest ok"

run()
