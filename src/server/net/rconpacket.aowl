## Port of pumpkin/src/net/rcon/packet.rs
##
## Source RCON packets: little-endian length, id, type, body, two zero bytes. Upstream's `ServerboundPacket::from_i32` maps
## 2 to a command and everything else to an auth, which is kept: the real auth type is 3.

const
  RconMinPacketSize* = 10
  RconMaxPacketSize* = 1460

type
  RconServerboundType* = enum
    rstAuth = 2     ## `from_i32` maps everything but 2 here: the real auth type is 3.
    rstExecCommand = 3

  RconClientboundType* = enum
    rctOutput = 0
    rctAuthResponse = 2

  RconPacket* = object
    id*: int32
    ptype*: RconServerboundType
    body*: string

  RconParseKind* = enum
    rpkNeedMore
    rpkPacket
    rpkInvalidLength
    rpkMissingNullTerminator
    rpkInvalidBody

  RconParse* = object
    kind*: RconParseKind
    packet*: RconPacket

proc serverboundFromI32*(n: int32): RconServerboundType =
  ## `ServerboundPacket::from_i32`: 2 is a command, anything else an auth.
  if n == 2'i32: rstExecCommand else: rstAuth

proc putI32Le(buf: var seq[byte]; v: int32) =
  let u = uint32(v)
  buf.add(byte(u and 255'u32))
  buf.add(byte((u shr 8) and 255'u32))
  buf.add(byte((u shr 16) and 255'u32))
  buf.add(byte((u shr 24) and 255'u32))

proc getI32Le(buf: openArray[byte]; at: int): int32 =
  int32(uint32(buf[at]) or (uint32(buf[at + 1]) shl 8) or (uint32(buf[at + 2]) shl 16) or (uint32(buf[at + 3]) shl 24))

proc rconWriteBuf*(ptype: RconClientboundType; id: int32; body: string): seq[byte] =
  ## `ClientboundPacket::write_buf`. 10 is for the type, the id and the two terminating zeros.
  result = @[]
  putI32Le(result, int32(10 + body.len))
  putI32Le(result, id)
  putI32Le(result, int32(ord(ptype)))
  for c in body:
    result.add(byte(c))
  result.add(0'u8)
  result.add(0'u8)

proc isValidUtf8(data: openArray[byte]; first, stop: int): bool =
  ## Well-formed lead and continuation bytes. Overlong forms and surrogates are not told apart.
  var i = first
  while i < stop:
    let b = int(data[i])
    var extra = 0
    if b < 0x80:
      extra = 0
    elif b >= 0xC2 and b <= 0xDF:
      extra = 1
    elif b >= 0xE0 and b <= 0xEF:
      extra = 2
    elif b >= 0xF0 and b <= 0xF4:
      extra = 3
    else:
      return false
    if i + extra >= stop and extra > 0:
      return false
    for k in 1 .. extra:
      if (int(data[i + k]) and 0xC0) != 0x80:
        return false
    i += extra + 1
  true

proc rconDeserialize*(incoming: var seq[byte]): RconParse =
  ## `Packet::deserialize`: the first whole packet is taken off `incoming`.
  let none0 = RconPacket(id: 0'i32, ptype: rstAuth, body: "")
  if incoming.len < 4:
    return RconParse(kind: rpkNeedMore, packet: none0)
  let size = getI32Le(incoming, 0)
  # An RCON packet size includes: ID(4) + Type(4) + Body(n) + Null(1) + EmptyStringNull(1).
  if size < int32(RconMinPacketSize) or size > int32(RconMaxPacketSize):
    return RconParse(kind: rpkInvalidLength, packet: none0)
  let total = int(size) + 4
  if incoming.len < total:
    return RconParse(kind: rpkNeedMore, packet: none0)
  let id = getI32Le(incoming, 4)
  let ty = getI32Le(incoming, 8)
  let bodyStart = 12
  let bodyEnd = total - 2
  if incoming[bodyEnd] != 0'u8 or incoming[bodyEnd + 1] != 0'u8:
    return RconParse(kind: rpkMissingNullTerminator, packet: none0)
  if not isValidUtf8(incoming, bodyStart, bodyEnd):
    return RconParse(kind: rpkInvalidBody, packet: none0)
  var body = ""
  for i in bodyStart ..< bodyEnd:
    body.add(char(incoming[i]))
  incoming = incoming[total ..< incoming.len]
  RconParse(kind: rpkPacket, packet: RconPacket(id: id, ptype: serverboundFromI32(ty), body: body))
