## Test for rconpacket.aowl: known bytes of Source RCON packets, split reads, and each way a packet can be refused.

import std/[assertions, syncio]
import rconpacket

proc fromHex(h: string): seq[byte] =
  result = @[]
  var i = 0
  while i + 1 < h.len:
    var v = 0
    for j in 0 ..< 2:
      let c = h[i + j]
      v = v * 16 + (if c >= 'a': ord(c) - ord('a') + 10 else: ord(c) - ord('0'))
    result.add(byte(v))
    i += 2

proc append(a: var seq[byte]; b: seq[byte]) =
  for x in b:
    a.add(x)

proc hexOf(parts: openArray[string]): seq[byte] =
  ## Several hex strings, one byte sequence.
  result = @[]
  for p in parts:
    append(result, fromHex(p))

proc run() =
  # What a client sends to log in with the password "pass" (type 3), and to run "list" (type 2).
  var auth = hexOf(["0e000000", "01000000", "03000000", "70617373", "0000"])
  let p1 = rconDeserialize(auth)
  assert p1.kind == rpkPacket and p1.packet.id == 1'i32 and p1.packet.ptype == rstAuth and p1.packet.body == "pass"
  assert auth.len == 0
  var cmd = hexOf(["0e000000", "07000000", "02000000", "6c697374", "0000"])
  let p2 = rconDeserialize(cmd)
  assert p2.packet.id == 7'i32 and p2.packet.ptype == rstExecCommand and p2.packet.body == "list"

  # What the server answers.
  assert rconWriteBuf(rctAuthResponse, 1'i32, "") == hexOf(["0a000000", "01000000", "02000000", "0000"])
  assert rconWriteBuf(rctAuthResponse, -1'i32, "") == hexOf(["0a000000", "ffffffff", "02000000", "0000"])
  assert rconWriteBuf(rctOutput, 7'i32, "hi") == hexOf(["0c000000", "07000000", "00000000", "6869", "0000"])

  # An unknown type is an auth, as upstream's `from_i32`.
  assert serverboundFromI32(2'i32) == rstExecCommand
  assert serverboundFromI32(3'i32) == rstAuth
  assert serverboundFromI32(99'i32) == rstAuth

  # Half a packet is not a packet; the rest of it completes it; two in a row come out one at a time.
  var chunked = hexOf(["0e000000", "01000000", "03000000", "7061"])
  assert rconDeserialize(chunked).kind == rpkNeedMore and chunked.len == 14
  append(chunked, hexOf(["7373", "0000", "0a000000", "02000000", "03000000", "0000"]))
  assert rconDeserialize(chunked).packet.body == "pass"
  let second = rconDeserialize(chunked)
  assert second.kind == rpkPacket and second.packet.id == 2'i32 and second.packet.body == ""
  var tiny = fromHex("0e00")
  assert rconDeserialize(tiny).kind == rpkNeedMore

  # Refused: a size under 10 or over 1460, a missing terminator, a body that is not UTF-8.
  var small = hexOf(["09000000", "01000000", "03000000", "00"])
  assert rconDeserialize(small).kind == rpkInvalidLength
  var big = hexOf(["b5050000", "01000000", "03000000"])
  assert rconDeserialize(big).kind == rpkInvalidLength
  var edge = fromHex("b4050000")
  assert rconDeserialize(edge).kind == rpkNeedMore, "1460 is allowed"
  var noNul = hexOf(["0b000000", "01000000", "03000000", "610001"])
  assert rconDeserialize(noNul).kind == rpkMissingNullTerminator
  var badUtf = hexOf(["0c000000", "01000000", "03000000", "c328", "0000"])
  assert rconDeserialize(badUtf).kind == rpkInvalidBody
  var goodUtf = hexOf(["0c000000", "01000000", "03000000", "c3a9", "0000"])
  let ok = rconDeserialize(goodUtf)
  assert ok.kind == rpkPacket and ok.packet.body == "\xc3\xa9"
  echo "rconpackettest ok"

run()
