## Minimal raw Winsock2 FFI.
##
## THE DESIGN OF THE SERVER'S NETWORKING: one thread, non-blocking sockets, polled from the loop in
## ../pumpkinlib.aowl. Upstream gives each connection tokio tasks and blocks them on `await`; none of that
## has an equivalent here. A socket from `listenOnNonBlocking`/`tryAccept` never blocks: `tryRecv` and
## `trySend` report "nothing now" (`WouldBlock`) and the loop moves on. Bytes the kernel will not take yet
## stay in the client's own buffer (src/server/net/java/javamod.aowl) and go out on a later pass.
##
## aowlmony's `std/nativesocket.aowl` is type scaffolding only - no actual
## `socket`/`bind`/`listen`/`accept`/`send`/`recv` syscalls are wired up
## (confirmed by reading it: just `Port`/`Domain`/`SockType`/`Protocol`
## enums, nothing else), and `std/net` doesn't exist in aowlmony's lib at
## all (`file not found: std\net.aowl`). Real listening sockets therefore
## need direct C FFI. This is scoped to exactly what `src/main.aowl` needs
## for a real accept/recv/send loop on Windows (this port's only dev
## target so far) - not a portable sockets abstraction. A POSIX variant
## (`<sys/socket.h>`) would be a straightforward sibling file if/when this
## ports to Linux, following the same split `src/nbt/nbt_compress.aowl`
## already documents for its own platform-specific gap.
##
## No `raise`/exceptions anywhere in this file - aowlmony has no
## aowlmony-compatible exception mechanism (see nbtbase.aowl's header for the
## house explanation), so every fallible proc here returns a plain `bool`/
## sentinel `int` instead, matching this port's `XResult`-free, simplest-
## possible convention for FFI wrappers this thin.

const Ws2_32 = "ws2_32.dll"

type
  WSAData = object
    ## Matches the real `WSADATA` layout closely enough: this code never
    ## reads its fields, only passes a big-enough buffer for WSAStartup
    ## to fill in, so padding it generously (real struct is ~400 bytes on
    ## Win64) is sufficient without reproducing every field.
    raw: array[512, byte]

  SocketHandle* = distinct int

  SockAddrIn = object
    ## Matches the real `struct sockaddr_in` layout (Win32/Win64: no
    ## padding differences for this shape).
    sin_family: int16
    sin_port: uint16
    sin_addr: uint32
    sin_zero: array[8, byte]

const
  AfInet = cint(2)
  SockStream = cint(1)
  IpprotoTcp = cint(6)
  InvalidSocket* = SocketHandle(-1)
  SocketErrorC = cint(-1)
  SolSocket = cint(0xFFFF)
  SoReuseAddr = cint(4)

proc wsaStartup(wVersionRequested: uint16, lpWSAData: ptr WSAData): cint
  {.stdcall, importc: "WSAStartup", dynlib: Ws2_32.}

proc wsaCleanup(): cint {.stdcall, importc: "WSACleanup", dynlib: Ws2_32.}

proc cSocket(domain, typ, protocol: cint): SocketHandle
  {.stdcall, importc: "socket", dynlib: Ws2_32.}

proc cBind(s: SocketHandle, name: ptr SockAddrIn, namelen: cint): cint
  {.stdcall, importc: "bind", dynlib: Ws2_32.}

proc cListen(s: SocketHandle, backlog: cint): cint
  {.stdcall, importc: "listen", dynlib: Ws2_32.}

proc cAccept(s: SocketHandle, address: pointer, addrlen: pointer): SocketHandle
  {.stdcall, importc: "accept", dynlib: Ws2_32.}

proc cRecv(s: SocketHandle, buf: pointer, len: cint, flags: cint): cint
  {.stdcall, importc: "recv", dynlib: Ws2_32.}

proc cSend(s: SocketHandle, buf: pointer, len: cint, flags: cint): cint
  {.stdcall, importc: "send", dynlib: Ws2_32.}

proc cCloseSocket(s: SocketHandle): cint
  {.stdcall, importc: "closesocket", dynlib: Ws2_32.}

proc cRecvFrom(s: SocketHandle, buf: pointer, len: cint, flags: cint, fromAddr: ptr SockAddrIn, fromLen: ptr cint): cint
  {.stdcall, importc: "recvfrom", dynlib: Ws2_32.}

proc cSendTo(s: SocketHandle, buf: pointer, len: cint, flags: cint, toAddr: ptr SockAddrIn, toLen: cint): cint
  {.stdcall, importc: "sendto", dynlib: Ws2_32.}

proc cGetSockName(s: SocketHandle, name: ptr SockAddrIn, namelen: ptr cint): cint
  {.stdcall, importc: "getsockname", dynlib: Ws2_32.}

proc cGetPeerName(s: SocketHandle, name: ptr SockAddrIn, namelen: ptr cint): cint
  {.stdcall, importc: "getpeername", dynlib: Ws2_32.}

proc htons(hostshort: uint16): uint16 {.stdcall, importc: "htons", dynlib: Ws2_32.}

proc setsockoptInt(s: SocketHandle, level, optname: cint, optval: ptr cint, optlen: cint): cint
  {.stdcall, importc: "setsockopt", dynlib: Ws2_32.}

proc initWinsock*(): bool =
  ## false means WSAStartup failed - caller should bail out, there's no
  ## socket API to use at all.
  var wsa: WSAData = WSAData()
  let r = wsaStartup(uint16(0x0202), addr wsa) # MAKEWORD(2,2)
  r == 0

proc shutdownWinsock*() =
  discard wsaCleanup()

proc listenOnAddr*(ip: uint32, port: uint16, backlog: cint = cint(128)): SocketHandle =
  ## Returns `InvalidSocket` on any failure (socket/bind/listen) - caller
  ## checks with `int(result) == int(InvalidSocket)`. `ip` is in network byte order, 0 for any.
  result = cSocket(AfInet, SockStream, IpprotoTcp)
  if int(result) == int(InvalidSocket):
    return InvalidSocket
  var reuse: cint = cint(1)
  discard setsockoptInt(result, SolSocket, SoReuseAddr, addr reuse, cint(sizeof(cint)))
  var addr4: SockAddrIn = SockAddrIn()
  addr4.sin_family = int16(AfInet)
  addr4.sin_port = htons(port)
  addr4.sin_addr = ip
  let bindRes = cBind(result, addr addr4, cint(sizeof(SockAddrIn)))
  if bindRes == SocketErrorC:
    discard cCloseSocket(result)
    return InvalidSocket
  let listenRes = cListen(result, backlog)
  if listenRes == SocketErrorC:
    discard cCloseSocket(result)
    return InvalidSocket

proc listenOn*(port: uint16, backlog: cint = cint(128)): SocketHandle =
  listenOnAddr(0'u32, port, backlog)

proc acceptClient*(listener: SocketHandle): SocketHandle =
  ## Returns `InvalidSocket` on failure.
  cAccept(listener, cast[pointer](0), cast[pointer](0))

proc recvByte*(s: SocketHandle): int =
  ## Returns the byte read (0..255), or -1 on orderly close/error.
  var b: byte = 0'u8
  let n = cRecv(s, addr b, cint(1), cint(0))
  if n != cint(1):
    return -1
  int(b)

proc recvInto*(s: SocketHandle, buf: var seq[byte], count: int): int =
  ## Reads up to `count` bytes into `buf[0..<count]`. Returns bytes read
  ## (0 means orderly close), <0 on error.
  if count == 0:
    return 0
  int(cRecv(s, addr buf[0], cint(count), cint(0)))

proc sendAll*(s: SocketHandle, data: seq[byte]): bool =
  ## Returns false if `send()` failed partway through.
  if data.len == 0:
    return true
  var sent = 0
  while sent < data.len:
    let n = cSend(s, unsafeAddr data[sent], cint(data.len - sent), cint(0))
    if n <= cint(0):
      return false
    sent += int(n)
  true

proc closeClient*(s: SocketHandle) =
  discard cCloseSocket(s)

# --- Non-blocking use; see the design note at the top ----------------------------------------------

const
  Fionbio = 0x8004667E'u32           ## FIONBIO, as `ioctlsocket` takes it.
  WsaEWouldBlock = cint(10035)
  TcpNoDelay = cint(1)
  WouldBlock* = -1                   ## `tryRecv`/`trySend`: nothing can move right now.
  SocketClosed* = -2                 ## `tryRecv`/`trySend`: the peer is gone or the socket failed.

proc ioctlSocket(s: SocketHandle, cmd: uint32, argp: ptr uint32): cint
  {.stdcall, importc: "ioctlsocket", dynlib: Ws2_32.}

proc wsaGetLastError(): cint {.stdcall, importc: "WSAGetLastError", dynlib: Ws2_32.}

proc winSleep(ms: uint32) {.stdcall, importc: "Sleep", dynlib: "kernel32.dll".}

proc getTickCount64(): uint64 {.stdcall, importc: "GetTickCount64", dynlib: "kernel32.dll".}

proc sleepMs*(ms: int) =
  winSleep(uint32(ms))

proc nowMs*(): int64 =
  ## Milliseconds on a monotonic clock, for keep-alives and the tick loop.
  int64(getTickCount64())

proc queryPerformanceCounter(v: ptr int64): int32 {.stdcall, importc: "QueryPerformanceCounter", dynlib: "kernel32.dll".}
proc queryPerformanceFrequency(v: ptr int64): int32 {.stdcall, importc: "QueryPerformanceFrequency", dynlib: "kernel32.dll".}

var perfFrequency = 0'i64

proc nowNanos*(): int64 =
  ## Nanoseconds on a monotonic clock, for the tick loop's timing: `Instant::now()`. The counter's own tick is far under a
  ## microsecond on Windows, where `nowMs` has the 15 ms or 1 ms granularity of the system timer.
  if perfFrequency == 0'i64:
    discard queryPerformanceFrequency(addr perfFrequency)
    if perfFrequency == 0'i64:
      perfFrequency = 1'i64
  var counter = 0'i64
  discard queryPerformanceCounter(addr counter)
  # Split the division so a counter of many hours does not overflow the multiplication.
  (counter div perfFrequency) * 1_000_000_000'i64 + ((counter mod perfFrequency) * 1_000_000_000'i64) div perfFrequency

proc setNonBlocking*(s: SocketHandle): bool =
  var on = 1'u32
  ioctlSocket(s, Fionbio, addr on) == cint(0)

proc setNoDelay*(s: SocketHandle) =
  ## `set_nodelay(true)`, which upstream's accept does.
  var on: cint = cint(1)
  discard setsockoptInt(s, IpprotoTcp, TcpNoDelay, addr on, cint(sizeof(cint)))

proc listenOnNonBlockingAt*(ip: uint32, port: uint16): SocketHandle =
  result = listenOnAddr(ip, port)
  if int(result) != int(InvalidSocket) and not setNonBlocking(result):
    discard cCloseSocket(result)
    return InvalidSocket

proc listenOnNonBlocking*(port: uint16): SocketHandle =
  result = listenOn(port)
  if int(result) != int(InvalidSocket) and not setNonBlocking(result):
    discard cCloseSocket(result)
    return InvalidSocket

proc tryAccept*(listener: SocketHandle): SocketHandle =
  ## A new non-blocking client, or `InvalidSocket` when none is waiting.
  result = cAccept(listener, cast[pointer](0), cast[pointer](0))
  if int(result) != int(InvalidSocket):
    if not setNonBlocking(result):
      discard cCloseSocket(result)
      return InvalidSocket
    setNoDelay(result)

proc tryRecv*(s: SocketHandle, buf: var seq[byte]): int =
  ## Bytes read into `buf`, `WouldBlock`, or `SocketClosed` (also for an orderly close).
  let n = cRecv(s, addr buf[0], cint(buf.len), cint(0))
  if n > cint(0):
    return int(n)
  if n == cint(0):
    return SocketClosed
  if wsaGetLastError() == WsaEWouldBlock: WouldBlock else: SocketClosed

proc trySend*(s: SocketHandle, data: seq[byte], start: int): int =
  ## Bytes the kernel took from `data[start..]`, `WouldBlock`, or `SocketClosed`.
  let n = cSend(s, unsafeAddr data[start], cint(data.len - start), cint(0))
  if n >= cint(0):
    return int(n)
  if wsaGetLastError() == WsaEWouldBlock: WouldBlock else: SocketClosed

proc peerIp*(s: SocketHandle): string =
  ## The remote IPv4 address in dotted form, "" when the socket has none. For `prevent_proxy_connections` and the logs.
  var peer = SockAddrIn()
  var len = cint(sizeof(SockAddrIn))
  if cGetPeerName(s, addr peer, addr len) != cint(0):
    return ""
  let a = peer.sin_addr   # network byte order: the first octet is the low byte
  $(a and 255'u32) & "." & $((a shr 8) and 255'u32) & "." & $((a shr 16) and 255'u32) & "." & $(a shr 24)

# --- UDP, for the query server and the LAN broadcast -----------------------------------------------------------------

type
  UdpPeer* = object
    ip*: uint32     ## Network byte order, as in `sockaddr_in`.
    port*: uint16   ## Host order.

const
  SockDgram = cint(2)
  IpprotoUdp = cint(17)
  SoBroadcast = cint(0x0020)

proc ipv4*(a, b, c, d: int): uint32 =
  ## The four octets as `sockaddr_in` holds them.
  uint32(a) or (uint32(b) shl 8) or (uint32(c) shl 16) or (uint32(d) shl 24)

proc udpPeer*(a, b, c, d: int; port: uint16): UdpPeer =
  UdpPeer(ip: ipv4(a, b, c, d), port: port)

proc peerText*(p: UdpPeer): string =
  let a = p.ip
  $(a and 255'u32) & "." & $((a shr 8) and 255'u32) & "." & $((a shr 16) and 255'u32) & "." & $(a shr 24)

proc bindUdp*(ip: uint32; port: uint16; broadcast: bool): SocketHandle =
  ## A non-blocking UDP socket bound to `ip:port` (0 is any), `InvalidSocket` on failure.
  result = cSocket(AfInet, SockDgram, IpprotoUdp)
  if int(result) == int(InvalidSocket):
    return InvalidSocket
  var on: cint = cint(1)
  if broadcast:
    discard setsockoptInt(result, SolSocket, SoBroadcast, addr on, cint(sizeof(cint)))
  var addr4: SockAddrIn = SockAddrIn()
  addr4.sin_family = int16(AfInet)
  addr4.sin_port = htons(port)
  addr4.sin_addr = ip
  if cBind(result, addr addr4, cint(sizeof(SockAddrIn))) == SocketErrorC or not setNonBlocking(result):
    discard cCloseSocket(result)
    return InvalidSocket

proc udpLocalPort*(s: SocketHandle): uint16 =
  ## The port a socket bound to port 0 got.
  var local = SockAddrIn()
  var len = cint(sizeof(SockAddrIn))
  if cGetSockName(s, addr local, addr len) != cint(0):
    return 0'u16
  htons(local.sin_port)

proc udpRecv*(s: SocketHandle, buf: var seq[byte], peer: var UdpPeer): int =
  ## Bytes of one datagram, `WouldBlock` when none is waiting, `SocketClosed` on a failure. A datagram longer than `buf`
  ## is cut, as the kernel does.
  var from4 = SockAddrIn()
  var len = cint(sizeof(SockAddrIn))
  let n = cRecvFrom(s, addr buf[0], cint(buf.len), cint(0), addr from4, addr len)
  if n >= cint(0):
    peer = UdpPeer(ip: from4.sin_addr, port: htons(from4.sin_port))
    return int(n)
  let e = wsaGetLastError()
  if e == WsaEWouldBlock:
    return WouldBlock
  if e == cint(10054):   # WSAECONNRESET: an earlier send to a closed port; the socket is fine.
    return WouldBlock
  SocketClosed

proc udpSend*(s: SocketHandle, data: openArray[byte], peer: UdpPeer): bool =
  var to4 = SockAddrIn()
  to4.sin_family = int16(AfInet)
  to4.sin_port = htons(peer.port)
  to4.sin_addr = peer.ip
  if data.len == 0:
    return true
  cSendTo(s, unsafeAddr data[0], cint(data.len), cint(0), addr to4, cint(sizeof(SockAddrIn))) >= cint(0)
