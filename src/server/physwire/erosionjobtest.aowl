## erosionjob: the whole erosion run as one pool job gives exactly the output of the stepwise single-threaded loop, inline and on 3 workers,
## and the apply tick does not depend on the mode. Exit 0 and "ALL PASS" when everything holds.

{.feature: "untyped".}

import std/syncio
import "../../generated/block_properties"
import ../../physics/[erosion, materials]
import ../sim/jobpool
import erosionjob

var failures = 0
var checks = 0

proc check(cond: bool, what: string) =
  inc checks
  if cond:
    echo "  PASS ", what
  else:
    echo "  FAIL ", what
    inc failures

proc sid(name: string): int =
  let b = Block.fromName(name)
  if b == nil:
    return 0
  int(asU16(b.defaultState.id))

proc makeSim(seed, nx, ny, nz: int; wet: float64): ErosionSim =
  var ids = newSeq[int](nx * ny * nz)
  let dirt = sid("dirt")
  let sand = sid("sand")
  let stone = sid("stone")
  var r = uint64(seed) * 6364136223846793005'u64 + 1442695040888963407'u64
  for z in 0 ..< nz:
    for x in 0 ..< nx:
      ids[x + nx * (z + nz * 0)] = stone
      r = r * 6364136223846793005'u64 + 1442695040888963407'u64
      let h = 1 + int((r shr 33) mod 9'u64)
      let st = if ((x + z) mod 3) == 0: sand else: dirt
      for y in 1 .. h:
        if y < ny: ids[x + nx * (z + nz * y)] = st
  var p = defaultErosionParams()
  let sim = newErosionSim(ids, nx, ny, nz, seed, p)
  sim.setUniformWeather(0.0, 0.0, 10.0, wet)
  sim

proc mix(h: var uint64; v: int) =
  h = (h xor uint64(v)) * 1099511628211'u64

proc digest(sim: ErosionSim; steps: int; ops: int64): uint64 =
  let o = drain(sim)
  var h = 1469598103934665603'u64
  mix(h, steps)
  mix(h, int(ops))
  mix(h, o.changes.len)
  for c in o.changes:
    mix(h, c.x); mix(h, c.y); mix(h, c.z); mix(h, c.fromState); mix(h, c.toState)
  mix(h, o.bodies.len)
  for b in o.bodies:
    mix(h, b.ox); mix(h, b.oy); mix(h, b.oz); mix(h, b.cells.len)
  h

const Ops = 20000
const MaxSteps = 40000

proc stepwise(seed: int; wet: float64): (uint64, int, int) =
  let sim = makeSim(seed, 20, 14, 20, wet)
  var steps = 0
  var ops = 0'i64
  while steps < MaxSteps:
    let info = sim.step(Ops)
    ops += int64(info.ops)
    inc steps
    if info.done: break
  let d = digest(sim, steps, ops)
  (d, steps, int(ops))

proc viaJob(pool: JobPool; seed: int; wet: float64): (uint64, int, int) =
  let sim = makeSim(seed, 20, 14, 20, wet)
  let run = newErosionRun(sim, Ops, MaxSteps)
  submitErosionRun(pool, run)
  waitErosionRun(pool, run)
  check(run.ok, "job body did not fail")
  let d = digest(sim, run.steps, run.ops)
  (d, run.steps, int(run.ops))

let inl = newJobPool(1)
let thr = newJobPool(3)
check(inl.workers == 0 and thr.workers == 2, "pools: inline and 2 workers")
prewarmMaterials()
var movedSome = false
for seed in 1 .. 6:
  let wet = if seed mod 2 == 0: 0.8 else: 0.0
  let a = stepwise(seed, wet)
  let b = viaJob(inl, seed, wet)
  let c = viaJob(thr, seed, wet)
  check(a == b, "seed " & $seed & ": inline job equals the stepwise loop (steps " & $a[1] & ", ops " & $a[2] & ")")
  check(a == c, "seed " & $seed & ": worker job equals the stepwise loop")
  if a[2] > 0: movedSome = true
check(movedSome, "the scenes did real work")
check(not erosionApplyDue(2, 5) and erosionApplyDue(5, 5) and erosionApplyDue(1, 0), "apply due at the stepwise finish tick, same in every mode")
# two runs queued back to back on the workers are told apart (distinct slots)
let s1 = makeSim(11, 20, 14, 20, 0.0)
let r1 = newErosionRun(s1, Ops, MaxSteps)
submitErosionRun(thr, r1)
waitErosionRun(thr, r1)
let s2 = makeSim(12, 20, 14, 20, 0.0)
let r2 = newErosionRun(s2, Ops, MaxSteps)
submitErosionRun(thr, r2)
waitErosionRun(thr, r2)
check(r1.ready and r2.ready and thr.failedCount == 0, "consecutive runs reuse the slot cleanly, no failures")
shutdown(thr)
if failures == 0:
  echo "ALL PASS (", checks, " checks)"
else:
  echo "FAILED ", failures, " of ", checks
  quit(1)
