## The seam between the vanilla fire block (block/blocks/fire/fire.aowl) and the physics fire model (firewire.aowl). This file imports
## NOTHING, so the block layer can import it without a cycle; firewire installs the proc. With the setting OFF (the default)
## `gFirePhysOn` is false and the fire block pays one bool test per fire tick and behaves exactly as before.

proc noFireSpread(dim: string; x, y, z: int32; age: int): bool {.nimcall.} = false

var gFirePhysOn*: bool = false     ## true when ANY world runs `physics_fire = on` (set by firewire.aowl)

var gFireSpread*: proc(dim: string; x, y, z: int32; age: int): bool {.nimcall.} = noFireSpread
  ## A fire block at (x, y, z) with this age took its fire tick (it survived the rain / fuel checks). true = the physics model owns the
  ## spreading from here (the vanilla "burn adjacent blocks / spread to air" part is skipped); false = vanilla spreads as usual.
