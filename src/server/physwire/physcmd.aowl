## The commands of the physics wiring (op level 4), thin wrappers over the glue modules so tests and scenarios drive the same code:
##   /climate on|off|status|at|override <vx> <vz>|override off     climatewire.aowl   (setting climate_feed, default off)
##   /fire on|off|status|ignite [x y z]                             firewire.aowl      (setting physics_fire, default off)
##   /erosion run [radius] [seed] [wet]|status|cancel               erosionwire.aowl   (a job you start; never automatic)
##   /explode [x y z] [power]                                       a real explosion at a place (default: under you, power 4); it takes
##                                                                  the blast model path when `/body triggers full` is on for the world

import std/[options, strutils, math]
import ../../util/closureset
import ../../command/[cmderrors, cmdsource, fallbackdispatch, args]
import ../../util/[vector3, permission]
import ../../util/text/[textbase, text, color]
import ../serverbase
import ../world/explosion
import ../body/bodymanager
import climatewire, firewire, erosionwire, physparse

{.feature: "lenientnils".}

const
  Description = "Server physics: climate feed, fire spread, erosion jobs, explosions."
  ArgRest = "args"
  Permission0* = "physics:command.physics"

proc registerPermission*(registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))

proc worldOf(sender: CommandSender; server: nil CommandServer): nil CommandWorld =
  if sender.kind == cskPlayer and sender.player.entity != nil and closureSet(sender.player.entity.getWorld):
    return sender.player.entity.getWorld()
  if server != nil and closureSet(server.getOverworld):
    return server.getOverworld()
  nil

proc runPhys(kind: int; sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var line = ""
  discard findMsg(args, ArgRest, line)
  let parts = line.splitWhitespace()
  let cw = worldOf(sender, server)
  if cw == nil:
    sendMessage(sender, colorNamed(text("No world"), ncRed))
    return cmdSuccess(0'i32)
  let found = worldByDim(cw.dimensionName)
  if found.isNone:
    sendMessage(sender, colorNamed(text("The physics modules have not seen this world yet (no tick ran)."), ncRed))
    return cmdSuccess(0'i32)
  let world = found.get
  let srv = world.server
  var ox = 0
  var oy = 0
  var oz = 0
  if sender.kind == cskPlayer and sender.player.entity != nil and closureSet(sender.player.entity.getPos):
    let p = sender.player.entity.getPos()
    ox = int(floor(p.x))
    oy = int(floor(p.y))
    oz = int(floor(p.z))
  elif closureSet(cw.getSpawnPoint):
    let sp = cw.getSpawnPoint()
    ox = int(sp.x)
    oy = int(sp.y)
    oz = int(sp.z)
  var lines: seq[string] = @[]
  case kind
  of 0:
    lines = climateExec(srv, world, parts)
  of 1:
    lines = fireExec(srv, world, parts, ox, oy, oz)
  of 2:
    lines = erosionExec(srv, world, parts, ox, oy, oz)
  else:
    var x = float64(ox) + 0.5
    var y = float64(oy) - 0.5
    var z = float64(oz) + 0.5
    var power = 4.0
    var okp = true
    if parts.len >= 3:
      if not (parseNumFloat(parts[0], x) and parseNumFloat(parts[1], y) and parseNumFloat(parts[2], z)): okp = false
    if parts.len == 4:
      if not parseNumFloat(parts[3], power): okp = false
    elif parts.len == 1:
      if not parseNumFloat(parts[0], power): okp = false
    elif parts.len == 2 or parts.len > 4:
      okp = false
    if not okp:
      lines.add("Usage: /explode [x y z] [power 0.1..40]")
    if lines.len == 0:
      power = max(0.1, min(40.0, power))
      explode(world, Vector3[float64](x: x, y: y, z: z), float32(power))
      lines.add("Exploded at " & $x & " " & $y & " " & $z & " with power " & $power)
  for l in lines:
    sendMessage(sender, text(l))
  cmdSuccess(1'i32)

proc climateCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  runPhys(0, sender, server, args)

proc fireCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  runPhys(1, sender, server, args)

proc erosionCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  runPhys(2, sender, server, args)

proc explodeCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  runPhys(3, sender, server, args)

proc climateTree*(): CommandTree =
  then(execute(newCommandTree(["climate"], Description), climateCommand), execute(argument(ArgRest, newMsgArgConsumer()), climateCommand))

proc fireTree*(): CommandTree =
  then(execute(newCommandTree(["fire"], Description), fireCommand), execute(argument(ArgRest, newMsgArgConsumer()), fireCommand))

proc erosionTree*(): CommandTree =
  then(execute(newCommandTree(["erosion"], Description), erosionCommand), execute(argument(ArgRest, newMsgArgConsumer()), erosionCommand))

proc explodeTree*(): CommandTree =
  then(execute(newCommandTree(["explode"], Description), explodeCommand), execute(argument(ArgRest, newMsgArgConsumer()), explodeCommand))
