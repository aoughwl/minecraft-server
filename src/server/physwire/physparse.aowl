## Number parsing for the physics commands (no exceptions: the dialect has no ValueError path worth catching).

import ../../command/string_reader

proc parseNumInt*(s: string; v: var int): bool =
  if s.len == 0:
    return false
  var i = 0
  var neg = false
  if s[0] == '-':
    neg = true
    i = 1
  if i >= s.len:
    return false
  var n = 0
  while i < s.len:
    if s[i] < '0' or s[i] > '9' or n > 100000000:
      return false
    n = n * 10 + (ord(s[i]) - ord('0'))
    inc i
  v = if neg: -n else: n
  true

proc parseNumFloat*(s: string; v: var float): bool =
  var d = 0.0
  if not parseF64Checked(s, d):
    return false
  if d != d or d > 1.0e12 or d < -1.0e12:
    return false
  v = d
  true
