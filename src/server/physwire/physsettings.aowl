## Per-world physics feature settings (climate feed, fire physics, ...): one small text file per setting in `<world folder>/aowlmony/`
## (a single word, like physics_triggers.txt), with an environment variable as the default of worlds that have no file:
##   1. `<world folder>/aowlmony/<file>`   (written by the feature's command, so a choice persists),
##   2. the environment variable named by the feature (the launcher's default for worlds without a file),
##   3. the feature's built in default ("off" for every feature here: they change how a real world behaves).
## Values are lowercase words. The first read of a setting is cached per world folder; a write updates the cache.

import std/[tables, strutils, envvars]
import ../../world/[level, worldfs]
import ../serverbase

var gSettingCache = initTable[string, string]()

proc settingRoot(world: World): string =
  world.level.levelFolder.rootFolder

proc settingPath(world: World; file: string): string =
  joinPathW(joinPathW(settingRoot(world), "aowlmony"), file)

proc readSettingFile(world: World; file, envName, fallback: string): string =
  let (st, bytes) = readFileBytes(settingPath(world, file))
  if st == rsOk:
    var t = ""
    for b in bytes:
      t.add(char(b))
    t = t.strip().toLowerAscii()
    if t.len > 0 and t.len < 64:
      return t
  let e = getEnv(envName).strip().toLowerAscii()
  if e.len > 0 and e.len < 64:
    return e
  fallback

proc settingGet*(world: World; file, envName, fallback: string): string =
  ## The setting's current word.
  let key = settingRoot(world) & "|" & file
  if gSettingCache.hasKey(key):
    return gSettingCache.getOrDefault(key, fallback)
  let v = readSettingFile(world, file, envName, fallback)
  gSettingCache[key] = v
  v

proc settingSet*(world: World; file, value: string): bool =
  ## Applies and persists the setting (false when the file could not be written; the session value still changes).
  gSettingCache[settingRoot(world) & "|" & file] = value
  var bytes: seq[byte] = @[]
  for ch in value:
    bytes.add(byte(ord(ch)))
  bytes.add(byte(10))
  discard createDirAllW(joinPathW(settingRoot(world), "aowlmony"))
  writeFileBytes(settingPath(world, file), bytes)

proc settingSource*(world: World; file, envName: string): string =
  let (st, _) = readFileBytes(settingPath(world, file))
  if st == rsOk: "world file"
  elif getEnv(envName).len > 0: envName
  else: "default"
