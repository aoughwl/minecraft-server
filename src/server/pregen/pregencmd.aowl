## The `/pregen` command, over pregen.aowl.
##
##   /pregen start <radius|<n>c> [x z] [dimension]   radius in blocks (Chunky's unit) or chunks with a `c`; centre in blocks,
##                                                   the world spawn when left out; dimension overworld|nether|end
##   /pregen pause|resume|cancel|status [dimension]
##   /pregen go|hold                                 the client's word, as jester-pregen-signal.txt carries it
##   /pregen inflight <n>                            the most chunks asked for at once
##
## Permission level three, like `/plugin`; RCON and the console always pass.

import std/[options, strutils]
import ../../command/[cmdsource, fallbackdispatch, args]
import ../../util/text/textbase, ../../util/text/text
import ../serverbase
import pregen

const
  Names = ["pregen"]
  Description = "Pre-generates the world round a centre, throttled by the client's go/hold word."
  ArgRest = "args"

proc words(line: string): seq[string] =
  result = @[]
  for w in line.split(' '):
    if w.len > 0:
      result.add(w)

proc isInt(s: string): bool =
  if s.len == 0:
    return false
  var i = 0
  if s[0] == '-':
    i = 1
  if i >= s.len:
    return false
  while i < s.len:
    if s[i] < '0' or s[i] > '9':
      return false
    inc i
  true

proc toInt(s: string): int32 =
  var v = 0'i64
  var i = 0
  var neg = false
  if s.len > 0 and s[0] == '-':
    neg = true
    i = 1
  while i < s.len:
    v = v * 10'i64 + int64(ord(s[i]) - ord('0'))
    inc i
  int32(if neg: -v else: v)

proc reply(sender: CommandSender; line: string) =
  sendMessage(sender, text(line))

proc statusLine(a: Active): string =
  let total = totalOf(a)
  let done = finishedCount(a)
  let pct = if total > 0'i64: int(done * 1000'i64 div total) else: 0
  a.task.dimension & ": " & phaseName(a.task.phase) & " " & $done & "/" & $total & " chunks (" & $(pct div 10) & "." & $(pct mod 10) &
    "%), " & $inFlightCount(a) & " in flight, " & $int(chunksPerSecond(a)) & " chunks/s, centre chunk " & $a.task.cx & " " & $a.task.cz &
    ", radius " & $a.task.radius & " chunks" & (if a.stuck > 0'i64: ", " & $a.stuck & " skipped" else: "")

proc dimensionFrom(ws: seq[string]; from0: int): string =
  ## The dimension named in `ws[from0 ..]`; the overworld when none is.
  for i in from0 ..< ws.len:
    let d = dimensionKey(ws[i])
    if d.len > 0:
      return d
  "minecraft:overworld"

proc doStart(sender: CommandSender; ws: seq[string]): CommandResult =
  if ws.len < 2:
    return cmdFailed(text("usage: /pregen start <radius|<n>c> [x z] [dimension]"))
  var radius = 0'i32
  if not parseRadius(ws[1], radius) or radius <= 0'i32:
    return cmdFailed(text("bad radius " & ws[1] & " (blocks, or chunks with a trailing c)"))
  var dimension = "minecraft:overworld"
  var haveCentre = false
  var bx = 0'i32
  var bz = 0'i32
  var i = 2
  while i < ws.len:
    if isInt(ws[i]) and i + 1 < ws.len and isInt(ws[i + 1]) and not haveCentre:
      bx = toInt(ws[i])
      bz = toInt(ws[i + 1])
      haveCentre = true
      i += 2
    else:
      let d = dimensionKey(ws[i])
      if d.len == 0:
        return cmdFailed(text("unknown argument " & ws[i]))
      dimension = d
      inc i
  var cx = bx shr 4
  var cz = bz shr 4
  if not haveCentre:
    let worlds = serverWorlds()
    for w in worlds:
      if w.dimension.minecraftName == dimension:
        cx = w.levelInfo.spawnX shr 4
        cz = w.levelInfo.spawnZ shr 4
  let err = startTask(dimension, cx, cz, radius)
  if err.len > 0:
    return cmdFailed(text(err))
  reply(sender, "pregen started: " & $totalChunks(radius) & " chunks round chunk " & $cx & " " & $cz & " in " & dimension)
  cmdSuccess(1'i32)

proc run(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var line = ""
  discard findMsg(args, ArgRest, line)
  let ws = words(line)
  let sub = if ws.len > 0: ws[0].toLowerAscii() else: "status"
  if sub == "start":
    return doStart(sender, ws)
  if sub == "go" or sub == "hold":
    setRemoteWord(sub)
    reply(sender, "pregen: " & sub)
    return cmdSuccess(1'i32)
  if sub == "inflight":
    if ws.len >= 2 and isInt(ws[1]):
      setMaxInFlight(int(toInt(ws[1])))
    reply(sender, "pregen: at most " & $maxInFlight() & " chunks in flight")
    return cmdSuccess(int32(maxInFlight()))
  if sub == "status":
    let tasks = activeTasks()
    if tasks.len == 0:
      reply(sender, "pregen: nothing running")
      return cmdSuccess(0'i32)
    for a in tasks:
      reply(sender, statusLine(a))
    reply(sender, "pregen: " & (if gateOpen(): "running" else: "held") & " by the client" &
      (if signalWord().len > 0: " (word: " & signalWord() & ")" else: ""))
    return cmdSuccess(int32(tasks.len))
  if sub == "pause" or sub == "resume" or sub == "cancel":
    let dimension = dimensionFrom(ws, 1)
    let ok =
      if sub == "pause": setPhase(dimension, ppPaused)
      elif sub == "resume": setPhase(dimension, ppRunning)
      else: cancelTask(dimension)
    if not ok:
      return cmdFailed(text("pregen: no task to " & sub & " in " & dimension))
    reply(sender, "pregen " & sub & ": " & dimension)
    return cmdSuccess(1'i32)
  cmdFailed(text("usage: /pregen start|pause|resume|cancel|status|go|hold|inflight"))

proc initCommandTree*(): CommandTree =
  then(execute(newCommandTree(Names, Description), run), execute(argument(ArgRest, newMsgArgConsumer()), run))
