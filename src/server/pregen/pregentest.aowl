## Test for pregenstate.aowl: the spiral covers a square exactly once nearest ring first, the task text round-trips and the
## go/hold gate follows mcserver.ps1's watcher.
import std/[syncio, tables]
import pregenstate

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

proc main() =
  # spiral: radius 6 -> 169 distinct chunks inside the square, ring order never decreasing
  var seen = initTable[int64, bool]()
  var lastRing = 0'i32
  for i in 0'i64 ..< totalChunks(6'i32):
    let (dx, dz) = spiralOffset(i)
    check(dx >= -6'i32 and dx <= 6'i32 and dz >= -6'i32 and dz <= 6'i32, "inside the square at " & $i)
    let key = int64(dx + 100'i32) * 1000'i64 + int64(dz + 100'i32)
    check(not seen.hasKey(key), "no repeat at " & $i)
    seen[key] = true
    let ring = max(abs(dx), abs(dz))
    check(ring >= lastRing, "rings nearest first at " & $i)
    lastRing = ring
  check(seen.len == 169, "169 chunks")
  check(spiralOffset(0'i64) == (0'i32, 0'i32), "centre first")
  let (bx, bz) = spiralOffset(totalChunks(300'i32) - 1'i64)
  check(max(abs(bx), abs(bz)) == 300'i32, "last chunk on the outer ring")

  # task text
  var t = PregenTask(dimension: "minecraft:the_nether", cx: -3'i32, cz: 7'i32, radius: 250'i32, resume: 12345'i64, phase: ppPaused)
  var u = PregenTask(dimension: "", cx: 0'i32, cz: 0'i32, radius: 0'i32, resume: 0'i64, phase: ppRunning)
  check(taskFromText(taskToText(t), u), "task parses")
  check(u.dimension == "minecraft:the_nether" and u.cx == -3'i32 and u.cz == 7'i32 and u.radius == 250'i32 and
    u.resume == 12345'i64 and u.phase == ppPaused, "task round trip")
  check(not taskFromText("garbage", u), "garbage refused")

  # radius and dimension words
  var r = 0'i32
  check(parseRadius("4096", r) and r == 256'i32, "4096 blocks is 256 chunks")
  check(parseRadius("100", r) and r == 7'i32, "100 blocks rounds up to 7 chunks")
  check(parseRadius("12c", r) and r == 12'i32, "12c is 12 chunks")
  check(not parseRadius("x", r), "bad radius")
  check(dimensionKey("nether") == "minecraft:the_nether" and dimensionKey("minecraft:overworld") == "minecraft:overworld" and
    dimensionKey("end") == "minecraft:the_end" and dimensionKey("3") == "", "dimension words")

  # gate
  var g = newGate()
  check(gateStep(g, "", 0'i64, 0, 0'i64), "nobody online: runs")
  check(not gateStep(g, "", 0'i64, 1, 100'i64), "a login holds")
  check(not gateStep(g, "hold", 1'i64, 1, 120'i64), "hold holds")
  check(gateStep(g, "go", 2'i64, 1, 200'i64), "go after the login releases")
  check(not gateStep(g, "hold", 3'i64, 1, 300'i64), "a new hold holds again")
  check(gateStep(g, "hold", 3'i64, 1, 300'i64 + HoldFallbackTicks), "a standing hold times out")
  check(gateStep(g, "hold", 3'i64, 1, 300'i64 + HoldFallbackTicks + 20'i64), "and is not re-held by the same word")
  check(not gateStep(g, "hold", 4'i64, 1, 300'i64 + HoldFallbackTicks + 40'i64), "a rewritten hold holds")
  check(gateStep(g, "hold", 4'i64, 0, 300'i64 + HoldFallbackTicks + 60'i64), "nobody online releases it")
  var h = newGate()
  check(gateStep(h, "go", 1'i64, 0, 0'i64), "go with nobody: runs")
  check(not gateStep(h, "go", 1'i64, 1, 10'i64), "a go from before the login does not count")
  check(gateStep(h, "go", 1'i64, 1, 10'i64 + FallbackTicks), "no new word: the fallback releases it")
  echo "pregen: ok"

main()
