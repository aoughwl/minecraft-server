## The `/profile` command (op level 4; the console and RCON always pass).
##
##   /profile start [seconds]   begin a session; with seconds it stops by itself
##   /profile stop
##   /profile status            running state and the rolling MSPT/TPS windows
##   /profile report            top scopes by time, per plugin, tick percentiles, slowest ticks
##   /profile export [file]     writes <world>/profiles/<file>.json (default profile-<n>.json)

import std/[strutils]
import ../../command/[cmdsource, fallbackdispatch, args]
import ../../util/[permission]
import ../../util/text/[textbase, text, color]
import ../../world/worldfs
import profiler

const
  Names = ["profile", "profiler"]
  Description = "Server profiler: per-tick section timers, MSPT/TPS windows, tick percentiles."
  ArgRest = "args"
  Permission0* = "profiler:command.profile"
  MaxSeconds = 86400

var exportCounter = 0

proc registerPermission*(registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Four)))

proc say(sender: CommandSender; line: string) =
  sendMessage(sender, text(line))

proc sayOk(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncGreen))

proc sayBad(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncRed))

proc parseNum(s: string; v: var int): bool =
  if s.len == 0 or s.len > 9:
    return false
  var r = 0
  for c in s:
    if c < '0' or c > '9':
      return false
    r = r * 10 + (ord(c) - ord('0'))
  v = r
  true

proc safeFileName(s: string): bool =
  if s.len == 0 or s.len > 60:
    return false
  for c in s:
    if not ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' or c == '.'):
      return false
  s[0] != '.'

proc exportReport(sender: CommandSender; parts: seq[string]) =
  var name = ""
  if parts.len >= 2:
    name = parts[1]
    if name.endsWith(".json"):
      name = name[0 ..< name.len - 5]
  else:
    exportCounter += 1
    name = "profile-" & $exportCounter
  if not safeFileName(name):
    sayBad(sender, "File names are letters, digits, _ - . (60 at most).")
    return
  let folder = profFolder()
  if folder.len == 0:
    sayBad(sender, "The world folder is not known yet; nothing was written.")
    return
  let dir = folder & "/profiles"
  discard createDirAllW(dir)
  let path = dir & "/" & name & ".json"
  let body = profReportJson()
  var bytes = newSeq[byte](body.len)
  for i in 0 ..< body.len:
    bytes[i] = byte(ord(body[i]))
  if writeFileBytes(path, bytes):
    sayOk(sender, "Profile written to " & path & " (" & $bytes.len & " bytes).")
  else:
    sayBad(sender, "Could not write " & path & ".")

proc profileCommand(sender: CommandSender; server: nil CommandServer; args: ConsumedArgs): CommandResult =
  var line = ""
  discard findMsg(args, ArgRest, line)
  let parts = line.splitWhitespace()
  if parts.len == 0:
    say(sender, "/profile start [seconds] | stop | status | report | export [file]")
    return cmdSuccess(0'i32)
  case parts[0]
  of "start":
    var secs = 0
    if parts.len >= 2 and (not parseNum(parts[1], secs) or secs > MaxSeconds):
      sayBad(sender, "Seconds is a number up to " & $MaxSeconds & ".")
      return cmdSuccess(0'i32)
    profStart(secs)
    sayOk(sender, "Profiler started" & (if secs > 0: " for " & $secs & " s" else: " (/profile stop to end)") & ".")
  of "stop":
    if profActive():
      profStop()
      sayOk(sender, "Profiler stopped after " & $profSessionTicks() & " ticks. /profile report shows the result.")
    else:
      sayBad(sender, "The profiler is not running.")
  of "status":
    let lines = profStatusLines()
    for l in lines:
      say(sender, l)
  of "report":
    let lines = profReportLines()
    for l in lines:
      say(sender, l)
  of "export":
    exportReport(sender, parts)
  else:
    sayBad(sender, "Unknown /profile subcommand " & parts[0] & ".")
  cmdSuccess(1'i32)

proc initCommandTree*(): CommandTree =
  then(execute(newCommandTree(Names, Description), profileCommand), execute(argument(ArgRest, newMsgArgConsumer()), profileCommand))
