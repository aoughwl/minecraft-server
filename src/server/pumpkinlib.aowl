## Port of pumpkin/src/lib.rs
## PARTIAL: pumpkin/src/lib.rs - `PumpkinServer` with the Java listener, the tick loop, the console, RCON, the query server, the LAN broadcast and the Bedrock UDP listener (net/bedrock: RakNet, login, resource packs, and the play side in bedrockplay.aowl, which has its own PARTIAL lines). Plugins start in `loadServer` (servermod.aowl). One thread runs everything (no task per client, no generation threads). The listener binds an IPv4 address; an IPv6 one in the config is refused (as RCON and query do).
##
## Upstream runs an accept task, tasks per client, a tick task and chunk generation threads. Here `serverLoop` is all of
## them in turn, on one thread, over non-blocking sockets; see src/server/net/winsock.aowl. Generation is time-sliced: a
## pass of the loop runs at most one stage of one chunk, then goes back to the sockets, so a slow chunk cannot stall a
## keep-alive for longer than that stage. A worker thread is not possible on this data flow: the chunk system shares
## refcounted chunks with the level the handlers read, and refcounts here are not atomic.

import std/[options, syncio]
import commandbridge, serverbase, servermod, ticker
import logging
import ../command/[cmdsource, cmddispatch]
import ../protocol/java/client/play/disconnect
import net/[rcon, queryserver]
import entity/player as playermod
import world/worldmod
import net/java/[dispatch]
import net/[winsock, netbase]
import net/bedrock/[bedrockserver, bedrockplay]
import ../util/text/text

type ConsoleCtrlHandler = proc(ctrlType: uint32): int32 {.stdcall.}

proc setConsoleCtrlHandler(handler: ConsoleCtrlHandler; add: int32): int32
  {.stdcall, importc: "SetConsoleCtrlHandler", dynlib: "kernel32.dll".}

var stopFlag: int32 = 0'i32
  ## Set from the console's handler thread; the loop only reads it. A plain word, so no refcounts cross threads.

proc exitProcess(code: uint32) {.stdcall, importc: "ExitProcess", dynlib: "kernel32.dll".}

proc onConsoleCtrl(ctrlType: uint32): int32 {.stdcall.} =
  ## `handle_interrupt` / `stop_or_exit_server`: the first signal asks the loop to stop and save, a second one while it is
  ## stopping ends the process at once, as upstream's `SERVER_IS_STOPPING` check does.
  if stopFlag != 0'i32:
    exitProcess(0'u32)
  stopFlag = 1'i32
  1'i32

proc installStopHandler*(server: Server) =
  ## `STOP_INTERRUPT`: a console interrupt ends the loop, which then saves.
  discard setConsoleCtrlHandler(onConsoleCtrl, 1'i32)

const
  FlushGraceMs = 2000'i64     ## How long a closed client's queued bytes may take to drain.
  ChunkBudgetMs = 5'i64       ## How long one pass of the loop keeps running the chunk system when there is IO to do.

type
  Connection = ref object
    client: JavaClient
    player: Option[Player]
    closingSince: int64

proc handleLoginResult(conn: Connection; server: Server; res: PacketHandlerResult) =
  ## The `match login_result` of `unified_listener_task`.
  case res.kind
  of phrStop, phrContinue:
    conn.client.close()
  of phrReadyToPlay:
    let (player, world) = server.addPlayer(conn.client, res.profile, res.config)
    # Set the player on the client BEFORE spawning so that chunk sends during spawn_java_player don't get dropped.
    conn.player = some(player)
    conn.client.nextKeepAliveAt = nowMs() + 15000'i64
    spawnJavaPlayer(world, server.basicConfig, player, server)

proc pumpConnection(conn: Connection; server: Server) =
  ## One pass of what upstream's per-client task does between awaits.
  let client = conn.client
  client.pumpSocket()
  client.progressLoginFor(server)
  while true:
    let packet = client.getPacket()
    if packet.isNone:
      break
    let raw = packet.unsafeGet
    if conn.player.isSome:
      let res = client.handlePlayPacket(conn.player.unsafeGet, server, raw)
      if not res.isOk:
        echo "Failed to handle play packet id ", raw.id, " (payload ", raw.payload.len, " bytes): ", res.error.msg
        client.kick(text("Error while handling incoming packet " & res.error.msg))
    else:
      var loginResult = PacketHandlerResult(kind: phrContinue)
      let res = client.handlePacket(server, raw, loginResult)
      if not res.isOk:
        echo "Failed to read incoming packet with id ", raw.id, ": ", res.error.msg
        client.kick(text("Error while reading incoming packet " & res.error.msg))
      elif loginResult.kind != phrContinue:
        handleLoginResult(conn, server, loginResult)
  if conn.player.isSome and not client.isClosed:
    client.progressKeepAlive()
  client.flushOutgoing()

proc finished(conn: Connection; now: int64): bool =
  ## True once a closed client has nothing left to send, or has had its time to drain it.
  if not conn.client.isClosed:
    return false
  if conn.closingSince == 0'i64:
    conn.closingSince = now
  conn.client.gone or not conn.client.hasOutgoing() or now - conn.closingSince > FlushGraceMs

proc queryInfoOf(server: Server): QueryInfo =
  ## What a query answer says: the motd, the counts, the save's name, and up to four players.
  var names: seq[string] = @[]
  for world in server.worlds:
    for p in world.players:
      names.add(p.gameprofile.name)
  QueryInfo(motd: server.advancedConfig.networking.java.motd, maxPlayers: int(server.advancedConfig.networking.java.maxPlayers),
    numPlayers: server.getPlayerCount(), worldName: worldNameOf(server.levelFolder), players: names)

proc bedrockHooksOf(server: Server): BedrockHooks =
  ## What the Bedrock listener asks of the server: `add_player` at the end of the login and `spawn_bedrock_player` when the
  ## resource packs are done, and the play packets (net/bedrock/bedrockplay.aowl).
  bedrockHooks(server)

proc serverLoop*(server: Server; port: uint16; ip: uint32 = 0'u32): bool =
  ## `PumpkinServer::new` and `start`. Returns false when the socket cannot be opened; otherwise when asked to stop.
  if not initWinsock():
    error("WSAStartup failed")
    return false
  let listener = listenOnNonBlockingAt(ip, port)
  if int(listener) == int(InvalidSocket):
    error("Error: Address " & peerText(UdpPeer(ip: ip, port: port)) & ":" & $port & " is already in use, or not available on this machine.")
    error("Make sure another instance of the server isn't already running")
    return false
  let networking = server.advancedConfig.networking
  var rconServer: nil RconServer = nil
  if networking.rcon.enabled:
    warn("RCON is enabled, but it's highly insecure as it transmits passwords and commands in plain text. This makes it vulnerable to interception and exploitation by anyone on the network")
    rconServer = startRcon(networking.rcon)
  var queryServer: nil QueryServer = nil
  var lanBroadcast: nil LanBroadcast = nil
  var bedrockServer: nil BedrockServer = nil
  if networking.bedrock.enabled:
    info("Bedrock Edition is enabled. Starting...")
    let bedrockContext = newBedrockContext(networking.bedrock, server.advancedConfig.resourcePack.bedrock, bedrockHooksOf(server))
    fetchBedrockOidc(bedrockContext)
    bedrockServer = startBedrock(bedrockContext)
  if networking.query.enabled:
    info("Query protocol is enabled. Starting...")
    queryServer = startQuery(networking.query)
  if networking.lanBroadcast.enabled:
    info("LAN broadcast is enabled. Starting...")
    lanBroadcast = startLanBroadcast(networking.lanBroadcast, networking.java.motd, port)
  let rconExec = proc(line: string): seq[string] {.closure.} =
    let buffer = RconBuffer(lines: @[])
    let dispatcher = server.commandDispatcher
    let commandServer = server.commandServer
    if dispatcher != nil and commandServer != nil:
      handleCommand(dispatcher, intoSource(senderRcon(buffer), commandServer), line)
    buffer.lines
  let queryProvide = proc(): QueryInfo {.closure.} = queryInfoOf(server)
  info("Server is now running. Connect using port: \x1b[33mJava Edition:\x1b[0m \x1b[34m" & peerText(UdpPeer(ip: ip, port: port)) &
    ":" & $port & "\x1b[0m")
  stdout.flushFile()
  var connections: seq[Connection] = @[]
  var masterClientIdCounter = 0'u64
  var ticker = newTickerState()
  while not server.stopRequested and stopFlag == 0'i32:
    if server.stopAtMs != 0'i64 and nowMs() >= server.stopAtMs:
      break
    while true:
      let socket = tryAccept(listener)
      if int(socket) == int(InvalidSocket):
        break
      let clientId = masterClientIdCounter
      masterClientIdCounter += 1'u64
      let accepted = newJavaClient(socket, clientId)
      accepted.peerIp = peerIp(socket)
      let formattedAddress = if server.basicConfig.scrubIps: scrubAddress(accepted.peerIp) else: accepted.peerIp
      debug("Accepted connection from Java Edition: " & formattedAddress & " (id " & $clientId & ")")
      connections.add(Connection(client: accepted, player: none[Player](), closingSince: 0'i64))

    for conn in connections:
      pumpConnection(conn, server)
    pumpConsole(server)
    pumpRcon(rconServer, rconExec)
    pumpQuery(queryServer, queryProvide)
    pumpBedrock(bedrockServer, nowMs())
    pumpBedrockPlay()
    pumpLanBroadcast(lanBroadcast)

    if ticker.stepTicker(server):
      for conn in connections:
        conn.client.flushOutgoing()

    let now = nowMs()
    var kept: seq[Connection] = @[]
    for conn in connections:
      if finished(conn, now):
        if conn.player.isSome:
          server.removePlayer(conn.player.unsafeGet)
          conn.player = none[Player]()
        closeClient(conn.client.socket)
      else:
        kept.add(conn)
    connections = kept

    # The chunk system: IO for up to the budget, and at most one generation stage. Its work ends in `chunk_listener`,
    # which the player tick above picks up.
    let budgetEnd = nowMs() + ChunkBudgetMs
    var worked = false
    while nowMs() < budgetEnd:
      if not server.pumpChunkSystems(1):
        break
      worked = true
      if nowMs() >= budgetEnd:
        break

    if not worked:
      sleepMs(1)

  if stopFlag != 0'i32:
    warn("\x1b[31mReceived interrupt signal; stopping server...\x1b[0m")
  info("Stopped accepting incoming connections")
  stopRcon(rconServer)
  stopQuery(queryServer)
  stopBedrock(bedrockServer)
  stopLanBroadcast(lanBroadcast)
  closeClient(listener)
  # Players are told, then removed, which saves each one; upstream saves them all first and then kicks.
  for conn in connections:
    if conn.player.isSome and not conn.client.isClosed:
      conn.client.kick(text("Server stopped"))
  info("Ending player tasks")
  for conn in connections:
    if conn.player.isSome:
      server.removePlayer(conn.player.unsafeGet)
      conn.player = none[Player]()
    conn.client.close()
    conn.client.flushOutgoing()
    closeClient(conn.client.socket)
  info("Starting save.")
  server.shutdown()
  info("Completed save!")
  true
