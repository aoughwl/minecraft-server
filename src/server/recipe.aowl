## Port of pumpkin/src/server/recipe.rs

import ../inventory/recipe_provider
import ../protocol/recipe as protorecipe

export protorecipe, recipe_provider

type
  RecipeManager* = ref object of RecipeProvider
    dynamicRecipes*: seq[DynamicRecipe]

proc getDynamicRecipesOf(self: RecipeProvider): seq[DynamicRecipe] =
  RecipeManager(self).dynamicRecipes

proc newRecipeManager*(): RecipeManager =
  RecipeManager(getDynamicRecipesImpl: getDynamicRecipesOf, dynamicRecipes: @[])

proc addRecipe*(self: RecipeManager; recipe: DynamicRecipe) =
  self.dynamicRecipes.add(recipe)

proc getDynamicRecipesInternal*(self: RecipeManager): seq[DynamicRecipe] =
  self.dynamicRecipes
