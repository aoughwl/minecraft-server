## Port of pumpkin/src/server/scheduler.rs
## PARTIAL: pumpkin/src/server/scheduler.rs - a task is its plugin's handler id with nobody to call it, since plugins are not loaded (src/plugin_runtime). `tick` hands back what is due, for the caller to run once there is one.

import std/[heapqueue, sets]

type
  TaskId* = uint32

  ScheduledTask* = object
    id*: TaskId
    pluginId*: int
    handlerId*: uint32
    nextTick*: uint64
    hasPeriod*: bool
    period*: uint64

  TaskScheduler* = ref object
    tasks: HeapQueue[ScheduledTask]
    cancelledTasks: HashSet[TaskId]
    nextTaskId: uint32

proc `<`*(a, b: ScheduledTask): bool {.inline.} =
  ## Upstream reverses this for its max-heap; `HeapQueue` is a min-heap.
  a.nextTick < b.nextTick

proc newTaskScheduler*(): TaskScheduler =
  TaskScheduler(tasks: initHeapQueue[ScheduledTask](), cancelledTasks: initHashSet[TaskId](), nextTaskId: 0'u32)

proc scheduleDelayedTask*(self: TaskScheduler; pluginId: int; handlerId: uint32; delay, currentTick: uint64): TaskId =
  result = self.nextTaskId
  self.nextTaskId += 1'u32
  self.tasks.push(ScheduledTask(id: result, pluginId: pluginId, handlerId: handlerId, nextTick: currentTick + delay,
    hasPeriod: false, period: 0'u64))

proc scheduleRepeatingTask*(self: TaskScheduler; pluginId: int; handlerId: uint32; delay, period, currentTick: uint64): TaskId =
  result = self.nextTaskId
  self.nextTaskId += 1'u32
  self.tasks.push(ScheduledTask(id: result, pluginId: pluginId, handlerId: handlerId, nextTick: currentTick + delay,
    hasPeriod: true, period: period))

proc cancelTask*(self: TaskScheduler; id: TaskId) =
  self.cancelledTasks.incl(id)

proc cancelAllTasks*(self: TaskScheduler; pluginId: int) =
  var kept = initHeapQueue[ScheduledTask]()
  while self.tasks.len > 0:
    let task = self.tasks.pop()
    if task.pluginId == pluginId:
      self.cancelledTasks.incl(task.id)
    kept.push(task)
  self.tasks = kept

proc tick*(self: TaskScheduler; currentTick: uint64): seq[ScheduledTask] =
  ## `TaskScheduler::tick`: what is due, for the caller to run. A repeating task goes back on the heap.
  result = @[]
  while self.tasks.len > 0 and self.tasks[0].nextTick <= currentTick:
    let task = self.tasks.pop()
    if self.cancelledTasks.contains(task.id):
      self.cancelledTasks.excl(task.id)
    else:
      result.add(task)
  for i in 0 ..< result.len:
    if result[i].hasPeriod:
      var again = result[i]
      again.nextTick = currentTick + again.period
      self.tasks.push(again)
