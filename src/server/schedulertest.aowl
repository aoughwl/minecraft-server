## `TaskScheduler`: order, repetition, cancelling.
import std/[assertions, syncio]
import scheduler

let s = newTaskScheduler()
let a = s.scheduleDelayedTask(1, 10'u32, 5'u64, 0'u64)
let b = s.scheduleRepeatingTask(1, 11'u32, 2'u64, 3'u64, 0'u64)
let c = s.scheduleDelayedTask(2, 12'u32, 1'u64, 0'u64)
assert a != b and b != c
assert s.tick(0'u64).len == 0
let first = s.tick(2'u64)
assert first.len == 2 and first[0].handlerId == 12'u32 and first[1].handlerId == 11'u32
s.cancelTask(a)
assert s.tick(4'u64).len == 0, "the cancelled one does not run"
let again = s.tick(5'u64)
assert again.len == 1 and again[0].id == b
s.cancelAllTasks(1)
assert s.tick(100'u64).len == 0
echo "scheduler ok"
