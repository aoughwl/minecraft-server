## Port of pumpkin/src/server/seasonal_events.rs

import std/options
import ../config/fun
import data/banlist_serializer

proc isApril*(): bool =
  ## `is_april`: the first of April, UTC.
  let date = formatBanDate(nowUtcSeconds())
  date.len >= 10 and date[5] == '0' and date[6] == '4' and date[8] == '0' and date[9] == '1'

proc splitWhitespace(s: string): seq[string] =
  result = @[]
  var word = ""
  for c in s:
    if c == ' ' or c == '\t' or c == '\n' or c == '\r':
      if word.len > 0:
        result.add(word)
        word = ""
    else:
      word.add(c)
  if word.len > 0:
    result.add(word)

proc modifyChatMessage*(message: string; fun: FunConfig): Option[string] =
  ## `modify_chat_message`
  if not fun.aprilFools or not isApril():
    return none[string]()
  var words = splitWhitespace(message)
  if words.len == 0:
    return none[string]()
  var state = uint64(nowUtcSeconds()) xor 0x9E3779B97F4A7C15'u64
  var i = words.len - 1
  while i > 0:
    # `words.shuffle`; nothing depends on the sequence.
    state = state xor (state shl 13)
    state = state xor (state shr 7)
    state = state xor (state shl 17)
    let j = int(state mod uint64(i + 1))
    let moved = words[i]
    let other = words[j]
    words[i] = other
    words[j] = moved
    dec i
  var joined = words[0]
  for w in 1 ..< words.len:
    joined.add(' ')
    joined.add(words[w])
  some(joined)
