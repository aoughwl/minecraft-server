## `modify_chat_message`: off unless the config and the date both say so.
import std/[assertions, options, syncio]
import ../config/fun
import seasonal_events

assert modifyChatMessage("a b c", FunConfig(aprilFools: false)).isNone
if not isApril():
  assert modifyChatMessage("a b c", FunConfig(aprilFools: true)).isNone
echo "seasonal ok"
