## The types of pumpkin/src/server/mod.rs, world/mod.rs and entity/player.rs that refer to each other. A Server holds
## worlds, a World holds players and a Player holds its World, and aowlmony types cannot be recursive across
## modules, so they share this one, as nbtbase.aowl does for the NBT crate. The logic is in servermod.aowl,
## world/worldmod.aowl and entity/player.aowl.

import std/[options, tables]
import ../config/lib as configlib
import ../generated/dimension
import ../util/uuid
import ../util/gamemode
import ../util/vector2
import ../util/vector3
import ../world/[level, cylindrical]
from ../world/worldinfo import LevelData
import net/java/javamod

export javamod, dimension, gamemode, vector2, vector3, level, LevelData, cylindrical, configlib, uuid

type
  LevelTime* = object
    ## Port of pumpkin/src/world/time.rs's fields.
    worldAge*: int64
    timeOfDay*: int64

  Weather* = object
    ## Port of pumpkin/src/world/weather.rs's fields, as far as the join reads them.
    raining*: bool
    rainLevel*: float32
    thunderLevel*: float32

  Worldborder* = object
    ## Port of pumpkin/src/world/border.rs's fields, as far as the join reads them.
    centerX*, centerZ*: float64
    oldDiameter*, newDiameter*: float64
    speed*: int64
    portalTeleportBoundary*: int32
    warningBlocks*: int32
    warningTime*: int32

  Abilities* = object
    ## `Abilities` in entity/player.rs.
    invulnerable*, flying*, allowFlying*, creative*: bool
    flySpeed*, walkSpeed*: float32

  ChunkManager* = object
    ## `ChunkManager` in entity/player.rs, holding positions: a chunk is read from the level when its turn comes,
    ## where upstream's chunk system hands over the loaded chunk through `chunk_listener`.
    chunksPerTick*: int
    center*: Vector2[int32]
    viewDistance*: uint8
    chunkSent*: Table[int64, bool]
    chunkQueue*: seq[(int32, Vector2[int32])]  ## (distance, position), nearest first.
    batchesSentSinceAck*: uint8
    lastChunkBatchSentAt*: int64

  Player* = ref object
    client*: JavaClient
    gameprofile*: GameProfile
    config*: PlayerConfig
    world*: World
    entityId*: int32
    gamemode*: GameMode
    previousGamemode*: Option[GameMode]
    pos*: Vector3[float64]
    lastPos*: Vector3[float64]
    velocity*: Vector3[float64]
    yaw*, pitch*: float32
    onGround*: bool
    chunkPos*: Vector2[int32]
    abilities*: Abilities
    hasPlayedBefore*: bool
    teleportIdCount*: int32
    awaitingTeleport*: Option[(int32, Vector3[float64])]
    watchedSection*: Cylindrical
    chunkManager*: ChunkManager
    selectedSlot*: int8
    ping*: uint32
    clientLoaded*: bool
    tabListListed*: bool
    tabListLatency*: int32
    tabListOrder*: int32

  World* = ref object
    level*: Level
    levelInfo*: LevelData
    dimension*: Dimension
    players*: seq[Player]
    seaLevel*: int32
    worldborder*: Worldborder
    levelTime*: LevelTime
    weather*: Weather

  Server* = ref object
    basicConfig*: BasicConfiguration
    advancedConfig*: AdvancedConfiguration
    worlds*: seq[World]
    dimensions*: seq[Dimension]
    tickCounter*: int64
    nextEntityId*: int32
