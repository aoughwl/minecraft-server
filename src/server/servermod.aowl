type
  ServerLoadResult* = object
    ok*: bool
    server*: nil Server
    error*: string

proc intoLevel(advancedConfig: AdvancedConfiguration; levelFolder: string; seed: int64; dim: Dimension): GameLevel =
  ## `into_level`: the nether and the end are folders inside the save, as vanilla lays them out.
  var root = levelFolder
  if dim.minecraftName == THE_NETHER.minecraftName:
    root = joinPathW(levelFolder, "DIM-1")
  elif dim.minecraftName == THE_END.minecraftName:
    root = joinPathW(levelFolder, "DIM1")
  fromRootFolder(advancedConfig.world, root, seed, dim)

proc settingsFor(dim: Dimension): (int32, int32) =
  ## `GenerationSettings::from_dimension`'s sea level and bottom.
  if dim.minecraftName == THE_NETHER.minecraftName:
    (gensettings.NETHER.seaLevel, dim.minY)
  elif dim.minecraftName == THE_END.minecraftName:
    (gensettings.END.seaLevel, dim.minY)
  else:
    (gensettings.OVERWORLD.seaLevel, dim.minY)

proc createWorld*(self: Server; name: string; dim: Dimension): World =
  ## `Server::create_world` (newer tree): a world called `name` inside the save, or the one that is already there. The
  ## plugins' `server.create-world` calls it through `gServerCreateWorldHook`. No `WorldInitEvent` is fired (PARTIAL).
  for w in self.worlds:
    if getWorldName(w) == name and w.dimension.minecraftName == dim.minecraftName:
      return w
  let worldPath = joinPathW(self.levelFolder, name)
  discard createDirAllW(worldPath)
  let info = self.worlds[0].levelInfo
  let level = intoLevel(self.advancedConfig, worldPath, info.worldGenSettings.seed, dim)
  level.worldPortal = worldgenPortal()
  let (seaLevel, minY) = settingsFor(dim)
  let loaded = loadWorld(level, info, dim, seaLevel, minY, self)
  level.worldPortal = worldPortalFor(loaded, level.worldPortal)
  installBlockHooks(loaded)
  discard installDragonFight(loaded)
  self.worlds.add(loaded)
  loaded

proc unloadWorld*(self: Server; name: string): string =
  ## `Server::unload_world`: "" on success, else upstream's error text.
  var idx = -1
  for i in 0 ..< self.worlds.len:
    if idx < 0 and (getWorldName(self.worlds[i]) == name or self.worlds[i].dimension.minecraftName == name):
      idx = i
  if idx < 0:
    return "World '" & name & "' not found"
  if idx == 0:
    return "Cannot unload the primary/default world"
  let target = self.worlds[idx]
  if target.players.len > 0:
    return "Cannot unload world '" & name & "': " & $target.players.len & " players are still in this world"
  worldmod.shutdown(target)
  self.worlds.delete(idx)
  ""

proc saveAll*(self: Server): string =
  ## `Server::save_all`: "" on success. The chunks are flagged for the next save pass (`World::save` here is that flag).
  saveAllPlayers(self)
  if not saveAllAdvancements(self):
    return "Failed to save player advancements"
  var info = self.worlds[0].levelInfo
  info.dayTime = self.worlds[0].levelTime.timeOfDay
  syncLevelExtras(self, info)
  let (ok, err) = writeWorldInfo(info, self.levelFolder)
  if not ok:
    return "Failed to save world info: " & $err
  for w in self.worlds:
    if not saveDimensionData(w, self.levelFolder):
      return "Failed to save the data files of " & w.dimension.minecraftName
  if not saveServerScoreboard(self):
    return "Failed to save scoreboard.dat"
  for w in self.worlds:
    w.saveBlockEntities()
    w.level.shouldSave = true
  ""

proc loadServer*(basicConfig: BasicConfiguration; advancedConfig: AdvancedConfiguration; levelFolder: string): ServerLoadResult =
  ## `Server::new`, reading the worlds from a save; a folder with no level.dat is a new world, as `Level::from_root_folder` makes it.
  var (ok, levelInfo, err) = readWorldInfo(levelFolder)
  if not ok and err.kind == wieInfoNotFound:
    echo "No world at ", levelFolder, ": creating one with seed ", basicConfig.seed.value
    if not createDirAllW(levelFolder):
      return ServerLoadResult(ok: false, server: nil, error: "cannot create " & levelFolder)
    let (written, writeErr) = writeWorldInfo(defaultLevelData(basicConfig.seed.value), levelFolder)
    if not written:
      return ServerLoadResult(ok: false, server: nil, error: "cannot write " & levelFolder & "/level.dat: " & $writeErr)
    (ok, levelInfo, err) = readWorldInfo(levelFolder)
  if not ok:
    return ServerLoadResult(ok: false, server: nil, error: "cannot read " & levelFolder & ": " & $err)
  var dimensions = @[OVERWORLD]
  if basicConfig.allowNether:
    dimensions.add(THE_NETHER)
  if basicConfig.allowEnd:
    dimensions.add(THE_END)
  let server = Server(basicConfig: basicConfig, advancedConfig: advancedConfig, worlds: @[], dimensions: dimensions,
    tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(basicConfig.tps), keyStore: nil,
    recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: loadServerData(DataFolder),
    playerDataStorage: newPlayerDataStorage(joinPathW(levelFolder, "playerdata"), advancedConfig.playerData.savePlayerData),
    levelFolder: levelFolder, playerIdleTimeout: 0'i32, mojangPublicKeys: @[], favicon: loadFavicon(basicConfig), authTransport: newWinHttpTransport(), stopRequested: false)
  for dim in dimensions:
    let level = intoLevel(advancedConfig, levelFolder, levelInfo.worldGenSettings.seed, dim)
    # `level.world_portal.store`: upstream's asks the block registry. Until that is here, `worldgenPortal` answers
    # `can_place_at` for what features place; `noOpWorldPortal` would grow trees on stone.
    level.worldPortal = worldgenPortal()
    let (seaLevel, minY) = settingsFor(dim)
    let loaded = loadWorld(level, levelInfo, dim, seaLevel, minY, server)
    applyLevelExtras(loaded, levelInfo)
    loadWorldBorder(loaded, levelFolder)
    level.worldPortal = worldPortalFor(loaded, level.worldPortal)
    installBlockHooks(loaded)
    discard installDragonFight(loaded)
    server.worlds.add(loaded)
  for loaded in server.worlds:
    loadForcedChunks(loaded, levelFolder)
  let java = advancedConfig.networking.java
  if java.onlineMode or java.encryption:
    echo "Creating encryption keys..."
    server.keyStore = newKeyStore()
  installAdvancements(server)
  installEndPortalHook()
  installCommands(server)
  startPlugins(server)
  gServerCreateWorldHook = proc(name: string; dimension: int): int {.closure.} =
    let dim = (if dimension == 1: THE_NETHER elif dimension == 2: THE_END else: OVERWORLD)
    let made = createWorld(server, name, dim)
    var found = 0
    for i in 0 ..< server.worlds.len:
      if server.worlds[i] == made: found = i
    found
  gServerUnloadWorldHook = proc(name: string): string {.closure.} = unloadWorld(server, name)
  gServerSaveAllHook = proc(): string {.closure.} = saveAll(server)
  ServerLoadResult(ok: true, server: server, error: "")

proc getPlayerCount*(self: Server): int =
  result = 0
  for world in self.worlds:
    result += world.players.len

proc broadcastTabListHeaderFooter*(self: Server; header, footer: TextComponent) =
  ## `broadcast_tab_list_header_footer`: every player in every world keeps and is sent the pair.
  for world in self.worlds:
    for player in world.players:
      player.setTabListHeaderFooter(header, footer)

proc hasNPlayers*(self: Server; n: int): bool =
  ## `has_n_players`: stops counting as soon as `n` players were found.
  var count = 0
  for world in self.worlds:
    count += world.players.len
    if count >= n:
      return true
  false

proc forEachPlayer*(self: Server; f: proc(player: Player) {.closure.}) =
  ## `for_each_player`
  for world in self.worlds:
    for player in world.players:
      f(player)

proc getPlayerByUuid*(self: Server; id: Uuid): Option[Player] =
  for world in self.worlds:
    for p in world.players:
      if p.gameprofile.id == id:
        return some(p)
  none[Player]()

proc getPlayerByName*(self: Server; name: string): Option[Player] =
  for world in self.worlds:
    for p in world.players:
      if p.gameprofile.name == name:
        return some(p)
  none[Player]()

proc getStatus*(self: Server): StatusResponse =
  ## `get_status`, built per request; see connection_cache.aowl.
  var sample: seq[Sample] = @[]
  for world in self.worlds:
    for p in world.players:
      if sample.len < MaxSamplePlayers:
        sample.add(Sample(name: p.gameprofile.name, id: $p.gameprofile.id))
  buildStatusResponse(self.advancedConfig.networking.java.motd,
    self.advancedConfig.networking.java.maxPlayers, uint32(self.getPlayerCount()), self.favicon, sample)

proc canNotJoin*(self: Server; profile: GameProfile; address: string): Option[TextComponent] =
  ## `can_not_join` from pumpkin/src/net/mod.rs; `address` is the client's IP as text (`JavaClient.peerIp`).
  let banned = self.data.bannedPlayerList.getEntry(profile.id)
  if banned.isSome:
    let entry = banned.unsafeGet
    let reason = translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_REASON, tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_REASON,
      [text(entry.reason)])
    if entry.expires != NoExpiry:
      return some(reason.addChild(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_EXPIRATION,
        tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_EXPIRATION, [text(formatBanDate(entry.expires))])))
    return some(reason)
  if self.basicConfig.whiteList:
    if self.data.operatorConfig.getEntry(profile.id).isNone and not self.data.whitelistConfig.isWhitelisted(profile.id):
      return some(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_NOT_WHITELISTED, tr.JAVA_MULTIPLAYER_DISCONNECT_NOT_WHITELISTED))
  let bannedIp = self.data.bannedIpList.getEntry(address)
  if bannedIp.isSome:
    let entry = bannedIp.unsafeGet
    let reason = translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_IP_REASON,
      tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_IP_REASON, [text(entry.reason)])
    if entry.expires != NoExpiry:
      return some(reason.addChild(translateCross(tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_IP_EXPIRATION,
        tr.JAVA_MULTIPLAYER_DISCONNECT_BANNED_IP_EXPIRATION, [text(formatBanDate(entry.expires))])))
    return some(reason)
  none[TextComponent]()

proc getWorldFromDimension*(self: Server; dimension: Dimension): World =
  ## `get_world_from_dimension`: falls back to the overworld, for a dimension that is switched off.
  for world in self.worlds:
    if world.dimension.minecraftName == dimension.minecraftName:
      return world
  self.worlds[0]

proc addPlayer*(self: Server; client: JavaClient; profile: GameProfile; config: PlayerConfig): (Player, World) =
  ## `add_player`
  var world = self.worlds[0]
  let loaded = loadData(self, profile.id)
  if loaded.isSome:
    let dimensionKey = loaded.unsafeGet.getString("Dimension")
    if dimensionKey.isSome:
      let (known, dimension) = dimensionFromName(dimensionKey.unsafeGet)
      if known:
        world = self.getWorldFromDimension(dimension)
      else:
        echo "Invalid dimension key in player data: ", dimensionKey.unsafeGet
  let entityId = self.nextEntityId
  self.nextEntityId = entityId + 1'i32
  let player = newPlayer(client, profile, config, world, self, self.basicConfig.defaultGamemode, entityId)
  if loaded.isSome:
    player.readNbt(loaded.unsafeGet)
  joinAdvancements(self, player)
  player.screenHandlerSyncHandler.storePlayer(player.asInventoryPlayer())
  # `PlayerLoginEvent`: a cancel kicks the client with the plugins' message; the player is still added so the disconnect
  # runs the normal leave path (upstream returns `None` before `add_player`).
  var loginEv = newPlayerLoginEvent(player, text("You have been kicked from the server"))
  firePlayerLogin(loginEv)
  if loginEv.cancelled:
    javamod.kick(client, loginEv.kickMessage)
  worldmod.addPlayer(world, player)
  firePlayerJoin(player)
  self.data.userCache.upsert(profile.id, profile.name)
  (player, world)

proc removePlayer*(self: Server; player: Player) =
  ## `remove_player` and `Player::remove`.
  if player.removed:
    return
  player.removed = true
  player.incrementCustomStat(csLeaveGame, 1'i32)
  handlePlayerLeave(self, player)
  saveAdvancementsOnLeave(self, player)
  gPlayerStats.del(player.entityId)
  firePlayerLeave(player)
  forgetCommandPlayer(player)
  let world = player.world
  worldmod.removePlayer(world, player, true)
  let radialChunks = allChunksWithin(player.watchedSection)
  player.chunkManager.cleanUp(world.level)
  var chunks: seq[(int32, int32)] = @[]
  for chunk in radialChunks:
    chunks.add((chunk.x, chunk.y))
  let toClean = markChunksAsNotWatched(world.level, chunks)
  if toClean.len > 0:
    discard cleanEntityChunks(world.level, toClean)
  let cleaned = cleanMemory(world.level)
  if cleaned.len > 0:
    discard cleanEntityChunks(world.level, cleaned)

proc tickPlayersAndNetwork(self: Server) =
  ## `tick_players_and_network`
  for world in self.worlds:
    world.flushBlockUpdates()
    world.flushSyncedBlockEvents()
    world.tickPlayers(self)

proc tickWorlds(self: Server) =
  ## `tick_worlds`
  runPluginTasks(self.scheduler.tick(uint64(self.tickCounter)))
  for world in self.worlds:
    worldmod.tick(world, self)
  tickPlayerData(self)

proc tick*(self: Server) =
  ## `tick`
  self.tickCounter += 1'i64
  if self.tickRateManager.runsNormally() or self.tickRateManager.isSprinting():
    self.tickWorlds()
  else:
    # Always run player and network ticking, even when game is frozen
    self.tickPlayersAndNetwork()

proc pumpChunkSystems*(self: Server; maxGenerationTasks: int): bool =
  ## One pass of every level's chunk system, for the main loop: true while there is work. See pumpkinlib.aowl.
  result = false
  for world in self.worlds:
    if pumpChunkSystem(world.level, maxGenerationTasks):
      result = true

proc shutdown*(self: Server) =
  ## `Server::shutdown`: saves the players, the chunks and the level's data.
  saveAllPlayers(self)
  discard saveAllAdvancements(self)
  for world in self.worlds:
    worldmod.shutdown(world)
  var info = self.worlds[0].levelInfo
  info.dayTime = self.worlds[0].levelTime.timeOfDay
  syncLevelExtras(self, info)
  let (ok, err) = writeWorldInfo(info, self.levelFolder)
  if not ok:
    echo "Could not save level.dat: ", $err
  for world in self.worlds:
    if not saveDimensionData(world, self.levelFolder):
      echo "Could not save the data files of ", world.dimension.minecraftName
  if not saveServerScoreboard(self):
    echo "Could not save scoreboard.dat"
