## Port of pumpkin/src/server/mod.rs
## PARTIAL: pumpkin/src/server/mod.rs - construction from a save, `add_player`, `remove_player`, lookups, counts, branding, status and the tick. The overworld only: no nether or end, no plugin manager, command dispatcher, tick-rate manager, recipe or advancement managers, key store, user cache or player data. The types are in serverbase.aowl.

import std/options
import ../protocol/proto
from ../generated/chunk_gen_settings as gensettings import nil
import ../world/worldinfoanvil
import connection_cache
import serverbase
import entity/player as playermod
import world/worldmod

type
  ServerLoadResult* = object
    ok*: bool
    server*: nil Server
    error*: string

proc loadServer*(basicConfig: BasicConfiguration; advancedConfig: AdvancedConfiguration; levelFolder: string): ServerLoadResult =
  ## `Server::new`, reading the one world from an existing save.
  let (ok, levelInfo, err) = readWorldInfo(levelFolder)
  if not ok:
    return ServerLoadResult(ok: false, server: nil, error: "cannot read " & levelFolder & ": " & $err)
  let level = fromRootFolder(advancedConfig.world, levelFolder, levelInfo.worldGenSettings.seed, OVERWORLD)
  let world = loadWorld(level, levelInfo, OVERWORLD, gensettings.OVERWORLD.seaLevel)
  let server = Server(basicConfig: basicConfig, advancedConfig: advancedConfig, worlds: @[world],
    dimensions: @[OVERWORLD, THE_NETHER, THE_END], tickCounter: 0'i64, nextEntityId: 1'i32)
  ServerLoadResult(ok: true, server: server, error: "")

proc getPlayerCount*(self: Server): int =
  result = 0
  for world in self.worlds:
    result += world.players.len

proc getPlayerByUuid*(self: Server; id: Uuid): Option[Player] =
  for world in self.worlds:
    for p in world.players:
      if p.gameprofile.id == id:
        return some(p)
  none[Player]()

proc getPlayerByName*(self: Server; name: string): Option[Player] =
  for world in self.worlds:
    for p in world.players:
      if p.gameprofile.name == name:
        return some(p)
  none[Player]()

proc getStatus*(self: Server): StatusResponse =
  ## `get_status`, built per request; see connection_cache.aowl.
  buildStatusResponse(self.advancedConfig.networking.java.motd,
    self.advancedConfig.networking.java.maxPlayers, uint32(self.getPlayerCount()))

proc addPlayer*(self: Server; client: JavaClient; profile: GameProfile; config: PlayerConfig): (Player, World) =
  ## `add_player`. Saved player data is not read: every join is a first join.
  let world = self.worlds[0]
  let entityId = self.nextEntityId
  self.nextEntityId = entityId + 1'i32
  let player = newPlayer(client, profile, config, world, self.basicConfig.defaultGamemode, entityId)
  worldmod.addPlayer(world, player)
  (player, world)

proc removePlayer*(self: Server; player: Player) =
  worldmod.removePlayer(player.world, player)

proc tick*(self: Server) =
  ## `tick`: both of upstream's halves, since nothing here freezes.
  self.tickCounter += 1'i64
  for world in self.worlds:
    worldmod.tick(world)
