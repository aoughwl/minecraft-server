## Does atomicFetchAdd on an int32 field of a ref object advance the field? (reserveIds regression check)
import std/[atomics, syncio]
type S = ref object
  tick: int64
  nextId: int32
proc reserve(s: S; n: int32): int32 =
  result = atomicFetchAdd(s.nextId, n, moSequentiallyConsistent)
let s = S(tick: 0'i64, nextId: 1'i32)
let a = reserve(s, 1'i32)
let b = reserve(s, 8'i32)
let c = reserve(s, 1'i32)
echo "ids ", a, " ", b, " ", c, " field now ", s.nextId
if a == 1 and b == 2 and c == 10 and s.nextId == 11:
  echo "atomic field ok"
else:
  echo "atomic field BROKEN"
