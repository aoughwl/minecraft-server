## The id-keyed item cooldown table (`itembehaviour.startCooldown/getCooldown/isOnCooldown`), behind one lock. The shield block in
## `entitymod` starts a cooldown from entity damage, which runs in a dimension job, while player ticks of other worlds read the
## table, and `isOnCooldown` deletes. The lock is taken unconditionally (uncontended cost is nil, and the table is not
## on a hot path) and only around the table operation itself: never call out while holding it.
import std/[tables, locks]

type
  ItemCooldown = object
    startTick: int32
    duration: int32

var gCooldownLock: Lock
initLock(gCooldownLock)
var gCooldowns = initTable[string, ItemCooldown]()

proc cooldownStart*(key: string; tick, duration: int32) =
  acquire(gCooldownLock)
  gCooldowns[key] = ItemCooldown(startTick: tick, duration: duration)
  release(gCooldownLock)

proc cooldownRemaining*(key: string; tick: int32): float32 =
  ## 1.0 just after the start down to 0.0 when elapsed; 0.0 when there is no entry.
  acquire(gCooldownLock)
  let c = gCooldowns.getOrDefault(key, ItemCooldown(startTick: 0'i32, duration: 0'i32))
  release(gCooldownLock)
  let elapsed = tick - c.startTick
  result = 0.0'f32
  if elapsed < c.duration:
    result = 1.0'f32 - float32(elapsed) / float32(c.duration)

proc cooldownActive*(key: string; tick: int32): bool =
  ## True while running; an expired entry is removed.
  result = false
  acquire(gCooldownLock)
  if gCooldowns.hasKey(key):
    let c = gCooldowns.getOrDefault(key, ItemCooldown(startTick: 0'i32, duration: 0'i32))
    if tick - c.startTick < c.duration:
      result = true
    else:
      gCooldowns.del(key)
  release(gCooldownLock)

proc cooldownCount*(): int =
  acquire(gCooldownLock)
  result = gCooldowns.len
  release(gCooldownLock)
