## Generic worker job pool, independent of chunk generation (docs/MULTITHREADING.md phase 1).
##
## `newJobPool(threads)`: `threads` counts the tick thread, so there are `threads - 1` workers; with none, `submit` runs the
## job inline (on the caller thread) and the result waits in the owner done queue exactly as a worker result would, so
## callers have one code path. A job is a plain `nimcall` proc over a `pointer` argument returning an `int` (the argument is
## the caller context, e.g. a pointer it keeps alive, or an index into a caller-owned table). Jobs never raise out of the
## worker: every exception is caught and reported as `failed = true`, so the pending count cannot stick.
## Results are only ever applied by the caller, on its own thread, via `drainDone`.
##
## Lanes: `lnUrgent`, `lnNormal`, `lnBackground`, each a FIFO; a worker takes the first job of the lowest-numbered non-empty
## lane, so Background runs only while Urgent and Normal are both empty. `submit` is `submitLane(.., lnNormal, ..)`;
## `laneDepth` counts queued (not yet started) jobs of a lane. Chunk generation (world/chunk_system/generation_executor)
## puts generation and decode jobs on Normal and distant-terrain summaries on Background.
##
## ONE POOL WITH WORKERS PER PROCESS. The worker proc is a `nimcall` with a nil argument and reads the pool from `gJobPool`, so a
## second pool with workers would steal the first one's threads. The decision: the process shares one pool. Chunk generation
## claims it first (`sharedJobPool`); the opt-in users (path, net encode/decode, plugin jobs, region scheduler) either share it
## through `sharedJobPool` or, when they still call `newJobPool` while a pool with workers is live, are REFUSED: they get an inline
## pool (no workers, jobs run at submit) and a line is printed and counted in `refusedPools()`. Callers that share a pool must not
## use owner ids that collide: a shared user takes ids from `allocOwner` (they start far above the small fixed ids the standalone
## users pick), and a handle must only drain its own owner.

{.feature: "lenientnils".}

import std/locks
import std/rawthreads
import std/syncio

const
  lnUrgent* = 0
  lnNormal* = 1
  lnBackground* = 2
  LaneCount* = 3
  FirstAllocatedOwner* = 1073741824   ## `allocOwner` ids start here, clear of the small ids standalone users pick

type
  Job* = proc(arg: pointer): int {.nimcall, raises.}

  JobResult* = object
    arg*: pointer
    value*: int
    failed*: bool

  JobItem = object
    job: Job
    arg: pointer
    owner: int

  DoneItem = object
    owner: int
    res: JobResult

  PoolThread = ref object
    t: RawThread

  JobPool* = ref object
    workers*: int
    lock: Lock
    wake: Cond
    lq: seq[seq[JobItem]]   ## One FIFO per lane.
    lh: seq[int]            ## Per lane: index of the next job to take.
    done: seq[DoneItem]
    pendOwner: seq[int]     ## Owners with submissions, parallel to `pendCount` (sparse: allocated owner ids are huge).
    pendCount: seq[int]     ## Per owner: submitted and not yet drained.
    nextOwner: int
    stopping: bool
    threads: seq[PoolThread]
    reserved*: int          ## Extra workers that take Urgent-lane jobs only (see `addReservedWorkers`).
    submitted*: int
    completed*: int
    failedCount*: int

var gJobPool: JobPool = nil
var gRefused = 0

proc refusedPools*(): int =
  ## How many `newJobPool` calls were refused (turned into inline pools) because a pool with workers was already live.
  gRefused

proc runJob(job: Job, arg: pointer): JobResult =
  result = JobResult(arg: arg, value: 0, failed: false)
  try:
    result.value = job(arg)
  except:
    result.failed = true

proc finish(p: JobPool, owner: int, r: JobResult) =
  ## Caller holds the lock.
  p.done.add(DoneItem(owner: owner, res: r))
  inc p.completed
  if r.failed:
    inc p.failedCount

proc nextLane(p: JobPool): int =
  ## Caller holds the lock. The lowest lane with a queued job, -1 when all are empty.
  result = -1
  for l in 0 ..< LaneCount:
    if p.lh[l] < p.lq[l].len:
      return l

proc workerMain(arg: pointer) {.nimcall.} =
  ## `arg` nil: a general worker. Non-nil: a reserved worker that only ever takes the Urgent lane, so a long Normal job
  ## (chunk generation) on every general worker cannot delay an Urgent job (dimension ticks) by a job's duration.
  let p = gJobPool
  let urgentOnly = arg != nil
  while true:
    acquire(p.lock)
    while (if urgentOnly: p.lh[lnUrgent] >= p.lq[lnUrgent].len else: nextLane(p) < 0) and not p.stopping:
      wait(p.wake, p.lock)
    let l = if urgentOnly: (if p.lh[lnUrgent] < p.lq[lnUrgent].len: lnUrgent else: -1) else: nextLane(p)
    if l < 0:
      release(p.lock)
      return
    let it = p.lq[l][p.lh[l]]
    p.lq[l][p.lh[l]] = JobItem()
    inc p.lh[l]
    if p.lh[l] == p.lq[l].len:
      p.lq[l].setLen(0)
      p.lh[l] = 0
    release(p.lock)
    let r = runJob(it.job, it.arg)
    acquire(p.lock)
    finish(p, it.owner, r)
    release(p.lock)

proc newJobPool*(threads: int): JobPool =
  ## `threads` counts the tick thread. If a pool with workers is already live and this one would have workers, it is refused:
  ## the result is an inline pool (see the header) and the refusal is printed and counted.
  var n = if threads > 1: threads - 1 else: 0
  result = JobPool(workers: 0, lq: newSeq[seq[JobItem]](LaneCount), lh: @[0, 0, 0], done: @[], pendOwner: @[], pendCount: @[], threads: @[],
    nextOwner: FirstAllocatedOwner)
  initLock(result.lock)
  initCond(result.wake)
  if n > 0 and gJobPool != nil and gJobPool.workers > 0:
    inc gRefused
    echo "jobpool: a worker pool is already live; this one runs inline (use sharedJobPool to share it)"
    n = 0
  if n > 0:
    gJobPool = result
    for i in 0 ..< n:
      let w = PoolThread()
      try:
        create(w.t, workerMain, nil)
        result.threads.add(w)
      except:
        break
    result.workers = result.threads.len
    if result.workers == 0:
      gJobPool = nil

proc addReservedWorkers*(p: JobPool, n: int) =
  ## Adds `n` workers that serve the Urgent lane only. Tick thread, before the first Urgent submit. Idle cost is nil (they sleep on
  ## the same condition); they do not take cores from generation because they never run Normal jobs. No-op for an inline pool.
  if p == nil or p.workers == 0:
    return
  for i in 0 ..< n:
    let w = PoolThread()
    try:
      create(w.t, workerMain, cast[pointer](1))
      p.threads.add(w)
      inc p.reserved
    except:
      break

proc sharedJobPool*(threads: int): JobPool =
  ## The process's one worker pool: the live one when there is one (whatever its size), else a new one with `threads - 1` workers.
  if gJobPool != nil and gJobPool.workers > 0:
    return gJobPool
  newJobPool(threads)

proc liveWorkerPool*(): JobPool =
  ## A query, not an accessor: the pool with workers that is live now, or nil. Use `sharedJobPool` to obtain a pool.
  if gJobPool != nil and gJobPool.workers > 0: gJobPool else: nil

proc allocOwner*(p: JobPool): int =
  ## A fresh owner id for a user of a shared pool.
  acquire(p.lock)
  result = p.nextOwner
  inc p.nextOwner
  release(p.lock)

proc pendIndex(p: JobPool, owner: int, create: bool): int =
  ## Caller holds the lock.
  for i in 0 ..< p.pendOwner.len:
    if p.pendOwner[i] == owner:
      return i
  if not create:
    return -1
  p.pendOwner.add(owner)
  p.pendCount.add(0)
  p.pendOwner.len - 1

proc submitLane*(p: JobPool, owner: int, lane: int, job: Job, arg: pointer) =
  ## Queues the job on `lane` (out of range: Normal) for a worker, or runs it now when there are none. Owner thread only.
  if owner < 0:
    return
  let ln = if lane < 0 or lane >= LaneCount: lnNormal else: lane
  acquire(p.lock)
  inc p.pendCount[pendIndex(p, owner, true)]
  inc p.submitted
  if p.workers == 0:
    release(p.lock)
    let r = runJob(job, arg)
    acquire(p.lock)
    finish(p, owner, r)
    release(p.lock)
    return
  p.lq[ln].add(JobItem(job: job, arg: arg, owner: owner))
  let wakeAll = p.reserved > 0 and ln != lnUrgent
  release(p.lock)
  # One condition serves general and Urgent-only workers. A single `signal` for a Normal job can land on a reserved worker, which
  # finds nothing for it and sleeps again: the signal is spent and the job sits queued while every general worker sleeps (hang).
  if wakeAll:
    broadcast(p.wake)
  else:
    signal(p.wake)

proc submit*(p: JobPool, owner: int, job: Job, arg: pointer) =
  ## `submitLane` on the Normal lane.
  submitLane(p, owner, lnNormal, job, arg)

proc laneDepth*(p: JobPool, lane: int): int =
  ## Jobs queued on `lane` and not yet taken by a worker.
  if lane < 0 or lane >= LaneCount:
    return 0
  acquire(p.lock)
  result = p.lq[lane].len - p.lh[lane]
  release(p.lock)

proc drainDone*(p: JobPool, owner: int, sink: var seq[JobResult]): int =
  ## Moves the finished results of `owner` (and only those) into `sink`, in completion order; how many.
  result = 0
  acquire(p.lock)
  var keep: seq[DoneItem] = @[]
  for i in 0 ..< p.done.len:
    if p.done[i].owner == owner:
      sink.add(p.done[i].res)
      inc result
    else:
      keep.add(p.done[i])
  p.done = keep
  let pi = pendIndex(p, owner, false)
  if pi >= 0:
    p.pendCount[pi] -= result
  release(p.lock)

proc pending*(p: JobPool, owner: int): int =
  ## Submitted by `owner` and not yet drained.
  acquire(p.lock)
  let pi = pendIndex(p, owner, false)
  result = if pi >= 0: p.pendCount[pi] else: 0
  release(p.lock)

proc shutdown*(p: JobPool) =
  ## Lets the workers finish every queued job, then joins them. Results stay in the done queues for a last `drainDone`.
  if p.threads.len == 0:
    return
  acquire(p.lock)
  p.stopping = true
  release(p.lock)
  broadcast(p.wake)
  for i in 0 ..< p.threads.len:
    join(p.threads[i].t)
  p.threads.setLen(0)
  p.workers = 0
  if gJobPool == p:
    gJobPool = nil
