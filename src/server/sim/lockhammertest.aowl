## Multi-thread hammer for the locks added in the MULTITHREADING_VARS fixes: the logger lock (logging.log / closeLogger) and the
## item cooldown table (cooldowntable). Run: lockhammertest. Prints "lockhammertest ok" and exits 0 on success.
import std/[assertions, syncio, os, envvars, rawthreads]
from std/paths import path, Path
import std/dirs
import ../../config/logging as logconfig
import ../logging
import cooldowntable

const
  Threads = 6
  Lines = 300
  Keys = 50

proc logWorker(arg: pointer) {.nimcall.} =
  let id = cast[int](arg)
  for i in 0 ..< Lines:
    info("hammer t" & $id & " n" & $i & " end", "hammer")

proc cdWorker(arg: pointer) {.nimcall.} =
  let id = cast[int](arg)
  for i in 0 ..< 2000:
    let key = "k" & $((id * 7 + i) mod Keys)
    cooldownStart(key, int32(i), 10'i32)
    discard cooldownRemaining(key, int32(i + 3))
    discard cooldownActive(key, int32(i + 20))

type Th = ref object
  t: RawThread

proc runThreads(body: proc(arg: pointer) {.nimcall.}) =
  var ts: seq[Th] = @[]
  for i in 0 ..< Threads:
    let h = Th()
    try:
      create(h.t, body, cast[pointer](i + 1))
    except:
      echo "thread start failed"
      quit(2)
    ts.add(h)
  for h in ts:
    join(h.t)

proc slurp(p: string): string =
  result = ""
  try:
    result = readFile(p)
  except ErrorCode:
    assert false, "cannot read " & p

proc main() =
  var base = getEnv("CONFIGTEST_DIR")
  if base.len == 0:
    base = parentDir(getAppFilename())
  let dir = base & "/lockhammer_logs"
  discard tryCreateFinalDir(path(dir))
  if fileExists(dir & "/hammer.log"):
    try:
      removeFile(path(dir & "/hammer.log"))
    except ErrorCode:
      discard
  logDir = dir
  initLogger(LoggingConfig(enabled: true, threads: false, color: false, timestamp: false, file: "hammer.log"))
  runThreads(logWorker)
  closeLogger()
  let text = slurp(dir & "/hammer.log")
  var count = 0
  var start = 0
  var bad = 0
  for i in 0 ..< text.len:
    if text[i] == '\n':
      let line = text[start ..< i]
      inc count
      # every line must be exactly one whole message, never two interleaved
      if not (line.len > 20 and line[0 ..< 15] == "[INFO] hammer t" and line[line.len - 4 ..< line.len] == " end"):
        inc bad
      start = i + 1
  echo "log lines ", count, " bad ", bad
  assert count == Threads * Lines, "lines lost or merged"
  assert bad == 0, "interleaved line"
  runThreads(cdWorker)
  assert cooldownCount() <= Keys
  cooldownStart("solo", 100'i32, 10'i32)
  assert cooldownActive("solo", 105'i32)
  assert cooldownRemaining("solo", 105'i32) == 0.5'f32
  assert not cooldownActive("solo", 110'i32)
  assert not cooldownActive("solo", 111'i32), "expired entry deleted"
  echo "lockhammertest ok"
main()
