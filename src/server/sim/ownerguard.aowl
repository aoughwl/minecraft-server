## Debug owner-thread assertions (docs/MULTITHREADING.md phase 2, section 7).
##
## With `MC_THREAD_ASSERT=1` (read once) a wrong-thread touch of owned state is recorded, never fatal: a count and the first
## `MaxMessages` messages, read back with `violations()`. With guards off every call is one bool check.
##
## Two kinds of owner: the tick thread (`registerTickThread`, `assertOwner`) and a per-world token (`newOwned` / `claim` /
## `assertHeld`) whose owner is the tick thread or one dimension thread, whichever claimed it last.

import std/locks
import std/rawthreads
import std/envvars
import std/atomics

const MaxMessages* = 32

var
  gMode = -1               ## -1 not read yet, 0 off, 1 on
  gTickThread = 0          ## thread id of the tick thread, 0 = none registered
  gLock: Lock
  gLockReady = false
  gCount = 0
  gMessages: seq[string] = @[]

type
  Owned* = ref object
    name*: string
    owner: int             ## owning thread id, 0 = unclaimed

var gInJob {.threadvar.}: bool   ## true while a plugin/pool job body runs on this thread (inline jobs included)

proc currentThreadId*(): int =
  getThreadId()

proc ensureInit() =
  ## Cheap after the first call. Must first run on one thread (the tick thread / main): `guardsEnabled` does that.
  if not gLockReady:
    initLock(gLock)
    gLockReady = true
  if gMode < 0:
    gMode = if getEnv("MC_THREAD_ASSERT") == "1": 1 else: 0

proc guardsEnabled*(): bool =
  if gMode < 0:
    ensureInit()
  gMode == 1

proc setGuards*(on: bool) =
  ## Overrides the environment (tests). Call before threads start.
  ensureInit()
  gMode = if on: 1 else: 0

proc registerTickThread*() =
  ## Marks the calling thread as the tick thread. Always records the id, even with guards off.
  atomicStore(gTickThread, currentThreadId())

proc onTickThread*(): bool =
  ## True if no tick thread is registered yet (nothing to violate) or the caller is it.
  let t = atomicLoad(gTickThread)
  t == 0 or t == currentThreadId()

proc record(msg: string) =
  acquire(gLock)
  inc gCount
  if gMessages.len < MaxMessages:
    gMessages.add(msg)
  release(gLock)

proc enterJob*() =
  gInJob = true

proc leaveJob*() =
  gInJob = false

proc inJob*(): bool =
  gInJob

proc assertOwner*(what: string) =
  ## Records a violation if `what` is touched off the tick thread, or from inside a job body (also when the job ran inline on the tick
  ## thread, so threads=1 finds the same mistakes as threads=N).
  if not guardsEnabled():
    return
  if gInJob:
    record("touched from inside a job: " & what)
    return
  if not onTickThread():
    record("not on tick thread: " & what & " (thread " & $currentThreadId() & ", tick " & $atomicLoad(gTickThread) & ")")

proc violationCount*(): int =
  if not guardsEnabled():
    return 0
  acquire(gLock)
  result = gCount
  release(gLock)

proc violations*(): seq[string] =
  ## The first `MaxMessages` messages.
  if not guardsEnabled():
    return @[]
  acquire(gLock)
  result = gMessages
  release(gLock)

proc resetViolations*() =
  if not guardsEnabled():
    return
  acquire(gLock)
  gCount = 0
  gMessages = @[]
  release(gLock)

proc newOwned*(name: string): Owned =
  Owned(name: name, owner: 0)

proc claim*(o: Owned) =
  ## The calling thread becomes the owner (hand-off between the tick thread and a dimension thread goes through here).
  atomicStore(o.owner, currentThreadId())

proc release*(o: Owned) =
  atomicStore(o.owner, 0)

proc assertHeld*(o: Owned, what: string) =
  ## Records a violation unless the caller owns `o`. An unclaimed token is itself a violation.
  if not guardsEnabled():
    return
  let own = atomicLoad(o.owner)
  let me = currentThreadId()
  if own != me:
    record(o.name & ": " & what & " touched from thread " & $me & ", owner " & (if own == 0: "none" else: $own))
