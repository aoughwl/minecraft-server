## Tests for ownerguard.aowl: ownerguardtest [off]
import std/[assertions, syncio, rawthreads, cmdline]
import ownerguard

var gOwned = newOwned("overworld")
var gDummy = 1
var gNone = 0

proc worker(arg: pointer) {.nimcall.} =
  assertOwner("worker touch")
  if arg == addr gDummy:
    assertHeld(gOwned, "worker world")

proc runWorker(arg: pointer) =
  var t: RawThread
  try:
    create(t, worker, arg)
  except:
    echo "thread start failed"
    quit(2)
  join(t)

proc main() =
  let off = paramCount() >= 1 and paramStr(1) == "off"
  setGuards(not off)
  registerTickThread()
  assert onTickThread()
  assertOwner("main")
  claim(gOwned)
  assertHeld(gOwned, "main world")
  assert violationCount() == 0
  runWorker(addr gNone)
  if off:
    assert violationCount() == 0 and violations().len == 0
    runWorker(addr gDummy)
    assert violationCount() == 0
    echo "off: no violations"
  else:
    assert violationCount() == 1, "worker assertOwner: exactly one"
    let vs = violations()
    assert vs.len == 1
    echo vs[0]
    resetViolations()
    assert violationCount() == 0
    runWorker(addr gDummy)  # assertOwner + assertHeld
    assert violationCount() == 2
    resetViolations()
    echo "on: ok"
main()
