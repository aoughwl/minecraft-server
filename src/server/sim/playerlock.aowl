## One lock for the id-keyed per-player tables (entitymod.gPlayerBases/gExperienceDelays, player.gPlayerStats/gPlayerPoses/
## gPlayerDisplayNames, playerextras tab list/xp tables, breath.gBreaths). Phase 4: with players in more than one world, player ticks
## of different worlds run on different threads and all go through these tables.
##
## Taken only inside a dimension job (tick-thread access is never concurrent with one: the tick thread waits at the barrier), so
## the gate-off path is the plain table access it always was. Rules: hold it only around the table operation itself (never around a
## call that can reach another locked table: the lock is not recursive), and never iterate under it.
import std/locks
import ownerguard

var gPlayerTablesLock: Lock
initLock(gPlayerTablesLock)

proc ptLock*() =
  if inDimJob():
    acquire(gPlayerTablesLock)

proc ptUnlock*() =
  if inDimJob():
    release(gPlayerTablesLock)
