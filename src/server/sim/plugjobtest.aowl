import std/syncio
import jobpool
import threadcfg
import ownerguard
import plugjob

proc sq(n: int): int =
  var s = 0
  for i in 0 ..< 2000:
    s = (s + n * i) mod 1000003
  n * n + s

proc square(arg: pointer): int {.nimcall, raises.} =
  sq(cast[int](arg))

proc boom(arg: pointer): int {.nimcall, raises.} =
  if cast[int](arg) mod 2 == 0:
    raise BadOperation
  cast[int](arg)

proc touchWorld(arg: pointer): int {.nimcall, raises.} =
  assertOwner("fake setBlockState")
  1

var failures = 0
proc check(ok: bool, name: string) =
  if ok:
    echo "PASS " & name
  else:
    echo "FAIL " & name
    inc failures

var got: seq[int] = @[]
var gotTickets: seq[int] = @[]
var failedN = 0
var cbThread = 0

proc onDone(plugin: int, ticket: int, value: int, failed: bool, ctx: pointer) {.nimcall.} =
  got.add(value)
  gotTickets.add(ticket)
  if failed:
    inc failedN
  cbThread = currentThreadId()

proc run(threads: int): seq[int] =
  got = @[]
  gotTickets = @[]
  let plan = planThreads(threads, 0, 8, -1, -1)
  let pj = newPlugJobs(plan)
  let h = registerPlugin(pj)
  for i in 1 .. 300:
    discard submitPlugJob(pj, h, square, cast[pointer](i), onDone, nil)
  check(got.len == 0, "nothing delivered before poll threads=" & $threads)
  var n = 0
  while n < 300:
    n += pollPlugJobs(pj, h)
  var ordered = true
  for i in 0 ..< gotTickets.len:
    if gotTickets[i] != i:
      ordered = false
  check(ordered, "ticket order threads=" & $threads)
  check(pendingPlugJobs(pj, h) == 0, "pending 0 threads=" & $threads)
  check(pj.workers == plan.workers, "workers from plan threads=" & $threads & " " & $pj.workers & " " & $plan.workers)
  shutdownPlugJobs(pj)
  result = got

registerTickThread()
setGuards(true)
let a = run(1)
let b = run(4)
check(a.len == 300 and a == b, "equal results at threads=1 and 4")
check(a[4] == sq(5), "value payload")
check(cbThread == currentThreadId(), "callback on tick thread")

block:
  got = @[]
  let pj = newPlugJobs(planThreads(1, 0, 8, -1, -1))
  let h = registerPlugin(pj)
  discard submitPlugJob(pj, h, square, cast[pointer](7), onDone, nil)
  check(got.len == 0 and pendingPlugJobs(pj, h) == 1, "inline result waits for poll")
  check(pollPlugJobs(pj, h) == 1 and got[0] == sq(7), "inline delivered on poll")

block:
  got = @[]
  failedN = 0
  let pj = newPlugJobs(planThreads(3, 0, 8, -1, -1))
  let h1 = registerPlugin(pj)
  let h2 = registerPlugin(pj)
  for i in 1 .. 20:
    discard submitPlugJob(pj, h1, boom, cast[pointer](i), onDone, nil)
  for i in 1 .. 5:
    discard submitPlugJob(pj, h2, square, cast[pointer](i), onDone, nil)
  shutdownPlugJobs(pj)
  check(pollPlugJobs(pj, h2) == 5, "plugin 2 gets only its 5")
  check(pollPlugJobs(pj, h1) == 20 and failedN == 10, "plugin 1 gets 20, 10 failed")

block:
  resetViolations()
  for t in [1, 3]:
    let pj = newPlugJobs(planThreads(t, 0, 8, -1, -1))
    let h = registerPlugin(pj)
    discard submitPlugJob(pj, h, touchWorld, nil, nil, nil)
    shutdownPlugJobs(pj)
    discard pollPlugJobs(pj, h)
  check(violationCount() >= 2, "job touching tick state flagged in both modes")
  resetViolations()
  assertOwner("tick thread ok")
  check(violationCount() == 0, "tick thread outside job not flagged")

if failures == 0:
  echo "ALL OK"
else:
  echo "FAILURES " & $failures
  quit(1)
