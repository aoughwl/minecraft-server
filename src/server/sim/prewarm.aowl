## Phase 0 of docs/MULTITHREADING.md: fill, on one thread, every lazy and unlocked table before any worker thread exists.
##
## Call `prewarmAll()` early in `runMain`, before `loadServer` builds the first Level (the shared executor starts its workers
## when the first schedule is built). After it the tables are only read.
##
## Materials: `physics/materials.prewarmMaterials()` forces `materialOf` for every state. `loadMaterialOverrides` and
## `clearMaterialOverrides` (packs, /reload) invalidate that table and call it again themselves; only a caller that uses
## `setBlockOverride`/`setTagOverride` directly has to call it after its last override. Never reload while a job that reads
## materials (erosion) is running.

import ../../generated/[block_loot, block_properties, tag, registry]
import ../../physics/materials
import ../../protocol/java/client/play/chunk_data
import ../../util/javaversion
import "../../world/chunk_system/generation_executor"
import ../entity/ai/pathfinder/pathpool
import dimtick, lightjob, netencode, jobpool

proc prewarmAll*() =
  for vi in 0 .. ord(high(JavaMinecraftVersion)):
    let v = JavaMinecraftVersion(vi)
    discard staticRegistries(v)
    discard remapBiomeForVersion(0'u32, v)
    for ki in 0 .. ord(high(RegistryKey)):
      discard getRegistryKeyTags(v, RegistryKey(ki))
  for i in 0 ..< BlockLootCount:
    discard blockLootTable(uint16(i))
  prewarmMaterials()
  prewarmWorldgen()
  # The lazy gate decisions (each also creates the shared worker pool on first call) are taken here, on the tick thread, from the
  # environment: otherwise the first call can land in a dimension job and race on the unsynchronised decision flags.
  discard lightJobsEnabled()
  discard pathJobsEnabled()
  if netEncodeEnabled() and netPool() != nil:
    for kind in 0 .. 2:
      discard netOwner(kind)
  if dimThreadsWanted():
    discard dimPool()
