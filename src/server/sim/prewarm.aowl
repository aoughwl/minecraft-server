## Phase 0 of docs/MULTITHREADING.md: fill, on one thread, every lazy and unlocked table before any worker thread exists.
##
## Call `prewarmAll()` early in `runMain`, before `loadServer` builds the first Level (the shared executor starts its workers
## when the first schedule is built). After it the tables are only read.
##
## Materials: `materialOf` is a cheap call and is warmed here for every state. `loadMaterialOverrides` (packs, /reload) clears
## that table again, so a later reload leaves it lazy until the next tick-thread fill; redo the loop after such a reload.

import ../../generated/[block_loot, block_properties, tag, registry]
import ../../physics/materials
import ../../protocol/java/client/play/chunk_data
import ../../util/javaversion
import "../../world/chunk_system/generation_executor"

proc prewarmMaterials*() =
  ## `materialOf` for every block state.
  for s in 0 ..< int(STATE_COUNT):
    discard materialOf(s)

proc prewarmAll*() =
  for vi in 0 .. ord(high(JavaMinecraftVersion)):
    let v = JavaMinecraftVersion(vi)
    discard staticRegistries(v)
    discard remapBiomeForVersion(0'u32, v)
    for ki in 0 .. ord(high(RegistryKey)):
      discard getRegistryKeyTags(v, RegistryKey(ki))
  for i in 0 ..< BlockLootCount:
    discard blockLootTable(uint16(i))
  prewarmMaterials()
  prewarmWorldgen()
