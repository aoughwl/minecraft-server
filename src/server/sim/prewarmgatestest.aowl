## prewarmAll decides the lazy pool gates (light jobs, net encode, path jobs, dim pool) on the calling thread, so the first
## call from a dimension job never has to. Env opt-ins are set before the call; the pools must exist right after it.
import std/[assertions, syncio, envvars]
import jobpool, lightjob, netencode, prewarm, dimtick
import ../entity/ai/pathfinder/pathpool

proc main() =
  try:
    putEnv("MC_LIGHT_WORKERS", "1")
    putEnv("MC_NET_WORKERS", "1")
    putEnv("MC_PATH_WORKERS", "1")
    putEnv("MC_THREADS", "3")
  except:
    discard
  setDimThreadsWanted(true)
  assert lightPool() == nil and netPool() == nil and pathPool() == nil
  prewarmAll()
  assert lightPool() != nil, "light gate not decided by prewarmAll"
  assert netPool() != nil, "net gate not decided by prewarmAll"
  assert pathPool() != nil, "path gate not decided by prewarmAll"
  assert dimPool() == lightPool(), "one shared pool"
  assert netOwner(0) != netOwner(1)
  echo "prewarmgatestest ok"
main()
