## regions.aowl (non-overlap proved by brute force on random chunk sets) and workbudget.aowl (budget-independent results, fairness).

import std/[assertions, syncio]
import regions
import workbudget

proc cc(x, z: int): ChunkCoord = ChunkCoord(x: x, z: z)

var seed = 12345
proc rnd(n: int): int =
  seed = (seed * 1103515245 + 12345) and 0x7FFFFFFF
  (seed shr 8) mod n

proc cheb(a, b: ChunkCoord): int =
  let dx = if a.x > b.x: a.x - b.x else: b.x - a.x
  let dz = if a.z > b.z: a.z - b.z else: b.z - a.z
  if dx > dz: dx else: dz

# --- planPhases ------------------------------------------------------------------------------------------------------
assert not validTileSize(4, 2) and validTileSize(5, 2) and validTileSize(1, 0)
assert planPhases(@[cc(0, 0)], 4, 2).len == 0, "unsafe parameters give no plan"
assert tileColor(0, 0) == 0 and tileColor(1, 0) == 1 and tileColor(0, 1) == 2 and tileColor(-1, -1) == 3, "parity of negatives"

block random_sets:
  for round in 0 ..< 30:
    var active: seq[ChunkCoord] = @[]
    let n = 40 + rnd(160)
    for i in 0 ..< n:
      active.add cc(rnd(61) - 30, rnd(61) - 30)
    # de-duplicate: a chunk is active once
    var uniq: seq[ChunkCoord] = @[]
    for c in active:
      var dup = false
      for u in uniq:
        if u.x == c.x and u.z == c.z: dup = true
      if not dup: uniq.add c
    let margin = 1 + rnd(3)
    let size = 2 * margin + 1 + rnd(3)
    let phases = planPhases(uniq, size, margin)
    # every chunk appears exactly once
    var seen = 0
    for ph in phases:
      for s in ph.shards:
        seen += s.chunks.len
    assert seen == uniq.len, "each active chunk is in exactly one shard"
    # no two chunks of different shards in one phase are within 2*margin of each other
    for ph in phases:
      for a in 0 ..< ph.shards.len:
        for b in a + 1 ..< ph.shards.len:
          for ca in ph.shards[a].chunks:
            for cb in ph.shards[b].chunks:
              assert cheb(ca, cb) > 2 * margin, "same-phase shards must not touch"
    # sanity that the guarantee is not vacuous: some pair of chunks in different phases IS within 2*margin
    if uniq.len > 100 and margin == 1:
      var closeAcrossPhases = false
      for a in 0 ..< phases.len:
        for b in a + 1 ..< phases.len:
          for sa in phases[a].shards:
            for sb in phases[b].shards:
              for ca in sa.chunks:
                for cb in sb.chunks:
                  if cheb(ca, cb) <= 2: closeAcrossPhases = true
      assert closeAcrossPhases or phases.len < 2

block order_and_determinism:
  let a = planPhases(@[cc(7, 0), cc(-1, -1), cc(0, 0), cc(5, 5), cc(1, 0)], 5, 2)
  let b = planPhases(@[cc(1, 0), cc(5, 5), cc(0, 0), cc(-1, -1), cc(7, 0)], 5, 2)
  assert a.len == b.len
  for i in 0 ..< a.len:
    assert a[i].color == b[i].color and a[i].shards.len == b[i].shards.len
    for j in 0 ..< a[i].shards.len:
      assert a[i].shards[j].chunks.len == b[i].shards[j].chunks.len
      for k in 0 ..< a[i].shards[j].chunks.len:
        assert a[i].shards[j].chunks[k].x == b[i].shards[j].chunks[k].x and a[i].shards[j].chunks[k].z == b[i].shards[j].chunks[k].z
  # (-1,-1) is in tile (-1,-1) colour 3; (0,0),(1,0) tile (0,0) colour 0 with chunks ordered by (z,x); (7,0) tile (1,0) colour 1; (5,5) tile (1,1) colour 3
  assert a.len == 3 and a[0].color == 0 and a[0].shards[0].chunks.len == 2 and a[0].shards[0].chunks[0].x == 0
  assert a[1].color == 1 and a[2].color == 3 and a[2].shards.len == 2 and a[2].shards[0].tileX == -1 and a[2].shards[1].tileX == 1

# --- connectedShards -------------------------------------------------------------------------------------------------
block components:
  let comps = connectedShards(@[cc(0, 0), cc(2, 0), cc(10, 10), cc(4, 0), cc(11, 12), cc(-30, 5)], 2)
  assert comps.len == 3
  assert comps[0].len == 3, "0,2,4 chain through margin 2"
  assert comps[1].len == 2, "10,10 and 11,12"
  assert comps[2].len == 1
  assert connectedShards(@[cc(0, 0), cc(3, 0)], 2).len == 2
  assert connectedShards(@[cc(0, 0), cc(3, 3)], 3).len == 1, "diagonal is Chebyshev"
  assert connectedShards(@[], 2).len == 0

# --- workbudget ------------------------------------------------------------------------------------------------------
var counters: array[4, int]
var order: seq[int] = @[]
proc stepJob(handle: int): bool {.nimcall.} =
  counters[handle] += 1
  order.add handle
  counters[handle] < 10

block budget_independent:
  for budget in [1, 3, 7, 1000]:
    counters = [0, 0, 0, 0]
    order = @[]
    var q = newJobQueue()
    discard q.submit(0, stepJob)
    discard q.submit(1, stepJob)
    discard q.submit(2, stepJob)
    var calls = 0
    var total = 0
    while q.pending() > 0:
      total += q.runBudget(budget)
      inc calls
      assert calls < 1000
    assert counters[0] == 10 and counters[1] == 10 and counters[2] == 10 and counters[3] == 0
    assert total == 30
    assert order.len == 30
    if budget == 1:
      assert calls == 30

block fairness_and_cancel:
  counters = [0, 0, 0, 0]
  order = @[]
  var q = newJobQueue()
  let a = q.submit(0, stepJob)
  let b = q.submit(1, stepJob)
  let c = q.submit(2, stepJob)
  assert q.runBudget(6) == 6
  assert counters[0] == 2 and counters[1] == 2 and counters[2] == 2, "round robin: no job runs twice before the others once"
  assert order == @[0, 1, 2, 0, 1, 2]
  assert q.cancel(b)
  assert not q.cancel(b)
  assert q.pending() == 2
  assert q.runBudget(4) == 4
  assert counters[1] == 2 and counters[0] == 4 and counters[2] == 4
  assert q.runBudget(0) == 0
  var empty = newJobQueue()
  assert empty.runBudget(5) == 0
  discard a
  discard c

echo "sim ok"
