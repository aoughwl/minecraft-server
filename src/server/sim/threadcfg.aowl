## How many worker threads the server may use: a pure function of the configuration, the environment and the machine, so it can be tested
## without threads. docs/MULTITHREADING.md section 5.
##
## `threads` counts every thread that does server work, the tick thread included: 0 = automatic, 1 = everything on the tick thread (no workers, the
## behaviour before threads existed), N = the tick thread plus N - 1 workers. Automatic uses the machine's logical cores minus `reservedCores`
## (cores left to the rest of the machine: the game's own renderer when this is the singleplayer server), never fewer than 1 thread, never more
## than MaxAutoThreads.

const
  MaxAutoThreads* = 16
  MaxThreads* = 64            ## the compiler's processor count covers one Windows processor group

type
  ThreadPlan* = object
    threads*: int             ## total threads including the tick thread (1 = inline)
    workers*: int             ## threads - 1
    why*: string              ## where the number came from, for the start-up line

proc clampThreads(n: int): int =
  if n < 1: 1 elif n > MaxThreads: MaxThreads else: n

proc planThreads*(configThreads, reservedCores, cores, envThreads, envChunkWorkers: int): ThreadPlan =
  ## `envThreads` is MC_THREADS and `envChunkWorkers` is MC_CHUNK_WORKERS (the older knob, workers only); pass -1 when the variable is not set.
  ## Precedence: MC_CHUNK_WORKERS, then MC_THREADS, then the configuration.
  result = ThreadPlan()
  if envChunkWorkers >= 0:
    result.threads = clampThreads(envChunkWorkers + 1)
    result.why = "MC_CHUNK_WORKERS"
  elif envThreads >= 0:
    result.threads = (if envThreads == 0: 0 else: clampThreads(envThreads))
    result.why = "MC_THREADS"
  elif configThreads > 0:
    result.threads = clampThreads(configThreads)
    result.why = "threads in the configuration"
  else:
    result.threads = 0
    result.why = "automatic"
  if result.threads == 0:
    var usable = cores - (if reservedCores > 0: reservedCores else: 0)
    if usable > MaxAutoThreads: usable = MaxAutoThreads
    result.threads = clampThreads(usable)
    result.why = result.why & ": " & $cores & " cores, " & $reservedCores & " reserved"
  result.workers = result.threads - 1
