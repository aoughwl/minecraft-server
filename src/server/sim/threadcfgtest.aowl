## Tests for threadcfg.aowl.

import std/[assertions, syncio]
import threadcfg

# automatic: cores minus the reserve, at least one thread, at most 16
assert planThreads(0, 2, 8, -1, -1).threads == 6 and planThreads(0, 2, 8, -1, -1).workers == 5
assert planThreads(0, 0, 8, -1, -1).threads == 8
assert planThreads(0, 2, 2, -1, -1).threads == 1 and planThreads(0, 2, 2, -1, -1).workers == 0
assert planThreads(0, 2, 1, -1, -1).threads == 1, "never below one thread"
assert planThreads(0, 99, 8, -1, -1).threads == 1, "a reserve larger than the machine"
assert planThreads(0, 0, 64, -1, -1).threads == 16, "automatic is capped"
assert planThreads(0, -3, 4, -1, -1).threads == 4, "a negative reserve counts as none"
# explicit numbers win over the machine
assert planThreads(1, 2, 32, -1, -1).threads == 1 and planThreads(1, 2, 32, -1, -1).workers == 0
assert planThreads(12, 2, 4, -1, -1).threads == 12 and planThreads(12, 2, 4, -1, -1).workers == 11
assert planThreads(500, 0, 4, -1, -1).threads == 64, "explicit is capped by the processor group"
# the environment wins over the configuration: MC_CHUNK_WORKERS counts workers, MC_THREADS counts threads
assert planThreads(8, 2, 16, -1, 4).threads == 5 and planThreads(8, 2, 16, -1, 4).workers == 4
assert planThreads(8, 2, 16, -1, 0).threads == 1 and planThreads(8, 2, 16, -1, 0).workers == 0
assert planThreads(8, 2, 16, 3, -1).threads == 3
assert planThreads(8, 2, 16, 0, -1).threads == 14, "MC_THREADS=0 asks for automatic"
assert planThreads(8, 2, 16, 3, 7).threads == 8, "MC_CHUNK_WORKERS beats MC_THREADS"
# the reason is reported
assert planThreads(0, 2, 8, -1, -1).why == "automatic: 8 cores, 2 reserved"
assert planThreads(5, 2, 8, -1, -1).why == "threads in the configuration"
assert planThreads(5, 2, 8, -1, 2).why == "MC_CHUNK_WORKERS"
echo "threadcfgtest: ok"
