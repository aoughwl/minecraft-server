import std/[syncio, times]
proc ms(): int64 = toUnix(getTime()) * 1000 + int64(nanosecond(getTime()) div 1000000)
var gA {.threadvar.}: bool
var gG: bool = false
proc readTv(): bool = gA
proc readG(): bool = gG
var n = 0
let t0 = ms()
for i in 0 ..< 20_000_000:
  if readTv(): inc n
let t1 = ms()
for i in 0 ..< 20_000_000:
  if readG(): inc n
let t2 = ms()
echo "threadvar 20M reads ms: ", int(t1 - t0), " global ms: ", int(t2 - t1), " ", n
