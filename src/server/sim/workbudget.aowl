## Cooperative, budgeted job queue (phase 3 #16, increment 1): the scheduling half of "async lighting / entity ticking" that needs no
## threads. A job is a non-capturing step proc plus an integer handle (the same no-closure-across-modules rule as
## entity/collision_providers.aowl); each `runBudget` call runs at most `maxSteps` steps over the queued jobs, round-robin, so a
## long relight or a crowd of entities can be spread over many ticks without starving the rest. Results do not depend on the
## budget: only on the order in which a job's own steps run. Pure; the tick loop would call `runBudget` once per tick.
## Real threads are blocked: see docs/DESIGN_16_ASYNC_TICKING.md.

type
  StepProc* = proc(handle: int): bool {.nimcall.}
    ## Does one small slice of work. true: the job has more to do; false: finished (it is then removed).
  Job* = object
    id*: int
    handle*: int
    step*: StepProc
    steps*: int      ## steps run so far
  JobQueue* = object
    jobs*: seq[Job]
    nextId*: int
    cursor*: int     ## round-robin position, persists across calls

proc newJobQueue*(): JobQueue =
  JobQueue(jobs: @[], nextId: 1, cursor: 0)

proc submit*(q: var JobQueue; handle: int; step: StepProc): int =
  let id = q.nextId
  inc q.nextId
  q.jobs.add Job(id: id, handle: handle, step: step, steps: 0)
  id

proc cancel*(q: var JobQueue; id: int): bool =
  for i in 0 ..< q.jobs.len:
    if q.jobs[i].id == id:
      q.jobs.delete(i)
      if q.cursor > i: dec q.cursor
      if q.cursor >= q.jobs.len: q.cursor = 0
      return true
  false

proc pending*(q: JobQueue): int = q.jobs.len

proc runBudget*(q: var JobQueue; maxSteps: int): int =
  ## Runs up to `maxSteps` steps, one job at a time in round-robin order; returns the steps run.
  var ran = 0
  while ran < maxSteps and q.jobs.len > 0:
    if q.cursor >= q.jobs.len:
      q.cursor = 0
    let idx = q.cursor
    let job = q.jobs[idx]
    let more = job.step(job.handle)
    inc ran
    if more:
      q.jobs[idx].steps = job.steps + 1
      q.cursor = idx + 1
    else:
      q.jobs.delete(idx)
      q.cursor = idx
  ran
