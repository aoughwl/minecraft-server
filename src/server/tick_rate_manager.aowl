## Port of pumpkin/src/server/tick_rate_manager.rs
##
## The state and what only reads it. What broadcasts to clients takes the server, which holds this, so it is in
## ticker.aowl: `setTickRate`, `setFrozen`, `stepGameIfPaused`, `stopStepping`, `requestGameToSprint`, `stopSprinting`,
## `finishTickSprint` and `updateJoiningPlayer`.

import net/winsock

const NanosecondsPerSecond = 1_000_000_000'i64

type
  TickRateManager* = ref object
    tickrate*: float32
    nanosecondsPerTick*: int64
    frozenTicksToRun*: int32
    runGameElements*: bool
    isFrozen*: bool
    remainingSprintTicks*: int64
    sprintTickStartMs*: int64
    sprintTimeSpendNanos*: int64
    scheduledCurrentSprintTicks*: int64
    previousIsFrozen*: bool

proc newServerTickRateManager*(tickrate: float32): TickRateManager =
  TickRateManager(tickrate: tickrate, nanosecondsPerTick: NanosecondsPerSecond div int64(tickrate), frozenTicksToRun: 0'i32,
    runGameElements: true, isFrozen: false, remainingSprintTicks: 0'i64, sprintTickStartMs: nowMs(),
    sprintTimeSpendNanos: 0'i64, scheduledCurrentSprintTicks: 0'i64, previousIsFrozen: false)

proc tick*(self: TickRateManager) =
  let frozenTicks = self.frozenTicksToRun
  self.runGameElements = not self.isFrozen or frozenTicks > 0'i32
  if frozenTicks > 0'i32:
    self.frozenTicksToRun -= 1'i32

proc runsNormally*(self: TickRateManager): bool {.inline.} = self.runGameElements
proc isSprinting*(self: TickRateManager): bool {.inline.} = self.remainingSprintTicks > 0'i64
proc isSteppingForward*(self: TickRateManager): bool {.inline.} = self.frozenTicksToRun > 0'i32

proc startSprintTickWork*(self: TickRateManager) =
  self.sprintTickStartMs = nowMs()

proc endSprintTickWork*(self: TickRateManager): bool =
  ## Records the time spent on the sprint tick's work and decrements the remaining sprint ticks. True if the sprint
  ## has just finished.
  self.sprintTimeSpendNanos += (nowMs() - self.sprintTickStartMs) * 1000000'i64
  let before = self.remainingSprintTicks
  self.remainingSprintTicks = before - 1'i64
  before == 1'i64
