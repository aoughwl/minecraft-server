## `ServerTickRateManager`'s state: upstream's rules for freezing and steps.
import std/[assertions, syncio]
import tick_rate_manager

let m = newServerTickRateManager(20.0'f32)
assert m.nanosecondsPerTick == 50000000'i64
m.tick()
assert m.runsNormally()
m.isFrozen = true
m.tick()
assert not m.runsNormally(), "frozen"
m.frozenTicksToRun = 2'i32
assert m.isSteppingForward()
m.tick()
assert m.runsNormally() and m.frozenTicksToRun == 1'i32, "a step runs"
m.tick()
m.tick()
assert not m.runsNormally() and not m.isSteppingForward()
m.remainingSprintTicks = 1'i64
assert m.isSprinting()
m.startSprintTickWork()
assert m.endSprintTickWork(), "the last sprint tick ends it"
assert not m.isSprinting()
echo "tick rate ok"
