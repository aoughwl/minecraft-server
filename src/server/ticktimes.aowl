## Port of the tick time statistics of pumpkin/src/server/mod.rs: `update_tick_times`, `get_average_tick_time_nanos`,
## `get_mspt`, `get_tps` and `get_tick_times_nanos_copy`.
## PARTIAL: pumpkin/src/server/mod.rs - `update_tick_times` does not send `CDebugSample` to players that subscribed; the clock is `nowMs`, so durations are whole milliseconds in nanoseconds.
##
## One server per process, so the state is module-level, as `src/server/ticker.aowl` drives it.

const TickSamples* = 100

var
  tickTimesNanos: seq[int64] = newSeq[int64](TickSamples)
  aggregatedTickTimesNanos: int64 = 0'i64
  tickCount: int64 = 0'i64

proc resetTickTimes*() =
  tickTimesNanos = newSeq[int64](TickSamples)
  aggregatedTickTimesNanos = 0'i64
  tickCount = 0'i64

proc updateTickTimes*(tickDurationNanos: int64) =
  let index = int(tickCount mod int64(TickSamples))
  tickCount += 1'i64
  let oldTime = tickTimesNanos[index]
  tickTimesNanos[index] = tickDurationNanos
  aggregatedTickTimesNanos += tickDurationNanos - oldTime

proc sampleSize*(): int = int(min(tickCount, int64(TickSamples)))

proc getAverageTickTimeNanos*(): int64 =
  let size = sampleSize()
  if size == 0:
    return 0'i64
  aggregatedTickTimesNanos div int64(size)

proc getMspt*(): float64 =
  float64(getAverageTickTimeNanos()) / 1_000_000.0

proc getTps*(): float64 =
  let mspt = getMspt()
  if mspt <= 0.0:
    return 0.0
  1000.0 / mspt

proc getTickTimesNanosCopy*(): seq[int64] =
  ## The filled prefix, `tick_times[..sample_size]`.
  result = @[]
  for i in 0 ..< sampleSize():
    result.add(tickTimesNanos[i])
