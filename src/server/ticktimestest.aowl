## Tick time statistics: the rolling average, the percentile source and TPS.
import std/[assertions, syncio]
import ticktimes

proc run() =
  resetTickTimes()
  assert getAverageTickTimeNanos() == 0'i64 and getTps() == 0.0 and getTickTimesNanosCopy().len == 0
  updateTickTimes(40_000_000'i64)
  updateTickTimes(60_000_000'i64)
  assert getAverageTickTimeNanos() == 50_000_000'i64
  assert getMspt() == 50.0 and getTps() == 20.0
  assert getTickTimesNanosCopy() == @[40_000_000'i64, 60_000_000'i64]
  # wraps after 100: the oldest sample is replaced
  resetTickTimes()
  for i in 0 ..< 100:
    updateTickTimes(10_000_000'i64)
  assert getAverageTickTimeNanos() == 10_000_000'i64
  updateTickTimes(110_000_000'i64)
  assert sampleSize() == 100
  assert getAverageTickTimeNanos() == 11_000_000'i64
  assert getTickTimesNanosCopy()[0] == 110_000_000'i64

run()
echo "ticktimes tests: all checks passed"
