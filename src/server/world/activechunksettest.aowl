## `World.activeChunkSet` (built by `updateActiveChunks`) must answer exactly what the old linear scan of `activeChunks` did.
## Random forced chunk lists (duplicates, negatives, extremes) go through `updateActiveChunks`; every probe is checked against the scan.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../../util/vector2
import ../serverbase
import worldmod

var gSeed: uint64 = 0x9E3779B97F4A7C15'u64

proc nextRand(): uint64 =
  gSeed = gSeed xor (gSeed shl 13)
  gSeed = gSeed xor (gSeed shr 7)
  gSeed = gSeed xor (gSeed shl 17)
  gSeed

proc coord(range: int): int32 =
  int32(int64(nextRand() mod uint64(2 * range + 1)) - int64(range))

proc linear(world: World; x, z: int32): bool =
  result = false
  let p = Vector2[int32](x: x, y: z)
  for c in world.activeChunks:
    if c == p:
      result = true
      break

proc run() =
  var checked = 0
  var hits = 0
  for round in 0 ..< 200:
    let range = if round mod 5 == 0: 2_000_000 elif round mod 2 == 0: 40 else: 6
    let w = World(players: @[], forcedChunks: @[])
    let n = int(nextRand() mod 300'u64)
    for i in 0 ..< n:
      w.forcedChunks.add(Vector2[int32](x: coord(range), y: coord(range)))
    if round == 7:
      w.forcedChunks.add(Vector2[int32](x: -2147483647'i32, y: 2147483647'i32))
      w.forcedChunks.add(Vector2[int32](x: 0'i32, y: -1'i32))
      w.forcedChunks.add(Vector2[int32](x: -1'i32, y: 0'i32))
    w.updateActiveChunks()
    assert w.activeChunkSet.len <= w.activeChunks.len
    # every member is found, and the set holds nothing else
    for c in w.activeChunks:
      assert w.isActiveChunk(c.x, c.y)
    for i in 0 ..< 400:
      let x = coord(range)
      let z = coord(range)
      let a = linear(w, x, z)
      assert a == w.isActiveChunk(x, z)
      inc checked
      if a: inc hits
    # swapped coordinates must not alias
    for c in w.activeChunks:
      assert linear(w, c.y, c.x) == w.isActiveChunk(c.y, c.x)
  assert hits > 0
  echo "activechunkset ok, probes ", checked, " hits ", hits

run()
