## Port of pumpkin/src/world/block_placer.rs
##
## `WorldBlockPlacer`: a template's `BlockPlacer` that writes straight into the world's level (`Level::set_block_state`, with
## no neighbour updates: the caller queues them from `changedPositions`) and keeps the block entities' NBT for `finalize`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/options
import ../../nbt/tag as nbttag
import ../../util/math/position
import ../../util/vector3
import ../../world/blockstates
import ../../world/level
import "../../world/generation/structure/template/processor"
import "../block/blockbehaviour"
import ../serverbase
import worldmod

type
  WorldBlockPlacer* = ref object of BlockPlacer
    world*: nil World
    blockEntityNbts*: seq[NbtCompound]
    changedPositions*: seq[(BlockPos, BlockStateId)]

proc worldPlacerGetState(self: BlockPlacer; pos: Vector3[int32]): BlockStateId {.nimcall.} =
  let p = cast[WorldBlockPlacer](self)
  let w = p.world
  if w == nil:
    return BlockStateId(0)
  BlockStateId(w.getBlockStateId(BlockPos(vec: vec3[int32](pos.x, pos.y, pos.z))))

proc worldPlacerSetState(self: BlockPlacer; pos: Vector3[int32]; state: BlockStateId) {.nimcall.} =
  let p = cast[WorldBlockPlacer](self)
  let blockPos = BlockPos(vec: vec3[int32](pos.x, pos.y, pos.z))
  let w = p.world
  if w != nil:
    discard setBlockState(w.level, blockPos, state)
  p.changedPositions.add((blockPos, state))

proc worldPlacerAddEntity(self: BlockPlacer; nbt: NbtCompound) {.nimcall.} =
  let p = cast[WorldBlockPlacer](self)
  p.blockEntityNbts.add(nbt)

proc newWorldBlockPlacer*(world: nil World): WorldBlockPlacer =
  WorldBlockPlacer(getStateFn: worldPlacerGetState, setStateFn: worldPlacerSetState, addEntityFn: worldPlacerAddEntity,
    world: world, blockEntityNbts: @[], changedPositions: @[])

proc finalize*(self: WorldBlockPlacer) =
  ## Block entities of the placed template, from their NBT, into the world.
  let world = self.world
  if world == nil:
    return
  let w = BlockWorld(world.blockWorld)
  if w == nil or w.blockEntityFromNbt0 == nil:
    return
  for nbt in self.blockEntityNbts:
    let blockEntity = w.blockEntityFromNbt0(nbt)
    if blockEntity.isSome:
      w.addBlockEntity(blockEntity.unsafeGet)
