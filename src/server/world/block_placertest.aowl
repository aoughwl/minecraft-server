## What `WorldBlockPlacer` does through the template's `BlockPlacer` vtable, on a nil world: only the bookkeeping that needs
## no world (the NBT list) can be known here; reads and writes go through the level and are the `/place` command's proof.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../../nbt/tag as nbttag
import "../../world/generation/structure/template/processor"
import block_placer

proc run() =
  let placer = newWorldBlockPlacer(nil)
  let base: BlockPlacer = placer
  var nbt = NbtCompound()
  nbt.putInt("x", 3'i32)
  base.addEntityFn(base, nbt)
  base.addEntityFn(base, nbt)
  assert placer.blockEntityNbts.len == 2
  assert placer.changedPositions.len == 0
  # No block-entity factory in a nil world: finalize does nothing and does not fail.
  placer.finalize()
  echo "block_placer test: ok"

run()
