## Port of pumpkin/src/world/border.rs
##
## The type is in ../serverbase.aowl, since `World` holds it.

import std/math
import ../../protocol/java/client/play/[initialize_world_border, set_border_center, set_border_lerp_size,
  set_border_size, set_border_warning_delay, set_border_warning_distance]
import ../serverbase

proc newWorldborder*(x, z, diameter: float64; speed: int64; warningBlocks, warningTime: int32): Worldborder =
  ## `Worldborder::new`
  Worldborder(centerX: x, centerZ: z, oldDiameter: diameter, newDiameter: diameter, speed: speed,
    portalTeleportBoundary: 29_999_984'i32, warningBlocks: warningBlocks, warningTime: warningTime,
    damagePerBlock: 0.0'f32, buffer: 0.0'f32)

proc initClient*(self: Worldborder; client: JavaClient) =
  client.writePacketFor(CInitializeWorldBorder(x: self.centerX, z: self.centerZ, oldDiameter: self.oldDiameter,
    newDiameter: self.newDiameter, speed: newVarLong(self.speed),
    portalTeleportBoundary: newVarInt(self.portalTeleportBoundary), warningBlocks: newVarInt(self.warningBlocks),
    warningTime: newVarInt(self.warningTime)))

proc setCenter*(self: var Worldborder; world: World; x, z: float64) =
  self.centerX = x
  self.centerZ = z
  world.broadcastPacketAll(CSetBorderCenter(x: self.centerX, z: self.centerZ))

proc setDiameter*(self: var Worldborder; world: World; diameter: float64; hasSpeed: bool; speed: int64) =
  self.oldDiameter = self.newDiameter
  self.newDiameter = diameter
  if hasSpeed:
    world.broadcastPacketAll(CSetBorderLerpSize(oldDiameter: self.oldDiameter, newDiameter: self.newDiameter,
      speed: newVarLong(speed)))
  else:
    world.broadcastPacketAll(CSetBorderSize(diameter: self.newDiameter))

proc addDiameter*(self: var Worldborder; world: World; offset: float64; hasSpeed: bool; speed: int64) =
  self.setDiameter(world, self.newDiameter + offset, hasSpeed, speed)

proc setWarningDelay*(self: var Worldborder; world: World; delay: int32) =
  self.warningTime = delay
  world.broadcastPacketAll(CSetBorderWarningDelay(warningTime: newVarInt(self.warningTime)))

proc setWarningDistance*(self: var Worldborder; world: World; distance: int32) =
  self.warningBlocks = distance
  world.broadcastPacketAll(CSetBorderWarningDistance(warningBlocks: newVarInt(self.warningBlocks)))

proc contains*(self: Worldborder; x, z: float64): bool =
  let half = self.newDiameter / 2.0
  let minX = self.centerX - half
  let maxX = self.centerX + half
  let minZ = self.centerZ - half
  let maxZ = self.centerZ + half
  x >= minX and x < maxX and z >= minZ and z < maxZ

proc containsBlock*(self: Worldborder; x, z: int32): bool =
  self.contains(float64(x), float64(z)) and self.contains(float64(x + 1'i32), float64(z + 1'i32))

proc clampBlock*(self: Worldborder; x, z: int32): (int32, int32) =
  let half = self.newDiameter / 2.0
  let minX = int32(floor(self.centerX - half))
  let maxX = int32(floor(self.centerX + half)) - 1'i32
  let minZ = int32(floor(self.centerZ - half))
  let maxZ = int32(floor(self.centerZ + half)) - 1'i32
  (max(min(x, maxX), minX), max(min(z, maxZ), minZ))

proc reset*(self: var Worldborder; world: World) =
  ## `reset` (newer tree): the defaults of a fresh border, sent to every player.
  self.centerX = 0.0
  self.centerZ = 0.0
  self.oldDiameter = 29_999_984.0
  self.newDiameter = 29_999_984.0
  self.speed = 0
  self.portalTeleportBoundary = 29_999_984'i32
  self.warningBlocks = 5'i32
  self.warningTime = 15'i32
  self.damagePerBlock = 0.2'f32
  self.buffer = 5.0'f32
  world.broadcastPacketAll(CInitializeWorldBorder(x: self.centerX, z: self.centerZ, oldDiameter: self.oldDiameter,
    newDiameter: self.newDiameter, speed: newVarLong(self.speed),
    portalTeleportBoundary: newVarInt(self.portalTeleportBoundary), warningBlocks: newVarInt(self.warningBlocks),
    warningTime: newVarInt(self.warningTime)))
