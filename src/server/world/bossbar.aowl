## Port of pumpkin/src/world/bossbar.rs
##
## The Java half. `to_bedrock` is the Bedrock branch of each method, which has no platform here.

import ../../protocol/java/client/play/[boss_event, bossevent_action]
import ../../util/text/text
import ../serverbase

const
  BossbarFlagDarkenSky* = 0x01'u8
  BossbarFlagDragonBar* = 0x02'u8
  BossbarFlagCreateFog* = 0x04'u8

type
  BossbarColor* = enum
    bcPink
    bcBlue
    bcRed
    bcGreen
    bcYellow
    bcPurple
    bcWhite

  BossbarDivisions* = enum
    bdNoDivision
    bdNotches6
    bdNotches10
    bdNotches12
    bdNotches20

  Bossbar* = object
    uuid*: Uuid
    title*: TextComponent
    health*: float32
    color*: BossbarColor
    division*: BossbarDivisions
    flags*: uint8

proc newBossbar*(title: TextComponent): Bossbar =
  ## `Bossbar::new`
  let (_, id) = newV4()
  Bossbar(uuid: id, title: title, health: 0.0'f32, color: bcWhite, division: bdNoDivision, flags: 0'u8)

proc sendBossbar*(self: Player; bossbar: Bossbar) =
  self.client.writePacketFor(CBossEvent(uuid: bossbar.uuid, action: BosseventAction(kind: baAdd, title: bossbar.title,
    health: bossbar.health, color: newVarInt(int32(ord(bossbar.color))), division: newVarInt(int32(ord(bossbar.division))),
    flags: bossbar.flags)))

proc removeBossbar*(self: Player; uuid: Uuid) =
  self.client.writePacketFor(CBossEvent(uuid: uuid, action: BosseventAction(kind: baRemove)))

proc updateBossbarHealth*(self: Player; uuid: Uuid; health: float32) =
  self.client.writePacketFor(CBossEvent(uuid: uuid, action: BosseventAction(kind: baUpdateHealth, updatedHealth: health)))

proc updateBossbarTitle*(self: Player; uuid: Uuid; title: TextComponent) =
  self.client.writePacketFor(CBossEvent(uuid: uuid, action: BosseventAction(kind: baUpdateTile, updatedTitle: title)))

proc updateBossbarStyle*(self: Player; uuid: Uuid; color: BossbarColor; dividers: BossbarDivisions) =
  self.client.writePacketFor(CBossEvent(uuid: uuid, action: BosseventAction(kind: baUpdateStyle,
    styleColor: newVarInt(int32(ord(color))), dividers: newVarInt(int32(ord(dividers))))))

proc updateBossbarFlags*(self: Player; uuid: Uuid; flags: uint8) =
  self.client.writePacketFor(CBossEvent(uuid: uuid, action: BosseventAction(kind: baUpdateFlags, updatedFlags: flags)))
