## Port of pumpkin/src/world/chunker.rs
## PARTIAL: pumpkin/src/world/chunker.rs - Java only. The entity chunks go through `gLoadEntityChunksHook` and `gRemoveEntitiesInChunksHook`, which block/worldhooks.aowl fills.

import ../../protocol/java/client/play/[center_chunk, unload_chunk]
import ../../util/math/rustnum
import ../serverbase
import ../entity/player as playermod

var gLoadEntityChunksHook*: proc(player: Player; chunks: seq[Vector2[int32]]; center: Vector2[int32]) {.closure.} =
  proc(player: Player; chunks: seq[Vector2[int32]]; center: Vector2[int32]) {.closure.} = discard
  ## `World::spawn_world_entity_chunks`: needs entitymod, so block/worldhooks.aowl sets it.
var gRemoveEntitiesInChunksHook*: proc(world: World; chunks: seq[(int32, int32)]) {.closure.} =
  proc(world: World; chunks: seq[(int32, int32)]) {.closure.} = discard
  ## `World::remove_entities_in_chunks`: block/worldhooks.aowl sets it.

proc getViewDistance*(player: Player; server: Server): uint8 =
  let maxViewDistance = server.advancedConfig.networking.java.viewDistance
  min(max(player.config.viewDistance, 2'u8), maxViewDistance)

proc isWithinViewDistance*(center, target: Vector2[int32]; viewDistance: int32): bool =
  ## Chebyshev distance.
  max(abs(target.x - center.x), abs(target.y - center.y)) <= viewDistance

proc updatePosition*(player: Player; server: Server) =
  let newChunkCenter = player.chunkPos
  let oldCylindrical = player.watchedSection

  let viewDistance = getViewDistance(player, server)
  let newCylindrical = newCylindrical(newChunkCenter, viewDistance)

  if oldCylindrical.center.x == newCylindrical.center.x and oldCylindrical.center.y == newCylindrical.center.y and
      oldCylindrical.viewDistance == newCylindrical.viewDistance:
    return

  player.client.writePacketFor(CCenterChunk(chunkX: newVarInt(newChunkCenter.x), chunkZ: newVarInt(newChunkCenter.y)))

  var loadingChunks: seq[Vector2[int32]] = @[]
  var unloadingChunks: seq[Vector2[int32]] = @[]
  forEachChangedChunk(oldCylindrical, newCylindrical, loadingChunks, unloadingChunks)

  let theLevel = player.world.level
  player.chunkManager.updateCenterAndViewDistance(newChunkCenter, viewDistance, theLevel, loadingChunks, unloadingChunks)

  player.watchedSection = newCylindrical

  for chunk in unloadingChunks:
    player.client.writePacketFor(CUnloadChunk(z: chunk.y, x: chunk.x))

  # Make sure the watched section and the chunk watcher updates stay together: what is unloaded when the player
  # disconnects must be correct.
  var loading: seq[(int32, int32)] = @[]
  for chunk in loadingChunks:
    loading.add((chunk.x, chunk.y))
  var unloading: seq[(int32, int32)] = @[]
  for chunk in unloadingChunks:
    unloading.add((chunk.x, chunk.y))
  markChunksAsNewlyWatched(theLevel, loading)
  let toClean = markChunksAsNotWatched(theLevel, unloading)
  if toClean.len > 0:
    gRemoveEntitiesInChunksHook(player.world, toClean)
    discard cleanEntityChunks(theLevel, toClean)
  if loadingChunks.len > 0:
    gLoadEntityChunksHook(player, loadingChunks, newChunkCenter)

proc unloadWatchedChunks*(player: Player; world: World) =
  ## `Player::unload_watched_chunks`
  let radialChunks = allChunksWithin(player.watchedSection)
  var chunks: seq[(int32, int32)] = @[]
  for chunk in radialChunks:
    chunks.add((chunk.x, chunk.y))
  let toClean = markChunksAsNotWatched(world.level, chunks)
  if toClean.len > 0:
    gRemoveEntitiesInChunksHook(world, toClean)
    discard cleanEntityChunks(world.level, toClean)
  for chunk in radialChunks:
    player.client.writePacketFor(CUnloadChunk(z: chunk.y, x: chunk.x))
  player.watchedSection = newCylindrical(Vector2[int32](x: 0'i32, y: 0'i32), 1'u8)
