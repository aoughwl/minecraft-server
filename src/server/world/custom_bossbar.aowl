## Port of pumpkin/src/world/custom_bossbar.rs
##
## Upstream's `Result<(), BossbarUpdateError>` is a `BossbarUpdate` value. `HashMap` is a seq, as there are few.

import std/options
import ../../util/text/text
import ../serverbase
import bossbar

type
  BossbarUpdateKind* = enum
    bukOk
    bukInvalidResourceLocation
    bukNoChanges

  BossbarUpdate* = object
    kind*: BossbarUpdateKind
    location*: string
    what*: string        ## `NoChanges`' first field.
    detail*: string      ## `NoChanges`' second field; empty for `None`.

  CustomBossbar* = object
    namespace*: string
    bossbarData*: Bossbar
    max*: int32
    value*: int32
    visible*: bool
    players*: seq[Uuid]

  CustomBossbars* = object
    customBossbars*: seq[CustomBossbar]

proc updated(): BossbarUpdate = BossbarUpdate(kind: bukOk)

proc invalidLocation(location: string): BossbarUpdate =
  BossbarUpdate(kind: bukInvalidResourceLocation, location: location)

proc noChanges(what: string; detail = ""): BossbarUpdate =
  BossbarUpdate(kind: bukNoChanges, what: what, detail: detail)

proc newCustomBossbar*(namespace: string; bossbarData: Bossbar): CustomBossbar =
  CustomBossbar(namespace: namespace, bossbarData: bossbarData, max: 100'i32, value: 0'i32, visible: true, players: @[])

proc newCustomBossbars*(): CustomBossbars =
  CustomBossbars(customBossbars: @[])

proc indexOf(self: CustomBossbars; location: string): int =
  for i in 0 ..< self.customBossbars.len:
    if self.customBossbars[i].namespace == location:
      return i
  -1

proc getPlayerBars*(self: CustomBossbars; uuid: Uuid): seq[Bossbar] =
  ## `get_player_bars`, empty for `None`.
  result = @[]
  for bar in self.customBossbars:
    if uuid in bar.players:
      result.add(bar.bossbarData)

proc replaceBossbar*(self: var CustomBossbars; location: string; data: CustomBossbar) =
  let i = self.indexOf(location)
  if i >= 0:
    self.customBossbars[i] = data
  else:
    self.customBossbars.add(data)

proc createBossbar*(self: var CustomBossbars; namespace: string; data: Bossbar) =
  self.replaceBossbar(namespace, newCustomBossbar(namespace, data))

proc getAllBossbars*(self: CustomBossbars): seq[CustomBossbar] = self.customBossbars

proc getBossbarsLen*(self: CustomBossbars): int = self.customBossbars.len

proc getBossbar*(self: CustomBossbars; location: string): Option[CustomBossbar] =
  let i = self.indexOf(location)
  if i >= 0: some(self.customBossbars[i]) else: none[CustomBossbar]()

proc hasBossbar*(self: CustomBossbars; location: string): bool = self.indexOf(location) >= 0

proc onlinePlayer(server: Server; id: Uuid): nil Player =
  for world in server.worlds:
    for p in world.players:
      if p.gameprofile.id == id:
        return p
  nil

proc removeBossbar*(self: var CustomBossbars; server: Server; location: string): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  let bar = self.customBossbars[i]
  self.customBossbars.delete(i)
  if bar.visible:
    for id in bar.players:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.removeBossbar(bar.bossbarData.uuid)
  updated()

proc updateHealth*(self: var CustomBossbars; server: Server; location: string; maxValue, value: int32): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  if self.customBossbars[i].value == value and self.customBossbars[i].max == maxValue:
    return noChanges("value")
  let ratio = float64(value) / float64(maxValue)
  let health = if ratio < 0.0: 0.0'f32 elif ratio > 1.0: 1.0'f32 else: float32(ratio)
  self.customBossbars[i].value = value
  self.customBossbars[i].max = maxValue
  self.customBossbars[i].bossbarData.health = health
  let bar = self.customBossbars[i]
  if bar.visible:
    for id in bar.players:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.updateBossbarHealth(bar.bossbarData.uuid, health)
  updated()

proc updateVisibility*(self: var CustomBossbars; server: Server; location: string; newVisibility: bool): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  if self.customBossbars[i].visible == newVisibility:
    return noChanges("visibility", if newVisibility: "visible" else: "hidden")
  self.customBossbars[i].visible = newVisibility
  let bar = self.customBossbars[i]
  for id in bar.players:
    let p = onlinePlayer(server, id)
    if p != nil:
      if newVisibility:
        p.sendBossbar(bar.bossbarData)
      else:
        p.removeBossbar(bar.bossbarData.uuid)
  updated()

proc updateName*(self: var CustomBossbars; server: Server; location: string; newTitle: TextComponent): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  if toJsonString(self.customBossbars[i].bossbarData.title) == toJsonString(newTitle):
    return noChanges("name")
  self.customBossbars[i].bossbarData.title = newTitle
  let bar = self.customBossbars[i]
  if bar.visible:
    for id in bar.players:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.updateBossbarTitle(bar.bossbarData.uuid, newTitle)
  updated()

proc sendStyle(server: Server; bar: CustomBossbar) =
  if bar.visible:
    for id in bar.players:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.updateBossbarStyle(bar.bossbarData.uuid, bar.bossbarData.color, bar.bossbarData.division)

proc updateColor*(self: var CustomBossbars; server: Server; location: string; newColor: BossbarColor): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  if self.customBossbars[i].bossbarData.color == newColor:
    return noChanges("color")
  self.customBossbars[i].bossbarData.color = newColor
  sendStyle(server, self.customBossbars[i])
  updated()

proc updateDivision*(self: var CustomBossbars; server: Server; location: string; newDivision: BossbarDivisions): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  if self.customBossbars[i].bossbarData.division == newDivision:
    return noChanges("style")
  self.customBossbars[i].bossbarData.division = newDivision
  sendStyle(server, self.customBossbars[i])
  updated()

proc updatePlayers*(self: var CustomBossbars; server: Server; location: string; newPlayers: seq[Uuid]): BossbarUpdate =
  let i = self.indexOf(location)
  if i < 0:
    return invalidLocation(location)
  let bar = self.customBossbars[i]
  var removedPlayers: seq[Uuid] = @[]
  for id in bar.players:
    if id notin newPlayers:
      removedPlayers.add(id)
  var addedPlayers: seq[Uuid] = @[]
  for id in newPlayers:
    if id notin bar.players:
      addedPlayers.add(id)
  if removedPlayers.len == 0 and addedPlayers.len == 0:
    return noChanges("players")
  if bar.visible:
    for id in removedPlayers:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.removeBossbar(bar.bossbarData.uuid)
  self.customBossbars[i].players = newPlayers
  if bar.visible:
    for id in addedPlayers:
      let p = onlinePlayer(server, id)
      if p != nil:
        p.sendBossbar(bar.bossbarData)
  updated()
