## Port of pumpkin/src/world/dragon_fight.rs
##
## End Dragon fight manager: the dragon's lifecycle, end crystal spawning, boss bar, gateways, the respawn sequence and
## the exit portal.
##
## The fight is a state machine over a `FightEnv`, the handful of questions it asks of its world (entities of two kinds,
## blocks by name, players, the boss bar packets). dragon_fight_world.aowl fills those from the real
## `World`, gives an End world a fight, ticks it from `tickEntitiesHook` and answers the dragon's `gDragonFightOf`. `tokio::sync::Mutex` is not needed: the fight is touched from the world tick alone.
##
## Upstream's gateway queue is not shuffled by seed (its own TODO), and nothing upstream calls `try_respawn` or
## `on_crystal_destroyed` yet; they are here for the item and entity that will.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[math, options]
import ../../util/uuid
import ../../util/vector3
import ../../util/math/position
import ../../util/text/[textbase, text]
import bossbar

const
  MaxTicksBeforeDragonRespawn* = 1200'i32
  CrystalScanInterval* = 100'i32
  PlayerScanInterval* = 20'i32
  DragonSpawnY* = 128.0
  ArenaRadius* = 192.0
  GatewayCount* = 20
  GatewayDistance* = 96.0
  GatewayY* = 75'i32

type
  DragonRespawnStage* = enum
    ## Mirrors vanilla `DragonRespawnStage`.
    drsStart       ## Crystals are charging up (0-99 ticks).
    drsPreparing   ## Summoning beam is active (100-179 ticks).
    drsEnd         ## Dragon is being summoned (180-199 ticks).

  FightEntityKind* = enum
    fekDragon
    fekCrystal

  FightEntity* = object
    uuid*: Uuid
    pos*: Vector3[float64]

  FightEnv* = ref object
    ## What the fight asks of its world. A nil field is the empty answer.
    entities*: proc(kind: FightEntityKind): seq[FightEntity] {.closure.}  ## `world.entities` of that type.
    removeEntity*: proc(uuid: Uuid) {.closure.}
    spawnDragon*: proc(uuid: Uuid; pos: Vector3[float64]) {.closure.}      ## `from_type(ENDER_DRAGON, ..)`, `spawn_entity`.
    spawnCrystal*: proc(pos: Vector3[float64]) {.closure.}                 ## An `EndCrystalEntity` with its bottom shown.
    setDragonOrigin*: proc(uuid: Uuid; origin: BlockPos) {.closure.}       ## `EnderDragonEntity::set_fight_origin`.
    blockName*: proc(x, y, z: int32): string {.closure.}                   ## `get_block`, as `bedrock` or `end_portal`.
    setBlock*: proc(x, y, z: int32; name: string) {.closure.}              ## `set_block_state(.., default_state, NOTIFY_ALL)`.
    topBlock*: proc(x, z: int32): int32 {.closure.}                        ## `get_top_block`.
    minY*: int32
    placePodium*: proc(origin: BlockPos; active: bool) {.closure.}         ## `end_podium::place`.
    gatewayEvent*: proc(pos: BlockPos) {.closure.}                         ## `sync_world_event(AnimationEndGatewaySpawn, pos, 0)`.
    players*: proc(): seq[FightEntity] {.closure.}                         ## Every player of the world, with its position.
    sendBossbar*: proc(player: Uuid; bar: Bossbar) {.closure.}
    removeBossbar*: proc(player: Uuid; bar: Uuid) {.closure.}
    updateBossbarHealth*: proc(player: Uuid; bar: Uuid; health: float32) {.closure.}

  DragonFightState* = ref object
    # Persistent state (would be saved to disk in vanilla).
    dragonKilled*: bool
    previouslyKilled*: bool
    needsStateScanning*: bool
    dragonUuid*: Option[Uuid]
    portalLocation*: Option[BlockPos]
    crystalsAlive*: uint32
    ## Gateways not yet unlocked, stored as angle indices 0-19. Vanilla shuffles these at world creation and pops one
    ## per dragon kill.
    pendingGateways*: seq[int]
    respawnStage*: Option[DragonRespawnStage]  ## Active respawn stage, or none when not respawning.
    respawnTime*: int32
    respawnCrystalUuids*: seq[Uuid]
    # Transient counters.
    ticksSinceDragonSeen*: int32
    ticksSinceCrystalsScanned*: int32
    ticksSinceLastPlayerScan*: int32
    # Boss bar.
    bossbarUuid*: Uuid
    bossbarPlayers*: seq[Uuid]
    env*: FightEnv

proc tick*(self: DragonRespawnStage; time: int32): bool =
  ## Advance through the respawn animation. True when the stage has completed and the caller should advance.
  case self
  of drsStart: time >= 100'i32
  of drsPreparing: time >= 80'i32
  of drsEnd: time >= 20'i32

proc newDragonFight*(env: FightEnv): DragonFightState =
  ## `DragonFight::new`. The gateway queue is 0-19 in a fixed (non-shuffled) order, as upstream has it.
  var pending: seq[int] = @[]
  for i in 0 ..< GatewayCount:
    pending.add(i)
  let (_, id) = newV4()
  DragonFightState(dragonKilled: false, previouslyKilled: false, needsStateScanning: true, dragonUuid: none[Uuid](),
    portalLocation: none[BlockPos](), crystalsAlive: 0'u32, pendingGateways: pending,
    respawnStage: none[DragonRespawnStage](), respawnTime: 0'i32, respawnCrystalUuids: @[],
    ticksSinceDragonSeen: 0'i32, ticksSinceCrystalsScanned: 0'i32,
    # Start above the threshold so the first tick with players triggers a scan.
    ticksSinceLastPlayerScan: PlayerScanInterval + 1'i32,
    bossbarUuid: id, bossbarPlayers: @[], env: env)

proc pos3(x, y, z: int32): BlockPos = newBlockPos(x, y, z)

proc containsId(list: seq[Uuid]; id: Uuid): bool =
  for u in list:
    if u == id:
      return true
  false

# ---- Boss bar -----------------------------------------------------------------------------------------------------

proc makeBossbar(self: DragonFightState): Bossbar =
  Bossbar(uuid: self.bossbarUuid,
    title: translateCross("entity.minecraft.ender_dragon", "entity.minecraft.ender_dragon"),
    health: 1.0'f32, color: bcPink, division: bdNoDivision, flags: BossbarFlagDragonBar)

proc updateBossbarHealth(self: DragonFightState; health: float32) =
  let env = self.env
  if env.updateBossbarHealth == nil or env.players == nil:
    return
  let listPlayer = env.players()
  for player in listPlayer:
    if containsId(self.bossbarPlayers, player.uuid):
      env.updateBossbarHealth(player.uuid, self.bossbarUuid, health)

proc removeAllBossbar(self: DragonFightState) =
  let env = self.env
  if env.removeBossbar != nil and env.players != nil:
    let listPlayer = env.players()
    for player in listPlayer:
      if containsId(self.bossbarPlayers, player.uuid):
        env.removeBossbar(player.uuid, self.bossbarUuid)
  self.bossbarPlayers.setLen(0)

proc updatePlayers(self: DragonFightState) =
  ## Sync the boss-bar recipient list with nearby players. Matches vanilla `updatePlayers`.
  let env = self.env
  var players: seq[FightEntity] = @[]
  if env.players != nil:
    players = env.players()
  var current: seq[Uuid] = @[]
  for p in players:
    let dx = p.pos.x
    let dy = p.pos.y - DragonSpawnY
    let dz = p.pos.z
    if dx * dx + dy * dy + dz * dz < ArenaRadius * ArenaRadius:
      current.add(p.uuid)
  # Add newly-in-range players.
  for uid in current:
    if not containsId(self.bossbarPlayers, uid):
      if not self.dragonKilled and env.sendBossbar != nil:
        env.sendBossbar(uid, self.makeBossbar())
      self.bossbarPlayers.add(uid)
  # Remove out-of-range players.
  var toRemove: seq[Uuid] = @[]
  for uid in self.bossbarPlayers:
    if not containsId(current, uid):
      toRemove.add(uid)
  for uid in toRemove:
    var online = false
    for p in players:
      if p.uuid == uid:
        online = true
    if online and env.removeBossbar != nil:
      env.removeBossbar(uid, self.bossbarUuid)
    var kept: seq[Uuid] = @[]
    for u in self.bossbarPlayers:
      if u != uid:
        kept.add(u)
    self.bossbarPlayers = kept

# ---- Exit portal --------------------------------------------------------------------------------------------------

proc spawnExitPortal*(self: DragonFightState; active: bool) =
  ## Place (or activate) the exit podium. `active` fills the portal disc with `END_PORTAL` blocks after the dragon dies.
  let env = self.env
  if self.portalLocation.isNone:
    let topY = env.topBlock(0'i32, 0'i32)
    var portalY = topY
    while portalY > 63'i32:
      if env.blockName(0'i32, portalY, 0'i32) != "bedrock":
        break
      dec portalY
    portalY = max(portalY, env.minY + 1'i32)
    self.portalLocation = some(pos3(0'i32, portalY, 0'i32))
  if self.portalLocation.isSome and env.placePodium != nil:
    env.placePodium(self.portalLocation.unsafeGet, active)

proc hasActiveExitPortal(self: DragonFightState): bool =
  ## Whether an `END_PORTAL` block exists within an 8-chunk radius of the origin, as vanilla's `hasActiveExitPortal`.
  for cx in -8'i32 .. 8'i32:
    for cz in -8'i32 .. 8'i32:
      let bx = cx * 16'i32
      let bz = cz * 16'i32
      for y in 30'i32 .. 80'i32:
        if self.env.blockName(bx, y, bz) == "end_portal":
          return true
  false

# ---- Crystals -----------------------------------------------------------------------------------------------------

proc spawnCrystals*(self: DragonFightState) =
  ## Spawn end crystals on the obsidian spike tops. Skips if any crystal already exists (resumed world). Matches vanilla
  ## `respawnCrystals`.
  let env = self.env
  if env.entities(fekCrystal).len > 0:
    return
  for i in 0 ..< 10:
    let angle = 2.0 * (-PI + PI * 0.1 * float64(i))
    let cx = int32(floor(42.0 * cos(angle)))
    let cz = int32(floor(42.0 * sin(angle)))
    # Find the top of the spike by scanning down from y=115 for bedrock.
    var crystalY = 78'i32
    var y = 115'i32
    while y >= 70'i32:
      if env.blockName(cx, y, cz) == "bedrock":
        crystalY = y + 1'i32
        break
      dec y
    env.spawnCrystal(Vector3[float64](x: float64(cx) + 0.5, y: float64(crystalY), z: float64(cz) + 0.5))

proc updateCrystalCount*(self: DragonFightState) =
  self.crystalsAlive = uint32(self.env.entities(fekCrystal).len)

# ---- Dragon lifecycle ---------------------------------------------------------------------------------------------

proc createNewDragon(self: DragonFightState) =
  let (_, id) = newV4()
  self.env.spawnDragon(id, Vector3[float64](x: 0.5, y: DragonSpawnY, z: 0.5))
  self.dragonUuid = some(id)

proc findOrCreateDragon(self: DragonFightState) =
  let found = self.env.entities(fekDragon)
  if found.len > 0:
    self.dragonUuid = some(found[0].uuid)
    self.ticksSinceDragonSeen = 0'i32
  else:
    self.createNewDragon()

proc updateDragon*(self: DragonFightState; health, maxHealth: float32) =
  ## Called every tick while the dragon is alive. Updates the boss-bar health fraction, matching vanilla
  ## `EnderDragonFight.updateDragon`.
  self.ticksSinceDragonSeen = 0'i32
  let fraction = if maxHealth > 0.0'f32: min(max(health / maxHealth, 0.0'f32), 1.0'f32) else: 0.0'f32
  self.updateBossbarHealth(fraction)
  # Sync fight origin to the dragon so its pathfinding nodes are correctly placed.
  if self.portalLocation.isSome and self.dragonUuid.isSome and self.env.setDragonOrigin != nil:
    let listE = self.env.entities(fekDragon)
    for e in listE:
      if e.uuid == self.dragonUuid.unsafeGet:
        self.env.setDragonOrigin(e.uuid, self.portalLocation.unsafeGet)

proc spawnNewGateway(self: DragonFightState) =
  ## Spawn the next end gateway, consuming one index from `pendingGateways`. Matches vanilla `spawnNewGateway`.
  if self.pendingGateways.len == 0:
    return
  let idx = self.pendingGateways[self.pendingGateways.len - 1]
  self.pendingGateways.setLen(self.pendingGateways.len - 1)
  let angle = 2.0 * (-PI + PI * 0.1 * float64(idx))
  let x = int32(floor(GatewayDistance * cos(angle)))
  let z = int32(floor(GatewayDistance * sin(angle)))
  if self.env.gatewayEvent != nil:
    self.env.gatewayEvent(pos3(x, GatewayY, z))

proc setDragonKilled*(self: DragonFightState; killed: Uuid) =
  ## Called by the dragon entity when it dies. Activates the portal, places the egg on a first kill, spawns a gateway and
  ## hides the boss bar. Matches vanilla `EnderDragonFight.setDragonKilled`.
  if self.dragonUuid.isNone or self.dragonUuid.unsafeGet != killed:
    return
  self.updateBossbarHealth(0.0'f32)
  self.removeAllBossbar()
  # Activate the exit portal.
  self.spawnExitPortal(true)
  # Place the dragon egg on the first kill.
  if not self.previouslyKilled and self.portalLocation.isSome:
    let loc = self.portalLocation.unsafeGet
    self.env.setBlock(loc.vec.x, loc.vec.y + 4'i32, loc.vec.z, "dragon_egg")
  self.spawnNewGateway()
  self.previouslyKilled = true
  self.dragonKilled = true
  self.dragonUuid = none[Uuid]()

# ---- State scanning -----------------------------------------------------------------------------------------------

proc scanState(self: DragonFightState) =
  ## Runs once on the first tick with nearby players. Determines whether this is a fresh fight or a resumed one and
  ## reconciles the entity list.
  let hasActivePortal = self.hasActiveExitPortal()
  if hasActivePortal:
    self.previouslyKilled = true
  else:
    self.previouslyKilled = false
    if self.portalLocation.isNone:
      self.spawnExitPortal(false)
    self.spawnCrystals()
  # Reconcile any live dragon entity.
  let existing = self.env.entities(fekDragon)
  if existing.len > 0 and hasActivePortal:
    # Stale dragon after a completed fight: remove it.
    self.env.removeEntity(existing[0].uuid)
    self.dragonUuid = none[Uuid]()
    self.dragonKilled = true
  elif existing.len > 0:
    self.dragonUuid = some(existing[0].uuid)
    self.dragonKilled = false
  else:
    self.dragonKilled = true
  # Fresh world where the dragon appears dead: force a spawn next tick.
  if not self.previouslyKilled and self.dragonKilled:
    self.dragonKilled = false

# ---- Respawn sequence ---------------------------------------------------------------------------------------------

proc clearPortalBlocks(self: DragonFightState; loc: BlockPos) =
  ## Replace the bedrock/portal blocks of the current podium with end-stone, as the vanilla portal reset during respawn.
  for dy in -1'i32 .. 5'i32:
    for dx in -4'i32 .. 4'i32:
      for dz in -4'i32 .. 4'i32:
        let x = loc.vec.x + dx
        let y = loc.vec.y + dy
        let z = loc.vec.z + dz
        let name = self.env.blockName(x, y, z)
        if name == "bedrock" or name == "end_portal":
          self.env.setBlock(x, y, z, "end_stone")

proc abortRespawn(self: DragonFightState) =
  self.respawnStage = none[DragonRespawnStage]()
  self.respawnTime = 0'i32
  self.respawnCrystalUuids.setLen(0)
  # Re-activate the portal so the world remains in a valid state.
  self.spawnExitPortal(true)

proc beginRespawn(self: DragonFightState; crystalUuids: seq[Uuid]) =
  # Tear down the active portal (replace END_PORTAL/BEDROCK with END_STONE) so the podium resets, matching vanilla.
  if self.portalLocation.isSome:
    self.clearPortalBlocks(self.portalLocation.unsafeGet)
  self.respawnStage = some(drsStart)
  self.respawnTime = 0'i32
  self.respawnCrystalUuids = crystalUuids
  self.spawnExitPortal(false)

proc tryRespawn*(self: DragonFightState) =
  ## Attempt to begin a respawn. Requires four end crystals placed on the cardinal sides of the portal, exactly as in
  ## vanilla `tryRespawn`.
  if not self.dragonKilled or self.respawnStage.isSome:
    return
  # Ensure we know where the portal is.
  if self.portalLocation.isNone:
    self.spawnExitPortal(true)
  if self.portalLocation.isNone:
    return
  let portalLoc = self.portalLocation.unsafeGet
  # Scan the four cardinal directions one block above the portal centre for end crystals.
  let centreX = portalLoc.vec.x
  let centreZ = portalLoc.vec.z
  let offsets = [(3'i32, 0'i32), (-3'i32, 0'i32), (0'i32, 3'i32), (0'i32, -3'i32)]
  let crystals = self.env.entities(fekCrystal)
  var ritual: seq[Uuid] = @[]
  for (dx, dz) in offsets:
    var found = false
    for e in crystals:
      let cx = float64(centreX + dx) + 0.5
      let cz = float64(centreZ + dz) + 0.5
      # Find a crystal near this position (within 2 blocks).
      if abs(e.pos.x - cx) < 2.0 and abs(e.pos.z - cz) < 2.0:
        ritual.add(e.uuid)
        found = true
        break
    if not found:
      return
  self.beginRespawn(ritual)

proc onCrystalDestroyed*(self: DragonFightState; crystal: Uuid) =
  ## Called when an end crystal is destroyed. If a respawn is in progress and this was one of the ritual crystals, the
  ## respawn is aborted. Matches vanilla `EnderDragonFight.onCrystalDestroyed`.
  if self.respawnStage.isSome and containsId(self.respawnCrystalUuids, crystal):
    self.abortRespawn()
  else:
    self.updateCrystalCount()

proc tickRespawn(self: DragonFightState) =
  ## Drive the respawn animation forward by one tick.
  if self.respawnStage.isNone:
    return
  let stage = self.respawnStage.unsafeGet
  # Verify all ritual crystals still exist.
  let alive = self.env.entities(fekCrystal)
  for wanted in self.respawnCrystalUuids:
    var present = false
    for e in alive:
      if e.uuid == wanted:
        present = true
    if not present:
      self.abortRespawn()
      return
  inc self.respawnTime
  if stage.tick(self.respawnTime):
    case stage
    of drsStart:
      self.respawnStage = some(drsPreparing)
      self.respawnTime = 0'i32
    of drsPreparing:
      self.respawnStage = some(drsEnd)
      self.respawnTime = 0'i32
    of drsEnd:
      # Spawn the new dragon.
      self.respawnStage = none[DragonRespawnStage]()
      self.respawnTime = 0'i32
      self.respawnCrystalUuids.setLen(0)
      self.dragonKilled = false
      self.createNewDragon()

# ---- Main tick ----------------------------------------------------------------------------------------------------

proc tick*(self: DragonFightState) =
  inc self.ticksSinceLastPlayerScan
  # Upstream reads these under the first lock, before the scans below change them, and steps 3 and 4 go by what it read.
  let needsStateScanning = self.needsStateScanning
  let respawnStage = self.respawnStage
  let dragonKilled = self.dragonKilled
  let dragonUuid = self.dragonUuid
  # 1. Update boss-bar recipients every 20 ticks.
  if self.ticksSinceLastPlayerScan >= PlayerScanInterval:
    self.updatePlayers()
    self.ticksSinceLastPlayerScan = 0'i32
  # Nothing to do without nearby players.
  if self.bossbarPlayers.len == 0:
    return
  # 2. One-time state scan on the first populated tick.
  if needsStateScanning:
    self.scanState()
    self.needsStateScanning = false
  # 3. Respawn sequence (takes priority over normal dragon-missing logic).
  if respawnStage.isSome:
    self.tickRespawn()
    return
  # 4. Normal fight ticking.
  if not dragonKilled:
    inc self.ticksSinceDragonSeen
    if dragonUuid.isNone or self.ticksSinceDragonSeen >= MaxTicksBeforeDragonRespawn:
      self.findOrCreateDragon()
      self.ticksSinceDragonSeen = 0'i32
    inc self.ticksSinceCrystalsScanned
    if self.ticksSinceCrystalsScanned >= CrystalScanInterval:
      self.updateCrystalCount()
      self.ticksSinceCrystalsScanned = 0'i32

# ---- Public queries -----------------------------------------------------------------------------------------------

proc aliveCrystals*(self: DragonFightState): uint32 = self.crystalsAlive
proc hasPreviouslyKilledDragon*(self: DragonFightState): bool = self.previouslyKilled
proc isRespawning*(self: DragonFightState): bool = self.respawnStage.isSome
