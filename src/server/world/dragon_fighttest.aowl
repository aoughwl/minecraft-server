## The End dragon fight run over a world of closures that records what it asked for.
import std/[math, options, syncio, tables]
import ../../util/uuid
import ../../util/vector3
import ../../util/math/position
import ../../util/text/textbase
import bossbar
import dragon_fight

proc check(ok: bool; what: string) =
  if not ok:
    echo "FAILED: ", what
    stdout.flushFile()
    quit(1)

type FakeWorld = ref object
  blocks: Table[string, string]
  dragons: seq[FightEntity]
  crystals: seq[FightEntity]
  players: seq[FightEntity]
  bars: seq[string]
  gateways: seq[BlockPos]
  podiums: seq[(BlockPos, bool)]
  origins: int
  removed: int

proc key(x, y, z: int32): string = $x & "," & $y & "," & $z

proc newId(): Uuid =
  let (_, id) = newV4()
  id

proc fakeEnv(w: FakeWorld): FightEnv =
  result = FightEnv(minY: -64'i32)
  result.entities = proc(kind: FightEntityKind): seq[FightEntity] {.closure.} =
    if kind == fekDragon: w.dragons else: w.crystals
  result.removeEntity = proc(uuid: Uuid) {.closure.} =
    inc w.removed
    var kept: seq[FightEntity] = @[]
    for d in w.dragons:
      if d.uuid != uuid:
        kept.add(d)
    w.dragons = kept
  result.spawnDragon = proc(uuid: Uuid; pos: Vector3[float64]) {.closure.} =
    w.dragons.add(FightEntity(uuid: uuid, pos: pos))
  result.spawnCrystal = proc(pos: Vector3[float64]) {.closure.} =
    w.crystals.add(FightEntity(uuid: newId(), pos: pos))
  result.setDragonOrigin = proc(uuid: Uuid; origin: BlockPos) {.closure.} = inc w.origins
  result.blockName = proc(x, y, z: int32): string {.closure.} = w.blocks.getOrDefault(key(x, y, z), "air")
  result.setBlock = proc(x, y, z: int32; name: string) {.closure.} = w.blocks[key(x, y, z)] = name
  result.topBlock = proc(x, z: int32): int32 {.closure.} = 64'i32
  result.placePodium = proc(origin: BlockPos; active: bool) {.closure.} =
    w.podiums.add((origin, active))
    if active:
      w.blocks[key(origin.vec.x, origin.vec.y, origin.vec.z)] = "end_portal"
    else:
      w.blocks[key(origin.vec.x, origin.vec.y, origin.vec.z)] = "bedrock"
  result.gatewayEvent = proc(pos: BlockPos) {.closure.} = w.gateways.add(pos)
  result.players = proc(): seq[FightEntity] {.closure.} = w.players
  result.sendBossbar = proc(player: Uuid; bar: Bossbar) {.closure.} = w.bars.add("send")
  result.removeBossbar = proc(player: Uuid; bar: Uuid) {.closure.} = w.bars.add("remove")
  result.updateBossbarHealth = proc(player: Uuid; bar: Uuid; health: float32) {.closure.} = w.bars.add("health " & $health)

proc newWorld(): FakeWorld =
  FakeWorld(blocks: initTable[string, string](), dragons: @[], crystals: @[], players: @[], bars: @[], gateways: @[],
    podiums: @[], origins: 0, removed: 0)

proc at(x, y, z: float64): Vector3[float64] = Vector3[float64](x: x, y: y, z: z)

proc stages() =
  check(not drsStart.tick(99'i32) and drsStart.tick(100'i32), "start lasts 100 ticks")
  check(not drsPreparing.tick(79'i32) and drsPreparing.tick(80'i32), "preparing lasts 80 ticks")
  check(not drsEnd.tick(19'i32) and drsEnd.tick(20'i32), "end lasts 20 ticks")

proc ritualCrystals(w: FakeWorld; ids: array[4, Uuid]) =
  w.crystals = @[FightEntity(uuid: ids[0], pos: at(3.5, 65.0, 0.5)), FightEntity(uuid: ids[1], pos: at(-2.5, 65.0, 0.5)),
    FightEntity(uuid: ids[2], pos: at(0.5, 65.0, 3.5)), FightEntity(uuid: ids[3], pos: at(0.5, 65.0, -2.5))]

proc freshFight() =
  let w = newWorld()
  let fight = newDragonFight(fakeEnv(w))
  check(fight.pendingGateways.len == 20 and fight.pendingGateways[19] == 19, "twenty gateways in order")
  check(fight.needsStateScanning and not fight.dragonKilled, "a fresh fight")
  # A player outside the arena is not a recipient, and without one the fight does nothing.
  w.players.add(FightEntity(uuid: newId(), pos: at(1000.0, 128.0, 0.0)))
  fight.tick()
  check(fight.bossbarPlayers.len == 0 and w.dragons.len == 0 and w.crystals.len == 0, "nothing without a player in range")
  let near = newId()
  w.players.add(FightEntity(uuid: near, pos: at(0.0, 128.0, 0.0)))
  fight.ticksSinceLastPlayerScan = PlayerScanInterval
  fight.tick()
  check(fight.bossbarPlayers.len == 1 and w.bars == @["send"], "the player in range gets the boss bar")
  check(not fight.needsStateScanning, "the state was scanned")
  check(w.crystals.len == 10, "ten crystals on the spikes")
  check(w.dragons.len == 1 and fight.dragonUuid.isSome, "a dragon was spawned")
  check(w.dragons[0].pos.x == 0.5 and w.dragons[0].pos.y == 128.0 and w.dragons[0].pos.z == 0.5, "at the arena centre")
  check(fight.portalLocation.isSome and fight.portalLocation.unsafeGet.vec.y == 64'i32, "the portal is at the top block")
  check(w.podiums.len == 1 and not w.podiums[0][1], "an inactive podium")
  # The first spike: floor(42 * cos(-2 pi)) = 42, z = 0; no bedrock found, so y 78.
  check(w.crystals[0].pos.x == 42.5 and w.crystals[0].pos.y == 78.0 and w.crystals[0].pos.z == 0.5, "the first crystal")
  # A crystal count refresh every 100 ticks.
  fight.crystalsAlive = 0'u32
  for i in 0 ..< 100:
    fight.tick()
  check(fight.aliveCrystals() == 10'u32, "crystals counted")
  # Health goes to the bar.
  fight.updateDragon(100.0'f32, 200.0'f32)
  check(w.bars[^1] == "health 0.5" and w.origins == 1, "health fraction and origin")
  # Killing it.
  let id = fight.dragonUuid.unsafeGet
  fight.setDragonKilled(newId())
  check(not fight.dragonKilled, "another uuid does not kill it")
  fight.setDragonKilled(id)
  w.dragons = @[]
  check(fight.dragonKilled and fight.previouslyKilled and fight.dragonUuid.isNone, "killed")
  check(w.podiums[^1][1], "the portal is active")
  let loc = fight.portalLocation.unsafeGet
  check(w.blocks.getOrDefault(key(loc.vec.x, loc.vec.y + 4'i32, loc.vec.z)) == "dragon_egg", "the egg on a first kill")
  check(w.gateways.len == 1 and w.gateways[0].vec.x == 77'i32 and w.gateways[0].vec.y == 75'i32 and w.gateways[0].vec.z == -57'i32,
    "the first gateway is index 19: x 77, z -57")
  check(fight.pendingGateways.len == 19, "one gateway used")
  check(w.bars[^1] == "remove" and fight.bossbarPlayers.len == 0, "the boss bar is removed")
  # Respawn needs the four crystals; the ten spike crystals are too far.
  fight.tryRespawn()
  check(not fight.isRespawning(), "the spike crystals are too far")
  w.crystals = @[]
  fight.tryRespawn()
  check(not fight.isRespawning(), "no crystals, no respawn")
  ritualCrystals(w, [newId(), newId(), newId(), newId()])
  fight.tryRespawn()
  check(fight.isRespawning() and fight.respawnStage.unsafeGet == drsStart, "the respawn begins")
  check(fight.respawnCrystalUuids.len == 4, "four ritual crystals")
  check(w.blocks.getOrDefault(key(loc.vec.x, loc.vec.y, loc.vec.z)) == "bedrock", "the podium was reset")
  # Run it: 100 + 80 + 20 ticks, with a player in range each tick.
  w.players = @[FightEntity(uuid: near, pos: at(0.0, 128.0, 0.0))]
  fight.ticksSinceLastPlayerScan = PlayerScanInterval
  var ticks = 0
  while fight.isRespawning() and ticks < 400:
    fight.tick()
    inc ticks
  check(ticks == 200, "the respawn takes 200 ticks: " & $ticks)
  check(not fight.dragonKilled and fight.dragonUuid.isSome and w.dragons.len == 1, "a new dragon")

proc abortedRespawn() =
  let w = newWorld()
  let fight = newDragonFight(fakeEnv(w))
  fight.dragonKilled = true
  fight.needsStateScanning = false
  fight.previouslyKilled = true
  fight.portalLocation = some(newBlockPos(0'i32, 64'i32, 0'i32))
  let near = newId()
  w.players = @[FightEntity(uuid: near, pos: at(0.0, 128.0, 0.0))]
  let a = newId()
  ritualCrystals(w, [a, newId(), newId(), newId()])
  fight.tryRespawn()
  check(fight.isRespawning(), "begins")
  for i in 0 ..< 10:
    fight.tick()
  check(fight.isRespawning() and fight.respawnTime > 0'i32, "running")
  # Killing a ritual crystal aborts it, and a stranger does not.
  fight.onCrystalDestroyed(newId())
  check(fight.isRespawning(), "another crystal does not abort")
  fight.onCrystalDestroyed(a)
  check(not fight.isRespawning() and fight.respawnCrystalUuids.len == 0, "a ritual crystal aborts")
  check(w.podiums[^1][1], "the portal is active again")
  # And the animation notices a missing crystal itself.
  fight.tryRespawn()
  check(fight.isRespawning(), "begins again")
  w.crystals = @[w.crystals[0], w.crystals[1], w.crystals[2]]
  fight.tick()
  check(not fight.isRespawning(), "a crystal gone aborts on the next tick")

proc staleDragon() =
  let w = newWorld()
  let fight = newDragonFight(fakeEnv(w))
  # An active exit portal exists, so the dragon was killed before and a live one is stale.
  w.blocks[key(0'i32, 60'i32, 0'i32)] = "end_portal"
  w.dragons = @[FightEntity(uuid: newId(), pos: at(0.0, 100.0, 0.0))]
  w.players = @[FightEntity(uuid: newId(), pos: at(0.0, 128.0, 0.0))]
  fight.tick()
  check(fight.previouslyKilled and fight.dragonKilled, "a completed fight")
  check(w.removed == 1, "the stale dragon was removed")
  # Upstream quirk, kept: step 4 of `tick` goes by the `dragon_killed` and `dragon_uuid` read before the scan, so on that
  # same tick it finds no dragon and spawns one although the fight is over.
  check(w.dragons.len == 1 and fight.dragonUuid.isSome, "the tick spawns a replacement from its stale snapshot")
  check(w.crystals.len == 0, "no crystals for a finished fight")
  # A resumed fight finds its dragon instead.
  let w2 = newWorld()
  let fight2 = newDragonFight(fakeEnv(w2))
  let live = newId()
  w2.dragons = @[FightEntity(uuid: live, pos: at(0.0, 100.0, 0.0))]
  w2.players = @[FightEntity(uuid: newId(), pos: at(0.0, 128.0, 0.0))]
  fight2.tick()
  check(fight2.dragonUuid.isSome and fight2.dragonUuid.unsafeGet == live and not fight2.dragonKilled, "found the live dragon")
  check(w2.dragons.len == 1, "no second dragon")

stages()
freshFight()
abortedRespawn()
staleDragon()
echo "dragon fight tests: all checks passed"
