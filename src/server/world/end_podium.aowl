## Port of pumpkin/src/world/end_podium.rs
##
## Places the End exit podium structure at `origin`: `active = false` is the bedrock rim with an air centre, placed before
## the dragon is killed; `active = true` has `END_PORTAL` tiles in the centre, placed after the kill. `podiumWrites` is the
## list of writes in upstream's order (a test reads it); `place` makes them through the world.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[math]
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../generated/block_properties
import ../../util/math/position
import ../../world/world as worldtraits
import ../serverbase
import worldmod

proc podiumWrites*(origin: BlockPos; active: bool): seq[(BlockPos, uint16)] =
  result = @[]
  let ox = origin.vec.x
  let oy = origin.vec.y
  let oz = origin.vec.z
  for y in (oy - 4'i32) .. (oy + 32'i32):
    for x in (ox - 4'i32) .. (ox + 4'i32):
      for z in (oz - 4'i32) .. (oz + 4'i32):
        let dx = float64(x - ox)
        let dy = float64(y - oy)
        let dz = float64(z - oz)
        let distSq = dx * dx + dy * dy + dz * dz
        let insideRim = distSq < 2.5 * 2.5  # inner 2-block disc
        let near = insideRim or distSq < 3.5 * 3.5  # outer rim up to 3.5
        if not near:
          continue
        let pos = BlockPos(vec: vec3[int32](x, y, z))
        var stateId = 0'u16
        if y < oy:
          stateId = asU16(if insideRim: blockBedrock().defaultState.id else: blockEndStone().defaultState.id)
        elif y > oy:
          stateId = asU16(blockAir().defaultState.id)
        else:
          if not insideRim:
            stateId = asU16(blockBedrock().defaultState.id)
          elif active:
            stateId = asU16(blockEndPortal().defaultState.id)
          else:
            stateId = asU16(blockAir().defaultState.id)
        result.add((pos, stateId))
  for y in oy .. (oy + 3'i32):
    result.add((BlockPos(vec: vec3[int32](ox, y, oz)), asU16(blockBedrock().defaultState.id)))
  # Wall torches on the N/S/E/W faces at pillar height 2.
  let torchY = oy + 2'i32
  let torches = [(0'i32, -1'i32, HorizontalFacing.North), (0'i32, 1'i32, HorizontalFacing.South),
    (-1'i32, 0'i32, HorizontalFacing.West), (1'i32, 0'i32, HorizontalFacing.East)]
  for (dx, dz, facing) in torches:
    let stateId = WallTorchLikeProperties(facing: facing).toStateId(blockWallTorch())
    result.add((BlockPos(vec: vec3[int32](ox + dx, torchY, oz + dz)), asU16(stateId)))

proc place*(world: World; origin: BlockPos; active: bool) =
  ## `place`
  for (pos, stateId) in podiumWrites(origin, active):
    discard world.setBlockState(pos, uint32(stateId), BfNotifyAll)
