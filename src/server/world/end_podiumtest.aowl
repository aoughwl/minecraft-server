## Known answers for end_podium.rs, counted from its loops: 179 positions pass `near` around an origin, 21 of them in the
## y == origin plane inside the 2.5 disc (16 on the rim of that plane), then four pillar blocks and four torches.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../generated/block_properties
import ../../util/math/position
import ../../util/vector3
import end_podium

proc stateAtLast(writes: seq[(BlockPos, uint16)]; x, y, z: int32): uint16 =
  ## The last write at a position.
  var found = 0'u16
  for (p, s) in writes:
    if p.vec.x == x and p.vec.y == y and p.vec.z == z:
      found = s
  found

proc run() =
  let origin = BlockPos(vec: vec3[int32](10'i32, 60'i32, -20'i32))
  let inactive = podiumWrites(origin, false)
  let active = podiumWrites(origin, true)
  assert inactive.len == 179 + 4 + 4
  assert active.len == inactive.len
  let bedrock = asU16(blockBedrock().defaultState.id)
  let endStone = asU16(blockEndStone().defaultState.id)
  let portal = asU16(blockEndPortal().defaultState.id)
  let air = asU16(blockAir().defaultState.id)
  var portals = 0
  for i in 0 ..< 179:
    if active[i][1] == portal:
      portals += 1
  assert portals == 21
  var portalsInactive = 0
  for (p, s) in inactive:
    if s == portal:
      portalsInactive += 1
  assert portalsInactive == 0
  # Below the origin: bedrock inside the disc (d^2 = 1 < 6.25), end stone on the rim (d^2 = 10 < 12.25).
  assert stateAtLast(inactive, 10'i32, 59'i32, -20'i32) == bedrock
  assert stateAtLast(inactive, 13'i32, 59'i32, -20'i32) == endStone
  # Above: air. In the plane: the rim (d^2 = 9) is bedrock, the centre is the portal or air (the pillar then takes it).
  assert stateAtLast(inactive, 10'i32, 61'i32, -20'i32) == bedrock  # pillar y+1
  assert stateAtLast(inactive, 12'i32, 61'i32, -20'i32) == air
  assert stateAtLast(active, 13'i32, 60'i32, -20'i32) == bedrock
  assert stateAtLast(active, 12'i32, 60'i32, -20'i32) == portal
  assert stateAtLast(inactive, 12'i32, 60'i32, -20'i32) == air
  # The pillar: origin to origin + 3; the centre is bedrock whatever `active` says.
  for y in 60'i32 .. 63'i32:
    assert stateAtLast(active, 10'i32, y, -20'i32) == bedrock
  # Torches: north (0,-1) facing north at y + 2.
  let north = asU16(WallTorchLikeProperties(facing: HorizontalFacing.North).toStateId(blockWallTorch()))
  let east = asU16(WallTorchLikeProperties(facing: HorizontalFacing.East).toStateId(blockWallTorch()))
  assert stateAtLast(active, 10'i32, 62'i32, -21'i32) == north
  assert stateAtLast(active, 11'i32, 62'i32, -20'i32) == east
  assert inactive[inactive.len - 4][0].vec.z == -21'i32
  echo "end_podium test: ok"

run()
