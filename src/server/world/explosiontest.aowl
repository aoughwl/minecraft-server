## `get_blocks_to_destroy` on an in-memory world: air stops nothing, obsidian-grade resistance survives small power.
import std/[assertions, syncio, cmdline]
import ../../config/lib as configlib
import ../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../../world/blockstates as states
import ../data/datamod
import ../recipe
import ../scheduler
import ../serverbase
import ../tick_rate_manager
import explosion, worldmod

proc scratch(): string =
  result = parentDirW(paramStr(0)) & "/explosion_scratch"
  discard createDirAllW(result)

let adv = defaultAdvancedConfiguration()
let theLevel = fromRootFolder(adv.world, scratch(), 1'i64, OVERWORLD)
let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD],
  tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
  recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
addLoadedChunk(theLevel, newChunkData(0'i32, 0'i32, newChunkSections(24, -64'i32)))
let (_, stone) = defaultStateByName("stone")
let (_, bedrockState) = defaultStateByName("bedrock")
discard setBlockState(theLevel, newBlockPos(8'i32, 64'i32, 8'i32), stone)
discard setBlockState(theLevel, newBlockPos(9'i32, 64'i32, 8'i32), bedrockState)

let center = Vector3[float64](x: 8.5, y: 65.5, z: 8.5)
let hit = getBlocksToDestroy(testWorld, center, 4.0'f32)
var sawStone = false
var sawBedrock = false
for at in hit:
  if at == newBlockPos(8'i32, 64'i32, 8'i32): sawStone = true
  if at == newBlockPos(9'i32, 64'i32, 8'i32): sawBedrock = true
assert sawStone, "stone goes"
assert not sawBedrock, "bedrock stays"
assert getBlocksToDestroy(testWorld, Vector3[float64](x: 8.5, y: 100.5, z: 8.5), 1.0'f32).len == 0, "only air around"
let removed = explodeBlocks(testWorld, center, 4.0'f32)
assert removed > 0, "explosion removed blocks"
assert getBlockStateId(testWorld, newBlockPos(8'i32, 64'i32, 8'i32)) == 0'u32, "stone gone"
assert getBlockStateId(testWorld, newBlockPos(9'i32, 64'i32, 8'i32)) == bedrockState, "bedrock stays"
echo "explosion ok"
