## What a vanilla 1.21.11 server reads from level.dat that the live server owns: the game time, the weather, the default game
## mode and hardcore. Not upstream: upstream starts every run at game time 0 and a clear sky, and leaves these keys of
## level.dat as they were read, so a save went back to a vanilla server with a stale `Time`, `raining` and `GameType`.
##
## `applyLevelExtras` reads them when a world loads, `syncLevelExtras` puts the live values into `LevelData.extra` just
## before level.dat is written (`worldinfo.levelDataToNbt` writes `extra` through, and writes `game_rules` and `spawn`
## from the typed fields).

import std/options
import ../../nbt/tag
import ../../world/worldinfo except Dimension
import ../../world/nbtget
import ../../generated/dimension
import ../serverbase

proc isOverworld(world: World): bool =
  world.dimension.minecraftName == OVERWORLD.minecraftName

var gLoadedGameType = -1'i32
  ## The configured default game mode when level.dat was read, to tell `/defaultgamemode` from the config's own value.

proc applyLevelExtras*(world: World; info: LevelData) =
  ## The game time of every dimension (vanilla keeps one for the save) and the overworld's weather, from level.dat.
  if gLoadedGameType < 0'i32 and world.server != nil:
    gLoadedGameType = int32(ord(world.server.basicConfig.defaultGamemode))
  let (hasTime, time) = nbtLong(info.extra, "Time")
  if hasTime and time > 0'i64:
    world.levelTime.worldAge = time
  if not world.isOverworld():
    return
  var w = world.weather
  let (hasRaining, raining) = nbtBool(info.extra, "raining")
  if hasRaining:
    w.raining = raining
    if raining:
      w.rainLevel = 1.0'f32
      w.oldRainLevel = 1.0'f32
  let (hasThundering, thundering) = nbtBool(info.extra, "thundering")
  if hasThundering:
    w.thundering = thundering
    if thundering:
      w.thunderLevel = 1.0'f32
      w.oldThunderLevel = 1.0'f32
  let (hasRainTime, rainTime) = nbtInt(info.extra, "rainTime")
  if hasRainTime:
    w.rainTime = rainTime
  let (hasThunderTime, thunderTime) = nbtInt(info.extra, "thunderTime")
  if hasThunderTime:
    w.thunderTime = thunderTime
  w.clearWeatherTime = info.clearWeatherTime
  world.weather = w

proc syncLevelExtras*(server: Server; info: var LevelData) =
  ## The live values into `info.extra`, for `levelDataToNbt`. `info` is the overworld's, which also holds `dayTime`.
  insert(info.extra, "Time", longTag(server.worlds[0].levelTime.worldAge))
  # The game mode and hardcore of an existing save are the save's: written only for a new one, or when the game mode was
  # changed with `/defaultgamemode` since the save was read.
  let gameType = int32(ord(server.basicConfig.defaultGamemode))
  if not info.extra.containsKey("GameType") or (gLoadedGameType >= 0'i32 and gameType != gLoadedGameType):
    insert(info.extra, "GameType", intTag(gameType))
  put(info.extra, "hardcore", boolTag(server.basicConfig.hardcore))
  let weather = server.worlds[0].weather
  info.clearWeatherTime = weather.clearWeatherTime
  insert(info.extra, "raining", boolTag(weather.raining))
  insert(info.extra, "thundering", boolTag(weather.thundering))
  insert(info.extra, "rainTime", intTag(weather.rainTime))
  insert(info.extra, "thunderTime", intTag(weather.thunderTime))
