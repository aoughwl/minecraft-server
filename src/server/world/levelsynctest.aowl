## `levelsync`: what a vanilla 1.21.11 level.dat holds that the live server owns, in and out of `LevelData.extra`.
import std/[assertions, options, tables, syncio]
import ../../nbt/tag
import ../../world/worldinfo except Dimension
import ../../world/nbtget
import ../serverbase
import weather
import levelsync

proc run() =
  var info = defaultLevelData(1'u64)
  info.extra = newCompound()
  put(info.extra, "Time", longTag(13257278'i64))
  put(info.extra, "raining", boolTag(true))
  put(info.extra, "thundering", boolTag(false))
  put(info.extra, "rainTime", intTag(9193'i32))
  put(info.extra, "thunderTime", intTag(125486'i32))
  # A world, with no level and no server: only the fields the two procs touch are needed.
  let world = World(levelInfo: info, dimension: OVERWORLD, levelTime: LevelTime(worldAge: 0'i64, timeOfDay: 6000'i64),
    weather: newWeather())
  applyLevelExtras(world, info)
  assert world.levelTime.worldAge == 13257278'i64, "line 22"
  assert world.weather.raining and not world.weather.thundering, "line 23"
  assert world.weather.rainTime == 9193'i32 and world.weather.thunderTime == 125486'i32, "line 24"
  assert world.weather.rainLevel == 1.0'f32 and world.weather.thunderLevel == 0.0'f32, "line 25"
  # The nether keeps the game time and a clear sky.
  let nether = World(levelInfo: info, dimension: THE_NETHER, levelTime: LevelTime(worldAge: 0'i64), weather: newWeather())
  applyLevelExtras(nether, info)
  assert nether.levelTime.worldAge == 13257278'i64 and not nether.weather.raining, "line 29"

  # And back out.
  world.levelTime.worldAge = 13257999'i64
  var w = world.weather
  w.raining = false
  w.thundering = true
  w.rainTime = 5'i32
  w.thunderTime = 6'i32
  world.weather = w
  var config = defaultBasicConfiguration()
  config.defaultGamemode = Creative
  config.hardcore = true
  let server = Server(basicConfig: config, worlds: @[world])
  syncLevelExtras(server, info)
  assert nbtLong(info.extra, "Time") == (true, 13257999'i64), "line 44"
  assert nbtInt(info.extra, "GameType") == (true, 1'i32), "line 45"
  assert nbtByte(info.extra, "hardcore") == (true, 1'i8), "line 46"
  assert nbtByte(info.extra, "raining") == (true, 0'i8), "line 47"
  assert nbtByte(info.extra, "thundering") == (true, 1'i8), "line 48"
  assert nbtInt(info.extra, "rainTime") == (true, 5'i32), "line 49"
  assert nbtInt(info.extra, "thunderTime") == (true, 6'i32), "line 50"
  # Written through by levelDataToNbt next to the typed fields.
  let nbt = levelDataToNbt(info)
  assert nbtLong(nbt, "Time") == (true, 13257999'i64), "line 53"
  assert nbtInt(nbt, "GameType") == (true, 1'i32), "line 54"
  echo "levelsync ok"

run()
