## Not a port of one upstream file: the half of loot.rs's callers that needs entities and a `World`.
##
## Importing this fills `gLootHook` (`LivingEntity::drop_loot`'s `loot_table.get_loot(params)`). `blockDropLoot` is
## `World::break_block`'s drop half: the `LootContextParameters` it builds and `block::drop_loot`, which
## `installBlockHooks` (block/worldhooks.aowl) hands to `BlockWorld.dropLoot0`.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/options
import "../../data/item_stack/mod"
import ../../data/block_ext
from ../../data/block_state import asU16, BlockStateId
import ../../generated/[block_loot, entity_type]
import ../../generated/attributes

import ../../util/math/position
import ../../util/vector3
import ../../util/xoroshiro128
from ../../util/random/random import getSeed
import "../block/blockbehaviour"
import ../entity/entitymod
import ../entity/experienceorb
import ../entity/itementity
import ../serverbase
import loot

gLootHook = proc(entityType: EntityType; params: LootContextParams): seq[ItemStack] {.closure.} =
  let p = LootContextParameters(
    killedByPlayer: params.killedByPlayer, thisEntity: params.thisEntity, killerEntity: params.killerEntity,
    directKillerEntity: params.directKillerEntity, position: params.position, worldTime: params.worldTime,
    damageType: params.damageType, tool: params.tool, isRaining: params.isRaining, isThundering: params.isThundering,
    isOnFire: params.isOnFire)
  getLoot(entityType.lootTable(), p)

proc blockDropLoot*(world: World; position: BlockPos; stateId: BlockStateId; cause: nil BlockPlayer;
    explosionRadius: Option[float32] = none[float32](); experience: bool = true) =
  ## `World::break_block` from `if !flags.contains(SKIP_DROPS)`: the params, then `block::drop_loot(.., experience: true, ..)`.
  var luck = 0.0'f32
  var tool = none[ItemStack]()
  if cause != nil:
    # The luck attribute of the breaking player, and what is in their hand.
    for p in world.players:
      if $p.gameprofile.id == cause.entityUuid:
        let base = playerBase(p)
        let living = base.living
        if living != nil:
          let value: float64 = living.getAttributeValue(attributes.LUCK)
          luck = float32(value)
        break
    let hand = cause.stackInHand0(0)
    if hand.itemCount > 0'u8:
      tool = some(hand)
  let blockRef = Block.fromStateId(stateId)
  let params = LootContextParameters(
    blockState: some(stateId), luck: luck, explosionRadius: explosionRadius,
    position: some(Vector3[float64](x: float64(position.vec.x), y: float64(position.vec.y), z: float64(position.vec.z))),
    worldTime: cast[uint64](world.levelInfo.dayTime), tool: tool,
    isRaining: some(world.weather.raining), isThundering: some(world.weather.thundering))
  # `block::drop_loot`
  let table = blockLootTable(asU16(blockRef.id))
  for stack in getLoot(table, params):
    callDropStack(world, position, stack)
  if experience and blockRef.hasExperience:
    var random = fromSeed(getSeed())
    # IntProvider::get: a constant is min == max; a uniform is `next_inbetween_i32`.
    let amount = if blockRef.experienceMin == blockRef.experienceMax: blockRef.experienceMin
                 else: random.nextInbetweenI32(blockRef.experienceMin, blockRef.experienceMax)
    # TODO upstream: silk touch gives no exp
    if amount > 0'i32:
      callSpawnExperienceOrb(world, Vector3[float64](x: float64(position.vec.x), y: float64(position.vec.y),
        z: float64(position.vec.z)), uint32(amount))
