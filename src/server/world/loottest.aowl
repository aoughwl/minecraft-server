## Port of pumpkin/src/world/loot.rs's tests, and known answers for the rest of it: what a block and an entity table
## give with a seeded generator, and a chest table drawn from a seed.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, options, syncio]
import "../../data/item_stack/mod"
import ../../data/block_ext
from ../../data/block_state import asU16, BlockStateId
import ../../generated/[block_properties, block_loot, chest_loot, damage_type, enchantment, entity_type, item_refs]
import ../../util/loot_table
import ../../util/xoroshiro128
import loot

proc baseParams(): LootContextParameters =
  LootContextParameters(killedByPlayer: some(true), thisEntity: some(EntityType.PIG), killerEntity: some(EntityType.PLAYER),
    directKillerEntity: some(EntityType.PLAYER), damageType: some(GENERIC))

proc ench(e: Enchantment): EnchantmentRef = EnchantmentRef(id: e.id, name: "")

proc fireAspectSword(level: int32): ItemStack =
  var sword = newItemStack(1'u8, ITEM_DIAMOND_SWORD)
  sword.enchant(ench(Enchantment.FIRE_ASPECT), level)
  sword

proc stateOf(name: string): BlockStateId =
  let b = Block.fromRegistryKey(name)
  assert b != nil
  b.defaultState.id

proc entCond(entity: string; expectedType: Option[string]; fire: Option[bool]; tag: Option[string]): LootCondition =
  LootCondition(kind: lcEntityProperties, entity: entity, expectedType: expectedType, isOnFire: fire, mainhandEnchantmentTag: tag)

proc run() =
  # --- upstream's tests ---
  var params = baseParams()
  assert entCond("this", some("minecraft:pig"), none[bool](), none[string]()).isFulfilled(params)
  assert not entCond("this", some("minecraft:cow"), none[bool](), none[string]()).isFulfilled(params)
  assert entCond("direct_attacker", none[string](), none[bool](), none[string]()).isFulfilled(params)
  params.directKillerEntity = none[EntityType]()
  assert not entCond("direct_attacker", none[string](), none[bool](), none[string]()).isFulfilled(params)
  params = baseParams()
  assert not entCond("target_entity", none[string](), none[bool](), none[string]()).isFulfilled(params)

  params.isOnFire = some(true)
  assert entCond("this", none[string](), some(true), none[string]()).isFulfilled(params)
  params.isOnFire = some(false)
  assert not entCond("this", none[string](), some(true), none[string]()).isFulfilled(params)
  assert entCond("this", none[string](), some(false), none[string]()).isFulfilled(params)
  params.isOnFire = none[bool]()
  assert not entCond("this", none[string](), some(true), none[string]()).isFulfilled(params)
  params.isOnFire = some(true)
  assert entCond("this", none[string](), none[bool](), none[string]()).isFulfilled(params)

  let smelts = some("minecraft:smelts_loot")
  params = baseParams()
  params.tool = some(fireAspectSword(1'i32))
  assert entCond("direct_attacker", none[string](), none[bool](), smelts).isFulfilled(params)
  params.tool = some(newItemStack(1'u8, ITEM_DIAMOND_SWORD))
  assert not entCond("direct_attacker", none[string](), none[bool](), smelts).isFulfilled(params)
  var sharp = newItemStack(1'u8, ITEM_DIAMOND_SWORD)
  sharp.enchant(ench(Enchantment.SHARPNESS), 5'i32)
  params.tool = some(sharp)
  assert not entCond("direct_attacker", none[string](), none[bool](), smelts).isFulfilled(params)
  params.tool = none[ItemStack]()
  assert not entCond("direct_attacker", none[string](), none[bool](), smelts).isFulfilled(params)
  params.tool = some(fireAspectSword(2'i32))
  assert entCond("direct_attacker", none[string](), none[bool](), none[string]()).isFulfilled(params)

  let anyOf = LootCondition(kind: lcAnyOf, anyOf: @[
    entCond("this", none[string](), some(true), none[string]()),
    entCond("direct_attacker", none[string](), none[bool](), smelts)])
  params = baseParams()
  params.isOnFire = some(true)
  params.tool = some(newItemStack(1'u8, ITEM_DIAMOND_SWORD))
  assert anyOf.isFulfilled(params)
  params = baseParams()
  params.isOnFire = some(false)
  params.tool = some(fireAspectSword(1'i32))
  assert anyOf.isFulfilled(params)
  params.tool = some(newItemStack(1'u8, ITEM_DIAMOND_SWORD))
  assert not anyOf.isFulfilled(params)

  # --- other conditions, hand worked from the Rust ---
  params = baseParams()
  assert LootCondition(kind: lcKilledByPlayer).isFulfilled(params)
  params.killedByPlayer = none[bool]()
  assert not LootCondition(kind: lcKilledByPlayer).isFulfilled(params)
  let inv = LootCondition(kind: lcInverted, inverted: @[LootCondition(kind: lcKilledByPlayer)])
  assert inv.isFulfilled(params)
  assert LootCondition(kind: lcAllOf, allOf: @[]).isFulfilled(params)
  assert not LootCondition(kind: lcAnyOf, anyOf: @[]).isFulfilled(params)
  assert LootCondition(kind: lcRandomChance, chance: 1.0'f32).isFulfilled(params)
  assert not LootCondition(kind: lcRandomChance, chance: 0.0'f32).isFulfilled(params)
  # time_check: world_time %= period, then the range is inclusive.
  params.worldTime = 13000'u64
  let tc = LootCondition(kind: lcTimeCheck, timeRange: (some(1000.0'f32), some(2000.0'f32)), period: some(12000'u64))
  assert tc.isFulfilled(params)
  params.worldTime = 15000'u64
  assert not tc.isFulfilled(params)
  # weather_check: missing context is false, so raining:false still matches.
  let wc = LootCondition(kind: lcWeatherCheck, raining: some(false), thundering: none[bool]())
  assert wc.isFulfilled(params)
  params.isRaining = some(true)
  assert not wc.isFulfilled(params)
  # match_tool with no item list is silk touch.
  let mt = LootCondition(kind: lcMatchTool, items: none[seq[string]]())
  assert not mt.isFulfilled(params)
  var silk = newItemStack(1'u8, ITEM_DIAMOND_PICKAXE)
  silk.enchant(ench(Enchantment.SILK_TOUCH), 1'i32)
  params.tool = some(silk)
  assert mt.isFulfilled(params)
  assert LootCondition(kind: lcMatchTool, items: some(@["minecraft:diamond_pickaxe"])).isFulfilled(params)
  assert not LootCondition(kind: lcMatchTool, items: some(@["minecraft:stone"])).isFulfilled(params)
  # survives_explosion: no radius is true, radius 1 always survives (draw <= 1/1).
  assert LootCondition(kind: lcSurvivesExplosion).isFulfilled(params)
  params.explosionRadius = some(1.0'f32)
  assert LootCondition(kind: lcSurvivesExplosion).isFulfilled(params)
  # location_check is true only without a biome.
  assert LootCondition(kind: lcLocationCheck, expectedBiome: none[string]()).isFulfilled(params)
  assert not LootCondition(kind: lcLocationCheck, expectedBiome: some("minecraft:plains")).isFulfilled(params)
  assert not LootCondition(kind: lcEntityScores, scoresEntity: "this").isFulfilled(params)
  assert not LootCondition(kind: lcReference, name: "x").isFulfilled(params)

  # --- block tables ---
  let stoneState = stateOf("stone")
  var bp = LootContextParameters(blockState: some(stoneState))
  # stone: alternatives(stone with silk touch, cobblestone if it survives); no tool gives cobblestone.
  var got = getLoot(blockLootTableByName("stone"), bp)
  assert got.len == 1
  assert got[0].item.registryKey == "cobblestone"
  assert got[0].itemCount == 1'u8
  bp.tool = some(silk)
  got = getLoot(blockLootTableByName("stone"), bp)
  assert got.len == 1
  assert got[0].item.registryKey == "stone"
  bp.tool = some(newItemStack(1'u8, ITEM_DIAMOND_PICKAXE))
  got = getLoot(blockLootTableByName("stone"), bp)
  assert got[0].item.registryKey == "cobblestone"
  got = getLoot(blockLootTableByName("dirt"), LootContextParameters(blockState: some(stateOf("dirt"))))
  assert got.len == 1 and got[0].item.registryKey == "dirt"

  # --- entity tables: a pig drops 1..3 porkchops ---
  seedLootRandom(12345'u64)
  var counts = newSeq[int](4)
  for i in 0 ..< 200:
    let drop = getLoot(EntityType.PIG.lootTable(), baseParams())
    var chops = 0
    for s in drop:
      assert s.item.registryKey == "porkchop" or s.item.registryKey == "cooked_porkchop"
      chops += int(s.itemCount)
    assert chops >= 1 and chops <= 3
    counts[chops] += 1
  assert counts[1] > 0 and counts[2] > 0 and counts[3] > 0

  # getLootWith: the table's own random is the caller's; the same seeds give the same drop.
  var r1 = fromSeed(77'u64)
  var r2 = fromSeed(77'u64)
  seedLootRandom(5'u64)
  let a = getLootWith(EntityType.PIG.lootTable(), baseParams(), r1)
  seedLootRandom(5'u64)
  let b = getLootWith(EntityType.PIG.lootTable(), baseParams(), r2)
  assert a.len == b.len
  for i in 0 ..< a.len:
    assert a[i].itemCount == b[i].itemCount and a[i].item.registryKey == b[i].item.registryKey

  # --- chest loot: deterministic in the seed ---
  let table = getChestLootTable("minecraft:chests/simple_dungeon")
  assert table.isSome
  let c1 = generateChestLoot(table.unsafeGet, 42'i64)
  let c2 = generateChestLoot(table.unsafeGet, 42'i64)
  assert c1.len == c2.len and c1.len > 0
  for i in 0 ..< c1.len:
    assert c1[i].item.registryKey == c2[i].item.registryKey and c1[i].itemCount == c2[i].itemCount
  let filled = fillChestInventory(table.unsafeGet, 42'i64, 27)
  assert filled.len >= c1.len
  var seen = newSeq[bool](27)
  for (slot, stack) in filled:
    assert slot >= 0 and slot < 27
    assert not seen[slot]
    seen[slot] = true
  var total1 = 0
  for s in c1: total1 += int(s.itemCount)
  var total2 = 0
  for (slot, s) in filled: total2 += int(s.itemCount)
  assert total1 == total2
  echo "loot test: ok"

run()
