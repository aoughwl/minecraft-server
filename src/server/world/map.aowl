## Port of pumpkin/src/world/map.rs
##
## `DashMap<i32, Arc<Mutex<MapData>>>` is a `Table[int32, MapData]` of ref objects; one thread ticks the world.
## `update` reads the world through `getTopBlock` and `getBlock`, as upstream does.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[tables, options]
import ../../data/block_ext
import ../../generated/dimension
import ../../util/math/position
import ../../util/vector2
import ../serverbase
import worldmod

const MapSide* = 128

type
  MapData* = ref object
    scale*: int8
    locked*: bool
    dimension*: Dimension
    centerX*: int32
    centerZ*: int32
    colors*: seq[uint8]  ## 128 * 128
    dirty*: bool
    fullyUpdated*: bool

  MapManager* = ref object
    maps*: Table[int32, MapData]

proc newMapData*(dimension: Dimension; x, z: int32; scale: int8): MapData =
  MapData(scale: scale, locked: false, dimension: dimension, centerX: x, centerZ: z,
    colors: newSeq[uint8](MapSide * MapSide), dirty: true, fullyUpdated: false)

proc newMapManager*(): MapManager =
  MapManager(maps: initTable[int32, MapData]())

proc getMap*(self: MapManager; id: int32): Option[MapData] =
  if self.maps.hasKey(id): some(self.maps.getOrDefault(id)) else: none[MapData]()

proc createMap*(self: MapManager; id: int32; dimension: Dimension; x, z: int32; scale: int8): MapData =
  result = newMapData(dimension, x, z, scale)
  self.maps[id] = result

proc setColor*(self: MapData; x, z: int; color: uint8) =
  if x >= 0 and x < MapSide and z >= 0 and z < MapSide:
    let idx = z * MapSide + x
    if self.colors[idx] != color:
      self.colors[idx] = color
      self.dirty = true

proc update*(self: MapData; player: Player) =
  let world = player.world
  let scale = 1'i32 shl int32(self.scale)
  let centerX = self.centerX
  let centerZ = self.centerZ
  let playerPos = player.pos
  let playerX = int32(playerPos.x)
  let playerZ = int32(playerPos.z)
  let startImgX = int(clamp((playerX - centerX) div scale + 64'i32, 0'i32, 127'i32))
  let startImgZ = int(clamp((playerZ - centerZ) div scale + 64'i32, 0'i32, 127'i32))
  let radius = 16
  var loX = 0
  var hiX = MapSide
  var loZ = 0
  var hiZ = MapSide
  if self.fullyUpdated:
    loX = max(startImgX - radius, 0)
    hiX = min(startImgX + radius, MapSide)
    loZ = max(startImgZ - radius, 0)
    hiZ = min(startImgZ + radius, MapSide)
  else:
    self.fullyUpdated = true
  for imgX in loX ..< hiX:
    var prevY = -1'i32
    for imgZ in loZ ..< hiZ:
      let worldX = (int32(imgX) - 64'i32) * scale + centerX
      let worldZ = (int32(imgZ) - 64'i32) * scale + centerZ
      let topY = world.getTopBlock(Vector2[int32](x: worldX, y: worldZ))
      let blk = world.getBlock(BlockPos(vec: vec3[int32](worldX, topY, worldZ)))
      let colorBase = blk.mapColor
      var brightness = 2'u8  # Normal
      if prevY != -1'i32:
        if topY > prevY:
          brightness = 3'u8  # High
        elif topY < prevY:
          brightness = 1'u8  # Low
      prevY = topY
      self.setColor(imgX, imgZ, colorBase * 4'u8 + brightness)
