## Port of pumpkin/src/entity/player.rs: `Player::tick_maps`, and the `Server::map_manager` and `Server::next_map_id` that
## it and pumpkin/src/item/items/map.rs (server/item/placing_items.aowl) reach through `gItemHooks`.
##
## serverbase.aowl's `Server` has no `map_manager` field, so the one manager of the process is `gMapManager` here (a server
## has one), and `Server::next_map_id` is `gNextMapId` (upstream also writes the counter to `LevelData::map_id`, which this
## port's level data does not carry, so map ids start again at 0 with the process, as the maps themselves do).

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[math, options]
import "../../data/item_stack/mod"
import ../../generated/item_full
import ../../inventory/[inventory, player_inventory]
import ../../protocol/java/client/play/map_item_data
import ../../protocol/varint
import ../../util/vector3
import ../entity/player
import ../item/itembehaviour
import ../serverbase
import map

var gMapManager* = newMapManager()
var gNextMapId* = 0'i32

proc nextMapId*(): int32 =
  ## `Server::next_map_id`
  result = gNextMapId
  inc gNextMapId

proc mapIconFor*(map: MapData; pos: Vector3[float64]; yaw: float32): MapIcon =
  ## The white pointer `tick_maps` shows for the holder.
  let scale = 1'i32 shl int32(map.scale)
  let dx = pos.x - float64(map.centerX)
  let dz = pos.z - float64(map.centerZ)
  let iconX = int8(clamp(dx / float64(scale) * 2.0, -128.0, 127.0))
  let iconZ = int8(clamp(dz / float64(scale) * 2.0, -128.0, 127.0))
  let step = int32(round(float64(yaw * 16.0'f32 / 360.0'f32)))
  let direction = int8(((step + 8'i32) mod 16'i32 + 16'i32) mod 16'i32)
  MapIcon(iconType: newVarInt(0'i32), x: iconX, z: iconZ, direction: direction, displayName: none[string]())

proc tickMapOf(self: Player; stack: ItemStack) =
  if stack.item.id != ITEM_FILLED_MAP.id:
    return
  let (hasId, idComponent) = stack.getDataComponent(MapIdImpl)
  if not hasId:
    return
  let mapId = idComponent.id
  let found = gMapManager.getMap(mapId)
  if found.isNone:
    return
  let mapData = found.unsafeGet
  mapData.update(self)
  if mapData.dirty or self.tickCounter mod 10'i32 == 0'i32:
    let icons = @[mapIconFor(mapData, self.pos, self.yaw)]
    var patch = none[MapPatch]()
    if mapData.dirty:
      patch = some(MapPatch(columns: 128'u8, rows: 128'u8, x: 0'i8, z: 0'i8, data: mapData.colors))
    self.client.writePacketFor(CMapItemData(mapId: newVarInt(mapId), scale: mapData.scale, locked: mapData.locked,
      icons: some(icons), data: patch))
    mapData.dirty = false

proc tickMaps*(self: Player) =
  ## `Player::tick_maps`: both hands, main hand first.
  self.tickMapOf(self.inventory.heldItem())
  self.tickMapOf(self.inventory.offHandItem())

proc installMapHooks*() =
  gItemHooks.nextMapId = proc(server: Server): int32 {.closure.} = nextMapId()
  gItemHooks.createMap = proc(server: Server; mapId: int32; world: World; x, z: int32; scale: uint8) {.closure.} =
    discard gMapManager.createMap(mapId, world.dimension, x, z, int8(scale))

installMapHooks()
