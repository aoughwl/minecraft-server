## Known answers for map.rs: the manager, `set_color`'s bounds and dirty flag.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, options, syncio]
import ../../generated/dimension
import map

proc run() =
  let m = newMapManager()
  assert m.getMap(3'i32).isNone
  let d = m.createMap(3'i32, THE_NETHER, 64'i32, -128'i32, 2'i8)
  assert m.getMap(3'i32).isSome
  assert d.scale == 2'i8 and d.centerX == 64'i32 and d.centerZ == -128'i32
  assert d.colors.len == 128 * 128
  assert d.dirty and not d.fullyUpdated and not d.locked
  d.dirty = false
  d.setColor(5, 7, 9'u8)
  assert d.colors[7 * 128 + 5] == 9'u8 and d.dirty
  d.dirty = false
  d.setColor(5, 7, 9'u8)  # the same colour: not dirty again
  assert not d.dirty
  d.setColor(128, 0, 1'u8)  # out of bounds: ignored
  d.setColor(0, 128, 1'u8)
  assert not d.dirty
  d.setColor(127, 127, 4'u8)
  assert d.colors[127 * 128 + 127] == 4'u8 and d.dirty
  echo "map test: ok"

run()
