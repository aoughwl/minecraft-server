## Known answers for natural_spawner.rs, worked from the Rust: the mob caps, the category filter, the potential energy of a
## charge, the distance rules and which blocks a mob may spawn inside. The parts that read a world (the biome's spawners,
## the heightmap) are what the `--world` scenario of tools/mcbot.py shows.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, math, syncio]
import ../../data/block_ext
from ../../data/block_state import newBlockStateIdUnchecked, BlockState, asU16
import ../../world/generation/protochunkbase
import ../../generated/[block_properties, entity_type]
import ../../util/math/position
import ../../util/vector2
import ../../util/vector3
import ../serverbase
import natural_spawner

proc stateOfBlock(b: Block): BlockState = BlockState.fromId(b.defaultState.id)

proc ids(cats: seq[MobCategory]): seq[int] =
  result = @[]
  for c in cats: result.add(c.id)

proc run() =
  # MobCounts: a category may spawn while its count is under its max (monster 70).
  var counts = MobCounts()
  assert counts.canSpawn(MobCategory.MONSTER)
  for i in 0 ..< 70:
    counts.add(MobCategory.MONSTER)
  assert not counts.canSpawn(MobCategory.MONSTER)
  counts.remove(MobCategory.MONSTER)
  assert counts.canSpawn(MobCategory.MONSTER)
  assert counts.counts[MobCategory.MONSTER.id] == 69'i32

  # The global cap is max * chunks / 289: 17 * 17 chunks give the category's own max.
  let state = emptySpawnState()
  state.spawnableChunkCount = 289'i32
  assert state.canSpawnForCategoryGlobal(MobCategory.MONSTER)
  state.mobCategoryCounts.counts[MobCategory.MONSTER.id] = 70'i32
  assert not state.canSpawnForCategoryGlobal(MobCategory.MONSTER)
  # 70 * 100 / 289 = 24 (integer division): 24 monsters in 100 chunks stop it, 23 do not.
  state.spawnableChunkCount = 100'i32
  state.mobCategoryCounts.counts[MobCategory.MONSTER.id] = 23'i32
  assert state.canSpawnForCategoryGlobal(MobCategory.MONSTER)
  state.mobCategoryCounts.counts[MobCategory.MONSTER.id] = 24'i32
  assert not state.canSpawnForCategoryGlobal(MobCategory.MONSTER)

  # The filter: friendly and persistent categories need spawn_passives, enemies need spawn_enemies.
  let open = emptySpawnState()
  open.spawnableChunkCount = 289'i32
  assert ids(getFilteredSpawningCategories(open, true, true, false)) == @[0, 2, 3, 4, 6]
  assert ids(getFilteredSpawningCategories(open, true, true, true)) == @[0, 1, 2, 3, 4, 5, 6]
  assert ids(getFilteredSpawningCategories(open, true, false, false)) == @[2, 3, 4, 6]
  assert ids(getFilteredSpawningCategories(open, false, true, true)) == @[0]
  assert getFilteredSpawningCategories(open, false, false, true).len == 0
  # A full category drops out.
  open.mobCategoryCounts.counts[MobCategory.AMBIENT.id] = 15'i32
  assert ids(getFilteredSpawningCategories(open, true, true, false)) == @[0, 3, 4, 6]

  # The spawn potential: a charge of 2 at (3, 4, 0) from one of 1 at the origin: 1 / 5 * 2.
  var potential = PotentialCalculator()
  potential.addCharge(BlockPos(vec: vec3[int32](0'i32, 0'i32, 0'i32)), 1.0)
  potential.addCharge(BlockPos(vec: vec3[int32](9'i32, 9'i32, 9'i32)), 0.0)  # a zero charge is not kept
  assert potential.charges.len == 1
  let change = potential.getPotentialEnergyChange(BlockPos(vec: vec3[int32](3'i32, 4'i32, 0'i32)), 2.0)
  assert abs(change - 0.4) < 1e-12
  assert potential.getPotentialEnergyChange(BlockPos(vec: vec3[int32](3'i32, 4'i32, 0'i32)), 0.0) == 0.0
  potential.removeCharge(BlockPos(vec: vec3[int32](0'i32, 0'i32, 0'i32)), 1.0)
  assert potential.charges.len == 0

  # The per-player cap's distance: the centre of chunk (0, 0) is (8, 8); a player 128 blocks away is not near (< 16384).
  assert calcDistance(Vector2[int32](x: 0'i32, y: 0'i32), Vector3[float64](x: 8.0, y: 70.0, z: 8.0)) == 0.0
  assert calcDistance(Vector2[int32](x: 0'i32, y: 0'i32), Vector3[float64](x: 136.0, y: 70.0, z: 8.0)) == 16384.0
  assert calcDistance(Vector2[int32](x: 1'i32, y: -1'i32), Vector3[float64](x: 0.0, y: 0.0, z: 0.0)) == 24.0 * 24.0 + 8.0 * 8.0

  # The nearest player is a squared distance; none is f64::MAX.
  assert getNearestPlayer(Vector3[float64](x: 0.0, y: 0.0, z: 0.0), @[]) == 1.7976931348623157e308
  assert getNearestPlayer(Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    @[Vector3[float64](x: 3.0, y: 4.0, z: 0.0), Vector3[float64](x: 1.0, y: 1.0, z: 1.0)]) == 3.0

  # The distance rules: more than 24 from every player and from the origin, and inside the chunk.
  let far = BlockPos(vec: vec3[int32](100'i32, 64'i32, 100'i32))
  let chunk = Vector2[int32](x: 6'i32, y: 6'i32)
  assert isRightDistanceToPlayerAndSpawnPoint(far, 24.0 * 24.0 + 1.0, chunk)
  assert not isRightDistanceToPlayerAndSpawnPoint(far, 24.0 * 24.0, chunk)
  assert not isRightDistanceToPlayerAndSpawnPoint(far, 1e9, Vector2[int32](x: 7'i32, y: 6'i32))
  assert not isRightDistanceToPlayerAndSpawnPoint(BlockPos(vec: vec3[int32](10'i32, 0'i32, 10'i32)), 1e9,
    Vector2[int32](x: 0'i32, y: 0'i32))

  # A mob may spawn inside air and not inside a full block, a liquid, or a block that prevents it.
  assert isValidEmptySpawnBlock(stateOfBlock(blockAir()))
  assert not isValidEmptySpawnBlock(stateOfBlock(blockStone()))
  assert not isValidEmptySpawnBlock(stateOfBlock(blockWater()))

  # The generation cache half: stone up to y 63, air above. A cow stands on the surface at y 64; a pig below ground does not.
  let stoneId = blockStone().defaultState.id
  let flatCache = GenerationCache(
    getBlockState: proc(pos: Vector3[int32]): uint32 {.closure.} =
      if pos.y <= 63'i32: uint32(asU16(stoneId)) else: 0'u32,
    getTopY: proc(heightmap: HeightMap; x, z: int32): int32 {.closure.} = 64'i32)
  let cow = EntityType.COW
  let topPos = getTopNonCollidingPos(World(players: @[]), flatCache, cow, 3'i32, 5'i32)
  assert topPos.vec.x == 3'i32 and topPos.vec.y == 64'i32 and topPos.vec.z == 5'i32, "the surface, a full cube below"
  assert isSpawnPositionOkCache(flatCache, topPos, cow), "a cow stands on stone with air around"
  assert not isSpawnPositionOkCache(flatCache, BlockPos(vec: vec3[int32](3'i32, 10'i32, 5'i32)), cow), "inside stone, no"
  assert adjustSpawnPositionCache(flatCache, topPos, cow) == topPos, "a full cube below keeps the position"

  # An empty cap calculator: no players near means nothing can spawn locally.
  let world = World(players: @[])
  assert not emptySpawnState().canSpawnForCategoryLocal(world, MobCategory.MONSTER, Vector2[int32](x: 0'i32, y: 0'i32))
  echo "natural_spawner test: ok"

run()
