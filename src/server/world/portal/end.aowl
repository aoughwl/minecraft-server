## Port of pumpkin/src/world/portal/end.rs
##
## `&Arc<World>` is the `BlockWorld` blocks get, as in nether.aowl. `BlockDirection::horizontal()` answers
## `HorizontalFacing`s here (`blockDirectionHorizontal`), which carry the same `to_offset` and rotations.

{.feature: "untyped".}
{.feature: "lenientnils".}

import "../../block/blockprelude"

proc isEndFrame(blockRef: Block): bool = blockRef == blockEndPortalFrame()

proc getMidPos(world: BlockWorld; pos: BlockPos): Option[BlockPos] =
  let (blockRef, state) = world.getBlockAndStateId(pos)
  if not isEndFrame(blockRef):
    return none[BlockPos]()
  let properties = EndPortalFrameLikeProperties.fromStateId(state, blockRef)
  let facingDir = properties.facing
  let leftPos = pos.offsetDir(facingDir.rotateClockwise().toOffset(), 1'i32)
  let rightPos = pos.offsetDir(facingDir.rotateCounterClockwise().toOffset(), 1'i32)
  let leftFrame = isEndFrame(world.getBlock(leftPos))
  let rightFrame = isEndFrame(world.getBlock(rightPos))
  var offset = 0'i32
  if leftFrame and rightFrame:
    offset = 0'i32  # Middle block
  elif leftFrame:
    offset = -1'i32  # Right block (offset left)
  elif rightFrame:
    offset = 1'i32  # Left block (offset right)
  else:
    return none[BlockPos]()
  some(pos.offsetDir(facingDir.toOffset(), 2'i32).offsetDir(facingDir.rotateCounterClockwise().toOffset(), offset))

proc isValidPortal*(world: BlockWorld; pos: BlockPos): bool =
  let dirs = blockDirectionHorizontal()
  for dir in dirs:
    let midPos = pos.offsetDir(dir.toOffset(), 2'i32)
    let leftPos = midPos.offsetDir(dir.rotateClockwise().toOffset(), 1'i32)
    let rightPos = midPos.offsetDir(dir.rotateCounterClockwise().toOffset(), 1'i32)
    let (midBlock, midState) = world.getBlockAndStateId(midPos)
    let (leftBlock, leftState) = world.getBlockAndStateId(leftPos)
    let (rightBlock, rightState) = world.getBlockAndStateId(rightPos)
    if not isEndFrame(leftBlock) or not isEndFrame(midBlock) or not isEndFrame(rightBlock):
      return false
    let midProperties = EndPortalFrameLikeProperties.fromStateId(midState, midBlock)
    let leftProperties = EndPortalFrameLikeProperties.fromStateId(leftState, leftBlock)
    let rightProperties = EndPortalFrameLikeProperties.fromStateId(rightState, rightBlock)
    let facing = dir
    if leftProperties.facing != facing.opposite() or midProperties.facing != facing.opposite() or
        rightProperties.facing != facing.opposite():
      return false
    if not leftProperties.eye or not midProperties.eye or not rightProperties.eye:
      return false
  true

proc createPortal(world: BlockWorld; pos: BlockPos) =
  let state = blockEndPortal().defaultState.id
  for x in -1'i32 .. 1'i32:
    for z in -1'i32 .. 1'i32:
      discard world.setBlockState(pos.offset(vec3[int32](x, 0'i32, z)), state, BfNotifyListeners)

proc endPortalGetNewPortal*(world: BlockWorld; pos: BlockPos) =
  ## `EndPortal::get_new_portal`: called with the frame that was just filled with an eye.
  let midPos = getMidPos(world, pos)
  if midPos.isSome and isValidPortal(world, midPos.unsafeGet):
    createPortal(world, midPos.unsafeGet)
