## Known answers for portal/nether.rs and portal/end.rs, worked from the Rust by hand: a 2x3 frame found and its numbers,
## the portal made, searched for and found again, the safe location search on a flat world, its fallback, and an end frame.

{.feature: "untyped".}
{.feature: "lenientnils".}

import std/[assertions, syncio]
import "../../block/blockprelude"
import "../../block/testworld"
import ../../../generated/dimension
import ../../../util/math/boundingbox
import "end"
import nether

type PoiBook = ref object
  added: seq[BlockPos]

proc makeWorld(book: PoiBook): TestWorld =
  let t = newTestWorld(newBlockRegistry())
  t.world.dimension = THE_NETHER
  t.world.minY = 0'i32
  t.world.portalPoiAdd0 = proc(pos: BlockPos) {.closure.} = book.added.add(pos)
  t.world.portalPoiRemove0 = proc(pos: BlockPos) {.closure.} = discard
  t.world.portalPoiInSquare0 = proc(center: BlockPos; radius: int32): seq[BlockPos] {.closure.} =
    result = @[]
    for p in book.added:
      if abs(p.vec.x - center.vec.x) <= radius and abs(p.vec.z - center.vec.z) <= radius:
        result.add(p)
  t

proc obsidianFrame(t: TestWorld) =
  # Inside x 0..1, y 64..66 on z 0: the frame is x -1 and 2, y 63 and 67.
  for y in 63'i32 .. 67'i32:
    for x in -1'i32 .. 2'i32:
      let edge = x == -1'i32 or x == 2'i32 or y == 63'i32 or y == 67'i32
      if edge:
        t.put(blockPos(x, y, 0'i32), blockObsidian())

proc run() =
  # --- a frame is found and measured ---
  let book = PoiBook(added: @[])
  let t = makeWorld(book)
  obsidianFrame(t)
  let found = getOnAxis(t.world, blockPos(0'i32, 64'i32, 0'i32), HorizontalAxis.X)
  assert found.isSome
  let portal = found.unsafeGet
  assert portal.width == 2'u32
  assert portal.height == 3'u32
  assert portal.lowerConor == blockPos(1'i32, 64'i32, 0'i32)
  assert portal.axis == HorizontalAxis.X
  assert portal.foundPortalBlocks == 0'u32
  assert portal.isValid()
  assert not portal.wasAlreadyValid()
  # The Z axis of the same spot has no frame.
  assert getOnAxis(t.world, blockPos(0'i32, 64'i32, 0'i32), HorizontalAxis.Z).isNone
  # getNewPortal tries X first.
  let fresh = getNewPortal(t.world, blockPos(0'i32, 64'i32, 0'i32), HorizontalAxis.X)
  assert fresh.isSome and fresh.unsafeGet.axis == HorizontalAxis.X
  # A gap in the top bar makes no portal.
  t.put(blockPos(0'i32, 67'i32, 0'i32), blockAir())
  assert getOnAxis(t.world, blockPos(0'i32, 64'i32, 0'i32), HorizontalAxis.X).isNone
  t.put(blockPos(0'i32, 67'i32, 0'i32), blockObsidian())

  # --- creating it fills six portal blocks and records them ---
  portal.create(t.world)
  assert book.added.len == 6
  for y in 64'i32 .. 66'i32:
    for x in 0'i32 .. 1'i32:
      assert t.world.getBlock(blockPos(x, y, 0'i32)) == blockNetherPortal()
  assert NetherPortalLikeProperties.fromStateId(t.world.getBlockStateId(blockPos(0'i32, 64'i32, 0'i32)), blockNetherPortal()).axis ==
    HorizontalAxis.X
  let again = getOnAxis(t.world, blockPos(1'i32, 65'i32, 0'i32), HorizontalAxis.X)
  assert again.isSome and again.unsafeGet.wasAlreadyValid()
  assert again.unsafeGet.foundPortalBlocks == 6'u32

  # --- searching: the nearest recorded portal block, then its frame ---
  let hit = searchForPortal(t.world, blockPos(10'i32, 64'i32, 3'i32))
  assert hit.isSome
  assert hit.unsafeGet.lowerCorner == blockPos(1'i32, 64'i32, 0'i32)
  assert hit.unsafeGet.width == 2'u32 and hit.unsafeGet.height == 3'u32 and hit.unsafeGet.axis == HorizontalAxis.X
  let tp = hit.unsafeGet.getTeleportPosition()
  assert tp.x == 2.0 and tp.y == 64.0 and tp.z == 0.5
  # Out of radius: nothing.
  assert searchForPortal(t.world, blockPos(500'i32, 64'i32, 0'i32)).isNone

  # --- yaw and the exit position ---
  assert hit.unsafeGet.calculateTeleportYaw(30.0'f32, none[HorizontalAxis]()) == 30.0'f32
  assert hit.unsafeGet.calculateTeleportYaw(30.0'f32, some(HorizontalAxis.X)) == 30.0'f32
  assert hit.unsafeGet.calculateTeleportYaw(30.0'f32, some(HorizontalAxis.Z)) == -60.0'f32
  let dims = newEntityDimensions(0.6'f32, 1.8'f32, 1.62'f32)
  # An entity in the middle of the opening: progress 0.5 along, 0 up, none across.
  let rel = hit.unsafeGet.entityPosInPortal(Vector3[float64](x: 2.0, y: 64.0, z: 0.5), dims)
  assert abs(rel.x - 0.5) < 1e-6 and rel.y == 0.0 and rel.z == 0.0
  # Entering at the west end of the opening clamps to 0, as the lower corner is the east end.
  assert hit.unsafeGet.entityPosInPortal(Vector3[float64](x: 1.0, y: 64.0, z: 0.5), dims).x == 0.0
  let back = hit.unsafeGet.calculateExitPosition(Vector3[float64](x: 0.0, y: 0.0, z: 0.0), dims)
  # axis_offset is width/2 of the entity (0.3): lower.x + 0.3, lower.y, lower.z + 0.5.
  assert abs(back.x - 1.3) < 1e-6 and back.y == 64.0 and abs(back.z - 0.5) < 1e-9

  # --- the safe location search on a flat world: ground at y 63, the heightmap above it ---
  let book2 = PoiBook(added: @[])
  let flat = makeWorld(book2)
  for x in -34'i32 .. 34'i32:
    for z in -34'i32 .. 34'i32:
      flat.put(blockPos(x, 63'i32, z), blockStone())
  flat.world.motionBlockingHeight0 = proc(x, z: int32): int32 {.closure.} = 70'i32
  let safe = findSafeLocation(flat.world, blockPos(0'i32, 64'i32, 0'i32), HorizontalAxis.X)
  assert safe.isSome
  assert safe.unsafeGet[0] == blockPos(0'i32, 64'i32, 0'i32)
  assert safe.unsafeGet[1] == HorizontalAxis.X
  assert not safe.unsafeGet[2]
  buildPortalFrame(flat.world, safe.unsafeGet[0], safe.unsafeGet[1], safe.unsafeGet[2])
  assert book2.added.len == 6
  assert flat.world.getBlock(blockPos(-1'i32, 65'i32, 0'i32)) == blockObsidian()
  assert flat.world.getBlock(blockPos(2'i32, 66'i32, 0'i32)) == blockObsidian()
  assert flat.world.getBlock(blockPos(0'i32, 63'i32, 0'i32)) == blockObsidian()
  assert flat.world.getBlock(blockPos(1'i32, 67'i32, 0'i32)) == blockObsidian()
  assert flat.world.getBlock(blockPos(0'i32, 65'i32, 0'i32)) == blockNetherPortal()
  assert flat.world.getBlock(blockPos(1'i32, 66'i32, 0'i32)) == blockNetherPortal()
  # The frame the search built is found by the search for portals (its lower corner is its east end).
  let built = searchForPortal(flat.world, blockPos(4'i32, 64'i32, 4'i32))
  assert built.isSome and built.unsafeGet.lowerCorner == blockPos(1'i32, 64'i32, 0'i32)

  # --- the fallback: nothing valid (no ground anywhere) clamps y to 70..top-9 and builds a platform ---
  let book3 = PoiBook(added: @[])
  let empty = makeWorld(book3)
  empty.world.motionBlockingHeight0 = proc(x, z: int32): int32 {.closure.} = 70'i32
  let fb = findSafeLocation(empty.world, blockPos(8'i32, 64'i32, 8'i32), HorizontalAxis.X)
  assert fb.isSome
  # Nether: top limit is min(0 + 128 - 1, 255) = 127; clamp(64, max(0, 70), 118) = 70; X direction East is (1,0,0).
  assert fb.unsafeGet[0] == blockPos(7'i32, 70'i32, 8'i32)
  assert fb.unsafeGet[1] == HorizontalAxis.X
  assert fb.unsafeGet[2]
  buildPortalFrame(empty.world, fb.unsafeGet[0], fb.unsafeGet[1], true)
  # The platform under it and the cleared air; the frame's bottom row replaces the platform at x 6..9.
  assert empty.world.getBlock(blockPos(7'i32, 69'i32, 7'i32)) == blockObsidian()
  assert empty.world.getBlock(blockPos(7'i32, 69'i32, 9'i32)) == blockObsidian()
  assert empty.world.getBlock(blockPos(8'i32, 71'i32, 7'i32)).isAir()
  assert empty.world.getBlock(blockPos(7'i32, 70'i32, 8'i32)) == blockNetherPortal()

  # --- an end portal: twelve frames with eyes make a 3x3 of portal blocks ---
  let endWorld = newTestWorld(newBlockRegistry())
  let centre = blockPos(0'i32, 60'i32, 0'i32)
  proc frameState(facing: HorizontalFacing; eye: bool): BlockStateId =
    EndPortalFrameLikeProperties(eye: eye, facing: facing).toStateId(blockEndPortalFrame())
  # Frames face the centre: the north row at z=-2 faces South, the south row at z=2 faces North, and so on.
  for i in -1'i32 .. 1'i32:
    endWorld.put(blockPos(i, 60'i32, -2'i32), frameState(HorizontalFacing.South, true))
    endWorld.put(blockPos(i, 60'i32, 2'i32), frameState(HorizontalFacing.North, true))
    endWorld.put(blockPos(-2'i32, 60'i32, i), frameState(HorizontalFacing.East, true))
    endWorld.put(blockPos(2'i32, 60'i32, i), frameState(HorizontalFacing.West, true))
  assert isValidPortal(endWorld.world, centre)
  endPortalGetNewPortal(endWorld.world, blockPos(1'i32, 60'i32, -2'i32))
  for x in -1'i32 .. 1'i32:
    for z in -1'i32 .. 1'i32:
      assert endWorld.world.getBlock(blockPos(x, 60'i32, z)) == blockEndPortal()
  # An eye missing: no portal.
  let noEye = newTestWorld(newBlockRegistry())
  for i in -1'i32 .. 1'i32:
    noEye.put(blockPos(i, 60'i32, -2'i32), frameState(HorizontalFacing.South, i != 0))
    noEye.put(blockPos(i, 60'i32, 2'i32), frameState(HorizontalFacing.North, true))
    noEye.put(blockPos(-2'i32, 60'i32, i), frameState(HorizontalFacing.East, true))
    noEye.put(blockPos(2'i32, 60'i32, i), frameState(HorizontalFacing.West, true))
  assert not isValidPortal(noEye.world, centre)
  echo "portal test: ok"

run()
