## Port of pumpkin/src/world/scoreboard.rs
##
## The Java half. Maps are seqs of entries, as there are few; `World` holds no scoreboard yet, since nothing but commands
## changes one, so a caller passes its own.

{.feature: "untyped".}

import std/[options, syncio]
import ../../generated/scoreboard_slot
import ../../protocol/java/client/play/[display_objective, set_player_team, update_objectives, update_score]
import ../../protocol/proto
import ../../util/text/color
import ../../util/text/text
import ../serverbase

type
  ScoreboardObjective* = object
    name*: string
    displayName*: TextComponent
    renderType*: RenderType
    numberFormat*: Option[NumberFormat]
    criterion*: string

  ScoreboardScore* = object
    entityName*: string
    objectiveName*: string
    value*: VarInt
    displayName*: Option[TextComponent]
    numberFormat*: Option[NumberFormat]
    locked*: bool

  NameTagVisibility* = enum
    ntvAlways
    ntvNever
    ntvHideForOtherTeams
    ntvHideForOwnTeam

  CollisionRule* = enum
    crAlways
    crNever
    crPushOtherTeams
    crPushOwnTeam

  Team* = object
    name*: string
    displayName*: TextComponent
    options*: int8
    nametagVisibility*: NameTagVisibility
    collisionRule*: CollisionRule
    color*: NamedColor
    playerPrefix*: TextComponent
    playerSuffix*: TextComponent
    players*: seq[string]

  Scoreboard* = object
    objectives*: seq[ScoreboardObjective]
    teams*: seq[Team]
    scores*: seq[ScoreboardScore]

proc toStr*(v: NameTagVisibility): string =
  case v
  of ntvAlways: "always"
  of ntvNever: "never"
  of ntvHideForOtherTeams: "hideForOtherTeams"
  of ntvHideForOwnTeam: "hideForOwnTeam"

proc toStr*(v: CollisionRule): string =
  case v
  of crAlways: "always"
  of crNever: "never"
  of crPushOtherTeams: "pushOtherTeams"
  of crPushOwnTeam: "pushOwnTeam"

proc newScoreboard*(): Scoreboard =
  Scoreboard(objectives: @[], teams: @[], scores: @[])

proc newScoreboardScore*(entityName, objectiveName: string; value: VarInt; displayName: Option[TextComponent];
    numberFormat: Option[NumberFormat]): ScoreboardScore =
  ScoreboardScore(entityName: entityName, objectiveName: objectiveName, value: value, displayName: displayName,
    numberFormat: numberFormat, locked: true)

proc objectiveIndex(self: Scoreboard; name: string): int =
  for i in 0 ..< self.objectives.len:
    if self.objectives[i].name == name:
      return i
  -1

proc teamIndex(self: Scoreboard; name: string): int =
  for i in 0 ..< self.teams.len:
    if self.teams[i].name == name:
      return i
  -1

proc addObjective*(self: var Scoreboard; world: World; objective: ScoreboardObjective) =
  if self.objectiveIndex(objective.name) >= 0:
    echo "Tried to create an objective which already exists: ", objective.name
    return
  world.broadcastPacketAll(newCUpdateObjectives(objective.name, mAdd, objective.displayName, objective.renderType,
    objective.numberFormat))
  world.broadcastPacketAll(newCDisplayObjective(sdsSidebar, objective.name))
  self.objectives.add(objective)

proc removeObjective*(self: var Scoreboard; world: World; name: string) =
  let i = self.objectiveIndex(name)
  if i < 0:
    echo "Tried to remove an objective which does not exist: ", name
    return
  world.broadcastPacketAll(newCUpdateObjectives(name, mRemove, empty(), rtInteger, none[NumberFormat]()))
  self.objectives.delete(i)
  var kept: seq[ScoreboardScore] = @[]
  for score in self.scores:
    if score.objectiveName != name:
      kept.add(score)
  self.scores = kept

proc updateScore*(self: var Scoreboard; world: World; score: ScoreboardScore) =
  if self.objectiveIndex(score.objectiveName) < 0:
    echo "Tried to place a score into an objective which does not exist: ", score.objectiveName
    return
  world.broadcastPacketAll(CUpdateScore(entityName: score.entityName, objectiveName: score.objectiveName,
    value: score.value, displayName: score.displayName, numberFormat: score.numberFormat))
  for i in 0 ..< self.scores.len:
    if self.scores[i].entityName == score.entityName and self.scores[i].objectiveName == score.objectiveName:
      self.scores[i] = score
      return
  self.scores.add(score)

proc removeScore*(self: var Scoreboard; world: World; entityName, objectiveName: string) =
  world.broadcastPacketAll(CUpdateScore.newRemove(entityName, objectiveName))
  var kept: seq[ScoreboardScore] = @[]
  for score in self.scores:
    if score.entityName != entityName or score.objectiveName != objectiveName:
      kept.add(score)
  self.scores = kept

proc parametersOf(team: Team): TeamParameters =
  TeamParameters(displayName: team.displayName, options: team.options, nametagVisibility: toStr(team.nametagVisibility),
    collisionRule: toStr(team.collisionRule), color: int32(ord(team.color)), playerPrefix: team.playerPrefix,
    playerSuffix: team.playerSuffix)

proc addTeam*(self: var Scoreboard; world: World; team: Team) =
  if self.teamIndex(team.name) >= 0:
    echo "Tried to create Team which does already exist, ", team.name
    return
  world.broadcastPacketAll(CSetPlayerTeam(teamName: team.name, teamMethod: tmCreate, parameters: some(parametersOf(team)),
    players: team.players))
  self.teams.add(team)

proc updateTeam*(self: var Scoreboard; world: World; team: Team) =
  let i = self.teamIndex(team.name)
  if i < 0:
    echo "Tried to update Team which does not exist, ", team.name
    return
  world.broadcastPacketAll(CSetPlayerTeam(teamName: team.name, teamMethod: tmUpdate, parameters: some(parametersOf(team)),
    players: @[]))
  self.teams[i] = team

proc removeTeam*(self: var Scoreboard; world: World; name: string) =
  let i = self.teamIndex(name)
  if i < 0:
    echo "Tried to remove Team which does not exist, ", name
    return
  world.broadcastPacketAll(CSetPlayerTeam(teamName: name, teamMethod: tmRemove, parameters: none[TeamParameters](), players: @[]))
  self.teams.delete(i)

proc addPlayerToTeam*(self: var Scoreboard; world: World; teamName, player: string) =
  let i = self.teamIndex(teamName)
  if i < 0:
    echo "Tried to add player to Team which does not exist, ", teamName
    return
  if player in self.teams[i].players:
    return
  world.broadcastPacketAll(CSetPlayerTeam(teamName: teamName, teamMethod: tmAddPlayers, parameters: none[TeamParameters](),
    players: @[player]))
  self.teams[i].players.add(player)

proc removePlayerFromTeam*(self: var Scoreboard; world: World; teamName, player: string) =
  let i = self.teamIndex(teamName)
  if i < 0:
    echo "Tried to remove player from Team which does not exist, ", teamName
    return
  if player notin self.teams[i].players:
    return
  world.broadcastPacketAll(CSetPlayerTeam(teamName: teamName, teamMethod: tmRemovePlayers, parameters: none[TeamParameters](),
    players: @[player]))
  var kept: seq[string] = @[]
  for p in self.teams[i].players:
    if p != player:
      kept.add(p)
  self.teams[i].players = kept
