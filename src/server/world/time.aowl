## Port of pumpkin/src/world/time.rs
##
## The type is in ../serverbase.aowl, since `World` holds it.

import ../../protocol/java/client/play/set_time
import ../serverbase

proc newLevelTime*(): LevelTime =
  LevelTime(worldAge: 0'i64, timeOfDay: 0'i64, rainTime: 0'i64)

proc tickTime*(self: var LevelTime; advanceTime, advanceWeather: bool) =
  self.worldAge += 1'i64
  if advanceWeather:
    self.rainTime += 1'i64
  if advanceTime:
    self.timeOfDay += 1'i64

proc sendTime*(self: LevelTime; world: World) =
  world.broadcastPacketAll(newCUpdateTime(self.worldAge, self.timeOfDay, world.levelInfo.gameRules.advanceTime))

proc addTime*(self: var LevelTime; time: int64) =
  self.timeOfDay += time

proc setTime*(self: var LevelTime; time: int64) =
  self.timeOfDay = time

proc queryDaytime*(self: LevelTime): int64 = self.timeOfDay mod 24000'i64

proc queryGametime*(self: LevelTime): int64 = self.worldAge

proc queryDay*(self: LevelTime): int64 = self.timeOfDay div 24000'i64

proc isNight*(self: LevelTime): bool =
  let t = self.timeOfDay mod 24000'i64
  t >= 12000'i64 and t <= 23999'i64
