## Port of pumpkin/src/world/weather.rs
##
## The type is in ../serverbase.aowl, since `World` holds it. Upstream's `if !self.weather_cycle_enabled` guards
## `advance_weather_cycle`, which reads backwards and is kept: with the default of `true` the cycle does not advance.
## `rand::rng()` is a small generator here, since no behaviour depends on the sequence.

import ../../protocol/java/client/play/game_event
import ../net/winsock
import ../serverbase

const
  RainDelayMin = 12000'i32
  RainDelayMax = 180000'i32
  RainDurationMin = 12000'i32
  RainDurationMax = 24000'i32
  ThunderDelayMin = 12000'i32
  ThunderDelayMax = 180000'i32
  ThunderDurationMin = 3600'i32
  ThunderDurationMax = 15600'i32
  WeatherTransitionSpeed = 0.01'f32
  Float32Epsilon = 1.1920929e-7'f32

var weatherRandomState = uint64(nowMs()) xor 0xDEADBEEFCAFEF00D'u64

proc randomRange(low, high: int32): int32 =
  weatherRandomState = weatherRandomState xor (weatherRandomState shl 13)
  weatherRandomState = weatherRandomState xor (weatherRandomState shr 7)
  weatherRandomState = weatherRandomState xor (weatherRandomState shl 17)
  low + int32(weatherRandomState mod uint64(high - low + 1'i32))

proc newWeather*(): Weather =
  Weather(clearWeatherTime: 0'i32, raining: false, rainTime: 0'i32, thundering: false, thunderTime: 0'i32,
    rainLevel: 0.0'f32, oldRainLevel: 0.0'f32, thunderLevel: 0.0'f32, oldThunderLevel: 0.0'f32,
    weatherCycleEnabled: true)

proc setWeatherParameters*(self: var Weather; world: World; clearTime, rainTime: int32; raining, thundering: bool) =
  let wasRaining = self.raining
  self.clearWeatherTime = clearTime
  self.rainTime = rainTime
  self.thunderTime = rainTime
  self.raining = raining
  self.thundering = thundering
  if wasRaining != raining:
    if wasRaining:
      world.broadcastPacketAll(newCGameEvent(geEndRaining, 0.0'f32))
    else:
      world.broadcastPacketAll(newCGameEvent(geBeginRaining, 0.0'f32))

proc advanceWeatherCycle(self: var Weather) =
  if self.clearWeatherTime > 0'i32:
    self.clearWeatherTime -= 1'i32
    self.thunderTime = if self.thundering: 0'i32 else: 1'i32
    self.rainTime = if self.raining: 0'i32 else: 1'i32
    self.thundering = false
    self.raining = false
  else:
    # Handle thunder timing
    if self.thunderTime > 0'i32:
      self.thunderTime -= 1'i32
      if self.thunderTime == 0'i32:
        self.thundering = not self.thundering
    elif self.thundering:
      self.thunderTime = randomRange(ThunderDurationMin, ThunderDurationMax)
    else:
      self.thunderTime = randomRange(ThunderDelayMin, ThunderDelayMax)

    # Handle rain timing
    if self.rainTime > 0'i32:
      self.rainTime -= 1'i32
      if self.rainTime == 0'i32:
        self.raining = not self.raining
    elif self.raining:
      self.rainTime = randomRange(RainDurationMin, RainDurationMax)
    else:
      self.rainTime = randomRange(RainDelayMin, RainDelayMax)

proc tickWeather*(self: var Weather; world: World) =
  if not self.weatherCycleEnabled:
    self.advanceWeatherCycle()

  # Update visual transitions
  self.oldRainLevel = self.rainLevel
  self.oldThunderLevel = self.thunderLevel

  if self.raining:
    self.rainLevel = min(self.rainLevel + WeatherTransitionSpeed, 1.0'f32)
  else:
    self.rainLevel = max(self.rainLevel - WeatherTransitionSpeed, 0.0'f32)

  if self.thundering:
    self.thunderLevel = min(self.thunderLevel + WeatherTransitionSpeed, 1.0'f32)
  else:
    self.thunderLevel = max(self.thunderLevel - WeatherTransitionSpeed, 0.0'f32)

  # Broadcast level changes if needed
  if abs(self.oldRainLevel - self.rainLevel) > Float32Epsilon:
    world.broadcastPacketAll(newCGameEvent(geRainLevelChange, self.rainLevel))

  if abs(self.oldThunderLevel - self.thunderLevel) > Float32Epsilon:
    world.broadcastPacketAll(newCGameEvent(geThunderLevelChange, self.thunderLevel))

proc resetWeatherCycle*(self: var Weather; world: World) =
  self.setWeatherParameters(world, 0'i32, 0'i32, false, false)
