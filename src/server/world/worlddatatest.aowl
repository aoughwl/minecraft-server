## `worlddata` and `scoreboardsave`: the vanilla 1.21.11 data files, against the values of a real save (a `world_border.dat`,
## the forced tickets of a `chunks.dat`, an empty `scoreboard.dat`) and a write and read of a whole file.
import std/[assertions, options, syncio]
import ../../nbt/tag
import ../../world/[nbtget, worldfs, worldinfodatafiles]
import ../../generated/dimension
import ../../util/vector2
import ../../protocol/proto
import ../../protocol/varint
import ../../protocol/java/client/play/update_objectives
import ../../util/text/[text, color]
import ../serverbase
import border
import scoreboard
import worlddata
import scoreboardsave

proc realBorder(): NbtCompound =
  ## What the real world's `data/world_border.dat` holds.
  result = newCompound()
  put(result, "center_z", doubleTag(0.0))
  put(result, "damage_per_block", doubleTag(0.2))
  put(result, "warning_time", intTag(300'i32))
  put(result, "size", doubleTag(59999968.0))
  put(result, "safe_zone", doubleTag(5.0))
  put(result, "warning_blocks", intTag(5'i32))
  put(result, "lerp_target", doubleTag(59999968.0))
  put(result, "lerp_time", longTag(0'i64))
  put(result, "center_x", doubleTag(0.0))

proc testBorder() =
  let fresh = newWorldborder(0.0, 0.0, 5.999_996_8e7, 0'i64, 5'i32, 300'i32)
  let loaded = worldBorderFromNbt(realBorder(), fresh)
  assert loaded.newDiameter == 59999968.0 and loaded.oldDiameter == 59999968.0
  assert loaded.damagePerBlock == 0.2'f32 and loaded.buffer == 5.0'f32
  assert loaded.warningBlocks == 5'i32 and loaded.warningTime == 300'i32 and loaded.speed == 0'i64
  # A border set in game: written, read back, and what the file had besides stays.
  var changed = loaded
  changed.centerX = 12.5
  changed.centerZ = -3.0
  changed.newDiameter = 1000.0
  changed.warningBlocks = 9'i32
  changed.warningTime = 20'i32
  changed.damagePerBlock = 1.5'f32
  changed.buffer = 2.0'f32
  var old = realBorder()
  put(old, "future_field", intTag(7'i32))
  let written = worldBorderToNbt(changed, old)
  assert nbtDouble(written, "size") == (true, 1000.0'f64)
  assert nbtDouble(written, "lerp_target") == (true, 1000.0'f64)
  assert nbtLong(written, "lerp_time") == (true, 0'i64)
  assert nbtDouble(written, "center_x") == (true, 12.5'f64)
  assert nbtInt(written, "warning_blocks") == (true, 9'i32)
  assert nbtInt(written, "future_field") == (true, 7'i32)
  let back = worldBorderFromNbt(written, fresh)
  assert back.centerX == 12.5 and back.centerZ == -3.0 and back.newDiameter == 1000.0
  assert back.damagePerBlock == 1.5'f32 and back.buffer == 2.0'f32 and back.warningTime == 20'i32
  # A resize that was running: 40 ticks left is 2000 ms for the client.
  var moving = realBorder()
  insert(moving, "size", doubleTag(100.0))
  insert(moving, "lerp_target", doubleTag(50.0))
  insert(moving, "lerp_time", longTag(40'i64))
  let m = worldBorderFromNbt(moving, fresh)
  assert m.oldDiameter == 100.0 and m.newDiameter == 50.0 and m.speed == 2000'i64

proc testForced() =
  var inner = newCompound()
  var a = newCompound()
  put(a, "chunk_pos", intArrayTag(@[-10'i32, -5'i32]))
  put(a, "level", intTag(31'i32))
  put(a, "type", stringTag("minecraft:forced"))
  var b = newCompound()
  put(b, "chunk_pos", intArrayTag(@[3'i32, 4'i32]))
  put(b, "level", intTag(33'i32))
  put(b, "type", stringTag("minecraft:portal"))
  put(inner, "tickets", listTag(@[compoundTag(a), compoundTag(b)]))
  let forced = forcedFromNbt(inner)
  assert forced.len == 1 and forced[0].x == -10'i32 and forced[0].y == -5'i32
  # Written back with one forced chunk swapped for two, the portal ticket kept.
  let out2 = ticketsToNbt(@[Vector2[int32](x: 1'i32, y: 2'i32), Vector2[int32](x: 7'i32, y: 8'i32)], inner)
  let (_, tickets) = nbtList(out2, "tickets")
  assert tickets.len == 3
  assert forcedFromNbt(out2).len == 2
  let (_, portal) = nbtString(tickets[0].compoundVal, "type")
  assert portal == "minecraft:portal"
  let (_, level) = nbtInt(tickets[1].compoundVal, "level")
  assert level == 31'i32
  assert nbtIntArray(tickets[2].compoundVal, "chunk_pos") == (true, @[7'i32, 8'i32])
  # Nothing forced: the list is empty, which a vanilla server reads as no tickets.
  assert forcedFromNbt(ticketsToNbt(@[], inner)).len == 0

proc testFolders() =
  let overworld = dimensionDataFolder("w", OVERWORLD)
  assert overworld.len > 0
  assert dimensionDataFolder("w", THE_NETHER) != overworld
  assert dimensionDataFolder("w", THE_NETHER) != dimensionDataFolder("w", THE_END)

proc testScoreboard() =
  var board = newScoreboard()
  board.objectives.add(newScoreboardObjective("kills", text("Kills"), "playerKillCount"))
  var hearts = newScoreboardObjective("hp", text("Health"), "health")
  hearts.renderType = rtHearts
  board.objectives.add(hearts)
  var bob = newScoreboardScore("bob", "kills", newVarInt(5'i32), none[TextComponent](), none[NumberFormat]())
  bob.locked = false  # `newScoreboardScore` makes them locked, as upstream does
  board.scores.add(bob)
  var locked = newScoreboardScore("alice", "kills", newVarInt(-2'i32), some(text("Alice!")), none[NumberFormat]())
  locked.locked = true
  board.scores.add(locked)
  board.teams.add(Team(name: "red", displayName: text("Reds"), options: 3'i8, nametagVisibility: ntvHideForOtherTeams,
    collisionRule: crPushOwnTeam, color: ncRed, playerPrefix: text("[R] "), playerSuffix: text(""), players: @["bob", "alice"]))
  var old = newCompound()
  put(old, "DisplaySlots", compoundTag(newCompound()))
  let nbt = scoreboardToNbt(board, old)
  # The vanilla field names and types.
  let (_, objectives) = nbtList(nbt, "Objectives")
  assert objectives.len == 2
  assert nbtString(objectives[0].compoundVal, "Name") == (true, "kills")
  assert nbtString(objectives[0].compoundVal, "CriteriaName") == (true, "playerKillCount")
  assert nbtString(objectives[1].compoundVal, "RenderType") == (true, "hearts")
  let (_, scores) = nbtList(nbt, "PlayerScores")
  assert nbtInt(scores[0].compoundVal, "Score") == (true, 5'i32)
  assert nbtString(scores[0].compoundVal, "Objective") == (true, "kills")
  assert not scores[0].compoundVal.containsKey("Locked")
  assert nbtBool(scores[1].compoundVal, "Locked") == (true, true)
  let (_, teams) = nbtList(nbt, "Teams")
  assert nbtString(teams[0].compoundVal, "TeamColor") == (true, "red")
  assert nbtString(teams[0].compoundVal, "NameTagVisibility") == (true, "hideForOtherTeams")
  assert nbtString(teams[0].compoundVal, "CollisionRule") == (true, "pushOwnTeam")
  assert nbtBool(teams[0].compoundVal, "AllowFriendlyFire") == (true, true)
  assert nbtBool(teams[0].compoundVal, "SeeFriendlyInvisibles") == (true, true)
  assert nbt.containsKey("DisplaySlots")
  # And back.
  let again = scoreboardFromNbt(nbt)
  assert again.objectives.len == 2 and again.objectives[0].name == "kills" and again.objectives[1].renderType == rtHearts
  assert again.scores.len == 2 and again.scores[0].entityName == "bob" and again.scores[0].value.value == 5'i32
  assert again.scores[1].locked and again.scores[1].displayName.isSome
  assert again.teams.len == 1 and again.teams[0].color == ncRed and again.teams[0].options == 3'i8
  assert again.teams[0].players == @["bob", "alice"] and again.teams[0].collisionRule == crPushOwnTeam
  # The real, empty `scoreboard.dat` holds `data: {}`: no objectives, scores or teams.
  let empty = scoreboardFromNbt(newCompound())
  assert empty.objectives.len == 0 and empty.scores.len == 0 and empty.teams.len == 0
  # Through a file: gzip, `data` and `DataVersion`, in a folder made on the way.
  let folder = "worlddatatest_save"
  assert saveScoreboard(board, folder)
  let (status, bytes) = readFileBytes(scoreboardPath(folder))
  assert status == rsOk
  let (parsed, root, _) = readGzipCompound(bytes)
  assert parsed and nbtInt(root, "DataVersion") == (true, 4671'i32)
  let loaded = loadScoreboard(folder)
  assert loaded.objectives.len == 2 and loaded.scores.len == 2 and loaded.teams.len == 1
  # An untouched empty board writes no file over one that is not there.
  assert saveScoreboard(newScoreboard(), "worlddatatest_nowhere")
  assert not fileExistsW(scoreboardPath("worlddatatest_nowhere"))

testBorder()
testForced()
testFolders()
testScoreboard()
echo "worlddata ok"
