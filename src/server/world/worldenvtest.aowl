## time.aowl, weather.aowl, border.aowl, bossbar.aowl, custom_bossbar.aowl and scoreboard.aowl, on a world with one player
## whose outgoing bytes are read back.
import std/[assertions, options, syncio, cmdline]
import ../../generated/packet
import ../../protocol/java/client/play/update_objectives
import ../../protocol/java/packet_decoder
import ../../protocol/proto
import ../../util/text/text
import ../../world/[playerdata, worldfs, worldinfo]
import ../data/datamod
import ../entity/player as playermod
import ../net/winsock
import ../recipe
import ../scheduler
import ../serverbase
import ../tick_rate_manager
import border, bossbar, custom_bossbar, scoreboard, time, weather, worldmod

proc scratch(): string =
  result = parentDirW(paramStr(0)) & "/worldenv_scratch"
  discard createDirAllW(result)

let adv = defaultAdvancedConfiguration()
let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: adv, worlds: @[], dimensions: @[OVERWORLD],
  tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32), keyStore: nil,
  recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let theLevel = fromRootFolder(adv.world, scratch(), 1'i64, OVERWORLD)
let testWorld = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(testWorld)
let client = newJavaClient(InvalidSocket, 1'u64)
client.connectionState = csPlay
client.version = jmvV1_21_11
let profile = GameProfile(id: offlineUuid("Tester"), name: "Tester", properties: @[], profileActions: @[])
let p = newPlayer(client, profile, defaultPlayerConfig(), testWorld, server, Survival, 1'i32)
worldmod.addPlayer(testWorld, p)
let v = jmvV1_21_11

proc packetIds(): seq[int32] =
  var decoder = newTCPNetworkDecoder()
  decoder.feed(client.networkWriter.flush())
  result = @[]
  while decoder.packetReady():
    let res = decoder.getRawPacket()
    assert res.isOk
    result.add(res.value.id)

block time_of_day:
  echo "time_of_day"
  var t = newLevelTime()
  t.tickTime(true, true)
  assert t.worldAge == 1'i64 and t.timeOfDay == 1'i64 and t.rainTime == 1'i64
  t.tickTime(false, false)
  assert t.worldAge == 2'i64 and t.timeOfDay == 1'i64 and t.rainTime == 1'i64
  t.setTime(36000'i64)
  assert t.queryDaytime() == 12000'i64 and t.queryDay() == 1'i64 and t.isNight()
  t.addTime(12000'i64)
  assert not t.isNight()
  t.sendTime(testWorld)
  assert CB_PLAY_SET_TIME.toId(v) in packetIds()

block weather_levels:
  echo "weather_levels"
  var w = newWeather()
  w.setWeatherParameters(testWorld, 0'i32, 100'i32, true, false)
  assert CB_PLAY_GAME_EVENT.toId(v) in packetIds(), "rain begins"
  w.tickWeather(testWorld)
  assert w.rainLevel == 0.01'f32 and w.thunderLevel == 0.0'f32
  assert CB_PLAY_GAME_EVENT.toId(v) in packetIds(), "the level moved"
  w.resetWeatherCycle(testWorld)
  assert not w.raining
  discard packetIds()

block border_shape:
  echo "border_shape"
  var b = newWorldborder(0.0, 0.0, 100.0, 0'i64, 5'i32, 300'i32)
  assert b.contains(49.0, -50.0)
  assert not b.contains(50.0, 0.0)
  assert b.containsBlock(48'i32, 0'i32)
  assert not b.containsBlock(49'i32, 0'i32)
  assert b.clampBlock(1000'i32, -1000'i32) == (49'i32, -50'i32)
  b.setDiameter(testWorld, 50.0, false, 0'i64)
  assert b.oldDiameter == 100.0 and b.newDiameter == 50.0
  assert CB_PLAY_SET_BORDER_SIZE.toId(v) in packetIds()
  b.setDiameter(testWorld, 60.0, true, 1000'i64)
  assert CB_PLAY_SET_BORDER_LERP_SIZE.toId(v) in packetIds()
  b.setCenter(testWorld, 3.0, 4.0)
  assert CB_PLAY_SET_BORDER_CENTER.toId(v) in packetIds()
  b.setWarningDelay(testWorld, 9'i32)
  b.setWarningDistance(testWorld, 8'i32)
  assert b.warningTime == 9'i32 and b.warningBlocks == 8'i32
  discard packetIds()

block custom_bossbars:
  echo "custom_bossbars"
  var bars = newCustomBossbars()
  bars.createBossbar("a:b", newBossbar(text("bar")))
  assert bars.hasBossbar("a:b") and bars.getBossbarsLen() == 1
  assert bars.updateHealth(server, "nope", 100'i32, 1'i32).kind == bukInvalidResourceLocation
  assert bars.updatePlayers(server, "a:b", @[profile.id]).kind == bukOk
  assert CB_PLAY_BOSS_EVENT.toId(v) in packetIds(), "the player added sees it"
  assert bars.updatePlayers(server, "a:b", @[profile.id]).kind == bukNoChanges
  assert bars.updateHealth(server, "a:b", 200'i32, 100'i32).kind == bukOk
  assert bars.getBossbar("a:b").unsafeGet.bossbarData.health == 0.5'f32
  assert CB_PLAY_BOSS_EVENT.toId(v) in packetIds()
  assert bars.updateHealth(server, "a:b", 200'i32, 100'i32).kind == bukNoChanges
  assert bars.updateColor(server, "a:b", bcRed).kind == bukOk
  assert bars.updateVisibility(server, "a:b", false).kind == bukOk
  discard packetIds()
  assert bars.updateName(server, "a:b", text("other")).kind == bukOk
  assert packetIds().len == 0, "a hidden bar says nothing"
  assert bars.removeBossbar(server, "a:b").kind == bukOk
  assert not bars.hasBossbar("a:b")

block scoreboards:
  echo "scoreboards"
  var board = newScoreboard()
  let objective = ScoreboardObjective(name: "o", displayName: text("O"), renderType: rtInteger,
    numberFormat: none[NumberFormat](), criterion: "dummy")
  board.addObjective(testWorld, objective)
  let ids = packetIds()
  assert CB_PLAY_SET_OBJECTIVE.toId(v) in ids and CB_PLAY_SET_DISPLAY_OBJECTIVE.toId(v) in ids
  board.addObjective(testWorld, objective)
  assert packetIds().len == 0, "already there"
  board.updateScore(testWorld, newScoreboardScore("e", "o", newVarInt(3'i32), none[TextComponent](), none[NumberFormat]()))
  board.updateScore(testWorld, newScoreboardScore("e", "o", newVarInt(4'i32), none[TextComponent](), none[NumberFormat]()))
  assert board.scores.len == 1 and board.scores[0].value.value == 4'i32
  board.updateScore(testWorld, newScoreboardScore("e", "none", newVarInt(3'i32), none[TextComponent](), none[NumberFormat]()))
  assert board.scores.len == 1
  board.removeObjective(testWorld, "o")
  assert board.scores.len == 0
  discard packetIds()
  let team = Team(name: "t", displayName: text("T"), options: 0'i8, nametagVisibility: ntvAlways, collisionRule: crNever,
    playerPrefix: empty(), playerSuffix: empty(), players: @[])
  board.addTeam(testWorld, team)
  board.addPlayerToTeam(testWorld, "t", "x")
  board.addPlayerToTeam(testWorld, "t", "x")
  assert board.teams[0].players == @["x"]
  board.removePlayerFromTeam(testWorld, "t", "x")
  assert board.teams[0].players.len == 0
  assert CB_PLAY_SET_PLAYER_TEAM.toId(v) in packetIds()
  board.removeTeam(testWorld, "t")
  assert board.teams.len == 0
  assert toStr(ntvHideForOwnTeam) == "hideForOwnTeam" and toStr(crPushOtherTeams) == "pushOtherTeams"

echo "world environment ok"
