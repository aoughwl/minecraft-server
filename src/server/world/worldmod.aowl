  chunk_batch_start, chunk_batch_end, chunk_data, player_action, spawn_entity, set_held_item,
  game_event, player_spawn_position, system_chat_message, player_remove, remove_entities, block_update,
  multi_block_update, block_destroy_stage, worldevent, set_equipment, respawn, entity_metadata, block_event,
  player_chat_message, update_entity_pos, update_entity_pos_rot, update_entity_rot, head_rot, entity_position_sync]
