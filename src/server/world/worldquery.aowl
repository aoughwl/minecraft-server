## Port of pumpkin/src/world/mod.rs `extend_entities_where` and `extend_entities_in_box_where`.
## They sit above worldmod.aowl because the entity list is entitymod's.

import ../entity/entitymod
import ../entity/player as playermod

proc extendEntitiesWhere*(self: World; list: var seq[EntityBase]; maxListCapacity: int;
    predicate: proc(e: EntityBase): bool {.closure.}) =
  ## Adds the players, then the entities, for which `predicate` holds. Like upstream, the cap is checked after
  ## a push (`len > max`), so the list can end one past it.
  if list.len >= maxListCapacity:
    return
  for player in self.players:
    let base = playerBase(player)
    if not predicate(base):
      continue
    list.add(base)
    if list.len > maxListCapacity:
      return
  for entity in entitiesOf(self).entities:
    if not predicate(entity):
      continue
    list.add(entity)
    if list.len > maxListCapacity:
      return

proc extendEntitiesInBoxWhere*(self: World; list: var seq[EntityBase]; maxListCapacity: int; boundingBox: BoundingBox;
    predicate: proc(e: EntityBase): bool {.closure.}) =
  self.extendEntitiesWhere(list, maxListCapacity, proc(e: EntityBase): bool {.closure.} =
    boundingBox.intersects(e.getEntity().boundingBox) and predicate(e))
