## worldmod.aowl's queueBlockUpdates, getLightingConfig, addBlockEntityNbt and worldquery.aowl's extendEntitiesWhere.
import std/[assertions, cmdline, options, syncio, tables]
import ../../config/lighting as lightingconfig
import ../../data/block_ext
from ../../data/block_state import asU16
import ../../nbt/tag as nbttag
import ../../world/[chunkdata, level, playerdata, worldfs, worldinfo]
import ../data/datamod
import ../recipe
import ../scheduler
import ../tick_rate_manager
import ../entity/entitymod
import worldmod, worldquery

let server = Server(basicConfig: defaultBasicConfiguration(), advancedConfig: defaultAdvancedConfiguration(), worlds: @[],
  dimensions: @[OVERWORLD], tickCounter: 0'i64, nextEntityId: 1'i32, tickRateManager: newServerTickRateManager(20.0'f32),
  keyStore: nil, recipeManager: newRecipeManager(), scheduler: newTaskScheduler(), data: ServerData(),
  playerDataStorage: PlayerDataStorage(), levelFolder: "", playerIdleTimeout: 0'i32, mojangPublicKeys: @[],
  stopRequested: false, stopAtMs: 0'i64)
let dir = parentDirW(paramStr(0)) & "/worldquery_scratch"
discard createDirAllW(dir)
let theLevel = fromRootFolder(server.advancedConfig.world, dir, 1'i64, OVERWORLD)
let w = loadWorld(theLevel, defaultLevelData(1'u64), OVERWORLD, 63'i32, -64'i32, server)
server.worlds.add(w)
addLoadedChunk(theLevel, newChunkData(0'i32, 0'i32, newChunkSections(24, -64'i32)))

proc run() =
  # queue_block_updates: later changes to one position replace earlier ones; nothing is sent until the flush.
  let a = BlockPos(vec: Vector3[int32](x: 1'i32, y: 64'i32, z: 2'i32))
  let b = BlockPos(vec: Vector3[int32](x: 3'i32, y: 64'i32, z: 4'i32))
  w.queueBlockUpdates([(a, 5'u32), (b, 6'u32), (a, 7'u32)])
  assert w.unsentBlockChanges.len == 2
  w.flushBlockUpdates()
  assert w.unsentBlockChanges.len == 0

  # get_lighting_config: the server's setting, the default without a server.
  assert w.getLightingConfig() == lecDefault
  server.advancedConfig.world.lighting = lecDark
  assert w.getLightingConfig() == lecDark
  w.server = nil
  assert w.getLightingConfig() == lecDefault
  w.server = server

  # add_block_entity_nbt: pending in the chunk and the chunk dirty; an unloaded chunk is ignored.
  var nbt = newCompound()
  put(nbt, "id", NbtTag(kind: ntkString, stringVal: "minecraft:chest"))
  let chunk = theLevel.loadedChunks.getOrDefault(chunkKey(0'i32, 0'i32), nil)
  chunk.dirty = false
  w.addBlockEntityNbt(a, nbt)
  assert chunk.pendingBlockEntities.len == 1 and chunk.dirty
  w.addBlockEntityNbt(a, nbt)
  assert chunk.pendingBlockEntities.len == 1
  w.addBlockEntityNbt(BlockPos(vec: Vector3[int32](x: 500'i32, y: 64'i32, z: 500'i32)), nbt)
  assert chunk.pendingBlockEntities.len == 1

  # extend_entities_where: capacity guard first, push-then-check after.
  var list: seq[EntityBase] = @[]
  w.extendEntitiesWhere(list, 0, proc(e: EntityBase): bool {.closure.} = true)
  assert list.len == 0
  w.extendEntitiesWhere(list, 3, proc(e: EntityBase): bool {.closure.} = true)
  assert list.len == 0  # no players, no entities in this world
  echo "worldquerytest ok"

run()
