## The WorldEdit-style commands, the selection wand and the `worldedit:cui` channel. Op level 2.
##
##   //wand  //pos1 [x y z]  //pos2 [x y z]  //sel  //size
##   //set <pattern>   //replace <mask> <pattern>   //walls <pattern>   //hollow [pattern]
##   //sphere [-h] <pattern> <radius>[,<ry>,<rz>]   //cyl [-h] <pattern> <radius>[,<rz>] [height]
##   //copy   //cut [leave]   //paste [-a] [-s]   //rotate <degrees>   //flip [direction]
##   //stack [count] [direction] [-a]   //move [count] [direction] [leave] [-s]
##   //count <mask>   //distribution [-d]   //undo [n]   //redo [n]
##   //expand <n> [reverse] [dir] | vert   //contract <n> [reverse] [dir]   //shift <n> [dir]   //outset|//inset [-h|-v] <n>
##   //chunk   //center <pattern>   //smooth [iterations]   //naturalize   //overlay <pattern>   //line [-h] <pattern> [thickness]
##   //drain [-w] <radius>   //fill <pattern> <radius> [depth]   //fixwater <radius>   //pyramid|//hpyramid <pattern> <size>
##   //hsphere [-r] <pattern> <radius>   //hcyl <pattern> <radius> [height]   //copy -e   //cut -e   //paste -e
##   //brush (//br) sphere [-h] <pattern> [radius] | cylinder [-h] <pattern> [radius] [height] | smooth [size] [iter] | none
##   //tool info | repl <pattern> | none   //none   //clearhistory   //historysize [entries]
##
## Brushes and tools act on a right click with the item they are bound to: on the clicked block, or (brushes, a click in the
## air) on the first block along your view within 300 blocks. Each brush stroke is one undoable edit.
##
## A client types `//set stone`, which reaches the server as the command string `/set stone`. The commands are registered in
## the node dispatcher under root literals named `/set`, `/pos1`, ... (as WorldEdit for Fabric does), so they are part of the
## command tree the client receives: it knows them, completes them and shows their arguments (see "the command tree" below).
## cmddispatch.handleCommand keeps the leading slash of a command whose name has one. The same logic is also reachable as
## `/we <name> <args>` (for consoles and for clients that cannot type the double slash). `/plugins` lists WorldEdit as a built-in
## server mod and `/help WorldEdit` lists its commands.
##
## The wand is a wooden axe: left click on a block sets position 1, right click on a block sets position 2 (the click does
## not break or use the block). The server also sends the selection to clients on the `worldedit:cui` channel: a client that
## registered the channel, sent `v|<version>` on it, or was granted the Jester `cui` capability gets `s|cuboid` and
## `p|<index>|<x>|<y>|<z>|<volume>` messages (UTF-8 text, one per packet) whenever the selection changes.

from ../sim/dimtick import assertTickThread
import ../../util/closureset
import std/[options, strutils, math]
import ../../command/[cmderrors, cmdsource, cmdtree, argument_builder, argtype, coordinates, string_reader, suggestion, cmddispatch,
  builtinmods]
import ../../protocol/java/client/play/commands
import ../../util/[vector3, permission]
import ../../util/text/[textbase, text, color]
import ../../util/math/position
import ../../nbt/tag as nbttag
import ../../plugin/[payloads, pluginhooks]
import ../serverbase
import ../entity/[player, entitymod, playerextras]
import "../../data/item_stack/mod" as itemstackmod
import ../../inventory/[inventory, player_inventory, screenhandler]
import ../../world/blockstates
import wecore, weworld

const
  Permission0* = "worldedit:command.we"
  Description = "WorldEdit-style editing."
  ArgRest = "args"
  WandItem = "wooden_axe"
  CuiChannel* = "worldedit:cui"
  SessionKeepTicks = 12000'i64
  CommandNames* = ["pos1", "pos2", "wand", "sel", "desel", "size", "set", "replace", "walls", "hollow", "sphere", "cyl", "copy",
    "cut", "paste", "rotate", "flip", "stack", "move", "count", "distribution", "undo", "redo", "expand", "contract", "shift",
    "outset", "inset", "chunk", "center", "smooth", "naturalize", "overlay", "drain", "fill", "fixwater", "line", "pyramid",
    "hpyramid", "hsphere", "hcyl", "brush", "tool", "none", "clearhistory", "historysize"]

var gServer: Option[Server] = none[Server]()
var gInstalled = false
var gLastTick = 0'i64
var gPrevEvent: proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} =
  proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} = (false, ev.flag)
var gPrevInteract: proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
  proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} = false

proc registerPermission*(registry: PermissionRegistry) =
  registerPermissionOrPanic(registry, newPermission(Permission0, Description, permissionOp(Two)))

proc say(sender: CommandSender; line: string) =
  sendMessage(sender, text(line))

proc sayOk(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncGreen))

proc sayBad(sender: CommandSender; line: string) =
  sendMessage(sender, colorNamed(text(line), ncRed))

proc findPlayer(name: string): Option[Player] =
  assertTickThread("wecmd.findPlayer")
  result = none[Player]()
  if gServer.isNone:
    return
  for w in gServer.unsafeGet.worlds:
    for p in w.players:
      if p.gameprofile.name == name:
        return some(p)

proc worldByDimName(dim: string): Option[World] =
  assertTickThread("wecmd.worldByDimName")
  if gServer.isSome:
    for w in gServer.unsafeGet.worlds:
      if w.dimension.minecraftName == dim:
        return some(w)
  none[World]()

# ---- the cui channel -------------------------------------------------------------------------------------------------

proc toBytes(s: string): seq[byte] =
  result = @[]
  for c in s:
    result.add byte(c)

proc cuiMessages*(ses: WeSession): seq[string] =
  ## What the client is told: the shape, then each point with the selection's volume.
  result = @["s|cuboid"]
  let vol = selectionVolume(ses)
  if ses.has1:
    result.add("p|0|" & $ses.p1x & "|" & $ses.p1y & "|" & $ses.p1z & "|" & $vol)
  if ses.has2:
    result.add("p|1|" & $ses.p2x & "|" & $ses.p2y & "|" & $ses.p2z & "|" & $vol)

proc cuiWanted(ses: WeSession): bool =
  ses.cuiHello or payloadChannelDeclared(ses.name, CuiChannel) or playerHasCapability(ses.name, "cui")

proc sendCui(who: Player; ses: WeSession) =
  for m in cuiMessages(ses):
    who.sendCustomPayload(CuiChannel, toBytes(m))
  ses.cuiDirty = false

proc tickWorldEdit*(server: Server; tick: int64) =
  ## Once a tick: installs the hooks the first time, sends changed selections to clients, drops sessions of long-gone players.
  assertTickThread("wecmd.tickWorldEdit")
  gServer = some(server)
  gLastTick = tick
  if not gInstalled:
    return
  var sessions = allSessions()
  for k in 0 ..< sessions.len:
    let ses = sessions[k]
    let who = findPlayer(ses.name)
    if who.isSome:
      ses.lastSeen = tick
      if ses.cuiDirty and cuiWanted(ses):
        sendCui(who.unsafeGet, ses)
    elif tick - ses.lastSeen > SessionKeepTicks and ses.lastSeen > 0'i64:
      dropSession(ses.name)

# ---- command plumbing ------------------------------------------------------------------------------------------------

type Ctx = object
  sender: CommandSender
  ses: WeSession
  world: World
  px, py, pz: int
  yaw, pitch: float
  parts: seq[string]
  flags: string

proc setupCtx(sender: CommandSender; line: string; ctx: var Ctx): bool =
  if sender.kind != cskPlayer or sender.player == nil or sender.player.entity == nil:
    sayBad(sender, "WorldEdit commands are for players.")
    return false
  let name = sender.player.gameProfile.name
  let cw = sender.player.entity.getWorld()
  if cw == nil:
    sayBad(sender, "No world.")
    return false
  let w = worldByDimName(cw.dimensionName)
  if w.isNone:
    sayBad(sender, "The server has not started ticking yet.")
    return false
  ctx.sender = sender
  ctx.ses = sessionFor(name)
  ctx.world = w.unsafeGet
  let p = sender.player.entity.getPos()
  ctx.px = int(floor(p.x))
  ctx.py = int(floor(p.y))
  ctx.pz = int(floor(p.z))
  let rot = sender.player.entity.getRotation()
  ctx.pitch = float(rot.x)
  ctx.yaw = float(rot.y)
  ctx.parts = @[]
  ctx.flags = ""
  for tok in line.splitWhitespace():
    if tok.len >= 2 and tok[0] == '-' and not (tok[1] >= '0' and tok[1] <= '9'):
      ctx.flags.add tok.substr(1)
    else:
      ctx.parts.add tok
  true

proc parseInt(s: string; v: var int): bool =
  if s.len == 0:
    return false
  var i = 0
  var neg = false
  if s[0] == '-':
    neg = true
    i = 1
  if i >= s.len:
    return false
  var n = 0
  while i < s.len:
    if s[i] < '0' or s[i] > '9' or n > 100_000_000:
      return false
    n = n * 10 + (ord(s[i]) - 48)
    inc i
  v = if neg: -n else: n
  true

proc direction(ctx: Ctx; s: string; dx, dy, dz: var int): bool =
  if s.len == 0 or s == "me":
    let f = facingOf(ctx.yaw, ctx.pitch)
    dx = f[0]
    dy = f[1]
    dz = f[2]
    return true
  parseDirection(s, dx, dy, dz)

proc report(ctx: Ctx; r: OpResult) =
  if r.ok:
    sayOk(ctx.sender, r.msg)
  else:
    sayBad(ctx.sender, r.msg)

proc posReply(ctx: Ctx; which: int) =
  let vol = selectionVolume(ctx.ses)
  var at = ""
  if which == 1:
    at = "(" & $ctx.ses.p1x & ", " & $ctx.ses.p1y & ", " & $ctx.ses.p1z & ")"
  else:
    at = "(" & $ctx.ses.p2x & ", " & $ctx.ses.p2y & ", " & $ctx.ses.p2z & ")"
  sayOk(ctx.sender, "Position " & $which & " set to " & at & (if vol > 0: " (" & $vol & " blocks)." else: "."))

proc coordsFromArgs(ctx: Ctx; x, y, z: var int): bool =
  ## "x,y,z" or "x y z" or nothing (the player's block).
  x = ctx.px
  y = ctx.py - 0
  z = ctx.pz
  if ctx.parts.len == 0:
    return true
  var nums: seq[string] = @[]
  for p in ctx.parts:
    for q in p.split(','):
      if q.len > 0:
        nums.add q
  if nums.len != 3:
    return false
  parseInt(nums[0], x) and parseInt(nums[1], y) and parseInt(nums[2], z)

proc giveWand(p: Player) =
  let it = Item.fromRegistryKey(WandItem)
  if it == nil:
    return
  var s = newItemStack(1'u8, it)
  discard insertStackAnywhere(p.inventory, s)
  if not s.isEmpty():
    p.asInventoryPlayer().dropItem(s, false)
  p.currentScreenHandler.sendContentUpdates()

proc usage(ctx: Ctx; text: string) =
  sayBad(ctx.sender, "Usage: " & text)

# ---- tools, brushes and entities in the clipboard --------------------------------------------------------------------

proc heldItemKey(ses: WeSession; key: var string): bool =
  let who = findPlayer(ses.name)
  if who.isNone:
    return false
  let s = who.unsafeGet.inventory.heldItem()
  if s.isEmpty():
    return false
  key = s.item.registryKey
  true

proc bindHeld(ctx: Ctx; tool: WeTool; equipped: string) =
  ## Binds the tool to the item in the main hand; `equipped` is the message, `{item}` for the item's id.
  var key = ""
  if not heldItemKey(ctx.ses, key):
    sayBad(ctx.sender, "You need to hold an item to bind a tool to it.")
    return
  if key == WandItem:
    sayBad(ctx.sender, "Can't bind tool to minecraft:" & key & ": it is the selection wand.")
    return
  var t = tool
  t.item = key
  bindTool(ctx.ses, t)
  sayOk(ctx.sender, equipped.replace("{item}", "minecraft:" & key))

proc unbindHeld(ctx: Ctx; msg: string) =
  var key = ""
  if heldItemKey(ctx.ses, key):
    discard unbindTool(ctx.ses, key)
  sayOk(ctx.sender, msg)

proc intArg(ctx: Ctx; at, fallback: int; v: var int): bool =
  v = fallback
  if at < ctx.parts.len:
    return parseInt(ctx.parts[at], v)
  true

proc brushCommand(ctx: Ctx) =
  ## `//brush sphere [-h] <pattern> [radius]`, `//brush cylinder [-h] <pattern> [radius] [height]`,
  ## `//brush smooth [size] [iterations]`, `//brush none`.
  if ctx.parts.len == 0:
    usage(ctx, "//brush <sphere|cylinder|smooth|none> ...")
    return
  let kind = ctx.parts[0].toLowerAscii()
  case kind
  of "sphere", "s", "cylinder", "cyl", "c":
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 2 or not parsePattern(ctx.parts[1], p, err):
      sayBad(ctx.sender, if err.len > 0: err else: "Usage: //brush " & kind & " [-h] <pattern> [radius]")
      return
    var radius = 2
    if not intArg(ctx, 2, 2, radius) or radius < 1 or radius > 50:
      sayBad(ctx.sender, "The radius must be a number from 1 to 50.")
      return
    var tool = WeTool(pattern: p, patternText: ctx.parts[1], radius: radius, hollow: 'h' in ctx.flags, height: 1, iterations: 1)
    if kind == "sphere" or kind == "s":
      tool.kind = wtBrushSphere
      bindHeld(ctx, tool, "Sphere brush shape equipped (" & $radius & ").")
    else:
      var height = 1
      if not intArg(ctx, 3, 1, height) or height < 1 or height > 256:
        sayBad(ctx.sender, "The height must be a number from 1 to 256.")
        return
      tool.kind = wtBrushCylinder
      tool.height = height
      bindHeld(ctx, tool, "Cylinder brush shape equipped (" & $radius & " by " & $height & ").")
  of "smooth":
    var size = 2
    var iterations = 4
    if not intArg(ctx, 1, 2, size) or size < 1 or size > 50 or not intArg(ctx, 2, 4, iterations) or iterations < 1:
      usage(ctx, "//brush smooth [size] [iterations]")
      return
    bindHeld(ctx, WeTool(kind: wtBrushSmooth, radius: size, iterations: iterations, height: 1),
      "Smooth brush equipped (" & $size & " x " & $iterations & "x using any block).")
  of "none":
    unbindHeld(ctx, "Brush unbound from your current item.")
  else:
    sayBad(ctx.sender, "Unknown brush " & kind & ": sphere, cylinder, smooth or none.")

proc toolCommand(ctx: Ctx) =
  ## `//tool none|info|repl <pattern>`.
  if ctx.parts.len == 0:
    usage(ctx, "//tool <none|info|repl> ...")
    return
  let kind = ctx.parts[0].toLowerAscii()
  case kind
  of "none":
    unbindHeld(ctx, "Tool unbound from your current item.")
  of "info":
    bindHeld(ctx, WeTool(kind: wtInfo, radius: 0, height: 1, iterations: 1), "Info tool bound to {item}.")
  of "repl":
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 2 or not parsePattern(ctx.parts[1], p, err):
      sayBad(ctx.sender, if err.len > 0: err else: "Usage: //tool repl <pattern>")
      return
    bindHeld(ctx, WeTool(kind: wtReplace, pattern: p, patternText: ctx.parts[1], height: 1, iterations: 1),
      "Block replacer tool bound to {item}.")
  else:
    sayBad(ctx.sender, "Unknown tool " & kind & ": none, info or repl.")

proc copyEntities(ctx: Ctx; remove: bool): int =
  ## `//copy -e`, `//cut -e`: the entities in the selection go into the clipboard (players never do).
  result = 0
  var box = weBox(0, 0, 0, 0, 0, 0)
  if not selectionBox(ctx.ses, box):
    return
  let cw = ctx.sender.player.entity.getWorld()
  # every entity of the world whose position is in the selection (`getEntitiesInBox` of the bridge only knows players)
  if cw == nil or not closureSet(cw.getEntities):
    return
  let found = cw.getEntities()
  for idx in 0 ..< found.len:
    let e = found[idx]
    if e.player != nil or e.entityTypeId == "minecraft:player" or not closureSet(e.writeNbt) or not closureSet(e.getPos):
      continue
    let pos = e.getPos()
    if pos.x < float(box.minX) or pos.x >= float(box.maxX + 1) or pos.y < float(box.minY) or pos.y >= float(box.maxY + 1) or
        pos.z < float(box.minZ) or pos.z >= float(box.maxZ + 1):
      continue
    var nbt = e.writeNbt()
    discard nbt.remove("UUID")
    discard nbt.remove("Pos")
    ctx.ses.clip.ents.add(ClipEntity(typeName: e.entityTypeName, fx: pos.x - float(box.minX), fy: pos.y - float(box.minY),
      fz: pos.z - float(box.minZ), nbt: nbt))
    if remove and closureSet(e.remove):
      e.remove()
    inc result

proc pasteEntities(ctx: Ctx): int =
  ## `//paste -e`: the clipboard's entities at their places relative to where you stand.
  result = 0
  if not ctx.ses.hasClip:
    return
  let c = ctx.ses.clip
  let cw = ctx.sender.player.entity.getWorld()
  if cw == nil or not closureSet(cw.spawnEntityNbt):
    return
  let minX = float(ctx.px - c.ox)
  let minY = float(ctx.py - c.oy)
  let minZ = float(ctx.pz - c.oz)
  for e in c.ents:
    discard cw.spawnEntityNbt(e.typeName, Vector3[float64](x: minX + e.fx, y: minY + e.fy, z: minZ + e.fz), e.nbt)
    inc result

proc runCommand*(sender: CommandSender; name, line: string) =
  var ctx = Ctx()
  if not setupCtx(sender, line, ctx):
    return
  let dimName = ctx.world.dimension.minecraftName
  case name
  of "pos1", "pos2":
    var x = 0
    var y = 0
    var z = 0
    if not coordsFromArgs(ctx, x, y, z):
      usage(ctx, "//" & name & " [x y z]")
      return
    if name == "pos1":
      setPos1(ctx.ses, dimName, x, y, z)
      posReply(ctx, 1)
    else:
      setPos2(ctx.ses, dimName, x, y, z)
      posReply(ctx, 2)
  of "wand":
    let who = findPlayer(ctx.ses.name)
    if who.isSome:
      giveWand(who.unsafeGet)
      sayOk(sender, "Left click a block with the wooden axe for position 1, right click for position 2.")
  of "sel", "desel":
    clearSelection(ctx.ses)
    sayOk(sender, "Selection cleared.")
  of "size":
    var b = weBox(0, 0, 0, 0, 0, 0)
    if not selectionBox(ctx.ses, b):
      sayBad(sender, "Make a selection first.")
    else:
      say(sender, "Size: " & $sizeX(b) & " x " & $sizeY(b) & " x " & $sizeZ(b) & ", " & $volume(b) & " blocks.")
  of "set":
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 1 or not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, if err.len > 0: err else: "Usage: //set <pattern>")
      return
    report(ctx, weSet(ctx.world, ctx.ses, p))
  of "replace":
    var m = Mask()
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 2:
      usage(ctx, "//replace <mask> <pattern>")
      return
    if not parseMask(ctx.parts[0], m, err) or not parsePattern(ctx.parts[1], p, err):
      sayBad(sender, err)
      return
    report(ctx, weReplace(ctx.world, ctx.ses, m, p))
  of "walls":
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 1 or not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, if err.len > 0: err else: "Usage: //walls <pattern>")
      return
    report(ctx, weWalls(ctx.world, ctx.ses, p))
  of "hollow":
    var p = singlePattern(0'u32)
    var err = ""
    if ctx.parts.len >= 1 and not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, err)
      return
    report(ctx, weHollow(ctx.world, ctx.ses, p))
  of "sphere", "cyl", "hsphere", "hcyl":
    let shape = if name.startsWith("h"): name.substr(1) else: name
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 2 or not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, if err.len > 0: err else: "Usage: //" & name & " [-h] <pattern> <radius> [height]")
      return
    var radii: seq[int] = @[]
    for q in ctx.parts[1].split(','):
      var n = 0
      if not parseInt(q, n):
        usage(ctx, "//" & name & " [-h] <pattern> <radius> [height]")
        return
      radii.add n
    let hollow = 'h' in ctx.flags or shape != name
    let raised = if 'r' in ctx.flags: 1 else: 0
    if shape == "sphere":
      let rx = radii[0]
      let ry = if radii.len > 1: radii[1] else: rx
      let rz = if radii.len > 2: radii[2] else: rx
      report(ctx, weSphere(ctx.world, ctx.ses, ctx.px, ctx.py + raised * ry, ctx.pz, p, rx, ry, rz, hollow))
    else:
      let rx = radii[0]
      let rz = if radii.len > 1: radii[1] else: rx
      var height = 1
      if ctx.parts.len > 2 and not parseInt(ctx.parts[2], height):
        usage(ctx, "//cyl [-h] <pattern> <radius> [height]")
        return
      report(ctx, weCyl(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, p, rx, rz, height, hollow))
  of "copy":
    var r = weCopy(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz)
    if r.ok and 'e' in ctx.flags:
      r.msg.add(" " & $copyEntities(ctx, false) & " entities copied.")
    report(ctx, r)
  of "cut":
    var p = singlePattern(0'u32)
    var err = ""
    if ctx.parts.len >= 1 and not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, err)
      return
    var r = weCut(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, p)
    if r.ok and 'e' in ctx.flags:
      r.msg.add(" " & $copyEntities(ctx, true) & " entities cut.")
    report(ctx, r)
  of "paste":
    var r = wePaste(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, 'a' in ctx.flags, 's' in ctx.flags)
    if r.ok and 'e' in ctx.flags:
      r.msg.add(" " & $pasteEntities(ctx) & " entities pasted.")
    report(ctx, r)
  of "rotate":
    var deg = 0
    if ctx.parts.len < 1 or not parseInt(ctx.parts[0], deg):
      usage(ctx, "//rotate <degrees>")
      return
    report(ctx, weRotate(ctx.ses, deg))
  of "flip":
    var dx = 0
    var dy = 0
    var dz = 0
    if not direction(ctx, (if ctx.parts.len > 0: ctx.parts[0] else: "me"), dx, dy, dz):
      usage(ctx, "//flip [direction]")
      return
    let axis = if dx != 0: 'x' elif dy != 0: 'y' else: 'z'
    report(ctx, weFlip(ctx.ses, axis))
  of "stack", "move":
    var count = 1
    var dx = 0
    var dy = 0
    var dz = 0
    var dirText = "me"
    for tok in ctx.parts:
      var n = 0
      if parseInt(tok, n):
        count = n
      else:
        dirText = tok
        break
    if not direction(ctx, dirText, dx, dy, dz):
      usage(ctx, "//" & name & " [count] [direction]")
      return
    if name == "stack":
      report(ctx, weStack(ctx.world, ctx.ses, count, dx, dy, dz, 'a' in ctx.flags))
    else:
      var leave = singlePattern(0'u32)
      var err = ""
      if ctx.parts.len >= 3 and not parsePattern(ctx.parts[2], leave, err):
        sayBad(sender, err)
        return
      report(ctx, weMove(ctx.world, ctx.ses, count, dx, dy, dz, leave, 's' in ctx.flags))
  of "count":
    var m = Mask()
    var err = ""
    if ctx.parts.len < 1 or not parseMask(ctx.parts[0], m, err):
      sayBad(sender, if err.len > 0: err else: "Usage: //count <mask>")
      return
    report(ctx, weCount(ctx.world, ctx.ses, m))
  of "distribution":
    var lines: seq[string] = @[]
    let r = weDistribution(ctx.world, ctx.ses, 'd' in ctx.flags, lines)
    report(ctx, r)
    if r.ok:
      var shown = 0
      for l in lines:
        if shown >= 15:
          break
        say(sender, "  " & l)
        inc shown
  of "undo":
    var n = 1
    if ctx.parts.len > 0:
      discard parseInt(ctx.parts[0], n)
    report(ctx, weUndo(ctx.world, ctx.ses, n))
  of "redo":
    var n = 1
    if ctx.parts.len > 0:
      discard parseInt(ctx.parts[0], n)
    report(ctx, weRedo(ctx.world, ctx.ses, n))
  of "expand", "contract":
    if name == "expand" and ctx.parts.len >= 1 and ctx.parts[0].toLowerAscii() == "vert":
      report(ctx, weExpandVert(ctx.world, ctx.ses))
      return
    var amount = 0
    if ctx.parts.len < 1 or not parseInt(ctx.parts[0], amount):
      usage(ctx, "//" & name & " <amount> [reverse-amount] [direction]" & (if name == "expand": " | //expand vert" else: ""))
      return
    var reverse = 0
    var dirText = "me"
    var i = 1
    if i < ctx.parts.len and parseInt(ctx.parts[i], reverse):
      inc i
    if i < ctx.parts.len:
      dirText = ctx.parts[i]
    var dx = 0
    var dy = 0
    var dz = 0
    if not direction(ctx, dirText, dx, dy, dz):
      sayBad(sender, "Unknown direction: " & dirText)
      return
    if name == "expand":
      report(ctx, weExpand(ctx.world, ctx.ses, amount, reverse, dx, dy, dz))
    else:
      report(ctx, weContract(ctx.world, ctx.ses, amount, reverse, dx, dy, dz))
  of "shift":
    var amount = 0
    if ctx.parts.len < 1 or not parseInt(ctx.parts[0], amount):
      usage(ctx, "//shift <amount> [direction]")
      return
    var dx = 0
    var dy = 0
    var dz = 0
    if not direction(ctx, (if ctx.parts.len > 1: ctx.parts[1] else: "me"), dx, dy, dz):
      sayBad(sender, "Unknown direction: " & ctx.parts[1])
      return
    report(ctx, weShift(ctx.world, ctx.ses, amount, dx, dy, dz))
  of "outset", "inset":
    var amount = 0
    if ctx.parts.len < 1 or not parseInt(ctx.parts[0], amount):
      usage(ctx, "//" & name & " [-h|-v] <amount>")
      return
    report(ctx, weOutset(ctx.world, ctx.ses, amount, 'h' in ctx.flags, 'v' in ctx.flags, name == "inset"))
  of "chunk":
    report(ctx, weChunk(ctx.world, ctx.ses, ctx.px, ctx.pz))
  of "center", "middle", "overlay":
    var p = Pattern()
    var err = ""
    if ctx.parts.len < 1 or not parsePattern(ctx.parts[0], p, err):
      sayBad(sender, if err.len > 0: err else: "Usage: //" & name & " <pattern>")
      return
    if name == "overlay":
      report(ctx, weOverlay(ctx.world, ctx.ses, p))
    else:
      report(ctx, weCenter(ctx.world, ctx.ses, p))
  of "smooth":
    var iterations = 1
    if ctx.parts.len > 0 and not parseInt(ctx.parts[0], iterations):
      usage(ctx, "//smooth [iterations]")
      return
    report(ctx, weSmooth(ctx.world, ctx.ses, iterations))
  of "naturalize":
    report(ctx, weNaturalize(ctx.world, ctx.ses))
  of "drain", "fixwater":
    var radius = 0
    if ctx.parts.len < 1 or not parseInt(ctx.parts[0], radius):
      usage(ctx, "//" & name & (if name == "drain": " [-w]" else: "") & " <radius>")
      return
    if name == "drain":
      report(ctx, weDrain(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, radius, 'w' in ctx.flags))
    else:
      report(ctx, weFixWater(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, radius))
  of "fill":
    var p = Pattern()
    var err = ""
    var radius = 0
    var depth = 1
    if ctx.parts.len < 2 or not parsePattern(ctx.parts[0], p, err) or not parseInt(ctx.parts[1], radius) or
        (ctx.parts.len > 2 and not parseInt(ctx.parts[2], depth)):
      sayBad(sender, if err.len > 0: err else: "Usage: //fill <pattern> <radius> [depth]")
      return
    report(ctx, weFill(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, p, radius, depth))
  of "line":
    var p = Pattern()
    var err = ""
    var thickness = 0
    if ctx.parts.len < 1 or not parsePattern(ctx.parts[0], p, err) or (ctx.parts.len > 1 and not parseInt(ctx.parts[1], thickness)):
      sayBad(sender, if err.len > 0: err else: "Usage: //line [-h] <pattern> [thickness]")
      return
    report(ctx, weLine(ctx.world, ctx.ses, p, thickness, 'h' in ctx.flags))
  of "pyramid", "hpyramid":
    var p = Pattern()
    var err = ""
    var size = 0
    if ctx.parts.len < 2 or not parsePattern(ctx.parts[0], p, err) or not parseInt(ctx.parts[1], size):
      sayBad(sender, if err.len > 0: err else: "Usage: //" & name & " <pattern> <size>")
      return
    report(ctx, wePyramid(ctx.world, ctx.ses, ctx.px, ctx.py, ctx.pz, p, size, name == "hpyramid" or 'h' in ctx.flags))
  of "brush", "br":
    brushCommand(ctx)
  of "tool":
    toolCommand(ctx)
  of "none":
    unbindHeld(ctx, "Tool unbound from your current item.")
  of "clearhistory":
    report(ctx, weClearHistory(ctx.ses))
  of "historysize":
    if ctx.parts.len == 0:
      say(sender, "History size: " & $ctx.ses.historyLimit & " edit(s) (" & $ctx.ses.undo.len & " to undo, " & $ctx.ses.redo.len &
        " to redo).")
      return
    var n = 0
    if not parseInt(ctx.parts[0], n):
      usage(ctx, "//historysize [entries]")
      return
    report(ctx, weSetHistoryLimit(ctx.ses, n))
  else:
    sayBad(sender, "Unknown WorldEdit command " & name & ".")

# ---- the command tree ------------------------------------------------------------------------------------------------
#
# Every command is a real node of the brigadier dispatcher, under a root literal whose name starts with a slash (`/set`), as
# WorldEdit for Fabric registers them: the client then knows `//set`, completes it and hints its arguments. The arguments are
# typed for the client (block positions, integers, directions with suggestions, patterns with block-name suggestions asked of
# the server); the executors put the parsed values back into one line and hand it to `runCommand`, the same code `/we` uses.
#
# A pattern or mask that is the last argument is a greedy string. One that is followed by more arguments (`//replace <from>
# <to>`, `//sphere <pattern> <radius>`) goes to the client as a `score_holder`: the only vanilla parser that takes any run of
# characters up to a space, so `50%stone,dirt` or `!air` is not marked as an error; its completions come from the server.

const
  ArgPos = "pos"
  ArgCoords = "coords"
  ArgPattern = "pattern"
  ArgMask = "mask"
  ArgFrom = "from"
  ArgTo = "to"
  ArgRadius = "radius"
  ArgRadii = "radii"
  ArgHeight = "height"
  ArgLeave = "leave"
  ArgDegrees = "degrees"
  ArgDirection = "direction"
  ArgCount = "count"
  ArgTimes = "times"
  ArgAmount = "amount"
  ArgReverse = "reverse"
  ArgThickness = "thickness"
  ArgDepth = "depth"
  ArgSize = "size"
  ArgIterations = "iterations"
  ArgEntries = "entries"
  DirectionNames = ["me", "north", "south", "east", "west", "up", "down"]
  MaxBlockSuggestions = 100

proc expectedValueError(): CommandErrorType = literalErrorType("Expected a value")

proc tokenType(client: JavaClientArgumentType; examples: seq[string]): AnyArgumentType =
  ## Any characters up to the next space; the client parses the argument as `client`.
  AnyArgumentType(clientParser: client, overrideSuggestion: none[SuggestionProviders](), examples: examples,
    parseProc: proc(r: var StringReader): CmdResult[ArgValue] {.closure.} =
      let start = cursor(r)
      readUntilSpace(r)
      let stop = cursor(r)
      if stop == start:
        return cmdFail[ArgValue](create(expectedValueError(), r))
      cmdOk[ArgValue](boxString(r.str[start ..< stop])))

proc anyTokenType(examples: seq[string]): AnyArgumentType =
  tokenType(JavaClientArgumentType(kind: atScoreHolder, flags: ScoreHolderFlagAllowMultiple), examples)

proc blockSuggestions(context: CommandContext; builder: SuggestionsBuilder): Suggestions =
  ## The block names that complete the element being typed: the text after the last `,`, `%` or `!` outside of `[...]`.
  var b = builder
  let typed = remaining(builder)
  var cut = 0
  var depth = 0
  var i = 0
  while i < typed.len:
    let c = typed[i]
    if c == '[':
      inc depth
    elif c == ']':
      dec depth
    elif depth == 0 and (c == ',' or c == '%' or c == '!'):
      cut = i + 1
    inc i
  if depth > 0:
    return build(b)
  let head = typed[0 ..< cut]
  var tail = toLowerAscii(typed[cut ..< typed.len])
  var ns = ""
  if tail.startsWith("minecraft:"):
    ns = "minecraft:"
    tail = tail[10 ..< tail.len]
  var shown = 0
  var id = 0
  let n = blockCount()
  while id < n and shown < MaxBlockSuggestions:
    let name = blockName(id)
    if name.startsWith(tail):
      b = suggest(b, head & ns & name)
      inc shown
    inc id
  build(b)

proc directionSuggestions(context: CommandContext; builder: SuggestionsBuilder): Suggestions =
  var b = builder
  let typed = remainingLowercase(builder)
  for d in DirectionNames:
    if d.startsWith(typed):
      b = suggest(b, d)
  build(b)

proc greedyPattern(name: string): ArgumentBuilder =
  suggests(argument(name, newStringArgumentType(spGreedyPhrase)), blockSuggestions)

proc tokenPattern(name: string): ArgumentBuilder =
  suggests(argument(name, anyTokenType(@["stone", "50%stone,50%dirt", "oak_log[axis=y]"])), blockSuggestions)

proc directionArg(): ArgumentBuilder =
  suggests(argument(ArgDirection, newStringArgumentType(spSingleWord)), directionSuggestions)

proc argText(c: CommandContext; name: string): string =
  ## The text of an argument as the user meant it ("" when it was not given); a block position comes back resolved, `x y z`.
  let s = getString(c, name)
  if s.isOk:
    return s.value
  let i = getInt(c, name)
  if i.isOk:
    return $i.value
  let p = getBlockPos(c, name)
  if p.isOk:
    return $p.value.vec.x & " " & $p.value.vec.y & " " & $p.value.vec.z
  ""

proc weExec(name, flags: string; argNames: seq[string]; lead = ""): CommandExecutor =
  ## Rebuilds `[lead] [-flags] <args...>` from the parsed arguments and runs the WorldEdit command.
  result = proc(context: CommandContext): CmdResult[int32] {.closure.} =
    var line = lead
    if flags.len > 0:
      if line.len > 0:
        line.add(' ')
      line.add("-" & flags)
    for a in argNames:
      let t = argText(context, a)
      if t.len > 0:
        if line.len > 0:
          line.add(' ')
        line.add(t)
    runCommand(context.source.output, name, line)
    cmdOk[int32](1'i32)

proc weRoot(name, description: string): ArgumentBuilder =
  requires(command("/" & name, description), Permission0)

proc flagNode(parent: ArgumentBuilder; flags: string): ArgumentBuilder =
  ## The node the arguments hang off for this flag set: the command itself, or its `-<flags>` literal.
  if flags.len == 0: parent else: literal("-" & flags)

proc attachFlag(parent, node: ArgumentBuilder; flags: string): ArgumentBuilder =
  if flags.len == 0: node else: then(parent, node)

proc plainCommand(name, description: string): ArgumentBuilder =
  executes(weRoot(name, description), weExec(name, "", @[]))

proc posCommand(name, description: string): ArgumentBuilder =
  result = executes(weRoot(name, description), weExec(name, "", @[]))
  result = then(result, executes(argument(ArgPos, newBlockPosArgumentType()), weExec(name, "", @[ArgPos])))
  result = then(result, executes(argument(ArgCoords, anyTokenType(@["10,64,-3"])), weExec(name, "", @[ArgCoords])))

proc patternCommand(name, description, argName: string; optional: bool): ArgumentBuilder =
  ## `//<name> <pattern>`, or `//<name> [pattern]` when `optional`.
  result = weRoot(name, description)
  if optional:
    result = executes(result, weExec(name, "", @[]))
  result = then(result, executes(greedyPattern(argName), weExec(name, "", @[argName])))

proc replaceCommand(): ArgumentBuilder =
  then(weRoot("replace", "Replaces the blocks matching a mask in the selection with a pattern."),
    then(tokenPattern(ArgFrom), executes(greedyPattern(ArgTo), weExec("replace", "", @[ArgFrom, ArgTo]))))

proc shapeCommand(name, description: string; flagSets: seq[string]; withHeight: bool): ArgumentBuilder =
  ## `//sphere [-h|-r|-hr] <pattern> <radius>|<rx,ry,rz>`, `//cyl [-h] <pattern> <radius>|<rx,rz> [height]`.
  result = weRoot(name, description)
  for flags in flagSets:
    let args = @[ArgPattern, ArgRadius, ArgRadii, ArgHeight]
    var radius = executes(argument(ArgRadius, newIntegerArgumentType(1'i32)), weExec(name, flags, args))
    var radii = executes(argument(ArgRadii, anyTokenType(@["5", "5,3,5"])), weExec(name, flags, args))
    if withHeight:
      radius = then(radius, executes(argument(ArgHeight, newIntegerArgumentType(1'i32)), weExec(name, flags, args)))
      radii = then(radii, executes(argument(ArgHeight, newIntegerArgumentType(1'i32)), weExec(name, flags, args)))
    let pattern = then(then(tokenPattern(ArgPattern), radius), radii)
    let at = flagNode(result, flags)
    result = attachFlag(result, then(at, pattern), flags)

proc pasteCommand(): ArgumentBuilder =
  result = executes(weRoot("paste", "Pastes the clipboard where you stand (-a skips air, -s selects the pasted region)."),
    weExec("paste", "", @[]))
  for flags in ["a", "s", "e", "as", "ae", "se", "ase"]:
    result = then(result, executes(literal("-" & flags), weExec("paste", flags, @[])))

proc stackOrMove(name, description: string; flagSets: seq[string]): ArgumentBuilder =
  ## `//stack [-a] [count] [direction]`, `//move [-s] [count] [direction] [leave]`.
  result = weRoot(name, description)
  for flags in flagSets:
    let args = @[ArgCount, ArgDirection, ArgLeave]
    var dirAfterCount = executes(directionArg(), weExec(name, flags, args))
    if name == "move":
      dirAfterCount = then(dirAfterCount, executes(greedyPattern(ArgLeave), weExec(name, flags, args)))
    let count = then(executes(argument(ArgCount, newIntegerArgumentType(1'i32)), weExec(name, flags, args)), dirAfterCount)
    let dirOnly = executes(directionArg(), weExec(name, flags, args))
    let at = executes(flagNode(result, flags), weExec(name, flags, @[]))
    result = attachFlag(result, then(then(at, count), dirOnly), flags)

proc expandCommand(name, description: string): ArgumentBuilder =
  ## `//expand <amount> [reverse] [direction]` (and `//expand vert`), `//contract <amount> [reverse] [direction]`.
  let args = @[ArgAmount, ArgReverse, ArgDirection]
  let reverse = then(executes(argument(ArgReverse, newIntegerArgumentType()), weExec(name, "", args)),
    executes(directionArg(), weExec(name, "", args)))
  let amount = then(then(executes(argument(ArgAmount, newIntegerArgumentType()), weExec(name, "", args)), reverse),
    executes(directionArg(), weExec(name, "", args)))
  result = then(weRoot(name, description), amount)
  if name == "expand":
    result = then(result, executes(literal("vert"), weExec(name, "", @[], "vert")))

proc amountFlagsCommand(name, description: string; flagSets: seq[string]; argName: string; withDirection: bool): ArgumentBuilder =
  ## `//<name> [-flags] <amount> [direction]`: shift, outset, inset, drain, fixwater.
  result = weRoot(name, description)
  for flags in flagSets:
    let args = @[argName, ArgDirection]
    let minimum = if withDirection: int32.low else: 1'i32
    var amount = executes(argument(argName, newIntegerArgumentType(minimum)), weExec(name, flags, args))
    if withDirection:
      amount = then(amount, executes(directionArg(), weExec(name, flags, args)))
    result = attachFlag(result, then(flagNode(result, flags), amount), flags)

proc intChain(name, flags: string; args, ints: seq[string]; at: int): ArgumentBuilder =
  ## `<ints[at]> [<ints[at+1]> ...]`, each one executable.
  result = executes(argument(ints[at], newIntegerArgumentType(0'i32)), weExec(name, flags, args))
  if at + 1 < ints.len:
    result = then(result, intChain(name, flags, args, ints, at + 1))

proc patternIntsCommand(name, description: string; flagSets: seq[string]; ints: seq[string]; required: int): ArgumentBuilder =
  ## `//<name> [-flags] <pattern> <int>... [int]...`: the first `required` integers must be given.
  result = weRoot(name, description)
  for flags in flagSets:
    var args = @[ArgPattern]
    for n in ints:
      args.add n
    var pattern = tokenPattern(ArgPattern)
    if required == 0:
      pattern = executes(pattern, weExec(name, flags, args))
    if ints.len > 0:
      pattern = then(pattern, intChain(name, flags, args, ints, 0))
    result = attachFlag(result, then(flagNode(result, flags), pattern), flags)

proc brushShape(shape: string): ArgumentBuilder =
  ## `sphere [-h] <pattern> [radius]`, `cylinder [-h] <pattern> [radius] [height]`.
  result = literal(shape)
  for flags in ["", "h"]:
    let args = @[ArgPattern, ArgRadius, ArgHeight]
    var radius = executes(argument(ArgRadius, newIntegerArgumentType(1'i32, 50'i32)), weExec("brush", flags, args, shape))
    if shape == "cylinder":
      radius = then(radius, executes(argument(ArgHeight, newIntegerArgumentType(1'i32, 256'i32)),
        weExec("brush", flags, args, shape)))
    let pattern = then(executes(tokenPattern(ArgPattern), weExec("brush", flags, args, shape)), radius)
    result = attachFlag(result, then(flagNode(result, flags), pattern), flags)

proc brushCommandTree(): ArgumentBuilder =
  ## `//brush sphere|cylinder|smooth|none ...` (alias `//br`).
  # executable (it prints the usage), so the `//br` alias copies its permission requirement
  result = executes(weRoot("brush", "Binds a brush to the item in your hand; right click to use it."), weExec("brush", "", @[]))
  result = then(result, brushShape("sphere"))
  result = then(result, brushShape("cylinder"))
  let smoothArgs = @[ArgSize, ArgIterations]
  let iterations = executes(argument(ArgIterations, newIntegerArgumentType(1'i32)), weExec("brush", "", smoothArgs, "smooth"))
  let size = then(executes(argument(ArgSize, newIntegerArgumentType(1'i32, 50'i32)), weExec("brush", "", smoothArgs, "smooth")),
    iterations)
  result = then(result, then(executes(literal("smooth"), weExec("brush", "", @[], "smooth")), size))
  result = then(result, executes(literal("none"), weExec("brush", "", @[], "none")))

proc toolCommandTree(): ArgumentBuilder =
  ## `//tool none|info|repl <pattern>`.
  result = weRoot("tool", "Binds a tool to the item in your hand: info, repl <pattern>, none.")
  result = then(result, executes(literal("none"), weExec("tool", "", @[], "none")))
  result = then(result, executes(literal("info"), weExec("tool", "", @[], "info")))
  result = then(result, then(literal("repl"), executes(greedyPattern(ArgPattern), weExec("tool", "", @[ArgPattern], "repl"))))

proc historyCommand(name, description: string): ArgumentBuilder =
  then(executes(weRoot(name, description), weExec(name, "", @[])),
    executes(argument(ArgTimes, newIntegerArgumentType(1'i32)), weExec(name, "", @[ArgTimes])))

proc weAllExecutor(context: CommandContext): CmdResult[int32] =
  ## `/we <name> <args>`: the same commands for a console or a client that cannot type the double slash.
  let sender = context.source.output
  var line = ""
  let given = getString(context, ArgRest)
  if given.isOk:
    line = given.value
  let words = line.splitWhitespace()
  if words.len == 0:
    var all = ""
    for n in CommandNames:
      all.add("//" & n & " ")
    say(sender, "/we <command> [args]: " & all)
  else:
    var rest = ""
    for i in 1 ..< words.len:
      rest.add(words[i] & " ")
    runCommand(sender, words[0].strip(chars = {'/'}), rest)
  cmdOk[int32](1'i32)

proc registerWorldEditCommands*(d: CommandDispatcher) =
  ## Every WorldEdit command as a node of the dispatcher (so the client's command tree has it), op level 2.
  discard register(d, posCommand("pos1", "Sets position 1 of the selection (your block, or the coordinates given)."))
  discard register(d, posCommand("pos2", "Sets position 2 of the selection (your block, or the coordinates given)."))
  discard register(d, plainCommand("wand", "Gives you the selection wand (a wooden axe)."))
  discard register(d, plainCommand("sel", "Clears the selection."))
  discard register(d, plainCommand("desel", "Clears the selection."))
  discard register(d, plainCommand("size", "Shows the size of the selection."))
  discard register(d, patternCommand("set", "Sets every block of the selection to a pattern.", ArgPattern, false))
  discard register(d, replaceCommand())
  discard register(d, patternCommand("walls", "Builds the four walls of the selection.", ArgPattern, false))
  discard register(d, patternCommand("hollow", "Hollows out the selection, leaving a one-block shell (air or a pattern inside).",
    ArgPattern, true))
  discard register(d, shapeCommand("sphere", "Builds a sphere centred on you (-h hollow, -r raised).", @["", "h", "r", "hr"], false))
  discard register(d, shapeCommand("cyl", "Builds a cylinder standing on your block (-h hollow).", @["", "h"], true))
  discard register(d, then(plainCommand("copy", "Copies the selection to your clipboard, relative to where you stand (-e entities too)."),
    executes(literal("-e"), weExec("copy", "e", @[]))))
  var cut = patternCommand("cut", "Copies the selection and clears it (to air, or the pattern given; -e entities too).", ArgLeave, true)
  cut = then(cut, then(executes(literal("-e"), weExec("cut", "e", @[])),
    executes(greedyPattern(ArgLeave), weExec("cut", "e", @[ArgLeave]))))
  discard register(d, cut)
  discard register(d, pasteCommand())
  discard register(d, then(weRoot("rotate", "Rotates the clipboard around the vertical axis (multiples of 90)."),
    executes(argument(ArgDegrees, newIntegerArgumentType()), weExec("rotate", "", @[ArgDegrees]))))
  discard register(d, then(executes(weRoot("flip", "Flips the clipboard along a direction (default: where you look)."),
    weExec("flip", "", @[])), executes(directionArg(), weExec("flip", "", @[ArgDirection]))))
  discard register(d, stackOrMove("stack", "Repeats the selection along a direction (-a skips air).", @["", "a"]))
  discard register(d, stackOrMove("move", "Moves the selection along a direction (-s moves the selection too).", @["", "s"]))
  discard register(d, then(weRoot("count", "Counts the blocks in the selection that match a mask."),
    executes(suggests(argument(ArgMask, newStringArgumentType(spGreedyPhrase)), blockSuggestions), weExec("count", "", @[ArgMask]))))
  discard register(d, then(executes(weRoot("distribution", "Lists the blocks of the selection by count (-d by block state)."),
    weExec("distribution", "", @[])), executes(literal("-d"), weExec("distribution", "d", @[]))))
  discard register(d, historyCommand("undo", "Undoes your last edits."))
  discard register(d, historyCommand("redo", "Redoes edits you undid."))
  # selection changes
  discard register(d, expandCommand("expand", "Expands the selection along a direction (or vert: the full height)."))
  discard register(d, expandCommand("contract", "Contracts the selection along a direction."))
  discard register(d, amountFlagsCommand("shift", "Moves the selection (not its blocks) along a direction.", @[""], ArgAmount, true))
  discard register(d, amountFlagsCommand("outset", "Moves every face of the selection out (-h horizontal only, -v vertical only).",
    @["", "h", "v"], ArgAmount, false))
  discard register(d, amountFlagsCommand("inset", "Moves every face of the selection in (-h horizontal only, -v vertical only).",
    @["", "h", "v"], ArgAmount, false))
  discard register(d, plainCommand("chunk", "Selects the chunk you stand in, the full height of the world."))
  # region edits
  discard register(d, patternCommand("center", "Sets the centre block(s) of the selection.", ArgPattern, false))
  discard register(d, then(executes(weRoot("smooth", "Smooths the terrain of the selection (height map, Gaussian)."),
    weExec("smooth", "", @[])), executes(argument(ArgIterations, newIntegerArgumentType(1'i32)), weExec("smooth", "", @[ArgIterations]))))
  discard register(d, plainCommand("naturalize", "Grass on top, three dirt below, stone further down, in the selection."))
  discard register(d, patternCommand("overlay", "Puts the pattern on top of the highest block of every column.", ArgPattern, false))
  discard register(d, patternIntsCommand("line", "Draws a line from position 1 to position 2 (-h hollow).", @["", "h"], @[ArgThickness], 0))
  # around the player
  discard register(d, amountFlagsCommand("drain", "Drains the water and lava around you (-w waterlogged blocks too).", @["", "w"],
    ArgRadius, false))
  discard register(d, amountFlagsCommand("fixwater", "Turns the water around you (and air below your feet) into still water.", @[""],
    ArgRadius, false))
  discard register(d, patternIntsCommand("fill", "Fills the hole you stand in, sideways and down.", @[""], @[ArgRadius, ArgDepth], 1))
  discard register(d, patternIntsCommand("pyramid", "Builds a pyramid on your block.", @[""], @[ArgSize], 1))
  discard register(d, patternIntsCommand("hpyramid", "Builds a hollow pyramid on your block.", @[""], @[ArgSize], 1))
  discard register(d, shapeCommand("hsphere", "Builds a hollow sphere centred on you (-r raised).", @["", "r"], false))
  discard register(d, shapeCommand("hcyl", "Builds a hollow cylinder standing on your block.", @[""], true))
  # tools, brushes, history
  discard registerWithAliases(d, brushCommandTree(), ["/br"])
  discard register(d, toolCommandTree())
  discard register(d, plainCommand("none", "Unbinds the tool or brush from the item in your hand."))
  discard register(d, plainCommand("clearhistory", "Clears your undo and redo history."))
  discard register(d, then(executes(weRoot("historysize", "Shows or sets how many edits //undo keeps."), weExec("historysize", "", @[])),
    executes(argument(ArgEntries, newIntegerArgumentType(0'i32, int32(MaxHistoryLimit))), weExec("historysize", "", @[ArgEntries]))))
  let weNode = then(executes(requires(command("we", Description), Permission0), weAllExecutor),
    executes(argument(ArgRest, newStringArgumentType(spGreedyPhrase)), weAllExecutor))
  discard registerWithAliases(d, weNode, ["worldedit"])
  var names: seq[string] = @[]
  for n in CommandNames:
    names.add("/" & n)
  names.add("/br")
  names.add("we")
  registerBuiltinMod(BuiltinMod(name: "WorldEdit", version: "1.0", description: Description, commands: names))

# ---- the wand and the cui handshake ----------------------------------------------------------------------------------

proc isOperator(p: Player): bool =
  ord(p.permissionLvl) >= 2

proc holdsWand(p: Player): bool =
  let s = p.inventory.heldItem()
  if s.isEmpty():
    return false
  s.item.registryKey == WandItem

proc wandClick(p: Player; which: int; x, y, z: int): bool =
  ## True when the click was the wand's (the block must not break or be used).
  if not isOperator(p) or not holdsWand(p):
    return false
  let ses = sessionFor(p.gameprofile.name)
  let dim = p.world.dimension.minecraftName
  var same = false
  if which == 1:
    same = ses.has1 and ses.dim == dim and ses.p1x == x and ses.p1y == y and ses.p1z == z
    if not same:
      setPos1(ses, dim, x, y, z)
  else:
    same = ses.has2 and ses.dim == dim and ses.p2x == x and ses.p2y == y and ses.p2z == z
    if not same:
      setPos2(ses, dim, x, y, z)
  if not same:
    let vol = selectionVolume(ses)
    p.sendSystemMessage(colorNamed(text("Position " & $which & " set to (" & $x & ", " & $y & ", " & $z & ")" &
      (if vol > 0: " (" & $vol & " blocks)." else: ".")), ncGreen))
  true

proc useTool(p: Player; clicked: Option[BlockPos]): bool =
  ## A right click with an item a tool is bound to: true when the tool took it (the click does nothing else).
  if not isOperator(p):
    return false
  let held = p.inventory.heldItem()
  if held.isEmpty():
    return false
  let ses = sessionFor(p.gameprofile.name)
  var tool = WeTool()
  if not toolFor(ses, held.item.registryKey, tool):
    return false
  if ses.lastToolTick == gLastTick:
    return true
  ses.lastToolTick = gLastTick
  let w = worldByDimName(p.world.dimension.minecraftName)
  if w.isNone:
    return true
  var hx = 0
  var hy = 0
  var hz = 0
  if clicked.isSome:
    let at: BlockPos = clicked.unsafeGet
    hx = int(at.vec.x)
    hy = int(at.vec.y)
    hz = int(at.vec.z)
  elif tool.kind == wtInfo or tool.kind == wtReplace:
    return false
  elif not weRaycast(w.unsafeGet, p.pos.x, p.pos.y + 1.62, p.pos.z, float(p.yaw), float(p.pitch), 300.0, hx, hy, hz):
    p.sendSystemMessage(colorNamed(text("No block in sight!"), ncRed))
    return true
  let r = weUseTool(w.unsafeGet, ses, tool, hx, hy, hz)
  if tool.kind == wtInfo or not r.ok:
    p.sendSystemMessage(colorNamed(text(r.msg), if r.ok: ncLightPurple else: ncRed))
  true

proc installWorldEdit*(server: Server) =
  ## Chains the wand clicks and the cui handshake onto the plugin event hooks, once; advertises the `cui` capability.
  if gInstalled:
    return
  gInstalled = true
  gServer = some(server)
  advertiseCapabilityBit(CapCui)
  gPrevEvent = gPluginPlayerEventHook
  gPluginPlayerEventHook = proc(player: Player; ev: PlayerEv): (bool, bool) {.closure.} =
    let before = gPrevEvent(player, ev)
    if before[0]:
      return before
    if ev.kind == pekUseItem:
      if useTool(player, none[BlockPos]()):
        return (true, false)
    elif ev.kind == pekBlockBreak:
      if wandClick(player, 1, int(ev.pos.vec.x), int(ev.pos.vec.y), int(ev.pos.vec.z)):
        return (true, false)
    elif ev.kind == pekCustomPayload and ev.text == CuiChannel:
      let ses = sessionFor(player.gameprofile.name)
      ses.cuiHello = true
      ses.cuiDirty = true
    before
  gPrevInteract = gPluginInteractHook
  gPluginInteractHook = proc(player: Player; action: int; pos: Option[BlockPos]): bool {.closure.} =
    if gPrevInteract(player, action, pos):
      return true
    if action == 3 and pos.isSome:
      let at: BlockPos = pos.unsafeGet
      if wandClick(player, 2, int(at.vec.x), int(at.vec.y), int(at.vec.z)):
        return true
      if useTool(player, pos):
        return true
    false
