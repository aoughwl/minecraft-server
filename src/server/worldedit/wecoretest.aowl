## wecore.aowl on plain grids: parsing, patterns, masks, shapes, direction, state rotation, clipboard rotate / flip.
import std/[assertions, syncio, strutils]
import ../../world/blockstates
import wecore

var failures = 0

proc check(name: string; cond: bool) =
  if cond:
    echo "PASS ", name
  else:
    echo "FAIL ", name
    inc failures

proc stateOf(text: string): uint32 =
  var s = 0'u32
  var err = ""
  if not parseBlockState(text, s, err):
    echo "BAD TEST BLOCK ", text, ": ", err
    inc failures
  s

let stone = stateOf("stone")
let dirt = stateOf("dirt")
let air = stateOf("air")

# ---- parsing
var st = 0'u32
var err = ""
check("parse stone", parseBlockState("minecraft:stone", st, err) and st == stone)
check("parse state props", parseBlockState("oak_stairs[facing=east,half=top]", st, err) and st != stateOf("oak_stairs"))
check("reject unknown block", not parseBlockState("notablock", st, err))
check("reject bad property", not parseBlockState("oak_stairs[facing=up2]", st, err))
check("reject unclosed", not parseBlockState("oak_stairs[facing=east", st, err))

var pat = Pattern()
check("pattern single", parsePattern("stone", pat, err) and pat.entries.len == 1 and pick(pat, 1, 2, 3) == stone)
check("pattern weights", parsePattern("70%stone,30%dirt", pat, err) and pat.total == 100)
var nStone = 0
var nDirt = 0
for i in 0 ..< 10000:
  let v = pick(pat, i, i div 7, i div 13)
  if v == stone: inc nStone
  elif v == dirt: inc nDirt
check("pattern only its blocks", nStone + nDirt == 10000)
check("pattern odds near 70/30", nStone > 6500 and nStone < 7500)
check("pattern deterministic", pick(pat, 5, 6, 7) == pick(pat, 5, 6, 7))
check("pattern with bracket commas", parsePattern("oak_stairs[facing=east,half=top],stone", pat, err) and pat.entries.len == 2)
check("pattern rejects bad %", not parsePattern("x%stone", pat, err))

var mask = Mask()
check("mask parse", parseMask("stone,dirt", mask, err))
check("mask matches", mask.matches(stone) and mask.matches(dirt) and not mask.matches(air))
check("negated mask", parseMask("!air", mask, err) and mask.matches(stone) and not mask.matches(air))
check("star mask", parseMask("*", mask, err) and mask.matches(air))
check("mask with props", parseMask("oak_stairs[facing=east]", mask, err) and mask.matches(stateOf("oak_stairs[facing=east,half=top]")) and
  not mask.matches(stateOf("oak_stairs[facing=west]")))

# ---- directions
var dx = 0
var dy = 0
var dz = 0
check("direction north", parseDirection("n", dx, dy, dz) and dx == 0 and dy == 0 and dz == -1)
check("direction up", parseDirection("up", dx, dy, dz) and dy == 1)
check("direction bad", not parseDirection("sideways", dx, dy, dz))
check("facing south at yaw 0", facingOf(0.0, 0.0) == (0, 0, 1))
check("facing west at yaw 90", facingOf(90.0, 0.0) == (-1, 0, 0))
check("facing north at yaw 180", facingOf(180.0, 0.0) == (0, 0, -1))
check("facing east at yaw -90", facingOf(-90.0, 0.0) == (1, 0, 0))
check("facing down at pitch 80", facingOf(0.0, 80.0) == (0, -1, 0))

# ---- state rotation
let stairsN = stateOf("oak_stairs[facing=north,half=bottom,shape=straight]")
let stairsE = stateOf("oak_stairs[facing=east,half=bottom,shape=straight]")
check("stairs turn a quarter", rotateState(stairsN, 1) == stairsE)
check("stairs turn four quarters is identity", rotateState(rotateState(rotateState(rotateState(stairsN, 1), 1), 1), 1) == stairsN)
check("stairs half turn", rotateState(stairsN, 2) == stateOf("oak_stairs[facing=south,half=bottom,shape=straight]"))
check("log axis x -> z", rotateState(stateOf("oak_log[axis=x]"), 1) == stateOf("oak_log[axis=z]"))
check("log axis y unchanged", rotateState(stateOf("oak_log[axis=y]"), 1) == stateOf("oak_log[axis=y]"))
check("stone unchanged", rotateState(stone, 3) == stone)
check("fence sides turn", rotateState(stateOf("oak_fence[north=true,east=false,south=false,west=false]"), 1) ==
  stateOf("oak_fence[north=false,east=true,south=false,west=false]"))
check("mirror x swaps east/west", mirrorState(stairsE, 'x') == stateOf("oak_stairs[facing=west,half=bottom,shape=straight]"))
check("mirror z leaves east", mirrorState(stairsE, 'z') == stairsE)
check("mirror y flips half", mirrorState(stairsN, 'y') == stateOf("oak_stairs[facing=north,half=top,shape=straight]"))
check("mirror twice is identity", mirrorState(mirrorState(stairsE, 'x'), 'x') == stairsE)

# ---- shapes
let sph = sphereCells(0, 0, 0, 5, 5, 5, false)
let sphHollow = sphereCells(0, 0, 0, 5, 5, 5, true)
check("sphere volume plausible (4/3 pi 5.5^3 = 697)", sph.len > 600 and sph.len < 800)
check("hollow sphere smaller", sphHollow.len < sph.len and sphHollow.len > 100)
var symmetric = true
for c in sph:
  var mirrorHit = false
  for d in sph:
    if d[0] == -c[0] and d[1] == c[1] and d[2] == c[2]:
      mirrorHit = true
      break
  if not mirrorHit:
    symmetric = false
    break
check("sphere symmetric in x", symmetric)
let cyl = cylCells(0, 10, 0, 4, 4, 6, false)
check("cylinder has 6 layers", cyl.len > 0 and cyl.len mod 6 == 0)
let cylHollow = cylCells(0, 10, 0, 4, 4, 6, true)
check("hollow cylinder has no centre", cylHollow.len < cyl.len and cylHollow.len > 0)
var centreIn = false
for c in cylHollow:
  if c[0] == 0 and c[2] == 0:
    centreIn = true
check("hollow cylinder centre empty", not centreIn)
let box = weBox(0, 0, 0, 4, 4, 4)
check("walls: edge in, centre out", onWalls(box, 0, 2) and not onWalls(box, 2, 2))
check("shell: top in, centre out", onShell(box, 2, 4, 2) and not onShell(box, 2, 2, 2))
check("box volume", volume(box) == 125)

# ---- grid, count, distribution
var g = newGrid(weBox(10, 5, 20, 12, 6, 22))
for i in 0 ..< g.cells.len:
  g.cells[i] = stone
g.setCell(11, 5, 21, dirt)
g.setCell(12, 6, 22, dirt)
check("grid index round trip", g.cellAt(11, 5, 21) == dirt and g.cellAt(10, 5, 20) == stone)
var m2 = Mask()
discard parseMask("dirt", m2, err)
check("count dirt", countMatching(g, m2) == 2)
let dist = distribution(g, false)
check("distribution sorted", dist.len == 2 and dist[0][0] == "stone" and dist[0][1] == 16 and dist[1][0] == "dirt" and dist[1][1] == 2)
check("distribution total", dist[0][1] + dist[1][1] == 18)

# ---- clipboard rotate / flip
var cg = newGrid(weBox(0, 0, 0, 2, 0, 1))   # 3 wide (x), 1 high, 2 deep (z)
for i in 0 ..< cg.cells.len:
  cg.cells[i] = air
cg.setCell(0, 0, 0, stone)
cg.setCell(2, 0, 1, dirt)
cg.setCell(1, 0, 0, stairsN)
let clip = clipFrom(cg, 0, 0, 0)
let r1 = rotateClip(clip, 1)
check("rotate swaps dimensions", r1.w == 2 and r1.d == 3 and r1.h == 1)
# turnXZ k=1: (x,z) -> (d-1-z, x): stone (0,0) -> (1,0); dirt (2,1) -> (0,2); stairs (1,0) -> (1,1)
check("rotate places stone", r1.cells[clipIndex(r1, 1, 0, 0)] == stone)
check("rotate places dirt", r1.cells[clipIndex(r1, 0, 0, 2)] == dirt)
check("rotate turns stairs", r1.cells[clipIndex(r1, 1, 0, 1)] == stairsE)
let r4 = rotateClip(rotateClip(rotateClip(rotateClip(clip, 1), 1), 1), 1)
check("four rotations restore", r4.w == clip.w and r4.d == clip.d and r4.cells == clip.cells and r4.ox == clip.ox and r4.oz == clip.oz)
let r2 = rotateClip(clip, 2)
check("half turn place", r2.cells[clipIndex(r2, 2, 0, 1)] == stone and r2.cells[clipIndex(r2, 0, 0, 0)] == dirt)
let f1 = flipClip(clip, 'x')
check("flip x moves stone", f1.cells[clipIndex(f1, 2, 0, 0)] == stone and f1.cells[clipIndex(f1, 0, 0, 1)] == dirt)
check("flip twice restores", flipClip(f1, 'x').cells == clip.cells)
var movedOrigin = clipFrom(cg, 2, 0, 1)
check("origin follows a flip", flipClip(movedOrigin, 'x').ox == 0 and flipClip(movedOrigin, 'z').oz == 0)
check("origin follows a rotation", rotateClip(movedOrigin, 1).ox == 0 and rotateClip(movedOrigin, 1).oz == 2)

if failures > 0:
  echo "wecoretest: ", failures, " FAILED"
  quit(1)
echo "wecoretest: all passed"
