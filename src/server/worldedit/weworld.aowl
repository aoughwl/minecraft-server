## WorldEdit-style server mod, the world half: selection sessions, the clipboard, undo / redo history and every edit, all of
## them applied through bulkedit (src/server/world/bulkedit.aowl) so lighting, heightmaps, client updates, block entities,
## the plugin veto and the block log behave as for any bulk edit.
##
## How an edit runs. `beginEdit` reads the volume the edit may touch into a snapshot and a `Grid` of block states. The edit
## changes the grid (wecore: patterns, masks, shapes). `finishEdit` writes the changed grid back into a copy of the snapshot
## and places that with `placeVolume` (one all-or-nothing call: section swaps, one light pass, one client update per section),
## then keeps the ORIGINAL snapshot as the undo entry. Undo places that snapshot back (reading the current state first for
## redo), so it restores block states and block entities exactly. Every changed cell also goes to the block log with the
## command cause and the player's name, so `/bl lookup` shows the edit and `/bl rollback` can undo it from the log too.

import std/[options, strutils, math]
import ../../util/math/position
import ../../nbt/tag as nbttag
import ../../world/blockstates
import ../serverbase
import ../blocklog/blocklogcore
import ../world/bulkedit
import ../../world/level as wlevel
import wecore

const
  MaxEditCells* = 4_000_000       ## one edit, in cells of the volume it reads
  MaxHistoryEntries* = 64         ## the default undo depth of a session (`//historysize` changes it)
  MaxHistoryLimit* = 1000
  MaxHistoryCells* = 24_000_000   ## undo + redo of one player, summed over the boxes

type
  HistEntry* = object
    label*: string
    box*: WeBox
    snap*: VolumeSnapshot   ## the cells to put back

  WeToolKind* = enum
    wtBrushSphere, wtBrushCylinder, wtBrushSmooth, wtInfo, wtReplace

  WeTool* = object
    ## A brush or tool bound to an item (`//brush`, `//tool`), used with a right click.
    item*: string           ## the held item's registry key
    kind*: WeToolKind
    pattern*: Pattern
    patternText*: string
    radius*, height*, iterations*: int
    hollow*: bool

  WeSession* = ref object
    name*: string
    dim*: string
    has1*, has2*: bool
    p1x*, p1y*, p1z*, p2x*, p2y*, p2z*: int
    hasClip*: bool
    clip*: Clip
    undo*: seq[HistEntry]
    redo*: seq[HistEntry]
    cuiDirty*: bool        ## the selection changed since the client was told
    cuiHello*: bool        ## the client said `v|<n>` on worldedit:cui
    lastSeen*: int64
    historyLimit*: int     ## undo entries kept
    tools*: seq[WeTool]
    lastToolTick*: int64   ## a right click arrives as use-on-block and use-item in one tick: the tool acts once

  OpResult* = object
    ok*: bool
    msg*: string
    changed*: int

  EditCtx = object
    box: WeBox
    snap: VolumeSnapshot
    before: Grid
    after: Grid
    bes: seq[VolumeBlockEntity]

var gSessions: seq[WeSession] = @[]

proc sessionFor*(name: string): WeSession =
  for s in gSessions:
    if s.name == name:
      return s
  let s = WeSession(name: name, dim: "", has1: false, has2: false, hasClip: false, undo: @[], redo: @[], cuiDirty: false,
    cuiHello: false, lastSeen: 0'i64,
    historyLimit: MaxHistoryEntries, tools: @[], lastToolTick: -1'i64)
  gSessions.add s
  s

proc allSessions*(): seq[WeSession] = gSessions

proc dropSession*(name: string) =
  var kept: seq[WeSession] = @[]
  for s in gSessions:
    if s.name != name:
      kept.add s
  gSessions = kept

proc resetSessions*() =
  gSessions = @[]

proc fail(msg: string): OpResult = OpResult(ok: false, msg: msg, changed: 0)
proc good(msg: string; changed: int): OpResult = OpResult(ok: true, msg: msg, changed: changed)

proc statusText(status: EditStatus): string =
  case status
  of esOk: "ok"
  of esStale: "the area changed while the edit was prepared"
  of esUnloaded: "part of the area is not loaded"
  of esOutOfRange: "the area is outside the world's build height"
  of esVetoed: "a plugin cancelled the change"
  of esBlocked: "blocked"
  of esWrongState: "bad snapshot state"

proc toVol(b: WeBox): VolumeBox =
  volumeBox(int32(b.minX), int32(b.minY), int32(b.minZ), int32(b.maxX), int32(b.maxY), int32(b.maxZ))

proc corner(b: WeBox): BlockPos =
  newBlockPos(int32(b.minX), int32(b.minY), int32(b.minZ))

# ---- selection -------------------------------------------------------------------------------------------------------

proc setPos1*(ses: WeSession; dim: string; x, y, z: int) =
  if ses.dim != dim:
    ses.has2 = false
  ses.dim = dim
  ses.p1x = x
  ses.p1y = y
  ses.p1z = z
  ses.has1 = true
  ses.cuiDirty = true

proc setPos2*(ses: WeSession; dim: string; x, y, z: int) =
  if ses.dim != dim:
    ses.has1 = false
  ses.dim = dim
  ses.p2x = x
  ses.p2y = y
  ses.p2z = z
  ses.has2 = true
  ses.cuiDirty = true

proc clearSelection*(ses: WeSession) =
  ses.has1 = false
  ses.has2 = false
  ses.cuiDirty = true

proc selectionBox*(ses: WeSession; box: var WeBox): bool =
  if not (ses.has1 and ses.has2):
    return false
  box = weBox(ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z)
  true

proc shiftSelection*(ses: WeSession; dx, dy, dz: int) =
  ses.p1x += dx
  ses.p1y += dy
  ses.p1z += dz
  ses.p2x += dx
  ses.p2y += dy
  ses.p2z += dz
  ses.cuiDirty = true

proc selectionVolume*(ses: WeSession): int =
  var b = weBox(0, 0, 0, 0, 0, 0)
  if selectionBox(ses, b): volume(b) else: 0

proc needSelection(ses: WeSession; world: World; box: var WeBox; err: var string): bool =
  if not selectionBox(ses, box):
    err = "Make a selection first (//pos1 and //pos2, or the wand)."
    return false
  if ses.dim != world.dimension.minecraftName:
    err = "Your selection is in " & ses.dim & "."
    return false
  true

# ---- snapshots and grids ---------------------------------------------------------------------------------------------

proc snapToGrid(snap: VolumeSnapshot; box: WeBox): Grid =
  result = newGrid(box)
  for sec in snap.sections:
    let cells = sec.blocks.cells()
    for y in sec.y0 .. sec.y1:
      for z in sec.z0 .. sec.z1:
        for x in sec.x0 .. sec.x1:
          let wx = int(sec.cx) * 16 + x
          let wy = int(sec.baseY) + y
          let wz = int(sec.cz) * 16 + z
          result.cells[gridIndex(result, wx, wy, wz)] = cells[y * 256 + z * 16 + x]

proc gridIntoSnap(snap: var VolumeSnapshot; g: Grid) =
  ## Writes the grid's cells into the snapshot's section palettes (copies, the world is not touched).
  for i in 0 ..< snap.sections.len:
    let cx = int(snap.sections[i].cx)
    let cz = int(snap.sections[i].cz)
    let baseY = int(snap.sections[i].baseY)
    let x0 = snap.sections[i].x0
    let x1 = snap.sections[i].x1
    let y0 = snap.sections[i].y0
    let y1 = snap.sections[i].y1
    let z0 = snap.sections[i].z0
    let z1 = snap.sections[i].z1
    for y in y0 .. y1:
      for z in z0 .. z1:
        for x in x0 .. x1:
          let want = g.cells[gridIndex(g, cx * 16 + x, baseY + y, cz * 16 + z)]
          discard snap.sections[i].blocks.set(x, y, z, want)

proc beginEdit(world: World; box: WeBox; ctx: var EditCtx; err: var string): bool =
  if volume(box) > MaxEditCells:
    err = "That region is too large (" & $volume(box) & " blocks, the limit is " & $MaxEditCells & ")."
    return false
  ctx.box = box
  ctx.snap = readVolume(world, toVol(box))
  if ctx.snap.status != esOk:
    err = "Cannot edit there: " & statusText(ctx.snap.status) & "."
    return false
  ctx.before = snapToGrid(ctx.snap, box)
  ctx.after = ctx.before
  ctx.bes = @[]
  true

proc trimHistory(ses: WeSession) =
  var cells = 0
  for e in ses.undo:
    cells += volume(e.box)
  for e in ses.redo:
    cells += volume(e.box)
  while ses.undo.len > max(ses.historyLimit, 0) or (cells > MaxHistoryCells and ses.undo.len > 1):
    cells -= volume(ses.undo[0].box)
    ses.undo.delete(0)

proc finishEdit(world: World; ses: WeSession; label: string; ctx: var EditCtx; fmt = ""): OpResult =
  ## `fmt`, when given, is the success message with `{n}` for the count (WorldEdit's own wording).
  var changed = 0
  for i in 0 ..< ctx.after.cells.len:
    if ctx.after.cells[i] != ctx.before.cells[i]:
      inc changed
  if changed == 0 and ctx.bes.len == 0:
    if fmt.len > 0:
      return good(fmt.replace("{n}", "0"), 0)
    return good("No blocks were changed.", 0)
  var after = ctx.snap
  gridIntoSnap(after, ctx.after)
  # block entities: a cell that stays the same block keeps its own; the pasted ones come from the edit
  var keep: seq[VolumeBlockEntity] = @[]
  for be in ctx.snap.blockEntities:
    let x = int(be.pos.vec.x)
    let y = int(be.pos.vec.y)
    let z = int(be.pos.vec.z)
    if ctx.box.inside(x, y, z) and blockIdOf(ctx.after.cellAt(x, y, z)) == blockIdOf(ctx.before.cellAt(x, y, z)):
      var replaced = false
      for ne in ctx.bes:
        if ne.pos == be.pos:
          replaced = true
      if not replaced:
        keep.add be
  for ne in ctx.bes:
    keep.add ne
  after.blockEntities = keep
  var opts = defaultPlaceOptions()
  opts.skipAir = false
  opts.mode = pmReplace
  let prev = blockLogPush(CauseCommand, KindPlayer, ses.name)
  let rep = placeVolume(world, after, corner(ctx.box), opts)
  blockLogPop(prev)
  if rep.status != esOk:
    return fail("The edit was refused: " & statusText(rep.status) & ".")
  ses.undo.add HistEntry(label: label, box: ctx.box, snap: ctx.snap)
  ses.redo = @[]
  trimHistory(ses)
  if fmt.len > 0:
    return good(fmt.replace("{n}", $rep.changed), rep.changed)
  good(label & ": " & $rep.changed & " block(s) changed.", rep.changed)

# ---- edits on the selection ------------------------------------------------------------------------------------------

proc weSet*(world: World; ses: WeSession; pat: Pattern): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        ctx.after.setCell(x, y, z, pick(pat, x, y, z))
  finishEdit(world, ses, "set", ctx)

proc weReplace*(world: World; ses: WeSession; mask: Mask; pat: Pattern): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        if mask.matches(ctx.before.cellAt(x, y, z)):
          ctx.after.setCell(x, y, z, pick(pat, x, y, z))
  finishEdit(world, ses, "replace", ctx)

proc weWalls*(world: World; ses: WeSession; pat: Pattern): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        if onWalls(box, x, z):
          ctx.after.setCell(x, y, z, pick(pat, x, y, z))
  finishEdit(world, ses, "walls", ctx)

proc weHollow*(world: World; ses: WeSession; pat: Pattern): OpResult =
  ## The interior of the selection becomes the pattern (air by default at the command), the one-block shell stays.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        if not onShell(box, x, y, z):
          ctx.after.setCell(x, y, z, pick(pat, x, y, z))
  finishEdit(world, ses, "hollow", ctx)

proc writeCells(world: World; ses: WeSession; label: string; cells: seq[(int, int, int)]; pat: Pattern; fmt = ""): OpResult =
  if cells.len == 0:
    return fail("Nothing to generate.")
  var box = weBox(cells[0][0], cells[0][1], cells[0][2], cells[0][0], cells[0][1], cells[0][2])
  for c in cells:
    box = unionBox(box, weBox(c[0], c[1], c[2], c[0], c[1], c[2]))
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, box, ctx, err): return fail(err)
  for c in cells:
    ctx.after.setCell(c[0], c[1], c[2], pick(pat, c[0], c[1], c[2]))
  finishEdit(world, ses, label, ctx, fmt)

proc weSphere*(world: World; ses: WeSession; cx, cy, cz: int; pat: Pattern; rx, ry, rz: int; hollow: bool): OpResult =
  if rx < 1 or ry < 1 or rz < 1:
    return fail("The radius must be at least 1.")
  if (2 * rx + 1) * (2 * ry + 1) * (2 * rz + 1) > MaxEditCells:
    return fail("That sphere is too large.")
  writeCells(world, ses, "sphere", sphereCells(cx, cy, cz, rx, ry, rz, hollow), pat)

proc weCyl*(world: World; ses: WeSession; cx, cy, cz: int; pat: Pattern; rx, rz, height: int; hollow: bool): OpResult =
  if rx < 1 or rz < 1 or height < 1:
    return fail("The radius and the height must be at least 1.")
  if (2 * rx + 1) * (2 * rz + 1) * height > MaxEditCells:
    return fail("That cylinder is too large.")
  writeCells(world, ses, "cylinder", cylCells(cx, cy, cz, rx, rz, height, hollow), pat)

proc weStack*(world: World; ses: WeSession; count, dx, dy, dz: int; skipAir: bool): OpResult =
  ## `count` further copies of the selection, each one selection-size further along the direction.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  if count < 1:
    return fail("The count must be at least 1.")
  let stepX = dx * sizeX(box)
  let stepY = dy * sizeY(box)
  let stepZ = dz * sizeZ(box)
  let last = shifted(box, stepX * count, stepY * count, stepZ * count)
  let area = unionBox(box, last)
  var ctx = EditCtx()
  if not beginEdit(world, area, ctx, err): return fail(err)
  for i in 1 .. count:
    for y in box.minY .. box.maxY:
      for z in box.minZ .. box.maxZ:
        for x in box.minX .. box.maxX:
          let v = ctx.before.cellAt(x, y, z)
          if v == 0'u32 and skipAir:
            continue
          ctx.after.setCell(x + stepX * i, y + stepY * i, z + stepZ * i, v)
  # block entities of the source go along
  for be in ctx.snap.blockEntities:
    if box.inside(int(be.pos.vec.x), int(be.pos.vec.y), int(be.pos.vec.z)):
      for i in 1 .. count:
        ctx.bes.add(VolumeBlockEntity(pos: newBlockPos(be.pos.vec.x + int32(stepX * i), be.pos.vec.y + int32(stepY * i),
          be.pos.vec.z + int32(stepZ * i)), nbt: be.nbt))
  result = finishEdit(world, ses, "stack", ctx)

proc weMove*(world: World; ses: WeSession; count, dx, dy, dz: int; leave: Pattern; shiftSel: bool): OpResult =
  ## The selection's blocks move `count` cells along the direction; the vacated cells become `leave` (air).
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  if count < 1:
    return fail("The distance must be at least 1.")
  let moved = shifted(box, dx * count, dy * count, dz * count)
  let area = unionBox(box, moved)
  var ctx = EditCtx()
  if not beginEdit(world, area, ctx, err): return fail(err)
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        ctx.after.setCell(x, y, z, pick(leave, x, y, z))
  for y in box.minY .. box.maxY:
    for z in box.minZ .. box.maxZ:
      for x in box.minX .. box.maxX:
        ctx.after.setCell(x + dx * count, y + dy * count, z + dz * count, ctx.before.cellAt(x, y, z))
  for be in ctx.snap.blockEntities:
    if box.inside(int(be.pos.vec.x), int(be.pos.vec.y), int(be.pos.vec.z)):
      ctx.bes.add(VolumeBlockEntity(pos: newBlockPos(be.pos.vec.x + int32(dx * count), be.pos.vec.y + int32(dy * count),
        be.pos.vec.z + int32(dz * count)), nbt: be.nbt))
  result = finishEdit(world, ses, "move", ctx)
  if result.ok and shiftSel:
    shiftSelection(ses, dx * count, dy * count, dz * count)

# ---- clipboard -------------------------------------------------------------------------------------------------------

proc weCopy*(world: World; ses: WeSession; px, py, pz: int): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  ses.clip = clipFrom(ctx.before, px, py, pz)
  for be in ctx.snap.blockEntities:
    ses.clip.bes.add(ClipBE(x: int(be.pos.vec.x) - box.minX, y: int(be.pos.vec.y) - box.minY, z: int(be.pos.vec.z) - box.minZ,
      nbt: be.nbt))
  ses.hasClip = true
  good("Copied " & $volume(box) & " block(s).", volume(box))

proc weCut*(world: World; ses: WeSession; px, py, pz: int; leave: Pattern): OpResult =
  let c = weCopy(world, ses, px, py, pz)
  if not c.ok:
    return c
  let r = weSet(world, ses, leave)
  if not r.ok:
    ses.hasClip = false
    return r
  good("Cut " & $volume(weBox(ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z)) & " block(s) to the clipboard.", r.changed)

proc wePaste*(world: World; ses: WeSession; px, py, pz: int; skipAir: bool; select: bool): OpResult =
  if not ses.hasClip:
    return fail("Your clipboard is empty. Use //copy first.")
  let c = ses.clip
  let minX = px - c.ox
  let minY = py - c.oy
  let minZ = pz - c.oz
  let box = weBox(minX, minY, minZ, minX + c.w - 1, minY + c.h - 1, minZ + c.d - 1)
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, box, ctx, err): return fail(err)
  for y in 0 ..< c.h:
    for z in 0 ..< c.d:
      for x in 0 ..< c.w:
        let v = c.cells[clipIndex(c, x, y, z)]
        if v == 0'u32 and skipAir:
          continue
        ctx.after.setCell(minX + x, minY + y, minZ + z, v)
  for be in c.bes:
    ctx.bes.add(VolumeBlockEntity(pos: newBlockPos(int32(minX + be.x), int32(minY + be.y), int32(minZ + be.z)), nbt: be.nbt))
  result = finishEdit(world, ses, "paste", ctx)
  if result.ok and select:
    setPos1(ses, world.dimension.minecraftName, box.minX, box.minY, box.minZ)
    setPos2(ses, world.dimension.minecraftName, box.maxX, box.maxY, box.maxZ)

proc weRotate*(ses: WeSession; degrees: int): OpResult =
  if not ses.hasClip:
    return fail("Your clipboard is empty.")
  if degrees mod 90 != 0:
    return fail("Rotations are in multiples of 90 degrees.")
  let k = ((degrees div 90) mod 4 + 4) mod 4
  ses.clip = rotateClip(ses.clip, k)
  good("The clipboard was rotated " & $degrees & " degrees.", 0)

proc weFlip*(ses: WeSession; axis: char): OpResult =
  if not ses.hasClip:
    return fail("Your clipboard is empty.")
  ses.clip = flipClip(ses.clip, axis)
  good("The clipboard was flipped.", 0)

# ---- queries ---------------------------------------------------------------------------------------------------------

proc weCount*(world: World; ses: WeSession; mask: Mask): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  let n = countMatching(ctx.before, mask)
  good("Counted " & $n & " block(s).", n)

proc weDistribution*(world: World; ses: WeSession; byState: bool; lines: var seq[string]): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  let rows = distribution(ctx.before, byState)
  lines = @[]
  let total = volume(box)
  for r in rows:
    let pct = (r[1] * 10000 div total)
    lines.add(r[0] & ": " & $r[1] & " (" & $(pct div 100) & "." & (if pct mod 100 < 10: "0" else: "") & $(pct mod 100) & "%)")
  good("Distribution of " & $total & " block(s).", total)

# ---- undo / redo -----------------------------------------------------------------------------------------------------

proc applyEntry(world: World; ses: WeSession; e: HistEntry; cur: var VolumeSnapshot): OpResult =
  ## Puts the entry's snapshot back; `cur` is what was there (the entry for the opposite stack).
  cur = readVolume(world, toVol(e.box))
  if cur.status != esOk:
    return fail("Cannot restore: " & statusText(cur.status) & ".")
  var opts = defaultPlaceOptions()
  opts.skipAir = false
  opts.mode = pmReplace
  let prev = blockLogPush(CauseCommand, KindPlayer, ses.name)
  let rep = placeVolume(world, e.snap, corner(e.box), opts)
  blockLogPop(prev)
  if rep.status != esOk:
    return fail("Cannot restore: " & statusText(rep.status) & ".")
  good(e.label & ": " & $rep.changed & " block(s) restored.", rep.changed)

proc weUndo*(world: World; ses: WeSession; times: int): OpResult =
  var total = 0
  var done = 0
  var lastMsg = ""
  for i in 0 ..< max(times, 1):
    if ses.undo.len == 0:
      break
    let e = ses.undo[ses.undo.len - 1]
    var cur = VolumeSnapshot()
    let r = applyEntry(world, ses, e, cur)
    if not r.ok:
      if done == 0:
        return r
      break
    ses.undo.setLen(ses.undo.len - 1)
    ses.redo.add HistEntry(label: e.label, box: e.box, snap: cur)
    total += r.changed
    inc done
    lastMsg = r.msg
  if done == 0:
    return fail("Nothing left to undo.")
  good("Undid " & $done & " edit(s): " & $total & " block(s) restored.", total)

proc weRedo*(world: World; ses: WeSession; times: int): OpResult =
  var total = 0
  var done = 0
  for i in 0 ..< max(times, 1):
    if ses.redo.len == 0:
      break
    let e = ses.redo[ses.redo.len - 1]
    var cur = VolumeSnapshot()
    let r = applyEntry(world, ses, e, cur)
    if not r.ok:
      if done == 0:
        return r
      break
    ses.redo.setLen(ses.redo.len - 1)
    ses.undo.add HistEntry(label: e.label, box: e.box, snap: cur)
    total += r.changed
    inc done
  if done == 0:
    return fail("Nothing left to redo.")
  good("Redid " & $done & " edit(s): " & $total & " block(s) changed.", total)

# ---- history settings ------------------------------------------------------------------------------------------------

proc weClearHistory*(ses: WeSession): OpResult =
  ses.undo = @[]
  ses.redo = @[]
  good("History cleared.", 0)

proc weSetHistoryLimit*(ses: WeSession; entries: int): OpResult =
  if entries < 0 or entries > MaxHistoryLimit:
    return fail("The history size must be between 0 and " & $MaxHistoryLimit & ".")
  ses.historyLimit = entries
  while ses.redo.len > entries:
    ses.redo.delete(0)
  trimHistory(ses)
  good("History size set to " & $entries & " edit(s).", entries)

# ---- selection changes (WorldEdit's CuboidRegion.expand / contract / shift) ------------------------------------------

proc expandAxis(a1, a2: var int; change: int) =
  if change > 0:
    if max(a1, a2) == a1: a1 += change else: a2 += change
  elif change < 0:
    if min(a1, a2) == a1: a1 += change else: a2 += change

proc contractAxis(a1, a2: var int; change: int) =
  if change < 0:
    if max(a1, a2) == a1: a1 += change else: a2 += change
  elif change > 0:
    if min(a1, a2) == a1: a1 += change else: a2 += change

proc saveSel(ses: WeSession): array[6, int] =
  [ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z]

proc restoreSel(ses: WeSession; a: array[6, int]) =
  ses.p1x = a[0]
  ses.p1y = a[1]
  ses.p1z = a[2]
  ses.p2x = a[3]
  ses.p2y = a[4]
  ses.p2z = a[5]
  ses.cuiDirty = true

proc expandSel(ses: WeSession; cx, cy, cz: int) =
  expandAxis(ses.p1x, ses.p2x, cx)
  expandAxis(ses.p1y, ses.p2y, cy)
  expandAxis(ses.p1z, ses.p2z, cz)
  ses.cuiDirty = true

proc contractSel(ses: WeSession; cx, cy, cz: int) =
  contractAxis(ses.p1x, ses.p2x, cx)
  contractAxis(ses.p1y, ses.p2y, cy)
  contractAxis(ses.p1z, ses.p2z, cz)
  ses.cuiDirty = true

proc clampSelY(ses: WeSession; world: World) =
  let lo = int(world.dimension.minY)
  let hi = int(world.dimension.minY + world.dimension.height - 1'i32)
  ses.p1y = min(max(ses.p1y, lo), hi)
  ses.p2y = min(max(ses.p2y, lo), hi)

proc weExpand*(world: World; ses: WeSession; amount, reverse, dx, dy, dz: int): OpResult =
  ## `//expand <amount> [reverse] [direction]`.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  let before = volume(box)
  expandSel(ses, dx * amount, dy * amount, dz * amount)
  if reverse != 0:
    expandSel(ses, -dx * reverse, -dy * reverse, -dz * reverse)
  clampSelY(ses, world)
  let after = selectionVolume(ses)
  good("Region expanded " & $(after - before) & " blocks.", after - before)

proc weExpandVert*(world: World; ses: WeSession): OpResult =
  ## `//expand vert`: the selection reaches from the bottom of the world to its top.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  let before = volume(box)
  let lo = int(world.dimension.minY)
  let hi = int(world.dimension.minY + world.dimension.height - 1'i32)
  if ses.p1y <= ses.p2y:
    ses.p1y = lo
    ses.p2y = hi
  else:
    ses.p1y = hi
    ses.p2y = lo
  ses.cuiDirty = true
  let after = selectionVolume(ses)
  good("Region expanded " & $(after - before) & " blocks (top-to-bottom).", after - before)

proc weContract*(world: World; ses: WeSession; amount, reverse, dx, dy, dz: int): OpResult =
  ## `//contract <amount> [reverse] [direction]`.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  let before = volume(box)
  let s1 = saveSel(ses)
  contractSel(ses, dx * amount, dy * amount, dz * amount)
  if reverse != 0:
    contractSel(ses, -dx * reverse, -dy * reverse, -dz * reverse)
  # a contraction past the opposite face is refused, as WorldEdit refuses a region of negative size
  let nb = weBox(ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z)
  if (dx != 0 and sizeX(nb) > sizeX(box)) or (dy != 0 and sizeY(nb) > sizeY(box)) or (dz != 0 and sizeZ(nb) > sizeZ(box)):
    restoreSel(ses, s1)
    return fail("The region cannot be contracted that far.")
  let after = selectionVolume(ses)
  good("Region contracted " & $(before - after) & " blocks.", before - after)

proc weShift*(world: World; ses: WeSession; amount, dx, dy, dz: int): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  shiftSelection(ses, dx * amount, dy * amount, dz * amount)
  good("Region shifted.", 0)

proc weOutset*(world: World; ses: WeSession; amount: int; onlyH, onlyV, inward: bool): OpResult =
  ## `//outset` and `//inset [-h|-v] <amount>`: every face moves out (in) by `amount`.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var changes: seq[(int, int, int)] = @[]
  if not onlyV:
    changes.add((amount, 0, 0))
    changes.add((-amount, 0, 0))
    changes.add((0, 0, amount))
    changes.add((0, 0, -amount))
  if not onlyH:
    changes.add((0, amount, 0))
    changes.add((0, -amount, 0))
  let s1 = saveSel(ses)
  for c in changes:
    if inward:
      contractSel(ses, c[0], c[1], c[2])
    else:
      expandSel(ses, c[0], c[1], c[2])
  if inward:
    let nb = weBox(ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z)
    if (not onlyV and (sizeX(nb) > sizeX(box) or sizeZ(nb) > sizeZ(box))) or (not onlyH and sizeY(nb) > sizeY(box)):
      restoreSel(ses, s1)
      return fail("The region cannot be inset that far.")
    return good("Region inset.", 0)
  clampSelY(ses, world)
  good("Region outset.", 0)

proc weChunk*(world: World; ses: WeSession; px, pz: int): OpResult =
  ## `//chunk`: the chunk you stand in, the whole height of the world.
  let cx = floorDiv(px, 16)
  let cz = floorDiv(pz, 16)
  let dim = world.dimension.minecraftName
  let lo = int(world.dimension.minY)
  let hi = int(world.dimension.minY + world.dimension.height - 1'i32)
  setPos1(ses, dim, cx * 16, lo, cz * 16)
  setPos2(ses, dim, cx * 16 + 15, hi, cz * 16 + 15)
  good("Chunk selected: " & $cx & ", " & $cz, 0)

# ---- region edits ----------------------------------------------------------------------------------------------------

proc weCenter*(world: World; ses: WeSession; pat: Pattern): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  writeCells(world, ses, "center", centerCells(box), pat, "Center set. ({n} blocks changed)")

proc smoothBox(world: World; ses: WeSession; box: WeBox; iterations: int; label, fmt: string): OpResult =
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, box, ctx, err): return fail(err)
  ctx.after = smoothGrid(ctx.before, iterations)
  finishEdit(world, ses, label, ctx, fmt)

proc weSmooth*(world: World; ses: WeSession; iterations: int): OpResult =
  ## `//smooth [iterations]`.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  if iterations < 1:
    return fail("The number of iterations must be at least 1.")
  smoothBox(world, ses, box, iterations, "smooth", "Terrain's height map smoothed. {n} blocks changed.")

proc weNaturalize*(world: World; ses: WeSession): OpResult =
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  var ctx = EditCtx()
  if not beginEdit(world, box, ctx, err): return fail(err)
  let (okG, grass) = defaultStateByName("grass_block")
  let (okD, dirt) = defaultStateByName("dirt")
  let (okS, stone) = defaultStateByName("stone")
  if not (okG and okD and okS):
    return fail("The block registry lacks grass, dirt or stone.")
  ctx.after = naturalizeGrid(ctx.before, grass, dirt, stone)
  finishEdit(world, ses, "naturalize", ctx, "{n} block(s) have been made to look more natural.")

proc weOverlay*(world: World; ses: WeSession; pat: Pattern): OpResult =
  ## `//overlay <pattern>`: on the highest non-air block of each column of the selection, one block of the pattern.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  let top = int(world.dimension.minY + world.dimension.height - 1'i32)
  var area = box
  if area.maxY < top:
    area.maxY += 1
  var ctx = EditCtx()
  if not beginEdit(world, area, ctx, err): return fail(err)
  for z in box.minZ .. box.maxZ:
    for x in box.minX .. box.maxX:
      var y = box.maxY
      while y >= box.minY:
        if not isAir(ctx.before.cellAt(x, y, z)):
          break
        dec y
      if y >= box.minY and y + 1 <= area.maxY:
        ctx.after.setCell(x, y + 1, z, pick(pat, x, y + 1, z))
  finishEdit(world, ses, "overlay", ctx, "{n} blocks have been overlaid.")

proc weLine*(world: World; ses: WeSession; pat: Pattern; thickness: int; hollow: bool): OpResult =
  ## `//line [-h] <pattern> [thickness]`: from position 1 to position 2.
  var box = weBox(0, 0, 0, 0, 0, 0)
  var err = ""
  if not needSelection(ses, world, box, err): return fail(err)
  if thickness < 0:
    return fail("The thickness cannot be negative.")
  writeCells(world, ses, "line", lineCells(ses.p1x, ses.p1y, ses.p1z, ses.p2x, ses.p2y, ses.p2z, thickness, not hollow), pat,
    "{n} blocks have been changed.")

proc wePyramid*(world: World; ses: WeSession; cx, cy, cz: int; pat: Pattern; size: int; hollow: bool): OpResult =
  if size < 1:
    return fail("The size must be at least 1.")
  if (2 * size + 1) * (2 * size + 1) * (size + 1) > MaxEditCells:
    return fail("That pyramid is too large.")
  writeCells(world, ses, "pyramid", pyramidCells(cx, cy, cz, size, not hollow), pat, "{n} blocks have been created.")

proc weShapeMsg*(world: World; ses: WeSession; cells: seq[(int, int, int)]; pat: Pattern; label: string): OpResult =
  ## A sphere or cylinder with WorldEdit's "created" wording (`//hsphere`, `//hcyl`, the brushes).
  writeCells(world, ses, label, cells, pat, "{n} blocks have been created.")

# ---- flood fills from where the player stands ------------------------------------------------------------------------

proc areaAround(world: World; cx, cy, cz, r, yLo, yHi: int): WeBox =
  let lo = int(world.dimension.minY)
  let hi = int(world.dimension.minY + world.dimension.height - 1'i32)
  weBox(cx - r, max(yLo, lo), cz - r, cx + r, min(yHi, hi), cz + r)

proc inBall(x, y, z, cx, cy, cz, r: int): bool =
  let dx = x - cx
  let dy = y - cy
  let dz = z - cz
  dx * dx + dy * dy + dz * dz <= r * r

proc isFluidNamed(state: uint32; name: string): bool =
  blockNameOfState(state) == name

proc waterlogged(state: uint32): bool =
  for p in stateProperties(state):
    if p.name == "waterlogged" and p.value == "true":
      return true
  false

proc unWaterlogged(state: uint32): uint32 =
  var props = stateProperties(state)
  for i in 0 ..< props.len:
    if props[i].name == "waterlogged":
      props[i].value = "false"
  stateIdFromProps(blockIdOf(state), props)

proc weDrain*(world: World; ses: WeSession; cx, cy, cz, radius: int; alsoWaterlogged: bool): OpResult =
  ## `//drain [-w] <radius>`: the water and lava connected to the 3x3x3 cells around you, within the radius, become air
  ## (-w: waterlogged blocks are dried too).
  if radius < 1:
    return fail("The radius must be at least 1.")
  let area = areaAround(world, cx, cy, cz, radius, cy - radius, cy + radius)
  if area.minY > area.maxY:
    return fail("That is outside the world.")
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, area, ctx, err): return fail(err)
  var allowed = newSeq[bool](ctx.before.cells.len)
  for y in area.minY .. area.maxY:
    for z in area.minZ .. area.maxZ:
      for x in area.minX .. area.maxX:
        let st = ctx.before.cellAt(x, y, z)
        let liquid = isFluidNamed(st, "water") or isFluidNamed(st, "lava") or (alsoWaterlogged and waterlogged(st))
        allowed[gridIndex(ctx.before, x, y, z)] = liquid and inBall(x, y, z, cx, cy, cz, radius)
  var seeds: seq[(int, int, int)] = @[]
  for oy in -1 .. 1:
    for oz in -1 .. 1:
      for ox in -1 .. 1:
        seeds.add((cx + ox, cy + oy, cz + oz))
  for c in floodCells(ctx.before, allowed, seeds, true):
    let st = ctx.before.cellAt(c[0], c[1], c[2])
    if isFluidNamed(st, "water") or isFluidNamed(st, "lava"):
      ctx.after.setCell(c[0], c[1], c[2], 0'u32)
    else:
      ctx.after.setCell(c[0], c[1], c[2], unWaterlogged(st))
  finishEdit(world, ses, "drain", ctx, "{n} blocks have been drained.")

proc weFill*(world: World; ses: WeSession; cx, cy, cz: int; pat: Pattern; radius, depth: int): OpResult =
  ## `//fill <pattern> <radius> [depth]`: the air connected to your cell going sideways and down (never up), within the
  ## radius and `depth` layers from your feet down.
  if radius < 1:
    return fail("The radius must be at least 1.")
  if depth < 1:
    return fail("The depth must be at least 1.")
  let area = areaAround(world, cx, cy, cz, radius, cy - depth + 1, cy)
  if area.minY > area.maxY:
    return fail("That is outside the world.")
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, area, ctx, err): return fail(err)
  var allowed = newSeq[bool](ctx.before.cells.len)
  for y in area.minY .. area.maxY:
    for z in area.minZ .. area.maxZ:
      for x in area.minX .. area.maxX:
        allowed[gridIndex(ctx.before, x, y, z)] = isAir(ctx.before.cellAt(x, y, z)) and inBall(x, y, z, cx, cy, cz, radius)
  for c in floodCells(ctx.before, allowed, @[(cx, cy, cz)], false):
    ctx.after.setCell(c[0], c[1], c[2], pick(pat, c[0], c[1], c[2]))
  finishEdit(world, ses, "fill", ctx, "{n} blocks have been filled.")

proc weFixWater*(world: World; ses: WeSession; cx, cy, cz, radius: int): OpResult =
  ## `//fixwater <radius>`: from the water around you, water and air at or below your feet (never up) within the radius
  ## becomes still water source blocks.
  if radius < 1:
    return fail("The radius must be at least 1.")
  let area = areaAround(world, cx, cy, cz, radius, cy - radius, cy)
  if area.minY > area.maxY:
    return fail("That is outside the world.")
  let (okW, water) = defaultStateByName("water")
  if not okW:
    return fail("No water in the block registry.")
  var ctx = EditCtx()
  var err = ""
  if not beginEdit(world, area, ctx, err): return fail(err)
  var allowed = newSeq[bool](ctx.before.cells.len)
  for y in area.minY .. area.maxY:
    for z in area.minZ .. area.maxZ:
      for x in area.minX .. area.maxX:
        let st = ctx.before.cellAt(x, y, z)
        allowed[gridIndex(ctx.before, x, y, z)] = (isAir(st) or isFluidNamed(st, "water")) and inBall(x, y, z, cx, cy, cz, radius)
  var seeds: seq[(int, int, int)] = @[]
  for oy in -1 .. 1:
    for oz in -1 .. 1:
      for ox in -1 .. 1:
        let x = cx + ox
        let y = cy + oy
        let z = cz + oz
        if area.inside(x, y, z) and isFluidNamed(ctx.before.cellAt(x, y, z), "water"):
          seeds.add((x, y, z))
  for c in floodCells(ctx.before, allowed, seeds, false):
    ctx.after.setCell(c[0], c[1], c[2], water)
  finishEdit(world, ses, "fixwater", ctx, "{n} blocks have been fixed.")

# ---- tools and brushes -----------------------------------------------------------------------------------------------

proc bindTool*(ses: WeSession; tool: WeTool) =
  for i in 0 ..< ses.tools.len:
    if ses.tools[i].item == tool.item:
      ses.tools[i] = tool
      return
  ses.tools.add tool

proc unbindTool*(ses: WeSession; item: string): bool =
  var kept: seq[WeTool] = @[]
  for t in ses.tools:
    if t.item == item:
      result = true
    else:
      kept.add t
  ses.tools = kept

proc toolFor*(ses: WeSession; item: string; tool: var WeTool): bool =
  for t in ses.tools:
    if t.item == item:
      tool = t
      return true
  false

proc weRaycast*(world: World; ex, ey, ez, yaw, pitch, maxDist: float; hx, hy, hz: var int): bool =
  ## The first non-air block along the look direction from the eye, up to `maxDist` blocks (WorldEdit's block trace).
  let yr = degToRad(yaw)
  let pr = degToRad(pitch)
  let dx = -sin(yr) * cos(pr)
  let dy = -sin(pr)
  let dz = cos(yr) * cos(pr)
  var t = 0.0
  var lastX = high(int)
  var lastY = high(int)
  var lastZ = high(int)
  while t <= maxDist:
    let x = int(floor(ex + dx * t))
    let y = int(floor(ey + dy * t))
    let z = int(floor(ez + dz * t))
    if x != lastX or y != lastY or z != lastZ:
      lastX = x
      lastY = y
      lastZ = z
      let st = wlevel.getBlockState(world.level, newBlockPos(int32(x), int32(y), int32(z)))
      if not isAir(st):
        hx = x
        hy = y
        hz = z
        return true
    t += 0.05
  false

proc weUseTool*(world: World; ses: WeSession; tool: WeTool; x, y, z: int): OpResult =
  ## A brush or the replacer acting on the block at (x, y, z).
  let lo = int(world.dimension.minY)
  let hi = int(world.dimension.minY + world.dimension.height - 1'i32)
  case tool.kind
  of wtBrushSphere:
    var cells: seq[(int, int, int)] = @[]
    for c in sphereCells(x, y, z, tool.radius, tool.radius, tool.radius, tool.hollow):
      if c[1] >= lo and c[1] <= hi:
        cells.add c
    writeCells(world, ses, "brush", cells, tool.pattern, "{n} blocks have been created.")
  of wtBrushCylinder:
    var cells: seq[(int, int, int)] = @[]
    for c in cylCells(x, y, z, tool.radius, tool.radius, tool.height, tool.hollow):
      if c[1] >= lo and c[1] <= hi:
        cells.add c
    writeCells(world, ses, "brush", cells, tool.pattern, "{n} blocks have been created.")
  of wtBrushSmooth:
    let box = weBox(x - tool.radius, max(y - tool.radius, lo), z - tool.radius, x + tool.radius, min(y + tool.radius, hi),
      z + tool.radius)
    smoothBox(world, ses, box, tool.iterations, "brush", "Terrain's height map smoothed. {n} blocks changed.")
  of wtReplace:
    writeCells(world, ses, "replace tool", @[(x, y, z)], tool.pattern, "{n} blocks have been changed.")
  of wtInfo:
    let st = wlevel.getBlockState(world.level, newBlockPos(int32(x), int32(y), int32(z)))
    var label = "minecraft:" & blockNameOfState(st)
    let props = stateProperties(st)
    if props.len > 0:
      label.add "["
      for i in 0 ..< props.len:
        if i > 0:
          label.add ","
        label.add props[i].name & "=" & props[i].value
      label.add "]"
    good("@(" & $x & ", " & $y & ", " & $z & "): " & label & " (#" & $st & ")", 0)
