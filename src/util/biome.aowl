## Port of pumpkin-util/src/biome.rs
##
## The three `LazyLock` samplers are module `let`s, built at start-up rather than first use.

import ../codecs/json_value
import ../codecs/data_result
import serde_forms
import legacy_rand
import noise/simplex

proc buildNoise(seed: uint64, octaves: openArray[int32]): OctaveSimplexNoiseSampler =
  var rand = legacy_rand.fromSeed(seed)
  newOctaveSimplexNoiseSampler(rand, octaves)

let
  TemperatureNoise* = buildNoise(1234'u64, [0'i32])
  FrozenOceanNoise* = buildNoise(3456'u64, [-2'i32, -1'i32, 0'i32])
  FoliageNoise* = buildNoise(2345'u64, [0'i32])

type
  TemperatureModifier* = enum
    tmNone
    tmFrozen

  Weather* = object
    hasPrecipitation: bool
    temperature: float32
    temperatureModifier: TemperatureModifier
    downfall: float32

proc fromJson*(t: typedesc[TemperatureModifier], v: JsonValue): DataResult[TemperatureModifier] =
  let r = readUnitVariant(v, ["NONE", "FROZEN"])
  if not r.isSuccess:
    return newError[TemperatureModifier](r.message)
  if r.successResult == 0: newSuccess(tmNone)
  else: newSuccess(tmFrozen)

proc convertTemperature*(m: TemperatureModifier, x, z: float64, temperature: float32): float32 =
  case m
  of tmNone:
    temperature
  of tmFrozen:
    let frozenOceanSample = FrozenOceanNoise.sample(x * 0.05, z * 0.05, false) * 7.0
    let foliageSample = FoliageNoise.sample(x * 0.2, z * 0.2, false)

    let threshold = frozenOceanSample + foliageSample
    if threshold < 0.3:
      let foliageSample2 = FoliageNoise.sample(x * 0.09, z * 0.09, false)
      if foliageSample2 < 0.8:
        return 0.2'f32

    temperature

proc newWeather*(hasPrecipitation: bool, temperature: float32, temperatureModifier: TemperatureModifier,
                 downfall: float32): Weather =
  Weather(hasPrecipitation: hasPrecipitation, temperature: temperature,
    temperatureModifier: temperatureModifier, downfall: downfall)

proc baseTemperature*(w: Weather): float32 =
  w.temperature

proc computeTemperature*(w: Weather, x: float64, y: int32, z: float64, seaLevel: int32): float32 =
  ## Expensive, so a caller should cache it.
  let modifiedTemperature = w.temperatureModifier.convertTemperature(x, z, w.temperature)
  let offsetSeaLevel = seaLevel + 17'i32

  if y > offsetSeaLevel:
    let temperatureNoise = float32(TemperatureNoise.sample(x / 8.0, z / 8.0, false) * 8.0)

    modifiedTemperature -
      (temperatureNoise + float32(y) - float32(offsetSeaLevel)) * 0.05'f32 / 40.0'f32
  else:
    modifiedTemperature
