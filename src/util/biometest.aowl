## Known answers for biome.aowl. Upstream has no #[test] for this file. The numbers came from a separate Python
## model of LegacyRand, OctaveSimplexNoiseSampler and biome.rs, not from this code.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import noise/simplex
import biome

proc near(a, b: float64): bool =
  abs(a - b) < 1e-13

proc same32(a: float32, b: float64): bool =
  a == float32(b)

# the three samplers, at their pinned seeds and octaves
assert near(TemperatureNoise.sample(1.5, -2.5, false), 0.0)
assert near(FrozenOceanNoise.sample(1.5, -2.5, false), -0.2836858064264063)
assert near(FoliageNoise.sample(1.5, -2.5, false), 0.6143130272544324)
assert near(TemperatureNoise.sample(100.0, 200.0, false), 0.0005885906806906013)
assert near(FrozenOceanNoise.sample(100.0, 200.0, false), -0.4079126013156842)
assert near(FoliageNoise.sample(100.0, 200.0, false), -0.3962961450136523)
assert near(TemperatureNoise.sample(-1234.5, 987.25, false), -0.6061688955493746)
assert near(FrozenOceanNoise.sample(-1234.5, 987.25, false), -0.2793682394973772)
assert near(FoliageNoise.sample(-1234.5, 987.25, false), -0.4425285738759859)

# TemperatureModifier
assert convertTemperature(tmNone, 0.0, 0.0, 0.5'f32) == 0.5'f32
assert convertTemperature(tmFrozen, -40.0, -7.0, 0.5'f32) == 0.2'f32
assert convertTemperature(tmFrozen, -40.0, -40.0, 0.5'f32) == 0.5'f32

assert fromJson(TemperatureModifier, jsonString("NONE")).successResult == tmNone
assert fromJson(TemperatureModifier, jsonString("FROZEN")).successResult == tmFrozen
assert fromJson(TemperatureModifier, jsonString("frozen")).message ==
  "unknown variant `frozen`, expected `NONE` or `FROZEN`"

# Weather::compute_temperature
let plain = newWeather(true, 0.8'f32, tmNone, 0.4'f32)
assert baseTemperature(plain) == 0.8'f32
# at or below sea level + 17 the height changes nothing
assert computeTemperature(plain, 10.0, 63'i32, 20.0, 63'i32) == 0.8'f32
assert computeTemperature(plain, 10.0, 80'i32, 20.0, 63'i32) == 0.8'f32
assert same32(computeTemperature(plain, 10.0, 81'i32, 20.0, 63'i32), 0.7923632264137268)
assert same32(computeTemperature(plain, -300.5, 200'i32, 700.25, 63'i32), 0.653008222579956)
let cold = newWeather(true, -0.5'f32, tmNone, 0.4'f32)
assert same32(computeTemperature(cold, 5.0, 120'i32, 5.0, 63'i32), -0.5520099997520447)

let frozen = newWeather(true, 0.5'f32, tmFrozen, 0.5'f32)
assert computeTemperature(frozen, -40.0, 63'i32, -7.0, 63'i32) == 0.2'f32
assert computeTemperature(frozen, -40.0, 63'i32, -40.0, 63'i32) == 0.5'f32
assert same32(computeTemperature(frozen, -40.0, 150'i32, -7.0, 63'i32), 0.11696043610572815)
assert same32(computeTemperature(frozen, -40.0, 150'i32, -40.0, 63'i32), 0.4130128026008606)

echo "biome checks passed"
