## Port of pumpkin-util/src/chest_loot_table.rs

type
  ChestLootEntry* = object
    item*: string
    weight*: int32
    minCount*: int32
    maxCount*: int32

  ChestLootPool* = object
    entries*: seq[ChestLootEntry]
    minRolls*: int32
    maxRolls*: int32
    emptyWeight*: int32

  ChestLootTable* = object
    pools*: seq[ChestLootPool]
