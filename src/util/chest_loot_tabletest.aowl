## Plain data types upstream with no logic; checks only that the shape holds together.

import std/assertions
import std/syncio
import chest_loot_table

let t = ChestLootTable(pools: @[ChestLootPool(
  entries: @[ChestLootEntry(item: "minecraft:diamond", weight: 3, minCount: 1, maxCount: 2)],
  minRolls: 1, maxRolls: 4, emptyWeight: 5)])

assert t.pools.len == 1
assert t.pools[0].entries[0].item == "minecraft:diamond"
assert t.pools[0].entries[0].maxCount == 2
assert t.pools[0].emptyWeight == 5

echo "chest_loot_table checks passed"
