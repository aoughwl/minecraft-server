## Known answers for difficulty.aowl. Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import difficulty

assert name(Peaceful) == "peaceful"
assert name(Hard) == "hard"
assert translationKey(Peaceful) == "options.difficulty.peaceful"
assert translationKey(Normal) == "options.difficulty.normal"

assert parseDifficulty("easy") == (true, Easy)
assert parseDifficulty("hard") == (true, Hard)
assert parseDifficulty("Hard")[0] == false
assert parseDifficulty("")[0] == false

assert ord(Peaceful) == 0 and ord(Hard) == 3
assert difficultyFromI8(2) == (true, Normal)
assert difficultyFromI8(4)[0] == false
assert difficultyFromI8(-1)[0] == false
assert toI8(Hard) == 3'i8

assert toJsonString(toJson(Normal)) == "\"Normal\""
assert fromJson(Difficulty, jsonString("Hard")).successResult == Hard
let bad = fromJson(Difficulty, jsonString("hard"))
assert not bad.isSuccess
assert bad.message == "unknown variant `hard`, expected one of `Peaceful`, `Easy`, `Normal`, `Hard`"
let badType = fromJson(Difficulty, jsonInt(1))
assert badType.message == "invalid type: integer `1`, expected string or map"

echo "difficulty checks passed"
