## Known answers for gamemode.aowl. Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import gamemode

assert Values.len == 4 and Values[0] == Survival and Values[3] == Spectator
assert toStr(Adventure) == "Adventure"
assert name(Adventure) == "adventure"

assert gameModeFromI8(0) == (true, Survival)
assert gameModeFromI8(3) == (true, Spectator)
assert gameModeFromI8(4)[0] == false
assert gameModeFromI8(-1)[0] == false
assert gameModeFromU8(1) == (true, Creative)
assert gameModeFromI32(2) == (true, Adventure)

assert parseGameMode("spectator") == (true, Spectator)
assert parseGameMode("Survival")[0] == false

assert toJsonString(toJson(Creative)) == "\"Creative\""
assert fromJson(GameMode, jsonString("Spectator")).successResult == Spectator
let bad = fromJson(GameMode, jsonString("nope"))
assert bad.message == "unknown variant `nope`, expected one of `Survival`, `Creative`, `Adventure`, `Spectator`"

echo "gamemode checks passed"
