## Port of pumpkin-util/src/identifier.rs
##
## `Cow<'static, str>` is a plain `string`, so `from_static`/`parse_static` differ from the runtime
## constructors only by panicking on bad input. `serverNs`/`isServerNs`/`ServerNamespace` are older
## names kept for existing callers; upstream's is the `pumpkin` namespace below.

{.feature: "untyped".}

import std/hashes
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import ../codecs/codec_core
import serde_forms

const
  VanillaNamespace* = "minecraft"
  PumpkinNamespace* = "pumpkin"
  ServerNamespace* = "server"

type
  Identifier* = object
    namespace: string
    path: string

  IdentifierErrorKind* = enum
    iekInvalidNamespace
    iekInvalidPath

  IdentifierError* = object
    kind*: IdentifierErrorKind
    identifier*: Identifier

  IdentifierResult* = object
    case isOk*: bool
    of true:
      value*: Identifier
    of false:
      error*: IdentifierError

proc isValidNamespace*(namespace: string): bool =
  for ch in namespace:
    let ok = (ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'z') or
             ch == '-' or ch == '_' or ch == '.'
    if not ok:
      return false
  true

proc isValidPath*(path: string): bool =
  for ch in path:
    let ok = (ch >= '0' and ch <= '9') or (ch >= 'a' and ch <= 'z') or
             ch == '-' or ch == '_' or ch == '.' or ch == '/'
    if not ok:
      return false
  true

proc isValidChar*(c: char): bool =
  (c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or
    c == '-' or c == '_' or c == '.' or c == '/' or c == ':'

proc validateIdentifier(identifier: sink Identifier): IdentifierResult =
  if not isValidNamespace(identifier.namespace):
    return IdentifierResult(isOk: false,
      error: IdentifierError(kind: iekInvalidNamespace, identifier: identifier))
  if not isValidPath(identifier.path):
    return IdentifierResult(isOk: false,
      error: IdentifierError(kind: iekInvalidPath, identifier: identifier))
  IdentifierResult(isOk: true, value: identifier)

proc validateIdentifierPath(identifier: sink Identifier): IdentifierResult =
  if not isValidPath(identifier.path):
    return IdentifierResult(isOk: false,
      error: IdentifierError(kind: iekInvalidPath, identifier: identifier))
  IdentifierResult(isOk: true, value: identifier)

proc newIdentifier*(namespace, path: string): IdentifierResult =
  validateIdentifier(Identifier(namespace: namespace, path: path))

proc fromStatic*(namespace, path: string): Identifier =
  ## Panics on an invalid part.
  if not isValidNamespace(namespace):
    quit("Invalid namespace provided")
  if not isValidPath(path):
    quit("Invalid path provided")
  Identifier(namespace: namespace, path: path)

proc vanilla*(path: string): IdentifierResult =
  newIdentifier(VanillaNamespace, path)

proc vanillaStatic*(path: string): Identifier =
  fromStatic(VanillaNamespace, path)

proc pumpkin*(path: string): IdentifierResult =
  newIdentifier(PumpkinNamespace, path)

proc pumpkinStatic*(path: string): Identifier =
  fromStatic(PumpkinNamespace, path)

proc serverNs*(path: string): IdentifierResult =
  newIdentifier(ServerNamespace, path)

proc parse*(identifier: string): IdentifierResult =
  ## Splits on the first `:`. No colon, or one at position 0, implies the vanilla namespace.
  var colonIdx = -1
  for i, ch in identifier:
    if ch == ':':
      colonIdx = i
      break
  if colonIdx < 0:
    newIdentifier(VanillaNamespace, identifier)
  elif colonIdx == 0:
    newIdentifier(VanillaNamespace, identifier[1 .. ^1])
  else:
    newIdentifier(identifier[0 ..< colonIdx], identifier[colonIdx+1 .. ^1])

proc parseStatic*(identifier: string): Identifier =
  ## Panics on invalid input.
  var colonIdx = -1
  for i, ch in identifier:
    if ch == ':':
      colonIdx = i
      break
  if colonIdx < 0:
    fromStatic(VanillaNamespace, identifier)
  elif colonIdx == 0:
    fromStatic(VanillaNamespace, identifier[1 .. ^1])
  else:
    fromStatic(identifier[0 ..< colonIdx], identifier[colonIdx+1 .. ^1])

proc tryFrom*(t: typedesc[Identifier], value: string): IdentifierResult =
  parse(value)

proc withPath*(id: sink Identifier, path: string): IdentifierResult =
  validateIdentifierPath(Identifier(namespace: id.namespace, path: path))

proc prefixPath*(id: sink Identifier, prefix: string): IdentifierResult =
  validateIdentifierPath(Identifier(namespace: id.namespace, path: prefix & id.path))

proc suffixPath*(id: sink Identifier, suffix: string): IdentifierResult =
  validateIdentifierPath(Identifier(namespace: id.namespace, path: id.path & suffix))

proc mapPath*(id: sink Identifier, f: proc (path: string): string): IdentifierResult =
  validateIdentifierPath(Identifier(namespace: id.namespace, path: f(id.path)))

proc namespace*(id: Identifier): string {.inline.} = id.namespace
proc path*(id: Identifier): string {.inline.} = id.path

proc view*(id: Identifier): (string, string) {.inline.} =
  (id.namespace, id.path)

proc isVanilla*(id: Identifier): bool {.inline.} =
  id.namespace == VanillaNamespace

proc isPumpkin*(id: Identifier): bool {.inline.} =
  id.namespace == PumpkinNamespace

proc isServerNs*(id: Identifier): bool {.inline.} =
  id.namespace == ServerNamespace

proc isVanillaThen*(id: Identifier): (bool, string) =
  ## `Option<&str>`: the path when this is a `minecraft:` identifier.
  if isVanilla(id): (true, id.path) else: (false, "")

proc isPumpkinThen*(id: Identifier): (bool, string) =
  ## `Option<&str>`: the path when this is a `pumpkin:` identifier.
  if isPumpkin(id): (true, id.path) else: (false, "")

proc `$`*(id: Identifier): string =
  id.namespace & ":" & id.path

func `==`*(a, b: Identifier): bool {.inline.} =
  a.namespace == b.namespace and a.path == b.path

func `<`*(a, b: Identifier): bool =
  ## Derived `Ord`: namespace, then path.
  if a.namespace != b.namespace: a.namespace < b.namespace
  else: a.path < b.path

func `<=`*(a, b: Identifier): bool =
  a == b or a < b

func hash*(id: Identifier): Hash =
  hash(id.namespace & ":" & id.path)

proc `$`*(e: IdentifierError): string =
  ## thiserror's `Display`.
  case e.kind
  of iekInvalidNamespace: "Invalid character in namespace of identifier: " & $e.identifier
  of iekInvalidPath: "Invalid character in path of identifier: " & $e.identifier

proc toJson*(id: Identifier): JsonValue =
  jsonString($id)

proc fromJson*(t: typedesc[Identifier], v: JsonValue): DataResult[Identifier] =
  let s = readString(v)
  if not s.isSuccess:
    return newError[Identifier](s.message)
  let parsed = parse(s.successResult)
  if parsed.isOk:
    newSuccess(parsed.value)
  else:
    newError[Identifier]($parsed.error)

proc flatTryFrom*(value: string): DataResult[Identifier] =
  ## `impl FlatTryFrom<String> for Identifier`.
  let parsed = parse(value)
  if parsed.isOk:
    newSuccess(parsed.value)
  else:
    newError[Identifier]("Not a valid resource location: " & value)

proc identifierToString(id: Identifier): string = $id

comapFlatMapCodecImpl(string, Identifier, flatTryFrom, identifierToString)
