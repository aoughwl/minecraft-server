## Port of the #[test]s in pumpkin-util/src/identifier.rs, plus the serde and error text forms.

{.feature: "untyped".}

import std/assertions
import std/syncio
import std/tables
import ../codecs/json_value
import ../codecs/data_result
import ../codecs/codec_core
import ../codecs/json_ops
import identifier

proc str(r: IdentifierResult): string =
  assert r.isOk
  $r.value

# new
assert str(newIdentifier("abc", "def")) == "abc:def"
assert $fromStatic("abc", "def") == "abc:def"

# parse
assert str(parse("abc")) == "minecraft:abc"
assert str(parse("abc:def")) == "abc:def"
assert str(parse("abc:")) == "abc:"
assert str(parse(":def")) == "minecraft:def"
assert str(parse(":")) == "minecraft:"
assert $parseStatic("abc") == "minecraft:abc"
assert $parseStatic("abc:def") == "abc:def"
assert parse("").isOk
assert parse("abc:/4/5").isOk
assert parse("a._b-c:/4_-/5.9").isOk
assert not parse("::").isOk
assert not parse("a:b:c").isOk
assert not parse("he/llo:bye").isOk
assert not parse("1234+567:89").isOk

# codec
assertEncodeSuccess(fromStatic("abc", "def"), jsonOps(), jsonString("abc:def"))
assertEncodeSuccess(fromStatic("", "no_namespace"), jsonOps(), jsonString(":no_namespace"))
assertEncodeSuccess(vanillaStatic("example"), jsonOps(), jsonString("minecraft:example"))
assertDecodeIsSuccess(Identifier, jsonString("abc:def"), jsonOps())
assertDecodeIsSuccess(Identifier, jsonString("vanilla"), jsonOps())
assertDecodeIsError(Identifier, jsonString("2 + 3"), jsonOps())
assertDecodeIsSuccess(Identifier, jsonString("a._b-c:/4_-/5.9"), jsonOps())
let decoded = codec_core.parse(Identifier, jsonString("vanilla"), jsonOps())
assert decoded.isSuccess and $decoded.successResult == "minecraft:vanilla"
let badDecode = codec_core.parse(Identifier, jsonString("2 + 3"), jsonOps())
assert badDecode.message == "Not a valid resource location: 2 + 3"

# the String form Encode and Decode go through
assert toJsonString(toJson(fromStatic("abc", "def"))) == "\"abc:def\""
assert toJsonString(toJson(fromStatic("", "no_namespace"))) == "\":no_namespace\""
assert toJsonString(toJson(vanillaStatic("example"))) == "\"minecraft:example\""
assert flatTryFrom("abc:def").isSuccess
assert flatTryFrom("vanilla").isSuccess
assert not flatTryFrom("2 + 3").isSuccess
assert flatTryFrom("2 + 3").message == "Not a valid resource location: 2 + 3"
assert flatTryFrom("a._b-c:/4_-/5.9").isSuccess

# serde
assert $fromJson(Identifier, jsonString("abc:def")).successResult == "abc:def"
assert fromJson(Identifier, jsonString("a:b:c")).message ==
  "Invalid character in path of identifier: a:b:c"
assert fromJson(Identifier, jsonString("A:b")).message ==
  "Invalid character in namespace of identifier: A:b"
assert fromJson(Identifier, jsonInt(1)).message == "invalid type: integer `1`, expected a string"

# the rest of the surface
assert $pumpkinStatic("x") == "pumpkin:x"
assert str(pumpkin("x")) == "pumpkin:x"
assert isPumpkin(pumpkinStatic("x")) and not isVanilla(pumpkinStatic("x"))
assert isVanillaThen(vanillaStatic("p")) == (true, "p")
assert isVanillaThen(pumpkinStatic("p"))[0] == false
assert isPumpkinThen(pumpkinStatic("p")) == (true, "p")
assert isPumpkinThen(vanillaStatic("p"))[0] == false
assert str(serverNs("x")) == "server:x"
assert isServerNs(serverNs("x").value)

assert str(withPath(fromStatic("a", "b"), "c")) == "a:c"
assert not withPath(fromStatic("a", "b"), "C").isOk
assert str(prefixPath(fromStatic("a", "b"), "x/")) == "a:x/b"
assert str(suffixPath(fromStatic("a", "b"), "/y")) == "a:b/y"
assert str(mapPath(fromStatic("a", "b"), proc (p: string): string = p & p)) == "a:bb"
assert view(fromStatic("a", "b")) == ("a", "b")
assert str(tryFrom(Identifier, "q:r")) == "q:r"

assert isValidChar(':') and isValidChar('/') and not isValidChar('A')
assert isValidNamespace("a.b_c-1") and not isValidNamespace("a/b")
assert isValidPath("a/b") and not isValidPath("a:b")

assert fromStatic("a", "z") < fromStatic("b", "a")
assert fromStatic("a", "a") < fromStatic("a", "b")
assert fromStatic("a", "a") <= fromStatic("a", "a")
assert fromStatic("a", "a") == fromStatic("a", "a")

var t = initTable[Identifier, int]()
t[fromStatic("a", "b")] = 7
assert t.hasKey(fromStatic("a", "b"))
assert not t.hasKey(fromStatic("a", "c"))

echo "identifier checks passed"
