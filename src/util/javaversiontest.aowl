let order = [jmvV1_7_2, jmvV1_7_6, jmvV1_8, jmvV1_9, jmvV1_9_1, jmvV1_9_2, jmvV1_9_3, jmvV1_10, jmvV1_11, jmvV1_11_1, jmvV1_12, jmvV1_12_1, jmvV1_12_2, jmvV1_13, jmvV1_13_1, jmvV1_13_2, jmvV1_14, jmvV1_14_1, jmvV1_14_2, jmvV1_14_3, jmvV1_14_4, jmvV1_15, jmvV1_15_1, jmvV1_15_2, jmvV1_16, jmvV1_16_1, jmvV1_16_2, jmvV1_16_3, jmvV1_16_4, jmvV1_17, jmvV1_17_1, jmvV1_18, jmvV1_18_2, jmvV1_19, jmvV1_19_1, jmvV1_19_3, jmvV1_19_4, jmvV1_20, jmvV1_20_2, jmvV1_20_3, jmvV1_20_5, jmvV1_21, jmvV1_21_2, jmvV1_21_4, jmvV1_21_5, jmvV1_21_6, jmvV1_21_7, jmvV1_21_9, jmvV1_21_11, jmvV26_1, jmvV26_2]
for i in 1 ..< order.len:
  assert order[i - 1] < order[i]

assert $jmvUnknown == "unknown"
assert toJsonString(toJson(jmvUnknown)) == "\"Unknown\""
assert fromProtocol(0) == jmvUnknown
assert fromProtocol(6) == jmvUnknown

assert protocolVersion(bmvV1_21) == 671
assert protocolVersion(bmvV1_26_30) == 1001
assert protocolVersion(bmvUnknown) == -1
assert bedrockFromProtocol(671) == bmvV1_21
assert bedrockFromProtocol(1001) == bmvV1_26_30
assert bedrockFromProtocol(774) == bmvUnknown
assert $bmvV1_21 == "1.21"
assert $bmvV1_26_30 == "1.26.30"
assert $bmvUnknown == "unknown"
assert bmvV1_21 < bmvV1_26_30 and bmvV1_26_30 < bmvUnknown
assert toJsonString(toJson(bmvV1_26_30)) == "\"V_1_26_30\""

echo "version checks passed"
