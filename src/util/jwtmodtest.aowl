## Known answers for jwtmod.aowl. Upstream has no #[test] for this file. Vectors come from a separate pure-Python
## model (jwtmodtestdata.aowl), RFC 6979 A.2.6, and the pycryptodome-minted token in src/auth/jwttest.aowl.

{.feature: "untyped".}

import std/assertions
import std/syncio
import std/options
import ../codecs/json_value
import ../codecs/data_result
import bignum, ecdsa
import jwtmodtestdata
import jwtmod

proc hv(c: char): int =
  if c >= '0' and c <= '9': ord(c) - ord('0')
  elif c >= 'a' and c <= 'f': ord(c) - ord('a') + 10
  elif c >= 'A' and c <= 'F': ord(c) - ord('A') + 10
  else: 0

proc fromHex(s: string): seq[byte] =
  result = newSeq[byte](s.len div 2)
  var i = 0
  while i < s.len:
    result[i div 2] = uint8(hv(s[i]) * 16 + hv(s[i + 1]))
    i += 2

proc toHex(b: openArray[byte]): string =
  const digits = "0123456789abcdef"
  result = ""
  for x in b:
    result.add(digits[int(x shr 4)])
    result.add(digits[int(x and 0x0F'u8)])

proc bytesOf(s: string): seq[byte] =
  result = newSeq[byte](s.len)
  for i in 0 ..< s.len:
    result[i] = byte(ord(s[i]))

proc err[T](r: JwtResult[T]): string =
  assert not r.isOk
  $r.error

proc samePoint(a, b: EcPoint): bool =
  bnCmp(a.x, b.x) == 0 and bnCmp(a.y, b.y) == 0

proc jwkFrom(text: string): Jwk =
  let d = fromJson(Jwk, parseJsonValue(text).value)
  assert d.isSuccess
  d.successResult

const Issuer = "https://issuer.test"

type CallLog = ref object
  calls: seq[string]
  timeouts: seq[uint32]

let d1 = signingKeyFromBytes(fromHex(D1Hex)).value
let d2 = signingKeyFromBytes(fromHex(D2Hex)).value
let q1 = verifyingKey(d1)

# --- base64 engines ---
assert toHex(decodeB64Standard("aGk=").value) == "6869"
assert toHex(decodeB64UrlNopad("aGk").value) == "6869"
assert toHex(decodeB64UrlNopad("-_-_").value) == "fbffbf"
assert toHex(decodeB64Standard("+/+/").value) == "fbffbf"
assert decodeB64Standard("").isOk
assert err(decodeB64Standard("aGk")) == "Base64 decoding failed: Invalid padding"
assert err(decodeB64UrlNopad("aGk=")) == "Base64 decoding failed: Invalid padding"
assert err(decodeB64Standard("aGk==")) == "Base64 decoding failed: Invalid padding"
assert err(decodeB64Standard("a-k=")) == "Base64 decoding failed: Invalid symbol 45, offset 1."
assert err(decodeB64UrlNopad("a+k")) == "Base64 decoding failed: Invalid symbol 43, offset 1."
assert err(decodeB64UrlNopad("a")) == "Base64 decoding failed: Invalid input length 1"
assert err(decodeB64UrlNopad("aGl")) == "Base64 decoding failed: Invalid last symbol 108, offset 2."

# --- build_public_key_from_b64, all its forms ---
assert samePoint(buildPublicKeyFromB64(Q1Sec1B64).value, q1)
assert samePoint(buildPublicKeyFromB64(Q1RawB64).value, q1)
assert samePoint(buildPublicKeyFromB64(Q1SpkiB64).value, q1)
assert samePoint(buildPublicKeyFromB64(Q1SpkiUrlB64).value, q1)
assert err(buildPublicKeyFromB64("AAAAAAA=")) == "Public key build failed: Unsupported key format/length: 5 bytes"
assert buildPublicKeyFromB64("!!!").error.kind == aekBase64Decode
assert toHex(toPublicKeyDer(q1)) == toHex(fromPublicKeyDer(toPublicKeyDer(q1)).value.toPublicKeyDer)

# from_sec1_bytes: compressed, off the curve, wrong sizes
assert samePoint(fromSec1Bytes(fromHex(Q1Compressed)).value, q1)
block:
  var offCurve = toSec1Bytes(q1)
  offCurve[96] = offCurve[96] xor 1'u8
  assert err(fromSec1Bytes(offCurve)) == "Public key build failed: crypto error"
  assert not fromSec1Bytes(@[0x00'u8]).isOk
  assert not fromSec1Bytes(@[]).isOk
  # SPKI with a wrong curve OID, and trailing junk
  var wrongCurve = toPublicKeyDer(q1)
  wrongCurve[19] = 0x23'u8
  assert not fromPublicKeyDer(wrongCurve).isOk
  var junk = toPublicKeyDer(q1)
  junk.add(0'u8)
  assert not fromPublicKeyDer(junk).isOk

# --- decode_header_get_x5u ---
block:
  var dot = 0
  while SelfSigned[dot] != '.':
    inc dot
  assert decodeHeaderGetX5u(SelfSigned[0 ..< dot]).value == Q1SpkiB64
  assert err(decodeHeaderGetX5u("e30")) == "x5u not found in header"
  assert decodeHeaderGetX5u("!").error.kind == aekBase64Decode
  assert decodeHeaderGetX5u("bm90anNvbg").error.kind == aekJsonParse

# --- Jwk ---
let ecJwk = jwkFrom("{\"kty\":\"EC\",\"crv\":\"P-384\",\"kid\":\"ec1\",\"x\":\"" & JwkX & "\",\"y\":\"" & JwkY & "\",\"extra\":1}")
let rsaJwk = jwkFrom("{\"kty\":\"RSA\",\"alg\":\"RS256\",\"kid\":\"rsa1\",\"n\":\"" & RsaN & "\",\"e\":\"" & RsaE & "\"}")
assert ecJwk.alg.isNone and ecJwk.crv.get() == "P-384" and ecJwk.n.isNone
assert rsaJwk.alg.get() == "RS256"
assert samePoint(toEcPublicKey(ecJwk).value, q1)
assert err(toEcPublicKey(rsaJwk)) == "Public key build failed: Unsupported JWK kty for EC: RSA"
assert err(toEcPublicKey(jwkFrom("""{"kty":"EC","crv":"P-256","kid":"k"}"""))) == "Public key build failed: Unsupported JWK crv: P-256"
assert err(toEcPublicKey(jwkFrom("""{"kty":"EC","kid":"k"}"""))) == "Public key build failed: JWK missing x coordinate for EC key"
assert err(toEcPublicKey(jwkFrom("""{"kty":"EC","kid":"k","x":"AA"}"""))) == "Public key build failed: JWK missing y coordinate for EC key"
assert err(toEcPublicKey(jwkFrom("""{"kty":"EC","kid":"k","x":"AA","y":"AA"}"""))) == "Public key build failed: Invalid P-384 coordinate lengths"
assert fromJson(Jwk, parseJsonValue("""{"kty":"EC"}""").value).message == "missing field `kid`"
assert fromJson(Jwk, parseJsonValue("""{"kid":"x"}""").value).message == "missing field `kty`"

assert toRsaPublicKey(rsaJwk).isOk
assert err(toRsaPublicKey(ecJwk)) == "Public key build failed: Unsupported JWK kty for RSA: EC"
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k"}"""))) == "Public key build failed: JWK missing n modulus for RSA key"
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k","n":"AQ"}"""))) == "Public key build failed: JWK missing e exponent for RSA key"
# n = 8 is even; e = 4 is even; e = 1 is too small; e = 2^33 + 1 is too large
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k","n":"CA","e":"Aw"}"""))) == "Public key build failed: invalid modulus"
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k","n":"IQ","e":"BA"}"""))) == "Public key build failed: invalid exponent"
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k","n":"IQ","e":"AQ"}"""))) == "Public key build failed: public exponent too small"
assert err(toRsaPublicKey(jwkFrom("""{"kty":"RSA","kid":"k","n":"AQAAAAAAAAAB","e":"AgAAAAE"}"""))) == "Public key build failed: public exponent too large"

let jwks = Jwks(keys: @[ecJwk, rsaJwk])

# --- verify_oidc_token ---
block:
  let es = verifyOidcToken(EsToken, Issuer, jwks)
  assert es.isOk
  assert es.value.displayName == "Steve"
  assert es.value.xuid == "2535400000000000"
  assert es.value.uuid == XuidUuid

  let rs = verifyOidcToken(RsToken, Issuer, jwks)
  assert rs.isOk
  assert rs.value.uuid == XuidUuid

  assert verifyOidcToken(EsAudList, Issuer, jwks).isOk

  assert err(verifyOidcToken("a.b", Issuer, jwks)) == "Invalid token format"
  assert err(verifyOidcToken(EsToken, "https://else", jwks)) ==
    "Public key build failed: OIDC issuer mismatch: expected https://else, got https://issuer.test"
  assert err(verifyOidcToken(EsToken, Issuer, Jwks(keys: @[rsaJwk]))) ==
    "Public key build failed: Key not found in JWKS: ec1"
  assert err(verifyOidcToken(EsBadAud, Issuer, jwks)) ==
    "Public key build failed: OIDC audience mismatch: expected api://auth-minecraft-services/multiplayer, got Array [String(\"other\"), Number(1)]"
  assert err(verifyOidcToken(EsExpired, Issuer, jwks)) == "Public key build failed: OIDC token expired"
  assert err(verifyOidcToken(EsNoExp, Issuer, jwks)) == "Public key build failed: OIDC payload missing exp"
  assert err(verifyOidcToken(EsNegExp, Issuer, jwks)) == "Public key build failed: OIDC payload missing exp"
  assert err(verifyOidcToken(EsNoIss, Issuer, jwks)) == "Public key build failed: OIDC payload missing iss"
  assert err(verifyOidcToken(EsNoAud, Issuer, jwks)) == "Public key build failed: OIDC payload missing aud"

  # eyJhbGciOiJIUzI1NiIsImtpZCI6ImVjMSJ9 is {"alg":"HS256","kid":"ec1"}
  assert err(verifyOidcToken("eyJhbGciOiJIUzI1NiIsImtpZCI6ImVjMSJ9.e30.AA", Issuer, jwks)) ==
    "Public key build failed: Unsupported OIDC algorithm: HS256"
  # e30 is {}, and {"kid":"ec1"} has no alg
  assert err(verifyOidcToken("e30.e30.AA", Issuer, jwks)) == "Public key build failed: OIDC header missing kid"
  assert err(verifyOidcToken("eyJraWQiOiJlYzEifQ.e30.AA", Issuer, jwks)) == "Public key build failed: OIDC header missing alg"

  # any changed signature byte is refused, on both algorithms
  var badEs = EsToken
  badEs[badEs.len - 2] = (if badEs[badEs.len - 2] == 'A': 'B' else: 'A')
  assert err(verifyOidcToken(badEs, Issuer, jwks)) == "Invalid signature"
  var badRs = RsToken
  badRs[badRs.len - 2] = (if badRs[badRs.len - 2] == 'A': 'B' else: 'A')
  assert err(verifyOidcToken(badRs, Issuer, jwks)) == "Invalid signature"
  # a short signature
  var dot2 = EsToken.len - 1
  while EsToken[dot2] != '.':
    dec dot2
  assert err(verifyOidcToken(EsToken[0 .. dot2] & "AAAA", Issuer, jwks)) == "Invalid signature"
  var rdot = RsToken.len - 1
  while RsToken[rdot] != '.':
    dec rdot
  assert err(verifyOidcToken(RsToken[0 .. rdot] & "AAAA", Issuer, jwks)) == "Invalid signature"

# --- the token minted by pycryptodome, an independent ES384 implementation ---
block:
  let token = "eyJhbGciOiJFUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0LXVzZXIiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MTg5MzQ1NjAwMH0.a8u02fuWQ5A-pY_bIEfhGokpD-qSHI0c7B27Sq6sb1im8XIYiHMDA685QUfdt5-9FDAbecaTtrB5nj3-TxrVAP_-6_7_yRMj0l_5hI9jjgsbfGtTXdaRb5hiNv7_iUWY"
  let key = fromSec1Bytes(fromHex("0400795e153e34ef959e470a1a2d49289c3e2790136de3a125adf4d19349d777c815a561a756300616401dead5d04e2e8a3cdeede220e72775b72c37379766b508a38b91afc68ec3be41bccf90b849b3bb0864702144c54ee6d63b0fa48667d3ea"))
  assert key.isOk
  let parts = "eyJhbGciOiJFUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0LXVzZXIiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MTg5MzQ1NjAwMH0"
  assert verifyEs384Signature(key.value, parts, token[parts.len + 1 .. ^1]).isOk
  assert err(verifyEs384Signature(key.value, parts & "x", token[parts.len + 1 .. ^1])) == "Invalid signature"

# --- verify_oidc_token_self_signed ---
block:
  let ok = verifyOidcTokenSelfSigned(SelfSigned)
  assert ok.isOk
  assert ok.value.displayName == "Alex"
  # no xid, so leguuid wins
  assert ok.value.uuid == "legacy-id"
  assert ok.value.xuid == ""
  assert err(verifyOidcTokenSelfSigned(SelfSignedOtherKey)) == "Invalid signature"
  assert err(verifyOidcTokenSelfSigned(SelfSignedRs)) ==
    "Public key build failed: Unsupported OIDC algorithm (for self-signed): RS256"
  assert err(verifyOidcTokenSelfSigned("e30.e30.AA")) == "Public key build failed: OIDC header missing alg"
  # {"alg":"ES384"} with no x5u
  assert err(verifyOidcTokenSelfSigned("eyJhbGciOiJFUzM4NCJ9.e30.AA")) == "x5u not found in header"
  # {"alg":"ES384","x5u":"AAAA"}
  assert err(verifyOidcTokenSelfSigned("eyJhbGciOiJFUzM4NCIsIng1dSI6IkFBQUEifQ.e30.AA")) ==
    "Public key build failed: Couldn't build public key from x5u"

# --- claims ---
block:
  assert xuidToUuid("2535400000000000") == XuidUuid
  let noClaims = extractOidcTokenPlayerClaims(NoClaimsToken)
  assert noClaims.isOk
  assert noClaims.value.displayName == "N"
  assert noClaims.value.xuid == ""
  # no xid and no leguuid hashes the empty xuid
  assert noClaims.value.uuid == EmptyXuidUuid
  assert err(extractOidcTokenPlayerClaims("x")) == "Invalid token format"

  let cpk = extractCpkFromToken(SelfSigned)
  assert cpk.isOk
  assert samePoint(cpk.value, verifyingKey(d2))
  assert err(extractCpkFromToken(EsToken)) == "Public key build failed: OIDC payload missing cpk"
  assert err(extractCpkFromToken("x")) == "Invalid token format"

# --- fetch_oidc_jwks, through a stand-in for the transport ---
proc testFetch() =
  let log = CallLog(calls: @[], timeouts: @[])
  let okGet: HttpGet = proc (url: string, connectTimeoutMs, readTimeoutMs: uint32): (bool, string) {.closure.} =
    log.calls.add(url)
    log.timeouts.add(connectTimeoutMs)
    log.timeouts.add(readTimeoutMs)
    if url == OidcDiscoveryUrl or url == "https://d.test":
      (true, """{"result":{"serviceEnvironments":{"auth":{"prod":{"serviceUri":"https://auth.test"}}}}}""")
    elif url == "https://auth.test/.well-known/openid-configuration":
      (true, """{"jwks_uri":"https://auth.test/keys","issuer":"https://auth.test/iss"}""")
    elif url == "https://auth.test/keys":
      (true, """{"keys":[{"kty":"EC","kid":"a"},{"kty":"RSA","kid":"b"}]}""")
    else:
      (false, "unexpected url")
  let r = fetchOidcJwks(okGet, none[string](), 11'u32, 22'u32)
  assert r.isOk
  assert r.value[0] == "https://auth.test/iss"
  assert r.value[1].keys.len == 2
  assert r.value[1].keys[1].kid == "b"
  assert log.calls == @[OidcDiscoveryUrl, "https://auth.test/.well-known/openid-configuration", "https://auth.test/keys"]
  assert log.timeouts[0] == 11'u32 and log.timeouts[1] == 22'u32
  assert fetchOidcJwks(okGet, some("https://d.test"), 1'u32, 1'u32).isOk
  assert err(fetchOidcJwks(okGet, some("https://nope.test"), 1'u32, 1'u32)) == "Public key build failed: unexpected url"

  let noUri: HttpGet = proc (url: string, c, t: uint32): (bool, string) {.closure.} =
    (true, """{"result":{}}""")
  assert err(fetchOidcJwks(noUri, none[string](), 1'u32, 1'u32)) == "Public key build failed: Discovery missing serviceUri"

  let noJwksUri: HttpGet = proc (url: string, c, t: uint32): (bool, string) {.closure.} =
    if url == OidcDiscoveryUrl:
      (true, """{"result":{"serviceEnvironments":{"auth":{"prod":{"serviceUri":"s"}}}}}""")
    else:
      (true, """{"issuer":"i"}""")
  assert err(fetchOidcJwks(noJwksUri, none[string](), 1'u32, 1'u32)) == "Public key build failed: OpenID config missing jwks_uri"

  let noIssuer: HttpGet = proc (url: string, c, t: uint32): (bool, string) {.closure.} =
    if url == OidcDiscoveryUrl:
      (true, """{"result":{"serviceEnvironments":{"auth":{"prod":{"serviceUri":"s"}}}}}""")
    else:
      (true, """{"jwks_uri":"j"}""")
  assert err(fetchOidcJwks(noIssuer, none[string](), 1'u32, 1'u32)) == "Public key build failed: OpenID config missing issuer"

testFetch()

# --- RFC 6979 A.2.6, P-384 with SHA-384, message "sample" ---
block:
  let key = signingKeyFromBytes(fromHex("6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5")).value
  let sig = signEs384(key, bytesOf("sample"))
  assert toHex(sig) == "94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46" &
                       "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8"
  assert toHex(sig) == RfcSampleR

# --- signing keys ---
assert not signingKeyFromBytes(@[1'u8]).isOk
assert not signingKeyFromBytes(newSeq[byte](48)).isOk
block:
  var overN = newSeq[byte](48)
  for i in 0 ..< 48:
    overN[i] = 0xFF'u8
  assert not signingKeyFromBytes(overN).isOk

# --- generate_handshake_jwt: exact text, then it verifies as a self-signed token's signature ---
block:
  var salt = newSeq[byte](16)
  for i in 0 ..< 16:
    salt[i] = uint8(i)
  let jwt = generateHandshakeJwt(d1, salt)
  assert jwt.isOk
  assert jwt.value == Handshake

# --- compute_shared_secret ---
block:
  let q2 = buildPublicKeyFromB64(Q2Sec1B64).value
  assert toHex(computeSharedSecret(d1, q2)) == SharedHex
  assert toHex(computeSharedSecret(d2, q1)) == SharedHex

echo "jwtmod checks passed"
