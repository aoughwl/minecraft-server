## Port of pumpkin-util/src/random/legacy_rand.rs
##
## Legacy (pre-1.13) Java-`Random`-compatible 48-bit LCG. `RandomImpl`'s `next_splitter` and the
## `RandomDeriverImpl` forms returning `RandomGenerator` live in random/random.aowl, which imports this file.
## `newSplitter` is the concrete splitter, and the `split*` procs here return the concrete `LegacyRand`.

import std/options
import random/rustnum
import random/gaussian
from math/mathmod import javaStringHash

export javaStringHash

type
  LegacyRand* = object
    seed: uint64
    internalNextGaussian: Option[float64]

  LegacySplitter* = object
    seed*: uint64

proc hashBlockPos*(x, y, z: int32): int64 =
  ## `hash_block_pos` from random/mod.rs, here so xoroshiro128.aowl can share it without an import cycle.
  let l0 = int64(wrapMul(x, 3129871'i32)) xor wrapMul(int64(z), 116129781'i64) xor int64(y)
  let l = wrapAdd(wrapMul(wrapMul(l0, l0), 42317861'i64), wrapMul(l0, 11'i64))
  l shr 16

proc fromSeed*(seed: uint64): LegacyRand =
  LegacyRand(seed: (seed xor 0x0005_DEEC_E66D'u64) and 0xFFFF_FFFF_FFFF'u64,
             internalNextGaussian: none[float64]())

proc nextRandom(r: var LegacyRand): int64 =
  let l = cast[int64](r.seed)
  let m = wrapAdd(wrapMul(l, 0x0005_DEEC_E66D'i64), 11'i64) and 0xFFFFFFFFFFFF'i64
  r.seed = cast[uint64](m)
  m

proc nextBits(r: var LegacyRand, bits: int): int32 =
  truncI32(nextRandom(r) shr (48 - bits))

proc storedNextGaussian*(r: LegacyRand): Option[float64] =
  r.internalNextGaussian

proc setStoredNextGaussian*(r: var LegacyRand, value: Option[float64]) =
  r.internalNextGaussian = value

proc nextI32*(r: var LegacyRand): int32 =
  nextBits(r, 32)

proc nextBoundedI32*(r: var LegacyRand, bound: int32): int32 =
  if (bound and wrapSub(bound, 1'i32)) == 0'i32:
    return truncI32(wrapMul(int64(bound), int64(nextBits(r, 31))) shr 31)
  while true:
    let i = nextBits(r, 31)
    let j = i mod bound
    if wrapAdd(wrapSub(i, j), wrapSub(bound, 1'i32)) >= 0'i32:
      return j

proc nextInbetweenI32*(r: var LegacyRand, minV, maxV: int32): int32 =
  wrapAdd(nextBoundedI32(r, wrapAdd(wrapSub(maxV, minV), 1'i32)), minV)

proc nextInbetweenI32Exclusive*(r: var LegacyRand, minV, maxV: int32): int32 =
  wrapAdd(minV, nextBoundedI32(r, wrapSub(maxV, minV)))

proc nextI64*(r: var LegacyRand): int64 =
  let i = nextI32(r)
  let j = nextI32(r)
  wrapAdd(int64(i) shl 32, int64(j))

proc nextBool*(r: var LegacyRand): bool =
  nextBits(r, 1) != 0'i32

proc nextF32*(r: var LegacyRand): float32 =
  float32(nextBits(r, 24)) * 5.9604645e-8'f32

proc nextInbetweenF32*(r: var LegacyRand, minV, maxV: float32): float32 =
  nextF32(r) * (maxV - minV) + minV

proc nextF64*(r: var LegacyRand): float64 =
  let i = nextBits(r, 26)
  let j = nextBits(r, 27)
  let l = wrapAdd(int64(i) shl 27, int64(j))
  float64(l) * float64(1.110223e-16'f32)

proc nextTriangular*(r: var LegacyRand, mode, deviation: float64): float64 =
  let a = nextF64(r)
  let b = nextF64(r)
  mode + deviation * (a - b)

proc nextGaussian*(r: var LegacyRand): float64 =
  calculateGaussian(r)

proc skip*(r: var LegacyRand, count: int32) =
  ## Upstream overrides the default here: `next_i64` is two LCG steps, and a skip is one per count.
  for i in 0'i32 ..< count:
    discard nextI32(r)

proc split*(r: var LegacyRand): LegacyRand =
  fromSeed(cast[uint64](nextI64(r)))

proc newSplitter*(r: var LegacyRand): LegacySplitter =
  LegacySplitter(seed: cast[uint64](nextI64(r)))

proc splitString*(s: LegacySplitter, seed: string): LegacyRand =
  let stringHash = javaStringHash(seed)
  fromSeed(signExtendU64(stringHash) xor s.seed)

proc splitU64*(s: LegacySplitter, seed: uint64): LegacyRand =
  fromSeed(seed)

proc splitPos*(s: LegacySplitter, x, y, z: int32): LegacyRand =
  let posHash = hashBlockPos(x, y, z)
  fromSeed(cast[uint64](posHash) xor s.seed)

proc getPopulationSeed*(worldSeed: uint64, blockX, blockZ: int32): uint64 =
  var rand = fromSeed(worldSeed)
  let l = nextI64(rand) or 1'i64
  let m = nextI64(rand) or 1'i64
  let base = wrapAdd(wrapMul(int64(blockX), l), wrapMul(int64(blockZ), m))
  cast[uint64](base) xor worldSeed
