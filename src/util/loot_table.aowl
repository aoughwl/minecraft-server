## Port of pumpkin-util/src/loot_table.rs
##
## `&'static [T]` is `seq[T]`, `Option<&'static [T]>` is `Option[seq[T]]`. `LootCondition::Inverted(&Self)` holds
## its one condition in a one-element seq. `ToTokens` is upstream's data generator feature, and here `toTokens`
## writes the aowlmony expression a generator emits.

{.feature: "untyped".}

import std/options
import ../codecs/json_value
import ../codecs/data_result
import serde_forms

proc fmaf(x, y, z: cfloat): cfloat {.importc: "fmaf", header: "<math.h>".}

type
  LootTableType* = enum
    lttEmpty
    lttEntity
    lttBlock
    lttChest

  UniformLootNumberProvider* = object
    min*: float32
    max*: float32

  LootNumberProviderTypesProviderKind* = enum
    lnpUniform

  LootNumberProviderTypesProvider* = object
    case kind*: LootNumberProviderTypesProviderKind
    of lnpUniform:
      uniform*: UniformLootNumberProvider

  LootNumberProviderTypesKind* = enum
    lntObject
    lntConstant

  LootNumberProviderTypes* = object
    case kind*: LootNumberProviderTypesKind
    of lntObject:
      provider*: LootNumberProviderTypesProvider
    of lntConstant:
      constant*: float32

  LootFunctionNumberProviderKind* = enum
    lfnConstant
    lfnUniform
    lfnBinomial

  LootFunctionNumberProvider* = object
    case kind*: LootFunctionNumberProviderKind
    of lfnConstant:
      value*: float32
    of lfnUniform:
      min*: float32
      max*: float32
    of lfnBinomial:
      n*: float32
      p*: float32

  LootFunctionBonusParameterKind* = enum
    lfbMultiplier
    lfbProbability

  LootFunctionBonusParameter* = object
    case kind*: LootFunctionBonusParameterKind
    of lfbMultiplier:
      bonusMultiplier*: int32
    of lfbProbability:
      extra*: int32
      probability*: float32

  LootConditionKind* = enum
    lcInverted
    lcAnyOf
    lcAllOf
    lcRandomChance
    lcRandomChanceWithEnchantedBonus
    lcEntityProperties
    lcKilledByPlayer
    lcEntityScores
    lcBlockStateProperty
    lcMatchTool
    lcTableBonus
    lcSurvivesExplosion
    lcDamageSourceProperties
    lcLocationCheck
    lcWeatherCheck
    lcReference
    lcTimeCheck
    lcValueCheck
    lcEnchantmentActiveCheck

  FloatRange* = (Option[float32], Option[float32])

  LootCondition* = object
    case kind*: LootConditionKind
    of lcInverted:
      inverted*: seq[LootCondition]   ## exactly one element
    of lcAnyOf:
      anyOf*: seq[LootCondition]
    of lcAllOf:
      allOf*: seq[LootCondition]
    of lcRandomChance:
      chance*: float32
    of lcRandomChanceWithEnchantedBonus:
      bonusEnchantment*: string
      bonusChances*: Option[seq[float32]]
    of lcEntityProperties:
      entity*: string
      expectedType*: Option[string]
      isOnFire*: Option[bool]
      mainhandEnchantmentTag*: Option[string]
    of lcKilledByPlayer, lcSurvivesExplosion:
      discard
    of lcEntityScores:
      scoresEntity*: string
    of lcBlockStateProperty:
      blockName*: string
      properties*: seq[(string, string)]
    of lcMatchTool:
      items*: Option[seq[string]]
    of lcTableBonus:
      enchantment*: string
      chances*: seq[float32]
    of lcDamageSourceProperties:
      expectedSourceType*: Option[string]
      expectedDirectType*: Option[string]
    of lcLocationCheck:
      offsetX*: int32
      offsetY*: int32
      offsetZ*: int32
      expectedBiome*: Option[string]
    of lcWeatherCheck:
      raining*: Option[bool]
      thundering*: Option[bool]
    of lcReference:
      name*: string
    of lcTimeCheck:
      timeRange*: FloatRange
      period*: Option[uint64]
    of lcValueCheck:
      checkValue*: LootNumberProviderTypes
      valueRange*: FloatRange
    of lcEnchantmentActiveCheck:
      active*: bool

  LootFunctionTypesKind* = enum
    lftSetCount
    lftEnchantedCountIncrease
    lftFurnaceSmelt
    lftSetPotion
    lftSetOminousBottleAmplifier
    lftLimitCount
    lftApplyBonus
    lftCopyComponents
    lftCopyState
    lftExplosionDecay

  LootFunctionTypes* = object
    case kind*: LootFunctionTypesKind
    of lftSetCount:
      setCount*: LootFunctionNumberProvider
      add*: bool
    of lftEnchantedCountIncrease:
      increaseEnchantment*: string
      increaseCount*: LootFunctionNumberProvider
      limit*: Option[float32]
    of lftFurnaceSmelt, lftSetOminousBottleAmplifier, lftExplosionDecay:
      discard
    of lftSetPotion:
      id*: string
    of lftLimitCount:
      limitMin*: Option[float32]
      limitMax*: Option[float32]
    of lftApplyBonus:
      bonusEnchantmentName*: string
      formula*: string
      parameters*: Option[LootFunctionBonusParameter]
    of lftCopyComponents:
      source*: string
      includes*: seq[string]
    of lftCopyState:
      stateBlock*: string
      stateProperties*: seq[string]

  LootFunction* = object
    content*: LootFunctionTypes
    conditions*: Option[seq[LootCondition]]

  ItemEntry* = object
    name*: string

  TagEntry* = object
    name*: string
    expand*: bool

  LootTableEntry* = object
    value*: string

  DynamicEntry* = object
    name*: string

  LootPoolEntryTypesKind* = enum
    lpeEmpty
    lpeItem
    lpeLootTable
    lpeDynamic
    lpeTag
    lpeAlternatives
    lpeSequence
    lpeGroup

  LootPoolEntryTypes* = object
    case kind*: LootPoolEntryTypesKind
    of lpeEmpty:
      discard
    of lpeItem:
      item*: ItemEntry
    of lpeLootTable:
      lootTable*: LootTableEntry
    of lpeDynamic:
      dynamic*: DynamicEntry
    of lpeTag:
      tag*: TagEntry
    of lpeAlternatives, lpeSequence, lpeGroup:
      children*: seq[LootPoolEntry]   ## AlternativeEntry, SequenceEntry, GroupEntry

  LootPoolEntry* = object
    content*: LootPoolEntryTypes
    weight*: int32
    quality*: int32
    conditions*: Option[seq[LootCondition]]
    functions*: Option[seq[LootFunction]]

  LootPool* = object
    entries*: seq[LootPoolEntry]
    rolls*: LootNumberProviderTypes
    bonusRolls*: LootNumberProviderTypes
    conditions*: Option[seq[LootCondition]]
    functions*: Option[seq[LootFunction]]

  LootTable* = object
    `type`*: LootTableType
    randomSequence*: Option[string]
    pools*: Option[seq[LootPool]]

proc getUniform[R](u: UniformLootNumberProvider, random: var R): float32 =
  ## `random.next_f32().mul_add(max - min, min)`: a fused multiply-add.
  let drawn: float32 = nextF32(random)
  float32(fmaf(cfloat(drawn), cfloat(u.max - u.min), cfloat(u.min)))

proc get*[R](u: UniformLootNumberProvider, random: var R): float32 =
  getUniform(u, random)

proc get*[R](p: LootNumberProviderTypes, random: var R): float32 =
  case p.kind
  of lntObject:
    case p.provider.kind
    of lnpUniform: getUniform(p.provider.uniform, random)
  of lntConstant:
    p.constant

proc constantProvider*(value: float32): LootNumberProviderTypes =
  LootNumberProviderTypes(kind: lntConstant, constant: value)

proc uniformProvider*(min, max: float32): LootNumberProviderTypes =
  LootNumberProviderTypes(kind: lntObject, provider: LootNumberProviderTypesProvider(kind: lnpUniform,
    uniform: UniformLootNumberProvider(min: min, max: max)))

proc optEq[T](a, b: Option[T]): bool =
  if a.isSome != b.isSome: return false
  if a.isNone: return true
  a.unsafeGet == b.unsafeGet

proc `==`*(a, b: UniformLootNumberProvider): bool =
  a.min == b.min and a.max == b.max

proc `==`*(a, b: LootNumberProviderTypesProvider): bool =
  a.uniform == b.uniform

proc `==`*(a, b: LootNumberProviderTypes): bool =
  if a.kind != b.kind: return false
  case a.kind
  of lntObject: a.provider == b.provider
  of lntConstant: a.constant == b.constant

proc `==`*(a, b: LootFunctionNumberProvider): bool =
  if a.kind != b.kind: return false
  case a.kind
  of lfnConstant: a.value == b.value
  of lfnUniform: a.min == b.min and a.max == b.max
  of lfnBinomial: a.n == b.n and a.p == b.p

proc `==`*(a, b: LootFunctionBonusParameter): bool =
  if a.kind != b.kind: return false
  case a.kind
  of lfbMultiplier: a.bonusMultiplier == b.bonusMultiplier
  of lfbProbability: a.extra == b.extra and a.probability == b.probability

proc `==`*(a, b: LootCondition): bool

proc seqEq(a, b: seq[LootCondition]): bool =
  if a.len != b.len: return false
  for i in 0 ..< a.len:
    if not (a[i] == b[i]): return false
  true

proc pairsEq(a, b: seq[(string, string)]): bool =
  if a.len != b.len: return false
  for i in 0 ..< a.len:
    if a[i][0] != b[i][0] or a[i][1] != b[i][1]: return false
  true

proc rangeEq(a, b: FloatRange): bool =
  optEq(a[0], b[0]) and optEq(a[1], b[1])

proc `==`*(a, b: LootCondition): bool =
  if a.kind != b.kind: return false
  case a.kind
  of lcInverted: seqEq(a.inverted, b.inverted)
  of lcAnyOf: seqEq(a.anyOf, b.anyOf)
  of lcAllOf: seqEq(a.allOf, b.allOf)
  of lcRandomChance: a.chance == b.chance
  of lcRandomChanceWithEnchantedBonus:
    a.bonusEnchantment == b.bonusEnchantment and optEq(a.bonusChances, b.bonusChances)
  of lcEntityProperties:
    a.entity == b.entity and optEq(a.expectedType, b.expectedType) and
      optEq(a.isOnFire, b.isOnFire) and optEq(a.mainhandEnchantmentTag, b.mainhandEnchantmentTag)
  of lcKilledByPlayer, lcSurvivesExplosion: true
  of lcEntityScores: a.scoresEntity == b.scoresEntity
  of lcBlockStateProperty: a.blockName == b.blockName and pairsEq(a.properties, b.properties)
  of lcMatchTool: optEq(a.items, b.items)
  of lcTableBonus: a.enchantment == b.enchantment and a.chances == b.chances
  of lcDamageSourceProperties:
    optEq(a.expectedSourceType, b.expectedSourceType) and optEq(a.expectedDirectType, b.expectedDirectType)
  of lcLocationCheck:
    a.offsetX == b.offsetX and a.offsetY == b.offsetY and a.offsetZ == b.offsetZ and
      optEq(a.expectedBiome, b.expectedBiome)
  of lcWeatherCheck: optEq(a.raining, b.raining) and optEq(a.thundering, b.thundering)
  of lcReference: a.name == b.name
  of lcTimeCheck: rangeEq(a.timeRange, b.timeRange) and optEq(a.period, b.period)
  of lcValueCheck: a.checkValue == b.checkValue and rangeEq(a.valueRange, b.valueRange)
  of lcEnchantmentActiveCheck: a.active == b.active

proc `==`*(a, b: LootFunctionTypes): bool =
  if a.kind != b.kind: return false
  case a.kind
  of lftSetCount: a.setCount == b.setCount and a.add == b.add
  of lftEnchantedCountIncrease:
    a.increaseEnchantment == b.increaseEnchantment and a.increaseCount == b.increaseCount and
      optEq(a.limit, b.limit)
  of lftFurnaceSmelt, lftSetOminousBottleAmplifier, lftExplosionDecay: true
  of lftSetPotion: a.id == b.id
  of lftLimitCount: optEq(a.limitMin, b.limitMin) and optEq(a.limitMax, b.limitMax)
  of lftApplyBonus:
    a.bonusEnchantmentName == b.bonusEnchantmentName and a.formula == b.formula and
      optEq(a.parameters, b.parameters)
  of lftCopyComponents: a.source == b.source and a.includes == b.includes
  of lftCopyState: a.stateBlock == b.stateBlock and a.stateProperties == b.stateProperties

proc `==`*(a, b: LootFunction): bool =
  if not (a.content == b.content): return false
  if a.conditions.isSome != b.conditions.isSome: return false
  if a.conditions.isNone: return true
  seqEq(a.conditions.unsafeGet, b.conditions.unsafeGet)

proc `==`*(a, b: ItemEntry): bool =
  a.name == b.name

proc fromJson*(t: typedesc[UniformLootNumberProvider], v: JsonValue): DataResult[UniformLootNumberProvider] =
  if v.kind != jvObject:
    return newError[UniformLootNumberProvider](invalidType(v, "struct UniformLootNumberProvider"))
  let (hasMin, minV) = v.get("min")
  if not hasMin:
    return newError[UniformLootNumberProvider](missingField("min"))
  let minR = readF32(minV)
  if not minR.isSuccess:
    return newError[UniformLootNumberProvider](minR.message)
  let (hasMax, maxV) = v.get("max")
  if not hasMax:
    return newError[UniformLootNumberProvider](missingField("max"))
  let maxR = readF32(maxV)
  if not maxR.isSuccess:
    return newError[UniformLootNumberProvider](maxR.message)
  newSuccess(UniformLootNumberProvider(min: minR.successResult, max: maxR.successResult))

proc fromJson*(t: typedesc[LootNumberProviderTypesProvider], v: JsonValue): DataResult[LootNumberProviderTypesProvider] =
  ## `#[serde(tag = "type")]`.
  if v.kind != jvObject:
    return newError[LootNumberProviderTypesProvider](invalidType(v, "internally tagged enum LootNumberProviderTypesProvider"))
  let (hasTag, tag) = v.get("type")
  if not hasTag:
    return newError[LootNumberProviderTypesProvider](missingField("type"))
  if tag.kind != jvString:
    return newError[LootNumberProviderTypesProvider](invalidType(tag, "variant identifier"))
  if tag.strVal != "minecraft:uniform":
    return newError[LootNumberProviderTypesProvider](unknownVariant(tag.strVal, ["minecraft:uniform"]))
  let u = fromJson(UniformLootNumberProvider, v)
  if not u.isSuccess:
    return newError[LootNumberProviderTypesProvider](u.message)
  newSuccess(LootNumberProviderTypesProvider(kind: lnpUniform, uniform: u.successResult))

proc fromJson*(t: typedesc[LootNumberProviderTypes], v: JsonValue): DataResult[LootNumberProviderTypes] =
  ## `#[serde(untagged)]`: object first, then the constant.
  let o = fromJson(LootNumberProviderTypesProvider, v)
  if o.isSuccess:
    return newSuccess(LootNumberProviderTypes(kind: lntObject, provider: o.successResult))
  let c = readF32(v)
  if c.isSuccess:
    return newSuccess(constantProvider(c.successResult))
  newError[LootNumberProviderTypes]("data did not match any variant of untagged enum LootNumberProviderTypes")

proc floatTokens(f: float32): string =
  formatF32(f) & "'f32"

proc toTokens*(u: UniformLootNumberProvider): string =
  "UniformLootNumberProvider(min: " & floatTokens(u.min) & ", max: " & floatTokens(u.max) & ")"

proc toTokens*(p: LootNumberProviderTypesProvider): string =
  "LootNumberProviderTypesProvider(kind: lnpUniform, uniform: " & toTokens(p.uniform) & ")"

proc toTokens*(p: LootNumberProviderTypes): string =
  case p.kind
  of lntObject: "LootNumberProviderTypes(kind: lntObject, provider: " & toTokens(p.provider) & ")"
  of lntConstant: "LootNumberProviderTypes(kind: lntConstant, constant: " & floatTokens(p.constant) & ")"
