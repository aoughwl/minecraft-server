## Known answers for loot_table.aowl. Upstream has no #[test] for this file.

{.feature: "untyped".}

import std/assertions
import std/syncio
import std/options
import ../codecs/json_value
import ../codecs/data_result
import legacy_rand
import loot_table

type FixedRand = object
  v: float32

proc nextF32(f: var FixedRand): float32 = f.v

proc provider(text: string): DataResult[LootNumberProviderTypes] =
  fromJson(LootNumberProviderTypes, parseJsonValue(text).value)

# untagged: a number is Constant, an object is the tagged provider
assert provider("3").successResult == constantProvider(3.0'f32)
assert provider("1.5").successResult == constantProvider(1.5'f32)
assert provider("""{"type": "minecraft:uniform", "min": 1, "max": 4.5}""").successResult ==
  uniformProvider(1.0'f32, 4.5'f32)
assert provider("""{"type": "minecraft:binomial", "n": 1, "p": 0.5}""").message ==
  "data did not match any variant of untagged enum LootNumberProviderTypes"
assert provider("""{"min": 1, "max": 2}""").message ==
  "data did not match any variant of untagged enum LootNumberProviderTypes"
assert provider("\"x\"").message ==
  "data did not match any variant of untagged enum LootNumberProviderTypes"

assert fromJson(LootNumberProviderTypesProvider, parseJsonValue("""{"min": 1, "max": 2}""").value).message ==
  "missing field `type`"
assert fromJson(LootNumberProviderTypesProvider, parseJsonValue("""{"type": "x"}""").value).message ==
  "unknown variant `x`, expected `minecraft:uniform`"
assert fromJson(UniformLootNumberProvider, parseJsonValue("""{"max": 2}""").value).message ==
  "missing field `min`"

# get: LegacyRand(0).nextF32 is java.util.Random(0).nextFloat, 0.73096776
block:
  var r = fromSeed(0'u64)
  var r2 = fromSeed(0'u64)
  let first = nextF32(r2)
  assert first == 0.73096776'f32
  let got = get(uniformProvider(2.0'f32, 4.0'f32), r)
  # fused: 0.73096776 * 2 + 2, rounded once
  assert got == 3.4619355'f32
  var r3 = fromSeed(0'u64)
  assert get(constantProvider(7.0'f32), r3) == 7.0'f32
  # a constant draws nothing from the generator
  assert nextF32(r3) == first

# the case where one rounding and two roundings differ: mul_add must round once
block:
  var f = FixedRand(v: 1.0000001192092896'f32)
  let u = UniformLootNumberProvider(min: -1.0000002384185791'f32, max: 0.0'f32)
  # span is 1.0000002384185791, product is 1 + 3*2^-23 + 2^-45, sum is 2^-23 + 2^-45 exactly once rounded
  let got = get(u, f)
  let twoRoundings = f.v * (u.max - u.min) + u.min
  assert got != twoRoundings
  assert float64(got) == 1.1920928955078125e-07'f64 + 2.8421709430404007e-14'f64

# PartialEq
let inner = LootCondition(kind: lcKilledByPlayer)
assert LootCondition(kind: lcInverted, inverted: @[inner]) == LootCondition(kind: lcInverted, inverted: @[inner])
assert not (LootCondition(kind: lcInverted, inverted: @[inner]) ==
            LootCondition(kind: lcInverted, inverted: @[LootCondition(kind: lcSurvivesExplosion)]))
assert not (inner == LootCondition(kind: lcSurvivesExplosion))
assert LootCondition(kind: lcRandomChance, chance: 0.5'f32) == LootCondition(kind: lcRandomChance, chance: 0.5'f32)
assert LootCondition(kind: lcTimeCheck, timeRange: (some(1.0'f32), none[float32]()), period: some(24000'u64)) ==
       LootCondition(kind: lcTimeCheck, timeRange: (some(1.0'f32), none[float32]()), period: some(24000'u64))
assert not (LootCondition(kind: lcTimeCheck, timeRange: (some(1.0'f32), none[float32]()), period: none[uint64]()) ==
            LootCondition(kind: lcTimeCheck, timeRange: (none[float32](), none[float32]()), period: none[uint64]()))
assert LootCondition(kind: lcBlockStateProperty, blockName: "b", properties: @[("age", "3")]) ==
       LootCondition(kind: lcBlockStateProperty, blockName: "b", properties: @[("age", "3")])
assert LootCondition(kind: lcMatchTool, items: some(@["a"])) == LootCondition(kind: lcMatchTool, items: some(@["a"]))
assert not (LootCondition(kind: lcMatchTool, items: some(@["a"])) == LootCondition(kind: lcMatchTool, items: none[seq[string]]()))

let setCount = LootFunctionTypes(kind: lftSetCount,
  setCount: LootFunctionNumberProvider(kind: lfnBinomial, n: 3.0'f32, p: 0.5'f32), add: true)
assert setCount == setCount
assert not (setCount == LootFunctionTypes(kind: lftFurnaceSmelt))
assert LootFunction(content: setCount, conditions: some(@[inner])) ==
       LootFunction(content: setCount, conditions: some(@[inner]))
assert not (LootFunction(content: setCount, conditions: some(@[inner])) ==
            LootFunction(content: setCount, conditions: none[seq[LootCondition]]()))

# a whole table holds together, recursive entries included
let leaf = LootPoolEntry(content: LootPoolEntryTypes(kind: lpeItem, item: ItemEntry(name: "minecraft:stick")),
  weight: 1, quality: 0, conditions: none[seq[LootCondition]](), functions: none[seq[LootFunction]]())
let group = LootPoolEntry(content: LootPoolEntryTypes(kind: lpeAlternatives, children: @[leaf, leaf]),
  weight: 2, quality: 1, conditions: some(@[inner]), functions: none[seq[LootFunction]]())
let pool = LootPool(entries: @[group], rolls: constantProvider(1.0'f32), bonusRolls: uniformProvider(0.0'f32, 1.0'f32),
  conditions: none[seq[LootCondition]](), functions: none[seq[LootFunction]]())
let table = LootTable(`type`: lttChest, randomSequence: some("minecraft:chests/x"), pools: some(@[pool]))
assert table.`type` == lttChest
assert table.pools.get()[0].entries[0].content.children[1].content.item == ItemEntry(name: "minecraft:stick")

# toTokens
assert toTokens(constantProvider(1.5'f32)) == "LootNumberProviderTypes(kind: lntConstant, constant: 1.5'f32)"
assert toTokens(uniformProvider(1.0'f32, 2.0'f32)) ==
  "LootNumberProviderTypes(kind: lntObject, provider: LootNumberProviderTypesProvider(kind: lnpUniform, uniform: UniformLootNumberProvider(min: 1.0'f32, max: 2.0'f32)))"

echo "loot_table checks passed"
