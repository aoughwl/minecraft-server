## Port of pumpkin-util/src/math/atomic_f32.rs
##
## Rust's `&self` with interior mutability is `var AtomicF32` here: keep it in a place you can mutate.
## `Ordering` is `MemoryOrder` from std/atomics, re-exported.

import std/atomics
export atomics.MemoryOrder

type
  AtomicF32* = object
    ## A thread-safe f32, stored as its u32 bits.
    storage: uint32

  CompareExchangeResult* = object
    ## `Result<f32, f32>`: `ok` with the previous value, or not `ok` with the current value.
    ok*: bool
    value*: float32

proc newAtomicF32*(value: float32): AtomicF32 =
  AtomicF32(storage: cast[uint32](value))

proc store*(self: var AtomicF32, value: float32, ordering: MemoryOrder) =
  atomicStore(self.storage, cast[uint32](value), ordering)

proc load*(self: var AtomicF32, ordering: MemoryOrder): float32 =
  cast[float32](atomicLoad(self.storage, ordering))

proc compareExchange*(self: var AtomicF32, current, new: float32,
    success, failure: MemoryOrder): CompareExchangeResult =
  ## Compares bits, not values: 0.0 does not match -0.0 and a NaN matches itself.
  var expected = cast[uint32](current)
  let ok = atomicCompareExchange(self.storage, expected, cast[uint32](new), success, failure)
  CompareExchangeResult(ok: ok, value: cast[float32](expected))
