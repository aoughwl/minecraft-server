## Known-answer tests for atomic_f32.aowl.
import std/[assertions, syncio, atomics, math]
import atomic_f32

proc main() =
  var a = newAtomicF32(1.5'f32)
  assert a.load(moSequentiallyConsistent) == 1.5'f32
  a.store(-2.25'f32, moRelease)
  assert a.load(moAcquire) == -2.25'f32

  let ok = a.compareExchange(-2.25'f32, 4.0'f32, moSequentiallyConsistent, moRelaxed)
  assert ok.ok and ok.value == -2.25'f32
  assert a.load(moRelaxed) == 4.0'f32

  let miss = a.compareExchange(9.0'f32, 5.0'f32, moSequentiallyConsistent, moRelaxed)
  assert not miss.ok and miss.value == 4.0'f32
  assert a.load(moRelaxed) == 4.0'f32

  # Bits decide: 0.0 and -0.0 are equal floats but do not match.
  var z = newAtomicF32(0.0'f32)
  let zero = z.compareExchange(-0.0'f32, 1.0'f32, moSequentiallyConsistent, moRelaxed)
  assert not zero.ok and z.load(moRelaxed) == 0.0'f32

  # And a NaN matches itself.
  let nan = float32(NaN)
  var n = newAtomicF32(nan)
  let same = n.compareExchange(nan, 1.0'f32, moSequentiallyConsistent, moRelaxed)
  assert same.ok and n.load(moRelaxed) == 1.0'f32

main()
echo "atomic_f32 checks passed"
