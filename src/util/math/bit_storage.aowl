## Port of pumpkin-util/src/math/bit_storage.rs
##
## `T: AsRef<[i64]>` becomes a plain `[T]` for anything indexable to int64 with a `len`: seq or array.

{.feature: "untyped".}

import std/assertions

type
  BitStorage*[T] = object
    data*: T
    bits: uint8
    size: int
    mask: uint64

proc newBitStorage*[T](bits: uint8, size: int, data: sink T): BitStorage[T] =
  let mask = (1'u64 shl int(bits)) - 1'u64
  BitStorage[T](data: data, bits: bits, size: size, mask: mask)

proc get*[T](self: BitStorage[T], index: int): uint32 =
  assert index < self.size
  let bitOffset = index * int(self.bits)
  let arrayIdx = bitOffset div 64
  let bitPos = bitOffset mod 64
  let val = cast[uint64](self.data[arrayIdx]) shr bitPos
  let nextIdx = arrayIdx + 1
  let res =
    if bitPos + int(self.bits) > 64 and nextIdx < self.data.len:
      val or (cast[uint64](self.data[nextIdx]) shl (64 - bitPos))
    else:
      val
  uint32(res and self.mask)

proc set*[T](self: var BitStorage[T], index: int, value: uint32) =
  assert index < self.size
  assert uint64(value) <= self.mask
  let bitOffset = index * int(self.bits)
  let arrayIdx = bitOffset div 64
  let bitPos = bitOffset mod 64
  self.data[arrayIdx] = cast[int64](
    (cast[uint64](self.data[arrayIdx]) and not (self.mask shl bitPos)) or
    ((uint64(value) and self.mask) shl bitPos))
  let nextIdx = arrayIdx + 1
  if bitPos + int(self.bits) > 64 and nextIdx < self.data.len:
    let nextBits = bitPos + int(self.bits) - 64
    self.data[nextIdx] = cast[int64](
      (cast[uint64](self.data[nextIdx]) and not ((1'u64 shl nextBits) - 1'u64)) or
      ((uint64(value) and self.mask) shr (64 - bitPos)))
