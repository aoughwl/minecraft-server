## Known-answer tests for bit_storage.aowl. Values span the i64 words, unlike vanilla's padded form.
import std/[assertions, syncio]
import bit_storage

proc testGetWithinWord() =
  # 4 bits each, low bits first: 0x...4321.
  let s = newBitStorage[seq[int64]](4'u8, 4, @[0x4321'i64])
  assert s.get(0) == 1'u32
  assert s.get(1) == 2'u32
  assert s.get(2) == 3'u32
  assert s.get(3) == 4'u32

proc testGetAcrossWord() =
  # 5 bits each. Index 12 starts at bit 60: 4 bits from the top of word 0 and 1 from word 1.
  # Word 0 top nibble 0xA (1010), word 1 low bit 1: value 0b1_1010 = 26.
  let s = newBitStorage[seq[int64]](5'u8, 25, @[cast[int64](0xA000_0000_0000_0000'u64), 1'i64])
  assert s.get(12) == 26'u32
  assert s.get(0) == 0'u32
  assert s.get(13) == 0'u32

proc testNegativeWordIsLogicalShift() =
  let s = newBitStorage[seq[int64]](4'u8, 16, @[-1'i64])
  for i in 0 ..< 16:
    assert s.get(i) == 15'u32

proc testSet() =
  var s = newBitStorage[seq[int64]](4'u8, 16, @[0'i64])
  s.set(0, 1'u32)
  s.set(3, 0xF'u32)
  assert s.data[0] == 0xF001'i64
  s.set(3, 0x2'u32)
  assert s.data[0] == 0x2001'i64
  s.set(15, 0x8'u32)
  assert s.data[0] == cast[int64](0x8000_0000_0000_2001'u64)
  assert s.get(15) == 8'u32

proc testSetAcrossWord() =
  var s = newBitStorage[seq[int64]](5'u8, 25, @[0'i64, 0'i64])
  s.set(12, 26'u32)
  assert s.data[0] == cast[int64](0xA000_0000_0000_0000'u64)
  assert s.data[1] == 1'i64
  assert s.get(12) == 26'u32
  # Overwriting clears only this entry's bits in both words.
  s.data[0] = cast[int64](s.data[0] or 0xFF'i64)
  s.data[1] = s.data[1] or 0xF0'i64
  s.set(12, 5'u32)
  assert s.data[0] == cast[int64](0x5000_0000_0000_00FF'u64)
  assert s.data[1] == 0xF0'i64

proc testLastWordEdge() =
  # Bits past the end of the data are dropped, not read.
  var s = newBitStorage[seq[int64]](5'u8, 13, @[0'i64])
  s.set(12, 31'u32)
  assert s.data[0] == cast[int64](0xF000_0000_0000_0000'u64)
  assert s.get(12) == 15'u32

proc testArray() =
  var s = newBitStorage[array[2, int64]](32'u8, 4, [0'i64, 0'i64])
  s.set(1, 0xFFFF_FFFF'u32)
  s.set(2, 7'u32)
  assert s.data[0] == cast[int64](0xFFFF_FFFF_0000_0000'u64)
  assert s.data[1] == 7'i64
  assert s.get(1) == 0xFFFF_FFFF'u32

proc testRoundTripEveryWidth() =
  for bits in 1 .. 32:
    let count = 200
    var s = newBitStorage[seq[int64]](uint8(bits), count, newSeq[int64]((count * bits + 63) div 64))
    let mask = (1'u64 shl bits) - 1'u64
    for i in 0 ..< count:
      s.set(i, uint32((uint64(i) * 2654435761'u64) and mask))
    for i in 0 ..< count:
      assert s.get(i) == uint32((uint64(i) * 2654435761'u64) and mask)

testGetWithinWord()
testGetAcrossWord()
testNegativeWordIsLogicalShift()
testSet()
testSetAcrossWord()
testLastWordEdge()
testArray()
testRoundTripEveryWidth()
echo "bit_storage checks passed"
