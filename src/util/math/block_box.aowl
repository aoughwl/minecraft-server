## Port of pumpkin-util/src/math/block_box.rs
##
## `rotated` takes any enum with `BlockDirection`'s ordinals (Down 0, Up 1, North 2, South 3, West 4, East 5),
## so util does not depend on src/data for src/data's copy of that enum.

{.feature: "untyped".}

import std/options
import position
import ../vector3
import ../../codecs/codec_core
import ../../codecs/list_codec

type
  BlockBox* = object
    ## An axis-aligned 3D box in integer coordinates, both corners inclusive.
    min*: Vector3[int32]
    max*: Vector3[int32]

proc newBlockBox*(minX, minY, minZ, maxX, maxY, maxZ: int32): BlockBox =
  BlockBox(
    min: Vector3[int32](x: minX, y: minY, z: minZ),
    max: Vector3[int32](x: maxX, y: maxY, z: maxZ))

proc createBox*(t: typedesc[BlockBox], x, y, z: int32, axis: Axis, width, height, depth: int32): BlockBox =
  if axis == axisZ:
    newBlockBox(x, y, z, x + width - 1'i32, y + height - 1'i32, z + depth - 1'i32)
  else:
    newBlockBox(x, y, z, x + depth - 1'i32, y + height - 1'i32, z + width - 1'i32)

proc rotated*[D: enum](t: typedesc[BlockBox], x, y, z, offsetX, offsetY, offsetZ, sizeX, sizeY, sizeZ: int32,
    facing: D): BlockBox =
  case ord(facing)
  of 2: # North
    newBlockBox(
      x + offsetX,
      y + offsetY,
      z - sizeZ + 1'i32 + offsetZ,
      x + sizeX - 1'i32 + offsetX,
      y + sizeY - 1'i32 + offsetY,
      z + offsetZ)
  of 4: # West
    newBlockBox(
      x - sizeZ + 1'i32 + offsetZ,
      y + offsetY,
      z + offsetX,
      x + offsetZ,
      y + sizeY - 1'i32 + offsetY,
      z + sizeX - 1'i32 + offsetX)
  of 5: # East
    newBlockBox(
      x + offsetZ,
      y + offsetY,
      z + offsetX,
      x + sizeZ - 1'i32 + offsetZ,
      y + sizeY - 1'i32 + offsetY,
      z + sizeX - 1'i32 + offsetX)
  else: # Default / South
    newBlockBox(
      x + offsetX,
      y + offsetY,
      z + offsetZ,
      x + sizeX - 1'i32 + offsetX,
      y + sizeY - 1'i32 + offsetY,
      z + sizeZ - 1'i32 + offsetZ)

proc fromPos*(t: typedesc[BlockBox], pos: BlockPos): BlockBox =
  BlockBox(min: pos.vec, max: pos.vec)

proc expand*(self: BlockBox, x, y, z: int32): BlockBox =
  BlockBox(
    min: Vector3[int32](x: self.min.x - x, y: self.min.y - y, z: self.min.z - z),
    max: Vector3[int32](x: self.max.x + x, y: self.max.y + y, z: self.max.z + z))

proc movePos*(self: var BlockBox, dx, dy, dz: int32) =
  self.min.x += dx
  self.min.y += dy
  self.min.z += dz
  self.max.x += dx
  self.max.y += dy
  self.max.z += dz

proc contains*(self: BlockBox, x, y, z: int32): bool =
  x >= self.min.x and x <= self.max.x and
    y >= self.min.y and y <= self.max.y and
    z >= self.min.z and z <= self.max.z

proc containsPos*(self: BlockBox, pos: Vector3[int32]): bool =
  contains(self, pos.x, pos.y, pos.z)

proc intersects*(self, other: BlockBox): bool =
  self.max.x >= other.min.x and self.min.x <= other.max.x and
    self.max.z >= other.min.z and self.min.z <= other.max.z and
    self.max.y >= other.min.y and self.min.y <= other.max.y

proc intersectsXz*(self, other: BlockBox): bool =
  self.max.x >= other.min.x and self.min.x <= other.max.x and
    self.max.z >= other.min.z and self.min.z <= other.max.z

proc intersectsRawXz*(self: BlockBox, minX, minZ, maxX, maxZ: int32): bool =
  self.max.x >= minX and self.min.x <= maxX and self.max.z >= minZ and self.min.z <= maxZ

proc getCenter*(self: BlockBox): Vector3[int32] =
  ## `get_center` (newer tree)
  vec3[int32](self.min.x + (self.max.x - self.min.x + 1) div 2, self.min.y + (self.max.y - self.min.y + 1) div 2,
    self.min.z + (self.max.z - self.min.z + 1) div 2)

proc getBlockCountY*(self: BlockBox): int32 =
  self.max.y - self.min.y + 1'i32

proc encompass*(self: var BlockBox, other: BlockBox) =
  self.min.x = min(self.min.x, other.min.x)
  self.min.y = min(self.min.y, other.min.y)
  self.min.z = min(self.min.z, other.min.z)
  self.max.x = max(self.max.x, other.max.x)
  self.max.y = max(self.max.y, other.max.y)
  self.max.z = max(self.max.z, other.max.z)

proc encompassAll*(boxes: openArray[BlockBox]): Option[BlockBox] =
  ## A box covering all `boxes`, or none when there are none.
  if boxes.len == 0:
    return none[BlockBox]()
  var res = boxes[0]
  for i in 1 ..< boxes.len:
    encompass(res, boxes[i])
  some(res)

# --- Encode and Decode: an IntStream ---------------------------------------------------------------

proc toIntStream*(value: BlockBox): IntStream =
  ## `From<&BlockBox> for IntStream`.
  intStream(@[value.min.x, value.min.y, value.min.z, value.max.x, value.max.y, value.max.z])

proc flatTryFrom*(target: typedesc[BlockBox], value: IntStream): DataResult[BlockBox] =
  let d = validateFixedSize(value.data, 6)
  if not d.hasResultOrPartial:
    return propagateError[seq[int32], BlockBox](d)
  let v = d.valueOrPartial
  flatMapJoin(d, newSuccess(newBlockBox(v[0], v[1], v[2], v[3], v[4], v[5])))

proc blockBoxFromIntStream(value: IntStream): DataResult[BlockBox] =
  flatTryFrom(BlockBox, value)

comapFlatMapCodecImpl(IntStream, BlockBox, blockBoxFromIntStream, toIntStream)
