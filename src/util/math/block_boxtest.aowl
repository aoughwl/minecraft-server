## Known-answer tests for block_box.aowl.
import std/[assertions, syncio, options]
import block_box
import position
import ../vector3
import ../../data/block_direction
import ../../codecs/codec_core
import ../../nbt/nbt_ops
import ../../nbt/tag

proc same(b: BlockBox, a0, a1, a2, a3, a4, a5: int32) =
  assert b.min == vec3[int32](a0, a1, a2) and b.max == vec3[int32](a3, a4, a5)

proc testConstruct() =
  same(newBlockBox(1, 2, 3, 4, 5, 6), 1, 2, 3, 4, 5, 6)
  same(BlockBox.createBox(1, 2, 3, axisZ, 10, 20, 30), 1, 2, 3, 10, 21, 32)
  same(BlockBox.createBox(1, 2, 3, axisX, 10, 20, 30), 1, 2, 3, 30, 21, 12)
  same(BlockBox.createBox(1, 2, 3, axisY, 10, 20, 30), 1, 2, 3, 30, 21, 12)
  same(BlockBox.fromPos(newBlockPos(7, 8, 9)), 7, 8, 9, 7, 8, 9)

proc testRotated() =
  # x=100 y=64 z=200, offsets 1 2 3, sizes 5 6 7, worked from the Rust match arms.
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.North),
    101, 66, 197, 105, 71, 203)
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.West),
    97, 66, 201, 103, 71, 205)
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.East),
    103, 66, 201, 109, 71, 205)
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.South),
    101, 66, 203, 105, 71, 209)
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.Up),
    101, 66, 203, 105, 71, 209)
  same(BlockBox.rotated(100, 64, 200, 1, 2, 3, 5, 6, 7, BlockDirection.Down),
    101, 66, 203, 105, 71, 209)

proc testGeometry() =
  let b = newBlockBox(0, 0, 0, 10, 10, 10)
  same(expand(b, 1, 2, 3), -1, -2, -3, 11, 12, 13)
  var m = b
  movePos(m, 1, -1, 2)
  same(m, 1, -1, 2, 11, 9, 12)
  assert contains(b, 0, 0, 0) and contains(b, 10, 10, 10)
  assert not contains(b, 11, 0, 0) and not contains(b, 0, -1, 0) and not contains(b, 0, 0, 11)
  assert containsPos(b, vec3[int32](5, 5, 5)) and not containsPos(b, vec3[int32](5, 5, -5))
  assert intersects(b, newBlockBox(10, 10, 10, 20, 20, 20))
  assert not intersects(b, newBlockBox(11, 0, 0, 20, 10, 10))
  assert not intersects(b, newBlockBox(0, 11, 0, 10, 20, 10))
  assert intersectsXz(b, newBlockBox(0, 50, 0, 1, 60, 1))
  assert not intersectsXz(b, newBlockBox(0, 0, 11, 1, 1, 12))
  assert intersectsRawXz(b, 10, 10, 20, 20)
  assert not intersectsRawXz(b, 11, 0, 20, 20)
  assert getBlockCountY(b) == 11
  assert getBlockCountY(newBlockBox(0, -64, 0, 0, 319, 0)) == 384

proc testEncompass() =
  var e = newBlockBox(0, 0, 0, 1, 1, 1)
  encompass(e, newBlockBox(-1, 5, 0, 0, 6, 9))
  same(e, -1, 0, 0, 1, 6, 9)
  let none0: seq[BlockBox] = @[]
  assert encompassAll(none0).isNone
  let one = encompassAll([newBlockBox(1, 1, 1, 2, 2, 2)])
  same(one.get, 1, 1, 1, 2, 2, 2)
  let all = encompassAll([newBlockBox(1, 1, 1, 2, 2, 2), newBlockBox(-5, 0, 3, -4, 9, 3), newBlockBox(0, 0, 0, 0, 0, 7)])
  same(all.get, -5, 0, 0, 2, 9, 7)

proc testCodec() =
  let ops = nbtOps()
  let tag = NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, -2'i32, 3'i32, 4'i32, 5'i32, -6'i32])
  assertEncodeSuccess(newBlockBox(1, -2, 3, 4, 5, -6), ops, tag)
  let d = parse(BlockBox, tag, ops)
  assert d.isSuccess
  same(d.successResult, 1, -2, 3, 4, 5, -6)
  assertDecodeIsError(BlockBox, NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32, 3'i32]), ops)
  assertDecodeIsError(BlockBox, NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32, 3'i32, 4'i32, 5'i32, 6'i32, 7'i32]), ops)
  let short = flatTryFrom(BlockBox, intStream(@[1'i32]))
  assert short.isError and short.message == "Input is not a list of 6 elements"

testConstruct()
testRotated()
testGeometry()
testEncompass()
testCodec()
echo "block_box checks passed"
