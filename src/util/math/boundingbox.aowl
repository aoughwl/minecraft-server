## Port of pumpkin-util/src/math/boundingbox.rs

import std/options
from mathmod import squaredMagnitude
import position
import rustnum
import ../vector2
import ../vector3

type
  BoundingBox* = object
    ## An axis-aligned bounding box in 3D space.
    min*: Vector3[float64]
    max*: Vector3[float64]

  BoundingPlane = object
    ## A 2D bounding plane used for collision checks.
    min: Vector2[float64]
    max: Vector2[float64]

  EntityDimensions* = object
    width*: float32
    height*: float32
    eyeHeight*: float32 ## relative to the bottom of the entity

proc newEntityDimensions*(width, height, eyeHeight: float32): EntityDimensions =
  EntityDimensions(width: width, height: height, eyeHeight: eyeHeight)

proc getSide*(self: BoundingBox, max: bool): Vector3[float64] =
  if max: self.max else: self.min

proc intersects(self, other: BoundingPlane): bool =
  self.min.x < other.max.x and self.max.x > other.min.x and
    self.min.y < other.max.y and self.max.y > other.min.y

proc fromBox(boundingBox: BoundingBox, excluded: Axis): BoundingPlane =
  ## Projects a box onto a 2D plane by excluding one axis.
  let axes = axisExcluding(excluded)
  let axis1 = axes[0]
  let axis2 = axes[1]
  BoundingPlane(
    min: Vector2[float64](x: getAxis(getSide(boundingBox, false), axis1), y: getAxis(getSide(boundingBox, false), axis2)),
    max: Vector2[float64](x: getAxis(getSide(boundingBox, true), axis1), y: getAxis(getSide(boundingBox, true), axis2)))

proc newBoundingBox*(min, max: Vector3[float64]): BoundingBox =
  BoundingBox(min: min, max: max)

proc newFromPos*(t: typedesc[BoundingBox], x, y, z: float64, size: EntityDimensions): BoundingBox =
  let f = float64(size.width) / 2.0
  BoundingBox(
    min: Vector3[float64](x: x - f, y: y, z: z - f),
    max: Vector3[float64](x: x + f, y: y + float64(size.height), z: z + f))

proc newDefault*(t: typedesc[BoundingBox], size: EntityDimensions): BoundingBox =
  BoundingBox.newFromPos(0.0, 0.0, 0.0, size)

proc expand*(self: BoundingBox, x, y, z: float64): BoundingBox =
  BoundingBox(
    min: Vector3[float64](x: self.min.x - x, y: self.min.y - y, z: self.min.z - z),
    max: Vector3[float64](x: self.max.x + x, y: self.max.y + y, z: self.max.z + z))

proc expandTowards*(self: BoundingBox, x, y, z: float64): BoundingBox =
  ## A negative value extends the minimum boundary on that axis, a positive one the maximum.
  var minX = self.min.x
  var minY = self.min.y
  var minZ = self.min.z
  var maxX = self.max.x
  var maxY = self.max.y
  var maxZ = self.max.z
  if x < 0.0:
    minX += x
  elif x > 0.0:
    maxX += x
  if y < 0.0:
    minY += y
  elif y > 0.0:
    maxY += y
  if z < 0.0:
    minZ += z
  elif z > 0.0:
    maxZ += z
  BoundingBox(
    min: Vector3[float64](x: minX, y: minY, z: minZ),
    max: Vector3[float64](x: maxX, y: maxY, z: maxZ))

proc expandAll*(self: BoundingBox, value: float64): BoundingBox =
  expand(self, value, value, value)

proc contractAll*(self: BoundingBox, value: float64): BoundingBox =
  expandAll(self, -value)

proc atPos*(self: BoundingBox, pos: BlockPos): BoundingBox =
  let v = Vector3[float64](x: float64(pos.vec.x), y: float64(pos.vec.y), z: float64(pos.vec.z))
  BoundingBox(min: self.min + v, max: self.max + v)

proc offset*(self, other: BoundingBox): BoundingBox =
  BoundingBox(min: add(self.min, other.min), max: add(self.max, other.max))

proc newArray*(t: typedesc[BoundingBox], min, max: array[3, float64]): BoundingBox =
  BoundingBox(
    min: Vector3[float64](x: min[0], y: min[1], z: min[2]),
    max: Vector3[float64](x: max[0], y: max[1], z: max[2]))

proc fullBlock*(t: typedesc[BoundingBox]): BoundingBox =
  BoundingBox(
    min: Vector3[float64](x: 0.0, y: 0.0, z: 0.0),
    max: Vector3[float64](x: 1.0, y: 1.0, z: 1.0))

proc fromBlock*(t: typedesc[BoundingBox], position: BlockPos): BoundingBox =
  let p = position.vec
  BoundingBox(
    min: Vector3[float64](x: float64(p.x), y: float64(p.y), z: float64(p.z)),
    max: Vector3[float64](x: float64(p.x) + 1.0, y: float64(p.y) + 1.0, z: float64(p.z) + 1.0))

proc shift*(self: BoundingBox, delta: Vector3[float64]): BoundingBox =
  BoundingBox(min: self.min + delta, max: self.max + delta)

proc calculateCollisionTime*(self, other: BoundingBox, movement: Vector3[float64], axis: Axis,
    maxTime: float64): Option[float64] =
  ## The time this box, moving by `movement`, hits `other` along `axis`, within `maxTime` (start with 1.0).
  let movementOnAxis = getAxis(movement, axis)
  if movementOnAxis == 0.0:
    return none[float64]()
  let movePositive = isSignPositive(movementOnAxis)
  let selfPlaneConst = getAxis(getSide(self, movePositive), axis)
  let otherPlaneConst = getAxis(getSide(other, not movePositive), axis)
  let collisionTime = (otherPlaneConst - selfPlaneConst) / movementOnAxis
  if collisionTime < 0.0 or collisionTime >= maxTime:
    return none[float64]()
  let selfMoved = shift(self, movement * collisionTime)
  let selfPlaneMoved = fromBox(selfMoved, axis)
  let otherPlane = fromBox(other, axis)
  if not intersects(selfPlaneMoved, otherPlane):
    return none[float64]()
  some(collisionTime)

proc getAverageSideLength*(self: BoundingBox): float64 =
  let width = self.max.x - self.min.x
  let height = self.max.y - self.min.y
  let depth = self.max.z - self.min.z
  (width + height + depth) / 3.0

proc minBlockPos*(self: BoundingBox): BlockPos =
  flooredV(self.min)

proc maxBlockPos*(self: BoundingBox): BlockPos =
  ## The epsilon keeps a box whose max sits on a block boundary out of the adjacent block.
  let eps = 1e-9'f64
  flooredV(Vector3[float64](x: self.max.x - eps, y: self.max.y - eps, z: self.max.z - eps))

proc stretch*(self: BoundingBox, other: Vector3[float64]): BoundingBox =
  result = self
  if other.x < 0.0:
    result.min.x += other.x
  elif other.x > 0.0:
    result.max.x += other.x
  if other.y < 0.0:
    result.min.y += other.y
  elif other.y > 0.0:
    result.max.y += other.y
  if other.z < 0.0:
    result.min.z += other.z
  elif other.z > 0.0:
    result.max.z += other.z

proc fromBlockRaw*(t: typedesc[BoundingBox], position: BlockPos): BoundingBox =
  ## A zero-volume box at a block position.
  let p = position.vec
  BoundingBox(
    min: Vector3[float64](x: float64(p.x), y: float64(p.y), z: float64(p.z)),
    max: Vector3[float64](x: float64(p.x), y: float64(p.y), z: float64(p.z)))

proc intersects*(self, other: BoundingBox): bool =
  self.min.x < other.max.x and self.max.x > other.min.x and
    self.min.y < other.max.y and self.max.y > other.min.y and
    self.min.z < other.max.z and self.max.z > other.min.z

proc squaredMagnitude*(self: BoundingBox, pos: Vector3[float64]): float64 =
  ## From a point to the nearest point on this box.
  let d = maxF64(maxF64(self.min.x - pos.x, pos.x - self.max.x), 0.0)
  let e = maxF64(maxF64(self.min.y - pos.y, pos.y - self.max.y), 0.0)
  let f = maxF64(maxF64(self.min.z - pos.z, pos.z - self.max.z), 0.0)
  squaredMagnitude(d, e, f)
