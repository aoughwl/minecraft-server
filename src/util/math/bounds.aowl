## Port of pumpkin-util/src/math/bounds.rs

import std/options

type
  Bounds*[T] = object
    ## A single range bound of some type, whose ends may be absent.
    min*: Option[T]
    max*: Option[T]

  IntBounds* = object
    ## A range of integers, storing both the bounds and their squares.
    bounds*: Bounds[int32]
    squaredBounds*: Bounds[int64]

  DoubleBounds* = object
    ## A range of f64s, storing both the bounds and their squares.
    bounds*: Bounds[float64]
    squaredBounds*: Bounds[float64]

  FloatDegreeBounds* = object
    ## A range of degrees, stored as f32s.
    bounds*: Bounds[float32]

proc newBounds*[T](min, max: Option[T]): Bounds[T] =
  Bounds[T](min: min, max: max)

proc areSwapped*(self: Bounds[int32]): bool =
  self.min.isSome and self.max.isSome and self.min.get > self.max.get

proc areSwapped*(self: Bounds[int64]): bool =
  self.min.isSome and self.max.isSome and self.min.get > self.max.get

proc areSwapped*(self: Bounds[float32]): bool =
  self.min.isSome and self.max.isSome and self.min.get > self.max.get

proc areSwapped*(self: Bounds[float64]): bool =
  self.min.isSome and self.max.isSome and self.min.get > self.max.get

proc square(m: Option[int32]): Option[int64] =
  if m.isSome: some(int64(m.get) * int64(m.get)) else: none[int64]()

proc square(m: Option[float64]): Option[float64] =
  if m.isSome: some(m.get * m.get) else: none[float64]()

# --- IntBounds --------------------------------------------------------------------------------------

proc fromBounds*(bounds: Bounds[int32]): IntBounds =
  IntBounds(bounds: bounds, squaredBounds: Bounds[int64](min: square(bounds.min), max: square(bounds.max)))

proc newIntBounds*(min, max: int32): IntBounds =
  fromBounds(Bounds[int32](min: some(min), max: some(max)))

proc newAtLeast*(min: int32): IntBounds =
  fromBounds(Bounds[int32](min: some(min), max: none[int32]()))

proc newAtMost*(max: int32): IntBounds =
  fromBounds(Bounds[int32](min: none[int32](), max: some(max)))

proc matches*(self: IntBounds, number: int32): bool =
  (self.bounds.min.isNone or self.bounds.min.get <= number) and
    (self.bounds.max.isNone or self.bounds.max.get >= number)

proc matchesSquare*(self: IntBounds, number: int64): bool =
  (self.squaredBounds.min.isNone or self.squaredBounds.min.get <= number) and
    (self.squaredBounds.max.isNone or self.squaredBounds.max.get >= number)

proc min*(self: IntBounds): Option[int32] {.inline.} = self.bounds.min
proc max*(self: IntBounds): Option[int32] {.inline.} = self.bounds.max

# --- DoubleBounds -----------------------------------------------------------------------------------

proc fromBounds*(bounds: Bounds[float64]): DoubleBounds =
  DoubleBounds(bounds: bounds, squaredBounds: Bounds[float64](min: square(bounds.min), max: square(bounds.max)))

proc newDoubleBounds*(min, max: float64): DoubleBounds =
  fromBounds(Bounds[float64](min: some(min), max: some(max)))

proc newAtLeast*(min: float64): DoubleBounds =
  fromBounds(Bounds[float64](min: some(min), max: none[float64]()))

proc newAtMost*(max: float64): DoubleBounds =
  fromBounds(Bounds[float64](min: none[float64](), max: some(max)))

proc matches*(self: DoubleBounds, number: float64): bool =
  (self.bounds.min.isNone or self.bounds.min.get <= number) and
    (self.bounds.max.isNone or self.bounds.max.get >= number)

proc matchesSquare*(self: DoubleBounds, number: float64): bool =
  (self.squaredBounds.min.isNone or self.squaredBounds.min.get <= number) and
    (self.squaredBounds.max.isNone or self.squaredBounds.max.get >= number)

proc min*(self: DoubleBounds): Option[float64] {.inline.} = self.bounds.min
proc max*(self: DoubleBounds): Option[float64] {.inline.} = self.bounds.max

# --- FloatDegreeBounds ------------------------------------------------------------------------------

proc fromBounds*(bounds: Bounds[float32]): FloatDegreeBounds =
  FloatDegreeBounds(bounds: bounds)

proc min*(self: FloatDegreeBounds): Option[float32] {.inline.} = self.bounds.min
proc max*(self: FloatDegreeBounds): Option[float32] {.inline.} = self.bounds.max
