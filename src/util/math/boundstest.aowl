## Known-answer tests for bounds.aowl.
import std/[assertions, syncio, options, math]
import bounds

proc testSwapped() =
  assert areSwapped(newBounds(some(5'i32), some(1'i32)))
  assert not areSwapped(newBounds(some(1'i32), some(5'i32)))
  assert not areSwapped(newBounds(some(1'i32), some(1'i32)))
  assert not areSwapped(newBounds(none[int32](), some(1'i32)))
  assert not areSwapped(newBounds(some(1'i32), none[int32]()))
  assert areSwapped(newBounds(some(2.0'f64), some(1.0'f64)))
  assert not areSwapped(newBounds(some(NaN), some(1.0'f64)))

proc testInt() =
  let b = newIntBounds(-3, 4)
  assert b.min.get == -3 and b.max.get == 4
  assert b.squaredBounds.min.get == 9'i64 and b.squaredBounds.max.get == 16'i64
  assert matches(b, -3) and matches(b, 4) and matches(b, 0)
  assert not matches(b, -4) and not matches(b, 5)
  assert matchesSquare(b, 9'i64) and matchesSquare(b, 16'i64)
  assert not matchesSquare(b, 8'i64) and not matchesSquare(b, 17'i64)
  let l = newAtLeast(2'i32)
  assert l.min.get == 2 and l.max.isNone
  assert matches(l, 2) and matches(l, int32.high) and not matches(l, 1)
  assert matchesSquare(l, 4'i64) and not matchesSquare(l, 3'i64)
  let m = newAtMost(2'i32)
  assert m.min.isNone and m.max.get == 2
  assert matches(m, int32.low) and matches(m, 2) and not matches(m, 3)
  # The square is computed in i64, so i32::MIN does not overflow.
  assert newAtLeast(int32.low).squaredBounds.min.get == 4611686018427387904'i64

proc testDouble() =
  let b = newDoubleBounds(1.5, 2.5)
  assert b.min.get == 1.5 and b.max.get == 2.5
  assert b.squaredBounds.min.get == 2.25 and b.squaredBounds.max.get == 6.25
  assert matches(b, 1.5) and matches(b, 2.5) and not matches(b, 1.0) and not matches(b, 3.0)
  assert not matches(b, NaN)
  assert matchesSquare(b, 2.25) and not matchesSquare(b, 2.0) and not matchesSquare(b, 6.5)
  let l = newAtLeast(1.0'f64)
  assert matches(l, 100.0) and not matches(l, 0.5) and not matches(l, NaN)
  let m = newAtMost(1.0'f64)
  assert matches(m, -100.0) and not matches(m, 1.5)

proc testDegrees() =
  let f = fromBounds(newBounds(some(10.0'f32), none[float32]()))
  assert f.min.get == 10.0'f32 and f.max.isNone

testSwapped()
testInt()
testDouble()
testDegrees()
echo "bounds checks passed"
