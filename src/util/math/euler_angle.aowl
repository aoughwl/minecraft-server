## Port of pumpkin-util/src/math/euler_angle.rs

{.feature: "untyped".}

import std/math
import serdeforms
import ../../codecs/codec_core
import ../../codecs/json_value
import ../../codecs/list_codec
import ../../nbt/tag

type
  EulerAngle* = object
    ## A 3D rotation in degrees.
    pitch*: float32 ## around the X axis
    yaw*: float32   ## around the Y axis
    roll*: float32  ## around the Z axis

const EulerAngleZero* = EulerAngle(pitch: 0.0'f32, yaw: 0.0'f32, roll: 0.0'f32)

proc newEulerAngle*(pitch, yaw, roll: float32): EulerAngle =
  ## `%` keeps the dividend's sign, so the result is in (-360, 360).
  EulerAngle(pitch: pitch mod 360.0'f32, yaw: yaw mod 360.0'f32, roll: roll mod 360.0'f32)

proc `==`*(a, b: EulerAngle): bool {.inline.} =
  a.pitch == b.pitch and a.yaw == b.yaw and a.roll == b.roll

proc toNbtTag*(val: EulerAngle): NbtTag =
  ## `From<EulerAngle> for NbtTag`: a list of three floats.
  NbtTag(kind: ntkList, listVal: @[
    NbtTag(kind: ntkFloat, floatVal: val.pitch),
    NbtTag(kind: ntkFloat, floatVal: val.yaw),
    NbtTag(kind: ntkFloat, floatVal: val.roll)])

proc floatOrZero(tag: NbtTag): float32 =
  if tag.kind == ntkFloat: tag.floatVal else: 0.0'f32

proc fromNbtTag*(tag: NbtTag): EulerAngle =
  ## `From<NbtTag> for EulerAngle`: anything but a three-element list is zero.
  if tag.kind == ntkList and tag.listVal.len == 3:
    return newEulerAngle(floatOrZero(tag.listVal[0]), floatOrZero(tag.listVal[1]), floatOrZero(tag.listVal[2]))
  EulerAngleZero

proc toSeq*(value: EulerAngle): seq[float32] =
  ## `From<&EulerAngle> for Vec<f32>`.
  @[value.pitch, value.yaw, value.roll]

proc flatTryFrom*(target: typedesc[EulerAngle], value: seq[float32]): DataResult[EulerAngle] =
  ## No normalizing here, unlike `newEulerAngle`.
  let d = validateFixedSize(value, 3)
  if not d.hasResultOrPartial:
    return propagateError[seq[float32], EulerAngle](d)
  let v = d.valueOrPartial
  flatMapJoin(d, newSuccess(EulerAngle(pitch: v[0], yaw: v[1], roll: v[2])))

proc eulerAngleFromSeq(value: seq[float32]): DataResult[EulerAngle] =
  flatTryFrom(EulerAngle, value)

comapFlatMapCodecImpl(seq[float32], EulerAngle, eulerAngleFromSeq, toSeq)

# --- serde: a derived struct ------------------------------------------------------------------------

proc toJson*(self: EulerAngle): JsonValue =
  result = jsonObject()
  result.put("pitch", jsonF32(self.pitch))
  result.put("yaw", jsonF32(self.yaw))
  result.put("roll", jsonF32(self.roll))

proc fromJson*(t: typedesc[EulerAngle], j: JsonValue): SerdeResult[EulerAngle] =
  ## A derived Deserialize fills the fields directly: no normalizing.
  if j.kind != jvObject:
    return serdeErr[EulerAngle](invalidType(j, "struct EulerAngle"))
  let pitch = fieldF32(j, "pitch")
  serdeCheck(pitch, EulerAngle)
  let yaw = fieldF32(j, "yaw")
  serdeCheck(yaw, EulerAngle)
  let roll = fieldF32(j, "roll")
  serdeCheck(roll, EulerAngle)
  serdeOk(EulerAngle(pitch: pitch.value, yaw: yaw.value, roll: roll.value))

proc toNbt*(self: EulerAngle): NbtTag =
  ## The derived Serialize through pumpkin-nbt: a compound.
  var c = newCompound()
  c.put("pitch", NbtTag(kind: ntkFloat, floatVal: self.pitch))
  c.put("yaw", NbtTag(kind: ntkFloat, floatVal: self.yaw))
  c.put("roll", NbtTag(kind: ntkFloat, floatVal: self.roll))
  NbtTag(kind: ntkCompound, compoundVal: c)

proc nbtField(c: NbtCompound, name: string): SerdeResult[float32] =
  let (found, tag) = get(c, name)
  if not found: serdeErr[float32]("missing field `" & name & "`")
  else: nbtReadF32(tag)

proc fromNbt*(t: typedesc[EulerAngle], tag: NbtTag): SerdeResult[EulerAngle] =
  if tag.kind != ntkCompound:
    return serdeErr[EulerAngle]("invalid type: expected struct EulerAngle")
  let pitch = nbtField(tag.compoundVal, "pitch")
  serdeCheck(pitch, EulerAngle)
  let yaw = nbtField(tag.compoundVal, "yaw")
  serdeCheck(yaw, EulerAngle)
  let roll = nbtField(tag.compoundVal, "roll")
  serdeCheck(roll, EulerAngle)
  serdeOk(EulerAngle(pitch: pitch.value, yaw: yaw.value, roll: roll.value))
