## Known-answer tests for euler_angle.aowl.
import std/[assertions, syncio]
import euler_angle
import serdeforms
import ../../codecs/codec_core
import ../../codecs/json_ops
import ../../codecs/json_value
import ../../nbt/tag

proc parse(text: string): JsonValue =
  let r = parseJsonValue(text)
  assert r.ok
  r.value

proc f(x: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: x)

proc testNew() =
  let a = newEulerAngle(370.0'f32, -370.0'f32, 720.0'f32)
  assert a.pitch == 10.0'f32 and a.yaw == -10.0'f32 and a.roll == 0.0'f32
  let b = newEulerAngle(359.5'f32, 360.0'f32, -0.5'f32)
  assert b.pitch == 359.5'f32 and b.yaw == 0.0'f32 and b.roll == -0.5'f32
  assert EulerAngleZero == EulerAngle(pitch: 0.0'f32, yaw: 0.0'f32, roll: 0.0'f32)
  assert default(EulerAngle) == EulerAngleZero

proc testNbtTagForm() =
  let t = toNbtTag(EulerAngle(pitch: 1.0'f32, yaw: 2.0'f32, roll: 3.0'f32))
  assert t.kind == ntkList and t.listVal.len == 3
  assert t.listVal[0].kind == ntkFloat and t.listVal[0].floatVal == 1.0'f32
  assert t.listVal[2].floatVal == 3.0'f32
  # The From impl goes through `new`, so it normalizes.
  assert fromNbtTag(NbtTag(kind: ntkList, listVal: @[f(370.0'f32), f(2.0'f32), f(-3.0'f32)])) ==
    EulerAngle(pitch: 10.0'f32, yaw: 2.0'f32, roll: -3.0'f32)
  # A non-float element reads as zero.
  assert fromNbtTag(NbtTag(kind: ntkList, listVal: @[f(1.0'f32), NbtTag(kind: ntkInt, intVal: 5'i32), f(3.0'f32)])) ==
    EulerAngle(pitch: 1.0'f32, yaw: 0.0'f32, roll: 3.0'f32)
  assert fromNbtTag(NbtTag(kind: ntkList, listVal: @[f(1.0'f32)])) == EulerAngleZero
  assert fromNbtTag(NbtTag(kind: ntkInt, intVal: 5'i32)) == EulerAngleZero
  let s = toSeq(EulerAngle(pitch: 1.0'f32, yaw: 2.0'f32, roll: 3.0'f32))
  assert s.len == 3 and s[0] == 1.0'f32 and s[1] == 2.0'f32 and s[2] == 3.0'f32

proc testSerde() =
  assert toJsonString(toJson(EulerAngle(pitch: 1.5'f32, yaw: -2.0'f32, roll: 0.25'f32))) ==
    "{\"pitch\":1.5,\"roll\":0.25,\"yaw\":-2.0}"
  let r = fromJson(EulerAngle, parse("{\"pitch\":370,\"yaw\":2.5,\"roll\":-1,\"extra\":true}"))
  assert r.ok and r.value == EulerAngle(pitch: 370.0'f32, yaw: 2.5'f32, roll: -1.0'f32)
  let missing = fromJson(EulerAngle, parse("{\"pitch\":1,\"yaw\":2}"))
  assert not missing.ok and missing.error == "missing field `roll`"
  assert fromJson(EulerAngle, parse("[1,2,3]")).error == "invalid type: sequence, expected struct EulerAngle"
  assert fromJson(EulerAngle, parse("{\"pitch\":\"x\",\"yaw\":2,\"roll\":3}")).error ==
    "invalid type: string \"x\", expected f32"
  let n = toNbt(EulerAngle(pitch: 1.0'f32, yaw: 2.0'f32, roll: 3.0'f32))
  assert n.kind == ntkCompound and n.compoundVal.names.len == 3
  let back = fromNbt(EulerAngle, n)
  assert back.ok and back.value == EulerAngle(pitch: 1.0'f32, yaw: 2.0'f32, roll: 3.0'f32)
  assert not fromNbt(EulerAngle, f(1.0'f32)).ok

proc testCodec() =
  let ops = jsonOps()
  assertEncodeSuccess(EulerAngle(pitch: 1.5'f32, yaw: -2.0'f32, roll: 0.25'f32), ops, parse("[1.5,-2.0,0.25]"))
  # Decoding fills the fields directly, so 370 stays 370.
  let d = parse(EulerAngle, parse("[370,2.5,-1]"), ops)
  assert d.isSuccess and d.successResult == EulerAngle(pitch: 370.0'f32, yaw: 2.5'f32, roll: -1.0'f32)
  assertDecodeIsError(EulerAngle, parse("[1,2]"), ops)
  assertDecodeIsError(EulerAngle, parse("[1,2,3,4]"), ops)
  assert flatTryFrom(EulerAngle, @[1.0'f32]).message == "Input is not a list of 3 elements"

testNew()
testNbtTagForm()
testSerde()
testCodec()
echo "euler_angle checks passed"
