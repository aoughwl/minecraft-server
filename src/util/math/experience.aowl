## Port of pumpkin-util/src/math/experience.rs
## PARTIAL: pumpkin-util/src/math/experience.rs - no toNbt/fromNbt: `Experience` is only read from JSON data, so no caller needs an NBT form. The `codegen`-feature ToTokens impl emits Rust source and has no counterpart.

import std/math
import int_provider
import rustnum
import serdeforms
import ../../codecs/json_value

type
  Experience* = object
    experience*: IntProvider ## the experience points

proc toJson*(self: Experience): JsonValue =
  result = jsonObject()
  result.put("experience", toJson(self.experience))

proc fromJson*(t: typedesc[Experience], j: JsonValue): SerdeResult[Experience] =
  if j.kind != jvObject:
    return serdeErr[Experience](invalidType(j, "struct Experience"))
  let i = find(j, "experience")
  if i < 0:
    return serdeErr[Experience]("missing field `experience`")
  let provider = fromJson(IntProvider, j.vals[i])
  serdeCheck(provider, Experience)
  serdeOk(Experience(experience: provider.value))

proc pointsInLevel*(level: int32): int32 =
  ## The points needed to progress within a level.
  if level >= 0'i32 and level <= 15'i32:
    2'i32 * level + 7'i32
  elif level >= 16'i32 and level <= 30'i32:
    5'i32 * level - 38'i32
  else:
    9'i32 * level - 158'i32

proc pointsToLevel*(level: int32): int32 =
  ## The total points needed to reach a level.
  if level >= 0'i32 and level <= 16'i32:
    level * level + 6'i32 * level
  elif level >= 17'i32 and level <= 31'i32:
    asI32(mulAdd(2.5'f64, float64(level * level), -(40.5'f64 * float64(level))) + 360.0'f64)
  else:
    asI32(mulAdd(4.5'f64, float64(level * level), -(162.5'f64 * float64(level))) + 2220.0'f64)

proc totalToLevelAndPoints*(totalPoints: int32): (int32, int32) =
  ## Total points as (level, points into that level).
  let level =
    if totalPoints >= 0'i32 and totalPoints <= 352'i32:
      asI32(sqrt(float64(totalPoints) + 9.0'f64) - 3.0'f64)
    elif totalPoints >= 353'i32 and totalPoints <= 1507'i32:
      asI32(8.1'f64 + sqrt(0.4'f64 * (float64(totalPoints) - (7839.0'f64 / 40.0'f64))))
    else:
      asI32((325.0'f64 / 18.0'f64) + sqrt(2.0'f64 / 9.0'f64 * (float64(totalPoints) - (54215.0'f64 / 72.0'f64))))
  let levelStart = pointsToLevel(level)
  let pointsIntoLevel = totalPoints - levelStart
  (level, pointsIntoLevel)

proc progressInLevel*(points, level: int32): float32 =
  ## Progress within a level, from 0.0 to 1.0.
  let maxPoints = pointsInLevel(level)
  let progress = float32(points) / float32(maxPoints)
  clamp(progress, 0.0'f32, 1.0'f32)
