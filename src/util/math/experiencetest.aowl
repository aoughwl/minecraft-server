## Known-answer tests for experience.aowl. Expected values are worked from the Rust formulas.
import std/[assertions, syncio]
import experience
import int_provider
import serdeforms
import ../../codecs/json_value

proc parse(text: string): JsonValue =
  let r = parseJsonValue(text)
  assert r.ok
  r.value

proc testPointsInLevel() =
  assert pointsInLevel(0) == 7
  assert pointsInLevel(15) == 37
  assert pointsInLevel(16) == 42
  assert pointsInLevel(30) == 112
  assert pointsInLevel(31) == 121
  assert pointsInLevel(100) == 742
  assert pointsInLevel(-1) == -167

proc testPointsToLevel() =
  assert pointsToLevel(0) == 0
  assert pointsToLevel(1) == 7
  assert pointsToLevel(15) == 315
  assert pointsToLevel(16) == 352
  assert pointsToLevel(17) == 394
  assert pointsToLevel(30) == 1395
  assert pointsToLevel(31) == 1507
  assert pointsToLevel(32) == 1628
  assert pointsToLevel(33) == 1758
  assert pointsToLevel(100) == 30970
  assert pointsToLevel(-1) == 2387

proc checkTotal(total, level, points: int32) =
  let r = totalToLevelAndPoints(total)
  assert r[0] == level and r[1] == points, $total & " gave " & $r[0] & ", " & $r[1]

proc testTotal() =
  checkTotal(0, 0, 0)
  checkTotal(6, 0, 6)
  checkTotal(7, 1, 0)
  checkTotal(351, 15, 36)
  checkTotal(352, 16, 0)
  checkTotal(353, 16, 1)
  checkTotal(393, 16, 41)
  checkTotal(394, 17, 0)
  checkTotal(1506, 30, 111)
  checkTotal(1507, 31, 0)
  checkTotal(1508, 31, 1)
  checkTotal(1627, 31, 120)
  checkTotal(1628, 32, 0)
  checkTotal(2000, 34, 103)
  checkTotal(100000, 166, 753)
  # Negative totals take the last arm: the sqrt is NaN, which `as i32` makes level 0.
  checkTotal(-5, 0, -5)

proc testProgress() =
  assert progressInLevel(0, 0) == 0.0'f32
  assert progressInLevel(7, 0) == 1.0'f32
  assert progressInLevel(21, 16) == 0.5'f32
  assert progressInLevel(100, 0) == 1.0'f32
  assert progressInLevel(-1, 0) == 0.0'f32

proc testSerde() =
  let bare = fromJson(Experience, parse("{\"experience\":5}"))
  assert bare.ok and bare.value.experience.kind == ipConstant and bare.value.experience.value == 5
  let obj = fromJson(Experience, parse(
    "{\"experience\":{\"type\":\"minecraft:uniform\",\"min_inclusive\":2,\"max_inclusive\":5}}"))
  assert obj.ok and getMin(obj.value.experience) == 2 and getMax(obj.value.experience) == 5
  assert toJsonString(toJson(bare.value)) == "{\"experience\":5}"
  assert fromJson(Experience, parse("{}")).error == "missing field `experience`"
  assert fromJson(Experience, parse("{\"experience\":\"x\"}")).error ==
    "data did not match any variant of untagged enum IntProvider"

testPointsInLevel()
testPointsToLevel()
testTotal()
testProgress()
testSerde()
echo "experience checks passed"
