## Port of pumpkin-util/src/math/float_provider.rs
## Complete as upstream has it: the file only derives Deserialize (JSON), and has no NBT form. Its `codegen`-feature ToTokens impls emit Rust source; src/data_codegen emits aowl directly, so they have no counterpart.
##
## `impl RandomImpl` is a plain `[R]` calling nextF32 and nextGaussian. Rust only derives Deserialize; toJson writes
## the same shape back. `mul_add` is fused, so every use goes through `mulAdd`.

{.feature: "untyped".}

import std/math
import rustnum
import serdeforms
import ../../codecs/json_value

type
  NormalFloatProviderKind* = enum
    nfpConstant
    nfpUniform
    nfpClampedNormal
    nfpTrapezoid

  FloatProviderKind* = enum
    fpObject
    fpConstant

  ConstantFloatProvider* = object
    ## Always returns the same value.
    value*: float32

  UniformFloatProvider* = object
    ## Uniform over [minInclusive, maxExclusive).
    minInclusive*: float32
    maxExclusive*: float32

  ClampedNormalFloatProvider* = object
    ## A normal distribution, clamped to [min, max].
    mean*: float32
    deviation*: float32
    min*: float32
    max*: float32

  TrapezoidFloatProvider* = object
    ## A flat plateau with linear ramps. `plateau` is a fraction of the range, 0 to 1.
    min*: float32
    max*: float32
    plateau*: float32

  NormalFloatProvider* = object
    ## `#[serde(tag = "type")]`.
    case kind*: NormalFloatProviderKind
    of nfpConstant: constant*: ConstantFloatProvider
    of nfpUniform: uniform*: UniformFloatProvider
    of nfpClampedNormal: clampedNormal*: ClampedNormalFloatProvider
    of nfpTrapezoid: trapezoid*: TrapezoidFloatProvider

  FloatProvider* = object
    ## `#[serde(untagged)]`: an object provider, or a bare number.
    case kind*: FloatProviderKind
    of fpObject: obj*: NormalFloatProvider
    of fpConstant: value*: float32

proc newConstantFloatProvider*(value: float32): ConstantFloatProvider =
  ConstantFloatProvider(value: value)

proc newUniformFloatProvider*(minInclusive, maxExclusive: float32): UniformFloatProvider =
  UniformFloatProvider(minInclusive: minInclusive, maxExclusive: maxExclusive)

proc newClampedNormalFloatProvider*(mean, deviation, min, max: float32): ClampedNormalFloatProvider =
  ClampedNormalFloatProvider(mean: mean, deviation: deviation, min: min, max: max)

proc newTrapezoidFloatProvider*(min, max, plateau: float32): TrapezoidFloatProvider =
  TrapezoidFloatProvider(min: min, max: max, plateau: plateau)

proc floatProvider*(f: float32): FloatProvider =
  ## `FloatProvider::Constant`.
  FloatProvider(kind: fpConstant, value: f)

proc floatProvider*(p: NormalFloatProvider): FloatProvider =
  ## `FloatProvider::Object`.
  FloatProvider(kind: fpObject, obj: p)

proc normal*(p: ConstantFloatProvider): NormalFloatProvider = NormalFloatProvider(kind: nfpConstant, constant: p)
proc normal*(p: UniformFloatProvider): NormalFloatProvider = NormalFloatProvider(kind: nfpUniform, uniform: p)
proc normal*(p: ClampedNormalFloatProvider): NormalFloatProvider = NormalFloatProvider(kind: nfpClampedNormal, clampedNormal: p)
proc normal*(p: TrapezoidFloatProvider): NormalFloatProvider = NormalFloatProvider(kind: nfpTrapezoid, trapezoid: p)

proc getMin*(self: ConstantFloatProvider): float32 = self.value
proc getMin*(self: UniformFloatProvider): float32 = self.minInclusive
proc getMin*(self: ClampedNormalFloatProvider): float32 = self.min
proc getMin*(self: TrapezoidFloatProvider): float32 = self.min

proc getMax*(self: ConstantFloatProvider): float32 = self.value
proc getMax*(self: UniformFloatProvider): float32 = self.maxExclusive
proc getMax*(self: ClampedNormalFloatProvider): float32 = self.max
proc getMax*(self: TrapezoidFloatProvider): float32 = self.max

proc getMin*(self: FloatProvider): float32 =
  case self.kind
  of fpConstant: self.value
  of fpObject:
    case self.obj.kind
    of nfpConstant: getMin(self.obj.constant)
    of nfpUniform: getMin(self.obj.uniform)
    of nfpClampedNormal: getMin(self.obj.clampedNormal)
    of nfpTrapezoid: getMin(self.obj.trapezoid)

proc getMax*(self: FloatProvider): float32 =
  case self.kind
  of fpConstant: self.value
  of fpObject:
    case self.obj.kind
    of nfpConstant: getMax(self.obj.constant)
    of nfpUniform: getMax(self.obj.uniform)
    of nfpClampedNormal: getMax(self.obj.clampedNormal)
    of nfpTrapezoid: getMax(self.obj.trapezoid)

proc get*[R](self: ConstantFloatProvider, random: var R): float32 =
  self.value

proc get*[R](self: UniformFloatProvider, random: var R): float32 =
  let range = self.maxExclusive - self.minInclusive
  mulAdd(nextF32(random), range, self.minInclusive)

proc get*[R](self: ClampedNormalFloatProvider, random: var R): float32 =
  let gaussian = float32(nextGaussian(random))
  let value = mulAdd(gaussian, self.deviation, self.mean)
  clamp(value, self.min, self.max)

proc get*[R](self: TrapezoidFloatProvider, random: var R): float32 =
  let range = self.max - self.min
  let plateauRange = range * self.plateau
  let rampRange = (range - plateauRange) * 0.5'f32
  let randomValue = nextF32(random)
  if randomValue < mulAdd(self.plateau, -0.5'f32, 0.5'f32):
    # Left ramp.
    let scaled = randomValue / mulAdd(self.plateau, -0.5'f32, 0.5'f32)
    let sqrtScaled = sqrt(scaled)
    self.min + rampRange * sqrtScaled
  elif randomValue > mulAdd(self.plateau, 0.5'f32, 0.5'f32):
    # Right ramp.
    let scaled = (randomValue - mulAdd(self.plateau, 0.5'f32, 0.5'f32)) / mulAdd(self.plateau, -0.5'f32, 0.5'f32)
    let sqrtScaled = sqrt(1.0'f32 - scaled)
    self.max - rampRange * sqrtScaled
  else:
    # Plateau.
    let plateauPos = (randomValue - mulAdd(self.plateau, -0.5'f32, 0.5'f32)) / self.plateau
    self.min + rampRange + plateauPos * plateauRange

proc get*[R](self: FloatProvider, random: var R): float32 =
  case self.kind
  of fpConstant: self.value
  of fpObject:
    case self.obj.kind
    of nfpConstant: get(self.obj.constant, random)
    of nfpUniform: get(self.obj.uniform, random)
    of nfpClampedNormal: get(self.obj.clampedNormal, random)
    of nfpTrapezoid: get(self.obj.trapezoid, random)

# --- serde ------------------------------------------------------------------------------------------

proc tagged(tag: string): JsonValue =
  result = jsonObject()
  result.put("type", jsonString(tag))

proc toJson*(self: NormalFloatProvider): JsonValue =
  case self.kind
  of nfpConstant:
    result = tagged("minecraft:constant")
    result.put("value", jsonF32(self.constant.value))
  of nfpUniform:
    result = tagged("minecraft:uniform")
    result.put("min_inclusive", jsonF32(self.uniform.minInclusive))
    result.put("max_exclusive", jsonF32(self.uniform.maxExclusive))
  of nfpClampedNormal:
    result = tagged("minecraft:clamped_normal")
    result.put("mean", jsonF32(self.clampedNormal.mean))
    result.put("deviation", jsonF32(self.clampedNormal.deviation))
    result.put("min", jsonF32(self.clampedNormal.min))
    result.put("max", jsonF32(self.clampedNormal.max))
  of nfpTrapezoid:
    result = tagged("minecraft:trapezoid")
    result.put("min", jsonF32(self.trapezoid.min))
    result.put("max", jsonF32(self.trapezoid.max))
    result.put("plateau", jsonF32(self.trapezoid.plateau))

proc toJson*(self: FloatProvider): JsonValue =
  case self.kind
  of fpConstant: jsonF32(self.value)
  of fpObject: toJson(self.obj)

proc fromJson*(t: typedesc[NormalFloatProvider], j: JsonValue): SerdeResult[NormalFloatProvider] =
  if j.kind != jvObject:
    return serdeErr[NormalFloatProvider](invalidType(j, "internally tagged enum NormalFloatProvider"))
  let tagAt = find(j, "type")
  if tagAt < 0:
    return serdeErr[NormalFloatProvider]("missing field `type`")
  if j.vals[tagAt].kind != jvString:
    return serdeErr[NormalFloatProvider](invalidType(j.vals[tagAt], "variant identifier"))
  let tag = j.vals[tagAt].strVal
  if tag == "minecraft:constant":
    let v = fieldF32(j, "value")
    serdeCheck(v, NormalFloatProvider)
    serdeOk(normal(newConstantFloatProvider(v.value)))
  elif tag == "minecraft:uniform":
    let lo = fieldF32(j, "min_inclusive")
    serdeCheck(lo, NormalFloatProvider)
    let hi = fieldF32(j, "max_exclusive")
    serdeCheck(hi, NormalFloatProvider)
    serdeOk(normal(newUniformFloatProvider(lo.value, hi.value)))
  elif tag == "minecraft:clamped_normal":
    let mean = fieldF32(j, "mean")
    serdeCheck(mean, NormalFloatProvider)
    let deviation = fieldF32(j, "deviation")
    serdeCheck(deviation, NormalFloatProvider)
    let lo = fieldF32(j, "min")
    serdeCheck(lo, NormalFloatProvider)
    let hi = fieldF32(j, "max")
    serdeCheck(hi, NormalFloatProvider)
    serdeOk(normal(newClampedNormalFloatProvider(mean.value, deviation.value, lo.value, hi.value)))
  elif tag == "minecraft:trapezoid":
    let lo = fieldF32(j, "min")
    serdeCheck(lo, NormalFloatProvider)
    let hi = fieldF32(j, "max")
    serdeCheck(hi, NormalFloatProvider)
    let plateau = fieldF32(j, "plateau")
    serdeCheck(plateau, NormalFloatProvider)
    serdeOk(normal(newTrapezoidFloatProvider(lo.value, hi.value, plateau.value)))
  else:
    serdeErr[NormalFloatProvider]("unknown variant `" & tag & "`, expected one of `minecraft:constant`, " &
      "`minecraft:uniform`, `minecraft:clamped_normal`, `minecraft:trapezoid`")

proc fromJson*(t: typedesc[FloatProvider], j: JsonValue): SerdeResult[FloatProvider] =
  ## Untagged: the object form first, then a bare number, and serde's one message when neither fits.
  let obj = fromJson(NormalFloatProvider, j)
  if obj.ok:
    return serdeOk(floatProvider(obj.value))
  let f = readF32(j)
  if f.ok:
    return serdeOk(floatProvider(f.value))
  serdeErr[FloatProvider]("data did not match any variant of untagged enum FloatProvider")
