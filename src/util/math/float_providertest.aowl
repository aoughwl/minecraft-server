## Known-answer tests for float_provider.aowl: upstream's vectors with a fixed seed, plus a scripted generator
## with answers worked from the Rust, plus the exact serde shapes.
import std/[assertions, syncio]
import float_provider
import serdeforms
import ../random/random
import ../xoroshiro128
import ../../codecs/json_value

type
  Scripted = object
    floats: seq[float32]
    gaussians: seq[float64]

proc nextF32(r: var Scripted): float32 =
  result = r.floats[0]
  r.floats.delete(0)

proc nextGaussian(r: var Scripted): float64 =
  result = r.gaussians[0]
  r.gaussians.delete(0)

proc bits(f: float32): uint32 = cast[uint32](f)

proc parse(text: string): JsonValue =
  let r = parseJsonValue(text)
  assert r.ok
  r.value

proc seeded(): RandomGenerator =
  toRandomGenerator(fromSeed(12345'u64))

proc testConstant() =
  var random = seeded()
  let provider = newConstantFloatProvider(5.5'f32)
  assert getMin(provider) == 5.5'f32
  assert getMax(provider) == 5.5'f32
  assert get(provider, random) == 5.5'f32
  assert get(provider, random) == 5.5'f32

proc testUniform() =
  var random = seeded()
  let provider = newUniformFloatProvider(1.0'f32, 5.0'f32)
  assert getMin(provider) == 1.0'f32
  assert getMax(provider) == 5.0'f32
  for _ in 0 ..< 100:
    let value = get(provider, random)
    assert value >= 1.0'f32 and value < 5.0'f32
  var s = Scripted(floats: @[cast[float32](0x3e99999a'u32)], gaussians: @[])
  # 0.3f32 * 4 + 1, fused.
  assert bits(get(provider, s)) == 0x400ccccd'u32

proc testIsFused() =
  # These three give 3fad5c40 with one rounding and 3fad5c41 with two.
  let g = cast[float32](0x3f0a9a02'u32)
  let deviation = cast[float32](0x4096438d'u32)
  let mean = cast[float32](0xbf980eff'u32)
  var n = Scripted(floats: @[], gaussians: @[float64(g)])
  assert bits(get(newClampedNormalFloatProvider(mean, deviation, -100.0'f32, 100.0'f32), n)) == 0x3fad5c40'u32

proc testClampedNormal() =
  var random = seeded()
  let provider = newClampedNormalFloatProvider(3.0'f32, 1.0'f32, 1.0'f32, 5.0'f32)
  assert getMin(provider) == 1.0'f32
  assert getMax(provider) == 5.0'f32
  for _ in 0 ..< 100:
    let value = get(provider, random)
    assert value >= 1.0'f32 and value <= 5.0'f32
  var s = Scripted(floats: @[], gaussians: @[0.5'f64, 100.0'f64, -100.0'f64])
  assert get(provider, s) == 3.5'f32
  assert get(provider, s) == 5.0'f32
  assert get(provider, s) == 1.0'f32
  # The gaussian narrows to f32 first: 0.7071067811865476 then 2 * g + 5.
  var g = Scripted(floats: @[], gaussians: @[0.7071067811865476'f64])
  assert bits(get(newClampedNormalFloatProvider(5.0'f32, 2.0'f32, 0.0'f32, 10.0'f32), g)) == 0x40cd413d'u32

proc testTrapezoid() =
  var random = seeded()
  let provider = newTrapezoidFloatProvider(0.0'f32, 10.0'f32, 0.5'f32)
  assert getMin(provider) == 0.0'f32
  assert getMax(provider) == 10.0'f32
  for _ in 0 ..< 100:
    let value = get(provider, random)
    assert value >= 0.0'f32 and value <= 10.0'f32
  # Ramps below 0.25 and above 0.75, plateau between.
  var s = Scripted(floats: @[0.0'f32, 0.1'f32, 0.25'f32, 0.5'f32, 0.75'f32, 0.9'f32, 0.99'f32], gaussians: @[])
  assert bits(get(provider, s)) == 0x00000000'u32
  assert bits(get(provider, s)) == 0x3fca62c2'u32
  assert bits(get(provider, s)) == 0x40200000'u32
  assert bits(get(provider, s)) == 0x40a00000'u32
  assert bits(get(provider, s)) == 0x40f00000'u32
  assert bits(get(provider, s)) == 0x4106b3a8'u32
  assert bits(get(provider, s)) == 0x41180000'u32

proc testEnum() =
  var random = seeded()
  let c = floatProvider(7.5'f32)
  assert getMin(c) == 7.5'f32 and getMax(c) == 7.5'f32 and get(c, random) == 7.5'f32
  let o = floatProvider(normal(newUniformFloatProvider(2.0'f32, 8.0'f32)))
  assert getMin(o) == 2.0'f32 and getMax(o) == 8.0'f32
  let value = get(o, random)
  assert value >= 2.0'f32 and value < 8.0'f32

proc testFromJson() =
  let bareF = fromJson(FloatProvider, parse("1.5"))
  assert bareF.ok and bareF.value.kind == fpConstant and bareF.value.value == 1.5'f32
  let bareI = fromJson(FloatProvider, parse("3"))
  assert bareI.ok and bareI.value.kind == fpConstant and bareI.value.value == 3.0'f32
  let c = fromJson(FloatProvider, parse("{\"type\":\"minecraft:constant\",\"value\":2}"))
  assert c.ok and c.value.obj.kind == nfpConstant and c.value.obj.constant.value == 2.0'f32
  let u = fromJson(FloatProvider, parse("{\"type\":\"minecraft:uniform\",\"min_inclusive\":0.5,\"max_exclusive\":1}"))
  assert u.ok and getMin(u.value) == 0.5'f32 and getMax(u.value) == 1.0'f32
  let n = fromJson(FloatProvider, parse("{\"type\":\"minecraft:clamped_normal\",\"mean\":1,\"deviation\":0.25,\"min\":-1,\"max\":3}"))
  assert n.ok and n.value.obj.clampedNormal.deviation == 0.25'f32
  assert getMin(n.value) == -1.0'f32 and getMax(n.value) == 3.0'f32
  let t = fromJson(FloatProvider, parse("{\"type\":\"minecraft:trapezoid\",\"min\":0,\"max\":4,\"plateau\":0.5}"))
  assert t.ok and t.value.obj.trapezoid.plateau == 0.5'f32
  # The f64 text narrows.
  let narrow = fromJson(FloatProvider, parse("0.1"))
  assert bits(narrow.value.value) == 0x3dcccccd'u32

proc testFromJsonErrors() =
  let untagged = "data did not match any variant of untagged enum FloatProvider"
  assert fromJson(FloatProvider, parse("\"x\"")).error == untagged
  assert fromJson(FloatProvider, parse("null")).error == untagged
  assert fromJson(FloatProvider, parse("{\"type\":\"minecraft:biased_to_bottom\"}")).error == untagged
  assert fromJson(NormalFloatProvider, parse("{\"type\":\"minecraft:uniform\",\"min_inclusive\":0.5}")).error ==
    "missing field `max_exclusive`"
  assert fromJson(NormalFloatProvider, parse("{\"type\":\"minecraft:nope\"}")).error ==
    "unknown variant `minecraft:nope`, expected one of `minecraft:constant`, `minecraft:uniform`, " &
    "`minecraft:clamped_normal`, `minecraft:trapezoid`"
  # A clamped_normal here has `min` and `max`, not the int provider's names.
  assert fromJson(NormalFloatProvider, parse(
    "{\"type\":\"minecraft:clamped_normal\",\"mean\":1,\"deviation\":1,\"min_inclusive\":0,\"max_inclusive\":1}")).error ==
    "missing field `min`"

proc checkShape(text: string) =
  let r = fromJson(FloatProvider, parse(text))
  assert r.ok, text
  assert toJsonString(toJson(r.value)) == text, toJsonString(toJson(r.value))

proc testToJson() =
  checkShape("1.5")
  checkShape("{\"type\":\"minecraft:constant\",\"value\":2.0}")
  checkShape("{\"max_exclusive\":1.0,\"min_inclusive\":0.5,\"type\":\"minecraft:uniform\"}")
  checkShape("{\"deviation\":0.25,\"max\":3.0,\"mean\":1.0,\"min\":-1.0,\"type\":\"minecraft:clamped_normal\"}")
  checkShape("{\"max\":4.0,\"min\":0.0,\"plateau\":0.5,\"type\":\"minecraft:trapezoid\"}")

testConstant()
testUniform()
testIsFused()
testClampedNormal()
testTrapezoid()
testEnum()
testFromJson()
testFromJsonErrors()
testToJson()
echo "float_provider checks passed"
