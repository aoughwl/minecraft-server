## Port of pumpkin-util/src/math/int_provider.rs
## Complete as upstream has it: the file only derives Deserialize (JSON), and has no NBT form. Its `codegen`-feature ToTokens impls emit Rust source; src/data_codegen emits aowl directly, so they have no counterpart.
##
## `impl RandomImpl` is a plain `[R]` calling nextBoundedI32, nextInbetweenI32, nextGaussian and nextTriangular.
## Rust only derives Deserialize; toJson writes the same shape back. A serde quirk is not reproduced: internally
## tagged enums also accept `["minecraft:constant", 5]`, which no data file uses.

{.feature: "untyped".}

import std/math
import rustnum
import serdeforms
import ../../codecs/json_value

type
  NormalIntProviderKind* = enum
    nipConstant
    nipUniform
    nipBiasedToBottom
    nipClamped
    nipTrapezoid
    nipClampedNormal
    nipWeightedList

  IntProviderKind* = enum
    ipObject
    ipConstant

  ConstantIntProvider* = object
    ## Always returns the same value.
    value*: int32

  UniformIntProvider* = object
    ## Uniform over an inclusive range.
    minInclusive*: int32
    maxInclusive*: int32

  BiasedToBottomIntProvider* = object
    ## Biased toward the lower end of an inclusive range.
    minInclusive*: int32
    maxInclusive*: int32

  ClampedIntProvider* = object
    ## Wraps another provider and clamps its output.
    source*: ref IntProvider
    minInclusive*: int32
    maxInclusive*: int32

  TrapezoidIntProvider* = object
    minInclusive*: int32
    maxInclusive*: int32
    plateau*: int32

  ClampedNormalIntProvider* = object
    ## A normal distribution, rounded and clamped.
    mean*: float32
    deviation*: float32
    minInclusive*: int32
    maxInclusive*: int32

  WeightedEntry* = object
    data*: IntProvider
    weight*: int32

  WeightedListIntProvider* = object
    distribution*: seq[WeightedEntry]

  NormalIntProvider* = object
    ## `#[serde(tag = "type")]`.
    case kind*: NormalIntProviderKind
    of nipConstant: constant*: ConstantIntProvider
    of nipUniform: uniform*: UniformIntProvider
    of nipBiasedToBottom: biasedToBottom*: BiasedToBottomIntProvider
    of nipClamped: clamped*: ClampedIntProvider
    of nipTrapezoid: trapezoid*: TrapezoidIntProvider
    of nipClampedNormal: clampedNormal*: ClampedNormalIntProvider
    of nipWeightedList: weightedList*: WeightedListIntProvider

  IntProvider* = object
    ## `#[serde(untagged)]`: an object provider, or a bare integer.
    case kind*: IntProviderKind
    of ipObject: obj*: NormalIntProvider
    of ipConstant: value*: int32

proc newConstantIntProvider*(value: int32): ConstantIntProvider =
  ConstantIntProvider(value: value)

proc newUniformIntProvider*(minInclusive, maxInclusive: int32): UniformIntProvider =
  UniformIntProvider(minInclusive: minInclusive, maxInclusive: maxInclusive)

proc newBiasedToBottomIntProvider*(minInclusive, maxInclusive: int32): BiasedToBottomIntProvider =
  BiasedToBottomIntProvider(minInclusive: minInclusive, maxInclusive: maxInclusive)

proc newClampedIntProvider*(source: IntProvider, minInclusive, maxInclusive: int32): ClampedIntProvider =
  let boxed = (ref IntProvider)()
  boxed[] = source
  ClampedIntProvider(source: boxed, minInclusive: minInclusive, maxInclusive: maxInclusive)

proc newTrapezoidIntProvider*(minInclusive, maxInclusive, plateau: int32): TrapezoidIntProvider =
  TrapezoidIntProvider(minInclusive: minInclusive, maxInclusive: maxInclusive, plateau: plateau)

proc newClampedNormalIntProvider*(mean, deviation: float32, minInclusive, maxInclusive: int32): ClampedNormalIntProvider =
  ClampedNormalIntProvider(mean: mean, deviation: deviation, minInclusive: minInclusive, maxInclusive: maxInclusive)

proc newWeightedListIntProvider*(distribution: seq[WeightedEntry]): WeightedListIntProvider =
  WeightedListIntProvider(distribution: distribution)

proc intProvider*(i: int32): IntProvider =
  ## `IntProvider::Constant`.
  IntProvider(kind: ipConstant, value: i)

proc intProvider*(p: NormalIntProvider): IntProvider =
  ## `IntProvider::Object`.
  IntProvider(kind: ipObject, obj: p)

proc normal*(p: ConstantIntProvider): NormalIntProvider = NormalIntProvider(kind: nipConstant, constant: p)
proc normal*(p: UniformIntProvider): NormalIntProvider = NormalIntProvider(kind: nipUniform, uniform: p)
proc normal*(p: BiasedToBottomIntProvider): NormalIntProvider = NormalIntProvider(kind: nipBiasedToBottom, biasedToBottom: p)
proc normal*(p: ClampedIntProvider): NormalIntProvider = NormalIntProvider(kind: nipClamped, clamped: p)
proc normal*(p: TrapezoidIntProvider): NormalIntProvider = NormalIntProvider(kind: nipTrapezoid, trapezoid: p)
proc normal*(p: ClampedNormalIntProvider): NormalIntProvider = NormalIntProvider(kind: nipClampedNormal, clampedNormal: p)
proc normal*(p: WeightedListIntProvider): NormalIntProvider = NormalIntProvider(kind: nipWeightedList, weightedList: p)

# --- getMin -----------------------------------------------------------------------------------------

proc getMin*(self: ConstantIntProvider): int32 = self.value
proc getMin*(self: UniformIntProvider): int32 = self.minInclusive
proc getMin*(self: BiasedToBottomIntProvider): int32 = self.minInclusive
proc getMin*(self: TrapezoidIntProvider): int32 = self.minInclusive
proc getMin*(self: ClampedNormalIntProvider): int32 = self.minInclusive

proc getMin*(self: ClampedIntProvider): int32 =
  ## The larger of the source's minimum and the clamp minimum.
  max(self.minInclusive, getMin(self.source[]))

proc getMin*(self: WeightedListIntProvider): int32 =
  ## The smallest minimum among the entries, or 0 when empty.
  if self.distribution.len == 0:
    return 0'i32
  result = getMin(self.distribution[0].data)
  for i in 1 ..< self.distribution.len:
    result = min(result, getMin(self.distribution[i].data))

proc getMin*(self: IntProvider): int32 =
  case self.kind
  of ipConstant: self.value
  of ipObject:
    case self.obj.kind
    of nipConstant: getMin(self.obj.constant)
    of nipUniform: getMin(self.obj.uniform)
    of nipBiasedToBottom: getMin(self.obj.biasedToBottom)
    of nipClamped: getMin(self.obj.clamped)
    of nipTrapezoid: getMin(self.obj.trapezoid)
    of nipClampedNormal: getMin(self.obj.clampedNormal)
    of nipWeightedList: getMin(self.obj.weightedList)

# --- getMax -----------------------------------------------------------------------------------------

proc getMax*(self: ConstantIntProvider): int32 = self.value
proc getMax*(self: UniformIntProvider): int32 = self.maxInclusive
proc getMax*(self: BiasedToBottomIntProvider): int32 = self.maxInclusive
proc getMax*(self: TrapezoidIntProvider): int32 = self.maxInclusive
proc getMax*(self: ClampedNormalIntProvider): int32 = self.maxInclusive

proc getMax*(self: ClampedIntProvider): int32 =
  ## The smaller of the source's maximum and the clamp maximum.
  min(self.maxInclusive, getMax(self.source[]))

proc getMax*(self: WeightedListIntProvider): int32 =
  ## The largest maximum among the entries, or 0 when empty.
  if self.distribution.len == 0:
    return 0'i32
  result = getMax(self.distribution[0].data)
  for i in 1 ..< self.distribution.len:
    result = max(result, getMax(self.distribution[i].data))

proc getMax*(self: IntProvider): int32 =
  case self.kind
  of ipConstant: self.value
  of ipObject:
    case self.obj.kind
    of nipConstant: getMax(self.obj.constant)
    of nipUniform: getMax(self.obj.uniform)
    of nipBiasedToBottom: getMax(self.obj.biasedToBottom)
    of nipClamped: getMax(self.obj.clamped)
    of nipTrapezoid: getMax(self.obj.trapezoid)
    of nipClampedNormal: getMax(self.obj.clampedNormal)
    of nipWeightedList: getMax(self.obj.weightedList)

# --- get --------------------------------------------------------------------------------------------

proc get*[R](self: ConstantIntProvider, random: var R): int32 =
  self.value

proc get*[R](self: UniformIntProvider, random: var R): int32 =
  nextInbetweenI32(random, self.minInclusive, self.maxInclusive)

proc get*[R](self: BiasedToBottomIntProvider, random: var R): int32 =
  let range = float64(self.maxInclusive - self.minInclusive + 1'i32)
  let triangular = nextTriangular(random, 0.0'f64, range)
  self.minInclusive + min(asI32(abs(triangular)), self.maxInclusive - self.minInclusive)

proc get*[R](self: ClampedIntProvider, random: var R): int32 =
  clamp(get(self.source[], random), self.minInclusive, self.maxInclusive)

proc get*[R](self: TrapezoidIntProvider, random: var R): int32 =
  if self.plateau == 0'i32 and self.maxInclusive == -self.minInclusive:
    let a = nextBoundedI32(random, self.maxInclusive + 1'i32)
    let b = nextBoundedI32(random, self.maxInclusive + 1'i32)
    return a - b
  let range = self.maxInclusive - self.minInclusive
  if self.plateau == range:
    return nextBoundedI32(random, self.maxInclusive - self.minInclusive + 1'i32) + self.minInclusive
  let plateauStart = (range - self.plateau) div 2'i32
  let plateauEnd = range - plateauStart
  let a = nextBoundedI32(random, plateauEnd + 1'i32)
  let b = nextBoundedI32(random, plateauStart + 1'i32)
  self.minInclusive + a + b

proc get*[R](self: ClampedNormalIntProvider, random: var R): int32 =
  let gaussian = float32(nextGaussian(random))
  let value = asI32(round(mulAdd(gaussian, self.deviation, self.mean)))
  clamp(value, self.minInclusive, self.maxInclusive)

proc get*[R](self: WeightedListIntProvider, random: var R): int32 =
  if self.distribution.len == 0:
    return 0'i32
  var totalWeight = 0'i32
  for i in 0 ..< self.distribution.len:
    totalWeight += self.distribution[i].weight
  if totalWeight == 0'i32:
    return 0'i32
  let chosenWeight = nextBoundedI32(random, totalWeight)
  var currentWeight = 0'i32
  for i in 0 ..< self.distribution.len:
    currentWeight += self.distribution[i].weight
    if chosenWeight < currentWeight:
      return get(self.distribution[i].data, random)
  get(self.distribution[self.distribution.len - 1].data, random)

proc get*[R](self: IntProvider, random: var R): int32 =
  case self.kind
  of ipConstant: self.value
  of ipObject:
    case self.obj.kind
    of nipConstant: get(self.obj.constant, random)
    of nipUniform: get(self.obj.uniform, random)
    of nipBiasedToBottom: get(self.obj.biasedToBottom, random)
    of nipClamped: get(self.obj.clamped, random)
    of nipClampedNormal: get(self.obj.clampedNormal, random)
    of nipWeightedList: get(self.obj.weightedList, random)
    of nipTrapezoid: get(self.obj.trapezoid, random)

# --- serde ------------------------------------------------------------------------------------------

proc toJson*(self: IntProvider): JsonValue

proc tagged(tag: string): JsonValue =
  result = jsonObject()
  result.put("type", jsonString(tag))

proc toJson*(self: NormalIntProvider): JsonValue =
  case self.kind
  of nipConstant:
    result = tagged("minecraft:constant")
    result.put("value", jsonI32(self.constant.value))
  of nipUniform:
    result = tagged("minecraft:uniform")
    result.put("min_inclusive", jsonI32(self.uniform.minInclusive))
    result.put("max_inclusive", jsonI32(self.uniform.maxInclusive))
  of nipBiasedToBottom:
    result = tagged("minecraft:biased_to_bottom")
    result.put("min_inclusive", jsonI32(self.biasedToBottom.minInclusive))
    result.put("max_inclusive", jsonI32(self.biasedToBottom.maxInclusive))
  of nipClamped:
    result = tagged("minecraft:clamped")
    result.put("source", toJson(self.clamped.source[]))
    result.put("min_inclusive", jsonI32(self.clamped.minInclusive))
    result.put("max_inclusive", jsonI32(self.clamped.maxInclusive))
  of nipTrapezoid:
    result = tagged("minecraft:trapezoid")
    result.put("min_inclusive", jsonI32(self.trapezoid.minInclusive))
    result.put("max_inclusive", jsonI32(self.trapezoid.maxInclusive))
    result.put("plateau", jsonI32(self.trapezoid.plateau))
  of nipClampedNormal:
    result = tagged("minecraft:clamped_normal")
    result.put("mean", jsonF32(self.clampedNormal.mean))
    result.put("deviation", jsonF32(self.clampedNormal.deviation))
    result.put("min_inclusive", jsonI32(self.clampedNormal.minInclusive))
    result.put("max_inclusive", jsonI32(self.clampedNormal.maxInclusive))
  of nipWeightedList:
    result = tagged("minecraft:weighted_list")
    var entries: seq[JsonValue] = @[]
    for i in 0 ..< self.weightedList.distribution.len:
      var entry = jsonObject()
      entry.put("data", toJson(self.weightedList.distribution[i].data))
      entry.put("weight", jsonI32(self.weightedList.distribution[i].weight))
      entries.add entry
    result.put("distribution", jsonArray(entries))

proc toJson*(self: IntProvider): JsonValue =
  case self.kind
  of ipConstant: jsonI32(self.value)
  of ipObject: toJson(self.obj)

proc fromJson*(t: typedesc[IntProvider], j: JsonValue): SerdeResult[IntProvider]

proc weightedListFromJson(j: JsonValue): SerdeResult[NormalIntProvider] =
  let i = find(j, "distribution")
  if i < 0:
    return serdeErr[NormalIntProvider]("missing field `distribution`")
  let list = j.vals[i]
  if list.kind != jvArray:
    return serdeErr[NormalIntProvider](invalidType(list, "a sequence"))
  var entries: seq[WeightedEntry] = @[]
  for k in 0 ..< list.items.len:
    let e = list.items[k]
    if e.kind != jvObject:
      return serdeErr[NormalIntProvider](invalidType(e, "struct WeightedEntry"))
    let d = find(e, "data")
    if d < 0:
      return serdeErr[NormalIntProvider]("missing field `data`")
    let data = fromJson(IntProvider, e.vals[d])
    serdeCheck(data, NormalIntProvider)
    let weight = fieldI32(e, "weight")
    serdeCheck(weight, NormalIntProvider)
    entries.add WeightedEntry(data: data.value, weight: weight.value)
  serdeOk(normal(newWeightedListIntProvider(entries)))

proc clampedFromJson(j: JsonValue): SerdeResult[NormalIntProvider] =
  let i = find(j, "source")
  if i < 0:
    return serdeErr[NormalIntProvider]("missing field `source`")
  let source = fromJson(IntProvider, j.vals[i])
  serdeCheck(source, NormalIntProvider)
  let lo = fieldI32(j, "min_inclusive")
  serdeCheck(lo, NormalIntProvider)
  let hi = fieldI32(j, "max_inclusive")
  serdeCheck(hi, NormalIntProvider)
  serdeOk(normal(newClampedIntProvider(source.value, lo.value, hi.value)))

proc fromJson*(t: typedesc[NormalIntProvider], j: JsonValue): SerdeResult[NormalIntProvider] =
  if j.kind != jvObject:
    return serdeErr[NormalIntProvider](invalidType(j, "internally tagged enum NormalIntProvider"))
  let tagAt = find(j, "type")
  if tagAt < 0:
    return serdeErr[NormalIntProvider]("missing field `type`")
  if j.vals[tagAt].kind != jvString:
    return serdeErr[NormalIntProvider](invalidType(j.vals[tagAt], "variant identifier"))
  let tag = j.vals[tagAt].strVal
  if tag == "minecraft:constant":
    let v = fieldI32(j, "value")
    serdeCheck(v, NormalIntProvider)
    serdeOk(normal(newConstantIntProvider(v.value)))
  elif tag == "minecraft:uniform":
    let lo = fieldI32(j, "min_inclusive")
    serdeCheck(lo, NormalIntProvider)
    let hi = fieldI32(j, "max_inclusive")
    serdeCheck(hi, NormalIntProvider)
    serdeOk(normal(newUniformIntProvider(lo.value, hi.value)))
  elif tag == "minecraft:biased_to_bottom":
    let lo = fieldI32(j, "min_inclusive")
    serdeCheck(lo, NormalIntProvider)
    let hi = fieldI32(j, "max_inclusive")
    serdeCheck(hi, NormalIntProvider)
    serdeOk(normal(newBiasedToBottomIntProvider(lo.value, hi.value)))
  elif tag == "minecraft:clamped":
    clampedFromJson(j)
  elif tag == "minecraft:trapezoid":
    let lo = fieldI32(j, "min_inclusive")
    serdeCheck(lo, NormalIntProvider)
    let hi = fieldI32(j, "max_inclusive")
    serdeCheck(hi, NormalIntProvider)
    let plateau = fieldI32(j, "plateau")
    serdeCheck(plateau, NormalIntProvider)
    serdeOk(normal(newTrapezoidIntProvider(lo.value, hi.value, plateau.value)))
  elif tag == "minecraft:clamped_normal":
    let mean = fieldF32(j, "mean")
    serdeCheck(mean, NormalIntProvider)
    let deviation = fieldF32(j, "deviation")
    serdeCheck(deviation, NormalIntProvider)
    let lo = fieldI32(j, "min_inclusive")
    serdeCheck(lo, NormalIntProvider)
    let hi = fieldI32(j, "max_inclusive")
    serdeCheck(hi, NormalIntProvider)
    serdeOk(normal(newClampedNormalIntProvider(mean.value, deviation.value, lo.value, hi.value)))
  elif tag == "minecraft:weighted_list":
    weightedListFromJson(j)
  else:
    serdeErr[NormalIntProvider]("unknown variant `" & tag & "`, expected one of `minecraft:constant`, " &
      "`minecraft:uniform`, `minecraft:biased_to_bottom`, `minecraft:clamped`, `minecraft:trapezoid`, " &
      "`minecraft:clamped_normal`, `minecraft:weighted_list`")

proc fromJson*(t: typedesc[IntProvider], j: JsonValue): SerdeResult[IntProvider] =
  ## Untagged: the object form first, then a bare i32, and serde's one message when neither fits.
  let obj = fromJson(NormalIntProvider, j)
  if obj.ok:
    return serdeOk(intProvider(obj.value))
  let i = readI32(j)
  if i.ok:
    return serdeOk(intProvider(i.value))
  serdeErr[IntProvider]("data did not match any variant of untagged enum IntProvider")
