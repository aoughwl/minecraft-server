## Port of pumpkin-util/src/math/mod.rs
##
## Rust's generic `lerp`/`map`/`lerp_progress` over `Float` and `floor_div`/`floor_mod` over `PrimInt`
## become float32/float64 and int32/int64 overloads, the instantiations callers use. `lerp`, `lerp2` and
## `lerp3` live in ../mathlerp.aowl, which already had them, and are re-exported here.
## `vector_codec_impl!` is the Encode/Decode for vectors and lives beside those types.

import std/math except sin, cos, floorMod, floorDiv
import ../mathlerp
export mathlerp

const
  SinScale = 10430.378'f32 ## 65536 / 2P
  SinMask = 65535'i32

proc buildSinTable(): seq[float32] =
  result = newSeq[float32](65536)
  for i in 0 ..< 65536:
    result[i] = float32(math.sin(float64(i) / 10430.378350470453'f64))

let SinTable = buildSinTable()

proc truncToI32(value: float32): int32 {.inline.} =
  ## Rust's saturating `as i32`: NaN becomes 0, out-of-range values clamp.
  if value != value: 0'i32
  elif value >= 2147483648.0'f32: int32.high
  elif value <= -2147483648.0'f32: int32.low
  else: int32(value)

proc sin*(value: float32): float32 =
  ## The vanilla sine table value for an angle in radians.
  SinTable[int(truncToI32(value * SinScale) and SinMask)]

proc cos*(value: float32): float32 =
  ## The vanilla cosine table value for an angle in radians.
  SinTable[int(truncToI32(value * SinScale + 16384.0'f32) and SinMask)]

proc wrapDegrees*(degrees: float32): float32 =
  ## Wraps an angle in degrees to the range [-180, 180).
  var var1 = degrees mod 360.0'f32
  if var1 >= 180.0'f32:
    var1 -= 360.0'f32
  if var1 < -180.0'f32:
    var1 += 360.0'f32
  var1

proc subtractAngles*(start, stop: float32): float32 =
  ## Subtracts two angles, returning the difference wrapped to [-180, 180).
  wrapDegrees(stop - start)

proc clampAngle*(value, mean, delta: float32): float32 =
  ## Clamps an angle toward a mean within a delta.
  let i = subtractAngles(value, mean)
  let j = if i < -delta: -delta elif i > delta: delta else: i
  mean - j

proc squaredMagnitude*(a, b, c: float64): float64 {.inline.} =
  c * c + (a * a + b * b)

proc magnitude*(a, b, c: float64): float64 {.inline.} =
  sqrt(squaredMagnitude(a, b, c))

proc getSectionCord*(coord: int32): int32 {.inline.} =
  ## Converts a world coordinate to a chunk-section coordinate.
  coord shr 4

const MultiplyDeBruijnBitPosition: array[32, uint8] = [
  0'u8, 1'u8, 28'u8, 2'u8, 29'u8, 14'u8, 24'u8, 3'u8, 30'u8, 22'u8, 20'u8, 15'u8, 25'u8, 17'u8, 4'u8, 8'u8,
  31'u8, 27'u8, 13'u8, 23'u8, 21'u8, 19'u8, 16'u8, 7'u8, 26'u8, 12'u8, 18'u8, 6'u8, 11'u8, 5'u8, 10'u8, 9'u8]

proc isPowerOfTwo(value: uint32): bool {.inline.} =
  value != 0'u32 and (value and (value - 1'u32)) == 0'u32

proc smallestEncompassingPowerOfTwo*(value: uint32): uint32 =
  ## `u32::next_power_of_two`: 0 gives 1.
  if value <= 1'u32:
    return 1'u32
  var v = value - 1'u32
  v = v or (v shr 1)
  v = v or (v shr 2)
  v = v or (v shr 4)
  v = v or (v shr 8)
  v = v or (v shr 16)
  v + 1'u32

proc ceilLog2*(value: uint32): uint8 =
  ## The smallest power-of-two exponent >= log2(value). Maximum return value: 31.
  let v = if isPowerOfTwo(value): value else: smallestEncompassingPowerOfTwo(value)
  MultiplyDeBruijnBitPosition[int(((uint64(v) * 125613361'u64) shr 27) and 31'u64)]

proc floorLog2*(value: uint32): uint8 =
  ## The largest power-of-two exponent <= log2(value). Maximum return value: 30.
  ceilLog2(value) - (if isPowerOfTwo(value): 0'u8 else: 1'u8)

proc floorDiv*(x, y: int32): int32 {.inline.} =
  let d = x div y
  let r = x mod y
  if (x xor y) < 0'i32 and r != 0'i32: d - 1'i32 else: d

proc floorDiv*(x, y: int64): int64 {.inline.} =
  let d = x div y
  let r = x mod y
  if (x xor y) < 0'i64 and r != 0'i64: d - 1'i64 else: d

proc floorMod*(x, y: int32): int32 {.inline.} =
  let r = x mod y
  if (x xor y) < 0'i32 and r != 0'i32: r + y else: r

proc floorMod*(x, y: int64): int64 {.inline.} =
  let r = x mod y
  if (x xor y) < 0'i64 and r != 0'i64: r + y else: r

proc squareF64*(n: float64): float64 {.inline.} = n * n
proc squareF32*(n: float32): float32 {.inline.} = n * n

proc lerpProgress*(value, start, stop: float32): float32 {.inline.} =
  (value - start) / (stop - start)

proc lerpProgress*(value, start, stop: float64): float64 {.inline.} =
  (value - start) / (stop - start)

proc map*(value, oldStart, oldEnd, newStart, newEnd: float32): float32 {.inline.} =
  lerp(lerpProgress(value, oldStart, oldEnd), newStart, newEnd)

proc map*(value, oldStart, oldEnd, newStart, newEnd: float64): float64 {.inline.} =
  lerp(lerpProgress(value, oldStart, oldEnd), newStart, newEnd)

proc clampedLerp*(start, stop, delta: float64): float64 =
  if delta < 0.0:
    start
  elif delta > 1.0:
    stop
  else:
    lerp(delta, start, stop)

proc clampedMap*(value, oldStart, oldEnd, newStart, newEnd: float64): float64 {.inline.} =
  clampedLerp(newStart, newEnd, lerpProgress(value, oldStart, oldEnd))

proc wrapMul31(a: int32, b: int32): int32 {.inline.} =
  cast[int32](cast[uint32](a) * 31'u32 + cast[uint32](b))

proc javaArrayHash*(data: openArray[byte]): int32 =
  ## Java-style hash code for a byte array. Bytes count as unsigned, as upstream's do.
  var hash = 1'i32
  for b in data:
    hash = wrapMul31(hash, int32(b))
  hash

proc polynomialRollingHash*(signatures: seq[seq[byte]]): uint8 =
  ## A single-byte hash of the byte arrays, never 0.
  var i = 1'i32
  for signature in signatures:
    i = wrapMul31(i, javaArrayHash(signature))
  let b = uint8(i and 0xFF'i32)
  if b == 0'u8: 1'u8 else: b

proc javaStringHash*(text: string): int32 =
  ## Java's `String.hashCode` over the UTF-16 encoding of a UTF-8 string.
  var hash = 0'i32
  var i = 0
  while i < text.len:
    let c = uint32(ord(text[i]))
    var cp = 0'u32
    var extra = 0
    if c < 0x80'u32:
      cp = c
    elif c < 0xE0'u32:
      cp = c and 0x1F'u32
      extra = 1
    elif c < 0xF0'u32:
      cp = c and 0x0F'u32
      extra = 2
    else:
      cp = c and 0x07'u32
      extra = 3
    inc i
    while extra > 0 and i < text.len:
      cp = (cp shl 6) or (uint32(ord(text[i])) and 0x3F'u32)
      inc i
      dec extra
    if cp >= 0x10000'u32:
      let v = cp - 0x10000'u32
      hash = wrapMul31(hash, int32(0xD800'u32 + (v shr 10)))
      hash = wrapMul31(hash, int32(0xDC00'u32 + (v and 0x3FF'u32)))
    else:
      hash = wrapMul31(hash, int32(cp))
  hash
