## Known answers from upstream's `java_hash` test and hand checks of the rest of
## pumpkin-util/src/math/mod.rs.

import std/syncio
import std/assertions
import mathmod

let JavaHashValues = @[
  ("", 0'i32, 1'i32),
  ("\x31", 49'i32, 80'i32),
  ("\x54\x45\x53\x54", 2571410'i32, 3494931'i32),
  ("\x54\x45\x53\x54\x31", 79713759'i32, 108342910'i32),
  ("\x54\x45\x53\x54\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39", 506557463'i32, 2014109272'i32),
  ("\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2A\x2B\x2C\x2D\x2E\x2F\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3A\x3B\x3C\x3D\x3E\x3F\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4A\x4B\x4C\x4D\x4E\x4F\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5A\x5B\x5C\x5D\x5E\x5F\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6A\x6B\x6C\x6D\x6E\x6F\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7A\x7B\x7C\x7D\x7E\xC2\xA1\xC2\xA2\xC2\xA3\xC2\xA4\xC2\xA5\xC2\xA6\xC2\xA7\xC2\xA8\xC2\xA9\xC2\xAA\xC2\xAB\xC2\xAC\xC2\xAE\xC2\xAF\xC2\xB0\xC2\xB1\xC2\xB2\xC2\xB3\xC2\xB4\xC2\xB5\xC2\xB6\xC2\xB7\xC2\xB8\xC2\xB9\xC2\xBA\xC2\xBB\xC2\xBC\xC2\xBD\xC2\xBE\xC2\xBF\xC3\x80\xC3\x81\xC3\x82\xC3\x83\xC3\x84\xC3\x85\xC3\x86\xC3\x87\xC3\x88\xC3\x89\xC3\x8A\xC3\x8B\xC3\x8C\xC3\x8D\xC3\x8E\xC3\x8F\xC3\x90\xC3\x91\xC3\x92\xC3\x93\xC3\x94\xC3\x95\xC3\x96\xC3\x97\xC3\x98\xC3\x99\xC3\x9A\xC3\x9B\xC3\x9C\xC3\x9D\xC3\x9E\xC3\x9F\xC3\xA0\xC3\xA1\xC3\xA2\xC3\xA3\xC3\xA4\xC3\xA5\xC3\xA6\xC3\xA7\xC3\xA8\xC3\xA9\xC3\xAA\xC3\xAB\xC3\xAC\xC3\xAD\xC3\xAE\xC3\xAF\xC3\xB0\xC3\xB1\xC3\xB2\xC3\xB3\xC3\xB4\xC3\xB5\xC3\xB6\xC3\xB7\xC3\xB8\xC3\xB9\xC3\xBA\xC3\xBB\xC3\xBC\xC3\xBD\xC3\xBE", -1992287231'i32, -1606003975'i32),
  ("\xE6\xB1\x82\xE5\x90\x8C\xE5\xAD\x98\xE5\xBC\x82", 847053876'i32, 1709557670'i32),
  ("\xD7\x90\xD7\x91\xD6\xBC\xD6\xB0\xD7\xA8\xD6\xB5\xD7\x90\xD7\xA9\xD7\x81\xD6\xB4\xD6\x96\xD7\x99\xD7\xAA\x20\xD7\x91\xD6\xBC\xD6\xB8\xD7\xA8\xD6\xB8\xD6\xA3\xD7\x90\x20\xD7\x90\xD6\xB1\xD7\x9C\xD6\xB9\xD7\x94\xD6\xB4\xD6\x91\xD7\x99\xD7\x9D\x20\xD7\x90\xD6\xB5\xD6\xA5\xD7\xAA\x20\xD7\x94\xD6\xB7\xD7\xA9\xD6\xBC\xD7\x81\xD6\xB8\xD7\x9E\xD6\xB7\xD6\x96\xD7\x99\xD6\xB4\xD7\x9D\x20\xD7\x95\xD6\xB0\xD7\x90\xD6\xB5\xD6\xA5\xD7\xAA\x20\xD7\x94\xD6\xB8\xD7\x90\xD6\xB8\xD6\xBD\xD7\xA8\xD6\xB6\xD7\xA5\x3A", 1372570871'i32, -396640725'i32),
  ("\xE0\xA4\xB8\xE0\xA4\x82\xE0\xA4\xB8\xE0\xA5\x8D\xE0\xA4\x95\xE0\xA5\x83\xE0\xA4\xA4\x2D", 1748614838'i32, -187482695'i32),
  ("\x6D\x69\x6E\x65\x63\x72\x61\x66\x74\x3A\x6F\x66\x66\x73\x65\x74", -920384768'i32, 432924929'i32),
]

for i in 0 ..< JavaHashValues.len:
  let (text, stringHash, arrayHash) = JavaHashValues[i]
  assert javaStringHash(text) == stringHash, text
  var bytes: seq[byte] = @[]
  for c in text: bytes.add byte(c)
  assert javaArrayHash(bytes) == arrayHash, text

assert ceilLog2(1'u32) == 0'u8
assert ceilLog2(2'u32) == 1'u8
assert ceilLog2(3'u32) == 2'u8
assert ceilLog2(1024'u32) == 10'u8
assert ceilLog2(1025'u32) == 11'u8
assert floorLog2(1025'u32) == 10'u8
assert floorLog2(1024'u32) == 10'u8
assert smallestEncompassingPowerOfTwo(0'u32) == 1'u32
assert smallestEncompassingPowerOfTwo(17'u32) == 32'u32
assert floorDiv(-7'i32, 2'i32) == -4'i32
assert floorMod(-7'i32, 2'i32) == 1'i32
assert floorDiv(7'i64, -2'i64) == -4'i64
assert floorMod(7'i64, -2'i64) == -1'i64
assert getSectionCord(-1'i32) == -1'i32
assert wrapDegrees(190.0'f32) == -170.0'f32
assert wrapDegrees(-190.0'f32) == 170.0'f32
assert wrapDegrees(180.0'f32) == -180.0'f32
assert subtractAngles(10.0'f32, 350.0'f32) == -20.0'f32
assert clampAngle(0.0'f32, 90.0'f32, 10.0'f32) == 80.0'f32
assert sin(0.0'f32) == 0.0'f32
assert cos(0.0'f32) == 1.0'f32
assert magnitude(3.0, 4.0, 0.0) == 5.0
assert clampedLerp(1.0, 3.0, -1.0) == 1.0
assert clampedLerp(1.0, 3.0, 2.0) == 3.0
assert clampedLerp(1.0, 3.0, 0.5) == 2.0
assert clampedMap(5.0, 0.0, 10.0, 0.0, 100.0) == 50.0
assert map(5.0, 0.0, 10.0, 0.0, 100.0) == 50.0
assert polynomialRollingHash(@[]) == 1'u8
echo "mathmod: OK"
