## Port of pumpkin-util/src/math/pool.rs
##
## `Weighted<E>`'s data decodes through the caller's `fromJson(typedesc[E], JsonValue)`. Rust's `&mut RandomGenerator`
## is a plain `[R]` calling nextBoundedI32.
## Complete as upstream has it: `Weighted` only derives Deserialize (JSON); upstream has no NBT form.

{.feature: "untyped".}

import std/options
import serdeforms
import ../../codecs/json_value

type
  Pool* = object
    ## A weighted selection pool for random sampling.

  Weighted*[E] = object
    ## A weighted entry in a pool.
    data*: E
    weight*: int32

proc flattenedContentGet[E](index: int32, entries: openArray[Weighted[E]], totalWeight: int32): E =
  var curIndex = 0'i32
  for i in 0 ..< entries.len:
    let weight = entries[i].weight
    if index >= curIndex and index < curIndex + weight:
      return entries[i].data
    curIndex += weight
  entries[0].data

proc get*[E, R](t: typedesc[Pool], distribution: openArray[Weighted[E]], random: var R): Option[E] =
  var totalWeight = 0'i32
  for i in 0 ..< distribution.len:
    totalWeight += distribution[i].weight
  var index = nextBoundedI32(random, totalWeight)
  if totalWeight < 64'i32:
    return some(flattenedContentGet(index, distribution, totalWeight))
  # WrappedContent
  for i in 0 ..< distribution.len:
    index -= distribution[i].weight
    if index >= 0'i32:
      continue
    return some(distribution[i].data)
  none[E]()

proc toJson*(self: Pool): JsonValue =
  jsonNull()

proc fromJson*(t: typedesc[Pool], j: JsonValue): SerdeResult[Pool] =
  ## A derived unit struct.
  if j.kind == jvNull: serdeOk(Pool())
  else: serdeErr[Pool](invalidType(j, "unit struct Pool"))

proc toJson*[E](self: Weighted[E]): JsonValue =
  mixin toJson
  result = jsonObject()
  result.put("data", toJson(self.data))
  result.put("weight", jsonI32(self.weight))

proc fromJson*[E](t: typedesc[Weighted[E]], j: JsonValue): SerdeResult[Weighted[E]] =
  mixin fromJson
  if j.kind != jvObject:
    return serdeErr[Weighted[E]](invalidType(j, "struct Weighted"))
  let i = find(j, "data")
  if i < 0:
    return serdeErr[Weighted[E]]("missing field `data`")
  let data = fromJson(E, j.vals[i])
  serdeCheck(data, Weighted[E])
  let weight = fieldI32(j, "weight")
  serdeCheck(weight, Weighted[E])
  serdeOk(Weighted[E](data: data.value, weight: weight.value))
