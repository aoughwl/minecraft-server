## Known-answer tests for pool.aowl, with a scripted generator.
import std/[assertions, syncio, options]
import pool
import serdeforms
import ../../codecs/json_value

type
  Scripted = object
    answer: int32
    asked: int32

proc nextBoundedI32(r: var Scripted, bound: int32): int32 =
  r.asked = bound
  r.answer

type
  Item = object
    name: string

proc `==`(a: Item, b: string): bool = a.name == b

proc fromJson*(t: typedesc[Item], j: JsonValue): SerdeResult[Item] =
  if j.kind == jvString: serdeOk(Item(name: j.strVal))
  else: serdeErr[Item](invalidType(j, "a string"))

proc toJson*(s: Item): JsonValue = jsonString(s.name)

proc pick(entries: seq[Weighted[Item]], answer: int32): Item =
  var r = Scripted(answer: answer, asked: -1)
  let got = Pool.get(entries, r)
  got.get

proc w(data: string, weight: int32): Weighted[Item] =
  Weighted[Item](data: Item(name: data), weight: weight)

proc testFlattened() =
  # Total below 64 walks the flattened index.
  let e = @[w("a", 2), w("b", 1), w("c", 3)]
  var r = Scripted(answer: 0, asked: -1)
  discard Pool.get(e, r)
  assert r.asked == 6
  assert pick(e, 0) == "a"
  assert pick(e, 1) == "a"
  assert pick(e, 2) == "b"
  assert pick(e, 3) == "c"
  assert pick(e, 5) == "c"
  # An index outside falls back to the first entry.
  assert pick(e, 6) == "a"

proc testWrapped() =
  # Total of 64 or more walks by subtraction.
  let e = @[w("a", 60), w("b", 4), w("c", 36)]
  var r = Scripted(answer: 0, asked: -1)
  discard Pool.get(e, r)
  assert r.asked == 100
  assert pick(e, 0) == "a"
  assert pick(e, 59) == "a"
  assert pick(e, 60) == "b"
  assert pick(e, 63) == "b"
  assert pick(e, 64) == "c"
  assert pick(e, 99) == "c"
  # An index outside walks off the end: none.
  var over = Scripted(answer: 100, asked: -1)
  assert Pool.get(e, over).isNone

proc testSerde() =
  assert fromJson(Pool, jsonNull()).ok
  assert fromJson(Pool, jsonInt(1'i64)).error == "invalid type: integer `1`, expected unit struct Pool"
  assert toJsonString(toJson(Pool())) == "null"
  let parsed = parseJsonValue("{\"data\":\"x\",\"weight\":3,\"other\":1}")
  assert parsed.ok
  let r = fromJson(Weighted[Item], parsed.value)
  assert r.ok and r.value.data.name == "x" and r.value.weight == 3
  assert toJsonString(toJson(r.value)) == "{\"data\":\"x\",\"weight\":3}"
  assert fromJson(Weighted[Item], parseJsonValue("{\"data\":\"x\"}").value).error == "missing field `weight`"
  assert fromJson(Weighted[Item], parseJsonValue("{\"weight\":1}").value).error == "missing field `data`"
  assert fromJson(Weighted[Item], parseJsonValue("{\"data\":1,\"weight\":1}").value).error ==
    "invalid type: integer `1`, expected a string"

testFlattened()
testWrapped()
testSerde()
echo "pool checks passed"
