## Port of pumpkin-util/src/math/position.rs
##
## Rust's tuple field `.0` is the field `vec`. `Vector3::to_block_pos` lives here because this module
## imports vector3.aowl. A `$` is the `Display` impl.

{.feature: "untyped".}

import std/[options, hashes, math]
from mathmod import getSectionCord, floorDiv, floorMod
import rustnum
import serdeforms
import ../vector2
import ../vector3
import ../../codecs/codec_core
import ../../codecs/json_value
import ../../codecs/list_codec
import ../../nbt/tag

type
  BlockPos* = object
    ## A position in a 3D block grid.
    vec*: Vector3[int32]

  ColumnPos* = object
    ## A position in a 2D block grid on the XZ plane.
    vec*: Vector2[int32]

  BlockPosIterator* = object
    ## Yields all positions within a cuboid region.
    startX, startY, startZ: int32
    endX, endY: int32
    index: uint64
    count: uint64

  OutwardIterator* = object
    ## Yields positions outward from a centre point.
    centerX, centerY, centerZ: int32
    rangeX, rangeY, rangeZ: int32
    maxManhattanDistance: int32
    pos: BlockPos
    manhattanDistance: int32
    limitX, limitY: int32
    dx, dy: int32
    swapZ: bool

func newBlockPos*(x, y, z: int32): BlockPos {.inline.} =
  BlockPos(vec: Vector3[int32](x: x, y: y, z: z))

const BlockPosZero* = BlockPos(vec: Vector3[int32](x: 0'i32, y: 0'i32, z: 0'i32))

proc newColumnPos*(x, z: int32): ColumnPos {.inline.} =
  ColumnPos(vec: Vector2[int32](x: x, y: z))

proc x*(p: BlockPos): int32 {.inline.} = p.vec.x
proc y*(p: BlockPos): int32 {.inline.} = p.vec.y
proc z*(p: BlockPos): int32 {.inline.} = p.vec.z

proc `==`*(a, b: BlockPos): bool {.inline.} = a.vec == b.vec
proc `==`*(a, b: ColumnPos): bool {.inline.} = a.vec == b.vec
proc hash*(p: BlockPos): Hash {.inline.} = hash(p.vec)
proc hash*(p: ColumnPos): Hash {.inline.} = hash(p.vec)

func asCount(value: int32): uint64 {.inline.} =
  ## `i32 as usize`: sign extends.
  cast[uint64](int64(value))

proc newBlockPosIterator*(startX, startY, startZ, endX, endY, endZ: int32): BlockPosIterator =
  let countX = endX - startX + 1'i32
  let countY = endY - startY + 1'i32
  let countZ = endZ - startZ + 1'i32
  BlockPosIterator(startX: startX, startY: startY, startZ: startZ, endX: endX, endY: endY, index: 0'u64,
    count: asCount(countX * countY * countZ))

func next*(self: var BlockPosIterator): Option[BlockPos] =
  if self.index >= self.count:
    return none[BlockPos]()
  let sizeX = asCount(self.endX - self.startX + 1'i32)
  let sizeY = asCount(self.endY - self.startY + 1'i32)
  let xOffset = self.index mod sizeX
  let yOffset = (self.index div sizeX) mod sizeY
  let zOffset = (self.index div sizeX) div sizeY
  let x = self.startX + truncToI32(xOffset)
  let y = self.startY + truncToI32(yOffset)
  let z = self.startZ + truncToI32(zOffset)
  self.index += 1'u64
  some(newBlockPos(x, y, z))

proc newOutwardIterator*(center: BlockPos, rangeX, rangeY, rangeZ: int32): OutwardIterator =
  OutwardIterator(centerX: center.vec.x, centerY: center.vec.y, centerZ: center.vec.z,
    rangeX: rangeX, rangeY: rangeY, rangeZ: rangeZ,
    maxManhattanDistance: rangeX + rangeY + rangeZ,
    pos: BlockPosZero, manhattanDistance: 0'i32, limitX: 0'i32, limitY: 0'i32, dx: 0'i32, dy: 0'i32,
    swapZ: false)

func next*(self: var OutwardIterator): Option[BlockPos] =
  if self.swapZ:
    self.swapZ = false
    self.pos.vec.z = self.centerZ - (self.pos.vec.z - self.centerZ)
    return some(self.pos)
  while true:
    if self.dy > self.limitY:
      self.dx += 1'i32
      if self.dx > self.limitX:
        self.manhattanDistance += 1'i32
        if self.manhattanDistance > self.maxManhattanDistance:
          return none[BlockPos]() # endOfData()
        self.limitX = min(self.rangeX, self.manhattanDistance)
        self.dx = -self.limitX
      self.limitY = min(self.rangeY, self.manhattanDistance - abs(self.dx))
      self.dy = -self.limitY
    let i2 = self.dx
    let j2 = self.dy
    let k2 = self.manhattanDistance - abs(i2) - abs(j2)
    if k2 <= self.rangeZ:
      self.swapZ = k2 != 0'i32
      self.pos = newBlockPos(self.centerX + i2, self.centerY + j2, self.centerZ + k2)
      self.dy += 1'i32
      return some(self.pos)
    self.dy += 1'i32

iterator items*(it: BlockPosIterator): BlockPos =
  var cur = it
  var n = next(cur)
  while n.isSome:
    yield n.get
    n = next(cur)

iterator items*(it: OutwardIterator): BlockPos =
  var cur = it
  var n = next(cur)
  while n.isSome:
    yield n.get
    n = next(cur)

proc iterate*(start, stop: BlockPos): BlockPosIterator =
  ## All positions in the cuboid between two corners.
  newBlockPosIterator(
    min(start.vec.x, stop.vec.x), min(start.vec.y, stop.vec.y), min(start.vec.z, stop.vec.z),
    max(start.vec.x, stop.vec.x), max(start.vec.y, stop.vec.y), max(start.vec.z, stop.vec.z))

proc iterateOutwards*(center: BlockPos, rangeX, rangeY, rangeZ: int32): OutwardIterator {.inline.} =
  newOutwardIterator(center, rangeX, rangeY, rangeZ)

proc iterateBlockPos*(startX, startY, startZ, endX, endY, endZ: int32): BlockPosIterator {.inline.} =
  newBlockPosIterator(startX, startY, startZ, endX, endY, endZ)

proc chunkPosition*(self: BlockPos): Vector2[int32] =
  let zChunk = floorDiv(self.vec.z, 16'i32)
  let xChunk = floorDiv(self.vec.x, 16'i32)
  Vector2[int32](x: xChunk, y: zChunk)

proc chunkRelativePosition*(self: BlockPos): Vector3[int32] =
  ## x and z in [0, 15], y unchanged.
  let zChunk = floorMod(self.vec.z, 16'i32)
  let xChunk = floorMod(self.vec.x, 16'i32)
  Vector3[int32](x: xChunk, y: self.vec.y, z: zChunk)

proc chunkAndChunkRelativePosition*(self: BlockPos): (Vector2[int32], Vector3[int32]) =
  (chunkPosition(self), chunkRelativePosition(self))

proc sectionRelativePosition*(self: BlockPos): Vector3[int32] =
  ## All coordinates in [0, 15].
  Vector3[int32](
    x: floorMod(self.vec.x, 16'i32),
    y: floorMod(self.vec.y, 16'i32),
    z: floorMod(self.vec.z, 16'i32))

proc fromI64*(encodedPosition: int64): BlockPos =
  ## Bits 38-63: X (26 bits), bits 12-37: Z (26 bits), bits 0-11: Y (12 bits).
  BlockPos(vec: Vector3[int32](
    x: int32(encodedPosition shr 38),
    y: int32((encodedPosition shl 52) shr 52),
    z: int32((encodedPosition shl 26) shr 38)))

proc floored*(x, y, z: float64): BlockPos =
  newBlockPos(asI32(floor(x)), asI32(floor(y)), asI32(floor(z)))

proc flooredV*(pos: Vector3[float64]): BlockPos =
  newBlockPos(asI32(floor(pos.x)), asI32(floor(pos.y)), asI32(floor(pos.z)))

proc ceiledV*(pos: Vector3[float64]): BlockPos =
  newBlockPos(asI32(ceil(pos.x)), asI32(ceil(pos.y)), asI32(ceil(pos.z)))

proc toF64*(self: BlockPos): Vector3[float64] =
  ## Centred on x and z, exact y.
  Vector3[float64](x: float64(self.vec.x) + 0.5, y: float64(self.vec.y), z: float64(self.vec.z) + 0.5)

proc toCenteredF64*(self: BlockPos): Vector3[float64] =
  Vector3[float64](x: float64(self.vec.x) + 0.5, y: float64(self.vec.y) + 0.5, z: float64(self.vec.z) + 0.5)

proc offset*(self: BlockPos, offset: Vector3[int32]): BlockPos =
  BlockPos(vec: self.vec + offset)

proc add*(self: BlockPos, x, y, z: int32): BlockPos =
  newBlockPos(self.vec.x + x, self.vec.y + y, self.vec.z + z)

proc offsetDir*(self: BlockPos, offset: Vector3[int32], direction: int32): BlockPos =
  newBlockPos(self.vec.x + offset.x * direction, self.vec.y + offset.y * direction,
    self.vec.z + offset.z * direction)

proc up*(self: BlockPos): BlockPos = offset(self, vec3[int32](0'i32, 1'i32, 0'i32))
proc upHeight*(self: BlockPos, height: int32): BlockPos = offset(self, vec3[int32](0'i32, height, 0'i32))
proc down*(self: BlockPos): BlockPos = offset(self, vec3[int32](0'i32, -1'i32, 0'i32))
proc downHeight*(self: BlockPos, height: int32): BlockPos = offset(self, vec3[int32](0'i32, -height, 0'i32))
proc west*(self: BlockPos): BlockPos = offset(self, vec3[int32](-1'i32, 0'i32, 0'i32))
proc north*(self: BlockPos): BlockPos = offset(self, vec3[int32](0'i32, 0'i32, -1'i32))
proc east*(self: BlockPos): BlockPos = offset(self, vec3[int32](1'i32, 0'i32, 0'i32))
proc south*(self: BlockPos): BlockPos = offset(self, vec3[int32](0'i32, 0'i32, 1'i32))

proc manhattanDistance*(self, other: BlockPos): int32 =
  abs(other.vec.x - self.vec.x) + abs(other.vec.y - self.vec.y) + abs(other.vec.z - self.vec.z)

proc squaredDistance*(self, other: BlockPos): int32 =
  squaredDistanceToVec(self.vec, other.vec)

proc asLong*(self: BlockPos): int64 =
  ## Bits 38-63: X (26 bits), bits 12-37: Z (26 bits), bits 0-11: Y (12 bits).
  ((int64(self.vec.x) and 0x03FF_FFFF'i64) shl 38) or
    ((int64(self.vec.z) and 0x03FF_FFFF'i64) shl 12) or
    (int64(self.vec.y) and 0xFFF'i64)

proc toBlockPos*[T: Arithmetic](v: Vector3[T]): BlockPos =
  ## `Vector3::to_block_pos`: rounds each component.
  BlockPos(vec: toI32(v))

proc `$`*(self: BlockPos): string =
  $self.vec.x & ", " & $self.vec.y & ", " & $self.vec.z

# --- serde: an i64 ---------------------------------------------------------------------------------

proc toJson*(self: BlockPos): JsonValue =
  jsonInt(asLong(self))

proc fromJson*(t: typedesc[BlockPos], j: JsonValue): SerdeResult[BlockPos] =
  ## Upstream's visitor has only `visit_i64`, so serde_json, which hands a non-negative number to `visit_u64`,
  ## would refuse every position with x >= 0. This accepts them: NBT and the wire are the forms upstream uses.
  if j.kind != jvInt:
    return serdeErr[BlockPos](invalidType(j, "An i64 int"))
  serdeOk(fromI64(j.intVal))

proc toNbt*(self: BlockPos): NbtTag =
  NbtTag(kind: ntkLong, longVal: asLong(self))

proc fromNbt*(t: typedesc[BlockPos], tag: NbtTag): SerdeResult[BlockPos] =
  let r = nbtReadI64(tag)
  if not r.ok:
    return serdeErr[BlockPos]("invalid type: expected An i64 int")
  serdeOk(fromI64(r.value))

# --- Encode and Decode: an IntStream ---------------------------------------------------------------

proc toIntStream*(value: BlockPos): IntStream =
  ## `From<&BlockPos> for IntStream`.
  intStream(@[value.vec.x, value.vec.y, value.vec.z])

proc flatTryFrom*(target: typedesc[BlockPos], value: IntStream): DataResult[BlockPos] =
  let d = validateFixedSize(value.data, 3)
  if not d.hasResultOrPartial:
    return propagateError[seq[int32], BlockPos](d)
  let v = d.valueOrPartial
  flatMapJoin(d, newSuccess(newBlockPos(v[0], v[1], v[2])))

proc blockPosFromIntStream(value: IntStream): DataResult[BlockPos] =
  flatTryFrom(BlockPos, value)

comapFlatMapCodecImpl(IntStream, BlockPos, blockPosFromIntStream, toIntStream)

# --- section helpers -------------------------------------------------------------------------------

proc chunkSectionFromPos*(blockPos: BlockPos): Vector3[int32] =
  let v = blockPos.vec
  Vector3[int32](x: getSectionCord(v.x), y: getSectionCord(v.y), z: getSectionCord(v.z))

proc getLocalCord*(cord: int32): int32 {.inline.} =
  ## Bits 0-3 of a coordinate, in [0, 15].
  cord and 15'i32

proc packLocalChunkSection*(blockPos: BlockPos): int16 =
  let x = getLocalCord(blockPos.vec.x)
  let z = getLocalCord(blockPos.vec.z)
  let y = getLocalCord(blockPos.vec.y)
  packedLocal(Vector3[int32](x: x, y: y, z: z))
