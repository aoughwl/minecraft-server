## Known-answer tests for position.aowl.
import std/[assertions, syncio, options, hashes]
import position
import serdeforms
import ../vector2
import ../vector3
import ../../codecs/codec_core
import ../../codecs/json_value
import ../../nbt/nbt_ops
import ../../nbt/tag

proc checkPacked(x, y, z: int32, packed: int64) =
  let p = newBlockPos(x, y, z)
  assert asLong(p) == packed, $p & " packed to " & $asLong(p)
  let back = fromI64(packed)
  assert back == p, $packed & " unpacked to " & $back

proc testPacking() =
  checkPacked(0, 0, 0, 0'i64)
  checkPacked(1, 2, 3, 274877919234'i64)
  checkPacked(-1, -1, -1, -1'i64)
  checkPacked(-1000, 200, 4521, -274877888425784'i64)
  checkPacked(33554431, 2047, 33554431, 9223371899415820287'i64)
  checkPacked(-33554432, -2048, -33554432, -9223371899415820288'i64)
  checkPacked(0, -64, 0, 4032'i64)
  checkPacked(-1, 0, 0, -274877906944'i64)
  checkPacked(0, 0, -1, 274877902848'i64)
  checkPacked(30000000, 319, -30000000, 8246337360317907263'i64)
  # Out-of-field values are masked on the way in, and sign-extend on the way out.
  assert asLong(newBlockPos(33554432, 0, 0)) == low(int64)
  assert fromI64(asLong(newBlockPos(33554432, 2048, 0))) == newBlockPos(-33554432, -2048, 0)

proc collect(it: BlockPosIterator): seq[BlockPos] =
  result = @[]
  for p in items(it):
    result.add p

proc collect(it: OutwardIterator): seq[BlockPos] =
  result = @[]
  for p in items(it):
    result.add p

proc testIterators() =
  let b = collect(iterate(newBlockPos(1, 0, 5), newBlockPos(0, 1, 5)))
  assert b.len == 4
  assert b[0] == newBlockPos(0, 0, 5) and b[1] == newBlockPos(1, 0, 5)
  assert b[2] == newBlockPos(0, 1, 5) and b[3] == newBlockPos(1, 1, 5)
  let z = collect(iterateBlockPos(0, 0, 0, 0, 0, 1))
  assert z.len == 2 and z[0] == newBlockPos(0, 0, 0) and z[1] == newBlockPos(0, 0, 1)
  assert collect(iterateBlockPos(1, 0, 0, 0, 0, 0)).len == 0
  var it = iterateBlockPos(3, 3, 3, 3, 3, 3)
  assert next(it).get == newBlockPos(3, 3, 3)
  assert next(it).isNone

  # Hand-stepped from the Rust.
  let xLine = collect(iterateOutwards(BlockPosZero, 1, 0, 0))
  assert xLine.len == 3
  assert xLine[0] == newBlockPos(0, 0, 0) and xLine[1] == newBlockPos(-1, 0, 0) and xLine[2] == newBlockPos(1, 0, 0)
  let zLine = collect(iterateOutwards(BlockPosZero, 0, 0, 1))
  assert zLine.len == 3
  assert zLine[0] == newBlockPos(0, 0, 0) and zLine[1] == newBlockPos(0, 0, 1) and zLine[2] == newBlockPos(0, 0, -1)
  let around = collect(iterateOutwards(newBlockPos(10, 20, 30), 1, 1, 1))
  assert around.len == 27
  assert around[0] == newBlockPos(10, 20, 30)
  assert around[1] == newBlockPos(9, 20, 30)
  assert around[2] == newBlockPos(10, 19, 30)
  assert around[3] == newBlockPos(10, 20, 31)
  assert around[4] == newBlockPos(10, 20, 29)
  assert around[5] == newBlockPos(10, 21, 30)
  assert around[6] == newBlockPos(11, 20, 30)
  assert around[26] == newBlockPos(11, 21, 29)

proc testChunk() =
  let p = newBlockPos(-1, -65, 17)
  assert chunkPosition(p) == vec2[int32](-1, 1)
  assert chunkRelativePosition(p) == vec3[int32](15, -65, 1)
  let both = chunkAndChunkRelativePosition(p)
  assert both[0] == vec2[int32](-1, 1) and both[1] == vec3[int32](15, -65, 1)
  assert sectionRelativePosition(p) == vec3[int32](15, 15, 1)
  assert chunkPosition(newBlockPos(-16, 0, -17)) == vec2[int32](-1, -2)
  assert chunkRelativePosition(newBlockPos(-16, 0, -17)) == vec3[int32](0, 0, 15)
  assert chunkSectionFromPos(p) == vec3[int32](-1, -5, 1)
  assert getLocalCord(-1) == 15 and getLocalCord(16) == 0
  assert packLocalChunkSection(newBlockPos(-1, -65, 17)) == int16((15 shl 8) or (1 shl 4) or 15)

proc testMoves() =
  assert floored(-0.5, 1.5, 2.0) == newBlockPos(-1, 1, 2)
  assert flooredV(vec3[float64](-0.5, 1.5, 2.0)) == newBlockPos(-1, 1, 2)
  assert ceiledV(vec3[float64](-0.5, 1.5, 2.0)) == newBlockPos(0, 2, 2)
  assert floored(3e10, -3e10, NaN) == newBlockPos(int32.high, int32.low, 0)
  assert toF64(newBlockPos(1, 2, -3)) == vec3[float64](1.5, 2.0, -2.5)
  assert toCenteredF64(newBlockPos(1, 2, -3)) == vec3[float64](1.5, 2.5, -2.5)
  let p = newBlockPos(1, 2, 3)
  assert offset(p, vec3[int32](1, 1, 1)) == newBlockPos(2, 3, 4)
  assert add(p, -1, -2, -3) == BlockPosZero
  assert offsetDir(p, vec3[int32](1, 0, -1), 3) == newBlockPos(4, 2, 0)
  assert up(p) == newBlockPos(1, 3, 3)
  assert upHeight(p, 5) == newBlockPos(1, 7, 3)
  assert down(p) == newBlockPos(1, 1, 3)
  assert downHeight(p, 5) == newBlockPos(1, -3, 3)
  assert west(p) == newBlockPos(0, 2, 3)
  assert north(p) == newBlockPos(1, 2, 2)
  assert east(p) == newBlockPos(2, 2, 3)
  assert south(p) == newBlockPos(1, 2, 4)
  assert manhattanDistance(p, newBlockPos(-1, 5, 3)) == 5
  assert squaredDistance(p, newBlockPos(-1, 5, 3)) == 13
  assert toBlockPos(vec3[float64](1.5, -2.5, 2.4)) == newBlockPos(2, -3, 2)
  assert $newBlockPos(-1000, 200, 4521) == "-1000, 200, 4521"
  assert p.x == 1 and p.y == 2 and p.z == 3
  assert hash(p) == hash(newBlockPos(1, 2, 3))
  assert hash(p) != hash(newBlockPos(3, 2, 1))
  assert newColumnPos(1, 2) == ColumnPos(vec: vec2[int32](1, 2))

proc testSerde() =
  assert toJsonString(toJson(newBlockPos(1, 2, 3))) == "274877919234"
  assert toJsonString(toJson(newBlockPos(-1, -1, -1))) == "-1"
  let r = fromJson(BlockPos, jsonInt(274877919234'i64))
  assert r.ok and r.value == newBlockPos(1, 2, 3)
  assert not fromJson(BlockPos, jsonString("1")).ok
  assert not fromJson(BlockPos, jsonFloat(1.0)).ok
  let n = toNbt(newBlockPos(-1000, 200, 4521))
  assert n.kind == ntkLong and n.longVal == -274877888425784'i64
  let back = fromNbt(BlockPos, n)
  assert back.ok and back.value == newBlockPos(-1000, 200, 4521)
  let small = fromNbt(BlockPos, NbtTag(kind: ntkInt, intVal: -1'i32))
  assert small.ok and small.value == newBlockPos(-1, -1, -1)
  assert not fromNbt(BlockPos, NbtTag(kind: ntkFloat, floatVal: 1.0'f32)).ok

proc i(x: int32): NbtTag = NbtTag(kind: ntkInt, intVal: x)

proc testCodec() =
  # Upstream's `codec` test.
  let ops = nbtOps()
  assertEncodeSuccess(newBlockPos(1, 2, 3), ops, NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32, 3'i32]))
  assertEncodeSuccess(newBlockPos(-1000, 200, 4521), ops,
    NbtTag(kind: ntkIntArray, intArrayVal: @[-1000'i32, 200'i32, 4521'i32]))
  assertDecodeIsSuccess(BlockPos, NbtTag(kind: ntkIntArray, intArrayVal: @[1'i32, 2'i32, 3'i32]), ops)
  assertDecodeIsError(BlockPos, NbtTag(kind: ntkList, listVal: @[]), ops)
  assertDecodeIsSuccess(BlockPos, NbtTag(kind: ntkList, listVal: @[
    i(1), NbtTag(kind: ntkFloat, floatVal: 2.0'f32), i(3)]), ops)
  assertDecodeIsError(BlockPos, NbtTag(kind: ntkList, listVal: @[
    i(1), NbtTag(kind: ntkFloat, floatVal: 2.0'f32), NbtTag(kind: ntkString, stringVal: "69")]), ops)
  assertDecodeIsError(BlockPos, NbtTag(kind: ntkList, listVal: @[
    i(1), NbtTag(kind: ntkFloat, floatVal: 2.0'f32), i(3), NbtTag(kind: ntkByte, byteVal: 3'i8)]), ops)
  let parsed = parse(BlockPos, NbtTag(kind: ntkIntArray, intArrayVal: @[-1000'i32, 200'i32, 4521'i32]), ops)
  assert parsed.isSuccess and parsed.successResult == newBlockPos(-1000, 200, 4521)
  # A float element truncates through the Number form.
  let viaFloat = parse(BlockPos, NbtTag(kind: ntkList, listVal: @[
    i(1), NbtTag(kind: ntkFloat, floatVal: 2.0'f32), i(3)]), ops)
  assert viaFloat.successResult == newBlockPos(1, 2, 3)
  assert toIntStream(newBlockPos(4, 5, 6)).data == @[4'i32, 5'i32, 6'i32]
  assert flatTryFrom(BlockPos, intStream(@[4'i32, 5'i32])).message == "Input is not a list of 3 elements"

testPacking()
testIterators()
testChunk()
testMoves()
testSerde()
testCodec()
echo "position checks passed"
