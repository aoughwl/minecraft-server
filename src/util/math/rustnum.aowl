## Rust number semantics the pumpkin-util/src/math ports share. Support module with no upstream file of
## its own: saturating `as i32`, fused `mul_add`, panicking `clamp`, and NaN-ignoring `f64::max`.

import std/assertions

proc fma(x, y, z: cdouble): cdouble {.importc: "fma", header: "<math.h>".}
proc fmaf(x, y, z: cfloat): cfloat {.importc: "fmaf", header: "<math.h>".}

proc mulAdd*(x, y, z: float32): float32 {.inline.} =
  ## `f32::mul_add`: x * y + z with one rounding, which `x * y + z` does not give.
  float32(fmaf(cfloat(x), cfloat(y), cfloat(z)))

proc mulAdd*(x, y, z: float64): float64 {.inline.} =
  ## `f64::mul_add`.
  float64(fma(cdouble(x), cdouble(y), cdouble(z)))

proc asI32*(value: float64): int32 =
  ## `as i32`: NaN gives 0, out-of-range values saturate.
  if value != value: 0'i32
  elif value >= 2147483648.0'f64: int32.high
  elif value <= -2147483648.0'f64: int32.low
  else: int32(value)

proc asI32*(value: float32): int32 {.inline.} =
  asI32(float64(value))

func truncToI32*(value: uint64): int32 {.inline.} =
  ## `usize as i32`: keeps the low 32 bits.
  cast[int32](uint32(value and 0xFFFF_FFFF'u64))

proc clamp*(value, lo, hi: int32): int32 {.inline.} =
  ## `i32::clamp`, which panics when lo > hi.
  assert lo <= hi
  if value < lo: lo
  elif value > hi: hi
  else: value

proc clamp*(value, lo, hi: float32): float32 {.inline.} =
  ## `f32::clamp`: panics when lo > hi or a bound is NaN, and a NaN value stays NaN.
  assert lo <= hi
  if value < lo: lo
  elif value > hi: hi
  else: value

proc maxF64*(a, b: float64): float64 {.inline.} =
  ## `f64::max`: when one side is NaN the other is returned.
  if a != a: b
  elif b != b: a
  elif a > b: a
  else: b

proc isSignPositive*(value: float64): bool {.inline.} =
  ## `f64::is_sign_positive`: reads the sign bit, so it also answers for -0.0 and NaN.
  (cast[uint64](value) shr 63) == 0'u64
