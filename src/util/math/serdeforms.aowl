## The serde data shapes the pumpkin-util/src/math ports share. Support module with no upstream file of its
## own: the result of a typed conversion, serde's type-error text, struct fields read from a `JsonValue`,
## the numeric widening serde does for NBT, and `serialize_bytes` in JSON and NBT.

{.feature: "untyped".}

import ../../codecs/json_value
import ../../nbt/tag

type
  SerdeResult*[T] = object
    ## Result of `fromJson`/`fromNbt`. `value` is only meaningful when `ok`.
    ok*: bool
    value*: T
    error*: string

proc serdeOk*[T](value: sink T): SerdeResult[T] =
  SerdeResult[T](ok: true, value: value, error: "")

proc serdeErr*[T](message: string): SerdeResult[T] =
  result = SerdeResult[T](ok: false, error: message)

template serdeCheck*(r, R: untyped) {.untyped.} =
  ## Returns the error of the local result `r` as a `SerdeResult[R]`.
  if not r.ok:
    return serdeErr[R](r.error)

proc unexpected*(j: JsonValue): string =
  ## serde's `Unexpected` text for a JSON value.
  case j.kind
  of jvNull: "null"
  of jvBool: "boolean `" & (if j.boolVal: "true" else: "false") & "`"
  of jvInt: "integer `" & $j.intVal & "`"
  of jvUInt: "integer `" & $j.uintVal & "`"
  of jvFloat: "floating point `" & displayF64(j.floatVal) & "`"
  of jvString: "string " & toJsonString(j)
  of jvArray: "sequence"
  of jvObject: "map"

proc invalidType*(j: JsonValue, expected: string): string =
  "invalid type: " & unexpected(j) & ", expected " & expected

proc readI32*(j: JsonValue): SerdeResult[int32] =
  ## A JSON number as i32. serde refuses floats and out-of-range integers.
  case j.kind
  of jvInt:
    if j.intVal >= int64(int32.low) and j.intVal <= int64(int32.high):
      serdeOk(int32(j.intVal))
    else:
      serdeErr[int32]("invalid value: integer `" & $j.intVal & "`, expected i32")
  of jvUInt:
    serdeErr[int32]("invalid value: integer `" & $j.uintVal & "`, expected i32")
  else:
    serdeErr[int32](invalidType(j, "i32"))

proc readF64*(j: JsonValue): SerdeResult[float64] =
  ## A JSON number as f64. serde takes integers too.
  case j.kind
  of jvInt: serdeOk(float64(j.intVal))
  of jvUInt: serdeOk(float64(j.uintVal))
  of jvFloat: serdeOk(j.floatVal)
  else: serdeErr[float64](invalidType(j, "f64"))

proc readF32*(j: JsonValue): SerdeResult[float32] =
  ## A JSON number as f32. serde parses to f64 and then narrows, so the double rounding is upstream's too.
  case j.kind
  of jvInt: serdeOk(float32(j.intVal))
  of jvUInt: serdeOk(float32(j.uintVal))
  of jvFloat: serdeOk(float32(j.floatVal))
  else: serdeErr[float32](invalidType(j, "f32"))

proc fieldI32*(j: JsonValue, name: string): SerdeResult[int32] =
  ## A required struct field. Unknown fields are ignored by callers, as derived structs ignore them.
  let i = find(j, name)
  if i < 0: serdeErr[int32]("missing field `" & name & "`")
  else: readI32(j.vals[i])

proc fieldF32*(j: JsonValue, name: string): SerdeResult[float32] =
  let i = find(j, name)
  if i < 0: serdeErr[float32]("missing field `" & name & "`")
  else: readF32(j.vals[i])

proc jsonF32*(f: float32): JsonValue {.inline.} =
  ## `serde_json::to_value` of an f32, which widens to f64.
  jsonFloat(float64(f))

proc jsonI32*(i: int32): JsonValue {.inline.} =
  jsonInt(int64(i))

proc bytesToJson*(bytes: seq[byte]): JsonValue =
  ## `serialize_bytes` on serde_json's serializer: an array of numbers.
  var items: seq[JsonValue] = @[]
  for b in bytes:
    items.add jsonInt(int64(b))
  jsonArray(items)

proc bytesToNbt*(bytes: seq[byte]): NbtTag =
  ## `serialize_bytes` on pumpkin-nbt's serializer: a list of bytes.
  var items: seq[NbtTag] = @[]
  for b in bytes:
    items.add NbtTag(kind: ntkByte, byteVal: cast[int8](b))
  NbtTag(kind: ntkList, listVal: items)

proc putBe*(buf: var seq[byte], value: uint16) =
  buf.add byte(value shr 8)
  buf.add byte(value and 0xFF'u16)

proc putBe*(buf: var seq[byte], value: uint32) =
  var shift = 24
  while shift >= 0:
    buf.add byte((value shr shift) and 0xFF'u32)
    shift -= 8

proc putBe*(buf: var seq[byte], value: uint64) =
  var shift = 56
  while shift >= 0:
    buf.add byte((value shr shift) and 0xFF'u64)
    shift -= 8

proc nbtElements*(tag: NbtTag): (bool, seq[NbtTag]) =
  ## What pumpkin-nbt's `deserialize_any` visits as a sequence: a list or any of the three array tags.
  var items: seq[NbtTag] = @[]
  case tag.kind
  of ntkList:
    items = tag.listVal
  of ntkByteArray:
    for b in tag.byteArrayVal: items.add NbtTag(kind: ntkByte, byteVal: b)
  of ntkIntArray:
    for i in tag.intArrayVal: items.add NbtTag(kind: ntkInt, intVal: i)
  of ntkLongArray:
    for l in tag.longArrayVal: items.add NbtTag(kind: ntkLong, longVal: l)
  else:
    return (false, items)
  (true, items)

proc nbtReadI64*(tag: NbtTag): SerdeResult[int64] =
  ## Any signed integer tag: a visitor's default `visit_i8`..`visit_i32` forward to `visit_i64`.
  case tag.kind
  of ntkByte: serdeOk(int64(tag.byteVal))
  of ntkShort: serdeOk(int64(tag.shortVal))
  of ntkInt: serdeOk(int64(tag.intVal))
  of ntkLong: serdeOk(tag.longVal)
  else: serdeErr[int64]("invalid type: expected an integer tag")

proc nbtReadI32*(tag: NbtTag): SerdeResult[int32] =
  let r = nbtReadI64(tag)
  if not r.ok:
    serdeErr[int32](r.error)
  elif r.value < int64(int32.low) or r.value > int64(int32.high):
    serdeErr[int32]("invalid value: integer `" & $r.value & "`, expected i32")
  else:
    serdeOk(int32(r.value))

proc nbtReadF64*(tag: NbtTag): SerdeResult[float64] =
  ## serde's float visitors take every numeric tag.
  case tag.kind
  of ntkFloat: serdeOk(float64(tag.floatVal))
  of ntkDouble: serdeOk(tag.doubleVal)
  else:
    let r = nbtReadI64(tag)
    if r.ok: serdeOk(float64(r.value))
    else: serdeErr[float64]("invalid type: expected a numeric tag")

proc nbtReadF32*(tag: NbtTag): SerdeResult[float32] =
  case tag.kind
  of ntkFloat: serdeOk(tag.floatVal)
  of ntkDouble: serdeOk(float32(tag.doubleVal))
  else:
    let r = nbtReadI64(tag)
    if r.ok: serdeOk(float32(r.value))
    else: serdeErr[float32]("invalid type: expected a numeric tag")
