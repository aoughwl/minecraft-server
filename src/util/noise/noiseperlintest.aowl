## Every #[test] in pumpkin-util/src/noise/perlin.rs. The chunk and map tests read upstream's own JSON from the
## pinned tree when they run, relative to the repo root (the directory t.sh runs from). A missing file fails the test.
## The vector tables are copied from the Rust by a script, not retyped.

import std/syncio
import std/parseutils
import ../random/random
import ../xoroshiro128 as xr
import ../legacy_rand as lr
import ./perlin

const Assets = "../ref/pumpkin-1.21.11/pumpkin-util/assets/"

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

proc numbersIn(path: string): seq[string] =
  ## The number tokens of a JSON file of nested number arrays.
  let text = try: readFile(path) except: ""
  if text.len == 0:
    echo "FAILED: cannot read ", path
    quit(1)
  result = @[]
  var i = 0
  while i < text.len:
    let c = text[i]
    if c == '-' or (c >= '0' and c <= '9'):
      var j = i + 1
      while j < text.len and text[j] != ',' and text[j] != ']' and text[j] != ' ' and text[j] != '\n' and text[j] != '\r':
        j += 1
      result.add text.substr(i, j - 1)
      i = j
    else:
      i += 1

proc toInt(token: string): int =
  var negative = false
  var value = 0
  for c in token:
    if c == '-':
      negative = true
    elif c >= '0' and c <= '9':
      value = value * 10 + (ord(c) - ord('0'))
    else:
      echo "FAILED: bad int ", token
      quit(1)
  if negative: -value else: value

proc toFloat(token: string): float64 =
  var value = 0.0'f64
  if parseBiggestFloat(token, value) != token.len:
    echo "FAILED: bad float ", token
    quit(1)
  value

proc assertEqDelta(x, y, d: float64, what: string) =
  ## upstream's assert_eq_delta!
  if 2.0'f64 * abs(x - y) > d * (abs(x) + abs(y)):
    echo "FAILED: ", what, " ", x, " vs ", y
    quit(1)

