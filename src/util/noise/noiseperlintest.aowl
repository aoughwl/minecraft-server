proc terrainSampler(): PerlinNoiseSampler =
  var rand0 = xr.fromSeed(0'u64)
  let splitter = rand0.nextSplitter()
  var probe = splitter.splitString("minecraft:terrain")
  check(probe.nextI32() == 1374487555'i32, "minecraft:terrain first value")
  var rand = splitter.splitString("minecraft:terrain")
  var octaves: seq[int32] = @[]
  for o in -15 .. 0:
    octaves.add int32(o)
  let (first, amplitudes) = calculateAmplitudes(octaves)
  let sampler = newOctavePerlinNoiseSampler(rand, first, amplitudes, true)
  result = sampler.samplers[sampler.samplers.len - 1].sampler
  check(result.xOrigin == 18.223354299069797, "terrain x origin")
  check(result.yOrigin == 93.99298907803595, "terrain y origin")
  check(result.zOrigin == 184.48198875745823, "terrain z origin")

block createXoroshiro:
  var rand = xr.fromSeed(513513513'u64)
  check(rand.nextI32() == 404174895'i32, "first value")
  let (start, amplitudes) = calculateAmplitudes([1'i32, 2'i32, 3'i32])
  check(start == 1'i32, "start")
  check(amplitudes == @[1.0'f64, 1.0'f64, 1.0'f64], "amplitudes")
  let sampler = newOctavePerlinNoiseSampler(rand, start, amplitudes, false)
  check(sampler.samplers[0].persistence == 0.5714285714285714, "persistence")
  check(sampler.samplers[0].lacunarity == 2.0, "lacunarity")
  check(sampler.maxValue() == 2.0, "max value")
  let coords = [
    [210.19539348148294'f64, 203.08258445596215'f64, 45.29925114984684'f64],
    [24.841250686920773'f64, 181.62678157390076'f64, 69.49871248131629'f64],
    [21.65886467061867'f64, 97.80131502331685'f64, 225.9273676334467'f64],
  ]
  for i in 0 ..< 3:
    check(sampler.samplers[i].sampler.xOrigin == coords[i][0], "x origin")
    check(sampler.samplers[i].sampler.yOrigin == coords[i][1], "y origin")
    check(sampler.samplers[i].sampler.zOrigin == coords[i][2], "z origin")

block createLegacy:
  var rand = lr.fromSeed(513513513'u64)
  check(rand.nextI32() == -1302745855'i32, "first value")
  let (start, amplitudes) = calculateAmplitudes([0'i32])
  check(start == 0'i32, "start")
  check(amplitudes == @[1.0'f64], "amplitudes")
  let sampler = newOctavePerlinNoiseSampler(rand, start, amplitudes, true)
  check(sampler.samplers[0].persistence == 1.0, "persistence")
  check(sampler.samplers[0].lacunarity == 1.0, "lacunarity")
  check(sampler.maxValue() == 2.0, "max value")
  check(sampler.samplers[0].sampler.xOrigin == 226.220117499588, "x origin")
  check(sampler.samplers[0].sampler.yOrigin == 32.67924779023767, "y origin")
  check(sampler.samplers[0].sampler.zOrigin == 202.84067325597647, "z origin")

block create:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newPerlinNoiseSampler(rand)
  check(sampler.xOrigin == 48.58072036717974, "x origin")
  check(sampler.yOrigin == 110.73235882678037, "y origin")
  check(sampler.zOrigin == 65.26438852860176, "z origin")
  check(sampler.permutation == expectedPermutation, "permutation")

block noY:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newPerlinNoiseSampler(rand)
  for i in 0 ..< noYValues.len:
    let v = noYValues[i]
    check(sampler.sampleFlatY(v[0], v[1], v[2]) == v[3], "no_y " & $i)

block noYChunk:
  let sampler = terrainSampler()
  let data = numbersIn(Assets & "perlin2_7_4.json")
  check(data.len > 0 and data.len mod 4 == 0, "perlin2_7_4.json shape")
  var i = 0
  while i < data.len:
    let scale = 0.005'f64
    let x = float64(toInt(data[i])) * scale
    let y = float64(toInt(data[i + 1])) * scale
    let z = float64(toInt(data[i + 2])) * scale
    assertEqDelta(sampler.sampleFlatY(x, y, z), toFloat(data[i + 3]), F64Epsilon, "no_y_chunk " & $(i div 4))
    i += 4
  echo "no_y_chunk: ", data.len div 4, " points"

block noFade:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newPerlinNoiseSampler(rand)
  for i in 0 ..< noFadeValues.len:
    let v = noFadeValues[i]
    check(sampler.sampleNoFade(v[0], v[1], v[2], v[3], v[4]) == v[5], "no_fade " & $i)

block noFadeChunk:
  let sampler = terrainSampler()
  let data = numbersIn(Assets & "perlin_7_4.json")
  check(data.len > 0 and data.len mod 4 == 0, "perlin_7_4.json shape")
  var i = 0
  while i < data.len:
    let scale = 0.005'f64
    let maxY = scale * 2.0'f64
    let x = float64(toInt(data[i])) * scale
    let y = float64(toInt(data[i + 1])) * scale
    let z = float64(toInt(data[i + 2])) * scale
    assertEqDelta(sampler.sampleNoFade(x, y, z, scale, maxY), toFloat(data[i + 3]), F64Epsilon, "no_fade_chunk " & $(i div 4))
    i += 4
  echo "no_fade_chunk: ", data.len div 4, " points"

block mapTest:
  let sampler = terrainSampler()
  let data = numbersIn(Assets & "perlin_map.json")
  check(data.len == 1024, "perlin_map.json has one value per x")
  for x in -512 ..< 512:
    check(int(sampler.map(int32(x))) == toInt(data[x + 512]), "map " & $x)

block octaveSampleAndTotals:
  # Own known answers from an independent Python oracle written from the Rust text, upstream has none.
  var rand = xr.fromSeed(111'u64)
  let (first, amplitudes) = calculateAmplitudes([-2'i32, -1'i32, 0'i32])
  check(first == -2'i32, "first octave")
  let sampler = newOctavePerlinNoiseSampler(rand, first, amplitudes, false)
  check(sampler.getTotalAmplitude(1.5) == 1.4999999999999998'f64, "get_total_amplitude")
  check(sampler.sample(12.5, -3.25, 100000000.75) == -0.06624926862689888'f64, "octave sample")
  check(maintainPrecision(33554432.0) == 0.0, "maintain_precision of a period")
  check(maintainPrecision(16777216.0) == -16777216.0, "maintain_precision rounds up at half")
  check(maintainPrecision(5.5) == 5.5, "maintain_precision near the origin")

echo "noise/perlin: all upstream test vectors matched"
