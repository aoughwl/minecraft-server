## pumpkin-util/src/noise/mod.rs has no #[test]. Own known answers for the table, read off the Rust constant, and
## for `dot`.

import std/syncio
import ./noise

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

let expected: array[16, array[3, float64]] = [
  [1.0, 1.0, 0.0], [-1.0, 1.0, 0.0], [1.0, -1.0, 0.0], [-1.0, -1.0, 0.0],
  [1.0, 0.0, 1.0], [-1.0, 0.0, 1.0], [1.0, 0.0, -1.0], [-1.0, 0.0, -1.0],
  [0.0, 1.0, 1.0], [0.0, -1.0, 1.0], [0.0, 1.0, -1.0], [0.0, -1.0, -1.0],
  [1.0, 1.0, 0.0], [0.0, -1.0, 1.0], [-1.0, 1.0, 0.0], [0.0, -1.0, -1.0],
]

for i in 0 ..< 16:
  let g = Gradients[i]
  check(g.x == expected[i][0] and g.y == expected[i][1] and g.z == expected[i][2], "gradient " & $i)
  # Powers of two so the sums are exact.
  let want = expected[i][0] * 0.5 + expected[i][1] * 0.25 + expected[i][2] * 0.125
  check(g.dot(0.5, 0.25, 0.125) == want, "dot " & $i)

check(Gradients[4].dot(2.0, 100.0, -3.0) == -1.0, "dot of gradient 4 ignores y")
check(Gradients[15].dot(100.0, 2.0, 3.0) == -5.0, "dot of gradient 15 ignores x")

echo "noise: all checks passed"
