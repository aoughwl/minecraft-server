## Port of pumpkin-util/src/noise/simplex.rs
##
## `impl RandomImpl` becomes a plain generic `[R]`. Upstream's `PartialEq`/`Hash` compare origins by bit pattern.

{.feature: "untyped".}

import std/math
import std/options
import std/assertions
import std/hashes
import ../noisegrad
import ../legacy_rand
import ../random/rustnum
import ../random/random

const
  Sqrt3 = 1.7320508075688772'f64
  SkewFactor2D = 0.5'f64 * (Sqrt3 - 1.0'f64)
  UnskewFactor2D = (3.0'f64 - Sqrt3) / 6.0'f64

type
  SimplexNoiseSampler* = object
    permutation*: array[256, uint8]
    xOrigin*, yOrigin*, zOrigin*: float64

  OctaveSimplexNoiseSampler* = object
    octaveSamplers*: seq[Option[SimplexNoiseSampler]]
    persistence*: float64
    lacunarity*: float64

proc `==`*(a, b: SimplexNoiseSampler): bool =
  a.permutation == b.permutation and
    cast[uint64](a.xOrigin) == cast[uint64](b.xOrigin) and
    cast[uint64](a.yOrigin) == cast[uint64](b.yOrigin) and
    cast[uint64](a.zOrigin) == cast[uint64](b.zOrigin)

proc hash*(s: SimplexNoiseSampler): Hash =
  var h: Hash = 0
  for p in s.permutation:
    h = h !& hash(int(p))
  h = h !& hash(cast[int64](s.xOrigin))
  h = h !& hash(cast[int64](s.yOrigin))
  h = h !& hash(cast[int64](s.zOrigin))
  !$h

proc newSimplexNoiseSampler*[R](random: var R): SimplexNoiseSampler =
  let xOrigin = nextF64(random) * 256.0'f64
  let yOrigin = nextF64(random) * 256.0'f64
  let zOrigin = nextF64(random) * 256.0'f64
  var permutation = default(array[256, uint8])
  for i in 0 ..< 256:
    permutation[i] = uint8(i)
  for i in 0 ..< 256:
    let j = int(nextBoundedI32(random, int32(256 - i)))
    let tmp = permutation[i]
    permutation[i] = permutation[i + j]
    permutation[i + j] = tmp
  SimplexNoiseSampler(permutation: permutation, xOrigin: xOrigin, yOrigin: yOrigin, zOrigin: zOrigin)

proc map*(s: SimplexNoiseSampler, input: int32): int32 {.inline.} =
  int32(s.permutation[int(input and 0xFF'i32)])

proc grad(gradientIndex: int, x, y, z, distance: float64): float64 =
  let d0 = distance - x * x - y * y - z * z
  if d0 < 0.0'f64:
    0.0'f64
  else:
    let d = d0 * d0
    d * d * Gradients[gradientIndex].dot(x, y, z)

proc sample2d*(s: SimplexNoiseSampler, x, y: float64): float64 =
  let d = (x + y) * SkewFactor2D
  let i = asI32(floor(x + d))
  let j = asI32(floor(y + d))

  let e = float64(wrapAdd(i, j)) * UnskewFactor2D
  let f = float64(i) - e
  let g = float64(j) - e

  let h = x - f
  let k = y - g

  var l = 0'i32
  var m = 1'i32
  if h > k:
    l = 1'i32
    m = 0'i32

  let n = h - float64(l) + UnskewFactor2D
  let o = k - float64(m) + UnskewFactor2D
  let p = 2.0'f64 * UnskewFactor2D + (h - 1.0'f64)
  let q = 2.0'f64 * UnskewFactor2D + (k - 1.0'f64)

  let r = i and 0xFF'i32
  let t2 = j and 0xFF'i32

  let t = s.map(wrapAdd(r, s.map(t2))) mod 12'i32
  let u = s.map(wrapAdd(wrapAdd(r, l), s.map(wrapAdd(t2, m)))) mod 12'i32
  let v = s.map(wrapAdd(wrapAdd(r, 1'i32), s.map(wrapAdd(t2, 1'i32)))) mod 12'i32

  let w = grad(int(t), h, k, 0.0'f64, 0.5'f64)
  let z = grad(int(u), n, o, 0.0'f64, 0.5'f64)
  let aa = grad(int(v), p, q, 0.0'f64, 0.5'f64)

  70.0'f64 * (w + z + aa)

proc sample3d*(s: SimplexNoiseSampler, x, y, z: float64): float64 =
  let e = (x + y + z) * 0.3333333333333333'f64

  let i = asI32(floor(x + e))
  let j = asI32(floor(y + e))
  let k = asI32(floor(z + e))

  let g = float64(wrapAdd(wrapAdd(i, j), k)) * 0.16666666666666666'f64
  let h = float64(i) - g
  let l = float64(j) - g
  let m = float64(k) - g

  let n = x - h
  let o = y - l
  let p = z - m

  var q, r, t2, t, u, v: int32
  if n >= o:
    if o >= p:
      q = 1; r = 0; t2 = 0; t = 1; u = 1; v = 0
    elif n >= p:
      q = 1; r = 0; t2 = 0; t = 1; u = 0; v = 1
    else:
      q = 0; r = 0; t2 = 1; t = 1; u = 0; v = 1
  elif o < p:
    q = 0; r = 0; t2 = 1; t = 0; u = 1; v = 1
  elif n < p:
    q = 0; r = 1; t2 = 0; t = 0; u = 1; v = 1
  else:
    q = 0; r = 1; t2 = 0; t = 1; u = 1; v = 0

  let w = n - float64(q) + 0.16666666666666666'f64
  let aa = o - float64(r) + 0.16666666666666666'f64
  let ab = p - float64(t2) + 0.16666666666666666'f64

  let ac = n - float64(t) + 0.3333333333333333'f64
  let ad = o - float64(u) + 0.3333333333333333'f64
  let ae = p - float64(v) + 0.3333333333333333'f64

  let af = n - 1.0'f64 + 0.5'f64
  let ag = o - 1.0'f64 + 0.5'f64
  let ah = p - 1.0'f64 + 0.5'f64

  let ai = i and 0xFF'i32
  let aj = j and 0xFF'i32
  let ak = k and 0xFF'i32

  let al = s.map(wrapAdd(ai, s.map(wrapAdd(aj, s.map(ak))))) mod 12'i32
  let am = s.map(wrapAdd(wrapAdd(ai, q), s.map(wrapAdd(wrapAdd(aj, r), s.map(wrapAdd(ak, t2)))))) mod 12'i32
  let an = s.map(wrapAdd(wrapAdd(ai, t), s.map(wrapAdd(wrapAdd(aj, u), s.map(wrapAdd(ak, v)))))) mod 12'i32
  let ao = s.map(wrapAdd(wrapAdd(ai, 1'i32), s.map(wrapAdd(wrapAdd(aj, 1'i32), s.map(wrapAdd(ak, 1'i32)))))) mod 12'i32

  let ap = grad(int(al), n, o, p, 0.6'f64)
  let aq = grad(int(am), w, aa, ab, 0.6'f64)
  let ar = grad(int(an), ac, ad, ae, 0.6'f64)
  let az = grad(int(ao), af, ag, ah, 0.6'f64)

  32.0'f64 * (ap + aq + ar + az)

proc hasOctave(octaves: openArray[int32], value: int32): bool =
  for o in octaves:
    if o == value:
      return true
  false

proc legacyRandFromSample(sample: float64): LegacyRand =
  # Not generic: inline in the generic body the cast below failed with `got: auto`. Could not reduce it.
  let n = asI64(sample * float64(9.223372e18'f32))
  legacy_rand.fromSeed(cast[uint64](n))

proc newOctaveSimplexNoiseSampler*[R](random: var R, octaves: openArray[int32]): OctaveSimplexNoiseSampler =
  assert octaves.len > 0, "Should have some octaves"
  var first = octaves[0]
  var last = octaves[0]
  for o in octaves:
    if o < first: first = o
    if o > last: last = o

  let i = -first
  let j = last
  let k = wrapAdd(wrapAdd(i, j), 1'i32)

  let sampler = newSimplexNoiseSampler(random)
  let l = j
  var samplers = newSeq[Option[SimplexNoiseSampler]](int(k))
  for x in 0 ..< int(k):
    samplers[x] = none[SimplexNoiseSampler]()

  var m = j + 1'i32
  while m < k:
    if m >= 0'i32 and hasOctave(octaves, l - m):
      let made = newSimplexNoiseSampler(random)
      samplers[int(m)] = some(made)
    else:
      skip(random, 262'i32)
    m += 1'i32

  if j > 0'i32:
    let originSample = sampler.sample3d(sampler.xOrigin, sampler.yOrigin, sampler.zOrigin)
    var legacyRandom = legacyRandFromSample(originSample)
    var o = l - 1'i32
    while o >= 0'i32:
      if o < k and hasOctave(octaves, l - o):
        let made = newSimplexNoiseSampler(legacyRandom)
        samplers[int(o)] = some(made)
      else:
        skip(legacyRandom, 262'i32)
      o -= 1'i32

  if j >= 0'i32 and j < k and hasOctave(octaves, 0'i32):
    samplers[int(j)] = some(sampler)

  OctaveSimplexNoiseSampler(octaveSamplers: samplers,
                            persistence: 1.0'f64 / (powi(2.0'f64, k) - 1.0'f64),
                            lacunarity: powi(2.0'f64, j))

proc sample*(s: OctaveSimplexNoiseSampler, x, y: float64, useOrigin: bool): float64 =
  var d = 0.0'f64
  var e = s.lacunarity
  var f = s.persistence
  for index in 0 ..< s.octaveSamplers.len:
    if s.octaveSamplers[index].isSome:
      let sampler = s.octaveSamplers[index].get
      let originX = if useOrigin: sampler.xOrigin else: 0.0'f64
      let originY = if useOrigin: sampler.yOrigin else: 0.0'f64
      d += sampler.sample2d(x * e + originX, y * e + originY) * f
    e = e / 2.0'f64
    f *= 2.0'f64
  d
