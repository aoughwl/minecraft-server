## Every #[test] in pumpkin-util/src/noise/simplex.rs. The vector tables are copied from the Rust by a script, not
## retyped.

import std/syncio
import std/options
import ../random/random
import ../xoroshiro128 as xr
import ./simplex

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

