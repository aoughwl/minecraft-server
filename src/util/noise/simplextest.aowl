block newOctave:
  var rand = xr.fromSeed(450'u64)
  check(rand.nextI32() == 1394613419'i32, "first value")
  let sampler = newOctaveSimplexNoiseSampler(rand, [-1'i32, 1'i32, 0'i32])
  check(sampler.lacunarity == 2.0, "lacunarity")
  check(sampler.persistence == 0.14285714285714285, "persistence")
  let values = [
    [33.48154133535127'f64, 200.15584029786743'f64, 239.82697852863149'f64],
    [115.65071632913913'f64, 5.88805286077266'f64, 184.4887403898897'f64],
    [64.69791492580848'f64, 19.256055216755044'f64, 97.01795462351956'f64],
  ]
  check(sampler.octaveSamplers.len == 3, "octave count")
  for i in 0 ..< 3:
    check(sampler.octaveSamplers[i].isSome, "octave present")
    let s = sampler.octaveSamplers[i].get
    check(s.xOrigin == values[i][0], "x origin")
    check(s.yOrigin == values[i][1], "y origin")
    check(s.zOrigin == values[i][2], "z origin")

block sampleOctave:
  var rand = xr.fromSeed(450'u64)
  check(rand.nextI32() == 1394613419'i32, "first value")
  let sampler = newOctaveSimplexNoiseSampler(rand, [-1'i32, 1'i32, 0'i32])
  for i in 0 ..< octaveValues1.len:
    let v = octaveValues1[i]
    check(sampler.sample(v[0], v[1], false) == v[2], "octave sample no origin " & $i)
  for i in 0 ..< octaveValues2.len:
    let v = octaveValues2[i]
    check(sampler.sample(v[0], v[1], true) == v[2], "octave sample origin " & $i)

block create:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newSimplexNoiseSampler(rand)
  check(sampler.xOrigin == 48.58072036717974, "x origin")
  check(sampler.yOrigin == 110.73235882678037, "y origin")
  check(sampler.zOrigin == 65.26438852860176, "z origin")
  check(sampler.permutation == expectedPermutation, "permutation")

block sample2dTest:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newSimplexNoiseSampler(rand)
  for i in 0 ..< data2d1.len:
    let v = data2d1[i]
    check(sampler.sample2d(v[0], v[1]) == v[2], "sample_2d data1 " & $i)
  for i in 0 ..< data2d2.len:
    let v = data2d2[i]
    check(sampler.sample2d(v[0], v[1]) == v[2], "sample_2d data2 " & $i)

block sample3dTest:
  var rand = xr.fromSeed(111'u64)
  check(rand.nextI32() == -1467508761'i32, "first value")
  let sampler = newSimplexNoiseSampler(rand)
  for i in 0 ..< data3d.len:
    let v = data3d[i]
    check(sampler.sample3d(v[0], v[1], v[2]) == v[3], "sample_3d " & $i)

block equalityByBits:
  var a = xr.fromSeed(111'u64)
  var b = xr.fromSeed(111'u64)
  var c = xr.fromSeed(112'u64)
  let sa = newSimplexNoiseSampler(a)
  let sb = newSimplexNoiseSampler(b)
  let sc = newSimplexNoiseSampler(c)
  check(sa == sb, "same seed equal")
  check(not (sa == sc), "other seed differs")
  check(hash(sa) == hash(sb), "same seed hashes equal")

block positiveFirstOctaveChain:
  # Own answers from an independent Python oracle written from the Rust text: octaves > 0 take the LegacyRand
  # branch, whose seed goes through the saturating `as i64` of a sample times 2^63.
  var rand = xr.fromSeed(7'u64)
  let sampler = newOctaveSimplexNoiseSampler(rand, [0'i32, 2'i32, 3'i32])
  check(sampler.lacunarity == 8.0, "lacunarity")
  check(sampler.octaveSamplers.len == 4, "octave count")
  check(sampler.sample(1.5, -2.5, true) == -0.2910502668961702'f64, "sample with origin")
  check(sampler.sample(1000.25, 7.75, false) == 0.12898029894765156'f64, "sample without origin")

echo "noise/simplex: all upstream test vectors matched"
