## Not in the pinned tree: pumpkin-util/src/noise/ has no volume.rs at b7ccef5b2. This is a port of
## crates/pumpkin-util/src/noise/volume.rs from the newer checkout in ../ref/pumpkin, which the batched
## `addToVolume` in ../perlin.aowl samples over.

import std/assertions
import std/options
import ../vector3
from ../math/mathmod import floorDiv, floorMod

type
  DensityVolume* = object
    sizeX*, sizeY*, sizeZ*: int
    minBlockX*, minBlockY*, minBlockZ*: int32
    stepBlockX*, stepBlockY*, stepBlockZ*: int32

proc newDensityVolume*(sizeX, sizeY, sizeZ: int; minBlockX, minBlockY, minBlockZ,
                       stepBlockX, stepBlockY, stepBlockZ: int32): DensityVolume =
  assert sizeX > 0 and sizeY > 0 and sizeZ > 0
  assert stepBlockX > 0'i32 and stepBlockY > 0'i32 and stepBlockZ > 0'i32
  DensityVolume(sizeX: sizeX, sizeY: sizeY, sizeZ: sizeZ,
                minBlockX: minBlockX, minBlockY: minBlockY, minBlockZ: minBlockZ,
                stepBlockX: stepBlockX, stepBlockY: stepBlockY, stepBlockZ: stepBlockZ)

proc withBlockStep*(sizeX, sizeY, sizeZ: int; minBlockX, minBlockY, minBlockZ: int32): DensityVolume =
  newDensityVolume(sizeX, sizeY, sizeZ, minBlockX, minBlockY, minBlockZ, 1'i32, 1'i32, 1'i32)

proc indexUnchecked*(v: DensityVolume, x, y, z: int): int {.inline.} =
  y + (x + z * v.sizeX) * v.sizeY

proc blockX*(v: DensityVolume, x: int): int32 {.inline.} =
  v.minBlockX + int32(x) * v.stepBlockX

proc blockY*(v: DensityVolume, y: int): int32 {.inline.} =
  v.minBlockY + int32(y) * v.stepBlockY

proc blockZ*(v: DensityVolume, z: int): int32 {.inline.} =
  v.minBlockZ + int32(z) * v.stepBlockZ

proc maxBlockX*(v: DensityVolume): int32 =
  v.minBlockX + int32(v.sizeX) * v.stepBlockX - 1'i32

proc maxBlockY*(v: DensityVolume): int32 =
  v.minBlockY + int32(v.sizeY) * v.stepBlockY - 1'i32

proc maxBlockZ*(v: DensityVolume): int32 =
  v.minBlockZ + int32(v.sizeZ) * v.stepBlockZ - 1'i32

proc size*(v: DensityVolume): int {.inline.} =
  v.sizeX * v.sizeY * v.sizeZ

proc isBlockStep*(v: DensityVolume): bool =
  v.stepBlockX == 1'i32 and v.stepBlockY == 1'i32 and v.stepBlockZ == 1'i32

proc containsBlockRelative(v: DensityVolume, relativeX, relativeY, relativeZ: int32): bool =
  # Steps are positive, so rem_euclid is floorMod.
  relativeX >= 0'i32 and relativeY >= 0'i32 and relativeZ >= 0'i32 and
    relativeX < int32(v.sizeX) * v.stepBlockX and
    relativeY < int32(v.sizeY) * v.stepBlockY and
    relativeZ < int32(v.sizeZ) * v.stepBlockZ and
    floorMod(relativeX, v.stepBlockX) == 0'i32 and
    floorMod(relativeY, v.stepBlockY) == 0'i32 and
    floorMod(relativeZ, v.stepBlockZ) == 0'i32

proc indexOfBlock*(v: DensityVolume, blockX, blockY, blockZ: int32): Option[int] =
  let relativeX = blockX - v.minBlockX
  let relativeY = blockY - v.minBlockY
  let relativeZ = blockZ - v.minBlockZ
  if v.isBlockStep():
    if relativeX >= 0'i32 and relativeY >= 0'i32 and relativeZ >= 0'i32 and
        relativeX < int32(v.sizeX) and relativeY < int32(v.sizeY) and relativeZ < int32(v.sizeZ):
      return some(v.indexUnchecked(int(relativeX), int(relativeY), int(relativeZ)))
  elif v.containsBlockRelative(relativeX, relativeY, relativeZ):
    return some(v.indexUnchecked(int(floorDiv(relativeX, v.stepBlockX)),
                                 int(floorDiv(relativeY, v.stepBlockY)),
                                 int(floorDiv(relativeZ, v.stepBlockZ))))
  none[int]()

proc fillWith*(v: DensityVolume, buffer: var openArray[float32],
               sample: proc (pos: Vector3[int32]): float32 {.closure.}) =
  assert buffer.len == v.size()
  var index = 0
  for z in 0 ..< v.sizeZ:
    let blockZ = v.blockZ(z)
    for x in 0 ..< v.sizeX:
      let blockX = v.blockX(x)
      for y in 0 ..< v.sizeY:
        buffer[index] = sample(vec3(blockX, v.blockY(y), blockZ))
        index += 1
