## volume.rs has no #[test]. Own known answers worked out by hand from the Rust.

import std/syncio
import std/options
import ../vector3
import ./volume

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

block blockStep:
  let v = withBlockStep(16, 384, 16, 0'i32, -64'i32, 0'i32)
  check(v.size() == 98304, "size")
  check(v.isBlockStep(), "is_block_step")
  check(v.maxBlockX() == 15'i32 and v.maxBlockY() == 319'i32 and v.maxBlockZ() == 15'i32, "max blocks")
  check(v.blockY(0) == -64'i32 and v.blockY(383) == 319'i32, "block_y")
  # y + (x + z * 16) * 384
  check(v.indexUnchecked(3, 5, 2) == 5 + (3 + 2 * 16) * 384, "index_unchecked")
  check(v.indexOfBlock(3'i32, -59'i32, 2'i32).get == 13445, "index_of_block")
  check(v.indexOfBlock(16'i32, 0'i32, 0'i32).isNone, "x past the end")
  check(v.indexOfBlock(0'i32, -65'i32, 0'i32).isNone, "y before the start")
  check(v.indexOfBlock(-1'i32, 0'i32, 0'i32).isNone, "x before the start")

block stepped:
  let v = newDensityVolume(2, 3, 2, 16'i32, -64'i32, -8'i32, 4'i32, 8'i32, 4'i32)
  check(not v.isBlockStep(), "is_block_step")
  check(v.size() == 12, "size")
  check(v.blockX(1) == 20'i32 and v.blockY(2) == -48'i32 and v.blockZ(1) == -4'i32, "blocks")
  # Each size * step, minus 1, past the minimum.
  check(v.maxBlockX() == 23'i32 and v.maxBlockY() == -41'i32 and v.maxBlockZ() == -1'i32, "max blocks")
  check(v.indexOfBlock(20'i32, -48'i32, -4'i32).get == 2 + (1 + 1 * 2) * 3, "index_of_block on the grid")
  check(v.indexOfBlock(21'i32, -48'i32, -4'i32).isNone, "x between steps")
  check(v.indexOfBlock(20'i32, -47'i32, -4'i32).isNone, "y between steps")
  check(v.indexOfBlock(24'i32, -64'i32, -8'i32).isNone, "x past the end")
  check(v.indexOfBlock(12'i32, -64'i32, -8'i32).isNone, "x before the start")

block fillOrder:
  let v = newDensityVolume(2, 2, 2, 1'i32, 10'i32, 100'i32, 1'i32, 2'i32, 3'i32)
  var buffer = newSeq[float32](v.size())
  v.fillWith(buffer, proc (pos: Vector3[int32]): float32 =
    float32(pos.x) + float32(pos.y) + float32(pos.z))
  # z, then x, then y innermost.
  let want = [111.0'f32, 113.0, 112.0, 114.0, 114.0, 116.0, 115.0, 117.0]
  for i in 0 ..< want.len:
    check(buffer[i] == want[i], "fill_with " & $i)

echo "volume: all checks passed"
