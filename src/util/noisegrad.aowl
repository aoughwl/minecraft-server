## Shared 3D gradient table for Perlin and simplex noise, the body of pumpkin-util/src/noise/mod.rs.
## noise/noise.aowl is the module file and re-exports this.

type
  Gradient* = object
    x*, y*, z*: float64

const Gradients*: array[16, Gradient] = [
  Gradient(x: 1.0, y: 1.0, z: 0.0),
  Gradient(x: -1.0, y: 1.0, z: 0.0),
  Gradient(x: 1.0, y: -1.0, z: 0.0),
  Gradient(x: -1.0, y: -1.0, z: 0.0),
  Gradient(x: 1.0, y: 0.0, z: 1.0),
  Gradient(x: -1.0, y: 0.0, z: 1.0),
  Gradient(x: 1.0, y: 0.0, z: -1.0),
  Gradient(x: -1.0, y: 0.0, z: -1.0),
  Gradient(x: 0.0, y: 1.0, z: 1.0),
  Gradient(x: 0.0, y: -1.0, z: 1.0),
  Gradient(x: 0.0, y: 1.0, z: -1.0),
  Gradient(x: 0.0, y: -1.0, z: -1.0),
  Gradient(x: 1.0, y: 1.0, z: 0.0),
  Gradient(x: 0.0, y: -1.0, z: 1.0),
  Gradient(x: -1.0, y: 1.0, z: 0.0),
  Gradient(x: 0.0, y: -1.0, z: -1.0),
]

proc dot*(g: Gradient, x, y, z: float64): float64 {.inline.} =
  # Upstream's mul_add is z + (x + y) with every factor ±1 or 0, so each product is exact and fusing changes nothing.
  g.x * x + g.y * y + g.z * z
