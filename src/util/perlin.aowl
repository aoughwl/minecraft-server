## Not in the pinned tree: the pinned pumpkin-util/src/noise/perlin.rs has only the f64 samplers, which are
## noise/perlin.aowl. This is a whole port of crates/pumpkin-util/src/noise/perlin.rs from the newer checkout in
## ../ref/pumpkin: PerlinNoise, SmearedPerlinNoise, NoiseStack, NormalNoise, legacy_fbm, add_to_volume and the
## Corners fast path. Upstream's `get` is `get` here, and `sample` stays as the older name for it.
##
## The `Noise` trait becomes overloads of `get` and `addToVolume`, with the `Noise` concept for bounds.
## `impl RandomImpl` is a plain generic `[R]`: non-legacy NormalNoise also needs `nextSplitter` for it.

{.feature: "untyped".}

import std/math
import mathlerp
import noise/volume
import random/rustnum
import random/random

export volume

const
  Gradients: array[16, array[3, float32]] = [
    [1.0'f32, 1.0'f32, 0.0'f32],
    [-1.0'f32, 1.0'f32, 0.0'f32],
    [1.0'f32, -1.0'f32, 0.0'f32],
    [-1.0'f32, -1.0'f32, 0.0'f32],
    [1.0'f32, 0.0'f32, 1.0'f32],
    [-1.0'f32, 0.0'f32, 1.0'f32],
    [1.0'f32, 0.0'f32, -1.0'f32],
    [-1.0'f32, 0.0'f32, -1.0'f32],
    [0.0'f32, 1.0'f32, 1.0'f32],
    [0.0'f32, -1.0'f32, 1.0'f32],
    [0.0'f32, 1.0'f32, -1.0'f32],
    [0.0'f32, -1.0'f32, -1.0'f32],
    [1.0'f32, 1.0'f32, 0.0'f32],
    [0.0'f32, -1.0'f32, 1.0'f32],
    [-1.0'f32, 1.0'f32, 0.0'f32],
    [0.0'f32, -1.0'f32, -1.0'f32],
  ]

  RoundOff = 33_554_432.0'f64
  # f64::from_bits(0x416FFFFFFFFFFFFF), one ULP below 2^24; perlintest.aowl checks the bits.
  HalfRoundOff* = 16777215.999999998'f64
  NoiseOffsetScale = 256.0'f64
  ShiftUpEpsilon = float64(1.0e-7'f32)
  StandardDeviation = 0.2702247831245211'f64
  TargetDeviation = 0.3333333333333333'f64
  InputFactor = 1.0181268882175227'f64
  Persistence = 0.5'f64
  Lacunarity = 2.0'f64

type
  RandomSource* = concept
    proc nextF64(r: var Self): float64
    proc nextBoundedI32(r: var Self, bound: int32): int32

  Noise* = concept
    proc get(n: Self, x, y, z: float64): float32
    proc addToVolume(n: Self, buffer: var openArray[float32], volume: DensityVolume,
                     xzScale, yScale: float64, amplitude: float32)

  PerlinNoise* = object
    perms: array[256, uint8]
    offsetX*, offsetY*, offsetZ*: float64

  Corners = object
    d000Xz, d100Xz, d010Xz, d110Xz, d001Xz, d101Xz, d011Xz, d111Xz: float32
    g000Y, g100Y, g010Y, g110Y, g001Y, g101Y, g011Y, g111Y: float32

  SmearedPerlinNoise* = object
    noise: PerlinNoise
    fudgeYScale: float64

  Layer*[N] = object
    noise*: N
    frequency*: float64
    amplitude*: float32

  NoiseStack*[N] = object
    layers*: seq[Layer[N]]

  OctaveInfo = object
    index: int32
    frequency: float64
    amplitude: float64

  NormalNoise* = object
    stack: NoiseStack[PerlinNoise]
    maxValueField: float32

proc wrap*(x: float64): float64 {.inline.} =
  ## Keeps `x` near the origin so repeated octave sampling keeps its f64 precision.
  if x >= -HalfRoundOff and x < HalfRoundOff:
    x
  else:
    x - floor(x / RoundOff + 0.5'f64) * RoundOff

proc gradDot(hash: int32, x, y, z: float32): float32 {.inline.} =
  let g = Gradients[int(hash and 15'i32)]
  g[0] * x + g[1] * y + g[2] * z

proc gradDotXz(g: array[3, float32], x, z: float32): float32 {.inline.} =
  g[0] * x + g[2] * z

proc newPerlinNoise*[R: RandomSource](random: var R): PerlinNoise {.noinit.} =
  ## `R` needs `nextF64(var R): float64` and `nextBoundedI32(var R, int32): int32`.
  result.offsetX = nextF64(random) * NoiseOffsetScale
  result.offsetY = nextF64(random) * NoiseOffsetScale
  result.offsetZ = nextF64(random) * NoiseOffsetScale
  for i in 0 ..< 256:
    result.perms[i] = uint8(i)
  for i in 0 ..< 256:
    let offset = int(nextBoundedI32(random, int32(256 - i)))
    let j = offset + i
    let tmp = result.perms[i]
    result.perms[i] = result.perms[j]
    result.perms[j] = tmp

proc permute(p: PerlinNoise, x: int32): int32 {.inline.} =
  int32(p.perms[int(x and 0xFF'i32)])

proc permuteToGrad(p: PerlinNoise, x: int32): array[3, float32] {.inline.} =
  Gradients[int(p.permute(x) and 15'i32)]

proc lerp(c: Corners, alphaX, alphaY, alphaZ, relativeY: float32): float32 {.inline.} =
  lerp3(alphaX, alphaY, alphaZ,
        c.d000Xz + c.g000Y * relativeY,
        c.d100Xz + c.g100Y * relativeY,
        c.d010Xz + c.g010Y * (relativeY - 1.0'f32),
        c.d110Xz + c.g110Y * (relativeY - 1.0'f32),
        c.d001Xz + c.g001Y * relativeY,
        c.d101Xz + c.g101Y * relativeY,
        c.d011Xz + c.g011Y * (relativeY - 1.0'f32),
        c.d111Xz + c.g111Y * (relativeY - 1.0'f32))

proc sampleAndLerp(p: PerlinNoise, x, y, z: int32,
                   relativeX, relativeY, relativeZ, originalRelativeY: float32): float32 =
  let x0 = p.permute(x)
  let x1 = p.permute(wrapAdd(x, 1'i32))
  let xy00 = p.permute(wrapAdd(x0, y))
  let xy01 = p.permute(wrapAdd(wrapAdd(x0, y), 1'i32))
  let xy10 = p.permute(wrapAdd(x1, y))
  let xy11 = p.permute(wrapAdd(wrapAdd(x1, y), 1'i32))
  let d000 = gradDot(p.permute(wrapAdd(xy00, z)), relativeX, relativeY, relativeZ)
  let d100 = gradDot(p.permute(wrapAdd(xy10, z)), relativeX - 1.0'f32, relativeY, relativeZ)
  let d010 = gradDot(p.permute(wrapAdd(xy01, z)), relativeX, relativeY - 1.0'f32, relativeZ)
  let d110 = gradDot(p.permute(wrapAdd(xy11, z)), relativeX - 1.0'f32, relativeY - 1.0'f32, relativeZ)
  let d001 = gradDot(p.permute(wrapAdd(wrapAdd(xy00, z), 1'i32)), relativeX, relativeY, relativeZ - 1.0'f32)
  let d101 = gradDot(p.permute(wrapAdd(wrapAdd(xy10, z), 1'i32)), relativeX - 1.0'f32, relativeY, relativeZ - 1.0'f32)
  let d011 = gradDot(p.permute(wrapAdd(wrapAdd(xy01, z), 1'i32)), relativeX, relativeY - 1.0'f32, relativeZ - 1.0'f32)
  let d111 = gradDot(p.permute(wrapAdd(wrapAdd(xy11, z), 1'i32)), relativeX - 1.0'f32, relativeY - 1.0'f32, relativeZ - 1.0'f32)
  let alphaX = smoothstep(relativeX)
  let alphaY = smoothstep(originalRelativeY)
  let alphaZ = smoothstep(relativeZ)
  lerp3(alphaX, alphaY, alphaZ, d000, d100, d010, d110, d001, d101, d011, d111)

proc corners(p: PerlinNoise, x0, x1, floorY, floorZ: int32, relativeX, relativeZ: float32, c: var Corners) =
  let xy00 = p.permute(wrapAdd(x0, floorY))
  let xy01 = p.permute(wrapAdd(wrapAdd(x0, floorY), 1'i32))
  let xy10 = p.permute(wrapAdd(x1, floorY))
  let xy11 = p.permute(wrapAdd(wrapAdd(x1, floorY), 1'i32))
  let g000 = p.permuteToGrad(wrapAdd(xy00, floorZ))
  c.d000Xz = gradDotXz(g000, relativeX, relativeZ)
  c.g000Y = g000[1]
  let g100 = p.permuteToGrad(wrapAdd(xy10, floorZ))
  c.d100Xz = gradDotXz(g100, relativeX - 1.0'f32, relativeZ)
  c.g100Y = g100[1]
  let g010 = p.permuteToGrad(wrapAdd(xy01, floorZ))
  c.d010Xz = gradDotXz(g010, relativeX, relativeZ)
  c.g010Y = g010[1]
  let g110 = p.permuteToGrad(wrapAdd(xy11, floorZ))
  c.d110Xz = gradDotXz(g110, relativeX - 1.0'f32, relativeZ)
  c.g110Y = g110[1]
  let g001 = p.permuteToGrad(wrapAdd(wrapAdd(xy00, floorZ), 1'i32))
  c.d001Xz = gradDotXz(g001, relativeX, relativeZ - 1.0'f32)
  c.g001Y = g001[1]
  let g101 = p.permuteToGrad(wrapAdd(wrapAdd(xy10, floorZ), 1'i32))
  c.d101Xz = gradDotXz(g101, relativeX - 1.0'f32, relativeZ - 1.0'f32)
  c.g101Y = g101[1]
  let g011 = p.permuteToGrad(wrapAdd(wrapAdd(xy01, floorZ), 1'i32))
  c.d011Xz = gradDotXz(g011, relativeX, relativeZ - 1.0'f32)
  c.g011Y = g011[1]
  let g111 = p.permuteToGrad(wrapAdd(wrapAdd(xy11, floorZ), 1'i32))
  c.d111Xz = gradDotXz(g111, relativeX - 1.0'f32, relativeZ - 1.0'f32)
  c.g111Y = g111[1]

proc get*(p: PerlinNoise, x, y, z: float64): float32 =
  let wx = wrap(x) + p.offsetX
  let wy = wrap(y) + p.offsetY
  let wz = wrap(z) + p.offsetZ
  let floorX = asI32(floor(wx))
  let floorY = asI32(floor(wy))
  let floorZ = asI32(floor(wz))
  let relX = float32(wx - float64(floorX))
  let relY = float32(wy - float64(floorY))
  let relZ = float32(wz - float64(floorZ))
  p.sampleAndLerp(floorX, floorY, floorZ, relX, relY, relZ, relY)

proc sample*(p: PerlinNoise, x, y, z: float64): float32 =
  p.get(x, y, z)

proc addToVolume*(p: PerlinNoise, buffer: var openArray[float32], volume: DensityVolume,
                  xzScale, yScale: float64, amplitude: float32) =
  var c = Corners()
  if yScale == 0.0'f64 and volume.sizeY > 1:
    let y = p.offsetY
    let floorY = asI32(floor(y))
    let relativeY = float32(y - float64(floorY))
    let alphaY = smoothstep(relativeY)
    var index = 0
    for indexZ in 0 ..< volume.sizeZ:
      let z = wrap(float64(volume.blockZ(indexZ)) * xzScale) + p.offsetZ
      let floorZ = asI32(floor(z))
      let relativeZ = float32(z - float64(floorZ))
      let alphaZ = smoothstep(relativeZ)
      for indexX in 0 ..< volume.sizeX:
        let x = wrap(float64(volume.blockX(indexX)) * xzScale) + p.offsetX
        let floorX = asI32(floor(x))
        let relativeX = float32(x - float64(floorX))
        let x0 = p.permute(floorX)
        let x1 = p.permute(wrapAdd(floorX, 1'i32))
        let alphaX = smoothstep(relativeX)
        p.corners(x0, x1, floorY, floorZ, relativeX, relativeZ, c)
        let val = amplitude * c.lerp(alphaX, alphaY, alphaZ, relativeY)
        for o in index ..< index + volume.sizeY:
          buffer[o] += val
        index += volume.sizeY
    return
  var index = 0
  for indexZ in 0 ..< volume.sizeZ:
    let z = wrap(float64(volume.blockZ(indexZ)) * xzScale) + p.offsetZ
    let floorZ = asI32(floor(z))
    let relativeZ = float32(z - float64(floorZ))
    let alphaZ = smoothstep(relativeZ)
    for indexX in 0 ..< volume.sizeX:
      let x = wrap(float64(volume.blockX(indexX)) * xzScale) + p.offsetX
      let floorX = asI32(floor(x))
      let relativeX = float32(x - float64(floorX))
      let x0 = p.permute(floorX)
      let x1 = p.permute(wrapAdd(floorX, 1'i32))
      let alphaX = smoothstep(relativeX)
      var lastFloorY = int32.low
      for indexY in 0 ..< volume.sizeY:
        let y = wrap(float64(volume.blockY(indexY)) * yScale) + p.offsetY
        let floorY = asI32(floor(y))
        let relativeY = float32(y - float64(floorY))
        let alphaY = smoothstep(relativeY)
        if lastFloorY != floorY:
          p.corners(x0, x1, floorY, floorZ, relativeX, relativeZ, c)
          lastFloorY = floorY
        buffer[index] += amplitude * c.lerp(alphaX, alphaY, alphaZ, relativeY)
        index += 1

proc newSmearedPerlinNoise*[R](random: var R, fudgeYScale: float64): SmearedPerlinNoise =
  SmearedPerlinNoise(noise: newPerlinNoise(random), fudgeYScale: fudgeYScale)

proc computeFudgeY(s: SmearedPerlinNoise, originalY, relativeY: float64): float64 {.inline.} =
  let fudgeLimit = if originalY >= 0.0'f64 and originalY < relativeY: originalY else: relativeY
  floor(fudgeLimit / s.fudgeYScale + ShiftUpEpsilon) * s.fudgeYScale

proc get*(s: SmearedPerlinNoise, x, originalY, z: float64): float32 =
  let wx = wrap(x) + s.noise.offsetX
  let wy = wrap(originalY) + s.noise.offsetY
  let wz = wrap(z) + s.noise.offsetZ
  let floorX = asI32(floor(wx))
  let floorY = asI32(floor(wy))
  let floorZ = asI32(floor(wz))
  let relativeX = float32(wx - float64(floorX))
  let relativeY = wy - float64(floorY)
  let relativeZ = float32(wz - float64(floorZ))
  let fudgedRelativeY = float32(relativeY - s.computeFudgeY(originalY, relativeY))
  s.noise.sampleAndLerp(floorX, floorY, floorZ, relativeX, fudgedRelativeY, relativeZ, float32(relativeY))

proc addToVolume*(s: SmearedPerlinNoise, buffer: var openArray[float32], volume: DensityVolume,
                  xzScale, yScale: float64, amplitude: float32) =
  var c = Corners()
  var index = 0
  for indexZ in 0 ..< volume.sizeZ:
    let z = wrap(float64(volume.blockZ(indexZ)) * xzScale) + s.noise.offsetZ
    let floorZ = asI32(floor(z))
    let relativeZ = float32(z - float64(floorZ))
    let alphaZ = smoothstep(relativeZ)
    for indexX in 0 ..< volume.sizeX:
      let x = wrap(float64(volume.blockX(indexX)) * xzScale) + s.noise.offsetX
      let floorX = asI32(floor(x))
      let relativeX = float32(x - float64(floorX))
      let x0 = s.noise.permute(floorX)
      let x1 = s.noise.permute(wrapAdd(floorX, 1'i32))
      let alphaX = smoothstep(relativeX)
      var lastFloorY = int32.low
      for indexY in 0 ..< volume.sizeY:
        let originalY = float64(volume.blockY(indexY)) * yScale
        let y = wrap(originalY) + s.noise.offsetY
        let floorY = asI32(floor(y))
        let relativeY = y - float64(floorY)
        let alphaY = smoothstep(float32(relativeY))
        if lastFloorY != floorY:
          s.noise.corners(x0, x1, floorY, floorZ, relativeX, relativeZ, c)
          lastFloorY = floorY
        let fudgedRelativeY = float32(relativeY - s.computeFudgeY(originalY, relativeY))
        buffer[index] += amplitude * c.lerp(alphaX, alphaY, alphaZ, fudgedRelativeY)
        index += 1

proc newNoiseStack*[N](layers: seq[Layer[N]]): NoiseStack[N] =
  NoiseStack[N](layers: layers)

proc get*[N](s: NoiseStack[N], x, y, z: float64): float32 =
  mixin get
  var value = 0.0'f32
  for index in 0 ..< s.layers.len:
    let frequency = s.layers[index].frequency
    value += s.layers[index].amplitude * get(s.layers[index].noise, x * frequency, y * frequency, z * frequency)
  value

proc addToVolume*[N](s: NoiseStack[N], buffer: var openArray[float32], volume: DensityVolume,
                     xzScale, yScale: float64, amplitude: float32) =
  mixin addToVolume
  for index in 0 ..< s.layers.len:
    let frequency = s.layers[index].frequency
    addToVolume(s.layers[index].noise, buffer, volume, xzScale * frequency, yScale * frequency,
                amplitude * s.layers[index].amplitude)

proc amplitudeModifier(modifiers: openArray[float64], index: int): float64 {.inline.} =
  if modifiers.len == 0: 1.0'f64 else: modifiers[index]

proc buildOctaves(baseOctave: int32, baseAmplitude: float64, octaveCount: int, normalize: bool,
                  modifiers: openArray[float64]): seq[OctaveInfo] =
  var frequency = powi(Lacunarity, baseOctave)
  var amplitude = baseAmplitude
  if normalize:
    amplitude = baseAmplitude * (powi(Persistence, -(int32(octaveCount) - 1'i32)) /
                                 (powi(Persistence, -int32(octaveCount)) - 1.0'f64))
  result = newSeqOfCap[OctaveInfo](octaveCount)
  for i in 0 ..< octaveCount:
    let modifier = amplitudeModifier(modifiers, i)
    if modifier != 0.0'f64:
      result.add OctaveInfo(index: baseOctave + int32(i), frequency: frequency, amplitude: amplitude * modifier)
    frequency *= Lacunarity
    amplitude *= Persistence

proc estimateDeviation(octaves: seq[OctaveInfo]): float64 =
  var variance = 0.0'f64
  for index in 0 ..< octaves.len:
    let layerDeviation = StandardDeviation * abs(octaves[index].amplitude)
    variance += layerDeviation * layerDeviation
  sqrt(variance)

proc computeNormalizationFactor(targetAmplitude: float64, octaves: seq[OctaveInfo]): float64 =
  let inputDeviation = estimateDeviation(octaves)
  if inputDeviation == 0.0'f64:
    0.0'f64
  else:
    let inputSumDeviation = inputDeviation * sqrt(2.0'f64)
    let targetDeviation = targetAmplitude * TargetDeviation
    targetDeviation / inputSumDeviation

proc parityExpectedDeviation(octaveSpan: int32): float64 =
  0.1'f64 * (1.0'f64 + 1.0'f64 / float64(wrapAdd(octaveSpan, 1'i32)))

proc parityNormalizationFactor(baseAmplitude: float64, octaveCount: int, modifiers: openArray[float64]): float64 =
  var minOctave = int32.high
  var maxOctave = int32.low
  for i in 0 ..< octaveCount:
    if amplitudeModifier(modifiers, i) != 0.0'f64:
      minOctave = min(minOctave, int32(i))
      maxOctave = max(maxOctave, int32(i))
  baseAmplitude * 0.5'f64 * TargetDeviation / parityExpectedDeviation(wrapSub(maxOctave, minOctave))

proc sumAbsAmplitude(octaves: seq[OctaveInfo]): float64 =
  var total = 0.0'f64
  for index in 0 ..< octaves.len:
    total += abs(octaves[index].amplitude)
  total

proc parityBaseAmplitude(baseOctave: int32, amplitudes: openArray[float64]): float64 =
  let octaves = buildOctaves(baseOctave, 1.0'f64, amplitudes.len, true, amplitudes)
  let targetAmplitude = sumAbsAmplitude(octaves)
  let newNormalizationFactor = computeNormalizationFactor(targetAmplitude, octaves)
  if newNormalizationFactor == 0.0'f64:
    1.0'f64
  else:
    parityNormalizationFactor(1.0'f64, amplitudes.len, amplitudes) / newNormalizationFactor

proc legacyFbm*[R](random: var R, firstOctave: int32, amplitudes: openArray[float64]): NoiseStack[PerlinNoise] =
  let octaves = amplitudes.len
  let zeroOctaveIndex = -firstOctave
  var present = newSeq[bool](octaves)
  var noiseLevels = newSeq[PerlinNoise](octaves)
  let zeroOctave = newPerlinNoise(random)
  if zeroOctaveIndex >= 0'i32 and zeroOctaveIndex < int32(octaves) and amplitudes[int(zeroOctaveIndex)] != 0.0'f64:
    present[int(zeroOctaveIndex)] = true
    noiseLevels[int(zeroOctaveIndex)] = zeroOctave
  var i = zeroOctaveIndex - 1'i32
  while i >= 0'i32:
    if i < int32(octaves):
      if amplitudes[int(i)] == 0.0'f64:
        skip(random, 262'i32)
      else:
        present[int(i)] = true
        noiseLevels[int(i)] = newPerlinNoise(random)
    else:
      skip(random, 262'i32)
    i -= 1'i32
  var factor = powi(Lacunarity, -zeroOctaveIndex)
  var valueFactor = powi(Lacunarity, int32(octaves) - 1'i32) / (powi(Lacunarity, int32(octaves)) - 1.0'f64)
  var layers = newSeqOfCap[Layer[PerlinNoise]](octaves)
  for index in 0 ..< octaves:
    if present[index]:
      layers.add Layer[PerlinNoise](noise: noiseLevels[index], frequency: factor,
                                    amplitude: float32(valueFactor * amplitudes[index]))
    factor *= Lacunarity
    valueFactor = valueFactor / Lacunarity
  newNoiseStack(layers)

proc newNormalNoise*[R](random: var R, firstOctave: int32, amplitudes: openArray[float64],
                        legacy: bool): NormalNoise =
  let octaveCount = amplitudes.len
  if legacy:
    let octaves = buildOctaves(firstOctave, 1.0'f64, octaveCount, true, amplitudes)
    var targetAmplitude = sumAbsAmplitude(octaves)
    var normalizationFactor = computeNormalizationFactor(targetAmplitude, octaves)
    if normalizationFactor != 0.0'f64:
      let parity = parityNormalizationFactor(1.0'f64, octaveCount, amplitudes)
      targetAmplitude *= parity / normalizationFactor
      normalizationFactor = parity
    let first = legacyFbm(random, firstOctave, amplitudes)
    let second = legacyFbm(random, firstOctave, amplitudes)
    let valueFactor = float32(normalizationFactor)
    var layers: seq[Layer[PerlinNoise]] = @[]
    for index in 0 ..< first.layers.len:
      layers.add Layer[PerlinNoise](noise: first.layers[index].noise,
                                    frequency: first.layers[index].frequency,
                                    amplitude: first.layers[index].amplitude * valueFactor)
    for index in 0 ..< second.layers.len:
      layers.add Layer[PerlinNoise](noise: second.layers[index].noise,
                                    frequency: second.layers[index].frequency * InputFactor,
                                    amplitude: second.layers[index].amplitude * valueFactor)
    return NormalNoise(stack: newNoiseStack(layers),
                       maxValueField: float32(targetAmplitude * TargetDeviation * 6.0'f64))
  let baseAmplitude = parityBaseAmplitude(firstOctave, amplitudes)
  let octaves = buildOctaves(firstOctave, baseAmplitude, octaveCount, true, amplitudes)
  let targetAmplitude = sumAbsAmplitude(octaves)
  let normalizationFactor = computeNormalizationFactor(targetAmplitude, octaves)
  let firstRandom = nextSplitter(random)
  let secondRandom = nextSplitter(random)
  var layers = newSeqOfCap[Layer[PerlinNoise]](octaves.len * 2)
  for index in 0 ..< octaves.len:
    let seed = "octave_" & $octaves[index].index
    let valueFactor = float32(normalizationFactor * octaves[index].amplitude)
    var a = splitString(firstRandom, seed)
    layers.add Layer[PerlinNoise](noise: newPerlinNoise(a), frequency: octaves[index].frequency,
                                  amplitude: valueFactor)
    var b = splitString(secondRandom, seed)
    layers.add Layer[PerlinNoise](noise: newPerlinNoise(b), frequency: octaves[index].frequency * InputFactor,
                                  amplitude: valueFactor)
  NormalNoise(stack: newNoiseStack(layers),
              maxValueField: float32(targetAmplitude * TargetDeviation * 6.0'f64))

proc maxValue*(n: NormalNoise): float32 {.inline.} =
  n.maxValueField

proc layerCount*(n: NormalNoise): int {.inline.} =
  n.stack.layers.len

proc get*(n: NormalNoise, x, y, z: float64): float32 =
  get(n.stack, x, y, z)

proc addToVolume*(n: NormalNoise, buffer: var openArray[float32], volume: DensityVolume,
                  xzScale, yScale: float64, amplitude: float32) =
  addToVolume(n.stack, buffer, volume, xzScale, yScale, amplitude)
