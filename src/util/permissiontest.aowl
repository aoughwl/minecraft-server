## Known answers for permission.aowl. Upstream has no #[test] for this file; the resolution cases walk
## has_permission's order: exact, namespace wildcard, each key level and its wildcard, inherited, default.

import std/assertions
import std/syncio
import std/tables
import ../codecs/json_value
import ../codecs/data_result
import uuid
import permission

let player = nameUuidFromBytes("OfflinePlayer:a")
let otherPlayer = nameUuidFromBytes("OfflinePlayer:b")

proc freshManager(): PermissionManager =
  let reg = newPermissionRegistry()
  var parent = newPermission("minecraft:command.parent", "p", permissionDeny())
  addChild(parent, "minecraft:command.kid_yes", true)
  addChild(parent, "minecraft:command.kid_no", false)
  registerPermissionOrPanic(reg, parent)
  registerPermissionOrPanic(reg, newPermission("minecraft:command.gamemode", "gm", permissionOp(Two)))
  registerPermissionOrPanic(reg, newPermission("minecraft:command.help", "help", permissionAllow()))
  registerPermissionOrPanic(reg, newPermission("minecraft:command.stop", "stop", permissionDeny()))
  newPermissionManager(reg)

# registry
block:
  let reg = newPermissionRegistry()
  assert not reg.hasPermission("a:b")
  assert registerPermission(reg, newPermission("a:b", "d", permissionAllow())) == (true, "")
  assert reg.hasPermission("a:b")
  assert registerPermission(reg, newPermission("a:b", "e", permissionDeny())) ==
    (false, "Permission a:b is already registered")
  # the first registration stays
  assert reg.getPermission("a:b")[1].description == "d"
  assert not reg.getPermission("a:c")[0]

# attachment
block:
  let a = newPermissionAttachment()
  assert a.hasPermissionSet("x") == (false, false)
  a.setPermission("x", true)
  assert a.hasPermissionSet("x") == (true, true)
  a.setPermission("x", false)
  assert a.hasPermissionSet("x") == (true, false)
  assert a.getPermissions().len == 1
  a.unsetPermission("x")
  assert a.hasPermissionSet("x") == (false, false)

# defaults with no attachment
block:
  var m = freshManager()
  assert m.hasPermission(player, "minecraft:command.help", Zero)
  assert not m.hasPermission(player, "minecraft:command.stop", Four)
  assert not m.hasPermission(player, "minecraft:command.gamemode", One)
  assert m.hasPermission(player, "minecraft:command.gamemode", Two)
  assert m.hasPermission(player, "minecraft:command.gamemode", Four)
  assert not m.hasPermission(player, "minecraft:unregistered", Four)

# exact match beats everything, even a true wildcard
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("minecraft:command.help", false)
  a.setPermission("minecraft:*", true)
  assert not m.hasPermission(player, "minecraft:command.help", Four)
  assert m.hasPermission(player, "minecraft:command.stop", Zero)
  # another player's attachment is separate
  assert m.hasPermission(otherPlayer, "minecraft:command.help", Zero)

# namespace wildcard goes before a key level
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("minecraft:*", false)
  a.setPermission("minecraft:command", true)
  assert not m.hasPermission(player, "minecraft:command.help", Four)

# key level then its wildcard, walking left to right
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("minecraft:command", true)
  a.setPermission("minecraft:command.*", false)
  assert m.hasPermission(player, "minecraft:command.stop", Zero)

  var m2 = freshManager()
  let a2 = m2.getAttachment(player)
  a2.setPermission("minecraft:command.*", false)
  assert not m2.hasPermission(player, "minecraft:command.help", Zero)

  var m3 = freshManager()
  let a3 = m3.getAttachment(player)
  a3.setPermission("minecraft:a.b.*", true)
  assert m3.hasPermission(player, "minecraft:a.b.c", Zero)
  assert not m3.hasPermission(player, "minecraft:a.d.c", Zero)
  # a trailing part has no wildcard of its own
  a3.setPermission("minecraft:x.y.*", true)
  assert not m3.hasPermission(player, "minecraft:x.y", Zero)

# a node that does not split in two skips the wildcard walk
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("nocolon.*", true)
  assert not m.hasPermission(player, "nocolon.child", Zero)
  a.setPermission("a:*", true)
  assert not m.hasPermission(player, "a:b:c", Zero)

# inherited from a set parent
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("minecraft:command.parent", true)
  assert m.hasPermission(player, "minecraft:command.kid_yes", Zero)
  assert not m.hasPermission(player, "minecraft:command.kid_no", Zero)
  a.setPermission("minecraft:command.parent", false)
  assert not m.hasPermission(player, "minecraft:command.kid_yes", Zero)

# with an attachment that does not speak to the node, the default still applies
block:
  var m = freshManager()
  discard m.getAttachment(player)
  assert m.hasPermission(player, "minecraft:command.help", Zero)
  assert not m.hasPermission(player, "minecraft:command.gamemode", Zero)

# the attachment is shared, and removal forgets it
block:
  var m = freshManager()
  let a = m.getAttachment(player)
  a.setPermission("minecraft:command.stop", true)
  assert m.getAttachment(player).hasPermissionSet("minecraft:command.stop") == (true, true)
  assert m.hasPermission(player, "minecraft:command.stop", Zero)
  m.removeAttachment(player)
  assert not m.hasPermission(player, "minecraft:command.stop", Zero)
  assert m.getAttachment(player).getPermissions().len == 0

# PermissionLvl ordering and serde
assert Zero < One and One < Two and Three < Four
assert Two >= Two
assert toJsonString(toJson(Four)) == "4"
assert fromJson(PermissionLvl, jsonInt(0)).successResult == Zero
assert fromJson(PermissionLvl, jsonInt(4)).successResult == Four
assert fromJson(PermissionLvl, jsonInt(1)).message == "Invalid value for OpLevel: 1"
assert fromJson(PermissionLvl, jsonInt(5)).message == "Invalid value for OpLevel: 5"
assert fromJson(PermissionLvl, jsonInt(300)).message == "invalid value: integer `300`, expected u8"
assert fromJson(PermissionLvl, jsonString("x")).message == "invalid type: string \"x\", expected u8"

# PermissionDefault serde
assert toJsonString(toJson(permissionDeny())) == "\"Deny\""
assert toJsonString(toJson(permissionAllow())) == "\"Allow\""
assert toJsonString(toJson(permissionOp(Three))) == "{\"Op\":3}"
assert fromJson(PermissionDefault, jsonString("Allow")).successResult == permissionAllow()
let op = parseJsonValue("{\"Op\":2}")
assert fromJson(PermissionDefault, op.value).successResult == permissionOp(Two)
assert fromJson(PermissionDefault, jsonString("Nope")).message ==
  "unknown variant `Nope`, expected one of `Deny`, `Allow`, `Op`"

# Permission and attachment serde
block:
  var p = newPermission("n:o", "desc", permissionOp(Four))
  addChild(p, "z", true)
  addChild(p, "a", false)
  let text = toJsonString(toJson(p))
  assert text == "{\"children\":{\"a\":false,\"z\":true},\"default\":{\"Op\":4},\"description\":\"desc\",\"node\":\"n:o\"}"
  let back = fromJson(Permission, parseJsonValue(text).value)
  assert back.isSuccess
  assert back.successResult.node == "n:o"
  assert back.successResult.default == permissionOp(Four)
  assert back.successResult.children.len == 2
  assert fromJson(Permission, parseJsonValue("{\"node\":\"x\"}").value).message ==
    "missing field `description`"

block:
  let a = newPermissionAttachment()
  a.setPermission("x", true)
  let text = toJsonString(toJson(a))
  assert text == "{\"permissions\":{\"x\":true}}"
  let back = fromJson(PermissionAttachment, parseJsonValue(text).value)
  assert back.isSuccess and back.successResult.hasPermissionSet("x") == (true, true)

echo "permission checks passed"
