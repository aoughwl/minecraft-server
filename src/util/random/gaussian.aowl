## Port of pumpkin-util/src/random/gaussian.rs
##
## `GaussianGenerator: RandomImpl` becomes a generic over `R`, which supplies `nextF64`, `storedNextGaussian` and
## `setStoredNextGaussian`.

{.feature: "untyped".}

import std/math
import std/options

proc calculateGaussian*[R](self: var R): float64 =
  mixin nextF64, storedNextGaussian, setStoredNextGaussian
  let stored: Option[float64] = storedNextGaussian(self)
  if stored.isSome:
    setStoredNextGaussian(self, none[float64]())
    return stored.get
  while true:
    # mul_add(2.0, -1.0): doubling is exact, so the fused and plain forms are the same value.
    let d = nextF64(self) * 2.0'f64 - 1.0'f64
    let e = nextF64(self) * 2.0'f64 - 1.0'f64
    let f = d * d + e * e
    if f < 1.0'f64 and f != 0.0'f64:
      let g = sqrt(-2.0'f64 * ln(f) / f)
      setStoredNextGaussian(self, some(e * g))
      return d * g
