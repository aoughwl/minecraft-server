## pumpkin-util/src/random/gaussian.rs has no #[test] of its own: its behaviour is upstream's next_gaussian vectors
## in legacy_rand.rs and xoroshiro128.rs. They run here through calculateGaussian on real generators, so the shared
## stored-value order is checked directly.

import std/syncio
import std/options
import ./gaussian
import ../legacy_rand as lr
import ../xoroshiro128 as xr

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

block storedValueIsHandedBackFirst:
  var r = lr.fromSeed(0'u64)
  check(storedNextGaussian(r).isNone, "starts empty")
  setStoredNextGaussian(r, some(42.5'f64))
  check(calculateGaussian(r) == 42.5'f64, "stored value comes first")
  check(storedNextGaussian(r).isNone, "stored value is cleared")
  # Nothing was drawn, so this is still upstream's first legacy value.
  check(calculateGaussian(r) == 0.8025330637390305'f64, "legacy first")
  check(storedNextGaussian(r).get == -0.9015460884175122'f64, "legacy stores the second for next time")
  check(calculateGaussian(r) == -0.9015460884175122'f64, "legacy second")

block xoroshiro:
  var r = xr.fromSeed(0'u64)
  check(calculateGaussian(r) == -0.48540690699780015'f64, "xoroshiro first")
  check(calculateGaussian(r) == 0.43399227545320296'f64, "xoroshiro second")

echo "gaussian: all checks passed"
