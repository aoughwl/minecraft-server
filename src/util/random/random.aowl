## Port of pumpkin-util/src/random/mod.rs
##
## `#[enum_dispatch]` becomes case objects with one dispatching proc per trait method. `RandomGenerator` also has
## the `Worldgen` variant the newer ../ref/pumpkin tree adds, since worldgen_random.aowl exists here. The trait
## bounds become the `RandomImpl` and `RandomDeriverImpl` concepts; a plain `[R]` generic also works, as the noise
## ports use. Trait forms that collide with an inherent proc on the concrete type: `nextSplitter` returns the
## `RandomDeriver` and `newSplitter` the concrete splitter. `getDecoratorSeed` lives in worldgen_random.aowl and
## `hashBlockPos` in legacy_rand.aowl, both re-exported here.

import std/atomics
import std/times
import ./rustnum
import ../legacy_rand
import ../xoroshiro128
import ../worldgen_random

export legacy_rand.LegacyRand, legacy_rand.LegacySplitter
export xoroshiro128.Xoroshiro, xoroshiro128.XoroshiroSplitter
export worldgen_random.WorldgenRandom, worldgen_random.getDecoratorSeed
export legacy_rand.hashBlockPos

const SeedUniquifierStart = 8682522807148012'u64

var seedUniquifier: uint64 = SeedUniquifierStart

proc getSeed*(): uint64 =
  ## Time-based seed, unique across calls at the same time.
  var seed = atomicLoad(seedUniquifier, moRelaxed)
  while not atomicCompareExchangeWeak(seedUniquifier, seed, seed * 1181783497276652981'u64, moRelaxed, moRelaxed):
    discard
  let now = getTime()
  # as_nanos fits u64 until 2554; upstream's `as u64` truncation of the u128 changes nothing before then.
  let nanos = cast[uint64](toUnix(now)) * 1_000_000_000'u64 + uint64(nanosecond(now))
  let nanoUpper = nanos shr 8
  let nanoLower = nanos
  seed xor nanoUpper xor nanoLower

type
  RandomGeneratorKind* = enum
    rgXoroshiro
    rgWorldgen
    rgLegacy

  RandomGenerator* = object
    case kind*: RandomGeneratorKind
    of rgXoroshiro:
      xoroshiro*: Xoroshiro
    of rgWorldgen:
      worldgen*: WorldgenRandom
    of rgLegacy:
      legacy*: LegacyRand

  RandomDeriverKind* = enum
    rdXoroshiro
    rdLegacy

  RandomDeriver* = object
    case kind*: RandomDeriverKind
    of rdXoroshiro:
      xoroshiro*: XoroshiroSplitter
    of rdLegacy:
      legacy*: LegacySplitter

  RandomImpl* = concept
    proc split(r: var Self): Self
    proc nextSplitter(r: var Self): RandomDeriver
    proc nextI32(r: var Self): int32
    proc nextBoundedI32(r: var Self, bound: int32): int32
    proc nextInbetweenI32(r: var Self, minV, maxV: int32): int32
    proc nextInbetweenF32(r: var Self, minV, maxV: float32): float32
    proc nextI64(r: var Self): int64
    proc nextBool(r: var Self): bool
    proc nextF32(r: var Self): float32
    proc nextF64(r: var Self): float64
    proc nextGaussian(r: var Self): float64
    proc nextTriangular(r: var Self, mode, deviation: float64): float64
    proc skip(r: var Self, count: int32)
    proc nextInbetweenI32Exclusive(r: var Self, minV, maxV: int32): int32

  RandomDeriverImpl* = concept
    proc splitString(s: Self, seed: string): RandomGenerator
    proc splitU64(s: Self, seed: uint64): RandomGenerator
    proc splitPos(s: Self, x, y, z: int32): RandomGenerator

proc toRandomGenerator*(r: Xoroshiro): RandomGenerator =
  RandomGenerator(kind: rgXoroshiro, xoroshiro: r)

proc toRandomGenerator*(r: WorldgenRandom): RandomGenerator =
  RandomGenerator(kind: rgWorldgen, worldgen: r)

proc toRandomGenerator*(r: LegacyRand): RandomGenerator =
  RandomGenerator(kind: rgLegacy, legacy: r)

proc toRandomDeriver*(s: XoroshiroSplitter): RandomDeriver =
  RandomDeriver(kind: rdXoroshiro, xoroshiro: s)

proc toRandomDeriver*(s: LegacySplitter): RandomDeriver =
  RandomDeriver(kind: rdLegacy, legacy: s)

proc getRegionSeed*(worldSeed: uint64, regionX, regionZ: int32, salt: uint32): uint64 =
  let xPart = cast[uint64](wrapMul(int64(regionX), 341873128712'i64))
  let zPart = cast[uint64](wrapMul(int64(regionZ), 132897987541'i64))
  worldSeed + xPart + zPart + uint64(salt)

proc seedSlimeChunk*(x, z: int32, seed, salt: uint64): uint64 =
  (seed +
    signExtendU64(wrapMul(wrapMul(x, x), 4_987_142'i32)) +
    signExtendU64(wrapMul(x, 5_947_611'i32)) +
    cast[uint64](wrapMul(int64(wrapMul(z, z)), 4_392_871'i64)) +
    signExtendU64(wrapMul(z, 389_711'i32))) xor salt

proc getCarverSeed*(worldSeed: uint64, chunkX, chunkZ: int32): uint64 =
  var random = legacy_rand.fromSeed(worldSeed)
  let l = nextI64(random) or 1'i64
  let m = nextI64(random) or 1'i64
  cast[uint64](wrapAdd(wrapMul(int64(chunkX), l), wrapMul(int64(chunkZ), m))) xor worldSeed

# RandomImpl::next_splitter on the concrete generators.

proc nextSplitter*(r: var Xoroshiro): RandomDeriver =
  toRandomDeriver(newSplitter(r))

proc nextSplitter*(r: var LegacyRand): RandomDeriver =
  toRandomDeriver(newSplitter(r))

proc nextSplitter*(r: var WorldgenRandom): RandomDeriver =
  toRandomDeriver(newSplitter(r))

# RandomImpl for RandomGenerator.

proc split*(r: var RandomGenerator): RandomGenerator =
  case r.kind
  of rgXoroshiro: toRandomGenerator(split(r.xoroshiro))
  of rgWorldgen: toRandomGenerator(split(r.worldgen))
  of rgLegacy: toRandomGenerator(split(r.legacy))

proc nextSplitter*(r: var RandomGenerator): RandomDeriver =
  case r.kind
  of rgXoroshiro: nextSplitter(r.xoroshiro)
  of rgWorldgen: nextSplitter(r.worldgen)
  of rgLegacy: nextSplitter(r.legacy)

proc nextI32*(r: var RandomGenerator): int32 =
  case r.kind
  of rgXoroshiro: nextI32(r.xoroshiro)
  of rgWorldgen: nextI32(r.worldgen)
  of rgLegacy: nextI32(r.legacy)

proc nextBoundedI32*(r: var RandomGenerator, bound: int32): int32 =
  case r.kind
  of rgXoroshiro: nextBoundedI32(r.xoroshiro, bound)
  of rgWorldgen: nextBoundedI32(r.worldgen, bound)
  of rgLegacy: nextBoundedI32(r.legacy, bound)

proc nextInbetweenI32*(r: var RandomGenerator, minV, maxV: int32): int32 =
  wrapAdd(nextBoundedI32(r, wrapAdd(wrapSub(maxV, minV), 1'i32)), minV)

proc nextI64*(r: var RandomGenerator): int64 =
  case r.kind
  of rgXoroshiro: nextI64(r.xoroshiro)
  of rgWorldgen: nextI64(r.worldgen)
  of rgLegacy: nextI64(r.legacy)

proc nextBool*(r: var RandomGenerator): bool =
  case r.kind
  of rgXoroshiro: nextBool(r.xoroshiro)
  of rgWorldgen: nextBool(r.worldgen)
  of rgLegacy: nextBool(r.legacy)

proc nextF32*(r: var RandomGenerator): float32 =
  case r.kind
  of rgXoroshiro: nextF32(r.xoroshiro)
  of rgWorldgen: nextF32(r.worldgen)
  of rgLegacy: nextF32(r.legacy)

proc nextInbetweenF32*(r: var RandomGenerator, minV, maxV: float32): float32 =
  nextF32(r) * (maxV - minV) + minV

proc nextF64*(r: var RandomGenerator): float64 =
  case r.kind
  of rgXoroshiro: nextF64(r.xoroshiro)
  of rgWorldgen: nextF64(r.worldgen)
  of rgLegacy: nextF64(r.legacy)

proc nextGaussian*(r: var RandomGenerator): float64 =
  case r.kind
  of rgXoroshiro: nextGaussian(r.xoroshiro)
  of rgWorldgen: nextGaussian(r.worldgen)
  of rgLegacy: nextGaussian(r.legacy)

proc nextTriangular*(r: var RandomGenerator, mode, deviation: float64): float64 =
  let a = nextF64(r)
  let b = nextF64(r)
  mode + deviation * (a - b)

proc skip*(r: var RandomGenerator, count: int32) =
  case r.kind
  of rgXoroshiro: skip(r.xoroshiro, count)
  of rgWorldgen: skip(r.worldgen, count)
  of rgLegacy: skip(r.legacy, count)

proc nextInbetweenI32Exclusive*(r: var RandomGenerator, minV, maxV: int32): int32 =
  wrapAdd(minV, nextBoundedI32(r, wrapSub(maxV, minV)))

# RandomDeriverImpl for RandomDeriver.

proc splitString*(s: RandomDeriver, seed: string): RandomGenerator =
  case s.kind
  of rdXoroshiro: toRandomGenerator(splitString(s.xoroshiro, seed))
  of rdLegacy: toRandomGenerator(splitString(s.legacy, seed))

proc splitU64*(s: RandomDeriver, seed: uint64): RandomGenerator =
  case s.kind
  of rdXoroshiro: toRandomGenerator(splitU64(s.xoroshiro, seed))
  of rdLegacy: toRandomGenerator(splitU64(s.legacy, seed))

proc splitPos*(s: RandomDeriver, x, y, z: int32): RandomGenerator =
  case s.kind
  of rdXoroshiro: toRandomGenerator(splitPos(s.xoroshiro, x, y, z))
  of rdLegacy: toRandomGenerator(splitPos(s.legacy, x, y, z))
