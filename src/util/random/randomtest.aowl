## Upstream's #[test] blocks in pumpkin-util/src/random/mod.rs, plus known answers for what they leave untested.

import std/syncio
import std/assertions
import ./random
import ../legacy_rand as lr
import ../xoroshiro128 as xr
import ../worldgen_random as wr

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

proc takesImpl[R: RandomImpl](r: var R): int32 = nextI32(r)
proc takesDeriver[D: RandomDeriverImpl](d: D): RandomGenerator = splitU64(d, 1'u64)

block regionSeed:
  check(getRegionSeed(12345612'u64, 1'i32, 1'i32, 14357620'u32) == 474797819485'u64, "region_seed")

block blockPositionHash:
  let values = [
    (0'i32, 0'i64),
    (1'i32, 60311958971344'i64),
    (4'i32, 120566413180880'i64),
    (25'i32, 111753446486209'i64),
    (676'i32, 75210837988243'i64),
    (458329'i32, -43764888250'i64),
    (-387008604'i32, 8437923733503'i64),
    (176771161'i32, 18421337580760'i64),
  ]
  for i in 0 ..< values.len:
    let v = values[i][0]
    check(hashBlockPos(v, v, v) == values[i][1], "block_position_hash " & $v)

block decoratorAndPopulation:
  # Worldgen vectors are vanilla's, from upstream's worldgen_random.rs; this is the shared decorator seed.
  check(getDecoratorSeed(0x36e9895dda2bad81'u64, 69'u64, 9'u64) == 0x36e9895dda2d0d56'u64, "decorator seed")

block generatedKnownAnswers:
  # From an independent Python oracle written from the Rust text.
  check(lr.getPopulationSeed(1234'u64, 160'i32, -320'i32) == 344552161718863986'u64, "legacy population seed")
  check(xr.getPopulationSeed(1234'u64, 160'i32, -320'i32) == 5549024284467847858'u64, "xoroshiro population seed")
  check(seedSlimeChunk(100'i32, -200'i32, 12345'u64, 987234911'u64) == 174450762354'u64, "slime chunk seed")
  check(seedSlimeChunk(46341'i32, 46341'i32, 42'u64, 987234911'u64) == 18437310477685919422'u64, "slime chunk seed, i32 wrap")
  check(getCarverSeed(1234'u64, 5'i32, -7'i32) == 10577489126809502210'u64, "carver seed")

block dispatchMatchesConcrete:
  var a = toRandomGenerator(xr.fromSeed(0'u64))
  var b = xr.fromSeed(0'u64)
  check(a.nextI32() == b.nextI32(), "xoroshiro i32")
  check(a.nextI64() == b.nextI64(), "xoroshiro i64")
  check(a.nextBoundedI32(10'i32) == b.nextBoundedI32(10'i32), "xoroshiro bounded")
  check(a.nextF32() == b.nextF32(), "xoroshiro f32")
  check(a.nextF64() == b.nextF64(), "xoroshiro f64")
  check(a.nextBool() == b.nextBool(), "xoroshiro bool")
  check(a.nextGaussian() == b.nextGaussian(), "xoroshiro gaussian")
  check(a.nextTriangular(10.0, 5.0) == b.nextTriangular(10.0, 5.0), "xoroshiro triangular")
  check(a.nextInbetweenI32(3'i32, 9'i32) == b.nextInbetweenI32(3'i32, 9'i32), "xoroshiro inbetween")
  check(a.nextInbetweenI32Exclusive(3'i32, 9'i32) == b.nextInbetweenI32Exclusive(3'i32, 9'i32), "xoroshiro exclusive")
  check(a.nextInbetweenF32(1.5'f32, 2.5'f32) == b.nextInbetweenF32(1.5'f32, 2.5'f32), "xoroshiro inbetween f32")
  a.skip(5'i32)
  b.skip(5'i32)
  check(a.nextI64() == b.nextI64(), "xoroshiro skip")

  var c = toRandomGenerator(lr.fromSeed(0'u64))
  var d = lr.fromSeed(0'u64)
  check(c.nextI32() == d.nextI32(), "legacy i32")
  c.skip(5'i32)
  d.skip(5'i32)
  check(c.nextI64() == d.nextI64(), "legacy skip is one LCG step per count")
  check(c.nextGaussian() == d.nextGaussian(), "legacy gaussian")

  var e = toRandomGenerator(wr.fromSeed(0'u64))
  var f = wr.fromSeed(0'u64)
  check(e.nextI64() == f.nextI64(), "worldgen i64")
  check(e.nextF64() == f.nextF64(), "worldgen f64")
  check(e.nextBoundedI32(16'i32) == f.nextBoundedI32(16'i32), "worldgen bounded")

block splitters:
  # Upstream's split vectors in legacy_rand.rs and xoroshiro128.rs, through the enums.
  var original = toRandomGenerator(lr.fromSeed(0'u64))
  var fresh = original.split()
  let legacyDeriver = fresh.nextSplitter()
  check(legacyDeriver.kind == rdLegacy, "legacy deriver kind")
  var r1 = legacyDeriver.splitString("TEST STRING")
  check(r1.kind == rgLegacy and r1.nextI32() == -1170413697'i32, "legacy split_string")
  var r2 = legacyDeriver.splitU64(10'u64)
  check(r2.nextI32() == -1157793070'i32, "legacy split_u64")
  var r3 = legacyDeriver.splitPos(1'i32, 11'i32, -111'i32)
  check(r3.nextI32() == -1213890343'i32, "legacy split_pos")
  check(original.nextI32() == 1033096058'i32, "legacy original untouched")
  check(fresh.nextI32() == -888301832'i32, "legacy new_rand untouched")

  var xoriginal = toRandomGenerator(xr.fromSeed(0'u64))
  var xfresh = xoriginal.split()
  check(xfresh.nextI32() == 542195535'i32, "xoroshiro split")
  let xderiver = xfresh.nextSplitter()
  check(xderiver.kind == rdXoroshiro, "xoroshiro deriver kind")
  var x1 = xderiver.splitString("TEST STRING")
  check(x1.kind == rgXoroshiro and x1.nextI32() == -641435713'i32, "xoroshiro split_string")
  var x2 = xderiver.splitU64(42069'u64)
  check(x2.nextI32() == -340700677'i32, "xoroshiro split_u64")
  var x3 = xderiver.splitPos(1337'i32, 80085'i32, -69420'i32)
  check(x3.nextI32() == 790449132'i32, "xoroshiro split_pos")
  check(xoriginal.nextI32() == 653572596'i32, "xoroshiro original untouched")
  check(xfresh.nextI32() == 435917842'i32, "xoroshiro new_rand untouched")

  var w = toRandomGenerator(wr.fromSeed(0'u64))
  check(w.nextSplitter().kind == rdXoroshiro, "worldgen derives a xoroshiro splitter")
  var wsplit = w.split()
  check(wsplit.kind == rgWorldgen, "worldgen split stays worldgen")

block concepts:
  var a = xr.fromSeed(0'u64)
  check(takesImpl(a) == -160476802'i32, "Xoroshiro is a RandomImpl")
  var b = lr.fromSeed(0'u64)
  check(takesImpl(b) == -1155484576'i32, "LegacyRand is a RandomImpl")
  var c = wr.fromSeed(0'u64)
  discard takesImpl(c)
  var d = toRandomGenerator(lr.fromSeed(0'u64))
  check(takesImpl(d) == -1155484576'i32, "RandomGenerator is a RandomImpl")
  var splitter = d.nextSplitter()
  var g = takesDeriver(splitter)
  check(g.kind == rgLegacy, "RandomDeriver is a RandomDeriverImpl")

block getSeedDiffers:
  let s1 = getSeed()
  let s2 = getSeed()
  check(s1 != s2, "get_seed gives a new value each call")

echo "random: all checks passed"
