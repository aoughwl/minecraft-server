## Rust integer and float semantics the noise and random ports rely on. No upstream counterpart.
##
## Signed overflow is undefined in the C aowlmony emits, so `wrapping_*` goes through unsigned.

proc wrapAdd*(a, b: int32): int32 {.inline.} = cast[int32](cast[uint32](a) + cast[uint32](b))
proc wrapSub*(a, b: int32): int32 {.inline.} = cast[int32](cast[uint32](a) - cast[uint32](b))
proc wrapMul*(a, b: int32): int32 {.inline.} = cast[int32](cast[uint32](a) * cast[uint32](b))

proc wrapAdd*(a, b: int64): int64 {.inline.} = cast[int64](cast[uint64](a) + cast[uint64](b))
proc wrapSub*(a, b: int64): int64 {.inline.} = cast[int64](cast[uint64](a) - cast[uint64](b))
proc wrapMul*(a, b: int64): int64 {.inline.} = cast[int64](cast[uint64](a) * cast[uint64](b))

proc truncI32*(x: int64): int32 {.inline.} =
  ## `x as i32`
  cast[int32](uint32(cast[uint64](x) and 0xFFFFFFFF'u64))

proc truncI32*(x: uint64): int32 {.inline.} =
  ## `x as i32`
  cast[int32](uint32(x and 0xFFFFFFFF'u64))

proc signExtendU64*(x: int32): uint64 {.inline.} =
  ## `x as u64`
  cast[uint64](int64(x))

proc asI32*(x: float64): int32 {.inline.} =
  ## `x as i32`: NaN becomes 0, out-of-range values clamp.
  if x != x: 0'i32
  elif x >= 2147483648.0'f64: int32.high
  elif x <= -2147483648.0'f64: int32.low
  else: int32(x)

proc asI64*(x: float64): int64 {.inline.} =
  ## `x as i64`: NaN becomes 0, out-of-range values clamp.
  if x != x: 0'i64
  elif x >= 9223372036854775808.0'f64: int64.high
  elif x <= -9223372036854775808.0'f64: int64.low
  else: int64(x)

proc powi*(base: float64, exponent: int32): float64 =
  ## `f64::powi`, the same square-and-multiply as compiler-rt's `__powidf2`.
  var a = base
  var b = exponent
  let recip = b < 0'i32
  var r = 1.0'f64
  while true:
    if (b and 1'i32) != 0'i32:
      r = r * a
    b = b div 2'i32
    if b == 0'i32:
      break
    a = a * a
  if recip: 1.0'f64 / r else: r
