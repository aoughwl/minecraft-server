## Port of pumpkin-util/src/registry.rs

import ../codecs/json_value
import ../codecs/data_result
import serde_forms

type
  TagTypeKind* = enum
    ttkItem
    ttkTag

  TagType* = object
    kind*: TagTypeKind
    name*: string   ## the item name or the tag, without its `#`

  RegistryEntryListKind* = enum
    relSingle
    relMany

  RegistryEntryList* = object
    case kind*: RegistryEntryListKind
    of relSingle:
      single*: TagType
    of relMany:
      many*: seq[TagType]

proc tagItem*(name: string): TagType = TagType(kind: ttkItem, name: name)
proc tagTag*(tag: string): TagType = TagType(kind: ttkTag, name: tag)

proc singleEntry*(t: TagType): RegistryEntryList = RegistryEntryList(kind: relSingle, single: t)
proc manyEntries*(s: seq[TagType]): RegistryEntryList = RegistryEntryList(kind: relMany, many: s)

proc serialize*(t: TagType): string =
  case t.kind
  of ttkItem: t.name
  of ttkTag: "#" & t.name

proc `==`*(a, b: TagType): bool =
  a.kind == b.kind and a.name == b.name

proc visitStr*(v: string): TagType =
  ## `TagVisitor::visit_str`.
  if v.len > 0 and v[0] == '#': tagTag(v[1 .. ^1])
  else: tagItem(v)

proc intoVec*(l: RegistryEntryList): seq[TagType] =
  case l.kind
  of relSingle: @[l.single]
  of relMany: l.many

proc `==`*(a, b: RegistryEntryList): bool =
  if a.kind != b.kind: return false
  case a.kind
  of relSingle:
    a.single == b.single
  of relMany:
    if a.many.len != b.many.len: return false
    for i in 0 ..< a.many.len:
      if not (a.many[i] == b.many[i]): return false
    true

proc `==`*(l: RegistryEntryList, other: TagType): bool =
  ## `impl PartialEq<TagType> for RegistryEntryList`.
  case l.kind
  of relSingle:
    other == l.single
  of relMany:
    for x in l.many:
      if x == other: return true
    false

proc fromJson*(t: typedesc[TagType], v: JsonValue): DataResult[TagType] =
  if v.kind == jvString: newSuccess(visitStr(v.strVal))
  else: newError[TagType](invalidType(v, "valid tag"))

proc fromJson*(t: typedesc[RegistryEntryList], v: JsonValue): DataResult[RegistryEntryList] =
  case v.kind
  of jvString:
    newSuccess(singleEntry(visitStr(v.strVal)))
  of jvArray:
    var ingredients: seq[TagType] = @[]
    for item in v.items:
      let e = fromJson(TagType, item)
      if not e.isSuccess:
        return newError[RegistryEntryList](e.message)
      ingredients.add(e.successResult)
    if ingredients.len == 1:
      newSuccess(singleEntry(ingredients[0]))
    else:
      newSuccess(manyEntries(ingredients))
  else:
    newError[RegistryEntryList](invalidType(v, "valid ingredient slot"))
