## Known answers for registry.aowl. Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import registry

proc list(text: string): DataResult[RegistryEntryList] =
  let o = parseJsonValue(text)
  assert o.ok
  fromJson(RegistryEntryList, o.value)

assert serialize(tagItem("minecraft:stone")) == "minecraft:stone"
assert serialize(tagTag("minecraft:logs")) == "#minecraft:logs"
assert visitStr("#a:b") == tagTag("a:b")
assert visitStr("a:b") == tagItem("a:b")
assert visitStr("") == tagItem("")
assert visitStr("#") == tagTag("")

assert list("\"minecraft:stone\"").successResult == singleEntry(tagItem("minecraft:stone"))
assert list("\"#minecraft:logs\"").successResult == singleEntry(tagTag("minecraft:logs"))

# a one-element array collapses to Single; empty stays Many
assert list("[\"#t\"]").successResult == singleEntry(tagTag("t"))
assert list("[]").successResult == manyEntries(@[])
let two = list("[\"a\", \"#b\"]").successResult
assert two == manyEntries(@[tagItem("a"), tagTag("b")])
assert not (two == singleEntry(tagItem("a")))

assert intoVec(singleEntry(tagItem("a"))).len == 1
assert intoVec(two).len == 2
assert intoVec(two)[1] == tagTag("b")

assert singleEntry(tagItem("a")) == tagItem("a")
assert not (singleEntry(tagItem("a")) == tagTag("a"))
assert two == tagTag("b")
assert not (two == tagItem("b"))

assert list("1").message == "invalid type: integer `1`, expected valid ingredient slot"
assert list("[1]").message == "invalid type: integer `1`, expected valid tag"

echo "registry checks passed"
