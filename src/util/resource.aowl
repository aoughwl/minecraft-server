## Port of pumpkin-util/src/resource_key.rs

import identifier

type
  ResourceKey* = object
    registryName*: Identifier
    identifier*: Identifier

proc newResourceKey*(registryName, identifier: Identifier): ResourceKey =
  ResourceKey(registryName: registryName, identifier: identifier)

proc castKey*(key: ResourceKey, registry: Identifier): (bool, ResourceKey) =
  ## `ResourceKey::cast` with `Option<&Self>` as a pair. `cast` is reserved in aowlmony.
  if key.registryName == registry:
    (true, key)
  else:
    (false, key)

func `==`*(a, b: ResourceKey): bool =
  a.registryName == b.registryName and a.identifier == b.identifier

func `<`*(a, b: ResourceKey): bool =
  ## Derived `Ord`: registry name, then identifier.
  if a.registryName != b.registryName: a.registryName < b.registryName
  else: a.identifier < b.identifier
