## Port of pumpkin-util/src/resource_location.rs
##
## The two traits have no shared dispatch upstream beyond their bound, so an implementer defines overloads
## `toResourceLocation(x: X): ResourceLocation` and `fromResourceLocation(t: typedesc[X], r: ResourceLocation): (bool, X)`,
## and a bound becomes a plain generic parameter.

type
  ResourceLocation* = string
    ## A fully qualified identifier for resources, usually in `namespace:path` form.
