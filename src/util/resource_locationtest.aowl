## Shows the trait shape of resource_location.aowl working through a generic bound.

{.feature: "untyped".}

import std/assertions
import std/syncio
import resource_location

type Thing = object
  n: string

proc toResourceLocation(x: Thing): ResourceLocation = "minecraft:" & x.n

proc fromResourceLocation(t: typedesc[Thing], r: ResourceLocation): (bool, Thing) =
  if r.len > 10 and r[0 .. 9] == "minecraft:": (true, Thing(n: r[10 .. ^1]))
  else: (false, Thing(n: ""))

proc roundTrip[T](x: T): ResourceLocation = toResourceLocation(x)

assert roundTrip(Thing(n: "stone")) == "minecraft:stone"
assert fromResourceLocation(Thing, "minecraft:dirt") == (true, Thing(n: "dirt"))
assert fromResourceLocation(Thing, "other:dirt")[0] == false

echo "resource_location checks passed"
