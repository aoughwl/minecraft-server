## Known answers for resource.aowl (resource_key.rs). Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import identifier as idmod
import resource

let reg = vanillaStatic("worldgen/biome")
let other = vanillaStatic("dimension")
let plains = vanillaStatic("plains")
let k = newResourceKey(reg, plains)

assert castKey(k, reg)[0]
assert $castKey(k, reg)[1].identifier == "minecraft:plains"
assert not castKey(k, other)[0]

assert k == newResourceKey(reg, plains)
assert k != newResourceKey(other, plains)
assert newResourceKey(other, plains) < k
assert newResourceKey(reg, vanillaStatic("desert")) < k

echo "resource_key checks passed"
