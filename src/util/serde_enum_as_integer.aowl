## Port of pumpkin-util/src/serde_enum_as_integer.rs
##
## `ToPrimitive`/`FromPrimitive` on a field-less enum are its ordinal. The one upstream user is
## `Difficulty` in level.dat, read through NBT; a caller turns the i8 here into a byte tag.

{.feature: "untyped".}

import ../codecs/json_value
import ../codecs/data_result
import serde_forms

proc serializeI8*[V: enum](value: V): DataResult[int8] =
  let n = ord(value)
  if n < -128 or n > 127:
    return newError[int8]("Invalid enum value")
  newSuccess(int8(n))

proc serialize*[V: enum](value: V): DataResult[JsonValue] =
  let n = serializeI8(value)
  if not n.isSuccess:
    return newError[JsonValue](n.message)
  newSuccess(jsonInt(int64(n.successResult)))

proc deserializeI8*[V: enum](value: int8): DataResult[V] =
  for e in low(V) .. high(V):
    if ord(e) == int(value):
      return newSuccess(e)
  newError[V]("Invalid enum value")

proc deserialize*[V: enum](input: JsonValue): DataResult[V] =
  let n = readSigned(input, -128'i64, 127'i64, "i8")
  if not n.isSuccess:
    return newError[V](n.message)
  deserializeI8[V](int8(n.successResult))
