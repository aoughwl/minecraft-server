## Known answers for serde_enum_as_integer.aowl. Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import difficulty
import serde_enum_as_integer

assert toJsonString(serialize(Hard).successResult) == "3"
assert toJsonString(serialize(Peaceful).successResult) == "0"

assert deserialize[Difficulty](jsonInt(2)).successResult == Normal
let high4 = deserialize[Difficulty](jsonInt(4))
assert high4.message == "Invalid enum value"
assert deserialize[Difficulty](jsonInt(-1)).message == "Invalid enum value"
assert deserialize[Difficulty](jsonInt(300)).message == "invalid value: integer `300`, expected i8"
assert deserialize[Difficulty](jsonString("Hard")).message ==
  "invalid type: string \"Hard\", expected i8"
assert deserializeI8[Difficulty](1'i8).successResult == Easy

echo "serde_enum_as_integer checks passed"
