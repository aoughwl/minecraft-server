## Support module with no upstream file: the value readers and serde error text shared by the
## explicit toJson/fromJson forms in src/util. Messages match what serde_json's `from_value` reports.

import ../codecs/json_value
import ../codecs/data_result

proc unexpected*(v: JsonValue): string =
  ## serde's `Unexpected` as `Value` reports it.
  case v.kind
  of jvNull: "null"
  of jvBool: "boolean `" & (if v.boolVal: "true" else: "false") & "`"
  of jvInt: "integer `" & $v.intVal & "`"
  of jvUInt: "integer `" & $v.uintVal & "`"
  of jvFloat: "floating point `" & formatF64(v.floatVal) & "`"
  of jvString: "string \"" & v.strVal & "\""
  of jvArray: "sequence"
  of jvObject: "map"

proc invalidType*(v: JsonValue, expected: string): string =
  "invalid type: " & unexpected(v) & ", expected " & expected

proc missingField*(name: string): string =
  "missing field `" & name & "`"

proc unknownVariant*(variant: string, names: openArray[string]): string =
  result = "unknown variant `" & variant & "`, expected "
  if names.len == 1:
    result.add("`" & names[0] & "`")
  elif names.len == 2:
    result.add("`" & names[0] & "` or `" & names[1] & "`")
  else:
    result.add("one of ")
    for i in 0 ..< names.len:
      if i > 0: result.add(", ")
      result.add("`" & names[i] & "`")

proc readString*(v: JsonValue, expected = "a string"): DataResult[string] =
  if v.kind == jvString: newSuccess(v.strVal)
  else: newError[string](invalidType(v, expected))

proc readBool*(v: JsonValue): DataResult[bool] =
  if v.kind == jvBool: newSuccess(v.boolVal)
  else: newError[bool](invalidType(v, "a boolean"))

proc readSigned*(v: JsonValue, lo, hi: int64, typeName: string): DataResult[int64] =
  ## Rust's integer `Deserialize`: no floats, range-checked.
  case v.kind
  of jvInt:
    if v.intVal < lo or v.intVal > hi:
      newError[int64]("invalid value: " & unexpected(v) & ", expected " & typeName)
    else:
      newSuccess(v.intVal)
  of jvUInt:
    newError[int64]("invalid value: " & unexpected(v) & ", expected " & typeName)
  else:
    newError[int64](invalidType(v, typeName))

proc readUnsigned*(v: JsonValue, hi: uint64, typeName: string): DataResult[uint64] =
  case v.kind
  of jvInt:
    if v.intVal < 0 or uint64(v.intVal) > hi:
      newError[uint64]("invalid value: " & unexpected(v) & ", expected " & typeName)
    else:
      newSuccess(uint64(v.intVal))
  of jvUInt:
    if v.uintVal > hi:
      newError[uint64]("invalid value: " & unexpected(v) & ", expected " & typeName)
    else:
      newSuccess(v.uintVal)
  else:
    newError[uint64](invalidType(v, typeName))

proc readF64*(v: JsonValue): DataResult[float64] =
  case v.kind
  of jvInt: newSuccess(float64(v.intVal))
  of jvUInt: newSuccess(float64(v.uintVal))
  of jvFloat: newSuccess(v.floatVal)
  else: newError[float64](invalidType(v, "f64"))

proc readF32*(v: JsonValue): DataResult[float32] =
  case v.kind
  of jvInt: newSuccess(float32(v.intVal))
  of jvUInt: newSuccess(float32(v.uintVal))
  of jvFloat: newSuccess(float32(v.floatVal))
  else: newError[float32](invalidType(v, "f32"))

proc readUnitVariant*(v: JsonValue, names: openArray[string]): DataResult[int] =
  ## An externally tagged enum whose variant carries nothing: `"Name"` or `{"Name": null}`.
  ## Gives the index into `names`.
  var variant = ""
  case v.kind
  of jvString:
    variant = v.strVal
  of jvObject:
    if v.keys.len != 1:
      return newError[int]("invalid value: map, expected map with a single key")
    if v.vals[0].kind != jvNull:
      return newError[int](invalidType(v.vals[0], "unit variant"))
    variant = v.keys[0]
  else:
    return newError[int](invalidType(v, "string or map"))
  for i in 0 ..< names.len:
    if names[i] == variant:
      return newSuccess(i)
  newError[int](unknownVariant(variant, names))

proc parseI64Exact*(text: string): (bool, int64) =
  ## Rust's `str::parse::<i64>`: optional sign then decimal digits only, and no overflow.
  var i = 0
  var negative = false
  if text.len > 0 and (text[0] == '+' or text[0] == '-'):
    negative = text[0] == '-'
    i = 1
  if i >= text.len:
    return (false, 0'i64)
  var acc = 0'u64
  let limit = if negative: 9223372036854775808'u64 else: 9223372036854775807'u64
  while i < text.len:
    let c = text[i]
    if c < '0' or c > '9':
      return (false, 0'i64)
    let digit = uint64(ord(c) - ord('0'))
    if acc > (limit - digit) div 10'u64:
      return (false, 0'i64)
    acc = acc * 10'u64 + digit
    inc i
  if negative:
    (true, cast[int64](0'u64 - acc))
  else:
    (true, int64(acc))
