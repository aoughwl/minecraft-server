## Port of pumpkin-util/src/text/click.rs

import serform
import ../../nbt/tag
import ../../codecs/json_value

type
  ClickEventKind* = enum
    ceOpenUrl
    ceOpenFile
    ceRunCommand
    ceSuggestCommand
    ceChangePage
    ceCopyToClipboard

  ClickEvent* = object
    ## Action to take on click of the text.
    case kind*: ClickEventKind
    of ceOpenUrl: url*: string
    of ceOpenFile: path*: string
    of ceRunCommand, ceSuggestCommand: command*: string
    of ceChangePage: page*: uint32
    of ceCopyToClipboard: value*: string

proc openUrl*(url: string): ClickEvent = ClickEvent(kind: ceOpenUrl, url: url)
proc openFile*(path: string): ClickEvent = ClickEvent(kind: ceOpenFile, path: path)
proc runCommand*(command: string): ClickEvent = ClickEvent(kind: ceRunCommand, command: command)
proc suggestCommand*(command: string): ClickEvent = ClickEvent(kind: ceSuggestCommand, command: command)
proc changePage*(page: uint32): ClickEvent = ClickEvent(kind: ceChangePage, page: page)
proc copyToClipboard*(value: string): ClickEvent = ClickEvent(kind: ceCopyToClipboard, value: value)

proc `==`*(a, b: ClickEvent): bool =
  if a.kind != b.kind: return false
  case a.kind
  of ceOpenUrl: a.url == b.url
  of ceOpenFile: a.path == b.path
  of ceRunCommand, ceSuggestCommand: a.command == b.command
  of ceChangePage: a.page == b.page
  of ceCopyToClipboard: a.value == b.value

proc toSer*(self: ClickEvent): SerValue =
  ## `#[serde(tag = "action", rename_all = "snake_case")]`: the tag comes first.
  result = serMap()
  case self.kind
  of ceOpenUrl:
    result.entry("action", serString("open_url"))
    result.entry("url", serString(self.url))
  of ceOpenFile:
    result.entry("action", serString("open_file"))
    result.entry("path", serString(self.path))
  of ceRunCommand:
    result.entry("action", serString("run_command"))
    result.entry("command", serString(self.command))
  of ceSuggestCommand:
    result.entry("action", serString("suggest_command"))
    result.entry("command", serString(self.command))
  of ceChangePage:
    result.entry("action", serString("change_page"))
    result.entry("page", serInt(int64(self.page)))
  of ceCopyToClipboard:
    result.entry("action", serString("copy_to_clipboard"))
    result.entry("value", serString(self.value))

proc toJson*(self: ClickEvent): JsonValue = serToJsonValue(toSer(self))
proc toJsonString*(self: ClickEvent): string = serToJsonString(toSer(self))
proc toNbt*(self: ClickEvent): NbtTag = serToNbt(toSer(self))

proc stringField(v: JsonValue, name: string, err: var string): string =
  let i = v.find(name)
  if i < 0:
    err = "missing field `" & name & "`"
    return ""
  if v.vals[i].kind != jvString:
    err = "invalid type for field `" & name & "`, expected a string"
    return ""
  v.vals[i].strVal

proc fromJson*(t: typedesc[ClickEvent], v: JsonValue, lenient = false): TextResult[ClickEvent] =
  if v.kind != jvObject:
    return textErr[ClickEvent]("invalid type: expected internally tagged enum ClickEvent")
  let a = v.find("action")
  if a < 0:
    return textErr[ClickEvent]("missing field `action`")
  if v.vals[a].kind != jvString:
    return textErr[ClickEvent]("invalid type: expected variant identifier")
  let action = v.vals[a].strVal
  var err = ""
  var ev = ClickEvent(kind: ceOpenUrl, url: "")
  case action
  of "open_url":
    ev = openUrl(stringField(v, "url", err))
  of "open_file":
    ev = openFile(stringField(v, "path", err))
  of "run_command":
    ev = runCommand(stringField(v, "command", err))
  of "suggest_command":
    ev = suggestCommand(stringField(v, "command", err))
  of "change_page":
    let i = v.find("page")
    if i < 0:
      err = "missing field `page`"
    else:
      var ok = true
      let page = decodeU32(v.vals[i], lenient, ok)
      if ok: ev = changePage(page)
      else: err = "invalid value for field `page`, expected u32"
  of "copy_to_clipboard":
    ev = copyToClipboard(stringField(v, "value", err))
  else:
    err = "unknown variant `" & action & "`, expected one of `open_url`, `open_file`, `run_command`, `suggest_command`, `change_page`, `copy_to_clipboard`"
  if err.len > 0:
    return textErr[ClickEvent](err)
  textOk(ev)

proc fromNbt*(t: typedesc[ClickEvent], tag: NbtTag): TextResult[ClickEvent] =
  fromJson(ClickEvent, nbtToJsonValue(tag), true)
