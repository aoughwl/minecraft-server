## Known-answer checks for color.aowl and click.aowl. Upstream has no tests for these files.

import std/[syncio, options]
import color, click, serform
import ../../nbt/tag
import ../../codecs/json_value

var failed = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failed

proc eqs(got, want, what: string) =
  if got != want:
    echo "FAILED: " & what & " got [" & got & "] want [" & want & "]"
    inc failed

proc rgb(c: RGBColor, r, g, b: int, what: string) =
  if int(c.red) != r or int(c.green) != g or int(c.blue) != b:
    echo "FAILED: " & what
    inc failed

proc hsv(h: float32, r, g, b: int) =
  let (x, y, z) = hsvToRgb(h, 1.0'f32, 1.0'f32)
  if int(x) != r or int(y) != g or int(z) != b:
    echo "FAILED: hsv " & $h & " got " & $int(x) & "," & $int(y) & "," & $int(z)
    inc failed

# Every name, its RGB and its legacy code, from the table in color.rs.
block:
  rgb(toRgb(ncBlack), 0, 0, 0, "black")
  rgb(toRgb(ncDarkBlue), 0, 0, 170, "dark blue")
  rgb(toRgb(ncDarkGreen), 0, 170, 0, "dark green")
  rgb(toRgb(ncDarkAqua), 0, 170, 170, "dark aqua")
  rgb(toRgb(ncDarkRed), 170, 0, 0, "dark red")
  rgb(toRgb(ncDarkPurple), 170, 0, 170, "dark purple")
  rgb(toRgb(ncGold), 255, 170, 0, "gold")
  rgb(toRgb(ncGray), 170, 170, 170, "gray")
  rgb(toRgb(ncDarkGray), 85, 85, 85, "dark gray")
  rgb(toRgb(ncBlue), 85, 85, 255, "blue")
  rgb(toRgb(ncGreen), 85, 255, 85, "green")
  rgb(toRgb(ncAqua), 85, 255, 255, "aqua")
  rgb(toRgb(ncRed), 255, 85, 85, "red")
  rgb(toRgb(ncLightPurple), 255, 85, 255, "light purple")
  rgb(toRgb(ncYellow), 255, 255, 85, "yellow")
  rgb(toRgb(ncWhite), 255, 255, 255, "white")
  check(ord(ncBlack) == 0 and ord(ncWhite) == 15, "discriminants")

  let codes = "0123456789abcdef"
  let names = ["black", "dark_blue", "dark_green", "dark_aqua", "dark_red", "dark_purple", "gold", "gray",
    "dark_gray", "blue", "green", "aqua", "red", "light_purple", "yellow", "white"]
  for n in ncBlack .. ncWhite:
    let i = ord(n)
    check(toLegacyChar(n) == codes[i], "legacy char " & names[i])
    check(fromLegacyCode(codes[i]).get() == colorNamed(n), "legacy code " & names[i])
    eqs(namedColorName(n), names[i], "name")
    check(namedColorTryFrom(names[i]).get() == n, "try_from " & names[i])
    let r = fromJson(NamedColor, jsonString(names[i]))
    check(r.ok and r.value == n, "NamedColor fromJson " & names[i])
  check(fromLegacyCode('C').get() == colorNamed(ncRed), "upper case code")
  check(fromLegacyCode('g').isNone, "bad code")
  check(namedColorTryFrom("Red").isNone, "try_from is case-sensitive")
  check(not fromJson(NamedColor, jsonString("nope")).ok, "NamedColor bad")

block:
  check(fromHexStr("fc0000").get() == colorRgb(newRGBColor(0xFC'u8, 0'u8, 0'u8)), "hex")
  check(fromHexStr("FFaa01").get() == colorRgb(newRGBColor(255'u8, 170'u8, 1'u8)), "mixed case")
  check(fromHexStr("+f+f+f").get() == colorRgb(newRGBColor(15'u8, 15'u8, 15'u8)), "from_str_radix takes a plus")
  check(fromHexStr("").isNone, "empty")
  check(fromHexStr("fff").isNone, "short")
  check(fromHexStr("fffffff").isNone, "long")
  check(fromHexStr("ggffff").isNone, "bad red")
  check(fromHexStr("ffggff").isNone, "bad green")
  check(fromHexStr("ffffgg").isNone, "bad blue")
  check(fromHexStr("-fffff").isNone, "minus")
  check(fromHexStr("\xC2\xA7ffff").isNone, "non-ASCII")

block:
  hsv(0.0'f32, 255, 0, 0)
  hsv(30.0'f32, 255, 127, 0)
  hsv(60.0'f32, 255, 255, 0)
  hsv(120.0'f32, 0, 255, 0)
  hsv(180.0'f32, 0, 255, 255)
  hsv(240.0'f32, 0, 0, 255)
  hsv(300.0'f32, 255, 0, 255)
  hsv(360.0'f32, 255, 0, 0)
  let (r, g, b) = hsvToRgb(0.0'f32, 0.5'f32, 0.5'f32)
  check(int(r) == 127 and int(g) == 63 and int(b) == 63, "saturation and value")
  check(int(saturatingU8(300.0'f32)) == 255, "as u8 high")
  check(int(saturatingU8(-1.0'f32)) == 0, "as u8 low")
  let nan = 0.0'f32 / 0.0'f32
  check(int(saturatingU8(nan)) == 0, "as u8 nan")

# Serialized forms.
block:
  eqs(toJsonString(toJson(newRGBColor(0'u8, 0x0F'u8, 0xFF'u8))), "\"#000FFF\"", "rgb")
  eqs(toJsonString(toJson(newARGBColor(255'u8, 1'u8, 2'u8, 3'u8))), "[255,1,2,3]", "argb")
  eqs(toJsonString(toJson(ncDarkAqua)), "\"dark_aqua\"", "named")
  eqs(toJsonString(toJson(colorNamed(ncGold))), "\"gold\"", "color named")
  eqs(toJsonString(toJson(colorRgb(newRGBColor(1'u8, 2'u8, 3'u8)))), "\"#010203\"", "color rgb")
  eqs(toJsonString(toJson(colorReset())), "null", "color reset")

  let reset = fromJson(Color, jsonString("reset"))
  check(reset.ok and reset.value == colorReset(), "reset parses")
  let v = fromJson(RGBColor, parseJsonValue("""{"red":1,"green":2,"blue":3}""").value)
  check(v.ok and v.value == newRGBColor(1'u8, 2'u8, 3'u8), "RGBColor derive, map")
  let s = fromJson(RGBColor, parseJsonValue("[1,2,3]").value)
  check(s.ok and s.value == newRGBColor(1'u8, 2'u8, 3'u8), "RGBColor derive, seq")
  check(not fromJson(RGBColor, jsonString("#010203")).ok, "RGBColor derive takes no string")
  check(not fromJson(ARGBColor, parseJsonValue("[-1,2,3,4]").value).ok, "strict u8")
  let lenient = fromJson(ARGBColor, parseJsonValue("[-1,2,3,4]").value, true)
  check(lenient.ok and lenient.value == newARGBColor(255'u8, 2'u8, 3'u8, 4'u8), "lenient u8")

# ClickEvent on its own.
block:
  eqs(toJsonString(openUrl("u")), """{"action":"open_url","url":"u"}""", "open_url")
  eqs(toJsonString(openFile("p")), """{"action":"open_file","path":"p"}""", "open_file")
  eqs(toJsonString(runCommand("c")), """{"action":"run_command","command":"c"}""", "run_command")
  eqs(toJsonString(suggestCommand("c")), """{"action":"suggest_command","command":"c"}""", "suggest_command")
  eqs(toJsonString(changePage(3'u32)), """{"action":"change_page","page":3}""", "change_page")
  eqs(toJsonString(copyToClipboard("v")), """{"action":"copy_to_clipboard","value":"v"}""", "copy_to_clipboard")
  eqs($toJson(openUrl("u")), """{"action":"open_url","url":"u"}""", "to_value")
  let t = toNbt(changePage(0x80000000'u32))
  let back = fromNbt(ClickEvent, t)
  check(t.compoundVal.values[1].intVal == int32.low, "u32 wraps into the int tag")
  check(back.ok and back.value == changePage(0x80000000'u32), "and wraps back")
  check(not (runCommand("c") == suggestCommand("c")), "kinds differ")

# colored's layout.
block:
  setColorOverride(true)
  eqs(consoleColor(colorNamed(ncBlack), "x"), "\x1B[30mx\x1B[0m", "black")
  eqs(consoleColor(colorNamed(ncDarkBlue), "x"), "\x1B[34mx\x1B[0m", "dark blue is blue")
  eqs(consoleColor(colorNamed(ncDarkGreen), "x"), "\x1B[32mx\x1B[0m", "dark green is green")
  eqs(consoleColor(colorNamed(ncDarkAqua), "x"), "\x1B[36mx\x1B[0m", "dark aqua is cyan")
  eqs(consoleColor(colorNamed(ncDarkRed), "x"), "\x1B[31mx\x1B[0m", "dark red is red")
  eqs(consoleColor(colorNamed(ncDarkPurple), "x"), "\x1B[35mx\x1B[0m", "dark purple is purple")
  eqs(consoleColor(colorNamed(ncGold), "x"), "\x1B[33mx\x1B[0m", "gold is yellow")
  eqs(consoleColor(colorNamed(ncGray), "x"), "\x1B[90mx\x1B[0m", "gray is bright black")
  eqs(consoleColor(colorNamed(ncDarkGray), "x"), "\x1B[90mx\x1B[0m", "dark gray is bright black")
  eqs(consoleColor(colorNamed(ncBlue), "x"), "\x1B[94mx\x1B[0m", "blue")
  eqs(consoleColor(colorNamed(ncGreen), "x"), "\x1B[92mx\x1B[0m", "green")
  eqs(consoleColor(colorNamed(ncAqua), "x"), "\x1B[96mx\x1B[0m", "aqua")
  eqs(consoleColor(colorNamed(ncRed), "x"), "\x1B[91mx\x1B[0m", "red")
  eqs(consoleColor(colorNamed(ncLightPurple), "x"), "\x1B[95mx\x1B[0m", "light purple")
  eqs(consoleColor(colorNamed(ncYellow), "x"), "\x1B[93mx\x1B[0m", "yellow")
  eqs(consoleColor(colorNamed(ncWhite), "x"), "\x1B[37mx\x1B[0m", "white")
  eqs(consoleColor(colorReset(), "x"), "x", "reset")
  eqs(coloredString("a\x1B[0mb", "1"), "\x1B[1ma\x1B[0m\x1B[1mb\x1B[0m", "inner reset re-arms")
  setColorOverride(false)
  eqs(consoleColor(colorNamed(ncRed), "x"), "x", "off")
  unsetColorOverride()

if failed > 0:
  echo $failed & " failed"
  quit(1)
echo "colortest ok"
