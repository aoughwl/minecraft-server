## Port of pumpkin-util/src/text/legacy.rs

import std/unicode
import text

export text

proc charString(c: char): string =
  result = ""
  result.add c

proc splitOn(input, symbol: string): seq[string] =
  ## `str::split(char)`.
  result = @[]
  var cur = ""
  var i = 0
  while i < input.len:
    var hit = i + symbol.len <= input.len
    if hit:
      for j in 0 ..< symbol.len:
        if input[i + j] != symbol[j]:
          hit = false
          break
    if hit:
      result.add cur
      cur = ""
      i += symbol.len
    else:
      cur.add input[i]
      inc i
  result.add cur

proc firstCharLen(s: string): int =
  let c = ord(s[0])
  let n = if c >= 0xF0: 4 elif c >= 0xE0: 3 elif c >= 0xC0: 2 else: 1
  min(n, s.len)

proc firstCodePoint(s: string, n: int): uint32 =
  case n
  of 1: uint32(ord(s[0]))
  of 2: (uint32(ord(s[0])) and 0x1F'u32) shl 6 or (uint32(ord(s[1])) and 0x3F'u32)
  of 3: (uint32(ord(s[0])) and 0x0F'u32) shl 12 or (uint32(ord(s[1])) and 0x3F'u32) shl 6 or (uint32(ord(s[2])) and 0x3F'u32)
  else: (uint32(ord(s[0])) and 0x07'u32) shl 18 or (uint32(ord(s[1])) and 0x3F'u32) shl 12 or (uint32(ord(s[2])) and 0x3F'u32) shl 6 or (uint32(ord(s[3])) and 0x3F'u32)

proc tailOf(s: string, start: int): string =
  result = ""
  for i in start ..< s.len: result.add s[i]

proc toAsciiLower(c: char): char =
  if c >= 'A' and c <= 'Z': char(ord(c) + 32) else: c

type
  LegacyState = object
    currentColor: Option[Color]
    bold, italic, underlined, strikethrough, obfuscated: bool

proc styledChild(state: LegacyState, plain: string): TextComponent =
  result = text(plain)
  if state.currentColor.isSome: result = color(result, state.currentColor.get())
  if state.bold: result = bold(result)
  if state.italic: result = italic(result)
  if state.underlined: result = underlined(result)
  if state.strikethrough: result = strikethrough(result)
  if state.obfuscated: result = obfuscated(result)

proc clearStyles(state: var LegacyState) =
  state.bold = false
  state.italic = false
  state.underlined = false
  state.strikethrough = false
  state.obfuscated = false

proc fromLegacyStringWithCode*(input, codeSymbol: string): TextComponent =
  ## Parses a legacy formatted string using a custom code symbol such as `&`.
  ## Colors 0-9 a-f, styles l o n m k, reset r, RGB as x then six symbol-prefixed hex digits.
  var root = text("")
  let parts = splitOn(input, codeSymbol)
  if parts[0].len > 0:
    root = addChild(root, text(parts[0]))

  var state = LegacyState(currentColor: none[Color]())
  var next = 1
  while next < parts.len:
    let part = parts[next]
    inc next
    if part.len == 0:
      continue

    let n = firstCharLen(part)
    let code = if n == 1: toAsciiLower(part[0]) else: '\0'
    let remainder = tailOf(part, n)

    if code == 'x':
      var hex = ""
      var validHex = true
      var trailingRemainder = ""
      for _ in 0 ..< 6:
        if next >= parts.len:
          validHex = false
          break
        let nextPart = parts[next]
        inc next
        if nextPart.len == 0:
          validHex = false
          break
        let m = firstCharLen(nextPart)
        # `c as u8` keeps the low byte of the code point.
        hex.add char(firstCodePoint(nextPart, m) and 0xFF'u32)
        trailingRemainder.add tailOf(nextPart, m)
      # When `str::from_utf8` fails the color is left as it was; `from_hex_str` refuses the rest.
      if validHex and validateUtf8(hex) == -1:
        state.currentColor = fromHexStr(hex)
      if remainder.len > 0 or trailingRemainder.len > 0:
        root = addChild(root, styledChild(state, remainder & trailingRemainder))
      continue

    case code
    of '0'..'9', 'a'..'f':
      state.currentColor = fromLegacyCode(code)
      clearStyles(state)
    of 'l': state.bold = true
    of 'o': state.italic = true
    of 'n': state.underlined = true
    of 'm': state.strikethrough = true
    of 'k': state.obfuscated = true
    of 'r':
      state.currentColor = none[Color]()
      clearStyles(state)
    else: discard

    if remainder.len > 0:
      root = addChild(root, styledChild(state, remainder))
  root

proc fromLegacyStringWithCode*(input: string, codeSymbol: char): TextComponent =
  fromLegacyStringWithCode(input, charString(codeSymbol))

proc fromLegacyString*(input: string): TextComponent =
  ## Parses a legacy string using section signs.
  fromLegacyStringWithCode(input, "§")

proc toLegacyStringWithCode*(self: TextComponent, codeSymbol: string, locale: Locale): string =
  ## A legacy formatted string with color and style codes using `codeSymbol`.
  result = ""
  let style = self.base.style
  if style.color.isSome:
    let c = style.color.get()
    case c.kind
    of ckNamed:
      result.add codeSymbol
      result.add toLegacyChar(c.named)
    of ckRgb:
      const LowerHex = "0123456789abcdef"
      result.add codeSymbol
      result.add 'x'
      for b in [c.rgb.red, c.rgb.green, c.rgb.blue]:
        result.add codeSymbol
        result.add LowerHex[int(b shr 4)]
        result.add codeSymbol
        result.add LowerHex[int(b and 15'u8)]
    of ckReset:
      result.add codeSymbol
      result.add 'r'

  if style.bold == some(true):
    result.add codeSymbol
    result.add 'l'
  if style.italic == some(true):
    result.add codeSymbol
    result.add 'o'
  if style.underlined == some(true):
    result.add codeSymbol
    result.add 'n'
  if style.strikethrough == some(true):
    result.add codeSymbol
    result.add 'm'
  if style.obfuscated == some(true):
    result.add codeSymbol
    result.add 'k'

  let content = self.base.content
  case content.kind
  of tcText:
    result.add content.text
  of tcTranslate:
    result.add getTranslationText("minecraft:" & content.translate, locale, content.translateWith)
  of tcEntityNames:
    result.add content.selector
  of tcKeybind:
    result.add content.keybind
  of tcCustom:
    result.add getTranslationText(content.key, locale, content.customWith)

  for child in self.base.extra:
    result.add toLegacyStringWithCode(TextComponent(base: child), codeSymbol, locale)
    result.add codeSymbol
    result.add 'r'

proc toLegacyStringWithCode*(self: TextComponent, codeSymbol: char, locale: Locale): string =
  toLegacyStringWithCode(self, charString(codeSymbol), locale)

proc toLegacyString*(self: TextComponent, locale: Locale): string =
  ## A Java legacy formatted string using `§`.
  toLegacyStringWithCode(self, "§", locale)
