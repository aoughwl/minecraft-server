## Known-answer checks for legacy.aowl: upstream's three tests in legacy.rs, plus hand-worked cases.

import std/[syncio, options]
import legacy

var failed = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failed

proc eqs(got, want, what: string) =
  if got != want:
    echo "FAILED: " & what & " got [" & got & "] want [" & want & "]"
    inc failed

# upstream: from_legacy_string_hex
block:
  let comp = fromLegacyString("§x§f§c§0§0§0§0Test String ▽")
  check(comp.base.extra.len == 1, "hex extra len")
  check(comp.base.extra[0].content.kind == tcText, "hex kind")
  eqs(comp.base.extra[0].content.text, "Test String ▽", "hex text")
  check(comp.base.extra[0].style.color.get() == fromHexStr("fc0000").get(), "hex color")

# upstream: from_legacy_string_alt_code
block:
  let comp = fromLegacyStringWithCode("&cRed &lBold", '&')
  check(comp.base.extra.len == 2, "alt extra len")
  check(comp.base.extra[0].style.color.get() == colorNamed(ncRed), "alt color")
  check(comp.base.extra[1].style.bold.get() == true, "alt bold")
  # A color keeps going after a style code.
  check(comp.base.extra[1].style.color.get() == colorNamed(ncRed), "alt color carries")
  eqs(comp.base.extra[0].content.text, "Red ", "alt text 0")
  eqs(comp.base.extra[1].content.text, "Bold", "alt text 1")

# upstream: to_legacy_string
block:
  let comp = addChild(text("Hello "), bold(colorNamed(text("World"), ncRed)))
  eqs(toLegacyString(comp, lcEnUs), "Hello §c§lWorld§r", "to_legacy_string")

# leading text, reset, a color clears styles, unknown codes vanish, upper case codes
block:
  let comp = fromLegacyString("pre§lA§cB§rC§zD§AE")
  eqs(comp.base.content.text, "", "root stays empty")
  check(comp.base.extra.len == 6, "mixed len")
  eqs(comp.base.extra[0].content.text, "pre", "leading")
  check(comp.base.extra[0].style == Style(), "leading has no style")
  check(comp.base.extra[1].style.bold.get(), "A bold")
  check(comp.base.extra[2].style.bold.isNone, "color clears bold")
  check(comp.base.extra[2].style.color.get() == colorNamed(ncRed), "B red")
  check(comp.base.extra[3].style.color.isNone, "reset clears color")
  eqs(comp.base.extra[4].content.text, "D", "unknown code dropped")
  check(comp.base.extra[5].style.color.get() == colorNamed(ncGreen), "upper case code")

# empty parts are skipped, and a lone trailing symbol produces nothing
block:
  let comp = fromLegacyString("§§§cX§")
  check(comp.base.extra.len == 1, "empties")
  eqs(comp.base.extra[0].content.text, "X", "empties text")

# RGB: text directly after x comes before what trails the digits, styles survive the x
block:
  let comp = fromLegacyStringWithCode("&ldrop&xA&1&2&3&4&5&6B", "&")
  check(comp.base.extra.len == 2, "x len")
  eqs(comp.base.extra[0].content.text, "drop", "x before")
  eqs(comp.base.extra[1].content.text, "AB", "x remainder then trailing")
  check(comp.base.extra[1].style.color.get() == colorRgb(newRGBColor(0x12'u8, 0x34'u8, 0x56'u8)), "x color")
  check(comp.base.extra[1].style.bold.get(), "x keeps bold")

# RGB: too few digit parts leave the color alone and keep the collected text
block:
  let comp = fromLegacyStringWithCode("&cR&x&1a&2b", "&")
  check(comp.base.extra.len == 2, "short x len")
  eqs(comp.base.extra[1].content.text, "ab", "short x text")
  check(comp.base.extra[1].style.color.get() == colorNamed(ncRed), "short x keeps color")

# RGB: valid ASCII that is not hex clears the color (from_hex_str gives None)
block:
  let comp = fromLegacyStringWithCode("&cR&x&z&z&z&z&z&zT", "&")
  check(comp.base.extra[1].style.color.isNone, "bad hex clears color")

# to_legacy with RGB, reset color and every style
block:
  let c = shadowColor(obfuscated(strikethrough(underlined(italic(bold(colorRgb(text("x"), newRGBColor(0xAB'u8, 0x01'u8, 0xFF'u8))))))),
    newARGBColor(1'u8, 2'u8, 3'u8, 4'u8))
  eqs(toLegacyStringWithCode(c, '&', lcEnUs), "&x&a&b&0&1&f&f&l&o&n&m&kx", "rgb and styles")
  eqs(toLegacyString(color(text("y"), colorReset()), lcEnUs), "§ry", "reset color")
  # Some(false) is not `== Some(true)`.
  var f = text("z")
  f.base.style.bold = some(false)
  eqs(toLegacyString(f, lcEnUs), "z", "explicit false")

if failed > 0:
  echo $failed & " failed"
  quit(1)
echo "legacytest ok"
