const LocaleCount* = ord(high(Locale)) + 1

proc localeFromStr*(s: string): Locale =
  ## `Locale::from_str`, which is case-insensitive and falls back to English (US) instead of failing.
  case toLower(s)
  of "af_za": lcAfZa  # Afrikaans (Suid-Afrika)
  of "ar_sa": lcArSa  # Arabic
  of "ast_es": lcAstEs  # Asturian
  of "az_az": lcAzAz  # Azerbaijani
  of "ba_ru": lcBaRu  # Bashkir
  of "bar": lcBar  # Bavarian
  of "be_by": lcBeBy  # Belarusian
  of "bg_bg": lcBgBg  # Bulgarian
  of "br_fr": lcBrFr  # Breton
  of "brb": lcBrb  # Brabantian
  of "bs_ba": lcBsBa  # Bosnian
  of "ca_es": lcCaEs  # Catalan
  of "cs_cz": lcCsCz  # Czech
  of "cy_gb": lcCyGb  # Welsh
  of "da_dk": lcDaDk  # Danish
  of "de_at": lcDeAt  # Austrian German
  of "de_ch": lcDeCh  # Swiss German
  of "de_de": lcDeDe  # German
  of "el_gr": lcElGr  # Greek
  of "en_au": lcEnAu  # Australian English
  of "en_ca": lcEnCa  # Canadian English
  of "en_gb": lcEnGb  # British English
  of "en_nz": lcEnNz  # New Zealand English
  of "en_pt": lcEnPt  # Pirate English
  of "en_ud": lcEnUd  # Upside down British English
  of "enp": lcEnp  # Modern English minus borrowed words
  of "enws": lcEnws  # Early Modern English
  of "eo_uy": lcEoUy  # Esperanto
  of "es_ar": lcEsAr  # Argentinian Spanish
  of "es_cl": lcEsCl  # Chilean Spanish
  of "es_ec": lcEsEc  # Ecuadorian Spanish
