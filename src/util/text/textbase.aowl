## Port of pumpkin-util/src/text/style.rs
## Port of pumpkin-util/src/text/hover.rs
## Also the type half of pumpkin-util/src/text/mod.rs (`TextComponent`, `TextComponentBase`, `TextContent`)
## and their serde forms. These types are mutually recursive through `HoverEvent`, so they share one type
## section and one module; the rest of mod.rs is in text.aowl, which re-exports this file.
##
## Serde attributes honoured: `TextComponentBase` flattens content and style, then `extra` (omitted when
## empty). `Style` has no rename_all, so its keys are `click_event`, `hover_event` and `shadow_color`.
## `TextContent` is untagged and tried in declaration order. `bedrock_translate` is never serialized.

{.feature: "untyped".}

import std/options
import color, click, locale, serform
import ../../nbt/[nbtbase, serializer, tag]
import ../../codecs/json_value

export options, color, click, locale, serform

type
  Style* = object
    ## The styling options for a text component.
    color*: Option[Color]
    bold*: Option[bool]
    italic*: Option[bool]
    underlined*: Option[bool]
    strikethrough*: Option[bool]
    obfuscated*: Option[bool]
    insertion*: Option[string]
    clickEvent*: Option[ClickEvent]
    hoverEvent*: Option[HoverEvent]
    font*: Option[string]
    shadowColor*: Option[ARGBColor]

  HoverEventKind* = enum
    heShowText
    heShowItem
    heShowEntity

  HoverEvent* = object
    case kind*: HoverEventKind
    of heShowText:
      value*: seq[TextComponentBase]
    of heShowItem:
      itemId*: string
      count*: Option[int32]
    of heShowEntity:
      entityId*: string
      uuid*: string
      name*: Option[seq[TextComponentBase]]

  TextContentKind* = enum
    tcText
    tcTranslate
    tcEntityNames
    tcKeybind
    tcCustom

  TextContent* = object
    case kind*: TextContentKind
    of tcText:
      text*: string
    of tcTranslate:
      translate*: string
      bedrockTranslate*: Option[string]
      translateWith*: seq[TextComponentBase]
    of tcEntityNames:
      selector*: string
      separator*: Option[string]
    of tcKeybind:
      keybind*: string
    of tcCustom:
      key*: string
      locale*: Locale
      customWith*: seq[TextComponentBase]

  TextComponentBase* = object
    content*: TextContent
    style*: Style
    extra*: seq[TextComponentBase]

  TextComponent* = object
    ## Upstream's newtype `TextComponent(pub TextComponentBase)`; `.base` is its `.0`.
    base*: TextComponentBase

proc textContent*(text: string): TextContent {.inline.} =
  TextContent(kind: tcText, text: text)

proc baseOf*(content: TextContent): TextComponentBase =
  TextComponentBase(content: content, style: Style(), extra: @[])

proc textBase*(text: string): TextComponentBase =
  ## `TextComponentBase { content: Text { text }, style: default, extra: [] }`.
  baseOf(textContent(text))

# --- equality (derive(PartialEq)) ----------------------------------------------------------------

proc eqOpt[T](a, b: Option[T]): bool =
  if a.isSome != b.isSome: return false
  if a.isNone: return true
  a.get() == b.get()

proc eqBases(a, b: seq[TextComponentBase]): bool =
  if a.len != b.len: return false
  for i in 0 ..< a.len:
    if not (a[i] == b[i]): return false
  true

proc `==`*(a, b: HoverEvent): bool =
  if a.kind != b.kind: return false
  case a.kind
  of heShowText:
    eqBases(a.value, b.value)
  of heShowItem:
    a.itemId == b.itemId and eqOpt(a.count, b.count)
  of heShowEntity:
    if a.entityId != b.entityId or a.uuid != b.uuid or a.name.isSome != b.name.isSome: return false
    a.name.isNone or eqBases(a.name.get(), b.name.get())

proc `==`*(a, b: Style): bool =
  if a.hoverEvent.isSome != b.hoverEvent.isSome: return false
  if a.hoverEvent.isSome and not (a.hoverEvent.get() == b.hoverEvent.get()): return false
  eqOpt(a.color, b.color) and eqOpt(a.bold, b.bold) and eqOpt(a.italic, b.italic) and
    eqOpt(a.underlined, b.underlined) and eqOpt(a.strikethrough, b.strikethrough) and
    eqOpt(a.obfuscated, b.obfuscated) and eqOpt(a.insertion, b.insertion) and
    eqOpt(a.clickEvent, b.clickEvent) and eqOpt(a.font, b.font) and eqOpt(a.shadowColor, b.shadowColor)

proc `==`*(a, b: TextContent): bool =
  if a.kind != b.kind: return false
  case a.kind
  of tcText: a.text == b.text
  of tcTranslate:
    a.translate == b.translate and eqOpt(a.bedrockTranslate, b.bedrockTranslate) and
      eqBases(a.translateWith, b.translateWith)
  of tcEntityNames: a.selector == b.selector and eqOpt(a.separator, b.separator)
  of tcKeybind: a.keybind == b.keybind
  of tcCustom: a.key == b.key and a.locale == b.locale and eqBases(a.customWith, b.customWith)

proc `==`*(a, b: TextComponentBase): bool =
  a.content == b.content and a.style == b.style and eqBases(a.extra, b.extra)

proc `==`*(a, b: TextComponent): bool = a.base == b.base

# --- impl Style ----------------------------------------------------------------------------------

proc color*(self: Style, color: Color): Style =
  result = self
  result.color = some(color)

proc colorNamed*(self: Style, color: NamedColor): Style =
  result = self
  result.color = some(colorNamed(color))

proc bold*(self: Style): Style =
  result = self
  result.bold = some(true)

proc italic*(self: Style): Style =
  result = self
  result.italic = some(true)

proc underlined*(self: Style): Style =
  result = self
  result.underlined = some(true)

proc strikethrough*(self: Style): Style =
  result = self
  result.strikethrough = some(true)

proc obfuscated*(self: Style): Style =
  result = self
  result.obfuscated = some(true)

proc insertion*(self: Style, text: string): Style =
  result = self
  result.insertion = some(text)

proc clickEvent*(self: Style, event: ClickEvent): Style =
  result = self
  result.clickEvent = some(event)

proc hoverEvent*(self: Style, event: HoverEvent): Style =
  result = self
  result.hoverEvent = some(event)

proc font*(self: Style, resourceLocation: string): Style =
  result = self
  result.font = some(resourceLocation)

proc shadowColor*(self: Style, color: ARGBColor): Style =
  result = self
  result.shadowColor = some(color)

# --- impl HoverEvent -----------------------------------------------------------------------------

proc showText*(text: TextComponent): HoverEvent =
  HoverEvent(kind: heShowText, value: @[text.base])

proc showEntity*(uuid, kind: string, name: Option[TextComponent]): HoverEvent =
  if name.isSome:
    HoverEvent(kind: heShowEntity, entityId: kind, uuid: uuid, name: some(@[name.get().base]))
  else:
    HoverEvent(kind: heShowEntity, entityId: kind, uuid: uuid, name: none[seq[TextComponentBase]]())

proc showEntity*(uuid, kind: string): HoverEvent =
  showEntity(uuid, kind, none[TextComponent]())

proc showItem*(id: string, count: Option[int32]): HoverEvent =
  HoverEvent(kind: heShowItem, itemId: id, count: count)

proc showItem*(id: string): HoverEvent =
  showItem(id, none[int32]())

# --- Serialize -----------------------------------------------------------------------------------

proc basesToSer(bases: seq[TextComponentBase], err: var string): SerValue =
  var items: seq[SerValue] = @[]
  for b in bases: items.add toSer(b, err)
  serList(items)

proc toSer*(self: HoverEvent, err: var string): SerValue =
  result = serMap()
  case self.kind
  of heShowText:
    result.entry("action", serString("show_text"))
    result.entry("value", basesToSer(self.value, err))
  of heShowItem:
    result.entry("action", serString("show_item"))
    result.entry("id", serString(self.itemId))
    if self.count.isSome:
      result.entry("count", serInt(int64(self.count.get())))
  of heShowEntity:
    result.entry("action", serString("show_entity"))
    result.entry("id", serString(self.entityId))
    result.entry("uuid", serString(self.uuid))
    if self.name.isSome:
      result.entry("name", basesToSer(self.name.get(), err))

proc addStyle(m: var SerValue, s: Style, err: var string) =
  if s.color.isSome: m.entry("color", toSer(s.color.get()))
  if s.bold.isSome: m.entry("bold", serBool(s.bold.get()))
  if s.italic.isSome: m.entry("italic", serBool(s.italic.get()))
  if s.underlined.isSome: m.entry("underlined", serBool(s.underlined.get()))
  if s.strikethrough.isSome: m.entry("strikethrough", serBool(s.strikethrough.get()))
  if s.obfuscated.isSome: m.entry("obfuscated", serBool(s.obfuscated.get()))
  if s.insertion.isSome: m.entry("insertion", serString(s.insertion.get()))
  if s.clickEvent.isSome: m.entry("click_event", toSer(s.clickEvent.get()))
  if s.hoverEvent.isSome: m.entry("hover_event", toSer(s.hoverEvent.get(), err))
  if s.font.isSome: m.entry("font", serString(s.font.get()))
  if s.shadowColor.isSome: m.entry("shadow_color", toSer(s.shadowColor.get()))

proc addContent(m: var SerValue, c: TextContent, err: var string) =
  case c.kind
  of tcText:
    m.entry("text", serString(c.text))
  of tcTranslate:
    m.entry("translate", serString(c.translate))
    if c.translateWith.len > 0:
      m.entry("with", basesToSer(c.translateWith, err))
  of tcEntityNames:
    m.entry("selector", serString(c.selector))
    if c.separator.isSome:
      m.entry("separator", serString(c.separator.get()))
  of tcKeybind:
    m.entry("keybind", serString(c.keybind))
  of tcCustom:
    # `#[serde(skip)]`: reachable only when a caller skips `toTranslated`.
    if err.len == 0:
      err = "the enum variant TextContent::Custom cannot be serialized"

proc toSer*(self: TextComponentBase, err: var string): SerValue =
  ## `err` stays empty unless a `TextContent::Custom` is left in the tree.
  result = serMap()
  addContent(result, self.content, err)
  addStyle(result, self.style, err)
  if self.extra.len > 0:
    result.entry("extra", basesToSer(self.extra, err))

proc toSer*(self: Style, err: var string): SerValue =
  result = serMap()
  addStyle(result, self, err)

proc toJson*(self: TextComponentBase): TextResult[JsonValue] =
  ## `serde_json::to_value`: sorted keys. Does not translate; see `toJson(TextComponent)`.
  var err = ""
  let s = toSer(self, err)
  if err.len > 0: return textErr[JsonValue](err)
  textOk(serToJsonValue(s))

proc toJsonString*(self: TextComponentBase): TextResult[string] =
  ## `serde_json::to_string`: declaration order. Does not translate.
  var err = ""
  let s = toSer(self, err)
  if err.len > 0: return textErr[string](err)
  textOk(serToJsonString(s))

proc toNbt*(self: TextComponentBase): TextResult[NbtTag] =
  ## The compound upstream's `Serializer` writes. Does not translate.
  var err = ""
  let s = toSer(self, err)
  if err.len > 0: return textErr[NbtTag](err)
  textOk(serToNbt(s))

proc toBytesUnnamed*(self: TextComponentBase): TextResult[seq[byte]] =
  ## `pumpkin_nbt::serializer::to_bytes_unnamed`: network NBT, no root name.
  let tagRes = toNbt(self)
  if not tagRes.ok: return textErr[seq[byte]](tagRes.error)
  var writer = newNbtWriter(nwmJava)
  let res = serialize(tagRes.value, writer)
  if not res.isOk: return textErr[seq[byte]](res.error.msg)
  textOk(writer.buf)

proc toJson*(self: HoverEvent): TextResult[JsonValue] =
  var err = ""
  let s = toSer(self, err)
  if err.len > 0: return textErr[JsonValue](err)
  textOk(serToJsonValue(s))

proc toJson*(self: Style): TextResult[JsonValue] =
  var err = ""
  let s = toSer(self, err)
  if err.len > 0: return textErr[JsonValue](err)
  textOk(serToJsonValue(s))

# --- Deserialize ---------------------------------------------------------------------------------

proc decodeBases(v: JsonValue, lenient: bool, err: var string): seq[TextComponentBase] =
  result = @[]
  if v.kind != jvArray:
    err = "invalid type: expected a sequence"
    return
  for it in v.items:
    result.add decodeBase(it, lenient, err)
    if err.len > 0: return

proc decodeHover(v: JsonValue, lenient: bool, err: var string): HoverEvent =
  result = HoverEvent(kind: heShowText, value: @[])
  if v.kind != jvObject:
    err = "invalid type: expected internally tagged enum HoverEvent"
    return
  let a = v.find("action")
  if a < 0:
    err = "missing field `action`"
    return
  if v.vals[a].kind != jvString:
    err = "invalid type: expected variant identifier"
    return
  let action = v.vals[a].strVal
  case action
  of "show_text":
    let i = v.find("value")
    if i < 0:
      err = "missing field `value`"
      return
    result = HoverEvent(kind: heShowText, value: decodeBases(v.vals[i], lenient, err))
  of "show_item":
    let i = v.find("id")
    if i < 0:
      err = "missing field `id`"
      return
    if v.vals[i].kind != jvString:
      err = "invalid type for field `id`, expected a string"
      return
    var count = none[int32]()
    let c = v.find("count")
    if c >= 0 and v.vals[c].kind != jvNull:
      var ok = true
      let n = decodeI32(v.vals[c], ok)
      if not ok:
        err = "invalid value for field `count`, expected i32"
        return
      count = some(n)
    result = HoverEvent(kind: heShowItem, itemId: v.vals[i].strVal, count: count)
  of "show_entity":
    let i = v.find("id")
    if i < 0:
      err = "missing field `id`"
      return
    if v.vals[i].kind != jvString:
      err = "invalid type for field `id`, expected a string"
      return
    let u = v.find("uuid")
    if u < 0:
      err = "missing field `uuid`"
      return
    if v.vals[u].kind != jvString:
      err = "invalid type for field `uuid`, expected a string"
      return
    var name = none[seq[TextComponentBase]]()
    let n = v.find("name")
    if n >= 0 and v.vals[n].kind != jvNull:
      name = some(decodeBases(v.vals[n], lenient, err))
      if err.len > 0: return
    result = HoverEvent(kind: heShowEntity, entityId: v.vals[i].strVal, uuid: v.vals[u].strVal, name: name)
  else:
    err = "unknown variant `" & action & "`, expected one of `show_text`, `show_item`, `show_entity`"

proc decodeOptBool(v: JsonValue, key: string, lenient: bool, err: var string): Option[bool] =
  result = none[bool]()
  let i = v.find(key)
  if i >= 0 and v.vals[i].kind != jvNull:
    var ok = true
    let b = decodeBool(v.vals[i], lenient, ok)
    if ok: result = some(b)
    elif err.len == 0: err = "invalid type for field `" & key & "`, expected a boolean"

proc decodeOptString(v: JsonValue, key: string, err: var string): Option[string] =
  result = none[string]()
  let i = v.find(key)
  if i >= 0 and v.vals[i].kind != jvNull:
    if v.vals[i].kind == jvString: result = some(v.vals[i].strVal)
    elif err.len == 0: err = "invalid type for field `" & key & "`, expected a string"

proc decodeStyle(v: JsonValue, lenient: bool, err: var string): Style =
  ## Runs over the flattened map, so keys it does not know are ignored.
  result = Style()
  let c = v.find("color")
  if c >= 0 and v.vals[c].kind != jvNull:
    let r = fromJson(Color, v.vals[c])
    if r.ok: result.color = some(r.value)
    elif err.len == 0: err = r.error
  result.bold = decodeOptBool(v, "bold", lenient, err)
  result.italic = decodeOptBool(v, "italic", lenient, err)
  result.underlined = decodeOptBool(v, "underlined", lenient, err)
  result.strikethrough = decodeOptBool(v, "strikethrough", lenient, err)
  result.obfuscated = decodeOptBool(v, "obfuscated", lenient, err)
  result.insertion = decodeOptString(v, "insertion", err)
  let ce = v.find("click_event")
  if ce >= 0 and v.vals[ce].kind != jvNull:
    let r = fromJson(ClickEvent, v.vals[ce], lenient)
    if r.ok: result.clickEvent = some(r.value)
    elif err.len == 0: err = r.error
  let he = v.find("hover_event")
  if he >= 0 and v.vals[he].kind != jvNull:
    let h = decodeHover(v.vals[he], lenient, err)
    if err.len == 0: result.hoverEvent = some(h)
  result.font = decodeOptString(v, "font", err)
  let sc = v.find("shadow_color")
  if sc >= 0 and v.vals[sc].kind != jvNull:
    let r = fromJson(ARGBColor, v.vals[sc], lenient)
    if r.ok: result.shadowColor = some(r.value)
    elif err.len == 0: err = r.error

proc decodeContent(v: JsonValue, lenient: bool, err: var string): TextContent =
  ## `#[serde(untagged)]`: variants in declaration order; a variant whose fields do not fit falls
  ## through to the next one instead of failing. `Custom` is `#[serde(skip)]`.
  let t = v.find("text")
  if t >= 0 and v.vals[t].kind == jvString:
    return textContent(v.vals[t].strVal)
  let tr = v.find("translate")
  if tr >= 0 and v.vals[tr].kind == jvString:
    var attempt = ""
    var args: seq[TextComponentBase] = @[]
    let w = v.find("with")
    if w >= 0: args = decodeBases(v.vals[w], lenient, attempt)
    if attempt.len == 0:
      return TextContent(kind: tcTranslate, translate: v.vals[tr].strVal,
        bedrockTranslate: none[string](), translateWith: args)
  let s = v.find("selector")
  if s >= 0 and v.vals[s].kind == jvString:
    let sep = v.find("separator")
    if sep < 0 or v.vals[sep].kind == jvNull:
      return TextContent(kind: tcEntityNames, selector: v.vals[s].strVal, separator: none[string]())
    if v.vals[sep].kind == jvString:
      return TextContent(kind: tcEntityNames, selector: v.vals[s].strVal, separator: some(v.vals[sep].strVal))
  let k = v.find("keybind")
  if k >= 0 and v.vals[k].kind == jvString:
    return TextContent(kind: tcKeybind, keybind: v.vals[k].strVal)
  err = "data did not match any variant of untagged enum TextContent"
  textContent("")

proc decodeBase(v: JsonValue, lenient: bool, err: var string): TextComponentBase =
  ## A derived struct with flatten: a map only, never a string or a sequence.
  result = textBase("")
  if v.kind != jvObject:
    if err.len == 0: err = "invalid type: expected a map"
    return
  let e = v.find("extra")
  if e >= 0:
    result.extra = decodeBases(v.vals[e], lenient, err)
    if err.len > 0: return
  result.content = decodeContent(v, lenient, err)
  if err.len > 0: return
  result.style = decodeStyle(v, lenient, err)

proc decodeComponent(v: JsonValue, lenient: bool, err: var string): TextComponentBase =
  ## `TextComponentVisitor`: a string, a sequence of components, or a map.
  case v.kind
  of jvString:
    result = textBase(v.strVal)
  of jvArray:
    result = textBase("")
    for it in v.items:
      result.extra.add decodeComponent(it, lenient, err)
      if err.len > 0: return
  of jvObject:
    result = decodeBase(v, lenient, err)
  else:
    result = textBase("")
    if err.len == 0: err = "invalid type: expected a TextComponentBase or a sequence of TextComponentBase"

proc fromJson*(t: typedesc[TextComponentBase], v: JsonValue): TextResult[TextComponentBase] =
  var err = ""
  let b = decodeBase(v, false, err)
  if err.len > 0: return textErr[TextComponentBase](err)
  textOk(b)

proc fromJson*(t: typedesc[TextComponent], v: JsonValue): TextResult[TextComponent] =
  var err = ""
  let b = decodeComponent(v, false, err)
  if err.len > 0: return textErr[TextComponent](err)
  textOk(TextComponent(base: b))

proc fromJsonString*(t: typedesc[TextComponent], text: string): TextResult[TextComponent] =
  ## `serde_json::from_str::<TextComponent>`.
  let parsed = parseJsonValue(text)
  if not parsed.ok: return textErr[TextComponent](parsed.error)
  fromJson(TextComponent, parsed.value)

proc fromJson*(t: typedesc[Style], v: JsonValue): TextResult[Style] =
  var err = ""
  if v.kind != jvObject: return textErr[Style]("invalid type: expected a map")
  let s = decodeStyle(v, false, err)
  if err.len > 0: return textErr[Style](err)
  textOk(s)

proc fromJson*(t: typedesc[HoverEvent], v: JsonValue): TextResult[HoverEvent] =
  var err = ""
  let h = decodeHover(v, false, err)
  if err.len > 0: return textErr[HoverEvent](err)
  textOk(h)

proc fromJson*(t: typedesc[TextContent], v: JsonValue): TextResult[TextContent] =
  var err = ""
  if v.kind != jvObject: return textErr[TextContent]("data did not match any variant of untagged enum TextContent")
  let c = decodeContent(v, false, err)
  if err.len > 0: return textErr[TextContent](err)
  textOk(c)

proc fromNbt*(t: typedesc[TextComponent], tag: NbtTag): TextResult[TextComponent] =
  ## NBT accepts what the JSON decoder accepts, plus a byte for a bool and a signed byte for a u8.
  ## Upstream's `Deserialize` cannot read a bool or a color from NBT at all (the flatten buffer hands
  ## `deserialize_bool` an i8 and `<&str>` an owned string), and no upstream caller decodes one;
  ## this direction reads what `toNbt` writes rather than copying that failure.
  var err = ""
  let b = decodeComponent(nbtToJsonValue(tag), true, err)
  if err.len > 0: return textErr[TextComponent](err)
  textOk(TextComponent(base: b))
