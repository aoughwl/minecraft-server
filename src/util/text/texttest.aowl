## Known-answer checks for text.aowl and textbase.aowl: upstream's NBT vector from text/mod.rs, plus exact
## bytes and exact JSON worked out by hand from the serde attributes and pumpkin-nbt's Serializer.

import std/syncio
import text
import ../../nbt/[serializer, tag]
import ../../codecs/json_value

var failed = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failed

proc eqs(got, want, what: string) =
  if got != want:
    echo "FAILED: " & what
    echo "  got  " & got
    echo "  want " & want
    inc failed

const Hex = "0123456789ABCDEF"

proc `&`(x, y: seq[byte]): seq[byte] =
  result = x
  for b in y: result.add b

proc showBytes(b: seq[byte]): string =
  result = ""
  for x in b:
    result.add Hex[int(x shr 4)]
    result.add Hex[int(x and 15'u8)]
    result.add ' '

proc hx(s: string): seq[byte] =
  ## Hex digits, spaces ignored.
  result = @[]
  var hi = -1
  for c in s:
    if c == ' ': continue
    let d = if c >= '0' and c <= '9': ord(c) - ord('0') else: ord(c) - ord('A') + 10
    if hi < 0:
      hi = d
    else:
      result.add byte(hi * 16 + d)
      hi = -1

proc a(s: string): seq[byte] =
  ## The bytes of an ASCII string, written with a u16 length in front.
  result = @[byte(s.len shr 8), byte(s.len and 255)]
  for c in s: result.add byte(ord(c))

proc eqb(got, want: seq[byte], what: string) =
  if got != want:
    echo "FAILED: " & what
    echo "  got  " & showBytes(got)
    echo "  want " & showBytes(want)
    inc failed

proc roundTrip(input, want: string) =
  ## Parses and prints back through the declaration-order form.
  let r = fromJsonString(TextComponent, input)
  if not r.ok:
    echo "FAILED: parse " & input & ": " & r.error
    inc failed
  else:
    eqs(toJsonString(r.value), want, "round trip " & input)

proc refuses(input, wantError: string) =
  let r = fromJsonString(TextComponent, input)
  if r.ok:
    echo "FAILED: should not parse: " & input
    inc failed
  else:
    eqs(r.error, wantError, "error for " & input)

# --- NBT: upstream's serialize_text_component ------------------------------------------------------

block:
  let msg = colorNamed(translate("multiplayer.player.joined", [text("NAME")]), ncYellow)
  let want = @[
    0x0A'u8, 0x08, 0x00, 0x09, 0x74, 0x72, 0x61, 0x6E, 0x73, 0x6C, 0x61, 0x74, 0x65, 0x00,
    0x19, 0x6D, 0x75, 0x6C, 0x74, 0x69, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x2E, 0x70,
    0x6C, 0x61, 0x79, 0x65, 0x72, 0x2E, 0x6A, 0x6F, 0x69, 0x6E, 0x65, 0x64, 0x09, 0x00,
    0x04, 0x77, 0x69, 0x74, 0x68, 0x0A, 0x00, 0x00, 0x00, 0x01, 0x08, 0x00, 0x04, 0x74,
    0x65, 0x78, 0x74, 0x00, 0x04, 0x4E, 0x41, 0x4D, 0x45, 0x00, 0x08, 0x00, 0x05, 0x63,
    0x6F, 0x6C, 0x6F, 0x72, 0x00, 0x06, 0x79, 0x65, 0x6C, 0x6C, 0x6F, 0x77, 0x00]
  let bytes = toBytesUnnamed(msg.base)
  check(bytes.ok, "upstream vector serializes")
  eqb(bytes.value, want, "upstream vector")
  eqb(encode(msg), want, "encode of upstream vector")
  eqs(toJsonString(msg), """{"translate":"multiplayer.player.joined","with":[{"text":"NAME"}],"color":"yellow"}""", "upstream vector JSON")

# --- NBT: exact bytes of each tag shape ------------------------------------------------------------

proc str(name, value: string): seq[byte] =
  hx("08") & a(name) & a(value)

proc txt(value: string): seq[byte] =
  str("text", value)

block:
  eqb(encode(text("hi")), hx("0A") & txt("hi") & hx("00"), "plain")
  eqb(encode(empty()), hx("0A") & txt("") & hx("00"), "empty")
  # A bool is a byte, and an explicit false is written.
  var f = bold(text("x"))
  f.base.style.italic = some(false)
  eqb(encode(f), hx("0A") & txt("x") & hx("01") & a("bold") & hx("01") & hx("01") & a("italic") & hx("00") & hx("00"), "bools")
  # Reset is a unit: neither its id nor its name is written.
  eqb(encode(color(text("x"), colorReset())), hx("0A") & txt("x") & hx("00"), "reset color")
  # RGB is upper-case hex.
  eqb(encode(colorRgb(text("x"), newRGBColor(0x0A'u8, 0xBC'u8, 0x0C'u8))),
    hx("0A") & txt("x") & str("color", "#0ABC0C") & hx("00"), "rgb")
  # shadow_color is a byte LIST (id 9 of id 1), not a byte array (id 7).
  eqb(encode(shadowColor(text("x"), newARGBColor(0xFF'u8, 1'u8, 2'u8, 3'u8))),
    hx("0A") & txt("x") & hx("09") & a("shadow_color") & hx("01 00000004 FF 01 02 03") & hx("00"), "shadow")
  # extra is a list of compounds after the style.
  eqb(encode(addChild(colorNamed(text("p"), ncRed), text("c"))),
    hx("0A") & txt("p") & str("color", "red") & hx("09") & a("extra") & hx("0A 00000001") & txt("c") & hx("00") & hx("00"), "extra")
  # Empty extra and with are omitted.
  eqb(encode(translate("k")), hx("0A") & str("translate", "k") & hx("00"), "translate without args")
  # Modified UTF-8: a supplementary character is a surrogate pair of 3-byte forms, NUL is C0 80.
  eqb(encode(text("\xF0\x9F\x98\x80")), hx("0A 08") & a("text") & hx("0006 ED A0 BD ED B8 80 00"), "cesu8")
  eqb(encode(text("\x00")), hx("0A 08") & a("text") & hx("0002 C0 80 00"), "nul")

# Other content kinds.
block:
  eqb(encode(fromContent(TextContent(kind: tcKeybind, keybind: "key.jump"))),
    hx("0A") & str("keybind", "key.jump") & hx("00"), "keybind")
  eqb(encode(fromContent(TextContent(kind: tcEntityNames, selector: "@e", separator: none[string]()))),
    hx("0A") & str("selector", "@e") & hx("00"), "selector")
  eqb(encode(fromContent(TextContent(kind: tcEntityNames, selector: "@e", separator: some(", ")))),
    hx("0A") & str("selector", "@e") & str("separator", ", ") & hx("00"), "selector separator")
  # bedrock_translate is `#[serde(skip)]`.
  eqb(encode(translateCross("j", "b")), hx("0A") & str("translate", "j") & hx("00"), "bedrock key not written")

# Click events: a nested compound, the tag first.
block:
  proc ce(e: ClickEvent, body: seq[byte]): seq[byte] =
    hx("0A") & txt("x") & hx("0A") & a("click_event") & body & hx("00") & hx("00")
  eqb(encode(clickEvent(text("x"), openUrl("u"))), ce(openUrl("u"), str("action", "open_url") & str("url", "u")), "open_url")
  eqb(encode(clickEvent(text("x"), openFile("f"))), ce(openFile("f"), str("action", "open_file") & str("path", "f")), "open_file")
  eqb(encode(clickEvent(text("x"), runCommand("/c"))), ce(runCommand("/c"), str("action", "run_command") & str("command", "/c")), "run_command")
  eqb(encode(clickEvent(text("x"), suggestCommand("/c"))), ce(suggestCommand("/c"), str("action", "suggest_command") & str("command", "/c")), "suggest_command")
  eqb(encode(clickEvent(text("x"), copyToClipboard("v"))), ce(copyToClipboard("v"), str("action", "copy_to_clipboard") & str("value", "v")), "copy_to_clipboard")
  # u32 is written through `as i32`.
  eqb(encode(clickEvent(text("x"), changePage(5'u32))), ce(changePage(5'u32), str("action", "change_page") & hx("03") & a("page") & hx("00000005")), "change_page")
  eqb(encode(clickEvent(text("x"), changePage(0xFFFFFFFF'u32))), ce(changePage(0xFFFFFFFF'u32), str("action", "change_page") & hx("03") & a("page") & hx("FFFFFFFF")), "change_page wraps")

# Hover events.
block:
  proc he(body: seq[byte]): seq[byte] =
    hx("0A") & txt("x") & hx("0A") & a("hover_event") & body & hx("00") & hx("00")
  eqb(encode(hoverEvent(text("x"), showText(text("h")))),
    he(str("action", "show_text") & hx("09") & a("value") & hx("0A 00000001") & txt("h") & hx("00")), "show_text")
  eqb(encode(hoverEvent(text("x"), showItem("minecraft:stone"))),
    he(str("action", "show_item") & str("id", "minecraft:stone")), "show_item")
  eqb(encode(hoverEvent(text("x"), showItem("i", some(3'i32)))),
    he(str("action", "show_item") & str("id", "i") & hx("03") & a("count") & hx("00000003")), "show_item count")
  eqb(encode(hoverEvent(text("x"), showEntity("uu", "minecraft:pig"))),
    he(str("action", "show_entity") & str("id", "minecraft:pig") & str("uuid", "uu")), "show_entity")
  eqb(encode(hoverEvent(text("x"), showEntity("uu", "minecraft:pig", some(text("n"))))),
    he(str("action", "show_entity") & str("id", "minecraft:pig") & str("uuid", "uu") & hx("09") & a("name") & hx("0A 00000001") & txt("n") & hx("00")), "show_entity name")

# Everything at once: the field order is the Style declaration.
block:
  let c = shadowColor(font(hoverEvent(clickEvent(insertion(obfuscated(strikethrough(underlined(italic(bold(colorNamed(text("t"), ncGold)))))),
    "ins"), runCommand("/r")), showText(text("h"))), "minecraft:alt"), newARGBColor(1'u8, 2'u8, 3'u8, 4'u8))
  let want = hx("0A") & txt("t") & str("color", "gold") &
    hx("01") & a("bold") & hx("01") & hx("01") & a("italic") & hx("01") & hx("01") & a("underlined") & hx("01") &
    hx("01") & a("strikethrough") & hx("01") & hx("01") & a("obfuscated") & hx("01") & str("insertion", "ins") &
    hx("0A") & a("click_event") & str("action", "run_command") & str("command", "/r") & hx("00") &
    hx("0A") & a("hover_event") & str("action", "show_text") & hx("09") & a("value") & hx("0A 00000001") & txt("h") & hx("00") & hx("00") &
    str("font", "minecraft:alt") & hx("09") & a("shadow_color") & hx("01 00000004 01 02 03 04") & hx("00")
  eqb(encode(c), want, "all fields NBT")
  eqs(toJsonString(c), """{"text":"t","color":"gold","bold":true,"italic":true,"underlined":true,"strikethrough":true,"obfuscated":true,"insertion":"ins","click_event":{"action":"run_command","command":"/r"},"hover_event":{"action":"show_text","value":[{"text":"h"}]},"font":"minecraft:alt","shadow_color":[1,2,3,4]}""", "all fields JSON")
  eqs($toJson(c), """{"bold":true,"click_event":{"action":"run_command","command":"/r"},"color":"gold","font":"minecraft:alt","hover_event":{"action":"show_text","value":[{"text":"h"}]},"insertion":"ins","italic":true,"obfuscated":true,"shadow_color":[1,2,3,4],"strikethrough":true,"text":"t","underlined":true}""", "all fields to_value is sorted")
  # And back.
  let back = fromJsonString(TextComponent, toJsonString(c))
  check(back.ok, "all fields parse")
  check(back.value == c, "all fields round trip")
  # toNbt is what encode writes, and fromNbt reads it (bytes as bools, signed bytes as u8).
  var w = newNbtWriter(nwmJava)
  check(serialize(toNbt(c), w).isOk, "toNbt writes")
  eqb(w.buf, want, "toNbt matches encode")
  let fromTag = fromNbt(TextComponent, toNbt(c))
  check(fromTag.ok, "fromNbt ok")
  check(fromTag.value == c, "fromNbt round trip")

# fromNbt: a byte above 127 in shadow_color comes back unsigned.
block:
  let c = shadowColor(text("x"), newARGBColor(0xFF'u8, 0x80'u8, 2'u8, 3'u8))
  let r = fromNbt(TextComponent, toNbt(c))
  check(r.ok and r.value == c, "fromNbt high bytes")

# Custom never reaches a serializer: the base form refuses, the component form resolves it first.
block:
  addTranslation("mod", "greet", "Hello %s and %s!", lcEnUs)
  addTranslation("mod", "tail", "Hi %s", lcEnUs)
  addTranslation("mod", "swap", "%2$s then %1$s", lcEnUs)
  addTranslation("mod", "plain", "Plain", lcEnUs)
  addTranslation("mod", "pct", "100% of %s", lcEnUs)
  addTranslation("mod", "de", "Hallo", lcDeDe)
  let g = custom("MOD", "GREET", lcEnUs, [text("a"), text("b")])
  eqs(g.base.content.key, "mod:greet", "custom lowercases")
  let raw = toJsonString(g.base)
  check(not raw.ok, "base JSON refuses Custom")
  if not raw.ok:
    eqs(raw.error, "the enum variant TextContent::Custom cannot be serialized", "Custom message")
  check(not toBytesUnnamed(g.base).ok, "base NBT refuses Custom")
  eqs(toJsonString(g), """{"text":"Hello ","extra":[{"text":"a"},{"text":" and "},{"text":"b"},{"text":"!"}]}""", "custom slices")
  eqs(toJsonString(custom("mod", "tail", lcEnUs, [text("a")])), """{"text":"Hi ","extra":[{"text":"a"}]}""", "placeholder last")
  eqs(toJsonString(custom("mod", "swap", lcEnUs, [text("a"), text("b")])), """{"text":"","extra":[{"text":"b"},{"text":" then "},{"text":"a"}]}""", "positional")
  eqs(toJsonString(custom("mod", "plain", lcEnUs)), """{"text":"Plain"}""", "no placeholder")
  eqs(toJsonString(custom("mod", "de", lcDeDe)), """{"text":"Hallo"}""", "locale")
  eqs(toJsonString(custom("mod", "unknown.key", lcEnUs)), """{"text":"mod:unknown.key"}""", "missing key shows the key")
  # style and existing extra survive, after the slices; nested Custom everywhere resolves.
  let styled = addChild(bold(custom("mod", "tail", lcEnUs, [text("a")])), custom("mod", "plain", lcEnUs))
  eqs(toJsonString(styled), """{"text":"Hi ","bold":true,"extra":[{"text":"a"},{"text":"Plain"}]}""", "extra after slices")
  let inHover = hoverEvent(text("x"), showText(custom("mod", "plain", lcEnUs)))
  eqs(toJsonString(inHover), """{"text":"x","hover_event":{"action":"show_text","value":[{"text":"Plain"}]}}""", "hover resolves")
  let inEntity = hoverEvent(text("x"), showEntity("u", "k", some(custom("mod", "plain", lcEnUs))))
  eqs(toJsonString(inEntity), """{"text":"x","hover_event":{"action":"show_entity","id":"k","uuid":"u","name":[{"text":"Plain"}]}}""", "entity name resolves")
  let inWith = translate("k", [custom("mod", "plain", lcEnUs)])
  eqs(toJsonString(inWith), """{"translate":"k","with":[{"text":"Plain"}]}""", "with resolves")
  # A Translate stays for the client.
  eqs(toJsonString(translate("mod:greet", [text("a")])), """{"translate":"mod:greet","with":[{"text":"a"}]}""", "translate untouched")
  # Fewer substitutions than placeholders: Rust panics, this leaves the slot empty.
  eqs(toJsonString(custom("mod", "greet", lcEnUs, [text("a")])), """{"text":"Hello ","extra":[{"text":"a"},{"text":" and "},{"text":""},{"text":"!"}]}""", "missing substitution")

# --- JSON forms ------------------------------------------------------------------------------------

block:
  eqs(toJsonString(text("a\"b\n")), "{\"text\":\"a\\\"b\\n\"}", "escapes")
  # Reset is `null` in JSON.
  eqs(toJsonString(color(text("x"), colorReset())), """{"text":"x","color":null}""", "reset JSON")
  eqs(toJsonString(colorRgb(text("x"), newRGBColor(1'u8, 2'u8, 255'u8))), """{"text":"x","color":"#0102FF"}""", "rgb JSON")
  eqs(toJsonString(clickEvent(text("x"), changePage(0xFFFFFFFF'u32))), """{"text":"x","click_event":{"action":"change_page","page":4294967295}}""", "u32 in JSON stays unsigned")
  eqs(toJsonString(hoverEvent(text("x"), showItem("i", some(3'i32)))), """{"text":"x","hover_event":{"action":"show_item","id":"i","count":3}}""", "show_item JSON")
  eqs(toJsonString(fromContent(TextContent(kind: tcEntityNames, selector: "@e", separator: some(",")))), """{"selector":"@e","separator":","}""", "selector JSON")
  eqs(toJsonString(fromContent(TextContent(kind: tcKeybind, keybind: "key.jump"))), """{"keybind":"key.jump"}""", "keybind JSON")
  eqs(toJsonString(translateCross("j", "b", [text("x")])), """{"translate":"j","with":[{"text":"x"}]}""", "bedrock key not in JSON")
  eqs(toJsonString(wrapInSquareBrackets(text("x"))), """{"translate":"chat.square_brackets","with":[{"text":"x"}]}""", "brackets")
  eqs(toJsonString(newLine(text("x"))), "{\"text\":\"x\",\"extra\":[{\"text\":\"\\n\"}]}", "new line")
  eqs(toJsonString(addText(text("x"), "y")), """{"text":"x","extra":[{"text":"y"}]}""", "add text")
  eqs(toJsonString(joinWithComma([text("a"), text("b")])), """{"text":"","extra":[{"text":"a"},{"text":", ","color":"gray"},{"text":"b"}]}""", "join comma")
  eqs(toJsonString(join([text("a"), text("b"), text("c")], text("-"))), """{"text":"","extra":[{"text":"a"},{"text":"-"},{"text":"b"},{"text":"-"},{"text":"c"}]}""", "join")
  var none0: seq[TextComponent] = @[]
  eqs(toJsonString(joinWithComma(none0)), """{"text":""}""", "join nothing")
  # Replacement order: `&` first, so `&` in the name or message survives.
  eqs(getText(chatDecorated("&c{DISPLAYNAME}: {MESSAGE}", "B&b", "x&y")), "§cB&b: x&y", "chat decorated")

# Style builders.
block:
  let s = shadowColor(font(hoverEvent(clickEvent(insertion(obfuscated(strikethrough(underlined(italic(bold(color(Style(), colorNamed(ncRed))))))),
    "i"), openUrl("u")), showText(text("t"))), "f"), newARGBColor(9'u8, 8'u8, 7'u8, 6'u8))
  var err = ""
  eqs(serToJsonString(toSer(s, err)), """{"color":"red","bold":true,"italic":true,"underlined":true,"strikethrough":true,"obfuscated":true,"insertion":"i","click_event":{"action":"open_url","url":"u"},"hover_event":{"action":"show_text","value":[{"text":"t"}]},"font":"f","shadow_color":[9,8,7,6]}""", "style builders")
  check(colorNamed(Style(), ncAqua).color.get() == colorNamed(ncAqua), "style colorNamed")

# --- Deserialize -----------------------------------------------------------------------------------

block:
  roundTrip("\"hi\"", """{"text":"hi"}""")
  roundTrip("""["a",{"text":"b"},["c"]]""", """{"text":"","extra":[{"text":"a"},{"text":"b"},{"text":"","extra":[{"text":"c"}]}]}""")
  roundTrip("""{"text":"a"}""", """{"text":"a"}""")
  # Order in the input does not matter, unknown keys are ignored.
  roundTrip("""{"zzz":1,"color":"red","text":"a"}""", """{"text":"a","color":"red"}""")
  # Untagged: first variant that fits. `text` beats `translate`, a bad `text` falls through.
  roundTrip("""{"translate":"k","text":"a"}""", """{"text":"a"}""")
  roundTrip("""{"text":1,"translate":"k"}""", """{"translate":"k"}""")
  roundTrip("""{"translate":"k","with":[{"text":"x"}],"color":"#FF0000","bold":true}""", """{"translate":"k","with":[{"text":"x"}],"color":"#FF0000","bold":true}""")
  roundTrip("""{"selector":"@a"}""", """{"selector":"@a"}""")
  roundTrip("""{"selector":"@a","separator":"/"}""", """{"selector":"@a","separator":"/"}""")
  roundTrip("""{"selector":"@a","separator":null}""", """{"selector":"@a"}""")
  roundTrip("""{"keybind":"key.jump"}""", """{"keybind":"key.jump"}""")
  # Bad `with` fails Translate but a later variant may still fit.
  roundTrip("""{"translate":"k","with":["x"],"keybind":"z"}""", """{"keybind":"z"}""")
  # `default` Options: null is None.
  roundTrip("""{"text":"a","bold":null,"color":null,"click_event":null,"hover_event":null,"shadow_color":null}""", """{"text":"a"}""")
  roundTrip("""{"text":"a","bold":false}""", """{"text":"a","bold":false}""")
  roundTrip("""{"text":"a","color":"reset"}""", """{"text":"a","color":null}""")
  roundTrip("""{"text":"a","color":"#abcDEF"}""", """{"text":"a","color":"#ABCDEF"}""")
  roundTrip("""{"text":"a","color":"#+f+f+f"}""", """{"text":"a","color":"#0F0F0F"}""")
  roundTrip("""{"text":"a","extra":[]}""", """{"text":"a"}""")
  roundTrip("""{"text":"a","shadow_color":[255,1,2,3]}""", """{"text":"a","shadow_color":[255,1,2,3]}""")
  roundTrip("""{"text":"a","shadow_color":{"alpha":1,"red":2,"green":3,"blue":4}}""", """{"text":"a","shadow_color":[1,2,3,4]}""")
  roundTrip("""{"text":"a","click_event":{"url":"u","action":"open_url"}}""", """{"text":"a","click_event":{"action":"open_url","url":"u"}}""")
  roundTrip("""{"text":"a","click_event":{"action":"change_page","page":7}}""", """{"text":"a","click_event":{"action":"change_page","page":7}}""")
  roundTrip("""{"text":"a","hover_event":{"action":"show_entity","uuid":"u","id":"k"}}""", """{"text":"a","hover_event":{"action":"show_entity","id":"k","uuid":"u"}}""")
  roundTrip("""{"text":"a","hover_event":{"action":"show_item","id":"i","count":null}}""", """{"text":"a","hover_event":{"action":"show_item","id":"i"}}""")

  const NoVariant = "data did not match any variant of untagged enum TextContent"
  refuses("1", "invalid type: expected a TextComponentBase or a sequence of TextComponentBase")
  refuses("null", "invalid type: expected a TextComponentBase or a sequence of TextComponentBase")
  refuses("{}", NoVariant)
  refuses("""{"color":"red"}""", NoVariant)
  refuses("""{"translate":"k","with":["x"]}""", NoVariant)
  refuses("""{"selector":"@a","separator":1}""", NoVariant)
  refuses("""{"text":"a","extra":["b"]}""", "invalid type: expected a map")
  refuses("""{"text":"a","extra":null}""", "invalid type: expected a sequence")
  refuses("""{"text":"a","color":"nope"}""", "Invalid named color")
  refuses("""{"text":"a","color":1}""", "invalid type: expected a borrowed string")
  refuses("""{"text":"a","color":"#FFF"}""", "Hex color must be in the format '#RRGGBB'")
  refuses("""{"text":"a","color":"#GG0000"}""", "Invalid red component in hex color")
  refuses("""{"text":"a","color":"#00GG00"}""", "Invalid green component in hex color")
  refuses("""{"text":"a","color":"#0000GG"}""", "Invalid blue component in hex color")
  refuses("""{"text":"a","bold":1}""", "invalid type for field `bold`, expected a boolean")
  refuses("""{"text":"a","font":1}""", "invalid type for field `font`, expected a string")
  refuses("""{"text":"a","click_event":{}}""", "missing field `action`")
  refuses("""{"text":"a","click_event":{"action":"nope"}}""", "unknown variant `nope`, expected one of `open_url`, `open_file`, `run_command`, `suggest_command`, `change_page`, `copy_to_clipboard`")
  refuses("""{"text":"a","click_event":{"action":"open_url"}}""", "missing field `url`")
  refuses("""{"text":"a","click_event":{"action":"change_page","page":-1}}""", "invalid value for field `page`, expected u32")
  refuses("""{"text":"a","click_event":{"action":"change_page","page":4294967296}}""", "invalid value for field `page`, expected u32")
  refuses("""{"text":"a","hover_event":{"action":"nope"}}""", "unknown variant `nope`, expected one of `show_text`, `show_item`, `show_entity`")
  refuses("""{"text":"a","hover_event":{"action":"show_text"}}""", "missing field `value`")
  refuses("""{"text":"a","hover_event":{"action":"show_text","value":"x"}}""", "invalid type: expected a sequence")
  refuses("""{"text":"a","hover_event":{"action":"show_entity","id":"k"}}""", "missing field `uuid`")
  refuses("""{"text":"a","hover_event":{"action":"show_item","id":"i","count":1.5}}""", "invalid value for field `count`, expected i32")
  refuses("""{"text":"a","shadow_color":[1,2,3]}""", "invalid length 3, expected 4 elements")
  refuses("""{"text":"a","shadow_color":[1,2,3,4,5]}""", "invalid length 5, expected 4 elements")
  refuses("""{"text":"a","shadow_color":[1,2,3,256]}""", "invalid value, expected u8")
  refuses("""{"text":"a","shadow_color":{"alpha":1}}""", "missing field `red`")

# --- gradient, rainbow -----------------------------------------------------------------------------

proc rgbOf(b: TextComponentBase): RGBColor =
  b.style.color.get().rgb

proc rgbEq(c: RGBColor, r, g, b: int, what: string) =
  if int(c.red) != r or int(c.green) != g or int(c.blue) != b:
    echo "FAILED: " & what & " got " & $int(c.red) & "," & $int(c.green) & "," & $int(c.blue)
    inc failed

block:
  # 127.5 truncates. The last position lands on the end color.
  let g = gradient(bold(text("abc")), [newRGBColor(0'u8, 0'u8, 0'u8), newRGBColor(255'u8, 255'u8, 255'u8)])
  eqs(g.base.content.text, "", "gradient empties the content")
  check(g.base.extra.len == 3, "gradient chars")
  eqs(g.base.extra[1].content.text, "b", "gradient char")
  check(g.base.extra[1].style.bold.get(), "gradient keeps the style")
  rgbEq(rgbOf(g.base.extra[0]), 0, 0, 0, "gradient 0")
  rgbEq(rgbOf(g.base.extra[1]), 127, 127, 127, "gradient 1")
  rgbEq(rgbOf(g.base.extra[2]), 255, 255, 255, "gradient 2")
  # Three colors over five characters; downwards lerp too.
  let three = gradient(text("abcde"), [newRGBColor(255'u8, 0'u8, 0'u8), newRGBColor(0'u8, 255'u8, 0'u8), newRGBColor(0'u8, 0'u8, 255'u8)])
  rgbEq(rgbOf(three.base.extra[1]), 127, 127, 0, "three 1")
  rgbEq(rgbOf(three.base.extra[2]), 0, 255, 0, "three 2")
  rgbEq(rgbOf(three.base.extra[3]), 0, 127, 127, "three 3")
  rgbEq(rgbOf(three.base.extra[4]), 0, 0, 255, "three 4")
  # Named, one character (colors[0]), fewer than two colors, empty text.
  let named = gradientNamed(text("x"), [ncRed, ncBlue])
  rgbEq(rgbOf(named.base.extra[0]), 255, 85, 85, "gradient single char")
  var oneColor = @[newRGBColor(1'u8, 1'u8, 1'u8)]
  check(gradient(text("abc"), oneColor) == text("abc"), "one color unchanged")
  check(gradient(text(""), [newRGBColor(0'u8, 0'u8, 0'u8), newRGBColor(1'u8, 1'u8, 1'u8)]) == text(""), "empty unchanged")
  # Characters, not bytes; the child's text counts.
  let wide = gradient(addChild(text("§"), text("▽")), [newRGBColor(0'u8, 0'u8, 0'u8), newRGBColor(255'u8, 255'u8, 255'u8)])
  check(wide.base.extra.len == 2, "multibyte chars")
  eqs(wide.base.extra[1].content.text, "▽", "multibyte char")

  let r = rainbow(text("ab"))
  rgbEq(rgbOf(r.base.extra[0]), 255, 0, 0, "rainbow 0")
  rgbEq(rgbOf(r.base.extra[1]), 0, 255, 255, "rainbow 1")

# --- text forms ------------------------------------------------------------------------------------

block:
  let t = addChild(colorNamed(text("a"), ncRed), translate("multiplayer.player.joined", [text("Bob")]))
  eqs(getText(t), "aBob joined the game", "getText")
  eqs(getText(fromContent(TextContent(kind: tcKeybind, keybind: "key.jump"))), "key.jump", "keybind text")
  eqs(getText(fromContent(TextContent(kind: tcEntityNames, selector: "@e", separator: none[string]()))), "@e", "selector text")
  eqs(getText(custom("mod", "tail", lcEnUs, [text("a")])), "Hi a", "custom text")

  eqs(toBedrockString(addChild(translateCross("j", "b.key"), text("x")).base), "%b.keyx", "bedrock string")
  eqs(toBedrockString(translate("j").base), "%j", "bedrock string java key")
  eqs(toBedrockString(custom("mod", "tail", lcEnUs).base), "%mod:tail", "bedrock string custom")
  eqs(toBedrockLegacy(addChild(underlined(italic(bold(colorNamed(text("a"), ncRed)))), obfuscated(text("b"))).base, lcEnUs), "§c§l§o§na§kb§r", "bedrock legacy")
  eqs(toBedrockLegacy(strikethrough(colorRgb(text("a"), newRGBColor(1'u8, 2'u8, 3'u8))).base, lcEnUs), "a", "bedrock legacy drops rgb and strike")
  eqs(toBedrockLegacy(color(text("a"), colorReset()).base, lcEnUs), "§ra", "bedrock legacy reset")

# Console output, with colors forced on.
block:
  setColorOverride(true)
  eqs(toPrettyConsole(colorNamed(text("x"), ncRed)), "\x1B[91mx\x1B[0m", "console red")
  eqs(toPrettyConsole(colorRgb(text("x"), newRGBColor(1'u8, 2'u8, 3'u8))), "\x1B[38;2;1;2;3mx\x1B[0m", "console rgb")
  eqs(toPrettyConsole(color(text("x"), colorReset())), "x", "console reset")
  eqs(toPrettyConsole(bold(colorNamed(text("x"), ncRed))), "\x1B[1m\x1B[91mx\x1B[0m\x1B[1m\x1B[0m", "console bold re-arms after the inner reset")
  eqs(toPrettyConsole(underlined(italic(text("x")))), "[4m[3mx[0m[4m[0m", "console styles nest")
  # An explicit false still styles upstream: `is_some`.
  var f = text("x")
  f.base.style.bold = some(false)
  eqs(toPrettyConsole(f), "\x1B[1mx\x1B[0m", "console is_some")
  setColorOverride(false)
  eqs(toPrettyConsole(strikethrough(colorNamed(bold(text("x")), ncRed))), "x", "console colors off")
  eqs(toPrettyConsole(clickEvent(text("x"), openUrl("http://a"))), "\x1B]8;;http://a\x1B\\x\x1B]8;;\x1B\\", "osc8 url")
  eqs(toPrettyConsole(clickEvent(text("x"), openFile("/a"))), "\x1B]8;;file:///a\x1B\\x\x1B]8;;\x1B\\", "osc8 file")
  eqs(toPrettyConsole(clickEvent(text("x"), runCommand("/a"))), "x", "no link for run_command")
  eqs(toPrettyConsole(addChild(text("a"), text("b"))), "ab", "console children")
  eqs(toPrettyConsole(translate("multiplayer.player.joined", [text("Bob")])), "Bob joined the game", "console translate")
  unsetColorOverride()

# Equality covers every kind.
block:
  check(text("a") == text("a"), "eq")
  check(not (text("a") == text("b")), "ne content")
  check(not (text("a") == bold(text("a"))), "ne style")
  check(not (text("a") == addText(text("a"), "b")), "ne extra")
  check(hoverEvent(text("a"), showText(text("b"))) == hoverEvent(text("a"), showText(text("b"))), "eq hover")
  check(not (hoverEvent(text("a"), showText(text("b"))) == hoverEvent(text("a"), showText(text("c")))), "ne hover")
  check(not (translateCross("a", "b") == translate("a")), "ne bedrock key")

if failed > 0:
  echo $failed & " failed"
  quit(1)
echo "texttest ok"
