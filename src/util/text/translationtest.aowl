## Known-answer checks for ../translation.aowl and locale.aowl. The table sizes and asset lengths were worked
## out separately from the assets in the pinned tree. Upstream has no tests for this file.

import std/syncio
import ../translation
import ../../generated/translations

var failed = 0

proc check(cond: bool, what: string) =
  if not cond:
    echo "FAILED: " & what
    inc failed

proc eqs(got, want, what: string) =
  if got != want:
    echo "FAILED: " & what & " got [" & got & "] want [" & want & "]"
    inc failed

proc eqi(got, want: int, what: string) =
  if got != want:
    echo "FAILED: " & what & " got " & $got & " want " & $want
    inc failed

proc args(items: varargs[string]): seq[TextComponentBase] =
  result = @[]
  for s in items: result.add textBase(s)

proc textsOf(bases: seq[TextComponentBase]): string =
  result = ""
  for b in bases:
    result.add '['
    result.add b.content.text
    result.add ']'

proc rangesOf(r: seq[SubstitutionRange]): string =
  result = ""
  for x in r:
    result.add $x.start
    result.add '-'
    result.add $x.`end`
    result.add ' '

# The embedded assets are byte for byte.
block:
  eqi(vanillaEnUsJson().len, 486883, "en_us_java.json bytes")
  eqi(bedrockEnUsLang().len, 812014, "en_us_bedrock.lang bytes")
  eqi(PumpkinTranslationFiles.len, 24, "file count")
  check(pumpkinTranslationJson("nope") == "", "unknown file")

block:
  eqi(LocaleCount, 128, "Locale::COUNT")
  eqi(ord(lcAfZa), 0, "first locale")
  eqi(ord(lcEnUs), 25, "EnUs position")
  eqi(ord(lcZlmArab), 127, "last locale")
  check(localeFromStr("af_za") == lcAfZa, "af_za")
  check(localeFromStr("EN_gb") == lcEnGb, "case-insensitive")
  check(localeFromStr("zlm_arab") == lcZlmArab, "zlm_arab")
  check(localeFromStr("ksh") == lcKsh, "ksh")
  check(localeFromStr("en_us") == lcEnUs, "en_us")
  check(localeFromStr("xx_xx") == lcEnUs, "fallback")
  check(localeFromStr("") == lcEnUs, "empty fallback")

# Table load: 8123 vanilla + 10 pumpkin, then 12927 bedrock lines under three prefixes, with overlaps.
block:
  eqi(translationCount(lcEnUs), 45629, "en_us entries")
  eqi(translationCount(lcDeDe), 10, "de_de entries")
  eqi(translationCount(lcBrb), 10, "brb entries")
  eqi(translationCount(lcAfZa), 0, "af_za entries")
  for file in PumpkinTranslationFiles:
    eqi(translationCount(localeFromStr(file)), (if file == "en_us": 45629 else: 10), "entries of " & file)

block:
  eqs(getTranslation("minecraft:multiplayer.player.joined", lcEnUs), "%s joined the game", "vanilla")
  eqs(getTranslation("MINECRAFT:Multiplayer.Player.Joined", lcEnUs), "%s joined the game", "lookup lowercases")
  eqs(getTranslation("minecraft:gui.done", lcEnUs), "Done", "vanilla 2")
  # The Bedrock pass overrides vanilla.
  eqs(getTranslation("minecraft:commands.seed.success", lcEnUs), "Seed: %1$s", "bedrock overrides")
  eqs(getTranslation("commands.seed.success", lcEnUs), "Seed: %1$s", "bedrock bare key")
  eqs(getTranslation("pumpkin:commands.seed.success", lcEnUs), "Seed: %1$s", "bedrock under pumpkin")
  # A vanilla key with an upper-case letter is stored as is and cannot be found through the lowercasing lookup,
  # unless Bedrock has it too.
  eqs(getTranslation("pumpkin:commands.pumpkin.version", lcEnUs), "Pumpkin %s\n", "pumpkin en_us")
  # Locale, then fallback to en_us, then the lowercased key.
  check(getTranslation("pumpkin:commands.pumpkin.description", lcDeDe) != getTranslation("pumpkin:commands.pumpkin.description", lcEnUs), "de_de differs")
  eqs(getTranslation("minecraft:gui.done", lcDeDe), "Done", "fallback to en_us")
  eqs(getTranslation("no.Such.KEY", lcEnUs), "no.such.key", "missing key lowercased")

block:
  addTranslation("Mod", "Key", "v", lcFrFr)
  eqs(getTranslation("mod:key", lcFrFr), "v", "add lowercases")
  eqs(getTranslation("mod:key", lcEnUs), "mod:key", "only that locale")
  addTranslation("mod", "key", "w", lcFrFr)
  eqs(getTranslation("mod:key", lcFrFr), "w", "add overrides")
  let before = translationCount(lcItIt)
  addTranslationFile("mod", "not json", lcItIt)
  eqi(translationCount(lcItIt), before, "bad json is ignored")
  addTranslationFile("mod", """{"a":1}""", lcItIt)
  eqi(translationCount(lcItIt), before, "non-string value is ignored whole")
  addTranslationFile("mod", "{}", lcItIt)
  eqi(translationCount(lcItIt), before, "empty is ignored")
  addTranslationFile("Mod", """{"A.B":"x","c":"y"}""", lcItIt)
  eqs(getTranslation("mod:a.b", lcItIt), "x", "file lowercases")
  eqi(translationCount(lcItIt), before + 2, "file adds")

block:
  let r = SubstitutionRange(start: 2, `end`: 3)
  eqi(r.len, 2, "range len")
  check(not r.isEmpty, "range not empty")
  check(SubstitutionRange(start: 2, `end`: 2).isEmpty, "range empty")

# reorder_substitutions.
block:
  let (s1, r1) = reorderSubstitutions("a %s b %s", args("x", "y"))
  eqs(textsOf(s1), "[x][y]", "plain subs")
  eqs(rangesOf(r1), "2-3 7-8 ", "plain ranges")

  let (s2, r2) = reorderSubstitutions("%2$s %1$s", args("x", "y"))
  eqs(textsOf(s2), "[y][x]", "positional subs")
  eqs(rangesOf(r2), "0-3 5-8 ", "positional ranges")

  # Positional numbers clamp into range; 0 and too big.
  let (s3, _) = reorderSubstitutions("%0$s %9$s", args("x", "y"))
  eqs(textsOf(s3), "[x][y]", "clamped")

  # Mixed: %d has no digits and takes the next argument, and the last argument repeats.
  let (s4, r4) = reorderSubstitutions("%d %d %d", args("x", "y"))
  eqs(textsOf(s4), "[x][y][y]", "next_idx clamps")
  eqs(rangesOf(r4), "0-1 3-4 6-7 ", "%d ranges")

  # An escaped percent is not a placeholder, though it counts in the "%s" tally upstream takes.
  let (s5, r5) = reorderSubstitutions("\\%s %s", args("x"))
  eqs(textsOf(s5), "[x]", "escaped subs")
  eqs(rangesOf(r5), "4-5 ", "escaped ranges")

  # A number too big for usize leaves the substitution empty.
  let (s6, _) = reorderSubstitutions("%99999999999999999999$s", args("x"))
  eqs(textsOf(s6), "[]", "overflow stays empty")

  # No arguments at all: upstream panics, these stay empty.
  let (s7, _) = reorderSubstitutions("%1$s %d", args())
  eqs(textsOf(s7), "[][]", "no args")

# get_translation_text.
block:
  addTranslation("t", "two", "a %s b %s c", lcEnUs)
  addTranslation("t", "pos", "%2$s-%1$s", lcEnUs)
  addTranslation("t", "none", "plain", lcEnUs)
  addTranslation("t", "pct", "100%", lcEnUs)
  addTranslation("t", "dbl", "%s is 5%% up", lcEnUs)
  eqs(getTranslationText("t:two", lcEnUs, args("X", "Y")), "a X b Y c", "text two")
  eqs(getTranslationText("t:pos", lcEnUs, args("X", "Y")), "Y-X", "text positional")
  eqs(getTranslationText("t:none", lcEnUs, args("X")), "plain", "text no percent")
  # No arguments returns the raw translation.
  eqs(getTranslationText("t:two", lcEnUs, args()), "a %s b %s c", "text no args")
  # Fewer arguments: the index clamps to the last one here, unlike in to_translated.
  eqs(getTranslationText("t:two", lcEnUs, args("X")), "a X b X c", "text clamps")
  # Rust panics on these two; they must simply not crash here. The second `%` of `%%` is a placeholder
  # whose range also covers the space after it.
  eqs(getTranslationText("t:pct", lcEnUs, args("X")), "100X", "percent last")
  eqs(getTranslationText("t:dbl", lcEnUs, args("X")), "X is 5XXup", "double percent")
  eqs(translationToPretty("t:two", lcEnUs, args("X", "Y")), "a X b Y c", "pretty two")
  eqs(translationToPretty("t:none", lcEnUs, args()), "plain", "pretty plain")
  # Nested substitutions recurse.
  var nested = textBase("N")
  nested.extra.add textBase("M")
  eqs(getTranslationText("t:pos", lcEnUs, @[nested, textBase("Y")]), "Y-NM", "nested")

if failed > 0:
  echo $failed & " failed"
  quit(1)
echo "translationtest ok"
