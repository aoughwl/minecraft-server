## Port of pumpkin-util/src/lib.rs
##
## `global_path!` reads the caller's `file!()`, which aowlmony cannot see, so `globalPath` takes the source
## file as its first argument. `MutableSplitSlice` holds raw pointers, standing in for the two `&mut [T]`;
## it must not outlive the base it was split from.

{.feature: "untyped".}

import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import serde_forms
import vector3
import difficulty
import gamemode
import permission

export Difficulty, GameMode, PermissionLvl

type
  HeightMap* = enum
    WorldSurfaceWg
    WorldSurface
    OceanFloorWg
    OceanFloor
    MotionBlocking
    MotionBlockingNoLeaves

  ProfileAction* = enum
    ForcedNameChange
    UsingBannedSkin

  BlockDirection* = enum
    Down = 0
    Up
    North
    South
    West
    East

  MutableSplitSlice*[T] = object
    startP: ptr UncheckedArray[T]
    startLen: int
    endP: ptr UncheckedArray[T]
    endLen: int

  DoublePerlinNoiseParametersCodec* = object
    firstOctave*: int32
    amplitudes*: seq[float64]
    amplitude*: float64

  Hand* = enum
    Left
    Right

proc fromJson*(t: typedesc[HeightMap], v: JsonValue): DataResult[HeightMap] =
  let r = readUnitVariant(v, ["WORLD_SURFACE_WG", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "OCEAN_FLOOR",
                              "MOTION_BLOCKING", "MOTION_BLOCKING_NO_LEAVES"])
  if not r.isSuccess:
    return newError[HeightMap](r.message)
  case r.successResult
  of 0: newSuccess(WorldSurfaceWg)
  of 1: newSuccess(WorldSurface)
  of 2: newSuccess(OceanFloorWg)
  of 3: newSuccess(OceanFloor)
  of 4: newSuccess(MotionBlocking)
  else: newSuccess(MotionBlockingNoLeaves)

proc parentDir(path: string): string =
  var i = path.len - 1
  while i >= 0:
    if path[i] == '/' or path[i] == '\\':
      return path[0 ..< i]
    dec i
  ""

proc globalPath*(sourceFile, path: string): string =
  ## `global_path!`: `path` relative to the directory of `sourceFile`.
  let dir = parentDir(sourceFile)
  if dir.len == 0: path else: dir & "/" & path

proc readDataFromFile*(sourceFile, path: string): JsonValue =
  ## `read_data_from_file!`, which panics. Not for static files.
  var f = default(File)
  if not open(f, globalPath(sourceFile, path), fmRead):
    quit("no data file")
  var text = ""
  var line = ""
  while f.readLine(line):
    text.add(line)
    text.add('\n')
  close(f)
  let parsed = parseJsonValue(text)
  if not parsed.ok:
    quit("failed to decode data")
  parsed.value

template assertEqDelta*(x, y, d: untyped) =
  ## `assert_eq_delta!`.
  if 2.0'f64 * abs(x - y) > d * (abs(x) + abs(y)):
    quit($x & " vs " & $y & " (" & $abs(x - y) & " vs " & $d & ")")

proc encompassingBits*(count: uint): uint8 =
  ## The minimum number of bits required to represent this number. Zero panics, as `ilog2` does.
  if count == 1'u:
    return 1'u8
  if count == 0'u:
    quit("argument of integer logarithm must be positive")
  var ilog2 = 0'u8
  var c = count
  while c > 1'u:
    c = c shr 1
    inc ilog2
  let isPowerOfTwo = (count and (count - 1'u)) == 0'u
  if isPowerOfTwo: ilog2 else: ilog2 + 1'u8

proc encompassingBits*(count: int): uint8 =
  encompassingBits(uint(count))

proc toJson*(a: ProfileAction): JsonValue =
  case a
  of ForcedNameChange: jsonString("FORCED_NAME_CHANGE")
  of UsingBannedSkin: jsonString("USING_BANNED_SKIN")

proc fromJson*(t: typedesc[ProfileAction], v: JsonValue): DataResult[ProfileAction] =
  let r = readUnitVariant(v, ["FORCED_NAME_CHANGE", "USING_BANNED_SKIN"])
  if not r.isSuccess:
    return newError[ProfileAction](r.message)
  if r.successResult == 0: newSuccess(ForcedNameChange)
  else: newSuccess(UsingBannedSkin)

proc getAxis*(d: BlockDirection): Axis =
  case d
  of Up, Down: axisY
  of North, South: axisZ
  of East, West: axisX

proc getRandomHorizontalDirection*[R](random: var R): BlockDirection =
  case nextBoundedI32(random, 4'i32)
  of 0'i32: North
  of 1'i32: East
  of 2'i32: South
  else: West

proc opposite*(d: BlockDirection): BlockDirection =
  case d
  of Down: Up
  of Up: Down
  of North: South
  of South: North
  of West: East
  of East: West

proc toVector*(d: BlockDirection): Vector3[int32] =
  case d
  of Down: vec3(0'i32, -1'i32, 0'i32)
  of Up: vec3(0'i32, 1'i32, 0'i32)
  of North: vec3(0'i32, 0'i32, -1'i32)
  of South: vec3(0'i32, 0'i32, 1'i32)
  of West: vec3(-1'i32, 0'i32, 0'i32)
  of East: vec3(1'i32, 0'i32, 0'i32)

proc extractIth*[T](base: var openArray[T], index: int): (ptr T, MutableSplitSlice[T]) =
  ## The `index`-th element, mutable, with a slice over the remaining elements. Panics out of bounds.
  if index < 0 or index >= base.len:
    quit("Index is not in base slice")
  let whole = cast[ptr UncheckedArray[T]](addr base[0])
  let afterP = cast[ptr UncheckedArray[T]](addr whole[index])
  (addr base[index], MutableSplitSlice[T](startP: whole, startLen: index,
    endP: afterP, endLen: base.len - index - 1))

proc len*[T](s: MutableSplitSlice[T]): int =
  s.startLen + s.endLen + 1

proc isEmpty*[T](s: MutableSplitSlice[T]): bool =
  false

proc slotOf[T](s: MutableSplitSlice[T], index: int): ptr T =
  if index < s.startLen:
    addr s.startP[index]
  elif index == s.startLen:
    quit("We tried to index into the element that was removed")
  else:
    let rel = index - s.startLen - 1
    if rel >= s.endLen:
      quit("index out of bounds")
    # endP starts at the removed element, so skip it
    addr s.endP[rel + 1]

proc `[]`*[T](s: MutableSplitSlice[T], index: int): T =
  slotOf(s, index)[]

proc `[]=`*[T](s: MutableSplitSlice[T], index: int, value: sink T) =
  slotOf(s, index)[] = value

proc fromJson*(t: typedesc[DoublePerlinNoiseParametersCodec], v: JsonValue): DataResult[DoublePerlinNoiseParametersCodec] =
  ## `amplitude` is `#[serde(skip)]` and takes its default.
  if v.kind != jvObject:
    return newError[DoublePerlinNoiseParametersCodec](invalidType(v, "struct DoublePerlinNoiseParametersCodec"))
  let (hasOctave, octaveV) = v.get("firstOctave")
  if not hasOctave:
    return newError[DoublePerlinNoiseParametersCodec](missingField("firstOctave"))
  let octave = readSigned(octaveV, -2147483648'i64, 2147483647'i64, "i32")
  if not octave.isSuccess:
    return newError[DoublePerlinNoiseParametersCodec](octave.message)
  let (hasAmps, ampsV) = v.get("amplitudes")
  if not hasAmps:
    return newError[DoublePerlinNoiseParametersCodec](missingField("amplitudes"))
  if ampsV.kind != jvArray:
    return newError[DoublePerlinNoiseParametersCodec](invalidType(ampsV, "a sequence"))
  var amps: seq[float64] = @[]
  for item in ampsV.items:
    let a = readF64(item)
    if not a.isSuccess:
      return newError[DoublePerlinNoiseParametersCodec](a.message)
    amps.add(a.successResult)
  newSuccess(DoublePerlinNoiseParametersCodec(firstOctave: int32(octave.successResult),
    amplitudes: amps, amplitude: 0.0))

proc handAll*(): array[2, Hand] =
  ## `Hand::all`.
  [Right, Left]

proc handTryFrom*(value: int32): (bool, Hand) =
  ## `impl TryFrom<i32> for Hand`: 0 is `Left`, 1 is `Right`.
  case value
  of 0'i32: (true, Left)
  of 1'i32: (true, Right)
  else: (false, Left)
