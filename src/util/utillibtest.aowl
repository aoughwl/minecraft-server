## Known answers for utillib.aowl (lib.rs). Upstream has no #[test] in lib.rs.

{.feature: "untyped".}

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import vector3
import legacy_rand
import utillib

# encompassing_bits
assert encompassingBits(1) == 1'u8
assert encompassingBits(2) == 1'u8
assert encompassingBits(3) == 2'u8
assert encompassingBits(4) == 2'u8
assert encompassingBits(5) == 3'u8
assert encompassingBits(8) == 3'u8
assert encompassingBits(9) == 4'u8
assert encompassingBits(4096) == 12'u8
assert encompassingBits(4097) == 13'u8
assert encompassingBits(27'u) == 5'u8

# HeightMap: SCREAMING_SNAKE_CASE
assert fromJson(HeightMap, jsonString("WORLD_SURFACE_WG")).successResult == WorldSurfaceWg
assert fromJson(HeightMap, jsonString("WORLD_SURFACE")).successResult == WorldSurface
assert fromJson(HeightMap, jsonString("OCEAN_FLOOR_WG")).successResult == OceanFloorWg
assert fromJson(HeightMap, jsonString("OCEAN_FLOOR")).successResult == OceanFloor
assert fromJson(HeightMap, jsonString("MOTION_BLOCKING")).successResult == MotionBlocking
assert fromJson(HeightMap, jsonString("MOTION_BLOCKING_NO_LEAVES")).successResult == MotionBlockingNoLeaves
assert not fromJson(HeightMap, jsonString("WorldSurface")).isSuccess

# ProfileAction
assert toJsonString(toJson(ForcedNameChange)) == "\"FORCED_NAME_CHANGE\""
assert toJsonString(toJson(UsingBannedSkin)) == "\"USING_BANNED_SKIN\""
assert fromJson(ProfileAction, jsonString("USING_BANNED_SKIN")).successResult == UsingBannedSkin
assert fromJson(ProfileAction, jsonString("x")).message ==
  "unknown variant `x`, expected `FORCED_NAME_CHANGE` or `USING_BANNED_SKIN`"

# BlockDirection
assert ord(Down) == 0 and ord(Up) == 1 and ord(North) == 2 and ord(South) == 3 and ord(West) == 4 and ord(East) == 5
assert getAxis(Up) == axisY and getAxis(Down) == axisY
assert getAxis(North) == axisZ and getAxis(South) == axisZ
assert getAxis(East) == axisX and getAxis(West) == axisX
assert opposite(Down) == Up and opposite(Up) == Down
assert opposite(North) == South and opposite(South) == North
assert opposite(West) == East and opposite(East) == West

proc vecIs(d: BlockDirection, x, y, z: int32): bool =
  let v = toVector(d)
  v.x == x and v.y == y and v.z == z

assert vecIs(Down, 0'i32, -1'i32, 0'i32)
assert vecIs(Up, 0'i32, 1'i32, 0'i32)
assert vecIs(North, 0'i32, 0'i32, -1'i32)
assert vecIs(South, 0'i32, 0'i32, 1'i32)
assert vecIs(West, -1'i32, 0'i32, 0'i32)
assert vecIs(East, 1'i32, 0'i32, 0'i32)

# LegacyRand(0).next_bounded_i32(4) is the first value of java.util.Random(0).nextInt(4)
block:
  var r = fromSeed(0'u64)
  var check = fromSeed(0'u64)
  let d = getRandomHorizontalDirection(r)
  let n = nextBoundedI32(check, 4'i32)
  case n
  of 0'i32: assert d == North
  of 1'i32: assert d == East
  of 2'i32: assert d == South
  else: assert d == West
  # only horizontal directions come out, and all four do
  var seen = [false, false, false, false, false, false]
  for i in 0 ..< 200:
    seen[ord(getRandomHorizontalDirection(r))] = true
  assert not seen[ord(Down)] and not seen[ord(Up)]
  assert seen[ord(North)] and seen[ord(South)] and seen[ord(West)] and seen[ord(East)]

# MutableSplitSlice
block:
  var base = @[10, 20, 30, 40, 50]
  let (value, slice) = extractIth(base, 2)
  assert value[] == 30
  assert slice.len == 5
  assert not slice.isEmpty
  assert slice[0] == 10 and slice[1] == 20
  assert slice[3] == 40 and slice[4] == 50
  value[] = 31
  slice[0] = 11
  slice[4] = 51
  assert base == @[11, 20, 31, 40, 51]

block:
  var base = @[1]
  let (value, slice) = extractIth(base, 0)
  assert value[] == 1
  assert slice.len == 1

# DoublePerlinNoiseParametersCodec
block:
  let o = parseJsonValue("""{"firstOctave": -7, "amplitudes": [1.0, 2, 0.5]}""")
  let c = fromJson(DoublePerlinNoiseParametersCodec, o.value)
  assert c.isSuccess
  assert c.successResult.firstOctave == -7'i32
  assert c.successResult.amplitudes == @[1.0'f64, 2.0'f64, 0.5'f64]
  assert c.successResult.amplitude == 0.0'f64
  let missing = fromJson(DoublePerlinNoiseParametersCodec, parseJsonValue("""{"amplitudes": []}""").value)
  assert missing.message == "missing field `firstOctave`"

# Hand
assert handAll()[0] == Right and handAll()[1] == Left
assert handTryFrom(0'i32) == (true, Left)
assert handTryFrom(1'i32) == (true, Right)
assert handTryFrom(2'i32)[0] == false
assert handTryFrom(-1'i32)[0] == false

# global_path! and assert_eq_delta!
assert globalPath("src/util/a.aowl", "b.json") == "src/util/b.json"
assert globalPath("a.aowl", "b.json") == "b.json"
assert globalPath("c:\\x\\a.aowl", "../b.json") == "c:\\x/../b.json"
assertEqDelta(1.0'f64, 1.0000001'f64, 0.001'f64)

# read_data_from_file! against a file this repo has
block:
  let doc = readDataFromFile("assets/x", "../src/util/utillibtestdata.json")
  assert doc.kind == jvObject
  assert doc.get("answer")[1].intVal == 42'i64

# the re-exports from lib.rs
let exportedPerm: PermissionLvl = PermissionLvl.Two
assert ord(exportedPerm) == 2

echo "utillib checks passed"
