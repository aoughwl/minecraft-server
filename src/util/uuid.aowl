## Port of pumpkin-util/src/uuid.rs
##
## Also holds the `uuid` crate's `Uuid` type that file and pumpkin-util/src/permission.rs use, with the
## surface this server needs. v4 draws from OS entropy as the crate's `getrandom` does: BCryptGenRandom on
## Windows, getentropy elsewhere. Same `hi`/`lo` shape as src/protocol/uuid.aowl's wire type.

import std/hashes
import std/md5
import ../codecs/json_value
import ../codecs/data_result
import serde_forms

type
  Uuid* = object
    hi*: uint64
    lo*: uint64

const
  NilUuid* = Uuid(hi: 0'u64, lo: 0'u64)
  NamespaceDns* = Uuid(hi: 0x6ba7b8109dad11d1'u64, lo: 0x80b400c04fd430c8'u64)
  NamespaceUrl* = Uuid(hi: 0x6ba7b8119dad11d1'u64, lo: 0x80b400c04fd430c8'u64)
  NamespaceOid* = Uuid(hi: 0x6ba7b8129dad11d1'u64, lo: 0x80b400c04fd430c8'u64)
  NamespaceX500* = Uuid(hi: 0x6ba7b8149dad11d1'u64, lo: 0x80b400c04fd430c8'u64)

func `==`*(a, b: Uuid): bool {.inline.} =
  a.hi == b.hi and a.lo == b.lo

func `<`*(a, b: Uuid): bool =
  if a.hi != b.hi: a.hi < b.hi else: a.lo < b.lo

func hash*(u: Uuid): Hash =
  hash(u.hi) xor hash(u.lo)

proc parseI64Radix16(part: string): (bool, int64) =
  ## `i64::from_str_radix(part, 16)`: an optional sign, at least one digit, no overflow.
  var i = 0
  if part.len > 0 and part[0] == '+':
    i = 1
  if i >= part.len:
    return (false, 0'i64)
  var acc = 0'u64
  while i < part.len:
    let c = part[i]
    var digit = 0'u64
    if c >= '0' and c <= '9': digit = uint64(ord(c) - ord('0'))
    elif c >= 'a' and c <= 'f': digit = uint64(ord(c) - ord('a') + 10)
    elif c >= 'A' and c <= 'F': digit = uint64(ord(c) - ord('A') + 10)
    else: return (false, 0'i64)
    if acc > (0x7FFFFFFFFFFFFFFF'u64 - digit) div 16'u64:
      return (false, 0'i64)
    acc = acc * 16'u64 + digit
    inc i
  (true, int64(acc))

proc parseUuidArray*(uuid: string): (bool, array[4, int32]) =
  ## Parses a UUID the way Java's `UUID.fromString` does, which is looser than the crate's parser.
  let none = [0'i32, 0'i32, 0'i32, 0'i32]
  if uuid.len > 36:
    return (false, none)
  var parsedParts = [0'i64, 0'i64, 0'i64, 0'i64, 0'i64]
  var count = 0
  var part = ""
  var i = 0
  while i <= uuid.len:
    if i == uuid.len or uuid[i] == '-':
      if count == 5:
        return (false, none)
      let (ok, value) = parseI64Radix16(part)
      if not ok:
        return (false, none)
      parsedParts[count] = value
      inc count
      part = ""
    else:
      part.add(uuid[i])
    inc i
  if count != 5:
    return (false, none)

  let bits0 = ((uint64(parsedParts[0]) and 0xFFFFFFFF'u64) shl 32) or
    ((uint64(parsedParts[1]) and 0xFFFF'u64) shl 16) or
    (uint64(parsedParts[2]) and 0xFFFF'u64)
  let bits1 = ((uint64(parsedParts[3]) and 0xFFFF'u64) shl 48) or
    (uint64(parsedParts[4]) and 0xFFFFFFFFFFFF'u64)

  (true, [cast[int32](uint32(bits0 shr 32)), cast[int32](uint32(bits0 and 0xFFFFFFFF'u64)),
          cast[int32](uint32(bits1 shr 32)), cast[int32](uint32(bits1 and 0xFFFFFFFF'u64))])

proc parseUuidVec*(uuid: string): (bool, seq[int32]) =
  let (ok, a) = parseUuidArray(uuid)
  if ok: (true, @[a[0], a[1], a[2], a[3]])
  else: (false, @[])

proc fromIntArray*(a: array[4, int32]): Uuid =
  ## The four big-endian words of the `[I;4]` NBT form.
  Uuid(hi: (uint64(cast[uint32](a[0])) shl 32) or uint64(cast[uint32](a[1])),
       lo: (uint64(cast[uint32](a[2])) shl 32) or uint64(cast[uint32](a[3])))

proc toIntArray*(u: Uuid): array[4, int32] =
  [cast[int32](uint32(u.hi shr 32)), cast[int32](uint32(u.hi and 0xFFFFFFFF'u64)),
   cast[int32](uint32(u.lo shr 32)), cast[int32](uint32(u.lo and 0xFFFFFFFF'u64))]

proc parseUuid*(uuid: string): (bool, Uuid) =
  let (ok, a) = parseUuidArray(uuid)
  if ok: (true, fromIntArray(a))
  else: (false, NilUuid)

proc fromBytes*(b: array[16, uint8]): Uuid =
  ## `Uuid::from_bytes`: big-endian.
  var hi = 0'u64
  var lo = 0'u64
  for i in 0 ..< 8:
    hi = (hi shl 8) or uint64(b[i])
    lo = (lo shl 8) or uint64(b[i + 8])
  Uuid(hi: hi, lo: lo)

proc asBytes*(u: Uuid): array[16, uint8] =
  result = [0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8]
  for i in 0 ..< 8:
    result[i] = uint8((u.hi shr (56 - 8 * i)) and 0xFF'u64)
    result[i + 8] = uint8((u.lo shr (56 - 8 * i)) and 0xFF'u64)

proc `$`*(u: Uuid): string =
  ## `Display`: lowercase, hyphenated.
  const hexChars = "0123456789abcdef"
  let b = asBytes(u)
  result = ""
  for i in 0 ..< 16:
    if i == 4 or i == 6 or i == 8 or i == 10:
      result.add('-')
    result.add(hexChars[int(b[i] shr 4)])
    result.add(hexChars[int(b[i] and 0x0F'u8)])

proc simple*(u: Uuid): string =
  ## `Uuid::simple`: no hyphens, the form Mojang's API uses.
  const hexChars = "0123456789abcdef"
  let b = asBytes(u)
  result = ""
  for i in 0 ..< 16:
    result.add(hexChars[int(b[i] shr 4)])
    result.add(hexChars[int(b[i] and 0x0F'u8)])

proc getVersionNum*(u: Uuid): int =
  int((u.hi shr 12) and 0xF'u64)

proc parseStr*(text: string): (bool, Uuid) =
  ## `Uuid::parse_str`: hyphenated, simple, `urn:uuid:` or braced. Strict, unlike `parseUuid`.
  var s = text
  if s.len == 45 and s[0 .. 8] == "urn:uuid:":
    s = s[9 .. ^1]
  elif s.len == 38 and s[0] == '{' and s[37] == '}':
    s = s[1 .. 36]
  var hex = ""
  if s.len == 36:
    for i in 0 ..< 36:
      if i == 8 or i == 13 or i == 18 or i == 23:
        if s[i] != '-':
          return (false, NilUuid)
      else:
        hex.add(s[i])
  elif s.len == 32:
    hex = s
  else:
    return (false, NilUuid)
  var hi = 0'u64
  var lo = 0'u64
  for i in 0 ..< 32:
    let c = hex[i]
    var digit = 0'u64
    if c >= '0' and c <= '9': digit = uint64(ord(c) - ord('0'))
    elif c >= 'a' and c <= 'f': digit = uint64(ord(c) - ord('a') + 10)
    elif c >= 'A' and c <= 'F': digit = uint64(ord(c) - ord('A') + 10)
    else: return (false, NilUuid)
    if i < 16: hi = (hi shl 4) or digit
    else: lo = (lo shl 4) or digit
  (true, Uuid(hi: hi, lo: lo))

proc digestToV3(digest: MD5Digest): Uuid =
  var b = [0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8]
  for i in 0 ..< 16:
    b[i] = uint8(digest[i])
  b[6] = (b[6] and 0x0F'u8) or 0x30'u8
  b[8] = (b[8] and 0x3F'u8) or 0x80'u8
  fromBytes(b)

proc nameUuidFromBytes*(name: string): Uuid =
  ## Java's `UUID.nameUUIDFromBytes`: MD5 of the name alone, as offline-mode player ids use.
  digestToV3(toMD5(name))

proc newV3*(namespace: Uuid, name: string): Uuid =
  ## `Uuid::new_v3`: MD5 of the namespace's bytes then the name.
  var data = newString(16)
  let b = asBytes(namespace)
  for i in 0 ..< 16:
    data[i] = char(b[i])
  data.add(name)
  digestToV3(toMD5(data))

when defined(windows):
  proc bcryptGenRandom(alg: nil pointer, buf: pointer, len: uint32, flags: uint32): int32
    {.stdcall, importc: "BCryptGenRandom", dynlib: "bcrypt.dll".}

  proc osEntropy(buf: pointer, len: int): bool =
    # 2 is BCRYPT_USE_SYSTEM_PREFERRED_RNG
    bcryptGenRandom(nil, buf, uint32(len), 2'u32) == 0'i32
else:
  proc getentropy(buf: pointer, len: csize_t): cint {.importc: "getentropy", header: "<unistd.h>".}

  proc osEntropy(buf: pointer, len: int): bool =
    getentropy(buf, csize_t(len)) == 0.cint

proc newV4*(): (bool, Uuid) =
  ## `Uuid::new_v4`. `(false, _)` when the OS has no entropy to give; the crate panics there.
  var b = [0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8, 0'u8]
  if not osEntropy(addr b[0], 16):
    return (false, NilUuid)
  b[6] = (b[6] and 0x0F'u8) or 0x40'u8
  b[8] = (b[8] and 0x3F'u8) or 0x80'u8
  (true, fromBytes(b))

proc toJson*(u: Uuid): JsonValue =
  ## The crate's `Serialize` for human-readable formats.
  jsonString($u)

proc fromJson*(t: typedesc[Uuid], v: JsonValue): DataResult[Uuid] =
  if v.kind != jvString:
    return newError[Uuid](invalidType(v, "a string"))
  let (ok, u) = parseStr(v.strVal)
  if ok: newSuccess(u)
  else: newError[Uuid]("UUID parsing failed: " & v.strVal)
