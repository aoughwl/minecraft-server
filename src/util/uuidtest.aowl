## Port of the #[test]s in pumpkin-util/src/uuid.rs, plus known answers for the crate surface.

import std/assertions
import std/syncio
import std/tables
import ../codecs/json_value
import ../codecs/data_result
import uuid

proc check(s: string, a, b, c, d: int32) =
  let r = parseUuidArray(s)
  assert r[0], s
  assert r[1][0] == a and r[1][1] == b and r[1][2] == c and r[1][3] == d, s

proc strictly(s: string): Uuid =
  let r = parseStr(s)
  assert r[0], s
  r[1]

# parse_uuids
check("3d569d3a-93ef-44a0-9f1c-f69db9d37a56", 1029086522'i32, -1813035872'i32, -1625491811'i32, -1177322922'i32)
check("3d53a-f-40-c-f69db9d37a56", 251194'i32, 983104'i32, 849565'i32, -1177322922'i32)
assert not parseUuidArray("3d53a-f40-c-f69db9d37a56")[0]
check("fffffffffffffff-0-0-0-0", -1'i32, 0'i32, 0'i32, 0'i32)
assert not parseUuidArray("ffffffffffffffff-0-0-0-0")[0]
check("+1-+2-+3-+4-+5", 1'i32, 131075'i32, 262144'i32, 5'i32)
check("aaaaaaaaaaaaaaa-bbbbbbbbbbbbbb-c-d-e", -1431655766'i32, -1145372660'i32, 851968'i32, 14'i32)
assert not parseUuidArray("aaaaaaaaaaaaaaa-bbbbbbbbbbbbbb-c--e")[0]

assert parseUuid("3d569d3a-93ef-44a0-9f1c-f69db9d37a56") == (true, strictly("3d569d3a-93ef-44a0-9f1c-f69db9d37a56"))
assert parseUuid("3d53a-f-40-c-f69db9d37a56") == (true, strictly("0003d53a-000f-0040-000c-f69db9d37a56"))
assert parseUuid("+1-+2-+3-+4-+5") == (true, strictly("00000001-0002-0003-0004-000000000005"))

# the rest of parse_uuid_array's edges
assert not parseUuidArray("")[0]
assert not parseUuidArray("1-2-3-4")[0]
assert not parseUuidArray("1-2-3-4-5-6")[0]
assert not parseUuidArray("0000000000000000000000000000000-1-2-3")[0]
assert not parseUuidArray("g-0-0-0-0")[0]
assert not parseUuidArray("+-0-0-0-0")[0]
let v = parseUuidVec("+1-+2-+3-+4-+5")
assert v[0] and v[1] == @[1'i32, 131075'i32, 262144'i32, 5'i32]
assert not parseUuidVec("x")[0]

# display and round trips
let u = strictly("3d569d3a-93ef-44a0-9f1c-f69db9d37a56")
assert $u == "3d569d3a-93ef-44a0-9f1c-f69db9d37a56"
assert simple(u) == "3d569d3a93ef44a09f1cf69db9d37a56"
assert u.hi == 0x3d569d3a93ef44a0'u64 and u.lo == 0x9f1cf69db9d37a56'u64
assert fromBytes(asBytes(u)) == u
assert fromIntArray(toIntArray(u)) == u
assert toIntArray(u)[1] == -1813035872'i32
assert $NilUuid == "00000000-0000-0000-0000-000000000000"
assert getVersionNum(u) == 4

# parse_str forms
assert strictly("3D569D3A93EF44A09F1CF69DB9D37A56") == u
assert strictly("urn:uuid:3d569d3a-93ef-44a0-9f1c-f69db9d37a56") == u
assert strictly("{3d569d3a-93ef-44a0-9f1c-f69db9d37a56}") == u
assert not parseStr("3d53a-f-40-c-f69db9d37a56")[0]
assert not parseStr("3d569d3a_93ef-44a0-9f1c-f69db9d37a56")[0]
assert not parseStr("")[0]

# Java's UUID.nameUUIDFromBytes: Notch's well-known offline id
assert $nameUuidFromBytes("OfflinePlayer:Notch") == "b50ad385-829d-3141-a216-7e7d7539ba7f"
assert getVersionNum(nameUuidFromBytes("x")) == 3

# RFC 4122 v3, the example in Python's uuid docs
assert $newV3(NamespaceDns, "python.org") == "6fa459ea-ee8a-3ca4-894e-db77e160355e"
assert $NamespaceUrl == "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
assert $NamespaceOid == "6ba7b812-9dad-11d1-80b4-00c04fd430c8"
assert $NamespaceX500 == "6ba7b814-9dad-11d1-80b4-00c04fd430c8"

# v4: version and variant bits, and two draws differ
let a4 = newV4()
let b4 = newV4()
assert a4[0] and b4[0]
assert getVersionNum(a4[1]) == 4
assert (a4[1].lo shr 62) == 2'u64
assert a4[1] != b4[1]

# serde and table use
assert toJsonString(toJson(u)) == "\"3d569d3a-93ef-44a0-9f1c-f69db9d37a56\""
assert fromJson(Uuid, jsonString("3d569d3a-93ef-44a0-9f1c-f69db9d37a56")).successResult == u
assert not fromJson(Uuid, jsonInt(1)).isSuccess
assert not fromJson(Uuid, jsonString("nope")).isSuccess

var t = initTable[Uuid, int]()
t[u] = 1
assert t.hasKey(strictly("3d569d3a93ef44a09f1cf69db9d37a56"))
assert not t.hasKey(NilUuid)

echo "uuid checks passed"
