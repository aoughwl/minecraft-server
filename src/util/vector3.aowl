## Port of pumpkin-util/src/math/vector3.rs
##
## 3-dimensional vector with generic numeric components. As with vector2.aowl, Rust's local `Math` trait
## becomes aowlmony's `Arithmetic` concept so this stays a real generic. The `-` and `unpackedChunkPos`
## here have no live upstream code (upstream's Neg is commented out) but callers use them.
## `to_block_pos` is `toBlockPos` in math/position.aowl, which imports this module.

{.feature: "untyped".}

import std/[math, hashes, assertions]
import ../codecs/codec_core
import ../codecs/json_value
import ../codecs/list_codec
import ../nbt/tag
import math/rustnum
import math/serdeforms
import vector2

type
  Axis* = enum
    axisX
    axisY
    axisZ

  Vector3*[T: Arithmetic] = object
    x*: T
    y*: T
    z*: T

proc axisAll*(): array[3, Axis] {.inline.} =
  [axisY, axisX, axisZ]

proc axisHorizontal*(): array[2, Axis] {.inline.} =
  [axisX, axisZ]

proc axisExcluding*(axis: Axis): array[2, Axis] =
  case axis
  of axisX: [axisY, axisZ]
  of axisY: [axisX, axisZ]
  of axisZ: [axisX, axisY]

proc vec3*[T: Arithmetic](x, y, z: T): Vector3[T] {.inline.} =
  Vector3[T](x: x, y: y, z: z)

proc getAxis*[T: Arithmetic](v: Vector3[T], a: Axis): T {.inline.} =
  case a
  of axisX: v.x
  of axisY: v.y
  of axisZ: v.z

proc setAxis*[T: Arithmetic](v: var Vector3[T], a: Axis, value: T) {.inline.} =
  case a
  of axisX: v.x = value
  of axisY: v.y = value
  of axisZ: v.z = value

proc lengthSquared*[T: Arithmetic](v: Vector3[T]): T {.inline.} =
  v.x * v.x + v.y * v.y + v.z * v.z

proc horizontalLengthSquared*[T: Arithmetic](v: Vector3[T]): T {.inline.} =
  v.x * v.x + v.z * v.z

proc add*[T: Arithmetic](a, b: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)

proc addRaw*[T: Arithmetic](v: Vector3[T], x, y, z: T): Vector3[T] {.inline.} =
  Vector3[T](x: v.x + x, y: v.y + y, z: v.z + z)

proc sub*[T: Arithmetic](a, b: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)

proc subRaw*[T: Arithmetic](v: Vector3[T], x, y, z: T): Vector3[T] {.inline.} =
  Vector3[T](x: v.x - x, y: v.y - y, z: v.z - z)

proc multiply*[T: Arithmetic](v: Vector3[T], x, y, z: T): Vector3[T] {.inline.} =
  Vector3[T](x: v.x * x, y: v.y * y, z: v.z * z)

proc lerp*[T: Arithmetic](a, b: Vector3[T], t: T): Vector3[T] =
  Vector3[T](
    x: a.x + (b.x - a.x) * t,
    y: a.y + (b.y - a.y) * t,
    z: a.z + (b.z - a.z) * t,
  )

proc squaredDistanceTo*[T: Arithmetic](v: Vector3[T], x, y, z: T): T =
  let dx = v.x - x
  let dy = v.y - y
  let dz = v.z - z
  dx * dx + dy * dy + dz * dz

proc squaredDistanceToVec*[T: Arithmetic](a, b: Vector3[T]): T {.inline.} =
  squaredDistanceTo(a, b.x, b.y, b.z)

proc squaredDistanceToXz*[T: Arithmetic](v: Vector3[T], x, z: T): T =
  let dx = v.x - x
  let dz = v.z - z
  dx * dx + dz * dz

proc squaredDistanceToVecXz*[T: Arithmetic](a, b: Vector3[T]): T {.inline.} =
  squaredDistanceToXz(a, b.x, b.z)

proc dot*[T: Arithmetic](a, b: Vector3[T]): T {.inline.} =
  a.x * b.x + a.y * b.y + a.z * b.z

proc cross*[T: Arithmetic](a, b: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](
    x: a.y * b.z - a.z * b.y,
    y: a.z * b.x - a.x * b.z,
    z: a.x * b.y - a.y * b.x,
  )

proc `*`*[T: Arithmetic](v: Vector3[T], scalar: T): Vector3[T] {.inline.} =
  Vector3[T](x: v.x * scalar, y: v.y * scalar, z: v.z * scalar)

proc `/`*[T: Arithmetic](v: Vector3[T], scalar: T): Vector3[T] {.inline.} =
  Vector3[T](x: v.x / scalar, y: v.y / scalar, z: v.z / scalar)

proc `+`*[T: Arithmetic](a, b: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)

proc `-`*[T: Arithmetic](a, b: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)

proc `+=`*[T: Arithmetic](a: var Vector3[T], b: Vector3[T]) {.inline.} =
  a.x = a.x + b.x
  a.y = a.y + b.y
  a.z = a.z + b.z

proc `-`*[T: Arithmetic](v: Vector3[T]): Vector3[T] {.inline.} =
  Vector3[T](x: -v.x, y: -v.y, z: -v.z)

# --- float-only methods ------------------------------------------------

proc length*(v: Vector3[float32]): float32 {.inline.} =
  sqrt(lengthSquared(v))

proc length*(v: Vector3[float64]): float64 {.inline.} =
  sqrt(lengthSquared(v))

proc horizontalLength*(v: Vector3[float32]): float32 {.inline.} =
  sqrt(horizontalLengthSquared(v))

proc horizontalLength*(v: Vector3[float64]): float64 {.inline.} =
  sqrt(horizontalLengthSquared(v))

proc normalize*(v: Vector3[float32]): Vector3[float32] =
  let r = 1'f32 / length(v)
  if not isNaN(r) and r != Inf and r != -Inf and r > 0'f32:
    Vector3[float32](x: v.x * r, y: v.y * r, z: v.z * r)
  else:
    Vector3[float32](x: 0, y: 0, z: 0)

proc normalize*(v: Vector3[float64]): Vector3[float64] =
  let r = 1'f64 / length(v)
  if not isNaN(r) and r != Inf and r != -Inf and r > 0'f64:
    Vector3[float64](x: v.x * r, y: v.y * r, z: v.z * r)
  else:
    Vector3[float64](x: 0, y: 0, z: 0)

proc rotationVector*(pitch, yaw: float64): Vector3[float64] =
  let h = degToRad(pitch)
  let i = degToRad(-yaw)
  let l = cos(h)
  Vector3[float64](x: sin(i) * l, y: -sin(h), z: cos(i) * l)

proc fromYawPitch*(yaw, pitch: float32): Vector3[float64] =
  let yawRad = degToRad(float64(yaw))
  let pitchRad = degToRad(float64(pitch))
  let cosPitch = cos(pitchRad)
  let sinPitch = sin(pitchRad)
  let cosYaw = cos(yawRad)
  let sinYaw = sin(yawRad)
  Vector3[float64](x: -cosPitch * sinYaw, y: -sinPitch, z: cosPitch * cosYaw)

proc sign*[T: Arithmetic](v: Vector3[T]): Vector3[int32] =
  ## -1, 0 or 1 per component. NaN compares neither way and gives 0.
  let zero = default(T)
  Vector3[int32](
    x: if v.x > zero: 1'i32 elif v.x < zero: -1'i32 else: 0'i32,
    y: if v.y > zero: 1'i32 elif v.y < zero: -1'i32 else: 0'i32,
    z: if v.z > zero: 1'i32 elif v.z < zero: -1'i32 else: 0'i32)

proc isWithinBounds*[T: Arithmetic](v, blockPos: Vector3[T], x, y, z: T): bool =
  ## Whether `v` is within a cuboid centred on `blockPos`.
  let minX = blockPos.x - x
  let maxX = blockPos.x + x
  let minY = blockPos.y - y
  let maxY = blockPos.y + y
  let minZ = blockPos.z - z
  let maxZ = blockPos.z + z
  v.x >= minX and v.x <= maxX and v.y >= minY and v.y <= maxY and v.z >= minZ and v.z <= maxZ

proc `==`*[T: Arithmetic](a, b: Vector3[T]): bool {.inline.} =
  a.x == b.x and a.y == b.y and a.z == b.z

proc hash*[T: Arithmetic](v: Vector3[T]): Hash =
  !$(hash(v.x) !& hash(v.y) !& hash(v.z))

proc toVector3*[T: Arithmetic](t: (T, T, T)): Vector3[T] {.inline.} =
  ## `From<(T, T, T)>`.
  Vector3[T](x: t[0], y: t[1], z: t[2])

proc toTuple*[T: Arithmetic](v: Vector3[T]): (T, T, T) {.inline.} =
  ## `From<Vector3<T>> for (T, T, T)`.
  (v.x, v.y, v.z)

proc toVector2*[T: Arithmetic](v: Vector3[T]): Vector2[T] {.inline.} =
  ## `From<Vector3<T>> for Vector2<T>`: keeps x and z.
  Vector2[T](x: v.x, y: v.z)

proc toF32Lossy*(v: Vector3[float64]): Vector3[float32] =
  Vector3[float32](x: float32(v.x), y: float32(v.y), z: float32(v.z))

proc toF64*[T: Arithmetic](v: Vector3[T]): Vector3[float64] =
  Vector3[float64](x: float64(v.x), y: float64(v.y), z: float64(v.z))

proc toF32*[T: Arithmetic](v: Vector3[T]): Vector3[float32] =
  Vector3[float32](x: float32(v.x), y: float32(v.y), z: float32(v.z))

proc toI32*[T: Arithmetic](v: Vector3[T]): Vector3[int32] =
  ## Rounds each component, half away from zero.
  Vector3[int32](x: asI32(round(float64(v.x))), y: asI32(round(float64(v.y))), z: asI32(round(float64(v.z))))

proc toVec2I32*[T: Arithmetic](v: Vector3[T]): Vector2[int32] =
  Vector2[int32](x: asI32(round(float64(v.x))), y: asI32(round(float64(v.z))))

proc floorToI32*[T: Arithmetic](v: Vector3[T]): Vector3[int32] =
  Vector3[int32](x: asI32(floor(float64(v.x))), y: asI32(floor(float64(v.y))), z: asI32(floor(float64(v.z))))

proc floorToVec2I32*[T: Arithmetic](v: Vector3[T]): Vector2[int32] =
  Vector2[int32](x: asI32(floor(float64(v.x))), y: asI32(floor(float64(v.z))))

# --- vector_codec_impl! -----------------------------------------------------------------------------

proc toSeq*[T: Arithmetic](v: Vector3[T]): seq[T] =
  ## `From<&Vector3<T>> for Vec<T>`.
  @[v.x, v.y, v.z]

proc flatTryFrom*[T: Arithmetic](target: typedesc[Vector3[T]], value: seq[T]): DataResult[Vector3[T]] =
  let d = validateFixedSize(value, 3)
  if not d.hasResultOrPartial:
    return propagateError[seq[T], Vector3[T]](d)
  let v = d.valueOrPartial
  flatMapJoin(d, newSuccess(Vector3[T](x: v[0], y: v[1], z: v[2])))

proc encode*[T: Arithmetic, V](x: Vector3[T], ops: DynamicOps[V], prefix: V): DataResult[V] =
  encode(toSeq(x), ops, prefix)

proc decode*[T: Arithmetic, V](t: typedesc[Vector3[T]], input: V, ops: DynamicOps[V]): DataResult[(Vector3[T], V)] =
  let d = decode(seq[T], input, ops)
  if not d.hasResultOrPartial:
    return propagateError[(seq[T], V), (Vector3[T], V)](d)
  let pair = d.valueOrPartial
  flatMapJoin(d, withRemainder(flatTryFrom(Vector3[T], pair[0]), pair[1]))

# --- serde: Serialize is big-endian bytes, Deserialize is a sequence of three numbers ----------------

proc toBytes*(v: Vector3[float32]): seq[byte] =
  result = @[]
  result.putBe cast[uint32](v.x)
  result.putBe cast[uint32](v.y)
  result.putBe cast[uint32](v.z)

proc toBytes*(v: Vector3[float64]): seq[byte] =
  result = @[]
  result.putBe cast[uint64](v.x)
  result.putBe cast[uint64](v.y)
  result.putBe cast[uint64](v.z)

proc toBytes*(v: Vector3[int16]): seq[byte] =
  result = @[]
  result.putBe cast[uint16](v.x)
  result.putBe cast[uint16](v.y)
  result.putBe cast[uint16](v.z)

proc toBytes*(v: Vector3[int32]): seq[byte] =
  result = @[]
  result.putBe cast[uint32](v.x)
  result.putBe cast[uint32](v.y)
  result.putBe cast[uint32](v.z)

proc toJson*(v: Vector3[float32]): JsonValue = bytesToJson(toBytes(v))
proc toJson*(v: Vector3[float64]): JsonValue = bytesToJson(toBytes(v))
proc toJson*(v: Vector3[int16]): JsonValue = bytesToJson(toBytes(v))
proc toJson*(v: Vector3[int32]): JsonValue = bytesToJson(toBytes(v))

proc toNbt*(v: Vector3[float32]): NbtTag = bytesToNbt(toBytes(v))
proc toNbt*(v: Vector3[float64]): NbtTag = bytesToNbt(toBytes(v))
proc toNbt*(v: Vector3[int16]): NbtTag = bytesToNbt(toBytes(v))
proc toNbt*(v: Vector3[int32]): NbtTag = bytesToNbt(toBytes(v))

proc jsonThree(j: JsonValue, expecting, failed: string): (string, seq[JsonValue]) =
  ## The array behind a three-number visitor, or the error text.
  if j.kind != jvArray:
    return (invalidType(j, expecting), @[])
  if j.items.len < 3:
    return (failed, @[])
  if j.items.len > 3:
    return ("invalid length " & $j.items.len & ", expected fewer elements in array", @[])
  ("", j.items)

proc nbtThree(tag: NbtTag, expecting, failed: string): (string, seq[NbtTag]) =
  let (isSeq, items) = nbtElements(tag)
  if not isSeq:
    return ("invalid type: expected " & expecting, @[])
  if items.len < 3:
    return (failed, @[])
  if items.len > 3:
    return ("invalid length " & $items.len & ", expected fewer elements in array", @[])
  ("", items)

proc fromJson*(t: typedesc[Vector3[int32]], j: JsonValue): SerdeResult[Vector3[int32]] =
  let (err, e) = jsonThree(j, "a valid Vector<i32>", "Failed to read Vector<i32>")
  if err.len > 0: return serdeErr[Vector3[int32]](err)
  let x = readI32(e[0])
  serdeCheck(x, Vector3[int32])
  let y = readI32(e[1])
  serdeCheck(y, Vector3[int32])
  let z = readI32(e[2])
  serdeCheck(z, Vector3[int32])
  serdeOk(Vector3[int32](x: x.value, y: y.value, z: z.value))

proc fromJson*(t: typedesc[Vector3[float32]], j: JsonValue): SerdeResult[Vector3[float32]] =
  let (err, e) = jsonThree(j, "a valid Vector<32>", "Failed to read Vector<f32>")
  if err.len > 0: return serdeErr[Vector3[float32]](err)
  let x = readF32(e[0])
  serdeCheck(x, Vector3[float32])
  let y = readF32(e[1])
  serdeCheck(y, Vector3[float32])
  let z = readF32(e[2])
  serdeCheck(z, Vector3[float32])
  serdeOk(Vector3[float32](x: x.value, y: y.value, z: z.value))

proc fromJson*(t: typedesc[Vector3[float64]], j: JsonValue): SerdeResult[Vector3[float64]] =
  let (err, e) = jsonThree(j, "a valid Vector<f64>", "Failed to read Vector<f64>")
  if err.len > 0: return serdeErr[Vector3[float64]](err)
  let x = readF64(e[0])
  serdeCheck(x, Vector3[float64])
  let y = readF64(e[1])
  serdeCheck(y, Vector3[float64])
  let z = readF64(e[2])
  serdeCheck(z, Vector3[float64])
  serdeOk(Vector3[float64](x: x.value, y: y.value, z: z.value))

proc fromNbt*(t: typedesc[Vector3[int32]], tag: NbtTag): SerdeResult[Vector3[int32]] =
  let (err, e) = nbtThree(tag, "a valid Vector<i32>", "Failed to read Vector<i32>")
  if err.len > 0: return serdeErr[Vector3[int32]](err)
  let x = nbtReadI32(e[0])
  serdeCheck(x, Vector3[int32])
  let y = nbtReadI32(e[1])
  serdeCheck(y, Vector3[int32])
  let z = nbtReadI32(e[2])
  serdeCheck(z, Vector3[int32])
  serdeOk(Vector3[int32](x: x.value, y: y.value, z: z.value))

proc fromNbt*(t: typedesc[Vector3[float32]], tag: NbtTag): SerdeResult[Vector3[float32]] =
  let (err, e) = nbtThree(tag, "a valid Vector<32>", "Failed to read Vector<f32>")
  if err.len > 0: return serdeErr[Vector3[float32]](err)
  let x = nbtReadF32(e[0])
  serdeCheck(x, Vector3[float32])
  let y = nbtReadF32(e[1])
  serdeCheck(y, Vector3[float32])
  let z = nbtReadF32(e[2])
  serdeCheck(z, Vector3[float32])
  serdeOk(Vector3[float32](x: x.value, y: y.value, z: z.value))

proc fromNbt*(t: typedesc[Vector3[float64]], tag: NbtTag): SerdeResult[Vector3[float64]] =
  let (err, e) = nbtThree(tag, "a valid Vector<f64>", "Failed to read Vector<f64>")
  if err.len > 0: return serdeErr[Vector3[float64]](err)
  let x = nbtReadF64(e[0])
  serdeCheck(x, Vector3[float64])
  let y = nbtReadF64(e[1])
  serdeCheck(y, Vector3[float64])
  let z = nbtReadF64(e[2])
  serdeCheck(z, Vector3[float64])
  serdeOk(Vector3[float64](x: x.value, y: y.value, z: z.value))

# --- chunk-position packing (Vector3[int32] only) -----------------------

proc packedChunkPos*(v: Vector3[int32]): int64 =
  (int64(v.x) and 0x03FF_FFFF'i64) shl 42 or
    (int64(v.z) and 0x003F_FFFF'i64) shl 20 or
    (int64(v.y) and 0xFFFFF'i64)

proc unpackedChunkPos*(packed: int64): Vector3[int32] =
  let x = int32(packed shr 42)
  let y = int32((packed shl 44) shr 44)
  let z = int32((packed shl 22) shr 42)
  Vector3[int32](x: x, y: y, z: z)

proc packedLocal*(v: Vector3[int32]): int16 =
  ## Bits 8-15: X, bits 4-7: Z, bits 0-3: Y. `as i16` keeps the low 16 bits.
  let x = cast[int16](cast[uint32](v.x) and 0xFFFF'u32)
  let y = cast[int16](cast[uint32](v.y) and 0xFFFF'u32)
  let z = cast[int16](cast[uint32](v.z) and 0xFFFF'u32)
  (x shl 8) or (z shl 4) or y
