## Port of pumpkin-util/src/math/vertical_surface_type.rs
## Complete as upstream has it: pumpkin-util/src/math/vertical_surface_type.rs only deserializes (JSON); it has no NBT form or serializer.

import ../codecs/json_value
import math/serdeforms

type
  VerticalSurfaceType* = enum
    ## Upward-facing surface (top of a block/space): ceiling collisions,
    ## hanging placement.
    vstCeiling
    ## Downward-facing surface (bottom of a block/space): ground collisions,
    ## standing placement.
    vstFloor

proc fromJson*(t: typedesc[VerticalSurfaceType], j: JsonValue): SerdeResult[VerticalSurfaceType] =
  ## `#[serde(rename_all = "snake_case")]`.
  if j.kind != jvString:
    return serdeErr[VerticalSurfaceType](invalidType(j, "enum VerticalSurfaceType"))
  if j.strVal == "ceiling":
    serdeOk(vstCeiling)
  elif j.strVal == "floor":
    serdeOk(vstFloor)
  else:
    serdeErr[VerticalSurfaceType]("unknown variant `" & j.strVal & "`, expected `ceiling` or `floor`")
