## Known-answer tests for vertical_surface_type.aowl.
import std/[assertions, syncio]
import vertical_surface_type
import math/serdeforms
import ../codecs/json_value

proc main() =
  let c = fromJson(VerticalSurfaceType, jsonString("ceiling"))
  assert c.ok and c.value == vstCeiling
  let f = fromJson(VerticalSurfaceType, jsonString("floor"))
  assert f.ok and f.value == vstFloor
  let bad = fromJson(VerticalSurfaceType, jsonString("Floor"))
  assert not bad.ok and bad.error == "unknown variant `Floor`, expected `ceiling` or `floor`"
  assert not fromJson(VerticalSurfaceType, jsonInt(1'i64)).ok

main()
echo "vertical_surface_type checks passed"
