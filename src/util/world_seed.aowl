## Port of pumpkin-util/src/world_seed.rs

import ../codecs/json_value
import ../codecs/data_result
import serde_forms
import legacy_rand
import math/mathmod
import random/random

type
  Seed* = object
    value*: uint64

proc utf8WhitespaceLenAt(text: string, i: int): int =
  ## Length in bytes of the Unicode `White_Space` char at `i`, or 0.
  let c = uint8(ord(text[i]))
  if c == 0x20'u8 or (c >= 0x09'u8 and c <= 0x0D'u8):
    return 1
  if c == 0xC2'u8 and i + 1 < text.len:
    let d = uint8(ord(text[i + 1]))
    if d == 0x85'u8 or d == 0xA0'u8: return 2
  if i + 2 < text.len:
    let d = uint8(ord(text[i + 1]))
    let e = uint8(ord(text[i + 2]))
    if c == 0xE1'u8 and d == 0x9A'u8 and e == 0x80'u8: return 3
    if c == 0xE2'u8 and d == 0x80'u8:
      if (e >= 0x80'u8 and e <= 0x8A'u8) or e == 0xA8'u8 or e == 0xA9'u8 or e == 0xAF'u8: return 3
    if c == 0xE2'u8 and d == 0x81'u8 and e == 0x9F'u8: return 3
    if c == 0xE3'u8 and d == 0x80'u8 and e == 0x80'u8: return 3
  0

proc trimRust(text: string): string =
  ## `str::trim`.
  var start = 0
  while start < text.len:
    let n = utf8WhitespaceLenAt(text, start)
    if n == 0: break
    start += n
  var stop = text.len
  while stop > start:
    # back up to the lead byte of the last char
    var lead = stop - 1
    while lead > start and (uint8(ord(text[lead])) and 0xC0'u8) == 0x80'u8:
      dec lead
    let n = utf8WhitespaceLenAt(text, lead)
    if n == 0 or lead + n != stop: break
    stop = lead
  text[start ..< stop]

proc seedFrom*(value: string): Seed =
  ## `impl From<&str> for Seed`: an integer, or the Java string hash, or random when blank.
  let trimmed = trimRust(value)
  if trimmed.len > 0:
    let (isNumber, number) = parseI64Exact(trimmed)
    let i64Value = if isNumber: number else: int64(mathmod.javaStringHash(trimmed))
    Seed(value: cast[uint64](i64Value))
  else:
    var rand = legacy_rand.fromSeed(getSeed())
    Seed(value: cast[uint64](nextI64(rand)))

proc toJson*(s: Seed): JsonValue =
  jsonString($cast[int64](s.value))

proc fromJson*(t: typedesc[Seed], v: JsonValue): DataResult[Seed] =
  let raw = readString(v)
  if not raw.isSuccess:
    return newError[Seed](raw.message)
  newSuccess(seedFrom(raw.successResult))
