## Known answers for world_seed.aowl. Upstream has no #[test] for this file. Hash values are Java's
## `String.hashCode`, sign extended then cast.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import world_seed

proc asI64(s: Seed): int64 = cast[int64](s.value)

# numbers parse as i64 then cast
assert seedFrom("12345").value == 12345'u64
assert asI64(seedFrom("-1")) == -1'i64
assert seedFrom("-1").value == 0xFFFFFFFFFFFFFFFF'u64
assert seedFrom("+5").value == 5'u64
assert asI64(seedFrom("9223372036854775807")) == 9223372036854775807'i64
assert seedFrom("-9223372036854775808").value == 0x8000000000000000'u64
assert seedFrom("  42\t\n").value == 42'u64

# anything else hashes
assert asI64(seedFrom("hello")) == 99162322'i64
assert asI64(seedFrom("polygenelubricants")) == -2147483648'i64
assert asI64(seedFrom("9223372036854775808")) == -1773151197'i64
assert asI64(seedFrom("1.5")) == 48568'i64
assert asI64(seedFrom(" abc def ")) == -1208318137'i64
assert asI64(seedFrom("-")) == 45'i64
assert asI64(seedFrom("+")) == 43'i64

# Unicode whitespace trims as Rust's does: NBSP, em space, ideographic space
assert seedFrom("\xC2\xA07\xE2\x80\x83").value == 7'u64
assert seedFrom("\xE3\x80\x808").value == 8'u64

# blank input draws a random seed
let a = seedFrom("")
let b = seedFrom("   ")
assert a.value != b.value

# serde: a string of the signed value, and From<&str> on the way back
assert toJsonString(toJson(seedFrom("-1"))) == "\"-1\""
assert toJsonString(toJson(Seed(value: 0x8000000000000000'u64))) == "\"-9223372036854775808\""
assert fromJson(Seed, jsonString("77")).successResult.value == 77'u64
assert asI64(fromJson(Seed, jsonString("hello")).successResult) == 99162322'i64
assert fromJson(Seed, jsonInt(1)).message == "invalid type: integer `1`, expected a string"

echo "world_seed checks passed"
