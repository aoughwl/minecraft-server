## Not in the pinned tree: pumpkin-util/src/random/ has no worldgen_random.rs at b7ccef5b2. This is a port of
## crates/pumpkin-util/src/random/worldgen_random.rs from the newer checkout in ../ref/pumpkin.
##
## A Xoroshiro source accessed through Java `WorldgenRandom` bit-source semantics: `next(bits)` takes the high
## bits of a complete underlying `nextLong()` draw, which differs from Xoroshiro's own direct methods.
## `RandomImpl::next_splitter` lives in random/random.aowl.

import xoroshiro128
import std/assertions
import std/options
import random/rustnum
import random/gaussian

type
  WorldgenRandom* = object
    source: Xoroshiro
    internalNextGaussian: Option[float64]

proc fromSeed*(seed: uint64): WorldgenRandom =
  WorldgenRandom(source: xoroshiro128.fromSeed(seed), internalNextGaussian: none[float64]())

proc next(r: var WorldgenRandom, bits: int): uint64 {.inline.} =
  nextBits(r.source, bits)

proc storedNextGaussian*(r: WorldgenRandom): Option[float64] =
  r.internalNextGaussian

proc setStoredNextGaussian*(r: var WorldgenRandom, value: Option[float64]) =
  r.internalNextGaussian = value

proc nextI32*(r: var WorldgenRandom): int32 =
  truncI32(next(r, 32))

proc nextBoundedI32*(r: var WorldgenRandom, bound: int32): int32 =
  assert bound > 0'i32, "bound must be positive"
  if (bound and (bound - 1'i32)) == 0'i32:
    return truncI32((int64(bound) * cast[int64](next(r, 31))) shr 31)
  while true:
    let value = truncI32(next(r, 31))
    let res = value mod bound
    if wrapAdd(wrapSub(value, res), bound - 1'i32) >= 0'i32:
      return res

proc nextInbetweenI32*(r: var WorldgenRandom, minV, maxV: int32): int32 =
  wrapAdd(nextBoundedI32(r, wrapAdd(wrapSub(maxV, minV), 1'i32)), minV)

proc nextInbetweenI32Exclusive*(r: var WorldgenRandom, minV, maxV: int32): int32 =
  wrapAdd(minV, nextBoundedI32(r, wrapSub(maxV, minV)))

proc nextI64*(r: var WorldgenRandom): int64 =
  let high = nextI32(r)
  let low = nextI32(r)
  wrapAdd(int64(high) shl 32, int64(low))

proc nextBool*(r: var WorldgenRandom): bool =
  next(r, 1) != 0'u64

proc nextF32*(r: var WorldgenRandom): float32 =
  float32(next(r, 24)) * 5.9604645e-8'f32

proc nextInbetweenF32*(r: var WorldgenRandom, minV, maxV: float32): float32 =
  nextF32(r) * (maxV - minV) + minV

proc nextF64*(r: var WorldgenRandom): float64 =
  let high = next(r, 26)
  let low = next(r, 27)
  float64((high shl 27) + low) * 1.1102230246251565e-16'f64

proc nextTriangular*(r: var WorldgenRandom, mode, deviation: float64): float64 =
  let a = nextF64(r)
  let b = nextF64(r)
  mode + deviation * (a - b)

proc nextGaussian*(r: var WorldgenRandom): float64 =
  calculateGaussian(r)

proc skip*(r: var WorldgenRandom, count: int32) =
  for i in 0'i32 ..< count:
    discard nextI64(r)

proc split*(r: var WorldgenRandom): WorldgenRandom =
  WorldgenRandom(source: xoroshiro128.split(r.source), internalNextGaussian: none[float64]())

proc newSplitter*(r: var WorldgenRandom): XoroshiroSplitter =
  ## The splitter of the underlying source, as upstream's `next_splitter` wraps.
  newSplitter(r.source)

proc getPopulationSeed*(worldSeed: uint64, blockX, blockZ: int32): uint64 =
  var rand = fromSeed(worldSeed)
  let l = nextI64(rand) or 1'i64
  let m = nextI64(rand) or 1'i64
  let base = wrapAdd(wrapMul(int64(blockX), l), wrapMul(int64(blockZ), m))
  cast[uint64](base) xor worldSeed

proc getDecoratorSeed*(populationSeed, index, step: uint64): uint64 =
  ## Upstream's in random/mod.rs; random/random.aowl re-exports this one.
  populationSeed + index + 10000'u64 * step
