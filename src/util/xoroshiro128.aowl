## Port of pumpkin-util/src/random/xoroshiro128.rs
##
## `RandomImpl::next_splitter` and the `RandomDeriverImpl` forms returning `RandomGenerator` live in
## random/random.aowl, which imports this file. `newSplitter` is upstream's inherent `next_splitter`, and the
## `split*` procs here return the concrete `Xoroshiro`, as upstream's inherent `split_string`/`split_pos` do.

import std/md5
import std/options
import random/rustnum
import random/gaussian
from legacy_rand import hashBlockPos

export hashBlockPos

type
  Xoroshiro* = object
    lo, hi: uint64
    internalNextGaussian: Option[float64]

  XoroshiroSplitter* = object
    lo*, hi*: uint64

proc mixStafford13*(z0: uint64): uint64 =
  var z = z0
  z = (z xor (z shr 30)) * 0xBF58476D1CE4E5B9'u64
  z = (z xor (z shr 27)) * 0x94D049BB133111EB'u64
  z xor (z shr 31)

proc mixU64(seed: uint64): (uint64, uint64) =
  let l = seed xor 0x6A09E667F3BCC909'u64
  let m = l + 0x9E3779B97F4A7C15'u64
  (l, m)

proc rotl(x: uint64, k: int): uint64 {.inline.} =
  (x shl k) or (x shr (64 - k))

proc newXoroshiro*(lo0, hi0: uint64): Xoroshiro =
  var lo = lo0
  var hi = hi0
  if (lo or hi) == 0'u64:
    lo = 0x9E3779B97F4A7C15'u64
    hi = 0x6A09E667F3BCC909'u64
  Xoroshiro(lo: lo, hi: hi, internalNextGaussian: none[float64]())

proc fromSeed*(seed: uint64): Xoroshiro =
  let (lo0, hi0) = mixU64(seed)
  newXoroshiro(mixStafford13(lo0), mixStafford13(hi0))

proc fromSeedUnmixed*(seed: uint64): Xoroshiro =
  let (lo0, hi0) = mixU64(seed)
  newXoroshiro(lo0, hi0)

proc nextRandom(r: var Xoroshiro): uint64 =
  let l = r.lo
  let m = r.hi
  let n = rotl(l + m, 17) + l
  let m2 = m xor l
  r.lo = rotl(l, 49) xor m2 xor (m2 shl 21)
  r.hi = rotl(m2, 28)
  n

proc nextBits*(r: var Xoroshiro, bits: int): uint64 {.inline.} =
  ## Upstream's `next`.
  nextRandom(r) shr (64 - bits)

proc storedNextGaussian*(r: Xoroshiro): Option[float64] =
  r.internalNextGaussian

proc setStoredNextGaussian*(r: var Xoroshiro, value: Option[float64]) =
  r.internalNextGaussian = value

proc nextI32*(r: var Xoroshiro): int32 =
  truncI32(nextRandom(r))

proc nextBoundedI32*(r: var Xoroshiro, bound: int32): int32 =
  let boundU = signExtendU64(bound)
  var l = signExtendU64(nextI32(r)) and 0xFFFF_FFFF'u64
  var m = l * boundU
  var n = m and 0xFFFF_FFFF'u64
  if n < boundU:
    # Upstream widens -bound to u64 with sign extension, so this is 2^64 mod bound where vanilla's
    # remainderUnsigned is 2^32 mod bound. Kept as upstream; see the bounded check in xoroshiro128test.aowl.
    let i = signExtendU64(wrapAdd(not bound, 1'i32)) mod boundU
    while n < i:
      l = signExtendU64(nextI32(r)) and 0xFFFF_FFFF'u64
      m = l * boundU
      n = m and 0xFFFF_FFFF'u64
  truncI32(m shr 32)

proc nextInbetweenI32*(r: var Xoroshiro, minV, maxV: int32): int32 =
  wrapAdd(nextBoundedI32(r, wrapAdd(wrapSub(maxV, minV), 1'i32)), minV)

proc nextInbetweenI32Exclusive*(r: var Xoroshiro, minV, maxV: int32): int32 =
  wrapAdd(minV, nextBoundedI32(r, wrapSub(maxV, minV)))

proc nextI64*(r: var Xoroshiro): int64 =
  cast[int64](nextRandom(r))

proc nextBool*(r: var Xoroshiro): bool =
  (nextRandom(r) and 1'u64) != 0'u64

proc nextF32*(r: var Xoroshiro): float32 =
  float32(nextBits(r, 24)) * 5.9604645e-8'f32

proc nextInbetweenF32*(r: var Xoroshiro, minV, maxV: float32): float32 =
  nextF32(r) * (maxV - minV) + minV

proc nextF64*(r: var Xoroshiro): float64 =
  # Upstream multiplies by an f32 constant widened to f64, not a full-precision f64 literal.
  float64(nextBits(r, 53)) * float64(1.110223e-16'f32)

proc nextTriangular*(r: var Xoroshiro, mode, deviation: float64): float64 =
  let a = nextF64(r)
  let b = nextF64(r)
  mode + deviation * (a - b)

proc nextGaussian*(r: var Xoroshiro): float64 =
  calculateGaussian(r)

proc skip*(r: var Xoroshiro, count: int32) =
  for i in 0'i32 ..< count:
    discard nextI64(r)

proc split*(r: var Xoroshiro): Xoroshiro =
  let lo = nextRandom(r)
  let hi = nextRandom(r)
  newXoroshiro(lo, hi)

proc newSplitter*(r: var Xoroshiro): XoroshiroSplitter =
  let lo = nextRandom(r)
  let hi = nextRandom(r)
  XoroshiroSplitter(lo: lo, hi: hi)

proc splitString*(s: XoroshiroSplitter, seed: string): Xoroshiro =
  let digest = toMD5(seed)
  var l: uint64 = 0
  var m: uint64 = 0
  for i in 0 ..< 8:
    l = (l shl 8) or uint64(digest[i])
  for i in 8 ..< 16:
    m = (m shl 8) or uint64(digest[i])
  newXoroshiro(l xor s.lo, m xor s.hi)

proc fromLoAndHi*(s: XoroshiroSplitter, lo, hi: uint64): Xoroshiro =
  newXoroshiro(lo xor s.lo, hi xor s.hi)

proc splitU64*(s: XoroshiroSplitter, seed: uint64): Xoroshiro =
  newXoroshiro(seed xor s.lo, seed xor s.hi)

proc splitPos*(s: XoroshiroSplitter, x, y, z: int32): Xoroshiro =
  let l = cast[uint64](hashBlockPos(x, y, z))
  newXoroshiro(l xor s.lo, s.hi)

proc getPopulationSeed*(worldSeed: uint64, blockX, blockZ: int32): uint64 =
  var rand = fromSeed(worldSeed)
  let l = nextI64(rand) or 1'i64
  let m = nextI64(rand) or 1'i64
  let base = wrapAdd(wrapMul(int64(blockX), l), wrapMul(int64(blockZ), m))
  cast[uint64](base) xor worldSeed
