## Every #[test] in pumpkin-util/src/random/xoroshiro128.rs, plus a known answer for the bounded retry path.

import std/syncio
import xoroshiro128
import random/random

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    quit(1)

block mixStafford13Test:
  let values = [
    (0'u64, 0'i64),
    (1'u64, 6238072747940578789'i64),
    (64'u64, -8456553050427055661'i64),
    (4096'u64, -1125827887270283392'i64),
    (262144'u64, -120227641678947436'i64),
    (16777216'u64, 6406066033425044679'i64),
    (1073741824'u64, 3143522559155490559'i64),
    (16'u64, -2773008118984693571'i64),
    (1024'u64, 8101005175654470197'i64),
    (65536'u64, -3551754741763842827'i64),
    (4194304'u64, -2737109459693184599'i64),
    (2'u64, -2606959012126976886'i64),
    (128'u64, -5825874238589581082'i64),
    (8192'u64, 1111983794319025228'i64),
    (524288'u64, -7964047577924347155'i64),
    (33554432'u64, -5634612006859462257'i64),
    (2147483648'u64, -1436547171018572641'i64),
    (137438953472'u64, -4514638798598940860'i64),
    (8796093022208'u64, -610572083552328405'i64),
    (562949953421312'u64, -263574021372026223'i64),
    (36028797018963968'u64, 7868130499179604987'i64),
    (253'u64, -4045451768301188906'i64),
    (127'u64, -6873224393826578139'i64),
    (8447'u64, 6670985465942597767'i64),
    (524543'u64, -6228499289678716485'i64),
    (33554687'u64, 2630391896919662492'i64),
    (2147483903'u64, -6879633228472053040'i64),
    (137438953727'u64, -5817997684975131823'i64),
    (8796093022463'u64, 2384436581894988729'i64),
    (562949953421567'u64, -5076179956679497213'i64),
    (36028797018964223'u64, -5993365784811617721'i64),
  ]
  for i in 0 ..< values.len:
    check(mixStafford13(values[i][0]) == cast[uint64](values[i][1]), "mix_stafford_13 " & $values[i][0])

block nextI32Test:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [-160476802'i32, 781697906, 653572596, 1337520923, -505875771,
                -47281585, 342195906, 1417498593, -1478887443, 1560080270]
  for v in values:
    check(x.nextI32() == v, "next_i32")

block nextBoundedI32Test:
  var x = xoroshiro128.fromSeed(0'u64)
  let small = [9'i32, 1, 1, 3, 8, 9, 0, 3, 6, 3]
  for v in small:
    check(x.nextBoundedI32(10'i32) == v, "next_bounded_i32(10)")
  let big = [9784805'i32, 470346, 13560642, 7320226, 14949645, 13460529, 2824352, 10938308, 14146127, 4549185]
  for v in big:
    check(x.nextBoundedI32(0xFFFFFF'i32) == v, "next_bounded_i32(0xFFFFFF)")

block nextBoundedRetryPath:
  # Not upstream's: from the Python oracle written from the Rust text, a bound large enough to hit the retry.
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [1550433936'i32, 293136714, 245089723, 501570346, 1420909322, 1592882142,
                128323464, 531561972, 1056029945, 585030101, 939341383, 1301821745]
  for v in values:
    check(x.nextBoundedI32(0x60000001'i32) == v, "next_bounded_i32(0x60000001)")

block nextBetweenI32:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [99'i32, 59, 57, 65, 94, 100, 54, 66, 83, 68]
  for v in values:
    check(x.nextInbetweenI32(50'i32, 100'i32) == v, "next_inbetween_i32")

block nextInbetweenExclusive:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [98'i32, 59, 57, 65, 94, 99, 53, 66, 82, 68]
  for v in values:
    check(x.nextInbetweenI32Exclusive(50'i32, 100'i32) == v, "next_inbetween_i32_exclusive")

block nextF64Test:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [0.16474369376959186, 0.7997457290026366, 0.2511961888876212, 0.11712489470639631,
                0.0997124786680137, 0.7566797430601416, 0.7723285712021574, 0.9420469457586381,
                0.48056202536813664, 0.6099690583914598]
  for v in values:
    check(x.nextF64() == v, "next_f64")

block nextF32Test:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [0.16474366'f32, 0.7997457'f32, 0.25119615'f32, 0.117124856'f32, 0.09971243'f32,
                0.7566797'f32, 0.77232856'f32, 0.94204694'f32, 0.48056197'f32, 0.609969'f32]
  for v in values:
    check(x.nextF32() == v, "next_f32")

block nextI64Test:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [3038984756725240190'i64, -3694039286755638414, 4633751808701151732, 2160572957309072155,
                1839370574944072389, -4488466507718817201, -4199796579929588030, -1069045159880208415,
                8864804693509535725, -7194800960680693874]
  for v in values:
    check(x.nextI64() == v, "next_i64")

block nextBoolTest:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [false, false, false, true, true, true, false, true, true, false]
  for v in values:
    check(x.nextBool() == v, "next_bool")

block nextGaussianTest:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [-0.48540690699780015, 0.43399227545320296, -0.3283265251019599, -0.5052497078202575,
                -0.3772512828630807, 0.2419080215945433, -0.42622066207565135, 2.411315261138953,
                -1.1419147030553274, -0.05849758093810378]
  for v in values:
    check(x.nextGaussian() == v, "next_gaussian")

block nextTriangularTest:
  var x = xoroshiro128.fromSeed(0'u64)
  let values = [6.824989823834776, 10.670356470906125, 6.71516367803936, 9.151408127217596,
                9.352964834883384, 8.291618967842293, 8.954549938640508, 11.833001837470519,
                10.65851306020791, 11.684676364031647]
  for v in values:
    check(x.nextTriangular(10.0, 5.0) == v, "next_triangular")

block splitTest:
  var x = xoroshiro128.fromSeed(0'u64)
  var newGenerator = xoroshiro128.split(x)
  check(newGenerator.nextI32() == 542195535'i32, "split")

  let splitter = newSplitter(newGenerator)
  var rand1 = splitter.splitString("TEST STRING")
  check(rand1.nextI32() == -641435713'i32, "split_string")
  var rand2 = splitter.splitU64(42069'u64)
  check(rand2.nextI32() == -340700677'i32, "split_u64")
  var rand3 = splitter.splitPos(1337'i32, 80085'i32, -69420'i32)
  check(rand3.nextI32() == 790449132'i32, "split_pos")

  check(x.nextI32() == 653572596'i32, "original not mutated")
  check(newGenerator.nextI32() == 435917842'i32, "new generator not mutated")

block intersection:
  var x = newXoroshiro(0'u64, 0'u64)
  check(x.nextI64() == 6807859099481836695'i64, "intersection")

echo "xoroshiro128: all upstream test vectors matched"
