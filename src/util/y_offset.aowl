## Port of pumpkin-util/src/y_offset.rs
##
## `Absolute`, `AboveBottom` and `BelowTop` upstream are one-field structs inside an untagged enum, so the
## case object holds their single field directly.

import ../codecs/json_value
import ../codecs/data_result
import serde_forms

type
  YOffsetKind* = enum
    yokAbsolute
    yokAboveBottom
    yokBelowTop

  YOffset* = object
    case kind*: YOffsetKind
    of yokAbsolute:
      absolute*: int16
    of yokAboveBottom:
      aboveBottom*: int8
    of yokBelowTop:
      belowTop*: int8

proc getY*(o: YOffset, minY: int16, height: uint16): int32 =
  case o.kind
  of yokAboveBottom:
    int32(minY) + int32(o.aboveBottom)
  of yokBelowTop:
    int32(height) - 1'i32 + int32(minY) - int32(o.belowTop)
  of yokAbsolute:
    int32(o.absolute)

proc fromJson*(t: typedesc[YOffset], v: JsonValue): DataResult[YOffset] =
  ## `#[serde(untagged)]`: the first variant whose struct reads wins, and other keys are ignored.
  let (hasAbsolute, absolute) = v.get("absolute")
  if hasAbsolute:
    let r = readSigned(absolute, -32768'i64, 32767'i64, "i16")
    if r.isSuccess:
      return newSuccess(YOffset(kind: yokAbsolute, absolute: int16(r.successResult)))
  let (hasAbove, above) = v.get("above_bottom")
  if hasAbove:
    let r = readSigned(above, -128'i64, 127'i64, "i8")
    if r.isSuccess:
      return newSuccess(YOffset(kind: yokAboveBottom, aboveBottom: int8(r.successResult)))
  let (hasBelow, below) = v.get("below_top")
  if hasBelow:
    let r = readSigned(below, -128'i64, 127'i64, "i8")
    if r.isSuccess:
      return newSuccess(YOffset(kind: yokBelowTop, belowTop: int8(r.successResult)))
  newError[YOffset]("data did not match any variant of untagged enum YOffset")
