## Known answers for y_offset.aowl. Upstream has no #[test] for this file.

import std/assertions
import std/syncio
import ../codecs/json_value
import ../codecs/data_result
import y_offset

proc parsed(text: string): DataResult[YOffset] =
  let o = parseJsonValue(text)
  assert o.ok
  fromJson(YOffset, o.value)

assert getY(YOffset(kind: yokAbsolute, absolute: 12), -64, 384) == 12
assert getY(YOffset(kind: yokAboveBottom, aboveBottom: 5), -64, 384) == -59
assert getY(YOffset(kind: yokBelowTop, belowTop: 5), -64, 384) == 314
assert getY(YOffset(kind: yokBelowTop, belowTop: -1), 0, 256) == 256

let a = parsed("""{"absolute": -3}""")
assert a.isSuccess and a.successResult.kind == yokAbsolute and a.successResult.absolute == -3
let b = parsed("""{"above_bottom": 8, "extra": true}""")
assert b.isSuccess and b.successResult.kind == yokAboveBottom and b.successResult.aboveBottom == 8
let c = parsed("""{"below_top": 127}""")
assert c.isSuccess and c.successResult.kind == yokBelowTop and c.successResult.belowTop == 127

# absolute out of range for i16 falls through to the next variant, as untagged does
let d = parsed("""{"absolute": 40000, "below_top": 1}""")
assert d.isSuccess and d.successResult.kind == yokBelowTop

let bad = parsed("""{"below_top": 128}""")
assert bad.message == "data did not match any variant of untagged enum YOffset"
assert not parsed("5").isSuccess
assert not parsed("""{"absolute": 1.5}""").isSuccess

echo "y_offset checks passed"
