## The Java Edition on-disk region file (.mca "Anvil") format: the 8 KiB location and timestamp
## header, per-chunk sector accounting, chunk payload framing and compression, and the file object
## that reads, updates and writes a region.
## Port of pumpkin-world/src/chunk/format/anvil.rs
##
## Upstream's `AnvilChunkFile<S>` is generic over the chunk type; `toSerializer` here gives the
## bytes-level `ChunkSerializer`, and filemanager.aowl parses the bytes into a chunk. No async: the
## `write_action` mutex is a plain field.

import std/[algorithm, times]
import ../nbt/nbtbase
import ../config/chunk as chunkconfig
import chunkdata, chunkio, chunkcompress, worldfs

const
  RegionSize* = 32                      ## one region is 32x32 chunks
  SubregionBits = 5'i32                 ## ceil_log2(32)
  SubregionAnd = (1'i32 shl SubregionBits) - 1
  ChunkCount* = RegionSize * RegionSize
  SectorBytes* = 4096
  NoCompressionId = 3'u8
  WorldDataVersion* = 4790  ## WORLD_DATA_VERSION, "26.1.2"

type
  CompressionKind* = enum
    ckGZip = 1
    ckZLib = 2
    ckLZ4 = 4
    ckCustom = 127

  CompressionByteKind* = enum
    cbInvalid    ## unrecognized byte
    cbNone       ## valid, explicitly "no compression"
    cbSome       ## valid, names a known compression method

  CompressionByteResult* = object
    ## Mirrors upstream's `Compression::from_byte -> Result<Option<Self>, ()>`:
    ## three outcomes, not two - a byte can name a known compression, name
    ## "no compression" (id 3, valid but not a `Compression` variant), or
    ## be an unrecognized id (an error).
    case kind*: CompressionByteKind
    of cbInvalid, cbNone: discard
    of cbSome: comp*: CompressionKind

proc compressionFromByte*(b: uint8): CompressionByteResult =
  case b
  of ord(ckGZip).uint8: CompressionByteResult(kind: cbSome, comp: ckGZip)
  of ord(ckZLib).uint8: CompressionByteResult(kind: cbSome, comp: ckZLib)
  of NoCompressionId: CompressionByteResult(kind: cbNone)
  of ord(ckLZ4).uint8: CompressionByteResult(kind: cbSome, comp: ckLZ4)
  of ord(ckCustom).uint8: CompressionByteResult(kind: cbSome, comp: ckCustom)
  else: CompressionByteResult(kind: cbInvalid)

proc compressionToByte*(r: CompressionByteResult): uint8 =
  case r.kind
  of cbNone: NoCompressionId
  of cbSome: ord(r.comp).uint8
  of cbInvalid: 0'u8 # caller error, not a valid encode input

# --- region/chunk-index math -------------------------------------------

proc floorShr(x: int32, bits: int32): int32 {.inline.} =
  ## Rust's `x >> SUBREGION_BITS` on a signed i32 is an arithmetic shift,
  ## which is floor division by a power of two (rounds toward -inf, not
  ## zero) - aowlmony's `shr` on a *signed* int is likewise arithmetic, so
  ## this is a direct port, spelled out because getting the rounding
  ## direction wrong here silently misfiles every chunk in a negative
  ## region coordinate.
  x shr bits

proc getRegionCoords*(chunkX, chunkZ: int32): (int32, int32) =
  let rx = floorShr(chunkX, SubregionBits)
  let rz = floorShr(chunkZ, SubregionBits)
  (rx, rz)

proc getChunkIndex*(chunkX, chunkZ: int32): int =
  ## Position of a chunk within its region's 32x32 grid, index into the
  ## 1024-entry location/timestamp tables.
  int((chunkX and SubregionAnd) + (chunkZ and SubregionAnd) * RegionSize.int32)

# --- per-chunk sector accounting ----------------------------------------

proc sectorCountFor*(compressedLen: int): uint32 =
  ## `raw_write_size` (4-byte length + 1-byte compression tag + payload),
  ## rounded up to whole 4 KiB sectors.
  let rawWriteSize = compressedLen + 4 + 1
  uint32((rawWriteSize + SectorBytes - 1) div SectorBytes)

proc paddedSizeFor*(compressedLen: int): int =
  int(sectorCountFor(compressedLen)) * SectorBytes

# --- location-table entry (u32 = (sectorOffset << 8) | sectorCount) -----

proc encodeLocation*(sectorOffset: uint32, sectorCount: uint8): uint32 {.inline.} =
  (sectorOffset shl 8) or sectorCount.uint32

proc decodeLocationOffset*(location: uint32): uint32 {.inline.} =
  location shr 8

proc decodeLocationCount*(location: uint32): uint8 {.inline.} =
  uint8(location and 0xFF'u32)

# --- 8 KiB region-file header (location table + timestamp table) --------

type
  RegionChunkEntry* = object
    present*: bool     ## false = this chunk slot is empty (location word 0)
    sectorOffset*: uint32
    sectorCount*: uint8
    timestamp*: uint32

proc readBE32(data: openArray[byte], pos: int): uint32 {.inline.} =
  (uint32(data[pos]) shl 24) or (uint32(data[pos+1]) shl 16) or
    (uint32(data[pos+2]) shl 8) or uint32(data[pos+3])

proc writeBE32(data: var seq[byte], pos: int, value: uint32) {.inline.} =
  data[pos] = uint8(value shr 24)
  data[pos+1] = uint8((value shr 16) and 0xFF'u32)
  data[pos+2] = uint8((value shr 8) and 0xFF'u32)
  data[pos+3] = uint8(value and 0xFF'u32)

proc parseRegionHeader*(headerBytes: openArray[byte]): NbtResult[seq[RegionChunkEntry]] =
  ## `headerBytes` must be exactly `2 * SectorBytes` (8192) bytes: the
  ## location table (1024 big-endian u32s) followed by the timestamp
  ## table (1024 big-endian u32s), per upstream's `AnvilChunkFile::read`.
  ## A zero sector offset or a zero count means absent.
  if headerBytes.len != 2 * SectorBytes:
    return errRes[seq[RegionChunkEntry]](
      nbtError(nekIncomplete, "region header must be exactly " & $(2 * SectorBytes) & " bytes"))
  var entries = newSeq[RegionChunkEntry](ChunkCount)
  for i in 0 ..< ChunkCount:
    let location = readBE32(headerBytes, i * 4)
    let timestamp = readBE32(headerBytes, SectorBytes + i * 4)
    let sectorCount = decodeLocationCount(location)
    let sectorOffset = decodeLocationOffset(location)
    if sectorOffset == 0'u32 or sectorCount == 0'u8:
      entries[i] = RegionChunkEntry(present: false)
    else:
      entries[i] = RegionChunkEntry(
        present: true, sectorOffset: sectorOffset, sectorCount: sectorCount, timestamp: timestamp)
  ok[seq[RegionChunkEntry]](entries)

proc buildRegionHeader*(entries: openArray[RegionChunkEntry]): NbtResult[seq[byte]] =
  if entries.len != ChunkCount:
    return errRes[seq[byte]](
      nbtError(nekIncomplete, "expected exactly " & $ChunkCount & " region entries"))
  var header = newSeq[byte](2 * SectorBytes)
  for i in 0 ..< ChunkCount:
    let e = entries[i]
    let location =
      if e.present: encodeLocation(e.sectorOffset, e.sectorCount)
      else: 0'u32
    writeBE32(header, i * 4, location)
    writeBE32(header, SectorBytes + i * 4, if e.present: e.timestamp else: 0'u32)
  ok[seq[byte]](header)

# --- per-chunk payload framing (length + compression tag + bytes) -------

type
  AnvilChunkPayload* = object
    compression*: CompressionByteResult
    data*: seq[byte]   ## the (still-compressed, if `compression.kind == cbSome`) payload bytes

proc framePayload*(p: AnvilChunkPayload): seq[byte] =
  ## `declaredLength` covers the compression byte plus the payload, per
  ## upstream's `AnvilChunkData::write` (`compressed_data.len() + 1`).
  let declaredLength = uint32(p.data.len + 1)
  result = newSeq[byte](4 + 1 + p.data.len)
  writeBE32(result, 0, declaredLength)
  result[4] = compressionToByte(p.compression)
  for i, b in p.data:
    result[5 + i] = b

proc unframePayload*(bytes: openArray[byte]): NbtResult[AnvilChunkPayload] =
  if bytes.len < 5:
    return errRes[AnvilChunkPayload](nbtError(nekIncomplete, "chunk payload shorter than its own header"))
  let declaredLength = readBE32(bytes, 0)
  if declaredLength == 0:
    return errRes[AnvilChunkPayload](
      nbtError(nekIncomplete, "chunk length does not cover its compression byte"))
  let length = int(declaredLength) - 1
  if length > bytes.len - 5:
    return errRes[AnvilChunkPayload](
      nbtError(nekIncomplete, "chunk length is greater than available bytes"))
  let compByte = bytes[4]
  let comp = compressionFromByte(compByte)
  if comp.kind == cbInvalid:
    return errRes[AnvilChunkPayload](unknownTagId(compByte))
  var data = newSeq[byte](length)
  for i in 0 ..< length:
    data[i] = bytes[5 + i]
  ok[AnvilChunkPayload](AnvilChunkPayload(compression: comp, data: data))

# --- Compression::{compress_data,decompress_data} ------------------------------

const Lz4CompressionLevelBase = 10

proc decompressData*(comp: CompressionKind, compressedData: openArray[byte]): (bool, seq[byte], CompressionError) =
  ## `Compression::decompress_data`
  let none = CompressionError(kind: ceUnknownCompression, msg: "")
  case comp
  of ckGZip:
    let r = gzipDecompressBytes(compressedData)
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceGZipError, msg: r.msg))
  of ckZLib:
    let r = zlibDecompress(compressedData)
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceZlibError, msg: r.msg))
  of ckLZ4:
    let r = lz4Decompress(compressedData)
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceLZ4Error, msg: r.msg))
  of ckCustom:
    (false, newSeq[byte](0), none)

proc compressData*(comp: CompressionKind, uncompressedData: openArray[byte],
                   compressionLevel: uint32): (bool, seq[byte], CompressionError) =
  ## `Compression::compress_data`
  let none = CompressionError(kind: ceUnknownCompression, msg: "")
  case comp
  of ckGZip:
    let r = gzipCompressBytes(uncompressedData, int(compressionLevel))
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceGZipError, msg: r.msg))
  of ckZLib:
    let r = zlibCompress(uncompressedData, int(compressionLevel))
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceZlibError, msg: r.msg))
  of ckLZ4:
    let blockSize = 1 shl (Lz4CompressionLevelBase + int(compressionLevel))
    let r = lz4Compress(uncompressedData, blockSize)
    if r.ok: (true, r.data, none) else: (false, newSeq[byte](0), CompressionError(kind: ceLZ4Error, msg: r.msg))
  of ckCustom:
    (false, newSeq[byte](0), none)

proc compressionFromConfig*(c: chunkconfig.Compression): CompressionKind =
  ## `impl From<pumpkin_config::chunk::Compression> for Compression`
  case c
  of compGZip: ckGZip
  of compZLib: ckZLib
  of compLZ4: ckLZ4
  of compCustom: ckCustom

# --- AnvilChunkData ------------------------------------------------------------

type
  AnvilChunkData* = AnvilChunkPayload

proc sectorCount*(d: AnvilChunkData): uint32 {.inline.} =
  ## `AnvilChunkData::sector_count`
  sectorCountFor(d.data.len)

proc writePadded(d: AnvilChunkData, o: var seq[byte]) =
  ## `AnvilChunkData::write`: frame plus zero padding to the sector boundary.
  let start = o.len
  let frame = framePayload(d)
  o.setLen(start + paddedSizeFor(d.data.len))
  for i in 0 ..< frame.len:
    o[start + i] = frame[i]

proc toChunkBytes*(d: AnvilChunkData): (bool, seq[byte], ChunkReadingError) =
  ## `AnvilChunkData::to_chunk`, up to the point `S::from_bytes` takes over.
  if d.compression.kind == cbSome:
    let (ok, raw, e) = decompressData(d.compression.comp, d.data)
    if not ok:
      return (false, newSeq[byte](0), readErr(creCompression, $e.kind & " " & e.msg))
    (true, raw, readErr(creIoError))
  else:
    (true, d.data, readErr(creIoError))

proc fromChunkBytes*(raw: openArray[byte], compression: CompressionByteResult,
                     cfg: AnvilChunkConfig): (bool, AnvilChunkData, ChunkWritingError) =
  ## `AnvilChunkData::from_chunk`
  let kind = if compression.kind == cbSome: compression.comp
             else: compressionFromConfig(cfg.compression.algorithm)
  let (ok, compressed, e) = compressData(kind, raw, cfg.compression.level)
  let empty = AnvilChunkPayload(compression: CompressionByteResult(kind: cbNone), data: @[])
  if not ok:
    return (false, empty, writeErr(cweCompression, $e.kind & " " & e.msg))
  (true, AnvilChunkPayload(compression: CompressionByteResult(kind: cbSome, comp: kind), data: compressed),
    writeErr(cweIoError))

# --- AnvilChunkFile ------------------------------------------------------------

type
  WriteActionKind = enum
    waPass   ## Don't write anything
    waAll    ## Write the entire file
    waParts  ## Only write certain indices

  AnvilChunkMetadata* = object
    present*: bool
    serializedData*: AnvilChunkData
    timestamp*: uint32
    fileSectorOffset*: uint32

  AnvilChunkFile* = ref object
    chunksData*: seq[AnvilChunkMetadata]
    endSector*: uint32
    writeAction: WriteActionKind
    writeParts: seq[int]

proc newAnvilChunkFile*(): AnvilChunkFile =
  ## `impl Default for AnvilChunkFile`
  AnvilChunkFile(chunksData: newSeq[AnvilChunkMetadata](ChunkCount), endSector: 2'u32,
    writeAction: waPass, writeParts: @[])

proc cmpInt64(a, b: int64): int =
  if a < b: -1
  elif a > b: 1
  else: 0

proc maybeUpdateChunkIndex(f: AnvilChunkFile, index: int) =
  ## `WriteAction::maybe_update_chunk_index`
  case f.writeAction
  of waPass:
    f.writeAction = waParts
    f.writeParts = @[index]
  of waParts:
    var found = false
    for p in f.writeParts:
      if p == index:
        found = true
    if not found:
      f.writeParts.add(index)
  of waAll:
    discard

proc putU32(o: var seq[byte], v: uint32) =
  o.add(uint8(v shr 24))
  o.add(uint8((v shr 16) and 0xFF'u32))
  o.add(uint8((v shr 8) and 0xFF'u32))
  o.add(uint8(v and 0xFF'u32))

proc buildHeader(f: AnvilChunkFile, assignSectors: bool): seq[byte] =
  result = newSeq[byte](0)
  var currentSector = 2'u32
  for m in f.chunksData:
    if m.present:
      let count = sectorCount(m.serializedData)
      if assignSectors:
        putU32(result, (currentSector shl 8) or count)
        currentSector += count
      else:
        putU32(result, (m.fileSectorOffset shl 8) or count)
    else:
      putU32(result, 0'u32)
  for m in f.chunksData:
    putU32(result, if m.present: m.timestamp else: 0'u32)

proc writeIndices(f: AnvilChunkFile, path: string, indices: openArray[int]): IoStatus =
  ## `AnvilChunkFile::write_indices`
  var keys = newSeq[int64](0)
  for index in indices:
    keys.add(int64(f.chunksData[index].fileSectorOffset) * 2048'i64 + int64(index))
  sort(keys, cmpInt64)  # stable by offset, then index
  var patches = @[FilePatch(offset: 0'i64, data: buildHeader(f, false))]
  for k in keys:
    let index = int(k mod 2048'i64)
    let m = f.chunksData[index]
    var body = newSeq[byte](0)
    writePadded(m.serializedData, body)
    patches.add(FilePatch(offset: int64(m.fileSectorOffset) * int64(SectorBytes), data: body))
  if not writePatches(path, patches):
    return ioErr("could not write " & path)
  ioOk()

proc withExtensionTmp*(path: string): string =
  ## `path.with_extension("tmp")`
  var i = path.len - 1
  while i >= 0:
    if path[i] == '.':
      return path[0 ..< i] & ".tmp"
    if path[i] == '/' or path[i] == '\\':
      break
    dec i
  path & ".tmp"

proc writeAll(f: AnvilChunkFile, path: string): IoStatus =
  ## `AnvilChunkFile::write_all`
  let tempPath = withExtensionTmp(path)
  var o = buildHeader(f, true)
  for m in f.chunksData:
    if m.present:
      writePadded(m.serializedData, o)
  if not writeFileBytes(tempPath, o):
    return ioErr("could not write " & tempPath)
  if not renameReplace(tempPath, path):
    return ioErr("could not rename " & tempPath)
  ioOk()

proc writeRegion*(f: AnvilChunkFile, path: string): IoStatus =
  ## `<AnvilChunkFile as ChunkSerializer>::write`
  var res = ioOk()
  case f.writeAction
  of waPass:
    discard
  of waAll:
    res = writeAll(f, path)
  of waParts:
    res = writeIndices(f, path, f.writeParts)
  if res.ok:
    f.writeAction = waPass
    f.writeParts = @[]
  res

proc readRegion*(r: seq[byte]): (bool, AnvilChunkFile, ChunkReadingError) =
  ## `<AnvilChunkFile as ChunkSerializer>::read`
  let chunkFile = newAnvilChunkFile()
  if r.len < SectorBytes * 2:
    return (false, chunkFile, readErr(creInvalidHeader))
  var lastOffset = 2
  for i in 0 ..< ChunkCount:
    let timestamp = readBE32(r, SectorBytes + i * 4)
    let location = readBE32(r, i * 4)
    let sectorCnt = int(location and 0xFF'u32)
    let sectorOffset = int(location shr 8)
    let endOffset = sectorOffset + sectorCnt
    if sectorOffset == 0 or sectorCnt == 0:
      continue
    if endOffset > lastOffset:
      lastOffset = endOffset
    let bytesOffset = sectorOffset * SectorBytes
    let bytesCount = sectorCnt * SectorBytes
    if sectorOffset < 2 or bytesOffset + bytesCount > r.len:
      return (false, chunkFile, readErr(creParsingError,
        "Not enough bytes available for the chunk " & $i))
    let payload = unframePayload(toOpenArray(r, bytesOffset, bytesOffset + bytesCount - 1))
    if not payload.isOk:
      let kind = if payload.error.kind == nekUnknownTagId: creCompression else: creParsingError
      return (false, chunkFile, readErr(kind, payload.error.msg))
    chunkFile.chunksData[i] = AnvilChunkMetadata(present: true, serializedData: payload.value,
      timestamp: timestamp, fileSectorOffset: uint32(sectorOffset))
  chunkFile.endSector = uint32(lastOffset)
  (true, chunkFile, readErr(creIoError))

proc nowEpoch(): uint32 =
  uint32(getTime().toUnix())

proc updateChunkBytes*(f: AnvilChunkFile, x, z: int32, raw: openArray[byte],
                       cfg: AnvilChunkConfig): ChunkWriteStatus =
  ## `<AnvilChunkFile as ChunkSerializer>::update_chunk`
  let epoch = nowEpoch()
  let index = getChunkIndex(x, z)
  # Default to the compression type read from the file.
  let compressionType =
    if f.chunksData[index].present: f.chunksData[index].serializedData.compression
    else: CompressionByteResult(kind: cbNone)
  let (ok, newChunkData, err) = fromChunkBytes(raw, compressionType, cfg)
  if not ok:
    return ChunkWriteStatus(ok: false, error: err)

  if not cfg.writeInPlace:
    f.writeAction = waAll

  if f.writeAction == waAll:
    f.chunksData[index] = AnvilChunkMetadata(present: true, serializedData: newChunkData,
      timestamp: epoch, fileSectorOffset: 0'u32)
    return writeOk()

  if not f.chunksData[index].present:
    # This chunk didn't exist before; append to EOF.
    let newEof = f.endSector + sectorCount(newChunkData)
    f.chunksData[index] = AnvilChunkMetadata(present: true, serializedData: newChunkData,
      timestamp: epoch, fileSectorOffset: f.endSector)
    f.endSector = newEof
    maybeUpdateChunkIndex(f, index)
    return writeOk()

  let oldChunk = f.chunksData[index]
  let oldSectors = sectorCount(oldChunk.serializedData)
  if oldSectors == sectorCount(newChunkData):
    f.chunksData[index] = AnvilChunkMetadata(present: true, serializedData: newChunkData,
      timestamp: epoch, fileSectorOffset: oldChunk.fileSectorOffset)
    maybeUpdateChunkIndex(f, index)
    return writeOk()

  # Walk back the end of the list, seeing if something can fit in our spot. If nothing does after
  # 64 chunks, re-write the whole file instead.
  var keys = newSeq[int64](0)
  for i in 0 ..< ChunkCount:
    if f.chunksData[i].present:
      keys.add(int64(f.chunksData[i].fileSectorOffset) * 2048'i64 + int64(i))
  sort(keys, cmpInt64)
  var chunksToShift = newSeq[int](0)
  var k = keys.len - 1
  while k >= 0 and chunksToShift.len < 64:
    let i = int(keys[k] mod 2048'i64)
    chunksToShift.add(i)
    if sectorCount(f.chunksData[i].serializedData) == oldSectors:
      break  # take_while_inclusive
    dec k

  if chunksToShift.len == 0 or chunksToShift[chunksToShift.len - 1] == index:
    # Unable to find a chunk to swap with; give up and serialize everything.
    f.writeAction = waAll
    f.chunksData[index] = AnvilChunkMetadata(present: true, serializedData: newChunkData,
      timestamp: epoch, fileSectorOffset: 0'u32)
    return writeOk()

  let swappedIndex = chunksToShift[chunksToShift.len - 1]
  chunksToShift.setLen(chunksToShift.len - 1)
  let swapOffset = f.chunksData[swappedIndex].fileSectorOffset
  let swappedSectors = sectorCount(f.chunksData[swappedIndex].serializedData)
  let newSectors = sectorCount(newChunkData)
  let oldOffset = oldChunk.fileSectorOffset
  f.chunksData[index] = AnvilChunkMetadata(present: true, serializedData: newChunkData,
    timestamp: epoch, fileSectorOffset: swapOffset)
  maybeUpdateChunkIndex(f, index)
  f.chunksData[swappedIndex].fileSectorOffset = oldOffset
  maybeUpdateChunkIndex(f, swappedIndex)

  # If positive, now larger: shift right; else shift left.
  let offset = int64(newSectors) - int64(swappedSectors)
  for shiftIndex in chunksToShift:
    f.chunksData[shiftIndex].fileSectorOffset =
      uint32(int64(f.chunksData[shiftIndex].fileSectorOffset) + offset)
    maybeUpdateChunkIndex(f, shiftIndex)
  f.endSector = uint32(int64(f.endSector) + offset)
  writeOk()

proc getChunkBytes*(f: AnvilChunkFile, x, z: int32): LoadedBytes =
  ## One step of `<AnvilChunkFile as ChunkSerializer>::get_chunks`.
  let index = getChunkIndex(x, z)
  if not f.chunksData[index].present:
    return loadedMissing(x, z)
  let (ok, raw, e) = toChunkBytes(f.chunksData[index].serializedData)
  if ok: loadedOk(x, z, raw) else: loadedError(x, z, e)

proc getChunkKeyAnvil*(x, z: int32): string =
  ## `<AnvilChunkFile as ChunkSerializer>::get_chunk_key`
  let (rx, rz) = getRegionCoords(x, z)
  "./r." & $rx & "." & $rz & ".mca"

proc toSerializer*(f: AnvilChunkFile, cfg: AnvilChunkConfig): ChunkSerializer =
  ChunkSerializer(
    shouldWrite: proc(isWatched: bool): bool {.closure.} = not isWatched,
    write: proc(path: string): IoStatus {.closure.} = writeRegion(f, path),
    updateChunk: proc(x, z: int32, raw: seq[byte]): ChunkWriteStatus {.closure.} =
      updateChunkBytes(f, x, z, raw, cfg),
    getChunk: proc(x, z: int32): LoadedBytes {.closure.} = getChunkBytes(f, x, z))

proc anvilSerializerType*(cfg: AnvilChunkConfig): ChunkSerializerType =
  ChunkSerializerType(
    getChunkKey: proc(x, z: int32): string {.closure.} = getChunkKeyAnvil(x, z),
    makeDefault: proc(): ChunkSerializer {.closure.} = toSerializer(newAnvilChunkFile(), cfg),
    read: proc(r: seq[byte]): SerializerReadResult {.closure.} =
      let (ok, f, e) = readRegion(r)
      if ok: serializerOk(toSerializer(f, cfg)) else: serializerErr(e))
