## Biome suppliers and the spawn position search.
## Port of pumpkin-world/src/biome/end.rs and pumpkin-world/src/biome/position_finder.rs, with the
## `to_long`/`NoiseValuePoint` half of biome/multi_noise.rs. `hash_seed` is in biomeparam.aowl.
##
## `MultiNoiseBiomeSupplier` and the real suppliers over `MultiNoiseSampler` are generation/noise/multi_noise_sampler.aowl.
## `theEndBiome` here answers by name with the sampler's `sample_erosion` as a parameter, for callers with no sampler.
## PARTIAL: pumpkin-world/src/biome/position_finder.rs - `ParameterRange` is biomeparam.aowl's `Parameter`.

import std/math
import biomeparam, blockstates
import ../util/vector2

const
  BiomeNetworkMaxBits* = 7  ## BIOME_NETWORK_MAX_BITS

type
  NoiseValuePoint* = object
    temperature*, humidity*, continentalness*, erosion*, depth*, weirdness*: int64

  BiomeSupplier* = ref object
    ## `trait BiomeSupplier`, answering a biome name.
    biome*: proc(x, y, z: int32): string {.closure.}

  FittestPositionFinderResult* = object
    location*: Vector2[int32]
    fitness*: int64

  NoiseRanges* = array[7, Parameter]
  NoiseSample* = array[7, int64]

proc toLong*(value: float32): int64 {.inline.} =
  ## `to_long` in multi_noise.rs
  int64(value * 10000.0'f32)

proc convertToList*(p: NoiseValuePoint): NoiseSample =
  ## `NoiseValuePoint::convert_to_list`
  [p.temperature, p.humidity, p.continentalness, p.erosion, p.depth, p.weirdness, 0'i64]

proc theEndBiome*(x, y, z: int32, sampleErosion: proc(x, y, z: int32): float64 {.closure.}): string =
  ## `<TheEndBiomeSupplier as BiomeSupplier>::biome`: x, y, z are biome coordinates.
  let blockX = x shl 2           # biome_coords::to_block
  let blockY = y shl 2
  let blockZ = z shl 2
  let sectionX = blockX shr 4    # section_coords::block_to_section
  let sectionZ = blockZ shr 4
  if int64(sectionX) * int64(sectionX) + int64(sectionZ) * int64(sectionZ) <= 4096'i64:
    return "the_end"
  let cx = (sectionX * 2'i32 + 1'i32) * 8'i32
  let cz = (sectionZ * 2'i32 + 1'i32) * 8'i32
  let noise = sampleErosion(cx, blockY, cz)
  if noise > 0.25:
    return "end_highlands"
  if noise >= -0.0625:
    return "end_midlands"
  if noise < -0.21875:
    return "small_end_islands"
  "end_barrens"

proc calculateFitness(noises: openArray[NoiseRanges], sampler: proc(x, z: int32): NoiseSample {.closure.},
                      x, z: int32): FittestPositionFinderResult =
  ## `FittestPositionFinder::calculate_fitness`
  let sampled = sampler(x, z)
  var minSquaredDist = high(int64)
  for ranges in noises:
    var currentDist = 0'i64
    for i in 0 ..< 7:
      currentDist += distance(ranges[i], sampled[i])
    minSquaredDist = min(minSquaredDist, currentDist)
  let originDistSq = int64(x) * int64(x) + int64(z) * int64(z)
  FittestPositionFinderResult(location: vec2[int32](x, z), fitness: minSquaredDist * (2048'i64 * 2048'i64) + originDistSq)

proc findFittest(noises: openArray[NoiseRanges], sampler: proc(x, z: int32): NoiseSample {.closure.},
                 best: var FittestPositionFinderResult, maxDistance, step: float32) =
  ## `FittestPositionFinder::find_fittest`
  var angle = 0.0'f32
  var dist = step
  let center = best.location
  while dist <= maxDistance:
    let x = center.x + int32(sin(float64(angle)) * float64(dist))
    let z = center.y + int32(cos(float64(angle)) * float64(dist))
    let r = calculateFitness(noises, sampler, x, z)
    if r.fitness < best.fitness:
      best = r
    angle += step / dist
    if angle > float32(2.0 * PI):
      angle = 0.0'f32
      dist += step

proc findBestSpawnPosition*(targetNoises: openArray[NoiseRanges],
                            sampler: proc(x, z: int32): NoiseSample {.closure.}): Vector2[int32] =
  ## `FittestPositionFinder::find_best_spawn_position`
  var best = calculateFitness(targetNoises, sampler, 0'i32, 0'i32)
  findFittest(targetNoises, sampler, best, 2048.0'f32, 512.0'f32)
  findFittest(targetNoises, sampler, best, 512.0'f32, 32.0'f32)
  best.location

proc biomeIdFitsNetwork*(): bool =
  ## Upstream's `proper_network_bits_per_entry`: every biome id fits the direct wire width.
  biomeCount() <= (1 shl BiomeNetworkMaxBits)
