## The End biome supplier, the spawn position search, `to_long`.

import std/[syncio, assertions]
import ../util/vector2
import biomesource, biomeparam

proc sampler(noiseValue: float64): proc(x, y, z: int32): float64 {.closure.} =
  proc(x, y, z: int32): float64 {.closure.} = noiseValue

proc testEndBiome() =
  # Within 64 sections of the origin: 4096 = 64^2 is still the center.
  assert theEndBiome(0'i32, 0'i32, 0'i32, sampler(1.0)) == "the_end"
  assert theEndBiome(256'i32, 0'i32, 0'i32, sampler(1.0)) == "the_end"     # block 1024, section 64
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(1.0)) == "end_highlands" # section 65
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(0.25)) == "end_midlands"
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(-0.0625)) == "end_midlands"
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(-0.1)) == "end_barrens"
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(-0.21875)) == "end_barrens"
  assert theEndBiome(260'i32, 0'i32, 0'i32, sampler(-0.3)) == "small_end_islands"
  # The sampler sees section-centered block coordinates: (65*2+1)*8 = 1048.
  var seenX = 0'i32
  discard theEndBiome(260'i32, 0'i32, 0'i32, proc(x, y, z: int32): float64 {.closure.} =
    seenX = x
    0.0)
  assert seenX == 1048'i32

proc testPositionFinder() =
  # Every sample matches a target only at x >= 512: the search must leave the origin and stop close.
  let target: NoiseRanges = [newParameter(0'i64, 0'i64), newParameter(0'i64, 0'i64), newParameter(0'i64, 0'i64),
    newParameter(0'i64, 0'i64), newParameter(0'i64, 0'i64), newParameter(0'i64, 0'i64), newParameter(0'i64, 0'i64)]
  let targets = @[target]
  let found = findBestSpawnPosition(targets, proc(x, z: int32): NoiseSample {.closure.} =
    let off = if x >= 400'i32: 0'i64 else: 1000'i64
    [off, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64])
  assert found.x >= 400'i32
  # With everything equally fit, the origin wins on distance.
  let origin = findBestSpawnPosition(targets, proc(x, z: int32): NoiseSample {.closure.} =
    [0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64, 0'i64])
  assert origin.x == 0'i32 and origin.y == 0'i32
  # to_long and convert_to_list in multi_noise.rs.
  assert toLong(0.5'f32) == 5000'i64
  assert convertToList(NoiseValuePoint(temperature: 1, humidity: 2, continentalness: 3, erosion: 4, depth: 5,
    weirdness: 6))[6] == 0'i64
  # `proper_network_bits_per_entry` in biome/mod.rs.
  assert biomeIdFitsNetwork()

testEndBiome()
testPositionFinder()
echo "biomesource: all checks passed"
