## Block state codec, block entity traits, viewer counting.
## Port of pumpkin-world/src/block/mod.rs, pumpkin-world/src/block/entities.rs and
## pumpkin-world/src/block/viewer.rs

import ../nbt/tag
import blockstates, nbtget

type
  BlockStateCodec* = object
    ## `name` is the resolved block id (`&'static Block`). Empty `properties` is upstream's `None`.
    name*: int
    hasProperties*: bool
    properties*: seq[StateProp]

  PropertyDelegate* = ref object
    ## `trait PropertyDelegate`
    getProperty*: proc(index: int32): int32 {.closure.}
    setProperty*: proc(index, value: int32) {.closure.}
    getPropertiesSize*: proc(): int32 {.closure.}

  ExperienceContainer* = ref object
    ## `trait ExperienceContainer`
    extractExperience*: proc(): int32 {.closure.}

  ViewerCountTracker* = object
    old*: uint16
    current*: uint16

proc getBlock*(c: BlockStateCodec): int {.inline.} =
  ## `BlockStateCodec::get_block`
  c.name

proc getStateId*(c: BlockStateCodec): BlockStateId =
  ## `BlockStateCodec::get_state_id`
  if not c.hasProperties:
    return defaultStateOf(c.name)
  stateIdFromProps(c.name, c.properties)

proc blockStateCodecFromNbt*(nbt: NbtCompound): (bool, BlockStateCodec) =
  ## `Deserialize for BlockStateCodec`: {Name, Properties}. Fails on an unknown name, as
  ## `parse_block_name` does.
  let (hasName, name) = nbtString(nbt, "Name")
  let empty = BlockStateCodec(name: 0, hasProperties: false, properties: @[])
  if not hasName:
    return (false, empty)
  let (known, id) = blockIdByName(name)
  if not known:
    return (false, empty)
  let (hasProps, props) = nbtCompound(nbt, "Properties")
  var kv = newSeq[StateProp](0)
  if hasProps:
    for i in 0 ..< props.names.len:
      if props.values[i].kind == ntkString:
        kv.add((name: props.names[i], value: props.values[i].stringVal))
  (true, BlockStateCodec(name: id, hasProperties: hasProps, properties: kv))

proc blockStateCodecToNbt*(c: BlockStateCodec): NbtCompound =
  ## `Serialize for BlockStateCodec`. `block_to_string` writes `block.name`, which has no namespace.
  result = newCompound()
  put(result, "Name", stringTag(blockName(c.name)))
  if c.hasProperties:
    var props = newCompound()
    for p in c.properties:
      put(props, p.name, stringTag(p.value))
    put(result, "Properties", compoundTag(props))

proc newViewerCountTracker*(): ViewerCountTracker =
  ViewerCountTracker(old: 0'u16, current: 0'u16)

proc openContainer*(t: var ViewerCountTracker) =
  ## `ViewerCountTracker::open_container`
  t.current = t.current + 1'u16

proc closeContainer*(t: var ViewerCountTracker) =
  ## `ViewerCountTracker::close_container`. u16 wraps as `fetch_sub` does.
  t.current = t.current - 1'u16

proc getViewerCount*(t: ViewerCountTracker): uint16 {.inline.} =
  ## `ViewerCountTracker::get_viewer_count`
  t.current

# See the same anchor in chunkio.aowl: this module only declares closure fields otherwise.
proc closureLiftAnchor*(): proc(): bool {.closure.} =
  proc(): bool {.closure.} = true
