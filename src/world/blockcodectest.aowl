## Port of the tests in block/mod.rs, plus the codec and `ViewerCountTracker`.

import std/[syncio, assertions]
import ../nbt/tag
import blockcodec, blockstates, nbtget

proc testBlockCodec() =
  var props = newCompound()
  put(props, "axis", stringTag("x"))
  var nbt = newCompound()
  put(nbt, "Name", stringTag("minecraft:oak_log"))
  put(nbt, "Properties", compoundTag(props))
  let (ok, codec) = blockStateCodecFromNbt(nbt)
  assert ok
  let (_, oak) = blockIdByName("oak_log")
  assert getBlock(codec) == oak
  assert getStateId(codec) == defaultStateOf(oak) - 1'u32
  # No Properties is the default state.
  var bare = newCompound()
  put(bare, "Name", stringTag("minecraft:oak_log"))
  let (okBare, plain) = blockStateCodecFromNbt(bare)
  assert okBare and getStateId(plain) == defaultStateOf(oak)
  # An unknown name fails, as parse_block_name does.
  var bad = newCompound()
  put(bad, "Name", stringTag("minecraft:nope"))
  assert not blockStateCodecFromNbt(bad)[0]
  assert not blockStateCodecFromNbt(newCompound())[0]
  # `block_to_string`: the bare block name.
  let back = blockStateCodecToNbt(codec)
  assert nbtString(back, "Name") == (true, "oak_log")
  let (_, backProps) = nbtCompound(back, "Properties")
  assert nbtString(backProps, "axis") == (true, "x")
  assert not blockStateCodecToNbt(plain).containsKey("Properties")

  # `proper_network_bits_per_entry` in block/mod.rs.
  assert stateIdOrAir(uint32(1 shl BlockNetworkMaxBits)) == 0'u32

proc testViewer() =
  var t = newViewerCountTracker()
  assert getViewerCount(t) == 0'u16
  openContainer(t)
  openContainer(t)
  assert getViewerCount(t) == 2'u16
  closeContainer(t)
  assert getViewerCount(t) == 1'u16

testBlockCodec()
testViewer()
echo "blockcodec: all checks passed"
