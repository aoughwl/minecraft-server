## Lookups over src/generated/block_states.aowl: the block-state and biome queries the
## world crate needs from pumpkin-data. Port of the parts of pumpkin-data/src/block_state.rs,
## pumpkin-data/src/blocks.rs and the `block_properties` free functions in
## pumpkin-data/src/generated/block.rs that chunk storage and lighting call.
##
## The tables come from gen_block_states.aowl, because blockdata.aowl and blockprops.aowl carry no
## per-state fields.

import std/tables
import ../generated/block_states

export BsStateCount

type
  BlockStateId* = uint32
    ## Same width as `PaletteValue`. Upstream's newtype guarantees validity through
    ## `new_or_air`; here that is `stateIdOrAir`.

  StateProp* = tuple[name, value: string]

const
  IsAirFlag = 1'u32 shl 0
  IsLiquidFlag = 1'u32 shl 5
  IsSolidFlag = 1'u32 shl 6
  HasRandomTicksFlag = 1'u32 shl 9
  BlockNetworkMaxBits* = 15 ## `BLOCK_NETWORK_MAX_BITS`

proc hexVal(c: char): uint32 {.inline.} =
  if c >= 'a': uint32(ord(c) - ord('a') + 10) else: uint32(ord(c) - ord('0'))

proc hexByte(i: int): uint32 {.inline.} =
  (hexVal(BsStateData[i * 2]) shl 4) or hexVal(BsStateData[i * 2 + 1])

proc buildBlockIndex(): Table[string, int] =
  result = initTable[string, int]()
  for i, b in BsBlocks:
    result[b.name] = i

proc buildBiomeIndex(): Table[string, int] =
  result = initTable[string, int]()
  for i, n in BsBiomeNames:
    result[n] = i

proc buildLeaves(): seq[bool] =
  result = newSeq[bool](BsBlocks.len)
  for i, b in BsBlocks:
    for l in BsLeavesTag:
      if l == b.name:
        result[i] = true

let
  blockIndex = buildBlockIndex()
  biomeIndex = buildBiomeIndex()
  leavesByBlock = buildLeaves()

proc stateFlags(id: BlockStateId): uint32 {.inline.} =
  let at = int(id) * 7
  (hexByte(at) shl 8) or hexByte(at + 1)

proc isValidStateId*(id: uint32): bool {.inline.} = int(id) < BsStateCount

proc stateIdOrAir*(id: uint32): BlockStateId {.inline.} =
  ## `BlockStateId::new_or_air`.
  if isValidStateId(id): id else: 0'u32

proc isAir*(id: BlockStateId): bool {.inline.} = (stateFlags(id) and IsAirFlag) != 0
proc isLiquid*(id: BlockStateId): bool {.inline.} = (stateFlags(id) and IsLiquidFlag) != 0
proc isSolid*(id: BlockStateId): bool {.inline.} = (stateFlags(id) and IsSolidFlag) != 0
proc hasRandomTicks*(id: BlockStateId): bool {.inline.} = (stateFlags(id) and HasRandomTicksFlag) != 0
proc sideFlags*(id: BlockStateId): uint8 {.inline.} = uint8(hexByte(int(id) * 7 + 2))
proc luminance*(id: BlockStateId): uint8 {.inline.} = uint8(hexByte(int(id) * 7 + 3))
proc opacity*(id: BlockStateId): uint8 {.inline.} = uint8(hexByte(int(id) * 7 + 4))

proc blockIdOf*(id: BlockStateId): int {.inline.} =
  ## `BlockStateId::to_block_id`.
  let at = int(id) * 7 + 5
  int((hexByte(at) shl 8) or hexByte(at + 1))

proc blockName*(blockId: int): string {.inline.} = BsBlocks[blockId].name

proc blockNameOfState*(id: BlockStateId): string = blockName(blockIdOf(id))

proc hasRandomTickingFluid*(id: BlockStateId): bool {.inline.} =
  ## `has_random_ticking_fluid`: only lava and flowing lava.
  int(id) >= BsLavaFirstState and int(id) <= BsLavaLastState

proc stripMinecraft*(name: string): string =
  ## `Block::from_name` accepts the name with or without the namespace.
  if name.len > 10 and name[0 .. 9] == "minecraft:": name[10 .. ^1] else: name

proc blockIdByName*(name: string): (bool, int) =
  ## `Block::from_name`.
  let i = blockIndex.getOrDefault(stripMinecraft(name), -1)
  (i >= 0, i)

proc defaultStateOf*(blockId: int): BlockStateId {.inline.} =
  uint32(BsBlocks[blockId].defaultStateId)

proc defaultStateByName*(name: string): (bool, BlockStateId) =
  let (ok, id) = blockIdByName(name)
  if ok: (true, defaultStateOf(id)) else: (false, 0'u32)

proc isLeaves*(id: BlockStateId): bool {.inline.} =
  ## `block.has_tag(MINECRAFT_LEAVES)` on the state's block.
  leavesByBlock[blockIdOf(id)]

const
  BlockIdCobwebName = "cobweb"
  BlockIdBambooSaplingName = "bamboo_sapling"

let
  cobwebBlockId = blockIndex.getOrDefault(BlockIdCobwebName, -1)
  bambooSaplingBlockId = blockIndex.getOrDefault(BlockIdBambooSaplingName, -1)

proc blocksMovement*(id: BlockStateId): bool =
  ## `blocks_movement(block_state, block)`.
  let b = blockIdOf(id)
  isSolid(id) and b != cobwebBlockId and b != bambooSaplingBlockId

proc stateProperties*(id: BlockStateId): seq[StateProp] =
  ## The state's property values, in the block's property order: the inverse of the
  ## mixed-radix `to_state_id`.
  result = @[]
  let b = BsBlocks[blockIdOf(id)]
  var offset = int(id) - b.firstStateId
  for r in b.props:
    let p = BsProps[r.prop]
    let idx = offset div r.multiplier
    offset = offset mod r.multiplier
    result.add((p.name, p.values[idx]))

proc stateIdFromProps*(blockId: int, props: openArray[StateProp]): BlockStateId =
  ## `block.from_properties(..).to_state_id(block)`. A property the block does not have is
  ## ignored and a missing one keeps the block's default value, the way vanilla's codec
  ## treats a partial `Properties` compound.
  let b = BsBlocks[blockId]
  var offset = 0
  var defOffset = b.defaultStateId - b.firstStateId
  for r in b.props:
    let p = BsProps[r.prop]
    var idx = defOffset div r.multiplier
    defOffset = defOffset mod r.multiplier
    for kv in props:
      if kv.name == p.name:
        for vi, v in p.values:
          if v == kv.value:
            idx = vi
    offset += idx * r.multiplier
  uint32(b.firstStateId + offset)

proc biomeIdByName*(name: string): (bool, int) =
  ## `Biome::from_name`.
  let i = biomeIndex.getOrDefault(stripMinecraft(name), -1)
  (i >= 0, i)

proc biomeNameById*(id: int): (bool, string) =
  ## `Biome::from_id`.
  if id >= 0 and id < BsBiomeNames.len: (true, BsBiomeNames[id]) else: (false, "")

proc biomeCount*(): int {.inline.} = BsBiomeNames.len

proc isReplaceable*(id: BlockStateId): bool {.inline.} =
  ## `BlockState::replaceable`
  (stateFlags(id) and (1'u32 shl 4)) != 0'u32

proc isFullCube*(id: BlockStateId): bool {.inline.} =
  ## `BlockState::is_full_cube`
  (stateFlags(id) and (1'u32 shl 7)) != 0'u32

proc isSolidBlock*(id: BlockStateId): bool {.inline.} =
  ## `BlockState::is_solid_block`
  (stateFlags(id) and (1'u32 shl 8)) != 0'u32

proc isSideSolid*(id: BlockStateId, direction: int): bool {.inline.} =
  ## `BlockState::is_side_solid`, by `BlockDirection` ordinal: `side_flags` holds one bit per direction, in order.
  (sideFlags(id) and (1'u8 shl direction)) != 0'u8

proc isCenterSolid*(id: BlockStateId, direction: int): bool {.inline.} =
  ## `BlockState::is_center_solid`, by `BlockDirection` ordinal: the two center bits follow the six side bits.
  if isSideSolid(id, direction):
    return true
  case direction
  of 0: (sideFlags(id) and (1'u8 shl 6)) != 0'u8
  of 1: (sideFlags(id) and (1'u8 shl 7)) != 0'u8
  else: false
