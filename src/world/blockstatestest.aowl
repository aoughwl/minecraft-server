## Known answers for blockstates.aowl. Every expected value is read from the pinned tree's
## pumpkin-data/src/generated/block.rs and fluid.rs, or from the 1.21.11 server's own
## blocks report.
import std/[syncio, assertions]
import blockstates

proc sid(name: string): BlockStateId =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc sp(n, v: string): seq[StateProp] = @[(name: n, value: v)]

# `is_air` in generated/block.rs: matches!(id, 0 | 15292 | 15293)
assert isAir(0'u32) and isAir(15292'u32) and isAir(15293'u32)
assert not isAir(1'u32)
assert sid("air") == 0'u32 and sid("void_air") == 15292'u32 and sid("cave_air") == 15293'u32

# `Fluid::from_state_id`: water states 86..101, lava states 102..117.
assert sid("water") == 86'u32 and sid("lava") == 102'u32
assert isLiquid(86'u32) and isLiquid(102'u32)
assert hasRandomTickingFluid(102'u32) and hasRandomTickingFluid(117'u32)
assert not hasRandomTickingFluid(101'u32) and not hasRandomTickingFluid(118'u32)

# blocks.json: grass_block's default state is 9 with flags 960 (solid, full cube, solid block, random ticks).
assert sid("grass_block") == 9'u32
assert hasRandomTicks(9'u32) and blocksMovement(9'u32) and opacity(9'u32) == 15'u8
assert not hasRandomTicks(sid("stone"))

# firefly_bush is the last state; luminance 2, opacity 0.
assert sid("firefly_bush") == uint32(BsStateCount - 1)
assert luminance(sid("firefly_bush")) == 2'u8 and opacity(sid("firefly_bush")) == 0'u8

# Tag and predicate cases from upstream's `heightmap_is_opaque` test.
assert isLeaves(sid("oak_leaves")) and not isLeaves(sid("stone"))
assert blocksMovement(sid("oak_leaves"))
assert not blocksMovement(sid("air"))
assert not blocksMovement(sid("cobweb"))

# Mixed-radix round trip over every state, and names.
for i in 0 ..< BsStateCount:
  let id = uint32(i)
  let b = blockIdOf(id)
  assert stateIdFromProps(b, stateProperties(id)) == id

# Decoded names and order: oak_log axis values are x, y, z and the default is y.
let log = sid("oak_log")
let logProps = stateProperties(log)
assert logProps.len == 1 and logProps[0].name == "axis" and logProps[0].value == "y"
let (_, logBlock) = blockIdByName("minecraft:oak_log")
assert stateIdFromProps(logBlock, sp("axis", "x")) == log - 1'u32
assert stateIdFromProps(logBlock, sp("axis", "z")) == log + 1'u32
assert stateIdFromProps(logBlock, newSeq[StateProp](0)) == log
assert stateIdFromProps(logBlock, sp("nope", "x")) == log
assert blockNameOfState(log) == "oak_log"

# 1.21.11 server blocks report: deepslate_redstone_ore[lit=false] is the second state of two.
let (_, redstone) = blockIdByName("deepslate_redstone_ore")
assert stateIdFromProps(redstone, sp("lit", "true")) + 1'u32 == stateIdFromProps(redstone, sp("lit", "false"))
assert stateProperties(defaultStateOf(redstone))[0].value == "false"

# Biomes: generated/biome.rs gives BADLANDS id 0, BAMBOO_JUNGLE 1, and the names are 'badlands'.
assert biomeIdByName("minecraft:badlands") == (true, 0)
assert biomeIdByName("bamboo_jungle") == (true, 1)
assert biomeNameById(0) == (true, "badlands")
assert biomeIdByName("minecraft:not_a_biome")[0] == false

# Upstream's `proper_network_bits_per_entry` tests: the wire widths still fit the tables.
assert stateIdOrAir(uint32(1 shl BlockNetworkMaxBits)) == 0'u32 or BsStateCount > (1 shl BlockNetworkMaxBits)
assert not biomeNameById(1 shl 7)[0]

echo "blockstates: all checks passed"
