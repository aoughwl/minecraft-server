## Port of pumpkin-world/src/chunk_system/channel.rs
##
## The chunk system runs on one thread here, so the mutex and condvar are gone: `get` is the only read, and
## `wait_and_get` has no counterpart because the schedule returns to its caller when it runs out of work.

import std/tables
import dag
import chunk_stage

type
  StageChange* = tuple[oldStage, newStage: StagedChunkEnum]

  ChunkLevel* = Table[ChunkPos, int8]

  LevelChange* = object
    changes*: Table[ChunkPos, StageChange]
    levels*: ChunkLevel

  LevelChannelValue* = object
    hasChange*: bool
    change*: LevelChange
    hasPriority*: bool
    priority*: seq[ChunkPos]

  LevelChannel* = ref object
    value*: LevelChannelValue

proc newLevelChannel*(): LevelChannel =
  LevelChannel(value: LevelChannelValue())

proc mergeLevelChange(c: LevelChannel, changes: Table[ChunkPos, StageChange], levels: ChunkLevel) =
  if c.value.hasChange:
    for pos, change in pairs(changes):
      if c.value.change.changes.hasKey(pos):
        let tmp = c.value.change.changes.getOrDefault(pos, change)
        if tmp.oldStage == change.newStage:
          c.value.change.changes.del(pos)
        else:
          c.value.change.changes[pos] = (oldStage: tmp.oldStage, newStage: change.newStage)
      else:
        c.value.change.changes[pos] = change
    c.value.change.levels = levels
  else:
    c.value.hasChange = true
    c.value.change = LevelChange(changes: changes, levels: levels)

proc setBoth*(c: LevelChannel, changes: Table[ChunkPos, StageChange], levels: ChunkLevel, pos: seq[ChunkPos]) =
  ## `LevelChannel::set_both`
  c.value.hasPriority = true
  c.value.priority = pos
  mergeLevelChange(c, changes, levels)

proc setLevel*(c: LevelChannel, changes: Table[ChunkPos, StageChange], levels: ChunkLevel) =
  ## `LevelChannel::set_level`
  mergeLevelChange(c, changes, levels)

proc setPriority*(c: LevelChannel, pos: seq[ChunkPos]) =
  ## `LevelChannel::set_priority`
  c.value.hasPriority = true
  c.value.priority = pos

proc get*(c: LevelChannel): LevelChannelValue =
  ## `LevelChannel::get`
  result = c.value
  c.value = LevelChannelValue()
