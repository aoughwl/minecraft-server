## Port of pumpkin-world/src/chunk_system/chunk_listener.rs
##
## A oneshot receiver is `SingleChunkListener`, polled with `received`. A global listener is a queue the caller
## drains; upstream's `Weak` is a plain reference, since a chunk's lifetime here is the holder's and the level's.

{.feature: "lenientnils".}

import ../chunkdata
import dag

type
  SingleChunkListener* = ref object
    pos*: ChunkPos
    received*: ChunkData  ## nil until the chunk arrives.

  GlobalChunkListener* = ref object
    queue*: seq[(ChunkPos, ChunkData)]

  ChunkListener* = ref object
    single: seq[SingleChunkListener]
    global: seq[GlobalChunkListener]

proc newChunkListener*(): ChunkListener =
  ChunkListener(single: @[], global: @[])

proc addSingleChunkListener*(l: ChunkListener, pos: ChunkPos): SingleChunkListener =
  ## `ChunkListener::add_single_chunk_listener`
  result = SingleChunkListener(pos: pos)
  l.single.add(result)

proc addGlobalChunkListener*(l: ChunkListener): GlobalChunkListener =
  ## `ChunkListener::add_global_chunk_listener`
  result = GlobalChunkListener(queue: @[])
  l.global.add(result)

proc removeGlobalChunkListener*(l: ChunkListener, g: GlobalChunkListener) =
  ## What dropping the receiver does upstream.
  var i = 0
  while i < l.global.len:
    if l.global[i] == g:
      l.global.delete(i)
    else:
      inc i

proc processNewChunk*(l: ChunkListener, pos: ChunkPos, chunk: ChunkData) =
  ## `ChunkListener::process_new_chunk`
  var i = 0
  while i < l.single.len:
    if l.single[i].pos == pos:
      l.single[i].received = chunk
      l.single.delete(i)
    else:
      inc i
  for gi in 0 ..< l.global.len:
    l.global[gi].queue.add((pos, chunk))
