## The stages a chunk generates through: the `StagedChunkEnum` half of pumpkin-world/src/chunk_system/chunk_state.rs.
## On its own because `ProtoChunk` holds one and `Chunk` holds a `ProtoChunk`; chunk_state.aowl has the rest.

import std/assertions
import ../../generated/chunk_status

export chunk_status

type
  StagedChunkEnum* {.pure.} = enum
    None
    Empty                ## Initial empty chunk, ready for biome population
    Biomes               ## Chunk with biomes populated, ready for noise generation
    StructureStart
    StructureReferences
    Noise                ## Chunk with terrain noise generated, ready for surface building
    Surface              ## Chunk with surface built, ready for carvers
    Carvers              ## Chunk with carvers applied, ready for features and structures
    Features             ## Chunk with features and structures, ready for lighting
    Lighting             ## Chunk with lighting calculated, ready for spawning
    Spawn                ## Chunk with mobs spawned, ready for finalization
    Full                 ## Fully generated chunk

const
  StagedChunkCount* = ord(StagedChunkEnum.Full) + 1  ## `StagedChunkEnum::COUNT`
  FullRadius* = 4'i32                                ## `StagedChunkEnum::FULL_RADIUS`
  FullDependencies*: array[6, StagedChunkEnum] = [   ## `StagedChunkEnum::FULL_DEPENDENCIES`
    StagedChunkEnum.Full, StagedChunkEnum.Spawn, StagedChunkEnum.Lighting, StagedChunkEnum.Features,
    StagedChunkEnum.Carvers, StagedChunkEnum.Surface]

proc stageFromU8*(v: int): StagedChunkEnum =
  ## `From<u8> for StagedChunkEnum`. Upstream panics on 0 and out of range; a caller never passes those.
  assert v >= 1 and v <= ord(StagedChunkEnum.Full)
  StagedChunkEnum(v)

proc stageFromStatus*(status: ChunkStatus): StagedChunkEnum =
  ## `From<ChunkStatus> for StagedChunkEnum`
  case status
  of csEmpty: StagedChunkEnum.Empty
  of csStructureStarts: StagedChunkEnum.StructureStart
  of csStructureReferences: StagedChunkEnum.StructureReferences
  of csBiomes: StagedChunkEnum.Biomes
  of csNoise: StagedChunkEnum.Noise
  of csSurface: StagedChunkEnum.Surface
  of csCarvers: StagedChunkEnum.Carvers
  of csFeatures: StagedChunkEnum.Features
  of csInitializeLight, csLight: StagedChunkEnum.Lighting
  of csSpawn: StagedChunkEnum.Spawn
  of csFull: StagedChunkEnum.Full

proc statusFromStage*(stage: StagedChunkEnum): ChunkStatus =
  ## `From<StagedChunkEnum> for ChunkStatus`. Upstream panics on `None`.
  case stage
  of StagedChunkEnum.None:
    assert false, "no ChunkStatus for StagedChunkEnum::None"
    csEmpty
  of StagedChunkEnum.Empty: csEmpty
  of StagedChunkEnum.StructureStart: csStructureStarts
  of StagedChunkEnum.StructureReferences: csStructureReferences
  of StagedChunkEnum.Biomes: csBiomes
  of StagedChunkEnum.Noise: csNoise
  of StagedChunkEnum.Surface: csSurface
  of StagedChunkEnum.Carvers: csCarvers
  of StagedChunkEnum.Features: csFeatures
  of StagedChunkEnum.Lighting: csLight
  of StagedChunkEnum.Spawn: csSpawn
  of StagedChunkEnum.Full: csFull

proc levelToStage*(level: int8): StagedChunkEnum =
  ## `StagedChunkEnum::level_to_stage`
  if level <= 43'i8: StagedChunkEnum.Full
  elif level <= 44'i8: StagedChunkEnum.Spawn
  elif level <= 45'i8: StagedChunkEnum.Lighting
  elif level <= 46'i8: StagedChunkEnum.Features
  elif level <= 47'i8: StagedChunkEnum.Carvers
  elif level <= 48'i8: StagedChunkEnum.Surface
  else: StagedChunkEnum.None

proc getDirectRadius*(stage: StagedChunkEnum): int32 =
  ## `StagedChunkEnum::get_direct_radius`
  case stage
  of StagedChunkEnum.Features, StagedChunkEnum.Lighting, StagedChunkEnum.Spawn, StagedChunkEnum.Full: 1'i32
  else: 0'i32

proc getWriteRadius*(stage: StagedChunkEnum): int32 =
  ## `StagedChunkEnum::get_write_radius`
  case stage
  of StagedChunkEnum.Features, StagedChunkEnum.Lighting, StagedChunkEnum.Spawn: 1'i32
  else: 0'i32

proc getDirectDependencies*(stage: StagedChunkEnum): seq[StagedChunkEnum] =
  ## `StagedChunkEnum::get_direct_dependencies`. In vanilla StructureStart is first, but since it needs the
  ## biome in vanilla it gets computed in StructureStart and the Biome step; this should be more efficient.
  case stage
  of StagedChunkEnum.Biomes: @[StagedChunkEnum.Empty]
  of StagedChunkEnum.StructureStart: @[StagedChunkEnum.Biomes]
  of StagedChunkEnum.StructureReferences:
    @[StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart,
      StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart,
      StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart, StagedChunkEnum.StructureStart]
  of StagedChunkEnum.Noise: @[StagedChunkEnum.StructureReferences]
  of StagedChunkEnum.Surface: @[StagedChunkEnum.Noise]
  of StagedChunkEnum.Carvers: @[StagedChunkEnum.Surface]
  of StagedChunkEnum.Features: @[StagedChunkEnum.Carvers, StagedChunkEnum.Carvers]
  of StagedChunkEnum.Lighting: @[StagedChunkEnum.Features, StagedChunkEnum.Features]
  of StagedChunkEnum.Spawn: @[StagedChunkEnum.Lighting, StagedChunkEnum.Lighting]
  of StagedChunkEnum.Full: @[StagedChunkEnum.Spawn, StagedChunkEnum.Spawn]
  else:
    assert false, "no dependencies for this stage"
    @[]
