## The task graph. Port of pumpkin-world/src/chunk_system/dag.rs, with the part of the slotmap crate it uses.
##
## `NodeKey` and `EdgeKey` are one key type with a version per slot, as slotmap's are: a key to a removed value
## stops being found, also once its slot is reused.

{.feature: "lenientnils".}

import std/assertions
import std/hashes
import chunk_stage

type
  ChunkPos* = object
    ## `Vector2<i32>`. Not util/vector2.aowl's generic: its `==` is ambiguous inside std/tables.
    x*, y*: int32

  SlotKey* = object
    index*: int32    ## -1 for `Key::null()`.
    version*: uint32

  NodeKey* = SlotKey
  EdgeKey* = SlotKey

  Node* = object
    pos*: ChunkPos
    stage*: StagedChunkEnum
    inDegree*: uint32
    inQueue*: bool
    inFlight*: bool
    edge*: EdgeKey

  Edge* = object
    to*: NodeKey
    next*: EdgeKey

  NodeSlot = object
    version: uint32
    occupied: bool
    value: Node

  EdgeSlot = object
    version: uint32
    occupied: bool
    value: Edge

  DAG* = ref object
    nodeSlots: seq[NodeSlot]
    nodeFree: seq[int32]
    nodeCount: int
    edgeSlots: seq[EdgeSlot]
    edgeFree: seq[int32]
    edgeCount: int

proc chunkPos*(x, y: int32): ChunkPos {.inline.} = ChunkPos(x: x, y: y)
func `==`*(a, b: ChunkPos): bool {.inline.} = a.x == b.x and a.y == b.y
func hash*(p: ChunkPos): Hash {.inline.} = hash((int64(p.x) shl 32) xor (int64(p.y) and 0xFFFFFFFF'i64))
proc addRaw*(p: ChunkPos, x, y: int32): ChunkPos {.inline.} = ChunkPos(x: p.x + x, y: p.y + y)

const NullKey* = SlotKey(index: -1'i32, version: 0'u32)

func `==`*(a, b: SlotKey): bool {.inline.} = a.index == b.index and a.version == b.version
func hash*(k: SlotKey): Hash = hash((int64(k.index) shl 32) or int64(k.version))
proc isNull*(k: SlotKey): bool {.inline.} = k.index < 0'i32

proc newDAG*(): DAG =
  DAG(nodeSlots: @[], nodeFree: @[], edgeSlots: @[], edgeFree: @[])

proc newNode*(pos: ChunkPos, stage: StagedChunkEnum): Node =
  ## `Node::new`
  Node(pos: pos, stage: stage, inDegree: 0'u32, inQueue: false, inFlight: false, edge: NullKey)

proc insertNode*(g: DAG, n: Node): NodeKey =
  ## `nodes.insert`
  inc g.nodeCount
  if g.nodeFree.len > 0:
    let i = g.nodeFree[g.nodeFree.len - 1]
    g.nodeFree.setLen(g.nodeFree.len - 1)
    g.nodeSlots[int(i)].occupied = true
    g.nodeSlots[int(i)].value = n
    return SlotKey(index: i, version: g.nodeSlots[int(i)].version)
  g.nodeSlots.add(NodeSlot(version: 1'u32, occupied: true, value: n))
  SlotKey(index: int32(g.nodeSlots.len - 1), version: 1'u32)

proc containsNode*(g: DAG, k: NodeKey): bool {.inline.} =
  ## `nodes.contains_key`
  k.index >= 0'i32 and int(k.index) < g.nodeSlots.len and g.nodeSlots[int(k.index)].occupied and
    g.nodeSlots[int(k.index)].version == k.version

template node*(g: DAG, k: NodeKey): untyped =
  ## `nodes.get` / `get_mut` once `containsNode` has answered true.
  g.nodeSlots[int(k.index)].value

proc removeNode*(g: DAG, k: NodeKey): (bool, Node) =
  ## `nodes.remove`
  if not containsNode(g, k):
    return (false, default(Node))
  let old = g.nodeSlots[int(k.index)].value
  g.nodeSlots[int(k.index)].occupied = false
  inc g.nodeSlots[int(k.index)].version
  g.nodeFree.add(k.index)
  dec g.nodeCount
  (true, old)

proc nodeLen*(g: DAG): int {.inline.} = g.nodeCount

proc nodeKeys*(g: DAG): seq[NodeKey] =
  ## `for (key, node) in &graph.nodes`, keys first.
  result = newSeq[NodeKey](0)
  for i in 0 ..< g.nodeSlots.len:
    if g.nodeSlots[i].occupied:
      result.add(SlotKey(index: int32(i), version: g.nodeSlots[i].version))

proc insertEdge*(g: DAG, e: Edge): EdgeKey =
  ## `edges.insert`
  inc g.edgeCount
  if g.edgeFree.len > 0:
    let i = g.edgeFree[g.edgeFree.len - 1]
    g.edgeFree.setLen(g.edgeFree.len - 1)
    g.edgeSlots[int(i)].occupied = true
    g.edgeSlots[int(i)].value = e
    return SlotKey(index: i, version: g.edgeSlots[int(i)].version)
  g.edgeSlots.add(EdgeSlot(version: 1'u32, occupied: true, value: e))
  SlotKey(index: int32(g.edgeSlots.len - 1), version: 1'u32)

proc containsEdge*(g: DAG, k: EdgeKey): bool {.inline.} =
  k.index >= 0'i32 and int(k.index) < g.edgeSlots.len and g.edgeSlots[int(k.index)].occupied and
    g.edgeSlots[int(k.index)].version == k.version

proc getEdge*(g: DAG, k: EdgeKey): Edge {.inline.} =
  ## `edges.get(key).unwrap()`
  assert containsEdge(g, k)
  g.edgeSlots[int(k.index)].value

proc setEdgeNext*(g: DAG, k, next: EdgeKey) {.inline.} =
  ## `edges.get_mut(key).unwrap().next = next`
  g.edgeSlots[int(k.index)].value.next = next

proc removeEdge*(g: DAG, k: EdgeKey): Edge =
  ## `edges.remove(key).unwrap()`
  assert containsEdge(g, k)
  result = g.edgeSlots[int(k.index)].value
  g.edgeSlots[int(k.index)].occupied = false
  inc g.edgeSlots[int(k.index)].version
  g.edgeFree.add(k.index)
  dec g.edgeCount

proc clearEdges*(g: DAG) =
  ## `edges.clear`
  g.edgeSlots = @[]
  g.edgeFree = @[]
  g.edgeCount = 0

proc edgeLen*(g: DAG): int {.inline.} = g.edgeCount

proc fastDropNode*(g: DAG, n: NodeKey) =
  ## `DAG::fast_drop_node`
  let (ok, old) = removeNode(g, n)
  assert ok
  var edge = old.edge
  while not isNull(edge):
    edge = removeEdge(g, edge).next

proc addEdge*(g: DAG, fromKey, to: NodeKey) =
  ## `DAG::add_edge`. Ensures both nodes exist before adding the edge.
  if not containsNode(g, to) or not containsNode(g, fromKey):
    return
  inc g.nodeSlots[int(to.index)].value.inDegree
  let next = g.nodeSlots[int(fromKey.index)].value.edge
  let e = insertEdge(g, Edge(to: to, next: next))
  g.nodeSlots[int(fromKey.index)].value.edge = e
