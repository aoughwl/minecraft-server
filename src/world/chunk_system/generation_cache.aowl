## Advancing the chunk at the center of a `Cache` one stage.
## Port of pumpkin-world/src/chunk_system/generation_cache.rs; the `Cache` type and its `GenerationCache` impl are
## chunk_state.aowl, which the lighting engine needs below this file. Also pumpkin-world/src/chunk_system/generation.rs.

{.feature: "lenientnils".}

import std/assertions
import ../../config/lighting
import ../world
import ../lightingengine
import ../generation/proto_chunk
import chunk_state

export chunk_state

proc advance*(cache: Cache, stage: StagedChunkEnum, generator: WorldGenerator, blockRegistry: WorldPortalExt,
              lightingConfig: LightingEngineConfig) =
  ## `Cache::advance`
  let mid = midIndex(cache)
  case cache.chunks[mid].kind
  of ChunkKind.Level:
    return
  of ChunkKind.Proto:
    if cache.chunks[mid].proto.stage >= stage:
      return
  let chunk = cache.chunks[mid].proto
  case stage
  of StagedChunkEnum.Empty:
    assert false, "empty stage"
  of StagedChunkEnum.StructureStart:
    if generator.kind == WorldGeneratorKind.Noise:
      setStructureStarts(chunk, generator.noise)
  of StagedChunkEnum.StructureReferences:
    if generator.kind == WorldGeneratorKind.Noise:
      setStructureReferences(chunk, generator.noise)
  of StagedChunkEnum.Biomes:
    if generator.kind == WorldGeneratorKind.Noise:
      stepToBiomes(chunk, generator.noise)
    else:
      stepToBiomes(generator.flat, chunk)
  of StagedChunkEnum.Noise:
    if generator.kind == WorldGeneratorKind.Noise:
      stepToNoise(chunk, generator.noise)
    else:
      stepToNoise(generator.flat, chunk)
  of StagedChunkEnum.Surface:
    if generator.kind == WorldGeneratorKind.Noise:
      stepToSurface(chunk, generator.noise)
    else:
      stepToSurface(generator.flat, chunk)
  of StagedChunkEnum.Carvers:
    if generator.kind == WorldGeneratorKind.Noise:
      stepToCarvers(chunk, generator.noise)
    else:
      stepToCarvers(generator.flat, chunk)
  of StagedChunkEnum.Features:
    if generator.kind == WorldGeneratorKind.Noise:
      generateFeaturesAndStructure(cacheAsGenerationCache(cache), blockRegistry, generator.noise.randomConfig)
    else:
      chunk.stage = StagedChunkEnum.Features
  of StagedChunkEnum.Lighting:
    var engine = newLightEngine()
    initializeLight(engine, cache, lightingConfig)
    # Only set stage to Lighting if it wasn't already at Lighting or higher:
    # initialize_light may short-circuit for already-lit chunks.
    if chunk.stage < StagedChunkEnum.Lighting:
      chunk.stage = StagedChunkEnum.Lighting
  of StagedChunkEnum.Spawn:
    spawnMobs(cacheAsGenerationCache(cache), blockRegistry)
  of StagedChunkEnum.Full:
    assert chunk.stage == StagedChunkEnum.Spawn
    chunk.stage = StagedChunkEnum.Full
    upgradeToLevelChunk(cache.chunks[mid], dimension(generator), lightingConfig)
  of StagedChunkEnum.None:
    discard

proc generateSingleChunk*(generator: WorldGenerator, blockRegistry: WorldPortalExt, chunkX, chunkZ: int32,
                          targetStage: StagedChunkEnum): Chunk =
  ## `generate_single_chunk` in generation.rs. Upstream's `_dimension` and `_biome_mixer_seed` go unread.
  let radius = getDirectRadius(targetStage)
  let cache = newCache(chunkX - radius, chunkZ - radius, radius * 2'i32 + 1'i32)
  var dx = -radius
  while dx <= radius:
    var dz = -radius
    while dz <= radius:
      cache.chunks.add(protoChunk(newProtoChunk(chunkX + dx, chunkZ + dz, generator)))
      inc dz
    inc dx
  const Stages = [StagedChunkEnum.Biomes, StagedChunkEnum.StructureStart, StagedChunkEnum.StructureReferences,
    StagedChunkEnum.Noise, StagedChunkEnum.Surface, StagedChunkEnum.Carvers, StagedChunkEnum.Features,
    StagedChunkEnum.Lighting, StagedChunkEnum.Spawn, StagedChunkEnum.Full]
  for i in 0 ..< Stages.len:
    if ord(Stages[i]) > ord(targetStage):
      break
    advance(cache, Stages[i], generator, blockRegistry, lecDefault)
  cache.chunks[midIndex(cache)]
