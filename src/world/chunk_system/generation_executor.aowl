## Runs `runGeneration` on worker threads. No upstream file: pumpkin-world's `generation_work` runs on rayon threads and
## sends `(pos, RecvChunk::Generation)` back over a channel. The workers are those of `server/sim/jobpool` (the process's one
## worker pool, shared through `sharedJobPool`): generation and decode batches are Normal-lane jobs, distant-terrain summaries
## Background-lane jobs (a worker takes Background only when Urgent and Normal are empty). The pool carries only an `int` per
## job, so a job's payload (`GenTask`) sits in a lock-protected table and the job argument is its index; the finished
## `RecvChunk`s go to a per-handle done list under the same lock, and the pool's own result is drained and dropped on each poll.
## Job bodies never raise: a generation that raises comes back as a `GenerationFailure`, a decode that raises yields fresh
## proto chunks for its unfinished entries, a failed summary is handed back unfinished.
##
## Ownership: `occupyForGeneration` moves the Protos of a task's write square into its `Cache` and clears the holders'
## `chunk`, so while a job is queued or running the schedule (tick thread) holds no reference to anything in that cache and
## reads none of it; the cache comes back, whole, in a `RecvChunk`. Reference counts are atomic, so the refs a job shares
## with the tick thread (`ScheduleHost`, the generator, the portal) are safe to hold from two threads; they are read-only
## during generation (see the notes on each global in the commit that added this file).
##
## Which stages go to a worker is a bit mask over `StagedChunkEnum`; a stage outside it runs inline in `submit`, exactly
## as before, and its result is available at the next `pollCompleted`. `Spawn` is never offloaded: it creates entities in
## the world (`World.spawnEntity`, plugin hooks), which only the tick thread may touch.
##
## Configuration: the worker count comes from `threadcfg.planThreads` (`chunkWorkers`) when `MC_CHUNK_WORKERS` or `MC_THREADS`
## is set, otherwise 0 = everything inline, as the server always did (an unset environment never turns threads on by itself);
## `MC_CHUNK_ASYNC_MASK` is a decimal bit mask of stage ordinals (default every stage but Spawn). `MC_GEN_STATS=1` prints
## per-stage totals every ten seconds.
##
## The low-priority lane carries distant-terrain summaries (`LodJob`, world/generation/lodsummary.aowl, for the `jester:lod`
## channel): a worker takes one only when no generation or decode job waits, so summaries never delay a chunk somebody stands next
## to. `submitLod` refuses (false) without workers; the caller then runs the job inline within its own budget.

{.feature: "lenientnils".}

import std/locks
import std/envvars
import std/cpuinfo
import std/times
import std/strutils
import std/syncio
import ../chunkdata
import ../chunkio
import chunk_stage
import dag
import generation_cache
import worker_logic
import ../generation/proto_chunk
import ../../server/sim/jobpool
import ../../server/sim/threadcfg
from ../../generated/tag import getLatestMap, RegistryKey
from ../generation/feature/decode import prewarmFeatureDefs
from ../generation/feature/feature_order import prewarmFeatureOrder
from ../generation/structure/structures/jigsaw_placement import prewarmStructureJson
from ../generation/structure/protostructures import prewarmStructureSteps
from "../generation/structure/template/processor" import prewarmBlockTags
from "../generation/structure/template/cache" import prewarmTemplates
from ../generation/lodsummary import LodJob, runLodJob

type
  TaskKind = enum
    tkGen, tkDecode, tkLod

  GenTask = object
    kind: TaskKind
    host: ScheduleHost
    pos: ChunkPos
    cache: Cache
    stage: StagedChunkEnum
    raws: seq[LoadedBytes]     ## tkDecode: region-file bytes to turn into chunks.
    lod: LodJob                ## tkLod
    owner: GenerationExecutor  ## The handle its result goes back to (see `pool`).

  GenerationExecutor* = ref object
    workers*: int
    mask*: int
    jp: JobPool              ## The shared pool (set on the pool root only; nil with no workers).
    owner: int               ## This handle's owner id in `jp`.
    done: seq[RecvChunk]     ## Guarded by gGenLock.
    lodDone: seq[LodJob]     ## finished summaries of this handle (gGenLock)
    lodInFlight*: int        ## Tick thread only.
    inFlight*: int           ## Submitted to a worker and not yet handed back by `pollCompleted`. Tick thread only.
    pool: GenerationExecutor ## nil for the pool root. Every level's schedule gets its own handle on the shared pool, with
                             ## its own result queue and in-flight count: results must go back to the schedule (the
                             ## dimension) whose chunks they hold, never to another one's.
    stageUs: array[16, int64]   ## Pool root only, guarded by gGenLock.
    stageN: array[16, int64]
    inlineUs: array[16, int64]
    lastStats: Time
    stats: bool

var gExec: GenerationExecutor = nil
  ## The one executor root; the job procs are plain `nimcall`s over an index and find everything from here.
var gGenLock: Lock
var gGenLockInit = false
var gTasks: seq[GenTask] = @[]
var gFreeTasks: seq[int] = @[]

proc sleepWin(ms: uint32) {.stdcall, importc: "Sleep", dynlib: "kernel32.dll".}

proc ensureGenLock() =
  if not gGenLockInit:
    initLock(gGenLock)
    gGenLockInit = true

proc envNum(name: string): int =
  ## -1 when unset or not a plain number.
  let raw = getEnv(name)
  if raw.len == 0:
    return -1
  var v = 0
  for ch in raw:
    if ch < '0' or ch > '9':
      return -1
    v = v * 10 + (ord(ch) - ord('0'))
  v

proc envInt(name: string, default: int): int =
  let v = envNum(name)
  if v < 0: default else: v

proc chunkWorkerCount(): int =
  ## Workers for chunk generation from the thread plan; 0 unless MC_CHUNK_WORKERS or MC_THREADS is set.
  let envChunk = envNum("MC_CHUNK_WORKERS")
  let envThreads = envNum("MC_THREADS")
  if envChunk < 0 and envThreads < 0:
    return 0
  planThreads(0, 0, countProcessors(), envThreads, envChunk).chunkWorkers

proc putTask(t: GenTask): pointer =
  acquire(gGenLock)
  var idx = 0
  if gFreeTasks.len > 0:
    idx = gFreeTasks[gFreeTasks.len - 1]
    gFreeTasks.setLen(gFreeTasks.len - 1)
    gTasks[idx] = t
  else:
    gTasks.add(t)
    idx = gTasks.len - 1
  release(gGenLock)
  cast[pointer](idx + 1)

proc takeTask(arg: pointer): GenTask =
  acquire(gGenLock)
  let idx = cast[int](arg) - 1
  result = gTasks[idx]
  gTasks[idx] = GenTask()
  gFreeTasks.add(idx)
  release(gGenLock)

proc genJob(arg: pointer): int {.nimcall, raises.} =
  ## Normal lane: one stage of one chunk. Never raises.
  var t = takeTask(arg)
  let owner = t.owner
  let stage = ord(t.stage)
  let t0 = getTime()
  var r: RecvChunk
  try:
    r = runGeneration(t.host, t.pos, t.cache, t.stage)
  except:
    r = RecvChunk(kind: RecvChunkKind.GenerationFailure, pos: t.pos, stage: t.stage, error: "generation raised")
  let us = (getTime() - t0).inMicroseconds
  t = GenTask()
  acquire(gGenLock)
  owner.done.add(r)
  let root = gExec
  root.stageUs[stage] += us
  root.stageN[stage] += 1
  release(gGenLock)
  0

proc decodeJob(arg: pointer): int {.nimcall, raises.} =
  ## Normal lane: a decode batch; one result per entry. Never raises.
  var t = takeTask(arg)
  let owner = t.owner
  var results = newSeq[RecvChunk](0)
  try:
    ioDecodeBatch(t.host, t.raws, results)
  except:
    for ri in results.len ..< t.raws.len:
      try:
        let pos = chunkPos(t.raws[ri].x, t.raws[ri].z)
        results.add(RecvChunk(kind: RecvChunkKind.IO, pos: pos, io: protoChunk(newProtoChunk(pos.x, pos.y, t.host.worldGen))))
      except:
        discard
  t = GenTask()
  acquire(gGenLock)
  for ri in 0 ..< results.len:
    owner.done.add(results[ri])
  release(gGenLock)
  0

proc lodJob(arg: pointer): int {.nimcall, raises.} =
  ## Background lane: one distant-terrain summary. Never raises.
  var t = takeTask(arg)
  let owner = t.owner
  let lt0 = getTime()
  try:
    runLodJob(t.lod)
  except:
    discard
  t.lod.micros = (getTime() - lt0).inMicroseconds
  acquire(gGenLock)
  owner.lodDone.add(t.lod)
  release(gGenLock)
  0

proc newGenerationExecutor*(workers: int, mask: int): GenerationExecutor =
  ensureGenLock()
  GenerationExecutor(workers: workers, mask: mask, done: @[], lodDone: @[], inFlight: 0, lastStats: getTime(),
    stats: getEnv("MC_GEN_STATS") == "1")

proc prewarmWorldgen*() =
  ## Fills, on this thread, every table generation would otherwise fill on first use, so the workers only read them. The
  ## ones filled per key as keys appear (template pools, templates, processor lists, replaceable-block tables, structure
  ## starts) are guarded by `genlock` instead.
  discard getLatestMap(RegistryKey(0))
  prewarmFeatureDefs()
  prewarmFeatureOrder()
  prewarmStructureJson()
  prewarmStructureSteps()
  prewarmBlockTags()
  prewarmTemplates()

proc startWorkers*(ex: GenerationExecutor) =
  ## Claims the process's shared job pool for `ex.workers` workers (or joins the live one: then its size wins).
  prewarmWorldgen()
  gExec = ex
  if ex.workers > 0:
    ex.jp = sharedJobPool(ex.workers + 1)
    ex.owner = allocOwner(ex.jp)
    if ex.jp.workers < ex.workers:
      echo "chunk generation: wanted " & $ex.workers & " workers, the shared pool has " & $ex.jp.workers
    ex.workers = ex.jp.workers

proc defaultAsyncMask(): int =
  var m = 0
  for st in ord(StagedChunkEnum.Empty) .. ord(StagedChunkEnum.Full):
    if st != ord(StagedChunkEnum.Spawn):
      m = m or (1 shl st)
  m

proc sharedExecutor*(): GenerationExecutor =
  ## A handle on the process's one worker pool (made on first use from the thread plan); every level's schedule shares the
  ## workers but has a handle of its own, so each gets back only its own results. With no workers configured it runs
  ## everything inline.
  if gExec == nil:
    let n = chunkWorkerCount()
    let mask = envInt("MC_CHUNK_ASYNC_MASK", defaultAsyncMask())
    let ex = newGenerationExecutor(n, mask)
    if n > 0:
      startWorkers(ex)
    else:
      gExec = ex
  let pool = gExec
  var h = 0
  if pool.jp != nil:
    h = allocOwner(pool.jp)
  GenerationExecutor(workers: pool.workers, mask: pool.mask, done: @[], lodDone: @[], inFlight: 0, pool: pool, owner: h,
    lastStats: pool.lastStats, stats: pool.stats)

proc poolOf(ex: GenerationExecutor): GenerationExecutor =
  if ex.pool != nil: ex.pool else: ex

proc isAsync*(ex: GenerationExecutor, stage: StagedChunkEnum): bool =
  ex.workers > 0 and ((ex.mask shr ord(stage)) and 1) == 1

proc submit*(ex: GenerationExecutor, host: ScheduleHost, pos: ChunkPos, cache: Cache, stage: StagedChunkEnum,
             sink: var seq[RecvChunk]) =
  ## Inline stages append their result to `sink` (the schedule's `recvChunk`); offloaded ones to the done queue.
  if not isAsync(ex, stage):
    let sp = poolOf(ex)
    if sp.stats:
      let t0 = getTime()
      sink.add(runGeneration(host, pos, cache, stage))
      let us = (getTime() - t0).inMicroseconds
      acquire(gGenLock)
      sp.inlineUs[ord(stage)] += us
      sp.stageN[ord(stage)] += 1
      release(gGenLock)
    else:
      sink.add(runGeneration(host, pos, cache, stage))
    return
  let p = poolOf(ex)
  let a = putTask(GenTask(kind: tkGen, host: host, pos: pos, cache: cache, stage: stage, owner: ex))
  inc ex.inFlight
  submitLane(p.jp, ex.owner, lnNormal, genJob, a)

proc submitDecode*(ex: GenerationExecutor, host: ScheduleHost, raws: seq[LoadedBytes]) =
  ## Hands region-file bytes to a worker to decode (`ioDecodeBatch`); one result per entry comes back through
  ## `pollCompleted`, counted in `inFlight` like generation results. Only with workers: callers check `ex.workers`.
  let p = poolOf(ex)
  let a = putTask(GenTask(kind: tkDecode, host: host, raws: raws, owner: ex))
  ex.inFlight += raws.len
  submitLane(p.jp, ex.owner, lnNormal, decodeJob, a)

proc submitLod*(ex: GenerationExecutor, job: LodJob): bool =
  ## Queues a summary on the Background lane; false (nothing queued) when the pool has no workers.
  let p = poolOf(ex)
  if p.workers <= 0 or p.jp == nil or p.jp.workers == 0:
    return false
  let a = putTask(GenTask(kind: tkLod, lod: job, owner: ex))
  inc ex.lodInFlight
  submitLane(p.jp, ex.owner, lnBackground, lodJob, a)
  true

proc dropPoolResults(ex: GenerationExecutor) =
  ## The pool's own per-job results (all zero: the payload travels in the done lists) are drained so its books stay empty.
  var scratch: seq[JobResult] = @[]
  discard drainDone(poolOf(ex).jp, ex.owner, scratch)

proc pollLodCompleted*(ex: GenerationExecutor, sink: var seq[LodJob]): int =
  ## Moves this handle's finished summaries into `sink`; how many.
  if ex.lodInFlight == 0:
    return 0
  acquire(gGenLock)
  result = ex.lodDone.len
  for i in 0 ..< ex.lodDone.len:
    sink.add(ex.lodDone[i])
  ex.lodDone.setLen(0)
  release(gGenLock)
  ex.lodInFlight -= result
  dropPoolResults(ex)

proc lodWorkers*(ex: GenerationExecutor): int =
  ## Worker threads the low-priority lane can use (0: run summaries inline).
  let p = poolOf(ex)
  if p.jp == nil or p.jp.workers == 0: 0 else: p.workers

proc statsLine*(ex: GenerationExecutor): string =
  ## MC_GEN_STATS only: the pool's queued jobs and the workers' busy time so far (idle time is no longer tracked: the shared
  ## pool does not time its waits).
  let p = poolOf(ex)
  acquire(gGenLock)
  var busy = 0'i64
  for st in 0 ..< 16:
    busy += p.stageUs[st]
  release(gGenLock)
  let pending = if p.jp != nil: laneDepth(p.jp, lnNormal) else: 0
  "pending=" & $pending & " busyMs=" & $(busy div 1000)

proc printStats(ex: GenerationExecutor) =
  acquire(gGenLock)
  var line = "chunkgen stats (workers=" & $ex.workers & "):"
  for st in 0 ..< 16:
    if ex.stageN[st] > 0:
      let total = ex.stageUs[st] + ex.inlineUs[st]
      line.add(" " & $StagedChunkEnum(st) & "=" & $ex.stageN[st] & "x" & $(total div ex.stageN[st]) & "us")
  release(gGenLock)
  echo line

proc pollCompleted*(ex: GenerationExecutor, sink: var seq[RecvChunk]): int =
  ## Moves every finished worker result into `sink`; how many.
  let p = poolOf(ex)
  if p.stats and (getTime() - p.lastStats).inSeconds >= 10:
    p.lastStats = getTime()
    printStats(p)
  if ex.workers == 0 or ex.inFlight == 0:
    return 0
  acquire(gGenLock)
  result = ex.done.len
  for i in 0 ..< ex.done.len:
    sink.add(ex.done[i])
  ex.done.setLen(0)
  release(gGenLock)
  ex.inFlight -= result
  dropPoolResults(ex)

proc waitCompleted*(ex: GenerationExecutor, ms: int) =
  ## Sleeps a moment so a caller that has nothing else to do does not spin while workers run.
  sleepWin(uint32(ms))

proc shutdown*(ex: GenerationExecutor) =
  ## Stops the workers once their queue is empty. Joins them. Only the pool root (not a handle) can be shut down; this shuts
  ## down the shared job pool, so every other user of it stops too.
  if ex.pool != nil or ex.workers == 0 or ex.jp == nil:
    return
  shutdown(ex.jp)
