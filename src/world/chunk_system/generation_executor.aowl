## Runs `runGeneration` on worker threads. No upstream file: pumpkin-world's `generation_work` runs on rayon threads and
## sends `(pos, RecvChunk::Generation)` back over a channel; this is that pair, with a mutex-protected job queue and result
## queue because aowlmony has no channel.
##
## Ownership: `occupyForGeneration` moves the Protos of a task's write square into its `Cache` and clears the holders'
## `chunk`, so while a job is queued or running the schedule (tick thread) holds no reference to anything in that cache and
## reads none of it; the cache comes back, whole, in a `RecvChunk`. Reference counts are atomic, so the refs a job shares
## with the tick thread (`ScheduleHost`, the generator, the portal) are safe to hold from two threads; they are read-only
## during generation (see the notes on each global in the commit that added this file).
##
## Which stages go to a worker is a bit mask over `StagedChunkEnum`; a stage outside it runs inline in `submit`, exactly
## as before, and its result is available at the next `pollCompleted`. `Spawn` is never offloaded: it creates entities in
## the world (`World.spawnEntity`, plugin hooks), which only the tick thread may touch.
##
## Configuration: `MC_CHUNK_WORKERS` (worker thread count, default 0 = everything inline, as the server always did) and
## `MC_CHUNK_ASYNC_MASK` (a decimal bit mask of stage ordinals; default every stage but Spawn). `MC_GEN_STATS=1` prints
## per-stage totals every ten seconds.
##
## A second, low-priority lane carries distant-terrain summaries (`LodJob`, world/generation/lodsummary.aowl, for the `jester:lod`
## channel): a worker takes one only when no generation or decode job waits, so summaries never delay a chunk somebody stands next
## to. `submitLod` refuses (false) without workers; the caller then runs the job inline within its own budget.

{.feature: "lenientnils".}

import std/locks
import std/rawthreads
import std/envvars
import std/times
import std/strutils
import std/cpuinfo
import ../../server/sim/threadcfg
import std/syncio
import ../chunkdata
import ../chunkio
import chunk_stage
import dag
import generation_cache
import worker_logic
from ../../generated/tag import getLatestMap, RegistryKey
from ../generation/feature/decode import prewarmFeatureDefs
from ../generation/feature/feature_order import prewarmFeatureOrder
from ../generation/structure/structures/jigsaw_placement import prewarmStructureJson
from ../generation/structure/protostructures import prewarmStructureSteps
from "../generation/structure/template/processor" import prewarmBlockTags
from "../generation/structure/template/cache" import prewarmTemplates
from ../generation/lodsummary import LodJob, runLodJob

type
  GenJob = object
    host: ScheduleHost
    pos: ChunkPos
    cache: Cache
    stage: StagedChunkEnum
    raws: seq[LoadedBytes]     ## A decode job (`decode`): region-file bytes to turn into chunks.
    decode: bool
    owner: GenerationExecutor  ## The handle its result goes back to (see `pool`).

  WorkerThread = ref object
    t: RawThread

  GenerationExecutor* = ref object
    workers*: int
    mask*: int
    lock: Lock
    wake: Cond
    jobs: seq[GenJob]
    jobHead: int
    done: seq[RecvChunk]
    lodJobs: seq[LodJob]     ## the low-priority lane (pool only), with the handle each result goes back to
    lodOwners: seq[GenerationExecutor]
    lodHead: int
    lodDone: seq[LodJob]     ## finished summaries of this handle
    lodInFlight*: int        ## Tick thread only.
    stopping: bool
    threads: seq[WorkerThread]
    inFlight*: int           ## Submitted to a worker and not yet handed back by `pollCompleted`. Tick thread only.
    pool: GenerationExecutor ## nil for the pool itself. Every level's schedule gets its own handle on the shared pool, with
                             ## its own result queue and in-flight count: results must go back to the schedule (the
                             ## dimension) whose chunks they hold, never to another one's.
    stageUs: array[16, int64]
    stageN: array[16, int64]
    inlineUs: array[16, int64]
    waitUs: int64            ## Worker time spent waiting for a job (stats only).
    lastStats: Time
    stats: bool

var gExec: GenerationExecutor = nil
  ## The one executor: the worker procs are plain `nimcall`s with a pointer argument and read it from here.

proc sleepWin(ms: uint32) {.stdcall, importc: "Sleep", dynlib: "kernel32.dll".}

proc envInt(name: string, default: int): int =
  let raw = getEnv(name)
  if raw.len == 0:
    return default
  var v = 0
  for ch in raw:
    if ch < '0' or ch > '9':
      return default
    v = v * 10 + (ord(ch) - ord('0'))
  v

proc workerMain(arg: pointer) {.nimcall.} =
  let ex = gExec
  while true:
    var job: GenJob
    acquire(ex.lock)
    let w0 = getTime()
    var waited = false
    while ex.jobHead >= ex.jobs.len and ex.lodHead >= ex.lodJobs.len and not ex.stopping:
      waited = true
      wait(ex.wake, ex.lock)
    if waited and ex.stats:
      ex.waitUs += (getTime() - w0).inMicroseconds
    if ex.jobHead >= ex.jobs.len and ex.stopping:
      release(ex.lock)
      return
    if ex.jobHead >= ex.jobs.len:
      # nothing of the chunk system waits: one summary from the low-priority lane
      let lj = ex.lodJobs[ex.lodHead]
      let lowner = ex.lodOwners[ex.lodHead]
      ex.lodJobs[ex.lodHead] = nil
      ex.lodOwners[ex.lodHead] = nil
      inc ex.lodHead
      if ex.lodHead == ex.lodJobs.len:
        ex.lodJobs.setLen(0)
        ex.lodOwners.setLen(0)
        ex.lodHead = 0
      release(ex.lock)
      let lt0 = getTime()
      try:
        runLodJob(lj)
      except:
        echo "chunk generation worker: a summary job raised; it is dropped"
      lj.micros = (getTime() - lt0).inMicroseconds
      acquire(ex.lock)
      lowner.lodDone.add(lj)
      release(ex.lock)
      continue
    job = ex.jobs[ex.jobHead]
    let owner = job.owner
    ex.jobs[ex.jobHead] = GenJob()
    inc ex.jobHead
    if ex.jobHead == ex.jobs.len:
      ex.jobs.setLen(0)
      ex.jobHead = 0
    release(ex.lock)
    if job.decode:
      var results = newSeq[RecvChunk](0)
      try:
        ioDecodeBatch(job.host, job.raws, results)
      except:
        echo "chunk generation worker: a decode batch raised; the chunks decoded so far are returned"
      job = GenJob()
      acquire(ex.lock)
      for ri in 0 ..< results.len:
        owner.done.add(results[ri])
      release(ex.lock)
      continue
    let stage = ord(job.stage)
    let t0 = getTime()
    var r = RecvChunk(kind: RecvChunkKind.Generation, pos: job.pos, cache: job.cache)
    try:
      r = runGeneration(job.host, job.pos, job.cache, job.stage)
    except:
      # A raise must neither kill the worker nor leave the job in flight: the unadvanced cache goes back like any result.
      echo "chunk generation worker: stage " & $job.stage & " raised; the unadvanced chunk goes back"
    let us = (getTime() - t0).inMicroseconds
    job = GenJob()
    acquire(ex.lock)
    owner.done.add(r)
    ex.stageUs[stage] += us
    ex.stageN[stage] += 1
    release(ex.lock)

proc newGenerationExecutor*(workers: int, mask: int): GenerationExecutor =
  result = GenerationExecutor(workers: workers, mask: mask, jobs: @[], jobHead: 0, done: @[], stopping: false,
    threads: @[], inFlight: 0, lastStats: getTime(), stats: getEnv("MC_GEN_STATS") == "1")
  initLock(result.lock)
  initCond(result.wake)

proc prewarmWorldgen*() =
  ## Fills, on this thread, every table generation would otherwise fill on first use, so the workers only read them. The
  ## ones filled per key as keys appear (template pools, templates, processor lists, replaceable-block tables, structure
  ## starts) are guarded by `genlock` instead.
  discard getLatestMap(RegistryKey(0))
  prewarmFeatureDefs()
  prewarmFeatureOrder()
  prewarmStructureJson()
  prewarmStructureSteps()
  prewarmBlockTags()
  prewarmTemplates()

proc startWorkers*(ex: GenerationExecutor) =
  prewarmWorldgen()
  gExec = ex
  for i in 0 ..< ex.workers:
    let w = WorkerThread()
    try:
      create(w.t, workerMain, nil)
      ex.threads.add(w)
    except:
      echo "chunk generation: could not start worker thread " & $i & "; continuing with " & $ex.threads.len
      break
  ex.workers = ex.threads.len

proc defaultAsyncMask(): int =
  var m = 0
  for st in ord(StagedChunkEnum.Empty) .. ord(StagedChunkEnum.Full):
    if st != ord(StagedChunkEnum.Spawn):
      m = m or (1 shl st)
  m

proc sharedExecutor*(): GenerationExecutor =
  ## A handle on the process's one worker pool (made on first use from the environment); every level's schedule shares the
  ## workers but has a handle of its own, so each gets back only its own results. With no workers configured it runs
  ## everything inline.
  if gExec == nil:
    let plan = planThreads(gThreadConfig, gReservedCores, countProcessors(), envInt("MC_THREADS", -1), envInt("MC_CHUNK_WORKERS", -1))
    let n = plan.chunkWorkers
    echo "threads: " & $plan.threads & " (" & plan.why & "), chunk workers: " & $n
    let mask = envInt("MC_CHUNK_ASYNC_MASK", defaultAsyncMask())
    let ex = newGenerationExecutor(n, mask)
    if n > 0:
      startWorkers(ex)
    else:
      gExec = ex
  let pool = gExec
  GenerationExecutor(workers: pool.workers, mask: pool.mask, jobs: @[], done: @[], inFlight: 0, pool: pool,
    lastStats: pool.lastStats, stats: pool.stats)

proc poolOf(ex: GenerationExecutor): GenerationExecutor =
  if ex.pool != nil: ex.pool else: ex

proc isAsync*(ex: GenerationExecutor, stage: StagedChunkEnum): bool =
  ex.workers > 0 and ((ex.mask shr ord(stage)) and 1) == 1

proc submit*(ex: GenerationExecutor, host: ScheduleHost, pos: ChunkPos, cache: Cache, stage: StagedChunkEnum,
             sink: var seq[RecvChunk]) =
  ## Inline stages append their result to `sink` (the schedule's `recvChunk`); offloaded ones to the done queue.
  if not isAsync(ex, stage):
    let sp = poolOf(ex)
    if sp.stats:
      let t0 = getTime()
      sink.add(runGeneration(host, pos, cache, stage))
      sp.inlineUs[ord(stage)] += (getTime() - t0).inMicroseconds
      sp.stageN[ord(stage)] += 1
    else:
      sink.add(runGeneration(host, pos, cache, stage))
    return
  let p = poolOf(ex)
  acquire(p.lock)
  p.jobs.add(GenJob(host: host, pos: pos, cache: cache, stage: stage, owner: ex))
  release(p.lock)
  inc ex.inFlight
  signal(p.wake)

proc submitDecode*(ex: GenerationExecutor, host: ScheduleHost, raws: seq[LoadedBytes]) =
  ## Hands region-file bytes to a worker to decode (`ioDecodeBatch`); one result per entry comes back through
  ## `pollCompleted`, counted in `inFlight` like generation results. Only with workers: callers check `ex.workers`.
  let p = poolOf(ex)
  acquire(p.lock)
  p.jobs.add(GenJob(host: host, raws: raws, decode: true, owner: ex))
  release(p.lock)
  ex.inFlight += raws.len
  signal(p.wake)

proc submitLod*(ex: GenerationExecutor, job: LodJob): bool =
  ## Queues a summary on the low-priority lane; false (nothing queued) when the pool has no workers.
  let p = poolOf(ex)
  if p.workers <= 0 or p.threads.len == 0:
    return false
  acquire(p.lock)
  p.lodJobs.add(job)
  p.lodOwners.add(ex)
  release(p.lock)
  inc ex.lodInFlight
  signal(p.wake)
  true

proc pollLodCompleted*(ex: GenerationExecutor, sink: var seq[LodJob]): int =
  ## Moves this handle's finished summaries into `sink`; how many.
  if ex.lodInFlight == 0:
    return 0
  let p = poolOf(ex)
  acquire(p.lock)
  result = ex.lodDone.len
  for i in 0 ..< ex.lodDone.len:
    sink.add(ex.lodDone[i])
  ex.lodDone.setLen(0)
  release(p.lock)
  ex.lodInFlight -= result

proc lodWorkers*(ex: GenerationExecutor): int =
  ## Worker threads the low-priority lane can use (0: run summaries inline).
  let p = poolOf(ex)
  if p.threads.len == 0: 0 else: p.workers

proc statsLine*(ex: GenerationExecutor): string =
  ## MC_GEN_STATS only: the pool's pending jobs and the workers' busy and idle time so far.
  let p = poolOf(ex)
  acquire(p.lock)
  var busy = 0'i64
  for st in 0 ..< 16:
    busy += p.stageUs[st]
  let pending = p.jobs.len - p.jobHead
  let waitUs = p.waitUs
  release(p.lock)
  "pending=" & $pending & " busyMs=" & $(busy div 1000) & " idleMs=" & $(waitUs div 1000)

proc printStats(ex: GenerationExecutor) =
  acquire(ex.lock)
  var line = "chunkgen stats (workers=" & $ex.workers & "):"
  for st in 0 ..< 16:
    if ex.stageN[st] > 0:
      let total = ex.stageUs[st] + ex.inlineUs[st]
      line.add(" " & $StagedChunkEnum(st) & "=" & $ex.stageN[st] & "x" & $(total div ex.stageN[st]) & "us")
  release(ex.lock)
  echo line

proc pollCompleted*(ex: GenerationExecutor, sink: var seq[RecvChunk]): int =
  ## Moves every finished worker result into `sink`; how many.
  let p = poolOf(ex)
  if p.stats and (getTime() - p.lastStats).inSeconds >= 10:
    p.lastStats = getTime()
    printStats(p)
  if ex.workers == 0 or ex.inFlight == 0:
    return 0
  acquire(p.lock)
  result = ex.done.len
  for i in 0 ..< ex.done.len:
    sink.add(ex.done[i])
  ex.done.setLen(0)
  release(p.lock)
  ex.inFlight -= result

proc waitCompleted*(ex: GenerationExecutor, ms: int) =
  ## Sleeps a moment so a caller that has nothing else to do does not spin while workers run.
  sleepWin(uint32(ms))

proc shutdown*(ex: GenerationExecutor) =
  ## Stops the workers once their queue is empty. Joins them. Only the pool itself (not a handle) can be shut down.
  if ex.pool != nil or ex.workers == 0 or ex.threads.len == 0:
    return
  acquire(ex.lock)
  ex.stopping = true
  release(ex.lock)
  broadcast(ex.wake)
  for i in 0 ..< ex.threads.len:
    join(ex.threads[i].t)
  ex.threads.setLen(0)
