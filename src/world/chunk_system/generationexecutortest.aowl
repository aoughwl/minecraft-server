## No upstream counterpart: the worker-thread executor must give the chunks the inline path gives. Twelve chunks spread
## over the overworld are generated stage by stage, once inline (generateSingleChunk) and once with four workers, all
## twelve in flight at once, and compared block for block, heightmap for heightmap.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../chunkdata
import ../blockstates
import ../world
import ../../config/lighting
import ../../generated/dimension
import ../generation/generator/generator
import ../generation/proto_chunk
import chunk_system

const
  Seed = 8222734'u64
  Stages = [StagedChunkEnum.Biomes, StagedChunkEnum.StructureStart, StagedChunkEnum.StructureReferences,
    StagedChunkEnum.Noise, StagedChunkEnum.Surface, StagedChunkEnum.Carvers, StagedChunkEnum.Features,
    StagedChunkEnum.Lighting, StagedChunkEnum.Spawn, StagedChunkEnum.Full]

let spots = [(0'i32, 0'i32), (40'i32, -17'i32), (-63'i32, 22'i32), (101'i32, 101'i32), (-200'i32, -80'i32),
  (7'i32, 301'i32), (-5'i32, -300'i32), (222'i32, 15'i32), (-120'i32, 140'i32), (64'i32, 64'i32), (-64'i32, -64'i32),
  (333'i32, -222'i32)]

proc newCacheFor(gen: WorldGenerator, cx, cz: int32): Cache =
  let radius = getDirectRadius(StagedChunkEnum.Full)
  let cache = newCache(cx - radius, cz - radius, radius * 2'i32 + 1'i32)
  var dx = -radius
  while dx <= radius:
    var dz = -radius
    while dz <= radius:
      cache.chunks.add(protoChunk(newProtoChunk(cx + dx, cz + dz, gen)))
      inc dz
    inc dx
  cache

# Inline reference.
var reference: seq[Chunk] = @[]
block:
  let gen = getWorldGen(Seed, OVERWORLD, false, @[], "")
  for i in 0 ..< spots.len:
    reference.add(generateSingleChunk(gen, noOpWorldPortal(), spots[i][0], spots[i][1], StagedChunkEnum.Full))

# The same, on workers: every chunk's stage s is submitted before any stage s+1.
let gen2 = getWorldGen(Seed, OVERWORLD, false, @[], "")
let host = noHostPublicMap()
host.worldGen = gen2
host.worldPortal = noOpWorldPortal()
host.lightingConfig = lecDefault
let ex = newGenerationExecutor(4, 0xFFF)
assert ex.workers == 4
startWorkers(ex)
var caches: seq[Cache] = @[]
for i in 0 ..< spots.len:
  caches.add(newCacheFor(gen2, spots[i][0], spots[i][1]))
for si in 0 ..< Stages.len:
  var sink: seq[RecvChunk] = @[]
  for i in 0 ..< spots.len:
    submit(ex, host, chunkPos(spots[i][0], spots[i][1]), caches[i], Stages[si], sink)
  var got = sink.len
  while got < spots.len:
    got += pollCompleted(ex, sink)
    if got < spots.len:
      waitCompleted(ex, 1)
  assert got == spots.len
  assert ex.inFlight == 0
  for r in sink:
    assert r.kind == RecvChunkKind.Generation
shutdown(ex)

for i in 0 ..< spots.len:
  let a = reference[i]
  let b = caches[i].chunks[midIndex(caches[i])]
  assert a.kind == ChunkKind.Level and b.kind == ChunkKind.Level
  let minY = a.level.section.minY
  for x in 0 ..< 16:
    for z in 0 ..< 16:
      for t in [chmWorldSurface, chmMotionBlocking, chmMotionBlockingNoLeaves]:
        assert getHeightmap(a.level.heightmap, t, int32(x), int32(z), minY) ==
          getHeightmap(b.level.heightmap, t, int32(x), int32(z), minY)
      for y in minY ..< minY + 384'i32:
        let (okA, idA) = getBlockAbsoluteY(a.level.section, x, y, z)
        let (okB, idB) = getBlockAbsoluteY(b.level.section, x, y, z)
        assert okA == okB
        assert idA == idB, "chunk " & $spots[i][0] & "," & $spots[i][1] & " differs at " & $x & "," & $y & "," & $z
echo "generationexecutortest ok"
