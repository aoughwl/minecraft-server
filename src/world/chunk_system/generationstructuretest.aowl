## `configured_seed_generates_vanilla_ancient_city_chunk`, `seed_zero_generates_the_vanilla_pillager_outpost_chunk` and
## `pillager_outpost_features_shape_ground_at_vanilla_height` from upstream's chunk_system/generation.rs. The third reads
## what placed features shape, so it needs generation/feature. Run from the repo root.
##
## This crashes today, in the compiler's closures rather than in structures: each call of a `GenerationCache` closure field
## takes a reference off the environment its fields share, so the 18th call in a step reads freed memory.
## structure/protostructurestest.aowl runs the first two without `GenerationCache`.
## Port of pumpkin-world/src/chunk_system/generation.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../blockstates
import ../world
import ../generation/proto_chunk
import ../../generated/dimension
import ../../util/vector3
import generation_cache

proc blockId(name: string): int =
  let (found, id) = blockIdByName(name)
  assert found, name
  id

proc features(seed: uint64, cx, cz: int32): ProtoChunk =
  let worldGen = getWorldGen(seed, OVERWORLD, false, @[], "")
  let chunk = generateSingleChunk(worldGen, noOpWorldPortal(), cx, cz, StagedChunkEnum.Features)
  assert chunk.kind == ChunkKind.Proto, "features stage should return a proto chunk"
  chunk.proto

proc countIn(chunk: ProtoChunk, x0, x1, z0, z1: int32, wanted: openArray[int]): (int, int) =
  ## (blocks in `wanted`, jigsaw blocks left)
  let jigsaw = blockId("jigsaw")
  var count = 0
  var jigsaws = 0
  for x in x0 ..< x1:
    for z in z0 ..< z1:
      for y in -64'i32 ..< 320'i32:
        let block1 = blockIdOf(getBlockState(chunk, vec3[int32](x, y, z)))
        for w in wanted:
          if block1 == w:
            inc count
        if block1 == jigsaw:
          inc jigsaws
  (count, jigsaws)

block configuredSeedGeneratesVanillaAncientCityChunk:
  let chunk = features(1782124772053846960'u64, 31, -12)
  let (cityBlocks, jigsawBlocks) = countIn(chunk, 496, 512, -192, -176,
    [blockId("deepslate_bricks"), blockId("polished_deepslate"), blockId("reinforced_deepslate"), blockId("sculk")])
  assert cityBlocks > 0, "reference chunk contains no Ancient City blocks"
  assert jigsawBlocks == 0, "jigsaw blocks were not replaced"
  echo "ancient city: ", cityBlocks, " blocks"

block seedZeroGeneratesTheVanillaPillagerOutpostChunk:
  let chunk = features(0'u64, 35, 103)
  let (outpostBlocks, jigsawBlocks) = countIn(chunk, 560, 576, 1648, 1664,
    [blockId("dark_oak_log"), blockId("dark_oak_planks"), blockId("dark_oak_fence")])
  assert outpostBlocks > 0, "reference chunk contains no outpost blocks"
  assert jigsawBlocks == 0, "jigsaw blocks were not replaced"
  echo "outpost: ", outpostBlocks, " blocks"

block pillagerOutpostFeaturesShapeGroundAtVanillaHeight:
  let chunk = features(1782124772053846960'u64, 73, -82)
  let grass = blockId("grass_block")
  assert blockIdOf(getBlockState(chunk, vec3[int32](1173, 70, -1311))) == grass
  assert blockIdOf(getBlockState(chunk, vec3[int32](1173, 70, -1305))) == grass
  let cageChunk = features(1782124772053846960'u64, 73, -84)
  assert blockIdOf(getBlockState(cageChunk, vec3[int32](1183, 68, -1330))) == grass

echo "generation structures: ok"
