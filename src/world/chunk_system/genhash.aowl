## No upstream counterpart: prints, for a fixed seed, a hash per chunk of its blocks, biomes, heightmaps and light, from the
## inline generator (generateSingleChunk, which is deterministic). Run before and after a change to generation or lighting
## and compare the output: a faster but different world shows here.

{.feature: "lenientnils".}

import std/syncio
import std/assertions
import ../chunkdata
import ../blockstates
import ../world
import ../../generated/dimension
import ../generation/generator/generator
import ../generation/proto_chunk
from ../../util/random/rustnum import wrapAdd, wrapMul
import chunk_system

const Seed = 8222734'u64

let spots = [(0'i32, 0'i32), (1'i32, 0'i32), (0'i32, 1'i32), (40'i32, -17'i32), (-63'i32, 22'i32), (101'i32, 101'i32),
  (-200'i32, -80'i32), (7'i32, 301'i32), (-5'i32, -300'i32), (222'i32, 15'i32), (-120'i32, 140'i32), (64'i32, 64'i32),
  (-64'i32, -64'i32), (333'i32, -222'i32), (12'i32, -9'i32), (-30'i32, 31'i32)]

proc hex64(v: uint64): string =
  result = ""
  var i = 15
  while i >= 0:
    let d = int((v shr uint64(i * 4)) and 15'u64)
    result.add("0123456789abcdef"[d])
    dec i

var h = 1469598103934665603'u64
proc mix(v: uint64) =
  h = cast[uint64](wrapMul(cast[int64](h xor v), 1099511628211'i64))

let gen = getWorldGen(Seed, OVERWORLD, false, @[], "")
for i in 0 ..< spots.len:
  let c = generateSingleChunk(gen, noOpWorldPortal(), spots[i][0], spots[i][1], StagedChunkEnum.Full)
  assert c.kind == ChunkKind.Level
  let minY = c.level.section.minY
  h = 1469598103934665603'u64
  for x in 0 ..< 16:
    for z in 0 ..< 16:
      for y in minY ..< minY + 384'i32:
        let (ok, id) = getBlockAbsoluteY(c.level.section, x, y, z)
        mix(uint64(id) + (if ok: 1'u64 else: 0'u64))
  let blocks = h
  h = 1469598103934665603'u64
  for x in 0 ..< 16:
    for z in 0 ..< 16:
      var y = minY
      while y < minY + 384'i32:
        let (ok, b) = getRoughBiomeAbsoluteY(c.level.section, x, y, z)
        mix(uint64(b) + (if ok: 1'u64 else: 0'u64))
        y += 4'i32
  let biomes = h
  h = 1469598103934665603'u64
  for x in 0 ..< 16:
    for z in 0 ..< 16:
      for t in [chmWorldSurface, chmMotionBlocking, chmMotionBlockingNoLeaves]:
        mix(uint64(getHeightmap(c.level.heightmap, t, int32(x), int32(z), minY)))
  let heights = h
  h = 1469598103934665603'u64
  let light = c.level.lightEngine
  for s in 0 ..< light.skyLight.len:
    mix(uint64(light.skyLight[s].default))
    for b in light.skyLight[s].data:
      mix(uint64(b))
  let sky = h
  h = 1469598103934665603'u64
  for s in 0 ..< light.blockLight.len:
    mix(uint64(light.blockLight[s].default))
    for b in light.blockLight[s].data:
      mix(uint64(b))
  let blk = h
  echo "chunk " & $spots[i][0] & "," & $spots[i][1] & " blocks=" & hex64(blocks) & " biomes=" & hex64(biomes) &
    " heights=" & hex64(heights) & " sky=" & hex64(sky) & " blocklight=" & hex64(blk)
echo "genhash done"
