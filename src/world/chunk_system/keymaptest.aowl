## Checks keymap.aowl against a plain list under random inserts and removals (the backward shift and the swap-remove are
## where it can go wrong).

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import dag
import keymap

type Holder = ref object
  v: int

var seed = 12345'u64
proc rnd(n: int): int =
  seed = seed * 6364136223846793005'u64 + 1442695040888963407'u64
  int((seed shr 33) mod uint64(n))

var m = initKeyMap[Holder]()
var refKeys: seq[ChunkPos] = @[]
var refVals: seq[int] = @[]

proc refFind(p: ChunkPos): int =
  for i in 0 ..< refKeys.len:
    if refKeys[i] == p:
      return i
  -1

proc check() =
  assert m.len == refKeys.len
  for i in 0 ..< refKeys.len:
    assert m.hasKey(refKeys[i])
    let h = m.getOrDefault(refKeys[i], nil)
    assert h != nil and h.v == refVals[i]
  var seen = 0
  for pos, h in pairs(m):
    let at = refFind(pos)
    assert at >= 0 and refVals[at] == h.v
    inc seen
  assert seen == refKeys.len

for step in 0 ..< 20000:
  # A small coordinate range makes collisions and re-use of slots common.
  let p = ChunkPos(x: int32(rnd(40) - 20), y: int32(rnd(40) - 20))
  let at = refFind(p)
  if rnd(3) == 0:
    if at >= 0:
      refKeys.delete(at)
      refVals.delete(at)
    m.del(p)
  else:
    let v = rnd(1000000)
    if at >= 0:
      refVals[at] = v
    else:
      refKeys.add(p)
      refVals.add(v)
    m[p] = Holder(v: v)
  assert m.hasKey(p) == (refFind(p) >= 0)
  if step mod 500 == 0:
    check()
check()

var s = initNodeSet()
var cs = initChunkSet()
for i in 0 ..< 5000:
  let k = NodeKey(index: int32(rnd(300)), version: uint32(rnd(3)))
  s.incl(k)
  if rnd(2) == 0:
    s.excl(k)
    assert not s.contains(k)
  cs.incl(ChunkPos(x: int32(rnd(50)), y: int32(rnd(50))))
  cs.excl(ChunkPos(x: int32(rnd(50)), y: int32(rnd(50))))
var n = 0
for k in items(s):
  assert s.contains(k)
  inc n
assert n == s.len
for p in items(cs):
  assert cs.contains(p)
for i in 0 ..< 300:
  s.excl(NodeKey(index: int32(i), version: 0'u32))
  s.excl(NodeKey(index: int32(i), version: 1'u32))
  s.excl(NodeKey(index: int32(i), version: 2'u32))
assert s.len == 0
echo "keymaptest ok"
