## Known answers for the codecs in chunkcompress.aowl. The xxHash values are the
## reference vectors; the zlib and gzip inputs below were produced by Python's zlib and
## gzip modules, so they prove interop rather than only a round trip.
import std/[syncio, assertions]
import chunkcompress

proc b(s: string): seq[byte] =
  result = newSeq[byte](s.len)
  for i, c in s: result[i] = byte(c)

proc pattern(n: int): seq[byte] =
  result = newSeq[byte](n)
  for i in 0 ..< n: result[i] = byte((i * i) mod 7 + (i div 300) mod 200)

# xxHash reference vectors.
assert xxh64(b("")) == 0xEF46DB3751D8E999'u64
assert xxh64(b("abc")) == 0x44BC2CF5AD770999'u64
assert xxh32(b("")) == 0x02CC5D05'u32
assert xxh32(b("abc")) == 0x32D153FF'u32

# zlib.compress(b"hello hello hello hello") from Python.
let zref: seq[byte] = @[0x78'u8, 0x9c, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0xc8, 0x40, 0x27, 0x01, 0x68, 0x03, 0x08, 0xb1]
let z = zlibDecompress(zref)
assert z.ok, z.msg
assert z.data == b("hello hello hello hello")

# gzip.compress(b"abc", mtime=0) from Python.
let gref: seq[byte] = @[0x1f'u8, 0x8b, 0x08, 0, 0, 0, 0, 0, 0x02, 0xff, 0x4b, 0x4c, 0x4a, 0x06, 0, 0xc2, 0x41, 0x24, 0x35, 3, 0, 0, 0]
let g = gzipDecompressBytes(gref)
assert g.ok, g.msg
assert g.data == b("abc")

# A corrupt stream is an error, not empty output.
assert not zlibDecompress(b("not zlib at all")).ok
assert not gzipDecompressBytes(b("not gzip")).ok

for n in [0, 1, 15, 300, 70000, 2_000_000]:
  let raw = pattern(n)
  let zc = zlibCompress(raw)
  assert zc.ok and zlibDecompress(zc.data).data == raw
  let gc = gzipCompressBytes(raw)
  assert gc.ok and gc.data[0] == 0x1f'u8 and gc.data[1] == 0x8b'u8
  assert gzipDecompressBytes(gc.data).data == raw
  let zs = zstdCompressBytes(raw)
  assert zs.ok
  let zd = zstdDecompressBytes(zs.data)
  assert zd.ok, zd.msg
  assert zd.data == raw
  let lc = lz4Compress(raw)
  assert lc.ok
  let ld = lz4Decompress(lc.data)
  assert ld.ok, ld.msg
  assert ld.data == raw
  if n >= 70000:
    assert lc.data.len < raw.len, "lz4 should shrink a repetitive buffer"

# A hand-built LZ4Java stream with one LZ4-compressed block: literal "abcd" then a match
# of length 8 at offset 4, then the five trailing literals the format requires.
block lz4Known:
  let body: seq[byte] = @[0x44'u8, byte('a'), byte('b'), byte('c'), byte('d'), 0x04, 0x00,
    0x50, byte('v'), byte('w'), byte('x'), byte('y'), byte('z')]
  let plain = b("abcdabcdabcdvwxyz")
  var s = b("LZ4Block")
  s.add(0x26'u8)
  let fields = [uint32(body.len), uint32(plain.len), xxh32(plain, 0x9747B28C'u32) and 0x0FFFFFFF'u32]
  for v in fields:
    for i in 0 ..< 4: s.add(byte((v shr (8 * i)) and 0xFF'u32))
  for x in body: s.add(x)
  let d = lz4Decompress(s)
  assert d.ok, d.msg
  assert d.data == plain

echo "chunkcompress: all checks passed"
