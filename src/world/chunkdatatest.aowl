## Round-trip test for chunkdata.aowl - actually run, not just checked.
## Verifies the heightmap 9-bit packing against upstream's own bit-shape
## (7 columns/i64 word, no cross-word values) and ChunkSections'
## multi-section block get/set against the underlying PalettedContainer.

import std/[syncio, assertions]
import chunkdata

proc testHeightmaps() =
  var h = newChunkHeightmaps()
  let minY = -64'i32

  # Every column in a 16x16 area, with a distinct height per column so a
  # packing bug (wrong shift/mask/word) would corrupt a neighbor.
  for x in 0'i32 ..< 16:
    for z in 0'i32 ..< 16:
      let height = minY + x * 16 + z + 1
      setHeightmap(h, chmMotionBlocking, x, z, height, minY)

  for x in 0'i32 ..< 16:
    for z in 0'i32 ..< 16:
      let expected = minY + x * 16 + z + 1
      let got = getHeightmap(h, chmMotionBlocking, x, z, minY)
      assert got == expected, "heightmap mismatch at (" & $x & "," & $z & "): got " & $got & " want " & $expected

  # A never-set heightmap type returns minY - 1 (upstream's "unset" sentinel).
  assert getHeightmap(h, chmWorldSurface, 0, 0, minY) == minY - 1

  # Setting one type doesn't disturb another.
  setHeightmap(h, chmWorldSurface, 5, 5, 100, minY)
  assert getHeightmap(h, chmMotionBlocking, 5, 5, minY) == minY + 5 * 16 + 5 + 1
  assert getHeightmap(h, chmWorldSurface, 5, 5, minY) == 100

  echo "heightmap packing: OK"

proc testChunkSections() =
  let minY = -64'i32
  var s = newChunkSections(24, minY, 0'u32, 0'u32) # 24 sections = -64..320

  # Set a distinct block-state id at several points spanning multiple
  # sections (Y=-64 is section 0, Y=319 is section 23) and confirm they
  # read back correctly and don't bleed into neighbors.
  let points = @[
    (0'i32, -64'i32, 0'i32, 111'u32),
    (15'i32, -1'i32, 15'i32, 222'u32),
    (8'i32, 0'i32, 8'i32, 333'u32),
    (3'i32, 319'i32, 3'i32, 444'u32),
  ]
  # Avoid `for (a, b, ...) in seqOfTuples` - a known aowlmony gotcha
  # (tuple-destructure over a local seq can mis-bind/crash the parser).
  for i in 0 ..< points.len:
    let p = points[i]
    discard setBlock(s, p[0], p[1], p[2], p[3])

  for i in 0 ..< points.len:
    let p = points[i]
    let got = getBlock(s, p[0], p[1], p[2])
    assert got == p[3], "block mismatch at index " & $i & ": got " & $got & " want " & $p[3]

  # Untouched cell stays at the default.
  assert getBlock(s, 1, 1, 1) == 0'u32

  assert sectionIndex(s, minY) == 0
  assert sectionIndex(s, 319'i32) == 23 # world Y=319 is the top of a -64..319 (24-section) range

  echo "chunk sections block get/set: OK"

testHeightmaps()
testChunkSections()
echo "all chunkdata checks passed"

# --- upstream's #[test] vectors --------------------------------------------------------------

import blockstates, palette
import tick, tickscheduler

proc sid(name: string): uint32 =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

block randomTickCacheInitializesFromPaletteContents:
  var sections = @[newBlockPalette(), newBlockPalette()]
  discard sections[1].set(0, 0, 0, sid("lava"))
  let (cache, _) = buildRandomTickSectionsCache(sections)
  assert cache.len == 2
  assert not isRandomlyTicking(cache[0])
  assert cache[1].randomTickingFluidCount > 0'u16
  assert isRandomlyTicking(cache[1])

block randomTickCacheUpdatesOnBlockMutation:
  let minY = -64'i32
  var sections = newChunkSections(1, minY)
  assert sections.randomTickSections.len == 0 or not isRandomlyTicking(sections.randomTickSections[0])
  let wheat = sid("wheat")
  assert hasRandomTicks(wheat)
  sections.setBlockAbsoluteY(0, minY, 0, wheat)
  assert sections.randomTickSections[0].randomTickingBlockCount == 1'u16
  assert sections.randomTickSections[0].randomTickingFluidCount == 0'u16
  assert isRandomlyTicking(sections.randomTickSections[0])
  assert sections.randomlyTickingMask == 1'u32
  sections.setBlockAbsoluteY(0, minY, 0, sid("stone"))
  assert sections.randomTickSections[0].randomTickingBlockCount == 0'u16
  assert sections.randomTickSections[0].randomTickingFluidCount == 0'u16
  assert not isRandomlyTicking(sections.randomTickSections[0])
  assert sections.randomlyTickingMask == 0'u32
  sections.setBlockAbsoluteY(0, minY, 0, sid("lava"))
  assert sections.randomTickSections[0].randomTickingFluidCount > 0'u16
  assert isRandomlyTicking(sections.randomTickSections[0])

block heightmapIsOpaque:
  let air = sid("air")
  let stone = sid("stone")
  let leaves = sid("oak_leaves")
  let water = sid("water")
  assert not isOpaque(chmWorldSurface, air)
  assert isOpaque(chmWorldSurface, stone)
  assert isOpaque(chmWorldSurface, leaves)
  assert isOpaque(chmWorldSurface, water)
  assert not isOpaque(chmMotionBlocking, air)
  assert isOpaque(chmMotionBlocking, stone)
  assert isOpaque(chmMotionBlocking, leaves)
  assert isOpaque(chmMotionBlocking, water)
  assert not isOpaque(chmMotionBlockingNoLeaves, air)
  assert isOpaque(chmMotionBlockingNoLeaves, stone)
  assert not isOpaque(chmMotionBlockingNoLeaves, leaves)
  assert isOpaque(chmMotionBlockingNoLeaves, water)

block lightContainer:
  var l = newLightEmpty(0'u8)
  assert l.isEmpty and l.get(3, 4, 5) == 0'u8
  l.set(3, 4, 5, 0'u8)
  assert l.isEmpty  # same as the default, stays empty
  l.set(3, 4, 5, 9'u8)
  assert not l.isEmpty and l.data.len == LightArraySize
  assert l.get(3, 4, 5) == 9'u8 and l.get(2, 4, 5) == 0'u8
  # index = 4*256 + 5*16 + 3 = 1107: odd, so the high nibble of byte 553.
  assert l.data[553] == 0x90'u8
  l.set(2, 4, 5, 6'u8)
  assert l.data[553] == 0x96'u8
  var f = newLightFilled(15'u8)
  assert f.data[0] == 0xFF'u8
  f.fill(3'u8)
  assert f.get(15, 15, 15) == 3'u8
  assert defaultLightContainer().get(0, 0, 0) == 15'u8

block heightmapUpdateAndCalculate:
  let stone = sid("stone")
  let leaves = sid("oak_leaves")
  var c = newChunkData(0'i32, 0'i32, newChunkSections(4, -64'i32))
  c.heightmap = calculateHeightmap(c)
  assert getHeightmap(c.heightmap, chmWorldSurface, 2, 3, -64'i32) == -65'i32
  # Upstream's stored value is y - min_y + 1; a block at min_y stores 1.
  c.setBlockAbsoluteY(2, -64'i32, 3, stone)
  assert getHeightmap(c.heightmap, chmWorldSurface, 2, 3, -64'i32) == -64'i32
  c.setBlockAbsoluteY(2, -20'i32, 3, leaves)
  assert getHeightmap(c.heightmap, chmWorldSurface, 2, 3, -64'i32) == -20'i32
  assert getHeightmap(c.heightmap, chmMotionBlocking, 2, 3, -64'i32) == -20'i32
  assert getHeightmap(c.heightmap, chmMotionBlockingNoLeaves, 2, 3, -64'i32) == -64'i32
  # Removing the top block rescans down.
  c.setBlockAbsoluteY(2, -20'i32, 3, sid("air"))
  assert getHeightmap(c.heightmap, chmWorldSurface, 2, 3, -64'i32) == -64'i32
  c.setBlockAbsoluteY(2, -64'i32, 3, sid("air"))
  assert getHeightmap(c.heightmap, chmWorldSurface, 2, 3, -64'i32) == -65'i32
  assert getHighestNonEmptySubchunk(c) == 0
  c.setBlockAbsoluteY(5, -10'i32, 5, stone)
  assert getHighestNonEmptySubchunk(c) == 3
  let hm = calculateHeightmap(c)
  assert getHeightmap(hm, chmWorldSurface, 5, 5, -64'i32) == -10'i32
  assert getHeightmap(hm, chmWorldSurface, 0, 0, -64'i32) == -65'i32

block sectionsApi:
  var s = newChunkSections(2, -64'i32)
  assert getBlockAbsoluteY(s, 0, -65'i32, 0)[0] == false   # below the world
  assert getBlockAbsoluteY(s, 0, -33'i32, 0)[0] == true
  assert getBlockAbsoluteY(s, 0, -32'i32, 0)[0] == false   # above the world
  discard s.setBlockAbsoluteY(1, -40'i32, 2, 5'u32)
  assert getTopY(s, 1, 2, -33'i32) == (true, -40'i32)
  assert getTopY(s, 0, 0, -33'i32)[0] == false
  s.setRelativeBiome(3, 5, 3, 9'u8)   # section 1, biome cell y 1
  assert getNoiseBiome(s, 1, 3, 1, 3) == (true, 9'u8)
  assert getRoughBiomeAbsoluteY(s, 15, -64'i32 + 16 + 4, 15) == (true, 9'u8)
  assert getRoughBiomeAbsoluteY(s, 0, -65'i32, 0)[0] == false
  assert dumpBlocks(s).len == 8192 and dumpBiomes(s).len == 128

echo "chunkdata: upstream vectors passed"
