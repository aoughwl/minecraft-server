## The chunk NBT form: exact keys and palette shape, vanilla input, what survives a rewrite.

import std/[syncio, assertions]
import ../nbt/[tag, nbtbase, serializer, deserializer, nbtdoc]
import blockstates, palette, chunkdata, chunkformat, anvilformat, tick, tickscheduler, nbtget

proc sid(name: string): uint32 =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc testChunkNbtForm() =
  # Exact keys and palette form a vanilla reader expects.
  let stone = sid("stone")
  let log = sid("oak_log")
  var s = newChunkSections(2, -64'i32)
  discard s.setBlockAbsoluteY(0, -64'i32, 0, stone)
  discard s.setBlockAbsoluteY(1, -64'i32, 0, log)
  let c = newChunkData(3'i32, -4'i32, s)
  c.status = csFull
  c.lightPopulated = true
  c.inhabitedTime = 77'u64
  scheduleTick(c.blockTicks, ScheduledTick[string](delay: 5'u8, priority: tpHigh,
    position: blockPos(48, -60, -64), value: "minecraft:stone"), 0'u64)
  var be = newCompound()
  put(be, "id", stringTag("minecraft:chest"))
  put(be, "x", intTag(48))
  put(be, "y", intTag(-60))
  put(be, "z", intTag(-64))
  putBlockEntity(c, blockPos(48, -60, -64), be)
  let root = toRootCompound(c)
  assert nbtInt(root, "DataVersion") == (true, int32(WorldDataVersion))
  assert WorldDataVersion == 4790
  assert nbtInt(root, "xPos") == (true, 3'i32)
  assert nbtInt(root, "zPos") == (true, -4'i32)
  assert nbtInt(root, "yPos") == (true, -4'i32)
  assert nbtString(root, "Status") == (true, "minecraft:full")
  assert nbtByte(root, "isLightOn") == (true, 1'i8)
  assert nbtLong(root, "InhabitedTime") == (true, 77'i64)
  let (_, sections) = nbtList(root, "sections")
  assert sections.len == 2
  let sec0 = sections[0].compoundVal
  assert nbtByte(sec0, "Y") == (true, -4'i8)
  let (_, bs) = nbtCompound(sec0, "block_states")
  let (_, paletteList) = nbtList(bs, "palette")
  assert paletteList.len == 3
  assert nbtString(paletteList[0].compoundVal, "Name") == (true, "minecraft:stone")
  assert not paletteList[0].compoundVal.containsKey("Properties")
  # `from_cube` keeps first-appearance order, then `set` appends: stone, air, oak_log.
  assert nbtString(paletteList[1].compoundVal, "Name") == (true, "minecraft:air")
  assert nbtString(paletteList[2].compoundVal, "Name") == (true, "minecraft:oak_log")
  let (_, logProps) = nbtCompound(paletteList[2].compoundVal, "Properties")
  assert nbtString(logProps, "axis") == (true, "y")
  let (hasData, data) = nbtLongArray(bs, "data")
  assert hasData and data.len == 256
  # Cell 0 is palette 0, cell 1 palette 2, the rest palette 1, four bits each.
  assert data[0] == cast[int64](0x1111111111111120'u64)
  let (_, biomes) = nbtCompound(sec0, "biomes")
  assert stringList(biomes, "palette") == @["minecraft:badlands"]
  assert not biomes.containsKey("data")
  let (_, sec1States) = nbtCompound(sections[1].compoundVal, "block_states")
  assert not sec1States.containsKey("data")

  # And back, through bytes.
  let bytes = internalToBytes(c)
  assert bytes.ok
  assert bytes.bytes[0] == 0x0a'u8 and bytes.bytes[1] == 0'u8 and bytes.bytes[2] == 0'u8
  let parsed = internalFromBytes(bytes.bytes, 3'i32, -4'i32)
  assert parsed.ok, parsed.error
  assert dumpBlocks(parsed.chunk.section) == dumpBlocks(c.section)
  assert parsed.chunk.status == csFull and parsed.chunk.lightPopulated
  assert parsed.chunk.inhabitedTime == 77'u64
  assert parsed.chunk.pendingBlockEntities.len == 1
  assert parsed.chunk.pendingBlockEntities[0].pos == blockPos(48, -60, -64)
  let ticks = toSeq(parsed.chunk.blockTicks)
  assert ticks.len == 1 and ticks[0].delay == 5'u8 and ticks[0].priority == tpHigh
  assert ticks[0].value == "minecraft:stone"
  assert parsed.chunk.dirty == false

  # Wrong position and missing fields are parse errors, as upstream words them.
  let wrong = internalFromBytes(bytes.bytes, 9'i32, 9'i32)
  assert not wrong.ok and wrong.error == "Expected data for chunk 9,9 but got it for 3,-4!"
  var noX = newCompound()
  put(noX, "zPos", intTag(1))
  let missing = internalFromBytes(write(newNbt("", noX), nwmJava), 0'i32, 0'i32)
  assert not missing.ok and missing.error == "Missing xPos"

proc testVanillaForms() =
  # A section as vanilla writes it, including an upstream-form int palette for comparison, a light-only
  # section above the world, unknown root keys, and absent SkyLight.
  var root = newCompound()
  put(root, "DataVersion", intTag(4671))
  put(root, "xPos", intTag(1))
  put(root, "zPos", intTag(2))
  put(root, "yPos", intTag(-4))
  put(root, "Status", stringTag("minecraft:full"))
  put(root, "isLightOn", byteTag(1))
  put(root, "LastUpdate", longTag(123))
  var structures = newCompound()
  put(structures, "References", compoundTag(newCompound()))
  put(root, "structures", compoundTag(structures))

  var deepslateProps = newCompound()
  put(deepslateProps, "axis", stringTag("z"))
  var deepslate = newCompound()
  put(deepslate, "Name", stringTag("minecraft:deepslate"))
  put(deepslate, "Properties", compoundTag(deepslateProps))
  var bedrock = newCompound()
  put(bedrock, "Name", stringTag("minecraft:bedrock"))
  var mystery = newCompound()
  put(mystery, "Name", stringTag("minecraft:not_a_block"))
  var states = newCompound()
  put(states, "palette", listTag(@[compoundTag(bedrock), compoundTag(deepslate), compoundTag(mystery)]))
  var words = newSeq[int64](256)
  words[0] = 0x0000000000000021'i64  # cell 0 -> deepslate, cell 1 -> mystery
  put(states, "data", longArrayTag(words))
  var biomes = newCompound()
  put(biomes, "palette", stringListTag(@["minecraft:plains", "minecraft:desert"]))
  put(biomes, "data", longArrayTag(@[2'i64]))  # one bit each, cell 1 is desert
  var skyData = newSeq[int8](2048)
  for i in 0 ..< 2048: skyData[i] = cast[int8](0x77'u8)
  var sec0 = newCompound()
  put(sec0, "Y", byteTag(-4))
  put(sec0, "block_states", compoundTag(states))
  put(sec0, "biomes", compoundTag(biomes))
  put(sec0, "SkyLight", byteArrayTag(skyData))
  var airPal = newCompound()
  put(airPal, "Name", stringTag("minecraft:air"))
  var airStates = newCompound()
  put(airStates, "palette", listTag(@[compoundTag(airPal)]))
  var sec1 = newCompound()
  put(sec1, "Y", byteTag(-3))
  put(sec1, "block_states", compoundTag(airStates))
  var lightOnly = newCompound()
  put(lightOnly, "Y", byteTag(-2))
  put(lightOnly, "SkyLight", byteArrayTag(skyData))
  var below = newCompound()
  put(below, "Y", byteTag(-5))
  put(below, "SkyLight", byteArrayTag(skyData))
  put(root, "sections", listTag(@[compoundTag(below), compoundTag(sec0), compoundTag(sec1), compoundTag(lightOnly)]))
  var heightmaps = newCompound()
  put(heightmaps, "WORLD_SURFACE", longArrayTag(newSeq[int64](37)))
  put(heightmaps, "OCEAN_FLOOR", longArrayTag(newSeq[int64](37)))
  put(root, "Heightmaps", compoundTag(heightmaps))

  let before = unknownPaletteEntries
  let p = internalFromBytes(write(newNbt("", root), nwmJava), 1'i32, 2'i32)
  assert p.ok, p.error
  let c = p.chunk
  assert unknownPaletteEntries == before + 1
  assert c.section.count == 2, "light-only sections must not count: " & $c.section.count
  assert c.section.minY == -64'i32
  let (_, deepslateBlock) = blockIdByName("deepslate")
  # Palette indices: cell 0 = 1 (deepslate z), cell 1 = 2 (unknown, air), the rest 0 (bedrock).
  let props = stateProperties(get(c.section.blockSections[0], 0, 0, 0))
  assert blockIdOf(get(c.section.blockSections[0], 0, 0, 0)) == deepslateBlock
  assert props[0].name == "axis" and props[0].value == "z"
  assert isAir(get(c.section.blockSections[0], 1, 0, 0))
  assert blockNameOfState(get(c.section.blockSections[0], 2, 0, 0)) == "bedrock"
  assert biomeNameById(int(get(c.section.biomeSections[0], 0, 0, 0)))[1] == "plains"
  assert biomeNameById(int(get(c.section.biomeSections[0], 1, 0, 0)))[1] == "desert"
  assert c.dataVersion == 4671'i32
  # Absent SkyLight: section 0 holds 7s; section 1, absent with nothing above, is 15.
  assert c.lightEngine.skyLight[0].get(0, 0, 0) == 7'u8
  assert c.lightEngine.skyLight[1].get(0, 0, 0) == 15'u8

  # What upstream's writer would drop survives, and the version is not re-stamped.
  let out2 = toRootCompound(c)
  assert nbtInt(out2, "DataVersion") == (true, 4671'i32)
  assert nbtLong(out2, "LastUpdate") == (true, 123'i64)
  assert out2.containsKey("structures")
  let (_, hm2) = nbtCompound(out2, "Heightmaps")
  assert hm2.containsKey("OCEAN_FLOOR") and hm2.containsKey("WORLD_SURFACE")

  # Upstream's internal form still reads: an int palette and a byte biome palette.
  var r2 = newCompound()
  put(r2, "xPos", intTag(0))
  put(r2, "zPos", intTag(0))
  put(r2, "yPos", intTag(-4))
  var st2 = newCompound()
  put(st2, "palette", listTag(@[intTag(int32(sid("stone")))]))
  var bi2 = newCompound()
  put(bi2, "palette", listTag(@[byteTag(3)]))
  var s2 = newCompound()
  put(s2, "Y", byteTag(-4))
  put(s2, "block_states", compoundTag(st2))
  put(s2, "biomes", compoundTag(bi2))
  put(r2, "sections", listTag(@[compoundTag(s2)]))
  let p2 = internalFromBytes(writeUnnamed(newNbt("", r2), nwmJava), 0'i32, 0'i32)
  assert p2.ok, p2.error
  assert get(p2.chunk.section.blockSections[0], 5, 5, 5) == sid("stone")
  assert get(p2.chunk.section.biomeSections[0], 1, 1, 1) == 3'u32

proc testEntityChunk() =
  let e = newChunkEntityData(5'i32, -6'i32)
  var pig = newCompound()
  put(pig, "id", stringTag("minecraft:pig"))
  e.data.add(pig)
  let b = internalToBytesEntity(e)
  let p = internalFromBytesEntity(b.bytes, 5'i32, -6'i32)
  assert p.ok, p.error
  assert p.chunk.data.len == 1 and nbtString(p.chunk.data[0], "id") == (true, "minecraft:pig")
  let wrong = internalFromBytesEntity(b.bytes, 0'i32, 0'i32)
  assert not wrong.ok
  # The on-disk Position is an int array, the form vanilla reads.
  var reader = newNbtReader(nrmJava, b.bytes)
  let doc = read(reader)
  assert doc.isOk
  assert nbtIntArray(doc.value.rootTag, "Position") == (true, @[5'i32, -6'i32])

testChunkNbtForm()
testVanillaForms()
testEntityChunk()
echo "chunkformat: all checks passed"
