## Chunk I/O interfaces. Port of pumpkin-world/src/chunk/io/mod.rs
##
## `LoadedData<D, Err>` and the `ChunkSerializer` trait. Upstream's serializers are generic over the
## chunk type only to call `S::from_bytes` and `S::to_bytes` at their edges, so here they work in
## serialized bytes and the typed decode lives in filemanager.aowl. The trait's associated functions
## (`get_chunk_key`, `read`, `Default`) are `ChunkSerializerType`, a value standing for the type.
## The mpsc channel in `get_chunks` becomes a return value: this port has no async.
##
## `LevelFolder` is upstream's level.rs type; it lives here because the file manager needs it and
## aowlmony has no import cycles to lean on.

{.feature: "lenientnils".}

import chunkdata

type
  LevelFolder* = object
    rootFolder*: string
    dimFolder*: string
    regionFolder*: string
    entitiesFolder*: string
    poiFolder*: string

  LoadedKind* = enum
    ldLoaded   ## `LoadedData::Loaded`
    ldMissing  ## `LoadedData::Missing`
    ldError    ## `LoadedData::Error`

  LoadedBytes* = object
    ## `LoadedData<_, ChunkReadingError>` before the bytes are parsed.
    kind*: LoadedKind
    x*, z*: int32
    bytes*: seq[byte]
    error*: ChunkReadingError

  IoStatus* = object
    ok*: bool
    msg*: string

  ChunkWriteStatus* = object
    ok*: bool
    error*: ChunkWritingError

  ChunkSerializer* = ref object
    ## An instance of upstream's `impl ChunkSerializer`.
    shouldWrite*: proc(isWatched: bool): bool {.closure.}
    write*: proc(path: string): IoStatus {.closure.}
    updateChunk*: proc(x, z: int32, raw: seq[byte]): ChunkWriteStatus {.closure.}
    getChunk*: proc(x, z: int32): LoadedBytes {.closure.}

  SerializerReadResult* = object
    ok*: bool
    serializer*: ChunkSerializer
    error*: ChunkReadingError

  ChunkSerializerType* = ref object
    getChunkKey*: proc(x, z: int32): string {.closure.}
    makeDefault*: proc(): ChunkSerializer {.closure.}
    read*: proc(r: seq[byte]): SerializerReadResult {.closure.}

proc ioOk*(): IoStatus = IoStatus(ok: true, msg: "")
proc ioErr*(msg: string): IoStatus = IoStatus(ok: false, msg: msg)
proc writeOk*(): ChunkWriteStatus = ChunkWriteStatus(ok: true, error: writeErr(cweIoError))
proc writeFail*(kind: ChunkWritingErrorKind, msg: string): ChunkWriteStatus =
  ChunkWriteStatus(ok: false, error: writeErr(kind, msg))

proc loadedOk*(x, z: int32, bytes: sink seq[byte]): LoadedBytes =
  LoadedBytes(kind: ldLoaded, x: x, z: z, bytes: bytes, error: readErr(creIoError))

proc loadedMissing*(x, z: int32): LoadedBytes =
  LoadedBytes(kind: ldMissing, x: x, z: z, bytes: @[], error: readErr(creIoError))

proc loadedError*(x, z: int32, e: ChunkReadingError): LoadedBytes =
  LoadedBytes(kind: ldError, x: x, z: z, bytes: @[], error: e)

proc serializerOk*(s: ChunkSerializer): SerializerReadResult =
  SerializerReadResult(ok: true, serializer: s, error: readErr(creIoError))

proc serializerErr*(e: ChunkReadingError): SerializerReadResult =
  SerializerReadResult(ok: false, serializer: nil, error: e)

# aowlhexer lifts closure types only in a module that declares a closure proc or captures something,
# and a module that only declares `{.closure.}` fields gets plain function pointers in its C struct,
# so every capturing importer then fails to compile. This one closure makes the pass run here. See
# the repro in the port report; it can go once the compiler handles field-only modules.
proc closureLiftAnchor*(): proc(): bool {.closure.} =
  proc(): bool {.closure.} = true

# Call closure fields only from this module, the one that declares them. aowlhexer copies a closure field of a type from
# another module with no `=dup` and still destroys the copy, so a call from elsewhere, `s.write(...)` or through a local
# alike, drops the environment's refcount by one and soon frees it. See worker_logic.aowl in chunk_system.
proc shouldWriteOf*(s: ChunkSerializer, isWatched: bool): bool =
  let f = s.shouldWrite
  f(isWatched)

proc writeOf*(s: ChunkSerializer, path: string): IoStatus =
  let f = s.write
  f(path)

proc updateChunkOf*(s: ChunkSerializer, x, z: int32, raw: seq[byte]): ChunkWriteStatus =
  let f = s.updateChunk
  f(x, z, raw)

proc getChunkOf*(s: ChunkSerializer, x, z: int32): LoadedBytes =
  let f = s.getChunk
  f(x, z)

proc chunkKeyOf*(t: ChunkSerializerType, x, z: int32): string =
  let f = t.getChunkKey
  f(x, z)

proc makeDefaultOf*(t: ChunkSerializerType): ChunkSerializer =
  let f = t.makeDefault
  f()

proc readOf*(t: ChunkSerializerType, r: seq[byte]): SerializerReadResult =
  let f = t.read
  f(r)
