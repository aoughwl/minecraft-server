## The loaded-data shapes and a vtable round trip through `ChunkSerializer`.
import std/[syncio, assertions]
import chunkdata, chunkio

type Store = ref object
  bytes: seq[byte]

proc memorySerializer(store: Store): ChunkSerializer =
  ChunkSerializer(
    shouldWrite: proc(isWatched: bool): bool {.closure.} = not isWatched,
    write: proc(path: string): IoStatus {.closure.} = (if path.len > 0: ioOk() else: ioErr("no path")),
    updateChunk: proc(x, z: int32, raw: seq[byte]): ChunkWriteStatus {.closure.} =
      store.bytes = raw
      writeOk(),
    getChunk: proc(x, z: int32): LoadedBytes {.closure.} =
      if store.bytes.len == 0: loadedMissing(x, z) else: loadedOk(x, z, store.bytes))

proc main() =
  let a = loadedOk(1'i32, 2'i32, @[9'u8])
  assert a.kind == ldLoaded and a.x == 1'i32 and a.z == 2'i32 and a.bytes == @[9'u8]
  assert loadedMissing(3'i32, 4'i32).kind == ldMissing
  let e = loadedError(5'i32, 6'i32, readErr(creRegionIsInvalid, "bad"))
  assert e.kind == ldError and e.error.kind == creRegionIsInvalid and e.error.msg == "bad"
  assert ioOk().ok and not ioErr("x").ok
  assert writeOk().ok and writeFail(cweCompression, "x").error.kind == cweCompression

  let store = Store(bytes: newSeq[byte](0))
  let s = memorySerializer(store)
  assert shouldWriteOf(s, false) and not shouldWriteOf(s, true)
  assert getChunkOf(s, 0'i32, 0'i32).kind == ldMissing
  assert updateChunkOf(s, 0'i32, 0'i32, @[1'u8, 2'u8]).ok
  assert getChunkOf(s, 0'i32, 0'i32).bytes == @[1'u8, 2'u8]
  assert writeOf(s, "p").ok and not writeOf(s, "").ok

  let t = ChunkSerializerType(
    getChunkKey: proc(x, z: int32): string {.closure.} = $x & "." & $z,
    makeDefault: proc(): ChunkSerializer {.closure.} = s,
    read: proc(r: seq[byte]): SerializerReadResult {.closure.} =
      if r.len > 0: serializerOk(s) else: serializerErr(readErr(creInvalidHeader)))
  assert chunkKeyOf(t, 1'i32, -2'i32) == "1.-2"
  assert readOf(t, @[1'u8]).ok and not readOf(t, newSeq[byte](0)).ok

main()
echo "chunkio: all checks passed"
