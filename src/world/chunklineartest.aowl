## Port of the #[test] vectors in chunk/format/linear.rs, plus a corrupt bucket and a bad footer.
## Scratch files go under WORLDTEST_DIR when set, otherwise beside the exe.

import std/[syncio, assertions, envvars, cmdline]
import chunkdata, chunkio, chunklinear, worldfs
import anvilformat

proc scratchDir(): string =
  result = getEnv("WORLDTEST_DIR")
  if result.len == 0:
    result = parentDirW(paramStr(0)) & "/chunkformats_scratch"
  discard createDirAllW(result)

proc testLinearVectors() =
  # bitmap_round_trip
  var bm = newChunkBitmap()
  bm.set(0, true)
  bm.set(7, true)
  bm.set(1023, true)
  assert bm.get(0) and not bm.get(1) and bm.get(7) and not bm.get(8) and bm.get(1023) and not bm.get(1022)
  # nbt_features_empty_round_trip
  let enc = featuresToBytes(emptyFeatures())
  assert enc == @[0'u8]
  var c1 = ByteCursor(data: enc, pos: 0)
  let (ok1, dec1, _) = featuresFromBytes(c1)
  assert ok1 and dec1.keys.len == 0
  # nbt_features_round_trip
  let f = NbtFeatures(keys: @["version"], values: @[42'u32])
  var c2 = ByteCursor(data: featuresToBytes(f), pos: 0)
  let (ok2, dec2, _) = featuresFromBytes(c2)
  assert ok2 and dec2.keys == @["version"] and dec2.values == @[42'u32]
  # index_round_trip_grid{1,2,4}
  for gs in [1'u8, 2'u8, 4'u8]:
    let g = int(gs)
    for i in 0 ..< ChunkCount:
      let cx = i mod 32
      let cz = i div 32
      let stride = 32 div g
      let b = (cz div stride) * g + (cx div stride)
      let l = (cz mod stride) * stride + (cx mod stride)
      assert globalChunkIndex(b, l, gs) == i
  # superblock_round_trip
  let sb = LinearV2Superblock(newestTimestamp: 0xDEADBEEFCAFEBABE'u64, gridSize: 4'u8, regionX: -7'i32, regionZ: 13'i32)
  let encoded = superblockToBytes(sb)
  assert encoded.len == LinearSuperblockSize
  let (ok3, dec3, _) = superblockFromBytes(encoded)
  assert ok3 and dec3.newestTimestamp == sb.newestTimestamp and dec3.gridSize == 4'u8
  assert dec3.regionX == -7'i32 and dec3.regionZ == 13'i32
  # superblock_rejects_bad_signature
  var bad = superblockToBytes(LinearV2Superblock(newestTimestamp: 0'u64, gridSize: 2'u8, regionX: 0'i32, regionZ: 0'i32))
  bad[0] = bad[0] xor 0xFF'u8
  assert not superblockFromBytes(bad)[0]
  # bucket_entry_present_round_trip
  var buf = newSeq[byte](0)
  writeInto(BucketChunkEntry(timestamp: 12345'u64, hasData: true, data: newSeq[byte](64)), buf)
  var c4 = ByteCursor(data: buf, pos: 0)
  let (ok4, e4) = readFrom(c4)
  assert ok4 and e4.timestamp == 12345'u64 and e4.hasData and e4.data.len == 64
  # bucket_entry_absent_round_trip
  var buf2 = newSeq[byte](0)
  writeInto(BucketChunkEntry(timestamp: 0'u64, hasData: false, data: @[]), buf2)
  var c5 = ByteCursor(data: buf2, pos: 0)
  let (ok5, e5) = readFrom(c5)
  assert ok5 and not e5.hasData

proc testLinearCorruptBucket(base: string) =
  # A flipped byte in one bucket drops that bucket and keeps the others, as upstream's xxhash check does.
  let f = newLinearV2File()
  assert updateChunkLinear(f, 0'i32, 0'i32, @[1'u8, 2'u8, 3'u8]).ok
  assert updateChunkLinear(f, 31'i32, 31'i32, @[9'u8, 9'u8]).ok
  let path = base & "/corrupt.linear"
  assert writeLinear(f, path).ok
  let (_, bytes0) = readFileBytes(path)
  var bytes = bytes0
  # Superblock 26, bitmap 128, features 1, four 13-byte entries, then the first bucket's frame.
  let firstBucket = 26 + 128 + 1 + 4 * 13
  bytes[firstBucket + 8] = bytes[firstBucket + 8] xor 0xFF'u8
  let (ok, g, err) = readLinear(bytes)
  assert ok, $err
  assert not g.chunkPresent[0]
  assert g.chunkPresent[31 * 32 + 31] and g.chunksData[31 * 32 + 31] == @[9'u8, 9'u8]
  # A bad footer is rejected outright.
  var noFooter = bytes0
  noFooter[noFooter.len - 1] = noFooter[noFooter.len - 1] xor 0xFF'u8
  let (footOk, _, footErr) = readLinear(noFooter)
  assert not footOk and footErr.kind == creInvalidHeader

testLinearVectors()
testLinearCorruptBucket(scratchDir())
echo "chunklinear: all checks passed"
