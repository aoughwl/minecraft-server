## Port of `pump_file_roundtrip` in chunk/format/pump.rs, with the unnamed root and negative coordinates.

import std/[syncio, assertions, envvars, cmdline]
import chunkio, chunkpump, worldfs

proc scratchDir(): string =
  result = getEnv("WORLDTEST_DIR")
  if result.len == 0:
    result = parentDirW(paramStr(0)) & "/chunkformats_scratch"
  discard createDirAllW(result)

proc testPumpRoundTrip(base: string) =
  # pump_file_roundtrip
  let f = newPumpFile()
  assert updateChunkPump(f, 0'i32, 0'i32, @[1'u8, 2'u8, 3'u8]).ok
  let path = base & "/r.0.0.pump"
  assert writePump(f, path).ok
  let (_, bytes) = readFileBytes(path)
  assert bytes[0] == 0x0a'u8   # unnamed root: the compound id, then straight to the first field
  assert bytes[1] == 0x03'u8   # an int field, "x"
  let (ok, back, err) = readPump(bytes)
  assert ok, $err
  assert back.chunks.len == 1 and back.chunks[0].key == "0"
  let g = getChunkPump(back, 0'i32, 0'i32)
  assert g.kind == ldLoaded and g.bytes == @[1'u8, 2'u8, 3'u8]
  assert getChunkPump(back, 1'i32, 0'i32).kind == ldMissing
  # A negative chunk: rem_euclid(32) and the arithmetic shift.
  assert getChunkKeyPump(-1'i32, -33'i32) == "r.-1.-2.pump"
  assert updateChunkPump(f, -1'i32, -33'i32, @[7'u8]).ok
  assert f.x == -1'i32 and f.z == -2'i32
  assert f.chunks[0].key == "0" and f.chunks[1].key == "1023" # 31 + 31*32

testPumpRoundTrip(scratchDir())
echo "chunkpump: all checks passed"
