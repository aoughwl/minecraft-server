## Chunk-loading view distance math: which chunk coordinates fall within a player's cylindrical view
## radius, and the load/unload diff between two view positions.
## Port of pumpkin-world/src/cylindrical_chunk_iterator.rs (cylindrical_chunk_iterator.rs)

import std/assertions
import ../util/vector2

type
  Cylindrical* = object
    center*: Vector2[int32]
    viewDistance*: uint8 ## Must be >= 1; upstream enforces this via `NonZero<u8>`.

proc newCylindrical*(center: Vector2[int32], viewDistance: uint8): Cylindrical {.inline.} =
  assert viewDistance >= 1, "viewDistance must be non-zero"
  Cylindrical(center: center, viewDistance: viewDistance)

proc left*(c: Cylindrical): int32 {.inline.} = c.center.x - int32(c.viewDistance) - 1'i32
proc bottom*(c: Cylindrical): int32 {.inline.} = c.center.y - int32(c.viewDistance) - 1'i32
proc right*(c: Cylindrical): int32 {.inline.} = c.center.x + int32(c.viewDistance) + 1'i32
proc top*(c: Cylindrical): int32 {.inline.} = c.center.y + int32(c.viewDistance) + 1'i32

proc isWithinDistance*(c: Cylindrical, x, z: int32): bool =
  let vd = int64(c.viewDistance)
  if vd == 1:
    return false
  let dx = int64(abs(x - c.center.x)) - 2
  let dz = int64(abs(z - c.center.y)) - 2
  let relX = if dx > 0: dx else: 0
  let relZ = if dz > 0: dz else: 0
  let hypSqr = relX * relX + relZ * relZ
  # The view distance is converted to i64 first because u8 * u8 can overflow.
  hypSqr < vd * vd

proc allChunksWithin*(c: Cylindrical): seq[Vector2[int32]] =
  ## `Cylindrical::all_chunks_within`
  result = @[]
  if c.viewDistance == 1'u8:
    return
  var x = left(c)
  while x <= right(c):
    var wasIn = false
    var z = bottom(c)
    while z <= top(c):
      if isWithinDistance(c, x, z):
        result.add(vec2[int32](x, z))
        wasIn = true
      elif wasIn:
        break
      inc z
    inc x

proc forEachChangedChunk*(oldC, newC: Cylindrical, newlyIncluded, justRemoved: var seq[Vector2[int32]]) =
  ## `Cylindrical::for_each_changed_chunk`
  let inNew = allChunksWithin(newC)
  for c in inNew:
    if not isWithinDistance(oldC, c.x, c.y):
      newlyIncluded.add(c)
  let inOld = allChunksWithin(oldC)
  for c in inOld:
    if not isWithinDistance(newC, c.x, c.y):
      justRemoved.add(c)

proc changedChunks*(oldC, newC: Cylindrical): (seq[Vector2[int32]], seq[Vector2[int32]]) =
  ## Returns (loading, unloading), `forEachChangedChunk` as a value.
  var loading: seq[Vector2[int32]] = @[]
  var unloading: seq[Vector2[int32]] = @[]
  forEachChangedChunk(oldC, newC, loading, unloading)
  (loading, unloading)
