## Port of the tests in cylindrical_chunk_iterator.rs, with known answers for small radii.
import std/[syncio, assertions]
import cylindrical
import ../util/vector2

proc bounds() =
  # `bounds`
  for viewDistance in 1 .. 32:
    let c = newCylindrical(vec2[int32](0'i32, 0'i32), uint8(viewDistance))
    let within = allChunksWithin(c)
    for chunk in within:
      assert chunk.x >= left(c) and chunk.x <= right(c)
      assert chunk.y >= bottom(c) and chunk.y <= top(c)
    var x = left(c) - 2'i32
    while x <= right(c) + 2'i32:
      var z = bottom(c) - 2'i32
      while z <= top(c) + 2'i32:
        if isWithinDistance(c, x, z):
          assert x >= left(c) and x <= right(c)
          assert z >= bottom(c) and z <= top(c)
        inc z
      inc x

proc capacityEstimation() =
  # `all_chunks_within_capacity_estimation`
  for distance in 1 .. 64:
    let c = newCylindrical(vec2[int32](0'i32, 0'i32), uint8(distance))
    let chunks = allChunksWithin(c)
    let estimated = ((distance + 3) * (distance + 3) * 3167) shr 10
    assert estimated >= chunks.len

proc knownAnswers() =
  # View distance 1 is empty.
  assert allChunksWithin(newCylindrical(vec2[int32](5'i32, 5'i32), 1'u8)).len == 0
  # View distance 2: rel = max(|d| - 2, 0) and rel^2 sum < 4, so all of [-3, 3]^2 (the corner is
  # 1 + 1 = 2) and nothing at 4 (rel 2, 4 is not < 4): 49 chunks.
  let two = allChunksWithin(newCylindrical(vec2[int32](0'i32, 0'i32), 2'u8))
  assert two.len == 49, "got " & $two.len
  # Upstream's order: x outer, z inner.
  assert two[0].x == -3'i32 and two[0].y == -3'i32
  assert two[1].x == -3'i32 and two[1].y == -2'i32
  # View distance 3 rounds its corners: (5, 5) has rel 3, 3 and 18 >= 9.
  let three = newCylindrical(vec2[int32](0'i32, 0'i32), 3'u8)
  assert isWithinDistance(three, 4'i32, 4'i32) and not isWithinDistance(three, 5'i32, 5'i32)

proc changed() =
  let a = newCylindrical(vec2[int32](0'i32, 0'i32), 2'u8)
  let b = newCylindrical(vec2[int32](1'i32, 0'i32), 2'u8)
  let (loading, unloading) = changedChunks(a, b)
  # Moving one to the east reveals the right edge and hides the left one, in equal numbers.
  assert loading.len > 0 and loading.len == unloading.len
  for c in loading:
    assert isWithinDistance(b, c.x, c.y) and not isWithinDistance(a, c.x, c.y)
  for c in unloading:
    assert isWithinDistance(a, c.x, c.y) and not isWithinDistance(b, c.x, c.y)
  let (l2, u2) = changedChunks(a, a)
  assert l2.len == 0 and u2.len == 0

bounds()
capacityEstimation()
knownAnswers()
changed()
echo "cylindrical: all checks passed"
