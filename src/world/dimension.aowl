## Dimension to Level entry point. Port of pumpkin-world/src/dimension.rs (dimension.rs)
##
## PARTIAL: pumpkin-world/src/dimension.rs - `gen_pool` is dropped with the rest of the chunk system;
## see level.aowl.

import ../config/world as worldconfig
import ../generated/dimension as dimensiondata
import level, worldfs

proc dimensionFolder*(dimension: DimensionType, baseDirectory: string): string =
  ## The path half of `into_level`.
  if dimension.minecraftName == OVERWORLD.minecraftName:
    baseDirectory
  elif dimension.minecraftName == THE_NETHER.minecraftName:
    joinPathW(baseDirectory, "DIM-1")
  elif dimension.minecraftName == THE_END.minecraftName:
    joinPathW(baseDirectory, "DIM1")
  else:
    baseDirectory

proc intoLevel*(dimension: DimensionType, levelConfig: LevelConfig, baseDirectory: string, seed: int64): Level =
  ## `into_level`
  fromRootFolder(levelConfig, dimensionFolder(dimension, baseDirectory), seed, dimension)
