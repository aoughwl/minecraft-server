## Dimension folders.

import std/[syncio, assertions, cmdline, envvars]
import ../config/[chunk, lighting, world]
import ../generated/dimension as dimensiondata
import level, dimension, chunkio, worldfs

proc testFolders() =
  assert dimensionFolder(OVERWORLD, "w") == "w"
  assert dimensionFolder(THE_NETHER, "w") == "w/DIM-1"
  assert dimensionFolder(THE_END, "w") == "w/DIM1"
  var dirRoot = getEnv("WORLDTEST_DIR")
  if dirRoot.len == 0:
    dirRoot = parentDirW(paramStr(0)) & "/dimension_scratch"
  let base = dirRoot & "/folders"
  discard createDirAllW(base)
  let nether = intoLevel(THE_NETHER, defaultLevelConfig(), base, 7'i64)
  assert nether.levelFolder.rootFolder == base & "/DIM-1"
  assert nether.levelFolder.regionFolder == base & "/DIM-1/region"
  assert nether.seed == 7'u64
  assert not nether.isFlat and nether.flatBiome == "minecraft:plains"

testFolders()
echo "dimension: all checks passed"
