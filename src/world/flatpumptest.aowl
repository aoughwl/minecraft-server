## The chunk SCHEDULER (not generateSingleChunk) must produce a flat world's chunks: a ticket at (0,0), pump until loaded.
{.feature: "lenientnils".}

import std/[assertions, syncio, cmdline]
import chunkdata
import world
import level
import worldfs
import worldinfo
import worldinfoanvil
import ../config/lib
import ../generated/dimension
import chunk_system/chunk_system
import chunk_system/chunk_loading

let dir = parentDirW(paramStr(0)) & "/flatpump_scratch"
discard createDirAllW(dir)
var info = defaultLevelData(5'u64)
info.worldGenSettings = newWorldGenSettingsOfType(5'u64, "flat")
let (ok, err) = writeWorldInfo(info, dir)
assert ok, $err
let l = fromRootFolder(defaultAdvancedConfiguration().world, dir, 5'i64, OVERWORLD)
assert l.isFlat
discard ensureChunkSystem(l)
let loading = l.chunkLoading
addTicket(loading, chunkPos(0'i32, 0'i32), getLevelFromViewDistance(2'u8))
sendChange(loading)
var iterations = 0
while not isChunkLoaded(l, 0'i32, 0'i32) and iterations < 20000:
  discard pumpChunkSystem(l, 64)
  iterations += 1
echo "iterations until chunk (0,0) is loaded: ", iterations, " loaded chunks: ", loadedChunkCount(l)
assert isChunkLoaded(l, 0'i32, 0'i32), "the scheduler never finished chunk 0,0 of a flat world"
echo "flatpumptest ok"
