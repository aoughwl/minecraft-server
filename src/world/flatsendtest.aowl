## A flat chunk must encode into the chunk packet (the live flat world sent no chunks at all).
{.feature: "lenientnils".}

import std/[assertions, syncio]
import chunkdata
import blockstates
import world
import ../generated/dimension
import generation/generator/generator
import chunk_system/chunk_system
import ../protocol/[protobase, netcodec]
import ../protocol/java/client/play/chunk_data
import ../util/javaversion

let gen = getWorldGen(7'u64, OVERWORLD, true, @[FlatLayer(block_name: "minecraft:bedrock", height: 1'i32),
  FlatLayer(block_name: "minecraft:dirt", height: 2'i32), FlatLayer(block_name: "minecraft:grass_block", height: 1'i32)], "minecraft:plains")
let c = generateSingleChunk(gen, noOpWorldPortal(), 0'i32, 0'i32, StagedChunkEnum.Full)
assert c.kind == ChunkKind.Level
echo "flat chunk: sections ", c.level.section.count, " sky light arrays ", c.level.lightEngine.skyLight.len, " block light ", c.level.lightEngine.blockLight.len
var w = newNetWriter()
let r = writePacket(CChunkData(data: c.level), w, jmvV1_21_11)
assert r.isOk, "the flat chunk encodes for 1.21.11"
echo "encoded bytes: ", w.buf.len
echo "flatsendtest ok"
