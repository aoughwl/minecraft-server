## Biome boundary blending. Port of pumpkin-world/src/generation/biome.rs

import ../../util/vector3
import ../../util/random/rustnum
import generation

proc saltMix*(seed, salt: int64): int64 {.inline.} =
  let mixedSeed = wrapMul(seed, wrapAdd(wrapMul(seed, 6364136223846793005'i64), 1442695040888963407'i64))
  wrapAdd(mixedSeed, salt)

proc scaleMix*(l: int64): float64 {.inline.} =
  # Shifting and then masking with 1023 is floor_mod(l >> 24, 1024).
  let d = float64((l shr 24) and 1023'i64) / 1024.0'f64
  (d - 0.5'f64) * 0.9'f64

proc scorePermutation*(seed: int64, x, y, z: int32, xPart, yPart, zPart: float64): float64 =
  ## A random offset (+/- 0.0-0.8ish) on our biome position quarters, returning the squared hypotenuse.
  var mix = saltMix(seed, int64(x))
  mix = saltMix(mix, int64(y))
  mix = saltMix(mix, int64(z))
  mix = saltMix(mix, int64(x))
  mix = saltMix(mix, int64(y))
  mix = saltMix(mix, int64(z))
  let offsetX = scaleMix(mix)
  mix = saltMix(mix, seed)
  let offsetY = scaleMix(mix)
  mix = saltMix(mix, seed)
  let offsetZ = scaleMix(mix)
  let a = zPart + offsetZ
  let b = yPart + offsetY
  let c = xPart + offsetX
  a * a + b * b + c * c

proc getBiomeBlend*(bottomY: int8, height: uint16, seed: int64, x, y, z: int32): Vector3[int32] =
  ## `get_biome_blend`: which biome to populate the surface on, based on the seed.
  # This is the "left" side of the biome boundary.
  let offsetX = x - 2'i32
  let offsetY = y - 2'i32
  let offsetZ = z - 2'i32
  let biomeX = biomeFromBlock(offsetX)
  let biomeY = biomeFromBlock(offsetY)
  let biomeZ = biomeFromBlock(offsetZ)
  # &'ing 3 gives 0-3, the data removed when converting to biome coords: "quarters" into the biome.
  let quartersX = float64(offsetX and 3'i32) * 0.25'f64
  let quartersY = float64(offsetY and 3'i32) * 0.25'f64
  let quartersZ = float64(offsetZ and 3'i32) * 0.25'f64

  var bestPermutation = 0
  var bestScore = cast[float64](0x7FF0000000000000'u64)
  for permutation in 0 ..< 8:
    let shouldMaintainX = (permutation and 4) == 0
    let shouldMaintainY = (permutation and 2) == 0
    let shouldMaintainZ = (permutation and 1) == 0
    # If we are shifting, add 1 to the biome coords.
    let shiftedBiomeX = if shouldMaintainX: biomeX else: biomeX + 1'i32
    let shiftedBiomeY = if shouldMaintainY: biomeY else: biomeY + 1'i32
    let shiftedBiomeZ = if shouldMaintainZ: biomeZ else: biomeZ + 1'i32
    # And reflect the "quarters" across the shift.
    let shiftedQuartersX = if shouldMaintainX: quartersX else: quartersX - 1.0'f64
    let shiftedQuartersY = if shouldMaintainY: quartersY else: quartersY - 1.0'f64
    let shiftedQuartersZ = if shouldMaintainZ: quartersZ else: quartersZ - 1.0'f64
    let permutationScore = scorePermutation(seed, shiftedBiomeX, shiftedBiomeY, shiftedBiomeZ,
      shiftedQuartersX, shiftedQuartersY, shiftedQuartersZ)
    if bestScore > permutationScore:
      bestScore = permutationScore
      bestPermutation = permutation

  # Now check if we want the "left" side or the "right" side.
  let resultX = if (bestPermutation and 4) == 0: biomeX else: biomeX + 1'i32
  let resultY = if (bestPermutation and 2) == 0: biomeY else: biomeY + 1'i32
  let resultZ = if (bestPermutation and 1) == 0: biomeZ else: biomeZ + 1'i32

  # Java's `getBiomeForNoiseGen`
  let biomeBottom = biomeFromBlock(int32(bottomY))
  let biomeTop = biomeBottom + biomeFromBlock(int32(height)) - 1'i32
  let clampedY = if resultY < biomeBottom: biomeBottom elif resultY > biomeTop: biomeTop else: resultY
  vec3[int32](resultX, clampedY, resultZ)
