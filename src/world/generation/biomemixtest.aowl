## Port of the tests in generation/biome.rs, including `chunk_wide_blend` against assets/biome_mixer.json, and
## `hash_seed_test` and `wide_area_surface` in biome/mod.rs against assets/biome_no_blend_no_beard_0.json.
## Run from the repo root.

import std/assertions
import std/syncio
import ../biomeparam
import ../../generated/dimension
import biomemix
import fixtures
import generation
import positions
import proto_chunk
import noise/multi_noise_sampler
import noise/router

block mixSeed:
  assert saltMix(12345678'i64, 12345678'i64) == 2937271135939595220'i64

block permutation:
  let seed = hashSeed(0'u64)
  assert scorePermutation(seed, 123'i32, 456'i32, 456'i32, 0.25'f64, 0.5'f64, 0.75'f64) == 1.276986312866211'f64

block biomeBlend:
  let p = getBiomeBlend(-64'i8, 384'u16, 1234567890'i64, 123'i32, 123'i32, 123'i32)
  assert p.x == 31'i32 and p.y == 30'i32 and p.z == 30'i32

block scale:
  assert scaleMix(12345678'i64) == -0.45'f64

block hashSeedTest:
  assert hashSeed(0'u64) == 8794265229978523055'i64
  assert hashSeed(cast[uint64](-777'i64)) == -1087248400229165450'i64

block chunkWideBlend:
  let data = readNumbers(assetPath("biome_mixer.json"))
  let seed = hashSeed(cast[uint64](-777'i64))
  var i = 0
  var checked = 0
  while i < data.len:
    let r = getBiomeBlend(int8.low, uint16.high, seed, int32(data[i]), int32(data[i + 1]), int32(data[i + 2]))
    assert r.x == int32(data[i + 3]) and r.y == int32(data[i + 4]) and r.z == int32(data[i + 5])
    i += 6
    inc checked
  echo "biome_mixer fixture: ", checked, " positions match"

proc nextNumber(text: string, pos: var int): int32 =
  while not (text[pos] == '-' or (text[pos] >= '0' and text[pos] <= '9')):
    inc pos
  var neg = false
  if text[pos] == '-':
    neg = true
    inc pos
  var v = 0'i32
  while text[pos] >= '0' and text[pos] <= '9':
    v = v * 10'i32 + int32(ord(text[pos]) - ord('0'))
    inc pos
  if neg: -v else: v

proc wideAreaSurface() =
  # {"x":5,"z":5,"data":[[x,y,z,id],..]} objects: the numbers in order, split at each "x" key.
  var text = ""
  try:
    text = readFile(assetPath("biome_no_blend_no_beard_0.json"))
  except:
    quit(1)
  let wg = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  var checked = 0
  var pos = 0
  while true:
    var at = -1
    var i = pos
    while i + 3 < text.len:
      if text[i] == '"' and text[i + 1] == 'x' and text[i + 2] == '"':
        at = i
        break
      inc i
    if at < 0:
      break
    pos = at + 3
    let chunkX = nextNumber(text, pos)
    let chunkZ = nextNumber(text, pos)
    let chunk = newProtoChunk(chunkX, chunkZ, wg)
    let sampler = generateMultiNoiseSampler(wg.noise.baseRouter.multiNoise, newMultiNoiseSamplerBuilderOptions(
      biomeFromBlock(startBlockX(chunkX)), biomeFromBlock(startBlockZ(chunkZ)), int(biomeFromBlock(16'i32))))
    populateBiomes(chunk, wg.noise, sampler)
    # Rows until the next object or the end.
    while true:
      var j = pos
      while j < text.len and text[j] != '[' and text[j] != '{':
        inc j
      if j >= text.len or text[j] == '{':
        pos = j
        break
      # `[` opening a row or the data array.
      var k = j
      while text[k] == '[':
        inc k
      pos = k
      let bx = nextNumber(text, pos)
      let by = nextNumber(text, pos)
      let bz = nextNumber(text, pos)
      let id = nextNumber(text, pos)
      assert int32(getBiomeId(chunk, bx, by, bz)) == id
      inc checked
      while pos < text.len and text[pos] != ']':
        inc pos
      inc pos
  echo "biome_no_blend_no_beard fixture: ", checked, " biomes match"

wideAreaSurface()

echo "biomemixtest ok"
