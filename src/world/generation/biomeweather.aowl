## `biome.weather.compute_temperature(..)` for a generated `Biome`. Support module with no upstream file of its own:
## generated/biome.aowl keeps the data and util/biome.aowl the logic, each with a `Weather` type of its own.

import ../../generated/biome as biomedata
import ../../util/biome as utilbiome

proc buildWeathers(): seq[utilbiome.Weather] =
  result = newSeq[utilbiome.Weather](biomedata.ALL.len)
  for i in 0 ..< biomedata.ALL.len:
    let w = biomedata.ALL[i].weather
    let modifier = if w.temperatureModifier == biomedata.TemperatureModifier.Frozen: tmFrozen else: tmNone
    result[int(biomedata.ALL[i].id)] = newWeather(w.hasPrecipitation, w.temperature, modifier, w.downfall)

let weathers = buildWeathers()

proc computeBiomeTemperature*(biomeId: uint8, x: float64, y: int32, z: float64, seaLevel: int32): float32 =
  computeTemperature(weathers[int(biomeId)], x, y, z, seaLevel)
