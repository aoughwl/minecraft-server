## Port of pumpkin-world/src/generation/blender/blending_data.rs
##
## `FnMut` consumers are plain closures. `&'static Biome` is the biome id, which is all blending reads.

{.feature: "lenientnils".}

type
  BlendingData* = ref object
    minY*, maxY*: int32
    heights*: seq[float64]    ## Heights at quart positions (16x16 per chunk).
    densities*: seq[float64]  ## Densities at quart positions, for the current chunk's Y levels.
    biomes*: seq[uint8]       ## Biomes at quart positions (16x16 per chunk).

let FloatMax* = cast[float64](0x7FEFFFFFFFFFFFFF'u64)  ## `f64::MAX`

proc getHeight*(d: BlendingData, cellX, cellY, cellZ: int32): float64 =
  if not (cellX >= 0'i32 and cellX < 16'i32) or not (cellZ >= 0'i32 and cellZ < 16'i32):
    return FloatMax
  d.heights[int(cellZ * 16'i32 + cellX)]

proc getDensity*(d: BlendingData, cellX, cellY, cellZ: int32): float64 =
  if not (cellX >= 0'i32 and cellX < 16'i32) or not (cellZ >= 0'i32 and cellZ < 16'i32):
    return FloatMax
  let cellCountY = (d.maxY - d.minY) div 8'i32
  if not (cellY >= 0'i32 and cellY < cellCountY):
    return FloatMax
  let index = int(cellY * 16'i32 * 16'i32 + cellZ * 16'i32 + cellX)
  if index < d.densities.len: d.densities[index] else: FloatMax

proc iterateHeights*(d: BlendingData, quartX, quartZ: int32, consumer: proc(x, z: int32, h: float64) {.closure.}) =
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      let h = d.heights[z * 16 + x]
      if h != FloatMax:
        consumer(quartX + int32(x), quartZ + int32(z), h)

proc iterateDensities*(d: BlendingData, quartX, quartZ, minCellY, maxCellY: int32,
                       consumer: proc(x, y, z: int32, density: float64) {.closure.}) =
  let cellCountY = (d.maxY - d.minY) div 8'i32
  var cellY = minCellY
  while cellY <= maxCellY:
    if cellY >= 0'i32 and cellY < cellCountY:
      for z in 0'i32 ..< 16'i32:
        for x in 0'i32 ..< 16'i32:
          let index = int(cellY * 16'i32 * 16'i32 + z * 16'i32 + x)
          if index < d.densities.len:
            let density = d.densities[index]
            if density != FloatMax:
              consumer(quartX + x, cellY, quartZ + z, density)
    inc cellY

proc iterateBiomes*(d: BlendingData, quartX, quartY, quartZ: int32, consumer: proc(x, z: int32, biome: uint8) {.closure.}) =
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      consumer(quartX + int32(x), quartZ + int32(z), d.biomes[z * 16 + x])
