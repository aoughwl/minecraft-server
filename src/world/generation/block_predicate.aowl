## Port of pumpkin-world/src/generation/block_predicate.rs
##
## One object with a kind, as the enum's variants share their shape: an offset and what to compare. Not a case
## object, since it holds its own type (COMPILER-BUGS.md bug 4). `MatchingBlocksWrapper` is a seq of one or more
## names, with or without `minecraft:`. `block_registry` is `WorldPortalExt`.

{.feature: "lenientnils".}

import std/options
import ../blockstates
import ../blockcodec
import ../tick
import ../world
import ../../generated/tag
from ../../generated/fluid import Fluid, FluidState
import ../../util/vector3
import protochunkbase

type
  BlockPredicateKind* {.pure.} = enum
    MatchingBlocks, MatchingBlockTag, MatchingFluids, HasSturdyFace, Solid, Replaceable, WouldSurvive,
    InsideWorldBounds, AnyOf, AllOf, Not, AlwaysTrue

  BlockPredicate* = ref object
    kind*: BlockPredicateKind
    hasOffset*: bool                ## `OffsetBlocksBlockPredicate.offset`'s Some.
    offset*: Vector3[int32]         ## That offset; InsideWorldBounds always has one.
    names*: seq[string]             ## MatchingBlocks, MatchingFluids: bare names.
    tag*: Tag                       ## MatchingBlockTag.
    direction*: int                 ## HasSturdyFace: a `BlockDirection` ordinal.
    state*: BlockStateCodec         ## WouldSurvive.
    predicates*: seq[BlockPredicate]  ## AnyOf, AllOf; Not's one.

proc offsetGet(p: BlockPredicate, pos: BlockPos): Vector3[int32] {.inline.} =
  ## `OffsetBlocksBlockPredicate::get`
  if p.hasOffset:
    vec3[int32](pos.x + p.offset.x, pos.y + p.offset.y, pos.z + p.offset.z)
  else:
    vec3[int32](pos.x, pos.y, pos.z)

proc nameIn(names: seq[string], name: string): bool =
  for n in names:
    if stripMinecraft(n) == name:
      return true
  false

proc test*(p: BlockPredicate, blockRegistry: WorldPortalExt, chunk: GenerationCache, pos: BlockPos): bool =
  ## `BlockPredicate::test`
  case p.kind
  of BlockPredicateKind.MatchingBlocks:
    nameIn(p.names, blockNameOfState(chunk.getBlockState(offsetGet(p, pos))))
  of BlockPredicateKind.MatchingFluids:
    let (fluid, state) = chunk.getFluidAndFluidState(offsetGet(p, pos))
    discard state
    nameIn(p.names, fluid.name)
  of BlockPredicateKind.MatchingBlockTag:
    hasTag(uint16(blockIdOf(chunk.getBlockState(offsetGet(p, pos)))), p.tag)
  of BlockPredicateKind.HasSturdyFace:
    isSideSolid(chunk.getBlockState(offsetGet(p, pos)), p.direction)
  of BlockPredicateKind.Solid:
    isSolid(chunk.getBlockState(offsetGet(p, pos)))
  of BlockPredicateKind.Replaceable:
    isReplaceable(chunk.getBlockState(offsetGet(p, pos)))
  of BlockPredicateKind.WouldSurvive:
    let at = offsetGet(p, pos)
    let accessor = generationCacheAsAccessor(chunk)
    blockRegistry.canPlaceAt(getBlock(p.state), getStateId(p.state), accessor, blockPos(at.x, at.y, at.z))
  of BlockPredicateKind.InsideWorldBounds:
    let y = pos.y + p.offset.y
    not outOfHeightOf(chunk.height(), chunk.bottomY(), int16(y))
  of BlockPredicateKind.AnyOf:
    for i in 0 ..< p.predicates.len:
      if test(p.predicates[i], blockRegistry, chunk, pos):
        return true
    false
  of BlockPredicateKind.AllOf:
    for i in 0 ..< p.predicates.len:
      if not test(p.predicates[i], blockRegistry, chunk, pos):
        return false
    true
  of BlockPredicateKind.Not:
    not test(p.predicates[0], blockRegistry, chunk, pos)
  of BlockPredicateKind.AlwaysTrue:
    true
