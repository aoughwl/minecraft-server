## Port of the tests in generation/carver/mod.rs, generation/carver/cave.rs and the mask in generation/carver/mask.rs.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../../blockstates
import ../../../generated/carver
import ../../../generated/chunk_gen_settings
import ../../../generated/dimension
import ../../../data/block_state as datablockstate
import ../proto_chunk
import ../surface/surface
import ../noise/router
import carvers

proc sid(name: string): blockstates.BlockStateId =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc settingsFor(rules: seq[MaterialRule], conditions: seq[MaterialCondition], base: GenerationSettings): GenerationSettings =
  GenerationSettings(aquifersEnabled: base.aquifersEnabled, oreVeinsEnabled: base.oreVeinsEnabled,
    legacyRandomSource: base.legacyRandomSource, seaLevel: base.seaLevel, defaultFluid: base.defaultFluid, shape: base.shape,
    surfaceRule: 0'i32, surfaceRules: rules, surfaceConditions: conditions, defaultBlock: base.defaultBlock)

proc blockRule(name: string): MaterialRule =
  MaterialRule(kind: mrBlock, resultState: newBlockStateIdUnchecked(uint16(sid(name))))

proc withCarveRun(rules: seq[MaterialRule], conditions: seq[MaterialCondition], useRules, useCarverAquifer: bool): CarveRun =
  ## `with_carve_run_options`: a run on chunk (0, 0) of seed 42.
  let worldGen = getWorldGen(42'u64, dimension.OVERWORLD, false, @[], "")
  let chunk = newProtoChunk(0'i32, 0'i32, worldGen)
  let ctx = newCarvingContext(chunk, worldGen.noise, worldGen.noise.settings.surfaceRule, useCarverAquifer)
  if useRules:
    ctx.settings = settingsFor(rules, conditions, worldGen.noise.settings)
    ctx.surfaceRule = 0'i32
  CarveRun(ctx: ctx, chunk: chunk, ids: newCarverBlockIds())

proc withCarveRunDefault(): CarveRun =
  withCarveRun(@[], @[], false, true)

proc setSurfaceHeight(chunk: ProtoChunk, x, z: int32, height: int16) =
  chunk.flatSurfaceHeightMap[int(x and 15'i32) * 16 + int(z and 15'i32)] = height

proc fillSurface(chunk: ProtoChunk, height: int16) =
  for i in 0 ..< 256:
    chunk.flatSurfaceHeightMap[i] = height

block overworldHasAquifer:
  assert withCarveRunDefault().ctx.carverAquifer != nil

block restoresSurface:
  let run = withCarveRun(@[blockRule("podzol")], @[], true, false)
  let x = 4'i32
  let y = 70'i32
  let z = 5'i32
  setBlockState(run.chunk, x, y - 1'i32, z, sid("dirt"))
  carveTopMaterial(run, x, y, z, sid("air"), true, true)
  assert getBlockState(run.chunk, vec3[int32](x, y - 1'i32, z)) == sid("podzol")

block skipsSurfaceRestore:
  let run = withCarveRun(@[blockRule("podzol")], @[], true, false)
  let x = 4'i32
  let y = 70'i32
  let z = 5'i32
  setBlockState(run.chunk, x, y - 1'i32, z, sid("dirt"))
  carveTopMaterial(run, x, y, z, sid("air"), false, true)
  assert getBlockState(run.chunk, vec3[int32](x, y - 1'i32, z)) == sid("dirt")
  setBlockState(run.chunk, x, y - 1'i32, z, sid("stone"))
  carveTopMaterial(run, x, y, z, sid("air"), true, true)
  assert getBlockState(run.chunk, vec3[int32](x, y - 1'i32, z)) == sid("stone")
  setBlockState(run.chunk, x, y - 1'i32, z, sid("dirt"))
  carveTopMaterial(run, x, y, z, sid("air"), true, false)
  assert getBlockState(run.chunk, vec3[int32](x, y - 1'i32, z)) == sid("dirt")

block passesFluidToRule:
  # A sequence of [if water(0, 0, false) then grass_block, dirt].
  let rules = @[
    MaterialRule(kind: mrSequence, sequence: @[2'i32, 3'i32]),
    blockRule("grass_block"),
    MaterialRule(kind: mrCondition, ifTrue: 0'i32, thenRun: 1'i32),
    blockRule("dirt")]
  let conditions = @[MaterialCondition(kind: mcWater, surfaceDepthMultiplier: 0'i32, addStoneDepth: false, offset: 0'i32)]
  let run = withCarveRun(rules, conditions, true, false)
  let x = 6'i32
  let y = 70'i32
  let z = 7'i32
  let dry = topMaterial(run.ctx, run.chunk, x, y - 1'i32, z, false, false)
  let underFluid = topMaterial(run.ctx, run.chunk, x, y - 1'i32, z, true, false)
  assert dry.hasState and dry.state == sid("grass_block")
  assert underFluid.hasState and underFluid.state == sid("dirt")

block steepMatchesVanilla:
  let run = withCarveRunDefault()
  let x = 5'i32
  let z = 5'i32
  fillSurface(run.chunk, 64'i16)
  setSurfaceHeight(run.chunk, x, z - 1'i32, 60'i16)
  setSurfaceHeight(run.chunk, x, z + 1'i32, 64'i16)
  assert steepMaterialCondition(run.chunk, x, z)
  fillSurface(run.chunk, 64'i16)
  setSurfaceHeight(run.chunk, x, z - 1'i32, 64'i16)
  setSurfaceHeight(run.chunk, x, z + 1'i32, 60'i16)
  assert not steepMaterialCondition(run.chunk, x, z)
  fillSurface(run.chunk, 64'i16)
  setSurfaceHeight(run.chunk, x - 1'i32, z, 64'i16)
  setSurfaceHeight(run.chunk, x + 1'i32, z, 60'i16)
  assert steepMaterialCondition(run.chunk, x, z)
  fillSurface(run.chunk, 64'i16)
  setSurfaceHeight(run.chunk, x - 1'i32, z, 60'i16)
  setSurfaceHeight(run.chunk, x + 1'i32, z, 64'i16)
  assert not steepMaterialCondition(run.chunk, x, z)

proc carveAt(run: CarveRun, x, y, z: int32, initialState, expected: blockstates.BlockStateId) =
  var hasGrass = false
  setBlockState(run.chunk, x, y, z, initialState)
  assert caveCarveBlock(run, CAVE, x, y, z, false, hasGrass)
  assert getBlockState(run.chunk, vec3[int32](x, y, z)) == expected

proc assertWorldY(run: CarveRun, x, y, z: int32, expected: blockstates.BlockStateId) =
  let oldWrongY = y - int32(bottomY(run.chunk))
  let stone = sid("stone")
  setBlockState(run.chunk, x, y, z, stone)
  setBlockState(run.chunk, x, oldWrongY, z, stone)
  carveAt(run, x, y, z, stone, expected)
  assert getBlockState(run.chunk, vec3[int32](x, oldWrongY, z)) == stone

block carvesAtWorldY:
  let run = withCarveRunDefault()
  let expected = overworldCarveState(run, CAVE, 5'i32, 20'i32, 6'i32)
  assert expected.present, "test position should carve"
  assertWorldY(run, 5'i32, 20'i32, 6'i32, expected.state)
  assertWorldY(run, 7'i32, -58'i32, 8'i32, sid("lava"))

block usesAquiferState:
  let run = withCarveRunDefault()
  let lavaY = getY(CAVE.lavaLevel, int16(bottomY(run.chunk)), height(run.chunk))
  var y = lavaY + 1'i32
  var foundNonAir = false
  var foundScheduled = false
  while y <= 63'i32 and not (foundNonAir and foundScheduled):
    for x in 0'i32 ..< 16'i32:
      for z in 0'i32 ..< 16'i32:
        let s = overworldCarveState(run, CAVE, x, y, z)
        if s.present:
          if not foundNonAir and s.state != sid("air"):
            carveAt(run, x, y, z, sid("water"), s.state)
            foundNonAir = true
          elif not foundScheduled and isLiquid(s.state) and s.shouldSchedule:
            let oldTickCount = run.chunk.fluidTicks.len
            carveAt(run, x, y, z, sid("stone"), s.state)
            assert run.chunk.fluidTicks.len == oldTickCount + 1
            let p = run.chunk.fluidTicks[run.chunk.fluidTicks.len - 1].position
            assert p.x == x and p.y == y and p.z == z
            foundScheduled = true
    inc y
  assert foundNonAir, "expected non-air aquifer carve state in test chunk"
  assert foundScheduled, "expected scheduled aquifer fluid in test chunk"

block carvingMask:
  var m = newCarvingMask(384'i32, -64'i32)
  assert not get(m, 3'i32, -64'i32, 4'i32)
  set(m, 3'i32, -64'i32, 4'i32)
  assert get(m, 3'i32, -64'i32, 4'i32) and get(m, 19'i32, -64'i32, 20'i32)
  assert not get(m, 3'i32, -63'i32, 4'i32)
  set(m, 15'i32, 319'i32, 15'i32)
  assert get(m, 15'i32, 319'i32, 15'i32)

echo "carverstest ok"
