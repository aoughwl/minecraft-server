## Port of pumpkin-world/src/generation/carver/mask.rs

type
  CarvingMask* = object
    minY: int32
    mask: seq[uint64]

proc newCarvingMask*(height, minY: int32): CarvingMask =
  ## Each u64 stores 64 bits. Total bits needed: 16 * 16 * height.
  let totalBits = 16 * 16 * int(height)
  CarvingMask(minY: minY, mask: newSeq[uint64]((totalBits + 63) div 64))

proc getBitIndex(m: CarvingMask, x, y, z: int32): int {.inline.} =
  # x: 0..16, z: 0..16, y: min_y..min_y+height
  let relX = x and 15'i32
  let relZ = z and 15'i32
  let relY = y - m.minY
  int(relX or (relZ shl 4) or (relY shl 8))

proc set*(m: var CarvingMask, x, y, z: int32) =
  let bitIndex = getBitIndex(m, x, y, z)
  m.mask[bitIndex div 64] = m.mask[bitIndex div 64] or (1'u64 shl (bitIndex mod 64))

proc get*(m: CarvingMask, x, y, z: int32): bool =
  let bitIndex = getBitIndex(m, x, y, z)
  ((m.mask[bitIndex div 64] shr (bitIndex mod 64)) and 1'u64) != 0'u64
