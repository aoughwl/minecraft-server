## What every feature module reaches for: block and tag lookups, positions, and `JavaBlockPosHashSet`.
## Port of the `JavaBlockPosHashSet` in crates/pumpkin-world/src/generation/feature/features/mod.rs of the newer checkout
## (../ref/pumpkin): the pinned tree iterates a Rust `HashSet`, which has no vanilla order, and that order is what the
## random draws of a vegetation patch follow. Otherwise a support module with no upstream file of its own.

{.feature: "lenientnils".}

import std/[math, syncio]
import ../../../generated/tag
import ../../../util/vector3 except Axis
import types

export vector3.vec3, vector3.Vector3

# --- blocks ---------------------------------------------------------------------------------------------------------

proc blockIdOfName*(name: string): int =
  let (ok, id) = blockIdByName(name)
  if not ok:
    echo "feature: unknown block ", name
    quit(1)
  id

proc blockTag*(name: string): Tag =
  ## A block tag by name, with or without `minecraft:`. The name is checked: a typo here would silently never match.
  let full = if name.len > 10 and name[0 .. 9] == "minecraft:": name else: "minecraft:" & name
  let t = find(getLatestMap(rkBlock), full)
  if t == nil:
    echo "feature: unknown block tag ", full
    quit(1)
  t

proc hasBlockTag*(state: BlockStateId, t: Tag): bool {.inline.} =
  hasTag(uint16(blockIdOf(state)), t)

let
  BWater* = blockIdOfName("water")
  BLava* = blockIdOfName("lava")
  BAir* = blockIdOfName("air")
  BCaveAir* = blockIdOfName("cave_air")
  BVoidAir* = blockIdOfName("void_air")
  BVine* = blockIdOfName("vine")
  SAir* = defaultStateOf(BAir)
  SCaveAir* = defaultStateOf(BCaveAir)
  SWater* = defaultStateOf(BWater)

proc stateOfName*(name: string): BlockStateId {.inline.} =
  defaultStateOf(blockIdOfName(name))

proc withProp*(state: BlockStateId, name, value: string): BlockStateId =
  ## The state with one property replaced. A property the block lacks changes nothing.
  var props = stateProperties(state)
  for i in 0 ..< props.len:
    if props[i].name == name:
      props[i] = (name: name, value: value)
  stateIdFromProps(blockIdOf(state), props)

proc propValue*(state: BlockStateId, name: string): string =
  ## The property's value, empty if the block lacks it.
  let props = stateProperties(state)
  for i in 0 ..< props.len:
    if props[i].name == name:
      return props[i].value
  ""

proc hasProp*(state: BlockStateId, name: string): bool =
  let props = stateProperties(state)
  for i in 0 ..< props.len:
    if props[i].name == name:
      return true
  false

proc isWaterlogged*(state: BlockStateId): bool {.inline.} =
  propValue(state, "waterlogged") == "true"

proc boolStr*(b: bool): string {.inline.} =
  if b: "true" else: "false"

proc stateWith*(blockId: int, props: openArray[StateProp]): BlockStateId {.inline.} =
  stateIdFromProps(blockId, props)

# --- chunk access ---------------------------------------------------------------------------------------------------

proc getState*(c: FeatureContext, p: BlockPos): BlockStateId {.inline.} =
  stateOf(c.chunk, p.vec)

proc getStateV*(c: FeatureContext, p: Vector3[int32]): BlockStateId {.inline.} =
  stateOf(c.chunk, p)

proc getBlockId*(c: FeatureContext, p: BlockPos): int {.inline.} =
  blockIdOf(getState(c, p))

proc setState*(c: FeatureContext, p: BlockPos, s: BlockStateId) {.inline.} =
  putState(c.chunk, p.vec, s)

proc airAt*(c: FeatureContext, p: BlockPos): bool {.inline.} =
  isAir(getState(c, p))

proc bottomY*(c: FeatureContext): int32 {.inline.} = int32(c.minY)
proc topY*(c: FeatureContext): int32 {.inline.} = int32(c.minY) + int32(c.height)

proc outOfHeight*(c: FeatureContext, y: int32): bool {.inline.} =
  y < int32(c.minY) or y >= int32(c.minY) + int32(c.height)

proc topMotionBlocking*(c: FeatureContext, x, z: int32): int32 {.inline.} =
  topMotionBlockingOf(c.chunk, x, z)

proc topBlock*(c: FeatureContext, x, z: int32): int32 {.inline.} =
  topBlockOf(c.chunk, x, z)

proc oceanFloor*(c: FeatureContext, x, z: int32): int32 {.inline.} =
  oceanFloorOf(c.chunk, x, z)

proc topY*(c: FeatureContext, heightmap: HeightMap, x, z: int32): int32 {.inline.} =
  topYOf(c.chunk, heightmap, x, z)

proc canPlace*(c: FeatureContext, state: BlockStateId, p: BlockPos): bool {.inline.} =
  ## `block_registry.can_place_at(block, state, chunk, pos)`
  canPlaceAtOf(c.blockRegistry, blockIdOf(state), state, c.accessor, p)

# --- positions and directions ---------------------------------------------------------------------------------------

proc pos*(x, y, z: int32): BlockPos {.inline.} = newBlockPos(x, y, z)

proc offset*(p: BlockPos, d: BlockDirection): BlockPos {.inline.} =
  p.offset(toOffset(d))

proc offsetN*(p: BlockPos, d: BlockDirection, n: int32): BlockPos =
  let o = toOffset(d)
  p.add(o.x * n, o.y * n, o.z * n)

const
  HorizontalWorldgen* = [BlockDirection.North, BlockDirection.East, BlockDirection.South, BlockDirection.West]
    ## `BlockDirection::horizontal_worldgen`, vanilla's `Direction.Plane.HORIZONTAL`.
  AllDirections* = [BlockDirection.Down, BlockDirection.Up, BlockDirection.North, BlockDirection.South,
                    BlockDirection.West, BlockDirection.East]

proc randomHorizontal*(random: var RandomGenerator): BlockDirection =
  ## `BlockDirection::random_horizontal` of the newer checkout: `nextInt(4)` over [north, east, south, west]. The pinned
  ## tree's bound is `len - 1`, which never draws the last direction.
  HorizontalWorldgen[int(nextBoundedI32(random, 4))]

proc randomDirection*(random: var RandomGenerator): BlockDirection =
  ## `Direction.getRandom`
  AllDirections[int(nextBoundedI32(random, 6))]

proc shuffle*[T](s: var seq[T], random: var RandomGenerator) =
  ## `Util.shuffle` as vanilla draws it: from the top down.
  var i = s.len - 1
  while i >= 1:
    let j = int(nextBoundedI32(random, int32(i + 1)))
    let a = s[i]
    let b = s[j]
    s[i] = b
    s[j] = a
    dec i

proc sideSolid*(state: BlockStateId, d: BlockDirection) : bool {.inline.} =
  isSideSolid(state, ord(d))

# --- Mojang's sin table ---------------------------------------------------------------------------------------------

const SinScale = 10430.378350470453'f64

proc buildSin(): seq[float32] =
  result = newSeq[float32](65536)
  for i in 0 .. 65535:
    result[i] = float32(sin(float64(i) * 2.0 * PI / 65536.0))

let SinTable = buildSin()

proc mthSin*(value: float32): float32 =
  ## `Mth.sin`, by table: its results differ from the C library's in the last bits.
  SinTable[int(cast[int64](int64(float64(value) * SinScale)) and 65535'i64)]

proc mthCos*(value: float32): float32 =
  SinTable[int(cast[int64](int64(float64(value) * SinScale + 16384.0)) and 65535'i64)]

# --- JavaBlockPosHashSet --------------------------------------------------------------------------------------------

type
  JavaBlockPosEntry = object
    hash: int32
    pos: BlockPos

  JavaBlockPosHashSet* = object
    ## A set of positions that iterates as OpenJDK's `HashSet<BlockPos>` does.
    buckets: seq[seq[JavaBlockPosEntry]]
    count: int
    threshold: int

proc newJavaBlockPosHashSet*(): JavaBlockPosHashSet =
  JavaBlockPosHashSet(buckets: newSeq[seq[JavaBlockPosEntry]](16), count: 0, threshold: 12)

proc wmul(a, b: int32): int32 {.inline.} = cast[int32](cast[uint32](a) * cast[uint32](b))
proc wadd(a, b: int32): int32 {.inline.} = cast[int32](cast[uint32](a) + cast[uint32](b))

proc javaHash(p: BlockPos): int32 =
  let h = wadd(wmul(wadd(p.y, wmul(p.z, 31)), 31), p.x)
  h xor cast[int32](cast[uint32](h) shr 16)

proc resize(s: var JavaBlockPosHashSet) =
  let oldCap = s.buckets.len
  s.threshold = s.threshold shl 1
  var nb = newSeq[seq[JavaBlockPosEntry]](oldCap shl 1)
  for j in 0 ..< oldCap:
    for k in 0 ..< s.buckets[j].len:
      let e = s.buckets[j][k]
      if (int(cast[uint32](e.hash)) and oldCap) == 0:
        nb[j].add(e)
      else:
        nb[j + oldCap].add(e)
  s.buckets = nb

proc incl*(s: var JavaBlockPosHashSet, p: BlockPos) =
  let h = javaHash(p)
  let idx = int(cast[uint32](h)) and (s.buckets.len - 1)
  for k in 0 ..< s.buckets[idx].len:
    if s.buckets[idx][k].pos == p:
      return
  s.buckets[idx].add(JavaBlockPosEntry(hash: h, pos: p))
  inc s.count
  if s.count > s.threshold:
    resize(s)

proc contains*(s: JavaBlockPosHashSet, p: BlockPos): bool =
  let idx = int(cast[uint32](javaHash(p))) and (s.buckets.len - 1)
  for k in 0 ..< s.buckets[idx].len:
    if s.buckets[idx][k].pos == p:
      return true
  false

proc len*(s: JavaBlockPosHashSet): int {.inline.} = s.count

proc isEmpty*(s: JavaBlockPosHashSet): bool {.inline.} = s.count == 0

proc popFirst*(s: var JavaBlockPosHashSet, p: var BlockPos): bool =
  for i in 0 ..< s.buckets.len:
    if s.buckets[i].len > 0:
      p = s.buckets[i][0].pos
      s.buckets[i].delete(0)
      dec s.count
      return true
  false

proc toSeq*(s: JavaBlockPosHashSet): seq[BlockPos] =
  result = newSeq[BlockPos](0)
  for i in 0 ..< s.buckets.len:
    for k in 0 ..< s.buckets[i].len:
      result.add(s.buckets[i][k].pos)

proc javaDedup*(items: seq[BlockPos]): seq[BlockPos] =
  ## `items.into_iter().collect::<JavaBlockPosHashSet>().into_vec()`
  var s = newJavaBlockPosHashSet()
  for i in 0 ..< items.len:
    s.incl(items[i])
  toSeq(s)
