export placed_features, decode, types

proc generateConfigured*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `ConfiguredFeature::generate`
  case f.kind
  of ConfiguredFeatureKind.NoOp: false
  of ConfiguredFeatureKind.Bamboo: generateBamboo(f, c, random, at)
  of ConfiguredFeatureKind.Seagrass: generateSeagrass(f, c, random, at)
  of ConfiguredFeatureKind.SeaPickle: generateSeaPickle(f, c, random, at)
  of ConfiguredFeatureKind.NetherForestVegetation: generateNetherForestVegetation(f, c, random, at)
  of ConfiguredFeatureKind.NetherrackReplaceBlobs: generateReplaceBlobs(f, c, random, at)
  of ConfiguredFeatureKind.SimpleBlock: generateSimpleBlock(f, c, random, at)
  of ConfiguredFeatureKind.ScatteredOre: generateScatteredOre(f, c, random, at)
  of ConfiguredFeatureKind.Ore: generateOre(f, c, random, at)
  of ConfiguredFeatureKind.SpringFeature: generateSpring(f, c, at)
  of ConfiguredFeatureKind.BlockColumn: generateBlockColumn(f, c, random, at)
  of ConfiguredFeatureKind.FallenTree: generateFallenTree(f, c, random, at)
  of ConfiguredFeatureKind.Flower, ConfiguredFeatureKind.NoBonemealFlower, ConfiguredFeatureKind.RandomPatch:
    generateRandomPatch(f, c, random, at)
  of ConfiguredFeatureKind.RandomSelector: generateRandomSelector(f, c, random, at)
  of ConfiguredFeatureKind.SimpleRandomSelector: generateSimpleRandomSelector(f, c, random, at)
  of ConfiguredFeatureKind.RandomBooleanSelector: generateRandomBooleanSelector(f, c, random, at)
  of ConfiguredFeatureKind.EndSpike: generateEndSpike(f, c, at)
  of ConfiguredFeatureKind.Tree: generateTree(f.tree, c, random, at)
  of ConfiguredFeatureKind.PointedDripstone: generatePointedDripstone(f, c, random, at)
  of ConfiguredFeatureKind.Geode: generateGeode(f, c, random, at)
  of ConfiguredFeatureKind.MonsterRoom: generateMonsterRoom(c, random, at)
  of ConfiguredFeatureKind.UnderwaterMagma: generateUnderwaterMagma(f, c, random, at)
  of ConfiguredFeatureKind.VegetationPatch: generateVegetationPatch(f, c, random, at)
  of ConfiguredFeatureKind.WaterloggedVegetationPatch: generateWaterloggedVegetationPatch(f, c, random, at)
  of ConfiguredFeatureKind.GlowstoneBlob: generateGlowstoneBlob(c, random, at)
  of ConfiguredFeatureKind.Disk: generateDisk(f, c, random, at)
  of ConfiguredFeatureKind.BasaltColumns: generateBasaltColumns(f, c, random, at)
  of ConfiguredFeatureKind.BasaltPillar: generateBasaltPillar(c, random, at)
  of ConfiguredFeatureKind.ForestRock: generateForestRock(f, c, random, at)
  of ConfiguredFeatureKind.FreezeTopLayer: generateFreezeTopLayer(c, at)
  of ConfiguredFeatureKind.IceSpike: generateIceSpike(c, random, at)
  of ConfiguredFeatureKind.Iceberg: generateIceberg(f, c, random, at)
  of ConfiguredFeatureKind.ChorusPlant: generateChorusPlant(c, random, at)
  of ConfiguredFeatureKind.EndPlatform: generateEndPlatform(c, at)
  of ConfiguredFeatureKind.EndIsland: generateEndIsland(c, random, at)
  of ConfiguredFeatureKind.Kelp: generateKelp(c, random, at)
  of ConfiguredFeatureKind.Fossil: generateFossil(f, c, random, at)
  of ConfiguredFeatureKind.Lake: generateLake(f, c, random, at)
  of ConfiguredFeatureKind.HugeBrownMushroom: generateHugeBrownMushroom(c, random, at)
  of ConfiguredFeatureKind.HugeRedMushroom: generateHugeRedMushroom(c, random, at)
  of ConfiguredFeatureKind.Vines: generateVines(c, at)
  of ConfiguredFeatureKind.RootSystem: generateRootSystem(f, c, random, at)
  of ConfiguredFeatureKind.MultifaceGrowth: generateMultifaceGrowth(f, c, random, at)
  of ConfiguredFeatureKind.BlueIce: generateBlueIce(c, random, at)
  of ConfiguredFeatureKind.EndGateway: generateEndGateway(f, c, at)
  of ConfiguredFeatureKind.CoralTree: generateCoralTree(c, random, at)
  of ConfiguredFeatureKind.CoralMushroom: generateCoralMushroom(c, random, at)
  of ConfiguredFeatureKind.CoralClaw: generateCoralClaw(c, random, at)
  of ConfiguredFeatureKind.HugeFungus: generateHugeFungus(f, c, random, at)
  of ConfiguredFeatureKind.WeepingVines: generateWeepingVines(c, random, at)
  of ConfiguredFeatureKind.TwistingVines: generateTwistingVines(f, c, random, at)
  of ConfiguredFeatureKind.DeltaFeature: generateDelta(f, c, random, at)
  of ConfiguredFeatureKind.FillLayer: generateFillLayer(f, c, at)
  of ConfiguredFeatureKind.BonusChest: generateBonusChest(c, random, at)
  of ConfiguredFeatureKind.DripstoneCluster: generateDripstoneCluster(c, at)
  of ConfiguredFeatureKind.LargeDripstone: generateLargeDripstone(c, random, at)
  of ConfiguredFeatureKind.SculkPatch: generateSculkPatch(f, c, random, at)
  of ConfiguredFeatureKind.BlockPile: generateBlockPile(f, c, random, at)
  of ConfiguredFeatureKind.ReplaceSingleBlock: generateReplaceSingleBlock(f, c, random, at)
  of ConfiguredFeatureKind.VoidStartPlatform: generateVoidStartPlatform(c, at)
  of ConfiguredFeatureKind.DesertWell: generateDesertWell(c, random, at)

proc seaLevelOf(minY: int8, chunk: GenerationCache): int32 =
  ## What upstream's newer `get_sea_level` answers: overworld 63, nether 32, end 0. A bare chunk here has no generator.
  if minY < 0'i8:
    return 63'i32
  let center = centerChunkOf(chunk)
  let b = getBiome(center, center.x shl 4, 64'i32, center.z shl 4)
  case b.registryId
  of "nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas": 32'i32
  else: 0'i32

proc generatePlacedFeatureHook*(feature: placedenum.PlacedFeature, cache: GenerationCache, registry: WorldPortalExt, minY: int8,
                               height: uint16, random: var RandomGenerator, origin: BlockPos) =
  ## `PLACED_FEATURES.get(&feature_enum)` and `feature.generate(..)`
  let ctx = FeatureContext(chunk: cache, blockRegistry: registry, minY: minY, height: height, worldSeed: featureWorldSeed,
    seaLevel: seaLevelOf(minY, cache), accessor: generationCacheAsAccessor(cache), feature: feature)
  discard generatePlaced(placedFeatureDef(feature), ctx, random, origin)

proc installFeatureHooks*() =
  ## Sets the placed-feature hook. Importing this module does it, as structure/protostructures does for its hooks; safe to call twice.
  installPlacedHooks()
  configuredGenerateHook = generateConfigured
  structureHooks.generatePlacedFeature = proc(feature: placedenum.PlacedFeature, cache: GenerationCache, registry: WorldPortalExt,
                                              minY: int8, height: uint16, random: var RandomGenerator, origin: BlockPos) {.closure.} =
    generatePlacedFeatureHook(feature, cache, registry, minY, height, random, origin)

installFeatureHooks()
