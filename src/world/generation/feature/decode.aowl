## The typed form of src/generated/configured_features_generated.aowl and placed_features_generated.aowl.
## Port of pumpkin-codegen/src/configured_feature.rs and pumpkin-codegen/src/placed_feature.rs: `build` and its `value_to_*`
## helpers, run when a table is first used rather than when the generators run, because a seq-of-objects literal of this
## size would make compile times unusable (see generated/gendecode.aowl). The tables hold the assets' entries.
##
## Defaults are the assets' own: 26.2 leaves a value out when it is its codec's default, so these are vanilla's, not
## upstream's. Upstream's generator reads a missing int provider as 0, which turns a geode's three to four distribution
## points into none; 1.21.11's files (which spell every default out) confirm the values here. Upstream's newer checkout
## has its `fallen_tree`, `multiface_growth`, `huge_fungus` and `delta_feature` fields, ported here too.

{.feature: "lenientnils".}

import std/[json, tables, syncio]
import ../../../generated/tag
import ../../../generated/placed_feature as placedenum
import ../../../generated/configured_feature as configuredenum
import ../../../util/y_offset
import ../../../util/vector3 except Axis
import ../../../util/math/pool
from ../../../util/utillib import DoublePerlinNoiseParametersCodec
import types
import common

# --- JSON ------------------------------------------------------------------------------------------------------------

proc fieldOf(n: JsonNode; key: string): (bool, JsonNode) =
  if kind(n) != JObject:
    return (false, n)
  for k, v in pairs(n):
    if k == key:
      return (true, v)
  (false, n)

proc has(n: JsonNode; key: string): bool = fieldOf(n, key)[0]

var nullTree = parseJson("null")
  ## A real null to answer with: `kind(JsonNode())` asserts, whatever its doc says.

proc at(n: JsonNode; key: string): JsonNode =
  ## The field, or JSON null: `v["x"]` on a `serde_json::Value`.
  let (ok, v) = fieldOf(n, key)
  if ok: v else: root(nullTree)

proc arr(n: JsonNode): seq[JsonNode] =
  ## The array's elements; none for anything else, where `items` would assert.
  result = newSeq[JsonNode](0)
  if kind(n) == JArray:
    for e in items(n):
      result.add(e)

proc num(n: JsonNode): float64 =
  if kind(n) == JInt: float64(getInt(n)) else: getFloat(n)

proc isNum(n: JsonNode): bool = kind(n) == JInt or kind(n) == JFloat

proc strAt(n: JsonNode; key: string; default = ""): string =
  let v = at(n, key)
  if kind(v) == JString: getStr(v) else: default

proc i32At(n: JsonNode; key: string; default: int32 = 0): int32 =
  let v = at(n, key)
  if isNum(v): int32(num(v)) else: default

proc f64At(n: JsonNode; key: string; default = 0.0'f64): float64 =
  let v = at(n, key)
  if isNum(v): num(v) else: default

proc f32At(n: JsonNode; key: string; default = 0.0'f32): float32 =
  let v = at(n, key)
  if isNum(v): float32(num(v)) else: default

proc boolAt(n: JsonNode; key: string; default = false): bool =
  let v = at(n, key)
  if kind(v) == JBool: getBool(v) else: default

proc die(msg: string) =
  echo "feature decode: ", msg
  quit(1)

proc bareName(s: string): string =
  if s.len > 10 and s[0 .. 9] == "minecraft:": s[10 .. ^1] else: s

# --- value_to_* in placed_feature.rs ---------------------------------------------------------------------------------

proc toBlockState*(v: JsonNode): BlockStateId =
  ## `value_to_block_state`
  let (ok, id) = blockIdByName(strAt(v, "Name", "minecraft:air"))
  if not ok:
    die("unknown block " & strAt(v, "Name"))
  let props = at(v, "Properties")
  if kind(props) != JObject:
    return defaultStateOf(id)
  var kv = newSeq[StateProp](0)
  for k, pv in pairs(props):
    kv.add((name: k, value: getStr(pv)))
  stateIdFromProps(id, kv)

proc toBlockStateCodec(v: JsonNode): BlockStateCodec =
  ## `value_to_block_state_codec`
  let (ok, id) = blockIdByName(strAt(v, "Name", "minecraft:air"))
  if not ok:
    die("unknown block " & strAt(v, "Name"))
  var kv = newSeq[StateProp](0)
  let props = at(v, "Properties")
  let hasProps = kind(props) == JObject
  if hasProps:
    for k, pv in pairs(props):
      kv.add((name: k, value: getStr(pv)))
  BlockStateCodec(name: id, hasProperties: hasProps, properties: kv)

proc toDirection(s: string): BlockDirection =
  case s
  of "down": BlockDirection.Down
  of "up": BlockDirection.Up
  of "north": BlockDirection.North
  of "south": BlockDirection.South
  of "west": BlockDirection.West
  of "east": BlockDirection.East
  else:
    die("unknown direction " & s)
    BlockDirection.Down

proc toHeightMap(s: string): HeightMap =
  case s
  of "WORLD_SURFACE_WG": WorldSurfaceWg
  of "WORLD_SURFACE": WorldSurface
  of "OCEAN_FLOOR_WG": OceanFloorWg
  of "OCEAN_FLOOR": OceanFloor
  of "MOTION_BLOCKING": MotionBlocking
  of "MOTION_BLOCKING_NO_LEAVES": MotionBlockingNoLeaves
  else:
    die("unknown heightmap " & s)
    MotionBlocking

proc toYOffset(v: JsonNode): YOffset =
  ## `value_to_y_offset`
  if has(v, "absolute"):
    YOffset(kind: yokAbsolute, absolute: int16(i32At(v, "absolute")))
  elif has(v, "above_bottom"):
    YOffset(kind: yokAboveBottom, aboveBottom: int8(i32At(v, "above_bottom")))
  elif has(v, "below_top"):
    YOffset(kind: yokBelowTop, belowTop: int8(i32At(v, "below_top")))
  else:
    YOffset(kind: yokAbsolute, absolute: 0'i16)

proc toHeightProvider(v: JsonNode): HeightProvider =
  ## `value_to_height_provider`
  case strAt(v, "type")
  of "minecraft:uniform":
    HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: toYOffset(at(v, "min_inclusive")),
      maxInclusive: toYOffset(at(v, "max_inclusive")))
  of "minecraft:trapezoid":
    let pv = at(v, "plateau")
    HeightProvider(kind: HeightProviderKind.Trapezoid, minInclusive: toYOffset(at(v, "min_inclusive")),
      maxInclusive: toYOffset(at(v, "max_inclusive")), hasPlateau: isNum(pv), plateau: if isNum(pv): int32(num(pv)) else: 0'i32)
  of "minecraft:very_biased_to_bottom":
    let iv = at(v, "inner")
    HeightProvider(kind: HeightProviderKind.VeryBiasedToBottom, minInclusive: toYOffset(at(v, "min_inclusive")),
      maxInclusive: toYOffset(at(v, "max_inclusive")), hasInner: isNum(iv), inner: if isNum(iv): uint32(num(iv)) else: 1'u32)
  of "minecraft:constant":
    let y = toYOffset(at(v, "value"))
    HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: y, maxInclusive: y)
  else:
    die("unknown height provider " & strAt(v, "type"))
    default(HeightProvider)

proc toIntProvider(v: JsonNode): IntProvider =
  ## `value_to_int_provider`
  case kind(v)
  of JNull:
    intProvider(0'i32)
  of JInt, JFloat:
    intProvider(int32(num(v)))
  of JObject:
    case strAt(v, "type")
    of "minecraft:constant":
      intProvider(normal(newConstantIntProvider(i32At(v, "value"))))
    of "minecraft:uniform":
      intProvider(normal(newUniformIntProvider(i32At(v, "min_inclusive"), i32At(v, "max_inclusive"))))
    of "minecraft:biased_to_bottom":
      intProvider(normal(newBiasedToBottomIntProvider(i32At(v, "min_inclusive"), i32At(v, "max_inclusive"))))
    of "minecraft:clamped":
      intProvider(normal(newClampedIntProvider(toIntProvider(at(v, "source")), i32At(v, "min_inclusive"), i32At(v, "max_inclusive"))))
    of "minecraft:trapezoid":
      intProvider(normal(newTrapezoidIntProvider(i32At(v, "min"), i32At(v, "max"), i32At(v, "plateau"))))
    of "minecraft:clamped_normal":
      intProvider(normal(newClampedNormalIntProvider(f32At(v, "mean"), f32At(v, "deviation", 1.0'f32), i32At(v, "min_inclusive"), i32At(v, "max_inclusive"))))
    of "minecraft:weighted_list":
      var entries = newSeq[WeightedEntry](0)
      for e in arr(at(v, "distribution")):
        entries.add(WeightedEntry(data: toIntProvider(at(e, "data")), weight: i32At(e, "weight", 1'i32)))
      intProvider(normal(newWeightedListIntProvider(entries)))
    else:
      die("unknown int provider " & strAt(v, "type"))
      intProvider(0'i32)
  else:
    die("unknown int provider")
    intProvider(0'i32)

proc uniform(a, b: int32): IntProvider = intProvider(normal(newUniformIntProvider(a, b)))

proc intProviderOr(n: JsonNode, key: string, dflt: IntProvider): IntProvider =
  if has(n, key): toIntProvider(at(n, key)) else: dflt

proc offsetInto(p: BlockPredicate, v: JsonNode) =
  ## `value_to_offset_predicate`
  if kind(v) == JArray and len(v) >= 3:
    p.hasOffset = true
    p.offset = vec3[int32](int32(num(arr(v)[0])), int32(num(arr(v)[1])), int32(num(arr(v)[2])))

proc namesOf(v: JsonNode): seq[string] =
  ## `value_to_matching_blocks_wrapper`
  result = newSeq[string](0)
  if kind(v) == JString:
    result.add(bareName(getStr(v)))
  elif kind(v) == JArray:
    for s in arr(v):
      result.add(bareName(getStr(s)))

proc toBlockPredicate*(v: JsonNode): BlockPredicate =
  ## `value_to_block_predicate`
  if kind(v) == JString:
    let s = getStr(v)
    if s.len > 0 and s[0] == '#':
      return BlockPredicate(kind: BlockPredicateKind.MatchingBlockTag, tag: blockTag(s[1 .. ^1]))
    return BlockPredicate(kind: BlockPredicateKind.AlwaysTrue)
  let t = strAt(v, "type")
  result = BlockPredicate(kind: BlockPredicateKind.AlwaysTrue)
  case t
  of "minecraft:true", "":
    discard
  of "minecraft:matching_blocks":
    result.kind = BlockPredicateKind.MatchingBlocks
    offsetInto(result, at(v, "offset"))
    result.names = namesOf(at(v, "blocks"))
  of "minecraft:matching_block_tag":
    result.kind = BlockPredicateKind.MatchingBlockTag
    offsetInto(result, at(v, "offset"))
    result.tag = blockTag(strAt(v, "tag"))
  of "minecraft:matching_fluids":
    result.kind = BlockPredicateKind.MatchingFluids
    offsetInto(result, at(v, "offset"))
    result.names = namesOf(at(v, "fluids"))
  of "minecraft:has_sturdy_face":
    result.kind = BlockPredicateKind.HasSturdyFace
    offsetInto(result, at(v, "offset"))
    result.direction = ord(toDirection(strAt(v, "direction", "down")))
  of "minecraft:solid":
    result.kind = BlockPredicateKind.Solid
    offsetInto(result, at(v, "offset"))
  of "minecraft:replaceable":
    result.kind = BlockPredicateKind.Replaceable
    offsetInto(result, at(v, "offset"))
  of "minecraft:would_survive":
    result.kind = BlockPredicateKind.WouldSurvive
    offsetInto(result, at(v, "offset"))
    result.state = toBlockStateCodec(at(v, "state"))
  of "minecraft:inside_world_bounds":
    result.kind = BlockPredicateKind.InsideWorldBounds
    offsetInto(result, at(v, "offset"))
  of "minecraft:any_of", "minecraft:all_of":
    result.kind = if t == "minecraft:any_of": BlockPredicateKind.AnyOf else: BlockPredicateKind.AllOf
    result.predicates = newSeq[BlockPredicate](0)
    for e in arr(at(v, "predicates")):
      result.predicates.add(toBlockPredicate(e))
  of "minecraft:not":
    result.kind = BlockPredicateKind.Not
    result.predicates = @[toBlockPredicate(at(v, "predicate"))]
  else:
    die("unknown block predicate " & t)

proc toPlacementModifier(v: JsonNode): PlacementModifier =
  ## `value_to_placement_modifier`
  let t = strAt(v, "type")
  result = PlacementModifier(kind: PlacementModifierKind.Biome)
  case t
  of "minecraft:biome":
    result.kind = PlacementModifierKind.Biome
  of "minecraft:in_square":
    result.kind = PlacementModifierKind.InSquare
  of "minecraft:fixed_placement":
    result.kind = PlacementModifierKind.FixedPlacement
    result.positions = newSeq[BlockPos](0)
    for p in arr(at(v, "positions")):
      result.positions.add(pos(int32(num(arr(p)[0])), int32(num(arr(p)[1])), int32(num(arr(p)[2]))))
  of "minecraft:heightmap":
    result.kind = PlacementModifierKind.Heightmap
    result.heightmap = toHeightMap(strAt(v, "heightmap"))
  of "minecraft:height_range":
    result.kind = PlacementModifierKind.HeightRange
    result.height = toHeightProvider(at(v, "height"))
  of "minecraft:count":
    result.kind = PlacementModifierKind.Count
    result.count = toIntProvider(at(v, "count"))
  of "minecraft:count_on_every_layer":
    result.kind = PlacementModifierKind.CountOnEveryLayer
    result.count = toIntProvider(at(v, "count"))
  of "minecraft:rarity_filter":
    result.kind = PlacementModifierKind.RarityFilter
    result.chance = uint32(i32At(v, "chance", 1'i32))
  of "minecraft:block_predicate_filter":
    result.kind = PlacementModifierKind.BlockPredicateFilter
    result.predicate = toBlockPredicate(at(v, "predicate"))
  of "minecraft:surface_relative_threshold_filter":
    result.kind = PlacementModifierKind.SurfaceRelativeThresholdFilter
    result.heightmap = toHeightMap(strAt(v, "heightmap", "MOTION_BLOCKING"))
    result.hasMin = isNum(at(v, "min_inclusive"))
    result.hasMax = isNum(at(v, "max_inclusive"))
    result.minInclusive = i32At(v, "min_inclusive")
    result.maxInclusive = i32At(v, "max_inclusive")
  of "minecraft:surface_water_depth_filter":
    result.kind = PlacementModifierKind.SurfaceWaterDepthFilter
    result.maxWaterDepth = i32At(v, "max_water_depth")
  of "minecraft:noise_based_count":
    result.kind = PlacementModifierKind.NoiseBasedCount
    result.toCountRatio = i32At(v, "noise_to_count_ratio")
    result.factor = f64At(v, "noise_factor", 1.0)
    result.offset = f64At(v, "noise_offset", 0.0)
  of "minecraft:noise_threshold_count":
    result.kind = PlacementModifierKind.NoiseThresholdCount
    result.noiseLevel = f64At(v, "noise_level")
    result.belowNoise = i32At(v, "below_noise")
    result.aboveNoise = i32At(v, "above_noise")
  of "minecraft:environment_scan":
    result.kind = PlacementModifierKind.EnvironmentScan
    result.directionOfSearch = toDirection(strAt(v, "direction_of_search", "down"))
    result.targetCondition = toBlockPredicate(at(v, "target_condition"))
    if kind(at(v, "allowed_search_condition")) == JObject:
      result.allowedSearchCondition = toBlockPredicate(at(v, "allowed_search_condition"))
    result.maxSteps = i32At(v, "max_steps", 1'i32)
  of "minecraft:random_offset":
    result.kind = PlacementModifierKind.RandomOffset
    result.xzSpread = toIntProvider(at(v, "xz_spread"))
    result.ySpread = toIntProvider(at(v, "y_spread"))
  else:
    die("unknown placement modifier " & t)

# --- value_to_* in configured_feature.rs -----------------------------------------------------------------------------

proc toDpnp(v: JsonNode): DoublePerlinNoiseParametersCodec =
  ## `value_to_dpnp`
  var amplitudes = newSeq[float64](0)
  for a in arr(at(v, "amplitudes")):
    amplitudes.add(num(a))
  var minOctave = int32.high
  var maxOctave = int32.low
  for i in 0 ..< amplitudes.len:
    if amplitudes[i] != 0.0:
      minOctave = min(minOctave, int32(i))
      maxOctave = max(maxOctave, int32(i))
  let octaves = maxOctave - minOctave
  let createAmp = 0.1'f64 * (1.0'f64 + 1.0'f64 / float64(octaves + 1))
  DoublePerlinNoiseParametersCodec(firstOctave: i32At(v, "firstOctave", -7'i32), amplitudes: amplitudes,
    amplitude: 0.16666666666666666'f64 / createAmp)

proc toNoiseBase(v: JsonNode): NoiseBlockStateProviderBase =
  ## `value_to_noise_base`
  let sv = at(v, "seed")
  NoiseBlockStateProviderBase(seed: if kind(sv) == JInt: int64(getInt(sv)) else: 0'i64, noise: toDpnp(at(v, "noise")),
    scale: f32At(v, "scale", 1.0'f32))

proc statesOf(v: JsonNode): seq[BlockStateId] =
  result = newSeq[BlockStateId](0)
  if kind(v) == JArray:
    for s in arr(v):
      result.add(toBlockState(s))

proc toBlockStateProvider*(v: JsonNode): BlockStateProvider =
  ## `value_to_block_state_provider`
  let t = strAt(v, "type")
  result = BlockStateProvider(kind: BlockStateProviderKind.Simple)
  case t
  of "minecraft:simple_state_provider":
    result.state = toBlockState(at(v, "state"))
  of "minecraft:weighted_state_provider":
    result.kind = BlockStateProviderKind.WeightedList
    result.entries = newSeq[Weighted[BlockStateId]](0)
    for e in arr(at(v, "entries")):
      result.entries.add(Weighted[BlockStateId](data: toBlockState(at(e, "data")), weight: i32At(e, "weight", 1'i32)))
  of "minecraft:rotated_block_provider":
    result.kind = BlockStateProviderKind.Pillar
    result.state = toBlockState(at(v, "state"))
  of "minecraft:noise_provider":
    result.kind = BlockStateProviderKind.NoiseProvider
    result.base = toNoiseBase(v)
    result.states = statesOf(at(v, "states"))
  of "minecraft:dual_noise_provider":
    result.kind = BlockStateProviderKind.DualNoise
    result.base = toNoiseBase(v)
    result.states = statesOf(at(v, "states"))
    let variety = at(v, "variety")
    result.variety = if kind(variety) == JArray: [uint32(num(arr(variety)[0])), uint32(num(arr(variety)[1]))] else: [2'u32, 4'u32]
    result.slowNoise = toDpnp(at(v, "slow_noise"))
    result.slowScale = f64At(v, "slow_scale", 1.0)
  of "minecraft:noise_threshold_provider":
    result.kind = BlockStateProviderKind.NoiseThreshold
    result.base = toNoiseBase(v)
    result.threshold = f32At(v, "threshold")
    result.highChance = f32At(v, "high_chance")
    result.state = toBlockState(at(v, "default_state"))
    result.lowStates = statesOf(at(v, "low_states"))
    result.highStates = statesOf(at(v, "high_states"))
  of "minecraft:randomized_int_state_provider":
    result.kind = BlockStateProviderKind.RandomizedInt
    result.source = toBlockStateProvider(at(v, "source"))
    result.property = strAt(v, "property")
    result.values = toIntProvider(at(v, "values"))
  of "minecraft:rule_based_state_provider":
    result.kind = BlockStateProviderKind.Rule
    let fb = at(v, "fallback")
    if kind(fb) != JNull:
      result.fallback = toBlockStateProvider(fb)
    result.rules = newSeq[BlockStateRule](0)
    for r in arr(at(v, "rules")):
      result.rules.add(BlockStateRule(ifTrue: toBlockPredicate(at(r, "if_true")), then: toBlockStateProvider(at(r, "then"))))
  else:
    result.state = SAir

proc toRuleTest(v: JsonNode): RuleTest =
  ## `value_to_rule_test`
  case strAt(v, "predicate_type")
  of "minecraft:always_true", "":
    RuleTest(kind: RuleTestKind.AlwaysTrue)
  of "minecraft:block_match":
    RuleTest(kind: RuleTestKind.BlockMatch, blockId: blockIdOfName(strAt(v, "block", "minecraft:stone")))
  of "minecraft:blockstate_match":
    RuleTest(kind: RuleTestKind.BlockStateMatch, blockState: toBlockState(at(v, "block_state")))
  of "minecraft:tag_match":
    RuleTest(kind: RuleTestKind.TagMatch, tag: blockTag(strAt(v, "tag")))
  of "minecraft:random_block_match":
    RuleTest(kind: RuleTestKind.RandomBlockMatch, blockId: blockIdOfName(strAt(v, "block", "minecraft:stone")),
      probability: f32At(v, "probability", 0.5'f32))
  of "minecraft:random_blockstate_match":
    RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: toBlockState(at(v, "block_state")),
      probability: f32At(v, "probability", 0.5'f32))
  else:
    die("unknown rule test " & strAt(v, "predicate_type"))
    RuleTest(kind: RuleTestKind.AlwaysTrue)

proc toBlockIds(v: JsonNode): seq[uint16] =
  ## `value_to_block_list`: a tag, or a list of names. Upstream hands back the tag's ids.
  result = newSeq[uint16](0)
  if kind(v) == JString:
    let s = getStr(v)
    if s.len > 0 and s[0] == '#':
      return blockTag(s[1 .. ^1]).ids
    result.add(uint16(blockIdOfName(s)))
  elif kind(v) == JArray:
    for b in arr(v):
      result.add(uint16(blockIdOfName(getStr(b))))

proc toFeatureSize(v: JsonNode): FeatureSize =
  ## `value_to_feature_size`
  result = FeatureSize(minClippedHeight: -1'i32, kind: FeatureSizeTypeKind.TwoLayers, limit: i32At(v, "limit", 1'i32),
    lowerSize: i32At(v, "lower_size", 0'i32), upperSize: i32At(v, "upper_size", 1'i32))
  if isNum(at(v, "min_clipped_height")):
    result.minClippedHeight = i32At(v, "min_clipped_height")
  if strAt(v, "type") == "minecraft:three_layers_feature_size":
    result.kind = FeatureSizeTypeKind.ThreeLayers
    result.upperLimit = i32At(v, "upper_limit", 1'i32)
    result.middleSize = i32At(v, "middle_size", 1'i32)

proc toTrunkPlacer(v: JsonNode): TrunkPlacer =
  ## `value_to_trunk_placer`
  result = TrunkPlacer(baseHeight: i32At(v, "base_height", 5'i32), heightRandA: i32At(v, "height_rand_a"),
    heightRandB: i32At(v, "height_rand_b"), kind: TrunkTypeKind.Straight)
  case strAt(v, "type")
  of "minecraft:forking_trunk_placer": result.kind = TrunkTypeKind.Forking
  of "minecraft:giant_trunk_placer": result.kind = TrunkTypeKind.Giant
  of "minecraft:mega_jungle_trunk_placer": result.kind = TrunkTypeKind.MegaJungle
  of "minecraft:dark_oak_trunk_placer": result.kind = TrunkTypeKind.DarkOak
  of "minecraft:fancy_trunk_placer": result.kind = TrunkTypeKind.Fancy
  of "minecraft:bending_trunk_placer":
    result.kind = TrunkTypeKind.Bending
    result.minHeightForLeaves = i32At(v, "min_height_for_leaves", 1'i32)
    result.bendLength = toIntProvider(at(v, "bend_length"))
  of "minecraft:upwards_branching_trunk_placer":
    result.kind = TrunkTypeKind.UpwardsBranching
    result.extraBranchSteps = toIntProvider(at(v, "extra_branch_steps"))
    result.placeBranchPerLogProbability = f32At(v, "place_branch_per_log_probability")
    result.extraBranchLength = toIntProvider(at(v, "extra_branch_length"))
    result.canGrowThrough = toBlockIds(at(v, "can_grow_through"))
  of "minecraft:cherry_trunk_placer":
    result.kind = TrunkTypeKind.Cherry
    result.count = toIntProvider(at(v, "branch_count"))
    result.horizontalLength = toIntProvider(at(v, "branch_horizontal_length"))
    let so = at(v, "branch_start_offset_from_top")
    result.startOffsetMin = i32At(so, "min_inclusive")
    result.startOffsetMax = i32At(so, "max_inclusive")
    result.endOffsetFromTop = toIntProvider(at(v, "branch_end_offset_from_top"))
  else:
    discard

proc toFoliagePlacer(v: JsonNode): FoliagePlacer =
  ## `value_to_foliage_placer`. The heights are each placer's codec default when left out.
  result = FoliagePlacer(radius: toIntProvider(at(v, "radius")), offset: toIntProvider(at(v, "offset")),
    kind: FoliageTypeKind.Blob, height: i32At(v, "height", 3'i32))
  case strAt(v, "type")
  of "minecraft:spruce_foliage_placer":
    result.kind = FoliageTypeKind.Spruce
    result.heightProvider = toIntProvider(at(v, "trunk_height"))
  of "minecraft:pine_foliage_placer":
    result.kind = FoliageTypeKind.Pine
    result.heightProvider = toIntProvider(at(v, "height"))
  of "minecraft:acacia_foliage_placer":
    result.kind = FoliageTypeKind.Acacia
  of "minecraft:bush_foliage_placer":
    result.kind = FoliageTypeKind.Bush
    result.height = i32At(v, "height", 2'i32)
  of "minecraft:fancy_foliage_placer":
    result.kind = FoliageTypeKind.Fancy
    result.height = i32At(v, "height", 4'i32)
  of "minecraft:jungle_foliage_placer":
    result.kind = FoliageTypeKind.Jungle
    result.height = i32At(v, "height", 2'i32)
  of "minecraft:mega_pine_foliage_placer":
    result.kind = FoliageTypeKind.MegaPine
    result.heightProvider = toIntProvider(at(v, "crown_height"))
  of "minecraft:dark_oak_foliage_placer":
    result.kind = FoliageTypeKind.DarkOak
  of "minecraft:random_spread_foliage_placer":
    result.kind = FoliageTypeKind.RandomSpread
    result.heightProvider = toIntProvider(at(v, "foliage_height"))
    result.leafPlacementAttempts = i32At(v, "leaf_placement_attempts", 128'i32)
  of "minecraft:cherry_foliage_placer":
    result.kind = FoliageTypeKind.Cherry
    result.heightProvider = toIntProvider(at(v, "height"))
    result.wideBottomLayerHoleChance = f32At(v, "wide_bottom_layer_hole_chance")
    result.cornerHoleChance = f32At(v, "corner_hole_chance")
    result.hangingLeavesChance = f32At(v, "hanging_leaves_chance")
    result.hangingLeavesExtensionChance = f32At(v, "hanging_leaves_extension_chance")
  else:
    discard

proc toDirections(v: JsonNode): seq[BlockDirection] =
  result = newSeq[BlockDirection](0)
  if kind(v) == JArray:
    for d in arr(v):
      result.add(toDirection(getStr(d)))

proc toTreeDecorator(v: JsonNode): TreeDecorator =
  ## `value_to_tree_decorator`
  result = TreeDecorator(kind: TreeDecoratorKind.TrunkVine, probability: f32At(v, "probability"))
  case strAt(v, "type")
  of "minecraft:trunk_vine":
    result.kind = TreeDecoratorKind.TrunkVine
  of "minecraft:leave_vine":
    result.kind = TreeDecoratorKind.LeaveVine
  of "minecraft:cocoa":
    result.kind = TreeDecoratorKind.Cocoa
  of "minecraft:beehive":
    result.kind = TreeDecoratorKind.Beehive
  of "minecraft:alter_ground":
    result.kind = TreeDecoratorKind.AlterGround
    result.provider = toBlockStateProvider(at(v, "provider"))
  of "minecraft:attached_to_logs":
    result.kind = TreeDecoratorKind.AttachedToLogs
    result.provider = toBlockStateProvider(at(v, "block_provider"))
    result.directions = toDirections(at(v, "directions"))
  of "minecraft:attached_to_leaves":
    result.kind = TreeDecoratorKind.AttachedToLeaves
    result.exclusionRadiusXz = i32At(v, "exclusion_radius_xz")
    result.exclusionRadiusY = i32At(v, "exclusion_radius_y")
    result.provider = toBlockStateProvider(at(v, "block_provider"))
    result.requiredEmptyBlocks = i32At(v, "required_empty_blocks")
    result.directions = toDirections(at(v, "directions"))
  of "minecraft:place_on_ground":
    result.kind = TreeDecoratorKind.PlaceOnGround
    result.tries = i32At(v, "tries", 128'i32)
    result.radius = i32At(v, "radius", 2'i32)
    result.height = i32At(v, "height", 1'i32)
    result.provider = toBlockStateProvider(at(v, "block_state_provider"))
  of "minecraft:creaking_heart":
    result.kind = TreeDecoratorKind.CreakingHeart
  of "minecraft:pale_moss":
    result.kind = TreeDecoratorKind.PaleMoss
    result.leavesProbability = f32At(v, "leaves_probability")
    result.trunkProbability = f32At(v, "trunk_probability")
    result.groundProbability = f32At(v, "ground_probability")
  else:
    die("unknown tree decorator " & strAt(v, "type"))

proc toDecorators(v: JsonNode): seq[TreeDecorator] =
  result = newSeq[TreeDecorator](0)
  if kind(v) == JArray:
    for d in arr(v):
      result.add(toTreeDecorator(d))

proc toRootPlacer(v: JsonNode): MangroveRootPlacer =
  ## `value_to_root_placer`
  let mrp = at(v, "mangrove_root_placement")
  result = MangroveRootPlacer(trunkOffsetY: toIntProvider(at(v, "trunk_offset_y")),
    rootProvider: toBlockStateProvider(at(v, "root_provider")),
    canGrowThrough: toBlockIds(at(mrp, "can_grow_through")), muddyRootsIn: toBlockIds(at(mrp, "muddy_roots_in")),
    muddyRootsProvider: toBlockStateProvider(at(mrp, "muddy_roots_provider")),
    maxRootWidth: i32At(mrp, "max_root_width", 8'i32), maxRootLength: i32At(mrp, "max_root_length", 15'i32),
    randomSkewChance: f32At(mrp, "random_skew_chance"))
  let av = at(v, "above_root_placement")
  if kind(av) == JObject:
    result.hasAbove = true
    result.aboveRootProvider = toBlockStateProvider(at(av, "above_root_provider"))
    result.aboveRootPlacementChance = f32At(av, "above_root_placement_chance")

proc toTreeFeature(c: JsonNode): TreeFeature =
  ## `value_to_tree_feature`. 1.21.11's `dirt_provider` is the older form of `below_trunk_provider`.
  let below = if has(c, "below_trunk_provider"): toBlockStateProvider(at(c, "below_trunk_provider"))
              else: toBlockStateProvider(at(c, "dirt_provider"))
  result = TreeFeature(trunkProvider: toBlockStateProvider(at(c, "trunk_provider")),
    trunkPlacer: toTrunkPlacer(at(c, "trunk_placer")), foliageProvider: toBlockStateProvider(at(c, "foliage_provider")),
    foliagePlacer: toFoliagePlacer(at(c, "foliage_placer")), minimumSize: toFeatureSize(at(c, "minimum_size")),
    ignoreVines: boolAt(c, "ignore_vines", true), decorators: toDecorators(at(c, "decorators")), belowTrunkProvider: below)
  let rp = at(c, "root_placer")
  if kind(rp) == JObject:
    result.rootPlacer = toRootPlacer(rp)

proc toFossilProcessor(v: JsonNode): FossilProcessor =
  case getStr(v)
  of "minecraft:fossil_rot": FossilProcessor.FossilRot
  of "minecraft:fossil_coal": FossilProcessor.Coal
  of "minecraft:fossil_diamonds": FossilProcessor.Diamonds
  else:
    die("unknown fossil processor " & getStr(v))
    FossilProcessor.FossilRot

proc toInlinePlaced(v: JsonNode): PlacedFeatureDef
proc toWrapper(v: JsonNode): PlacedFeatureWrapper

proc kindOf(t: string): ConfiguredFeatureKind =
  ## The arms of `value_to_configured_feature`, including the ones where the variant's name is not the asset's type.
  case t
  of "minecraft:no_op", "minecraft:sequence", "minecraft:weighted_random_selector": ConfiguredFeatureKind.NoOp
  of "minecraft:bamboo": ConfiguredFeatureKind.Bamboo
  of "minecraft:seagrass": ConfiguredFeatureKind.Seagrass
  of "minecraft:sea_pickle": ConfiguredFeatureKind.SeaPickle
  of "minecraft:nether_forest_vegetation": ConfiguredFeatureKind.NetherForestVegetation
  of "minecraft:netherrack_replace_blobs": ConfiguredFeatureKind.NetherrackReplaceBlobs
  of "minecraft:simple_block": ConfiguredFeatureKind.SimpleBlock
  of "minecraft:ore": ConfiguredFeatureKind.Ore
  of "minecraft:scattered_ore": ConfiguredFeatureKind.ScatteredOre
  of "minecraft:spring_feature": ConfiguredFeatureKind.SpringFeature
  of "minecraft:block_column": ConfiguredFeatureKind.BlockColumn
  of "minecraft:fallen_tree": ConfiguredFeatureKind.FallenTree
  of "minecraft:flower": ConfiguredFeatureKind.Flower
  of "minecraft:no_bonemeal_flower": ConfiguredFeatureKind.NoBonemealFlower
  of "minecraft:random_patch": ConfiguredFeatureKind.RandomPatch
  of "minecraft:random_selector": ConfiguredFeatureKind.RandomSelector
  of "minecraft:simple_random_selector": ConfiguredFeatureKind.SimpleRandomSelector
  of "minecraft:random_boolean_selector": ConfiguredFeatureKind.RandomBooleanSelector
  of "minecraft:end_spike": ConfiguredFeatureKind.EndSpike
  of "minecraft:tree": ConfiguredFeatureKind.Tree
  of "minecraft:pointed_dripstone", "minecraft:speleothem": ConfiguredFeatureKind.PointedDripstone
  of "minecraft:geode": ConfiguredFeatureKind.Geode
  of "minecraft:monster_room": ConfiguredFeatureKind.MonsterRoom
  of "minecraft:underwater_magma": ConfiguredFeatureKind.UnderwaterMagma
  of "minecraft:vegetation_patch": ConfiguredFeatureKind.VegetationPatch
  of "minecraft:waterlogged_vegetation_patch": ConfiguredFeatureKind.WaterloggedVegetationPatch
  of "minecraft:glowstone_blob": ConfiguredFeatureKind.GlowstoneBlob
  of "minecraft:disk": ConfiguredFeatureKind.Disk
  of "minecraft:basalt_columns": ConfiguredFeatureKind.BasaltColumns
  of "minecraft:basalt_pillar": ConfiguredFeatureKind.BasaltPillar
  of "minecraft:block_blob", "minecraft:forest_rock": ConfiguredFeatureKind.ForestRock
  of "minecraft:freeze_top_layer": ConfiguredFeatureKind.FreezeTopLayer
  of "minecraft:ice_spike", "minecraft:spike": ConfiguredFeatureKind.IceSpike
  of "minecraft:iceberg": ConfiguredFeatureKind.Iceberg
  of "minecraft:chorus_plant": ConfiguredFeatureKind.ChorusPlant
  of "minecraft:end_platform": ConfiguredFeatureKind.EndPlatform
  of "minecraft:end_island": ConfiguredFeatureKind.EndIsland
  of "minecraft:kelp": ConfiguredFeatureKind.Kelp
  of "minecraft:fossil": ConfiguredFeatureKind.Fossil
  of "minecraft:lake": ConfiguredFeatureKind.Lake
  of "minecraft:huge_brown_mushroom": ConfiguredFeatureKind.HugeBrownMushroom
  of "minecraft:huge_red_mushroom": ConfiguredFeatureKind.HugeRedMushroom
  of "minecraft:vines": ConfiguredFeatureKind.Vines
  of "minecraft:root_system": ConfiguredFeatureKind.RootSystem
  of "minecraft:multiface_growth": ConfiguredFeatureKind.MultifaceGrowth
  of "minecraft:blue_ice": ConfiguredFeatureKind.BlueIce
  of "minecraft:end_gateway": ConfiguredFeatureKind.EndGateway
  of "minecraft:coral_tree": ConfiguredFeatureKind.CoralTree
  of "minecraft:coral_mushroom": ConfiguredFeatureKind.CoralMushroom
  of "minecraft:coral_claw": ConfiguredFeatureKind.CoralClaw
  of "minecraft:huge_fungus": ConfiguredFeatureKind.HugeFungus
  of "minecraft:weeping_vines": ConfiguredFeatureKind.WeepingVines
  of "minecraft:twisting_vines": ConfiguredFeatureKind.TwistingVines
  of "minecraft:delta_feature": ConfiguredFeatureKind.DeltaFeature
  of "minecraft:fill_layer": ConfiguredFeatureKind.FillLayer
  of "minecraft:bonus_chest": ConfiguredFeatureKind.BonusChest
  of "minecraft:dripstone_cluster", "minecraft:speleothem_cluster": ConfiguredFeatureKind.DripstoneCluster
  of "minecraft:large_dripstone": ConfiguredFeatureKind.LargeDripstone
  of "minecraft:sculk_patch": ConfiguredFeatureKind.SculkPatch
  of "minecraft:block_pile": ConfiguredFeatureKind.BlockPile
  of "minecraft:replace_single_block": ConfiguredFeatureKind.ReplaceSingleBlock
  of "minecraft:void_start_platform": ConfiguredFeatureKind.VoidStartPlatform
  of "minecraft:desert_well": ConfiguredFeatureKind.DesertWell
  else:
    die("unknown configured feature type " & t)
    ConfiguredFeatureKind.NoOp

proc toConfiguredFeature*(v: JsonNode): ConfiguredFeatureDef =
  ## `value_to_configured_feature`
  let t = strAt(v, "type")
  let c = at(v, "config")
  result = ConfiguredFeatureDef(kind: kindOf(t))
  case result.kind
  of ConfiguredFeatureKind.Bamboo, ConfiguredFeatureKind.Seagrass:
    result.probability = f32At(c, "probability")
  of ConfiguredFeatureKind.SeaPickle:
    result.count = toIntProvider(at(c, "count"))
  of ConfiguredFeatureKind.NetherForestVegetation:
    result.stateProvider = toBlockStateProvider(at(c, "state_provider"))
    result.spreadWidth = i32At(c, "spread_width", 8'i32)
    result.spreadHeight = i32At(c, "spread_height", 4'i32)
  of ConfiguredFeatureKind.NetherrackReplaceBlobs:
    result.targetState = toBlockState(at(c, "target"))
    result.state = toBlockState(at(c, "state"))
    result.radius = toIntProvider(at(c, "radius"))
  of ConfiguredFeatureKind.SimpleBlock:
    result.stateProvider = toBlockStateProvider(at(c, "to_place"))
  of ConfiguredFeatureKind.Ore, ConfiguredFeatureKind.ScatteredOre:
    result.size = i32At(c, "size")
    result.discardChanceOnAirExposure = f32At(c, "discard_chance_on_air_exposure")
    result.targets = newSeq[OreTarget](0)
    for e in arr(at(c, "targets")):
      result.targets.add(OreTarget(target: toRuleTest(at(e, "target")), state: toBlockState(at(e, "state"))))
  of ConfiguredFeatureKind.ReplaceSingleBlock:
    result.targets = newSeq[OreTarget](0)
    for e in arr(at(c, "targets")):
      result.targets.add(OreTarget(target: toRuleTest(at(e, "target")), state: toBlockState(at(e, "state"))))
  of ConfiguredFeatureKind.SpringFeature:
    result.state = toBlockState(at(c, "state"))
    result.requiresBlockBelow = boolAt(c, "requires_block_below", true)
    result.rockCount = i32At(c, "rock_count", 4'i32)
    result.holeCount = i32At(c, "hole_count", 1'i32)
    result.validBlocks = namesOf(at(c, "valid_blocks"))
  of ConfiguredFeatureKind.BlockColumn:
    result.layers = newSeq[BlockColumnLayer](0)
    for l in arr(at(c, "layers")):
      result.layers.add(BlockColumnLayer(height: toIntProvider(at(l, "height")), provider: toBlockStateProvider(at(l, "provider"))))
    result.direction = toDirection(strAt(c, "direction", "up"))
    result.allowedPlacement = toBlockPredicate(at(c, "allowed_placement"))
    result.prioritizeTip = boolAt(c, "prioritize_tip")
  of ConfiguredFeatureKind.FallenTree:
    result.stateProvider = toBlockStateProvider(at(c, "trunk_provider"))
    result.logLength = toIntProvider(at(c, "log_length"))
    result.stumpDecorators = toDecorators(at(c, "stump_decorators"))
    result.logDecorators = toDecorators(at(c, "log_decorators"))
  of ConfiguredFeatureKind.RandomPatch, ConfiguredFeatureKind.Flower, ConfiguredFeatureKind.NoBonemealFlower:
    result.tries = i32At(c, "tries", 128'i32)
    result.xzSpread = i32At(c, "xz_spread", 7'i32)
    result.ySpread = i32At(c, "y_spread", 3'i32)
    result.placed = toInlinePlaced(at(c, "feature"))
  of ConfiguredFeatureKind.RandomSelector:
    result.entries = newSeq[RandomFeatureEntry](0)
    for e in arr(at(c, "features")):
      result.entries.add(RandomFeatureEntry(feature: toWrapper(at(e, "feature")), chance: f32At(e, "chance", 0.1'f32)))
    result.defaultFeature = toWrapper(at(c, "default"))
  of ConfiguredFeatureKind.SimpleRandomSelector:
    result.features = newSeq[PlacedFeatureDef](0)
    for e in arr(at(c, "features")):
      result.features.add(toInlinePlaced(e))
  of ConfiguredFeatureKind.RandomBooleanSelector:
    result.featureTrue = toWrapper(at(c, "feature_true"))
    result.featureFalse = toWrapper(at(c, "feature_false"))
  of ConfiguredFeatureKind.EndSpike:
    result.crystalInvulnerable = boolAt(c, "crystal_invulnerable")
    result.spikes = newSeq[Spike](0)
    let sv = at(c, "spikes")
    if kind(sv) == JArray:
      for s in arr(sv):
        result.spikes.add(Spike(centerX: i32At(s, "centerX"), centerZ: i32At(s, "centerZ"), radius: i32At(s, "radius"),
          height: i32At(s, "height"), guarded: boolAt(s, "guarded")))
  of ConfiguredFeatureKind.Tree:
    result.tree = toTreeFeature(c)
  of ConfiguredFeatureKind.PointedDripstone:
    result.tallerDripstone = f32At(c, "chance_of_taller_speleothem", f32At(c, "chance_of_taller_dripstone", 0.2'f32))
    result.directionalSpread = f32At(c, "chance_of_directional_spread", 0.7'f32)
    result.spreadRadius2 = f32At(c, "chance_of_spread_radius2", 0.5'f32)
    result.spreadRadius3 = f32At(c, "chance_of_spread_radius3", 0.5'f32)
  of ConfiguredFeatureKind.Geode:
    let blocks = at(c, "blocks")
    result.fillingProvider = toBlockStateProvider(at(blocks, "filling_provider"))
    result.innerLayerProvider = toBlockStateProvider(at(blocks, "inner_layer_provider"))
    result.alternateInnerLayerProvider = toBlockStateProvider(at(blocks, "alternate_inner_layer_provider"))
    result.middleLayerProvider = toBlockStateProvider(at(blocks, "middle_layer_provider"))
    result.outerLayerProvider = toBlockStateProvider(at(blocks, "outer_layer_provider"))
    result.innerPlacements = newSeq[BlockStateCodec](0)
    for e in arr(at(blocks, "inner_placements")):
      result.innerPlacements.add(toBlockStateCodec(e))
    result.cannotReplace = toBlockIds(at(blocks, "cannot_replace"))
    result.invalidBlocks = toBlockIds(at(blocks, "invalid_blocks"))
    let layers = at(c, "layers")
    result.filling = f64At(layers, "filling", 1.7)
    result.innerLayer = f64At(layers, "inner_layer", 2.2)
    result.middleLayer = f64At(layers, "middle_layer", 3.2)
    result.outerLayer = f64At(layers, "outer_layer", 4.2)
    let crack = at(c, "crack")
    result.generateCrackChance = f64At(crack, "generate_crack_chance", 1.0)
    result.baseCrackSize = f64At(crack, "base_crack_size", 2.0)
    result.crackPointOffset = i32At(crack, "crack_point_offset", 2'i32)
    result.usePotentialPlacementsChance = f64At(c, "use_potential_placements_chance", 0.35)
    result.useAlternateLayer0Chance = f64At(c, "use_alternate_layer0_chance", 0.0)
    result.placementsRequireLayer0Alternate = boolAt(c, "placements_require_layer0_alternate", true)
    result.outerWallDistance = intProviderOr(c, "outer_wall_distance", uniform(4'i32, 5'i32))
    result.distributionPoints = intProviderOr(c, "distribution_points", uniform(3'i32, 4'i32))
    result.pointOffset = intProviderOr(c, "point_offset", uniform(1'i32, 2'i32))
    result.minGenOffset = i32At(c, "min_gen_offset", -16'i32)
    result.maxGenOffset = i32At(c, "max_gen_offset", 16'i32)
    result.noiseMultiplier = f64At(c, "noise_multiplier", 0.05)
    result.invalidBlocksThreshold = i32At(c, "invalid_blocks_threshold")
  of ConfiguredFeatureKind.UnderwaterMagma:
    result.floorSearchRange = i32At(c, "floor_search_range")
    result.placementRadius = i32At(c, "placement_radius_around_floor")
    result.placementProbability = f32At(c, "placement_probability_per_valid_position")
  of ConfiguredFeatureKind.VegetationPatch, ConfiguredFeatureKind.WaterloggedVegetationPatch:
    result.replaceable = toBlockPredicate(at(c, "replaceable"))
    result.groundState = toBlockStateProvider(at(c, "ground_state"))
    result.placed = toInlinePlaced(at(c, "vegetation_feature"))
    result.surfaceIsCeiling = strAt(c, "surface", "floor") == "ceiling"
    result.depth = toIntProvider(at(c, "depth"))
    result.extraBottomBlockChance = f32At(c, "extra_bottom_block_chance")
    result.verticalRange = i32At(c, "vertical_range")
    result.vegetationChance = f32At(c, "vegetation_chance")
    result.xzRadius = toIntProvider(at(c, "xz_radius"))
    result.extraEdgeColumnChance = f32At(c, "extra_edge_column_chance")
  of ConfiguredFeatureKind.Disk:
    result.stateProvider = toBlockStateProvider(at(c, "state_provider"))
    result.replaceable = toBlockPredicate(at(c, "target"))
    result.radius = toIntProvider(at(c, "radius"))
    result.verticalRange = i32At(c, "half_height", 1'i32)
  of ConfiguredFeatureKind.BasaltColumns:
    result.columnHeight = toIntProvider(at(c, "height"))
    result.reach = toIntProvider(at(c, "reach"))
  of ConfiguredFeatureKind.ForestRock:
    result.state = toBlockState(at(c, "state"))
    if has(c, "can_place_on"):
      result.replaceable = toBlockPredicate(at(c, "can_place_on"))
  of ConfiguredFeatureKind.Iceberg:
    result.state = toBlockState(at(c, "state"))
  of ConfiguredFeatureKind.Fossil:
    result.fossilStructures = namesOf(at(c, "fossil_structures"))
    result.overlayStructures = namesOf(at(c, "overlay_structures"))
    result.fossilProcessor = toFossilProcessor(at(c, "fossil_processors"))
    result.overlayProcessor = toFossilProcessor(at(c, "overlay_processors"))
    result.maxEmptyCornersAllowed = i32At(c, "max_empty_corners_allowed")
  of ConfiguredFeatureKind.Lake:
    result.stateProvider = toBlockStateProvider(at(c, "fluid"))
    result.barrier = toBlockStateProvider(at(c, "barrier"))
  of ConfiguredFeatureKind.RootSystem:
    result.placed = toInlinePlaced(at(c, "feature"))
    result.requiredVerticalSpaceForTree = i32At(c, "required_vertical_space_for_tree")
    result.rootRadius = i32At(c, "root_radius")
    result.rootReplaceable = toBlockPredicate(at(c, "root_replaceable"))
    result.rootStateProvider = toBlockStateProvider(at(c, "root_state_provider"))
    result.rootPlacementAttempts = i32At(c, "root_placement_attempts")
    result.rootColumnMaxHeight = i32At(c, "root_column_max_height")
    result.hangingRootRadius = i32At(c, "hanging_root_radius")
    result.hangingRootsVerticalSpan = i32At(c, "hanging_roots_vertical_span", i32At(c, "hanging_root_vertical_span"))
    result.hangingRootStateProvider = toBlockStateProvider(at(c, "hanging_root_state_provider"))
    result.hangingRootPlacementAttempts = i32At(c, "hanging_root_placement_attempts")
    result.allowedVerticalWaterForTree = i32At(c, "allowed_vertical_water_for_tree")
    result.allowedTreePosition = toBlockPredicate(at(c, "allowed_tree_position"))
  of ConfiguredFeatureKind.MultifaceGrowth:
    result.placeBlock = blockIdOfName(strAt(c, "block", "minecraft:glow_lichen"))
    result.searchRange = i32At(c, "search_range", 10'i32)
    result.canPlaceOnFloor = boolAt(c, "can_place_on_floor")
    result.canPlaceOnCeiling = boolAt(c, "can_place_on_ceiling")
    result.canPlaceOnWall = boolAt(c, "can_place_on_wall")
    result.chanceOfSpreading = f32At(c, "chance_of_spreading", 0.5'f32)
    result.canBePlacedOn = newSeq[int](0)
    for b in arr(at(c, "can_be_placed_on")):
      result.canBePlacedOn.add(blockIdOfName(getStr(b)))
  of ConfiguredFeatureKind.HugeFungus:
    result.validBaseBlock = toBlockState(at(c, "valid_base_block"))
    result.stemState = toBlockState(at(c, "stem_state"))
    result.hatState = toBlockState(at(c, "hat_state"))
    result.decorState = toBlockState(at(c, "decor_state"))
    result.replaceableBlocks = toBlockPredicate(at(c, "replaceable_blocks"))
    result.planted = boolAt(c, "planted")
  of ConfiguredFeatureKind.DeltaFeature:
    result.contents = toBlockState(at(c, "contents"))
    result.rim = toBlockState(at(c, "rim"))
    result.deltaSize = toIntProvider(at(c, "size"))
    result.rimSize = toIntProvider(at(c, "rim_size"))
  of ConfiguredFeatureKind.FillLayer:
    result.fillHeight = i32At(c, "height")
    result.state = toBlockState(at(c, "state"))
  of ConfiguredFeatureKind.TwistingVines:
    result.spreadWidth = i32At(c, "spread_width")
    result.spreadHeight = i32At(c, "spread_height")
    result.maxHeight = i32At(c, "max_height")
  of ConfiguredFeatureKind.SculkPatch:
    result.chargeCount = i32At(c, "charge_count")
    result.amountPerCharge = i32At(c, "amount_per_charge")
    result.spreadAttempts = i32At(c, "spread_attempts")
    result.growthRounds = i32At(c, "growth_rounds")
    result.spreadRounds = i32At(c, "spread_rounds")
    result.extraRareGrowths = toIntProvider(at(c, "extra_rare_growths"))
    result.catalystChance = f32At(c, "catalyst_chance")
  of ConfiguredFeatureKind.BlockPile:
    result.stateProvider = toBlockStateProvider(at(c, "state_provider"))
  of ConfiguredFeatureKind.EndGateway:
    result.exact = boolAt(c, "exact")
    let ex = at(c, "exit")
    if kind(ex) == JArray:
      result.hasExit = true
      result.exit = pos(int32(num(arr(ex)[0])), int32(num(arr(ex)[1])), int32(num(arr(ex)[2])))
  of ConfiguredFeatureKind.HugeBrownMushroom, ConfiguredFeatureKind.HugeRedMushroom:
    result.stateProvider = toBlockStateProvider(at(c, "cap_provider"))
    result.barrier = toBlockStateProvider(at(c, "stem_provider"))
    result.placementRadius = i32At(c, "foliage_radius", if result.kind == ConfiguredFeatureKind.HugeRedMushroom: 2'i32 else: 3'i32)
    if has(c, "can_place_on"):
      result.replaceable = toBlockPredicate(at(c, "can_place_on"))
  else:
    discard

var
  configuredOverride = initTable[string, string]()
  placedOverride = initTable[string, string]()

proc toFeatureRef(v: JsonNode, p: PlacedFeatureDef) =
  ## `value_to_feature_ref`
  if kind(v) == JString and configuredOverride.hasKey(bareName(getStr(v))):
    # Another version's data: its name may not be one of this one's.
    var tree = parseJson(configuredOverride.getOrDefault(bareName(getStr(v)), ""))
    p.featureKind = FeatureRefKind.Inlined
    p.inlined = toConfiguredFeature(root(tree))
  elif kind(v) == JString:
    let (found, f) = configuredenum.ConfiguredFeature.fromName(getStr(v))
    if not found:
      die("unknown configured feature " & getStr(v))
    p.featureKind = FeatureRefKind.Named
    p.feature = f
  else:
    p.featureKind = FeatureRefKind.Inlined
    p.inlined = toConfiguredFeature(v)

proc toInlinePlaced(v: JsonNode): PlacedFeatureDef =
  ## `value_to_inline_placed_feature`
  result = PlacedFeatureDef(placement: newSeq[PlacementModifier](0))
  toFeatureRef(at(v, "feature"), result)
  let pv = at(v, "placement")
  if kind(pv) == JArray:
    for m in arr(pv):
      result.placement.add(toPlacementModifier(m))

proc toWrapper(v: JsonNode): PlacedFeatureWrapper =
  ## `value_to_placed_feature_wrapper`
  if kind(v) == JString:
    let (found, f) = placedenum.PlacedFeature.fromName(getStr(v))
    if not found:
      die("unknown placed feature " & getStr(v))
    PlacedFeatureWrapper(named: f)
  else:
    PlacedFeatureWrapper(direct: toInlinePlaced(v))

# --- the two maps ----------------------------------------------------------------------------------------------------

var
  configuredDefs: seq[ConfiguredFeatureDef]
  placedDefs: seq[PlacedFeatureDef]

proc setFeatureDataOverride*(configured, placed: Table[string, string]) =
  ## Entries by bare name that replace the generated tables' JSON. Only for comparing against another version's data.
  configuredOverride = configured
  placedOverride = placed
  configuredDefs = @[]
  placedDefs = @[]

proc configuredFeatureDef*(f: configuredenum.ConfiguredFeature): ConfiguredFeatureDef =
  ## `CONFIGURED_FEATURES.get(..)`, decoded entry by entry as it is first asked for.
  if configuredDefs.len == 0:
    configuredDefs = newSeq[ConfiguredFeatureDef](ConfiguredFeatureEntries.len)
  let i = ord(f)
  if configuredDefs[i] == nil:
    let text = configuredOverride.getOrDefault(toName(f), configuredFeatureEntry(f).json)
    var tree = parseJson(text)
    configuredDefs[i] = toConfiguredFeature(root(tree))
  configuredDefs[i]

proc placedFeatureDef*(f: placedenum.PlacedFeature): PlacedFeatureDef =
  ## `PLACED_FEATURES.get(..)`, likewise.
  if placedDefs.len == 0:
    placedDefs = newSeq[PlacedFeatureDef](PlacedFeatureEntries.len)
  let i = ord(f)
  if placedDefs[i] == nil:
    let text = placedOverride.getOrDefault(toName(f), placedFeatureEntry(f).json)
    var tree = parseJson(text)
    placedDefs[i] = toInlinePlaced(root(tree))
  placedDefs[i]
