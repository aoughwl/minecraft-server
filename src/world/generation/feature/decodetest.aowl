## Decodes every entry of the generated configured and placed feature tables, then checks known values against the assets.

{.feature: "lenientnils".}

import std/syncio
import ../../../generated/placed_feature as placedenum
import ../../../generated/configured_feature as configuredenum
import decode
import types
import common

var failures = 0

proc expect(ok: bool, what: string) =
  if not ok:
    echo "FAIL ", what
    inc failures

for f in low(configuredenum.ConfiguredFeature) .. high(configuredenum.ConfiguredFeature):
  when defined(traceDecode):
    echo toName(f)
  discard configuredFeatureDef(f)
for f in low(placedenum.PlacedFeature) .. high(placedenum.PlacedFeature):
  when defined(traceDecode):
    echo toName(f)
  discard placedFeatureDef(f)

block ore:
  let (found, name) = configuredenum.ConfiguredFeature.fromName("ore_iron")
  expect(found, "ore_iron is named")
  let d = configuredFeatureDef(name)
  expect(d.kind == ConfiguredFeatureKind.Ore, "ore_iron kind")
  expect(d.size == 9'i32, "ore_iron size")
  expect(d.targets.len == 2, "ore_iron targets")
  expect(d.targets[0].state == stateOfName("iron_ore"), "ore_iron first state")
  expect(d.targets[1].state == stateOfName("deepslate_iron_ore"), "ore_iron second state")
  expect(d.targets[0].target.kind == RuleTestKind.TagMatch, "ore_iron rule")

block geodeDefaults:
  # 26.2 leaves these out as its codec's defaults; 1.21.11's file spells them out.
  let (found, name) = configuredenum.ConfiguredFeature.fromName("amethyst_geode")
  expect(found, "amethyst_geode is named")
  let d = configuredFeatureDef(name)
  expect(d.filling == 1.7'f64 and d.outerLayer == 4.2'f64, "geode layers")
  expect(d.noiseMultiplier == 0.05'f64, "geode noise multiplier")
  expect(getMax(d.distributionPoints) == 4'i32 and getMin(d.distributionPoints) == 3'i32, "geode distribution points")
  expect(getMax(d.pointOffset) == 2'i32 and getMin(d.pointOffset) == 1'i32, "geode point offset")

block placed:
  let (found, name) = placedenum.PlacedFeature.fromName("ore_iron_upper")
  expect(found, "ore_iron_upper is named")
  let d = placedFeatureDef(name)
  expect(d.featureKind == FeatureRefKind.Named and toName(d.feature) == "ore_iron", "ore_iron_upper feature")
  expect(d.placement.len == 4, "ore_iron_upper modifiers")
  expect(d.placement[0].kind == PlacementModifierKind.Count, "count first")
  expect(getMax(d.placement[0].count) == 90'i32, "count 90")
  expect(d.placement[1].kind == PlacementModifierKind.InSquare, "square second")
  expect(d.placement[2].kind == PlacementModifierKind.HeightRange, "range third")
  expect(d.placement[3].kind == PlacementModifierKind.Biome, "biome last")

if failures > 0:
  echo failures, " checks failed"
  quit(1)
echo "decodetest ok"
