## Which placed features run in a chunk at a decoration step, in which order and under which seed index: vanilla's
## `FeatureSorter`. No file in the pinned tree: it sorts a chunk's features by enum and seeds each by its position in that
## short list, which matches vanilla in no chunk. Port of crates/pumpkin-world/src/generation/feature_order.rs in the newer
## checkout (../ref/pumpkin).
##
## The per-step index is global to a generator's biomes: `get_decorator_seed(population_seed, index, step)` takes it. The
## biome order breaks ties between independent features, and is the order `OverworldBiomeBuilder` first reaches each biome.
## `sulfur_caves` is in the newer checkout's list; the pinned tree's biome tree does not generate it, and 1.21.11 has no such
## biome, so its features take no index here.

{.feature: "lenientnils".}

import std/tables
import ../../../generated/biome
import ../../../generated/placed_feature

const
  OverworldBiomeNames = ["mushroom_fields", "deep_frozen_ocean", "frozen_ocean", "deep_cold_ocean", "cold_ocean", "deep_ocean",
    "ocean", "deep_lukewarm_ocean", "lukewarm_ocean", "warm_ocean", "stony_shore", "swamp", "mangrove_swamp", "snowy_slopes",
    "snowy_plains", "snowy_beach", "windswept_gravelly_hills", "grove", "windswept_hills", "snowy_taiga", "windswept_forest",
    "taiga", "plains", "meadow", "beach", "forest", "old_growth_spruce_taiga", "flower_forest", "birch_forest", "dark_forest",
    "pale_garden", "savanna_plateau", "savanna", "jungle", "badlands", "desert", "wooded_badlands", "jagged_peaks", "stony_peaks",
    "frozen_river", "river", "ice_spikes", "old_growth_pine_taiga", "sunflower_plains", "old_growth_birch_forest",
    "sparse_jungle", "bamboo_jungle", "eroded_badlands", "windswept_savanna", "cherry_grove", "frozen_peaks", "dripstone_caves",
    "lush_caves", "deep_dark"]
  NetherBiomeNames = ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"]
  EndBiomeNames = ["the_end", "end_highlands", "end_midlands", "small_end_islands", "end_barrens"]

type
  FeatureData = object
    step, encounterIndex: int
    feature: PlacedFeature

  DimensionOrder = ref object
    biomeIds: seq[bool]               ## Indexed by biome id.
    perStep: seq[seq[PlacedFeature]]

proc biomeByName(name: string): nil Biome =
  Biome.fromName(name)

proc sortFeaturesPerStep(names: openArray[string]): seq[seq[PlacedFeature]] =
  ## `sort_features_per_step`
  var featureIndices = initTable[int, int]()
  var edgeSets = initTable[int64, seq[int64]]()
  var dataOf = initTable[int64, FeatureData]()
  var maxSteps = 0
  template keyOf(d: FeatureData): int64 =
    int64(d.step) * 100000'i64 + int64(d.encounterIndex)
  for ni in 0 ..< names.len:
    let b = biomeByName(names[ni])
    if b == nil:
      continue
    maxSteps = max(maxSteps, b.features.len)
    var biomeFeatures = newSeq[FeatureData](0)
    for step in 0 ..< b.features.len:
      for fi in 0 ..< b.features[step].len:
        let feature = b.features[step][fi]
        let nextIndex = featureIndices.len
        let f = ord(feature)
        if not featureIndices.hasKey(f):
          featureIndices[f] = nextIndex
        let data = FeatureData(step: step, encounterIndex: featureIndices.getOrDefault(f, 0), feature: feature)
        let k = keyOf(data)
        dataOf[k] = data
        if not edgeSets.hasKey(k):
          edgeSets[k] = newSeq[int64](0)
        biomeFeatures.add(data)
    for i in 0 ..< biomeFeatures.len - 1:
      let a = keyOf(biomeFeatures[i])
      let b2 = keyOf(biomeFeatures[i + 1])
      var known = false
      let list = edgeSets.getOrDefault(a, newSeq[int64](0))
      for x in list:
        if x == b2:
          known = true
          break
      if not known:
        var nl = list
        nl.add(b2)
        edgeSets[a] = nl
  # `BTreeMap` iteration: keys ascending; each key's `BTreeSet` ascending.
  var keys = newSeq[int64](0)
  for k, v in pairs(edgeSets):
    keys.add(k)
  for i in 1 ..< keys.len:
    let v = keys[i]
    var j = i - 1
    while j >= 0 and keys[j] > v:
      let m = keys[j]
      keys[j + 1] = m
      dec j
    keys[j + 1] = v
  var discovered = initTable[int64, bool]()
  var sorted = newSeq[int64](0)
  # Depth first, iteratively: a frame is a key and how far through its sorted edges it has got.
  for ki in 0 ..< keys.len:
    if discovered.hasKey(keys[ki]):
      continue
    var stack = newSeq[(int64, int)](0)
    stack.add((keys[ki], 0))
    while stack.len > 0:
      let top = stack[stack.len - 1]
      var es = edgeSets.getOrDefault(top[0], newSeq[int64](0))
      for i in 1 ..< es.len:
        let v = es[i]
        var j = i - 1
        while j >= 0 and es[j] > v:
          let m = es[j]
          es[j + 1] = m
          dec j
        es[j + 1] = v
      if top[1] < es.len:
        stack[stack.len - 1] = (top[0], top[1] + 1)
        if not discovered.hasKey(es[top[1]]):
          stack.add((es[top[1]], 0))
      else:
        discard stack.pop()
        if not discovered.hasKey(top[0]):
          discovered[top[0]] = true
          sorted.add(top[0])
  result = newSeq[seq[PlacedFeature]](maxSteps)
  for i in 0 ..< maxSteps:
    result[i] = newSeq[PlacedFeature](0)
  var i = sorted.len - 1
  while i >= 0:
    let d = dataOf.getOrDefault(sorted[i], FeatureData())
    result[d.step].add(d.feature)
    dec i

proc newOrder(names: openArray[string]): DimensionOrder =
  result = DimensionOrder(biomeIds: newSeq[bool](256), perStep: sortFeaturesPerStep(names))
  for ni in 0 ..< names.len:
    let b = biomeByName(names[ni])
    if b != nil:
      result.biomeIds[int(b.id)] = true

var
  overworldOrder: DimensionOrder
  netherOrder: DimensionOrder
  endOrder: DimensionOrder

proc overworld(): DimensionOrder =
  if overworldOrder == nil:
    overworldOrder = newOrder(OverworldBiomeNames)
  overworldOrder

proc nether(): DimensionOrder =
  if netherOrder == nil:
    netherOrder = newOrder(NetherBiomeNames)
  netherOrder

proc theEnd(): DimensionOrder =
  if endOrder == nil:
    endOrder = newOrder(EndBiomeNames)
  endOrder

proc selectFeatures*(biomeIds: seq[uint8], step: int): seq[(int, PlacedFeature)] =
  ## `select_features`: every feature of the biomes at this step, with its global index, in index order.
  var order = overworld()
  var chosen = false
  for i in 0 ..< biomeIds.len:
    if nether().biomeIds[int(biomeIds[i])]:
      order = nether()
      chosen = true
      break
  if not chosen:
    for i in 0 ..< biomeIds.len:
      if theEnd().biomeIds[int(biomeIds[i])]:
        order = theEnd()
        break
  result = newSeq[(int, PlacedFeature)](0)
  if step >= order.perStep.len:
    return result
  var selected = newSeq[bool](PlacedFeature.high.ord + 1)
  for i in 0 ..< biomeIds.len:
    if not order.biomeIds[int(biomeIds[i])]:
      continue
    let b = ALL[int(biomeIds[i])]
    if step < b.features.len:
      for fi in 0 ..< b.features[step].len:
        selected[ord(b.features[step][fi])] = true
  for idx in 0 ..< order.perStep[step].len:
    if selected[ord(order.perStep[step][idx])]:
      result.add((idx, order.perStep[step][idx]))

proc featuresPerStep*(dimensionIndex: int): seq[seq[PlacedFeature]] =
  ## For tests: 0 overworld, 1 nether, 2 end.
  case dimensionIndex
  of 0: overworld().perStep
  of 1: nether().perStep
  else: theEnd().perStep
