## Port of the tests in crates/pumpkin-world/src/generation/feature_order.rs of the newer checkout. Its overworld has
## dappled_forest and sulfur_caves, whose features add 3 to every index in step 9 here. These numbers are upstream's less
## that 3, the indices 1.21.11 has: the same indices reproduce the trees of a real 1.21.11 save.

{.feature: "lenientnils".}

import std/syncio
import ../../../generated/biome
import ../../../generated/placed_feature
import feature_order

var failures = 0

proc expect(ok: bool, what: string) =
  if not ok:
    echo "FAIL ", what
    inc failures

proc positionOf(step: seq[PlacedFeature], f: PlacedFeature): int =
  for i in 0 ..< step.len:
    if step[i] == f:
      return i
  -1

proc idOf(name: string): uint8 =
  let b = Biome.fromName(name)
  if b == nil:
    quit("no biome " & name)
  else:
    b.id

proc indexIn(selected: seq[(int, PlacedFeature)], f: PlacedFeature): int =
  for i in 0 ..< selected.len:
    if selected[i][1] == f:
      return selected[i][0]
  -1

# dry_grass_uses_vanilla_global_feature_index
block:
  let step = featuresPerStep(0)[9]
  expect(positionOf(step, PlacedFeature.PatchDryGrassDesert) == 69, "patch_dry_grass_desert index")
  expect(positionOf(step, PlacedFeature.PatchDryGrassBadlands) == 71, "patch_dry_grass_badlands index")
  expect(positionOf(step, PlacedFeature.TreesJungle) == 7, "trees_jungle index")

# biome_selection_keeps_global_indices_and_order
block:
  let selected = selectFeatures(@[idOf("savanna"), idOf("desert")], 9)
  for i in 1 ..< selected.len:
    expect(selected[i - 1][0] < selected[i][0], "ascending indices")
  expect(indexIn(selected, PlacedFeature.PatchDryGrassDesert) == 69, "desert grass selected at 69")
  expect(indexIn(selected, PlacedFeature.PatchDryGrassBadlands) == -1, "badlands grass not selected")
  expect(indexIn(selected, PlacedFeature.PatchGrassSavanna) == 12, "savanna grass at 12")

# selection_deduplicates_biomes_from_neighbor_chunks
block:
  let once = selectFeatures(@[idOf("desert")], 9)
  let repeated = selectFeatures(@[idOf("desert"), idOf("desert"), idOf("desert")], 9)
  expect(once.len == repeated.len, "same length")
  for i in 0 ..< min(once.len, repeated.len):
    expect(once[i][0] == repeated[i][0] and once[i][1] == repeated[i][1], "same entries")

# non_overworld_selection_preserves_local_indexing
block:
  let selected = selectFeatures(@[idOf("nether_wastes")], 9)
  expect(selected.len > 0, "nether has features")
  for i in 0 ..< selected.len:
    expect(selected[i][0] == i, "nether index is its position")

if failures > 0:
  echo failures, " checks failed"
  quit(1)
echo "feature_ordertest ok"
