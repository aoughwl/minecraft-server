## The features that place other features. Port of pumpkin-world/src/generation/feature/features/random_patch.rs,
## pumpkin-world/src/generation/feature/features/random_selector.rs, pumpkin-world/src/generation/feature/features/simple_random_selector.rs,
## pumpkin-world/src/generation/feature/features/random_boolean_selector.rs, pumpkin-world/src/generation/feature/features/vegetation_patch.rs,
## pumpkin-world/src/generation/feature/features/waterlogged_vegetation_patch.rs and pumpkin-world/src/generation/feature/features/root_system.rs
##
## Each calls back up through `placedGenerateHook`. Logic as the newer checkout (../ref/pumpkin) has it: its patch surface
## iterates as `java.util.HashSet` does, and the vegetation's random draws follow that order.

{.feature: "lenientnils".}

import ../types
import ../common

proc nestedGenerate(p: PlacedFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool {.inline.} =
  placedGenerateHook(p, c, random, at)

proc wrapperGenerate(w: PlacedFeatureWrapper, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## A named feature's own name goes down, as the newer checkout's `sub_name`: a biome filter inside tests that one.
  if w.direct != nil:
    return placedGenerateHook(w.direct, c, random, at)
  let saved = c.feature
  c.feature = w.named
  result = placedGenerateHook(placedGetHook(w), c, random, at)
  c.feature = saved

proc generateRandomPatch*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `RandomPatchFeature::generate`
  let xz = f.xzSpread + 1
  let y = f.ySpread + 1
  result = false
  for i in 0'i32 ..< f.tries:
    let dx = nextBoundedI32(random, xz) - nextBoundedI32(random, xz)
    let dy = nextBoundedI32(random, y) - nextBoundedI32(random, y)
    let dz = nextBoundedI32(random, xz) - nextBoundedI32(random, xz)
    if nestedGenerate(f.placed, c, random, pos(at.x + dx, at.y + dy, at.z + dz)):
      result = true

proc generateRandomSelector*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `RandomFeature::generate`
  for i in 0 ..< f.entries.len:
    if nextF32(random) >= f.entries[i].chance:
      continue
    return wrapperGenerate(f.entries[i].feature, c, random, at)
  wrapperGenerate(f.defaultFeature, c, random, at)

proc generateSimpleRandomSelector*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `SimpleRandomFeature::generate`
  let i = nextBoundedI32(random, int32(f.features.len))
  nestedGenerate(f.features[int(i)], c, random, at)

proc generateRandomBooleanSelector*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `RandomBooleanFeature::generate`
  if nextBool(random):
    wrapperGenerate(f.featureTrue, c, random, at)
  else:
    wrapperGenerate(f.featureFalse, c, random, at)

# --- VegetationPatchFeature -------------------------------------------------------------------------------------------

proc surfaceDirection(f: ConfiguredFeatureDef): BlockDirection {.inline.} =
  if f.surfaceIsCeiling: BlockDirection.Up else: BlockDirection.Down

proc placeGround(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, start: BlockPos, depth: int32): bool =
  var below = start
  for i in 0'i32 ..< depth:
    let toPlace = get(f.groundState, random, below, c.chunk, c.blockRegistry)
    if blockIdOf(toPlace) != getBlockId(c, below):
      if not test(f.replaceable, c.blockRegistry, c.chunk, below):
        return i != 0
      setState(c, below, toPlace)
      below = offset(below, surfaceDirection(f))
  true

proc placeGroundPatch(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, origin: BlockPos, xRadius, zRadius: int32): JavaBlockPosHashSet =
  result = newJavaBlockPosHashSet()
  let inwards = surfaceDirection(f)
  let outwards = opposite(inwards)
  var dx = -xRadius
  while dx <= xRadius:
    let xEdge = dx == -xRadius or dx == xRadius
    var dz = -zRadius
    while dz <= zRadius:
      let zEdge = dz == -zRadius or dz == zRadius
      let corner = xEdge and zEdge
      let edge = xEdge or zEdge
      block column:
        if corner:
          break column
        if edge and (f.extraEdgeColumnChance == 0.0'f32 or nextF32(random) > f.extraEdgeColumnChance):
          break column
        var at = origin.add(dx, 0, dz)
        for i in 0'i32 ..< f.verticalRange:
          if not airAt(c, at):
            break
          at = offset(at, inwards)
        for i in 0'i32 ..< f.verticalRange:
          if airAt(c, at):
            break
          at = offset(at, outwards)
        let below = offset(at, inwards)
        if airAt(c, at) and sideSolid(getState(c, below), outwards):
          var depth = get(f.depth, random)
          if f.extraBottomBlockChance > 0.0'f32 and nextF32(random) < f.extraBottomBlockChance:
            inc depth
          if placeGround(f, c, random, below, depth):
            result.incl(below)
      inc dz
    inc dx

proc generateVegetationPatch*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `VegetationPatchFeature::generate`
  let xRadius = get(f.xzRadius, random) + 1
  let zRadius = get(f.xzRadius, random) + 1
  let surface = placeGroundPatch(f, c, random, at, xRadius, zRadius)
  let opp = opposite(surfaceDirection(f))
  let positions = toSeq(surface)
  for i in 0 ..< positions.len:
    if f.vegetationChance > 0.0'f32 and nextF32(random) < f.vegetationChance:
      discard nestedGenerate(f.placed, c, random, offset(positions[i], opp))
  positions.len > 0

proc isExposed(c: FeatureContext, p: BlockPos): bool =
  for d in [BlockDirection.North, BlockDirection.East, BlockDirection.South, BlockDirection.West, BlockDirection.Down]:
    if not sideSolid(getState(c, offset(p, d)), opposite(d)):
      return true
  false

proc generateWaterloggedVegetationPatch*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `WaterloggedVegetationPatchFeature::generate`
  let xRadius = get(f.xzRadius, random) + 1
  let zRadius = get(f.xzRadius, random) + 1
  let surface = toSeq(placeGroundPatch(f, c, random, at, xRadius, zRadius))
  var water = newJavaBlockPosHashSet()
  for i in 0 ..< surface.len:
    if not isExposed(c, surface[i]):
      water.incl(surface[i])
  let waterSurface = toSeq(water)
  for i in 0 ..< waterSurface.len:
    setState(c, waterSurface[i], SWater)
  for i in 0 ..< waterSurface.len:
    if f.vegetationChance > 0.0'f32 and nextF32(random) < f.vegetationChance:
      if nestedGenerate(f.placed, c, random, waterSurface[i]):
        let placed = getState(c, waterSurface[i])
        if hasProp(placed, "waterlogged") and not isWaterlogged(placed):
          setState(c, waterSurface[i], withProp(placed, "waterlogged", "true"))
  waterSurface.len > 0

# --- RootSystemFeature ------------------------------------------------------------------------------------------------

proc spaceForTree(f: ConfiguredFeatureDef, c: FeatureContext, at: BlockPos): bool =
  var col = at
  var i = 1'i32
  while i <= f.requiredVerticalSpaceForTree:
    col = col.up()
    let id = getBlockId(c, col)
    if not (id == BAir or (i + 1 <= f.allowedVerticalWaterForTree and id == BWater)):
      return false
    inc i
  true

proc placeRootedDirt(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, originX, originZ: int32, start: BlockPos) =
  let r = max(f.rootRadius, 1'i32)
  var working = start
  for i in 0'i32 ..< f.rootPlacementAttempts:
    working = working.add(nextBoundedI32(random, r) - nextBoundedI32(random, r), 0, nextBoundedI32(random, r) - nextBoundedI32(random, r))
    if test(f.rootReplaceable, c.blockRegistry, c.chunk, working):
      setState(c, working, get(f.rootStateProvider, random, working, c.chunk, c.blockRegistry))
    working = pos(originX, working.y, originZ)

proc placeDirtAndTree(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  var working = at
  for y in 0'i32 ..< f.rootColumnMaxHeight:
    working = working.up()
    if topBlock(c, working.x, working.z) < working.y:
      return false
    if test(f.allowedTreePosition, c.blockRegistry, c.chunk, working) and spaceForTree(f, c, working):
      let below = getState(c, working.down())
      if blockIdOf(below) == BLava or not sideSolid(below, BlockDirection.Up):
        return false
      if nestedGenerate(f.placed, c, random, working):
        var yy = at.y
        while yy < at.y + y:
          placeRootedDirt(f, c, random, at.x, at.z, pos(at.x, yy, at.z))
          inc yy
        return true
  false

proc generateRootSystem*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `RootSystemFeature::generate`
  if not airAt(c, at):
    return false
  if placeDirtAndTree(f, c, random, at):
    let r = max(f.hangingRootRadius, 1'i32)
    let span = max(f.hangingRootsVerticalSpan, 1'i32)
    for i in 0'i32 ..< f.hangingRootPlacementAttempts:
      let w = at.add(nextBoundedI32(random, r) - nextBoundedI32(random, r), nextBoundedI32(random, span) - nextBoundedI32(random, span),
        nextBoundedI32(random, r) - nextBoundedI32(random, r))
      if airAt(c, w) and sideSolid(getState(c, w.up()), BlockDirection.Down):
        setState(c, w, get(f.hangingRootStateProvider, random, w, c.chunk, c.blockRegistry))
  true
