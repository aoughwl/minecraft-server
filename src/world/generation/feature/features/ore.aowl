## Port of pumpkin-world/src/generation/feature/features/ore.rs, pumpkin-world/src/generation/feature/features/scattered_ore.rs,
## pumpkin-world/src/generation/feature/features/replace_single_block.rs and
## pumpkin-world/src/generation/feature/features/netherrack_replace_blobs.rs
##
## Logic as the newer checkout (../ref/pumpkin) has it, checked against vanilla 1.21.11's OreFeature bytecode: the
## pinned tree tests one column of the ocean floor where vanilla scans the whole box, and takes sin, cos and the sphere
## size in f32 where vanilla takes them in f64 and through `Mth.sin`.

{.feature: "lenientnils".}

import std/math
import ../types
import ../common

proc shouldNotDiscard(random: var RandomGenerator, chance: float32): bool =
  if chance <= 0.0'f32: return true
  if chance >= 1.0'f32: return false
  nextF32(random) >= chance

proc isExposedToAir(c: FeatureContext, p: BlockPos): bool =
  for d in AllDirections:
    if airAt(c, offset(p, d)):
      return true
  false

proc shouldPlace*(discardChance: float32, c: FeatureContext, state: BlockStateId, random: var RandomGenerator,
                  target: OreTarget, p: BlockPos): bool =
  ## `OreFeature::should_place`
  if not test(target.target, state, random):
    return false
  if shouldNotDiscard(random, discardChance):
    return true
  not isExposedToAir(c, p)

proc mthCeil(v: float32): int32 {.inline.} =
  ## `Mth.ceil`
  let i = int32(v)
  if v > float32(i): i + 1 else: i

proc mthFloor(v: float64): int32 {.inline.} =
  let i = int32(v)
  if v < float64(i): i - 1 else: i

proc lerpD(t, a, b: float64): float64 {.inline.} = a + t * (b - a)

proc generateVeinPart(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator,
                      startX, endX, startZ, endZ, startY, endY: float64,
                      xBound, yBound, zBound, horizontalSize, verticalSize: int32): bool =
  var placedBlocksCount = 0
  var bitSet = newSeq[bool](int(horizontalSize) * int(verticalSize) * int(horizontalSize))
  let j = f.size
  var ds = newSeq[float64](int(j) * 4)
  for k in 0 ..< int(j):
    let ff = float32(k) / float32(j)
    let d = lerpD(float64(ff), startX, endX)
    let e = lerpD(float64(ff), startY, endY)
    let g = lerpD(float64(ff), startZ, endZ)
    let h = nextF64(random) * float64(j) / 16.0
    let l = (float64(mthSin(3.1415927'f32 * ff) + 1.0'f32) * h + 1.0) / 2.0
    ds[k * 4] = d
    ds[k * 4 + 1] = e
    ds[k * 4 + 2] = g
    ds[k * 4 + 3] = l

  for k in 0 ..< int(j) - 1:
    if ds[k * 4 + 3] <= 0.0:
      continue
    for m in k + 1 ..< int(j):
      if ds[m * 4 + 3] <= 0.0:
        continue
      let dx = ds[k * 4] - ds[m * 4]
      let dy = ds[k * 4 + 1] - ds[m * 4 + 1]
      let dz = ds[k * 4 + 2] - ds[m * 4 + 2]
      let dr = ds[k * 4 + 3] - ds[m * 4 + 3]
      if dr * dr > dx * dx + dy * dy + dz * dz:
        if dr > 0.0:
          ds[m * 4 + 3] = -1.0
        else:
          ds[k * 4 + 3] = -1.0

  for m in 0 ..< int(j):
    let d = ds[m * 4 + 3]
    if d < 0.0:
      continue
    let e = ds[m * 4]
    let g = ds[m * 4 + 1]
    let h = ds[m * 4 + 2]
    let nBound = max(mthFloor(e - d), xBound)
    let oBound = max(mthFloor(g - d), yBound)
    let pBound = max(mthFloor(h - d), zBound)
    let qBound = max(mthFloor(e + d), nBound)
    let rBound = max(mthFloor(g + d), oBound)
    let sBound = max(mthFloor(h + d), pBound)
    var t = nBound
    while t <= qBound:
      let u = (float64(t) + 0.5 - e) / d
      if u * u < 1.0:
        var v = oBound
        while v <= rBound:
          let w = (float64(v) + 0.5 - g) / d
          if u * u + w * w < 1.0:
            var aa = pBound
            while aa <= sBound:
              let ab = (float64(aa) + 0.5 - h) / d
              if u * u + w * w + ab * ab < 1.0 and not outOfHeight(c, v):
                let ac = int((t - xBound) + (v - yBound) * horizontalSize + (aa - zBound) * horizontalSize * verticalSize)
                if not bitSet[ac]:
                  bitSet[ac] = true
                  let p = pos(t, v, aa)
                  let blockState = getState(c, p)
                  for ti in 0 ..< f.targets.len:
                    if shouldPlace(f.discardChanceOnAirExposure, c, blockState, random, f.targets[ti], p):
                      setState(c, p, f.targets[ti].state)
                      inc placedBlocksCount
                      break
              inc aa
          inc v
      inc t
  placedBlocksCount > 0

proc generateOre*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, p: BlockPos): bool =
  ## `OreFeature::generate`
  let ff = nextF32(random) * 3.1415927'f32
  let g = float32(f.size) / 8.0'f32
  let i = mthCeil((float32(f.size) / 16.0'f32 * 2.0'f32 + 1.0'f32) / 2.0'f32)
  let d = float64(p.x) + sin(float64(ff)) * float64(g)
  let e = float64(p.x) - sin(float64(ff)) * float64(g)
  let h = float64(p.z) + cos(float64(ff)) * float64(g)
  let j = float64(p.z) - cos(float64(ff)) * float64(g)
  let l = float64(p.y + nextBoundedI32(random, 3) - 2)
  let m = float64(p.y + nextBoundedI32(random, 3) - 2)
  let n = p.x - mthCeil(g) - i
  let o = p.y - 2 - i
  let pp = p.z - mthCeil(g) - i
  let q = 2 * (mthCeil(g) + i)
  let r = 2 * (2 + i)
  var xprobe = n
  while xprobe <= n + q:
    var zprobe = pp
    while zprobe <= pp + q:
      if o <= topY(c, OceanFloorWg, xprobe, zprobe):
        return generateVeinPart(f, c, random, d, e, h, j, l, m, n, o, pp, q, r)
      inc zprobe
    inc xprobe
  false

proc scatteredOffset(random: var RandomGenerator, maxDist: int32): int32 =
  let f1 = nextF32(random)
  let f2 = nextF32(random)
  int32(round((f1 - f2) * float32(maxDist)))

proc generateScatteredOre*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, p: BlockPos): bool =
  ## `ScatteredOreFeature::generate`
  let count = nextBoundedI32(random, f.size + 1)
  for i in 0'i32 ..< count:
    let maxDist = min(i, 7'i32)
    let dx = scatteredOffset(random, maxDist)
    let dy = scatteredOffset(random, maxDist)
    let dz = scatteredOffset(random, maxDist)
    let t = p.add(dx, dy, dz)
    if outOfHeight(c, t.y):
      continue
    let blockState = getState(c, t)
    for ti in 0 ..< f.targets.len:
      if shouldPlace(f.discardChanceOnAirExposure, c, blockState, random, f.targets[ti], t):
        setState(c, t, f.targets[ti].state)
        break
  true

proc generateReplaceSingleBlock*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, p: BlockPos): bool =
  ## `ReplaceSingleBlockFeature::generate`: the newer checkout's, with its targets.
  let blockState = getState(c, p)
  for ti in 0 ..< f.targets.len:
    if test(f.targets[ti].target, blockState, random):
      setState(c, p, f.targets[ti].state)
      break
  true

proc generateReplaceBlobs*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, p: BlockPos): bool =
  ## `ReplaceBlobsFeature::generate`
  let target = blockIdOf(f.targetState)
  var at = p
  var found = false
  while at.y > bottomY(c) + 1:
    if getBlockId(c, at) == target:
      found = true
      break
    at = at.down()
  if not found:
    return false
  let x = get(f.radius, random)
  let y = get(f.radius, random)
  let z = get(f.radius, random)
  let distance = max(x, max(y, z))
  result = false
  var it = iterateOutwards(at, x, y, z)
  while true:
    let n = next(it)
    if isNone(n):
      break
    let ip = n.get()
    if manhattanDistance(ip, at) > distance:
      break
    if getBlockId(c, ip) != target:
      continue
    setState(c, ip, f.state)
    result = true
