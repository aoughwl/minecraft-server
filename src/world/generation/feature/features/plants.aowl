## Port of pumpkin-world/src/generation/feature/features/bamboo.rs, pumpkin-world/src/generation/feature/features/seagrass.rs,
## pumpkin-world/src/generation/feature/features/sea_pickle.rs, pumpkin-world/src/generation/feature/features/kelp.rs,
## pumpkin-world/src/generation/feature/features/vines.rs, pumpkin-world/src/generation/feature/features/multiface_growth.rs,
## pumpkin-world/src/generation/feature/features/simple_block.rs, pumpkin-world/src/generation/feature/features/block_column.rs,
## pumpkin-world/src/generation/feature/features/nether_forest_vegetation.rs, pumpkin-world/src/generation/feature/features/twisting_vines.rs,
## pumpkin-world/src/generation/feature/features/weeping_vines.rs, pumpkin-world/src/generation/feature/features/huge_fungus.rs,
## pumpkin-world/src/generation/feature/features/huge_brown_mushroom.rs and pumpkin-world/src/generation/feature/features/huge_red_mushroom.rs
##
## Logic as the newer checkout (../ref/pumpkin) has it, where the pinned tree stubs or simplifies them.

{.feature: "lenientnils".}

import ../types
import ../common

let
  TagBeneathBambooPodzolReplaceable = blockTag("beneath_bamboo_podzol_replaceable")
  TagCannotSupportSeagrass = blockTag("cannot_support_seagrass")
  TagCannotSupportKelp = blockTag("cannot_support_kelp")
  TagNylium = blockTag("nylium")
  TagHugeBrown = blockTag("huge_brown_mushroom_can_place_on")
  TagHugeRed = blockTag("huge_red_mushroom_can_place_on")
  TagReplaceableByMushrooms = blockTag("replaceable_by_mushrooms")
  TagLeaves = blockTag("leaves")
  BBamboo = blockIdOfName("bamboo")
  SBamboo = defaultStateOf(BBamboo)
  SPodzol = stateOfName("podzol")
  BKelp = blockIdOfName("kelp")
  BKelpPlant = blockIdOfName("kelp_plant")
  BSeaPickle = blockIdOfName("sea_pickle")
  BSeagrass = blockIdOfName("seagrass")
  BTallSeagrass = blockIdOfName("tall_seagrass")
  BSmallDripleaf = blockIdOfName("small_dripleaf")
  BPaleMossCarpet = blockIdOfName("pale_moss_carpet")
  BNetherrack = blockIdOfName("netherrack")
  BNetherWartBlock = blockIdOfName("nether_wart_block")
  BWarpedNylium = blockIdOfName("warped_nylium")
  BWarpedWartBlock = blockIdOfName("warped_wart_block")
  BTwistingVines = blockIdOfName("twisting_vines")
  STwistingVinesPlant = stateOfName("twisting_vines_plant")
  BWeepingVines = blockIdOfName("weeping_vines")
  SWeepingVinesPlant = stateOfName("weeping_vines_plant")
  SNetherWartBlock = defaultStateOf(BNetherWartBlock)
  BMushroomStem = blockIdOfName("mushroom_stem")
  BBrownMushroomBlock = blockIdOfName("brown_mushroom_block")
  BRedMushroomBlock = blockIdOfName("red_mushroom_block")

proc generateBamboo*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BambooFeature::generate`
  if not (airAt(c, at) and canPlace(c, SBamboo, at)):
    return false
  let height = nextBoundedI32(random, 12) + 5
  if nextF32(random) < f.probability:
    let r = nextBoundedI32(random, 4) + 1
    var xx = at.x - r
    while xx <= at.x + r:
      var zz = at.z - r
      while zz <= at.z + r:
        let xd = xx - at.x
        let zd = zz - at.z
        if xd * xd + zd * zd <= r * r:
          let py = topBlock(c, xx, zz) - 1
          let pp = pos(xx, py, zz)
          if hasBlockTag(getState(c, pp), TagBeneathBambooPodzolReplaceable):
            setState(c, pp, SPodzol)
        inc zz
      inc xx
  let trunk = stateWith(BBamboo, [(name: "age", value: "1"), (name: "leaves", value: "none"), (name: "stage", value: "0")])
  var b = at
  for i in 0'i32 ..< height:
    if airAt(c, b):
      setState(c, b, trunk)
      b = b.up()
    else:
      break
  if b.y - at.y >= 3:
    setState(c, b, stateWith(BBamboo, [(name: "age", value: "1"), (name: "leaves", value: "large"), (name: "stage", value: "1")]))
    setState(c, b.down(), stateWith(BBamboo, [(name: "age", value: "1"), (name: "leaves", value: "large"), (name: "stage", value: "0")]))
    setState(c, b.down().down(), stateWith(BBamboo, [(name: "age", value: "1"), (name: "leaves", value: "small"), (name: "stage", value: "0")]))
  true

proc generateSeagrass*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `SeagrassFeature::generate`
  result = false
  let x = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
  let z = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
  let y = oceanFloor(c, at.x + x, at.z + z)
  let p = pos(at.x + x, y, at.z + z)
  if getBlockId(c, p) == BWater:
    let below = getState(c, p.down())
    if not hasBlockTag(below, TagCannotSupportSeagrass) and sideSolid(below, BlockDirection.Up):
      if nextF64(random) < float64(f.probability):
        let above = p.up()
        if getBlockId(c, above) == BWater:
          setState(c, p, defaultStateOf(BTallSeagrass))
          setState(c, above, stateWith(BTallSeagrass, [(name: "half", value: "upper")]))
          result = true
      else:
        setState(c, p, defaultStateOf(BSeagrass))
        result = true

proc generateSeaPickle*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `SeaPickleFeature::generate`
  result = false
  let count = get(f.count, random)
  for i in 0'i32 ..< count:
    let x = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
    let z = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
    let y = oceanFloor(c, at.x + x, at.z + z)
    let p = pos(at.x + x, y, at.z + z)
    if getBlockId(c, p) == BWater and sideSolid(getState(c, p.down()), BlockDirection.Up):
      let pickles = nextBoundedI32(random, 4) + 1
      setState(c, p, stateWith(BSeaPickle, [(name: "pickles", value: $pickles)]))
      result = true

proc kelpCanSurvive(c: FeatureContext, p: BlockPos): bool =
  let below = getState(c, p.down())
  if hasBlockTag(below, TagCannotSupportKelp):
    return false
  let id = blockIdOf(below)
  id == BKelp or id == BKelpPlant or sideSolid(below, BlockDirection.Up)

proc kelpTop(random: var RandomGenerator): BlockStateId =
  stateWith(BKelp, [(name: "age", value: $(nextBoundedI32(random, 4) + 20))])

proc generateKelp*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `KelpFeature::generate`
  result = false
  var p = pos(at.x, oceanFloor(c, at.x, at.z), at.z)
  if getBlockId(c, p) == BWater:
    let height = 1 + nextBoundedI32(random, 10)
    for h in 0'i32 .. height:
      let survive = kelpCanSurvive(c, p)
      if getBlockId(c, p) == BWater and getBlockId(c, p.up()) == BWater and survive:
        if h == height:
          setState(c, p, kelpTop(random))
          result = true
        else:
          setState(c, p, defaultStateOf(BKelpPlant))
      elif h > 0:
        let below = p.down()
        if kelpCanSurvive(c, below) and getBlockId(c, below.down()) != BKelp:
          setState(c, below, kelpTop(random))
          result = true
        break
      p = p.up()

proc generateVines*(c: FeatureContext, at: BlockPos): bool =
  ## `VinesFeature::generate`
  if not airAt(c, at):
    return false
  for dir in AllDirections:
    if dir == BlockDirection.Down:
      continue
    let n = getState(c, offset(at, dir))
    if not sideSolid(n, opposite(dir)) and not isFullCube(n):
      continue
    setState(c, at, stateWith(BVine, [(name: "north", value: boolStr(dir == BlockDirection.North)),
      (name: "east", value: boolStr(dir == BlockDirection.East)), (name: "south", value: boolStr(dir == BlockDirection.South)),
      (name: "west", value: boolStr(dir == BlockDirection.West)), (name: "up", value: boolStr(dir == BlockDirection.Up))]))
    return true
  false

# --- MultifaceGrowthFeature -------------------------------------------------------------------------------------------

proc dirName(d: BlockDirection): string =
  case d
  of BlockDirection.Down: "down"
  of BlockDirection.Up: "up"
  of BlockDirection.North: "north"
  of BlockDirection.South: "south"
  of BlockDirection.West: "west"
  of BlockDirection.East: "east"

proc airOrWater(c: FeatureContext, p: BlockPos): bool =
  let s = getState(c, p)
  isAir(s) or blockIdOf(s) == BWater

proc validForPlacement(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, face: BlockDirection): bool =
  let existing = getState(c, p)
  if blockIdOf(existing) == f.placeBlock and propValue(existing, dirName(face)) == "true":
    return false
  let n = getState(c, offset(p, face))
  sideSolid(n, opposite(face)) or isFullCube(n)

proc placeFace(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, face: BlockDirection) =
  let cur = getState(c, p)
  var props = newSeq[StateProp](0)
  for d in AllDirections:
    let on = d == face or (blockIdOf(cur) == f.placeBlock and propValue(cur, dirName(d)) == "true")
    props.add((name: dirName(d), value: boolStr(on)))
  let waterlogged = if blockIdOf(cur) == f.placeBlock: isWaterlogged(cur) else: cur == SWater
  props.add((name: "waterlogged", value: boolStr(waterlogged)))
  setState(c, p, stateWith(f.placeBlock, props))

proc canSpreadInto(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, face: BlockDirection): bool =
  let existing = getState(c, p)
  if not (isAir(existing) or blockIdOf(existing) == f.placeBlock or existing == SWater):
    return false
  validForPlacement(f, c, p, face)

proc sameAxis(a, b: BlockDirection): bool =
  ord(a) div 2 == ord(b) div 2

proc spreadFromFace(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, startingFace: BlockDirection, random: var RandomGenerator) =
  var dirs = @AllDirections
  shuffle(dirs, random)
  for k in 0 ..< dirs.len:
    let spread = dirs[k]
    if sameAxis(spread, startingFace):
      continue
    let cur = getState(c, p)
    if blockIdOf(cur) == f.placeBlock and propValue(cur, dirName(spread)) == "true":
      continue
    let a = offset(p, spread)
    let b = offset(a, startingFace)
    if canSpreadInto(f, c, p, spread):
      placeFace(f, c, p, spread)
      return
    if canSpreadInto(f, c, a, startingFace):
      placeFace(f, c, a, startingFace)
      return
    if canSpreadInto(f, c, b, opposite(spread)):
      placeFace(f, c, b, opposite(spread))
      return

proc inInts(s: seq[int], v: int): bool =
  for x in s:
    if x == v:
      return true
  false

proc placeGrowthIfPossible(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, random: var RandomGenerator, dirs: seq[BlockDirection]): bool =
  for i in 0 ..< dirs.len:
    let d = dirs[i]
    if inInts(f.canBePlacedOn, getBlockId(c, offset(p, d))):
      if not validForPlacement(f, c, p, d):
        return false
      placeFace(f, c, p, d)
      if nextF32(random) < f.chanceOfSpreading:
        spreadFromFace(f, c, p, d, random)
      return true
  false

proc validDirections(f: ConfiguredFeatureDef): seq[BlockDirection] =
  result = newSeq[BlockDirection](0)
  if f.canPlaceOnCeiling: result.add(BlockDirection.Up)
  if f.canPlaceOnFloor: result.add(BlockDirection.Down)
  if f.canPlaceOnWall:
    for d in HorizontalWorldgen:
      result.add(d)

proc generateMultifaceGrowth*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `MultifaceGrowthFeature::generate`
  if not airOrWater(c, at):
    return false
  var shuffled = validDirections(f)
  shuffle(shuffled, random)
  if placeGrowthIfPossible(f, c, at, random, shuffled):
    return true
  # Vanilla's `setWithOffset(origin, direction)` inside its `search_range` loop lands on the same block each time.
  for i in 0 ..< shuffled.len:
    let search = shuffled[i]
    var placement = newSeq[BlockDirection](0)
    let valid = validDirections(f)
    for k in 0 ..< valid.len:
      if valid[k] != opposite(search):
        placement.add(valid[k])
    shuffle(placement, random)
    let cur = offset(at, search)
    if not airOrWater(c, cur) and getBlockId(c, cur) != f.placeBlock:
      continue
    if placeGrowthIfPossible(f, c, cur, random, placement):
      return true
  false

# --- SimpleBlockFeature -----------------------------------------------------------------------------------------------

proc isWaterAt(c: FeatureContext, p: BlockPos): bool =
  let s = getState(c, p)
  isWaterlogged(s) or blockIdOf(s) == BWater

proc carpetSupport(c: FeatureContext, p: BlockPos, d: BlockDirection): bool =
  sideSolid(getState(c, offset(p, d)), opposite(d))

proc updatedCarpet(state: BlockStateId, c: FeatureContext, p: BlockPos, createSides0: bool): BlockStateId =
  ## `updated_pale_moss_carpet_state`: north, east, south and west each follow the same rule.
  result = state
  let bottom = propValue(state, "bottom") == "true"
  let createSides = createSides0 or bottom
  let aboveRaw = getState(c, p.up())
  let belowRaw = getState(c, p.down())
  let aboveCarpet = blockIdOf(aboveRaw) == BPaleMossCarpet
  let belowCarpet = blockIdOf(belowRaw) == BPaleMossCarpet
  for d in HorizontalWorldgen:
    let name = dirName(d)
    var v = propValue(result, name)
    if carpetSupport(c, p, d):
      if createSides:
        v = "low"
      if v == "low":
        if aboveCarpet and propValue(aboveRaw, name) != "none" and propValue(aboveRaw, "bottom") != "true":
          v = "tall"
        if not bottom and belowCarpet and propValue(belowRaw, name) == "none":
          v = "none"
    else:
      v = "none"
    result = withProp(result, name, v)

proc placePaleMossCarpet(c: FeatureContext, p: BlockPos, random: var RandomGenerator) =
  let base = defaultStateOf(BPaleMossCarpet)
  let adjusted = updatedCarpet(base, c, p, true)
  setState(c, p, adjusted)
  let above = p.up()
  let abovePrev = getState(c, above)
  let isCarpetAbove = blockIdOf(abovePrev) == BPaleMossCarpet
  let canPlaceTopper = (not isCarpetAbove or propValue(abovePrev, "bottom") != "true") and (isCarpetAbove or isReplaceable(abovePrev))
  if canPlaceTopper:
    var topper = updatedCarpet(withProp(base, "bottom", "false"), c, above, true)
    for d in HorizontalWorldgen:
      let name = dirName(d)
      if propValue(topper, name) != "none" and not nextBool(random):
        topper = withProp(topper, name, "none")
    var hasFaces = propValue(topper, "bottom") == "true"
    for d in HorizontalWorldgen:
      if propValue(topper, dirName(d)) != "none":
        hasFaces = true
    if hasFaces and topper != abovePrev:
      setState(c, above, topper)
      setState(c, p, updatedCarpet(adjusted, c, p, true))

proc generateSimpleBlock*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `SimpleBlockFeature::generate`
  let o = getOptional(f.stateProvider, c.blockRegistry, c.chunk, random, at)
  if not o.hasState:
    return false
  let state = o.state
  if not canPlace(c, state, at):
    return false
  let id = blockIdOf(state)
  let isDouble = hasProp(state, "half") and propValue(state, "half") == "lower" and not hasProp(state, "facing")
  if id == BSmallDripleaf or isDouble:
    let above = at.up()
    let aboveState = getState(c, above)
    if not isAir(aboveState):
      let stateIsWater = id == BTallSeagrass or isWaterlogged(state) or id == BWater
      if stateIsWater != isWaterAt(c, above) or not isReplaceable(aboveState):
        return false
    if id == BSmallDripleaf:
      let lower = withProp(withProp(state, "half", "lower"), "waterlogged", boolStr(isWaterAt(c, at)))
      setState(c, at, lower)
      setState(c, above, withProp(withProp(lower, "half", "upper"), "waterlogged", boolStr(isWaterAt(c, above))))
    else:
      setState(c, at, withProp(state, "half", "lower"))
      setState(c, above, withProp(state, "half", "upper"))
  elif id == BPaleMossCarpet:
    placePaleMossCarpet(c, at, random)
  else:
    setState(c, at, state)
  true

# --- BlockColumnFeature -----------------------------------------------------------------------------------------------

proc adjustLayerHeights(layers: var seq[int32], expected, actual: int32, prioritizeTip: bool) =
  var i = expected - actual
  let j = if prioritizeTip: 1'i32 else: -1'i32
  let k = if prioritizeTip: 0'i32 else: int32(layers.len) - 1
  let l = if prioritizeTip: int32(layers.len) else: -1'i32
  var m = k
  while m != l and i > 0:
    let n = layers[int(m)]
    let o = min(n, i)
    layers[int(m)] -= o
    i -= o
    m += j

proc generateBlockColumn*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BlockColumnFeature::generate`
  var heights = newSeq[int32](f.layers.len)
  var j = 0'i32
  for k in 0 ..< f.layers.len:
    heights[k] = get(f.layers[k].height, random)
    j += heights[k]
  if j == 0:
    return false
  var m1 = at
  var m2 = offset(m1, f.direction)
  var l = 0'i32
  while l < j:
    if not test(f.allowedPlacement, c.blockRegistry, c.chunk, m2):
      adjustLayerHeights(heights, j, l, f.prioritizeTip)
      break
    m2 = offset(m2, f.direction)
    inc l
  for k in 0 ..< heights.len:
    if heights[k] == 0:
      continue
    for n in 0'i32 ..< heights[k]:
      let s = get(f.layers[k].provider, random, m1, c.chunk, c.blockRegistry)
      setState(c, m1, s)
      m1 = offset(m1, f.direction)
  true

# --- Nether ------------------------------------------------------------------------------------------------------------

proc generateNetherForestVegetation*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `NetherForestVegetationFeature::generate`
  if not hasBlockTag(getState(c, at.down()), TagNylium):
    return false
  if at.y <= bottomY(c) or at.y > topY(c):
    return false
  result = false
  for i in 0'i32 ..< f.spreadWidth * f.spreadWidth:
    let x = nextBoundedI32(random, f.spreadWidth) - nextBoundedI32(random, f.spreadWidth)
    let y = nextBoundedI32(random, f.spreadHeight) - nextBoundedI32(random, f.spreadHeight)
    let z = nextBoundedI32(random, f.spreadWidth) - nextBoundedI32(random, f.spreadWidth)
    let p = at.add(x, y, z)
    let s = get(f.stateProvider, random, p, c.chunk, c.blockRegistry)
    if not airAt(c, p) or p.y <= bottomY(c) or not canPlace(c, s, p):
      continue
    setState(c, p, s)
    result = true

proc twistingInvalid(c: FeatureContext, p: BlockPos): bool =
  if not airAt(c, p):
    return true
  let below = getBlockId(c, p.down())
  below != BNetherrack and below != BWarpedNylium and below != BWarpedWartBlock

proc placeTwistingColumn(c: FeatureContext, random: var RandomGenerator, start: BlockPos, totalHeight, minAge, maxAge: int32) =
  var p = start
  var height = 1'i32
  while height <= totalHeight:
    if airAt(c, p):
      if height == totalHeight or not airAt(c, p.up()):
        setState(c, p, stateWith(BTwistingVines, [(name: "age", value: $nextInbetweenI32(random, minAge, maxAge))]))
        break
      setState(c, p, STwistingVinesPlant)
    p = p.up()
    inc height

proc generateTwistingVines*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `TwistingVinesFeature::generate`
  if twistingInvalid(c, at):
    return false
  result = false
  for i in 0'i32 ..< f.spreadWidth * f.spreadWidth:
    let dx = nextInbetweenI32(random, -f.spreadWidth, f.spreadWidth)
    let dy = nextInbetweenI32(random, -f.spreadHeight, f.spreadHeight)
    let dz = nextInbetweenI32(random, -f.spreadWidth, f.spreadWidth)
    var p = at.add(dx, dy, dz)
    var found = true
    while true:
      p = p.down()
      if p.y <= bottomY(c):
        found = false
        break
      if not airAt(c, p):
        break
    if found:
      p = p.up()
      if not twistingInvalid(c, p):
        var vh = nextInbetweenI32(random, 1, f.maxHeight)
        if nextBoundedI32(random, 6) == 0:
          vh *= 2
        if nextBoundedI32(random, 5) == 0:
          vh = 1
        placeTwistingColumn(c, random, p, vh, 17, 25)
        result = true

proc placeWeepingColumn*(c: FeatureContext, random: var RandomGenerator, start: BlockPos, totalHeight, minAge, maxAge: int32) =
  ## `WeepingVinesFeature::place_weeping_vines_column`
  var p = start
  var height = 0'i32
  while height <= totalHeight:
    if airAt(c, p):
      if height == totalHeight or not airAt(c, p.down()):
        setState(c, p, stateWith(BWeepingVines, [(name: "age", value: $nextInbetweenI32(random, minAge, maxAge))]))
        break
      setState(c, p, SWeepingVinesPlant)
    p = p.down()
    inc height

proc generateWeepingVines*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `WeepingVinesFeature::generate`
  if not airAt(c, at):
    return false
  let aboveId = getBlockId(c, at.up())
  if aboveId != BNetherrack and aboveId != BNetherWartBlock:
    return false
  setState(c, at, SNetherWartBlock)
  for i in 0 ..< 200:
    let p = at.add(nextBoundedI32(random, 6) - nextBoundedI32(random, 6), nextBoundedI32(random, 2) - nextBoundedI32(random, 5),
      nextBoundedI32(random, 6) - nextBoundedI32(random, 6))
    if airAt(c, p):
      var neighbours = 0
      for dir in AllDirections:
        let id = getBlockId(c, offset(p, dir))
        if id == BNetherrack or id == BNetherWartBlock:
          inc neighbours
        if neighbours > 1:
          break
      if neighbours == 1:
        setState(c, p, SNetherWartBlock)
  for i in 0 ..< 100:
    let p = at.add(nextBoundedI32(random, 8) - nextBoundedI32(random, 8), nextBoundedI32(random, 2) - nextBoundedI32(random, 7),
      nextBoundedI32(random, 8) - nextBoundedI32(random, 8))
    if airAt(c, p):
      let a = getBlockId(c, p.up())
      if a == BNetherrack or a == BNetherWartBlock:
        var vh = nextBoundedI32(random, 8) + 1
        if nextBoundedI32(random, 6) == 0:
          vh *= 2
        if nextBoundedI32(random, 5) == 0:
          vh = 1
        placeWeepingColumn(c, random, p, vh, 17, 25)
  true

# --- HugeFungusFeature -------------------------------------------------------------------------------------------------

proc fungusReplaceable(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, checkPlants: bool): bool =
  if airAt(c, p):
    true
  elif checkPlants:
    test(f.replaceableBlocks, c.blockRegistry, c.chunk, p)
  else:
    false

proc tryPlaceWeeping(c: FeatureContext, random: var RandomGenerator, hat: BlockPos) =
  let p = hat.down()
  if airAt(c, p):
    var goal = nextInbetweenI32(random, 1, 5)
    if nextBoundedI32(random, 7) == 0:
      goal *= 2
    placeWeepingColumn(c, random, p, goal, 23, 25)

proc placeHatBlock(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, p: BlockPos, decorProb, hatProb, vinesProb: float32) =
  if nextF32(random) < decorProb:
    setState(c, p, f.decorState)
  elif nextF32(random) < hatProb:
    setState(c, p, f.hatState)
    if nextF32(random) < vinesProb:
      tryPlaceWeeping(c, random, p)

proc generateHugeFungus*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `HugeFungusFeature::generate`
  if getBlockId(c, at.down()) != blockIdOf(f.validBaseBlock):
    return false
  var totalHeight = nextInbetweenI32(random, 4, 13)
  if nextBoundedI32(random, 12) == 0:
    totalHeight *= 2
  if not f.planted and at.y + totalHeight + 1 >= topY(c):
    return false
  let isHuge = not f.planted and nextF32(random) < 0.06'f32
  setState(c, at, SAir)
  # place_stem
  let stemRadius = if isHuge: 1'i32 else: 0'i32
  var dx = -stemRadius
  while dx <= stemRadius:
    var dz = -stemRadius
    while dz <= stemRadius:
      let corner = isHuge and abs(dx) == stemRadius and abs(dz) == stemRadius
      for dy in 0'i32 ..< totalHeight:
        let p = at.add(dx, dy, dz)
        if fungusReplaceable(f, c, p, true):
          if f.planted:
            setState(c, p, f.stemState)
          elif corner:
            if nextF32(random) < 0.1'f32:
              setState(c, p, f.stemState)
          else:
            setState(c, p, f.stemState)
      inc dz
    inc dx
  # place_hat
  let placeVines = blockIdOf(f.hatState) == BNetherWartBlock
  let hatHeight = min(nextBoundedI32(random, 1 + totalHeight div 3) + 5, totalHeight)
  let hatStart = totalHeight - hatHeight
  var dy = hatStart
  while dy <= totalHeight:
    let rnd = nextBoundedI32(random, 3)
    var radius = if hatHeight > 8 and dy < hatStart + 4: 3'i32
                 elif dy < totalHeight - rnd: 2'i32
                 else: 1'i32
    if isHuge:
      inc radius
    var hx = -radius
    while hx <= radius:
      var hz = -radius
      while hz <= radius:
        let edgeX = hx == -radius or hx == radius
        let edgeZ = hz == -radius or hz == radius
        let inside = not edgeX and not edgeZ and dy != totalHeight
        let corner = edgeX and edgeZ
        let hatBottom = dy < hatStart + 3
        let p = at.add(hx, dy, hz)
        if fungusReplaceable(f, c, p, false):
          if hatBottom:
            if not inside:
              if getBlockId(c, p.down()) == blockIdOf(f.hatState):
                setState(c, p, f.hatState)
              elif nextF32(random) < 0.15'f32:
                setState(c, p, f.hatState)
                if placeVines and nextBoundedI32(random, 11) == 0:
                  tryPlaceWeeping(c, random, p)
          elif inside:
            placeHatBlock(f, c, random, p, 0.1'f32, 0.2'f32, if placeVines: 0.1'f32 else: 0.0'f32)
          elif corner:
            placeHatBlock(f, c, random, p, 0.01'f32, 0.7'f32, if placeVines: 0.083'f32 else: 0.0'f32)
          else:
            placeHatBlock(f, c, random, p, 5.0e-4'f32, 0.98'f32, if placeVines: 0.07'f32 else: 0.0'f32)
        inc hz
      inc hx
    inc dy
  true

# --- Huge mushrooms ----------------------------------------------------------------------------------------------------

proc mushroomTreeHeight(random: var RandomGenerator): int32 =
  result = nextBoundedI32(random, 3) + 4
  if nextBoundedI32(random, 12) == 0:
    result *= 2

proc placeMushroomBlock(c: FeatureContext, p: BlockPos, s: BlockStateId) =
  let cur = getState(c, p)
  if isAir(cur) or hasBlockTag(cur, TagReplaceableByMushrooms):
    setState(c, p, s)

proc mushroomProps(up, west, east, north, south: bool): array[6, StateProp] =
  [(name: "up", value: boolStr(up)), (name: "down", value: "false"), (name: "west", value: boolStr(west)),
   (name: "east", value: boolStr(east)), (name: "north", value: boolStr(north)), (name: "south", value: boolStr(south))]

proc clearForMushroom(c: FeatureContext, at: BlockPos, dy, radius: int32): bool =
  var dx = -radius
  while dx <= radius:
    var dz = -radius
    while dz <= radius:
      let s = getState(c, at.add(dx, dy, dz))
      if not isAir(s) and not hasBlockTag(s, TagLeaves):
        return false
      inc dz
    inc dx
  true

proc placeStem(c: FeatureContext, at: BlockPos, treeHeight: int32) =
  let stem = stateWith(BMushroomStem, mushroomProps(false, true, true, true, true))
  for i in 0'i32 ..< treeHeight:
    placeMushroomBlock(c, at.add(0, i, 0), stem)

proc generateHugeBrownMushroom*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `HugeBrownMushroomFeature::generate`
  const R = 3'i32
  let treeHeight = mushroomTreeHeight(random)
  if at.y < bottomY(c) + 1 or at.y + treeHeight + 1 > topY(c):
    return false
  if not hasBlockTag(getState(c, at.down()), TagHugeBrown):
    return false
  for dy in 0'i32 .. treeHeight:
    if not clearForMushroom(c, at, dy, if dy <= 3: 0'i32 else: R):
      return false
  let capY = at.y + treeHeight
  var j = -R
  while j <= R:
    var k = -R
    while k <= R:
      let edgeX = j == -R or j == R
      let edgeZ = k == -R or k == R
      if not (edgeX and edgeZ):
        let s = stateWith(BBrownMushroomBlock, mushroomProps(true, j == -R or (edgeZ and j == 1 - R), j == R or (edgeZ and j == R - 1),
          k == -R or (edgeX and k == 1 - R), k == R or (edgeX and k == R - 1)))
        placeMushroomBlock(c, pos(at.x + j, capY, at.z + k), s)
      inc k
    inc j
  placeStem(c, at, treeHeight)
  true

proc generateHugeRedMushroom*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `HugeRedMushroomFeature::generate`
  const R = 2'i32
  let treeHeight = mushroomTreeHeight(random)
  if at.y < bottomY(c) + 1 or at.y + treeHeight + 1 > topY(c):
    return false
  if not hasBlockTag(getState(c, at.down()), TagHugeRed):
    return false
  for dy in 0'i32 .. treeHeight:
    let r = if (dy < treeHeight and dy >= treeHeight - 3) or dy == treeHeight: R else: 0'i32
    if not clearForMushroom(c, at, dy, r):
      return false
  var i = treeHeight - 3
  while i <= treeHeight:
    let j = if i < treeHeight: R else: R - 1
    let k = R - 2
    var l = -j
    while l <= j:
      var m = -j
      while m <= j:
        let edgeX = l == -j or l == j
        let edgeZ = m == -j or m == j
        if not (i < treeHeight and edgeX == edgeZ):
          let s = stateWith(BRedMushroomBlock, mushroomProps(i >= treeHeight - 1, l < -k, l > k, m < -k, m > k))
          placeMushroomBlock(c, pos(at.x + l, at.y + i, at.z + m), s)
        inc m
      inc l
    inc i
  placeStem(c, at, treeHeight)
  true
