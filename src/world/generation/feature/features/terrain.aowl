## Port of pumpkin-world/src/generation/feature/features/disk.rs, pumpkin-world/src/generation/feature/features/lake.rs,
## pumpkin-world/src/generation/feature/features/forest_rock.rs, pumpkin-world/src/generation/feature/features/ice_spike.rs,
## pumpkin-world/src/generation/feature/features/iceberg.rs, pumpkin-world/src/generation/feature/features/blue_ice.rs,
## pumpkin-world/src/generation/feature/features/freeze_top_layer.rs, pumpkin-world/src/generation/feature/features/fill_layer.rs,
## pumpkin-world/src/generation/feature/features/underwater_magma.rs, pumpkin-world/src/generation/feature/features/basalt_columns.rs,
## pumpkin-world/src/generation/feature/features/basalt_pillar.rs, pumpkin-world/src/generation/feature/features/delta_feature.rs,
## pumpkin-world/src/generation/feature/features/glowstone_blob.rs, pumpkin-world/src/generation/feature/features/spring_feature.rs,
## pumpkin-world/src/generation/feature/features/monster_room.rs, pumpkin-world/src/generation/feature/features/desert_well.rs,
## pumpkin-world/src/generation/feature/features/bonus_chest.rs, pumpkin-world/src/generation/feature/features/void_start_platform.rs,
## pumpkin-world/src/generation/feature/features/block_pile.rs, pumpkin-world/src/generation/feature/features/fallen_tree.rs,
## pumpkin-world/src/generation/feature/features/fossil.rs, pumpkin-world/src/generation/feature/features/end_gateway.rs,
## pumpkin-world/src/generation/feature/features/end_island.rs, pumpkin-world/src/generation/feature/features/end_platform.rs,
## pumpkin-world/src/generation/feature/features/end_spike.rs and pumpkin-world/src/generation/feature/features/chorus_plant.rs
##
## Logic as the newer checkout (../ref/pumpkin) has it, where the pinned tree stubs or simplifies them.
## PARTIAL: pumpkin-world/src/generation/feature/features/void_start_platform.rs - the pinned tree's shape; the newer checkout's is the debug void world's, which no vanilla world here generates.

{.feature: "lenientnils".}

import std/math
import ../../../../generated/biome as biomedata
import ../../../../nbt/tag
import ../../../../data/block_rotation
import ../../biomeweather
import "../../structure/template/cache"
import "../../structure/template/structure_template"
import "../../structure/template/block_state_resolver"
import ../types
import ../common
import tree

let
  TagFeaturesCannotReplace = blockTag("features_cannot_replace")
  TagLavaPoolStoneCannotReplace = blockTag("lava_pool_stone_cannot_replace")
  TagDirt = blockTag("dirt")
  TagBaseStoneOverworld = blockTag("base_stone_overworld")
  TagCannotSupportSnowLayer = blockTag("cannot_support_snow_layer")
  TagSupportOverrideSnowLayer = blockTag("support_override_snow_layer")
  TagSupportsChorusPlant = blockTag("supports_chorus_plant")
  SSnow = stateOfName("snow")
  SIce = stateOfName("ice")
  SPackedIce = stateOfName("packed_ice")
  SBlueIce = stateOfName("blue_ice")
  SSnowBlock = stateOfName("snow_block")
  SBasalt = stateOfName("basalt")
  BSnow = blockIdOfName("snow")
  BSnowBlock = blockIdOfName("snow_block")
  BIce = blockIdOfName("ice")
  BPackedIce = blockIdOfName("packed_ice")
  BBlueIce = blockIdOfName("blue_ice")
  BBasalt = blockIdOfName("basalt")
  BGlowstone = blockIdOfName("glowstone")
  BNetherrack = blockIdOfName("netherrack")
  BBlackstone = blockIdOfName("blackstone")
  BMagma = blockIdOfName("magma_block")
  BSoulSand = blockIdOfName("soul_sand")
  BNetherBricks = blockIdOfName("nether_bricks")
  BNetherBrickFence = blockIdOfName("nether_brick_fence")
  BNetherBrickStairs = blockIdOfName("nether_brick_stairs")
  BNetherWart = blockIdOfName("nether_wart")
  BChest = blockIdOfName("chest")
  BSpawner = blockIdOfName("spawner")
  BBedrock = blockIdOfName("bedrock")
  BChorusPlant = blockIdOfName("chorus_plant")
  BChorusFlower = blockIdOfName("chorus_flower")
  BSand = blockIdOfName("sand")
  BDirtPath = blockIdOfName("dirt_path")
  BCoalOre = blockIdOfName("coal_ore")

# --- disk.rs ----------------------------------------------------------------------------------------------------------

proc generateDisk*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `DiskFeature::generate`. `half_height` is in `verticalRange` and `target` in `replaceable`.
  result = false
  let top = at.y + f.verticalRange
  let bottom = at.y - f.verticalRange - 1
  let r = get(f.radius, random)
  var x = at.x - r
  while x <= at.x + r:
    var z = at.z - r
    while z <= at.z + r:
      let xd = x - at.x
      let zd = z - at.z
      if xd * xd + zd * zd <= r * r:
        var y = top
        while y > bottom:
          let p = pos(x, y, z)
          if test(f.replaceable, c.blockRegistry, c.chunk, p):
            setState(c, p, getWithContext(f.stateProvider, c.blockRegistry, c.chunk, random, p))
            result = true
          dec y
      inc z
    inc x

# --- lake.rs ----------------------------------------------------------------------------------------------------------

proc lakeCanReplace(state: BlockStateId): bool {.inline.} =
  not hasBlockTag(state, TagFeaturesCannotReplace)

proc generateLake*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `LakeFeature::generate`
  if at.y <= bottomY(c) + 4:
    return false
  let origin = at.add(-8, -4, -8)
  var grid = newSeq[bool](2048)
  template g(xx, zz, yy: int): bool = grid[(xx * 16 + zz) * 8 + yy]
  let spots = nextBoundedI32(random, 4) + 4
  for s in 0'i32 ..< spots:
    let xr = nextF64(random) * 6.0 + 3.0
    let yr = nextF64(random) * 4.0 + 2.0
    let zr = nextF64(random) * 6.0 + 3.0
    let xp = nextF64(random) * (16.0 - xr - 2.0) + 1.0 + xr / 2.0
    let yp = nextF64(random) * (8.0 - yr - 4.0) + 2.0 + yr / 2.0
    let zp = nextF64(random) * (16.0 - zr - 2.0) + 1.0 + zr / 2.0
    for xx in 1 ..< 15:
      for zz in 1 ..< 15:
        for yy in 1 ..< 7:
          let xd = (float64(xx) - xp) / (xr / 2.0)
          let yd = (float64(yy) - yp) / (yr / 2.0)
          let zd = (float64(zz) - zp) / (zr / 2.0)
          if xd * xd + yd * yd + zd * zd < 1.0:
            grid[(xx * 16 + zz) * 8 + yy] = true
  let fluidState = getWithContext(f.stateProvider, c.blockRegistry, c.chunk, random, origin)
  template edge(xx, zz, yyx: int): bool =
    not g(xx, zz, yyx) and ((xx < 15 and g(xx + 1, zz, yyx)) or (xx > 0 and g(xx - 1, zz, yyx)) or
      (zz < 15 and g(xx, zz + 1, yyx)) or (zz > 0 and g(xx, zz - 1, yyx)) or
      (yyx < 7 and g(xx, zz, yyx + 1)) or (yyx > 0 and g(xx, zz, yyx - 1)))
  for xx in 0 ..< 16:
    for zz in 0 ..< 16:
      for yyx in 0 ..< 8:
        if edge(xx, zz, yyx):
          let s = getState(c, origin.add(int32(xx), int32(yyx), int32(zz)))
          if yyx >= 4 and isLiquid(s):
            return false
          if yyx < 4 and not isSolid(s) and s != fluidState:
            return false
  for xx in 0 ..< 16:
    for zz in 0 ..< 16:
      for yyx in 0 ..< 8:
        if g(xx, zz, yyx):
          let p = origin.add(int32(xx), int32(yyx), int32(zz))
          if lakeCanReplace(getState(c, p)):
            setState(c, p, if yyx >= 4: SCaveAir else: fluidState)
  let barrier = getWithContext(f.barrier, c.blockRegistry, c.chunk, random, origin)
  if not isAir(barrier):
    for xx in 0 ..< 16:
      for zz in 0 ..< 16:
        for yyx in 0 ..< 8:
          if edge(xx, zz, yyx) and (yyx < 4 or nextBoundedI32(random, 2) != 0):
            let p = origin.add(int32(xx), int32(yyx), int32(zz))
            let s = getState(c, p)
            if isSolid(s) and not hasBlockTag(s, TagLavaPoolStoneCannotReplace):
              setState(c, p, barrier)
  if blockIdOf(fluidState) == BWater:
    for xx in 0'i32 ..< 16'i32:
      for zz in 0'i32 ..< 16'i32:
        let p = origin.add(xx, 4, zz)
        let b = biomeForTerrainGenOf(c.chunk, p.x, p.y, p.z)
        if computeBiomeTemperature(b.id, float64(p.x), p.y, float64(p.z), c.seaLevel) < 0.15'f32:
          if lakeCanReplace(getState(c, p)):
            setState(c, p, SIce)
  true

# --- forest_rock.rs ---------------------------------------------------------------------------------------------------

proc generateForestRock*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `ForestRockFeature::generate`
  var p = at
  while true:
    if p.y <= bottomY(c) + 3:
      return false
    let below = getState(c, p.down())
    if not isAir(below):
      let ok = if f.replaceable != nil: test(f.replaceable, c.blockRegistry, c.chunk, p.down())
               else: hasBlockTag(below, TagDirt) or hasBlockTag(below, TagBaseStoneOverworld)
      if ok:
        break
    p = p.down()
  for i in 0 ..< 3:
    let xr = nextBoundedI32(random, 2)
    let yr = nextBoundedI32(random, 2)
    let zr = nextBoundedI32(random, 2)
    let threshold = float32(xr + yr + zr) * 0.333'f32 + 0.5'f32
    let thresholdSq = threshold * threshold
    # `BlockPos::iterate`: x fastest, then y, then z.
    var z = p.z - zr
    while z <= p.z + zr:
      var y = p.y - yr
      while y <= p.y + yr:
        var x = p.x - xr
        while x <= p.x + xr:
          let dx = float32(x - p.x)
          let dy = float32(y - p.y)
          let dz = float32(z - p.z)
          if dx * dx + dy * dy + dz * dz <= thresholdSq:
            setState(c, pos(x, y, z), f.state)
          inc x
        inc y
      inc z
    p = p.add(-1 + nextBoundedI32(random, 2), -nextBoundedI32(random, 2), -1 + nextBoundedI32(random, 2))
  true

# --- ice_spike.rs -----------------------------------------------------------------------------------------------------

proc spikeReplaceable(s: BlockStateId): bool =
  let id = blockIdOf(s)
  isAir(s) or hasBlockTag(s, TagDirt) or id == BSnowBlock or id == BIce

proc generateIceSpike*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `IceSpikeFeature::generate`
  var x = at.x
  var y = at.y
  let z = at.z
  while isAir(getState(c, pos(x, y, z))) and y > bottomY(c) + 2:
    dec y
  if getBlockId(c, pos(x, y, z)) != BSnowBlock:
    return false
  y += nextBoundedI32(random, 4)
  let height = nextBoundedI32(random, 4) + 7
  let width = height div 4 + nextBoundedI32(random, 2)
  if width > 1 and nextBoundedI32(random, 60) == 0:
    y += 10 + nextBoundedI32(random, 30)
  for yOff in 0'i32 ..< height:
    let scale = (1.0'f32 - float32(yOff) / float32(height)) * float32(width)
    let newWidth = int32(ceil(scale))
    var xo = -newWidth
    while xo <= newWidth:
      let dx = float32(abs(xo)) - 0.25'f32
      var zo = -newWidth
      while zo <= newWidth:
        let dz = float32(abs(zo)) - 0.25'f32
        let inSphere = (xo == 0 and zo == 0) or (dx * dx + dz * dz <= scale * scale)
        let edgeOk = (xo != -newWidth and xo != newWidth and zo != -newWidth and zo != newWidth) or nextF32(random) <= 0.75'f32
        if inSphere and edgeOk:
          let p1 = pos(x + xo, y + yOff, z + zo)
          if spikeReplaceable(getState(c, p1)):
            setState(c, p1, SPackedIce)
          if yOff != 0 and newWidth > 1:
            let p2 = pos(x + xo, y - yOff, z + zo)
            if spikeReplaceable(getState(c, p2)):
              setState(c, p2, SPackedIce)
        inc zo
      inc xo
  let pillarWidth = max(min(width - 1, 1'i32), 0'i32)
  var xo = -pillarWidth
  while xo <= pillarWidth:
    var zo = -pillarWidth
    while zo <= pillarWidth:
      var iy = y - 1
      let ix = x + xo
      let iz = z + zo
      var run = if abs(xo) == 1 and abs(zo) == 1: nextBoundedI32(random, 5) else: 50'i32
      while iy > 50:
        let s = getState(c, pos(ix, iy, iz))
        let id = blockIdOf(s)
        if not isAir(s) and not hasBlockTag(s, TagDirt) and id != BSnowBlock and id != BIce and id != BPackedIce:
          break
        setState(c, pos(ix, iy, iz), SPackedIce)
        dec iy
        dec run
        if run <= 0:
          iy -= nextBoundedI32(random, 5) + 1
          run = nextBoundedI32(random, 5)
      inc zo
    inc xo
  true

# --- iceberg.rs -------------------------------------------------------------------------------------------------------

proc isIcebergState(id: int): bool {.inline.} =
  id == BPackedIce or id == BSnowBlock or id == BBlueIce

proc ceilI(v: float32): int32 {.inline.} = int32(ceil(v))

proc radiusRound(random: var RandomGenerator, yOff, height, width: int32): int32 =
  let k = 3.5'f32 - nextF32(random)
  let ySq = float32(float64(yOff) * float64(yOff))
  var scale = 0.0'f32
  if height > 15 + nextBoundedI32(random, 5):
    let t = if yOff < 3 + nextBoundedI32(random, 6): yOff div 2 else: yOff
    scale = (1.0'f32 - float32(t) / (float32(height) * k * 0.4'f32)) * float32(width)
  else:
    scale = (1.0'f32 - ySq / (float32(height) * k)) * float32(width)
  ceilI(scale / 2.0'f32)

proc radiusEllipse(yOff, height, width: int32): int32 =
  let ySq = float32(float64(yOff) * float64(yOff))
  ceilI((1.0'f32 - ySq / float32(height)) * float32(width) / 2.0'f32)

proc radiusSteep(random: var RandomGenerator, yOff, height, width: int32): int32 =
  let k = 1.0'f32 + nextF32(random) / 2.0'f32
  ceilI((1.0'f32 - float32(yOff) / (float32(height) * k)) * float32(width) / 2.0'f32)

proc distCircle(xo, zo, ox, oz, radius: int32, random: var RandomGenerator): float64 =
  let n = nextF32(random)
  let cl = if n < 0.2'f32: 0.2'f32 elif n > 0.8'f32: 0.8'f32 else: n
  let off = 10.0'f32 * cl / float32(radius)
  let dx = float64(xo - ox)
  let dz = float64(zo - oz)
  let r = float64(radius)
  float64(off) + dx * dx + dz * dz - r * r

proc distEllipse(xo, zo, ox, oz, a, cc: int32, angle: float64): float64 =
  let dx = float64(xo - ox)
  let dz = float64(zo - oz)
  let co = cos(angle)
  let si = sin(angle)
  let p = (dx * co - dz * si) / float64(a)
  let q = (dx * si + dz * co) / float64(cc)
  p * p + q * q - 1.0

proc ellipseC(yOff, height, shapeC: int32): int32 =
  if yOff > 0 and height - yOff <= 3:
    return shapeC - (4 - (height - yOff))
  shapeC

proc setIcebergBlock(c: FeatureContext, random: var RandomGenerator, p: BlockPos, hDiff, height: int32, isEllipse, snowOnTop: bool, mainBlock: BlockStateId) =
  let s = getState(c, p)
  let id = blockIdOf(s)
  if isAir(s) or id == BSnowBlock or id == BIce or id == BWater:
    let randomness = not isEllipse or nextF64(random) > 0.05
    let divisor = if isEllipse: 3'i32 else: 2'i32
    let threshold = float64(nextBoundedI32(random, max(height div divisor, 1'i32))) + float64(height) * 0.6
    if snowOnTop and id != BWater and float64(hDiff) <= threshold and randomness:
      setState(c, p, SSnowBlock)
    else:
      setState(c, p, mainBlock)

proc icebergBlock(c: FeatureContext, random: var RandomGenerator, ox, oy, oz, height, xo, yOff, zo, radius, a: int32, isEllipse: bool, shapeC: int32, angle: float64, snowOnTop: bool, mainBlock: BlockStateId) =
  let d = if isEllipse: distEllipse(xo, zo, 0, 0, a, ellipseC(yOff, height, shapeC), angle)
          else: distCircle(xo, zo, 0, 0, radius, random)
  if d < 0.0:
    let p = pos(ox + xo, oy + yOff, oz + zo)
    let cmpv = if isEllipse: -0.5'f64 else: -6.0'f64 - float64(nextBoundedI32(random, 3))
    if d > cmpv and nextF64(random) > 0.9:
      return
    setIcebergBlock(c, random, p, height - yOff, height, isEllipse, snowOnTop, mainBlock)

proc icebergSmooth(c: FeatureContext, ox, oy, oz, width, height: int32, isEllipse: bool, shapeA: int32) =
  let a = if isEllipse: shapeA else: width div 2
  var x = -a
  while x <= a:
    var z = -a
    while z <= a:
      var yOff = 0'i32
      while yOff <= height:
        let p = pos(ox + x, oy + yOff, oz + z)
        let id = getBlockId(c, p)
        if isIcebergState(id) or id == BSnow:
          if airAt(c, p.down()):
            setState(c, p, SAir)
            setState(c, p.up(), SAir)
          elif isIcebergState(id):
            var nonIceberg = 0
            for sp in [p.west(), p.east(), p.north(), p.south()]:
              if not isIcebergState(getBlockId(c, sp)):
                inc nonIceberg
            if nonIceberg >= 3:
              setState(c, p, SAir)
        inc yOff
      inc z
    inc x

proc icebergCarve(c: FeatureContext, radius, yOff, ox, oy, oz: int32, underWater: bool, angle: float64, lx, lz, shapeA, shapeC: int32) =
  let a = radius + 1 + shapeA div 3
  let cc = min(radius - 3, 3'i32) + shapeC div 2 - 1
  var xo = -a
  while xo < a:
    var zo = -a
    while zo < a:
      if distEllipse(xo, zo, lx, lz, a, cc, angle) < 0.0:
        let p = pos(ox + xo, oy + yOff, oz + zo)
        let id = getBlockId(c, p)
        if isIcebergState(id) or id == BSnowBlock:
          if underWater:
            setState(c, p, SWater)
          else:
            setState(c, p, SAir)
            if getBlockId(c, p.up()) == BSnow:
              setState(c, p.up(), SAir)
      inc zo
    inc xo

proc generateIceberg*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `IcebergFeature::generate`
  let ox = at.x
  let oy = c.seaLevel
  let oz = at.z
  let mainBlock = f.state
  let snowOnTop = nextF64(random) > 0.7
  let angle = nextF64(random) * 2.0 * PI
  let shapeA = 11 - nextBoundedI32(random, 5)
  let shapeC = 3 + nextBoundedI32(random, 3)
  let isEllipse = nextF64(random) > 0.7
  var overWater = if isEllipse: nextBoundedI32(random, 6) + 6 else: nextBoundedI32(random, 15) + 3
  if not isEllipse and nextF64(random) > 0.9:
    overWater += nextBoundedI32(random, 19) + 7
  let underWater = min(overWater + nextBoundedI32(random, 11), 18'i32)
  let width = min(overWater + nextBoundedI32(random, 7) - nextBoundedI32(random, 5), 11'i32)
  let a = if isEllipse: shapeA else: 11'i32
  var xo = -a
  while xo < a:
    var zo = -a
    while zo < a:
      for yOff in 0'i32 ..< overWater:
        let radius = if isEllipse: radiusEllipse(yOff, overWater, width) else: radiusRound(random, yOff, overWater, width)
        if isEllipse or xo < radius:
          icebergBlock(c, random, ox, oy, oz, overWater, xo, yOff, zo, radius, a, isEllipse, shapeC, angle, snowOnTop, mainBlock)
      inc zo
    inc xo
  icebergSmooth(c, ox, oy, oz, width, overWater, isEllipse, shapeA)
  xo = -a
  while xo < a:
    var zo = -a
    while zo < a:
      var yNeg = 1'i32
      while yNeg < underWater:
        let yOff = -yNeg
        let newA = if isEllipse:
                     let ySq = float32(float64(yOff) * float64(yOff))
                     ceilI(float32(a) * (1.0'f32 - ySq / (float32(underWater) * 8.0'f32)))
                   else: a
        let radius = radiusSteep(random, -yOff, underWater, width)
        if xo < radius:
          icebergBlock(c, random, ox, oy, oz, underWater, xo, yOff, zo, radius, newA, isEllipse, shapeC, angle, snowOnTop, mainBlock)
        inc yNeg
      inc zo
    inc xo
  let doCut = if isEllipse: nextF64(random) > 0.1 else: nextF64(random) > 0.7
  if doCut:
    let signX = if nextBool(random): -1'i32 else: 1'i32
    let signZ = if nextBool(random): -1'i32 else: 1'i32
    var xOff = if nextBool(random): width div 2 + 1 - nextBoundedI32(random, max(width - width div 2 - 1, 1'i32))
               else: nextBoundedI32(random, max(width div 2 - 2, 1'i32))
    var zOff = if nextBool(random): width div 2 + 1 - nextBoundedI32(random, max(width - width div 2 - 1, 1'i32))
               else: nextBoundedI32(random, max(width div 2 - 2, 1'i32))
    if isEllipse:
      let v = nextBoundedI32(random, max(shapeA - 5, 1'i32))
      xOff = v
      zOff = v
    let lx = signX * xOff
    let lz = signZ * zOff
    let cutAngle = if isEllipse: angle + PI / 2.0 else: nextF64(random) * 2.0 * PI
    var yOff = 0'i32
    while yOff < overWater - 3:
      let radius = radiusRound(random, yOff, overWater, width)
      icebergCarve(c, radius, yOff, ox, oy, oz, false, cutAngle, lx, lz, shapeA, shapeC)
      inc yOff
    yOff = -1
    while yOff > -overWater + nextBoundedI32(random, 5):
      let radius = radiusSteep(random, -yOff, overWater, width)
      icebergCarve(c, radius, yOff, ox, oy, oz, true, cutAngle, lx, lz, shapeA, shapeC)
      dec yOff
  true

# --- blue_ice.rs ------------------------------------------------------------------------------------------------------

proc generateBlueIce*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BlueIceFeature::generate`
  if at.y > c.seaLevel - 1:
    return false
  if getState(c, at) != SWater and getState(c, at.down()) != SWater:
    return false
  var found = false
  for dir in AllDirections:
    if dir != BlockDirection.Down and getBlockId(c, offset(at, dir)) == BPackedIce:
      found = true
      break
  if not found:
    return false
  setState(c, at, SBlueIce)
  for i in 0 ..< 200:
    let yOff = nextBoundedI32(random, 5) - nextBoundedI32(random, 6)
    var xz = 3'i32
    if yOff < 2:
      xz += yOff div 2
    if xz >= 1:
      let a = nextBoundedI32(random, xz) - nextBoundedI32(random, xz)
      let b = nextBoundedI32(random, xz) - nextBoundedI32(random, xz)
      let p = at.add(a, yOff, b)
      if outOfHeight(c, p.y):
        continue
      let s = getState(c, p)
      if isAir(s) or s == SWater or s == SPackedIce or s == SIce:
        for dir in AllDirections:
          if getBlockId(c, offset(p, dir)) == BBlueIce:
            setState(c, p, SBlueIce)
            break
  true

# --- freeze_top_layer.rs ----------------------------------------------------------------------------------------------

proc generateFreezeTopLayer*(c: FeatureContext, at: BlockPos): bool =
  ## `FreezeTopLayerFeature::generate`. Vanilla's check for full faces goes through the collision shape, of which a
  ## full top `sideSolid` is what the generated flags hold; block light is 0 during generation.
  for dx in 0'i32 ..< 16'i32:
    for dz in 0'i32 ..< 16'i32:
      let x = at.x + dx
      let z = at.z + dz
      let y = topMotionBlocking(c, x, z)
      let topPos = pos(x, y, z)
      let belowPos = pos(x, y - 1, z)
      let below = getState(c, belowPos)
      let belowId = blockIdOf(below)
      let b = biomeForTerrainGenOf(c.chunk, x, y, z)
      let baseTemp = computeBiomeTemperature(b.id, float64(x), belowPos.y, float64(z), c.seaLevel)
      if baseTemp < 0.15'f32 and belowId == BWater:
        setState(c, belowPos, SIce)
        continue
      let topTemp = computeBiomeTemperature(b.id, float64(x), y, float64(z), c.seaLevel)
      if b.weather.hasPrecipitation and topTemp < 0.15'f32:
        if isAir(getState(c, topPos)) and not isAir(below) and not hasBlockTag(below, TagCannotSupportSnowLayer) and
            (hasBlockTag(below, TagSupportOverrideSnowLayer) or sideSolid(below, BlockDirection.Up) or
             (belowId == BSnow and propValue(below, "layers") == "8")):
          setState(c, topPos, SSnow)
          if hasProp(below, "snowy"):
            setState(c, belowPos, withProp(below, "snowy", "true"))
  true

# --- fill_layer.rs, void_start_platform.rs ----------------------------------------------------------------------------

proc generateFillLayer*(f: ConfiguredFeatureDef, c: FeatureContext, at: BlockPos): bool =
  ## `FillLayerFeature::generate`
  let y = bottomY(c) + f.fillHeight
  for dx in 0'i32 ..< 16'i32:
    for dz in 0'i32 ..< 16'i32:
      let p = pos(at.x + dx, y, at.z + dz)
      if airAt(c, p):
        setState(c, p, f.state)
  true

proc generateVoidStartPlatform*(c: FeatureContext, at: BlockPos): bool =
  ## `VoidStartPlatformFeature::generate`
  let obsidian = stateOfName("obsidian")
  for dx in -1'i32 .. 1'i32:
    for dz in -1'i32 .. 1'i32:
      setState(c, pos(at.x + dx, at.y, at.z + dz), obsidian)
  true

# --- underwater_magma.rs ----------------------------------------------------------------------------------------------

proc magmaValid(c: FeatureContext, t: BlockPos): bool =
  let id = getBlockId(c, t)
  if id == BWater or id == BAir:
    return false
  let bid = getBlockId(c, t.down())
  if bid == BWater or bid == BAir:
    return false
  for dir in HorizontalWorldgen:
    let n = getBlockId(c, offset(t, dir))
    if n == BWater or n == BAir:
      return false
  true

proc generateUnderwaterMagma*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `UnderwaterMagmaFeature::generate`
  var y = at.y
  if getBlockId(c, pos(at.x, y, at.z)) != BWater:
    return false
  var i = 1'i32
  while i < f.floorSearchRange:
    if getBlockId(c, pos(at.x, y, at.z)) != BWater:
      break
    dec y
    inc i
  if getBlockId(c, pos(at.x, y, at.z)) == BWater:
    return false
  result = false
  let r = f.placementRadius
  let magma = defaultStateOf(BMagma)
  var dz = -r
  while dz <= r:
    var dy = -r
    while dy <= r:
      var dx = -r
      while dx <= r:
        if nextF32(random) < f.placementProbability:
          let t = pos(at.x + dx, y + dy, at.z + dz)
          if magmaValid(c, t):
            setState(c, t, magma)
            result = true
        inc dx
      inc dy
    inc dz

# --- basalt ------------------------------------------------------------------------------------------------------------

proc cannotPlaceOn(id: int): bool =
  id == BLava or id == BBedrock or id == BMagma or id == BSoulSand or id == BNetherBricks or id == BNetherBrickFence or
    id == BNetherBrickStairs or id == BNetherWart or id == BChest or id == BSpawner

proc airOrLavaOcean(c: FeatureContext, p: BlockPos): bool =
  let s = getState(c, p)
  isAir(s) or (blockIdOf(s) == BLava and p.y <= c.seaLevel)

proc basaltCanPlaceAt(c: FeatureContext, p: BlockPos): bool =
  if not airOrLavaOcean(c, p):
    return false
  let below = getState(c, p.down())
  not isAir(below) and not cannotPlaceOn(blockIdOf(below))

proc placeBasaltColumn(c: FeatureContext, origin: BlockPos, columnHeight, reach: int32): bool =
  result = false
  var x = origin.x - reach
  while x <= origin.x + reach:
    var z = origin.z - reach
    while z <= origin.z + reach:
      let p = pos(x, origin.y, z)
      let stepLimit = manhattanDistance(p, origin)
      var found = false
      var cursor = p
      var limit = stepLimit
      if airOrLavaOcean(c, p):
        while cursor.y > bottomY(c) + 1 and limit > 0:
          dec limit
          if basaltCanPlaceAt(c, cursor):
            found = true
            break
          cursor = cursor.down()
      else:
        while cursor.y < topY(c) and limit > 0:
          dec limit
          let s = getState(c, cursor)
          if cannotPlaceOn(blockIdOf(s)):
            break
          if isAir(s):
            found = true
            break
          cursor = cursor.up()
      if found:
        var blocksY = columnHeight - stepLimit div 2
        while blocksY >= 0:
          if airOrLavaOcean(c, cursor):
            setState(c, cursor, SBasalt)
            cursor = cursor.up()
            result = true
          else:
            if getBlockId(c, cursor) != BBasalt:
              break
            cursor = cursor.up()
          dec blocksY
      inc z
    inc x

proc generateBasaltColumns*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BasaltColumnsFeature::generate`
  if not basaltCanPlaceAt(c, at):
    return false
  let columnHeight = get(f.columnHeight, random)
  let clustered = nextF32(random) < 0.9'f32
  let spread = min(columnHeight, if clustered: 5'i32 else: 8'i32)
  let count = if clustered: 50 else: 15
  result = false
  for i in 0 ..< count:
    let x = nextInbetweenI32(random, at.x - spread, at.x + spread)
    let z = nextInbetweenI32(random, at.z - spread, at.z + spread)
    let ip = pos(x, at.y, z)
    let blocksY = columnHeight - manhattanDistance(ip, at)
    if blocksY >= 0:
      let inner = get(f.reach, random)
      if placeBasaltColumn(c, ip, blocksY, inner):
        result = true

proc generateBasaltPillar*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BasaltPillarFeature::generate`
  if not airAt(c, at) or airAt(c, at.up()):
    return false
  var cur = at
  var north = true
  var south = true
  var west = true
  var east = true
  proc hangOff(c: FeatureContext, random: var RandomGenerator, p: BlockPos): bool =
    if nextBoundedI32(random, 10) != 0:
      setState(c, p, SBasalt)
      true
    else:
      false
  while airAt(c, cur):
    if outOfHeight(c, cur.y):
      return true
    setState(c, cur, SBasalt)
    north = north and hangOff(c, random, cur.north())
    south = south and hangOff(c, random, cur.south())
    west = west and hangOff(c, random, cur.west())
    east = east and hangOff(c, random, cur.east())
    cur = cur.down()
  cur = cur.up()
  if nextBool(random): setState(c, cur.north(), SBasalt)
  if nextBool(random): setState(c, cur.south(), SBasalt)
  if nextBool(random): setState(c, cur.west(), SBasalt)
  if nextBool(random): setState(c, cur.east(), SBasalt)
  cur = cur.down()
  for dx in -3'i32 ..< 4'i32:
    for dz in -3'i32 ..< 4'i32:
      let probability = abs(dx) * abs(dz)
      if nextBoundedI32(random, 10) < 10 - probability:
        var b = pos(cur.x + dx, cur.y, cur.z + dz)
        var maxDrop = 3'i32
        while airAt(c, b.down()):
          b = b.down()
          dec maxDrop
          if maxDrop <= 0:
            break
        if not airAt(c, b.down()):
          setState(c, b, SBasalt)
  true

proc deltaIsClear(c: FeatureContext, p: BlockPos, contents: BlockStateId): bool =
  let id = getBlockId(c, p)
  if id == blockIdOf(contents):
    return false
  if id == BBedrock or id == BNetherBricks or id == BNetherBrickFence or id == BNetherBrickStairs or id == BNetherWart or
      id == BChest or id == BSpawner:
    return false
  for dir in AllDirections:
    let a = airAt(c, offset(p, dir))
    if (a and dir != BlockDirection.Up) or (not a and dir == BlockDirection.Up):
      return false
  true

proc generateDelta*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `DeltaFeatureFeature::generate`
  result = false
  let spawnRim = nextF64(random) < 0.9
  let rimX = if spawnRim: get(f.rimSize, random) else: 0'i32
  let rimZ = if spawnRim: get(f.rimSize, random) else: 0'i32
  let hasRim = spawnRim and rimX != 0 and rimZ != 0
  let rx = get(f.deltaSize, random)
  let rz = get(f.deltaSize, random)
  let limit = max(rx, rz)
  var it = iterateOutwards(at, rx, 0, rz)
  while true:
    let n = next(it)
    if isNone(n):
      break
    let ip = n.get()
    if manhattanDistance(ip, at) > limit:
      break
    if deltaIsClear(c, ip, f.contents):
      if hasRim:
        result = true
        setState(c, ip, f.rim)
      let po = ip.add(rimX, 0, rimZ)
      if deltaIsClear(c, po, f.contents):
        result = true
        setState(c, po, f.contents)

proc generateGlowstoneBlob*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `GlowstoneBlobFeature::generate`
  if not airAt(c, at):
    return false
  let aboveId = getBlockId(c, at.up())
  if aboveId != BNetherrack and aboveId != BBasalt and aboveId != BBlackstone:
    return false
  let glowstone = defaultStateOf(BGlowstone)
  setState(c, at, glowstone)
  for i in 0 ..< 1500:
    let a = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
    let b = -nextBoundedI32(random, 12)
    let d = nextBoundedI32(random, 8) - nextBoundedI32(random, 8)
    let p = at.add(a, b, d)
    if airAt(c, p):
      var neighbours = 0
      for dir in AllDirections:
        if getBlockId(c, offset(p, dir)) == BGlowstone:
          inc neighbours
        if neighbours > 1:
          break
      if neighbours == 1:
        setState(c, p, glowstone)
  true

# --- spring_feature.rs ------------------------------------------------------------------------------------------------

proc validContains(valid: seq[string], s: BlockStateId): bool =
  let name = blockNameOfState(s)
  for i in 0 ..< valid.len:
    if valid[i] == name:
      return true
  false

proc generateSpring*(f: ConfiguredFeatureDef, c: FeatureContext, at: BlockPos): bool =
  ## `SpringFeatureFeature::generate`
  if not validContains(f.validBlocks, getState(c, at.up())):
    return false
  if f.requiresBlockBelow and not validContains(f.validBlocks, getState(c, at.down())):
    return false
  let s = getState(c, at)
  if not isAir(s) and not validContains(f.validBlocks, s):
    return false
  var valid = 0'i32
  var air = 0'i32
  for dir in [BlockDirection.West, BlockDirection.East, BlockDirection.North, BlockDirection.South, BlockDirection.Down]:
    let n = getState(c, offset(at, dir))
    if validContains(f.validBlocks, n):
      inc valid
    if isAir(n):
      inc air
  if valid == f.rockCount and air == f.holeCount:
    setState(c, at, f.state)
    return true
  false

# --- monster_room.rs --------------------------------------------------------------------------------------------------

const DungeonMobs = ["minecraft:skeleton", "minecraft:zombie", "minecraft:zombie", "minecraft:spider"]

proc addEntity(c: FeatureContext, p: BlockPos, nbt: NbtCompound) =
  putBlockEntity(c.chunk, p.vec, nbt)

proc chestFacing(c: FeatureContext, p: BlockPos): string =
  ## `StructurePiece::reorient`: the first horizontal side with no solid block, preferring the opposite of a solid one.
  var facing = BlockDirection.North
  var solidFound = false
  for dir in HorizontalWorldgen:
    if isSolidBlock(getState(c, offset(p, dir))):
      if solidFound:
        facing = BlockDirection.North
        break
      facing = opposite(dir)
      solidFound = true
  case facing
  of BlockDirection.South: "south"
  of BlockDirection.West: "west"
  of BlockDirection.East: "east"
  else: "north"

proc generateMonsterRoom*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `DungeonFeature::generate`
  let xr = nextBoundedI32(random, 2) + 2
  let zr = nextBoundedI32(random, 2) + 2
  let minX = -xr - 1
  let maxX = xr + 1
  let minZ = -zr - 1
  let maxZ = zr + 1
  var holeCount = 0'i32
  var dx = minX
  while dx <= maxX:
    var dy = -1'i32
    while dy <= 4:
      var dz = minZ
      while dz <= maxZ:
        let p = at.add(dx, dy, dz)
        let solid = isSolid(getState(c, p))
        if dy == -1 and not solid:
          return false
        if dy == 4 and not solid:
          return false
        if (dx == minX or dx == maxX or dz == minZ or dz == maxZ) and dy == 0 and airAt(c, p) and airAt(c, p.up()):
          inc holeCount
        inc dz
      inc dy
    inc dx
  if holeCount < 1 or holeCount > 5:
    return false
  let mossy = stateOfName("mossy_cobblestone")
  let cobble = stateOfName("cobblestone")
  dx = minX
  while dx <= maxX:
    var dy = 3'i32
    while dy >= -1:
      var dz = minZ
      while dz <= maxZ:
        let wall = at.add(dx, dy, dz)
        if dx == minX or dy == -1 or dz == minZ or dx == maxX or dy == 4 or dz == maxZ:
          let belowSolid = isSolid(getState(c, wall.down()))
          let cur = getState(c, wall)
          if wall.y >= bottomY(c) and not belowSolid:
            setState(c, wall, SCaveAir)
          elif isSolid(cur) and blockIdOf(cur) != BChest:
            if dy == -1 and nextBoundedI32(random, 4) != 0:
              setState(c, wall, mossy)
            else:
              setState(c, wall, cobble)
        else:
          let id = getBlockId(c, wall)
          if id != BChest and id != BSpawner:
            setState(c, wall, SCaveAir)
        inc dz
      dec dy
    inc dx
  for a in 0 ..< 2:
    for b in 0 ..< 3:
      let cx = at.x + nextBoundedI32(random, xr * 2 + 1) - xr
      let cz = at.z + nextBoundedI32(random, zr * 2 + 1) - zr
      let chest = pos(cx, at.y, cz)
      if not airAt(c, chest):
        continue
      var wallCount = 0
      for dir in HorizontalWorldgen:
        if isSolid(getState(c, offset(chest, dir))):
          inc wallCount
      if wallCount == 1:
        setState(c, chest, stateWith(BChest, [(name: "facing", value: chestFacing(c, chest))]))
        let seed = nextI64(random)
        var nbt = newCompound()
        putString(nbt, "id", "minecraft:chest")
        putInt(nbt, "x", chest.x)
        putInt(nbt, "y", chest.y)
        putInt(nbt, "z", chest.z)
        putString(nbt, "LootTable", "minecraft:chests/simple_dungeon")
        putLong(nbt, "LootTableSeed", seed)
        addEntity(c, chest, nbt)
        break
  let mob = DungeonMobs[int(nextBoundedI32(random, 4))]
  setState(c, at, defaultStateOf(BSpawner))
  var inner = newCompound()
  putString(inner, "id", mob)
  var spawnEntry = newCompound()
  putCompound(spawnEntry, "entity", inner)
  var nbt = newCompound()
  putString(nbt, "id", "minecraft:mob_spawner")
  putInt(nbt, "x", at.x)
  putInt(nbt, "y", at.y)
  putInt(nbt, "z", at.z)
  putCompound(nbt, "SpawnData", spawnEntry)
  addEntity(c, at, nbt)
  true

# --- desert_well.rs ---------------------------------------------------------------------------------------------------

proc generateDesertWell*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `DesertWellFeature::generate`
  var p = at.up()
  while airAt(c, p) and p.y > bottomY(c) + 2:
    p = p.down()
  if getBlockId(c, p) != BSand:
    return false
  for i in -2'i32 .. 2'i32:
    for j in -2'i32 .. 2'i32:
      if airAt(c, p.add(i, -1, j)) and airAt(c, p.add(i, -2, j)):
        return false
  let wall = stateOfName("sandstone")
  let slab = stateOfName("sandstone_slab")
  let sand = defaultStateOf(BSand)
  for i in -2'i32 .. 0'i32:
    for j in -2'i32 .. 2'i32:
      for k in -2'i32 .. 2'i32:
        setState(c, p.add(j, i, k), wall)
  setState(c, p, SWater)
  for dir in HorizontalWorldgen:
    setState(c, offset(p, dir), SWater)
  let p2 = p.add(0, -1, 0)
  setState(c, p2, sand)
  for dir in HorizontalWorldgen:
    setState(c, offset(p2, dir), sand)
  for j in -2'i32 .. 2'i32:
    for k in -2'i32 .. 2'i32:
      if j == -2 or j == 2 or k == -2 or k == 2:
        setState(c, p.add(j, 1, k), wall)
  setState(c, p.add(2, 1, 0), slab)
  setState(c, p.add(-2, 1, 0), slab)
  setState(c, p.add(0, 1, 2), slab)
  setState(c, p.add(0, 1, -2), slab)
  for j in -1'i32 .. 1'i32:
    for k in -1'i32 .. 1'i32:
      setState(c, p.add(j, 4, k), if j == 0 and k == 0: wall else: slab)
  for j in 1'i32 .. 3'i32:
    setState(c, p.add(-1, j, -1), wall)
    setState(c, p.add(-1, j, 1), wall)
    setState(c, p.add(1, j, -1), wall)
    setState(c, p.add(1, j, 1), wall)
  let wc = [p, p.add(1, 0, 0), p.add(0, 0, 1), p.add(-1, 0, 0), p.add(0, 0, -1)]
  let pos1 = wc[int(nextBoundedI32(random, 5))].add(0, -1, 0)
  let pos2 = wc[int(nextBoundedI32(random, 5))].add(0, -2, 0)
  let sus = stateOfName("suspicious_sand")
  for sp in [pos1, pos2]:
    setState(c, sp, sus)
    var nbt = newCompound()
    putString(nbt, "id", "minecraft:brushable_block")
    putInt(nbt, "x", sp.x)
    putInt(nbt, "y", sp.y)
    putInt(nbt, "z", sp.z)
    putString(nbt, "LootTable", "minecraft:archaeology/desert_well")
    putLong(nbt, "LootTableSeed", asLong(sp))
    addEntity(c, sp, nbt)
  true

# --- bonus_chest.rs ---------------------------------------------------------------------------------------------------

proc generateBonusChest*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BonusChestFeature::generate`
  let cx = (at.x shr 4) shl 4
  let cz = (at.z shr 4) shl 4
  var xs = newSeq[int32](0)
  var zs = newSeq[int32](0)
  for i in 0'i32 .. 15'i32:
    xs.add(cx + i)
    zs.add(cz + i)
  shuffle(xs, random)
  shuffle(zs, random)
  for xi in 0 ..< xs.len:
    for zi in 0 ..< zs.len:
      let y = topY(c, MotionBlockingNoLeaves, xs[xi], zs[zi])
      let chest = pos(xs[xi], y, zs[zi])
      if airAt(c, chest):
        setState(c, chest, defaultStateOf(BChest))
        let seed = nextI64(random)
        var nbt = newCompound()
        putString(nbt, "id", "minecraft:chest")
        putInt(nbt, "x", chest.x)
        putInt(nbt, "y", chest.y)
        putInt(nbt, "z", chest.z)
        putString(nbt, "LootTable", "minecraft:chests/spawn_bonus_chest")
        putLong(nbt, "LootTableSeed", seed)
        addEntity(c, chest, nbt)
        for dir in HorizontalWorldgen:
          let t = offset(chest, dir)
          if not airAt(c, t.down()) and airAt(c, t):
            setState(c, t, stateOfName("torch"))
        return true
  false

# --- block_pile.rs ----------------------------------------------------------------------------------------------------

proc generateBlockPile*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `BlockPileFeature::generate`, the newer checkout's: the pinned tree has only the struct.
  if at.y < bottomY(c) + 5:
    return false
  let xr = 2 + nextBoundedI32(random, 2)
  let zr = 2 + nextBoundedI32(random, 2)
  var z = at.z - zr
  while z <= at.z + zr:
    var y = at.y
    while y <= at.y + 1:
      var x = at.x - xr
      while x <= at.x + xr:
        let p = pos(x, y, z)
        let xd = at.x - x
        let zd = at.z - z
        let a = nextF32(random) * 10.0'f32
        let b = nextF32(random) * 6.0'f32
        if float32(xd * xd + zd * zd) <= a - b or nextF32(random) < 0.031'f32:
          if airAt(c, p):
            let below = getState(c, p.down())
            let may = if blockIdOf(below) == BDirtPath: nextBool(random) else: sideSolid(below, BlockDirection.Up)
            if may:
              setState(c, p, get(f.stateProvider, random, p, c.chunk, c.blockRegistry))
        inc x
      inc y
    inc z
  true

# --- fallen_tree.rs ---------------------------------------------------------------------------------------------------

proc overSolidGround(c: FeatureContext, p: BlockPos): bool =
  sideSolid(getState(c, p.down()), BlockDirection.Up)

proc generateFallenTree*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `FallenTreeFeature::generate`, the newer checkout's: the pinned tree returns false.
  setState(c, at, get(f.stateProvider, random, at, c.chunk, c.blockRegistry))
  let empty = newSeq[BlockPos](0)
  var decos = newSeq[BlockPos](0)
  for i in 0 ..< f.stumpDecorators.len:
    generateDecorator(f.stumpDecorators[i], c, random, empty, @[at], empty, decos)
  let direction = randomHorizontal(random)
  let logLength = get(f.logLength, random) - 2
  var start = offsetN(at, direction, 2 + nextBoundedI32(random, 2))
  start = start.up()
  for i in 0 ..< 6:
    if canReplace(getState(c, start)) and overSolidGround(c, start):
      break
    start = start.down()
  var gap = 0
  var ok = true
  var cur = start
  for i in 0'i32 ..< logLength:
    if not canReplace(getState(c, cur)):
      ok = false
      break
    if overSolidGround(c, cur):
      gap = 0
    else:
      inc gap
      if gap > 2:
        ok = false
        break
    cur = offset(cur, direction)
  if ok:
    let axis = if direction == BlockDirection.East or direction == BlockDirection.West: "x" else: "z"
    var fallen = newJavaBlockPosHashSet()
    cur = start
    for i in 0'i32 ..< logLength:
      let s = get(f.stateProvider, random, cur, c.chunk, c.blockRegistry)
      setState(c, cur, withProp(s, "axis", axis))
      fallen.incl(cur)
      cur = offset(cur, direction)
    let logs = toSeq(fallen)
    for i in 0 ..< f.logDecorators.len:
      generateDecorator(f.logDecorators[i], c, random, empty, logs, empty, decos)
  true

# --- fossil.rs --------------------------------------------------------------------------------------------------------

proc fossilIntegrity(p: FossilProcessor): float32 =
  case p
  of FossilProcessor.FossilRot: 0.9'f32
  of FossilProcessor.Coal, FossilProcessor.Diamonds: 0.1'f32

proc placeFossilTemplate(c: FeatureContext, t: StructureTemplate, ox, oy, oz: int32, rotation: Rotation, processor: FossilProcessor, random: var RandomGenerator,
                         minX, minY, minZ, maxX, maxY, maxZ: int32) =
  for bi in 0 ..< t.blocks.len:
    let local = rotation.transformPos(t.blocks[bi].pos, t.size)
    let wx = ox + local.x
    let wy = oy + local.y
    let wz = oz + local.z
    if wx < minX or wx > maxX or wy < minY or wy > maxY or wz < minZ or wz > maxZ or nextF32(random) > fossilIntegrity(processor):
      continue
    let at = pos(wx, wy, wz)
    if hasBlockTag(getState(c, at), TagFeaturesCannotReplace):
      continue
    let entry = t.palette[int(t.blocks[bi].state)]
    if entry.name == "minecraft:structure_void":
      continue
    let (ok, s) = resolve(entry, rotation, Mirror.None)
    if ok:
      if processor == FossilProcessor.Diamonds and blockIdOf(s) == BCoalOre:
        setState(c, at, stateOfName("deepslate_diamond_ore"))
      else:
        setState(c, at, s)

proc generateFossil*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `FossilFeature::generate`
  if f.fossilStructures.len == 0 or f.fossilStructures.len != f.overlayStructures.len:
    return false
  let rotation = Rotation.fromIndex(uint8(nextBoundedI32(random, 4)))
  let index = int(nextBoundedI32(random, int32(f.fossilStructures.len)))
  let fossil = getTemplate(f.fossilStructures[index])
  let overlay = getTemplate(f.overlayStructures[index])
  if fossil == nil or overlay == nil:
    return false
  let rs = rotation.transformSize(fossil.size)
  let ox = at.x - rs.x div 2
  let oz = at.z - rs.z div 2
  var floorY = at.y
  var x = ox
  while x < ox + rs.x:
    var z = oz
    while z < oz + rs.z:
      floorY = min(floorY, topY(c, OceanFloorWg, x, z))
      inc z
    inc x
  let oy = max(floorY - 15 - nextBoundedI32(random, 10), int32(c.minY) + 10)
  var emptyCorners = 0'i32
  for cx in [ox, ox + rs.x - 1]:
    for cy in [oy, oy + rs.y - 1]:
      for cz in [oz, oz + rs.z - 1]:
        let s = getState(c, pos(cx, cy, cz))
        let id = blockIdOf(s)
        if isAir(s) or id == BLava or id == BWater:
          inc emptyCorners
  if emptyCorners > f.maxEmptyCornersAllowed:
    return false
  let cmx = (at.x shr 4) shl 4
  let cmz = (at.z shr 4) shl 4
  let bminY = int32(c.minY)
  let bmaxY = int32(c.minY) + int32(c.height) - 1
  placeFossilTemplate(c, fossil, ox, oy, oz, rotation, f.fossilProcessor, random, cmx - 16, bminY, cmz - 16, cmx + 31, bmaxY, cmz + 31)
  placeFossilTemplate(c, overlay, ox, oy, oz, rotation, f.overlayProcessor, random, cmx - 16, bminY, cmz - 16, cmx + 31, bmaxY, cmz + 31)
  true

# --- The End -----------------------------------------------------------------------------------------------------------

proc generateEndGateway*(f: ConfiguredFeatureDef, c: FeatureContext, at: BlockPos): bool =
  ## `EndGatewayFeature::generate`
  let gateway = stateOfName("end_gateway")
  let bedrock = defaultStateOf(BBedrock)
  for dx in -1'i32 .. 1'i32:
    for dy in -2'i32 .. 2'i32:
      for dz in -1'i32 .. 1'i32:
        let sameX = dx == 0
        let sameY = dy == 0
        let sameZ = dz == 0
        let isEnd = abs(dy) == 2
        let t = pos(at.x + dx, at.y + dy, at.z + dz)
        if sameX and sameY and sameZ:
          setState(c, t, gateway)
          if f.hasExit:
            var exitNbt = newCompound()
            putInt(exitNbt, "X", f.exit.x)
            putInt(exitNbt, "Y", f.exit.y)
            putInt(exitNbt, "Z", f.exit.z)
            var nbt = newCompound()
            putString(nbt, "id", "minecraft:end_gateway")
            putInt(nbt, "x", t.x)
            putInt(nbt, "y", t.y)
            putInt(nbt, "z", t.z)
            putLong(nbt, "Age", 0'i64)
            putBool(nbt, "ExactTeleport", f.exact)
            putCompound(nbt, "ExitPortal", exitNbt)
            addEntity(c, t, nbt)
        elif sameY:
          setState(c, t, SAir)
        elif (isEnd and sameX and sameZ) or ((sameX or sameZ) and not isEnd):
          setState(c, t, bedrock)
        else:
          setState(c, t, SAir)
  true

proc generateEndIsland*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `EndIslandFeature::generate`
  var size = float32(nextBoundedI32(random, 3)) + 4.0'f32
  var dy = 0'i32
  let endStone = stateOfName("end_stone")
  while size > 0.5'f32:
    let start = int32(floor(-size))
    let stop = int32(ceil(size))
    let rq = (size + 1.0'f32) * (size + 1.0'f32)
    var dx = start
    while dx <= stop:
      var dz = start
      while dz <= stop:
        if float32(dx * dx + dz * dz) <= rq:
          setState(c, pos(at.x + dx, at.y + dy, at.z + dz), endStone)
        inc dz
      inc dx
    size -= float32(nextBoundedI32(random, 2)) + 0.5'f32
    dec dy
  true

proc generateEndPlatform*(c: FeatureContext, at: BlockPos): bool =
  ## `EndPlatformFeature::generate`
  let obsidian = stateOfName("obsidian")
  for dx in -2'i32 .. 2'i32:
    for dz in -2'i32 .. 2'i32:
      for dy in -1'i32 ..< 3'i32:
        setState(c, pos(at.x + dx, at.y + dy, at.z + dz), if dy == -1: obsidian else: SAir)
  true

# `JavaRandom` of the newer checkout's end_spike.rs: the `java.util.Random` vanilla seeds per world.

proc jrNext(seed: var uint64, bits: int): int32 =
  seed = (seed * 0x5DEECE66D'u64 + 0xB'u64) and ((1'u64 shl 48) - 1'u64)
  cast[int32](uint32((seed shr (48 - bits)) and 0xFFFFFFFF'u64))

proc jrNextI32(seed: var uint64, bound: int32): int32 =
  if (bound and (bound - 1)) == 0:
    return int32((int64(bound) * int64(jrNext(seed, 31))) shr 31)
  var bits = jrNext(seed, 31)
  var val = bits mod bound
  while cast[int32](cast[uint32](bits) - cast[uint32](val) + cast[uint32](bound - 1)) < 0:
    bits = jrNext(seed, 31)
    val = bits mod bound
  val

proc spikesForSeed(seed: uint64): seq[Spike] =
  ## `EndSpikeFeature::get_spikes_for_seed`
  var js = (seed xor 0x5DEECE66D'u64) and ((1'u64 shl 48) - 1'u64)
  let hi = int64(jrNext(js, 32))
  let lo = int64(jrNext(js, 32))
  let key = cast[uint64](cast[int64](cast[uint64](hi) shl 32) + lo) and 65535'u64
  var ks = (key xor 0x5DEECE66D'u64) and ((1'u64 shl 48) - 1'u64)
  var sizes = @[0'i32, 1, 2, 3, 4, 5, 6, 7, 8, 9]
  var i = 9
  while i >= 1:
    let j = int(jrNextI32(ks, int32(i) + 1))
    let a = sizes[i]
    let b = sizes[j]
    sizes[i] = b
    sizes[j] = a
    dec i
  result = newSeq[Spike](0)
  for k in 0 ..< 10:
    let angle = 2.0 * (-PI + (PI / 10.0) * float64(k))
    let size = sizes[k]
    result.add(Spike(centerX: int32(floor(42.0 * cos(angle))), centerZ: int32(floor(42.0 * sin(angle))),
      radius: 2 + size div 3, height: 76 + size * 3, guarded: size == 1 or size == 2))

proc genSpike(c: FeatureContext, s: Spike) =
  let r = s.radius
  let obsidian = stateOfName("obsidian")
  # `BlockPos::iterate`: x fastest, then y, then z.
  var z = s.centerZ - r
  while z <= s.centerZ + r:
    var y = bottomY(c)
    while y <= s.height + 10:
      var x = s.centerX - r
      while x <= s.centerX + r:
        let dx = x - s.centerX
        let dz = z - s.centerZ
        if dx * dx + dz * dz <= r * r + 1 and y < s.height:
          setState(c, pos(x, y, z), obsidian)
        elif y > 65:
          setState(c, pos(x, y, z), SAir)
        inc x
      inc y
    inc z
  setState(c, pos(s.centerX, s.height, s.centerZ), defaultStateOf(BBedrock))
  setState(c, pos(s.centerX, s.height + 1, s.centerZ), stateOfName("fire"))
  if s.guarded:
    let bars = blockIdOfName("iron_bars")
    for dy in 0'i32 .. 3'i32:
      for dx in -2'i32 .. 2'i32:
        for dz in -2'i32 .. 2'i32:
          let xWall = abs(dx) == 2
          let zWall = abs(dz) == 2
          let onTop = dy == 3
          if not xWall and not zWall and not onTop:
            continue
          let xEdge = xWall or onTop
          let zEdge = zWall or onTop
          setState(c, pos(s.centerX + dx, s.height + dy, s.centerZ + dz), stateWith(bars, [
            (name: "north", value: boolStr(xEdge and dz != -2)), (name: "south", value: boolStr(xEdge and dz != 2)),
            (name: "west", value: boolStr(zEdge and dx != -2)), (name: "east", value: boolStr(zEdge and dx != 2))]))

proc generateEndSpike*(f: ConfiguredFeatureDef, c: FeatureContext, at: BlockPos): bool =
  ## `EndSpikeFeature::generate`
  let spikes = if f.spikes.len == 0: spikesForSeed(cast[uint64](c.worldSeed)) else: f.spikes
  for i in 0 ..< spikes.len:
    if (at.x shr 4) == (spikes[i].centerX shr 4) and (at.z shr 4) == (spikes[i].centerZ shr 4):
      genSpike(c, spikes[i])
  true

# --- chorus_plant.rs --------------------------------------------------------------------------------------------------

proc chorusConnects(id: int): bool {.inline.} = id == BChorusPlant or id == BChorusFlower

proc setChorusPlant(c: FeatureContext, p: BlockPos) =
  let downId = getBlockId(c, p.down())
  setState(c, p, stateWith(BChorusPlant, [
    (name: "down", value: boolStr(chorusConnects(downId) or hasBlockTag(getState(c, p.down()), TagSupportsChorusPlant))),
    (name: "up", value: boolStr(chorusConnects(getBlockId(c, p.up())))),
    (name: "north", value: boolStr(chorusConnects(getBlockId(c, p.north())))),
    (name: "east", value: boolStr(chorusConnects(getBlockId(c, p.east())))),
    (name: "south", value: boolStr(chorusConnects(getBlockId(c, p.south())))),
    (name: "west", value: boolStr(chorusConnects(getBlockId(c, p.west()))))]))

proc chorusNeighborsEmpty(c: FeatureContext, p: BlockPos, ignore: BlockDirection, hasIgnore: bool): bool =
  for dir in HorizontalWorldgen:
    if hasIgnore and dir == ignore:
      continue
    if not airAt(c, offset(p, dir)):
      return false
  true

proc growChorus(c: FeatureContext, random: var RandomGenerator, current, start: BlockPos, spread, depth: int32) =
  var height = nextBoundedI32(random, 4) + 1
  if depth == 0:
    inc height
  for i in 0'i32 ..< height:
    let t = current.upHeight(i + 1)
    if not chorusNeighborsEmpty(c, t, BlockDirection.North, false):
      return
    setChorusPlant(c, t)
    setChorusPlant(c, t.down())
  let top = current.upHeight(height)
  var placedStem = false
  if depth < 4:
    var stems = nextBoundedI32(random, 4)
    if depth == 0:
      inc stems
    for i in 0'i32 ..< stems:
      let dir = randomHorizontal(random)
      let t = offset(top, dir)
      if abs(t.x - start.x) < spread and abs(t.z - start.z) < spread and airAt(c, t) and airAt(c, t.down()) and
          chorusNeighborsEmpty(c, t, opposite(dir), true):
        placedStem = true
        setChorusPlant(c, t)
        setChorusPlant(c, top)
        growChorus(c, random, t, start, spread, depth + 1)
  if not placedStem:
    setState(c, top, stateWith(BChorusFlower, [(name: "age", value: "5")]))

proc generateChorusPlant*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `ChorusPlantFeature::generate`
  if not airAt(c, at) or not hasBlockTag(getState(c, at.down()), TagSupportsChorusPlant):
    return false
  setChorusPlant(c, at)
  growChorus(c, random, at, at, 8, 0)
  true
