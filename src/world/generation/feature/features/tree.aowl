## Port of pumpkin-world/src/generation/feature/features/tree/mod.rs, its decorators
## (pumpkin-world/src/generation/feature/features/tree/decorator/mod.rs, pumpkin-world/src/generation/feature/features/tree/decorator/alter_ground.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/attached_to_leaves.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/attached_to_logs.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/beehive.rs, pumpkin-world/src/generation/feature/features/tree/decorator/cocoa.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/creaking_heart.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/leave_vine.rs, pumpkin-world/src/generation/feature/features/tree/decorator/pale_moss.rs,
## pumpkin-world/src/generation/feature/features/tree/decorator/place_on_ground.rs, pumpkin-world/src/generation/feature/features/tree/decorator/trunk_vine.rs),
## its foliage placers (pumpkin-world/src/generation/feature/features/tree/foliage/mod.rs, pumpkin-world/src/generation/feature/features/tree/foliage/acacia.rs,
## pumpkin-world/src/generation/feature/features/tree/foliage/blob.rs, pumpkin-world/src/generation/feature/features/tree/foliage/bush.rs,
## pumpkin-world/src/generation/feature/features/tree/foliage/cherry.rs, pumpkin-world/src/generation/feature/features/tree/foliage/dark_oak.rs,
## pumpkin-world/src/generation/feature/features/tree/foliage/fancy.rs, pumpkin-world/src/generation/feature/features/tree/foliage/jungle.rs,
## pumpkin-world/src/generation/feature/features/tree/foliage/mega_pine.rs, pumpkin-world/src/generation/feature/features/tree/foliage/pine.rs,
## pumpkin-world/src/generation/feature/features/tree/foliage/random_spread.rs, pumpkin-world/src/generation/feature/features/tree/foliage/spruce.rs),
## its trunk placers (pumpkin-world/src/generation/feature/features/tree/trunk/mod.rs, pumpkin-world/src/generation/feature/features/tree/trunk/bending.rs,
## pumpkin-world/src/generation/feature/features/tree/trunk/cherry.rs, pumpkin-world/src/generation/feature/features/tree/trunk/dark_oak.rs,
## pumpkin-world/src/generation/feature/features/tree/trunk/fancy.rs, pumpkin-world/src/generation/feature/features/tree/trunk/forking.rs,
## pumpkin-world/src/generation/feature/features/tree/trunk/giant.rs, pumpkin-world/src/generation/feature/features/tree/trunk/mega_jungle.rs,
## pumpkin-world/src/generation/feature/features/tree/trunk/straight.rs, pumpkin-world/src/generation/feature/features/tree/trunk/upwards_branching.rs)
## and pumpkin-world/src/generation/feature/features/tree/root/mod.rs, pumpkin-world/src/generation/feature/features/tree/root/mangrove.rs
##
## Logic as the newer checkout (../ref/pumpkin) has it: the pinned tree draws the foliage's height and radius after the
## trunk, stubs most decorators, and hands decorators positions in `Vec` order. `update_leaves` and `update_shape_at_edge`
## are here because vines dropped by it change blocks.

{.feature: "lenientnils".}

import std/math
import ../types
import ../common

let
  TagLogs = blockTag("logs")
  TagReplaceableByTrees = blockTag("replaceable_by_trees")
  TagLeaves = blockTag("leaves")
  TagPreventsNearbyLeafDecay = blockTag("prevents_nearby_leaf_decay")
  BCreakingHeart = blockIdOfName("creaking_heart")
  BBeeNest = blockIdOfName("bee_nest")
  BCocoa = blockIdOfName("cocoa")
  BPaleHangingMoss = blockIdOfName("pale_hanging_moss")

proc canReplace*(state: BlockStateId): bool {.inline.} =
  ## `TreeFeature::can_replace`
  isAir(state) or hasBlockTag(state, TagReplaceableByTrees)

proc canReplaceOrLog*(state: BlockStateId): bool {.inline.} =
  canReplace(state) or hasBlockTag(state, TagLogs)

proc isAirOrLeaves(state: BlockStateId): bool {.inline.} =
  isAir(state) or hasBlockTag(state, TagLeaves)

proc containsId(ids: seq[uint16], id: int): bool =
  for x in ids:
    if int(x) == id:
      return true
  false

proc providerGet(p: BlockStateProvider, c: FeatureContext, random: var RandomGenerator, at: BlockPos): BlockStateId {.inline.} =
  get(p, random, at, c.chunk, c.blockRegistry)

# --- TrunkPlacer ------------------------------------------------------------------------------------------------------

proc setDirt(c: FeatureContext, random: var RandomGenerator, at: BlockPos, below: BlockStateProvider): bool =
  ## `TrunkPlacer::set_dirt`
  let o = getOptional(below, c.blockRegistry, c.chunk, random, at)
  if o.hasState:
    setState(c, at, o.state)
  o.hasState

proc place(c: FeatureContext, at: BlockPos, trunk: BlockStateId): bool =
  ## `TrunkPlacer::place`
  if canReplace(getState(c, at)):
    setState(c, at, trunk)
    return true
  false

proc tryPlace(c: FeatureContext, at: BlockPos, trunk: BlockStateId): bool =
  ## `TrunkPlacer::try_place`
  if canReplaceOrLog(getState(c, at)):
    return place(c, at, trunk)
  false

type TrunkResult = object
  nodes: seq[TreeNode]
  logs: seq[BlockPos]

proc node(center: BlockPos, foliageRadius = 0'i32, giant = false): TreeNode {.inline.} =
  TreeNode(center: center, foliageRadius: foliageRadius, giantTrunk: giant)

proc straightTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                   trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  if setDirt(c, random, start.down(), below):
    result.logs.add(start.down())
  for i in 0'i32 ..< height:
    let p = start.upHeight(i)
    if place(c, p, trunk):
      result.logs.add(p)
  result.nodes.add(node(start.upHeight(height)))

proc forkingTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                  trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  if setDirt(c, random, start.down(), below):
    result.logs.add(start.down())
  let leanDirection = randomHorizontal(random)
  let leanHeight = height - nextBoundedI32(random, 4) - 1
  var leanSteps = 3 - nextBoundedI32(random, 3)
  var tx = start.x
  var tz = start.z
  var hasLast = false
  var lastY = 0'i32
  for yo in 0'i32 ..< height:
    let yy = start.y + yo
    if yo >= leanHeight and leanSteps > 0:
      let o = toOffset(leanDirection)
      tx += o.x
      tz += o.z
      dec leanSteps
    let p = pos(tx, yy, tz)
    if place(c, p, trunk):
      result.logs.add(p)
      hasLast = true
      lastY = yy + 1
  if hasLast:
    result.nodes.add(node(pos(tx, lastY, tz), 1'i32))
  var bx = start.x
  var bz = start.z
  let branchDirection = randomHorizontal(random)
  if branchDirection != leanDirection:
    let branchPos = leanHeight - nextBoundedI32(random, 2) - 1
    var branchSteps = 1 + nextBoundedI32(random, 3)
    var bHas = false
    var bLast = 0'i32
    var yo = branchPos
    while yo < height and branchSteps > 0:
      if yo >= 1:
        let yyx = start.y + yo
        let o = toOffset(branchDirection)
        bx += o.x
        bz += o.z
        let p = pos(bx, yyx, bz)
        if place(c, p, trunk):
          result.logs.add(p)
          bHas = true
          bLast = yyx + 1
      inc yo
      dec branchSteps
    if bHas:
      result.nodes.add(node(pos(bx, bLast, bz)))

proc giantTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  let b = start.down()
  if setDirt(c, random, b, below): result.logs.add(b)
  if setDirt(c, random, b.east(), below): result.logs.add(b.east())
  if setDirt(c, random, b.south(), below): result.logs.add(b.south())
  if setDirt(c, random, b.south().east(), below): result.logs.add(b.south().east())
  for y in 0'i32 ..< height:
    let l = start.upHeight(y)
    if tryPlace(c, l, trunk): result.logs.add(l)
    if y >= height - 1:
      continue
    let le = start.east().upHeight(y)
    if tryPlace(c, le, trunk): result.logs.add(le)
    let lse = start.east().south().upHeight(y)
    if tryPlace(c, lse, trunk): result.logs.add(lse)
    let ls = start.south().upHeight(y)
    if tryPlace(c, ls, trunk): result.logs.add(ls)
  result.nodes.add(node(start.upHeight(height), 0'i32, true))

proc megaJungleTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                     trunk: BlockStateId): TrunkResult =
  result = giantTrunk(c, random, height, start, below, trunk)
  var i = height - 2 - nextBoundedI32(random, 4)
  var jv = 0'i32
  var kv = 0'i32
  while i > height div 2:
    let f = nextF32(random) * float32(PI * 2.0)
    for l in 0'i32 ..< 5'i32:
      jv = int32(1.5'f32 + mthCos(f) * float32(l))
      kv = int32(1.5'f32 + mthSin(f) * float32(l))
      let p = start.add(jv, i - 3 + l div 2, kv)
      if place(c, p, trunk):
        result.logs.add(p)
    result.nodes.add(node(start.add(jv, i, kv), -2'i32))
    i -= 2 + nextBoundedI32(random, 4)

proc darkOakTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                  trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  let b = start.down()
  if setDirt(c, random, b, below): result.logs.add(b)
  if setDirt(c, random, b.east(), below): result.logs.add(b.east())
  if setDirt(c, random, b.south(), below): result.logs.add(b.south())
  if setDirt(c, random, b.south().east(), below): result.logs.add(b.south().east())
  let leanDirection = randomHorizontal(random)
  let leanHeight = height - nextBoundedI32(random, 4)
  var leanSteps = 2 - nextBoundedI32(random, 3)
  var tx = start.x
  var tz = start.z
  let ey = start.y + height - 1
  for dy in 0'i32 ..< height:
    if dy >= leanHeight and leanSteps > 0:
      let o = toOffset(leanDirection)
      tx += o.x
      tz += o.z
      dec leanSteps
    let p = pos(tx, start.y + dy, tz)
    if isAirOrLeaves(getState(c, p)):
      if tryPlace(c, p, trunk): result.logs.add(p)
      if tryPlace(c, p.east(), trunk): result.logs.add(p.east())
      if tryPlace(c, p.south(), trunk): result.logs.add(p.south())
      if tryPlace(c, p.east().south(), trunk): result.logs.add(p.east().south())
  result.nodes.add(node(pos(tx, ey, tz), 0'i32, true))
  for ox in -1'i32 .. 2'i32:
    for oz in -1'i32 .. 2'i32:
      if (not (ox >= 0 and ox <= 1) or not (oz >= 0 and oz <= 1)) and nextBoundedI32(random, 3) <= 0:
        let length = nextBoundedI32(random, 3) + 2
        for by in 0'i32 ..< length:
          let p = pos(start.x + ox, ey - by - 1, start.z + oz)
          if tryPlace(c, p, trunk): result.logs.add(p)
        result.nodes.add(node(pos(start.x + ox, ey, start.z + oz)))

type BranchPosition = object
  pos: BlockPos
  endY: int32

proc longestSide(o: Vector3[int32]): int32 =
  max(abs(o.x), max(abs(o.y), abs(o.z)))

proc logAxis(a, b: Vector3[int32]): string =
  let x = abs(b.x - a.x)
  let z = abs(b.z - a.z)
  let m = max(x, z)
  if m > 0:
    if x == m: "x" else: "z"
  else:
    "y"

proc ffloor(v: float32): int32 {.inline.} =
  let i = int32(v)
  if v < float32(i): i - 1 else: i

proc makeOrCheckBranch(c: FeatureContext, a, b: Vector3[int32], trunk: BlockStateId, make: bool, logs: var seq[BlockPos]): bool =
  if not make and a.x == b.x and a.y == b.y and a.z == b.z:
    return true
  let o = vec3[int32](b.x - a.x, b.y - a.y, b.z - a.z)
  let i = longestSide(o)
  let f = float32(o.x) / float32(i)
  let g = float32(o.y) / float32(i)
  let h = float32(o.z) / float32(i)
  if make:
    var j = 0'i32
    while j <= i:
      let p = pos(a.x + ffloor(0.5'f32 + float32(j) * f), a.y + ffloor(0.5'f32 + float32(j) * g),
        a.z + ffloor(0.5'f32 + float32(j) * h))
      if canReplace(getState(c, p)):
        setState(c, p, withProp(trunk, "axis", logAxis(a, p.vec)))
        logs.add(p)
      inc j
    return true
  var j = 0'i32
  while j <= i:
    let p = pos(a.x + ffloor(0.5'f32 + float32(j) * f), a.y + ffloor(0.5'f32 + float32(j) * g),
      a.z + ffloor(0.5'f32 + float32(j) * h))
    if not canReplaceOrLog(getState(c, p)):
      return false
    inc j
  true

proc shouldGenerateBranch(treeHeight, height: int32): float32 =
  if float32(height) < float32(treeHeight) * 0.3'f32:
    return -1.0'f32
  let f = float32(treeHeight) / 2.0'f32
  let g = f - float32(height)
  var h = sqrt(f * f - g * g)
  if g == 0.0'f32:
    h = f
  elif abs(g) >= f:
    return 0.0'f32
  h * 0.5'f32

proc isHighEnough(treeHeight, height: int32): bool =
  float64(height) >= float64(treeHeight) * 0.2

proc fancyTrunk(c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos, below: BlockStateProvider,
                trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  let j = height + 2
  let k = int32(floor(float64(j) * 0.618))
  if setDirt(c, random, start.down(), below):
    result.logs.add(start.down())
  let l = min(int32(floor(1.382 + pow(1.0 * float64(j) / 13.0, 2.0))), 1'i32)
  let m = start.y + k
  var list = newSeq[BranchPosition](0)
  list.add(BranchPosition(pos: start.upHeight(j - 5), endY: m))
  var n = j - 5
  while n >= 0:
    let f = shouldGenerateBranch(j, n)
    if f >= 0.0'f32:
      for o in 0'i32 ..< l:
        let g = 1.0'f64 * float64(f) * (float64(nextF32(random)) + 0.328'f64)
        let h = float64(nextF32(random) * 2.0'f32) * PI
        let px = g * sin(h) + 0.5'f64
        let qz = g * cos(h) + 0.5'f64
        let bp = start.add(int32(floor(px)), n - 1, int32(floor(qz)))
        let bp2 = bp.upHeight(5)
        if not makeOrCheckBranch(c, bp.vec, bp2.vec, trunk, false, result.logs):
          continue
        let r = start.x - bp.x
        let s = start.z - bp.z
        let t = float64(bp.y) - sqrt(float64(r * r + s * s)) * 0.381'f64
        let u = if t > float64(m): m else: int32(t)
        let bp3 = pos(start.x, u, start.z)
        if not makeOrCheckBranch(c, bp3.vec, bp.vec, trunk, false, result.logs):
          continue
        list.add(BranchPosition(pos: bp, endY: bp3.y))
    dec n
  discard makeOrCheckBranch(c, start.vec, start.upHeight(k).vec, trunk, true, result.logs)
  for bi in 0 ..< list.len:
    let i = list[bi].endY
    let bp = pos(start.x, i, start.z)
    if bp == list[bi].pos or not isHighEnough(j, i - start.y):
      continue
    discard makeOrCheckBranch(c, bp.vec, list[bi].pos.vec, trunk, true, result.logs)
  for bi in 0 ..< list.len:
    if isHighEnough(j, list[bi].endY - start.y):
      result.nodes.add(node(list[bi].pos))

proc bendingTrunk(t: TrunkPlacer, c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos,
                  below: BlockStateProvider, trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  let direction = randomHorizontal(random)
  let logHeight = height - 1
  var at = start
  if setDirt(c, random, at.down(), below):
    result.logs.add(at.down())
  for i in 0'i32 .. logHeight:
    if i + 1 >= logHeight + nextBoundedI32(random, 2):
      at = offset(at, direction)
    if place(c, at, trunk):
      result.logs.add(at)
    if i >= t.minHeightForLeaves:
      result.nodes.add(node(at))
    at = at.up()
  let dirLength = get(t.bendLength, random)
  for i in 0'i32 .. dirLength:
    if place(c, at, trunk):
      result.logs.add(at)
    result.nodes.add(node(at))
    at = offset(at, direction)

proc placeLogSpecial(t: TrunkPlacer, c: FeatureContext, at: BlockPos, trunk: BlockStateId): bool =
  let s = getState(c, at)
  if canReplace(s) or containsId(t.canGrowThrough, blockIdOf(s)):
    setState(c, at, trunk)
    return true
  false

proc upwardsBranchingTrunk(t: TrunkPlacer, c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos,
                           trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  for hp in 0'i32 ..< height:
    let cur = start.upHeight(hp)
    if placeLogSpecial(t, c, cur, trunk):
      result.logs.add(cur)
      if hp < height - 1 and nextF32(random) < t.placeBranchPerLogProbability:
        let branchDir = randomHorizontal(random)
        let branchLen = get(t.extraBranchLength, random)
        let branchPos = max(branchLen - get(t.extraBranchLength, random) - 1, 0'i32)
        var branchSteps = get(t.extraBranchSteps, random)
        var heightAlong = cur.y + branchPos
        var lx = cur.x
        var lz = cur.z
        var idx = branchPos
        while idx < height and branchSteps > 0:
          if idx >= 1:
            let ph = cur.y + idx
            let o = toOffset(branchDir)
            lx += o.x
            lz += o.z
            heightAlong = ph
            let p = pos(lx, ph, lz)
            if placeLogSpecial(t, c, p, trunk):
              result.logs.add(p)
              heightAlong = ph + 1
            result.nodes.add(node(p))
          inc idx
          dec branchSteps
        if heightAlong - cur.y > 1:
          let fp = pos(lx, heightAlong, lz)
          result.nodes.add(node(fp))
          result.nodes.add(node(fp.downHeight(2)))
    if hp == height - 1:
      result.nodes.add(node(cur.up()))

proc cherryBranch(t: TrunkPlacer, c: FeatureContext, random: var RandomGenerator, treeHeight: int32, origin: BlockPos,
                  trunk: BlockStateId, bdx, bdz, offsetFromOrigin: int32, middleContinuesUpwards: bool,
                  logs: var seq[BlockPos]): TreeNode =
  var lp = origin.upHeight(offsetFromOrigin)
  let branchEndOffset = treeHeight - 1 + get(t.endOffsetFromTop, random)
  let extend = middleContinuesUpwards or branchEndOffset < offsetFromOrigin
  let distanceToTrunk = get(t.horizontalLength, random) + (if extend: 1'i32 else: 0'i32)
  let branchEnd = origin.add(bdx * distanceToTrunk, 0, bdz * distanceToTrunk).upHeight(branchEndOffset)
  let stepsH = if extend: 2'i32 else: 1'i32
  let sideways = withProp(trunk, "axis", if bdx != 0: "x" else: "z")
  for i in 0'i32 ..< stepsH:
    lp = lp.add(bdx, 0, bdz)
    if place(c, lp, sideways):
      logs.add(lp)
  let verticalDirection = if branchEnd.y > lp.y: 1'i32 else: -1'i32
  while true:
    let distance = manhattanDistance(lp, branchEnd)
    if distance == 0:
      return node(branchEnd.up())
    let chance = float32(abs(branchEnd.y - lp.y)) / float32(distance)
    if nextF32(random) < chance:
      lp = lp.upHeight(verticalDirection)
      if place(c, lp, trunk):
        logs.add(lp)
    else:
      lp = lp.add(bdx, 0, bdz)
      if place(c, lp, sideways):
        logs.add(lp)

proc cherryTrunk(t: TrunkPlacer, c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos,
                 below: BlockStateProvider, trunk: BlockStateId): TrunkResult =
  result = TrunkResult(nodes: @[], logs: @[])
  if setDirt(c, random, start.down(), below):
    result.logs.add(start.down())
  let firstBranchOffset = max(height - 1 + nextInbetweenI32(random, t.startOffsetMin, t.startOffsetMax), 0'i32)
  var secondBranchOffset = max(height - 1 + nextInbetweenI32(random, t.startOffsetMin, t.startOffsetMax - 1), 0'i32)
  if secondBranchOffset >= firstBranchOffset:
    inc secondBranchOffset
  let branchCount = get(t.count, random)
  let hasMiddle = branchCount == 3
  let hasBoth = branchCount >= 2
  let trunkHeight = if hasMiddle: height
                    elif hasBoth: max(firstBranchOffset, secondBranchOffset) + 1
                    else: firstBranchOffset + 1
  for y in 0'i32 ..< trunkHeight:
    let p = start.upHeight(y)
    if place(c, p, trunk):
      result.logs.add(p)
  if hasMiddle:
    result.nodes.add(node(start.upHeight(trunkHeight)))
  let dirs = [(0'i32, -1'i32), (1'i32, 0'i32), (0'i32, 1'i32), (-1'i32, 0'i32)]
  let d = dirs[int(nextBoundedI32(random, 4))]
  result.nodes.add(cherryBranch(t, c, random, height, start, trunk, d[0], d[1], firstBranchOffset,
    firstBranchOffset < trunkHeight - 1, result.logs))
  if hasBoth:
    result.nodes.add(cherryBranch(t, c, random, height, start, trunk, -d[0], -d[1], secondBranchOffset,
      secondBranchOffset < trunkHeight - 1, result.logs))

proc generateTrunk(t: TrunkPlacer, c: FeatureContext, random: var RandomGenerator, height: int32, start: BlockPos,
                   below: BlockStateProvider, trunk: BlockStateId): TrunkResult =
  ## `TrunkType::generate`
  case t.kind
  of TrunkTypeKind.Straight: straightTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.Forking: forkingTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.Giant: giantTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.MegaJungle: megaJungleTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.DarkOak: darkOakTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.Fancy: fancyTrunk(c, random, height, start, below, trunk)
  of TrunkTypeKind.Bending: bendingTrunk(t, c, random, height, start, below, trunk)
  of TrunkTypeKind.UpwardsBranching: upwardsBranchingTrunk(t, c, random, height, start, trunk)
  of TrunkTypeKind.Cherry: cherryTrunk(t, c, random, height, start, below, trunk)

# --- FoliagePlacer ----------------------------------------------------------------------------------------------------

proc placeFoliageBlock(c: FeatureContext, random: var RandomGenerator, at: BlockPos, provider: BlockStateProvider): bool =
  ## `FoliagePlacer::place_foliage_block`
  let blk = getState(c, at)
  if isLeaves(blk) and propValue(blk, "persistent") == "true":
    return false
  if not canReplace(blk):
    return false
  var s = providerGet(provider, c, random, at)
  if blk == SWater or isWaterlogged(blk):
    s = withProp(s, "waterlogged", "true")
  setState(c, at, s)
  true

proc isInvalidForLeaves(f: FoliagePlacer, random: var RandomGenerator, dx, y, dz, radius: int32, giantTrunk: bool): bool =
  ## `LeaveValidator::is_invalid_for_leaves` of each placer.
  case f.kind
  of FoliageTypeKind.Acacia:
    if y == 0:
      return (dx > 1 or dz > 1) and dx != 0 and dz != 0
    dx == radius and dz == radius and radius > 0
  of FoliageTypeKind.Blob:
    dx == radius and dz == radius and (nextBoundedI32(random, 2) == 0 or y == 0)
  of FoliageTypeKind.Bush:
    dx == radius and dz == radius and nextBoundedI32(random, 2) == 0
  of FoliageTypeKind.Cherry:
    if y == -1 and (dx == radius or dz == radius) and nextF32(random) < f.wideBottomLayerHoleChance:
      return true
    let corner = dx == radius and dz == radius
    if radius > 2:
      corner or (dx + dz > radius * 2 - 2 and nextF32(random) < f.cornerHoleChance)
    else:
      corner and nextF32(random) < f.cornerHoleChance
  of FoliageTypeKind.DarkOak:
    if y == -1 and not giantTrunk:
      return dx == radius and dz == radius
    if y == 1:
      return dx + dz > radius * 2 - 2
    false
  of FoliageTypeKind.Fancy:
    let a = float32(dx) + 0.5'f32
    let b = float32(dz) + 0.5'f32
    a * a + b * b > float32(radius * radius)
  of FoliageTypeKind.Jungle:
    if dx + dz >= 7:
      return true
    dx * dx + dz * dz > radius * radius
  of FoliageTypeKind.MegaPine:
    if dx + dz >= 7:
      return true
    dx * dx + dz * dz > radius * radius
  of FoliageTypeKind.Pine, FoliageTypeKind.Spruce:
    dx == radius and dz == radius and radius > 0
  of FoliageTypeKind.RandomSpread:
    false

proc isPositionInvalid(f: FoliagePlacer, random: var RandomGenerator, dx, y, dz, radius: int32, giantTrunk: bool): bool =
  ## `LeaveValidator::is_position_invalid`
  if f.kind == FoliageTypeKind.DarkOak:
    if not (y != 0 or not giantTrunk or (dx != -radius and dx < radius) or (dz != -radius and dz < radius)):
      return true
  let x = if giantTrunk: min(abs(dx), abs(dx - 1)) else: abs(dx)
  let z = if giantTrunk: min(abs(dz), abs(dz - 1)) else: abs(dz)
  isInvalidForLeaves(f, random, x, y, z, radius, giantTrunk)

proc generateSquare(f: FoliagePlacer, out0: var seq[BlockPos], c: FeatureContext, random: var RandomGenerator, center: BlockPos,
                    radius, y: int32, giantTrunk: bool, provider: BlockStateProvider) =
  ## `FoliagePlacer::generate_square`
  let i = if giantTrunk: 1'i32 else: 0'i32
  var x = -radius
  while x <= radius + i:
    var z = -radius
    while z <= radius + i:
      if not isPositionInvalid(f, random, x, y, z, radius, giantTrunk):
        let p = center.add(x, y, z)
        if placeFoliageBlock(c, random, p, provider):
          out0.add(p)
      inc z
    inc x

proc seqHasPos(s: seq[BlockPos], p: BlockPos): bool =
  for i in 0 ..< s.len:
    if s[i] == p:
      return true
  false

proc tryPlaceExtension(out0: var seq[BlockPos], c: FeatureContext, random: var RandomGenerator, chance: float32, logPos, p: BlockPos,
                       provider: BlockStateProvider): bool =
  if manhattanDistance(p, logPos) >= 7 or nextF32(random) > chance:
    return false
  let placed = placeFoliageBlock(c, random, p, provider)
  if placed:
    out0.add(p)
  placed

proc generateSquareWithHangingLeaves(f: FoliagePlacer, out0: var seq[BlockPos], c: FeatureContext, random: var RandomGenerator,
                                     center: BlockPos, radius, y: int32, giantTrunk: bool, provider: BlockStateProvider,
                                     chance, extensionChance: float32) =
  generateSquare(f, out0, c, random, center, radius, y, giantTrunk, provider)
  let i = if giantTrunk: 1'i32 else: 0'i32
  let logPos = center.down()
  for alongEdge in HorizontalWorldgen:
    let toEdge = rotateClockwise(alongEdge)
    let offsetToEdge = if positive(toEdge): radius + i else: radius
    var p = offsetN(offsetN(center.add(0, y - 1, 0), toEdge, offsetToEdge), alongEdge, -radius)
    var n = -radius
    while n < radius + i:
      if seqHasPos(out0, p.up()) and tryPlaceExtension(out0, c, random, chance, logPos, p, provider):
        discard tryPlaceExtension(out0, c, random, extensionChance, logPos, p.down(), provider)
      p = offsetN(p, alongEdge, 1)
      inc n

proc generateFoliage(f: FoliagePlacer, out0: var seq[BlockPos], c: FeatureContext, random: var RandomGenerator, n: TreeNode,
                     foliageHeight, radius: int32, provider: BlockStateProvider) =
  ## `FoliagePlacer::generate` and `FoliageType::generate`
  let offset = get(f.offset, random)
  case f.kind
  of FoliageTypeKind.Acacia:
    generateSquare(f, out0, c, random, n.center, radius + n.foliageRadius, -1, n.giantTrunk, provider)
    generateSquare(f, out0, c, random, n.center, radius - 1, -foliageHeight, n.giantTrunk, provider)
    generateSquare(f, out0, c, random, n.center, radius + n.foliageRadius - 1, 0, n.giantTrunk, provider)
  of FoliageTypeKind.Blob:
    var y = offset
    while y >= offset - foliageHeight:
      let r = max(radius + n.foliageRadius - 1 - y div 2, 0'i32)
      generateSquare(f, out0, c, random, n.center, r, y, n.giantTrunk, provider)
      dec y
  of FoliageTypeKind.Bush:
    var y = offset
    while y >= offset - foliageHeight:
      generateSquare(f, out0, c, random, n.center, radius + n.foliageRadius - 1 - y, y, n.giantTrunk, provider)
      dec y
  of FoliageTypeKind.Cherry:
    let p = n.center.upHeight(offset)
    let cr = radius + n.foliageRadius - 1
    generateSquare(f, out0, c, random, p, cr - 2, foliageHeight - 3, n.giantTrunk, provider)
    generateSquare(f, out0, c, random, p, cr - 1, foliageHeight - 4, n.giantTrunk, provider)
    var y = foliageHeight - 5
    while y >= 0:
      generateSquare(f, out0, c, random, p, cr, y, n.giantTrunk, provider)
      dec y
    generateSquareWithHangingLeaves(f, out0, c, random, p, cr, -1, n.giantTrunk, provider, f.hangingLeavesChance, f.hangingLeavesExtensionChance)
    generateSquareWithHangingLeaves(f, out0, c, random, p, cr - 1, -2, n.giantTrunk, provider, f.hangingLeavesChance, f.hangingLeavesExtensionChance)
  of FoliageTypeKind.DarkOak:
    let p = n.center.upHeight(offset)
    generateSquare(f, out0, c, random, p, radius + 2, -1, n.giantTrunk, provider)
    if n.giantTrunk:
      generateSquare(f, out0, c, random, p, radius + 3, 0, n.giantTrunk, provider)
      generateSquare(f, out0, c, random, p, radius + 2, 1, n.giantTrunk, provider)
      if nextBool(random):
        generateSquare(f, out0, c, random, p, radius, 2, n.giantTrunk, provider)
    else:
      generateSquare(f, out0, c, random, p, radius + 1, 0, n.giantTrunk, provider)
  of FoliageTypeKind.Fancy:
    var y = offset
    while y >= offset - foliageHeight:
      let r = radius + (if y == offset or y == offset - foliageHeight: 0'i32 else: 1'i32)
      generateSquare(f, out0, c, random, n.center, r, y, n.giantTrunk, provider)
      dec y
  of FoliageTypeKind.Jungle:
    let height = if n.giantTrunk: foliageHeight else: 1 + nextBoundedI32(random, 2)
    var y = offset
    while y >= offset - height:
      generateSquare(f, out0, c, random, n.center, radius + n.foliageRadius + 1 - y, y, n.giantTrunk, provider)
      dec y
  of FoliageTypeKind.MegaPine:
    let px = n.center.x
    let py = n.center.y
    let pz = n.center.z
    var current = 0'i32
    var y = py - foliageHeight + offset
    while y <= py + offset:
      let delta = py - y
      let computed = radius + n.foliageRadius + int32(floor(float32(delta) / float32(foliageHeight) * 3.5'f32))
      let r = if delta > 0 and computed == current and (y and 1) == 0: computed + 1 else: computed
      generateSquare(f, out0, c, random, pos(px, y, pz), r, 0, n.giantTrunk, provider)
      current = computed
      inc y
  of FoliageTypeKind.Pine:
    var r = 0'i32
    var y = offset
    while y >= offset - foliageHeight:
      generateSquare(f, out0, c, random, n.center, r, y, n.giantTrunk, provider)
      if r >= 1 and y == offset - foliageHeight + 1:
        dec r
      elif r < radius + n.foliageRadius:
        inc r
      dec y
  of FoliageTypeKind.RandomSpread:
    for i in 0'i32 ..< f.leafPlacementAttempts:
      let a = nextBoundedI32(random, radius) - nextBoundedI32(random, radius)
      let b = nextBoundedI32(random, foliageHeight) - nextBoundedI32(random, foliageHeight)
      let d = nextBoundedI32(random, radius) - nextBoundedI32(random, radius)
      let p = n.center.add(a, b, d)
      if placeFoliageBlock(c, random, p, provider):
        out0.add(p)
  of FoliageTypeKind.Spruce:
    var r = nextBoundedI32(random, 2)
    var mx = 1'i32
    var next = 0'i32
    var y = offset
    while y >= -foliageHeight:
      generateSquare(f, out0, c, random, n.center, r, y, n.giantTrunk, provider)
      if r >= mx:
        r = next
        next = 1
        mx = min(radius + n.foliageRadius, mx + 1)
      else:
        inc r
      dec y

proc foliageRandomHeight(f: FoliagePlacer, random: var RandomGenerator, trunkHeight: int32): int32 =
  ## `FoliageType::get_random_height`
  case f.kind
  of FoliageTypeKind.Blob, FoliageTypeKind.Bush, FoliageTypeKind.Fancy, FoliageTypeKind.Jungle: f.height
  of FoliageTypeKind.Spruce: max(trunkHeight - get(f.heightProvider, random), 4'i32)
  of FoliageTypeKind.Pine, FoliageTypeKind.MegaPine, FoliageTypeKind.RandomSpread, FoliageTypeKind.Cherry: get(f.heightProvider, random)
  of FoliageTypeKind.Acacia: 0
  of FoliageTypeKind.DarkOak: 4

proc foliageRandomRadius(f: FoliagePlacer, random: var RandomGenerator, baseHeight: int32): int32 =
  ## `FoliagePlacer::get_random_radius`
  if f.kind == FoliageTypeKind.Pine:
    get(f.radius, random) + nextBoundedI32(random, max(baseHeight + 1, 1'i32))
  else:
    get(f.radius, random)

# --- Mangrove roots ---------------------------------------------------------------------------------------------------

proc canGrowThroughRoot(r: MangroveRootPlacer, c: FeatureContext, at: BlockPos): bool =
  let s = getState(c, at)
  canReplace(s) or containsId(r.canGrowThrough, blockIdOf(s))

proc applyWaterlogging(c: FeatureContext, at: BlockPos, state: BlockStateId): BlockStateId =
  if isWaterlogged(state):
    return state
  let (fluid, fs) = fluidOf(c.chunk, at.vec)
  discard fs
  if fluid.name != "water" and fluid.name != "flowing_water":
    return state
  withProp(state, "waterlogged", "true")

proc offshootPositions(r: MangroveRootPlacer, at: BlockPos, direction: BlockDirection, random: var RandomGenerator, origin: BlockPos): seq[BlockPos] =
  let down = at.down()
  let sideways = offset(at, direction)
  let dist = manhattanDistance(at, origin)
  if dist > r.maxRootWidth - 3 and dist <= r.maxRootWidth:
    if nextF32(random) < r.randomSkewChance: @[down, sideways.down()] else: @[down]
  elif dist > r.maxRootWidth or nextF32(random) < r.randomSkewChance:
    @[down]
  elif nextBool(random):
    @[sideways]
  else:
    @[down]

proc canGrow(r: MangroveRootPlacer, c: FeatureContext, random: var RandomGenerator, at: BlockPos, direction: BlockDirection, origin: BlockPos,
             offshoots: var seq[BlockPos], rootLength: int32): bool =
  if rootLength == r.maxRootLength or offshoots.len > int(r.maxRootLength):
    return false
  let nexts = offshootPositions(r, at, direction, random, origin)
  for i in 0 ..< nexts.len:
    if canGrowThroughRoot(r, c, nexts[i]):
      offshoots.add(nexts[i])
      if not canGrow(r, c, random, nexts[i], direction, origin, offshoots, rootLength + 1):
        return false
  true

proc placeRoots(r: MangroveRootPlacer, c: FeatureContext, random: var RandomGenerator, at: BlockPos, placed: var seq[BlockPos]) =
  if containsId(r.muddyRootsIn, getBlockId(c, at)):
    let s = applyWaterlogging(c, at, providerGet(r.muddyRootsProvider, c, random, at))
    setState(c, at, s)
    placed.add(at)
    return
  if not canGrowThroughRoot(r, c, at):
    return
  let s = applyWaterlogging(c, at, providerGet(r.rootProvider, c, random, at))
  setState(c, at, s)
  placed.add(at)
  if r.hasAbove:
    let above = at.up()
    if nextF32(random) < r.aboveRootPlacementChance and airAt(c, above):
      let a = applyWaterlogging(c, above, providerGet(r.aboveRootProvider, c, random, above))
      setState(c, above, a)
      placed.add(above)

proc generateRoots(r: MangroveRootPlacer, c: FeatureContext, random: var RandomGenerator, at, trunkPos: BlockPos, placed: var seq[BlockPos]): bool =
  ## `MangroveRootPlacer::generate`; false is upstream's None.
  var roots = newSeq[BlockPos](0)
  var walker = at
  while walker.y < trunkPos.y:
    if not canGrowThroughRoot(r, c, walker):
      return false
    walker = walker.up()
  roots.add(trunkPos.down())
  for dir in HorizontalWorldgen:
    let start = offset(trunkPos, dir)
    var offshoots = newSeq[BlockPos](0)
    if not canGrow(r, c, random, start, dir, trunkPos, offshoots, 0):
      return false
    for i in 0 ..< offshoots.len:
      roots.add(offshoots[i])
    roots.add(start)
  for i in 0 ..< roots.len:
    placeRoots(r, c, random, roots[i], placed)
  true

# --- TreeDecorator ----------------------------------------------------------------------------------------------------

proc leafLitterPositions(roots, logs: seq[BlockPos]): seq[BlockPos] =
  ## `TreeDecorator::get_leaf_litter_positions`
  if roots.len == 0:
    return logs
  if logs.len > 0 and roots[0].y == logs[0].y:
    result = newSeq[BlockPos](0)
    for i in 0 ..< logs.len: result.add(logs[i])
    for i in 0 ..< roots.len: result.add(roots[i])
    return result
  roots

proc vineState(north, south, east, west: bool): BlockStateId =
  stateWith(BVine, [(name: "north", value: boolStr(north)), (name: "south", value: boolStr(south)),
    (name: "east", value: boolStr(east)), (name: "west", value: boolStr(west)), (name: "up", value: "false")])

proc placeVines(c: FeatureContext, start: BlockPos, s: BlockStateId, decorations: var seq[BlockPos]) =
  setState(c, start, s)
  decorations.add(start)
  var cur = start.down()
  for i in 0 ..< 4:
    if not airAt(c, cur):
      break
    setState(c, cur, s)
    decorations.add(cur)
    cur = cur.down()

proc addMossHanger(c: FeatureContext, random: var RandomGenerator, start: BlockPos, decorations: var seq[BlockPos]) =
  var at = start
  while airAt(c, at.down()) and nextF32(random) >= 0.5'f32:
    setState(c, at, stateWith(BPaleHangingMoss, [(name: "tip", value: "false")]))
    decorations.add(at)
    at = at.down()
  setState(c, at, stateWith(BPaleHangingMoss, [(name: "tip", value: "true")]))
  decorations.add(at)

proc placeCircleBlock(d: TreeDecorator, c: FeatureContext, random: var RandomGenerator, at: BlockPos, decorations: var seq[BlockPos]) =
  var dy = 2'i32
  while dy >= -3:
    let cursor = at.upHeight(dy)
    let o = getOptional(d.provider, c.blockRegistry, c.chunk, random, cursor)
    if o.hasState:
      setState(c, cursor, o.state)
      decorations.add(cursor)
      break
    if not airAt(c, cursor) and dy < 0:
      break
    dec dy

proc placeCircle(d: TreeDecorator, c: FeatureContext, random: var RandomGenerator, at: BlockPos, decorations: var seq[BlockPos]) =
  for xx in -2'i32 .. 2'i32:
    for zz in -2'i32 .. 2'i32:
      if abs(xx) != 2 or abs(zz) != 2:
        placeCircleBlock(d, c, random, at.add(xx, 0, zz), decorations)

proc generateDecorator*(d: TreeDecorator, c: FeatureContext, random: var RandomGenerator, roots, logs, foliage: seq[BlockPos],
                        decorations: var seq[BlockPos]) =
  ## `TreeDecorator::generate`
  case d.kind
  of TreeDecoratorKind.TrunkVine:
    for i in 0 ..< logs.len:
      let p = logs[i]
      if nextBoundedI32(random, 3) > 0 and airAt(c, p.west()):
        setState(c, p.west(), vineState(false, false, true, false))
        decorations.add(p.west())
      if nextBoundedI32(random, 3) > 0 and airAt(c, p.east()):
        setState(c, p.east(), vineState(false, false, false, true))
        decorations.add(p.east())
      if nextBoundedI32(random, 3) > 0 and airAt(c, p.north()):
        setState(c, p.north(), vineState(false, true, false, false))
        decorations.add(p.north())
      if nextBoundedI32(random, 3) > 0 and airAt(c, p.south()):
        setState(c, p.south(), vineState(true, false, false, false))
        decorations.add(p.south())
  of TreeDecoratorKind.LeaveVine:
    for i in 0 ..< foliage.len:
      let p = foliage[i]
      if nextF32(random) < d.probability and airAt(c, p.west()):
        placeVines(c, p.west(), vineState(false, false, true, false), decorations)
      if nextF32(random) < d.probability and airAt(c, p.east()):
        placeVines(c, p.east(), vineState(false, false, false, true), decorations)
      if nextF32(random) < d.probability and airAt(c, p.north()):
        placeVines(c, p.north(), vineState(false, true, false, false), decorations)
      if nextF32(random) < d.probability and airAt(c, p.south()):
        placeVines(c, p.south(), vineState(true, false, false, false), decorations)
  of TreeDecoratorKind.PaleMoss:
    if logs.len == 0:
      return
    for i in 0 ..< logs.len:
      if nextF32(random) < d.trunkProbability and airAt(c, logs[i].down()):
        addMossHanger(c, random, logs[i].down(), decorations)
    for i in 0 ..< foliage.len:
      if nextF32(random) < d.leavesProbability and airAt(c, foliage[i].down()):
        addMossHanger(c, random, foliage[i].down(), decorations)
  of TreeDecoratorKind.CreakingHeart:
    if logs.len == 0 or nextF32(random) >= d.probability:
      return
    var shuffled = logs
    shuffle(shuffled, random)
    for i in 0 ..< shuffled.len:
      var allLogs = true
      for dir in AllDirections:
        if not hasBlockTag(getState(c, offset(shuffled[i], dir)), TagLogs):
          allLogs = false
          break
      if allLogs:
        setState(c, shuffled[i], stateWith(BCreakingHeart, [(name: "axis", value: "y"),
          (name: "creaking_heart_state", value: "dormant"), (name: "natural", value: "true")]))
        decorations.add(shuffled[i])
        break
  of TreeDecoratorKind.Cocoa:
    if nextF32(random) >= d.probability or logs.len == 0:
      return
    let treeY = logs[0].y
    for i in 0 ..< logs.len:
      if logs[i].y - treeY > 2:
        continue
      for facing in HorizontalWorldgen:
        if nextF32(random) <= 0.25'f32:
          let cocoaPos = offset(logs[i], opposite(facing))
          if airAt(c, cocoaPos):
            let facingName = case facing
              of BlockDirection.North: "north"
              of BlockDirection.South: "south"
              of BlockDirection.West: "west"
              else: "east"
            setState(c, cocoaPos, stateWith(BCocoa, [(name: "age", value: $nextBoundedI32(random, 3)), (name: "facing", value: facingName)]))
            decorations.add(cocoaPos)
  of TreeDecoratorKind.Beehive:
    if logs.len == 0 or nextF32(random) >= d.probability:
      return
    let spawnDirections = [BlockDirection.East, BlockDirection.South, BlockDirection.West]
    let hiveY = if foliage.len > 0: max(foliage[0].y - 1, logs[0].y + 1)
                else: min(logs[0].y + 1 + nextBoundedI32(random, 3), logs[logs.len - 1].y)
    var placements = newSeq[BlockPos](0)
    for i in 0 ..< logs.len:
      if logs[i].y == hiveY:
        for dir in spawnDirections:
          placements.add(offset(logs[i], dir))
    if placements.len == 0:
      return
    shuffle(placements, random)
    for i in 0 ..< placements.len:
      let p = placements[i]
      if airAt(c, p) and airAt(c, p.south()):
        setState(c, p, stateWith(BBeeNest, [(name: "facing", value: "south")]))
        let numBees = 2 + nextBoundedI32(random, 2)
        for b in 0'i32 ..< numBees:
          discard nextBoundedI32(random, 599)
        decorations.add(p)
        break
  of TreeDecoratorKind.AlterGround:
    let list = leafLitterPositions(roots, logs)
    if list.len == 0:
      return
    var minY = list[0].y
    for i in 0 ..< list.len:
      minY = min(minY, list[i].y)
    for i in 0 ..< list.len:
      let p = list[i]
      if p.y != minY:
        continue
      placeCircle(d, c, random, p.west().north(), decorations)
      placeCircle(d, c, random, p.east().east().north(), decorations)
      placeCircle(d, c, random, p.west().south().south(), decorations)
      placeCircle(d, c, random, p.east().east().south().south(), decorations)
      for n in 0 ..< 5:
        let placement = nextBoundedI32(random, 64)
        let xx = placement mod 8
        let zz = placement div 8
        if xx == 0 or xx == 7 or zz == 0 or zz == 7:
          placeCircle(d, c, random, p.add(-3 + xx, 0, -3 + zz), decorations)
  of TreeDecoratorKind.PlaceOnGround:
    let list = leafLitterPositions(roots, logs)
    if list.len == 0:
      return
    let i0 = list[0].y
    var j = list[0].x
    var k = list[0].x
    var l = list[0].z
    var m = list[0].z
    for i in 0 ..< list.len:
      if list[i].y != i0:
        continue
      j = min(j, list[i].x)
      k = max(k, list[i].x)
      l = min(l, list[i].z)
      m = max(m, list[i].z)
    let minX = j - d.radius
    let maxX = k + d.radius
    let minY = i0 - d.height
    let maxY = i0 + d.height
    let minZ = l - d.radius
    let maxZ = m + d.radius
    for n in 0'i32 ..< d.tries:
      let x = nextInbetweenI32(random, minX, maxX)
      let y = nextInbetweenI32(random, minY, maxY)
      let z = nextInbetweenI32(random, minZ, maxZ)
      let p = pos(x, y, z)
      let above = p.up()
      let aboveState = getState(c, above)
      let ground = getState(c, p)
      if (isAir(aboveState) or blockIdOf(aboveState) == BVine) and isSolidBlock(ground) and
          topY(c, MotionBlockingNoLeaves, p.x, p.z) <= above.y:
        setState(c, above, providerGet(d.provider, c, random, above))
        decorations.add(above)
  of TreeDecoratorKind.AttachedToLeaves:
    if d.directions.len == 0 or foliage.len == 0:
      return
    var blacklist = newJavaBlockPosHashSet()
    var shuffled = foliage
    shuffle(shuffled, random)
    for i in 0 ..< shuffled.len:
      let leaf = shuffled[i]
      let direction = d.directions[int(nextBoundedI32(random, int32(d.directions.len)))]
      let placement = offset(leaf, direction)
      if not contains(blacklist, placement) and nextF32(random) < d.probability:
        var free = true
        var e = 1'i32
        while e <= d.requiredEmptyBlocks:
          if not airAt(c, offsetN(leaf, direction, e)):
            free = false
            break
          inc e
        if free:
          var dx = -d.exclusionRadiusXz
          while dx <= d.exclusionRadiusXz:
            var dy = -d.exclusionRadiusY
            while dy <= d.exclusionRadiusY:
              var dz = -d.exclusionRadiusXz
              while dz <= d.exclusionRadiusXz:
                blacklist.incl(placement.add(dx, dy, dz))
                inc dz
              inc dy
            inc dx
          setState(c, placement, providerGet(d.provider, c, random, placement))
          decorations.add(placement)
  of TreeDecoratorKind.AttachedToLogs:
    if d.directions.len == 0 or logs.len == 0:
      return
    var shuffled = logs
    shuffle(shuffled, random)
    for i in 0 ..< shuffled.len:
      let direction = d.directions[int(nextBoundedI32(random, int32(d.directions.len)))]
      let placement = offset(shuffled[i], direction)
      if nextF32(random) <= d.probability and airAt(c, placement):
        setState(c, placement, providerGet(d.provider, c, random, placement))
        decorations.add(placement)

# --- TreeFeature ------------------------------------------------------------------------------------------------------

proc maxFreeTreeHeight(t: TreeFeature, maxTreeHeight: int32, c: FeatureContext, treePos: BlockPos): int32 =
  ## `get_max_free_tree_height`
  var y = 0'i32
  while y <= maxTreeHeight + 1:
    let r = getRadius(t.minimumSize, uint32(maxTreeHeight), y)
    var x = -r
    while x <= r:
      var z = -r
      while z <= r:
        let s = getState(c, treePos.add(x, y, z))
        let id = blockIdOf(s)
        let through = t.trunkPlacer.kind == TrunkTypeKind.UpwardsBranching and containsId(t.trunkPlacer.canGrowThrough, id)
        if not ((canReplaceOrLog(s) or through) and (t.ignoreVines or id != BVine)):
          return y - 2
        inc z
      inc x
    inc y
  maxTreeHeight

proc sortByY(s: seq[BlockPos]): seq[BlockPos] =
  ## A stable `sort_by_key(|p| p.0.y)`.
  result = s
  for i in 1 ..< result.len:
    let v = result[i]
    var j = i - 1
    while j >= 0 and result[j].y > v.y:
      let moved = result[j]
      result[j + 1] = moved
      dec j
    result[j + 1] = v

proc vineSideKept(c: FeatureContext, at: BlockPos, aboveId: BlockStateId, aboveIsVine, flag: bool, dir: BlockDirection, name: string): bool =
  if not flag:
    return false
  let s = getState(c, offset(at, dir))
  if sideSolid(s, opposite(dir)) or isFullCube(s):
    return true
  aboveIsVine and propValue(aboveId, name) == "true"

proc edgeState(c: FeatureContext, at: BlockPos, dirToNeighbor: BlockDirection, changed: var bool): BlockStateId =
  ## `get_updated_edge_state`: only a vine's shape can change when a tree's neighbours do.
  changed = false
  let id = getState(c, at)
  if blockIdOf(id) != BVine or dirToNeighbor == BlockDirection.Down:
    return id
  var up = propValue(id, "up") == "true"
  var north = propValue(id, "north") == "true"
  var east = propValue(id, "east") == "true"
  var south = propValue(id, "south") == "true"
  var west = propValue(id, "west") == "true"
  let orig = id
  let abovePos = at.up()
  if up:
    let s = getState(c, abovePos)
    up = sideSolid(s, BlockDirection.Down) or isFullCube(s)
  let aboveId = getState(c, abovePos)
  let aboveIsVine = blockIdOf(aboveId) == BVine
  north = vineSideKept(c, at, aboveId, aboveIsVine, north, BlockDirection.North, "north")
  east = vineSideKept(c, at, aboveId, aboveIsVine, east, BlockDirection.East, "east")
  south = vineSideKept(c, at, aboveId, aboveIsVine, south, BlockDirection.South, "south")
  west = vineSideKept(c, at, aboveId, aboveIsVine, west, BlockDirection.West, "west")
  if not up and not north and not east and not south and not west:
    changed = true
    return SAir
  let n = stateWith(BVine, [(name: "up", value: boolStr(up)), (name: "north", value: boolStr(north)),
    (name: "east", value: boolStr(east)), (name: "south", value: boolStr(south)), (name: "west", value: boolStr(west))])
  if n != orig:
    changed = true
  n

proc updateEdgePair(c: FeatureContext, at: BlockPos, direction: BlockDirection) =
  var changed = false
  let s = edgeState(c, at, direction, changed)
  if changed:
    setState(c, at, s)
  let n = offset(at, direction)
  let s2 = edgeState(c, n, opposite(direction), changed)
  if changed:
    setState(c, n, s2)

proc updateShapeAtEdge(c: FeatureContext, shape: seq[bool], minX, minY, minZ, xSpan, ySpan, zSpan: int32) =
  template full(x, y, z: int32): bool =
    if x < 0 or x >= xSpan or y < 0 or y >= ySpan or z < 0 or z >= zSpan: false
    else: shape[(int(x) * int(ySpan) + int(y)) * int(zSpan) + int(z)]
  for x in 0'i32 ..< xSpan:
    for y in 0'i32 ..< ySpan:
      var lastFull = false
      var z = 0'i32
      while z <= zSpan:
        let f = z != zSpan and full(x, y, z)
        if not lastFull and f:
          updateEdgePair(c, pos(minX + x, minY + y, minZ + z), BlockDirection.North)
        if lastFull and not f:
          updateEdgePair(c, pos(minX + x, minY + y, minZ + z - 1), BlockDirection.South)
        lastFull = f
        inc z
  for z in 0'i32 ..< zSpan:
    for x in 0'i32 ..< xSpan:
      var lastFull = false
      var y = 0'i32
      while y <= ySpan:
        let f = y != ySpan and full(x, y, z)
        if not lastFull and f:
          updateEdgePair(c, pos(minX + x, minY + y, minZ + z), BlockDirection.Down)
        if lastFull and not f:
          updateEdgePair(c, pos(minX + x, minY + y - 1, minZ + z), BlockDirection.Up)
        lastFull = f
        inc y
  for y in 0'i32 ..< ySpan:
    for z in 0'i32 ..< zSpan:
      var lastFull = false
      var x = 0'i32
      while x <= xSpan:
        let f = x != xSpan and full(x, y, z)
        if not lastFull and f:
          updateEdgePair(c, pos(minX + x, minY + y, minZ + z), BlockDirection.West)
        if lastFull and not f:
          updateEdgePair(c, pos(minX + x - 1, minY + y, minZ + z), BlockDirection.East)
        lastFull = f
        inc x

proc updateLeaves(c: FeatureContext, logs, roots, foliage, decorations: seq[BlockPos]) =
  ## `TreeFeature::update_leaves`
  if logs.len == 0 and foliage.len == 0:
    return
  var minX = int32.high
  var minY = int32.high
  var minZ = int32.high
  var maxX = int32.low
  var maxY = int32.low
  var maxZ = int32.low
  template grow(list: seq[BlockPos]) =
    for i in 0 ..< list.len:
      let p = list[i]
      minX = min(minX, p.x)
      minY = min(minY, p.y)
      minZ = min(minZ, p.z)
      maxX = max(maxX, p.x)
      maxY = max(maxY, p.y)
      maxZ = max(maxZ, p.z)
  grow(logs)
  grow(roots)
  grow(foliage)
  grow(decorations)
  let xSpan = maxX - minX + 1
  let ySpan = maxY - minY + 1
  let zSpan = maxZ - minZ + 1
  var shape = newSeq[bool](int(xSpan) * int(ySpan) * int(zSpan))
  template indexOf(x, y, z: int32): int =
    if x >= minX and x <= maxX and y >= minY and y <= maxY and z >= minZ and z <= maxZ:
      (int(x - minX) * int(ySpan) + int(y - minY)) * int(zSpan) + int(z - minZ)
    else:
      -1
  for i in 0 ..< roots.len:
    let idx = indexOf(roots[i].x, roots[i].y, roots[i].z)
    if idx >= 0: shape[idx] = true
  for i in 0 ..< decorations.len:
    let idx = indexOf(decorations[i].x, decorations[i].y, decorations[i].z)
    if idx >= 0: shape[idx] = true
  var toCheck = newSeq[JavaBlockPosHashSet](7)
  for i in 0 ..< 7:
    toCheck[i] = newJavaBlockPosHashSet()
  for i in 0 ..< logs.len:
    toCheck[0].incl(logs[i])
  var smallest = 0
  while true:
    while smallest >= 7 or not isEmpty(toCheck[smallest]):
      if smallest >= 7:
        updateShapeAtEdge(c, shape, minX, minY, minZ, xSpan, ySpan, zSpan)
        return
      var at = pos(0, 0, 0)
      if not popFirst(toCheck[smallest], at):
        break
      let idx = indexOf(at.x, at.y, at.z)
      if idx >= 0:
        if smallest != 0:
          let s = getState(c, at)
          if isLeaves(s) and hasProp(s, "distance"):
            setState(c, at, withProp(s, "distance", $smallest))
        shape[idx] = true
        for dir in AllDirections:
          let n = offset(at, dir)
          let nIdx = indexOf(n.x, n.y, n.z)
          if nIdx >= 0 and not shape[nIdx]:
            let ns = getState(c, n)
            var distance = -1
            if hasBlockTag(ns, TagPreventsNearbyLeafDecay):
              distance = 0
            elif isLeaves(ns) and hasProp(ns, "distance"):
              let dv = propValue(ns, "distance")
              distance = ord(dv[0]) - ord('0')
            if distance >= 0:
              let nd = min(distance, smallest + 1)
              if nd < 7:
                toCheck[nd].incl(n)
                smallest = min(smallest, nd)
    inc smallest

proc generateTree*(t: TreeFeature, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `TreeFeature::generate` and `generate_main`
  let height = t.trunkPlacer.baseHeight + nextBoundedI32(random, t.trunkPlacer.heightRandA + 1) +
    nextBoundedI32(random, t.trunkPlacer.heightRandB + 1)
  let foliageHeight = foliageRandomHeight(t.foliagePlacer, random, height)
  let trunkHeight = height - foliageHeight
  let foliageRadius = foliageRandomRadius(t.foliagePlacer, random, trunkHeight)
  let trunkStart = if t.rootPlacer != nil: at.upHeight(get(t.rootPlacer.trunkOffsetY, random)) else: at
  let minY = min(at.y, trunkStart.y)
  let maxY = max(at.y, trunkStart.y) + height + 1
  if minY < bottomY(c) + 1 or maxY > topY(c):
    return false
  let clipped = maxFreeTreeHeight(t, height, c, trunkStart)
  let meetsClipped = t.minimumSize.minClippedHeight >= 0 and clipped >= t.minimumSize.minClippedHeight
  if clipped < height and not meetsClipped:
    return false
  var rawRoots = newSeq[BlockPos](0)
  if t.rootPlacer != nil:
    if not generateRoots(t.rootPlacer, c, random, at, trunkStart, rawRoots):
      return false
  let trunkState = providerGet(t.trunkProvider, c, random, at)
  let tr = generateTrunk(t.trunkPlacer, c, random, clipped, trunkStart, t.belowTrunkProvider, trunkState)
  var rawFoliage = newSeq[BlockPos](0)
  for i in 0 ..< tr.nodes.len:
    generateFoliage(t.foliagePlacer, rawFoliage, c, random, tr.nodes[i], foliageHeight, foliageRadius, t.foliageProvider)
  if tr.logs.len == 0 and rawFoliage.len == 0:
    return false
  let logPositions = javaDedup(tr.logs)
  let rootPositions = javaDedup(rawRoots)
  let foliagePositions = javaDedup(rawFoliage)
  var rawDecorations = newSeq[BlockPos](0)
  if t.decorators.len > 0:
    let sortedLogs = sortByY(logPositions)
    let sortedRoots = sortByY(rootPositions)
    let sortedFoliage = sortByY(foliagePositions)
    for i in 0 ..< t.decorators.len:
      generateDecorator(t.decorators[i], c, random, sortedRoots, sortedLogs, sortedFoliage, rawDecorations)
  updateLeaves(c, logPositions, rootPositions, foliagePositions, javaDedup(rawDecorations))
  true
