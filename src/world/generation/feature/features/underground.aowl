## Port of pumpkin-world/src/generation/feature/features/coral/mod.rs, pumpkin-world/src/generation/feature/features/coral/coral_claw.rs,
## pumpkin-world/src/generation/feature/features/coral/coral_mushroom.rs, pumpkin-world/src/generation/feature/features/coral/coral_tree.rs,
## pumpkin-world/src/generation/feature/features/drip_stone/mod.rs, pumpkin-world/src/generation/feature/features/drip_stone/cluster.rs,
## pumpkin-world/src/generation/feature/features/drip_stone/large.rs, pumpkin-world/src/generation/feature/features/drip_stone/small.rs,
## and pumpkin-world/src/generation/feature/features/geode.rs. The sculk patch is features/sculk.aowl.
##
## Logic as the newer checkout (../ref/pumpkin) has it, except a geode's noise, which vanilla 1.21.11's bytecode seeds
## from the world seed through a legacy source and not from the feature's random: `new WorldgenRandom(new
## LegacyRandomSource(level.getSeed()))`, `NormalNoise.create(.., -4, 1.0)`.
## PARTIAL: pumpkin-world/src/generation/feature/features/drip_stone/cluster.rs - as upstream: a single-pass simplification with no column or floor logic, not vanilla's DripstoneClusterFeature. Upstream's newer checkout is no further along.
## PARTIAL: pumpkin-world/src/generation/feature/features/drip_stone/large.rs - as upstream: a stub, not vanilla's LargeDripstoneFeature.

{.feature: "lenientnils".}

import std/math
import ../../../../generated/tag
import ../../../../util/legacy_rand
import ../../noise/doubleperlin
import ../types
import ../common

let
  TagCorals = blockTag("corals")
  TagCoralBlocks = blockTag("coral_blocks")
  TagWallCorals = blockTag("wall_corals")
  TagDripstoneReplaceable = blockTag("dripstone_replaceable_blocks")
  BSeaPickle = blockIdOfName("sea_pickle")
  BDripstoneBlock = blockIdOfName("dripstone_block")
  BPointedDripstone = blockIdOfName("pointed_dripstone")
  SDripstoneBlock = defaultStateOf(BDripstoneBlock)

# --- coral ------------------------------------------------------------------------------------------------------------

proc randomTagBlock(t: Tag, random: var RandomGenerator): int =
  ## `get_random_tag_entry_block`
  int(t.ids[int(nextBoundedI32(random, int32(t.ids.len)))])

proc generateCoralPiece(c: FeatureContext, random: var RandomGenerator, state: BlockStateId, at: BlockPos): bool =
  ## `CoralFeature::generate_coral_piece`
  let cur = getState(c, at)
  let above = at.up()
  if (blockIdOf(cur) != BWater and not hasBlockTag(cur, TagCorals)) or getBlockId(c, above) != BWater:
    return false
  if canPlace(c, state, at):
    setState(c, at, state)
  if nextF32(random) < 0.25'f32:
    let s = defaultStateOf(randomTagBlock(TagCorals, random))
    if canPlace(c, s, above):
      setState(c, above, s)
  elif nextF32(random) < 0.05'f32:
    let s = stateWith(BSeaPickle, [(name: "pickles", value: $(nextBoundedI32(random, 4) + 1))])
    if canPlace(c, s, above):
      setState(c, above, s)
  for dir in HorizontalWorldgen:
    let dp = offset(at, dir)
    if nextF32(random) >= 0.2'f32 or getBlockId(c, dp) != BWater:
      continue
    let wall = randomTagBlock(TagWallCorals, random)
    let name = case dir
      of BlockDirection.North: "north"
      of BlockDirection.South: "south"
      of BlockDirection.West: "west"
      else: "east"
    let s = stateWith(wall, [(name: "facing", value: name)])
    if canPlace(c, s, dp):
      setState(c, dp, s)
  true

proc generateCoralClaw*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `CoralClawFeature::generate`
  let blk = defaultStateOf(randomTagBlock(TagCoralBlocks, random))
  if not generateCoralPiece(c, random, blk, at):
    return false
  let clawDir = randomHorizontal(random)
  let nBranches = nextBoundedI32(random, 2) + 2
  var possible = @[clawDir, rotateClockwise(clawDir), rotateCounterClockwise(clawDir)]
  shuffle(possible, random)
  for i in 0 ..< min(int(nBranches), possible.len):
    let branch = possible[i]
    var p = offset(at, branch)
    let sideway = nextBoundedI32(random, 2) + 1
    var segment = clawDir
    var inway = 0'i32
    if branch == clawDir:
      segment = clawDir
      inway = nextBoundedI32(random, 3) + 2
    else:
      p = p.up()
      segment = if nextBool(random): branch else: BlockDirection.Up
      inway = nextBoundedI32(random, 3) + 3
    for k in 0'i32 ..< sideway:
      if not generateCoralPiece(c, random, blk, p):
        break
      p = offset(p, segment)
    p = offset(p, opposite(segment))
    p = p.up()
    for k in 0'i32 ..< inway:
      p = offset(p, clawDir)
      if not generateCoralPiece(c, random, blk, p):
        break
      if nextF32(random) < 0.25'f32:
        p = p.up()
  true

proc generateCoralMushroom*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `CoralMushroomFeature::generate`
  let blk = defaultStateOf(randomTagBlock(TagCoralBlocks, random))
  let height = nextBoundedI32(random, 3) + 3
  let width = nextBoundedI32(random, 3) + 3
  let length = nextBoundedI32(random, 3) + 3
  let sink = nextBoundedI32(random, 3) + 1
  for x in 0'i32 .. width:
    for y in 0'i32 .. height:
      for z in 0'i32 .. length:
        let a = (x != 0 and x != width) or (y != 0 and y != height)
        let b = (z != 0 and z != length) or (y != 0 and y != height)
        let d = (x != 0 and x != width) or (z != 0 and z != length)
        let e = x == 0 or x == width or y == 0 or y == height or z == 0 or z == length
        if a and b and d and e and nextF32(random) >= 0.1'f32:
          discard generateCoralPiece(c, random, blk, pos(at.x + x, at.y + y - sink, at.z + z))
  true

proc generateCoralTree*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `CoralTreeFeature::generate`
  let blk = defaultStateOf(randomTagBlock(TagCoralBlocks, random))
  var cur = at
  let trunkHeight = nextBoundedI32(random, 3) + 1
  for i in 0'i32 ..< trunkHeight:
    if not generateCoralPiece(c, random, blk, cur):
      return true
    cur = cur.up()
  let top = cur
  let nBranches = nextBoundedI32(random, 3) + 2
  var dirs = @HorizontalWorldgen
  shuffle(dirs, random)
  for i in 0 ..< min(int(nBranches), dirs.len):
    let d = dirs[i]
    var bp = offset(top, d)
    let branchHeight = nextBoundedI32(random, 5) + 2
    var segment = 0'i32
    for j in 0'i32 ..< branchHeight:
      if not generateCoralPiece(c, random, blk, bp):
        break
      inc segment
      bp = bp.up()
      if j == 0 or (segment >= 2 and nextF32(random) < 0.25'f32):
        bp = offset(bp, d)
        segment = 0
  true

# --- dripstone --------------------------------------------------------------------------------------------------------

proc canReplaceDrip(s: BlockStateId): bool {.inline.} =
  blockIdOf(s) == BDripstoneBlock or hasBlockTag(s, TagDripstoneReplaceable)

proc genDripstone(c: FeatureContext, at: BlockPos): bool =
  if hasBlockTag(getState(c, at), TagDripstoneReplaceable):
    setState(c, at, SDripstoneBlock)
    return true
  false

proc growPointedDripstone(c: FeatureContext, start: BlockPos, tip: BlockDirection, height: int32, mergedTip: bool) =
  var cur = start
  let vert = if tip == BlockDirection.Down: "down" else: "up"
  var thicknesses = newSeq[string](0)
  if height >= 3:
    thicknesses.add("base")
    for i in 0'i32 ..< height - 3:
      thicknesses.add("middle")
  if height >= 2:
    thicknesses.add("frustum")
  if height >= 1:
    thicknesses.add(if mergedTip: "tip_merge" else: "tip")
  for i in 0 ..< thicknesses.len:
    let water = getBlockId(c, cur) == BWater
    setState(c, cur, stateWith(BPointedDripstone, [(name: "thickness", value: thicknesses[i]),
      (name: "vertical_direction", value: vert), (name: "waterlogged", value: boolStr(water))]))
    cur = offset(cur, tip)

proc generateDripstoneCluster*(c: FeatureContext, at: BlockPos): bool =
  ## `DripstoneClusterFeature::generate`
  result = false
  let radius = 3'i32
  var dx = -radius
  while dx <= radius:
    var dz = -radius
    while dz <= radius:
      if dx * dx + dz * dz <= radius * radius:
        var cur = pos(at.x + dx, at.y, at.z + dz)
        while airAt(c, cur) and cur.y > bottomY(c) + 2:
          cur = cur.down()
        if genDripstone(c, cur):
          result = true
          if airAt(c, cur.up()):
            setState(c, cur.up(), defaultStateOf(BPointedDripstone))
      inc dz
    inc dx

proc generateLargeDripstone*(c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `LargeDripstoneFeature::generate`
  let height = nextBoundedI32(random, 8) + 4
  result = false
  var cur = at
  while airAt(c, cur) and cur.y > bottomY(c) + 2:
    cur = cur.down()
  for i in 0'i32 ..< height:
    if genDripstone(c, pos(cur.x, cur.y + i, cur.z)):
      result = true

proc generatePointedDripstone*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, at: BlockPos): bool =
  ## `SmallDripstoneFeature::generate`
  let up = canReplaceDrip(getState(c, at.up()))
  let down = canReplaceDrip(getState(c, at.down()))
  var dir = BlockDirection.Down
  if up and down:
    dir = if nextBool(random): BlockDirection.Down else: BlockDirection.Up
  elif up:
    dir = BlockDirection.Down
  elif down:
    dir = BlockDirection.Up
  else:
    return false
  let root = offset(at, opposite(dir))
  discard genDripstone(c, root)
  for d in HorizontalWorldgen:
    if nextF32(random) > f.directionalSpread:
      continue
    let p1 = offset(root, d)
    discard genDripstone(c, p1)
    if nextF32(random) > f.spreadRadius2:
      continue
    let p2 = offset(p1, randomDirection(random))
    discard genDripstone(c, p2)
    if nextF32(random) > f.spreadRadius3:
      continue
    let p3 = offset(p2, randomDirection(random))
    discard genDripstone(c, p3)
  let next = getBlockId(c, offset(at, dir))
  let isEmpty = next == BAir or next == BCaveAir or next == BVoidAir or next == BWater
  let height = if nextF32(random) < f.tallerDripstone and isEmpty: 2'i32 else: 1'i32
  growPointedDripstone(c, at, dir, height, false)
  true

# --- geode ------------------------------------------------------------------------------------------------------------

proc inIds(ids: seq[uint16], id: int): bool =
  for x in ids:
    if int(x) == id:
      return true
  false

proc safeSetBlock(f: ConfiguredFeatureDef, c: FeatureContext, p: BlockPos, s: BlockStateId) =
  let existing = getState(c, p)
  if isAir(existing) or not inIds(f.cannotReplace, blockIdOf(existing)):
    setState(c, p, s)

proc dirNameOf(d: BlockDirection): string =
  case d
  of BlockDirection.Up: "up"
  of BlockDirection.Down: "down"
  of BlockDirection.North: "north"
  of BlockDirection.South: "south"
  of BlockDirection.West: "west"
  of BlockDirection.East: "east"

proc generateGeode*(f: ConfiguredFeatureDef, c: FeatureContext, random: var RandomGenerator, origin: BlockPos): bool =
  ## `GeodeFeature::generate`
  var points = newSeq[(BlockPos, int32)](0)
  let numPoints = get(f.distributionPoints, random)
  var noiseRandom = toRandomGenerator(legacy_rand.fromSeed(cast[uint64](c.worldSeed)))
  let noise = newDoublePerlinNoiseSampler(noiseRandom, -4'i32, [1.0'f64], 0.16666666666666666'f64 / (0.1'f64 * (1.0'f64 + 1.0'f64 / 1.0'f64)), false)
  var crackPoints = newSeq[BlockPos](0)
  let crackAdjust = float64(numPoints) / float64(getMax(f.outerWallDistance))
  let innerAir = 1.0 / sqrt(f.filling)
  let innermost = 1.0 / sqrt(f.innerLayer + crackAdjust)
  let innerCrust = 1.0 / sqrt(f.middleLayer + crackAdjust)
  let outerCrust = 1.0 / sqrt(f.outerLayer + crackAdjust)
  let crackSize = 1.0 / sqrt(f.baseCrackSize + nextF64(random) / 2.0 + (if numPoints > 3: crackAdjust else: 0.0))
  let shouldCrack = float64(nextF32(random)) < f.generateCrackChance
  var numInvalid = 0'i32
  for i in 0'i32 ..< numPoints:
    let x = get(f.outerWallDistance, random)
    let y = get(f.outerWallDistance, random)
    let z = get(f.outerWallDistance, random)
    let p = origin.add(x, y, z)
    let s = getState(c, p)
    if isAir(s) or inIds(f.invalidBlocks, blockIdOf(s)):
      inc numInvalid
      if numInvalid > f.invalidBlocksThreshold:
        return false
    points.add((p, get(f.pointOffset, random)))
  if shouldCrack:
    let oi = nextBoundedI32(random, 4)
    let co = numPoints * 2 + 1
    case oi
    of 0:
      crackPoints.add(origin.add(co, 7, 0))
      crackPoints.add(origin.add(co, 5, 0))
      crackPoints.add(origin.add(co, 1, 0))
    of 1:
      crackPoints.add(origin.add(0, 7, co))
      crackPoints.add(origin.add(0, 5, co))
      crackPoints.add(origin.add(0, 1, co))
    of 2:
      crackPoints.add(origin.add(co, 7, co))
      crackPoints.add(origin.add(co, 5, co))
      crackPoints.add(origin.add(co, 1, co))
    else:
      crackPoints.add(origin.add(0, 7, 0))
      crackPoints.add(origin.add(0, 5, 0))
      crackPoints.add(origin.add(0, 1, 0))
  var potential = newSeq[BlockPos](0)
  # `BlockPos::iterate`: x fastest, then y, then z.
  var pz = origin.z + f.minGenOffset
  while pz <= origin.z + f.maxGenOffset:
    var py = origin.y + f.minGenOffset
    while py <= origin.y + f.maxGenOffset:
      var px = origin.x + f.minGenOffset
      while px <= origin.x + f.maxGenOffset:
        let inside = pos(px, py, pz)
        let noiseOffset = sample(noise, float64(px), float64(py), float64(pz)) * f.noiseMultiplier
        var shell = 0.0'f64
        var crack = 0.0'f64
        for i in 0 ..< points.len:
          let dx = float64(px - points[i][0].x)
          let dy = float64(py - points[i][0].y)
          let dz = float64(pz - points[i][0].z)
          shell += 1.0 / sqrt(dx * dx + dy * dy + dz * dz + float64(points[i][1])) + noiseOffset
        for i in 0 ..< crackPoints.len:
          let dx = float64(px - crackPoints[i].x)
          let dy = float64(py - crackPoints[i].y)
          let dz = float64(pz - crackPoints[i].z)
          crack += 1.0 / sqrt(dx * dx + dy * dy + dz * dz + float64(f.crackPointOffset)) + noiseOffset
        if shell >= outerCrust:
          if shouldCrack and crack >= crackSize and shell < innerAir:
            safeSetBlock(f, c, inside, SAir)
          elif shell >= innerAir:
            safeSetBlock(f, c, inside, get(f.fillingProvider, random, inside, c.chunk, c.blockRegistry))
          elif shell >= innermost:
            let useAlt = float64(nextF32(random)) < f.useAlternateLayer0Chance
            if useAlt:
              safeSetBlock(f, c, inside, get(f.alternateInnerLayerProvider, random, inside, c.chunk, c.blockRegistry))
            else:
              safeSetBlock(f, c, inside, get(f.innerLayerProvider, random, inside, c.chunk, c.blockRegistry))
            if (not f.placementsRequireLayer0Alternate or useAlt) and float64(nextF32(random)) < f.usePotentialPlacementsChance:
              potential.add(inside)
          elif shell >= innerCrust:
            safeSetBlock(f, c, inside, get(f.middleLayerProvider, random, inside, c.chunk, c.blockRegistry))
          elif shell >= outerCrust:
            safeSetBlock(f, c, inside, get(f.outerLayerProvider, random, inside, c.chunk, c.blockRegistry))
        inc px
      inc py
    inc pz
  for i in 0 ..< potential.len:
    let baseCodec = f.innerPlacements[int(nextBoundedI32(random, int32(f.innerPlacements.len)))]
    for dir in AllDirections:
      let pp = offset(potential[i], dir)
      let ps = getState(c, pp)
      let isWater = blockIdOf(ps) == BWater
      if isAir(ps) or isWater:
        var s = getStateId(baseCodec)
        if hasProp(s, "facing"):
          s = withProp(s, "facing", dirNameOf(dir))
        if hasProp(s, "waterlogged"):
          s = withProp(s, "waterlogged", boolStr(isWater))
        safeSetBlock(f, c, pp, s)
        break
  true
