## Tests for placed_features.aowl, configured_features.aowl, survival.aowl and features/*.aowl. The candidate order is the
## newer checkout's `modifier_candidates_interleave_with_feature_rng`; the rest are known answers worked from vanilla's code.
## The whole of decoration is compared to a real 1.21.11 save by a tool outside the repo, as the terrain's was.

{.feature: "lenientnils".}

import std/syncio
import ../../../util/xoroshiro128
import ../../../util/worldgen_random as worldgen_random
import ../../../generated/biome
import ../../../generated/placed_feature as placedenum
import ../../../generated/configured_feature as configuredenum
import ../../../util/math/pool
import types
import common
import decode
import placed_features
import configured_features
import survival

var failures = 0

proc expect(ok: bool, what: string) =
  if not ok:
    echo "FAIL ", what
    inc failures

proc topAt(chunk: ProtoChunk, x: int32): BlockStateId =
  getBlockState(chunk, vec3[int32](x, 64'i32, 0'i32))

proc freshRandom(): RandomGenerator =
  toRandomGenerator(worldgen_random.fromSeed(42'u64))

proc freshChunk(): ProtoChunk =
  newProtoChunkRaw(0'i32, 0'i32, stateOfName("stone"), 0'i64, 384'i32, -64'i32)

proc context(chunk: ProtoChunk): FeatureContext =
  let cache = protoChunkAsGenerationCache(chunk)
  FeatureContext(chunk: cache, blockRegistry: worldgenPortal(), minY: -64'i8, height: 384'u16, worldSeed: 1'i64, seaLevel: 63'i32,
    accessor: generationCacheAsAccessor(cache), feature: placedenum.PlacedFeature(0))

installFeatureHooks()

# JavaBlockPosHashSet: order is OpenJDK's, by hash bucket and then insertion, through a resize.
block:
  var s = newJavaBlockPosHashSet()
  for i in 0'i32 ..< 20'i32:
    s.incl(pos(i, 0'i32, 0'i32))
  s.incl(pos(3'i32, 0'i32, 0'i32))
  expect(s.len == 20, "set size")
  # `31 * (y + 31 * z) + x` with y = z = 0 is x, and a table of 32 buckets holds 0..19 in order.
  let order = toSeq(s)
  for i in 0 ..< order.len:
    expect(order[i].x == int32(i), "hash order")

# mthSin is Mojang's table, not libm.
block:
  expect(mthSin(0.0'f32) == 0.0'f32, "sin 0")
  expect(mthSin(1.5707964'f32) == 1.0'f32, "sin pi/2")
  expect(mthCos(0.0'f32) == 1.0'f32, "cos 0")

# Each candidate walks the rest of the modifiers and the feature before the next one draws.
block:
  let chunk = freshChunk()
  let c = context(chunk)
  # `count 2`, `in_square`, then a block: in_square's two draws and the state's interleave.
  let inner = ConfiguredFeatureDef(kind: ConfiguredFeatureKind.SimpleBlock, stateProvider: BlockStateProvider(
    kind: BlockStateProviderKind.WeightedList, entries: @[Weighted[BlockStateId](data: stateOfName("stone"), weight: 1'i32),
      Weighted[BlockStateId](data: stateOfName("dirt"), weight: 1'i32)]))
  let p = PlacedFeatureDef(featureKind: FeatureRefKind.Inlined, inlined: inner, placement: @[
    PlacementModifier(kind: PlacementModifierKind.Count, count: intProvider(2'i32)),
    PlacementModifier(kind: PlacementModifierKind.InSquare)])
  var random = toRandomGenerator(worldgen_random.fromSeed(77'u64))
  discard generatePlaced(p, c, random, pos(0'i32, 0'i32, 0'i32))
  var expected = toRandomGenerator(worldgen_random.fromSeed(77'u64))
  let x1 = nextBoundedI32(expected, 16'i32)
  let z1 = nextBoundedI32(expected, 16'i32)
  let s1 = nextBoundedI32(expected, 2'i32)
  let x2 = nextBoundedI32(expected, 16'i32)
  let z2 = nextBoundedI32(expected, 16'i32)
  let s2 = nextBoundedI32(expected, 2'i32)
  expect(nextI64(random) == nextI64(expected), "the same draws in total")
  let at1 = getBlockState(chunk, vec3[int32](x1, 0'i32, z1))
  let at2 = getBlockState(chunk, vec3[int32](x2, 0'i32, z2))
  if x1 != x2 or z1 != z2:
    expect(at1 == (if s1 == 0: stateOfName("stone") else: stateOfName("dirt")), "first candidate's state")
  expect(at2 == (if s2 == 0: stateOfName("stone") else: stateOfName("dirt")), "second candidate's state")

# would_survive through the portal: a sapling takes dirt, not stone.
block:
  let chunk = freshChunk()
  let c = context(chunk)
  setBlockState(chunk, 1'i32, 60'i32, 1'i32, stateOfName("dirt"))
  setBlockState(chunk, 2'i32, 60'i32, 2'i32, stateOfName("stone"))
  let sapling = stateOfName("oak_sapling")
  expect(canPlace(c, sapling, pos(1'i32, 61'i32, 1'i32)), "sapling on dirt")
  expect(not canPlace(c, sapling, pos(2'i32, 61'i32, 2'i32)), "sapling on stone")
  setBlockState(chunk, 3'i32, 60'i32, 3'i32, stateOfName("sand"))
  expect(not canPlace(c, stateOfName("sugar_cane"), pos(3'i32, 61'i32, 3'i32)), "sugar cane with no water")
  setBlockState(chunk, 4'i32, 60'i32, 3'i32, stateOfName("water"))
  expect(canPlace(c, stateOfName("sugar_cane"), pos(3'i32, 61'i32, 3'i32)), "sugar cane by water")

# Heightmaps fall when the top of a column goes, as vanilla's `Heightmap.update` does.
block:
  let chunk = freshChunk()
  setBlockState(chunk, 5'i32, 70'i32, 5'i32, stateOfName("stone"))
  setBlockState(chunk, 5'i32, 75'i32, 5'i32, stateOfName("stone"))
  expect(topBlockHeightExclusive(chunk, 5'i32, 5'i32) == 76'i32, "height up")
  setBlockState(chunk, 5'i32, 75'i32, 5'i32, stateOfName("air"))
  expect(topBlockHeightExclusive(chunk, 5'i32, 5'i32) == 71'i32, "height back down")

# Ore: a vein in solid stone replaces only what its rule matches, and is deterministic.
block:
  let chunk = freshChunk()
  for i in 0 ..< chunk.flatBlockMap.len:
    chunk.flatBlockMap[i] = stateOfName("stone")
  primeHeightmapsOnce(chunk)
  let c = context(chunk)
  let (found, name) = configuredenum.ConfiguredFeature.fromName("ore_iron")
  expect(found, "ore_iron is named")
  var random = toRandomGenerator(worldgen_random.fromSeed(5'u64))
  expect(generateConfigured(configuredFeatureDef(name), c, random, pos(8'i32, 40'i32, 8'i32)), "ore placed")
  var ore = 0
  let iron = stateOfName("iron_ore")
  for i in 0 ..< chunk.flatBlockMap.len:
    if chunk.flatBlockMap[i] == iron:
      inc ore
  expect(ore > 0 and ore <= 90, "a vein of plausible size")

# The newer checkout's freeze_top_layer tests: `snow_placement_rules`, less its block light case, as block light is unset
# during generation here, `full_snow_layer_supports_snow` and `partial_snow_layer_does_not_support_snow`.
block:
  let chunk = freshChunk()
  for i in 0 ..< chunk.flatBiomeMap.len:
    chunk.flatBiomeMap[i] = SNOWY_PLAINS.id
  for x in 0'i32 ..< 16'i32:
    for z in 0'i32 ..< 16'i32:
      setBlockState(chunk, x, 63'i32, z, stateOfName("stone"))
  setBlockState(chunk, 1'i32, 63'i32, 0'i32, stateOfName("oak_slab"))
  setBlockState(chunk, 2'i32, 63'i32, 0'i32, stateOfName("soul_sand"))
  setBlockState(chunk, 4'i32, 63'i32, 0'i32, withProp(stateOfName("snow"), "layers", "8"))
  setBlockState(chunk, 5'i32, 63'i32, 0'i32, withProp(stateOfName("snow"), "layers", "4"))
  # As upstream's tests do: snow never blocks motion, so the column's top is set by hand.
  chunk.flatMotionBlockingHeightMap[localPositionToHeightMapIndex(4'i32, 0'i32)] = 63'i16
  chunk.flatMotionBlockingHeightMap[localPositionToHeightMapIndex(5'i32, 0'i32)] = 63'i16
  let c = context(chunk)
  var fr = freshRandom()
  discard generateConfigured(ConfiguredFeatureDef(kind: ConfiguredFeatureKind.FreezeTopLayer), c, fr, pos(0'i32, 0'i32, 0'i32))
  let snow = stateOfName("snow")
  expect(topAt(chunk, 0'i32) == snow, "snow on a full face")
  expect(isAir(topAt(chunk, 1'i32)), "no snow on a slab")
  expect(topAt(chunk, 2'i32) == snow, "snow on soul sand, by its tag")
  expect(topAt(chunk, 4'i32) == snow, "snow on a full eight-layer snow block")
  expect(isAir(topAt(chunk, 5'i32)), "no snow on a partial layer")

if failures > 0:
  echo failures, " checks failed"
  quit(1)
echo "featurestest ok"
