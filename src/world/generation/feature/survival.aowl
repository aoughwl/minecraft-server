## The `block_registry.can_place_at` world generation asks: a `WorldPortalExt` that answers for the blocks features place,
## with no world behind it. Port of the `can_place_at` of the plants in pumpkin/src/block/blocks/plant/*.rs and
## pumpkin/src/block/blocks/coral/*.rs, which sit in the main crate, where the port of src/server has no block registry
## yet: without an answer here, `would_survive` and `simple_block` pass everywhere, a tree grows on bare stone and the rest
## of that feature's draws go wrong.
##
## Vanilla's mushroom asks for the light level, which is unset this early in generation, so it counts as dark.
##
## PARTIAL: pumpkin/src/block/blocks/plant/mod.rs - only the placement checks features reach, as a stand-in for the block registry; the server's `WorldPortal` replaces it when it exists.

{.feature: "lenientnils".}

import ../../../generated/tag
import ../../../generated/block_states
import types
import common

let
  TagVegetation = blockTag("supports_vegetation")
  TagDryVegetation = blockTag("supports_dry_vegetation")
  TagMangrove = blockTag("supports_mangrove_propagule")
  TagAzalea = blockTag("supports_azalea")
  TagSugarCane = blockTag("supports_sugar_cane")
  TagSugarCaneAdjacent = blockTag("supports_sugar_cane_adjacently")
  TagCactus = blockTag("supports_cactus")
  TagLilyPad = blockTag("supports_lily_pad")
  TagBamboo = blockTag("supports_bamboo")
  TagCrimsonRoots = blockTag("supports_crimson_roots")
  TagWarpedRoots = blockTag("supports_warped_roots")
  TagCrimsonFungus = blockTag("supports_crimson_fungus")
  TagWarpedFungus = blockTag("supports_warped_fungus")
  TagSmallDripleaf = blockTag("supports_small_dripleaf")
  TagMushroomOverride = blockTag("overrides_mushroom_light_requirement")
  TagDirt = blockTag("dirt")
  TagCorals = blockTag("corals")
  TagWallCorals = blockTag("wall_corals")
  TagSoulFireBase = blockTag("soul_fire_base_blocks")
  BSugarCane = blockIdOfName("sugar_cane")
  BCactus = blockIdOfName("cactus")
  BFarmland = blockIdOfName("farmland")
  BSporeBlossom = blockIdOfName("spore_blossom")
  BMossCarpet = blockIdOfName("moss_carpet")
  BPaleMossCarpet = blockIdOfName("pale_moss_carpet")
  BSeaPickle = blockIdOfName("sea_pickle")
  BBamboo = blockIdOfName("bamboo")
  BLilyPad = blockIdOfName("lily_pad")
  BSoulFire = blockIdOfName("soul_fire")
  BFire = blockIdOfName("fire")

type Rule {.pure.} = enum
  Always, Vegetation, DryVegetation, Mangrove, Azalea, SugarCane, Cactus, LilyPad, Bamboo, CrimsonRoots, WarpedRoots,
  CrimsonFungus, WarpedFungus, SmallDripleaf, Mushroom, FlowerBed, LeafLitter, SolidCenterBelow, WallCoral, Carpet,
  SporeBlossom, SoulFire, Fire

proc buildRules(): seq[Rule] =
  result = newSeq[Rule](BsBlocks.len)
  template setRules(rule: Rule, names: openArray[string]) =
    for n in names:
      result[blockIdOfName(n)] = rule
  setRules(Rule.Vegetation, ["oak_sapling", "spruce_sapling", "birch_sapling", "jungle_sapling", "acacia_sapling", "cherry_sapling",
    "dark_oak_sapling", "pale_oak_sapling", "dandelion", "poppy", "blue_orchid", "allium", "azure_bluet", "red_tulip",
    "orange_tulip", "white_tulip", "pink_tulip", "oxeye_daisy", "cornflower", "lily_of_the_valley", "torchflower",
    "open_eyeblossom", "closed_eyeblossom", "short_grass", "fern", "tall_grass", "large_fern", "sunflower", "lilac", "rose_bush",
    "peony", "bush", "firefly_bush", "sweet_berry_bush"])
  setRules(Rule.DryVegetation, ["dead_bush", "short_dry_grass", "tall_dry_grass"])
  setRules(Rule.Azalea, ["azalea", "flowering_azalea"])
  setRules(Rule.CrimsonRoots, ["crimson_roots"])
  setRules(Rule.WarpedRoots, ["warped_roots", "nether_sprouts"])
  setRules(Rule.CrimsonFungus, ["crimson_fungus"])
  setRules(Rule.WarpedFungus, ["warped_fungus"])
  setRules(Rule.Mushroom, ["brown_mushroom", "red_mushroom"])
  setRules(Rule.FlowerBed, ["pink_petals", "wildflowers"])
  setRules(Rule.LeafLitter, ["leaf_litter"])
  result[blockIdOfName("mangrove_propagule")] = Rule.Mangrove
  result[BSugarCane] = Rule.SugarCane
  result[BCactus] = Rule.Cactus
  result[BLilyPad] = Rule.LilyPad
  result[BBamboo] = Rule.Bamboo
  result[blockIdOfName("small_dripleaf")] = Rule.SmallDripleaf
  result[BSeaPickle] = Rule.SolidCenterBelow
  result[BMossCarpet] = Rule.Carpet
  result[BPaleMossCarpet] = Rule.Carpet
  result[BSporeBlossom] = Rule.SporeBlossom
  result[BSoulFire] = Rule.SoulFire
  result[BFire] = Rule.Fire
  for i in 0 ..< TagCorals.ids.len:
    result[int(TagCorals.ids[i])] = Rule.SolidCenterBelow
  for i in 0 ..< TagWallCorals.ids.len:
    result[int(TagWallCorals.ids[i])] = Rule.WallCoral

let Rules = buildRules()

proc facingOf(state: BlockStateId): BlockDirection =
  case propValue(state, "facing")
  of "south": BlockDirection.South
  of "west": BlockDirection.West
  of "east": BlockDirection.East
  else: BlockDirection.North

proc survivalCheck*(blockId: int, state: BlockStateId, a: BlockAccessor, p: BlockPos): bool =
  ## `BlockState.canSurvive` for one block, by the rule its class has.
  let below = stateIdAt(a, p.down())
  case Rules[blockId]
  of Rule.Always: true
  of Rule.Vegetation: hasBlockTag(below, TagVegetation)
  of Rule.DryVegetation: hasBlockTag(below, TagDryVegetation)
  of Rule.Mangrove: hasBlockTag(below, TagMangrove)
  of Rule.Azalea: hasBlockTag(below, TagAzalea)
  of Rule.SugarCane:
    if blockIdOf(below) == BSugarCane:
      return true
    if not hasBlockTag(below, TagSugarCane):
      return false
    let d = p.down()
    for dir in HorizontalWorldgen:
      let n = stateIdAt(a, offset(d, dir))
      if hasBlockTag(n, TagSugarCaneAdjacent) or blockIdOf(n) == BWater:
        return true
    false
  of Rule.Cactus:
    for dir in HorizontalWorldgen:
      let n = stateIdAt(a, offset(p, dir))
      if isSolid(n) or blockIdOf(n) == BLava:
        return false
    (blockIdOf(below) == BCactus or hasBlockTag(below, TagCactus)) and not isLiquid(stateIdAt(a, p.up()))
  of Rule.LilyPad:
    (hasBlockTag(below, TagLilyPad) or blockIdOf(below) == BWater) and isAir(stateIdAt(a, p))
  of Rule.Bamboo: hasBlockTag(below, TagBamboo)
  of Rule.CrimsonRoots: hasBlockTag(below, TagCrimsonRoots)
  of Rule.WarpedRoots: hasBlockTag(below, TagWarpedRoots)
  of Rule.CrimsonFungus: hasBlockTag(below, TagCrimsonFungus)
  of Rule.WarpedFungus: hasBlockTag(below, TagWarpedFungus)
  of Rule.SmallDripleaf:
    let replacing = blockIdOf(stateIdAt(a, p))
    hasBlockTag(below, TagVegetation) and replacing == BWater or hasBlockTag(below, TagSmallDripleaf)
  of Rule.Mushroom:
    hasBlockTag(below, TagMushroomOverride) or isSolidBlock(below)
  of Rule.FlowerBed:
    hasBlockTag(below, TagDirt) or blockIdOf(below) == BFarmland
  of Rule.LeafLitter: sideSolid(below, BlockDirection.Up)
  of Rule.SolidCenterBelow: sideSolid(below, BlockDirection.Up)
  of Rule.WallCoral:
    let d = facingOf(state)
    sideSolid(stateIdAt(a, offset(p, opposite(d))), d)
  of Rule.Carpet: not isAir(below)
  of Rule.SporeBlossom: sideSolid(stateIdAt(a, p.up()), BlockDirection.Down)
  of Rule.SoulFire: hasBlockTag(below, TagSoulFireBase)
  of Rule.Fire: sideSolid(below, BlockDirection.Up)

proc worldgenPortal*(): WorldPortalExt =
  ## `noOpWorldPortal`, with `can_place_at` answering.
  result = noOpWorldPortal()
  result.canPlaceAt = proc(blockId: int, state: BlockStateId, accessor: BlockAccessor, pos: BlockPos): bool {.closure.} =
    survivalCheck(blockId, state, accessor, pos)
