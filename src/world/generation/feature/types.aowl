## The types of pumpkin-world/src/generation/feature, in one module because they hold one another: a `ConfiguredFeature`
## holds a `RandomFeature`, which holds a `PlacedFeature`, which holds a `ConfiguredFeature`. Upstream's modules have
## their structs beside their logic; here each logic module under features/ names the upstream files it ports.
## Port of pumpkin-world/src/generation/feature/size.rs, and the struct and enum declarations of
## pumpkin-world/src/generation/feature/placed_features.rs and pumpkin-world/src/generation/feature/configured_features.rs.
##
## Each enum of structs is one object with a kind and only its own fields set, as block_predicate.aowl does: a case
## object cannot hold its own type (COMPILER-BUGS.md bug 4).

{.feature: "lenientnils".}

import ../../blockstates
import ../../blockcodec
import ../../tick
import ../../world
import ../../../data/block_direction
from ../../../generated/carver import HeightProvider, HeightProviderKind
import ../../../generated/tag
import ../../../generated/placed_feature as placedenum
import ../../../generated/configured_feature as configuredenum
import ../../../generated/placed_features_generated
import ../../../generated/configured_features_generated
import ../../../util/math/int_provider
import ../../../util/random/random
import ../../../util/utillib except BlockDirection, Axis
import ../protochunkbase
import ../block_predicate
import ../block_state_provider
import ../rule/rule

export placed_features_generated, configured_features_generated
export block_predicate, block_state_provider, rule, int_provider, blockcodec, HeightProvider, HeightProviderKind
export utillib.HeightMap, block_direction, world, tick, protochunkbase, random, blockstates

type
  # size.rs

  FeatureSizeTypeKind* {.pure.} = enum
    ThreeLayers, TwoLayers

  FeatureSize* = object
    minClippedHeight*: int32        ## -1 for upstream's None.
    kind*: FeatureSizeTypeKind
    limit*, upperLimit*, lowerSize*, middleSize*, upperSize*: int32

  # tree/

  TreeNode* = object
    center*: BlockPos
    foliageRadius*: int32
    giantTrunk*: bool

  TrunkTypeKind* {.pure.} = enum
    Straight, Forking, Giant, MegaJungle, DarkOak, Fancy, Bending, UpwardsBranching, Cherry

  TrunkPlacer* = object
    baseHeight*, heightRandA*, heightRandB*: int32
    kind*: TrunkTypeKind
    minHeightForLeaves*: int32        ## Bending.
    bendLength*: IntProvider          ## Bending.
    extraBranchSteps*: IntProvider    ## UpwardsBranching.
    placeBranchPerLogProbability*: float32
    extraBranchLength*: IntProvider
    canGrowThrough*: seq[uint16]      ## Block ids.
    count*, horizontalLength*, endOffsetFromTop*: IntProvider  ## Cherry.
    startOffsetMin*, startOffsetMax*: int32

  FoliageTypeKind* {.pure.} = enum
    Blob, Spruce, Pine, Acacia, Bush, Fancy, Jungle, MegaPine, DarkOak, RandomSpread, Cherry

  FoliagePlacer* = object
    radius*, offset*: IntProvider
    kind*: FoliageTypeKind
    height*: int32                     ## Blob, Bush, Fancy, Jungle.
    heightProvider*: IntProvider       ## Pine, Cherry; Spruce's trunk_height; MegaPine's crown_height; RandomSpread's foliage_height.
    leafPlacementAttempts*: int32      ## RandomSpread.
    wideBottomLayerHoleChance*, cornerHoleChance*, hangingLeavesChance*, hangingLeavesExtensionChance*: float32

  TreeDecoratorKind* {.pure.} = enum
    TrunkVine, LeaveVine, PaleMoss, CreakingHeart, Cocoa, Beehive, AlterGround, AttachedToLeaves, PlaceOnGround,
    AttachedToLogs

  TreeDecorator* = ref object
    kind*: TreeDecoratorKind
    probability*: float32
    leavesProbability*, trunkProbability*, groundProbability*: float32  ## PaleMoss.
    provider*: BlockStateProvider      ## AlterGround; attached block_provider; place_on_ground's block_state_provider.
    exclusionRadiusXz*, exclusionRadiusY*, requiredEmptyBlocks*: int32
    directions*: seq[BlockDirection]
    tries*, radius*, height*: int32    ## PlaceOnGround.

  MangroveRootPlacer* = ref object
    trunkOffsetY*: IntProvider
    rootProvider*: BlockStateProvider
    hasAbove*: bool
    aboveRootProvider*: BlockStateProvider
    aboveRootPlacementChance*: float32
    canGrowThrough*, muddyRootsIn*: seq[uint16]
    muddyRootsProvider*: BlockStateProvider
    maxRootWidth*, maxRootLength*: int32
    randomSkewChance*: float32

  TreeFeature* = ref object
    trunkProvider*: BlockStateProvider
    trunkPlacer*: TrunkPlacer
    foliageProvider*: BlockStateProvider
    foliagePlacer*: FoliagePlacer
    minimumSize*: FeatureSize
    ignoreVines*: bool
    decorators*: seq[TreeDecorator]
    belowTrunkProvider*: BlockStateProvider
    rootPlacer*: MangroveRootPlacer    ## nil for upstream's None.

  # placed_features.rs

  FeatureRefKind* {.pure.} = enum
    Named, Inlined

  PlacementModifier* = ref object
    kind*: PlacementModifierKind
    predicate*: BlockPredicate         ## BlockPredicateFilter.
    chance*: uint32                    ## RarityFilter.
    heightmap*: HeightMap              ## SurfaceRelativeThresholdFilter, Heightmap.
    hasMin*, hasMax*: bool
    minInclusive*, maxInclusive*: int32
    maxWaterDepth*: int32              ## SurfaceWaterDepthFilter.
    count*: IntProvider                ## Count, CountOnEveryLayer.
    toCountRatio*: int32               ## NoiseBasedCount.
    factor*, offset*: float64
    noiseLevel*: float64               ## NoiseThresholdCount.
    belowNoise*, aboveNoise*: int32
    directionOfSearch*: BlockDirection ## EnvironmentScan.
    targetCondition*, allowedSearchCondition*: BlockPredicate  ## nil allowed is `AlwaysTrue`.
    maxSteps*: int32
    height*: HeightProvider            ## HeightRange.
    xzSpread*, ySpread*: IntProvider   ## RandomOffset.
    positions*: seq[BlockPos]          ## FixedPlacement.

  PlacedFeatureDef* = ref object
    ## `placed_features::PlacedFeature`. `feature` names the configured feature, or `inlined` is it.
    featureKind*: FeatureRefKind
    feature*: configuredenum.ConfiguredFeature
    inlined*: ConfiguredFeatureDef
    placement*: seq[PlacementModifier]

  PlacedFeatureWrapper* = ref object
    ## `PlacedFeatureWrapper`: `direct` is nil when named.
    named*: placedenum.PlacedFeature
    direct*: PlacedFeatureDef

  # features/

  OreTarget* = object
    target*: RuleTest
    state*: BlockStateId

  RandomFeatureEntry* = object
    feature*: PlacedFeatureWrapper
    chance*: float32

  BlockColumnLayer* = object
    height*: IntProvider
    provider*: BlockStateProvider

  Spike* = object
    centerX*, centerZ*, radius*, height*: int32
    guarded*: bool

  FossilProcessor* {.pure.} = enum
    FossilRot, Coal, Diamonds

  ConfiguredFeatureDef* = ref object
    ## `configured_features::ConfiguredFeature`. Fields used by more than one kind are shared by name.
    kind*: ConfiguredFeatureKind
    probability*: float32               ## Bamboo, Seagrass.
    count*: IntProvider                 ## SeaPickle.
    stateProvider*: BlockStateProvider  ## NetherForestVegetation, Disk, SimpleBlock's to_place, FallenTree's trunk_provider, BlockPile, Lake's fluid.
    barrier*: BlockStateProvider        ## Lake.
    spreadWidth*, spreadHeight*, maxHeight*: int32  ## NetherForestVegetation, TwistingVines.
    state*, targetState*: BlockStateId  ## ReplaceBlobs, SpringFeature, ForestRock, Iceberg, FillLayer.
    radius*: IntProvider                ## ReplaceBlobs, Disk.
    size*: int32                        ## Ore, ScatteredOre.
    discardChanceOnAirExposure*: float32
    targets*: seq[OreTarget]
    requiresBlockBelow*: bool           ## SpringFeature.
    rockCount*, holeCount*: int32
    validBlocks*: seq[string]
    layers*: seq[BlockColumnLayer]      ## BlockColumn.
    direction*: BlockDirection
    allowedPlacement*: BlockPredicate
    prioritizeTip*: bool
    logLength*: IntProvider             ## FallenTree.
    stumpDecorators*, logDecorators*: seq[TreeDecorator]
    tries*, xzSpread*, ySpread*: int32  ## RandomPatch.
    placed*: PlacedFeatureDef           ## RandomPatch's feature, RootSystem's feature, VegetationPatch's vegetation_feature.
    entries*: seq[RandomFeatureEntry]   ## RandomSelector.
    defaultFeature*: PlacedFeatureWrapper
    features*: seq[PlacedFeatureDef]    ## SimpleRandomSelector.
    featureTrue*, featureFalse*: PlacedFeatureWrapper
    spikes*: seq[Spike]                 ## EndSpike.
    crystalInvulnerable*: bool
    tree*: TreeFeature
    tallerDripstone*, directionalSpread*, spreadRadius2*, spreadRadius3*: float32  ## PointedDripstone.
    # Geode
    fillingProvider*, innerLayerProvider*, alternateInnerLayerProvider*, middleLayerProvider*,
      outerLayerProvider*: BlockStateProvider
    innerPlacements*: seq[BlockStateCodec]
    cannotReplace*, invalidBlocks*: seq[uint16]
    filling*, innerLayer*, middleLayer*, outerLayer*: float64
    generateCrackChance*, baseCrackSize*: float64
    crackPointOffset*: int32
    usePotentialPlacementsChance*, useAlternateLayer0Chance*: float64
    placementsRequireLayer0Alternate*: bool
    outerWallDistance*, distributionPoints*, pointOffset*: IntProvider
    minGenOffset*, maxGenOffset*: int32
    noiseMultiplier*: float64
    invalidBlocksThreshold*: int32
    # UnderwaterMagma
    floorSearchRange*, placementRadius*: int32
    placementProbability*: float32
    # VegetationPatch
    replaceable*: BlockPredicate
    groundState*: BlockStateProvider
    surfaceIsCeiling*: bool
    depth*: IntProvider
    extraBottomBlockChance*, vegetationChance*, extraEdgeColumnChance*: float32
    verticalRange*: int32
    xzRadius*: IntProvider
    # BasaltColumns
    columnHeight*, reach*: IntProvider
    # Fossil
    fossilStructures*, overlayStructures*: seq[string]
    fossilProcessor*, overlayProcessor*: FossilProcessor
    maxEmptyCornersAllowed*: int32
    # RootSystem
    requiredVerticalSpaceForTree*, rootRadius*, rootPlacementAttempts*, rootColumnMaxHeight*, hangingRootRadius*,
      hangingRootsVerticalSpan*, hangingRootPlacementAttempts*, allowedVerticalWaterForTree*: int32
    rootReplaceable*, allowedTreePosition*: BlockPredicate
    rootStateProvider*, hangingRootStateProvider*: BlockStateProvider
    # MultifaceGrowth
    placeBlock*: int
    searchRange*: int32
    canPlaceOnFloor*, canPlaceOnCeiling*, canPlaceOnWall*: bool
    chanceOfSpreading*: float32
    canBePlacedOn*: seq[int]
    # HugeFungus
    validBaseBlock*, stemState*, hatState*, decorState*: BlockStateId
    replaceableBlocks*: BlockPredicate
    planted*: bool
    # DeltaFeature
    contents*, rim*: BlockStateId
    deltaSize*, rimSize*: IntProvider
    fillHeight*: int32
    # SculkPatch
    chargeCount*, amountPerCharge*, spreadAttempts*, growthRounds*, spreadRounds*: int32
    extraRareGrowths*: IntProvider
    catalystChance*: float32
    # EndGateway
    hasExit*, exact*: bool
    exit*: BlockPos

  FeatureContext* = ref object
    ## The arguments every `generate` takes: chunk, block_registry, min_y, height and feature_name.
    chunk*: GenerationCache
    blockRegistry*: WorldPortalExt
    minY*: int8
    height*: uint16
    worldSeed*: int64
    seaLevel*: int32
    accessor*: BlockAccessor
    feature*: placedenum.PlacedFeature

var placedGenerateHook*: proc(p: PlacedFeatureDef, ctx: FeatureContext, random: var RandomGenerator,
                              pos: BlockPos): bool {.nimcall.}
  ## `PlacedFeature::generate`. Features that nest one call back up through this, since modules cannot form the cycle
  ## upstream's do; placed_features.aowl sets it.
var placedGetHook*: proc(w: PlacedFeatureWrapper): PlacedFeatureDef {.nimcall.}
  ## `PlacedFeatureWrapper::get`, set likewise.

proc getRadius*(s: FeatureSize, height: uint32, y: int32): int32 =
  ## `FeatureSizeType::get_radius`
  case s.kind
  of FeatureSizeTypeKind.ThreeLayers:
    if y < s.limit: s.lowerSize
    elif y >= int32(height) - s.upperLimit: s.upperSize
    else: s.middleSize
  of FeatureSizeTypeKind.TwoLayers:
    if y < s.limit: s.lowerSize else: s.upperSize
