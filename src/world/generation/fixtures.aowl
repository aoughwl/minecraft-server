## Test support: reads upstream's asset fixtures out of the pinned tree. Only tests import this.
## Tests run from the repo root, as PORTING.md's commands do, so the pinned tree is at ../ref/pumpkin-1.21.11.

{.feature: "lenientnils".}

import std/syncio

const AssetDir* = "../ref/pumpkin-1.21.11/pumpkin-world/assets/"

proc assetPath*(name: string): string = AssetDir & name

proc strtod(s: cstring, endp: pointer): cdouble {.importc: "strtod", header: "<stdlib.h>".}

proc readNumbers*(path: string): seq[float64] =
  ## Every number in a JSON file, in order, whatever the nesting. The numeric fixtures are arrays of arrays of
  ## numbers and the largest are 10MB; a tree parse is not needed to read them. `strtod` rounds correctly, so
  ## a double reads back bit for bit.
  var data = ""
  try:
    data = readFile(path)
  except:
    echo "fixture not readable: ", path
    quit(1)
  result = newSeq[float64](0)
  var i = 0
  let n = data.len
  while i < n:
    let c = data[i]
    if c == '-' or (c >= '0' and c <= '9'):
      var stop = i + 1
      while stop < n and ((data[stop] >= '0' and data[stop] <= '9') or data[stop] == '.' or data[stop] == 'e' or
          data[stop] == 'E' or data[stop] == '-' or data[stop] == '+'):
        inc stop
      var saved = substr(data, i, stop - 1)
      result.add(float64(strtod(toCString(saved), nil)))
      i = stop
    else:
      inc i
