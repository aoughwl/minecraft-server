## World generation's shared pieces: the seed config and coordinate helpers.
## Port of pumpkin-world/src/generation/mod.rs, without `get_world_gen`, which is generator/generator.aowl:
## it needs `WorldGenerator` and this file sits below it.

import ../../util/xoroshiro128

type
  GlobalRandomConfig* = ref object
    seed*: uint64
    legacyRandomSource*: bool
    baseRandomDeriver*: XoroshiroSplitter
    aquiferRandomDeriver*: XoroshiroSplitter
    oreRandomDeriver*: XoroshiroSplitter

  Direction* {.pure.} = enum
    North, NorthEast, East, SouthEast, South, SouthWest, West, NorthWest

proc newGlobalRandomConfig*(seed: uint64, legacyRandomSource: bool): GlobalRandomConfig =
  ## `GlobalRandomConfig::new`
  var seeded = xoroshiro128.fromSeed(seed)
  let randomDeriver = newSplitter(seeded)
  var aquiferSource = splitString(randomDeriver, "minecraft:aquifer")
  let aquiferDeriver = newSplitter(aquiferSource)
  var oreSource = splitString(randomDeriver, "minecraft:ore")
  let oreDeriver = newSplitter(oreSource)
  GlobalRandomConfig(seed: seed, legacyRandomSource: legacyRandomSource, baseRandomDeriver: randomDeriver,
    aquiferRandomDeriver: aquiferDeriver, oreRandomDeriver: oreDeriver)

# `section_coords`

proc blockToSection*(coord: int32): int32 {.inline.} = coord shr 4
proc sectionToBlock*(coord: int32): int32 {.inline.} = coord shl 4
proc getOffsetPos*(chunkCoord, offset: int32): int32 {.inline.} = sectionToBlock(chunkCoord) + offset

# `biome_coords`

proc biomeFromBlock*(coord: int32): int32 {.inline.} = coord shr 2
proc biomeToBlock*(coord: int32): int32 {.inline.} = coord shl 2
proc biomeFromChunk*(coord: int32): int32 {.inline.} = coord shl 2
proc biomeToChunk*(coord: int32): int32 {.inline.} = coord shr 2

# Rust's float min and max, which every range calculation here goes through: when one side is NaN the other
# is returned. A plain comparison would keep the NaN, and an infinite range times zero does make one.

proc rmin*(a, b: float64): float64 {.inline.} =
  if a != a: b
  elif b != b: a
  elif a < b: a
  else: b

proc rmax*(a, b: float64): float64 {.inline.} =
  if a != a: b
  elif b != b: a
  elif a > b: a
  else: b

proc rmin*(a, b: float32): float32 {.inline.} =
  if a != a: b
  elif b != b: a
  elif a < b: a
  else: b

proc rmax*(a, b: float32): float32 {.inline.} =
  if a != a: b
  elif b != b: a
  elif a > b: a
  else: b
