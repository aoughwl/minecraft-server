## Port of pumpkin-world/src/generation/generator/flat.rs

{.feature: "lenientnils".}

import ../../blockstates
import ../../../generated/dimension
import ../../../generated/biome
import ../protochunkbase
import ../positions

type
  FlatLayer* = object
    ## `generation::generator::FlatLayer`
    block_name*: string
    height*: int32

  FlatGenerator* = ref object
    seed*: uint64
    dimension*: Dimension
    layers*: seq[FlatLayer]
    biome*: string

proc newFlatGenerator*(seed: uint64, dimension: Dimension, layers: seq[FlatLayer], biome: string): FlatGenerator =
  FlatGenerator(seed: seed, dimension: dimension, layers: layers, biome: biome)

proc stepToBiomes*(g: FlatGenerator, chunk: ProtoChunk) =
  let (found, id) = biomeIdByName(g.biome)
  let biomeId = if found: uint8(id) else: PLAINS.id
  for i in 0 ..< chunk.flatBiomeMap.len:
    chunk.flatBiomeMap[i] = biomeId
  chunk.stage = StagedChunkEnum.Biomes

proc stepToNoise*(g: FlatGenerator, chunk: ProtoChunk) =
  let startX = startBlockX(chunk.x)
  let startZ = startBlockZ(chunk.z)
  for x in 0'i32 ..< 16'i32:
    for z in 0'i32 ..< 16'i32:
      var currentY = int32(bottomY(chunk))
      for li in 0 ..< g.layers.len:
        let (found, state0) = defaultStateByName(g.layers[li].block_name)
        let state = if found: state0 else: 0'u32
        var i = 0'i32
        while i < g.layers[li].height:
          if currentY < int32(bottomY(chunk)) + int32(height(chunk)):
            setBlockState(chunk, startX + x, currentY, startZ + z, state)
            currentY += 1'i32
          else:
            break
          inc i
  chunk.stage = StagedChunkEnum.Noise

proc stepToSurface*(g: FlatGenerator, chunk: ProtoChunk) =
  chunk.stage = StagedChunkEnum.Surface

proc stepToCarvers*(g: FlatGenerator, chunk: ProtoChunk) =
  chunk.stage = StagedChunkEnum.Carvers
