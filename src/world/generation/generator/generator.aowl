## The world generators. Port of pumpkin-world/src/generation/generator/mod.rs, with `TerrainCache` from
## proto_chunk.rs and `get_world_gen` from generation/mod.rs, which need these types.

{.feature: "lenientnils".}

import std/tables
import std/strutils
import ../../blockstates
import ../../biomeparam
import ../../../generated/chunk_gen_settings as gensettings
import ../../../generated/dimension as dimensiondata
import ../../../generated/noise_router
import ../../../generated/noise_parameter
import ../../../generated/structures
from ../../../data/block_state import asU16
import ../generation
import ../noise/router
import ../surface/terrain
import ../structure/placement
import flat

export flat, placement

type
  TerrainCache* = ref object
    terrainBuilder*: SurfaceTerrainBuilder
    surfaceNoise*: DoublePerlinNoiseSampler
    secondaryNoise*: DoublePerlinNoiseSampler

  VanillaGenerator* = ref object
    randomConfig*: GlobalRandomConfig
    baseRouter*: ProtoNoiseRouters
    dimension*: Dimension
    settings*: GenerationSettings
    biomeMixerSeed*: int64
    terrainCache*: TerrainCache
    defaultBlock*: blockstates.BlockStateId
    globalStructureCache*: GlobalStructureCache
    structureCalculator*: StructurePlacementCalculator
    structureAllowedBiomes*: Table[int, seq[uint16]]

  WorldGeneratorKind* {.pure.} = enum
    Noise, Flat

  WorldGenerator* = ref object
    ## `enum WorldGenerator`. Not a case object: the compiler rejects `of WorldGeneratorKind.Noise:` branches there.
    kind*: WorldGeneratorKind
    noise*: VanillaGenerator
    flat*: FlatGenerator

proc dimension*(g: WorldGenerator): Dimension =
  case g.kind
  of WorldGeneratorKind.Noise: g.noise.dimension
  of WorldGeneratorKind.Flat: g.flat.dimension

proc seed*(g: WorldGenerator): uint64 =
  case g.kind
  of WorldGeneratorKind.Noise: g.noise.randomConfig.seed
  of WorldGeneratorKind.Flat: g.flat.seed

proc terrainCacheFromRandom*(randomConfig: GlobalRandomConfig): TerrainCache =
  ## `TerrainCache::from_random`
  TerrainCache(terrainBuilder: newSurfaceTerrainBuilder(randomConfig.baseRandomDeriver),
    surfaceNoise: getNoiseSamplerForId(randomConfig.baseRandomDeriver, SURFACE),
    secondaryNoise: getNoiseSamplerForId(randomConfig.baseRandomDeriver, SURFACE_SECONDARY))

proc newVanillaGenerator*(seed: uint64, dimension: Dimension): VanillaGenerator =
  ## `<VanillaGenerator as GeneratorInit>::new`
  let settings = fromDimension(dimension)
  let randomConfig = newGlobalRandomConfig(seed, settings.legacyRandomSource)
  # Upstream's TODO: the generation settings contain part of the noise routers too.
  let base =
    if dimension.minecraftName == dimensiondata.OVERWORLD.minecraftName: OVERWORLD_BASE_NOISE_ROUTER
    elif dimension.minecraftName == THE_NETHER.minecraftName: NETHER_BASE_NOISE_ROUTER
    elif dimension.minecraftName == THE_END.minecraftName: END_BASE_NOISE_ROUTER
    else: OVERWORLD_BASE_NOISE_ROUTER
  let terrainCache = terrainCacheFromRandom(randomConfig)
  let baseRouter = generateProtoNoiseRouters(base, randomConfig)
  var allowed = initTable[int, seq[uint16]]()
  for i in 0 ..< ALL_STRUCTURE_SETS.len:
    allowed[i] = getAllowedBiomes(ALL_STRUCTURE_SETS[i])
  VanillaGenerator(randomConfig: randomConfig, baseRouter: baseRouter, dimension: dimension, settings: settings,
    biomeMixerSeed: hashSeed(seed), terrainCache: terrainCache, defaultBlock: uint32(asU16(settings.defaultBlock)),
    globalStructureCache: newGlobalStructureCache(), structureCalculator: newStructurePlacementCalculator(cast[int64](seed)),
    structureAllowedBiomes: allowed)

proc getWorldGen*(seed: uint64, dimension: Dimension, isFlat: bool, flatLayers: seq[FlatLayer],
                  flatBiome: string): WorldGenerator =
  ## `get_world_gen` in generation/mod.rs
  if isFlat:
    WorldGenerator(kind: WorldGeneratorKind.Flat, flat: newFlatGenerator(seed, dimension, flatLayers, flatBiome))
  else:
    WorldGenerator(kind: WorldGeneratorKind.Noise, noise: newVanillaGenerator(seed, dimension))
