## Port of pumpkin-world/src/generation/generator/structure_finder.rs
##
## PARTIAL: pumpkin-world/src/generation/generator/structure_finder.rs - `GlobalStructureCache` and
## `get_structure_chunk_in_region` are generation/structure's, which another batch ports, so a caller passes the
## stronghold chunks and that function in. The search is upstream's.

{.feature: "lenientnils".}

import ../../tick
import ../../../generated/structures
import ../../../util/math/mathmod

type
  FoundStructure* = object
    pos*: BlockPos
    distanceSq*: float64

  NearestStructureResult* = object
    ## `Option<BlockPos>`
    found*: bool
    pos*: BlockPos

proc findNearestConcentric(origin: BlockPos, strongholds: seq[(int32, int32)]): (bool, FoundStructure) =
  ## `find_nearest_concentric`
  if strongholds.len == 0:
    return (false, default(FoundStructure))
  let ox = float64(origin.x)
  let oz = float64(origin.z)
  var best = default(FoundStructure)
  var hasBest = false
  for i in 0 ..< strongholds.len:
    # Centre of the chunk in block coords.
    let bx = (strongholds[i][0] shl 4) + 8'i32
    let bz = (strongholds[i][1] shl 4) + 8'i32
    let dx = float64(bx) - ox
    let dz = float64(bz) - oz
    let candidate = FoundStructure(pos: blockPos(bx, 0'i32, bz), distanceSq: dx * dx + dz * dz)
    if not hasBest or candidate.distanceSq < best.distanceSq:
      best = candidate
      hasBest = true
  (true, best)

proc findNearestRandomSpreadAtRadius(origin: BlockPos, chunkOriginX, chunkOriginZ, radius: int32, worldSeed: int64,
                                     placement: RandomSpreadStructurePlacement, salt: uint32,
                                     getStructureChunkInRegion: proc(placement: RandomSpreadStructurePlacement, seed: int64,
                                       rx, rz: int32, salt: uint32): (int32, int32) {.closure.}): (bool, FoundStructure) =
  ## `find_nearest_random_spread_at_radius`
  let spacing = placement.spacing
  let ox = float64(origin.x)
  let oz = float64(origin.z)
  var hasBest = false
  var best = default(FoundStructure)
  var rxOff = -radius
  while rxOff <= radius:
    var rzOff = -radius
    while rzOff <= radius:
      if abs(rxOff) == radius or abs(rzOff) == radius:
        let rx = floorDiv(chunkOriginX, spacing) + rxOff
        let rz = floorDiv(chunkOriginZ, spacing) + rzOff
        let (structCx, structCz) = getStructureChunkInRegion(placement, worldSeed, rx, rz, salt)
        let bx = (structCx shl 4) + 8'i32
        let bz = (structCz shl 4) + 8'i32
        let dx = float64(bx) - ox
        let dz = float64(bz) - oz
        let distSq = dx * dx + dz * dz
        if not hasBest or distSq < best.distanceSq:
          hasBest = true
          best = FoundStructure(pos: blockPos(bx, 0'i32, bz), distanceSq: distSq)
      inc rzOff
    inc rxOff
  (hasBest, best)

proc findNearestStructure*(origin: BlockPos, placements: seq[StructurePlacement], maxSearchRadius: int32, worldSeed: int64,
                           strongholds: seq[(int32, int32)],
                           getStructureChunkInRegion: proc(placement: RandomSpreadStructurePlacement, seed: int64,
                             rx, rz: int32, salt: uint32): (int32, int32) {.closure.}): NearestStructureResult =
  ## `find_nearest_structure`: vanilla's `ChunkGenerator.findNearestMapStructure`. Concentric-rings placements are
  ## resolved in one pass from the computed stronghold chunks; random-spread ones are searched ring by ring outward,
  ## stopping at the first radius with a result. The best candidate of both passes is returned.
  if placements.len == 0:
    return NearestStructureResult(found: false)
  var hasNearest = false
  var nearest = default(FoundStructure)
  for pi in 0 ..< placements.len:
    if placements[pi].placementType.kind == StructurePlacementKind.ConcentricRings:
      let (ok, found) = findNearestConcentric(origin, strongholds)
      if ok and (not hasNearest or found.distanceSq < nearest.distanceSq):
        hasNearest = true
        nearest = found

  let chunkOriginX = origin.x shr 4
  let chunkOriginZ = origin.z shr 4
  var radius = 0'i32
  var searching = true
  while searching and radius <= maxSearchRadius:
    for pi in 0 ..< placements.len:
      if searching and placements[pi].placementType.kind == StructurePlacementKind.RandomSpread:
        let (ok, found) = findNearestRandomSpreadAtRadius(origin, chunkOriginX, chunkOriginZ, radius, worldSeed,
          placements[pi].placementType.randomSpread, placements[pi].salt, getStructureChunkInRegion)
        if ok:
          if not hasNearest or found.distanceSq < nearest.distanceSq:
            hasNearest = true
            nearest = found
          searching = false
    inc radius
  NearestStructureResult(found: hasNearest, pos: nearest.pos)
