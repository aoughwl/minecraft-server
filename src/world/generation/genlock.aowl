## One lock for the few lazily filled tables that generation reads from several threads (chunk generation runs on worker
## threads, see chunk_system/generation_executor.aowl). Only leaf sections take it: a section never calls anything that
## takes it again, so the lock needs no recursion. The hot read-mostly tables (feature definitions, block tag sets, tags)
## are decoded up front instead, by the `prewarm` procs.

import std/locks

var genLockCell: Lock
initLock(genLockCell)

proc lockGen*() {.inline.} = acquire(genLockCell)
proc unlockGen*() {.inline.} = release(genLockCell)
