## Port of pumpkin-world/src/generation/height_provider.rs
##
## The three provider structs are generated/carver.aowl's flattened `HeightProvider`. carver/carvers.aowl has
## `get_height` from cave.rs, which is close to this and differs on an empty trapezoid.

import ../../generated/carver
import ../../util/random/random
import ../../util/y_offset

export carver.HeightProvider, carver.HeightProviderKind

proc get*(p: HeightProvider, random: var RandomGenerator, minY: int8, height: uint16): int32 =
  ## `HeightProvider::get`
  let lo = getY(p.minInclusive, int16(minY), height)
  let hi = getY(p.maxInclusive, int16(minY), height)
  case p.kind
  of HeightProviderKind.Uniform:
    nextInbetweenI32(random, lo, hi)
  of HeightProviderKind.Trapezoid:
    let plateau = if p.hasPlateau: p.plateau else: 0'i32
    if lo > hi:
      return lo  # Upstream warns "Empty height range".
    let k = hi - lo
    if plateau >= k:
      return nextInbetweenI32(random, lo, hi)
    let l = (k - plateau) div 2'i32
    let m = k - l
    let a = nextInbetweenI32(random, 0'i32, m)
    let b = nextInbetweenI32(random, 0'i32, l)
    lo + a + b
  of HeightProviderKind.VeryBiasedToBottom:
    let inner = if p.hasInner: int32(p.inner) else: 1'i32
    if hi - lo - inner < 0'i32:
      return lo  # The newer checkout's "Empty height range".
    let minRnd = nextInbetweenI32(random, lo + inner, hi)
    let maxRnd = nextInbetweenI32(random, lo, minRnd - 1'i32)
    nextInbetweenI32(random, lo, maxRnd - 1'i32 + inner)
