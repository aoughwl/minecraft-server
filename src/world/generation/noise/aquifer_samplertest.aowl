proc strtod(s: cstring, endp: pointer): cdouble {.importc: "strtod", header: "<stdlib.h>".}

proc num(s: string): float64 =
  var copy = s
  float64(strtod(toCString(copy), nil))

proc inum(s: string): int32 = int32(num(s))

let randomConfig = newGlobalRandomConfig(0'u64, false)
let protoRouter = generateProtoNoiseRouters(OVERWORLD_BASE_NOISE_ROUTER, randomConfig)

type Aquifer = object
  aquifer: WorldAquiferSampler
  router: ChunkNoiseRouter
  heightEstimator: SurfaceHeightEstimateSampler
  options: ChunkNoiseFunctionSampleOptions

proc createAquifer(): Aquifer =
  const ChunkWidth = 16
  let surfaceConfig = fromDimension(dimensiondata.OVERWORLD)
  let shape = surfaceConfig.shape
  let chunkX = 7'i32
  let chunkZ = 4'i32
  let sampler = newStandardChunkFluidLevelSampler(newFluidLevel(63'i32, WaterBlockId), newFluidLevel(-54'i32, LavaBlockId))
  let noise = newChunkNoiseGenerator(protoRouter.noise, randomConfig, ChunkWidth div int(horizontalCellBlockCount(shape)),
    startBlockX(chunkX), startBlockZ(chunkZ), shape, sampler, true, true, @[], @[], false, default(BlockBox))
  let horizontalCellCount = ChunkWidth div int(horizontalCellBlockCount(shape))
  let horizontalBiomeEnd = biomeFromBlock(int32(horizontalCellCount) * int32(horizontalCellBlockCount(shape)))
  # Upstream passes the chunk position where biome coordinates go; kept, this is its test.
  let options = newSurfaceHeightSamplerBuilderOptions(chunkX, chunkZ, int(horizontalBiomeEnd), int32(shape.minY),
    int32(maxY(shape)), int(verticalCellBlockCount(shape)))
  Aquifer(aquifer: noise.aquiferSampler.aquifer, router: noise.router,
    heightEstimator: generateSurfaceHeightEstimateSampler(protoRouter.surfaceEstimator, options),
    options: skipCellCachesOptions())

proc createCarverAquifer(): CarverAquiferSampler =
  newCarverAquiferSampler(7'i32, 4'i32, protoRouter, randomConfig, fromDimension(dimensiondata.OVERWORLD))

proc blockFor(c: string): int =
  if c == "W": WaterBlockId else: LavaBlockId

proc stateFor(c: string): uint32 =
  case c
  of "W": defaultStateOf(WaterBlockId)
  of "L": defaultStateOf(LavaBlockId)
  else: 0'u32

var failures = 0

proc check(ok: bool, what: string, row: string) =
  if not ok:
    inc failures
    if failures < 20:
      echo "FAIL ", what, ": ", row

block carverAquiferReturnsStableOutput:
  let pos = vec3[int32](112'i32, 0'i32, 64'i32)
  let first = compute(createCarverAquifer(), pos, -1.0'f64)
  let second = compute(createCarverAquifer(), pos, -1.0'f64)
  assert first.hasState == second.hasState and first.state == second.state and
    first.shouldScheduleFluidUpdate == second.shouldScheduleFluidUpdate

block carverAquiferHandlesChunkEdges:
  let aquifer = createCarverAquifer()
  discard compute(aquifer, vec3[int32](112'i32, -64'i32, 64'i32), -1.0'f64)
  discard compute(aquifer, vec3[int32](127'i32, -64'i32, 79'i32), -1.0'f64)
  discard compute(aquifer, vec3[int32](112'i32, 319'i32, 79'i32), -1.0'f64)
  discard compute(aquifer, vec3[int32](127'i32, 319'i32, 64'i32), -1.0'f64)

block carverAquiferReportsFluidScheduleSignal:
  let aquifer = createCarverAquifer()
  var foundSchedule = false
  var y = -64'i32
  while y <= 63'i32 and not foundSchedule:
    var x = 112'i32
    while x <= 127'i32 and not foundSchedule:
      var z = 64'i32
      while z <= 79'i32 and not foundSchedule:
        if compute(aquifer, vec3[int32](x, y, z), -1.0'f64).shouldScheduleFluidUpdate:
          foundSchedule = true
        inc z
      inc x
    inc y
  assert foundSchedule

block getFluidBlockState:
  let a = createAquifer()
  let level = newFluidLevel(0'i32, WaterBlockId)
  for row in FluidBlockStateTable.split('\n'):
    let f = row.split(' ')
    let got = getFluidBlockState(inum(f[0]), inum(f[1]), inum(f[2]), level, -10'i32, a.router, a.options)
    check(got == blockFor(f[3]), "get_fluid_block_state", row)

block getNoiseBasedFluidLevel:
  let a = createAquifer()
  for row in NoiseBasedFluidLevelTable.split('\n'):
    let f = row.split(' ')
    let got = getNoiseBasedFluidLevel(inum(f[0]), inum(f[1]), inum(f[2]), 200'i32, a.router, a.options)
    check(got == inum(f[3]), "get_noise_based_fluid_level", row)

block getFluidBlockY:
  let a = createAquifer()
  let level = newFluidLevel(0'i32, WaterBlockId)
  for row in FluidBlockYTable.split('\n'):
    let f = row.split(' ')
    let got = getFluidBlockY(inum(f[0]), inum(f[1]), inum(f[2]), level, 80'i32, true, a.router, a.options)
    check(got == inum(f[3]), "get_fluid_block_y", row)
  for row in FluidBlockYUnmappedTable.split('\n'):
    let f = row.split(' ')
    let got = getFluidBlockY(inum(f[0]), inum(f[1]), inum(f[2]), level, 80'i32, false, a.router, a.options)
    check(got == inum(f[3]), "get_fluid_block_y unmapped", row)

block getFluidLevel:
  let a = createAquifer()
  for row in FluidLevelTable.split('\n'):
    let f = row.split(' ')
    let got = getFluidLevelFor(a.aquifer.fluidLevelSampler, inum(f[0]), inum(f[1]), inum(f[2]), a.router, a.heightEstimator, a.options)
    check(got.maxY == inum(f[3]) and got.blockId == blockFor(f[4]), "get_fluid_level", row)

block calculateDensity:
  let a = createAquifer()
  for row in CalculateDensityTable.split('\n'):
    let f = row.split(' ')
    let level1 = newFluidLevel(inum(f[3]), WaterBlockId)
    let level2 = newFluidLevel(inum(f[4]), WaterBlockId)
    var hasSample = false
    var sample = 0.0'f64
    let got = calculateDensity(hasSample, sample, vec3[int32](inum(f[0]), inum(f[1]), inum(f[2])), a.router, a.options, level1, level2)
    check(got == num(f[5]), "calculate_density", row)

block applyTable:
  let a = createAquifer()
  for row in ApplyTable.split('\n'):
    let f = row.split(' ')
    let r = applyInternal(a.aquifer, a.router, vec3[int32](inum(f[0]), inum(f[1]), inum(f[2])), a.options, a.heightEstimator, num(f[3]))
    if f[4] == "N":
      check(not r.hasState, "apply", row)
    else:
      check(r.hasState and r.state == stateFor(f[4]), "apply", row)

if failures > 0:
  echo failures, " rows failed"
  quit(1)
echo "aquifer_samplertest ok"
