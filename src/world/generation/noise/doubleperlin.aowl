## Port of pumpkin-world/src/generation/noise/perlin.rs
##
## `impl RandomImpl` is a plain generic `[R]`, as in src/util/noise/perlin.aowl.

import ../../../util/noise/perlin
import ../../../generated/noise_parameter

export perlin

type
  DoublePerlinNoiseSampler* = object
    firstSampler*: OctavePerlinNoiseSampler
    secondSampler*: OctavePerlinNoiseSampler
    amplitude*: float64
    maxValueField: float64

proc createAmplitude(octaves: int32): float64 {.inline.} =
  0.1'f64 * (1.0'f64 + 1.0'f64 / float64(octaves + 1'i32))

proc maxValue*(s: DoublePerlinNoiseSampler): float64 {.inline.} = s.maxValueField

proc getAmplitude*(amplitudes: openArray[float64]): float64 =
  ## `DoublePerlinNoiseSampler::get_amplitude`
  var j = int32.high
  var k = int32.low
  for index in 0 ..< amplitudes.len:
    if amplitudes[index] != 0.0'f64:
      j = min(j, int32(index))
      k = max(k, int32(index))
  0.16666666666666666'f64 / createAmplitude(k - j)

proc newDoublePerlinNoiseSampler*[R](rand: var R, firstOctave: int32, amplitudes: openArray[float64],
                                     amplitude: float64, legacy: bool): DoublePerlinNoiseSampler =
  ## `DoublePerlinNoiseSampler::new`
  let firstSampler = newOctavePerlinNoiseSampler(rand, firstOctave, amplitudes, legacy)
  let secondSampler = newOctavePerlinNoiseSampler(rand, firstOctave, amplitudes, legacy)
  let maxValue = (firstSampler.maxValue() + secondSampler.maxValue()) * amplitude
  DoublePerlinNoiseSampler(firstSampler: firstSampler, secondSampler: secondSampler, amplitude: amplitude,
    maxValueField: maxValue)

proc doublePerlinFromParams*[R](rand: var R, parameters: DoublePerlinNoiseParameters,
                                legacy: bool): DoublePerlinNoiseSampler =
  ## `DoublePerlinNoiseSampler::from_params`
  newDoublePerlinNoiseSampler(rand, parameters.firstOctave, parameters.amplitudes, parameters.amplitude, legacy)

proc sample*(s: DoublePerlinNoiseSampler, x, y, z: float64): float64 =
  let d = x * 1.0181268882175227'f64
  let e = y * 1.0181268882175227'f64
  let f = z * 1.0181268882175227'f64
  (s.firstSampler.sample(x, y, z) + s.secondSampler.sample(d, e, f)) * s.amplitude
