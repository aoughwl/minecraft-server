const OctaveValues = [
  [1.4633897801218182E8'f64, 3.360929121402108E8'f64, -1.7376184515043163E8'f64, -0.16510137639683028'f64],
  [-3.952093942501234E8'f64, -8.149682915016855E7'f64, 2.0761709535397574E8'f64, -0.19865227457826365'f64],
  [1.0603518812861493E8'f64, -1.6028050039630303E8'f64, 9.621510690305333E7'f64, -0.16157548492944798'f64],
  [-2.2789281609860754E8'f64, 1.2416505757723756E8'f64, -3.047619296454517E8'f64, -0.05762575118540847'f64],
  [-1.6361322604690066E8'f64, -1.862652364900794E8'f64, 9.03458926538596E7'f64, 0.21589404036742288'f64],
  [-1.6074718857061076E8'f64, -4.816551924254624E8'f64, -9.930236785759543E7'f64, 0.1888188057014473'f64],
  [-1.6848478115907547E8'f64, 1.9495247771890038E8'f64, 1.3780564333313772E8'f64, 0.23114508298896774'f64],
  [2.5355640846261957E8'f64, -2.5973376726076955E8'f64, 3.7834594620459855E7'f64, -0.23703473310230702'f64],
  [-8.636649828254433E7'f64, 1.7017680431584623E8'f64, 2.941033134334743E8'f64, -0.14050102207739693'f64],
  [-4.573784466442647E8'f64, 1.789046617664721E8'f64, -5.515223967099891E8'f64, -0.1422470544720957'f64]]

block sampleLegacy:
  var rand = legacy_rand.fromSeed(513513513'u64)
  assert nextI32(rand) == -1302745855'i32
  var randGen = toRandomGenerator(rand)
  let amplitudes = @[4.0'f64]
  let sampler = newDoublePerlinNoiseSampler(randGen, 0'i32, amplitudes, getAmplitude(amplitudes), true)
  for v in LegacyValues:
    assert sample(sampler, v[0], v[1], v[2]) == v[3]

block sampleXoroshiro:
  var rand = xoroshiro128.fromSeed(5'u64)
  assert nextI32(rand) == -1678727252'i32
  var randGen = toRandomGenerator(rand)
  let amplitudes = @[2.0'f64, 4.0'f64]
  let sampler = newDoublePerlinNoiseSampler(randGen, 1'i32, amplitudes, getAmplitude(amplitudes), false)
  for v in XoroshiroValues:
    assert sample(sampler, v[0], v[1], v[2]) == v[3]

block sampleOctave:
  var rand = xoroshiro128.fromSeed(513513513'u64)
  assert nextI32(rand) == 404174895'i32
  let (start, amplitudes) = calculateAmplitudes([1'i32, 2'i32, 3'i32])
  var randGen = toRandomGenerator(rand)
  let sampler = newOctavePerlinNoiseSampler(randGen, start, amplitudes, false)
  for v in OctaveValues:
    assert sample(sampler, v[0], v[1], v[2]) == v[3]

block calculateAmplitudesTest:
  var octaves = newSeq[int32](0)
  for o in -15'i32 .. 0'i32:
    octaves.add(o)
  let (first, amplitudes) = calculateAmplitudes(octaves)
  assert first == -15'i32
  assert amplitudes.len == 16
  for a in amplitudes:
    assert a == 1.0'f64

echo "doubleperlintest ok"
