## Port of the tests in generation/noise/perlin.rs, with upstream's tables.

import std/assertions
import std/syncio
import ../../../util/noise/perlin
import ../../../util/legacy_rand
import ../../../util/xoroshiro128
import ../../../util/random/random
import doubleperlin

