## Climate sampling for biome selection, and the biome suppliers built on it.
## Port of pumpkin-world/src/generation/noise/router/multi_noise_sampler.rs, and of
## pumpkin-world/src/biome/mod.rs, whose `MultiNoiseBiomeSupplier` has waited for this sampler.
## `hash_seed` is in biomeparam.aowl; `NoiseValuePoint` and `to_long` are biomesource.aowl.
##
## `BiomeSupplier`'s three impls are a closed set, so it is an enum and `supplierBiome` dispatches.
## `LAST_RESULT_NODE`, upstream's thread-local shortcut, is a field of the sampler: it only makes the tree walk
## cheaper, whichever node it starts from.

{.feature: "lenientnils".}

import ../../../generated/biome
import ../../../generated/noise_router as noiserouterdata
import ../../biomesource
import ../generation
import router

export biomesource.NoiseValuePoint

type
  MultiNoiseSamplerBuilderOptions* = object
    startBiomeX*, startBiomeZ*: int32
    horizontalBiomeEnd*: int

  MultiNoiseSampler* = ref object
    temperature*, humidity*, continentalness*, erosion*, depth*, ridges*: int
    stack*: ChunkStack
    lastResultNode*: int32

  BiomeSupplierKind* {.pure.} = enum
    Overworld, Nether, End

proc newMultiNoiseSamplerBuilderOptions*(startBiomeX, startBiomeZ: int32, horizontalBiomeEnd: int): MultiNoiseSamplerBuilderOptions =
  MultiNoiseSamplerBuilderOptions(startBiomeX: startBiomeX, startBiomeZ: startBiomeZ, horizontalBiomeEnd: horizontalBiomeEnd)

proc generateMultiNoiseSampler*(base: ProtoMultiNoiseRouter, buildOptions: MultiNoiseSamplerBuilderOptions): MultiNoiseSampler =
  ## `MultiNoiseSampler::generate`
  MultiNoiseSampler(temperature: base.temperature, humidity: base.vegetation, continentalness: base.continents,
    depth: base.depth, erosion: base.erosion, ridges: base.ridges,
    stack: generateStackForSampler(base.stack, buildOptions.startBiomeX, buildOptions.startBiomeZ, buildOptions.horizontalBiomeEnd),
    lastResultNode: -1'i32)

proc sample*(s: MultiNoiseSampler, biomeX, biomeY, biomeZ: int32): NoiseValuePoint =
  ## `MultiNoiseSampler::sample`
  let pos = vec3[int32](biomeToBlock(biomeX), biomeToBlock(biomeY), biomeToBlock(biomeZ))
  let sampleOptions = skipCellCachesOptions()
  let temperature = float32(sampleFromStack(s.stack, s.temperature, pos, sampleOptions))
  let humidity = float32(sampleFromStack(s.stack, s.humidity, pos, sampleOptions))
  let continentalness = float32(sampleFromStack(s.stack, s.continentalness, pos, sampleOptions))
  let erosion = float32(sampleFromStack(s.stack, s.erosion, pos, sampleOptions))
  let depth = float32(sampleFromStack(s.stack, s.depth, pos, sampleOptions))
  let weirdness = float32(sampleFromStack(s.stack, s.ridges, pos, sampleOptions))
  NoiseValuePoint(temperature: toLong(temperature), humidity: toLong(humidity), continentalness: toLong(continentalness),
    erosion: toLong(erosion), depth: toLong(depth), weirdness: toLong(weirdness))

proc sampleErosion*(s: MultiNoiseSampler, blockX, blockY, blockZ: int32): float64 =
  ## `MultiNoiseSampler::sample_erosion`
  sampleFromStack(s.stack, s.erosion, vec3[int32](blockX, blockY, blockZ), skipCellCachesOptions())

proc multiNoiseBiome*(source: BiomeTree, x, y, z: int32, noise: MultiNoiseSampler): Biome =
  ## `<MultiNoiseBiomeSupplier as BiomeSupplier>::biome`
  let point = sample(noise, x, y, z)
  let pointList = convertToList(point)
  get(source, pointList, noise.lastResultNode)

proc theEndBiome*(x0, y0, z0: int32, noise: MultiNoiseSampler): Biome =
  ## `<TheEndBiomeSupplier as BiomeSupplier>::biome`, on the biome end.rs names; see biomesource.aowl for the logic.
  let x = biomeToBlock(x0)
  let y = biomeToBlock(y0)
  let z = biomeToBlock(z0)
  let sectionX = blockToSection(x)
  let sectionZ = blockToSection(z)
  if sectionX * sectionX + sectionZ * sectionZ <= 4096'i32:
    return THE_END
  let cx = (sectionX * 2'i32 + 1'i32) * 8'i32
  let cz = (sectionZ * 2'i32 + 1'i32) * 8'i32
  let value = sampleErosion(noise, cx, y, cz)
  if value > 0.25'f64:
    return END_HIGHLANDS
  if value >= -0.0625'f64:
    return END_MIDLANDS
  if value < -0.21875'f64:
    return SMALL_END_ISLANDS
  END_BARRENS

proc supplierBiome*(kind: BiomeSupplierKind, x, y, z: int32, noise: MultiNoiseSampler): Biome =
  ## `BiomeSupplier::biome`, across `MultiNoiseBiomeSupplier::OVERWORLD`, `::NETHER` and `TheEndBiomeSupplier`.
  case kind
  of BiomeSupplierKind.Overworld: multiNoiseBiome(OVERWORLD_BIOME_SOURCE, x, y, z, noise)
  of BiomeSupplierKind.Nether: multiNoiseBiome(NETHER_BIOME_SOURCE, x, y, z, noise)
  of BiomeSupplierKind.End: theEndBiome(x, y, z, noise)
