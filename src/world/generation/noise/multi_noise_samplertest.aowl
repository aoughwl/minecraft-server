## Port of the tests in generation/noise/router/multi_noise_sampler.rs, plus `sample_value` in biome/multi_noise.rs
## against assets/multi_noise_sample_no_blend_no_beard_0_0_0.json and `sample_multinoise_biome` against
## assets/multi_noise_biome_source_test.json. Run from the repo root.

import std/assertions
import std/syncio
import ../../../generated/biome
import ../../../generated/noise_router as noiserouterdata
import ../generation
import ../positions
import router
import multi_noise_sampler
import ../fixtures

proc routersFor(seed: uint64): ProtoNoiseRouters =
  generateProtoNoiseRouters(OVERWORLD_BASE_NOISE_ROUTER, newGlobalRandomConfig(seed, false))

block sample1:
  let r = routersFor(123'u64)
  let s = generateMultiNoiseSampler(r.multiNoise, newMultiNoiseSamplerBuilderOptions(1'i32, 1'i32, 1))
  let p = sample(s, 123'i32, 123'i32, 123'i32)
  assert p.temperature == -5727'i64
  assert p.humidity == 55'i64
  assert p.continentalness == 4996'i64
  assert p.erosion == 2371'i64
  assert p.depth == -19774'i64
  assert p.weirdness == 4421'i64

block sample2:
  let r = routersFor(13579'u64)
  let s = generateMultiNoiseSampler(r.multiNoise, newMultiNoiseSamplerBuilderOptions(1'i32, 1'i32, 1))
  let p = sample(s, 123'i32, 123'i32, 123'i32)
  assert p.temperature == 7489'i64
  assert p.humidity == 3502'i64
  assert p.continentalness == -2168'i64
  assert p.erosion == -3511'i64
  assert p.depth == -21237'i64
  assert p.weirdness == -5222'i64

block biomeDesert:
  let r = routersFor(13579'u64)
  let s = generateMultiNoiseSampler(r.multiNoise, newMultiNoiseSamplerBuilderOptions(1'i32, 1'i32, 1))
  let b = supplierBiome(BiomeSupplierKind.Overworld, -24'i32, 1'i32, 8'i32, s)
  assert b.id == DESERT.id

block sampleValue:
  let data = readNumbers(assetPath("multi_noise_sample_no_blend_no_beard_0_0_0.json"))
  let r = routersFor(0'u64)
  let s = generateMultiNoiseSampler(r.multiNoise, newMultiNoiseSamplerBuilderOptions(
    biomeFromBlock(startBlockX(0'i32)), biomeFromBlock(startBlockZ(0'i32)), int(biomeFromBlock(16'i32))))
  var i = 0
  var checked = 0
  while i < data.len:
    let p = sample(s, int32(data[i]), int32(data[i + 1]), int32(data[i + 2]))
    assert p.temperature == int64(data[i + 3])
    assert p.humidity == int64(data[i + 4])
    assert p.continentalness == int64(data[i + 5])
    assert p.erosion == int64(data[i + 6])
    assert p.depth == int64(data[i + 7])
    assert p.weirdness == int64(data[i + 8])
    i += 9
    inc checked
  echo "multi_noise_sample fixture: ", checked, " points match"

block sampleMultinoiseBiome:
  let data = readNumbers(assetPath("multi_noise_biome_source_test.json"))
  let r = routersFor(0'u64)
  let s = generateMultiNoiseSampler(r.multiNoise, newMultiNoiseSamplerBuilderOptions(0'i32, 0'i32, 4))
  var i = 0
  var checked = 0
  while i < data.len:
    let b = supplierBiome(BiomeSupplierKind.Overworld, int32(data[i]), int32(data[i + 1]), int32(data[i + 2]), s)
    assert int(b.id) == int(data[i + 3])
    i += 4
    inc checked
  echo "multi_noise_biome_source fixture: ", checked, " biomes match"

echo "multi_noise_samplertest ok"
