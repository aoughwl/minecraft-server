## The per-chunk terrain sampler. Port of pumpkin-world/src/generation/noise/mod.rs
##
## `ChainedBlockStateSampler`'s two kinds are a closed set: the aquifer and an optional ore sampler.

{.feature: "lenientnils".}

import ../../blockstates
import ../../../generated/chunk_gen_settings
import ../../../util/math/block_box
import ../../../util/xoroshiro128
import ../generation
import router
import aquifer_sampler
import ore_sampler
import surface_height_sampler

export aquifer_sampler, ore_sampler, router

const ChunkDim* = 16'u8  ## `CHUNK_DIM`

type
  BlockStateSampleResult* = object
    hasState*: bool
    state*: blockstates.BlockStateId

  ChunkNoiseGenerator* = ref object
    aquiferSampler*: AquiferSampler  ## `state_sampler`'s first entry.
    oreVeins*: bool                  ## Whether `state_sampler` has the second.
    generationShape*: GenerationShapeConfig
    startCellPosX*, startCellPosZ*: int32
    horizontalCellCount*, verticalCellCount*: int
    minimumCellY*: int32
    cacheFillUniqueId*, cacheResultUniqueId*: uint64
    router*: ChunkNoiseRouter

proc horizontalCellBlockCount*(g: ChunkNoiseGenerator): uint8 {.inline.} = horizontalCellBlockCount(g.generationShape)
proc verticalCellBlockCount*(g: ChunkNoiseGenerator): uint8 {.inline.} = verticalCellBlockCount(g.generationShape)
proc minY*(g: ChunkNoiseGenerator): int8 {.inline.} = g.generationShape.minY
proc height*(g: ChunkNoiseGenerator): uint16 {.inline.} = g.generationShape.height

proc newChunkNoiseGenerator*(noiseRouterBase: ProtoNoiseRouter, randomConfig: GlobalRandomConfig,
                             horizontalCellCount: int, startBlockX, startBlockZ: int32,
                             generationShape: GenerationShapeConfig, levelSampler: StandardChunkFluidLevelSampler,
                             aquifers, oreVeins: bool, beardifierStructures: seq[BeardifierStructure],
                             beardifierJunctions: seq[BeardifierJunction], hasAffectedBox: bool,
                             affectedBox: BlockBox): ChunkNoiseGenerator =
  ## `ChunkNoiseGenerator::new`
  let horizontalCellBlockCount = horizontalCellBlockCount(generationShape)
  let verticalCellBlockCount = verticalCellBlockCount(generationShape)
  let startCellPosX = startBlockX div int32(horizontalCellBlockCount)
  let startCellPosZ = startBlockZ div int32(horizontalCellBlockCount)
  let horizontalBiomeEnd = biomeFromBlock(int32(horizontalCellCount) * int32(horizontalCellBlockCount))
  let verticalCellCount = int(generationShape.height) div int(verticalCellBlockCount)
  let minimumCellY = int32(generationShape.minY) div int32(verticalCellBlockCount)

  let builderOptions = ChunkNoiseFunctionBuilderOptions(
    horizontalCellBlockCount: int(horizontalCellBlockCount),
    verticalCellBlockCount: int(verticalCellBlockCount),
    verticalCellCount: verticalCellCount,
    horizontalCellCount: horizontalCellCount,
    startBiomeX: biomeFromBlock(startBlockX),
    startBiomeZ: biomeFromBlock(startBlockZ),
    horizontalBiomeEnd: int(horizontalBiomeEnd),
    beardifierStructures: beardifierStructures,
    beardifierJunctions: beardifierJunctions,
    hasAffectedBox: hasAffectedBox,
    affectedBox: affectedBox)

  var aquiferSampler = default(AquiferSampler)
  if aquifers:
    let sectionX = blockToSection(startBlockX)
    let sectionZ = blockToSection(startBlockZ)
    aquiferSampler = AquiferSampler(kind: AquiferSamplerKind.Aquifer,
      aquifer: newWorldAquiferSampler(sectionX, sectionZ, randomConfig.aquiferRandomDeriver, generationShape.minY,
        generationShape.height, levelSampler))
  else:
    aquiferSampler = AquiferSampler(kind: AquiferSamplerKind.SeaLevel, levelSampler: levelSampler)

  let router = generateChunkNoiseRouter(noiseRouterBase, builderOptions)

  ChunkNoiseGenerator(aquiferSampler: aquiferSampler, oreVeins: oreVeins, generationShape: generationShape,
    startCellPosX: startCellPosX, startCellPosZ: startCellPosZ, horizontalCellCount: horizontalCellCount,
    verticalCellCount: verticalCellCount, minimumCellY: minimumCellY, cacheFillUniqueId: 0'u64,
    cacheResultUniqueId: 0'u64, router: router)

proc sampleDensity(g: ChunkNoiseGenerator, start: bool, currentX: int32) =
  let hCount = int32(horizontalCellBlockCount(g))
  let vCount = int32(verticalCellBlockCount(g))
  let x = currentX * hCount
  for cellZ in 0 .. g.horizontalCellCount:
    let currentCellZPos = g.startCellPosZ + int32(cellZ)
    let z = currentCellZPos * hCount
    g.cacheFillUniqueId += 1'u64
    let mapper = newInterpolationMapper(x, z, g.minimumCellY, vCount)
    var options = newSampleOptions(false, true, g.cacheResultUniqueId, g.cacheFillUniqueId, 0)
    setWrapperData(options, 0, 0, 0, int(hCount), int(vCount))
    fillInterpolatorBuffers(g.router, start, cellZ, mapper, options)
    g.cacheResultUniqueId = options.cacheResultUniqueId
  g.cacheFillUniqueId += 1'u64

proc sampleStartDensity*(g: ChunkNoiseGenerator) =
  g.cacheResultUniqueId = 0'u64
  sampleDensity(g, true, g.startCellPosX)

proc sampleEndDensity*(g: ChunkNoiseGenerator, cellX: int32) =
  sampleDensity(g, false, g.startCellPosX + cellX + 1'i32)

proc interpolateX*(g: ChunkNoiseGenerator, delta: float64) {.inline.} = interpolateX(g.router, delta)
proc interpolateY*(g: ChunkNoiseGenerator, delta: float64) {.inline.} = interpolateY(g.router, delta)

proc interpolateZ*(g: ChunkNoiseGenerator, delta: float64) {.inline.} =
  g.cacheResultUniqueId += 1'u64
  interpolateZ(g.router, delta)

proc swapBuffers*(g: ChunkNoiseGenerator) {.inline.} = swapBuffers(g.router)

proc onSampledCellCorners*(g: ChunkNoiseGenerator, cellX, cellY, cellZ: int32) =
  onSampledCellCorners(g.router, int(cellY), int(cellZ))
  g.cacheFillUniqueId += 1'u64
  let hCount = int32(horizontalCellBlockCount(g))
  let vCount = int32(verticalCellBlockCount(g))
  let startX = (g.startCellPosX + cellX) * hCount
  let startY = (cellY + g.minimumCellY) * vCount
  let startZ = (g.startCellPosZ + cellZ) * hCount
  let mapper = newChunkIndexMapper(startX, startY, startZ, int(hCount), int(vCount))
  var sampleOptions = newSampleOptions(true, true, g.cacheResultUniqueId, g.cacheFillUniqueId, 0)
  setWrapperData(sampleOptions, 0, 0, 0, int(hCount), int(vCount))
  fillCellCaches(g.router, mapper, sampleOptions)
  g.cacheFillUniqueId += 1'u64

proc sampleBlockState*(g: ChunkNoiseGenerator, oreRandomDeriver: XoroshiroSplitter, startX, startY, startZ,
                       cellX, cellY, cellZ: int32, heightEstimator: SurfaceHeightEstimateSampler): BlockStateSampleResult =
  ## `ChunkNoiseGenerator::sample_block_state`, with `ChainedBlockStateSampler::sample` inline.
  let pos = vec3[int32](startX + cellX, startY + cellY, startZ + cellZ)
  var options = newSampleOptions(false, true, g.cacheResultUniqueId, g.cacheFillUniqueId, 0)
  setWrapperData(options, int(cellX), int(cellY), int(cellZ), int(horizontalCellBlockCount(g)), int(verticalCellBlockCount(g)))
  let a = apply(g.aquiferSampler, g.router, pos, options, heightEstimator)
  if a.hasState:
    return BlockStateSampleResult(hasState: true, state: a.state)
  if g.oreVeins:
    let o = sampleOre(g.router, oreRandomDeriver, pos, options)
    if o.hasState:
      return BlockStateSampleResult(hasState: true, state: o.state)
  BlockStateSampleResult(hasState: false)
