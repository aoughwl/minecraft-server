## Ore veins. Port of pumpkin-world/src/generation/noise/ore_sampler.rs

import ../../blockstates
import ../../../util/math/mathmod
import ../../../util/xoroshiro128
import router

type
  VeinType* = object
    ore*, rawOre*, stone*: blockstates.BlockStateId
    minY*, maxY*: int32

  OreResult* = object
    ## `Option<&'static BlockState>`
    hasState*: bool
    state*: blockstates.BlockStateId

let
  VeinCopper* = VeinType(ore: defaultStateByName("copper_ore")[1], rawOre: defaultStateByName("raw_copper_block")[1],
    stone: defaultStateByName("granite")[1], minY: 0'i32, maxY: 50'i32)
  VeinIron* = VeinType(ore: defaultStateByName("deepslate_iron_ore")[1], rawOre: defaultStateByName("raw_iron_block")[1],
    stone: defaultStateByName("tuff")[1], minY: -60'i32, maxY: -8'i32)

proc sampleOre*(r: ChunkNoiseRouter, oreRandomDeriver: XoroshiroSplitter, pos: Vector3[int32],
                sampleOptions: ChunkNoiseFunctionSampleOptions): OreResult =
  ## `OreVeinSampler::sample`
  let veinToggle = sampleVeinToggle(r, pos, sampleOptions)
  let copper = veinToggle > 0.0'f64
  let minY = if copper: VeinCopper.minY else: VeinIron.minY
  let maxY = if copper: VeinCopper.maxY else: VeinIron.maxY
  let blockY = pos.y
  let maxToY = maxY - blockY
  let yToMin = blockY - minY
  if maxToY >= 0'i32 and yToMin >= 0'i32:
    let closestToBound = min(maxToY, yToMin)
    let mappedDiff = clampedMap(float64(closestToBound), 0.0'f64, 20.0'f64, -0.2'f64, 0.0'f64)
    let absSample = abs(veinToggle)
    if absSample + mappedDiff >= float64(0.4'f32):
      var random = splitPos(oreRandomDeriver, pos.x, blockY, pos.z)
      let veinRidgedSample = sampleVeinRidged(r, pos, sampleOptions)
      if nextF32(random) <= 0.7'f32 and veinRidgedSample < 0.0'f64:
        let clampedSample = clampedMap(absSample, float64(0.4'f32), float64(0.6'f32), float64(0.1'f32), float64(0.3'f32))
        let veinGap = sampleVeinGap(r, pos, sampleOptions)
        if float64(nextF32(random)) < clampedSample and veinGap > float64(-0.3'f32):
          let raw = nextF32(random) < 0.02'f32
          if copper:
            return OreResult(hasState: true, state: if raw: VeinCopper.rawOre else: VeinCopper.ore)
          return OreResult(hasState: true, state: if raw: VeinIron.rawOre else: VeinIron.ore)
        return OreResult(hasState: true, state: if copper: VeinCopper.stone else: VeinIron.stone)
  OreResult(hasState: false)
