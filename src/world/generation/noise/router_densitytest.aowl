## The density function tests in generation/noise/router/density_function/test.rs and
## generation/noise/router/density_function/test_deserializer.rs. Upstream comments them out: the old `WeirdScaledSampler` class their JSON still uses no longer exists in the router. The
## tables and fixtures in them stay valid known answers for everything else, so:
##   - `normal_surface_noisified` and its tables run as they were;
##   - `config_final_density` runs against assets/final_density_dump_7_4.json;
##   - each `base_*` test runs against assets/converted_*_7_4.json, through a small deserializer below for
##     assets/density_function_tests.json. The two functions holding a `WeirdScaledSampler` (`caves/entrances`,
##     `caves/spaghetti_2d`) are not run, as the class has no component here to deserialize to.
## Equality is upstream's `assert_eq_delta!(.., f64::EPSILON)`. Run from the repo root.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import std/strutils
import std/math
import std/tables
import ../../../generated/noise_router as noiserouterdata
import ../../../generated/noise_parameter
import ../../../codecs/json_value
import ../generation
import router
import router_densitydata
import ../fixtures

proc strtod(s: cstring, endp: pointer): cdouble {.importc: "strtod", header: "<stdlib.h>".}
proc num(s: string): float64 =
  var copy = s
  float64(strtod(toCString(copy), nil))

const Epsilon = 2.220446049250313e-16'f64

let randomConfig = newGlobalRandomConfig(0'u64, false)

proc passThroughStack(stack: ProtoStack, count: int): ChunkStack =
  ## `build_function_stack!`: wrappers pass through, and the beardifier contributes nothing.
  result = ChunkStack(comps: newSeq[ChunkComponent](0), splines: stack.splines)
  let zero = constantProto(0.0'f64)
  for i in 0 ..< count:
    let p = stack.components[i]
    case p.kind
    of ProtoKind.Wrapper, ProtoKind.PassThrough:
      result.comps.add(newPassThroughComponent(p.inputIndex, p.minValue, p.maxValue))
    of ProtoKind.Beardifier:
      result.comps.add(newProtoChunkComponent(zero))
    else:
      result.comps.add(newProtoChunkComponent(p))

var failures = 0
proc note(ok: bool, what: string, x: string) =
  if not ok:
    inc failures
    if failures < 30:
      echo "FAIL ", what, ": ", x

let options = skipCellCachesOptions()
let base = OVERWORLD_BASE_NOISE_ROUTER
let noiseProto = generateProtoStack(base.noise.fullComponentStack, randomConfig)
let multiProto = generateProtoStack(base.multiNoise.fullComponentStack, randomConfig)
let noiseStack = passThroughStack(noiseProto, noiseProto.components.len)
let multiStack = passThroughStack(multiProto, multiProto.components.len)

proc noiseIndex(name: string): int =
  case name
  of "barrier_noise": int(base.noise.barrierNoise)
  of "fluid_level_floodedness_noise": int(base.noise.fluidLevelFloodednessNoise)
  of "fluid_level_spread_noise": int(base.noise.fluidLevelSpreadNoise)
  of "lava_noise": int(base.noise.lavaNoise)
  of "erosion": int(base.noise.erosion)
  of "depth": int(base.noise.depth)
  of "final_density": int(base.noise.finalDensity)
  of "vein_toggle": int(base.noise.veinToggle)
  of "vein_ridged": int(base.noise.veinRidged)
  of "vein_gap": int(base.noise.veinGap)
  else: -1

proc multiIndex(name: string): int =
  case name
  of "temperature": int(base.multiNoise.temperature)
  of "vegetation": int(base.multiNoise.vegetation)
  of "continents": int(base.multiNoise.continents)
  of "erosion": int(base.multiNoise.erosion)
  of "depth": int(base.multiNoise.depth)
  of "ridges": int(base.multiNoise.ridges)
  else: -1

block normalSurfaceNoisified:
  let pos = vec3[int32](0'i32, 0'i32, 0'i32)
  var checked = 0
  for vi in 0 ..< SingleValues.len:
    let cat = SingleValues[vi][0]
    let name = SingleValues[vi][1]
    let expected = SingleValues[vi][2]
    # The surface row is stale: that router gives a height now, as `FindTopSurface`, not the density of the old table.
    if cat != "surface":
      let got =
        if cat == "noise": sampleFromStack(noiseStack, noiseIndex(name), pos, options)
        else: sampleFromStack(multiStack, multiIndex(name), pos, options)
      note(got == expected, cat & "/" & name, $got)
      inc checked
  echo "normal_surface_noisified: ", checked, " values"

proc checkTable(name, table: string) =
  let idx = noiseIndex(name)
  var checked = 0
  for row in table.split('\n'):
    let f = row.split(' ')
    let got = sampleFromStack(noiseStack, idx, vec3[int32](int32(num(f[0])), int32(num(f[1])), int32(num(f[2]))), options)
    note(got == num(f[3]), name, row)
    inc checked
  echo name, " table: ", checked, " values"

checkTable("vein_toggle", TableVeinToggle)
checkTable("vein_ridged", TableVeinRidged)
checkTable("vein_gap", TableVeinGap)

proc compareDump(label: string, data: seq[float64], stack: ChunkStack, top, step: int) =
  var i = 0
  var checked = 0
  var bad = 0
  var worst = 0.0'f64
  while i < data.len:
    let got = sampleFromStack(stack, top, vec3[int32](int32(data[i]), int32(data[i + 1]), int32(data[i + 2])), options)
    let delta = abs(got - data[i + 3])
    if delta > worst:
      worst = delta
    if not (delta <= Epsilon):
      inc bad
    inc checked
    i += 4 * step
  echo label, ": ", checked, " values, ", bad, " beyond epsilon, largest difference ", worst
  if bad != 0:
    inc failures

block configFinalDensity:
  compareDump("final_density_dump_7_4", readNumbers(assetPath("final_density_dump_7_4.json")), noiseStack,
    int(base.noise.finalDensity), 5)

# --- test_deserializer.rs ---------------------------------------------------------------------

proc field(j: JsonValue, key: string): JsonValue =
  let i = find(j, key)
  assert i >= 0, key
  j.vals[i]

proc numField(j: JsonValue, key: string): float64 =
  let v = field(j, key)
  case v.kind
  of jvInt: float64(v.intVal)
  of jvFloat: v.floatVal
  else: 0.0'f64

proc noiseIdOf(j: JsonValue, key: string): int32 =
  let (ok, params) = idToParameters(field(j, key).strVal)
  assert ok, field(j, key).strVal
  int32(params.id)

proc addRepr(j: JsonValue, stack: var ComponentStack): int32

proc addSpline(j: JsonValue, stack: var ComponentStack): int32 =
  ## `SplineRepr::as_base_component`
  let v = field(j, "value")
  if field(j, "_type").strVal == "fixed":
    stack.splines.add(SplineRepr(kind: SplineReprKind.Fixed, value: float32(numField(v, "value"))))
    return int32(stack.splines.len - 1)
  let functionIndex = addRepr(field(v, "locationFunction"), stack)
  let locations = field(v, "locations").items
  let values = field(v, "values").items
  let derivatives = field(v, "derivatives").items
  var points = newSeq[SplinePoint](locations.len)
  for i in 0 ..< locations.len:
    let loc = if locations[i].kind == jvInt: float32(locations[i].intVal) else: float32(locations[i].floatVal)
    let der = if derivatives[i].kind == jvInt: float32(derivatives[i].intVal) else: float32(derivatives[i].floatVal)
    points[i] = SplinePoint(location: loc, value: addSpline(values[i], stack), derivative: der)
  stack.splines.add(SplineRepr(kind: SplineReprKind.Standard, locationFunctionIndex: functionIndex, points: points))
  int32(stack.splines.len - 1)

proc addRepr(j: JsonValue, stack: var ComponentStack): int32 =
  ## `DensityFunctionRepr::as_base_component` and `index`, without upstream's dedup: nothing here caches.
  let cls = field(j, "_class").strVal
  var c = BaseNoiseFunctionComponent()
  var v = jsonNull()
  if find(j, "value") >= 0:
    v = field(j, "value")
  case cls
  of "BlendAlpha": c.kind = BaseNoiseFunctionComponentKind.BlendAlpha
  of "BlendOffset": c.kind = BaseNoiseFunctionComponentKind.BlendOffset
  of "Beardifier": c.kind = BaseNoiseFunctionComponentKind.Beardifier
  of "EndIslands": c.kind = BaseNoiseFunctionComponentKind.EndIslands
  of "BlendDensity":
    c.kind = BaseNoiseFunctionComponentKind.BlendDensity
    c.inputIndex = addRepr(field(v, "input"), stack)
  of "Noise":
    c.kind = BaseNoiseFunctionComponentKind.Noise
    c.noiseId = noiseIdOf(v, "noise")
    c.xzScale = numField(v, "xzScale")
    c.yScale = numField(v, "yScale")
  of "ShiftA":
    c.kind = BaseNoiseFunctionComponentKind.ShiftA
    c.noiseId = noiseIdOf(v, "offsetNoise")
  of "ShiftB":
    c.kind = BaseNoiseFunctionComponentKind.ShiftB
    c.noiseId = noiseIdOf(v, "offsetNoise")
  of "ShiftedNoise":
    c.kind = BaseNoiseFunctionComponentKind.ShiftedNoise
    c.shiftXIndex = addRepr(field(v, "shiftX"), stack)
    c.shiftYIndex = addRepr(field(v, "shiftY"), stack)
    c.shiftZIndex = addRepr(field(v, "shiftZ"), stack)
    c.noiseId = noiseIdOf(v, "noise")
    c.xzScale = numField(v, "xzScale")
    c.yScale = numField(v, "yScale")
  of "InterpolatedNoiseSampler":
    c.kind = BaseNoiseFunctionComponentKind.InterpolatedNoiseSampler
    # The fixture's `scaled*` are already multiplied out. The router's multiply by 684.412, and y by xzFactor / yFactor
    # as well, which for overworld data makes y 0.25 where the fixture's `yScale` says 0.125.
    c.scaledXzScale = numField(v, "xzScale")
    c.scaledYScale = numField(v, "yScale") * numField(v, "yFactor") / numField(v, "xzFactor")
    c.xzFactor = numField(v, "xzFactor")
    c.yFactor = numField(v, "yFactor")
    c.smearScaleMultiplier = numField(v, "smearScaleMultiplier")
  of "Wrapping":
    c.kind = BaseNoiseFunctionComponentKind.Wrapper
    c.inputIndex = addRepr(field(v, "wrapped"), stack)
    c.wrapper = WrapperType.CacheOnce
  of "Constant":
    c.kind = BaseNoiseFunctionComponentKind.Constant
    c.value = numField(v, "value")
  of "YClampedGradient":
    c.kind = BaseNoiseFunctionComponentKind.ClampedYGradient
    c.fromY = numField(v, "fromY")
    c.toY = numField(v, "toY")
    c.fromValue = numField(v, "fromValue")
    c.toValue = numField(v, "toValue")
  of "BinaryOperation":
    c.kind = BaseNoiseFunctionComponentKind.Binary
    c.argument1Index = addRepr(field(v, "argument1"), stack)
    c.argument2Index = addRepr(field(v, "argument2"), stack)
    c.binaryOperation = case field(v, "type").strVal
      of "ADD": BinaryOperation.Add
      of "MUL": BinaryOperation.Mul
      of "MIN": BinaryOperation.Min
      else: BinaryOperation.Max
  of "LinearOperation":
    c.kind = BaseNoiseFunctionComponentKind.Linear
    c.inputIndex = addRepr(field(v, "input"), stack)
    c.linearOperation = if field(v, "specificType").strVal == "ADD": LinearOperation.Add else: LinearOperation.Mul
    c.argument = numField(v, "argument")
  of "UnaryOperation":
    c.kind = BaseNoiseFunctionComponentKind.Unary
    c.inputIndex = addRepr(field(v, "input"), stack)
    c.unaryOperation = case field(v, "type").strVal
      of "ABS": UnaryOperation.Abs
      of "SQUARE": UnaryOperation.Square
      of "CUBE": UnaryOperation.Cube
      of "HALF_NEGATIVE": UnaryOperation.HalfNegative
      of "QUARTER_NEGATIVE": UnaryOperation.QuarterNegative
      else: UnaryOperation.Squeeze
  of "Clamp":
    c.kind = BaseNoiseFunctionComponentKind.Clamp
    c.inputIndex = addRepr(field(v, "input"), stack)
    c.minValue = numField(v, "minValue")
    c.maxValue = numField(v, "maxValue")
  of "RangeChoice":
    c.kind = BaseNoiseFunctionComponentKind.RangeChoice
    c.inputIndex = addRepr(field(v, "input"), stack)
    c.whenInRangeIndex = addRepr(field(v, "whenInRange"), stack)
    c.whenOutRangeIndex = addRepr(field(v, "whenOutOfRange"), stack)
    c.minInclusive = numField(v, "minInclusive")
    c.maxExclusive = numField(v, "maxExclusive")
  of "Spline":
    c.kind = BaseNoiseFunctionComponentKind.Spline
    c.spline = addSpline(field(v, "spline"), stack)
  else:
    assert false, "no component for " & cls
  stack.components.add(c)
  int32(stack.components.len - 1)

proc runBase(reprs: JsonValue, key, fixture: string) =
  var stack = ComponentStack(components: @[], splines: @[])
  let top = addRepr(field(reprs, key), stack)
  let proto = generateProtoStack(stack, randomConfig)
  compareDump(key, readNumbers(assetPath(fixture)), passThroughStack(proto, proto.components.len), int(top), 1)

proc baseDensityFunctions() =
  var text = ""
  try:
    text = readFile(assetPath("density_function_tests.json"))
  except:
    quit(1)
  # serde_json5 reads these. Only range fields hold infinities, and only Clamp's are read, which are finite.
  let parsed = parseJsonValue(text.replace("Infinity", "1e300"))
  assert parsed.ok, parsed.error
  runBase(parsed.value, "overworld/sloped_cheese", "converted_sloped_cheese_7_4.json")
  runBase(parsed.value, "overworld/factor", "converted_factor_7_4.json")
  runBase(parsed.value, "overworld/depth", "converted_depth_7_4.json")
  runBase(parsed.value, "overworld/offset", "converted_offset_7_4.json")
  runBase(parsed.value, "overworld/base_3d_noise", "converted_3d_overworld_7_4.json")
  runBase(parsed.value, "overworld/caves/spaghetti_roughness_function", "converted_cave_spaghetti_rough_overworld_7_4.json")
  runBase(parsed.value, "overworld/caves/noodle", "converted_cave_noodle_7_4.json")
  runBase(parsed.value, "overworld/caves/pillars", "converted_cave_pillar_7_4.json")
  runBase(parsed.value, "overworld/caves/spaghetti_2d_thickness_modulator", "converted_cave_spaghetti_2d_thicc_7_4.json")

baseDensityFunctions()

if failures > 0:
  echo failures, " failed"
  quit(1)
echo "router_densitytest ok"
