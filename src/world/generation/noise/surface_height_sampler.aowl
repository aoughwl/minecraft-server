## Port of pumpkin-world/src/generation/noise/router/surface_height_sampler.rs

{.feature: "lenientnils".}

import std/tables
import std/math
import ../../../util/random/rustnum
import ../generation
import ../positions
import router

type
  SurfaceHeightSamplerBuilderOptions* = object
    startBiomeX*, startBiomeZ*: int32
    horizontalBiomeEnd*: int
    minimumY*, maximumY*: int32
    yLevelStepCount*: int

  SurfaceHeightEstimateSampler* = ref object
    minimumY*, maximumY*: int32
    yLevelStepCount*: int
    stack*: ChunkStack
    cache*: Table[uint64, int32]

proc newSurfaceHeightSamplerBuilderOptions*(startBiomeX, startBiomeZ: int32, horizontalBiomeEnd: int,
                                            minimumY, maximumY: int32, yLevelStepCount: int): SurfaceHeightSamplerBuilderOptions =
  SurfaceHeightSamplerBuilderOptions(startBiomeX: startBiomeX, startBiomeZ: startBiomeZ,
    horizontalBiomeEnd: horizontalBiomeEnd, minimumY: minimumY, maximumY: maximumY, yLevelStepCount: yLevelStepCount)

proc generateSurfaceHeightEstimateSampler*(base: ProtoSurfaceEstimator,
                                           buildOptions: SurfaceHeightSamplerBuilderOptions): SurfaceHeightEstimateSampler =
  ## `SurfaceHeightEstimateSampler::generate`
  SurfaceHeightEstimateSampler(
    stack: generateStackForSampler(base.stack, buildOptions.startBiomeX, buildOptions.startBiomeZ, buildOptions.horizontalBiomeEnd),
    maximumY: buildOptions.maximumY, minimumY: buildOptions.minimumY, yLevelStepCount: buildOptions.yLevelStepCount,
    cache: initTable[uint64, int32]())

proc calculateHeightEstimate(s: SurfaceHeightEstimateSampler, alignedX, alignedZ: int32): int32 =
  let sampleOptions = skipCellCachesOptions()
  let pos = vec3[int32](alignedX, 0'i32, alignedZ)
  let top = s.stack.comps.len - 1
  # If the top-most component is FindTopSurface, perform a precise search rather than the coarse
  # cell-stepping search it does internally.
  if s.stack.comps[top].kind == ChunkKind.Proto and s.stack.comps[top].proto.kind == ProtoKind.FindTopSurface:
    let fts = s.stack.comps[top].proto
    let upper = sampleFromStack(s.stack, fts.input2Index, pos, sampleOptions)
    # First find the coarse cell that contains the surface.
    let cellHeight = fts.cellHeight
    var y = wrapMul(asI32(floor(upper / float64(cellHeight))), cellHeight)
    while y >= s.minimumY:
      let density = sampleFromStack(s.stack, fts.inputIndex, vec3[int32](alignedX, y, alignedZ), sampleOptions)
      if density > 0.0'f64:
        return y
      y -= cellHeight
    return s.minimumY
  let surfaceY = sampleFromStack(s.stack, top, pos, sampleOptions)
  asI32(floor(surfaceY))

proc estimateHeight*(s: SurfaceHeightEstimateSampler, blockX, blockZ: int32): int32 =
  ## `SurfaceHeightEstimateSampler::estimate_height`
  let biomeAlignedX = biomeToBlock(biomeFromBlock(blockX))
  let biomeAlignedZ = biomeToBlock(biomeFromBlock(blockZ))
  let packedColumn = packedChunkI32(biomeAlignedX, biomeAlignedZ)
  let cached = s.cache.getOrDefault(packedColumn, int32.low)
  if cached != int32.low:
    return cached
  let estimate = calculateHeightEstimate(s, biomeAlignedX, biomeAlignedZ)
  s.cache[packedColumn] = estimate
  estimate
