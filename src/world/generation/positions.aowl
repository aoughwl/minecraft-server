## Packed block and chunk positions. Port of pumpkin-world/src/generation/positions.rs
##
## `SIZE_BITS_X` and friends are upstream's const expressions worked out: 30000000 rounds up to 2^25, so
## x and z take 26 bits and y the remaining 12.

const
  SizeBitsX* = 26
  SizeBitsZ* = SizeBitsX
  SizeBitsY* = 64 - SizeBitsX - SizeBitsZ
  BitsX = (1'i64 shl SizeBitsX) - 1'i64
  BitsZ = (1'i64 shl SizeBitsZ) - 1'i64
  BitsY = (1'i64 shl SizeBitsY) - 1'i64
  BitShiftZ = SizeBitsY
  BitShiftX = SizeBitsY + SizeBitsZ
  MaxHeight* = (1'i32 shl SizeBitsY) - 32'i32
  MaxColumnHeight* = (MaxHeight shr 1) - 1'i32
  MinHeight* = MaxColumnHeight - MaxHeight + 1'i32
  MinHeightCell* = MinHeight * 16'i32

# `block_pos`

proc unpackBlockX*(packed: int64): int32 {.inline.} =
  int32((packed shl (64 - BitShiftX - SizeBitsX)) shr (64 - SizeBitsX))

proc unpackBlockY*(packed: int64): int32 {.inline.} =
  int32((packed shl (64 - SizeBitsY)) shr (64 - SizeBitsY))

proc unpackBlockZ*(packed: int64): int32 {.inline.} =
  int32((packed shl (64 - BitShiftZ - SizeBitsZ)) shr (64 - SizeBitsZ))

proc packedBlock*(x, y, z: int64): int64 {.inline.} =
  var r = 0'i64
  r = r or ((x and BitsX) shl BitShiftX)
  r = r or ((z and BitsZ) shl BitShiftZ)
  r = r or (y and BitsY)
  r

# `chunk_pos`

proc packedChunk*(x, y: uint64): uint64 {.inline.} =
  (x and 4294967295'u64) or ((y and 4294967295'u64) shl 32)

proc packedChunkI32*(x, y: int32): uint64 {.inline.} =
  ## `packed(x as u64, y as u64)`
  packedChunk(cast[uint64](int64(x)), cast[uint64](int64(y)))

const ChunkPosMarker* = 1875066'u64 or (1875066'u64 shl 32)

proc unpackChunkX*(packed: uint64): int32 {.inline.} =
  cast[int32](uint32(packed and 4294967295'u64))

proc unpackChunkZ*(packed: uint64): int32 {.inline.} =
  cast[int32](uint32((packed shr 32) and 4294967295'u64))

proc startBlockX*(x: int32): int32 {.inline.} = x shl 4
proc endBlockX*(x: int32): int32 {.inline.} = startBlockX(x) + 15'i32
proc startBlockZ*(z: int32): int32 {.inline.} = z shl 4
proc endBlockZ*(z: int32): int32 {.inline.} = startBlockZ(z) + 15'i32
proc getCenterX*(coord: int32): int32 {.inline.} = (coord shl 4) + 8'i32
proc getCenterZ*(coord: int32): int32 {.inline.} = (coord shl 4) + 8'i32
