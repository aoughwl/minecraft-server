## Port of the tests in generation/positions.rs
import std/assertions
import std/syncio
import world/generation/positions

block chunkPacking:
  let x = 305135135'i32
  let y = -1351513511'i32
  let packed = packedChunkI32(x, y)
  assert cast[int64](packed) == -5804706329542001121'i64
  assert x == unpackChunkX(packed)
  assert y == unpackChunkZ(packed)

block blockPacking:
  let packed = packedBlock(-30000000'i64, 120'i64, 30000000'i64)
  assert packed == -8246337085439999880'i64
  assert -30000000'i32 == unpackBlockX(packed)
  assert 120'i32 == unpackBlockY(packed)
  assert 30000000'i32 == unpackBlockZ(packed)
  for x in -10 .. 10:
    for y in -10 .. 10:
      for z in -10 .. 10:
        let p = packedBlock(int64(x * 1000000), int64(y * 10), int64(z * 1000000))
        assert int32(x * 1000000) == unpackBlockX(p)
        assert int32(y * 10) == unpackBlockY(p)
        assert int32(z * 1000000) == unpackBlockZ(p)

assert MinHeightCell == -32512'i32
echo "positionstest ok"
