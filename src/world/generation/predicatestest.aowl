## Generation's small modules, which upstream gives no tests of their own: rule/rule.aowl, height_provider.aowl,
## block_predicate.aowl, block_state_provider.aowl, generator/structure_finder.aowl and blender/blender.aowl. Checks
## here are by hand from the Rust: the random-less answers, and the stream a provider draws from.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import std/tables
import ../blockstates
import ../chunkdata
import ../tick
import ../world
import ../../generated/carver
import ../../generated/dimension as dimensiondata
import ../../generated/tag
import ../../generated/structures
import structure/placement
import ../../util/y_offset
import ../../util/utillib
import ../../util/legacy_rand
import ../../util/vector3
import ../../util/random/random
import rule/rule
import height_provider
import block_predicate
import block_state_provider
import generator/structure_finder
import blender/blender
import proto_chunk
import noise/doubleperlin

proc sid(name: string): blockstates.BlockStateId =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc bid(name: string): int =
  let (ok, id) = blockIdByName(name)
  assert ok, name
  id

proc absolute(y: int16): YOffset = YOffset(kind: yokAbsolute, absolute: y)

block ruleTests:
  var r = toRandomGenerator(legacy_rand.fromSeed(1'u64))
  let stone = sid("stone")
  assert test(RuleTest(kind: RuleTestKind.AlwaysTrue), stone, r), """test(RuleTest(kind: RuleTestKind.AlwaysTrue), stone, r)"""
  assert test(RuleTest(kind: RuleTestKind.BlockMatch, blockId: bid("stone")), stone, r), """test(RuleTest(kind: RuleTestKind.BlockMatch, blockId: bid('stone')), stone, r)"""
  assert not test(RuleTest(kind: RuleTestKind.BlockMatch, blockId: bid("dirt")), stone, r), """not test(RuleTest(kind: RuleTestKind.BlockMatch, blockId: bid('dirt')), stone, r)"""
  assert test(RuleTest(kind: RuleTestKind.BlockStateMatch, blockState: stone), stone, r), """test(RuleTest(kind: RuleTestKind.BlockStateMatch, blockState: stone), stone, r)"""
  assert not test(RuleTest(kind: RuleTestKind.BlockStateMatch, blockState: sid("dirt")), stone, r), """not test(RuleTest(kind: RuleTestKind.BlockStateMatch, blockState: sid('dirt')), stone, r)"""
  # The draw happens only when the state matches, and the fixed stream decides it.
  var fixed = toRandomGenerator(legacy_rand.fromSeed(7'u64))
  let first = nextF32(fixed)
  var a = toRandomGenerator(legacy_rand.fromSeed(7'u64))
  assert test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: stone, probability: first + 0.001'f32), stone, a), """test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: stone, probability: first + 0.001'f32), stone, a)"""
  var b = toRandomGenerator(legacy_rand.fromSeed(7'u64))
  assert not test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: stone, probability: first), stone, b), """not test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: stone, probability: first), stone, b)"""
  var c = toRandomGenerator(legacy_rand.fromSeed(7'u64))
  assert not test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: sid("dirt"), probability: 1.0'f32), stone, c), """not test(RuleTest(kind: RuleTestKind.RandomBlockStateMatch, blockState: sid('dirt'), probability: 1.0'f32), stone, c)"""
  assert nextF32(c) == first, """nextF32(c) == first"""

block heightProviders:
  var r = toRandomGenerator(legacy_rand.fromSeed(99'u64))
  let uniform = HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: absolute(10'i16), maxInclusive: absolute(20'i16))
  for _ in 0 ..< 200:
    let v = height_provider.get(uniform, r, -64'i8, 384'u16)
    assert v >= 10'i32 and v <= 20'i32, """v >= 10'i32 and v <= 20'i32"""
  # An empty trapezoid answers its bottom and draws nothing.
  let empty = HeightProvider(kind: HeightProviderKind.Trapezoid, minInclusive: absolute(5'i16), maxInclusive: absolute(1'i16))
  var d = toRandomGenerator(legacy_rand.fromSeed(5'u64))
  var e = toRandomGenerator(legacy_rand.fromSeed(5'u64))
  assert height_provider.get(empty, d, -64'i8, 384'u16) == 5'i32, """height_provider.get(empty, d, -64'i8, 384'u16) == 5'i32"""
  assert nextI32(d) == nextI32(e), """nextI32(d) == nextI32(e)"""
  let trapezoid = HeightProvider(kind: HeightProviderKind.Trapezoid, minInclusive: absolute(0'i16), maxInclusive: absolute(40'i16),
    hasPlateau: true, plateau: 10'i32)
  for _ in 0 ..< 200:
    let v = height_provider.get(trapezoid, r, -64'i8, 384'u16)
    assert v >= 0'i32 and v <= 40'i32, """v >= 0'i32 and v <= 40'i32"""
  let biased = HeightProvider(kind: HeightProviderKind.VeryBiasedToBottom, minInclusive: absolute(0'i16), maxInclusive: absolute(40'i16))
  for _ in 0 ..< 200:
    let v = height_provider.get(biased, r, -64'i8, 384'u16)
    assert v >= 0'i32 and v <= 40'i32, """v >= 0'i32 and v <= 40'i32"""

proc testChunk(): ProtoChunk =
  let wg = getWorldGen(1'u64, dimensiondata.OVERWORLD, true, @[], "")
  result = newProtoChunk(0'i32, 0'i32, wg)

block predicates:
  let chunk = testChunk()
  let cache = protoChunkAsGenerationCache(chunk)
  let portal = noOpWorldPortal()
  setBlockState(chunk, 1'i32, 10'i32, 1'i32, sid("stone"))
  setBlockState(chunk, 1'i32, 11'i32, 1'i32, sid("short_grass"))
  let at = blockPos(1'i32, 10'i32, 1'i32)
  let above = blockPos(1'i32, 11'i32, 1'i32)
  assert test(BlockPredicate(kind: BlockPredicateKind.AlwaysTrue), portal, cache, at), """test(BlockPredicate(kind: BlockPredicateKind.AlwaysTrue), portal, cache, at)"""
  let matching = BlockPredicate(kind: BlockPredicateKind.MatchingBlocks, names: @["minecraft:stone", "minecraft:dirt"])
  assert test(matching, portal, cache, at), """test(matching, portal, cache, at)"""
  assert not test(matching, portal, cache, above), """not test(matching, portal, cache, above)"""
  let offsetUp = BlockPredicate(kind: BlockPredicateKind.MatchingBlocks, names: @["minecraft:short_grass"],
    hasOffset: true, offset: vec3[int32](0'i32, 1'i32, 0'i32))
  assert test(offsetUp, portal, cache, at), """test(offsetUp, portal, cache, at)"""
  assert test(BlockPredicate(kind: BlockPredicateKind.Solid), portal, cache, at), """test(BlockPredicate(kind: BlockPredicateKind.Solid), portal, cache, at)"""
  assert test(BlockPredicate(kind: BlockPredicateKind.Replaceable), portal, cache, above), """test(BlockPredicate(kind: BlockPredicateKind.Replaceable), portal, cache, above)"""
  assert not test(BlockPredicate(kind: BlockPredicateKind.Replaceable), portal, cache, at), """not test(BlockPredicate(kind: BlockPredicateKind.Replaceable), portal, cache, at)"""
  assert test(BlockPredicate(kind: BlockPredicateKind.HasSturdyFace, direction: 1), portal, cache, at), """test(BlockPredicate(kind: BlockPredicateKind.HasSturdyFace, direction: 1), portal, cache, at)"""
  let notMatching = BlockPredicate(kind: BlockPredicateKind.Not, predicates: @[matching])
  assert not test(notMatching, portal, cache, at), """not test(notMatching, portal, cache, at)"""
  assert test(BlockPredicate(kind: BlockPredicateKind.AnyOf, predicates: @[notMatching, matching]), portal, cache, at), """test(BlockPredicate(kind: BlockPredicateKind.AnyOf, predicates: @[notMatching, matching]), portal, cache, at)"""
  assert not test(BlockPredicate(kind: BlockPredicateKind.AllOf, predicates: @[notMatching, matching]), portal, cache, at), """not test(BlockPredicate(kind: BlockPredicateKind.AllOf, predicates: @[notMatching, matching]), portal, cache, at)"""
  let bounds = BlockPredicate(kind: BlockPredicateKind.InsideWorldBounds, offset: vec3[int32](0'i32, 400'i32, 0'i32))
  assert not test(bounds, portal, cache, at), """not test(bounds, portal, cache, at)"""

block providers:
  let chunk = testChunk()
  let cache = protoChunkAsGenerationCache(chunk)
  let portal = noOpWorldPortal()
  var r = toRandomGenerator(legacy_rand.fromSeed(3'u64))
  let at = blockPos(0'i32, 64'i32, 0'i32)
  let simple = BlockStateProvider(kind: BlockStateProviderKind.Simple, state: sid("stone"))
  assert get(simple, r, at, cache, portal) == sid("stone"), """get(simple, r, at, cache, portal) == sid('stone')"""
  let matching = BlockPredicate(kind: BlockPredicateKind.AlwaysTrue)
  let rule = BlockStateProvider(kind: BlockStateProviderKind.Rule, rules: @[BlockStateRule(ifTrue: matching, then: simple)])
  assert get(rule, r, at, cache, portal) == sid("stone"), """get(rule, r, at, cache, portal) == sid('stone')"""
  let never = BlockPredicate(kind: BlockPredicateKind.Not, predicates: @[matching])
  let noRule = BlockStateProvider(kind: BlockStateProviderKind.Rule, rules: @[BlockStateRule(ifTrue: never, then: simple)])
  assert not getOptional(noRule, portal, cache, r, at).hasState, """not getOptional(noRule, portal, cache, r, at).hasState"""
  let fallback = BlockStateProvider(kind: BlockStateProviderKind.Rule, fallback: simple, rules: @[])
  assert getOptional(fallback, portal, cache, r, at).state == sid("stone"), """getOptional(fallback, portal, cache, r, at).state == sid('stone')"""
  let noise = BlockStateProvider(kind: BlockStateProviderKind.NoiseProvider, states: @[sid("stone"), sid("dirt")],
    base: NoiseBlockStateProviderBase(seed: 1'i64, scale: 0.02'f32,
      noise: DoublePerlinNoiseParametersCodec(firstOctave: 0'i32, amplitudes: @[1.0'f64], amplitude: 0.8333333333333333'f64)))
  let picked = get(noise, r, at, cache, portal)
  assert picked == sid("stone") or picked == sid("dirt"), """picked == sid('stone') or picked == sid('dirt')"""
  assert get(noise, r, at, cache, portal) == picked, """get(noise, r, at, cache, portal) == picked"""

block finder:
  # Rings pass: the nearest stronghold chunk's center.
  let cache = newGlobalStructureCache()
  setStrongholdChunks(cache, @[(100'i32, 0'i32), (1'i32, 1'i32)])
  let rings = StructurePlacement(placementType: StructurePlacementType(kind: StructurePlacementKind.ConcentricRings))
  let near = findNearestStructure(blockPos(0'i32, 0'i32, 0'i32), @[rings], 1'i32, 0'i64, cache)
  assert near.found and near.pos.x == 24'i32 and near.pos.z == 24'i32, """near.found and near.pos.x == 24'i32 and near.pos.z == 24'i32"""
  # Spread pass: radius 0 finds the region's chunk and stops the search.
  let spreadPlacement = RandomSpreadStructurePlacement(spacing: 16'i32, separation: 4'i32)
  let spread = StructurePlacement(placementType: StructurePlacementType(kind: StructurePlacementKind.RandomSpread,
    randomSpread: spreadPlacement), salt: 5'u32)
  let found = findNearestStructure(blockPos(0'i32, 0'i32, 0'i32), @[spread], 8'i32, 0'i64, cache)
  let (structCx, structCz) = getStructureChunkInRegion(spreadPlacement, 0'i64, 0'i32, 0'i32, 5'u32)
  assert found.found and found.pos.x == (structCx shl 4) + 8'i32 and found.pos.z == (structCz shl 4) + 8'i32, """found at the region's chunk"""
  assert not findNearestStructure(blockPos(0'i32, 0'i32, 0'i32), @[], 8'i32, 0'i64, cache).found

block blenderEmpty:
  let b = emptyBlender()
  assert isEmpty(b), """isEmpty(b)"""
  let o = blendOffsetAndFactor(b, 10'i32, 10'i32)
  assert o.alpha == 1.0'f64 and o.blendingOffset == 0.0'f64, """o.alpha == 1.0'f64 and o.blendingOffset == 0.0'f64"""
  assert blendDensity(b, 10'i32, 10'i32, 10'i32, 0.25'f64) == 0.25'f64, """blendDensity(b, 10'i32, 10'i32, 10'i32, 0.25'f64) == 0.25'f64"""

block blenderWithData:
  # A chunk whose blending heights are all 64: inside it the height is read straight back.
  var heights = newSeq[float64](256)
  var biomes = newSeq[uint8](256)
  for i in 0 ..< 256:
    heights[i] = 64.0'f64
    biomes[i] = 3'u8
  let data = BlendingData(minY: 0'i32, maxY: 8'i32, heights: heights, densities: @[], biomes: biomes)
  let b = emptyBlender()
  b.heightAndBiomeBlendingData[0'u64] = data
  assert not isEmpty(b), """not isEmpty(b)"""
  let inside = blendOffsetAndFactor(b, 4'i32, 4'i32)
  assert inside.alpha == 0.0'f64, """inside.alpha == 0.0'f64"""
  # Out of the chunk: weights from the nearest cells, which are all 64, and an alpha from the distance.
  let outside = blendOffsetAndFactor(b, 120'i32, 4'i32)
  assert outside.alpha > 0.0'f64 and outside.alpha < 1.0'f64, """outside.alpha > 0.0'f64 and outside.alpha < 1.0'f64"""
  assert abs(outside.blendingOffset - inside.blendingOffset) < 1e-9'f64, "the weighted height is still 64"

echo "predicatestest ok"
