## Port of generation/proto_chunk_test.rs, plus the `no_blend_no_beard_*.chunk` fixtures in assets/: each is a whole
## flat block map dumped from vanilla, which upstream's older tests compared to and its current ones no longer
## read. Every cell must match. Run from the repo root.

{.feature: "lenientnils".}

import std/syncio
import std/tables
import std/assertions
import std/times
import ../blockstates
import ../chunkdata
import ../../generated/dimension
import ../../generated/noise_router
import ../../generated/block_state_remap
import ../../util/javaversion
import noise/router
import proto_chunk
import fixtures
import ../chunk_system/chunk_state
import ../../config/lighting

const FixtureVersion = jmvV1_21_11

var failures = 0

proc expectEq(a, b: int, what: string) =
  if a != b:
    echo "FAIL ", what, ": ", a, " != ", b
    inc failures

proc compareTo(name: string, c: ProtoChunk): int =
  ## Fixture ids are the state ids of the vanilla version it was dumped from, not 26.2's; generated/block_state_remap
  ## says what a 26.2 id was in that version.
  let expected = readNumbers(assetPath(name))
  expectEq(expected.len, c.flatBlockMap.len, name & " length")
  var bad = 0
  var mapped = newSeq[uint16](BsStateCount)
  var isMapped = newSeq[bool](BsStateCount)
  var firstBad = -1
  for i in 0 ..< expected.len:
    let id = int(c.flatBlockMap[i])
    if not isMapped[id]:
      mapped[id] = remapBlockStateForVersion(uint16(id), FixtureVersion)
      isMapped[id] = true
    if int(expected[i]) != int(mapped[id]):
      if firstBad < 0:
        firstBad = i
      inc bad
  echo name, ": ", expected.len, " cells, ", bad, " differ"
  bad

proc noiseChunk(wg: WorldGenerator, cx, cz: int32): ProtoChunk =
  ## What the tests do: no structures, so no beardifier input.
  result = newProtoChunk(cx, cz, wg)
  stepToBiomes(result, wg.noise)
  result.stage = StagedChunkEnum.StructureReferences
  stepToNoise(result, wg.noise)

proc checkNoise(name: string, seed: uint64, cx, cz: int32) =
  let wg = getWorldGen(seed, OVERWORLD, false, @[], "")
  let c = noiseChunk(wg, cx, cz)
  expectEq(compareTo(name, c), 0, name)

proc checkSurface(name: string, seed: uint64, cx, cz: int32) =
  let wg = getWorldGen(seed, OVERWORLD, false, @[], "")
  let c = noiseChunk(wg, cx, cz)
  stepToSurface(c, wg.noise)
  expectEq(compareTo(name, c), 0, name)

proc checkOnlyWrappers(name: string, keepInterpolated, keepCache2d, keepCacheFlat, keepCacheOnce: bool) =
  ## The `only_cell_cache*` fixtures: vanilla's router with every other wrapper replaced by its input.
  let wg = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let comps = wg.noise.baseRouter.noise.stack.components
  for i in 0 ..< comps.len:
    if comps[i].kind == ProtoKind.Wrapper:
      let w = comps[i].wrapper
      let keep = w == WrapperType.CellCache or (w == WrapperType.Interpolated and keepInterpolated) or
        (w == WrapperType.Cache2D and keepCache2d) or (w == WrapperType.CacheFlat and keepCacheFlat) or
        (w == WrapperType.CacheOnce and keepCacheOnce)
      if not keep:
        comps[i].kind = ProtoKind.PassThrough
  let c = noiseChunk(wg, 0'i32, 0'i32)
  expectEq(compareTo(name, c), 0, name)

let startedAt = getTime()

checkNoise("no_blend_no_beard_0_0.chunk", 0'u64, 0'i32, 0'i32)
checkNoise("no_blend_no_beard_7_4.chunk", 0'u64, 7'i32, 4'i32)
checkNoise("no_blend_no_beard_-595_544.chunk", 0'u64, -595'i32, 544'i32)
checkNoise("no_blend_no_beard_-119_183.chunk", 0'u64, -119'i32, 183'i32)
checkNoise("no_blend_no_beard_13579_-2_15.chunk", 13579'u64, -2'i32, 15'i32)
checkNoise("no_blend_no_beard_13579_-6_11.chunk", 13579'u64, -6'i32, 11'i32)

checkSurface("no_blend_no_beard_surface_0_0.chunk", 0'u64, 0'i32, 0'i32)
checkSurface("no_blend_no_beard_surface_13579_-2_15.chunk", 13579'u64, -2'i32, 15'i32)
checkSurface("no_blend_no_beard_surface_13579_-6_11.chunk", 13579'u64, -6'i32, 11'i32)
checkSurface("no_blend_no_beard_surface_13579_-7_9.chunk", 13579'u64, -7'i32, 9'i32)
checkSurface("no_blend_no_beard_surface_badlands_-595_544.chunk", 0'u64, -595'i32, 544'i32)
checkSurface("no_blend_no_beard_surface_frozen_ocean_-119_183.chunk", 0'u64, -119'i32, 183'i32)

checkOnlyWrappers("no_blend_no_beard_only_cell_cache_0_0.chunk", false, false, false, false)
checkOnlyWrappers("no_blend_no_beard_only_cell_cache_flat_cache_0_0.chunk", false, false, true, false)
checkOnlyWrappers("no_blend_no_beard_only_cell_cache_interpolated_0_0.chunk", true, false, false, false)
# Upstream reads none of the `only_cell_cache` fixtures any more. The once-cache variant used to differ in 936 cells:
# upstream's `ChunkIndexMapper::at` does not bump the result id as `InterpolationIndexMapper::at` does, so a CacheOnce
# filled through the cell-cache mapper returned the first index's value for the whole cell. A cache must not change
# the values, and with the bump this configuration equals the plain `only_cell_cache` fixture (0 cells differ).
# The once_cache fixture itself differs from that one in 7 cells (an older dump), so it is pinned at 7.
block onceCacheVariant:
  let wg = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let comps = wg.noise.baseRouter.noise.stack.components
  for i in 0 ..< comps.len:
    if comps[i].kind == ProtoKind.Wrapper and comps[i].wrapper != WrapperType.CellCache and
        comps[i].wrapper != WrapperType.CacheOnce:
      comps[i].kind = ProtoKind.PassThrough
  let c = noiseChunk(wg, 0'i32, 0'i32)
  expectEq(compareTo("no_blend_no_beard_only_cell_cache_0_0.chunk", c), 0, "once cache variant is transparent")
  expectEq(compareTo("no_blend_no_beard_only_cell_cache_once_cache_0_0.chunk", c), 7, "once cache variant, old dump")

echo "fixtures done in ", (getTime() - startedAt).inMilliseconds, " ms"

# `no_blend_no_beard_surface_0_0` in proto_chunk_test.rs
block:
  let wg = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let c = noiseChunk(wg, 0'i32, 0'i32)
  stepToSurface(c, wg.noise)
  assert blockNameOfState(getBlockStateRaw(c, 0'i32, 0'i32, 0'i32)) == "bedrock"
  var hasDeepslateOrStone = false
  for y in 10'i32 ..< 100'i32:
    let name = blockNameOfState(getBlockStateRaw(c, 8'i32, y, 8'i32))
    if name == "deepslate" or name == "stone":
      hasDeepslateOrStone = true
  assert hasDeepslateOrStone
  var hasSurfaceBlocks = false
  for y in 100'i32 ..< 384'i32:
    let name = blockNameOfState(getBlockStateRaw(c, 8'i32, y, 8'i32))
    if name == "grass_block" or name == "dirt" or name == "sand" or name == "water":
      hasSurfaceBlocks = true
  assert hasSurfaceBlocks

# `heightmap_roundtrip_through_chunk_data_resume`: transposed heightmaps during a Noise-stage resume. Flat terrain
# cannot expose this, so a sloped chunk.
block heightmapRoundtrip:
  let cx = 67'i32
  let cz = 63'i32
  let wg = getWorldGen(1779920288596261407'u64, OVERWORLD, false, @[], "")
  let proto = newProtoChunk(cx, cz, wg)
  stepToBiomes(proto, wg.noise)
  setStructureStarts(proto, wg.noise)
  setStructureReferences(proto, wg.noise)
  stepToNoise(proto, wg.noise)
  var expectedHeights = newSeq[int32](256)
  for z in 0'i32 ..< 16'i32:
    for x in 0'i32 ..< 16'i32:
      expectedHeights[int(z) * 16 + int(x)] = topBlockHeightExclusive(proto, x, z)
  let staged = protoChunk(proto)
  upgradeToLevelChunk(staged, OVERWORLD, lecDefault)
  assert staged.level != nil
  assert staged.level.status == csNoise
  let resumed = fromChunkData(staged.level, wg)
  assert resumed.stage == StagedChunkEnum.Noise
  var heightMismatches = 0
  for z in 0'i32 ..< 16'i32:
    for x in 0'i32 ..< 16'i32:
      if topBlockHeightExclusive(resumed, x, z) != expectedHeights[int(z) * 16 + int(x)]:
        inc heightMismatches
  expectEq(heightMismatches, 0, "heightmap corrupted by save/load roundtrip (transposed or lost)")
  stepToSurface(resumed, wg.noise)
  let fresh = newProtoChunk(cx, cz, wg)
  stepToBiomes(fresh, wg.noise)
  setStructureStarts(fresh, wg.noise)
  setStructureReferences(fresh, wg.noise)
  stepToNoise(fresh, wg.noise)
  stepToSurface(fresh, wg.noise)
  let bottom = int32(bottomY(fresh))
  let top = bottom + int32(height(fresh))
  var surfaceMismatches = 0
  for lz in 0'i32 ..< 16'i32:
    for lx in 0'i32 ..< 16'i32:
      let wx = cx * 16'i32 + lx
      let wz = cz * 16'i32 + lz
      var y = top - 1'i32
      var searching = true
      while searching and y >= bottom:
        let f = getBlockState(fresh, vec3[int32](wx, y, wz))
        if not isAir(f) and not isLiquid(f):
          if f != getBlockState(resumed, vec3[int32](wx, y, wz)):
            inc surfaceMismatches
          searching = false
        dec y
  expectEq(surfaceMismatches, 0, "resumed chunk surface differs from uninterrupted generation")

if failures > 0:
  echo failures, " checks failed"
  quit(1)
echo "proto_chunktest ok"
