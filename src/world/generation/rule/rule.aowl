## Block rule tests. Port of pumpkin-world/src/generation/rule/mod.rs,
## pumpkin-world/src/generation/rule/block_match.rs, pumpkin-world/src/generation/rule/block_state_match.rs,
## pumpkin-world/src/generation/rule/random_block_match.rs, pumpkin-world/src/generation/rule/random_block_state_match.rs
## and pumpkin-world/src/generation/rule/tag_match.rs
##
## `random_block_match.rs` compares the rule's block id to the state id, not to the state's block id. Kept: it is
## upstream's behaviour, and a fix belongs there first.

{.feature: "lenientnils".}

import ../../blockstates
import ../../../generated/tag
import ../../../util/random/random

type
  RuleTestKind* {.pure.} = enum
    AlwaysTrue, BlockMatch, BlockStateMatch, TagMatch, RandomBlockMatch, RandomBlockStateMatch

  RuleTest* = object
    kind*: RuleTestKind
    blockId*: int                        ## BlockMatch, RandomBlockMatch.
    blockState*: blockstates.BlockStateId ## BlockStateMatch, RandomBlockStateMatch.
    tag*: Tag                            ## TagMatch.
    probability*: float32                ## RandomBlockMatch, RandomBlockStateMatch.

proc test*(rule: RuleTest, state: blockstates.BlockStateId, random: var RandomGenerator): bool =
  ## `RuleTest::test`
  case rule.kind
  of RuleTestKind.AlwaysTrue: true
  of RuleTestKind.BlockMatch: blockIdOf(state) == rule.blockId
  of RuleTestKind.BlockStateMatch: rule.blockState == state
  of RuleTestKind.TagMatch: hasTag(uint16(blockIdOf(state)), rule.tag)
  of RuleTestKind.RandomBlockMatch: uint32(rule.blockId) == state and nextF32(random) < rule.probability
  of RuleTestKind.RandomBlockStateMatch: rule.blockState == state and nextF32(random) < rule.probability
