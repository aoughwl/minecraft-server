## Port of pumpkin-world/src/generation/structure/height_sampler.rs
##
## `preliminary` is built on first use: most chunks' samplers are never asked anything, and generating one costs more
## than the search around it. It is pure, so when it is built does not change an answer.

{.feature: "lenientnils".}

import std/tables
import ../../blockstates
import ../../../generated/chunk_gen_settings
from ../../../data/block_state import asU16
import ../../../util/math/mathmod
import ../generator/generator
import ../generation
import ../noise/noise
import ../noise/surface_height_sampler
import structures/structuresmod

type
  NoiseHeightSampler* = ref object of HeightSampler
    generator: VanillaGenerator
    startX, startZ: int32
    hasPreliminary: bool
    preliminary: SurfaceHeightEstimateSampler
    heights: Table[(int32, int32), int32]

proc preliminarySampler(s: NoiseHeightSampler): SurfaceHeightEstimateSampler =
  if not s.hasPreliminary:
    let shape = s.generator.settings.shape
    let horizontalBiomeEnd = int(biomeFromBlock(16))
    s.preliminary = generateSurfaceHeightEstimateSampler(s.generator.baseRouter.surfaceEstimator,
      newSurfaceHeightSamplerBuilderOptions(biomeFromBlock(s.startX), biomeFromBlock(s.startZ), horizontalBiomeEnd,
        int32(shape.minY), int32(maxY(shape)), int(verticalCellBlockCount(shape))))
    s.hasPreliminary = true
  s.preliminary

proc sampleColumn(s: NoiseHeightSampler, x, z: int32): int32 =
  let settings = s.generator.settings
  let shape = settings.shape
  let horizontal = int32(horizontalCellBlockCount(shape))
  let vertical = int32(verticalCellBlockCount(shape))
  let startX = floorDiv(x, horizontal) * horizontal
  let startZ = floorDiv(z, horizontal) * horizontal
  let localX = floorMod(x, horizontal)
  let localZ = floorMod(z, horizontal)
  let fluidSampler = newStandardChunkFluidLevelSampler(
    newFluidLevel(settings.seaLevel, blockIdOf(uint32(asU16(settings.defaultFluid)))),
    newFluidLevel(-54, blockIdByName("lava")[1]))
  var noEmptyStructures = newSeq[BeardifierStructure](0)
  var noEmptyJunctions = newSeq[BeardifierJunction](0)
  let noiseGen = newChunkNoiseGenerator(s.generator.baseRouter.noise, s.generator.randomConfig, 1, startX, startZ, shape,
    fluidSampler, settings.aquifersEnabled, false, noEmptyStructures, noEmptyJunctions, false, default(BlockBox))

  sampleStartDensity(noiseGen)
  sampleEndDensity(noiseGen, 0)
  let minimumCellY = floorDiv(int32(minY(noiseGen)), vertical)
  let cellCount = int32(height(noiseGen)) div vertical
  var cellY = cellCount - 1
  while cellY >= 0:
    onSampledCellCorners(noiseGen, 0, cellY, 0)
    let sampleStartY = (minimumCellY + cellY) * vertical
    var localY = vertical - 1
    while localY >= 0:
      let y = sampleStartY + localY
      interpolateY(noiseGen, float64(localY) / float64(vertical))
      interpolateX(noiseGen, float64(localX) / float64(horizontal))
      interpolateZ(noiseGen, float64(localZ) / float64(horizontal))
      let sampled = sampleBlockState(noiseGen, s.generator.randomConfig.oreRandomDeriver, startX, sampleStartY, startZ,
        localX, localY, localZ, preliminarySampler(s))
      let state = if sampled.hasState: sampled.state else: s.generator.defaultBlock
      if not isAir(state):
        return y + 1
      dec localY
    dec cellY
  int32(shape.minY)

proc estimateNoiseHeight(self: HeightSampler, blockX, blockZ: int32): int32 {.nimcall.} =
  let s = cast[NoiseHeightSampler](self)
  let key = (blockX, blockZ)
  if s.heights.hasKey(key):
    return s.heights.getOrDefault(key, 0'i32)
  result = sampleColumn(s, blockX, blockZ)
  s.heights[key] = result

proc newNoiseHeightSampler*(generator: VanillaGenerator, startX, startZ: int32): NoiseHeightSampler =
  NoiseHeightSampler(estimateFn: estimateNoiseHeight, generator: generator, startX: startX, startZ: startZ,
    hasPreliminary: false, heights: initTable[(int32, int32), int32]())
