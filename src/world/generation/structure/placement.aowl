## Port of pumpkin-world/src/generation/structure/placement.rs
##
## `should_generate_frequency` is the newer tree's; see there. `get_or_compute_structure_start`'s closure is split into `findStructureStart` and `storeStructureStart`. `getAllowedBiomes`
## is `ProtoChunk::get_allowed_biomes`, here because `should_generate_structure` calls it and generator.aowl sits above this.

##
## PARTIAL: pumpkin-world/src/generation/structure/placement.rs - `get_or_calculate_strongholds` asks the chunk that happens to
## call first for its biomes, so the rings' biome search depends on the order chunks generate in, as upstream's does. The save's
## radius holds no stronghold to check it against.

{.feature: "lenientnils".}

import std/math
import std/tables
import ../../../generated/structures
import ../../../generated/tag
import ../../../util/math/mathmod
import ../../../util/math/rustnum
import ../../../util/random/random
from ../../../util/random/rustnum import wrapAdd, wrapMul
import ../../../util/legacy_rand
import ../protochunkbase
import structures/structuresmod

type
  StructureStartKey = tuple[key: StructureKeys, chunkX, chunkZ: int32]

  GlobalStructureCache* = ref object
    hasStrongholdChunks: bool
    strongholdChunks: seq[(int32, int32)]
    structureStarts: Table[StructureStartKey, StructurePosition]

proc newGlobalStructureCache*(): GlobalStructureCache =
  GlobalStructureCache(hasStrongholdChunks: false, strongholdChunks: @[],
    structureStarts: initTable[StructureStartKey, StructurePosition]())

proc getStrongholdChunks*(c: GlobalStructureCache): seq[(int32, int32)] =
  c.strongholdChunks

proc findStructureStart*(c: GlobalStructureCache, key: StructureKeys, chunkX, chunkZ: int32,
                         found: var StructurePosition): bool =
  ## The lookup half of `get_or_compute_structure_start`. `found` may be nil: a computed start of `None`.
  let k: StructureStartKey = (key, chunkX, chunkZ)
  if c.structureStarts.hasKey(k):
    found = c.structureStarts.getOrDefault(k, nil)
    return true
  false

proc storeStructureStart*(c: GlobalStructureCache, key: StructureKeys, chunkX, chunkZ: int32, computed: StructurePosition) =
  ## The insert half of `get_or_compute_structure_start`.
  let k: StructureStartKey = (key, chunkX, chunkZ)
  c.structureStarts[k] = computed

type
  StructureStartEntry* = object
    key*: StructureKeys
    chunkX*, chunkZ*: int32
    position*: StructurePosition

proc structureStartEntries*(c: GlobalStructureCache): seq[StructureStartEntry] =
  ## What has been computed, for checks. Upstream's map is private.
  result = @[]
  for k, v in pairs(c.structureStarts):
    result.add(StructureStartEntry(key: k.key, chunkX: k.chunkX, chunkZ: k.chunkZ, position: v))

proc setStrongholdChunks*(c: GlobalStructureCache, chunks: seq[(int32, int32)]) =
  ## For a test of what reads them.
  c.strongholdChunks = chunks
  c.hasStrongholdChunks = true

proc containsBiome(allowed: openArray[uint16], id: uint16): bool =
  for i in 0 ..< allowed.len:
    if allowed[i] == id:
      return true
  false

proc getOrCalculateStrongholds*(c: GlobalStructureCache, seed: int64, placement: ConcentricRingsStructurePlacement,
                                biomeSupplier: ProtoChunk, allowedBiomes: openArray[uint16]): seq[(int32, int32)] =
  ## `get_or_calculate_strongholds`
  if c.hasStrongholdChunks:
    return c.strongholdChunks
  var chunks = newSeqOfCap[(int32, int32)](int(placement.count))
  let distanceParam = float64(placement.distance)
  var spread = placement.spread
  let count = placement.count
  var random = toRandomGenerator(legacy_rand.fromSeed(cast[uint64](seed)))
  var angle = nextF64(random) * PI * 2.0'f64
  var positionInCircle = 0'i32
  var circle = 0'i32
  var i = 0'i32
  while i < count:
    let dist = 4.0'f64 * distanceParam + distanceParam * float64(circle) * 6.0'f64 +
      (nextF64(random) - 0.5'f64) * (distanceParam * 2.5'f64)
    let initialX = asI32(floor(cos(angle) * dist + 0.5'f64))
    let initialZ = asI32(floor(sin(angle) * dist + 0.5'f64))
    let forkSeed = nextI64(random)
    var biomeSearchGenerator = toRandomGenerator(legacy_rand.fromSeed(cast[uint64](forkSeed)))
    var hasFoundPos = false
    var foundPos = (0'i32, 0'i32)
    var foundCount = 0'i32
    let centerBlockX = (initialX shl 4) + 8
    let centerBlockZ = (initialZ shl 4) + 8
    var dz = -112'i32
    while dz <= 112:
      var dx = -112'i32
      while dx <= 112:
        let testX = centerBlockX + dx
        let testZ = centerBlockZ + dz
        let biome = getBiome(biomeSupplier, testX, 0, testZ)
        if containsBiome(allowedBiomes, uint16(biome.id)):
          inc foundCount
          if not hasFoundPos or nextBoundedI32(biomeSearchGenerator, foundCount) == 0:
            hasFoundPos = true
            foundPos = (testX shr 4, testZ shr 4)
        dx += 4
      dz += 4
    chunks.add(if hasFoundPos: foundPos else: (initialX, initialZ))
    angle += (PI * 2.0'f64) / float64(spread)
    inc positionInCircle
    if positionInCircle == spread:
      inc circle
      positionInCircle = 0
      spread += 2 * spread div (circle + 1)
      spread = min(spread, count - i)
      angle += nextF64(random) * PI * 2.0'f64
    inc i
  c.strongholdChunks = chunks
  c.hasStrongholdChunks = true
  chunks

proc getAllowedBiomes*(s: StructureSet): seq[uint16] =
  ## `ProtoChunk::get_allowed_biomes`
  result = @[]
  for ei in 0 ..< s.structures.len:
    let structure = structures.get(s.structures[ei].structure)
    let name = if structure.biomes.len > 0 and structure.biomes[0] == '#': structure.biomes[1 .. ^1] else: structure.biomes
    let (found, ids) = getTagIds(rkWorldgenBiome, name)
    if found:
      for id in ids:
        result.add(id)

proc largeFeatureWithSalt(worldSeed: int64, x, z, blend: int32): uint64 =
  ## `get_large_feature_with_salt`
  cast[uint64](wrapAdd(wrapAdd(wrapAdd(worldSeed, wrapMul(int64(x), 341873128712'i64)), wrapMul(int64(z), 132897987541'i64)),
    int64(blend)))

proc shouldGenerateFrequency(meth: FrequencyReductionMethod, seed: int64, chunkX, chunkZ: int32, salt: uint32,
                             frequency: float32): bool =
  ## The newer tree's, as vanilla has it: every reducer is on the legacy generator. The pinned tree draws three of them
  ## from Xoroshiro, which places none of the save's 27 mineshafts. `Default` does pass the salt as x, as vanilla does.
  case meth
  of FrequencyReductionMethod.Default:
    var random = legacy_rand.fromSeed(largeFeatureWithSalt(seed, cast[int32](salt), chunkX, chunkZ))
    nextF32(random) < frequency
  of FrequencyReductionMethod.LegacyType1:
    let x = chunkX shr 4
    let z = chunkZ shr 4
    var random = legacy_rand.fromSeed(cast[uint64](int64(x xor (z shl 4)) xor seed))
    discard nextI32(random)
    nextBoundedI32(random, asI32(1.0'f32 / frequency)) == 0
  of FrequencyReductionMethod.LegacyType2:
    var random = legacy_rand.fromSeed(largeFeatureWithSalt(seed, chunkX, chunkZ, 10387320'i32))
    nextF32(random) < frequency
  of FrequencyReductionMethod.LegacyType3:
    var random = createChunkRandom(seed, chunkX, chunkZ)
    nextF64(random) < float64(frequency)

proc applyFrequencyReduction*(hasMethod: bool, meth: FrequencyReductionMethod, seed: int64, chunkX, chunkZ: int32,
                              salt: uint32, frequency: float32): bool =
  if frequency >= 1.0'f32:
    return true
  shouldGenerateFrequency(if hasMethod: meth else: FrequencyReductionMethod.Default, seed, chunkX, chunkZ, salt, frequency)

proc getStructureChunkInRegion*(placement: RandomSpreadStructurePlacement, seed: int64, rx, rz: int32, salt: uint32): (int32, int32) =
  ## `get_structure_chunk_in_region`: where a structure attempts to spawn in region (rx, rz).
  let regionSeed = getRegionSeed(cast[uint64](seed), rx, rz, salt)
  var random = toRandomGenerator(legacy_rand.fromSeed(regionSeed))
  let bound = placement.spacing - placement.separation
  let spreadType = if placement.hasSpreadType: placement.spreadType else: SpreadType.Linear
  let randX = get(spreadType, random, bound)
  let randZ = get(spreadType, random, bound)
  (rx * placement.spacing + randX, rz * placement.spacing + randZ)

proc getStartChunkRandomSpread*(placement: RandomSpreadStructurePlacement, seed: int64, chunkX, chunkZ: int32, salt: uint32): (int32, int32) =
  let rx = floorDiv(chunkX, placement.spacing)
  let rz = floorDiv(chunkZ, placement.spacing)
  getStructureChunkInRegion(placement, seed, rx, rz, salt)

proc isStartChunkRandomSpread(placement: RandomSpreadStructurePlacement, calculator: StructurePlacementCalculator,
                              chunkX, chunkZ: int32, salt: uint32): bool =
  let pos = getStartChunkRandomSpread(placement, calculator.seed, chunkX, chunkZ, salt)
  chunkX == pos[0] and chunkZ == pos[1]

proc isStartChunk*(placementType: StructurePlacementType, calculator: StructurePlacementCalculator, chunkX, chunkZ: int32,
                   salt: uint32, globalCache: GlobalStructureCache, biomeSupplier: ProtoChunk,
                   allowedBiomes: openArray[uint16]): bool =
  case placementType.kind
  of StructurePlacementKind.RandomSpread:
    isStartChunkRandomSpread(placementType.randomSpread, calculator, chunkX, chunkZ, salt)
  of StructurePlacementKind.ConcentricRings:
    let strongholds = getOrCalculateStrongholds(globalCache, calculator.seed, placementType.concentricRings,
      biomeSupplier, allowedBiomes)
    for i in 0 ..< strongholds.len:
      if strongholds[i][0] == chunkX and strongholds[i][1] == chunkZ:
        return true
    false

proc shouldGenerateStructure*(placement: StructurePlacement, calculator: StructurePlacementCalculator, chunkX, chunkZ: int32,
                              globalCache: GlobalStructureCache, biomeSupplier: ProtoChunk,
                              allowedBiomes: openArray[uint16]): bool =
  if not isStartChunk(placement.placementType, calculator, chunkX, chunkZ, placement.salt, globalCache, biomeSupplier,
      allowedBiomes):
    return false
  let frequency = if placement.hasFrequency: placement.frequency else: 1.0'f32
  if not applyFrequencyReduction(placement.hasFrequencyReductionMethod, placement.frequencyReductionMethod,
      calculator.seed, chunkX, chunkZ, placement.salt, frequency):
    return false
  if not placement.hasExclusionZone:
    return true
  let zone = placement.exclusionZone
  let setName = if zone.otherSet.len > 10 and zone.otherSet[0 .. 9] == "minecraft:": zone.otherSet[10 .. ^1] else: zone.otherSet
  let (found, other) = structureSetGet(setName)
  if not found:
    return true
  let otherBiomes = getAllowedBiomes(other)
  var x = chunkX - zone.chunkCount
  while x <= chunkX + zone.chunkCount:
    var z = chunkZ - zone.chunkCount
    while z <= chunkZ + zone.chunkCount:
      if shouldGenerateStructure(other.placement, calculator, x, z, globalCache, biomeSupplier, otherBiomes):
        return false
      inc z
    inc x
  true
