## Upstream's tests of placement.rs and of mod.rs's `large_feature_seed_matches_java_random`.
## Port of pumpkin-world/src/generation/structure/placement.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../../../generated/structures
import ../../../generated/dimension
import ../../../util/random/random
import ../../../util/legacy_rand

import ../generator/generator
import ../protochunkbase
import placement

block getStartChunkRandom:
  let regionSeed = getRegionSeed(123'u64, 1, 1, 14357620'u32)
  var random = toRandomGenerator(legacy_rand.fromSeed(regionSeed))
  assert nextBoundedI32(random, 24) == 8

block getStartChunk:
  let spread = RandomSpreadStructurePlacement(spacing: 32, separation: 8, hasSpreadType: false)
  let (x, z) = getStartChunkRandomSpread(spread, 123'i64, 1, 1, 14357620'u32)
  assert x == 5
  assert z == 4

block pillagerOutpostsRespectTheVillageExclusionZone:
  let seed = 0'i64
  let calculator = newStructurePlacementCalculator(seed)
  let cache = newGlobalStructureCache()
  let generator = getWorldGen(cast[uint64](seed), OVERWORLD, false, @[], "")
  let chunk = newProtoChunkRaw(0, 0, 0'u32, 0'i64, 384, -64)
  let outposts = STRUCTURE_SET_PILLAGER_OUTPOSTS
  let villages = STRUCTURE_SET_VILLAGES
  let excludedX = -1002'i32
  let excludedZ = -595'i32
  let none = newSeq[uint16](0)
  assert isStartChunk(outposts.placement.placementType, calculator, excludedX, excludedZ, outposts.placement.salt, cache, chunk, none)
  assert applyFrequencyReduction(outposts.placement.hasFrequencyReductionMethod, outposts.placement.frequencyReductionMethod,
    seed, excludedX, excludedZ, outposts.placement.salt, outposts.placement.frequency)
  var anyVillage = false
  var dx = -10'i32
  while dx <= 10:
    var dz = -10'i32
    while dz <= 10:
      if isStartChunk(villages.placement.placementType, calculator, excludedX + dx, excludedZ + dz, villages.placement.salt, cache, chunk, none):
        anyVillage = true
      inc dz
    inc dx
  assert anyVillage
  assert not shouldGenerateStructure(outposts.placement, calculator, excludedX, excludedZ, cache, chunk, none)

echo "placement: ok"
