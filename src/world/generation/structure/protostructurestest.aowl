## Starts, references, noise and piece placement for one chunk, on upstream's generation.rs reference chunks, without placed
## features and without `GenerationCache`: chunk_system/generationstructuretest.aowl is upstream's whole form of these. Also
## `step_to_noise`'s beard input. Run from the repo root.
## Port of pumpkin-world/src/chunk_system/generation.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import std/tables
import ../../blockstates
import ../../world
import ../../../generated/dimension
import ../../../generated/structures
import ../../../util/vector3
import ../../../util/random/random
import ../../../util/worldgen_random as worldgen_random
import ../proto_chunk
import ../generation
import ../positions
import ../structurehooks
import structures/structuresmod

proc blockId(name: string): int =
  let (found, id) = blockIdByName(name)
  assert found, name
  id

proc built(seed: uint64, cx, cz: int32, wantKey: StructureKeys): ProtoChunk =
  ## Up to carvers, then each of the chunk's structures in step order, as `generate_structure_step` does for the centre chunk.
  let gen = getWorldGen(seed, OVERWORLD, false, @[], "")
  let c = newProtoChunk(cx, cz, gen)
  stepToBiomes(c, gen.noise)
  setStructureStarts(c, gen.noise)
  setStructureReferences(c, gen.noise)
  assert c.structureStarts.hasKey(wantKey), toName(wantKey)
  stepToNoise(c, gen.noise)
  stepToSurface(c, gen.noise)
  stepToCarvers(c, gen.noise)
  let portal = noOpWorldPortal()
  let populationSeed = worldgen_random.getPopulationSeed(seed, startBlockX(cx), startBlockZ(cz))
  for stepIndex in 0 ..< 11:
    var random = toRandomGenerator(worldgen_random.fromSeed(worldgen_random.getDecoratorSeed(populationSeed, 0'u64, uint64(stepIndex))))
    for id, instance in pairs(c.structureStarts):
      if ordinal(structures.get(id).step) == stepIndex:
        generateInChunk(instanceData(instance).collector, c, portal, random, cast[int64](seed))
  c

proc countIn(chunk: ProtoChunk, x0, x1, z0, z1: int32, wanted: openArray[int]): (int, int) =
  let jigsaw = blockId("jigsaw")
  var count = 0
  var jigsaws = 0
  for x in x0 ..< x1:
    for z in z0 ..< z1:
      for y in -64'i32 ..< 320'i32:
        let id = blockIdOf(getBlockState(chunk, vec3[int32](x, y, z)))
        for w in wanted:
          if id == w:
            inc count
        if id == jigsaw:
          inc jigsaws
  (count, jigsaws)

block configuredSeedHasTheAncientCityChunk:
  let chunk = built(1782124772053846960'u64, 31, -12, StructureKeys.AncientCity)
  let (cityBlocks, jigsawBlocks) = countIn(chunk, 496, 512, -192, -176,
    [blockId("deepslate_bricks"), blockId("polished_deepslate"), blockId("reinforced_deepslate"), blockId("sculk")])
  assert cityBlocks > 0, "reference chunk contains no Ancient City blocks"
  assert jigsawBlocks == 0, "jigsaw blocks were not replaced"
  echo "ancient city: ", cityBlocks, " blocks"

block seedZeroHasTheOutpostChunk:
  let chunk = built(0'u64, 35, 103, StructureKeys.PillagerOutpost)
  let (outpostBlocks, jigsawBlocks) = countIn(chunk, 560, 576, 1648, 1664,
    [blockId("dark_oak_log"), blockId("dark_oak_planks"), blockId("dark_oak_fence")])
  assert outpostBlocks > 0, "reference chunk contains no outpost blocks"
  assert jigsawBlocks == 0, "jigsaw blocks were not replaced"
  echo "outpost: ", outpostBlocks, " blocks"

block beardifierPiecesOfAJigsawStart:
  let gen = getWorldGen(1782124772053846960'u64, OVERWORLD, false, @[], "")
  let c = newProtoChunk(31, -12, gen)
  stepToBiomes(c, gen.noise)
  setStructureStarts(c, gen.noise)
  setStructureReferences(c, gen.noise)
  let instance = c.structureStarts.getOrDefault(StructureKeys.AncientCity, nil)
  assert instance != nil
  let pieces = structureHooks.beardifierPieces(StructureKeys.AncientCity, instance)
  assert pieces.len > 10
  var anyJunction = false
  for i in 0 ..< pieces.len:
    assert pieces[i].isJigsaw
    if pieces[i].junctions.len > 0:
      anyJunction = true
  assert anyJunction

echo "protostructures: ok"
