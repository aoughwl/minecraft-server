## Port of pumpkin-world/src/generation/structure/shiftable_piece.rs
##
## Upstream's struct is composed into a piece; here a piece derives from this.

{.feature: "lenientnils".}

import structures/structuresmod

const DefaultHPos* = -1'i32

type
  ShiftableStructurePiece* = ref object of StructurePieceBase
    hPos*: int32
    width*, height*: int32

proc initShiftable*(p: ShiftableStructurePiece, structureType: StructurePieceType, x, y, z, width, height, depth: int32,
                    axis: Axis) =
  ## `ShiftableStructurePiece::new`
  p.piece = newStructurePiece(structureType, createBox(BlockBox, x, y, z, axis, width, height, depth), 0)
  p.hPos = DefaultHPos
  p.width = width
  p.height = height

proc adjustToAverageHeight*(p: ShiftableStructurePiece, chunk: ProtoChunk): bool =
  let boundingBox = p.piece.boundingBox
  if p.hPos >= 0:
    return true
  var sumY = 0'i32
  var count = 0'i32
  var z = boundingBox.min.z
  while z <= boundingBox.max.z:
    var x = boundingBox.min.x
    while x <= boundingBox.max.x:
      sumY += getTopY(chunk, OceanFloorWg, x, z)
      inc count
      inc x
    inc z
  if count == 0:
    return false
  p.hPos = sumY div count
  let offset = p.hPos - boundingBox.min.y
  p.piece.boundingBox.min.y += offset
  p.piece.boundingBox.max.y += offset
  true

proc adjustToMinHeight*(p: ShiftableStructurePiece, chunk: ProtoChunk, yOffset: int32): bool =
  let boundingBox = p.piece.boundingBox
  if p.hPos >= 0:
    return true
  var minY = int32.high
  var foundAny = false
  var z = boundingBox.min.z
  while z <= boundingBox.max.z:
    var x = boundingBox.min.x
    while x <= boundingBox.max.x:
      let y = getTopY(chunk, OceanFloorWg, x, z)
      if y < minY:
        minY = y
      foundAny = true
      inc x
    inc z
  if not foundAny:
    return false
  p.hPos = minY
  let shiftY = (p.hPos - boundingBox.min.y) + yOffset
  p.piece.boundingBox.min.y += shiftY
  p.piece.boundingBox.max.y += shiftY
  true
