import ../../../generated/structures
import ../../../generated/tag
import ../generation
import ../noise/multi_noise_sampler
import ../blender/blender
import structures/structuresmod
import structures/buried_treasure
import structures/desert_pyramid
import structures/end_city
import structures/igloo
import structures/jigsaw_placement
import structures/jungle_temple
import structures/mansion/mansion
import structures/mineshaft
import structures/nether_fortress/nether_fortress
import structures/nether_fossil
import structures/ocean_monument
import structures/ocean_ruin
import structures/ruined_portal
import structures/shipwreck
import structures/stronghold/stronghold
import structures/swamp_hut

export structuresmod, jigsaw_placement

proc generateStructurePosition*(key: StructureKeys, structure: Structure, context: var StructureGeneratorContext): StructurePosition =
  ## `generate_structure_position`: no biome validation, which callers add.
  case key
  of StructureKeys.BuriedTreasure: buriedTreasurePosition(context)
  of StructureKeys.SwampHut: swampHutPosition(context)
  of StructureKeys.Stronghold: strongholdPosition(context)
  of StructureKeys.Fortress: netherFortressPosition(context)
  of StructureKeys.NetherFossil: netherFossilPosition(context)
  of StructureKeys.Igloo: iglooPosition(context)
  of StructureKeys.DesertPyramid: desertPyramidPosition(context)
  of StructureKeys.JunglePyramid: jungleTemplePosition(context)
  of StructureKeys.VillagePlains, StructureKeys.VillageDesert, StructureKeys.VillageSavanna, StructureKeys.VillageSnowy,
      StructureKeys.VillageTaiga, StructureKeys.AncientCity, StructureKeys.BastionRemnant, StructureKeys.PillagerOutpost,
      StructureKeys.TrailRuins, StructureKeys.TrialChambers:
    getStructurePosition(newJigsawGenerator(structure.startPool, structure.size), context)
  of StructureKeys.Shipwreck, StructureKeys.ShipwreckBeached:
    shipwreckPosition(context, key == StructureKeys.ShipwreckBeached)
  of StructureKeys.RuinedPortal, StructureKeys.RuinedPortalDesert, StructureKeys.RuinedPortalJungle,
      StructureKeys.RuinedPortalSwamp, StructureKeys.RuinedPortalMountain, StructureKeys.RuinedPortalOcean,
      StructureKeys.RuinedPortalNether:
    ruinedPortalPosition(context, key)
  of StructureKeys.OceanRuinCold, StructureKeys.OceanRuinWarm:
    oceanRuinPosition(context, key == StructureKeys.OceanRuinWarm)
  of StructureKeys.EndCity: endCityPosition(context)
  of StructureKeys.Mansion: mansionPosition(context)
  of StructureKeys.Monument: oceanMonumentPosition(context)
  of StructureKeys.Mineshaft, StructureKeys.MineshaftMesa:
    mineshaftPosition(context, key == StructureKeys.MineshaftMesa)

proc biomeAllowed(structure: Structure, biomeId: uint16): bool =
  let name = if structure.biomes.len > 0 and structure.biomes[0] == '#': structure.biomes[1 .. ^1] else: structure.biomes
  let (found, ids) = getTagIds(rkWorldgenBiome, name)
  if found:
    for i in 0 ..< ids.len:
      if ids[i] == biomeId:
        return true
  false

proc tryGenerateStructure*(key: StructureKeys, structure: Structure, seed: int64, chunk: ProtoChunk, seaLevel: int32,
                           heightSampler: HeightSampler): StructurePosition =
  ## `try_generate_structure`
  var context = newContext(seed, chunk.x, chunk.z, seaLevel, int32(bottomY(chunk)), heightSampler, key, int32(height(chunk)))
  let pos = generateStructurePosition(key, structure, context)
  if pos == nil:
    return nil
  # Clamp biome Y to the chunk's valid range: a start's y may exceed the chunk's logical height.
  let biomeY = biomeFromBlock(pos.startPos.y)
  let biomeHeight = int32(height(chunk) shr 2)
  let biomeBottom = biomeFromBlock(int32(bottomY(chunk)))
  let clampedBiomeY = max(biomeBottom, min(biomeY, biomeBottom + biomeHeight - 1))
  let currentBiome = uint16(getBiomeId(chunk, biomeFromBlock(pos.startPos.x), clampedBiomeY, biomeFromBlock(pos.startPos.z)))
  if biomeAllowed(structure, currentBiome): pos else: nil

proc lazilyGenerateStructure*(key: StructureKeys, structure: Structure, context: var StructureGeneratorContext,
                              biomeSupplier: BlenderBiomeSupplier, multiNoiseSampler: MultiNoiseSampler): StructurePosition =
  ## `lazily_generate_structure`
  if key == StructureKeys.Monument:
    let startY =
      if context.heightSampler == nil: context.seaLevel
      else: estimateOceanFloorHeight(context.heightSampler, getCenterX(context.chunkX), getCenterZ(context.chunkZ))
    if not hasValidBiomes(biomeSupplier, multiNoiseSampler, context.chunkX, context.chunkZ, context.seaLevel, startY):
      return nil
  let pos = generateStructurePosition(key, structure, context)
  if pos == nil:
    return nil
  let b = biome(biomeSupplier, biomeFromBlock(pos.startPos.x), biomeFromBlock(pos.startPos.y), biomeFromBlock(pos.startPos.z),
    multiNoiseSampler)
  if biomeAllowed(structure, uint16(b.id)): pos else: nil
