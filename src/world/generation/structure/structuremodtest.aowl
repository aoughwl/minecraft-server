## Every structure kind built and placed: mod.rs's dispatch, and each piece's `place`, whose block names are only looked up
## when it runs. Upstream has no test of these; the known answers are in mansiontest, jigsawtest and placementtest.
## Port of pumpkin-world/src/generation/structure/mod.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../../../generated/structures
import ../../../generated/tag
import structuremod

type
  FixedHeightSampler = ref object of HeightSampler
    height: int32

proc fixedEstimate(self: HeightSampler, blockX, blockZ: int32): int32 {.nimcall.} =
  cast[FixedHeightSampler](self).height

let sampler = FixedHeightSampler(estimateFn: fixedEstimate, height: 72)

proc floorDivChunk(v: int32): int32 = v shr 4

proc placeAround(position: StructurePosition, seed: int64) =
  ## Places every piece once in the chunk holding its corner, as `generate_in_chunk` would.
  let portal = noOpWorldPortal()
  var random = createChunkRandom(seed, 0, 0)
  var placed = 0
  for i in 0 ..< position.collector.pieces.len:
    if placed >= 40:
      break
    let bb = position.collector.pieces[i].piece.boundingBox
    let chunk = newProtoChunkRaw(floorDivChunk(bb.min.x), floorDivChunk(bb.min.z), 1'u32, 0'i64, 384, -64)
    let single = newStructurePiecesCollector()
    addPiece(single, position.collector.pieces[i])
    generateInChunk(single, chunk, portal, random, seed)
    inc placed

block everyKindBuildsAndPlaces:
  var built = 0
  for keyIndex in ord(low(StructureKeys)) .. ord(high(StructureKeys)):
    let key = StructureKeys(keyIndex)
    let structure = structures.get(key)
    for seed in [0'i64, 12345'i64, -7436126469594556380'i64]:
      var context = newContext(seed, 3, -2, 63, -64, sampler, key)
      let position = generateStructurePosition(key, structure, context)
      if position != nil:
        assert position.collector.pieces.len > 0, toName(key)
        discard getBoundingBox(position)
        placeAround(position, seed)
        inc built
  # A jigsaw can fail on a fixed height; not all of them, and nothing else can.
  assert built >= 90, $built

block biomeTagsExistForEveryStructure:
  for keyIndex in ord(low(StructureKeys)) .. ord(high(StructureKeys)):
    let structure = structures.get(StructureKeys(keyIndex))
    let name = if structure.biomes.len > 0 and structure.biomes[0] == '#': structure.biomes[1 .. ^1] else: structure.biomes
    assert getTagIds(rkWorldgenBiome, name)[0], name

block strongholdHasAPortalRoomAndNoOverlaps:
  for seed in [1'i64, 2'i64, 3'i64]:
    var context = newContext(seed, 100, 40, 63, -64, nil, StructureKeys.Stronghold)
    let position = generateStructurePosition(StructureKeys.Stronghold, structures.get(StructureKeys.Stronghold), context)
    assert position != nil
    var portalRooms = 0
    let pieces = position.collector.pieces
    for i in 0 ..< pieces.len:
      if pieces[i].piece.structureType == StructurePieceType.StrongholdPortalRoom:
        inc portalRooms
      for j in i + 1 ..< pieces.len:
        # A small corridor is cut to run one block into what it meets, on purpose.
        if pieces[i].piece.structureType != StructurePieceType.StrongholdSmallCorridor and
            pieces[j].piece.structureType != StructurePieceType.StrongholdSmallCorridor:
          assert not intersects(pieces[i].piece.boundingBox, pieces[j].piece.boundingBox), "stronghold pieces overlap"
    assert portalRooms == 1, $portalRooms
    assert pieces.len > 10, $pieces.len

block fortressPiecesStayInBoundsAndApart:
  for seed in [1'i64, 2'i64, 3'i64]:
    var context = newContext(seed, 10, -40, 32, 0, nil, StructureKeys.Fortress)
    let position = generateStructurePosition(StructureKeys.Fortress, structures.get(StructureKeys.Fortress), context)
    assert position != nil
    assert position.startPos.y == 64
    let pieces = position.collector.pieces
    assert pieces.len > 10, $pieces.len
    for i in 0 ..< pieces.len:
      for j in i + 1 ..< pieces.len:
        assert not intersects(pieces[i].piece.boundingBox, pieces[j].piece.boundingBox), "fortress pieces overlap"

block mansionNeedsASampler:
  var context = newContext(0'i64, 1, 1, 63, -64, nil, StructureKeys.Mansion)
  assert generateStructurePosition(StructureKeys.Mansion, structures.get(StructureKeys.Mansion), context) == nil

echo "structuremod: ok"
