## Port of pumpkin-world/src/generation/structure/structures/buried_treasure.rs

{.feature: "lenientnils".}

import ../../../../util/legacy_rand
import structuresmod

let
  SandstoneBlock = blockIdNamed("sandstone")
  StoneBlock = blockIdNamed("stone")
  AndesiteBlock = blockIdNamed("andesite")
  GraniteBlock = blockIdNamed("granite")
  DioriteBlock = blockIdNamed("diorite")
  WaterBlockId = blockIdNamed("water")
  LavaBlockId = blockIdNamed("lava")
  SandState = blockState("sand")

proc isLiquidId(id: int): bool =
  id == WaterBlockId or id == LavaBlockId

proc placeBuriedTreasure(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                         random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let boundingbox = self.piece.boundingBox
  let y = getTopY(chunk, OceanFloorWg, boundingbox.min.x, boundingbox.min.z)
  var posX = boundingbox.min.x
  var posY = y
  let posZ = boundingbox.min.z
  let bottom = int32(bottomY(chunk))
  var remaining = y
  while remaining >= bottom:
    let state = getBlockState(chunk, vec3[int32](posX, posY, posZ))
    let downRawState = getBlockState(chunk, vec3[int32](posX, posY - 1, posZ))
    let downBlock = blockIdOf(downRawState)
    if downBlock == SandstoneBlock or downBlock == StoneBlock or downBlock == AndesiteBlock or downBlock == GraniteBlock or
        downBlock == DioriteBlock:
      for dirIndex in 0 .. 5:
        # `BlockDirection::all()`: Down, Up, North, South, West, East.
        let dir = BlockDirection(dirIndex)
        let off = toVector(dir)
        let ox = posX + off.x
        let oy = posY + off.y
        let oz = posZ + off.z
        let dirState = getBlockState(chunk, vec3[int32](ox, oy, oz))
        if not isAir(dirState) and not isLiquidId(blockIdOf(dirState)):
          continue
        let downOffsetState = getBlockState(chunk, vec3[int32](ox, oy - 1, oz))
        if (isAir(downOffsetState) or isLiquidId(blockIdOf(downOffsetState))) and dir != Up:
          setBlockState(chunk, ox, oy, oz, downRawState)
          continue
        let state1 = if isAir(state) or isLiquidId(blockIdOf(state)): SandState else: state
        setBlockState(chunk, ox, oy, oz, state1)
      setBlockState(chunk, posX, posY, posZ, ChestStateId)
      var chestNbt = newCompound()
      putString(chestNbt, "id", "minecraft:chest")
      putInt(chestNbt, "x", posX)
      putInt(chestNbt, "y", posY)
      putInt(chestNbt, "z", posZ)
      putString(chestNbt, "LootTable", "minecraft:chests/buried_treasure")
      var r = legacy_rand.fromSeed(cast[uint64](hashBlockPos(posX, posY, posZ)))
      putLong(chestNbt, "LootTableSeed", nextI64(r))
      addBlockEntity(chunk, chestNbt)
      return
    dec posY
    dec remaining

proc buriedTreasurePosition*(context: var StructureGeneratorContext): StructurePosition =
  let x = getCenterX(context.chunkX)
  let z = getCenterZ(context.chunkZ)
  let piece = StructurePieceBase(piece: newStructurePiece(StructurePieceType.BuriedTreasure,
    newBlockBox(x, -64, z, x, 320, z), 0), placeFn: placeBuriedTreasure)
  singlePiecePosition(piece, x, 90, z)
