## Port of the newer checkout's crates/pumpkin-world/src/generation/structure/structures/mod.rs `StructurePiece::reorient`.
## Its own module: the property enums and block properties clash with names structuresmod uses.

import ../../../blockstates
from ../../../../generated/block_enums import HorizontalFacing, toValue
from ../../../../generated/block_properties import ChestLikeProperties, blockChest, blockIdChest, fromStateId, toStateId,
  newBlockStateIdOrAir
from ../../../../data/block_state import nil
import ../../../../util/vector3
import ../../protochunkbase

const ChestBlockIdInt* = int(blockIdChest)

proc offset(f: HorizontalFacing): Vector3[int32] =
  case f
  of HorizontalFacing.North: vec3[int32](0'i32, 0'i32, -1'i32)
  of HorizontalFacing.South: vec3[int32](0'i32, 0'i32, 1'i32)
  of HorizontalFacing.West: vec3[int32](-1'i32, 0'i32, 0'i32)
  of HorizontalFacing.East: vec3[int32](1'i32, 0'i32, 0'i32)
proc opposite(f: HorizontalFacing): HorizontalFacing =
  case f
  of HorizontalFacing.North: HorizontalFacing.South
  of HorizontalFacing.South: HorizontalFacing.North
  of HorizontalFacing.West: HorizontalFacing.East
  of HorizontalFacing.East: HorizontalFacing.West
proc clockwise(f: HorizontalFacing): HorizontalFacing =
  case f
  of HorizontalFacing.North: HorizontalFacing.East
  of HorizontalFacing.East: HorizontalFacing.South
  of HorizontalFacing.South: HorizontalFacing.West
  of HorizontalFacing.West: HorizontalFacing.North
proc solidAt(chunk: ProtoChunk, pos: Vector3[int32], f: HorizontalFacing): bool =
  let o = offset(f)
  isSolidRender(getBlockState(chunk, vec3[int32](pos.x + o.x, pos.y + o.y, pos.z + o.z)))

proc reorientChest*(pos: Vector3[int32], chestState: BlockStateId, chunk: ProtoChunk): BlockStateId =
  ## `StructurePiece::reorient`, vanilla's `StructurePiece.reorient` for a chest: faces away from a lone solid
  ## neighbour, else keeps the default facing and turns off any solid-render wall in front of it.
  var solidNeighbor = HorizontalFacing.North
  var hasSolid = false
  let horizontal = [HorizontalFacing.North, HorizontalFacing.South, HorizontalFacing.West, HorizontalFacing.East]
  for direction in horizontal:
    let o = offset(direction)
    let state = getBlockState(chunk, vec3[int32](pos.x + o.x, pos.y + o.y, pos.z + o.z))
    if blockIdOf(state) == int(blockIdChest):
      return chestState
    if isSolidRender(state):
      if hasSolid:
        hasSolid = false
        break
      solidNeighbor = direction
      hasSolid = true
  var props = ChestLikeProperties.fromStateId(newBlockStateIdOrAir(uint16(chestState)), blockChest())
  if hasSolid:
    props.facing = opposite(solidNeighbor)
    return uint32(block_state.asU16(props.toStateId(blockChest())))
  var lockDir = props.facing
  if solidAt(chunk, pos, lockDir):
    lockDir = opposite(lockDir)
  if solidAt(chunk, pos, lockDir):
    lockDir = clockwise(lockDir)
  if solidAt(chunk, pos, lockDir):
    lockDir = opposite(lockDir)
  props.facing = lockDir
  uint32(block_state.asU16(props.toStateId(blockChest())))

proc chestFacingName*(state: BlockStateId): string =
  ## The facing a chest state holds, as its property value (`north`, `east`...), for tests.
  ChestLikeProperties.fromStateId(newBlockStateIdOrAir(uint16(state)), blockChest()).facing.toValue()
