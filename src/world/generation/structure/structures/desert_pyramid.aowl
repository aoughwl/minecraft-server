## Port of pumpkin-world/src/generation/structure/structures/desert_pyramid.rs

{.feature: "lenientnils".}

import ../../../../util/legacy_rand
import ../../../../util/xoroshiro128
import structuresmod

const
  Width = 21'i32
  Height = 15'i32
  Depth = 21'i32

type
  DesertPyramidPiece = ref object of StructurePieceBase
    heightAdjusted: bool
    hasPlacedChest: array[4, bool]

iterator stepRange(a, b, step: int32): int32 =
  var i = a
  while i <= b:
    yield i
    i += step

proc sandstoneStairs(facing: string): BlockStateId =
  stateWith("sandstone_stairs", [("facing", facing)])

proc adjustHeight(s: DesertPyramidPiece, chunk: ProtoChunk, random: var RandomGenerator): bool =
  if s.heightAdjusted:
    return true
  let groundOffset = -nextBoundedI32(random, 3)
  let bb = s.piece.boundingBox
  var lowest = int32.high
  var z = bb.min.z
  while z <= bb.max.z:
    var x = bb.min.x
    while x <= bb.max.x:
      lowest = min(lowest, getTopY(chunk, MotionBlockingNoLeaves, x, z))
      inc x
    inc z
  if lowest == int32.high:
    return false
  let shiftY = lowest - s.piece.boundingBox.min.y + groundOffset
  movePos(s.piece.boundingBox, 0, shiftY, 0)
  s.heightAdjusted = true
  true

proc placeSand(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, x, y, z: int32) =
  addBlock(s.piece, chunk, blockState("sand"), x, y, z, bb)

proc placeSandBox(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, x0, y0, z0, x1, y1, z1: int32) =
  for y in y0 .. y1:
    for x in x0 .. x1:
      for z in z0 .. z1:
        placeSand(s, chunk, bb, x, y, z)

proc placeCollapsedRoofPiece(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, random: var RandomGenerator, x, y, z: int32) =
  let state = if nextF32(random) < 0.33'f32: blockState("sandstone") else: blockState("sand")
  addBlock(s.piece, chunk, state, x, y, z, bb)

proc placeCollapsedRoof(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, random: var RandomGenerator, x0, y0, z0, x1, z1: int32) =
  for x in x0 .. x1:
    for z in z0 .. z1:
      placeCollapsedRoofPiece(s, chunk, bb, random, x, y0, z)

proc tryPlaceChest(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, index: int, x, y, z: int32) =
  if s.hasPlacedChest[index]:
    return
  let worldPos = offsetPos(s.piece, x, y, z)
  if not containsPos(bb, worldPos):
    return
  addBlock(s.piece, chunk, ChestStateId, x, y, z, bb)
  var nbt = newCompound()
  putInt(nbt, "x", worldPos.x)
  putInt(nbt, "y", worldPos.y)
  putInt(nbt, "z", worldPos.z)
  putString(nbt, "id", "minecraft:chest")
  putString(nbt, "LootTable", "minecraft:chests/desert_pyramid")
  var r = legacy_rand.fromSeed(cast[uint64](hashBlockPos(worldPos.x, worldPos.y, worldPos.z)))
  putLong(nbt, "LootTableSeed", nextI64(r))
  addBlockEntity(chunk, nbt)
  s.hasPlacedChest[index] = true

proc addCellarStairs(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, random: var RandomGenerator) =
  let p = s.piece
  let westStairs = sandstoneStairs("west")
  addBlock(p, chunk, westStairs, 13, -1, 17, bb)
  addBlock(p, chunk, westStairs, 14, -2, 17, bb)
  addBlock(p, chunk, westStairs, 15, -3, 17, bb)
  let sand = blockState("sand")
  let sandstone = blockState("sandstone")
  let x = 16'i32
  let y = -4'i32
  let z = 13'i32
  let variant = nextBool(random)
  addBlock(p, chunk, sand, x - 4, y + 4, z + 4, bb)
  addBlock(p, chunk, sand, x - 3, y + 4, z + 4, bb)
  addBlock(p, chunk, sand, x - 2, y + 4, z + 4, bb)
  addBlock(p, chunk, sand, x - 1, y + 4, z + 4, bb)
  addBlock(p, chunk, sand, x, y + 4, z + 4, bb)
  addBlock(p, chunk, sand, x - 2, y + 3, z + 4, bb)
  addBlock(p, chunk, (if variant: sand else: sandstone), x - 1, y + 3, z + 4, bb)
  addBlock(p, chunk, (if variant: sandstone else: sand), x, y + 3, z + 4, bb)
  addBlock(p, chunk, sand, x - 1, y + 2, z + 4, bb)
  addBlock(p, chunk, sandstone, x, y + 2, z + 4, bb)
  addBlock(p, chunk, sand, x, y + 1, z + 4, bb)

proc addCellarRoom(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, random: var RandomGenerator) =
  let p = s.piece
  let x = 16'i32
  let y = -4'i32
  let z = 13'i32
  let cut = blockState("cut_sandstone")
  let chiseled = blockState("chiseled_sandstone")
  let orange = blockState("orange_terracotta")
  let blue = blockState("blue_terracotta")
  fillWithOutline(p, chunk, bb, true, x - 3, y + 1, z - 3, x - 3, y + 1, z + 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x + 3, y + 1, z - 3, x + 3, y + 1, z + 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x - 3, y + 1, z - 3, x + 3, y + 1, z - 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x - 3, y + 1, z + 3, x + 3, y + 1, z + 3, cut, cut)
  fillWithOutline(p, chunk, bb, true, x - 3, y + 2, z - 3, x - 3, y + 2, z + 2, chiseled, chiseled)
  fillWithOutline(p, chunk, bb, true, x + 3, y + 2, z - 3, x + 3, y + 2, z + 2, chiseled, chiseled)
  fillWithOutline(p, chunk, bb, true, x - 3, y + 2, z - 3, x + 3, y + 2, z - 2, chiseled, chiseled)
  fillWithOutline(p, chunk, bb, true, x - 3, y + 2, z + 3, x + 3, y + 2, z + 3, chiseled, chiseled)
  fillWithOutline(p, chunk, bb, true, x - 3, -1, z - 3, x - 3, -1, z + 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x + 3, -1, z - 3, x + 3, -1, z + 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x - 3, -1, z - 3, x + 3, -1, z - 2, cut, cut)
  fillWithOutline(p, chunk, bb, true, x - 3, -1, z + 3, x + 3, -1, z + 3, cut, cut)
  placeSandBox(s, chunk, bb, x - 2, y + 1, z - 2, x + 2, y + 3, z + 2)
  placeCollapsedRoof(s, chunk, bb, random, x - 2, y + 4, z - 2, x + 2, z + 2)
  addBlock(p, chunk, blue, x, y, z, bb)
  addBlock(p, chunk, orange, x + 1, y, z - 1, bb)
  addBlock(p, chunk, orange, x + 1, y, z + 1, bb)
  addBlock(p, chunk, orange, x - 1, y, z - 1, bb)
  addBlock(p, chunk, orange, x - 1, y, z + 1, bb)
  addBlock(p, chunk, orange, x + 2, y, z, bb)
  addBlock(p, chunk, orange, x - 2, y, z, bb)
  addBlock(p, chunk, orange, x, y, z + 2, bb)
  addBlock(p, chunk, orange, x, y, z - 2, bb)
  addBlock(p, chunk, orange, x + 3, y, z, bb)
  placeSand(s, chunk, bb, x + 3, y + 1, z)
  placeSand(s, chunk, bb, x + 3, y + 2, z)
  addBlock(p, chunk, cut, x + 4, y + 1, z, bb)
  addBlock(p, chunk, chiseled, x + 4, y + 2, z, bb)
  addBlock(p, chunk, orange, x - 3, y, z, bb)
  placeSand(s, chunk, bb, x - 3, y + 1, z)
  placeSand(s, chunk, bb, x - 3, y + 2, z)
  addBlock(p, chunk, cut, x - 4, y + 1, z, bb)
  addBlock(p, chunk, chiseled, x - 4, y + 2, z, bb)
  addBlock(p, chunk, orange, x, y, z + 3, bb)
  placeSand(s, chunk, bb, x, y + 1, z + 3)
  placeSand(s, chunk, bb, x, y + 2, z + 3)
  addBlock(p, chunk, orange, x, y, z - 3, bb)
  placeSand(s, chunk, bb, x, y + 1, z - 3)
  placeSand(s, chunk, bb, x, y + 2, z - 3)
  addBlock(p, chunk, cut, x, y + 1, z - 4, bb)
  addBlock(p, chunk, chiseled, x, -2, z - 4, bb)

proc addCellar(s: DesertPyramidPiece, chunk: ProtoChunk, bb: BlockBox, random: var RandomGenerator) =
  addCellarStairs(s, chunk, bb, random)
  addCellarRoom(s, chunk, bb, random)

proc placeDesertPyramid(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[DesertPyramidPiece](self)
  if not adjustHeight(s, chunk, random):
    return
  let origin = s.piece.boundingBox.min
  var seeded = toRandomGenerator(xoroshiro128.fromSeed(cast[uint64](seed)))
  let splitter = nextSplitter(seeded)
  var levelRandom = splitPos(splitter, origin.x, origin.y, origin.z)
  let p = s.piece
  let bb = chunkBox
  if not adjustHeight(s, chunk, random):
    return
  let ss = blockState("sandstone")
  let air = blockState("air")
  let cut = blockState("cut_sandstone")
  let chiseled = blockState("chiseled_sandstone")
  let orange = blockState("orange_terracotta")
  let blue = blockState("blue_terracotta")
  let slab = blockState("sandstone_slab")
  let northStairs = sandstoneStairs("north")
  let southStairs = sandstoneStairs("south")
  let eastStairs = sandstoneStairs("east")
  let westStairs = sandstoneStairs("west")
  s.piece .fillWithOutline(chunk, bb, false, 0, -4, 0, Width - 1, 0, Depth - 1, ss, ss)
  for pos in int32(1) .. int32(9):
    fillWithOutline(p, chunk, bb, false, pos, pos, pos, Width - 1 - pos, pos, Depth - 1 - pos, ss, ss)
    fillWithOutline(p, chunk, bb, false, pos + 1, pos, pos + 1, Width - 2 - pos, pos, Depth - 2 - pos, air, air)
  for x in int32(0) ..< int32(Width):
    for z in int32(0) ..< int32(Depth):
      fillDownwards(p, chunk, ss, x, -5, z, bb)
  s.piece .fillWithOutline(chunk, bb, false, 0, 0, 0, 4, 9, 4, ss, air)
  s.piece .fillWithOutline(chunk, bb, false, 1, 10, 1, 3, 10, 3, ss, ss)
  addBlock(p, chunk, northStairs, 2, 10, 0, bb)
  addBlock(p, chunk, southStairs, 2, 10, 4, bb)
  addBlock(p, chunk, eastStairs, 0, 10, 2, bb)
  addBlock(p, chunk, westStairs, 4, 10, 2, bb)
  s.piece .fillWithOutline(chunk, bb, false, Width - 5, 0, 0, Width - 1, 9, 4, ss, air)
  s.piece .fillWithOutline(chunk, bb, false, Width - 4, 10, 1, Width - 2, 10, 3, ss, ss)
  s.piece .addBlock(chunk, northStairs, Width - 3, 10, 0, bb)
  s.piece .addBlock(chunk, southStairs, Width - 3, 10, 4, bb)
  s.piece .addBlock(chunk, eastStairs, Width - 5, 10, 2, bb)
  s.piece .addBlock(chunk, westStairs, Width - 1, 10, 2, bb)
  s.piece .fillWithOutline(chunk, bb, false, 8, 0, 0, 12, 4, 4, ss, air)
  s.piece .fillWithOutline(chunk, bb, false, 9, 1, 0, 11, 3, 4, air, air)
  addBlock(p, chunk, cut, 9, 1, 1, bb)
  addBlock(p, chunk, cut, 9, 2, 1, bb)
  addBlock(p, chunk, cut, 9, 3, 1, bb)
  addBlock(p, chunk, cut, 10, 3, 1, bb)
  addBlock(p, chunk, cut, 11, 3, 1, bb)
  addBlock(p, chunk, cut, 11, 2, 1, bb)
  addBlock(p, chunk, cut, 11, 1, 1, bb)
  s.piece .fillWithOutline(chunk, bb, false, 4, 1, 1, 8, 3, 3, ss, air)
  s.piece .fillWithOutline(chunk, bb, false, 4, 1, 2, 8, 2, 2, air, air)
  s.piece .fillWithOutline(chunk, bb, false, 12, 1, 1, 16, 3, 3, ss, air)
  s.piece .fillWithOutline(chunk, bb, false, 12, 1, 2, 16, 2, 2, air, air)
  s.piece .fillWithOutline(chunk, bb, false, 5, 4, 5, Width - 6, 4, Depth - 6, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, 9, 4, 9, 11, 4, 11, air, air)
  s.piece .fillWithOutline(chunk, bb, false, 8, 1, 8, 8, 3, 8, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 12, 1, 8, 12, 3, 8, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 8, 1, 12, 8, 3, 12, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 12, 1, 12, 12, 3, 12, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 1, 1, 5, 4, 4, 11, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, Width - 5, 1, 5, Width - 2, 4, 11, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, 6, 7, 9, 6, 7, 11, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, Width - 7, 7, 9, Width - 7, 7, 11, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, 5, 5, 9, 5, 7, 11, cut, cut)
  fillWithOutline(p, chunk, bb, false, Width - 6, 5, 9, Width - 6, 7, 11, cut, cut)
  addBlock(p, chunk, air, 5, 5, 10, bb)
  addBlock(p, chunk, air, 5, 6, 10, bb)
  addBlock(p, chunk, air, 6, 6, 10, bb)
  addBlock(p, chunk, air, Width - 6, 5, 10, bb)
  addBlock(p, chunk, air, Width - 6, 6, 10, bb)
  addBlock(p, chunk, air, Width - 7, 6, 10, bb)
  s.piece .fillWithOutline(chunk, bb, false, 2, 4, 4, 2, 6, 4, air, air)
  s.piece .fillWithOutline(chunk, bb, false, Width - 3, 4, 4, Width - 3, 6, 4, air, air)
  addBlock(p, chunk, northStairs, 2, 4, 5, bb)
  addBlock(p, chunk, northStairs, 2, 3, 4, bb)
  s.piece .addBlock(chunk, northStairs, Width - 3, 4, 5, bb)
  s.piece .addBlock(chunk, northStairs, Width - 3, 3, 4, bb)
  s.piece .fillWithOutline(chunk, bb, false, 1, 1, 3, 2, 2, 3, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, Width - 3, 1, 3, Width - 2, 2, 3, ss, ss)
  addBlock(p, chunk, ss, 1, 1, 2, bb)
  addBlock(p, chunk, ss, Width - 2, 1, 2, bb)
  addBlock(p, chunk, slab, 1, 2, 2, bb)
  addBlock(p, chunk, slab, Width - 2, 2, 2, bb)
  addBlock(p, chunk, westStairs, 2, 1, 2, bb)
  s.piece .addBlock(chunk, eastStairs, Width - 3, 1, 2, bb)
  s.piece .fillWithOutline(chunk, bb, false, 4, 3, 5, 4, 3, 17, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, Width - 5, 3, 5, Width - 5, 3, 17, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, 3, 1, 5, 4, 2, 16, air, air)
  fillWithOutline(p, chunk, bb, false, Width - 6, 1, 5, Width - 5, 2, 16, air, air)
  for z in stepRange(int32(5), int32(17), int32(2)):
    addBlock(p, chunk, cut, 4, 1, z, bb)
    addBlock(p, chunk, chiseled, 4, 2, z, bb)
    addBlock(p, chunk, cut, Width - 5, 1, z, bb)
    addBlock(p, chunk, chiseled, Width - 5, 2, z, bb)
  addBlock(p, chunk, orange, 10, 0, 7, bb)
  addBlock(p, chunk, orange, 10, 0, 8, bb)
  addBlock(p, chunk, orange, 9, 0, 9, bb)
  addBlock(p, chunk, orange, 11, 0, 9, bb)
  addBlock(p, chunk, orange, 8, 0, 10, bb)
  addBlock(p, chunk, orange, 12, 0, 10, bb)
  addBlock(p, chunk, orange, 7, 0, 10, bb)
  addBlock(p, chunk, orange, 13, 0, 10, bb)
  addBlock(p, chunk, orange, 9, 0, 11, bb)
  addBlock(p, chunk, orange, 11, 0, 11, bb)
  addBlock(p, chunk, orange, 10, 0, 12, bb)
  addBlock(p, chunk, orange, 10, 0, 13, bb)
  addBlock(p, chunk, blue, 10, 0, 10, bb)
  for x in [0'i32, Width - 1]:
    addBlock(p, chunk, cut, x, 2, 1, bb)
    addBlock(p, chunk, orange, x, 2, 2, bb)
    addBlock(p, chunk, cut, x, 2, 3, bb)
    addBlock(p, chunk, cut, x, 3, 1, bb)
    addBlock(p, chunk, orange, x, 3, 2, bb)
    addBlock(p, chunk, cut, x, 3, 3, bb)
    addBlock(p, chunk, orange, x, 4, 1, bb)
    addBlock(p, chunk, chiseled, x, 4, 2, bb)
    addBlock(p, chunk, orange, x, 4, 3, bb)
    addBlock(p, chunk, cut, x, 5, 1, bb)
    addBlock(p, chunk, orange, x, 5, 2, bb)
    addBlock(p, chunk, cut, x, 5, 3, bb)
    addBlock(p, chunk, orange, x, 6, 1, bb)
    addBlock(p, chunk, chiseled, x, 6, 2, bb)
    addBlock(p, chunk, orange, x, 6, 3, bb)
    addBlock(p, chunk, orange, x, 7, 1, bb)
    addBlock(p, chunk, orange, x, 7, 2, bb)
    addBlock(p, chunk, orange, x, 7, 3, bb)
    addBlock(p, chunk, cut, x, 8, 1, bb)
    addBlock(p, chunk, cut, x, 8, 2, bb)
    addBlock(p, chunk, cut, x, 8, 3, bb)
  for x in [2'i32, Width - 3]:
    addBlock(p, chunk, cut, x - 1, 2, 0, bb)
    addBlock(p, chunk, orange, x, 2, 0, bb)
    addBlock(p, chunk, cut, x + 1, 2, 0, bb)
    addBlock(p, chunk, cut, x - 1, 3, 0, bb)
    addBlock(p, chunk, orange, x, 3, 0, bb)
    addBlock(p, chunk, cut, x + 1, 3, 0, bb)
    addBlock(p, chunk, orange, x - 1, 4, 0, bb)
    addBlock(p, chunk, chiseled, x, 4, 0, bb)
    addBlock(p, chunk, orange, x + 1, 4, 0, bb)
    addBlock(p, chunk, cut, x - 1, 5, 0, bb)
    addBlock(p, chunk, orange, x, 5, 0, bb)
    addBlock(p, chunk, cut, x + 1, 5, 0, bb)
    addBlock(p, chunk, orange, x - 1, 6, 0, bb)
    addBlock(p, chunk, chiseled, x, 6, 0, bb)
    addBlock(p, chunk, orange, x + 1, 6, 0, bb)
    addBlock(p, chunk, orange, x - 1, 7, 0, bb)
    addBlock(p, chunk, orange, x, 7, 0, bb)
    addBlock(p, chunk, orange, x + 1, 7, 0, bb)
    addBlock(p, chunk, cut, x - 1, 8, 0, bb)
    addBlock(p, chunk, cut, x, 8, 0, bb)
    addBlock(p, chunk, cut, x + 1, 8, 0, bb)
  s.piece .fillWithOutline(chunk, bb, false, 8, 4, 0, 12, 6, 0, cut, cut)
  addBlock(p, chunk, air, 8, 6, 0, bb)
  addBlock(p, chunk, air, 12, 6, 0, bb)
  addBlock(p, chunk, orange, 9, 5, 0, bb)
  addBlock(p, chunk, chiseled, 10, 5, 0, bb)
  addBlock(p, chunk, orange, 11, 5, 0, bb)
  s.piece .fillWithOutline(chunk, bb, false, 8, -14, 8, 12, -11, 12, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 8, -10, 8, 12, -10, 12, chiseled, chiseled)
  s.piece .fillWithOutline(chunk, bb, false, 8, -9, 8, 12, -9, 12, cut, cut)
  s.piece .fillWithOutline(chunk, bb, false, 8, -8, 8, 12, -1, 12, ss, ss)
  s.piece .fillWithOutline(chunk, bb, false, 9, -11, 9, 11, -1, 11, air, air)
  addBlock(p, chunk, blockState("stone_pressure_plate"), 10, -11, 10, bb)
  fillWithOutline(p, chunk, bb, false, 9, -13, 9, 11, -13, 11, blockState("tnt"), air)
  addBlock(p, chunk, air, 8, -11, 10, bb)
  addBlock(p, chunk, air, 8, -10, 10, bb)
  addBlock(p, chunk, chiseled, 7, -10, 10, bb)
  addBlock(p, chunk, cut, 7, -11, 10, bb)
  addBlock(p, chunk, air, 12, -11, 10, bb)
  addBlock(p, chunk, air, 12, -10, 10, bb)
  addBlock(p, chunk, chiseled, 13, -10, 10, bb)
  addBlock(p, chunk, cut, 13, -11, 10, bb)
  addBlock(p, chunk, air, 10, -11, 8, bb)
  addBlock(p, chunk, air, 10, -10, 8, bb)
  addBlock(p, chunk, chiseled, 10, -10, 7, bb)
  addBlock(p, chunk, cut, 10, -11, 7, bb)
  addBlock(p, chunk, air, 10, -11, 12, bb)
  addBlock(p, chunk, air, 10, -10, 12, bb)
  addBlock(p, chunk, chiseled, 10, -10, 13, bb)
  addBlock(p, chunk, cut, 10, -11, 13, bb)
  tryPlaceChest(s, chunk, bb, 0, 10, -11, 12)
  tryPlaceChest(s, chunk, bb, 1, 8, -11, 10)
  tryPlaceChest(s, chunk, bb, 2, 10, -11, 8)
  tryPlaceChest(s, chunk, bb, 3, 12, -11, 10)
  addCellar(s, chunk, bb, levelRandom)

proc desertPyramidPosition*(context: var StructureGeneratorContext): StructurePosition =
  let x = startBlockX(context.chunkX)
  let z = startBlockZ(context.chunkZ)
  let facing = getRandomHorizontalDirection(context.random)
  let piece = DesertPyramidPiece(piece: newStructurePiece(StructurePieceType.DesertTemple, createBox(BlockBox, x, 64, z, getAxis(facing), Width, Height, Depth), 0), placeFn: placeDesertPyramid, heightAdjusted: false)
  setFacing(piece.piece, facing)
  singlePiecePosition(piece, x + (Width div 2), 64, z + (Depth div 2))
