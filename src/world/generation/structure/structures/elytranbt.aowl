## The end city's item frame item, written by the real item stack serializer (`ItemStack::write_item_stack`), as
## the newer checkout's end_city.rs does. Its own module: src/data/item_stack exports names that structuresmod uses.

import ../../../../nbt/tag
import "../../../../data/item_stack/mod"
import ../../../../generated/item_full

proc elytraItemNbt*(): NbtCompound =
  ## `ItemStack::new(1, &Item::ELYTRA).write_item_stack(&mut nbt)`
  result = newCompound()
  writeItemStack(newItemStack(1'u8, ITEM_ELYTRA), result)
