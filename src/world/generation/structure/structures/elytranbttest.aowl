## `ItemStack::new(1, &Item::ELYTRA).write_item_stack`: id and count, and the empty `components` compound the real
## serializer always writes.

import std/[syncio, options, assertions]
import ../../../../nbt/tag
import elytranbt

let nbt = elytraItemNbt()
assert getString(nbt, "id") == some("minecraft:elytra")
assert getInt(nbt, "count") == some(1'i32)
let components = getCompound(nbt, "components")
assert components.isSome
echo "elytranbt: all checks passed"
