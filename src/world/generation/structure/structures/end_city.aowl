## Port of pumpkin-world/src/generation/structure/structures/end_city.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/end_city.rs - the pinned tree's piece is one fixed tower in a 61-wide
## box, and no end was in the save to compare with.

{.feature: "lenientnils".}

import "../template/templatemod"
import structuresmod

type
  EndCityPiece = ref object of StructurePieceBase
    baseFloor, towerBase, towerPiece, towerTop, ship: StructureTemplate
    rotation: Rotation
    hasShip: bool

proc placeEndCity(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[EndCityPiece](self)
  let origin = p.piece.boundingBox.min
  let sampleY = getTopY(chunk, WorldSurfaceWg, origin.x, origin.z)
  let startY = if sampleY <= 0: 60'i32 else: sampleY
  var pos = vec3[int32](origin.x, startY, origin.z)
  placeTemplateIn(chunk, p.baseFloor, pos, (0'i32, 0'i32), p.rotation, true, false, chunkBox)
  pos.y += p.baseFloor.size.y
  placeTemplateIn(chunk, p.towerBase, pos, (0'i32, 0'i32), p.rotation, true, false, chunkBox)
  pos.y += p.towerBase.size.y
  placeTemplateIn(chunk, p.towerPiece, pos, (0'i32, 0'i32), p.rotation, true, false, chunkBox)
  pos.y += p.towerPiece.size.y
  placeTemplateIn(chunk, p.towerTop, pos, (0'i32, 0'i32), p.rotation, true, false, chunkBox)
  if p.hasShip:
    placeTemplateIn(chunk, p.ship, vec3[int32](origin.x + 16, startY + 20, origin.z + 16), (0'i32, 0'i32), p.rotation, true,
      false, chunkBox)

proc endCityPosition*(context: var StructureGeneratorContext): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let baseFloor = getTemplate("end_city/base_floor")
  let towerBase = getTemplate("end_city/tower_base")
  let towerPiece = getTemplate("end_city/tower_piece")
  let towerTop = getTemplate("end_city/tower_top")
  let ship = getTemplate("end_city/ship")
  if baseFloor == nil or towerBase == nil or towerPiece == nil or towerTop == nil or ship == nil:
    return nil
  let boundingBox = newBlockBox(chunkCenterX - 30, context.minY, chunkCenterZ - 30, chunkCenterX + 30, 256, chunkCenterZ + 30)
  let piece = EndCityPiece(piece: newStructurePiece(StructurePieceType.EndCity, boundingBox, 0), placeFn: placeEndCity,
    baseFloor: baseFloor, towerBase: towerBase, towerPiece: towerPiece, towerTop: towerTop, ship: ship, rotation: rotation,
    hasShip: nextF32(context.random) < 0.5'f32)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
