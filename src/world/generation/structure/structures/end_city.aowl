## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/end_city/mod.rs and end_city/layout.rs
##
## The pinned tree's piece was one fixed tower, so this one comes from the newer tree. Upstream's `Option<T>` returns from
## layout mean a template is missing; here that sets `failed` on the layout and the generator returns nil.

{.feature: "lenientnils".}

import std/options
import std/strutils
import "../template/templatemod"
import structuresmod
import elytranbt

const
  LootTable = "minecraft:chests/end_city_treasure"
  MaxGenerationDepth = 8'i32

type
  PieceDescriptor* = ref object
    templateData*: StructureTemplate
    templatePosition*: Vector3[int32]
    rotation*: Rotation
    overwrite*: bool
    boundingBox*: BlockBox
    generationGroup*: int32
    templateName*: string

  Section {.pure.} = enum
    HouseTower, Tower, TowerBridge, FatTower

  EndCityLayout = ref object
    shipCreated: bool
    failed: bool

  EndCityTemplatePiece = ref object of StructurePieceBase
    descriptor: PieceDescriptor

proc newPieceDescriptor*(templateName: string, templatePosition: Vector3[int32], rotation: Rotation, overwrite: bool): PieceDescriptor =
  ## `PieceDescriptor::new`: nil for a missing template.
  let t = getTemplate("end_city/" & templateName)
  if t == nil:
    return nil
  let (maxX, maxZ) = rotateOffset(rotation, t.size.x - 1, t.size.z - 1)
  let boundingBox = newBlockBox(min(templatePosition.x, templatePosition.x + maxX), templatePosition.y,
    min(templatePosition.z, templatePosition.z + maxZ), max(templatePosition.x, templatePosition.x + maxX),
    templatePosition.y + t.size.y - 1, max(templatePosition.z, templatePosition.z + maxZ))
  PieceDescriptor(templateData: t, templatePosition: templatePosition, rotation: rotation, overwrite: overwrite,
    boundingBox: boundingBox, generationGroup: 0, templateName: templateName)

proc connected(parent: PieceDescriptor, offset: Vector3[int32], templateName: string, rotation: Rotation,
               overwrite: bool): PieceDescriptor =
  ## Vanilla's calculateConnectedPosition rotates both connector positions around the template origin. End City children
  ## always use ZERO for the child connector, leaving only the parent's rotated offset.
  let (x, z) = rotateOffset(parent.rotation, offset.x, offset.z)
  newPieceDescriptor(templateName, vec3[int32](parent.templatePosition.x + x, parent.templatePosition.y + offset.y,
    parent.templatePosition.z + z), rotation, overwrite)

proc pushConnected(layout: EndCityLayout, pieces: var seq[PieceDescriptor], parent: PieceDescriptor, offset: Vector3[int32],
                   templateName: string, rotation: Rotation, overwrite: bool): PieceDescriptor =
  ## `push_connected`. A copy goes into `pieces`, as upstream's clone does: later writes to the returned one stay out.
  let piece = connected(parent, offset, templateName, rotation, overwrite)
  if piece == nil:
    layout.failed = true
    return parent
  pieces.add(PieceDescriptor(templateData: piece.templateData, templatePosition: piece.templatePosition,
    rotation: piece.rotation, overwrite: piece.overwrite, boundingBox: piece.boundingBox,
    generationGroup: piece.generationGroup, templateName: piece.templateName))
  piece

proc recursiveChildren(layout: EndCityLayout, section: Section, depth: int32, parent: PieceDescriptor, hasOffset: bool,
                       offset: Vector3[int32], pieces: var seq[PieceDescriptor], random: var RandomGenerator): bool

proc generateHouseTower(layout: EndCityLayout, depth: int32, parent: PieceDescriptor, offset: Vector3[int32],
                        pieces: var seq[PieceDescriptor], random: var RandomGenerator): bool =
  if depth > MaxGenerationDepth:
    return false
  let rotation = parent.rotation
  var last = pushConnected(layout, pieces, parent, offset, "base_floor", rotation, true)
  case nextBoundedI32(random, 3)
  of 0:
    discard pushConnected(layout, pieces, last, vec3[int32](-1, 4, -1), "base_roof", rotation, true)
  of 1:
    last = pushConnected(layout, pieces, last, vec3[int32](-1, 0, -1), "second_floor_2", rotation, false)
    last = pushConnected(layout, pieces, last, vec3[int32](-1, 8, -1), "second_roof", rotation, false)
    discard recursiveChildren(layout, Section.Tower, depth + 1, last, false, vec3[int32](0, 0, 0), pieces, random)
  else:
    last = pushConnected(layout, pieces, last, vec3[int32](-1, 0, -1), "second_floor_2", rotation, false)
    last = pushConnected(layout, pieces, last, vec3[int32](-1, 4, -1), "third_floor_2", rotation, false)
    last = pushConnected(layout, pieces, last, vec3[int32](-1, 8, -1), "third_roof", rotation, true)
    discard recursiveChildren(layout, Section.Tower, depth + 1, last, false, vec3[int32](0, 0, 0), pieces, random)
  true

proc generateTower(layout: EndCityLayout, depth: int32, parent: PieceDescriptor, pieces: var seq[PieceDescriptor],
                   random: var RandomGenerator): bool =
  let rotation = parent.rotation
  let firstX = 3 + nextBoundedI32(random, 2)
  let firstZ = 3 + nextBoundedI32(random, 2)
  var last = pushConnected(layout, pieces, parent, vec3[int32](firstX, -3, firstZ), "tower_base", rotation, true)
  last = pushConnected(layout, pieces, last, vec3[int32](0, 7, 0), "tower_piece", rotation, true)
  var bridgePiece: PieceDescriptor = nil
  if nextBoundedI32(random, 3) == 0:
    bridgePiece = last
  let towerHeight = 1 + nextBoundedI32(random, 3)
  for index in 0'i32 ..< towerHeight:
    last = pushConnected(layout, pieces, last, vec3[int32](0, 4, 0), "tower_piece", rotation, true)
    if index < towerHeight - 1 and nextBool(random):
      bridgePiece = last

  if bridgePiece != nil:
    for (bridgeRotation, ox, oz) in [(Rotation.None, 1'i32, 0'i32), (Rotation.Clockwise90, 6'i32, 1'i32),
        (Rotation.CounterClockwise90, 0'i32, 5'i32), (Rotation.Rotate180, 5'i32, 6'i32)]:
      if nextBool(random):
        let bridgeStart = pushConnected(layout, pieces, bridgePiece, vec3[int32](ox, -1, oz), "bridge_end",
          then(rotation, bridgeRotation), true)
        discard recursiveChildren(layout, Section.TowerBridge, depth + 1, bridgeStart, false, vec3[int32](0, 0, 0), pieces, random)
    discard pushConnected(layout, pieces, last, vec3[int32](-1, 4, -1), "tower_top", rotation, true)
    return true

  if depth != 7:
    return recursiveChildren(layout, Section.FatTower, depth + 1, last, false, vec3[int32](0, 0, 0), pieces, random)
  discard pushConnected(layout, pieces, last, vec3[int32](-1, 4, -1), "tower_top", rotation, true)
  true

proc generateTowerBridge(layout: EndCityLayout, depth: int32, parent: PieceDescriptor, pieces: var seq[PieceDescriptor],
                         random: var RandomGenerator): bool =
  let rotation = parent.rotation
  let bridgeLength = nextBoundedI32(random, 4) + 1
  var last = pushConnected(layout, pieces, parent, vec3[int32](0, 0, -4), "bridge_piece", rotation, true)
  last.generationGroup = -1
  if pieces.len > 0:
    pieces[pieces.len - 1].generationGroup = -1
  var nextY = 0'i32
  for n in 0'i32 ..< bridgeLength:
    let offsetY = nextY
    var templateName = "bridge_piece"
    var z = -4'i32
    if nextBool(random):
      nextY = 0
    else:
      if nextBool(random):
        templateName = "bridge_steep_stairs"
        z = -4
      else:
        templateName = "bridge_gentle_stairs"
        z = -8
      nextY = 4
    last = pushConnected(layout, pieces, last, vec3[int32](0, offsetY, z), templateName, rotation, true)

  if not layout.shipCreated and nextBoundedI32(random, 10 - depth) == 0:
    let shipX = -8 + nextBoundedI32(random, 8)
    let shipZ = -70 + nextBoundedI32(random, 10)
    discard pushConnected(layout, pieces, last, vec3[int32](shipX, nextY, shipZ), "ship", rotation, true)
    layout.shipCreated = true
  elif not recursiveChildren(layout, Section.HouseTower, depth + 1, last, true, vec3[int32](-3, nextY + 1, -11), pieces, random):
    return false

  discard pushConnected(layout, pieces, last, vec3[int32](4, nextY, 0), "bridge_end", then(rotation, Rotation.Rotate180), true)
  if pieces.len > 0:
    pieces[pieces.len - 1].generationGroup = -1
  true

proc generateFatTower(layout: EndCityLayout, depth: int32, parent: PieceDescriptor, pieces: var seq[PieceDescriptor],
                      random: var RandomGenerator): bool =
  let rotation = parent.rotation
  var last = pushConnected(layout, pieces, parent, vec3[int32](-3, 4, -3), "fat_tower_base", rotation, true)
  last = pushConnected(layout, pieces, last, vec3[int32](0, 4, 0), "fat_tower_middle", rotation, true)
  for n in 0 ..< 2:
    if nextBoundedI32(random, 3) == 0:
      break
    last = pushConnected(layout, pieces, last, vec3[int32](0, 8, 0), "fat_tower_middle", rotation, true)
    for (bridgeRotation, ox, oz) in [(Rotation.None, 4'i32, 0'i32), (Rotation.Clockwise90, 12'i32, 4'i32),
        (Rotation.CounterClockwise90, 0'i32, 8'i32), (Rotation.Rotate180, 8'i32, 12'i32)]:
      if nextBool(random):
        let bridgeStart = pushConnected(layout, pieces, last, vec3[int32](ox, -1, oz), "bridge_end",
          then(rotation, bridgeRotation), true)
        discard recursiveChildren(layout, Section.TowerBridge, depth + 1, bridgeStart, false, vec3[int32](0, 0, 0), pieces, random)
  discard pushConnected(layout, pieces, last, vec3[int32](-2, 8, -2), "fat_tower_top", rotation, true)
  true

proc generateSection(layout: EndCityLayout, section: Section, depth: int32, parent: PieceDescriptor, offset: Vector3[int32],
                     pieces: var seq[PieceDescriptor], random: var RandomGenerator): bool =
  case section
  of Section.HouseTower: generateHouseTower(layout, depth, parent, offset, pieces, random)
  of Section.Tower: generateTower(layout, depth, parent, pieces, random)
  of Section.TowerBridge: generateTowerBridge(layout, depth, parent, pieces, random)
  of Section.FatTower: generateFatTower(layout, depth, parent, pieces, random)

proc recursiveChildren(layout: EndCityLayout, section: Section, depth: int32, parent: PieceDescriptor, hasOffset: bool,
                       offset: Vector3[int32], pieces: var seq[PieceDescriptor], random: var RandomGenerator): bool =
  if depth > MaxGenerationDepth:
    return false
  var children: seq[PieceDescriptor] = @[]
  if not generateSection(layout, section, depth, parent, offset, children, random):
    return false
  let generationGroup = nextI32(random)
  for ci in 0 ..< children.len:
    children[ci].generationGroup = generationGroup
    for pi in 0 ..< pieces.len:
      if intersects(pieces[pi].boundingBox, children[ci].boundingBox):
        if pieces[pi].generationGroup != parent.generationGroup:
          return false
        break
  for ci in 0 ..< children.len:
    pieces.add(children[ci])
  true

proc createLayout*(origin: Vector3[int32], rotation: Rotation, random: var RandomGenerator, pieces: var seq[PieceDescriptor]): bool =
  ## `EndCityLayout::create`: false for `None`.
  let layout = EndCityLayout(shipCreated: false, failed: false)
  var last = newPieceDescriptor("base_floor", origin, rotation, true)
  if last == nil:
    return false
  pieces.add(last)
  last = pushConnected(layout, pieces, last, vec3[int32](-1, 0, -1), "second_floor_1", rotation, false)
  last = pushConnected(layout, pieces, last, vec3[int32](-1, 4, -1), "third_floor_1", rotation, false)
  last = pushConnected(layout, pieces, last, vec3[int32](-1, 8, -1), "third_roof", rotation, true)
  discard recursiveChildren(layout, Section.Tower, 1, last, false, vec3[int32](0, 0, 0), pieces, random)
  not layout.failed

proc entityNbt(id: string, x, y, z: float64): NbtCompound =
  result = newCompound()
  putString(result, "id", id)
  putList(result, "Pos", @[nbtTag(x), nbtTag(y), nbtTag(z)])
  putList(result, "Motion", @[nbtTag(0.0'f64), nbtTag(0.0'f64), nbtTag(0.0'f64)])
  putList(result, "Rotation", @[nbtTag(0.0'f32), nbtTag(0.0'f32)])

proc itemFrameNbt(p: EndCityTemplatePiece, position: Vector3[int32]): NbtCompound =
  let (facing, yaw) =
    case p.descriptor.rotation
    of Rotation.None: (South, 0.0'f32)
    of Rotation.Clockwise90: (West, 90.0'f32)
    of Rotation.Rotate180: (North, 180.0'f32)
    of Rotation.CounterClockwise90: (East, 270.0'f32)
  let offset = toVector(facing)
  result = entityNbt("minecraft:item_frame", float64(position.x) + 0.5'f64 - float64(offset.x) * 0.46875'f64,
    float64(position.y) + 0.5'f64, float64(position.z) + 0.5'f64 - float64(offset.z) * 0.46875'f64)
  putByte(result, "Facing", int8(ord(facing)))
  put(result, "block_pos", NbtTag(kind: ntkIntArray, intArrayVal: @[position.x, position.y, position.z]))
  putByte(result, "ItemRotation", 0)
  putList(result, "Rotation", @[nbtTag(yaw), nbtTag(0.0'f32)])
  putCompound(result, "Item", elytraItemNbt())

proc handleMarker(p: EndCityTemplatePiece, chunk: ProtoChunk, random: var RandomGenerator, marker: string, position: Vector3[int32],
                  chunkBox: BlockBox) =
  if startsWith(marker, "Chest"):
    let chestPosition = vec3[int32](position.x, position.y - 1, position.z)
    if containsPos(chunkBox, chestPosition):
      var nbt = newCompound()
      putString(nbt, "id", "minecraft:chest")
      putInt(nbt, "x", chestPosition.x)
      putInt(nbt, "y", chestPosition.y)
      putInt(nbt, "z", chestPosition.z)
      putString(nbt, "LootTable", LootTable)
      putLong(nbt, "LootTableSeed", nextI64(random))
      addBlockEntity(chunk, nbt)
    return
  if not containsPos(chunkBox, position):
    return
  if startsWith(marker, "Sentry"):
    addStructureEntity(chunk, entityNbt("minecraft:shulker", float64(position.x) + 0.5'f64, float64(position.y),
      float64(position.z) + 0.5'f64))
  elif startsWith(marker, "Elytra"):
    addStructureEntity(chunk, itemFrameNbt(p, position))

proc worldPosition(p: EndCityTemplatePiece, local: Vector3[int32]): Vector3[int32] =
  let (x, z) = rotateOffset(p.descriptor.rotation, local.x, local.z)
  vec3[int32](p.descriptor.templatePosition.x + x, p.descriptor.templatePosition.y + local.y, p.descriptor.templatePosition.z + z)

proc placeBlockEntity(chunk: ProtoChunk, palette: PaletteEntry, b: TemplateBlock, position: Vector3[int32],
                      random: var RandomGenerator) =
  let (hasEntityId, entityId) = getBlockEntityId(palette.name)
  if not b.hasNbt and not hasEntityId:
    return
  var nbt = newCompound()
  putString(nbt, "id", if hasEntityId: entityId else: palette.name)
  putInt(nbt, "x", position.x)
  putInt(nbt, "y", position.y)
  putInt(nbt, "z", position.z)
  if b.hasNbt:
    copyTemplateNbt(nbt, b.nbt)
  if isSome(getString(nbt, "LootTable")) and isNone(getLong(nbt, "LootTableSeed")):
    putLong(nbt, "LootTableSeed", nextI64(random))
  addBlockEntity(chunk, nbt)

proc placeEndCity(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[EndCityTemplatePiece](self)
  let d = p.descriptor
  let t = d.templateData
  for bi in 0 ..< t.blocks.len:
    let palette = t.palette[int(t.blocks[bi].state)]
    if palette.name == "minecraft:structure_void" or palette.name == "minecraft:structure_block" or
        (not d.overwrite and palette.name == "minecraft:air"):
      continue
    let position = worldPosition(p, t.blocks[bi].pos)
    if not containsPos(chunkBox, position):
      continue
    let (found, state) = resolve(palette, d.rotation, Mirror.None)
    if not found:
      continue
    setBlockState(chunk, position.x, position.y, position.z, state)
    placeBlockEntity(chunk, palette, t.blocks[bi], position, random)

  for bi in 0 ..< t.blocks.len:
    if t.palette[int(t.blocks[bi].state)].name != "minecraft:structure_block" or not t.blocks[bi].hasNbt:
      continue
    let marker = getString(t.blocks[bi].nbt, "metadata")
    if isNone(marker):
      continue
    handleMarker(p, chunk, random, get(marker), worldPosition(p, t.blocks[bi].pos), chunkBox)

proc endCityPosition*(context: var StructureGeneratorContext): StructurePosition =
  ## `<EndCityGenerator as StructureGenerator>::get_structure_position`
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let x = context.chunkX * 16 + 7
  let z = context.chunkZ * 16 + 7
  let (offsetX, offsetZ) =
    case rotation
    of Rotation.None: (5'i32, 5'i32)
    of Rotation.Clockwise90: (-5'i32, 5'i32)
    of Rotation.Rotate180: (-5'i32, -5'i32)
    of Rotation.CounterClockwise90: (5'i32, -5'i32)
  if context.heightSampler == nil:
    return nil
  let h0 = estimateHeight(context.heightSampler, x, z) - 1
  let h1 = estimateHeight(context.heightSampler, x, z + offsetZ) - 1
  let h2 = estimateHeight(context.heightSampler, x + offsetX, z) - 1
  let h3 = estimateHeight(context.heightSampler, x + offsetX, z + offsetZ) - 1
  let y = min(min(min(h0, h1), h2), h3)
  if y < 60:
    return nil
  var descriptors: seq[PieceDescriptor] = @[]
  if not createLayout(vec3[int32](x, y, z), rotation, context.random, descriptors):
    return nil
  let collector = newStructurePiecesCollector()
  for i in 0 ..< descriptors.len:
    addPiece(collector, EndCityTemplatePiece(piece: newStructurePiece(StructurePieceType.EndCity, descriptors[i].boundingBox, 0),
      placeFn: placeEndCity, descriptor: descriptors[i]))
  StructurePosition(startPos: blockPos(x, y, z), collector: collector)
