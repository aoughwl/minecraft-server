## Igloo structure generator for snowy biomes.
## Port of pumpkin-world/src/generation/structure/structures/igloo.rs

{.feature: "lenientnils".}

import "../template/templatemod"
import ../shiftable_piece
import structuresmod

const
  DomeWidth = 7'i32
  DomeHeight = 5'i32
  DomeDepth = 8'i32
  ShaftHeight = 3'i32
  BasementHeight = 6'i32
  BasementDepth = 9'i32
  PivotOffsetX = 3'i32
  PivotOffsetZ = 5'i32
  ShaftOffsetX = 2'i32
  ShaftOffsetZ = 4'i32
  BasementOffsetX = 0'i32
  BasementOffsetZ = -2'i32

type
  IglooPiece = ref object of ShiftableStructurePiece
    topTemplate, middleTemplate, bottomTemplate: StructureTemplate
    rotation: Rotation
    hasBasement: bool
    ladderSegments: uint8

proc placeIgloo(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[IglooPiece](self)
  let origin0 = p.piece.boundingBox.min
  let (entranceX, entranceZ) = rotateOffset(p.rotation, 3, 5)
  let surfaceY = getTopY(chunk, WorldSurfaceWg, origin0.x + entranceX, origin0.z + entranceZ)
  let offset = surfaceY - 1 - origin0.y
  p.piece.boundingBox.min.y += offset
  p.piece.boundingBox.max.y += offset
  let origin = p.piece.boundingBox.min
  let domeFloorY = origin.y
  placeTemplateIn(chunk, p.topTemplate, origin, (0'i32, 0'i32), p.rotation, false, false, chunkBox)
  if p.hasBasement:
    let basementDepth = (int32(p.ladderSegments) * ShaftHeight) + BasementHeight + 1
    p.piece.boundingBox.min.y -= basementDepth
    let (ignoredX, bz) = rotateOffset(p.rotation, BasementOffsetX, BasementOffsetZ)
    if bz < 0:
      p.piece.boundingBox.min.z += bz
    else:
      p.piece.boundingBox.max.z += BasementDepth
    if p.middleTemplate != nil:
      var segment = 0'i32
      while segment < int32(p.ladderSegments):
        let segmentY = domeFloorY - 1 - (segment * ShaftHeight)
        placeTemplateIn(chunk, p.middleTemplate, vec3[int32](origin.x, segmentY, origin.z), (ShaftOffsetX, ShaftOffsetZ),
          p.rotation, false, false, chunkBox)
        inc segment
    if p.bottomTemplate != nil:
      let totalShaftDepth = int32(p.ladderSegments) * ShaftHeight
      let basementY = domeFloorY - totalShaftDepth - BasementHeight + 1
      placeTemplateIn(chunk, p.bottomTemplate, vec3[int32](origin.x, basementY, origin.z), (BasementOffsetX, BasementOffsetZ),
        p.rotation, false, false, chunkBox)

proc iglooPosition*(context: var StructureGeneratorContext): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let x = chunkCenterX - PivotOffsetX
  let z = chunkCenterZ - PivotOffsetZ
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let hasBasement = nextF64(context.random) < 0.5'f64
  let ladderSegments = if hasBasement: uint8(nextBoundedI32(context.random, 8)) + 4'u8 else: 0'u8
  let topTemplate = getTemplate("igloo/top")
  if topTemplate == nil:
    return nil
  let piece = IglooPiece(placeFn: placeIgloo, topTemplate: topTemplate,
    middleTemplate: if hasBasement: getTemplate("igloo/middle") else: nil,
    bottomTemplate: if hasBasement: getTemplate("igloo/bottom") else: nil,
    rotation: rotation, hasBasement: hasBasement, ladderSegments: ladderSegments)
  initShiftable(piece, StructurePieceType.Igloo, x, 64, z, DomeWidth, DomeHeight, DomeDepth, toAxis(rotation))
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
