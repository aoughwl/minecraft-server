## Jigsaw expansion, and the generator that calls it.
## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/jigsaw_placement.rs, with `JigsawGenerator`
## from jigsaw.rs: pool aliases and the placing queue are the newer tree's. The start's height provider and pool aliases come
## from the embedded assets/structures.json (see gen_structure_assets.aowl).

{.feature: "lenientnils".}

import std/tables
import ../../../../codecs/json_value
import ../../../../generated/structures
import ../../../../generated/structure_assets
import ../../../../util/legacy_rand
import ../../height_provider
import ../../../../util/y_offset
import "../template/templatemod"
import structuresmod
import jigsaw

export jigsaw

const
  MaxTotalStructureRange* = 128'i32
  MinDepth* = 0'i32
  MaxDepth* = 20'i32

type
  DimensionPadding* = object
    top*, bottom*: int32

  MaxDistance* = object
    horizontal*, vertical*: int32

  PoolAliasBindingKind* {.pure.} = enum
    Direct, Random, RandomGroup

  WeightedPoolAliasTarget* = object
    target*: string
    weight*: uint32

  WeightedPoolAliasGroup* = object
    bindings*: seq[PoolAliasBinding]
    weight*: uint32

  PoolAliasBinding* = object
    ## `enum PoolAliasBinding`
    kind*: PoolAliasBindingKind
    alias*: string                          ## `Direct`, `Random`
    target*: string                         ## `Direct`
    targets*: seq[WeightedPoolAliasTarget]  ## `Random`
    groups*: seq[WeightedPoolAliasGroup]    ## `RandomGroup`

  PoolAliasLookup* = ref object
    aliases: Table[string, string]

  FreeSpace* = ref object
    bounds*: BlockBox
    occupied*: seq[BlockBox]

  PieceState = object
    pieceIdx: int
    free: FreeSpace
    depth: int32

  PriorityQueue = object
    priority: int32
    items: seq[PieceState]
    head: int

  PlacingQueue = object
    ## Queues by priority, highest first; first in, first out within one.
    queues: seq[PriorityQueue]

  Placer = ref object
    maxDepth: int32
    pieces: seq[PoolElementStructurePiece]
    placing: PlacingQueue

  JigsawGenerator* = object
    startPool*: string
    size*: int32
    hasStartJigsawName*: bool
    startJigsawName*: string
    useExpansionHack*: bool

proc newMaxDistance*(horizontal: int32): MaxDistance =
  MaxDistance(horizontal: horizontal, vertical: 384)

proc addDirect*(l: PoolAliasLookup, alias, target: string) =
  ## `add_direct`: under both spellings of the alias.
  if alias.len > 10 and alias[0 .. 9] == "minecraft:":
    l.aliases[alias[10 .. ^1]] = target
  else:
    l.aliases["minecraft:" & alias] = target
  l.aliases[alias] = target

proc addBinding(l: PoolAliasLookup, binding: PoolAliasBinding, random: var RandomGenerator) =
  case binding.kind
  of PoolAliasBindingKind.Direct:
    addDirect(l, binding.alias, binding.target)
  of PoolAliasBindingKind.Random:
    if binding.targets.len == 0:
      return
    var total = 0'u32
    for i in 0 ..< binding.targets.len:
      total += binding.targets[i].weight
    var picked = 0
    if total != 0'u32:
      var r = cast[uint32](nextBoundedI32(random, cast[int32](total)))
      for i in 0 ..< binding.targets.len:
        if r < binding.targets[i].weight:
          picked = i
          break
        r -= binding.targets[i].weight
    addDirect(l, binding.alias, binding.targets[picked].target)
  of PoolAliasBindingKind.RandomGroup:
    if binding.groups.len == 0:
      return
    var total = 0'u32
    for i in 0 ..< binding.groups.len:
      total += binding.groups[i].weight
    var picked = 0
    if total != 0'u32:
      var r = cast[uint32](nextBoundedI32(random, cast[int32](total)))
      for i in 0 ..< binding.groups.len:
        if r < binding.groups[i].weight:
          picked = i
          break
        r -= binding.groups[i].weight
    for i in 0 ..< binding.groups[picked].bindings.len:
      addBinding(l, binding.groups[picked].bindings[i], random)

proc poolAliasLookupFromBindings*(bindings: seq[PoolAliasBinding], random: var RandomGenerator): PoolAliasLookup =
  ## `PoolAliasLookup::from_bindings`
  result = PoolAliasLookup(aliases: initTable[string, string]())
  for i in 0 ..< bindings.len:
    addBinding(result, bindings[i], random)

proc lookup*(l: PoolAliasLookup, id: string): string =
  ## `PoolAliasLookup::lookup`
  result = id
  while l.aliases.hasKey(result):
    result = l.aliases.getOrDefault(result, "")

proc field(n: JsonValue, key: string, value: var JsonValue): bool =
  if n.kind != jvObject:
    return false
  let (found, v) = get(n, key)
  if found:
    value = v
  found

proc textOf(n: JsonValue, key: string): string =
  var v = jsonNull()
  if field(n, key, v) and v.kind == jvString: v.strVal else: ""

proc weightOf(n: JsonValue): uint32 =
  var v = jsonNull()
  if field(n, "weight", v) and v.kind == jvInt: uint32(v.intVal) else: 0'u32

proc parseBinding(n: JsonValue): PoolAliasBinding =
  ## What pumpkin-codegen's `PoolAliasBindingStruct` reads.
  case textOf(n, "type")
  of "minecraft:random":
    result = PoolAliasBinding(kind: PoolAliasBindingKind.Random, alias: textOf(n, "alias"))
    var targets = jsonNull()
    if field(n, "targets", targets) and targets.kind == jvArray:
      for i in 0 ..< targets.items.len:
        var data = jsonNull()
        if field(targets.items[i], "data", data) and data.kind == jvString:
          result.targets.add(WeightedPoolAliasTarget(target: data.strVal, weight: weightOf(targets.items[i])))
  of "minecraft:random_group":
    result = PoolAliasBinding(kind: PoolAliasBindingKind.RandomGroup)
    var groups = jsonNull()
    if field(n, "groups", groups) and groups.kind == jvArray:
      for i in 0 ..< groups.items.len:
        var group = WeightedPoolAliasGroup(weight: weightOf(groups.items[i]))
        var data = jsonNull()
        if field(groups.items[i], "data", data) and data.kind == jvArray:
          for j in 0 ..< data.items.len:
            group.bindings.add(parseBinding(data.items[j]))
        result.groups.add(group)
  else:
    result = PoolAliasBinding(kind: PoolAliasBindingKind.Direct, alias: textOf(n, "alias"), target: textOf(n, "target"))

proc anchorOf(n: JsonValue): YOffset =
  ## `{"absolute": n}`, `{"above_bottom": n}` or `{"below_top": n}`.
  var v = jsonNull()
  if field(n, "above_bottom", v) and v.kind == jvInt:
    return YOffset(kind: yokAboveBottom, aboveBottom: int8(v.intVal))
  if field(n, "below_top", v) and v.kind == jvInt:
    return YOffset(kind: yokBelowTop, belowTop: int8(v.intVal))
  if field(n, "absolute", v) and v.kind == jvInt:
    return YOffset(kind: yokAbsolute, absolute: int16(v.intVal))
  YOffset(kind: yokAbsolute, absolute: 0)

var
  structuresJsonRoot = jsonNull()
  structuresJsonReady = false

proc structureJson(key: StructureKeys, value: var JsonValue): bool =
  if not structuresJsonReady:
    structuresJsonReady = true
    let parsed = parseJsonValue(StructuresJson)
    if parsed.ok:
      structuresJsonRoot = parsed.value
  field(structuresJsonRoot, toName(key), value)

proc structurePoolAliases*(key: StructureKeys): seq[PoolAliasBinding] =
  ## `Structure::pool_aliases`
  result = @[]
  var s = jsonNull()
  var list = jsonNull()
  if structureJson(key, s) and field(s, "pool_aliases", list) and list.kind == jvArray:
    for i in 0 ..< list.items.len:
      result.add(parseBinding(list.items[i]))

proc sampleStartHeight(key: StructureKeys, context: var StructureGeneratorContext, y: var int32): bool =
  ## `Structure::start_height`, drawn from: false for `None`. A constant draws nothing, as vanilla's `ConstantHeight`.
  var s = jsonNull()
  var node = jsonNull()
  if not structureJson(key, s) or not field(s, "start_height", node):
    return false
  var minNode = jsonNull()
  var maxNode = jsonNull()
  if field(node, "min_inclusive", minNode) and field(node, "max_inclusive", maxNode):
    let provider = HeightProvider(kind: HeightProviderKind.Uniform, minInclusive: anchorOf(minNode), maxInclusive: anchorOf(maxNode))
    y = get(provider, context.random, int8(context.minY), uint16(context.height))
  else:
    y = getY(anchorOf(node), int16(context.minY), uint16(context.height))
  true

proc canFit*(f: FreeSpace, candidate: BlockBox): bool =
  ## `FreeSpace::can_fit`
  if not (candidate.min.x >= f.bounds.min.x and candidate.max.x <= f.bounds.max.x and candidate.min.y >= f.bounds.min.y and
      candidate.max.y <= f.bounds.max.y and candidate.min.z >= f.bounds.min.z and candidate.max.z <= f.bounds.max.z):
    return false
  for i in 0 ..< f.occupied.len:
    let b = f.occupied[i]
    if b.max.x >= candidate.min.x and b.min.x <= candidate.max.x and b.max.y >= candidate.min.y and b.min.y <= candidate.max.y and
        b.max.z >= candidate.min.z and b.min.z <= candidate.max.z:
      return false
  true

proc add(q: var PlacingQueue, state: PieceState, priority: int32) =
  ## `PlacingQueue::add`
  var at = 0
  while at < q.queues.len and q.queues[at].priority > priority:
    inc at
  if at == q.queues.len or q.queues[at].priority != priority:
    q.queues.add(PriorityQueue(priority: priority, items: @[], head: 0))
    var i = q.queues.len - 1
    while i > at:
      let moved = q.queues[i - 1]
      let later = q.queues[i]
      q.queues[i - 1] = later
      q.queues[i] = moved
      dec i
  q.queues[at].items.add(state)

proc hasNext(q: PlacingQueue): bool = q.queues.len > 0

proc next(q: var PlacingQueue): PieceState =
  ## `PlacingQueue::next`: an empty queue leaves the list, so the first one always has something.
  result = q.queues[0].items[q.queues[0].head]
  inc q.queues[0].head
  if q.queues[0].head == q.queues[0].items.len:
    q.queues.delete(0)

proc getJigsawBlocks*(t: StructureTemplate): seq[JigsawBlock] =
  result = newSeqOfCap[JigsawBlock](t.jigsawBlocks.len)
  for i in 0 ..< t.jigsawBlocks.len:
    let b = t.jigsawBlocks[i]
    let (ok, jigsaw) = jigsawFromTemplateBlock(t.blocks[b], t.palette[int(t.blocks[b].state)])
    if ok:
      result.add(jigsaw)

proc rotatePos*(pos: Vector3[int32], rotation: Rotation): Vector3[int32] =
  let (x, z) = rotateOffset(rotation, pos.x, pos.z)
  vec3[int32](x, pos.y, z)

proc rotatedBox*(origin: BlockPos, size: Vector3[int32], rotation: Rotation): BlockBox =
  let corner = rotatePos(vec3[int32](size.x - 1, size.y - 1, size.z - 1), rotation)
  newBlockBox(min(origin.x, origin.x + corner.x), origin.y, min(origin.z, origin.z + corner.z),
    max(origin.x, origin.x + corner.x), origin.y + corner.y, max(origin.z, origin.z + corner.z))

proc rotateDirection*(dir: BlockDirection, rotation: Rotation): BlockDirection =
  case rotation
  of Rotation.None:
    dir
  of Rotation.Clockwise90:
    case dir
    of North: East
    of East: South
    of South: West
    of West: North
    else: dir
  of Rotation.Rotate180:
    case dir
    of North: South
    of South: North
    of West: East
    of East: West
    else: dir
  of Rotation.CounterClockwise90:
    case dir
    of North: West
    of West: South
    of South: East
    of East: North
    else: dir

proc groundLevelDeltaOf(kind: PoolElementKind): int32 =
  case kind.tag
  of PoolElementKindTag.Single: 1'i32
  of PoolElementKindTag.List:
    if kind.elements.len > 0: groundLevelDeltaOf(kind.elements[0]) else: 1'i32
  of PoolElementKindTag.Feature, PoolElementKindTag.Empty: 0'i32

proc getGroundLevelDelta*(element: PoolElement): int32 = groundLevelDeltaOf(element.kind)

proc ySizeOf(kind: PoolElementKind, size: var int32): bool =
  ## `get_y_size`: false for `None`.
  case kind.tag
  of PoolElementKindTag.Single:
    let t = getTemplate(kind.templateName)
    if t == nil:
      return false
    size = t.size.y
    true
  of PoolElementKindTag.List:
    var found = false
    for i in 0 ..< kind.elements.len:
      var s = 0'i32
      if ySizeOf(kind.elements[i], s):
        size = if found: max(size, s) else: s
        found = true
    found
  of PoolElementKindTag.Feature:
    size = 1
    true
  of PoolElementKindTag.Empty:
    false

proc getMaxSize*(p: TemplatePool): int32 =
  ## `TemplatePool::get_max_size`
  result = 0'i32
  for i in 0 ..< p.elements.len:
    var s = 0'i32
    if ySizeOf(p.elements[i].kind, s):
      result = max(result, s)

proc boundingBoxOf(kind: PoolElementKind, offset: BlockPos, rotation: Rotation): BlockBox =
  let point = newBlockBox(offset.x, offset.y, offset.z, offset.x, offset.y, offset.z)
  case kind.tag
  of PoolElementKindTag.Single:
    let t = getTemplate(kind.templateName)
    if t == nil: point else: rotatedBox(offset, t.size, rotation)
  of PoolElementKindTag.List:
    var found = false
    var bbox = point
    for i in 0 ..< kind.elements.len:
      if kind.elements[i].tag == PoolElementKindTag.Empty:
        continue
      let b = boundingBoxOf(kind.elements[i], offset, rotation)
      if found:
        encompass(bbox, b)
      else:
        bbox = b
        found = true
    bbox
  of PoolElementKindTag.Feature, PoolElementKindTag.Empty:
    point

proc getBoundingBox*(element: PoolElement, offset: BlockPos, rotation: Rotation): BlockBox =
  boundingBoxOf(element.kind, offset, rotation)

proc shuffledJigsawsOf(kind: PoolElementKind, offset: BlockPos, rotation: Rotation, random: var RandomGenerator): seq[JigsawBlock] =
  result = @[]
  case kind.tag
  of PoolElementKindTag.Single:
    let t = getTemplate(kind.templateName)
    if t == nil:
      return
    result = getJigsawBlocks(t)
    var i = result.len - 1
    while i >= 1:
      let j = int(nextBoundedI32(random, int32(i) + 1))
      let a = result[i]
      let b = result[j]
      result[i] = b
      result[j] = a
      dec i
    # `sort_by_key(Reverse(selection_priority))`, which is stable.
    for a in 1 ..< result.len:
      let v = result[a]
      var b = a - 1
      while b >= 0 and result[b].selectionPriority < v.selectionPriority:
        let moved = result[b]
        result[b + 1] = moved
        dec b
      result[b + 1] = v
    for k in 0 ..< result.len:
      let rotatedPos = rotatePos(vec3[int32](result[k].pos.x, result[k].pos.y, result[k].pos.z), rotation)
      result[k].pos = blockPos(offset.x + rotatedPos.x, offset.y + rotatedPos.y, offset.z + rotatedPos.z)
      result[k].facing = rotateDirection(result[k].facing, rotation)
      result[k].up = rotateDirection(result[k].up, rotation)
  of PoolElementKindTag.List:
    if kind.elements.len > 0:
      result = shuffledJigsawsOf(kind.elements[0], offset, rotation, random)
  of PoolElementKindTag.Feature:
    result.add(JigsawBlock(pos: offset, name: "minecraft:bottom", target: "minecraft:empty", pool: "minecraft:empty",
      finalState: "minecraft:air", joint: JigsawJointType.Rollable, facing: Down, up: South, selectionPriority: 0,
      placementPriority: 0))
  of PoolElementKindTag.Empty:
    discard

proc getShuffledJigsawBlocks*(element: PoolElement, offset: BlockPos, rotation: Rotation, random: var RandomGenerator): seq[JigsawBlock] =
  shuffledJigsawsOf(element.kind, offset, rotation, random)

proc isStartTooCloseToWorldHeightLimits(minY, maxY: int32, dimensionPadding: DimensionPadding, centerPieceBb: BlockBox): bool =
  if dimensionPadding.top == 0 and dimensionPadding.bottom == 0:
    return false
  centerPieceBb.min.y < minY + dimensionPadding.bottom or centerPieceBb.max.y > maxY - dimensionPadding.top

proc canAttachBlocks(source, target: JigsawBlock): bool =
  ## `can_attach`: `target` is already rotated.
  if source.target != target.name:
    return false
  if opposite(source.facing) != target.facing:
    return false
  if source.joint == JigsawJointType.Aligned and source.up != target.up:
    return false
  true

proc sampleHeight(sampler: HeightSampler, pos: BlockPos): int32 =
  ## `height_sampler.as_mut().map_or(pos.y, |s| s.estimate_height(pos.x, pos.z))`
  if sampler == nil: pos.y else: estimateHeight(sampler, pos.x, pos.z)

proc tryPlacingChildren(placer: Placer, sourcePieceIdx: int, contextFree: FreeSpace, depth: int32, doExpansionHack: bool,
                        heightSampler: HeightSampler, random: var RandomGenerator, poolAliasLookup: PoolAliasLookup,
                        liquidSettings: LiquidSettings) =
  ## `Placer::try_placing_children`
  let sourceElement = placer.pieces[sourcePieceIdx].element
  let sourceBoxPosition = placer.pieces[sourcePieceIdx].pos
  let sourceRotation = placer.pieces[sourcePieceIdx].rotation
  let sourceProjection = sourceElement.projection
  let sourceRigid = sourceProjection == JigsawProjection.Rigid
  var sourceFree: FreeSpace = nil
  let sourceBb = placer.pieces[sourcePieceIdx].piece.boundingBox
  let sourceBoxY = sourceBb.min.y
  let sourceJigsaws = getShuffledJigsawBlocks(sourceElement, sourceBoxPosition, sourceRotation, random)

  for sj in 0 ..< sourceJigsaws.len:
    let sourceJigsaw = sourceJigsaws[sj]
    let sourceDirection = toVector(sourceJigsaw.facing)
    let sourceJigsawPos = sourceJigsaw.pos
    let targetJigsawPos = blockPos(sourceJigsawPos.x + sourceDirection.x, sourceJigsawPos.y + sourceDirection.y,
      sourceJigsawPos.z + sourceDirection.z)
    let sourceJigsawLocalY = sourceJigsawPos.y - sourceBoxY
    var sourceJigsawBaseHeight = int32.low

    let poolName = lookup(poolAliasLookup, sourceJigsaw.pool)
    if poolName == "minecraft:empty" or poolName.len == 0:
      continue
    let targetPool = discover(poolName)
    if targetPool == nil:
      continue
    if targetPool.elements.len == 0 and targetPool.id != "minecraft:empty":
      continue

    let fallbackPool = discover(lookup(poolAliasLookup, targetPool.fallback))

    let attachInsideSource = contains(sourceBb, targetJigsawPos.x, targetJigsawPos.y, targetJigsawPos.z)
    var childrenFree = contextFree
    if attachInsideSource:
      if sourceFree == nil:
        sourceFree = FreeSpace(bounds: sourceBb, occupied: @[])
      childrenFree = sourceFree

    var targetPieces: seq[PoolElement] = @[]
    if depth != placer.maxDepth:
      targetPieces = getShuffledElements(targetPool, random)
    if fallbackPool != nil:
      let fallbackElements = getShuffledElements(fallbackPool, random)
      for i in 0 ..< fallbackElements.len:
        targetPieces.add(fallbackElements[i])

    let placementPriority = sourceJigsaw.placementPriority

    block sourceJigsawDone:
      for ti in 0 ..< targetPieces.len:
        let targetElement = targetPieces[ti]
        if isEmpty(targetElement):
          break sourceJigsawDone

        var rotations = rotationValues()
        var ri = 3
        while ri >= 1:
          let j = int(nextBoundedI32(random, int32(ri) + 1))
          let a = rotations[ri]
          let b = rotations[j]
          rotations[ri] = b
          rotations[j] = a
          dec ri

        for rotIndex in 0 ..< 4:
          let targetRotation = rotations[rotIndex]
          let targetJigsaws = getShuffledJigsawBlocks(targetElement, blockPos(0, 0, 0), targetRotation, random)
          let hackBox = getBoundingBox(targetElement, blockPos(0, 0, 0), targetRotation)
          let hackBoxYSpan = hackBox.max.y - hackBox.min.y + 1

          var expandTo = 0'i32
          if doExpansionHack and hackBoxYSpan <= 16:
            for hi in 0 ..< targetJigsaws.len:
              let facing = toVector(targetJigsaws[hi].facing)
              let relative = targetJigsaws[hi].pos
              if not contains(hackBox, relative.x + facing.x, relative.y + facing.y, relative.z + facing.z):
                continue
              let childPool = discover(lookup(poolAliasLookup, targetJigsaws[hi].pool))
              var childPoolSize = 0'i32
              var childFallbackSize = 0'i32
              if childPool != nil:
                childPoolSize = getMaxSize(childPool)
                let childFallback = discover(lookup(poolAliasLookup, childPool.fallback))
                if childFallback != nil:
                  childFallbackSize = getMaxSize(childFallback)
              expandTo = max(expandTo, max(childPoolSize, childFallbackSize))

          for tj in 0 ..< targetJigsaws.len:
            let targetJigsaw = targetJigsaws[tj]
            if not canAttachBlocks(sourceJigsaw, targetJigsaw):
              continue
            let targetJigsawLocalPos = targetJigsaw.pos
            let rawTargetBoxPos = blockPos(targetJigsawPos.x - targetJigsawLocalPos.x, targetJigsawPos.y - targetJigsawLocalPos.y,
              targetJigsawPos.z - targetJigsawLocalPos.z)
            let rawTargetBb = getBoundingBox(targetElement, rawTargetBoxPos, targetRotation)
            let rawTargetY = rawTargetBb.min.y
            let targetProjection = targetElement.projection
            let targetRigid = targetProjection == JigsawProjection.Rigid
            let targetJigsawLocalY = targetJigsawLocalPos.y
            let deltaY = sourceJigsawLocalY - targetJigsawLocalY + sourceDirection.y

            var targetBoxY = 0'i32
            if sourceRigid and targetRigid:
              targetBoxY = sourceBoxY + deltaY
            else:
              if sourceJigsawBaseHeight == int32.low:
                sourceJigsawBaseHeight = sampleHeight(heightSampler, sourceJigsawPos)
              targetBoxY = sourceJigsawBaseHeight - targetJigsawLocalY

            let yOffset = targetBoxY - rawTargetY
            var targetBb = rawTargetBb
            movePos(targetBb, 0, yOffset, 0)
            let targetBoxPosition = blockPos(rawTargetBoxPos.x, rawTargetBoxPos.y + yOffset, rawTargetBoxPos.z)

            if expandTo > 0:
              let newSize = max(expandTo + 1, targetBb.max.y - targetBb.min.y)
              targetBb.max.y = targetBb.min.y + newSize

            if canFit(childrenFree, targetBb):
              childrenFree.occupied.add(targetBb)

              let sourceGroundLevelDelta = placer.pieces[sourcePieceIdx].groundLevelDelta
              let targetGroundLevelDelta =
                if targetRigid: sourceGroundLevelDelta - deltaY else: getGroundLevelDelta(targetElement)

              let targetPiece = newPoolElementStructurePiece(targetBb, uint32(depth) + 1'u32, targetElement, targetBoxPosition,
                targetRotation, @[], targetGroundLevelDelta, liquidSettings, targetProjection)

              var junctionY = 0'i32
              if sourceRigid:
                junctionY = sourceBoxY + sourceJigsawLocalY
              elif targetRigid:
                junctionY = targetBoxY + targetJigsawLocalY
              else:
                if sourceJigsawBaseHeight == int32.low:
                  sourceJigsawBaseHeight = sampleHeight(heightSampler, sourceJigsawPos)
                junctionY = sourceJigsawBaseHeight + deltaY div 2

              addJunction(placer.pieces[sourcePieceIdx], JigsawJunction(sourceX: targetJigsawPos.x,
                sourceGroundY: junctionY - sourceJigsawLocalY + sourceGroundLevelDelta, sourceZ: targetJigsawPos.z,
                deltaY: deltaY, projection: targetProjection))
              addJunction(targetPiece, JigsawJunction(sourceX: sourceJigsawPos.x,
                sourceGroundY: junctionY - targetJigsawLocalY + targetGroundLevelDelta, sourceZ: sourceJigsawPos.z,
                deltaY: -deltaY, projection: sourceProjection))

              let targetPieceIdx = placer.pieces.len
              placer.pieces.add(targetPiece)

              if depth < placer.maxDepth:
                add(placer.placing, PieceState(pieceIdx: targetPieceIdx, free: childrenFree, depth: depth + 1), placementPriority)

              break sourceJigsawDone

proc addPieces*(context: var StructureGeneratorContext, startPoolId: string, hasStartJigsaw: bool, startJigsaw: string,
                maxDepthIn: int32, position: BlockPos, doExpansionHack, projectStartToHeightmap: bool,
                maxDistanceFromCenter: MaxDistance, dimensionPadding: DimensionPadding, liquidSettings: LiquidSettings,
                poolAliasLookup: PoolAliasLookup): StructurePosition =
  ## `JigsawPlacement::add_pieces`
  if maxDistanceFromCenter.horizontal > MaxTotalStructureRange:
    return nil

  let maxDepth = max(MinDepth, min(maxDepthIn, MaxDepth))

  let pool = discover(lookup(poolAliasLookup, startPoolId))
  if pool == nil:
    return nil
  let centerRotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let centerElement = getRandomElement(pool, context.random)
  if isEmpty(centerElement):
    return nil

  var localAnchorPosition = vec3[int32](0, 0, 0)
  var adjustedPosition = position
  if hasStartJigsaw:
    var foundAnchor = false
    let centerJigsaws = getShuffledJigsawBlocks(centerElement, position, centerRotation, context.random)
    for i in 0 ..< centerJigsaws.len:
      if centerJigsaws[i].name == startJigsaw:
        localAnchorPosition = vec3[int32](centerJigsaws[i].pos.x - position.x, centerJigsaws[i].pos.y - position.y,
          centerJigsaws[i].pos.z - position.z)
        foundAnchor = true
        break
    if not foundAnchor:
      return nil
    adjustedPosition = blockPos(position.x - localAnchorPosition.x, position.y - localAnchorPosition.y,
      position.z - localAnchorPosition.z)

  var box = getBoundingBox(centerElement, adjustedPosition, centerRotation)

  let centerX = midpointI32(box.max.x, box.min.x)
  let centerZ = midpointI32(box.max.z, box.min.z)

  let bottomY =
    if projectStartToHeightmap:
      position.y + (if context.heightSampler == nil: 0'i32 else: estimateHeight(context.heightSampler, centerX, centerZ))
    else:
      adjustedPosition.y

  let groundLevelDelta = getGroundLevelDelta(centerElement)
  let oldAbsoluteGroundY = box.min.y + groundLevelDelta
  let yOffset = bottomY - oldAbsoluteGroundY
  movePos(box, 0, yOffset, 0)
  let piecePos = blockPos(adjustedPosition.x, adjustedPosition.y + yOffset, adjustedPosition.z)

  let maxY = context.minY + context.height - 1
  if isStartTooCloseToWorldHeightLimits(context.minY, maxY, dimensionPadding, box):
    return nil

  let centerY = bottomY + localAnchorPosition.y

  let globalBoundingBox = newBlockBox(centerX - maxDistanceFromCenter.horizontal,
    max(centerY - maxDistanceFromCenter.vertical, context.minY + dimensionPadding.bottom),
    centerZ - maxDistanceFromCenter.horizontal, centerX + maxDistanceFromCenter.horizontal,
    min(centerY + maxDistanceFromCenter.vertical, maxY - dimensionPadding.top),
    centerZ + maxDistanceFromCenter.horizontal)

  let centerPiece = newPoolElementStructurePiece(box, 0'u32, centerElement, piecePos, centerRotation, @[], groundLevelDelta,
    liquidSettings, centerElement.projection)

  let collector = newStructurePiecesCollector()
  if maxDepth > 0:
    let globalFree = FreeSpace(bounds: globalBoundingBox, occupied: @[box])
    let placer = Placer(maxDepth: maxDepth, pieces: @[centerPiece], placing: PlacingQueue(queues: @[]))
    tryPlacingChildren(placer, 0, globalFree, 0, doExpansionHack, context.heightSampler, context.random, poolAliasLookup,
      liquidSettings)
    while hasNext(placer.placing):
      let state = next(placer.placing)
      tryPlacingChildren(placer, state.pieceIdx, state.free, state.depth, doExpansionHack, context.heightSampler, context.random,
        poolAliasLookup, liquidSettings)
    for i in 0 ..< placer.pieces.len:
      addPiece(collector, placer.pieces[i])
  else:
    addPiece(collector, centerPiece)

  StructurePosition(startPos: blockPos(centerX, centerY, centerZ), collector: collector)

proc newJigsawGenerator*(startPool: string, size: int32): JigsawGenerator =
  JigsawGenerator(startPool: startPool, size: size, hasStartJigsawName: false, startJigsawName: "", useExpansionHack: false)

proc withStartJigsaw*(g: JigsawGenerator, name: string): JigsawGenerator =
  result = g
  result.hasStartJigsawName = true
  result.startJigsawName = name

proc withExpansionHack*(g: JigsawGenerator, useHack: bool): JigsawGenerator =
  result = g
  result.useExpansionHack = useHack

proc getStructurePosition*(g: JigsawGenerator, context: var StructureGeneratorContext): StructurePosition =
  ## `<JigsawGenerator as StructureGenerator>::get_structure_position_checked`, less the biome test: `structuremod` makes that
  ## on the finished position, which comes to the same start because the placer's draws do not affect it.
  var startY = context.seaLevel
  var projectStartToHeightmap = false
  var maxDistance = 80'i32
  var liquidSettings = LiquidSettings.ApplyWaterlog
  var dimensionPadding = DimensionPadding(top: 0, bottom: 0)
  var useExpansionHack = g.useExpansionHack
  var hasStartJigsaw = g.hasStartJigsawName
  var startJigsaw = g.startJigsawName
  var aliases: seq[PoolAliasBinding] = @[]
  if context.hasStructureKey:
    let s = structures.get(context.structureKey)
    discard sampleStartHeight(context.structureKey, context, startY)
    projectStartToHeightmap = s.hasProjectStartToHeightmap
    if s.hasMaxDistanceFromCenter:
      maxDistance = s.maxDistanceFromCenter
    if s.hasLiquidSettings and s.liquidSettings == "ignore_waterlogging":
      liquidSettings = LiquidSettings.IgnoreWaterlogDone
    if s.hasDimensionPadding:
      dimensionPadding = DimensionPadding(top: s.dimensionPadding, bottom: s.dimensionPadding)
    if s.hasUseExpansionHack and s.useExpansionHack:
      useExpansionHack = true
    if not hasStartJigsaw and s.hasStartJigsawName:
      hasStartJigsaw = true
      startJigsaw = s.startJigsawName
    aliases = structurePoolAliases(context.structureKey)
  let startPos = blockPos(startBlockX(context.chunkX), startY, startBlockZ(context.chunkZ))
  # `LegacyRand::from_seed(seed).next_splitter().split_pos(start)`: vanilla's `PoolAliasLookup.create`.
  var seeder = toRandomGenerator(legacy_rand.fromSeed(cast[uint64](context.seed)))
  let splitter = nextSplitter(seeder)
  var aliasRandom = splitPos(splitter, startPos.x, startPos.y, startPos.z)
  let poolAliasLookup = poolAliasLookupFromBindings(aliases, aliasRandom)
  addPieces(context, g.startPool, hasStartJigsaw, startJigsaw, g.size, startPos, useExpansionHack, projectStartToHeightmap,
    newMaxDistance(maxDistance), dimensionPadding, liquidSettings, poolAliasLookup)
