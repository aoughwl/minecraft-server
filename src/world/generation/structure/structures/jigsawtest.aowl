## Upstream's tests of jigsaw.rs. `pillager_outpost_builds_the_vanilla_jigsaw_graph` is a known answer from vanilla.
## Port of pumpkin-world/src/generation/structure/structures/jigsaw.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/options
import std/strutils
import std/syncio
import ../../../../generated/structures
import ../../../../generated/dimension
import "../template/templatemod"

import ../../generator/generator
import ../height_sampler
import structuresmod
import jigsaw_placement

proc checkPool(id: string, elementCount: int, totalWeight: uint32) =
  let pool = discover(id)
  assert pool != nil, id
  assert pool.elements.len == elementCount, id
  var total = 0'u32
  for i in 0 ..< pool.elements.len:
    total += pool.elements[i].weight
  assert total == totalWeight, id
  assert pool.fallback == "minecraft:empty", id

block ancientCityPoolsMatchVanillaWeights:
  checkPool("minecraft:ancient_city/city_center", 3, 3)
  checkPool("minecraft:ancient_city/sculk", 2, 7)
  checkPool("minecraft:ancient_city/structures", 20, 46)
  checkPool("minecraft:ancient_city/walls", 16, 27)
  checkPool("minecraft:ancient_city/city/entrance", 6, 6)
  checkPool("minecraft:ancient_city/city_center/walls", 10, 10)
  checkPool("minecraft:ancient_city/walls/no_corners", 8, 8)
  let base = discover("minecraft:pillager_outpost/base_plates")
  assert base.elements[0].kind.tag == PoolElementKindTag.Single and base.elements[0].kind.legacy

block ancientCityStartTemplatesAndAnchorExist:
  let pool = discover("minecraft:ancient_city/city_center")
  for i in 0 ..< pool.elements.len:
    let t = firstTemplate(pool.elements[i])
    assert t != nil, "missing start template"
    var found = false
    let jigsaws = getJigsawBlocks(t)
    for j in 0 ..< jigsaws.len:
      if jigsaws[j].name == "minecraft:city_anchor":
        found = true
    assert found, "start template has no city_anchor"

proc checkEmbedded(kind: PoolElementKind) =
  case kind.tag
  of PoolElementKindTag.Single:
    # This entry exists in vanilla's pool data but has no corresponding template in the vanilla server jar.
    if kind.templateName == "minecraft:ancient_city/walls/intact_horizontal_wall_stairs_5":
      assert getTemplate(kind.templateName) == nil
    else:
      assert getTemplate(kind.templateName) != nil, "missing template " & kind.templateName
  of PoolElementKindTag.List:
    for i in 0 ..< kind.elements.len:
      checkEmbedded(kind.elements[i])
  of PoolElementKindTag.Empty, PoolElementKindTag.Feature:
    discard

block ancientCityPoolTemplatesAreEmbedded:
  let ids = @["minecraft:ancient_city/city_center", "minecraft:ancient_city/structures", "minecraft:ancient_city/walls",
      "minecraft:ancient_city/city/entrance", "minecraft:ancient_city/city_center/walls", "minecraft:ancient_city/walls/no_corners"]
  for ii in 0 ..< ids.len:
    let pool = discover(ids[ii])
    for i in 0 ..< pool.elements.len:
      checkEmbedded(pool.elements[i].kind)

block ancientCityBuildsAMultiPieceGraph:
  let generator = withStartJigsaw(newJigsawGenerator("minecraft:ancient_city/city_center", 7), "minecraft:city_anchor")
  var context = newContext(0'i64, 0, 0, 63, -64, nil, StructureKeys.AncientCity)
  let position = getStructurePosition(generator, context)
  assert position != nil, "ancient city graph should generate"
  assert position.collector.pieces.len > 10, "ancient city generated only " & $position.collector.pieces.len & " pieces"
  assert position.startPos.y == -27

block pillagerOutpostPoolsMatchVanilla:
  checkPool("minecraft:pillager_outpost/base_plates", 1, 1)
  checkPool("minecraft:pillager_outpost/towers", 1, 1)
  checkPool("minecraft:pillager_outpost/feature_plates", 1, 1)
  checkPool("minecraft:pillager_outpost/features", 8, 13)

block pillagerOutpostTemplatesAndCagedMobsAreEmbedded:
  let names = @["base_plate", "watchtower", "watchtower_overgrown", "feature_plate", "feature_cage1", "feature_cage2",
      "feature_cage_with_allays", "feature_logs", "feature_tent1", "feature_tent2", "feature_targets"]
  for ni in 0 ..< names.len:
    assert getTemplate("minecraft:pillager_outpost/" & names[ni]) != nil, names[ni]
  let cage = getTemplate("minecraft:pillager_outpost/feature_cage1")
  assert cage.entities.len == 1
  assert get(getString(cage.entities[0].nbt, "id")) == "minecraft:iron_golem"
  let allayCage = getTemplate("minecraft:pillager_outpost/feature_cage_with_allays")
  assert allayCage.entities.len == 2
  for i in 0 ..< allayCage.entities.len:
    assert get(getString(allayCage.entities[i].nbt, "id")) == "minecraft:allay"

block pillagerOutpostBuildsTheVanillaJigsawGraph:
  let Seed = 1782124772053846960'i64
  let worldGen = getWorldGen(cast[uint64](Seed), OVERWORLD, false, @[], "")
  let heightSampler = newNoiseHeightSampler(worldGen.noise, 1200, -1312)
  let generator = withExpansionHack(newJigsawGenerator("minecraft:pillager_outpost/base_plates", 7), true)
  var context = newContext(Seed, 75, -82, 63, -64, heightSampler, StructureKeys.PillagerOutpost)
  let position = getStructurePosition(generator, context)
  assert position != nil, "pillager outpost graph should generate"
  var featurePlates = 0
  var allayCages = 0
  for i in 0 ..< position.collector.pieces.len:
    let piece = cast[PoolElementStructurePiece](position.collector.pieces[i])
    let visits = forEachTemplate(piece.element)
    for vi in 0 ..< visits.len:
      if endsWith(visits[vi].name, "/feature_plate"):
        inc featurePlates
      if endsWith(visits[vi].name, "/feature_cage_with_allays"):
        inc allayCages
  assert featurePlates == 3, $featurePlates
  assert allayCages == 2, $allayCages
  assert position.startPos.y == 69, $position.startPos.y
  let b = getBoundingBox(position)
  assert b.min.x == 1169 and b.min.y == 68 and b.min.z == -1343, $b.min.x & " " & $b.min.y & " " & $b.min.z
  assert b.max.x == 1216 and b.max.y == 97 and b.max.z == -1296, $b.max.x & " " & $b.max.y & " " & $b.max.z

echo "jigsaw: ok"
