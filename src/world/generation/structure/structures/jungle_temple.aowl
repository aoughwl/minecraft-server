## Port of pumpkin-world/src/generation/structure/structures/jungle_temple.rs
##
## Upstream leaves the dispensers and chests commented out, and so does this.

{.feature: "lenientnils".}

import structuresmod

const
  Width* = 12'i32
  Depth* = 15'i32

type
  JungleTemplePiece = ref object of StructurePieceBase
    heightAdjusted: bool
    placedMainChest, placedHiddenChest, placedTrap1, placedTrap2: bool

iterator stepRange(a, b, step: int32): int32 =
  var i = a
  while i <= b:
    yield i
    i += step

proc adjustHeight(s: JungleTemplePiece, chunk: ProtoChunk, random: var RandomGenerator): bool =
  if s.heightAdjusted:
    return true
  let groundOffset = -nextBoundedI32(random, 3)
  let bb = s.piece.boundingBox
  var lowest = int32.high
  var z = bb.min.z
  while z <= bb.max.z:
    var x = bb.min.x
    while x <= bb.max.x:
      lowest = min(lowest, getTopY(chunk, MotionBlockingNoLeaves, x, z))
      inc x
    inc z
  if lowest == int32.high:
    return false
  let shiftY = lowest - s.piece.boundingBox.min.y + groundOffset
  movePos(s.piece.boundingBox, 0, shiftY, 0)
  s.heightAdjusted = true
  true

proc mossStoneNext(random: var RandomGenerator): BlockStateId =
  ## `MossStoneSelector::next`
  if nextF32(random) < 0.4'f32: blockState("cobblestone") else: blockState("mossy_cobblestone")

proc cobblestoneStairs(facing: string): BlockStateId =
  stateWith("cobblestone_stairs", [("facing", facing)])

proc redstoneWireBidirectional(facingOne, facingTwo: string): BlockStateId =
  if facingOne == facingTwo:
    stateWith("redstone_wire", [(facingOne, "side")])
  else:
    stateWith("redstone_wire", [(facingOne, "side"), (facingTwo, "side")])

proc attachedTripwireBidirectional(facingOne, facingTwo: string): BlockStateId =
  stateWith("tripwire", [(facingOne, "true"), (facingTwo, "true"), ("attached", "true")])

proc stickyPistonFacing(facing: string): BlockStateId =
  stateWith("sticky_piston", [("facing", facing)])

proc vineFacing(facing: string): BlockStateId =
  if facing == "down": blockState("vine") else: stateWith("vine", [(facing, "true")])

proc attachedTripwireHookFacing(facing: string): BlockStateId =
  stateWith("tripwire_hook", [("facing", facing), ("attached", "true")])

proc placeJungleTemple(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[JungleTemplePiece](self)
  if not adjustHeight(s, chunk, random):
    return
  let p = s.piece
  let bb = chunkBox
  fill(p, chunk, bb, 0, -4, 0, Width - 1, 0, Depth - 1, mossStoneNext(random))
  s.piece .fill(chunk, bb, 2, 1, 2, 9, 2, 2, mossStoneNext(random))
  fill(p, chunk, bb, 2, 1, 12, 9, 2, 12, mossStoneNext(random))
  fill(p, chunk, bb, 2, 1, 3, 2, 2, 11, mossStoneNext(random))
  fill(p, chunk, bb, 9, 1, 3, 9, 2, 11, mossStoneNext(random))
  fill(p, chunk, bb, 1, 3, 1, 10, 6, 1, mossStoneNext(random))
  fill(p, chunk, bb, 1, 3, 13, 10, 6, 13, mossStoneNext(random))
  fill(p, chunk, bb, 1, 3, 2, 1, 6, 12, mossStoneNext(random))
  fill(p, chunk, bb, 10, 3, 2, 10, 6, 12, mossStoneNext(random))
  fill(p, chunk, bb, 2, 3, 2, 9, 3, 12, mossStoneNext(random))
  fill(p, chunk, bb, 2, 6, 2, 9, 6, 12, mossStoneNext(random))
  fill(p, chunk, bb, 3, 7, 3, 8, 7, 11, mossStoneNext(random))
  fill(p, chunk, bb, 4, 8, 4, 7, 8, 10, mossStoneNext(random))
  let a = blockState("air")
  fill(p, chunk, bb, 3, 1, 3, 8, 2, 11, a)
  fill(p, chunk, bb, 4, 3, 6, 7, 3, 9, a)
  fill(p, chunk, bb, 2, 4, 2, 9, 5, 12, a)
  fill(p, chunk, bb, 4, 6, 5, 7, 6, 9, a)
  fill(p, chunk, bb, 5, 7, 6, 6, 7, 8, a)
  fill(p, chunk, bb, 5, 1, 2, 6, 2, 2, a)
  fill(p, chunk, bb, 5, 2, 12, 6, 2, 12, a)
  fill(p, chunk, bb, 5, 5, 1, 6, 5, 1, a)
  fill(p, chunk, bb, 5, 5, 13, 6, 5, 13, a)
  addBlock(p, chunk, a, 1, 5, 5, bb)
  addBlock(p, chunk, a, 10, 5, 5, bb)
  addBlock(p, chunk, a, 1, 5, 9, bb)
  addBlock(p, chunk, a, 10, 5, 9, bb)
  for z in stepRange(int32(0), int32(14), int32(14)):
    s.piece .fill(chunk, bb, 2, 4, z, 2, 5, z, mossStoneNext(random))
    s.piece .fill(chunk, bb, 4, 4, z, 4, 5, z, mossStoneNext(random))
    s.piece .fill(chunk, bb, 7, 4, z, 7, 5, z, mossStoneNext(random))
    s.piece .fill(chunk, bb, 9, 4, z, 9, 5, z, mossStoneNext(random))
  s.piece .fill(chunk, bb, 5, 6, 0, 6, 6, 0, mossStoneNext(random))
  for x in stepRange(int32(0), int32(11), int32(11)):
    for z in stepRange(int32(2), int32(12), int32(2)):
      s.piece .fill(chunk, bb, x, 4, z, x, 5, z, mossStoneNext(random))
    s.piece .fill(chunk, bb, x, 6, 5, x, 6, 5, mossStoneNext(random))
    s.piece .fill(chunk, bb, x, 6, 9, x, 6, 9, mossStoneNext(random))
  s.piece .fill(chunk, bb, 2, 7, 2, 2, 9, 2, mossStoneNext(random))
  s.piece .fill(chunk, bb, 9, 7, 2, 9, 9, 2, mossStoneNext(random))
  fill(p, chunk, bb, 2, 7, 12, 2, 9, 12, mossStoneNext(random))
  fill(p, chunk, bb, 9, 7, 12, 9, 9, 12, mossStoneNext(random))
  s.piece .fill(chunk, bb, 4, 9, 4, 4, 9, 4, mossStoneNext(random))
  s.piece .fill(chunk, bb, 7, 9, 4, 7, 9, 4, mossStoneNext(random))
  fill(p, chunk, bb, 4, 9, 10, 4, 9, 10, mossStoneNext(random))
  fill(p, chunk, bb, 7, 9, 10, 7, 9, 10, mossStoneNext(random))
  s.piece .fill(chunk, bb, 5, 9, 7, 6, 9, 7, mossStoneNext(random))
  let eastStairs = cobblestoneStairs("east")
  let westStairs = cobblestoneStairs("west")
  let southStairs = cobblestoneStairs("south")
  let northStairs = cobblestoneStairs("north")
  addBlock(p, chunk, northStairs, 5, 9, 6, bb)
  addBlock(p, chunk, northStairs, 6, 9, 6, bb)
  addBlock(p, chunk, southStairs, 5, 9, 8, bb)
  addBlock(p, chunk, southStairs, 6, 9, 8, bb)
  addBlock(p, chunk, northStairs, 4, 0, 0, bb)
  addBlock(p, chunk, northStairs, 5, 0, 0, bb)
  addBlock(p, chunk, northStairs, 6, 0, 0, bb)
  addBlock(p, chunk, northStairs, 7, 0, 0, bb)
  addBlock(p, chunk, northStairs, 4, 1, 8, bb)
  addBlock(p, chunk, northStairs, 4, 2, 9, bb)
  addBlock(p, chunk, northStairs, 4, 3, 10, bb)
  addBlock(p, chunk, northStairs, 7, 1, 8, bb)
  addBlock(p, chunk, northStairs, 7, 2, 9, bb)
  addBlock(p, chunk, northStairs, 7, 3, 10, bb)
  s.piece .fill(chunk, bb, 4, 1, 9, 4, 1, 9, mossStoneNext(random))
  s.piece .fill(chunk, bb, 7, 1, 9, 7, 1, 9, mossStoneNext(random))
  fill(p, chunk, bb, 4, 1, 10, 7, 2, 10, mossStoneNext(random))
  s.piece .fill(chunk, bb, 5, 4, 5, 6, 4, 5, mossStoneNext(random))
  addBlock(p, chunk, eastStairs, 4, 4, 5, bb)
  addBlock(p, chunk, westStairs, 7, 4, 5, bb)
  for i in int32(0) ..< int32(4):
    s.piece .addBlock(chunk, southStairs, 5, 0 - i, 6 + i, bb)
    s.piece .addBlock(chunk, southStairs, 6, 0 - i, 6 + i, bb)
    s.piece .fill(chunk, bb, 5, 0 - i, 7 + i, 6, 0 - i, 9 + i, a)
  fill(p, chunk, bb, 1, -3, 12, 10, -1, 13, a)
  fill(p, chunk, bb, 1, -3, 1, 3, -1, 13, a)
  fill(p, chunk, bb, 1, -3, 1, 9, -1, 5, a)
  for z in stepRange(int32(1), int32(13), int32(2)):
    fill(p, chunk, bb, 1, -3, z, 1, -2, z, mossStoneNext(random))
  for z in stepRange(int32(2), int32(12), int32(2)):
    fill(p, chunk, bb, 1, -1, z, 3, -1, z, mossStoneNext(random))
  fill(p, chunk, bb, 2, -2, 1, 5, -2, 1, mossStoneNext(random))
  fill(p, chunk, bb, 7, -2, 1, 9, -2, 1, mossStoneNext(random))
  fill(p, chunk, bb, 6, -3, 1, 6, -3, 1, mossStoneNext(random))
  fill(p, chunk, bb, 6, -1, 1, 6, -1, 1, mossStoneNext(random))
  addBlock(p, chunk, attachedTripwireHookFacing("east"), 1, -3, 8, bb)
  addBlock(p, chunk, attachedTripwireHookFacing("west"), 4, -3, 8, bb)
  addBlock(p, chunk, redstoneWireBidirectional("east", "west"), 2, -3, 8, bb)
  addBlock(p, chunk, attachedTripwireBidirectional("east", "west"), 3, -3, 8, bb)
  let redstoneWireNs = redstoneWireBidirectional("north", "south")
  addBlock(p, chunk, redstoneWireNs, 5, -3, 7, bb)
  addBlock(p, chunk, redstoneWireNs, 5, -3, 6, bb)
  addBlock(p, chunk, redstoneWireNs, 5, -3, 5, bb)
  addBlock(p, chunk, redstoneWireNs, 5, -3, 4, bb)
  addBlock(p, chunk, redstoneWireNs, 5, -3, 3, bb)
  addBlock(p, chunk, redstoneWireNs, 5, -3, 2, bb)
  addBlock(p, chunk, redstoneWireBidirectional("north", "west"), 5, -3, 1, bb)
  addBlock(p, chunk, redstoneWireBidirectional("east", "west"), 4, -3, 1, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 3, -3, 1, bb)
  s.piece .addBlock(chunk, vineFacing("south"), 3, -2, 2, bb)
  addBlock(p, chunk, attachedTripwireHookFacing("north"), 7, -3, 1, bb)
  addBlock(p, chunk, attachedTripwireHookFacing("south"), 7, -3, 5, bb)
  addBlock(p, chunk, attachedTripwireBidirectional("north", "south"), 7, -3, 2, bb)
  addBlock(p, chunk, attachedTripwireBidirectional("north", "south"), 7, -3, 3, bb)
  addBlock(p, chunk, attachedTripwireBidirectional("north", "south"), 7, -3, 4, bb)
  addBlock(p, chunk, redstoneWireBidirectional("east", "west"), 8, -3, 6, bb)
  addBlock(p, chunk, redstoneWireBidirectional("west", "south"), 9, -3, 6, bb)
  let rState0 = stateWith("redstone_wire", [("south", "up"), ("north", "side")])
  addBlock(p, chunk, rState0, 9, -3, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 9, -3, 4, bb)
  addBlock(p, chunk, redstoneWireNs, 9, -2, 4, bb)
  s.piece .addBlock(chunk, vineFacing("east"), 8, -1, 3, bb)
  s.piece .addBlock(chunk, vineFacing("east"), 8, -2, 3, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 9, -3, 2, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 8, -3, 1, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 4, -3, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 5, -2, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 5, -1, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 6, -3, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 7, -2, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 7, -1, 5, bb)
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 8, -3, 5, bb)
  fill(p, chunk, bb, 9, -1, 1, 9, -1, 5, mossStoneNext(random))
  fill(p, chunk, bb, 8, -3, 8, 10, -1, 10, a)
  addBlock(p, chunk, blockState("chiseled_stone_bricks"), 8, -2, 11, bb)
  addBlock(p, chunk, blockState("chiseled_stone_bricks"), 9, -2, 11, bb)
  addBlock(p, chunk, blockState("chiseled_stone_bricks"), 10, -2, 11, bb)
  let lever = stateWith("lever", [("facing", "north"), ("face", "wall")])
  addBlock(p, chunk, lever, 8, -2, 12, bb)
  addBlock(p, chunk, lever, 9, -2, 12, bb)
  addBlock(p, chunk, lever, 10, -2, 12, bb)
  fill(p, chunk, bb, 8, -3, 8, 8, -3, 10, mossStoneNext(random))
  fill(p, chunk, bb, 10, -3, 8, 10, -3, 10, mossStoneNext(random))
  s.piece .addBlock(chunk, blockState("mossy_cobblestone"), 10, -2, 9, bb)
  addBlock(p, chunk, redstoneWireNs, 8, -2, 9, bb)
  addBlock(p, chunk, redstoneWireNs, 8, -2, 10, bb)
  let rState = stateWith("redstone_wire", [("south", "up"), ("north", "side"), ("east", "side"), ("west", "side")])
  addBlock(p, chunk, rState, 9, -3, 5, bb)
  addBlock(p, chunk, rState, 10, -1, 9, bb)
  s.piece .addBlock(chunk, stickyPistonFacing("up"), 9, -2, 8, bb)
  addBlock(p, chunk, stickyPistonFacing("west"), 10, -2, 8, bb)
  addBlock(p, chunk, stickyPistonFacing("west"), 10, -1, 8, bb)
  let repeaterState = stateWith("repeater", [("facing", "north")])
  addBlock(p, chunk, repeaterState, 10, -2, 10, bb)

proc jungleTemplePosition*(context: var StructureGeneratorContext): StructurePosition =
  let x = startBlockX(context.chunkX)
  let z = startBlockZ(context.chunkZ)
  let facing = getRandomHorizontalDirection(context.random)
  let piece = JungleTemplePiece(piece: newStructurePiece(StructurePieceType.JungleTemple, createBox(BlockBox, x, 64, z, getAxis(facing), Width, 10, Depth), 0), placeFn: placeJungleTemple, heightAdjusted: false, placedMainChest: true, placedHiddenChest: true, placedTrap1: true, placedTrap2: true)
  setFacing(piece.piece, facing)
  singlePiecePosition(piece, x + (Width div 2), 64, z + (Depth div 2))
