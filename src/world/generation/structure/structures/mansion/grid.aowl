## Port of pumpkin-world/src/generation/structure/structures/mansion/grid.rs
##
## `Direction` from mansion/mod.rs is here too: this file needs it and sits below mansion.aowl.

{.feature: "lenientnils".}

import ../structuresmod

const
  Corridor* = 1'i32
  Room* = 2'i32
  StartRoom* = 3'i32
  TestRoom = 4'i32
  Blocked = 5'i32

  Room1x1* = 0x1_0000'i32
  Room1x2* = 0x2_0000'i32
  Room2x2* = 0x4_0000'i32
  RoomOriginFlag* = 0x10_0000'i32
  RoomDoorFlag* = 0x20_0000'i32
  RoomStairsFlag* = 0x40_0000'i32
  RoomCorridorFlag* = 0x80_0000'i32
  RoomTypeMask* = 0xF_0000'i32
  RoomIdMask* = 0xFFFF'i32

  GridSize = 11
  GridArea = GridSize * GridSize

type
  Direction* {.pure.} = enum
    North, South, West, East, Up

  SimpleGrid* = ref object
    cells: seq[int32]
    outside: int32

  MansionGrid* = ref object
    base*: SimpleGrid
    thirdFloor*: SimpleGrid
    floorRooms*: seq[SimpleGrid]
    entranceX*, entranceY*: int32

const DirectionHorizontal* = [Direction.North, Direction.East, Direction.South, Direction.West]

proc directionFrom2dIndex*(index: int32): Direction =
  case index
  of 0'i32: Direction.South
  of 1'i32: Direction.West
  of 2'i32: Direction.North
  else: Direction.East

proc directionFromName*(name: string): (bool, Direction) =
  case name
  of "north": (true, Direction.North)
  of "south": (true, Direction.South)
  of "west": (true, Direction.West)
  of "east": (true, Direction.East)
  of "up": (true, Direction.Up)
  else: (false, Direction.North)

proc stepX*(d: Direction): int32 =
  case d
  of Direction.West: -1'i32
  of Direction.East: 1'i32
  else: 0'i32

proc stepZ*(d: Direction): int32 =
  case d
  of Direction.North: -1'i32
  of Direction.South: 1'i32
  else: 0'i32

proc name*(d: Direction): string =
  case d
  of Direction.North: "north"
  of Direction.South: "south"
  of Direction.West: "west"
  of Direction.East: "east"
  of Direction.Up: "up"

proc clockwise*(d: Direction): Direction =
  case d
  of Direction.North: Direction.East
  of Direction.East: Direction.South
  of Direction.South: Direction.West
  of Direction.West: Direction.North
  of Direction.Up: Direction.Up

proc counterclockwise*(d: Direction): Direction =
  case d
  of Direction.North: Direction.West
  of Direction.West: Direction.South
  of Direction.South: Direction.East
  of Direction.East: Direction.North
  of Direction.Up: Direction.Up

proc opposite*(d: Direction): Direction =
  case d
  of Direction.North: Direction.South
  of Direction.South: Direction.North
  of Direction.West: Direction.East
  of Direction.East: Direction.West
  of Direction.Up: Direction.Up

proc rotate*(d: Direction, rotation: Rotation): Direction =
  case rotation
  of Rotation.None: d
  of Rotation.Clockwise90: clockwise(d)
  of Rotation.Rotate180: opposite(d)
  of Rotation.CounterClockwise90: counterclockwise(d)

proc rotate*(rotation: Rotation, direction: Direction): Direction =
  ## `impl RotateDirection for Rotation`
  rotate(direction, rotation)

proc newSimpleGrid(outside: int32): SimpleGrid =
  SimpleGrid(cells: newSeq[int32](GridArea), outside: outside)

proc width*(g: SimpleGrid): int32 {.inline.} = int32(GridSize)
proc height*(g: SimpleGrid): int32 {.inline.} = int32(GridSize)

proc inGrid(x, y: int32): bool {.inline.} =
  x >= 0 and x < int32(GridSize) and y >= 0 and y < int32(GridSize)

proc set*(g: SimpleGrid, x, y, value: int32) =
  if inGrid(x, y):
    g.cells[int(x) * GridSize + int(y)] = value

proc setRect(g: SimpleGrid, x0, y0, x1, y1, value: int32) =
  var y = y0
  while y <= y1:
    var x = x0
    while x <= x1:
      set(g, x, y, value)
      inc x
    inc y

proc get*(g: SimpleGrid, x, y: int32): int32 =
  if inGrid(x, y): g.cells[int(x) * GridSize + int(y)] else: g.outside

proc setIf(g: SimpleGrid, x, y, expected, value: int32) =
  if get(g, x, y) == expected:
    set(g, x, y, value)

proc edgesTo(g: SimpleGrid, x, y, value: int32): bool =
  get(g, x - 1, y) == value or get(g, x + 1, y) == value or get(g, x, y - 1) == value or get(g, x, y + 1) == value

proc isHouse*(grid: SimpleGrid, x, y: int32): bool =
  let v = get(grid, x, y)
  v == Corridor or v == Room or v == StartRoom or v == TestRoom

proc isRoomId*(m: MansionGrid, x, y: int32, floor: int, roomId: int32): bool =
  (get(m.floorRooms[floor], x, y) and RoomIdMask) == roomId

proc roomDirection*(m: MansionGrid, x, y: int32, floor: int, roomId: int32): (bool, Direction) =
  for i in 0 ..< DirectionHorizontal.len:
    let direction = DirectionHorizontal[i]
    if isRoomId(m, x + stepX(direction), y + stepZ(direction), floor, roomId):
      return (true, direction)
  (false, Direction.North)

proc recursiveCorridor(random: var RandomGenerator, grid: SimpleGrid, x, y: int32, heading: Direction, depth: int32) =
  if depth <= 0:
    return
  set(grid, x, y, Corridor)
  setIf(grid, x + stepX(heading), y + stepZ(heading), 0, Corridor)
  var attempt = 0
  while attempt < 8:
    inc attempt
    let next = directionFrom2dIndex(nextBoundedI32(random, 4))
    if next == opposite(heading) or (next == Direction.East and nextBool(random)):
      continue
    let nextX = x + stepX(heading)
    let nextY = y + stepZ(heading)
    if get(grid, nextX + stepX(next), nextY + stepZ(next)) != 0 or
        get(grid, nextX + stepX(next) * 2, nextY + stepZ(next) * 2) != 0:
      continue
    recursiveCorridor(random, grid, nextX + stepX(next), nextY + stepZ(next), next, depth - 1)
    break
  let cw = clockwise(heading)
  let ccw = counterclockwise(heading)
  setIf(grid, x + stepX(cw), y + stepZ(cw), 0, Room)
  setIf(grid, x + stepX(ccw), y + stepZ(ccw), 0, Room)
  setIf(grid, x + stepX(heading) + stepX(cw), y + stepZ(heading) + stepZ(cw), 0, Room)
  setIf(grid, x + stepX(heading) + stepX(ccw), y + stepZ(heading) + stepZ(ccw), 0, Room)
  setIf(grid, x + stepX(heading) * 2, y + stepZ(heading) * 2, 0, Room)
  setIf(grid, x + stepX(cw) * 2, y + stepZ(cw) * 2, 0, Room)
  setIf(grid, x + stepX(ccw) * 2, y + stepZ(ccw) * 2, 0, Room)

proc countHouses(grid: SimpleGrid, a0, b0, a1, b1, a2, b2, a3, b3: int32): int =
  result = 0
  if isHouse(grid, a0, b0): inc result
  if isHouse(grid, a1, b1): inc result
  if isHouse(grid, a2, b2): inc result
  if isHouse(grid, a3, b3): inc result

proc cleanEdges(grid: SimpleGrid): bool =
  result = false
  var y = 0'i32
  while y < height(grid):
    var x = 0'i32
    while x < width(grid):
      if get(grid, x, y) == 0:
        let directNeighbors = countHouses(grid, x + 1, y, x - 1, y, x, y + 1, x, y - 1)
        if directNeighbors >= 3:
          set(grid, x, y, Room)
          result = true
        elif directNeighbors == 2:
          let diagonalNeighbors = countHouses(grid, x + 1, y + 1, x - 1, y + 1, x + 1, y - 1, x - 1, y - 1)
          if diagonalNeighbors <= 1:
            set(grid, x, y, Room)
            result = true
      inc x
    inc y

proc setupThirdFloor(m: MansionGrid, random: var RandomGenerator) =
  var potentialRooms: seq[(int32, int32)] = @[]
  var y = 0'i32
  while y < height(m.thirdFloor):
    var x = 0'i32
    while x < width(m.thirdFloor):
      let roomData = get(m.floorRooms[1], x, y)
      if (roomData and RoomTypeMask) == Room1x2 and (roomData and RoomDoorFlag) == RoomDoorFlag:
        potentialRooms.add((x, y))
      inc x
    inc y
  if potentialRooms.len == 0:
    setRect(m.thirdFloor, 0, 0, 11, 11, Blocked)
    return
  let picked = potentialRooms[int(nextBoundedI32(random, int32(potentialRooms.len)))]
  let roomX = picked[0]
  let roomY = picked[1]
  let roomData = get(m.floorRooms[1], roomX, roomY)
  set(m.floorRooms[1], roomX, roomY, roomData or RoomStairsFlag)
  let (hasDirection, roomDir) = roomDirection(m, roomX, roomY, 1, roomData and RoomIdMask)
  if not hasDirection:
    setRect(m.thirdFloor, 0, 0, 11, 11, Blocked)
    set(m.floorRooms[1], roomX, roomY, roomData)
    return
  let roomEndX = roomX + stepX(roomDir)
  let roomEndY = roomY + stepZ(roomDir)
  y = 0
  while y < height(m.thirdFloor):
    var x = 0'i32
    while x < width(m.thirdFloor):
      if not isHouse(m.base, x, y):
        set(m.thirdFloor, x, y, Blocked)
      elif x == roomX and y == roomY:
        set(m.thirdFloor, x, y, StartRoom)
      elif x == roomEndX and y == roomEndY:
        set(m.thirdFloor, x, y, StartRoom)
        set(m.floorRooms[2], x, y, RoomCorridorFlag)
      inc x
    inc y
  var potentialCorridors: seq[Direction] = @[]
  for i in 0 ..< DirectionHorizontal.len:
    let direction = DirectionHorizontal[i]
    if get(m.thirdFloor, roomEndX + stepX(direction), roomEndY + stepZ(direction)) == 0:
      potentialCorridors.add(direction)
  if potentialCorridors.len == 0:
    setRect(m.thirdFloor, 0, 0, 11, 11, Blocked)
    set(m.floorRooms[1], roomX, roomY, roomData)
    return
  let direction = potentialCorridors[int(nextBoundedI32(random, int32(potentialCorridors.len)))]
  recursiveCorridor(random, m.thirdFloor, roomEndX + stepX(direction), roomEndY + stepZ(direction), direction, 4)
  while cleanEdges(m.thirdFloor):
    discard

proc identifyRooms(random: var RandomGenerator, fromGrid, roomGrid: SimpleGrid) =
  var roomPositions: seq[(int32, int32)] = @[]
  var gy = 0'i32
  while gy < height(fromGrid):
    var gx = 0'i32
    while gx < width(fromGrid):
      if get(fromGrid, gx, gy) == Room:
        roomPositions.add((gx, gy))
      inc gx
    inc gy
  var index = roomPositions.len - 1
  while index >= 1:
    let swapWith = int(nextBoundedI32(random, int32(index + 1)))
    let a = roomPositions[index]
    let b = roomPositions[swapWith]
    roomPositions[index] = b
    roomPositions[swapWith] = a
    dec index

  var roomId = 10'i32
  for pi in 0 ..< roomPositions.len:
    let x = roomPositions[pi][0]
    let y = roomPositions[pi][1]
    if get(roomGrid, x, y) != 0:
      continue
    var x0 = x
    var x1 = x
    var y0 = y
    var y1 = y
    var roomType = Room1x1
    if get(roomGrid, x + 1, y) == 0 and get(roomGrid, x, y + 1) == 0 and get(roomGrid, x + 1, y + 1) == 0 and
        get(fromGrid, x + 1, y) == Room and get(fromGrid, x, y + 1) == Room and get(fromGrid, x + 1, y + 1) == Room:
      x1 += 1
      y1 += 1
      roomType = Room2x2
    elif get(roomGrid, x - 1, y) == 0 and get(roomGrid, x, y + 1) == 0 and get(roomGrid, x - 1, y + 1) == 0 and
        get(fromGrid, x - 1, y) == Room and get(fromGrid, x, y + 1) == Room and get(fromGrid, x - 1, y + 1) == Room:
      x0 -= 1
      y1 += 1
      roomType = Room2x2
    elif get(roomGrid, x - 1, y) == 0 and get(roomGrid, x, y - 1) == 0 and get(roomGrid, x - 1, y - 1) == 0 and
        get(fromGrid, x - 1, y) == Room and get(fromGrid, x, y - 1) == Room and get(fromGrid, x - 1, y - 1) == Room:
      x0 -= 1
      y0 -= 1
      roomType = Room2x2
    elif get(roomGrid, x + 1, y) == 0 and get(fromGrid, x + 1, y) == Room:
      x1 += 1
      roomType = Room1x2
    elif get(roomGrid, x, y + 1) == 0 and get(fromGrid, x, y + 1) == Room:
      y1 += 1
      roomType = Room1x2
    elif get(roomGrid, x - 1, y) == 0 and get(fromGrid, x - 1, y) == Room:
      x0 -= 1
      roomType = Room1x2
    elif get(roomGrid, x, y - 1) == 0 and get(fromGrid, x, y - 1) == Room:
      y0 -= 1
      roomType = Room1x2

    var doorX = if nextBool(random): x0 else: x1
    var doorY = if nextBool(random): y0 else: y1
    var doorFlag = RoomDoorFlag
    if not edgesTo(fromGrid, doorX, doorY, Corridor):
      doorX = if doorX == x0: x1 else: x0
      doorY = if doorY == y0: y1 else: y0
      if not edgesTo(fromGrid, doorX, doorY, Corridor):
        doorY = if doorY == y0: y1 else: y0
        if not edgesTo(fromGrid, doorX, doorY, Corridor):
          doorX = if doorX == x0: x1 else: x0
          doorY = if doorY == y0: y1 else: y0
          if not edgesTo(fromGrid, doorX, doorY, Corridor):
            doorFlag = 0
            doorX = x0
            doorY = y0

    var roomY = y0
    while roomY <= y1:
      var roomX = x0
      while roomX <= x1:
        let flags = if roomX == doorX and roomY == doorY: RoomOriginFlag or doorFlag else: 0'i32
        set(roomGrid, roomX, roomY, flags or roomType or roomId)
        inc roomX
      inc roomY
    inc roomId

proc newMansionGrid*(random: var RandomGenerator): MansionGrid =
  let entranceX = 7'i32
  let entranceY = 4'i32
  let base = newSimpleGrid(Blocked)
  setRect(base, entranceX, entranceY, entranceX + 1, entranceY + 1, StartRoom)
  setRect(base, entranceX - 1, entranceY, entranceX - 1, entranceY + 1, Room)
  setRect(base, entranceX + 2, entranceY - 2, entranceX + 3, entranceY + 3, Blocked)
  setRect(base, entranceX + 1, entranceY - 2, entranceX + 1, entranceY - 1, Corridor)
  setRect(base, entranceX + 1, entranceY + 2, entranceX + 1, entranceY + 3, Corridor)
  set(base, entranceX - 1, entranceY - 1, Corridor)
  set(base, entranceX - 1, entranceY + 2, Corridor)
  setRect(base, 0, 0, 11, 1, Blocked)
  setRect(base, 0, 9, 11, 11, Blocked)
  recursiveCorridor(random, base, entranceX, entranceY - 2, Direction.West, 6)
  recursiveCorridor(random, base, entranceX, entranceY + 3, Direction.West, 6)
  recursiveCorridor(random, base, entranceX - 2, entranceY - 1, Direction.West, 3)
  recursiveCorridor(random, base, entranceX - 2, entranceY + 2, Direction.West, 3)
  while cleanEdges(base):
    discard
  let floor0 = newSimpleGrid(Blocked)
  let floor1 = newSimpleGrid(Blocked)
  let floor2 = newSimpleGrid(Blocked)
  identifyRooms(random, base, floor0)
  identifyRooms(random, base, floor1)
  setRect(floor0, entranceX + 1, entranceY, entranceX + 1, entranceY + 1, RoomCorridorFlag)
  setRect(floor1, entranceX + 1, entranceY, entranceX + 1, entranceY + 1, RoomCorridorFlag)
  result = MansionGrid(base: base, thirdFloor: newSimpleGrid(Blocked), floorRooms: @[floor0, floor1, floor2],
    entranceX: entranceX, entranceY: entranceY)
  setupThirdFloor(result, random)
  identifyRooms(random, result.thirdFloor, result.floorRooms[2])
