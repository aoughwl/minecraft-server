## Port of pumpkin-world/src/generation/structure/structures/mansion/mod.rs
##
## `Direction` lives in grid.aowl, `offset`, `relative` and `TemplateMirror` in placer.aowl, which sit below this file.

{.feature: "lenientnils".}

import std/options
import std/strutils
import "../../template/templatemod"
import ../structuresmod
import placer

export placer

const LootTable = "minecraft:chests/woodland_mansion"

let WaterBlockForMansion = blockIdNamed("water")

type
  MansionTemplatePiece* = ref object of StructurePieceBase
    templateData*: StructureTemplate
    templatePosition*: Vector3[int32]
    rotation*: Rotation
    mirror*: TemplateMirror

  MansionFoundationPiece* = ref object of StructurePieceBase
    mansionPieces*: seq[BlockBox]
    y*: int32

proc stateMirror*(m: TemplateMirror): Mirror =
  ## Mojang names a Z reflection LEFT_RIGHT and an X reflection FRONT_BACK. Pumpkin names the axis being reflected, so
  ## the variants are exchanged.
  case m
  of TemplateMirror.None: Mirror.None
  of TemplateMirror.LeftRight: Mirror.FrontBack
  of TemplateMirror.FrontBack: Mirror.LeftRight

proc transform*(position: Vector3[int32], mirror: TemplateMirror, rotation: Rotation): Vector3[int32] =
  let x = if mirror == TemplateMirror.FrontBack: -position.x else: position.x
  let z = if mirror == TemplateMirror.LeftRight: -position.z else: position.z
  let (rx, rz) = rotateOffset(rotation, x, z)
  vec3[int32](rx, position.y, rz)

proc property*(palette: PaletteEntry, name: string): (bool, string) =
  for i in 0 ..< palette.properties.len:
    if palette.properties[i][0] == name:
      return (true, palette.properties[i][1])
  (false, "")

proc setProperty(palette: var PaletteEntry, name, value: string) =
  for i in 0 ..< palette.properties.len:
    if palette.properties[i][0] == name:
      palette.properties[i][1] = value
      return

proc transformDirection(direction: Direction, mirror: TemplateMirror, rotation: Rotation): Direction =
  var mirrored = direction
  if mirror == TemplateMirror.LeftRight and direction == Direction.North: mirrored = Direction.South
  elif mirror == TemplateMirror.LeftRight and direction == Direction.South: mirrored = Direction.North
  elif mirror == TemplateMirror.FrontBack and direction == Direction.East: mirrored = Direction.West
  elif mirror == TemplateMirror.FrontBack and direction == Direction.West: mirrored = Direction.East
  rotate(rotation, mirrored)

proc transformRailShape(shape: string, mirror: TemplateMirror, rotation: Rotation): (bool, string) =
  if startsWith(shape, "ascending_"):
    let (known, direction) = directionFromName(shape[10 .. ^1])
    if known:
      case transformDirection(direction, mirror, rotation)
      of Direction.North: return (true, "ascending_north")
      of Direction.South: return (true, "ascending_south")
      of Direction.West: return (true, "ascending_west")
      of Direction.East: return (true, "ascending_east")
      of Direction.Up: return (false, "")
  var first = Direction.North
  var second = Direction.South
  case shape
  of "north_south":
    first = Direction.North
    second = Direction.South
  of "east_west":
    first = Direction.East
    second = Direction.West
  of "north_east":
    first = Direction.North
    second = Direction.East
  of "north_west":
    first = Direction.North
    second = Direction.West
  of "south_east":
    first = Direction.South
    second = Direction.East
  of "south_west":
    first = Direction.South
    second = Direction.West
  else:
    return (false, "")
  let a = transformDirection(first, mirror, rotation)
  let b = transformDirection(second, mirror, rotation)
  template isPair(p, q: Direction): bool = (a == p and b == q) or (a == q and b == p)
  if isPair(Direction.North, Direction.South): (true, "north_south")
  elif isPair(Direction.East, Direction.West): (true, "east_west")
  elif isPair(Direction.North, Direction.East): (true, "north_east")
  elif isPair(Direction.North, Direction.West): (true, "north_west")
  elif isPair(Direction.South, Direction.East): (true, "south_east")
  elif isPair(Direction.South, Direction.West): (true, "south_west")
  else: (false, "")

proc transformedPalette*(paletteIn: PaletteEntry, mirror: TemplateMirror, rotation: Rotation): PaletteEntry =
  result = paletteIn
  if endsWith(result.name, "_stairs"):
    let (hasFacing, facing) = property(result, "facing")
    let (hasShape, shape) = property(result, "shape")
    let northSouth = hasFacing and (facing == "north" or facing == "south")
    let eastWest = hasFacing and (facing == "east" or facing == "west")
    if hasShape:
      if mirror == TemplateMirror.LeftRight and northSouth and shape == "inner_left":
        setProperty(result, "shape", "inner_right")
      elif mirror == TemplateMirror.LeftRight and northSouth and shape == "inner_right":
        setProperty(result, "shape", "inner_left")
      elif shape == "outer_left" and ((mirror == TemplateMirror.LeftRight and northSouth) or (mirror == TemplateMirror.FrontBack and eastWest)):
        setProperty(result, "shape", "outer_right")
      elif shape == "outer_right" and ((mirror == TemplateMirror.LeftRight and northSouth) or (mirror == TemplateMirror.FrontBack and eastWest)):
        setProperty(result, "shape", "outer_left")
  elif endsWith(result.name, "_door") and mirror != TemplateMirror.None:
    let (hasHinge, hinge) = property(result, "hinge")
    if hasHinge and hinge == "left":
      setProperty(result, "hinge", "right")
    elif hasHinge and hinge == "right":
      setProperty(result, "hinge", "left")
  elif result.name == "minecraft:rail":
    let (hasShape, shape) = property(result, "shape")
    if hasShape:
      let (hasNew, newShape) = transformRailShape(shape, mirror, rotation)
      if hasNew:
        setProperty(result, "shape", newShape)

proc worldPosition(p: MansionTemplatePiece, local: Vector3[int32]): Vector3[int32] =
  let transformed = transform(local, p.mirror, p.rotation)
  offset(p.templatePosition, transformed.x, transformed.y, transformed.z)

proc placeBlockEntity(chunk: ProtoChunk, palette: PaletteEntry, hasNbt: bool, templateNbt: NbtCompound, position: Vector3[int32],
                      random: var RandomGenerator) =
  let (hasId, entityId) = getBlockEntityId(palette.name)
  if not hasNbt and not hasId:
    return
  var nbt = newCompound()
  putString(nbt, "id", if hasId: entityId else: palette.name)
  putInt(nbt, "x", position.x)
  putInt(nbt, "y", position.y)
  putInt(nbt, "z", position.z)
  if hasNbt:
    copyTemplateNbt(nbt, templateNbt)
  if isSome(getString(nbt, "LootTable")) and isNone(getLong(nbt, "LootTableSeed")):
    putLong(nbt, "LootTableSeed", nextI64(random))
  addBlockEntity(chunk, nbt)

proc handleMarker(p: MansionTemplatePiece, chunk: ProtoChunk, random: var RandomGenerator, marker: string, position: Vector3[int32]) =
  if startsWith(marker, "Chest"):
    let facing = marker[5 .. ^1]
    let direction =
      case facing
      of "West": Direction.West
      of "East": Direction.East
      of "South": Direction.South
      else: Direction.North
    let target = rotate(p.rotation, direction)
    setBlockState(chunk, position.x, position.y, position.z, stateWith("chest", [("facing", name(target))]))
    var nbt = newCompound()
    putString(nbt, "id", "minecraft:chest")
    putInt(nbt, "x", position.x)
    putInt(nbt, "y", position.y)
    putInt(nbt, "z", position.z)
    putString(nbt, "LootTable", LootTable)
    putLong(nbt, "LootTableSeed", nextI64(random))
    addBlockEntity(chunk, nbt)
    return
  var entity = ""
  var count = 1'i32
  case marker
  of "Mage":
    entity = "minecraft:evoker"
  of "Warrior":
    entity = "minecraft:vindicator"
  of "Group of Allays":
    entity = "minecraft:allay"
    count = nextBoundedI32(random, 3) + 1
  else:
    return
  setBlockState(chunk, position.x, position.y, position.z, AirStateId)
  var i = 0'i32
  while i < count:
    var nbt = newCompound()
    putString(nbt, "id", entity)
    putList(nbt, "Pos", @[nbtTag(float64(position.x) + 0.5'f64), nbtTag(float64(position.y)), nbtTag(float64(position.z) + 0.5'f64)])
    put(nbt, "Motion", NbtTag(kind: ntkList, listVal: @[nbtTag(0.0'f64), nbtTag(0.0'f64), nbtTag(0.0'f64)]))
    put(nbt, "Rotation", NbtTag(kind: ntkList, listVal: @[nbtTag(0.0'f32), nbtTag(0.0'f32)]))
    putBool(nbt, "PersistenceRequired", true)
    addStructureEntity(chunk, nbt)
    inc i

proc placeMansionTemplate(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                          random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[MansionTemplatePiece](self)
  let t = p.templateData
  for bi in 0 ..< t.blocks.len:
    let position = worldPosition(p, t.blocks[bi].pos)
    if not containsPos(chunkBox, position):
      continue
    let palette = t.palette[int(t.blocks[bi].state)]
    if palette.name == "minecraft:structure_void":
      continue
    if palette.name == "minecraft:structure_block":
      if t.blocks[bi].hasNbt:
        let marker = getString(t.blocks[bi].nbt, "metadata")
        if isSome(marker):
          handleMarker(p, chunk, random, get(marker), position)
      continue
    var transformed = transformedPalette(palette, p.mirror, p.rotation)
    if blockIdOf(getBlockState(chunk, position)) == WaterBlockForMansion and property(transformed, "waterlogged")[0]:
      setProperty(transformed, "waterlogged", "true")
    let (found, state) = resolve(transformed, p.rotation, stateMirror(p.mirror))
    if not found:
      continue
    setBlockState(chunk, position.x, position.y, position.z, state)
    placeBlockEntity(chunk, palette, t.blocks[bi].hasNbt, t.blocks[bi].nbt, position, random)

proc newMansionTemplatePiece*(descriptor: PieceDescriptor): MansionTemplatePiece =
  ## nil when the template does not exist.
  let t = getTemplate("woodland_mansion/" & descriptor.templateName)
  if t == nil:
    return nil
  let maxPos = vec3[int32](t.size.x - 1, t.size.y - 1, t.size.z - 1)
  let first = transform(vec3[int32](0, 0, 0), descriptor.mirror, descriptor.rotation)
  let second = transform(maxPos, descriptor.mirror, descriptor.rotation)
  let boundingBox = newBlockBox(descriptor.position.x + min(first.x, second.x), descriptor.position.y,
    descriptor.position.z + min(first.z, second.z), descriptor.position.x + max(first.x, second.x),
    descriptor.position.y + maxPos.y, descriptor.position.z + max(first.z, second.z))
  MansionTemplatePiece(piece: newStructurePiece(StructurePieceType.WoodlandMansion, boundingBox, 0),
    placeFn: placeMansionTemplate, templateData: t, templatePosition: descriptor.position, rotation: descriptor.rotation,
    mirror: descriptor.mirror)

proc placeMansionFoundation(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                            random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[MansionFoundationPiece](self)
  let cobblestone = blockState("cobblestone")
  let minX = max(p.piece.boundingBox.min.x, chunkBox.min.x)
  let maxX = min(p.piece.boundingBox.max.x, chunkBox.max.x)
  let minZ = max(p.piece.boundingBox.min.z, chunkBox.min.z)
  let maxZ = min(p.piece.boundingBox.max.z, chunkBox.max.z)
  let bottom = int32(bottomY(chunk)) + 1
  var x = minX
  while x <= maxX:
    var z = minZ
    while z <= maxZ:
      let position = vec3[int32](x, p.y, z)
      var inPiece = false
      for i in 0 ..< p.mansionPieces.len:
        if containsPos(p.mansionPieces[i], position):
          inPiece = true
          break
      if not isAir(getBlockState(chunk, position)) and inPiece:
        var y = p.y - 1
        while y >= bottom:
          let state = getBlockState(chunk, vec3[int32](x, y, z))
          if not isAir(state) and not isLiquid(state):
            break
          setBlockState(chunk, x, y, z, cobblestone)
          dec y
      inc z
    inc x

proc newMansionFoundationPiece(mansionPieces: seq[BlockBox]): MansionFoundationPiece =
  if mansionPieces.len == 0:
    return nil
  var boundingBox = mansionPieces[0]
  for i in 1 ..< mansionPieces.len:
    encompass(boundingBox, mansionPieces[i])
  MansionFoundationPiece(piece: newStructurePiece(StructurePieceType.WoodlandMansion, boundingBox, 0),
    placeFn: placeMansionFoundation, mansionPieces: mansionPieces, y: boundingBox.min.y)

proc mansionPosition*(context: var StructureGeneratorContext): StructurePosition =
  ## `<MansionGenerator as StructureGenerator>::get_structure_position`
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let x = context.chunkX * 16 + 7
  let z = context.chunkZ * 16 + 7
  var offsetX = 5'i32
  var offsetZ = 5'i32
  case rotation
  of Rotation.None:
    offsetX = 5
    offsetZ = 5
  of Rotation.Clockwise90:
    offsetX = -5
    offsetZ = 5
  of Rotation.Rotate180:
    offsetX = -5
    offsetZ = -5
  of Rotation.CounterClockwise90:
    offsetX = 5
    offsetZ = -5
  if context.heightSampler == nil:
    return nil
  let s = context.heightSampler
  let h1 = estimateHeight(s, x, z)
  let h2 = estimateHeight(s, x, z + offsetZ)
  let h3 = estimateHeight(s, x + offsetX, z)
  let h4 = estimateHeight(s, x + offsetX, z + offsetZ)
  let y = min(min(h1, h2), min(h3, h4))
  if y < 60:
    return nil
  let origin = vec3[int32](x, y, z)
  let mansionGrid = newMansionGrid(context.random)
  let descriptors = createPieces(context.random, origin, rotation, mansionGrid)
  var pieces: seq[MansionTemplatePiece] = @[]
  var pieceBoxes: seq[BlockBox] = @[]
  for i in 0 ..< descriptors.len:
    let piece = newMansionTemplatePiece(descriptors[i])
    if piece == nil:
      return nil
    pieces.add(piece)
    pieceBoxes.add(piece.piece.boundingBox)
  let collector = newStructurePiecesCollector()
  for i in 0 ..< pieces.len:
    addPiece(collector, pieces[i])
  let foundation = newMansionFoundationPiece(pieceBoxes)
  if foundation == nil:
    return nil
  addPiece(collector, foundation)
  StructurePosition(startPos: blockPos(x, y, z), collector: collector)
