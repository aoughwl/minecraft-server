## Upstream's tests of mansion/mod.rs, mansion/grid.rs and mansion/placer.rs. `layouts_match_java_26_2` is a known answer
## dumped from vanilla.
## Port of pumpkin-world/src/generation/structure/structures/mansion/mod.rs tests, grid.rs tests and placer.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../../../../../util/legacy_rand
import "../../../structure/template/templatemod"
import ../structuresmod
import mansion

type
  RecordingHeightSampler = ref object of HeightSampler
    calls: seq[(int32, int32)]
    heights: seq[int32]
    next: int

proc recordEstimate(self: HeightSampler, blockX, blockZ: int32): int32 {.nimcall.} =
  let s = cast[RecordingHeightSampler](self)
  s.calls.add((blockX, blockZ))
  result = s.heights[s.next]
  inc s.next

proc palette(name: string, properties: seq[(string, string)]): PaletteEntry =
  paletteEntryWithProperties(name, properties)

proc layout(seed: uint64): (int, uint64) =
  var random = toRandomGenerator(legacy_rand.fromSeed(seed))
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(random, 4)))
  let g = newMansionGrid(random)
  let pieces = createPieces(random, vec3[int32](0, 64, 0), rotation, g)
  var hash = 0xcbf29ce484222325'u64
  for i in 0 ..< pieces.len:
    let line = pieces[i].templateName & ";" & $pieces[i].position.x & "," & $pieces[i].position.y & "," & $pieces[i].position.z &
      ";" & $ord(pieces[i].rotation) & ";" & $ord(pieces[i].mirror) & "\n"
    for c in line:
      hash = hash xor uint64(ord(c))
      hash = hash * 0x100000001b3'u64
  (pieces.len, hash)

block mirrorsDirectionalShapesLikeJava:
  let stairs = transformedPalette(palette("minecraft:dark_oak_stairs", @[("facing", "north"), ("shape", "inner_left")]),
    TemplateMirror.LeftRight, Rotation.Clockwise90)
  assert property(stairs, "shape")[1] == "inner_right"
  let door = transformedPalette(palette("minecraft:dark_oak_door", @[("facing", "east"), ("hinge", "left")]),
    TemplateMirror.FrontBack, Rotation.None)
  assert property(door, "hinge")[1] == "right"
  let rail = transformedPalette(palette("minecraft:rail", @[("shape", "north_east")]), TemplateMirror.LeftRight, Rotation.Clockwise90)
  assert property(rail, "shape")[1] == "south_west"

block startPositionUsesJavaFiveByFiveCornerSampling:
  let seed = 42'u64
  var expectedRandom = toRandomGenerator(legacy_rand.fromSeed(seed))
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(expectedRandom, 4)))
  let offsetX = if rotation == Rotation.None or rotation == Rotation.CounterClockwise90: 5'i32 else: -5'i32
  let offsetZ = if rotation == Rotation.None or rotation == Rotation.Clockwise90: 5'i32 else: -5'i32
  let sampler = RecordingHeightSampler(estimateFn: recordEstimate, calls: @[], heights: @[74'i32, 70'i32, 72'i32, 73'i32], next: 0)
  var context = StructureGeneratorContext(seed: int64(seed), chunkX: 3, chunkZ: -2,
    random: toRandomGenerator(legacy_rand.fromSeed(seed)), seaLevel: 63, minY: -64, heightSampler: sampler, hasStructureKey: false)
  let position = mansionPosition(context)
  assert position != nil
  let x = 3'i32 * 16 + 7
  let z = -2'i32 * 16 + 7
  assert position.startPos.x == x and position.startPos.y == 70 and position.startPos.z == z
  assert sampler.calls.len == 4
  assert sampler.calls[0] == (x, z)
  assert sampler.calls[1] == (x, z + offsetZ)
  assert sampler.calls[2] == (x + offsetX, z)
  assert sampler.calls[3] == (x + offsetX, z + offsetZ)

block vanillaZeroPivotTransformIsNotBoundsNormalized:
  let a = transform(vec3[int32](3, 2, 5), TemplateMirror.LeftRight, Rotation.Clockwise90)
  assert a.x == 5 and a.y == 2 and a.z == 3
  let b = transform(vec3[int32](3, 2, 5), TemplateMirror.FrontBack, Rotation.None)
  assert b.x == -3 and b.y == 2 and b.z == 5

block generatedRoomsArePartitionedAndHaveAThirdFloor:
  var random = toRandomGenerator(legacy_rand.fromSeed(1'u64))
  let m = newMansionGrid(random)
  for floor in 0 ..< 2:
    var y = 0'i32
    while y < height(m.base):
      var x = 0'i32
      while x < width(m.base):
        if get(m.base, x, y) == Room:
          assert (get(m.floorRooms[floor], x, y) and RoomIdMask) != 0
        inc x
      inc y
  var anyHouse = false
  var y = 0'i32
  while y < height(m.thirdFloor):
    var x = 0'i32
    while x < width(m.thirdFloor):
      if isHouse(m.thirdFloor, x, y):
        anyHouse = true
      inc x
    inc y
  assert anyHouse

block layoutsMatchJava262:
  let a = layout(0'u64)
  assert a[0] == 590 and a[1] == 0xfc1eca03a5d7b852'u64, $a[0]
  let b = layout(1'u64)
  assert b[0] == 579 and b[1] == 0x1b41bf3a4fd9020c'u64, $b[0]
  let c = layout(42'u64)
  assert c[0] == 519 and c[1] == 0xe36767ff2580643e'u64, $c[0]
  let d = layout(8675309'u64)
  assert d[0] == 557 and d[1] == 0x8120b9487d0beb80'u64, $d[0]

echo "mansion: ok"
