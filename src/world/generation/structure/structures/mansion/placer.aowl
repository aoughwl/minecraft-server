## Port of pumpkin-world/src/generation/structure/structures/mansion/placer.rs

{.feature: "lenientnils".}

import ../structuresmod
import grid

export grid

type
  TemplateMirror* {.pure.} = enum
    None, LeftRight, FrontBack

  PieceDescriptor* = object
    templateName*: string
    position*: Vector3[int32]
    rotation*: Rotation
    mirror*: TemplateMirror

  PlacementData = object
    position: Vector3[int32]
    rotation: Rotation
    wall: string

  FloorRooms {.pure.} = enum
    First, Upper

  MansionPiecePlacer = ref object
    random: RandomGenerator
    pieces: seq[PieceDescriptor]
    startX, startY: int32

proc offset*(position: Vector3[int32], x, y, z: int32): Vector3[int32] =
  vec3[int32](position.x + x, position.y + y, position.z + z)

proc relative*(position: Vector3[int32], direction: Direction, distance: int32): Vector3[int32] =
  offset(position, stepX(direction) * distance, 0, stepZ(direction) * distance)

proc numbered(prefix: string, random: var RandomGenerator, count: int32): string =
  prefix & $(nextBoundedI32(random, count) + 1)

proc oneByOne(rooms: FloorRooms, random: var RandomGenerator): string =
  numbered(if rooms == FloorRooms.First: "1x1_a" else: "1x1_b", random, 5)

proc oneByOneSecret(random: var RandomGenerator): string =
  numbered("1x1_as", random, 4)

proc oneByTwoSide(rooms: FloorRooms, random: var RandomGenerator, stairs: bool): string =
  if rooms == FloorRooms.First: numbered("1x2_a", random, 9)
  elif stairs: "1x2_c_stairs"
  else: numbered("1x2_c", random, 4)

proc oneByTwoFront(rooms: FloorRooms, random: var RandomGenerator, stairs: bool): string =
  if rooms == FloorRooms.First: numbered("1x2_b", random, 5)
  elif stairs: "1x2_d_stairs"
  else: numbered("1x2_d", random, 5)

proc oneByTwoSecret(rooms: FloorRooms, random: var RandomGenerator): string =
  if rooms == FloorRooms.First: numbered("1x2_s", random, 2)
  else: numbered("1x2_se", random, 1)

proc twoByTwo(rooms: FloorRooms, random: var RandomGenerator): string =
  if rooms == FloorRooms.First: numbered("2x2_a", random, 4)
  else: numbered("2x2_b", random, 5)

proc addMirrored(s: MansionPiecePlacer, templateName: string, position: Vector3[int32], rotation: Rotation, mirror: TemplateMirror) =
  s.pieces.add(PieceDescriptor(templateName: templateName, position: position, rotation: rotation, mirror: mirror))

proc add(s: MansionPiecePlacer, templateName: string, position: Vector3[int32], rotation: Rotation) =
  addMirrored(s, templateName, position, rotation, TemplateMirror.None)

proc addOneByTwoSide(s: MansionPiecePlacer, rooms: FloorRooms, stairs: bool, position: Vector3[int32], rotation: Rotation, mirror: TemplateMirror) =
  let t = oneByTwoSide(rooms, s.random, stairs)
  addMirrored(s, t, position, rotation, mirror)

proc addOneByTwoFront(s: MansionPiecePlacer, rooms: FloorRooms, stairs: bool, position: Vector3[int32], rotation: Rotation) =
  let t = oneByTwoFront(rooms, s.random, stairs)
  add(s, t, position, rotation)

proc addOneByTwoSecret(s: MansionPiecePlacer, rooms: FloorRooms, position: Vector3[int32], rotation: Rotation) =
  let t = oneByTwoSecret(rooms, s.random)
  add(s, t, position, rotation)

proc entrance(s: MansionPiecePlacer, data: var PlacementData) =
  let position = relative(data.position, rotate(data.rotation, Direction.West), 9)
  add(s, "entrance", position, data.rotation)
  data.position = relative(data.position, rotate(data.rotation, Direction.South), 16)

proc traverseWallPiece(s: MansionPiecePlacer, data: var PlacementData) =
  let position = relative(data.position, rotate(data.rotation, Direction.East), 7)
  add(s, data.wall, position, data.rotation)
  data.position = relative(data.position, rotate(data.rotation, Direction.South), 8)

proc traverseTurn(s: MansionPiecePlacer, data: var PlacementData) =
  data.position = relative(data.position, rotate(data.rotation, Direction.South), -1)
  add(s, "wall_corner", data.position, data.rotation)
  data.position = relative(data.position, rotate(data.rotation, Direction.South), -7)
  data.position = relative(data.position, rotate(data.rotation, Direction.West), -6)
  data.rotation = then(data.rotation, Rotation.Clockwise90)

proc traverseInnerTurn(data: var PlacementData) =
  data.position = relative(data.position, rotate(data.rotation, Direction.South), 6)
  data.position = relative(data.position, rotate(data.rotation, Direction.East), 8)
  data.rotation = then(data.rotation, Rotation.CounterClockwise90)

proc traverseOuterWalls(s: MansionPiecePlacer, data: var PlacementData, g: SimpleGrid, directionIn: Direction,
                        startX, startY, endX, endY: int32) =
  var direction = directionIn
  var gridX = startX
  var gridY = startY
  let startDirection = direction
  while true:
    if not isHouse(g, gridX + stepX(direction), gridY + stepZ(direction)):
      traverseTurn(s, data)
      direction = clockwise(direction)
      if gridX != endX or gridY != endY or startDirection != direction:
        traverseWallPiece(s, data)
    elif isHouse(g, gridX + stepX(direction) + stepX(counterclockwise(direction)),
        gridY + stepZ(direction) + stepZ(counterclockwise(direction))):
      traverseInnerTurn(data)
      gridX += stepX(direction)
      gridY += stepZ(direction)
      direction = counterclockwise(direction)
    else:
      gridX += stepX(direction)
      gridY += stepZ(direction)
      if gridX != endX or gridY != endY or startDirection != direction:
        traverseWallPiece(s, data)
    if gridX == endX and gridY == endY and startDirection == direction:
      break

proc roofPosition(s: MansionPiecePlacer, origin: Vector3[int32], rotation: Rotation, x, y: int32): Vector3[int32] =
  let position = relative(origin, rotate(rotation, Direction.South), 8 + (y - s.startY) * 8)
  relative(position, rotate(rotation, Direction.East), (x - s.startX) * 8)

proc createRoof(s: MansionPiecePlacer, origin: Vector3[int32], rotation: Rotation, g, above: SimpleGrid) =
  ## `above` is nil for upstream's None.
  let east = rotate(rotation, Direction.East)
  let west = rotate(rotation, Direction.West)
  let south = rotate(rotation, Direction.South)
  let north = rotate(rotation, Direction.North)
  let cw = then(rotation, Rotation.Clockwise90)
  let ccw = then(rotation, Rotation.CounterClockwise90)
  let flip = then(rotation, Rotation.Rotate180)
  var y = 0'i32
  while y < height(g):
    var x = 0'i32
    while x < width(g):
      let position = roofPosition(s, origin, rotation, x, y)
      let covered = above != nil and isHouse(above, x, y)
      if isHouse(g, x, y) and not covered:
        add(s, "roof", offset(position, 0, 3, 0), rotation)
        if not isHouse(g, x + 1, y):
          add(s, "roof_front", relative(position, east, 6), rotation)
        if not isHouse(g, x - 1, y):
          add(s, "roof_front", relative(relative(position, east, 0), south, 7), flip)
        if not isHouse(g, x, y - 1):
          add(s, "roof_front", relative(position, west, 1), ccw)
        if not isHouse(g, x, y + 1):
          add(s, "roof_front", relative(relative(position, east, 6), south, 6), cw)
      inc x
    inc y

  if above != nil:
    y = 0
    while y < height(g):
      var x = 0'i32
      while x < width(g):
        let position = roofPosition(s, origin, rotation, x, y)
        if isHouse(g, x, y) and isHouse(above, x, y):
          if not isHouse(g, x + 1, y):
            add(s, "small_wall", relative(position, east, 7), rotation)
          if not isHouse(g, x - 1, y):
            add(s, "small_wall", relative(relative(position, west, 1), south, 6), flip)
          if not isHouse(g, x, y - 1):
            add(s, "small_wall", relative(relative(position, west, 0), north, 1), ccw)
          if not isHouse(g, x, y + 1):
            add(s, "small_wall", relative(relative(position, east, 6), south, 7), cw)
          if not isHouse(g, x + 1, y):
            if not isHouse(g, x, y - 1):
              add(s, "small_wall_corner", relative(relative(position, east, 7), north, 2), rotation)
            if not isHouse(g, x, y + 1):
              add(s, "small_wall_corner", relative(relative(position, east, 8), south, 7), cw)
          if not isHouse(g, x - 1, y):
            if not isHouse(g, x, y - 1):
              add(s, "small_wall_corner", relative(relative(position, west, 2), north, 1), ccw)
            if not isHouse(g, x, y + 1):
              add(s, "small_wall_corner", relative(relative(position, west, 1), south, 8), flip)
        inc x
      inc y

  y = 0
  while y < height(g):
    var x = 0'i32
    while x < width(g):
      let position = roofPosition(s, origin, rotation, x, y)
      let covered = above != nil and isHouse(above, x, y)
      if isHouse(g, x, y) and not covered:
        if not isHouse(g, x + 1, y):
          let eastPos = relative(position, east, 6)
          if not isHouse(g, x, y + 1):
            add(s, "roof_corner", relative(eastPos, south, 6), rotation)
          elif isHouse(g, x + 1, y + 1):
            add(s, "roof_inner_corner", relative(eastPos, south, 5), rotation)
          if not isHouse(g, x, y - 1):
            add(s, "roof_corner", eastPos, ccw)
          elif isHouse(g, x + 1, y - 1):
            add(s, "roof_inner_corner", relative(relative(position, east, 9), north, 2), cw)
        if not isHouse(g, x - 1, y):
          if not isHouse(g, x, y + 1):
            add(s, "roof_corner", relative(position, south, 6), cw)
          elif isHouse(g, x - 1, y + 1):
            add(s, "roof_inner_corner", relative(relative(position, south, 8), west, 3), ccw)
          if not isHouse(g, x, y - 1):
            add(s, "roof_corner", position, flip)
          elif isHouse(g, x - 1, y - 1):
            add(s, "roof_inner_corner", relative(position, south, 1), flip)
      inc x
    inc y

proc addCorridors(s: MansionPiecePlacer, floor: int, floorOrigin: Vector3[int32], rotation: Rotation, rooms, g: SimpleGrid) =
  let southCarpet = if floor == 0: "carpet_south_1" else: "carpet_south_2"
  let westCarpet = if floor == 0: "carpet_west_1" else: "carpet_west_2"
  let east = rotate(rotation, Direction.East)
  let west = rotate(rotation, Direction.West)
  let south = rotate(rotation, Direction.South)
  let north = rotate(rotation, Direction.North)
  var y = 0'i32
  while y < height(g):
    var x = 0'i32
    while x < width(g):
      if get(g, x, y) == Corridor:
        var position = relative(floorOrigin, south, 8 + (y - s.startY) * 8)
        position = relative(position, east, (x - s.startX) * 8)
        add(s, "corridor_floor", position, rotation)
        if get(g, x, y - 1) == Corridor or (get(rooms, x, y - 1) and RoomCorridorFlag) == RoomCorridorFlag:
          add(s, "carpet_north", offset(relative(position, east, 1), 0, 1, 0), rotation)
        if get(g, x + 1, y) == Corridor or (get(rooms, x + 1, y) and RoomCorridorFlag) == RoomCorridorFlag:
          add(s, "carpet_east", offset(relative(relative(position, south, 1), east, 5), 0, 1, 0), rotation)
        if get(g, x, y + 1) == Corridor or (get(rooms, x, y + 1) and RoomCorridorFlag) == RoomCorridorFlag:
          add(s, southCarpet, relative(relative(position, south, 5), west, 1), rotation)
        if get(g, x - 1, y) == Corridor or (get(rooms, x - 1, y) and RoomCorridorFlag) == RoomCorridorFlag:
          add(s, westCarpet, relative(relative(position, west, 1), north, 1), rotation)
      inc x
    inc y

proc addRoom1x1(s: MansionPiecePlacer, roomPosition: Vector3[int32], rotation: Rotation, hasDoor: bool, doorDirection: Direction, rooms: FloorRooms) =
  var pieceRotation = Rotation.None
  var room = oneByOne(rooms, s.random)
  if hasDoor and doorDirection == Direction.East:
    discard
  elif hasDoor and doorDirection == Direction.North:
    pieceRotation = Rotation.CounterClockwise90
  elif hasDoor and doorDirection == Direction.West:
    pieceRotation = Rotation.Rotate180
  elif hasDoor and doorDirection == Direction.South:
    pieceRotation = Rotation.Clockwise90
  else:
    room = oneByOneSecret(s.random)
  var ox = 1'i32
  var oz = 0'i32
  case pieceRotation
  of Rotation.None:
    ox = 1
    oz = 0
  of Rotation.Clockwise90:
    ox = 7
    oz = 0
  of Rotation.Rotate180:
    ox = 7
    oz = 6
  of Rotation.CounterClockwise90:
    ox = 1
    oz = 6
  let orientation = rotateOffset(rotation, ox, oz)
  add(s, room, offset(roomPosition, orientation[0], 0, orientation[1]), then(pieceRotation, rotation))

proc addRoom1x2(s: MansionPiecePlacer, roomPosition: Vector3[int32], rotation: Rotation, roomDirection, doorDirection: Direction, rooms: FloorRooms, stairs: bool) =
  let east = rotate(rotation, Direction.East)
  let south = rotate(rotation, Direction.South)
  template d(a, b: Direction): bool = doorDirection == a and roomDirection == b
  if d(Direction.East, Direction.South):
    addOneByTwoSide(s, rooms, stairs, relative(roomPosition, east, 1), rotation, TemplateMirror.None)
  elif d(Direction.East, Direction.North):
    addOneByTwoSide(s, rooms, stairs, relative(relative(roomPosition, east, 1), south, 6), rotation, TemplateMirror.LeftRight)
  elif d(Direction.West, Direction.North):
    addOneByTwoSide(s, rooms, stairs, relative(relative(roomPosition, east, 7), south, 6), then(rotation, Rotation.Rotate180), TemplateMirror.None)
  elif d(Direction.West, Direction.South):
    addOneByTwoSide(s, rooms, stairs, relative(roomPosition, east, 7), rotation, TemplateMirror.FrontBack)
  elif d(Direction.South, Direction.East):
    addOneByTwoSide(s, rooms, stairs, relative(roomPosition, east, 1), then(rotation, Rotation.Clockwise90), TemplateMirror.LeftRight)
  elif d(Direction.South, Direction.West):
    addOneByTwoSide(s, rooms, stairs, relative(roomPosition, east, 7), then(rotation, Rotation.Clockwise90), TemplateMirror.None)
  elif d(Direction.North, Direction.West):
    addOneByTwoSide(s, rooms, stairs, relative(relative(roomPosition, east, 7), south, 6), then(rotation, Rotation.Clockwise90), TemplateMirror.FrontBack)
  elif d(Direction.North, Direction.East):
    addOneByTwoSide(s, rooms, stairs, relative(relative(roomPosition, east, 1), south, 6), then(rotation, Rotation.CounterClockwise90), TemplateMirror.None)
  elif d(Direction.South, Direction.North):
    addOneByTwoFront(s, rooms, stairs, relative(relative(roomPosition, east, 1), rotate(rotation, Direction.North), 8), rotation)
  elif d(Direction.North, Direction.South):
    addOneByTwoFront(s, rooms, stairs, relative(relative(roomPosition, east, 7), south, 14), then(rotation, Rotation.Rotate180))
  elif d(Direction.West, Direction.East):
    addOneByTwoFront(s, rooms, stairs, relative(roomPosition, east, 15), then(rotation, Rotation.Clockwise90))
  elif d(Direction.East, Direction.West):
    addOneByTwoFront(s, rooms, stairs, relative(relative(roomPosition, rotate(rotation, Direction.West), 7), south, 6), then(rotation, Rotation.CounterClockwise90))
  elif d(Direction.Up, Direction.East):
    addOneByTwoSecret(s, rooms, relative(roomPosition, east, 15), then(rotation, Rotation.Clockwise90))
  elif d(Direction.Up, Direction.South):
    addOneByTwoSecret(s, rooms, relative(roomPosition, east, 1), rotation)

proc addRoom2x2(s: MansionPiecePlacer, roomPosition: Vector3[int32], rotation: Rotation, roomDirection, doorDirection: Direction, rooms: FloorRooms) =
  var east = 0'i32
  var south = 0'i32
  var pieceRotation = rotation
  var mirror = TemplateMirror.None
  template d(a, b: Direction): bool = doorDirection == a and roomDirection == b
  if d(Direction.East, Direction.South):
    east = -7
  elif d(Direction.East, Direction.North):
    east = -7
    south = 6
    mirror = TemplateMirror.LeftRight
  elif d(Direction.North, Direction.East):
    east = 1
    south = 14
    pieceRotation = then(rotation, Rotation.CounterClockwise90)
  elif d(Direction.North, Direction.West):
    east = 7
    south = 14
    pieceRotation = then(rotation, Rotation.CounterClockwise90)
    mirror = TemplateMirror.LeftRight
  elif d(Direction.South, Direction.West):
    east = 7
    south = -8
    pieceRotation = then(rotation, Rotation.Clockwise90)
  elif d(Direction.South, Direction.East):
    east = 1
    south = -8
    pieceRotation = then(rotation, Rotation.Clockwise90)
    mirror = TemplateMirror.LeftRight
  elif d(Direction.West, Direction.North):
    east = 15
    south = 6
    pieceRotation = then(rotation, Rotation.Rotate180)
  elif d(Direction.West, Direction.South):
    east = 15
    south = 0
    mirror = TemplateMirror.FrontBack
  let position = relative(relative(roomPosition, rotate(rotation, Direction.East), east), rotate(rotation, Direction.South), south)
  let t = twoByTwo(rooms, s.random)
  addMirrored(s, t, position, pieceRotation, mirror)

proc addRoom2x2Secret(s: MansionPiecePlacer, roomPosition: Vector3[int32], rotation: Rotation) =
  add(s, "2x2_s1", relative(roomPosition, rotate(rotation, Direction.East), 1), rotation)

proc addRooms(s: MansionPiecePlacer, floor: int, floorOrigin: Vector3[int32], rotation: Rotation, mansion: MansionGrid, rooms, g: SimpleGrid, roomCollection: FloorRooms) =
  let wall = if floor == 0: "indoors_wall_1" else: "indoors_wall_2"
  let door = if floor == 0: "indoors_door_1" else: "indoors_door_2"
  var y = 0'i32
  while y < height(g):
    var x = 0'i32
    while x < width(g):
      let thirdFloorStart = floor == 2 and get(g, x, y) == StartRoom
      if get(g, x, y) == Room or thirdFloorStart:
        let roomData = get(rooms, x, y)
        let roomType = roomData and RoomTypeMask
        let roomId = roomData and RoomIdMask
        let corridorStart = thirdFloorStart and (roomData and RoomCorridorFlag) == RoomCorridorFlag
        var doorDirections: seq[Direction] = @[]
        if (roomData and RoomDoorFlag) == RoomDoorFlag:
          for i in 0 ..< DirectionHorizontal.len:
            let direction = DirectionHorizontal[i]
            if get(g, x + stepX(direction), y + stepZ(direction)) == Corridor:
              doorDirections.add(direction)
        var hasDoor = false
        var doorDirection = Direction.Up
        if doorDirections.len == 0:
          if (roomData and RoomOriginFlag) == RoomOriginFlag:
            hasDoor = true
            doorDirection = Direction.Up
        else:
          hasDoor = true
          doorDirection = doorDirections[int(nextBoundedI32(s.random, int32(doorDirections.len)))]

        var roomPosition = relative(floorOrigin, rotate(rotation, Direction.South), 8 + (y - s.startY) * 8)
        roomPosition = relative(roomPosition, rotate(rotation, Direction.East), -1 + (x - s.startX) * 8)

        if isHouse(g, x - 1, y) and not isRoomId(mansion, x - 1, y, floor, roomId):
          add(s, if hasDoor and doorDirection == Direction.West: door else: wall, roomPosition, rotation)
        if get(g, x + 1, y) == Corridor and not corridorStart:
          add(s, if hasDoor and doorDirection == Direction.East: door else: wall,
            relative(roomPosition, rotate(rotation, Direction.East), 8), rotation)
        if isHouse(g, x, y + 1) and not isRoomId(mansion, x, y + 1, floor, roomId):
          let position = relative(relative(roomPosition, rotate(rotation, Direction.South), 7), rotate(rotation, Direction.East), 7)
          add(s, if hasDoor and doorDirection == Direction.South: door else: wall, position, then(rotation, Rotation.Clockwise90))
        if get(g, x, y - 1) == Corridor and not corridorStart:
          let position = relative(relative(roomPosition, rotate(rotation, Direction.North), 1), rotate(rotation, Direction.East), 7)
          add(s, if hasDoor and doorDirection == Direction.North: door else: wall, position, then(rotation, Rotation.Clockwise90))

        if roomType == Room1x1:
          addRoom1x1(s, roomPosition, rotation, hasDoor, doorDirection, roomCollection)
        elif roomType == Room1x2 and hasDoor:
          let (hasRoomDirection, roomDir) = roomDirection(mansion, x, y, floor, roomId)
          if hasRoomDirection:
            addRoom1x2(s, roomPosition, rotation, roomDir, doorDirection, roomCollection, (roomData and RoomStairsFlag) == RoomStairsFlag)
        elif roomType == Room2x2 and hasDoor and doorDirection == Direction.Up:
          addRoom2x2Secret(s, roomPosition, rotation)
        elif roomType == Room2x2 and hasDoor:
          var roomDir = clockwise(doorDirection)
          if not isRoomId(mansion, x + stepX(roomDir), y + stepZ(roomDir), floor, roomId):
            roomDir = opposite(roomDir)
          addRoom2x2(s, roomPosition, rotation, roomDir, doorDirection, roomCollection)
      inc x
    inc y

proc createMansion(s: MansionPiecePlacer, origin: Vector3[int32], rotation: Rotation, mansion: MansionGrid) =
  var ground = PlacementData(position: origin, rotation: rotation, wall: "wall_flat")
  entrance(s, ground)
  var second = PlacementData(position: offset(ground.position, 0, 8, 0), rotation: ground.rotation, wall: "wall_window")
  let endX = mansion.entranceX + 1
  let endY = mansion.entranceY
  traverseOuterWalls(s, ground, mansion.base, Direction.South, s.startX, s.startY, endX, endY)
  traverseOuterWalls(s, second, mansion.base, Direction.South, s.startX, s.startY, endX, endY)

  var third = PlacementData(position: offset(ground.position, 0, 19, 0), rotation: ground.rotation, wall: "wall_window")
  block findStart:
    var y = 0'i32
    while y < height(mansion.thirdFloor):
      var x = width(mansion.thirdFloor) - 1
      while x >= 0:
        if isHouse(mansion.thirdFloor, x, y):
          third.position = relative(third.position, rotate(rotation, Direction.South), 8 + (y - s.startY) * 8)
          third.position = relative(third.position, rotate(rotation, Direction.East), (x - s.startX) * 8)
          traverseWallPiece(s, third)
          traverseOuterWalls(s, third, mansion.thirdFloor, Direction.South, x, y, x, y)
          break findStart
        dec x
      inc y

  createRoof(s, offset(origin, 0, 16, 0), rotation, mansion.base, mansion.thirdFloor)
  createRoof(s, offset(origin, 0, 27, 0), rotation, mansion.thirdFloor, nil)

  for floor in 0 ..< 3:
    let extra = if floor == 2: 3'i32 else: 0'i32
    let floorOrigin = offset(origin, 0, 8 * int32(floor) + extra, 0)
    let rooms = mansion.floorRooms[floor]
    let g = if floor == 2: mansion.thirdFloor else: mansion.base
    let roomCollection = if floor == 0: FloorRooms.First else: FloorRooms.Upper
    addCorridors(s, floor, floorOrigin, rotation, rooms, g)
    addRooms(s, floor, floorOrigin, rotation, mansion, rooms, g, roomCollection)

proc createPieces*(random: var RandomGenerator, origin: Vector3[int32], rotation: Rotation, mansion: MansionGrid): seq[PieceDescriptor] =
  ## `MansionPiecePlacer::create`. The placer holds the generator as long as it runs, then gives it back.
  let placer = MansionPiecePlacer(random: random, pieces: @[], startX: mansion.entranceX + 1, startY: mansion.entranceY + 1)
  createMansion(placer, origin, rotation, mansion)
  random = placer.random
  placer.pieces
