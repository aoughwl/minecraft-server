## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/mineshaft.rs
##
## The pinned tree's piece was one fixed crossing, so this one comes from the newer tree. Upstream's `GeneratedPiece` enum
## is `MineshaftPieceBase`'s subtypes here, told apart by `structureType`.

{.feature: "lenientnils".}

import ../../../../generated/biome
import structuresmod

type
  MineshaftType* {.pure.} = enum
    Normal, Mesa

  MineshaftPieceBase = ref object of StructurePieceBase
    shaftType: MineshaftType

  MineShaftRoom* = ref object of MineshaftPieceBase
    childEntranceBoxes: seq[BlockBox]

  MineShaftCorridor* = ref object of MineshaftPieceBase
    hasRails*: bool
    spiderCorridor*: bool
    hasPlacedSpider: bool
    numSections*: int32

  MineShaftCrossing* = ref object of MineshaftPieceBase
    direction: BlockDirection
    isTwoFloored: bool

  MineShaftStairs* = ref object of MineshaftPieceBase

let
  CaveAir = blockState("cave_air")
  OakLog = blockState("oak_log")
  DarkOakLog = blockState("dark_oak_log")
  OakPlanks = blockState("oak_planks")
  DarkOakPlanks = blockState("dark_oak_planks")
  OakFence = blockState("oak_fence")
  DarkOakFence = blockState("dark_oak_fence")
  Cobweb = blockState("cobweb")
  Spawner = blockState("spawner")
  IronChain = blockState("iron_chain")
  LavaBlock = blockIdNamed("lava")
  GlowLichen = blockIdNamed("glow_lichen")
  SeagrassBlock = blockIdNamed("seagrass")
  TallSeagrass = blockIdNamed("tall_seagrass")
  FallingBlocks = [blockIdNamed("sand"), blockIdNamed("red_sand"), blockIdNamed("gravel"), blockIdNamed("suspicious_sand"),
    blockIdNamed("suspicious_gravel"), blockIdNamed("anvil"), blockIdNamed("chipped_anvil"), blockIdNamed("damaged_anvil"),
    blockIdNamed("dragon_egg"), blockIdNamed("white_concrete_powder"), blockIdNamed("orange_concrete_powder"),
    blockIdNamed("magenta_concrete_powder"), blockIdNamed("light_blue_concrete_powder"),
    blockIdNamed("yellow_concrete_powder"), blockIdNamed("lime_concrete_powder"), blockIdNamed("pink_concrete_powder"),
    blockIdNamed("gray_concrete_powder"), blockIdNamed("light_gray_concrete_powder"), blockIdNamed("cyan_concrete_powder"),
    blockIdNamed("purple_concrete_powder"), blockIdNamed("blue_concrete_powder"), blockIdNamed("brown_concrete_powder"),
    blockIdNamed("green_concrete_powder"), blockIdNamed("red_concrete_powder"), blockIdNamed("black_concrete_powder")]

const AbandonedMineshaftLoot = "minecraft:chests/abandoned_mineshaft"

proc wood(t: MineshaftType): BlockStateId =
  if t == MineshaftType.Normal: OakLog else: DarkOakLog

proc planks(t: MineshaftType): BlockStateId =
  if t == MineshaftType.Normal: OakPlanks else: DarkOakPlanks

proc fence(t: MineshaftType): BlockStateId =
  if t == MineshaftType.Normal: OakFence else: DarkOakFence

proc fenceBlockName(t: MineshaftType): string =
  if t == MineshaftType.Normal: "oak_fence" else: "dark_oak_fence"

proc isFallingBlock(blockId: int): bool =
  for i in 0 ..< FallingBlocks.len:
    if FallingBlocks[i] == blockId:
      return true
  false

proc isReplaceableByStructures(state: BlockStateId): bool =
  ## `StructurePiece::is_replaceable_by_structures`
  let b = blockIdOf(state)
  isAir(state) or isLiquid(state) or b == GlowLichen or b == SeagrassBlock or b == TallSeagrass

proc placeRoom(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
               seed: int64, chunkBox: BlockBox) {.nimcall.}
proc placeCorridor(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                   seed: int64, chunkBox: BlockBox) {.nimcall.}
proc placeCrossing(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                   seed: int64, chunkBox: BlockBox) {.nimcall.}
proc placeStairs(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                 seed: int64, chunkBox: BlockBox) {.nimcall.}
proc translateRoom(self: StructurePieceBase, x, y, z: int32) {.nimcall.}

proc newMineShaftRoom*(genDepth: uint32, random: var RandomGenerator, west, north: int32, shaftType: MineshaftType): MineShaftRoom =
  let maxX = west + 7 + nextBoundedI32(random, 6)
  let maxY = 54'i32 + nextBoundedI32(random, 6)
  let maxZ = north + 7 + nextBoundedI32(random, 6)
  let boundingBox = newBlockBox(west, 50, north, maxX, maxY, maxZ)
  MineShaftRoom(piece: newStructurePiece(StructurePieceType.MineshaftRoom, boundingBox, genDepth), placeFn: placeRoom,
    translateFn: translateRoom, shaftType: shaftType, childEntranceBoxes: @[])

proc newMineShaftCorridor*(genDepth: uint32, random: var RandomGenerator, boundingBox: BlockBox, direction: BlockDirection,
                           shaftType: MineshaftType): MineShaftCorridor =
  let hasRails = nextBoundedI32(random, 3) == 0
  let spiderCorridor = not hasRails and nextBoundedI32(random, 23) == 0
  let numSections =
    if getAxis(direction) == axisZ: (boundingBox.max.z - boundingBox.min.z + 1) div 5
    else: (boundingBox.max.x - boundingBox.min.x + 1) div 5
  var piece = newStructurePiece(StructurePieceType.MineshaftCorridor, boundingBox, genDepth)
  setFacing(piece, direction)
  MineShaftCorridor(piece: piece, placeFn: placeCorridor, shaftType: shaftType, hasRails: hasRails,
    spiderCorridor: spiderCorridor, hasPlacedSpider: false, numSections: numSections)

proc findCorridorSize*(collector: StructurePiecesCollector, random: var RandomGenerator, footX, footY, footZ: int32,
                       direction: BlockDirection, found: var BlockBox): bool =
  ## `MineShaftCorridor::find_corridor_size`: false for `None`.
  let maxLen = nextBoundedI32(random, 3) + 2
  var corridorLength = maxLen
  while corridorLength >= 1:
    let blockLength = corridorLength * 5
    var boxCand =
      case direction
      of South: newBlockBox(0, 0, 0, 2, 2, blockLength - 1)
      of West: newBlockBox(-(blockLength - 1), 0, 0, 0, 2, 2)
      of East: newBlockBox(0, 0, 0, blockLength - 1, 2, 2)
      else: newBlockBox(0, 0, -(blockLength - 1), 2, 2, 0)
    movePos(boxCand, footX, footY, footZ)
    if getIntersecting(collector, boxCand) == nil:
      found = boxCand
      return true
    dec corridorLength
  false

proc newMineShaftCrossing*(genDepth: uint32, boundingBox: BlockBox, direction: BlockDirection,
                           shaftType: MineshaftType): MineShaftCrossing =
  let isTwoFloored = boundingBox.max.y - boundingBox.min.y + 1 > 3
  var piece = newStructurePiece(StructurePieceType.MineshaftCrossing, boundingBox, genDepth)
  setFacing(piece, direction)
  MineShaftCrossing(piece: piece, placeFn: placeCrossing, shaftType: shaftType, direction: direction,
    isTwoFloored: isTwoFloored)

proc findCrossing*(collector: StructurePiecesCollector, random: var RandomGenerator, footX, footY, footZ: int32,
                   direction: BlockDirection, found: var BlockBox): bool =
  ## `MineShaftCrossing::find_crossing`: false for `None`.
  let y1 = if nextBoundedI32(random, 4) == 0: 6'i32 else: 2'i32
  var boxCand =
    case direction
    of South: newBlockBox(-1, 0, 0, 3, y1, 4)
    of West: newBlockBox(-4, 0, -1, 0, y1, 3)
    of East: newBlockBox(0, 0, -1, 4, y1, 3)
    else: newBlockBox(-1, 0, -4, 3, y1, 0)
  movePos(boxCand, footX, footY, footZ)
  if getIntersecting(collector, boxCand) != nil:
    return false
  found = boxCand
  true

proc newMineShaftStairs*(genDepth: uint32, boundingBox: BlockBox, direction: BlockDirection,
                         shaftType: MineshaftType): MineShaftStairs =
  var piece = newStructurePiece(StructurePieceType.MineshaftStairs, boundingBox, genDepth)
  setFacing(piece, direction)
  MineShaftStairs(piece: piece, placeFn: placeStairs, shaftType: shaftType)

proc findStairs*(collector: StructurePiecesCollector, footX, footY, footZ: int32, direction: BlockDirection,
                 found: var BlockBox): bool =
  ## `MineShaftStairs::find_stairs`: false for `None`.
  var boxCand =
    case direction
    of South: newBlockBox(0, -5, 0, 2, 2, 8)
    of West: newBlockBox(-8, -5, 0, 0, 2, 2)
    of East: newBlockBox(0, -5, 0, 8, 2, 2)
    else: newBlockBox(0, -5, -8, 2, 2, 0)
  movePos(boxCand, footX, footY, footZ)
  if getIntersecting(collector, boxCand) != nil:
    return false
  found = boxCand
  true

proc createRandomShaftPiece(collector: StructurePiecesCollector, random: var RandomGenerator, footX, footY, footZ: int32,
                            direction: BlockDirection, genDepth: uint32, shaftType: MineshaftType): MineshaftPieceBase =
  ## `create_random_shaft_piece`: nil for `None`.
  let randomSelection = nextBoundedI32(random, 100)
  var found = default(BlockBox)
  if randomSelection >= 80:
    if findCrossing(collector, random, footX, footY, footZ, direction, found):
      return newMineShaftCrossing(genDepth, found, direction, shaftType)
  elif randomSelection >= 70:
    if findStairs(collector, footX, footY, footZ, direction, found):
      return newMineShaftStairs(genDepth, found, direction, shaftType)
  elif findCorridorSize(collector, random, footX, footY, footZ, direction, found):
    return newMineShaftCorridor(genDepth, random, found, direction, shaftType)
  nil

proc addCorridorChildren(bb: BlockBox, depth: uint32, orientation: BlockDirection, startPieceBox: BlockBox,
                         shaftType: MineshaftType, collector: StructurePiecesCollector, random: var RandomGenerator)
proc addCrossingChildren(bb: BlockBox, depth: uint32, dir: BlockDirection, isTwoFloored: bool, startPieceBox: BlockBox,
                         shaftType: MineshaftType, collector: StructurePiecesCollector, random: var RandomGenerator)
proc addStairsChildren(bb: BlockBox, depth: uint32, dir: BlockDirection, startPieceBox: BlockBox, shaftType: MineshaftType,
                       collector: StructurePiecesCollector, random: var RandomGenerator)

proc generateAndAddPiece(startPieceBox: BlockBox, collector: StructurePiecesCollector, random: var RandomGenerator,
                         footX, footY, footZ: int32, direction: BlockDirection, depth: uint32, shaftType: MineshaftType,
                         pieceBox: var BlockBox): bool =
  ## `generate_and_add_piece`: false for `None`.
  if depth > 8'u32:
    return false
  if abs(footX - startPieceBox.min.x) > 80 or abs(footZ - startPieceBox.min.z) > 80:
    return false
  let newPiece = createRandomShaftPiece(collector, random, footX, footY, footZ, direction, depth + 1'u32, shaftType)
  if newPiece == nil:
    return false
  pieceBox = newPiece.piece.boundingBox
  let bb = newPiece.piece.boundingBox
  addPiece(collector, newPiece)
  case newPiece.piece.structureType
  of StructurePieceType.MineshaftCorridor:
    addCorridorChildren(bb, depth + 1'u32, newPiece.piece.facing, startPieceBox, shaftType, collector, random)
  of StructurePieceType.MineshaftCrossing:
    let crossing = cast[MineShaftCrossing](newPiece)
    addCrossingChildren(bb, depth + 1'u32, crossing.direction, crossing.isTwoFloored, startPieceBox, shaftType, collector, random)
  else:
    addStairsChildren(bb, depth + 1'u32, newPiece.piece.facing, startPieceBox, shaftType, collector, random)
  true

proc generateAndAdd(startPieceBox: BlockBox, collector: StructurePiecesCollector, random: var RandomGenerator,
                    footX, footY, footZ: int32, direction: BlockDirection, depth: uint32, shaftType: MineshaftType) =
  ## `generate_and_add_piece` where the caller drops the box.
  var ignored = default(BlockBox)
  discard generateAndAddPiece(startPieceBox, collector, random, footX, footY, footZ, direction, depth, shaftType, ignored)

proc addRoomChildren(room: MineShaftRoom, startPieceBox: BlockBox, shaftType: MineshaftType, collector: StructurePiecesCollector,
                     random: var RandomGenerator) =
  ## `MineShaftRoom::add_room_children`
  let depth = 0'u32
  let ySpan = startPieceBox.max.y - startPieceBox.min.y + 1
  var heightSpace = ySpan - 4
  if heightSpace <= 0:
    heightSpace = 1
  let xSpan = startPieceBox.max.x - startPieceBox.min.x + 1
  let zSpan = startPieceBox.max.z - startPieceBox.min.z + 1
  var childBox = default(BlockBox)

  var pos = 0'i32
  while pos < xSpan:
    pos += nextBoundedI32(random, xSpan)
    if pos + 3 > xSpan:
      break
    let childX = startPieceBox.min.x + pos
    let childY = startPieceBox.min.y + nextBoundedI32(random, heightSpace) + 1
    let childZ = startPieceBox.min.z - 1
    if generateAndAddPiece(startPieceBox, collector, random, childX, childY, childZ, North, depth, shaftType, childBox):
      room.childEntranceBoxes.add(newBlockBox(childBox.min.x, childBox.min.y, startPieceBox.min.z, childBox.max.x,
        childBox.max.y, startPieceBox.min.z + 1))
    pos += 4

  pos = 0
  while pos < xSpan:
    pos += nextBoundedI32(random, xSpan)
    if pos + 3 > xSpan:
      break
    let childX = startPieceBox.min.x + pos
    let childY = startPieceBox.min.y + nextBoundedI32(random, heightSpace) + 1
    let childZ = startPieceBox.max.z + 1
    if generateAndAddPiece(startPieceBox, collector, random, childX, childY, childZ, South, depth, shaftType, childBox):
      room.childEntranceBoxes.add(newBlockBox(childBox.min.x, childBox.min.y, startPieceBox.max.z - 1, childBox.max.x,
        childBox.max.y, startPieceBox.max.z))
    pos += 4

  pos = 0
  while pos < zSpan:
    pos += nextBoundedI32(random, zSpan)
    if pos + 3 > zSpan:
      break
    let childX = startPieceBox.min.x - 1
    let childY = startPieceBox.min.y + nextBoundedI32(random, heightSpace) + 1
    let childZ = startPieceBox.min.z + pos
    if generateAndAddPiece(startPieceBox, collector, random, childX, childY, childZ, West, depth, shaftType, childBox):
      room.childEntranceBoxes.add(newBlockBox(startPieceBox.min.x, childBox.min.y, childBox.min.z, startPieceBox.min.x + 1,
        childBox.max.y, childBox.max.z))
    pos += 4

  pos = 0
  while pos < zSpan:
    pos += nextBoundedI32(random, zSpan)
    if pos + 3 > zSpan:
      break
    let childX = startPieceBox.max.x + 1
    let childY = startPieceBox.min.y + nextBoundedI32(random, heightSpace) + 1
    let childZ = startPieceBox.min.z + pos
    if generateAndAddPiece(startPieceBox, collector, random, childX, childY, childZ, East, depth, shaftType, childBox):
      room.childEntranceBoxes.add(newBlockBox(startPieceBox.max.x - 1, childBox.min.y, childBox.min.z, startPieceBox.max.x,
        childBox.max.y, childBox.max.z))
    pos += 4

proc addCorridorChildren(bb: BlockBox, depth: uint32, orientation: BlockDirection, startPieceBox: BlockBox,
                         shaftType: MineshaftType, collector: StructurePiecesCollector, random: var RandomGenerator) =
  ## `MineShaftCorridor::add_corridor_children`
  let endSelection = nextBoundedI32(random, 4)
  let randY = bb.min.y - 1 + nextBoundedI32(random, 3)
  case orientation
  of North:
    if endSelection <= 1:
      generateAndAdd(startPieceBox, collector, random, bb.min.x, randY, bb.min.z - 1, orientation, depth, shaftType)
    elif endSelection == 2:
      generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, randY, bb.min.z, West, depth, shaftType)
    else:
      generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, randY, bb.min.z, East, depth, shaftType)
  of South:
    if endSelection <= 1:
      generateAndAdd(startPieceBox, collector, random, bb.min.x, randY, bb.max.z + 1, orientation, depth, shaftType)
    elif endSelection == 2:
      generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, randY, bb.max.z - 3, West, depth, shaftType)
    else:
      generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, randY, bb.max.z - 3, East, depth, shaftType)
  of West:
    if endSelection <= 1:
      generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, randY, bb.min.z, orientation, depth, shaftType)
    elif endSelection == 2:
      generateAndAdd(startPieceBox, collector, random, bb.min.x, randY, bb.min.z - 1, North, depth, shaftType)
    else:
      generateAndAdd(startPieceBox, collector, random, bb.min.x, randY, bb.max.z + 1, South, depth, shaftType)
  of East:
    if endSelection <= 1:
      generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, randY, bb.min.z, orientation, depth, shaftType)
    elif endSelection == 2:
      generateAndAdd(startPieceBox, collector, random, bb.max.x - 3, randY, bb.min.z - 1, North, depth, shaftType)
    else:
      generateAndAdd(startPieceBox, collector, random, bb.max.x - 3, randY, bb.max.z + 1, South, depth, shaftType)
  else:
    discard

  if depth < 8'u32:
    if orientation != North and orientation != South:
      var x = bb.min.x + 3
      while x + 3 <= bb.max.x:
        let sel = nextBoundedI32(random, 5)
        if sel == 0:
          generateAndAdd(startPieceBox, collector, random, x, bb.min.y, bb.min.z - 1, North, depth + 1'u32, shaftType)
        elif sel == 1:
          generateAndAdd(startPieceBox, collector, random, x, bb.min.y, bb.max.z + 1, South, depth + 1'u32, shaftType)
        x += 5
    else:
      var z = bb.min.z + 3
      while z + 3 <= bb.max.z:
        let sel = nextBoundedI32(random, 5)
        if sel == 0:
          generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y, z, West, depth + 1'u32, shaftType)
        elif sel == 1:
          generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y, z, East, depth + 1'u32, shaftType)
        z += 5

proc addCrossingChildren(bb: BlockBox, depth: uint32, dir: BlockDirection, isTwoFloored: bool, startPieceBox: BlockBox,
                         shaftType: MineshaftType, collector: StructurePiecesCollector, random: var RandomGenerator) =
  ## `MineShaftCrossing::add_crossing_children`
  case dir
  of North:
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.min.z - 1, North, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y, bb.min.z + 1, West, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y, bb.min.z + 1, East, depth, shaftType)
  of South:
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.max.z + 1, South, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y, bb.min.z + 1, West, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y, bb.min.z + 1, East, depth, shaftType)
  of West:
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.min.z - 1, North, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.max.z + 1, South, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y, bb.min.z + 1, West, depth, shaftType)
  of East:
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.min.z - 1, North, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y, bb.max.z + 1, South, depth, shaftType)
    generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y, bb.min.z + 1, East, depth, shaftType)
  else:
    discard
  if isTwoFloored:
    if nextBool(random):
      generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y + 4, bb.min.z - 1, North, depth, shaftType)
    if nextBool(random):
      generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y + 4, bb.min.z + 1, West, depth, shaftType)
    if nextBool(random):
      generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y + 4, bb.min.z + 1, East, depth, shaftType)
    if nextBool(random):
      generateAndAdd(startPieceBox, collector, random, bb.min.x + 1, bb.min.y + 4, bb.max.z + 1, South, depth, shaftType)

proc addStairsChildren(bb: BlockBox, depth: uint32, dir: BlockDirection, startPieceBox: BlockBox, shaftType: MineshaftType,
                       collector: StructurePiecesCollector, random: var RandomGenerator) =
  ## `MineShaftStairs::add_stairs_children`
  case dir
  of North:
    generateAndAdd(startPieceBox, collector, random, bb.min.x, bb.min.y, bb.min.z - 1, North, depth, shaftType)
  of South:
    generateAndAdd(startPieceBox, collector, random, bb.min.x, bb.min.y, bb.max.z + 1, South, depth, shaftType)
  of West:
    generateAndAdd(startPieceBox, collector, random, bb.min.x - 1, bb.min.y, bb.min.z, West, depth, shaftType)
  of East:
    generateAndAdd(startPieceBox, collector, random, bb.max.x + 1, bb.min.y, bb.min.z, East, depth, shaftType)
  else:
    discard

proc mineshaftPosition*(context: var StructureGeneratorContext, isMesa: bool): StructurePosition =
  ## `<MineshaftGenerator as StructureGenerator>::get_structure_position`
  discard nextF64(context.random)
  let startX = context.chunkX shl 4
  let startZ = context.chunkZ shl 4
  let roomX = startX + 2
  let roomZ = startZ + 2
  let shaftType = if isMesa: MineshaftType.Mesa else: MineshaftType.Normal
  let startRoom = newMineShaftRoom(0'u32, context.random, roomX, roomZ, shaftType)
  let startPieceBox = startRoom.piece.boundingBox
  let collector = newStructurePiecesCollector()
  addPiece(collector, startRoom)
  addRoomChildren(startRoom, startPieceBox, shaftType, collector, context.random)
  var dy = 0'i32
  if isMesa:
    let bbox = getBoundingBox(collector)
    let centerX = midpointI32(bbox.min.x, bbox.max.x)
    let centerZ = midpointI32(bbox.min.z, bbox.max.z)
    let centerY = midpointI32(bbox.min.y, bbox.max.y)
    let surfaceHeight =
      if context.heightSampler == nil: context.seaLevel else: estimateHeight(context.heightSampler, centerX, centerZ)
    let targetY =
      if surfaceHeight <= context.seaLevel:
        context.seaLevel
      else:
        let range = surfaceHeight - context.seaLevel + 1
        context.seaLevel + nextBoundedI32(context.random, range)
    dy = targetY - centerY
    shift(collector, dy)
  else:
    dy = shiftInto(collector, context.seaLevel, context.minY, context.random, 10)
  StructurePosition(startPos: blockPos(startX + 8, 50 + dy, startZ), collector: collector)

proc isInInvalidLocation(pieceBb: BlockBox, chunk: ProtoChunk, chunkBox: BlockBox): bool =
  let x0 = max(pieceBb.min.x - 1, chunkBox.min.x)
  let y0 = max(pieceBb.min.y - 1, chunkBox.min.y)
  let z0 = max(pieceBb.min.z - 1, chunkBox.min.z)
  let x1 = min(pieceBb.max.x + 1, chunkBox.max.x)
  let y1 = min(pieceBb.max.y + 1, chunkBox.max.y)
  let z1 = min(pieceBb.max.z + 1, chunkBox.max.z)
  if x0 > x1 or y0 > y1 or z0 > z1:
    return false
  let midX = midpointI32(x0, x1)
  let midY = midpointI32(y0, y1)
  let midZ = midpointI32(z0, z1)
  if getBiome(chunk, midX shr 2, midY shr 2, midZ shr 2).registryId == "minecraft:deep_dark":
    return true
  for x in x0 .. x1:
    for z in z0 .. z1:
      if isLiquid(getBlockState(chunk, vec3[int32](x, y0, z))) or isLiquid(getBlockState(chunk, vec3[int32](x, y1, z))):
        return true
  for x in x0 .. x1:
    for y in y0 .. y1:
      if isLiquid(getBlockState(chunk, vec3[int32](x, y, z0))) or isLiquid(getBlockState(chunk, vec3[int32](x, y, z1))):
        return true
  for z in z0 .. z1:
    for y in y0 .. y1:
      if isLiquid(getBlockState(chunk, vec3[int32](x0, y, z))) or isLiquid(getBlockState(chunk, vec3[int32](x1, y, z))):
        return true
  false

proc entranceBoxes*(room: MineShaftRoom): seq[BlockBox] = room.childEntranceBoxes

proc translateRoom(self: StructurePieceBase, x, y, z: int32) {.nimcall.} =
  let room = cast[MineShaftRoom](self)
  movePos(room.piece.boundingBox, x, y, z)
  for i in 0 ..< room.childEntranceBoxes.len:
    movePos(room.childEntranceBoxes[i], x, y, z)

proc placeRoom(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
               seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let room = cast[MineShaftRoom](self)
  if isInInvalidLocation(room.piece.boundingBox, chunk, chunkBox):
    return
  let bb = room.piece.boundingBox
  let maxClearY = min(bb.min.y + 3, bb.max.y)
  for y in bb.min.y + 1 .. maxClearY:
    for x in bb.min.x .. bb.max.x:
      for z in bb.min.z .. bb.max.z:
        if contains(chunkBox, x, y, z):
          setBlockState(chunk, x, y, z, CaveAir)
  for i in 0 ..< room.childEntranceBoxes.len:
    let entrance = room.childEntranceBoxes[i]
    for y in entrance.max.y - 2 .. entrance.max.y:
      for x in entrance.min.x .. entrance.max.x:
        for z in entrance.min.z .. entrance.max.z:
          if contains(chunkBox, x, y, z):
            setBlockState(chunk, x, y, z, CaveAir)
  let diagX = float32(bb.max.x - bb.min.x + 1)
  let diagY = float32(bb.max.y - (bb.min.y + 4) + 1)
  let diagZ = float32(bb.max.z - bb.min.z + 1)
  let cx = float32(bb.min.x) + diagX / 2.0'f32
  let cz = float32(bb.min.z) + diagZ / 2.0'f32
  let y0 = bb.min.y + 4
  if diagY > 0.0'f32:
    for y in y0 .. bb.max.y:
      let ny = float32(y - y0) / diagY
      for x in bb.min.x .. bb.max.x:
        let nx = (float32(x) - cx) / (diagX * 0.5'f32)
        for z in bb.min.z .. bb.max.z:
          let nz = (float32(z) - cz) / (diagZ * 0.5'f32)
          if nx * nx + ny * ny + nz * nz <= 1.05'f32 and contains(chunkBox, x, y, z):
            setBlockState(chunk, x, y, z, CaveAir)

proc isInterior(self: MineShaftCorridor, chunk: ProtoChunk, x, y, z: int32, chunkBox: BlockBox): bool =
  let pos = offsetPos(self.piece, x, y + 1, z)
  containsPos(chunkBox, pos) and pos.y < getTopY(chunk, OceanFloorWg, pos.x, pos.z)

proc hasSturdyNeighbours(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, x, y, z, count: int32): bool =
  let worldPos = offsetPos(self.piece, x, y, z)
  var sturdy = 0'i32
  for dir in [Down, Up, North, South, West, East]:
    let step = toVector(dir)
    let neighborPos = vec3[int32](worldPos.x + step.x, worldPos.y + step.y, worldPos.z + step.z)
    if containsPos(chunkBox, neighborPos):
      if isSideSolid(getBlockState(chunk, neighborPos), ord(opposite(dir))):
        inc sturdy
        if sturdy >= count:
          return true
  false

proc maybePlaceCobweb(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, random: var RandomGenerator, prob: float32,
                      x, y, z: int32) =
  if isInterior(self, chunk, x, y, z, chunkBox) and nextF32(random) < prob and
      hasSturdyNeighbours(self, chunk, chunkBox, x, y, z, 2):
    addBlock(self.piece, chunk, Cobweb, x, y, z, chunkBox)

proc isSupportingBox(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, x0, x1, y1, z0: int32): bool =
  for x in x0 .. x1:
    let worldPos = offsetPos(self.piece, x, y1 + 1, z0)
    if not containsPos(chunkBox, worldPos):
      return false
    if isAir(getBlockState(chunk, worldPos)):
      return false
  true

proc placeSupport(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, x0, y0, z, y1, x1: int32,
                  random: var RandomGenerator) =
  if not isSupportingBox(self, chunk, chunkBox, x0, x1, y1, z):
    return
  let plank = planks(self.shaftType)
  let fenceW = stateWith(fenceBlockName(self.shaftType), [("west", "true")])
  let fenceE = stateWith(fenceBlockName(self.shaftType), [("east", "true")])
  fill(self.piece, chunk, chunkBox, x0, y0, z, x0, y1 - 1, z, fenceW)
  fill(self.piece, chunk, chunkBox, x1, y0, z, x1, y1 - 1, z, fenceE)
  if nextBoundedI32(random, 4) == 0:
    fill(self.piece, chunk, chunkBox, x0, y1, z, x0, y1, z, plank)
    fill(self.piece, chunk, chunkBox, x1, y1, z, x1, y1, z, plank)
  else:
    fill(self.piece, chunk, chunkBox, x0, y1, z, x1, y1, z, plank)
    if nextF32(random) < 0.05'f32:
      addBlock(self.piece, chunk, stateWith("wall_torch", [("facing", "south")]), x0 + 1, y1, z - 1, chunkBox)
    if nextF32(random) < 0.05'f32:
      addBlock(self.piece, chunk, stateWith("wall_torch", [("facing", "north")]), x0 + 1, y1, z + 1, chunkBox)

proc createChest*(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, random: var RandomGenerator, x, y, z: int32,
                 lootTable: string): bool =
  let pos = offsetPos(self.piece, x, y, z)
  if containsPos(chunkBox, pos):
    let state = getBlockState(chunk, pos)
    let belowState = getBlockState(chunk, vec3[int32](pos.x, pos.y - 1, pos.z))
    if isAir(state) and not isAir(belowState):
      let shape = if nextBool(random): "north_south" else: "east_west"
      addBlock(self.piece, chunk, stateWith("rail", [("shape", shape)]), x, y, z, chunkBox)
      let seedValue = nextI64(random)
      var nbt = newCompound()
      putString(nbt, "id", "minecraft:chest_minecart")
      putList(nbt, "Pos", @[nbtTag(float64(pos.x) + 0.5'f64), nbtTag(float64(pos.y) + 0.5'f64), nbtTag(float64(pos.z) + 0.5'f64)])
      putList(nbt, "Motion", @[nbtTag(0.0'f64), nbtTag(0.0'f64), nbtTag(0.0'f64)])
      putList(nbt, "Rotation", @[nbtTag(0.0'f32), nbtTag(0.0'f32)])
      putString(nbt, "LootTable", lootTable)
      if seedValue != 0:
        putLong(nbt, "LootTableSeed", seedValue)
      addStructureEntity(chunk, nbt)
      return true
  false

proc setPlanksBlock(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, plank: BlockStateId, x, y, z: int32) =
  if not isInterior(self, chunk, x, y, z, chunkBox):
    return
  let pos = offsetPos(self.piece, x, y, z)
  if not isSideSolid(getBlockState(chunk, pos), ord(Up)):
    setBlockState(chunk, pos.x, pos.y, pos.z, plank)

proc fillPillarDownOrChainUp(self: MineShaftCorridor, chunk: ProtoChunk, pillarState: BlockStateId, x, y, z: int32,
                             chunkBox: BlockBox) =
  let worldPos = offsetPos(self.piece, x, y, z)
  if not containsPos(chunkBox, worldPos):
    return
  let worldY = worldPos.y
  var distanceFromWorldY = 1'i32
  var checkBelow = true
  var checkAbove = true
  let minY = int32(bottomY(chunk))
  let maxY = int32(bottomY(chunk)) + int32(height(chunk)) - 1
  while checkBelow or checkAbove:
    if checkBelow:
      let belowY = worldY - distanceFromWorldY
      let belowState = getBlockState(chunk, vec3[int32](worldPos.x, belowY, worldPos.z))
      let emptyBelow = isReplaceableByStructures(belowState) and blockIdOf(belowState) != LavaBlock
      if not emptyBelow and isSideSolid(belowState, ord(Up)):
        var py = belowY + 1
        while py < worldY:
          setBlockState(chunk, worldPos.x, py, worldPos.z, pillarState)
          inc py
        return
      checkBelow = distanceFromWorldY <= 20 and emptyBelow and belowY > minY + 1
    if checkAbove:
      let aboveY = worldY + distanceFromWorldY
      let aboveState = getBlockState(chunk, vec3[int32](worldPos.x, aboveY, worldPos.z))
      let emptyAbove = isReplaceableByStructures(aboveState)
      if not emptyAbove and isCenterSolid(aboveState, ord(Down)) and not isFallingBlock(blockIdOf(aboveState)):
        setBlockState(chunk, worldPos.x, worldY + 1, worldPos.z, fence(self.shaftType))
        var py = worldY + 2
        while py < aboveY:
          setBlockState(chunk, worldPos.x, py, worldPos.z, IronChain)
          inc py
        return
      checkAbove = distanceFromWorldY <= 50 and emptyAbove and aboveY < maxY
    inc distanceFromWorldY

proc placeDoubleLowerOrUpperSupport(self: MineShaftCorridor, chunk: ProtoChunk, chunkBox: BlockBox, x, y, z: int32) =
  let woodState = wood(self.shaftType)
  let planksId = blockIdOf(planks(self.shaftType))
  let pos1 = offsetPos(self.piece, x, y, z)
  if containsPos(chunkBox, pos1) and blockIdOf(getBlockState(chunk, pos1)) == planksId:
    fillPillarDownOrChainUp(self, chunk, woodState, x, y, z, chunkBox)
  let pos2 = offsetPos(self.piece, x + 2, y, z)
  if containsPos(chunkBox, pos2) and blockIdOf(getBlockState(chunk, pos2)) == planksId:
    fillPillarDownOrChainUp(self, chunk, woodState, x + 2, y, z, chunkBox)

proc placeCorridor(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                   seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let c = cast[MineShaftCorridor](self)
  if isInInvalidLocation(c.piece.boundingBox, chunk, chunkBox):
    return
  let length = c.numSections * 5 - 1
  let plank = planks(c.shaftType)
  fill(c.piece, chunk, chunkBox, 0, 0, 0, 2, 1, length, CaveAir)
  for x in 0'i32 .. 2'i32:
    for z in 0'i32 .. length:
      if nextF32(random) <= 0.8'f32:
        addBlock(c.piece, chunk, CaveAir, x, 2, z, chunkBox)
  if c.spiderCorridor:
    for y in 0'i32 .. 1'i32:
      for x in 0'i32 .. 2'i32:
        for z in 0'i32 .. length:
          if nextF32(random) <= 0.6'f32 and isInterior(c, chunk, x, y, z, chunkBox):
            addBlock(c.piece, chunk, Cobweb, x, y, z, chunkBox)
  var section = 0'i32
  while section < c.numSections:
    let z = 2 + section * 5
    placeSupport(c, chunk, chunkBox, 0, 0, z, 2, 2, random)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.1'f32, 0, 2, z - 1)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.1'f32, 2, 2, z - 1)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.1'f32, 0, 2, z + 1)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.1'f32, 2, 2, z + 1)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.05'f32, 0, 2, z - 2)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.05'f32, 2, 2, z - 2)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.05'f32, 0, 2, z + 2)
    maybePlaceCobweb(c, chunk, chunkBox, random, 0.05'f32, 2, 2, z + 2)
    if nextBoundedI32(random, 100) == 0:
      discard createChest(c, chunk, chunkBox, random, 2, 0, z - 1, AbandonedMineshaftLoot)
    if nextBoundedI32(random, 100) == 0:
      discard createChest(c, chunk, chunkBox, random, 0, 0, z + 1, AbandonedMineshaftLoot)
    if c.spiderCorridor and not c.hasPlacedSpider:
      let spawnerZ = z - 1 + nextBoundedI32(random, 3)
      let spawnerPos = offsetPos(c.piece, 1, 0, spawnerZ)
      if containsPos(chunkBox, spawnerPos) and isInterior(c, chunk, 1, 0, spawnerZ, chunkBox):
        c.hasPlacedSpider = true
        setBlockState(chunk, spawnerPos.x, spawnerPos.y, spawnerPos.z, Spawner)
        var nbt = newCompound()
        putString(nbt, "id", "minecraft:mob_spawner")
        putInt(nbt, "x", spawnerPos.x)
        putInt(nbt, "y", spawnerPos.y)
        putInt(nbt, "z", spawnerPos.z)
        var entity = newCompound()
        putString(entity, "id", "minecraft:cave_spider")
        var spawnData = newCompound()
        putCompound(spawnData, "entity", entity)
        putCompound(nbt, "SpawnData", spawnData)
        addBlockEntity(chunk, nbt)
    inc section
  for x in 0'i32 .. 2'i32:
    for z2 in 0'i32 .. length:
      setPlanksBlock(c, chunk, chunkBox, plank, x, -1, z2)
  placeDoubleLowerOrUpperSupport(c, chunk, chunkBox, 0, -1, 2)
  if c.numSections > 1:
    placeDoubleLowerOrUpperSupport(c, chunk, chunkBox, 0, -1, length - 2)
  if c.hasRails:
    let railState = stateWith("rail", [("shape", "north_south")])
    for z3 in 0'i32 .. length:
      let floorPos = offsetPos(c.piece, 1, -1, z3)
      let floorState = if containsPos(chunkBox, floorPos): getBlockState(chunk, floorPos) else: AirStateId
      if not isAir(floorState) and isFullCube(floorState):
        let prob = if isInterior(c, chunk, 1, 0, z3, chunkBox): 0.7'f32 else: 0.9'f32
        if nextF32(random) < prob:
          addBlock(c.piece, chunk, railState, 1, 0, z3, chunkBox)

proc clearCross(chunk: ProtoChunk, chunkBox, bb: BlockBox, y: int32) =
  ## The two `for` pairs each of upstream's crossing clears repeats.
  var x = bb.min.x + 1
  while x < bb.max.x:
    for z in bb.min.z .. bb.max.z:
      if contains(chunkBox, x, y, z):
        setBlockState(chunk, x, y, z, CaveAir)
    inc x
  for x2 in bb.min.x .. bb.max.x:
    var z = bb.min.z + 1
    while z < bb.max.z:
      if contains(chunkBox, x2, y, z):
        setBlockState(chunk, x2, y, z, CaveAir)
      inc z

proc placeCrossing(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                   seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let c = cast[MineShaftCrossing](self)
  if isInInvalidLocation(c.piece.boundingBox, chunk, chunkBox):
    return
  let plank = planks(c.shaftType)
  let bb = c.piece.boundingBox
  if c.isTwoFloored:
    for y in bb.min.y .. bb.min.y + 2:
      clearCross(chunk, chunkBox, bb, y)
    for y in bb.max.y - 2 .. bb.max.y:
      clearCross(chunk, chunkBox, bb, y)
    let midY = bb.min.y + 3
    var x = bb.min.x + 1
    while x < bb.max.x:
      var z = bb.min.z + 1
      while z < bb.max.z:
        if contains(chunkBox, x, midY, z):
          setBlockState(chunk, x, midY, z, CaveAir)
        inc z
      inc x
  else:
    for y in bb.min.y .. bb.max.y:
      clearCross(chunk, chunkBox, bb, y)

  for (cx, cz) in [(bb.min.x + 1, bb.min.z + 1), (bb.min.x + 1, bb.max.z - 1), (bb.max.x - 1, bb.min.z + 1),
      (bb.max.x - 1, bb.max.z - 1)]:
    let abovePos = vec3[int32](cx, bb.max.y + 1, cz)
    if containsPos(chunkBox, abovePos) and not isAir(getBlockState(chunk, abovePos)):
      for py in bb.min.y .. bb.max.y:
        if contains(chunkBox, cx, py, cz):
          setBlockState(chunk, cx, py, cz, plank)

  let floorY = bb.min.y - 1
  for x in bb.min.x .. bb.max.x:
    for z in bb.min.z .. bb.max.z:
      let insidePos = vec3[int32](x, bb.min.y, z)
      if containsPos(chunkBox, insidePos) and insidePos.y < getTopY(chunk, OceanFloorWg, insidePos.x, insidePos.z):
        let state = getBlockState(chunk, vec3[int32](x, floorY, z))
        if not isSideSolid(state, ord(Up)):
          setBlockState(chunk, x, floorY, z, plank)

proc placeStairs(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                 seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[MineShaftStairs](self)
  if isInInvalidLocation(s.piece.boundingBox, chunk, chunkBox):
    return
  fill(s.piece, chunk, chunkBox, 0, 5, 0, 2, 7, 1, CaveAir)
  fill(s.piece, chunk, chunkBox, 0, 0, 7, 2, 2, 8, CaveAir)
  for i in 0'i32 ..< 5'i32:
    let yMin = 5 - i - (if i < 4: 1'i32 else: 0'i32)
    let yMax = 7 - i
    let z = 2 + i
    fill(s.piece, chunk, chunkBox, 0, yMin, z, 2, yMax, z, CaveAir)
