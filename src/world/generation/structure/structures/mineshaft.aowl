## Port of pumpkin-world/src/generation/structure/structures/mineshaft.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/mineshaft.rs - the pinned tree's piece is one fixed crossing in a
## 33-wide box. Starts match the vanilla save, 27 of 27; its boxes and pieces do not, so references fall short (98 of 829).
## ../ref/pumpkin has the real one, 2072 lines, not ported.

{.feature: "lenientnils".}

import structuresmod

type
  MineshaftPiece = ref object of StructurePieceBase
    isMesa: bool

let
  AirState = blockState("air")
  RailState = blockState("rail")
  OakPlanksState = blockState("oak_planks")
  DarkOakPlanksState = blockState("dark_oak_planks")
  OakFenceState = blockState("oak_fence")
  DarkOakFenceState = blockState("dark_oak_fence")

proc placeMineshaft(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[MineshaftPiece](self)
  let origin = p.piece.boundingBox.min
  let startY = 15'i32
  let woodPlanks = if p.isMesa: DarkOakPlanksState else: OakPlanksState
  let woodFence = if p.isMesa: DarkOakFenceState else: OakFenceState
  var y = startY
  while y < startY + 3:
    var x = origin.x - 12
    while x <= origin.x + 12:
      var z = origin.z - 12
      while z <= origin.z + 12:
        let inCenter = abs(x - origin.x) <= 2 and abs(z - origin.z) <= 2
        let inNsCorridor = abs(x - origin.x) <= 1
        let inEwCorridor = abs(z - origin.z) <= 1
        if (inCenter or inNsCorridor or inEwCorridor) and contains(chunkBox, x, y, z):
          setBlockState(chunk, x, y, z, AirState)
          if abs(x - origin.x) == 2 and y == startY:
            setBlockState(chunk, x, y, z, woodFence)
          if abs(z - origin.z) == 2 and y == startY:
            setBlockState(chunk, x, y, z, woodFence)
        inc z
      inc x
    inc y
  var x = origin.x - 12
  while x <= origin.x + 12:
    let z = origin.z
    if contains(chunkBox, x, startY, z):
      setBlockState(chunk, x, startY, z, RailState)
    if x mod 5 == 0:
      var sy = startY
      while sy <= startY + 2:
        if contains(chunkBox, x, sy, z - 1):
          setBlockState(chunk, x, sy, z - 1, woodFence)
        if contains(chunkBox, x, sy, z + 1):
          setBlockState(chunk, x, sy, z + 1, woodFence)
        inc sy
      if contains(chunkBox, x, startY + 2, z):
        setBlockState(chunk, x, startY + 2, z, woodPlanks)
    inc x

proc mineshaftPosition*(context: var StructureGeneratorContext, isMesa: bool): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let boundingBox = newBlockBox(chunkCenterX - 16, context.minY, chunkCenterZ - 16, chunkCenterX + 16, 256, chunkCenterZ + 16)
  let piece = MineshaftPiece(piece: newStructurePiece(StructurePieceType.MineshaftCrossing, boundingBox, 0),
    placeFn: placeMineshaft, isMesa: isMesa)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
