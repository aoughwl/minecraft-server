## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  BridgePiece* = ref object of NetherFortressPiece

proc fillBridgePiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 1, 3, false)

proc placeBridgePiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgePiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 0, 3, 0, 4, 4, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 5, 0, 3, 7, 18, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 0, 5, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 5, 0, 4, 5, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 4, 2, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 13, 4, 2, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 4, 1, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 0, 15, 4, 1, 18, nb, nb)
  for i in int32(0) .. int32(4):
    for j in int32(0) .. int32(2):
      fillDownwards(p, chunk, nb, i, -1, j, bb)
      fillDownwards(p, chunk, nb, i, -1, 18 - j, bb)
  let fenceEast = stateWith("nether_brick_fence", [("east", "true"), ("north", "true"), ("south", "true")])
  let fenceWest = stateWith("nether_brick_fence", [("north", "true"), ("south", "true"), ("east", "false"), ("west", "true")])
  fillWithOutline(p, chunk, bb, false, 0, 1, 1, 0, 4, 1, fenceEast, fenceEast)
  fillWithOutline(p, chunk, bb, false, 0, 3, 4, 0, 4, 4, fenceEast, fenceEast)
  fillWithOutline(p, chunk, bb, false, 0, 3, 14, 0, 4, 14, fenceEast, fenceEast)
  fillWithOutline(p, chunk, bb, false, 0, 1, 17, 0, 4, 17, fenceEast, fenceEast)
  fillWithOutline(p, chunk, bb, false, 4, 1, 1, 4, 4, 1, fenceWest, fenceWest)
  fillWithOutline(p, chunk, bb, false, 4, 3, 4, 4, 4, 4, fenceWest, fenceWest)
  fillWithOutline(p, chunk, bb, false, 4, 3, 14, 4, 4, 14, fenceWest, fenceWest)
  fillWithOutline(p, chunk, bb, false, 4, 1, 17, 4, 4, 17, fenceWest, fenceWest)

proc createBridgePiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -3, 0, 5, 10, 19, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = BridgePiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridge, bbox, chainLength), placeFn: placeBridgePiece, fillFn: fillBridgePiece)
  setFacing(result.piece, orientation)
