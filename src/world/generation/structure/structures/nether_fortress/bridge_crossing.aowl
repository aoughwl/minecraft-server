## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge_crossing.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  BridgeCrossingPiece* = ref object of NetherFortressPiece

proc fillBridgeCrossingPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 8, 3, false)
  fillNwOpening(self, ctx, last, 3, 8, false)
  fillSeOpening(self, ctx, last, 3, 8, false)

proc placeBridgeCrossingPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgeCrossingPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 7, 3, 0, 11, 4, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 3, 7, 18, 4, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 5, 0, 10, 7, 18, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 5, 8, 18, 7, 10, air, air)
  fillWithOutline(p, chunk, bb, false, 7, 5, 0, 7, 5, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 7, 5, 11, 7, 5, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 0, 11, 5, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 11, 11, 5, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 7, 7, 5, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 7, 18, 5, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 11, 7, 5, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 11, 18, 5, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 7, 2, 0, 11, 2, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 7, 2, 13, 11, 2, 18, nb, nb)
  fillWithOutline(p, chunk, bb, false, 7, 0, 0, 11, 1, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 7, 0, 15, 11, 1, 18, nb, nb)
  for i in int32(7) .. int32(11):
    for j in int32(0) .. int32(2):
      fillDownwards(p, chunk, nb, i, -1, j, bb)
      fillDownwards(p, chunk, nb, i, -1, 18 - j, bb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 7, 5, 2, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 13, 2, 7, 18, 2, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 0, 7, 3, 1, 11, nb, nb)
  fillWithOutline(p, chunk, bb, false, 15, 0, 7, 18, 1, 11, nb, nb)
  for i in int32(0) .. int32(2):
    for j in int32(7) .. int32(11):
      fillDownwards(p, chunk, nb, i, -1, j, bb)
      fillDownwards(p, chunk, nb, i, -1, 18 - j, bb)

proc newBridgeCrossingStart*(random: var RandomGenerator, x, z: int32): NetherFortressPiece =
  ## `BridgeCrossingPiece::new_start`: the very first piece, at a fixed y=64.
  let orientation = getRandomHorizontalDirection(random)
  let bbox = createBox(BlockBox, x, 64, z, getAxis(orientation), 19, 10, 19)
  result = BridgeCrossingPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgeCrossing, bbox, 0), placeFn: placeBridgeCrossingPiece, fillFn: fillBridgeCrossingPiece)
  setFacing(result.piece, orientation)

proc createBridgeCrossingPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -8, -3, 0, 19, 10, 19, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = BridgeCrossingPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgeCrossing, bbox, chainLength), placeFn: placeBridgeCrossingPiece, fillFn: fillBridgeCrossingPiece)
  setFacing(result.piece, orientation)
