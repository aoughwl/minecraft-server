## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge_end.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase
import ../../../../../util/xoroshiro128

type
  BridgeEndPiece* = ref object of NetherFortressPiece
    seed*: uint32

proc placeBridgeEndPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgeEndPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  var rng = toRandomGenerator(xoroshiro128.fromSeed(uint64(s.seed)))
  for i in int32(0) .. int32(4):
    for j in int32(3) .. int32(4):
      let k = nextBoundedI32(rng, 8)
      fillWithOutline(p, chunk, bb, false, i, j, 0, i, j, k, nb, nb)
  let k0 = nextBoundedI32(rng, 8)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 0, 5, k0, nb, nb)
  let k1 = nextBoundedI32(rng, 8)
  fillWithOutline(p, chunk, bb, false, 4, 5, 0, 4, 5, k1, nb, nb)
  for i in int32(0) .. int32(4):
    let j = nextBoundedI32(rng, 5)
    fillWithOutline(p, chunk, bb, false, i, 2, 0, i, 2, j, nb, nb)
  for i in int32(0) .. int32(4):
    for j in int32(0) .. int32(1):
      let k = nextBoundedI32(rng, 3)
      fillWithOutline(p, chunk, bb, false, i, j, 0, i, j, k, nb, nb)

proc createBridgeEndPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -3, 0, 5, 10, 8, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let pieceSeed = cast[uint32](nextI32(ctx.random))
  result = BridgeEndPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgeEnd, bbox, chainLength), placeFn: placeBridgeEndPiece, fillFn: nil, seed: pieceSeed)
  setFacing(result.piece, orientation)
