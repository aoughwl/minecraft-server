## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge_platform.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  BridgePlatformPiece* = ref object of NetherFortressPiece
    hasBlazeSpawner*: bool

proc placeBridgePlatformPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgePlatformPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 6, 7, 7, air, air)
  fillWithOutline(p, chunk, bb, false, 1, 0, 0, 5, 1, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 2, 1, 5, 2, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 3, 2, 5, 3, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 4, 3, 5, 4, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 2, 0, 1, 4, 2, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 2, 0, 5, 4, 2, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 5, 2, 1, 5, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 5, 2, 5, 5, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 3, 0, 5, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 5, 3, 6, 5, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 5, 8, 5, 5, 8, nb, nb)
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  addBlock(p, chunk, fence(true, false, false, false), 1, 6, 3, bb)
  addBlock(p, chunk, fence(false, true, false, false), 5, 6, 3, bb)
  addBlock(p, chunk, fence(false, true, true, false), 0, 6, 3, bb)
  addBlock(p, chunk, fence(true, false, true, false), 6, 6, 3, bb)
  fillWithOutline(p, chunk, bb, false, 0, 6, 4, 0, 6, 7, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 6, 6, 4, 6, 6, 7, fNs, fNs)
  addBlock(p, chunk, fence(false, true, false, true), 0, 6, 8, bb)
  addBlock(p, chunk, fence(true, false, false, true), 6, 6, 8, bb)
  fillWithOutline(p, chunk, bb, false, 1, 6, 8, 5, 6, 8, fEw, fEw)
  addBlock(p, chunk, fence(false, true, false, false), 1, 7, 8, bb)
  fillWithOutline(p, chunk, bb, false, 2, 7, 8, 4, 7, 8, fEw, fEw)
  addBlock(p, chunk, fence(true, false, false, false), 5, 7, 8, bb)
  addBlock(p, chunk, fence(false, true, false, false), 2, 8, 8, bb)
  addBlock(p, chunk, fEw, 3, 8, 8, bb)
  addBlock(p, chunk, fence(true, false, false, false), 4, 8, 8, bb)
  if not s.hasBlazeSpawner:
    let spawnerPos = offsetPos(p, 3, 5, 5)
    if containsPos(bb, spawnerPos):
      s.hasBlazeSpawner = true
      setBlockState(chunk, spawnerPos.x, spawnerPos.y, spawnerPos.z, blockState("spawner"))
      var entityNbt = newCompound()
      putString(entityNbt, "id", "minecraft:mob_spawner")
      putInt(entityNbt, "x", spawnerPos.x)
      putInt(entityNbt, "y", spawnerPos.y)
      putInt(entityNbt, "z", spawnerPos.z)
      var spawnEntry = newCompound()
      var entityNbtInner = newCompound()
      putString(entityNbtInner, "id", "minecraft:blaze")
      putCompound(spawnEntry, "entity", entityNbtInner)
      putCompound(entityNbt, "SpawnData", spawnEntry)
      addBlockEntity(chunk, entityNbt)
  for i in int32(0) .. int32(6):
    for j in int32(0) .. int32(6):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createBridgePlatformPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -2, 0, 0, 7, 8, 9, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = BridgePlatformPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgePlatform, bbox, chainLength), placeFn: placeBridgePlatformPiece, fillFn: nil, hasBlazeSpawner: false)
  setFacing(result.piece, orientation)
