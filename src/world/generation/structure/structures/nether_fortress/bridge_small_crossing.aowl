## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge_small_crossing.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  BridgeSmallCrossingPiece* = ref object of NetherFortressPiece

proc fillBridgeSmallCrossingPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 2, 0, false)
  fillNwOpening(self, ctx, last, 0, 2, false)
  fillSeOpening(self, ctx, last, 0, 2, false)

proc placeBridgeSmallCrossingPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgeSmallCrossingPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 6, 1, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 6, 7, 6, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 1, 6, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 6, 1, 6, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 2, 0, 6, 6, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 2, 6, 6, 6, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 0, 6, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 5, 0, 6, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 2, 0, 6, 6, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 2, 5, 6, 6, 6, nb, nb)
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  fillWithOutline(p, chunk, bb, false, 2, 6, 0, 4, 6, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 0, 4, 5, 0, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 2, 6, 6, 4, 6, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 6, 4, 5, 6, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 0, 6, 2, 0, 6, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 2, 0, 5, 4, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 6, 6, 2, 6, 6, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 5, 2, 6, 5, 4, fNs, fNs)
  for i in int32(0) .. int32(6):
    for j in int32(0) .. int32(6):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createBridgeSmallCrossingPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -2, 0, 0, 7, 9, 7, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = BridgeSmallCrossingPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgeSmallCrossing, bbox, chainLength), placeFn: placeBridgeSmallCrossingPiece, fillFn: fillBridgeSmallCrossingPiece)
  setFacing(result.piece, orientation)
