## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/bridge_stairs.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  BridgeStairsPiece* = ref object of NetherFortressPiece

proc fillBridgeStairsPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillSeOpening(self, ctx, last, 6, 2, false)

proc placeBridgeStairsPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[BridgeStairsPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 6, 1, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 6, 10, 6, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 1, 8, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 2, 0, 6, 8, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 1, 0, 8, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 2, 1, 6, 8, 6, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 2, 6, 5, 8, 6, nb, nb)
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  fillWithOutline(p, chunk, bb, false, 0, 3, 2, 0, 5, 4, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 6, 3, 2, 6, 5, 2, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 6, 3, 4, 6, 5, 4, fNs, fNs)
  addBlock(p, chunk, nb, 5, 2, 5, bb)
  fillWithOutline(p, chunk, bb, false, 4, 2, 5, 4, 3, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 3, 2, 5, 3, 4, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 2, 5, 2, 5, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 2, 5, 1, 6, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 7, 1, 5, 7, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 8, 2, 6, 8, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 2, 6, 0, 4, 8, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 0, 4, 5, 0, fEw, fEw)
  for i in int32(0) .. int32(6):
    for j in int32(0) .. int32(6):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createBridgeStairsPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -2, 0, 0, 7, 11, 7, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = BridgeStairsPiece(piece: newStructurePiece(StructurePieceType.NetherFortressBridgeStairs, bbox, chainLength), placeFn: placeBridgeStairsPiece, fillFn: fillBridgeStairsPiece)
  setFacing(result.piece, orientation)
