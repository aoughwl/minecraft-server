## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_balcony.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorBalconyPiece* = ref object of NetherFortressPiece

proc fillCorridorBalconyPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  let i = if self.piece.hasFacing and (self.piece.facing == West or self.piece.facing == North): 5'i32 else: 1'i32
  let nwBlocked = nextBoundedI32(ctx.random, 8) > 0
  let seBlocked = nextBoundedI32(ctx.random, 8) > 0
  fillNwOpening(self, ctx, last, 0, i, nwBlocked)
  fillSeOpening(self, ctx, last, 0, i, seBlocked)

proc placeCorridorBalconyPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorBalconyPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let fNs = fence(false, false, true, true)
  let fEw = fence(true, true, false, false)
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 8, 1, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 8, 5, 8, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 6, 0, 8, 6, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 2, 5, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 2, 0, 8, 5, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 3, 0, 1, 4, 0, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 7, 3, 0, 7, 4, 0, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 0, 2, 4, 8, 2, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 1, 4, 2, 2, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 6, 1, 4, 7, 2, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 1, 3, 8, 7, 3, 8, fEw, fEw)
  addBlock(p, chunk, fence(false, true, false, true), 0, 3, 8, bb)
  addBlock(p, chunk, fence(true, false, false, true), 8, 3, 8, bb)
  fillWithOutline(p, chunk, bb, false, 0, 3, 6, 0, 3, 7, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 8, 3, 6, 8, 3, 7, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 0, 3, 4, 0, 5, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 3, 4, 8, 5, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 3, 5, 2, 5, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 3, 5, 7, 5, 5, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 4, 5, 1, 5, 5, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 7, 4, 5, 7, 5, 5, fEw, fEw)
  for i in int32(0) .. int32(5):
    for j in int32(0) .. int32(8):
      fillDownwards(p, chunk, nb, j, -1, i, bb)

proc createCorridorBalconyPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -3, 0, 0, 9, 7, 9, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = CorridorBalconyPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorBalcony, bbox, chainLength), placeFn: placeCorridorBalconyPiece, fillFn: fillCorridorBalconyPiece)
  setFacing(result.piece, orientation)
