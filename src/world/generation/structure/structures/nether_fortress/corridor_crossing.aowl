## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_crossing.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorCrossingPiece* = ref object of NetherFortressPiece

proc fillCorridorCrossingPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 1, 0, true)
  fillNwOpening(self, ctx, last, 0, 1, true)
  fillSeOpening(self, ctx, last, 0, 1, true)

proc placeCorridorCrossingPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorCrossingPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 4, 1, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 4, 5, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 0, 5, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 2, 0, 4, 5, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 4, 0, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 2, 4, 4, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 6, 0, 4, 6, 4, nb, nb)
  for i in int32(0) .. int32(4):
    for j in int32(0) .. int32(4):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createCorridorCrossingPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, 0, 0, 5, 7, 5, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = CorridorCrossingPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorCrossing, bbox, chainLength), placeFn: placeCorridorCrossingPiece, fillFn: fillCorridorCrossingPiece)
  setFacing(result.piece, orientation)
