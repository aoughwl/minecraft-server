## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_exit.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorExitPiece* = ref object of NetherFortressPiece

proc fillCorridorExitPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 5, 3, true)

proc placeCorridorExitPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorExitPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  fillWithOutline(p, chunk, bb, false, 0, 3, 0, 12, 4, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 12, 13, 12, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 1, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 0, 12, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 11, 4, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 5, 11, 10, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 9, 11, 7, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 0, 4, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 5, 0, 10, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 9, 0, 7, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 11, 2, 10, 12, 10, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 8, 0, 7, 8, 0, blockState("nether_brick_fence"), blockState("nether_brick_fence"))
  var i = 1'i32
  while i <= 11:
    fillWithOutline(p, chunk, bb, false, i, 10, 0, i, 11, 0, fEw, fEw)
    fillWithOutline(p, chunk, bb, false, i, 10, 12, i, 11, 12, fEw, fEw)
    fillWithOutline(p, chunk, bb, false, 0, 10, i, 0, 11, i, fNs, fNs)
    fillWithOutline(p, chunk, bb, false, 12, 10, i, 12, 11, i, fNs, fNs)
    addBlock(p, chunk, nb, i, 13, 0, bb)
    addBlock(p, chunk, nb, i, 13, 12, bb)
    addBlock(p, chunk, nb, 0, 13, i, bb)
    addBlock(p, chunk, nb, 12, 13, i, bb)
    if i != 11:
      addBlock(p, chunk, fEw, i + 1, 13, 0, bb)
      addBlock(p, chunk, fEw, i + 1, 13, 12, bb)
      addBlock(p, chunk, fNs, 0, 13, i + 1, bb)
      addBlock(p, chunk, fNs, 12, 13, i + 1, bb)
    i += 2
  addBlock(p, chunk, fence(false, true, true, false), 0, 13, 0, bb)
  addBlock(p, chunk, fence(false, true, false, true), 0, 13, 12, bb)
  addBlock(p, chunk, fence(true, false, false, true), 12, 13, 12, bb)
  addBlock(p, chunk, fence(true, false, true, false), 12, 13, 0, bb)
  i = 3'i32
  while i <= 9:
    fillWithOutline(p, chunk, bb, false, 1, 7, i, 1, 8, i, fence(false, false, true, true), fence(false, false, true, true))
    fillWithOutline(p, chunk, bb, false, 11, 7, i, 11, 8, i, fence(false, false, true, true), fence(false, false, true, true))
    i += 2
  fillWithOutline(p, chunk, bb, false, 4, 2, 0, 8, 2, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 4, 12, 2, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 0, 0, 8, 1, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 0, 9, 8, 1, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 0, 4, 3, 1, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 9, 0, 4, 12, 1, 8, nb, nb)
  for i in int32(4) .. int32(8):
    for j in int32(0) .. int32(2):
      fillDownwards(p, chunk, nb, i, -1, j, bb)
      fillDownwards(p, chunk, nb, i, -1, 12 - j, bb)
  for i in int32(0) .. int32(2):
    for j in int32(4) .. int32(8):
      fillDownwards(p, chunk, nb, i, -1, j, bb)
      fillDownwards(p, chunk, nb, 12 - i, -1, j, bb)
  fillWithOutline(p, chunk, bb, false, 5, 5, 5, 7, 5, 7, nb, nb)
  fillWithOutline(p, chunk, bb, false, 6, 1, 6, 6, 4, 6, air, air)
  addBlock(p, chunk, nb, 6, 0, 6, bb)
  addBlock(p, chunk, blockState("lava"), 6, 5, 6, bb)

proc createCorridorExitPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -5, -3, 0, 13, 14, 13, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = CorridorExitPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorExit, bbox, chainLength), placeFn: placeCorridorExitPiece, fillFn: fillCorridorExitPiece)
  setFacing(result.piece, orientation)
