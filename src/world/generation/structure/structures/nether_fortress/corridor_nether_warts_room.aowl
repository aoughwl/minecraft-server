## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_nether_warts_room.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorNetherWartsRoomPiece* = ref object of NetherFortressPiece

proc fillCorridorNetherWartsRoomPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 5, 3, true)
  fillForwardOpening(self, ctx, last, 5, 11, true)

proc placeCorridorNetherWartsRoomPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorNetherWartsRoomPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  let fNsWest = fence(true, false, true, true)
  let fNsEast = fence(false, true, true, true)
  fillWithOutline(p, chunk, bb, false, 0, 3, 0, 12, 4, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 12, 13, 12, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 5, 0, 1, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 11, 5, 0, 12, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 11, 4, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 5, 11, 10, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 9, 11, 7, 12, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 0, 4, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 8, 5, 0, 10, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 5, 9, 0, 7, 12, 1, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 11, 2, 10, 12, 10, nb, nb)
  var i = 1'i32
  while i <= 11:
    fillWithOutline(p, chunk, bb, false, i, 10, 0, i, 11, 0, fEw, fEw)
    fillWithOutline(p, chunk, bb, false, i, 10, 12, i, 11, 12, fEw, fEw)
    fillWithOutline(p, chunk, bb, false, 0, 10, i, 0, 11, i, fNs, fNs)
    fillWithOutline(p, chunk, bb, false, 12, 10, i, 12, 11, i, fNs, fNs)
    addBlock(p, chunk, nb, i, 13, 0, bb)
    addBlock(p, chunk, nb, i, 13, 12, bb)
    addBlock(p, chunk, nb, 0, 13, i, bb)
    addBlock(p, chunk, nb, 12, 13, i, bb)
    if i != 11:
      addBlock(p, chunk, fEw, i + 1, 13, 0, bb)
      addBlock(p, chunk, fEw, i + 1, 13, 12, bb)
      addBlock(p, chunk, fNs, 0, 13, i + 1, bb)
      addBlock(p, chunk, fNs, 12, 13, i + 1, bb)
    i += 2
  addBlock(p, chunk, fence(false, true, true, false), 0, 13, 0, bb)
  addBlock(p, chunk, fence(false, true, false, true), 0, 13, 12, bb)
  addBlock(p, chunk, fence(true, false, false, true), 12, 13, 12, bb)
  addBlock(p, chunk, fence(true, false, true, false), 12, 13, 0, bb)
  i = 3'i32
  while i <= 9:
    fillWithOutline(p, chunk, bb, false, 1, 7, i, 1, 8, i, fNsWest, fNsWest)
    fillWithOutline(p, chunk, bb, false, 11, 7, i, 11, 8, i, fNsEast, fNsEast)
    i += 2
  let stairN = stateWith("nether_brick_stairs", [("facing", "north")])
  let stairE = stateWith("nether_brick_stairs", [("facing", "east")])
  let stairW = stateWith("nether_brick_stairs", [("facing", "west")])
  for j in int32(0) .. int32(6):
    let k = j + 4
    for l in int32(5) .. int32(7):
      addBlock(p, chunk, stairN, l, 5 + j, k, bb)
    if k >= 5 and k <= 8:
      fillWithOutline(p, chunk, bb, false, 5, 5, k, 7, j + 4, k, nb, nb)
    elif k >= 9 and k <= 10:
      fillWithOutline(p, chunk, bb, false, 5, 8, k, 7, j + 4, k, nb, nb)
    if j >= 1:
      fillWithOutline(p, chunk, bb, false, 5, 6 + j, k, 7, 9 + j, k, air, air)
  for l in int32(5) .. int32(7):
    addBlock(p, chunk, stairN, l, 12, 11, bb)
  fillWithOutline(p, chunk, bb, false, 5, 6, 7, 5, 7, 7, fNsEast, fNsEast)
  fillWithOutline(p, chunk, bb, false, 7, 6, 7, 7, 7, 7, fNsWest, fNsWest)
  fillWithOutline(p, chunk, bb, false, 5, 13, 12, 7, 13, 12, air, air)
  fillWithOutline(p, chunk, bb, false, 2, 5, 2, 3, 5, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 9, 3, 5, 10, nb, nb)
  fillWithOutline(p, chunk, bb, false, 2, 5, 4, 2, 5, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 9, 5, 2, 10, 5, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 9, 5, 9, 10, 5, 10, nb, nb)
  fillWithOutline(p, chunk, bb, false, 10, 5, 4, 10, 5, 8, nb, nb)
  addBlock(p, chunk, stairW, 4, 5, 2, bb)
  addBlock(p, chunk, stairW, 4, 5, 3, bb)
  addBlock(p, chunk, stairW, 4, 5, 9, bb)
  addBlock(p, chunk, stairW, 4, 5, 10, bb)
  addBlock(p, chunk, stairE, 8, 5, 2, bb)
  addBlock(p, chunk, stairE, 8, 5, 3, bb)
  addBlock(p, chunk, stairE, 8, 5, 9, bb)
  addBlock(p, chunk, stairE, 8, 5, 10, bb)
  let soulSand = blockState("soul_sand")
  let netherWart = blockState("nether_wart")
  fillWithOutline(p, chunk, bb, false, 3, 4, 4, 4, 4, 8, soulSand, soulSand)
  fillWithOutline(p, chunk, bb, false, 8, 4, 4, 9, 4, 8, soulSand, soulSand)
  fillWithOutline(p, chunk, bb, false, 3, 5, 4, 4, 5, 8, netherWart, netherWart)
  fillWithOutline(p, chunk, bb, false, 8, 5, 4, 9, 5, 8, netherWart, netherWart)
  fillWithOutline(p, chunk, bb, false, 4, 2, 0, 8, 2, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 4, 12, 2, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 0, 0, 8, 1, 3, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 0, 9, 8, 1, 12, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 0, 4, 3, 1, 8, nb, nb)
  fillWithOutline(p, chunk, bb, false, 9, 0, 4, 12, 1, 8, nb, nb)
  for l in int32(4) .. int32(8):
    for m in int32(0) .. int32(2):
      fillDownwards(p, chunk, nb, l, -1, m, bb)
      fillDownwards(p, chunk, nb, l, -1, 12 - m, bb)
  for l in int32(0) .. int32(2):
    for m in int32(4) .. int32(8):
      fillDownwards(p, chunk, nb, l, -1, m, bb)
      fillDownwards(p, chunk, nb, 12 - l, -1, m, bb)

proc createCorridorNetherWartsRoomPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -5, -3, 0, 13, 14, 13, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = CorridorNetherWartsRoomPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorNetherWartsRoom, bbox, chainLength), placeFn: placeCorridorNetherWartsRoomPiece, fillFn: fillCorridorNetherWartsRoomPiece)
  setFacing(result.piece, orientation)
