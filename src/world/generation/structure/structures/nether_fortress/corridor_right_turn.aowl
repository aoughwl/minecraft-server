## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_right_turn.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorRightTurnPiece* = ref object of NetherFortressPiece
    containsChest*: bool

proc fillCorridorRightTurnPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillSeOpening(self, ctx, last, 0, 1, true)

proc placeCorridorRightTurnPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorRightTurnPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let fEw = fence(true, true, false, false)
  let fNs = fence(false, false, true, true)
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 4, 1, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 4, 5, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 0, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 3, 1, 0, 4, 1, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 0, 3, 3, 0, 4, 3, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 4, 2, 0, 4, 5, 0, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 2, 4, 4, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 1, 3, 4, 1, 4, 4, fEw, fEw)
  fillWithOutline(p, chunk, bb, false, 3, 3, 4, 3, 4, 4, fEw, fEw)
  if s.containsChest:
    let chestPos = offsetPos(p, 1, 2, 3)
    if containsPos(bb, chestPos):
      s.containsChest = false
      discard addChest(p, chunk, bb, random, 1, 2, 3, "minecraft:chests/nether_bridge")
  fillWithOutline(p, chunk, bb, false, 0, 6, 0, 4, 6, 4, nb, nb)
  for i in int32(0) .. int32(4):
    for j in int32(0) .. int32(4):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createCorridorRightTurnPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, 0, 0, 5, 7, 5, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let containsChest = nextBoundedI32(ctx.random, 3) == 0
  result = CorridorRightTurnPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorRightTurn, bbox, chainLength), placeFn: placeCorridorRightTurnPiece, fillFn: fillCorridorRightTurnPiece, containsChest: containsChest)
  setFacing(result.piece, orientation)
