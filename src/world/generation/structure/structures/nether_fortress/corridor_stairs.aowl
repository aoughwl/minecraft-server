## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/corridor_stairs.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  CorridorStairsPiece* = ref object of NetherFortressPiece

proc fillCorridorStairsPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 1, 0, true)

proc placeCorridorStairsPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorStairsPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let stair = stateWith("nether_brick_stairs", [("facing", "south")])
  let fNs = fenceNs(true, true)
  for i in int32(0) .. int32(9):
    let j = max(1, 7 - i)
    let k = min(min(j + 5, 14 - i), 13)
    let l = i
    fillWithOutline(p, chunk, bb, false, 0, 0, i, 4, j, i, nb, nb)
    fillWithOutline(p, chunk, bb, false, 1, j + 1, i, 3, k - 1, i, air, air)
    if i <= 6:
      addBlock(p, chunk, stair, 1, j + 1, i, bb)
      addBlock(p, chunk, stair, 2, j + 1, i, bb)
      addBlock(p, chunk, stair, 3, j + 1, i, bb)
    fillWithOutline(p, chunk, bb, false, 0, k, i, 4, k, i, nb, nb)
    fillWithOutline(p, chunk, bb, false, 0, j + 1, i, 0, k - 1, i, nb, nb)
    fillWithOutline(p, chunk, bb, false, 4, j + 1, i, 4, k - 1, i, nb, nb)
    if (i and 1) == 0:
      fillWithOutline(p, chunk, bb, false, 0, j + 2, i, 0, j + 3, i, fNs, fNs)
      fillWithOutline(p, chunk, bb, false, 4, j + 2, i, 4, j + 3, i, fNs, fNs)
    for m in int32(0) .. int32(4):
      fillDownwards(p, chunk, nb, m, -1, l, bb)

proc createCorridorStairsPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -7, 0, 5, 14, 10, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = CorridorStairsPiece(piece: newStructurePiece(StructurePieceType.NetherFortressCorridorStairs, bbox, chainLength), placeFn: placeCorridorStairsPiece, fillFn: fillCorridorStairsPiece)
  setFacing(result.piece, orientation)
