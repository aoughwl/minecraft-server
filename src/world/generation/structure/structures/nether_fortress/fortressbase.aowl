## What a fortress piece needs from upstream's nether_fortress/mod.rs. The rest of that file is nether_fortress.aowl, which
## imports every piece: a piece calling `piece_generator` reaches it through `pieceGeneratorHook`.
## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/mod.rs

{.feature: "lenientnils".}

import ../structuresmod

export structuresmod

type
  NetherFortressPieceType* {.pure.} = enum
    Bridge, BridgeCrossing, BridgeSmallCrossing, BridgeStairs, BridgePlatform, CorridorExit,
    SmallCorridor, CorridorCrossing, CorridorRightTurn, CorridorLeftTurn, CorridorStairs, CorridorBalcony,
    CorridorNetherWartsRoom

  PieceWeight* = object
    pieceType*: NetherFortressPieceType
    weight*: int32
    limit*: uint32
    generatedCount*: uint32
    repeatable*: bool

  LastPiece* = object
    ## `Option<NetherFortressPieceType>`
    has*: bool
    value*: NetherFortressPieceType

  NetherFortressPiece* = ref object of StructurePieceBase
    ## `NetherFortressPiece`, and `StructurePieceBase::fill_openings_nether` as `fillFn`. nil is the trait's default.
    fillFn*: FillFn

  FillFn* = proc(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.}

  FortressContext* = ref object
    ## The arguments `fill_openings_nether` passes down, together.
    start*: StructurePiece
    random*: RandomGenerator
    bridgePieces*: seq[PieceWeight]
    corridorPieces*: seq[PieceWeight]
    collector*: StructurePiecesCollector
    piecesToProcess*: seq[NetherFortressPiece]

var pieceGeneratorHook*: proc(self: NetherFortressPiece, ctx: FortressContext, last: var LastPiece, x, y, z: int32,
                              orientation: BlockDirection, inside: bool) {.nimcall.}
  ## `NetherFortressPiece::piece_generator`, set by nether_fortress.aowl.

proc isInBounds*(bb: BlockBox): bool {.inline.} =
  bb.min.y > 10

proc boolText(b: bool): string =
  if b: "true" else: "false"

proc fence*(west, east, north, south: bool): BlockStateId =
  ## The `fence` closure the pieces write out.
  stateWith("nether_brick_fence", [("west", boolText(west)), ("east", boolText(east)), ("north", boolText(north)),
    ("south", boolText(south))])

proc fenceNs*(north, south: bool): BlockStateId =
  ## The two-argument `fence` closure of small_corridor.rs and corridor_stairs.rs.
  stateWith("nether_brick_fence", [("north", boolText(north)), ("south", boolText(south))])

iterator stepRange*(a, b, step: int32): int32 =
  ## `(a..=b).step_by(step)`
  var i = a
  while i <= b:
    yield i
    i += step

proc fillForwardOpening*(self: NetherFortressPiece, ctx: FortressContext, last: var LastPiece, leftRightOffset,
                         heightOffset: int32, inside: bool) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  let facing = self.piece.facing
  var nx, ny, nz: int32
  case facing
  of North:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.min.z - 1
  of South:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.max.z + 1
  of West:
    nx = bb.min.x - 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
  of East:
    nx = bb.max.x + 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
  else:
    return
  let f = pieceGeneratorHook
  f(self, ctx, last, nx, ny, nz, facing, inside)

proc fillNwOpening*(self: NetherFortressPiece, ctx: FortressContext, last: var LastPiece, heightOffset,
                    leftRightOffset: int32, inside: bool) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  var nx, ny, nz: int32
  var nextFacing = West
  case self.piece.facing
  of North, South:
    nx = bb.min.x - 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
    nextFacing = West
  of West, East:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.min.z - 1
    nextFacing = North
  else:
    return
  let f = pieceGeneratorHook
  f(self, ctx, last, nx, ny, nz, nextFacing, inside)

proc fillSeOpening*(self: NetherFortressPiece, ctx: FortressContext, last: var LastPiece, heightOffset,
                    leftRightOffset: int32, inside: bool) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  var nx, ny, nz: int32
  var nextFacing = East
  case self.piece.facing
  of North, South:
    nx = bb.max.x + 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
    nextFacing = East
  of West, East:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.max.z + 1
    nextFacing = South
  else:
    return
  let f = pieceGeneratorHook
  f(self, ctx, last, nx, ny, nz, nextFacing, inside)
