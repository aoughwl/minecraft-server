## The fortress generator, and `pick_piece`, `create_piece` and `piece_generator`.
## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/mod.rs; the rest of it is fortressbase.aowl.

{.feature: "lenientnils".}

import ../../../generation
import fortressbase
import bridge
import bridge_crossing
import bridge_end
import bridge_platform
import bridge_small_crossing
import bridge_stairs
import corridor_balcony
import corridor_crossing
import corridor_exit
import corridor_left_turn
import corridor_nether_warts_room
import corridor_right_turn
import corridor_stairs
import small_corridor

export fortressbase

proc newPieceWeight(pieceType: NetherFortressPieceType, weight: int32, limit: uint32, repeatable: bool): PieceWeight =
  PieceWeight(pieceType: pieceType, weight: weight, limit: limit, generatedCount: 0'u32, repeatable: repeatable)

proc canGenerate*(w: PieceWeight): bool =
  w.limit == 0'u32 or w.generatedCount < w.limit

proc getBridgePieceWeights*(): seq[PieceWeight] =
  @[newPieceWeight(NetherFortressPieceType.Bridge, 30, 0, true),
    newPieceWeight(NetherFortressPieceType.BridgeCrossing, 10, 4, false),
    newPieceWeight(NetherFortressPieceType.BridgeSmallCrossing, 10, 4, false),
    newPieceWeight(NetherFortressPieceType.BridgeStairs, 10, 3, false),
    newPieceWeight(NetherFortressPieceType.BridgePlatform, 5, 2, false),
    newPieceWeight(NetherFortressPieceType.CorridorExit, 5, 1, false)]

proc getCorridorPieceWeights*(): seq[PieceWeight] =
  @[newPieceWeight(NetherFortressPieceType.SmallCorridor, 25, 0, true),
    newPieceWeight(NetherFortressPieceType.CorridorCrossing, 15, 5, false),
    newPieceWeight(NetherFortressPieceType.CorridorRightTurn, 5, 10, false),
    newPieceWeight(NetherFortressPieceType.CorridorLeftTurn, 5, 10, false),
    newPieceWeight(NetherFortressPieceType.CorridorStairs, 10, 3, true),
    newPieceWeight(NetherFortressPieceType.CorridorBalcony, 7, 2, false),
    newPieceWeight(NetherFortressPieceType.CorridorNetherWartsRoom, 5, 2, false)]

proc createPiece(pieceType: NetherFortressPieceType, ctx: FortressContext, x, y, z: int32, orientation: BlockDirection,
                 chainLength: uint32): NetherFortressPiece =
  case pieceType
  of NetherFortressPieceType.Bridge: createBridgePiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.BridgeCrossing: createBridgeCrossingPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.BridgeSmallCrossing: createBridgeSmallCrossingPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.BridgeStairs: createBridgeStairsPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.BridgePlatform: createBridgePlatformPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorExit: createCorridorExitPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.SmallCorridor: createSmallCorridorPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorCrossing: createCorridorCrossingPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorRightTurn: createCorridorRightTurnPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorLeftTurn: createCorridorLeftTurnPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorStairs: createCorridorStairsPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorBalcony: createCorridorBalconyPiece(ctx, x, y, z, orientation, chainLength)
  of NetherFortressPieceType.CorridorNetherWartsRoom: createCorridorNetherWartsRoomPiece(ctx, x, y, z, orientation, chainLength)

proc checkRemainingPieces(weights: seq[PieceWeight]): int32 =
  var hasLimited = false
  var total = 0'i32
  for i in 0 ..< weights.len:
    if weights[i].limit > 0'u32 and weights[i].generatedCount < weights[i].limit:
      hasLimited = true
    total += weights[i].weight
  if hasLimited: total else: -1

proc pickPiece(weights: var seq[PieceWeight], last: var LastPiece, ctx: FortressContext, x, y, z: int32,
               orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  ## `NetherFortressPiece::pick_piece`
  let totalWeight = checkRemainingPieces(weights)
  if totalWeight < 0:
    return createBridgeEndPiece(ctx, x, y, z, orientation, chainLength)
  var attempt = 0
  while attempt < 5:
    inc attempt
    var k = nextBoundedI32(ctx.random, totalWeight)
    var i = 0
    while i < weights.len:
      k -= weights[i].weight
      if k < 0:
        let sameAsLast = last.has and weights[i].pieceType == last.value and not weights[i].repeatable
        if not canGenerate(weights[i]) or sameAsLast:
          break
        let p = createPiece(weights[i].pieceType, ctx, x, y, z, orientation, chainLength)
        if p != nil:
          weights[i].generatedCount += 1'u32
          last.has = true
          last.value = weights[i].pieceType
          if not canGenerate(weights[i]):
            weights.delete(i)
          return p
        break
      inc i
  createBridgeEndPiece(ctx, x, y, z, orientation, chainLength)

proc pieceGenerator(self: NetherFortressPiece, ctx: FortressContext, last: var LastPiece, x, y, z: int32,
                    orientation: BlockDirection, inside: bool) {.nimcall.} =
  ## `NetherFortressPiece::piece_generator`, with the newer tree's `generate_and_add_piece`, as vanilla has it: a piece joins
  ## the collector when it is made, and one past the range is made and dropped. The pinned tree adds it after its children,
  ## so a pending piece is no obstacle and rooms overlap; and it keeps the one past the range.
  let startBox = ctx.start.boundingBox
  if abs(x - startBox.min.x) > 112 or abs(z - startBox.min.z) > 112:
    discard createBridgeEndPiece(ctx, x, y, z, orientation, self.piece.chainLength)
    return
  # A copy, written back: `ctx` is passed beside it, and the compiler rejects a var argument aliasing it.
  var weights = if inside: ctx.corridorPieces else: ctx.bridgePieces
  let p = pickPiece(weights, last, ctx, x, y, z, orientation, self.piece.chainLength + 1'u32)
  if inside:
    ctx.corridorPieces = weights
  else:
    ctx.bridgePieces = weights
  if p != nil:
    addPiece(ctx.collector, p)
    ctx.piecesToProcess.add(p)

pieceGeneratorHook = pieceGenerator

proc fillOpeningsNether(p: NetherFortressPiece, ctx: FortressContext) =
  if p.fillFn != nil:
    let f = p.fillFn
    f(p, ctx)

proc netherFortressPosition*(context: var StructureGeneratorContext): StructurePosition =
  ## `<NetherFortressGenerator as StructureGenerator>::get_structure_position`
  let collector = newStructurePiecesCollector()
  let ctx = FortressContext(random: context.random, collector: collector, piecesToProcess: @[],
    bridgePieces: getBridgePieceWeights(), corridorPieces: getCorridorPieceWeights())
  let startX = sectionToBlock(context.chunkX) + 2
  let startZ = sectionToBlock(context.chunkZ) + 2
  let startPiece = newBridgeCrossingStart(ctx.random, startX, startZ)
  ctx.start = startPiece.piece
  addPiece(collector, startPiece)
  fillOpeningsNether(startPiece, ctx)
  while ctx.piecesToProcess.len > 0:
    let idx = int(nextBoundedI32(ctx.random, int32(ctx.piecesToProcess.len)))
    let piece = ctx.piecesToProcess[idx]
    ctx.piecesToProcess.delete(idx)
    fillOpeningsNether(piece, ctx)
  context.random = ctx.random
  StructurePosition(startPos: blockPos(sectionToBlock(context.chunkX), 64, sectionToBlock(context.chunkZ)), collector: collector)
