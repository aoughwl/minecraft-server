## Port of pumpkin-world/src/generation/structure/structures/nether_fortress/small_corridor.rs

{.feature: "lenientnils".}

import ../structuresmod
import fortressbase

type
  SmallCorridorPiece* = ref object of NetherFortressPiece

proc fillSmallCorridorPiece(self: NetherFortressPiece, ctx: FortressContext) {.nimcall.} =
  var last = default(LastPiece)
  fillForwardOpening(self, ctx, last, 1, 0, true)

proc placeSmallCorridorPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[SmallCorridorPiece](self)
  let p = s.piece
  let bb = chunkBox
  let nb = blockState("nether_bricks")
  let air = blockState("air")
  let fNs = fenceNs(true, true)
  fillWithOutline(p, chunk, bb, false, 0, 0, 0, 4, 1, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 4, 5, 4, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 2, 0, 0, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 4, 2, 0, 4, 5, 4, nb, nb)
  fillWithOutline(p, chunk, bb, false, 0, 3, 1, 0, 4, 1, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 0, 3, 3, 0, 4, 3, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 4, 3, 1, 4, 4, 1, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 4, 3, 3, 4, 4, 3, fNs, fNs)
  fillWithOutline(p, chunk, bb, false, 0, 6, 0, 4, 6, 4, nb, nb)
  for i in int32(0) .. int32(4):
    for j in int32(0) .. int32(4):
      fillDownwards(p, chunk, nb, i, -1, j, bb)

proc createSmallCorridorPiece*(ctx: FortressContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): NetherFortressPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, 0, 0, 5, 7, 5, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  result = SmallCorridorPiece(piece: newStructurePiece(StructurePieceType.NetherFortressSmallCorridor, bbox, chainLength), placeFn: placeSmallCorridorPiece, fillFn: fillSmallCorridorPiece)
  setFacing(result.piece, orientation)
