## Port of pumpkin-world/src/generation/structure/structures/nether_fossil.rs

{.feature: "lenientnils".}

import ../../../../util/xoroshiro128
import "../template/templatemod"
import ../shiftable_piece
import structuresmod

const
  TemplateNames = ["nether_fossils/fossil_1", "nether_fossils/fossil_2", "nether_fossils/fossil_3", "nether_fossils/fossil_4",
    "nether_fossils/fossil_5", "nether_fossils/fossil_6", "nether_fossils/fossil_7", "nether_fossils/fossil_8",
    "nether_fossils/fossil_9", "nether_fossils/fossil_10", "nether_fossils/fossil_11", "nether_fossils/fossil_12",
    "nether_fossils/fossil_13", "nether_fossils/fossil_14"]
  HeightMin = 32'i32
  HeightMax = 253'i32

type
  NetherFossilPiece = ref object of ShiftableStructurePiece
    templateData: StructureTemplate
    rotation: Rotation
    initialY: int32
    seaLevel: int32

let
  SoulSandBlock = blockIdNamed("soul_sand")
  DriedGhastState = blockState("dried_ghast")

proc findPlacementY(p: NetherFossilPiece, chunk: ProtoChunk, placementY: var int32): bool =
  ## `find_placement_y`: vanilla's column scan, with its pre-decrement.
  let origin = p.piece.boundingBox.min
  var y = p.initialY
  while y > p.seaLevel:
    let upper = getBlockState(chunk, vec3[int32](origin.x, y, origin.z))
    dec y
    let lower = getBlockState(chunk, vec3[int32](origin.x, y, origin.z))
    if isAir(upper) and (blockIdOf(lower) == SoulSandBlock or isSideSolid(lower, ord(Up))):
      break
  if y <= p.seaLevel:
    return false
  placementY = y
  true

proc tryPlaceDriedGhast(p: NetherFossilPiece, chunk: ProtoChunk, seed: int64) =
  let bbox = p.piece.boundingBox
  let centerX = midpointI32(bbox.min.x, bbox.max.x)
  let centerY = midpointI32(bbox.min.y, bbox.max.y)
  let centerZ = midpointI32(bbox.min.z, bbox.max.z)
  var seeded = toRandomGenerator(xoroshiro128.fromSeed(cast[uint64](seed)))
  let splitter = nextSplitter(seeded)
  var rng = splitPos(splitter, centerX, centerY, centerZ)
  if nextF32(rng) >= 0.5'f32:
    return
  let blockCountX = max(bbox.max.x - bbox.min.x + 1, 1)
  let blockCountZ = max(bbox.max.z - bbox.min.z + 1, 1)
  let x = bbox.min.x + nextBoundedI32(rng, blockCountX)
  let y = bbox.min.y
  let z = bbox.min.z + nextBoundedI32(rng, blockCountZ)
  let chunkX = startBlockX(chunk.x)
  let chunkZ = startBlockZ(chunk.z)
  if x < chunkX or x > chunkX + 15 or z < chunkZ or z > chunkZ + 15:
    return
  if not isAir(getBlockState(chunk, vec3[int32](x, y, z))):
    return
  setBlockState(chunk, x, y, z, DriedGhastState)

proc placeNetherFossil(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                       random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[NetherFossilPiece](self)
  var placementY = 0'i32
  if not findPlacementY(p, chunk, placementY):
    return
  let offset = placementY - p.piece.boundingBox.min.y
  p.piece.boundingBox.min.y += offset
  p.piece.boundingBox.max.y += offset
  placeTemplateIn(chunk, p.templateData, p.piece.boundingBox.min, (0'i32, 0'i32), p.rotation, true, false, chunkBox)
  tryPlaceDriedGhast(p, chunk, seed)

proc netherFossilPosition*(context: var StructureGeneratorContext): StructurePosition =
  let x = startBlockX(context.chunkX) + nextBoundedI32(context.random, 16)
  let z = startBlockZ(context.chunkZ) + nextBoundedI32(context.random, 16)
  let heightRange = HeightMax - HeightMin + 1
  let initialY = HeightMin + nextBoundedI32(context.random, heightRange)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let templateIndex = int(nextBoundedI32(context.random, 14))
  let t = getTemplate(TemplateNames[templateIndex])
  if t == nil:
    return nil
  let rotatedSize = transformSize(rotation, t.size)
  let piece = NetherFossilPiece(placeFn: placeNetherFossil, templateData: t, rotation: rotation, initialY: initialY,
    seaLevel: context.seaLevel)
  initShiftable(piece, StructurePieceType.NetherFossil, x, initialY, z, rotatedSize.x, rotatedSize.y, rotatedSize.z,
    toAxis(rotation))
  singlePiecePosition(piece, x, initialY, z)
