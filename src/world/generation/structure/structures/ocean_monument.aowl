## Port of pumpkin-world/src/generation/structure/structures/ocean_monument.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/ocean_monument.rs - the pinned tree's piece is one stepped pyramid.
## The start matches the vanilla save; the box and rooms do not. ../ref/pumpkin has the rooms, not ported.

{.feature: "lenientnils".}

import structuresmod

let
  DarkPrismarineState = blockState("dark_prismarine")
  PrismarineBricksState = blockState("prismarine_bricks")
  PrismarineState = blockState("prismarine")

proc placeOceanMonument(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                        random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let origin = self.piece.boundingBox.min
  let sampleY = getTopY(chunk, OceanFloorWg, origin.x, origin.z)
  let startY = if sampleY <= 0: 40'i32 else: sampleY - 4
  var dy = 0'i32
  while dy < 15:
    let halfSz = 29 - dy
    let minX = origin.x - halfSz
    let maxX = origin.x + halfSz
    let minZ = origin.z - halfSz
    let maxZ = origin.z + halfSz
    let y = startY + dy
    var x = minX
    while x <= maxX:
      var z = minZ
      while z <= maxZ:
        if contains(chunkBox, x, y, z):
          let isBorder = x == minX or x == maxX or z == minZ or z == maxZ
          let state =
            if isBorder: DarkPrismarineState
            elif dy mod 3 == 0: PrismarineBricksState
            else: PrismarineState
          setBlockState(chunk, x, y, z, state)
        inc z
      inc x
    inc dy

proc oceanMonumentPosition*(context: var StructureGeneratorContext): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let boundingBox = newBlockBox(chunkCenterX - 29, context.minY, chunkCenterZ - 29, chunkCenterX + 29, 256, chunkCenterZ + 29)
  let piece = StructurePieceBase(piece: newStructurePiece(StructurePieceType.OceanMonumentBase, boundingBox, 0),
    placeFn: placeOceanMonument)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
