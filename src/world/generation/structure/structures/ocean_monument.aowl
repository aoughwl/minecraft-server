## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/ocean_monument/mod.rs,
## ocean_monument/graph.rs, ocean_monument/building.rs and ocean_monument/rooms.rs
##
## The pinned tree's piece was one stepped pyramid, so this one comes from the newer tree. One piece holds the rooms, as in
## vanilla: a monument in a save has one child, `omb`. Rooms are `ref object`s and an `Option<usize>` connection is -1.

{.feature: "lenientnils".}

import ../../../../generated/tag
import ../../blender/blender
import ../../noise/multi_noise_sampler
from ../../generation import biomeFromBlock
import structuresmod

const
  GridSize = 75
  HasOceanMonumentTag = "minecraft:has_structure/ocean_monument"
  SurroundingTag = "minecraft:required_ocean_monument_surrounding"

let
  BaseGray = blockState("prismarine")
  BaseLight = blockState("prismarine_bricks")
  BaseBlack = blockState("dark_prismarine")
  Lamp = blockState("sea_lantern")
  WaterState = blockState("water")
  GoldBlockState = blockState("gold_block")
  WetSpongeState = blockState("wet_sponge")
  IceBlock = blockIdNamed("ice")
  PackedIceBlock = blockIdNamed("packed_ice")
  BlueIceBlock = blockIdNamed("blue_ice")
  WaterBlock = blockIdNamed("water")

type
  RoomKindTag {.pure.} = enum
    Entry, Core, DoubleX, DoubleXY, DoubleY, DoubleYZ, DoubleZ, Simple, SimpleTop, Wing, Penthouse

  RoomKind = object
    tag: RoomKindTag
    design: int32  ## `Simple` and `Wing`

  RoomDefinition = ref object
    index: int32
    connections: array[6, int]
    openings: array[6, bool]
    claimed: bool
    source: bool

  RoomGraph = ref object
    rooms: seq[RoomDefinition]
    source: int
    core: int

  MonumentPiece = ref object
    piece: StructurePiece

  RoomPiece = ref object
    room: int
    pieceData: MonumentPiece
    kind: RoomKind

  MonumentBuilding* = ref object of StructurePieceBase
    base: MonumentPiece
    graph: RoomGraph
    children: seq[RoomPiece]
    seaLevel: int32

proc stepDown(hi, lo, step: int32): seq[int32] =
  ## `(lo..=hi).rev().step_by(step)`
  result = @[]
  var v = hi
  while v >= lo:
    result.add(v)
    v -= step

proc stepUp(lo, hi, step: int32): seq[int32] =
  ## `(lo..=hi).step_by(step)`
  result = @[]
  var v = lo
  while v <= hi:
    result.add(v)
    v += step

# graph.rs

proc roomIndex(x, y, z: int32): int32 = y * 25 + z * 5 + x

proc oppositeIndex(direction: int): int =
  [1, 0, 3, 2, 5, 4][direction]

proc isSpecial(r: RoomDefinition): bool = r.index >= 75

proc countOpenings(r: RoomDefinition): int =
  result = 0
  for i in 0 ..< 6:
    if r.openings[i]:
      inc result

proc pushRoom(g: RoomGraph, index: int32): int =
  result = g.rooms.len
  g.rooms.add(RoomDefinition(index: index, connections: [-1, -1, -1, -1, -1, -1],
    openings: [false, false, false, false, false, false], claimed: false, source: false))

proc connect(g: RoomGraph, room: int, direction: BlockDirection, neighbor: int) =
  g.rooms[room].connections[ord(direction)] = neighbor
  g.rooms[neighbor].connections[ord(opposite(direction))] = room

proc connection(g: RoomGraph, room: int, direction: BlockDirection): int =
  ## `RoomGraph::connection`: `unwrap_or(0)`.
  let c = g.rooms[room].connections[ord(direction)]
  if c < 0: 0 else: c

proc claimCore(g: RoomGraph) =
  let east = connection(g, g.core, East)
  let north = connection(g, g.core, North)
  let northEast = connection(g, east, North)
  let up = connection(g, g.core, Up)
  let eastUp = connection(g, east, Up)
  let northUp = connection(g, north, Up)
  let northEastUp = connection(g, northEast, Up)
  for room in [g.core, east, north, northEast, up, eastUp, northUp, northEastUp]:
    g.rooms[room].claimed = true

proc findSource(g: RoomGraph, start: int): bool =
  var visited = newSeq[bool](g.rooms.len)
  var pending = @[start]
  while pending.len > 0:
    let room = pending[pending.len - 1]
    pending.setLen(pending.len - 1)
    if visited[room]:
      continue
    visited[room] = true
    if g.rooms[room].source:
      return true
    for direction in 0 ..< 6:
      if g.rooms[room].openings[direction] and g.rooms[room].connections[direction] >= 0:
        pending.add(g.rooms[room].connections[direction])
  false

proc shuffleRooms(values: var seq[int], random: var RandomGenerator) =
  var index = values.len - 1
  while index >= 1:
    let other = int(nextBoundedI32(random, int32(index) + 1))
    let a = values[index]
    let b = values[other]
    values[index] = b
    values[other] = a
    dec index

proc generateGraph(random: var RandomGenerator, order: var seq[int]): RoomGraph =
  ## `RoomGraph::generate`
  let graph = RoomGraph(rooms: newSeqOfCap[RoomDefinition](49), source: 0, core: 0)
  var grid = default(array[GridSize, int])
  for i in 0 ..< GridSize:
    grid[i] = -1
  for y in 0'i32 .. 1'i32:
    for z in 0'i32 ..< 4'i32:
      for x in 0'i32 ..< 5'i32:
        let index = roomIndex(x, y, z)
        grid[int(index)] = pushRoom(graph, index)
  for z in 0'i32 ..< 2'i32:
    for x in 1'i32 ..< 4'i32:
      let index = roomIndex(x, 2, z)
      grid[int(index)] = pushRoom(graph, index)
  if grid[int(roomIndex(2, 0, 0))] >= 0:
    graph.source = grid[int(roomIndex(2, 0, 0))]

  for x in 0'i32 ..< 5'i32:
    for z in 0'i32 ..< 5'i32:
      for y in 0'i32 ..< 3'i32:
        let room = grid[int(roomIndex(x, y, z))]
        if room < 0:
          continue
        for direction in [Down, Up, North, South, West, East]:
          let step = toVector(direction)
          let nx = x + step.x
          let ny = y + step.y
          let nz = z + step.z
          if nx < 0 or nx >= 5 or ny < 0 or ny >= 3 or nz < 0 or nz >= 5:
            continue
          let neighbor = grid[int(roomIndex(nx, ny, nz))]
          if neighbor < 0:
            continue
          let connectionDirection = if nz == z: direction else: opposite(direction)
          connect(graph, room, connectionDirection, neighbor)

  let roof = pushRoom(graph, 1003)
  let leftWing = pushRoom(graph, 1001)
  let rightWing = pushRoom(graph, 1002)
  if grid[int(roomIndex(2, 2, 0))] >= 0:
    connect(graph, grid[int(roomIndex(2, 2, 0))], Up, roof)
  if grid[int(roomIndex(0, 1, 0))] >= 0:
    connect(graph, grid[int(roomIndex(0, 1, 0))], South, leftWing)
  if grid[int(roomIndex(4, 1, 0))] >= 0:
    connect(graph, grid[int(roomIndex(4, 1, 0))], South, rightWing)
  graph.rooms[roof].claimed = true
  graph.rooms[leftWing].claimed = true
  graph.rooms[rightWing].claimed = true
  graph.rooms[graph.source].source = true

  let coreRoom = grid[int(roomIndex(nextBoundedI32(random, 4), 0, 2))]
  if coreRoom >= 0:
    graph.core = coreRoom
  claimCore(graph)
  for ri in 0 ..< graph.rooms.len:
    # Vanilla updates every grid room and the roof room here. The two wing sentinels deliberately keep their side closed so
    # that edge pruning cannot disconnect their grid attachment.
    if not isSpecial(graph.rooms[ri]) or graph.rooms[ri].index == 1003:
      for direction in 0 ..< 6:
        graph.rooms[ri].openings[direction] = graph.rooms[ri].connections[direction] >= 0

  order = @[]
  for i in 0 ..< GridSize:
    if grid[i] >= 0:
      order.add(grid[i])
  shuffleRooms(order, random)
  for oi in 0 ..< order.len:
    let room = order[oi]
    var closed = 0
    for attempt in 0 ..< 5:
      if closed == 2:
        break
      let direction = int(nextBoundedI32(random, 6))
      if not graph.rooms[room].openings[direction]:
        continue
      let neighbor = graph.rooms[room].connections[direction]
      if neighbor < 0:
        continue
      let oppositeDir = oppositeIndex(direction)
      graph.rooms[room].openings[direction] = false
      graph.rooms[neighbor].openings[oppositeDir] = false
      if findSource(graph, room) and findSource(graph, neighbor):
        inc closed
      else:
        graph.rooms[room].openings[direction] = true
        graph.rooms[neighbor].openings[oppositeDir] = true
  order.add(roof)
  order.add(leftWing)
  order.add(rightWing)
  graph

# mod.rs: MonumentPiece

proc pieceType(kind: RoomKind): StructurePieceType =
  case kind.tag
  of RoomKindTag.Entry: StructurePieceType.OceanMonumentEntryRoom
  of RoomKindTag.Core: StructurePieceType.OceanMonumentCoreRoom
  of RoomKindTag.DoubleX: StructurePieceType.OceanMonumentDoubleXRoom
  of RoomKindTag.DoubleXY: StructurePieceType.OceanMonumentDoubleXYRoom
  of RoomKindTag.DoubleY: StructurePieceType.OceanMonumentDoubleYRoom
  of RoomKindTag.DoubleYZ: StructurePieceType.OceanMonumentDoubleYZRoom
  of RoomKindTag.DoubleZ: StructurePieceType.OceanMonumentDoubleZRoom
  of RoomKindTag.Simple: StructurePieceType.OceanMonumentSimpleRoom
  of RoomKindTag.SimpleTop: StructurePieceType.OceanMonumentSimpleTopRoom
  of RoomKindTag.Wing: StructurePieceType.OceanMonumentWingRoom
  of RoomKindTag.Penthouse: StructurePieceType.OceanMonumentPenthouse

proc dimensions(kind: RoomKind): (int32, int32, int32) =
  case kind.tag
  of RoomKindTag.Core: (2'i32, 2'i32, 2'i32)
  of RoomKindTag.DoubleX: (2'i32, 1'i32, 1'i32)
  of RoomKindTag.DoubleXY: (2'i32, 2'i32, 1'i32)
  of RoomKindTag.DoubleY: (1'i32, 2'i32, 1'i32)
  of RoomKindTag.DoubleYZ: (1'i32, 2'i32, 2'i32)
  of RoomKindTag.DoubleZ: (1'i32, 1'i32, 2'i32)
  else: (1'i32, 1'i32, 1'i32)

proc pieceForRoom(kind: RoomKind, direction: BlockDirection, roomIndexValue, width, height, depth: int32): MonumentPiece =
  ## `MonumentPiece::for_room`
  let roomX = roomIndexValue mod 5
  let roomZ = roomIndexValue div 5 mod 5
  let roomY = roomIndexValue div 25
  var boundingBox =
    case direction
    of North, South: newBlockBox(0, 0, 0, width * 8 - 1, height * 4 - 1, depth * 8 - 1)
    else: newBlockBox(0, 0, 0, depth * 8 - 1, height * 4 - 1, width * 8 - 1)
  case direction
  of North:
    movePos(boundingBox, roomX * 8, roomY * 4, -(roomZ + depth) * 8 + 1)
  of South:
    movePos(boundingBox, roomX * 8, roomY * 4, roomZ * 8)
  of West:
    movePos(boundingBox, -(roomZ + depth) * 8 + 1, roomY * 4, roomX * 8)
  else:
    movePos(boundingBox, roomZ * 8, roomY * 4, roomX * 8)
  var piece = newStructurePiece(pieceType(kind), boundingBox, 1)
  setFacing(piece, direction)
  MonumentPiece(piece: piece)

proc pieceSpecial(kind: RoomKind, direction: BlockDirection, boundingBox: BlockBox): MonumentPiece =
  var piece = newStructurePiece(pieceType(kind), boundingBox, 1)
  setFacing(piece, direction)
  MonumentPiece(piece: piece)

proc fill(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, x0, y0, z0, x1, y1, z1: int32, state: BlockStateId) =
  fill(p.piece, chunk, chunkBox, x0, y0, z0, x1, y1, z1, state)

proc placeAt(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, x, y, z: int32, state: BlockStateId) =
  addBlock(p.piece, chunk, state, x, y, z, chunkBox)

proc water(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel, x0, y0, z0, x1, y1, z1: int32) =
  for y in y0 .. y1:
    for x in x0 .. x1:
      for z in z0 .. z1:
        let blockId = blockIdOf(getBlockAt(p.piece, chunk, x, y, z, chunkBox))
        if blockId == IceBlock or blockId == PackedIceBlock or blockId == BlueIceBlock or blockId == WaterBlock:
          continue
        let state = if offsetPos(p.piece, x, y, z).y >= seaLevel: AirStateId else: WaterState
        placeAt(p, chunk, chunkBox, x, y, z, state)

proc defaultFloor(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, x, z: int32, downOpening: bool) =
  if not downOpening:
    fill(p, chunk, chunkBox, x, 0, z, x + 7, 0, z + 7, BaseGray)
    return
  fill(p, chunk, chunkBox, x, 0, z, x + 2, 0, z + 7, BaseGray)
  fill(p, chunk, chunkBox, x + 5, 0, z, x + 7, 0, z + 7, BaseGray)
  fill(p, chunk, chunkBox, x + 3, 0, z, x + 4, 0, z + 2, BaseGray)
  fill(p, chunk, chunkBox, x + 3, 0, z + 5, x + 4, 0, z + 7, BaseGray)
  fill(p, chunk, chunkBox, x + 3, 0, z + 2, x + 4, 0, z + 2, BaseLight)
  fill(p, chunk, chunkBox, x + 3, 0, z + 5, x + 4, 0, z + 5, BaseLight)
  fill(p, chunk, chunkBox, x + 2, 0, z + 3, x + 2, 0, z + 4, BaseLight)
  fill(p, chunk, chunkBox, x + 5, 0, z + 3, x + 5, 0, z + 4, BaseLight)

proc fillOnWater(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, x0, y0, z0, x1, y1, z1: int32, state: BlockStateId) =
  for y in y0 .. y1:
    for x in x0 .. x1:
      for z in z0 .. z1:
        if blockIdOf(getBlockAt(p.piece, chunk, x, y, z, chunkBox)) == WaterBlock:
          placeAt(p, chunk, chunkBox, x, y, z, state)

proc chunkIntersects(p: MonumentPiece, chunkBox: BlockBox, x0, z0, x1, z1: int32): bool =
  let first = offsetPos(p.piece, x0, 0, z0)
  let second = offsetPos(p.piece, x1, 0, z1)
  intersectsRawXz(chunkBox, min(first.x, second.x), min(first.z, second.z), max(first.x, second.x), max(first.z, second.z))

proc elderGuardianNbt(pos: Vector3[int32]): NbtCompound =
  result = newCompound()
  putString(result, "id", "minecraft:elder_guardian")
  putList(result, "Pos", @[nbtTag(float64(pos.x) + 0.5'f64), nbtTag(float64(pos.y)), nbtTag(float64(pos.z) + 0.5'f64)])
  putList(result, "Motion", @[nbtTag(0.0'f64), nbtTag(0.0'f64), nbtTag(0.0'f64)])
  putList(result, "Rotation", @[nbtTag(0.0'f32), nbtTag(0.0'f32)])
  putFloat(result, "Health", 80.0'f32)
  putBool(result, "PersistenceRequired", true)

proc spawnElder(p: MonumentPiece, chunk: ProtoChunk, chunkBox: BlockBox, x, y, z: int32) =
  let pos = offsetPos(p.piece, x, y, z)
  if containsPos(chunkBox, pos):
    addStructureEntity(chunk, elderGuardianNbt(pos))

proc boxFromCorners(first, second: Vector3[int32]): BlockBox =
  newBlockBox(min(first.x, second.x), min(first.y, second.y), min(first.z, second.z), max(first.x, second.x),
    max(first.y, second.y), max(first.z, second.z))

# rooms.rs

proc opening(room: RoomDefinition, direction: BlockDirection): bool {.inline.} = room.openings[ord(direction)]

proc claim(graph: RoomGraph, rooms: openArray[int]) =
  for i in 0 ..< rooms.len:
    graph.rooms[rooms[i]].claimed = true

proc roomForRoom(kind: RoomKind, direction: BlockDirection, room: int, roomIndexValue: int32): RoomPiece =
  let (width, height, depth) = dimensions(kind)
  RoomPiece(room: room, pieceData: pieceForRoom(kind, direction, roomIndexValue, width, height, depth), kind: kind)

proc roomSpecial(kind: RoomKind, direction: BlockDirection, boundingBox: BlockBox): RoomPiece =
  RoomPiece(room: -1, pieceData: pieceSpecial(kind, direction, boundingBox), kind: kind)

proc unclaimed(graph: RoomGraph, room: int): bool {.inline.} = room >= 0 and not graph.rooms[room].claimed

proc fit(random: var RandomGenerator, direction: BlockDirection, room: int, graph: RoomGraph): RoomPiece =
  ## `RoomPiece::fit`
  let def = graph.rooms[room]
  let roomIndexValue = def.index
  let east = def.connections[ord(East)]
  let north = def.connections[ord(North)]
  let up = def.connections[ord(Up)]
  var kind = RoomKind(tag: RoomKindTag.Simple)
  if opening(def, East) and unclaimed(graph, east) and opening(def, Up) and unclaimed(graph, up) and
      opening(graph.rooms[east], Up) and unclaimed(graph, graph.rooms[east].connections[ord(Up)]):
    claim(graph, [room, east, up, connection(graph, east, Up)])
    kind = RoomKind(tag: RoomKindTag.DoubleXY)
  elif opening(def, North) and unclaimed(graph, north) and opening(def, Up) and unclaimed(graph, up) and
      opening(graph.rooms[north], Up) and unclaimed(graph, graph.rooms[north].connections[ord(Up)]):
    claim(graph, [room, north, up, connection(graph, north, Up)])
    kind = RoomKind(tag: RoomKindTag.DoubleYZ)
  elif opening(def, North) and unclaimed(graph, north):
    claim(graph, [room, north])
    kind = RoomKind(tag: RoomKindTag.DoubleZ)
  elif opening(def, East) and unclaimed(graph, east):
    claim(graph, [room, east])
    kind = RoomKind(tag: RoomKindTag.DoubleX)
  elif opening(def, Up) and unclaimed(graph, up):
    claim(graph, [room, up])
    kind = RoomKind(tag: RoomKindTag.DoubleY)
  elif not (opening(def, West) or opening(def, East) or opening(def, North) or opening(def, South) or opening(def, Up)):
    claim(graph, [room])
    kind = RoomKind(tag: RoomKindTag.SimpleTop)
  else:
    claim(graph, [room])
    kind = RoomKind(tag: RoomKindTag.Simple, design: nextBoundedI32(random, 3))
  roomForRoom(kind, direction, room, roomIndexValue)

proc placeEntry(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let room = graph.rooms[self.room]
  fill(p, chunk, chunkBox, 0, 3, 0, 2, 3, 7, BaseLight)
  fill(p, chunk, chunkBox, 5, 3, 0, 7, 3, 7, BaseLight)
  fill(p, chunk, chunkBox, 0, 2, 0, 1, 2, 7, BaseLight)
  fill(p, chunk, chunkBox, 6, 2, 0, 7, 2, 7, BaseLight)
  fill(p, chunk, chunkBox, 0, 1, 0, 0, 1, 7, BaseLight)
  fill(p, chunk, chunkBox, 7, 1, 0, 7, 1, 7, BaseLight)
  fill(p, chunk, chunkBox, 0, 1, 7, 7, 3, 7, BaseLight)
  fill(p, chunk, chunkBox, 1, 1, 0, 2, 3, 0, BaseLight)
  fill(p, chunk, chunkBox, 5, 1, 0, 6, 3, 0, BaseLight)
  if opening(room, North):
    water(p, chunk, chunkBox, seaLevel, 3, 1, 7, 4, 2, 7)
  if opening(room, West):
    water(p, chunk, chunkBox, seaLevel, 0, 1, 3, 1, 2, 4)
  if opening(room, East):
    water(p, chunk, chunkBox, seaLevel, 6, 1, 3, 7, 2, 4)

proc placeCore(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.pieceData
  fillOnWater(p, chunk, chunkBox, 1, 8, 0, 14, 8, 14, BaseGray)
  fill(p, chunk, chunkBox, 0, 7, 0, 0, 7, 15, BaseLight)
  fill(p, chunk, chunkBox, 15, 7, 0, 15, 7, 15, BaseLight)
  fill(p, chunk, chunkBox, 1, 7, 0, 15, 7, 0, BaseLight)
  fill(p, chunk, chunkBox, 1, 7, 15, 14, 7, 15, BaseLight)
  for y in 1'i32 .. 6'i32:
    let stateValue = if y == 2 or y == 6: BaseGray else: BaseLight
    for x in [0'i32, 15'i32]:
      fill(p, chunk, chunkBox, x, y, 0, x, y, 1, stateValue)
      fill(p, chunk, chunkBox, x, y, 6, x, y, 9, stateValue)
      fill(p, chunk, chunkBox, x, y, 14, x, y, 15, stateValue)
    placeAt(p, chunk, chunkBox, 1, y, 0, stateValue)
    fill(p, chunk, chunkBox, 6, y, 0, 9, y, 0, stateValue)
    placeAt(p, chunk, chunkBox, 14, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 15, 14, y, 15, stateValue)
  fill(p, chunk, chunkBox, 6, 3, 6, 9, 6, 9, BaseBlack)
  fill(p, chunk, chunkBox, 7, 4, 7, 8, 5, 8, GoldBlockState)
  for y in [3'i32, 6'i32]:
    for x in [6'i32, 9'i32]:
      placeAt(p, chunk, chunkBox, x, y, 6, Lamp)
      placeAt(p, chunk, chunkBox, x, y, 9, Lamp)
  for (x, z) in [(5'i32, 6'i32), (5'i32, 9'i32), (10'i32, 6'i32), (10'i32, 9'i32)]:
    fill(p, chunk, chunkBox, x, 1, z, x, 2, z, BaseLight)
  for (x, z) in [(6'i32, 5'i32), (9'i32, 5'i32), (6'i32, 10'i32), (9'i32, 10'i32)]:
    fill(p, chunk, chunkBox, x, 1, z, x, 2, z, BaseLight)
  for (x, z) in [(5'i32, 5'i32), (5'i32, 10'i32), (10'i32, 5'i32), (10'i32, 10'i32)]:
    fill(p, chunk, chunkBox, x, 2, z, x, 6, z, BaseLight)
  for (x, z0, z1) in [(5'i32, 1'i32, 6'i32), (10'i32, 1'i32, 6'i32), (5'i32, 9'i32, 14'i32), (10'i32, 9'i32, 14'i32)]:
    fill(p, chunk, chunkBox, x, 7, z0, x, 7, z1, BaseLight)
  for (z, x0, x1) in [(5'i32, 1'i32, 6'i32), (10'i32, 1'i32, 6'i32), (5'i32, 9'i32, 14'i32), (10'i32, 9'i32, 14'i32)]:
    fill(p, chunk, chunkBox, x0, 7, z, x1, 7, z, BaseLight)
  for (x, z0, z1) in [(2'i32, 2'i32, 3'i32), (13'i32, 2'i32, 3'i32), (2'i32, 12'i32, 13'i32), (13'i32, 12'i32, 13'i32)]:
    fill(p, chunk, chunkBox, x, 1, z0, x, 1, z1, BaseLight)
  for (x, z) in [(3'i32, 2'i32), (12'i32, 2'i32), (3'i32, 13'i32), (12'i32, 13'i32)]:
    placeAt(p, chunk, chunkBox, x, 1, z, BaseLight)

proc placeDoubleX(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let west = self.room
  let east = connection(graph, west, East)
  let westRoom = graph.rooms[west]
  let eastRoom = graph.rooms[east]
  if westRoom.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 8, 0, opening(eastRoom, Down))
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(westRoom, Down))
  if westRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 4, 1, 7, 4, 6, BaseGray)
  if eastRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 8, 4, 1, 14, 4, 6, BaseGray)
  for (y, stateValue) in [(3'i32, BaseLight), (2'i32, BaseGray), (1'i32, BaseLight)]:
    fill(p, chunk, chunkBox, 0, y, 0, 0, y, 7, stateValue)
    fill(p, chunk, chunkBox, 15, y, 0, 15, y, 7, stateValue)
    fill(p, chunk, chunkBox, 1, y, 0, 15, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 7, 14, y, 7, stateValue)
  fill(p, chunk, chunkBox, 5, 1, 0, 10, 1, 4, BaseLight)
  fill(p, chunk, chunkBox, 6, 2, 0, 9, 2, 3, BaseGray)
  fill(p, chunk, chunkBox, 5, 3, 0, 10, 3, 4, BaseLight)
  placeAt(p, chunk, chunkBox, 6, 2, 3, Lamp)
  placeAt(p, chunk, chunkBox, 9, 2, 3, Lamp)
  for (room, x, south, north, westOrEast) in [(westRoom, 0'i32, (3'i32, 4'i32), (3'i32, 4'i32), West), (eastRoom, 15'i32, (11'i32, 12'i32), (11'i32, 12'i32), East)]:
    if opening(room, South):
      water(p, chunk, chunkBox, seaLevel, south[0], 1, 0, south[1], 2, 0)
    if opening(room, North):
      water(p, chunk, chunkBox, seaLevel, north[0], 1, 7, north[1], 2, 7)
    if opening(room, westOrEast):
      water(p, chunk, chunkBox, seaLevel, x, 1, 3, x, 2, 4)

proc placeDoubleXy(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let west = self.room
  let east = connection(graph, west, East)
  let westUp = connection(graph, west, Up)
  let eastUp = connection(graph, east, Up)
  let westRoom = graph.rooms[west]
  let eastRoom = graph.rooms[east]
  let westUpRoom = graph.rooms[westUp]
  let eastUpRoom = graph.rooms[eastUp]
  if westRoom.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 8, 0, opening(eastRoom, Down))
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(westRoom, Down))
  if westUpRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 8, 1, 7, 8, 6, BaseGray)
  if eastUpRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 8, 8, 1, 14, 8, 6, BaseGray)
  for y in 1'i32 .. 7'i32:
    let stateValue = if y == 2 or y == 6: BaseGray else: BaseLight
    fill(p, chunk, chunkBox, 0, y, 0, 0, y, 7, stateValue)
    fill(p, chunk, chunkBox, 15, y, 0, 15, y, 7, stateValue)
    fill(p, chunk, chunkBox, 1, y, 0, 15, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 7, 14, y, 7, stateValue)
  for (x, z0, z1) in [(2'i32, 3'i32, 4'i32), (3'i32, 2'i32, 2'i32), (3'i32, 5'i32, 5'i32), (13'i32, 3'i32, 4'i32), (11'i32, 2'i32, 2'i32), (11'i32, 5'i32, 5'i32)]:
    let x1 = if x == 3 or x == 11: x + 1 else: x
    fill(p, chunk, chunkBox, x, 1, z0, x1, 7, z1, BaseLight)
  fill(p, chunk, chunkBox, 5, 1, 3, 5, 3, 4, BaseLight)
  fill(p, chunk, chunkBox, 10, 1, 3, 10, 3, 4, BaseLight)
  fill(p, chunk, chunkBox, 5, 7, 2, 10, 7, 5, BaseLight)
  for (x, z) in [(5'i32, 2'i32), (10'i32, 2'i32), (5'i32, 5'i32), (10'i32, 5'i32)]:
    fill(p, chunk, chunkBox, x, 5, z, x, 7, z, BaseLight)
    placeAt(p, chunk, chunkBox, x, 4, z, Lamp)
  for (x, z) in [(6'i32, 2'i32), (9'i32, 2'i32), (6'i32, 5'i32), (9'i32, 5'i32)]:
    placeAt(p, chunk, chunkBox, x, 6, z, BaseLight)
  fill(p, chunk, chunkBox, 5, 4, 3, 6, 4, 4, BaseLight)
  fill(p, chunk, chunkBox, 9, 4, 3, 10, 4, 4, BaseLight)
  for (room, offsetX, side) in [(westRoom, 0'i32, West), (eastRoom, 8'i32, East)]:
    if opening(room, South):
      water(p, chunk, chunkBox, seaLevel, offsetX + 3, 1, 0, offsetX + 4, 2, 0)
    if opening(room, North):
      water(p, chunk, chunkBox, seaLevel, offsetX + 3, 1, 7, offsetX + 4, 2, 7)
    if opening(room, side):
      let x = if side == West: 0'i32 else: 15'i32
      water(p, chunk, chunkBox, seaLevel, x, 1, 3, x, 2, 4)
  for (room, offsetX, side) in [(westUpRoom, 0'i32, West), (eastUpRoom, 8'i32, East)]:
    if opening(room, South):
      water(p, chunk, chunkBox, seaLevel, offsetX + 3, 5, 0, offsetX + 4, 6, 0)
    if opening(room, North):
      water(p, chunk, chunkBox, seaLevel, offsetX + 3, 5, 7, offsetX + 4, 6, 7)
    if opening(room, side):
      let x = if side == West: 0'i32 else: 15'i32
      water(p, chunk, chunkBox, seaLevel, x, 5, 3, x, 6, 4)

proc placeDoubleY(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let lower = self.room
  let upper = connection(graph, lower, Up)
  let lowerRoom = graph.rooms[lower]
  let upperRoom = graph.rooms[upper]
  if lowerRoom.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(lowerRoom, Down))
  if upperRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 8, 1, 6, 8, 6, BaseGray)
  fill(p, chunk, chunkBox, 0, 4, 0, 0, 4, 7, BaseLight)
  fill(p, chunk, chunkBox, 7, 4, 0, 7, 4, 7, BaseLight)
  fill(p, chunk, chunkBox, 1, 4, 0, 6, 4, 0, BaseLight)
  fill(p, chunk, chunkBox, 1, 4, 7, 6, 4, 7, BaseLight)
  for (x, z0, z1) in [(2'i32, 1'i32, 2'i32), (5'i32, 1'i32, 2'i32), (2'i32, 5'i32, 6'i32), (5'i32, 5'i32, 6'i32)]:
    fill(p, chunk, chunkBox, x, 4, z0, x, 4, z1, BaseLight)
  for (x, z) in [(1'i32, 2'i32), (6'i32, 2'i32), (1'i32, 5'i32), (6'i32, 5'i32)]:
    placeAt(p, chunk, chunkBox, x, 4, z, BaseLight)
  for (level, room) in [(1'i32, lowerRoom), (5'i32, upperRoom)]:
    for (direction, fixed, a, b) in [(South, 0'i32, 2'i32, 5'i32), (North, 7'i32, 2'i32, 5'i32)]:
      if opening(room, direction):
        fill(p, chunk, chunkBox, a, level, fixed, a, level + 2, fixed, BaseLight)
        fill(p, chunk, chunkBox, b, level, fixed, b, level + 2, fixed, BaseLight)
        fill(p, chunk, chunkBox, a + 1, level + 2, fixed, b - 1, level + 2, fixed, BaseLight)
      else:
        fill(p, chunk, chunkBox, 0, level, fixed, 7, level + 2, fixed, BaseLight)
        fill(p, chunk, chunkBox, 0, level + 1, fixed, 7, level + 1, fixed, BaseGray)
    for (direction, fixed, a, b) in [(West, 0'i32, 2'i32, 5'i32), (East, 7'i32, 2'i32, 5'i32)]:
      if opening(room, direction):
        fill(p, chunk, chunkBox, fixed, level, a, fixed, level + 2, a, BaseLight)
        fill(p, chunk, chunkBox, fixed, level, b, fixed, level + 2, b, BaseLight)
        fill(p, chunk, chunkBox, fixed, level + 2, a + 1, fixed, level + 2, b - 1, BaseLight)
      else:
        fill(p, chunk, chunkBox, fixed, level, 0, fixed, level + 2, 7, BaseLight)
        fill(p, chunk, chunkBox, fixed, level + 1, 0, fixed, level + 1, 7, BaseGray)

proc placeDoubleYz(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let south = self.room
  let north = connection(graph, south, North)
  let southUp = connection(graph, south, Up)
  let northUp = connection(graph, north, Up)
  let southRoom = graph.rooms[south]
  let northRoom = graph.rooms[north]
  let southUpRoom = graph.rooms[southUp]
  let northUpRoom = graph.rooms[northUp]
  if southRoom.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 0, 8, opening(northRoom, Down))
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(southRoom, Down))
  if southUpRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 8, 1, 6, 8, 7, BaseGray)
  if northUpRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 8, 8, 6, 8, 14, BaseGray)
  for y in 1'i32 .. 7'i32:
    let stateValue = if y == 2 or y == 6: BaseGray else: BaseLight
    fill(p, chunk, chunkBox, 0, y, 0, 0, y, 15, stateValue)
    fill(p, chunk, chunkBox, 7, y, 0, 7, y, 15, stateValue)
    fill(p, chunk, chunkBox, 1, y, 0, 6, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 15, 6, y, 15, stateValue)
  for y in 1'i32 .. 7'i32:
    let stateValue = if y == 2 or y == 6: Lamp else: BaseBlack
    fill(p, chunk, chunkBox, 3, y, 7, 4, y, 8, stateValue)
  for (room, z, cross) in [(southRoom, 0'i32, 3'i32), (northRoom, 15'i32, 11'i32)]:
    let longitudinal = if z == 0: South else: North
    if opening(room, longitudinal):
      water(p, chunk, chunkBox, seaLevel, 3, 1, z, 4, 2, z)
    if opening(room, West):
      water(p, chunk, chunkBox, seaLevel, 0, 1, cross, 0, 2, cross + 1)
    if opening(room, East):
      water(p, chunk, chunkBox, seaLevel, 7, 1, cross, 7, 2, cross + 1)
  for (room, z, cross) in [(southUpRoom, 0'i32, 3'i32), (northUpRoom, 15'i32, 11'i32)]:
    let longitudinal = if z == 0: South else: North
    if opening(room, longitudinal):
      water(p, chunk, chunkBox, seaLevel, 3, 5, z, 4, 6, z)
    if opening(room, West):
      water(p, chunk, chunkBox, seaLevel, 0, 5, cross, 0, 6, cross + 1)
      fill(p, chunk, chunkBox, 1, 4, cross - 1, 2, 4, cross + 2, BaseLight)
      fill(p, chunk, chunkBox, 1, 1, cross - 1, 1, 3, cross - 1, BaseLight)
      fill(p, chunk, chunkBox, 1, 1, cross + 2, 1, 3, cross + 2, BaseLight)
    if opening(room, East):
      water(p, chunk, chunkBox, seaLevel, 7, 5, cross, 7, 6, cross + 1)
      fill(p, chunk, chunkBox, 5, 4, cross - 1, 6, 4, cross + 2, BaseLight)
      fill(p, chunk, chunkBox, 6, 1, cross - 1, 6, 3, cross - 1, BaseLight)
      fill(p, chunk, chunkBox, 6, 1, cross + 2, 6, 3, cross + 2, BaseLight)

proc placeDoubleZ(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let south = self.room
  let north = connection(graph, south, North)
  let southRoom = graph.rooms[south]
  let northRoom = graph.rooms[north]
  if southRoom.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 0, 8, opening(northRoom, Down))
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(southRoom, Down))
  if southRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 4, 1, 6, 4, 7, BaseGray)
  if northRoom.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 4, 8, 6, 4, 14, BaseGray)
  for (y, stateValue) in [(3'i32, BaseLight), (2'i32, BaseGray), (1'i32, BaseLight)]:
    fill(p, chunk, chunkBox, 0, y, 0, 0, y, 15, stateValue)
    fill(p, chunk, chunkBox, 7, y, 0, 7, y, 15, stateValue)
    fill(p, chunk, chunkBox, 1, y, 0, 7, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 15, 6, y, 15, stateValue)
  for (x, z0, z1) in [(1'i32, 1'i32, 2'i32), (6'i32, 1'i32, 2'i32), (1'i32, 13'i32, 14'i32), (6'i32, 13'i32, 14'i32)]:
    fill(p, chunk, chunkBox, x, 1, z0, x, 1, z1, BaseLight)
    fill(p, chunk, chunkBox, x, 3, z0, x, 3, z1, BaseLight)
  for (x, z) in [(2'i32, 6'i32), (5'i32, 6'i32), (2'i32, 9'i32), (5'i32, 9'i32)]:
    fill(p, chunk, chunkBox, x, 1, z, x, 3, z, BaseLight)
  fill(p, chunk, chunkBox, 3, 2, 6, 4, 2, 6, BaseLight)
  fill(p, chunk, chunkBox, 3, 2, 9, 4, 2, 9, BaseLight)
  fill(p, chunk, chunkBox, 2, 2, 7, 2, 2, 8, BaseLight)
  fill(p, chunk, chunkBox, 5, 2, 7, 5, 2, 8, BaseLight)
  for (x, z) in [(2'i32, 5'i32), (5'i32, 5'i32), (2'i32, 10'i32), (5'i32, 10'i32)]:
    placeAt(p, chunk, chunkBox, x, 2, z, Lamp)
    placeAt(p, chunk, chunkBox, x, 3, z, BaseLight)
  for (room, z, cross) in [(southRoom, 0'i32, 3'i32), (northRoom, 15'i32, 11'i32)]:
    let longitudinal = if z == 0: South else: North
    if opening(room, longitudinal):
      water(p, chunk, chunkBox, seaLevel, 3, 1, z, 4, 2, z)
    if opening(room, West):
      water(p, chunk, chunkBox, seaLevel, 0, 1, cross, 0, 2, cross + 1)
    if opening(room, East):
      water(p, chunk, chunkBox, seaLevel, 7, 1, cross, 7, 2, cross + 1)

proc placeSimple(self: RoomPiece, chunk: ProtoChunk, random: var RandomGenerator, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph, design: int32) =
  let p = self.pieceData
  let room = graph.rooms[self.room]
  if room.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(room, Down))
  if room.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 4, 1, 6, 4, 6, BaseGray)
  let centerPillar = design != 0 and nextBool(random) and not opening(room, Down) and not opening(room, Up) and countOpenings(room) > 1
  case design
  of 0:
    for (x0, z0, lampX, lampZ) in [(0'i32, 0'i32, 1'i32, 1'i32), (5'i32, 0'i32, 6'i32, 1'i32), (0'i32, 5'i32, 1'i32, 6'i32), (5'i32, 5'i32, 6'i32, 6'i32)]:
      fill(p, chunk, chunkBox, x0, 1, z0, x0 + 2, 1, z0 + 2, BaseLight)
      fill(p, chunk, chunkBox, x0, 3, z0, x0 + 2, 3, z0 + 2, BaseLight)
      let outerX = if x0 == 0: x0 else: x0 + 2
      let outerZ = if z0 == 0: z0 else: z0 + 2
      fill(p, chunk, chunkBox, outerX, 2, z0, outerX, 2, z0 + 2, BaseGray)
      fill(p, chunk, chunkBox, x0 + 1 - (if x0 != 0: 1'i32 else: 0'i32), 2, outerZ, x0 + 2 - (if x0 != 0: 1'i32 else: 0'i32), 2, outerZ, BaseGray)
      placeAt(p, chunk, chunkBox, lampX, 2, lampZ, Lamp)
    if opening(room, South):
      fill(p, chunk, chunkBox, 3, 3, 0, 4, 3, 0, BaseLight)
    else:
      fill(p, chunk, chunkBox, 3, 3, 0, 4, 3, 1, BaseLight)
      fill(p, chunk, chunkBox, 3, 2, 0, 4, 2, 0, BaseGray)
      fill(p, chunk, chunkBox, 3, 1, 0, 4, 1, 1, BaseLight)
    if opening(room, North):
      fill(p, chunk, chunkBox, 3, 3, 7, 4, 3, 7, BaseLight)
    else:
      fill(p, chunk, chunkBox, 3, 3, 6, 4, 3, 7, BaseLight)
      fill(p, chunk, chunkBox, 3, 2, 7, 4, 2, 7, BaseGray)
      fill(p, chunk, chunkBox, 3, 1, 6, 4, 1, 7, BaseLight)
    if opening(room, West):
      fill(p, chunk, chunkBox, 0, 3, 3, 0, 3, 4, BaseLight)
    else:
      fill(p, chunk, chunkBox, 0, 3, 3, 1, 3, 4, BaseLight)
      fill(p, chunk, chunkBox, 0, 2, 3, 0, 2, 4, BaseGray)
      fill(p, chunk, chunkBox, 0, 1, 3, 1, 1, 4, BaseLight)
    if opening(room, East):
      fill(p, chunk, chunkBox, 7, 3, 3, 7, 3, 4, BaseLight)
    else:
      fill(p, chunk, chunkBox, 6, 3, 3, 7, 3, 4, BaseLight)
      fill(p, chunk, chunkBox, 7, 2, 3, 7, 2, 4, BaseGray)
      fill(p, chunk, chunkBox, 6, 1, 3, 7, 1, 4, BaseLight)
  of 1:
    for (x, z) in [(2'i32, 2'i32), (2'i32, 5'i32), (5'i32, 5'i32), (5'i32, 2'i32)]:
      fill(p, chunk, chunkBox, x, 1, z, x, 3, z, BaseLight)
      placeAt(p, chunk, chunkBox, x, 2, z, Lamp)
    for (x0, z0, x1, z1) in [(0'i32, 0'i32, 1'i32, 0'i32), (0'i32, 1'i32, 0'i32, 1'i32), (0'i32, 7'i32, 1'i32, 7'i32), (0'i32, 6'i32, 0'i32, 6'i32), (6'i32, 7'i32, 7'i32, 7'i32), (7'i32, 6'i32, 7'i32, 6'i32), (6'i32, 0'i32, 7'i32, 0'i32), (7'i32, 1'i32, 7'i32, 1'i32)]:
      fill(p, chunk, chunkBox, x0, 1, z0, x1, 3, z1, BaseLight)
    for (x, z) in [(1'i32, 0'i32), (0'i32, 1'i32), (1'i32, 7'i32), (0'i32, 6'i32), (6'i32, 7'i32), (7'i32, 6'i32), (6'i32, 0'i32), (7'i32, 1'i32)]:
      placeAt(p, chunk, chunkBox, x, 2, z, BaseGray)
    for (direction, x0, z0, x1, z1) in [(South, 1'i32, 0'i32, 6'i32, 0'i32), (North, 1'i32, 7'i32, 6'i32, 7'i32), (West, 0'i32, 1'i32, 0'i32, 6'i32), (East, 7'i32, 1'i32, 7'i32, 6'i32)]:
      if not opening(room, direction):
        fill(p, chunk, chunkBox, x0, 1, z0, x1, 1, z1, BaseLight)
        fill(p, chunk, chunkBox, x0, 2, z0, x1, 2, z1, BaseGray)
        fill(p, chunk, chunkBox, x0, 3, z0, x1, 3, z1, BaseLight)
  else:
    for (y, stateValue) in [(1'i32, BaseLight), (2'i32, BaseBlack), (3'i32, BaseLight)]:
      fill(p, chunk, chunkBox, 0, y, 0, 0, y, 7, stateValue)
      fill(p, chunk, chunkBox, 7, y, 0, 7, y, 7, stateValue)
      fill(p, chunk, chunkBox, 1, y, 0, 6, y, 0, stateValue)
      fill(p, chunk, chunkBox, 1, y, 7, 6, y, 7, stateValue)
    for (direction, x0, z0, x1, z1) in [(South, 3'i32, 0'i32, 4'i32, 0'i32), (North, 3'i32, 7'i32, 4'i32, 7'i32), (West, 0'i32, 3'i32, 0'i32, 4'i32), (East, 7'i32, 3'i32, 7'i32, 4'i32)]:
      fill(p, chunk, chunkBox, x0, 1, z0, x1, 2, z1, BaseBlack)
      if opening(room, direction):
        water(p, chunk, chunkBox, seaLevel, x0, 1, z0, x1, 2, z1)
  if centerPillar:
    fill(p, chunk, chunkBox, 3, 1, 3, 4, 1, 4, BaseLight)
    fill(p, chunk, chunkBox, 3, 2, 3, 4, 2, 4, BaseGray)
    fill(p, chunk, chunkBox, 3, 3, 3, 4, 3, 4, BaseLight)

proc placeSimpleTop(self: RoomPiece, chunk: ProtoChunk, random: var RandomGenerator, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  let p = self.pieceData
  let room = graph.rooms[self.room]
  if room.index div 25 > 0:
    defaultFloor(p, chunk, chunkBox, 0, 0, opening(room, Down))
  if room.connections[ord(Up)] < 0:
    fillOnWater(p, chunk, chunkBox, 1, 4, 1, 6, 4, 6, BaseGray)
  for x in 1'i32 .. 6'i32:
    for z in 1'i32 .. 6'i32:
      if nextBoundedI32(random, 3) != 0:
        let y = if nextBoundedI32(random, 4) == 0: 2'i32 else: 3'i32
        fill(p, chunk, chunkBox, x, y, z, x, 3, z, WetSpongeState)
  for (y, stateValue) in [(1'i32, BaseLight), (2'i32, BaseBlack), (3'i32, BaseLight)]:
    fill(p, chunk, chunkBox, 0, y, 0, 0, y, 7, stateValue)
    fill(p, chunk, chunkBox, 7, y, 0, 7, y, 7, stateValue)
    fill(p, chunk, chunkBox, 1, y, 0, 6, y, 0, stateValue)
    fill(p, chunk, chunkBox, 1, y, 7, 6, y, 7, stateValue)
  fill(p, chunk, chunkBox, 0, 1, 3, 0, 2, 4, BaseBlack)
  fill(p, chunk, chunkBox, 7, 1, 3, 7, 2, 4, BaseBlack)
  fill(p, chunk, chunkBox, 3, 1, 0, 4, 2, 0, BaseBlack)
  fill(p, chunk, chunkBox, 3, 1, 7, 4, 2, 7, BaseBlack)
  if opening(room, South):
    water(p, chunk, chunkBox, seaLevel, 3, 1, 0, 4, 2, 0)

proc placeWing(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, design: int32) =
  let p = self.pieceData
  if (design and 1) == 0:
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, 10 - i, 3 - i, 20 - i, 12 + i, 3 - i, 20, BaseLight)
    fill(p, chunk, chunkBox, 7, 0, 6, 15, 0, 16, BaseLight)
    fill(p, chunk, chunkBox, 6, 0, 6, 6, 3, 20, BaseLight)
    fill(p, chunk, chunkBox, 16, 0, 6, 16, 3, 20, BaseLight)
    fill(p, chunk, chunkBox, 7, 1, 7, 7, 1, 20, BaseLight)
    fill(p, chunk, chunkBox, 15, 1, 7, 15, 1, 20, BaseLight)
    fill(p, chunk, chunkBox, 7, 1, 6, 9, 3, 6, BaseLight)
    fill(p, chunk, chunkBox, 13, 1, 6, 15, 3, 6, BaseLight)
    fill(p, chunk, chunkBox, 8, 1, 7, 9, 1, 7, BaseLight)
    fill(p, chunk, chunkBox, 13, 1, 7, 14, 1, 7, BaseLight)
    fill(p, chunk, chunkBox, 9, 0, 5, 13, 0, 5, BaseLight)
    fill(p, chunk, chunkBox, 10, 0, 7, 12, 0, 7, BaseBlack)
    fill(p, chunk, chunkBox, 8, 0, 10, 8, 0, 12, BaseBlack)
    fill(p, chunk, chunkBox, 14, 0, 10, 14, 0, 12, BaseBlack)
    for z in stepDown(18, 7, 3):
      placeAt(p, chunk, chunkBox, 6, 3, z, Lamp)
      placeAt(p, chunk, chunkBox, 16, 3, z, Lamp)
    for (x, z) in [(10'i32, 10'i32), (12'i32, 10'i32), (10'i32, 12'i32), (12'i32, 12'i32)]:
      placeAt(p, chunk, chunkBox, x, 0, z, Lamp)
    placeAt(p, chunk, chunkBox, 8, 3, 6, Lamp)
    placeAt(p, chunk, chunkBox, 14, 3, 6, Lamp)
    for (x, z) in [(4'i32, 4'i32), (18'i32, 4'i32), (4'i32, 18'i32), (18'i32, 18'i32)]:
      placeAt(p, chunk, chunkBox, x, 2, z, BaseLight)
      placeAt(p, chunk, chunkBox, x, 1, z, Lamp)
      placeAt(p, chunk, chunkBox, x, 0, z, BaseLight)
    placeAt(p, chunk, chunkBox, 9, 7, 20, BaseLight)
    placeAt(p, chunk, chunkBox, 13, 7, 20, BaseLight)
    fill(p, chunk, chunkBox, 6, 0, 21, 7, 4, 21, BaseLight)
    fill(p, chunk, chunkBox, 15, 0, 21, 16, 4, 21, BaseLight)
    spawnElder(p, chunk, chunkBox, 11, 2, 16)
  else:
    fill(p, chunk, chunkBox, 9, 3, 18, 13, 3, 20, BaseLight)
    fill(p, chunk, chunkBox, 9, 0, 18, 9, 2, 18, BaseLight)
    fill(p, chunk, chunkBox, 13, 0, 18, 13, 2, 18, BaseLight)
    for x in [9'i32, 13'i32]:
      placeAt(p, chunk, chunkBox, x, 6, 20, BaseLight)
      placeAt(p, chunk, chunkBox, x, 5, 20, Lamp)
      placeAt(p, chunk, chunkBox, x, 4, 20, BaseLight)
    fill(p, chunk, chunkBox, 7, 3, 7, 15, 3, 14, BaseLight)
    for x in [10'i32, 12'i32]:
      fill(p, chunk, chunkBox, x, 0, 10, x, 6, 10, BaseLight)
      fill(p, chunk, chunkBox, x, 0, 12, x, 6, 12, BaseLight)
      for z in [10'i32, 12'i32]:
        placeAt(p, chunk, chunkBox, x, 0, z, Lamp)
        placeAt(p, chunk, chunkBox, x, 4, z, Lamp)
    for x in [8'i32, 14'i32]:
      fill(p, chunk, chunkBox, x, 0, 7, x, 2, 7, BaseLight)
      fill(p, chunk, chunkBox, x, 0, 14, x, 2, 14, BaseLight)
    fill(p, chunk, chunkBox, 8, 3, 8, 8, 3, 13, BaseBlack)
    fill(p, chunk, chunkBox, 14, 3, 8, 14, 3, 13, BaseBlack)
    spawnElder(p, chunk, chunkBox, 11, 5, 13)

proc placePenthouse(self: RoomPiece, chunk: ProtoChunk, chunkBox: BlockBox, seaLevel: int32) =
  let p = self.pieceData
  fill(p, chunk, chunkBox, 2, -1, 2, 11, -1, 11, BaseLight)
  fill(p, chunk, chunkBox, 0, -1, 0, 1, -1, 11, BaseGray)
  fill(p, chunk, chunkBox, 12, -1, 0, 13, -1, 11, BaseGray)
  fill(p, chunk, chunkBox, 2, -1, 0, 11, -1, 1, BaseGray)
  fill(p, chunk, chunkBox, 2, -1, 12, 11, -1, 13, BaseGray)
  fill(p, chunk, chunkBox, 0, 0, 0, 0, 0, 13, BaseLight)
  fill(p, chunk, chunkBox, 13, 0, 0, 13, 0, 13, BaseLight)
  fill(p, chunk, chunkBox, 1, 0, 0, 12, 0, 0, BaseLight)
  fill(p, chunk, chunkBox, 1, 0, 13, 12, 0, 13, BaseLight)
  for i in stepUp(2, 11, 3):
    placeAt(p, chunk, chunkBox, 0, 0, i, Lamp)
    placeAt(p, chunk, chunkBox, 13, 0, i, Lamp)
    placeAt(p, chunk, chunkBox, i, 0, 0, Lamp)
  fill(p, chunk, chunkBox, 2, 0, 3, 4, 0, 9, BaseLight)
  fill(p, chunk, chunkBox, 9, 0, 3, 11, 0, 9, BaseLight)
  fill(p, chunk, chunkBox, 4, 0, 9, 9, 0, 11, BaseLight)
  for (x, z) in [(5'i32, 8'i32), (8'i32, 8'i32), (10'i32, 10'i32), (3'i32, 10'i32)]:
    placeAt(p, chunk, chunkBox, x, 0, z, BaseLight)
  fill(p, chunk, chunkBox, 3, 0, 3, 3, 0, 7, BaseBlack)
  fill(p, chunk, chunkBox, 10, 0, 3, 10, 0, 7, BaseBlack)
  fill(p, chunk, chunkBox, 6, 0, 10, 7, 0, 10, BaseBlack)
  for x in [3'i32, 10'i32]:
    for z in stepUp(2, 8, 3):
      fill(p, chunk, chunkBox, x, 0, z, x, 2, z, BaseLight)
  fill(p, chunk, chunkBox, 5, 0, 10, 5, 2, 10, BaseLight)
  fill(p, chunk, chunkBox, 8, 0, 10, 8, 2, 10, BaseLight)
  fill(p, chunk, chunkBox, 6, -1, 7, 7, -1, 8, BaseBlack)
  water(p, chunk, chunkBox, seaLevel, 6, -1, 3, 7, -1, 4)
  spawnElder(p, chunk, chunkBox, 6, 1, 6)

proc placeRoom(self: RoomPiece, chunk: ProtoChunk, random: var RandomGenerator, chunkBox: BlockBox, seaLevel: int32, graph: RoomGraph) =
  ## `RoomPiece::place`
  case self.kind.tag
  of RoomKindTag.Entry: placeEntry(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.Core: placeCore(self, chunk, chunkBox)
  of RoomKindTag.DoubleX: placeDoubleX(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.DoubleXY: placeDoubleXy(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.DoubleY: placeDoubleY(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.DoubleYZ: placeDoubleYz(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.DoubleZ: placeDoubleZ(self, chunk, chunkBox, seaLevel, graph)
  of RoomKindTag.Simple: placeSimple(self, chunk, random, chunkBox, seaLevel, graph, self.kind.design)
  of RoomKindTag.SimpleTop: placeSimpleTop(self, chunk, random, chunkBox, seaLevel, graph)
  of RoomKindTag.Wing: placeWing(self, chunk, chunkBox, self.kind.design)
  of RoomKindTag.Penthouse: placePenthouse(self, chunk, chunkBox, seaLevel)

# building.rs

proc generateWing(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox, flipped: bool, x: int32) =
  let p = self.base
  if not chunkIntersects(p, chunkBox, x, 0, x + 23, 20):
    return
  fill(p, chunk, chunkBox, x, 0, 0, x + 24, 0, 20, BaseGray)
  water(p, chunk, chunkBox, self.seaLevel, x, 1, 0, x + 24, 10, 20)
  for i in 0'i32 ..< 4'i32:
    fill(p, chunk, chunkBox, x + i, i + 1, i, x + i, i + 1, 20, BaseLight)
    fill(p, chunk, chunkBox, x + i + 7, i + 5, i + 7, x + i + 7, i + 5, 20, BaseLight)
    fill(p, chunk, chunkBox, x + 17 - i, i + 5, i + 7, x + 17 - i, i + 5, 20, BaseLight)
    fill(p, chunk, chunkBox, x + 24 - i, i + 1, i, x + 24 - i, i + 1, 20, BaseLight)
    fill(p, chunk, chunkBox, x + i + 1, i + 1, i, x + 23 - i, i + 1, i, BaseLight)
    fill(p, chunk, chunkBox, x + i + 8, i + 5, i + 7, x + 16 - i, i + 5, i + 7, BaseLight)
  fill(p, chunk, chunkBox, x + 4, 4, 4, x + 6, 4, 20, BaseGray)
  fill(p, chunk, chunkBox, x + 7, 4, 4, x + 17, 4, 6, BaseGray)
  fill(p, chunk, chunkBox, x + 18, 4, 4, x + 20, 4, 20, BaseGray)
  fill(p, chunk, chunkBox, x + 11, 8, 11, x + 13, 8, 20, BaseGray)
  for z in [12'i32, 15'i32, 18'i32]:
    placeAt(p, chunk, chunkBox, x + 12, 9, z, BaseLight)
  let left = x + (if flipped: 19'i32 else: 5'i32)
  let right = x + (if flipped: 5'i32 else: 19'i32)
  for z in stepDown(20, 5, 3):
    placeAt(p, chunk, chunkBox, left, 5, z, BaseLight)
  for z in stepDown(19, 7, 3):
    placeAt(p, chunk, chunkBox, right, 5, z, BaseLight)
  for i in 0'i32 ..< 4'i32:
    let pos = if flipped: x + 24 - (17 - i * 3) else: x + 17 - i * 3
    placeAt(p, chunk, chunkBox, pos, 5, 5, BaseLight)
  placeAt(p, chunk, chunkBox, right, 5, 5, BaseLight)
  fill(p, chunk, chunkBox, x + 11, 1, 12, x + 13, 7, 12, BaseGray)
  fill(p, chunk, chunkBox, x + 12, 1, 11, x + 12, 7, 13, BaseGray)

proc generateEntranceArches(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if not chunkIntersects(p, chunkBox, 22, 5, 35, 17):
    return
  water(p, chunk, chunkBox, self.seaLevel, 25, 0, 0, 32, 8, 20)
  for i in 0'i32 ..< 4'i32:
    let z = 5 + i * 4
    fill(p, chunk, chunkBox, 24, 2, z, 24, 4, z, BaseLight)
    fill(p, chunk, chunkBox, 22, 4, z, 23, 4, z, BaseLight)
    placeAt(p, chunk, chunkBox, 25, 5, z, BaseLight)
    placeAt(p, chunk, chunkBox, 26, 6, z, BaseLight)
    placeAt(p, chunk, chunkBox, 26, 5, z, Lamp)
    fill(p, chunk, chunkBox, 33, 2, z, 33, 4, z, BaseLight)
    fill(p, chunk, chunkBox, 34, 4, z, 35, 4, z, BaseLight)
    placeAt(p, chunk, chunkBox, 32, 5, z, BaseLight)
    placeAt(p, chunk, chunkBox, 31, 6, z, BaseLight)
    placeAt(p, chunk, chunkBox, 31, 5, z, Lamp)
    fill(p, chunk, chunkBox, 27, 6, z, 30, 6, z, BaseGray)

proc generateEntranceWall(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if not chunkIntersects(p, chunkBox, 15, 20, 42, 21):
    return
  fill(p, chunk, chunkBox, 15, 0, 21, 42, 0, 21, BaseGray)
  water(p, chunk, chunkBox, self.seaLevel, 26, 1, 21, 31, 3, 21)
  for (x0, y, x1) in [(21'i32, 12'i32, 36'i32), (17'i32, 11'i32, 40'i32), (16'i32, 10'i32, 41'i32), (15'i32, 9'i32, 42'i32), (15'i32, 8'i32, 42'i32), (15'i32, 7'i32, 42'i32), (16'i32, 6'i32, 41'i32), (17'i32, 5'i32, 40'i32), (21'i32, 4'i32, 36'i32), (22'i32, 3'i32, 26'i32), (31'i32, 3'i32, 35'i32), (23'i32, 2'i32, 25'i32), (32'i32, 2'i32, 34'i32)]:
    fill(p, chunk, chunkBox, x0, y, 21, x1, y, 21, BaseGray)
  fill(p, chunk, chunkBox, 28, 4, 20, 29, 4, 21, BaseLight)
  for (x, y) in [(27'i32, 3'i32), (30'i32, 3'i32), (26'i32, 2'i32), (31'i32, 2'i32), (25'i32, 1'i32), (32'i32, 1'i32)]:
    placeAt(p, chunk, chunkBox, x, y, 21, BaseLight)
  for i in 0'i32 ..< 7'i32:
    placeAt(p, chunk, chunkBox, 28 - i, 6 + i, 21, BaseBlack)
    placeAt(p, chunk, chunkBox, 29 + i, 6 + i, 21, BaseBlack)
  for i in 0'i32 ..< 4'i32:
    placeAt(p, chunk, chunkBox, 28 - i, 9 + i, 21, BaseBlack)
    placeAt(p, chunk, chunkBox, 29 + i, 9 + i, 21, BaseBlack)
  placeAt(p, chunk, chunkBox, 28, 12, 21, BaseBlack)
  placeAt(p, chunk, chunkBox, 29, 12, 21, BaseBlack)
  for i in 0'i32 ..< 3'i32:
    for y in 8'i32 .. 9'i32:
      placeAt(p, chunk, chunkBox, 22 - i * 2, y, 21, BaseBlack)
      placeAt(p, chunk, chunkBox, 35 + i * 2, y, 21, BaseBlack)
  for (x0, y0, x1, y1) in [(15'i32, 13'i32, 42'i32, 15'i32), (15'i32, 1'i32, 15'i32, 6'i32), (16'i32, 1'i32, 16'i32, 5'i32), (17'i32, 1'i32, 20'i32, 4'i32), (21'i32, 1'i32, 21'i32, 3'i32), (22'i32, 1'i32, 22'i32, 2'i32), (23'i32, 1'i32, 24'i32, 1'i32), (42'i32, 1'i32, 42'i32, 6'i32), (41'i32, 1'i32, 41'i32, 5'i32), (37'i32, 1'i32, 40'i32, 4'i32), (36'i32, 1'i32, 36'i32, 3'i32), (33'i32, 1'i32, 34'i32, 1'i32), (35'i32, 1'i32, 35'i32, 2'i32)]:
    water(p, chunk, chunkBox, self.seaLevel, x0, y0, 21, x1, y1, 21)

proc generateRoof(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if not chunkIntersects(p, chunkBox, 21, 21, 36, 36):
    return
  fill(p, chunk, chunkBox, 21, 0, 22, 36, 0, 36, BaseGray)
  water(p, chunk, chunkBox, self.seaLevel, 21, 1, 22, 36, 23, 36)
  for i in 0'i32 ..< 4'i32:
    fill(p, chunk, chunkBox, 21 + i, 13 + i, 21 + i, 36 - i, 13 + i, 21 + i, BaseLight)
    fill(p, chunk, chunkBox, 21 + i, 13 + i, 36 - i, 36 - i, 13 + i, 36 - i, BaseLight)
    fill(p, chunk, chunkBox, 21 + i, 13 + i, 22 + i, 21 + i, 13 + i, 35 - i, BaseLight)
    fill(p, chunk, chunkBox, 36 - i, 13 + i, 22 + i, 36 - i, 13 + i, 35 - i, BaseLight)
  fill(p, chunk, chunkBox, 25, 16, 25, 32, 16, 32, BaseGray)
  for (x, z) in [(25'i32, 25'i32), (32'i32, 25'i32), (25'i32, 32'i32), (32'i32, 32'i32)]:
    fill(p, chunk, chunkBox, x, 17, z, x, 19, z, BaseLight)
  for (x, y, z, stateValue) in [(26'i32, 20'i32, 26'i32, BaseLight), (27'i32, 21'i32, 27'i32, BaseLight), (27'i32, 20'i32, 27'i32, Lamp), (26'i32, 20'i32, 31'i32, BaseLight), (27'i32, 21'i32, 30'i32, BaseLight), (27'i32, 20'i32, 30'i32, Lamp), (31'i32, 20'i32, 31'i32, BaseLight), (30'i32, 21'i32, 30'i32, BaseLight), (30'i32, 20'i32, 30'i32, Lamp), (31'i32, 20'i32, 26'i32, BaseLight), (30'i32, 21'i32, 27'i32, BaseLight), (30'i32, 20'i32, 27'i32, Lamp)]:
    placeAt(p, chunk, chunkBox, x, y, z, stateValue)
  fill(p, chunk, chunkBox, 28, 21, 27, 29, 21, 27, BaseGray)
  fill(p, chunk, chunkBox, 27, 21, 28, 27, 21, 29, BaseGray)
  fill(p, chunk, chunkBox, 28, 21, 30, 29, 21, 30, BaseGray)
  fill(p, chunk, chunkBox, 30, 21, 28, 30, 21, 29, BaseGray)

proc generateLowerWall(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if chunkIntersects(p, chunkBox, 0, 21, 6, 58):
    fill(p, chunk, chunkBox, 0, 0, 21, 6, 0, 57, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 0, 1, 21, 6, 7, 57)
    fill(p, chunk, chunkBox, 4, 4, 21, 6, 4, 53, BaseGray)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, i, i + 1, 21, i, i + 1, 57 - i, BaseLight)
    for z in stepUp(23, 52, 3):
      placeAt(p, chunk, chunkBox, 5, 5, z, BaseLight)
    placeAt(p, chunk, chunkBox, 5, 5, 52, BaseLight)
    fill(p, chunk, chunkBox, 4, 1, 52, 6, 3, 52, BaseGray)
    fill(p, chunk, chunkBox, 5, 1, 51, 5, 3, 53, BaseGray)
  if chunkIntersects(p, chunkBox, 51, 21, 58, 58):
    fill(p, chunk, chunkBox, 51, 0, 21, 57, 0, 57, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 51, 1, 21, 57, 7, 57)
    fill(p, chunk, chunkBox, 51, 4, 21, 53, 4, 53, BaseGray)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, 57 - i, i + 1, 21, 57 - i, i + 1, 57 - i, BaseLight)
    for z in stepUp(23, 52, 3):
      placeAt(p, chunk, chunkBox, 52, 5, z, BaseLight)
    placeAt(p, chunk, chunkBox, 52, 5, 52, BaseLight)
    fill(p, chunk, chunkBox, 51, 1, 52, 53, 3, 52, BaseGray)
    fill(p, chunk, chunkBox, 52, 1, 51, 52, 3, 53, BaseGray)
  if chunkIntersects(p, chunkBox, 0, 51, 57, 57):
    fill(p, chunk, chunkBox, 7, 0, 51, 50, 0, 57, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 7, 1, 51, 50, 10, 57)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, i + 1, i + 1, 57 - i, 56 - i, i + 1, 57 - i, BaseLight)

proc generateMiddleWall(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if chunkIntersects(p, chunkBox, 7, 21, 13, 50):
    fill(p, chunk, chunkBox, 7, 0, 21, 13, 0, 50, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 7, 1, 21, 13, 10, 50)
    fill(p, chunk, chunkBox, 11, 8, 21, 13, 8, 53, BaseGray)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, i + 7, i + 5, 21, i + 7, i + 5, 54, BaseLight)
    for z in stepUp(21, 45, 3):
      placeAt(p, chunk, chunkBox, 12, 9, z, BaseLight)
  if chunkIntersects(p, chunkBox, 44, 21, 50, 54):
    fill(p, chunk, chunkBox, 44, 0, 21, 50, 0, 50, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 44, 1, 21, 50, 10, 50)
    fill(p, chunk, chunkBox, 44, 8, 21, 46, 8, 53, BaseGray)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, 50 - i, i + 5, 21, 50 - i, i + 5, 54, BaseLight)
    for z in stepUp(21, 45, 3):
      placeAt(p, chunk, chunkBox, 45, 9, z, BaseLight)
  if chunkIntersects(p, chunkBox, 8, 44, 49, 54):
    fill(p, chunk, chunkBox, 14, 0, 44, 43, 0, 50, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 14, 1, 44, 43, 10, 50)
    for x in stepUp(12, 45, 3):
      placeAt(p, chunk, chunkBox, x, 9, 45, BaseLight)
      placeAt(p, chunk, chunkBox, x, 9, 52, BaseLight)
      if x == 12 or x == 18 or x == 24 or x == 33 or x == 39 or x == 45:
        for (y, z) in [(9'i32, 47'i32), (9'i32, 50'i32), (10'i32, 45'i32), (10'i32, 46'i32), (10'i32, 51'i32), (10'i32, 52'i32), (11'i32, 47'i32), (11'i32, 50'i32), (12'i32, 48'i32), (12'i32, 49'i32)]:
          placeAt(p, chunk, chunkBox, x, y, z, BaseLight)
    for i in 0'i32 ..< 3'i32:
      fill(p, chunk, chunkBox, 8 + i, 5 + i, 54, 49 - i, 5 + i, 54, BaseGray)
    fill(p, chunk, chunkBox, 11, 8, 54, 46, 8, 54, BaseLight)
    fill(p, chunk, chunkBox, 14, 8, 44, 43, 8, 53, BaseGray)

proc generateUpperWall(self: MonumentBuilding, chunk: ProtoChunk, chunkBox: BlockBox) =
  let p = self.base
  if chunkIntersects(p, chunkBox, 14, 21, 20, 43):
    fill(p, chunk, chunkBox, 14, 0, 21, 20, 0, 43, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 14, 1, 22, 20, 14, 43)
    fill(p, chunk, chunkBox, 18, 12, 22, 20, 12, 39, BaseGray)
    fill(p, chunk, chunkBox, 18, 12, 21, 20, 12, 21, BaseLight)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, i + 14, i + 9, 21, i + 14, i + 9, 43 - i, BaseLight)
    for z in stepUp(23, 39, 3):
      placeAt(p, chunk, chunkBox, 19, 13, z, BaseLight)
  if chunkIntersects(p, chunkBox, 37, 21, 43, 43):
    fill(p, chunk, chunkBox, 37, 0, 21, 43, 0, 43, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 37, 1, 22, 43, 14, 43)
    fill(p, chunk, chunkBox, 37, 12, 22, 39, 12, 39, BaseGray)
    fill(p, chunk, chunkBox, 37, 12, 21, 39, 12, 21, BaseLight)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, 43 - i, i + 9, 21, 43 - i, i + 9, 43 - i, BaseLight)
    for z in stepUp(23, 39, 3):
      placeAt(p, chunk, chunkBox, 38, 13, z, BaseLight)
  if chunkIntersects(p, chunkBox, 15, 37, 42, 43):
    fill(p, chunk, chunkBox, 21, 0, 37, 36, 0, 43, BaseGray)
    water(p, chunk, chunkBox, self.seaLevel, 21, 1, 37, 36, 14, 43)
    fill(p, chunk, chunkBox, 21, 12, 37, 36, 12, 39, BaseGray)
    for i in 0'i32 ..< 4'i32:
      fill(p, chunk, chunkBox, 15 + i, i + 9, 43 - i, 42 - i, i + 9, 43 - i, BaseLight)
    for x in stepUp(21, 36, 3):
      placeAt(p, chunk, chunkBox, x, 13, 38, BaseLight)

proc placeBuilding*(self: MonumentBuilding, chunk: ProtoChunk, random: var RandomGenerator, chunkBox: BlockBox) =
  let seaLevel = self.seaLevel
  let waterHeight = max(seaLevel, 64) - self.base.piece.boundingBox.min.y
  water(self.base, chunk, chunkBox, seaLevel, 0, 0, 0, 58, waterHeight, 58)
  generateWing(self, chunk, chunkBox, false, 0)
  generateWing(self, chunk, chunkBox, true, 33)
  generateEntranceArches(self, chunk, chunkBox)
  generateEntranceWall(self, chunk, chunkBox)
  generateRoof(self, chunk, chunkBox)
  generateLowerWall(self, chunk, chunkBox)
  generateMiddleWall(self, chunk, chunkBox)
  generateUpperWall(self, chunk, chunkBox)
  for pillarX in 0'i32 ..< 7'i32:
    var pillarZ = 0'i32
    while pillarZ < 7:
      if pillarZ == 0 and pillarX == 3:
        pillarZ = 6
      let x = pillarX * 9
      let z = pillarZ * 9
      for dx in 0'i32 ..< 4'i32:
        for dz in 0'i32 ..< 4'i32:
          placeAt(self.base, chunk, chunkBox, x + dx, 0, z + dz, BaseLight)
          fillDownwards(self.base.piece, chunk, BaseLight, x + dx, -1, z + dz, chunkBox)
      pillarZ += (if pillarX == 0 or pillarX == 6: 1'i32 else: 6'i32)
  for offset in 0'i32 ..< 5'i32:
    water(self.base, chunk, chunkBox, seaLevel, -1 - offset, offset * 2, -1 - offset, -1 - offset, 23, 58 + offset)
    water(self.base, chunk, chunkBox, seaLevel, 58 + offset, offset * 2, -1 - offset, 58 + offset, 23, 58 + offset)
    water(self.base, chunk, chunkBox, seaLevel, -offset, offset * 2, -1 - offset, 57 + offset, 23, -1 - offset)
    water(self.base, chunk, chunkBox, seaLevel, -offset, offset * 2, 58 + offset, 57 + offset, 23, 58 + offset)
  for child in self.children:
    if intersects(child.pieceData.piece.boundingBox, chunkBox):
      placeRoom(child, chunk, random, chunkBox, seaLevel, self.graph)

proc placeMonument(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt, random: var RandomGenerator,
                   seed: int64, chunkBox: BlockBox) {.nimcall.} =
  placeBuilding(cast[MonumentBuilding](self), chunk, random, chunkBox)

proc newMonumentBuilding*(random: var RandomGenerator, west, north: int32, direction: BlockDirection, seaLevel: int32): MonumentBuilding =
  ## `MonumentBuilding::new`
  var piece = newStructurePiece(StructurePieceType.OceanMonumentBase, newBlockBox(west, 39, north, west + 57, 61, north + 57), 0)
  setFacing(piece, direction)
  let base = MonumentPiece(piece: piece)
  var roomOrder: seq[int] = @[]
  let graph = generateGraph(random, roomOrder)
  graph.rooms[graph.source].claimed = true
  var children = @[roomForRoom(RoomKind(tag: RoomKindTag.Entry), direction, graph.source, graph.rooms[graph.source].index),
    roomForRoom(RoomKind(tag: RoomKindTag.Core), direction, graph.core, graph.rooms[graph.core].index)]
  for oi in 0 ..< roomOrder.len:
    let room = roomOrder[oi]
    if graph.rooms[room].claimed or isSpecial(graph.rooms[room]):
      continue
    children.add(fit(random, direction, room, graph))
  let roomOffset = offsetPos(base.piece, 9, 0, 22)
  for ci in 0 ..< children.len:
    movePos(children[ci].pieceData.piece.boundingBox, roomOffset.x, roomOffset.y, roomOffset.z)
  let leftWing = boxFromCorners(offsetPos(base.piece, 1, 1, 1), offsetPos(base.piece, 23, 8, 21))
  let rightWing = boxFromCorners(offsetPos(base.piece, 34, 1, 1), offsetPos(base.piece, 56, 8, 21))
  let penthouse = boxFromCorners(offsetPos(base.piece, 22, 13, 22), offsetPos(base.piece, 35, 17, 35))
  let wingDesign = nextI32(random)
  children.add(roomSpecial(RoomKind(tag: RoomKindTag.Wing, design: wingDesign), direction, leftWing))
  children.add(roomSpecial(RoomKind(tag: RoomKindTag.Wing, design: cast[int32](cast[uint32](wingDesign) + 1'u32)), direction, rightWing))
  children.add(roomSpecial(RoomKind(tag: RoomKindTag.Penthouse), direction, penthouse))
  MonumentBuilding(piece: piece, placeFn: placeMonument, base: base, graph: graph, children: children, seaLevel: seaLevel)

proc roomBoxes*(b: MonumentBuilding): seq[BlockBox] =
  ## The rooms' boxes, for a test: a save has only the one piece.
  result = @[]
  for i in 0 ..< b.children.len:
    result.add(b.children[i].pieceData.piece.boundingBox)

proc graphRoomCountsAndConnected*(random: var RandomGenerator): bool =
  ## `generated_graph_keeps_every_room_connected`
  var order: seq[int] = @[]
  let graph = generateGraph(random, order)
  if graph.rooms.len != 49 or order.len != 49:
    return false
  var special = 0
  for i in 0 ..< graph.rooms.len:
    if isSpecial(graph.rooms[i]):
      inc special
    elif not findSource(graph, i):
      return false
  special == 3

proc hasTagBiome(tagName: string, biomeId: uint16): bool =
  let (found, ids) = getTagIds(rkWorldgenBiome, tagName)
  if found:
    for i in 0 ..< ids.len:
      if ids[i] == biomeId:
        return true
  false

proc hasValidBiomes*(biomeSupplier: BlenderBiomeSupplier, sampler: MultiNoiseSampler, chunkX, chunkZ, seaLevel, startY: int32): bool =
  ## `has_valid_biomes`
  let startX = getCenterX(chunkX)
  let startZ = getCenterZ(chunkZ)
  let startBiome = biome(biomeSupplier, biomeFromBlock(startX), biomeFromBlock(startY), biomeFromBlock(startZ), sampler)
  if not hasTagBiome(HasOceanMonumentTag, uint16(startBiome.id)):
    return false
  let centerX = startBlockX(chunkX) + 9
  let centerZ = startBlockZ(chunkZ) + 9
  for x in biomeFromBlock(centerX - 29) .. biomeFromBlock(centerX + 29):
    for z in biomeFromBlock(centerZ - 29) .. biomeFromBlock(centerZ + 29):
      for y in biomeFromBlock(seaLevel - 29) .. biomeFromBlock(seaLevel + 29):
        if not hasTagBiome(SurroundingTag, uint16(biome(biomeSupplier, x, y, z, sampler).id)):
          return false
  true

proc oceanMonumentPosition*(context: var StructureGeneratorContext): StructurePosition =
  ## `<OceanMonumentGenerator as StructureGenerator>::get_structure_position`
  let centerX = getCenterX(context.chunkX)
  let centerZ = getCenterZ(context.chunkZ)
  let startY =
    if context.heightSampler == nil: context.seaLevel
    else: estimateOceanFloorHeight(context.heightSampler, centerX, centerZ)
  let direction = getRandomHorizontalDirection(context.random)
  let building = newMonumentBuilding(context.random, startBlockX(context.chunkX) - 29, startBlockZ(context.chunkZ) - 29, direction,
    context.seaLevel)
  singlePiecePosition(building, centerX, startY, centerZ)
