## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/ocean_ruin.rs
##
## The pinned tree's piece was one template in a whole-height box, so this one comes from the newer tree. A ruin learns its
## height when placed, as in vanilla: its box stays at y 90 until then, which is also what a save holds until then.

{.feature: "lenientnils".}

import std/options
import "../template/templatemod"
import ../../../../util/legacy_rand
import structuresmod

const
  WarmRuins* = ["underwater_ruin/warm_1", "underwater_ruin/warm_2", "underwater_ruin/warm_3", "underwater_ruin/warm_4",
    "underwater_ruin/warm_5", "underwater_ruin/warm_6", "underwater_ruin/warm_7", "underwater_ruin/warm_8"]
  BigWarmRuins* = ["underwater_ruin/big_warm_4", "underwater_ruin/big_warm_5", "underwater_ruin/big_warm_6",
    "underwater_ruin/big_warm_7"]
  RuinsBrick* = ["underwater_ruin/brick_1", "underwater_ruin/brick_2", "underwater_ruin/brick_3", "underwater_ruin/brick_4",
    "underwater_ruin/brick_5", "underwater_ruin/brick_6", "underwater_ruin/brick_7", "underwater_ruin/brick_8"]
  RuinsCracked* = ["underwater_ruin/cracked_1", "underwater_ruin/cracked_2", "underwater_ruin/cracked_3",
    "underwater_ruin/cracked_4", "underwater_ruin/cracked_5", "underwater_ruin/cracked_6", "underwater_ruin/cracked_7",
    "underwater_ruin/cracked_8"]
  RuinsMossy* = ["underwater_ruin/mossy_1", "underwater_ruin/mossy_2", "underwater_ruin/mossy_3", "underwater_ruin/mossy_4",
    "underwater_ruin/mossy_5", "underwater_ruin/mossy_6", "underwater_ruin/mossy_7", "underwater_ruin/mossy_8"]
  BigRuinsBrick* = ["underwater_ruin/big_brick_1", "underwater_ruin/big_brick_2", "underwater_ruin/big_brick_3",
    "underwater_ruin/big_brick_8"]
  BigRuinsCracked* = ["underwater_ruin/big_cracked_1", "underwater_ruin/big_cracked_2", "underwater_ruin/big_cracked_3",
    "underwater_ruin/big_cracked_8"]
  BigRuinsMossy* = ["underwater_ruin/big_mossy_1", "underwater_ruin/big_mossy_2", "underwater_ruin/big_mossy_3",
    "underwater_ruin/big_mossy_8"]

let
  WaterBlock = blockIdNamed("water")
  AirState = blockState("air")
  WaterState = blockState("water")
  SuspiciousSand = blockState("suspicious_sand")
  SuspiciousGravel = blockState("suspicious_gravel")

type
  OceanRuinPiece* = ref object of StructurePieceBase
    templateData*: StructureTemplate
    templateName*: string
    templatePosition*: Vector3[int32]
    rotation*: Rotation
    integrity*: float32
    isWarm*: bool
    isLarge*: bool
    seaLevel: int32  ## `chunk.get_sea_level()`: a proto chunk here does not hold one.

proc placeOceanRuin(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.}

proc translateOceanRuin(self: StructurePieceBase, x, y, z: int32) {.nimcall.} =
  let p = cast[OceanRuinPiece](self)
  movePos(p.piece.boundingBox, x, y, z)
  p.templatePosition = vec3[int32](p.templatePosition.x + x, p.templatePosition.y + y, p.templatePosition.z + z)

proc newOceanRuinPiece(t: StructureTemplate, templateName: string, position: Vector3[int32], rotation: Rotation,
                       integrity: float32, isWarm, isLarge: bool): OceanRuinPiece =
  let boundingBox = getBoundingBoxStatic(position, rotation, vec3[int32](0, 0, 0), Mirror.None, t.size)
  OceanRuinPiece(piece: newStructurePiece(StructurePieceType.OceanTemple, boundingBox, 0), placeFn: placeOceanRuin,
    translateFn: translateOceanRuin, templateData: t, templateName: templateName, templatePosition: position, rotation: rotation,
    integrity: integrity, isWarm: isWarm, isLarge: isLarge)

proc addTemplatePiece(collector: StructurePiecesCollector, name: string, position: Vector3[int32], rotation: Rotation,
                      integrity: float32, isWarm, isLarge: bool) =
  let t = getTemplate(name)
  if t != nil:
    addPiece(collector, newOceanRuinPiece(t, name, position, rotation, integrity, isWarm, isLarge))

proc addPieceTo(collector: StructurePiecesCollector, position: Vector3[int32], rotation: Rotation, random: var RandomGenerator,
                isWarm, isLarge: bool, baseIntegrity: float32) =
  ## `add_piece`
  if isWarm:
    let name =
      if isLarge: BigWarmRuins[int(nextBoundedI32(random, int32(BigWarmRuins.len)))]
      else: WarmRuins[int(nextBoundedI32(random, int32(WarmRuins.len)))]
    addTemplatePiece(collector, name, position, rotation, baseIntegrity, isWarm, isLarge)
  elif isLarge:
    let idx = int(nextBoundedI32(random, int32(BigRuinsBrick.len)))
    addTemplatePiece(collector, BigRuinsBrick[idx], position, rotation, baseIntegrity, isWarm, isLarge)
    addTemplatePiece(collector, BigRuinsCracked[idx], position, rotation, 0.7'f32, isWarm, isLarge)
    addTemplatePiece(collector, BigRuinsMossy[idx], position, rotation, 0.5'f32, isWarm, isLarge)
  else:
    let idx = int(nextBoundedI32(random, int32(RuinsBrick.len)))
    addTemplatePiece(collector, RuinsBrick[idx], position, rotation, baseIntegrity, isWarm, isLarge)
    addTemplatePiece(collector, RuinsCracked[idx], position, rotation, 0.7'f32, isWarm, isLarge)
    addTemplatePiece(collector, RuinsMossy[idx], position, rotation, 0.5'f32, isWarm, isLarge)

proc generateClusterPositions(random: var RandomGenerator, origin: Vector3[int32]): seq[Vector3[int32]] =
  ## The order of the draws is the order of the fields: each `+ 1` or `+ 4` comes after its own draw.
  result = newSeqOfCap[Vector3[int32]](8)
  block:
    let dx = -16 + nextBoundedI32(random, 8) + 1
    let dz = 16 + nextBoundedI32(random, 7) + 1
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = -16 + nextBoundedI32(random, 8) + 1
    let dz = nextBoundedI32(random, 7) + 1
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = -16 + nextBoundedI32(random, 8) + 1
    let dz = -16 + nextBoundedI32(random, 5) + 4
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = nextBoundedI32(random, 7) + 1
    let dz = 16 + nextBoundedI32(random, 7) + 1
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = nextBoundedI32(random, 7) + 1
    let dz = -16 + nextBoundedI32(random, 3) + 4
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = 16 + nextBoundedI32(random, 7) + 1
    let dz = 16 + nextBoundedI32(random, 6) + 3
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = 16 + nextBoundedI32(random, 7) + 1
    let dz = nextBoundedI32(random, 7) + 1
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))
  block:
    let dx = 16 + nextBoundedI32(random, 7) + 1
    let dz = -16 + nextBoundedI32(random, 5) + 4
    result.add(vec3[int32](origin.x + dx, origin.y, origin.z + dz))

proc addClusterRuins(collector: StructurePiecesCollector, random: var RandomGenerator, rotation: Rotation, p: Vector3[int32],
                     isWarm: bool) =
  let parentPos = vec3[int32](p.x, 90, p.z)
  let cornerOffset = transformBlockPos(vec3[int32](15, 0, 15), Mirror.None, rotation, vec3[int32](0, 0, 0))
  let parentCorner = vec3[int32](cornerOffset.x + parentPos.x, cornerOffset.y + parentPos.y, cornerOffset.z + parentPos.z)
  let parentBb = newBlockBox(min(parentPos.x, parentCorner.x), min(parentPos.y, parentCorner.y), min(parentPos.z, parentCorner.z),
    max(parentPos.x, parentCorner.x), max(parentPos.y, parentCorner.y), max(parentPos.z, parentCorner.z))
  let parentBottomLeft = vec3[int32](min(parentPos.x, parentCorner.x), parentPos.y, min(parentPos.z, parentCorner.z))
  var allPositions = generateClusterPositions(random, parentBottomLeft)
  let ruinsCount = nextBoundedI32(random, 5) + 4
  var n = 0'i32
  while n < ruinsCount:
    if allPositions.len == 0:
      break
    let idx = int(nextBoundedI32(random, int32(allPositions.len)))
    let pos = allPositions[idx]
    allPositions.delete(idx)
    let nextRotation = fromIndex(Rotation, uint8(nextBoundedI32(random, 4)))
    let nextOffset = transformBlockPos(vec3[int32](5, 0, 6), Mirror.None, nextRotation, vec3[int32](0, 0, 0))
    let nextCorner = vec3[int32](nextOffset.x + pos.x, nextOffset.y + pos.y, nextOffset.z + pos.z)
    let nextBb = newBlockBox(min(pos.x, nextCorner.x), min(pos.y, nextCorner.y), min(pos.z, nextCorner.z),
      max(pos.x, nextCorner.x), max(pos.y, nextCorner.y), max(pos.z, nextCorner.z))
    if not intersects(nextBb, parentBb):
      addPieceTo(collector, pos, nextRotation, random, isWarm, false, 0.8'f32)
    inc n

proc addPieces(collector: StructurePiecesCollector, position: Vector3[int32], rotation: Rotation, random: var RandomGenerator,
               isWarm: bool, largeProbability, clusterProbability: float32) =
  let isLarge = nextF32(random) <= largeProbability
  let baseIntegrity = if isLarge: 0.9'f32 else: 0.8'f32
  addPieceTo(collector, position, rotation, random, isWarm, isLarge, baseIntegrity)
  if isLarge and nextF32(random) <= clusterProbability:
    addClusterRuins(collector, random, rotation, position, isWarm)

proc oceanRuinPosition*(context: var StructureGeneratorContext, isWarm: bool): StructurePosition =
  ## `<OceanRuinGenerator as StructureGenerator>::get_structure_position`
  let startX = context.chunkX shl 4
  let startZ = context.chunkZ shl 4
  let position = vec3[int32](startX, 90, startZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let collector = newStructurePiecesCollector()
  addPieces(collector, position, rotation, context.random, isWarm, 0.3'f32, 0.7'f32)
  for i in 0 ..< collector.pieces.len:
    cast[OceanRuinPiece](collector.pieces[i]).seaLevel = context.seaLevel
  StructurePosition(startPos: blockPos(startX + 8, 64, startZ + 8), collector: collector)

proc calculateHeight(pos, corner: Vector3[int32], chunk: ProtoChunk): int32 =
  var newY = pos.y
  var minY = 512'i32
  let topY = newY - 1
  var area = 0'i32
  for x in min(pos.x, corner.x) .. max(pos.x, corner.x):
    for z in min(pos.z, corner.z) .. max(pos.z, corner.z):
      let floorY = getTopY(chunk, OceanFloorWg, x, z) - 1
      minY = min(minY, floorY)
      if floorY < topY - 2:
        inc area
  let width = abs(pos.x - corner.x)
  if topY - minY > 2 and area > width - 2:
    newY = minY + 1
  newY

proc placeBrushable(chunk: ProtoChunk, worldPos: Vector3[int32], state: BlockStateId, lootTable: string) =
  setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, state)
  var nbt = newCompound()
  putString(nbt, "id", "minecraft:brushable_block")
  putInt(nbt, "x", worldPos.x)
  putInt(nbt, "y", worldPos.y)
  putInt(nbt, "z", worldPos.z)
  putString(nbt, "LootTable", lootTable)
  var rng = legacy_rand.fromSeed(cast[uint64](hashBlockPos(worldPos.x, worldPos.y, worldPos.z)))
  putLong(nbt, "LootTableSeed", nextI64(rng))
  addBlockEntity(chunk, nbt)

proc placeOceanRuin(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[OceanRuinPiece](self)
  let t = p.templateData
  let height = getTopY(chunk, OceanFloorWg, p.templatePosition.x, p.templatePosition.z)
  var pos = vec3[int32](p.templatePosition.x, height, p.templatePosition.z)
  let cornerOffset = transformBlockPos(vec3[int32](t.size.x - 1, 0, t.size.z - 1), Mirror.None, p.rotation, vec3[int32](0, 0, 0))
  let corner = vec3[int32](cornerOffset.x + pos.x, cornerOffset.y + pos.y, cornerOffset.z + pos.z)
  pos.y = calculateHeight(pos, corner, chunk)
  p.templatePosition = pos
  p.piece.boundingBox = getBoundingBoxStatic(pos, p.rotation, vec3[int32](0, 0, 0), Mirror.None, t.size)
  let boxLimit = p.piece.boundingBox
  var suspiciousCount = 0'i32

  for bi in 0 ..< t.blocks.len:
    let paletteEntry = t.palette[int(t.blocks[bi].state)]
    if paletteEntry.name == "minecraft:structure_void" or paletteEntry.name == "structure_void":
      continue
    let relPos = transformBlockPos(t.blocks[bi].pos, Mirror.None, p.rotation, vec3[int32](0, 0, 0))
    let worldPos = vec3[int32](pos.x + relPos.x, pos.y + relPos.y, pos.z + relPos.z)
    if not containsPos(boxLimit, worldPos) or not containsPos(chunkBox, worldPos):
      continue

    if paletteEntry.name == "minecraft:structure_block":
      if t.blocks[bi].hasNbt:
        let mode = getString(t.blocks[bi].nbt, "mode")
        if isSome(mode) and get(mode) == "DATA":
          let metadataTag = getString(t.blocks[bi].nbt, "metadata")
          let metadata = if isSome(metadataTag): get(metadataTag) else: ""
          if metadata == "chest":
            let isWater = blockIdOf(getBlockState(chunk, worldPos)) == WaterBlock
            let chestState = stateWith("chest", [("facing", "north"), ("waterlogged", if isWater: "true" else: "false")])
            setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, chestState)
            var chestNbt = newCompound()
            putString(chestNbt, "id", "minecraft:chest")
            putInt(chestNbt, "x", worldPos.x)
            putInt(chestNbt, "y", worldPos.y)
            putInt(chestNbt, "z", worldPos.z)
            putString(chestNbt, "LootTable",
              if p.isLarge: "minecraft:chests/underwater_ruin_big" else: "minecraft:chests/underwater_ruin_small")
            var rng = legacy_rand.fromSeed(cast[uint64](hashBlockPos(worldPos.x, worldPos.y, worldPos.z)))
            putLong(chestNbt, "LootTableSeed", nextI64(rng))
            addBlockEntity(chunk, chestNbt)
          elif metadata == "drowned":
            var entityNbt = newCompound()
            putString(entityNbt, "id", "minecraft:drowned")
            putList(entityNbt, "Pos", @[nbtTag(float64(worldPos.x) + 0.5'f64), nbtTag(float64(worldPos.y)),
              nbtTag(float64(worldPos.z) + 0.5'f64)])
            putBool(entityNbt, "PersistenceRequired", true)
            addStructureEntity(chunk, entityNbt)
            setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z,
              if worldPos.y > p.seaLevel: AirState else: WaterState)
      continue

    if p.integrity < 0.999'f32 and nextF32(random) > p.integrity:
      continue
    if paletteEntry.name == "minecraft:air" or paletteEntry.name == "air":
      continue

    if p.isWarm and paletteEntry.name == "minecraft:sand" and suspiciousCount < 5 and nextF32(random) < 0.45'f32:
      inc suspiciousCount
      placeBrushable(chunk, worldPos, SuspiciousSand, "minecraft:archaeology/ocean_ruin_warm")
      continue
    elif not p.isWarm and paletteEntry.name == "minecraft:gravel" and suspiciousCount < 5 and nextF32(random) < 0.45'f32:
      inc suspiciousCount
      placeBrushable(chunk, worldPos, SuspiciousGravel, "minecraft:archaeology/ocean_ruin_cold")
      continue

    var (found, state) = resolve(paletteEntry, p.rotation, Mirror.None)
    if not found:
      continue
    if blockIdOf(getBlockState(chunk, worldPos)) == WaterBlock:
      state = resolveWaterlogged(paletteEntry, p.rotation, Mirror.None, state)
    setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, state)
    addPlacedBlockEntity(chunk, state, t.blocks[bi], worldPos)
