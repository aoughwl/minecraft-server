## Port of pumpkin-world/src/generation/structure/structures/ocean_ruin.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/ocean_ruin.rs - the pinned tree's piece is one template in a
## whole-height box. Starts match the vanilla save, 6 of 6; boxes, heights and clusters do not. ../ref/pumpkin has them, not ported.

{.feature: "lenientnils".}

import "../template/templatemod"
import structuresmod

const
  ColdRuins = ["underwater_ruin/brick_1", "underwater_ruin/brick_2", "underwater_ruin/brick_3", "underwater_ruin/brick_4",
    "underwater_ruin/brick_5", "underwater_ruin/brick_6", "underwater_ruin/brick_7", "underwater_ruin/brick_8",
    "underwater_ruin/cracked_1", "underwater_ruin/cracked_2", "underwater_ruin/cracked_3", "underwater_ruin/mossy_1",
    "underwater_ruin/mossy_2", "underwater_ruin/mossy_3"]
  WarmRuins = ["underwater_ruin/warm_1", "underwater_ruin/warm_2", "underwater_ruin/warm_3", "underwater_ruin/warm_4",
    "underwater_ruin/warm_5", "underwater_ruin/warm_6", "underwater_ruin/warm_7", "underwater_ruin/warm_8",
    "underwater_ruin/big_warm_4", "underwater_ruin/big_warm_5"]

type
  OceanRuinPiece = ref object of StructurePieceBase
    templateData: StructureTemplate
    rotation: Rotation

proc placeOceanRuin(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[OceanRuinPiece](self)
  let origin = p.piece.boundingBox.min
  let sampleY = getTopY(chunk, OceanFloorWg, origin.x, origin.z)
  placeTemplateIn(chunk, p.templateData, vec3[int32](origin.x, sampleY - 2, origin.z), (0'i32, 0'i32), p.rotation, true, true,
    chunkBox)

proc oceanRuinPosition*(context: var StructureGeneratorContext, isWarm: bool): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let poolLen = if isWarm: WarmRuins.len else: ColdRuins.len
  let templateIdx = int(nextBoundedI32(context.random, int32(poolLen)))
  let t = getTemplate(if isWarm: WarmRuins[templateIdx] else: ColdRuins[templateIdx])
  if t == nil:
    return nil
  let size = t.size
  let boundingBox = newBlockBox(chunkCenterX - size.x div 2, context.minY, chunkCenterZ - size.z div 2,
    chunkCenterX + size.x div 2, 256, chunkCenterZ + size.z div 2)
  let piece = OceanRuinPiece(piece: newStructurePiece(StructurePieceType.OceanTemple, boundingBox, 0), placeFn: placeOceanRuin,
    templateData: t, rotation: rotation)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
