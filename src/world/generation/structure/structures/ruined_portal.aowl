## Port of pumpkin-world/src/generation/structure/structures/ruined_portal.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/ruined_portal.rs - the pinned tree's piece takes a whole-height box
## and a flat template list. The start matches the vanilla save; the box does not. ../ref/pumpkin has the rest, not ported.

{.feature: "lenientnils".}

import ../../../../generated/structures
import "../template/templatemod"
import structuresmod

const Portals = ["ruined_portal/portal_1", "ruined_portal/portal_2", "ruined_portal/portal_3", "ruined_portal/portal_4",
  "ruined_portal/portal_5", "ruined_portal/portal_6", "ruined_portal/portal_7", "ruined_portal/portal_8",
  "ruined_portal/portal_9", "ruined_portal/portal_10", "ruined_portal/giant_portal_1", "ruined_portal/giant_portal_2",
  "ruined_portal/giant_portal_3"]

type
  RuinedPortalPiece = ref object of StructurePieceBase
    templateData: StructureTemplate
    rotation: Rotation
    variant: StructureKeys

proc placeRuinedPortal(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                       random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[RuinedPortalPiece](self)
  let origin = p.piece.boundingBox.min
  var heightMapType = WorldSurfaceWg
  var verticalOffset = -1'i32
  case p.variant
  of StructureKeys.RuinedPortalOcean:
    heightMapType = OceanFloorWg
    verticalOffset = -2
  of StructureKeys.RuinedPortalDesert:
    verticalOffset = -3
  of StructureKeys.RuinedPortalNether:
    verticalOffset = 0
  else:
    discard
  let sampleY =
    if p.variant == StructureKeys.RuinedPortalNether: 45'i32
    else: getTopY(chunk, heightMapType, origin.x, origin.z)
  placeTemplateIn(chunk, p.templateData, vec3[int32](origin.x, sampleY + verticalOffset, origin.z), (0'i32, 0'i32), p.rotation,
    true, false, chunkBox)

proc ruinedPortalPosition*(context: var StructureGeneratorContext, variant: StructureKeys): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let templateIdx = int(nextBoundedI32(context.random, int32(Portals.len)))
  let t = getTemplate(Portals[templateIdx])
  if t == nil:
    return nil
  let size = t.size
  let boundingBox = newBlockBox(chunkCenterX - size.x div 2, context.minY, chunkCenterZ - size.z div 2,
    chunkCenterX + size.x div 2, 256, chunkCenterZ + size.z div 2)
  let piece = RuinedPortalPiece(piece: newStructurePiece(StructurePieceType.RuinedPortal, boundingBox, 0),
    placeFn: placeRuinedPortal, templateData: t, rotation: rotation, variant: variant)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
