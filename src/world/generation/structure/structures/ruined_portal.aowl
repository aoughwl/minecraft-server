## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/ruined_portal.rs
##
## The pinned tree's piece took a whole-height box and a flat template list, so this one comes from the newer tree.
##
## `LavaSubmergedBlock` tests `is_solid_render`, which the pinned assets lack: it is derived (a full cube with light block 15) in
## src/world/blockstates.aowl and src/data/block_state.aowl, so the checked-in `state_flags` stay as the pinned tree has them.

{.feature: "lenientnils".}

import std/options
import ../../../../generated/structures
import "../template/templatemod"
import ../../../../util/legacy_rand
import structuresmod

const
  StructureLocationPortals* = ["ruined_portal/portal_1", "ruined_portal/portal_2", "ruined_portal/portal_3",
    "ruined_portal/portal_4", "ruined_portal/portal_5", "ruined_portal/portal_6", "ruined_portal/portal_7",
    "ruined_portal/portal_8", "ruined_portal/portal_9", "ruined_portal/portal_10"]
  StructureLocationGiantPortals* = ["ruined_portal/giant_portal_1", "ruined_portal/giant_portal_2", "ruined_portal/giant_portal_3"]
  NetherrackProbabilityByDistance = [1.0'f32, 1.0'f32, 1.0'f32, 1.0'f32, 1.0'f32, 1.0'f32, 1.0'f32, 0.9'f32, 0.9'f32,
    0.8'f32, 0.7'f32, 0.6'f32, 0.4'f32, 0.2'f32]

type
  VerticalPlacement* {.pure.} = enum
    OnLandSurface, PartlyBuried, OnOceanFloor, InMountain, Underground, InNether

  RuinedPortalSetup* = object
    placement*: VerticalPlacement
    airPocketProbability*: float32
    mossiness*: float32
    overgrown*: bool
    vines*: bool
    canBeCold*: bool
    replaceWithBlackstone*: bool
    weight*: float32

  RuinedPortalProperties* = object
    cold*: bool
    mossiness*: float32
    airPocket*: bool
    overgrown*: bool
    vines*: bool
    replaceWithBlackstone*: bool

  RuinedPortalPiece* = ref object of StructurePieceBase
    templateData*: StructureTemplate
    templateName*: string
    rotation*: Rotation
    mirror*: Mirror
    pivot*: Vector3[int32]
    processors*: seq[StructureProcessor]
    templatePosition*: Vector3[int32]
    verticalPlacement*: VerticalPlacement
    properties*: RuinedPortalProperties

let
  WaterBlock = blockIdNamed("water")
  LavaBlock = blockIdNamed("lava")
  AirBlock = blockIdNamed("air")
  ObsidianBlock = blockIdNamed("obsidian")
  BedrockBlock = blockIdNamed("bedrock")
  NetherrackBlock = blockIdNamed("netherrack")
  VineBlock = blockIdNamed("vine")
  GoldBlock = blockIdNamed("gold_block")
  StructureBlock = blockIdNamed("structure_block")
  AirState = blockState("air")
  MagmaState = blockState("magma_block")
  NetherrackState = blockState("netherrack")

proc setup(placement: VerticalPlacement, airPocketProbability, mossiness: float64, overgrown, vines, canBeCold,
           replaceWithBlackstone: bool, weight: float64): RuinedPortalSetup =
  RuinedPortalSetup(placement: placement, airPocketProbability: float32(airPocketProbability), mossiness: float32(mossiness),
    overgrown: overgrown, vines: vines, canBeCold: canBeCold, replaceWithBlackstone: replaceWithBlackstone, weight: float32(weight))

proc setupsForVariant*(variant: StructureKeys): seq[RuinedPortalSetup] =
  ## `RuinedPortalSetup::setups_for_variant`
  case variant
  of StructureKeys.RuinedPortalNether:
    @[setup(VerticalPlacement.InNether, 0.0, 0.0, false, false, false, true, 1.0)]
  of StructureKeys.RuinedPortalDesert:
    @[setup(VerticalPlacement.PartlyBuried, 0.0, 0.0, false, false, false, false, 1.0)]
  of StructureKeys.RuinedPortalJungle:
    @[setup(VerticalPlacement.OnLandSurface, 0.0, 0.8, true, true, false, false, 1.0)]
  of StructureKeys.RuinedPortalSwamp:
    @[setup(VerticalPlacement.OnOceanFloor, 0.0, 0.5, false, true, false, false, 1.0)]
  of StructureKeys.RuinedPortalOcean:
    @[setup(VerticalPlacement.OnOceanFloor, 0.0, 0.8, false, false, true, false, 1.0)]
  of StructureKeys.RuinedPortalMountain:
    @[setup(VerticalPlacement.InMountain, 1.0, 0.2, false, false, true, false, 0.5),
      setup(VerticalPlacement.OnLandSurface, 0.0, 0.2, false, false, true, false, 0.5)]
  else:
    @[setup(VerticalPlacement.Underground, 1.0, 0.2, false, false, true, false, 0.5),
      setup(VerticalPlacement.OnLandSurface, 0.0, 0.2, false, false, true, false, 0.5)]

proc sample(random: var RandomGenerator, limit: float32): bool =
  if limit == 0.0'f32:
    false
  elif abs(limit - 1.0'f32) < 1.1920929e-7'f32:
    true
  else:
    nextF32(random) < limit

proc getRandomWithinInterval(random: var RandomGenerator, minPreferred, maxV: int32): int32 =
  if minPreferred < maxV: nextInbetweenI32(random, minPreferred, maxV) else: maxV

proc isOpaque(state: BlockStateId, placement: VerticalPlacement): bool =
  if placement == VerticalPlacement.OnOceanFloor: blocksMovement(state) else: not isAir(state)

proc findSuitableY(random: var RandomGenerator, heightSampler: HeightSampler, verticalPlacement: VerticalPlacement,
                   airPocket: bool, surfaceYAtCenter, ySpan: int32, boundingBox: BlockBox, minChunkY: int32): int32 =
  let minY = minChunkY + 15
  var newY = 0'i32
  case verticalPlacement
  of VerticalPlacement.InNether:
    if airPocket:
      newY = nextInbetweenI32(random, 32, 100)
    elif nextF32(random) < 0.5'f32:
      newY = nextInbetweenI32(random, 27, 29)
    else:
      newY = nextInbetweenI32(random, 29, 100)
  of VerticalPlacement.InMountain:
    newY = getRandomWithinInterval(random, 70, surfaceYAtCenter - ySpan)
  of VerticalPlacement.Underground:
    newY = getRandomWithinInterval(random, minY, surfaceYAtCenter - ySpan)
  of VerticalPlacement.PartlyBuried:
    newY = surfaceYAtCenter - ySpan + nextInbetweenI32(random, 2, 8)
  else:
    newY = surfaceYAtCenter

  let bottomCorners = [(boundingBox.min.x, boundingBox.min.z), (boundingBox.max.x, boundingBox.min.z),
    (boundingBox.min.x, boundingBox.max.z), (boundingBox.max.x, boundingBox.max.z)]
  var projectedY = newY
  if heightSampler != nil:
    while projectedY > minY:
      var cornersOnSolidGround = 0'i32
      for (x, z) in bottomCorners:
        var state = 0'u32
        if sampleColumnBlock(heightSampler, x, z, projectedY, state) and isOpaque(state, verticalPlacement):
          inc cornersOnSolidGround
          if cornersOnSolidGround == 3:
            return projectedY
      dec projectedY
  projectedY

proc randomBlockRule(blockId: int, probability: float32, output: BlockStateId): ProcessorRule =
  ProcessorRule(input: RuleInput(kind: RuleInputKind.Block, blockId: blockId), probability: probability, outputState: output)

proc makeSettings(verticalPlacement: VerticalPlacement, properties: RuinedPortalProperties): seq[StructureProcessor] =
  ## The processors of `make_settings`. A rule at probability 1 is upstream's `BlockMatch`, which draws nothing.
  result = @[]
  result.add(StructureProcessor(kind: StructureProcessorKind.BlockIgnore,
    ignored: if properties.airPocket: @[StructureBlock] else: @[StructureBlock, AirBlock]))
  var rules = @[randomBlockRule(GoldBlock, 0.3'f32, AirState)]
  if verticalPlacement == VerticalPlacement.OnOceanFloor:
    rules.add(randomBlockRule(LavaBlock, 1.0'f32, MagmaState))
  elif properties.cold:
    rules.add(randomBlockRule(LavaBlock, 1.0'f32, NetherrackState))
  else:
    rules.add(randomBlockRule(LavaBlock, 0.2'f32, MagmaState))
  if not properties.cold:
    rules.add(randomBlockRule(NetherrackBlock, 0.07'f32, MagmaState))
  result.add(StructureProcessor(kind: StructureProcessorKind.Rules, rules: rules))
  result.add(StructureProcessor(kind: StructureProcessorKind.BlockAge, mossiness: properties.mossiness))
  result.add(StructureProcessor(kind: StructureProcessorKind.ProtectedBlocks, blocks: BlockTag.FeaturesCannotReplace))
  result.add(StructureProcessor(kind: StructureProcessorKind.LavaSubmerged))
  if properties.replaceWithBlackstone:
    result.add(StructureProcessor(kind: StructureProcessorKind.BlackstoneReplace))

proc placeRuinedPortal(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                       random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.}

proc newRuinedPortalPiece(t: StructureTemplate, templateName: string, templatePosition: Vector3[int32],
                          verticalPlacement: VerticalPlacement, properties: RuinedPortalProperties, rotation: Rotation,
                          mirror: Mirror, pivot: Vector3[int32]): RuinedPortalPiece =
  let boundingBox = getBoundingBoxStatic(templatePosition, rotation, pivot, mirror, t.size)
  RuinedPortalPiece(piece: newStructurePiece(StructurePieceType.RuinedPortal, boundingBox, 0), placeFn: placeRuinedPortal,
    templateData: t, templateName: templateName, rotation: rotation, mirror: mirror, pivot: pivot,
    processors: makeSettings(verticalPlacement, properties), templatePosition: templatePosition,
    verticalPlacement: verticalPlacement, properties: properties)

proc ruinedPortalPosition*(context: var StructureGeneratorContext, variant: StructureKeys): StructurePosition =
  ## `<RuinedPortalGenerator as StructureGenerator>::get_structure_position`
  let setups = setupsForVariant(variant)
  var chosenSetup = setups[0]
  if setups.len > 1:
    var total = 0.0'f32
    for i in 0 ..< setups.len:
      total += setups[i].weight
    var pick = nextF32(context.random)
    for i in 0 ..< setups.len:
      pick -= setups[i].weight / total
      if pick < 0.0'f32:
        chosenSetup = setups[i]
        break

  let airPocket = sample(context.random, chosenSetup.airPocketProbability)
  let templateName =
    if nextF32(context.random) < 0.05'f32:
      StructureLocationGiantPortals[int(nextBoundedI32(context.random, int32(StructureLocationGiantPortals.len)))]
    else:
      StructureLocationPortals[int(nextBoundedI32(context.random, int32(StructureLocationPortals.len)))]
  let t = getTemplate(templateName)
  if t == nil:
    return nil
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let mirror = if nextF32(context.random) < 0.5'f32: Mirror.None else: Mirror.FrontBack

  let pivot = vec3[int32](t.size.x div 2, 0, t.size.z div 2)
  let basePosition = vec3[int32](context.chunkX * 16, 0, context.chunkZ * 16)
  let boundingBox = getBoundingBoxStatic(basePosition, rotation, pivot, mirror, t.size)
  let center = getCenter(boundingBox)

  let surfaceY =
    if chosenSetup.placement == VerticalPlacement.OnOceanFloor:
      if context.heightSampler == nil: context.seaLevel else: estimateOceanFloorHeight(context.heightSampler, center.x, center.z)
    else:
      if context.heightSampler == nil: 64'i32 else: estimateHeight(context.heightSampler, center.x, center.z) - 1

  let ySpan = getBlockCountY(boundingBox)
  let projectedY = findSuitableY(context.random, context.heightSampler, chosenSetup.placement, airPocket, surfaceY, ySpan,
    boundingBox, context.minY)

  let origin = vec3[int32](basePosition.x, projectedY, basePosition.z)
  let properties = RuinedPortalProperties(cold: chosenSetup.canBeCold, mossiness: chosenSetup.mossiness, airPocket: airPocket,
    overgrown: chosenSetup.overgrown, vines: chosenSetup.vines, replaceWithBlackstone: chosenSetup.replaceWithBlackstone)
  let piece = newRuinedPortalPiece(t, templateName, origin, chosenSetup.placement, properties, rotation, mirror, pivot)
  singlePiecePosition(piece, origin.x, origin.y, origin.z)

proc placeBlocks(p: RuinedPortalPiece, chunk: ProtoChunk, chunkBox: BlockBox) =
  let t = p.templateData
  let placer = protoChunkPlacer(chunk)
  var contextRng = legacy_rand.fromSeed(cast[uint64](hashBlockPos(p.templatePosition.x, p.templatePosition.y, p.templatePosition.z)))
  for bi in 0 ..< t.blocks.len:
    let paletteEntry = t.palette[int(t.blocks[bi].state)]
    var (found, state) = resolve(paletteEntry, p.rotation, p.mirror)
    if not found:
      continue
    let localPos = transformBlockPos(t.blocks[bi].pos, p.mirror, p.rotation, p.pivot)
    let worldPos = vec3[int32](p.templatePosition.x + localPos.x, p.templatePosition.y + localPos.y, p.templatePosition.z + localPos.z)
    if not containsPos(chunkBox, worldPos):
      continue
    var keep = true
    for pi in 0 ..< p.processors.len:
      let (kept, processed) = processWithRng(p.processors[pi], placer, worldPos, state, contextRng)
      if not kept:
        keep = false
        break
      state = processed
    if not keep:
      continue
    # Upstream's waterlogged branch resolves the same entry to the same state before its processors ran, so a template
    # block already waterlogged keeps that state over water.
    if blockIdOf(getBlockState(chunk, worldPos)) == WaterBlock:
      for pi in 0 ..< paletteEntry.properties.len:
        if paletteEntry.properties[pi][0] == "waterlogged" and paletteEntry.properties[pi][1] == "true":
          state = resolve(paletteEntry, p.rotation, p.mirror)[1]
    setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, state)
    addPlacedBlockEntity(chunk, state, t.blocks[bi], worldPos)

proc placeNetherrackOrMagma(p: RuinedPortalPiece, random: var RandomGenerator, chunk: ProtoChunk, pos: Vector3[int32]) =
  if not p.properties.cold and nextF32(random) < 0.07'f32:
    setBlockState(chunk, pos.x, pos.y, pos.z, MagmaState)
  else:
    setBlockState(chunk, pos.x, pos.y, pos.z, NetherrackState)

proc addNetherrackDripColumn(p: RuinedPortalPiece, random: var RandomGenerator, chunk: ProtoChunk, startPos: Vector3[int32],
                             chunkBox: BlockBox) =
  var cur = startPos
  if containsPos(chunkBox, cur):
    placeNetherrackOrMagma(p, random, chunk, cur)
  var remaining = 8
  while remaining > 0 and nextF32(random) < 0.5'f32:
    cur.y -= 1
    dec remaining
    if containsPos(chunkBox, cur):
      placeNetherrackOrMagma(p, random, chunk, cur)

proc canBlockBeReplacedByNetherrackOrMagma(p: RuinedPortalPiece, chunk: ProtoChunk, pos: Vector3[int32]): bool =
  let blockId = blockIdOf(getBlockState(chunk, pos))
  blockId != AirBlock and blockId != ObsidianBlock and blockId != BedrockBlock and
    (p.verticalPlacement == VerticalPlacement.InNether or blockId != LavaBlock)

proc maybeAddLeavesAbove(random: var RandomGenerator, chunk: ProtoChunk, pos: Vector3[int32]) =
  if nextF32(random) < 0.5'f32 and blockIdOf(getBlockState(chunk, pos)) == NetherrackBlock:
    let above = vec3[int32](pos.x, pos.y + 1, pos.z)
    if blockIdOf(getBlockState(chunk, above)) == AirBlock:
      setBlockState(chunk, above.x, above.y, above.z, stateWith("jungle_leaves", [("persistent", "true")]))

proc maybeAddVines(random: var RandomGenerator, chunk: ProtoChunk, pos: Vector3[int32]) =
  let blockId = blockIdOf(getBlockState(chunk, pos))
  if blockId != AirBlock and blockId != VineBlock:
    let dirIdx = nextBoundedI32(random, 4)
    let (dx, dz, face) =
      case dirIdx
      of 0: (0'i32, -1'i32, "south")
      of 1: (0'i32, 1'i32, "north")
      of 2: (-1'i32, 0'i32, "east")
      else: (1'i32, 0'i32, "west")
    let neighborPos = vec3[int32](pos.x + dx, pos.y, pos.z + dz)
    if blockIdOf(getBlockState(chunk, neighborPos)) == AirBlock:
      setBlockState(chunk, neighborPos.x, neighborPos.y, neighborPos.z, stateWith("vine", [(face, "true")]))

proc spreadNetherrack(p: RuinedPortalPiece, random: var RandomGenerator, chunk: ProtoChunk, chunkBox: BlockBox) =
  let followGroundSurface = p.verticalPlacement == VerticalPlacement.OnLandSurface or
    p.verticalPlacement == VerticalPlacement.OnOceanFloor
  let bb = p.piece.boundingBox
  let centerX = midpointI32(bb.min.x, bb.max.x)
  let centerZ = midpointI32(bb.min.z, bb.max.z)
  let maxDistance = int32(NetherrackProbabilityByDistance.len)
  let xSpan = bb.max.x - bb.min.x + 1
  let zSpan = bb.max.z - bb.min.z + 1
  let averageWidth = midpointI32(xSpan, zSpan)
  let maxAdj = max(8 - averageWidth div 2, 1)
  let distanceAdjustment = nextBoundedI32(random, maxAdj)
  let heightmap = if p.verticalPlacement == VerticalPlacement.OnOceanFloor: OceanFloorWg else: WorldSurfaceWg
  for x in centerX - maxDistance .. centerX + maxDistance:
    for z in centerZ - maxDistance .. centerZ + maxDistance:
      let distance = abs(x - centerX) + abs(z - centerZ)
      let adjustedDistance = max(distance + distanceAdjustment, 0)
      if adjustedDistance < maxDistance:
        let prob = NetherrackProbabilityByDistance[int(adjustedDistance)]
        if nextF64(random) < float64(prob):
          let surfaceY = getTopY(chunk, heightmap, x, z) - 1
          let y = if followGroundSurface: surfaceY else: min(bb.min.y, surfaceY)
          let pos = vec3[int32](x, y, z)
          if abs(y - bb.min.y) <= 3 and containsPos(chunkBox, pos) and canBlockBeReplacedByNetherrackOrMagma(p, chunk, pos):
            placeNetherrackOrMagma(p, random, chunk, pos)
            if p.properties.overgrown:
              maybeAddLeavesAbove(random, chunk, pos)
            addNetherrackDripColumn(p, random, chunk, vec3[int32](pos.x, pos.y - 1, pos.z), chunkBox)

proc addNetherrackDripColumnsBelowPortal(p: RuinedPortalPiece, random: var RandomGenerator, chunk: ProtoChunk, chunkBox: BlockBox) =
  let bb = p.piece.boundingBox
  var x = bb.min.x + 1
  while x < bb.max.x:
    var z = bb.min.z + 1
    while z < bb.max.z:
      if blockIdOf(getBlockState(chunk, vec3[int32](x, bb.min.y, z))) == NetherrackBlock:
        addNetherrackDripColumn(p, random, chunk, vec3[int32](x, bb.min.y - 1, z), chunkBox)
      inc z
    inc x

proc placeRuinedPortal(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                       random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[RuinedPortalPiece](self)
  let boundingBox = getBoundingBoxStatic(p.templatePosition, p.rotation, p.pivot, p.mirror, p.templateData.size)
  let center = vec3[int32](midpointI32(boundingBox.min.x, boundingBox.max.x), midpointI32(boundingBox.min.y, boundingBox.max.y),
    midpointI32(boundingBox.min.z, boundingBox.max.z))
  if containsPos(chunkBox, center):
    var enlargedBox = chunkBox
    encompass(enlargedBox, boundingBox)
    placeBlocks(p, chunk, enlargedBox)
    spreadNetherrack(p, random, chunk, enlargedBox)
    addNetherrackDripColumnsBelowPortal(p, random, chunk, enlargedBox)
    if p.properties.vines or p.properties.overgrown:
      for x in p.piece.boundingBox.min.x .. p.piece.boundingBox.max.x:
        for y in p.piece.boundingBox.min.y .. p.piece.boundingBox.max.y:
          for z in p.piece.boundingBox.min.z .. p.piece.boundingBox.max.z:
            let pos = vec3[int32](x, y, z)
            if containsPos(enlargedBox, pos):
              if p.properties.vines:
                maybeAddVines(random, chunk, pos)
              if p.properties.overgrown:
                maybeAddLeavesAbove(random, chunk, pos)
