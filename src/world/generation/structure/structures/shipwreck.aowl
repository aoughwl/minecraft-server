## Port of pumpkin-world/src/generation/structure/structures/shipwreck.rs
##
## PARTIAL: pumpkin-world/src/generation/structure/structures/shipwreck.rs - the pinned tree's piece takes a whole-height box around
## the chunk centre. Starts match the vanilla save, 4 of 4; the boxes do not. ../ref/pumpkin has the rest, not ported.

{.feature: "lenientnils".}

import "../template/templatemod"
import structuresmod

const Templates = ["shipwreck/rightsideup_backhalf", "shipwreck/rightsideup_backhalf_degraded", "shipwreck/rightsideup_fronthalf",
  "shipwreck/rightsideup_fronthalf_degraded", "shipwreck/rightsideup_full", "shipwreck/rightsideup_full_degraded",
  "shipwreck/sideways_backhalf", "shipwreck/sideways_backhalf_degraded", "shipwreck/sideways_fronthalf",
  "shipwreck/sideways_fronthalf_degraded", "shipwreck/sideways_full", "shipwreck/sideways_full_degraded",
  "shipwreck/upsidedown_backhalf", "shipwreck/upsidedown_backhalf_degraded", "shipwreck/upsidedown_fronthalf",
  "shipwreck/upsidedown_fronthalf_degraded", "shipwreck/upsidedown_full", "shipwreck/upsidedown_full_degraded",
  "shipwreck/with_mast", "shipwreck/with_mast_degraded"]

type
  ShipwreckPiece = ref object of StructurePieceBase
    templateData: StructureTemplate
    rotation: Rotation
    isBeached: bool

proc placeShipwreck(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[ShipwreckPiece](self)
  let origin = p.piece.boundingBox.min
  let heightMapType = if p.isBeached: WorldSurfaceWg else: OceanFloorWg
  let sampleY = getTopY(chunk, heightMapType, origin.x, origin.z)
  let targetY = if p.isBeached: sampleY - 1 else: sampleY - 3
  placeTemplateIn(chunk, p.templateData, vec3[int32](origin.x, targetY, origin.z), (0'i32, 0'i32), p.rotation, true,
    not p.isBeached, chunkBox)

proc shipwreckPosition*(context: var StructureGeneratorContext, isBeached: bool): StructurePosition =
  let chunkCenterX = getCenterX(context.chunkX)
  let chunkCenterZ = getCenterZ(context.chunkZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let templateIdx = int(nextBoundedI32(context.random, int32(Templates.len)))
  let t = getTemplate(Templates[templateIdx])
  if t == nil:
    return nil
  let size = t.size
  let boundingBox = newBlockBox(chunkCenterX - size.x div 2, context.minY, chunkCenterZ - size.z div 2,
    chunkCenterX + size.x div 2, 256, chunkCenterZ + size.z div 2)
  let piece = ShipwreckPiece(piece: newStructurePiece(StructurePieceType.Shipwreck, boundingBox, 0), placeFn: placeShipwreck,
    templateData: t, rotation: rotation, isBeached: isBeached)
  singlePiecePosition(piece, chunkCenterX, 64, chunkCenterZ)
