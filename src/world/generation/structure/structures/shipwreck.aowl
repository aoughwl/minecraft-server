## Port of ../ref/pumpkin crates/pumpkin-world/src/generation/structure/structures/shipwreck.rs
##
## The pinned tree's piece took a whole-height box around the chunk centre, so this one comes from the newer tree. A ship
## small enough for one world generation region only learns its height when placed, as in vanilla: its box stays at y 90
## until then, and that is also what a save holds for a chunk nothing has been placed in.

{.feature: "lenientnils".}

import std/options
import "../template/templatemod"
import ../../../../util/legacy_rand
import structuresmod

const
  NumberOfBlocksAllowedInWorldGenRegion = 32'i32
  StructureLocationBeached* = ["shipwreck/with_mast", "shipwreck/sideways_full", "shipwreck/sideways_fronthalf",
    "shipwreck/sideways_backhalf", "shipwreck/rightsideup_full", "shipwreck/rightsideup_fronthalf",
    "shipwreck/rightsideup_backhalf", "shipwreck/with_mast_degraded", "shipwreck/rightsideup_full_degraded",
    "shipwreck/rightsideup_fronthalf_degraded", "shipwreck/rightsideup_backhalf_degraded"]
  StructureLocationOcean* = ["shipwreck/with_mast", "shipwreck/upsidedown_full", "shipwreck/upsidedown_fronthalf",
    "shipwreck/upsidedown_backhalf", "shipwreck/sideways_full", "shipwreck/sideways_fronthalf", "shipwreck/sideways_backhalf",
    "shipwreck/rightsideup_full", "shipwreck/rightsideup_fronthalf", "shipwreck/rightsideup_backhalf",
    "shipwreck/with_mast_degraded", "shipwreck/upsidedown_full_degraded", "shipwreck/upsidedown_fronthalf_degraded",
    "shipwreck/upsidedown_backhalf_degraded", "shipwreck/sideways_full_degraded", "shipwreck/sideways_fronthalf_degraded",
    "shipwreck/sideways_backhalf_degraded", "shipwreck/rightsideup_full_degraded", "shipwreck/rightsideup_fronthalf_degraded",
    "shipwreck/rightsideup_backhalf_degraded"]

let
  Pivot = vec3[int32](4, 0, 15)
  WaterBlock = blockIdNamed("water")

type
  ShipwreckPiece* = ref object of StructurePieceBase
    templateData: StructureTemplate
    rotation: Rotation
    templatePosition: Vector3[int32]
    isBeached: bool
    heightAdjusted: bool

proc placeShipwreck(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.}

proc newShipwreckPiece(t: StructureTemplate, position: Vector3[int32], rotation: Rotation, isBeached: bool): ShipwreckPiece =
  let boundingBox = getBoundingBoxStatic(position, rotation, Pivot, Mirror.None, t.size)
  ShipwreckPiece(piece: newStructurePiece(StructurePieceType.Shipwreck, boundingBox, 0), placeFn: placeShipwreck, templateData: t,
    rotation: rotation, templatePosition: position, isBeached: isBeached, heightAdjusted: false)

proc isTooBigToFitInWorldGenRegion(p: ShipwreckPiece): bool =
  p.templateData.size.x > NumberOfBlocksAllowedInWorldGenRegion or p.templateData.size.y > NumberOfBlocksAllowedInWorldGenRegion

proc calculateBeachedPosition(p: ShipwreckPiece, minY: int32, random: var RandomGenerator): int32 =
  minY - p.templateData.size.y div 2 - nextBoundedI32(random, 3)

proc adjustPositionHeight(p: ShipwreckPiece, newHeight: int32) =
  p.heightAdjusted = true
  p.templatePosition.y = newHeight
  p.piece.boundingBox = getBoundingBoxStatic(p.templatePosition, p.rotation, Pivot, Mirror.None, p.templateData.size)

proc shipwreckPosition*(context: var StructureGeneratorContext, isBeached: bool): StructurePosition =
  ## `<ShipwreckGenerator as StructureGenerator>::get_structure_position`
  let centerX = getCenterX(context.chunkX)
  let centerZ = getCenterZ(context.chunkZ)
  let centerY =
    if isBeached:
      if context.heightSampler == nil: 64'i32 else: estimateHeight(context.heightSampler, centerX, centerZ)
    else:
      if context.heightSampler == nil: context.seaLevel else: estimateOceanFloorHeight(context.heightSampler, centerX, centerZ)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(context.random, 4)))
  let position = vec3[int32](startBlockX(context.chunkX), 90, startBlockZ(context.chunkZ))
  let templateName =
    if isBeached: StructureLocationBeached[int(nextBoundedI32(context.random, int32(StructureLocationBeached.len)))]
    else: StructureLocationOcean[int(nextBoundedI32(context.random, int32(StructureLocationOcean.len)))]
  let t = getTemplate(templateName)
  if t == nil:
    return nil
  let piece = newShipwreckPiece(t, position, rotation, isBeached)
  if isTooBigToFitInWorldGenRegion(piece):
    let bb = piece.piece.boundingBox
    var height = 0'i32
    if isBeached:
      var minY = 64'i32
      if context.heightSampler != nil:
        let c0 = estimateHeight(context.heightSampler, bb.min.x, bb.min.z)
        let c1 = estimateHeight(context.heightSampler, bb.min.x, bb.max.z)
        let c2 = estimateHeight(context.heightSampler, bb.max.x, bb.min.z)
        let c3 = estimateHeight(context.heightSampler, bb.max.x, bb.max.z)
        minY = min(min(min(c0, c1), c2), c3)
      height = calculateBeachedPosition(piece, minY, context.random)
    elif context.heightSampler != nil:
      let c0 = estimateHeight(context.heightSampler, bb.min.x, bb.min.z)
      let c1 = estimateHeight(context.heightSampler, bb.min.x, bb.max.z)
      let c2 = estimateHeight(context.heightSampler, bb.max.x, bb.min.z)
      let c3 = estimateHeight(context.heightSampler, bb.max.x, bb.max.z)
      height = (c0 + c1 + c2 + c3) div 4
    else:
      height = context.seaLevel
    adjustPositionHeight(piece, height)
  singlePiecePosition(piece, centerX, centerY, centerZ)

proc handleDataMarker(markerId: string, position: Vector3[int32], chunk: ProtoChunk, chunkBox: BlockBox) =
  var lootTable = ""
  case markerId
  of "map_chest": lootTable = "minecraft:chests/shipwreck_map"
  of "treasure_chest": lootTable = "minecraft:chests/shipwreck_treasure"
  of "supply_chest": lootTable = "minecraft:chests/shipwreck_supply"
  else: return
  let chestPos = vec3[int32](position.x, position.y - 1, position.z)
  if not containsPos(chunkBox, chestPos):
    return
  var rng = legacy_rand.fromSeed(cast[uint64](hashBlockPos(chestPos.x, chestPos.y, chestPos.z)))
  let lootSeed = nextI64(rng)
  for i in 0 ..< chunk.pendingBlockEntities.len:
    let x = getInt(chunk.pendingBlockEntities[i], "x")
    let y = getInt(chunk.pendingBlockEntities[i], "y")
    let z = getInt(chunk.pendingBlockEntities[i], "z")
    if isSome(x) and isSome(y) and isSome(z) and get(x) == chestPos.x and get(y) == chestPos.y and get(z) == chestPos.z:
      putString(chunk.pendingBlockEntities[i], "LootTable", lootTable)
      putLong(chunk.pendingBlockEntities[i], "LootTableSeed", lootSeed)
      return
  var chestNbt = newCompound()
  putString(chestNbt, "id", "minecraft:chest")
  putInt(chestNbt, "x", chestPos.x)
  putInt(chestNbt, "y", chestPos.y)
  putInt(chestNbt, "z", chestPos.z)
  putString(chestNbt, "LootTable", lootTable)
  putLong(chestNbt, "LootTableSeed", lootSeed)
  addBlockEntity(chunk, chestNbt)

proc placeShipwreck(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                    random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[ShipwreckPiece](self)
  let t = p.templateData
  if not p.heightAdjusted and not isTooBigToFitInWorldGenRegion(p):
    let heightmapType = if p.isBeached: WorldSurfaceWg else: OceanFloorWg
    let baseSize = t.size.x * t.size.z
    var mean = 0'i32
    var minY = int32.high
    if baseSize == 0:
      mean = getTopY(chunk, heightmapType, p.templatePosition.x, p.templatePosition.z)
      minY = mean
    else:
      var total = 0'i32
      var x = p.templatePosition.x
      while x < p.templatePosition.x + t.size.x:
        var z = p.templatePosition.z
        while z < p.templatePosition.z + t.size.z:
          let h = getTopY(chunk, heightmapType, x, z)
          total += h
          minY = min(minY, h)
          inc z
        inc x
      mean = total div baseSize
    let targetY = if p.isBeached: calculateBeachedPosition(p, minY, random) else: mean
    adjustPositionHeight(p, targetY)

  let boxLimit = p.piece.boundingBox
  for bi in 0 ..< t.blocks.len:
    let paletteEntry = t.palette[int(t.blocks[bi].state)]
    if paletteEntry.name == "minecraft:structure_block" or paletteEntry.name == "minecraft:air" or
        paletteEntry.name == "minecraft:structure_void" or paletteEntry.name == "structure_void":
      continue
    let relPos = transformBlockPos(t.blocks[bi].pos, Mirror.None, p.rotation, Pivot)
    let worldPos = vec3[int32](p.templatePosition.x + relPos.x, p.templatePosition.y + relPos.y, p.templatePosition.z + relPos.z)
    if not containsPos(boxLimit, worldPos) or not containsPos(chunkBox, worldPos):
      continue
    var (found, state) = resolve(paletteEntry, p.rotation, Mirror.None)
    if not found:
      continue
    if blockIdOf(getBlockState(chunk, worldPos)) == WaterBlock:
      state = resolveWaterlogged(paletteEntry, p.rotation, Mirror.None, state)
    setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, state)
    addPlacedBlockEntity(chunk, state, t.blocks[bi], worldPos)

  for bi in 0 ..< t.blocks.len:
    if t.palette[int(t.blocks[bi].state)].name == "minecraft:structure_block" and t.blocks[bi].hasNbt:
      let mode = getString(t.blocks[bi].nbt, "mode")
      if isSome(mode) and get(mode) == "DATA":
        let metadata = getString(t.blocks[bi].nbt, "metadata")
        let relPos = transformBlockPos(t.blocks[bi].pos, Mirror.None, p.rotation, Pivot)
        let worldPos = vec3[int32](p.templatePosition.x + relPos.x, p.templatePosition.y + relPos.y, p.templatePosition.z + relPos.z)
        handleDataMarker(if isSome(metadata): get(metadata) else: "", worldPos, chunk, chunkBox)
