## Port of pumpkin-world/src/generation/structure/structures/stronghold/chest_corridor.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  ChestCorridorPiece* = ref object of StrongholdPiece
    chestGenerated*: bool

proc fillChestCorridorPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  fillForwardOpening(self, ctx, 1, 1, false, StrongholdPieceType.Corridor)

proc placeChestCorridorPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[ChestCorridorPiece](self)
  let p = s.piece
  let bb = chunkBox
  fillOutlineRandom(p, 0, 0, 0, 4, 4, 6, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 1, 0)
  generateEntrance(s, chunk, bb, EntranceType.Opening, 1, 1, 6)
  let stoneBricks = blockState("stone_bricks")
  fillWithOutline(p, chunk, bb, false, 3, 1, 2, 3, 1, 4, stoneBricks, stoneBricks)
  let slab = blockState("stone_brick_slab")
  addBlock(p, chunk, slab, 3, 1, 1, bb)
  addBlock(p, chunk, slab, 3, 1, 5, bb)
  addBlock(p, chunk, slab, 3, 2, 2, bb)
  addBlock(p, chunk, slab, 3, 2, 4, bb)
  for i in int32(2) .. int32(4):
    addBlock(p, chunk, slab, 2, 1, i, bb)

proc createChestCorridorPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, 7, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = ChestCorridorPiece(piece: newStructurePiece(StructurePieceType.StrongholdChestCorridor, bbox, chainLength), placeFn: placeChestCorridorPiece, fillFn: fillChestCorridorPiece, chestGenerated: false)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  asBase(r)
