## Port of pumpkin-world/src/generation/structure/structures/stronghold/corridor.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  CorridorPiece* = ref object of StrongholdPiece
    leftExit*, rightExit*: bool

  SmallCorridorPiece* = ref object of StrongholdPiece
    length*: int32

proc fillCorridorPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  let s = cast[CorridorPiece](self)
  fillForwardOpening(self, ctx, 1, 1, false, StrongholdPieceType.Corridor)
  if s.leftExit:
    fillNwOpening(self, ctx, 1, 2)
  if s.rightExit:
    fillSeOpening(self, ctx, 1, 2)

proc placeCorridorPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[CorridorPiece](self)
  let p = s.piece
  let bb = chunkBox
  let air = blockState("air")
  fillOutlineRandom(p, 0, 0, 0, 4, 4, 6, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 1, 0)
  generateEntrance(s, chunk, bb, EntranceType.Opening, 1, 1, 6)
  if s.leftExit:
    fillWithOutline(p, chunk, bb, false, 0, 1, 2, 0, 3, 4, air, air)
  if s.rightExit:
    fillWithOutline(p, chunk, bb, false, 4, 1, 2, 4, 3, 4, air, air)

proc placeSmallCorridorPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[SmallCorridorPiece](self)
  let p = s.piece
  let bb = chunkBox
  let stone = blockState("stone_bricks")
  let caveAir = blockState("cave_air")
  for i in int32(0) ..< int32(s.length):
    addBlock(p, chunk, stone, 0, 0, i, bb)
    addBlock(p, chunk, stone, 1, 0, i, bb)
    addBlock(p, chunk, stone, 2, 0, i, bb)
    addBlock(p, chunk, stone, 3, 0, i, bb)
    addBlock(p, chunk, stone, 4, 0, i, bb)
    for j in int32(1) .. int32(3):
      addBlock(p, chunk, stone, 0, j, i, bb)
      addBlock(p, chunk, caveAir, 1, j, i, bb)
      addBlock(p, chunk, caveAir, 2, j, i, bb)
      addBlock(p, chunk, caveAir, 3, j, i, bb)
      addBlock(p, chunk, stone, 4, j, i, bb)
    addBlock(p, chunk, stone, 0, 4, i, bb)
    addBlock(p, chunk, stone, 1, 4, i, bb)
    addBlock(p, chunk, stone, 2, 4, i, bb)
    addBlock(p, chunk, stone, 3, 4, i, bb)
    addBlock(p, chunk, stone, 4, 4, i, bb)

proc createCorridorPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, 7, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = CorridorPiece(piece: newStructurePiece(StructurePieceType.StrongholdCorridor, bbox, chainLength), placeFn: placeCorridorPiece, fillFn: fillCorridorPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  r.leftExit = nextBoundedI32(ctx.random, 2) == 0
  r.rightExit = nextBoundedI32(ctx.random, 2) == 0
  asBase(r)

proc newSmallCorridorPiece*(chainLength: uint32, bbox: BlockBox, orientation: BlockDirection): StrongholdPiece =
  ## `SmallCorridorPiece::new`
  let length = if orientation == North or orientation == South: bbox.max.z - bbox.min.z + 1 else: bbox.max.x - bbox.min.x + 1
  let r = SmallCorridorPiece(piece: newStructurePiece(StructurePieceType.StrongholdSmallCorridor, bbox, chainLength), placeFn: placeSmallCorridorPiece, length: length)
  setFacing(r.piece, orientation)
  asBase(r)

proc smallCorridorCreateBox*(holder: StructurePiecesCollector, x, y, z: int32, orientation: BlockDirection, found: var BlockBox): bool =
  ## `SmallCorridorPiece::create_box`: false for `None`.
  var blockBox = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, 4, orientation)
  let intersecting = getIntersecting(holder, blockBox)
  if intersecting == nil:
    return false
  if intersecting.piece.boundingBox.min.y == blockBox.min.y:
    var j = 2'i32
    while j >= 1:
      blockBox = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, j, orientation)
      if not intersects(intersecting.piece.boundingBox, blockBox):
        found = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, j + 1, orientation)
        return true
      dec j
  false
