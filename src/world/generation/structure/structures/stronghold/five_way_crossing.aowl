## Port of pumpkin-world/src/generation/structure/structures/stronghold/five_way_crossing.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  FiveWayCrossingPiece* = ref object of StrongholdPiece
    lowerLeftExists*, upperLeftExists*, lowerRightExists*, upperRightExists*: bool

proc fillFiveWayCrossingPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  let s = cast[FiveWayCrossingPiece](self)
  var i = 3'i32
  var j = 5'i32
  let facing = if self.piece.hasFacing: self.piece.facing else: North
  if facing == West or facing == North:
    i = 8 - i
    j = 8 - j
  fillForwardOpening(self, ctx, 5, 1, false, StrongholdPieceType.Corridor)
  if s.lowerLeftExists:
    fillNwOpening(self, ctx, i, 1)
  if s.upperLeftExists:
    fillNwOpening(self, ctx, j, 7)
  if s.lowerRightExists:
    fillSeOpening(self, ctx, i, 1)
  if s.upperRightExists:
    fillSeOpening(self, ctx, j, 7)

proc placeFiveWayCrossingPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[FiveWayCrossingPiece](self)
  let p = s.piece
  let bb = chunkBox
  let air = blockState("air")
  fillOutlineRandom(p, 0, 0, 0, 9, 8, 10, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 4, 3, 0)
  if s.lowerLeftExists:
    fillWithOutline(p, chunk, bb, false, 0, 3, 1, 0, 5, 3, air, air)
  if s.lowerRightExists:
    fillWithOutline(p, chunk, bb, false, 9, 3, 1, 9, 5, 3, air, air)
  if s.upperLeftExists:
    fillWithOutline(p, chunk, bb, false, 0, 5, 7, 0, 7, 9, air, air)
  if s.upperRightExists:
    fillWithOutline(p, chunk, bb, false, 9, 5, 7, 9, 7, 9, air, air)
  fillWithOutline(p, chunk, bb, false, 5, 1, 10, 7, 3, 10, air, air)
  fillOutlineRandom(p, 1, 2, 1, 8, 2, 6, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 1, 5, 4, 4, 9, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 8, 1, 5, 8, 4, 9, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 1, 4, 7, 3, 4, 9, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 1, 3, 5, 3, 3, 6, stoneBrickRandomizer, chunk, false, random, bb)
  let slab = blockState("smooth_stone_slab")
  fillWithOutline(p, chunk, bb, false, 1, 3, 4, 3, 3, 4, slab, slab)
  fillWithOutline(p, chunk, bb, false, 1, 4, 6, 3, 4, 6, slab, slab)
  fillOutlineRandom(p, 5, 1, 7, 7, 1, 8, stoneBrickRandomizer, chunk, false, random, bb)
  fillWithOutline(p, chunk, bb, false, 5, 1, 9, 7, 1, 9, slab, slab)
  fillWithOutline(p, chunk, bb, false, 5, 2, 7, 7, 2, 7, slab, slab)
  fillWithOutline(p, chunk, bb, false, 4, 5, 7, 4, 5, 9, slab, slab)
  fillWithOutline(p, chunk, bb, false, 8, 5, 7, 8, 5, 9, slab, slab)
  let doubleSlab = stateWith("smooth_stone_slab", [("type", "double")])
  fillWithOutline(p, chunk, bb, false, 5, 5, 7, 7, 5, 9, doubleSlab, doubleSlab)

proc createFiveWayCrossingPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -4, -3, 0, 10, 9, 11, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = FiveWayCrossingPiece(piece: newStructurePiece(StructurePieceType.StrongholdFiveWayCrossing, bbox, chainLength), placeFn: placeFiveWayCrossingPiece, fillFn: fillFiveWayCrossingPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  r.lowerLeftExists = nextBool(ctx.random)
  r.upperLeftExists = nextBool(ctx.random)
  r.lowerRightExists = nextBool(ctx.random)
  r.upperRightExists = nextBoundedI32(ctx.random, 3) > 0
  asBase(r)
