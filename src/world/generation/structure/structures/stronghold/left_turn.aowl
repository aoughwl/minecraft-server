## Port of pumpkin-world/src/generation/structure/structures/stronghold/left_turn.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  LeftTurnPiece* = ref object of StrongholdPiece

proc fillLeftTurnPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  let facing = if self.piece.hasFacing: self.piece.facing else: North
  if facing == North or facing == East:
    fillNwOpening(self, ctx, 1, 1)
  else:
    fillSeOpening(self, ctx, 1, 1)

proc placeLeftTurnPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[LeftTurnPiece](self)
  let p = s.piece
  let bb = chunkBox
  let air = blockState("air")
  fillOutlineRandom(p, 0, 0, 0, 4, 4, 4, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 1, 0)
  let direction = facingOrNorth(p)
  if direction == North  or  direction == East:
    fillWithOutline(p, chunk, bb, false, 0, 1, 1, 0, 3, 3, air, air)
  else:
    fillWithOutline(p, chunk, bb, false, 4, 1, 1, 4, 3, 3, air, air)

proc createLeftTurnPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -1, 0, 5, 5, 5, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = LeftTurnPiece(piece: newStructurePiece(StructurePieceType.StrongholdLeftTurn, bbox, chainLength), placeFn: placeLeftTurnPiece, fillFn: fillLeftTurnPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  asBase(r)
