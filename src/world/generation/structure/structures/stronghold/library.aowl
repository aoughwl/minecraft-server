## Port of pumpkin-world/src/generation/structure/structures/stronghold/library.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  LibraryPiece* = ref object of StrongholdPiece
    tall*: bool

proc placeLibraryPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[LibraryPiece](self)
  let p = s.piece
  let bb = chunkBox
  let maxY = if s.tall: 10'i32 else: 5'i32
  fillOutlineRandom(p, 0, 0, 0, 13, maxY, 14, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 4, 1, 0)
  fillWithOutlineUnderSeaLevel(p, chunk, bb, random, 0.07'f32, 2, 1, 1, 11, 4, 13, blockState("cobweb"), blockState("cobweb"), false, false)
  let planks = blockState("oak_planks")
  let books = blockState("bookshelf")
  for l in int32(1) .. int32(13):
    if (l - 1) mod 4 == 0:
      fillWithOutline(p, chunk, bb, false, 1, 1, l, 1, 4, l, planks, planks)
      fillWithOutline(p, chunk, bb, false, 12, 1, l, 12, 4, l, planks, planks)
      if s.tall:
        fillWithOutline(p, chunk, bb, false, 1, 6, l, 1, 9, l, planks, planks)
        fillWithOutline(p, chunk, bb, false, 12, 6, l, 12, 9, l, planks, planks)
    else:
      fillWithOutline(p, chunk, bb, false, 1, 1, l, 1, 4, l, books, books)
      fillWithOutline(p, chunk, bb, false, 12, 1, l, 12, 4, l, books, books)
      if s.tall:
        fillWithOutline(p, chunk, bb, false, 1, 6, l, 1, 9, l, books, books)
        fillWithOutline(p, chunk, bb, false, 12, 6, l, 12, 9, l, books, books)
  for l in stepRange(int32(3), int32(12 - 1), int32(2)):
    fillWithOutline(p, chunk, bb, false, 3, 1, l, 4, 3, l, books, books)
    fillWithOutline(p, chunk, bb, false, 6, 1, l, 7, 3, l, books, books)
    fillWithOutline(p, chunk, bb, false, 9, 1, l, 10, 3, l, books, books)
  if s.tall:
    fillWithOutline(p, chunk, bb, false, 1, 5, 1, 3, 5, 13, planks, planks)
    fillWithOutline(p, chunk, bb, false, 10, 5, 1, 12, 5, 13, planks, planks)
    fillWithOutline(p, chunk, bb, false, 4, 5, 1, 9, 5, 2, planks, planks)
    fillWithOutline(p, chunk, bb, false, 4, 5, 12, 9, 5, 13, planks, planks)
    addBlock(p, chunk, planks, 9, 5, 11, bb)
    addBlock(p, chunk, planks, 8, 5, 11, bb)
    addBlock(p, chunk, planks, 9, 5, 10, bb)
    let ladder = stateWith("ladder", [("facing", "south")])
    for y in int32(1) .. int32(7):
      addBlock(p, chunk, ladder, 10, y, 13, bb)
    let t = blockState("torch")
    addBlock(p, chunk, t, 5, 8, 7, bb)
    addBlock(p, chunk, t, 8, 8, 7, bb)
    addBlock(p, chunk, t, 6, 8, 6, bb)
    addBlock(p, chunk, t, 6, 8, 8, bb)

proc createLibraryPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  var bbox = rotated(BlockBox, x, y, z, -4, -1, 0, 14, 11, 15, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    bbox = rotated(BlockBox, x, y, z, -4, -1, 0, 14, 6, 15, orientation)
    if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
      return nil
  let r = LibraryPiece(piece: newStructurePiece(StructurePieceType.StrongholdLibrary, bbox, chainLength), placeFn: placeLibraryPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  r.tall = getBlockCountY(bbox) > 6
  asBase(r)
