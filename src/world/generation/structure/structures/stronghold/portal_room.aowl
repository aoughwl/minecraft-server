## Port of pumpkin-world/src/generation/structure/structures/stronghold/portal_room.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  PortalRoomPiece* = ref object of StrongholdPiece
    spawnerPlaced*: bool

proc withEye(facing: string, hasEye: bool): BlockStateId =
  stateWith("end_portal_frame", [("facing", facing), ("eye", if hasEye: "true" else: "false")])

proc fillPortalRoomPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  ctx.hasPortalRoom = true

proc placePortalRoomPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[PortalRoomPiece](self)
  let p = s.piece
  let bb = chunkBox
  fillOutlineRandom(p, 0, 0, 0, 10, 7, 15, stoneBrickRandomizer, chunk, false, random, bb)
  generateEntrance(s, chunk, bb, EntranceType.Grates, 4, 1, 0)
  fillOutlineRandom(p, 1, 6, 1, 1, 6, 14, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 9, 6, 1, 9, 6, 14, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 2, 6, 1, 8, 6, 2, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 2, 6, 14, 8, 6, 14, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 1, 1, 1, 2, 1, 4, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 8, 1, 1, 9, 1, 4, stoneBrickRandomizer, chunk, false, random, bb)
  let lava = blockState("lava")
  fillWithOutline(p, chunk, bb, false, 1, 1, 1, 1, 1, 3, lava, lava)
  fillWithOutline(p, chunk, bb, false, 9, 1, 1, 9, 1, 3, lava, lava)
  fillOutlineRandom(p, 3, 1, 8, 7, 1, 12, stoneBrickRandomizer, chunk, false, random, bb)
  fillWithOutline(p, chunk, bb, false, 4, 1, 9, 6, 1, 11, lava, lava)
  let barNs = stateWith("iron_bars", [("north", "true"), ("south", "true")])
  let barWe = stateWith("iron_bars", [("north", "false"), ("south", "false"), ("west", "true"), ("east", "true")])
  for j in stepRange(int32(3), int32(14 - 1), int32(2)):
    fillWithOutline(p, chunk, bb, false, 0, 3, j, 0, 4, j, barNs, barNs)
    fillWithOutline(p, chunk, bb, false, 10, 3, j, 10, 4, j, barNs, barNs)
  for j in stepRange(int32(2), int32(9 - 1), int32(2)):
    fillWithOutline(p, chunk, bb, false, j, 3, 15, j, 4, 15, barWe, barWe)
  fillOutlineRandom(p, 4, 1, 5, 6, 1, 7, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 2, 6, 6, 2, 7, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 3, 7, 6, 3, 7, stoneBrickRandomizer, chunk, false, random, bb)
  let stairsN = stateWith("stone_brick_stairs", [("facing", "north")])
  for k in int32(4) .. int32(6):
    addBlock(p, chunk, stairsN, k, 1, 4, bb)
    addBlock(p, chunk, stairsN, k, 2, 5, bb)
    addBlock(p, chunk, stairsN, k, 3, 6, bb)
  var eyes: array[12, bool]
  for i in 0 ..< 12:
    eyes[i] = nextF32(random) > 0.9'f32
  var allEyes = true
  for i in 0 ..< 12:
    if not eyes[i]:
      allEyes = false
  addBlock(p, chunk, withEye("north", eyes[0]), 4, 3, 8, bb)
  addBlock(p, chunk, withEye("north", eyes[1]), 5, 3, 8, bb)
  addBlock(p, chunk, withEye("north", eyes[2]), 6, 3, 8, bb)
  addBlock(p, chunk, withEye("south", eyes[3]), 4, 3, 12, bb)
  addBlock(p, chunk, withEye("south", eyes[4]), 5, 3, 12, bb)
  addBlock(p, chunk, withEye("south", eyes[5]), 6, 3, 12, bb)
  addBlock(p, chunk, withEye("east", eyes[6]), 3, 3, 9, bb)
  addBlock(p, chunk, withEye("east", eyes[7]), 3, 3, 10, bb)
  addBlock(p, chunk, withEye("east", eyes[8]), 3, 3, 11, bb)
  addBlock(p, chunk, withEye("west", eyes[9]), 7, 3, 9, bb)
  addBlock(p, chunk, withEye("west", eyes[10]), 7, 3, 10, bb)
  addBlock(p, chunk, withEye("west", eyes[11]), 7, 3, 11, bb)
  if allEyes:
    let portal = blockState("end_portal")
    fillWithOutline(p, chunk, bb, false, 4, 3, 9, 6, 3, 11, portal, portal)
  if not s.spawnerPlaced:
    let pos = offsetPos(p, 5, 3, 6)
    if containsPos(bb, pos):
      s.spawnerPlaced = true
      let spawner = blockState("spawner")
      addBlock(p, chunk, spawner, 5, 3, 6, bb)
      var entityNbt = newCompound()
      putString(entityNbt, "id", "minecraft:mob_spawner")
      putInt(entityNbt, "x", pos.x)
      putInt(entityNbt, "y", pos.y)
      putInt(entityNbt, "z", pos.z)
      var spawnEntry = newCompound()
      var entityNbtInner = newCompound()
      putString(entityNbtInner, "id", "minecraft:silverfish")
      putCompound(spawnEntry, "entity", entityNbtInner)
      putCompound(entityNbt, "SpawnData", spawnEntry)
      addBlockEntity(chunk, entityNbt)

proc createPortalRoomPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -4, -1, 0, 11, 8, 16, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = PortalRoomPiece(piece: newStructurePiece(StructurePieceType.StrongholdPortalRoom, bbox, chainLength), placeFn: placePortalRoomPiece, fillFn: fillPortalRoomPiece, spawnerPlaced: false)
  setFacing(r.piece, orientation)
  asBase(r)
