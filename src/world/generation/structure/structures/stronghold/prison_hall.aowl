## Port of pumpkin-world/src/generation/structure/structures/stronghold/prison_hall.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  PrisonHallPiece* = ref object of StrongholdPiece

proc fillPrisonHallPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  fillForwardOpening(self, ctx, 1, 1, false, StrongholdPieceType.Corridor)

proc placePrisonHallPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[PrisonHallPiece](self)
  let p = s.piece
  let bb = chunkBox
  let air = blockState("air")
  fillOutlineRandom(p, 0, 0, 0, 8, 4, 10, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 1, 0)
  fillWithOutline(p, chunk, bb, false, 1, 1, 10, 3, 3, 10, air, air)
  fillOutlineRandom(p, 4, 1, 1, 4, 3, 1, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 1, 3, 4, 3, 3, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 1, 7, 4, 3, 7, stoneBrickRandomizer, chunk, false, random, bb)
  fillOutlineRandom(p, 4, 1, 9, 4, 3, 9, stoneBrickRandomizer, chunk, false, random, bb)
  let barNs = stateWith("iron_bars", [("north", "true"), ("south", "true")])
  let barNse = stateWith("iron_bars", [("north", "true"), ("south", "true"), ("east", "true")])
  let barWe = stateWith("iron_bars", [("east", "true"), ("north", "false"), ("south", "false"), ("west", "true")])
  for i in int32(1) .. int32(3):
    addBlock(p, chunk, barNs, 4, i, 4, bb)
    addBlock(p, chunk, barNse, 4, i, 5, bb)
    addBlock(p, chunk, barNs, 4, i, 6, bb)
    addBlock(p, chunk, barWe, 5, i, 5, bb)
    addBlock(p, chunk, barWe, 6, i, 5, bb)
    addBlock(p, chunk, barWe, 7, i, 5, bb)
  addBlock(p, chunk, barNs, 4, 3, 2, bb)
  addBlock(p, chunk, barNs, 4, 3, 8, bb)

proc createPrisonHallPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -1, 0, 9, 5, 11, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = PrisonHallPiece(piece: newStructurePiece(StructurePieceType.StrongholdPrisonHall, bbox, chainLength), placeFn: placePrisonHallPiece, fillFn: fillPrisonHallPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  asBase(r)
