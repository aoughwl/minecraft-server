## Port of pumpkin-world/src/generation/structure/structures/stronghold/spiral_staircase.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  SpiralStaircasePiece* = ref object of StrongholdPiece
    isStructureStart*: bool

proc fillSpiralStaircasePiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  let s = cast[SpiralStaircasePiece](self)
  fillForwardOpening(self, ctx, 1, 1, s.isStructureStart, StrongholdPieceType.FiveWayCrossing)

proc placeSpiralStaircasePiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[SpiralStaircasePiece](self)
  let p = s.piece
  let bb = chunkBox
  fillOutlineRandom(p, 0, 0, 0, 4, 10, 4, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 7, 0)
  generateEntrance(s, chunk, bb, EntranceType.Opening, 1, 1, 4)
  let stone = blockState("stone_bricks")
  let slab = blockState("smooth_stone_slab")
  addBlock(p, chunk, stone, 2, 6, 1, bb)
  addBlock(p, chunk, stone, 1, 5, 1, bb)
  addBlock(p, chunk, slab, 1, 6, 1, bb)
  addBlock(p, chunk, stone, 1, 5, 2, bb)
  addBlock(p, chunk, stone, 1, 4, 3, bb)
  addBlock(p, chunk, slab, 1, 5, 3, bb)
  addBlock(p, chunk, stone, 2, 4, 3, bb)
  addBlock(p, chunk, stone, 3, 3, 3, bb)
  addBlock(p, chunk, slab, 3, 4, 3, bb)
  addBlock(p, chunk, stone, 3, 3, 2, bb)
  addBlock(p, chunk, stone, 3, 2, 1, bb)
  addBlock(p, chunk, slab, 3, 3, 1, bb)
  addBlock(p, chunk, stone, 2, 2, 1, bb)
  addBlock(p, chunk, stone, 1, 1, 1, bb)
  addBlock(p, chunk, slab, 1, 2, 1, bb)
  addBlock(p, chunk, stone, 1, 1, 2, bb)
  addBlock(p, chunk, slab, 1, 1, 3, bb)

proc newSpiralStaircaseStart*(random: var RandomGenerator, x, z: int32): StrongholdPiece =
  ## `SpiralStaircasePiece::new_start`
  let orientation = getRandomHorizontalDirection(random)
  let bbox = createBox(BlockBox, x, 64, z, getAxis(orientation), 5, 11, 5)
  let r = SpiralStaircasePiece(piece: newStructurePiece(StructurePieceType.StrongholdStart, bbox, 0), placeFn: placeSpiralStaircasePiece, fillFn: fillSpiralStaircasePiece, isStructureStart: true)
  setFacing(r.piece, orientation)
  asBase(r)

proc createSpiralStaircasePiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -7, 0, 5, 11, 5, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = SpiralStaircasePiece(piece: newStructurePiece(StructurePieceType.StrongholdSpiralStaircase, bbox, chainLength), placeFn: placeSpiralStaircasePiece, fillFn: fillSpiralStaircasePiece, isStructureStart: false)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  asBase(r)
