## Port of pumpkin-world/src/generation/structure/structures/stronghold/square_room.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

const CROSSING_LOOT_TABLE = "minecraft:chests/stronghold_crossing"

type
  SquareRoomPiece* = ref object of StrongholdPiece
    roomType*: uint32

proc fillSquareRoomPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  fillForwardOpening(self, ctx, 4, 1, false, StrongholdPieceType.Corridor)
  fillNwOpening(self, ctx, 1, 4)
  fillSeOpening(self, ctx, 1, 4)

proc placeSquareRoomPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[SquareRoomPiece](self)
  let p = s.piece
  let bb = chunkBox
  let air = blockState("air")
  fillOutlineRandom(p, 0, 0, 0, 10, 6, 10, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 4, 1, 0)
  fillWithOutline(p, chunk, bb, false, 4, 1, 10, 6, 3, 10, air, air)
  fillWithOutline(p, chunk, bb, false, 0, 1, 4, 0, 3, 6, air, air)
  fillWithOutline(p, chunk, bb, false, 10, 1, 4, 10, 3, 6, air, air)
  if s.roomType == 0'u32:
    let stoneBrick = blockState("stone_bricks")
    let smoothSlab = blockState("smooth_stone_slab")
    addBlock(p, chunk, stoneBrick, 5, 1, 5, bb)
    addBlock(p, chunk, stoneBrick, 5, 2, 5, bb)
    addBlock(p, chunk, stoneBrick, 5, 3, 5, bb)
    addBlock(p, chunk, smoothSlab, 4, 1, 4, bb)
    addBlock(p, chunk, smoothSlab, 4, 1, 5, bb)
    addBlock(p, chunk, smoothSlab, 4, 1, 6, bb)
    addBlock(p, chunk, smoothSlab, 6, 1, 4, bb)
    addBlock(p, chunk, smoothSlab, 6, 1, 5, bb)
    addBlock(p, chunk, smoothSlab, 6, 1, 6, bb)
    addBlock(p, chunk, smoothSlab, 5, 1, 4, bb)
    addBlock(p, chunk, smoothSlab, 5, 1, 6, bb)
  if s.roomType == 1'u32:
    let stoneBrick = blockState("stone_bricks")
    for i in int32(0) ..< int32(5):
      addBlock(p, chunk, stoneBrick, 3, 1, 3 + i, bb)
      addBlock(p, chunk, stoneBrick, 7, 1, 3 + i, bb)
      addBlock(p, chunk, stoneBrick, 3 + i, 1, 3, bb)
      addBlock(p, chunk, stoneBrick, 3 + i, 1, 7, bb)
    addBlock(p, chunk, stoneBrick, 5, 1, 5, bb)
    addBlock(p, chunk, stoneBrick, 5, 2, 5, bb)
    addBlock(p, chunk, stoneBrick, 5, 3, 5, bb)
    addBlock(p, chunk, blockState("water"), 5, 4, 5, bb)
  if s.roomType == 2'u32:
    let cobble = blockState("cobblestone")
    for i in int32(1) .. int32(9):
      addBlock(p, chunk, cobble, 1, 3, i, bb)
      addBlock(p, chunk, cobble, 9, 3, i, bb)
    for i in int32(1) .. int32(9):
      addBlock(p, chunk, cobble, i, 3, 1, bb)
      addBlock(p, chunk, cobble, i, 3, 9, bb)
    addBlock(p, chunk, cobble, 5, 1, 4, bb)
    addBlock(p, chunk, cobble, 5, 1, 6, bb)
    addBlock(p, chunk, cobble, 5, 3, 4, bb)
    addBlock(p, chunk, cobble, 5, 3, 6, bb)
    addBlock(p, chunk, cobble, 4, 1, 5, bb)
    addBlock(p, chunk, cobble, 6, 1, 5, bb)
    addBlock(p, chunk, cobble, 4, 3, 5, bb)
    addBlock(p, chunk, cobble, 6, 3, 5, bb)
    for i in int32(1) .. int32(3):
      addBlock(p, chunk, cobble, 4, i, 4, bb)
      addBlock(p, chunk, cobble, 6, i, 4, bb)
      addBlock(p, chunk, cobble, 4, i, 6, bb)
      addBlock(p, chunk, cobble, 6, i, 6, bb)
    addBlock(p, chunk, blockState("wall_torch"), 5, 3, 5, bb)
    let oak = blockState("oak_planks")
    for i in int32(2) .. int32(8):
      addBlock(p, chunk, oak, 2, 3, i, bb)
      addBlock(p, chunk, oak, 3, 3, i, bb)
      if i <= 3  or  i >= 7:
        addBlock(p, chunk, oak, 4, 3, i, bb)
        addBlock(p, chunk, oak, 5, 3, i, bb)
        addBlock(p, chunk, oak, 6, 3, i, bb)
      addBlock(p, chunk, oak, 7, 3, i, bb)
      addBlock(p, chunk, oak, 8, 3, i, bb)
    let ladder = stateWith("ladder", [("facing", "west")])
    addBlock(p, chunk, ladder, 9, 1, 3, bb)
    addBlock(p, chunk, ladder, 9, 2, 3, bb)
    addBlock(p, chunk, ladder, 9, 3, 3, bb)
    discard addChest(p, chunk, bb, random, 3, 4, 8, CROSSING_LOOT_TABLE)

proc createSquareRoomPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -4, -1, 0, 11, 7, 11, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = SquareRoomPiece(piece: newStructurePiece(StructurePieceType.StrongholdSquareRoom, bbox, chainLength), placeFn: placeSquareRoomPiece, fillFn: fillSquareRoomPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  r.roomType = cast[uint32](nextBoundedI32(ctx.random, 5))
  asBase(r)
