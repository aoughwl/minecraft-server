## Port of pumpkin-world/src/generation/structure/structures/stronghold/stairs.rs

{.feature: "lenientnils".}

import ../structuresmod
import strongholdbase

type
  StairsPiece* = ref object of StrongholdPiece

proc fillStairsPiece(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.} =
  fillForwardOpening(self, ctx, 1, 1, false, StrongholdPieceType.Corridor)

proc placeStairsPiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
  random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[StairsPiece](self)
  let p = s.piece
  let bb = chunkBox
  fillOutlineRandom(p, 0, 0, 0, 4, 10, 7, stoneBrickRandomizer, chunk, true, random, bb)
  generateEntrance(s, chunk, bb, s.entryDoor, 1, 7, 0)
  generateEntrance(s, chunk, bb, EntranceType.Opening, 1, 1, 7)
  let stairState = stateWith("cobblestone_stairs", [("facing", "south")])
  let stoneBricks = blockState("stone_bricks")
  for i in int32(0) ..< int32(6):
    addBlock(p, chunk, stairState, 1, 6 - i, 1 + i, bb)
    addBlock(p, chunk, stairState, 2, 6 - i, 1 + i, bb)
    addBlock(p, chunk, stairState, 3, 6 - i, 1 + i, bb)
    if i < 5:
      addBlock(p, chunk, stoneBricks, 1, 5 - i, 1 + i, bb)
      addBlock(p, chunk, stoneBricks, 2, 5 - i, 1 + i, bb)
      addBlock(p, chunk, stoneBricks, 3, 5 - i, 1 + i, bb)

proc createStairsPiece*(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  let bbox = rotated(BlockBox, x, y, z, -1, -7, 0, 5, 11, 8, orientation)
  if not isInBounds(bbox) or getIntersecting(ctx.collector, bbox) != nil:
    return nil
  let r = StairsPiece(piece: newStructurePiece(StructurePieceType.StrongholdStairs, bbox, chainLength), placeFn: placeStairsPiece, fillFn: fillStairsPiece)
  setFacing(r.piece, orientation)
  r.entryDoor = entranceTypeGetRandom(ctx.random)
  asBase(r)
