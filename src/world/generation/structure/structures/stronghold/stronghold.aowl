## The stronghold generator, and `pick_piece` and `create_piece`.
## Port of pumpkin-world/src/generation/structure/structures/stronghold/mod.rs; the rest of it is strongholdbase.aowl.

{.feature: "lenientnils".}

import ../../../generation
import strongholdbase
import chest_corridor
import corridor
import five_way_crossing
import left_turn
import library
import portal_room
import prison_hall
import right_turn
import spiral_staircase
import square_room
import stairs

export strongholdbase

proc newPieceWeight(pieceType: StrongholdPieceType, weight: int32, limit: uint32): PieceWeight =
  PieceWeight(pieceType: pieceType, weight: weight, limit: limit, generatedCount: 0'u32)

proc canGenerate(w: PieceWeight): bool =
  w.limit == 0'u32 or w.generatedCount < w.limit

proc canGenerateChained(w: PieceWeight, chainLength: uint32): bool =
  case w.pieceType
  of StrongholdPieceType.Library: canGenerate(w) and chainLength > 4'u32
  of StrongholdPieceType.PortalRoom: canGenerate(w) and chainLength > 5'u32
  else: canGenerate(w)

proc getInitialWeights*(): seq[PieceWeight] =
  @[newPieceWeight(StrongholdPieceType.Corridor, 40, 0),
    newPieceWeight(StrongholdPieceType.PrisonHall, 5, 5),
    newPieceWeight(StrongholdPieceType.LeftTurn, 20, 0),
    newPieceWeight(StrongholdPieceType.RightTurn, 20, 0),
    newPieceWeight(StrongholdPieceType.SquareRoom, 10, 6),
    newPieceWeight(StrongholdPieceType.Stairs, 5, 5),
    newPieceWeight(StrongholdPieceType.SpiralStaircase, 5, 5),
    newPieceWeight(StrongholdPieceType.FiveWayCrossing, 5, 4),
    newPieceWeight(StrongholdPieceType.ChestCorridor, 5, 4),
    newPieceWeight(StrongholdPieceType.Library, 10, 2),
    newPieceWeight(StrongholdPieceType.PortalRoom, 20, 1)]

proc createPiece(pieceType: StrongholdPieceType, ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection,
                 chainLength: uint32): StrongholdPiece =
  case pieceType
  of StrongholdPieceType.FiveWayCrossing: createFiveWayCrossingPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.Corridor: createCorridorPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.SquareRoom: createSquareRoomPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.PortalRoom: createPortalRoomPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.SpiralStaircase: createSpiralStaircasePiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.PrisonHall: createPrisonHallPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.LeftTurn: createLeftTurnPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.RightTurn: createRightTurnPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.Stairs: createStairsPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.ChestCorridor: createChestCorridorPiece(ctx, x, y, z, orientation, chainLength)
  of StrongholdPieceType.Library: createLibraryPiece(ctx, x, y, z, orientation, chainLength)

proc checkRemainingPieces(weights: seq[PieceWeight], totalWeight: var int32): bool =
  result = false
  totalWeight = 0
  for i in 0 ..< weights.len:
    if weights[i].limit > 0'u32 and weights[i].generatedCount < weights[i].limit:
      result = true
    totalWeight += weights[i].weight

proc pickPiece(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32): StrongholdPiece =
  var totalWeight = 0'i32
  if not checkRemainingPieces(ctx.weights, totalWeight):
    return nil
  var attempt = 0
  while attempt < 5:
    inc attempt
    var j = nextBoundedI32(ctx.random, totalWeight)
    var i = 0
    while i < ctx.weights.len:
      j -= ctx.weights[i].weight
      if j < 0:
        if not canGenerateChained(ctx.weights[i], chainLength) or
            (ctx.hasLastPieceType and ctx.weights[i].pieceType == ctx.lastPieceType):
          break
        let p = createPiece(ctx.weights[i].pieceType, ctx, x, y, z, orientation, chainLength)
        if p != nil:
          ctx.weights[i].generatedCount += 1'u32
          ctx.hasLastPieceType = true
          ctx.lastPieceType = ctx.weights[i].pieceType
          if not canGenerate(ctx.weights[i]):
            ctx.weights.delete(i)
          return p
      inc i
  var bbox = default(BlockBox)
  if smallCorridorCreateBox(ctx.collector, x, y, z, orientation, bbox) and bbox.min.y > 1:
    return newSmallCorridorPiece(chainLength, bbox, orientation)
  nil

proc pieceGenerator(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32,
                    hasPieceType: bool, pieceType: StrongholdPieceType): StrongholdPiece {.nimcall.} =
  ## `StrongholdPiece::piece_generator`
  if chainLength > 50'u32:
    return nil
  let startBox = ctx.start.boundingBox
  if abs(x - startBox.min.x) > 112 or abs(z - startBox.min.z) > 112:
    return nil
  if hasPieceType:
    createPiece(pieceType, ctx, x, y, z, orientation, chainLength + 1'u32)
  else:
    pickPiece(ctx, x, y, z, orientation, chainLength + 1'u32)

pieceGeneratorHook = pieceGenerator

proc fillOpenings(p: StrongholdPiece, ctx: StrongholdContext) =
  if p.fillFn != nil:
    let f = p.fillFn
    f(p, ctx)

proc strongholdPosition*(context: var StructureGeneratorContext): StructurePosition =
  ## `<StrongholdGenerator as StructureGenerator>::get_structure_position`
  let collector = newStructurePiecesCollector()
  let ctx = StrongholdContext(random: context.random, collector: collector, piecesToProcess: @[], weights: @[])
  while true:
    clear(collector)
    ctx.weights = getInitialWeights()
    ctx.hasLastPieceType = false
    ctx.hasPortalRoom = false
    let startX = sectionToBlock(context.chunkX) + 2
    let startZ = sectionToBlock(context.chunkZ) + 2
    let startPiece = newSpiralStaircaseStart(ctx.random, startX, startZ)
    ctx.start = startPiece.piece
    ctx.piecesToProcess = @[]
    addPiece(collector, startPiece)
    fillOpenings(startPiece, ctx)
    while ctx.piecesToProcess.len > 0:
      let idx = int(nextBoundedI32(ctx.random, int32(ctx.piecesToProcess.len)))
      let piece = ctx.piecesToProcess[idx]
      ctx.piecesToProcess.delete(idx)
      fillOpenings(piece, ctx)
    discard shiftInto(collector, context.seaLevel, context.minY, ctx.random, 10)
    if not isEmpty(collector) and ctx.hasPortalRoom:
      break
  context.random = ctx.random
  StructurePosition(startPos: blockPos(sectionToBlock(context.chunkX), 0, sectionToBlock(context.chunkZ)), collector: collector)
