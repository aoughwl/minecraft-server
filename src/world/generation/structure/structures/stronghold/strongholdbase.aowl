## What a stronghold piece needs from upstream's stronghold/mod.rs. The rest of that file is stronghold.aowl, which imports
## every piece: `piece_generator` here reaches `create_piece` and `pick_piece` through `pieceFactoryHook`.
## Port of pumpkin-world/src/generation/structure/structures/stronghold/mod.rs

{.feature: "lenientnils".}

import ../structuresmod

export structuresmod

type
  EntranceType* {.pure.} = enum
    Opening = 0, WoodDoor = 1, Grates = 2, IronDoor = 3

  StrongholdPieceType* {.pure.} = enum
    Corridor, PrisonHall, LeftTurn, RightTurn, SquareRoom, Stairs, SpiralStaircase, FiveWayCrossing, ChestCorridor,
    Library, PortalRoom

  PieceWeight* = object
    pieceType*: StrongholdPieceType
    weight*: int32
    limit*: uint32
    generatedCount*: uint32

  StrongholdPiece* = ref object of StructurePieceBase
    ## `StrongholdPiece`, and `StructurePieceBase::fill_openings` as `fillFn`. nil is the trait's default.
    entryDoor*: EntranceType
    fillFn*: FillFn

  FillFn* = proc(self: StrongholdPiece, ctx: StrongholdContext) {.nimcall.}

  StrongholdContext* = ref object
    ## The arguments `fill_openings` passes down, together.
    start*: StructurePiece
    random*: RandomGenerator
    weights*: seq[PieceWeight]
    hasLastPieceType*: bool
    lastPieceType*: StrongholdPieceType
    hasPortalRoom*: bool
    collector*: StructurePiecesCollector
    piecesToProcess*: seq[StrongholdPiece]

var pieceGeneratorHook*: proc(ctx: StrongholdContext, x, y, z: int32, orientation: BlockDirection, chainLength: uint32,
                              hasPieceType: bool, pieceType: StrongholdPieceType): StrongholdPiece {.nimcall.}
  ## `StrongholdPiece::piece_generator`, set by stronghold.aowl.

proc isInBounds*(bb: BlockBox): bool {.inline.} =
  bb.min.y > 10

proc entranceTypeGetRandom*(random: var RandomGenerator): EntranceType =
  case nextBoundedI32(random, 5)
  of 2'i32: EntranceType.WoodDoor
  of 3'i32: EntranceType.Grates
  of 4'i32: EntranceType.IronDoor
  else: EntranceType.Opening

proc stoneBrickRandomizer*(rng: var RandomGenerator, isBorder: bool): BlockStateId {.nimcall.} =
  ## `StoneBrickRandomizer`
  if not isBorder:
    return AirStateId
  let roll = nextF32(rng)
  if roll < 0.2'f32: blockState("cracked_stone_bricks")
  elif roll < 0.5'f32: blockState("mossy_stone_bricks")
  else: blockState("stone_bricks")

iterator stepRange*(a, b, step: int32): int32 =
  ## `(a..=b).step_by(step)`
  var i = a
  while i <= b:
    yield i
    i += step

proc facingOrNorth*(p: StructurePiece): BlockDirection =
  ## `facing.unwrap_or(BlockDirection::North)`
  if p.hasFacing: p.facing else: North

proc unwrapOr*(p: StructurePiece, fallback: BlockDirection): BlockDirection =
  if p.hasFacing: p.facing else: fallback

proc generateEntrance*(self: StrongholdPiece, chunk: ProtoChunk, boxLimit: BlockBox, entranceType: EntranceType, x, y, z: int32) =
  let p = self.piece
  case entranceType
  of EntranceType.Opening:
    fillWithOutline(p, chunk, boxLimit, false, x, y, z, x + 2, y + 2, z, AirStateId, AirStateId)
  of EntranceType.WoodDoor:
    let stone = blockState("stone_bricks")
    let doorLower = blockState("oak_door")
    let doorUpper = stateWith("oak_door", [("half", "upper")])
    addBlock(p, chunk, stone, x, y, z, boxLimit)
    addBlock(p, chunk, stone, x, y + 1, z, boxLimit)
    addBlock(p, chunk, stone, x, y + 2, z, boxLimit)
    addBlock(p, chunk, stone, x + 1, y + 2, z, boxLimit)
    addBlock(p, chunk, stone, x + 2, y + 2, z, boxLimit)
    addBlock(p, chunk, stone, x + 2, y + 1, z, boxLimit)
    addBlock(p, chunk, stone, x + 2, y, z, boxLimit)
    addBlock(p, chunk, doorLower, x + 1, y, z, boxLimit)
    addBlock(p, chunk, doorUpper, x + 1, y + 1, z, boxLimit)
  of EntranceType.Grates:
    let air = CaveAirStateId
    let barW = stateWith("iron_bars", [("west", "true")])
    let barE = stateWith("iron_bars", [("west", "false"), ("east", "true")])
    let barEw = stateWith("iron_bars", [("east", "true"), ("west", "true")])
    addBlock(p, chunk, air, x + 1, y, z, boxLimit)
    addBlock(p, chunk, air, x + 1, y + 1, z, boxLimit)
    addBlock(p, chunk, barW, x, y, z, boxLimit)
    addBlock(p, chunk, barW, x, y + 1, z, boxLimit)
    addBlock(p, chunk, barEw, x, y + 2, z, boxLimit)
    addBlock(p, chunk, barEw, x + 1, y + 2, z, boxLimit)
    addBlock(p, chunk, barEw, x + 2, y + 2, z, boxLimit)
    addBlock(p, chunk, barE, x + 2, y + 1, z, boxLimit)
    addBlock(p, chunk, barE, x + 2, y, z, boxLimit)
  of EntranceType.IronDoor:
    let stone = blockState("stone_bricks")
    let doorLower = blockState("iron_door")
    let doorUpper = stateWith("iron_door", [("half", "upper")])
    let buttonN = stateWith("stone_button", [("facing", "north")])
    let buttonS = stateWith("stone_button", [("facing", "south")])
    fillWithOutline(p, chunk, boxLimit, false, x, y, z, x, y + 2, z, stone, stone)
    addBlock(p, chunk, stone, x + 1, y + 2, z, boxLimit)
    fillWithOutline(p, chunk, boxLimit, false, x + 2, y, z, x + 2, y + 2, z, stone, stone)
    addBlock(p, chunk, doorLower, x + 1, y, z, boxLimit)
    addBlock(p, chunk, doorUpper, x + 1, y + 1, z, boxLimit)
    addBlock(p, chunk, buttonN, x + 2, y + 1, z + 1, boxLimit)
    addBlock(p, chunk, buttonS, x + 2, y + 1, z - 1, boxLimit)

proc pushGenerated(ctx: StrongholdContext, next: StrongholdPiece) =
  ## The newer tree's `generate_and_add_piece`, as vanilla has it: a piece joins the collector when it is made. The pinned
  ## tree adds it after its own children, so a pending piece is no obstacle and rooms overlap.
  if next != nil:
    addPiece(ctx.collector, next)
    ctx.piecesToProcess.add(next)

proc fillForwardOpening*(self: StrongholdPiece, ctx: StrongholdContext, leftRightOffset, heightOffset: int32, hasPiece: bool,
                         pieceType: StrongholdPieceType) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  let facing = self.piece.facing
  var nx, ny, nz: int32
  case facing
  of North:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.min.z - 1
  of South:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.max.z + 1
  of West:
    nx = bb.min.x - 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
  of East:
    nx = bb.max.x + 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
  else:
    return
  let f = pieceGeneratorHook
  pushGenerated(ctx, f(ctx, nx, ny, nz, facing, self.piece.chainLength, hasPiece, pieceType))

proc fillNwOpening*(self: StrongholdPiece, ctx: StrongholdContext, heightOffset, leftRightOffset: int32) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  var nx, ny, nz: int32
  var nextFacing = West
  case self.piece.facing
  of North, South:
    nx = bb.min.x - 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
    nextFacing = West
  of West, East:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.min.z - 1
    nextFacing = North
  else:
    return
  let f = pieceGeneratorHook
  pushGenerated(ctx, f(ctx, nx, ny, nz, nextFacing, self.piece.chainLength, false, StrongholdPieceType.Corridor))

proc fillSeOpening*(self: StrongholdPiece, ctx: StrongholdContext, heightOffset, leftRightOffset: int32) =
  if not self.piece.hasFacing:
    return
  let bb = self.piece.boundingBox
  var nx, ny, nz: int32
  var nextFacing = East
  case self.piece.facing
  of North, South:
    nx = bb.max.x + 1
    ny = bb.min.y + heightOffset
    nz = bb.min.z + leftRightOffset
    nextFacing = East
  of West, East:
    nx = bb.min.x + leftRightOffset
    ny = bb.min.y + heightOffset
    nz = bb.max.z + 1
    nextFacing = South
  else:
    return
  let f = pieceGeneratorHook
  pushGenerated(ctx, f(ctx, nx, ny, nz, nextFacing, self.piece.chainLength, false, StrongholdPieceType.Corridor))

proc asBase*(p: StrongholdPiece): StrongholdPiece {.inline.} =
  ## A derived `ref` returned by its last use, upcast, generates `&(cast)` in C, which gcc rejects. Through a parameter it does not.
  p
