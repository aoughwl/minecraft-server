## Upstream's own `#[test]` vectors for the pieces ported from ../ref/pumpkin: end_city/mod.rs, end_city/layout.rs,
## ocean_monument/mod.rs, ocean_monument/graph.rs and mineshaft.rs. Covers mineshaft.aowl, end_city.aowl, ocean_monument.aowl,
## shipwreck.aowl, ocean_ruin.aowl, ruined_portal.aowl and jigsaw_placement.aowl's pool aliases.

{.feature: "lenientnils".}

import std/options
import std/syncio
import ../../../../generated/structures
import ../../../../generated/dimension
import ../../../../util/legacy_rand
import ../../generator/generator
from ../../generation import getWorldGen
import "../template/templatemod"
import structuresmod
import chestorient
import end_city
import jigsaw_placement
import mineshaft
import ocean_monument
import ocean_ruin
import ruined_portal
import shipwreck

var failures = 0

proc check(ok: bool, what: string) =
  if not ok:
    echo "FAILED: ", what
    inc failures

type
  RecordingHeightSampler = ref object of HeightSampler
    calls: seq[(int32, int32)]
    heights: seq[int32]

proc recordHeight(self: HeightSampler, blockX, blockZ: int32): int32 {.nimcall.} =
  let s = cast[RecordingHeightSampler](self)
  result = s.heights[s.calls.len]
  s.calls.add((blockX, blockZ))

proc newRecording(heights: seq[int32]): RecordingHeightSampler =
  RecordingHeightSampler(estimateFn: recordHeight, calls: @[], heights: heights)

proc legacyRandom(seed: uint64): RandomGenerator = toRandomGenerator(legacy_rand.fromSeed(seed))

proc endCityStartSampling() =
  ## `start_position_uses_java_five_by_five_corner_sampling`
  let seed = 42'u64
  var expectedRandom = legacyRandom(seed)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(expectedRandom, 4)))
  let (offsetX, offsetZ) =
    case rotation
    of Rotation.None: (5'i32, 5'i32)
    of Rotation.Clockwise90: (-5'i32, 5'i32)
    of Rotation.Rotate180: (-5'i32, -5'i32)
    of Rotation.CounterClockwise90: (5'i32, -5'i32)
  let sampler = newRecording(@[74'i32, 70, 72, 73])
  var context = StructureGeneratorContext(seed: 42, chunkX: 3, chunkZ: -2, random: legacyRandom(seed), seaLevel: 63, minY: 0,
    height: 128, heightSampler: sampler, hasStructureKey: false)
  let position = endCityPosition(context)
  let x = 3'i32 * 16 + 7
  let z = -2'i32 * 16 + 7
  check(sampler.calls == @[(x, z), (x, z + offsetZ), (x + offsetX, z), (x + offsetX, z + offsetZ)], "end city samples its corners")
  check(position != nil and position.startPos.x == x and position.startPos.y == 69 and position.startPos.z == z, "end city start")

proc endCityRejectsLowTerrain() =
  ## `terrain_below_sixty_rejects_the_city`
  let sampler = newRecording(@[70'i32, 59, 70, 70])
  var context = StructureGeneratorContext(seed: 0, chunkX: 0, chunkZ: 0, random: legacyRandom(0), seaLevel: 63, minY: 0,
    height: 128, heightSampler: sampler, hasStructureKey: false)
  check(endCityPosition(context) == nil, "terrain below sixty rejects the city")

proc endCityShipCity() =
  ## `fixed_seed_matches_vanilla_ship_city`
  var random = createChunkRandom(12345, -298, -275)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(random, 4)))
  var pieces: seq[PieceDescriptor] = @[]
  check(createLayout(vec3[int32](-4761, 60, -4393), rotation, random, pieces), "ship city lays out")
  check(rotation == Rotation.Rotate180, "ship city rotation")
  check(pieces.len == 78, "ship city has 78 pieces, not " & $pieces.len)
  if pieces.len > 43:
    let ship = pieces[43]
    check(ship.templateName == "ship", "piece 43 is the ship")
    check(ship.rotation == Rotation.CounterClockwise90, "ship rotation")
    check(ship.templatePosition == vec3[int32](-4888, 123, -4393), "ship position")
    check(ship.generationGroup == -340338317, "ship generation group")
    check(ship.boundingBox.min == vec3[int32](-4888, 123, -4405) and ship.boundingBox.max == vec3[int32](-4860, 146, -4393), "ship box")

proc endCityFatTower() =
  ## `fixed_seed_matches_vanilla_fat_tower_city`
  var random = createChunkRandom(12345, 62, 24)
  let rotation = fromIndex(Rotation, uint8(nextBoundedI32(random, 4)))
  var pieces: seq[PieceDescriptor] = @[]
  check(createLayout(vec3[int32](999, 61, 391), rotation, random, pieces), "fat tower city lays out")
  let expected = ["base_floor", "second_floor_1", "third_floor_1", "third_roof", "tower_base", "tower_piece", "tower_piece",
    "tower_piece", "fat_tower_base", "fat_tower_middle", "fat_tower_top"]
  check(pieces.len == expected.len, "fat tower city has 11 pieces, not " & $pieces.len)
  if pieces.len == expected.len:
    for i in 0 ..< expected.len:
      check(pieces[i].templateName == expected[i], "fat tower piece " & $i)
    let top = pieces[pieces.len - 1]
    check(top.templatePosition == vec3[int32](994, 101, 386), "fat tower top position")
    check(top.generationGroup == 1141071963, "fat tower top generation group")

proc endCityTemplatesAvailable() =
  ## `vanilla_templates_are_available`, with `recursive_generation_never_creates_multiple_ships`
  for name in ["base_floor", "base_roof", "bridge_end", "bridge_gentle_stairs", "bridge_piece", "bridge_steep_stairs",
      "fat_tower_base", "fat_tower_middle", "fat_tower_top", "second_floor_1", "second_floor_2", "second_roof", "ship",
      "third_floor_1", "third_floor_2", "third_roof", "tower_base", "tower_piece", "tower_top"]:
    let t = getTemplate("end_city/" & name)
    check(t != nil, "pinned assets have end_city/" & name)
    if t != nil:
      for pi in 0 ..< t.palette.len:
        check(resolve(t.palette[pi], Rotation.Clockwise90, Mirror.None)[0], "resolves " & t.palette[pi].name & " in " & name)
  for seed in 0'u64 ..< 256'u64:
    var random = legacyRandom(seed)
    let rotation = fromIndex(Rotation, uint8(nextBoundedI32(random, 4)))
    var pieces: seq[PieceDescriptor] = @[]
    discard createLayout(vec3[int32](0, 70, 0), rotation, random, pieces)
    var ships = 0
    for i in 0 ..< pieces.len:
      if pieces[i].templateName == "ship":
        inc ships
    check(ships <= 1, "one ship at most")

proc monumentStart() =
  ## `structure_start_uses_the_ocean_floor_heightmap`
  let sampler = newRecording(@[])
  sampler.estimateOceanFloorFn = proc(self: HeightSampler, blockX, blockZ: int32): int32 {.nimcall.} = 37'i32
  var context = StructureGeneratorContext(seed: 0, chunkX: 2, chunkZ: -3, random: legacyRandom(0), seaLevel: 63, minY: -64,
    height: 384, heightSampler: sampler, hasStructureKey: false)
  let position = oceanMonumentPosition(context)
  check(position != nil and position.startPos.y == 37, "monument starts on the ocean floor")
  check(sampler.calls.len == 0, "monuments must not use the world-surface heightmap")

proc monumentOrientation() =
  ## `orientation_does_not_move_the_monument_origin`, `generated_graph_keeps_every_room_connected`
  for direction in [North, South, West, East]:
    var random = legacyRandom(0)
    let building = newMonumentBuilding(random, 100, 200, direction, 63)
    let bounds = building.piece.boundingBox
    check(bounds.min == vec3[int32](100, 39, 200) and bounds.max == vec3[int32](157, 61, 257), "orientation keeps the origin")
    for bi in 0 ..< roomBoxes(building).len:
      let child = roomBoxes(building)[bi]
      check(child.min.x >= bounds.min.x and child.min.y >= bounds.min.y and child.min.z >= bounds.min.z and
        child.max.x <= bounds.max.x and child.max.y <= bounds.max.y and child.max.z <= bounds.max.z, "a room stays in the monument")
  for seed in 0'u64 ..< 128'u64:
    var random = legacyRandom(seed)
    check(graphRoomCountsAndConnected(random), "graph of seed " & $seed)

proc monumentTreasure() =
  ## `every_orientation_places_the_complete_treasure_core`
  let gen = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let gold = blockIdNamed("gold_block")
  for direction in [North, South, West, East]:
    var random = legacyRandom(0)
    let building = newMonumentBuilding(random, 0, 0, direction, 63)
    let bounds = building.piece.boundingBox
    var goldBlocks = 0
    for chunkX in (bounds.min.x shr 4) .. (bounds.max.x shr 4):
      for chunkZ in (bounds.min.z shr 4) .. (bounds.max.z shr 4):
        let chunk = newProtoChunkRaw(chunkX, chunkZ, gen.noise.defaultBlock, gen.noise.biomeMixerSeed, 384, -64)
        let startX = startBlockX(chunkX)
        let startZ = startBlockZ(chunkZ)
        let chunkBox = newBlockBox(startX, -64, startZ, startX + 15, 319, startZ + 15)
        var placementRandom = legacyRandom(1)
        placeBuilding(building, chunk, placementRandom, chunkBox)
        for x in 0'i32 ..< 16'i32:
          for y in 0'i32 ..< 384'i32:
            for z in 0'i32 ..< 16'i32:
              if blockIdOf(getBlockStateRaw(chunk, x, y, z)) == gold:
                inc goldBlocks
    check(goldBlocks == 8, "treasure core has 8 gold blocks, not " & $goldBlocks)

proc mineshaftChest() =
  ## `mineshaft_corridor_chest_minecart_spawns_with_loot_table`
  let gen = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let chunk = newProtoChunkRaw(0, 0, gen.noise.defaultBlock, gen.noise.biomeMixerSeed, 384, -64)
  let chunkBox = newBlockBox(0, -64, 0, 15, 319, 15)
  setBlockState(chunk, 2, 63, 2, blockState("stone"))
  setBlockState(chunk, 2, 64, 2, blockState("air"))
  var random = legacyRandom(42)
  let corridor = newMineShaftCorridor(0, random, newBlockBox(0, 64, 0, 2, 67, 10), South, MineshaftType.Normal)
  check(createChest(corridor, chunk, chunkBox, random, 2, 0, 2, "minecraft:chests/abandoned_mineshaft"), "chest is created")
  let entities = takePendingStructureEntities(chunk)
  check(entities.len == 1, "one minecart")
  if entities.len == 1:
    check(get(getString(entities[0], "id")) == "minecraft:chest_minecart", "minecart id")
    check(get(getString(entities[0], "LootTable")) == "minecraft:chests/abandoned_mineshaft", "minecart loot")
    check(isSome(getLong(entities[0], "LootTableSeed")), "minecart loot seed")
    let pos = get(getList(entities[0], "Pos"))
    check(pos.len == 3 and pos[0].doubleVal == 2.5'f64 and pos[1].doubleVal == 64.5'f64 and pos[2].doubleVal == 2.5'f64, "minecart pos")

proc clearReorientArea(chunk: ProtoChunk) =
  for dx in 4 .. 6:
    for dz in 4 .. 6:
      setBlockState(chunk, int32(dx), 70'i32, int32(dz), blockState("air"))

proc chestReorient() =
  ## The newer checkout's `StructurePiece::reorient` (vanilla's): a lone solid-render neighbour makes the chest face away
  ## from it; with none, or two, it keeps the default facing and turns away from any solid wall in front of it.
  let gen = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let chunk = newProtoChunkRaw(0, 0, gen.noise.defaultBlock, gen.noise.biomeMixerSeed, 384, -64)
  let stone = blockState("stone")
  let pos = vec3[int32](5'i32, 70'i32, 5'i32)
  clearReorientArea(chunk)
  check(chestFacingName(reorientChest(pos, ChestStateId, chunk)) == "north", "no neighbours: default north")
  setBlockState(chunk, 4'i32, 70'i32, 5'i32, stone)  # west
  check(chestFacingName(reorientChest(pos, ChestStateId, chunk)) == "east", "stone west: faces east")
  clearReorientArea(chunk)
  setBlockState(chunk, 5'i32, 70'i32, 4'i32, stone)  # north
  check(chestFacingName(reorientChest(pos, ChestStateId, chunk)) == "south", "stone north: faces south")
  setBlockState(chunk, 5'i32, 70'i32, 6'i32, stone)  # and south: two solids, so the lock walk: N solid -> S solid -> W
  check(chestFacingName(reorientChest(pos, ChestStateId, chunk)) == "west", "stone north and south: lock walk ends west")
  clearReorientArea(chunk)
  setBlockState(chunk, 4'i32, 70'i32, 5'i32, ChestStateId)  # a chest beside it: the state is returned untouched
  check(chestFacingName(reorientChest(pos, ChestStateId, chunk)) == "north", "chest neighbour: unchanged")

proc sameBox(a, b: BlockBox): bool = a.min == b.min and a.max == b.max

proc mineshaftShifted() =
  ## A shift moves the room's entrances with it (`MineShaftRoom::translate`). Known answer: the start at chunk (-2, -24) of a
  ## real 1.21.11 save, seed -7436126469594556380, whose `msroom` holds these `BB` and `Entrances`.
  let seed = -7436126469594556380'i64
  var context = StructureGeneratorContext(seed: seed, chunkX: -2, chunkZ: -24, random: createChunkRandom(seed, -2, -24), seaLevel: 63,
    minY: -64, height: 384, heightSampler: nil, hasStructureKey: false)
  let position = mineshaftPosition(context, false)
  check(position.collector.pieces.len == 166, "that start has 166 pieces, not " & $position.collector.pieces.len)
  let room = cast[MineShaftRoom](position.collector.pieces[0])
  check(sameBox(room.piece.boundingBox, newBlockBox(-30, 34, -382, -23, 39, -375)), "the room's box")
  let expected = [newBlockBox(-28, 35, -382, -24, 37, -381), newBlockBox(-25, 36, -376, -23, 38, -375),
    newBlockBox(-30, 35, -381, -29, 37, -379)]
  check(entranceBoxes(room).len == expected.len, "three entrances")
  if entranceBoxes(room).len == expected.len:
    for i in 0 ..< expected.len:
      check(sameBox(entranceBoxes(room)[i], expected[i]), "entrance " & $i)

proc poolAliases() =
  ## `PoolAliasLookup`: both spellings of an alias, chains, and the trial chambers' bindings from the pinned assets.
  var random = legacyRandom(1)
  let lookupTable = poolAliasLookupFromBindings(@[
    PoolAliasBinding(kind: PoolAliasBindingKind.Direct, alias: "minecraft:a", target: "minecraft:b"),
    PoolAliasBinding(kind: PoolAliasBindingKind.Direct, alias: "minecraft:b", target: "minecraft:c")], random)
  check(lookup(lookupTable, "minecraft:a") == "minecraft:c", "alias chain")
  check(lookup(lookupTable, "a") == "minecraft:c", "alias without its namespace")
  check(lookup(lookupTable, "minecraft:other") == "minecraft:other", "not an alias")
  let bindings = structurePoolAliases(StructureKeys.TrialChambers)
  check(bindings.len > 0, "trial chambers have aliases")
  let chambers = poolAliasLookupFromBindings(bindings, random)
  check(lookup(chambers, "minecraft:trial_chambers/spawner/contents/ranged") != "minecraft:trial_chambers/spawner/contents/ranged",
    "the ranged spawner alias resolves")
  check(structurePoolAliases(StructureKeys.VillagePlains).len == 0, "a village has none")

proc pinnedAssetsHaveEveryTemplate() =
  ## What the newer tree's pieces name, in the pinned tree's assets.
  template each(list: untyped) =
    for name in list:
      check(getTemplate(name) != nil, "pinned assets have " & name)
  each(StructureLocationBeached)
  each(StructureLocationOcean)
  each(WarmRuins)
  each(BigWarmRuins)
  each(RuinsBrick)
  each(RuinsCracked)
  each(RuinsMossy)
  each(BigRuinsBrick)
  each(BigRuinsCracked)
  each(BigRuinsMossy)
  each(StructureLocationPortals)
  each(StructureLocationGiantPortals)

proc placeEverywhere(position: StructurePosition, what: string) =
  ## Every chunk a start touches, on stone up to y 40: nothing here reads a registry.
  let gen = getWorldGen(0'u64, OVERWORLD, false, @[], "")
  let air = blockState("air")
  let stone = blockState("stone")
  let bb = getBoundingBox(position.collector)
  var placed = 0
  for chunkX in (bb.min.x shr 4) .. (bb.max.x shr 4):
    for chunkZ in (bb.min.z shr 4) .. (bb.max.z shr 4):
      let chunk = newProtoChunkRaw(chunkX, chunkZ, air, gen.noise.biomeMixerSeed, 384, -64)
      for x in 0'i32 ..< 16'i32:
        for z in 0'i32 ..< 16'i32:
          for y in -64'i32 .. 40'i32:
            setBlockState(chunk, startBlockX(chunkX) + x, y, startBlockZ(chunkZ) + z, stone)
      primeHeightmaps(chunk)
      let before = chunk.flatBlockMap
      var random = legacyRandom(9)
      generateInChunk(position.collector, chunk, nil, random, 0)
      for i in 0 ..< before.len:
        if before[i] != chunk.flatBlockMap[i]:
          inc placed
  check(placed > 0, what & " places blocks")

proc templateKindsPlace() =
  ## A ruined portal of each variant runs every processor it builds, so each name they look up must exist in the pinned data.
  for seed in 0'i64 ..< 8'i64:
    var ruin = StructureGeneratorContext(seed: seed, chunkX: 3, chunkZ: 3, random: createChunkRandom(seed, 3, 3), seaLevel: 63,
      minY: -64, height: 384, heightSampler: nil, hasStructureKey: false)
    placeEverywhere(oceanRuinPosition(ruin, seed mod 2 == 0), "an ocean ruin")
    var wreck = StructureGeneratorContext(seed: seed, chunkX: 3, chunkZ: 3, random: createChunkRandom(seed, 3, 3), seaLevel: 63,
      minY: -64, height: 384, heightSampler: nil, hasStructureKey: false)
    placeEverywhere(shipwreckPosition(wreck, seed mod 2 == 0), "a shipwreck")
    for variant in [StructureKeys.RuinedPortal, StructureKeys.RuinedPortalDesert, StructureKeys.RuinedPortalJungle,
        StructureKeys.RuinedPortalSwamp, StructureKeys.RuinedPortalMountain, StructureKeys.RuinedPortalOcean,
        StructureKeys.RuinedPortalNether]:
      var portal = StructureGeneratorContext(seed: seed, chunkX: 3, chunkZ: 3, random: createChunkRandom(seed, 3, 3), seaLevel: 63,
        minY: -64, height: 384, heightSampler: nil, hasStructureKey: false)
      placeEverywhere(ruinedPortalPosition(portal, variant), "a ruined portal")
  var mine = StructureGeneratorContext(seed: 3, chunkX: 3, chunkZ: 3, random: createChunkRandom(3, 3, 3), seaLevel: 63, minY: -64,
    height: 384, heightSampler: nil, hasStructureKey: false)
  placeEverywhere(mineshaftPosition(mine, false), "a mineshaft")
  var city = StructureGeneratorContext(seed: 3, chunkX: 3, chunkZ: 3, random: createChunkRandom(3, 3, 3), seaLevel: 63, minY: 0,
    height: 256, heightSampler: newRecording(@[70'i32, 70, 70, 70]), hasStructureKey: false)
  placeEverywhere(endCityPosition(city), "an end city")

endCityStartSampling()
endCityRejectsLowTerrain()
endCityShipCity()
endCityFatTower()
endCityTemplatesAvailable()
monumentStart()
monumentOrientation()
monumentTreasure()
mineshaftChest()
chestReorient()
mineshaftShifted()
poolAliases()
pinnedAssetsHaveEveryTemplate()
templateKindsPlace()

if failures > 0:
  echo failures, " failed"
  quit(1)
echo "structurepiecestest passed"
