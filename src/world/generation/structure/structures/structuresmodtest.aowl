## `large_feature_seed_matches_java_random` from upstream's structures/mod.rs, and the piece transforms and collector, which
## have no upstream test.
## Port of pumpkin-world/src/generation/structure/structures/mod.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import structuresmod

block largeFeatureSeedMatchesJavaRandom:
  var random = createChunkRandom(123456789'i64, -37, 84)
  assert nextI32(random) == -2113851872'i32
  assert nextI32(random) == -821770162'i32
  assert nextI32(random) == 381681559'i32
  assert nextI32(random) == -196012664'i32
  assert nextI32(random) == 372718864'i32

block facingTransforms:
  let box = newBlockBox(10, 20, 30, 14, 24, 36)
  var p = newStructurePiece(StructurePieceType.StrongholdCorridor, box, 0)
  # No facing: the coordinates pass through.
  let none = offsetPos(p, 1, 2, 3)
  assert none.x == 1 and none.y == 2 and none.z == 3
  setFacing(p, North)
  let north = offsetPos(p, 1, 2, 3)
  assert north.x == 11 and north.y == 22 and north.z == 33
  assert p.mirror == Mirror.None and p.rotation == Rotation.None
  setFacing(p, South)
  let south = offsetPos(p, 1, 2, 3)
  assert south.x == 11 and south.y == 22 and south.z == 33
  assert p.mirror == Mirror.LeftRight and p.rotation == Rotation.None
  setFacing(p, West)
  let west = offsetPos(p, 1, 2, 3)
  assert west.x == 11 and west.y == 22 and west.z == 31
  assert p.mirror == Mirror.LeftRight and p.rotation == Rotation.Clockwise90
  setFacing(p, East)
  let east = offsetPos(p, 1, 2, 3)
  assert east.x == 13 and east.y == 22 and east.z == 31
  assert p.mirror == Mirror.None and p.rotation == Rotation.Clockwise90

block collector:
  let c = newStructurePiecesCollector()
  assert isEmpty(c)
  let a = StructurePieceBase(piece: newStructurePiece(StructurePieceType.Igloo, newBlockBox(0, 0, 0, 4, 9, 4), 0), placeFn: placeNothing)
  let b = StructurePieceBase(piece: newStructurePiece(StructurePieceType.Igloo, newBlockBox(10, 5, 10, 14, 7, 14), 0), placeFn: placeNothing)
  addPiece(c, a)
  addPiece(c, b)
  let bbox = getBoundingBox(c)
  assert bbox.min.x == 0 and bbox.max.x == 14 and bbox.min.y == 0 and bbox.max.y == 9
  assert getIntersecting(c, newBlockBox(12, 6, 12, 12, 6, 12)) == b
  assert getIntersecting(c, newBlockBox(50, 6, 12, 50, 6, 12)) == nil
  # `shift_into`: (9 - 0 + 1) + 0 + 1 = 11 < 20, so 11 + nextInt(9) - 9.
  var random = createChunkRandom(1'i64, 0, 0)
  var expected = createChunkRandom(1'i64, 0, 0)
  let moved = shiftInto(c, 30, 0, random, 10)
  assert moved == 11 + nextBoundedI32(expected, 9) - 9
  assert getBoundingBox(c).min.y == moved

echo "structuresmod: ok"
