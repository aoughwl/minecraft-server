## Port of pumpkin-world/src/generation/structure/structures/swamp_hut.rs
##
## Upstream leaves the roof stairs, witch and cat commented out, and so does this.

{.feature: "lenientnils".}

import ../shiftable_piece
import structuresmod

type
  SwampHutPiece = ref object of ShiftableStructurePiece

let
  SprucePlanksState = blockState("spruce_planks")
  OakLogState = blockState("oak_log")
  OakFenceState = blockState("oak_fence")
  PottedRedMushroomState = blockState("potted_red_mushroom")
  CraftingTableState = blockState("crafting_table")
  CauldronState = blockState("cauldron")

proc placeSwampHut(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                   random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let s = cast[SwampHutPiece](self)
  if not adjustToAverageHeight(s, chunk):
    return
  let p = s.piece
  let sp = SprucePlanksState
  fillWithOutline(p, chunk, chunkBox, false, 1, 1, 1, 5, 1, 7, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 1, 4, 2, 5, 4, 7, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 2, 1, 0, 4, 1, 0, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 2, 2, 2, 3, 3, 2, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 1, 2, 3, 1, 3, 6, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 5, 2, 3, 5, 3, 6, sp, sp)
  fillWithOutline(p, chunk, chunkBox, false, 2, 2, 7, 4, 3, 7, sp, sp)
  let ol = OakLogState
  fillWithOutline(p, chunk, chunkBox, false, 1, 0, 2, 1, 3, 2, ol, ol)
  fillWithOutline(p, chunk, chunkBox, false, 5, 0, 2, 5, 3, 2, ol, ol)
  fillWithOutline(p, chunk, chunkBox, false, 1, 0, 7, 1, 3, 7, ol, ol)
  fillWithOutline(p, chunk, chunkBox, false, 5, 0, 7, 5, 3, 7, ol, ol)
  addBlock(p, chunk, OakFenceState, 2, 3, 2, chunkBox)
  addBlock(p, chunk, OakFenceState, 3, 3, 7, chunkBox)
  addBlock(p, chunk, AirStateId, 1, 3, 4, chunkBox)
  addBlock(p, chunk, AirStateId, 5, 3, 4, chunkBox)
  addBlock(p, chunk, AirStateId, 5, 3, 5, chunkBox)
  addBlock(p, chunk, PottedRedMushroomState, 1, 3, 5, chunkBox)
  addBlock(p, chunk, CraftingTableState, 3, 2, 6, chunkBox)
  addBlock(p, chunk, CauldronState, 4, 2, 6, chunkBox)
  addBlock(p, chunk, OakFenceState, 1, 2, 1, chunkBox)
  addBlock(p, chunk, OakFenceState, 5, 2, 1, chunkBox)
  for i in [2'i32, 7'i32]:
    for j in [1'i32, 5'i32]:
      fillDownwards(p, chunk, ol, j, -1, i, chunkBox)

proc swampHutPosition*(context: var StructureGeneratorContext): StructurePosition =
  let x = getCenterX(context.chunkX)
  let z = getCenterZ(context.chunkZ)
  let piece = SwampHutPiece(placeFn: placeSwampHut)
  initShiftable(piece, StructurePieceType.SwampHut, x, 64, z, 7, 7, 9, getAxis(getRandomHorizontalDirection(context.random)))
  singlePiecePosition(piece, x, 64, z)
