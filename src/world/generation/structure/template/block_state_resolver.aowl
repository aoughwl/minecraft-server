## Block state resolution from template palette entries.
## Port of pumpkin-world/src/generation/structure/template/block_state_resolver.rs

{.feature: "lenientnils".}

import std/strutils
import ../../../blockstates
import ../../../../data/block_rotation
import structure_template

proc transformProperty(key, value: string, rotation: Rotation, mirror: Mirror): string =
  case key
  of "facing":
    rotateFacing(rotation, mirrorFacing(mirror, value))
  of "axis":
    rotateAxis(rotation, value)
  of "rotation":
    var rotValue = 0
    var parsed = value.len > 0
    for c in value:
      if c >= '0' and c <= '9':
        rotValue = rotValue * 10 + (ord(c) - ord('0'))
      else:
        parsed = false
    if parsed:
      let mirrored = mirrorBlockRotation(mirror, int32(rotValue))
      $(rotateBlockRotation(rotation, mirrored) mod 16'i32)
    else:
      value
  else:
    value

proc resolve*(entry: PaletteEntry, rotation: Rotation, mirror: Mirror): (bool, BlockStateId) =
  ## `BlockStateResolver::resolve`: false for a block that does not exist.
  let (found, blockId) = blockIdByName(entry.name)
  if not found:
    return (false, 0'u32)
  if entry.properties.len == 0:
    return (true, defaultStateOf(blockId))
  var transformedProps = newSeq[StateProp](entry.properties.len)
  for i in 0 ..< entry.properties.len:
    let key = entry.properties[i][0]
    let value = entry.properties[i][1]
    var transformedKey = key
    if key == "north" or key == "south" or key == "east" or key == "west":
      transformedKey = rotateFacing(rotation, mirrorFacing(mirror, key))
    transformedProps[i] = (transformedKey, transformProperty(key, value, rotation, mirror))
  (true, stateIdFromProps(blockId, transformedProps))

proc resolveSimple*(entry: PaletteEntry): (bool, BlockStateId) =
  resolve(entry, Rotation.None, Mirror.None)
