## Template caching for embedded structure templates.
## Port of pumpkin-world/src/generation/structure/template/cache.rs
##
## `get_template_bytes` and friends from upstream's build script are generated/structure_assets.aowl.

{.feature: "lenientnils".}

import std/tables
import std/syncio
import ../../../../generated/structures
import ../../../../generated/structure_assets
import structure_template

type
  TemplateCache* = ref object
    cache: Table[string, StructureTemplate]

var
  templateIndex = initTable[string, int]()
  poolJsonIndex = initTable[string, int]()
  processorJsonIndex = initTable[string, int]()
  poolElements = initTable[string, seq[string]]()
  indexed = false
  globalCacheInstance: TemplateCache = nil

proc stripMinecraftPrefix*(name: string): string =
  if name.len > 10 and name[0 .. 9] == "minecraft:": name[10 .. ^1] else: name

proc ensureIndexed() =
  if indexed:
    return
  indexed = true
  for i in 0 ..< TemplateBytesEntries.len:
    let name = TemplateBytesEntries[i].name
    templateIndex[name] = i
    var at = name.len - 1
    while at >= 0 and name[at] != '/':
      dec at
    if at > 0:
      let prefix = name[0 ..< at]
      var inDir = poolElements.getOrDefault(prefix, @[])
      inDir.add(name)
      poolElements[prefix] = inDir
  for i in 0 ..< TemplatePoolJson.len:
    poolJsonIndex[TemplatePoolJson[i].id] = i
  for i in 0 ..< ProcessorListJson.len:
    processorJsonIndex[ProcessorListJson[i].id] = i

proc base64Value(c: char): uint32 {.inline.} =
  if c >= 'A' and c <= 'Z': uint32(ord(c) - ord('A'))
  elif c >= 'a' and c <= 'z': uint32(ord(c) - ord('a') + 26)
  elif c >= '0' and c <= '9': uint32(ord(c) - ord('0') + 52)
  elif c == '+': 62'u32
  else: 63'u32

proc decodeTemplateBytes(entry: TemplateBytesEntry): seq[byte] =
  result = newSeqOfCap[byte](entry.length div 4 * 3)
  var i = entry.offset
  let stop = entry.offset + entry.length
  while i < stop:
    let v = (base64Value(TemplateBytesBase64[i]) shl 18) or (base64Value(TemplateBytesBase64[i + 1]) shl 12) or
      (base64Value(TemplateBytesBase64[i + 2]) shl 6) or base64Value(TemplateBytesBase64[i + 3])
    result.add(byte((v shr 16) and 255'u32))
    if TemplateBytesBase64[i + 2] != '=':
      result.add(byte((v shr 8) and 255'u32))
    if TemplateBytesBase64[i + 3] != '=':
      result.add(byte(v and 255'u32))
    i += 4

proc getTemplateBytes*(path: string): (bool, seq[byte]) =
  ## `get_template_bytes`
  ensureIndexed()
  let i = templateIndex.getOrDefault(path, -1)
  if i < 0:
    return (false, @[])
  (true, decodeTemplateBytes(TemplateBytesEntries[i]))

proc getPoolElements*(poolId: string): (bool, seq[string]) =
  ## `get_pool_elements`
  ensureIndexed()
  let id = stripMinecraftPrefix(poolId)
  if poolElements.hasKey(id):
    (true, poolElements.getOrDefault(id, @[]))
  else:
    (false, @[])

proc getTemplatePoolJson*(path: string): (bool, string) =
  ## `get_template_pool_json`
  ensureIndexed()
  let i = poolJsonIndex.getOrDefault(stripMinecraftPrefix(path), -1)
  if i < 0: (false, "") else: (true, TemplatePoolJson[i].json)

proc getProcessorListJson*(path: string): (bool, string) =
  ## `get_processor_list_json`
  ensureIndexed()
  let i = processorJsonIndex.getOrDefault(stripMinecraftPrefix(path), -1)
  if i < 0: (false, "") else: (true, ProcessorListJson[i].json)

proc newTemplateCache*(): TemplateCache =
  TemplateCache(cache: initTable[string, StructureTemplate]())

proc get*(c: TemplateCache, nameIn: string): StructureTemplate =
  ## `TemplateCache::get`: nil for a missing or broken template.
  let name = stripMinecraftPrefix(nameIn)
  if c.cache.hasKey(name):
    return c.cache.getOrDefault(name, nil)
  let (found, bytes) = getTemplateBytes(name)
  if not found:
    return nil
  let loaded = templateFromNbtBytes(bytes)
  if not loaded.ok:
    echo "Failed to load template '", name, "': ", loaded.error
    return nil
  c.cache[name] = loaded.value
  loaded.value

proc getOrError*(c: TemplateCache, nameIn: string): TemplateResult =
  ## `TemplateCache::get_or_error`
  let name = stripMinecraftPrefix(nameIn)
  if c.cache.hasKey(name):
    return TemplateResult(ok: true, error: "", value: c.cache.getOrDefault(name, nil))
  let (found, bytes) = getTemplateBytes(name)
  if not found:
    return TemplateResult(ok: false, error: "Missing required field: template file not found", value: nil)
  result = templateFromNbtBytes(bytes)
  if result.ok:
    c.cache[name] = result.value

proc preload*(c: TemplateCache, names: openArray[string]) =
  for name in names:
    let r = getOrError(c, name)
    if not r.ok:
      echo "Failed to preload template '", name, "': ", r.error

proc len*(c: TemplateCache): int = c.cache.len
proc isEmpty*(c: TemplateCache): bool = c.cache.len == 0
proc clear*(c: TemplateCache) = c.cache = initTable[string, StructureTemplate]()

proc globalCache*(): TemplateCache =
  if globalCacheInstance == nil:
    globalCacheInstance = newTemplateCache()
  globalCacheInstance

proc getTemplate*(name: string): StructureTemplate =
  ## `get_template`
  get(globalCache(), name)

proc allTemplateNames*(): seq[string] =
  result = newSeqOfCap[string](TemplateBytesEntries.len)
  for i in 0 ..< TemplateBytesEntries.len:
    result.add(TemplateBytesEntries[i].name)

proc allStructureNames*(): seq[string] =
  structureAllNames()

proc allPoolNames*(): seq[string] =
  ## `_generated_all_pool_names`: the directories that hold templates, sorted as the `BTreeMap` has them.
  ensureIndexed()
  result = @[]
  for k in poolElements.keys:
    result.add(k)
  for a in 1 ..< result.len:
    let v = result[a]
    var b = a - 1
    while b >= 0 and result[b] > v:
      let moved = result[b]
      result[b + 1] = moved
      dec b
    result[b + 1] = v
