## A structure piece that places blocks from an NBT template.
## Port of pumpkin-world/src/generation/structure/template/template_piece.rs

{.feature: "lenientnils".}

import std/options
import ../structures/structuresmod
import ../../../../util/legacy_rand
import templatemod

type
  TemplatePiece* = ref object of StructurePieceBase
    templateData*: StructureTemplate
    rotation*: Rotation
    mirror*: Mirror

proc rotatedSize*(p: TemplatePiece): Vector3[int32] =
  transformSize(p.rotation, p.templateData.size)

proc transformLocal(p: TemplatePiece, localPos: Vector3[int32]): Vector3[int32] =
  let mirrored = transformPos(p.mirror, localPos, p.templateData.size)
  let rotated = transformPos(p.rotation, mirrored, p.templateData.size)
  vec3[int32](p.piece.boundingBox.min.x + rotated.x, p.piece.boundingBox.min.y + rotated.y,
    p.piece.boundingBox.min.z + rotated.z)

proc isStructureVoid(name: string): bool =
  name == "minecraft:structure_void" or name == "structure_void"

proc placeTemplatePiece(self: StructurePieceBase, chunk: ProtoChunk, blockRegistry: WorldPortalExt,
                        random: var RandomGenerator, seed: int64, chunkBox: BlockBox) {.nimcall.} =
  let p = cast[TemplatePiece](self)
  let boxLimit = p.piece.boundingBox
  let t = p.templateData
  for bi in 0 ..< t.blocks.len:
    let paletteEntry = t.palette[int(t.blocks[bi].state)]
    if isStructureVoid(paletteEntry.name):
      continue
    let (found, state) = resolve(paletteEntry, p.rotation, p.mirror)
    if not found:
      continue
    let worldPos = transformLocal(p, t.blocks[bi].pos)
    if not containsPos(boxLimit, worldPos) or not containsPos(chunkBox, worldPos):
      continue
    setBlockState(chunk, worldPos.x, worldPos.y, worldPos.z, state)
    let (hasEntityId, entityId) = getBlockEntityId(paletteEntry.name)
    if t.blocks[bi].hasNbt or hasEntityId:
      var placedNbt = newCompound()
      putString(placedNbt, "id", if hasEntityId: entityId else: paletteEntry.name)
      putInt(placedNbt, "x", worldPos.x)
      putInt(placedNbt, "y", worldPos.y)
      putInt(placedNbt, "z", worldPos.z)
      if t.blocks[bi].hasNbt:
        copyTemplateNbt(placedNbt, t.blocks[bi].nbt)
      if isSome(getString(placedNbt, "LootTable")) and isNone(getLong(placedNbt, "LootTableSeed")):
        var r = legacy_rand.fromSeed(cast[uint64](hashBlockPos(worldPos.x, worldPos.y, worldPos.z)))
        putLong(placedNbt, "LootTableSeed", nextI64(r))
      addBlockEntity(chunk, placedNbt)

proc newTemplatePiece*(t: StructureTemplate, rotation: Rotation, mirror: Mirror, origin: Vector3[int32],
                       pieceType: StructurePieceType): TemplatePiece =
  let rotated = transformSize(rotation, t.size)
  let boundingBox = newBlockBox(origin.x, origin.y, origin.z, origin.x + rotated.x - 1, origin.y + rotated.y - 1,
    origin.z + rotated.z - 1)
  TemplatePiece(piece: newStructurePiece(pieceType, boundingBox, 0), placeFn: placeTemplatePiece, templateData: t,
    rotation: rotation, mirror: mirror)

proc templatePieceWithChainLength*(t: StructureTemplate, rotation: Rotation, mirror: Mirror, origin: Vector3[int32],
                                   pieceType: StructurePieceType, chainLength: uint32): TemplatePiece =
  result = newTemplatePiece(t, rotation, mirror, origin, pieceType)
  result.piece.chainLength = chainLength
