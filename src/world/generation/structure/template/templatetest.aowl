## Upstream's tests of structure_template.rs, block_state_resolver.rs and processor.rs, with placement and generator checks
## of template/mod.rs, cache.rs and template_piece.rs, which have none.
## Port of pumpkin-world/src/generation/structure/template/processor.rs tests.

{.feature: "lenientnils".}

import std/assertions
import std/syncio
import ../../../blockstates
import ../../../../util/vector3
import ../../../../util/math/block_box
import ../../../../data/block_rotation
import ../../protochunkbase
import ../structures/structuresmod
import templatemod
import template_piece

block paletteEntryCreation:
  let entry = newPaletteEntry("minecraft:stone")
  assert entry.name == "minecraft:stone"
  assert entry.properties.len == 0
  let withProps = paletteEntryWithProperties("minecraft:oak_stairs", @[("facing", "north"), ("half", "bottom")])
  assert withProps.properties.len == 2

block paletteEntryFromStringForms:
  let a = paletteEntryFromString("minecraft:oak_log[axis=x,waterlogged=false]")
  assert a.name == "minecraft:oak_log"
  assert a.properties.len == 2 and a.properties[0][0] == "axis" and a.properties[1][1] == "false"
  assert paletteEntryFromString("minecraft:air").properties.len == 0

block resolveSimpleBlock:
  assert resolveSimple(newPaletteEntry("minecraft:stone"))[0]

block resolveWithProperties:
  let entry = paletteEntryWithProperties("minecraft:oak_stairs",
    @[("facing", "north"), ("half", "bottom"), ("shape", "straight"), ("waterlogged", "false")])
  assert resolveSimple(entry)[0]

block rotationTransformsFacing:
  let entry = paletteEntryWithProperties("minecraft:furnace", @[("facing", "north"), ("lit", "false")])
  let (found, rotated) = resolve(entry, Rotation.Clockwise90, Mirror.None)
  assert found
  var facing = ""
  for prop in stateProperties(rotated):
    if prop.name == "facing":
      facing = prop.value
  assert facing == "east", facing

block rotationKeysTransform:
  # A fence's connection follows the rotation.
  let entry = paletteEntryWithProperties("minecraft:oak_fence", @[("north", "true"), ("east", "false")])
  let (found, rotated) = resolve(entry, Rotation.Clockwise90, Mirror.None)
  assert found
  for prop in stateProperties(rotated):
    if prop.name == "east":
      assert prop.value == "true"

block unknownBlockReturnsNone:
  assert not resolveSimple(newPaletteEntry("minecraft:nonexistent_block"))[0]

block parsesAncientCityProcessorLists:
  assert loadProcessorList("minecraft:ancient_city_generic_degradation").len == 3
  assert loadProcessorList("minecraft:ancient_city_start_degradation").len == 2
  assert loadProcessorList("minecraft:ancient_city_walls_degradation").len == 3

block parsesStreetProcessorLists:
  assert loadProcessorList("minecraft:street_plains").len == 1
  assert loadProcessorList("minecraft:street_savanna").len == 1

block parsesTrailRuinsProcessorLists:
  assert loadProcessorList("minecraft:trail_ruins_houses_archaeology").len == 3

block parsesOutpostRotWithoutABlockFilter:
  let processors = loadProcessorList("minecraft:outpost_rot")
  assert processors.len == 1
  assert processors[0].kind == StructureProcessorKind.BlockRot and not processors[0].hasBlocks
  assert abs(processors[0].integrity - 0.05'f32) < 1.1920929e-7'f32

block templateCache:
  let t = getTemplate("igloo/top")
  assert t != nil
  assert t.size.x == 7 and t.size.y == 5 and t.size.z == 8, $t.size.x & "," & $t.size.y & "," & $t.size.z
  assert getTemplate("minecraft:igloo/top") == t
  assert getTemplate("does/not/exist") == nil
  assert allTemplateNames().len == 1202
  let (found, elements) = getPoolElements("minecraft:igloo")
  assert found and elements.len == 3
  assert not getTemplatePoolJson("minecraft:nope")[0]

block getBlockEntityIds:
  assert getBlockEntityId("minecraft:chest") == (true, "minecraft:chest")
  assert getBlockEntityId("minecraft:spruce_sign") == (true, "minecraft:sign")
  assert not getBlockEntityId("minecraft:stone")[0]

proc testChunk(): ProtoChunk =
  newProtoChunkRaw(0, 0, 1'u32, 0'i64, 384, -64)

block placeTemplateInBox:
  let c = testChunk()
  let t = getTemplate("igloo/top")
  let box = newBlockBox(0, -64, 0, 15, 319, 15)
  placeTemplateIn(c, t, vec3[int32](2, 70, 2), (0'i32, 0'i32), Rotation.None, false, false, box)
  var placed = 0
  for bi in 0 ..< t.blocks.len:
    let p = t.blocks[bi].pos
    let name = t.palette[int(t.blocks[bi].state)].name
    if name != "minecraft:structure_void" and name != "minecraft:structure_block" and name != "minecraft:jigsaw":
      let expected = resolve(t.palette[int(t.blocks[bi].state)], Rotation.None, Mirror.None)[1]
      assert getBlockState(c, vec3[int32](2 + p.x, 70 + p.y, 2 + p.z)) == expected, name
      inc placed
  assert placed > 0

block placeTemplateRespectsChunkBox:
  let c = testChunk()
  placeTemplateIn(c, getTemplate("igloo/top"), vec3[int32](2, 70, 2), (0'i32, 0'i32), Rotation.None, false, false,
    newBlockBox(0, 0, 0, 0, 0, 0))
  for x in 0'i32 .. 15'i32:
    for z in 0'i32 .. 15'i32:
      assert getBlockState(c, vec3[int32](x, 72, z)) == 0'u32

block templatePieceBounds:
  let t = getTemplate("igloo/top")
  let piece = newTemplatePiece(t, Rotation.Clockwise90, Mirror.None, vec3[int32](1, 2, 3), StructurePieceType.Igloo)
  let size = rotatedSize(piece)
  assert size.x == t.size.z and size.z == t.size.x
  assert piece.piece.boundingBox.max.x == 1 + t.size.z - 1

echo "template: ok"
