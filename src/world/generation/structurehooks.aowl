## Where proto_chunk.aowl calls into generation/feature and generation/structure, which another batch ports.
## Support module with no upstream file of its own.
##
## PARTIAL: pumpkin-world/src/generation/proto_chunk.rs - structure starts, structure references, structure pieces
## and placed features go through the hooks below. With the default `noStructureHooks` a step only advances the chunk's stage,
## so a chunk has no structures, no beardifier input and no features. That port's module replaces `structureHooks` at start-up.
##
## The hooks take what upstream's methods take. `generator` is `pointer` because `VanillaGenerator` sits above
## this file: cast it with `cast[VanillaGenerator](generator)`.

{.feature: "lenientnils".}

import ../../generated/structures
import ../../generated/placed_feature
import ../../util/math/block_box
import ../../util/random/random
import ../tick
import ../world
import protochunkbase

export structures, placed_feature

type
  BeardifierPieceJunction* = object
    ## `JigsawJunction`'s source position.
    sourceX*, sourceGroundY*, sourceZ*: int32

  BeardifierPiece* = object
    ## What `step_to_noise` reads of a structure piece through `get_structure_piece()` and the
    ## `PoolElementStructurePiece` downcast.
    boundingBox*: BlockBox
    isJigsaw*: bool                  ## The downcast succeeded.
    projectionRigid*: bool           ## `jigsaw_piece.projection == JigsawProjection::Rigid`
    groundLevelDelta*: int32
    junctions*: seq[BeardifierPieceJunction]

  StructureHooks* = ref object
    ## One value, set whole: a nil closure field cannot be tested (`f != nil` does not compile on one).
    setStructureStarts*: proc(chunk: ProtoChunk, generator: pointer) {.closure.}
      ## The body of `set_structure_starts`, without the stage change.
    setStructureReferences*: proc(chunk: ProtoChunk, generator: pointer) {.closure.}
      ## The body of `set_structure_references`, without the stage change.
    beardifierPieces*: proc(key: StructureKeys, instance: StructureInstance): seq[BeardifierPiece] {.closure.}
      ## `instance.collector.pieces` for one entry of `structure_starts`.
    generateStructureStep*: proc(cache: GenerationCache, registry: WorldPortalExt, step: int, populationSeed: uint64,
                                 worldSeed: int64) {.closure.}
      ## `ProtoChunk::generate_structure_step`
    generatePlacedFeature*: proc(feature: PlacedFeature, cache: GenerationCache, registry: WorldPortalExt, minY: int8,
                                 height: uint16, random: var RandomGenerator, origin: BlockPos) {.closure.}
      ## `PLACED_FEATURES.get(&feature_enum)` and `feature.generate(..)`.

proc noStructureHooks*(): StructureHooks =
  ## The default: every step only advances the stage. Built here because the compiler needs a module that
  ## declares a closure field to construct one too, or a caller elsewhere fails in C (see the report in PORTING's
  ## compiler notes).
  StructureHooks(
    setStructureStarts: proc(chunk: ProtoChunk, generator: pointer) {.closure.} = discard,
    setStructureReferences: proc(chunk: ProtoChunk, generator: pointer) {.closure.} = discard,
    beardifierPieces: proc(key: StructureKeys, instance: StructureInstance): seq[BeardifierPiece] {.closure.} = @[],
    generateStructureStep: proc(cache: GenerationCache, registry: WorldPortalExt, step: int, populationSeed: uint64,
                                worldSeed: int64) {.closure.} = discard,
    generatePlacedFeature: proc(feature: PlacedFeature, cache: GenerationCache, registry: WorldPortalExt, minY: int8,
                                height: uint16, random: var RandomGenerator, origin: BlockPos) {.closure.} = discard)

var structureHooks*: StructureHooks = noStructureHooks()
