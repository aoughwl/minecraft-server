## Badlands bands and pillars, and icebergs. Port of pumpkin-world/src/generation/surface/terrain.rs
##
## `thresholdNoises` is not upstream: `test_noise_threshold` builds a sampler for every block and marks that
## TODO. Building one is pure, so keeping them here changes nothing but the time it takes, and the builder is
## the one object every surface context shares.

{.feature: "lenientnils".}

import std/math
import ../../blockstates
import ../../../generated/noise_parameter
import ../../../util/xoroshiro128
import ../../../util/random/rustnum
import ../noise/doubleperlin
import ../noise/router
import ../noise/aquifer_sampler
import ../protochunkbase
import ../biomeweather

proc roundF64(x: cdouble): cdouble {.importc: "round", header: "<math.h>".}

type
  SurfaceTerrainBuilder* = ref object
    terracottaBands*: seq[blockstates.BlockStateId]
    terracottaBandsOffsetNoise*: DoublePerlinNoiseSampler
    badlandsPillarNoise*: DoublePerlinNoiseSampler
    badlandsSurfaceNoise*: DoublePerlinNoiseSampler
    badlandsPillarRoofNoise*: DoublePerlinNoiseSampler
    icebergPillarNoise*: DoublePerlinNoiseSampler
    icebergPillarRoofNoise*: DoublePerlinNoiseSampler
    icebergSurfaceNoise*: DoublePerlinNoiseSampler
    randomDeriver*: XoroshiroSplitter
    thresholdPresent*: seq[bool]
    thresholdNoises*: seq[DoublePerlinNoiseSampler]

let
  OrangeTerracotta = defaultStateByName("orange_terracotta")[1]
  YellowTerracotta = defaultStateByName("yellow_terracotta")[1]
  BrownTerracotta = defaultStateByName("brown_terracotta")[1]
  RedTerracotta = defaultStateByName("red_terracotta")[1]
  WhiteTerracotta = defaultStateByName("white_terracotta")[1]
  LightGrayTerracotta = defaultStateByName("light_gray_terracotta")[1]
  Terracotta = defaultStateByName("terracotta")[1]
  SnowBlock = defaultStateByName("snow_block")[1]
  PackedIce = defaultStateByName("packed_ice")[1]

proc addTerracottaBands(random: var Xoroshiro, terracottaBands: var seq[blockstates.BlockStateId], minBandSize: int32,
                        state: blockstates.BlockStateId) =
  let bandCount = nextInbetweenI32(random, 6'i32, 15'i32)
  var b = 0'i32
  while b < bandCount:
    let bandWidth = minBandSize + nextBoundedI32(random, 3'i32)
    let startIndex = nextBoundedI32(random, int32(terracottaBands.len))
    var m = 0'i32
    while m < bandWidth:
      if startIndex + m < int32(terracottaBands.len) and m < bandWidth:
        terracottaBands[int(startIndex + m)] = state
      else:
        break  # Stop if we reach the end of the array
      inc m
    inc b

proc createTerracottaBands(random: var Xoroshiro): seq[blockstates.BlockStateId] =
  var blockStates = newSeq[blockstates.BlockStateId](192)
  for i in 0 ..< blockStates.len:
    blockStates[i] = Terracotta

  var i = 0
  while i < blockStates.len:
    i += int(nextBoundedI32(random, 5'i32)) + 1
    if i >= blockStates.len:
      break
    blockStates[i] = OrangeTerracotta
    i += 1

  addTerracottaBands(random, blockStates, 1'i32, YellowTerracotta)
  addTerracottaBands(random, blockStates, 2'i32, BrownTerracotta)
  addTerracottaBands(random, blockStates, 1'i32, RedTerracotta)

  let bandCount = nextInbetweenI32(random, 9'i32, 15'i32)
  var currentBand = 0'i32
  var index = 0
  while currentBand < bandCount and index < blockStates.len:
    blockStates[index] = WhiteTerracotta
    if index > 1 and nextBool(random):
      blockStates[index - 1] = LightGrayTerracotta
    if index + 1 < blockStates.len and nextBool(random):
      blockStates[index + 1] = LightGrayTerracotta
    index += int(nextBoundedI32(random, 16'i32)) + 4
    currentBand += 1'i32
  blockStates

proc newSurfaceTerrainBuilder*(randomDeriver: XoroshiroSplitter): SurfaceTerrainBuilder =
  ## `SurfaceTerrainBuilder::new`
  var clayBands = splitString(randomDeriver, "minecraft:clay_bands")
  let bands = createTerracottaBands(clayBands)
  SurfaceTerrainBuilder(
    terracottaBands: bands,
    terracottaBandsOffsetNoise: getNoiseSamplerForId(randomDeriver, CLAY_BANDS_OFFSET),
    badlandsPillarNoise: getNoiseSamplerForId(randomDeriver, BADLANDS_PILLAR),
    badlandsSurfaceNoise: getNoiseSamplerForId(randomDeriver, BADLANDS_SURFACE),
    badlandsPillarRoofNoise: getNoiseSamplerForId(randomDeriver, BADLANDS_PILLAR_ROOF),
    icebergPillarNoise: getNoiseSamplerForId(randomDeriver, ICEBERG_PILLAR),
    icebergPillarRoofNoise: getNoiseSamplerForId(randomDeriver, ICEBERG_PILLAR_ROOF),
    icebergSurfaceNoise: getNoiseSamplerForId(randomDeriver, ICEBERG_SURFACE),
    randomDeriver: randomDeriver,
    thresholdPresent: newSeq[bool](NOISE_PARAMETER_COUNT),
    thresholdNoises: newSeq[DoublePerlinNoiseSampler](NOISE_PARAMETER_COUNT))

proc sampleThresholdNoise*(b: SurfaceTerrainBuilder, noiseId: int, x, y, z: float64): float64 =
  ## `get_noise_sampler_for_id(random_deriver, &condition.noise).sample(..)`, built once per noise.
  if not b.thresholdPresent[noiseId]:
    b.thresholdNoises[noiseId] = getNoiseSamplerForId(b.randomDeriver, NoiseParameters[noiseId])
    b.thresholdPresent[noiseId] = true
  sample(b.thresholdNoises[noiseId], x, y, z)

proc placeBadlandsPillar*(b: SurfaceTerrainBuilder, chunk: ProtoChunk, globalX, globalZ, surfaceY: int32) =
  let surfaceNoise = abs(sample(b.badlandsSurfaceNoise, float64(globalX), 0.0'f64, float64(globalZ)) * 8.25'f64)
  let pillarNoise = sample(b.badlandsPillarNoise, float64(globalX) * 0.2'f64, 0.0'f64, float64(globalZ) * 0.2'f64) * 15.0'f64
  let threshold = min(surfaceNoise, pillarNoise)
  if threshold > 0.0'f64:
    let pillarRoofNoise = abs(sample(b.badlandsPillarRoofNoise, float64(globalX) * 0.75'f64, 0.0'f64,
      float64(globalZ) * 0.75'f64) * 1.5'f64)
    let scaledThreshold = threshold * threshold * 2.5'f64
    let transformedRoof = ceil(pillarRoofNoise * 50.0'f64) + 24.0'f64
    let elevation = 64.0'f64 + min(scaledThreshold, transformedRoof)
    let elevationY = asI32(floor(elevation))
    if surfaceY <= elevationY:
      var y = elevationY
      while y >= int32(bottomY(chunk)):
        let blockId = blockIdOf(getBlockState(chunk, vec3[int32](globalX, y, globalZ)))
        if blockId == blockIdOf(chunk.defaultBlock):
          break
        if blockId == WaterBlockId:
          return
        dec y
      y = elevationY
      while y >= int32(bottomY(chunk)):
        if not blockstates.isAir(getBlockState(chunk, vec3[int32](globalX, y, globalZ))):
          break
        setBlockState(chunk, globalX, y, globalZ, chunk.defaultBlock)
        dec y

proc placeIceberg*(b: SurfaceTerrainBuilder, chunk: ProtoChunk, biomeId: uint8, x, z, estimatedSurfaceY, currentTopY,
                   seaLevel: int32, randomDeriver: XoroshiroSplitter) =
  let iceburgSurfaceNoise = abs(sample(b.icebergSurfaceNoise, float64(x), 0.0'f64, float64(z)) * 8.25'f64)
  let iceburgPillarNoise = sample(b.icebergPillarNoise, float64(x) * 1.28'f64, 0.0'f64, float64(z) * 1.28'f64) * 15.0'f64
  let threshold = min(iceburgSurfaceNoise, iceburgPillarNoise)
  if threshold > 1.8'f64:
    let iceburgPillarRoofNoise = abs(sample(b.icebergPillarRoofNoise, float64(x) * 1.17'f64, 0.0'f64,
      float64(z) * 1.17'f64) * 1.5'f64)
    let scaledThreshold = threshold * threshold * 1.2'f64
    let scaledRoofNoise = ceil(iceburgPillarRoofNoise * 40.0'f64) + 14.0'f64
    var blockThreshold = min(scaledThreshold, scaledRoofNoise)
    let temperature = computeBiomeTemperature(biomeId, float64(x), seaLevel, float64(z), seaLevel)
    if temperature > 0.1'f32:
      blockThreshold -= 2.0'f64
    var topBlock = 0'i32
    var bottomBlock = 0'i32
    if blockThreshold > 2.0'f64:
      let value = float64(seaLevel) - blockThreshold - 7.0'f64
      topBlock = asI32(blockThreshold) + seaLevel
      bottomBlock = asI32(value)
    var rand = splitPos(randomDeriver, x, 0'i32, z)
    let snowBlockCount = 2'i32 + nextBoundedI32(rand, 4'i32)
    let snowBottom = seaLevel + 18'i32 + nextBoundedI32(rand, 10'i32)
    var snowBlocks = 0'i32
    let topY = max(currentTopY, topBlock + 1'i32)
    var y = topY
    while y >= estimatedSurfaceY:
      let blockState = getBlockState(chunk, vec3[int32](x, y, z))
      if (blockstates.isAir(blockState) and y < topBlock and nextF64(rand) > 0.01'f64) or
          (blockIdOf(blockState) == WaterBlockId and y > bottomBlock and y < seaLevel and bottomBlock != 0'i32 and
            nextF64(rand) > 0.15'f64):
        if snowBlocks <= snowBlockCount and y > snowBottom:
          setBlockState(chunk, x, y, z, SnowBlock)
          snowBlocks += 1'i32
        else:
          setBlockState(chunk, x, y, z, PackedIce)
      dec y

proc getTerracottaBlock*(b: SurfaceTerrainBuilder, x, y, z: int32): blockstates.BlockStateId =
  let offset0 = asI32(float64(roundF64(cdouble(sample(b.terracottaBandsOffsetNoise, float64(x), 0.0'f64, float64(z)) * 4.0'f64))))
  let offset = y + offset0
  let n = uint64(b.terracottaBands.len)
  b.terracottaBands[int((cast[uint64](int64(offset)) + n) mod n)]
