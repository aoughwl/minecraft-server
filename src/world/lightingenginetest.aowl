## Generation-time lighting. Upstream has no tests for lighting/; these are known answers worked by
## hand from its rules: light falls by max(opacity, 1) a block, sky light at 15 falls straight down through
## transparent blocks.

import std/[syncio, assertions]
import ../config/lighting
import blockstates, palette, chunkdata, tick, lightingstorage, lightingengine

proc sid(name: string): uint32 =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc emptyChunk(x, z: int32, sections = 4): ChunkData =
  let c = newChunkData(x, z, newChunkSections(sections, 0'i32))
  c.lightEngine.skyLight = newSeq[LightContainer](sections)
  c.lightEngine.blockLight = newSeq[LightContainer](sections)
  for i in 0 ..< sections:
    c.lightEngine.skyLight[i] = newLightEmpty(0'u8)
    c.lightEngine.blockLight[i] = newLightEmpty(0'u8)
  c.heightmap = calculateHeightmap(c)
  c

proc gridOf(sections = 4): seq[ChunkData] =
  ## A 3x3 cache around chunk (0, 0), indexed `rel_x * 3 + rel_z`.
  result = newSeq[ChunkData](0)
  for x in -1'i32 .. 1'i32:
    for z in -1'i32 .. 1'i32:
      result.add(emptyChunk(x, z, sections))

proc testLightEngineBlockLight() =
  let chunks = gridOf()
  let center = chunks[4]
  center.setBlockAbsoluteY(8, 20'i32, 8, sid("glowstone"))  # luminance 15
  let cache = newLightCacheFromChunks(chunks, -1'i32, -1'i32, 3'i32)
  var e = newLightEngine()
  propagateBlockLight(e.blockLight, cache)
  assert getBlockLight(cache, blockPos(8, 20, 8)) == 15'u8
  assert getBlockLight(cache, blockPos(9, 20, 8)) == 14'u8
  assert getBlockLight(cache, blockPos(8, 21, 8)) == 14'u8
  assert getBlockLight(cache, blockPos(10, 21, 8)) == 12'u8
  assert getBlockLight(cache, blockPos(8, 20, 22)) == 1'u8      # 14 blocks away, across a chunk border
  assert getBlockLight(cache, blockPos(8, 20, 23)) == 0'u8
  assert getBlockLight(cache, blockPos(-3, 20, 8)) == 4'u8      # into the western neighbor
  assert center.dirty

  # An opaque block stops it: opacity 15 takes the level straight to 0, and light goes round.
  let walled = gridOf()
  walled[4].setBlockAbsoluteY(8, 20'i32, 8, sid("glowstone"))
  walled[4].setBlockAbsoluteY(8, 21'i32, 8, sid("stone"))
  let c2 = newLightCacheFromChunks(walled, -1'i32, -1'i32, 3'i32)
  var e2 = newLightEngine()
  propagateBlockLight(e2.blockLight, c2)
  assert getBlockLight(c2, blockPos(8, 21, 8)) == 0'u8
  assert getBlockLight(c2, blockPos(9, 21, 8)) == 13'u8
  assert getBlockLight(c2, blockPos(8, 22, 8)) == 11'u8

proc testLightEngineSkyLight() =
  let chunks = gridOf()
  let center = chunks[4]
  # A stone roof at y 10 over one column, and bare stone at y 0 elsewhere in the center chunk.
  center.setBlockAbsoluteY(5, 10'i32, 5, sid("stone"))
  center.heightmap = calculateHeightmap(center)
  let cache = newLightCacheFromChunks(chunks, -1'i32, -1'i32, 3'i32)
  var e = newLightEngine()
  convertLight(e.skyLight, cache)
  assert getSkyLight(cache, blockPos(0, 40, 0)) == 15'u8
  assert getSkyLight(cache, blockPos(5, 11, 5)) == 15'u8
  # In the shade directly under the roof, light comes in from the sides: 15 next door, 14 here.
  assert getSkyLight(cache, blockPos(5, 9, 5)) == 14'u8
  assert getSkyLight(cache, blockPos(5, 10, 5)) == 0'u8     # the opaque block itself
  assert getSkyLight(cache, blockPos(6, 9, 5)) == 15'u8

proc testLightEngineUpdates() =
  let chunks = gridOf()
  let center = chunks[4]
  let cache = newLightCacheFromChunks(chunks, -1'i32, -1'i32, 3'i32)
  var e = newLightEngine()
  updateBlockLight(e, cache, blockPos(8, 20, 8), 0'u8, 10'u8)
  runLightUpdates(e, cache)
  assert getBlockLight(cache, blockPos(8, 20, 8)) == 10'u8
  assert getBlockLight(cache, blockPos(9, 20, 8)) == 9'u8
  # Removing it darkens the neighbourhood.
  updateBlockLight(e, cache, blockPos(8, 20, 8), 10'u8, 0'u8)
  runLightUpdates(e, cache)
  assert getBlockLight(cache, blockPos(8, 20, 8)) == 0'u8
  assert getBlockLight(cache, blockPos(9, 20, 8)) == 0'u8
  assert getBlockLight(cache, blockPos(8, 25, 8)) == 0'u8
  assert center.lightEngine.blockLight.len == 4

  # Config gate and the stage gate in `initialize_light`.
  let c2 = gridOf()
  c2[4].setBlockAbsoluteY(8, 20'i32, 8, sid("glowstone"))
  let cache2 = newLightCacheFromChunks(c2, -1'i32, -1'i32, 3'i32)
  initializeLight(e, cache2, lecDark)
  assert getBlockLight(cache2, blockPos(8, 20, 8)) == 0'u8
  cache2.centerAtLightingStage = true
  initializeLight(e, cache2, lecDefault)
  assert getBlockLight(cache2, blockPos(8, 20, 8)) == 0'u8
  cache2.centerAtLightingStage = false
  initializeLight(e, cache2, lecDefault)
  assert getBlockLight(cache2, blockPos(8, 20, 8)) == 15'u8
  assert getSkyLight(cache2, blockPos(0, 40, 0)) == 15'u8

testLightEngineBlockLight()
testLightEngineSkyLight()
testLightEngineUpdates()
echo "lightingengine: all checks passed"
