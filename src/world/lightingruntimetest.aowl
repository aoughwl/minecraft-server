## Runtime lighting through a real `Level`, on hand-worked levels as in lightingenginetest.aowl.

import std/[syncio, assertions, cmdline, envvars]
import ../config/[chunk, lighting, world]
import ../generated/dimension as dimensiondata
import blockstates, palette, chunkdata, tick, level, worldfs, lightingruntime

proc sid(name: string): uint32 =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc scratch(name: string): string =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/level_scratch"
  result = base & "/" & name
  discard createDirAllW(result)

proc emptyChunk(x, z: int32, sections = 4): ChunkData =
  let c = newChunkData(x, z, newChunkSections(sections, 0'i32))
  c.lightEngine.skyLight = newSeq[LightContainer](sections)
  c.lightEngine.blockLight = newSeq[LightContainer](sections)
  for i in 0 ..< sections:
    c.lightEngine.skyLight[i] = newLightEmpty(0'u8)
    c.lightEngine.blockLight[i] = newLightEmpty(0'u8)
  c.heightmap = calculateHeightmap(c)
  c

proc testRuntime() =
  let l = fromRootFolder(defaultLevelConfig(), scratch("runtime"), 1'i64, OVERWORLD)
  let c = emptyChunk(0'i32, 0'i32, 24)
  addLoadedChunk(l, c)
  # Place a torch-like light source.
  discard setBlockState(l, blockPos(8, 64, 8), sid("glowstone"))
  c.dirty = false
  updateLightingAt(l, blockPos(8, 64, 8))
  assert getBlockLightLevel(l.lightAccess, blockPos(8, 64, 8)) == (true, 15'u8)
  assert getBlockLightLevel(l.lightAccess, blockPos(9, 64, 8)) == (true, 14'u8)
  assert getBlockLightLevel(l.lightAccess, blockPos(8, 64, 15)) == (true, 8'u8)
  assert c.dirty
  # An unloaded chunk has no level, and writes are dropped without spinning.
  assert getBlockLightLevel(l.lightAccess, blockPos(16, 64, 8))[0] == false
  assert getSkyLightLevel(l.lightAccess, blockPos(16, 64, 8)) == 0'u8

  # Removing it clears the light.
  discard setBlockState(l, blockPos(8, 64, 8), sid("air"))
  updateLightingAt(l, blockPos(8, 64, 8))
  assert getBlockLightLevel(l.lightAccess, blockPos(8, 64, 8)) == (true, 0'u8)
  assert getBlockLightLevel(l.lightAccess, blockPos(9, 64, 8)) == (true, 0'u8)

  # Sky: open air above gets 15, and a section index past the end answers 15.
  updateLightingAt(l, blockPos(2, 100, 2))
  assert getSkyLightLevel(l.lightAccess, blockPos(2, 100, 2)) == 15'u8
  assert getSkyLightLevel(l.lightAccess, blockPos(2, 99, 2)) == 15'u8
  assert getSkyLightLevel(l.lightAccess, blockPos(3, 100, 2)) == 14'u8
  assert getSkyLightLevel(l.lightAccess, blockPos(2, 500, 2)) == 15'u8

  # Lighting config short-circuits.
  var cfg = defaultLevelConfig()
  cfg.lighting = lecFull
  let full = fromRootFolder(cfg, scratch("runtimefull"), 1'i64, OVERWORLD)
  let fc = emptyChunk(0'i32, 0'i32, 24)
  addLoadedChunk(full, fc)
  updateLightingAt(full, blockPos(1, 1, 1))
  assert getBlockLightLevel(full.lightAccess, blockPos(1, 1, 1)) == (true, 15'u8)
  assert getSkyLightLevel(full.lightAccess, blockPos(1, 1, 1)) == 15'u8

testRuntime()
echo "lightingruntime: all checks passed"
