## Light get and set over a chunk cache. Port of pumpkin-world/src/lighting/storage.rs, and the module surface of
## pumpkin-world/src/lighting/mod.rs (the `LightEngine` and `DynamicLightEngine` re-exports are lightingengine.aowl
## and lightingruntime.aowl).
##
## `LightCache` is chunk_system's `Cache`. The two procs lighting reads it through keep its int32 arithmetic.

{.feature: "lenientnils".}

import ../util/vector3
import ../util/utillib
import chunkdata, blockstates, tick
import chunk_system/chunk_state

export chunk_state.Cache, chunk_state.light

type
  LightCache* = Cache

proc bottomY*(cache: LightCache): int32 {.inline.} = int32(bottomYOf(cache))
proc height*(cache: LightCache): int32 {.inline.} = int32(heightOf(cache))

proc centerAtLightingStage*(cache: LightCache): bool =
  ## `center_chunk.stage >= StagedChunkEnum::Lighting`. Upstream panics on a level center; a grid of level chunks is
  ## what `newLightCacheFromChunks` gives, to be lit.
  let mid = cache.chunks[midIndex(cache)]
  mid.kind == ChunkKind.Proto and mid.proto.stage >= StagedChunkEnum.Lighting

proc blockStateAt*(cache: LightCache, x, y, z: int32): BlockStateId {.inline.} =
  getBlockState(cache, vec3[int32](x, y, z))

proc getChunkIndex(cache: LightCache, chunkX, chunkZ: int32): int =
  let relX = chunkX - cache.x
  let relZ = chunkZ - cache.z
  if relX < 0'i32 or relX >= cache.size or relZ < 0'i32 or relZ >= cache.size:
    return -1
  int(relX * cache.size + relZ)

proc topYAt*(cache: LightCache, x, z: int32): int32 {.inline.} =
  ## `get_top_y(&HeightMap::WorldSurface, x, z)`. Upstream's index panics outside the grid, which a 3x3 write area
  ## around the lit chunk never reaches; a smaller grid reads as an empty column here.
  if getChunkIndex(cache, x shr 4, z shr 4) < 0:
    return bottomY(cache) - 1'i32
  getTopY(cache, WorldSurface, x, z)

proc getSectionY(cache: LightCache, posY: int32): int =
  if posY < bottomY(cache):
    return -1
  int((posY - bottomY(cache)) shr 4)

proc markDirty(cache: LightCache, idx: int) {.inline.} =
  if cache.chunks[idx].kind == ChunkKind.Level:
    cache.chunks[idx].level.dirty = true

proc getBlockLight*(cache: LightCache, pos: BlockPos): uint8 =
  ## `get_block_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return 0'u8
  let sectionY = getSectionY(cache, pos.y)
  let chunkLight = light(cache.chunks[idx])
  if sectionY < 0 or sectionY >= chunkLight.blockLight.len:
    return 0'u8
  chunkLight.blockLight[sectionY].get(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15))

proc setBlockLight*(cache: LightCache, pos: BlockPos, level: uint8) =
  ## `set_block_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return
  let sectionY = getSectionY(cache, pos.y)
  let chunkLight = light(cache.chunks[idx])
  if sectionY < 0 or sectionY >= chunkLight.blockLight.len:
    return
  chunkLight.blockLight[sectionY].set(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15), level)
  markDirty(cache, idx)

proc getSkyLight*(cache: LightCache, pos: BlockPos): uint8 =
  ## `get_sky_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return 0'u8
  let sectionY = getSectionY(cache, pos.y)
  let chunkLight = light(cache.chunks[idx])
  if sectionY < 0 or sectionY >= chunkLight.skyLight.len:
    return 0'u8
  chunkLight.skyLight[sectionY].get(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15))

proc setSkyLight*(cache: LightCache, pos: BlockPos, level: uint8) =
  ## `set_sky_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return
  let sectionY = getSectionY(cache, pos.y)
  let chunkLight = light(cache.chunks[idx])
  if sectionY < 0 or sectionY >= chunkLight.skyLight.len:
    return
  chunkLight.skyLight[sectionY].set(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15), level)
  markDirty(cache, idx)

proc newLightCacheFromChunks*(chunks: seq[ChunkData], x, z, size: int32): LightCache =
  ## A grid of level chunks, `chunks[rel_x * size + rel_z]`.
  result = newCache(x, z, size)
  for i in 0 ..< chunks.len:
    result.chunks.add(levelChunk(chunks[i]))
