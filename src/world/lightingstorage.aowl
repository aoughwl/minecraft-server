## Light get and set over a chunk cache. Port of pumpkin-world/src/lighting/storage.rs, and the
## module surface of pumpkin-world/src/lighting/mod.rs.
##
## PARTIAL: pumpkin-world/src/lighting/storage.rs - upstream reads `chunk_system::generation_cache::Cache`,
## which the chunk-system batch has not ported. `LightCache` is the part of it lighting uses: the chunk
## grid with each chunk's `ChunkLight`, block lookup and top height. That batch can build one from its
## `Cache`; `Chunk::Proto` and `Chunk::Level` become an entry with or without `dirtyChunk`.
## PARTIAL: pumpkin-world/src/lighting/mod.rs - the `LightEngine` and `DynamicLightEngine` re-exports are
## lightingengine.aowl and lightingruntime.aowl.

{.feature: "lenientnils".}

import chunkdata, blockstates, tick

type
  LightCacheChunk* = object
    light*: ChunkLight
    dirtyChunk*: ChunkData  ## `Chunk::Level`'s chunk, marked dirty on a light write; nil for proto.

  LightCache* = ref object
    x*, z*, size*: int32
    bottomY*, height*: int32
    chunks*: seq[LightCacheChunk]   ## Indexed `rel_x * size + rel_z`.
    getBlockState*: proc(x, y, z: int32): BlockStateId {.closure.}
    getTopY*: proc(x, z: int32): int32 {.closure.}  ## `get_top_y(&HeightMap::WorldSurface, x, z)`
    centerAtLightingStage*: bool  ## `center_chunk.stage >= StagedChunkEnum::Lighting`

proc blockStateAt*(cache: LightCache, x, y, z: int32): BlockStateId {.inline.} =
  ## Through a local; see the note in chunkio.aowl.
  let f = cache.getBlockState
  f(x, y, z)

proc topYAt*(cache: LightCache, x, z: int32): int32 {.inline.} =
  let f = cache.getTopY
  f(x, z)

proc getChunkIndex(cache: LightCache, chunkX, chunkZ: int32): int =
  let relX = chunkX - cache.x
  let relZ = chunkZ - cache.z
  if relX < 0'i32 or relX >= cache.size or relZ < 0'i32 or relZ >= cache.size:
    return -1
  int(relX * cache.size + relZ)

proc getSectionY(cache: LightCache, posY: int32): int =
  if posY < cache.bottomY:
    return -1
  int((posY - cache.bottomY) shr 4)

proc getBlockLight*(cache: LightCache, pos: BlockPos): uint8 =
  ## `get_block_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return 0'u8
  let sectionY = getSectionY(cache, pos.y)
  if sectionY < 0 or sectionY >= cache.chunks[idx].light.blockLight.len:
    return 0'u8
  cache.chunks[idx].light.blockLight[sectionY].get(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15))

proc setBlockLight*(cache: LightCache, pos: BlockPos, level: uint8) =
  ## `set_block_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return
  let sectionY = getSectionY(cache, pos.y)
  if sectionY < 0 or sectionY >= cache.chunks[idx].light.blockLight.len:
    return
  cache.chunks[idx].light.blockLight[sectionY].set(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15), level)
  if cache.chunks[idx].dirtyChunk != nil:
    cache.chunks[idx].dirtyChunk.dirty = true

proc getSkyLight*(cache: LightCache, pos: BlockPos): uint8 =
  ## `get_sky_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return 0'u8
  let sectionY = getSectionY(cache, pos.y)
  if sectionY < 0 or sectionY >= cache.chunks[idx].light.skyLight.len:
    return 0'u8
  cache.chunks[idx].light.skyLight[sectionY].get(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15))

proc setSkyLight*(cache: LightCache, pos: BlockPos, level: uint8) =
  ## `set_sky_light`
  let idx = getChunkIndex(cache, pos.x shr 4, pos.z shr 4)
  if idx < 0:
    return
  let sectionY = getSectionY(cache, pos.y)
  if sectionY < 0 or sectionY >= cache.chunks[idx].light.skyLight.len:
    return
  cache.chunks[idx].light.skyLight[sectionY].set(int(pos.x and 15), int(pos.y and 15), int(pos.z and 15), level)
  if cache.chunks[idx].dirtyChunk != nil:
    cache.chunks[idx].dirtyChunk.dirty = true

proc newLightCacheFromChunks*(chunks: seq[ChunkData], x, z, size: int32): LightCache =
  ## A grid of level chunks, `chunks[rel_x * size + rel_z]`, as `Cache` holds `Chunk::Level` entries.
  let first = chunks[0]
  var entries = newSeq[LightCacheChunk](chunks.len)
  for i in 0 ..< chunks.len:
    entries[i] = LightCacheChunk(light: chunks[i].lightEngine, dirtyChunk: chunks[i])
  LightCache(x: x, z: z, size: size, bottomY: first.section.minY, height: int32(first.section.count) * 16'i32,
    chunks: entries, centerAtLightingStage: false,
    getBlockState: proc(px, py, pz: int32): BlockStateId {.closure.} =
      let dx = (px shr 4) - x
      let dz = (pz shr 4) - z
      if not (dx < size and dz < size and dx >= 0'i32 and dz >= 0'i32):
        return 0'u32
      let c = chunks[int(dx * size + dz)]
      let (ok, id) = getBlockAbsoluteY(c.section, int(px and 15), py, int(pz and 15))
      if ok: id else: 0'u32,
    getTopY: proc(px, pz: int32): int32 {.closure.} =
      let dx = (px shr 4) - x
      let dz = (pz shr 4) - z
      if not (dx < size and dz < size and dx >= 0'i32 and dz >= 0'i32):
        return first.section.minY - 1'i32
      let c = chunks[int(dx * size + dz)]
      getHeightmap(c.heightmap, chmWorldSurface, px, pz, c.section.minY))
