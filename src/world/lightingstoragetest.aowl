## Light get and set over a chunk grid: storage.rs's bounds behaviour and index arithmetic.
import std/[syncio, assertions]
import chunkdata, tick, lightingstorage

proc emptyChunk(x, z: int32): ChunkData =
  let c = newChunkData(x, z, newChunkSections(2, -64'i32))
  c.lightEngine.skyLight = @[newLightEmpty(0'u8), newLightEmpty(0'u8)]
  c.lightEngine.blockLight = @[newLightEmpty(0'u8), newLightEmpty(0'u8)]
  c

proc main() =
  # chunks[rel_x * size + rel_z]: (0, 1) is index 1, (1, 0) is index 2.
  let chunks = @[emptyChunk(0'i32, 0'i32), emptyChunk(0'i32, 1'i32), emptyChunk(1'i32, 0'i32), emptyChunk(1'i32, 1'i32)]
  let cache = newLightCacheFromChunks(chunks, 0'i32, 0'i32, 2'i32)
  assert cache.bottomY == -64'i32 and cache.height == 32'i32

  setBlockLight(cache, blockPos(1, -60, 17), 9'u8)  # chunk (0, 1), section 0
  assert getBlockLight(cache, blockPos(1, -60, 17)) == 9'u8
  assert chunks[1].lightEngine.blockLight[0].get(1, 4, 1) == 9'u8
  assert chunks[1].dirty and not chunks[0].dirty

  setSkyLight(cache, blockPos(16, -40, 0), 4'u8)    # chunk (1, 0), section 1, local y 8
  assert getSkyLight(cache, blockPos(16, -40, 0)) == 4'u8
  assert chunks[2].lightEngine.skyLight[1].get(0, 8, 0) == 4'u8

  # Outside the grid, below the world and above the sections read 0, and writes vanish.
  assert getBlockLight(cache, blockPos(-1, -60, 0)) == 0'u8
  assert getBlockLight(cache, blockPos(0, -65, 0)) == 0'u8
  assert getBlockLight(cache, blockPos(0, 100, 0)) == 0'u8
  setBlockLight(cache, blockPos(32, -60, 0), 9'u8)
  setSkyLight(cache, blockPos(0, 100, 0), 9'u8)
  assert getSkyLight(cache, blockPos(0, 100, 0)) == 0'u8

  # The state and height lookups a level-chunk cache answers.
  discard setBlockAbsoluteY(chunks[3].section, 2, -50'i32, 3, 1'u32)
  assert blockStateAt(cache, 18'i32, -50'i32, 19'i32) == 1'u32
  assert blockStateAt(cache, -1'i32, -50'i32, 0'i32) == 0'u32
  setHeightmap(chunks[3].heightmap, chmWorldSurface, 2'i32, 3'i32, -50'i32, -64'i32)
  assert topYAt(cache, 18'i32, 19'i32) == -50'i32
  assert topYAt(cache, 99'i32, 0'i32) == -65'i32

main()
echo "lighting storage: all checks passed"
