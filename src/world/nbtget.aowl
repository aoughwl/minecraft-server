## Typed compound getters and putters over src/nbt/tag.aowl: upstream's `NbtCompound::get_int`,
## `put_int` and friends. A getter answers `(false, _)` when the tag is absent or has another type.
## A local helper with `nbt`-prefixed names, since src/nbt is another agent's and may grow its own.

import ../nbt/tag

proc nbtByte*(c: NbtCompound, name: string): (bool, int8) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkByte: (true, t.byteVal) else: (false, 0'i8)

proc nbtShort*(c: NbtCompound, name: string): (bool, int16) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkShort: (true, t.shortVal) else: (false, 0'i16)

proc nbtInt*(c: NbtCompound, name: string): (bool, int32) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkInt: (true, t.intVal) else: (false, 0'i32)

proc nbtLong*(c: NbtCompound, name: string): (bool, int64) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkLong: (true, t.longVal) else: (false, 0'i64)

proc nbtFloat*(c: NbtCompound, name: string): (bool, float32) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkFloat: (true, t.floatVal) else: (false, 0.0'f32)

proc nbtDouble*(c: NbtCompound, name: string): (bool, float64) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkDouble: (true, t.doubleVal) else: (false, 0.0'f64)

proc nbtBool*(c: NbtCompound, name: string): (bool, bool) =
  ## `NbtCompound::get_bool`: a byte, non-zero is true.
  let (found, t) = get(c, name)
  if found and t.kind == ntkByte: (true, t.byteVal != 0'i8) else: (false, false)

proc nbtString*(c: NbtCompound, name: string): (bool, string) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkString: (true, t.stringVal) else: (false, "")

proc nbtCompound*(c: NbtCompound, name: string): (bool, NbtCompound) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkCompound: (true, t.compoundVal) else: (false, newCompound())

proc nbtList*(c: NbtCompound, name: string): (bool, seq[NbtTag]) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkList: (true, t.listVal) else: (false, newSeq[NbtTag](0))

proc nbtLongArray*(c: NbtCompound, name: string): (bool, seq[int64]) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkLongArray: (true, t.longArrayVal) else: (false, newSeq[int64](0))

proc nbtIntArray*(c: NbtCompound, name: string): (bool, seq[int32]) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkIntArray: (true, t.intArrayVal) else: (false, newSeq[int32](0))

proc nbtByteArray*(c: NbtCompound, name: string): (bool, seq[int8]) =
  let (found, t) = get(c, name)
  if found and t.kind == ntkByteArray: (true, t.byteArrayVal) else: (false, newSeq[int8](0))

proc byteTag*(v: int8): NbtTag = NbtTag(kind: ntkByte, byteVal: v)
proc boolTag*(v: bool): NbtTag = NbtTag(kind: ntkByte, byteVal: (if v: 1'i8 else: 0'i8))
proc intTag*(v: int32): NbtTag = NbtTag(kind: ntkInt, intVal: v)
proc longTag*(v: int64): NbtTag = NbtTag(kind: ntkLong, longVal: v)
proc floatTag*(v: float32): NbtTag = NbtTag(kind: ntkFloat, floatVal: v)
proc doubleTag*(v: float64): NbtTag = NbtTag(kind: ntkDouble, doubleVal: v)
proc stringTag*(v: string): NbtTag = NbtTag(kind: ntkString, stringVal: v)
proc compoundTag*(v: NbtCompound): NbtTag = NbtTag(kind: ntkCompound, compoundVal: v)
proc listTag*(v: seq[NbtTag]): NbtTag = NbtTag(kind: ntkList, listVal: v)
proc longArrayTag*(v: seq[int64]): NbtTag = NbtTag(kind: ntkLongArray, longArrayVal: v)
proc intArrayTag*(v: seq[int32]): NbtTag = NbtTag(kind: ntkIntArray, intArrayVal: v)
proc byteArrayTag*(v: seq[int8]): NbtTag = NbtTag(kind: ntkByteArray, byteArrayVal: v)

proc stringListTag*(v: seq[string]): NbtTag =
  var l = newSeq[NbtTag](0)
  for s in v:
    l.add(stringTag(s))
  listTag(l)

proc stringList*(c: NbtCompound, name: string): seq[string] =
  ## The strings of a list tag; a missing or wrong-typed tag gives an empty list.
  result = newSeq[string](0)
  let (ok, l) = nbtList(c, name)
  if ok:
    for t in l:
      if t.kind == ntkString:
        result.add(t.stringVal)
