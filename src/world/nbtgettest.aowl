## Typed getters: a value of the right type, and absent or wrong-typed both answer false.
import std/[syncio, assertions]
import ../nbt/tag
import nbtget

proc main() =
  var c = newCompound()
  put(c, "b", byteTag(-1'i8))
  put(c, "t", boolTag(true))
  put(c, "i", intTag(7'i32))
  put(c, "l", longTag(8'i64))
  put(c, "f", floatTag(0.5'f32))
  put(c, "d", doubleTag(0.25'f64))
  put(c, "s", stringTag("x"))
  put(c, "c", compoundTag(newCompound()))
  put(c, "ls", stringListTag(@["p", "q"]))
  put(c, "la", longArrayTag(@[1'i64]))
  put(c, "ia", intArrayTag(@[2'i32]))
  put(c, "ba", byteArrayTag(@[3'i8]))
  assert nbtByte(c, "b") == (true, -1'i8)
  assert nbtBool(c, "t") == (true, true) and nbtBool(c, "b") == (true, true)
  assert nbtInt(c, "i") == (true, 7'i32)
  assert nbtLong(c, "l") == (true, 8'i64)
  assert nbtFloat(c, "f") == (true, 0.5'f32)
  assert nbtDouble(c, "d") == (true, 0.25'f64)
  assert nbtString(c, "s") == (true, "x")
  assert nbtCompound(c, "c")[0]
  assert stringList(c, "ls") == @["p", "q"]
  assert nbtLongArray(c, "la")[1] == @[1'i64]
  assert nbtIntArray(c, "ia")[1] == @[2'i32]
  assert nbtByteArray(c, "ba")[1] == @[3'i8]
  # Upstream's getters do not coerce.
  assert not nbtInt(c, "b")[0] and not nbtLong(c, "i")[0] and not nbtString(c, "i")[0]
  assert not nbtInt(c, "missing")[0] and not nbtList(c, "i")[0]
  assert stringList(c, "i").len == 0

main()
echo "nbtget: all checks passed"
