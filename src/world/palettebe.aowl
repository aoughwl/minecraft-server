## `BlockPalette::convert_be_network` and `BiomePalette::convert_be_network` with the generated id tables, as
## pumpkin-world/src/chunk/palette.rs has them: `BlockState::to_be_network_id` and `Biome::be_network_id`.
## Its own module: block_properties and biome export names palette.aowl already uses.

import palette
from ../generated/block_properties import toBeNetworkId, newBlockStateIdOrAir
from ../generated/biome import ALL

proc blockBeNetworkId(v: uint32): uint32 =
  ## `BlockState::to_be_network_id`
  uint32(toBeNetworkId(newBlockStateIdOrAir(uint16(v))))

proc biomeBeNetworkId(v: uint32): uint32 =
  ## `Biome::from_id(id).map_or(1, |b| b.be_network_id)`
  if v < uint32(ALL.len): uint32(ALL[int(v)].beNetworkId) else: 1'u32

proc blockConvertBeNetwork*(p: BlockPalette): BeNetworkSerialization =
  blockConvertBeNetwork(p, blockBeNetworkId)

proc biomeConvertBeNetwork*(p: BiomePalette): BeNetworkSerialization =
  biomeConvertBeNetwork(p, biomeBeNetworkId)
