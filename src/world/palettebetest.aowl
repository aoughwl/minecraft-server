## `convert_be_network` through the generated Bedrock id tables: the palette's ids are state ids and biome ids, and the
## serialization carries what `BlockState::to_be_network_id` and `Biome::be_network_id` say for them.

import std/[syncio, assertions]
import palette, palettebe
from ../generated/block_properties import toBeNetworkId, newBlockStateIdOrAir
from ../generated/biome import ALL

proc bid(id: uint32): uint32 = uint32(toBeNetworkId(newBlockStateIdOrAir(uint16(id))))

block homogeneousBiome:
  let p = newBiomePalette()
  let r = biomeConvertBeNetwork(p)
  assert r.bitsPerEntry == 0'u8
  assert r.value == uint32(ALL[0].beNetworkId)

block homogeneousBlock:
  let p = newBlockPalette()
  let r = blockConvertBeNetwork(p)
  assert r.bitsPerEntry == 0'u8
  assert r.value == bid(0'u32)

block mixedBlock:
  var p = newBlockPalette()
  let stone = 1'u32  # state 1: stone, the first state after air
  discard p.set(0, 0, 0, stone)
  let r = blockConvertBeNetwork(p)
  assert r.values.len == 2
  # The palette's order is its own (the new value goes first); the set of mapped ids is what is fixed.
  assert (r.values[0] == bid(0'u32) and r.values[1] == bid(stone)) or (r.values[1] == bid(0'u32) and r.values[0] == bid(stone))
  assert r.values[0] != r.values[1]
  assert r.bitsPerEntry >= 1'u8

block mixedBiome:
  var p = newBiomePalette()
  discard p.set(0, 0, 0, 3'u32)
  let r = biomeConvertBeNetwork(p)
  assert r.values.len == 2
  let a = uint32(ALL[0].beNetworkId)
  let b = uint32(ALL[3].beNetworkId)
  assert (r.values[0] == a and r.values[1] == b) or (r.values[0] == b and r.values[1] == a)

echo "palettebe: all checks passed"
