## Smoke test for palette.aowl, run via `aowlmony c -r src/world/palettetest.aowl`.
import std/assertions
import std/syncio
import palette

# 16x16x16 block section, default-filled with "air" (id 0).
var p = newPalettedContainer(16, 0'u32)
assert p.paletteSize == 1
assert p.isSingleValued

# Fill every cell with distinct values to force an Indexed->Dense upgrade
# past 255 distinct palette entries (16^3 = 4096 cells > 255).
var expect = newSeq[uint32](16 * 16 * 16)
var n = 0
for y in 0 ..< 16:
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      let v = uint32(n mod 300)  # cycle through 300 distinct ids > 255
      discard p.set(x, y, z, v)
      expect[(y * 16 + z) * 16 + x] = v
      inc n

for y in 0 ..< 16:
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      assert p.get(x, y, z) == expect[(y * 16 + z) * 16 + x]

assert not p.isSingleValued
assert p.paletteSize == 300

# Overwrite everything back to a single value; palette should shrink to 1
# (exercises the swap-remove-on-zero-count path many, many times).
for y in 0 ..< 16:
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      discard p.set(x, y, z, 7'u32)

for y in 0 ..< 16:
  for z in 0 ..< 16:
    for x in 0 ..< 16:
      assert p.get(x, y, z) == 7'u32

assert p.isSingleValued
assert p.paletteSize == 1

# Small biome section (4x4x4), stays in Indexed form the whole time.
var b = newPalettedContainer(4, 1'u32)
discard b.set(1, 2, 3, 5'u32)
assert b.get(1, 2, 3) == 5'u32
assert b.get(0, 0, 0) == 1'u32
assert b.paletteSize == 2

echo "palette.aowl: all checks passed"

# --- upstream's #[test] vectors and known-answer packing ------------------------------------

import blockstates

proc sid(name: string): uint32 =
  let (ok, id) = defaultStateByName(name)
  assert ok, name
  id

proc assertBulkMatchesMutations(valueAt: proc(x, y, z: int): uint32 {.closure.}) =
  ## Upstream's `assert_bulk_matches_mutations`.
  var mutated = newBlockPalette()
  for y in 0 ..< 16:
    for z in 0 ..< 16:
      for x in 0 ..< 16:
        discard mutated.set(x, y, z, valueAt(x, y, z))
  let bulk = fromFn(16, valueAt)
  assert cells(mutated) == cells(bulk)
  assert randomTickingCounts(mutated) == randomTickingCounts(bulk)
  assert nonAirBlockCount(mutated) == nonAirBlockCount(bulk)
  assert liquidBlockCount(mutated) == liquidBlockCount(bulk)
  let mn = blockConvertNetwork(mutated)
  let bn = blockConvertNetwork(bulk)
  assert mn.bitsPerEntry == bn.bitsPerEntry
  assert mn.paletteKind == bn.paletteKind

proc bulkPaletteMatchesIndividualMutations() =
  let states = [sid("air"), sid("stone"), sid("water"), sid("lava")]
  assertBulkMatchesMutations(proc(x, y, z: int): uint32 {.closure.} = states[(x + y + z) mod states.len])

proc bulkPaletteHandlesHomogeneousSections() =
  let stone = sid("stone")
  assertBulkMatchesMutations(proc(x, y, z: int): uint32 {.closure.} = stone)

proc bulkPaletteHandlesDirectNetworkPalettes() =
  assertBulkMatchesMutations(proc(x, y, z: int): uint32 {.closure.} = stateIdOrAir(uint32((y * 256 + z * 16 + x) mod 300)))

bulkPaletteMatchesIndividualMutations()
bulkPaletteHandlesHomogeneousSections()
bulkPaletteHandlesDirectNetworkPalettes()

# encompassing_bits: 1 -> 1, 2 -> 1, 3 -> 2, 4 -> 2, 5 -> 3, 16 -> 4, 17 -> 5
assert encompassingBits(1) == 1'u8 and encompassingBits(2) == 1'u8 and encompassingBits(3) == 2'u8
assert encompassingBits(4) == 2'u8 and encompassingBits(5) == 3'u8
assert encompassingBits(16) == 4'u8 and encompassingBits(17) == 5'u8

block diskPacking:
  # One stone at (1, 0, 0) in an air section, and the bits must land where vanilla reads them:
  # four bits per entry, 16 entries per long, first cell in the low bits.
  var s = newBlockPalette()
  let stone = sid("stone")
  assert s.isEmpty and s.hasOnlyAir
  discard s.set(1, 0, 0, stone)
  assert not s.isEmpty and not s.hasOnlyAir
  let nbt = blockToDiskNbt(s)
  assert nbt.palette == @[0'u32, stone]   # from_cube keeps first-appearance order
  assert nbt.data.len == 256               # 4096 cells / 16 per long
  assert nbt.data[0] == 0x10'i64
  for i in 1 ..< nbt.data.len:
    assert nbt.data[i] == 0'i64
  assert nonAirBlockCount(s) == 1'u16
  let back = blockFromDiskNbt(nbt)
  assert back.get(1, 0, 0) == stone and back.get(0, 0, 0) == 0'u32
  assert nonAirBlockCount(back) == 1'u16

  # Going back to one value collapses to the homogeneous form.
  discard s.set(1, 0, 0, 0'u32)
  assert s.isEmpty and s.isSingleValued
  let empty = blockToDiskNbt(s)
  assert empty.palette == @[0'u32] and empty.data.len == 0

block fiveBitWidth:
  # 17 palette entries pack at 5 bits, 12 to a long, with the top four bits of each long unused.
  var s = newBlockPalette()
  for i in 0 ..< 17:
    discard s.set(i mod 16, 0, i div 16, uint32(i + 1))
  let (palette, packed) = toPaletteAndPackedData(s, max(bitsPerEntry(s), BlockDiskMinBits))
  assert palette.len == 18 and bitsPerEntry(s) == 5'u8
  assert packed.len == (4096 + 11) div 12
  let roundTrip = fromPaletteAndPackedData(16, palette, packed, BlockDiskMinBits)
  assert cells(roundTrip) == cells(s)

block network:
  let air = newBlockPalette()
  let single = blockConvertNetwork(air)
  assert single.paletteKind == npSingle and single.bitsPerEntry == 0'u8 and single.packedData.len == 0

  # Two values use the 4-bit minimum map width and the same packing as disk.
  var two = newBlockPalette()
  discard two.set(1, 0, 0, 5'u32)
  let indirect = blockConvertNetwork(two)
  assert indirect.paletteKind == npIndirect and indirect.bitsPerEntry == 4'u8
  assert indirect.values == @[0'u32, 5'u32] and indirect.packedData[0] == 0x10'i64

  # Past 8 bits of map, ids go direct at 15 bits: four to a long.
  let many = fromFn(16, proc(x, y, z: int): uint32 {.closure.} = uint32((y * 256 + z * 16 + x) mod 300))
  let direct = blockConvertNetwork(many)
  assert direct.paletteKind == npDirect and direct.bitsPerEntry == 15'u8
  assert direct.packedData.len == 1024
  assert direct.packedData[0] == ((1'i64 shl 15) or (2'i64 shl 30) or (3'i64 shl 45))

  # A biome palette past 3 bits goes direct at 7 bits; below, the minimum is 1 bit.
  let biomes = fromFn(4, proc(x, y, z: int): uint32 {.closure.} = uint32(x + z * 4))
  let bd = biomeConvertNetwork(biomes)
  assert bd.paletteKind == npDirect and bd.bitsPerEntry == 7'u8
  let twoBiomes = fromFn(4, proc(x, y, z: int): uint32 {.closure.} = uint32(x mod 2))
  let bi = biomeConvertNetwork(twoBiomes)
  assert bi.paletteKind == npIndirect and bi.bitsPerEntry == 1'u8

block bedrock:
  var two = newBlockPalette()
  discard two.set(1, 2, 3, 5'u32)
  let be = blockConvertBeNetwork(two, proc(v: uint32): uint32 {.closure.} = v + 100'u32)
  assert be.paletteKind == npIndirect and be.values.len == 2 and be.values[1] == 105'u32 or be.values[0] == 105'u32
  assert be.bitsPerEntry == 1'u8
  assert be.packedData.len == 128  # 4096 / 32
  let single = blockConvertBeNetwork(newBlockPalette(), proc(v: uint32): uint32 {.closure.} = v + 7'u32)
  assert single.paletteKind == npSingle and single.value == 7'u32

block randomTicks:
  var s = newBlockPalette()
  assert randomTickingCounts(s) == (0'u16, 0'u16)
  discard s.set(0, 0, 0, sid("lava"))
  discard s.set(1, 0, 0, sid("wheat"))
  assert randomTickingCounts(s)[1] == 1'u16
  assert randomTickingCounts(s)[0] >= 1'u16
  assert liquidBlockCount(s) == 1'u16

echo "palette.aowl: upstream vectors passed"
