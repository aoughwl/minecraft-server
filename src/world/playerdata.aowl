## Player data on disk. Port of pumpkin-world/src/data/player_data.rs, and the module surface of
## pumpkin-world/src/data/mod.rs
##
## Upstream takes a `Uuid`; here it is the hyphenated string its `Display` prints, since src/util has no
## UUID type yet. Upstream logs on error; here a failure is returned in the result only.

import ../nbt/tag
import worldfs, worldinfodatafiles

type
  PlayerDataErrorKind* = enum
    pdeIo
    pdeNbt

  PlayerDataError* = object
    kind*: PlayerDataErrorKind
    msg*: string

  PlayerDataStorage* = object
    dataPath: string
    saveEnabled: bool

  PlayerDataLoad* = object
    ok*: bool
    found*: bool
    nbt*: NbtCompound
    error*: PlayerDataError

proc newPlayerDataStorage*(dataPath: string, enabled: bool): PlayerDataStorage =
  ## `PlayerDataStorage::new`
  discard createDirAllW(dataPath)
  PlayerDataStorage(dataPath: dataPath, saveEnabled: enabled)

proc getDataPath*(s: PlayerDataStorage): string {.inline.} = s.dataPath
proc isSaveEnabled*(s: PlayerDataStorage): bool {.inline.} = s.saveEnabled
proc setSaveEnabled*(s: var PlayerDataStorage, enabled: bool) {.inline.} = s.saveEnabled = enabled

proc getPlayerDataPath*(s: PlayerDataStorage, uuid: string): string =
  ## `PlayerDataStorage::get_player_data_path`
  joinPathW(s.dataPath, uuid & ".dat")

proc loadPlayerData*(s: PlayerDataStorage, uuid: string): PlayerDataLoad =
  ## `PlayerDataStorage::load_player_data`
  let none = PlayerDataError(kind: pdeIo, msg: "")
  if not s.saveEnabled:
    return PlayerDataLoad(ok: true, found: false, nbt: newCompound(), error: none)
  let (status, bytes) = readFileBytes(getPlayerDataPath(s, uuid))
  if status != rsOk:
    return PlayerDataLoad(ok: true, found: false, nbt: newCompound(), error: none)
  let (ok, nbt, msg) = readGzipCompound(bytes)
  if not ok:
    return PlayerDataLoad(ok: false, found: false, nbt: newCompound(), error: PlayerDataError(kind: pdeNbt, msg: msg))
  PlayerDataLoad(ok: true, found: true, nbt: nbt, error: none)

proc savePlayerData*(s: PlayerDataStorage, uuid: string, data: NbtCompound): (bool, PlayerDataError) =
  ## `PlayerDataStorage::save_player_data`
  let none = PlayerDataError(kind: pdeIo, msg: "")
  if not s.saveEnabled:
    return (true, none)
  let path = getPlayerDataPath(s, uuid)
  if not createDirAllW(parentDirW(path)):
    return (false, PlayerDataError(kind: pdeIo, msg: "could not create directory for " & path))
  let (ok, msg) = writeGzipCompoundFile(path, data)
  if ok: (true, none) else: (false, PlayerDataError(kind: pdeNbt, msg: msg))
