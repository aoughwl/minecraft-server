## Player data on disk: data/player_data.rs has no tests of its own.

import std/[syncio, assertions, cmdline, envvars]
import ../nbt/tag
import nbtget, playerdata, worldfs

proc scratch(name: string): string =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/misc_scratch"
  result = base & "/" & name
  discard createDirAllW(result)

proc testPlayerData() =
  let dir = scratch("players")
  let uuid = "00000000-0000-0000-0000-000000000001"
  discard removeFileW(dir & "/" & uuid & ".dat")
  var s = newPlayerDataStorage(dir, true)
  assert isSaveEnabled(s)
  assert getPlayerDataPath(s, uuid) == dir & "/" & uuid & ".dat"
  let none = loadPlayerData(s, uuid)
  assert none.ok and not none.found
  var nbt = newCompound()
  put(nbt, "Health", floatTag(20.0'f32))
  assert savePlayerData(s, uuid, nbt)[0]
  let got = loadPlayerData(s, uuid)
  assert got.ok and got.found and nbtFloat(got.nbt, "Health") == (true, 20.0'f32)
  # The file is gzip, as vanilla's playerdata is.
  let (_, raw) = readFileBytes(dir & "/" & uuid & ".dat")
  assert raw[0] == 0x1f'u8 and raw[1] == 0x8b'u8
  # Corrupt data is an error, not an empty player.
  assert writeFileBytes(dir & "/" & uuid & ".dat", [1'u8, 2'u8, 3'u8])
  let corrupt = loadPlayerData(s, uuid)
  assert not corrupt.ok and corrupt.error.kind == pdeNbt
  # Saving disabled reads nothing and writes nothing.
  setSaveEnabled(s, false)
  let off = loadPlayerData(s, uuid)
  assert off.ok and not off.found
  assert savePlayerData(s, "other", nbt)[0]
  assert not fileExistsW(dir & "/other.dat")

testPlayerData()
echo "playerdata: all checks passed"
