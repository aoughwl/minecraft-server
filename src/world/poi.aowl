## Points of interest (villager job sites, nether portals, etc.): the model, its NBT, region files.
## Port of pumpkin-world/src/poi/mod.rs
##
## DIVERGENCE: upstream's `PoiEntry` serializes `x`, `y`, `z`, where vanilla's POI files store
## `pos: [I; x, y, z]`, so upstream skips every record of a real save. Reading accepts both; writing
## emits vanilla's `pos`.

import tick  # BlockPos
import ../nbt/tag
import ../nbt/[nbtbase, serializer, deserializer, nbtdoc]
import std/times
import nbtget, chunkcompress, worldfs

const
  PoiTypeNetherPortal* = "minecraft:nether_portal"
  SectorSize = 4096
  RegionSize = 32
  ChunkCount = RegionSize * RegionSize
  HeaderSize = SectorSize * 2
  CompressionZlib = 2'u8
  DataVersion = 3955'i32  ## upstream's hardcoded "for 1.21" constant.

type
  PoiEntry* = object
    x*, y*, z*: int32
    poiType*: string
    freeTickets*: int32

  PoiSectionData* = object
    valid*: int8
    records*: seq[PoiEntry]

  PoiChunkData* = object
    dataVersion*: int32
    sectionKeys*: seq[string]   ## parallel seqs, not a hash map - matches
    sections*: seq[PoiSectionData]  ## the ordered-compound convention
                                     ## `NbtCompound` itself already uses.

  PoiPosKey = (int32, int32, int32)

  PoiRegion* = object
    ## Entries indexed by position, matching upstream's `FxHashMap` with a
    ## aowlmony `Table`. `dirtyChunks` is a plain dedup seq (chunk coordinate
    ## pairs are few compared to entries) rather than pulling in a set type.
    entries: seq[(PoiPosKey, PoiEntry)]
    dirtyChunks: seq[(int32, int32)]
    dirty*: bool

proc newPortalEntry*(pos: BlockPos): PoiEntry =
  PoiEntry(x: pos.x, y: pos.y, z: pos.z, poiType: PoiTypeNetherPortal, freeTickets: 0)

proc pos*(e: PoiEntry): BlockPos {.inline.} =
  blockPos(e.x, e.y, e.z)

proc chunkIndex*(chunkX, chunkZ: int32): int =
  ## Chunk's slot (0..1023) in an MCA file's location/timestamp tables.
  let localX = chunkX and 31
  let localZ = chunkZ and 31
  int((localZ shl 5) or localX)

proc sectionKeyOf(pos: BlockPos): string =
  ## Just the Y section coordinate, as a decimal string - matches vanilla's
  ## own POI-file section-key convention (not a full chunk-section id).
  $(pos.y shr 4)

proc newPoiRegion*(): PoiRegion =
  PoiRegion(entries: @[], dirtyChunks: @[], dirty: false)

proc findEntryIndex(r: PoiRegion, key: PoiPosKey): int =
  for i, (k, _) in r.entries:
    if k == key:
      return i
  -1

proc markChunkDirty(r: var PoiRegion, chunkX, chunkZ: int32) =
  let key = (chunkX, chunkZ)
  for c in r.dirtyChunks:
    if c == key:
      return
  r.dirtyChunks.add(key)

proc add*(r: var PoiRegion, entry: PoiEntry) =
  let chunkX = entry.x shr 4
  let chunkZ = entry.z shr 4
  markChunkDirty(r, chunkX, chunkZ)
  let key = (entry.x, entry.y, entry.z)
  let i = findEntryIndex(r, key)
  if i >= 0:
    r.entries[i][1] = entry
  else:
    r.entries.add((key, entry))
  r.dirty = true

proc remove*(r: var PoiRegion, p: BlockPos): bool =
  let key = (p.x, p.y, p.z)
  let i = findEntryIndex(r, key)
  if i < 0:
    return false
  r.entries.delete(i)
  markChunkDirty(r, p.x shr 4, p.z shr 4)
  r.dirty = true
  true

proc getAll*(r: PoiRegion): seq[PoiEntry] =
  result = @[]
  for (_, e) in r.entries:
    result.add(e)

proc markClean*(r: var PoiRegion) =
  r.dirty = false
  r.dirtyChunks = @[]

proc findOrAddSection(data: var PoiChunkData, key: string): int =
  for i, k in data.sectionKeys:
    if k == key:
      return i
  data.sectionKeys.add(key)
  data.sections.add(PoiSectionData(valid: 1, records: @[]))
  data.sectionKeys.len - 1

proc getChunkData*(r: PoiRegion, chunkX, chunkZ: int32): (bool, PoiChunkData) =
  ## Groups this region's entries by section for one chunk. Returns
  ## `(false, _)` if the chunk has no POI entries, matching upstream's
  ## `Option<PoiChunkData>`.
  var data = PoiChunkData(dataVersion: DataVersion, sectionKeys: @[], sections: @[])
  for (_, entry) in r.entries:
    if (entry.x shr 4) != chunkX or (entry.z shr 4) != chunkZ:
      continue
    let secKey = sectionKeyOf(entry.pos())
    let idx = findOrAddSection(data, secKey)
    data.sections[idx].records.add(entry)
  if data.sectionKeys.len == 0:
    (false, data)
  else:
    (true, data)

proc buildChunkNbt*(data: PoiChunkData): NbtCompound =
  ## Port of `compress_chunk_data`'s NBT-building half (the compression
  ## itself is deferred - see file header).
  var root = newCompound()
  put(root, "DataVersion", NbtTag(kind: ntkInt, intVal: data.dataVersion))
  var sectionsComp = newCompound()
  for i, secKey in data.sectionKeys:
    let sec = data.sections[i]
    var secComp = newCompound()
    put(secComp, "Valid", NbtTag(kind: ntkByte, byteVal: sec.valid))
    var recList: seq[NbtTag] = @[]
    for rec in sec.records:
      var recComp = newCompound()
      put(recComp, "pos", intArrayTag(@[rec.x, rec.y, rec.z]))
      put(recComp, "type", NbtTag(kind: ntkString, stringVal: rec.poiType))
      put(recComp, "free_tickets", NbtTag(kind: ntkInt, intVal: rec.freeTickets))
      recList.add(NbtTag(kind: ntkCompound, compoundVal: recComp))
    put(secComp, "Records", NbtTag(kind: ntkList, listVal: recList))
    put(sectionsComp, secKey, NbtTag(kind: ntkCompound, compoundVal: secComp))
  put(root, "Sections", NbtTag(kind: ntkCompound, compoundVal: sectionsComp))
  root

proc parseChunkNbt*(root: NbtCompound): PoiChunkData =
  ## Port of `decompress_chunk_data`'s NBT-parsing half. Missing/malformed
  ## fields fall back to upstream's own defaults rather than failing, since
  ## that's what `unwrap_or(...)` does throughout the Rust source.
  var dataVersion = DataVersion
  let (foundVer, verTag) = get(root, "DataVersion")
  if foundVer and verTag.kind == ntkInt:
    dataVersion = verTag.intVal

  var data = PoiChunkData(dataVersion: dataVersion, sectionKeys: @[], sections: @[])
  let (foundSections, sectionsTag) = get(root, "Sections")
  if not foundSections or sectionsTag.kind != ntkCompound:
    return data

  let sectionsComp = sectionsTag.compoundVal
  for i in 0 ..< sectionsComp.names.len:
    let secKey = sectionsComp.names[i]
    let secTag = sectionsComp.values[i]
    if secTag.kind != ntkCompound:
      continue
    let secComp = secTag.compoundVal
    var valid: int8 = 1
    let (foundValid, validTag) = get(secComp, "Valid")
    if foundValid and validTag.kind == ntkByte:
      valid = validTag.byteVal
    var records: seq[PoiEntry] = @[]
    let (foundRecs, recsTag) = get(secComp, "Records")
    if foundRecs and recsTag.kind == ntkList:
      for recTag in recsTag.listVal:
        if recTag.kind != ntkCompound:
          continue
        let rc = recTag.compoundVal
        var e = PoiEntry(x: 0, y: 0, z: 0, poiType: PoiTypeNetherPortal, freeTickets: 0)
        let (fx, xt) = get(rc, "x")
        if fx and xt.kind == ntkInt: e.x = xt.intVal
        let (fy, yt) = get(rc, "y")
        if fy and yt.kind == ntkInt: e.y = yt.intVal
        let (fz, zt) = get(rc, "z")
        if fz and zt.kind == ntkInt: e.z = zt.intVal
        let (hasPos, posArr) = nbtIntArray(rc, "pos")
        if hasPos and posArr.len == 3:
          e.x = posArr[0]
          e.y = posArr[1]
          e.z = posArr[2]
        let (ft, tt) = get(rc, "type")
        if ft and tt.kind == ntkString: e.poiType = tt.stringVal
        let (ff, ftt) = get(rc, "free_tickets")
        if ff and ftt.kind == ntkInt: e.freeTickets = ftt.intVal
        records.add(e)
    data.sectionKeys.add(secKey)
    data.sections.add(PoiSectionData(valid: valid, records: records))
  data

proc compressChunkData*(chunkData: PoiChunkData): (bool, seq[byte]) =
  ## `PoiRegion::compress_chunk_data`
  let r = zlibCompress(write(newNbt("", buildChunkNbt(chunkData)), nwmJava))
  (r.ok, r.data)

proc decompressChunkData*(compressed: openArray[byte]): (bool, PoiChunkData) =
  ## `PoiRegion::decompress_chunk_data`
  let empty = PoiChunkData(dataVersion: DataVersion, sectionKeys: @[], sections: @[])
  let raw = zlibDecompress(compressed)
  if not raw.ok:
    return (false, empty)
  let isNamed = raw.data.len >= 3 and raw.data[0] == 0x0a'u8 and raw.data[1] == 0x00'u8 and raw.data[2] == 0x00'u8
  var reader = newNbtReader(nrmJava, raw.data)
  let doc = if isNamed: read(reader) else: readUnnamed(reader)
  if not doc.isOk:
    return (false, empty)
  (true, parseChunkNbt(doc.value.rootTag))

proc be32(data: openArray[byte], p: int): uint32 =
  (uint32(data[p]) shl 24) or (uint32(data[p + 1]) shl 16) or (uint32(data[p + 2]) shl 8) or uint32(data[p + 3])

proc putBe32(o: var seq[byte], p: int, v: uint32) =
  o[p] = uint8(v shr 24)
  o[p + 1] = uint8((v shr 16) and 0xFF'u32)
  o[p + 2] = uint8((v shr 8) and 0xFF'u32)
  o[p + 3] = uint8(v and 0xFF'u32)

proc save*(r: var PoiRegion, path: string): (bool, string) =
  ## `PoiRegion::save`
  if not r.dirty:
    return (true, "")
  if r.entries.len == 0:
    # Don't save empty regions, delete the file if it exists.
    if fileExistsW(path):
      if not removeFileW(path):
        return (false, "could not remove " & path)
    r.dirty = false
    r.dirtyChunks = @[]
    return (true, "")

  var chunkData = newSeq[seq[byte]](ChunkCount)
  var present = newSeq[bool](ChunkCount)
  for i in 0 ..< r.entries.len:
    let chunkX = r.entries[i][1].x shr 4
    let chunkZ = r.entries[i][1].z shr 4
    let index = chunkIndex(chunkX, chunkZ)
    if present[index]:
      continue
    let (found, data) = getChunkData(r, chunkX, chunkZ)
    if found:
      let (ok, compressed) = compressChunkData(data)
      if not ok:
        return (false, "could not compress POI chunk")
      chunkData[index] = compressed
      present[index] = true

  let timestamp = uint32(getTime().toUnix())
  var output = newSeq[byte](HeaderSize)
  var currentSector = 2'u32
  for index in 0 ..< ChunkCount:
    if present[index]:
      let compressed = chunkData[index]
      let dataLen = compressed.len + 5  # 4 bytes length + 1 byte compression + data
      let sectorCount = uint32((dataLen + SectorSize - 1) div SectorSize)
      let start = output.len
      output.setLen(start + int(sectorCount) * SectorSize)
      putBe32(output, start, uint32(compressed.len + 1))
      output[start + 4] = CompressionZlib
      for i in 0 ..< compressed.len:
        output[start + 5 + i] = compressed[i]
      putBe32(output, index * 4, (currentSector shl 8) or sectorCount)
      putBe32(output, SectorSize + index * 4, timestamp)
      currentSector += sectorCount

  let parent = parentDirW(path)
  if parent.len > 0:
    discard createDirAllW(parent)
  if not writeFileBytes(path, output):
    return (false, "could not write " & path)
  r.dirty = false
  r.dirtyChunks = @[]
  (true, "")

proc load*(path: string): (bool, PoiRegion) =
  ## `PoiRegion::load`. An absent or short file is an empty region; a bad chunk is skipped.
  var region = newPoiRegion()
  let (status, fileData) = readFileBytes(path)
  if status != rsOk or fileData.len < HeaderSize:
    return (true, region)
  for index in 0 ..< ChunkCount:
    let location = be32(fileData, index * 4)
    let sectorOffset = int(location shr 8)
    let sectorCount = int(location and 0xFF'u32)
    if sectorOffset == 0 or sectorCount == 0:
      continue
    let byteOffset = sectorOffset * SectorSize
    let byteEnd = byteOffset + sectorCount * SectorSize
    if byteEnd > fileData.len:
      continue
    let length = int(be32(fileData, byteOffset))
    let compression = fileData[byteOffset + 4]
    if compression != CompressionZlib or length < 1 or length > sectorCount * SectorSize - 4:
      continue
    let (ok, data) = decompressChunkData(toOpenArray(fileData, byteOffset + 5, byteOffset + 4 + length - 1))
    if ok:
      for section in data.sections:
        for entry in section.records:
          region.add(entry)
  region.dirty = false
  region.dirtyChunks = @[]
  (true, region)

type
  LoadedPoiRegion = object
    rx, rz: int32
    region: PoiRegion

  PoiStorage* = ref object
    folder: string
    regions: seq[LoadedPoiRegion]

proc newPoiStorage*(poiFolder: string): PoiStorage =
  ## `PoiStorage::new`
  PoiStorage(folder: poiFolder, regions: @[])

proc regionPath(s: PoiStorage, rx, rz: int32): string =
  joinPathW(s.folder, "r." & $rx & "." & $rz & ".mca")

proc getOrLoadRegion(s: PoiStorage, rx, rz: int32): int =
  ## `PoiStorage::get_or_load_region`, as an index into `regions`.
  for i in 0 ..< s.regions.len:
    if s.regions[i].rx == rx and s.regions[i].rz == rz:
      return i
  let (_, region) = load(regionPath(s, rx, rz))
  s.regions.add(LoadedPoiRegion(rx: rx, rz: rz, region: region))
  s.regions.len - 1

proc add*(s: PoiStorage, p: BlockPos, poiType: string) =
  ## `PoiStorage::add`
  let i = getOrLoadRegion(s, (p.x shr 4) shr 5, (p.z shr 4) shr 5)
  s.regions[i].region.add(PoiEntry(x: p.x, y: p.y, z: p.z, poiType: poiType, freeTickets: 0'i32))

proc addPortal*(s: PoiStorage, p: BlockPos) =
  ## `PoiStorage::add_portal`
  add(s, p, PoiTypeNetherPortal)

proc remove*(s: PoiStorage, p: BlockPos): bool =
  ## `PoiStorage::remove`
  let i = getOrLoadRegion(s, (p.x shr 4) shr 5, (p.z shr 4) shr 5)
  s.regions[i].region.remove(p)

proc getInSquare*(s: PoiStorage, center: BlockPos, radius: int32, poiType = ""): seq[BlockPos] =
  ## `PoiStorage::get_in_square`. An empty `poiType` is upstream's `None`.
  result = newSeq[BlockPos](0)
  let minRx = ((center.x - radius) shr 4) shr 5
  let maxRx = ((center.x + radius) shr 4) shr 5
  let minRz = ((center.z - radius) shr 4) shr 5
  let maxRz = ((center.z + radius) shr 4) shr 5
  var rx = minRx
  while rx <= maxRx:
    var rz = minRz
    while rz <= maxRz:
      let i = getOrLoadRegion(s, rx, rz)
      let entries = s.regions[i].region.getAll()
      for entry in entries:
        if poiType.len > 0 and entry.poiType != poiType:
          continue
        if abs(entry.x - center.x) <= radius and abs(entry.z - center.z) <= radius:
          result.add(entry.pos())
      inc rz
    inc rx

proc saveAll*(s: PoiStorage): (bool, string) =
  ## `PoiStorage::save_all`
  discard createDirAllW(s.folder)
  for i in 0 ..< s.regions.len:
    if s.regions[i].region.dirty:
      let (ok, msg) = save(s.regions[i].region, regionPath(s, s.regions[i].rx, s.regions[i].rz))
      if not ok:
        return (false, msg)
  (true, "")

proc loadedRegionCount*(s: PoiStorage): int {.inline.} =
  ## `PoiStorage::loaded_region_count`
  s.regions.len

proc totalPoiCount*(s: PoiStorage): int =
  ## `PoiStorage::total_poi_count`
  result = 0
  for r in s.regions:
    result += r.region.getAll().len
