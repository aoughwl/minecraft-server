## Round-trip smoke test for poi.aowl, run via `aowlmony c -r src/world/poitest.aowl`.

import std/assertions
import std/syncio
import tick
import poi

proc main() =
  var region = newPoiRegion()
  assert not region.dirty

  region.add(newPortalEntry(blockPos(10, 64, -5)))
  region.add(PoiEntry(x: 10, y: 70, z: -5, poiType: "minecraft:home", freeTickets: 3))
  region.add(PoiEntry(x: 300, y: 64, z: 300, poiType: "minecraft:meeting", freeTickets: 1))
  assert region.dirty
  assert region.getAll().len == 3

  # Same chunk (10>>4 == 0, -5>>4 == -1), different chunk for the third.
  let (found0, chunk0) = region.getChunkData(0, -1)
  assert found0
  assert chunk0.dataVersion == 3955
  # y=64 -> section 4, y=70 -> section 4 too (70 shr 4 == 4).
  assert chunk0.sectionKeys.len == 1
  assert chunk0.sections[0].records.len == 2

  let (found1, chunk1) = region.getChunkData(18, 18)
  assert found1
  assert chunk1.sections[0].records.len == 1
  assert chunk1.sections[0].records[0].poiType == "minecraft:meeting"

  let (foundEmpty, _) = region.getChunkData(999, 999)
  assert not foundEmpty

  # NBT round-trip: build -> parse -> compare.
  let nbt = buildChunkNbt(chunk0)
  let back = parseChunkNbt(nbt)
  assert back.dataVersion == chunk0.dataVersion
  assert back.sectionKeys == chunk0.sectionKeys
  assert back.sections.len == chunk0.sections.len
  assert back.sections[0].valid == chunk0.sections[0].valid
  assert back.sections[0].records.len == chunk0.sections[0].records.len
  # Records may come back in a different order than added (both are just
  # "the two entries in this chunk"); check membership rather than order.
  var sawPortal = false
  var sawHome = false
  for r in back.sections[0].records:
    if r.poiType == PoiTypeNetherPortal and r.x == 10 and r.y == 64 and r.z == -5:
      sawPortal = true
    if r.poiType == "minecraft:home" and r.freeTickets == 3:
      sawHome = true
  assert sawPortal
  assert sawHome

  assert region.remove(blockPos(10, 64, -5))
  assert region.getAll().len == 2
  assert not region.remove(blockPos(10, 64, -5))  # already gone

  region.markClean()
  assert not region.dirty

  echo "poi.aowl: all checks passed"

main()

# --- upstream's #[test] poi_storage_mca, and the vanilla record form ---------------------------

import std/[cmdline, envvars]
import nbtget, worldfs, chunkcompress
import ../nbt/tag as nbttag

proc poiStorageMca() =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/poi_scratch"
  let dir = base & "/poi"
  discard createDirAllW(dir)
  discard removeFileW(dir & "/r.0.0.mca")
  let storage = newPoiStorage(dir)
  storage.addPortal(blockPos(100, 64, 100))
  storage.addPortal(blockPos(110, 64, 100))
  storage.addPortal(blockPos(1000, 64, 1000))  # different region
  let results = storage.getInSquare(blockPos(105, 64, 100), 16'i32, PoiTypeNetherPortal)
  assert results.len == 2
  assert storage.loadedRegionCount() == 1 or storage.loadedRegionCount() == 2
  assert storage.saveAll()[0]
  assert fileExistsW(dir & "/r.0.0.mca")

  # On-disk layout: first entry at sector 2, zlib, `pos` as an int array.
  let (_, bytes) = readFileBytes(dir & "/r.0.0.mca")
  assert bytes.len mod 4096 == 0 and bytes.len >= 3 * 4096
  let at = chunkIndex(6'i32, 6'i32) * 4
  assert bytes[at] == 0'u8 and bytes[at + 1] == 0'u8 and bytes[at + 2] == 2'u8 and bytes[at + 3] == 1'u8
  assert bytes[8196] == 2'u8

  # Reload and verify.
  let storage2 = newPoiStorage(dir)
  let results2 = storage2.getInSquare(blockPos(105, 64, 100), 16'i32, PoiTypeNetherPortal)
  assert results2.len == 2
  assert storage2.getInSquare(blockPos(105, 64, 100), 16'i32, "minecraft:home").len == 0
  assert storage2.getInSquare(blockPos(105, 64, 100), 16'i32).len == 2
  assert storage2.remove(blockPos(100, 64, 100))
  assert not storage2.remove(blockPos(100, 64, 100))
  assert storage2.totalPoiCount() == 1

  # Removing everything deletes the file.
  assert storage2.remove(blockPos(110, 64, 100))
  assert storage2.saveAll()[0]
  assert not fileExistsW(dir & "/r.0.0.mca")

proc vanillaRecords() =
  # What a 1.21.11 server writes for a record: `pos`, no x/y/z.
  var rec = newCompound()
  put(rec, "pos", intArrayTag(@[-5'i32, 70'i32, 9'i32]))
  put(rec, "type", stringTag("minecraft:home"))
  put(rec, "free_tickets", intTag(1))
  var sec = newCompound()
  put(sec, "Valid", byteTag(1))
  put(sec, "Records", listTag(@[compoundTag(rec)]))
  var sections = newCompound()
  put(sections, "4", compoundTag(sec))
  var root = newCompound()
  put(root, "DataVersion", intTag(4671))
  put(root, "Sections", compoundTag(sections))
  let parsed = parseChunkNbt(root)
  assert parsed.dataVersion == 4671'i32 and parsed.sections.len == 1
  let e = parsed.sections[0].records[0]
  assert e.x == -5'i32 and e.y == 70'i32 and e.z == 9'i32 and e.poiType == "minecraft:home" and e.freeTickets == 1'i32
  # Written back the same way.
  let again = buildChunkNbt(parsed)
  let (_, secs) = nbtCompound(again, "Sections")
  let (_, sec4) = nbtCompound(secs, "4")
  let (_, recs) = nbtList(sec4, "Records")
  assert nbtIntArray(recs[0].compoundVal, "pos") == (true, @[-5'i32, 70'i32, 9'i32])
  assert not recs[0].compoundVal.containsKey("x")

poiStorageMca()
vanillaRecords()
echo "poi: storage vectors passed"
