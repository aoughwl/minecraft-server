## Chunk save with compress jobs (sim/savepool): region files byte-identical to the inline save, at 0 and 3 workers,
## for a first write and an in-place rewrite that changes sector counts. The timestamp page (bytes 4096..8191) is masked,
## it holds the wall clock at apply time.
import std/[syncio, assertions, envvars, cmdline]
import ../config/chunk as chunkconfig
import blockstates, palette, chunkdata, chunkio, chunkformat, anvilformat, filemanager, worldfs
import ../server/sim/savepool

proc scratchDir(): string =
  result = getEnv("WORLDTEST_DIR")
  if result.len == 0:
    result = parentDirW(paramStr(0)) & "/savejob_scratch"
  discard createDirAllW(result)

proc folderAt(base: string): LevelFolder =
  discard createDirAllW(base & "/region")
  discard createDirAllW(base & "/entities")
  LevelFolder(rootFolder: base, dimFolder: base, regionFolder: base & "/region",
    entitiesFolder: base & "/entities", poiFolder: base & "/poi")

proc chunkAt(x, z: int32, rounds: int): ChunkData =
  var s = newChunkSections(6, -64'i32)
  for sec in 0 ..< 6:
    for cx in 0 ..< 16:
      for cz in 0 ..< 16:
        for y in 0 ..< 16:
          let k = (int(x) * 31 + int(z) * 17 + cx * 7 + cz * 3 + y + rounds * 5 + sec) mod 23
          if k < 3 + (int(x + z) mod 5) * rounds * 3:
            let id = uint32(((16 * 16 * y + 16 * cz + cx + int(x) * 977 + rounds) * 2654435761) mod BsStateCount)
            discard setRelativeBlock(s, cx, sec * 16 + y, cz, id)
  let c = newChunkData(x, z, s)
  c.status = csFull
  c.dirty = true
  c

proc coordsList(): seq[(int32, int32)] =
  result = @[]
  for i in 0 ..< 44:
    # three region files (x 0..31, 32..63, and z 32+)
    let x = int32((i * 5) mod 64)
    let z = int32(if i mod 4 == 3: 33 + i mod 3 else: i mod 7)
    result.add((x, z))

proc saveAll(base: string, cfg: AnvilChunkConfig, rounds: int) =
  let folder = folderAt(base)
  let m = newChunkFileManager(anvilSerializerType(cfg), fkRegion)
  var chunks: seq[ChunkData] = @[]
  let cl = coordsList()
  for i in 0 ..< cl.len:
    chunks.add(chunkAt(cl[i][0], cl[i][1], rounds))
  let st = saveChunks(m, folder, chunks)
  assert st.ok, $st.error
  for c in chunks:
    assert not c.dirty

proc regionBytes(base: string, name: string): seq[byte] =
  let (status, bytes) = readFileBytes(base & "/region/" & name)
  assert status == rsOk, name
  result = bytes
  for i in 4096 ..< min(8192, result.len):
    result[i] = 0'u8

var failures = 0
proc check(ok: bool, name: string) =
  if ok:
    echo "PASS " & name
  else:
    echo "FAIL " & name
    inc failures

proc runCase(root: string, tag: string, cfg: AnvilChunkConfig, workers: int) =
  # inline reference
  let a = root & "/" & tag & "_inline"
  let b = root & "/" & tag & "_w" & $workers
  for d in @[a, b]:
    let f = folderAt(d)
    for n in @["r.0.0.mca", "r.1.0.mca", "r.0.1.mca"]:
      discard removeFileW(f.regionFolder & "/" & n)
  saveAll(a, cfg, 1)
  saveAll(a, cfg, 2)       # rewrite, sector counts change
  assert enableSaveJobs(workers)
  assert saveJobsEnabled()
  saveAll(b, cfg, 1)
  saveAll(b, cfg, 2)
  shutdownSaveJobs()
  for n in @["r.0.0.mca", "r.1.0.mca", "r.0.1.mca"]:
    let ba = regionBytes(a, n)
    let bb = regionBytes(b, n)
    check(ba.len > 8192 and ba == bb, tag & " " & n & " identical at workers=" & $workers & " (" & $ba.len & " bytes)")

proc main() =
  let root = scratchDir()
  check(not saveJobsEnabled(), "default off")
  var inPlace = defaultAnvilChunkConfig()
  inPlace.writeInPlace = true
  var whole = defaultAnvilChunkConfig()
  whole.writeInPlace = false
  runCase(root, "inplace", inPlace, 3)
  runCase(root, "whole", whole, 3)
  runCase(root, "inplace0", inPlace, 0)
  echo "failures: " & $failures
  assert failures == 0

main()
