## A fixed-size `Inventory`. Port of pumpkin-world/src/inventory/simple_inventory.rs and
## pumpkin-world/src/inventory/mod.rs
##
## The trait itself is src/inventory/inventory.aowl, which already ports inventory/inventory.rs.
##
## PARTIAL: pumpkin-world/src/inventory/simple_inventory.rs - `ItemStack` is src/inventory/itemstub.aowl
## until pumpkin-data's item stacks are ported. `s.inv` is filled in, but its closures are not safe to
## call yet: storing a closure in another module's `{.closure.}` field takes no reference on the
## environment, and inventory.aowl's wrappers call fields directly, which drops one per call (see the
## port report). `size`, `isEmpty` and the rest below are the same logic without the vtable, and work.
## PARTIAL: pumpkin-world/src/inventory/mod.rs - the same.

import ../inventory/[inventory, itemstub]

type
  SimpleInventory* = ref object
    inv*: Inventory
    stacks*: seq[ItemStack]

proc splitStack*(stacks: var seq[ItemStack], slot: int, amount: uint8): ItemStack =
  ## `split_stack`. Upstream indexes `stacks[slot]` before testing the bound; this tests first.
  if slot < stacks.len and not isEmpty(stacks[slot]) and amount > 0'u8:
    split(stacks[slot], amount)
  else:
    emptyStack()

proc size*(s: SimpleInventory): int {.inline.} =
  ## `Inventory::size`
  s.stacks.len

proc isEmpty*(s: SimpleInventory): bool =
  ## `Inventory::is_empty`
  for stack in s.stacks:
    if not isEmpty(stack):
      return false
  true

proc getStack*(s: SimpleInventory, slot: int): ItemStack {.inline.} =
  ## `Inventory::get_stack`
  s.stacks[slot]

proc removeStack*(s: SimpleInventory, slot: int): ItemStack =
  ## `Inventory::remove_stack`
  result = s.stacks[slot]
  s.stacks[slot] = emptyStack()

proc removeStackSpecific*(s: SimpleInventory, slot: int, amount: uint8): ItemStack =
  ## `Inventory::remove_stack_specific`
  splitStack(s.stacks, slot, amount)

proc setStack*(s: SimpleInventory, slot: int, stack: ItemStack) =
  ## `Inventory::set_stack`
  s.stacks[slot] = stack

proc clear*(s: SimpleInventory) =
  ## `impl Clearable for SimpleInventory`
  for i in 0 ..< s.stacks.len:
    s.stacks[i] = emptyStack()

proc fillVtable(s: SimpleInventory) =
  s.inv.sizeImpl = proc(): int {.closure.} = size(s)
  s.inv.isEmptyImpl = proc(): bool {.closure.} = isEmpty(s)
  s.inv.getStackImpl = proc(slot: int): ItemStack {.closure.} = getStack(s, slot)
  s.inv.removeStackImpl = proc(slot: int): ItemStack {.closure.} = removeStack(s, slot)
  s.inv.removeStackSpecificImpl = proc(slot: int, amount: uint8): ItemStack {.closure.} =
    removeStackSpecific(s, slot, amount)
  s.inv.setStackImpl = proc(slot: int, stack: ItemStack) {.closure.} = setStack(s, slot, stack)
  s.inv.clearImpl = proc() {.closure.} = clear(s)

proc newSimpleInventory*(size: int): SimpleInventory =
  ## `SimpleInventory::new`
  let s = SimpleInventory(inv: Inventory(), stacks: newSeq[ItemStack](size))
  for i in 0 ..< size:
    s.stacks[i] = emptyStack()
  fillVtable(s)
  s
