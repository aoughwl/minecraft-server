## `SimpleInventory`, directly: see the file comment in simpleinventory.aowl about the vtable.

import std/[syncio, assertions]
import ../inventory/itemstub
import simpleinventory

proc testSimpleInventory() =
  let s = newSimpleInventory(3)
  assert size(s) == 3 and isEmpty(s)
  let stack = ItemStack(item: Item(id: 5'u16), itemCount: 10'u8)
  setStack(s, 1, stack)
  assert not isEmpty(s)
  assert getStack(s, 1).itemCount == 10'u8
  let split3 = removeStackSpecific(s, 1, 3'u8)
  assert split3.itemCount == 3'u8 and getStack(s, 1).itemCount == 7'u8
  let all = removeStack(s, 1)
  assert all.itemCount == 7'u8 and isEmpty(s)
  assert isEmpty(removeStackSpecific(s, 0, 3'u8))
  setStack(s, 2, stack)
  clear(s)
  assert isEmpty(s)

testSimpleInventory()
echo "simpleinventory: all checks passed"
