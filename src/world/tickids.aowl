## Port of the `FromResourceLocation` impls of pumpkin-data/src/blocks.rs and the generated fluid.rs, which
## `parse_scheduled_tick` (pumpkin-world/src/chunk/format/mod.rs) uses to check a tick's id is registered.
## Its own module: block_properties and fluid export names the chunk format already uses.

import std/options
import ../generated/block_properties
import ../generated/fluid

proc stripMinecraft(id: string): string =
  if id.len > 10 and id[0 ..< 10] == "minecraft:": id[10 ..< id.len] else: id

proc isRegisteredBlockKey*(id: string): bool =
  ## `<&Block as FromResourceLocation>::from_resource_location(..).is_some()`
  Block.fromRegistryKey(stripMinecraft(id)) != nil

proc isRegisteredFluidKey*(id: string): bool =
  ## `<&Fluid as FromResourceLocation>::from_resource_location(..).is_some()`
  Fluid.fromRegistryKey(stripMinecraft(id)).isSome
