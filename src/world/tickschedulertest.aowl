## The per-chunk tick ring. tick/scheduler.rs has no #[test]s; expectations are read from its code.
import std/[syncio, assertions]
import tick, tickscheduler

proc st(delay: uint8, pos: BlockPos, value: string): ScheduledTick[string] =
  ScheduledTick[string](delay: delay, priority: tpNormal, position: pos, value: value)

proc main() =
  var s = newChunkTickScheduler()
  assert not hasTicks(s)
  assert stepTick(s).len == 0
  let p = blockPos(1, 2, 3)
  # step_tick took slot 0 and moved the offset to 1; delay 0 lands on the next step.
  scheduleTick(s, st(0'u8, p, "a"), 10'u64)
  scheduleTick(s, st(2'u8, p, "b"), 11'u64)
  scheduleTick(s, st(2'u8, p, "b"), 12'u64)  # same position and value: dropped
  assert hasTicks(s)
  assert isScheduled(s, p, "a") and isScheduled(s, p, "b")
  assert not isScheduled(s, blockPos(0, 0, 0), "a")

  # to_vec walks from the offset, delay being the distance.
  let v = toSeq(s)
  assert v.len == 2 and v[0].value == "a" and v[0].delay == 0'u8 and v[1].value == "b" and v[1].delay == 2'u8

  let first = stepTick(s)
  assert first.len == 1 and first[0].value == "a" and first[0].subTickOrder == 10'u64
  assert not isScheduled(s, p, "a")
  assert stepTick(s).len == 0
  let third = stepTick(s)
  assert third.len == 1 and third[0].value == "b" and third[0].subTickOrder == 11'u64
  assert not hasTicks(s)

  # The maximum delay wraps the ring: 255 steps later.
  scheduleTick(s, st(255'u8, p, "w"), 0'u64)
  var steps = 0
  while hasTicks(s):
    discard stepTick(s)
    inc steps
  assert steps == 256

  # FromIterator
  let r = fromTicks([st(1'u8, p, "x"), st(4'u8, p, "y"), st(1'u8, p, "x")])
  let rv = toSeq(r)
  assert rv.len == 2 and rv[0].delay == 1'u8 and rv[1].delay == 4'u8

main()
echo "tick scheduler: all checks passed"
