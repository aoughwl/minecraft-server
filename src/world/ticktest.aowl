## Tick ordering and the NBT form. tick/mod.rs has no #[test]s; expectations are read from its
## derives and `Serialize`/`Deserialize` impls.
import std/[syncio, assertions]
import ../nbt/tag
import tick, nbtget

proc main() =
  assert tickPriorityValues()[0] == tpExtremelyHigh and tickPriorityValues()[6] == tpExtremelyLow
  assert tickPriorityFromInt(-3'i32) == (true, tpExtremelyHigh)
  assert tickPriorityFromInt(3'i32) == (true, tpExtremelyLow)
  assert tickPriorityFromInt(4'i32)[0] == false
  assert MaxTickDelay == 256

  # Order: priority, then sub_tick_order. Lower sorts first.
  let a = OrderedTick[string](priority: tpHigh, subTickOrder: 5'u64, position: blockPos(0, 0, 0), value: "a")
  let b = OrderedTick[string](priority: tpNormal, subTickOrder: 1'u64, position: blockPos(0, 0, 0), value: "b")
  let c = OrderedTick[string](priority: tpNormal, subTickOrder: 2'u64, position: blockPos(9, 9, 9), value: "c")
  assert a < b and b < c and not (c < b)
  assert cmp(b, b) == 0
  # PartialEq ignores position and value.
  let d = OrderedTick[string](priority: tpNormal, subTickOrder: 2'u64, position: blockPos(1, 1, 1), value: "z")
  assert c == d
  assert newOrderedTick[string](blockPos(1, 2, 3), "v").priority == tpNormal

  # NBT: x, y, z, t, p, i.
  let t = ScheduledTick[string](delay: 7'u8, priority: tpVeryLow, position: blockPos(-1, 2, 3), value: "minecraft:stone")
  let nbt = toNbtCompound(t)
  assert nbtInt(nbt, "x") == (true, -1'i32) and nbtInt(nbt, "y") == (true, 2'i32) and nbtInt(nbt, "z") == (true, 3'i32)
  assert nbtInt(nbt, "t") == (true, 7'i32) and nbtInt(nbt, "p") == (true, 2'i32)
  assert nbtString(nbt, "i") == (true, "minecraft:stone")
  let (ok, back) = fromNbtCompound(nbt)
  assert ok and back.delay == 7'u8 and back.priority == tpVeryLow and back.position == blockPos(-1, 2, 3)

  # `delay as u8` wraps: vanilla stores overdue ticks with a negative t.
  var overdue = newCompound()
  put(overdue, "x", intTag(0))
  put(overdue, "y", intTag(0))
  put(overdue, "z", intTag(0))
  put(overdue, "t", intTag(-1))
  put(overdue, "p", intTag(0))
  put(overdue, "i", stringTag("minecraft:water"))
  let (okO, o) = fromNbtCompound(overdue)
  assert okO and o.delay == 255'u8

  # Missing fields and a bad priority fail.
  assert not fromNbtCompound(newCompound())[0]
  var badPriority = overdue
  insert(badPriority, "p", intTag(9))
  assert not fromNbtCompound(badPriority)[0]

main()
echo "tick: all checks passed"
