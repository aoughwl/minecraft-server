## World-side interfaces the rest of the crate calls back through. Port of pumpkin-world/src/world.rs
## (world.rs)
##
## Traits become vtables. Blocks and states travel as ids.

{.feature: "lenientnils".}

import ../nbt/tag
import ../generated/biome
import blockstates, tick
import generation/protochunkbase
import ../util/vector3
import ../data/block_rotation

const
  BfNotifyNeighbors* = 0b000_0000_0001'u32
  BfNotifyListeners* = 0b000_0000_0010'u32
  BfNotifyAll* = 0b000_0000_0011'u32
  BfForceState* = 0b000_0000_0100'u32
  BfSkipDrops* = 0b000_0000_1000'u32
  BfMoved* = 0b000_0001_0000'u32
  BfSkipRedstoneWireStateReplacement* = 0b000_0010_0000'u32
  BfSkipBlockEntityReplacedCallback* = 0b000_0100_0000'u32
  BfSkipBlockAddedCallback* = 0b000_1000_0000'u32

type
  BlockFlags* = uint32

  GetBlockError* = enum
    gbeInvalidBlockId
    gbeBlockOutOfWorldBounds

  BlockAccessor* = ref object
    getBlock*: proc(position: BlockPos): int {.closure.}
    getBlockState*: proc(position: BlockPos): BlockStateId {.closure.}
    getBlockStateId*: proc(position: BlockPos): BlockStateId {.closure.}
    getBlockAndState*: proc(position: BlockPos): (int, BlockStateId) {.closure.}

  WorldPortalExt* = ref object
    canPlaceAt*: proc(blockId: int, state: BlockStateId, accessor: BlockAccessor, pos: BlockPos): bool {.closure.}
    mirror*: proc(blockId: int, stateId: BlockStateId, mirror: Mirror): BlockStateId {.closure.}
    rotate*: proc(blockId: int, stateId: BlockStateId, rotation: Rotation): BlockStateId {.closure.}
    spawnMobsForChunkGeneration*: proc(cache: GenerationCache, biome: Biome, chunkX, chunkZ: int32) {.closure.}
    spawnStructureEntities*: proc(entities: seq[NbtCompound]) {.closure.}  ## default: no-op

proc hasFlag*(flags, flag: BlockFlags): bool {.inline.} = (flags and flag) != 0'u32

proc `$`*(e: GetBlockError): string =
  ## `impl Display for GetBlockError`
  case e
  of gbeInvalidBlockId: "InvalidBlockId"
  of gbeBlockOutOfWorldBounds: "BlockOutOfWorldBounds"

type StateLookupHolder = ref object
  lookup: proc(position: BlockPos): BlockStateId {.closure.}

proc lookupIn(h: StateLookupHolder, position: BlockPos): BlockStateId =
  let f = h.lookup
  f(position)

proc accessorFromStateLookup*(lookup: proc(position: BlockPos): BlockStateId {.closure.}): BlockAccessor =
  ## The default shape: everything from `get_block_state_id`, as `Cache`'s impl does.
  let h = StateLookupHolder(lookup: lookup)
  BlockAccessor(
    getBlock: proc(position: BlockPos): int {.closure.} = blockIdOf(lookupIn(h, position)),
    getBlockState: proc(position: BlockPos): BlockStateId {.closure.} = lookupIn(h, position),
    getBlockStateId: proc(position: BlockPos): BlockStateId {.closure.} = lookupIn(h, position),
    getBlockAndState: proc(position: BlockPos): (int, BlockStateId) {.closure.} =
      let id = lookupIn(h, position)
      (blockIdOf(id), id))

proc blockAt*(a: BlockAccessor, position: BlockPos): int =
  ## Through a local; see the note in chunkio.aowl.
  let f = a.getBlock
  f(position)

proc stateIdAt*(a: BlockAccessor, position: BlockPos): BlockStateId =
  let f = a.getBlockStateId
  f(position)

proc blockAndStateAt*(a: BlockAccessor, position: BlockPos): (int, BlockStateId) =
  let f = a.getBlockAndState
  f(position)

proc generationCacheAsAccessor*(cache: GenerationCache): BlockAccessor =
  ## `GenerationCache: BlockAccessor`
  accessorFromStateLookup(proc(position: BlockPos): BlockStateId {.closure.} =
    stateOf(cache, vec3[int32](position.x, position.y, position.z)))

proc canPlaceAtOf*(p: WorldPortalExt, blockId: int, state: BlockStateId, accessor: BlockAccessor, pos: BlockPos): bool =
  let f = p.canPlaceAt
  f(blockId, state, accessor, pos)

proc spawnMobsOf*(p: WorldPortalExt, cache: GenerationCache, biome: Biome, chunkX, chunkZ: int32) =
  let f = p.spawnMobsForChunkGeneration
  f(cache, biome, chunkX, chunkZ)

proc spawnStructureEntitiesOf*(p: WorldPortalExt, entities: seq[NbtCompound]) =
  let f = p.spawnStructureEntities
  f(entities)

proc noOpWorldPortal*(): WorldPortalExt =
  ## A portal for chunk generation with no world behind it: everything can be placed, mirror and rotate keep the
  ## state, no mobs spawn. The stand-in upstream's generation tests write as `BlockRegistry`.
  WorldPortalExt(
    canPlaceAt: proc(blockId: int, state: BlockStateId, accessor: BlockAccessor, pos: BlockPos): bool {.closure.} = true,
    mirror: proc(blockId: int, stateId: BlockStateId, mirror: Mirror): BlockStateId {.closure.} = stateId,
    rotate: proc(blockId: int, stateId: BlockStateId, rotation: Rotation): BlockStateId {.closure.} = stateId,
    spawnMobsForChunkGeneration: proc(cache: GenerationCache, biome: Biome, chunkX, chunkZ: int32) {.closure.} = discard,
    spawnStructureEntities: proc(entities: seq[NbtCompound]) {.closure.} = discard)
