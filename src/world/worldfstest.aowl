## File helpers: status results, binary fidelity, replace-on-rename, in-place patches.
import std/[syncio, assertions, cmdline, envvars]
import worldfs

proc main() =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/worldfs_scratch"
  let dir = base & "/worldfs/a/b"
  assert createDirAllW(dir)
  assert createDirAllW(dir)   # already there is fine

  assert joinPathW("a", "b") == "a/b" and joinPathW("a/", "b") == "a/b" and joinPathW("", "b") == "b"
  assert parentDirW("a/b/c.dat") == "a/b" and parentDirW("c.dat") == ""

  let path = dir & "/f.bin"
  discard removeFileW(path)
  assert not fileExistsW(path)
  assert readFileBytes(path)[0] == rsNotFound

  # All 256 byte values, CR and LF included: no text-mode translation either way.
  var data = newSeq[byte](70000)
  for i in 0 ..< data.len:
    data[i] = byte(i mod 256)
  assert writeFileBytes(path, data)
  assert fileExistsW(path)
  let (st, back) = readFileBytes(path)
  assert st == rsOk and back == data

  # An empty file reads as empty, not missing.
  let empty = dir & "/empty.bin"
  assert writeFileBytes(empty, newSeq[byte](0))
  let (st2, e) = readFileBytes(empty)
  assert st2 == rsOk and e.len == 0

  # Rename replaces an existing target.
  let tmp = dir & "/new.tmp"
  let target = dir & "/target.bin"
  assert writeFileBytes(target, [1'u8])
  assert writeFileBytes(tmp, [2'u8, 3'u8])
  assert renameReplace(tmp, target)
  assert not fileExistsW(tmp)
  assert readFileBytes(target)[1] == @[2'u8, 3'u8]

  # Patches leave the rest of the file alone, extend it, and create it when absent.
  assert writePatches(target, [FilePatch(offset: 4'i64, data: @[9'u8])])
  assert readFileBytes(target)[1] == @[2'u8, 3'u8, 0'u8, 0'u8, 9'u8]
  assert writePatches(target, [FilePatch(offset: 1'i64, data: @[7'u8, 8'u8]), FilePatch(offset: 0'i64, data: @[6'u8])])
  assert readFileBytes(target)[1] == @[6'u8, 7'u8, 8'u8, 0'u8, 9'u8]
  let fresh = dir & "/fresh.bin"
  discard removeFileW(fresh)
  assert writePatches(fresh, [FilePatch(offset: 2'i64, data: @[5'u8])])
  assert readFileBytes(fresh)[1] == @[0'u8, 0'u8, 5'u8]

  assert removeFileW(fresh)
  assert not removeFileW(fresh)

main()
echo "worldfs: all checks passed"
