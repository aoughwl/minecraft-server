## World info: `LevelData` and friends, and the level.dat reader and writer traits.
## Port of pumpkin-world/src/world_info/mod.rs
##
## Serde derives become `levelDataFromNbt`/`levelDataToNbt`, with the same field names and defaults.
##
## PARTIAL: pumpkin-world/src/world_info/mod.rs - not upstream: `extra` holds level.dat keys upstream
## has no field for, so a real save keeps `Time`, `initialized`, `DragonFight`, `spawn` and the rest
## when rewritten, and 1.21.11's `spawn` compound and `game_rules` are read, since upstream's fields
## only match older or newer layouts. Upstream's own fields are written exactly as upstream writes them.

import ../nbt/tag
import ../util/difficulty
import ../generated/game_rules
import nbtget

const
  CurrentMcVersion* = "26.2"                      ## lib.rs CURRENT_MC_VERSION
  CurrentBedrockMcVersion* = "1.26.30"            ## lib.rs CURRENT_BEDROCK_MC_VERSION
  CurrentBedrockMcProtocol* = 1001'u32            ## lib.rs CURRENT_BEDROCK_MC_PROTOCOL
  MinimumSupportedWorldDataVersion* = 4435'i32    ## 1.21.9
  MaximumSupportedWorldDataVersion* = 4903'i32    ## 26.2
  MinimumSupportedLevelVersion* = 19132'i32       ## 1.21.9
  MaximumSupportedLevelVersion* = 19133'i32       ## 1.21.9
  DefaultBorderDamagePerBlock = 0.2'f64
  DefaultBorderSize = 60_000_000.0'f64
  DefaultBorderSafeZone = 5.0'f64
  DefaultBorderWarningBlocks = 5.0'f64
  DefaultBorderWarningTime = 15.0'f64
  DefaultLevelName = "world"
  DefaultSpawnY = 200'i32

type
  WorldInfoErrorKind* = enum
    wieIoError
    wieInfoNotFound
    wieDeserializationError
    wieSerializationError
    wieUnsupportedDataVersion
    wieUnsupportedLevelVersion

  WorldInfoError* = object
    kind*: WorldInfoErrorKind
    msg*: string
    version*: int32

  GeneratorSettingsKind* = enum
    gskNone       ## `Option::None`
    gskReference  ## `GeneratorSettings::Reference`
    gskCompound   ## `GeneratorSettings::Compound`

  GeneratorSettings* = object
    kind*: GeneratorSettingsKind
    reference*: string
    compound*: NbtCompound

  BiomeSourceKind* = enum
    bskNone        ## `Option::None`
    bskWithPreset  ## `BiomeSource::WithPreset`
    bskSimple      ## `BiomeSource::Simple`

  BiomeSource* = object
    kind*: BiomeSourceKind
    preset*: string
    biomeType*: string

  Generator* = object
    settings*: GeneratorSettings
    biomeSource*: BiomeSource
    generatorType*: string

  Dimension* = object
    generator*: Generator
    dimensionType*: string

  DimensionEntry* = object
    name*: string
    dimension*: Dimension

  WorldGenSettings* = object
    seed*: int64
    dimensions*: seq[DimensionEntry]  ## `HashMap<String, Dimension>`

  DataPacks* = object
    disabled*: seq[string]
    enabled*: seq[string]

  WorldVersion* = object
    name*: string
    id*: int32
    snapshot*: bool
    series*: string

  LevelData* = object
    allowCommands*: bool
    borderCenterX*: float64
    borderCenterZ*: float64
    borderDamagePerBlock*: float64
    borderSize*: float64
    borderSafeZone*: float64
    borderSizeLerpTarget*: float64
    borderSizeLerpTime*: int64
    borderWarningBlocks*: float64
    borderWarningTime*: float64
    dataPacks*: DataPacks
    dataVersion*: int32
    difficulty*: Difficulty
    difficultyLocked*: bool
    lastPlayed*: int64
    levelName*: string
    spawnX*: int32
    spawnY*: int32
    spawnZ*: int32
    spawnYaw*: float32
    spawnPitch*: float32
    worldVersion*: WorldVersion
    levelVersion*: int32
    mapId*: int32
    # Not serialized to level.dat by upstream; see `data_files`.
    gameRules*: GameRuleRegistry
    worldGenSettings*: WorldGenSettings
    dayTime*: int64
    clearWeatherTime*: int32
    # Not upstream, see the file comment.
    extra*: NbtCompound

  WorldInfoReader* = ref object
    readWorldInfo*: proc(levelFolder: string): (bool, LevelData, WorldInfoError) {.closure.}

  WorldInfoWriter* = ref object
    writeWorldInfo*: proc(info: LevelData, levelFolder: string): (bool, WorldInfoError) {.closure.}

let AllRules* = allGameRules()

proc infoErr*(kind: WorldInfoErrorKind, msg = "", version = 0'i32): WorldInfoError =
  WorldInfoError(kind: kind, msg: msg, version: version)

proc `$`*(e: WorldInfoError): string = $e.kind & ": " & e.msg & (if e.version != 0'i32: " " & $e.version else: "")

proc referenceSettings(name: string): GeneratorSettings =
  GeneratorSettings(kind: gskReference, reference: name, compound: newCompound())

proc newWorldGenSettings*(seed: uint64): WorldGenSettings =
  ## `WorldGenSettings::new`
  WorldGenSettings(seed: cast[int64](seed), dimensions: @[
    DimensionEntry(name: "minecraft:overworld", dimension: Dimension(
      generator: Generator(settings: referenceSettings("minecraft:overworld"),
        biomeSource: BiomeSource(kind: bskWithPreset, preset: "minecraft:overworld", biomeType: "minecraft:multi_noise"),
        generatorType: "minecraft:noise"),
      dimensionType: "minecraft:overworld")),
    DimensionEntry(name: "minecraft:the_nether", dimension: Dimension(
      generator: Generator(settings: referenceSettings("minecraft:nether"),
        biomeSource: BiomeSource(kind: bskWithPreset, preset: "minecraft:nether", biomeType: "minecraft:multi_noise"),
        generatorType: "minecraft:noise"),
      dimensionType: "minecraft:the_nether")),
    DimensionEntry(name: "minecraft:the_end", dimension: Dimension(
      generator: Generator(settings: referenceSettings("minecraft:end"),
        biomeSource: BiomeSource(kind: bskSimple, preset: "", biomeType: "minecraft:the_end"),
        generatorType: "minecraft:noise"),
      dimensionType: "minecraft:the_end"))])

proc findDimension*(w: WorldGenSettings, name: string): (bool, Dimension) =
  for e in w.dimensions:
    if e.name == name:
      return (true, e.dimension)
  (false, Dimension())

proc defaultWorldVersion*(): WorldVersion =
  ## `WorldVersion::default()`
  WorldVersion(name: CurrentMcVersion, id: MaximumSupportedWorldDataVersion, snapshot: false, series: "main")

proc defaultDataPacks(): DataPacks =
  DataPacks(disabled: @[], enabled: @["vanilla"])

proc defaultLevelData*(seed: uint64): LevelData =
  ## `LevelData::default`
  LevelData(allowCommands: true, borderCenterX: 0.0, borderCenterZ: 0.0,
    borderDamagePerBlock: DefaultBorderDamagePerBlock, borderSize: DefaultBorderSize,
    borderSafeZone: DefaultBorderSafeZone, borderSizeLerpTarget: DefaultBorderSize, borderSizeLerpTime: 0'i64,
    borderWarningBlocks: DefaultBorderWarningBlocks, borderWarningTime: DefaultBorderWarningTime,
    dataPacks: defaultDataPacks(), dataVersion: MaximumSupportedWorldDataVersion, difficulty: Normal,
    difficultyLocked: false, lastPlayed: -1'i64, levelName: DefaultLevelName, spawnX: 0'i32,
    spawnY: DefaultSpawnY, spawnZ: 0'i32, spawnYaw: 0.0'f32, spawnPitch: 0.0'f32,
    worldVersion: defaultWorldVersion(), levelVersion: MaximumSupportedLevelVersion, mapId: 0'i32,
    gameRules: defaultGameRuleRegistry(), worldGenSettings: newWorldGenSettings(0'u64), dayTime: 0'i64,
    clearWeatherTime: -1'i32, extra: newCompound())

proc setPos*(d: var LevelData, x, z: int32) =
  ## `LevelData::set_pos`
  d.spawnX = x
  d.spawnZ = z

# --- NBT forms ----------------------------------------------------------------

proc numericInt64(t: NbtTag): (bool, int64) =
  case t.kind
  of ntkByte: (true, int64(t.byteVal))
  of ntkShort: (true, int64(t.shortVal))
  of ntkInt: (true, int64(t.intVal))
  of ntkLong: (true, t.longVal)
  else: (false, 0'i64)

proc anyInt(c: NbtCompound, name: string, default: int64): int64 =
  let (found, t) = get(c, name)
  if found:
    let (ok, v) = numericInt64(t)
    if ok:
      return v
  default

proc anyBool(c: NbtCompound, name: string, default: bool): bool =
  anyInt(c, name, if default: 1'i64 else: 0'i64) != 0'i64

proc anyDouble(c: NbtCompound, name: string, default: float64): float64 =
  let (found, t) = get(c, name)
  if found:
    case t.kind
    of ntkDouble: return t.doubleVal
    of ntkFloat: return float64(t.floatVal)
    else:
      let (ok, v) = numericInt64(t)
      if ok:
        return float64(v)
  default

proc anyFloat(c: NbtCompound, name: string, default: float32): float32 =
  float32(anyDouble(c, name, float64(default)))

proc strOr(c: NbtCompound, name, default: string): string =
  let (ok, v) = nbtString(c, name)
  if ok: v else: default

proc dataPacksFromNbt(c: NbtCompound): DataPacks =
  DataPacks(disabled: stringList(c, "Disabled"), enabled: stringList(c, "Enabled"))

proc dataPacksToNbt(d: DataPacks): NbtCompound =
  result = newCompound()
  put(result, "Disabled", stringListTag(d.disabled))
  put(result, "Enabled", stringListTag(d.enabled))

proc worldVersionFromNbt(c: NbtCompound): WorldVersion =
  WorldVersion(name: strOr(c, "Name", ""), id: int32(anyInt(c, "Id", 0'i64)), snapshot: anyBool(c, "Snapshot", false),
    series: strOr(c, "Series", ""))

proc worldVersionToNbt(v: WorldVersion): NbtCompound =
  result = newCompound()
  put(result, "Name", stringTag(v.name))
  put(result, "Id", intTag(v.id))
  put(result, "Snapshot", boolTag(v.snapshot))
  put(result, "Series", stringTag(v.series))

proc generatorFromNbt(c: NbtCompound): Generator =
  result = Generator(settings: GeneratorSettings(kind: gskNone, reference: "", compound: newCompound()),
    biomeSource: BiomeSource(kind: bskNone, preset: "", biomeType: ""), generatorType: strOr(c, "type", ""))
  let (hasSettings, st) = get(c, "settings")
  if hasSettings:
    if st.kind == ntkString:
      result.settings = referenceSettings(st.stringVal)
    elif st.kind == ntkCompound:
      result.settings = GeneratorSettings(kind: gskCompound, reference: "", compound: st.compoundVal)
  let (hasBs, bs) = nbtCompound(c, "biome_source")
  if hasBs:
    let (hasPreset, preset) = nbtString(bs, "preset")
    result.biomeSource = BiomeSource(kind: (if hasPreset: bskWithPreset else: bskSimple), preset: preset,
      biomeType: strOr(bs, "type", ""))

proc generatorToNbt(g: Generator): NbtCompound =
  result = newCompound()
  case g.settings.kind
  of gskNone: discard
  of gskReference: put(result, "settings", stringTag(g.settings.reference))
  of gskCompound: put(result, "settings", compoundTag(g.settings.compound))
  case g.biomeSource.kind
  of bskNone:
    discard
  of bskWithPreset:
    var bs = newCompound()
    put(bs, "preset", stringTag(g.biomeSource.preset))
    put(bs, "type", stringTag(g.biomeSource.biomeType))
    put(result, "biome_source", compoundTag(bs))
  of bskSimple:
    var bs = newCompound()
    put(bs, "type", stringTag(g.biomeSource.biomeType))
    put(result, "biome_source", compoundTag(bs))
  put(result, "type", stringTag(g.generatorType))

proc worldGenSettingsFromNbt*(c: NbtCompound): WorldGenSettings =
  result = WorldGenSettings(seed: anyInt(c, "seed", 0'i64), dimensions: @[])
  let (hasDims, dims) = nbtCompound(c, "dimensions")
  if hasDims:
    for i in 0 ..< dims.names.len:
      if dims.values[i].kind == ntkCompound:
        let d = dims.values[i].compoundVal
        let (_, gen) = nbtCompound(d, "generator")
        result.dimensions.add(DimensionEntry(name: dims.names[i], dimension: Dimension(
          generator: generatorFromNbt(gen), dimensionType: strOr(d, "type", ""))))

proc worldGenSettingsToNbt*(w: WorldGenSettings): NbtCompound =
  result = newCompound()
  put(result, "seed", longTag(w.seed))
  var dims = newCompound()
  for e in w.dimensions:
    var d = newCompound()
    put(d, "generator", compoundTag(generatorToNbt(e.dimension.generator)))
    put(d, "type", stringTag(e.dimension.dimensionType))
    put(dims, e.name, compoundTag(d))
  put(result, "dimensions", compoundTag(dims))

proc gameRulesFromInner*(inner: NbtCompound): GameRuleRegistry =
  ## The `minecraft:<rule>` byte and int form shared by game_rules.dat and 1.21.11's level.dat.
  result = defaultGameRuleRegistry()
  for r in AllRules:
    let key = "minecraft:" & gameRuleName(r)
    case gameRuleKind(r)
    of grkBool:
      let (ok, v) = nbtByte(inner, key)
      if ok:
        result.set(r, GameRuleValue(kind: grkBool, boolValue: v != 0'i8))
    of grkInt:
      let (ok, v) = nbtInt(inner, key)
      if ok:
        result.set(r, GameRuleValue(kind: grkInt, intValue: int64(v)))

proc parseIntStrict(s: string): (bool, int64) =
  if s.len == 0:
    return (false, 0'i64)
  var i = 0
  var neg = false
  if s[0] == '-':
    neg = true
    i = 1
  if i >= s.len:
    return (false, 0'i64)
  var v = 0'i64
  while i < s.len:
    if s[i] < '0' or s[i] > '9':
      return (false, 0'i64)
    v = v * 10'i64 + int64(ord(s[i]) - ord('0'))
    inc i
  (true, if neg: -v else: v)

proc gameRulesFromStrings(c: NbtCompound): GameRuleRegistry =
  ## Upstream's serde form for `GameRuleRegistry`: snake_case keys, values as strings.
  result = defaultGameRuleRegistry()
  for r in AllRules:
    let (ok, s) = nbtString(c, gameRuleName(r))
    if ok:
      case gameRuleKind(r)
      of grkBool:
        result.set(r, GameRuleValue(kind: grkBool, boolValue: s == "true"))
      of grkInt:
        let (parsed, v) = parseIntStrict(s)
        if parsed:
          result.set(r, GameRuleValue(kind: grkInt, intValue: v))

proc isKnownLevelKey(k: string): bool =
  case k
  of "allowCommands", "BorderCenterX", "BorderCenterZ", "BorderDamagePerBlock", "BorderSize", "BorderSafeZone",
     "BorderSizeLerpTarget", "BorderSizeLerpTime", "BorderWarningBlocks", "BorderWarningTime", "DataPacks",
     "DataVersion", "Difficulty", "DifficultyLocked", "LastPlayed", "LevelName", "SpawnX", "SpawnY", "SpawnZ",
     "SpawnYaw", "SpawnAngle", "SpawnPitch", "Version", "version", "map_id": true
  else: false

proc difficultyFromInt(v: int64): Difficulty =
  case v
  of 0'i64: Peaceful
  of 1'i64: Easy
  of 3'i64: Hard
  else: Normal

proc levelDataFromNbt*(d: NbtCompound): (bool, LevelData, string) =
  ## `Deserialize for LevelData`, on the `Data` compound.
  var o = defaultLevelData(0'u64)
  let (hasDv, dv) = nbtInt(d, "DataVersion")
  if not hasDv:
    return (false, o, "missing field DataVersion")
  o.dataVersion = dv
  o.allowCommands = anyBool(d, "allowCommands", false)
  o.borderCenterX = anyDouble(d, "BorderCenterX", 0.0'f64)
  o.borderCenterZ = anyDouble(d, "BorderCenterZ", 0.0'f64)
  o.borderDamagePerBlock = anyDouble(d, "BorderDamagePerBlock", DefaultBorderDamagePerBlock)
  o.borderSize = anyDouble(d, "BorderSize", DefaultBorderSize)
  o.borderSafeZone = anyDouble(d, "BorderSafeZone", DefaultBorderSafeZone)
  o.borderSizeLerpTarget = anyDouble(d, "BorderSizeLerpTarget", DefaultBorderSize)
  o.borderSizeLerpTime = anyInt(d, "BorderSizeLerpTime", 0'i64)
  o.borderWarningBlocks = anyDouble(d, "BorderWarningBlocks", DefaultBorderWarningBlocks)
  o.borderWarningTime = anyDouble(d, "BorderWarningTime", DefaultBorderWarningTime)
  let (hasPacks, packs) = nbtCompound(d, "DataPacks")
  if hasPacks:
    o.dataPacks = dataPacksFromNbt(packs)
  o.difficulty = difficultyFromInt(anyInt(d, "Difficulty", 2'i64))
  o.difficultyLocked = anyBool(d, "DifficultyLocked", false)
  o.lastPlayed = anyInt(d, "LastPlayed", 0'i64)
  o.levelName = strOr(d, "LevelName", DefaultLevelName)
  o.spawnX = int32(anyInt(d, "SpawnX", 0'i64))
  o.spawnY = int32(anyInt(d, "SpawnY", int64(DefaultSpawnY)))
  o.spawnZ = int32(anyInt(d, "SpawnZ", 0'i64))
  o.spawnYaw = if d.containsKey("SpawnYaw"): anyFloat(d, "SpawnYaw", 0.0'f32) else: anyFloat(d, "SpawnAngle", 0.0'f32)
  o.spawnPitch = anyFloat(d, "SpawnPitch", 0.0'f32)
  let (hasVersion, version) = nbtCompound(d, "Version")
  if hasVersion:
    o.worldVersion = worldVersionFromNbt(version)
  o.levelVersion = int32(anyInt(d, "version", int64(MaximumSupportedLevelVersion)))
  o.mapId = int32(anyInt(d, "map_id", 0'i64))

  let (hasOldRules, oldRules) = nbtCompound(d, "GameRules")
  if hasOldRules:
    o.gameRules = gameRulesFromStrings(oldRules)
  let (hasRules, rules) = nbtCompound(d, "game_rules")
  if hasRules:
    o.gameRules = gameRulesFromInner(rules)
  let (hasWgs, wgs) = nbtCompound(d, "WorldGenSettings")
  o.worldGenSettings = if hasWgs: worldGenSettingsFromNbt(wgs) else: newWorldGenSettings(0'u64)
  o.dayTime = anyInt(d, "DayTime", 0'i64)
  o.clearWeatherTime = int32(anyInt(d, "clearWeatherTime", 0'i64))

  # 1.21.11's `spawn` compound replaces SpawnX/Y/Z and the angles.
  let (hasSpawn, spawn) = nbtCompound(d, "spawn")
  if hasSpawn:
    let (hasPos, pos) = nbtIntArray(spawn, "pos")
    if hasPos and pos.len == 3:
      o.spawnX = pos[0]
      o.spawnY = pos[1]
      o.spawnZ = pos[2]
    o.spawnYaw = anyFloat(spawn, "yaw", o.spawnYaw)
    o.spawnPitch = anyFloat(spawn, "pitch", o.spawnPitch)

  o.extra = newCompound()
  for i in 0 ..< d.names.len:
    if not isKnownLevelKey(d.names[i]):
      put(o.extra, d.names[i], d.values[i])
  (true, o, "")

proc levelDataToNbt*(d: LevelData): NbtCompound =
  ## `Serialize for LevelData`, in declaration order, then `extra` with live values written through.
  result = newCompound()
  put(result, "allowCommands", boolTag(d.allowCommands))
  put(result, "BorderCenterX", doubleTag(d.borderCenterX))
  put(result, "BorderCenterZ", doubleTag(d.borderCenterZ))
  put(result, "BorderDamagePerBlock", doubleTag(d.borderDamagePerBlock))
  put(result, "BorderSize", doubleTag(d.borderSize))
  put(result, "BorderSafeZone", doubleTag(d.borderSafeZone))
  put(result, "BorderSizeLerpTarget", doubleTag(d.borderSizeLerpTarget))
  put(result, "BorderSizeLerpTime", longTag(d.borderSizeLerpTime))
  put(result, "BorderWarningBlocks", doubleTag(d.borderWarningBlocks))
  put(result, "BorderWarningTime", doubleTag(d.borderWarningTime))
  put(result, "DataPacks", compoundTag(dataPacksToNbt(d.dataPacks)))
  put(result, "DataVersion", intTag(d.dataVersion))
  put(result, "Difficulty", byteTag(int8(ord(d.difficulty))))
  put(result, "DifficultyLocked", boolTag(d.difficultyLocked))
  put(result, "LastPlayed", longTag(d.lastPlayed))
  put(result, "LevelName", stringTag(d.levelName))
  put(result, "SpawnX", intTag(d.spawnX))
  put(result, "SpawnY", intTag(d.spawnY))
  put(result, "SpawnZ", intTag(d.spawnZ))
  put(result, "SpawnYaw", floatTag(d.spawnYaw))
  put(result, "SpawnPitch", floatTag(d.spawnPitch))
  put(result, "Version", compoundTag(worldVersionToNbt(d.worldVersion)))
  put(result, "version", intTag(d.levelVersion))
  put(result, "map_id", intTag(d.mapId))
  for i in 0 ..< d.extra.names.len:
    let k = d.extra.names[i]
    case k
    of "DayTime":
      put(result, k, longTag(d.dayTime))
    of "clearWeatherTime":
      put(result, k, intTag(d.clearWeatherTime))
    of "spawn":
      var spawn = d.extra.values[i].compoundVal
      insert(spawn, "pos", intArrayTag(@[d.spawnX, d.spawnY, d.spawnZ]))
      insert(spawn, "yaw", floatTag(d.spawnYaw))
      insert(spawn, "pitch", floatTag(d.spawnPitch))
      put(result, k, compoundTag(spawn))
    else:
      put(result, k, d.extra.values[i])

# See the same anchor in chunkio.aowl: this module only declares closure fields otherwise.
proc closureLiftAnchor*(): proc(): bool {.closure.} =
  proc(): bool {.closure.} = true

proc readInfoOf*(r: WorldInfoReader, levelFolder: string): (bool, LevelData, WorldInfoError) =
  ## Through a local; see the note in chunkio.aowl.
  let f = r.readWorldInfo
  f(levelFolder)

proc writeInfoOf*(w: WorldInfoWriter, info: LevelData, levelFolder: string): (bool, WorldInfoError) =
  let f = w.writeWorldInfo
  f(info, levelFolder)
