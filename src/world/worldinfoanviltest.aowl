## level.dat through `readWorldInfo`/`writeWorldInfo`. Port of `preserve_level_dat_seed` and
## `failed_deserialize_old_level_dat` in world_info/anvil.rs, with upstream's fixture level_1_20.dat, and a
## level.dat shaped like the one a 1.21.11 server writes.

import std/[syncio, assertions, envvars, cmdline]
import ../nbt/[tag, nbtbase, serializer, deserializer, nbtdoc]
import ../generated/game_rules
import ../util/difficulty
import worldinfo, worldinfoanvil, worldinfodatafiles, worldfs, nbtget, chunkcompress

const Assets = "../ref/pumpkin-1.21.11/pumpkin-world/assets/"

proc scratch(name: string): string =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/worldinfo_scratch"
  result = base & "/" & name
  discard createDirAllW(result)
  discard removeFileW(result & "/level.dat")
  for f in ["game_rules", "world_gen_settings", "world_clocks", "weather", "wandering_trader",
            "custom_boss_events", "scheduled_events"]:
    discard removeFileW(result & "/data/minecraft/" & f & ".dat")

proc real1_21_11Shape(): NbtCompound =
  # The keys a 1.21.11 server writes, values as read from a real level.dat by an independent decoder.
  result = newCompound()
  put(result, "DataVersion", intTag(4671))
  put(result, "version", intTag(19133))
  put(result, "LevelName", stringTag("world"))
  put(result, "Difficulty", byteTag(1))
  put(result, "allowCommands", byteTag(0))
  put(result, "DayTime", longTag(6000))
  put(result, "Time", longTag(13257278))
  put(result, "clearWeatherTime", intTag(0))
  put(result, "initialized", byteTag(1))
  var spawn = newCompound()
  put(spawn, "pos", intArrayTag(@[-160'i32, 78'i32, -64'i32]))
  put(spawn, "pitch", floatTag(0.0'f32))
  put(spawn, "dimension", stringTag("minecraft:overworld"))
  put(spawn, "yaw", floatTag(0.0'f32))
  put(result, "spawn", compoundTag(spawn))
  var rules = newCompound()
  put(rules, "minecraft:keep_inventory", byteTag(1))
  put(rules, "minecraft:random_tick_speed", intTag(9))
  put(result, "game_rules", compoundTag(rules))
  var version = newCompound()
  put(version, "Snapshot", byteTag(0))
  put(version, "Series", stringTag("main"))
  put(version, "Id", intTag(4671))
  put(version, "Name", stringTag("1.21.11"))
  put(result, "Version", compoundTag(version))
  var wgs = newCompound()
  put(wgs, "seed", longTag(-7436126469594556380'i64))
  put(wgs, "bonus_chest", byteTag(0))
  put(result, "WorldGenSettings", compoundTag(wgs))

proc testPreserveLevelDatSeed() =
  # preserve_level_dat_seed
  let dir = scratch("seed")
  var data = defaultLevelData(1337'u64)
  data.worldGenSettings = newWorldGenSettings(1337'u64)
  let (ok, err) = writeWorldInfo(data, dir)
  assert ok, $err
  let (rok, back, rerr) = readWorldInfo(dir)
  assert rok, $rerr
  assert back.worldGenSettings.seed == 1337'i64

proc testFailedDeserializeOldLevelDat() =
  # failed_deserialize_old_level_dat
  let dir = scratch("old")
  let (status, bytes) = readFileBytes(Assets & "level_1_20.dat")
  assert status == rsOk
  assert writeFileBytes(dir & "/level.dat", bytes)
  let (ok, _, err) = readWorldInfo(dir)
  assert not ok and err.kind == wieUnsupportedDataVersion

proc testNotFound() =
  let dir = scratch("none")
  let (ok, _, err) = readWorldInfo(dir)
  assert not ok and err.kind == wieInfoNotFound

proc testRealShape() =
  let dir = scratch("real")
  var root = newCompound()
  put(root, "Data", compoundTag(real1_21_11Shape()))
  let (gzOk, _) = writeGzipCompoundFile(dir & "/level.dat", root)
  assert gzOk
  let (ok, d, err) = readWorldInfo(dir)
  assert ok, $err
  assert d.dataVersion == 4671'i32 and d.difficulty == Easy and d.dayTime == 6000'i64
  assert d.spawnX == -160'i32 and d.spawnY == 78'i32 and d.spawnZ == -64'i32
  assert d.worldGenSettings.seed == -7436126469594556380'i64
  assert d.gameRules.keepInventory == true
  assert d.gameRules.randomTickSpeed == 9'i64
  assert d.gameRules.advanceTime == defaultBool(grAdvanceTime)
  assert d.worldVersion.name == "1.21.11"

  # Rewriting keeps what upstream's struct has no field for, and writes live values through.
  var changed = d
  changed.dayTime = 7000'i64
  changed.spawnY = 80'i32
  let (wok, werr) = writeWorldInfo(changed, dir)
  assert wok, $werr
  let (_, compressed) = readFileBytes(dir & "/level.dat")
  let (_, data, _) = parseLevelDat(gzipDecompressBytes(compressed).data)
  assert nbtLong(data, "Time") == (true, 13257278'i64)
  assert nbtByte(data, "initialized") == (true, 1'i8)
  assert nbtLong(data, "DayTime") == (true, 7000'i64)
  let (_, spawn) = nbtCompound(data, "spawn")
  assert nbtIntArray(spawn, "pos") == (true, @[-160'i32, 80'i32, -64'i32])
  assert nbtString(spawn, "dimension") == (true, "minecraft:overworld")
  assert data.containsKey("WorldGenSettings") and data.containsKey("game_rules")

  # The data files took the values, and the next read prefers them.
  let (ok2, d2, _) = readWorldInfo(dir)
  assert ok2 and d2.dayTime == 7000'i64
  assert d2.worldGenSettings.seed == -7436126469594556380'i64
  assert d2.gameRules.randomTickSpeed == 9'i64

testPreserveLevelDatSeed()
testFailedDeserializeOldLevelDat()
testNotFound()
testRealShape()
echo "worldinfoanvil: all checks passed"
