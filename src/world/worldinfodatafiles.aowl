## The `data/minecraft/*.dat` files: weather, world gen settings, game rules, clocks, trader, stubs.
## Port of pumpkin-world/src/world_info/data_files.rs

import ../nbt/[tag, nbtbase, serializer, deserializer, nbtdoc]
import ../generated/game_rules
import worldinfo, nbtget, worldfs, chunkcompress

type
  WeatherData* = object
    rainTime*: int32
    raining*: bool
    thundering*: bool
    thunderTime*: int32
    clearWeatherTime*: int32
    dataVersion*: int32

  WorldGenSettingsData* = object
    settings*: WorldGenSettings
    dataVersion*: int32
    bonusChest*: bool
    generateStructures*: bool

  DimensionClock* = object
    totalTicks*: int64

  ClockEntry* = object
    name*: string
    clock*: DimensionClock

  WorldClocksData* = object
    clocks*: seq[ClockEntry]  ## `HashMap<String, DimensionClock>`
    dataVersion*: int32

  WanderingTraderData* = object
    spawnDelay*: int32
    spawnChance*: int32
    dataVersion*: int32

proc defaultWeatherData*(): WeatherData =
  WeatherData(rainTime: 0'i32, raining: false, thundering: false, thunderTime: 0'i32,
    clearWeatherTime: -1'i32, dataVersion: 0'i32)

proc defaultWanderingTraderData*(): WanderingTraderData =
  WanderingTraderData(spawnDelay: 24_000'i32, spawnChance: 25'i32, dataVersion: 0'i32)

proc newWorldGenSettingsData*(settings: WorldGenSettings, dataVersion: int32): WorldGenSettingsData =
  WorldGenSettingsData(settings: settings, dataVersion: dataVersion, bonusChest: false, generateStructures: true)

proc minecraftDataDir*(levelFolder: string): string =
  joinPathW(joinPathW(levelFolder, "data"), "minecraft")

proc ensureMinecraftDataDir*(levelFolder: string): (bool, string) =
  let dir = minecraftDataDir(levelFolder)
  (createDirAllW(dir), dir)

proc readGzipCompound*(bytes: openArray[byte]): (bool, NbtCompound, string) =
  ## `read_gzip_compound_tag` over `chunkcompress`.
  let raw = gzipDecompressBytes(bytes)
  if not raw.ok:
    return (false, newCompound(), raw.msg)
  var reader = newNbtReader(nrmJava, raw.data)
  let doc = read(reader)
  if not doc.isOk:
    return (false, newCompound(), doc.error.msg)
  (true, doc.value.rootTag, "")

proc writeGzipCompoundFile*(path: string, compound: NbtCompound, level = 6): (bool, string) =
  ## `write_gzip_compound_tag`/`to_gzip_bytes` over `chunkcompress`.
  let gz = gzipCompressBytes(write(newNbt("", compound), nwmJava), level)
  if not gz.ok:
    return (false, gz.msg)
  if not writeFileBytes(path, gz.data):
    return (false, "could not write " & path)
  (true, "")

proc readDataFile(levelFolder, name: string): (bool, NbtCompound) =
  ## The shared body of every `read_*`: absent, unreadable or corrupt all fall back to defaults.
  let path = joinPathW(minecraftDataDir(levelFolder), name)
  let (status, bytes) = readFileBytes(path)
  if status != rsOk:
    return (false, newCompound())
  let (ok, root, _) = readGzipCompound(bytes)
  if not ok:
    return (false, newCompound())
  (true, root)

proc writeDataFile(levelFolder, name: string, inner: NbtCompound): (bool, WorldInfoError) =
  let (dirOk, dir) = ensureMinecraftDataDir(levelFolder)
  if not dirOk:
    return (false, infoErr(wieIoError, "could not create " & dir))
  var root = newCompound()
  put(root, "data", compoundTag(inner))
  let (ok, msg) = writeGzipCompoundFile(joinPathW(dir, name), root)
  if ok: (true, infoErr(wieIoError)) else: (false, infoErr(wieSerializationError, msg))

proc intOr(c: NbtCompound, name: string, d: int32): int32 =
  let (ok, v) = nbtInt(c, name)
  if ok: v else: d

proc boolOr(c: NbtCompound, name: string, d: bool): bool =
  let (ok, v) = nbtBool(c, name)
  if ok: v else: d

proc readWeather*(levelFolder: string): WeatherData =
  ## `read_weather`
  result = defaultWeatherData()
  let (ok, root) = readDataFile(levelFolder, "weather.dat")
  if not ok:
    return
  let (hasData, d) = nbtCompound(root, "data")
  if not hasData:
    return
  # Upstream's serde defaults: a missing field is the type's zero, not `WeatherData::default()`.
  result = WeatherData(rainTime: intOr(d, "rain_time", 0'i32), raining: boolOr(d, "raining", false),
    thundering: boolOr(d, "thundering", false), thunderTime: intOr(d, "thunder_time", 0'i32),
    clearWeatherTime: intOr(d, "clear_weather_time", 0'i32), dataVersion: intOr(d, "DataVersion", 0'i32))

proc writeWeather*(levelFolder: string, data: WeatherData): (bool, WorldInfoError) =
  ## `write_weather`
  var d = newCompound()
  put(d, "rain_time", intTag(data.rainTime))
  put(d, "raining", boolTag(data.raining))
  put(d, "thundering", boolTag(data.thundering))
  put(d, "thunder_time", intTag(data.thunderTime))
  put(d, "clear_weather_time", intTag(data.clearWeatherTime))
  put(d, "DataVersion", intTag(data.dataVersion))
  writeDataFile(levelFolder, "weather.dat", d)

proc readWorldGenSettings*(levelFolder: string): (bool, WorldGenSettings) =
  ## `read_world_gen_settings`
  let (ok, root) = readDataFile(levelFolder, "world_gen_settings.dat")
  if not ok:
    return (false, WorldGenSettings())
  let (hasData, d) = nbtCompound(root, "data")
  if not hasData or not d.containsKey("seed"):
    return (false, WorldGenSettings())
  (true, worldGenSettingsFromNbt(d))

proc writeWorldGenSettings*(levelFolder: string, settings: WorldGenSettings, dataVersion: int32): (bool, WorldInfoError) =
  ## `write_world_gen_settings`
  let data = newWorldGenSettingsData(settings, dataVersion)
  var d = worldGenSettingsToNbt(data.settings)
  put(d, "DataVersion", intTag(data.dataVersion))
  put(d, "bonus_chest", boolTag(data.bonusChest))
  put(d, "generate_structures", boolTag(data.generateStructures))
  writeDataFile(levelFolder, "world_gen_settings.dat", d)

proc gameRulesToNbt*(rules: GameRuleRegistry, dataVersion: int32): NbtCompound =
  ## `game_rules_to_nbt`
  var inner = newCompound()
  for r in AllRules:
    let key = "minecraft:" & gameRuleName(r)
    let v = rules.get(r)
    case v.kind
    of grkBool: put(inner, key, boolTag(v.boolValue))
    of grkInt: put(inner, key, intTag(int32(v.intValue)))
  put(inner, "DataVersion", intTag(dataVersion))
  result = newCompound()
  put(result, "data", compoundTag(inner))

proc gameRulesFromNbt*(root: NbtCompound): GameRuleRegistry =
  ## `game_rules_from_nbt`
  let (hasData, inner) = nbtCompound(root, "data")
  if not hasData:
    return defaultGameRuleRegistry()
  gameRulesFromInner(inner)

proc readGameRules*(levelFolder: string): GameRuleRegistry =
  ## `read_game_rules`
  let (ok, root) = readDataFile(levelFolder, "game_rules.dat")
  if not ok:
    return defaultGameRuleRegistry()
  gameRulesFromNbt(root)

proc writeGameRules*(levelFolder: string, rules: GameRuleRegistry, dataVersion: int32): (bool, WorldInfoError) =
  ## `write_game_rules`
  let (dirOk, dir) = ensureMinecraftDataDir(levelFolder)
  if not dirOk:
    return (false, infoErr(wieIoError, "could not create " & dir))
  let (ok, msg) = writeGzipCompoundFile(joinPathW(dir, "game_rules.dat"), gameRulesToNbt(rules, dataVersion))
  if ok: (true, infoErr(wieIoError)) else: (false, infoErr(wieSerializationError, msg))

proc readWorldClocks*(levelFolder: string): WorldClocksData =
  ## `read_world_clocks` and `world_clocks_from_nbt`
  result = WorldClocksData(clocks: @[], dataVersion: 0'i32)
  let (ok, root) = readDataFile(levelFolder, "world_clocks.dat")
  if not ok:
    return
  let (hasData, inner) = nbtCompound(root, "data")
  if not hasData:
    return
  result.dataVersion = intOr(inner, "DataVersion", 0'i32)
  for i in 0 ..< inner.names.len:
    if inner.names[i] != "DataVersion" and inner.values[i].kind == ntkCompound:
      let (hasTicks, ticks) = nbtLong(inner.values[i].compoundVal, "total_ticks")
      result.clocks.add(ClockEntry(name: inner.names[i],
        clock: DimensionClock(totalTicks: if hasTicks: ticks else: 0'i64)))

proc writeWorldClocks*(levelFolder: string, clocks: WorldClocksData): (bool, WorldInfoError) =
  ## `write_world_clocks`
  var inner = newCompound()
  for e in clocks.clocks:
    var dim = newCompound()
    put(dim, "total_ticks", longTag(e.clock.totalTicks))
    put(inner, e.name, compoundTag(dim))
  put(inner, "DataVersion", intTag(clocks.dataVersion))
  writeDataFile(levelFolder, "world_clocks.dat", inner)

proc readWanderingTrader*(levelFolder: string): WanderingTraderData =
  ## `read_wandering_trader`
  result = defaultWanderingTraderData()
  let (ok, root) = readDataFile(levelFolder, "wandering_trader.dat")
  if not ok:
    return
  let (hasData, d) = nbtCompound(root, "data")
  if hasData:
    result = WanderingTraderData(spawnDelay: intOr(d, "spawn_delay", 24_000'i32),
      spawnChance: intOr(d, "spawn_chance", 25'i32), dataVersion: intOr(d, "DataVersion", 0'i32))

proc writeWanderingTrader*(levelFolder: string, data: WanderingTraderData): (bool, WorldInfoError) =
  ## `write_wandering_trader`
  var d = newCompound()
  put(d, "spawn_delay", intTag(data.spawnDelay))
  put(d, "spawn_chance", intTag(data.spawnChance))
  put(d, "DataVersion", intTag(data.dataVersion))
  writeDataFile(levelFolder, "wandering_trader.dat", d)

proc writeCustomBossEventsStub*(levelFolder: string, dataVersion: int32): (bool, WorldInfoError) =
  ## `write_custom_boss_events_stub`: only created if absent.
  if fileExistsW(joinPathW(minecraftDataDir(levelFolder), "custom_boss_events.dat")):
    return (true, infoErr(wieIoError))
  var inner = newCompound()
  put(inner, "DataVersion", intTag(dataVersion))
  writeDataFile(levelFolder, "custom_boss_events.dat", inner)

proc writeScheduledEventsStub*(levelFolder: string, dataVersion: int32): (bool, WorldInfoError) =
  ## `write_scheduled_events_stub`: only created if absent.
  if fileExistsW(joinPathW(minecraftDataDir(levelFolder), "scheduled_events.dat")):
    return (true, infoErr(wieIoError))
  var inner = newCompound()
  put(inner, "events", listTag(newSeq[NbtTag](0)))
  put(inner, "DataVersion", intTag(dataVersion))
  writeDataFile(levelFolder, "scheduled_events.dat", inner)
