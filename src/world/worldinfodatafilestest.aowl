## The data/minecraft/*.dat files: defaults when absent, exact on-disk shape, stubs written once.

import std/[syncio, assertions, envvars, cmdline]
import ../nbt/[tag, nbtbase, serializer, deserializer, nbtdoc]
import ../generated/game_rules
import ../util/difficulty
import worldinfo, worldinfodatafiles, worldfs, nbtget

proc scratch(name: string): string =
  var base = getEnv("WORLDTEST_DIR")
  if base.len == 0:
    base = parentDirW(paramStr(0)) & "/worldinfo_scratch"
  result = base & "/" & name
  discard createDirAllW(result)
  discard removeFileW(result & "/level.dat")
  for f in ["game_rules", "world_gen_settings", "world_clocks", "weather", "wandering_trader",
            "custom_boss_events", "scheduled_events"]:
    discard removeFileW(result & "/data/minecraft/" & f & ".dat")

proc testDataFiles() =
  let dir = scratch("data")
  # Defaults when absent.
  let w0 = readWeather(dir)
  assert w0.clearWeatherTime == -1'i32 and w0.rainTime == 0'i32 and not w0.raining
  let t0 = readWanderingTrader(dir)
  assert t0.spawnDelay == 24_000'i32 and t0.spawnChance == 25'i32
  assert readWorldGenSettings(dir)[0] == false
  assert readWorldClocks(dir).clocks.len == 0

  assert writeWeather(dir, WeatherData(rainTime: 5'i32, raining: true, thundering: false, thunderTime: 7'i32,
    clearWeatherTime: 9'i32, dataVersion: 4903'i32))[0]
  let w = readWeather(dir)
  assert w.rainTime == 5'i32 and w.raining and w.thunderTime == 7'i32 and w.clearWeatherTime == 9'i32
  assert w.dataVersion == 4903'i32

  assert writeWorldGenSettings(dir, newWorldGenSettings(42'u64), 4903'i32)[0]
  let (hasW, wgs) = readWorldGenSettings(dir)
  assert hasW and wgs.seed == 42'i64 and wgs.dimensions.len == 3
  # The on-disk shape: {data: {seed, dimensions, DataVersion, bonus_chest, generate_structures}}.
  let (_, raw) = readFileBytes(dir & "/data/minecraft/world_gen_settings.dat")
  let (ok, root, _) = readGzipCompound(raw)
  assert ok
  let (_, inner) = nbtCompound(root, "data")
  assert nbtByte(inner, "generate_structures") == (true, 1'i8)
  assert nbtByte(inner, "bonus_chest") == (true, 0'i8)
  assert nbtInt(inner, "DataVersion") == (true, 4903'i32)

  var rules = defaultGameRuleRegistry()
  rules.keepInventory = true
  rules.randomTickSpeed = 12'i64
  assert writeGameRules(dir, rules, 4903'i32)[0]
  let r = readGameRules(dir)
  assert r.keepInventory and r.randomTickSpeed == 12'i64

  let nbt = gameRulesToNbt(rules, 4903'i32)
  let (_, nbtInner) = nbtCompound(nbt, "data")
  assert nbtByte(nbtInner, "minecraft:keep_inventory") == (true, 1'i8)
  assert nbtInt(nbtInner, "minecraft:random_tick_speed") == (true, 12'i32)
  assert nbtInt(nbtInner, "DataVersion") == (true, 4903'i32)
  # No `data` compound: defaults.
  let noData = gameRulesFromNbt(newCompound())
  assert noData.randomTickSpeed == defaultInt(grRandomTickSpeed)

  let clocks = WorldClocksData(clocks: @[ClockEntry(name: "minecraft:overworld", clock: DimensionClock(totalTicks: 100'i64))],
    dataVersion: 3'i32)
  assert writeWorldClocks(dir, clocks)[0]
  let c = readWorldClocks(dir)
  assert c.dataVersion == 3'i32 and c.clocks.len == 1 and c.clocks[0].clock.totalTicks == 100'i64

  assert writeWanderingTrader(dir, WanderingTraderData(spawnDelay: 1'i32, spawnChance: 2'i32, dataVersion: 3'i32))[0]
  assert readWanderingTrader(dir).spawnDelay == 1'i32

  # Stubs are only created once.
  assert writeCustomBossEventsStub(dir, 1'i32)[0]
  assert writeScheduledEventsStub(dir, 1'i32)[0]
  assert writeScheduledEventsStub(dir, 2'i32)[0]
  let (_, sched) = readFileBytes(dir & "/data/minecraft/scheduled_events.dat")
  let (_, schedRoot, _) = readGzipCompound(sched)
  let (_, schedInner) = nbtCompound(schedRoot, "data")
  assert nbtInt(schedInner, "DataVersion") == (true, 1'i32)
  assert nbtList(schedInner, "events")[0]

testDataFiles()
echo "worldinfodatafiles: all checks passed"
