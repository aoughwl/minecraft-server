## `LevelData` to and from NBT. Port of `deserialize_level_dat` and `serialize_level_dat` in
## world_info/anvil.rs, reading upstream's fixture pumpkin-world/assets/level_1_21_4.dat.

import std/[syncio, assertions]
import ../nbt/[tag, nbtbase, serializer, deserializer, nbtdoc]
import ../util/difficulty
import ../generated/game_rules
import worldinfo, worldinfoanvil, worldfs, nbtget, chunkcompress

const Assets = "../ref/pumpkin-1.21.11/pumpkin-world/assets/"

proc testDeserializeLevelDat() =
  # deserialize_level_dat: upstream's LEVEL_DAT expectations for the 1.21.4 file.
  let (status, compressed) = readFileBytes(Assets & "level_1_21_4.dat")
  assert status == rsOk
  let raw = gzipDecompressBytes(compressed)
  assert raw.ok
  let (parsed, data, perr) = parseLevelDat(raw.data)
  assert parsed, $perr
  let (ok, d, msg) = levelDataFromNbt(data)
  assert ok, msg
  assert d.allowCommands == true
  assert d.borderCenterX == 0.0 and d.borderCenterZ == 0.0
  assert d.borderDamagePerBlock == 0.2
  assert d.borderSize == 59_999_968.0
  assert d.borderSafeZone == 5.0
  assert d.borderSizeLerpTarget == 59_999_968.0
  assert d.borderSizeLerpTime == 0'i64
  assert d.borderWarningBlocks == 5.0
  assert d.borderWarningTime == 15.0
  assert d.clearWeatherTime == 0'i32
  assert d.dataPacks.disabled == @["minecart_improvements", "redstone_experiments", "trade_rebalance"]
  assert d.dataPacks.enabled == @["vanilla"]
  assert d.dataVersion == 4189'i32
  assert d.dayTime == 1727'i64
  assert d.difficulty == Normal
  assert d.difficultyLocked == false
  assert d.lastPlayed == 1733847709327'i64
  assert d.levelName == "New World"
  assert d.spawnX == 160'i32 and d.spawnY == 70'i32 and d.spawnZ == 160'i32
  assert d.spawnYaw == 0.0'f32 and d.spawnPitch == 0.0'f32
  assert d.levelVersion == 19133'i32
  assert d.worldVersion.name == "1.21.4" and d.worldVersion.id == 4189'i32
  assert d.worldVersion.snapshot == false and d.worldVersion.series == "main"
  assert d.mapId == 0'i32
  assert d.worldGenSettings.seed == 1'i64
  let (hasOver, over) = findDimension(d.worldGenSettings, "minecraft:overworld")
  assert hasOver and over.dimensionType == "minecraft:overworld"
  assert over.generator.generatorType == "minecraft:noise"
  assert over.generator.settings.kind == gskReference and over.generator.settings.reference == "minecraft:overworld"
  assert over.generator.biomeSource.kind == bskWithPreset and over.generator.biomeSource.preset == "minecraft:overworld"
  let (hasEnd, theEnd) = findDimension(d.worldGenSettings, "minecraft:the_end")
  assert hasEnd and theEnd.generator.biomeSource.kind == bskSimple
  assert theEnd.generator.biomeSource.biomeType == "minecraft:the_end"

  # The 1.21.4 file's data version is below the minimum, so the checked reader refuses it.
  assert checkFileDataVersion(data)[0] == false

proc testSerializeLevelDat() =
  # serialize_level_dat: through bytes and back, with the skip_serializing fields at defaults.
  let (_, compressed) = readFileBytes(Assets & "level_1_21_4.dat")
  let (_, data, _) = parseLevelDat(gzipDecompressBytes(compressed).data)
  let (_, d0, _) = levelDataFromNbt(data)
  var d = d0
  d.extra = newCompound()    # upstream's shape: only its own fields go out
  var root = newCompound()
  put(root, "Data", compoundTag(levelDataToNbt(d)))
  let bytes = write(newNbt("", root), nwmJava)
  let (ok, data2, err) = parseLevelDat(bytes)
  assert ok, $err
  let (ok2, again, _) = levelDataFromNbt(data2)
  assert ok2
  assert again.levelName == d.levelName and again.spawnY == d.spawnY and again.borderSize == d.borderSize
  assert again.dataPacks.disabled == d.dataPacks.disabled and again.worldVersion.name == "1.21.4"
  assert again.lastPlayed == d.lastPlayed and again.dataVersion == d.dataVersion
  assert again.dayTime == 0'i64 and again.clearWeatherTime == 0'i32
  # Exact NBT key and type choices, as upstream's serde writes them.
  assert nbtByte(data2, "allowCommands") == (true, 1'i8)
  assert nbtDouble(data2, "BorderSize") == (true, 59_999_968.0'f64)
  assert nbtLong(data2, "BorderSizeLerpTime") == (true, 0'i64)
  assert nbtInt(data2, "version") == (true, 19133'i32)
  assert nbtInt(data2, "map_id") == (true, 0'i32)
  assert nbtFloat(data2, "SpawnYaw") == (true, 0.0'f32)
  let (_, version) = nbtCompound(data2, "Version")
  assert nbtString(version, "Series") == (true, "main")
  # Not upstream: the compounds a vanilla 1.21.11 reads the rules and the spawn from.
  let (hasRules, rules) = nbtCompound(data2, "game_rules")
  assert hasRules
  assert nbtByte(rules, "minecraft:keep_inventory") == (true, 0'i8)
  assert nbtByte(rules, "minecraft:advance_time") == (true, 1'i8)
  assert nbtInt(rules, "minecraft:random_tick_speed") == (true, 3'i32)
  assert nbtInt(rules, "minecraft:players_sleeping_percentage") == (true, 100'i32)
  assert not rules.containsKey("minecraft:max_minecart_speed")
  let (hasSpawn, spawn) = nbtCompound(data2, "spawn")
  assert hasSpawn and nbtString(spawn, "dimension") == (true, "minecraft:overworld")
  assert nbtIntArray(spawn, "pos") == (true, @[d.spawnX, d.spawnY, d.spawnZ])
  # A changed rule is written through the file's own compound, and what the file had stays.
  var changed = d
  changed.gameRules.set(grKeepInventory, GameRuleValue(kind: grkBool, boolValue: true))
  changed.gameRules.set(grRandomTickSpeed, GameRuleValue(kind: grkInt, intValue: 9'i64))
  var old = newCompound()
  put(old, "minecraft:from_the_future", byteTag(1'i8))
  put(old, "minecraft:keep_inventory", byteTag(0'i8))
  changed.extra = newCompound()
  put(changed.extra, "game_rules", compoundTag(old))
  let out2 = levelDataToNbt(changed)
  let (_, rules2) = nbtCompound(out2, "game_rules")
  assert nbtByte(rules2, "minecraft:keep_inventory") == (true, 1'i8)
  assert nbtInt(rules2, "minecraft:random_tick_speed") == (true, 9'i32)
  assert nbtByte(rules2, "minecraft:from_the_future") == (true, 1'i8)
  assert gameRulesFromInner(rules2).get(grKeepInventory).boolValue

testDeserializeLevelDat()
testSerializeLevelDat()
echo "worldinfo: all checks passed"
