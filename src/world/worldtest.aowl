## `BlockFlags` values, `GetBlockError`, the `BlockAccessor` vtable.

import std/[syncio, assertions]
import blockstates, tick, world

proc testWorldFlags() =
  assert BfNotifyAll == (BfNotifyNeighbors or BfNotifyListeners)
  assert BfSkipBlockAddedCallback == 128'u32
  assert hasFlag(BfNotifyAll, BfNotifyListeners) and not hasFlag(BfNotifyAll, BfMoved)
  assert $gbeInvalidBlockId == "InvalidBlockId" and $gbeBlockOutOfWorldBounds == "BlockOutOfWorldBounds"
  let (_, stoneState) = defaultStateByName("stone")
  let accessor = accessorFromStateLookup(proc(p: BlockPos): BlockStateId {.closure.} = stoneState)
  let (_, stoneBlock) = blockIdByName("stone")
  assert blockAt(accessor, blockPos(0, 0, 0)) == stoneBlock
  assert stateIdAt(accessor, blockPos(0, 0, 0)) == stoneState
  assert blockAndStateAt(accessor, blockPos(0, 0, 0))[1] == stoneState

testWorldFlags()
echo "world: all checks passed"
