## World types (Fabric gap "flat / amplified / large-biomes"): the creation option writes the generator into level.dat,
## Level reads it back (isFlat + layers, noiseVariant), and the generator really changes: same seed, same chunks, four
## world types, compared cell by cell. A generator that ignored the type fails the "differs" and the layer asserts.
{.feature: "lenientnils".}

import std/[assertions, syncio, cmdline]
import chunkdata
import blockstates
import world
import level
import worldfs
import worldinfo
import worldinfoanvil
import ../config/lib
import ../generated/dimension
import generation/generator/generator
import chunk_system/chunk_system

const Seed = 8222734'u64

proc scratch(tag: string): string =
  result = parentDirW(paramStr(0)) & "/wt_scratch_" & tag
  discard createDirAllW(result)

# --- level.dat round trip of each type ------------------------------------------------------------------
proc levelFor(worldType: string): level.Level =
  let dir = scratch(worldType)
  var info = defaultLevelData(Seed)
  info.worldGenSettings = newWorldGenSettingsOfType(Seed, worldType)
  let (ok, err) = writeWorldInfo(info, dir)
  assert ok, $err
  let (rok, back, rerr) = readWorldInfo(dir)
  assert rok, $rerr
  assert back.worldGenSettings.seed == cast[int64](Seed), "the seed is the configured one"
  fromRootFolder(defaultAdvancedConfiguration().world, dir, back.worldGenSettings.seed, OVERWORLD)

let lDefault = levelFor("default")
let lFlat = levelFor("flat")
let lAmp = levelFor("amplified")
let lLarge = levelFor("large_biomes")
assert not lDefault.isFlat and lDefault.noiseVariant == "minecraft:overworld"
assert lFlat.isFlat and lFlat.flatLayers.len == 3 and lFlat.flatLayers[0].block_name == "minecraft:bedrock" and
  lFlat.flatLayers[1].height == 2'i32 and lFlat.flatLayers[2].block_name == "minecraft:grass_block"
assert not lAmp.isFlat and lAmp.noiseVariant == "minecraft:amplified"
assert not lLarge.isFlat and lLarge.noiseVariant == "minecraft:large_biomes"
assert isKnownWorldType("flat") and not isKnownWorldType("superflat")
echo "level.dat round trip ok"

# --- the generator follows the type ---------------------------------------------------------------------
let airId = defaultStateByName("air")[1]
let spots = [(0'i32, 0'i32), (40'i32, -17'i32), (-63'i32, 22'i32), (101'i32, 101'i32), (-200'i32, -80'i32), (7'i32, 301'i32)]

type Stats = object
  heights: seq[int32]
  cells: seq[BlockStateId]

proc sample(l: level.Level): Stats =
  let gen = getWorldGen(l.seed, OVERWORLD, l.isFlat, l.flatLayers, l.flatBiome, l.noiseVariant)
  result = Stats(heights: @[], cells: @[])
  for si in 0 ..< spots.len:
    let c = generateSingleChunk(gen, noOpWorldPortal(), spots[si][0], spots[si][1], StagedChunkEnum.Full)
    assert c.kind == ChunkKind.Level
    let minY = c.level.section.minY
    for x in 0 ..< 16:
      for z in 0 ..< 16:
        result.heights.add(getHeightmap(c.level.heightmap, chmWorldSurface, int32(x), int32(z), minY))
        for y in [-64'i32, -63'i32, -62'i32, -61'i32, -60'i32, 40'i32, 70'i32, 120'i32, 200'i32]:
          let (ok, id) = getBlockAbsoluteY(c.level.section, x, y, z)
          result.cells.add(if ok: id else: airId)

proc diffCells(a, b: Stats): int =
  result = 0
  for i in 0 ..< a.cells.len:
    if a.cells[i] != b.cells[i]:
      inc result

proc spread(a: Stats): (int32, int32, int64) =
  var lo = high(int32)
  var hi = low(int32)
  var sum = 0'i64
  for h in a.heights:
    lo = min(lo, h)
    hi = max(hi, h)
    sum += int64(h)
  (lo, hi, sum)

let sDefault = sample(lDefault)
let sFlat = sample(lFlat)
let sAmp = sample(lAmp)
let sLarge = sample(lLarge)
echo "default  height lo/hi/sum ", spread(sDefault)[0], " ", spread(sDefault)[1], " ", spread(sDefault)[2]
echo "flat     height lo/hi/sum ", spread(sFlat)[0], " ", spread(sFlat)[1], " ", spread(sFlat)[2]
echo "amplified height lo/hi/sum ", spread(sAmp)[0], " ", spread(sAmp)[1], " ", spread(sAmp)[2]
echo "large    height lo/hi/sum ", spread(sLarge)[0], " ", spread(sLarge)[1], " ", spread(sLarge)[2]
echo "cells differing vs default: flat ", diffCells(sDefault, sFlat), " amplified ", diffCells(sDefault, sAmp),
  " large_biomes ", diffCells(sDefault, sLarge), " of ", sDefault.cells.len

# flat: every column is exactly the layers (bedrock, dirt, dirt, grass_block, then air)
let flatSpread = spread(sFlat)
assert flatSpread[0] == flatSpread[1], "a flat world has one surface height"
let bedrockId = defaultStateByName("bedrock")[1]
let grassId = defaultStateByName("grass_block")[1]
let dirtId = defaultStateByName("dirt")[1]
for i in 0 ..< sFlat.heights.len:
  let base = i * 9
  assert sFlat.cells[base] == bedrockId and sFlat.cells[base + 1] == dirtId and sFlat.cells[base + 2] == dirtId and
    sFlat.cells[base + 3] == grassId and sFlat.cells[base + 4] == airId,
    "flat column layers at column " & $i
assert diffCells(sDefault, sFlat) > 1000
assert diffCells(sDefault, sAmp) > 500, "amplified differs from default"
assert diffCells(sDefault, sLarge) > 500, "large_biomes differs from default"
assert diffCells(sAmp, sLarge) > 500
let ampSpread = spread(sAmp)
let defSpread = spread(sDefault)
assert (ampSpread[1] - ampSpread[0]) > (defSpread[1] - defSpread[0]), "amplified terrain has more relief than default over the same chunks"
echo "worldtypestest ok"
