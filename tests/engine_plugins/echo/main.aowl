## A tiny aowlmony plugin for the plugin manager's test: registers /echo and a chat handler, and logs when it starts and stops.
import pluginsdk

var runs = 0

proc echoCommand(c: var CommandContext) =
  runs = runs + 1
  log("echo cmd " & c.name & ":" & c.rawArgs & " run " & $runs)
  c.reply("echo: " & c.rawArgs)

proc chatFilter(e: var ChatEvent) =
  if e.message.len > 0 and e.message[0] == 'x':
    e.cancel()
  else:
    e.message = e.message & "!"

proc halveDamage(e: var EntityDamageEvent) =
  log("echo damage " & e.entityType & " " & $e.amount)
  e.amount = e.amount / 2.0

proc started() = log("echo started")
proc stopped() = log("echo stopped")

command("echo", "Echoes its arguments", 0, echoCommand)
registerEvent(chatFilter)
registerEvent(halveDamage)
onEnable(started)
onDisable(stopped)
